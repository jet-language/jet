#Derive(Clone)
struct FseTable { log: U8, entries: [FseEntry] }
impl FseTable {
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:81
    fn parse(source: &[U8], max_log: U8, max_symbol: USize) -> (FseTable, USize)? {
        bits := ForwardBits { source: source, bit: 0 }
        log :: 5 + bits.read(4)? as U8
        if log > max_log { return None }
        total: U32 = 1 << log
        sum: U32 = 0
        probabilities := [I32]{}
        loop sum < total {
            remaining :: total - sum + 1
            width :: 32 - remaining.leading_zeros()
            unchecked :: bits.read(width as USize)?
            low :: (1 << width) - 1 - remaining
            mask :: (1 << (width - 1)) - 1
            small :: unchecked & mask
            value :: if small < low {
                bits.bit = bits.bit.checked_sub(1)?
                small
            } else if unchecked > mask { unchecked - low } else { unchecked }
            probability :: value as I32 - 1
            probabilities.push(probability)
            if probability == {
                -1 -> sum += 1
                0 -> loop {
                    skip :: bits.read(2)? as USize
                    probabilities.resize(probabilities.len().checked_add(skip)?, 0)
                    if skip != 3 { break }
                }
                n if n > 0 -> sum = sum.checked_add(n as U32)?
                _ -> return None
            }
            if probabilities.len() > max_symbol + 1 || sum > total { return None }
        }
        table :: FseTable.from_probabilities(log, &probabilities)?
        Val((^table, bits.bit.div_ceil(8)))
    }
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:127
    fn from_probabilities(log: U8, probabilities: &[I32]) -> FseTable? {
        size: USize = 1 << log
        total :: probabilities.iter().try_fold(USize{0}, fn(sum, probability) {
            sum.checked_add(if probability == { -1 -> 1; value if value >= 0 -> value as USize; _ -> return None })
        })?
        if total != size || probabilities.is_empty() || probabilities.len() > 256 { return None }
        entries := [FseEntry].filled(size, FseEntry { baseline: 0, bits: 0, symbol: 0 })
        high := size
        loop (symbol, probability) in probabilities.iter().enumerate() {
            if probability == -1 {
                high = high.checked_sub(1)?
                entries[high] = FseEntry { baseline: 0, bits: log, symbol: symbol as U8 }
            }
        }
        step :: (size >> 1) + (size >> 3) + 3
        position: USize = 0
        loop (symbol, probability) in probabilities.iter().enumerate() {
            loop _ in 0..<probability.max(0) {
                entries[position].symbol = symbol as U8
                position = (position + step) & (size - 1)
                loop position >= high { position = (position + step) & (size - 1) }
            }
        }
        counters := [U32].filled(probabilities.len(), 0)
        loop entry in &entries[0..<high] {
            probability :: probabilities[USize.from(entry.symbol)] as U32
            states :: probability.next_power_of_two()
            doubled :: states - probability
            single :: probability - doubled
            width :: size as U32 / states
            number :: counters[USize.from(entry.symbol)]
            if number < doubled {
                entry.baseline = (single * width + number * width * 2) as USize
                entry.bits = width.trailing_zeros() as U8 + 1
            } else {
                entry.baseline = ((number - doubled) * width) as USize
                entry.bits = width.trailing_zeros() as U8
            }
            counters[USize.from(entry.symbol)] += 1
        }
        Val(FseTable { log: log, entries: ^entries })
    }
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:189
    fn weights(self: &FseTable, source: &[U8]) -> [U8]? {
        bits := ReverseBits.new(source)?
        first := bits.read(self.log)
        second := bits.read(self.log)
        out := [U8]{}
        loop {
            entry :: self.entries.get(first)?
            out.push(entry.symbol)
            first = entry.baseline + bits.read(entry.bits)
            if bits.remaining <= -1 { out.push(self.entries.get(second)?.symbol); break }
            entry :: self.entries.get(second)?
            out.push(entry.symbol)
            second = entry.baseline + bits.read(entry.bits)
            if bits.remaining <= -1 { out.push(self.entries.get(first)?.symbol); break }
            if out.len() > 255 { return None }
        }
        Val(^out)
    }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:218
#Derive(Clone, Copy)
struct HuffEntry { symbol: U8, bits: U8 }
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:224
#Derive(Clone)
struct Huffman { log: U8, entries: [HuffEntry] }
impl Huffman {
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:230
    fn parse(source: &[U8]) -> (Huffman, USize)? {
        header :: source.first()?
        (weights, used) := if header < 128 {
            payload :: source.get(1..<1 + USize.from(header))?
            (table, table_used) :: FseTable.parse(payload, 6, 255)?
            weights :: table.weights(payload.get(table_used..<payload.len())?)?
            (^weights, 1 + USize.from(header))
        } else {
            count :: USize.from(header - 127)
            bytes :: source.get(1..<1 + count.div_ceil(2))?
            weights :: (0..<count).map(fn(index) { if index % 2 == 0 { bytes[index / 2] >> 4 } else { bytes[index / 2] & 15 } }).collect<[U8]>()
            (^weights, 1 + count.div_ceil(2))
        }
        if weights.len() > 255 { return None }
        sum :: weights.iter().try_fold(U32{0}, fn(sum, weight) {
            if weight <= 11 { Val(sum + if weight == 0 { 0 } else { 1 << (weight - 1) }) } else { None }
        })?
        if sum == 0 { return None }
        log :: (32 - sum.leading_zeros()) as U8
        leftover :: (U32{1} << log).checked_sub(sum)?
        if !leftover.is_power_of_two() || log > 11 { return None }
        weights.push((32 - leftover.leading_zeros()) as U8)
        if !weights.contains(&1) || weights.iter().filter(fn(weight) { weight != 0 }).take(2).count() < 2 { return None }
        lengths :: weights.iter().map(fn(weight) { if weight == 0 { U8{0} } else { log + 1 - weight } }).collect<[U8]>()
        ranks := [USize].filled(USize.from(log) + 1, 0)
        loop length in lengths { ranks[USize.from(length)] += 1 }
        starts := [USize].filled(USize.from(log) + 1, 0)
        loop bits in (1..=USize.from(log)).rev() { starts[bits - 1] = starts[bits] + ranks[bits] * (1 << (USize.from(log) - bits)) }
        if starts[0] != 1 << log { return None }
        entries := [HuffEntry].filled(1 << log, HuffEntry { symbol: 0, bits: 0 })
        loop (symbol, length) in lengths.into_iter().enumerate() {
            if length == 0 { continue }
            span :: 1 << (log - length)
            start :: starts[USize.from(length)]
            starts[USize.from(length)] += span
            loop entry in &entries[start..<start + span] { entry = HuffEntry { symbol: symbol as U8, bits: length } }
        }
        Val((Huffman { log: log, entries: ^entries }, used))
    }
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:309
    fn stream(self: &Huffman, source: &[U8], expected: USize) -> [U8]? {
        bits := ReverseBits.new(source)?
        state := bits.read(self.log)
        out := [U8].with_capacity(expected)
        loop bits.remaining > -ISize.from(self.log) {
            entry :: self.entries.get(state)?
            out.push(entry.symbol)
            state = ((state << entry.bits) & (self.entries.len() - 1)) | bits.read(entry.bits)
            if out.len() > expected { return None }
        }
        if bits.remaining == -ISize.from(self.log) && out.len() == expected { Val(^out) } else { None }
    }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:326
#Derive(Default)
struct HuffmanState { table: Huffman? }
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:328
fn literals(block: &[U8], state: &HuffmanState) -> ([U8], USize)? {
    first :: block.first()?
    kind :: first & 3
    format :: (first >> 2) & 3
    if kind < 2 {
        (header, size) :: if format == {
            0 | 2 -> (USize{1}, USize.from(first >> 3))
            1 -> (USize{2}, USize.from(first >> 4) + (USize.from(block.get(1)?) << 4))
            _ -> (USize{3}, USize.from(first >> 4) + (USize.from(block.get(1)?) << 4) + (USize.from(block.get(2)?) << 12))
        }
        if size > BLOCK_MAX { return None }
        return if kind == 0 { Val((block.get(header..<header + size)?.to_vec(), header + size)) }
        else { Val(([U8].filled(size, block.get(header)?), header + 1)) }
    }
    (header, streams, regenerated, compressed) :: if format == {
        0 | 1 -> (USize{3}, if format == 0 { 1 } else { 4 }, USize.from(first >> 4) + ((USize.from(block.get(1)?) & 0x3f) << 4), USize.from(block.get(1)? >> 6) + (USize.from(block.get(2)?) << 2))
        2 -> (USize{4}, 4, USize.from(first >> 4) + (USize.from(block.get(1)?) << 4) + ((USize.from(block.get(2)?) & 3) << 12), (USize.from(block.get(2)?) >> 2) + (USize.from(block.get(3)?) << 6))
        _ -> (USize{5}, 4, USize.from(first >> 4) + (USize.from(block.get(1)?) << 4) + ((USize.from(block.get(2)?) & 0x3f) << 12), (USize.from(block.get(2)?) >> 6) + (USize.from(block.get(3)?) << 2) + (USize.from(block.get(4)?) << 10))
    }
    if regenerated > BLOCK_MAX || compressed == 0 || (streams == 4 && regenerated < 6) { return None }
    payload :: block.get(header..<header + compressed)?
    tree_used :: if kind == 2 {
        (table, used) :: Huffman.parse(payload)?
        state.table = Val(^table)
        used
    } else { 0 }
    table :: state.table.as_ref()?
    source :: payload.get(tree_used..<payload.len())?
    out :: if streams == 1 { table.stream(source, regenerated)? } else {
        one :: USize.from(U16.from_le_bytes(source.get(0..<2)?.try_into().ok()?))
        two :: USize.from(U16.from_le_bytes(source.get(2..<4)?.try_into().ok()?))
        three :: USize.from(U16.from_le_bytes(source.get(4..<6)?.try_into().ok()?))
        source :: source.get(6..<source.len())?
        split2 :: one.checked_add(two)?
        split3 :: split2.checked_add(three)?
        each :: regenerated.div_ceil(4)
        out := [U8].with_capacity(regenerated)
        out.extend(table.stream(source.get(0..<one)?, each)?)
        out.extend(table.stream(source.get(one..<split2)?, each)?)
        out.extend(table.stream(source.get(split2..<split3)?, each)?)
        out.extend(table.stream(source.get(split3..<source.len())?, regenerated.checked_sub(each * 3)?)?)
        ^out
    }
    Val((^out, header + compressed))
}
