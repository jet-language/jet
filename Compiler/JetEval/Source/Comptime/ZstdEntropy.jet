    fn read(self: &ReverseBits, count: U8) -> USize {
        value: USize = 0
        loop _ in 0..<count {
            value = (value << 1) | USize.from(self.bits.get(self.next).unwrap_or(&0))
            self.next += 1
            self.remaining -= 1
        }
        value
    }
}
