struct FseEntry { baseline: USize, bits: U8, symbol: U8 }
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:15
struct ForwardBits { source: &[U8], bit: USize }
impl ForwardBits {
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:21
    fn read(self: &ForwardBits, count: USize) -> U32? {
        if self.bit.checked_add(count)? > self.source.len() * 8 { return None }
        value: U32 = 0
        loop shift in 0..<count {
            value |= U32.from((self.source[self.bit / 8] >> (self.bit % 8)) & 1) << shift
            self.bit += 1
        }
        Val(value)
    }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:34
struct ReverseBits { bits: [U8], next: USize, remaining: ISize }
impl ReverseBits {
    // Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:41
    fn new(source: &[U8]) -> ReverseBits? {
        last :: source.last()?
        if last == 0 { return None }
        marker :: USize{7}.checked_sub(last.leading_zeros() as USize)?
        bits := [U8].with_capacity((source.len() - 1) * 8 + marker)
        loop bit in (0..<marker).rev() { bits.push((last >> bit) & 1) }
        loop byte in source[0..<source.len() - 1].iter().rev() {
            loop bit in (0..<8).rev() { bits.push((byte >> bit) & 1) }
        }
        Val(ReverseBits { remaining: bits.len() as ISize, bits: ^bits, next: 0 })
    }
