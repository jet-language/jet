// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:461
fn sequence_count(source: &[U8]) -> (USize, USize)? {
    first :: source.first()?
    if first <= 127 { Val((USize.from(source[0]), 1)) }
    else if first <= 254 { Val((((USize.from(source[0]) - 128) << 8) + USize.from(source.get(1)?), 2)) }
    else { Val((USize.from(source.get(1)?) + (USize.from(source.get(2)?) << 8) + 0x7f00, 3)) }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:475
fn sequence_table(mode: U8, source: &[U8], current: &FseTable?, max_log: U8, max_symbol: USize, default_log: U8, default: &[I32]) -> USize? {
    if mode == {
        0 -> { current = Val(FseTable.from_probabilities(default_log, default)?); Val(0) }
        1 -> {
            symbol :: source.first()?
            if USize.from(symbol) > max_symbol { return None }
            current = Val(FseTable { log: 0, entries: [FseEntry { baseline: 0, bits: 0, symbol: symbol }] })
            Val(1)
        }
        2 -> { (table, used) :: FseTable.parse(source, max_log, max_symbol)?; current = Val(^table); Val(used) }
        3 -> current.as_ref().map(fn(_) { USize{0} })
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:514
fn update_sequence_state(table: &FseTable, entry: FseEntry, bits: &ReverseBits) -> USize? {
    state :: entry.baseline.checked_add(bits.read(entry.bits))?
    if state < table.entries.len() { Val(state) } else { None }
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:523
fn resolve_offset(value: USize, literals: USize, recent: &[USize; 3]) -> USize? {
    actual :: if literals != 0 {
        if value >= 1 && value <= 3 { recent[value - 1] } else { value.checked_sub(3)? }
    } else {
        if value >= 1 && value <= 2 { recent[value] } else if value == 3 { recent[0].checked_sub(1)? } else { value.checked_sub(3)? }
    }
    if actual == 0 { return None }
    if literals != 0 && value == 1 {}
    else if (literals != 0 && value == 2) || (literals == 0 && value == 1) { recent[1] = recent[0]; recent[0] = actual }
    else { recent[2] = recent[1]; recent[1] = recent[0]; recent[0] = actual }
    Val(actual)
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:554
fn append_match(out: &[U8], frame_start: USize, offset: USize, length: USize, window: USize, maximum: USize) -> ()? {
    if offset > window || out.len().checked_sub(offset)? < frame_start { return None }
    if out.len().checked_add(length)? > maximum { return None }
    loop _ in 0..<length { out.push(out[out.len() - offset]) }
    Val(())
}
// Rust: crates/jet-comptime/src/Comptime/ZstdEntropy.rs:574
fn sequences(source: &[U8], literals: &[U8], state: &SequenceState, out: &[U8], frame_start: USize, window: USize, block_max: USize, maximum: USize) -> ()? {
    block_start :: out.len()
    (count, used) := sequence_count(source)?
    if count == 0 {
        if used != source.len() || out.len().checked_add(literals.len())? > maximum { return None }
        out.extend_from_slice(literals)
        return if out.len() - block_start <= block_max { Val(()) } else { None }
    }
    modes :: source.get(used)?
    used += 1
    if modes & 3 != 0 { return None }
    ll_mode :: modes >> 6
    of_mode :: (modes >> 4) & 3
    ml_mode :: (modes >> 2) & 3
    table_source :: source.get(used..<source.len())?
    used += sequence_table(ll_mode, table_source, &state.literal_lengths, 9, 35, 6, &LL_DEFAULT)?
    table_source :: source.get(used..<source.len())?
    used += sequence_table(of_mode, table_source, &state.offsets, 8, 31, 5, &OF_DEFAULT)?
    table_source :: source.get(used..<source.len())?
    used += sequence_table(ml_mode, table_source, &state.match_lengths, 9, 52, 6, &ML_DEFAULT)?
    ll_table :: state.literal_lengths.as_ref()?
    of_table :: state.offsets.as_ref()?
    ml_table :: state.match_lengths.as_ref()?
    bits := ReverseBits.new(source.get(used..<source.len())?)?
    ll_state := bits.read(ll_table.log)
    of_state := bits.read(of_table.log)
    ml_state := bits.read(ml_table.log)
    if bits.remaining < 0 { return None }
    literal: USize = 0
    loop index in 0..<count {
        ll_entry :: ll_table.entries.get(ll_state)?
        of_entry :: of_table.entries.get(of_state)?
        ml_entry :: ml_table.entries.get(ml_state)?
        ll_code :: USize.from(ll_entry.symbol)
        ml_code :: USize.from(ml_entry.symbol)
        of_code :: of_entry.symbol
        offset_value :: (USize{1} << of_code).checked_add(bits.read(of_code))?
        match_length :: ML_BASE.get(ml_code)?.checked_add(bits.read(ML_BITS[ml_code]))?
        literal_length :: LL_BASE.get(ll_code)?.checked_add(bits.read(LL_BITS[ll_code]))?
        if bits.remaining < 0 { return None }
        literal_end :: literal.checked_add(literal_length)?
        selected :: literals.get(literal..<literal_end)?
        after_sequence :: out.len().checked_add(selected.len())?.checked_add(match_length)?
        if after_sequence > maximum || after_sequence.checked_sub(block_start)? > block_max { return None }
        out.extend_from_slice(selected)
        literal = literal_end
        offset :: resolve_offset(offset_value, literal_length, &state.recent_offsets)?
        append_match(out, frame_start, offset, match_length, window, maximum)?
        if index + 1 < count {
            ll_state = update_sequence_state(ll_table, ll_entry, &bits)?
            ml_state = update_sequence_state(ml_table, ml_entry, &bits)?
            of_state = update_sequence_state(of_table, of_entry, &bits)?
            if bits.remaining < 0 { return None }
        }
    }
    if bits.remaining != 0 { return None }
    remaining :: literals.get(literal..<literals.len())?
    end :: out.len().checked_add(remaining.len())?
    if end > maximum || end.checked_sub(block_start)? > block_max { return None }
    out.extend_from_slice(remaining)
    Val(())
}
