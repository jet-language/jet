fn runtime_to_worker(v: &MIRRuntimeValue, span: Span) -> JetServiceWorker Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> { if name != "ServiceWorker" -> fail unsupported("ServiceWorker", span); fields } else -> fail unsupported("ServiceWorker", span) }
    field :: fn(name: String) -> MIRRuntimeValue Diagnostic! { loop field in fields { if field.name == name -> return field.value }; fail unsupported("worker field", span) }
