        return MIRRuntimeValue.Struct{type_name: ^type_name, fields: ^fields}
    }
    fail unsupported("workflow handle state", span)
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:818
fn runtime_to_workflow_handle(value: &MIRRuntimeValue, span: Span) -> JetWorkflowHandle Diagnostic! {
    (type_name, fields) :: if value == { .Struct(name, fields) -> { if name != "ServiceWorkflow" -> fail unsupported("ServiceWorkflow", span); (name, fields) } else -> fail unsupported("ServiceWorkflow", span) }
    authority :: fields.iter().find(fn(field) -> field.name == "authority") ?? fail unsupported("workflow handle authority", span)
    authority :: runtime_to_state_authority(&authority.value, span)!
    filtered := [MIRRuntimeField]{}
    loop field in fields { if field.name != "authority" -> filtered.push(field.clone()) }
    workflow :: runtime_to_workflow(&MIRRuntimeValue.Struct{type_name: type_name.clone(), fields: ^filtered}, span)!
    JetWorkflowHandle{authority: ^authority, state: Arc.new(Mutex.new(^workflow))}
}
