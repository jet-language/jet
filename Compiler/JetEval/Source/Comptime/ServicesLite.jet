        else -> fail unsupported("mailbox messages", span)
    }
    depth :: if field("depth")! == { .Int(n) -> n else -> fail unsupported("mailbox depth", span) }
    endpoint :: runtime_to_endpoint(field("endpoint")!, span)!
    authoritative_messages :: service_authority_channel(&endpoint).ok().map(fn((_, _, channel)) -> channel.snapshot())
    has_authority_channel :: authoritative_messages != None
    messages :: authoritative_messages ?? ^messages
    mailbox :: jet_services_new_mailbox(^endpoint, capacity, ^messages) catch _ -> fail unsupported("ServiceMailbox channel", span)
    if depth < 0 || (!has_authority_channel && mailbox.channel.depth() as I64 != depth) -> fail unsupported("mailbox depth", span)
    ^mailbox
}
