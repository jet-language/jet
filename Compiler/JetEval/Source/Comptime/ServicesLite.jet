fn workflow_to_runtime(w: &JetServiceWorkflow) -> MIRRuntimeValue Never! {
    steps := [MIRRuntimeValue]{}; loop value in w.steps -> steps.push(MIRRuntimeValue.String{value: value.clone()})
    history := [MIRRuntimeValue]{}; loop value in w.history -> history.push(MIRRuntimeValue.String{value: value.clone()})
    outcomes := [MIRRuntimeValue]{}
    loop (key, outcome) in w.activity_outcomes -> outcomes.push(MIRRuntimeValue.Struct{type_name: "ServiceActivityOutcome", fields: [MIRRuntimeField]{MIRRuntimeField{name: "key", value: MIRRuntimeValue.String{value: key.clone()}}, MIRRuntimeField{name: "outcome", value: task_outcome_to_runtime(outcome)}}})
    MIRRuntimeValue.Struct{type_name: "ServiceWorkflow", fields: [MIRRuntimeField]{
        MIRRuntimeField{name: "id", value: MIRRuntimeValue.String{value: w.id.clone()}},
        MIRRuntimeField{name: "run_id", value: MIRRuntimeValue.Int{value: w.run_id}},
        MIRRuntimeField{name: "version", value: MIRRuntimeValue.Int{value: w.version}},
        MIRRuntimeField{name: "steps", value: MIRRuntimeValue.List{values: ^steps}},
        MIRRuntimeField{name: "history", value: MIRRuntimeValue.List{values: ^history}},
        MIRRuntimeField{name: "replay_cursor", value: MIRRuntimeValue.Int{value: w.replay_cursor as I64}},
        MIRRuntimeField{name: "status", value: task_status_to_runtime(&w.status)},
        MIRRuntimeField{name: "activity_outcomes", value: MIRRuntimeValue.List{values: ^outcomes}},
        MIRRuntimeField{name: "outcome", value: if w.outcome == { Val(value) -> MIRRuntimeValue.Present{value: task_outcome_to_runtime(value)} else -> mir_absent("TaskOutcome") }}
    }}
}
