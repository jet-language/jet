    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:863
fn runtime_to_workflow(v: &MIRRuntimeValue, span: Span) -> JetServiceWorkflow Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> { if name != "ServiceWorkflow" -> fail unsupported("ServiceWorkflow", span); fields } else -> fail unsupported("ServiceWorkflow", span) }
    field :: fn(name: String) -> MIRRuntimeValue Diagnostic! { loop field in fields { if field.name == name -> return field.value }; fail unsupported("workflow field", span) }
    str_list :: fn(name: String) -> [String] Diagnostic! {
        xs :: if field(name)! == { .List(xs) -> xs else -> fail unsupported("workflow string list", span) }
        if xs.len() > MAX_SERVICE_WORKFLOW_STEPS -> fail unsupported("workflow string limit", span)
        out := [String]{}; loop x in xs -> out.push(runtime_to_service_string(x, MAX_SERVICE_MESSAGE, "workflow string", span)!)
        ^out
    }
    id :: runtime_to_service_string(field("id")!, MAX_SERVICE_NAME, "workflow id", span)!
    run_id :: if field("run_id")! == { .Int(n) -> n else -> fail unsupported("workflow run id", span) }
    version :: if field("version")! == { .Int(n) -> n else -> fail unsupported("workflow version", span) }
    steps :: str_list("steps")!
    history :: str_list("history")!
    replay_cursor :: if field("replay_cursor")! == { .Int(n) if n >= 0 -> USize.try_from(n).ok() ?? fail unsupported("workflow replay cursor", span) else -> fail unsupported("workflow replay cursor", span) }
    status :: runtime_to_task_status(field("status")!, span)!
    activity_outcomes := [(String, JetTaskOutcome)]{}
    if field("activity_outcomes")! == {
        .List(entries) -> loop entry in entries {
            fields :: if entry == { .Struct(name, fields) -> { if name != "ServiceActivityOutcome" -> fail unsupported("ServiceActivityOutcome", span); fields } else -> fail unsupported("ServiceActivityOutcome", span) }
            key :: fields.iter().find(fn(field) -> field.name == "key") ?? fail unsupported("activity outcome key", span)
            key :: runtime_to_service_string(&key.value, MAX_SERVICE_NAME, "activity outcome key", span)!
            outcome :: fields.iter().find(fn(field) -> field.name == "outcome") ?? fail unsupported("activity outcome value", span)
            outcome :: runtime_to_task_outcome(&outcome.value, span)!
            activity_outcomes.push((^key, ^outcome))
        }
        else -> fail unsupported("activity outcomes", span)
    }
    outcome :: if field("outcome")! == { .Absent(_) -> None; .Present(value) -> Val(runtime_to_task_outcome(value, span)!); else -> fail unsupported("workflow outcome", span) }
    JetServiceWorkflow{id: ^id, run_id: run_id, version: version, steps: ^steps, history: ^history, replay_cursor: replay_cursor, status: ^status, activity_outcomes: ^activity_outcomes, outcome: ^outcome}
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:951
fn upgrade_receipt_to_runtime(receipt: &JetServiceUpgradeReceipt) -> MIRRuntimeValue Never! {
    shards := [MIRRuntimeValue]{}; loop shard in receipt.pinned_shards -> shards.push(MIRRuntimeValue.String{value: shard.clone()})
    MIRRuntimeValue.Struct{type_name: "ServiceUpgradeReceipt", fields: [MIRRuntimeField]{
        MIRRuntimeField{name: "from_generation", value: MIRRuntimeValue.Int{value: receipt.from_generation}},
        MIRRuntimeField{name: "to_generation", value: MIRRuntimeValue.Int{value: receipt.to_generation}},
        MIRRuntimeField{name: "migration", value: MIRRuntimeValue.String{value: receipt.migration.clone()}},
        MIRRuntimeField{name: "rollback_store", value: MIRRuntimeValue.String{value: receipt.rollback_store.clone()}},
        MIRRuntimeField{name: "rollback_available", value: MIRRuntimeValue.Bool{value: receipt.rollback_available}},
        MIRRuntimeField{name: "pinned_shards", value: MIRRuntimeValue.List{values: ^shards}}
    }}
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:990
fn runtime_to_upgrade_receipt(v: &MIRRuntimeValue, span: Span) -> JetServiceUpgradeReceipt Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> { if name != "ServiceUpgradeReceipt" -> fail unsupported("ServiceUpgradeReceipt", span); fields } else -> fail unsupported("ServiceUpgradeReceipt", span) }
    field :: fn(name: String) -> MIRRuntimeValue Diagnostic! { loop field in fields { if field.name == name -> return field.value }; fail unsupported("ServiceUpgradeReceipt field", span) }
    JetServiceUpgradeReceipt{
        from_generation: if field("from_generation")! == { .Int(n) -> n else -> fail unsupported("upgrade from generation", span) },
        to_generation: if field("to_generation")! == { .Int(n) -> n else -> fail unsupported("upgrade to generation", span) },
        migration: runtime_to_service_string(field("migration")!, 32, "upgrade migration", span)!,
        rollback_store: runtime_to_service_string(field("rollback_store")!, MAX_SERVICE_STATE_STORE, "upgrade rollback store", span)!,
        rollback_available: if field("rollback_available")! == { .Bool(value) -> value else -> fail unsupported("upgrade rollback availability", span) },
        pinned_shards: runtime_str_list(field("pinned_shards")!, span)!
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:1028
fn tree_to_runtime(tree: &JetServiceTree) -> MIRRuntimeValue Never! {
    workers := [MIRRuntimeValue]{}; loop w in tree.workers -> workers.push(worker_to_runtime(w))
    groups := [MIRRuntimeValue]{}
    loop g in tree.groups {
        names := [MIRRuntimeValue]{}; loop name in g.workers -> names.push(MIRRuntimeValue.String{value: name.clone()})
        groups.push(MIRRuntimeValue.Struct{type_name: "ServiceGroup", fields: [MIRRuntimeField]{MIRRuntimeField{name: "name", value: MIRRuntimeValue.String{value: g.name.clone()}}, MIRRuntimeField{name: "restart", value: restart_to_runtime(g.restart.clone())}, MIRRuntimeField{name: "budget", value: restart_budget_to_runtime(&g.budget)}, MIRRuntimeField{name: "workers", value: MIRRuntimeValue.List{values: ^names}}}})
    }
    event_log := [MIRRuntimeValue]{}; loop value in tree.event_log -> event_log.push(MIRRuntimeValue.String{value: value.clone()})
    dead_letters := [MIRRuntimeValue]{}; loop value in tree.dead_letters -> dead_letters.push(MIRRuntimeValue.String{value: value.clone()})
    idempotency := [MIRRuntimeValue]{}
    loop (key, endpoint, message) in tree.idempotency_seen -> idempotency.push(MIRRuntimeValue.Struct{type_name: "ServiceIdempotencyEntry", fields: [MIRRuntimeField]{MIRRuntimeField{name: "key", value: MIRRuntimeValue.String{value: key.clone()}}, MIRRuntimeField{name: "endpoint", value: endpoint_to_runtime(endpoint)}, MIRRuntimeField{name: "message", value: MIRRuntimeValue.String{value: message.clone()}}}})
    directory := [MIRRuntimeValue]{}
    loop (name, endpoint, signature) in tree.directory -> directory.push(MIRRuntimeValue.Struct{type_name: "ServiceDirectoryEntry", fields: [MIRRuntimeField]{MIRRuntimeField{name: "name", value: MIRRuntimeValue.String{value: name.clone()}}, MIRRuntimeField{name: "endpoint", value: endpoint_to_runtime(endpoint)}, MIRRuntimeField{name: "signature", value: MIRRuntimeValue.String{value: signature.clone()}}}})
    draining := [MIRRuntimeValue]{}; loop value in tree.draining -> draining.push(MIRRuntimeValue.String{value: value.clone()})
    partitioned := [MIRRuntimeValue]{}; loop value in tree.partitioned -> partitioned.push(MIRRuntimeValue.String{value: value.clone()})
    workflows := [MIRRuntimeValue]{}; loop value in tree.workflows -> workflows.push(workflow_to_runtime(value))
    MIRRuntimeValue.Struct{type_name: "ServiceTree", fields: [MIRRuntimeField]{
        MIRRuntimeField{name: "name", value: MIRRuntimeValue.String{value: tree.name.clone()}},
        MIRRuntimeField{name: "authority", value: MIRRuntimeValue.String{value: tree.authority.clone()}},
        MIRRuntimeField{name: "generation", value: MIRRuntimeValue.Int{value: tree.generation}},
        MIRRuntimeField{name: "delivery", value: delivery_to_runtime(tree.delivery.clone())},
        MIRRuntimeField{name: "restart", value: restart_to_runtime(tree.restart.clone())},
        MIRRuntimeField{name: "restart_budget", value: restart_budget_to_runtime(&tree.restart_budget)},
        MIRRuntimeField{name: "workers", value: MIRRuntimeValue.List{values: ^workers}},
        MIRRuntimeField{name: "groups", value: MIRRuntimeValue.List{values: ^groups}},
        MIRRuntimeField{name: "started", value: MIRRuntimeValue.Bool{value: tree.started}},
        MIRRuntimeField{name: "state_adapter", value: state_adapter_to_runtime(tree.state_adapter.clone())},
        MIRRuntimeField{name: "state_authority", value: if tree.state_authority == { Val(value) -> MIRRuntimeValue.Present{value: state_authority_to_runtime(value)} else -> mir_absent("ServiceStateAuthority") }},
        MIRRuntimeField{name: "snapshot", value: MIRRuntimeValue.String{value: tree.snapshot.clone() ?? ""}},
        MIRRuntimeField{name: "event_log", value: MIRRuntimeValue.List{values: ^event_log}},
        MIRRuntimeField{name: "dead_letters", value: MIRRuntimeValue.List{values: ^dead_letters}},
        MIRRuntimeField{name: "idempotency_seen", value: MIRRuntimeValue.List{values: ^idempotency}},
        MIRRuntimeField{name: "directory", value: MIRRuntimeValue.List{values: ^directory}},
        MIRRuntimeField{name: "draining", value: MIRRuntimeValue.List{values: ^draining}},
        MIRRuntimeField{name: "partitioned", value: MIRRuntimeValue.List{values: ^partitioned}},
        MIRRuntimeField{name: "workflows", value: MIRRuntimeValue.List{values: ^workflows}},
        MIRRuntimeField{name: "chaos_fails", value: MIRRuntimeValue.Int{value: tree.chaos_fails}},
        MIRRuntimeField{name: "previous_generation", value: MIRRuntimeValue.Int{value: tree.previous_generation}},
        MIRRuntimeField{name: "last_upgrade", value: if tree.last_upgrade == { Val(value) -> MIRRuntimeValue.Present{value: upgrade_receipt_to_runtime(value)} else -> mir_absent("ServiceUpgradeReceipt") }}
    }}
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:1166
fn runtime_str_list(v: &MIRRuntimeValue, span: Span) -> [String] Diagnostic! {
    xs :: if v == { .List(xs) -> xs else -> fail unsupported("string list", span) }
    if xs.len() > MAX_SERVICE_STATE_RECORDS -> fail unsupported("string list length", span)
    out := [String]{}
    loop x in xs { if x == { .String(s) if s.len() <= MAX_SERVICE_MESSAGE && !s.chars().any(fn(c) -> c.is_control()) -> out.push(s.clone()) else -> fail unsupported("string list", span) } }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:1187
fn runtime_to_tree(v: &MIRRuntimeValue, span: Span) -> JetServiceTree Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> { if name != "ServiceTree" -> fail unsupported("ServiceTree", span); fields } else -> fail unsupported("ServiceTree", span) }
    field :: fn(name: String) -> MIRRuntimeValue Diagnostic! { loop field in fields { if field.name == name -> return field.value }; fail unsupported("tree field", span) }
    workers := [JetServiceWorker]{}
    if field("workers")! == {
        .List(xs) -> { if xs.len() > MAX_SERVICE_WORKERS -> fail unsupported("tree worker limit", span); loop x in xs -> workers.push(runtime_to_worker(x, span)!) }
        else -> fail unsupported("tree workers", span)
    }
    groups := [JetServiceGroup]{}
    if field("groups")! == {
        .List(xs) -> {
            if xs.len() > MAX_SERVICE_WORKERS -> fail unsupported("tree group limit", span)
            loop x in xs {
                fields :: if x == { .Struct(name, fields) -> { if name != "ServiceGroup" -> fail unsupported("ServiceGroup", span); fields } else -> fail unsupported("ServiceGroup", span) }
                name :: fields.iter().find(fn(field) -> field.name == "name") ?? fail unsupported("group name", span)
                name :: runtime_to_service_string(&name.value, MAX_SERVICE_NAME, "group name", span)!
                restart :: fields.iter().find(fn(field) -> field.name == "restart") ?? fail unsupported("group restart", span)
                restart :: runtime_to_restart(&restart.value, span)!
                budget :: fields.iter().find(fn(field) -> field.name == "budget") ?? fail unsupported("group restart budget", span)
                budget :: runtime_to_restart_budget(&budget.value, span)!
                worker_field :: fields.iter().find(fn(field) -> field.name == "workers") ?? fail unsupported("group workers", span)
                workers := [String]{}
                if worker_field.value == {
                    .List(xs) -> { if xs.len() > MAX_SERVICE_WORKERS -> fail unsupported("group worker limit", span); loop x in xs -> workers.push(runtime_to_service_string(x, MAX_SERVICE_NAME, "group worker", span)!) }
                    else -> fail unsupported("group workers", span)
                }
                groups.push(JetServiceGroup{name: ^name, restart: ^restart, budget: ^budget, workers: ^workers})
            }
        }
        else -> fail unsupported("tree groups", span)
    }
    directory := [(String, JetServiceEndpoint, String)]{}
    if field("directory")! == {
        .List(xs) -> {
            if xs.len() > MAX_SERVICE_WORKERS -> fail unsupported("service directory limit", span)
            loop x in xs {
                fields :: if x == { .Struct(name, fields) -> { if name != "ServiceDirectoryEntry" -> fail unsupported("directory entry", span); fields } else -> fail unsupported("directory entry", span) }
                name :: fields.iter().find(fn(field) -> field.name == "name") ?? fail unsupported("directory name", span)
                name :: runtime_to_service_string(&name.value, MAX_SERVICE_NAME, "directory name", span)!
                endpoint :: fields.iter().find(fn(field) -> field.name == "endpoint") ?? fail unsupported("directory endpoint", span)
                signature :: fields.iter().find(fn(field) -> field.name == "signature") ?? fail unsupported("directory signature", span)
                signature :: runtime_to_service_string(&signature.value, 64, "directory signature", span)!
                directory.push((^name, runtime_to_endpoint(&endpoint.value, span)!, ^signature))
            }
        }
        else -> fail unsupported("service directory", span)
    }
    workflows := [JetServiceWorkflow]{}
    if field("workflows")! == {
        .List(xs) -> { if xs.len() > MAX_SERVICE_WORKFLOW_STEPS -> fail unsupported("service workflow limit", span); loop x in xs -> workflows.push(runtime_to_workflow(x, span)!) }
        else -> fail unsupported("service workflows", span)
    }
    snapshot :: runtime_to_service_string(field("snapshot")!, MAX_SERVICE_MESSAGE, "service snapshot", span)!
    snapshot :: if snapshot.is_empty() -> None else -> Val(^snapshot)
    state_authority := JetServiceStateAuthority?{None}
    if fields.iter().find(fn(field) -> field.name == "state_authority") == Val(field) {
        if field.value == { .Absent(_) -> {}; .Present(value) -> state_authority = Val(runtime_to_state_authority(value, span)!); else -> fail unsupported("service state authority", span) }
    }
    last_upgrade := JetServiceUpgradeReceipt?{None}
    if fields.iter().find(fn(field) -> field.name == "last_upgrade") == Val(field) {
        if field.value == { .Absent(_) -> {}; .Present(value) -> last_upgrade = Val(runtime_to_upgrade_receipt(value, span)!); else -> fail unsupported("service upgrade receipt", span) }
    }
    partitioned :: if fields.iter().find(fn(field) -> field.name == "partitioned") == { Val(field) -> runtime_str_list(&field.value, span)! else -> [String]{} }
    idempotency_seen := [(String, JetServiceEndpoint, String)]{}
    if field("idempotency_seen")! == {
        .List(entries) -> {
            if entries.len() > MAX_SERVICE_IDEMPOTENCY -> fail unsupported("service idempotency limit", span)
            loop entry in entries {
                fields :: if entry == { .Struct(name, fields) -> { if name != "ServiceIdempotencyEntry" -> fail unsupported("idempotency entry", span); fields } else -> fail unsupported("idempotency entry", span) }
                field :: fn(name: String) -> MIRRuntimeValue Diagnostic! { loop field in fields { if field.name == name -> return field.value }; fail unsupported("idempotency field", span) }
                key :: runtime_to_service_string(field("key")!, MAX_SERVICE_NAME, "idempotency key", span)!
                endpoint :: runtime_to_endpoint(field("endpoint")!, span)!
                message :: runtime_to_service_string(field("message")!, MAX_SERVICE_MESSAGE, "idempotency message", span)!
                idempotency_seen.push((^key, ^endpoint, ^message))
            }
        }
        else -> fail unsupported("service idempotency state", span)
    }
    tree := JetServiceTree{
        name: runtime_to_service_string(field("name")!, MAX_SERVICE_NAME, "tree name", span)!,
        authority: runtime_to_service_string(field("authority")!, MAX_SERVICE_NAME, "tree authority", span)!,
        generation: if field("generation")! == { .Int(n) -> n else -> fail unsupported("tree generation", span) },
        delivery: runtime_to_delivery(field("delivery")!, span)!,
        restart: runtime_to_restart(field("restart")!, span)!,
        restart_budget: runtime_to_restart_budget(field("restart_budget")!, span)!,
        workers: ^workers, groups: ^groups,
        started: if field("started")! == { .Bool(b) -> b else -> fail unsupported("tree started state", span) },
        state_adapter: runtime_to_state_adapter(field("state_adapter")!, span)!,
        state_authority: ^state_authority, snapshot: ^snapshot,
        event_log: runtime_str_list(field("event_log")!, span)!,
        dead_letters: runtime_str_list(field("dead_letters")!, span)!,
        idempotency_seen: ^idempotency_seen, directory: ^directory,
        draining: runtime_str_list(field("draining")!, span)!,
        partitioned: ^partitioned, workflows: ^workflows,
        task_group: Arc.new(JetTaskGroupRuntime.new()), supervisor_tasks: [],
        chaos_fails: if field("chaos_fails")! == { .Int(n) -> n else -> fail unsupported("service chaos counter", span) },
        previous_generation: if field("previous_generation")! == { .Int(n) -> n else -> fail unsupported("previous service generation", span) },
        last_upgrade: ^last_upgrade
    }
    jet_services_validate_tree(&tree) catch error -> fail unsupported(error.jet_show(), span)
    loop worker in tree.workers {
        draining :: tree.draining.iter().any(fn(name) -> name == worker.name)
        partitioned :: tree.partitioned.iter().any(fn(name) -> name == worker.name)
        started :: tree.started && !partitioned && (worker.running || draining)
        jet_services_authority_hydrate(&worker.endpoint, started) catch error -> fail unsupported(error.jet_show(), span)
        if partitioned { jet_services_authority_update_partitioned(&worker.endpoint, true) catch error -> fail unsupported(error.jet_show(), span) }
        if tree.started { jet_services_authority_update_draining(&worker.endpoint, draining) catch error -> fail unsupported(error.jet_show(), span) }
        if started { jet_services_bind_delivery_endpoint(&tree.delivery, tree.state_authority.as_ref(), &worker.endpoint) catch error -> fail unsupported(error.jet_show(), span) }
    }
    if tree.started { jet_services_build_runtime_groups(&tree) catch error -> fail unsupported(error.jet_show(), span) }
    ^tree
}
