    JetServiceWorker{name: ^name, handler_name: ^handler_name, handler: jet_services_noop_worker, endpoint: ^endpoint, mailbox: ^mailbox, restarts: ^restarts, running: running, received_bytes: 0, sent_bytes: 0, task: Arc.new(Mutex.new(JetServiceSupervisorState.new(if running -> JetServiceSupervisorStatus.Running else -> JetServiceSupervisorStatus.Stopped)))}
