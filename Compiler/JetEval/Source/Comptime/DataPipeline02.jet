// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1823
fn data_loader_payload(state: &DataKernel) -> ([U8], Bool) CtValue! {
    payload := try { PreludeDataFlow.payload(state)? } catch(error) { fail data_loader_kernel_failure(^error) }
    if p := payload { return p }
    if state.source.kind == PreludeDataFlow.LoaderKind.File && state.source.member.is_empty() {
        // GATE #4494: checked native file reads use the canonical provider.
        data := try { CheckReads.read(&state.raw_locator)? } catch(error) {
            fail data_loader_failure("IO", "data.loader.file", "could not read `{state.source.locator}`: {error}")
        }
        try { PreludeDataFlow.check_payload(&state.limits, data.len(), "data.loader.file")? }
        catch(error) { fail data_loader_kernel_failure(^error) }
        return (^data, state.offline)
    }
    operation := state.source.kind == { URL -> "data.loader.url"; Database -> "data.loader.database"; File -> "data.loader.archive"; Value -> "data.loader.value" }
    fail data_loader_bridge(operation)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1858
fn data_dynamic_scalar_type(value: &CtValue) -> (String, Bool) {
    value == {
        Enum { type_name, variant, .. } if type_name == "DataTree" -> variant == {
            "Null" -> ("null", true); "Bool" -> ("bool", false); "Number" -> ("float", false)
            "TypedText" | "Text" -> ("text", false); "Array" -> ("array", false); "Object" -> ("object", false); _ -> ("Any", false)
        }
        Bool(_) -> ("bool", false); Int(_) | BigInt(_) -> ("int", false); Float(_) -> ("float", false)
        Str(_) -> ("text", false); Bytes(_) -> ("bytes", false); List(_) -> ("array", false)
        Map(_) | Struct { .. } -> ("object", false); _ -> ("Any", false)
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1885
fn data_dynamic_merge_type(left: &String, right: &String) -> (String, Bool) {
    if left == right { return (left == { "null" | "bool" | "int" | "float" | "text" | "bytes" | "array" | "object" -> left.clone(); _ -> "Any" }, left == "null") }
    if left == "null" { return (right == { "bool" | "int" | "float" | "text" | "bytes" | "array" | "object" -> right.clone(); _ -> "Any" }, true) }
    if right == "null" { return (left == { "bool" | "int" | "float" | "text" | "bytes" | "array" | "object" -> left.clone(); _ -> "Any" }, true) }
    if (left == "int" && right == "float") || (left == "float" && right == "int") { return ("float", false) }
    ("Any", false)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1932
fn data_dynamic_object_fields(value: &CtValue) -> [(String, CtValue)]? {
    value == { Struct { type_name, fields } if type_name == "JSONObject" -> { return Val(fields.clone()) }; _ -> {} }
    JSONInterp.json_payload(value, "Object").and_then(fn(v) { data_dynamic_object_fields(v) })
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1942
fn data_schema_value(tree: &CtValue, format: &String) -> CtValue {
    rows := data_dynamic_rows(tree)
    fields: [String:(String, Bool)] = [:]
    rows_seen: USize = 0
    for row in &rows {
        if entries := data_dynamic_object_fields(row) {
            present := entries.iter().map(fn(entry) { entry.0.clone() }).collect::<BTreeSet<String>>()
            for (name, value) in entries {
                (current, nullable) := data_dynamic_scalar_type(&value)
                (merged, merged_nullable) := fields.get(&name) == {
                    Val((previous, previous_nullable)) -> {
                        (merged, type_nullable) := data_dynamic_merge_type(previous, &current)
                        (^merged, previous_nullable || nullable || type_nullable)
                    }
                    None -> (^current, nullable)
                }
                fields.insert(^name, (^merged, merged_nullable || rows_seen > 0))
            }
            absent := fields.keys().filter(fn(name) { !present.contains(name) }).cloned().collect::<[String]>()
            for name in absent { if entry := fields.get(&name) { fields.insert(^name, (entry.0.clone(), true)) } }
        } else {
            (current, nullable) := data_dynamic_scalar_type(row)
            (merged, merged_nullable) := fields.get("$") == {
                Val((previous, previous_nullable)) -> {
                    (merged, type_nullable) := data_dynamic_merge_type(previous, &current)
                    (^merged, previous_nullable || nullable || type_nullable)
                }
                None -> (^current, nullable || rows_seen > 0)
            }
            fields.insert("$", (^merged, merged_nullable))
        }
        rows_seen = rows_seen.saturating_add(1)
    }
    names := fields.keys().collect::<[&String]>(); names.sort()
    columns := names.iter().enumerate().map(fn(order, name) { entry := &fields[name]; data_column_with_id(order, name, &entry.0, entry.1) }).collect::<[CtValue]>()
    identity := ""
    PreludeDataFlow.identity_part(&identity, format)
    for column in &columns {
        for name in ["id", "name", "type_name", "nullable"] {
            if value := struct_field(column, "DataColumn", name) {
                text := value == { Bool(v) -> v.to_string(); Str(v) -> v.clone(); _ -> "" }
                PreludeDataFlow.identity_part(&identity, &text)
            }
        }
    }
    ct_struct("DataSchema", [("identity", CtValue.Str(PreludeDataFlow.digest(identity.as_bytes()))),
        ("format", data_kernel_format_value(format)), ("columns", CtValue.List(^columns)),
        ("projection", CtValue.absent(Type.Named("ShapeProjection")))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2024
fn data_column_with_id(order: USize, name: &String, type_name: &String, nullable: Bool) -> CtValue {
    ct_struct("DataColumn", [("id", CtValue.Str("column-{order}-{name}")), ("name", CtValue.Str(name.to_string())),
        ("type_name", CtValue.Str(type_name.to_string())), ("nullable", CtValue.Bool(nullable))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2044
fn data_loader_fail_value(loader: &ComptimeLoader, value: &CtValue, operation: &String) {
    kind := struct_field(value, "DataError", "kind") == {
        Val(Enum { variant, .. }) if variant == "Limit" -> PreludeDataFlow.ErrorKind.Limit
        Val(Enum { variant, .. }) if variant == "State" -> PreludeDataFlow.ErrorKind.State
        Val(Enum { variant, .. }) if variant == "Bridge" -> PreludeDataFlow.ErrorKind.Bridge
        _ -> PreludeDataFlow.ErrorKind.InvalidArgument
    }
    reason := struct_field(value, "DataError", "reason").map(query_cell_text).unwrap_or_else(fn() { value.jet_show() })
    error := PreludeDataFlow.KernelError { kind: kind, operation: operation.to_string(), reason: ^reason }
    PreludeDataFlow.fail(&loader.state, &error)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2072
fn data_dynamic_canonical(value: &CtValue) -> CtValue {
    value == {
        Enum { type_name, variant, args } if type_name == "DataTree" && variant == "Object" -> {
            entries := args.first().map(fn(entry) { &entry.1 }) == {
                Val(Struct { type_name: object_type, fields }) if object_type == "JSONObject" -> fields
                _ -> { return value.clone() }
            }
            fields := entries.iter().map(fn(entry) { (entry.0.clone(), data_dynamic_canonical(&entry.1)) }).collect::<[(String, CtValue)]>()
            fields.sort_by(fn(left, right) { left.0.cmp(&right.0) })
            data_dynamic_object(^fields)
        }
        Enum { type_name, variant, args } if type_name == "DataTree" && variant == "Array" -> {
            values := args.first().map(fn(entry) { &entry.1 }) == { Val(List(values)) -> values; _ -> { return value.clone() } }
            data_dynamic_array(values.iter().map(data_dynamic_canonical).collect())
        }
        _ -> value.clone()
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2115
fn data_snapshot_dynamic(loader: &ComptimeLoader, interp: &Interp, span: Span) -> CtValue CtValue! {
    if loader.state.cancelled {
        error := PreludeDataFlow.KernelError { kind: PreludeDataFlow.ErrorKind.State, operation: "data.loader", reason: "loader was cancelled before snapshot" }
        PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error)
    }
    try { PreludeDataFlow.validate_loader(&loader.state)? } catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    try { PreludeDataFlow.validate_limits(&loader.state.limits)? } catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    (payload, offline) := try { data_loader_payload(&loader.state)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
    tree := try { data_dynamic_tree(&payload, &loader.state.format, &loader.state.limits)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
    value := loader.decode_ty == {
        Val(ty) -> {
            decode_tree := if loader.state.format == "csv" { data_typed_tree(&tree) } else { tree.clone() }
            try { interp.typed_decode_top(ty, &decode_tree, span)? } catch(error) {
                failure := data_loader_failure("Decode", "data.loader", "typed decode failed: {typed_decode_failure_text(&error)}")
                data_loader_fail_value(loader, &failure, "data.loader"); fail ^failure
            }
        }
        None -> loader.seed.clone().unwrap_or_else(fn() { tree.clone() })
    }
    canonical_value := if loader.decode_ty.is_some() {
        try { interp.encode_value(&value, span)? } catch(error) {
            failure := data_loader_failure("Decode", "data.loader", format!("typed encode failed: {:?}", error))
            data_loader_fail_value(loader, &failure, "data.loader"); fail ^failure
        }
    } else { data_dynamic_canonical(&value) }
    canonical := JSONInterp.render_ordered_datatree(&canonical_value, false, 0).into_bytes()
    schema := data_schema_value(&tree, &loader.state.format)
    schema_id := struct_field(&schema, "DataSchema", "identity") == { Val(Str(v)) -> v.clone(); _ -> "" }
    state := loader.state.clone()
    facts := try { PreludeDataFlow.commit_snapshot(&state, ^payload, &canonical, &schema_id, offline)? }
        catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    loader.state = ^state
    identity := ct_struct("DataSnapshotIdentity", [("id", CtValue.Str("snapshot-{facts.snapshot_id}")),
        ("source", CtValue.Str("source-{facts.source_id}")), ("content", CtValue.Str(^facts.content_id)),
        ("schema", CtValue.Str(^facts.schema_id)), ("format", data_kernel_format_value(&loader.state.format))])
    provenance := ct_struct("DataProvenance", [("source", data_kernel_source_value(&loader.state.source)),
        ("format", data_kernel_format_value(&loader.state.format)), ("authority", data_kernel_authority_value(&loader.state.authority))])
    ct_struct("DataSnapshot", [("value", ^value), ("identity", ^identity), ("provenance", ^provenance), ("schema", ^schema),
        ("status", data_kernel_status_value(&PreludeDataFlow.status(&loader.state))), ("content", CtValue.Bytes(^canonical))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2246
fn data_stream_row_type(ty: &Type) -> Type { ty == { List(inner) | FixedList { elem: inner, .. } -> inner.as_ref().clone(); _ -> ty.clone() } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2253
fn data_stream_rows(loader: &ComptimeLoader, interp: &Interp, span: Span) -> [CtValue] CtValue! {
    (payload, offline) := data_loader_payload(&loader.state)?
    tree := data_dynamic_tree(&payload, &loader.state.format, &loader.state.limits)?
    rows := data_dynamic_rows(&tree)
    ty := loader.decode_ty.as_ref().map(data_stream_row_type) == { Val(ty) -> ty; None -> { return rows } }
    decoded: [CtValue] = []
    for (index, row) in rows.into_iter().enumerate() {
        tree_row := if loader.state.format == "csv" { data_typed_tree(&row) } else { ^row }
        value := try { interp.typed_decode_top(&ty, &tree_row, span)? } catch(error) {
            fail data_loader_failure("Decode", "data.loader.stream", "typed decode failed at row {index + 1}: {typed_decode_failure_text(&error)}")
        }
        decoded.push(^value)
    }
    decoded
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2287
fn data_stream_next(stream: &ComptimeStream) -> CtValue {
    if stream.cancelled { return data_loader_failure("State", "data.stream", "stream was cancelled") }
    if row := stream.rows.get(stream.cursor).cloned() {
        stream.cursor += 1
        return CtValue.Present(Box.new(CtValue.Present(Box.new(^row))))
    }
    row_ty := stream.row_ty.clone().unwrap_or_else(fn() { Type.Named("Unknown") })
    CtValue.Present(Box.new(CtValue.absent(^row_ty)))
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2301
fn data_state_plain_tree(value: &CtValue) -> CtValue {
    value == {
        Enum { type_name, variant, args } if type_name == "DataTree" -> variant == {
            "Null" -> CtValue.Unit
            "Bool" | "Int" | "Float" | "Text" | "TypedText" | "Bytes" -> args.first().map(fn(entry) { data_state_plain_tree(&entry.1) }).unwrap_or(CtValue.Unit)
            "Number" -> {
                text := args.first().map(fn(entry) { &entry.1 }) == { Val(Str(v)) -> v; _ -> { return CtValue.Unit } }
                text.parse::<I64>().map(fn(v) { CtValue.Int(v) }).or_else(fn(_) { text.parse::<F64>().map(fn(v) { CtValue.Float(CtFloat.f64(v)) }) }).unwrap_or_else(fn(_) { CtValue.Str(text.clone()) })
            }
            "Array" -> CtValue.List(args.first().and_then(fn(entry) { entry.1 == { List(values) -> Val(values.iter().map(data_state_plain_tree).collect::<[CtValue]>()); _ -> None } }).unwrap_or([]))
            "Object" -> CtValue.Struct { type_name: "JSONObject", fields: args.first().and_then(fn(entry) { data_dynamic_object_fields(&entry.1) }).unwrap_or([]).into_iter().map(fn(entry) { (entry.0, data_state_plain_tree(&entry.1)) }).collect() }
            _ -> value.clone()
        }
        List(values) -> CtValue.List(values.iter().map(data_state_plain_tree).collect())
        Map(values) -> {
            plain: [CtKey:CtValue] = [:]
            for (key, value) in values { plain.insert(key.clone(), data_state_plain_tree(value)) }
            CtValue.Map(^plain)
        }
        Struct { type_name, fields } -> CtValue.Struct { type_name: type_name.clone(), fields: fields.iter().map(fn(entry) { (entry.0.clone(), data_state_plain_tree(&entry.1)) }).collect() }
        Present(v) -> data_state_plain_tree(v)
        _ -> value.clone()
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2369
fn data_state_decode_tree(ty: &Type, tree: &CtValue) -> CtValue CtValue! {
    plain := data_state_plain_tree(tree)
    ty == {
        Int | IntN { .. } | InlineRange { .. } -> plain == {
            Int(v) -> CtValue.Int(v)
            Str(v) -> { try { CtValue.Int(v.parse::<I64>()?) } catch(_) { fail data_loader_failure("Decode", "data.loader", "expected Int for `{ty.name()}`") } }
            _ -> { fail data_loader_failure("Decode", "data.loader", "expected Int for `{ty.name()}`") }
        }
        Float | Float32 -> plain == {
            Float(v) -> CtValue.Float(v); Int(v) -> CtValue.Float(CtFloat.f64(v as F64))
            Str(v) -> { try { CtValue.Float(CtFloat.f64(v.parse::<F64>()?)) } catch(_) { fail data_loader_failure("Decode", "data.loader", "expected Float for `{ty.name()}`") } }
            _ -> { fail data_loader_failure("Decode", "data.loader", "expected Float for `{ty.name()}`") }
        }
        Bool -> plain == { Bool(v) -> CtValue.Bool(v); _ -> { fail data_loader_failure("Decode", "data.loader", "expected Bool for `{ty.name()}`") } }
        String -> plain == { Str(v) -> CtValue.Str(^v); _ -> { fail data_loader_failure("Decode", "data.loader", "expected String for `{ty.name()}`") } }
        Char -> plain == {
            Str(v) -> v.chars().next().filter(fn(_) { v.chars().count() == 1 }) == {
                Val(c) -> CtValue.Char(c); None -> { fail data_loader_failure("Decode", "data.loader", "expected one character for `{ty.name()}`") }
            }
            _ -> { fail data_loader_failure("Decode", "data.loader", "expected one character for `{ty.name()}`") }
        }
        Option(inner) -> {
            if plain == { Unit -> true; _ -> false } { CtValue.absent(inner.as_ref().clone()) }
            else { CtValue.Present(Box.new(data_state_decode_tree(inner, tree)?)) }
        }
        List(inner) | FixedList { elem: inner, .. } -> {
            values := plain == { List(v) -> v; _ -> { fail data_loader_failure("Decode", "data.loader", "expected a list for `{ty.name()}`") } }
            decoded := [CtValue].with_capacity(values.len())
            for value in values { decoded.push(data_state_decode_tree(inner, &value)?) }
            CtValue.List(^decoded)
        }
        Map { key, value: value_ty, .. } if key.as_ref() == Type.String -> {
            fields := plain == { Struct { fields, .. } -> fields; _ -> { fail data_loader_failure("Decode", "data.loader", "expected an object for `{ty.name()}`") } }
            // GATE #4499: CtKey map keys preserve canonical equality and ordering.
            decoded: [CtKey:CtValue] = [:]
            for (name, cell) in fields { decoded.insert(CtKey.Str(^name), data_state_decode_tree(value_ty, &cell)?) }
            CtValue.Map(^decoded)
        }
        Map { .. } -> { fail data_loader_failure("Decode", "data.loader", "loader maps require String keys") }
        Result { ok, .. } -> CtValue.Present(Box.new(data_state_decode_tree(ok, tree)?))
        Shared(inner) | Tagged { inner, .. } | Quantity { base: inner, .. } -> data_state_decode_tree(inner, tree)?
        Named(name) | Apply { name, .. } -> plain == { Struct { fields, .. } -> CtValue.Struct { type_name: name.clone(), fields: ^fields }; value -> value }
        Union(_) -> plain
        _ -> { fail data_loader_failure("Decode", "data.loader", "MIR loader cannot decode `{ty.name()}`") }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2517
fn data_state_encode_tree(value: &CtValue) -> CtValue CtValue! {
    value == {
        Int(v) -> JSONInterp.json_variant("Int", Val(CtValue.Int(v)))
        BigInt(v) -> JSONInterp.json_variant("Int", Val(CtValue.BigInt(v.clone())))
        Float(v) -> JSONInterp.json_variant("Float", Val(CtValue.Float(v)))
        Bool(v) -> JSONInterp.json_variant("Bool", Val(CtValue.Bool(v)))
        Str(v) -> JSONInterp.json_variant("Text", Val(CtValue.Str(v.clone())))
        Char(v) -> JSONInterp.json_variant("Text", Val(CtValue.Str(v.to_string())))
        Bytes(v) -> JSONInterp.json_variant("Bytes", Val(CtValue.Bytes(v.clone())))
        List(values) -> {
            out: [CtValue] = []
            for value in values { out.push(data_state_encode_tree(value)?) }
            JSONInterp.json_variant("Array", Val(CtValue.List(^out)))
        }
        Map(values) -> {
            fields: [(String, CtValue)] = []
            keys := values.keys().collect::<[&CtKey]>(); keys.sort()
            for key in keys {
                name := key == { Str(k) -> k; _ -> { fail data_loader_failure("Decode", "data.loader", "loader maps require String keys") } }
                fields.push((name.clone(), data_state_encode_tree(&values[key])?))
            }
            JSONInterp.json_variant("Object", Val(CtValue.Struct { type_name: "JSONObject", fields: ^fields }))
        }
        Struct { fields, .. } -> {
            out: [(String, CtValue)] = []
            for (name, value) in fields { out.push((name.clone(), data_state_encode_tree(value)?)) }
            JSONInterp.json_variant("Object", Val(CtValue.Struct { type_name: "JSONObject", fields: ^out }))
        }
        Present(v) -> data_state_encode_tree(v)?
        Failed(Clean(_)) | Unit -> JSONInterp.json_variant("Null", None)
        Enum { type_name, .. } if type_name == "DataTree" -> value.clone()
        Enum { .. } | Failed(Told(_)) -> { fail data_loader_failure("Decode", "data.loader", "typed loader value has no canonical Encode representation") }
        Closure(_) -> { fail data_loader_failure("Decode", "data.loader", "closures cannot cross the typed loader boundary") }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2605
fn data_snapshot_dynamic_in_state(loader: &ComptimeLoader) -> CtValue CtValue! {
    if loader.state.cancelled {
        error := PreludeDataFlow.KernelError { kind: PreludeDataFlow.ErrorKind.State, operation: "data.loader", reason: "loader was cancelled before snapshot" }
        PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error)
    }
    try { PreludeDataFlow.validate_loader(&loader.state)? } catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    try { PreludeDataFlow.validate_limits(&loader.state.limits)? } catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    (payload, offline) := try { data_loader_payload(&loader.state)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
    tree := try { data_dynamic_tree(&payload, &loader.state.format, &loader.state.limits)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
    value := loader.decode_ty == {
        Val(ty) -> {
            decode_tree := if loader.state.format == "csv" { data_typed_tree(&tree) } else { tree.clone() }
            try { data_state_decode_tree(ty, &decode_tree)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
        }
        None -> loader.seed.clone().unwrap_or_else(fn() { tree.clone() })
    }
    canonical_value := if loader.decode_ty.is_some() {
        try { data_state_encode_tree(&value)? } catch(error) { data_loader_fail_value(loader, &error, "data.loader"); fail ^error }
    } else { data_dynamic_canonical(&value) }
    canonical := JSONInterp.render_ordered_datatree(&canonical_value, false, 0).into_bytes()
    schema := data_schema_value(&tree, &loader.state.format)
    schema_id := struct_field(&schema, "DataSchema", "identity") == { Val(Str(v)) -> v.clone(); _ -> "" }
    state := loader.state.clone()
    facts := try { PreludeDataFlow.commit_snapshot(&state, ^payload, &canonical, &schema_id, offline)? }
        catch(error) { PreludeDataFlow.fail(&loader.state, &error); fail data_loader_kernel_failure(^error) }
    loader.state = ^state
    identity := ct_struct("DataSnapshotIdentity", [("id", CtValue.Str("snapshot-{facts.snapshot_id}")),
        ("source", CtValue.Str("source-{facts.source_id}")), ("content", CtValue.Str(^facts.content_id)),
        ("schema", CtValue.Str(^facts.schema_id)), ("format", data_kernel_format_value(&loader.state.format))])
    provenance := ct_struct("DataProvenance", [("source", data_kernel_source_value(&loader.state.source)),
        ("format", data_kernel_format_value(&loader.state.format)), ("authority", data_kernel_authority_value(&loader.state.authority))])
    ct_struct("DataSnapshot", [("value", ^value), ("identity", ^identity), ("provenance", ^provenance), ("schema", ^schema),
        ("status", data_kernel_status_value(&PreludeDataFlow.status(&loader.state))), ("content", CtValue.Bytes(^canonical))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2724
fn data_stream_rows_in_state(loader: &ComptimeLoader) -> [CtValue] CtValue! {
    (payload, offline) := data_loader_payload(&loader.state)?
    tree := data_dynamic_tree(&payload, &loader.state.format, &loader.state.limits)?
    rows := data_dynamic_rows(&tree)
    ty := loader.decode_ty == { Val(ty) -> ty; None -> { return rows } }
    out: [CtValue] = []
    for row in rows {
        tree_row := if loader.state.format == "csv" { data_typed_tree(&row) } else { ^row }
        out.push(data_state_decode_tree(ty, &tree_row)?)
    }
    out
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:2746
pub fn eval_data_call_in_state(state: &DataPipelineState, module: &String, method: &String, args: &[CtValue], type_args: &[Type], resolved_ret: &Type?, data_plan: &MirDataPlan?, span: Span) -> (CtValue Diagnostic!)? {
    if module.is_empty() {
        if recv := args.first() {
            if recv == { Struct { type_name, .. } -> type_name == "Query" || type_name == "DataGroupedQuery" || type_name == "DataTracked" || type_name == "DataWatch"; _ -> false } {
                return eval_data_query_method_with(state, recv, method, &args[1..], resolved_ret,
                    fn(callback, callback_args, span) { Methods.invoke_standalone_closure(callback, ^callback_args, span) }, span)
            }
            if method == "query" && recv == { List(_) -> true; _ -> false } { return eval_data_call_in_state(state, "core.data", "query", args, type_args, resolved_ret, data_plan, span) }
        }
    }
    if (module == "core.data" || module == "core.data.plot") && (method == "plot" || method == "inspect" || method == "inspect_json" || method == "text" || method == "svg" || method == "show" || method == "render") { return Val(plot_static_call(state, method, args, None, &[:], span)) }
    if module == "core.data" && method == "describe" { return Val(Methods.eval_data_describe(args, resolved_ret, span)) }
    if module == "core.data" && (method == "load" || method == "load_default" || method == "file" || method == "file_member" || method == "url" || method == "database" || method == "value") { return Val(data_loader_constructor_in_state(state, method, args, type_args, resolved_ret, span)) }
    try {
        if module == "core.data" && method == "snapshot" {
            loader := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.snapshot()` is missing loader", span) } }
            call := eval_data_loader_method_in_state(state, loader, "snapshot", &[], span) == { Val(v) -> v; None -> { fail unsupported("data.snapshot", span) } }
            return Val(Ok(call?))
        }
        if module == "core.data.loader" && method == "snapshot_reusable" {
            (left, right) := (args.first(), args.get(1)) == { (Val(l), Val(r)) -> (l, r); _ -> { fail unsupported("`data.loader.snapshot_reusable()`: missing argument", span) } }
            reused := data_snapshot_reusable_value(left, right) == { Val(v) -> v; None -> { fail unsupported("`data.loader.snapshot_reusable()` needs snapshot identities", span) } }
            return Val(Ok(CtValue.Bool(reused)))
        }
        if module == "core.data.loader" {
            loader := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.loader.{method}()`: missing loader", span) } }
            call := eval_data_loader_method_in_state(state, loader, method, &args[1..], span) == { Val(v) -> v; None -> { fail unsupported("data.loader.{method}", span) } }
            return Val(Ok(call?))
        }
        if module == "core.data.stream" {
            stream := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.stream.{method}()`: missing stream", span) } }
            call := eval_data_stream_method_in_state(state, stream, method, &args[1..], span) == { Val(v) -> v; None -> { fail unsupported("data.stream.{method}", span) } }
            return Val(Ok(call?))
        }
        if module == "core.data" && (method == "inner_join" || method == "left_join") {
            if args.len() != 4 { fail unsupported("`data.{method}()` expects left, right, and two key callbacks", span) }
            left := args[0] == { List(rows) -> rows.clone(); _ -> { fail unsupported("`data.{method}()` needs a left list", span) } }
            right := args[1] == { List(rows) -> rows.clone(); _ -> { fail unsupported("`data.{method}()` needs a right list", span) } }
            right_type := data_join_right_type(resolved_ret)
            call := fn(callback, callback_args, span) { Methods.invoke_standalone_closure(callback, ^callback_args, span) }
            joined := collect_join_rows(&left, &right, &args[2], &args[3], method == "left_join", ^right_type, call, span)?
            return Val(Ok(CtValue.Present(Box.new(CtValue.List(^joined)))))
        }
        if module == "core.data" && method == "pivot_sum" { return Val(Methods.eval_data_pivot_sum(args, span, fn(callback, callback_args, span) { Methods.invoke_standalone_closure(callback, ^callback_args, span) })) }
        if module == "core.data" && method == "track" {
            if args.len() != 2 { fail unsupported("`data.track()` expects rows and one key callback", span) }
            rows := args.first() == { Val(List(rows)) -> rows.clone(); Val(_) -> { fail unsupported("`data.track()` needs a list", span) }; None -> { fail unsupported("`data.track()` is missing rows", span) } }
            key := args[1].clone()
            tracked := build_tracked(state, ^rows, ^key, fn(callback, callback_args, span) { Methods.invoke_standalone_closure(callback, ^callback_args, span) }, span)?
            return Val(Ok(CtValue.Present(Box.new(^tracked))))
        }
        if module == "core.data" && method == "query" {
            rows := args.first() == { Val(List(rows)) -> rows.clone(); Val(_) -> { fail unsupported("`data.query()` needs a list", span) }; None -> { fail unsupported("`data.query()` is missing rows", span) } }
            declared_fields := data_plan.and_then(fn(plan) { plan.logical.iter().find(fn(node) { node.id == plan.output }) }).map(fn(node) { node.columns.iter().map(fn(c) { c.name.clone() }).collect::<[String]>() })
            selected := if args.len() == 1 { Ok(^rows) } else {
                sql := args.get(1) == { Val(Str(v)) -> v; _ -> { fail unsupported("`data.query()` expects SQL text as argument 1", span) } }
                query_sql_rows(^rows, sql, ^declared_fields)
            }
            value := selected == {
                Ok(rows) -> {
                    query := store_query(state, ^rows, if args.len() == 1 { ["scan"] } else { ["scan", "sql"] })
                    if args.len() == 1 { query } else { CtValue.Present(Box.new(^query)) }
                }
                Err(error) -> CtValue.failed(Box.new(^error))
            }
            return Val(Ok(^value))
        }
        None
    } catch(error) { Val(Err(^error)) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3001
fn data_loader_constructor_in_state(state: &DataPipelineState, method: &String, args: &[CtValue], type_args: &[Type], resolved_ret: &Type?, span: Span) -> CtValue Diagnostic! {
    operation := "core.data.{method}"
    (kind, locator, member, parameters, format, authority, limits, payload, seed) := method == {
        "load" -> {
            locator := data_loader_string_arg(args, 0, method, span)?
            limits := data_limits_from_value(args.get(1))
            format := data_loader_format_for_locator(&locator) == { Ok(v) -> v; Err(e) -> { return e } }
            kind := if locator.starts_with("http://") || locator.starts_with("https://") { PreludeDataFlow.LoaderKind.URL } else { PreludeDataFlow.LoaderKind.File }
            scope := if kind == PreludeDataFlow.LoaderKind.URL { "network" } else { "local" }
            authority := data_loader_authority(scope, "") == { Ok(v) -> v; Err(e) -> { return e } }
            (kind, ^locator, "", [], ^format, ^authority, ^limits, None, None)
        }
        "load_default" -> {
            locator := data_loader_string_arg(args, 0, method, span)?
            format := data_loader_format_for_locator(&locator) == { Ok(v) -> v; Err(e) -> { return e } }
            kind := if locator.starts_with("http://") || locator.starts_with("https://") { PreludeDataFlow.LoaderKind.URL } else { PreludeDataFlow.LoaderKind.File }
            scope := if kind == PreludeDataFlow.LoaderKind.URL { "network" } else { "local" }
            authority := data_loader_authority(scope, "") == { Ok(v) -> v; Err(e) -> { return e } }
            (kind, ^locator, "", [], ^format, ^authority, data_kernel_limits_safe(), None, None)
        }
        "file" -> {
            path := data_loader_string_arg(args, 0, method, span)?
            name := data_loader_string_arg(args, 1, method, span)?
            format := data_loader_format(&name) == { Val(v) -> v; None -> { return data_loader_failure("Bridge", &operation, "format is provider-owned; import its package") } }
            authority := data_loader_authority("local", "") == { Ok(v) -> v; Err(e) -> { return e } }
            (PreludeDataFlow.LoaderKind.File, ^path, "", [], format.to_string(), ^authority, data_limits_from_value(args.get(2)), None, None)
        }
        "file_member" -> {
            path := data_loader_string_arg(args, 0, method, span)?
            member := data_loader_string_arg(args, 1, method, span)?
            name := data_loader_string_arg(args, 2, method, span)?
            format := data_loader_format(&name) == { Val(v) -> v; None -> { return data_loader_failure("Bridge", &operation, "format is provider-owned; import its package") } }
            authority := data_loader_authority("local", "") == { Ok(v) -> v; Err(e) -> { return e } }
            (PreludeDataFlow.LoaderKind.File, ^path, ^member, [], format.to_string(), ^authority, data_limits_from_value(args.get(3)), None, None)
        }
        "url" -> {
            url := data_loader_string_arg(args, 0, method, span)?
            name := data_loader_string_arg(args, 1, method, span)?
            authority_name := data_loader_string_arg(args, 2, method, span)?
            format := data_loader_format(&name) == { Val(v) -> v; None -> { return data_loader_failure("Bridge", &operation, "format is provider-owned; import its package") } }
            authority := data_loader_authority(&authority_name, "") == { Ok(v) -> v; Err(e) -> { return e } }
            (PreludeDataFlow.LoaderKind.URL, ^url, "", [], format.to_string(), ^authority, data_limits_from_value(args.get(3)), None, None)
        }
        "database" -> {
            query := data_loader_string_arg(args, 0, method, span)?
            parameters := args.get(1) == { Val(v) -> data_loader_parameters(v, span)?; None -> { fail unsupported("`data.database()` is missing parameters", span) } }
            authority_name := data_loader_string_arg(args, 2, method, span)?
            authority := data_loader_authority(&authority_name, "") == { Ok(v) -> v; Err(e) -> { return e } }
            (PreludeDataFlow.LoaderKind.Database, ^query, "", ^parameters, "json", ^authority, data_limits_from_value(args.get(3)), None, None)
        }
        "value" -> {
            value := args.first().cloned() == { Val(v) -> v; None -> { fail unsupported("`data.value()` is missing value", span) } }
            limits := data_limits_from_value(args.get(1))
            text := JSONInterp.render_ordered_datatree(&value, false, 0)
            authority := data_loader_authority("local", "") == { Ok(v) -> v; Err(e) -> { return e } }
            (PreludeDataFlow.LoaderKind.Value, "value", "", [], "json", ^authority, ^limits, Val(text.into_bytes()), Val(^value))
        }
        _ -> unreachable()
    }
    data_loader_new(state, kind, ^locator, ^member, ^parameters, ^format, ^limits, ^authority, ^payload, loader_type_for_call(type_args, resolved_ret), ^seed) == { Ok(v) -> v; Err(e) -> e }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3227
fn eval_data_loader_method_in_state(state: &DataPipelineState, recv: &CtValue, method: &String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { Struct { type_name, .. } -> type_name == "DataLoader"; _ -> false }) { return None }
    id := data_loader_state_id(state, recv, span) == { Ok(id) -> id; Err(e) -> { return Val(Err(^e)) } }
    slot := state.loaders.get_mut(id - 1).and_then(fn(slot) { slot.take() }).expect("loader identity checked")
    result := try {
        value := method == {
            "status" -> data_kernel_status_value(&PreludeDataFlow.status(&slot.state))
            "source_identity" -> data_kernel_source_value(&slot.state.source)
            "authority" | "authority_of" -> data_kernel_authority_value(&slot.state.authority)
            "ready" -> CtValue.Bool(PreludeDataFlow.ready(&slot.state))
            "needs_refresh" -> CtValue.Bool(PreludeDataFlow.needs_refresh(&slot.state))
            "snapshot_reusable" -> {
                snapshot := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.loader.snapshot_reusable()` needs a snapshot", span) } }
                reused := data_snapshot_reusable_value(recv, snapshot) == { Val(v) -> v; None -> { fail unsupported("`snapshot_reusable()` needs a DataSnapshot", span) } }
                CtValue.Bool(reused)
            }
            "bind" -> {
                payload := args.first() == {
                    Val(Bytes(bytes)) -> bytes.clone()
                    Val(List(values)) -> {
                        bytes: [U8] = []
                        for value in values { value == { Int(v) if v >= 0 && v <= 255 -> bytes.push(v as U8); _ -> { fail unsupported("`DataLoader.bind()` needs byte values", span) } } }
                        bytes
                    }
                    _ -> { fail unsupported("`DataLoader.bind()` needs byte values", span) }
                }
                PreludeDataFlow.bind(&slot.state, ^payload) == { Ok(_) -> CtValue.Present(Box.new(CtValue.Unit)); Err(error) -> { PreludeDataFlow.fail(&slot.state, &error); data_loader_kernel_failure(^error) } }
            }
            "bind_text" -> {
                payload := args.first() == { Val(Str(v)) -> v.as_bytes().to_vec(); _ -> { fail unsupported("`DataLoader.bind_text()` needs String", span) } }
                PreludeDataFlow.bind(&slot.state, ^payload) == { Ok(_) -> CtValue.Present(Box.new(CtValue.Unit)); Err(error) -> { PreludeDataFlow.fail(&slot.state, &error); data_loader_kernel_failure(^error) } }
            }
            "cancel" -> { PreludeDataFlow.cancel(&slot.state); CtValue.Unit }
            "offline" -> {
                enabled := args.first() == { Val(Bool(v)) -> v; _ -> { fail unsupported("`DataLoader.offline()` needs Bool", span) } }
                PreludeDataFlow.set_offline(&slot.state, enabled); CtValue.Unit
            }
            "invalidate" -> {
                variant := args.first() == { Val(Enum { type_name, variant, .. }) if type_name == "DataInvalidationCause" -> variant; _ -> { fail unsupported("`DataLoader.invalidate()` needs DataInvalidationCause", span) } }
                cause := variant == {
                    "NoCause" -> PreludeDataFlow.InvalidationCause.NoCause; "Loader" -> PreludeDataFlow.InvalidationCause.Loader
                    "Input" -> PreludeDataFlow.InvalidationCause.Input; "ArchiveMember" -> PreludeDataFlow.InvalidationCause.ArchiveMember
                    "Parameters" -> PreludeDataFlow.InvalidationCause.Parameters; "Credential" -> PreludeDataFlow.InvalidationCause.Credential
                    "Capability" -> PreludeDataFlow.InvalidationCause.Capability; "Manual" -> PreludeDataFlow.InvalidationCause.Manual
                    _ -> { fail unsupported("`DataLoader.invalidate()` needs DataInvalidationCause", span) }
                }
                PreludeDataFlow.invalidate(&slot.state, cause); CtValue.Unit
            }
            "stream" -> {
                stream_call := fn() -> CtValue {
                    if slot.state.cancelled {
                        error := PreludeDataFlow.KernelError { kind: PreludeDataFlow.ErrorKind.State, operation: "data.loader.stream", reason: "loader was cancelled" }
                        PreludeDataFlow.fail(&slot.state, &error); return data_loader_kernel_failure(^error)
                    }
                    PreludeDataFlow.validate_loader(&slot.state) == { Err(e) -> { PreludeDataFlow.fail(&slot.state, &e); return data_loader_kernel_failure(^e) }; Ok(_) -> {} }
                    PreludeDataFlow.validate_limits(&slot.state.limits) == { Err(e) -> { PreludeDataFlow.fail(&slot.state, &e); return data_loader_kernel_failure(^e) }; Ok(_) -> {} }
                    data_stream_rows_in_state(&slot) == {
                        Ok(rows) -> {
                            size := slot.state.payload.as_ref().map(fn(p) { p.len() }).unwrap_or(0)
                            bytes := I64.try_from(size).unwrap_or(I64.MAX)
                            slot.state.status.buffered_bytes = bytes
                            slot.state.status.backpressure = bytes > slot.state.limits.buffer_bytes
                            CtValue.Present(Box.new(store_data_stream(state, ComptimeStream { rows: ^rows, cursor: 0, cancelled: false, row_ty: slot.decode_ty.as_ref().map(data_stream_row_type) })))
                        }
                        Err(error) -> { data_loader_fail_value(&slot, &error, "data.loader.stream"); error }
                    }
                }
                stream_call()
            }
            "snapshot" -> data_snapshot_dynamic_in_state(&slot) == { Ok(v) -> v; Err(e) -> e }
            _ -> { fail unsupported("`DataLoader.{method}()` is not a registered operation", span) }
        }
        Ok(^value)
    } catch(error) { Err(^error) }
    state.loaders[id - 1] = Val(^slot)
    Val(^result)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3423
fn eval_data_stream_method_in_state(state: &DataPipelineState, recv: &CtValue, method: &String, _args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { Struct { type_name, .. } -> type_name == "DataStream"; _ -> false }) { return None }
    id := data_stream_state_id(state, recv, span) == { Ok(id) -> id; Err(e) -> { return Val(Err(^e)) } }
    stream := state.streams.get_mut(id - 1).and_then(fn(slot) { slot.take() }).expect("stream identity checked")
    result := method == {
        "next" -> Ok(data_stream_next(&stream))
        "collect" -> {
            if stream.cancelled { Ok(data_loader_failure("State", "data.stream.collect", "stream was cancelled")) }
            else { rows := stream.rows[stream.cursor..].to_vec(); stream.cursor = stream.rows.len(); Ok(CtValue.Present(Box.new(CtValue.List(^rows)))) }
        }
        "cancel" -> { stream.cancelled = true; Ok(CtValue.Unit) }
        _ -> Err(unsupported("`DataStream.{method}()` is not a registered operation", span))
    }
    state.streams[id - 1] = Val(^stream)
    Val(^result)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3472
fn eval_data_loader_call(interp: &Interp, module: &String, method: &String, args: &[CtValue], type_args: &[Type], resolved_ret: &Type?, span: Span) -> (CtValue Diagnostic!)? {
    operation := "{module}.{method}"
    (module, method) == {
        ("core.data", "load" | "load_default" | "file" | "file_member" | "url" | "database" | "value") -> {
            // All constructor arguments, validation ordering and outcomes are
            // identical to the state-only route; use that canonical body.
            Val(data_loader_constructor_in_state(&interp.data_pipeline, method, args, type_args, resolved_ret, span))
        }
        ("core.data", "snapshot") -> {
            call := try {
                loader := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.snapshot()` is missing loader", span) } }
                dispatched := eval_data_loader_method(interp, loader, "snapshot", &[], span) == { Val(v) -> v; None -> { fail unsupported("data.snapshot", span) } }
                Ok(dispatched?)
            } catch(error) { Err(^error) }
            Val(^call)
        }
        ("core.data.loader", "snapshot_reusable") -> {
            call := try {
                (left, right) := (args.first(), args.get(1)) == { (Val(l), Val(r)) -> (l, r); _ -> { fail unsupported("`data.loader.snapshot_reusable()`: missing argument", span) } }
                reused := data_snapshot_reusable_value(left, right) == { Val(v) -> v; None -> { fail unsupported("`data.loader.snapshot_reusable()` needs snapshot identities", span) } }
                Ok(CtValue.Bool(reused))
            } catch(error) { Err(^error) }
            Val(^call)
        }
        ("core.data.loader", _) -> {
            call := try {
                loader := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.loader.{method}()`: missing loader", span) } }
                dispatched := eval_data_loader_method(interp, loader, method, &args[1..], span) == { Val(v) -> v; None -> { fail unsupported(&operation, span) } }
                Ok(dispatched?)
            } catch(error) { Err(^error) }
            Val(^call)
        }
        ("core.data.stream", _) -> {
            call := try {
                stream := args.first() == { Val(v) -> v; None -> { fail unsupported("`data.stream.{method}()`: missing stream", span) } }
                dispatched := eval_data_stream_method(interp, stream, method, &args[1..], span) == { Val(v) -> v; None -> { fail unsupported(&operation, span) } }
                Ok(dispatched?)
            } catch(error) { Err(^error) }
            Val(^call)
        }
        _ -> None
    }
}

