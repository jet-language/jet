// JSON adapters use the same Foundation parser as the other evaluator tiers.
use jet_foundation.[CtFloat, CtKey, CtValue, CtEnumArg, NamedCtValue]
use jet_foundation.DataTree.[DataTree]
use jet_foundation.[EncodingJson]
use jet_comptime.Builtins.[exact_int_value]
use jet_comptime.Numeric.[CtBigInt]
use jet_comptime.Comptime.[EncodingLite]

// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:7
fn from_json_int(value: Int) -> CtValue Never! { exact_int_value(CtBigInt.from_int(value)) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:11
fn from_json_number(value: String) -> CtValue Never! {
    number :: CtBigInt.from_str(value).expect("dynamic JSON integer token must be valid exact integer text")
    exact_int_value(number)
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:17
fn from_json(value: DataTree) -> CtValue Never! {
    if value == {
        .Null -> json_variant("Null", None)
        .Bool(v) -> json_variant("Bool", Val(CtValue.Bool{value: v}))
        .Int(v) -> json_variant("Int", Val(from_json_int(v)))
        .Float(v) -> json_variant("Float", Val(CtValue.Float{value: CtFloat.f64(v)}))
        .Number(v) -> json_variant("Int", Val(from_json_number(v)))
        .TypedText(v) | .Text(v) -> json_variant("Text", Val(CtValue.Str{value: v}))
        .Array(values) -> { out := [CtValue]{}; loop v in values { out.push(from_json(^v)) }; json_variant("Array", Val(CtValue.List{values: ^out})) }
        .Object(fields) -> { out := [NamedCtValue]{}; loop (name, v) in fields { out.push(NamedCtValue{name: name, value: from_json(^v)}) }; json_object(^out) }
        .Bytes(_) -> panic("JSON parser does not produce byte nodes")
    }
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:52
fn from_ordered_json(value: DataTree) -> CtValue Never! {
    if value == {
        .Object(fields) -> { out := [NamedCtValue]{}; loop (name, v) in fields { out.push(NamedCtValue{name: name, value: from_ordered_json(^v)}) }; json_object(^out) }
        .Null -> json_variant("Null", None)
        .Bool(v) -> json_variant("Bool", Val(CtValue.Bool{value: v}))
        .Int(v) -> json_variant("Int", Val(from_json_int(v)))
        .Float(v) -> json_variant("Float", Val(CtValue.Float{value: CtFloat.f64(v)}))
        .Number(v) -> json_variant("Int", Val(from_json_number(v)))
        .TypedText(v) | .Text(v) -> json_variant("Text", Val(CtValue.Str{value: v}))
        .Array(values) -> { out := [CtValue]{}; loop v in values { out.push(from_ordered_json(^v)) }; json_variant("Array", Val(CtValue.List{values: ^out})) }
        .Bytes(_) -> panic("JSON parser does not produce byte nodes")
    }
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:89
fn from_typed_ordered_json(value: DataTree) -> CtValue Never! {
    if value == {
        .Object(fields) -> { out := [NamedCtValue]{}; loop (name, v) in fields { out.push(NamedCtValue{name: name, value: from_typed_ordered_json(^v)}) }; json_object(^out) }
        .Null -> json_variant("Null", None)
        .Bool(v) -> json_variant("Bool", Val(CtValue.Bool{value: v}))
        .Number(v) -> json_variant("Number", Val(CtValue.Str{value: v}))
        .TypedText(v) | .Text(v) -> json_variant("TypedText", Val(CtValue.Str{value: v}))
        .Array(values) -> { out := [CtValue]{}; loop v in values { out.push(from_typed_ordered_json(^v)) }; json_variant("Array", Val(CtValue.List{values: ^out})) }
        .Int(_) | .Float(_) | .Bytes(_) -> panic("lossless JSON parsing projected a number early")
    }
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:122
fn json_object(fields: [NamedCtValue]) -> CtValue Never! { json_variant("Object", Val(CtValue.Struct{type_name: "JSONObject", fields: ^fields})) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:137
pub fn json_variant(variant: String, payload: CtValue?) -> CtValue Never! {
    args :: if payload == { Val(v) -> [CtEnumArg]{CtEnumArg{label: None, value: ^v}} None -> [CtEnumArg]{} }
    CtValue.Enum{type_name: "DataTree", variant: variant, args: args}
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:151
pub fn json_payload(v: &CtValue, variant: String) -> CtValue? {
    if v == { .Enum(type_name, vname, args) -> if type_name == "DataTree" && vname == variant && !args.is_empty() -> Val(args[0].value) else -> None else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:162
pub fn parse_json(text: String) -> CtValue EncodingJson.Error! { from_json(EncodingJson.parse_json(text, true)!) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:166
pub fn parse_json_ordered(text: String) -> CtValue EncodingJson.Error! { from_ordered_json(EncodingJson.parse_json(text, true)!) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:172
pub fn parse_json_typed_ordered(text: String) -> CtValue EncodingJson.Error! { from_typed_ordered_json(EncodingJson.parse_json_typed(text, true)!) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:178
pub fn encoding_error_value(e: EncodingJson.Error) -> CtValue Never! { EncodingLite.encoding_error_value_at("JSON", "Syntax", e.line, 1, e.message) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:193
pub fn encoding_error_value_at_line(e: EncodingJson.Error, line_offset: Int) -> CtValue Never! { EncodingLite.encoding_error_value_at("JSONL", "Syntax", line_offset + e.line, 1, e.message) }
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:209
pub fn render_ordered_datatree(v: &CtValue, pretty: Bool, depth: Int) -> String Never! {
    if v == {
        .Enum(type_name, variant, args) -> if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" {
            if variant == {
                "Null" -> return "null"
                "Number" -> return if !args.is_empty() -> (if args[0].value == { .Str(value) -> value.clone() else -> "null" }) else -> "null"
                "Object" -> return if args.is_empty() -> "{}" else -> render_ordered_object_payload(&args[0].value, pretty, depth)
                else -> return if args.is_empty() -> "null" else -> render_ordered_datatree(&args[0].value, pretty, depth)
            }
        }
        .List(items) -> {
            if items.is_empty() -> return "[]"
            parts := [String]{}
            pad :: if pretty -> "  ".repeat(depth + 1) else -> ""; end :: if pretty -> "  ".repeat(depth) else -> ""
            loop item in items { parts.push(if pretty -> "{pad}{render_ordered_datatree(&item, true, depth + 1)}" else -> render_ordered_datatree(&item, false, depth)) }
            return if pretty -> "[\n{parts.join(",\n")}\n{end}]" else -> "[{parts.join(",")}]"
        }
        .Struct(type_name, fields) -> if type_name == "JSONObject" -> return render_ordered_object(&fields, pretty, depth)
        else -> {}
    }
    render_json_pretty(v, pretty, depth)
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:267
fn render_ordered_object_payload(payload: &CtValue, pretty: Bool, depth: Int) -> String Never! {
    fields := [NamedCtValue]{}
    if payload == {
        .Map(entries) -> loop entry in entries {
            if entry.key == { .Str(key) -> fields.push(NamedCtValue{name: key.clone(), value: entry.value.clone()}) else -> return render_json_pretty(payload, pretty, depth) }
        }
        .Struct(type_name, members) -> if type_name == "JSONObject" -> return render_ordered_object(&members, pretty, depth) else -> return render_json_pretty(payload, pretty, depth)
        .List(values) -> loop value in values {
            members :: if value == { .Struct(_, members) -> members else -> return render_json_pretty(payload, pretty, depth) }
            key := None; found := None
            loop field in members { if field.name == "key" && key.is_none() -> key = Val(field.value); if field.name == "value" && found.is_none() -> found = Val(field.value) }
            name :: if key == { Val(.Str(name)) -> name else -> return render_json_pretty(payload, pretty, depth) }
            value :: found ?? return render_json_pretty(payload, pretty, depth)
            fields.push(NamedCtValue{name: name.clone(), value: value.clone()})
        }
        else -> return render_json_pretty(payload, pretty, depth)
    }
    render_ordered_object(&fields, pretty, depth)
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:306
fn render_ordered_object(fields: &[NamedCtValue], pretty: Bool, depth: Int) -> String Never! {
    if fields.is_empty() -> return "{}"
    parts := [String]{}; pad :: if pretty -> "  ".repeat(depth + 1) else -> ""; end :: if pretty -> "  ".repeat(depth) else -> ""
    loop field in fields { parts.push(if pretty -> "{pad}{quote_json(field.name)}: {render_ordered_datatree(&field.value, true, depth + 1)}" else -> "{quote_json(field.name)}:{render_ordered_datatree(&field.value, false, depth)}") }
    if pretty -> "\u{007b}\n{parts.join(",\n")}\n{end}\u{007d}" else -> "\u{007b}{parts.join(",")}\u{007d}"
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:342
pub fn render_json_pretty(v: &CtValue, pretty: Bool, depth: Int) -> String Never! {
    if v == {
        .Enum(type_name, variant, args) -> if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" {
            return if variant == "Null" || args.is_empty() -> "null" else -> render_json_pretty(&args[0].value, pretty, depth)
        }
        .Unit -> return "null"
        .Bool(b) -> return b.to_string()
        .Int(n) -> return n.to_string()
        .Float(f) -> { assert(f.as_f64().is_finite(), "JSON cannot encode a non-finite Float"); return f.debug() }
        .BigInt(value) -> return value.clone()
        .Str(s) -> return quote_json(s)
        .List(xs) -> {
            if xs.is_empty() -> return "[]"
            parts := [String]{}; pad :: if pretty -> "  ".repeat(depth + 1) else -> ""; end :: if pretty -> "  ".repeat(depth) else -> ""
            loop x in xs { parts.push(if pretty -> "{pad}{render_json_pretty(&x, true, depth + 1)}" else -> render_json_pretty(&x, false, depth)) }
            return if pretty -> "[\n{parts.join(",\n")}\n{end}]" else -> "[{parts.join(",")}]"
        }
        .Map(entries) -> {
            if entries.is_empty() -> return "{}"
            parts := [String]{}; pad :: if pretty -> "  ".repeat(depth + 1) else -> ""; end :: if pretty -> "  ".repeat(depth) else -> ""
            loop entry in entries {
                key :: if entry.key == { .Str(s) -> quote_json(s) else -> quote_json(entry.key.to_value().jet_show()) }
                parts.push(if pretty -> "{pad}{key}: {render_json_pretty(&entry.value, true, depth + 1)}" else -> "{key}:{render_json_pretty(&entry.value, false, depth)}")
            }
            return if pretty -> "\u{007b}\n{parts.join(",\n")}\n{end}\u{007d}" else -> "\u{007b}{parts.join(",")}\u{007d}"
        }
        .Struct(type_name, members) -> if type_name == "JSONObject" {
            fields := members.clone(); fields.sort_by(fn(a: NamedCtValue, b: NamedCtValue) -> Ordering Never! { a.name.compare(b.name) })
            if fields.is_empty() -> return "{}"
            parts := [String]{}; pad :: if pretty -> "  ".repeat(depth + 1) else -> ""; end :: if pretty -> "  ".repeat(depth) else -> ""
            loop field in fields { parts.push(if pretty -> "{pad}{quote_json(field.name)}: {render_json_pretty(&field.value, true, depth + 1)}" else -> "{quote_json(field.name)}:{render_json_pretty(&field.value, false, depth)}") }
            return if pretty -> "\u{007b}\n{parts.join(",\n")}\n{end}\u{007d}" else -> "\u{007b}{parts.join(",")}\u{007d}"
        }
        else -> {}
    }
    v.to_json()
}
// Rust: crates/jet-comptime/src/Comptime/JSONInterp.rs:462
fn quote_json(s: String) -> String Never! {
    out := "\""
    loop c in s.chars() {
        if c == {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\u{0008}' -> out.push_str("\\b")
            '\u{000c}' -> out.push_str("\\f")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            else -> if U32{c} < 0x20 -> out.push_str("\\u{U32{c}.to_radix(16).pad_start(4, "0")}") else -> out.push(c)
        }
    }
    out.push('"')
    ^out
}
