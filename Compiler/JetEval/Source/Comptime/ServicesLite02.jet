// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3100
fn legacy_conversion_error(label: String) -> Diagnostic { unsupported(label, Span.new(0, 0)) }
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3104
pub fn ct_to_runtime_value(value: &CtValue) -> MirRuntimeValue Diagnostic! {
    if value == {
        .Int(value) -> MirRuntimeValue.Int(value)
        .Float(.F32(value)) -> MirRuntimeValue.Float{value: value as F64, f32: true}
        .Float(.F64(value)) -> MirRuntimeValue.Float{value: value, f32: false}
        .Bool(value) -> MirRuntimeValue.Bool(value)
        .Char(value) -> MirRuntimeValue.Char(value)
        .Str(value) -> MirRuntimeValue.String(value.clone())
        .BigInt(value) -> MirRuntimeValue.BigInt(value.to_string_rep())
        .Bytes(values) -> MirRuntimeValue.Bytes(values.clone())
        .List(values) -> {
            out := [MirRuntimeValue]{}
            loop item in values -> &out.push(ct_to_runtime_value(item)?)
            MirRuntimeValue.List(out)
        }
        .Map(values) -> {
            // GATE #4499: CtKey canonical ordered map, not string-encoded keys.
            keys := values.keys().collect()
            &keys.sort()
            out := [(MirKey, MirRuntimeValue)]{}
            loop key in keys -> &out.push((ct_to_mir_key(key.clone()), ct_to_runtime_value(values[key])?))
            MirRuntimeValue.Map(out)
        }
        .Struct(type_name, fields) -> {
            out := [(String, MirRuntimeValue)]{}
            loop (name, item) in fields -> &out.push((name.clone(), ct_to_runtime_value(item)?))
            MirRuntimeValue.Struct{type_name: type_name.clone(), fields: out}
        }
        .Enum(type_name, variant, args) -> {
            out := [(String?, MirRuntimeValue)]{}
            loop (name, item) in args -> &out.push((name.clone(), ct_to_runtime_value(item)?))
            MirRuntimeValue.Enum{type_name: type_name.clone(), variant: variant.clone(), args: out}
        }
        .Present(value) -> MirRuntimeValue.Present(ct_to_runtime_value(value)?)
        .Failed(.Clean(ty)) -> MirRuntimeValue.Absent{element: mir_compat_type(ty)}
        .Failed(.Told(value)) -> MirRuntimeValue.FailedTold(ct_to_runtime_value(value)?)
        .Unit -> MirRuntimeValue.Unit
        .Closure(_) -> return Err(legacy_conversion_error("legacy closure service value"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3164
pub fn runtime_to_ct_value(value: &MirRuntimeValue) -> CtValue Diagnostic! {
    if value == {
        .Int(value) -> CtValue.Int(value)
        .BigInt(value) -> CtValue.BigInt(crate.Numeric.CtBigInt.from_str(value).map_err(fn(_) { legacy_conversion_error("runtime BigInt service value") })?)
        .Float(value, f32) -> CtValue.Float(if f32 -> CtFloat.F32(value as F32) else -> CtFloat.F64(value))
        .Bool(value) -> CtValue.Bool(value)
        .Char(value) -> CtValue.Char(value)
        .String(value) -> CtValue.Str(value.clone())
        .Bytes(values) -> CtValue.Bytes(values.clone())
        .List(values) -> {
            out := [CtValue]{}
            loop item in values -> &out.push(runtime_to_ct_value(item)?)
            CtValue.List(out)
        }
        .Map(values) -> {
            // GATE #4499: native composite CtKey equality/hash/order.
            out := [CtKey:CtValue]{}
            loop (key, item) in values -> out[mir_to_ct_key(key)] = runtime_to_ct_value(item)?
            CtValue.Map(out)
        }
        .Struct(type_name, fields) -> {
            out := [(String, CtValue)]{}
            loop (name, item) in fields -> &out.push((name.clone(), runtime_to_ct_value(item)?))
            CtValue.Struct{type_name: type_name.clone(), fields: out}
        }
        .Enum(type_name, variant, args) -> {
            out := [(String?, CtValue)]{}
            loop (name, item) in args -> &out.push((name.clone(), runtime_to_ct_value(item)?))
            CtValue.Enum{type_name: type_name.clone(), variant: variant.clone(), args: out}
        }
        .Present(value) -> CtValue.Present(runtime_to_ct_value(value)?)
        .FailedTold(value) -> CtValue.Failed(CtReport.Told(runtime_to_ct_value(value)?))
        .Absent(element) -> CtValue.Failed(CtReport.Clean(Type.Named(element.display_name())))
        .Unit -> CtValue.Unit
        .Moved -> return Err(legacy_conversion_error("internal moved service value"))
        .NativeCursor(_) -> return Err(legacy_conversion_error("native cursor service value"))
        .NativeOwned(_) -> return Err(legacy_conversion_error("native-owned service value"))
        .Closure(_) -> return Err(legacy_conversion_error("runtime closure service value"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3228
pub fn interpreter_job_cbor_bytes(value: &MirRuntimeValue, span: Span) -> [U8] Diagnostic! {
    value :: runtime_to_ct_value(value)?
    crate.Comptime.EncodingLite.cbor_encode_canonical(value).map_err(fn(error) { unsupported("Job payload CBOR encoding: {error.debug()}", span) })?
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3238
pub fn service_runtime_value(store: String, retention_ms: I64) -> MirRuntimeValue { service_runtime_to_value(jet_services_runtime(store, retention_ms)) }
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3242
pub fn service_show_value(value: &CtValue) -> String? { ct_to_runtime_value(value).ok().and_then(fn(value) { service_show_value_runtime(value) }) }
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3248
pub fn apply_runtime_method(receiver: &CtValue, method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    receiver :: ct_to_runtime_value(receiver)?
    converted := [MirRuntimeValue]{}
    loop item in args -> &converted.push(ct_to_runtime_value(item)?)
    runtime_to_ct_value(apply_runtime_method_mir(receiver, method, converted, span)?)?
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3262
pub fn take_mut_ok(value: CtValue) -> (CtValue, CtValue) CtValue! {
    runtime :: if ct_to_runtime_value(value) == { Ok(value) -> value; Err(_) -> return Err(value) }
    if take_mut_runtime(runtime) == {
        Ok((tree, result)) -> if (runtime_to_ct_value(tree), runtime_to_ct_value(result)) == { (Ok(tree), Ok(value)) -> (tree, value); _ -> return Err(value) }
        Err(result) -> if runtime_to_ct_value(result) == { Ok(result) -> return Err(result); Err(_) -> return Err(value) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3276
pub fn apply(method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    converted := [MirRuntimeValue]{}
    loop value in args {
        item :: if (method, value) == { ("worker", .Closure(_)) -> MirRuntimeValue.Unit; _ -> ct_to_runtime_value(value)? }
        &converted.push(item)
    }
    if !converted.is_empty() {
        tree :: converted[0]
        converted[0] = MirRuntimeValue.Unit
        converted[0] = intern_resolve(tree)
    }
    slot :: converted.first().and_then(intern_slot)
    runtime_to_ct_value(intern_commit(slot, apply_runtime(method, converted, span)?))?
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3299
fn queue_failed(error: JetServiceError) -> MirRuntimeValue { MirRuntimeValue.FailedTold(map_err(error)) }
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3303
fn queue_one(args: &[MirRuntimeValue], index: USize, method: String, span: Span) -> &MirRuntimeValue Diagnostic! { args.get(index) ?? return Err(unsupported("core.jobs.{method} arg {index}", span)) }
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3313
fn queue_timeout_ms(value: &MirRuntimeValue, span: Span) -> I64 Diagnostic! {
    if value == { .Struct(type_name, _) -> { if type_name == "Duration" -> return queue_duration_ms(value, span); return Err(unsupported("JobQueue.wait timeout", span)) }; _ -> return Err(unsupported("JobQueue.wait timeout", span)) }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3322
fn apply_jobs_runtime_for_endpoint(endpoint: &JetServiceEndpoint, method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    if method == {
        "queue" -> {
            if !args.is_empty() -> return Err(unsupported("`core.jobs.queue()` takes no arguments", span))
            queue_result_value(queue_open(endpoint, JOB_QUEUE_DEFAULT_NAME).map(fn(_) { queue_to_runtime(endpoint, JOB_QUEUE_DEFAULT_NAME) }), fn(value) { value })
        }
        _ -> return Err(unsupported("`core.jobs.{method}()`", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3346
pub fn apply_jobs_runtime(method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    endpoint :: if jet_services_active_execution_endpoint() == { Ok(endpoint) -> endpoint; Err(error) -> return queue_failed(error) }
    apply_jobs_runtime_for_endpoint(endpoint, method, args, span)
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3361
pub fn apply_jobs_method_mir(receiver: &MirRuntimeValue, method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    (endpoint, name) :: runtime_to_queue(receiver, span)?
    jet_services_authority_validate(endpoint).map_err(fn(_) { unsupported("JobQueue endpoint authority", span) })?
    queue := if queue_open(endpoint, name) == { Ok(queue) -> queue; Err(error) -> return queue_failed(error) }
    exact :: fn(expected: USize) -> Unit Diagnostic! { if args.len() != expected -> return Err(unsupported("JobQueue.{method} argument count", span)) }
    if method == {
        "enqueue" -> {
            if args.len() < 2 || args.len() > 3 -> return Err(unsupported("JobQueue.enqueue(Job, payload, key?)", span))
            job_type :: queue_job_type(queue_one(args, 0, "enqueue", span)?, span)?
            payload :: queue_payload(job_type, queue_one(args, 1, "enqueue", span)?, span)?
            request :: queue_request(job_type, payload, args, span)?
            queue_result_value(&queue.enqueue(request), queue_receipt_to_runtime)
        }
        "delay" -> {
            exact(3)?
            job_type :: queue_job_type(queue_one(args, 0, "delay", span)?, span)?
            payload :: queue_payload(job_type, queue_one(args, 1, "delay", span)?, span)?
            delay_ms :: queue_duration_ms(queue_one(args, 2, "delay", span)?, span)?
            queue_result_value(&queue.enqueue_delayed(job_type, payload, delay_ms, None, None), queue_receipt_to_runtime)
        }
        "receipt" -> {
            exact(1)?
            id :: queue_text(queue_one(args, 0, "receipt", span)?, "JobQueue", "id", span)?
            queue_result_value(queue.receipt(id), queue_receipt_to_runtime)
        }
        "inspect" -> {
            exact(2)?
            // GATE #4483: selected-target USize checked conversion.
            limit :: USize.try_from(queue_int(queue_one(args, 0, "inspect", span)?, "JobQueue", "limit", span)?).map_err(fn(_) { unsupported("JobQueue.inspect limit", span) })?
            include_payload :: queue_bool(queue_one(args, 1, "inspect", span)?, "JobQueue", "include_payload", span)?
            queue_result_value(queue.inspect(limit, include_payload), fn(records) { MirRuntimeValue.List(records.into_iter().map(queue_record_to_runtime).collect()) })
        }
        "events" -> {
            exact(1)?
            id :: queue_text(queue_one(args, 0, "events", span)?, "JobQueue", "id", span)?
            queue_result_value(queue.events(id), fn(events) { MirRuntimeValue.List(events.into_iter().map(queue_event_to_runtime).collect()) })
        }
        "claim" -> {
            exact(2)?
            worker :: queue_text(queue_one(args, 0, "claim", span)?, "JobQueue", "worker", span)?
            limit :: USize.try_from(queue_int(queue_one(args, 1, "claim", span)?, "JobQueue", "limit", span)?).map_err(fn(_) { unsupported("JobQueue.claim limit", span) })?
            queue_result_value(&queue.claim(worker, limit), fn(claims) { MirRuntimeValue.List(claims.into_iter().map(queue_claim_to_runtime).collect()) })
        }
        "heartbeat" -> {
            exact(1)?
            claim :: runtime_to_queue_claim(queue_one(args, 0, "heartbeat", span)?, span)?
            queue_result_value(&queue.heartbeat(claim), queue_receipt_to_runtime)
        }
        "acknowledge" -> {
            exact(2)?
            claim :: runtime_to_queue_claim(queue_one(args, 0, "acknowledge", span)?, span)?
            result :: runtime_to_queue_result(queue_one(args, 1, "acknowledge", span)?, span)?
            queue_result_value(&queue.acknowledge(claim, result), queue_receipt_to_runtime)
        }
        "fail" -> {
            exact(2)?
            claim :: runtime_to_queue_claim(queue_one(args, 0, "fail", span)?, span)?
            error :: runtime_to_queue_error(queue_one(args, 1, "fail", span)?, span)?
            queue_result_value(&queue.fail(claim, error), queue_receipt_to_runtime)
        }
        "cancel" | "dead_letter" -> {
            if args.len() < 2 || args.len() > 3 -> return Err(unsupported("JobQueue.{method}(id, reason, lease_token?)", span))
            id :: queue_text(queue_one(args, 0, method, span)?, "JobQueue", "id", span)?
            reason :: queue_text(queue_one(args, 1, method, span)?, "JobQueue", "reason", span)?
            lease_token :: queue_optional_text(args, 2, "JobQueue", "lease_token", span)?
            result :: if method == "cancel" -> &queue.cancel(id, reason, lease_token.as_deref()) else -> &queue.dead_letter(id, reason, lease_token.as_deref())
            queue_result_value(result, queue_receipt_to_runtime)
        }
        "recover_expired" -> { exact(0)?; queue_result_value(&queue.recover_expired(), fn(_) { MirRuntimeValue.Unit }) }
        "status" -> { exact(0)?; queue_result_value(queue.status(), queue_status_to_runtime) }
        "pause" | "resume" -> {
            exact(0)?
            result :: if method == "pause" -> &queue.pause() else -> &queue.resume()
            queue_result_value(result, queue_status_to_runtime)
        }
        "wait" -> {
            exact(1)?
            timeout_ms :: queue_timeout_ms(queue_one(args, 0, "wait", span)?, span)?
            queue_result_value(&queue.wait(timeout_ms), queue_status_to_runtime)
        }
        "prune" -> { exact(0)?; queue_result_value(&queue.prune(), fn(count) { MirRuntimeValue.Int(I64.try_from(count).unwrap_or(I64.MAX)) }) }
        _ -> return Err(unsupported("`JobQueue.{method}()`", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3505
pub fn apply_jobs_method(receiver: &CtValue, method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    receiver :: ct_to_runtime_value(receiver)?
    converted := [MirRuntimeValue]{}
    loop item in args -> &converted.push(ct_to_runtime_value(item)?)
    runtime_to_ct_value(apply_jobs_method_mir(receiver, method, converted, span)?)?
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:3519
pub fn apply_jobs(method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    converted := [MirRuntimeValue]{}
    loop item in args -> &converted.push(ct_to_runtime_value(item)?)
    runtime_to_ct_value(apply_jobs_runtime(method, converted, span)?)?
}
