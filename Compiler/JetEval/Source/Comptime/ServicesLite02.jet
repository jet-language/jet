// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:2232
fn runtime_to_service_error(value: &MirRuntimeValue, span: Span) -> JetServiceError Diagnostic! {
    if value != .Enum(type_name, variant, args) -> return Err(unsupported("ServiceError", span))
    if type_name != "ServiceError" || args.len() != 1 -> return Err(unsupported("ServiceError", span))
    if args[0].1 != .String(message) -> return Err(unsupported("ServiceError message", span))
    message :: message.clone()
    if variant == {
        "Full" -> .Full(message); "Ambiguous" -> .Ambiguous(message); "Unknown" -> .Unknown(message)
        "NotStarted" -> .NotStarted(message); "Policy" -> .Policy(message); "Unavailable" -> .Unavailable(message)
        "Partitioned" -> .Partitioned(message); "Revoked" -> .Revoked(message); "Stale" -> .Stale(message); "Expired" -> .Expired(message)
        _ -> return Err(unsupported("ServiceError variant", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:2265
pub fn service_display_value_runtime(value: &MirRuntimeValue) -> String? {
    span :: Span.new(0, 0)
    if value == {
        .Enum(type_name, _, _) -> if type_name == {
            "DeliveryState" -> Val((runtime_to_delivery_state(value, span).ok() ?? return None).jet_show())
            "ServiceError" -> Val((runtime_to_service_error(value, span).ok() ?? return None).jet_show())
            _ -> None
        }
        .Struct(type_name, _) -> if type_name == {
            "Delivery" -> Val((runtime_to_delivery_record(value, span).ok() ?? return None).jet_show())
            "DeliveryReceipt" -> Val((runtime_to_delivery_receipt(value, span).ok() ?? return None).jet_show())
            "DeliveryEvent" -> Val((runtime_to_delivery_event(value, span).ok() ?? return None).jet_show())
            "ServiceEndpoint" -> Val((runtime_to_endpoint(value, span).ok() ?? return None).jet_show())
            "ServiceRuntime" -> Val((runtime_value_to_service_runtime(value, span).ok() ?? return None).jet_show())
            _ -> None
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:2295
pub fn service_show_value_runtime(value: &MirRuntimeValue) -> String? {
    span :: Span.new(0, 0)
    if value == {
        .Enum(type_name, _, _) -> if type_name == {
            "ServiceRestart" -> Val((runtime_to_restart(value, span).ok() ?? return None).jet_show())
            "ServiceDelivery" -> Val((runtime_to_delivery(value, span).ok() ?? return None).jet_show())
            "TaskOutcome" -> Val((runtime_to_task_outcome(value, span).ok() ?? return None).jet_show())
            "TaskStatus" -> Val((runtime_to_task_status(value, span).ok() ?? return None).jet_show())
            _ -> service_display_value_runtime(value)
        }
        .Struct(type_name, _) -> if type_name == {
            "ServiceStateStore" -> Val((runtime_to_state_store(value, span).ok() ?? return None).jet_show())
            "ServiceUpgradeReceipt" -> Val((runtime_to_upgrade_receipt(value, span).ok() ?? return None).jet_show())
            _ -> service_display_value_runtime(value)
        }
        _ -> service_display_value_runtime(value)
    }
}
