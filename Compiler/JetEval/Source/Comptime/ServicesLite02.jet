fn runtime_to_queue_payload(value: &MirRuntimeValue, span: Span) -> JetJobPayload Diagnostic! {
    if value != .Struct(type_name, fields) -> return Err(unsupported("JobPayload", span))
    if type_name != "JobPayload" -> return Err(unsupported("JobPayload", span))
    type_id :: queue_text(queue_field(fields, type_name, "type_id", span)?, type_name, "type_id", span)?
    bytes :: if queue_field(fields, type_name, "bytes", span)? == { .Bytes(bytes) -> bytes.clone(); _ -> return Err(unsupported("JobPayload.bytes", span)) }
    publish :: queue_bool(queue_field(fields, type_name, "publish", span)?, type_name, "publish", span)?
    JetJobPayload.new(type_id, bytes, publish).map_err(fn(_) { unsupported("JobPayload", span) })?
}
