pub fn apply_runtime(method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    one :: fn(i: USize) -> &MirRuntimeValue Diagnostic! { args.get(i) ?? return Err(unsupported("core.service.{method} arg {i}", span)) }
    if method == {
        "tree" -> tree_to_runtime(jet_services_tree(runtime_to_service_string(one(0)?, MAX_SERVICE_NAME, "tree name", span)?))
        "runtime" -> {
            store :: runtime_to_service_string(one(0)?, SERVICE_AUTH_MAX_STORE, "ServiceRuntime.store", span)?
            if one(1)? != .Struct(type_name, fields) -> return Err(unsupported("ServiceRuntime.retention_ms", span))
            if type_name != "Duration" -> return Err(unsupported("ServiceRuntime.retention_ms", span))
            retention_ms :: fields.iter().find_map(fn(pair) { if (pair.0, pair.1) == { ("ns", .Int(ns)) -> Val(ns / 1000000); _ -> None } }) ?? return Err(unsupported("ServiceRuntime.retention_ms", span))
            service_runtime_to_value(jet_services_runtime(store, retention_ms))
        }
        "restart_one_for_one" -> restart_to_runtime(jet_services_restart_one_for_one())
        "restart_one_for_all" -> restart_to_runtime(jet_services_restart_one_for_all())
        "restart_rest_for_one" -> restart_to_runtime(jet_services_restart_rest_for_one())
        "delivery_at_most_once" -> delivery_to_runtime(jet_services_delivery_at_most_once())
        "delivery_durable" -> delivery_to_runtime(jet_services_delivery_durable())
        "state_store" -> {
            path :: runtime_to_service_string(one(0)?, MAX_SERVICE_STATE_STORE, "service state store", span)?
            if jet_services_state_store(path) == { Ok(store) -> MirRuntimeValue.Present(state_store_to_runtime(store)); Err(error) -> MirRuntimeValue.FailedTold(map_err(error)) }
        }
        "set_restart" -> {
            tree := runtime_to_tree(one(0)?, span)?
            restart :: runtime_to_restart(one(1)?, span)?
            if jet_services_set_restart(&tree, restart) == { Ok(_) -> MirRuntimeValue.Present(mutate_ok(tree, MirRuntimeValue.Unit)); Err(e) -> mutate_err(tree, map_err(e)) }
        }
        "set_delivery" -> {
            tree := runtime_to_tree(one(0)?, span)?
            delivery :: runtime_to_delivery(one(1)?, span)?
            if jet_services_set_delivery(&tree, delivery) == { Ok(_) -> MirRuntimeValue.Present(mutate_ok(tree, MirRuntimeValue.Unit)); Err(e) -> mutate_err(tree, map_err(e)) }
        }
        "worker" -> {
            if args.len() != 5 -> return Err(unsupported("core.service.worker expects five arguments", span))
            tree := runtime_to_tree(one(0)?, span)?
            name :: runtime_to_service_string(one(1)?, MAX_SERVICE_NAME, "worker name", span)?
            handler_name :: runtime_to_service_string(one(3)?, MAX_SERVICE_NAME, "worker handler", span)?
            capacity :: if one(4)? == { .Int(n) -> n; _ -> return Err(unsupported("capacity", span)) }
            // Callback is retained by the engine; kernel stores its checked handler identity.
            if jet_services_worker(&tree, name, jet_services_noop_worker, handler_name, capacity) == { Ok(ep) -> MirRuntimeValue.Present(mutate_ok(tree, endpoint_to_runtime(ep))); Err(e) -> mutate_err(tree, map_err(e)) }
        }
        "group" -> {
            tree := runtime_to_tree(one(0)?, span)?
            name :: runtime_to_service_string(one(1)?, MAX_SERVICE_NAME, "group name", span)?
            if one(2)? != .List(xs) -> return Err(unsupported("group workers", span))
            if xs.len() > MAX_SERVICE_WORKERS -> return Err(unsupported("group worker limit", span))
            workers := [String]{}
            loop x in xs -> &workers.push(runtime_to_service_string(x, MAX_SERVICE_NAME, "group worker", span)?)
            if jet_services_group(&tree, name, workers) == { Ok(_) -> MirRuntimeValue.Present(mutate_ok(tree, MirRuntimeValue.Unit)); Err(e) -> mutate_err(tree, map_err(e)) }
        }
        "stop" -> {
            tree := runtime_to_tree(one(0)?, span)?
            if jet_services_stop(&tree) == { Ok(_) -> MirRuntimeValue.Present(mutate_ok(tree, MirRuntimeValue.Unit)); Err(e) -> mutate_err(tree, map_err(e)) }
        }
        "send" -> {
            tree := runtime_to_tree(one(0)?, span)?
            endpoint :: runtime_to_endpoint(one(1)?, span)?
            message :: runtime_to_service_string(one(2)?, MAX_SERVICE_MESSAGE, "message", span)?
