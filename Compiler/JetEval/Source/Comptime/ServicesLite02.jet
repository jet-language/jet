pub fn apply_runtime_start_with_dispatcher(value: &MirRuntimeValue, span: Span, dispatch: fn(String, &JetServiceEndpoint) -> Unit JetServiceError!) -> MirRuntimeValue Diagnostic! {
    tree := runtime_to_tree(value, span)?
    if jet_services_start_with_queue_dispatcher(&tree, dispatch) == { Ok(_) -> MirRuntimeValue.Present(mutate_ok(tree, MirRuntimeValue.Unit)); Err(error) -> mutate_err(tree, map_err(error)) }
}
