//RS /// Apply a direct `core.jobs` call for an explicitly checked endpoint.
//RS /// Runtime adapters use this form when the graph entry has an endpoint value;
//RS /// the ordinary wrapper below obtains the same endpoint from the active scope.
//RS pub fn apply_jobs_runtime(
//RS     method: &str,
//RS     args: &[MirRuntimeValue],
//RS     span: Span,
//RS ) -> Result<MirRuntimeValue, Diagnostic> {
//RS     let endpoint = match jet_services_active_execution_endpoint() {
