// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:1998
fn map_err(err: JetServiceError) -> MirRuntimeValue {
    (variant, message) :: if err == {
        .Full(m) -> ("Full", m); .Ambiguous(m) -> ("Ambiguous", m); .Unknown(m) -> ("Unknown", m)
        .NotStarted(m) -> ("NotStarted", m); .Policy(m) -> ("Policy", m); .Unavailable(m) -> ("Unavailable", m)
        .Partitioned(m) -> ("Partitioned", m); .Revoked(m) -> ("Revoked", m); .Stale(m) -> ("Stale", m); .Expired(m) -> ("Expired", m)
    }
    MirRuntimeValue.Enum{type_name: "ServiceError", variant: variant, args: [(None, MirRuntimeValue.String(message))]}
}
