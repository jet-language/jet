    id :: if field("id")? == { .String(value) -> value.clone(); _ -> return Err(unsupported("Delivery.id", span)) }
    store :: if field("store")? == { .String(value) -> value.clone(); _ -> return Err(unsupported("Delivery.store", span)) }
    duplicate :: if field("duplicate")? == { .Bool(value) -> value; _ -> return Err(unsupported("Delivery.duplicate", span)) }
    authority :: if field("authority")? == { .String(value) -> value.clone(); _ -> return Err(unsupported("Delivery.authority", span)) }
    generation :: if field("generation")? == { .Int(value) -> value; _ -> return Err(unsupported("Delivery.generation", span)) }
    JetDelivery{id: id, store: store, duplicate: duplicate, authority: authority, generation: generation}
