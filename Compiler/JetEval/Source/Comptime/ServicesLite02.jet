// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:2466
pub fn take_mut_runtime(value: MirRuntimeValue) -> (MirRuntimeValue, MirRuntimeValue) MirRuntimeValue! {
    if value == {
        .Present(inner) -> if inner == {
            .Struct(type_name, fields) -> {
                if type_name != "__JetServiceMut" -> return (MirRuntimeValue.Unit, MirRuntimeValue.Present(inner))
                tree :: fields.iter().find(fn(pair) { pair.0 == "tree" }).map(fn(pair) { pair.1.clone() }) ?? return Err(MirRuntimeValue.FailedTold(MirRuntimeValue.String("core.service: missing tree write-back")))
                val :: fields.iter().find(fn(pair) { pair.0 == "value" }).map(fn(pair) { pair.1.clone() }) ?? return Err(MirRuntimeValue.FailedTold(MirRuntimeValue.String("core.service: missing value write-back")))
                (tree, MirRuntimeValue.Present(val))
            }
            other -> (MirRuntimeValue.Unit, MirRuntimeValue.Present(other))
        }
        .FailedTold(inner) -> if inner == {
            .Struct(type_name, fields) -> {
                if type_name != "__JetServiceMutErr" -> return Err(MirRuntimeValue.FailedTold(inner))
                tree :: fields.iter().find(fn(pair) { pair.0 == "tree" }).map(fn(pair) { pair.1.clone() }) ?? return Err(MirRuntimeValue.FailedTold(MirRuntimeValue.String("core.service: missing tree write-back")))
                error :: fields.iter().find(fn(pair) { pair.0 == "error" }).map(fn(pair) { pair.1.clone() }) ?? return Err(MirRuntimeValue.FailedTold(MirRuntimeValue.String("core.service: missing error write-back")))
                (tree, MirRuntimeValue.FailedTold(error))
            }
            other -> return Err(MirRuntimeValue.FailedTold(other))
        }
        other -> return Err(other)
    }
}
