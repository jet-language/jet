// Rust: crates/jet-comptime/src/Comptime/ServicesLite.rs:2361
pub fn apply_runtime_method_mir(receiver: &MirRuntimeValue, method: String, args: &[MirRuntimeValue], span: Span) -> MirRuntimeValue Diagnostic! {
    runtime :: runtime_value_to_service_runtime(receiver, span)?
    one :: fn(index: USize) -> &MirRuntimeValue Diagnostic! { args.get(index) ?? return Err(unsupported("ServiceRuntime.{method} arg {index}", span)) }
    if method == {
        "send" -> {
            endpoint :: runtime_to_endpoint(one(0)?, span)?
            message :: runtime_to_service_string(one(1)?, SERVICE_AUTH_MAX_MESSAGE, "ServiceRuntime.send message", span)?
            key :: runtime_to_service_string(one(2)?, SERVICE_AUTH_MAX_KEY, "ServiceRuntime.send key", span)?
            if jet_services_runtime_send(runtime, endpoint, message, key) == { Ok(delivery) -> MirRuntimeValue.Present(delivery_record_to_runtime(delivery)); Err(error) -> MirRuntimeValue.FailedTold(map_err(error)) }
        }
        "retry" | "dead_letter" | "retain" -> {
            delivery :: runtime_to_delivery_record(one(0)?, span)?
            result :: if method == { "retry" -> jet_services_runtime_retry(runtime, delivery); "dead_letter" -> jet_services_runtime_dead_letter(runtime, delivery); _ -> jet_services_runtime_retain(runtime, delivery) }
            if result == { Ok(delivery) -> MirRuntimeValue.Present(delivery_record_to_runtime(delivery)); Err(error) -> MirRuntimeValue.FailedTold(map_err(error)) }
        }
        "commit" -> {
            delivery :: runtime_to_delivery_record(one(0)?, span)?
            if jet_services_runtime_commit(runtime, delivery) == { Ok(_) -> MirRuntimeValue.Present(MirRuntimeValue.Unit); Err(error) -> MirRuntimeValue.FailedTold(map_err(error)) }
        }
        _ -> return Err(unsupported("ServiceRuntime.{method}", span))
    }
}
