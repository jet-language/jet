    if type_name != "JobError" -> return Err(unsupported("JobError", span))
    detail :: if queue_field(fields, type_name, "detail", span)? == {
        .Absent(_) -> None
        .Present(value) -> if value == { .String(value) -> Val(value.clone()); _ -> return Err(unsupported("JobError.detail", span)) }
        .String(value) -> Val(value.clone())
        _ -> return Err(unsupported("JobError.detail", span))
    }
    JetJobError.new(queue_text(queue_field(fields, type_name, "type_id", span)?, type_name, "type_id", span)?, queue_text(queue_field(fields, type_name, "reason", span)?, type_name, "reason", span)?, detail).map_err(fn(_) { unsupported("JobError", span) })?
