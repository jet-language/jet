// core.auth shares session/password/magic-link/OAuth policy with canonical kernels.
// JWT/PASETO verification is intentionally routed to the AOT/subset tier, not here.
use jet_comptime.Comptime.Diagnostics.unsupported
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.AST.[CtValue, Type]
use jet_foundation.Outcome.*
use jet_codegen.Prelude.CoreLib.Top.[CryptoEntropy, SHA256Raw, AuthSession]
use jet_crypto_entropy.[jet_crypto_entropy_fill, JetCryptoEntropyError]
use jet_codegen.Prelude.CoreLib.Top.AuthSession.*

// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:21
fn session_to_ct(s: JetAuthSession) -> CtValue {
    CtValue.Struct { type_name: "Session", fields: [("id", CtValue.Str(s.id.clone())), ("user_id", CtValue.Str(s.user_id.clone())), ("expires_at", CtValue.Int(s.expires_at)), ("cookie", CtValue.Str(s.cookie.clone()))] }
}
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:33
fn ct_to_session(v: CtValue, span: Span) -> JetAuthSession Diagnostic! {
    (type_name, fields) := v == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("Session", span) } }
    if type_name != "Session" && type_name != "JetAuthSession" { fail unsupported("Session", span) }
    field := fn(name: String) -> CtValue Diagnostic! { fields.iter().find(fn(entry) { entry.0 == name }).map(fn(entry) { entry.1 }) == { Val(value) -> value; None -> { fail unsupported("Session field", span) } } }
    JetAuthSession {
        id: field("id")? == { Str(s) -> s.clone(); _ -> { fail unsupported("id", span) } },
        user_id: field("user_id")? == { Str(s) -> s.clone(); _ -> { fail unsupported("user_id", span) } },
        expires_at: field("expires_at")? == { Int(n) -> n; _ -> { fail unsupported("expires_at", span) } },
        cookie: field("cookie")? == { Str(s) -> s.clone(); _ -> { fail unsupported("cookie", span) } }
    }
}
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:67
fn auth_to_ct(a: JetAuthApp) -> CtValue { CtValue.Struct { type_name: "Auth", fields: [("users_table", CtValue.Str(a.users_table.clone())), ("providers", CtValue.Str(a.providers.join(",")))] } }
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:80
fn ct_to_auth(v: CtValue, span: Span) -> JetAuthApp Diagnostic! {
    (type_name, fields) := v == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("Auth", span) } }
    if type_name != "Auth" && type_name != "JetAuthApp" { fail unsupported("Auth", span) }
    users := fields.iter().find(fn(entry) { entry.0 == "users_table" }).and_then(fn(entry) { entry.1 == { Str(s) -> Val(s.clone()); _ -> None } }) == { Val(users) -> ^users; None -> { fail unsupported("users_table", span) } }
    providers := fields.iter().find(fn(entry) { entry.0 == "providers" }).and_then(fn(entry) { entry.1 == { Str(s) -> Val(s.split(',').filter(fn(p) { !p.is_empty() }).map(fn(p) { p.to_string() }).collect()); _ -> None } }) == { Val(providers) -> ^providers; None -> { fail unsupported("providers", span) } }
    JetAuthApp { users_table: ^users, providers: ^providers }
}
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:114
fn result_session(r: JetAuthSession Err!) -> CtValue { r == { Ok(s) -> CtValue.Present(session_to_ct(s)); Err(e) -> CtValue.failed(CtValue.Str(^e)) } }
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:121
fn result_unit(r: Unit Err!) -> CtValue { r == { Ok(_) -> CtValue.Present(CtValue.Unit); Err(e) -> CtValue.failed(CtValue.Str(^e)) } }
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:128
fn result_str(r: String Err!) -> CtValue { r == { Ok(s) -> CtValue.Present(CtValue.Str(^s)); Err(e) -> CtValue.failed(CtValue.Str(^e)) } }

// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:135
pub fn apply(method: String, args: [CtValue], span: Span) -> CtValue Diagnostic! {
    one := fn(i: USize) -> CtValue Diagnostic! { args.get(i) == { Val(value) -> value; None -> { fail unsupported("core.auth.{method} arg {i}", span) } } }
    as_str := fn(i: USize) -> String Diagnostic! { one(i)? == { Str(s) -> s.clone(); _ -> { fail unsupported("String", span) } } }
    as_int := fn(i: USize) -> I64 Diagnostic! { one(i)? == { Int(n) -> n; _ -> { fail unsupported("Int", span) } } }
    // GATE #4494: canonical AuthSession kernel uses real entropy/session providers.
    method == {
        "register_user" -> result_unit(jet_auth_register_user(as_str(0)?, as_str(1)?))
        "password_login" -> result_session(jet_auth_password_login(as_str(0)?, as_str(1)?, as_int(2)?, as_int(3)?))
        "session_validate" -> result_session(jet_auth_session_validate(as_str(0)?, as_int(1)?))
        "session_show" -> CtValue.Str(jet_auth_session_show(ct_to_session(one(0)?, span)?))
        "session_user" -> CtValue.Str(jet_auth_session_user(ct_to_session(one(0)?, span)?))
        "session_cookie" -> CtValue.Str(jet_auth_session_cookie(ct_to_session(one(0)?, span)?))
        "session_id" -> CtValue.Str(jet_auth_session_id(ct_to_session(one(0)?, span)?))
        "magic_link_issue" -> result_str(jet_auth_magic_link_issue(as_str(0)?, as_int(1)?, as_int(2)?))
        "magic_link_consume" -> result_session(jet_auth_magic_link_consume(as_str(0)?, as_int(1)?, as_int(2)?))
        "oauth_begin" -> result_str(jet_auth_oauth_begin(as_str(0)?))
        "oauth_finish" -> result_session(jet_auth_oauth_finish(as_str(0)?, as_str(1)?, as_int(2)?, as_int(3)?))
        "auth" -> auth_to_ct(jet_app_auth(as_str(0)?))
        "auth_oauth" -> auth_to_ct(jet_app_auth_oauth(ct_to_auth(one(0)?, span)?, as_str(1)?))
        "auth_routes" -> CtValue.Str(jet_app_auth_routes(ct_to_auth(one(0)?, span)?))
        "auth_show" -> CtValue.Str(jet_app_auth_show(ct_to_auth(one(0)?, span)?))
        _ -> { fail unsupported("`core.auth.{method}()`", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/AuthLite.rs:208
fn _type_anchor() -> Type { Type.Named("Session") }
