pub struct DataPipelineState { loaders: [ComptimeLoader?], streams: [ComptimeStream?], queries: [ComptimeQuery?], tracked: [ComptimeTracked?], watches: [ComptimeWatch?], plots: [data_plot_rt.JetDataPlot<CtValue>?] }
