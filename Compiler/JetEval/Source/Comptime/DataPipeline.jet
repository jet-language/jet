fn data_loader_new(registry: &DataPipelineState, kind: PreludeDataFlow.LoaderKind, locator: String, member: String, parameters: [String], format: String, limits: DataKernelLimits, authority: PreludeDataFlow.Authority, payload: [U8]?, decode_ty: Type?, seed: CtValue?) -> CtValue CtValue! {
    state := PreludeDataFlow.new_loader(kind, ^locator, ^member, ^parameters, ^format, ^limits, ^authority).map_err(data_loader_kernel_failure)?
    if payload == .Val(payload) {
        PreludeDataFlow.check_payload(&state.limits, payload.len(), "data.value").map_err(data_loader_kernel_failure)?
        state.payload = Val(^payload)
    }
    store_data_loader(registry, ComptimeLoader{state: ^state, seed: ^seed, decode_ty: ^decode_ty})
}
