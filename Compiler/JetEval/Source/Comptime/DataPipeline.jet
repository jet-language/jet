// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1584
fn data_arrow_limits(limits: &DataKernelLimits) -> ArrowData.ArrowLimits CtValue! {
    max_buffer_bytes :: USize.try_from(limits.max_expansion_bytes).map_err(fn(_) { data_loader_failure("Limit", "data.loader.parquet", "max_expansion_bytes cannot be represented by this target") })?
    max_total_i64 :: limits.max_total_bytes.unwrap_or_else(fn() { limits.max_item_bytes.max(limits.max_expansion_bytes) })
    max_total_bytes :: USize.try_from(max_total_i64).map_err(fn(_) { data_loader_failure("Limit", "data.loader.parquet", "max_total_bytes cannot be represented by this target") })?
    ArrowData.ArrowLimits{max_rows: limits.max_output_rows, max_columns: 1024, max_children: limits.max_depth, max_dictionary_values: limits.max_output_rows, max_buffer_bytes: max_buffer_bytes, max_total_bytes: max_total_bytes}
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1616
fn data_arrow_tree_value(value: DataTree.DataTree) -> CtValue {
    if value == {
        .Null -> JSONInterp.json_variant("Null", None)
        .Bool(value) -> JSONInterp.json_variant("Bool", Val(CtValue.Bool(value)))
        .Int(value) -> JSONInterp.json_variant("Int", Val(CtValue.Int(value)))
        .Float(value) -> JSONInterp.json_variant("Float", Val(CtValue.Float(CtFloat.f64(value))))
        .Number(value) -> JSONInterp.json_variant("Number", Val(CtValue.Str(^value)))
        .TypedText(value) | .Text(value) -> JSONInterp.json_variant("Text", Val(CtValue.Str(^value)))
        .Bytes(value) -> JSONInterp.json_variant("Bytes", Val(CtValue.Bytes(^value)))
        .Array(values) -> data_dynamic_array(values.into_iter().map(data_arrow_tree_value).collect())
        .Object(fields) -> data_dynamic_object(fields.into_iter().map(fn(pair) { (pair.0, data_arrow_tree_value(pair.1)) }).collect())
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1654
fn data_arrow_tree_failure(error: ArrowData.ArrowError) -> CtValue {
    kind :: if error.kind == { .Limit -> "Limit"; .ProducerFailure -> "Bridge"; else -> "Decode" }
    data_loader_failure(kind, "data.loader.parquet", error.to_string())
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1663
fn data_arrow_tree(payload: &[U8], limits: &DataKernelLimits) -> CtValue CtValue! {
    arrow_limits :: data_arrow_limits(limits)?
    ArrowFileReader.read_tree(ArrowFileReader.FORMAT_PARQUET, payload, &arrow_limits).map(data_arrow_tree_value).map_err(data_arrow_tree_failure)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1677
fn data_dynamic_tree(payload: &[U8], format: String, limits: &DataKernelLimits) -> CtValue CtValue! {
    if format == "parquet" -> return data_arrow_tree(payload, limits)
    if format == "arrow" -> return .Err(data_loader_failure("Bridge", "data.loader", "Arrow IPC has a separate provider boundary; Parquet is the registered reader"))
    text :: String.from_utf8(payload.to_vec()).map_err(fn(error) { data_loader_failure("Decode", "data.loader", "payload is not UTF-8: {error}") })?
    tree :: if format == {
        "json" -> JSONInterp.parse_json_typed_ordered(text).map_err(fn(error) { data_loader_failure("Decode", "data.loader.json", "invalid JSON (line {error.line}): {error.message}") })?
        "jsonl" -> {
            values := [CtValue]{}
            loop (line_index, line) in text.lines().enumerate() {
                line := line.trim() // #4303
                if line.is_empty() -> continue
                if values.len() as I64 >= limits.max_output_rows -> return .Err(data_loader_failure("Limit", "data.loader.jsonl", "max_output_rows {limits.max_output_rows} exceeded"))
                value :: JSONInterp.parse_json_typed_ordered(line).map_err(fn(error) { data_loader_failure("Decode", "data.loader.jsonl", "invalid JSONL record at line {line_index + 1} (line {error.line}): {error.message}") })?
                values.push(^value)
            }
            data_dynamic_array(^values)
        }
        "csv" -> {
            records :: EncodingLite.csv_parse(text, ",", false, false).map_err(fn(reason) { data_loader_failure("Decode", "data.loader.csv", reason) })?
            header :: records.first() ?? return data_dynamic_array([])
            header_names := [String:Bool]{}
            loop name in header.fields {
                PreludeDataFlow.validate_public_text("CSV header", name, false).map_err(data_loader_kernel_failure)?
                if header_names.insert(name.clone(), true).is_some() -> return .Err(data_loader_failure("Decode", "data.loader.csv", "duplicate CSV header `{name}`"))
            }
            values := [CtValue]{}
            loop record in records.iter().skip(1) {
                if values.len() as I64 >= limits.max_output_rows -> return .Err(data_loader_failure("Limit", "data.loader.csv", "max_output_rows {limits.max_output_rows} exceeded"))
                if record.fields.len() > header.fields.len() -> return .Err(data_loader_failure("Decode", "data.loader.csv", "CSV row has {record.fields.len()} fields; header has {header.fields.len()}"))
                fields :: header.fields.iter().enumerate().map(fn(pair) {
                    (index, name) :: pair
                    (name.clone(), record.fields.get(index).map(fn(value) { JSONInterp.json_variant("TypedText", Val(CtValue.Str(value.clone()))) }).unwrap_or_else(fn() { JSONInterp.json_variant("Null", None) }))
                }).collect()
                values.push(data_dynamic_object(^fields))
            }
            data_dynamic_array(^values)
        }
        "parquet" | "arrow" -> return .Err(data_loader_bridge("data.loader"))
        else -> return .Err(data_loader_failure("Bridge", "data.loader", "format `{format}` is provider-owned; import its package"))
    }
    if data_dynamic_rows(&tree).len() as I64 > limits.max_output_rows -> return .Err(data_loader_failure("Limit", "data.loader", "max_output_rows {limits.max_output_rows} exceeded"))
    tree
}
