fn tracked_replace(state: &DataPipelineState, tracked: &CtValue, key_value: CtValue, row: CtValue, call: QueryCallback, span: Span) -> Unit Diagnostic! {
    id :: tracked_id(state, tracked, span)?
    key_callback :: state.tracked[id - 1].as_ref().map(fn(slot) { slot.key.clone() }).ok_or_else(fn() { unsupported("`DataTracked` state slot is stale", span) })?
    existing_rows :: state.tracked[id - 1].as_ref().map(fn(slot) { slot.rows.clone() }).ok_or_else(fn() { unsupported("`DataTracked` state slot is stale", span) })?
