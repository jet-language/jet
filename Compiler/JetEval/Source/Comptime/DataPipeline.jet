// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:958
fn tracked_revision(state: &DataPipelineState, tracked: USize, span: Span) -> U64 Diagnostic! {
    state.tracked.get(tracked).and_then(fn(slot) { slot.as_ref() }).map(fn(slot) {
        slot.changes.last().map(fn(change) { change.revision }).unwrap_or(slot.revision).max(slot.revision)
    }).ok_or_else(fn() { unsupported("`DataTracked` state slot is stale", span) })
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:978
fn watch_refresh(state: &DataPipelineState, watch: &CtValue, call: QueryCallback, span: Span) -> [CtValue] Diagnostic! {
    id :: watch_id(state, watch, span)?
    slot :: state.watches[id - 1].as_ref().ok_or_else(fn() { unsupported("`DataWatch` state slot is stale", span) })?
    source_revision :: query_source_revision(state, &slot.query, span)?
    query :: slot.query.clone()
    entries :: slot.entries.clone()
    generation :: slot.lifecycle.generation
    active :: slot.lifecycle.active
    cancelled :: slot.lifecycle.cancelled
    if !active || cancelled -> return .Err(unsupported("`DataWatch` is inactive", span))
    if source_revision == state.watches[id - 1].as_ref().unwrap().source_revision -> return entries
    if !state.watches[id - 1].as_mut().unwrap().lifecycle.begin_refresh(generation) -> return .Err(unsupported("`DataWatch` refresh was superseded", span))
    refreshed :: if collect_query_rows(state, &query, call, span) == {
        .Ok(rows) if rows.len() <= data_kernel_limits_safe().max_output_rows as USize -> rows
        .Ok(_) -> {
            error :: unsupported("`DataWatch` output exceeds max_output_rows", span)
            _ :: state.watches[id - 1].as_mut().unwrap().lifecycle.fail(generation, error.what.clone())
            return .Err(error)
        }
        .Err(error) -> {
            _ :: state.watches[id - 1].as_mut().unwrap().lifecycle.fail(generation, error.what.clone())
            return .Err(error)
        }
    }
    // GATE #4494: real lifecycle clock.
    fresh_at_ms :: LiveLifecycle.JetLiveLifecycle.active_now().fresh_at_ms
    retained_rows :: query_retained_rows(state, &query, span)?
    slot :: state.watches[id - 1].as_mut().ok_or_else(fn() { unsupported("`DataWatch` state slot is stale", span) })?
    if !slot.lifecycle.publish(generation, fresh_at_ms) -> return .Err(unsupported("`DataWatch` refresh was superseded", span))
    slot.entries = refreshed.clone()
    slot.source_revision = source_revision
    slot.retained_rows = retained_rows
    slot.recomputations = slot.recomputations.saturating_add(1)
    refreshed
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1049
fn query_source_revision(state: &DataPipelineState, query: &ComptimeQuery, span: Span) -> U64 Diagnostic! {
    revision := if query.tracked == { .Val(tracked) -> tracked_revision(state, tracked, span)?; .None -> 0 }
    loop operation in query.operations {
        if operation != .Join{right, ..} -> continue
        right_query :: clone_query(state, right, span)?
        right_revision :: query_source_revision(state, &right_query, span)?
        revision = revision.wrapping_mul(1_000_003).wrapping_add(right_revision.saturating_add(1))
    }
    revision
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1071
fn query_retained_rows(state: &DataPipelineState, query: &ComptimeQuery, span: Span) -> USize Diagnostic! {
    retained := if query.tracked == {
        .Val(tracked) -> state.tracked.get(tracked).and_then(fn(slot) { slot.as_ref() }).map(fn(slot) { slot.rows.len() }).ok_or_else(fn() { unsupported("`DataTracked` state slot is stale", span) })?
        .None -> query.rows.len()
    }
    loop operation in query.operations {
        if operation != .Join{right, ..} -> continue
        right_query :: clone_query(state, right, span)?
        retained = retained.checked_add(query_retained_rows(state, &right_query, span)?) ?? return .Err(unsupported("query retained row count overflowed", span))
    }
    retained
}
