fn loader_type_from_resolved(value: Type?) -> Type? {
    if value? == {
        .Result{ok, ..} | .Option(ok) -> loader_type_from_resolved(Val(ok))
        .Apply{name, args} if (name == "DataLoader" || name == "DataSnapshot" || name == "DataStream") && args.len() == 1 -> Val(args[0].clone())
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1503
fn typed_decode_failure_text(value: &CtValue) -> String {
    if value != .List(errors) -> return value.jet_show()
    reasons :: errors.iter().filter_map(fn(error) {
        path :: struct_field(error, "FieldError", "path").map(query_cell_text)?
        reason :: struct_field(error, "FieldError", "reason").map(query_cell_text)?
        Val(if path.is_empty() -> reason else -> "{path}: {reason}")
    }).collect<[String]>()
    if reasons.is_empty() -> value.jet_show() else -> reasons.join("; ")
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:1525
fn data_typed_tree(value: &CtValue) -> CtValue {
    if value == {
        .Enum{type_name, variant, args} if type_name == "DataTree" && variant == "TypedText" -> JSONInterp.json_variant("Text", args.first().map(fn(pair) { data_typed_tree(&pair.1) }))
        .Enum{type_name, variant, args} if type_name == "DataTree" -> CtValue.Enum{type_name: type_name.clone(), variant: variant.clone(), args: args.iter().map(fn(pair) { (pair.0.clone(), data_typed_tree(&pair.1)) }).collect()}
        else -> value.clone()
    }
}
