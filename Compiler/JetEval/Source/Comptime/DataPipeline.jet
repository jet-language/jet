        max_depth: data_int_field(struct_field(&encoding, "EncodingLimits", "max_depth"), defaults.max_depth),
        max_item_bytes: data_int_field(struct_field(&encoding, "EncodingLimits", "max_item_bytes"), defaults.max_item_bytes),
        max_total_bytes: data_optional_int(struct_field(&encoding, "EncodingLimits", "max_total_bytes")),
        max_expansion_depth: data_int_field(struct_field(&encoding, "EncodingLimits", "max_expansion_depth"), defaults.max_expansion_depth),
        max_expansion_bytes: data_int_field(struct_field(&encoding, "EncodingLimits", "max_expansion_bytes"), defaults.max_expansion_bytes),
        max_groups: data_int_field(struct_field(&value, "DataLimits", "max_groups"), defaults.max_groups),
        max_sort_rows: data_int_field(struct_field(&value, "DataLimits", "max_sort_rows"), defaults.max_sort_rows),
        max_join_rows: data_int_field(struct_field(&value, "DataLimits", "max_join_rows"), defaults.max_join_rows),
        max_output_rows: data_int_field(struct_field(&value, "DataLimits", "max_output_rows"), defaults.max_output_rows),
    }
}
