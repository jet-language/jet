    if id <= 0 -> return .Err(unsupported("`DataWatch` state slot is invalid", span))
    id :: USize.try_from(id).map_err(fn(_) { unsupported("`DataWatch` state slot is invalid", span) })?
    if state.watches.get(id - 1).and_then(fn(slot) { slot.as_ref() }).is_none() -> return .Err(unsupported("`DataWatch` state slot is stale", span))
