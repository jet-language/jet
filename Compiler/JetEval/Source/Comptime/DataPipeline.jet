// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:31
fn ct_struct(type_name: String, fields: [(String, CtValue)]) -> CtValue { CtValue.Struct{type_name: type_name, fields: ^fields} }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:40
fn struct_field(v: &CtValue, type_name: String, field: String) -> CtValue? {
    if v == {
        .Struct{type_name: t, fields} if t == type_name -> fields.iter().find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:49
fn expect_list(v: &CtValue, what: String, span: Span) -> &[CtValue] Diagnostic! {
    if v == { .List(xs) -> &xs; else -> return .Err(unsupported("`data.{what}` needs a list-backed value", span)) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:59
pub fn query_row_field(row: &CtValue, field: String) -> CtValue? {
    if row == {
        .Struct{fields, ..} -> fields.iter().find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
        .Enum{type_name, ..} if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" -> {
            if JSONInterp.json_payload(row, "Object") == {
                .Val(.Map(entries)) -> entries.iter().find_map(fn(pair) {
                    if pair.0 == { .Str(name) if name == field -> Val(pair.1); else -> None }
                })
                .Val(.Struct{fields, ..}) -> fields.iter().find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1 })
                else -> None
            }
        }
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:85
pub fn query_cell_text(value: &CtValue) -> String {
    if value == {
        .Enum{type_name, variant, args} if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" -> {
            if variant == "Null" -> String.new() else -> args.first().map(fn(pair) { query_cell_text(&pair.1) }).unwrap_or_default()
        }
        .Str(text) -> text.clone()
        .Int(value) -> value.to_string()
        .BigInt(value) -> value.to_string_rep()
        .Float(value) -> value.to_json()
        .Bool(value) -> value.to_string()
        else -> JSONInterp.render_json_pretty(value, false, 0)
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:108
fn query_cell_sql_value(value: &CtValue) -> sql_query.JetSqlValue? {
    if value == {
        .Unit -> Val(sql_query.JetSqlValue.Null)
        .Bool(value) -> Val(sql_query.JetSqlValue.Bool(value))
        .Int(value) -> Val(sql_query.JetSqlValue.Int(value))
        .BigInt(value) -> {
            text :: value.to_string_rep()
            text.parse<I64>().map(sql_query.JetSqlValue.Int).ok().or_else(fn() { Val(sql_query.JetSqlValue.Text(text)) })
        }
        .Float(value) -> Val(sql_query.JetSqlValue.Float(value.as_f64()))
        .Str(value) -> Val(sql_query.JetSqlValue.Text(value.clone()))
        .Enum{type_name, variant, args} if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" -> {
            if variant == {
                "Null" -> Val(sql_query.JetSqlValue.Null)
                "Bool" | "Int" | "Number" | "Float" | "TypedText" | "Text" -> args.first().and_then(fn(pair) { query_cell_sql_value(&pair.1) })
                else -> Val(sql_query.JetSqlValue.Text(query_cell_text(value)))
            }
        }
        else -> Val(sql_query.JetSqlValue.Text(query_cell_text(value)))
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:138
fn query_sql_value_ct(value: sql_query.JetSqlValue) -> CtValue {
    if value == { .Null -> CtValue.Unit; .Bool(value) -> CtValue.Bool(value); .Int(value) -> CtValue.Int(value); .Float(value) -> CtValue.Float(CtFloat.f64(value)); .Text(value) -> CtValue.Str(^value) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:148
fn query_runtime_fields(rows: &[CtValue]) -> [String] {
    rows.iter().find_map(fn(row) {
        if row == {
            .Struct{fields, ..} -> Val(fields.iter().map(fn(pair) { pair.0.clone() }).collect())
            .Enum{..} -> JSONInterp.json_payload(row, "Object").and_then(fn(value) {
                if value == {
                    .Struct{fields, ..} -> Val(fields.iter().map(fn(pair) { pair.0.clone() }).collect())
                    .Map(entries) -> Val(entries.iter().filter_map(fn(pair) { if pair.0 == { .Str(name) -> Val(name.clone()); else -> None } }).collect())
                    else -> None
                }
            })
            else -> None
        }
    }).unwrap_or_default()
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:174
fn data_schema_elem_ty(arg_ty: &Type) -> Type? {
    if arg_ty == { .List(inner) | .FixedList{elem: inner, ..} -> Val(inner); else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:180
fn data_join_right_type(call_ret: Type?) -> Type? {
    joined :: if call_ret? == { .Result{ok, ..} -> ok; ty -> ty }
    if joined != .List(join) -> return None
    if join != .Apply{name, args} -> return None
    if name != "DataJoin" || args.len() != 2 -> return None
    if args[1] == { .Option(inner) -> Val(inner.clone()); right -> Val(right.clone()) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:199
fn query_join_right_type(call_ret: Type?) -> Type? {
    if call_ret? != .Apply{name, args} -> return None
    if name != "Query" || args.len() != 1 -> return None
    if args[0] != .Apply{name: join_name, args: join_args} -> return None
    if join_name != "DataJoin" || join_args.len() != 2 -> return None
    if join_args[1] == { .Option(inner) -> Val(inner.clone()); right -> Val(right.clone()) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:221
fn query_sql_rows(rows: [CtValue], sql: String, declared_fields: [String]?) -> [CtValue] CtValue! {
    query :: sql_query.parse_sql_query(sql).map_err(fn(error) { TypedDecode.decode_error("`data.query()`: {error}") })?
    sql_query.validate_sql_query_schema(&query, fn(field) {
        if declared_fields == {
            .Val(fields) -> fields.iter().any(fn(known) { known == field })
            .None if rows.is_empty() -> true
            .None -> rows.iter().any(fn(row) { query_row_field(row, field).is_some() })
        }
    }, "`data.query()`").map_err(TypedDecode.decode_error)?
    if query.needs_projection_execution() {
        fields :: declared_fields.unwrap_or_else(fn() { query_runtime_fields(&rows) })
        result :: sql_query.execute_sql_rows(&fields, rows.len(), &query, fn(index, field) {
            query_row_field(&rows[index], field).and_then(query_cell_sql_value)
        }).map_err(fn(error) { TypedDecode.decode_error("`data.query()`: {error}") })?
        type_name :: rows.iter().find_map(fn(row) { if row == { .Struct{type_name, ..} -> Val(type_name.clone()); else -> None } }).unwrap_or("SqlRow")
        return result.into_iter().map(fn(row) {
            CtValue.Struct{type_name: type_name.clone(), fields: row.fields.into_iter().map(fn(pair) { (pair.0, query_sql_value_ct(pair.1)) }).collect()}
        }).collect()
    }
    selected :: sql_query.select_sql_indices(rows.len(), &query, fn(index, field) { query_row_field(&rows[index], field).map(query_cell_text) })
    selected.into_iter().map(fn(index) { rows[index].clone() }).collect()
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:279
fn query_declared_fields(arg0_ty: Type?, call_ret: Type?, structs: &[String:&StructDef]) -> [String]? {
    elem_ty :: arg0_ty.and_then(data_schema_elem_ty).or_else(fn() {
        if call_ret? != .Result{ok, ..} -> return None
        data_schema_elem_ty(ok)
    })?
    struct_name :: elem_ty.base_name()?
    definition :: structs.get(struct_name)?
    Val(definition.fields.iter().map(fn(field) { field.name.clone() }).collect())
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:303
fn data_column(name: String, type_name: String) -> CtValue {
    id :: JetTableColumn.new(name, JetTableTypeId.new(type_name)).id.as_str().to_string()
    ct_struct("DataColumn", [("id", CtValue.Str(^id)), ("name", CtValue.Str(name)), ("type_name", CtValue.Str(type_name)), ("nullable", CtValue.Bool(type_name.ends_with('?')))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:321
fn data_loader_enum(type_name: String, variant: String) -> CtValue { CtValue.Enum{type_name: type_name, variant: variant, args: []} }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:329
fn data_loader_error_value(kind: String, operation: String, reason: String) -> CtValue {
    ct_struct("DataError", [("kind", data_loader_enum("DataErrorKind", kind)), ("operation", CtValue.Str(operation)), ("row", CtValue.absent(Type.Int)), ("column", CtValue.absent(Type.Int)), ("index", CtValue.absent(Type.Int)), ("reason", CtValue.Str(PreludeDataFlow.status_text(reason))), ("cause", CtValue.absent(Type.Named("EncodingError")))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:350
fn data_loader_failure(kind: String, operation: String, reason: String) -> CtValue { CtValue.failed(data_loader_error_value(kind, operation, reason)) }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:354
fn data_loader_kernel_failure(error: PreludeDataFlow.KernelError) -> CtValue {
    kind :: if error.kind == { .InvalidArgument -> "InvalidArgument"; .Limit -> "Limit"; .State -> "State"; .Bridge -> "Bridge" }
    data_loader_failure(kind, error.operation, ^error.reason)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:366
fn data_loader_bridge(operation: String) -> CtValue { data_loader_failure("Bridge", operation, "provider payload is missing; bind a canonical provider response") }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:374
fn data_snapshot_reusable_value(left: &CtValue, right: &CtValue) -> Bool? {
    if left == .Struct{type_name: left_type, ..} && right == .Struct{type_name: right_type, ..} {
        if left_type == "DataSnapshotIdentity" && right_type == "DataSnapshotIdentity" {
            return Val(["id", "source", "content", "schema", "format"].iter().all(fn(field) { struct_field(left, "DataSnapshotIdentity", field) == struct_field(right, "DataSnapshotIdentity", field) }))
        }
        if left_type != "DataLoader" || right_type != "DataSnapshot" -> return None
        provenance :: struct_field(right, "DataSnapshot", "provenance")?
        return Val(struct_field(&provenance, "DataProvenance", "source") == struct_field(left, "DataLoader", "source") && struct_field(&provenance, "DataProvenance", "authority") == struct_field(left, "DataLoader", "authority") && struct_field(&provenance, "DataProvenance", "format") == struct_field(left, "DataLoader", "format"))
    }
    None
}
