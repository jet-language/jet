}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:657
fn data_loader_format(format: String) -> String? {
    if format.to_ascii_lowercase() == { "csv" -> Val("csv"); "json" -> Val("json"); "jsonl" | "ndjson" -> Val("jsonl"); "parquet" -> Val("parquet"); "arrow" | "arrow-ipc" | "feather" -> Val("arrow"); else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:668
fn data_loader_format_for_locator(locator: String) -> String CtValue! {
    path :: locator.split(fn(character) { character == '?' || character == '#' }).next().unwrap_or(locator) // #4303
    path :: path.rsplit_once('/').map_or(path, fn(pair) { pair.1 }) // #4303
    extension :: path.rsplit_once('.').map(fn(pair) { pair.1 }) ?? return .Err(data_loader_failure("Bridge", "data.load", "source has no core format; import a provider package"))
    data_loader_format(extension).ok_or_else(fn() { data_loader_failure("Bridge", "data.load", "format `{extension}` is provider-owned; import its package") })
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:692
fn data_kernel_limits_safe() -> DataKernelLimits {
    DataKernelLimits{buffer_bytes: 65_536, max_depth: 256, max_item_bytes: 16_777_216, max_total_bytes: None, max_expansion_depth: 32, max_expansion_bytes: 8_388_608, max_groups: 100_000, max_sort_rows: 1_000_000, max_join_rows: 1_000_000, max_output_rows: 1_000_000}
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:707
fn data_int_field(value: CtValue?, fallback: I64) -> I64 { if value == { .Val(.Int(value)) -> value; else -> fallback } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:714
fn data_optional_int(value: CtValue?) -> I64? { if value == { .Val(.Int(value)) -> Val(value); .Val(.Present(.Int(value))) -> Val(value); else -> None } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:724
fn build_tracked(state: &DataPipelineState, rows: [CtValue], key: CtValue, call: QueryCallback, span: Span) -> CtValue Diagnostic! {
    max_rows :: USize.try_from(data_kernel_limits_safe().max_output_rows).unwrap_or(USize.MAX)
    if rows.len() > max_rows -> return .Err(unsupported("`data.track()` rows exceed max_output_rows", span))
    keyed := [(U64, CtValue)].with_capacity(rows.len())
    loop (order, row) in rows.into_iter().enumerate() {
        key_value :: call(&key, [row.clone()], span)?
        if keyed.iter().any(fn(pair) { pair.1 == key_value }) -> return .Err(unsupported("`data.track()` key callback returned a duplicate key", span))
        keyed.push((U64.try_from(order).unwrap_or(U64.MAX), ^row))
    }
    store_tracked(state, ^keyed, ^key, 0)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:753
fn invalidate_tracked_watches(state: &DataPipelineState, tracked_id: USize, cause: String) {
    affected :: state.watches.iter().enumerate().filter_map(fn(pair) {
        (index, watch) :: pair
        slot :: watch.as_ref()?
        if query_depends_on_tracked(state, &slot.query, tracked_id) -> Val(index) else -> None
    }).collect<[USize]>()
    loop index in affected {
        if state.watches[index].as_mut() == .Val(watch) { _ :: watch.lifecycle.invalidate(cause) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:770
fn query_depends_on_tracked(state: &DataPipelineState, query: &ComptimeQuery, tracked_id: USize) -> Bool {
    if query.tracked == Val(tracked_id) -> return true
    query.operations.iter().any(fn(operation) {
        if operation != .Join{right, ..} -> return false
        if struct_field(right, "Query", "slot") != .Val(.Int(id)) -> return false
        if USize.try_from(id) != .Ok(id) -> return false
        state.queries.get(id.saturating_sub(1)).and_then(fn(slot) { slot.as_ref() }).is_some_and(fn(right_query) { query_depends_on_tracked(state, right_query, tracked_id) })
    })
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:795
fn query_is_maintained(state: &DataPipelineState, query: &ComptimeQuery) -> Bool {
    query.tracked.is_some() || query.operations.iter().any(fn(operation) {
        if operation != .Join{right, ..} -> return false
        if struct_field(right, "Query", "slot") != .Val(.Int(id)) -> return false
        if USize.try_from(id) != .Ok(id) -> return false
        state.queries.get(id.saturating_sub(1)).and_then(fn(slot) { slot.as_ref() }).is_some_and(fn(right_query) { query_is_maintained(state, right_query) })
    })
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:815
fn bump_tracked_revision(tracked: &ComptimeTracked, span: Span) -> Unit Diagnostic! {
    tracked.revision = tracked.revision.checked_add(1) ?? return .Err(unsupported("`DataTracked` revision overflowed", span))
    tracked.changes.push(ComptimeTrackedChange{revision: tracked.revision})
    max_history :: USize.try_from(data_kernel_limits_safe().max_output_rows).unwrap_or(USize.MAX)
    if tracked.changes.len() > max_history { _ :: tracked.changes.drain(..(tracked.changes.len() - max_history)) }
}
