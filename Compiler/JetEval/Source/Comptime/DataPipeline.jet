// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:511
fn store_query_source(state: &DataPipelineState, rows: [CtValue], tracked: USize?, plan: [String]) -> CtValue {
    state.queries.push(Val(ComptimeQuery{rows: ^rows, tracked: tracked, operations: [], plan: ^plan}))
    ct_struct("Query", [("slot", CtValue.Int(I64.try_from(state.queries.len()).unwrap_or(I64.MAX)))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:532
fn store_tracked(state: &DataPipelineState, rows: [(U64, CtValue)], key: CtValue, revision: U64) -> CtValue {
    next_order :: rows.last().map(fn(pair) { pair.0.saturating_add(1) }).unwrap_or(0)
    state.tracked.push(Val(ComptimeTracked{rows: ^rows, key: ^key, next_order: next_order, revision: revision, changes: []}))
    ct_struct("DataTracked", [("slot", CtValue.Int(I64.try_from(state.tracked.len()).unwrap_or(I64.MAX)))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:558
fn tracked_id(state: &DataPipelineState, tracked: &CtValue, span: Span) -> USize Diagnostic! {
    id :: if struct_field(tracked, "DataTracked", "slot") == { .Val(.Int(id)) -> id; else -> return .Err(unsupported("`DataTracked` carrier has no state slot", span)) }
    if id <= 0 -> return .Err(unsupported("`DataTracked` state slot is invalid", span))
    id :: USize.try_from(id).map_err(fn(_) { unsupported("`DataTracked` state slot is invalid", span) })?
    if state.tracked.get(id - 1).and_then(fn(slot) { slot.as_ref() }).is_none() -> return .Err(unsupported("`DataTracked` state slot is stale", span))
    id
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:577
fn store_watch(state: &DataPipelineState, query: ComptimeQuery, entries: [CtValue], source_revision: U64, retained_rows: USize, mode: String) -> CtValue {
    // GATE #4494: lifecycle uses the real clock.
    state.watches.push(Val(ComptimeWatch{query: ^query, lifecycle: LiveLifecycle.JetLiveLifecycle.active_now(), source_revision: source_revision, retained_rows: retained_rows, entries: ^entries, mode: ^mode, recomputations: 0}))
    ct_struct("DataWatch", [("slot", CtValue.Int(I64.try_from(state.watches.len()).unwrap_or(I64.MAX)))])
}
