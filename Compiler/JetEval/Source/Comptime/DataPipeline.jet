// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:641
fn clone_query(state: &DataPipelineState, query: &CtValue, span: Span) -> ComptimeQuery Diagnostic! {
    id :: query_id(state, query, span)?
