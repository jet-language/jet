        .InlineRange(_, lo, _) -> CtValue.Int{value: lo}
        .Float | .Float32 -> CtValue.Float{value: CtFloat.f64(0.0)}
        .Bool -> CtValue.Bool{value: false}
        .String -> CtValue.Str{value: ""}
        .Char -> CtValue.Char{value: TEXT_NUL.chars()[0]}
        .List(_) | .FixedList(_, _) -> CtValue.List{values: [CtValue]{}}
        .Map(_, _, _) -> CtValue.Map{entries: [CtMapEntry]{}}
        .Option(inner) -> CtValue.absent(inner.clone())
        else -> CtValue.Unit
    }
