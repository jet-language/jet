pub fn value_type_name(value: &CtValue) -> String? {
    if value == { .Struct(name, _) | .Enum(name, _, _) -> Val(name) else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:276
fn key_to_string(key: &CtKey) -> String { if key == { .Str(value) -> value else -> key.to_value().jet_show() } }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:289
fn encode_ct_value(v: &CtValue, structs: &[String:StructDef]) -> CtValue {
    if v == {
        .Int(n) -> json_variant("Int", Val(CtValue.Int{value: n}))
        .BigInt(n) -> json_variant("Int", Val(CtValue.BigInt{value: n}))
        .Float(value) -> json_variant("Float", Val(CtValue.Float{value: CtFloat.f64(value.as_f64())}))
        .Bool(b) -> json_variant("Bool", Val(CtValue.Bool{value: b}))
        .Str(s) -> json_variant("Text", Val(CtValue.Str{value: s}))
        .Char(c) -> json_variant("Text", Val(CtValue.Str{value: c.to_string()}))
        .List(xs) -> {
            out := [CtValue]{}
            loop x in xs { out.push(encode_ct_value(&x, structs)) }
            json_variant("Array", Val(CtValue.List{values: ^out}))
        }
        .Present(inner) -> encode_ct_value(&inner, structs)
        .Failed(CtReport.Clean(_)) -> json_variant("Null", None)
        .Struct(type_name, fields) -> {
            sdef :: structs.get(type_name)
            style :: if sdef == { Val(s) -> container_rename_all(&s.serde_markers) None -> None }
            entries := [String:CtValue]{}
            loop field in fields {
                key := field.name
                if sdef == Val(s) { loop f in s.fields { if f.name == field.name { key = field_wire_key(style, &f); break } } }
                entries[key] = encode_ct_value(&field.value, structs)
            }
            keys := entries.keys().collect(); keys.sort()
            out := [CtMapEntry]{}
            loop key in keys { out.push(CtMapEntry{key: CtKey.Str{value: key}, value: entries[key]}) }
            json_variant("Object", Val(CtValue.Map{entries: ^out}))
        }
        .Enum(type_name, _, args) if type_name.starts_with("__JetUnion_") -> if args.is_empty() -> json_variant("Null", None) else -> encode_ct_value(&args[0].value, structs)
        else -> json_variant("Null", None)
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:347
fn typed_union_wire_shapes(ty: &Type, structs: &[String:StructDef], distinct_bases: &[String:Type]) -> [String] {
    shapes := if ty == {
        .Int | .IntN(_, _) | .InlineRange(_, _, _) -> [String]{"Int"}
        .Float | .Float32 -> [String]{"Float"}
        .Bool -> [String]{"Bool"}
        .String | .Char -> [String]{"Text"}
        .Named(name) if [String]{"Date", "LocalDate", "LocalTime", "DateTime"}.contains(name) -> [String]{"Text"}
        .Named(name) if name == "Duration" -> [String]{"Int"}
        .Named(name) if name == "Decimal" -> [String]{"Text"}
        .List(_) | .FixedList(_, _) -> [String]{"Array"}
        .Map(_, _, _) | .Tuple(_) -> [String]{"Object"}
        .Shared(inner) | .Quantity(inner, _) | .Tagged(_, inner) -> typed_union_wire_shapes(&inner, structs, distinct_bases)
        .Option(inner) -> { out := [String]{"Null"}; out.extend(typed_union_wire_shapes(&inner, structs, distinct_bases)); out }
        .Union(members) -> { out := [String]{}; loop member in members { out.extend(typed_union_wire_shapes(&member, structs, distinct_bases)) }; out }
        .Named(name) -> if distinct_bases.get(name) == { Val(base) -> typed_union_wire_shapes(&base, structs, distinct_bases) None -> if structs.contains_key(name) -> [String]{"Object"} else -> [String]{} }
        .Apply(name, _) -> if structs.contains_key(name) -> [String]{"Object"} else -> [String]{}
        .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Measure(_) -> [String]{}
    }
    shapes.sort(); shapes.dedup(); shapes
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:401
fn decode_int(tree: &CtValue) -> CtValue CtValue! { SyncLite.decode_int_ct(tree) }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:404
fn decode_float(tree: &CtValue) -> CtValue CtValue! {
    if variant_of(tree) == {
        Val(("Float", Val(CtValue.Float(value)))) -> Ok(CtValue.Float{value: CtFloat.f64(value.as_f64())})
        Val(("Int", Val(CtValue.Int(n)))) -> Ok(CtValue.Float{value: CtFloat.f64(n as F64)})
        Val(("Int", Val(CtValue.BigInt(value)))) -> {
            if value.parse<F64>() == Ok(n) && n.is_finite() -> Ok(CtValue.Float{value: CtFloat.f64(n)})
            else -> Err(decode_error("expected Float, found out-of-range Int"))
        }
        Val(("Number", Val(CtValue.Str(text)))) | Val(("Text", Val(CtValue.Str(text)))) -> {
            trimmed := text.trim() // #4303
            value :: trimmed.parse<F64>().map_err(fn(_) -> decode_error("expected Float, found text {text.debug()}"))?
            if value.is_finite() -> Ok(CtValue.Float{value: CtFloat.f64(value)}) else -> Err(decode_error("expected Float, found out-of-range Float"))
        }
        Val(("TypedText", Val(CtValue.Str(text)))) -> Err(decode_error("expected Float, found text {text.debug()}"))
        else -> Err(decode_error("expected Float, found {datatree_kind_for(tree)}"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:438
fn decode_bool(tree: &CtValue) -> CtValue CtValue! {
    if variant_of(tree) == {
        Val(("Bool", Val(CtValue.Bool(b)))) -> Ok(CtValue.Bool{value: b})
        Val(("TypedText", Val(CtValue.Str(text)))) -> Err(decode_error("expected Bool, found text {text.debug()}"))
        Val(("Text", Val(CtValue.Str(text)))) -> {
            trimmed := text.trim() // #4303
            if trimmed == { "true" -> Ok(CtValue.Bool{value: true}) "false" -> Ok(CtValue.Bool{value: false}) else -> Err(decode_error("expected Bool, found text {text.debug()}")) }
        }
        else -> Err(decode_error("expected Bool, found {datatree_kind_for(tree)}"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:459
fn decode_string(tree: &CtValue) -> CtValue CtValue! {
    if variant_of(tree) == {
        Val(("Text", Val(CtValue.Str(text)))) | Val(("TypedText", Val(CtValue.Str(text)))) -> Ok(CtValue.Str{value: text})
        Val(("Number", Val(CtValue.Str(text)))) -> Err(decode_error("expected Text, found number {text}"))
        Val(("Int", Val(CtValue.Int(n)))) -> Ok(CtValue.Str{value: n.to_string()})
        Val(("Int", Val(CtValue.BigInt(n)))) -> Ok(CtValue.Str{value: n})
        Val(("Float", Val(CtValue.Float(f)))) -> Ok(CtValue.Str{value: f.debug()})
        Val(("Bool", Val(CtValue.Bool(b)))) -> Ok(CtValue.Str{value: b.to_string()})
        else -> Err(decode_error("expected Text, found {datatree_kind_for(tree)}"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:476
fn decode_char(tree: &CtValue) -> CtValue CtValue! {
    s :: if decode_string(tree)? == { .Str(s) -> s else -> panic("decode_string must return Str") }
    chars := s.chars().iter()
    first :: chars.next()
    if (first, chars.next()) == { (Val(c), None) -> Ok(CtValue.Char{value: c}) else -> Err(decode_error("expected a single Char, found {s.debug()}")) }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:490
fn decode_int_n(tree: &CtValue, signed: Bool, bits: Int, name: String) -> CtValue CtValue! { SyncLite.decode_int_n_ct(tree, signed, bits, name) }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:494
fn decode_f32(tree: &CtValue) -> CtValue CtValue! {
    value :: if variant_of(tree) == {
        Val(("Float", Val(CtValue.Float(value)))) -> value.as_f64()
        Val(("Int", Val(CtValue.Int(value)))) -> value as F64
        Val(("Number", Val(CtValue.Str(text)))) | Val(("Text", Val(CtValue.Str(text)))) -> {
            trimmed := text.trim() // #4303
            trimmed.parse<F64>().map_err(fn(_) -> decode_error("expected F32, found text {text.debug()}"))?
        }
        Val(("TypedText", Val(CtValue.Str(text)))) -> return Err(decode_error("expected F32, found text {text.debug()}"))
        else -> return Err(decode_error("expected F32, found {datatree_kind_for(tree)}"))
    }
    if value.is_finite() && value >= -(F32.MAX as F64) && value <= F32.MAX as F64 -> Ok(CtValue.Float{value: CtFloat.f32(value as F32)})
    else -> Err(decode_error("expected F32, found out-of-range Float"))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:520
fn decode_decimal(tree: &CtValue) -> CtValue CtValue! {
    parsed :: if variant_of(tree) == {
        Val(("Number", Val(CtValue.Str(text)))) -> CtDecimal.from_json_number(text)
        Val(("TypedText", Val(CtValue.Str(text)))) -> return Err(decode_error("expected Decimal, found text {text.debug()}"))
        Val(("Text", Val(CtValue.Str(text)))) -> CtDecimal.from_str(text)
        Val(("Int", Val(CtValue.Int(value)))) -> CtDecimal.from_str(value.to_string())
        else -> return Err(decode_error("expected Decimal, found {datatree_kind_for(tree)}"))
    }
    parsed.map(fn(value) -> value.to_value()).map_err(fn(error) -> decode_error("expected Decimal: {error}"))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:549
pub fn builtin_codec_kind(name: String) -> Int? {
    if name == { "Date" -> Val(0) "LocalDate" -> Val(1) "LocalTime" -> Val(2) "DateTime" -> Val(3) "Duration" -> Val(4) "Decimal" -> Val(5) else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:561
fn codec_field(value: &CtValue, expected: &[String], field: String) -> CtValue Err! {
    if value == .Struct(type_name, fields) {
        if !expected.contains(type_name) -> return Err("expected {expected.join(" or ")}, found {type_name}")
        loop f in fields { if f.name == field -> return Ok(f.value) }
        return Err("missing {type_name}.{field}")
    }
    Err("expected {expected.join(" or ")}, found non-struct value")
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:578
fn codec_int_field(value: &CtValue, expected: &[String], field: String) -> Int Err! {
    if codec_field(value, expected, field)? == {
        .Int(value) -> Ok(value)
        .BigInt(value) -> CtBigInt.from_str(value)?.try_i64().ok_or("{field} is outside the I64 range")
        else -> Err("{field} is not an Int")
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:595
pub fn encode_builtin_codec(kind: Int, value: &CtValue) -> CtValue Err! {
    text :: if kind == {
        0 | 1 -> codec_rt.jet_codec_date_encode(codec_int_field(value, &[String]{"Date", "LocalDate"}, "year")?, codec_int_field(value, &[String]{"Date", "LocalDate"}, "month")?, codec_int_field(value, &[String]{"Date", "LocalDate"}, "day")?)
        2 -> codec_rt.jet_codec_local_time_encode(codec_int_field(value, &[String]{"LocalTime"}, "hour")?, codec_int_field(value, &[String]{"LocalTime"}, "minute")?, codec_int_field(value, &[String]{"LocalTime"}, "second")?)
        3 -> {
            secs :: codec_int_field(value, &[String]{"DateTime"}, "secs")?
            nanos :: codec_int_field(value, &[String]{"DateTime"}, "nanos")?
            if nanos < 0 || nanos > U32.MAX as Int -> return Err("DateTime.nanos is outside the U32 range")
            leap :: if codec_field(value, &[String]{"DateTime"}, "leap_second")? == { .Bool(value) -> value else -> return Err("DateTime.leap_second is not a Bool") }
            codec_rt.jet_codec_datetime_encode(secs, nanos as U32, leap)
        }
        4 -> return Ok(json_variant("Int", Val(CtValue.Int{value: codec_rt.jet_codec_duration_encode(codec_int_field(value, &[String]{"Duration"}, "ns")?)})))
        5 -> {
            decimal :: CtDecimal.from_value(value)?
            return Ok(json_variant("Text", Val(CtValue.Str{value: codec_rt.jet_codec_decimal_encode(&decimal)})))
        }
        else -> return Err("unknown builtin codec kind {kind}")
    }
    Ok(json_variant("Text", Val(CtValue.Str{value: text})))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:636
fn decode_date(tree: &CtValue, type_name: String) -> CtValue CtValue! {
    value :: if decode_string(tree)? == { .Str(value) -> value else -> panic("decode_string must return Str") }
    codec_rt.jet_codec_date_decode(value).map(fn((year, month, day)) -> CtValue.Struct{type_name: type_name, fields: [NamedCtValue]{
        NamedCtValue{name: "year", value: CtValue.Int{value: year}}, NamedCtValue{name: "month", value: CtValue.Int{value: month}}, NamedCtValue{name: "day", value: CtValue.Int{value: day}}
    }}).map_err(fn(error) -> decode_error("expected Date: {error}"))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:652
fn decode_local_time(tree: &CtValue) -> CtValue CtValue! {
    value :: if decode_string(tree)? == { .Str(value) -> value else -> panic("decode_string must return Str") }
    codec_rt.jet_codec_local_time_decode(value).map(fn((hour, minute, second)) -> CtValue.Struct{type_name: "LocalTime", fields: [NamedCtValue]{
        NamedCtValue{name: "hour", value: CtValue.Int{value: hour}}, NamedCtValue{name: "minute", value: CtValue.Int{value: minute}}, NamedCtValue{name: "second", value: CtValue.Int{value: second}},
        NamedCtValue{name: "millisecond", value: CtValue.Int{value: 0}}, NamedCtValue{name: "microsecond", value: CtValue.Int{value: 0}}, NamedCtValue{name: "nanosecond", value: CtValue.Int{value: 0}}
    }}).map_err(fn(error) -> decode_error("expected LocalTime: {error}"))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:671
fn decode_datetime(tree: &CtValue) -> CtValue CtValue! {
