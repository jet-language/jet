// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:49
pub fn decode_error(reason: String) -> CtValue { decode_error_at("", reason) }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:53
pub fn decode_error_at(path: String, reason: String) -> CtValue {
    CtValue.List{values: [CtValue]{CtValue.Struct{type_name: "FieldError", fields: [NamedCtValue]{
        NamedCtValue{name: "path", value: CtValue.Str{value: path}},
        NamedCtValue{name: "reason", value: CtValue.Str{value: reason}}
    }}}}
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:63
fn extend_decode_errors(errors: &[CtValue], error: CtValue) -> {
    if error == {
        .List(items) -> &errors.extend(^items)
        else -> if decode_error(error.jet_show()) == { .List(items) -> &errors.extend(^items) else -> {} }
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:79
pub fn decode_error_under(seg: String, e: CtValue) -> CtValue {
    if e == {
        .List(errors) -> {
            out := [CtValue]{}
            loop error in errors {
                if error == {
                    .Struct(_, fields) -> {
                        fields := ^fields
                        loop field in &fields {
                            if field.name == "path" && field.value == .Str(path) {
                                field.value = CtValue.Str{value: field_error_prelude.jet_field_error_kernel_under(seg, path)}
                                break
                            }
                        }
                        out.push(CtValue.Struct{type_name: "FieldError", fields: ^fields})
                    }
                    else -> out.push(^error)
                }
            }
            CtValue.List{values: ^out}
        }
        else -> decode_error(e.jet_show())
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:107
fn serde_marker(markers: &[Marker], name: String) -> Marker? {
    loop m in markers { if m.name == name -> return Val(m) }
    None
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:110
fn serde_has(markers: &[Marker], name: String) -> Bool { serde_marker(markers, name).is_some() }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:113
fn apply_rename_all(style: String, name: String) -> String {
    if style == {
        RENAME_ALL_CAMEL -> to_camel_acronym(name)
        RENAME_ALL_PASCAL -> to_pascal_acronym(name)
        RENAME_ALL_KEBAB -> to_snake_acronym(name).replace('_', "-")
        RENAME_ALL_SCREAMING -> to_shouty_acronym(name)
        else -> to_snake_acronym(name)
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:122
fn container_rename_all(markers: &[Marker]) -> String? {
    m :: serde_marker(markers, MARKER_RENAME_ALL) ?? return None
    if m.expr_arg(0) == { Val(Expr.Ident(n, _)) -> Val(n) else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:128
fn marker_str_arg(m: &Marker) -> String? {
    if m.expr_arg(0) == {
        Val(Expr.Str(parts, _)) if parts.len() == 1 -> if parts[0] == { .Lit(s) -> Val(s) else -> None }
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:137
fn field_wire_key(style: String?, f: &Field) -> String {
    if serde_marker(&f.serde_markers, MARKER_RENAME) == Val(m) {
        if marker_str_arg(&m) == Val(s) -> return s
    }
    if style == { Val(st) -> apply_rename_all(st, f.name) None -> f.name }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:150
fn migration_wire_key(style: String?, s: &StructDef, name: String) -> String {
    loop f in s.fields { if f.name == name -> return field_wire_key(style, &f) }
    if style == { Val(st) -> apply_rename_all(st, name) None -> name }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:162
fn variant_of(tree: &CtValue) -> (String, CtValue?)? {
    if tree == {
        .Enum(type_name, variant, args) if type_name == "DataTree" -> Val((variant, if args.is_empty() -> None else -> Val(args[0].value)))
        .Bytes(_) -> Val(("Bytes", Val(tree)))
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:173
fn datatree_kind_for(tree: &CtValue) -> String {
    tag :: if variant_of(tree) == { Val((tag, _)) -> tag None -> "value" }
    datatree_kind_rt.datatree_kind(tag)
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:177
fn object_pairs(tree: &CtValue) -> [NamedCtValue]? {
    if json_payload(tree, "Object") == {
        Val(CtValue.Struct(type_name, fields)) if type_name == "JSONObject" -> Val(fields.clone())
        Val(CtValue.Map(entries)) -> {
            out := [NamedCtValue]{}
            loop entry in entries {
                name :: if entry.key == { .Str(s) -> s else -> entry.key.debug() }
                out.push(NamedCtValue{name: name, value: entry.value.clone()})
            }
            Val(^out)
        }
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:198
fn object_get(tree: &CtValue, key: String) -> CtValue? {
    if json_payload(tree, "Object") == {
        Val(CtValue.Struct(type_name, fields)) if type_name == "JSONObject" -> {
            loop field in fields { if field.name == key -> return Val(field.value) }
            None
        }
        Val(CtValue.Map(entries)) -> {
            // Canonical CtMapEntry storage retains the Rust BTreeMap ordering.
            // GATE #4499: CtKey equality/order must be the canonical user-key policy.
            if entries.binary_search_by(fn(entry) -> entry.key.cmp(CtKey.Str{value: key})) == {
                Ok(index) -> Val(entries[index].value)
                Err(_) -> None
            }
        }
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:208
fn rebuild_object(pairs: [NamedCtValue]) -> CtValue {
    json_variant("Object", Val(CtValue.Struct{type_name: "JSONObject", fields: ^pairs}))
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:217
fn object_key_set(tree: &CtValue) -> [String:Bool] {
    out := [String:Bool]{}
    if object_pairs(tree) == Val(pairs) { loop pair in pairs { out[pair.name] = true } }
    out
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:222
fn text_cell(cell: String) -> CtValue { json_variant("Text", Val(CtValue.Str{value: cell})) }
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:226
fn typed_csv_values(interp: &Interp, rows: [CsvRecord], ty: &Type, span: Span) -> ([String], [CtValue]) CtValue! {
    if rows.is_empty() -> return Ok(([String]{}, [CtValue]{}))
    fields :: rows[0].fields
    values := [CtValue]{}
    errors := [CtValue]{}
    loop i in 1..rows.len() {
        cells := [String:CtValue]{}
        loop c in 0..fields.len() { cells[fields[c]] = text_cell(rows[i].fields.get(c) ?? "") }
        keys := cells.keys().collect(); keys.sort()
        entries := [CtMapEntry]{}
        loop key in keys { entries.push(CtMapEntry{key: CtKey.Str{value: key}, value: cells[key]}) }
        tree :: json_variant("Object", Val(CtValue.Map{entries: ^entries}))
        if interp.typed_decode_top(ty, &tree, span) == {
            Ok(value) -> values.push(^value)
            Err(error) -> extend_decode_errors(&errors, decode_error_under("row {i}", ^error))
        }
    }
    if errors.is_empty() -> Ok((fields, ^values)) else -> Err(CtValue.List{values: ^errors})
}
