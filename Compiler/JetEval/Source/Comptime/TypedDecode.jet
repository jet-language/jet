// PORT-PENDING 0604 crates-jet-comptime-src-comptime-typeddecode: crates/jet-comptime/src/Comptime/TypedDecode.rs:1-1798
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Card #392 pass 5: typed `Decode` dispatch at comptime — the machinery
//RS //! behind `json.decode<T>` (and the csv/toml/yaml
//RS //! siblings, plus `core.data.csv<T>`'s row decode). Mirrors AOT's derived
//RS //! `__jet_Decode::jet_decode` field-by-field walk from the shared typed codec
//RS //! item bodies and migration-chain walker
//RS //! and `Sema::SchemaMigration`'s `#PublishedSchema` migration chain
//RS //! byte-for-byte (R12 parity) — including error message text (E2410/E2412)
//RS //! and the canonical `[FieldError]` value defined by `jet_std`.
//RS //! parity: guard tests/corelib.rs::typed_codec_decode_matches_between_full_build_and_quick_run
//RS //!
//RS //! Operates directly on the canonical `DataTree`-tagged `CtValue` tree that
//RS //! `JSONInterp`/`EncodingLite` build for every codec (json/csv/toml/yaml) — its
//RS //! variant tags (`Null`/`Bool`/`Int`/`Float`/`Text`/`Array`/`Object`) are
//RS //! exactly AOT's `DataTree` shape, so no separate value type is needed at this
//RS //! tier.
//RS 
//RS use std::collections::{BTreeSet, HashMap};
//RS 
//RS use crate::Diagnostics::{Diagnostic, Span};
//RS use crate::AST::{CtFloat, CtKey, Field, Marker, MigrationDecl, MigrationOp, StructDef, Type};
//RS 
//RS use super::Diagnostics::unsupported;
//RS use super::Interpreter::Interp;
//RS use super::JSONInterp::{json_payload, json_variant};
//RS use crate::AST::{CtReport, CtValue};
//RS 
