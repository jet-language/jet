    fn typed_decode_top(&self, ty: &Type, tree: &CtValue, span: Span) -> CtValue CtValue! {
        if self.typed_decode_value(ty, tree, span) == {
            Ok(v) -> Ok(v)
            Err(e) -> {
                name :: if ty == { .Named(name) -> name else -> return Err(e) }
                sdef :: self.structs.get(name) ?? return Err(e)
                published := sdef.is_published_schema
                loop derive in sdef.derives { if derive.0 == MARKER_PUBLISHED_SCHEMA { published = true; break } }
                if !published || !sdef.type_params.is_empty() -> return Err(e)
                blocks :: self.migrations.get(name) ?? return Err(e)
                if blocks.is_empty() -> return Err(e)
                style :: container_rename_all(&sdef.serde_markers)
                shapes :: self.migration_shapes(style, &sdef, &blocks)
                keys :: object_key_set(tree)
                loop j in (0..shapes.len()).rev() {
                    shape :: shapes[j]
                    matches :: if shape.is_empty() -> keys.is_empty() else -> shape.len() == keys.len() && shape.iter().all(fn(k) -> keys.contains_key(k))
                    if !matches -> continue
                    pairs := object_pairs(tree) ?? return Err(e)
                    loop i in j..shapes.len() { self.apply_migration_step(&sdef, style, &blocks[i], &pairs, span)? }
                    new_tree :: rebuild_object(^pairs)
                    return self.typed_decode_value(ty, &new_tree, span)
                }
                Err(e)
            }
        }
    }
    // Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:1658
    fn eval_typed_decode(&self, module: String, text: String, ty: &Type, span: Span) -> CtValue Diagnostic! {
        if module == "core.encoding.csv" -> return self.eval_typed_csv_decode(text, ty, span)
        parsed :: if module == {
            "core.encoding.json" -> JSONInterp.parse_json_typed_ordered(text).map_err(fn(e) -> json_parse_err_to_decode("JSON", JSONInterp.encoding_error_value(e)))
            "core.encoding.toml" -> EncodingLite.toml_parse(text).map_err(fn(e) -> json_parse_err_to_decode("TOML", ^e))
            "core.encoding.yaml" -> EncodingLite.yaml_parse(text).map_err(fn(e) -> json_parse_err_to_decode("YAML", ^e))
            "core.encoding.xml" -> if EncodingLite.xml_parse(text) == { Ok(document) -> EncodingLite.xml_project_for_decode(&document) Err(e) -> Err(EncodingLite.xml_error_value(e)) }
            else -> return Err(unsupported("`{module}.decode()`", span))
        }
        tree :: if parsed == { Ok(t) -> t Err(e) -> return Ok(CtValue.failed(^e)) }
        Ok(if self.typed_decode_top(ty, &tree, span) == { Ok(value) -> CtValue.Present{value: ^value} Err(e) -> CtValue.failed(^e) })
    }
    // Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:1701
    fn eval_typed_csv_decode(&self, text: String, ty: &Type, span: Span) -> CtValue Diagnostic! {
        rows :: if EncodingLite.csv_parse(text, ",", false, false) == { Ok(rows) -> rows Err(error) -> return Ok(CtValue.failed(decode_error(error))) }
        (_, values) :: if typed_csv_values(self, ^rows, ty, span) == { Ok(result) -> result Err(error) -> return Ok(CtValue.failed(^error)) }
        Ok(CtValue.Present{value: CtValue.List{values: ^values}})
    }
    // Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:1720
    fn eval_typed_csv_query(&self, text: String, sql: String, ty: &Type, span: Span) -> CtValue Diagnostic! {
        rows :: if EncodingLite.csv_parse(text, ",", false, false) == { Ok(rows) -> rows Err(error) -> return Ok(CtValue.failed(decode_error(error))) }
        fields :: if rows.is_empty() -> [String]{} else -> rows[0].fields
        query :: if sql_query.parse_sql_query(sql) == { Ok(query) -> query Err(error) -> return Ok(CtValue.failed(decode_error("`core.encoding.csv.query()`: {error}"))) }
        if sql_query.validate_sql_query_schema(&query, fn(field) -> fields.iter().any(fn(known) -> known == field), "`core.encoding.csv.query()`") == Err(error) -> return Ok(CtValue.failed(decode_error(error)))
        (_, values) :: if typed_csv_values(self, ^rows, ty, span) == { Ok(result) -> result Err(error) -> return Ok(CtValue.failed(^error)) }
        selected :: sql_query.select_sql_indices(values.len(), &query, fn(index, field) -> DataPipeline.query_row_field(&values[index], field).map(DataPipeline.query_cell_text))
        out := [CtValue]{}
        loop index in selected { out.push(values[index].clone()) }
        Ok(CtValue.Present{value: CtValue.List{values: ^out}})
    }
}
// Rust: crates/jet-comptime/src/Comptime/TypedDecode.rs:1769
pub fn json_parse_err_to_decode(codec: String, e: CtValue) -> CtValue {
    line := 0
    message := ""
    if e == .Struct(_, fields) {
        loop field in fields {
            if field.name == "line" {
                line = if field.value == { .Int(n) -> n .Present(CtValue.Int(n)) -> n else -> 0 }
                break
            }
        }
        loop field in fields { if field.name == "reason" { message = if field.value == { .Str(s) -> s else -> "" }; break } }
    }
    decode_error("invalid {codec} (line {line}): {message}")
}
