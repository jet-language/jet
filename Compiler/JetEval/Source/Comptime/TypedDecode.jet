    fn apply_migration_step(&self, s: &StructDef, style: String?, block: &MigrationDecl, pairs: &[NamedCtValue], span: Span) -> Unit CtValue! {
        loop op in block.ops {
            if op == {
                .Rename(from, _, to, _) -> {
                    from_key :: migration_wire_key(style, s, from)
                    to_key :: migration_wire_key(style, s, to)
                    loop p in &pairs { if p.name == from_key -> p.name = to_key }
                }
                .Remove(field, _) -> { key :: migration_wire_key(style, s, field); pairs.retain(fn(p) -> p.name != key) }
                .Add(field, _, _, _, _, _, default_fn) -> {
                    key :: migration_wire_key(style, s, field)
                    fn_name :: default_fn ?? return Err(decode_error("migration `add {field}` has no lowered default function"))
                    func :: self.funcs.get(fn_name) ?? return Err(decode_error("migration `add {field}`'s default function `{fn_name}` isn't registered"))
                    value :: self.call_func(fn_name, func, [String:CtValue]{}).map_err(fn(d) -> decode_error(d.what))?
                    pairs.push(NamedCtValue{name: key, value: encode_ct_value(&value, self.structs)})
                }
                .Change{field, from_ty, conv_fn, ..} -> {
                    key :: migration_wire_key(style, s, field)
                    fn_name :: conv_fn ?? return Err(decode_error("migration `change {field}` has no lowered converter function"))
                    func :: self.funcs.get(fn_name) ?? return Err(decode_error("migration `change {field}`'s converter function `{fn_name}` isn't registered"))
                    pos :: pairs.iter().position(fn(p) -> p.name == key) ?? return Err(decode_error("E2410: missing required field `{field}`"))
                    old_value :: self.typed_decode_value(&from_ty, &pairs[pos].value, span).map_err(fn(e) -> decode_error_under(key, ^e))?
                    frame := [String:CtValue]{}
                    if func.params.first() == Val(param) -> frame[param.name] = ^old_value
                    new_value :: self.call_func(fn_name, func, ^frame).map_err(fn(d) -> decode_error(d.what))?
                    pairs[pos].value = encode_ct_value(&new_value, self.structs)
                }
            }
        }
        Ok(())
    }
