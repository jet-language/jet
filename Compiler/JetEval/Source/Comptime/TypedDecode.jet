//RS /// Encode the closed scalar/container subset used by the MIR typed codec
//RS /// route without a checked nominal callback.
//RS pub(super) fn encode_typed_builtin_value(
//RS     ty: &Type,
//RS     value: &CtValue,
//RS ) -> Option<Result<CtValue, String>> {
//RS     encode_typed_value_with(ty, value, &mut |_, _| Ok(None))
//RS }
//RS 
//RS /// A reasonable zero value for a type with no `#[Default(expr)]` argument —
//RS /// mirrors what `Default::default()` would build for AOT's Rust field type.
//RS fn zero_value(ty: &Type) -> CtValue {
//RS     match ty {
//RS         Type::Int | Type::IntN { .. } => CtValue::Int(0),
//RS         Type::InlineRange { lo, .. } => CtValue::Int(*lo),
//RS         Type::Float | Type::Float32 => CtValue::Float(CtFloat::f64(0.0)),
//RS         Type::Bool => CtValue::Bool(false),
//RS         Type::String => CtValue::Str(String::new()),
//RS         Type::Char => CtValue::Char('\0'),
//RS         Type::List(_) | Type::FixedList { .. } => CtValue::List(Vec::new()),
//RS         Type::Map { .. } => CtValue::Map(std::collections::BTreeMap::new()),
//RS         Type::Option(inner) => CtValue::absent((**inner).clone()),
//RS         _ => CtValue::Unit,
//RS     }
//RS }
//RS 
//RS impl<'a> Interp<'a> {
//RS     /// Run the ordinary `Encode` method for a value when one is registered,
//RS     /// then fall back to the scalar/container representation used by the
//RS     /// typed tree walker. This is the interpreter-side marshalling adapter:
//RS     /// codec policy remains in the Jet method body, just as it does for AOT.
//RS     pub(super) fn encode_value(
//RS         &mut self,
//RS         value: &CtValue,
//RS         span: Span,
//RS     ) -> Result<CtValue, Diagnostic> {
//RS         if let Some(type_name) = value_type_name(value) {
//RS             let codec_key = format!("{type_name}::encode");
//RS             if let Some(func) = self.funcs.get(&codec_key).copied().or_else(|| {
//RS                 self.methods
//RS                     .get(&(type_name.clone(), "encode".to_string()))
//RS                     .copied()
