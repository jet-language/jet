// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:642
fn mailer_handle(value: &CtValue) -> USize? {
    value == {
        Struct { type_name, fields } if type_name == "Mailer" -> fields.iter().find_map(fn(entry) {
            (entry.0, entry.1) == { ("handle", Int(v)) if v > 0 -> Val(v as USize - 1); _ -> None }
        })
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:656
// GATE #4494: process-lifetime OnceLock and poisoned-mutex recovery need native synchronization.
const MAILERS: OnceLock<Mutex<[jet_email.Mailer?]>> = OnceLock.new()
fn ambient_mailers() -> &Mutex<[jet_email.Mailer?]> { MAILERS.get_or_init(fn() { Mutex.new([]) }) }
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:662
fn store_mailer(mailer: jet_email.Mailer) -> CtValue {
    mailers := ambient_mailers().lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    mailers.push(Val(^mailer))
    mailer_value(mailers.len() - 1)
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:670
fn address_value_owned(address: jet_email.Address) -> CtValue {
    display := address.display == { Val(v) -> CtValue.Present(Box.new(CtValue.Str(^v))); None -> CtValue.absent(Type.String) }
    structure("Address", [("display", ^display), ("mailbox", CtValue.Str(^address.mailbox))])
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:686
fn recipient_report_value(report: jet_email.RecipientReport) -> CtValue {
    structure("RecipientReport", [("address", address_value_owned(^report.address)), ("accepted", CtValue.Bool(report.accepted)),
        ("code", CtValue.Int(report.code)), ("message", CtValue.Str(^report.message))])
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:704
fn send_report_value(report: jet_email.SendReport) -> CtValue {
    structure("SendReport", [("server", CtValue.Str(^report.server)),
        ("accepted", CtValue.List(report.accepted.into_iter().map(recipient_report_value).collect())),
        ("rejected", CtValue.List(report.rejected.into_iter().map(recipient_report_value).collect())),
        ("response_code", CtValue.Int(report.response_code)), ("response", CtValue.Str(^report.response)), ("accepted_at", CtValue.Str(^report.accepted_at))])
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:732
pub fn ambient_core_call(method: &String, args: &[CtValue], span: Span, runtime: RuntimeFns) -> (CtValue Diagnostic!)? {
    if pure := evaluate(method, args, span) { return Val(^pure) }
    try {
        output := method == {
            "smtp" -> {
                config := args.first() == { Val(v) -> smtp_config_from_value(v, span)?; None -> { fail unsupported("email.smtp(): missing config", span) } }
                email_runtime := kernel_runtime(runtime)
                smtp_result := jet_email.smtp(&config, copy_secret, email_runtime)
                jet_email.wipe_config_secrets(&config, email_runtime)
                result(^smtp_result, store_mailer)
            }
            "smtp_from_env" if args.is_empty() -> result(jet_email.smtp_from_env(kernel_runtime(runtime)), store_mailer)
            _ -> { return None }
        }
        Val(Ok(^output))
    } catch(error) { Val(Err(^error)) }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:764
pub fn ambient_handle(op: &String, recv: &CtValue, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    method := op.strip_prefix("EmailMethod:")?
    if method != "send" { return evaluate_method(recv, method, args, span) }
    try {
        index := mailer_handle(recv) == { Val(i) -> i; None -> { fail unsupported("email Mailer receiver", span) } }
        message := args.first() == { Val(v) -> message_from_value(v, span)?; None -> { fail unsupported("email Mailer.send(): missing message", span) } }
        mailers := ambient_mailers().lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        mailer := mailers.get_mut(index).map(fn(slot) { slot.take() }) == {
            Val(Val(mailer)) -> mailer; _ -> { fail unsupported("email Mailer handle", span) }
        }
        send_result := mailer.send(^message)
        mailers[index] = Val(^mailer)
        Val(Ok(result(^send_result, send_report_value)))
    } catch(error) { Val(Err(^error)) }
}
