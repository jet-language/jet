    username := enum_arg(args, "username") == { Val(v) -> string(v, span)?.to_string(); None -> { fail unsupported("email SMTPAuth.username is missing", span) } }
    password := enum_arg(args, "password") == { Val(v) -> secret(v, span)?; None -> { fail unsupported("email SMTPAuth.password is missing", span) } }
    jet_email.SMTPAuth.Password { username: ^username, password: ^password }
}
