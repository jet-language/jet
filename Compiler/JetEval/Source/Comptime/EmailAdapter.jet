// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:580
fn smtp_config_from_value(value: &CtValue, span: Span) -> jet_email.SMTPConfig<[U8]> Diagnostic! {
    host := field(value, "SMTPConfig", "host") == { Val(v) -> string(v, span)?.to_string(); None -> { fail unsupported("email SMTPConfig.host is missing", span) } }
    port := field(value, "SMTPConfig", "port") == { Val(v) -> int(v, "SMTPConfig.port", span)?; None -> { fail unsupported("email SMTPConfig.port is missing", span) } }
    security := field(value, "SMTPConfig", "security") == {
        Val(v) if enum_args(v, "SMTPSecurity", "StartTLS").is_some() -> jet_email.SMTPSecurity.StartTLS
        Val(v) if enum_args(v, "SMTPSecurity", "TLS").is_some() -> jet_email.SMTPSecurity.TLS
        _ -> { fail unsupported("email SMTPConfig.security is invalid", span) }
    }
    auth := field(value, "SMTPConfig", "auth") == { Val(v) -> auth_from_value(v, span)?; None -> { fail unsupported("email SMTPConfig.auth is missing", span) } }
    recipient_policy := field(value, "SMTPConfig", "recipient_policy") == {
        Val(v) if enum_args(v, "RecipientPolicy", "RequireAll").is_some() -> jet_email.RecipientPolicy.RequireAll
        Val(v) if enum_args(v, "RecipientPolicy", "DeliverAccepted").is_some() -> jet_email.RecipientPolicy.DeliverAccepted
        _ -> { fail unsupported("email SMTPConfig.recipient_policy is invalid", span) }
    }
    trust := field(value, "SMTPConfig", "trust") == { Val(v) -> trust_from_value(v, span)?; None -> { fail unsupported("email SMTPConfig.trust is missing", span) } }
    limits := field(value, "SMTPConfig", "limits") == { Val(v) -> limits_from_value(v, span)?; None -> { fail unsupported("email SMTPConfig.limits is missing", span) } }
    maybe_dkim := field(value, "SMTPConfig", "dkim") == { Val(v) -> optional(v, span, fn(v) { dkim_from_value(v, span) })?; None -> { fail unsupported("email SMTPConfig.dkim is missing", span) } }
    dkim := maybe_dkim == { Val(v) -> Ok(^v); None -> Err(JetAbsent) }
    jet_email.SMTPConfig { host: ^host, port: port, security: security, auth: ^auth, recipient_policy: recipient_policy, trust: ^trust, limits: limits, dkim: ^dkim }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:638
