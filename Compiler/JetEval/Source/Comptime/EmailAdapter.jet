    domain := field(value, "DKIMConfig", "domain") == { Val(v) -> string(v, span)?.to_string(); None -> { fail unsupported("email DKIMConfig.domain is missing", span) } }
    selector := field(value, "DKIMConfig", "selector") == { Val(v) -> string(v, span)?.to_string(); None -> { fail unsupported("email DKIMConfig.selector is missing", span) } }
    private_key := field(value, "DKIMConfig", "private_key") == { Val(v) -> secret(v, span)?; None -> { fail unsupported("email DKIMConfig.private_key is missing", span) } }
    signed_headers := field(value, "DKIMConfig", "signed_headers") == { Val(v) -> string_list(v, span)?; None -> { fail unsupported("email DKIMConfig.signed_headers is missing", span) } }
    jet_email.DkimConfig { domain: ^domain, selector: ^selector, private_key: ^private_key, signed_headers: ^signed_headers }
