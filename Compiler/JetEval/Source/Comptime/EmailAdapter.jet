fn bytes(value: &CtValue, span: Span) -> [U8] Diagnostic! {
    value == {
        Bytes(data) -> data.clone()
        List(values) -> {
            data: [U8] = []
            for value in values {
                value == { Int(v) if v >= 0 && v <= 255 -> data.push(v as U8); _ -> { fail unsupported("email bytes must be a [U8] value", span) } }
            }
            data
        }
        _ -> { fail unsupported("email bytes must be a [U8] value", span) }
    }
}
