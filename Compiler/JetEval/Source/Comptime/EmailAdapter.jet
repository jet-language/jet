// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:62
pub fn evaluate(method: &String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    try {
        value := method == {
            "address" -> email_address(args, span)?
            "attachment" -> email_attachment(args, span)?
            "message" -> email_message(args, span)?
            "envelope" -> email_envelope(args, span)?
            "serialize" -> email_serialize(args, span)?
            _ -> { return None }
        }
        Val(Ok(^value))
    } catch(error) { Val(Err(^error)) }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:74
pub fn evaluate_method(recv: &CtValue, method: &String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    try {
        value := method == {
            "envelope" if args.is_empty() -> { message := message_from_value(recv, span)?; envelope_value(message.envelope()) }
            "with_envelope" if args.len() == 1 -> {
                message := message_from_value(recv, span)?
                envelope := envelope_from_value(&args[0], span)?
                result(message.with_envelope(&envelope), fn(value) { message_value(&value) })
            }
            "send" -> { return None }
            _ -> { return None }
        }
        Val(Ok(^value))
    } catch(error) { Val(Err(^error)) }
}
