// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:299
fn message_from_value(value: &CtValue, span: Span) -> jet_email.Message Diagnostic! {
    from := field(value, "Message", "from") == { Val(v) -> address_from_value(v, span)?; None -> { fail unsupported("email Message sender is missing", span) } }
    list := fn(name) -> [jet_email.Address] Diagnostic! {
        field(value, "Message", name) == { Val(v) -> address_list(v, span)?; None -> { fail unsupported("email Message address list is missing", span) } }
    }
    text := fn(name) -> String Diagnostic! {
        field(value, "Message", name) == { Val(Str(v)) -> v.clone(); _ -> { fail unsupported("email Message text field is invalid", span) } }
    }
    attachments := field(value, "Message", "attachments") == { Val(v) -> attachment_list(v, span)?; None -> { fail unsupported("email Message attachments are missing", span) } }
    to := list("to")?; bcc := list("bcc")?
    subject := text("subject")?; plain := text("text")?; html := text("html")?
    message := try { jet_email.message(&from, &to, &bcc, &subject, &plain, &html, &attachments)? }
        catch(error) { fail unsupported("email Message is invalid: {jet_email.error_reason(&error)}", span) }
    field(value, "Message", "envelope") == {
        Val(v) -> {
            envelope := envelope_from_value(v, span)?
            try { message.with_envelope(&envelope)? }
            catch(error) { fail unsupported("email Message envelope is invalid: {jet_email.error_reason(&error)}", span) }
        }
        None -> message
    }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:352
fn error_value(error: jet_email.Error) -> CtValue {
    (variant, disc, operation, server, code, reason) := jet_email.error_parts(^error)
    server_value := server == { Val(v) -> CtValue.Present(Box.new(CtValue.Str(^v))); None -> CtValue.absent(Type.String) }
    code_value := code == { Val(v) -> CtValue.Present(Box.new(CtValue.Int(v))); None -> CtValue.absent(Type.Int) }
    CtValue.Enum { type_name: "EmailError", variant: variant.to_string(), args: [
        (Val("operation"), CtValue.Str(^operation)), (Val("server"), ^server_value),
        (Val("code"), ^code_value), (Val("reason"), CtValue.Str(^reason))] }
}
// Rust: crates/jet-comptime/src/Comptime/EmailAdapter.rs:376
fn result<T>(value: T jet_email.Error!, map: fn(T) -> CtValue) -> CtValue {
    value == { Ok(v) -> CtValue.Present(Box.new(map(^v))); Err(e) -> CtValue.failed(Box.new(error_value(^e))) }
}
