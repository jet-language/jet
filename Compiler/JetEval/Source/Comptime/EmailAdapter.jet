fn message_value(message: &jet_email.Message) -> CtValue {
    structure("Message", [("from", address_value(&message.from)),
        ("to", CtValue.List(message.to.iter().map(address_value).collect())),
        ("bcc", CtValue.List(message.bcc.iter().map(address_value).collect())),
        ("subject", CtValue.Str(message.subject.clone())), ("text", CtValue.Str(message.text.clone())), ("html", CtValue.Str(message.html.clone())),
        ("attachments", CtValue.List(message.attachments.iter().map(attachment_value).collect())),
