use jet_foundation.[CtValue, CtFloat, NamedCtValue, Type, Span, Diagnostic]
use jet_comptime.Interpreter.[Interp]
use jet_comptime.Builtins.[as_bool, cmp]
use jet_comptime.Methods.[as_string, eval_data_pivot_sum]
use jet_comptime.Comptime.DataPipeline.[DataPipelineState, ComptimeQuery, ComptimeQueryOperation, SchemaRow, data_schema_elem_ty, schema_columns_for_type, data_column, ct_value_type_name, data_kernel_limits_safe, clone_query, ct_struct, tracked_id, tracked_insert, tracked_replace, tracked_remove, watch_id, watch_refresh, query_source_revision, query_join_right_type, query_is_maintained, query_retained_rows, store_watch, store_query, struct_field, plot_static_call, expect_list, query_sql_rows, query_declared_fields, data_join_right_type, build_tracked]

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5496
pub fn schema_value(recv: &CtValue, arg0_ty: Type?, row: SchemaRow, span: Span) -> CtValue Diagnostic! {
    sample :: if recv == { .List(xs) -> if xs.is_empty() -> None else -> Val(xs[0]) else -> fail unsupported("`data.schema()` needs an ordinary typed list", span) }
    columns := None
    if arg0_ty == { Val(ty) -> if data_schema_elem_ty(&ty) == { Val(elem) -> columns = schema_columns_for_type(&elem, true, row) else -> {} } else -> {} }
    if columns == { Val(values) -> return CtValue.List{values: values} else -> {} }
    out := [CtValue]{}
    if sample == {
        Val(.Struct(_, fields)) -> loop field in fields { out.push(data_column(field.name, ct_value_type_name(&field.value))) }
        Val(value) -> out.push(data_column("value", ct_value_type_name(&value)))
        else -> {}
    }
    CtValue.List{values: ^out}
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5528
fn add_query_values(left: &CtValue, right: CtValue, span: Span) -> Unit Diagnostic! {
    if (left, right) == {
        (.Int(a), .Int(b)) -> { total :: a.checked_add(b) ?? fail unsupported("`Query.sum()` integer overflow", span); left = CtValue.Int{value: total} }
        (.Float(a), .Float(b)) -> left = CtValue.Float{value: CtFloat.f64(a.as_f64() + b.as_f64())}
        (.Float(a), .Int(b)) -> left = CtValue.Float{value: CtFloat.f64(a.as_f64() + Float{b})}
        (.Int(_), .Float(_)) -> fail unsupported("`Query.sum()` cannot mix Int and Float values", span)
        else -> fail unsupported("`Query.sum()` callback must return numeric values", span)
    }
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5562
// Shared mutable invocation seam: both evaluators use these same semantics.
type QueryCallback = &fn(&CtValue, [CtValue], Span) -> CtValue Diagnostic!

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5565
fn collect_query_rows(state: &DataPipelineState, query: &ComptimeQuery, call: QueryCallback, span: Span) -> [CtValue] Diagnostic! {
    limits :: data_kernel_limits_safe()
    // GATE #4483: conversions saturate at selected-target usize::MAX.
    max_sort_rows :: USize.try_from(limits.max_sort_rows) ?? USize.MAX
    max_join_rows :: USize.try_from(limits.max_join_rows) ?? USize.MAX
    max_output_rows :: USize.try_from(limits.max_output_rows) ?? USize.MAX
    rows := [CtValue]{}
    if query.tracked == {
        Val(id) -> {
            if id >= state.tracked.len() -> fail unsupported("`DataTracked` state slot is stale", span)
            slot :: state.tracked[id] ?? fail unsupported("`DataTracked` state slot is stale", span)
            loop (_, row) in slot.rows { rows.push(row.clone()) }
        }
        None -> rows = query.rows.clone()
    }
    loop operation in query.operations {
        if operation == {
            .Filter(predicate) -> {
                filtered := [CtValue]{}
                loop row in rows { value :: call(&predicate, [CtValue]{row.clone()}, span)!; if as_bool(&value, span)! -> filtered.push(^row) }
                rows = ^filtered
            }
            .SortBy(key) -> {
                if rows.len() > max_sort_rows -> fail unsupported("`Query.sort_by()` input exceeds max_sort_rows", span)
                keyed := [(String, CtValue)]{}
                loop row in rows { value :: call(&key, [CtValue]{row.clone()}, span)!; text := as_string(&value, span)!.to_string(); keyed.push((text, ^row)) }
                keyed.sort_by(fn(left: (String, CtValue), right: (String, CtValue)) -> Ordering Never! { left.0.compare(right.0) })
                rows = [CtValue]{}
                loop (_, row) in keyed { rows.push(^row) }
            }
            .Map(mapper) -> {
                mapped := [CtValue]{}
                loop row in rows { mapped.push(call(&mapper, [CtValue]{^row}, span)!) }
                rows = ^mapped
            }
            .Extreme(key, maximum) -> {
                selected := None
                loop row in rows {
                    value :: call(&key, [CtValue]{^row}, span)!
                    if value == { .Float(number) -> if !number.as_f64().is_finite() -> fail unsupported("`Query.min()`/`Query.max()` key must be finite", span) else -> {} }
                    replace :: if selected == {
                        None -> true
                        Val((best, _)) -> { order :: cmp(value.clone(), best.clone(), span)!; if maximum -> order == Ordering.Greater else -> order == Ordering.Less }
                    }
                    // Rust retains the callback value, not its source row.
                    if replace -> selected = Val((value.clone(), value))
                }
                if selected == {
                    Val((_, value)) -> rows = [CtValue]{value}
                    None -> fail unsupported(if maximum -> "`Query.max()` cannot reduce an empty query" else -> "`Query.min()` cannot reduce an empty query", span)
                }
            }
            .Join(right, left_key, right_key, left, right_type) -> {
                right_query :: clone_query(state, &right, span)!
                right_rows :: collect_query_rows(state, &right_query, call, span)!
                if right_rows.len() > max_join_rows -> fail unsupported("`Query.join()` input exceeds max_join_rows", span)
                rows = collect_join_rows(&rows, &right_rows, &left_key, &right_key, left, Val(right_type.clone()), call, span)!
            }
        }
    }
    if rows.len() > max_output_rows -> fail unsupported("`Query.collect()` output exceeds max_output_rows", span)
    ^rows
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5698
fn collect_join_rows(left_rows: &[CtValue], right_rows: &[CtValue], left_key: &CtValue, right_key: &CtValue, left_join: Bool, right_type: Type?, call: QueryCallback, span: Span) -> [CtValue] Diagnostic! {
    right_by_key := [String:[CtValue]]{}
    loop row in right_rows {
        value :: call(right_key, [CtValue]{row.clone()}, span)!
        key := as_string(&value, span)!.to_string()
        right_by_key.entry(key).or_insert([CtValue]{}).push(row.clone())
    }
    joined := [CtValue]{}
    loop left_row in left_rows {
        value :: call(left_key, [CtValue]{left_row.clone()}, span)!
        key := as_string(&value, span)!.to_string()
        if right_by_key.get(key) == {
            Val(matches) -> loop right_row in matches {
                joined.push(ct_struct("DataJoin", [(String, CtValue)]{("left", left_row.clone()), ("right", if left_join -> CtValue.Present{value: right_row.clone()} else -> right_row.clone())}))
            }
            None -> if left_join {
                ty :: right_type ?? fail unsupported("`data.left_join()` needs a resolved right row type", span)
                joined.push(ct_struct("DataJoin", [(String, CtValue)]{("left", left_row.clone()), ("right", CtValue.absent(ty))}))
            }
        }
    }
    ^joined
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5760
fn store_query_with_operations(state: &DataPipelineState, query: ComptimeQuery) -> CtValue Never! {
    state.queries.push(Val(^query))
    ct_struct("Query", [(String, CtValue)]{("slot", CtValue.Int{value: Int.try_from(state.queries.len()) ?? Int.MAX})})
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5775
pub fn eval_data_query_method_with(state: &DataPipelineState, recv: &CtValue, method: String, args: &[CtValue], resolved_ret: Type?, call: QueryCallback, span: Span) -> (CtValue Diagnostic!)? {
    type_name :: if recv == { .Struct(name, _) -> name else -> return None }
    // Keep unknown dispatch None, but stale recognized receiver errors claimed.
    try {
        if type_name == "DataTracked" {
            tracked :: tracked_id(state, recv, span)!
            if method == {
                "query" -> {
                    if !args.is_empty() -> fail unsupported("`DataTracked.query()` takes no arguments", span)
                    slot :: state.tracked[tracked - 1] ?? fail unsupported("`DataTracked` state slot is stale", span)
                    rows := [CtValue]{}; loop (_, row) in slot.rows { rows.push(row.clone()) }
                    query :: ComptimeQuery{rows: ^rows, tracked: Val(tracked - 1), operations: [ComptimeQueryOperation]{}, plan: [String]{"track"}}
                    return Val(Ok(store_query_with_operations(state, query)))
                }
                "insert" -> {
                    if args.len() != 1 -> fail unsupported("`DataTracked.insert()` needs one row", span)
                    tracked_insert(state, recv, args[0].clone(), call, span)!
                    return Val(Ok(CtValue.Present{value: CtValue.Unit}))
                }
                "replace" -> {
                    if args.len() != 2 -> fail unsupported("`DataTracked.replace()` needs a key and row", span)
                    tracked_replace(state, recv, args[0].clone(), args[1].clone(), call, span)!
                    return Val(Ok(CtValue.Present{value: CtValue.Unit}))
                }
                "remove" -> {
                    if args.len() != 1 -> fail unsupported("`DataTracked.remove()` needs one key", span)
                    tracked_remove(state, recv, args[0].clone(), call, span)!
                    return Val(Ok(CtValue.Present{value: CtValue.Unit}))
                }
                else -> return None
            }
        }
        if type_name == "DataWatch" {
            watch :: watch_id(state, recv, span)!
            if method == {
                "get" -> {
                    if !args.is_empty() -> fail unsupported("`DataWatch.get()` takes no arguments", span)
                    rows :: watch_refresh(state, recv, call, span)!
                    return Val(Ok(CtValue.Present{value: CtValue.List{values: rows}}))
                }
                "status" -> {
                    if !args.is_empty() -> fail unsupported("`DataWatch.status()` takes no arguments", span)
                    slot :: state.watches[watch - 1] ?? fail unsupported("`DataWatch` state slot is stale", span)
                    revision :: query_source_revision(state, &slot.query, span)!
                    return Val(Ok(ct_struct("DataWatchStatus", [(String, CtValue)]{
                        ("mode", CtValue.Str{value: slot.mode.clone()}),
                        ("revision", CtValue.Int{value: Int.try_from(revision) ?? Int.MAX}),
                        ("retained_rows", CtValue.Int{value: Int.try_from(slot.retained_rows) ?? Int.MAX}),
                        ("recomputations", CtValue.Int{value: Int.try_from(slot.recomputations) ?? Int.MAX}),
                        ("active", CtValue.Bool{value: slot.lifecycle.active}),
                        ("generation", CtValue.Int{value: Int.try_from(slot.lifecycle.generation) ?? Int.MAX}),
                        ("dirty", CtValue.Bool{value: slot.lifecycle.dirty}),
                        ("error", CtValue.Str{value: slot.lifecycle.error.clone()}),
                        ("freshness_ms", CtValue.Int{value: Int.try_from(slot.lifecycle.freshness_ms()) ?? Int.MAX}),
                        ("invalidation_cause", CtValue.Str{value: slot.lifecycle.invalidation_cause.clone()}),
                        ("refreshing", CtValue.Bool{value: slot.lifecycle.refreshing}),
                        ("cancelled", CtValue.Bool{value: slot.lifecycle.cancelled})
                    })))
                }
                "cancel" -> {
                    if !args.is_empty() -> fail unsupported("`DataWatch.cancel()` takes no arguments", span)
                    slot := &state.watches[watch - 1] ?? fail unsupported("`DataWatch` state slot is stale", span)
                    slot.lifecycle.cancel()
                    return Val(Ok(CtValue.Unit))
                }
                else -> return None
            }
        }
        if type_name == "Query" {
            query := clone_query(state, recv, span)!
            if method == {
                "filter" | "sort_by" | "map" | "min" | "max" -> {
                    if args.len() != 1 -> fail unsupported("`Query.{method}()` needs one callback", span)
                    operation :: if method == {
                        "filter" -> ComptimeQueryOperation.Filter{predicate: args[0].clone()}
                        "sort_by" -> ComptimeQueryOperation.SortBy{key: args[0].clone()}
                        "map" -> ComptimeQueryOperation.Map{mapper: args[0].clone()}
                        else -> ComptimeQueryOperation.Extreme{key: args[0].clone(), maximum: method == "max"}
                    }
                    query.operations.push(operation); query.plan.push(method)
                    return Val(Ok(store_query_with_operations(state, ^query)))
                }
                "inner_join" | "left_join" -> {
                    if args.len() != 3 -> fail unsupported("`Query.{method}()` needs a query and two callbacks", span)
                    right_query :: clone_query(state, &args[0], span)!
                    right_type :: query_join_right_type(resolved_ret) ?? (if right_query.rows.is_empty() -> Type.Int else -> right_query.rows[0].jet_type())
                    query.operations.push(ComptimeQueryOperation.Join{right: args[0].clone(), left_key: args[1].clone(), right_key: args[2].clone(), left: method == "left_join", right_type: right_type})
                    query.plan.push(method)
                    return Val(Ok(store_query_with_operations(state, ^query)))
                }
                "watch" -> {
                    if !args.is_empty() -> fail unsupported("`Query.watch()` takes no arguments", span)
                    if !query_is_maintained(state, &query) -> fail unsupported("E2476: `Query.watch()` requires a maintained `data.track()` source", span)
                    entries :: collect_query_rows(state, &query, call, span)!
                    if entries.len() > USize{data_kernel_limits_safe().max_output_rows} -> fail unsupported("`DataWatch` output exceeds max_output_rows", span)
                    source_revision :: query_source_revision(state, &query, span)!
                    retained_rows :: query_retained_rows(state, &query, span)!
                    mode :: if query.plan.is_empty() -> "tracked" else -> query.plan[query.plan.len() - 1].clone()
                    return Val(Ok(CtValue.Present{value: store_watch(state, ^query, entries, source_revision, retained_rows, mode)}))
                }
                "collect" -> {
                    if !args.is_empty() -> fail unsupported("`Query.collect()` takes no arguments", span)
                    rows :: collect_query_rows(state, &query, call, span)!
                    return Val(Ok(CtValue.Present{value: CtValue.List{values: rows}}))
                }
                "plan" -> {
                    if !args.is_empty() -> fail unsupported("`Query.plan()` takes no arguments", span)
                    values := [CtValue]{}; loop item in query.plan { values.push(CtValue.Str{value: ^item}) }
                    return Val(Ok(CtValue.List{values: ^values}))
                }
                "group_by" -> {
                    if args.len() != 1 -> fail unsupported("`Query.group_by()` needs one callback", span)
                    return Val(Ok(ct_struct("DataGroupedQuery", [(String, CtValue)]{("query", recv.clone()), ("key", args[0].clone())})))
                }
                else -> return None
            }
        }
        if type_name != "DataGroupedQuery" -> return None
        source :: struct_field(recv, "DataGroupedQuery", "query") ?? fail unsupported("`DataGroupedQuery` has no query source", span)
        grouped_query :: clone_query(state, source, span)!
        key :: (struct_field(recv, "DataGroupedQuery", "key") ?? fail unsupported("`DataGroupedQuery` has no key callback", span)).clone()
        plan := grouped_query.plan.clone(); plan.push("group_by"); plan.push(method)
        if method == "count" {
            if !args.is_empty() -> fail unsupported("`DataGroupedQuery.count()` takes no arguments", span)
            rows :: collect_query_rows(state, &grouped_query, call, span)!
            groups := [(CtValue, Int)]{}
            loop row in rows {
                group_key :: call(&key, [CtValue]{^row}, span)!
                index := None
                loop i in 0..<groups.len() { if groups[i].0 == group_key { index = Val(i); break } }
                if index == { Val(i) -> groups[i].1 += 1 None -> groups.push((group_key, 1)) }
            }
            result := [CtValue]{}
            loop (group_key, count) in groups { result.push(ct_struct("Group", [(String, CtValue)]{("key", group_key), ("value", CtValue.Int{value: count})})) }
            return Val(Ok(store_query(state, ^result, ^plan)))
        }
        if (method != "sum" && method != "mean") || args.len() != 1 -> return None
        value :: args[0].clone()
        rows :: collect_query_rows(state, &grouped_query, call, span)!
        groups := [(CtValue, CtValue, Int)]{}
        loop row in rows {
            group_key :: call(&key, [CtValue]{row.clone()}, span)!
            group_value :: call(&value, [CtValue]{^row}, span)!
            index := None
            loop i in 0..<groups.len() { if groups[i].0 == group_key { index = Val(i); break } }
            if index == {
                Val(i) -> {
                    if method == "mean" {
                        if (groups[i].1, group_value) == {
                            (.Float(total), .Float(next)) -> groups[i].1 = CtValue.Float{value: CtFloat.f64(total.as_f64() + next.as_f64())}
                            else -> fail unsupported("`Query.mean()` callback must return Float", span)
                        }
                    } else { add_query_values(&groups[i].1, group_value, span)! }
                    groups[i].2 += 1
                }
                None -> {
                    if method == "mean" && !(if group_value == { .Float(_) -> true else -> false }) -> fail unsupported("`Query.mean()` callback must return Float", span)
                    groups.push((group_key, group_value, 1))
                }
            }
        }
        result := [CtValue]{}
        loop (group_key, total, count) in groups {
            value := total
            if method == "mean" { if value == { .Float(n) -> value = CtValue.Float{value: CtFloat.f64(n.as_f64() / Float{count})} else -> {} } }
            result.push(ct_struct("Group", [(String, CtValue)]{("key", group_key), ("value", ^value)}))
        }
        Val(Ok(store_query(state, ^result, ^plan)))
    } catch(error) { Val(Err(error)) }
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:6179
pub fn eval_data_query_method(self: &Interp, recv: &CtValue, method: String, args: &[CtValue], resolved_ret: Type?, span: Span) -> (CtValue Diagnostic!)? {
    state := self.data_pipeline.take()
    result :: eval_data_query_method_with(&state, recv, method, args, resolved_ret, &fn(callback: &CtValue, callback_args: [CtValue], span: Span) -> CtValue Diagnostic! { self.call_closure(callback, callback_args, span) }, span)
    self.data_pipeline = ^state
    result
}

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:6205
pub fn eval_data_call(self: &Interp, method: String, argv: [CtValue], type_args: &[Type], arg0_ty: Type?, call_ret: Type?, span: Span) -> CtValue Diagnostic! {
    if method == {
        "plot" | "inspect" | "inspect_json" | "text" | "svg" | "show" | "render" -> plot_static_call(&self.data_pipeline, method, &argv, arg0_ty, self.structs, span)
        "track" -> {
            if argv.len() != 2 -> fail unsupported("`data.track()` expects rows and one key callback", span)
            rows :: expect_list(&argv[0], "track", span)!.clone(); key :: argv[1].clone()
            state := self.data_pipeline.take()
            result :: (fn() -> CtValue Diagnostic! {
                tracked :: build_tracked(&state, rows, key, &fn(callback: &CtValue, callback_args: [CtValue], span: Span) -> CtValue Diagnostic! { self.call_closure(callback, callback_args, span) }, span)!
                CtValue.Present{value: tracked}
            })()
            // Restore allocated slots even when callbacks return diagnostics.
            self.data_pipeline = ^state
            result!
        }
        "query" -> {
            if argv.is_empty() -> fail unsupported("`data.query()`: missing rows", span)
            rows :: expect_list(&argv[0], "query", span)!.clone()
            if argv.len() == 1 -> return store_query(&self.data_pipeline, rows, [String]{"scan"})
            sql :: if argv[1] == { .Str(text) -> text else -> fail unsupported("`data.query()`: expected SQL text as argument 1", span) }
            selected :: query_sql_rows(rows, sql, query_declared_fields(arg0_ty, call_ret, self.structs)) catch error -> return CtValue.failed(error)
            CtValue.Present{value: store_query(&self.data_pipeline, selected, [String]{"scan", "sql"})}
        }
        "csv" | "json" -> {
            if type_args.is_empty() -> fail unsupported("`data.{method}<T>()` needs a type argument", span)
            if argv.is_empty() -> fail unsupported("`data.{method}()`: expected a string argument", span)
            text :: if argv[0] == { .Str(s) -> s.clone() else -> fail unsupported("`data.{method}()`: expected a string argument", span) }
            if method == "csv" -> self.eval_typed_csv_decode(text, &type_args[0], span) else -> self.eval_typed_decode("core.encoding.json", text, &Type.List{inner: type_args[0].clone()}, span)
        }
        "count" -> {
            if argv.is_empty() -> fail unsupported("`data.count()`: missing argument", span)
            CtValue.Int{value: expect_list(&argv[0], "count", span)!.len()}
        }
        "schema" -> {
            if argv.is_empty() -> fail unsupported("`data.schema()`: missing argument", span)
            structs :: self.structs
            row :: &fn(name: String) -> ([String], [(String, Type)])? {
                def :: structs.get(name) ?? return None
                params := [String]{}; fields := [(String, Type)]{}
                loop param in def.type_params { params.push(param.name.clone()) }
                loop field in def.fields { fields.push((field.name.clone(), field.ty.clone())) }
                Val((^params, ^fields))
            }
            schema_value(&argv[0], arg0_ty, row, span)
        }
        "pivot_sum" -> eval_data_pivot_sum(&argv, span, fn(callback: &CtValue, args: [CtValue], span: Span) -> CtValue Diagnostic! { self.call_closure(callback, args, span) })
        "inner_join" | "left_join" -> {
            values := argv
            right_key :: values.pop().unwrap(); left_key :: values.pop().unwrap()
            right :: expect_list(&values[1], method, span)!.clone(); left :: expect_list(&values[0], method, span)!.clone()
            right_type :: data_join_right_type(call_ret)
            call := fn(callback: &CtValue, args: [CtValue], span: Span) -> CtValue Diagnostic! { self.call_closure(callback, args, span) }
            CtValue.List{values: collect_join_rows(&left, &right, &left_key, &right_key, method == "left_join", right_type, &call, span)!}
        }
        else -> fail unsupported("`data.{method}()`", span)
    }
}
