// Comptime/REPL marshalling reuses the canonical shared Complex value.
use jet_codegen.Prelude.CoreLib.Top.MathLibPure.JetComplex
use jet_foundation.AST.[CtFloat, CtValue]
use jet_foundation.Syntax.TYPE_COMPLEX

// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:9
pub fn part(value: &CtValue) -> F64? {
    value == { Int(v) -> Val(v as F64); Float(v) -> Val(v.as_f64()); _ -> None }
}
// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:17
pub fn from_parts(real: F64, imaginary: F64) -> CtValue {
    v := JetComplex.from_parts(real, imaginary)
    CtValue.Struct { type_name: TYPE_COMPLEX.to_string(), fields: [
        ("real", CtValue.Float(CtFloat.f64(v.real))), ("imaginary", CtValue.Float(CtFloat.f64(v.imaginary)))] }
}
// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:31
fn value(input: &CtValue) -> JetComplex? {
    input == {
        Struct { type_name, fields } -> {
            if type_name != TYPE_COMPLEX { return None }
            field := fn(wanted) { fields.iter().find(fn(entry) { entry.0 == wanted }).and_then(fn(entry) { part(&entry.1) }) }
            Val(JetComplex.from_parts(field("real")?, field("imaginary")?))
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:50
pub fn binary(method: &String, left: &CtValue, right: &CtValue) -> CtValue? {
    a := value(left)?
    b := value(right)?
    result := method == { "add" -> a.add(&b); "sub" -> a.sub(&b); "mul" -> a.mul(&b); "div" -> a.div(&b); _ -> { return None } }
    Val(from_parts(result.real, result.imaginary))
}
// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:63
pub fn abs(input: &CtValue) -> F64? { Val(value(input)?.abs()) }
// Rust: crates/jet-comptime/src/Comptime/ComplexParity.rs:67
pub fn to_string(input: &CtValue) -> String? { Val(value(input)?.to_string_rep()) }
