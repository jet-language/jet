use jet_foundation.AST.[CtReport, CtValue]
use jet_foundation.Diagnostics.[Diagnostic, Span]

// Rust: crates/jet-comptime/src/Comptime/Template.rs:8
#Derive(Clone)
pub struct TemplateBody<E> { pub items: [TemplateItem<E>], pub span: Span }
// Rust: crates/jet-comptime/src/Comptime/Template.rs:15
#Derive(Clone)
pub enum TemplateItem<E> {
    Item(TemplateSource<E>)
    Statement(TemplateStatement<E>)
    Loop { var: String, source: E, body: [TemplateItem<E>], span: Span }
    If { condition: E, then_body: [TemplateItem<E>], else_body: [TemplateItem<E>], selected: Bool?, span: Span }
    Invalid { construct: String, span: Span }
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:40
#Derive(Clone)
pub enum TemplateStatement<E> {
    Binding { name: String, value: E, span: Span }
    Expr { value: E, span: Span }
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:54
#Derive(Clone)
pub struct TemplateSource<E> { pub source: String, pub holes: [TemplateHole<E>], pub span: Span }
// Rust: crates/jet-comptime/src/Comptime/Template.rs:62
#Derive(Clone)
pub struct TemplateHole<E> { pub start: USize, pub end: USize, pub expr: E, pub kind: TemplateHoleKind, pub span: Span }
// Rust: crates/jet-comptime/src/Comptime/Template.rs:72
#Derive(Clone, Copy, Eq)
pub enum TemplateHoleKind { Value; Name }
// Rust: crates/jet-comptime/src/Comptime/Template.rs:83
pub fn format_tir_template_body<E>(body: &TemplateBody<E>, scope: &[String:CtValue], eval: fn(&E, &[String:CtValue]) -> CtValue Diagnostic!) -> String Diagnostic! {
    template_scope := scope.clone()
    render_items(&body.items, &template_scope, &eval)
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:95
fn render_items<E>(items: &[TemplateItem<E>], scope: &[String:CtValue], eval: &fn(&E, &[String:CtValue]) -> CtValue Diagnostic!) -> String Diagnostic! {
    rendered: [String] = []
    for item in items {
        item == {
            Item(source) -> rendered.push(render_source(source, scope, eval)?)
            Invalid { construct, span } -> { return Err(template_error(construct, "checked template source must remain attached to its source span", "report the malformed generated template to the compiler", span)) }
            Statement(statement) -> statement == {
                Binding { name, value, .. } -> { value := eval(value, scope)?; scope.insert(name.clone(), value.clone()); scope.insert("${name}", value) }
                Expr { value, .. } -> { _ :: eval(value, scope)? }
            }
            Loop { var, source, body, span } -> {
                values := eval(source, scope)? == {
                    CtValue.List(values) -> values
                    _ -> { return Err(template_error("a `prep loop` source is not a compile-time list", "`prep loop` expands one item template for each value in its source list", "use a reflected/comptime list or a closed type list", span)) }
                }
                marked_var := "${var}"; previous := scope.get(var).cloned(); previous_marked := scope.get(&marked_var).cloned()
                for value in values {
                    scope.insert(var.clone(), value.clone()); scope.insert(marked_var.clone(), value)
                    expansion := render_items(body, scope, eval)?
                    if !expansion.is_empty() { rendered.push(expansion) }
                }
                restore_scope(scope, var, previous); restore_scope(scope, &marked_var, previous_marked)
            }
            If { condition, then_body, else_body, selected, span } -> {
                selected := selected == {
                    Val(selected) -> selected
                    None -> eval(condition, scope)? == {
                        CtValue.Bool(selected) -> selected
                        _ -> { return Err(template_error("a template condition is not Bool", "compile-time template control requires a checked boolean expression", "use a Bool-valued condition", span)) }
                    }
                }
                chosen := if selected { then_body } else { else_body }
                expansion := render_items(chosen, scope, eval)?
                if !expansion.is_empty() { rendered.push(expansion) }
            }
        }
    }
    Ok(rendered.join("\n"))
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:187
fn restore_scope(scope: &[String:CtValue], name: &String, previous: CtValue?) {
    if previous == Val(previous) { scope.insert(name.to_string(), previous) } else { _ :: scope.remove(name) }
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:195
fn render_source<E>(source: &TemplateSource<E>, scope: &[String:CtValue], eval: &fn(&E, &[String:CtValue]) -> CtValue Diagnostic!) -> String Diagnostic! {
    holes := source.holes.iter().collect()
    holes.sort_by_key(fn(hole) { hole.start })
    rendered := String.with_capacity(source.source.len()); cursor: USize = 0
    for hole in holes {
        if hole.start < cursor || hole.end < hole.start || hole.end > source.source.len() || !source.source.is_char_boundary(hole.start) || !source.source.is_char_boundary(hole.end) {
            return Err(template_error("template splice range is invalid", "checked template spans must remain byte-aligned with their static source", "report the malformed generated template to the compiler", hole.span))
        }
        rendered.push_str(&source.source[cursor..hole.start])
        value := eval(&hole.expr, scope)?
        replacement := hole.kind == { Value -> template_value_source(&value, hole.span)?; Name -> template_name_source(&value, hole.span)? }
        rendered.push_str(&replacement); cursor = hole.end
    }
    rendered.push_str(&source.source[cursor..])
    Ok(rendered)
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:234
fn template_name_source(value: &CtValue, span: Span) -> String Diagnostic! {
    value == {
        Str(name) if !name.is_empty() -> Ok(name.clone())
        Struct { fields, .. } -> {
            for (field, value) in fields {
                if field == "name" { if value == CtValue.Str(name) { if !name.is_empty() { return Ok(name.clone()) } } }
            }
            Err(template_error("a generated item name needs text", "item and type splices use the reflected name fact", "bind the name to a non-empty String value", span))
        }
        _ -> Err(template_error("a generated item name needs text", "item and type splices use a String value", "bind the name to a String value", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:260
fn template_value_source(value: &CtValue, span: Span) -> String Diagnostic! {
    value == {
        Bool(value) -> Ok(value.to_string())
        Int(value) -> Ok(value.to_string())
        Float(value) -> Ok(value.render())
        Char(value) -> Ok("{value:Debug}")
        Str(value) -> Ok("{value:Debug}")
        BigInt(value) -> Ok(value.to_string_rep())
        Enum { type_name, variant, args } if args.is_empty() -> Ok(if type_name.is_empty() { variant.clone() } else { "{type_name}.{variant}" })
        Present(value) -> Ok("value({template_value_source(value, span)?})")
        Failed(CtReport.Clean(_)) -> Ok("null")
        _ -> Err(template_error("a template value has no source literal", "dynamic template values must be representable Jet literals", "convert the value to Bool, Int, Float, Char, String, or a closed enum", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Template.rs:290
fn template_error(message: &String, detail: &String, hint: &String, span: Span) -> Diagnostic { Diagnostic.error("E0956", message.to_string(), detail.to_string(), hint.to_string(), Val(span)) }
