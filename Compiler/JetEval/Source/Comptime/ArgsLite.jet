// Interpreter core.args shares the canonical Args algorithm; only handles marshal here.
use std.cell.RefCell
use std.thread_local.ThreadLocal
use jet_comptime.Comptime.Diagnostics.unsupported
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.AST.[CtValue, CtReport, CtFloat, Type]
use jet_foundation.Outcome.*
use jet_codegen.Prelude.Job.jet_args_source_program_name
use jet_codegen.Prelude.CoreLib.Top.Args.*

// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:16
trait JetShow {
    // Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:18
    fn jet_show(self) -> String
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:24
// GATE #4494: invocation-thread-local handle storage uses real TLS/RefCell primitives.
const SPECS: ThreadLocal<RefCell<[JetArgsSpec]>> = ThreadLocal.new(fn() { RefCell.new([]) })
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:26
const PARSED: ThreadLocal<RefCell<[JetParsedArgs]>> = ThreadLocal.new(fn() { RefCell.new([]) })

// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:29
fn push_spec(spec: ^JetArgsSpec) -> I64 {
    SPECS.with(fn(slot) { v := slot.borrow_mut(); v.push(^spec); v.len() as I64 })
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:37
fn take_spec(id: I64) -> JetArgsSpec? {
    SPECS.with(fn(slot) { v := slot.borrow(); idx := id.saturating_sub(1) as USize; v.get(idx).cloned() })
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:45
fn replace_spec(id: I64, spec: ^JetArgsSpec) -> I64 {
    SPECS.with(fn(slot) {
        v := slot.borrow_mut()
        idx := id.saturating_sub(1) as USize
        if idx < v.len() { v[idx] = ^spec; id } else { v.push(^spec); v.len() as I64 }
    })
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:59
fn push_parsed(parsed: ^JetParsedArgs) -> I64 {
    PARSED.with(fn(slot) { v := slot.borrow_mut(); v.push(^parsed); v.len() as I64 })
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:67
fn with_parsed<R>(id: I64, f: fn(JetParsedArgs) -> R) -> R? {
    PARSED.with(fn(slot) { v := slot.borrow(); idx := id.saturating_sub(1) as USize; v.get(idx).map(fn(p) { f(p) }) })
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:75
fn spec_value(id: I64) -> CtValue { CtValue.Struct { type_name: "ArgsSpec", fields: [("id", CtValue.Int(id))] } }
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:82
fn parsed_value(id: I64) -> CtValue { CtValue.Struct { type_name: "ParsedArgs", fields: [("id", CtValue.Int(id))] } }
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:89
fn spec_id(recv: CtValue) -> I64? {
    recv == { Struct { type_name, fields } -> if type_name == "ArgsSpec" { fields.iter().find_map(fn(entry) { (entry.0, entry.1) == { ("id", Int(i)) -> Val(i); _ -> None } }) } else { None }; _ -> None }
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:101
fn parsed_id(recv: CtValue) -> I64? {
    recv == { Struct { type_name, fields } -> if type_name == "ParsedArgs" { fields.iter().find_map(fn(entry) { (entry.0, entry.1) == { ("id", Int(i)) -> Val(i); _ -> None } }) } else { None }; _ -> None }
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:113
fn as_str(v: CtValue, span: Span) -> String Diagnostic! { v == { Str(s) -> s.clone(); _ -> { fail unsupported("args expects text", span) } } }
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:120
fn str_arg(args: [CtValue], i: USize, span: Span) -> String Diagnostic! {
    value := args.get(i) == { Val(value) -> value; None -> { fail unsupported("args: missing argument", span) } }
    as_str(value, span)?
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:126
fn optional_str_arg(args: [CtValue], i: USize, span: Span) -> String? Diagnostic! {
    args.get(i) == { Val(Str(value)) -> Val(value.clone()); Val(Unit) | Val(Failed(Clean(_))) -> None; Val(_) -> { fail unsupported("args expects optional text", span) }; None -> { fail unsupported("args: missing argument", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:139
pub fn core_args_spec() -> CtValue { spec_value(push_spec(jet_args_spec())) }

// Rust: crates/jet-comptime/src/Comptime/ArgsLite.rs:143
pub fn eval_handle(op: String, recv: &CtValue, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    // Unclaimed handles remain None; argument failures remain claimed diagnostics.
    try {
        result := op == {
            "ArgsSpecProgram" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                prog := str_arg(args, 0, span)?
                spec_value(replace_spec(id, jet_args_program(^spec, prog)))
            }
            "ArgsSpecFlag" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?
                spec_value(replace_spec(id, jet_args_flag(^spec, name, help)))
            }
            "ArgsSpecFlagShort" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; short := str_arg(args, 1, span)?; help := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_flag_short(^spec, name, short, help)))
            }
            "ArgsSpecOption" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_option(^spec, name, help, meta)))
            }
            "ArgsSpecOptionDefault" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?; default := str_arg(args, 3, span)?
                spec_value(replace_spec(id, jet_args_option_default(^spec, name, help, meta, default)))
            }
            "ArgsSpecOptionInt" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_option_int(^spec, name, help, meta)))
            }
            "ArgsSpecOptionFloat" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_option_float(^spec, name, help, meta)))
            }
            "ArgsSpecOptionBase" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; short := optional_str_arg(args, 1, span)?; help := str_arg(args, 2, span)?; meta := str_arg(args, 3, span)?; default := optional_str_arg(args, 4, span)?; env := optional_str_arg(args, 5, span)?
                required := args.get(6) == { Val(Bool(value)) -> value; _ -> { fail unsupported("args expects Bool", span) } }
                repeat := args.get(7) == { Val(Bool(value)) -> value; _ -> { fail unsupported("args expects Bool", span) } }
                kind := str_arg(args, 8, span)?
                value := kind == { "Int" -> JetArgValueKind.Int; "Float" -> JetArgValueKind.Float; _ -> JetArgValueKind.String }
                updated := jet_args_option_base(^spec, name, ^short, help, meta, ^default, ^env, required, repeat, value)
                spec_value(replace_spec(id, ^updated))
            }
            "ArgsSpecOptionChoice" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?; choices := str_arg(args, 3, span)?
                spec_value(replace_spec(id, jet_args_option_choice(^spec, name, help, meta, choices)))
            }
            "ArgsSpecRepeat" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_repeat(^spec, name, help, meta)))
            }
            "ArgsSpecRequiredOption" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?; meta := str_arg(args, 2, span)?
                spec_value(replace_spec(id, jet_args_required_option(^spec, name, help, meta)))
            }
            "ArgsSpecPositional" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?
                spec_value(replace_spec(id, jet_args_positional(^spec, name, help)))
            }
            "ArgsSpecSubcommand" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                name := str_arg(args, 0, span)?; help := str_arg(args, 1, span)?
                nested_id := spec_id(args.get(2)?)?; nested := take_spec(nested_id)?
                spec_value(replace_spec(id, jet_args_subcommand(^spec, name, help, ^nested)))
            }
            "ArgsSpecVersion" -> {
                id := spec_id(recv)?; spec := take_spec(id)?; version := str_arg(args, 0, span)?
                spec_value(replace_spec(id, jet_args_version(^spec, version)))
            }
            "ArgsSpecDescription" -> {
                id := spec_id(recv)?; spec := take_spec(id)?; description := str_arg(args, 0, span)?
                spec_value(replace_spec(id, jet_args_description(^spec, description)))
            }
            "ArgsSpecCompletion" -> { id := spec_id(recv)?; spec := take_spec(id)?; shell := str_arg(args, 0, span)?; CtValue.Str(jet_args_completion(spec, shell)) }
            "ArgsSpecHelp" -> { id := spec_id(recv)?; spec := take_spec(id)?; CtValue.Str(spec.help()) }
            "ArgsSpecParse" -> {
                id := spec_id(recv)?; spec := take_spec(id)?
                items := args.first() == { Val(List(items)) -> items; _ -> { fail unsupported("ArgsSpec.parse expects a list of text", span) } }
                mut argv: [String] := [].with_capacity(items.len())
                for item in items { argv.push(as_str(item, span)?) }
                try { parsed := jet_args_parse(spec, argv)?; CtValue.Present(parsed_value(push_parsed(^parsed))) }
                catch(message) { CtValue.failed(CtValue.Str(message.to_string())) }
            }
            "ParsedArgsFlag" -> { id := parsed_id(recv)?; name := str_arg(args, 0, span)?; CtValue.Bool(with_parsed(id, fn(p) { jet_parsed_flag(p, name) }).unwrap_or(false)) }
            "ParsedArgsOption" -> {
                id := parsed_id(recv)?; name := str_arg(args, 0, span)?
                with_parsed(id, fn(p) { jet_parsed_option(p, name) }).and_then(fn(r) { r.ok() }) == { Val(s) -> CtValue.Present(CtValue.Str(^s)); None -> CtValue.absent(Type.String) }
            }
            "ParsedArgsOptionInt" -> {
                id := parsed_id(recv)?; name := str_arg(args, 0, span)?
                with_parsed(id, fn(p) { jet_parsed_option_int(p, name) }).and_then(fn(r) { r.ok() }) == { Val(n) -> CtValue.Present(CtValue.Int(n)); None -> CtValue.absent(Type.Int) }
            }
            "ParsedArgsOptionFloat" -> {
                id := parsed_id(recv)?; name := str_arg(args, 0, span)?
                with_parsed(id, fn(p) { jet_parsed_option_float(p, name) }).and_then(fn(r) { r.ok() }) == { Val(n) -> CtValue.Present(CtValue.Float(CtFloat.f64(n))); None -> CtValue.absent(Type.Float) }
            }
            "ParsedArgsOptions" -> {
                id := parsed_id(recv)?; name := str_arg(args, 0, span)?
                items := with_parsed(id, fn(p) { jet_parsed_options(p, name) }).unwrap_or_default()
                CtValue.List(items.into_iter().map(fn(item) { CtValue.Str(^item) }).collect())
            }
            "ParsedArgsSubcommand" -> {
                id := parsed_id(recv)?
                with_parsed(id, fn(p) { jet_parsed_subcommand(p) }).and_then(fn(r) { r.ok() }) == { Val(s) -> CtValue.Present(CtValue.Str(^s)); None -> CtValue.absent(Type.String) }
            }
            "ParsedArgsPositional" -> {
                id := parsed_id(recv)?
                idx := args.first() == { Val(Int(n)) -> n; _ -> { fail unsupported("ParsedArgs.positional expects Int", span) } }
                with_parsed(id, fn(p) { jet_parsed_positional(p, idx) }).and_then(fn(r) { r.ok() }) == { Val(s) -> CtValue.Present(CtValue.Str(^s)); None -> CtValue.absent(Type.String) }
            }
            _ -> { return None }
        }
        Val(Ok(^result))
    } catch(error) { Val(Err(^error)) }
}
