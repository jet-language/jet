//RS /// Install the folded release-policy projection for the current interpreter
//RS /// invocation. Kernel callbacks consult this shared context instead of the
//RS /// compiler's build profile. Dropping the guard restores the enclosing
//RS /// invocation's policy.
//RS pub struct WebRuntimePolicyGuard {
//RS     previous: (bool, bool),
//RS }
//RS 
//RS impl Drop for WebRuntimePolicyGuard {
//RS     fn drop(&mut self) {
//RS         WEB_RUNTIME_POLICY.with(|policy| policy.set(self.previous));
//RS     }
//RS }
//RS 
//RS pub fn set_web_runtime_policy(
//RS     devtools_enabled: bool,
//RS     history_enabled: bool,
//RS ) -> WebRuntimePolicyGuard {
//RS     let previous = WEB_RUNTIME_POLICY.with(|policy| {
//RS         policy.replace((devtools_enabled, history_enabled))
//RS     });
//RS     WebRuntimePolicyGuard { previous }
//RS }
//RS 
