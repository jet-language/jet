// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1793
fn web_int_pairs(value: CtValue, what: String, span: Span) -> [(I64, I64)] Diagnostic! {
    if value != .List(values) -> return .Err(unsupported(what, span))
    out := [(I64, I64)].with_capacity(values.len())
    loop value in values {
        if value != .Struct(_, fields) -> return .Err(unsupported(what, span))
        field :: fn(name) { fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { pair.1 }) }
        index :: field("index").or_else(fn() { fields.first().map(fn(pair) { pair.1 }) }) ?? return .Err(unsupported(what, span))
        size :: field("size").or_else(fn() { fields.get(1).map(fn(pair) { pair.1 }) }) ?? return .Err(unsupported(what, span))
        out.push((web_int(index, "measurement index", span)?, web_int(size, "measurement size", span)?))
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1827
fn web_string_map(value: CtValue, what: String, span: Span) -> [String:String] Diagnostic! {
    if value != .Map(values) -> return .Err(unsupported(what, span))
    out := [String:String]{}
    loop (key, value) in values {
        if key != .Str(text) -> return .Err(unsupported(what, span))
        out.insert(text, web_string(value, what, span)?)
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1846
fn web_string_map_value(values: [String:String]) -> CtValue Never! {
    keys := values.keys().collect()
    keys.sort()
    // GATE #4499: CtKey preserves its canonical composite-key order.
    out := [CtKey:CtValue]{}
    loop key in keys -> out.insert(CtKey.Str(key), CtValue.Str(values[key]))
    CtValue.Map(^out)
}
