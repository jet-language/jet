            slot := handle.lock().unwrap_or_else(fn(error) { error.into_inner() })
            if method == "typed_validation_cancel" {
                web_kernel.jet_web_forms_typed_validation_cancel(slot.as_ref() ?? return .Err(unsupported("consumed form validation", span)))
                CtValue.Unit
