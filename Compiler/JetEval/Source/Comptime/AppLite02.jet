// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:2486
pub struct WebRuntimePolicyGuard {
    previous: (Bool, Bool)
    // Rust: crates/jet-comptime/src/Comptime/AppLite.rs:2491
    fn drop(self: &Self) -> Unit Never! {
        // GATE #4494: invocation-local TLS, restored by scoped destruction.
        WEB_RUNTIME_POLICY.with(fn(policy) { policy.set(self.previous) })
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:2496
pub fn set_web_runtime_policy(devtools_enabled: Bool, history_enabled: Bool) -> WebRuntimePolicyGuard Never! {
    previous :: WEB_RUNTIME_POLICY.with(fn(policy) { policy.replace((devtools_enabled, history_enabled)) })
    WebRuntimePolicyGuard{previous: previous}
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:2506
pub fn apply_suite_with_policy(module: String, method: String, args: [CtValue], span: Span, devtools_enabled: Bool, history_enabled: Bool) -> CtValue Diagnostic! {
    guard :: set_web_runtime_policy(devtools_enabled, history_enabled)
    defer guard.drop()
    apply_suite(module, method, args, span, None)
}
