// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:2565
pub fn apply_suite(module: String, method: String, args: [CtValue], span: Span, result_type: Type?) -> CtValue Diagnostic! {
    one :: fn(index: Int) { args.get(index) ?? return .Err(unsupported("{module}.{method} argument {index}", span)) }
    if (module, method) == {
        ("core.reactive", "effect") -> {
            callback :: one(0)?
            opaque_web(web_kernel.jet_reactive_effect(fn() { _ :: invoke_standalone_closure(callback, [], span).unwrap_or_else(fn(error) { panic(error) }) }))
        }
        ("core.ui", "reactive_render") -> {
            callback :: one(0)?
            web_kernel.jet_reactive_effect_rooted(fn() { _ :: invoke_standalone_closure(callback, [], span).unwrap_or_else(fn(error) { panic(error) }) })
            CtValue.Unit
        }
        ("core.reactive", "signal") -> opaque_web(web_kernel.JetSignal.new(one(0)?))
        ("core.reactive", "derived" | "computed") -> {
            callback :: one(0)?
            opaque_web(web_kernel.JetDerived.new(fn() { invoke_standalone_closure(callback, [], span).unwrap_or_else(fn(error) { panic(error) }) }))
        }
        ("core.web", "page") -> {
            title :: web_string(one(0)?, "page title", span)?
            body :: web_string(one(1)?, "page body", span)?
            page :: web_kernel.jet_web_page(title, body)
