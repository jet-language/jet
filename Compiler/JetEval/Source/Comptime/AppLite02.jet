// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:3805
fn web_signal_method<T>(signal: web_kernel.JetSignal<T>, method: String, args: [CtValue], encode: fn(T) -> CtValue, decode: fn(CtValue, Span) -> T Diagnostic!, span: Span) -> CtValue Diagnostic! {
    if method == {
        "get" -> encode(signal.get())
        "set" -> {
            value :: args.first() ?? return .Err(unsupported("Signal.set value", span))
            signal.set(decode(value, span)?)
            CtValue.Unit
        }
        _ -> return .Err(unsupported("Signal.{method}", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:3824
fn normalize_web_handle_method(method: String) -> String Never! {
    if method == {
        "Signal.get" | "Derived.get" -> "get"
        "Signal.set" -> "set"
        "Effect.active" -> "active"
        "Effect.unsubscribe" -> "unsubscribe"
        _ -> method
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:3836
pub fn apply_web_handle(receiver: CtValue, method: String, args: [CtValue], span: Span, result_type: Type?) -> (CtValue Diagnostic!)? Never! {
    if receiver != .Closure(data) -> return None
    opaque :: data.opaque ?? return None
    if apply_file_handle(receiver, method, args, span) == .Val(result) -> return Val(result)
    method :: normalize_web_handle_method(method)
    // GATE #4494: retain live, typed opaque owners across the callback ABI.
    if opaque.downcast_ref<web_kernel.JetReactiveEffect>() == .Val(effect) {
        return Val(if method == {
            "active" -> .Ok(CtValue.Bool(effect.active()))
            "unsubscribe" -> { effect.unsubscribe(); .Ok(CtValue.Unit) }
            _ -> .Err(unsupported("Effect.{method}", span))
        })
    }
    if opaque.downcast_ref<web_kernel.JetSignal<CtValue>>() == .Val(signal) -> return Val(web_signal_method(signal, method, args, fn(value) { value }, fn(value, _) { .Ok(value) }, span))
    if opaque.downcast_ref<web_kernel.JetSignal<web_kernel.JetWebQueryState>>() == .Val(signal) -> return Val(web_signal_method(signal, method, args, web_query_state, web_query_state_read, span))
    if opaque.downcast_ref<web_kernel.JetSignal<web_kernel.JetWebMutationState>>() == .Val(signal) -> return Val(web_signal_method(signal, method, args, web_mutation_state, web_mutation_state_read, span))
    if opaque.downcast_ref<web_kernel.JetDerived<CtValue>>() == .Val(derived) -> return Val(if method == "get" -> .Ok(derived.get()) else -> .Err(unsupported("Derived.{method}", span)))
    if opaque.downcast_ref<web_kernel.JetDerived<web_kernel.JetWebFormFieldState>>() == .Val(derived) -> return Val(if method == "get" -> .Ok(web_form_field_state(derived.get())) else -> .Err(unsupported("Derived.{method}", span)))
    (module, prefix) :: if opaque.downcast_ref<WebRouterHandle>() != None -> ("core.web.router", "")
        else if opaque.downcast_ref<WebQueryHandle>() != None -> ("core.web.query", "")
        else if opaque.downcast_ref<WebFormHandle>() != None -> ("core.web.forms", "")
        else if opaque.downcast_ref<web_kernel.JetWebFormInput>() != None -> ("core.web.forms", "input_")
        else if opaque.downcast_ref<web_kernel.JetWebFormTyped>() != None -> ("core.web.forms", "typed_")
        else if opaque.downcast_ref<web_kernel.JetWebFormValidationChain>() != None -> ("core.web.forms", "typed_validation_")
        else if opaque.downcast_ref<WebFormValidationHandle>() != None -> ("core.web.forms", "typed_validation_")
        else if opaque.downcast_ref<WebFormSubmissionHandle>() != None -> ("core.web.forms", "typed_submission_")
        else if opaque.downcast_ref<WebTableHandle>() != None -> ("core.web.table", "")
        else if opaque.downcast_ref<WebVirtualPlanViewportHandle>() != None -> ("core.web.virtual", "plan_viewport_")
        else if opaque.downcast_ref<WebStoreHandle>() != None -> ("core.web.store", "")
        else if opaque.downcast_ref<WebStorePatchHandle>() != None -> ("core.web.store", "patch_")
        else if opaque.downcast_ref<WebStoreSubscriptionHandle>() != None -> ("core.web.store", "subscription_")
        else -> return None
    projected :: if prefix.is_empty() -> method else -> "{prefix}{method}"
    if args.is_empty() -> return Val(apply_suite(module, projected, [receiver], span, result_type))
    values := [CtValue].with_capacity(args.len() + 1)
    values.push(receiver)
    values.extend_from_slice(args)
    Val(apply_suite(module, projected, ^values, span, result_type))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:3935
fn web_ints(value: CtValue, what: String, span: Span) -> [I64] Diagnostic! {
    if value != .List(values) -> return .Err(unsupported(what, span))
    out := [I64].with_capacity(values.len())
    loop value in values -> out.push(web_int(value, what, span)?)
    ^out
}
