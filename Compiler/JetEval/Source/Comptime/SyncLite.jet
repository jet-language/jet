        if items.len() > MAX_SYNC_ENTRIES -> fail unsupported("SyncList item limit", span)
        list := JetSyncList{items: [(String, String)]{}, valid: valid}
        loop item in items {
            fields :: if item == { .Struct(name, fields) -> if name == "SyncListItem" -> fields else -> fail unsupported("SyncList item", span) else -> fail unsupported("SyncList item", span) }
            field :: fn(name: String) -> &CtValue Diagnostic! { &(fields.iter().find(fn(f) -> f.name == name) ?? fail unsupported("SyncList item field", span)).value }
            replica :: if field("replica")! == { .Str(s) -> s.clone() else -> fail unsupported("SyncList replica", span) }
            value :: if field("item")! == { .Str(s) -> s.clone() else -> fail unsupported("SyncList item value", span) }
            if !jet_sync_token_is_valid(&replica) || value.len() > MAX_SYNC_TEXT -> fail unsupported("SyncList item value", span)
            list.items.push((replica, value))
        }
        return ^list
    } None -> {} }
    show :: if fields.iter().find(fn(f) -> f.name == "show") == {
        Val(f) -> if f.value == { .Str(s) -> s else -> fail unsupported("SyncList show", span) }
        None -> fail unsupported("SyncList items", span)
    }
    body :: show.strip_prefix("SyncList(").and_then(fn(s) -> s.strip_suffix(')')) ?? fail unsupported("SyncList show", span)
    list := JetSyncList{items: [(String, String)]{}, valid: valid}
    if !body.is_empty() {
        loop part in body.split('|') {
            (replica, item) :: part.split_once(':') ?? fail unsupported("SyncList show", span)
            if !jet_sync_token_is_valid(replica) || item.len() > MAX_SYNC_TEXT -> fail unsupported("SyncList show", span)
            list.items.push((replica.to_string(), item.to_string()))
