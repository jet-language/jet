        "text_merge" -> text_to_ct(&jet_sync_text_merge(&ct_to_text(&one(0)!, span)!, &ct_to_text(&one(1)!, span)!))
        "text_show" -> CtValue.Str{value: jet_sync_text_show(&ct_to_text(&one(0)!, span)!)}
        "text_edit" -> text_to_ct(&jet_sync_text_edit(ct_to_text(&one(0)!, span)!, as_str(1)!, as_int(2)!, as_int(3)!, as_str(4)!))
        "text_metadata" -> CtValue.Str{value: jet_sync_text_metadata(&ct_to_text(&one(0)!, span)!)}
        "counter_new" -> counter_to_ct(&jet_sync_counter_new(as_str(0)!, as_int(1)!))
        "counter_inc" -> counter_to_ct(&jet_sync_counter_inc(ct_to_counter(&one(0)!, span)!, as_str(1)!, as_int(2)!))
        "counter_merge" -> counter_to_ct(&jet_sync_counter_merge(&ct_to_counter(&one(0)!, span)!, &ct_to_counter(&one(1)!, span)!))
        "counter_value" -> CtValue.Int{value: jet_sync_counter_value(&ct_to_counter(&one(0)!, span)!)}
        "map_new" -> map_to_ct(&jet_sync_map_new())
        "map_set" -> map_to_ct(&jet_sync_map_set(ct_to_map(&one(0)!, span)!, as_str(1)!, as_str(2)!))
        "map_get" -> if jet_sync_map_get(&ct_to_map(&one(0)!, span)!, &as_str(1)!) == { Val(s) -> CtValue.Present{value: Box.new(CtValue.Str{value: s})} None -> CtValue.absent(Type.String) }
        "map_merge" -> map_to_ct(&jet_sync_map_merge(&ct_to_map(&one(0)!, span)!, &ct_to_map(&one(1)!, span)!))
        "map_show" -> CtValue.Str{value: jet_sync_map_show(&ct_to_map(&one(0)!, span)!)}
        "list_new" -> list_to_ct(&jet_sync_list_new())
        "list_push" -> list_to_ct(&jet_sync_list_push(ct_to_list(&one(0)!, span)!, as_str(1)!, as_str(2)!))
        "list_merge" -> list_to_ct(&jet_sync_list_merge(&ct_to_list(&one(0)!, span)!, &ct_to_list(&one(1)!, span)!))
        "list_show" -> CtValue.Str{value: jet_sync_list_show(&ct_to_list(&one(0)!, span)!)}
        "policy_new" -> if jet_db_policy_new(as_str(0)!, as_str(1)!) == { Ok(p) -> CtValue.Present{value: Box.new(policy_to_ct(&p))} Err(e) -> CtValue.failed(Box.new(CtValue.Str{value: e})) }
        "policy_allows" -> CtValue.Bool{value: jet_db_policy_allows(&ct_to_policy(&one(0)!, span)!, &as_str(1)!, &as_str(2)!)}
        "policy_show" -> CtValue.Str{value: jet_db_policy_show(&ct_to_policy(&one(0)!, span)!)}
        "sync" -> CtValue.Str{value: jet_app_sync(as_str(0)!, as_str(1)!)}
        else -> fail unsupported("`core.sync.{method}()`", span)
