// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:350
fn text_to_ct(doc: &JetSyncText) -> CtValue {
    atoms := [CtValue]{}
    loop atom in doc.atoms {
        after :: if atom.after == { Val((replica, counter)) -> "{replica}:{counter}" None -> "" }
        atoms.push(CtValue.Struct{type_name: "SyncTextAtom", fields: [NamedCtValue]{
            NamedCtValue{name: "replica", value: CtValue.Str{value: atom.replica.clone()}},
            NamedCtValue{name: "counter", value: CtValue.Str{value: atom.counter.to_string()}},
            NamedCtValue{name: "after", value: CtValue.Str{value: after}},
            NamedCtValue{name: "ch", value: CtValue.Str{value: atom.ch.to_string()}},
            NamedCtValue{name: "deleted", value: CtValue.Str{value: atom.deleted.to_string()}}
        }})
    }
    CtValue.Struct{type_name: "SyncText", fields: [NamedCtValue]{
        NamedCtValue{name: "show", value: CtValue.Str{value: jet_sync_text_show(doc)}},
        NamedCtValue{name: "valid", value: CtValue.Bool{value: doc.valid}},
        NamedCtValue{name: "atoms", value: CtValue.List{values: ^atoms}}
    }}
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:392
fn counter_to_ct(c: &JetSyncCounter) -> CtValue {
    counts := [CtValue]{}
    loop (replica, positive, negative) in c.counts {
        counts.push(CtValue.Struct{type_name: "SyncCounterEntry", fields: [NamedCtValue]{
            NamedCtValue{name: "replica", value: CtValue.Str{value: replica.clone()}},
            NamedCtValue{name: "positive", value: CtValue.Str{value: positive.to_string()}},
            NamedCtValue{name: "negative", value: CtValue.Str{value: negative.to_string()}}
        }})
    }
    CtValue.Struct{type_name: "SyncCounter", fields: [NamedCtValue]{
        NamedCtValue{name: "valid", value: CtValue.Bool{value: c.valid}},
        NamedCtValue{name: "counts", value: CtValue.List{values: ^counts}}
    }}
}
