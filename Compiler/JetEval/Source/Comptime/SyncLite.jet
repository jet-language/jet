fn map_to_ct(m: &JetSyncMap) -> CtValue {
    entries := [CtValue]{}
    loop (key, value, clock, writer) in m.entries {
        entries.push(CtValue.Struct{type_name: "SyncMapEntry", fields: [NamedCtValue]{
            NamedCtValue{name: "key", value: CtValue.Str{value: key.clone()}},
            NamedCtValue{name: "value", value: CtValue.Str{value: value.clone()}},
            NamedCtValue{name: "clock", value: CtValue.Str{value: clock.to_string()}},
            NamedCtValue{name: "writer", value: CtValue.Str{value: writer.clone()}}
        }})
    }
    CtValue.Struct{type_name: "SyncMap", fields: [NamedCtValue]{
        NamedCtValue{name: "show", value: CtValue.Str{value: jet_sync_map_show(m)}},
        NamedCtValue{name: "valid", value: CtValue.Bool{value: m.valid}},
        NamedCtValue{name: "entries", value: CtValue.List{values: ^entries}}
    }}
}
