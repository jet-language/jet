// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:499
fn ct_to_text(v: &CtValue, span: Span) -> JetSyncText Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> if name == "SyncText" || name == "JetSyncText" -> fields else -> fail unsupported("SyncText", span) else -> fail unsupported("SyncText", span) }
    value :: fields.iter().find(fn(f) -> f.name == "atoms") ?? fail unsupported("SyncText atoms", span)
    valid :: ct_carrier_valid(&fields)
    entries :: if value.value == { .List(entries) -> entries else -> fail unsupported("SyncText atoms", span) }
    if entries.len() > MAX_SYNC_ATOMS -> fail unsupported("SyncText atom limit", span)
    atoms := [JetSyncTextAtom]{}
    // GATE #4499: exact tuple equality/hash for replica+counter, not string encoding.
    seen := [(String, UInt64): Bool]{}
    loop entry in entries {
        fields :: if entry == { .Struct(name, fields) -> if name == "SyncTextAtom" -> fields else -> fail unsupported("SyncText atom", span) else -> fail unsupported("SyncText atom", span) }
        field :: fn(name: String) -> &CtValue Diagnostic! {
            &(fields.iter().find(fn(f) -> f.name == name) ?? fail unsupported("SyncText atom field", span)).value
        }
        text :: fn(name: String) -> String Diagnostic! {
            if field(name)! == { .Str(s) -> s.clone() else -> fail unsupported("SyncText atom field", span) }
        }
        replica :: text("replica")!
        counter :: if field("counter")! == {
            .Int(n) -> if n >= 0 -> UInt64.try_from(n).map_err(fn(_) -> unsupported("SyncText atom counter", span))! else -> fail unsupported("SyncText atom counter", span)
            .Str(s) -> s.parse[UInt64]().map_err(fn(_) -> unsupported("SyncText atom counter", span))!
            else -> fail unsupported("SyncText atom counter", span)
        }
        after_text :: text("after")!
        after :: if after_text.is_empty() -> None else {
            (r, c) :: after_text.rsplit_once(':') ?? fail unsupported("SyncText atom anchor", span)
            count :: c.parse[UInt64]().map_err(fn(_) -> unsupported("SyncText atom anchor", span))!
            if !jet_sync_token_is_valid(r) -> fail unsupported("SyncText atom anchor", span)
            Val((r.to_string(), count))
        }
        ch_text :: text("ch")!
        chars := ch_text.chars()
        ch :: chars.next() ?? fail unsupported("SyncText atom character", span)
        if chars.next().is_some() -> fail unsupported("SyncText atom character", span)
        deleted :: if text("deleted")! == { "true" -> true "false" -> false else -> fail unsupported("SyncText atom tombstone", span) }
        if !jet_sync_token_is_valid(&replica) -> fail unsupported("SyncText atom replica", span)
        identity :: (replica.clone(), counter)
        if counter == 0 || seen.contains_key(identity) -> fail unsupported("SyncText atom identity", span)
        seen[identity] = true
        atoms.push(JetSyncTextAtom{replica: replica, counter: counter, after: after, ch: ch, deleted: deleted})
    }
    doc :: JetSyncText{atoms: ^atoms, valid: valid}
    if !doc.valid -> return doc
    if jet_sync_text_order(&doc).len() != doc.atoms.len() -> fail unsupported("SyncText reachability", span)
    doc
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:599
fn ct_to_counter(v: &CtValue, span: Span) -> JetSyncCounter Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> if name == "SyncCounter" || name == "JetSyncCounter" -> fields else -> fail unsupported("SyncCounter", span) else -> fail unsupported("SyncCounter", span) }
    valid :: ct_carrier_valid(&fields)
    if fields.iter().find(fn(f) -> f.name == "counts") == { Val(value) -> {
        entries :: if value.value == { .List(entries) -> entries else -> fail unsupported("SyncCounter counts", span) }
        if entries.len() > MAX_SYNC_REPLICAS -> fail unsupported("SyncCounter replica limit", span)
        counts := [(String, UInt64, UInt64)]{}
        loop entry in entries {
            if entry == {
                .Struct(name, ef) -> if name == "SyncCounterEntry" {
                    replica :: ef.iter().find(fn(f) -> f.name == "replica").and_then(fn(f) -> if f.value == { .Str(s) -> Val(s.clone()) else -> None }) ?? fail unsupported("SyncCounter replica", span)
                    positive :: ef.iter().find(fn(f) -> f.name == "positive").and_then(fn(f) -> if f.value == { .Int(n) -> if n >= 0 -> UInt64.try_from(n).ok() else -> None .Str(s) -> s.parse[UInt64]().ok() else -> None }) ?? fail unsupported("SyncCounter positive", span)
                    negative :: ef.iter().find(fn(f) -> f.name == "negative").and_then(fn(f) -> if f.value == { .Int(n) -> if n >= 0 -> UInt64.try_from(n).ok() else -> None .Str(s) -> s.parse[UInt64]().ok() else -> None }) ?? fail unsupported("SyncCounter negative", span)
                    if !jet_sync_token_is_valid(&replica) -> fail unsupported("SyncCounter replica", span)
                    counts.push((replica, positive, negative))
                } else -> fail unsupported("SyncCounter entry", span)
                .List(parts) -> if parts.len() == 3 {
                    replica :: if parts[0] == { .Str(s) -> s.clone() else -> fail unsupported("SyncCounter replica", span) }
                    positive :: if parts[1] == { .Int(n) -> if n >= 0 -> UInt64.try_from(n).map_err(fn(_) -> unsupported("SyncCounter positive", span))! else -> fail unsupported("SyncCounter positive", span) else -> fail unsupported("SyncCounter positive", span) }
                    negative :: if parts[2] == { .Int(n) -> if n >= 0 -> UInt64.try_from(n).map_err(fn(_) -> unsupported("SyncCounter negative", span))! else -> fail unsupported("SyncCounter negative", span) else -> fail unsupported("SyncCounter negative", span) }
                    if !jet_sync_token_is_valid(&replica) -> fail unsupported("SyncCounter replica", span)
                    counts.push((replica, positive, negative))
                } else if parts.len() == 2 {
                    replica :: if parts[0] == { .Str(s) -> s.clone() else -> fail unsupported("SyncCounter replica", span) }
                    value :: if parts[1] == { .Int(n) -> n else -> fail unsupported("SyncCounter value", span) }
                    if !jet_sync_token_is_valid(&replica) -> fail unsupported("SyncCounter replica", span)
                    counts.push((replica, if value >= 0 -> value as UInt64 else -> 0, if value < 0 -> value.unsigned_abs() else -> 0))
                } else -> fail unsupported("SyncCounter entry", span)
                else -> fail unsupported("SyncCounter entry", span)
            }
        }
        return JetSyncCounter{counts: ^counts, valid: valid}
    } None -> {} }
    // Rust's legacy ambient carrier is accepted with the same validity policy.
    value :: if fields.iter().find(fn(f) -> f.name == "value") == {
        Val(f) -> if f.value == { .Int(n) -> n else -> fail unsupported("SyncCounter value", span) }
        None -> fail unsupported("SyncCounter counts", span)
    }
    JetSyncCounter{counts: [(String, UInt64, UInt64)]{("ambient", if value >= 0 -> value as UInt64 else -> 0, if value < 0 -> value.unsigned_abs() else -> 0)}, valid: valid}
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:712
fn ct_to_map(v: &CtValue, span: Span) -> JetSyncMap Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> if name == "SyncMap" || name == "JetSyncMap" -> fields else -> fail unsupported("SyncMap", span) else -> fail unsupported("SyncMap", span) }
    valid :: ct_carrier_valid(&fields)
    if fields.iter().find(fn(f) -> f.name == "entries") == { Val(value) -> {
        entries :: if value.value == { .List(entries) -> entries else -> fail unsupported("SyncMap entries", span) }
        if entries.len() > MAX_SYNC_ENTRIES -> fail unsupported("SyncMap entry limit", span)
        map_entries := [(String, String, UInt64, String)]{}
        loop entry in entries {
            fields :: if entry == { .Struct(name, fields) -> if name == "SyncMapEntry" -> fields else -> fail unsupported("SyncMap entry", span) else -> fail unsupported("SyncMap entry", span) }
            field :: fn(name: String) -> &CtValue Diagnostic! { &(fields.iter().find(fn(f) -> f.name == name) ?? fail unsupported("SyncMap entry field", span)).value }
            key :: if field("key")! == { .Str(s) -> s.clone() else -> fail unsupported("SyncMap key", span) }
            value :: if field("value")! == { .Str(s) -> s.clone() else -> fail unsupported("SyncMap value", span) }
            clock :: if field("clock")! == {
                .Int(n) -> if n >= 0 -> UInt64.try_from(n).map_err(fn(_) -> unsupported("SyncMap clock", span))! else -> fail unsupported("SyncMap clock", span)
