// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:45
fn datatree_from_ct(value: &CtValue) -> DataTree? {
    // Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:46
    fn object_pairs(fields: [NamedCtValue]) -> [(String, DataTree)]? {
        pairs := [(String, DataTree)]{}
        loop field in fields {
            tree :: datatree_from_ct(&field.value) ?? return None
            pairs.push((field.name, ^tree))
        }
        Val(^pairs)
    }
    // Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:55
    fn map_pairs(fields: &[CtMapEntry]) -> [NamedCtValue]? {
        pairs := [NamedCtValue]{}
        // CtValue.Map is the ordered BTreeMap carrier; preserve canonical key order.
        loop entry in fields {
            key :: if entry.key == { .Str(key) -> key else -> return None }
            pairs.push(NamedCtValue{name: key.clone(), value: entry.value.clone()})
        }
        Val(^pairs)
    }
    // Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:71
    fn list_object_pairs(values: &[CtValue]) -> [NamedCtValue]? {
        pairs := [NamedCtValue]{}
        loop value in values {
            fields :: if value == { .Struct(_, fields) -> fields else -> return None }
            if fields.len() != 2 -> return None
            key :: fields.iter().find(fn(f) -> f.name == "key") ?? return None
            value :: fields.iter().find(fn(f) -> f.name == "value") ?? return None
            name :: if key.value == { .Str(name) -> name else -> return None }
            pairs.push(NamedCtValue{name: name.clone(), value: value.value.clone()})
        }
        Val(^pairs)
    }
    if value == {
        .Enum(type_name, variant, args) -> if type_name == "DataTree" || type_name == "TOML" || type_name == "YAML" || type_name == "CSV" {
            payload :: args.first().map(fn(arg) -> &arg.value)
            return if variant == {
                "Null" -> Val(DataTree.Null)
                "Bool" -> if payload == { Val(.Bool(v)) -> Val(DataTree.Bool(v)) else -> None }
                "Int" -> if payload == {
                    Val(.Int(v)) -> Val(DataTree.Int(v))
                    Val(.BigInt(v)) -> Val(if CtBigInt.from_str(v).ok()?.try_i64() == { Val(n) -> DataTree.Int(n) None -> DataTree.Number(v.clone()) })
                    else -> None
                }
                "Float" -> if payload == { Val(.Float(v)) -> Val(DataTree.Float(v.as_f64())) else -> None }
                "Number" -> if payload == { Val(.Str(v)) -> Val(DataTree.Number(v.clone())) else -> None }
                "TypedText" -> if payload == { Val(.Str(v)) -> Val(DataTree.TypedText(v.clone())) else -> None }
                "Text" -> if payload == { Val(.Str(v)) -> Val(DataTree.Text(v.clone())) else -> None }
                "Bytes" -> if payload == { Val(.Bytes(v)) -> Val(DataTree.Bytes(v.clone())) else -> None }
                "Array" -> if payload == {
                    Val(.List(values)) -> {
                        trees := [DataTree]{}
                        loop v in values { trees.push(datatree_from_ct(&v) ?? return None) }
                        Val(DataTree.Array(^trees))
                    }
                    else -> None
                }
                "Object" -> if payload == {
                    Val(.Map(fields)) -> Val(DataTree.Object(object_pairs(map_pairs(&fields) ?? return None) ?? return None))
                    Val(.List(values)) -> Val(DataTree.Object(object_pairs(list_object_pairs(&values) ?? return None) ?? return None))
                    Val(.Struct(name, fields)) -> if name == "JSONObject" -> Val(DataTree.Object(object_pairs(fields.clone()) ?? return None)) else -> None
                    else -> None
                }
                else -> None
            }
        } else -> return None
        .Int(v) -> Val(DataTree.Int(v))
        .BigInt(v) -> Val(if CtBigInt.from_str(v).ok()?.try_i64() == { Val(n) -> DataTree.Int(n) None -> DataTree.Number(v.clone()) })
        .Float(v) -> Val(DataTree.Float(v.as_f64()))
        .Bool(v) -> Val(DataTree.Bool(v))
        .Str(v) -> Val(DataTree.Text(v.clone()))
        .Bytes(v) -> Val(DataTree.Bytes(v.clone()))
        .List(values) -> {
            trees := [DataTree]{}
            loop v in values { trees.push(datatree_from_ct(&v) ?? return None) }
            Val(DataTree.Array(^trees))
        }
        .Map(fields) -> Val(DataTree.Object(object_pairs(map_pairs(&fields) ?? return None) ?? return None))
        .Struct(name, fields) -> if name == "JSONObject" -> Val(DataTree.Object(object_pairs(fields.clone()) ?? return None)) else -> None
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:189
fn field_errors_to_ct(errors: [FieldError]) -> CtValue {
    values := [CtValue]{}
    loop error in errors {
        values.push(CtValue.Struct{type_name: "FieldError", fields: [NamedCtValue]{
            NamedCtValue{name: "path", value: CtValue.Str{value: error.path}},
            NamedCtValue{name: "reason", value: CtValue.Str{value: error.reason}}
        }})
    }
    CtValue.List{values: ^values}
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:205
pub fn datatree_to_text(value: &CtValue) -> String? { datatree_from_ct(value)?.to_text() }
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:210
pub fn datatree_equal_unordered(left: &CtValue, right: &CtValue) -> Bool {
    l :: datatree_from_ct(left) ?? return false
    r :: datatree_from_ct(right) ?? return false
    l.equal_unordered(&r)
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:218
pub fn decode_int_ct(value: &CtValue) -> CtValue CtValue! {
    tree :: datatree_from_ct(value) ?? fail field_errors_to_ct(FieldError.one("expected Int, found value"))
    exact :: jet_std.decode_int_with(&tree, CtBigInt.from_int, fn(text) -> CtBigInt String! {
        CtBigInt.from_str(text).map_err(fn(error) -> error.to_string())!
    }).map_err(field_errors_to_ct)!
    exact_int_value(^exact)
}
// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:237
pub fn decode_int_n_ct(value: &CtValue, signed: Bool, bits: UInt8, type_name: String) -> CtValue CtValue! {
    tree :: datatree_from_ct(value) ?? fail field_errors_to_ct(FieldError.one("expected Int, found value"))
    decoded :: jet_std.jet_datatree_decode_fixed_integer(&tree, signed, bits, type_name).map_err(field_errors_to_ct)!
    exact :: if Int64.try_from(decoded) == {
        Ok(v) -> CtBigInt.from_int(v)
        Err(_) -> if UInt64.try_from(decoded) == {
            Ok(v) -> CtBigInt.from_u64(v)
            Err(_) -> panic("fixed integer kernel returned an unrepresentable value")
        }
    }
    exact_int_value(^exact)
}
