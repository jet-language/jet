fn ct_to_policy(v: &CtValue, span: Span) -> JetRowPolicy Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> if name == "RowPolicy" || name == "JetRowPolicy" -> fields else -> fail unsupported("RowPolicy", span) else -> fail unsupported("RowPolicy", span) }
    table :: fields.iter().find(fn(f) -> f.name == "table").and_then(fn(f) -> if f.value == { .Str(s) -> Val(s.clone()) else -> None }) ?? fail unsupported("table", span)
    code :: fields.iter().find(fn(f) -> f.name == "compiled").and_then(fn(f) -> if f.value == { .Int(n) -> Val(n) else -> None }) ?? fail unsupported("compiled row policy", span)
    compiled :: if code == { 0 -> jet_std.JetRowPolicyExpr.AllowAll 1 -> jet_std.JetRowPolicyExpr.OwnerEqualsUser else -> fail unsupported("compiled row policy", span) }
    jet_db_policy_from_compiled(table, compiled).map_err(fn(_) -> unsupported("unsupported row policy", span))!
}
