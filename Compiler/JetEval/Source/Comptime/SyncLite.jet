// Rust: crates/jet-comptime/src/Comptime/SyncLite.rs:889
pub fn sync_show_value(value: &CtValue) -> String? {
    span :: Span.new(0, 0)
    name :: if value == { .Struct(name, _) -> name else -> return None }
    if name == {
        "SyncText" | "JetSyncText" -> Val(ct_to_text(value, span).ok()?.jet_show())
        "SyncCounter" | "JetSyncCounter" -> Val(ct_to_counter(value, span).ok()?.jet_show())
        "SyncMap" | "JetSyncMap" -> Val(ct_to_map(value, span).ok()?.jet_show())
        "SyncList" | "JetSyncList" -> Val(ct_to_list(value, span).ok()?.jet_show())
        else -> None
    }
}
