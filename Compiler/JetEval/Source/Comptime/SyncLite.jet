fn ct_to_list(v: &CtValue, span: Span) -> JetSyncList Diagnostic! {
    fields :: if v == { .Struct(name, fields) -> if name == "SyncList" || name == "JetSyncList" -> fields else -> fail unsupported("SyncList", span) else -> fail unsupported("SyncList", span) }
