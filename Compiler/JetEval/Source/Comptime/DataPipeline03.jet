    plot_variant(value, "JetDataPlotAggregate", span)? == { "None" -> JetDataPlotAggregate.None; "Count" -> JetDataPlotAggregate.Count; "Sum" -> JetDataPlotAggregate.Sum; "Mean" -> JetDataPlotAggregate.Mean; "Min" -> JetDataPlotAggregate.Min; "Max" -> JetDataPlotAggregate.Max; _ -> { fail unsupported("unknown JetDataPlotAggregate variant", span) } }
}
