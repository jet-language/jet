// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4460
fn plot_facet(value: CtValue, span: Span) -> JetDataPlotFacet Diagnostic! {
    field := plot_field(plot_struct_field(value, "field") ?? { fail unsupported("plot facet is missing field", span) }, span)?
    kind := plot_variant(plot_struct_field(value, "kind") ?? { fail unsupported("plot facet is missing kind", span) }, "JetDataPlotFacetKind", span)? == {
        "Row" -> JetDataPlotFacetKind.Row; "Column" -> JetDataPlotFacetKind.Column; _ -> { fail unsupported("unknown JetDataPlotFacetKind", span) }
    }
    title := if item := plot_struct_field(value, "title") { plot_string(item, "plot facet title", span)? } else { "" }
    JetDataPlotFacet { field: ^field, kind, title: ^title, columns: plot_optional_int(value, "columns", 0, span)?, rows: plot_optional_int(value, "rows", 0, span)? }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4489
fn plot_layer(value: CtValue, span: Span) -> JetDataPlotLayer Diagnostic! {
    name := plot_string(plot_struct_field(value, "name") ?? { fail unsupported("plot layer is missing name", span) }, "plot layer name", span)?
    mark := plot_mark(plot_struct_field(value, "mark") ?? { fail unsupported("plot layer is missing mark", span) }, span)?
    encodings := [JetDataPlotEncoding]()
    plot_struct_field(value, "encodings") == {
        Val(CtValue.List(values)) -> { for item in values { encodings.push(plot_encoding(item, span)?) } }
        Val(_) -> { fail unsupported("plot layer encodings must be a list", span) }
        None -> {}
    }
    transforms := [JetDataPlotTransform]()
    plot_struct_field(value, "transforms") == {
        Val(CtValue.List(values)) -> { for item in values { transforms.push(plot_transform(item, span)?) } }
        Val(_) -> { fail unsupported("plot layer transforms must be a list", span) }
