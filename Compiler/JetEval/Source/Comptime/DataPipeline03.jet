// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5060
fn plot_rows_fields(arg0_ty: Type?, structs: [String:StructDef], rows: [CtValue]) -> [JetDataPlotField] {
    if row := rows.first() {
        if row == { CtValue.Struct { .. } -> true; _ -> false } {
            return (row == { CtValue.Struct { fields, .. } -> fields }).iter().map(fn(name, value) { JetDataPlotField.new(name, ct_value_type_name(value)) }).collect<[JetDataPlotField]>()
        }
    }
    if elem_ty := arg0_ty.and_then(data_schema_elem_ty) {
        if definition := elem_ty.base_name().and_then(fn(name) { structs.get(name) }) {
            return definition.fields.iter().map(fn(field) { JetDataPlotField.new(field.name.clone(), field.ty.name()) }).collect<[JetDataPlotField]>()
        }
        return [JetDataPlotField.new("value", elem_ty.name())]
    }
    rows.first().map(fn(value) { [JetDataPlotField.new("value", ct_value_type_name(value))] }).unwrap_or_default()
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5094
fn plot_error_value(error: JetDataPlotError) -> CtValue {
    optional_int := fn(value: I64?) { value.map(fn(value) { CtValue.Present(Box.new(CtValue.Int(value))) }).unwrap_or_else(fn() { CtValue.absent(Type.Int) }) }
    ct_struct("DataError", [("kind", plot_enum_value("DataErrorKind", "{error.kind:?}")), ("operation", CtValue.Str(error.operation.clone())),
        ("row", CtValue.absent(Type.Int)), ("column", CtValue.absent(Type.Int)), ("index", optional_int(error.index)), ("reason", CtValue.Str(error.to_string())),
        ("cause", CtValue.absent(Type.Named("EncodingError")))])
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5117
fn plot_result<T>(result: T JetDataPlotError!, to_value: fn(T) -> CtValue) -> CtValue {
    value := result catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
    CtValue.Present(Box.new(to_value(^value)))
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5127
fn plot_from_rows(rows: CtValue, arg0_ty: Type?, structs: [String:StructDef], span: Span) -> JetDataPlot<CtValue> Diagnostic! {
    values := expect_list(rows, "plot", span)?.clone()
    fields := plot_rows_fields(arg0_ty, structs, values)
    row_type := arg0_ty.and_then(data_schema_elem_ty).map(fn(ty) { ty.name() }).or_else(fn() { values.first().map(ct_value_type_name) }).unwrap_or_else(fn() { "Value" })
    identity := "data.list:{row_type}"
    schema := JetDataPlotSchema.new(identity.clone(), row_type.clone(), fields.clone())
    source := JetDataPlotSourceFacts.new(identity.clone(), identity.clone(), identity.clone(), row_type, I64.try_from(values.len()) catch { _ -> I64.MAX }, identity, "comptime:data.list")
    plot := JetDataPlot.from_rows_with_limits(^values, ^source, ^schema, data_plot_rt.jet_std.DataLimits.safe()) catch { error -> fail unsupported(error.to_string(), span) }
    for field in fields {
        name := field.name.clone()
        plot = plot.bind_column(jet_data_plot_column(^field, fn(row) {
            value := if name == "value" { Val(row) } else { query_row_field(row, name) }
            value.map(plot_value).unwrap_or(JetDataPlotValue.Null)
        })) catch { error -> fail unsupported(error.to_string(), span) }
    }
    ^plot
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5187
type SchemaRow = fn(String) -> ([String], [(String, Type)])?
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5190
fn plot_static_call(state: &DataPipelineState, method: String, argv: [CtValue], arg0_ty: Type?, structs: [String:StructDef], span: Span) -> CtValue Diagnostic! {
    one := fn(what: String) -> CtValue Diagnostic! { argv.first() ?? { fail unsupported("`data.{method}()`: missing {what}", span) } }
    method == {
        "plot" -> { plot := plot_from_rows(one("rows")?, arg0_ty, structs, span)?; CtValue.Present(Box.new(store_plot(&state, ^plot))) }
        "inspect" -> { plot := clone_plot(state, one("plot")?, span)?; plot_result(plot.inspect(), plot_inspection_value) }
        "inspect_json" -> { plot := clone_plot(state, one("plot")?, span)?; plot_result(plot.inspect_json(), CtValue.Str) }
        "text" -> { plot := clone_plot(state, one("plot")?, span)?; plot_result(plot.text(), CtValue.Str) }
        "svg" -> { plot := clone_plot(state, one("plot")?, span)?; plot_result(plot.svg(), CtValue.Str) }
        "show" -> { plot := clone_plot(state, one("plot")?, span)?; plot_result(plot.show(), plot_render_value) }
        "render" -> {
            plot := clone_plot(state, one("plot")?, span)?
            backend := plot_variant(argv.get(1) ?? { fail unsupported("`data.render()`: missing backend", span) }, "JetDataPlotBackend", span)? == {
                "Terminal" -> JetDataPlotBackend.Terminal; "Browser" -> JetDataPlotBackend.Browser; "Native" -> JetDataPlotBackend.Native; "Export" -> JetDataPlotBackend.Export
                _ -> { fail unsupported("unknown JetDataPlotBackend variant", span) }
            }
            plot_result(plot.render(backend), plot_render_value)
        }
        _ -> { fail unsupported("`data.{method}()`", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5248
fn eval_data_plot_method(state: &DataPipelineState, recv: CtValue, method: String, argv: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { CtValue.Struct { type_name, .. } -> type_name == "JetDataPlot"; _ -> false }) { return None }
    Val((fn() -> CtValue Diagnostic! {
        plot := clone_plot(state, recv, span)?
        method == {
            "line" -> replace_plot(&state, recv, plot.line(), span)?
            "bar" -> replace_plot(&state, recv, plot.bar(), span)?
            "point" -> replace_plot(&state, recv, plot.point(), span)?
            "mark" -> {
                mark := plot_mark(argv.first() ?? { fail unsupported("plot.mark() needs a mark", span) }, span)?
                replace_plot(&state, recv, plot.mark(mark), span)?
            }
            "x" -> {
                column := plot_column(argv.first() ?? { fail unsupported("plot.x() needs a column", span) }, span)?
                next := plot.x(^column) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "y" -> {
                column := plot_column(argv.first() ?? { fail unsupported("plot.y() needs a column", span) }, span)?
                aggregate := plot_aggregate(argv.get(1) ?? { fail unsupported("plot.y() needs an aggregate", span) }, span)?
                next := plot.y(^column, aggregate) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "color" | "size" | "text" | "text_channel" | "detail" -> {
                column := plot_column(argv.first() ?? { fail unsupported("plot channel method needs a column", span) }, span)?
                next := (method == { "color" -> plot.color(^column); "size" -> plot.size(^column); "text" | "text_channel" -> plot.text_channel(^column); "detail" -> plot.detail(^column); _ -> unreachable("plot channel method set is closed") })
                    catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "encode" -> {
                channel := plot_channel(argv.first() ?? { fail unsupported("plot.encode() needs a channel", span) }, span)?
                column := plot_column(argv.get(1) ?? { fail unsupported("plot.encode() needs a column", span) }, span)?
                aggregate := plot_aggregate(argv.get(2) ?? { fail unsupported("plot.encode() needs an aggregate", span) }, span)?
                next := plot.encode(channel, ^column, aggregate) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "with_transform" -> {
                transform := plot_transform(argv.first() ?? { fail unsupported("plot.with_transform() needs a transform", span) }, span)?
                next := plot.with_transform(^transform) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "with_scale" -> {
                scale := plot_scale(argv.first() ?? { fail unsupported("plot.with_scale() needs a scale", span) }, span)?
                next := plot.with_scale(^scale) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "with_axis" -> {
                axis := plot_axis(argv.first() ?? { fail unsupported("plot.with_axis() needs an axis", span) }, span)?
                next := plot.with_axis(^axis) catch { error -> return CtValue.failed(Box.new(plot_error_value(error))) }
                replace_plot(&state, recv, ^next, span)?
            }
            "with_legend" -> {
                legend := plot_legend(argv.first() ?? { fail unsupported("plot.with_legend() needs a legend", span) }, span)?
