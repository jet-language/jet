// GATE #4494: plot/loader calls marshal into the canonical native DataFlow/DataPlot kernels.

// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3710
fn eval_data_loader_method(interp: &Interp, recv: CtValue, method: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { CtValue.Struct { type_name, .. } -> type_name == "DataLoader"; _ -> false }) { return None }
    id := data_loader_state_id(interp.data_pipeline, recv, span) catch { error -> return Val(fail error) }
    slot := interp.data_pipeline.loaders.get_mut(id - 1).and_then(fn(value) { value.take() }).expect("loader identity checked")
    result := (fn() -> CtValue Diagnostic! {
        method == {
            "status" -> data_kernel_status_value(flow.status(slot.state))
            "source_identity" -> data_kernel_source_value(slot.state.source)
            "authority" | "authority_of" -> data_kernel_authority_value(slot.state.authority)
            "ready" -> CtValue.Bool(flow.ready(slot.state))
            "needs_refresh" -> CtValue.Bool(flow.needs_refresh(slot.state))
            "snapshot_reusable" -> {
                snapshot := args.first() ?? { fail unsupported("`data.loader.snapshot_reusable()` needs a snapshot", span) }
                CtValue.Bool(data_snapshot_reusable_value(recv, snapshot) ?? { fail unsupported("`snapshot_reusable()` needs a DataSnapshot", span) })
            }
            "bind" -> {
                payload := args.first() == {
                    Val(CtValue.Bytes(bytes)) -> bytes.clone()
                    Val(CtValue.List(values)) -> {
                        bytes := [U8]()
                        for value in values { bytes.push(value == { CtValue.Int(byte) if byte >= 0 && byte <= 255 -> byte as U8; _ -> { fail unsupported("`DataLoader.bind()` needs byte values", span) } }) }
                        ^bytes
                    }
                    _ -> { fail unsupported("`DataLoader.bind()` needs byte values", span) }
                }
                flow.bind(&slot.state, ^payload) catch { error -> { flow.fail(&slot.state, error); return data_loader_kernel_failure(^error) } }
                CtValue.Present(Box.new(CtValue.Unit))
            }
            "bind_text" -> {
                payload := args.first() == { Val(CtValue.Str(value)) -> value.as_bytes().to_vec(); _ -> { fail unsupported("`DataLoader.bind_text()` needs String", span) } }
                flow.bind(&slot.state, ^payload) catch { error -> { flow.fail(&slot.state, error); return data_loader_kernel_failure(^error) } }
                CtValue.Present(Box.new(CtValue.Unit))
            }
            "cancel" -> { flow.cancel(&slot.state); CtValue.Unit }
            "offline" -> {
                enabled := args.first() == { Val(CtValue.Bool(value)) -> value; _ -> { fail unsupported("`DataLoader.offline()` needs Bool", span) } }
                flow.set_offline(&slot.state, enabled); CtValue.Unit
            }
            "invalidate" -> {
                cause := args.first() == {
                    Val(CtValue.Enum { type_name, variant, .. }) if type_name == "DataInvalidationCause" -> variant == {
                        "NoCause" -> flow.InvalidationCause.NoCause; "Loader" -> flow.InvalidationCause.Loader; "Input" -> flow.InvalidationCause.Input
                        "ArchiveMember" -> flow.InvalidationCause.ArchiveMember; "Parameters" -> flow.InvalidationCause.Parameters; "Credential" -> flow.InvalidationCause.Credential
                        "Capability" -> flow.InvalidationCause.Capability; "Manual" -> flow.InvalidationCause.Manual
                        _ -> { fail unsupported("`DataLoader.invalidate()` needs DataInvalidationCause", span) }
                    }
                    _ -> { fail unsupported("`DataLoader.invalidate()` needs DataInvalidationCause", span) }
                }
                flow.invalidate(&slot.state, cause); CtValue.Unit
            }
            "stream" -> {
                if slot.state.cancelled {
                    error := flow.KernelError { kind: flow.ErrorKind.State, operation: "data.loader.stream", reason: "loader was cancelled" }
                    flow.fail(&slot.state, error); return data_loader_kernel_failure(^error)
                }
                flow.validate_loader(slot.state) catch { error -> { flow.fail(&slot.state, error); return data_loader_kernel_failure(^error) } }
                flow.validate_limits(slot.state.limits) catch { error -> { flow.fail(&slot.state, error); return data_loader_kernel_failure(^error) } }
                rows := data_stream_rows(slot, &interp, span) catch { error -> { data_loader_fail_value(&slot, error, "data.loader.stream"); return ^error } }
                size := slot.state.payload.map_or(0, fn(bytes) { bytes.len() })
                bytes := I64.try_from(size) catch { _ -> I64.MAX }
                slot.state.status.buffered_bytes = bytes
                slot.state.status.backpressure = bytes > slot.state.limits.buffer_bytes
                CtValue.Present(Box.new(store_data_stream(&interp.data_pipeline, ComptimeStream { rows: ^rows, cursor: 0, cancelled: false, row_ty: slot.decode_ty.map(data_stream_row_type) })))
            }
            "snapshot" -> data_snapshot_dynamic(&slot, &interp, span) catch { error -> ^error }
            _ -> { fail unsupported("`DataLoader.{method}()` is not a registered operation", span) }
        }
    })()
    interp.data_pipeline.loaders[id - 1] = Val(^slot)
    Val(result)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3907
fn eval_data_stream_method(interp: &Interp, recv: CtValue, method: String, _args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { CtValue.Struct { type_name, .. } -> type_name == "DataStream"; _ -> false }) { return None }
    id := data_stream_state_id(interp.data_pipeline, recv, span) catch { error -> return Val(fail error) }
    stream := interp.data_pipeline.streams.get_mut(id - 1).and_then(fn(value) { value.take() }).expect("stream identity checked")
    result := (fn() -> CtValue Diagnostic! {
        method == {
            "next" -> data_stream_next(&stream)
            "collect" -> {
                if stream.cancelled { data_loader_failure("State", "data.stream.collect", "stream was cancelled") }
                else { rows := stream.rows[stream.cursor..].to_vec(); stream.cursor = stream.rows.len(); CtValue.Present(Box.new(CtValue.List(^rows))) }
            }
            "cancel" -> { stream.cancelled = true; CtValue.Unit }
            _ -> { fail unsupported("`DataStream.{method}()` is not a registered operation", span) }
        }
    })()
    interp.data_pipeline.streams[id - 1] = Val(^stream)
    Val(result)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3955
fn ct_value_type_name(v: CtValue) -> String {
    v == {
        CtValue.Int(_) | CtValue.BigInt(_) -> "Int"; CtValue.Float(value) -> value.jet_type().name()
        CtValue.Bool(_) -> "Bool"; CtValue.Char(_) -> "Char"; CtValue.Str(_) -> "String"; CtValue.Bytes(_) -> "[U8]"
        CtValue.List(_) -> "List"; CtValue.Map(_) -> "Map"; CtValue.Struct { type_name, .. } | CtValue.Enum { type_name, .. } -> type_name.clone()
        CtValue.Present(inner) -> "{ct_value_type_name(inner)}?"; CtValue.Failed(CtReport.Clean(ty)) -> "{ty.name()}?"
        CtValue.Failed(CtReport.Told(_)) -> "Result"; CtValue.Unit -> "()"; CtValue.Closure(_) -> "Fn"
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3978
fn plot_handle(id: USize) -> CtValue { ct_struct("JetDataPlot", [("id", CtValue.Int(I64.try_from(id) catch { _ -> I64.MAX }))]) }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:3985
// GATE #4483: positive selected-target slot IDs with checked narrowing.
fn plot_handle_id(state: DataPipelineState, value: CtValue, span: Span) -> USize Diagnostic! {
    raw := struct_field(value, "JetDataPlot", "id") == { Val(CtValue.Int(id)) -> id; _ -> { fail unsupported("`JetDataPlot` handle is malformed", span) } }
    if raw <= 0 { fail unsupported("`JetDataPlot` handle is invalid", span) }
    id := USize.try_from(raw) catch { _ -> fail unsupported("`JetDataPlot` handle is invalid", span) }
    _ :: state.plots.get(id - 1).and_then(fn(value) { value.as_ref() }) ?? { fail unsupported("`JetDataPlot` handle is stale", span) }
    id
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4006
fn store_plot(state: &DataPipelineState, plot: JetDataPlot<CtValue>) -> CtValue { state.plots.push(Val(^plot)); plot_handle(state.plots.len()) }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4014
fn replace_plot(state: &DataPipelineState, handle: CtValue, plot: JetDataPlot<CtValue>, span: Span) -> CtValue Diagnostic! {
    id := plot_handle_id(state, handle, span)?
    slot := state.plots.get_mut(id - 1).and_then(fn(value) { value.as_mut() }) ?? { fail unsupported("`JetDataPlot` handle is stale", span) }
    slot = ^plot
    handle.clone()
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4030
fn clone_plot(state: DataPipelineState, handle: CtValue, span: Span) -> JetDataPlot<CtValue> Diagnostic! {
    id := plot_handle_id(state, handle, span)?
    state.plots.get(id - 1).and_then(fn(value) { value.as_ref() }).cloned() ?? { fail unsupported("`JetDataPlot` handle is stale", span) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4044
fn plot_value(value: CtValue) -> JetDataPlotValue {
    value == {
        CtValue.Int(value) -> JetDataPlotValue.Integer(value)
        CtValue.BigInt(value) -> { number := I64.from_str(value.to_string_rep()) catch { _ -> return JetDataPlotValue.Text(value.to_string_rep()) }; JetDataPlotValue.Integer(number) }
        CtValue.Float(value) -> JetDataPlotValue.Number(value.as_f64()); CtValue.Bool(value) -> JetDataPlotValue.Boolean(value)
        CtValue.Char(value) -> JetDataPlotValue.Text(value.to_string()); CtValue.Str(value) -> JetDataPlotValue.Text(value.clone())
        CtValue.Present(value) -> plot_value(value); CtValue.Failed(_) | CtValue.Unit -> JetDataPlotValue.Null
        _ -> JetDataPlotValue.Text(query_cell_text(value))
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4063
fn plot_variant(value: CtValue, expected: String, span: Span) -> String Diagnostic! {
    value == {
        CtValue.Enum { type_name, variant, .. } if type_name.is_empty() || type_name == expected || type_name.ends_with(expected) -> {
            text := variant.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(variant) // #4303
            text
        }
        _ -> { fail unsupported("expected `{expected}` option", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4085
fn plot_enum_arg(value: CtValue, name: String, index: USize) -> CtValue? {
    value == {
        CtValue.Enum { args, .. } -> args.iter().find_map(fn(label, value) { if label == Val(name) { Val(value) } else { None } }).or_else(fn() { args.get(index).map(fn(_, value) { value }) })
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4098
fn plot_string(value: CtValue, what: String, span: Span) -> String Diagnostic! { value == { CtValue.Str(value) -> value.clone(); _ -> { fail unsupported("{what} must be String", span) } } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4105
fn plot_bool(value: CtValue, what: String, span: Span) -> Bool Diagnostic! { value == { CtValue.Bool(value) -> value; _ -> { fail unsupported("{what} must be Bool", span) } } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4112
fn plot_int(value: CtValue, what: String, span: Span) -> I64 Diagnostic! { value == { CtValue.Int(value) -> value; _ -> { fail unsupported("{what} must be Int", span) } } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4119
fn plot_float(value: CtValue, what: String, span: Span) -> F64 Diagnostic! { value == { CtValue.Float(value) -> value.as_f64(); CtValue.Int(value) -> value as F64; _ -> { fail unsupported("{what} must be Float", span) } } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4127
fn plot_field(value: CtValue, span: Span) -> JetDataPlotField Diagnostic! {
    if field := struct_field(value, "JetDataPlotColumn", "field") { return plot_field(field, span)? }
    id := struct_field(value, "JetDataPlotField", "id").and_then(fn(value) { value == { CtValue.Str(_) -> Val(query_cell_text(value)); _ -> None } })
    name := plot_string(struct_field(value, "JetDataPlotField", "name") ?? { fail unsupported("plot column is missing field.name", span) }, "plot field name", span)?
    type_name := plot_string(struct_field(value, "JetDataPlotField", "type_name") ?? { fail unsupported("plot column is missing field.type_name", span) }, "plot field type_name", span)?
    id == { Val(id) -> JetDataPlotField.with_id(id, name, type_name); None -> JetDataPlotField.new(name, type_name) }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4145
fn plot_column(value: CtValue, span: Span) -> JetDataPlotColumn<CtValue> Diagnostic! {
    field := plot_field(value, span)?
    name := field.name.clone()
    jet_data_plot_column(^field, fn(row) { query_row_field(row, name).map(plot_value).unwrap_or(JetDataPlotValue.Null) })
}
