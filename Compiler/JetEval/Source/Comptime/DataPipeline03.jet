// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:5461
fn schema_columns_for_type(elem_ty: Type, expand_struct: Bool, row: SchemaRow) -> [CtValue]? {
    if !expand_struct { return Val([data_column("value", elem_ty.name())]) }
    struct_name := elem_ty.base_name() ?? { return Val([data_column("value", elem_ty.name())]) }
    (type_params, fields) := row(struct_name) ?? { return Val([data_column("value", elem_ty.name())]) }
    args := elem_ty == { Type.Apply { args, .. } -> args; Type.Named(_) -> []; _ -> { return None } }
    if type_params.len() != args.len() { return None }
    subst := type_params.into_iter().zip(args.iter().cloned()).collect<[String:Type]>()
    Val(fields.iter().map(fn(name, field_ty) { checked := jet_foundation.Generics.substitute_type(field_ty, subst); data_column(name, checked.name()) }).collect<[CtValue]>())
}
