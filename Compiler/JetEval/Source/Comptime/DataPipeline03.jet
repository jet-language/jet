    plot_variant(value, "JetDataPlotFilterOp", span)? == { "Equal" -> JetDataPlotFilterOp.Equal; "NotEqual" -> JetDataPlotFilterOp.NotEqual; "Less" -> JetDataPlotFilterOp.Less; "LessEqual" -> JetDataPlotFilterOp.LessEqual; "Greater" -> JetDataPlotFilterOp.Greater; "GreaterEqual" -> JetDataPlotFilterOp.GreaterEqual; _ -> { fail unsupported("unknown JetDataPlotFilterOp variant", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4257
fn plot_scale_kind(value: CtValue, span: Span) -> JetDataPlotScaleKind Diagnostic! {
    plot_variant(value, "JetDataPlotScaleKind", span)? == { "Linear" -> JetDataPlotScaleKind.Linear; "Log" -> JetDataPlotScaleKind.Log; "Band" -> JetDataPlotScaleKind.Band; "Point" -> JetDataPlotScaleKind.Point; _ -> { fail unsupported("unknown JetDataPlotScaleKind variant", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4270
fn plot_domain(value: CtValue, span: Span) -> JetDataPlotDomain Diagnostic! {
    plot_variant(value, "JetDataPlotDomain", span)? == {
        "Auto" -> JetDataPlotDomain.Auto
        "Numeric" -> {
            min := plot_float(plot_enum_arg(value, "min", 0) ?? { fail unsupported("numeric plot domain is missing min", span) }, "plot domain min", span)?
            max := plot_float(plot_enum_arg(value, "max", 1) ?? { fail unsupported("numeric plot domain is missing max", span) }, "plot domain max", span)?
            JetDataPlotDomain.Numeric { min, max }
        }
        "Categories" -> {
            raw := plot_enum_arg(value, "values", 0) ?? { fail unsupported("category plot domain is missing values", span) }
            values := raw == { CtValue.List(values) -> values; _ -> { fail unsupported("plot domain categories must be a list", span) } }
            categories := [String]()
            for item in values { categories.push(plot_string(item, "plot domain category", span)?) }
            JetDataPlotDomain.Categories(^categories)
        }
        _ -> { fail unsupported("unknown JetDataPlotDomain variant", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4302
fn plot_encoding(value: CtValue, span: Span) -> JetDataPlotEncoding Diagnostic! {
    channel := plot_channel(plot_struct_field(value, "channel") ?? { fail unsupported("plot encoding is missing channel", span) }, span)?
    field := plot_field(plot_struct_field(value, "field") ?? { fail unsupported("plot encoding is missing field", span) }, span)?
    aggregate := plot_aggregate(plot_struct_field(value, "aggregate") ?? { fail unsupported("plot encoding is missing aggregate", span) }, span)?
    JetDataPlotEncoding.new(channel, ^field, aggregate)
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4320
fn plot_transform(value: CtValue, span: Span) -> JetDataPlotTransform Diagnostic! {
    plot_variant(value, "JetDataPlotTransform", span)? == {
        "Filter" -> {
            field := plot_field(plot_enum_arg(value, "field", 0) ?? { fail unsupported("plot filter is missing field", span) }, span)?
            op := plot_filter_op(plot_enum_arg(value, "op", 1) ?? { fail unsupported("plot filter is missing op", span) }, span)?
            filter_value := plot_value(plot_enum_arg(value, "value", 2) ?? { fail unsupported("plot filter is missing value", span) })
            JetDataPlotTransform.Filter { field: ^field, op, value: ^filter_value }
        }
        "Sort" -> {
            field := plot_field(plot_enum_arg(value, "field", 0) ?? { fail unsupported("plot sort is missing field", span) }, span)?
            descending := if item := plot_enum_arg(value, "descending", 1) { plot_bool(item, "plot sort descending", span)? } else { false }
            JetDataPlotTransform.Sort { field: ^field, descending }
        }
        "Bin" -> {
            field := plot_field(plot_enum_arg(value, "field", 0) ?? { fail unsupported("plot bin is missing field", span) }, span)?
            step := plot_float(plot_enum_arg(value, "step", 1) ?? { fail unsupported("plot bin is missing step", span) }, "plot bin step", span)?
            JetDataPlotTransform.Bin { field: ^field, step }
        }
        "Aggregate" -> {
            raw := plot_enum_arg(value, "group_by", 0) ?? { fail unsupported("plot aggregate is missing group_by", span) }
            values := raw == { CtValue.List(values) -> values; _ -> { fail unsupported("plot aggregate group_by must be a list", span) } }
            group_by := [JetDataPlotField]()
            for item in values { group_by.push(plot_field(item, span)?) }
            field := plot_field(plot_enum_arg(value, "field", 1) ?? { fail unsupported("plot aggregate is missing field", span) }, span)?
            aggregate := plot_aggregate(plot_enum_arg(value, "aggregate", 2) ?? { fail unsupported("plot aggregate is missing aggregate", span) }, span)?
            JetDataPlotTransform.Aggregate { group_by: ^group_by, field: ^field, aggregate }
        }
        _ -> { fail unsupported("unknown JetDataPlotTransform variant", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4389
fn plot_scale(value: CtValue, span: Span) -> JetDataPlotScale Diagnostic! {
    channel := plot_channel(plot_struct_field(value, "channel") ?? { fail unsupported("plot scale is missing channel", span) }, span)?
    kind := plot_scale_kind(plot_struct_field(value, "kind") ?? { fail unsupported("plot scale is missing kind", span) }, span)?
    domain := plot_domain(plot_struct_field(value, "domain") ?? { fail unsupported("plot scale is missing domain", span) }, span)?
    JetDataPlotScale { channel, kind, domain: ^domain, clamp: plot_optional_bool(value, "clamp", false, span)?, reverse: plot_optional_bool(value, "reverse", false, span)? }
}
