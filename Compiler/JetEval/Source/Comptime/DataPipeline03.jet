fn plot_optional_bool(value: CtValue, name: String, default: Bool, span: Span) -> Bool Diagnostic! { if item := plot_struct_field(value, name) { plot_bool(item, "plot {name}", span)? } else { default } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4178
fn plot_optional_int(value: CtValue, name: String, default: I64, span: Span) -> I64 Diagnostic! { if item := plot_struct_field(value, name) { plot_int(item, "plot {name}", span)? } else { default } }
// Rust: crates/jet-comptime/src/Comptime/DataPipeline.rs:4189
fn plot_optional_float(value: CtValue, name: String, default: F64, span: Span) -> F64 Diagnostic! { if item := plot_struct_field(value, name) { plot_float(item, "plot {name}", span)? } else { default } }
