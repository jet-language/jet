// Rust: crates/jet-comptime/src/Comptime/Methods.rs:55
pub fn apply_pool(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> ((CtValue, CtValue?) Diagnostic!)? {
    if !Pool.is_method(recv, method) -> return None
    Val((fn() -> (CtValue, CtValue?) Diagnostic! {
        outcome :: Pool.apply(recv, method, args, None, span)!
        (outcome.value, outcome.updated)
    })())
}
