    jet_http_body_json_text_defaulted(body, limit).map_err(fn(error) { http_error_to_ct(error) })
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:588
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:654
pub fn http_project_json_decode_error(result: CtValue) -> CtValue {
    result := if result == { .Present(value) -> Ok(^value); .Failed(_) -> Err([] as [FieldError]); value -> return ^value }
    if jet_http_project_json_decode_error(result) == {
        Ok(value) -> CtValue.Present(^value)
        Err(error) -> CtValue.Failed(CtReport.Told(http_error_to_ct(error)))
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:601
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:657
pub fn http_error_response(error: CtValue) -> CtValue Err! {
    if error != .Enum{type_name, variant, args} -> return Err("MIR HTTP handler error is not an enum carrier")
    if type_name != "HTTPError" -> return Err("MIR HTTP handler error is not HTTPError")
    payload := 0
    text: String? := None
    for (_, value) in args {
        if value == {
            .Int(value) -> { payload = value }
            .Str(value) -> { text = Val(^value) }
            .Enum{type_name, variant, args} if type_name == "HTTPOperation" && args.is_empty() -> {
                payload = if variant == { "ClientConnect" -> 0; "ServerBind" -> 1; "ServeListener" -> 2; else -> return Err("MIR HTTP operation error has an unknown variant") }
            }
            else -> return Err("MIR HTTP handler error has an invalid payload")
        }
    }
    error := jet_http_error_from_surface_name(variant, payload, ^text) ?? return Err("MIR HTTP handler error has an unknown variant")
    http_response_to_ct(jet_http_srv_error_response(error)).map_err(fn(_) { "canonical HTTP error response could not be materialized" })
}
