// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:734
pub fn live_query_with(footprint: String, initial: String, rerun: fn() -> String Err!) -> CtValue {
    live_to_ct(app_live_query(footprint, initial, rerun))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:741
pub fn apply(method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    one := fn(i: USize) -> &CtValue Diagnostic! { args.get(i).ok_or_else(fn() { unsupported("app.{method} arg {i}", span) }) }
    if method == {
        "live" -> {
            footprint := if one(0)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("footprint", span)) }
            initial := if one(1)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("initial", span)) }
            Ok(live_to_ct(app_live(footprint, initial)))
        }
        "subscribe" -> {
            source := if one(0)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("source", span)) }
            Ok(live_to_ct(app_subscribe(source)))
        }
        "invalidate" -> {
            footprint := if one(0)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("footprint", span)) }
            Ok(CtValue.Int(app_invalidate(footprint)))
        }
        "transact_invalidate" -> {
            write_set := if one(0)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("write_set", span)) }
            Ok(CtValue.Int(app_transact_invalidate(write_set)))
        }
        "signal_push" -> {
            payload := if one(1)? == { .Str(s) -> s.clone(); else -> return Err(unsupported("payload", span)) }
            Ok(live_to_ct(app_signal_push(ct_to_live(one(0)?, span)?, payload)))
        }
        "live_get" -> Ok(CtValue.Str(app_live_get(ct_to_live(one(0)?, span)?)))
        "live_show" -> Ok(CtValue.Str(app_live_show(ct_to_live(one(0)?, span)?)))
        "live_stats" -> Ok(CtValue.Str(app_live_stats()))
        else -> Err(unsupported("`app.{method}()`", span))
    }
}
