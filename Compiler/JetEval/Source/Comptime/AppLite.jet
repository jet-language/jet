// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:665
fn live_to_ct(q: &AppLiveQuery) -> CtValue {
    (id, footprint, value, generation, active, error) := app_live_query_parts(q)
    CtValue.Struct{type_name: "LiveQuery", fields: [
        ("id", CtValue.Int(id.min(I64.MAX as U64) as I64)), ("footprint", CtValue.Str(footprint)), ("value", CtValue.Str(value)),
        ("generation", CtValue.Int(generation.min(I64.MAX as U64) as I64)), ("active", CtValue.Bool(active)), ("error", CtValue.Str(error))]}
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:686
fn ct_to_live(v: &CtValue, span: Span) -> AppLiveQuery Diagnostic! {
    if v != .Struct{type_name, fields} -> return Err(unsupported("LiveQuery", span))
    if type_name != "LiveQuery" && type_name != "JetLiveQuery" -> return Err(unsupported("LiveQuery", span))
    field := fn(name: String) -> &CtValue Diagnostic! {
        fields.iter().find(fn(entry) { (n, _) := entry; n == name }).map(fn(entry) { (_, v) := entry; v }).ok_or_else(fn() { unsupported("LiveQuery field", span) })
    }
    footprint := if field("footprint")? == { .Str(s) -> s.clone(); else -> return Err(unsupported("footprint", span)) }
    active := if field("active")? == { .Bool(b) -> b; else -> return Err(unsupported("active", span)) }
    error := if field("error")? == { .Str(s) -> s.clone(); else -> return Err(unsupported("error", span)) }
    if !active && error.is_empty() -> return Err(unsupported("LiveQuery error", span))
    id := if field("id")? == { .Int(n) if n >= 0 -> n as U64; else -> return Err(unsupported("id", span)) }
    value := if field("value")? == { .Str(s) -> s.clone(); else -> return Err(unsupported("value", span)) }
    generation := if field("generation")? == { .Int(n) if n >= 0 -> n as U64; else -> return Err(unsupported("generation", span)) }
    app_live_query_from_parts(id, footprint, value, generation, active, error).ok_or_else(fn() { unsupported("footprint", span) })
}

