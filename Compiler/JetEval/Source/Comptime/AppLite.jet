fn tree_text(tree: &DataTree) -> String? {
    if tree == {
        .Text(value) | .TypedText(value) | .Number(value) -> Val(value.clone())
        .Int(value) | .Float(value) | .Bool(value) -> Val(value.to_string())
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1077
fn tree_to_untyped(tree: &DataTree, span: Span) -> CtValue Err! {
    if tree == {
        .Null -> Ok(CtValue.Unit)
        .Bool(value) -> Ok(CtValue.Bool(value))
        .Int(value) -> Ok(CtValue.Int(value))
        .Float(value) -> Ok(CtValue.Float(CtFloat.f64(value)))
        .Number(value) -> value.parse<I64>().map(fn(n) { CtValue.Int(n) })
            .or_else(fn(_) { value.parse<F64>().map(fn(n) { CtValue.Float(CtFloat.f64(n)) }) }).map_err(fn(_) { "invalid JSON number `{value}`" })
        .TypedText(value) -> { parsed := parse_app_json_tree(value)?; tree_to_untyped(parsed, span) }
        .Text(value) -> Ok(CtValue.Str(value.clone()))
        .Bytes(value) -> Ok(CtValue.Bytes(value.clone()))
        .Array(values) -> {
            out := [CtValue].with_capacity(values.len())
            for value in values { out.push(tree_to_untyped(value, span)?) }
            Ok(CtValue.List(^out))
        }
        .Object(values) -> {
            fields := [(String, CtValue)].with_capacity(values.len())
            for (name, value) in values { fields.push((name.clone(), tree_to_untyped(value, span)?)) }
            Ok(CtValue.Struct{type_name: "RouteObject", fields: ^fields})
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1110
fn binding_type(value: String) -> (String, Bool) {
    if value.strip_suffix('?') == { Val(value) -> (value.to_string(), true); None -> (value.to_string(), false) }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1117
fn binding_ast_type(value: String) -> Type {
    (value, optional) := binding_type(value)
    ty := if value == { "Int" -> Type.Int; "Float" -> Type.Float; "Bool" -> Type.Bool; "String" | "Text" -> Type.String; "Char" -> Type.Char; value -> Type.Named(value.to_string()) }
    if optional -> Type.Option(^ty) else -> ^ty
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1134
fn decode_binding_tree(tree: &DataTree, ty: String, span: Span) -> CtValue Err! {
    (base, optional) := binding_type(ty)
    if optional {
        if tree is .Null -> return Ok(CtValue.absent(binding_ast_type(ty)))
        return decode_binding_tree(tree, base, span).map(fn(value) { CtValue.Present(value) })
    }
    if base == {
        "Int" -> tree_text(tree).and_then(fn(value) { value.parse<I64>().ok() }).map(fn(n) { CtValue.Int(n) }).ok_or_else(fn() { "route input is not a valid Int: {tree:?}" })
        "Float" -> tree_text(tree).and_then(fn(value) { value.parse<F64>().ok() }).map(fn(n) { CtValue.Float(CtFloat.f64(n)) }).ok_or_else(fn() { "route input is not a valid Float: {tree:?}" })
        "Bool" -> tree_text(tree).and_then(fn(value) { if value == { "true" -> Val(true); "false" -> Val(false); else -> None } }).map(fn(b) { CtValue.Bool(b) }).ok_or_else(fn() { "route input is not a valid Bool: {tree:?}" })
        "String" | "Text" -> tree_text(tree).map(fn(s) { CtValue.Str(s) }).ok_or_else(fn() { "route input is not valid Text: {tree:?}" })
        "Char" -> tree_text(tree).and_then(fn(value) { value.chars().next().filter(fn(_) { value.chars().count() == 1 }) }).map(fn(c) { CtValue.Char(c) }).ok_or_else(fn() { "route input is not a valid Char: {tree:?}" })
        else -> tree_to_untyped(tree, span).map(fn(value) { if value == { .Struct{fields, ..} -> CtValue.Struct{type_name: base.clone(), fields: ^fields}; value -> ^value } })
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1181
fn parse_app_json_tree(value: String) -> DataTree Err! { EncodingJson.parse_json(value, true).map_err(fn(error) { error.message }) }
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1187
fn mir_tree_to_ct(tree: &DataTree, ty: &MirType, span: Span) -> CtValue Err! {
    if ty.kind() == {
        .Option(inner) -> {
            if tree is .Null -> Ok(CtValue.absent(mir_to_ast_type(inner)))
            else -> mir_tree_to_ct(tree, inner, span).map(fn(value) { CtValue.Present(value) })
        }
        .Shared(inner) | .Tagged{inner, ..} | .Quantity{base: inner, ..} | .InlineRange{base: inner, ..} -> mir_tree_to_ct(tree, inner, span)
        .Int | .IntN{..} -> decode_binding_tree(tree, "Int", span)
        .Float | .Float32 -> decode_binding_tree(tree, "Float", span)
        .Bool -> decode_binding_tree(tree, "Bool", span)
        .String -> decode_binding_tree(tree, "String", span)
        .Char -> decode_binding_tree(tree, "Char", span)
        .List(inner) | .FixedList{elem: inner, ..} -> {
            if tree != .Array(values) -> return Err("route input is not a list: {tree:?}")
            out := [CtValue].with_capacity(values.len())
            for value in values { out.push(mir_tree_to_ct(value, inner, span)?) }
            Ok(CtValue.List(^out))
        }
        .Map{value: value_ty, ..} -> {
            if tree != .Object(values) -> return Err("route input is not an object: {tree:?}")
            out := [CtKey: CtValue]{} // GATE #4499: exact CtKey equality.
            for (key, value) in values { out.insert(CtKey.Str(key.clone()), mir_tree_to_ct(value, value_ty, span)?) }
            Ok(CtValue.Map(^out))
        }
        .Tuple(fields) -> {
            if tree != .Object(values) -> return Err("route input is not a tuple object: {tree:?}")
            out := [(String, CtValue)].with_capacity(fields.len())
            for (name, field_ty) in fields {
                value := values.iter().find(fn(entry) { (key, _) := entry; key == name }).map(fn(entry) { (_, value) := entry; value }) ?? return Err("route input is missing `{name}`")
                out.push((name.clone(), mir_tree_to_ct(value, field_ty, span)?))
            }
            Ok(CtValue.Struct{type_name: "RouteTuple", fields: ^out})
        }
        .Apply{name, ..} -> {
            value := tree_to_untyped(tree, span)?
            Ok(if value == { .Struct{fields, ..} -> CtValue.Struct{type_name: name.name.clone(), fields: ^fields}; value -> ^value })
        }
        else -> tree_to_untyped(tree, span)
    }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1269
fn decode_route_inputs(trees: &[DataTree], bindings: &[JetAppRouteBinding], types: &[MirType], span: Span) -> [CtValue] Err! {
    if trees.len() != bindings.len() || trees.len() != types.len() -> return Err("app callback received {trees.len()} inputs for {bindings.len()} checked bindings")
    out := [CtValue].with_capacity(trees.len())
    for ((tree, binding), ty) in trees.iter().zip(bindings).zip(types) {
        value := if binding == {
            .Search{scalar: None, fields, ..} -> {
                if tree != .Object(values) -> return Err("route search input is not an object")
                out_fields := [(String, CtValue)].with_capacity(fields.len())
                for field in fields {
                    value := values.iter().find(fn(entry) { (name, _) := entry; name == field.name })
                    decoded := if value == {
                        Val((_, value)) -> decode_binding_tree(value, field.ty, span)?
                        None if !field.required -> CtValue.absent(binding_ast_type(field.ty))
                        None -> return Err("route search input is missing `{field.name}`")
                    }
                    out_fields.push((field.name.clone(), ^decoded))
                }
                CtValue.Struct{type_name: ty.nominal_name().unwrap_or("RouteSearch").to_string(), fields: ^out_fields}
            }
            .Data -> {
                tree := if tree == { .TypedText(value) -> parse_app_json_tree(value)?; tree -> tree.clone() }
                mir_tree_to_ct(tree, ty, span)?
            }
            else -> mir_tree_to_ct(tree, ty, span)?
        }
        out.push(^value)
    }
    Ok(^out)
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1327
fn callback_error(value: CtValue) -> String { if value == { .Failed(report) -> "{report:?}"; value -> "{value:?}" } }
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1334
fn callback_page(value: CtValue) -> JetWebPage Err! {
    value := if value == { .Present(value) -> ^value; value -> ^value }
    if value != .Struct{fields, ..} -> return Err("app page callback did not return WebPage")
    title := fields.iter().find(fn(entry) { (name, _) := entry; name == "title" }).and_then(fn(entry) {
        (_, value) := entry; if value == { .Str(value) -> Val(value.clone()); else -> None }
    }) ?? return Err("app page callback returned WebPage without title")
    body := fields.iter().find(fn(entry) { (name, _) := entry; name == "body" }).and_then(fn(entry) {
        (_, value) := entry; if value == { .Str(value) -> Val(value.clone()); else -> None }
    }) ?? return Err("app page callback returned WebPage without body")
    Ok(JetWebPage{title: title, body: body})
}

use jet_comptime.Comptime.Methods.invoke_standalone_closure
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1361
fn app_page_callback(callback: CtValue, types: [MirType], binding: [JetAppRouteBinding], span: Span) -> JetAppTreeRouteCallback<JetWebPage Err!> {
    arity := types.len()
    JetAppTreeRouteCallback.new(arity, Arc.new(fn(trees) {
        values := decode_route_inputs(trees, binding, types, span)?
        value := invoke_standalone_closure(callback, ^values, span).map_err(fn(error) { "{error:?}" })?
        if value == { .Failed(report) -> Err("{report:?}"); value -> Ok(callback_page(^value)) }
    }))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1382
fn app_boundary_callback(callback: CtValue, span: Span) -> JetAppTreeRouteCallback<JetWebPage Err!> {
    JetAppTreeRouteCallback.new(0, Arc.new(fn(_) {
        value := invoke_standalone_closure(callback, [], span).map_err(fn(error) { "{error:?}" })?
        if value == { .Failed(report) -> Err("{report:?}"); value -> Ok(callback_page(^value)) }
    }))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1399
fn app_loader_callback(callback: CtValue, types: [MirType], binding: [JetAppRouteBinding], span: Span) -> JetAppTreeRouteCallback<String Err!> {
    arity := types.len()
    JetAppTreeRouteCallback.new(arity, Arc.new(fn(trees) {
        values := decode_route_inputs(trees, binding, types, span)?
        value := invoke_standalone_closure(callback, ^values, span).map_err(fn(error) { "{error:?}" })?
        if value == { .Failed(report) -> Err("{report:?}"); .Present(value) -> Ok(Ok(ct_to_json_string(value))); value -> Ok(Ok(ct_to_json_string(value))) }
    }))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1421
fn ct_to_json_string(value: &CtValue) -> String {
    // Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1422
    fn tree(value: &CtValue) -> DataTree {
        if value == {
            .Int(value) -> DataTree.Int(value)
            .Float(value) -> DataTree.Float(value.as_f64())
            .Bool(value) -> DataTree.Bool(value)
            .Char(value) -> DataTree.Text(value.to_string())
            .Str(value) -> DataTree.Text(value.clone())
            .Bytes(value) -> DataTree.Bytes(value.clone())
            .List(values) -> DataTree.Array(values.iter().map(fn(value) { tree(value) }).collect())
            .Map(values) -> {
                keys := values.keys().collect<[CtKey]>()
                keys.sort()
                DataTree.Object(keys.iter().filter_map(fn(key) { if key == { .Str(s) -> Val((s.clone(), tree(values.get(key).expect("sorted key exists")))); else -> None } }).collect())
            }
            .Struct{fields, ..} -> DataTree.Object(fields.iter().map(fn(entry) { (key, value) := entry; (key.clone(), tree(value)) }).collect())
            .Enum{variant, ..} if variant == "Null" -> DataTree.Null
            .Enum{args, ..} -> DataTree.Object(args.iter().filter_map(fn(entry) { (key, value) := entry; key.map(fn(key) { (key.clone(), tree(value)) }) }).collect())
            .Present(value) -> tree(value)
            .Failed(_) | .Unit | .Closure(_) -> DataTree.Null
            .BigInt(value) -> DataTree.Number(value.to_string_rep())
        }
    }
    // Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1461
    fn render(tree: &DataTree) -> String {
        if tree == {
            .Null -> "null"
            .Bool(value) | .Int(value) -> value.to_string()
            .Float(value) -> "{value:?}"
            .Number(value) -> value.clone()
            .TypedText(value) | .Text(value) -> "{value:?}"
            .Bytes(values) -> "[{values.iter().map(fn(value) { value.to_string() }).collect<[String]>().join(",")}]"
            .Array(values) -> "[{values.iter().map(fn(value) { render(value) }).collect<[String]>().join(",")}]"
            .Object(values) -> {
                parts := values.iter().map(fn(entry) { (key, value) := entry; "{key:?}:{render(value)}" }).collect<[String]>().join(",")
                "{{{parts}}}"
            }
        }
    }
    render(tree(value))
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1491
fn app_output_type(value: &MirType?) -> String {
    value := value ?? return "Unit"
    if value.kind() == { .Result{ok, ..} -> ok.canonical_key(); else -> value.canonical_key() }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:1501
pub fn app_method_runtime(handle: &AppHandle, method: String, args: &[CtValue], callback_types: &[MirType], callback_return_type: &MirType?, span: Span) -> AppRuntimeResult Diagnostic! {
    one := fn(index: USize) -> &CtValue Diagnostic! { args.get(index).ok_or_else(fn() { unsupported("app.{method} argument {index}", span) }) }
    wrap_app := fn(value: JetApp) { AppRuntimeResult.App(AppHandle{value: value}) }
    if method == {
        "route" | "page" | "layout" -> {
            path := app_string(one(0)?, "app route path", span)?
            callback := app_callback(one(1)?, span)?
            binding_text := app_string(one(2)?, "app route binding", span)?
            binding := jet_app_route_binding(binding_text)
            callback := app_page_callback(^callback, callback_types.to_vec(), ^binding, span)
            app := if method == {
                "route" -> jet_app_route(handle.value, path, callback, binding_text)
                "page" -> jet_app_page(handle.value, path, callback, binding_text)
                else -> jet_app_layout(handle.value, path, callback, binding_text)
            }
            Ok(wrap_app(^app))
        }
        "loader" -> {
            callback := app_callback(one(0)?, span)?
            binding_text := app_string(args.last() ?? return Err(unsupported("app loader binding", span)), "app loader binding", span)?
            binding := jet_app_route_binding(binding_text)
            callback := app_loader_callback(^callback, callback_types.to_vec(), binding.clone(), span)
            preload := if args.len() == 4 {
                if one(2)? == { .Bool(value) -> value; else -> return Err(unsupported("app loader preload", span)) }
            } else { false }
            data_type := app_output_type(callback_return_type)
            Ok(wrap_app(handle.value.loader_encoded(callback, binding, data_type, preload)))
        }
        "pending" | "not_found" | "error" -> {
            callback := app_boundary_callback(app_callback(one(0)?, span)?, span)
            app := if method == { "pending" -> jet_app_pending(handle.value, callback); "not_found" -> jet_app_not_found(handle.value, callback); else -> jet_app_error(handle.value, callback) }
            Ok(wrap_app(^app))
        }
        "action" | "form" | "data" -> {
            name := app_string(one(0)?, "app server function name", span)?
            callback := app_callback(one(1)?, span)?
            binding := if method == "form" -> app_string(args.get(2) ?? return Err(unsupported("app form binding", span)), "app form binding", span)? else -> String.new()
            invoke := fn(args) -> String Err! {
                value := invoke_standalone_closure(callback, args, span).map_err(fn(error) { "{error:?}" })?
                if value == { .Failed(report) -> Err("{report:?}"); value -> Ok(ct_to_json_string(value)) }
            }
            app := if callback_types.is_empty() {
                action := Arc.new(fn() { invoke([]) })
                if method == { "action" -> jet_app_action(handle.value, name, action); "form" -> jet_app_form(handle.value, name, action, binding); else -> jet_app_data(handle.value, name, action) }
            } else {
                action := if method == "form" {
                    bindings := jet_app_route_binding(binding)
                    types := callback_types.to_vec()
                    Arc.new(fn(body) {
                        tree := parse_app_json_tree(body)?
                        values := decode_route_inputs(std.slice.from_ref(tree), bindings, types, span)?
                        invoke(^values)
                    })
                } else {
                    Arc.new(fn(body) { invoke([CtValue.Str(body.clone())]) })
                }
                if method == { "action" -> jet_app_action(handle.value, name, action); "form" -> jet_app_form(handle.value, name, action, binding); else -> jet_app_data(handle.value, name, action) }
            }
            Ok(wrap_app(^app))
        }
        "mount" -> {
            prefix := app_string(one(0)?, "app mount prefix", span)?
            callback := app_callback(one(1)?, span)?
            app := handle.value.mount(prefix, fn(path) { _ :: invoke_standalone_closure(callback, [CtValue.Str(path.clone())], span) })
            Ok(wrap_app(^app))
        }
        "routes" | "security" | "assets" | "split" | "code_split" | "cache" | "a11y" | "adapter" -> {
            value := app_string(one(0)?, "app setting", span)?
            app := if method == {
                "routes" -> jet_app_routes(handle.value, value)
                "security" -> jet_app_security(handle.value, value)
                "assets" -> jet_app_assets(handle.value, value)
                "split" -> jet_app_split(handle.value, value)
                "code_split" -> jet_app_code_split(handle.value, value)
                "cache" -> jet_app_cache(handle.value, value)
                "a11y" -> jet_app_a11y(handle.value, value)
                else -> jet_app_adapter(handle.value, value)
            }
            Ok(wrap_app(^app))
        }
        "csr" | "ssr" | "ssg" | "stream" | "streaming" | "island" | "hydration_dev" | "hydration_release" -> {
            app := if method == {
                "csr" -> jet_app_csr(handle.value)
                "ssr" -> jet_app_ssr(handle.value)
                "ssg" -> jet_app_ssg(handle.value)
                "stream" -> jet_app_stream(handle.value)
                "streaming" -> jet_app_streaming(handle.value)
                "island" -> jet_app_island(handle.value)
                "hydration_dev" -> jet_app_hydration_dev(handle.value)
                else -> jet_app_hydration_release(handle.value)
            }
            Ok(wrap_app(^app))
        }
        "facts_json" -> Ok(AppRuntimeResult.Value(CtValue.Str(jet_app_facts_json(handle.value))))
        "serve" | "serve_on" -> {
            if args.first() == Val(value) {
                port := if value == { .Int(value) if value >= 0 && value <= U16.MAX as I64 -> value; else -> return Err(unsupported("app serve port", span)) }
                jet_app_serve_on(handle.value, port)
            } else { jet_app_serve(handle.value) }
            Ok(AppRuntimeResult.Value(CtValue.Unit))
        }
        else -> Err(unsupported("`App.{method}()`", span))
    }
}
