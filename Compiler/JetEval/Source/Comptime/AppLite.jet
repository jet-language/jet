// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:481
fn http_error_to_ct(error: JetHTTPError) -> CtValue {
    parts := jet_http_error_surface_parts(error)
    args := if parts.payload == {
        .Unit -> []
        .Int{field, value} -> [(Val(field.to_string()), CtValue.Int(value))]
        .Text{field, value} -> [(Val(field.to_string()), CtValue.Str(value))]
        .Operation{field, variant, ..} -> [(Val(field.to_string()), CtValue.Enum{type_name: "HTTPOperation", variant: variant.to_string(), args: []})]
    }
    CtValue.Enum{type_name: "HTTPError", variant: parts.variant.to_string(), args: ^args}
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:508
fn http_response_to_ct(response: JetHTTPResponse) -> CtValue JetHTTPError! {
    JetHTTPResponse{status, version, headers, body, trailers, protocol, remote_address, redirect_history, timings_ms, reused_connection, raw_content_encoding, ..} := ^response
    body := body.bytes(USize.MAX)?
    headers_to_ct := fn(headers: JetHTTPHeaders) {
        CtValue.Struct{type_name: "Headers", fields: headers.entries.into_iter().map(fn(entry) { (name, value) := entry; (name, CtValue.Str(value)) }).collect()}
    }
    raw_content_encoding := raw_content_encoding.map(fn(value) { CtValue.Present(CtValue.Str(value)) }).unwrap_or_else(fn() { CtValue.absent(Type.String) })
    Ok(CtValue.Struct{type_name: "HTTPResponse", fields: [
        ("status", CtValue.Int(status)), ("version", CtValue.Str(version)), ("headers", headers_to_ct(^headers)),
        ("body", CtValue.Struct{type_name: "Body", fields: [("bytes", CtValue.Bytes(^body))]}),
        ("trailers", headers_to_ct(^trailers)), ("protocol", CtValue.Str(^protocol)), ("remote_address", CtValue.Str(^remote_address)),
        ("redirect_history", CtValue.List(redirect_history.into_iter().map(fn(value) { CtValue.Str(value) }).collect())),
        ("timings_ms", CtValue.List(timings_ms.into_iter().map(fn(value) { CtValue.Int(value) }).collect())),
        ("reused_connection", CtValue.Bool(reused_connection)), ("raw_content_encoding", ^raw_content_encoding)]})
}
