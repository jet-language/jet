// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:651
pub fn http_static_file(path: String, mime: String) -> CtValue {
    if jet_http_srv_static_file(path, mime).and_then(fn(response) { http_response_to_ct(response) }) == {
        Ok(response) -> CtValue.Present(^response)
        Err(error) -> CtValue.failed(http_error_to_ct(error))
    }
}
