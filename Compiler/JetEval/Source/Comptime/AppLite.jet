fn web_record_field(value: &CtValue, name: String, span: Span) -> &CtValue Diagnostic! {
    if value != .Struct{fields, ..} -> return Err(unsupported("checked Web record", span))
    fields.iter().find(fn(entry) { (field, _) := entry; field == name }).map(fn(entry) { (_, value) := entry; value })
        .ok_or_else(fn() { unsupported("Web record field `{name}`", span) })
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:841
fn web_enum_variant(value: &CtValue, expected: String, span: Span) -> String Diagnostic! {
    if value == { .Enum{type_name, variant, ..} if type_name == expected -> Ok(variant); else -> Err(unsupported(expected, span)) }
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:852
fn web_enum_value<T: std.fmt.Debug>(type_name: String, value: T) -> CtValue {
    CtValue.Enum{type_name: type_name.to_string(), variant: "{value:?}", args: []}
}
// Rust: crates/jet-comptime/src/Comptime/AppLite.rs:860
fn web_form_field_spec(value: &CtValue, span: Span) -> (JetWebFormFieldSpec Err!) Diagnostic! {
    field := fn(name) { web_record_field(value, name, span) }
    value_type := if web_enum_variant(field("value_type")?, "WebFormValueType", span)? == {
        "String" -> JetWebFormValueType.String; "Int" -> JetWebFormValueType.Int; "Bool" -> JetWebFormValueType.Bool; "Float" -> JetWebFormValueType.Float
        else -> return Err(unsupported("WebFormValueType", span))
    }
    control := if web_enum_variant(field("control")?, "WebFormControl", span)? == {
        "Text" -> JetWebFormControl.Text; "Email" -> JetWebFormControl.Email; "Password" -> JetWebFormControl.Password
        "Number" -> JetWebFormControl.Number; "Checkbox" -> JetWebFormControl.Checkbox; "Hidden" -> JetWebFormControl.Hidden
        "URL" -> JetWebFormControl.URL; "Date" -> JetWebFormControl.Date
        else -> return Err(unsupported("WebFormControl", span))
    }
    optional := fn(value: &CtValue) -> String? Diagnostic! {
        if value == {
            .Present(value) -> web_string(value, "form optional text", span).map(fn(s) { Val(s) })
            value if value.is_clean_stop() -> Ok(None)
            else -> Err(unsupported("form optional text", span))
        }
    }
    default := optional(field("default")?)?
    group := optional(field("group")?)?
    label := web_string(field("label")?, "form label", span)?
