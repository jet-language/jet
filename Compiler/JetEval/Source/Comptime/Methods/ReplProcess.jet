// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:15
fn repl_refusal(what: String, reason: String, fix: String, required: String, granted: Holds, span: Span) -> Diagnostic Never! {
    authority :: ApplicationAuthority{required_effects: Holds.from([String]{required}), granted_effects: ^granted, denied_effects: Holds.new(), authority: "REPL lexical Authority"}
    Diagnostic.error("E1803", what, repl_refusal_why(&authority, reason), fix, Val(span)).with_detail(authority.policy_facts())
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:39
pub fn repl_effect_request(module: String, method: String, args: &[CtValue]) -> ReplEffectRequest Never! {
    shown :: fn(i: Int, fallback: String) -> String Never! { if args.get(i) == { Val(value) -> value.jet_show() else -> fallback } }
    (root, operation, resource) :: if is_nondeterministic_core(module, method) {
        (root, operation) :: if core_effect(module, method) == { Val(.Time) -> ("Time", "Read"); Val(.Rand) -> ("Rand", "Draw"); else -> panic("nondeterministic Core call has no time/rand effect") }
        (root, operation, method)
    } else -> if (module, method) == {
        ("core.files", "read" | "read_bytes" | "exists" | "is_dir") -> ("FS", "Read", shown(0, "<path>"))
        ("core.files", "write" | "append_all" | "create_dir" | "remove") -> ("FS", "Write", shown(0, "<path>"))
        ("core.sys", "get") -> ("Env", "Read", shown(0, "<key>"))
        ("core.sys", "set") -> ("Env", "Write", shown(0, "<key>"))
        ("core.sys", "current_dir") -> ("Env", "Read", "PWD")
        ("core.sys", "home_dir") -> ("Env", "Read", "HOME")
        ("core.term", "eprint") -> ("IO", "Write", "stderr")
        ("core.term", "input" | "read_all_input" | "stdin") -> ("IO", "Read", "stdin")
        ("core.process", "argv" | "args") -> ("IO", "Read", "argv")
        ("core.process", "run") -> ("Exec", "Run", shown(0, "<command>"))
        ("core.process", "exit") -> ("Exec", "Exit", shown(0, "0"))
        ("core.math.random", _) -> ("Rand", "Draw", method)
        ("core.net" | "core.net.tls", _) -> ("Net", method, shown(0, "<network resource>"))
        else -> ("IO", method, module)
    }
    ReplEffectRequest{root: root, operation: operation, resource: resource}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:87
pub fn apply_repl_fs_call(method: String, args: &[CtValue], span: Span, authorizer: &ReplAuthorizer) -> CtValue Diagnostic! {
    one :: fn(i: Int) -> CtValue Diagnostic! { args.get(i) ?? fail unsupported("core.files call has the wrong number of arguments", span) }
    path :: as_string(one(0)!, span)!
    operation :: if method == { "write" | "append_all" | "create_dir" | "remove" -> IoErrorOperation.Write else -> IoErrorOperation.Read }
    io_error :: fn(error: IOError) -> CtValue Never! { CtValue.failed(io_error_value(operation, path, ^error)) }
    if method == {
        "read" -> {
            bytes :: authorizer.fs_read(path) catch error -> return io_error(^error)
            // GATE #4409: invalid UTF8 is InvalidData, never InvalidInput.
            text :: String.from_utf8(^bytes) catch error -> return io_error(IOError.new(ErrorKind.InvalidData, ^error))
            CtValue.Present{value: CtValue.Str{value: ^text}}
        }
        "read_bytes" -> {
            bytes :: authorizer.fs_read(path) catch error -> return io_error(^error)
            CtValue.Present{value: CtValue.Bytes{value: ^bytes}}
        }
        "write" | "append_all" -> {
            content :: as_string(one(1)!, span)!
            authorizer.fs_write(path, content.as_bytes(), method == "append_all") catch error -> return io_error(^error)
            CtValue.Present{value: CtValue.Unit}
        }
        "exists" -> { value :: authorizer.fs_exists(path) catch error -> fail unsupported("secure filesystem check failed: {error}", span); CtValue.Bool{value: value} }
        "is_dir" -> { value :: authorizer.fs_is_dir(path) catch error -> fail unsupported("secure filesystem check failed: {error}", span); CtValue.Bool{value: value} }
        "create_dir" -> { authorizer.fs_create_dir(path) catch error -> return io_error(^error); CtValue.Present{value: CtValue.Unit} }
        "remove" -> { authorizer.fs_remove(path) catch error -> return io_error(^error); CtValue.Present{value: CtValue.Unit} }
        else -> fail unsupported("core.files.{method}", span)
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:152
pub fn apply_repl_authorized_core_call(module: String, method: String, args: [CtValue], span: Span, base_dir: &OSPath, sink: DevSink?, grants: &[CtValue], authorizer: ReplAuthorizer?) -> CtValue Diagnostic! {
    apply_repl_authorized_core_call_with_type(module, method, ^args, span, base_dir, sink, grants, authorizer, None)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:167
pub fn apply_repl_authorized_core_call_with_type(module: String, method: String, args: [CtValue], span: Span, base_dir: &OSPath, sink: DevSink?, grants: &[CtValue], authorizer: ReplAuthorizer?, resolved_ret: Type?) -> CtValue Diagnostic! {
    args := normalize_path_args(module, method, ^args, span)!
    // Qualified prints remain ordinary transcript output, also under #NoPrelude.
    if module == "core.term" && (method == "print" || method == "eprint") -> return apply_impure_core_call_with_type(module, method, ^args, span, base_dir, sink, true, None, None, resolved_ret)
    pinned_executable :: if module == "core.process" && method == "run" -> Val(pin_repl_command(&args, base_dir, span)!) else -> None
    request :: repl_effect_request(module, method, &args)
    authorizer := authorizer ?? {
        granted := Holds.new()
        loop grant in grants { if authority_holds(grant) == Val(rights) -> granted.extend(^rights) }
        fail repl_refusal("{request.root}.{request.operation} for `{request.resource}` was denied", "this REPL mode has no runtime authority provider", "restart with `jet repl --allow-{request.root.to_ascii_lowercase()}` or use an interactive session and approve the exact operation", request.root, ^granted, span)
    }
    authorizer.preflight(&request, span)!
    boundary_authority :: args.len() == 2 && ((module == "core.process" && method == "run") || (module == "core.plugin" && method == "load"))
    held := Holds.new()
    if boundary_authority {
        if authority_holds(&args[1]) == Val(rights) -> held = ^rights
    } else { loop grant in grants { if authority_holds(grant) == Val(rights) -> held.extend(^rights) } }
    denied :: Holds.new()
    granted :: answer(&held, &denied, request.root) == Verdict.Allowed
    if !granted -> fail repl_refusal("{request.root}.{request.operation} for `{request.resource}` has no REPL runtime authority", "REPL host effects require both lexical `#FX` access and invocation policy", "wrap this operation in `#FX(grant: {request.root}) {{ ... }}`; interactive sessions then prompt, while non-TTY sessions also need `--allow-{request.root.to_ascii_lowercase()}`", request.root, ^held, span)
    authorizer.authorize(&request, span)!
    if module == "core.term" && (method == "input" || method == "read_all_input") {
        prompt :: if args.first() == { Val(.Str(value)) -> value else -> "" }
        line :: authorizer.read_input(prompt) catch error -> return CtValue.failed(io_error_value(IoErrorOperation.Read, "stdin", ^error))
        return CtValue.Present{value: CtValue.Str{value: ^line}}
    }
    if module == "core.files" -> return apply_repl_fs_call(method, &args, span, &authorizer)
    if module == "core.math.random" -> return apply_core_call_with_type(module, method, ^args, span, true, resolved_ret)
    verified_root :: if module == "core.process" && method == "run" {
        root :: authorizer.verified_root() catch error -> fail unsupported("REPL project root handle is unavailable: {error}", span)
        Val(^root)
    } else -> None
    apply_impure_core_call_with_type(module, method, ^args, span, base_dir, sink, true, pinned_executable.as_ref(), verified_root.as_ref(), resolved_ret)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:308
pub fn pin_repl_command(args: &[CtValue], base_dir: &OSPath, span: Span) -> FileReader Diagnostic! {
    words := if args.first_mut() == { Val(.List(words)) -> &words else -> fail unsupported("process.run expects a list of command words", span) }
    program := if words.first_mut() == { Val(.Str(program)) -> &program else -> fail unsupported("process.run needs an executable name", span) }
    candidate :: OSPath.from_text(program)
    resolved := OSPath?{None}
    // GATE #4494: native PATH ingress and retained descriptor resolution.
    if candidate.components().count() > 1 || candidate.is_absolute() {
        path :: if candidate.is_absolute() -> candidate else -> base_dir.join(candidate)
        resolved = canonicalize(path).ok()
    } else {
        if env.var_os("PATH") == Val(path) {
            loop dir in env.split_paths(path) {
                if canonicalize(dir.join(candidate)).ok() == Val(path) { if path.is_file() { resolved = Val(^path); break } }
            }
        }
    }
    resolved :: resolved ?? fail unsupported("process.run could not resolve executable `{program}`", span)
    executable :: open_reader(resolved, OpenOptions{}) catch error -> fail unsupported("process.run could not pin executable `{resolved.display()}`: {error}", span)
    if !executable.stat().is_ok_and(fn(metadata) -> metadata.is_file) -> fail unsupported("process.run executable is not a regular file", span)
    program = resolved.to_string_lossy()
    ^executable
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:366
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:374
fn repl_descriptor_path(fd: I32) -> String Never! {
    // GATE #4483: selected target OS, not build-host OS.
    if core.sys.target.selected_os() == "linux" -> "/proc/self/fd/{fd}" else -> "/dev/fd/{fd}"
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:378
pub const REPL_PROCESS_OUTPUT_LIMIT_BYTES: USize = 64 * 1024 * 1024
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:380
fn drain_repl_output<R: Read>(reader: R, used: &Arc<AtomicUsize>, overflowed: &Arc<AtomicBool>) -> [U8] IOError! {
    // GATE #4494: native pipe reads and shared atomic accounting.
    reader := ^reader
    output := [U8]{}
    buffer := [U8; 8192]{0}
    loop {
        count :: reader.read(&buffer)!
        if count == 0 -> return ^output
        updated :: used.fetch_update(Ordering.AcqRel, Ordering.Acquire, fn(previous) -> USize? Never! {
            total :: previous.checked_add(count) ?? return None
            if total <= REPL_PROCESS_OUTPUT_LIMIT_BYTES -> Val(total) else -> None
        })
        if updated.is_err() {
            overflowed.store(true, Ordering.Release)
            fail IOError.new(ErrorKind.Other, "process.run output exceeded {REPL_PROCESS_OUTPUT_LIMIT_BYTES} bytes")
        }
        output.extend_from_slice(buffer[0..<count])
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:414
pub fn run_repl_process(cmd: &[String], base_dir: &OSPath, pinned_executable: FileReader?, verified_root: Directory?, timeout: Duration) -> Output IOError! {
    // GATE #4494: native Command, pipes, threads, retained descriptor projection.
    // GATE #4483: preserve Unix and non-Unix dispatch.
    unix :: core.sys.target.selected_family() == "unix"
    executable :: if unix {
        if pinned_executable == { Val(file) -> repl_descriptor_path(file.as_raw_fd()) else -> cmd[0] }
    } else {
        if pinned_executable != None -> fail IOError.new(ErrorKind.Unsupported, "this platform cannot launch a descriptor-pinned REPL executable")
        cmd[0]
    }
    cwd :: if unix {
        if verified_root == { Val(file) -> OSPath.from_text(repl_descriptor_path(file.as_raw_fd())) else -> base_dir.clone() }
    } else -> base_dir.clone()
    command := Command.new(executable)
    command.args(cmd[1..<cmd.len()]).current_dir(cwd).env_clear().stdin(Stdio.null()).stdout(Stdio.piped()).stderr(Stdio.piped())
    if unix && pinned_executable != None -> command.process_group(0)
    child := command.spawn()!
    stdout := child.stdout.take().ok_or_else(fn() -> IOError.new(ErrorKind.Other, "process.run stdout pipe unavailable"))
    stderr := child.stderr.take().ok_or_else(fn() -> IOError.new(ErrorKind.Other, "process.run stderr pipe unavailable"))
    (stdout, stderr) :: if (stdout, stderr) == {
        (Ok(out), Ok(err)) -> (^out, ^err)
        (Err(error), _) | (_, Err(error)) -> { _ :: child.kill(); _ :: child.wait(); fail ^error }
    }
    output_used :: Arc.new(AtomicUsize.new(0))
    output_overflowed :: Arc.new(AtomicBool.new(false))
    stdout_used :: output_used.clone()
    stdout_overflowed :: output_overflowed.clone()
    stdout_thread :: thread.spawn(fn() -> [U8] IOError! { drain_repl_output(^stdout, &stdout_used, &stdout_overflowed) })
    stderr_used :: ^output_used
    stderr_overflowed :: output_overflowed.clone()
    stderr_thread :: thread.spawn(fn() -> [U8] IOError! { drain_repl_output(^stderr, &stderr_used, &stderr_overflowed) })
    signal_forward :: if unix && pinned_executable != None -> Val(ReplSignalForward.install(child.id() as I32)) else -> None
    terminal_signals :: if unix && pinned_executable != None -> ReplTerminalSignals.enable() else -> None
    stop_child :: fn(child: &Child) -> Never! {
        if unix && pinned_executable != None -> kill_repl_process_group(child.id() as I32) else -> { _ :: child.kill() }
        _ :: child.wait()
    }
    deadline :: Instant.now() + timeout
    status :: (fn() -> std.process.ExitStatus IOError! {
        loop {
            if output_overflowed.load(Ordering.Acquire) {
                stop_child(&child)
                fail IOError.new(ErrorKind.Other, "process.run output exceeded {REPL_PROCESS_OUTPUT_LIMIT_BYTES} bytes")
            }
            waited :: child.try_wait() catch error -> { stop_child(&child); fail ^error }
            if waited == Val(status) -> return status
            if Instant.now() >= deadline {
                stop_child(&child)
                fail IOError.new(ErrorKind.TimedOut, "process.run exceeded the 30 second REPL limit")
            }
            thread.sleep(Duration.from_millis(10))
        }
    })()
    // Background descendants cannot outlive the operation boundary.
    if status.is_ok() && pinned_executable != None && unix -> kill_repl_process_group(child.id() as I32)
    stdout :: stdout_thread.join().map_err(fn(_) -> IOError.new(ErrorKind.Other, "process.run stdout reader panicked"))
    stderr :: stderr_thread.join().map_err(fn(_) -> IOError.new(ErrorKind.Other, "process.run stderr reader panicked"))
    status :: status!
    Output{status: status, stdout: stdout!!, stderr: stderr!!}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:565
// GATE #4494: process-static native atomic cell, Unix only at call sites.
static REPL_CHILD_GROUP: AtomicI32 = AtomicI32.new(0)
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:572
use std.posix.[kill, signal]
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:577
extern "C" fn forward_repl_interrupt(signal_number: I32) -> Never! {
    note_repl_interrupt()
    warn_repl_runtime_call_stopping()
    group :: REPL_CHILD_GROUP.load(Ordering.Relaxed)
    if group > 0 { #Unsafe("forward POSIX interrupt to the live child process group; GATE #4494") { _ :: kill(-group, signal_number) } }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:587
struct ReplSignalForward { previous: USize }
impl ReplSignalForward {
    // Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:593
    fn install(group: I32) -> ReplSignalForward Never! {
        REPL_CHILD_GROUP.store(group, Ordering.SeqCst)
        previous :: #Unsafe("opaque POSIX signal disposition and callback ABI; GATE #4494") { signal(2, forward_repl_interrupt as *Unit as USize) }
        ReplSignalForward{previous: previous}
    }
}
impl ReplSignalForward.Close {
    // Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:602
    fn close(^self) -> Never! {
        REPL_CHILD_GROUP.store(0, Ordering.SeqCst)
        #Unsafe("restore exact previous POSIX signal disposition; GATE #4494") { _ :: signal(2, self.previous) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:609
fn kill_repl_process_group(group: I32) -> Never! {
    #Unsafe("SIGKILL targets the retained process group; GATE #4494") { _ :: kill(-group, 9) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:614
struct ReplTerminalSignals { saved: String }
impl ReplTerminalSignals {
    // Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:620
    fn enable() -> ReplTerminalSignals? Never! {
        // GATE #4494: terminal detection and native stty execution.
        if !stdin().is_terminal() || !stdout().is_terminal() -> return None
        saved :: Command.new("stty").arg("-g").stdin(Stdio.inherit()).stderr(Stdio.null()).output().ok() ?? return None
        if !saved.status.success() -> return None
        decoded :: String.from_utf8_lossy(&saved.stdout)
        trimmed := decoded.trim() // #4303
        saved :: trimmed.to_string()
        if saved.is_empty() -> return None
        enabled :: Command.new("stty").arg("isig").stdin(Stdio.inherit()).stdout(Stdio.null()).stderr(Stdio.null()).status().ok() ?? return None
        if enabled.success() -> Val(ReplTerminalSignals{saved: ^saved}) else -> None
    }
}
impl ReplTerminalSignals.Close {
    // Rust: crates/jet-comptime/src/Comptime/Methods/repl_process.rs:654
    fn close(^self) -> Never! {
        _ :: Command.new("stty").arg(self.saved).stdin(Stdio.inherit()).stdout(Stdio.null()).stderr(Stdio.null()).status()
    }
}
