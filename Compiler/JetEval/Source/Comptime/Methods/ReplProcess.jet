//RS #[cfg(unix)]
//RS static REPL_CHILD_GROUP: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0);
//RS 
//RS // POSIX `signal(3)` keeps platform-specific `sigaction` layouts out of this
//RS // std-only crate. Store returned disposition opaquely so nested guards restore
//RS // either prior Jet handler or SIG_DFL/SIG_IGN exactly.
