// D-POOLID-API1=A: resident tier-0 Pool<T> generational-arena state.
use jet_foundation.[Diagnostic, Span, CtValue, NamedCtValue, CtEnumArg, Type]
use jet_foundation.Syntax
use jet_comptime.Diagnostics.[unsupported]
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:8
pub struct PoolOutcome { pub value: CtValue, pub updated: CtValue? }
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:13
pub fn new_value() -> CtValue Never! { pool_value([CtValue]{}, [CtValue]{}) }
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:17
pub fn is_method(recv: &CtValue, method: String) -> Bool Never! {
    if recv == { .Struct(type_name, _) -> type_name == Syntax.MEM_POOL && (method == "add" || method == "remove" || method == "ids") else -> false }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:27
pub fn apply(recv: &CtValue, method: String, args: &[CtValue], resolved_ret: Type?, span: Span) -> PoolOutcome Diagnostic! {
    if !is_method(recv, method) -> fail unsupported("this Pool method", span)
    (type_name, fields) :: if recv == { .Struct(name, fields) -> (name, fields) else -> panic("is_method accepted only Pool structs") }
    assert(type_name == Syntax.MEM_POOL)
    slots := list_field(fields, "slots")
    free := list_field(fields, "free")
    changed := false
    value :: if method == {
        "add" -> {
            value :: args.first().cloned() ?? fail unsupported("Pool.add without a value", span)
            (index, generation) :: if free.pop() == {
                Val(.Int(raw)) -> {
                    index :: USize.try_from(raw).ok() ?? fail unsupported("this Pool state", span)
                    slot :: slots.get(index) ?? fail unsupported("this Pool state", span)
                    generation :: slot_generation(slot, "Vacant") ?? fail unsupported("this Pool state", span)
                    slots[index] = occupied(generation, ^value)
                    (index, generation)
                }
                Val(_) -> fail unsupported("this Pool state", span)
                None -> { index :: slots.len(); slots.push(occupied(U32{0}, ^value)); (index, U32{0}) }
            }
            changed = true
            id(index, generation)
        }
        "remove" -> {
            removed := (USize, U32)?{None}
            if args.first() == Val(value) {
                if id_parts(value) == Val((index, generation)) {
                    if slots.get(index) == Val(current) {
                        if slot_generation(current, "Occupied") == Val(generation) -> removed = Val((index, generation))
                    }
                }
            }
            if removed == {
                Val((index, generation)) -> {
                    old :: slots[index]
                    slots[index] = vacant(generation.wrapping_add(U32{1}))
                    free.push(CtValue.Int{value: index as Int})
                    changed = true
                    if old == { .Enum(_, _, args) -> CtValue.Present{value: args.swap_remove(1).value} else -> panic("validated occupied Pool slot") }
                }
                None -> CtValue.absent(if resolved_ret == { Val(.Option(inner)) -> inner.clone() else -> Type.Int })
            }
        }
        "ids" -> {
            out := [CtValue]{}
            loop index in 0..<slots.len() { if slot_generation(&slots[index], "Occupied") == Val(generation) -> out.push(id(index, generation)) }
            CtValue.List{values: ^out}
        }
        else -> fail unsupported("this Pool method", span)
    }
    PoolOutcome{value: ^value, updated: if changed -> Val(pool_value(^slots, ^free)) else -> None}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:114
fn pool_value(slots: [CtValue], free: [CtValue]) -> CtValue Never! {
    CtValue.Struct{type_name: Syntax.MEM_POOL, fields: [NamedCtValue]{NamedCtValue{name: "slots", value: CtValue.List{values: ^slots}}, NamedCtValue{name: "free", value: CtValue.List{values: ^free}}}}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:124
fn list_field(fields: &[NamedCtValue], wanted: String) -> [CtValue] Never! {
    loop field in fields { if field.name == wanted { if field.value == .List(values) -> return values.clone() } }
    [CtValue]{}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:134
fn id(index: USize, generation: U32) -> CtValue Never! {
    CtValue.Struct{type_name: "ID", fields: [NamedCtValue]{NamedCtValue{name: "index", value: CtValue.Int{value: index as Int}}, NamedCtValue{name: "generation", value: CtValue.Int{value: generation as Int}}}}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:147
fn id_parts(value: &CtValue) -> (USize, U32)? Never! {
    fields :: if value == { .Struct(type_name, fields) -> { if type_name != "ID" -> return None; fields } else -> return None }
    int_field :: fn(wanted: String) -> Int? Never! {
        loop field in fields { if field.name == wanted { if field.value == .Int(value) -> return Val(value) } }
        None
    }
    index :: int_field("index") ?? return None
    generation :: int_field("generation") ?? return None
    Val((USize.try_from(index).ok() ?? return None, U32.try_from(generation).ok() ?? return None))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:166
fn occupied(generation: U32, value: CtValue) -> CtValue Never! {
    CtValue.Enum{type_name: "__PoolSlot", variant: "Occupied", args: [CtEnumArg]{CtEnumArg{label: None, value: CtValue.Int{value: generation as Int}}, CtEnumArg{label: None, value: ^value}}}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:174
fn vacant(generation: U32) -> CtValue Never! {
    CtValue.Enum{type_name: "__PoolSlot", variant: "Vacant", args: [CtEnumArg]{CtEnumArg{label: None, value: CtValue.Int{value: generation as Int}}}}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/pool.rs:182
fn slot_generation(slot: &CtValue, wanted: String) -> U32? Never! {
    if slot == {
        .Enum(_, variant, args) -> {
            if variant != wanted -> return None
            if args.first() == { Val(arg) -> if arg.value == { .Int(generation) -> U32.try_from(generation).ok() else -> None } else -> None }
        }
        else -> None
    }
}
