use jet_foundation.AST.[CtValue, CtReport]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.Syntax.GENERATED_NAME_PREFIX
use jet_comptime.Comptime.Diagnostics.unsupported
use jet_comptime.Comptime.UrlLite
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:3
pub fn named_tuple(fields: &[(String, CtValue)]) -> CtValue {
    names: [String] := fields.iter().map(fn(e) { e.0 }).collect()
    CtValue.Struct { type_name: "({names.join(",")})", fields: fields.iter().map(fn(e) { (e.0.to_string(), e.1.clone()) }).collect() }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:16
pub fn as_string(v: &CtValue, span: Span) -> &String Diagnostic! {
    v == { Str(s) -> s; _ -> { fail unsupported("non-string argument to a Core string call", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:26
pub fn as_string_rows(v: &CtValue, span: Span) -> [[String]] Diagnostic! {
    v == {
        List(rows) -> rows.iter().map(fn(row) { row == {
            List(cols) -> cols.iter().map(fn(c) { as_string(c, span)?.to_string() }).collect()?
            _ -> { fail unsupported("rows that are not `[[String]]`", span) }
        } }).collect()?
        _ -> { fail unsupported("rows that are not `[[String]]`", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:42
pub fn csv_rows_from_records(v: &CtValue) -> [[String]]? {
    items := v == { List(items) -> items; _ -> { return None } }
    field_names := fn(value) { value == {
        Struct { fields, .. } -> Val(fields.iter().map(fn(e) { e.0.strip_prefix(GENERATED_NAME_PREFIX).unwrap_or(e.0).to_string() }).collect())
        _ -> None
    } }
    header := field_names(items.first()?)?
    if items.iter().any(fn(item) { field_names(item).is_none() }) { return None }
    cell := fn(value) { value == {
        Str(s) -> s.clone(); Int(n) -> n.to_string(); Float(f) -> f.render(); Bool(b) -> b.to_string()
        Unit | Failed(Clean(_)) -> ""; other -> other.to_json()
    } }
    rows := [header.clone()]
    for item in items {
        fields := item == { Struct { fields, .. } -> fields; _ -> { return None } }
        rows.push(header.iter().map(fn(key) {
            fields.iter().find(fn(e) { e.0.strip_prefix(GENERATED_NAME_PREFIX).unwrap_or(e.0) == key }).map(fn(e) { cell(e.1) }).unwrap_or_default()
        }).collect())
    }
    Val(rows)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:99
pub fn url_parts_to_ct(u: &UrlLite.UrlParts) -> CtValue {
    (port, port_explicit) := u.core_port(); text := fn(value: &String?) { CtValue.Str(value.clone().unwrap_or_default()) }
    CtValue.Struct { type_name: "URL", fields: [
        ("scheme", CtValue.Str(u.scheme.clone())), ("user_text", text(&u.username)), ("password_text", text(&u.password)),
        ("host", text(&u.host)), ("port", CtValue.Int(port)), ("port_explicit", CtValue.Bool(port_explicit)),
        ("path", CtValue.Str(u.path.clone())), ("query", CtValue.Str(u.query())), ("fragment", text(&u.fragment)), ("raw", CtValue.Str(u.to_string_value()))
    ] }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:119
fn url_record_field(fields: &[(String, CtValue)], name: String, span: Span) -> &CtValue Diagnostic! {
    fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { e.1 }).ok_or_else(fn() { unsupported("malformed URL {name}", span) })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:131
fn url_record_text(fields: &[(String, CtValue)], name: String, span: Span) -> &String Diagnostic! {
    url_record_field(fields, name, span)? == { Str(value) -> value; _ -> { fail unsupported("malformed URL {name}", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/values.rs:143
pub fn url_parts_from_ct(value: &CtValue, span: Span) -> UrlLite.UrlParts Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("malformed URL value", span) } }
    type_name := type_name.strip_prefix(GENERATED_NAME_PREFIX).unwrap_or(type_name)
    if type_name != "URL" { fail unsupported("malformed URL value", span) }
    port := url_record_field(fields, "port", span)? == { Int(port) -> port; _ -> { fail unsupported("malformed URL port", span) } }
    port_explicit := url_record_field(fields, "port_explicit", span)? == { Bool(v) -> v; _ -> { fail unsupported("malformed URL port_explicit", span) } }
    UrlLite.from_core_record(url_record_text(fields, "scheme", span)?, url_record_text(fields, "user_text", span)?, url_record_text(fields, "password_text", span)?, url_record_text(fields, "host", span)?, port, port_explicit, url_record_text(fields, "path", span)?, url_record_text(fields, "query", span)?, url_record_text(fields, "fragment", span)?)
}
