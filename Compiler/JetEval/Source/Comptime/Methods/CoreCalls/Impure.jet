fn log_field_arg(value: &CtValue, span: Span) -> log_kernel.LogField Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("core.log expects a LogField", span) } }
    if type_name != "LogField" { fail unsupported("core.log expects a LogField", span) }
    field := fn(name) { fields.iter().find_map(fn(e) { if e.0 == name { Val(e.1) } else { None } }).ok_or_else(fn() { unsupported("malformed LogField", span) }) }
    key := log_string_arg(field("key")?, span)?.clone(); value := log_string_arg(field("value")?, span)?.clone()
    kind := log_string_arg(field("kind")?, span)?.clone(); redacted := log_bool_arg(field("redacted")?, span)?
    log_kernel.LogField { key, value, kind, redacted }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/impure.rs:117
fn log_fields_arg(value: &CtValue, span: Span) -> [log_kernel.LogField] Diagnostic! {
    values := value == { List(values) -> values; _ -> { fail unsupported("core.log expects a List[LogField]", span) } }
    values.iter().map(fn(v) { log_field_arg(v, span) }).collect()?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/impure.rs:130
fn log_span_arg(value: &CtValue, span: Span) -> log_kernel.LogSpan Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("core.log expects a LogSpan", span) } }
    if type_name != "LogSpan" { fail unsupported("core.log expects a LogSpan", span) }
    field := fn(name) { fields.iter().find_map(fn(e) { if e.0 == name { Val(e.1) } else { None } }).ok_or_else(fn() { unsupported("malformed LogSpan", span) }) }
    id := as_int(field("id")?, span)?; name := log_string_arg(field("name")?, span)?.clone()
