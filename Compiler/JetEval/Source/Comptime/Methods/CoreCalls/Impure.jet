        ("core.log", "float") -> { key := log_string_arg(one(0)?, span)?; value := as_float(one(1)?, span)?; ct_log_field(log_kernel.float(key, value)) }
        ("core.log", "bool") -> { key := log_string_arg(one(0)?, span)?; value := log_bool_arg(one(1)?, span)?; ct_log_field(log_kernel.bool_field(key, value)) }
