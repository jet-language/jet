            "with_policy" -> Comptime.core_event_with_policy(one(0)?.clone()); "hook" -> Comptime.core_event_hook(one(0)?.clone())
            "decision_hook" -> Comptime.core_event_decision_hook(one(0)?.clone()); "async_result" -> Comptime.core_event_async_result(one(0)?, one(1)?, span)?
