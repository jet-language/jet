            std.process.exit(code as I32)
        }
        ("core.process", "run") -> {
            cmd := one(0)? == { List(items) -> items.iter().map(fn(v) { v.jet_show() }).collect<[String]>(); _ -> { fail unsupported("process.run expects a list of command words", span) } }
            if cmd.is_empty() { return CtValue.failed(Box.new(CtValue.Struct { type_name: "IOError", fields: [("message", CtValue.Str("process.run needs at least one command word"))] })) }
            run_repl_process(&cmd, base_dir, pinned_executable, verified_root, Duration.from_secs(30)) == {
                Ok(out) -> CtValue.Present(Box.new(CtValue.Struct { type_name: "ProcessReceipt", fields: [
                    ("code", CtValue.Int(out.status.code().unwrap_or(-1) as I64)),
                    ("output", CtValue.Str(String.from_utf8_lossy(&out.stdout).into_owned())), ("errors", CtValue.Str(String.from_utf8_lossy(&out.stderr).into_owned())),
                    ("signal", CtValue.absent(Type.Int)), ("success", CtValue.Bool(out.status.success())), ("timed_out", CtValue.Bool(false)),
                    ("executable_identity", CtValue.Str(cmd.first().cloned().unwrap_or_default())), ("argv", CtValue.List(cmd.iter().cloned().map(CtValue.Str).collect())),
                    ("input_digest", CtValue.Str("")), ("policy_digest", CtValue.Str("")), ("backend", CtValue.Str("comptime-ambient")), ("authority", CtValue.List([])),
                    ("descendants", CtValue.Str("direct")), ("limits", CtValue.List([CtValue.Str("timeout-ms=30000"), CtValue.Str("output-limit={REPL_PROCESS_OUTPUT_LIMIT_BYTES}")])),
                    ("outputs", CtValue.List([CtValue.Str("stdout=capture"), CtValue.Str("stderr=capture")])), ("redacted", CtValue.Bool(false)), ("pid", CtValue.Int(0))
                ] }))
                Err(e) -> CtValue.failed(Box.new(io_error_value(IoErrorOperation.Resolve, &cmd[0], e)))
            }
        }
        ("core.net.tls", _) -> { fail Diagnostic.error("E3412", "`core.net.tls.{method}()` is not available at comptime", "live TLS sessions cannot be opened during compile-time evaluation", "move the TLS operation to runtime; use `core.net.fetch(url, sha256: \"<hash>\")` for content-hash-pinned build-time downloads", Val(span)) }
        ("core.handle", "duration.in") -> apply_core_call_without_ambient_with_type(module, method, args, span, repl_mode, resolved_ret)?
        (module, _) if module == "core.web" || module.starts_with("core.web.") -> apply_core_call_without_ambient_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.archive.gzip", _) | ("core.archive.zstd", _) | ("core.archive", _) | ("core.perf", _) -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        (module, _) if module.starts_with("core.encoding.") -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.term", method) if core_effect("core.term", method).is_none() -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.testing", "histories") -> apply_core_call_without_ambient_with_type_args(module, method, args, span, repl_mode, type_args, resolved_ret)?
        ("core.math.random", _) | ("core.testing", "fake_rng") -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.crypto.random", "bytes") -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.builtin", "len_string" | "map_keys" | "map_values") | ("core.reactive.loadable", _) | ("core.time", _) | ("core.math", _) | ("core.testing", _) | ("core.data", _) | ("core.compute", _) | ("core.service", _) | ("core.auth", _) | ("core.sync", _) | ("app", _) | ("core.ui", _) | ("core.crypto", _) | ("core.crypto.expert", _) | ("core.email", _) | ("core.regex", _) | ("core.units", _) | ("core.text.fmt", _) -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.net", method) if core_effect("core.net", method).is_none() -> apply_core_call_with_type(module, method, args, span, repl_mode, resolved_ret)?
        ("core.net", _) -> { fail Diagnostic.error("E3412", "`core.net.{method}()` is not available at comptime", "only `core.net.fetch(url, sha256:)` is supported at compile time", "use `core.net.fetch(url, sha256: \"<hash>\")` for content-hash-pinned downloads", Val(span)) }
        _ -> { fail unsupported("`{module}.{method}()`", span) }
    }
}
