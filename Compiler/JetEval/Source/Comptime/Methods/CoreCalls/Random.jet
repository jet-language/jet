// D-DET1 / I9: adapters marshal containers around the one runtime random kernel.
use jet_codegen.Prelude.CoreLib.Top.MathRandomFns.*
use std.cell.Cell
use std.thread_local.ThreadLocal
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:7
// The included kernel's Rng is the canonical carrier, not an ambient duplicate.
use jet_codegen.Prelude.CoreLib.JetStd.Rng
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:12
type WorldRngNext = fn() -> U64?
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:13
type WorldRngSeed = fn(I64) -> Bool
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:16
// GATE #4494: provider scope is invocation-thread-local, restored on unwind.
const WORLD_RNG_NEXT: ThreadLocal<Cell<WorldRngNext?>> = ThreadLocal.new(fn() { Cell.new(None) })
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:18
const WORLD_RNG_SEED: ThreadLocal<Cell<WorldRngSeed?>> = ThreadLocal.new(fn() { Cell.new(None) })
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:22
struct WorldRngProviderGuard { previous_next: WorldRngNext?, previous_seed: WorldRngSeed? }
impl WorldRngProviderGuard {
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:28
    fn drop(self: &Self) {
        WORLD_RNG_NEXT.with(fn(p) { p.set(self.previous_next) })
        WORLD_RNG_SEED.with(fn(p) { p.set(self.previous_seed) })
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:34
pub fn with_world_rng_provider<T>(next: WorldRngNext, seed: WorldRngSeed, callback: fn() -> T) -> T {
    previous_next := WORLD_RNG_NEXT.with(fn(p) { p.replace(Val(next)) })
    previous_seed := WORLD_RNG_SEED.with(fn(p) { p.replace(Val(seed)) })
    guard := WorldRngProviderGuard { previous_next, previous_seed }
    defer { guard.drop() }
    callback()
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:48
fn world_rng_next() -> U64? { WORLD_RNG_NEXT.with(fn(p) { p.get().and_then(fn(provider) { provider() }) }) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:52
fn world_rng_seed(seed: I64) -> Bool { WORLD_RNG_SEED.with(fn(p) { p.get().is_some_and(fn(provider) { provider(seed) }) }) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:60
fn jet_scheduler_world_rng_next() -> U64? { world_rng_next() }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/random.rs:63
fn jet_scheduler_world_rng_seed(seed: I64) -> Bool { world_rng_seed(seed) }
