// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:360
pub fn regex_split_limit(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(&args, span)?; text := as_string(args.get(1).ok_or_else(fn() { unsupported("regex.split_limit: missing text argument", span) })?, span)?
    limit := as_int(args.get(2).ok_or_else(fn() { unsupported("regex.split_limit: missing limit argument", span) })?, span)?
    CtValue.List(re.split_limit(text, limit).into_iter().map(CtValue.Str).collect())
