use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.AST.[CtValue, Type]
use jet_comptime.Comptime.Builtins.[as_bool, as_int]
use jet_comptime.Comptime.Diagnostics.unsupported
use jet_comptime.Comptime.Methods.CoreCalls.Values.as_string
use jet_comptime.Comptime.regex_kernel.[JetRegex, RegexFlags, JetRegexMatch, jet_regex_compile_with]
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:10
pub fn apply_regex_method(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !(recv == { Struct { type_name, .. } if type_name == "__JetRegex" -> true; _ -> false }) { return None }
    // Scalar receiver paths avoid allocating/copying an argument vector.
    if method == "is_match" { return Val(try { Ok(regex_is_match_method(recv, args, span)?) } catch(e) { Err(e) }) }
    if method == "find" { return Val(try { Ok(regex_find_method(recv, args, span)?) } catch(e) { Err(e) }) }
    call_args: [CtValue] := [].with_capacity(args.len() + 1); call_args.push(recv.clone()); call_args.extend_from_slice(args)
    try {
        result := method == {
            "pattern" | "source" | "flags" | "options" | "names" | "count" -> regex_metadata(call_args, method, span)?
            "full_match" -> regex_full_match(call_args, span)?; "find_all" -> regex_find_all(call_args, span)?; "matches" -> regex_matches(call_args, span)?
            "split" -> regex_split(call_args, span)?; "split_limit" -> regex_split_limit(call_args, span)?
            "replace" | "replace_first" -> regex_replace_method(recv, method, args, span)?; "match" -> regex_match(call_args, span)?
            _ -> { return None }
        }; Val(Ok(result))
    } catch(e) { Val(Err(e)) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:48
fn regex_is_match_method(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern_value(recv, span)?
    text := as_string(args.first().ok_or_else(fn() { unsupported("regex.is_match: missing text argument", span) })?, span)?
    CtValue.Bool(re.is_match(text))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:62
fn regex_find_method(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern_value(recv, span)?
    text := as_string(args.first().ok_or_else(fn() { unsupported("regex.find: missing text argument", span) })?, span)?
    re.find(text).ok() == { Val(v) -> CtValue.Present(Box.new(CtValue.Str(v))); None -> CtValue.absent(Type.String) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:74
pub fn regex_pattern(args: &[CtValue], span: Span) -> JetRegex Diagnostic! {
    value := args.first().ok_or_else(fn() { unsupported("regex call: missing pattern argument", span) })?; regex_pattern_value(value, span)?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:84
fn regex_pattern_value(value: &CtValue, span: Span) -> JetRegex Diagnostic! {
    (pat, flags) := value == {
        Str(pattern) -> (pattern, RegexFlags.default())
        Struct { type_name, fields } if type_name == "__JetRegex" -> {
            pattern := fields.iter().find_map(fn(e) { (e.0, e.1) == { ("pattern", Str(p)) -> Val(p); _ -> None } }).ok_or_else(fn() { unsupported("Regex literal value", span) })?
            flags := fields.iter().find(fn(e) { e.0 == "flags" }).map(fn(e) { regex_flags_value(e.1, span) }).transpose()?.unwrap_or_default()
            (pattern, flags)
        }
        _ -> { fail unsupported("Regex pattern value", span) }
    }
    jet_regex_compile_with(pat, &flags).map_err(fn(e) { Diagnostic.error("E0956", "bad regex pattern: {e}", "the pattern could not be compiled", "fix the pattern syntax", Val(span)) })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:122
fn regex_metadata(args: [CtValue], method: String, span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(&args, span)?
    method == {
        "pattern" | "source" -> CtValue.Str(re.pattern()); "flags" | "options" -> CtValue.Str(re.flags())
        "names" -> CtValue.List(re.names().into_iter().map(CtValue.Str).collect())
        "count" -> CtValue.Int(re.count(as_string(args.get(1).ok_or_else(fn() { unsupported("regex.count: missing text argument", span) })?, span)?))
        _ -> unreachable("guarded regex metadata method")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:141
pub fn eval_regex_replace_all_with(recv: &CtValue, args: &[CtValue], span: Span, invoke: &fn(CtValue, [CtValue]) -> CtValue Diagnostic!) -> (CtValue Diagnostic!)? {
    if !(recv == { Struct { type_name, .. } if type_name == "__JetRegex" -> true; _ -> false }) { return None }
    try {
        re := regex_pattern(std.slice.from_ref(recv), span)?
        text := as_string(args.first().ok_or_else(fn() { unsupported("regex.replace_all_with: missing text argument", span) })?, span)?
        callback := args.get(1).ok_or_else(fn() { unsupported("regex.replace_all_with: missing callback argument", span) })?
        replaced := re.replace_all_with_result(text, fn(found) { value := invoke(callback.clone(), [regex_match_value(text, found)])?; as_string(&value, span)?.to_string() })?
        Val(Ok(CtValue.Str(replaced)))
    } catch(e) { Val(Err(e)) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:172
fn regex_flags_value(value: &CtValue, span: Span) -> RegexFlags Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("RegexFlags value", span) } }
    if type_name != "__JetRegexFlags" { fail unsupported("RegexFlags value", span) }
    field := fn(name) { fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { as_bool(e.1, span) }).transpose() }
    RegexFlags { case_insensitive: field("case_insensitive")?.unwrap_or(false), multiline: field("multiline")?.unwrap_or(false), dotall: field("dotall")?.unwrap_or(false) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:196
pub fn regex_flags(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    field := fn(index: USize, name: String) { as_bool(args.get(index).ok_or_else(fn() { unsupported("regex.flags: missing {name}", span) })?, span) }
    CtValue.Struct { type_name: "__JetRegexFlags", fields: [("case_insensitive", CtValue.Bool(field(0, "case_insensitive")?)), ("multiline", CtValue.Bool(field(1, "multiline")?)), ("dotall", CtValue.Bool(field(2, "dotall")?))] }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:220
pub fn regex_compile(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    pattern := as_string(args.first().ok_or_else(fn() { unsupported("regex.compile: missing pattern", span) })?, span)?
    flags := args.get(1).map(fn(v) { regex_flags_value(v, span) }).transpose()?.unwrap_or_default()
    jet_regex_compile_with(pattern, &flags) == {
        Ok(_) -> CtValue.Present(Box.new(CtValue.Struct { type_name: "__JetRegex", fields: [
            ("pattern", CtValue.Str(pattern.to_string())),
            ("flags", CtValue.Struct { type_name: "__JetRegexFlags", fields: [("case_insensitive", CtValue.Bool(flags.case_insensitive)), ("multiline", CtValue.Bool(flags.multiline)), ("dotall", CtValue.Bool(flags.dotall))] })
        ] }))
        Err(error) -> CtValue.failed(Box.new(CtValue.Str(error)))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:256
pub fn regex_escape(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    text := as_string(args.first().ok_or_else(fn() { unsupported("regex.escape: missing text argument", span) })?, span)?; CtValue.Str(escape_regex_text(text))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:265
fn escape_regex_text(text: String) -> String {
    out := String.with_capacity(text.len())
    for ch in text.chars() { meta := ch == { '\\' | '.' | '+' | '*' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '^' | '\u{24}' | '\u{7c}' -> true; _ -> false }; if meta { out.push('\\') }; out.push(ch) }
    out
}
