// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:415
fn regex_replace_method(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(std.slice.from_ref(recv), span)?; text := as_string(args.first().ok_or_else(fn() { unsupported("regex.replace: missing text argument", span) })?, span)?
    rep := as_string(args.get(1).ok_or_else(fn() { unsupported("regex.replace: missing replacement argument", span) })?, span)?
    replaced := if method == "replace" { re.replace(text, rep) } else { re.replace_first(text, rep) }; CtValue.Str(replaced)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:440
pub fn regex_match(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(&args, span)?; text := as_string(args.get(1).ok_or_else(fn() { unsupported("regex.match: missing text argument", span) })?, span)?
    re.match_value(text).ok() == { Val(found) -> CtValue.Present(Box.new(regex_match_value(text, found))); None -> CtValue.absent(Type.Named("Match")) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:453
pub fn regex_match_value(_text: String, found: JetRegexMatch) -> CtValue {
    groups := (0..=found.group_count()).map(fn(index) { found.group(index as I64) == { Ok(v) -> CtValue.Present(Box.new(CtValue.Str(v))); Err(_) -> CtValue.absent(Type.String) } }).collect()
    spans := (0..=found.group_count()).map(fn(index) { (found.group_start(index as I64), found.group_end(index as I64)) == {
        (Ok(start), Ok(end)) -> CtValue.Present(Box.new(CtValue.Struct { type_name: "__RegexSpan", fields: [("start", CtValue.Int(start)), ("end", CtValue.Int(end))] }))
        _ -> CtValue.absent(Type.Named("__RegexSpan"))
    } }).collect()
    names := found.capture_names().into_iter().map(fn(name) { name.map(fn(n) { CtValue.Present(Box.new(CtValue.Str(n))) }).unwrap_or_else(fn() { CtValue.absent(Type.String) }) }).collect()
    CtValue.Struct { type_name: "Match", fields: [("groups", CtValue.List(groups)), ("spans", CtValue.List(spans)), ("names", CtValue.List(names))] }
}
