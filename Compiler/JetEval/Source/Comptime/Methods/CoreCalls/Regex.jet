// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:379
fn regex_replace_impl(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(&args, span)?; rep := as_string(args.get(1).ok_or_else(fn() { unsupported("regex.replace: missing replacement argument", span) })?, span)?
    text := as_string(args.get(2).ok_or_else(fn() { unsupported("regex.replace: missing text argument", span) })?, span)?; CtValue.Str(re.replace(text, rep))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:395
pub fn regex_replace(args: [CtValue], span: Span) -> CtValue Diagnostic! { regex_replace_impl(args, span)? }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:399
