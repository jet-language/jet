// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/regex.rs:334
pub fn regex_matches(args: [CtValue], span: Span) -> CtValue Diagnostic! {
    re := regex_pattern(&args, span)?; text := as_string(args.get(1).ok_or_else(fn() { unsupported("regex.matches: missing text argument", span) })?, span)?
