use jet_foundation.AST.[CtValue, CtFloat, CtReport, Type]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.Outcome.JetAbsent
use jet_foundation.PackageEdition.package_edition_at_least
use jet_comptime.Comptime.Diagnostics.unsupported
use jet_comptime.Comptime.Methods.CoreCalls.Values.[as_float, as_string]
// Shared canonical Core kernels: the interpreter only marshals, never implements another policy.
use jet_codegen.Prelude.CoreLib.Top.DataStats as data_kernel
use jet_codegen.Prelude.CoreLib.Top.DataPlot as data_plot_rt
use jet_codegen.Prelude.CoreLib.Top.DataStats.[GroupValue, DataLineOptions, DataError, DataErrorKind, DataSummary, DataLimits, JetDataPivotCell]

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:4
fn as_float_list(v: &CtValue, span: Span) -> [F64] Diagnostic! {
    if v == {
        .List(xs) -> xs.iter().map(fn(x) { as_float(x, span) }).collect::<[F64] Diagnostic!>()
        _ -> Err(unsupported("core.data: argument must be `[Float]`", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:12
fn as_data_bar_groups(v: &CtValue, span: Span) -> [GroupValue<CtValue, I64>] Diagnostic! {
    if v != .List(items) -> return Err(unsupported("core.data: argument must be `[Group<K, Int>]`", span))
    items.iter().map(fn(item) -> GroupValue<CtValue, I64> Diagnostic! {
        if item != .Struct{type_name, fields} -> return Err(unsupported("core.data: argument must be `[Group<K, Int>]`", span))
        if type_name != "Group" -> return Err(unsupported("core.data: argument must be `[Group<K, Int>]`", span))
        field := fn(name: String) { fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { &pair.1 }) }
        key := field("key").cloned() ?? return Err(unsupported("core.data: a `Group` needs `key` and `value: Int`", span))
        value := if field("value") == {
            Some(CtValue.Int(value)) -> value
            _ -> return Err(unsupported("core.data: a `Group` needs `key` and `value: Int`", span))
        }
        Ok(GroupValue{key: ^key, value: value})
    }).collect::<[GroupValue<CtValue, I64>] Diagnostic!>()
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:64
fn as_data_line_groups(v: &CtValue, span: Span) -> [GroupValue<CtValue, F64>] Diagnostic! {
    if v != .List(items) -> return Err(unsupported("core.data: argument must be `[Group<K, Float>]`", span))
    items.iter().map(fn(item) -> GroupValue<CtValue, F64> Diagnostic! {
        if item != .Struct{type_name, fields} -> return Err(unsupported("core.data: argument must be `[Group<K, Float>]`", span))
        if type_name != "Group" -> return Err(unsupported("core.data: argument must be `[Group<K, Float>]`", span))
        field := fn(name: String) { fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { &pair.1 }) }
        key := field("key").cloned() ?? return Err(unsupported("core.data: a `Group` needs `key` and `value: Float`", span))
        value := field("value") ?? return Err(unsupported("core.data: a `Group` needs `key` and `value: Float`", span))
        value := as_float(value, span)?
        Ok(GroupValue{key: ^key, value: value})
    }).collect::<[GroupValue<CtValue, F64>] Diagnostic!>()
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:114
fn as_data_line_options(v: &CtValue, span: Span) -> DataLineOptions Diagnostic! {
    if v != .Struct{type_name, fields} -> return Err(unsupported("core.data line renderers need `DataLineOptions`", span))
    if type_name != "DataLineOptions" -> return Err(unsupported("core.data line renderers need `DataLineOptions`", span))
    field := fn(name: String) -> CtValue Diagnostic! {
        fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { pair.1.clone() }) ?? return Err(unsupported("DataLineOptions is missing a required field", span))
    }
    string := fn(name: String) -> String Diagnostic! {
        if field(name)? == {
            .Str(value) -> Ok(^value)
            _ -> Err(unsupported("DataLineOptions string field has the wrong type", span))
        }
    }
    markers := if field("markers")? == {
        .Bool(value) -> value
        _ -> return Err(unsupported("DataLineOptions `markers` must be Bool", span))
    }
    reference := if field("reference")? == {
        .Present(value) -> Ok(as_float(&value, span)?)
        .Failed(CtReport.Clean(_)) -> Err(JetAbsent)
        _ -> return Err(unsupported("DataLineOptions `reference` must be Float?", span))
    }
    Ok(DataLineOptions{title: string("title")?, x_label: string("x_label")?, y_label: string("y_label")?, markers: markers, reference: reference, style: string("style")?, color: string("color")?, legend: string("legend")?})
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:173
fn data_checked_surface() -> Bool { package_edition_at_least("2027") }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:179
fn data_error_value(error: &DataError) -> CtValue {
    index := fn(slot: &(I64 JetAbsent!)) -> CtValue {
        if slot == { .Ok(value) -> CtValue.Present(CtValue.Int(value)); .Err(_) -> CtValue.absent(Type.Int) }
    }
    CtValue.Struct{type_name: "DataError", fields: [
        ("kind", CtValue.Enum{type_name: "DataErrorKind", variant: "{error.kind:?}", args: []}),
        ("operation", CtValue.Str(error.operation.clone())),
        ("row", index(&error.row)), ("column", index(&error.column)), ("index", index(&error.index)),
        ("reason", CtValue.Str(error.reason.clone())),
        ("cause", CtValue.absent(Type.Named("EncodingError"))),
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:215
fn data_result_value<T>(checked: T DataError!, unchecked: fn() -> T, to_value: fn(T) -> CtValue) -> CtValue {
    data_result_value_for_type(^checked, unchecked, to_value, None)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:226
fn data_result_value_for_type<T>(checked: T DataError!, unchecked: fn() -> T, to_value: fn(T) -> CtValue, resolved_ret: Type?) -> CtValue {
    checked_surface := (resolved_ret is Some(Type.Result{..})) || data_checked_surface()
    if !checked_surface -> return to_value(unchecked())
    if checked == {
        .Ok(value) -> CtValue.Present(to_value(^value))
        .Err(error) -> CtValue.failed(data_error_value(&error))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:243
fn data_summary_value(summary: DataSummary) -> CtValue {
    CtValue.Struct{type_name: "DataSummary", fields: [
        ("count", CtValue.Int(summary.count)), ("sum", data_float_value(summary.sum)),
        ("mean", data_float_value(summary.mean)), ("min", data_float_value(summary.min)),
        ("max", data_float_value(summary.max)), ("median", data_float_value(summary.median)),
        ("variance", data_float_value(summary.variance)), ("stddev", data_float_value(summary.stddev)),
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:261
pub fn eval_data_describe(args: &[CtValue], resolved_ret: Type?, span: Span) -> CtValue Diagnostic! {
    arg := args.first() ?? return Err(unsupported("core.data.describe(): missing arg 0", span))
    values := as_float_list(arg, span)?
    Ok(data_result_value_for_type(data_kernel.jet_data_describe_checked(&values), fn() { data_kernel.jet_data_describe(&values) }, data_summary_value, resolved_ret))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:281
fn data_pivot_sum(args: &[CtValue], span: Span, call: fn(&CtValue, [CtValue], Span) -> CtValue Diagnostic!) -> CtValue Diagnostic! {
    if args.len() != 4 -> return Err(unsupported("`data.pivot_sum()` expects rows and three callbacks", span))
    row_key := &args[1]
    column_key := &args[2]
    value := &args[3]
    if args[0] != .List(rows) -> return Err(unsupported("`data.pivot_sum()` needs a row list", span))
    values := [(String, String, F64)].with_capacity(rows.len())
    for row in rows {
        row_key_value := call(row_key, [row.clone()], span)?
        row_key_text := as_string(&row_key_value, span)?.to_owned()
        column_key_value := call(column_key, [row.clone()], span)?
        column_key_text := as_string(&column_key_value, span)?.to_owned()
        amount_value := call(value, [row.clone()], span)?
        amount := as_float(&amount_value, span)?
        values.push((^row_key_text, ^column_key_text, amount))
    }
    limits := DataLimits.safe()
    checked := data_kernel.jet_data_pivot_sum_values(&values, &data_kernel.jet_data_kernel_limits(limits.max_groups, limits.max_sort_rows, limits.max_join_rows, limits.max_output_rows))
    to_value := fn(cells: [JetDataPivotCell]) -> CtValue {
        CtValue.List(cells.into_iter().map(fn(cell) {
            CtValue.Struct{type_name: "DataPivotCell", fields: [
                ("row_key", CtValue.Str(^cell.row_key)), ("column_key", CtValue.Str(^cell.column_key)),
                ("count", CtValue.Int(cell.count)), ("sum", data_float_value(cell.sum)), ("mean", data_float_value(cell.mean)),
            ]}
        }).collect::<[CtValue]>())
    }
    Ok(if checked == {
        .Ok(cells) -> CtValue.Present(to_value(^cells))
        .Err(error) -> CtValue.failed(data_error_value(&error))
    })
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:349
fn data_float_value(value: F64) -> CtValue { CtValue.Float(CtFloat.f64(value)) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:355
pub fn data_status_rows() -> [(String, String, String, String, String, String, String)] {
    data_kernel.jet_data_status().into_iter().map(fn(row) {
        (^row.step, ^row.path, ^row.clone_value, ^row.ownership, ^row.trust, ^row.fallback, ^row.replacement)
    }).collect::<[_]>()
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/data.rs:372
pub fn apply_data_line_call(method: String, args: [CtValue], resolved_ret: Type?, span: Span) -> CtValue Diagnostic! {
    group_arg := args.first() ?? return Err(unsupported("core.data line renderers need groups", span))
    groups := as_data_line_groups(group_arg, span)?
    options_arg := args.get(1) ?? return Err(unsupported("core.data line renderers need options", span))
    options := as_data_line_options(options_arg, span)?
    plot_error := fn(error: data_plot_rt.DataPlotError) -> DataError {
        DataError{kind: if error.kind == "NonFinite" -> DataErrorKind.NonFinite else -> DataErrorKind.InvalidArgument,
            operation: error.operation.to_string(), row: Err(JetAbsent), column: Err(JetAbsent),
            index: if error.index is Some(index) -> Ok(index) else -> Err(JetAbsent),
            reason: error.reason.to_string(), cause: Err(JetAbsent)}
    }
    if method == {
        "line_text" -> Ok(data_result_value_for_type(data_plot_rt.jet_data_line_text_plot_checked(&groups, &options).map_err(plot_error), fn() { data_plot_rt.jet_data_line_text(&groups, &options) }, fn(text) { CtValue.Str(^text) }, resolved_ret))
        "line_svg" -> Ok(data_result_value_for_type(data_plot_rt.jet_data_line_svg_plot_checked(&groups, &options).map_err(plot_error), fn() { data_plot_rt.jet_data_line_svg(&groups, &options) }, fn(text) { CtValue.Str(^text) }, resolved_ret))
        _ -> Err(unsupported("unsupported core.data line renderer `{method}`", span))
    }
}
