    callback_error: std.rc.Rc<std.cell.RefCell<String?>>
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:912
impl ComptimeHistoryStrategy {
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:913
    fn note_error(self: &Self, reason: String) {
        error := self.callback_error.borrow_mut()
        if error.is_none() -> error.set(Val(reason))
    }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:918
    fn invoke(self: &Self, callback: &CtValue, args: [CtValue], role: String) -> CtValue Err! {
        result :: try_ambient_standalone_closure(callback, args.clone(), self.span).unwrap_or_else(fn() { invoke_standalone_closure(callback, args, self.span) })
        value :: if result == {
            Ok(value) -> value
            Err(error) -> { reason :: "{role} callback failed: {error.what}"; self.note_error(reason.clone()); return Err(reason) }
        }
        if value == {
            .Failed(.Told(reason)) -> { reason :: "{role} callback returned failure: {reason.debug_rust()}"; self.note_error(reason.clone()); return Err(reason) }
            .Failed(.Clean(_)) -> { reason :: "{role} callback returned an absent value"; self.note_error(reason.clone()); return Err(reason) }
            value -> value
        }
    }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:953
    fn invoke_mut(self: &Self, callback: &CtValue, args: &[CtValue], role: String) -> CtValue Err! {
        result :: try_ambient_standalone_closure_mut(callback, &args, self.span).unwrap_or_else(fn() { invoke_standalone_closure_mut_args(callback, &args, self.span) })
        value :: if result == {
            Ok(value) -> value
            Err(error) -> { reason :: "{role} callback failed: {error.what}"; self.note_error(reason.clone()); return Err(reason) }
        }
        if value == {
            .Failed(.Told(reason)) -> { reason :: "{role} callback returned failure: {reason.debug_rust()}"; self.note_error(reason.clone()); return Err(reason) }
            .Failed(.Clean(_)) -> { reason :: "{role} callback returned an absent value"; self.note_error(reason.clone()); return Err(reason) }
            value -> value
        }
    }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:988
    fn callback_error(self: &Self) -> String? { self.callback_error.borrow().clone() }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:993
impl HistoryStrategyBehavior<ComptimeHistoryCommand> for ComptimeHistoryStrategy {
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:994
    fn command_type(self: &Self) -> String { self.command_type }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:998
    fn bounds(self: &Self) -> HistoryBounds { self.bounds }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1002
    fn distributions(self: &Self) -> [HistoryDistribution] { self.distributions.clone() }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1006
    fn generate(self: &Self, rng: &HistoryRng, case_index: USize, max_steps: USize) -> TypedHistoryCase<ComptimeHistoryCommand>? {
        args := [history_rng_carrier(&rng), history_count_to_ct(U64.try_from(case_index).unwrap_or(U64.MAX)), history_count_to_ct(U64.try_from(max_steps).unwrap_or(U64.MAX))]
        value :: if self.invoke_mut(self.generate, &args, "history generate") == { Ok(value) -> value; Err(reason) -> { self.note_error(reason); return None } }
        value :: if history_option_value(value) == {
            Ok(Val(value)) -> value
            Ok(None) -> return None
            Err(reason) -> { self.note_error("history generate callback: {reason}"); return None }
        }
        if history_typed_case_from_ct(value) == { Ok(value) -> Val(value); Err(reason) -> { self.note_error("history generate callback: {reason}"); None } }
    }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1041
    fn rebuild(self: &Self, case: &HistoryCase) -> TypedHistoryCase<ComptimeHistoryCommand>? {
        value :: if self.invoke(self.rebuild, [history_case_to_ct(case)], "history rebuild") == { Ok(value) -> value; Err(reason) -> { self.note_error(reason); return None } }
        value :: if history_option_value(value) == {
            Ok(Val(value)) -> value
            Ok(None) -> return None
            Err(reason) -> { self.note_error("history rebuild callback: {reason}"); return None }
        }
        if history_typed_case_from_ct(value) == { Ok(value) -> Val(value); Err(reason) -> { self.note_error("history rebuild callback: {reason}"); None } }
    }
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1071
    fn valid(self: &Self, case: &TypedHistoryCase<ComptimeHistoryCommand>) -> Bool {
        value :: if self.invoke(self.valid, [history_typed_case_to_ct(case)], "history valid") == { Ok(value) -> value; Err(reason) -> { self.note_error(reason); return false } }
        if value == { .Bool(value) -> value; _ -> { self.note_error("history valid callback must return Bool"); false } }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1092
fn history_capture_u64(payload: &[U8], value: U64) { &payload.extend_from_slice(value.to_le_bytes()) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1096
fn history_capture_bytes(payload: &[U8], value: &[U8]) {
    history_capture_u64(&payload, U64.try_from(value.len()).unwrap_or(U64.MAX))
    &payload.extend_from_slice(value)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1101
fn history_capture_text(payload: &[U8], value: String) { history_capture_bytes(&payload, value.as_bytes()) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1105
fn history_capture_value(value: &CtValue, payload: &[U8]) -> Unit Err! {
    if value == {
        .Int(value) -> { &payload.push(105); &payload.extend_from_slice(value.to_le_bytes()) }
        .Float(.F32(value)) -> { &payload.push(102); &payload.push(32); &payload.extend_from_slice(value.to_bits().to_le_bytes()) }
        .Float(.F64(value)) -> { &payload.push(102); &payload.push(64); &payload.extend_from_slice(value.to_bits().to_le_bytes()) }
        .Bool(value) -> &payload.extend_from_slice(if value -> [98, 116] else -> [98, 102])
        .Char(value) -> { &payload.push(99); &payload.extend_from_slice((value as U32).to_le_bytes()) }
        .Str(value) -> { &payload.push(115); history_capture_text(&payload, value) }
        .BigInt(value) -> { &payload.push(110); history_capture_text(&payload, value.to_string_rep()) }
        .Bytes(value) -> { &payload.push(98); history_capture_bytes(&payload, value) }
        .List(values) -> {
            &payload.push(108)
            history_capture_u64(&payload, U64.try_from(values.len()).unwrap_or(U64.MAX))
            loop item in values -> history_capture_value(item, &payload)?
        }
        .Map(values) -> {
            &payload.push(109)
            history_capture_u64(&payload, U64.try_from(values.len()).unwrap_or(U64.MAX))
            // GATE #4499: canonical CtKey ordering, matching Rust's map iteration.
            keys := values.keys().collect()
            &keys.sort()
            loop key in keys { history_capture_value(key.to_value(), &payload)?; history_capture_value(values[key], &payload)? }
        }
        .Struct(type_name, fields) -> {
            &payload.push(114)
            history_capture_text(&payload, type_name)
            visible :: fields.iter().filter(fn(pair) { !crate.Syntax.is_memo_storage_name(pair.0) }).collect()
            history_capture_u64(&payload, U64.try_from(visible.len()).unwrap_or(U64.MAX))
            loop (name, item) in visible { history_capture_text(&payload, name); history_capture_value(item, &payload)? }
        }
        .Enum(type_name, variant, args) -> {
            &payload.push(101)
            history_capture_text(&payload, type_name)
            history_capture_text(&payload, variant)
            history_capture_u64(&payload, U64.try_from(args.len()).unwrap_or(U64.MAX))
            loop (label, item) in args {
                if label == { .Val(label) -> { &payload.push(1); history_capture_text(&payload, label) }; .None -> &payload.push(0) }
                history_capture_value(item, &payload)?
            }
        }
        .Present(value) -> { &payload.push(111); history_capture_value(value, &payload)? }
        .Failed(.Clean(ty)) -> { &payload.push(97); history_capture_text(&payload, ty.identity_key()) }
        .Failed(.Told(value)) -> { &payload.push(120); history_capture_value(value, &payload)? }
        .Unit -> &payload.push(117)
        .Closure(_) -> { &payload.push(102); identity :: history_callback_fingerprint_from_ct(value)?; history_capture_text(&payload, identity) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1213
pub fn history_callback_fingerprint(function_identity: String, captures: &[CtValue]) -> String Err! {
    if function_identity.is_empty() -> return Err("history callback has no checked function identity")
    payload := [U8]{}
    history_capture_text(&payload, "jet.history.callback.v1")
    history_capture_text(&payload, function_identity)
    history_capture_u64(&payload, U64.try_from(captures.len()).unwrap_or(U64.MAX))
    loop capture in captures -> history_capture_value(capture, &payload)?
    SHA256.sha256_hex(payload)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1233
// GATE #4494: thread-local stack, never a process-global substitute.
HISTORY_CALLBACK_FINGERPRINT_STACK :: std.thread_local<std.cell.RefCell<[USize]>>.new(fn() { std.cell.RefCell.new([]) })
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1238
struct HistoryCallbackFingerprintGuard { key: USize }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1240
impl Drop for HistoryCallbackFingerprintGuard {
    // Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1241
    fn drop(self: &Self) {
        HISTORY_CALLBACK_FINGERPRINT_STACK.with(fn(stack) {
            stack := stack.borrow_mut()
            if stack.iter().rposition(fn(key) { key == self.key }) == .Val(index) -> _ :: &stack.remove(index)
        })
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1251
fn enter_history_callback_fingerprint(closure: &std.sync.Arc<ClosureData>) -> HistoryCallbackFingerprintGuard Err! {
    // GATE #4494: identity of retained Arc allocation, not structural equality.
    key :: std.sync.Arc.as_ptr(closure) as USize
    HISTORY_CALLBACK_FINGERPRINT_STACK.with(fn(stack) -> HistoryCallbackFingerprintGuard Err! {
        stack := stack.borrow_mut()
        if stack.contains(key) -> return Err("history callback capture contains a cycle")
        &stack.push(key)
        HistoryCallbackFingerprintGuard{key: key}
    })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1266
fn history_callback_fingerprint_from_ct(value: &CtValue) -> String Err! {
    if value != .Closure(closure) -> return Err("history callback is not a closure")
    _guard :: enter_history_callback_fingerprint(closure)?
    if closure.opaque == .Val(opaque) {
        if opaque.downcast_ref<AmbientStandaloneClosure>() == .Val(host) -> return host.history_callback_identity()
        return Err("history callback has an unknown opaque owner")
    }
    return Err("history callback checked source identity is unavailable for a non-MIR closure")
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1283
fn history_derived_strategy_fingerprint(schema: HistoryCommandSchema?, strategy: &HistorySchemaStrategy, bounds: HistoryBounds) -> String Err! {
    schema :: schema ?? return Err("history checked schema is unavailable")
    payload := [U8]{}
    history_capture_text(&payload, "jet.history.derived-strategy.v1")
    history_capture_text(&payload, schema.command_type)
    history_capture_u64(&payload, U64.try_from(schema.variants.len()).unwrap_or(U64.MAX))
    loop variant in schema.variants {
        history_capture_text(&payload, variant.operation)
        history_capture_text(&payload, variant.variant)
        history_capture_u64(&payload, U64.try_from(variant.fields.len()).unwrap_or(U64.MAX))
        loop (label, field) in variant.fields {
            if label == { .Val(label) -> { &payload.push(1); history_capture_text(&payload, label) }; .None -> &payload.push(0) }
            if field == {
                .Integer(lo, hi) -> { &payload.push(105); &payload.extend_from_slice(lo.to_le_bytes()); &payload.extend_from_slice(hi.to_le_bytes()) }
                .Boolean -> &payload.push(98)
                .Text -> &payload.push(116)
                .Char -> &payload.push(99)
            }
        }
    }
    if schema.unsupported_reason == { .Val(reason) -> { &payload.push(1); history_capture_text(&payload, reason) }; .None -> &payload.push(0) }
    loop value in [bounds.max_steps, bounds.max_resources, bounds.max_shrink_attempts, bounds.max_discarded_cases] -> history_capture_u64(&payload, U64.try_from(value).unwrap_or(U64.MAX))
    loop distribution in strategy.distributions() {
        history_capture_text(&payload, distribution.operation)
        history_capture_u64(&payload, U64.try_from(distribution.weight).unwrap_or(U64.MAX))
    }
    SHA256.sha256_hex(payload)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1348
fn history_provenance_for_callbacks(schema: HistoryCommandSchema?, callbacks: &[(String, CtValue)], strategy_identity: String?) -> HistoryProvenance Err! {
    provenance :: schema.and_then(fn(schema) { schema.provenance.clone() }) ?? return Err("history checked provenance is unavailable")
    fingerprints := [(String, String)]{}
    loop (role, callback) in callbacks -> &fingerprints.push((role, history_callback_fingerprint_from_ct(callback)?))
    if strategy_identity == .Val(identity) -> &fingerprints.push(("strategy", identity))
    &fingerprints.sort_unstable_by(fn(left, right) { left.0.cmp(right.0) })
    provenance.bind_callbacks(fingerprints).map_err(fn(error) { error.to_string() })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1377
fn history_strategy_from_ct(value: &CtValue, command_type: String, span: Span) -> ComptimeHistoryStrategy Err! {
    bounds :: history_bounds_from_ct(history_field(value, "bounds")?)?
    distributions := [HistoryDistribution]{}
    loop item in history_list(history_field(value, "distributions")?, "HistoryStrategy.distributions")? -> &distributions.push(history_distribution_from_ct(item)?)
    ComptimeHistoryStrategy{command_type: command_type, generate: history_field(value, "generate")?.clone(), rebuild: history_field(value, "rebuild")?.clone(), valid: history_field(value, "valid")?.clone(), bounds: bounds, distributions: distributions, span: span, callback_error: std.rc.Rc.new(std.cell.RefCell.new(None))}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1402
pub fn apply_testing_histories_explicit(seed: U64, cases: USize, strategy_value: CtValue, model: CtValue, actual: CtValue, observe: CtValue, schema: HistoryCommandSchema?, command_type: String, span: Span) -> CtValue Diagnostic! {
    strategy :: if history_strategy_from_ct(strategy_value, command_type, span) == { Ok(strategy) -> strategy; Err(reason) -> return CtValue.failed(CtValue.Str(reason)) }
    provenance :: if history_provenance_for_callbacks(schema, [("generate", strategy.generate), ("rebuild", strategy.rebuild), ("valid", strategy.valid), ("model", model), ("actual", actual), ("observe", observe)], None) == { Ok(provenance) -> provenance; Err(reason) -> return CtValue.failed(CtValue.Str(reason)) }
    relation :: ObservationRelation.TypedEquality
    config := HistoryConfig.new(seed, cases, strategy.bounds, provenance.source.clone(), provenance.tool.clone(), provenance.target.clone(), relation.clone(), OracleDeclaration.independent("testing.histories.model")).with_provenance(provenance.clone()).with_command_type(command_type)
    loop distribution in strategy.distributions -> config = config.with_distribution(distribution.clone())
    runner :: if HistoryRunner.new(config) == { Ok(runner) -> runner; Err(error) -> return CtValue.failed(CtValue.Str(error.to_string())) }
    invoke :: fn(callback: &CtValue, input: CtValue, role: String) -> CtValue Err! { strategy.invoke(callback, [input], role) }
    inputs := [CtValue]{}
    reference_values := [CtValue]{}
    candidate_values := [CtValue]{}
    samples := [ComparisonSample]{}
    run :: if runner.run_strategy<ComptimeHistoryCommand>(&strategy, fn(typed) {
        unavailable :: fn(reason: String) { ComparisonRecord.terminal(relation.clone(), ComparisonStatus.Unavailable, reason) }
        input :: CtValue.List(typed.commands.iter().map(fn(command) { command.value.clone() }).collect())
        observe_value :: fn(value: CtValue) -> ComparisonObservation Err! { ComparisonObservation.value(render_ordered_datatree(invoke(observe, value, "observe")?, false, 0)) }
        reference_value :: if invoke(model, input.clone(), "model") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_value :: if invoke(actual, input.clone(), "actual") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_observed :: if observe_value(reference_value.clone()) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_observed :: if observe_value(candidate_value.clone()) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_replay_value :: if invoke(model, input.clone(), "model replay") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_replay_value :: if invoke(actual, input.clone(), "actual replay") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_replay :: if observe_value(reference_replay_value) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_replay :: if observe_value(candidate_replay_value) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        identity := ComparisonIdentity.new(typed.case.case_id.clone(), typed.case.input_id(), provenance.source.clone(), provenance.tool.clone(), provenance.target.clone())
        identity.seed = Val(typed.case.seed)
        sample :: ComparisonSample.new(identity, reference_observed, candidate_observed).with_replays(reference_replay, candidate_replay)
        &inputs.push(input.clone())
        &reference_values.push(reference_value)
        &candidate_values.push(candidate_value)
        &samples.push(sample.clone())
        compare_samples(relation.clone(), [sample])
    }) == {
        Ok(run) -> run
        Err(error) -> return CtValue.failed(CtValue.Str(strategy.callback_error().unwrap_or_else(fn() { error.to_string() })))
    }
    if strategy.callback_error() == .Val(reason) -> return CtValue.failed(CtValue.Str(reason))
    if run.failure == .Val(artifact) -> return CtValue.failed(CtValue.Str("history-artifact {artifact.json()}"))
    explored_cases :: run.explored_cases
    record := compare_samples_with_discarded(relation, samples, run.discarded_cases)
    if explored_cases == 0 { record.status = ComparisonStatus.Unavailable; record.reason = Val("no history case produced an observation") }
    case_ids :: record.samples.iter().map(fn(sample) { CtValue.Str(sample.identity.case_id.clone()) }).collect()
    CtValue.Present(CtValue.Struct{type_name: "TestComparison", fields: [
        ("status", CtValue.Str(record.status.as_str().to_string())), ("relation", CtValue.Str(record.relation.as_str().to_string())),
        ("source", CtValue.Str(provenance.source.clone())), ("tool", CtValue.Str(provenance.tool.clone())), ("target", CtValue.Str(provenance.target.clone())),
        ("seed", history_count_to_ct(seed)), ("case_ids", CtValue.List(case_ids)), ("inputs", CtValue.List(inputs)),
        ("reference", CtValue.List(reference_values)), ("candidate", CtValue.List(candidate_values)),
        ("first_difference", CtValue.Int(record.first_difference.map(fn(index) { index as I64 }).unwrap_or(-1))),
        ("reason", CtValue.Str(record.reason.unwrap_or_else(fn() { "{explored_cases} observed history case(s) matched" }))),
        ("universal_proof", CtValue.Bool(false))
    ]})
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:1615
pub fn apply_testing_histories(args: [CtValue], type_args: &[Type], span: Span, schema: HistoryCommandSchema?) -> CtValue Diagnostic! {
    if args.len() != 6 -> return Err(unsupported("testing.histories expects seed, cases, optional strategy, model, actual, and observe", span))
    command_type :: type_args.first() ?? return CtValue.failed(CtValue.Str("core.testing.histories needs one declared Command type"))
    if type_args.len() != 1 -> return CtValue.failed(CtValue.Str("core.testing.histories needs exactly one declared Command type"))
    command_key :: command_type.identity_key()
    data_tree_command :: command_key == "DataTree" || command_key.starts_with("DataTree|")
    cases :: exact_big(args[1]).and_then(fn(number) { number.try_i64() }) ?? return CtValue.failed(CtValue.Str(HISTORY_CASE_BOUND_INVALID_REASON.to_string()))
    seed :: exact_big(args[0]).and_then(fn(number) { number.try_i64() }) ?? return CtValue.failed(CtValue.Str(HISTORY_SEED_INVALID_REASON.to_string()))
    (seed, cases) :: if validate_history_bounds(seed, cases) == { Ok(bounds) -> bounds; Err(reason) -> return CtValue.failed(CtValue.Str(reason.to_string())) }
    if cases == 0 -> return CtValue.failed(CtValue.Str("history cases must be a positive Int"))
    strategy_value :: if history_option_value(args[2]) == { Ok(value) -> value; Err(reason) -> return CtValue.failed(CtValue.Str(reason)) }
    if strategy_value == .Val(strategy_value) -> return apply_testing_histories_explicit(seed, cases, strategy_value, args[3].clone(), args[4].clone(), args[5].clone(), schema, command_key, span)
    model :: args[3].clone()
    actual :: args[4].clone()
    observe :: args[5].clone()
    unsupported_reason :: if data_tree_command -> None else -> schema.and_then(fn(schema) { schema.unsupported_reason.clone() }).or_else(fn() {
        schema.filter(fn(schema) { schema.variants.is_empty() }).map(fn(_) { history_unsupported_type_reason(command_key) })
    }).or_else(fn() { if schema.is_none() -> Val(history_unsupported_type_reason(command_key)) else -> None })
    if unsupported_reason == .Val(reason) -> return comptime_history_terminal(seed, ComparisonStatus.Unsupported, reason)
    bounds :: HistoryBounds{max_steps: 8, max_resources: 32, max_shrink_attempts: 10000, max_discarded_cases: 100}
    relation :: ObservationRelation.TypedEquality
    strategy :: if schema == {
        .Val(schema) -> {
            variants := [HistorySchemaVariant]{}
            loop variant in schema.variants {
                row :: HistorySchemaVariant.new(variant.operation.clone(), variant.variant.clone(), variant.fields.iter().map(fn(pair) { pair.1.clone() }).collect()) ?? return comptime_history_terminal(seed, ComparisonStatus.Unsupported, history_unsupported_type_reason(schema.command_type))
                &variants.push(row)
            }
            HistorySchemaStrategy.with_variants(schema.command_type.clone(), variants) ?? return comptime_history_terminal(seed, ComparisonStatus.Unsupported, history_unsupported_type_reason(schema.command_type))
        }
        .None -> HistorySchemaStrategy.new("DataTree")
    }
    strategy_identity :: if history_derived_strategy_fingerprint(schema, strategy, bounds) == { Ok(identity) -> identity; Err(reason) -> return CtValue.failed(CtValue.Str(reason)) }
    provenance :: if history_provenance_for_callbacks(schema, [("model", model), ("actual", actual), ("observe", observe)], Val(strategy_identity)) == { Ok(provenance) -> provenance; Err(reason) -> return CtValue.failed(CtValue.Str(reason)) }
    config := HistoryConfig.new(seed, cases, bounds, provenance.source.clone(), provenance.tool.clone(), provenance.target.clone(), relation.clone(), OracleDeclaration.independent("testing.histories.model")).with_provenance(provenance.clone()).with_command_type(strategy.command_type())
    loop distribution in strategy.distributions() -> config = config.with_distribution(distribution)
    runner :: if HistoryRunner.new(config) == { Ok(runner) -> runner; Err(error) -> return CtValue.failed(CtValue.Str(error.to_string())) }
    invoke :: fn(callback: &CtValue, input: CtValue, role: String) -> CtValue Err! {
        result :: try_ambient_standalone_closure(callback, [input.clone()], span).unwrap_or_else(fn() { invoke_standalone_closure(callback, [input], span) })
        if result == { Ok(value) -> value; Err(error) -> return Err("{role} callback failed: {error.what}") }
    }
    inputs := [CtValue]{}
    reference_values := [CtValue]{}
    candidate_values := [CtValue]{}
    samples := [ComparisonSample]{}
    run :: if runner.run_strategy<DataTree>(&strategy, fn(typed) {
        unavailable :: fn(reason: String) { ComparisonRecord.terminal(relation.clone(), ComparisonStatus.Unavailable, reason) }
        command_values := [CtValue]{}
        if schema == {
            .Val(schema) -> {
                loop operation in typed.case.operations {
                    value :: if comptime_history_enum_command(operation, schema) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
                    &command_values.push(value)
                }
            }
            .None -> {
                loop command in typed.commands {
                    value :: if comptime_history_data_tree_command(command) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
                    &command_values.push(value)
                }
            }
        }
        input :: CtValue.List(command_values)
        observe_value :: fn(value: CtValue) -> ComparisonObservation Err! { ComparisonObservation.value(render_ordered_datatree(invoke(observe, value, "observe")?, false, 0)) }
        reference_value :: if invoke(model, input.clone(), "model") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_value :: if invoke(actual, input.clone(), "actual") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_observed :: if observe_value(reference_value.clone()) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_observed :: if observe_value(candidate_value.clone()) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_replay_value :: if invoke(model, input.clone(), "model replay") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_replay_value :: if invoke(actual, input.clone(), "actual replay") == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        reference_replay :: if observe_value(reference_replay_value) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        candidate_replay :: if observe_value(candidate_replay_value) == { Ok(value) -> value; Err(reason) -> return unavailable(reason) }
        identity := ComparisonIdentity.new(typed.case.case_id.clone(), typed.case.input_id(), provenance.source.clone(), provenance.tool.clone(), provenance.target.clone())
        identity.seed = Val(typed.case.seed)
        sample :: ComparisonSample.new(identity, reference_observed, candidate_observed).with_replays(reference_replay, candidate_replay)
        &inputs.push(input.clone())
        &reference_values.push(reference_value)
        &candidate_values.push(candidate_value)
        &samples.push(sample.clone())
        compare_samples(relation.clone(), [sample])
    }) == { Ok(run) -> run; Err(error) -> return CtValue.failed(CtValue.Str(error.to_string())) }
    explored_cases :: run.explored_cases
    if run.failure == .Val(artifact) -> return CtValue.failed(CtValue.Str("history-artifact {artifact.json()}"))
    record := compare_samples_with_discarded(relation, samples, run.discarded_cases)
    if explored_cases == 0 { record.status = ComparisonStatus.Unavailable; record.reason = Val("no history case produced an observation") }
    case_ids :: record.samples.iter().map(fn(sample) { CtValue.Str(sample.identity.case_id.clone()) }).collect()
    CtValue.Present(CtValue.Struct{type_name: "TestComparison", fields: [
        ("status", CtValue.Str(record.status.as_str().to_string())), ("relation", CtValue.Str(record.relation.as_str().to_string())),
        ("source", CtValue.Str(provenance.source.clone())), ("tool", CtValue.Str(provenance.tool.clone())), ("target", CtValue.Str(provenance.target.clone())),
        ("seed", history_count_to_ct(seed)), ("case_ids", CtValue.List(case_ids)), ("inputs", CtValue.List(inputs)),
        ("reference", CtValue.List(reference_values)), ("candidate", CtValue.List(candidate_values)),
        ("first_difference", CtValue.Int(record.first_difference.map(fn(index) { index as I64 }).unwrap_or(-1))),
        ("reason", CtValue.Str(record.reason.unwrap_or_else(fn() { "{explored_cases} observed history case(s) matched" }))),
        ("universal_proof", CtValue.Bool(false))
    ]})
}
