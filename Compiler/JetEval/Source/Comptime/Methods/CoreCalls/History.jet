}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:23
pub fn history_command_schema_from_mir(program: &MirProgram, command_type: &MirType, provenance: HistoryProvenance?) -> HistoryCommandSchema? {
    command_name :: command_type.nominal_name().map(fn(name) { name.to_string() }).unwrap_or_else(fn() { command_type.identity_key() })
    definition :: command_type.identity.and_then(fn(identity) { program.types.iter().find(fn(definition) { definition.id == identity }) }).or_else(fn() {
        program.types.iter().find(fn(definition) { definition.name == command_name || definition.key == command_name })
    })
    if definition == .None -> return Val(HistoryCommandSchema{command_type: command_name, variants: [], unsupported_reason: Val(history_unsupported_type_reason(command_name)), provenance: provenance})
    definition :: definition.unwrap()
    if definition.kind != .Enum(variants, _) -> return Val(HistoryCommandSchema{command_type: command_name, variants: [], unsupported_reason: Val(history_unsupported_type_reason(command_name)), provenance: provenance})
    if !definition.generic_params.is_empty() -> return Val(HistoryCommandSchema{command_type: command_name, variants: [], unsupported_reason: Val(history_unsupported_type_reason(command_name)), provenance: provenance})
    supported := [HistoryCommandVariant]{}
    unsupported_variant := String?{None}
    loop variant in variants {
        fields :: if variant.payload == {
            .Unit -> Val([(String?, HistorySchemaField)]{})
            .Single(ty) -> history_schema_field(ty).map(fn(field) { [(None, field)] })
            .Named(fields) -> {
                rows := [(String?, HistorySchemaField)]{}
                complete := true
                loop field in fields {
                    field_type :: history_schema_field(field.ty)
                    if field_type == .Val(field_type) -> &rows.push((Val(field.name), field_type))
                    else { complete = false; break }
                }
                if complete -> Val(rows) else -> None
            }
        }
        if fields == .None {
            if unsupported_variant.is_none() -> unsupported_variant = Val(variant.name)
            continue
        }
        &supported.push(HistoryCommandVariant{operation: variant.wire_name, variant: variant.name, fields: fields.unwrap()})
    }
    Val(HistoryCommandSchema{command_type: command_name, variants: supported, unsupported_reason: unsupported_variant.map(fn(variant) { history_unsupported_variant_reason(command_name, variant) }), provenance: provenance})
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:111
fn history_schema_field(ty: &MirType) -> HistorySchemaField? {
    if ty.kind() == {
        .Int -> Val(.Integer{lo: -8, hi: 8})
        .Bool -> Val(.Boolean)
        .String -> Val(.Text)
        .Char -> Val(.Char)
        .IntN(signed, _) -> Val(.Integer{lo: if signed -> -8 else -> 0, hi: if signed -> 8 else -> 16})
        .InlineRange(base, lo, hi) -> {
            if lo > hi -> return None
            field :: history_schema_field(base) ?? return None
            if field == .Integer(_, _) -> Val(.Integer{lo: lo, hi: hi}) else -> None
        }
        .Tagged(inner, _) | .Quantity(inner, _) -> history_schema_field(inner)
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:141
fn comptime_history_data_tree_command(value: &DataTree) -> CtValue Err! {
    json :: EncodingJson.render_json(value, false, 0)
    parse_json(json).map_err(fn(error) { "history command could not be encoded: {error.message}" })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:149
fn comptime_history_enum_command(operation: &HistoryOperation, schema: &HistoryCommandSchema) -> CtValue Err! {
    if !operation.creates.is_empty() || !operation.consumes.is_empty() -> return Err("history operation `{operation.name}` carries resources without an executable strategy")
    variant :: schema.variants.iter().find(fn(variant) { variant.operation == operation.name }) ?? return Err("history operation `{operation.name}` is not in the checked command schema")
    if operation.arguments.len() != variant.fields.len() -> return Err("history operation `{operation.name}` has {operation.arguments.len()} argument(s), expected {variant.fields.len()}")
    args := [(String?, CtValue)]{}
    loop ((label, field), value) in variant.fields.iter().zip(operation.arguments) {
        converted :: if (field, value) == {
            (.Integer(lo, hi), .Integer(value)) -> {
                if lo > value || value > hi -> return Err("history operation `{operation.name}` has an argument with the wrong scalar kind")
                CtValue.Int(value)
            }
            (.Boolean, .Boolean(value)) -> CtValue.Bool(value)
            (.Text, .Text(value)) -> CtValue.Str(value.clone())
            (.Char, .Text(value)) -> {
                chars := value.chars()
                character :: chars.next() ?? return Err("history operation `{operation.name}` has an invalid Char argument")
                if chars.next().is_some() -> return Err("history operation `{operation.name}` has an invalid Char argument")
                CtValue.Char(character)
            }
            _ -> return Err("history operation `{operation.name}` has an argument with the wrong scalar kind")
        }
        &args.push((label.clone(), converted))
    }
    CtValue.Enum{type_name: schema.command_type.clone(), variant: variant.variant.clone(), args: args}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:217
fn comptime_history_terminal(seed: U64, status: ComparisonStatus, reason: String) -> CtValue {
    CtValue.Present(CtValue.Struct{type_name: "TestComparison", fields: [
        ("status", CtValue.Str(status.as_str().to_string())),
        ("relation", CtValue.Str(ObservationRelation.TypedEquality.as_str().to_string())),
        ("source", CtValue.Str("core.testing")), ("tool", CtValue.Str("interpreter")),
        ("target", CtValue.Str("comptime")), ("seed", history_count_to_ct(seed)),
        ("case_ids", CtValue.List([])), ("inputs", CtValue.List([])),
        ("reference", CtValue.List([])), ("candidate", CtValue.List([])),
        ("first_difference", CtValue.Int(-1)), ("reason", CtValue.Str(reason)),
        ("universal_proof", CtValue.Bool(false))
    ]})
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:255
// GATE #4494: synchronous borrowed RNG pointer carried through opaque callbacks.
#Derive(Clone, Copy)
struct HistoryRngBorrow { pointer: RawPtr<HistoryRng> }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:260
#Unsafe("RNG borrow is valid only during its owning synchronous callback")
impl Send for HistoryRngBorrow {}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:261
#Unsafe("RNG carrier crosses the synchronous MIR callback seam only")
impl Sync for HistoryRngBorrow {}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:263
fn history_rng_carrier(rng: &HistoryRng) -> CtValue {
    // GATE #4494: Arc, opaque typed carrier and raw borrowed pointer.
    CtValue.Closure(std.sync.Arc.new(ClosureData{
        lambda: Lambda{take_names: [], params: [], result_type: None, error_type: None, effects: None,
            body: LambdaBody.Block([]), span: Span.new(0, 0), meta: LambdaMeta.default()},
        captured: [:], return_type: None, opaque: Val(CtOpaque.new(HistoryRngBorrow{pointer: RawPtr.from_ref(&rng)}))
    }))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:283
fn history_rng_pointer(value: &CtValue) -> RawPtr<HistoryRng>? {
    if value != .Closure(data) -> return None
    data.opaque.as_ref().and_then(fn(opaque) { opaque.downcast_ref<HistoryRngBorrow>() }).map(fn(borrow) { borrow.pointer })
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:295
pub fn apply_history_rng_method(receiver: &CtValue, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if method != "next_u64" && method != "below" && method != "coin" -> return None
    pointer :: history_rng_pointer(receiver) ?? return None
    // GATE #4494: dereference valid synchronous callback carrier.
    #Unsafe("runner owns the mutable RNG for the lifetime of this callback")
    rng :: pointer.as_mut() ?? return Val(Err(unsupported("invalid HistoryRNG callback carrier", span)))
    if method == {
        "next_u64" -> {
            if !args.is_empty() -> return Val(Err(unsupported("HistoryRNG.next_u64() expects no arguments", span)))
            Val(Ok(exact_int_value(CtBigInt.from_u64(rng.next_u64()))))
        }
        "below" -> {
            if args.len() != 1 -> return Val(Err(unsupported("HistoryRNG.below() expects one argument", span)))
            bound :: history_u64_from_ct(args[0]) == { Ok(bound) -> bound; Err(reason) -> return Val(Err(unsupported(reason, span))) }
            Val(Ok(exact_int_value(CtBigInt.from_u64(rng.below(bound)))))
        }
        "coin" -> {
            if !args.is_empty() -> return Val(Err(unsupported("HistoryRNG.coin() expects no arguments", span)))
            Val(Ok(CtValue.Bool(rng.coin())))
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:340
fn history_u64_from_ct(value: &CtValue) -> U64 Err! {
    number :: exact_big(value) ?? return Err("history count must be an exact non-negative Int")
    signed :: number.try_i128() ?? return Err("history count is outside the supported integer range")
    U64.try_from(signed).map_err(fn(_) { "history count must be a non-negative Int" })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:351
fn history_u32_from_ct(value: &CtValue, label: String) -> U32 Err! {
    count :: history_u64_from_ct(value).map_err(fn(reason) { "{label} must be a non-negative Count: {reason}" })?
    U32.try_from(count).map_err(fn(_) { "{label} exceeds the u32 identity range" })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:357
fn history_i64_from_ct(value: &CtValue, label: String) -> I64 Err! {
    exact_big(value).and_then(fn(number) { number.try_i64() }) ?? return Err("{label} must fit in an Int")
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:363
fn history_string_from_ct(value: &CtValue, label: String) -> String Err! {
    if value == { .Str(value) -> value.clone(); _ -> return Err("{label} must be a String") }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:370
fn history_option_value(value: &CtValue) -> CtValue? Err! {
    if value == {
        .Present(value) -> Val(value.clone())
        .Failed(.Clean(_)) -> None
        .Enum(type_name, variant, args) -> {
            if type_name.is_empty() && variant == "Val" -> return Val((args.first() ?? return Err("malformed optional history value")).1.clone())
            if type_name.is_empty() && variant == "None" && args.is_empty() -> return None
            return Err("history strategy field must be an optional value")
        }
        .Failed(.Told(reason)) -> return Err("optional history value carries failure: {reason.debug_rust()}")
        _ -> return Err("history strategy field must be an optional value")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:395
fn history_field(value: &CtValue, name: String) -> &CtValue Err! {
    if value != .Struct(_, fields) -> return Err("history value is not a record with `{name}`")
    fields.iter().find_map(fn(pair) { if pair.0 == name -> Val(&pair.1) else -> None }) ?? return Err("history record is missing `{name}`")
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:405
fn history_list(value: &CtValue, label: String) -> &[CtValue] Err! {
    if value == { .List(values) -> &values; _ -> return Err("{label} must be a List") }
}
