// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:468
fn history_handle_from_ct(value: &CtValue) -> HandleId Err! { HandleId{value: history_u32_from_ct(history_field(value, "value")?, "HandleID.value")?} }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:477
fn history_task_from_ct(value: &CtValue) -> TaskId Err! { TaskId{value: history_u32_from_ct(history_field(value, "value")?, "TaskID.value")?} }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:483
fn history_event_from_ct(value: &CtValue) -> EventId Err! { EventId{value: history_u32_from_ct(history_field(value, "value")?, "EventID.value")?} }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:489
fn history_value_from_ct(value: &CtValue) -> HistoryValue Err! {
    if value != .Enum(_, variant, args) -> return Err("HistoryValue must be an enum value")
    payload :: history_enum_payload(args, "HistoryValue")?
    if variant == {
        "Integer" -> .Integer(history_i64_from_ct(payload, "HistoryValue.Integer")?)
        "Boolean" -> if payload == { .Bool(value) -> .Boolean(value); _ -> return Err("HistoryValue.Boolean payload must be Bool") }
        "Text" -> .Text(history_string_from_ct(payload, "HistoryValue.Text")?)
        "Handle" -> .Handle(history_handle_from_ct(payload)?)
        "Redacted" -> .Redacted(history_string_from_ct(payload, "HistoryValue.Redacted")?)
        _ -> return Err("unknown HistoryValue variant `{variant}`")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:508
fn history_precondition_from_ct(value: &CtValue) -> HistoryPrecondition Err! {
    if value != .Enum(_, variant, args) -> return Err("HistoryPrecondition must be an enum value")
    if variant == {
        "HandleLive" -> .HandleLive(history_handle_from_ct(history_enum_payload(args, "HistoryPrecondition.HandleLive")?)?)
        "HandleState" -> {
            handle :: args.iter().find_map(fn(pair) { if pair.0 == Val("handle") -> Val(&pair.1) else -> None }) ?? return Err("HistoryPrecondition.HandleState is missing `handle`")
            handle :: history_handle_from_ct(handle)?
            state :: args.iter().find_map(fn(pair) { if pair.0 == Val("state") -> Val(&pair.1) else -> None }) ?? return Err("HistoryPrecondition.HandleState is missing `state`")
            .HandleState{handle: handle, state: history_string_from_ct(state, "HistoryPrecondition.HandleState.state")?}
        }
        "TaskCompleted" -> .TaskCompleted(history_task_from_ct(history_enum_payload(args, "HistoryPrecondition.TaskCompleted")?)?)
        "EventAvailable" -> .EventAvailable(history_event_from_ct(history_enum_payload(args, "HistoryPrecondition.EventAvailable")?)?)
        _ -> return Err("unknown HistoryPrecondition variant `{variant}`")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:543
fn history_operation_from_ct(value: &CtValue) -> HistoryOperation Err! {
    arguments := [HistoryValue]{}
    loop item in history_list(history_field(value, "arguments")?, "HistoryOperation.arguments")? -> &arguments.push(history_value_from_ct(item)?)
    creates := [HandleId]{}
    loop item in history_list(history_field(value, "creates")?, "HistoryOperation.creates")? -> &creates.push(history_handle_from_ct(item)?)
    consumes := [HandleId]{}
    loop item in history_list(history_field(value, "consumes")?, "HistoryOperation.consumes")? -> &consumes.push(history_handle_from_ct(item)?)
    preconditions := [HistoryPrecondition]{}
    loop item in history_list(history_field(value, "preconditions")?, "HistoryOperation.preconditions")? -> &preconditions.push(history_precondition_from_ct(item)?)
    depends_on := [U32]{}
    loop item in history_list(history_field(value, "depends_on")?, "HistoryOperation.depends_on")? -> &depends_on.push(history_u32_from_ct(item, "HistoryOperation.depends_on")?)
    task :: if history_option_value(history_field(value, "task")?)? == { .Val(value) -> Val(history_task_from_ct(value)?); .None -> None }
    event :: if history_option_value(history_field(value, "event")?)? == { .Val(value) -> Val(history_event_from_ct(value)?); .None -> None }
    HistoryOperation{index: history_u32_from_ct(history_field(value, "index")?, "HistoryOperation.index")?,
        name: history_string_from_ct(history_field(value, "name")?, "HistoryOperation.name")?, arguments: arguments,
        creates: creates, consumes: consumes, preconditions: preconditions, depends_on: depends_on, task: task, event: event}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:597
fn history_schedule_from_ct(value: &CtValue) -> HistoryScheduleChoice Err! {
    operation :: history_u32_from_ct(history_field(value, "operation")?, "HistoryScheduleChoice.operation")?
    task :: if history_option_value(history_field(value, "task")?)? == { .Val(value) -> Val(history_task_from_ct(value)?); .None -> None }
    event :: if history_option_value(history_field(value, "event")?)? == { .Val(value) -> Val(history_event_from_ct(value)?); .None -> None }
    HistoryScheduleChoice{operation: operation, task: task, event: event, choice: history_string_from_ct(history_field(value, "choice")?, "HistoryScheduleChoice.choice")?}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:618
fn history_case_from_ct(value: &CtValue) -> HistoryCase Err! {
    operations := [HistoryOperation]{}
    loop item in history_list(history_field(value, "operations")?, "HistoryCase.operations")? -> &operations.push(history_operation_from_ct(item)?)
    schedule := [HistoryScheduleChoice]{}
    loop item in history_list(history_field(value, "schedule")?, "HistoryCase.schedule")? -> &schedule.push(history_schedule_from_ct(item)?)
    HistoryCase{case_id: history_string_from_ct(history_field(value, "case_id")?, "HistoryCase.case_id")?, seed: history_u64_from_ct(history_field(value, "seed")?)?, operations: operations, schedule: schedule}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:638
fn history_typed_case_from_ct(value: &CtValue) -> TypedHistoryCase<ComptimeHistoryCommand> Err! {
    case :: history_case_from_ct(history_field(value, "case")?)?
    commands :: history_list(history_field(value, "commands")?, "TypedHistoryCase.commands")?.iter().map(fn(value) { ComptimeHistoryCommand{value: value.clone()} }).collect()
    TypedHistoryCase.new(case, commands) ?? return Err("TypedHistoryCase command count does not match operations")
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:654
fn history_count_to_ct(value: U64) -> CtValue { exact_int_value(CtBigInt.from_u64(value)) }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:658
fn history_optional_to_ct(value: CtValue?, type_name: String) -> CtValue {
    if value == { .Val(value) -> CtValue.Present(value); .None -> CtValue.absent(Type.Named(type_name)) }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:665
fn history_id_to_ct(type_name: String, value: U32) -> CtValue { CtValue.Struct{type_name: type_name, fields: [("value", history_count_to_ct(value as U64))]} }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:672
fn history_value_to_ct(value: &HistoryValue) -> CtValue {
    (variant, payload) :: if value == {
        .Integer(value) -> ("Integer", CtValue.Int(value))
        .Boolean(value) -> ("Boolean", CtValue.Bool(value))
        .Text(value) -> ("Text", CtValue.Str(value.clone()))
        .Handle(value) -> ("Handle", history_id_to_ct("HandleID", value.value))
        .Redacted(value) -> ("Redacted", CtValue.Str(value.clone()))
    }
    CtValue.Enum{type_name: "HistoryValue", variant: variant, args: [(None, payload)]}
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:687
fn history_usize_from_ct(value: &CtValue, label: String) -> USize Err! {
    // GATE #4483: USize uses the selected target pointer width.
    USize.try_from(history_u64_from_ct(value)?).map_err(fn(_) { "{label} exceeds the supported host count range" })?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:692
fn history_precondition_to_ct(value: &HistoryPrecondition) -> CtValue {
    if value == {
        .HandleLive(handle) -> CtValue.Enum{type_name: "HistoryPrecondition", variant: "HandleLive", args: [(None, history_id_to_ct("HandleID", handle.value))]}
        .HandleState(handle, state) -> CtValue.Enum{type_name: "HistoryPrecondition", variant: "HandleState", args: [(Val("handle"), history_id_to_ct("HandleID", handle.value)), (Val("state"), CtValue.Str(state.clone()))]}
        .TaskCompleted(task) -> CtValue.Enum{type_name: "HistoryPrecondition", variant: "TaskCompleted", args: [(None, history_id_to_ct("TaskID", task.value))]}
        .EventAvailable(event) -> CtValue.Enum{type_name: "HistoryPrecondition", variant: "EventAvailable", args: [(None, history_id_to_ct("EventID", event.value))]}
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:723
fn history_operation_to_ct(value: &HistoryOperation) -> CtValue {
    CtValue.Struct{type_name: "HistoryOperation", fields: [
        ("index", history_count_to_ct(value.index as U64)), ("name", CtValue.Str(value.name.clone())),
