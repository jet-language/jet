// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:7
#Derive(Clone, Debug)
pub struct HistoryCommandSchema {
    pub command_type: String
    pub variants: [HistoryCommandVariant]
    pub unsupported_reason: String?
    pub provenance: HistoryProvenance?
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/history.rs:15
#Derive(Clone, Debug)
pub struct HistoryCommandVariant {
