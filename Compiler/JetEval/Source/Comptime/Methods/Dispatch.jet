// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:46
fn sorted_unique(items: [CtValue], span: Span) -> [CtValue] Diagnostic! {
    sort_error: Diagnostic? = None
    items.sort_by(fn(left, right) {
        cmp_for_sort(left.clone(), right.clone(), span) == {
            Ok(order) -> order
            Err(error) -> { _ :: sort_error.get_or_insert(error); Ordering.Equal }
        }
    })
    if sort_error == Val(error) { return Err(error) }
    items.dedup()
    Ok(items)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:64
fn unique_values(items: [CtValue]) -> [CtValue] {
    // Comptime sets are small; retain the reference equality dedup algorithm.
    unique: [CtValue] = []
    for item in items { if !unique.contains(&item) { unique.push(item) } }
    unique
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:78
pub fn project_rejection(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    if args.len() != 4 { return Err(unsupported("`reject` requires String code, what, why, and fix arguments", span)) }
    args == {
        [CtValue.Str(code), CtValue.Str(what), CtValue.Str(why), CtValue.Str(fix)] -> {
            if Registry.diagnostic(code).is_none() { return Err(unsupported("`reject` uses unregistered diagnostic `{code}`", span)) }
            Err(Diagnostic.project_error(code.clone(), what.clone(), why.clone(), fix.clone(), Val(span)).expect("registered rule diagnostic"))
        }
        _ -> Err(unsupported("`reject` requires String code, what, why, and fix arguments", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:102
pub fn is_tier2_core_call(module: &String, method: &String, repl_mode: Bool) -> Bool {
    resolved := if module == "app" { "core.web" } else { module }
    if core_requires_comptime_gate(resolved, method) { return true }
    repl_mode && is_nondeterministic_core(resolved, method)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:114
pub fn vault_comptime_denied(module: &String, method: &String, span: Span) -> Diagnostic {
    Diagnostic.error("E1265", "`{module}.{method}()` can't be reached from a build-time context",
        "module-field/comptime evaluation runs before secrets are ever decrypted; a repo's encrypted store is only ever opened at ordinary runtime, and — unlike the Tier-2 comptime effect gate — there is no `#Impure` escape hatch here.",
        "move the secret read out of comptime/module-field evaluation and into ordinary runtime code.", Val(span))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:130
fn sorted_descending(items: [CtValue], span: Span) -> [CtValue] Diagnostic! {
    sort_error: Diagnostic? = None
    items.sort_by(fn(left, right) {
