// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:156
pub fn apply_seeded_rng_method_with_type(state: &U64, method: &String, args: &[CtValue], span: Span, resolved_ret: Type?) -> CtValue Diagnostic! {
    float := fn(index) { as_float(args.get(index).ok_or_else(fn() { unsupported("this RNG method argument", span) })?, span) }
    list := fn(index) {
        args.get(index) == { Val(CtValue.List(values)) -> Ok(values.as_slice()); _ -> Err(unsupported("this RNG method list argument", span)) }
    }
    method == {
        "int" -> {
            low := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            high := as_int(args.get(1).unwrap_or(&CtValue.Int(0)), span)?
            value := seeded_rng_int(state, low, high).map_err(fn(message) { Diagnostic.from_row("E3010", [("msg", message)], Val(span)) })?
            Ok(CtValue.Int(value))
        }
        "float" -> Ok(CtValue.Float(CtFloat.f64(seeded_rng_float(state))))
        "float_range" -> { low := float(0)?; high := float(1)?; Ok(CtValue.Float(CtFloat.f64(seeded_random_kernel.jet_seeded_rng_float_range(state, low, high)))) }
        "bool" -> {
            if args.is_empty() { Ok(CtValue.Bool(seeded_random_kernel.jet_seeded_rng_bool(state))) }
            else { p := float(0)?; Ok(CtValue.Bool(seeded_random_kernel.jet_seeded_rng_bool_p(state, p))) }
        }
        "normal" -> { mean := float(0)?; stddev := float(1)?; Ok(CtValue.Float(CtFloat.f64(seeded_random_kernel.jet_seeded_rng_normal(state, mean, stddev)))) }
        "exponential" -> { lambda := float(0)?; Ok(CtValue.Float(CtFloat.f64(seeded_random_kernel.jet_seeded_rng_exponential(state, lambda)))) }
        "bytes" -> { count := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?; Ok(CtValue.Bytes(seeded_random_kernel.jet_seeded_rng_bytes(state, count))) }
        "split" -> Ok(CtValue.Struct { type_name: Syntax.RNG_TYPE.to_string(), fields: [("state", CtValue.Int(seeded_random_kernel.jet_seeded_rng_split(state) as I64))] })
        "pick" -> {
            values := list(0)?
            seeded_random_kernel.jet_seeded_rng_pick(state, values) == {
                Val(value) -> Ok(CtValue.Present(value))
                None -> Ok(CtValue.absent(CtValue.resolved_option_element_type(resolved_ret).ok_or_else(fn() { unsupported("RNG.pick needs a resolved element type", span) })?))
            }
        }
        "weighted_pick" -> {
            values := list(0)?; weights := list(1)?
            if values.is_empty() || values.len() != weights.len() {
                return Ok(CtValue.absent(CtValue.resolved_option_element_type(resolved_ret).ok_or_else(fn() { unsupported("RNG.weighted_pick needs a resolved element type", span) })?))
            }
            numeric_weights: [F64] = []
            for weight in weights { numeric_weights.push(as_float(weight, span)?) }
            seeded_random_kernel.jet_seeded_rng_weighted_pick(state, values, &numeric_weights) == {
                Val(value) -> Ok(CtValue.Present(value))
                None -> Ok(CtValue.absent(CtValue.resolved_option_element_type(resolved_ret).ok_or_else(fn() { unsupported("RNG.weighted_pick needs a resolved element type", span) })?))
            }
        }
        "sample" -> { values := list(0)?; count := as_int(args.get(1).unwrap_or(&CtValue.Int(0)), span)?; Ok(CtValue.List(seeded_random_kernel.jet_seeded_rng_sample(state, values, count))) }
        "shuffle" -> {
            args.first_mut() == {
                Val(CtValue.List(values)) -> { seeded_random_kernel.jet_seeded_rng_shuffle(state, values); Ok(CtValue.Unit) }
                _ -> Err(unsupported("RNG.shuffle with a non-list argument", span))
            }
        }
        _ -> Err(unsupported("this RNG method", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:287
pub fn check_literal_embed_path(builtin: &String, path: &String, span: Span) -> String Diagnostic! {
    path := normalize_rel(path)
    p := OSPath.new(&path)
    if p.is_absolute() { return Err(embed_path_err(builtin, "absolute", span)) }
    if p.components().any(fn(c) { c == { ParentDir -> true; _ -> false } }) { return Err(embed_path_err(builtin, "escape", span)) }
    Ok(path)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:305
pub fn embed_path_err(builtin: &String, kind: &String, span: Span) -> Diagnostic {
    noun := if builtin == Syntax.BUILTIN_FIND { "glob" } else { "path" }
    inline_example := if builtin == Syntax.BUILTIN_FIND { "{builtin}(\"content/**/*.jet\")" } else { "{builtin}(\"data/file\")" }
    (msg, why, fix) := kind == {
        "literal" -> ("`{builtin}` {noun} must be a string literal", "a computed {noun} can't be audited at build time, so the compiler can't tell which file it reads", "pass the {noun} inline, e.g. `{inline_example}`")
        "absolute" -> ("`{builtin}` {noun} must be relative", "an absolute {noun} reaches outside the project", "use a {noun} relative to this file's own directory")
        _ -> ("`{builtin}` {noun} escapes the project with `..`", "`..` could read files outside your project; comptime inputs must stay inside it", "drop the `..` and use a {noun} under this file's directory")
    }
    Diagnostic.error("E0957", msg, why, fix, Val(span))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:336
pub fn find_glob(base_dir: &OSPath, glob: &String, span: Span) -> [String] Diagnostic! {
    pattern := normalize_rel(glob); segments := split_rel(&pattern); root_rel := static_glob_prefix(&segments)
    walk_error := fn(error: io.Error) { Diagnostic.error("E0955", "`{Syntax.BUILTIN_FIND}` can't walk `{glob}`", error.to_string(), "check that every directory matched by the glob can be read", Val(span)) }
    base_root := checked_embed_path(base_dir, ".").map_err(walk_error)?
    root := if root_rel.is_empty() { base_root.clone() } else {
        checked_embed_path(&base_root, &root_rel.join("/")) == {
            Ok(root) -> root
            Err(error) -> { if error.kind() == io.ErrorKind.NotFound { return Ok([]) }; return Err(walk_error(error)) }
        }
    }
    has_recursive := segments.iter().any(fn(segment) { segment == "**" })
    max_depth := if has_recursive { USize.MAX } else { segments.len() }
    out: [String] = []
    if root.is_file() { rel := root_rel.join("/"); if glob_segments_match(&segments, &split_rel(&rel)) { out.push(rel) }; return Ok(out) }
    if !root.exists() { return Ok(out) }
    logical_root := root_rel.join("/")
    walk_find(&root, &OSPath.new(&logical_root), &segments, root_rel.len(), max_depth, &out).map_err(walk_error)?
    Ok(out)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:398
pub fn eval_build_time_io(builtin: &String, base_dir: &OSPath, literal: String?, embed_inputs: &[ComptimeInput]?, span: Span) -> CtValue Diagnostic! {
    literal := literal.ok_or_else(fn() { embed_path_err(builtin, "literal", span) })?
    rel := check_literal_embed_path(builtin, &literal, span)?
    if builtin == Syntax.BUILTIN_FIND { return eval_locked_find(base_dir, &rel, embed_inputs, span) }
    // GATE #4494: canonical no-follow retained-descriptor read; never follow host symlinks.
    bytes := CheckReads.read_nofollow_at_root(base_dir, &OSPath.new(&rel), SHA256.MAX_TREE_FILE_BYTES).map_err(fn(error) {
        Diagnostic.error("E0955", "`{builtin}` can't open `{rel}`", "{error} (looked next to the file doing the embedding)", "check the path — it is relative to the file's own directory", Val(span))
    })?
    if embed_inputs == Val(inputs) { inputs.push(ComptimeInput { path: rel.clone(), hash: SHA256.sha256_hex(&bytes) }) }
    if builtin == Syntax.BUILTIN_EMBED_BYTES { return Ok(CtValue.Bytes(bytes)) }
    String.from_utf8(bytes) == {
        Ok(text) -> Ok(CtValue.Str(text))
        Err(_) -> Err(Diagnostic.error("E0955", "`{builtin}` can't read `{rel}` as text", "the file isn't valid UTF-8; `{builtin}` returns a String", "embed it with `embed_bytes(\"path\")` instead — it returns raw `[U8]`", Val(span)))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:449
pub fn arg_string_literal(arg: &CallArg) -> String? {
    arg.expr == {
        Str(parts, _) -> { if parts.len() != 1 { return None }; parts[0] == { Lit(value) -> Val(value); _ -> None } }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:459
pub fn eval_locked_find(base_dir: &OSPath, glob: &String, embed_inputs: &[ComptimeInput]?, span: Span) -> CtValue Diagnostic! {
    builtin := Syntax.BUILTIN_FIND
    base_root := checked_embed_path(base_dir, ".").map_err(fn(error) {
        Diagnostic.error("E0955", "`{builtin}` can't walk `{glob}`", error.to_string(), "check that every directory matched by the glob can be read", Val(span))
    })?
    matches := find_glob(&base_root, glob, span)?
    matches.sort()
    for rel in &matches {
        // GATE #4494: real no-follow reads, including ancestor and hard-link validation.
        bytes := CheckReads.read_nofollow_at_root(base_dir, &OSPath.new(rel), SHA256.MAX_TREE_FILE_BYTES).map_err(fn(error) {
            Diagnostic.error("E0955", "`{builtin}` can't open `{rel}`", "{error} (matched while expanding `{glob}`)", "check the path — it is relative to the file's own directory", Val(span))
        })?
        if embed_inputs == Val(inputs) { inputs.push(ComptimeInput { path: rel.clone(), hash: SHA256.sha256_hex(&bytes) }) }
    }
    Ok(CtValue.List(matches.into_iter().map(fn(s) { CtValue.Str(s) }).collect()))
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:504
pub fn eval_build_embed(args: &[CtValue], base_dir: &OSPath, embed_inputs: &[ComptimeInput]?, span: Span) -> CtValue Diagnostic! {
    rel := args.first() == { Val(CtValue.Str(path)) -> path; _ -> { return Err(unsupported("`b.embed` requires a path string", span)) } }
    path := OSPath.new(rel)
    if args.len() != 1 || path.is_absolute() || path.components().any(fn(component) { component == { ParentDir -> true; _ -> false } }) {
        return Err(Diagnostic.error("E0957", "`b.embed` path `{rel}` escapes the build root", "locked build inputs must stay beneath the selected source directory", "use a relative path returned by `b.find`, without `..`", Val(span)))
    }
    // GATE #4494: canonical retained-descriptor read preserves no-follow and link-count checks.
    bytes := CheckReads.read_nofollow_at_root(base_dir, &OSPath.new(rel), SHA256.MAX_TREE_FILE_BYTES).map_err(fn(error) {
        Diagnostic.error("E0955", "`b.embed` cannot open `{rel}`", error.to_string(), "check the locked relative path", Val(span))
    })?
    if embed_inputs == Val(inputs) { inputs.push(ComptimeInput { path: rel.clone(), hash: SHA256.sha256_hex(&bytes) }) }
    String.from_utf8(bytes).map(fn(s) { CtValue.Str(s) }).map_err(fn(_) {
        Diagnostic.error("E0955", "`b.embed` cannot decode `{rel}` as text", "the embedded file is not valid UTF-8", "embed a UTF-8 text file", Val(span))
    })
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:560
fn normalize_rel(path: &String) -> String { path.replace('\\', "/") }
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:564
fn checked_embed_path(base_dir: &OSPath, relative: &String) -> OSPath io.Error! {
    // GATE #4494: native canonicalization; #4409 preserves PermissionDenied.
    root := fs.canonicalize(base_dir)?
    candidate := root.join(relative)
    real := fs.canonicalize(&candidate)?
    if !real.starts_with(&root) { return Err(io.Error.new(io.ErrorKind.PermissionDenied, "embedded path escapes the real source root")) }
    Ok(real)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:577
fn split_rel(path: &String) -> [String] {
    path.split('/').filter(fn(part) { !part.is_empty() && part != "." }).map(fn(part) { part.to_string() }).collect()
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:584
fn static_glob_prefix(segments: &[String]) -> [String] {
    prefix: [String] = []
    for segment in segments { if segment == "**" || segment_has_glob(segment) { break }; prefix.push(segment.clone()) }
    prefix
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:595
fn segment_has_glob(segment: &String) -> Bool { segment.chars().any(fn(c) { c == { '*' | '?' | '{' | '[' -> true; _ -> false } }) }
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:599
fn walk_find(dir: &OSPath, logical_dir: &OSPath, pattern: &[String], depth: USize, max_depth: USize, out: &[String]) -> Unit io.Error! {
    // GATE #4494: native sorted directory listing and no-follow metadata.
    for path in CheckReads.read_dir_sorted(dir)? {
        ty := fs.symlink_metadata(&path)?.file_type()
        name := path.file_name() == { Val(name) -> name; None -> { continue } }
        logical_path := logical_dir.join(name)
        if ty.is_dir() { dir_depth := depth + 1; if dir_depth < max_depth { walk_find(&path, &logical_path, pattern, dir_depth, max_depth, out)? } }
        else if ty.is_file() { rel := normalize_rel(&logical_path.to_string_lossy()); if glob_segments_match(pattern, &split_rel(&rel)) { out.push(rel) } }
    }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:630
fn glob_segments_match(pattern: &[String], path: &[String]) -> Bool {
    if pattern.is_empty() { return path.is_empty() }
    if pattern[0] == "**" { return glob_segments_match(&pattern[1..], path) || (!path.is_empty() && glob_segments_match(pattern, &path[1..])) }
    !path.is_empty() && segment_match(&pattern[0], &path[0]) && glob_segments_match(&pattern[1..], &path[1..])
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:643
fn segment_match(pattern: &String, text: &String) -> Bool { segment_match_chars(&pattern.chars().collect(), &text.chars().collect()) }
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:650
fn segment_match_chars(pattern: &[Char], text: &[Char]) -> Bool {
    if pattern.is_empty() { return text.is_empty() }
    pattern[0] == {
        '*' -> segment_match_chars(&pattern[1..], text) || (!text.is_empty() && segment_match_chars(pattern, &text[1..]))
        '?' -> !text.is_empty() && segment_match_chars(&pattern[1..], &text[1..])
        '{' -> find_closing(pattern, 0, '}') == {
            Val(end) -> split_alternatives(&pattern[1..end]).into_iter().any(fn(alt) { next := alt; next.extend_from_slice(&pattern[end + 1..]); segment_match_chars(&next, text) })
            None -> !text.is_empty() && text[0] == '{' && segment_match_chars(&pattern[1..], &text[1..])
        }
        '[' -> find_closing(pattern, 0, ']') == {
            Val(end) -> !text.is_empty() && class_matches(&pattern[1..end], text[0]) && segment_match_chars(&pattern[end + 1..], &text[1..])
            None -> !text.is_empty() && text[0] == '[' && segment_match_chars(&pattern[1..], &text[1..])
        }
        c -> !text.is_empty() && text[0] == c && segment_match_chars(&pattern[1..], &text[1..])
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:684
fn find_closing(chars: &[Char], start: USize, close: Char) -> USize? {
    for (idx, c) in chars.iter().enumerate().skip(start + 1) { if c == close { return Val(idx) } }
    None
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:692
fn split_alternatives(chars: &[Char]) -> [[Char]] {
    out: [[Char]] = []; cur: [Char] = []
    for c in chars { if c == ',' { out.push(^cur); cur = [] } else { cur.push(c) } }
    out.push(cur)
    out
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:707
fn class_matches(class: &[Char], needle: Char) -> Bool {
    i := 0; matched := false
    while i < class.len() {
        if i + 2 < class.len() && class[i + 1] == '-' { matched = matched || (class[i] <= needle && needle <= class[i + 2]); i += 3 }
        else { matched = matched || class[i] == needle; i += 1 }
    }
    matched
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:725
fn literal_int(e: &Expr) -> I64? {
    e == {
        Int(n, _, _, raw) -> exact_integer_ct_value(n, raw) == { CtValue.Int(value) -> Val(value); _ -> None }
        Unary(UnOp.Neg, inner, _) -> literal_int(inner).and_then(fn(n) { n.checked_neg() })
        Paren(inner, _) -> literal_int(inner)
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:738
fn integer_width_from_type(ty: &Type) -> U32? {
    ty == { Int -> Val(64); IntN { bits, .. } -> Val(bits as U32); InlineRange { base, .. } -> integer_width_from_type(base); _ -> None }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:747
fn integer_width_from_name(name: &String) -> U32? { jet_foundation.AST.numeric_type_from_name(name).and_then(fn(ty) { integer_width_from_type(&ty) }) }
// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch.rs:755
pub fn eval_net_fetch(args: &[CtValue], base_dir: &OSPath, embed_inputs: &[ComptimeInput]?, span: Span) -> CtValue Diagnostic! {
    url := args.first() == {
        Val(CtValue.Str(s)) -> s.clone()
        _ -> { return Err(Diagnostic.error("E3414", "fetch: first argument must be a string URL", "`core.net.fetch` expects a string URL as its first argument", "pass a string literal: `net.fetch('https://example.com/data.txt', sha256: '…')`", Val(span))) }
