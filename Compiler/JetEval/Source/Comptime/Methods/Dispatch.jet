                        "{mangle(&field.name)}: {rendered}"
                    }).collect()
                    return "{mangle_path(type_name)} {{ {parts.join(", ")} }}"
                }
                parts := def.fields.iter().map(fn(field) {
                    rendered := fields.iter().find(fn(entry) { entry.0 == field.name }).map(fn(entry) { entry.1.jet_show() }).unwrap_or_else(fn() { CtValue.Unit.jet_show() })
