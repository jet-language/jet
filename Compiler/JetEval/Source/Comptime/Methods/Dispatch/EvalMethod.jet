                    tree := try { EncodingLite.cbor_decode(bytes, options, true)! }
                    catch error { return CtValue.failed(decode_error_value(EncodingLite.cbor_encoding_error_value(error), "invalid CBOR input")) }
                    try { return CtValue.Present(self.typed_decode_top(type_args[0], tree, span)!) }
                    catch error { return CtValue.failed(error) }
                }
                if module == "core.net" && method == "fetch" { return eval_net_fetch(argv, self.base_dir, Some(&self.embed_inputs), span) }
                if module == "core.crypto.vault" { throw vault_comptime_denied(module, method, span) }
                if !self.repl_mode && is_nondeterministic_core(module, method) {
                    throw Diagnostic.e3403("{module.rsplit('.').next().unwrap_or(module)}.{method}", Some(span))
                }
                if !self.repl_mode && self.impure_depth == 0 && core_effect(module, method).is_some() {
                    throw Diagnostic.error("E3410",
                        "`{module}.{method}()` is a Tier-2 comptime effect — it requires a `#Impure` gate",
                        "effectful Core APIs are not allowed in pure comptime evaluation",
                        "wrap the comptime binding in `#Impure(\"reason\") { … }` and pass `--gate impure=allow` to the build, or keep the call at runtime", Some(span))
                }
