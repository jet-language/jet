                return CtValue.Struct(type_name: Syntax.TYPE_SET, fields: [("items", CtValue.List(^items))])
            }
            if type_name == Syntax.TYPE_PRIORITY_QUEUE && (method == "new" || method == "from") {
                items := if method == "new" { [] } else {
                    match self.eval(args[0].expr, scope)! {
                        CtValue.List(items) => sorted_descending(^items, span)!,
                        _ => { throw unsupported("PriorityQueue.from with a non-list", span) },
                    }
                }
                return CtValue.Struct(type_name: Syntax.TYPE_PRIORITY_QUEUE, fields: [("items", CtValue.List(^items))])
            }
            if type_name == Syntax.TYPE_RANK && (method == "new" || method == "from") {
                items := if method == "new" { [] } else {
                    match self.eval(args[0].expr, scope)! {
                        CtValue.List(items) => sorted_unique(^items, span)!,
                        _ => { throw unsupported("Rank.from with a non-list", span) },
