    // Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:72
    fn eval_method(self: &Self, receiver: &Expr, method: String, span: Span, type_args: &[Type],
        recv_type: String?, resolved_ret: Type?, args: &[CallArg],
        scope: &[String:CtValue], evaluated_receiver: CtValue?) -> CtValue Diagnostic! {
        sequence_result_ty := resolved_ret
        if sequence_result_ty.is_none() && (method == "sum" || method == "product") {
            if Expr.Ident(name, _) := receiver {
                match self.binding_types.get(name) {
                    Some(Type.List(inner)) | Some(Type.FixedList(elem: inner, ..)) => sequence_result_ty = Some(inner),
                    _ => {}
                }
            }
        }
        if recv_type == Some(Syntax.INTERNAL_CALL_VALUE) {
            recv := evaluated_receiver.take().unwrap_or_else(() => self.eval(receiver, scope)!)
            argv: [CtValue] = []
            argv.reserve(args.len())
            for arg in args { argv.push(self.eval(arg.expr, scope)!) }
            return self.call_inline_closure(recv, ^argv, span, scope)
        }
        if Expr.Ident(type_name, _) := receiver {
            if type_name == Syntax.TYPE_AUTHORITY && (method == "workspace" || method == "from_rights") {
