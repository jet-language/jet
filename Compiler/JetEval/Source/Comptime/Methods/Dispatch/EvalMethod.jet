        // Core effects precede alias receiver and argument evaluation.
        if Expr.Ident(alias, _) := receiver {
            if module := self.core_imports.get(alias) {
                if !self.repl_mode && is_nondeterministic_core(module, method) {
                    throw Diagnostic.e3403("{module.rsplit('.').next().unwrap_or(module)}.{method}", Some(span))
                }
                if module == "core.math.random" && method == "shuffle" {
                    arg := args.first().ok_or_else(() => unsupported("random.shuffle(): missing arg 0", span))!
                    list := self.eval(arg.expr, scope)!
                    if !matches(list, CtValue.List(_)) { throw unsupported("random.shuffle needs a list", span) }
                    value: CtValue
                    if self.repl_mode {
