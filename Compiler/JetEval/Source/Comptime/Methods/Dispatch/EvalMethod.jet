                            Some(CtValue.Str(s)) => s,
                            _ => { throw unsupported("core.encoding.xml.decode(): expected a string argument", span) },
                        }
                        try {
                            if options := argv.get(1) { EncodingLite.xml_parse_with(text, options)! }
                            else { EncodingLite.xml_parse(text)! }
                        } catch error { return CtValue.failed(decode_xml_error(error)) }
                    }
                    projected: CtValue
                    try { projected = EncodingLite.xml_project_for_decode(document)! }
                    catch error { return CtValue.failed(decode_error_value(error, "XML value cannot be projected for typed decode")) }
                    try { return CtValue.Present(self.typed_decode_top(type_args[0], projected, span)!) }
                    catch error { return CtValue.failed(error) }
                }
                if ["core.encoding.json", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml"].contains(module) && method == "decode" && !type_args.is_empty() {
                    text := match argv.first() {
                        Some(CtValue.Str(s)) => s,
                        _ => { throw unsupported("`{module}.{method}()`: expected a string argument", span) },
                    }
                    return self.eval_typed_decode(module, text, type_args[0], span)
                }
                if module == "core.encoding.json" && (method == "to_string" || method == "to_string_pretty") {
