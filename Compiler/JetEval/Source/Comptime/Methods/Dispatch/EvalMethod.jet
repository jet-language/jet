            if type_name == Syntax.CLOCK_TYPE && method == "new" {
                seed := self.eval(args[0].expr, scope)!
                if CtValue.Int(n) := seed {
                    return CtValue.Struct(type_name: Syntax.CLOCK_TYPE, fields: [("now", CtValue.Int(n))])
                }
                throw unsupported("Clock.new expects an Int seed", span)
            }
            if type_name == Syntax.DURATION_TYPE {
                unit := Syntax.duration_unit_for_constructor(method)
                    .ok_or_else(() => Diagnostics.unsupported("`{type_name}.{method}()`", span))!
                scale: I64 = match unit {
                    "Nanoseconds" => 1, "Microseconds" => 1_000, "Milliseconds" => 1_000_000,
                    "Seconds" => 1_000_000_000, "Minutes" => 60_000_000_000, "Hours" => 3_600_000_000_000,
                    _ => panic("Syntax returned a closed duration unit"),
                }
                value := self.eval(args[0].expr, scope)!
                (ns, reason) := match value {
                    CtValue.Int(n) => (DurationKernel.jet_duration_kernel_from_int(n, scale), DurationKernel.jet_duration_kernel_int_error_reason()),
                    CtValue.Float(n) => (DurationKernel.jet_duration_kernel_from_float(n.as_f64(), scale), DurationKernel.jet_duration_kernel_float_error_reason()),
                    _ => (None, DurationKernel.jet_duration_kernel_float_error_reason()),
                }
                if n := ns {
                    return CtValue.Present(CtValue.Struct(type_name: Syntax.DURATION_TYPE, fields: [("ns", CtValue.Int(n))]))
                }
                return CtValue.failed(CtValue.Struct(type_name: Syntax.DURATION_RANGE_ERROR_TYPE, fields: [("reason", CtValue.Str(reason))]))
            }
            if type_name == Syntax.SOLVER_TYPE && method == "new" {
                argv: [CtValue] = []
                argv.reserve(args.len())
                for arg in args { argv.push(self.eval(arg.expr, scope)!) }
                return solver_new(argv, span)
            }
            is_builtin_type := numeric_type_from_name(type_name).is_some() || type_name == "Bool" || type_name == "String" || MathLayout.is_math_type(type_name)
            if is_builtin_type {
                argv: [CtValue] = []
                argv.reserve(args.len())
                for arg in args { argv.push(self.eval(arg.expr, scope)!) }
