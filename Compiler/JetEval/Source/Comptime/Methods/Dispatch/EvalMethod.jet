                argv: [CtValue] = []
                argv.reserve(args.len())
                for arg in args { argv.push(self.eval(arg.expr, scope)!) }
                self.poll_repl_interrupt()
                runtime_call := ReplRuntimeCallGuard.new(self.repl_interruptible)
