                        bytes: [U8]
                        // GATE #4494: canonical descriptor-relative nofollow read.
                        try { bytes = CheckReads.read_nofollow_at_root(self.base_dir, OSPath.new(path), SHA256.MAX_TREE_FILE_BYTES)! }
                        catch error { return CtValue.failed(io_error_value(IoErrorOperation.Read, path, error)) }
                        text: String
                        try { text = String.from_utf8(^bytes)! }
