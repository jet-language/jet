                            sql_value := argv.get(1).ok_or_else(() => unsupported("`core.encoding.csv.query()`: missing SQL text", span))!
                            sql := as_string(sql_value, span)!.to_string()
                            path := argv.first().ok_or_else(() => unsupported("`core.encoding.csv.query()`: missing path", span))!
                            read := apply_repl_authorized_core_call_with_type("core.files", "read", [path], span,
                                self.base_dir, &self.sink, self.repl_grants, reborrow_repl_authorizer(&self.repl_authorizer), None)!
                            text := match read {
                                CtValue.Present(value) => match value {
                                    CtValue.Str(text) => text,
                                    _ => { throw unsupported("`core.files.read()` returned non-text data", span) },
                                },
                                other => { return other },
