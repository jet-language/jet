// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:6
fn decode_path(path: String) -> String {
    if path == "$" { return "" }
    if stripped := path.strip_prefix("$.") { return stripped.to_string() }
    return path.strip_prefix('$').unwrap_or(path).to_string()
}

// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:16
fn decode_error_value(error: CtValue, fallback: String) -> CtValue {
    path := ""
    reason := fallback
    match error {
        CtValue.Struct(fields: fields, ..) => {
            for (name, value) in fields {
                if name == "path" {
                    if CtValue.Str(text) := value { path = text; break }
                }
            }
            for (name, value) in fields {
                if name == "reason" {
                    if CtValue.Str(text) := value { reason = text; break }
                }
            }
            path = decode_path(path)
        }
        _ => {}
    }
    return TypedDecode.decode_error_at(path, reason)
}

// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:40
fn decode_xml_error(error: XmlPull.Error) -> CtValue {
    return TypedDecode.decode_error_at(decode_path(error.path), "XML {error.kind:?}: {error.reason}")
}

// Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:51
// Raw Val/None and lowered Present/Clean share the option law at this boundary.
fn option_surface_view(value: CtValue) -> CtValue?? {
    match value {
        CtValue.Present(value) => return Some(Some(^value)),
        CtValue.Failed(CtReport.Clean(_)) => return Some(None),
        CtValue.Enum(type_name: type_name, variant: variant, args: args) => {
            if type_name.is_empty() && variant == "Val" {
                if first := args.first() { return Some(Some(first.1)) }
            }
            if type_name.is_empty() && variant == "None" && args.is_empty() { return Some(None) }
        }
        _ => {}
    }
    return None
}

