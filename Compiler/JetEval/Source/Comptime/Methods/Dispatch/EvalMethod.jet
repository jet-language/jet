                            return CtValue.failed(io_error_value(IoErrorOperation.Read, path, core.io.Error.new(core.io.ErrorKind.InvalidData, error)))
                        }
                        return self.eval_typed_csv_query(text, sql, type_args[0], span)
                    }
                    return apply_impure_core_call_with_type(module, method, ^argv, span, self.base_dir, &self.sink, false, None, None, resolved_ret)
                }
                return apply_core_call_with_type(module, method, ^argv, span, self.repl_mode, resolved_ret)
