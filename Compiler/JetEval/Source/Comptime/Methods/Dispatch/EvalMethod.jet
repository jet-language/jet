                if module == "core.data" && ["csv", "json", "query", "count", "schema", "inner_join", "left_join", "pivot_sum"].contains(method) {
                    arg0_ty := args.first().and_then((arg) => match arg.expr {
                        Expr.Ident(name, _) => self.binding_types.get(name),
                        Expr.MethodCall(resolved_ret: Some(ty), ..) => Some(ty),
                        _ => None,
                    })
                    return self.eval_data_call(method, ^argv, type_args, arg0_ty, resolved_ret, span)
                }
                if module == "core.data" && (method == "line_text" || method == "line_svg") { return apply_data_line_call(method, ^argv, resolved_ret, span) }
                if module == "core.encoding.cbor" && (method == "to_bytes" || method == "to_bytes_canonical") {
                    value := argv.first().ok_or_else(() => unsupported("core.encoding.cbor.to_bytes(): missing arg 0", span))!
                    struct_fields := EncodingLite.cbor_struct_fields(self.structs)
                    root_ty := args.first().and_then((arg) => match arg.expr {
                        Expr.Ident(name, _) => self.binding_types.get(name),
                        Expr.StructLit(type_name: name, type_args: ts, ..) if ts.is_empty() => Some(Type.Named(name)),
                        Expr.StructLit(type_name: name, type_args: ts, ..) => Some(Type.Apply(name: name, args: ts)),
                        Expr.TypedLit(head: Some(ty), ..) => Some(ty),
                        Expr.MethodCall(resolved_ret: Some(ty), ..) => Some(ty),
