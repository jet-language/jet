            if type_name == Syntax.TYPE_BITS && method == "new" {
                return CtValue.Struct(type_name: Syntax.TYPE_BITS, fields: [("bits", CtValue.List([]))])
            }
            if type_name == Syntax.TYPE_TALLY && method == "new" {
                return CtValue.Struct(type_name: Syntax.TYPE_TALLY, fields: [("items", CtValue.List([])), ("counts", CtValue.List([]))])
            }
            if type_name == Syntax.TYPE_SET && method == "from" {
