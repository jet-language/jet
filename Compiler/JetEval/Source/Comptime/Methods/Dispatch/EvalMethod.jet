                            "wrap the comptime binding in `#Impure(\"reason\") { … }` and pass `--gate impure=allow` to the build", Some(span))
                    }
                    if !Policy.resolve_invocation(Policy.PolicyKey.Impure, self.gates).unwrap_or(false) {
