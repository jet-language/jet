            if Expr.Field(base, type_name, _) := receiver {
                if Expr.Ident(alias, _) := base {
                    module := self.core_imports.get(alias)
                    if module == Some("core.encoding.xml") {
                        if type_name == "XMLLimits" { return EncodingLite.xml_safe_limits_value() }
                        if type_name == "XMLParseOptions" { return EncodingLite.xml_safe_options_value() }
                        if type_name == "XMLRenderOptions" { return EncodingLite.xml_safe_render_options_value() }
                    }
                    if module == Some("core.email") && type_name == "Limits" { return EmailAdapter.limits_safe_value() }
                    if module == Some("core.data") && type_name == "DataLimits" { return DataPipeline.data_limits_safe_value() }
                }
            }
        }
        if method == "new" {
            solver_ctor := match receiver {
                Expr.Ident(type_name, _) => type_name == Syntax.SOLVER_TYPE,
                Expr.Field(base, type_name, _) => {
                    match base {
                        Expr.Ident(alias, _) => type_name == Syntax.SOLVER_TYPE && self.core_imports.get(alias) == Some("core.compute.solve"),
                        _ => false,
                    }
                },
                _ => false,
            }
            if solver_ctor {
                argv: [CtValue] = []
                argv.reserve(args.len())
                for arg in args { argv.push(self.eval(arg.expr, scope)!) }
                return solver_new(argv, span)
            }
        }
        if Expr.Ident(type_name, _) := receiver {
            if range := self.distinct_ranges.get(type_name) {
                if base := self.distinct_bases.get(type_name) {
                    if !base.is_numeric() && Syntax.conversion_method_for_source(base.name()) == method && args.len() == 1 {
                        return self.eval(args[0].expr, scope)
                    }
                }
                if Syntax.numeric_conversion_source(method).is_some() && args.len() == 1 {
                    base := self.distinct_bases.get(type_name).ok_or_else(() => unsupported("a distinct conversion without its base type", span))!
                    value := self.eval(args[0].expr, scope)!
                    converted := Builtins.apply_static_type_method(base.name(), method, [^value], span)
                        .ok_or_else(() => unsupported("this distinct numeric conversion", span))!!
                    // Rust: crates/jet-comptime/src/Comptime/Methods/dispatch/eval_method.rs:224
                    check_range := (value: CtValue) -> CtValue Diagnostic! {
                        if bounds := range {
                            (lo, hi) := bounds
                            n := as_int(value, args[0].expr.span())!
                            if n >= lo && n <= hi { return CtValue.Present(CtValue.Int(n)) }
                            return CtValue.failed(CtValue.Str("{n} out of range {lo}..{hi}"))
                        }
                        return value
                    }
                    if bounds := range {
                        if n := literal_int(args[0].expr) {
                            if n >= bounds.0 && n <= bounds.1 { return CtValue.Int(n) }
                        }
                    }
                    match converted {
                        CtValue.Present(value) if range.is_some() => return check_range(^value),
                        CtValue.Failed(CtReport.Told(error)) if range.is_some() => return CtValue.Failed(CtReport.Told(error)),
                        value => return check_range(^value),
                    }
                }
            }
        }
        if Expr.Ident(type_name, _) := receiver {
            if type_name == Syntax.MEM_POOL && method == "new" { return Pool.new_value() }
            if type_name == Syntax.TYPE_BYTES && (method == "new" || method == "from") {
                bytes := if method == "new" { [] } else { as_bytes(self.eval(args[0].expr, scope)!, span)! }
                return CtValue.Struct(type_name: Syntax.TYPE_BYTES, fields: [("bytes", CtValue.Bytes(^bytes))])
            }
            if type_name == Syntax.TYPE_LRU && method == "new" {
                capacity := as_int(self.eval(args[0].expr, scope)!, span)!.max(0)
                return CtValue.Struct(type_name: Syntax.TYPE_LRU, fields: [("capacity", CtValue.Int(capacity)), ("entries", CtValue.List([]))])
            }
            if type_name == Syntax.TYPE_QUEUE && method == "new" {
                return CtValue.Struct(type_name: Syntax.TYPE_QUEUE, fields: [("items", CtValue.List([]))])
            }
            if type_name == Syntax.TYPE_QUEUE && method == "init" {
                items := match self.eval(args[0].expr, scope)! {
