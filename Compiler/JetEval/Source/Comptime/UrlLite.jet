fn from_core_record(scheme: &String, user_text: &String, password_text: &String, host: &String, port: I64, port_explicit: Bool, path: &String, query: &String, fragment: &String) -> JetURLParts {
    JetURLParts.from_core_record(scheme, user_text, password_text, host, port, port_explicit, path, query, fragment)
}
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:73
fn parse(input: &String) -> JetURLParts Err! { JetURLParts.parse(input) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:77
fn validate_typed_url_literal(literals: &[String]) -> Unit Err! { jet_validate_typed_url_literal(literals) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:82
fn typed_url_literal(literals: &[String], holes: &[String]) -> JetURLParts { jet_typed_url_parts_literal(literals, holes.to_vec()) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:87
fn from_parts(scheme: &String, host: &String, path: &String, query: &[[String]], fragment: &String) -> JetURLParts Err! { JetURLParts.from_parts(scheme, host, path, query, fragment) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:103
fn file(path: &String) -> JetURLParts { JetURLParts.file(path) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:107
fn data(mime_rendered: &String, text: &String) -> JetURLParts {
    mime := JetMIME.parse(mime_rendered).unwrap_or_else(fn(_) { JetMIME { top: mime_rendered.to_string(), sub: "", parameters: [] } })
    JetURLParts.data(&mime, text)
}
