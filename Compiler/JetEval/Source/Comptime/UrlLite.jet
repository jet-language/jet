fn render_query(pairs: &[(String,String)]) -> String { jet_url_render_query(pairs) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:33
fn percent_encode(value: &String) -> String { jet_url_percent_encode(value, false) }
// Rust: crates/jet-comptime/src/Comptime/UrlLite.rs:37
fn percent_decode(value: &String) -> String Err! { jet_url_percent_decode_str(value) }
