//RS /// The one wording for a zero divisor, shared by `%` and by `/%`
//RS /// (D-FLOORDIV1=A). `Prelude/Core/Division.rs` carries the same text.
//RS pub const INTEGER_DIVIDE_ZERO: &str = "divided by zero";
//RS /// D-EXPSEM1=A: the two power traps. `Prelude/Core/Power.rs` is the one place
//RS /// the rule lives; these constants carry its exact wording to the tiers that
//RS /// cannot include that file — the comptime interpreter and the Cranelift host.
//RS /// `tests/power_and_exclusive_or.rs` proves the Prelude text still matches, so
//RS /// the wordings cannot drift apart.
//RS pub const INTEGER_POWER_NEGATIVE: &str =
//RS     "a negative exponent has no whole-number result (make the base a Float to raise it to a negative power)";
//RS pub const INTEGER_POWER_OVERFLOW: &str =
//RS     "this power overflows the value's type (the result is outside its range)";
//RS pub const INTEGER_ROTATE_NEGATIVE: &str = "a rotation count cannot be negative";
//RS /// D-FLOORDIV1=A / D-MODSEM1=A: the division-family traps. Same contract as the
//RS /// power ones above — `Prelude/Core/Division.rs` owns the rule, these carry its
//RS /// exact wording to the tiers that cannot include that file, and
//RS /// `tests/floor_division.rs` proves every tier still reports them.
//RS pub const INTEGER_DIVIDE_OVERFLOW: &str =
//RS     "this division overflows the value's type (the result is outside its range)";
//RS 
//RS /// D-FLOORDIV1=A: the `/%` rule, mirroring `Prelude/Core/Division.rs` for the
//RS /// tiers that cannot include that file. Rust's `/` rounds toward zero, so an
//RS /// answer whose remainder falls on the other side of zero from the divisor sat
//RS /// one step too high. `None` means the division itself overflowed.
//RS pub fn floor_div(left: i128, right: i128) -> Option<i128> {
//RS     let quotient = left.checked_div(right)?;
//RS     let remainder = left % right;
//RS     if remainder != 0 && (remainder < 0) != (right < 0) {
//RS         quotient.checked_sub(1)
//RS     } else {
//RS         Some(quotient)
//RS     }
//RS }
//RS 
//RS /// D-MODSEM1=A: the `%` rule, mirroring `Prelude/Core/Division.rs`. Rust's `%`
//RS /// gives the remainder the dividend's sign; the floored modulo takes the
//RS /// divisor's, so the answer is moved across when the two disagree. `None`
//RS /// means the remainder itself overflowed.
//RS pub fn floored_mod(left: i128, right: i128) -> Option<i128> {
//RS     if right == 0 {
//RS         return None;
//RS     }
//RS     // `MIN % -1` is 0 and fits every width, so it answers rather than trapping.
//RS     let remainder = left.wrapping_rem(right);
//RS     if remainder != 0 && (remainder < 0) != (right < 0) {
//RS         remainder.checked_add(right)
//RS     } else {
//RS         Some(remainder)
//RS     }
//RS }
