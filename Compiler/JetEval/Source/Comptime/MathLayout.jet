// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:781
fn mat_mul(n: USize, a: &[F64], b: &[F64]) -> [F64] {
    r := [F64].filled(n * n, 0.0)
    loop c in 0..n { loop row in 0..n {
        acc := 0.0
        loop k in 0..n { acc += a[k * n + row] * b[c * n + k] }
        r[c * n + row] = acc
    } }
    r
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:795
fn mat_transform(n: USize, m: &[F64], v: &[F64]) -> [F64] {
    r := [F64].filled(n, 0.0)
    loop row in 0..n {
        a := 0.0
        loop k in 0..n { a += m[k * n + row] * v[k] }
        r[row] = a
    }
    r
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:808
fn list_to_lanes(args: &[CtValue], n: USize, span: Span) -> [F64] Diagnostic! {
    list :: if args.first() == { .Val(.List(items)) -> items; else -> return .Err(unsupported("from_array expects a fixed list", span)) }
    if list.len() != n -> return .Err(unsupported("from_array expects {n} elements", span))
    list.iter().map(fn(v) { as_lane(v, span) }).collect()
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:822
fn list_to_int_lanes(args: &[CtValue], n: USize, name: String, span: Span) -> [I64] Diagnostic! {
    list :: if args.first() == { .Val(.List(items)) -> items; else -> return .Err(unsupported("from_array expects a fixed list", span)) }
    if list.len() != n -> return .Err(unsupported("from_array expects {n} elements", span))
    list.iter().map(fn(value) { as_int_lane(value, name, span) }).collect()
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:843
fn apply_geometry_method(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    if recv != .Struct{type_name, ..} -> return .Err(unsupported("malformed geometry carrier", span))
    if type_name == "Transform" || type_name == "Transform2" {
        (name, matrix, from, to) :: geometry_transform(recv, span)?
        return if (method, args) == {
            ("then", [next]) -> {
                (_, nm, next_from, next_to) :: geometry_transform(next, span)?
                if to != 0 && next_from != 0 && to != next_from -> return geometry_failed("transform composition has mismatched frame identity")
                composed :: [F64; 6]{nm[0] * matrix[0] + nm[1] * matrix[2], nm[0] * matrix[1] + nm[1] * matrix[3], nm[2] * matrix[0] + nm[3] * matrix[2], nm[2] * matrix[1] + nm[3] * matrix[3], nm[0] * matrix[4] + nm[1] * matrix[5] + nm[4], nm[2] * matrix[4] + nm[3] * matrix[5] + nm[5]}
                CtValue.Present(geometry_transform_value(name, composed, from, next_to))
            }
            ("inverse", []) -> {
                det :: matrix[0] * matrix[3] - matrix[1] * matrix[2]
                if !det.is_finite() || det.abs() <= F64.EPSILON -> return geometry_failed("transform is singular and has no inverse")
                inv_det :: 1.0 / det
                inverse :: [F64; 6]{matrix[3] * inv_det, -matrix[1] * inv_det, -matrix[2] * inv_det, matrix[0] * inv_det, (matrix[1] * matrix[5] - matrix[3] * matrix[4]) * inv_det, (matrix[2] * matrix[4] - matrix[0] * matrix[5]) * inv_det}
                CtValue.Present(geometry_transform_value(name, inverse, to, from))
            }
            ("point", [point]) -> {
                (_, x, y, frame) :: geometry_coord(point, span)?
                if frame != 0 && frame != from -> return geometry_failed("coordinate point belongs to a stale frame")
                CtValue.Present(geometry_coord_value("Point2", matrix[0] * x + matrix[1] * y + matrix[4], matrix[2] * x + matrix[3] * y + matrix[5], to))
            }
            ("point_at_depth", [point, depth]) -> {
                depth :: geometry_float(depth, "perspective depth", span)?
                if !depth.is_finite() -> return geometry_failed("perspective depth must be finite")
                (_, x, y, frame) :: geometry_coord(point, span)?
                if frame != 0 && frame != from -> return geometry_failed("coordinate point belongs to a stale frame")
                CtValue.Present(geometry_coord_value("Point2", matrix[0] * x + matrix[1] * y + matrix[4] + matrix[0] * depth, matrix[2] * x + matrix[3] * y + matrix[5] + matrix[2] * depth, to))
            }
            ("ray", [point]) -> {
                (_, x, y, frame) :: geometry_coord(point, span)?
                if frame != 0 && frame != from -> return geometry_failed("coordinate point belongs to a stale frame")
                origin :: geometry_coord_value("Point2", matrix[0] * x + matrix[1] * y + matrix[4], matrix[2] * x + matrix[3] * y + matrix[5], to)
                direction :: geometry_coord_value("Delta2", matrix[0], matrix[2], to)
                CtValue.Present(CtValue.Struct{type_name: "Ray2", fields: [("origin", ^origin), ("direction", ^direction)]})
            }
            else -> return .Err(unsupported("`{name}.{method}` has no geometry method", span))
        }
    }
    if geometry_is_point(type_name) || geometry_is_delta(type_name) {
        (_, x, y, frame) :: geometry_coord(recv, span)?
        if args != [other] -> return .Err(unsupported("`{type_name}.{method}` expects one coordinate", span))
        (other_name, ox, oy, other_frame) :: geometry_coord(other, span)?
        dynamic :: type_name == "Point2" || type_name == "Delta2" || other_name == "Point2" || other_name == "Delta2"
        if dynamic && frame != 0 && other_frame != 0 && frame != other_frame -> return geometry_failed("coordinate values belong to different frames")
        frame :: if frame != 0 -> frame else -> other_frame
        output_name :: if method == "add" && geometry_is_point(type_name) -> geometry_point_result_name(type_name, dynamic) else if method == "sub" && geometry_is_point(type_name) && geometry_is_point(other_name) -> geometry_delta_result_name(type_name, dynamic) else if geometry_is_delta(type_name) -> geometry_delta_result_name(type_name, dynamic) else -> type_name
        value :: if method == {
            "add" if (geometry_is_point(type_name) && geometry_is_delta(other_name)) || (geometry_is_delta(type_name) && geometry_is_delta(other_name)) -> geometry_coord_value(output_name, x + ox, y + oy, frame)
            "sub" if (geometry_is_point(type_name) && (geometry_is_delta(other_name) || geometry_is_point(other_name))) || (geometry_is_delta(type_name) && geometry_is_delta(other_name)) -> geometry_coord_value(output_name, x - ox, y - oy, frame)
            else -> return .Err(unsupported("`{type_name}.{method}` has no geometry method", span))
        }
        return if dynamic -> CtValue.Present(^value) else -> value
    }
    .Err(unsupported("`{type_name}.{method}` has no geometry method", span))
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1016
pub fn apply_static(type_name: String, method: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if apply_geometry_static(type_name, method, &args, span) == .Val(result) -> return Val(result)
    if !is_math_type(type_name) -> return None
    n :: arity(type_name)?
    Val((fn() -> CtValue Diagnostic! {
        if method == {
            "new" -> {
                if args.len() != n -> return .Err(unsupported("`{type_name}.new` needs {n} lane arguments", span))
                if integer_lane_layout(type_name).is_some() -> from_int_lanes(type_name, &list_to_int_lanes(&args, n, type_name, span)?) else -> {
                    values := list_to_lanes(&args, n, span)?
                    loop value in &values { value = narrow_lane(type_name, value) }
                    from_lanes(type_name, &values)
                }
            }
            "splat" -> {
                arg :: args.first() ?? return .Err(unsupported("`{type_name}.splat` needs one argument", span))
                if integer_lane_layout(type_name).is_some() -> from_int_lanes(type_name, &simd_lanes.jet_simd_splat_slice(as_int_lane(arg, type_name, span)?, n)) else -> from_lanes(type_name, &simd_lanes.jet_simd_splat_slice(narrow_lane(type_name, as_lane(arg, span)?), n))
            }
            "from_array" -> {
                if integer_lane_layout(type_name).is_some() -> from_int_lanes(type_name, &list_to_int_lanes(&args, n, type_name, span)?) else -> {
                    values := list_to_lanes(&args, n, span)?
                    loop value in &values { value = narrow_lane(type_name, value) }
                    from_lanes(type_name, &values)
                }
            }
            else -> return .Err(unsupported("`{type_name}.{method}`", span))
        }
    })())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1096
fn to_array_list(type_name: String, lanes: &[F64]) -> CtValue { CtValue.List(lanes.iter().map(fn(n) { lane_value(type_name, n) }).collect()) }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1100
fn to_int_array_list(type_name: String, lanes: &[I64]) -> CtValue {
    (signed, bits) :: integer_lane_layout(type_name).expect("integer SIMD lane")
    CtValue.List(lanes.iter().map(fn(n) { CtValue.Int(integer_narrow(integer_widen(n, signed), signed, bits)) }).collect())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1110
fn reduce_op(name: String, lanes: &[F64], op: String) -> F64? {
    op :: simd_reduce_op(op)?
    if is_f32_lanes(name) {
        values :: lanes.iter().map(fn(value) { value as F32 }).collect<[F32]>()
        return simd_lanes.jet_simd_reduce_slice(&values, op).map(F64.from)
    }
    simd_lanes.jet_simd_reduce_slice(lanes, op)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1119
fn reduce_int_op(name: String, lanes: &[I64], op: String) -> I64? {
    (signed, bits) :: integer_lane_layout(name)?
    simd_lanes.jet_simd_integer_reduce(lanes, simd_reduce_op(op)?, signed, bits)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1124
fn reduce_value(name: String, lanes: &[F64], int_lanes: (&[I64])?, op: String) -> CtValue? {
    if int_lanes == .Val(values) -> return reduce_int_op(name, values, op).map(CtValue.Int)
    reduce_op(name, lanes, op).map(fn(value) { lane_value(name, value) })
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1131
pub fn apply_method(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if is_geometry_value(recv) -> return Val(apply_geometry_method(recv, method, args, span))
    (name, vals) :: lanes(recv)?
    int_vals :: integer_lanes(recv).map(fn(pair) { pair.1 })
    Val((fn() -> CtValue Diagnostic! {
        if (method, args.len()) == {
            ("to_array", 0) -> int_vals.as_deref().map_or_else(fn() { to_array_list(name, &vals) }, fn(values) { to_int_array_list(name, values) })
            ("sum", 0) -> reduce_value(name, &vals, int_vals.as_deref(), "sum").unwrap_or_else(fn() { lane_value(name, 0.0) })
            ("product", 0) -> reduce_value(name, &vals, int_vals.as_deref(), "product").unwrap_or_else(fn() { lane_value(name, 0.0) })
            ("min", 0) -> reduce_value(name, &vals, int_vals.as_deref(), "Min").unwrap_or_else(fn() { lane_value(name, 0.0) })
            ("max", 0) -> reduce_value(name, &vals, int_vals.as_deref(), "Max").unwrap_or_else(fn() { lane_value(name, 0.0) })
            ("reduce", 1) -> {
                op :: if args[0] == { .Enum{variant, ..} -> variant; .Str(s) -> s; else -> return .Err(unsupported("reduce expects .Add/.Mul/.Min/.Max/.Avg", span)) }
                reduce_value(name, &vals, int_vals.as_deref(), op).ok_or_else(fn() { unsupported("reduce({op})", span) })?
            }
            ("dot", 1) -> {
                (_, other) :: lanes(&args[0]) ?? return .Err(unsupported("dot argument", span))
                if other.len() != vals.len() -> return .Err(unsupported("dot size mismatch", span))
                acc := 0.0
                loop (a, b) in vals.iter().zip(other.iter()) { acc += a * b }
                CtValue.Float(CtFloat.f64(acc))
            }
            ("cross", 1) if name == Syntax.LINALG_VEC3_TYPE -> {
                (_, o) :: lanes(&args[0]) ?? return .Err(unsupported("cross argument", span))
                if o.len() != 3 -> return .Err(unsupported("cross needs Vec3", span))
                from_lanes(name, &[vals[1] * o[2] - vals[2] * o[1], vals[2] * o[0] - vals[0] * o[2], vals[0] * o[1] - vals[1] * o[0]])
            }
            ("length", 0) -> CtValue.Float(CtFloat.f64(vals.iter().map(fn(n) { n * n }).sum<F64>().sqrt()))
            ("normalize", 0) -> {
                len :: vals.iter().map(fn(n) { n * n }).sum<F64>().sqrt()
                if len == 0.0 -> from_lanes(name, &vals) else -> from_lanes(name, &vals.iter().map(fn(n) { n / len }).collect<[F64]>())
            }
            ("matmul", 1) -> {
                (on, other) :: lanes(&args[0]) ?? return .Err(unsupported("matmul argument", span))
                if on != name -> return .Err(unsupported("matmul type mismatch", span))
                if name != Syntax.LINALG_MAT3_TYPE && name != Syntax.LINALG_MAT4_TYPE -> return .Err(unsupported("matmul on a matrix", span))
                n :: if name == Syntax.LINALG_MAT3_TYPE -> 3 else -> 4
                from_lanes(name, &mat_mul(n, &vals, &other))
            }
            ("transform", 1) -> {
                (n, expect_v) :: if name == Syntax.LINALG_MAT3_TYPE -> (3, Syntax.LINALG_VEC3_TYPE) else if name == Syntax.LINALG_MAT4_TYPE -> (4, Syntax.LINALG_VEC4_TYPE) else -> return .Err(unsupported("transform on a matrix", span))
                (vn, v) :: lanes(&args[0]) ?? return .Err(unsupported("transform argument", span))
                if vn != expect_v -> return .Err(unsupported("transform vector type", span))
                from_lanes(expect_v, &mat_transform(n, &vals, &v))
            }
            ("transpose", 0) -> {
                n :: if name == Syntax.LINALG_MAT3_TYPE -> 3 else if name == Syntax.LINALG_MAT4_TYPE -> 4 else -> return .Err(unsupported("transpose on a matrix", span))
                r := [F64].filled(n * n, 0.0)
                loop c in 0..n { loop row in 0..n { r[c * n + row] = vals[row * n + c] } }
                from_lanes(name, &r)
            }
            else -> return .Err(unsupported("`{name}.{method}`", span))
        }
    })())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:1270
pub fn overflow_opt(mode: String, op: BinOp, left: I64, right: I64, signed: Bool, bits: U8, span: Span) -> CtValue Diagnostic! {
    operation :: if mode == "rotate_left" -> fixed_arithmetic.JET_FIXED_OP_ROTATE_LEFT else if mode == "rotate_right" -> fixed_arithmetic.JET_FIXED_OP_ROTATE_RIGHT else -> fixed_op(op) ?? return .Err(overflow(mode, span))
    fixed_mode :: if mode == {
        Syntax.BUILTIN_WRAPPING -> fixed_arithmetic.JET_FIXED_MODE_WRAPPING
        Syntax.BUILTIN_SATURATING -> fixed_arithmetic.JET_FIXED_MODE_SATURATING
        Syntax.BUILTIN_CHECKED -> fixed_arithmetic.JET_FIXED_MODE_CHECKED
        "checked_policy" -> fixed_arithmetic.JET_FIXED_MODE_TRAP
        "rotate_left" | "rotate_right" -> fixed_arithmetic.JET_FIXED_MODE_WRAPPING
        else -> return .Err(overflow(mode, span))
    }
    fixed_result(fixed_arithmetic.jet_fixed_arithmetic(left, right as I128, operation, fixed_mode, signed, bits, true), signed, bits, mode == Syntax.BUILTIN_CHECKED, span)
}
