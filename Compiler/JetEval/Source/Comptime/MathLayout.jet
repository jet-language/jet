// Scalar-array mirror of shared fixed arithmetic, SIMD lanes and linalg kernels.
use jet_comptime.[Diagnostic, Span, Syntax, BinOp, CtFloat, Type, CtValue, Numeric]
use jet_comptime.Diagnostics.[comptime_panic, overflow, unsupported]
use core.prelude.runtime.[kernel_fixed_arithmetic as fixed_arithmetic, kernel_simd_lanes as simd_lanes]

// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:19
fn fixed_op(op: BinOp) -> I64? {
    if op == {
        .Add -> Val(fixed_arithmetic.JET_FIXED_OP_ADD)
        .Sub -> Val(fixed_arithmetic.JET_FIXED_OP_SUB)
        .Mul -> Val(fixed_arithmetic.JET_FIXED_OP_MUL)
        .Div -> Val(fixed_arithmetic.JET_FIXED_OP_DIV)
        .Rem -> Val(fixed_arithmetic.JET_FIXED_OP_REM)
        .BitAnd -> Val(fixed_arithmetic.JET_FIXED_OP_BIT_AND)
        .BitOr -> Val(fixed_arithmetic.JET_FIXED_OP_BIT_OR)
        .BitXor -> Val(fixed_arithmetic.JET_FIXED_OP_BIT_XOR)
        .Shl -> Val(fixed_arithmetic.JET_FIXED_OP_SHL)
        .Shr -> Val(fixed_arithmetic.JET_FIXED_OP_SHR)
        .Pow -> Val(fixed_arithmetic.JET_FIXED_OP_POW)
        .FloorDiv -> Val(fixed_arithmetic.JET_FIXED_OP_FLOOR_DIV)
        .Mod -> Val(fixed_arithmetic.JET_FIXED_OP_MOD)
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:38
fn fixed_result(result: fixed_arithmetic.JetFixedArithmeticResult, signed: Bool, bits: U8, checked: Bool, span: Span) -> CtValue Diagnostic! {
    if result == {
        .Value(value) -> { value :: integer_value(value, signed, bits); if checked -> CtValue.Present(^value) else -> value }
        .Absent -> CtValue.absent(Type.IntN{signed: signed, bits: bits})
        .Trap(error) -> return .Err(comptime_panic(error.to_string(), span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:64
pub fn integer_type_layout(ty: &Type) -> (Bool, U8)? {
    if ty == {
        .Int -> Val((true, 64))
        .IntN{signed, bits} -> Val((signed, bits))
        .InlineRange{base, ..} -> integer_type_layout(base)
        .Named(name) -> if name == {
            "I8" -> Val((true, 8)); "I16" -> Val((true, 16)); "I32" -> Val((true, 32)); "I64" | "Int" -> Val((true, 64))
            "U8" -> Val((false, 8)); "U16" -> Val((false, 16)); "U32" -> Val((false, 32)); "U64" -> Val((false, 64)); else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:84
pub fn integer_widen(value: I64, signed: Bool) -> I128 { if signed -> value as I128 else -> value as U64 as I128 }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:92
pub fn integer_narrow(value: I128, signed: Bool, bits: U8) -> I64 {
    if bits == 64 -> return value as U64 as I64
    mask :: ((1 as I128) << bits) - 1
    value := value & mask
    if signed && value & ((1 as I128) << (bits - 1)) != 0 { value |= !mask }
    value as I64
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:103
// Preserve full-width unsigned results outside the signed fast carrier.
pub fn integer_value(value: I64, signed: Bool, bits: U8) -> CtValue {
    if !signed && bits == 64 && value < 0 -> CtValue.BigInt(Numeric.CtBigInt.from_u64(value as U64)) else -> CtValue.Int(value)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:113
pub fn integer_show(value: I64, signed: Bool) -> String { if signed -> value.to_string() else -> (value as U64).to_string() }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:123
pub INTEGER_DIVIDE_ZERO :: "divided by zero"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:129
pub INTEGER_POWER_NEGATIVE :: "a negative exponent has no whole-number result (make the base a Float to raise it to a negative power)"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:131
pub INTEGER_POWER_OVERFLOW :: "this power overflows the value's type (the result is outside its range)"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:133
pub INTEGER_ROTATE_NEGATIVE :: "a rotation count cannot be negative"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:138
pub INTEGER_DIVIDE_OVERFLOW :: "this division overflows the value's type (the result is outside its range)"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:145
pub fn floor_div(left: I128, right: I128) -> I128? {
    quotient :: left.checked_div(right)?
    remainder :: left % right
    if remainder != 0 && (remainder < 0) != (right < 0) -> quotient.checked_sub(1) else -> Val(quotient)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:159
pub fn floored_mod(left: I128, right: I128) -> I128? {
    if right == 0 -> return None
    // MIN % -1 is zero and fits every width.
    remainder :: left.wrapping_rem(right)
    if remainder != 0 && (remainder < 0) != (right < 0) -> remainder.checked_add(right) else -> Val(remainder)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:172
MATH_TYPES :: [Syntax.SIMD_F32X4_TYPE, Syntax.SIMD_F64X2_TYPE, Syntax.LINALG_VEC2_TYPE, Syntax.LINALG_VEC3_TYPE, Syntax.LINALG_VEC4_TYPE, Syntax.LINALG_MAT3_TYPE, Syntax.LINALG_MAT4_TYPE]
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:182
pub fn is_math_type(name: String) -> Bool { Syntax.is_simd_lane_type(name) || MATH_TYPES.contains(name) }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:185
GEOMETRY_TYPES :: ["Point2", "Delta2", "Transform", "Transform2", "Ray2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint", "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta"]
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:203
GEOMETRY_FRAME :: "__jet_frame_id"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:204
GEOMETRY_FROM_FRAME :: "__jet_from_frame"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:205
GEOMETRY_TO_FRAME :: "__jet_to_frame"
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:207
pub fn is_geometry_type(name: String) -> Bool { GEOMETRY_TYPES.contains(name) }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:211
pub fn is_geometry_value(value: &CtValue) -> Bool { if value == { .Struct{type_name, ..} -> is_geometry_type(type_name); else -> false } }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:218
fn geometry_field(fields: &[(String, CtValue)], name: String) -> CtValue? { fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { pair.1 }) }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:228
fn geometry_float(value: &CtValue, what: String, span: Span) -> F64 Diagnostic! {
    if value == { .Float(value) -> value.as_f64(); .Int(value) -> value as F64; else -> return .Err(unsupported("geometry {what} must be a Float", span)) }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:239
fn geometry_int(value: &CtValue, what: String, span: Span) -> I64 Diagnostic! {
    if value == { .Int(value) -> value; else -> return .Err(unsupported("geometry {what} must be a FrameId", span)) }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:249
fn geometry_coord(value: &CtValue, span: Span) -> (String, F64, F64, I64) Diagnostic! {
    if value != .Struct{type_name, fields} -> return .Err(unsupported("malformed coordinate carrier", span))
    if !is_geometry_type(type_name) || !(type_name == "Point2" || type_name == "Delta2" || type_name.ends_with("Point") || type_name.ends_with("Delta")) -> return .Err(unsupported("expected a coordinate carrier", span))
    x_value :: geometry_field(&fields, "x") ?? return .Err(unsupported("coordinate carrier is missing x", span))
    x :: geometry_float(&x_value, "x", span)?
    y_value :: geometry_field(&fields, "y") ?? return .Err(unsupported("coordinate carrier is missing y", span))
    y :: geometry_float(&y_value, "y", span)?
    frame :: if geometry_field(&fields, GEOMETRY_FRAME) == { .Val(value) -> geometry_int(&value, "frame identity", span)?; .None -> 0 }
    (type_name.clone(), x, y, frame)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:275
fn geometry_coord_value(type_name: String, x: F64, y: F64, frame: I64) -> CtValue {
    CtValue.Struct{type_name: type_name, fields: [("x", CtValue.Float(CtFloat.f64(x))), ("y", CtValue.Float(CtFloat.f64(y))), (GEOMETRY_FRAME, CtValue.Int(frame))]}
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:286
fn geometry_transform(value: &CtValue, span: Span) -> (String, [F64; 6], I64, I64) Diagnostic! {
    if value != .Struct{type_name, fields} -> return .Err(unsupported("malformed transform carrier", span))
    if type_name != "Transform" && type_name != "Transform2" -> return .Err(unsupported("expected a transform carrier", span))
    matrix := [F64; 6].filled(0.0)
    loop (index, name) in ["m00", "m01", "m10", "m11", "tx", "ty"].iter().enumerate() {
        value :: geometry_field(&fields, name) ?? return .Err(unsupported("transform carrier is missing a matrix field", span))
        matrix[index] = geometry_float(&value, name, span)?
    }
    from :: if geometry_field(&fields, GEOMETRY_FROM_FRAME) == { .Val(value) -> geometry_int(&value, "source frame", span)?; .None -> 0 }
    to :: if geometry_field(&fields, GEOMETRY_TO_FRAME) == { .Val(value) -> geometry_int(&value, "destination frame", span)?; .None -> 0 }
    (type_name.clone(), matrix, from, to)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:309
fn geometry_transform_value(type_name: String, matrix: [F64; 6], from: I64, to: I64) -> CtValue {
    fields :: ["m00", "m01", "m10", "m11", "tx", "ty"].into_iter().zip(matrix).map(fn(pair) { (pair.0, CtValue.Float(CtFloat.f64(pair.1))) }).chain([(GEOMETRY_FROM_FRAME, CtValue.Int(from)), (GEOMETRY_TO_FRAME, CtValue.Int(to))]).collect()
    CtValue.Struct{type_name: type_name, fields: ^fields}
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:330
fn geometry_failed(message: String) -> CtValue { CtValue.failed(CtValue.Str(message)) }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:334
fn geometry_is_point(name: String) -> Bool { name == "Point2" || name.ends_with("Point") }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:338
fn geometry_is_delta(name: String) -> Bool { name == "Delta2" || name.ends_with("Delta") }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:341
fn geometry_point_result_name(name: String, dynamic: Bool) -> String { if dynamic -> "Point2" else -> name }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:348
fn geometry_delta_result_name(name: String, dynamic: Bool) -> String {
    if dynamic -> return "Delta2"
    if name == { "ScreenPoint" -> "ScreenDelta"; "WorldPoint" -> "WorldDelta"; "ViewPoint" -> "ViewDelta"; "CameraPoint" -> "CameraDelta"; "DevicePoint" -> "DeviceDelta"; else -> name }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:362
pub fn apply_geometry_static(type_name: String, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    if !is_geometry_type(type_name) || (method != "new" && method != "affine") -> return None
    Val((fn() -> CtValue Diagnostic! {
        if (type_name, args) == {
            (name, [x, y]) if geometry_is_point(name) || geometry_is_delta(name) -> geometry_coord_value(name, geometry_float(x, "x", span)?, geometry_float(y, "y", span)?, 0)
            (name, [x, y, frame]) if name == "Point2" || name == "Delta2" -> geometry_coord_value(name, geometry_float(x, "x", span)?, geometry_float(y, "y", span)?, geometry_int(frame, "frame identity", span)?)
            (name, [m00, m01, m10, m11, tx, ty, from, to]) if name == "Transform" || name == "Transform2" -> {
                matrix := [F64; 6].filled(0.0)
                loop (index, value) in [m00, m01, m10, m11, tx, ty].into_iter().enumerate() { matrix[index] = geometry_float(value, "matrix component", span)? }
                from :: geometry_int(from, "source frame", span)?
                to :: geometry_int(to, "destination frame", span)?
                geometry_transform_value(name, matrix, from, to)
            }
            else -> return .Err(unsupported("`{type_name}.{method}` has no geometry constructor shape", span))
        }
    })())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:405
pub fn arity(name: String) -> USize? {
    if Syntax.simd_lane_layout(name) == .Val((_, lanes)) -> return Val(lanes)
    if name == { Syntax.LINALG_VEC2_TYPE -> Val(2); Syntax.LINALG_VEC3_TYPE -> Val(3); Syntax.LINALG_VEC4_TYPE -> Val(4); Syntax.LINALG_MAT3_TYPE -> Val(9); Syntax.LINALG_MAT4_TYPE -> Val(16); else -> None }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:419
fn is_f32_lanes(name: String) -> Bool { if Syntax.simd_lane_layout(name) == { .Val((.F32, _)) -> true; else -> false } }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:426
fn integer_lane_layout(name: String) -> (Bool, U8)? {
    if Syntax.simd_lane_layout(name)?.0 == { .I8 -> Val((true, 8)); .I16 -> Val((true, 16)); .I32 -> Val((true, 32)); .I64 -> Val((true, 64)); .U8 -> Val((false, 8)); .U16 -> Val((false, 16)); .U32 -> Val((false, 32)); .U64 -> Val((false, 64)); .F32 | .F64 -> None }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:440
fn lane_value(name: String, n: F64) -> CtValue {
    if integer_lane_layout(name) == .Val((signed, bits)) -> return CtValue.Int(integer_narrow(n as I128, signed, bits))
    if is_f32_lanes(name) -> CtValue.Float(CtFloat.f32(n as F32)) else -> CtValue.Float(CtFloat.f64(n))
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:451
fn as_lane(v: &CtValue, span: Span) -> F64 Diagnostic! {
    if v == {
        .Float(f) -> f.as_f64()
        .Int(n) -> n as F64
        .Struct{type_name, ..} if type_name == Syntax.TYPE_DECIMAL -> Numeric.CtDecimal.from_value(v).map(fn(decimal) { decimal.to_f64() }).map_err(fn(error) { unsupported(error.message, span) })?
        else -> return .Err(unsupported("math component must be a Float", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:464
pub fn from_lanes(type_name: String, lanes: &[F64]) -> CtValue {
    CtValue.Struct{type_name: type_name, fields: lanes.iter().enumerate().map(fn(pair) { (field_name(type_name, pair.0), lane_value(type_name, pair.1)) }).collect()}
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:476
fn from_int_lanes(type_name: String, lanes: &[I64]) -> CtValue {
    (signed, bits) :: integer_lane_layout(type_name).expect("integer SIMD lane")
    CtValue.Struct{type_name: type_name, fields: lanes.iter().enumerate().map(fn(pair) { (field_name(type_name, pair.0), CtValue.Int(integer_narrow(integer_widen(pair.1, signed), signed, bits))) }).collect()}
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:494
fn geometry_binop(op: BinOp, left: &CtValue, right: &CtValue, span: Span) -> (CtValue Diagnostic!)? {
    if !is_geometry_value(left) && !is_geometry_value(right) -> return None
    Val((fn() -> CtValue Diagnostic! {
        (left_name, lx, ly, left_frame) :: geometry_coord(left, span)?
        (right_name, rx, ry, right_frame) :: geometry_coord(right, span)?
        dynamic :: left_name == "Point2" || left_name == "Delta2" || right_name == "Point2" || right_name == "Delta2"
        wrap :: fn(value) { if dynamic -> CtValue.Present(^value) else -> value }
        if dynamic && left_frame != 0 && right_frame != 0 && left_frame != right_frame && (op == .Add || op == .Sub) -> return geometry_failed("coordinate values belong to different frames")
        frame :: if left_frame != 0 -> left_frame else -> right_frame
        if op == {
            .Add if geometry_is_point(left_name) && geometry_is_delta(right_name) -> wrap(geometry_coord_value(geometry_point_result_name(left_name, dynamic), lx + rx, ly + ry, frame))
            .Add if geometry_is_delta(left_name) && geometry_is_point(right_name) -> wrap(geometry_coord_value(geometry_point_result_name(right_name, dynamic), lx + rx, ly + ry, frame))
            .Add if geometry_is_delta(left_name) && geometry_is_delta(right_name) -> wrap(geometry_coord_value(geometry_delta_result_name(left_name, dynamic), lx + rx, ly + ry, frame))
            .Sub if geometry_is_point(left_name) && geometry_is_delta(right_name) -> wrap(geometry_coord_value(geometry_point_result_name(left_name, dynamic), lx - rx, ly - ry, left_frame))
            .Sub if geometry_is_point(left_name) && geometry_is_point(right_name) -> wrap(geometry_coord_value(geometry_delta_result_name(left_name, dynamic), lx - rx, ly - ry, left_frame))
            .Sub if geometry_is_delta(left_name) && geometry_is_delta(right_name) -> wrap(geometry_coord_value(geometry_delta_result_name(left_name, dynamic), lx - rx, ly - ry, left_frame))
            .Eq -> CtValue.Bool(lx == rx && ly == ry && left_frame == right_frame)
            .Ne -> CtValue.Bool(!(lx == rx && ly == ry && left_frame == right_frame))
            else -> return .Err(unsupported("this coordinate-space operator", span))
        }
    })())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:590
pub fn eval_binop(op: BinOp, left: &CtValue, right: &CtValue, span: Span) -> (CtValue Diagnostic!)? {
    if geometry_binop(op, left, right, span) == .Val(result) -> return Val(result)
    (ln, ll) :: lanes(left)?
    (rn, rl) :: lanes(right)?
    Val((fn() -> CtValue Diagnostic! {
        if ln == rn && integer_lane_layout(ln).is_some() {
            (_, left) :: integer_lanes(left) ?? return .Err(unsupported("integer math lanes", span))
            (_, right) :: integer_lanes(right) ?? return .Err(unsupported("integer math lanes", span))
            return from_int_lanes(ln, &zip_int_op(op, &left, &right, ln, span)?)
        }
        if ln != rn {
            if op == .Mul {
                if ln == Syntax.LINALG_MAT3_TYPE && rn == Syntax.LINALG_VEC3_TYPE -> return from_lanes(rn, &mat_transform(3, &ll, &rl))
                if ln == Syntax.LINALG_MAT4_TYPE && rn == Syntax.LINALG_VEC4_TYPE -> return from_lanes(rn, &mat_transform(4, &ll, &rl))
            }
            return .Err(unsupported("mixing math types", span))
        }
        out :: if (ln == Syntax.LINALG_MAT3_TYPE || ln == Syntax.LINALG_MAT4_TYPE) && op == .Mul -> mat_mul(if ln == Syntax.LINALG_MAT3_TYPE -> 3 else -> 4, &ll, &rl) else -> zip_op(op, &ll, &rl, ln) ?? return .Err(unsupported("this math operator", span))
        from_lanes(ln, &out)
    })())
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:637
fn field_name(type_name: String, index: USize) -> String {
    if type_name == {
        Syntax.LINALG_VEC2_TYPE | Syntax.LINALG_VEC3_TYPE | Syntax.LINALG_VEC4_TYPE -> ["x", "y", "z", "w"][index]
        Syntax.LINALG_MAT3_TYPE -> "m{index % 3}{index / 3}"
        Syntax.LINALG_MAT4_TYPE -> "m{index % 4}{index / 4}"
        else -> index.to_string()
    }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:648
pub fn lanes(value: &CtValue) -> (String, [F64])? {
    if value != .Struct{type_name, fields} -> return None
    if !is_math_type(type_name) -> return None
    n :: arity(type_name)?
    if fields.len() != n -> return None
    out := [F64].with_capacity(n)
    loop i in 0..n {
        key :: field_name(type_name, i)
        (_, v) :: fields.iter().find(fn(pair) { pair.0 == key })?
        out.push(if v == { .Float(f) -> f.as_f64(); .Int(n) -> n as F64; else -> return None })
    }
    Val((type_name, ^out))
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:672
fn integer_lanes(value: &CtValue) -> (String, [I64])? {
    if value != .Struct{type_name, fields} -> return None
    (signed, bits) :: integer_lane_layout(type_name)?
    n :: arity(type_name)?
    if fields.len() != n -> return None
    out := [I64].with_capacity(n)
    loop i in 0..n {
        key :: field_name(type_name, i)
        (_, value) :: fields.iter().find(fn(pair) { pair.0 == key })?
        if value != .Int(value) -> return None
        out.push(integer_narrow(integer_widen(value, signed), signed, bits))
    }
    Val((type_name, ^out))
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:693
fn as_int_lane(value: &CtValue, name: String, span: Span) -> I64 Diagnostic! {
    (signed, bits) :: integer_lane_layout(name).expect("integer SIMD lane")
    if value == { .Int(value) -> integer_narrow(integer_widen(value, signed), signed, bits); else -> return .Err(unsupported("math component must be an integer", span)) }
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:701
pub fn construct(name: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    n :: arity(name) ?? return .Err(unsupported("`{name}`", span))
    if args.len() != n -> return .Err(unsupported("`{name}` expects {n} components", span))
    if integer_lane_layout(name).is_some() {
        values :: args.iter().map(fn(arg) { as_int_lane(arg, name, span) }).collect<[I64] Diagnostic!>()?
        return from_int_lanes(name, &values)
    }
    values := [F64].with_capacity(n)
    loop arg in args { values.push(narrow_lane(name, as_lane(arg, span)?)) }
    from_lanes(name, &values)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:725
fn narrow_lane(name: String, n: F64) -> F64 {
    if integer_lane_layout(name) == .Val((signed, bits)) -> return integer_narrow(n as I128, signed, bits) as F64
    if is_f32_lanes(name) -> n as F32 as F64 else -> n
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:736
fn simd_binary_op(op: BinOp) -> simd_lanes.JetSimdBinaryOp? { if op == { .Add -> Val(.Add); .Sub -> Val(.Sub); .Mul -> Val(.Mul); .Div -> Val(.Div); else -> None } }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:746
fn simd_reduce_op(op: String) -> simd_lanes.JetSimdReduceOp? { if op == { "Add" | "sum" -> Val(.Add); "Mul" | "product" -> Val(.Mul); "Min" -> Val(.Min); "Max" -> Val(.Max); "Avg" -> Val(.Avg); else -> None } }
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:757
fn zip_op(op: BinOp, a: &[F64], b: &[F64], name: String) -> [F64]? {
    op :: simd_binary_op(op)?
    if is_f32_lanes(name) {
        left :: a.iter().map(fn(value) { value as F32 }).collect<[F32]>()
        right :: b.iter().map(fn(value) { value as F32 }).collect<[F32]>()
        return simd_lanes.jet_simd_binary_slice(&left, &right, op).map(fn(values) { values.into_iter().map(F64.from).collect() })
    }
    simd_lanes.jet_simd_binary_slice(a, b, op)
}
// Rust: crates/jet-comptime/src/Comptime/MathLayout.rs:768
fn zip_int_op(op: BinOp, a: &[I64], b: &[I64], name: String, span: Span) -> [I64] Diagnostic! {
    (signed, bits) :: integer_lane_layout(name).expect("integer SIMD lane")
    op :: simd_binary_op(op) ?? return .Err(unsupported("this math operator", span))
    simd_lanes.jet_simd_integer_binary(a, b, op, signed, bits).ok_or_else(fn() { unsupported("this math operator", span) })
