pub fn autodiff_vjp_pull(output: &CtValue, anchor: &CtValue, seed: &CtValue, targets: &[I64], span: Span) -> [CtValue] Diagnostic! {
    seed := ct_to_tensor(seed, span)?
    state := autodiff_transform_state("vjp", output, anchor, &[], targets, span)? == { Vjp { state, .. } -> state; _ -> { fail unsupported("compute.vjp result", span) } }
    values := jet_compute_vjp_pull_or_panic(&state, &seed, targets, "compute.vjp.pull")
    values.iter().map(tensor_to_ct).collect()
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:1637
pub fn autodiff_jvp(output: &CtValue, anchor: &CtValue, tangents: &[CtValue], span: Span) -> CtValue Diagnostic! {
    tangent := autodiff_transform_state("jvp", output, anchor, tangents, &[], span)? == { Jvp { tangent, .. } -> tangent; _ -> { fail unsupported("compute.jvp result", span) } }
    tensor_to_ct(&tangent)
}
