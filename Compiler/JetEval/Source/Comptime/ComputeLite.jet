// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:1667
pub fn apply(method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    one := fn(i: USize) { args.get(i).ok_or_else(fn() { unsupported("core.compute.{method} arg {i}", span) }) }
    method == {
        "zeros" -> jet_compute_zeros(&as_i64_list(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "ones" -> jet_compute_ones(&as_i64_list(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "full" -> jet_compute_full(&as_i64_list(one(0)?, span)?, as_float(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "from_list" -> jet_compute_from_list(&as_f64_list(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "matrix" -> jet_compute_matrix(as_int(one(0)?, span)?, as_int(one(1)?, span)?, as_float(one(2)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "vec" -> jet_compute_vec(as_int(one(0)?, span)?, as_float(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "add" -> jet_compute_add(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "mul" -> jet_compute_mul(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "matmul" -> jet_compute_matmul(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "reshape" -> jet_compute_reshape(&ct_to_tensor(one(0)?, span)?, &as_i64_list(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "get" -> jet_compute_get(&ct_to_tensor(one(0)?, span)?, &as_i64_list(one(1)?, span)?) == { Ok(v) -> CtValue.Present(Box.new(CtValue.Float(CtFloat.f64(v)))); Err(e) -> err_compute(e) }
        "set" -> {
            handle := tensor_handle_state(one(0)?, span)?; tensor := handle.tensor.lock().map_err(fn(_) { unsupported("Tensor handle", span) })?
            jet_compute_set(&tensor, &as_i64_list(one(1)?, span)?, as_float(one(2)?, span)?) == {
                Ok(()) -> {
                    snapshot := tensor.clone(); drop(tensor)
                    CtValue.Present(Box.new(CtValue.Struct { type_name: "__JetComputeSet", fields: [("tensor", tensor_to_ct_with_handle(&snapshot, Arc.clone(&handle.tensor), handle.valid, true)), ("unit", CtValue.Unit)] }))
                }
                Err(e) -> err_compute(e)
            }
        }
        "shape" -> CtValue.List(jet_compute_tensor_shape(&ct_to_tensor(one(0)?, span)?).into_iter().map(CtValue.Int).collect())
        "rank" -> CtValue.Int(jet_compute_tensor_rank(&ct_to_tensor(one(0)?, span)?))
        "numel" -> CtValue.Int(jet_compute_tensor_numel(&ct_to_tensor(one(0)?, span)?))
        "to_list" -> CtValue.List(jet_compute_tensor_to_list(&ct_to_tensor(one(0)?, span)?).into_iter().map(fn(v) { CtValue.Float(CtFloat.f64(v)) }).collect())
        "device" -> CtValue.Str(jet_compute_tensor_device(&ct_to_tensor(one(0)?, span)?))
        "placement" -> CtValue.Str(jet_compute_tensor_placement(&ct_to_tensor(one(0)?, span)?))
        "device_cpu" -> device_to_ct(jet_compute_device_cpu()); "device_auto" -> device_to_ct(jet_compute_device_auto())
        "device_metal" -> device_to_ct(jet_compute_device_metal()); "device_cuda" -> device_to_ct(jet_compute_device_cuda())
        "device_vulkan" -> device_to_ct(jet_compute_device_vulkan()); "device_webgpu" -> device_to_ct(jet_compute_device_webgpu())
        "on_device" -> jet_compute_on_device(&ct_to_tensor(one(0)?, span)?, ct_to_device(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "broadcast_to" -> jet_compute_broadcast_to(&ct_to_tensor(one(0)?, span)?, &as_i64_list(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "transpose" -> jet_compute_transpose(&ct_to_tensor(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "sum_axis" -> jet_compute_sum_axis(&ct_to_tensor(one(0)?, span)?, as_int(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "negate" | "abs" | "exp" | "log" | "sqrt" -> jet_compute_unary(method, &ct_to_tensor(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "sub" | "div" | "maximum" | "minimum" -> jet_compute_binary(method, &ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "eye" -> jet_compute_eye(as_int(one(0)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "det" -> jet_compute_det(&ct_to_tensor(one(0)?, span)?) == { Ok(v) -> CtValue.Present(Box.new(CtValue.Float(CtFloat.f64(v)))); Err(e) -> err_compute(e) }
        "inv" | "fft" -> {
            tensor := ct_to_tensor(one(0)?, span)?
            result := if method == "inv" { jet_compute_inv(&tensor) } else { jet_compute_fft(&tensor) }
            result == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        }
        "solve" -> jet_compute_solve(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "stream_new" -> stream_to_ct(&jet_compute_stream_new())
        "stream_new_on" -> jet_compute_stream_new_on_device(ct_to_device(one(0)?, span)?) == { Ok(s) -> stream_to_ct(&s); Err(e) -> err_compute(e) }
        "stream_sync" -> jet_compute_stream_sync(&ct_to_stream(one(0)?, span)?) == { Ok(()) -> CtValue.Present(Box.new(CtValue.Unit)); Err(e) -> err_compute(e) }
        "stream_show" -> CtValue.Str(jet_compute_stream_show(&ct_to_stream(one(0)?, span)?))
        "transfer" -> jet_compute_transfer(&ct_to_tensor(one(0)?, span)?, ct_to_device(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "transfer_show" -> CtValue.Str(jet_compute_transfer_show(&ct_to_tensor(one(0)?, span)?))
        "kernel_bounds_ok" -> jet_compute_kernel_bounds_ok(&as_i64_list(one(0)?, span)?, &as_i64_list(one(1)?, span)?) == { Ok(b) -> CtValue.Present(Box.new(CtValue.Bool(b))); Err(e) -> err_compute(e) }
        "mse_loss" -> jet_compute_mse_loss(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "sgd_step" -> jet_compute_sgd_step(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?, as_float(one(2)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "serialize" -> jet_compute_serialize(&ct_to_tensor(one(0)?, span)?) == { Ok(p) -> CtValue.Present(Box.new(CtValue.Str(p))); Err(e) -> err_compute(e) }
        "deserialize" -> {
            payload := one(0)? == { Str(s) -> s.clone(); _ -> { fail unsupported("serialize payload", span) } }
            jet_compute_deserialize(&payload) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        }
        "to_sparse" -> jet_compute_to_sparse(&ct_to_tensor(one(0)?, span)?) == { Ok(s) -> ok_sparse(s); Err(e) -> err_compute(e) }
        "sparse_nnz" -> CtValue.Int(jet_compute_sparse_nnz(&ct_to_sparse(one(0)?, span)?))
        "sparse_mv" -> jet_compute_sparse_mv(&ct_to_sparse(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "sparse_show" -> CtValue.Str(jet_compute_sparse_show(&ct_to_sparse(one(0)?, span)?))
        "matmul_f32_tile" -> jet_compute_matmul_f32_tile(&ct_to_tensor(one(0)?, span)?, &ct_to_tensor(one(1)?, span)?) == { Ok(t) -> ok_tensor(t); Err(e) -> err_compute(e) }
        "profile_f32_strict" | "profile_show" -> CtValue.Str(jet_compute_profile_show())
        _ -> { fail unsupported("`core.compute.{method}()`", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:1979
pub fn take_set_ok(value: &CtValue) -> (CtValue, CtValue)? {
    inner := value == { Present(inner) -> inner; _ -> { return None } }
    (type_name, fields) := inner.as_ref() == { Struct { type_name, fields } -> (type_name, fields); _ -> { return None } }
    if type_name != "__JetComputeSet" { return None }
    tensor := fields.iter().find(fn(e) { e.0 == "tensor" })?.1.clone()
    Val((tensor, CtValue.Present(Box.new(CtValue.Unit))))
}
