// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:326
fn opaque_closure<T: std.any.Any + Send + Sync>(opaque: T) -> CtValue {
    CtValue.Closure(Arc.new(ClosureData {
        lambda: Lambda { take_names: [], params: [], result_type: None, error_type: None, effects: None, body: LambdaBody.Block([]), span: Span.new(0, 0), meta: LambdaMeta.default() },
        captured: [:], return_type: None, opaque: Val(CtOpaque.new(opaque))
    }))
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:344
const TENSOR_WINDOW_HANDLE_FIELD: String = "__jet_tensor_window_handle"
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:346
pub fn tensor_window_handle(value: &CtValue, span: Span) -> CtValue Diagnostic! {
    tensor := tensor_handle_state(value, span)?
