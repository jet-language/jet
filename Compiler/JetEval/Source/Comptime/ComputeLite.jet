    vulkan := if device == JetComputeDevice.Vulkan { Val(Arc.new(jet_compute_vulkan.stream_new().map_err(fn(_) { unsupported("Vulkan compute stream", span) })?)) } else { None }
    id := field("id")? == { Int(n) if n > 0 -> n; _ -> { fail unsupported("compute stream id", span) } }
    JetComputeStream { id, device, cuda, vulkan }
