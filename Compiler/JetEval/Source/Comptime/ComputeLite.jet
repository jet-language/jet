    tape := anchor.trace.as_ref().and_then(fn(t) { t.tape.upgrade() }).or_else(fn() { output.trace.as_ref().and_then(fn(t) { t.tape.upgrade() }) }).unwrap_or_else(jet_compute_empty_tape)
