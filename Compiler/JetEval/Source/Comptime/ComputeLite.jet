pub fn autodiff_unit_grads(output: &CtValue, anchor: &CtValue, targets: &[I64], span: Span) -> [CtValue] Diagnostic! { autodiff_gradient(output, anchor, targets, span)? }
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:1599
pub fn autodiff_nested_gradient(outputs: &[CtValue], anchor: &CtValue, targets: &[I64], span: Span) -> [[CtValue]] Diagnostic! {
    states := outputs.iter().map(fn(v) { autodiff_state(v, anchor, span) }).collect()?
    gradients := jet_compute_nested_gradient(&states, targets).map_err(fn(e) { unsupported("compute.gradient autodiff: {e.jet_show()}", span) })?
    gradients.iter().map(fn(vs) { vs.iter().map(tensor_to_ct).collect() }).collect()
}
