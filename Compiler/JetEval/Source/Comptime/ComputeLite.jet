// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:1564
pub fn autodiff_trace_inputs(values: &[CtValue], span: Span) -> [CtValue] Diagnostic! {
    inputs := values.iter().map(fn(v) { ct_to_tensor(v, span) }).collect()?
    (tape, tracked) := jet_compute_trace_inputs(inputs)
    // Keep strong tape ownership until all trace identities have crossed the boundary.
    _tape_owner := tape
    tracked.iter().map(tensor_to_ct).collect()
}
