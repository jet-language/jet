// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:354
pub fn tensor_window_is_live(fields: &[(String, CtValue)]) -> Bool {
    value := fields.iter().find(fn(e) { e.0 == TENSOR_WINDOW_HANDLE_FIELD }).map(fn(e) { e.1 }) == { Val(v) -> v; None -> { return true } }
    data := value == { Closure(data) -> data; _ -> { return false } }
    data.opaque.as_ref().and_then(fn(o) { o.downcast_ref<JetComputeWindowHandle>() }).is_some_and(fn(h) { h.valid.load(Ordering.Acquire) && h.tensor_valid.load(Ordering.Acquire) })
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:376
pub fn tensor_window_drop_value(value: &CtValue, span: Span) -> Unit Diagnostic! {
    fields := value == { Struct { fields, .. } -> fields; _ -> { fail unsupported("Tensor window", span) } }
    value := fields.iter().find(fn(e) { e.0 == TENSOR_WINDOW_HANDLE_FIELD }).map(fn(e) { e.1 }) == { Val(v) -> v; None -> { return () } }
    data := value == { Closure(data) -> data; _ -> { fail unsupported("Tensor window handle", span) } }
    handle := data.opaque.as_ref().and_then(fn(o) { o.downcast_ref<JetComputeWindowHandle>() }).ok_or_else(fn() { unsupported("Tensor window handle", span) })?
    handle.valid.store(false, Ordering.Release)
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:401
pub fn tensor_window_values_share_handle(left: &CtValue, right: &CtValue) -> Bool {
    handle := fn(value) {
        fields := value == { Struct { fields, .. } -> fields; _ -> { return None } }
        data := fields.iter().find(fn(e) { e.0 == TENSOR_WINDOW_HANDLE_FIELD }).map(fn(e) { e.1 })? == { Closure(data) -> data; _ -> { return None } }
        data.opaque.as_ref().and_then(fn(o) { o.downcast_ref<JetComputeWindowHandle>() }).map(fn(h) { Arc.clone(&h.valid) })
    }
    handle(left).zip(handle(right)).is_some_and(fn(pair) { Arc.ptr_eq(&pair.0, &pair.1) })
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:423
fn tensor_handle_from_fields(fields: &[(String, CtValue)], span: Span) -> JetComputeTensorHandle? Diagnostic! {
    value := fields.iter().find(fn(e) { e.0 == TENSOR_HANDLE_FIELD }).map(fn(e) { e.1 }) == { Val(v) -> v; None -> { return None } }
    data := value == { Closure(data) -> data; _ -> { fail unsupported("Tensor handle", span) } }
    handle := data.opaque.as_ref().and_then(fn(o) { o.downcast_ref<JetComputeTensorHandle>() }).filter(fn(h) { h.valid.load(Ordering.Acquire) }).cloned().ok_or_else(fn() { unsupported("Tensor handle", span) })?
    Val(handle)
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:446
fn tensor_handle_state(value: &CtValue, span: Span) -> JetComputeTensorHandle Diagnostic! {
    fields := value == { Struct { fields, .. } -> fields; _ -> { fail unsupported("Tensor", span) } }
    tensor_handle_from_fields(fields, span)?.ok_or_else(fn() { unsupported("Tensor handle", span) })?
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:453
fn trace_to_ct(trace: &JetComputeTrace) -> CtValue {
    tape_handle := trace.tape.upgrade().unwrap_or_else(fn() { jet_panic("ComputeLite::trace_to_ct", 457, "autodiff tape ended before its trace was marshalled") })
    tape := tape_handle.lock().unwrap_or_else(fn(_) { jet_panic("ComputeLite::trace_to_ct", 464, "autodiff tape is poisoned") })
    nodes := tape.nodes.iter().map(fn(node) {
        CtValue.Struct { type_name: "__JetComputeNode", fields: [
            ("parents", CtValue.List(node.parents.iter().map(fn(p) { CtValue.Int(p.map_or(-1, fn(v) { v as I64 })) }).collect())),
            ("rule", tape_rule_to_ct(node.rule.as_ref())),
            ("values", CtValue.List(node.values.iter().map(fn(v) { tensor_to_ct_inner(v, false) }).collect())),
            ("output", tensor_to_ct_inner(&node.output, false))
        ] }
    }).collect()
    inputs := CtValue.List(tape.inputs.iter().map(fn(v) { tensor_to_ct_inner(v, false) }).collect())
    drop(tape)
    fields := [("identity", tape_handle_to_ct(tape_handle)), ("node", CtValue.Int(trace.node as I64)), ("inputs", inputs), ("nodes", CtValue.List(nodes))]
    if trace.parent == Val(parent) { fields.push(("parent", CtValue.Present(Box.new(trace_to_ct(parent))))) }
    CtValue.Struct { type_name: "__JetComputeTrace", fields }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:525
fn tensor_to_ct(tensor: &JetTensor) -> CtValue {
    handle := Arc.new(Mutex.new(tensor.clone())); valid := Arc.new(AtomicBool.new(true))
    tensor_to_ct_with_handle(tensor, handle, valid, true)
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:531
fn tensor_to_ct_inner(tensor: &JetTensor, include_trace: Bool) -> CtValue {
    handle := Arc.new(Mutex.new(tensor.clone())); valid := Arc.new(AtomicBool.new(true))
    tensor_to_ct_with_handle(tensor, handle, valid, include_trace)
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:537
fn tensor_to_ct_with_handle(tensor: &JetTensor, handle: Arc<Mutex<JetTensor>>, valid: Arc<AtomicBool>, include_trace: Bool) -> CtValue {
    // The opaque shared handle owns storage; only bounded metadata crosses here.
    jet_compute_validate_tensor(tensor).unwrap_or_else(fn(error) { jet_panic("ComputeLite::tensor_to_ct", 548, "invalid Tensor result: {error.jet_show()}") })
    strides := jet_compute_row_major_strides(&tensor.shape).unwrap_or_else(fn(error) { jet_panic("ComputeLite::tensor_to_ct", 557, "invalid Tensor view metadata: {error.jet_show()}") })
    fields := [
        ("shape", CtValue.List(tensor.shape.iter().map(fn(d) { CtValue.Int(d) }).collect())),
        ("strides", CtValue.List(strides.iter().map(fn(d) { CtValue.Int(d) }).collect())),
        ("device", device_to_ct(tensor.device)), ("last_placement", receipt_to_ct(&tensor.last_placement)),
        ("last_transfer", tensor.last_transfer.as_ref().map(transfer_to_ct).map(fn(v) { CtValue.Present(Box.new(v)) }).unwrap_or_else(fn() { CtValue.absent(Type.Named("ComputeTransfer")) }))
    ]
    if include_trace { if tensor.trace == Val(trace) { fields.push(("autodiff", CtValue.Present(Box.new(trace_to_ct(trace))))) } }
    fields.push((TENSOR_HANDLE_FIELD.to_string(), tensor_handle_to_ct(handle, valid)))
    CtValue.Struct { type_name: "Tensor", fields }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:603
fn as_i64_list(value: &CtValue, span: Span) -> [I64] Diagnostic! {
    value == { List(xs) -> xs.iter().map(fn(x) { x == { Int(n) -> n; _ -> { fail unsupported("Int list element", span) } } }).collect()?; _ -> { fail unsupported("[Int]", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:616
fn as_f64_list(value: &CtValue, span: Span) -> [F64] Diagnostic! {
    value == { List(xs) -> xs.iter().map(fn(x) { x == { Float(f) -> f.as_f64(); Int(n) -> n as F64; _ -> { fail unsupported("Float list element", span) } } }).collect()?; _ -> { fail unsupported("[Float]", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:630
fn tape_rule_from_ct(value: &CtValue, span: Span) -> JetComputeTapeRule? Diagnostic! {
    kind := value == {
        Str(kind) -> kind
        Struct { type_name, fields } if type_name == "__JetComputeRule" -> fields.iter().find_map(fn(e) { if e.0 == "kind" { Val(e.1) } else { None } }).and_then(fn(v) { v == { Str(k) -> Val(k); _ -> None } }).ok_or_else(fn() { unsupported("autodiff tape rule", span) })?
        _ -> { fail unsupported("autodiff tape rule", span) }
    }
    if kind == "input" { return None }
    fields := value == { Struct { fields, .. } -> fields; _ -> { fail unsupported("autodiff tape rule", span) } }
    source_shape := fn() { v := fields.iter().find_map(fn(e) { if e.0 == "source_shape" { Val(e.1) } else { None } }).ok_or_else(fn() { unsupported("autodiff source shape", span) })?; as_i64_list(v, span)? }
    axis := fn() { fields.iter().find_map(fn(e) { if e.0 == "axis" { Val(e.1) } else { None } }).and_then(fn(v) { v == { Int(axis) -> Val(axis); _ -> None } }).ok_or_else(fn() { unsupported("autodiff reduction axis", span) })? }
    learning_rate := fn() {
        v := fields.iter().find_map(fn(e) { if e.0 == "learning_rate" { Val(e.1) } else { None } }).ok_or_else(fn() { unsupported("autodiff learning rate", span) })?
        v == { Float(rate) -> rate.as_f64(); Int(rate) -> rate as F64; _ -> { fail unsupported("autodiff learning rate", span) } }
    }
    Val(kind == {
        "add" -> JetComputeTapeRule.Add; "sub" -> JetComputeTapeRule.Sub; "mul" -> JetComputeTapeRule.Mul; "div" -> JetComputeTapeRule.Div
        "maximum" -> JetComputeTapeRule.Maximum; "minimum" -> JetComputeTapeRule.Minimum; "matmul" -> JetComputeTapeRule.Matmul
        "matmul_f32_tile" -> JetComputeTapeRule.MatmulF32Tile; "mse_loss" -> JetComputeTapeRule.MseLoss
        "sgd_step" -> JetComputeTapeRule.SgdStep { learning_rate: learning_rate()? }
        "negate" | "abs" | "exp" | "log" | "sqrt" -> JetComputeTapeRule.Unary(kind.to_string())
        "reshape" -> JetComputeTapeRule.Reshape { source_shape: source_shape()? }; "broadcast" -> JetComputeTapeRule.Broadcast { source_shape: source_shape()? }
        "reduce_to_shape" -> JetComputeTapeRule.ReduceToShape { source_shape: source_shape()? }; "transpose" -> JetComputeTapeRule.Transpose
        "sum_axis" -> JetComputeTapeRule.SumAxis { axis: USize.try_from(axis()?).map_err(fn(_) { unsupported("autodiff reduction axis", span) })?, source_shape: source_shape()? }
        _ -> { fail unsupported("autodiff tape operation", span) }
    })
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:713
fn trace_from_ct(value: &CtValue, span: Span) -> JetComputeTrace Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("autodiff trace", span) } }
    if type_name != "__JetComputeTrace" { fail unsupported("autodiff trace", span) }
    field := fn(name) { fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { e.1 }).ok_or_else(fn() { unsupported("autodiff trace field", span) }) }
    tape_handle := field("identity")? == {
        Closure(data) -> data.opaque.as_ref().and_then(fn(o) { o.downcast_ref<JetComputeTapeHandle>() }).map(fn(h) { h.tape.clone() }).ok_or_else(fn() { unsupported("autodiff trace identity", span) })?
        _ -> { fail unsupported("autodiff trace identity", span) }
    }
    node := field("node")? == { Int(n) if n >= 0 -> USize.try_from(n).map_err(fn(_) { unsupported("autodiff trace node", span) })?; _ -> { fail unsupported("autodiff trace node", span) } }
    _inputs := field("inputs")? == { List(vs) -> vs.iter().map(fn(v) { ct_to_tensor_inner(v, span, false) }).collect()?; _ -> { fail unsupported("autodiff trace inputs", span) } }
    nodes := field("nodes")? == {
        List(vs) -> vs.iter().map(fn(v) {
            (type_name, fields) := v == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("autodiff tape node", span) } }
            if type_name != "__JetComputeNode" { fail unsupported("autodiff tape node", span) }
            node_field := fn(name) { fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { e.1 }).ok_or_else(fn() { unsupported("autodiff tape node field", span) }) }
            parents := node_field("parents")? == {
                List(vs) -> vs.iter().map(fn(v) { v == { Int(n) if n < 0 -> None; Int(n) -> Val(USize.try_from(n).map_err(fn(_) { unsupported("autodiff parent", span) })?); _ -> { fail unsupported("autodiff parent", span) } } }).collect()?
                _ -> { fail unsupported("autodiff parents", span) }
            }
            rule := tape_rule_from_ct(node_field("rule")?, span)?
            values := node_field("values")? == { List(vs) -> vs.iter().map(fn(v) { ct_to_tensor_inner(v, span, false) }).collect()?; _ -> { fail unsupported("autodiff node values", span) } }
            output := ct_to_tensor_inner(node_field("output")?, span, false)?
            JetComputeTapeNode { parents, rule, values, output }
        }).collect()?
        _ -> { fail unsupported("autodiff trace nodes", span) }
    }
