// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:52
fn device_to_ct(device: JetComputeDevice) -> CtValue {
    variant := device == { Auto -> "Auto"; Cpu -> "CPU"; Metal -> "Metal"; Cuda -> "CUDA"; Vulkan -> "Vulkan"; WebGpu -> "WebGPU" }
    CtValue.Enum { type_name: "ComputeDevice", variant, args: [] }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:67
fn ct_to_device(value: &CtValue, span: Span) -> JetComputeDevice Diagnostic! {
    value == {
        Enum { type_name, variant, .. } if type_name == "ComputeDevice" -> variant == {
            "Auto" -> JetComputeDevice.Auto; "CPU" | "Cpu" -> JetComputeDevice.Cpu
            "Metal" | "METAL" -> JetComputeDevice.Metal; "CUDA" | "Cuda" -> JetComputeDevice.Cuda
            "Vulkan" | "VULKAN" -> JetComputeDevice.Vulkan; "WebGPU" | "WEBGPU" | "Webgpu" -> JetComputeDevice.WebGpu
            _ -> { fail unsupported("ComputeDevice variant", span) }
        }
        Str("Auto") -> JetComputeDevice.Auto; Str("CPU") | Str("Cpu") -> JetComputeDevice.Cpu
        Str("Metal") | Str("METAL") -> JetComputeDevice.Metal; Str("CUDA") | Str("Cuda") -> JetComputeDevice.Cuda
        Str("Vulkan") | Str("VULKAN") -> JetComputeDevice.Vulkan
        Str("WebGPU") | Str("WEBGPU") | Str("Webgpu") -> JetComputeDevice.WebGpu
        _ -> { fail unsupported("ComputeDevice", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:92
fn receipt_to_ct(receipt: &JetComputePlacementReceipt) -> CtValue {
    CtValue.Struct { type_name: "ComputePlacement", fields: [
        ("requested", device_to_ct(receipt.requested)), ("selected", device_to_ct(receipt.selected)),
        ("backend", CtValue.Str(receipt.backend.clone())), ("version", CtValue.Str(receipt.version.clone())),
        ("profile", CtValue.Str(receipt.profile.clone())), ("cache", CtValue.Str(receipt.cache.clone())),
        ("abilities", CtValue.List(receipt.abilities.iter().map(fn(s) { CtValue.Str(s.clone()) }).collect())),
        ("reason", CtValue.Str(receipt.reason.clone()))
    ] }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:118
fn ct_to_receipt(value: &CtValue, span: Span) -> JetComputePlacementReceipt Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("ComputePlacement", span) } }
    if type_name != "ComputePlacement" && type_name != "JetComputePlacementReceipt" { fail unsupported("ComputePlacement", span) }
    field := fn(name) { fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { e.1 }).ok_or_else(fn() { unsupported("ComputePlacement field", span) }) }
    requested := ct_to_device(field("requested")?, span)?
    selected := ct_to_device(field("selected")?, span)?
    text := fn(name) { field(name)? == { Str(s) if !s.is_empty() && !s.chars().any(fn(c) { c.is_control() }) -> s.clone(); _ -> { fail unsupported("ComputePlacement text field", span) } } }
    abilities := field("abilities")? == {
        List(values) -> values.iter().map(fn(v) { v == { Str(s) if !s.is_empty() && !s.chars().any(fn(c) { c.is_control() }) -> s.clone(); _ -> { fail unsupported("ComputePlacement ability", span) } } }).collect()?
        _ -> { fail unsupported("ComputePlacement abilities", span) }
    }
    reason := field("reason")? == { Str(s) if !s.is_empty() && !s.chars().any(fn(c) { c.is_control() }) -> s.clone(); _ -> { fail unsupported("placement reason", span) } }
    receipt := JetComputePlacementReceipt { requested, selected, backend: text("backend")?, version: text("version")?, profile: text("profile")?, cache: text("cache")?, abilities, reason }
    jet_compute_validate_placement(receipt.selected, &receipt).map_err(fn(error) { unsupported("ComputePlacement metadata: {error.jet_show()}", span) })?
    receipt
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:173
fn transfer_to_ct(transfer: &JetComputeTransferReceipt) -> CtValue {
    CtValue.Struct { type_name: "ComputeTransfer", fields: [("from", device_to_ct(transfer.from)), ("to", device_to_ct(transfer.to)), ("bytes", CtValue.Int(transfer.bytes)), ("fallback", CtValue.Str(transfer.fallback.clone()))] }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:188
fn ct_to_transfer(value: &CtValue, span: Span) -> JetComputeTransferReceipt Diagnostic! {
    (type_name, fields) := value == { Struct { type_name, fields } -> (type_name, fields); _ -> { fail unsupported("ComputeTransfer", span) } }
    if type_name != "ComputeTransfer" && type_name != "JetComputeTransferReceipt" { fail unsupported("ComputeTransfer", span) }
    field := fn(name) { fields.iter().find(fn(e) { e.0 == name }).map(fn(e) { e.1 }).ok_or_else(fn() { unsupported("ComputeTransfer field", span) }) }
    from := ct_to_device(field("from")?, span)?; to := ct_to_device(field("to")?, span)?
    bytes := field("bytes")? == { Int(n) if n >= 0 -> n; _ -> { fail unsupported("transfer bytes", span) } }
    fallback := field("fallback")? == { Str(s) if !s.is_empty() && !s.chars().any(fn(c) { c.is_control() }) -> s.clone(); _ -> { fail unsupported("transfer fallback", span) } }
    JetComputeTransferReceipt { from, to, bytes, fallback }
}
// Rust: crates/jet-comptime/src/Comptime/ComputeLite.rs:220
fn tape_rule_to_ct(rule: JetComputeTapeRule?) -> CtValue {
    rule := rule == { Val(r) -> r; None -> { return CtValue.Str("input") } }
    (kind, source_shape, axis) := rule == {
        Add -> ("add", None, None); Sub -> ("sub", None, None); Mul -> ("mul", None, None); Div -> ("div", None, None)
        Maximum -> ("maximum", None, None); Minimum -> ("minimum", None, None); Matmul -> ("matmul", None, None)
        MatmulF32Tile -> ("matmul_f32_tile", None, None); MseLoss -> ("mse_loss", None, None); SgdStep { .. } -> ("sgd_step", None, None)
        Unary(op) -> (op, None, None); Reshape { source_shape } -> ("reshape", Val(source_shape), None)
        Broadcast { source_shape } -> ("broadcast", Val(source_shape), None); ReduceToShape { source_shape } -> ("reduce_to_shape", Val(source_shape), None)
        Transpose -> ("transpose", None, None); SumAxis { axis, source_shape } -> ("sum_axis", Val(source_shape), Val(axis as I64))
    }
    fields := [("kind", CtValue.Str(kind.to_string()))]
    if source_shape == Val(shape) { fields.push(("source_shape", CtValue.List(shape.iter().map(fn(v) { CtValue.Int(v) }).collect()))) }
    if axis == Val(axis) { fields.push(("axis", CtValue.Int(axis))) }
    if rule == SgdStep { learning_rate } { fields.push(("learning_rate", CtValue.Float(CtFloat.f64(learning_rate)))) }
    CtValue.Struct { type_name: "__JetComputeRule", fields }
}
