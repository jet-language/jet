// Rust: crates/jet-comptime/src/Comptime/mod.rs:1084
fn evaluate_with_imports_opts_collecting_structs_and_methods(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], binding_types: &[String:Type], core_imports: &[String:String], gates: GateSet,
    initial_impure_depth: Int, structs: &[String:StructDef], methods: &[(String, String):Func], method_traits: &[(String, String):String],
    distinct_ranges: &[String:(I64, I64)?], distinct_bases: &[String:Type], unit_families: &[UnitFamilyDef],
    nominal_facts: MirBridge.MirFragmentNominalFacts?, mutated: (&[String:CtValue])?) -> (CtValue, [ComptimeInput]) Diagnostic! {
    if initial_impure_depth == 0 { check_purity(init, funcs, extern_names)? }
    embed_inputs := [ComptimeInput]()
    (value, package_inputs) :: with_package_read_context(base_dir, fn() {
        data_pipeline := DataPipeline.DataPipelineState.default()
        MirBridge.eval_expr(&MirBridge.ExprEvalRequest {
            data_pipeline: &data_pipeline, expr: init, funcs: funcs, binding_types: binding_types, error_conversions: [],
            method_traits: method_traits, methods: methods, extern_names: extern_names, base_dir: base_dir,
            globals: globals, core_imports: core_imports, gates: gates, initial_impure_depth: initial_impure_depth,
            runtime_execution: false, structs: structs, computed_fields: empty_computed(), distinct_ranges: distinct_ranges,
            distinct_bases: distinct_bases, unit_families: unit_families, fuel: FUEL_BUDGET, sink: None,
            checked_nominals: nominal_facts, repl_mode: false, repl_grants: [], repl_authorizer: None,
            embed_inputs: Val(&embed_inputs), mutated: mutated,
        })
    })
    embed_inputs.extend(package_inputs)
    Ok((value?, embed_inputs))
}

