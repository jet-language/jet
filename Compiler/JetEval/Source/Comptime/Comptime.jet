// Rust: crates/jet-comptime/src/Comptime/mod.rs:1415
pub fn run_repl_step(stmts: &[Stmt], funcs: &[String:Func], base_dir: OSPath, sink: &DevSink, scope: &[String:CtValue], fuel: U64,
    suppress: Bool, core_imports: &[String:String], structs: &[String:StructDef], binding_types: &[String:Type], authorizer: &ReplAuthorizer) -> CtValue? Diagnostic! {
    if run_repl_step_inner(stmts, funcs, base_dir, sink, scope, fuel, suppress, core_imports, structs, binding_types, authorizer, false) == {
        Ok(value) -> Ok(value)
        Err(.Diagnostic(diagnostic)) -> Err(diagnostic)
        Err(.Interrupted) -> unreachable("non-interruptible REPL step interrupted")
    }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1450
pub fn run_repl_step_interruptible(stmts: &[Stmt], funcs: &[String:Func], base_dir: OSPath, sink: &DevSink, scope: &[String:CtValue], fuel: U64,
    suppress: Bool, core_imports: &[String:String], structs: &[String:StructDef], binding_types: &[String:Type], authorizer: &ReplAuthorizer) -> CtValue? ReplStepError! {
    // GATE #4494: native unwind carrier preserves non-interrupt panics verbatim.
    result :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
        run_repl_step_inner(stmts, funcs, base_dir, sink, scope, fuel, suppress, core_imports, structs, binding_types, authorizer, true)
    }))
    if result == {
        Ok(result) -> result
        Err(payload) -> {
            if payload.is::<ReplInterrupted>() -> return Err(ReplStepError.Interrupted)
            panic.resume_unwind(payload)
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1486
fn run_repl_step_inner(stmts: &[Stmt], funcs: &[String:Func], base_dir: OSPath, sink: &DevSink, scope: &[String:CtValue], fuel: U64,
    suppress: Bool, core_imports: &[String:String], structs: &[String:StructDef], binding_types: &[String:Type], authorizer: &ReplAuthorizer,
    interruptible: Bool) -> CtValue? ReplStepError! {
    interp := Interp {
        funcs: funcs, error_conversions: [], base_dir: base_dir, fuel: fuel, sink: Val(sink),
        checked_nominals: None, core_imports: core_imports, debugger: None, runtime_execution: false,
        depth: 0, cur_func: "main", impure_depth: 0, gates: GateSet.allow(PolicyKey.Impure),
        repl_mode: true, repl_grants: [], repl_authorizer: Val(authorizer), repl_interruptible: interruptible,
        embed_inputs: [], binding_types: binding_types.clone(), globals: empty_globals(), methods: empty_methods(), structs: structs,
        computed_fields: empty_computed(), distinct_ranges: empty_distinct(), distinct_bases: empty_distinct_bases(),
        migrations: empty_migrations(), list_write_windows: [:], data_pipeline: DataPipeline.DataPipelineState.default(),
    }
    if stmts.is_empty() -> return Ok(None)
    last :: stmts[stmts.len() - 1]
    head :: stmts[..stmts.len() - 1]
    _ :: interp.exec_block(head, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?
    echo_bare :: !suppress && if last == { .Expr(_) -> true else -> false }
    if last == {
        .Val(binding) -> {
            value :: interp.eval(binding.init, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?
            if !suppress && binding.name == "__repl_echo__" -> return Ok(Val(value))
            if binding.pattern == {
                Val(pattern) -> interp.bind_pattern(pattern, value, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?
                None -> { scope.insert(binding.name, value) }
            }
            Ok(None)
        }
        .Expr(expr) -> {
            if echo_bare -> return Ok(Val(interp.eval(expr, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?))
            _ :: interp.exec_stmt(last, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?
            Ok(None)
        }
        other -> {
            _ :: interp.exec_stmt(other, scope).map_err(fn(diagnostic) { ReplStepError.Diagnostic(diagnostic) })?
            Ok(None)
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1584
pub fn run_block_with_imports(stmts: &[Stmt], funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], core_imports: &[String:String]) -> [String:CtValue] Diagnostic! {
    Purity.check_purity_stmts(stmts, funcs, extern_names)?
    (result, _) :: with_package_read_context(base_dir, fn() {
        data_pipeline := DataPipeline.DataPipelineState.default()
        MirBridge.eval_block(&MirBridge.BlockEvalRequest {
            data_pipeline: &data_pipeline, stmts: stmts, funcs: funcs, binding_types: [:], error_conversions: [],
            method_traits: empty_method_traits(), methods: empty_methods(), extern_names: extern_names, base_dir: base_dir,
            globals: globals, core_imports: core_imports, structs: [:], computed_fields: empty_computed(),
            distinct_ranges: empty_distinct(), distinct_bases: empty_distinct_bases(), unit_families: [], fuel: FUEL_BUDGET,
            sink: None, checked_nominals: None, repl_mode: false, repl_authorizer: None, gates: GateSet.default(),
            impure_depth: 0, runtime_execution: false, debugger: None, debug_function: "", debug_depth: 0, embed_inputs: None,
        })
    })
    if result? == { .Done(scope) -> Ok(scope) .Returned { scope, .. } -> Ok(scope) }
