// Rust: crates/jet-comptime/src/Comptime/mod.rs:357
// GATE #4494: native process-lifetime atomics, signal-safe interrupt accounting.
const REPL_INTERRUPT_COUNT: AtomicUsize = AtomicUsize.new(0)
// Rust: crates/jet-comptime/src/Comptime/mod.rs:358
const REPL_RUNTIME_CALL_ACTIVE: AtomicBool = AtomicBool.new(false)
// Rust: crates/jet-comptime/src/Comptime/mod.rs:359
const REPL_INTERRUPTIBLE_TURN_ACTIVE: AtomicBool = AtomicBool.new(false)
// Rust: crates/jet-comptime/src/Comptime/mod.rs:360
const REPL_INTERRUPT_WARNING_EMITTED: AtomicBool = AtomicBool.new(false)
// Rust: crates/jet-comptime/src/Comptime/mod.rs:368
pub fn begin_repl_interruptible_turn() -> () {
    REPL_INTERRUPTIBLE_TURN_ACTIVE.store(true, Ordering.SeqCst)
    REPL_RUNTIME_CALL_ACTIVE.store(false, Ordering.SeqCst)
    REPL_INTERRUPT_WARNING_EMITTED.store(false, Ordering.SeqCst)
    REPL_INTERRUPT_COUNT.store(0, Ordering.SeqCst)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:375
pub fn end_repl_interruptible_turn() -> () {
    REPL_INTERRUPTIBLE_TURN_ACTIVE.store(false, Ordering.SeqCst)
    REPL_RUNTIME_CALL_ACTIVE.store(false, Ordering.SeqCst)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:380
pub fn repl_interruptible_turn_active() -> Bool { REPL_INTERRUPTIBLE_TURN_ACTIVE.load(Ordering.SeqCst) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:385
pub fn note_repl_interrupt() -> () { _ :: REPL_INTERRUPT_COUNT.fetch_add(1, Ordering.SeqCst) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:389
pub fn repl_interrupt_count() -> Int { REPL_INTERRUPT_COUNT.load(Ordering.SeqCst) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:393
pub fn repl_runtime_call_active() -> Bool { REPL_RUNTIME_CALL_ACTIVE.load(Ordering.SeqCst) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:398
pub fn warn_repl_runtime_call_stopping() -> () {
    if !repl_runtime_call_active() || REPL_INTERRUPT_WARNING_EMITTED.swap(true, Ordering.SeqCst) -> return
    // GATE #4483 / #4494: selected Unix arm uses an async-signal-safe raw write.
    if target.selected_family() == "unix" {
        message :: b"\r\nwarning: interrupt requested; waiting for active external I/O to stop\r\n"
        _ :: unix.write(2, message.as_ptr(), message.len())
    }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:412
struct ReplRuntimeCallGuard { active: Bool }
impl ReplRuntimeCallGuard {
    // Rust: crates/jet-comptime/src/Comptime/mod.rs:415
    fn new(active: Bool) -> ReplRuntimeCallGuard {
        if active { REPL_RUNTIME_CALL_ACTIVE.store(true, Ordering.SeqCst) }
        ReplRuntimeCallGuard { active: active }
    }
}
impl Drop for ReplRuntimeCallGuard {
    // Rust: crates/jet-comptime/src/Comptime/mod.rs:424
    fn drop(self: &ReplRuntimeCallGuard) -> () {
        if self.active {
            REPL_RUNTIME_CALL_ACTIVE.store(false, Ordering.SeqCst)
            // GATE #4494: real unwinding, not a diagnostic/success substitute.
            if !thread.panicking() && repl_interrupt_count() > 0 { panic.resume_unwind(ReplInterrupted {}) }
        }
    }
}
