pub fn evaluate_owned_with_imports_opts_collecting(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], core_imports: &[String:String], gates: GateSet, initial_impure_depth: Int,
    mutated: (&[String:CtValue])?) -> (CtValue, [ComptimeInput]) Diagnostic! {
    reachable :: Purity.reachable_owned_funcs(init, funcs)
