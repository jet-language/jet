// Rust: crates/jet-comptime/src/Comptime/mod.rs:1193
pub fn run_main(main: &Func, funcs: &[String:Func], base_dir: OSPath, sink: &DevSink, _program: &ProgramInfo) -> CtValue Diagnostic! {
    interp := Interp {
        funcs: funcs, error_conversions: [], base_dir: base_dir, fuel: DEV_FUEL_BUDGET, sink: Val(sink),
        checked_nominals: None, core_imports: empty_imports(), debugger: None, runtime_execution: false,
        depth: 0, cur_func: "main", impure_depth: 0, gates: GateSet.allow(PolicyKey.Impure),
        repl_mode: false, repl_grants: [], repl_authorizer: None, repl_interruptible: false,
        embed_inputs: [], binding_types: [:], globals: empty_globals(), methods: empty_methods(), structs: empty_structs(),
        computed_fields: empty_computed(), distinct_ranges: empty_distinct(), distinct_bases: empty_distinct_bases(),
        migrations: empty_migrations(), list_write_windows: [:], data_pipeline: DataPipeline.DataPipelineState.default(),
    }
    scope := [String:CtValue]()
    if interp.exec_block(main.body, &scope)? == { .Return(value) -> Ok(value) else -> Ok(CtValue.Unit) }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1245
pub fn run_main_debug(main: &Func, funcs: &[String:Func], base_dir: OSPath, core_imports: &[String:String], sink: &DevSink, debugger: &DebugHook) -> () Diagnostic! {
    interp := Interp {
        funcs: funcs, error_conversions: [], base_dir: base_dir, fuel: DEV_FUEL_BUDGET, sink: Val(sink),
        checked_nominals: None, core_imports: core_imports, debugger: Val(debugger), runtime_execution: true,
        depth: 0, cur_func: "main", impure_depth: 0, gates: GateSet.default(),
        repl_mode: false, repl_grants: [], repl_authorizer: None, repl_interruptible: false,
        embed_inputs: [], binding_types: [:], globals: empty_globals(), methods: empty_methods(), structs: empty_structs(),
        computed_fields: empty_computed(), distinct_ranges: empty_distinct(), distinct_bases: empty_distinct_bases(),
        migrations: empty_migrations(), list_write_windows: [:], data_pipeline: DataPipeline.DataPipelineState.default(),
    }
    scope := [String:CtValue]()
    // One canonical evaluation owns all statement boundaries and nested calls.
    if interp.exec_block(main.body, &scope)? == {
        .Return(_) -> return Ok(())
        .Normal | .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> {}
    }
    Ok(())
}
