//RS /// Whole-program dev interpretation (E2-M4 `jet dev`). Runs `main`'s body
//RS /// with a buffered stdout/stderr sink, reusing the exact same evaluator the
//RS /// M9.5 comptime path uses — there is no second interpreter. Output bytes are
//RS /// produced via `CtValue::jet_show()` + `\n`, identical to the compiled
//RS /// program (the differential battery in `tests/dev.rs` enforces this, I2).
//RS ///
//RS /// The canonical MIR caller supplies the checked artifact; this function
//RS /// simply runs and may itself return E0956 (`unsupported`) when it reaches
//RS /// a construct the evaluator can't run, or E2202 when the fuel budget is
//RS /// exhausted.
//RS /// c139: everything the dev interpreter needs beyond the flat `funcs` map to
//RS /// run whole programs at parity with the real build — pre-evaluated
//RS /// top-level `const`/`comptime` bindings, user-method dispatch (`impl`/
//RS /// in-struct methods and D-MOD2 code-module namespaced calls), D-FIELDPOL1
//RS /// computed fields, and D-RANGETYPE1/D-DIST1 distinct-type constructors.
//RS /// Built once per `jet dev` run by `Source/Interpreter.rs::collect_program_info`.
//RS pub struct ProgramInfo<'a> {
//RS     pub globals: HashMap<String, CtValue>,
//RS     pub methods: HashMap<(String, String), &'a Func>,
//RS     pub structs: HashMap<String, &'a StructDef>,
//RS     pub enums: HashMap<String, &'a EnumDef>,
//RS     pub computed_fields: HashMap<(String, String), &'a Expr>,
//RS     pub distinct_ranges: HashMap<String, Option<(i64, i64)>>,
//RS     pub distinct_bases: HashMap<String, Type>,
//RS     pub core_imports: HashMap<String, String>,
//RS     /// D-CONF-READ1=A: the same pre-sema build snapshot used to fold source
//RS     /// facts. The dev/build interpreter never probes the host for it.
//RS     pub build_facts: jet_foundation::Facts::BuildFactSnapshot,
//RS     /// Card #392 pass 5: `TypeName -> migration { }` blocks (source order) for
//RS     /// Typed decode's runtime chain-walker (see `Interp::migrations`).
//RS     pub migrations: HashMap<String, Vec<&'a crate::AST::MigrationDecl>>,
//RS }
//RS 
//RS impl<'a> ProgramInfo<'a> {
//RS     pub fn empty() -> Self {
