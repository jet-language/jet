#Error
pub enum ReplStepError { Diagnostic(Diagnostic); Interrupted }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:446
#Derive(Debug, Clone)
pub struct ProgramBuildEvaluation { pub plan: Build.BuildPlan, pub comptime_inputs: [ComptimeInput], pub diagnostics: [Diagnostic] }

// Rust: crates/jet-comptime/src/Comptime/mod.rs:455
pub fn run_build_entry_with_policy(build: &Func, funcs: &[String:Func], error_conversions: &[ErrorConvDef], base_dir: OSPath,
    program: &ProgramInfo, program_value: CtValue, package: String, gates: GateSet, policy: Build.BuildPolicy) -> ProgramBuildEvaluation Diagnostic! {
    context :: Build.begin_program_build_with_policy_at(package, program_value, policy, base_dir)
    interp := Interp {
        funcs: funcs, error_conversions: error_conversions, base_dir: base_dir, fuel: DEV_FUEL_BUDGET,
        sink: None, checked_nominals: None, core_imports: &program.core_imports, debugger: None,
        runtime_execution: false, depth: 0, cur_func: "build", impure_depth: 0, gates: gates,
        repl_mode: false, repl_grants: [], repl_authorizer: None, repl_interruptible: false,
        embed_inputs: [], binding_types: [:], globals: &program.globals, methods: &program.methods,
        structs: &program.structs, computed_fields: &program.computed_fields,
        distinct_ranges: &program.distinct_ranges, distinct_bases: &program.distinct_bases,
        migrations: &program.migrations, list_write_windows: [:], data_pipeline: DataPipeline.DataPipelineState.default(),
    }
    frame := [String:CtValue]()
    frame.insert(build.params[0].name, context.clone())
    (call_result, package_inputs) :: with_package_read_context(base_dir, fn() { interp.call_func("build", build, frame) })
    interp.embed_inputs.extend(package_inputs)
    returned :: if call_result == {
        Ok(value) -> value
        Err(error) -> { Build.abort_program_build(context); return Err(error) }
    }
    if returned == CtValue.Failed(CtReport.Told(error)) {
        Build.abort_program_build(context)
        if Build.build_error_diagnostic_from_value(error, build.name_span) == Val(diagnostic) -> return Err(diagnostic)
        detail :: error.jet_show()
        (code, what, why, fix) :: if detail.strip_prefix("E3511: ") == {
            Val(detail) -> ("E3511", detail.to_string(),
                "generated source must reach a bounded deterministic order, not loop until quiescent",
                "break the dependency between these generators or give each generated module one owner")
            None -> ("E3502", "`fn build` returned an error: {detail}",
                "the selected root build entry must finish graph construction before any action runs",
                "fix the failing build operation; use `jet inspect explain-build` to inspect completed graph nodes")
        }
        return Err(Diagnostic.error(code, what, why, fix, Val(build.name_span)))
    }
    (plan, diagnostics) :: Build.finish_program_build(context, returned)?
    Ok(ProgramBuildEvaluation { plan: plan, comptime_inputs: interp.embed_inputs, diagnostics: diagnostics })
}

