pub fn xml_safe_static_for_tir(path: String, method: String) -> CtValue? {
    if method != "safe" -> return None
    if path == {
        "jet_std::EncodingLimits" -> Val(EncodingLite.encoding_limits_safe_value())
        "jet_std::XMLLimits" -> Val(EncodingLite.xml_safe_limits_value())
        "jet_std::XMLParseOptions" -> Val(EncodingLite.xml_safe_options_value())
        "jet_std::XMLRenderOptions" -> Val(EncodingLite.xml_safe_render_options_value())
        "jet_std::DataLimits" -> Val(DataPipeline.data_limits_safe_value())
        else -> None
    }
}
