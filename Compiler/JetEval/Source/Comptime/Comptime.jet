// Rust: crates/jet-comptime/src/Comptime/mod.rs:1759
fn is_serde_codec_trait(trait_name: String?) -> Bool { trait_name == Val(Generics.ENCODE) || trait_name == Val(Generics.DECODE) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1766
fn insert_serde_codec_ref(funcs: &[String:Func], owner: String, method: &Func, generated: Bool) -> () {
    key :: "{owner}::{method.name}"
    if generated { funcs.entry(key).or_insert(method) } else { funcs.insert(key, method) }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1783
fn insert_item_method_ref(funcs: &[String:Func], methods: &[(String, String):Func], owner: String, trait_name: String?, method: &Func, generated: Bool) -> () {
    method_key :: (owner, method.name)
    if is_serde_codec_trait(trait_name) {
        insert_serde_codec_ref(funcs, owner, method, generated)
        if generated { methods.entry(method_key).or_insert(method) } else { methods.insert(method_key, method) }
    } else { methods.insert(method_key, method) }
}
