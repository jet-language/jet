// Rust: crates/jet-comptime/src/Comptime/mod.rs:969
pub fn evaluate_with_imports_opts(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], core_imports: &[String:String], gates: GateSet, initial_impure_depth: Int) -> CtValue Diagnostic! {
    // Active lexical impurity defers to the Tier-2 gate/flag diagnostic (E3411).
    if initial_impure_depth == 0 { check_purity(init, funcs, extern_names)? }
    (value, _) :: with_package_read_context(base_dir, fn() {
        data_pipeline := DataPipeline.DataPipelineState.default()
        MirBridge.eval_expr(&MirBridge.ExprEvalRequest {
            data_pipeline: &data_pipeline, expr: init, funcs: funcs, binding_types: [:], error_conversions: [],
            method_traits: empty_method_traits(), methods: empty_methods(), extern_names: extern_names,
            base_dir: base_dir, globals: globals, core_imports: core_imports, gates: gates,
            initial_impure_depth: initial_impure_depth, runtime_execution: false, structs: [:],
            computed_fields: empty_computed(), distinct_ranges: empty_distinct(), distinct_bases: empty_distinct_bases(),
            unit_families: [], fuel: FUEL_BUDGET, sink: None, checked_nominals: None, repl_mode: false,
            repl_grants: [], repl_authorizer: None, embed_inputs: None, mutated: None,
        })
    })
    value
}
