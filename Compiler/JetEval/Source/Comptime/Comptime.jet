// Rust: crates/jet-comptime/src/Comptime/mod.rs:173
pub fn validate_typed_url_literal(literals: [String]) -> () Err! { UrlLite.validate_typed_url_literal(literals) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:177
pub fn validate_typed_path_literal(literals: [String]) -> () Err! { typed_text_kernel.jet_validate_typed_path_literal(literals) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:182
pub fn validate_typed_boundary_literal(kind: Syntax.TypedHeadKind, literals: [String]) -> () Err! {
    if kind == {
        .URL -> validate_typed_url_literal(literals)
        .Path -> validate_typed_path_literal(literals)
        .DateTime -> validate_datetime_literal(literals.join(""))
        else -> Err("typed head is not a checked boundary head")
    }
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:199
pub fn render_typed_hole(value: &CtValue) -> String? { display_core_pure_value(value) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:203
pub fn render_typed_holes(values: &[CtValue], span: Span) -> [String] Diagnostic! {
    shown := [String]()
    loop value in values {
        if render_typed_hole(value) == {
            Val(text) -> shown.push(text)
            None -> return Err(Diagnostic.error("E0112", "a typed literal hole has no canonical JetShow renderer",
                "typed literal holes use one display contract in every execution tier",
                "use a sema-admitted printable value or convert it to String before the hole", Val(span)))
        }
    }
    Ok(shown)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:225
pub fn validate_datetime_literal(value: String) -> () Err! { Methods.validate_datetime_literal(value) }
// Rust: crates/jet-comptime/src/Comptime/mod.rs:232
pub fn evaluate_typed_head(kind: Syntax.TypedHeadKind, literals: [String], holes: &[CtValue], span: Span) -> CtValue Diagnostic! {
    name :: kind.source_name()
    if !kind.is_boundary() {
        return Err(Diagnostic.error("E0956", "typed head `{name}` can't run at compile time yet",
            "the canonical TIR evaluator only accepts the ratified URL, Path, and DateTime heads",
            "use one of `URL.{\"…\"}`, `Path.{\"…\"}`, or `DateTime.{\"…\"}`", Val(span)))
    }
    if kind.forbids_holes() && !holes.is_empty() {
        return Err(Diagnostic.error("E0155", "a `DateTime` literal cannot contain interpolation",
            "DateTime values are checked as complete RFC3339 literals before the program runs",
            "write a complete `DateTime.{\"…\"}` literal, or parse a runtime String explicitly", Val(span)))
    }
    if validate_typed_boundary_literal(kind, literals) == Err(reason) {
        return Err(Diagnostic.error("E0155", "this `{name}` literal is invalid", reason,
            "fix the literal, or parse a runtime String with the ordinary `{name}` constructor", Val(span)))
    }
    shown_holes :: render_typed_holes(holes, span)?
    if kind == {
        .URL -> {
            url :: UrlLite.typed_url_literal(literals, shown_holes)
            Ok(Methods.url_parts_to_ct(url))
        }
        .Path -> Ok(CtValue.Struct { type_name: Syntax.TYPE_PATH,
            fields: [("inner", CtValue.Str(typed_text_kernel.jet_typed_path_interpolate(literals, shown_holes)))], })
        .DateTime -> {
            text :: typed_text_kernel.jet_typed_datetime_interpolate(literals, shown_holes)
            parsed :: Methods.evaluate_typed_datetime_literal(text, span)?
            if parsed == {
                .Present(value) -> Ok(value)
                failure -> {
                    why :: if render_typed_hole(failure) == {
                        Val(text) -> "the typed head parser returned `{text}` after sema validation"
                        None -> "the typed head parser returned an unrenderable value after sema validation"
                    }
                    Err(Diagnostic.error("E0956", "{name} typed head produced an invalid value", why,
                        "keep the literal skeleton valid and let holes supply only head-safe values", Val(span)))
                }
            }
        }
        else -> unreachable("boundary evaluation validated its descriptor")
    }
}
