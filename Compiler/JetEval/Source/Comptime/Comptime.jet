// Rust: crates/jet-comptime/src/Comptime/mod.rs:1660
pub fn evaluate_owned(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath, globals: &[String:CtValue]) -> CtValue Diagnostic! {
    evaluate_owned_with_imports(init, funcs, extern_names, base_dir, globals, [:])
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1678
pub fn evaluate_owned_with_imports(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], core_imports: &[String:String]) -> CtValue Diagnostic! {
    evaluate_owned_with_imports_opts(init, funcs, extern_names, base_dir, globals, core_imports, GateSet.default(), 0)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1702
pub fn evaluate_owned_with_imports_opts(init: &Expr, funcs: &[String:Func], extern_names: Set<String>, base_dir: OSPath,
    globals: &[String:CtValue], core_imports: &[String:String], gates: GateSet, initial_impure_depth: Int) -> CtValue Diagnostic! {
    reachable :: Purity.reachable_owned_funcs(init, funcs)
    evaluate_with_imports_opts(init, &reachable, extern_names, base_dir, globals, core_imports, gates, initial_impure_depth)
}
