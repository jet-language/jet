pub fn reachable_owned_function_roots<F: Borrow<Func>>(init: &Expr, funcs: &[String:F], roots: &Set<String>) -> () {
    Purity.reachable_func_roots(init, funcs, roots)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:1650
pub fn reachable_owned_function_closure<F: Borrow<Func>>(roots: Set<String>, funcs: &[String:F]) -> Set<String> {
