// Rust: crates/jet-comptime/src/Comptime/mod.rs:755
pub fn evaluate_closed_value_with_imports_opts_collecting_structs_and_facts(init: &Expr, funcs: &[String:Func], extern_names: Set<String>,
    base_dir: OSPath, globals: &[String:CtValue], core_imports: &[String:String], gates: GateSet, initial_impure_depth: Int,
    structs: &[String:StructDef], methods: &[(String, String):Func], distinct_ranges: &[String:(I64, I64)?],
    distinct_bases: &[String:Type], unit_families: &[UnitFamilyDef], mutated: (&[String:CtValue])?,
    fact_items: &[Item], build_facts: &BuildFactSnapshot, fact_registry: &FactRegistry,
    checked_nominals: (&MirBridge.MirFragmentNominalFacts)?) -> (CtValue, [ComptimeInput]) Diagnostic! {
    closed :: fold_build_facts(init, fact_items, build_facts, fact_registry)
    nominal_facts := checked_nominals.cloned().unwrap_or_default()
    loop item in fact_items {
        if item == Item.Enum(definition) {
            row := definition.clone()
            row.methods.clear()
            row.trait_impls.clear()
            row.derives.clear()
            nominal_facts.enums.insert(row.name, row)
        }
    }
    evaluate_with_imports_opts_collecting_structs_and_methods(closed, funcs, extern_names, base_dir, globals, [:],
        core_imports, gates, initial_impure_depth, structs, methods, item_method_traits(fact_items), distinct_ranges,
        distinct_bases, unit_families, Val(nominal_facts), mutated)
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:814
fn item_method_traits(items: &[Item]) -> [(String, String):String] {
    traits := [(String, String):String]()
    insert :: fn(owner: String, trait_name: String, methods: &[Func]) {
        loop method in methods { traits.insert((owner, method.name), trait_name) }
    }
    loop item in items {
        if item == {
            .Impl(implementation) -> {
                if implementation.trait_name == Val(trait_name) { insert(implementation.type_name, trait_name, implementation.methods) }
            }
            .Struct(definition) -> { loop block in definition.trait_impls { insert(definition.name, block.trait_name, block.methods) } }
            .Enum(definition) -> { loop block in definition.trait_impls { insert(definition.name, block.trait_name, block.methods) } }
            else -> {}
        }
    }
    traits
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:847
fn fold_build_facts(init: &Expr, fact_items: &[Item], build_facts: &BuildFactSnapshot, fact_registry: &FactRegistry) -> Expr {
    closed := init.clone()
    closed.for_each_expr_mut(fn(expr) {
        if Reflect.fact_read_value_with_registry(expr, fact_items, build_facts, fact_registry) == Val(value) {
            span :: expr.span()
            expr = build_fact_expr(value, span).unwrap_or_else(fn() { Expr.ComptimeName { name: "@fact", span: span, value: Val(value) } })
        }
    })
    closed
}
// Rust: crates/jet-comptime/src/Comptime/mod.rs:873
fn build_fact_expr(value: &CtValue, span: Span) -> Expr? {
    Val(if value == {
        .Bool(value) -> Expr.Bool(value, span)
        .Int(value) -> Expr.Int(value, span, None, None)
        .BigInt(value) -> Expr.Int(0, span, None, Val(value.to_string_rep()))
        .Float(value) -> Expr.Float(value.as_f64(), span, false, None)
        .Char(value) -> Expr.Char(value, span)
        .Str(value) -> Expr.Str([StrPart.Lit(value)], span)
        .List(values) -> {
            expressions := [Expr]()
            loop value in values {
                if build_fact_expr(value, span) == { Val(expr) -> expressions.push(expr) None -> return None }
            }
            Expr.ListLit(expressions, span)
        }
        .Map(values) -> {
            expressions := [(Expr, Expr)]()
            // GATE #4499: preserve BTreeMap's canonical key order.
            keys := values.keys().collect::<[CtKey]>()
            keys.sort()
            loop key in keys {
                key_expr :: build_fact_expr(key.to_value(), span)
                value_expr :: build_fact_expr(values[key], span)
                if key_expr == None || value_expr == None -> return None
                expressions.push((key_expr.unwrap(), value_expr.unwrap()))
            }
            Expr.MapLit(expressions, span)
        }
        .Enum { type_name, variant, args } -> {
            if !args.is_empty() -> return None
            Expr.EnumLit { type_name: type_name, variant: variant, variant_span: None, args: [], leading_dot: false, span: span }
        }
        .Struct { .. } -> Expr.ComptimeName { name: "", span: span, value: Val(value.clone()) }
        .Present(value) -> {
            inner :: build_fact_expr(value, span)
            if inner == None -> return None
            Expr.Present(inner.unwrap(), span)
        }
        .Failed(.Clean(_)) -> Expr.ComptimeName { name: "", span: span, value: Val(value.clone()) }
        else -> return None
    })
}
