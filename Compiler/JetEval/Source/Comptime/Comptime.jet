// Rust: crates/jet-comptime/src/Comptime/mod.rs:321
pub fn exact_integer_ct_value(value: I64, raw: String?) -> CtValue {
    if raw == None -> return CtValue.Int(value)
    exact :: if CtBigInt.from_literal(raw.unwrap()) == { Ok(exact) -> exact else -> return CtValue.Int(value) }
    if exact.try_i64() == { Val(value) -> CtValue.Int(value) None -> CtValue.BigInt(exact) }
}
