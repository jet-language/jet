use jet_foundation.[Diagnostic, Span, BinOp, CtFloat, CtKey, CtReport, CtValue, CtMapEntry, NamedCtValue, Type]
use jet_comptime.Builtins.[as_bool, as_int, cmp, exact_big, exact_int_value]
use jet_comptime.Interpreter.[Interp]
use jet_comptime.Comptime.[CollectionEval]
use jet_comptime.Numeric.[CtBigInt]
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:14
use jet_codegen.Prelude.Core.[SimdLanes, ParallelKernel]
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:20
pub enum SequenceOutcome { Value(value: CtValue) WriteBack(value: CtValue) }
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:25
pub fn eval_sequence_method(interp: &Interp, recv: &CtValue, method: String, args: &[CtValue], arg_labels: &[String?], resolved_ret: Type?, span: Span, scope: &[String:CtValue]) -> (SequenceOutcome Diagnostic!)? {
    xs :: if recv == { .List(xs) -> xs else -> return None }
    recognized :: if method == {
        "all" | "any" | "chunks" | "count_by" | "counts" | "dedup" | "indexed" | "indexes" | "filter_map" | "first" | "flat_map" | "flatten" | "fold" | "group_by" | "index_of" | "insert" | "intersperse" | "last" | "max" | "max_by" | "min" | "min_by" | "para_filter" | "para_fold" | "para_map" | "para_partition" | "partition" | "position" | "product" | "reduce" | "scan" | "skip" | "skip_while" | "step_by" | "sum" | "take" | "take_while" | "try_collect" | "unzip" | "windows" | "zip" | "zip_short" | "zip_pad" -> true
        else -> false
    }
    if !recognized -> return None
    Val((fn() -> SequenceOutcome Diagnostic! {
        if method == "insert" {
            out := xs.clone(); CollectionEval.list_insert_args(&out, args, span)!
            return SequenceOutcome.WriteBack{value: CtValue.List{values: ^out}}
        }
        SequenceOutcome.Value{value: eval(interp, &xs, method, args, arg_labels, resolved_ret, span, scope)!}
    })())
}
// GATE #4499: exact CtKey equality/hash/order, including composite keys.
fn sequence_map_value(entries: [CtKey:CtValue]) -> CtValue Never! {
    keys := entries.keys().to_list(); keys.sort()
    out := [CtMapEntry]{}
    loop k in keys { out.push(CtMapEntry{key: k, value: entries[k]}) }
    CtValue.Map{entries: ^out}
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:108
fn eval(interp: &Interp, xs: &[CtValue], method: String, args: &[CtValue], arg_labels: &[String?], resolved_ret: Type?, span: Span, scope: &[String:CtValue]) -> CtValue Diagnostic! {
    if method == {
        "all" | "any" -> if args.len() == 1 {
            loop x in xs {
                value :: interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!
                result :: as_bool(&value, span)!
                if method == "all" && !result -> return CtValue.Bool{value: false}
                if method == "any" && result -> return CtValue.Bool{value: true}
            }
            return CtValue.Bool{value: method == "all"}
        }
        "chunks" | "take" | "skip" | "step_by" | "windows" -> if args.len() == 1 {
            n :: as_int(&args[0], span)!
            if CollectionEval.sequence_argument_message(method, n) == { Val(message) -> fail comptime_panic(message, span) else -> {} }
            if method == "skip" -> return CtValue.List{values: CollectionEval.iter_skip(xs.to_list(), n)}
            out := [CtValue]{}
            if method == {
                "chunks" -> { i := 0; loop i < xs.len() { out.push(CtValue.List{values: xs[i..<(i + n).min(xs.len())].to_list()}); i += n } }
                "take" -> loop i in 0..<n.min(xs.len()) { out.push(xs[i].clone()) }
                "step_by" -> { i := 0; loop i < xs.len() { out.push(xs[i].clone()); i += n } }
                else -> { i := 0; loop i + n <= xs.len() { out.push(CtValue.List{values: xs[i..<i + n].to_list()}); i += 1 } }
            }
            return CtValue.List{values: ^out}
        }
        "count_by" | "counts" -> if (method == "count_by" && args.len() == 1) || (method == "counts" && args.is_empty()) {
            out := [CtKey:CtValue]{}
            loop x in xs {
                v :: if method == "counts" -> x.clone() else -> interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!
                k :: key(v, span)!
                count :: if out.get(k) == { Val(.Int(n)) -> n else -> 0 }
                out[k] = CtValue.Int{value: count + 1}
            }
            return sequence_map_value(^out)
        }
        "dedup" -> if args.is_empty() {
            out := [CtValue]{}; loop x in xs { if out.is_empty() || out[out.len() - 1] != x -> out.push(x.clone()) }
            return CtValue.List{values: ^out}
        }
        "indexed" | "indexes" -> if args.is_empty() {
            out := [CtValue]{}
            loop i in 0..<xs.len() { out.push(if method == "indexes" -> CtValue.Int{value: i} else -> tuple([(String, CtValue)]{("idx", CtValue.Int{value: i}), ("item", xs[i].clone())})) }
            return CtValue.List{values: ^out}
        }
        "filter_map" -> if args.len() == 1 {
            out := [CtValue]{}
            loop x in xs {
                if interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)! == {
                    .Present(value) -> out.push(^value)
                    .Failed(.Told(_)) -> {}
                    else -> fail unsupported("filter_map callback returning a non-Result", span)
                }
            }
            return CtValue.List{values: ^out}
        }
        "first" -> if args.is_empty() -> return option(CollectionEval.iter_first(xs.to_list()), xs)
        "flat_map" -> if args.len() == 1 {
            out := [CtValue]{}
            loop x in xs {
                value :: interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!
                if value == { .List(values) -> out.extend(^values) else -> fail unsupported("flat_map callback returning a non-list", span) }
            }
            return CtValue.List{values: ^out}
        }
        "flatten" -> if args.is_empty() {
            out := [CtValue]{}
            loop x in xs { if x == { .List(values) -> out.extend(values.clone()) else -> fail unsupported("flatten on a non-nested list", span) } }
            return CtValue.List{values: ^out}
        }
        "para_fold" -> if args.len() == 3 {
            if xs.is_empty() -> return interp.call_closure(&args[0], [CtValue]{}, span)
            indexed :: ParallelKernel.jet_list_para_chunks_serial_kernel(xs.len(), fn(range) -> CtValue Diagnostic! {
                acc := interp.call_closure(&args[0], [CtValue]{}, span)!
                loop x in xs[range] { acc = interp.call_closure(&args[1], [CtValue]{^acc, x.clone()}, span)! }
                ^acc
            })
            partials := [CtValue]{}
            loop (_, result) in indexed { partials.push(result!) }
            return ParallelKernel.jet_list_para_merge_tree(^partials, fn(left: CtValue, right: CtValue) -> CtValue Diagnostic! { interp.call_closure(&args[2], [CtValue]{^left, ^right}, span) })
        }
        "group_by" -> if args.len() == 1 {
            out := [CtKey:CtValue]{}
            loop x in xs {
                k :: key(interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!, span)!
                group := &out.entry(k).or_insert(CtValue.List{values: [CtValue]{}})
                if group == { .List(values) -> values.push(x.clone()) else -> panic("group_by accumulator is not a list") }
            }
            return sequence_map_value(^out)
        }
        "index_of" -> if args.len() == 1 {
            loop i in 0..<xs.len() { if xs[i] == args[0] -> return option(Val(CtValue.Int{value: i}), &[CtValue]{}) }
            return option(None, &[CtValue]{})
        }
        "intersperse" -> if args.len() == 1 {
            out := [CtValue]{}
            loop i in 0..<xs.len() { if i != 0 -> out.push(args[0].clone()); out.push(xs[i].clone()) }
            return CtValue.List{values: ^out}
        }
        "last" -> if args.is_empty() -> return option(if xs.is_empty() -> None else -> Val(xs[xs.len() - 1].clone()), xs)
        "min" | "max" -> if args.is_empty() -> return option(extreme(xs, method == "max", span)!, xs)
        "min_by" | "max_by" -> if args.len() == 1 -> return option(extreme_by(interp, xs, &args[0], method == "max_by", span, scope)!, xs)
        "para_filter" -> if args.len() == 1 {
            out := [CtValue]{}
            loop x in xs { result :: interp.call_closure(&args[0], [CtValue]{x.clone()}, span)!; if as_bool(&result, span)! -> out.push(x.clone()) }
            return CtValue.List{values: ^out}
        }
        "para_map" -> if !args.is_empty() {
            out := [CtValue]{}
            loop x in xs { out.push(interp.call_closure(&args[0], [CtValue]{x.clone()}, span)!) }
            return CtValue.List{values: ^out}
        }
        "partition" | "para_partition" -> if args.len() == 1 {
            no := [CtValue]{}; yes := [CtValue]{}
            loop x in xs {
                value :: interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!
                if as_bool(&value, span)! -> yes.push(x.clone()) else -> no.push(x.clone())
            }
            return tuple([(String, CtValue)]{("false_", CtValue.List{values: ^no}), ("true_", CtValue.List{values: ^yes})})
        }
        "position" -> if args.len() == 1 {
            loop i in 0..<xs.len() { value :: interp.call_inline_closure(&args[0], [CtValue]{xs[i].clone()}, span, scope)!; if as_bool(&value, span)! -> return option(Val(CtValue.Int{value: i}), &[CtValue]{}) }
            return option(None, &[CtValue]{})
        }
        "sum" | "product" -> if args.is_empty() -> return aggregate(xs, method == "product", resolved_ret, span)
        "scan" -> if args.len() == 2 {
            acc := args[0].clone(); out := [CtValue]{}
            loop x in xs { acc = interp.call_inline_closure(&args[1], [CtValue]{^acc, x.clone()}, span, scope)!; out.push(acc.clone()) }
            return CtValue.List{values: ^out}
        }
        "take_while" | "skip_while" -> if args.len() == 1 {
            out := [CtValue]{}; skipping := true
            loop x in xs {
                if method == "take_while" {
                    value :: interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!
                    if !as_bool(&value, span)! -> break
                    out.push(x.clone())
                } else {
                    if skipping { value :: interp.call_inline_closure(&args[0], [CtValue]{x.clone()}, span, scope)!; skipping = as_bool(&value, span)! }
                    if !skipping -> out.push(x.clone())
                }
            }
            return CtValue.List{values: ^out}
        }
        "try_collect" -> if args.is_empty() {
            out := [CtValue]{}
            loop x in xs {
                if x == { .Present(value) -> out.push(value.clone()) .Failed(.Told(error)) -> return CtValue.failed(error.clone()) else -> fail unsupported("try_collect on a non-Result list", span) }
            }
            return CtValue.Present{value: CtValue.List{values: ^out}}
        }
        "unzip" -> if args.is_empty() {
            left := [CtValue]{}; right := [CtValue]{}
            loop x in xs {
                fields :: if x == { .Struct(_, fields) -> fields else -> fail unsupported("unzip on a non-tuple list", span) }
                a := None; b := None
                loop field in fields { if field.name == "a" && a.is_none() -> a = Val(field.value.clone()); if field.name == "b" && b.is_none() -> b = Val(field.value.clone()) }
                left.push(a ?? fail unsupported("unzip on a tuple without `a` and `b`", span)); right.push(b ?? fail unsupported("unzip on a tuple without `a` and `b`", span))
            }
            return tuple([(String, CtValue)]{("a", CtValue.List{values: ^left}), ("b", CtValue.List{values: ^right})})
        }
        "zip" | "zip_short" | "zip_pad" -> return eval_zip(xs, method, args, arg_labels, span)
        else -> {}
    }
    fail unsupported("the method `.{method}` with these arguments", span)
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:489
fn eval_zip(first: &[CtValue], method: String, args: &[CtValue], arg_labels: &[String?], span: Span) -> CtValue Diagnostic! {
    columns := [[CtValue]]{first.to_list()}; common_fill := None; column_fills := None
    loop i in 0..<args.len() {
        label :: if i < arg_labels.len() -> arg_labels[i] else -> None
        if label == {
            Val("fill") -> common_fill = Val(args[i].clone())
            Val("fills") -> column_fills = Val(args[i].clone())
            else -> if args[i] == { .List(values) -> columns.push(values.clone()) else -> fail unsupported("zip with a non-list argument", span) }
        }
    }
    mode :: if method == { "zip" -> 1 "zip_pad" -> 2 else -> 0 }
    lengths := [Int]{}; loop column in columns { lengths.push(column.len()) }
    row_count :: CollectionEval.zip_row_count(&lengths, mode) ?? fail Diagnostic.error("E0128", "zip inputs have different lengths", "strict `zip` requires every input to end on the same row", "use `zip_short` or `zip_pad` when lengths may differ", Val(span))
    if columns.len() == 1 -> return CtValue.List{values: columns.pop().unwrap_or([CtValue]{})}
    fields := [String]{}; loop i in 0..<columns.len() { fields.push(zip_field_name(i)) }
    fill_for :: fn(index: Int) -> CtValue Never! {
        if common_fill == { Val(value) -> return value.clone() else -> {} }
        if column_fills == {
            Val(.Struct(_, members)) -> loop member in members {
                if member.name == fields[index] || member.name.strip_prefix(jet_foundation.Syntax.GENERATED_NAME_PREFIX) == Val(fields[index]) -> return member.value.clone()
            }
            else -> {}
        }
        CtValue.absent(if columns[index].is_empty() -> Type.Int else -> columns[index][0].jet_type())
    }
    rows := [CtValue]{}
    loop row in 0..<row_count {
        members := [(String, CtValue)]{}
        loop i in 0..<columns.len() { members.push((fields[i], if row < columns[i].len() -> columns[i][row].clone() else -> fill_for(i))) }
        rows.push(tuple(^members))
    }
    CtValue.List{values: ^rows}
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:576
fn zip_field_name(index: Int) -> String Never! { if index == { 0 -> "a" 1 -> "b" 2 -> "c" 3 -> "d" 4 -> "e" 5 -> "f" else -> "column_{index + 1}" } }
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:588
fn tuple(fields: [(String, CtValue)]) -> CtValue Never! {
    names := [String]{}; members := [NamedCtValue]{}
    loop (name, value) in fields { names.push(name); members.push(NamedCtValue{name: name, value: ^value}) }
    CtValue.Struct{type_name: "({names.join(",")})", fields: ^members}
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:606
fn key(value: CtValue, span: Span) -> CtKey Diagnostic! { CtKey.from_value(value) ?? fail unsupported("this map key type", span) }
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:610
fn option(value: CtValue?, xs: &[CtValue]) -> CtValue Never! { if value == { Val(v) -> CtValue.Present{value: ^v} None -> CtValue.absent(if xs.is_empty() -> Type.Int else -> xs[0].jet_type()) } }
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:617
fn extreme(xs: &[CtValue], maximum: Bool, span: Span) -> CtValue? Diagnostic! {
    if xs.is_empty() -> return None
    best := xs[0].clone()
    loop i in 1..<xs.len() {
        order :: cmp(best.clone(), xs[i].clone(), span)!
        if (maximum && order != Ordering.Greater) || (!maximum && order == Ordering.Greater) -> best = xs[i].clone()
    }
    Val(^best)
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:630
fn extreme_by(interp: &Interp, xs: &[CtValue], f: &CtValue, maximum: Bool, span: Span, scope: &[String:CtValue]) -> CtValue? Diagnostic! {
    if xs.is_empty() -> return None
    best := xs[0].clone(); best_key := interp.call_inline_closure(f, [CtValue]{best.clone()}, span, scope)!
    loop i in 1..<xs.len() {
        candidate_key :: interp.call_inline_closure(f, [CtValue]{xs[i].clone()}, span, scope)!
        order :: cmp(best_key.clone(), candidate_key.clone(), span)!
        if (maximum && order != Ordering.Greater) || (!maximum && order != Ordering.Less) { best = xs[i].clone(); best_key = candidate_key }
    }
    Val(^best)
}
// Rust: crates/jet-comptime/src/Comptime/SequenceParity.rs:653
fn aggregate(xs: &[CtValue], product: Bool, resolved_ret: Type?, span: Span) -> CtValue Diagnostic! {
    if xs.is_empty() {
        return if resolved_ret == {
            Val(.Float) -> CtValue.Float{value: CtFloat.f64(if product -> 1.0 else -> 0.0)}
            Val(.Float32) -> CtValue.Float{value: CtFloat.f32(if product -> 1.0 else -> 0.0)}
            else -> CtValue.Int{value: if product -> 1 else -> 0}
        }
    }
    if xs[0] == {
        .Int(_) | .BigInt(_) -> {
            acc := CtBigInt.from_int(if product -> 1 else -> 0)
            loop x in xs { value :: exact_big(&x) ?? fail unsupported("sum/product on mixed numeric types", span); acc = if product -> acc.mul(&value) else -> acc.add(&value) }
            exact_int_value(acc)
        }
        .Float(first) -> {
            acc := if first == { .F32(_) -> CtFloat.f32(if product -> 1.0 else -> 0.0) .F64(_) -> CtFloat.f64(if product -> 1.0 else -> 0.0) }
            loop x in xs {
                value :: if x == { .Float(v) -> v else -> fail unsupported("sum/product on mixed numeric types", span) }
                acc = acc.binop(if product -> BinOp.Mul else -> BinOp.Add, value) ?? fail unsupported("sum/product on mixed float widths", span)
            }
            CtValue.Float{value: acc}
        }
        else -> fail unsupported("sum/product on non-numeric values", span)
    }
}
