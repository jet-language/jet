// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2817
pub fn cbor_encode_canonical(v: &CtValue) -> [U8] CborFailure! {
    value := cbor_kernel_value(v).map_err(fn(reason) { CborFailure.new("Unsupported", 0, "$", ^reason) })?
    CborKernel.encode(&value, true).map_err(cbor_kernel_error)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2823
pub fn cbor_decode(bytes: &[U8], options: &CborKernel.Options, allow_bytes: Bool) -> CtValue CborFailure! {
