// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3139
fn jcs_big_pow(base: jcs_big.JetBigInt, exponent: USize) -> jcs_big.JetBigInt {
    out := jcs_big.JetBigInt.from_int(1)
    while exponent > 0 {
        if exponent & 1 == 1 { out = out.mul(&base) }
        base = base.mul(&base)
        exponent >>= 1
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3151
fn jcs_decimal_ratio(text: String) -> (jcs_big.JetBigInt,jcs_big.JetBigInt) {
    (mantissa, exponent) := text.split_once('e').map(fn(pair) { (pair.0, pair.1.parse<I32>().expect("Rust float exponent")) }).unwrap_or((text, 0))
    decimal := mantissa.find('.').unwrap_or(mantissa.len()) as I32
    digits: String = mantissa.chars().filter(fn(c) { c != '.' }).collect()
    numerator := jcs_big.JetBigInt.from_str(&digits).expect("Rust float digits")
    denominator := jcs_big.JetBigInt.from_int(1)
    decimal_exponent := exponent - ((digits.len() as I32) - decimal)
    if decimal_exponent >= 0 { numerator = numerator.mul(&jcs_big_pow(jcs_big.JetBigInt.from_int(10), decimal_exponent as USize)) }
    else { denominator = jcs_big_pow(jcs_big.JetBigInt.from_int(10), (-decimal_exponent) as USize) }
    (^numerator, ^denominator)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3175
fn jcs_float_ratio(value: F64) -> (jcs_big.JetBigInt,jcs_big.JetBigInt) {
    bits := value.to_bits()
    biased := ((bits >> 52) & 0x7ff) as I32
    fraction := bits & ((1 as U64 << 52) - 1)
    (significand, exponent) := if biased == 0 { (fraction, -1074) } else { ((1 as U64 << 52) | fraction, biased - 1023 - 52) }
    numerator := jcs_big.JetBigInt.from_int(significand as I64)
    denominator := jcs_big.JetBigInt.from_int(1)
    if exponent >= 0 { numerator = numerator.mul(&jcs_big_pow(jcs_big.JetBigInt.from_int(2), exponent as USize)) }
    else { denominator = jcs_big_pow(jcs_big.JetBigInt.from_int(2), (-exponent) as USize) }
    (^numerator, ^denominator)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3197
fn jcs_decimal_distance(text: String, exact: &(jcs_big.JetBigInt,jcs_big.JetBigInt)) -> jcs_big.JetBigInt {
    candidate := jcs_decimal_ratio(text)
    distance := candidate.0.mul(&exact.1).sub(&exact.0.mul(&candidate.1))
    rendered := distance.to_string_rep()
    jcs_big.JetBigInt.from_str(rendered.strip_prefix('-').unwrap_or(&rendered)).expect("absolute decimal distance")
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3208
fn jcs_positive_big_cmp(left: &jcs_big.JetBigInt, right: &jcs_big.JetBigInt) -> Ordering {
    left := left.to_string_rep()
    right := right.to_string_rep()
    left.len().cmp(&right.len()).then_with(fn() { left.cmp(&right) })
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3217
fn jcs_shortest(value: F64) -> String {
    shortest := value.debug() // GATE #4500: shortest round-trip float debug spelling.
    mantissa_end := shortest.find('e').unwrap_or(shortest.len())
    index := match shortest[..mantissa_end].rfind(fn(ch: Char) { ch.is_ascii_digit() }) { Some(index) => index, None => return ^shortest }
    digit := shortest.as_bytes()[index] - '0' as U8
    candidates := [(shortest.clone(), digit)]
    for replacement in [digit.checked_sub(1), digit.checked_add(1).filter(fn(next) { next < 10 })].into_iter().flatten() {
        candidate := shortest.clone().into_bytes()
        candidate[index] = '0' as U8 + replacement
        candidate := String.from_utf8(^candidate).expect("ASCII digit replacement")
        if candidate.parse<F64>().is_ok_and(fn(parsed) { parsed.to_bits() == value.to_bits() }) { candidates.push((^candidate, replacement)) }
    }
    exact := jcs_float_ratio(value)
    candidates.sort_by(fn(left, right) {
        left_distance := jcs_decimal_distance(&left.0, &exact)
        right_distance := jcs_decimal_distance(&right.0, &exact)
        jcs_positive_big_cmp(&left_distance, &right_distance).then_with(fn() { left.1.cmp(&right.1) }).then_with(fn() { left.0.cmp(&right.0) })
    })
    candidates.into_iter().map(fn(pair) { pair.0 }).next().expect("at least one shortest float")
}

// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3257
fn jcs_number(value: F64) -> String {
    if value == 0.0 -> return "0"
    negative := value.is_sign_negative()
    shortest := jcs_shortest(value.abs())
    (mantissa, exponent) := shortest.split_once('e').map(fn(pair) { (pair.0, pair.1.parse<I32>().expect("Rust float exponent")) }).unwrap_or((&shortest, 0))
    decimal := mantissa.find('.').unwrap_or(mantissa.len()) as I32
    digits := mantissa.bytes().filter(fn(byte) { byte != '.' as U8 }).collect<[U8]>()
    leading := digits.iter().take_while(fn(byte) { byte == '0' as U8 }).count()
    _ :: digits.drain(..leading)
    while digits.len() > 1 && digits.last() == Some(&('0' as U8)) { _ :: digits.pop() }
    n := decimal + exponent - leading as I32
    out := String.new()
    if negative { out.push('-') }
    if n > 0 && n <= 21 {
        if digits.len() <= n as USize {
            out.extend(digits.iter().map(fn(byte) { byte as Char }))
            out.extend(iter.repeat_n('0', n as USize - digits.len()))
        } else {
            split := n as USize
            out.extend(digits[..split].iter().map(fn(byte) { byte as Char }))
            out.push('.')
            out.extend(digits[split..].iter().map(fn(byte) { byte as Char }))
        }
    } else if n > -6 && n <= 0 {
        out.push_str("0.")
        out.extend(iter.repeat_n('0', (-n) as USize))
        out.extend(digits.iter().map(fn(byte) { byte as Char }))
    } else {
        out.push(digits[0] as Char)
        if digits.len() > 1 { out.push('.'); out.extend(digits[1..].iter().map(fn(byte) { byte as Char })) }
        out.push('e')
        exponent := n - 1
        if exponent >= 0 { out.push('+') }
        out.push_str(&exponent.to_string())
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3317
fn jcs_quote_text(text: String) -> [U8] {
    out: [U8] = ['"' as U8]
    HEX := "0123456789abcdef".as_bytes()
    for ch in text.chars() {
        match ch {
            '"' => out.extend_from_slice("\\\"".as_bytes()),
            '\\' => out.extend_from_slice("\\\\".as_bytes()),
            '\n' => out.extend_from_slice("\\n".as_bytes()),
            '\r' => out.extend_from_slice("\\r".as_bytes()),
            '\t' => out.extend_from_slice("\\t".as_bytes()),
            c if c as U32 == 8 => out.extend_from_slice("\\b".as_bytes()),
            c if c as U32 == 12 => out.extend_from_slice("\\f".as_bytes()),
            c if c as U32 <= 31 => {
                value := c as USize
                out.extend_from_slice(&['\\' as U8, 'u' as U8, HEX[(value >> 12) & 15], HEX[(value >> 8) & 15], HEX[(value >> 4) & 15], HEX[value & 15]])
            },
            c => {
                encoded: [U8;4] = [0;4]
                out.extend_from_slice(c.encode_utf8(&encoded).as_bytes())
            }
        }
    }
    out.push('"' as U8)
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3351
fn jcs_tree(value: &CtValue, limits: &EncodingLimitsLite, depth: I64) -> [U8] CtValue! {
    if depth > limits.max_depth -> return Err(encoding_error_value("Limit", "max_depth {limits.max_depth} exceeded"))
    if value is CtValue.Enum{type_name, variant, args} {
        if type_name == "DataTree" {
            match variant {
                "Null" => return Ok("null".as_bytes().to_vec()),
                "Bool" => {
                    b := match args.first().map(fn(pair) { &pair.1 }) { Some(CtValue.Bool(b)) => b, _ => false }
                    return Ok(if b { "true".as_bytes().to_vec() } else { "false".as_bytes().to_vec() })
                },
                "Int" => {
                    if args.first().map(fn(pair) { &pair.1 }) is Some(CtValue.Int(n)) {
                        if (n as F64) as I128 != n as I128 -> return Err(encoding_error_value("Unsupported", "JCS requires Int exactly representable as IEEE 754 binary64; encode this integer as Text"))
                        return Ok(jcs_number(n as F64).into_bytes())
                    }
                },
                "Float" => {
                    if args.first().map(fn(pair) { &pair.1 }) is Some(CtValue.Float(f)) {
                        f := f.as_f64()
                        if !f.is_finite() -> return Err(encoding_error_value("Unsupported", "JCS cannot encode a non-finite Float"))
                        return Ok(jcs_number(f).into_bytes())
                    }
                },
                "Text" => {
                    if args.first().map(fn(pair) { &pair.1 }) is Some(CtValue.Str(s)) -> return Ok(jcs_quote_text(s))
                },
                "Bytes" => return Err(encoding_error_value("Unsupported", "JSON cannot encode Bytes; encode bytes as Text explicitly")),
                "Array" => {
                    items := json_array_items(value).unwrap_or_default()
                    out := "[".as_bytes().to_vec()
                    for (index, item) in items.iter().enumerate() {
                        if index > 0 { out.push(',' as U8) }
                        out.extend_from_slice(&jcs_tree(item, limits, depth + 1)?)
                    }
                    out.push(']' as U8)
                    return Ok(^out)
                },
                "Object" => {
                    sorted := json_object_entries(value).unwrap_or_default()
                    sorted.sort_by(fn(left, right) { left.0.encode_utf16().cmp(right.0.encode_utf16()) })
                    if sorted.windows(2).any(fn(pair) { pair[0].0 == pair[1].0 }) -> return Err(encoding_error_value("Syntax", "JCS requires unique object keys"))
                    out: [U8] = ['{' as U8]
                    for (index, (key, item)) in sorted.iter().enumerate() {
                        if index > 0 { out.push(',' as U8) }
                        out.extend_from_slice(&jcs_quote_text(key))
                        out.push(':' as U8)
                        out.extend_from_slice(&jcs_tree(item, limits, depth + 1)?)
                    }
                    out.push('}' as U8)
                    return Ok(^out)
                },
                _ => {}
            }
        }
    }
    match value {
        CtValue.Bool(b) => Ok(if b { "true".as_bytes().to_vec() } else { "false".as_bytes().to_vec() }),
        CtValue.Int(n) => {
            if (n as F64) as I128 != n as I128 { Err(encoding_error_value("Unsupported", "JCS requires Int exactly representable as IEEE 754 binary64; encode this integer as Text")) }
            else { Ok(jcs_number(n as F64).into_bytes()) }
        },
        CtValue.Float(f) => {
            f := f.as_f64()
            if !f.is_finite() { Err(encoding_error_value("Unsupported", "JCS cannot encode a non-finite Float")) }
            else { Ok(jcs_number(f).into_bytes()) }
        },
        CtValue.Str(s) => Ok(jcs_quote_text(s)),
        CtValue.Bytes(_) => Err(encoding_error_value("Unsupported", "JSON cannot encode Bytes; encode bytes as Text explicitly")),
        CtValue.List(items) => {
            out := "[".as_bytes().to_vec()
            for (index, item) in items.iter().enumerate() {
                if index > 0 { out.push(',' as U8) }
                out.extend_from_slice(&jcs_tree(item, limits, depth + 1)?)
            }
            out.push(']' as U8)
            Ok(^out)
        },
        _ => Err(encoding_error_value("Unsupported", "JCS cannot encode this value"))
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3499
pub fn json_canonical_jcs(v: &CtValue, limits: &EncodingLimitsLite) -> String CtValue! {
    validate_encoding_limits(limits)?
    bytes := jcs_tree(v, limits, 1)?
    if limits.max_total_bytes.is_some_and(fn(max) { bytes.len() as I64 > max }) -> return Err(encoding_error_value("Limit", "max_total_bytes {limits.max_total_bytes.unwrap_or(0)} exceeded"))
    String.from_utf8(^bytes).map_err(fn(_) { encoding_error_value("Unsupported", "canonical JSON output is not UTF-8") })
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3521
pub fn json_canonical(v: &CtValue) -> String { jet_comptime.Comptime.JSONInterp.render_json_pretty(v, false, 0) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3524
pub fn json_events(v: &CtValue) -> String {
    // Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3525
    fn walk(path: String, t: &CtValue, out: &[String]) {
        here := if path.is_empty() { "$" } else { ^path }
        if json_object_entries(t) is Some(entries) {
            out.push("object_start {here}")
            for (k, v) in &entries { walk("{here}.{k}", v, out) }
            out.push("object_end {here}")
            return
        }
        if json_array_items(t) is Some(items) {
            out.push("array_start {here}")
            for (i, v) in items.iter().enumerate() { walk("{here}[{i}]", v, out) }
            out.push("array_end {here}")
            return
        }
        out.push("value {here} {json_canonical(t)}")
    }
    out: [String] = []
    walk("", v, &out)
    out.join("\n")
}


