pub fn xml_safe_limits_value() -> CtValue {
    limits := XmlPull.Limits.safe()
    CtValue.Struct{type_name: "XMLLimits", fields: [
        ("max_depth", CtValue.Int(limits.max_depth as I64)),
        ("max_nodes", CtValue.Int(limits.max_nodes as I64)),
        ("max_attributes_per_element", CtValue.Int(limits.max_attributes_per_element as I64)),
        ("max_name_bytes", CtValue.Int(limits.max_name_bytes as I64)),
        ("max_text_bytes", CtValue.Int(limits.max_text_bytes as I64)),
        ("max_entity_declarations", CtValue.Int(limits.max_entity_declarations as I64)),
        ("max_entity_depth", CtValue.Int(limits.max_entity_depth as I64)),
        ("max_entity_replacement_bytes", CtValue.Int(limits.max_entity_replacement_bytes as I64))
    ]}
}
