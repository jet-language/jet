// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2992
pub fn encoding_limits_from_value(v: &CtValue) -> EncodingLimitsLite Err! {
    fields := match v { CtValue.Struct{type_name, fields} if type_name == "EncodingLimits" => fields, _ => return Err("EncodingLimits expected") }
    lim := EncodingLimitsLite.safe()
    for (name, value) in fields {
        match (name, value) {
            ("buffer_bytes", CtValue.Int(n)) => lim.buffer_bytes = n,
            ("max_depth", CtValue.Int(n)) => lim.max_depth = n,
            ("max_item_bytes", CtValue.Int(n)) => lim.max_item_bytes = n,
            ("max_total_bytes", CtValue.Failed(CtReport.Clean(_))) => lim.max_total_bytes = None,
            ("max_total_bytes", CtValue.Present(inner)) => match inner.as_ref() { CtValue.Int(n) => lim.max_total_bytes = Some(n), _ => return Err("max_total_bytes must be Int?") },
            ("max_total_bytes", CtValue.Int(n)) => lim.max_total_bytes = Some(n),
            ("max_expansion_depth", CtValue.Int(n)) => lim.max_expansion_depth = n,
            ("max_expansion_bytes", CtValue.Int(n)) => lim.max_expansion_bytes = n,
            _ => {}
        }
    }
    Ok(lim)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3019
fn encoding_error_value(kind: String, reason: String) -> CtValue { encoding_error_value_at("JSON", kind, 1, 1, ^reason) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3023
fn encoding_error_value_fields(format: String, kind: String, byte_offset: I64, line: I64?, column: I64?, path: String, reason: String) -> CtValue {
    CtValue.Struct{type_name: "EncodingError", fields: [
        ("format", CtValue.Enum{type_name: "EncodingFormat", variant: format, args: []}),
        ("kind", CtValue.Enum{type_name: "EncodingErrorKind", variant: kind, args: []}),
        ("byte_offset", CtValue.Int(byte_offset)),
        ("line", line.map(fn(value) { CtValue.Present(Box.new(CtValue.Int(value))) }).unwrap_or(CtValue.absent(Type.Int))),
        ("column", column.map(fn(value) { CtValue.Present(Box.new(CtValue.Int(value))) }).unwrap_or(CtValue.absent(Type.Int))),
        ("path", CtValue.Str(^path)), ("reason", CtValue.Str(^reason)),
        ("cause", CtValue.absent(Type.Named("EncodingCause")))
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3073
pub fn encoding_error_value_at(format: String, kind: String, line: I64, column: I64, reason: String) -> CtValue {
    encoding_error_value_fields(format, kind, 0, Some(line), Some(column), "", ^reason)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:3091
fn validate_encoding_limits(limits: &EncodingLimitsLite) -> Unit CtValue! {
    invalid: String? = if limits.buffer_bytes < 4096 || limits.buffer_bytes > 16777216 {
        Some("buffer_bytes {limits.buffer_bytes} is outside 4096..16777216")
    } else if limits.max_depth < 1 || limits.max_depth > 4096 {
        Some("max_depth {limits.max_depth} is outside 1..4096")
    } else if limits.max_item_bytes < 1 || limits.max_item_bytes > 1073741824 {
        Some("max_item_bytes {limits.max_item_bytes} is outside 1..1073741824")
    } else if limits.max_total_bytes.is_some_and(fn(value) { value < 0 }) {
        Some("max_total_bytes {limits.max_total_bytes.unwrap_or_default()} is outside 0..Int.max")
    } else if limits.max_expansion_depth < 0 || limits.max_expansion_depth > 256 {
        Some("max_expansion_depth {limits.max_expansion_depth} is outside 0..256")
    } else if limits.max_expansion_bytes < 0 || limits.max_expansion_bytes > 1073741824 {
        Some("max_expansion_bytes {limits.max_expansion_bytes} is outside 0..1073741824")
    } else { None }
    match invalid { Some(reason) => Err(encoding_error_value("Limit", ^reason)), None => Ok(()) }
}
