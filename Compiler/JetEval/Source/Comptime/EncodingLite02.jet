//RS fn encoding_error_value(kind: &str, reason: impl Into<String>) -> CtValue {
//RS     encoding_error_value_at("JSON", kind, 1, 1, reason)
//RS }
//RS 
//RS fn encoding_error_value_fields(
//RS     format: &str,
//RS     kind: &str,
//RS     byte_offset: i64,
//RS     line: Option<i64>,
//RS     column: Option<i64>,
//RS     path: String,
//RS     reason: impl Into<String>,
//RS ) -> CtValue {
//RS     CtValue::Struct {
//RS         type_name: "EncodingError".to_string(),
//RS         fields: vec![
//RS             (
//RS                 "format".to_string(),
//RS                 CtValue::Enum {
//RS                     type_name: "EncodingFormat".to_string(),
//RS                     variant: format.to_string(),
//RS                     args: Vec::new(),
//RS                 },
//RS             ),
//RS             (
//RS                 "kind".to_string(),
//RS                 CtValue::Enum {
//RS                     type_name: "EncodingErrorKind".to_string(),
//RS                     variant: kind.to_string(),
//RS                     args: Vec::new(),
//RS                 },
//RS             ),
//RS             ("byte_offset".to_string(), CtValue::Int(byte_offset)),
//RS             (
//RS                 "line".to_string(),
//RS                 line.map(|value| CtValue::Present(Box::new(CtValue::Int(value))))
//RS                     .unwrap_or(CtValue::absent(Type::Int)),
//RS             ),
//RS             (
//RS                 "column".to_string(),
//RS                 column
//RS                     .map(|value| CtValue::Present(Box::new(CtValue::Int(value))))
//RS                     .unwrap_or(CtValue::absent(Type::Int)),
//RS             ),
//RS             ("path".to_string(), CtValue::Str(path)),
//RS             ("reason".to_string(), CtValue::Str(reason.into())),
//RS             (
//RS                 "cause".to_string(),
//RS                 CtValue::absent(crate::AST::Type::Named("EncodingCause".to_string())),
//RS             ),
//RS         ],
//RS     }
//RS }
//RS 
//RS pub(super) fn encoding_error_value_at(
//RS     format: &str,
//RS     kind: &str,
//RS     line: i64,
//RS     column: i64,
//RS     reason: impl Into<String>,
//RS ) -> CtValue {
//RS     encoding_error_value_fields(
//RS         format,
//RS         kind,
//RS         0,
//RS         Some(line),
//RS         Some(column),
//RS         String::new(),
//RS         reason,
//RS     )
//RS }
