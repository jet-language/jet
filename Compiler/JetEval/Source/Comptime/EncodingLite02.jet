        ("buffer_bytes", CtValue.Int(lim.buffer_bytes)), ("max_depth", CtValue.Int(lim.max_depth)),
        ("max_item_bytes", CtValue.Int(lim.max_item_bytes)), ("max_total_bytes", CtValue.absent(Type.Int)),
