//RS // #1636: one home for the limb-arithmetic bigint routine. `crate::Numeric::CtBigInt`
//RS // (jet-foundation, already a direct dependency of every seam crate) is the
//RS // canonical compiled implementation; JCS float formatting here just borrows
//RS // its name locally so the call sites below read unchanged. The Prelude's
//RS // `JetBigInt` (CommonTypes.rs) stays a separate, hand-mirrored copy — AOT
//RS // output is a standalone Rust program that can't link back into the compiler,
//RS // the same constraint `JetDecimal`/`CtDecimal` already document there.
//RS mod jcs_big {
//RS     pub use crate::Numeric::CtBigInt as JetBigInt;
//RS }
