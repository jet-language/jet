// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2223
pub fn xml_to_bytes(value: &CtValue, options: (&CtValue)?) -> [U8] CtValue! {
    value := xml_from_ct(value).map_err(xml_shape_error_value)?
    (encoding, lexical) := match options {
        Some(CtValue.Struct{fields, ..}) => {
            encoding := match fields.iter().find_map(fn(pair) { if pair.0 == "encoding" { Some(&pair.1) } else { None } }) {
                Some(CtValue.Enum{variant, ..}) if variant == "UTF8BOM" => XmlPull.RenderEncoding.UTF8Bom,
                Some(CtValue.Enum{variant, ..}) if variant == "UTF16LE" => XmlPull.RenderEncoding.Utf16Le,
                Some(CtValue.Enum{variant, ..}) if variant == "UTF16BE" => XmlPull.RenderEncoding.Utf16Be,
                _ => XmlPull.RenderEncoding.UTF8
            }
            lexical := match fields.iter().find_map(fn(pair) { if pair.0 == "lexical" { Some(&pair.1) } else { None } }) {
                Some(CtValue.Enum{variant, ..}) if variant == "Deterministic" => XmlPull.LexicalPolicy.Deterministic,
                _ => XmlPull.LexicalPolicy.PreserveValid
            }
            (encoding, lexical)
        },
        _ => (XmlPull.RenderEncoding.UTF8, XmlPull.LexicalPolicy.PreserveValid)
    }
    XmlKernel.render_document_bytes(&value, encoding, lexical).map_err(xml_error_value)
}

use jet_foundation.AST.[CtReport, StructDef]
use jet_foundation.CborKernel
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2479
fn cbor_is_u8_list(ty: (&Type)?) -> Bool {
    match ty {
        Some(Type.List(elem)) | Some(Type.FixedList{elem, ..}) => match elem.as_ref() {
            Type.IntN{signed: false, bits: 8} => true,
            Type.Named(name) => name == "U8",
            _ => false
        },
        _ => false
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2488
fn cbor_codable_value(value: &CtValue, ty: (&Type)?, struct_fields: &[String:[(String,Type)]]) -> CtValue Err! {
    ty := match ty { Some(Type.Shared(inner)) | Some(Type.Tagged{inner, ..}) => Some(inner.as_ref()), other => other }
    match value {
        CtValue.List(items) if cbor_is_u8_list(ty) => try_collect(items.iter().map(fn(item) {
            match item { CtValue.Int(n) if n >= 0 && n <= 255 => Ok(n as U8), _ => Err("CBOR [U8] contains an out-of-range byte") }
        })).map(CtValue.Bytes),
        CtValue.List(items) => {
            elem_ty := match ty { Some(Type.List(elem)) | Some(Type.FixedList{elem, ..}) => Some(elem.as_ref()), _ => None }
            try_collect(items.iter().map(fn(item) { cbor_codable_value(item, elem_ty, struct_fields) })).map(CtValue.List)
        },
        CtValue.Map(entries) => {
            value_ty := match ty { Some(Type.Map{value, ..}) => Some(value.as_ref()), _ => None }
            mapped: [CtKey:CtValue] = [CtKey:CtValue].new()
            for (key, value) in entries {
                if !(key is CtKey.Str(_)) -> return Err("CBOR Codable maps require text keys")
                _ :: mapped.insert(key.clone(), cbor_codable_value(value, value_ty, struct_fields)?)
            }
            Ok(CtValue.Map(^mapped))
        },
        CtValue.Struct{type_name, fields} => {
            definition := struct_fields.get(type_name).ok_or_else(fn() { "CBOR comptime encoder has no schema for `{type_name}`" })?
            mapped: [(String,CtValue)] = [].with_capacity(fields.len())
            for (name, value) in fields {
                field_ty := definition.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { &pair.1 })
                mapped.push((name.clone(), cbor_codable_value(value, field_ty, struct_fields)?))
            }
            Ok(CtValue.Struct{type_name: type_name.clone(), fields: ^mapped})
        },
        CtValue.Present(inner) => Ok(CtValue.Present(Box.new(cbor_codable_value(inner, match ty { Some(Type.Option(inner)) => Some(inner.as_ref()), _ => None }, struct_fields)?))),
        CtValue.Failed(CtReport.Clean(_)) => Ok(value.clone()),
        CtValue.BigInt(_) => Err("CBOR kernel cannot encode an exact Int spill"),
        CtValue.Closure(_) => Err("CBOR cannot encode a function value"),
        CtValue.Failed(CtReport.Told(_)) => Err("CBOR cannot encode a Result without an explicit Codable schema"),
        CtValue.Enum{type_name, ..} if type_name != "DataTree" => Err("CBOR comptime encoder does not own the Codable schema for enum `{type_name}`"),
        _ => Ok(value.clone())
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2575
pub fn cbor_encode_typed(value: &CtValue, root_ty: (&Type)?, struct_fields: &[String:[(String,Type)]], canonical: Bool) -> [U8] Err! {
    value := cbor_codable_value(value, root_ty, struct_fields)?
    result := if canonical { cbor_encode_canonical(&value) } else { cbor_encode(&value) }
    result.map_err(fn(error) { error.reason })
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2590
pub fn cbor_struct_fields(structs: &[String:&StructDef]) -> [String:[(String,Type)]] {
    structs.iter().map(fn(pair) { (pair.0.clone(), pair.1.reflection_fields().map(fn(field) { (field.name.clone(), field.ty.clone()) }).collect()) }).collect()
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2606
#Derive(Clone, Debug)
pub struct CborFailure {
    kind: String
    byte_offset: USize
    path: String
    pub reason: String
}
impl CborFailure {
    // Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2615
    fn new(kind: String, byte_offset: USize, path: String, reason: String) -> Self { Self{kind: kind, byte_offset: byte_offset, path: ^path, reason: ^reason} }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2630
fn cbor_encoding_kind(kind: String) -> String {
    match kind { "Truncated" => "Truncated", "Unsupported" | "NonCanonical" => "Unsupported", "Limit" => "Limit", _ => "Syntax" }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2639
pub fn cbor_encoding_error_value(error: CborFailure) -> CtValue {
    encoding_error_value_fields("CBOR", cbor_encoding_kind(error.kind), error.byte_offset as I64, None, None, error.path, error.reason)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2651
pub fn cbor_unsupported_error_value(reason: String) -> CtValue { cbor_encoding_error_value(CborFailure.new("Unsupported", 0, "$", ^reason)) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2655
pub fn cbor_safe_options() -> CborKernel.Options { CborKernel.Options.safe() }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2659
pub fn cbor_options(value: (&CtValue)?) -> CborKernel.Options CborFailure! {
    max_depth: I64? = None
    max_items: I64? = None
    max_bytes: I64? = None
    require_canonical: Bool? = None
    if value is Some(CtValue.Struct{fields, ..}) {
        for (name, value) in fields {
            match (name, value) {
                ("max_depth", CtValue.Int(n)) => max_depth = Some(n),
                ("max_items", CtValue.Int(n)) => max_items = Some(n),
                ("max_bytes", CtValue.Int(n)) => max_bytes = Some(n),
                ("require_canonical", CtValue.Bool(v)) => require_canonical = Some(v),
                _ => {}
            }
        }
    }
    CborKernel.Options.from_fields(max_depth, max_items, max_bytes, require_canonical).map_err(cbor_kernel_error)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2686
fn cbor_kernel_error(error: CborKernel.Error) -> CborFailure {
    kind := match error.kind {
        CborKernel.ErrorKind.Syntax => "Syntax", CborKernel.ErrorKind.Truncated => "Truncated",
        CborKernel.ErrorKind.Unsupported => "Unsupported", CborKernel.ErrorKind.Limit => "Limit",
        CborKernel.ErrorKind.TypeMismatch => "TypeMismatch", CborKernel.ErrorKind.TrailingData => "TrailingData",
        CborKernel.ErrorKind.NonCanonical => "NonCanonical"
    }
    CborFailure.new(kind, error.byte_offset, error.path, error.reason)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2699
fn cbor_kernel_value(value: &CtValue) -> CborKernel.Value Err! {
    if json_object_entries(value) is Some(entries) -> return try_collect(entries.iter().map(fn(pair) { cbor_kernel_value(&pair.1).map(fn(value) { (pair.0.clone(), ^value) }) })).map(CborKernel.Value.Object)
    if json_array_items(value) is Some(items) -> return try_collect(items.iter().map(cbor_kernel_value)).map(CborKernel.Value.Array)
    match value {
        CtValue.Unit | CtValue.Failed(CtReport.Clean(_)) => Ok(CborKernel.Value.Null),
        CtValue.Bool(value) => Ok(CborKernel.Value.Bool(value)),
        CtValue.Int(value) => Ok(CborKernel.Value.Int(value)),
        CtValue.Float(value) => Ok(CborKernel.Value.Float(value.as_f64())),
        CtValue.Char(value) => Ok(CborKernel.Value.Text(value.to_string())),
        CtValue.Str(value) => Ok(CborKernel.Value.Text(value.clone())),
        CtValue.Bytes(value) => Ok(CborKernel.Value.Bytes(value.clone())),
        CtValue.List(items) => try_collect(items.iter().map(cbor_kernel_value)).map(CborKernel.Value.Array),
        CtValue.Map(entries) => {
            // GATE #4499: CtKey map uses canonical key ordering.
            keys := entries.keys().cloned().collect()
            keys.sort()
            try_collect(keys.iter().map(fn(key) {
                match key {
                    CtKey.Str(text) => cbor_kernel_value(entries.get(key).unwrap()).map(fn(value) { (text.clone(), ^value) }),
                    _ => Err("CBOR maps require text keys")
                }
            })).map(CborKernel.Value.Object)
        },
        CtValue.Struct{fields, ..} => try_collect(fields.iter().map(fn(pair) { cbor_kernel_value(&pair.1).map(fn(value) { (pair.0.clone(), ^value) }) })).map(CborKernel.Value.Object),
        CtValue.Present(value) | CtValue.Failed(CtReport.Told(value)) => cbor_kernel_value(value),
        CtValue.Enum{type_name, variant, args} if type_name == "DataTree" => match variant {
            "Null" => Ok(CborKernel.Value.Null),
            "Bool" => match args.first().map(fn(pair) { &pair.1 }) { Some(CtValue.Bool(value)) => Ok(CborKernel.Value.Bool(value)), _ => Err("DataTree.Bool has an invalid payload") },
            "Int" => match args.first().map(fn(pair) { &pair.1 }) { Some(CtValue.Int(value)) => Ok(CborKernel.Value.Int(value)), _ => Err("DataTree.Int has an invalid payload") },
            "Float" => match args.first().map(fn(pair) { &pair.1 }) { Some(CtValue.Float(value)) => Ok(CborKernel.Value.Float(value.as_f64())), _ => Err("DataTree.Float has an invalid payload") },
            "Text" | "TypedText" => match args.first().map(fn(pair) { &pair.1 }) { Some(CtValue.Str(value)) => Ok(CborKernel.Value.Text(value.clone())), _ => Err("DataTree.Text has an invalid payload") },
            _ => Err("unsupported DataTree variant `{variant}`")
        },
        CtValue.Enum{type_name, ..} => Err("CBOR encoder does not own enum `{type_name}`"),
        CtValue.BigInt(_) => Err("CBOR kernel cannot encode an exact Int spill"),
        CtValue.Closure(_) => Err("CBOR cannot encode a function value")
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2783
fn cbor_kernel_tree(value: CborKernel.Value) -> CtValue {
    match value {
        CborKernel.Value.Null => json_variant("Null", None),
        CborKernel.Value.Bool(value) => json_variant("Bool", Some(CtValue.Bool(value))),
        CborKernel.Value.Int(value) => json_variant("Int", Some(CtValue.Int(value))),
        CborKernel.Value.Float(value) => json_variant("Float", Some(CtValue.Float(CtFloat.f64(value)))),
        CborKernel.Value.Text(value) => json_variant("Text", Some(CtValue.Str(^value))),
        CborKernel.Value.Bytes(value) => CtValue.Bytes(^value),
        CborKernel.Value.Array(values) => json_array(values.into_iter().map(cbor_kernel_tree).collect()),
        CborKernel.Value.Object(entries) => json_object(entries.into_iter().map(fn(pair) { (pair.0, cbor_kernel_tree(pair.1)) }).collect())
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2811
