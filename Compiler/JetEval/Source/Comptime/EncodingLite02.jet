// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2047
fn xml_int(fields: &[(String,CtValue)], name: String) -> I64 {
    fields.iter().find_map(fn(pair) { if pair.0 == name { match pair.1 { CtValue.Int(value) => Some(value), _ => None } } else { None } }).unwrap_or(-1)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2061
fn xml_options(value: &CtValue) -> XmlPull.ParseOptions XmlPull.Error! {
    fields := match value { CtValue.Struct{fields, ..} => fields, _ => return Ok(XmlPull.ParseOptions.safe()) }
    entities := fields.iter().find_map(fn(pair) { if pair.0 == "entities" { Some(&pair.1) } else { None } })
    entities := match entities {
        Some(CtValue.Enum{variant, ..}) if variant == "Reject" => XmlPull.EntityPolicy.Reject,
        Some(CtValue.Enum{variant, args, ..}) if variant == "Resolve" => {
            resolved: [String:String] = [String:String].new()
            if args.first() is Some((_, CtValue.Map(entries))) {
                for (key, value) in entries {
                    match (key, value) { (CtKey.Str(key), CtValue.Str(value)) => { _ :: resolved.insert(key.clone(), value.clone()) }, _ => {} }
                }
            }
            XmlPull.EntityPolicy.Resolve(^resolved)
        },
        _ => XmlPull.EntityPolicy.Preserve
    }
    limits_fields := fields.iter().find_map(fn(pair) { if pair.0 == "limits" { match pair.1 { CtValue.Struct{fields, ..} => Some(fields), _ => None } } else { None } })
    to_usize := fn(value: I64) { USize.try_from(value).unwrap_or(USize.MAX) } // GATE #4483: selected-target width.
    limits := if limits_fields is Some(fields) {
        XmlPull.Limits{
            max_depth: to_usize(xml_int(fields, "max_depth")),
            max_nodes: to_usize(xml_int(fields, "max_nodes")),
            max_attributes_per_element: to_usize(xml_int(fields, "max_attributes_per_element")),
            max_name_bytes: to_usize(xml_int(fields, "max_name_bytes")),
            max_text_bytes: to_usize(xml_int(fields, "max_text_bytes")),
            max_entity_declarations: to_usize(xml_int(fields, "max_entity_declarations")),
            max_entity_depth: to_usize(xml_int(fields, "max_entity_depth")),
            max_entity_replacement_bytes: to_usize(xml_int(fields, "max_entity_replacement_bytes"))
        }
    } else { XmlPull.Limits.safe() }
    options := XmlPull.ParseOptions{entities: ^entities, limits: ^limits}
    options.limits.validate()?
    Ok(^options)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2119
fn xml_error_kind(kind: XmlPull.Reason) -> String {
    match kind { XmlPull.Reason.EntityCycle | XmlPull.Reason.Limit => "Limit", XmlPull.Reason.Canonicalization | XmlPull.Reason.Unsupported => "Unsupported", _ => "Syntax" }
}
