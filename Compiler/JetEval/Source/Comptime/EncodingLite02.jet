fn xml_error_value_with_source(error: XmlPull.Error, source_bytes: Bool) -> CtValue {
    byte_offset := if source_bytes || error.line.is_some() { error.offset as I64 } else { 0 }
    encoding_error_value_fields("XML", xml_error_kind(error.kind), byte_offset, error.line.map(fn(value) { value as I64 }), error.column.map(fn(value) { value as I64 }), error.path, error.reason)
}
