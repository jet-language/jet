// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1792
fn yaml_render_scalar(v: &CtValue) -> String {
    if json_object_entries(v) is Some(entries) {
        parts: [String] = entries.iter().map(fn(pair) { "{yaml_render_key(&pair.0)}: {yaml_render_scalar(&pair.1)}" }).collect()
        return "\{{parts.join(\", \")}\}"
    }
    if json_array_items(v) is Some(items) {
        parts: [String] = items.iter().map(yaml_render_scalar).collect()
        return "[{parts.join(\", \")}]"
    }
    match v {
        CtValue.Enum{variant, args, ..} => match (variant, args.first()) {
            ("Null", _) => "null",
            ("Bool", Some((_, CtValue.Bool(b)))) => b.to_string(),
            ("Int", Some((_, CtValue.Int(n)))) => n.to_string(),
            ("Float", Some((_, CtValue.Float(f)))) => f.debug(),
            ("Text", Some((_, CtValue.Str(s)))) => if yaml_needs_quote(s) { s.debug() } else { s.clone() },
            _ => "null"
        },
        _ => "null"
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1822
fn yaml_needs_quote(s: String) -> Bool {
    s.is_empty() || ["null", "Null", "NULL", "~", "true", "True", "TRUE", "false", "False", "FALSE"].contains(s)
        || jet_foundation.Numeric.CtBigInt.from_str(s).is_ok() || s.parse<F64>().is_ok()
        || s.starts_with(' ') || s.ends_with(' ')
        || s.starts_with(['-', '?', ':', '[', ']', '{', '}', '#', '&', '*', '!', '|', '>', '\'', '"', '%', '@', '`'])
        || s.contains(": ") || s.contains(" #") || s.contains('\n')
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1845
fn xml_to_ct(value: XmlPull.Value) -> CtValue { xml_value_to_ct(^value) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1849
fn xml_value_to_ct(value: XmlPull.Value) -> CtValue {
    match value {
        XmlPull.Value.Null => json_variant("Null", None),
        XmlPull.Value.Bool(value) => json_variant("Bool", Some(CtValue.Bool(value))),
        XmlPull.Value.Int(value) => json_variant("Int", Some(CtValue.Int(value))),
        XmlPull.Value.Text(value) => json_variant("Text", Some(CtValue.Str(^value))),
        XmlPull.Value.Array(values) => json_array(values.into_iter().map(xml_value_to_ct).collect()),
        XmlPull.Value.Object(entries) => json_object(entries.into_iter().map(fn(pair) { (pair.0, xml_value_to_ct(pair.1)) }).collect())
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1866
fn restore_xml_snapshot_order(value: &XmlPull.Value) {
    match value {
        XmlPull.Value.Array(values) => for value in values { restore_xml_snapshot_order(&value) },
        XmlPull.Value.Object(entries) => {
            for (_, value) in entries { restore_xml_snapshot_order(&value) }
            if XmlPull.xml_schema_order(entries) is Some(order) {
                entries.sort_by_key(fn(pair) { order.iter().position(fn(expected) { expected == &pair.0 }).expect("checked XML schema key") })
            }
        },
        _ => {}
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1893
fn xml_value_from_ct(value: &CtValue) -> XmlPull.Value Err! {
    match value { CtValue.Enum{type_name, variant, args} if type_name == "DataTree" && variant == "Null" && args.is_empty() => return Ok(XmlPull.Value.Null), _ => {} }
    if json_payload(value, "Bool") is Some(CtValue.Bool(value)) -> return Ok(XmlPull.Value.Bool(value))
    if json_payload(value, "Int") is Some(CtValue.Int(value)) -> return Ok(XmlPull.Value.Int(value))
    if json_payload(value, "Text") is Some(CtValue.Str(value)) -> return Ok(XmlPull.Value.Text(value.clone()))
    if json_payload(value, "Array") is Some(CtValue.List(values)) -> return Ok(XmlPull.Value.Array(try_collect(values.iter().map(xml_value_from_ct))?))
    if json_object_entries(value) is Some(entries) {
        converted := try_collect(entries.into_iter().map(fn(pair) { Ok((pair.0, xml_value_from_ct(&pair.1)?)) }))?
        return Ok(XmlPull.Value.Object(^converted))
    }
    Err("XML tree contains a non-DataTree value")
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:1932
pub fn xml_from_ct(value: &CtValue) -> XmlPull.Value Err! {
    value := xml_value_from_ct(value)?
    XmlPull.invalidate_untrusted_lexical_evidence(&value)
    restore_xml_snapshot_order(&value)
    Ok(^value)
}
