// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2912
pub fn jsonl_parse(text: String) -> [CtValue] CtValue! {
    out: [CtValue] = []
    for (idx, line) in text.lines().enumerate() {
        trimmed := line.trim() // #4303
        if trimmed.is_empty() -> continue
        match jet_comptime.Comptime.JSONInterp.parse_json(trimmed) {
            Ok(v) => out.push(^v),
            Err(e) => return Err(jet_comptime.Comptime.JSONInterp.encoding_error_value_at_line(e, idx as I64))
        }
    }
    Ok(^out)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:2926
pub fn jsonl_render(rows: &[CtValue]) -> String {
    out := rows.iter().map(fn(v) { jet_comptime.Comptime.JSONInterp.render_json_pretty(v, false, 0) }).collect<[String]>().join("\n")
    if !out.is_empty() { out.push('\n') }
    ^out
}
