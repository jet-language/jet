// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:474
fn list_field(fields: &[(String,CtValue)], wanted: String) -> [CtValue] {
    for (name, value) in fields {
        if name == wanted {
            match value { CtValue.List(values) => return values.clone(), _ => {} }
        }
    }
    []
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:484
fn int_field(fields: &[(String,CtValue)], wanted: String) -> I64? {
    for (name, value) in fields {
        if name == wanted { match value { CtValue.Int(n) => return Some(n), _ => {} } }
    }
    None
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:493
fn unique_values(items: [CtValue]) -> [CtValue] {
    unique: [CtValue] = []
    for item in items { if !unique.contains(&item) { unique.push(^item) } }
    ^unique
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:504
fn sorted_unique(items: [CtValue], span: Span) -> [CtValue] Diagnostic! {
    sort_error: Diagnostic? = None
    items.sort_by(fn(left, right) {
        match cmp_for_sort(left.clone(), right.clone(), span) {
            Ok(order) => order,
            Err(error) => { _ :: sort_error.get_or_insert(error); Ordering.Equal }
        }
    })
    if sort_error is Some(error) -> return Err(error)
    items.dedup()
    Ok(^items)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:522
fn sorted_descending(items: [CtValue], span: Span) -> [CtValue] Diagnostic! {
    sort_error: Diagnostic? = None
    items.sort_by(fn(left, right) {
        match cmp_for_sort(right.clone(), left.clone(), span) {
            Ok(order) => order,
            Err(error) => { _ :: sort_error.get_or_insert(error); Ordering.Equal }
        }
    })
    match sort_error { Some(error) => Err(error), None => Ok(^items) }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:539
fn as_string(v: &CtValue, span: Span) -> String Diagnostic! {
    match v { CtValue.Str(s) => Ok(s.clone()), _ => Err(unsupported("non-String argument to Bytes", span)) }
}
