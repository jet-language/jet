//RS fn collection_struct_fields<'a>(
//RS     value: &'a CtValue,
//RS     expected: &str,
//RS     what: &str,
//RS     span: Span,
//RS ) -> Result<&'a [(String, CtValue)], Diagnostic> {
//RS     match value {
//RS         CtValue::Struct { type_name, fields }
//RS             if collection_type_matches(type_name, expected) =>
//RS         {
//RS             Ok(fields)
//RS         }
//RS         _ => Err(unsupported(what, span)),
//RS     }
//RS }
