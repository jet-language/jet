// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:617
pub fn from_list(type_name: String, list: &CtValue, span: Span) -> CtValue Diagnostic! {
    match list {
        CtValue.List(values) => {
            items := values.clone()
            match type_name {
                Syntax.TYPE_SET => Ok(set_struct(type_name, unique_values(^items))),
                Syntax.TYPE_RANK => Ok(set_struct(type_name, sorted_unique(^items, span)?)),
                Syntax.TYPE_PRIORITY_QUEUE => Ok(set_struct(type_name, sorted_descending(^items, span)?)),
                Syntax.TYPE_QUEUE => Ok(deque_struct(^items)),
                _ => Err(unsupported("{type_name}.from at compile time", span))
            }
        },
        _ => Err(unsupported("{type_name}.from with a non-list", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:641
pub fn byte_buffer_from(bytes: &CtValue, span: Span) -> CtValue Diagnostic! { Ok(byte_buffer_struct(as_bytes(bytes, span)?)) }
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:646
pub fn prelude_new(path: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    match path {
        "JetBitSet" => Some(Ok(bitset_struct([]))),
        "JetByteBuffer" => {
            capacity: USize = 0
            if args.first() is Some(v) {
                match as_int(v, span) { Ok(n) => capacity = n.max(0) as USize, Err(e) => return Some(Err(e)) }
            }
            bytes: [U8] = []
            bytes.reserve(capacity)
            Some(Ok(byte_buffer_struct(^bytes)))
        },
        "JetCache" => {
            capacity: I64 = 0
            if args.first() is Some(v) {
                match as_int(v, span) { Ok(n) => capacity = n.max(0), Err(e) => return Some(Err(e)) }
            }
            Some(Ok(lru_struct(capacity, [])))
        },
        "std::collections::VecDeque" => Some(Ok(deque_struct([]))),
        "std::collections::HashMap" => Some(Ok(bag_struct([], []))),
        "std::collections::HashSet" => Some(Ok(set_struct(Syntax.TYPE_SET, []))),
        "std::collections::BTreeSet" => Some(Ok(set_struct(Syntax.TYPE_RANK, []))),
        "std::collections::BinaryHeap" => Some(Ok(set_struct(Syntax.TYPE_PRIORITY_QUEUE, []))),
        "jet_std::JetPool" => Some(Ok(pool_struct())),
        _ => None
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:695
pub fn apply_method(recv: &CtValue, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    match recv {
        CtValue.Struct{type_name, fields} => {
            method := if method == "contains" && ["Set", Syntax.TYPE_RANK, Syntax.TYPE_BITS].contains(type_name) { "has" } else { method }
            match type_name {
                Syntax.TYPE_TALLY => Some(bag_method(fields, method, args, span)),
                Syntax.TYPE_SET => Some(set_method(Syntax.TYPE_SET, fields, method, args, span, false)),
                Syntax.TYPE_RANK => Some(set_method(Syntax.TYPE_RANK, fields, method, args, span, true)),
                Syntax.TYPE_PRIORITY_QUEUE => Some(priority_queue_method(fields, method, args, span)),
                Syntax.TYPE_BITS => Some(bitset_method(fields, method, args, span)),
                Syntax.TYPE_QUEUE => Some(deque_method(fields, method, args, span)),
                Syntax.TYPE_LRU => Some(lru_method(fields, method, args, span)),
                Syntax.TYPE_BYTES => Some(byte_buffer_method(fields, method, args, span)),
                _ => None
            }
        },
        _ => None
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:756
pub fn apply_mutating(recv: &CtValue, method: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? {
    type_name := match recv { CtValue.Struct{type_name, ..} => type_name.clone(), _ => return None }
    handled := match type_name {
        Syntax.TYPE_TALLY => ["add", "remove", "clear"].contains(method),
        "Set" => ["add", "remove", "pop", "clear"].contains(method),
        Syntax.TYPE_RANK => ["add", "remove", "clear"].contains(method),
        "PriorityQueue" => ["push", "pop", "clear", "remove"].contains(method),
        Syntax.TYPE_BITS => ["add", "remove", "clear"].contains(method),
        Syntax.TYPE_QUEUE => ["push_front", "push_back", "pop_front", "pop_back", "clear"].contains(method),
        "Cache" => ["add", "add_new", "get", "remove", "clear"].contains(method),
        Syntax.TYPE_BYTES => ["clear", "write_u8", "write_u16_le", "write_u16_be", "write_i8", "write_i16_le", "write_i16_be", "write_u32_le", "write_u32_be", "write_i32_le", "write_i32_be", "write_u64_le", "write_u64_be", "write_i64_le", "write_i64_be", "write_f32_le", "write_f32_be", "write_f64_le", "write_f64_be", "write_bytes"].contains(method),
        _ => false
    }
    if !handled -> return None
    peek := recv.clone()
    fields := match &peek { CtValue.Struct{fields, ..} => fields, _ => return None }
    result := match type_name {
        Syntax.TYPE_TALLY => bag_mutating(recv, fields, method, &args, span),
        "Set" => set_mutating(recv, Syntax.TYPE_SET, fields, method, &args, span, false),
        Syntax.TYPE_RANK => set_mutating(recv, Syntax.TYPE_RANK, fields, method, &args, span, true),
        "PriorityQueue" => priority_queue_mutating(recv, fields, method, &args, span),
        Syntax.TYPE_BITS => bitset_mutating(recv, fields, method, &args, span),
        Syntax.TYPE_QUEUE => deque_mutating(recv, fields, method, &args, span),
        "Cache" => lru_mutating(recv, fields, method, &args, span),
        Syntax.TYPE_BYTES => byte_buffer_mutating(recv, fields, method, &args, span),
        _ => return None
    }
    Some(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:841
fn bag_method(fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    c := list_field(fields, "counts")
    counts := if c.is_empty() { [CtValue.Int(1); items.len()] } else { ^c }
    match method {
        "len" => Ok(CtValue.Int(counts.iter().filter_map(fn(c) { match c { CtValue.Int(n) => Some(n), _ => None } }).sum())),
        "is_empty" => Ok(CtValue.Bool(items.is_empty())),
        "has" => Ok(CtValue.Bool(items.contains(args.first().unwrap_or(&CtValue.Unit)))),
        "count" => Ok(CtValue.Int(items.iter().position(fn(item) { item == args.first().unwrap_or(&CtValue.Unit) }).and_then(fn(index) {
            match counts.get(index) { Some(CtValue.Int(count)) => Some(count), _ => None }
        }).unwrap_or(0))),
        _ => Err(unsupported("Tally.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:887
fn bag_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    c := list_field(fields, "counts")
    counts := if c.is_empty() { [CtValue.Int(1); items.len()] } else { ^c }
    result := match method {
        "clear" => { items.clear(); counts.clear(); CtValue.Unit },
        "add" => {
            value := args.first().cloned().unwrap_or(CtValue.Unit)
            if items.iter().position(fn(item) { item == &value }) is Some(index) {
                if counts.get(index) is Some(CtValue.Int(count)) { counts[index] = CtValue.Int(count + 1) }
            } else { items.push(^value); counts.push(CtValue.Int(1)) }
            CtValue.Bool(true)
        },
        "remove" => {
            value := args.first().unwrap_or(&CtValue.Unit)
            if items.iter().position(fn(item) { item == value }) is Some(index) {
                match counts.get(index) {
                    Some(CtValue.Int(1)) => { _ :: items.remove(index); _ :: counts.remove(index) },
                    Some(CtValue.Int(count)) => counts[index] = CtValue.Int(count - 1),
                    _ => {}
                }
            }
            CtValue.Unit
        },
        _ => return Err(unsupported("Tally.{method} at compile time", span))
    }
    recv.* = bag_struct(^items, ^counts)
    Ok(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:945
fn set_method(type_name: String, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span, sorted: Bool) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    match method {
        "len" => Ok(CtValue.Int(items.len() as I64)),
        "is_empty" => Ok(CtValue.Bool(items.is_empty())),
        "has" => Ok(CtValue.Bool(items.contains(args.first().unwrap_or(&CtValue.Unit)))),
        "to_list" | "values" => Ok(CtValue.List(^items)),
        "sort" => {
            items.sort_by(fn(a, b) { cmp_for_sort(a.clone(), b.clone(), span).unwrap_or(Ordering.Equal) })
            Ok(CtValue.List(^items))
        },
        "max" => jet_comptime.Comptime.Builtins.apply_method(&CtValue.List(^items), "max", args.to_vec(), span),
        "shuffle" => {
            state: U64 = 0xC0FF_EE42
            for i in (1..items.len()).rev() {
                state = state.wrapping_mul(6364136223846793005).wrapping_add(1)
                j := ((state >> 33) as USize) % (i + 1)
                items.swap(i, j)
            }
            Ok(CtValue.List(^items))
        },
        "copy" | "to_set" => Ok(set_struct(type_name, ^items)),
        "capacity" => Ok(CtValue.Int(items.len() as I64)),
        "equal" => {
            other := args.first().ok_or_else(fn() { unsupported("{type_name}.equal missing argument", span) })?
            match other {
                CtValue.Struct{type_name: other_type, fields: other_fields} => {
                    if other_type != type_name -> return Ok(CtValue.Bool(false))
                    other_items := list_field(other_fields, "items")
                    Ok(CtValue.Bool(set_semantics.jet_set_is_subset_by(&items, &other_items, fn(a,b) { a == b }) && set_semantics.jet_set_is_subset_by(&other_items, &items, fn(a,b) { a == b })))
                },
                _ => Err(unsupported("{type_name}.equal with a non-set", span))
            }
        },
        "first" => Ok(items.first().cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })),
        "last" if sorted => Ok(items.last().cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })),
        "union" => {
            other := args.first().ok_or_else(fn() { unsupported("{type_name}.union missing argument", span) })?
            match other {
                CtValue.Struct{type_name: other_type, fields: other_fields} => {
                    if other_type != type_name -> return Err(unsupported("{type_name}.union with a non-set", span))
                    other_items := list_field(other_fields, "items")
                    merged := set_semantics.jet_set_union_by(&items, &other_items, fn(left,right) { left == right })
                    merged := if sorted { sorted_unique(^merged, span)? } else { ^merged }
                    Ok(set_struct(type_name, ^merged))
                },
                _ => Err(unsupported("{type_name}.union with a non-set", span))
            }
        },
        "intersection" | "difference" | "symmetric_difference" | "is_subset" | "is_superset" | "is_disjoint" => {
            other := args.first().ok_or_else(fn() { unsupported("{type_name}.{method} missing argument", span) })?
            match other {
                CtValue.Struct{type_name: other_type, fields: other_fields} => {
                    if other_type != type_name -> return Err(unsupported("{type_name}.{method} with a non-set", span))
                    other_items := list_field(other_fields, "items")
                    equal := fn(left: &CtValue, right: &CtValue) { left == right }
                    match method {
                        "is_subset" => Ok(CtValue.Bool(set_semantics.jet_set_is_subset_by(&items, &other_items, equal))),
                        "is_superset" => Ok(CtValue.Bool(set_semantics.jet_set_is_superset_by(&items, &other_items, equal))),
                        "is_disjoint" => Ok(CtValue.Bool(set_semantics.jet_set_is_disjoint_by(&items, &other_items, equal))),
                        "intersection" => {
                            values := set_semantics.jet_set_intersection_by(&items, &other_items, equal)
                            Ok(set_struct(type_name, if sorted { sorted_unique(^values, span)? } else { ^values }))
                        },
                        "difference" => {
                            values := set_semantics.jet_set_difference_by(&items, &other_items, equal)
                            Ok(set_struct(type_name, if sorted { sorted_unique(^values, span)? } else { ^values }))
                        },
                        "symmetric_difference" => {
                            values := set_semantics.jet_set_symmetric_difference_by(&items, &other_items, equal)
                            Ok(set_struct(type_name, if sorted { sorted_unique(^values, span)? } else { ^values }))
                        },
                        _ => unreachable()
                    }
                },
                _ => Err(unsupported("{type_name}.{method} with a non-set", span))
            }
        },
        _ => Err(unsupported("{type_name}.{method} at compile time", span))
    }
}

// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1144
fn set_mutating(recv: &CtValue, type_name: String, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span, sorted: Bool) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    result := match method {
        "clear" => { items.clear(); CtValue.Unit },
        "add" => {
            value := args.first().cloned().unwrap_or(CtValue.Unit)
            added := !items.contains(&value)
            if added { items.push(^value); if sorted { items = sorted_unique(^items, span)? } }
            CtValue.Bool(added)
        },
        "remove" => {
            value := args.first().unwrap_or(&CtValue.Unit)
            if items.iter().position(fn(item) { item == value }) is Some(index) { _ :: items.remove(index) }
            CtValue.Unit
        },
        "pop" => match collection_semantics.set_pop(&items, args.first().unwrap_or(&CtValue.Unit)) {
            Some(value) => CtValue.Present(Box.new(^value)), None => option_none()
        },
        _ => return Err(unsupported("{type_name}.{method} at compile time", span))
    }
    recv.* = set_struct(type_name, ^items)
    Ok(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1196
fn priority_queue_method(fields: &[(String,CtValue)], method: String, _args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    match method {
        "len" => Ok(CtValue.Int(items.len() as I64)),
        "is_empty" => Ok(CtValue.Bool(items.is_empty())),
        "peek" => Ok(items.first().cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })),
        "to_sorted_list" => Ok(CtValue.List(^items)),
        _ => Err(unsupported("PriorityQueue.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1218
fn priority_queue_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    result := match method {
        "clear" => { items.clear(); CtValue.Unit },
        "push" => {
            items.push(args.first().cloned().unwrap_or(CtValue.Unit))
            items = sorted_descending(^items, span)?
            CtValue.Unit
        },
        "pop" => match collection_semantics.priority_queue_pop(&items) {
            Some(value) => CtValue.Present(Box.new(^value)), None => option_none()
        },
        "remove" => {
            by_slot := match args.get(1) { Some(CtValue.Enum{variant, ..}) => variant == "Slot", _ => false }
            if by_slot {
                i := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
                if i < 0 || i as USize >= items.len() -> return Err(index_oob(items.len(), i, span))
                CtValue.Present(Box.new(items.remove(i as USize)))
            } else {
                value := args.first().cloned().unwrap_or(CtValue.Unit)
                match items.iter().position(fn(item) { item == &value }) {
                    Some(index) => CtValue.Present(Box.new(items.remove(index))),
                    None => CtValue.absent(items.first().map(fn(item) { item.jet_type() }).unwrap_or(Type.Int))
                }
            }
        },
        _ => return Err(unsupported("PriorityQueue.{method} at compile time", span))
    }
    recv.* = set_struct(Syntax.TYPE_PRIORITY_QUEUE, ^items)
    Ok(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1279
fn bitset_method(fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    bits := list_field(fields, "bits")
    match method {
        "count" => Ok(CtValue.Int(bits.len() as I64)),
        "len" => Ok(CtValue.Int(match bits.last() { Some(CtValue.Int(bit)) => bit + 1, _ => 0 })),
        "is_empty" => Ok(CtValue.Bool(bits.is_empty())),
        "has" => {
            bit := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            Ok(CtValue.Bool(bits.contains(&CtValue.Int(bit))))
        },
        "copy" => Ok(bitset_struct(bits.clone())),
        "to_list" => Ok(CtValue.List(^bits)),
        _ => Err(unsupported("Bits.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1306
fn bitset_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    bits := list_field(fields, "bits")
    result := match method {
        "clear" => { bits.clear(); CtValue.Unit },
        "add" => {
            bit := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            added := bit >= 0 && !bits.contains(&CtValue.Int(bit))
            if added { bits.push(CtValue.Int(bit)); bits = sorted_unique(^bits, span)? }
            CtValue.Bool(added)
        },
        "remove" => {
            bit := CtValue.Int(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?)
            if bits.iter().position(fn(value) { value == &bit }) is Some(index) { _ :: bits.remove(index) }
            CtValue.Unit
        },
        _ => return Err(unsupported("Bits.{method} at compile time", span))
    }
    recv.* = bitset_struct(^bits)
    Ok(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1346
fn deque_method(fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    match method {
        "len" | "capacity" => Ok(CtValue.Int(items.len() as I64)),
        "is_empty" => Ok(CtValue.Bool(items.is_empty())),
        "peek_front" => Ok(items.first().cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })),
        "peek_back" => Ok(items.last().cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })),
        "get" => {
            idx := match args.first() { Some(CtValue.Int(i)) if i >= 0 => i as USize, _ => return Ok(option_none()) }
            Ok(items.get(idx).cloned().map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) }))
        },
        "contains" => {
            needle := args.first().cloned().unwrap_or(CtValue.Unit)
            Ok(CtValue.Bool(items.iter().any(fn(x) { x == &needle })))
        },
        "to_list" => Ok(CtValue.List(^items)),
        "join" => {
            sep := match args.first() { Some(CtValue.Str(s)) => s, _ => "" }
            parts: [String] = items.iter().map(fn(x) { x.jet_show() }).collect()
            Ok(CtValue.Str(parts.join(sep)))
        },
        _ => Err(unsupported("Queue.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1394
fn deque_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := list_field(fields, "items")
    result := match method {
        "clear" => { items.clear(); CtValue.Unit },
        "push_front" => { items.insert(0, args.first().cloned().unwrap_or(CtValue.Unit)); CtValue.Unit },
        "push_back" => { items.push(args.first().cloned().unwrap_or(CtValue.Unit)); CtValue.Unit },
        "pop_front" => match collection_semantics.deque_pop_front(&items) { Some(value) => CtValue.Present(Box.new(^value)), None => option_none() },
        "pop_back" => match collection_semantics.deque_pop_back(&items) { Some(value) => CtValue.Present(Box.new(^value)), None => option_none() },
        "delete" => {
            needle := args.first().cloned().unwrap_or(CtValue.Unit)
            if items.iter().position(fn(x) { x == &needle }) is Some(i) { _ :: items.remove(i) }
            CtValue.Unit
        },
        "reverse" => { items.reverse(); CtValue.Unit },
        "split" => {
            idx := match args.first() { Some(CtValue.Int(i)) if i >= 0 => (i as USize).min(items.len()), _ => items.len() }
            rest := items.split_off(idx)
            recv.* = deque_struct(^items)
            return Ok(deque_struct(^rest))
        },
        _ => return Err(unsupported("Queue.{method} at compile time", span))
    }
    recv.* = deque_struct(^items)
    Ok(result)
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1454
fn lru_method(fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    capacity := int_field(fields, "capacity").unwrap_or(0) as USize
    entries := list_field(fields, "entries")
    key_position := fn(entries: &[CtValue], key: &CtValue) {
        entries.iter().position(fn(entry) { match entry { CtValue.List(pair) => pair.first() == Some(key), _ => false } })
    }
    match method {
        "len" => Ok(CtValue.Int(entries.len() as I64)),
        "is_empty" => Ok(CtValue.Bool(entries.is_empty())),
        "capacity" => Ok(CtValue.Int(capacity as I64)),
        "has_key" | "contains_key" => Ok(CtValue.Bool(key_position(&entries, args.first().unwrap_or(&CtValue.Unit)).is_some())),
        "keys" => Ok(CtValue.List(entries.iter().filter_map(fn(entry) { match entry { CtValue.List(pair) => pair.first().cloned(), _ => None } }).collect())),
        _ => Err(unsupported("Cache.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1490
fn lru_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    capacity := int_field(fields, "capacity").unwrap_or(0).max(0) as USize
    entries := list_field(fields, "entries")
    key_position := fn(entries: &[CtValue], key: &CtValue) {
        entries.iter().position(fn(entry) { match entry { CtValue.List(pair) => pair.first() == Some(key), _ => false } })
    }
    key := args.first().cloned().unwrap_or(CtValue.Unit)
    value := args.get(1).cloned().unwrap_or(CtValue.Unit)
    result := match method {
        "clear" => { entries.clear(); CtValue.Unit },
        "add_new" => {
            added := capacity > 0 && key_position(&entries, &key).is_none()
            if added {
                entries.insert(0, CtValue.List([^key, ^value]))
                if entries.len() > capacity { _ :: entries.pop() }
            }
            CtValue.Bool(added)
        },
        "add" => {
            if capacity == 0 { option_none() }
            else {
                displaced := key_position(&entries, &key).map(fn(index) {
                    match entries.remove(index) {
                        CtValue.List(pair) => pair[1].clone(),
                        _ => unreachable("Cache entries are pairs")
                    }
                })
                entries.insert(0, CtValue.List([^key, ^value]))
                if entries.len() > capacity { _ :: entries.pop() }
                displaced.map_or_else(option_none, fn(v) { CtValue.Present(Box.new(^v)) })
            }
        },
        "get" => match key_position(&entries, &key) {
            Some(index) => {
                entry := entries.remove(index)
                value := match &entry { CtValue.List(pair) => pair[1].clone(), _ => unreachable("Cache entries are pairs") }
                entries.insert(0, ^entry)
                CtValue.Present(Box.new(^value))
            },
            None => option_none()
        },
        "remove" => match key_position(&entries, &key) {
            Some(index) => match entries.remove(index) {
                CtValue.List(pair) => CtValue.Present(Box.new(pair[1].clone())),
                _ => unreachable("Cache entries are pairs")
            },
            None => option_none()
        },
        _ => return Err(unsupported("Cache.{method} at compile time", span))
    }
    recv.* = lru_struct(capacity as I64, ^entries)
    Ok(result)
}

// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1570
fn byte_buffer_method(fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    bytes := fields.iter().find(fn(pair) { pair.0 == "bytes" }).map(fn(pair) { as_bytes(&pair.1, span) }).transpose()?.unwrap_or([])
    pos := fields.iter().find(fn(pair) { pair.0 == "pos" }).map(fn(pair) { as_int(&pair.1, span) }).transpose()?.unwrap_or(0).max(0) as USize
    text := String.from_utf8_lossy(&bytes).into_owned()
    match method {
        "len" => Ok(CtValue.Int(bytes.len() as I64)),
        "capacity" => Ok(CtValue.Int(bytes.capacity() as I64)),
        "is_empty" => Ok(CtValue.Bool(bytes.is_empty())),
        "to_bytes" | "get_buffer" | "buffer" => Ok(CtValue.Bytes(^bytes)),
        "position" => Ok(CtValue.Int(pos as I64)),
        "eof" => Ok(CtValue.Bool(pos >= bytes.len())),
        "to_string" | "string" => Ok(CtValue.Str(^text)),
        "is_ascii" => Ok(CtValue.Bool(bytes.is_ascii())),
        "first" => Ok(match bytes.first() { Some(b) => CtValue.Present(Box.new(CtValue.Int(b as I64))), None => CtValue.absent(Type.Int) }),
        "get" => {
            index := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            Ok(if index < 0 { CtValue.absent(Type.Int) } else {
                match bytes.get(index as USize) { Some(b) => CtValue.Present(Box.new(CtValue.Int(b as I64))), None => CtValue.absent(Type.Int) }
            })
        },
        "contains" => {
            needle := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(CtValue.Bool(text.contains(&needle)))
        },
        "starts_with" => {
            prefix := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(CtValue.Bool(text.starts_with(&prefix)))
        },
        "ends_with" => {
            suffix := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(CtValue.Bool(text.ends_with(&suffix)))
        },
        "trim" => {
            view := text.trim() // #4303
            Ok(byte_buffer_struct(view.as_bytes().to_vec()))
        },
        "trim_start" => {
            view := text.trim_start() // #4303
            Ok(byte_buffer_struct(view.as_bytes().to_vec()))
        },
        "trim_end" => {
            view := text.trim_end() // #4303
            Ok(byte_buffer_struct(view.as_bytes().to_vec()))
        },
        "to_lower" => Ok(byte_buffer_struct(text.to_lowercase().into_bytes())),
        "to_upper" => Ok(byte_buffer_struct(text.to_uppercase().into_bytes())),
        "to_title" | "title" => {
            out := String.with_capacity(text.len())
            start := true
            for ch in text.chars() {
                if ch.is_whitespace() { start = true; out.push(ch) }
                else if start { for c in ch.to_uppercase() { out.push(c) }; start = false }
                else { for c in ch.to_lowercase() { out.push(c) } }
            }
            Ok(byte_buffer_struct(out.into_bytes()))
        },
        "clone" | "copy" => Ok(byte_buffer_struct_at(^bytes, pos)),
        "lines" => Ok(CtValue.List(text.lines().map(fn(s) { CtValue.Str(s.to_string()) }).collect())),
        "index_of" => {
            needle := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(match text.find(&needle) { Some(i) => CtValue.Present(Box.new(CtValue.Int(i as I64))), None => CtValue.absent(Type.Int) })
        },
        "last_index_of" => {
            needle := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(match text.rfind(&needle) { Some(i) => CtValue.Present(Box.new(CtValue.Int(i as I64))), None => CtValue.absent(Type.Int) })
        },
        "split" => {
            sep := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            Ok(CtValue.List(text.split(&sep).map(fn(s) { CtValue.Str(s.to_string()) }).collect()))
        },
        "replace" => {
            from := as_string(args.first().unwrap_or(&CtValue.Str("")), span)?
            to := as_string(args.get(1).unwrap_or(&CtValue.Str("")), span)?
            Ok(byte_buffer_struct(text.replace(&from, &to).into_bytes()))
        },
        "join" => {
            parts: [String] = match args.first() {
                Some(CtValue.List(xs)) => try_collect(xs.iter().map(fn(x) { as_string(x, span) }))?,
                _ => []
            }
            Ok(byte_buffer_struct(parts.join(&text).into_bytes()))
        },
        "equal" => {
            other: [U8] = match args.first() {
                Some(CtValue.Struct{fields, ..}) => fields.iter().find(fn(pair) { pair.0 == "bytes" }).map(fn(pair) { as_bytes(&pair.1, span) }).transpose()?.unwrap_or([]),
                _ => []
            }
            Ok(CtValue.Bool(bytes == other))
        },
        "compare" => {
            other: [U8] = match args.first() {
                Some(CtValue.Struct{fields, ..}) => fields.iter().find(fn(pair) { pair.0 == "bytes" }).map(fn(pair) { as_bytes(&pair.1, span) }).transpose()?.unwrap_or([]),
                _ => []
            }
            Ok(CtValue.Int(match bytes.cmp(&other) { Ordering.Less => -1, Ordering.Equal => 0, Ordering.Greater => 1 }))
        },
        "parse" => {
            view := text.trim() // #4303
            match jet_foundation.Numeric.CtBigInt.from_str(view) {
                Ok(n) => Ok(CtValue.Present(Box.new(jet_comptime.Comptime.Builtins.exact_int_value(n)))),
                Err(e) => Ok(CtValue.failed(Box.new(CtValue.Str(e.to_string()))))
            }
        },
        _ => Err(unsupported("Bytes.{method} at compile time", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1734
fn byte_buffer_mutating(recv: &CtValue, fields: &[(String,CtValue)], method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    bytes := fields.iter().find(fn(pair) { pair.0 == "bytes" }).map(fn(pair) { as_bytes(&pair.1, span) }).transpose()?.unwrap_or([])
    pos := fields.iter().find(fn(pair) { pair.0 == "pos" }).map(fn(pair) { as_int(&pair.1, span) }).transpose()?.unwrap_or(0).max(0) as USize
    result := match method {
        "clear" | "close" | "shutdown" => { bytes.clear(); pos = 0; CtValue.Unit },
        "flush" => CtValue.Unit,
        "rewind" => { pos = 0; CtValue.Unit },
        "seek" => {
            index := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            pos = if index <= 0 { 0 } else if index as USize > bytes.len() { bytes.len() } else { index as USize }
            CtValue.Unit
        },
        "write_bytes" | "write" => { bytes.extend(as_bytes(args.first().unwrap_or(&CtValue.Bytes([])), span)?); CtValue.Unit },
        "write_u8" | "write_byte" => { bytes.push(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U8); CtValue.Unit },
        "write_u16_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U16).to_le_bytes()); CtValue.Unit },
        "write_u16_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U16).to_be_bytes()); CtValue.Unit },
        "write_i8" => { bytes.push(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I8 as U8); CtValue.Unit },
        "write_i16_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I16).to_le_bytes()); CtValue.Unit },
        "write_i16_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I16).to_be_bytes()); CtValue.Unit },
        "write_u32_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U32).to_le_bytes()); CtValue.Unit },
        "write_u32_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U32).to_be_bytes()); CtValue.Unit },
        "write_i32_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I32).to_le_bytes()); CtValue.Unit },
        "write_i32_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I32).to_be_bytes()); CtValue.Unit },
        "write_u64_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U64).to_le_bytes()); CtValue.Unit },
        "write_u64_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as U64).to_be_bytes()); CtValue.Unit },
        "write_i64_le" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I64).to_le_bytes()); CtValue.Unit },
        "write_i64_be" => { bytes.extend_from_slice(&(as_int(args.first().unwrap_or(&CtValue.Int(0)), span)? as I64).to_be_bytes()); CtValue.Unit },
        "write_f32_le" | "write_f32_be" => {
            value := match args.first() { Some(CtValue.Float(value)) => value.as_f32(), _ => return Err(unsupported("Bytes.write_f32 expects Float", span)) }
            if method == "write_f32_le" { bytes.extend_from_slice(&value.to_le_bytes()) }
            else { bytes.extend_from_slice(&value.to_be_bytes()) }
            CtValue.Unit
        },
        "write_f64_le" | "write_f64_be" => {
            value := match args.first() { Some(CtValue.Float(value)) => value.as_f64(), _ => return Err(unsupported("Bytes.write_f64 expects Float", span)) }
            if method == "write_f64_le" { bytes.extend_from_slice(&value.to_le_bytes()) }
            else { bytes.extend_from_slice(&value.to_be_bytes()) }
            CtValue.Unit
        },
        "read_byte" | "next" => {
            if pos >= bytes.len() { CtValue.absent(Type.Int) }
            else { b := bytes[pos]; pos += 1; CtValue.Present(Box.new(CtValue.Int(b as I64))) }
        },
        "read" => {
            if pos >= bytes.len() { CtValue.absent(Type.List(Box.new(Type.IntN{signed: false, bits: 8}))) }
            else { out := bytes[pos..].to_vec(); pos = bytes.len(); CtValue.Present(Box.new(CtValue.Bytes(^out))) }
        },
        "read_bytes" => {
            n := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            if n < 0 || pos + n as USize > bytes.len() { CtValue.absent(Type.List(Box.new(Type.IntN{signed: false, bits: 8}))) }
            else { out := bytes[pos..pos + n as USize].to_vec(); pos += n as USize; CtValue.Present(Box.new(CtValue.Bytes(^out))) }
        },
        "read_string" => {
            n := as_int(args.first().unwrap_or(&CtValue.Int(0)), span)?
            if n < 0 || pos + n as USize > bytes.len() { CtValue.absent(Type.String) }
            else {
                out := bytes[pos..pos + n as USize].to_vec()
                pos += n as USize
                CtValue.Present(Box.new(CtValue.Str(String.from_utf8_lossy(&out).into_owned())))
            }
        },
        "copy_to" | "write_to" => return Err(unsupported("Bytes.{method} at compile time", span)),
        _ => return Err(unsupported("Bytes.{method} at compile time", span))
    }
    recv.* = byte_buffer_struct_at(^bytes, pos)
    Ok(result)
}

// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1951
fn collection_type_matches(actual: String, expected: String) -> Bool { actual == expected || actual == "Jet{expected}" }
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1955
fn collection_struct_fields(value: &CtValue, expected: String, what: String, span: Span) -> &[(String,CtValue)] Diagnostic! {
    match value {
        CtValue.Struct{type_name, fields} if collection_type_matches(type_name, expected) => Ok(fields),
        _ => Err(unsupported(what, span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1971
fn collection_field(fields: &[(String,CtValue)], name: String, what: String, span: Span) -> &CtValue Diagnostic! {
    fields.iter().find(fn(pair) { pair.0 == name }).map(fn(pair) { &pair.1 }).ok_or_else(fn() { unsupported(what, span) })
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:1984
fn collection_string_list(value: &CtValue, what: String, span: Span) -> [String] Diagnostic! {
    match value {
        CtValue.List(values) => try_collect(values.iter().map(fn(value) { match value { CtValue.Str(value) => Ok(value.clone()), _ => Err(unsupported(what, span)) } })),
        _ => Err(unsupported(what, span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2001
fn collection_int_list(value: &CtValue, what: String, span: Span) -> [I64] Diagnostic! {
    match value { CtValue.List(values) => try_collect(values.iter().map(fn(value) { as_int(value, span) })), _ => Err(unsupported(what, span)) }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2015
fn collection_counter(value: &CtValue, span: Span) -> collection_semantics.JetCounter Diagnostic! {
    fields := collection_struct_fields(value, "Counter", "Counter value", span)?
    keys := collection_string_list(collection_field(fields, "keys", "Counter keys", span)?, "Counter keys", span)?
    counts := collection_int_list(collection_field(fields, "counts", "Counter counts", span)?, "Counter counts", span)?
    if keys.len() != counts.len() -> return Err(unsupported("Counter keys/counts", span))
    Ok(collection_semantics.JetCounter{keys: ^keys, counts: ^counts})
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2036
fn collection_counter_value(counter: &collection_semantics.JetCounter) -> CtValue {
    CtValue.Struct{type_name: "Counter", fields: [
        ("keys", CtValue.List(counter.keys.iter().cloned().map(CtValue.Str).collect())),
        ("counts", CtValue.List(counter.counts.iter().copied().map(CtValue.Int).collect()))
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2052
fn collection_optional_string(value: String?) -> CtValue {
    value.map(fn(value) { CtValue.Present(Box.new(CtValue.Str(^value))) }).unwrap_or_else(fn() { CtValue.absent(Type.String) })
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2058
fn collection_ordered_map(value: &CtValue, span: Span) -> collection_semantics.JetOrderedMap Diagnostic! {
    fields := collection_struct_fields(value, "OrderedMap", "OrderedMap value", span)?
    keys := collection_string_list(collection_field(fields, "keys", "OrderedMap keys", span)?, "OrderedMap keys", span)?
    values := collection_string_list(collection_field(fields, "values", "OrderedMap values", span)?, "OrderedMap values", span)?
    if keys.len() != values.len() -> return Err(unsupported("OrderedMap keys/values", span))
    Ok(collection_semantics.JetOrderedMap{keys: ^keys, values: ^values})
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2079
fn collection_ordered_map_value(map: &collection_semantics.JetOrderedMap) -> CtValue {
    CtValue.Struct{type_name: "OrderedMap", fields: [
        ("keys", CtValue.List(map.keys.iter().cloned().map(CtValue.Str).collect())),
        ("values", CtValue.List(map.values.iter().cloned().map(CtValue.Str).collect()))
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2095
fn collection_layer(value: &CtValue, span: Span) -> collection_semantics.JetLayer Diagnostic! {
    fields := collection_struct_fields(value, "Layer", "Chain layer", span)?
    keys := collection_string_list(collection_field(fields, "keys", "Chain layer keys", span)?, "Chain layer keys", span)?
    values := collection_string_list(collection_field(fields, "values", "Chain layer values", span)?, "Chain layer values", span)?
    if keys.len() != values.len() -> return Err(unsupported("Chain layer keys/values", span))
    Ok(collection_semantics.JetLayer{keys: ^keys, values: ^values})
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2116
fn collection_layer_value(layer: &collection_semantics.JetLayer) -> CtValue {
    CtValue.Struct{type_name: "Layer", fields: [
        ("keys", CtValue.List(layer.keys.iter().cloned().map(CtValue.Str).collect())),
        ("values", CtValue.List(layer.values.iter().cloned().map(CtValue.Str).collect()))
    ]}
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2132
fn collection_chain(value: &CtValue, span: Span) -> collection_semantics.JetChain Diagnostic! {
    fields := collection_struct_fields(value, "Chain", "Chain value", span)?
    match collection_field(fields, "layers", "Chain layers", span)? {
        CtValue.List(layers) => Ok(collection_semantics.JetChain{layers: try_collect(layers.iter().map(fn(layer) { collection_layer(layer, span) }))?}),
        _ => Err(unsupported("Chain layers", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2150
fn collection_chain_value(chain: &collection_semantics.JetChain) -> CtValue {
    CtValue.Struct{type_name: "Chain", fields: [("layers", CtValue.List(chain.layers.iter().map(collection_layer_value).collect()))]}
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2159
fn collection_string_set(value: &CtValue, span: Span) -> collection_semantics.JetStringSet Diagnostic! {
    fields := collection_struct_fields(value, "StringSet", "StringSet value", span)?
    Ok(collection_semantics.JetStringSet{items: collection_string_list(collection_field(fields, "items", "StringSet items", span)?, "StringSet items", span)?})
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2173
fn collection_string_set_value(set: &collection_semantics.JetStringSet) -> CtValue {
    CtValue.Struct{type_name: "StringSet", fields: [("items", CtValue.List(set.items.iter().cloned().map(CtValue.Str).collect()))]}
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2183
fn collection_optional_string_set(value: collection_semantics.JetStringSet?) -> CtValue {
    value.map(fn(value) { CtValue.Present(Box.new(collection_string_set_value(&value))) }).unwrap_or_else(fn() { CtValue.absent(Type.Named("StringSet")) })
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2191
fn collection_arg(args: &[CtValue], index: USize, method: String, span: Span) -> &CtValue Diagnostic! {
    args.get(index).ok_or_else(fn() { unsupported("core.collections.{method} argument", span) })
}
// Rust: crates/jet-comptime/src/Comptime/CollectionEval.rs:2204
pub fn apply_core_collections(module: String, method: String, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    use collection_semantics as native
    match method {
        "counter" => Ok(collection_counter_value(&native.jet_coll_counter())),
        "counter_from" => {
            keys := collection_string_list(collection_arg(args, 0, method, span)?, "core.collections.counter_from keys", span)?
            Ok(collection_counter_value(&native.jet_coll_counter_from(&keys)))
        },
        "add" if module == "core.collections" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            amount := as_int(collection_arg(args, 2, method, span)?, span)?
            Ok(collection_counter_value(&native.jet_coll_counter_add(&counter, &key, amount)))
        },
        "inc" | "dec" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            value := if method == "inc" { native.jet_coll_counter_inc(&counter, &key) } else { native.jet_coll_counter_dec(&counter, &key) }
            Ok(collection_counter_value(&value))
        },
        "get" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            Ok(CtValue.Int(native.jet_coll_counter_get(&counter, &key)))
        },
        "set_count" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            count := as_int(collection_arg(args, 2, method, span)?, span)?
            Ok(collection_counter_value(&native.jet_coll_counter_set_count(&counter, &key, count)))
        },
        "total" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            Ok(CtValue.Int(native.jet_coll_counter_total(&counter)))
        },
        "names" | "elements" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            values := if method == "names" { native.jet_coll_counter_names(&counter) } else { native.jet_coll_counter_elements(&counter) }
            Ok(CtValue.List(values.into_iter().map(CtValue.Str).collect()))
        },
        "most_common" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            count := as_int(collection_arg(args, 1, method, span)?, span)?
            Ok(collection_counter_value(&native.jet_coll_counter_most_common(&counter, count)))
        },
        "subtract" | "merge_add" => {
            left := collection_counter(collection_arg(args, 0, method, span)?, span)?
            right := collection_counter(collection_arg(args, 1, method, span)?, span)?
            value := if method == "subtract" { native.jet_coll_counter_subtract(&left, &right) } else { native.jet_coll_counter_merge_add(&left, &right) }
            Ok(collection_counter_value(&value))
        },
        "clear_counter" => {
            counter := collection_counter(collection_arg(args, 0, method, span)?, span)?
            Ok(collection_counter_value(&native.jet_coll_counter_clear(&counter)))
        },
        "ordered_map" => Ok(collection_ordered_map_value(&native.jet_coll_ordered_map())),
        "map_get" | "map_set" | "map_remove" | "map_contains" => {
            map := collection_ordered_map(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            match method {
                "map_get" => Ok(collection_optional_string(native.jet_coll_map_get(&map, &key))),
                "map_set" => {
                    value := as_string(collection_arg(args, 2, method, span)?, span)?
                    Ok(collection_ordered_map_value(&native.jet_coll_map_set(&map, &key, &value)))
                },
                "map_remove" => Ok(collection_ordered_map_value(&native.jet_coll_map_remove(&map, &key))),
                _ => Ok(CtValue.Bool(native.jet_coll_map_contains(&map, &key)))
            }
        },
        "map_keys" | "map_values" | "map_len" => {
            map := collection_ordered_map(collection_arg(args, 0, method, span)?, span)?
            match method {
                "map_keys" => Ok(CtValue.List(native.jet_coll_map_keys(&map).into_iter().map(CtValue.Str).collect())),
                "map_values" => Ok(CtValue.List(native.jet_coll_map_values(&map).into_iter().map(CtValue.Str).collect())),
                _ => Ok(CtValue.Int(native.jet_coll_map_len(&map)))
            }
        },
        "chain" => Ok(collection_chain_value(&native.jet_coll_chain())),
        "chain_push" => {
            chain := collection_chain(collection_arg(args, 0, method, span)?, span)?
            keys := collection_string_list(collection_arg(args, 1, method, span)?, "core.collections.chain_push keys", span)?
            values := collection_string_list(collection_arg(args, 2, method, span)?, "core.collections.chain_push values", span)?
            Ok(collection_chain_value(&native.jet_coll_chain_push(&chain, &keys, &values)))
        },
        "chain_get" | "chain_contains" => {
            chain := collection_chain(collection_arg(args, 0, method, span)?, span)?
            key := as_string(collection_arg(args, 1, method, span)?, span)?
            if method == "chain_get" { Ok(collection_optional_string(native.jet_coll_chain_get(&chain, &key))) }
            else { Ok(CtValue.Bool(native.jet_coll_chain_contains(&chain, &key))) }
        },
        "new" => Ok(collection_string_set_value(&native.jet_coll_set())),
        "from_list" => {
            items := collection_string_list(collection_arg(args, 0, method, span)?, "core.collections.set.from_list items", span)?
            Ok(collection_string_set_value(&native.jet_coll_set_from_list(&items)))
        },
        "add" | "discard" => {
            set := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            item := as_string(collection_arg(args, 1, method, span)?, span)?
            next := if method == "add" { native.jet_coll_set_add(&set, &item) } else { native.jet_coll_set_discard(&set, &item) }
            Ok(collection_string_set_value(&next))
        },
        "remove" => {
            set := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            item := as_string(collection_arg(args, 1, method, span)?, span)?
            Ok(collection_optional_string_set(native.jet_coll_set_remove(&set, &item)))
        },
        "contains" => {
            set := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            item := as_string(collection_arg(args, 1, method, span)?, span)?
            Ok(CtValue.Bool(native.jet_coll_set_contains(&set, &item)))
        },
        "len" | "is_empty" | "to_list" | "clear" | "clone_set" => {
            set := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            match method {
                "len" => Ok(CtValue.Int(native.jet_coll_set_len(&set))),
                "is_empty" => Ok(CtValue.Bool(native.jet_coll_set_is_empty(&set))),
                "to_list" => Ok(CtValue.List(native.jet_coll_set_items(&set).into_iter().map(CtValue.Str).collect())),
                "clear" => Ok(collection_string_set_value(&native.jet_coll_set_clear(&set))),
                _ => Ok(collection_string_set_value(&native.jet_coll_set_clone(&set)))
            }
        },
        "union" | "intersection" | "difference" | "symmetric_difference" => {
            left := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            right := collection_string_set(collection_arg(args, 1, method, span)?, span)?
            next := match method {
                "union" => native.jet_coll_set_union(&left, &right),
                "intersection" => native.jet_coll_set_intersection(&left, &right),
                "difference" => native.jet_coll_set_difference(&left, &right),
                _ => native.jet_coll_set_symmetric_difference(&left, &right)
            }
            Ok(collection_string_set_value(&next))
        },
        "issubset" | "issuperset" | "isdisjoint" => {
            left := collection_string_set(collection_arg(args, 0, method, span)?, span)?
            right := collection_string_set(collection_arg(args, 1, method, span)?, span)?
            result := match method {
                "issubset" => native.jet_coll_set_issubset(&left, &right),
                "issuperset" => native.jet_coll_set_issuperset(&left, &right),
                _ => native.jet_coll_set_isdisjoint(&left, &right)
            }
            Ok(CtValue.Bool(result))
        },
        _ => Err(unsupported("core.collections.{method}()", span))
    }
}

