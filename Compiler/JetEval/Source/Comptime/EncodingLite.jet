// PORT-PENDING 0584 crates-jet-comptime-src-comptime-encodinglite-slice-1: crates/jet-comptime/src/Comptime/EncodingLite.rs:1-1791
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Card #392 pass 4 gap fix: `core.encoding.{csv,toml,yaml,xml,cbor,jsonl}`
//RS //! + `core.encoding.json.{canonical,events}`, ported verbatim into the
//RS //! comptime/REPL tier-0 interpreter so they match AOT byte-for-byte (R12
//RS //! parity). Sources (std-only, I6, no changes to logic — only the target
//RS //! value type changes from `jet_std::DataTree` to the canonical `DataTree`
//RS //! `CtValue` shape `JSONInterp.rs` established for `core.encoding.json`):
//RS //!
//RS //! - csv: `jet_ring_csv_parse`/`jet_ring_csv_render`,
//RS //!   `crates/jet-codegen/src/Prelude/CoreLib/Top/RingCsvLogTimeCrypto.rs`.
//RS //! - toml: `pub mod toml` (`parse_to_tree`/`render`),
//RS //!   `crates/jet-codegen/src/Prelude/CoreLib/JetStd/TOML.rs`.
//RS //! - yaml: `pub mod yaml` (`parse_to_tree`/`render`),
//RS //!   `crates/jet-codegen/src/Prelude/CoreLib/JetStd/YAML.rs`.
//RS //! - xml/cbor: `jet_std_xml_parse`/`jet_std_xml_render`/`jet_std_cbor_encode`/
//RS //!   `jet_std_cbor_decode`, `crates/jet-codegen/src/Prelude/CoreLib/Top/EncodingCodecs.rs`.
//RS //! - jsonl: `jet_std_jsonl_parse`/`jet_std_jsonl_render`,
//RS //!   `crates/jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs`.
//RS //! - json canonical/events: `jet_std_json_render_canonical`/`jet_std_json_events`,
//RS //!   same file.
//RS //!
//RS //! sema (`fixed_sigs.rs`) types `core.encoding.{toml,yaml,xml,cbor}`'s
//RS //! parsed value as the same `DataTree` type as `core.encoding.json` — AOT
//RS //! backs every one of these with the single `jet_std::DataTree`. Comptime
//RS //! mirrors that with the same canonical `CtValue::Enum` (`JSONInterp::json_variant`/
//RS //! `json_payload`) every accessor method (`.field`/`.at`/...) already reads,
//RS //! so no new value machinery is needed — just new parse/render walkers that
//RS //! build/consume that shape.
//RS //! parity: guard tests/encoding_parity.rs::whole_value_codecs_match_aot_comptime_and_default_dev
//RS 
//RS use std::collections::{BTreeMap, HashMap};
//RS 
//RS use crate::AST::{CtFloat, CtKey, CtReport, CtValue, StructDef, Type};
//RS 
//RS use super::JSONInterp::{json_payload, json_variant};
