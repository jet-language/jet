}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:297
fn toml_value_to_json(v: TOMLValue) -> CtValue {
    v == {
        String(s) | Datetime(s) -> json_variant("Text", Val(CtValue.Str(s)))
        Integer(n) -> json_variant("Int", Val(CtValue.Int(n)))
        Float(v) -> json_variant("Float", Val(CtValue.Float(CtFloat.f64(v))))
        Boolean(b) -> json_variant("Bool", Val(CtValue.Bool(b)))
        Array(xs) -> json_array(xs.into_iter().map(toml_value_to_json).collect())
        InlineTable(es) -> json_object(es.into_iter().map(fn(e) { (e.0, toml_value_to_json(e.1)) }).collect())
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:315
pub fn toml_render(v: &CtValue) -> String { out := ""; toml_render_table(v, &[], &out); t := out.trim_end(); t.to_string() }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:321
fn toml_is_table(v: &CtValue) -> Bool { json_object_entries(v).is_some() }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:324
fn toml_is_array_of_tables(v: &CtValue) -> Bool { json_array_items(v) == { Val(arr) -> !arr.is_empty() && arr.iter().all(toml_is_table); None -> false } }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:330
fn toml_render_table(t: &CtValue, path: &[String], out: &String) {
    entries := json_object_entries(t) == { Val(e) -> e; None -> { return } }
    for (k, v) in &entries { if !toml_is_table(v) && !toml_is_array_of_tables(v) { out.push_str("{k} = {toml_render_value(v)}\n") } }
    for (k, v) in &entries {
        if toml_is_table(v) { p := path.to_vec(); p.push(k.clone()); out.push_str("\n[{p.join(".")}]\n"); toml_render_table(v, &p, out) }
        else if toml_is_array_of_tables(v) {
            p := path.to_vec(); p.push(k.clone())
            if json_array_items(v) == Val(arr) { for elem in &arr { out.push_str("\n[[{p.join(".")}]]\n"); toml_render_table(elem, &p, out) } }
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:357
fn toml_render_value(v: &CtValue) -> String {
    if json_payload(v, "Null").is_some() || v == CtValue.Unit { return "\"\"" }
    v == {
        Enum { variant, args, .. } -> (variant, args.first()) == {
            ("Null", _) -> "\"\""; ("Bool", Val((_, Bool(b)))) -> b.to_string(); ("Int", Val((_, Int(n)))) -> n.to_string()
            ("Float", Val((_, Float(f)))) -> "{f:?}"; ("Text", Val((_, Str(s)))) -> quote_json_local(s)
            ("Array", Val((_, List(items)))) -> { parts: [String] := items.iter().map(toml_render_value).collect(); "[{parts.join(", ")}]" }
            ("Object", _) -> {
                entries := json_object_entries(v) == { Val(e) -> e; None -> { return "\"\"" } }
                parts: [String] := entries.iter().map(fn(e) { "{e.0} = {toml_render_value(e.1)}" }).collect()
                "{{ {parts.join(", ")} }}"
            }
            _ -> "\"\""
        }
        _ -> "\"\""
    }
}
