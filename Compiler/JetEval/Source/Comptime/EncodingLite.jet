}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:210
fn toml_set_key(root: &CtValue, current: &[String], key_path: &[String], value: CtValue) {
    full := current.to_vec(); full.extend_from_slice(&key_path[..key_path.len() - 1])
    fk := key_path[key_path.len() - 1].clone(); *root = toml_set_at_path(root, &full, &fk, value)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:221
fn toml_set_at_path(root: &CtValue, path: &[String], field: String, value: CtValue) -> CtValue {
    if path.is_empty() {
        entries := json_object_entries(root).unwrap_or_default()
        entries.iter_mut().find(fn(e) { e.0 == field }) == { Val(slot) -> slot.1 = value; None -> entries.push((field.to_string(), value)) }
        return json_object(entries)
    }
    (seg, rest) := (path[0].clone(), &path[1..]); entries := json_object_entries(root).unwrap_or_default()
    entries.iter().position(fn(e) { e.0 == seg }) == {
        Val(idx) -> {
            is_arr := json_array_items(&entries[idx].1).is_some()
            if is_arr {
                items := json_array_items(&entries[idx].1).unwrap(); last_idx := items.len().saturating_sub(1)
                if items.get(last_idx).cloned() == Val(last) { items[last_idx] = toml_set_at_path(&last, rest, field, value) }
                entries[idx].1 = json_array(items)
