    }
    if s.starts_with('\'') && s.ends_with('\'') && s.len() >= 2 { return json_variant("Text", Val(CtValue.Str(s[1..s.len() - 1].replace("''", "'")))) }
    s == {
        "null" | "Null" | "NULL" | "~" -> { return json_variant("Null", None) }
        "true" | "True" | "TRUE" -> { return json_variant("Bool", Val(CtValue.Bool(true))) }
        "false" | "False" | "FALSE" -> { return json_variant("Bool", Val(CtValue.Bool(false))) }
        ".inf" | ".Inf" | ".INF" -> { return json_variant("Float", Val(CtValue.Float(CtFloat.f64(F64.INFINITY)))) }
        "-.inf" | "-.Inf" -> { return json_variant("Float", Val(CtValue.Float(CtFloat.f64(F64.NEG_INFINITY)))) }
        ".nan" | ".NaN" | ".NAN" -> { return json_variant("Float", Val(CtValue.Float(CtFloat.f64(F64.NAN)))) }
        _ -> ()
    }
    if CtBigInt.from_str(s) == Ok(n) { return json_variant("Int", Val(exact_int_value(n))) }
    if (s.contains('.') || s.contains('e') || s.contains('E')) && s.chars().all(fn(c) { c.is_ascii_digit() || c == { '.' | 'e' | 'E' | '+' | '-' -> true; _ -> false } }) {
        if s.parse<F64>() == Ok(f) { return json_variant("Float", Val(CtValue.Float(CtFloat.f64(f)))) }
    }
