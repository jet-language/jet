}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:182
fn toml_table_at(root: &CtValue, path: &[String]) { *root = toml_ensure_table(root, path) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:185
fn toml_ensure_table(node: &CtValue, path: &[String]) -> CtValue {
    (seg, rest) := path.split_first() == { Val(pair) -> pair; None -> { return node.clone() } }
    entries := json_object_entries(node).unwrap_or_default()
    entries.iter().position(fn(e) { e.0 == seg }) == {
        Val(idx) -> {
            if json_array_items(&entries[idx].1) == Val(items) {
                last_idx := items.len().saturating_sub(1)
                if items.get(last_idx).cloned() == Val(last) { items[last_idx] = toml_ensure_table(&last, rest) }
                entries[idx].1 = json_array(items)
            } else { entries[idx].1 = toml_ensure_table(&entries[idx].1, rest) }
        }
