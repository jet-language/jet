enum TOMLItem { Header { path: [String], array: Bool }, KeyVal { path: [String], value: TOMLValue } }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:87
pub fn toml_parse(raw: String) -> CtValue CtValue! {
    p := TOMLParser { chars: raw.chars().collect(), pos: 0, line: 1, current_path_len: 0 }
    items := []
    loop {
        p.skip_between_statements()
        if p.peek().is_none() { break }
        item := try { p.statement()? } catch(e) { fail encoding_error_struct("TOML", e.line as I64, e.message) }
        if item == Val(item) {
            if item == Header { path, .. } { p.current_path_len = path.len() }
            items.push(item)
        }
    }
    toml_assemble(items)
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:116
fn json_object(entries: [(String, CtValue)]) -> CtValue {
    // Insertion order matches DataTree.Object, not sorted TOML keys.
    json_variant("Object", Val(CtValue.Struct { type_name: "JSONObject", fields: entries }))
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:125
fn json_array(items: [CtValue]) -> CtValue { json_variant("Array", Val(CtValue.List(items))) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:128
fn json_object_entries(v: &CtValue) -> [(String, CtValue)]? {
    json_payload(v, "Object") == {
        Val(Struct { fields, .. }) -> Val(fields.clone())
        Val(Map(m)) -> {
            // GATE #4499: retain exact CtKey ordering in the legacy map projection.
            keys := m.keys().cloned().collect(); keys.sort()
            Val(keys.iter().map(fn(k) { (k == { Str(s) -> s.clone(); other -> "{other:?}" }, m[k].clone()) }).collect())
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:147
fn json_array_items(v: &CtValue) -> [CtValue]? { json_payload(v, "Array") == { Val(List(xs)) -> Val(xs.clone()); _ -> None } }
