fn yaml_render_seq(items: &[CtValue], indent: USize, out: &String) {
    pad := " ".repeat(indent)
    for item in items {
        is_nonempty_obj := json_object_entries(item).map_or(false, fn(e) { !e.is_empty() }); is_nonempty_arr := json_array_items(item).map_or(false, fn(a) { !a.is_empty() })
        if is_nonempty_obj { out.push_str("{pad}-\n"); yaml_render_node(item, indent + 2, out) }
        else if is_nonempty_arr { out.push_str("{pad}-\n"); yaml_render_seq(&json_array_items(item).unwrap(), indent + 2, out) }
        else { out.push_str("{pad}- {yaml_render_scalar(item)}\n") }
    }
}
