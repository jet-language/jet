}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:255
fn toml_push_array_table(root: &CtValue, path: &[String]) {
    (parent_path, last) := path.split_at(path.len() - 1); *root = toml_push_array_at(root, parent_path, &last[0])
}
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:260
fn toml_push_array_at(root: &CtValue, path: &[String], field: String) -> CtValue {
    if path.is_empty() {
        entries := json_object_entries(root).unwrap_or_default()
        entries.iter().position(fn(e) { e.0 == field }) == {
            Val(idx) -> { items := json_array_items(&entries[idx].1).unwrap_or_default(); items.push(json_object([])); entries[idx].1 = json_array(items) }
            None -> entries.push((field.to_string(), json_array([json_object([])])))
        }
        return json_object(entries)
    }
    (seg, rest) := (path[0].clone(), &path[1..]); entries := json_object_entries(root).unwrap_or_default()
    entries.iter().position(fn(e) { e.0 == seg }) == {
        Val(idx) -> {
            is_arr := json_array_items(&entries[idx].1).is_some()
            if is_arr {
                items := json_array_items(&entries[idx].1).unwrap(); last_idx := items.len().saturating_sub(1)
                if items.get(last_idx).cloned() == Val(last) { items[last_idx] = toml_push_array_at(&last, rest, field) }
                entries[idx].1 = json_array(items)
            } else { entries[idx].1 = toml_push_array_at(&entries[idx].1, rest, field) }
        }
