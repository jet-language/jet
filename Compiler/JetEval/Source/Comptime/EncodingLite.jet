fn toml_assemble(items: [TOMLItem]) -> CtValue {
    root := json_object([]); current: [String] := []
    for item in items { item == {
        Header { path, array } -> { if array { toml_push_array_table(&root, &path) } else { toml_table_at(&root, &path) }; current = path }
        KeyVal { path, value } -> toml_set_key(&root, &current, &path, toml_value_to_json(value))
    } }
