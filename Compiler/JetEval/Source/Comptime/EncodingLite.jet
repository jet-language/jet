fn yaml_render_node(t: &CtValue, indent: USize, out: &String) {
    pad := " ".repeat(indent)
    if json_object_entries(t) == Val(entries) {
        if entries.is_empty() { out.push_str("{pad}{{}}\n"); return }
        for (k, v) in &entries {
            is_nonempty_obj := json_object_entries(v).map_or(false, fn(e) { !e.is_empty() }); is_nonempty_arr := json_array_items(v).map_or(false, fn(a) { !a.is_empty() })
            if is_nonempty_obj { out.push_str("{pad}{yaml_render_key(k)}:\n"); yaml_render_node(v, indent + 2, out) }
            else if is_nonempty_arr { out.push_str("{pad}{yaml_render_key(k)}:\n"); yaml_render_seq(&json_array_items(v).unwrap(), indent, out) }
            else { out.push_str("{pad}{yaml_render_key(k)}: {yaml_render_scalar(v)}\n") }
        }; return
    }
    if json_array_items(t) == Val(items) { yaml_render_seq(&items, indent, out); return }
    out.push_str("{pad}{yaml_render_scalar(t)}\n")
}
