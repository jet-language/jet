// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:62
fn encoding_error_struct(format: String, line: I64, message: String) -> CtValue { encoding_error_value_at(format, "Syntax", line, 1, message) }
// Rust: crates/jet-comptime/src/Comptime/EncodingLite.rs:71
enum TOMLValue { String(String), Integer(I64), Float(F64), Boolean(Bool), Datetime(String), Array([TOMLValue]), InlineTable([(String, TOMLValue)]) }
