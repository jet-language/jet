pub fn yaml_parse(raw: String) -> CtValue CtValue! {
    line_count := raw.as_bytes().iter().filter(fn(b) { b == 10 }).count().checked_add(1)
    if raw.len() > MAX_YAML_BYTES || !line_count.is_some_and(fn(n) { n <= MAX_YAML_NODES }) { fail encoding_error_struct("YAML", 1, "YAML input exceeds its byte or line budget") }
    lines: [String] := raw.split('\n').map(fn(l) { t := l.trim_end_matches('\r'); t.to_string() }).collect()
    p := YAMLParser { lines, pos: 0, anchors: [:], budget: YamlBudget { nodes: 0, bytes: 0 } }
    p.skip_ignorable(); while p.at_doc_marker() { p.pos = p.pos.saturating_add(1); p.skip_ignorable() }
    if p.pos >= p.lines.len() || p.at_doc_end() {
        line := p.pos.saturating_add(1) as I64
        return try { p.null()? } catch(_) { fail encoding_error_struct("YAML", line, "YAML value exceeds its node or byte budget") }
    }
    base := p.indent(p.pos)
    value := try { p.parse_node(base, 0)? } catch(e) { fail encoding_error_struct("YAML", e.line as I64, e.message) }
    p.skip_ignorable()
    if p.pos < p.lines.len() && !p.at_doc_marker() && !p.at_doc_end() { fail encoding_error_struct("YAML", p.pos.saturating_add(1) as I64, YAML_EXPECTED_KEY_VALUE.to_string()) }
    value
}
