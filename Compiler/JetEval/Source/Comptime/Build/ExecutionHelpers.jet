use jet_comptime.Comptime.Build.ActionsPolicy.[ActionCache, BuildAction, BuildResourcePool, BuildResourcePoolSpec]
use jet_comptime.Comptime.Build.CacheCas.[ActionCacheStatus, CacheHitReason, CacheMissReason]
use jet_comptime.Comptime.Build.ErrorsKeys.[action_cycle_error, target_cycle_error, BuildError]
use jet_comptime.Comptime.Build.Handles.[ActionId, TargetId]
use jet_comptime.Comptime.Build.PlanGraph.[BuildExecutionMetrics, BuildExecutionStage, BuildPlan]
use std.collections.BTreeSet

// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:8
fn default_resource_pools() -> [BuildResourcePoolSpec] {
    [BuildResourcePoolSpec.new(BuildResourcePool.CPU, 0),
     BuildResourcePoolSpec.new(BuildResourcePool.Memory, 0),
     BuildResourcePoolSpec.new(BuildResourcePool.Linker, 1),
     BuildResourcePoolSpec.new(BuildResourcePool.Console, 1),
     BuildResourcePoolSpec.new(BuildResourcePool.GPU, 1)]
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:18
fn action_pools(action: &BuildAction) -> [BuildResourcePool] {
    if action.resource_pools.is_empty() { [BuildResourcePool.CPU] }
    else { action.resource_pools.iter().cloned().collect() }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:26
fn cache_status_reason(status: ActionCacheStatus) -> String {
    status == {
        Hit(LocalActionRecordMatched) -> "local action record matched"
        Hit(DeclaredOutputsRestored) -> "declared outputs restored"
        Miss(NoLocalActionRecord) -> "no local action record"
        Miss(ActionKeyChanged) -> "action key changed"
        Miss(DeclaredOutputMissing) -> "declared output missing"
        Miss(CacheRecordInvalid) -> "local cache record or blob is invalid"
        Miss(CacheRestoreFailed) -> "local cache output could not be restored"
        Miss(RemoteDenied) -> "remote cache denied by policy"
        Miss(UncachedAction) -> "action is uncached"
        Miss(FrontEndIncomplete) -> "cache lookup blocked until parser, sema, policy, and diagnostics complete"
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:53
// GATE #4499: action-handle map/set keys use canonical equality and ordering.
fn execution_stages(plan: &BuildPlan, prereqs: &[ActionId:[ActionId]]) -> [BuildExecutionStage] BuildError! {
    remaining := BTreeSet<ActionId>.new()
    indegree: [ActionId:USize] = [:]
    dependents: [ActionId:[ActionId]] = [:]
    for (action, dependencies) in prereqs {
        _ :: remaining.insert(action)
        indegree.insert(action, dependencies.len())
        for dependency in dependencies {
            dependents.entry(dependency).or_default().push(action)
        }
    }
    for actions in dependents.values_mut() { actions.sort() }
    ready := BTreeSet<ActionId>.new()
    for (action, count) in &indegree { if count == 0 { _ :: ready.insert(action) } }
    stages: [BuildExecutionStage] = []
    while !ready.is_empty() {
        current := ready.into_iter().collect::<[ActionId]>()
        for action in &current { _ :: remaining.remove(action) }
        next_ready := BTreeSet<ActionId>.new()
        for action in &current {
            if followers := dependents.get(action) {
                for dependent in followers {
                    count := indegree.get_mut(dependent).expect("dependency graph node must have an indegree")
                    count.* -= 1
                    if count.* == 0 { _ :: next_ready.insert(dependent) }
                }
            }
        }
        stages.push(BuildExecutionStage { index: stages.len(), actions: ^current })
        ready = ^next_ready
    }
    if !remaining.is_empty() { fail action_cycle_error(plan, &remaining, prereqs) }
    stages
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:105
fn execution_metrics(actions: &[BuildAction], stages: &[BuildExecutionStage]) -> BuildExecutionMetrics {
    metrics := BuildExecutionMetrics.default()
    metrics.actions_total = actions.len()
    metrics.parallel_stages = stages.len()
    metrics.max_parallel_actions = stages.iter().map(fn(stage) { stage.actions.len() }).max().unwrap_or(0)
    metrics.cacheable_actions = actions.iter().filter(fn(action) { action.cache == ActionCache.Cached }).count()
    metrics.phony_actions = actions.iter().filter(fn(action) { action.cache == ActionCache.UncachedPhony }).count()
    metrics
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_helpers.rs:129
fn collect_target_actions(plan: &BuildPlan, target: TargetId, visiting: &[TargetId], out: &BTreeSet<ActionId>) -> Unit BuildError! {
    if visiting.contains(&target) { fail target_cycle_error(plan, visiting, target) }
    visiting.push(target)
    target_ref := plan.targets.get(target.0) == { Val(t) -> t; None -> { fail BuildError.UnknownTarget(target) } }
    for dep in &target_ref.deps { collect_target_actions(plan, dep.id, visiting, out)? }
    out.extend(target_ref.actions.iter().map(fn(action) { action.id }))
    _ :: visiting.pop()
}
