}
impl RemoteSandboxProof {
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:402
    pub fn new(sandbox_id: String, action_key: String, provenance_digest: ContentDigest) -> RemoteSandboxProof Never! {
        RemoteSandboxProof(sandbox_id: ^sandbox_id, attempt_id: "", action_key: ^action_key, provenance_digest: ^provenance_digest, sandbox_class: "remote", worker_id: "", platform: "", abi: "", worker_receipt: "")
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:420
    fn with_worker_identity(self: RemoteSandboxProof, worker_id: String, platform: String, abi: String, worker_receipt: String) -> RemoteSandboxProof Never! {
        result := ^self
        result.worker_id = ^worker_id; result.platform = ^platform; result.abi = ^abi; result.worker_receipt = ^worker_receipt
        ^result
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:434
    fn with_attempt_id(self: RemoteSandboxProof, attempt_id: String) -> RemoteSandboxProof Never! { result := ^self; result.attempt_id = ^attempt_id; ^result }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:439
    fn with_sandbox_class(self: RemoteSandboxProof, sandbox_class: String) -> RemoteSandboxProof Never! { result := ^self; result.sandbox_class = ^sandbox_class; ^result }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:444
    fn is_complete(self: &RemoteSandboxProof) -> Bool Never! {
        !self.sandbox_id.is_empty() && self.sandbox_id.len() <= 512 && !self.sandbox_id.chars().any(fn(ch) { ch.is_control() })
        && !self.action_key.is_empty() && self.action_key.len() <= 4096 && !self.action_key.chars().any(fn(ch) { ch.is_control() })
        && ContentDigest.parse(self.provenance_digest.as_str()).is_ok()
        && !self.sandbox_class.is_empty() && self.sandbox_class.len() <= 256 && !self.sandbox_class.chars().any(fn(ch) { ch.is_control() })
        && ((self.worker_id.is_empty() && self.platform.is_empty() && self.abi.is_empty() && self.worker_receipt.is_empty())
            || (!self.worker_id.is_empty() && !self.platform.is_empty() && !self.abi.is_empty() && !self.worker_receipt.is_empty() && !self.attempt_id.is_empty()
                && self.worker_id.len() <= 256 && self.platform.len() <= 256 && self.abi.len() <= 256 && self.worker_receipt.len() <= 256 && self.attempt_id.len() <= 256
                && !self.worker_id.chars().any(fn(ch) { ch.is_control() }) && !self.platform.chars().any(fn(ch) { ch.is_control() })
                && !self.abi.chars().any(fn(ch) { ch.is_control() }) && !self.worker_receipt.chars().any(fn(ch) { ch.is_control() }) && !self.attempt_id.chars().any(fn(ch) { ch.is_control() })))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:480
pub fn remote_policy_digest<I: IntoIterator<BuildCapability>>(capabilities: I) -> ContentDigest Never! {
    // GATE #4499: canonical capability ordering and deduplication, not names alone.
    unique :: capabilities.into_iter().collect<Set<BuildCapability>>()
    ordered := unique.iter().collect()
    ordered.sort()
    bytes := b"jet.remote-policy.v1\n".to_vec()
    for capability in &ordered { bytes.extend_from_slice(capability.name().as_bytes()); bytes.push(b'\n') }
    ContentDigest.from_bytes(&bytes)
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:497
pub enum RemoteCachePolicy {
    DisabledUntilGrantAndSandboxProof
    Granted { cache_read: Bool, cache_write: Bool, execute: Bool, proof: RemoteSandboxProof }
}
impl RemoteCachePolicy {
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:508
    pub fn disabled_until_grant_and_sandbox_proof() -> RemoteCachePolicy Never! { RemoteCachePolicy.DisabledUntilGrantAndSandboxProof }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:512
    pub fn granted(proof: RemoteSandboxProof) -> RemoteCachePolicy Never! { RemoteCachePolicy.Granted(cache_read: true, cache_write: true, execute: true, proof: ^proof) }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:521
    pub fn with_grants(cache_read: Bool, cache_write: Bool, execute: Bool, proof: RemoteSandboxProof) -> RemoteCachePolicy Never! { RemoteCachePolicy.Granted(cache_read: cache_read, cache_write: cache_write, execute: execute, proof: ^proof) }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:535
    pub fn proof(self: &RemoteCachePolicy) -> &RemoteSandboxProof? Never! { if self == { .DisabledUntilGrantAndSandboxProof -> None; .Granted { proof, .. } -> Val(&proof) } }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:542
    pub fn check(self: &RemoteCachePolicy, request: RemoteActionRequest) -> Unit RemoteCacheDenied! {
        if self == {
            .DisabledUntilGrantAndSandboxProof -> Err(RemoteCacheDenied(request: request, reason: RemoteDeniedReason.MissingGrantAndSandboxProof))
            .Granted { cache_read, cache_write, execute, proof } -> {
                allowed :: if request == { .CacheRead -> cache_read; .CacheWrite -> cache_write; .Execute -> execute }
                if !proof.is_complete() -> return Err(RemoteCacheDenied(request: request, reason: RemoteDeniedReason.MissingGrantAndSandboxProof))
                if !allowed -> return Err(RemoteCacheDenied(request: request, reason: RemoteDeniedReason.GrantNotAllowed))
                return ()
            }
        }
    }
}
