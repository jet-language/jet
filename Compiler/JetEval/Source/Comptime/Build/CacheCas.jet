        if !allowed.contains(field) || fields.insert(field.to_string(), value.to_string()).is_some() -> return Err("remote binding record has an unknown or duplicate field")
        if value.is_empty() || value.chars().any(fn(ch) { ch.is_control() }) -> return Err("remote binding field `{field}` is empty or contains control text")
    }
    if fields.get("version").map(fn(value) { value.as_str() }) != Val("1") || fields.get("builder").map(fn(value) { value.as_str() }) != Val(expected_builder) -> return Err("remote binding record version or builder does not match")
