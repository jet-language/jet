    pub fn bind_host(builder: String, root: OSPath, credential_provider: OSPath, trust_domain: String, worker_id: String, platform: String, abi: String, cache_read: Bool, cache_write: Bool, execute: Bool, fallback_local: Bool, timeout_ms: U64) -> RemoteBuildBinding Err! {
