        self.validate_policy_identity(policy)?
        self.read_remote_blob(digest)
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1528
    pub fn upload_action_record(self: &RemoteCacheTransport, record: &ActionResultRecord, policy: &RemoteCachePolicy) -> Unit RemoteCacheError! {
        policy.check(RemoteActionRequest.CacheWrite).map_err(fn(error) { RemoteCacheError.Denied(^error) })?
        self.require_auth(RemoteActionRequest.CacheWrite)?
        self.require_worker_identity()?
        self.validate_policy_identity(policy)?
        self.validate_proof_for_key(policy, &record.key, RemoteActionRequest.CacheWrite)?
        validate_action_result_record(record)?
        validate_action_key(&record.key)?
        validate_remote_count(record.outputs.len(), "cache outputs")?
        for output in &record.outputs { ContentDigest.parse(output.digest.as_str())?; validate_remote_path(output.path.as_str())? }
        validate_unique_remote_paths(record.outputs.iter().map(fn(output) { output.path.as_str() }))?
        // Every declared blob must be authenticated before the record is publishable.
        for output in &record.outputs -> self.read_remote_blob_with_len(&output.digest, output.byte_len)?
        path :: self.record_path(&record.key)?
        record_text :: encode_remote_record(record)
        bytes :: self.seal("cache-record", record_text.as_bytes())?
        ensure_remote_root(&self.root_path)?
        atomic_restore_file(&self.root_path, &path, &bytes)?
        return ()
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1561
    pub fn download_action_record(self: &RemoteCacheTransport, key: &ActionKey, policy: &RemoteCachePolicy) -> ActionResultRecord RemoteCacheError! {
        policy.check(RemoteActionRequest.CacheRead).map_err(fn(error) { RemoteCacheError.Denied(^error) })?
        self.require_auth(RemoteActionRequest.CacheRead)?
        self.validate_policy_identity(policy)?
        self.validate_proof_for_key(policy, key, RemoteActionRequest.CacheRead)?
        path :: self.record_path(key)?
        bytes :: secure_read_file_bounded(&self.root_path, &path, MAX_REMOTE_WIRE_BYTES + 256)?
        payload :: self.open("cache-record", &bytes)?
        record :: decode_remote_record(&payload)?
        if record.key != key -> return Err(RemoteCacheError.InvalidRecord("record key does not match lookup key"))
        validate_action_key(&record.key)?
        validate_remote_count(record.outputs.len(), "cache outputs")?
        for output in &record.outputs {
            validate_remote_path(output.path.as_str())?
            ContentDigest.parse(output.digest.as_str())?
            self.read_remote_blob_with_len(&output.digest, output.byte_len)?
        }
        validate_unique_remote_paths(record.outputs.iter().map(fn(output) { output.path.as_str() }))?
        return ^record
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1591
    fn validate_proof_for_key(self: &RemoteCacheTransport, policy: &RemoteCachePolicy, key: &ActionKey, request: RemoteActionRequest) -> Unit RemoteCacheError! {
        if policy.proof() == {
            .Val(proof) -> { if proof.action_key != key.as_str() -> return Err(RemoteCacheError.Denied(RemoteCacheDenied(request: request, reason: RemoteDeniedReason.ProofDoesNotMatchAction))) }
            .None -> {}
        }
        return ()
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1608
    fn validate_sandbox_proof(self: &RemoteCacheTransport, policy: &RemoteCachePolicy, sandbox: &RemoteSandboxProof, request: RemoteActionRequest) -> Unit RemoteCacheError! {
        if policy.proof() == {
            .Val(expected) -> { if expected != sandbox -> return Err(RemoteCacheError.Denied(RemoteCacheDenied(request: request, reason: RemoteDeniedReason.ProofDoesNotMatchAction))) }
            .None -> {}
        }
        return ()
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1625
    fn record_path(self: &RemoteCacheTransport, key: &ActionKey) -> OSPath RemoteCacheError! {
        digest :: ContentDigest.from_bytes(key.as_str().as_bytes())
        valid :: ContentDigest.parse(digest.as_str())?
        hex := valid.as_str().strip_prefix("sha256:").ok_or_else(fn() { RemoteCacheError.InvalidRecord("action key digest has no sha256 prefix") })?
        self.root_path.join("records").join(&hex[..2]).join(&hex[2..])
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1637
    pub fn submit_execution(self: &RemoteCacheTransport, request: &RemoteExecutionRequest, policy: &RemoteCachePolicy) -> Unit RemoteCacheError! {
        policy.check(RemoteActionRequest.Execute).map_err(fn(error) { RemoteCacheError.Denied(^error) })?
        self.require_auth(RemoteActionRequest.Execute)?
        self.require_worker_identity()?
        self.validate_policy_identity(policy)?
        self.validate_proof_for_key(policy, &request.key, RemoteActionRequest.Execute)?
        self.validate_sandbox_proof(policy, &request.sandbox, RemoteActionRequest.Execute)?
        if self.worker_identity.as_ref() == { .Val(expected) -> self.validate_worker_identity(&request.sandbox, expected)?; .None -> {} }
        validate_remote_execution_request(request)?
        for input in &request.inputs -> self.read_remote_blob_with_len(&input.digest, input.byte_len)?
        ensure_remote_root(&self.root_path)?
        _commit :: remote_execution_commit_lock(&self.root_path)?
        result_path :: self.execution_result_path(&request.key)?
        if secure_read_file_bounded(&self.root_path, &self.execution_request_path(&request.key)?, MAX_REMOTE_WIRE_BYTES + 256) == {
            .Ok(bytes) -> {
                payload :: self.open("execution-request", &bytes)?
                current :: decode_remote_execution_request(&payload)?
                if current.attempt_id == request.attempt_id -> return Err(RemoteCacheError.InvalidRecord("remote execution attempt id was already submitted"))
            }
            .Err(error) -> { if error.kind() != io.ErrorKind.NotFound -> return Err(RemoteCacheError.Io(^error)) }
        }
        cancellation :: self.execution_cancel_state(&request.key)?
        if cancellation.retired || cancellation.attempts.len() >= MAX_REMOTE_CANCELLED_ATTEMPTS -> return Err(RemoteCacheError.InvalidRecord("remote action was retired after cancellation history reached its limit"))
        if cancellation.attempts.iter().any(fn(attempt_id) { attempt_id == request.attempt_id }) -> return Err(RemoteCacheError.InvalidRecord("remote execution attempt id was already cancelled"))
        if fs.symlink_metadata(&result_path) == {
            .Ok(metadata) -> {
                if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(RemoteCacheError.Io(io.Error.new(io.ErrorKind.PermissionDenied, "remote execution result is not a regular file")))
                fs.remove_file(&result_path)?
            }
            .Err(_) -> {}
        }
        path :: self.execution_request_path(&request.key)?
        request_text :: encode_remote_execution_request(request)
        bytes :: self.seal("execution-request", request_text.as_bytes())?
        atomic_restore_file(&self.root_path, &path, &bytes)?
        return ()
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1715
    pub fn cancel_execution(self: &RemoteCacheTransport, key: &ActionKey, policy: &RemoteCachePolicy) -> Unit RemoteCacheError! {
        policy.check(RemoteActionRequest.Execute).map_err(fn(error) { RemoteCacheError.Denied(^error) })?
        self.require_auth(RemoteActionRequest.Execute)?
        self.require_worker_identity()?
        self.validate_policy_identity(policy)?
        self.validate_proof_for_key(policy, key, RemoteActionRequest.Execute)?
        attempt_id :: policy.proof().map(fn(proof) { proof.attempt_id.as_str() }).ok_or_else(fn() { RemoteCacheError.InvalidRecord("remote execution cancellation requires an attempt-bound proof") })?
        validate_remote_attempt_id(attempt_id)?
        ensure_remote_root(&self.root_path)?
        _commit :: remote_execution_commit_lock(&self.root_path)?
        request :: self.read_execution_request(key)?
        if request.attempt_id != attempt_id -> return Err(RemoteCacheError.InvalidRecord("remote execution cancellation belongs to a stale attempt"))
        self.validate_sandbox_proof(policy, &request.sandbox, RemoteActionRequest.Execute)?
        marker :: self.execution_cancel_path(key)?
        cancellation :: self.execution_cancel_state(key)?
        if cancellation.retired -> return Err(RemoteCacheError.InvalidRecord("remote action was retired after cancellation history reached its limit"))
        if cancellation.attempts.iter().any(fn(cancelled) { cancelled == attempt_id }) -> return Err(RemoteCacheError.InvalidRecord("remote execution attempt id was already cancelled"))
        payload := "key={hex_encode(key.as_str().as_bytes())}\n"
        if cancellation.attempts.len().saturating_add(1) >= MAX_REMOTE_CANCELLED_ATTEMPTS -> payload.push_str("retired=1\n")
        else {
            for cancelled in &cancellation.attempts { payload.push_str("attempt="); payload.push_str(&hex_encode(cancelled.as_bytes())); payload.push('\n') }
            payload.push_str("attempt="); payload.push_str(&hex_encode(attempt_id.as_bytes())); payload.push('\n')
        }
        bytes :: self.seal("execution-cancel", payload.as_bytes())?
        atomic_restore_file(&self.root_path, &marker, &bytes)?
        remove_remote_execution_file(&self.execution_result_path(key)?)?
        remove_remote_execution_file(&self.execution_request_path(key)?)?
        return ()
    }
