// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:29
struct RemoteExecutionCommitLock { file: fs.File, path: OSPath? }
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:35
fn remote_execution_commit_lock(root: &OSPath) -> RemoteExecutionCommitLock RemoteCacheError! {
    ensure_remote_root(root)?
    path :: root.join("execution.commit.lock")
    // GATE #4483: selected-target dispatch, never host cfg.
    if core.sys.target.selected_family() == "unix" {
        os :: core.sys.target.selected_os()
        options := fs.OpenOptions.new()
        options.read(true).write(true).create(true)
        if ["linux", "android", "macos", "ios", "freebsd", "dragonfly", "openbsd", "netbsd"].contains(os) {
            O_NOFOLLOW :: if os == "linux" || os == "android" -> 0o400000 else -> 0x00000100
            options.custom_flags(O_NOFOLLOW)
        }
        file :: options.open(&path)?
        if !file.metadata()?.is_file() -> return Err(RemoteCacheError.Io(io.Error.new(io.ErrorKind.PermissionDenied, "remote execution lock is not a regular file")))
        // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:61
        // GATE #4494: native flock holds the live descriptor until the guard drops.
        #Unsafe("flock receives the descriptor owned by this live lock file") {
            if core.sys.host.unix_fd.flock(file.as_raw_fd(), 2) != 0 -> return Err(RemoteCacheError.Io(io.Error.last_os_error()))
        }
        return RemoteExecutionCommitLock(file: ^file, path: None)
    }
    file :: fs.OpenOptions.new().write(true).create_new(true).open(&path).map_err(fn(error) { RemoteCacheError.Io(^error) })?
    return RemoteExecutionCommitLock(file: ^file, path: Val(^path))
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:103
impl Drop for RemoteExecutionCommitLock {
    fn drop(self: &RemoteExecutionCommitLock) -> Unit Never! {
        if core.sys.target.selected_family() != "unix" {
            if self.path == { .Val(path) -> { _ :: fs.remove_file(&path) }; .None -> {} }
        }
    }
}
