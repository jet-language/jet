// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:262
// GATE #4494: real shared mutex serializes optional observation writes only.
COMPTIME_CACHE_OBSERVATION_LOCK :: LazyLock.new(fn() { Mutex.new(()) })
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:267
fn record_comptime_cache_event(action: String, key: &ActionKey, status: ActionCacheStatus, phase: String, outcome: ActionOutcome?) -> Unit Never! {
    native_path :: env.var_os("JET_COMPTIME_CACHE_OBSERVATION_PATH") ?? return
    path :: OSPath.from(^native_path)
    home :: env.var_os("HOME").map(fn(value) { OSPath.from(^value) }) ?? return
    allowed_root :: home.join(".cache")
    if !path.is_absolute() || !(path == allowed_root || path.starts_with(&allowed_root)) -> return
    quote :: fn(text: String) -> String Never! {
        out := String.with_capacity(text.len() + 2)
        out.push('"')
        for character in text.chars() {
            if character == {
                '"' -> out.push_str("\\\"")
                '\\' -> out.push_str("\\\\")
                '\n' -> out.push_str("\\n")
                '\r' -> out.push_str("\\r")
                '\t' -> out.push_str("\\t")
                ch -> { if ch.is_control() -> out.push_str("\\u{ch as U32:04x}") else -> out.push(ch) }
            }
        }
        out.push('"')
        out
    }
    (status_name, reason) :: if status == {
        .Hit(.LocalActionRecordMatched) -> ("hit", "local_action_record_matched")
        .Hit(.DeclaredOutputsRestored) -> ("hit", "declared_outputs_restored")
        .Miss(.NoLocalActionRecord) -> ("miss", "no_local_action_record")
        .Miss(.ActionKeyChanged) -> ("miss", "action_key_changed")
        .Miss(.DeclaredOutputMissing) -> ("miss", "declared_output_missing")
        .Miss(.CacheRecordInvalid) -> ("miss", "cache_record_invalid")
        .Miss(.CacheRestoreFailed) -> ("miss", "cache_restore_failed")
        .Miss(.RemoteDenied) -> ("miss", "remote_denied")
        .Miss(.UncachedAction) -> ("miss", "uncached_action")
        .Miss(.FrontEndIncomplete) -> ("miss", "front_end_incomplete")
    }
    outcome_text :: outcome.map(fn(value) { if value == {
        .Succeeded { exit_code } -> "succeeded:{exit_code}"
        .Failed { exit_code } -> "failed:{exit_code}"
        .RestoredFromCache -> "restored"
    } })
    mode :: env.var("JET_COMPTIME_MODE").unwrap_or_else(fn(_) { "unknown" })
    operation_id :: env.var("JET_COMPTIME_OPERATION_ID").unwrap_or_else(fn(_) { "unknown" })
    outcome_json :: outcome_text.map(quote).unwrap_or_else(fn() { "null" })
    payload :: "{{\"schema\":\"jet.comptime-cache-event.v1\",\"mode\":{quote(mode)},\"operation_id\":{quote(operation_id)},\"action\":{quote(action)},\"key\":{quote(key.as_str())},\"phase\":{quote(phase)},\"status\":{quote(status_name)},\"reason\":{quote(reason)},\"outcome\":{outcome_json}}}\n"
    _guard :: COMPTIME_CACHE_OBSERVATION_LOCK.lock().ok()
    if path.parent() == { .Val(parent) -> { _ :: fs.create_dir_all(parent) }; .None -> {} }
    if fs.OpenOptions.new().create(true).append(true).open(path) == {
        .Ok(file) -> { _ :: file.write_all(payload.as_bytes()) }
        .Err(_) -> {}
    }
}
