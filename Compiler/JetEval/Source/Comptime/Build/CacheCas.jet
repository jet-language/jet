// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:122
pub struct ContentDigest { value: String }
impl ContentDigest {
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:125
    pub fn from_bytes(bytes: &[U8]) -> ContentDigest Never! { ContentDigest(value: "sha256:{SHA256.sha256_hex(bytes)}") }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:129
    pub fn as_str(self: &ContentDigest) -> &String Never! { &self.value }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:133
    pub fn parse(value: String) -> ContentDigest io.Error! {
        hex := value.strip_prefix("sha256:") ?? return Err(io.Error.new(io.ErrorKind.InvalidData, "digest must start with `sha256:`"))
        // GATE #4409: InvalidData, not InvalidInput.
        if hex.len() != 64 || !hex.bytes().all(fn(byte) { byte.is_ascii_hexdigit() }) -> return Err(io.Error.new(io.ErrorKind.InvalidData, "sha256 digest must contain exactly 64 hexadecimal digits"))
        return ContentDigest(value: "sha256:{hex.to_ascii_lowercase()}")
    }
}
