use jet_comptime.Comptime.Build.ErrorsKeys.BuildError
use jet_comptime.Comptime.Build.Handles.[ActionHandle, PluginHandle, ProbeHandle, SigningIdentityHandle, TargetId, TargetRef, ToolchainHandle]
use std.path.Component

// Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:10
#Derive(Debug, Clone, Copy, Eq, Ord, Hash)
pub enum TargetKind { Executable, Library, Test, AssetBundle, Doc, Install, Package, Publish }
// Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:22
#Derive(Debug, Clone, Eq, Ord, Hash)
pub struct BuildPath { value: String }
impl BuildPath {
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:25
    pub fn new(path: String) -> Self BuildError! {
        trimmed := path.trim() // #4303
        if trimmed.is_empty() -> return Err(BuildError.EmptyPath)
        // GATE #4483: OSPath component grammar belongs to the selected target.
        native := OSPath.from(path)
        if native.is_absolute() || native.components().any(fn(component) { component is .ParentDir || component is .RootDir || component is .Prefix }) {
            return Err(BuildError.InvalidPath(path))
        }
        Ok(BuildPath{value: ^path})
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:43
    pub fn as_str(self: &Self) -> String { self.value }
}
// Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:49
pub struct TargetSpec {
    pub sources: [BuildPath]
    pub inputs: [BuildPath]
    pub outputs: [BuildPath]
    pub deps: [TargetRef]
    pub actions: [ActionHandle]
    pub probes: [ProbeHandle]
    pub toolchain: ToolchainHandle?
    pub signing_identity: SigningIdentityHandle?
    pub metadata: [String:String]
}
impl TargetSpec {
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:62
    pub fn new() -> Self { Self.default() }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:66
    pub fn with_source(self: Self, path: String) -> Self { self.sources.push(BuildPath{value: ^path}); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:71
    pub fn with_input(self: Self, path: String) -> Self { self.inputs.push(BuildPath{value: ^path}); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:76
    pub fn with_output(self: Self, path: String) -> Self { self.outputs.push(BuildPath{value: ^path}); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:81
    pub fn with_dep<T: Into<TargetRef>>(self: Self, target: T) -> Self { self.deps.push(target.into()); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:86
    pub fn with_action(self: Self, action: ActionHandle) -> Self { self.actions.push(action); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:91
    pub fn with_probe(self: Self, probe: ProbeHandle) -> Self { self.probes.push(probe); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:96
    pub fn with_toolchain(self: Self, toolchain: ToolchainHandle) -> Self { self.toolchain = Some(toolchain); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:101
    pub fn with_signing_identity(self: Self, identity: SigningIdentityHandle) -> Self { self.signing_identity = Some(identity); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:106
    pub fn with_metadata(self: Self, key: String, value: String) -> Self { self.metadata.insert(^key, ^value); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:113
    pub fn default() -> Self {
        TargetSpec{sources: [], inputs: [], outputs: [], deps: [], actions: [], probes: [], toolchain: None, signing_identity: None, metadata: [String:String].new()}
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/targets.rs:129
pub struct BuildTarget {
    pub id: TargetId
    pub name: String
