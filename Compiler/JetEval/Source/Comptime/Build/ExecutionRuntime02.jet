// Private continuation of canonical Comptime.Build.ExecutionRuntime.
use std.[fs, env, process, io, Output]
use jet_comptime.Comptime.Build.ProvenanceToolchains.[BuildToolchain, ToolchainRole, ToolchainResolution]
use jet_foundation.Outcome.[JetErrorReport]
// GATE #4494: native filesystem/process/atomic/descriptor operations throughout.

// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1812
fn run_probe_sandboxed(executable: OSPath, args: [String], source: (OSPath, String)?) -> Output BuildExecutionError! {
    attempt :: &REMOTE_ATTEMPT.fetch_add(1, .Relaxed)
    root :: env.temp_dir().join("jet-build-probe-{process.id()}-{attempt}")
    fs.create_dir_all(root) ?? {
        fs.remove_dir_all(root) ?? {}
        return Err(.IO{action: "build probe sandbox", detail: err.to_string()})
    }
    defer { fs.remove_dir_all(root) ?? {} }
    if source == .Val((path, contents)) {
        fs.write(root.join(path), contents) ?? return Err(.IO{action: "build probe input", detail: err.to_string()})
    }
    result :: run_native_sandboxed(executable, args, root, None, [String:String]{}, false) ?? {
        match err { .Unsupported(_) => return Err(.SandboxUnavailable); .Io(detail) => return Err(.IO{action: "build probe sandbox", detail: detail}) }
    }
    Ok(^result.output)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1851
fn run_compile_probe(plan: BuildPlan, toolchain: ToolchainHandle, source: String) -> (Bool, String) BuildExecutionError! {
    compiler := OSPath?{None}
    loop name in ["cc", "clang", "gcc"] { if resolve_program_path(plan, toolchain, name) == .Val(path) { compiler = Val(path); break } }
    path :: compiler ?? return Ok((false, "no C compiler (`cc`, `clang`, or `gcc`) was found"))
    output :: run_probe_sandboxed(path, ["-x", "c", "-fsyntax-only", "probe.c"], Val((OSPath.new("probe.c"), source)))
    if output.status.success() -> return Ok((true, "{path.display()} accepted the syntax probe"))
    stderr :: String.from_utf8_lossy(output.stderr)
    detail := stderr.trim() // #4303
    Ok((false, if detail.is_empty() -> "{path.display()} rejected the syntax probe" else -> "{path.display()}: {detail}"))
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1890
fn find_program_path(program: String) -> OSPath? Never! {
    direct :: OSPath.new(program)
    if direct.components().count() > 1 && direct.is_file() {
        path :: fs.canonicalize(direct) ?? return None
        return Val(path)
    }
    paths :: env.var_os("PATH") ?? return None
    loop directory in env.split_paths(paths) {
        candidate :: directory.join(program)
        if candidate.is_file() {
            path :: fs.canonicalize(candidate) ?? continue
            return Val(path)
        }
    }
    None
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1906
fn resolve_program_path(plan: BuildPlan, toolchain_handle: ToolchainHandle, program: String) -> OSPath? Never! {
    toolchain :: plan.toolchain(toolchain_handle) ?? return None
    if toolchain.tools.get(program) == .Val(declared) -> return canonical_tool_path(toolchain, declared)
    basename :: OSPath.new(program).file_name().and_then(|name| name.to_str())
    if basename == .Val(name) {
        if toolchain.tools.get(name) == .Val(declared) -> return canonical_tool_path(toolchain, declared)
    }
    if toolchain.resolution == .DeclaredOnly -> return None
    if OSPath.new(program).components().count() > 1 {
        if canonical_executable_path(program) == .Val(path) -> return Val(path)
    }
    // Only explicitly ambient host/native toolchains fall through to PATH.
    if toolchain.role == .Host || target_matches_running_host(toolchain.target_triple) -> find_program_path(program) else -> None
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1949
fn target_matches_running_host(triple: String) -> Bool Never! {
    // GATE #4483: selected compilation target determines the executable platform facts.
    arch :: core.sys.target.selected_arch()
    match core.sys.target.selected_os() {
        "linux" => ["{arch}-linux", "{arch}-linux-gnu", "{arch}-unknown-linux-gnu"].contains(triple)
        "macos" => ["{arch}-macos", "{arch}-apple-darwin"].contains(triple)
        "windows" => ["{arch}-windows", "{arch}-pc-windows-msvc", "{arch}-pc-windows-gnu"].contains(triple)
        _ => false
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1970
fn canonical_executable_path(program: String) -> OSPath? Never! {
    path :: OSPath.new(program)
    if !path.is_file() -> return None
    canonical :: fs.canonicalize(path) ?? return None
    Val(canonical)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1977
fn canonical_tool_path(toolchain: BuildToolchain, declared: String) -> OSPath? Never! {
    declared_path :: OSPath.new(declared)
    loop mount in toolchain.mounts {
        relative :: declared_path.strip_prefix(OSPath.new(mount.destination)) ?? continue
        if relative.components().any(|component| component == .ParentDir) -> return None
        source :: OSPath.new(mount.source).join(relative)
        return canonical_executable_path(source.to_string_lossy())
    }
    canonical_executable_path(declared)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2004
fn runtime_toolchain_arguments(plan: BuildPlan, toolchain_handle: ToolchainHandle, args: [String]) -> [String] Never! {
    // Linux projects virtual mounts; other selected OS adapters translate paths.
    if core.sys.target.selected_os() == "linux" -> return ~args
    toolchain :: plan.toolchain(toolchain_handle) ?? return ~args
    out := [String]{}
    loop argument in args -> &out.push(runtime_toolchain_argument(toolchain, argument))
    out
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2026
fn runtime_toolchain_environment(plan: BuildPlan, toolchain_handle: ToolchainHandle, environment: [String:String]) -> [String:String] Never! {
    if core.sys.target.selected_os() == "linux" -> return ~environment
    toolchain :: plan.toolchain(toolchain_handle) ?? return ~environment
    out := [String:String]{}
    keys :: environment.keys().sorted()
    loop key in keys -> out[key] = runtime_toolchain_argument(toolchain, environment[key])
    out
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2049
fn runtime_toolchain_argument(toolchain: BuildToolchain, argument: String) -> String Never! {
    if runtime_mount_path(toolchain, argument) == .Val(path) -> return path
    loop prefix in ["--sysroot=", "-isysroot=", "-I", "-L", "-include", "-isystem", "-iquote", "-idirafter", "-imacros"] {
        value :: argument.strip_prefix(prefix) ?? continue
        if runtime_mount_path(toolchain, value) == .Val(path) -> return "{prefix}{path}"
    }
    argument.to_string()
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2078
fn runtime_mount_path(toolchain: BuildToolchain, value: String) -> String? Never! {
    loop mount in toolchain.mounts {
        destination := mount.destination.trim_end_matches(|character| character == '/' || character == '\\') // #4303
        if value == destination -> return Val(mount.source.to_string())
        suffix :: value.strip_prefix(destination) ?? continue
        relative :: suffix.strip_prefix('/') ?? suffix.strip_prefix('\\') ?? continue
        path :: OSPath.new(mount.source).join(relative)
        return Val(path.to_string_lossy().to_string())
    }
    None
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2102
fn toolchain_provenance_digest(plan: BuildPlan, toolchain: ToolchainHandle) -> ContentDigest Never! {
    identity :: match plan.toolchain(toolchain) { Val(value) => "{value:?}"; None => "missing-toolchain" }
    ContentDigest.from_bytes(identity.bytes())
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2110
fn remote_provenance_digest(plan: BuildPlan, action: BuildAction) -> ContentDigest Never! {
    toolchain :: toolchain_provenance_digest(plan, action.toolchain)
    policy :: remote_policy_digest(action.caps.to_list().sorted())
    statement :: "jet.remote-provenance.v1\ntoolchain={toolchain.as_str()}\npolicy={policy.as_str()}\n"
    ContentDigest.from_bytes(statement.bytes())
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2121
fn write_action_record(artifact_store: BuildArtifactStore, key: ActionKey, record: ActionResultRecord) io.Error! {
    text := "{record.key.as_str()}\noutcome={encode_local_outcome(record.outcome)}\n"
    if record.failure_report == .Val(report) -> &text.push_str("failure={hex_encode(report.to_json().bytes())}\n")
    loop output in record.outputs -> &text.push_str("{output.path.as_str()}\t{output.digest.as_str()}\t{output.byte_len}\n")
    artifact_store.put_record(key.as_str(), text.bytes())
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2147
fn encode_local_outcome(outcome: ActionOutcome) -> String Never! {
    match outcome { .Succeeded{exit_code} => "succeeded:{exit_code}"; .Failed{exit_code} => "failed:{exit_code}"; .RestoredFromCache => "restored" }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2155
fn parse_local_outcome(value: String) -> ActionOutcome io.Error! {
    // GATE #4409: exact InvalidData kind and original validation precedence.
    if value == "restored" -> return Ok(.RestoredFromCache)
    (kind, code) :: value.split_once(':') ?? return Err(io.Error.new(.InvalidData, "action record outcome is malformed"))
    exit_code :: code.parse::<I32>() ?? return Err(io.Error.new(.InvalidData, "action record outcome exit code is not a number"))
    match kind { "succeeded" => Ok(.Succeeded{exit_code: exit_code}); "failed" => Ok(.Failed{exit_code: exit_code}); _ => Err(io.Error.new(.InvalidData, "action record outcome is unknown")) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2181
fn cache_restore_miss_reason(error: io.Error) -> CacheMissReason Never! {
    match error.kind() { .NotFound => .DeclaredOutputMissing; .InvalidData => .CacheRecordInvalid; _ => .CacheRestoreFailed }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2189
fn read_action_record(artifact_store: BuildArtifactStore, key: ActionKey) -> ActionResultRecord? io.Error! {
    bytes :: artifact_store.get_record(key.as_str()) ?? return Ok(None)
    text :: String.from_bytes(bytes) ?? return Err(io.Error.new(.InvalidData, "action record is not UTF-8"))
    lines := text.lines()
    if &lines.next() != Val(key.as_str()) -> return Err(io.Error.new(.InvalidData, "action record key does not match its cache path"))
    outcome := ActionOutcome?{None}
    failure_report := JetErrorReport?{None}
    outputs := [ActionOutputRecord]{}
    loop line in lines {
        if line.strip_prefix("outcome=") == .Val(value) {
            if outcome != None -> return Err(io.Error.new(.InvalidData, "action record has duplicate outcome"))
            outcome = Val(parse_local_outcome(value))
            continue
        }
        if line.strip_prefix("failure=") == .Val(value) {
            if failure_report != None || value.is_empty() -> return Err(io.Error.new(.InvalidData, "action record has an invalid failure report"))
            decoded :: hex_decode(value) ?? return Err(io.Error.new(.InvalidData, err.to_string()))
            report_text :: String.from_bytes(decoded) ?? return Err(io.Error.new(.InvalidData, "action failure report is not UTF-8"))
            report :: JetErrorReport.from_json(report_text) ?? return Err(io.Error.new(.InvalidData, "action failure report is invalid: {err}"))
            failure_report = Val(report)
            continue
        }
        parts := line.split('\t')
        invalid :: || io.Error.new(.InvalidData, "malformed action output record")
        path_text :: &parts.next() ?? return Err(invalid())
        path :: BuildPath.new(path_text) ?? return Err(invalid())
        digest :: ContentDigest.parse(&parts.next() ?? return Err(invalid()))
        length_text :: &parts.next() ?? return Err(invalid())
        byte_len :: length_text.parse::<U64>() ?? return Err(invalid())
        if &parts.next() != None -> return Err(invalid())
        &outputs.push(ActionOutputRecord{path: path, digest: digest, byte_len: byte_len})
    }
    final_outcome :: outcome ?? return Err(io.Error.new(.InvalidData, "action record has no outcome"))
    failed :: match final_outcome { .Failed{..} => true; _ => false }
    if failed != (failure_report != None) -> return Err(io.Error.new(.InvalidData, "failed action record and failure report disagree"))
    if failure_report != None && !outputs.is_empty() -> return Err(io.Error.new(.InvalidData, "failed action record contains outputs"))
    Ok(Val(ActionResultRecord{key: key, outcome: final_outcome, outputs: ^outputs, failure_report: ^failure_report, provenance: ActionCacheProvenance.hit(.LocalActionRecordMatched)}))
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2287
fn io_action(action: BuildAction, error: io.Error) -> BuildExecutionError Never! { .IO{action: action.name.to_string(), detail: error.to_string()} }
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:2294
fn native_sandbox_error(action: BuildAction, error: NativeSandboxError) -> BuildExecutionError Never! {
    match error { .Unsupported(_) => .SandboxUnavailable; .Io(detail) => .IO{action: action.name.to_string(), detail: detail} }
}
