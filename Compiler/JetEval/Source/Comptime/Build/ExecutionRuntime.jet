    pub fn is_reported_action_failure(self: &Self) -> Bool { self is .Reported }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:122
fn action_failure_report(action: String, exit_code: I32, stderr: String) -> JetErrorReport {
    error := jet_err_with_identity("build action `{action}` exited with status {exit_code}", Ok("E3505"), Err(JetAbsent), "BuildAction::Failed")
    jet_err_set_details(&error, JetErrorDetails{
        variant: "BuildActionFailure",
        fields: [JetErrorField{name: "action", value: report_json_string(action)},
                 JetErrorField{name: "exit_code", value: exit_code.to_string()},
                 JetErrorField{name: "stderr", value: report_json_string(stderr)}],
        source_span: None,
    })
    jet_error_report(&error)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:157
fn report_json_string(value: String) -> String { "\"{json_escape(value)}\"" }

