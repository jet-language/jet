#Error
pub enum BuildExecutionError {
    MissingGrant(action: String, capability: BuildCapability)
    SandboxUnavailable
    IO(action: String, detail: String)
    ProbeFailed(probe: String, detail: String)
    Reported(report: JetErrorReport)
    InvalidGraph(BuildError)
}
impl BuildExecutionError {
    // Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:110
    pub fn report(self: &Self) -> JetErrorReport? {
        if self == { .Reported(report) -> Some(report); _ -> None }
    }
