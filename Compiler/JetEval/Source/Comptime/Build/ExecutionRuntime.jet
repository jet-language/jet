// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:188
pub fn native_sandbox_status() -> NativeSandboxStatus {
    // GATE #4494: native environment/backend probe. GATE #4483: selected-target OS.
    if std.env.var_os("JETPACK_FAKE_SANDBOX").is_some() {
        return NativeSandboxStatus{available: false, mechanism: "test-sandbox-unavailable", policy: "not-enforced", reason: "test sandbox override prevents the native backend probe"}
    }
    os := core.sys.target.selected_os()
    if os == "linux" || os == "macos" {
        native := jet_process_sandbox.status()
        return NativeSandboxStatus{available: native.available, mechanism: native.mechanism, policy: native.policy, reason: native.reason}
    }
    if os == "windows" {
        native := jet_windows_sandbox.windows_status()
        return NativeSandboxStatus{available: native.available, mechanism: native.mechanism, policy: native.policy, reason: native.reason}
    }
    NativeSandboxStatus{available: false, mechanism: "unsupported", policy: "not-enforced", reason: "Jetpack's native child sandbox is implemented only on Linux, macOS, and Windows"}
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:241
pub fn run_native_sandboxed(executable: &OSPath, args: &[String], source_dir: &OSPath, output_dir: OSPath?, env: &[String:String], share_network: Bool) -> NativeSandboxOutput NativeSandboxError! {
    run_native_sandboxed_with_timeout(executable, args, source_dir, output_dir, env, share_network, None)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:261
pub fn run_native_sandboxed_with_mounts(executable: &OSPath, args: &[String], source_dir: &OSPath, output_dir: OSPath?, env: &[String:String], share_network: Bool, mounts: &[ReadOnlyMount]) -> NativeSandboxOutput NativeSandboxError! {
    run_native_sandboxed_with_timeout_and_mounts(executable, args, source_dir, output_dir, env, share_network, mounts, None)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:282
fn run_native_sandboxed_with_timeout(executable: &OSPath, args: &[String], source_dir: &OSPath, output_dir: OSPath?, env: &[String:String], share_network: Bool, timeout: Duration?) -> NativeSandboxOutput NativeSandboxError! {
    run_native_sandboxed_with_timeout_and_mounts(executable, args, source_dir, output_dir, env, share_network, [], timeout)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:303
fn run_native_sandboxed_with_timeout_and_mounts(executable: &OSPath, args: &[String], source_dir: &OSPath, output_dir: OSPath?, env: &[String:String], share_network: Bool, mounts: &[ReadOnlyMount], timeout: Duration?) -> NativeSandboxOutput NativeSandboxError! {
    // GATE #4483, #4494: dispatch each original native sandbox arm by selected target.
    os := core.sys.target.selected_os()
    if os == "linux" || os == "macos" {
        output_is_separate := output_dir.is_some()
        output := jet_process_sandbox.output_with_read_only_mounts(executable, args, source_dir, output_dir, env, share_network, mounts, timeout).map_err(fn(error) {
            if error == { .Unsupported(detail) -> NativeSandboxError.Unsupported(detail); .Io(detail) -> NativeSandboxError.Io(detail) }
        })?
        return Ok(NativeSandboxOutput{output: ^output, mechanism: if os == "linux" -> "linux-bwrap" else -> "macos-seatbelt", policy: jet_process_sandbox.policy(output_is_separate, share_network)})
    }
    if os == "windows" {
        result := jet_windows_sandbox.windows_output_with_read_only_mounts(executable, args, source_dir, output_dir, env, share_network, true, output_dir.is_none(), mounts, timeout.map(fn(limit) { limit.as_millis().min(I64.MAX as U128) as I64 }), Some(64 * 1024 * 1024)).map_err(fn(error) {
            if error == { .Unsupported(detail) -> NativeSandboxError.Unsupported(detail); .Io(detail) -> NativeSandboxError.Io(detail) }
        })?
        return Ok(NativeSandboxOutput{output: ^result.output, mechanism: ^result.mechanism, policy: ^result.policy})
    }
    Err(NativeSandboxError.Unsupported("Jetpack's native child sandbox is implemented only on Linux, macOS, and Windows"))
}

