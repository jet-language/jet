// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:465
pub fn execute_build_plan_with_front_end_and_remote_and_compiler(plan: &BuildPlan, project_root: &OSPath, artifact_store: &BuildArtifactStore, grants: &Set<BuildCapability>, front_end: FrontEndCompletion, remote_binding: RemoteBuildBinding?, compiler: CompilerActionRunner?) -> BuildExecutionResult BuildExecutionError! {
    selected_actions := plan.selected_action_ids().map_err(fn(error) { BuildExecutionError.InvalidGraph(error) })?
    for action in plan.actions.iter().filter(fn(action) { selected_actions.contains(action.id) }) {
        for cap in action.caps {
            if !grants.contains(cap) -> return Err(BuildExecutionError.MissingGrant(action: action.name.clone(), capability: cap))
        }
    }
    selected_probes := plan.selected_probe_ids().map_err(fn(error) { BuildExecutionError.InvalidGraph(error) })?
    if !selected_probes.is_empty() && !grants.contains(BuildCapability.Exec) {
        ids := selected_probes.iter().collect::<[ProbeId]>()
        ids.sort()
        probe := plan.probes[ids[0].0]
        return Err(BuildExecutionError.MissingGrant(action: "probe {probe.name}", capability: BuildCapability.Exec))
    }
    probes := execute_probes(plan, &selected_probes)?
    model := plan.execution_model().map_err(fn(error) { BuildExecutionError.InvalidGraph(error) })?
    remote_scheduler := if remote_binding is Some(binding) && binding.is_enabled() {
        Some(remote_scheduler_for_binding(binding).map_err(fn(error) { BuildExecutionError.IO(action: "remote scheduler", detail: error) })?)
    } else { None }
    outcomes := [(ActionHandle, ActionOutcome)].new()
    for stage in model.stages {
        for batch in execution_batches(plan, &stage.actions) {
            for action_id in batch {
                action := plan.actions[action_id.0]
                for cap in action.caps {
                    if !grants.contains(cap) -> return Err(BuildExecutionError.MissingGrant(action: action.name.clone(), capability: cap))
                }
            }
            // GATE #4494: scoped workers must join before borrowed execution state expires.
            completed := thread.scope(fn(scope) -> [(ActionHandle, ActionOutcome)] BuildExecutionError! {
                jobs := batch.iter().map(fn(action_id) {
                    action := &plan.actions[action_id.0]
                    handle := ActionHandle{id: action.id, context: plan.context}
                    (handle, scope.spawn(fn() {
                        execute_one_action(plan, action, handle, project_root, artifact_store, grants, &probes, front_end, remote_binding, remote_scheduler.as_ref(), compiler)
                    }))
                }).collect::<[_]>()
                jobs.into_iter().map(fn(pair) -> (ActionHandle, ActionOutcome) BuildExecutionError! {
                    (handle, job) := ^pair
                    result := job.join().map_err(fn(_) { BuildExecutionError.IO(action: plan.actions[handle.id.0].name.clone(), detail: "sandbox worker panicked") })?
                    Ok((handle, result?))
                }).collect::<[_] BuildExecutionError!>()
            })?
            completed.sort_by_key(fn(pair) { pair.0.id })
            outcomes.extend(^completed)
        }
    }
    report := plan.execution_report(&outcomes).map_err(fn(error) { BuildExecutionError.InvalidGraph(error) })?
    Ok(BuildExecutionResult{report: ^report, probes: ^probes})
}

// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:581
fn execution_batches(plan: &BuildPlan, actions: &[ActionId]) -> [[ActionId]] {
    batches := [[ActionId]].new()
    limits := [String:USize].new()
    for spec in plan.resource_pools() { limits.insert(spec.pool.as_str().to_string(), spec.slots) }
    held := [[String:USize]].new()
    for action_id in actions {
        pools := action_pools(&plan.actions[action_id.0]).iter().map(fn(pool) { pool.as_str().to_string() }).collect::<Set<String>>()
        slot := held.iter().position(fn(used) {
            pools.iter().all(fn(pool) {
                limit := limits.get(pool) ?? 1
                limit == 0 || (used.get(pool) ?? 0) < limit
            })
        }) ?? {
            batches.push([])
            held.push([String:USize].new())
            batches.len() - 1
        }
        for pool in pools { held[slot].insert(pool.clone(), (held[slot].get(pool) ?? 0) + 1) }
        batches[slot].push(action_id)
    }
    ^batches
}

// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:615
fn execute_one_action(plan: &BuildPlan, action: &BuildAction, handle: ActionHandle, project_root: &OSPath, artifact_store: &BuildArtifactStore, grants: &Set<BuildCapability>, probe_facts: &[BuildProbeFact], front_end: FrontEndCompletion, remote_binding: RemoteBuildBinding?, remote_scheduler: RemoteScheduler?, compiler: CompilerActionRunner?) -> ActionOutcome BuildExecutionError! {
    cache_lookup_allowed := front_end.authorize_cache_lookup().is_ok()
    snapshots := snapshot_declared_inputs(artifact_store, project_root, action).map_err(fn(e) { io_action(action, e) })?
    remote_requested := remote_binding.is_some_and(fn(binding) { binding.is_enabled() })
    (executable, executable_digest) := if action.is_compiler_owned() {
        (OSPath.from("<jet-compiler>"), ContentDigest.from_bytes(b"jet-compiler"))
    } else {
        executable := resolve_program_path(plan, action.toolchain, &action.argv[0]).or_else(fn() {
            if remote_requested -> Some(OSPath.from(action.argv[0])) else -> None
        }) ?? return Err(BuildExecutionError.IO(action: action.name.clone(), detail: "tool {action.argv[0]} was not found"))
        executable_bytes := if executable.is_file() {
            fs.read(&executable).map_err(fn(e) { io_action(action, e) })?
        } else { action.argv[0].as_bytes().to_vec() }
        (^executable, ContentDigest.from_bytes(&executable_bytes))
    }
    action_probe_names := action.probes.iter().map(fn(probe) { plan.probes[probe.id.0].name }).collect::<Set<String>>()
    effective_probe_facts := probe_facts.iter().filter(fn(fact) { action_probe_names.contains(fact.name) }).cloned().collect::<[BuildProbeFact]>()
    key := plan.effective_action_key(handle, &snapshots, grants, &executable, &executable_digest, &effective_probe_facts).map_err(fn(error) { BuildExecutionError.InvalidGraph(error) })?
    remote := if action.is_compiler_owned() -> None else -> remote_for_action(plan, action, &key, grants, remote_binding, remote_scheduler)?
    restore_failure: CacheMissReason? = None
    if action.cache == ActionCache.Cached {
        if cache_lookup_allowed {
            if read_action_record(artifact_store, key.clone()) == {
                .Ok(Some(record)) -> {
                    if record.failure_report.is_some() {
                        record_comptime_cache_event(action.name, &key, ActionCacheStatus.Hit(CacheHitReason.LocalActionRecordMatched), "terminal", Some(record.outcome))
                    }
                    if record.failure_report is Some(report) -> return Err(BuildExecutionError.Reported(report: ^report))
                    if restore_action_outputs(artifact_store, project_root, action, &record) == {
                        .Ok(_) -> {
                            record_comptime_cache_event(action.name, &key, ActionCacheStatus.Hit(CacheHitReason.LocalActionRecordMatched), "restore", Some(ActionOutcome.RestoredFromCache))
                            return Ok(ActionOutcome.RestoredFromCache)
                        }
                        .Err(error) -> { restore_failure = Some(cache_restore_miss_reason(&error)) }
                    }
                }
                .Ok(None) -> {}
                .Err(error) -> { restore_failure = Some(cache_restore_miss_reason(&error)) }
            }
        } else { restore_failure = Some(CacheMissReason.FrontEndIncomplete) }
    }
    if action.cache == ActionCache.Cached && cache_lookup_allowed {
        if remote is Some((transport, policy, _execute)) {
            if transport.download_action_record(&key, policy) == {
                .Ok(record) -> {
                    if record.failure_report is Some(report) -> return Err(BuildExecutionError.Reported(report: ^report))
                    if !(record.outcome is .Succeeded || record.outcome is .RestoredFromCache) {
                        return Err(remote_action(action, "remote cache record contains a failed outcome without a report"))
                    }
                    if restore_remote_outputs(transport, policy, project_root, action, &record, RemoteActionRequest.CacheRead) == {
                        .Ok(restored) -> {
                            restored.commit()
                            record_comptime_cache_event(action.name, &key, ActionCacheStatus.Hit(CacheHitReason.DeclaredOutputsRestored), "restore", Some(ActionOutcome.RestoredFromCache))
                            return Ok(ActionOutcome.RestoredFromCache)
                        }
                        .Err(detail) -> {
                            if !remote_binding.is_some_and(fn(binding) { binding.fallback_local }) -> return Err(remote_action(action, detail))
                        }
                    }
                }
                .Err(RemoteCacheError.Io(error)) if error.kind() == io.ErrorKind.NotFound -> {}
                .Err(RemoteCacheError.Denied(denied)) if denied.reason == RemoteDeniedReason.GrantNotAllowed -> {}
                .Err(error) -> {
                    if !remote_binding.is_some_and(fn(binding) { binding.fallback_local }) -> return Err(remote_action(action, error.to_string()))
                }
            }
        }
    }
    rebuild_status := if action.cache == ActionCache.UncachedPhony {
        ActionCacheStatus.Miss(CacheMissReason.UncachedAction)
    } else if restore_failure is Some(reason) { ActionCacheStatus.Miss(reason) }
    else { ActionCacheStatus.Miss(CacheMissReason.NoLocalActionRecord) }
    record_comptime_cache_event(action.name, &key, rebuild_status, "lookup", None)
    if action.legacy_wrapper == Some(LegacyWrapperKind.Npm) && action.labels.keys().any(fn(key) { key.starts_with("legacy.dependency.") }) {
        // GATE #4409: preserve Unsupported IO kind.
        return Err(io_action(action, io.Error.new(io.ErrorKind.Unsupported, "npm dependency-bearing imports require a provisioned locked dependency tree")))
    }
    if action.is_compiler_owned() {
        runner := compiler ?? return Err(BuildExecutionError.IO(action: action.name.clone(), detail: "compiler-owned action has no compiler runner"))
        bytes := runner(action, &snapshots).map_err(fn(detail) { BuildExecutionError.IO(action: action.name.clone(), detail: detail) })?
        if bytes.len() != action.outputs.len() {
            return Err(BuildExecutionError.IO(action: action.name.clone(), detail: "compiler runner returned {bytes.len()} outputs for {action.outputs.len()} declarations"))
        }
        for (output, bytes) in action.outputs.iter().zip(bytes) {
            path := resolve_under(project_root, output.as_str()).map_err(fn(e) { io_action(action, e) })?
            prepare_output_destination(project_root, &path).map_err(fn(e) { io_action(action, e) })?
            atomic_restore_file(project_root, &path, &bytes).map_err(fn(e) { io_action(action, e) })?
        }
        outcome := ActionOutcome.Succeeded(exit_code: 0)
        if action.cache == ActionCache.Cached {
            record := capture_declared_outputs(artifact_store, project_root, action, key.clone(), outcome, ActionCacheProvenance.miss(rebuild_status_reason(rebuild_status))).map_err(fn(e) { io_action(action, e) })?
            write_action_record(artifact_store, &key, &record).map_err(fn(e) { io_action(action, e) })?
        }
        record_comptime_cache_event(action.name, &key, rebuild_status, "publish", Some(outcome))
        return Ok(outcome)
    }
    if remote is Some((_transport, _policy, true)) {
        timeout_ms := remote_binding.map(fn(binding) { binding.timeout_ms }) ?? 30_000
        result := execute_remote_action(plan, action, project_root, artifact_store, &snapshots, &key, timeout_ms, remote_scheduler.expect("enabled remote execution requires its scheduler"), remote_binding.expect("enabled remote execution requires its host binding"))
        if result == {
            .Ok(outcome) -> return Ok(outcome)
            .Err(error) -> {
                if !(remote_binding.is_some_and(fn(binding) { binding.fallback_local }) && !error.is_reported_action_failure()) -> return Err(error)
            }
        }
    }
    if remote_binding.is_some_and(fn(binding) { binding.cache_read && !binding.execute && !binding.fallback_local }) {
        return Err(remote_action(action, "remote cache miss cannot fall back to local execution"))
    }
    // GATE #4494: real native filesystem and process identity, with exact IO kinds (#4409).
    key_suffix := key.as_str().trim_start_matches("act-sha256:") // #4303
    sandbox := project_root.join(".jet/build-sandbox").join("{process.id()}-{action.id.0}-{key_suffix}")
    sandbox_root := sandbox.parent() ?? return Err(io_action(action, io.Error.new(io.ErrorKind.InvalidInput, "sandbox has no parent")))
    ensure_real_directory(sandbox_root).map_err(fn(e) { io_action(action, e) })?
    if fs.symlink_metadata(&sandbox) is .Ok(metadata) {
        if metadata.file_type().is_symlink() || !metadata.is_dir() {
            return Err(io_action(action, io.Error.new(io.ErrorKind.PermissionDenied, "action sandbox is not a real directory")))
        }
        fs.remove_dir_all(&sandbox).map_err(fn(e) { io_action(action, e) })?
    }
    ensure_real_directory(&sandbox).map_err(fn(e) { io_action(action, e) })?
