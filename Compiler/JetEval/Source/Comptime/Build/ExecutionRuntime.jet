// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1052
fn execute_remote_action(plan: &BuildPlan, action: &BuildAction, project_root: &OSPath, artifact_store: &BuildArtifactStore, snapshots: &[ActionInputSnapshot], key: &ActionKey, timeout_ms: U64, scheduler: &RemoteScheduler, binding: &RemoteBuildBinding) -> ActionOutcome BuildExecutionError! {
    request := remote_execution_request(action, key, binding)
    last_failure: BuildExecutionError? = None
    dispatch := scheduler.dispatch(&request, fn(builder) -> ActionOutcome RemoteAttemptError! {
        transport := RemoteCacheTransport.for_binding(&builder.binding).map_err(fn(detail) { RemoteAttemptError.rejected(detail) })?
        policy := remote_attempt_policy(plan, action, key, &builder.binding, &transport).map_err(fn(error) { RemoteAttemptError.rejected("{error:?}") })?
        if execute_remote_candidate(plan, action, project_root, artifact_store, snapshots, key, &transport, &policy, timeout_ms, &builder.binding) == {
            .Ok(outcome) -> Ok(outcome)
            .Err(failure) -> {
                detail := "{failure.error:?}"
                retryable := failure.retryable
                last_failure = Some(^failure.error)
                if retryable -> Err(RemoteAttemptError.worker_lost(detail)) else -> Err(RemoteAttemptError.rejected(detail))
            }
        }
    })
    if dispatch == {
        .Ok(dispatch) -> Ok(^dispatch.value)
        .Err(error) -> Err(last_failure ?? remote_action(action, error.to_string()))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1101
fn execute_remote_candidate(plan: &BuildPlan, action: &BuildAction, project_root: &OSPath, artifact_store: &BuildArtifactStore, snapshots: &[ActionInputSnapshot], key: &ActionKey, transport: &RemoteCacheTransport, policy: &RemoteCachePolicy, timeout_ms: U64, binding: &RemoteBuildBinding) -> ActionOutcome RemoteAttemptFailure! {
    policy := policy.clone()
    last_failure: RemoteAttemptFailure? = None
    for attempt in 0..MAX_REMOTE_EXECUTION_ATTEMPTS {
        if execute_remote_attempt(plan, action, project_root, artifact_store, snapshots, key, transport, &policy, timeout_ms) == {
            .Ok(outcome) -> return Ok(outcome)
            .Err(failure) -> {
                if failure.retryable && attempt + 1 < MAX_REMOTE_EXECUTION_ATTEMPTS {
                    last_failure = Some(^failure)
                    policy = remote_attempt_policy(plan, action, key, binding, transport).map_err(fn(error) { RemoteAttemptFailure.from(error) })?
                } else { return Err(^failure) }
            }
        }
    }
    Err(last_failure.expect("remote execution attempt loop must produce a result"))
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1138
fn execute_remote_attempt(plan: &BuildPlan, action: &BuildAction, project_root: &OSPath, artifact_store: &BuildArtifactStore, snapshots: &[ActionInputSnapshot], key: &ActionKey, transport: &RemoteCacheTransport, policy: &RemoteCachePolicy, timeout_ms: U64) -> ActionOutcome RemoteAttemptFailure! {
    proof := policy.proof().cloned() ?? return Err(RemoteAttemptFailure.terminal(remote_action(action, "remote sandbox proof is missing")))
    for snapshot in snapshots {
        path := resolve_under(project_root, snapshot.path.as_str()).map_err(fn(e) { RemoteAttemptFailure.from(io_action(action, e)) })?
        bytes := secure_read_file(project_root, &path).map_err(fn(e) { RemoteAttemptFailure.from(io_action(action, e)) })?
        digest := transport.upload_execution_blob(&bytes, policy).map_err(fn(error) { RemoteAttemptFailure.from(remote_action(action, error.to_string())) })?
        if digest != snapshot.digest || bytes.len() as U64 != snapshot.byte_len {
            return Err(RemoteAttemptFailure.terminal(remote_action(action, "remote input CAS identity changed for {snapshot.path.as_str()}")))
        }
    }
    request := RemoteExecutionRequest{key: key.clone(), attempt_id: proof.attempt_id.clone(), argv: action.argv.clone(), inputs: snapshots.to_vec(), outputs: action.outputs.clone(), toolchain_digest: toolchain_provenance_digest(plan, action.toolchain), sandbox: ^proof}
    expected_execution_id := remote_execution_identity(&request)
    transport.submit_execution(&request, policy).map_err(fn(error) { RemoteAttemptFailure.from(remote_action(action, error.to_string())) })?
    result := wait_remote_execution_result(transport, policy, key, action, &expected_execution_id, timeout_ms)?
    if result.outcome == {
        .Succeeded(exit_code) -> {
            restored := restore_remote_outputs(transport, policy, project_root, action, &ActionResultRecord{key: result.key.clone(), outcome: result.outcome, outputs: result.outputs.clone(), failure_report: None, provenance: ActionCacheProvenance.miss(CacheMissReason.RemoteDenied)}, RemoteActionRequest.Execute).map_err(fn(detail) { RemoteAttemptFailure.from(remote_action(action, detail)) })?
            if action.cache == ActionCache.Cached {
                record := capture_declared_outputs(artifact_store, project_root, action, key.clone(), ActionOutcome.Succeeded(exit_code: exit_code), ActionCacheProvenance.miss(CacheMissReason.RemoteDenied)).map_err(fn(e) { RemoteAttemptFailure.from(io_action(action, e)) })?
                if record.outputs != result.outputs {
                    return Err(RemoteAttemptFailure.terminal(remote_action(action, "remote output changed before local publication")))
                }
                if policy.check(RemoteActionRequest.CacheWrite).is_ok() {
                    publish_remote_outputs(transport, policy, project_root, &record).map_err(fn(detail) { RemoteAttemptFailure.from(remote_action(action, detail)) })?
                }
                write_action_record(artifact_store, key, &record).map_err(fn(e) { RemoteAttemptFailure.from(io_action(action, e)) })?
                record_comptime_cache_event(action.name, key, ActionCacheStatus.Miss(CacheMissReason.RemoteDenied), "publish", Some(ActionOutcome.Succeeded(exit_code: exit_code)))
            }
            restored.commit()
            Ok(ActionOutcome.Succeeded(exit_code: exit_code))
        }
        .Failed(exit_code) -> {
            stderr := transport.download_execution_blob(&result.stderr_digest, policy).map_err(fn(error) { RemoteAttemptFailure.terminal(remote_action(action, error.to_string())) })?
            stderr_view := String.from_utf8_lossy(&stderr).trim() // #4303
            report := action_failure_report(action.name, exit_code, stderr_view.to_string())
            if action.cache == ActionCache.Cached {
                record := ActionResultRecord{key: key.clone(), outcome: ActionOutcome.Failed(exit_code: exit_code), outputs: [], failure_report: Some(report.clone()), provenance: ActionCacheProvenance.miss(CacheMissReason.RemoteDenied)}
                if policy.check(RemoteActionRequest.CacheWrite).is_ok() {
                    publish_remote_outputs(transport, policy, project_root, &record).map_err(fn(detail) { RemoteAttemptFailure.terminal(remote_action(action, detail)) })?
                }
                write_action_record(artifact_store, key, &record).map_err(fn(error) { RemoteAttemptFailure.terminal(io_action(action, error)) })?
                record_comptime_cache_event(action.name, key, ActionCacheStatus.Miss(CacheMissReason.RemoteDenied), "terminal", Some(ActionOutcome.Failed(exit_code: exit_code)))
            }
            Err(RemoteAttemptFailure.terminal(BuildExecutionError.Reported(report: ^report)))
        }
        .RestoredFromCache -> Err(RemoteAttemptFailure.terminal(remote_action(action, "remote execution returned a cache-only outcome")))
    }
}

// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1289
fn remote_for_action(plan: &BuildPlan, action: &BuildAction, key: &ActionKey, grants: &Set<BuildCapability>, binding: RemoteBuildBinding?, scheduler: RemoteScheduler?) -> (RemoteCacheTransport, RemoteCachePolicy, Bool)? BuildExecutionError! {
    binding := binding.filter(fn(binding) { binding.is_enabled() }) ?? return Ok(None)
    trust_domain := binding.trust_domain.trim() // #4303
    if trust_domain.is_empty() -> return Err(remote_action(action, "remote builder binding has no trust domain"))
    if binding.trust_domain.len() > 256 || binding.trust_domain.chars().any(fn(character) { character.is_control() }) {
        return Err(remote_action(action, "remote builder binding has an invalid trust domain"))
    }
    if !grants.contains(BuildCapability.Net) -> return Err(BuildExecutionError.MissingGrant(action: "remote build transport for {action.name}", capability: BuildCapability.Net))
    transport := RemoteCacheTransport.for_binding(binding).map_err(fn(detail) { remote_action(action, detail) })?
    if !action.caps.contains(BuildCapability.Net) -> return Err(BuildExecutionError.MissingGrant(action: "remote build transport for {action.name}", capability: BuildCapability.Net))
    request := action_pools(action).into_iter().fold(RemoteBuildRequest.new(key.clone()), fn(request, pool) { request.with_pool(pool) })
        .with_platform(binding.platform.clone()).with_trust_domain(binding.trust_domain.clone())
        .with_cache_read(binding.cache_read).with_cache_write(binding.cache_write).with_execute(binding.execute).with_local_fallback(binding.fallback_local)
    scheduler := scheduler ?? return Err(remote_action(action, "remote builder binding has no canonical scheduler"))
    if scheduler.select(&request) == {
        .Ok(_) -> {}
        .Err(error) -> { if binding.fallback_local -> return Ok(None) else -> return Err(remote_action(action, error.to_string())) }
    }
    policy := remote_attempt_policy(plan, action, key, binding, &transport)?
    Ok(Some((^transport, ^policy, binding.execute)))
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1360
fn remote_scheduler_for_binding(binding: &RemoteBuildBinding) -> RemoteScheduler Err! {
    selected := RemoteBuilder.from_binding(binding.clone())
    selected.capabilities.priority = 1
    builders := [^selected]
    selected_is_registered := if RemoteBuildBinding.load_host(binding.builder) == { .Ok(registered) -> registered == binding; .Err(_) -> false }
    if selected_is_registered {
        for name in RemoteBuildBinding.list_host()? {
            if name == binding.builder -> continue
            candidate := if RemoteBuildBinding.load_host(name) == { .Ok(candidate) -> ^candidate; .Err(_) -> continue }
            candidate := RemoteBuilder.from_binding(^candidate)
            candidate.capabilities.priority = 0
            builders.push(^candidate)
        }
    }
    RemoteScheduler.new(^builders).map_err(fn(error) { error.to_string() })
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1387
fn remote_execution_request(action: &BuildAction, key: &ActionKey, binding: &RemoteBuildBinding) -> RemoteBuildRequest {
    action_pools(action).into_iter().fold(RemoteBuildRequest.new(key.clone()), fn(request, pool) { request.with_pool(pool) })
        .with_platform(binding.platform.clone()).with_trust_domain(binding.trust_domain.clone()).with_execute(true).with_local_fallback(binding.fallback_local)
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1403
fn remote_attempt_policy(plan: &BuildPlan, action: &BuildAction, key: &ActionKey, binding: &RemoteBuildBinding, transport: &RemoteCacheTransport) -> RemoteCachePolicy BuildExecutionError! {
    // GATE #4494: atomics, wall clock and native process id.
    attempt := REMOTE_ATTEMPT.fetch_add(1, Ordering.Relaxed)
    timestamp := SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()
    attempt_id := "attempt-{process.id()}-{timestamp}-{attempt}"
    proof := transport.sandbox_proof("remote:{binding.builder}:{binding.trust_domain}:local-{process.id()}-{action.id.0}-{attempt}", attempt_id, key.as_str(), remote_provenance_digest(plan, action)).map_err(fn(detail) { remote_action(action, detail) })?
    Ok(RemoteCachePolicy.with_grants(binding.cache_read, binding.cache_write, binding.execute, ^proof))
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1438
fn wait_remote_execution_result(transport: &RemoteCacheTransport, policy: &RemoteCachePolicy, key: &ActionKey, action: &BuildAction, expected_execution_id: &ContentDigest, timeout_ms: U64) -> RemoteExecutionResult RemoteAttemptFailure! {
    // GATE #4494: monotonic clock, cancellation, native sleep. #4409: NotFound fidelity.
    timeout := Duration.from_millis(timeout_ms)
    deadline := Instant.now() + timeout
    loop {
        if transport.download_execution_result(key, policy) == {
            .Ok(result) -> {
                if result.execution_id != expected_execution_id {
                    detail := "remote execution identity mismatch: expected {expected_execution_id.as_str()}, got {result.execution_id.as_str()}"
                    detail := if transport.cancel_execution(key, policy) == {
                        .Ok(_) -> ^detail
                        .Err(cancel_error) -> "{detail}; cancellation failed: {cancel_error}"
                    }
                    record_comptime_cache_event(action.name, key, ActionCacheStatus.Miss(CacheMissReason.RemoteDenied), "interrupted", None)
                    return Err(RemoteAttemptFailure.terminal(remote_action(action, detail)))
                }
                return Ok(^result)
            }
            .Err(RemoteCacheError.Io(error)) if error.kind() == io.ErrorKind.NotFound && Instant.now() < deadline -> {
                thread.sleep(Duration.from_millis(10))
            }
            .Err(RemoteCacheError.Io(error)) if error.kind() == io.ErrorKind.NotFound -> {
                record_comptime_cache_event(action.name, key, ActionCacheStatus.Miss(CacheMissReason.RemoteDenied), "interrupted", None)
                return if transport.cancel_execution(key, policy) == {
                    .Ok(_) -> Err(RemoteAttemptFailure.retryable(remote_action(action, "remote worker did not publish a result within {timeout.as_millis()}ms")))
                    .Err(cancel_error) -> Err(RemoteAttemptFailure.terminal(remote_action(action, "remote worker did not publish a result within {timeout.as_millis()}ms; cancellation failed: {cancel_error}")))
                }
            }
            .Err(error) -> {
                detail := if transport.cancel_execution(key, policy) == {
                    .Ok(_) -> error.to_string()
                    .Err(cancel_error) -> "{error}; cancellation failed: {cancel_error}"
                }
                record_comptime_cache_event(action.name, key, ActionCacheStatus.Miss(CacheMissReason.RemoteDenied), "interrupted", None)
                return Err(RemoteAttemptFailure.terminal(remote_action(action, detail)))
            }
        }
    }
}

// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1524
fn restore_remote_outputs(transport: &RemoteCacheTransport, policy: &RemoteCachePolicy, project_root: &OSPath, action: &BuildAction, record: &ActionResultRecord, blob_request: RemoteActionRequest) -> RemoteOutputRestore Err! {
    if record.outputs.len() != action.outputs.len() || record.outputs.iter().zip(&action.outputs).any(fn(pair) { pair.0.path != pair.1 }) {
        return Err("remote output record does not exactly match action declarations")
    }
    staged := [(OSPath, [U8])].with_capacity(record.outputs.len())
    backups := [(OSPath, [U8]?)].with_capacity(record.outputs.len())
    for output in record.outputs {
        bytes := if blob_request == {
            .CacheRead -> transport.download_blob(&output.digest, policy)
            .Execute -> transport.download_execution_blob(&output.digest, policy)
            .CacheWrite -> return Err("remote output restore cannot use a cache-write grant")
        }.map_err(fn(error) { error.to_string() })?
        if bytes.len() as U64 != output.byte_len || ContentDigest.from_bytes(&bytes) != output.digest {
            return Err("remote output blob {output.path.as_str()} failed digest or length verification")
        }
        path := resolve_under(project_root, output.path.as_str()).map_err(fn(error) { error.to_string() })?
        previous := if secure_read_file(project_root, &path) == {
            .Ok(bytes) -> Some(^bytes)
            .Err(error) if error.kind() == io.ErrorKind.NotFound -> None
            .Err(error) -> return Err(error.to_string())
        }
        backups.push((path.clone(), ^previous))
        staged.push((^path, ^bytes))
    }
    for (path, bytes) in staged {
        if prepare_output_destination(project_root, path).and_then(fn(_) { atomic_restore_file(project_root, path, bytes) }) is .Err(error) {
            rollback_output_restore(project_root, &backups)
            return Err(error.to_string())
        }
    }
    Ok(RemoteOutputRestore{project_root: project_root, backups: ^backups, committed: false})
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1589
struct RemoteOutputRestore { project_root: &OSPath, backups: [(OSPath, [U8]?)], committed: Bool }
impl RemoteOutputRestore {
    // Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1596
    fn commit(self: Self) { self.committed = true }
}
impl Drop for RemoteOutputRestore {
    // Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1602
    fn drop(self: &Self) { if !self.committed { rollback_output_restore(self.project_root, &self.backups) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1609
fn rollback_output_restore(project_root: &OSPath, backups: &[(OSPath, [U8]?)]) {
    for (path, previous) in backups.iter().rev() {
        if previous == {
            Some(bytes) -> { _ :: prepare_output_destination(project_root, path).and_then(fn(_) { atomic_restore_file(project_root, path, bytes) }) }
            None -> {
                if fs.symlink_metadata(path) == {
                    .Ok(metadata) if metadata.file_type().is_symlink() -> {}
                    .Ok(metadata) if metadata.is_file() -> { _ :: fs.remove_file(path) }
                    _ -> {}
                }
            }
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1627
fn publish_remote_outputs(transport: &RemoteCacheTransport, policy: &RemoteCachePolicy, project_root: &OSPath, record: &ActionResultRecord) -> () Err! {
    outputs := [ActionOutputRecord].with_capacity(record.outputs.len())
    for output in record.outputs {
        path := resolve_under(project_root, output.path.as_str()).map_err(fn(error) { error.to_string() })?
        bytes := secure_read_file(project_root, &path).map_err(fn(error) { error.to_string() })?
        digest := transport.upload_blob(&bytes, policy).map_err(fn(error) { error.to_string() })?
        if digest != output.digest || bytes.len() as U64 != output.byte_len {
            return Err("remote output CAS identity changed for {output.path.as_str()}")
        }
        outputs.push(ActionOutputRecord{path: output.path.clone(), digest: ^digest, byte_len: bytes.len() as U64})
    }
    transport.upload_action_record(&ActionResultRecord{key: record.key.clone(), outcome: record.outcome, outputs: ^outputs, failure_report: record.failure_report.clone(), provenance: record.provenance.clone()}, policy).map_err(fn(error) { error.to_string() })?
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1668
fn remote_action(action: &BuildAction, detail: String) -> BuildExecutionError { BuildExecutionError.IO(action: "remote {action.name}", detail: ^detail) }
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1675
fn rebuild_status_reason(status: ActionCacheStatus) -> CacheMissReason {
    if status == { .Miss(reason) -> reason; .Hit(_) -> CacheMissReason.NoLocalActionRecord }
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1682
fn prepare_output_destination(root: &OSPath, output: &OSPath) -> () io.Error! {
    // GATE #4494 native filesystem; #4409 preserves InvalidInput/PermissionDenied/NotADirectory.
    parent := output.parent() ?? root
    relative := parent.strip_prefix(root).map_err(fn(_) { io.Error.new(io.ErrorKind.InvalidInput, "build output parent escapes project root") })?
    current := root.to_path_buf()
    for component in relative.components() {
        if component is Component.Normal(part) {
            current.push(part)
            if fs.symlink_metadata(&current) == {
                .Ok(meta) if meta.file_type().is_symlink() -> return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build output parent `{current.display()}` is a symlink"))
                .Ok(meta) if !meta.is_dir() -> return Err(io.Error.new(io.ErrorKind.NotADirectory, "build output parent `{current.display()}` is not a directory"))
                .Ok(_) -> {}
                .Err(error) if error.kind() == io.ErrorKind.NotFound -> {
                    if fs.create_dir(&current) == {
                        .Ok(_) -> {}
                        .Err(error) if error.kind() == io.ErrorKind.AlreadyExists -> {
                            metadata := fs.symlink_metadata(&current)?
                            if metadata.file_type().is_symlink() || !metadata.is_dir() {
                                return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build output parent `{current.display()}` is not a real directory"))
                            }
                        }
                        .Err(error) -> return Err(error)
                    }
                }
                .Err(error) -> return Err(error)
            }
        }
    }
    if fs.symlink_metadata(output).is_ok_and(fn(meta) { meta.file_type().is_symlink() }) { fs.remove_file(output)? }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/execution_runtime.rs:1739
fn execute_probes(plan: &BuildPlan, selected: &Set<ProbeId>) -> [BuildProbeFact] BuildExecutionError! {
    facts := [BuildProbeFact].new()
    for probe in plan.probes.iter().filter(fn(probe) { selected.contains(probe.id) }) {
        (success, detail) := if probe.kind == {
            .FindProgram(program) -> {
                if resolve_program_path(plan, probe.toolchain, program) == {
                    Some(path) -> (true, path.display().to_string())
                    None -> (false, "program `{program}` not found")
                }
            }
            .PkgConfig(package, min_version) -> {
                pkg_config := resolve_program_path(plan, probe.toolchain, "pkg-config") ?? return Err(BuildExecutionError.ProbeFailed(probe: probe.name.clone(), detail: "pkg-config not found"))
                args := ["--exists"]
                if min_version is Some(version) { args.push("{package} >= {version}") } else { args.push(package.clone()) }
                output := run_probe_sandboxed(&pkg_config, &args, None)?
                (output.status.success(), "pkg-config exit {output.status.code() ?? 1}")
            }
            .HeaderCheck(header) -> {
                source := "#include <{header}>\nint main(void) {{ return 0; }}\n"
                run_compile_probe(plan, probe.toolchain, &source)?
            }
            .CompileCheck(includes, code, ..) -> {
                source := String.new()
                for header in includes { source.push_str("#include <{header}>\n") }
                source.push_str("int main(void) {\n")
                source.push_str(code)
                source.push_str("\nreturn 0;\n}\n")
                run_compile_probe(plan, probe.toolchain, &source)?
            }
        }
        facts.push(BuildProbeFact{name: probe.name.clone(), success: success, detail: detail.clone(), reproducibility: probe.reproducibility, toolchain: probe.toolchain, toolchain_provenance: toolchain_provenance_digest(plan, probe.toolchain)})
        if !success -> return Err(BuildExecutionError.ProbeFailed(probe: probe.name.clone(), detail: ^detail))
    }
    Ok(^facts)
}
