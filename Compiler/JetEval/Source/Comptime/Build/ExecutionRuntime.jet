            }
        }
        write_action_record(artifact_store, &key, &record).map_err(fn(e) { io_action(action, e) })?
        record_comptime_cache_event(action.name, &key, ActionCacheStatus.Miss(CacheMissReason.NoLocalActionRecord), "publish", Some(outcome))
