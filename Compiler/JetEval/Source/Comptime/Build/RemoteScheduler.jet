// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:178
#Derive(Debug, Clone, Eq)
pub struct RemoteBuilder { pub binding: RemoteBuildBinding; pub capabilities: RemoteBuilderCapabilities }
impl RemoteBuilder {
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:184
    pub fn new(binding: RemoteBuildBinding, capabilities: RemoteBuilderCapabilities) -> RemoteBuilder RemoteScheduleError! {
        if binding.platform != capabilities.platform || binding.trust_domain != capabilities.trust_domain || binding.cache_read != capabilities.cache_read || binding.cache_write != capabilities.cache_write || binding.execute != capabilities.execute {
            throw RemoteScheduleError.BindingFactsMismatch { builder: ^binding.builder }
        }
        RemoteBuilder { binding: ^binding, capabilities: ^capabilities }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:204
    pub fn from_binding(binding: RemoteBuildBinding) -> RemoteBuilder {
        capabilities := RemoteBuilderCapabilities.from_binding(&binding)
        RemoteBuilder { binding: ^binding, capabilities: ^capabilities }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:212
    pub fn builder(self: &RemoteBuilder) -> &String { &self.binding.builder }
}
