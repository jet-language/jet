// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:247
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:322
#Error
#Derive(Debug, Clone, Eq)
pub enum RemoteScheduleError {
    DuplicateBuilder(String)
    BindingFactsMismatch { builder: String }
    NoEligibleBuilder { action: ActionKey, fallback_local: Bool }
    CapacityExhausted { action: ActionKey, fallback_local: Bool }
    Rejected { action: ActionKey, builder: String, detail: String, fallback_local: Bool }
    AttemptsExhausted { action: ActionKey, attempted: [String], fallback_local: Bool }
}
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:275
impl std.fmt.Display for RemoteScheduleError {
    fn fmt(self: &RemoteScheduleError, f: &std.fmt.Formatter) -> Unit std.fmt.Error! {
        match self {
            .DuplicateBuilder(builder) => f.write_str("remote builder `{builder}` is duplicated")?
            .BindingFactsMismatch { builder } => f.write_str("remote builder `{builder}` binding facts do not match its capability record")?
            .NoEligibleBuilder { action, fallback_local } => f.write_str("no eligible remote builder for `{action.as_str()}` (local fallback: {fallback_local})")?
            .CapacityExhausted { action, fallback_local } => f.write_str("eligible remote builder capacity is exhausted for `{action.as_str()}` (local fallback: {fallback_local})")?
            .Rejected { action, builder, detail, fallback_local } => f.write_str("remote builder `{builder}` rejected `{action.as_str()}`: {detail} (local fallback: {fallback_local})")?
            .AttemptsExhausted { action, attempted, fallback_local } => f.write_str("remote builders exhausted for `{action.as_str()}` after [{attempted.join(", ")}] (local fallback: {fallback_local})")?
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:325
#Derive(Debug, Eq)
pub struct RemoteDispatch<T> { pub builder: String; pub attempted: [String]; pub value: T }
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:332
#Derive(Debug, Clone, Default)
pub struct RemoteScheduler {
    builders: [String:RemoteBuilder]
    active: Arc<Mutex<[String:USize]>>
}
impl RemoteScheduler {
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:339
    pub fn new(builders: [RemoteBuilder]) -> RemoteScheduler RemoteScheduleError! {
        registered: [String:RemoteBuilder] = [:]
        for builder in ^builders {
            name := builder.builder().clone()
            if registered.insert(name.clone(), ^builder).is_some() { throw RemoteScheduleError.DuplicateBuilder(^name) }
        }
        RemoteScheduler { builders: ^registered, active: Arc.new(Mutex.new([:])) }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:356
    pub fn builders(self: &RemoteScheduler) -> [&RemoteBuilder] {
        names := self.builders.keys().cloned().collect::<[String]>()
        names.sort()
        names.iter().map(fn(name) { self.builders.get(name).unwrap() }).collect()
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:360
    pub fn candidates(self: &RemoteScheduler, request: &RemoteBuildRequest) -> [&RemoteBuilder] {
        candidates := self.builders.values().filter(fn(builder) { eligible(builder, request) }).collect::<[&RemoteBuilder]>()
        candidates.sort_by(fn(left, right) { right.capabilities.priority.cmp(&left.capabilities.priority).then_with(fn() { left.builder().cmp(right.builder()) }) })
        ^candidates
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:376
    pub fn select(self: &RemoteScheduler, request: &RemoteBuildRequest) -> &RemoteBuilder RemoteScheduleError! {
        if builder := self.candidates(request).into_iter().next() { return builder }
        throw RemoteScheduleError.NoEligibleBuilder { action: request.action.clone(), fallback_local: request.fallback_local }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:391
    // Fail over only on retryable errors. Never implicitly execute locally.
    pub fn dispatch<T>(self: &RemoteScheduler, request: &RemoteBuildRequest, attempt: fn(&RemoteBuilder) -> T RemoteAttemptError!) -> RemoteDispatch<T> RemoteScheduleError! {
        candidates := self.candidates(request)
        if candidates.is_empty() { throw RemoteScheduleError.NoEligibleBuilder { action: request.action.clone(), fallback_local: request.fallback_local } }
        attempted := [String].with_capacity(candidates.len())
        reserved := false
        for builder in candidates {
            reservation := self.reserve(builder) else { continue }
            reserved = true
            name := builder.builder().clone()
            attempted.push(name.clone())
            // Release the lease on both success and failure, before handling the outcome.
            value := attempt(builder) catch error {
                std.mem.drop(^reservation)
                if error.retryable { continue }
                throw RemoteScheduleError.Rejected { action: request.action.clone(), builder: ^name, detail: ^error.detail, fallback_local: request.fallback_local }
            }
            std.mem.drop(^reservation)
            return RemoteDispatch { builder: ^name, attempted: ^attempted, value: ^value }
        }
        if !reserved { throw RemoteScheduleError.CapacityExhausted { action: request.action.clone(), fallback_local: request.fallback_local } }
        throw RemoteScheduleError.AttemptsExhausted { action: request.action.clone(), attempted: ^attempted, fallback_local: request.fallback_local }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:449
    // GATE #4494: mutex guard releases the native lock on scope exit.
    fn reserve(self: &RemoteScheduler, builder: &RemoteBuilder) -> RemoteBuilderLease? {
        active := self.active.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        count := active.entry(builder.builder().clone()).or_default()
        if *count >= builder.capabilities.concurrency { return None }
        *count += 1
        Val(RemoteBuilderLease { active: Arc.clone(&self.active), builder: builder.builder().clone() })
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:466
struct RemoteBuilderLease { active: Arc<Mutex<[String:USize]>>; builder: String }
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:472
impl Drop for RemoteBuilderLease {
    fn drop(self: &RemoteBuilderLease) {
        active := self.active.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        if count := active.get_mut(&self.builder) {
            *count = count.saturating_sub(1)
            if *count == 0 { _ :: active.remove(&self.builder) }
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:486
fn eligible(builder: &RemoteBuilder, request: &RemoteBuildRequest) -> Bool {
    facts := &builder.capabilities
    builder.binding.is_enabled() && facts.concurrency > 0
        && request.platform.as_ref().is_none_or(fn(platform) { platform == &facts.platform })
        && request.trust_domain.as_ref().is_none_or(fn(trust) { trust == &facts.trust_domain })
        && request.features.is_subset(&facts.features)
        && request.resource_pools.is_subset(&facts.resource_pools)
        && request.capabilities.is_subset(&facts.capabilities)
        && (!request.cache_read || facts.cache_read && builder.binding.cache_read)
        && (!request.cache_write || facts.cache_write && builder.binding.cache_write)
        && (!request.execute || facts.execute && builder.binding.execute)
}
