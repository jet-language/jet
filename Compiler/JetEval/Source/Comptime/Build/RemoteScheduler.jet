#Error
#Derive(Debug, Clone, Eq)
pub struct RemoteAttemptError { pub retryable: Bool; pub detail: String }
impl RemoteAttemptError {
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:225
    pub fn worker_lost(detail: String) -> RemoteAttemptError { RemoteAttemptError { retryable: true, detail: ^detail } }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:232
    pub fn retryable(detail: String) -> RemoteAttemptError { RemoteAttemptError { retryable: true, detail: ^detail } }
    // Rust: crates/jet-comptime/src/Comptime/Build/remote_scheduler.rs:239
    pub fn rejected(detail: String) -> RemoteAttemptError { RemoteAttemptError { retryable: false, detail: ^detail } }
