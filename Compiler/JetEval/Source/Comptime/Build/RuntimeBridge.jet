// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1705
fn safe_name(name: String) -> String { name.chars().map(fn(c) { if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' } }).collect<String>() }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1717
fn build_error_jet_error(error: BuildError, span: Span) -> JetErr {
    jet_error := jet_err_with_identity(build_error_text(error), Ok("E3502"), Err(JetAbsent), "BuildError::{build_error_variant(error)}")
    jet_err_set_details(&jet_error, build_error_details(error, span))
    ^jet_error
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1728
fn build_error_value(error: BuildError, span: Span) -> CtValue { CtValue.from_jet_err(build_error_jet_error(error, span)) }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1732
fn build_error_diagnostic_from_value(error: CtValue, fallback_span: Span) -> Diagnostic? {
    jet_error := error.to_jet_err() ?? { return None }
    _ :: jet_err_details(jet_error) ?? { return None }
    report := jet_error_report(jet_error)
    span := report.details.and_then(fn(details) { details.source_span }).map_or(fallback_span, fn(span) { Span.new(span.start, span.end) })
    diagnostic := build_diag(report.message, span)
    diagnostic.structured = Val(StructuredDiagnostic.BuildError { report: ^report })
    Val(^diagnostic)
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1749
fn build_error_diag(error: BuildError, span: Span) -> Diagnostic {
    report := jet_error_report(build_error_jet_error(error, span))
    diagnostic := build_diag(report.message, span)
    diagnostic.structured = Val(StructuredDiagnostic.BuildError { report: ^report })
    ^diagnostic
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1756
fn build_error_variant(error: BuildError) -> String {
    error == {
        BuildError.EmptyTargetName -> "EmptyTargetName"; BuildError.EmptyActionName -> "EmptyActionName"; BuildError.EmptyToolchainName -> "EmptyToolchainName"
        BuildError.EmptySigningIdentityName -> "EmptySigningIdentityName"; BuildError.EmptyProbeName -> "EmptyProbeName"
        BuildError.DuplicateTargetName(_) -> "DuplicateTargetName"; BuildError.DuplicateActionName(_) -> "DuplicateActionName"
        BuildError.CompilerPackageDependencyMissing { .. } -> "CompilerPackageDependencyMissing"
        BuildError.DuplicateToolchainName(_) -> "DuplicateToolchainName"; BuildError.DuplicateSigningIdentityName(_) -> "DuplicateSigningIdentityName"
        BuildError.DuplicateProbeName(_) -> "DuplicateProbeName"; BuildError.EmptyPath -> "EmptyPath"; BuildError.InvalidPath(_) -> "InvalidPath"
        BuildError.EmptyToolchainTriple(_) -> "EmptyToolchainTriple"; BuildError.EmptyIdentityField(_) -> "EmptyIdentityField"
        BuildError.MissingLockedProvenance(_) -> "MissingLockedProvenance"; BuildError.EmptyProbeField(_) -> "EmptyProbeField"; BuildError.EmptyActionArgv(_) -> "EmptyActionArgv"
        BuildError.EmptyEnvName(_) -> "EmptyEnvName"; BuildError.UndeclaredEnvName { .. } -> "UndeclaredEnvName"
        BuildError.CachedActionWithoutOutputs(_) -> "CachedActionWithoutOutputs"; BuildError.PhonyActionWithoutCaps(_) -> "PhonyActionWithoutCaps"
        BuildError.PhonyActionWithOutputs(_) -> "PhonyActionWithOutputs"; BuildError.DuplicateActionOutput { .. } -> "DuplicateActionOutput"; BuildError.DuplicateBuildOutput { .. } -> "DuplicateBuildOutput"
        BuildError.UnknownTarget(_) -> "UnknownTarget"; BuildError.UnknownAction(_) -> "UnknownAction"; BuildError.UnknownToolchain(_) -> "UnknownToolchain"
        BuildError.UnknownSigningIdentity(_) -> "UnknownSigningIdentity"; BuildError.UnknownProbe(_) -> "UnknownProbe"
        BuildError.LegacyWrapperWithoutInputs(_) -> "LegacyWrapperWithoutInputs"; BuildError.LegacyWrapperWithoutOutputs(_) -> "LegacyWrapperWithoutOutputs"; BuildError.LegacyWrapperWithoutCaps(_) -> "LegacyWrapperWithoutCaps"
        BuildError.LegacyWrapperCommandMismatch { .. } -> "LegacyWrapperCommandMismatch"; BuildError.LegacyProjectFileMissing(_) -> "LegacyProjectFileMissing"; BuildError.LegacyProjectFileInvalid(_) -> "LegacyProjectFileInvalid"
        BuildError.PolicyDenied(_) -> "PolicyDenied"; BuildError.EmptyPluginField(_) -> "EmptyPluginField"; BuildError.InvalidPluginDigest(_) -> "InvalidPluginDigest"; BuildError.PackagedPlugin(_) -> "PackagedPlugin"
        BuildError.PluginVersionMismatch { .. } -> "PluginVersionMismatch"; BuildError.EmptyGeneratedModuleField(_) -> "EmptyGeneratedModuleField"; BuildError.InvalidGeneratedModulePath(_) -> "InvalidGeneratedModulePath"
        BuildError.DuplicateGeneratedModuleName(_) -> "DuplicateGeneratedModuleName"; BuildError.DuplicateGeneratedModulePath(_) -> "DuplicateGeneratedModulePath"; BuildError.GeneratedModuleCycle { .. } -> "GeneratedModuleCycle"
        BuildError.TargetDependencyCycle(_) -> "TargetDependencyCycle"; BuildError.ActionDependencyCycle(_) -> "ActionDependencyCycle"
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1809
fn build_error_details(error: BuildError, span: Span) -> JetErrorDetails {
    fields := error == {
        BuildError.EmptyTargetName | BuildError.EmptyActionName | BuildError.EmptyToolchainName | BuildError.EmptySigningIdentityName | BuildError.EmptyProbeName | BuildError.EmptyPath -> []
        BuildError.DuplicateTargetName(value) | BuildError.DuplicateActionName(value) | BuildError.DuplicateToolchainName(value)
        | BuildError.DuplicateSigningIdentityName(value) | BuildError.DuplicateProbeName(value) | BuildError.InvalidPath(value)
        | BuildError.EmptyToolchainTriple(value) | BuildError.EmptyIdentityField(value) | BuildError.MissingLockedProvenance(value)
        | BuildError.EmptyProbeField(value) | BuildError.EmptyActionArgv(value) | BuildError.EmptyEnvName(value)
        | BuildError.CachedActionWithoutOutputs(value) | BuildError.PhonyActionWithoutCaps(value) | BuildError.PhonyActionWithOutputs(value)
        | BuildError.LegacyProjectFileInvalid(value) | BuildError.EmptyPluginField(value) | BuildError.InvalidPluginDigest(value)
        | BuildError.PackagedPlugin(value) | BuildError.EmptyGeneratedModuleField(value) | BuildError.InvalidGeneratedModulePath(value)
        | BuildError.DuplicateGeneratedModuleName(value) | BuildError.DuplicateGeneratedModulePath(value) -> [build_error_text_field("value", value)]
        BuildError.CompilerPackageDependencyMissing { package, dependency } -> [build_error_text_field("package", package), build_error_text_field("dependency", dependency)]
        BuildError.UndeclaredEnvName { action, key } -> [build_error_text_field("action", action), build_error_text_field("key", key)]
        BuildError.DuplicateActionOutput { action, output } -> [build_error_text_field("action", action), build_error_text_field("output", output)]
        BuildError.DuplicateBuildOutput { output, first_action, second_action } -> [build_error_text_field("output", output), build_error_text_field("first_action", first_action), build_error_text_field("second_action", second_action)]
        BuildError.UnknownTarget(id) -> [build_error_number_field("id", id.0)]
        BuildError.UnknownAction(id) -> [build_error_number_field("id", id.0)]
        BuildError.UnknownToolchain(id) -> [build_error_number_field("id", id.0)]
        BuildError.UnknownSigningIdentity(id) -> [build_error_number_field("id", id.0)]
        BuildError.UnknownProbe(id) -> [build_error_number_field("id", id.0)]
        BuildError.LegacyWrapperWithoutInputs(kind) | BuildError.LegacyWrapperWithoutOutputs(kind) | BuildError.LegacyWrapperWithoutCaps(kind)
        | BuildError.LegacyProjectFileMissing(kind) -> [build_error_text_field("kind", kind.as_str())]
        BuildError.LegacyWrapperCommandMismatch { wrapper, actual } -> [build_error_text_field("wrapper", wrapper.as_str()), build_error_text_field("actual", actual)]
        BuildError.PolicyDenied(explanation) -> [
            build_error_text_field("subject", explanation.subject), build_error_bool_field("allowed", explanation.allowed), build_error_text_field("reason", explanation.reason),
            build_error_json_field("required_caps", "[" + explanation.required_caps.iter().map(fn(cap) { build_error_json_string(cap.name()) }).collect<[String]>().join(",") + "]"),
        ]
        BuildError.PluginVersionMismatch { plugin, expected, actual } -> [build_error_text_field("plugin", plugin), build_error_text_field("expected", expected), build_error_text_field("actual", actual)]
        BuildError.GeneratedModuleCycle { module, path } -> [build_error_text_field("module", module), build_error_text_field("path", path)]
        BuildError.TargetDependencyCycle(cycle) | BuildError.ActionDependencyCycle(cycle) ->
            [build_error_json_field("nodes", "[" + cycle.nodes().iter().map(build_error_json_string).collect<[String]>().join(",") + "]")]
    }
    JetErrorDetails { variant: build_error_variant(error), fields: ^fields, source_span: Val(JetErrorSpan { start: span.start, end: span.end }) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1936
fn build_error_text_field(name: String, value: String) -> JetErrorField { build_error_json_field(name, build_error_json_string(value)) }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1940
fn build_error_number_field(name: String, value: USize) -> JetErrorField { build_error_json_field(name, value.to_string()) }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1944
fn build_error_bool_field(name: String, value: Bool) -> JetErrorField { build_error_json_field(name, value.to_string()) }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1948
fn build_error_json_field(name: String, value: String) -> JetErrorField { JetErrorField { name, value: ^value } }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1955
fn build_error_json_string(value: String) -> String {
    out := String.with_capacity(value.len() + 2)
    out.push('"')
    for ch in value.chars() {
        ch == {
            '\\' -> out += "\\\\"; '"' -> out += "\\\""; '\n' -> out += "\\n"; '\r' -> out += "\\r"; '\t' -> out += "\\t"
            ch if ch.is_control() -> out += "\\u{ch as U32:04x}"
            ch -> out.push(ch)
        }
    }
    out.push('"')
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1973
fn build_error_text(error: BuildError) -> String {
    error == {
        BuildError.DuplicateTargetName(name) -> "target name `{name}` is registered twice"
        BuildError.DuplicateActionName(name) -> "action name `{name}` is registered twice"
        BuildError.CompilerPackageDependencyMissing { package, dependency } -> "compiler package `{package}` depends on missing package artifact `{dependency}`"
        BuildError.DuplicateToolchainName(name) -> "toolchain name `{name}` is registered twice"
        BuildError.DuplicateProbeName(name) -> "probe name `{name}` is registered twice"
        BuildError.InvalidPath(path) -> "build path `{path}` must be relative and stay inside the project"
        BuildError.LegacyProjectFileMissing(kind) -> "legacy {kind.as_str()} import requires `{kind.project_file()}` in the project root"
        BuildError.LegacyProjectFileInvalid(path) -> "legacy project file `{path}` must be a readable regular file"
        BuildError.UndeclaredEnvName { action, key } -> "action `{action}` allowlists undeclared environment variable `{key}`"
        BuildError.PackagedPlugin(message) -> "packaged build plugin rejected: {message}"
        BuildError.InvalidPluginDigest(message) -> "build plugin component digest is invalid: {message}"
        BuildError.CachedActionWithoutOutputs(name) -> "cached action `{name}` declares no outputs"
        BuildError.PhonyActionWithoutCaps(name) -> "uncached action `{name}` declares no abilities"
        BuildError.DuplicateBuildOutput { output, first_action, second_action } -> "output `{output}` is owned by both `{first_action}` and `{second_action}`"
        BuildError.DuplicateGeneratedModuleName(name) -> "E3511: generation rounds form a cycle: module `{name}` is generated twice"
        BuildError.DuplicateGeneratedModulePath(path) -> "E3511: generation rounds form a cycle: path `{path}` is generated twice"
        BuildError.GeneratedModuleCycle { module, path } -> "E3511: generation rounds form a cycle: `{module}` and `{path}` have two producers"
        BuildError.TargetDependencyCycle(cycle) -> dependency_cycle_text("target", cycle)
        BuildError.ActionDependencyCycle(cycle) -> dependency_cycle_text("action", cycle)
        other -> "{other:?}"
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:2035
fn build_diag(detail: String, span: Span) -> Diagnostic {
    if generation_detail := detail.strip_prefix("E3511: ") {
        text := generation_detail // #4303
        return Diagnostic.error("E3511", "build plan is invalid: {text}", "generated source must reach a bounded deterministic order, not loop until quiescent",
            "break the dependency between these generators or give each generated module one owner", Val(span))
    }
    Diagnostic.error("E3502", "build plan is invalid: {detail}", "`fn build` must return one deterministic typed graph whose handles all belong to that build",
        "fix the named target/action/toolchain/probe and run `jet inspect explain-build` to inspect the graph", Val(span))
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:2056
fn build_project_error(code: String, what: String, why: String, fix: String, span: Span?) -> Diagnostic Err! { Diagnostic.project_error(code, what, why, fix, span)? }
