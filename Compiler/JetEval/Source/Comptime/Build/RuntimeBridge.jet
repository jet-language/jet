PROGRAM_BUILD_SESSIONS :: ThreadLocal<RefCell<[U64:ProgramBuildSession]>>.new(fn() { RefCell.new([:]) })
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:42
PROGRAM_BUILD_EXECUTION_RECEIPTS :: ThreadLocal<RefCell<[(BuildGraph, BuildExecutionReport)]>>.new(fn() { RefCell.new([]) })
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:48
fn begin_program_build(package: String, program: CtValue) -> CtValue { begin_program_build_with_policy(package, ^program, BuildPolicy.local_default()) }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:55
fn begin_program_build_with_policy(package: String, program: CtValue, policy: BuildPolicy) -> CtValue {
    begin_program_build_with_policy_at(package, ^program, ^policy, OSPath.new("."))
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:66
fn begin_program_build_with_policy_at(package: String, program: CtValue, policy: BuildPolicy, project_root: OSPath) -> CtValue {
    context := BuildContext.new_with_policy(^policy)
    id := context.context
    PROGRAM_BUILD_SESSIONS.with(fn(sessions) {
        sessions.borrow_mut().insert(id, ProgramBuildSession { context: ^context, package, project_root: project_root.to_path_buf(), diagnostics: [], last_span: Span.new(0, 0) })
    })
    CtValue.Struct { type_name: Syntax.TYPE_BUILD_CONTEXT.to_string(), fields: [("__session", CtValue.Int(id as I64)), ("program", ^program)] }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:95
fn abort_program_build(context: CtValue) {
    if id := build_session_id(context) { PROGRAM_BUILD_SESSIONS.with(fn(sessions) { _ :: sessions.borrow_mut().remove(id) }) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:103
fn finish_program_build(context: CtValue, returned: CtValue) -> (BuildPlan, [Diagnostic]) Diagnostic! {
    id := build_session_id(context) ?? { fail build_diag("lost build context", Span.new(0, 0)) }
    default := returned_handle(returned, Syntax.TYPE_BUILD_PLAN).and_then(fn(_, target) { if target >= 0 { Val(target as USize) } else { None } })
    session := PROGRAM_BUILD_SESSIONS.with(fn(sessions) { sessions.borrow_mut().remove(id) }) ?? { fail build_diag("build context expired", Span.new(0, 0)) }
    plan := (default == {
        Val(target) -> session.context.plan_with_default(TargetRef { id: TargetId(target), context: id })
        None -> session.context.plan()
    }) catch { error -> fail build_error_diag(error, session.last_span) }
    (^plan, ^session.diagnostics)
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:134
fn install_build_execution_receipt(plan: BuildPlan, execution: BuildExecutionReport) {
    if !execution.events.iter().any(fn(event) { event == { BuildExecutionEvent.Finished { .. } -> true; _ -> false } }) { return }
    graph := plan.graph()
    PROGRAM_BUILD_EXECUTION_RECEIPTS.with(fn(receipts) {
        rows := receipts.borrow_mut()
        rows.retain(fn(known, _) { known != graph })
        rows.push((^graph, execution.clone()))
        excess := rows.len().saturating_sub(8)
        if excess != 0 { _ :: rows.drain(..excess) }
    })
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:158
fn execution_receipt_for_graph(graph: BuildGraph) -> BuildExecutionReport? {
    PROGRAM_BUILD_EXECUTION_RECEIPTS.with(fn(receipts) { receipts.borrow().iter().rev().find(fn(known, _) { known == graph }).map(fn(_, execution) { execution.clone() }) })
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:172
fn graph_for_build_query(plan: BuildPlan, execution: BuildExecutionReport?) -> BuildGraph {
    if report := execution { return plan.graph_with_execution(Val(report)) }
    static_graph := plan.graph()
    ambient := execution_receipt_for_graph(static_graph)
    plan.graph_with_execution(ambient)
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:186
fn eval_build_graph(plan: CtValue, span: Span) -> CtValue Diagnostic! {
    (session_id, target_id) := returned_handle(plan, Syntax.TYPE_BUILD_PLAN) ?? { fail build_query_diag("argument 1 must be a BuildPlan returned by this build", span) }
    graph := PROGRAM_BUILD_SESSIONS.with(fn(sessions) -> BuildGraph Diagnostic! {
        rows := sessions.borrow()
        session := rows.get(session_id) ?? { fail build_query_diag("build context expired", span) }
        plan := (if target_id >= 0 { session.context.plan_with_default(TargetRef { id: TargetId(target_id as USize), context: session_id }) } else { session.context.plan() })
            catch { error -> fail build_error_diag(error, span) }
        graph_for_build_query(plan, None)
    })?
    build_graph_value(graph)
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:219
fn eval_build_receipt_diff(before: CtValue, after: CtValue, span: Span) -> CtValue Diagnostic! {
    before_graph := build_graph_from_value(before, span)?
    after_graph := build_graph_from_value(after, span)?
    build_graph_diff_value(before_graph.diff(after_graph))
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:229
fn build_query_diag(detail: String, span: Span) -> Diagnostic {
    Diagnostic.error("E3502", "build graph query failed: {detail}", "core.build exposes only canonical checked BuildPlan facts", "pass a BuildPlan or BuildGraph returned by this build", Val(span))
}
