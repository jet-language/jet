// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1443
fn fact_value_arg(value: CtValue, span: Span) -> FactValue Diagnostic! {
    value == {
        CtValue.Bool(value) -> FactValue.Bool(value); CtValue.Int(value) -> FactValue.Int(value); CtValue.Char(value) -> FactValue.Char(value)
        CtValue.Str(value) -> FactValue.Text(value.clone()); CtValue.Enum { variant, args, .. } if args.is_empty() -> FactValue.Enum(variant.clone())
        _ -> { fail build_diag("`b.contribute` accepts only Bool, Int, Char, String, or a fieldless enum value", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1467
fn validate_legacy_import_contract(declared: LegacyWrapperSpec, imported: LegacyWrapperSpec, span: Span) -> Unit Diagnostic! {
    if declared.argv != imported.argv { fail build_diag("legacy wrapper argv does not match its canonical project-file import", span) }
    declared_inputs := declared.inputs.iter().cloned().collect<Set<String>>()
    imported_inputs := imported.inputs.iter().cloned().collect<Set<String>>()
    if declared_inputs != imported_inputs { fail build_diag("legacy wrapper inputs must exactly match its canonical project-file import", span) }
    declared_outputs := declared.outputs.iter().cloned().collect<Set<String>>()
    imported_outputs := imported.outputs.iter().cloned().collect<Set<String>>()
    if declared_outputs != imported_outputs { fail build_diag("legacy wrapper outputs must exactly match its canonical project-file import", span) }
    if declared.caps != imported.caps { fail build_diag("legacy wrapper abilities must exactly match its canonical project-file import", span) }
    if declared.env != imported.env { fail build_diag("legacy wrapper environment does not match its canonical project-file import", span) }
    if declared.env_allowlist != imported.env_allowlist { fail build_diag("legacy wrapper environment allowlist must exactly match its canonical project-file import", span) }
    if declared.resource_pools != imported.resource_pools { fail build_diag("legacy wrapper resource pools must exactly match its canonical project-file import", span) }
    if imported.cache != ActionCache.Cached && declared.cache != imported.cache { fail build_diag("legacy wrapper cache policy does not match its canonical project-file import", span) }
    if imported.action_kind != ActionKind.Generic && declared.action_kind != imported.action_kind { fail build_diag("legacy wrapper action kind does not match its canonical project-file import", span) }
}
