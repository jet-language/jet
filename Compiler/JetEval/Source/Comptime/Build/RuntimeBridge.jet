}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1677
fn string_list_arg(args: [CtValue], index: USize, span: Span) -> [String] Diagnostic! {
    values := args.get(index) == { Val(CtValue.List(values)) -> values; _ -> { fail build_diag("argument {index + 1} must be [String]", span) } }
    result := [String]()
    for value in values { result.push(value == { CtValue.Str(text) -> text.clone(); _ -> { fail build_diag("argument {index + 1} must be [String]", span) } }) }
    ^result
}
