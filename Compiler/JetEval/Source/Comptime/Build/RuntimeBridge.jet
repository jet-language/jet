// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:534
fn graph_payload(value: CtValue) -> CtValue { value == { CtValue.Present(inner) -> inner; _ -> value } }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:541
fn graph_struct_fields(value: CtValue, type_name: String, span: Span) -> [(String, CtValue)] Diagnostic! {
    graph_payload(value) == { CtValue.Struct { type_name: actual, fields } if actual == type_name -> fields; _ -> { fail build_query_diag("value must be a `{type_name}`", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:558
fn graph_field(fields: [(String, CtValue)], name: String, span: Span) -> CtValue Diagnostic! {
    fields.iter().find_map(fn(field, value) { if field == name { Val(value) } else { None } }) ?? { fail build_query_diag("`{name}` is missing", span) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:569
fn graph_list_value(value: CtValue, name: String, span: Span) -> [CtValue] Diagnostic! {
    graph_payload(value) == { CtValue.List(values) -> values; _ -> { fail build_query_diag("`{name}` must be a list", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:580
fn graph_int(value: CtValue, name: String, span: Span) -> I64 Diagnostic! {
    graph_payload(value) == { CtValue.Int(item) -> item; _ -> { fail build_query_diag("`{name}` must be an Int", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:587
// GATE #4483: selected-target USize conversion rejects negative and overflowing ids.
fn graph_id(value: CtValue, name: String, span: Span) -> USize Diagnostic! {
    USize.try_from(graph_int(value, name, span)?) catch { _ -> fail build_query_diag("`{name}` must be a non-negative id", span) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:593
fn graph_string(value: CtValue, name: String, span: Span) -> String Diagnostic! {
    graph_payload(value) == { CtValue.Str(item) -> item.clone(); _ -> { fail build_query_diag("`{name}` must be a String", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:600
fn graph_bool(value: CtValue, name: String, span: Span) -> Bool Diagnostic! {
    graph_payload(value) == { CtValue.Bool(item) -> item; _ -> { fail build_query_diag("`{name}` must be a Bool", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:607
fn graph_strings(value: CtValue, name: String, span: Span) -> [String] Diagnostic! {
    result := [String]()
    for item in graph_list_value(value, name, span)? { result.push(graph_string(item, name, span)?) }
    ^result
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:618
fn graph_ids(value: CtValue, name: String, span: Span) -> [USize] Diagnostic! {
    result := [USize]()
    for item in graph_list_value(value, name, span)? { result.push(graph_id(item, name, span)?) }
    ^result
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:625
fn graph_optional_int(value: CtValue, name: String, span: Span) -> USize? Diagnostic! {
    value == { CtValue.Failed(CtReport.Clean(_)) -> None; CtValue.Present(item) -> Val(graph_id(item, name, span)?); _ -> { fail build_query_diag("`{name}` must be an optional Int", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:638
fn graph_optional_bool(value: CtValue, name: String, span: Span) -> Bool? Diagnostic! {
    value == { CtValue.Failed(CtReport.Clean(_)) -> None; CtValue.Present(item) -> Val(graph_bool(item, name, span)?); _ -> { fail build_query_diag("`{name}` must be an optional Bool", span) } }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:650
fn graph_target_kind(value: String) -> TargetKind { value == { "Executable" | "executable" -> TargetKind.Executable; "Test" | "test" -> TargetKind.Test; _ -> TargetKind.Library } }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:658
fn graph_action_kind(value: String) -> ActionKind {
    value == { "compile" | "Compile" -> ActionKind.Compile; "docs" | "Docs" -> ActionKind.Docs; "debug" | "Debug" -> ActionKind.Debug; "source-archive" | "SourceArchive" -> ActionKind.SourceArchive; _ -> ActionKind.Generic }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:668
fn build_graph_from_value(value: CtValue, span: Span) -> BuildGraph Diagnostic! {
    fields := graph_struct_fields(value, Syntax.TYPE_BUILD_GRAPH, span)?
    targets := [BuildGraphTarget]()
    for value in graph_list_value(graph_field(fields, "targets", span)?, "targets", span)? {
        row := graph_struct_fields(value, Syntax.TYPE_BUILD_GRAPH_TARGET, span)?
        id := TargetId(graph_id(graph_field(row, "id", span)?, "id", span)?)
        name := graph_string(graph_field(row, "name", span)?, "name", span)?
        kind := graph_target_kind(graph_string(graph_field(row, "kind", span)?, "kind", span)?)
        deps := graph_ids(graph_field(row, "deps", span)?, "deps", span)?.into_iter().map(TargetId).collect<[TargetId]>()
        actions := graph_ids(graph_field(row, "actions", span)?, "actions", span)?.into_iter().map(ActionId).collect<[ActionId]>()
        files := graph_strings(graph_field(row, "files", span)?, "files", span)?
        plugin := graph_optional_int(graph_field(row, "plugin", span)?, "plugin", span)?.map(PluginId)
        targets.push(BuildGraphTarget { id, name: ^name, kind, deps: ^deps, actions: ^actions, files: ^files, plugin })
    }
    actions := [BuildGraphAction]()
    for value in graph_list_value(graph_field(fields, "actions", span)?, "actions", span)? {
        row := graph_struct_fields(value, Syntax.TYPE_BUILD_GRAPH_ACTION, span)?
        id := ActionId(graph_id(graph_field(row, "id", span)?, "id", span)?)
        name := graph_string(graph_field(row, "name", span)?, "name", span)?
        kind := graph_action_kind(graph_string(graph_field(row, "kind", span)?, "kind", span)?)
        inputs := graph_strings(graph_field(row, "inputs", span)?, "inputs", span)?
        outputs := graph_strings(graph_field(row, "outputs", span)?, "outputs", span)?
        target := graph_optional_int(graph_field(row, "target", span)?, "target", span)?.map(TargetId)
        plugin := graph_optional_int(graph_field(row, "plugin", span)?, "plugin", span)?.map(PluginId)
        compiler_owned := graph_bool(graph_field(row, "compiler_owned", span)?, "compiler_owned", span)?
        key := ActionKey.new(graph_string(graph_field(row, "key", span)?, "key", span)?)
        cache_hit := graph_optional_bool(graph_field(row, "cache_hit", span)?, "cache_hit", span)?
        actions.push(BuildGraphAction { id, name: ^name, kind, inputs: ^inputs, outputs: ^outputs, target, caps: [], pools: [], legacy_wrapper: None, plugin, compiler_owned, key: ^key, cache_hit })
    }
    files := [BuildGraphFile]()
    for value in graph_list_value(graph_field(fields, "files", span)?, "files", span)? {
        row := graph_struct_fields(value, Syntax.TYPE_BUILD_GRAPH_FILE, span)?
        path := graph_string(graph_field(row, "path", span)?, "path", span)?
        owner := graph_optional_int(graph_field(row, "owner", span)?, "owner", span)?.map(ActionId)
        consumers := graph_ids(graph_field(row, "consumers", span)?, "consumers", span)?.into_iter().map(ActionId).collect<[ActionId]>()
        target_ids := graph_ids(graph_field(row, "targets", span)?, "targets", span)?.into_iter().map(TargetId).collect<[TargetId]>()
        files.push(BuildGraphFile { path: ^path, owner, consumers: ^consumers, targets: ^target_ids })
    }
    BuildGraph { targets: ^targets, actions: ^actions, files: ^files, nodes: [] }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:784
fn eval_program_build_method(receiver: CtValue, method: String, args: [CtValue], generated_source: String?, span: Span, in_impure_gate: Bool) -> (CtValue Diagnostic!)? {
    id := build_session_id(receiver) ?? { return None }
    Val(PROGRAM_BUILD_SESSIONS.with(fn(sessions) -> CtValue Diagnostic! {
        rows := sessions.borrow_mut()
        session := rows.get_mut(id) ?? { fail build_diag("build context expired", span) }
        session.last_span = span
        eval_session_method(id, &session, method, ^args, generated_source, span, in_impure_gate)?
    }))
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:812
fn eval_program_build_input_method(receiver: CtValue, method: String, args: [CtValue], first_string_literal: String?, base_dir: OSPath, embed_inputs: &[ComptimeInput]?, span: Span) -> (CtValue Diagnostic!)? {
    _ :: build_session_id(receiver) ?? { return None }
    method == {
        "find" -> Val((fn() -> CtValue Diagnostic! {
            if args.len() != 1 { fail build_diag("`b.find` requires exactly one glob", span) }
            builtin := Syntax.BUILTIN_FIND
            glob := first_string_literal ?? { fail embed_path_err(builtin, "literal", span) }
            checked := check_literal_embed_path(builtin, glob, span)?
            eval_locked_find(base_dir, checked, embed_inputs, span)?
        })())
        "embed" -> Val(eval_build_embed(args, base_dir, embed_inputs, span))
