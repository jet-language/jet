fn build_session_id(value: CtValue) -> U64? {
    value == {
        CtValue.Struct { type_name, fields } if type_name == Syntax.TYPE_BUILD_CONTEXT ->
            fields.iter().find_map(fn(name, value) { (name, value) == { ("__session", CtValue.Int(id)) if id >= 0 -> Val(id as U64); _ -> None } })
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1564
fn returned_handle(value: CtValue, type_name: String) -> (U64, I64)? {
    graph_payload(value) == {
        CtValue.Struct { type_name: actual, fields } if actual == type_name -> {
            session := fields.iter().find_map(fn(n, v) { (n, v) == { ("session", CtValue.Int(id)) -> Val(id as U64); _ -> None } }) ?? { return None }
            id := fields.iter().find_map(fn(n, v) { (n, v) == { ("id", CtValue.Int(id)) -> Val(id); _ -> None } }) ?? { return None }
            Val((session, id))
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1590
fn handle_value(type_name: String, session: U64, id: USize) -> CtValue {
    CtValue.Struct { type_name, fields: [("session", CtValue.Int(session as I64)), ("id", CtValue.Int(id as I64))] }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1600
fn handle_arg(args: [CtValue], index: USize, ty: String, session: U64, span: Span) -> USize Diagnostic! {
    args.get(index).and_then(fn(v) { returned_handle(v, ty) }) == {
        Val((actual, id)) if actual == session && id >= 0 -> id as USize
        _ -> { fail build_diag("argument {index + 1} must be a `{ty}` from this build", span) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1616
fn handle_list_arg(args: [CtValue], index: USize, ty: String, session: U64, span: Span) -> [USize] Diagnostic! {
    values := args.get(index) == { Val(CtValue.List(values)) -> values; _ -> { fail build_diag("argument {index + 1} must be a list", span) } }
    ids := [USize]()
    for value in values { ids.push(handle_arg(core.slice.from_ref(value), 0, ty, session, span)?) }
