fn build_graph_target_value(target: BuildGraphTarget) -> CtValue {
    graph_struct(Syntax.TYPE_BUILD_GRAPH_TARGET, [
        ("id", CtValue.Int(target.id.0 as I64)), ("name", CtValue.Str(target.name.clone())), ("kind", CtValue.Str("{target.kind:?}")),
        ("deps", graph_list(target.deps.iter().map(fn(id) { CtValue.Int(id.0 as I64) }))),
        ("actions", graph_list(target.actions.iter().map(fn(id) { CtValue.Int(id.0 as I64) }))),
        ("files", graph_list(target.files.iter().cloned().map(CtValue.Str))), ("plugin", graph_option_int(target.plugin.map(fn(id) { id.0 }))),
    ])
}
