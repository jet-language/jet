// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:1645
fn source_span_arg(args: [CtValue], index: USize, span: Span) -> Span Diagnostic! {
    fields := args.get(index) == {
        Val(CtValue.Struct { type_name, fields }) if type_name == Syntax.TYPE_SOURCE_SPAN -> fields
        _ -> { fail build_diag("custom build diagnostics require a source span", span) }
    }
    value := fn(name: String) { fields.iter().find_map(fn(field, value) { (field, value) == { (actual, CtValue.Int(value)) if actual == name && value >= 0 -> Val(value as USize); _ -> None } }) }
