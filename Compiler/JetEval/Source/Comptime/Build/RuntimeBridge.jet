//RS     declared: &LegacyWrapperSpec,
//RS     imported: &LegacyWrapperSpec,
//RS     span: Span,
//RS ) -> Result<(), Diagnostic> {
//RS     if declared.argv != imported.argv {
//RS         return Err(build_diag(
//RS             "legacy wrapper argv does not match its canonical project-file import",
//RS             span,
//RS         ));
//RS     }
//RS     let declared_inputs = declared
//RS         .inputs
//RS         .iter()
//RS         .cloned()
//RS         .collect::<std::collections::BTreeSet<_>>();
//RS     let imported_inputs = imported
//RS         .inputs
//RS         .iter()
//RS         .cloned()
//RS         .collect::<std::collections::BTreeSet<_>>();
//RS     if declared_inputs != imported_inputs {
//RS         return Err(build_diag(
//RS             "legacy wrapper inputs must exactly match its canonical project-file import",
//RS             span,
//RS         ));
//RS     }
//RS     let declared_outputs = declared
//RS         .outputs
//RS         .iter()
//RS         .cloned()
//RS         .collect::<std::collections::BTreeSet<_>>();
//RS     let imported_outputs = imported
//RS         .outputs
//RS         .iter()
//RS         .cloned()
//RS         .collect::<std::collections::BTreeSet<_>>();
//RS     if declared_outputs != imported_outputs {
//RS         return Err(build_diag(
//RS             "legacy wrapper outputs must exactly match its canonical project-file import",
//RS             span,
//RS         ));
//RS     }
//RS     if declared.caps != imported.caps {
//RS         return Err(build_diag(
//RS             "legacy wrapper abilities must exactly match its canonical project-file import",
//RS             span,
//RS         ));
//RS     }
//RS     if declared.env != imported.env {
