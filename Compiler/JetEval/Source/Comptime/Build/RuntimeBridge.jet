fn graph_option(value: CtValue?, element_type: Type) -> CtValue { value == { None -> CtValue.absent(element_type); Val(item) -> CtValue.Present(Box.new(^item)) } }
// Rust: crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs:261
