    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:235
    pub fn add_compiler_package_actions(self: &BuildPlan, packages: &[CompilerPackageSpec], compiler_identity: &String, target: &String, profile: &String) -> [ActionHandle] BuildError! {
        if packages.is_empty() { return [] }
        if packages.len() > MAX_ACTIONS.saturating_sub(self.actions.len()) { fail BuildError.PackagedPlugin("action graph exceeds {MAX_ACTIONS} actions") }
        target_id := self.default.map(fn(t) { t.id }).or_else(fn() { self.targets.first().map(fn(t) { t.id }) }) == {
            Val(id) -> id; None -> { fail BuildError.UnknownTarget(TargetId(0)) }
        }
        if self.targets.get(target_id.0).is_none() { fail BuildError.UnknownTarget(target_id) }
        toolchain_id := self.toolchains.first().map(fn(t) { t.id }) == { Val(id) -> id; None -> { fail BuildError.UnknownToolchain(ToolchainId(0)) } }
        output_by_package: [String:BuildPath] = [:]
        package_by_output: [BuildPath:String] = [:]
        dependencies_by_package: [String:BTreeSet<String>] = [:]
        for package in packages {
            trimmed := package.name.trim() // #4303
            if trimmed.is_empty() { fail BuildError.EmptyActionName }
            if output_by_package.contains_key(&package.name) { fail BuildError.DuplicateActionName("compile-package:{package.name}") }
            output := BuildPath.new(".jet/package-artifacts/{compiler_package_path_name(&package.name)}.sealed")?
            if previous := package_by_output.insert(output.clone(), package.name.clone()) {
                fail BuildError.DuplicateActionName("compile-package:{package.name} (output also belongs to {previous})")
            }
            output_by_package.insert(package.name.clone(), ^output)
            dependencies_by_package.insert(package.name.clone(), package.dependencies.iter().cloned().collect::<BTreeSet<String>>())
        }
        for package in packages {
            action_name := "compile-package:{package.name}"
            if self.actions.iter().any(fn(a) { a.name == action_name }) { fail BuildError.DuplicateActionName(^action_name) }
            output := output_by_package.get(&package.name) == {
                Val(o) -> o
                None -> { fail BuildError.CompilerPackageDependencyMissing { package: package.name.clone(), dependency: package.name.clone() } }
            }
            if existing := self.actions.iter().find(fn(a) { a.outputs.iter().any(fn(o) { o == output }) }) {
                fail BuildError.DuplicateBuildOutput { output: output.as_str().to_string(), first_action: existing.name.clone(), second_action: ^action_name }
            }
            if module := self.generated_modules.iter().find(fn(m) { m.path == output }) {
                fail BuildError.GeneratedModuleCycle { module: module.name.clone(), path: output.as_str().to_string() }
            }
        }
        package_names := dependencies_by_package.keys().collect::<[&String]>()
        package_names.sort()
        for package in package_names {
            for dependency in &dependencies_by_package[package] {
                if !output_by_package.contains_key(dependency) { fail BuildError.CompilerPackageDependencyMissing { package: package.clone(), dependency: dependency.clone() } }
            }
        }
        remaining := dependencies_by_package.keys().cloned().collect::<BTreeSet<String>>()
        while !remaining.is_empty() {
            ready := remaining.iter().filter(fn(package) {
                dependencies_by_package.get(package).expect("compiler package dependency preflight").iter().all(fn(dep) { !remaining.contains(dep) })
            }).cloned().collect::<[String]>()
            if ready.is_empty() {
                fail BuildError.ActionDependencyCycle(stalled_cycle(&remaining,
                    fn(package) { dependencies_by_package.get(package).map(fn(deps) { deps.iter().cloned().collect::<[String]>() }).unwrap_or([]) },
                    fn(package) { "compile-package:{package}" }))
            }
            for package in ready { _ :: remaining.remove(&package) }
        }
        handles: [ActionHandle] = []
        for package in packages {
            inputs := dependencies_by_package[&package.name].iter().map(fn(dependency) {
                output_by_package.get(dependency).cloned().expect("compiler package dependency output preflight")
            }).collect::<[BuildPath]>()
            output := output_by_package.get(&package.name).cloned().expect("compiler package output preflight")
            id := ActionId(self.actions.len())
            labels: [String:String] = [
                "compiler.owner": "jet", "compiler.package": package.name.clone(),
                "compiler.source-digest": package.source_digest.as_str().to_string(),
                "compiler.identity": compiler_identity.clone(), "compiler.target": target.clone(), "compiler.profile": profile.clone()]
            self.actions.push(BuildAction {
                id: id, name: "compile-package:{package.name}", inputs: ^inputs, outputs: [^output],
                argv: ["jet-compiler", package.name.clone()], env: [:], env_allowlist: BTreeSet<String>.new(),
                caps: BTreeSet<BuildCapability>.new(), cache: ActionCache.Cached, kind: ActionKind.Compile,
                toolchain: ToolchainHandle { id: toolchain_id, context: self.context }, probes: [], signing_identity: None,
                labels: ^labels, helper_versions: [:], resource_pools: BTreeSet<BuildResourcePool>.new(),
                legacy_wrapper: None, plugin: None, variant_identity: None, compiler_owned: true })
            handle := ActionHandle { id: id, context: self.context }
            self.targets[target_id.0].actions.push(handle)
            handles.push(handle)
        }
        handles
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:447
    pub fn action_key(self: &BuildPlan, action: ActionHandle) -> ActionKey BuildError! { self.action_key_with_inputs(action, &[])? }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:453
    pub fn complete_recipe_fingerprint(self: &BuildPlan) -> String BuildError! {
        keys: [String] = []
        for action in &self.actions { keys.push(self.action_key(ActionHandle { id: action.id, context: self.context })?.as_str().to_string()) }
        keys.sort()
        bytes: [U8] = []
        bytes.extend_from_slice("jet.plan-fingerprint.v1".as_bytes())
        bytes.push(0)
        for key in keys { bytes.extend_from_slice(key.as_bytes()); bytes.push(0) }
        "plan-sha256:{SHA256.sha256_hex(&bytes)}"
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:472
    pub fn action_key_with_inputs(self: &BuildPlan, action: ActionHandle, inputs: &[ActionInputSnapshot]) -> ActionKey BuildError! {
        if action.context != self.context { fail BuildError.UnknownAction(action.id) }
        a := self.actions.get(action.id.0) == { Val(a) -> a; None -> { fail BuildError.UnknownAction(action.id) } }
        canonical_action_key(self, a, inputs)
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:487
    pub fn effective_action_key(self: &BuildPlan, action: ActionHandle, inputs: &[ActionInputSnapshot], grants: &BTreeSet<BuildCapability>, executable: &OSPath, executable_digest: &ContentDigest, probe_facts: &[BuildProbeFact]) -> ActionKey BuildError! {
        a := self.action(action) == { Val(a) -> a; None -> { fail BuildError.UnknownAction(action.id) } }
        canonical_effective_action_key(self, a, inputs, grants, executable, executable_digest, probe_facts)
    }
