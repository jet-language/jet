    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:534
    pub fn targets_by_kind(self: &BuildPlan, kind: TargetKind) -> [&BuildTarget] { self.targets.iter().filter(fn(t) { t.kind == kind }).collect() }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:538
    pub fn phony_actions(self: &BuildPlan) -> [&BuildAction] { self.actions.iter().filter(fn(a) { a.cache == ActionCache.UncachedPhony }).collect() }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:545
    pub fn resource_pools(self: &BuildPlan) -> [BuildResourcePoolSpec] {
        pools := default_resource_pools()
        custom_pools: [BuildResourcePoolSpec] = []
        for action in &self.actions {
            for pool in action_pools(action) {
                if !pools.iter().any(fn(spec) { spec.pool.as_str() == pool.as_str() }) {
                    // Without declared capacity, custom pools serialize deterministically.
                    custom_pools.push(BuildResourcePoolSpec.new(^pool, 1))
                }
            }
        }
        custom_pools.sort_by(fn(left, right) { left.pool.as_str().cmp(right.pool.as_str()) })
        pools.extend(^custom_pools)
        pools
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:565
    pub fn graph(self: &BuildPlan) -> BuildGraph {
        action_targets := self.action_targets()
        file_index := self.file_index(&action_targets)
        targets := self.targets.iter().map(fn(target) {
            BuildGraphTarget { id: target.id, name: target.name.clone(), kind: target.kind,
                deps: target.deps.iter().map(fn(dep) { dep.id }).collect(),
                actions: target.actions.iter().map(fn(action) { action.id }).collect(),
                files: target.sources.iter().chain(target.inputs.iter()).chain(target.outputs.iter()).map(fn(path) { path.as_str().to_string() }).collect(),
                plugin: target.plugin.map(fn(plugin) { plugin.id }) }
        }).collect::<[BuildGraphTarget]>()
        actions := self.actions.iter().map(fn(action) {
            BuildGraphAction { id: action.id, name: action.name.clone(), kind: action.kind,
                inputs: action.inputs.iter().map(fn(path) { path.as_str().to_string() }).collect(),
                outputs: action.outputs.iter().map(fn(path) { path.as_str().to_string() }).collect(),
                target: action_targets.get(&action.id).copied(), caps: action.caps.iter().cloned().collect(),
                pools: action_pools(action), legacy_wrapper: action.legacy_wrapper, plugin: action.plugin.map(fn(p) { p.id }),
                compiler_owned: action.compiler_owned, key: canonical_action_key(self, action, &[]), cache_hit: None }
        }).collect::<[BuildGraphAction]>()
        paths := file_index.keys().collect::<[&String]>()
        paths.sort()
        files := paths.iter().map(fn(path) {
            o := &file_index[path]
            BuildGraphFile { path: path.clone(), owner: o.owner, consumers: o.consumers.clone(), targets: o.targets.clone() }
        }).collect::<[BuildGraphFile]>()
        BuildGraph { targets: ^targets, actions: ^actions, files: ^files, nodes: self.compiler_nodes.clone() }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:630
    pub fn graph_with_execution(self: &BuildPlan, execution: &BuildExecutionReport?) -> BuildGraph {
        graph := self.graph()
        report := execution == { Val(report) -> report; None -> { return graph } }
        statuses: [ActionId:Bool] = [:]
        for event in &report.events {
            event == { Finished { action, outcome } -> { statuses.insert(action, outcome == { RestoredFromCache -> true; _ -> false }) }; _ -> {} }
        }
        for action in &graph.actions { action.cache_hit = statuses.get(&action.id).copied() }
        graph
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:655
    pub fn file_ownership(self: &BuildPlan, path: &String) -> FileOwnership {
        files := self.file_index(&self.action_targets())
        files.remove(path).unwrap_or(FileOwnership { path: path.clone(), owner: None, consumers: [], targets: [] })
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:667
    pub fn explain_target(self: &BuildPlan, target: impl Into<TargetRef>) -> BuildExplanation? {
        t := self.target(target)?
        Val(BuildExplanation { subject: BuildGraphSubject.Target(t.id), label: t.name.clone(),
            provenance: [format!("kind={:?}", t.kind), "sources={t.sources.len()}", "deps={t.deps.len()}", "actions={t.actions.len()}"] })
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:681
    pub fn explain_target_named(self: &BuildPlan, name: &String) -> BuildExplanation? {
        t := self.targets.iter().find(fn(target) { target.name == name })?
        self.explain_target(TargetRef { id: t.id, context: self.context })
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:689
    pub fn explain_action(self: &BuildPlan, action: ActionHandle) -> BuildExplanation? {
        a := self.action(action)?
        provenance := ["argv={a.argv.join(\" \")}", "inputs={a.inputs.len()}", "outputs={a.outputs.len()}", format!("cache={:?}", a.cache)]
        if wrapper := a.legacy_wrapper { provenance.push("legacy={wrapper.as_str()}") }
        if plugin := a.plugin { provenance.push("plugin={self.plugins[plugin.id.0].name}") }
        Val(BuildExplanation { subject: BuildGraphSubject.Action(a.id), label: a.name.clone(), provenance: ^provenance })
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:710
    pub fn explain_action_named(self: &BuildPlan, name: &String) -> BuildExplanation? {
        a := self.actions.iter().find(fn(action) { action.name == name })?
        self.explain_action(ActionHandle { id: a.id, context: self.context })
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:718
    pub fn explain_file(self: &BuildPlan, path: &String) -> BuildExplanation {
        ownership := self.file_ownership(path)
        provenance := [format!("owner={:?}", ownership.owner), format!("consumers={:?}", ownership.consumers), format!("targets={:?}", ownership.targets)]
        if module := self.generated_modules.iter().find(fn(m) { m.path.as_str() == ownership.path }) {
            provenance.push("generated={module.name}"); provenance.push("digest={module.source_digest.as_str()}")
        }
        BuildExplanation { subject: BuildGraphSubject.File, label: ^ownership.path, provenance: ^provenance }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:740
    pub fn why_rebuilt(self: &BuildPlan, action: ActionHandle, status: ActionCacheStatus) -> RebuildExplanation BuildError! {
        if action.context != self.context { fail BuildError.UnknownAction(action.id) }
        a := self.actions.get(action.id.0) == { Val(a) -> a; None -> { fail BuildError.UnknownAction(action.id) } }
        RebuildExplanation { action: action.id, action_name: a.name.clone(), status: status, reason: cache_status_reason(status) }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:760
    pub fn execution_model(self: &BuildPlan) -> BuildExecutionModel BuildError! {
        selected := self.selected_action_ids()?
        prereqs := self.action_prereqs_for(&selected)?
        stages := execution_stages(self, &prereqs)?
        action_targets := self.action_targets()
        nodes := self.actions.iter().filter(fn(a) { selected.contains(&a.id) }).map(fn(a) {
            BuildExecutionNode { action: a.id, name: a.name.clone(), target: action_targets.get(&a.id).copied(),
                prerequisites: prereqs.get(&a.id).cloned().unwrap_or([]), pools: action_pools(a) }
        }).collect::<[BuildExecutionNode]>()
        events := stages.iter().flat_map(fn(stage) { stage.actions.iter().map(fn(action) { BuildExecutionEvent.Ready { action: action, stage: stage.index } }) }).collect::<[BuildExecutionEvent]>()
        selected_actions := self.actions.iter().filter(fn(a) { selected.contains(&a.id) }).cloned().collect::<[BuildAction]>()
        metrics := execution_metrics(&selected_actions, &stages)
        BuildExecutionModel { pools: self.resource_pools(), nodes: ^nodes, stages: ^stages, events: ^events,
            console_order: self.actions.iter().filter(fn(a) { selected.contains(&a.id) }).map(fn(a) { a.id }).collect(), metrics: ^metrics }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:811
    pub fn execution_report(self: &BuildPlan, outcomes: &[(ActionHandle, ActionOutcome)]) -> BuildExecutionReport BuildError! {
        selected := self.selected_action_ids()?
        prereqs := self.action_prereqs_for(&selected)?
        stages := execution_stages(self, &prereqs)?
        supplied: [ActionId:ActionOutcome] = [:]
        for (action, outcome) in outcomes {
            if action.context != self.context || action.id.0 >= self.actions.len() { fail BuildError.UnknownAction(action.id) }
            supplied.insert(action.id, outcome)
        }
        failed := BTreeSet<ActionId>.new()
        finished := BTreeSet<ActionId>.new()
        events: [BuildExecutionEvent] = []
        selected_actions := self.actions.iter().filter(fn(a) { selected.contains(&a.id) }).cloned().collect::<[BuildAction]>()
        metrics := execution_metrics(&selected_actions, &stages)
        for stage in &stages {
            for action in &stage.actions {
                failed_prereq := prereqs.get(action).and_then(fn(deps) { deps.iter().find(fn(dep) { failed.contains(dep) }) })
                if dep := failed_prereq {
                    _ :: failed.insert(action)
                    metrics.cancelled_actions += 1
                    events.push(BuildExecutionEvent.Cancelled { action: action, failed_prereq: dep })
                    continue
                }
                supplied.get(action) == {
                    Val(outcome) -> {
                        _ :: finished.insert(action)
                        if outcome == { Failed { .. } -> true; _ -> false } { _ :: failed.insert(action); metrics.failed_actions += 1 }
                        if outcome == { RestoredFromCache -> true; _ -> false } { metrics.cache_restored_actions += 1 }
                        events.push(BuildExecutionEvent.Finished { action: action, outcome: outcome })
                    }
                    None -> { metrics.pending_actions += 1; events.push(BuildExecutionEvent.Pending { action: action }) }
                }
            }
        }
        BuildExecutionReport { events: ^events, metrics: ^metrics }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:877
    fn action_targets(self: &BuildPlan) -> [ActionId:TargetId] {
        out: [ActionId:TargetId] = [:]
        for target in &self.targets { for action in &target.actions { _ :: out.entry(action.id).or_insert(target.id) } }
        out
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:887
    fn file_index(self: &BuildPlan, action_targets: &[ActionId:TargetId]) -> [String:FileOwnership] {
        files: [String:FileOwnership] = [:]
        for action in &self.actions {
            for output in &action.outputs {
                entry := files.entry(output.as_str().to_string()).or_insert(FileOwnership { path: output.as_str().to_string(), owner: None, consumers: [], targets: [] })
                entry.owner = Val(action.id)
            }
            for input in &action.inputs {
                entry := files.entry(input.as_str().to_string()).or_insert(FileOwnership { path: input.as_str().to_string(), owner: None, consumers: [], targets: [] })
                entry.consumers.push(action.id)
            }
        }
        for target in &self.targets {
            for path in target.sources.iter().chain(target.inputs.iter()).chain(target.outputs.iter()) {
                entry := files.entry(path.as_str().to_string()).or_insert(FileOwnership { path: path.as_str().to_string(), owner: None, consumers: [], targets: [] })
                entry.targets.push(target.id)
            }
            for action in &target.actions {
                if target_id := action_targets.get(&action.id) {
                    for path in self.actions[action.id.0].inputs.iter().chain(self.actions[action.id.0].outputs.iter()) {
                        entry := files.entry(path.as_str().to_string()).or_insert(FileOwnership { path: path.as_str().to_string(), owner: None, consumers: [], targets: [] })
                        if !entry.targets.contains(target_id) { entry.targets.push(target_id) }
                    }
                }
            }
        }
        files
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:959
    fn action_prereqs(self: &BuildPlan) -> [ActionId:[ActionId]] BuildError! {
        out: [ActionId:BTreeSet<ActionId>] = [:]
        for action in &self.actions { out.insert(action.id, BTreeSet<ActionId>.new()) }
        for target in &self.targets {
            deps := BTreeSet<ActionId>.new()
            for dep in &target.deps { visiting: [TargetId] = []; collect_target_actions(self, dep.id, &visiting, &deps)? }
            for action in &target.actions { out.entry(action.id).or_default().extend(deps.iter().copied()) }
        }
        action_targets := self.action_targets()
        files := self.file_index(&action_targets)
        paths := files.keys().collect::<[&String]>()
        paths.sort()
        for path in paths {
            ownership := &files[path]
            owner := ownership.owner == { Val(owner) -> owner; None -> { continue } }
            for consumer in &ownership.consumers { if consumer != owner { _ :: out.entry(consumer).or_default().insert(owner) } }
        }
        result: [ActionId:[ActionId]] = [:]
        for (action, deps) in out { result.insert(action, deps.into_iter().collect()) }
        result
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:993
    fn action_prereqs_for(self: &BuildPlan, selected: &BTreeSet<ActionId>) -> [ActionId:[ActionId]] BuildError! {
        result: [ActionId:[ActionId]] = [:]
        for (action, deps) in self.action_prereqs()? {
            if selected.contains(&action) { result.insert(action, deps.into_iter().filter(fn(dep) { selected.contains(dep) }).collect()) }
        }
        result
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1013
    pub fn provider_plan_facts(self: &BuildPlan) -> [String:String] Err! {
        facts: [String:String] = [:]
        fingerprint := try { self.complete_recipe_fingerprint()? } catch(error) { fail Err(format!("cannot fingerprint build plan: {:?}", error)) }
        facts.insert("plan.recipe_fingerprint", ^fingerprint)
        facts.insert("plan.default", self.default_target().map(fn(t) { t.id().0.to_string() }).unwrap_or(""))
        facts.insert("plan.targets", self.targets().len().to_string())
        facts.insert("plan.actions", self.actions().len().to_string())
        for (index, contribution) in self.fact_contributions().iter().enumerate() {
            prefix := "fact_contribution.{index}"
            facts.insert("{prefix}.key", contribution.key.clone())
            facts.insert("{prefix}.value", format!("{:?}", contribution.value))
            facts.insert("{prefix}.scope", contribution.scope.name().to_string())
            facts.insert("{prefix}.layer", contribution.layer.name().to_string())
            facts.insert("{prefix}.source", contribution.source.clone())
            facts.insert("{prefix}.reason", contribution.reason.clone().unwrap_or(""))
        }
        for (index, target) in self.targets().iter().enumerate() {
            prefix := "target.{index}"
            facts.insert("{prefix}.name", target.name.clone())
            facts.insert("{prefix}.kind", format!("{:?}", target.kind))
            facts.insert("{prefix}.sources", target.sources.iter().map(fn(p) { p.as_str() }).collect::<[&String]>().join(TEXT_NUL))
            facts.insert("{prefix}.inputs", target.inputs.iter().map(fn(p) { p.as_str() }).collect::<[&String]>().join(TEXT_NUL))
            facts.insert("{prefix}.outputs", target.outputs.iter().map(fn(p) { p.as_str() }).collect::<[&String]>().join(TEXT_NUL))
            facts.insert("{prefix}.deps", target.deps.iter().map(fn(d) { d.id().0.to_string() }).collect::<[String]>().join(","))
            facts.insert("{prefix}.actions", target.actions.iter().map(fn(a) { a.id().0.to_string() }).collect::<[String]>().join(","))
            facts.insert("{prefix}.toolchain", target.toolchain.id().0.to_string())
            facts.insert("{prefix}.metadata", map_debug(&target.metadata))
        }
        for (index, action) in self.actions().iter().enumerate() {
            prefix := "action.{index}"
            facts.insert("{prefix}.name", action.name.clone())
            facts.insert("{prefix}.kind", action.kind.as_str().to_string())
            facts.insert("{prefix}.cache", format!("{:?}", action.cache))
            facts.insert("{prefix}.argv", action.argv.join(TEXT_NUL))
            facts.insert("{prefix}.inputs", action.inputs.iter().map(fn(p) { p.as_str() }).collect::<[&String]>().join(TEXT_NUL))
            facts.insert("{prefix}.outputs", action.outputs.iter().map(fn(p) { p.as_str() }).collect::<[&String]>().join(TEXT_NUL))
            facts.insert("{prefix}.env", map_debug(&action.env))
            facts.insert("{prefix}.env_allowlist", action.env_allowlist.iter().cloned().collect::<[String]>().join(TEXT_NUL))
            facts.insert("{prefix}.caps", action.caps.iter().map(fn(c) { c.name().to_string() }).collect::<[String]>().join(TEXT_NUL))
            facts.insert("{prefix}.toolchain", action.toolchain.id().0.to_string())
            facts.insert("{prefix}.labels", map_debug(&action.labels))
            facts.insert("{prefix}.helpers", map_debug(&action.helper_versions))
            facts.insert("{prefix}.pools", action.resource_pools.iter().map(pool_name).collect::<[String]>().join(TEXT_NUL))
            facts.insert("{prefix}.variant", action.variant_identity.clone().unwrap_or(""))
            facts.insert("{prefix}.legacy", action.legacy_wrapper.map(fn(w) { w.as_str().to_string() }).unwrap_or(""))
            key := try { self.action_key(ActionHandle { id: action.id, context: self.context })? } catch(error) { fail Err(format!("cannot key provider plan action: {:?}", error)) }
            facts.insert("{prefix}.action_key", key.as_str().to_string())
        }
        for (index, toolchain) in self.toolchains().iter().enumerate() { facts.insert("toolchain.{index}", format!("{:?}", toolchain)) }
        for (index, identity) in self.signing_identities().iter().enumerate() { facts.insert("signing.{index}", format!("{:?}", identity)) }
        for (index, probe) in self.probes().iter().enumerate() { facts.insert("probe.{index}", format!("{:?}", probe)) }
        for (index, plugin) in self.plugins().iter().enumerate() { facts.insert("plugin.{index}", format!("{:?}", plugin)) }
        for (index, module) in self.generated_modules().iter().enumerate() { facts.insert("generated.{index}", format!("{:?}", module)) }
        facts
    }
}

// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1206
impl BuildGraph {
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1211
    pub fn affected_files(self: &BuildGraph) -> &[BuildGraphFile] { &self.files }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1216
    pub fn action_keys(self: &BuildGraph) -> [BuildGraphActionKey] {
        keys := self.actions.iter().map(fn(a) { BuildGraphActionKey { action: a.name.clone(), key: a.key.clone() } }).collect::<[BuildGraphActionKey]>()
        keys.sort_by(fn(left, right) { left.action.cmp(&right.action) })
        keys
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1233
    pub fn cache_hits(self: &BuildGraph) -> [&BuildGraphAction] {
        hits := self.actions.iter().filter(fn(a) { a.cache_hit == Val(true) }).collect::<[&BuildGraphAction]>()
        hits.sort_by(fn(left, right) { left.name.cmp(&right.name) })
        hits
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1246
    pub fn diff(self: &BuildGraph, after: &BuildGraph) -> BuildGraphDiff {
        paths := BTreeSet<String>.new()
        paths.extend(self.files.iter().map(fn(f) { f.path.clone() }))
        paths.extend(after.files.iter().map(fn(f) { f.path.clone() }))
        file_deltas: [BuildGraphFileDelta] = []
        for path in paths {
            before_file := self.files.iter().find(fn(f) { f.path == path })
            after_file := after.files.iter().find(fn(f) { f.path == path })
            if file_identity(self, before_file) != file_identity(after, after_file) {
                file_deltas.push(BuildGraphFileDelta { path: ^path, before: before_file.cloned(), after: after_file.cloned() })
            }
        }
        action_names := BTreeSet<String>.new()
        action_names.extend(self.actions.iter().map(fn(a) { a.name.clone() }))
        action_names.extend(after.actions.iter().map(fn(a) { a.name.clone() }))
        changed_actions := BTreeSet<String>.new()
        key_deltas: [BuildGraphKeyDelta] = []
        cache_deltas: [BuildGraphCacheDelta] = []
        for action_name in action_names {
            before := self.actions.iter().find(fn(a) { a.name == action_name })
            after_action := after.actions.iter().find(fn(a) { a.name == action_name })
            action_changed := (before, after_action) == { (Val(b), Val(a)) -> b.key != a.key || b.inputs != a.inputs; _ -> true }
            if action_changed { _ :: changed_actions.insert(action_name.clone()) }
            before_key := before.map(fn(a) { a.key.clone() })
            after_key := after_action.map(fn(a) { a.key.clone() })
            if before_key != after_key { key_deltas.push(BuildGraphKeyDelta { action: action_name.clone(), before: ^before_key, after: ^after_key }) }
            before_hit := before.and_then(fn(a) { a.cache_hit })
            after_hit := after_action.and_then(fn(a) { a.cache_hit })
            if before_hit != after_hit { cache_deltas.push(BuildGraphCacheDelta { action: ^action_name, before: before_hit, after: after_hit }) }
        }
        affected_files := graph_affected_files(self, &changed_actions)
        affected_files.extend(graph_affected_files(after, &changed_actions))
        BuildGraphDiff { file_deltas: ^file_deltas, affected_files: affected_files.into_iter().collect(), key_deltas: ^key_deltas, cache_deltas: ^cache_deltas }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1324
fn graph_affected_files(graph: &BuildGraph, changed_actions: &BTreeSet<String>) -> BTreeSet<String> {
    pending_actions := graph.actions.iter().filter(fn(a) { changed_actions.contains(&a.name) }).map(fn(a) { a.id }).collect::<[ActionId]>()
    pending_targets: [TargetId] = []
    seen_actions := BTreeSet<ActionId>.new()
    seen_targets := BTreeSet<TargetId>.new()
    affected := BTreeSet<String>.new()
    while !pending_actions.is_empty() || !pending_targets.is_empty() {
        while action_id := pending_actions.pop() {
            if !seen_actions.insert(action_id) { continue }
            action := graph.actions.iter().find(fn(a) { a.id == action_id }) == { Val(a) -> a; None -> { continue } }
            for output in &action.outputs {
                _ :: affected.insert(output.clone())
                if file := graph.files.iter().find(fn(f) { f.path == output }) { pending_actions.extend(file.consumers.iter().copied()) }
            }
            pending_targets.extend(graph.targets.iter().filter(fn(t) { t.actions.contains(&action_id) }).map(fn(t) { t.id }))
        }
        while target_id := pending_targets.pop() {
            if !seen_targets.insert(target_id) { continue }
            for target in graph.targets.iter().filter(fn(t) { t.deps.contains(&target_id) }) {
                pending_actions.extend(target.actions.iter().copied())
                pending_targets.push(target.id)
            }
        }
    }
    affected
}
// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1384
fn file_identity(graph: &BuildGraph, file: &BuildGraphFile?) -> (String?, [String], [String])? {
    f := file?
    action_name := fn(id) { graph.actions.iter().find(fn(a) { a.id == id }).map(fn(a) { a.name.clone() }) }
    target_name := fn(id) { graph.targets.iter().find(fn(t) { t.id == id }).map(fn(t) { t.name.clone() }) }
    consumers := f.consumers.iter().filter_map(fn(id) { action_name(id) }).collect::<[String]>()
    targets := f.targets.iter().filter_map(fn(id) { target_name(id) }).collect::<[String]>()
    consumers.sort(); consumers.dedup()
    targets.sort(); targets.dedup()
    Val((f.owner.and_then(action_name), ^consumers, ^targets))
}
// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1424
fn map_debug(map: &[String:String]) -> String {
    keys := map.keys().collect::<[&String]>()
    keys.sort()
    keys.iter().map(fn(key) { value := &map[key]; "{key.as_bytes().len()}:{key}:{value.as_bytes().len()}:{value}" }).collect::<[String]>().join("")
}
// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1431
fn pool_name(pool: &BuildResourcePool) -> String { pool == { Custom(name) -> "custom:{name}"; _ -> pool.as_str().to_string() } }
// Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:1438
fn compiler_package_path_name(name: &String) -> String {
    out := name.chars().map(fn(character) { if character.is_ascii_alphanumeric() || character == '-' || character == '_' { character } else { '_' } }).collect::<String>()
    if out.is_empty() { out.push_str("package") }
    out
}
