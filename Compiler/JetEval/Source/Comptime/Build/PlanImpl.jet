    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:70
    pub fn selected_generated_modules(self: &BuildPlan) -> [&BuildGeneratedModule] BuildError! {
        if self.targets.is_empty() {
            selected := self.generated_modules.iter().collect::<[&BuildGeneratedModule]>()
            selected.sort_by(fn(left, right) { left.path.as_str().cmp(right.path.as_str()).then_with(fn() { left.name.cmp(&right.name) }) })
            return selected
        }
        paths := self.selected_sources()?.into_iter().map(fn(path) { path.as_str().to_string() }).collect::<BTreeSet<String>>()
        actions := self.selected_action_ids()?
        for action in self.actions.iter().filter(fn(action) { actions.contains(&action.id) }) {
            paths.extend(action.outputs.iter().map(fn(path) { path.as_str().to_string() }))
        }
        selected := self.generated_modules.iter().filter(fn(module) { paths.contains(module.path.as_str()) }).collect::<[&BuildGeneratedModule]>()
        selected.sort_by(fn(left, right) { left.path.as_str().cmp(right.path.as_str()).then_with(fn() { left.name.cmp(&right.name) }) })
        selected
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:110
    pub fn selected_action_ids(self: &BuildPlan) -> BTreeSet<ActionId> BuildError! {
        selected := BTreeSet<ActionId>.new()
        self.default == {
            Val(default) -> { visiting: [TargetId] = []; collect_target_actions(self, default.id, &visiting, &selected)? }
            None -> { for target in &self.targets { visiting: [TargetId] = []; collect_target_actions(self, target.id, &visiting, &selected)? } }
        }
        prereqs := self.action_prereqs()?
        pending := selected.iter().copied().collect::<[ActionId]>()
        while action := pending.pop() {
            if deps := prereqs.get(&action) {
                for dependency in deps { if selected.insert(dependency) { pending.push(dependency) } }
            }
        }
        selected
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:132
    pub fn selected_sources(self: &BuildPlan) -> [BuildPath] BuildError! {
        // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:133
        fn collect(plan: &BuildPlan, id: TargetId, visiting: &[TargetId], seen: &BTreeSet<String>, out: &[BuildPath]) -> Unit BuildError! {
            if visiting.contains(&id) { fail target_cycle_error(plan, visiting, id) }
            visiting.push(id)
            target := plan.targets.get(id.0) == { Val(t) -> t; None -> { fail BuildError.UnknownTarget(id) } }
            for source in &target.sources { if seen.insert(source.as_str().to_string()) { out.push(source.clone()) } }
            for dep in &target.deps { collect(plan, dep.id, visiting, seen, out)? }
            _ :: visiting.pop()
        }
        out: [BuildPath] = []
        seen := BTreeSet<String>.new()
        self.default == {
            Val(default) -> { visiting: [TargetId] = []; collect(self, default.id, &visiting, &seen, &out)? }
            None -> { for target in &self.targets { visiting: [TargetId] = []; collect(self, target.id, &visiting, &seen, &out)? } }
        }
        out
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:171
    pub fn selected_probe_ids(self: &BuildPlan) -> BTreeSet<ProbeId> BuildError! {
        actions := self.selected_action_ids()?
        probes := self.actions.iter().filter(fn(a) { actions.contains(&a.id) }).flat_map(fn(a) { a.probes.iter().map(fn(p) { p.id }) }).collect::<BTreeSet<ProbeId>>()
        selected_targets := self.default == {
            Val(default) -> {
                targets := BTreeSet<TargetId>.new()
                // Rust: crates/jet-comptime/src/Comptime/Build/plan_impl.rs:181
                fn visit(plan: &BuildPlan, id: TargetId, out: &BTreeSet<TargetId>) {
                    if out.insert(id) {
                        if target := plan.targets.get(id.0) { for dep in &target.deps { visit(plan, dep.id, out) } }
                    }
                }
                visit(self, default.id, &targets)
                targets
            }
            None -> self.targets.iter().map(fn(t) { t.id }).collect::<BTreeSet<TargetId>>()
        }
        for target in self.targets.iter().filter(fn(t) { selected_targets.contains(&t.id) }) { probes.extend(target.probes.iter().map(fn(p) { p.id })) }
        probes
    }
