// Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:32
#Derive(Debug, Clone, Eq)
pub struct BuildPlanNode { pub kind: BuildNodeKind, pub key: String, pub subject: String, pub inputs: [String], pub input_digests: [(String,String)] }
impl BuildPlanNode {
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:42
    pub fn new(kind: BuildNodeKind, subject: String, input_digests: [(String,String)]) -> Self {
        input_digests.sort(); input_digests.dedup()
        inputs := input_digests.iter().map(fn(entry) { entry.0.clone() }).collect()
        key := compiler_node_key(kind, &subject, &input_digests)
        Self { kind: kind, key: key, subject: subject, inputs: inputs, input_digests: input_digests }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:66
pub fn compiler_node_key(kind: BuildNodeKind, subject: &String, input_digests: &[(String,String)]) -> String {
    inputs := input_digests.to_vec(); inputs.sort()
    bytes: [U8] = []
    for value in ["jet.action-key.v2", "compiler-node", kind.as_str(), subject] {
        bytes.extend_from_slice(&(value.len() as U64).to_be_bytes()); bytes.extend_from_slice(value.as_bytes())
    }
    for (name, digest) in inputs {
        for value in [name, digest] { bytes.extend_from_slice(&(value.len() as U64).to_be_bytes()); bytes.extend_from_slice(value.as_bytes()) }
    }
    sha256_hex(&bytes)
}
