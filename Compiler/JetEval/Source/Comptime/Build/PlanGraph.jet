// Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:89
#Derive(Debug, Clone, Eq)
pub struct BuildPlan {
    context: U64
    targets: [BuildTarget]
    actions: [BuildAction]
    toolchains: [BuildToolchain]
    signing_identities: [BuildSigningIdentity]
    probes: [BuildProbe]
    plugins: [BuildPlugin]
    generated_modules: [BuildGeneratedModule]
    compiler_nodes: [BuildPlanNode]
    default: TargetRef?
    pub fact_contributions: [FactContribution]
}
impl BuildPlan {
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:109
    pub fn fact_contributions(self: &Self) -> &[FactContribution] { &self.fact_contributions }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:113
    pub fn compiler_nodes(self: &Self) -> &[BuildPlanNode] { &self.compiler_nodes }
    // Rust: crates/jet-comptime/src/Comptime/Build/plan_graph.rs:117
    pub fn set_compiler_nodes(self: &Self, nodes: [BuildPlanNode]) {
        nodes.sort_by(fn(left, right) { left.kind.cmp(&right.kind).then_with(fn() { left.subject.cmp(&right.subject) }).then_with(fn() { left.key.cmp(&right.key) }) })
        self.compiler_nodes = nodes
    }
}
