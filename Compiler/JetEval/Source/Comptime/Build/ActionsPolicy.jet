// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:116
fn push_unique(values: &[String], value: String) Never! {
    if !value.is_empty() && !values.any(|existing| existing == value) -> &values.push(value)
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:123
fn split_import_words(value: String) -> [String] Never! {
    words := [String]{}
    loop part in value.split(|ch| ch.is_whitespace() || ch == ',') {
        trimmed := part.trim_matches(|ch| ch == '"' || ch == '\'') // #4303
        if !trimmed.is_empty() -> &words.push(trimmed.to_string())
    }
    words
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:133
fn scalar_import_value(value: String) -> String Never! {
