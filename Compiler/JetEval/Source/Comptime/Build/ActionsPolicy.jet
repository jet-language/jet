//RS pub enum ActionCache {
//RS     Cached,
//RS     UncachedPhony,
//RS }
//RS 
//RS /// Distinct executable identities under one BuildPlan (E4-JP2 / #419).
//RS /// Compile / docs / debug / source-archive never share a cache key even when
//RS /// argv and declared paths match — each surface observes different outputs.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
//RS pub enum ActionKind {
//RS     Compile,
//RS     Docs,
//RS     Debug,
//RS     SourceArchive,
//RS     Generic,
//RS }
//RS 
//RS impl ActionKind {
//RS     pub fn as_str(self) -> &'static str {
//RS         match self {
//RS             ActionKind::Compile => "compile",
//RS             ActionKind::Docs => "docs",
//RS             ActionKind::Debug => "debug",
//RS             ActionKind::SourceArchive => "source-archive",
//RS             ActionKind::Generic => "generic",
//RS         }
//RS     }
//RS 
//RS     /// Exact source bytes remain identity inputs when these surfaces can
//RS     /// observe them (docs, doctests, diagnostics/line maps, debug info,
//RS     /// publication / source archives).
//RS     pub fn observes_exact_source(self) -> bool {
//RS         matches!(
//RS             self,
//RS             ActionKind::Compile | ActionKind::Docs | ActionKind::Debug | ActionKind::SourceArchive
//RS         )
//RS     }
//RS }
//RS 
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub struct ActionSpec {
//RS     pub inputs: Vec<BuildPath>,
//RS     pub outputs: Vec<BuildPath>,
//RS     pub argv: Vec<String>,
//RS     pub env: BTreeMap<String, String>,
//RS     /// Only allowlisted env keys enter the action identity. Empty means the
//RS     /// declared `env` map itself is the allowlist (no ambient leakage).
//RS     pub env_allowlist: BTreeSet<String>,
//RS     pub caps: BTreeSet<BuildCapability>,
//RS     pub cache: ActionCache,
//RS     pub kind: ActionKind,
//RS     pub toolchain: Option<ToolchainHandle>,
//RS     pub probes: Vec<ProbeHandle>,
//RS     pub signing_identity: Option<SigningIdentityHandle>,
//RS     pub labels: BTreeMap<String, String>,
//RS     /// Helper tool versions (formatter, docgen, archive helper, …) keyed into
//RS     /// the complete CAS identity.
//RS     pub helper_versions: BTreeMap<String, String>,
//RS     pub resource_pools: BTreeSet<BuildResourcePool>,
//RS     pub legacy_wrapper: Option<LegacyWrapperKind>,
//RS     /// Selected typed variant identity (E4-JP15 / D-JPK-VARIANT1). Canonical
//RS     /// `PackageVariant::identity_key()` string; empty means host defaults were
//RS     /// never materialised into the action (legacy plans).
//RS     pub variant_identity: Option<String>,
//RS }
//RS 
