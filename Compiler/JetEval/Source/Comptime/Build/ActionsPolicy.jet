    pub fn with_cache(self, cache: ActionCache) -> Self Never! { self.cache = cache; ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1866
    pub fn with_kind(self, kind: ActionKind) -> Self Never! { self.action_kind = kind; ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1871
    pub fn with_toolchain(self, toolchain: ToolchainHandle) -> Self Never! { self.toolchain = Val(toolchain); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1876
    pub fn with_probe(self, probe: ProbeHandle) -> Self Never! { &self.probes.push(probe); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1881
    pub fn with_signing_identity(self, identity: SigningIdentityHandle) -> Self Never! { self.signing_identity = Val(identity); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1886
    pub fn with_helper_version(self, helper: String, version: String) -> Self Never! { self.helper_versions[helper] = version; ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1895
    pub fn with_pool(self, pool: BuildResourcePool) -> Self Never! { &self.resource_pools.insert(pool); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1900
    pub fn with_variant_identity(self, identity: String) -> Self Never! { self.variant_identity = Val(identity); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1905
    pub fn with_label(self, key: String, value: String) -> Self Never! { self.labels[key] = value; ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1910
    pub fn explain(self, policy: BuildPolicy) -> PolicyExplanation Never! {
        subject :: "legacy wrapper {self.kind.as_str()}"
        caps :: self.caps.to_list().sorted()
        match policy.legacy_wrappers { .Allow => PolicyExplanation.allowed(subject, caps); .Deny(reason) => PolicyExplanation.denied(subject, reason, caps) }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:1919
    pub fn into_action_spec(self, policy: BuildPolicy) -> ActionSpec BuildError! {
        if policy.legacy_wrappers == .Deny(_) -> return Err(.PolicyDenied(self.explain(policy)))
        if self.inputs.is_empty() -> return Err(.LegacyWrapperWithoutInputs(self.kind))
        if self.outputs.is_empty() -> return Err(.LegacyWrapperWithoutOutputs(self.kind))
        if self.caps.is_empty() -> return Err(.LegacyWrapperWithoutCaps(self.kind))
        actual := String{}
        if self.argv.first() == .Val(value) {
            filename :: OSPath.new(value).file_name().and_then(|name| name.to_str()) ?? value
            text := filename.trim_end_matches(".cmd").trim_end_matches(".exe") // #4303
            actual = text.to_ascii_lowercase()
        }
        if actual != self.kind.as_str() -> return Err(.LegacyWrapperCommandMismatch{wrapper: self.kind, actual: ^actual})
        labels := ^self.labels
        labels["legacy.wrapper"] = self.kind.as_str()
        spec :: ActionSpec{inputs: ^self.inputs, outputs: ^self.outputs, argv: ^self.argv, env: ^self.env, env_allowlist: ^self.env_allowlist, caps: ^self.caps, cache: self.cache, kind: self.action_kind, toolchain: self.toolchain, probes: ^self.probes, signing_identity: self.signing_identity, labels: ^labels, helper_versions: ^self.helper_versions, resource_pools: ^self.resource_pools, legacy_wrapper: Val(self.kind), variant_identity: ^self.variant_identity}
        validate_action(self.kind.as_str(), spec)
        Ok(^spec)
    }
}
