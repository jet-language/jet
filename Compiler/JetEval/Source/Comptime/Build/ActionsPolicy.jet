}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:171
fn apply_import_key(kind: LegacyWrapperKind, key: String, value: String, import: &LegacyProjectImport) BuildError! {
    match key {
        "argv" | "args" => import.argv = Val(parse_import_array(value))
        "input" | "inputs" => { loop path in parse_import_array(value) -> push_unique(&import.inputs, path) }
        "output" | "outputs" => {
            paths :: parse_import_array(value)
            if paths.is_empty() -> return Err(legacy_import_error(kind, "output declarations cannot be empty"))
            import.outputs_explicit = true
            loop path in paths -> push_unique(&import.outputs, path)
        }
        "cap" | "caps" => {
            loop text in parse_import_array(value) {
                cap :: BuildCapability.parse(text) ?? return Err(legacy_import_error(kind, "unknown ability `{text}`"))
                &import.caps.insert(cap)
            }
        }
        "env" => {
            loop entry in parse_import_array(value) {
                (name, env_value) :: entry.split_once('=') ?? return Err(legacy_import_error(kind, "environment entries must use KEY=VALUE"))
                if name.trim().is_empty() -> return Err(legacy_import_error(kind, "environment names cannot be empty"))
                import.env[name.to_string()] = env_value.to_string()
            }
        }
        "env_allowlist" | "env-allowlist" => { loop name in parse_import_array(value) -> &import.env_allowlist.insert(name) }
        "pool" | "pools" => { loop pool in parse_import_array(value) -> &import.resource_pools.insert(import_resource_pool(pool)) }
        "cache" => {
            import.cache = match scalar_import_value(value).to_ascii_lowercase() {
                "cached" => Val(.Cached)
                "phony" | "uncached" => Val(.UncachedPhony)
                _ => return Err(legacy_import_error(kind, "cache must be cached or phony"))
            }
        }
        "kind" => {
            text :: scalar_import_value(value)
            import.action_kind = import_action_kind(text)
            if import.action_kind == None -> return Err(legacy_import_error(kind, "unknown action kind `{text}`"))
        }
        _ => {
            if key.starts_with("label.") {
                name := key.trim_start_matches("label.") // #4303
                if name.is_empty() -> return Err(legacy_import_error(kind, "label names cannot be empty"))
                import.labels[name.to_string()] = scalar_import_value(value)
            } else -> return Err(legacy_import_error(kind, "unsupported import field `{key}`"))
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:269
fn apply_import_directives(kind: LegacyWrapperKind, source: String, import: &LegacyProjectImport) BuildError! {
    loop raw in source.lines() {
        line := raw.trim() // #4303
        if line.strip_prefix('#') == .Val(rest) -> line = rest.trim()
        else if line.strip_prefix("//") == .Val(rest) -> line = rest.trim()
        directive :: line.strip_prefix("jet:") ?? line.strip_prefix("jet.") ?? continue
        (key, value) :: directive.split_once('=') ?? return Err(legacy_import_error(kind, "Jet import directives must use key=value"))
        apply_import_key(kind, key.trim(), value.trim(), &import)
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:298
fn legacy_generated_directory(kind: LegacyWrapperKind, name: String) -> Bool Never! {
    if name == ".git" || name == ".jet" -> return true
    match kind { .CMake | .Make => name == "build"; .Gradle => name == "build" || name == ".gradle"; .Npm => name == "build" || name == "dist" || name == "node_modules"; .Cargo => name == "target" }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:315
fn walk(root: OSPath, relative: OSPath, kind: LegacyWrapperKind, import: &LegacyProjectImport, file_count: &Int, byte_count: &U64) BuildError! {
    // GATE #4494: native read-dir, lstat and lossless OS path ownership.
    directory :: root.join(relative)
    iterator :: fs.read_dir(directory) ?? return Err(legacy_import_error(kind, "cannot read `{relative.display()}`"))
    entries := iterator.collect() ?? return Err(legacy_import_error(kind, "cannot read `{relative.display()}`"))
    &entries.sort_by_key(|entry| entry.file_name())
    loop entry in entries {
        name :: entry.file_name()
        child_relative :: relative.join(name)
        metadata :: fs.symlink_metadata(entry.path()) ?? return Err(legacy_import_error(kind, "cannot inspect `{child_relative.display()}`"))
        if metadata.file_type().is_symlink() -> return Err(legacy_import_error(kind, "source closure cannot contain symlink `{child_relative.display()}`"))
        if metadata.is_dir() {
            if legacy_generated_directory(kind, name.to_string_lossy()) -> continue
            walk(root, child_relative, kind, &import, &file_count, &byte_count)
            continue
        }
        if !metadata.is_file() -> return Err(legacy_import_error(kind, "source closure contains non-file `{child_relative.display()}`"))
        child_path :: child_relative.to_string_lossy()
        if import.outputs.any(|output| output == child_path) -> continue
        // Host project's Jet build sources are not legacy-tool inputs.
        if child_relative.extension() == .Val("jet") -> continue
        file_count += 1
        byte_count = byte_count.saturating_add(metadata.len())
        if file_count > MAX_LEGACY_PROJECT_INPUT_FILES -> return Err(legacy_import_error(kind, "source closure exceeds {MAX_LEGACY_PROJECT_INPUT_FILES} files"))
        if byte_count > MAX_LEGACY_PROJECT_INPUT_BYTES -> return Err(legacy_import_error(kind, "source closure exceeds {MAX_LEGACY_PROJECT_INPUT_BYTES} bytes"))
        path :: child_relative.to_str() ?? return Err(legacy_import_error(kind, "source closure contains a non-UTF-8 path"))
        push_unique(&import.inputs, path.to_string())
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:310
fn collect_legacy_project_inputs(root: OSPath, kind: LegacyWrapperKind, import: &LegacyProjectImport) BuildError! {
    file_count := 0
    byte_count := U64{0}
    walk(root, OSPath.new(""), kind, &import, &file_count, &byte_count)
    import.labels["legacy.source-closure"] = "project-files-v1:{file_count}:{byte_count}"
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:422
fn cmake_command_calls(source: String) -> [(String, [String])] Never! {
    bytes :: source.bytes()
    calls := [(String, [String])]{}
    cursor := 0
    quote := U8?{None}
    loop cursor < bytes.len() {
        if quote == .Val(end) {
            if bytes[cursor] == end && (cursor == 0 || bytes[cursor - 1] != U8{92}) -> quote = None
            cursor += 1
            continue
        }
        if bytes[cursor] == U8{34} || bytes[cursor] == U8{39} { quote = Val(bytes[cursor]); cursor += 1; continue }
        if bytes[cursor] == U8{35} {
            match source[cursor..<source.len()].find('\n') { Val(offset) => cursor += offset + 1; None => cursor = bytes.len() }
            continue
        }
        if !(bytes[cursor].is_ascii_alphabetic() || bytes[cursor] == U8{95}) { cursor += 1; continue }
        start :: cursor
        cursor += 1
        loop cursor < bytes.len() && (bytes[cursor].is_ascii_alphanumeric() || bytes[cursor] == U8{95}) -> cursor += 1
        name :: source[start..<cursor]
        open := cursor
        loop open < bytes.len() && bytes[open].is_ascii_whitespace() -> open += 1
        if open >= bytes.len() || bytes[open] != U8{40} -> continue
        depth := 1
        close := open + 1
        nested_quote := U8?{None}
        loop close < bytes.len() && depth > 0 {
            if nested_quote == .Val(end) {
                if bytes[close] == end && (close == 0 || bytes[close - 1] != U8{92}) -> nested_quote = None
            } else {
                match bytes[close] { U8{34} | U8{39} => nested_quote = Val(bytes[close]); U8{40} => depth += 1; U8{41} => depth -= 1; _ => {} }
            }
            close += 1
        }
        if depth != 0 { &calls.push((name.to_string(), [String]{})); break }
        &calls.push((name.to_string(), split_import_words(source[open + 1..<close - 1])))
        cursor = close
    }
    calls
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:497
fn cmake_commands(source: String, name: String) -> [[String]] Never! {
    rows := [[String]]{}
    loop (command, args) in cmake_command_calls(source) { if command.eq_ignore_ascii_case(name) -> &rows.push(^args) }
    rows
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:504
fn parse_cmake_import(source: String, import: &LegacyProjectImport) BuildError! {
    calls :: cmake_command_calls(source)
    allowed :: ["cmake_minimum_required", "project", "add_executable", "add_library", "add_custom_target"]
    loop (command, args) in calls {
        if args.is_empty() -> return Err(legacy_import_error(.CMake, "malformed command `{command}`"))
        if !allowed.any(|name| command.eq_ignore_ascii_case(name)) -> return Err(legacy_import_error(.CMake, "unsupported construct `{command}`"))
    }
    targets := [(String, [String])]{}
    loop command in ["add_executable", "add_library", "add_custom_target"] {
        loop args in cmake_commands(source, command) -> &targets.push((command.to_string(), ^args))
    }
    if targets.len() != 1 -> return Err(legacy_import_error(.CMake, if targets.is_empty() -> "supported import needs one add_executable, add_library, or add_custom_target" else -> "multiple or ambiguous build targets are not supported"))
    (command, args) :: &targets.pop() ?? panic("one CMake target was checked")
    name :: args.first() ?? return Err(legacy_import_error(.CMake, "{command} has no target name"))
    if name.starts_with("$") || name.contains(' ') -> return Err(legacy_import_error(.CMake, "target name must be a literal word"))
    import.argv = Val(["cmake", "--build", "build", "--target", name.to_string()])
    import.labels["legacy.target"] = name.to_string()
    match command {
        "add_custom_target" => {
            if args[1..<args.len()].any(|arg| arg != "ALL") -> return Err(legacy_import_error(.CMake, "add_custom_target options and commands are not supported"))
            import.cache = Val(.UncachedPhony)
        }
        "add_executable" | "add_library" => {
            known_flags :: ["WIN32", "MACOSX_BUNDLE", "EXCLUDE_FROM_ALL", "STATIC", "SHARED", "MODULE", "OBJECT", "INTERFACE"]
            loop path in args[1..<args.len()] {
                if path.starts_with("$") -> return Err(legacy_import_error(.CMake, "target sources must be literal paths"))
                if known_flags.contains(path) -> continue
                if path == "IMPORTED" || path == "ALIAS" -> return Err(legacy_import_error(.CMake, "imported and alias targets are not buildable project targets"))
                push_unique(&import.inputs, path.to_string())
            }
        }
        _ => panic("all CMake target commands are handled")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:617
fn parse_make_import(source: String, import: &LegacyProjectImport) BuildError! {
    loop unsupported in ["$(shell", "$(eval", "include ", "define "] {
        if source.contains(unsupported) -> return Err(legacy_import_error(.Make, "unsupported construct `{unsupported}`"))
    }
    rules := [(String, String)]{}
    phony_targets := Set<String>{}
    loop raw in source.lines() {
        line := raw.trim_end() // #4303
        trimmed := line.trim_start() // #4303
        if trimmed.is_empty() || trimmed.starts_with("#") -> continue
        if line.starts_with("\t") -> return Err(legacy_import_error(.Make, "recipe bodies are not representable in the typed import"))
        if trimmed.split_once(':') == .Val((special, targets)) {
            if special == ".PHONY" {
                loop target in targets.split_whitespace() {
                    if target.starts_with("$") || target.contains('%') -> return Err(legacy_import_error(.Make, ".PHONY targets must be literal paths"))
                    &phony_targets.insert(target.to_string())
                }
                continue
            }
            if special.starts_with(".") -> return Err(legacy_import_error(.Make, "unsupported special target `{special}`"))
        }
        (raw_target, prerequisites) :: line.split_once(':') ?? return Err(legacy_import_error(.Make, "only one literal target rule is supported"))
        target := raw_target.trim() // #4303
        if target.is_empty() || target.chars().any(|ch| ch.is_whitespace()) || target.contains('%') -> return Err(legacy_import_error(.Make, "target rules must name one literal target"))
        if prerequisites.contains('|') -> return Err(legacy_import_error(.Make, "order-only prerequisites are not supported"))
        &rules.push((target.to_string(), prerequisites.to_string()))
    }
    if rules.len() != 1 -> return Err(legacy_import_error(.Make, if rules.is_empty() -> "supported import needs one named target rule" else -> "multiple or ambiguous target rules are not supported"))
    (target, prerequisites) :: &rules.pop() ?? panic("one Make rule was checked")
    import.argv = Val(["make", target.to_string()])
    push_unique(&import.outputs, target.to_string())
    loop path in prerequisites.split_whitespace() {
        if path.starts_with("$") -> return Err(legacy_import_error(.Make, "prerequisites must be literal paths"))
        push_unique(&import.inputs, path.to_string())
    }
    if phony_targets.any(|phony| phony != target) -> return Err(legacy_import_error(.Make, ".PHONY must name the imported target only"))
    if phony_targets.contains(target) -> import.cache = Val(.UncachedPhony)
    import.labels["legacy.target"] = ^target
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:716
fn parse_gradle_import(source: String, import: &LegacyProjectImport) BuildError! {
    tasks := [String]{}
    project := String?{None}
    loop raw_line in source.lines() {
        line := raw_line.trim() // #4303
        if line.is_empty() || line.starts_with("//") || line.starts_with("#") -> continue
        declaration := (String, String)?{None}
        loop marker in ["tasks.register(", "tasks.create("] {
            if line.strip_prefix(marker) == .Val(rest) { declaration = Val((marker, rest)); break }
        }
        if declaration == .Val((marker, rest)) {
            text :: rest.strip_suffix(')') ?? return Err(legacy_import_error(.Gradle, "unsupported task body after {marker}"))
            argument := text.trim() // #4303
            quote :: argument.chars().first() ?? return Err(legacy_import_error(.Gradle, "task declaration needs one quoted literal name"))
            if (quote != '\'' && quote != '"') || argument.len() < 2 || !argument.ends_with(quote) || argument[1..<argument.len() - 1].contains(quote) -> return Err(legacy_import_error(.Gradle, "task declaration needs one quoted literal name"))
            &tasks.push(argument[1..<argument.len() - 1].to_string())
            continue
        }
        if line.strip_prefix("task ") == .Val(rest) {
            words := rest.split_whitespace()
            task :: &words.next() ?? return Err(legacy_import_error(.Gradle, "task declaration needs one literal name"))
            if &words.next() != None -> return Err(legacy_import_error(.Gradle, "task bodies and task options are not representable in the typed import"))
            &tasks.push(task.to_string())
            continue
        }
        if line.strip_prefix("rootProject.name") == .Val(rest) {
            (_, raw_value) :: rest.split_once('=') ?? return Err(legacy_import_error(.Gradle, "rootProject.name must assign one quoted literal"))
            value := raw_value.trim() // #4303
            quote :: value.chars().first() ?? return Err(legacy_import_error(.Gradle, "rootProject.name must assign one quoted literal"))
            if (quote != '\'' && quote != '"') || value.len() < 2 || !value.ends_with(quote) || value[1..<value.len() - 1].contains(quote) -> return Err(legacy_import_error(.Gradle, "rootProject.name must assign one quoted literal"))
            previous :: project
            project = Val(value[1..<value.len() - 1].to_string())
            if previous != None -> return Err(legacy_import_error(.Gradle, "rootProject.name must be declared once"))
            continue
        }
        return Err(legacy_import_error(.Gradle, "unsupported construct `{line}`"))
    }
    if tasks.len() != 1 -> return Err(legacy_import_error(.Gradle, if tasks.is_empty() -> "supported import needs tasks.register, tasks.create, or task" else -> "multiple or ambiguous task declarations are not supported"))
    task :: &tasks.pop() ?? panic("one Gradle task was checked")
    if task.is_empty() || task.chars().any(|ch| ch.is_whitespace()) -> return Err(legacy_import_error(.Gradle, "task name must be one literal word"))
    if (task == "build" || task == "assemble") && project == None -> return Err(legacy_import_error(.Gradle, "build or assemble import needs rootProject.name"))
    import.argv = Val(["gradle", task.to_string()])
    import.labels["legacy.task"] = ^task
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:839
fn parse_cargo_import(root: OSPath, source: String, import: &LegacyProjectImport) BuildError! {
    section := String{}
    package := String?{None}
    version := String?{None}
    bin_name := String?{None}
    bin_path := String?{None}
    bin_count := 0
    dependencies := [(String, String)]{}
    loop raw_line in source.lines() {
        line := (raw_line.split('#').first() ?? "").trim() // #4303
        if line.is_empty() -> continue
        if line.starts_with("[") && line.ends_with("]") {
            section = line.trim_matches('[').trim_matches(']').to_string()
            if !["package", "bin", "dependencies", "package.metadata.jet"].contains(section) -> return Err(legacy_import_error(.Cargo, "unsupported Cargo section"))
            if section == "bin" {
                bin_count += 1
                if bin_count > 1 -> return Err(legacy_import_error(.Cargo, "multiple binary targets are not supported"))
            }
            continue
        }
        (raw_key, raw) :: line.split_once('=') ?? return Err(legacy_import_error(.Cargo, "Cargo fields must use key = value"))
        key := raw_key.trim() // #4303
        value :: scalar_import_value(raw)
        match section {
            "package" => {
                match key {
                    "build" => return Err(legacy_import_error(.Cargo, "build scripts are not supported by the typed importer"))
                    "name" => { package = Val(value); import.labels["legacy.package.name"] = raw.trim().to_string() }
                    "version" => { version = Val(value); import.labels["legacy.package.version"] = raw.trim().to_string() }
                    _ => {
                        if !["edition", "rust-version", "authors", "description", "license", "license-file", "repository", "homepage", "documentation", "readme", "keywords", "categories", "exclude", "include", "publish"].contains(key) -> return Err(legacy_import_error(.Cargo, "unsupported [package] field {key}"))
                        import.labels["legacy.package.{key}"] = raw.trim().to_string()
                    }
                }
            }
            "bin" => {
                match key {
                    "name" => {
                        previous :: bin_name
                        bin_name = Val(value)
                        if previous != None -> return Err(legacy_import_error(.Cargo, "binary target names must be declared once"))
                        import.labels["legacy.bin.name"] = raw.trim().to_string()
                    }
                    "path" => {
                        previous :: bin_path
                        bin_path = Val(value)
