fn import_resource_pool(value: String) -> BuildResourcePool Never! {
    match value.to_ascii_lowercase() { "cpu" => .CPU; "memory" => .Memory; "linker" => .Linker; "console" => .Console; "gpu" => .GPU; _ => .Custom(value.to_string()) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:160
fn import_action_kind(value: String) -> ActionKind? Never! {
