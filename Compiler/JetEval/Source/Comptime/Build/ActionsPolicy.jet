    match kind { .CMake => parse_cmake_import(source, &import); .Make => parse_make_import(source, &import); .Gradle => parse_gradle_import(source, &import); .Npm => parse_npm_import(root, source, &import); .Cargo => parse_cargo_import(root, source, &import) }
    apply_import_directives(kind, source, &import)
    if (kind == .CMake || kind == .Gradle) && !import.outputs_explicit -> return Err(legacy_import_error(kind, "import must declare an exact build output with `jet: output=...`"))
