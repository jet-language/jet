    trimmed.to_string()
}
// Rust: crates/jet-comptime/src/Comptime/Build/actions_policy.rs:140
fn parse_import_array(value: String) -> [String] Never! {
    text := value.trim() // #4303
    if text.starts_with("[") && text.ends_with("]") -> split_import_words(text[1..<text.len() - 1]) else -> split_import_words(text)
}
