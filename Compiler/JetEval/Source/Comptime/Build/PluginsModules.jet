pub fn run_packaged_plugin(manifest_path: OSPath, component_path: OSPath, spec: WasmComponentPluginSpec, manifest_digest: String) -> PackagedPluginContribution Err! {
    PACKAGED_PLUGIN_RUNNER.with(fn(slot) {
        runner :: slot.get() ?? fail "packaged build-plugin host is not installed"
        runner(manifest_path, component_path, spec, manifest_digest)!
    })!
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:541
pub fn encode_build_plugin_request(spec: WasmComponentPluginSpec) -> [U8] {
    caps :: spec.requested_caps.iter().map(fn(cap) { cap.flag() }).collect()
    "version=1\nname={wire_scalar(spec.name)}\nplugin_version={wire_scalar(spec.version)}\napi_version={wire_scalar(spec.api_version)}\ncomponent_digest={wire_scalar(spec.component_digest)}\ncapabilities={wire_list(caps)}\n".into_bytes()
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:556
pub fn decode_build_plugin_response(bytes: [U8]) -> PackagedPluginContribution Err! {
    if bytes.len() > BUILD_PLUGIN_MAX_RESPONSE_BYTES -> fail "build plugin response exceeds {BUILD_PLUGIN_MAX_RESPONSE_BYTES} bytes"
    text :: String.from_utf8(bytes) catch _ { fail "build plugin response is not UTF-8" }
    version := None as USize?
    status := None as String?
    error := None as String?
    action_count := None as USize?
    target_count := None as USize?
    generated_count := None as USize?
    actions := [PackagedPluginAction]{}
    targets := [PackagedPluginTarget]{}
    generated_modules := [GeneratedModuleSpec]{}
    top_level_fields := BTreeSet<String>.new()
    loop line in text.lines() {
        top_level :: ["version=", "status=", "error=", "actions=", "targets=", "generated="].iter().find(fn(prefix) { line.starts_with(prefix) })
        if top_level == Some(field) {
            if !top_level_fields.insert(field) -> fail "build plugin response field {field.trim_end_matches('=')} is declared more than once"
        }
        if line.strip_prefix("version=") == Some(value) -> version = Some(parse_wire_count(value, "version")!)
        else if line.strip_prefix("status=") == Some(value) -> status = Some(value)
        else if line.strip_prefix("error=") == Some(value) -> error = Some(wire_unscalar(value, "plugin error")!)
        else if line.strip_prefix("actions=") == Some(value) -> action_count = Some(parse_wire_count(value, "actions")!)
        else if line.strip_prefix("targets=") == Some(value) -> target_count = Some(parse_wire_count(value, "targets")!)
        else if line.strip_prefix("generated=") == Some(value) -> generated_count = Some(parse_wire_count(value, "generated")!)
        else if line.strip_prefix("action\t") == Some(value) -> actions.push(decode_packaged_action(value)!)
        else if line.strip_prefix("target\t") == Some(value) -> targets.push(decode_packaged_target(value)!)
        else if line.strip_prefix("generated\t") == Some(value) {
            fields :: value.split('\t').collect()
            if fields.len() != 3 -> fail "generated plugin entry needs name, path, and source"
            generated_modules.push(GeneratedModuleSpec.new(wire_unscalar(fields[0], "generated name")!, wire_unscalar(fields[1], "generated path")!, wire_unscalar(fields[2], "generated source")!))
        } else if !line.trim().is_empty() -> fail "unknown build plugin response field: {line}"
    }
    if version != Some(1) -> fail "unsupported build plugin response version"
    if status != Some("ok") -> fail (error ?? "build plugin returned a failure")
    if error != None -> fail "build plugin success response contains an error field"
    loop (name, count) in [("actions", action_count), ("targets", target_count), ("generated", generated_count)] {
        if count == Some(count) {
            if count > BUILD_PLUGIN_MAX_WIRE_ITEMS -> fail "build plugin {name} count exceeds {BUILD_PLUGIN_MAX_WIRE_ITEMS}"
        }
    }
    if action_count != Some(actions.len()) || target_count != Some(targets.len()) || generated_count != Some(generated_modules.len()) -> fail "build plugin response count does not match its entries"
    PackagedPluginContribution{actions: ^actions, targets: ^targets, generated_modules: ^generated_modules}
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:657
fn decode_packaged_action(value: String) -> PackagedPluginAction Err! {
    fields :: value.split('\t').collect()
    if fields.len() != 17 -> fail "plugin action needs 17 fields"
    PackagedPluginAction{name: wire_unscalar(fields[0], "action name")!, inputs: wire_unlist(fields[1], "action inputs")!, outputs: wire_unlist(fields[2], "action outputs")!, argv: wire_unlist(fields[3], "action argv")!,
        env: wire_unmap(fields[4], "action env")!, env_allowlist: wire_unlist(fields[5], "action env allowlist")!.iter().collect(),
        caps: wire_unlist(fields[6], "action abilities")!.iter().collect(), cache: wire_unscalar(fields[7], "action cache")!, kind: wire_unscalar(fields[8], "action kind")!,
        toolchain: wire_optional(fields[9], "action toolchain")!, probes: wire_unlist(fields[10], "action probes")!, signing_identity: wire_optional(fields[11], "action signing identity")!,
        labels: wire_unmap(fields[12], "action labels")!, helper_versions: wire_unmap(fields[13], "action helper versions")!, resource_pools: wire_unlist(fields[14], "action resource pools")!.iter().collect(),
        legacy_wrapper: wire_optional(fields[15], "action legacy wrapper")!, variant_identity: wire_optional(fields[16], "action variant identity")!}
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:689
fn decode_packaged_target(value: String) -> PackagedPluginTarget Err! {
    fields :: value.split('\t').collect()
    if fields.len() != 11 -> fail "plugin target needs 11 fields"
    PackagedPluginTarget{kind: wire_unscalar(fields[0], "target kind")!, name: wire_unscalar(fields[1], "target name")!, sources: wire_unlist(fields[2], "target sources")!, inputs: wire_unlist(fields[3], "target inputs")!,
        outputs: wire_unlist(fields[4], "target outputs")!, deps: wire_unlist(fields[5], "target dependencies")!, actions: wire_unlist(fields[6], "target actions")!, probes: wire_unlist(fields[7], "target probes")!,
        toolchain: wire_optional(fields[8], "target toolchain")!, signing_identity: wire_optional(fields[9], "target signing identity")!, metadata: wire_unmap(fields[10], "target metadata")!}
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:709
fn wire_scalar(value: String) -> String { hex_encode(value.as_bytes()) }
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:713
fn wire_unscalar(value: String, field: String) -> String Err! { String.from_utf8(hex_decode(value)!) catch _ { fail "{field} is not UTF-8" } }
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:717
fn wire_optional(value: String, field: String) -> String? Err! { if value.is_empty() -> None else -> Some(wire_unscalar(value, field)!) }
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:725
fn wire_list(values: [String]) -> String {
    out := "{values.len()}:"
    loop value in values {
        bytes :: value.as_bytes()
        out += "{bytes.len()}:"
        out += hex_encode(bytes)
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:738
fn wire_unlist(value: String, field: String) -> [String] Err! {
    (count_text, initial_rest) :: value.split_once(':') ?? fail "{field} list has no count"
    count :: count_text.parse<USize>() catch _ { fail "{field} list count is invalid" }
    if count > BUILD_PLUGIN_MAX_WIRE_ITEMS -> fail "{field} list contains too many items (maximum {BUILD_PLUGIN_MAX_WIRE_ITEMS})"
    rest := initial_rest // #4303
    values := [String].with_capacity(count)
    loop _ in 0..count {
        (len_text, next) :: rest.split_once(':') ?? fail "{field} list item has no length"
        len :: len_text.parse<USize>() catch _ { fail "{field} list item length is invalid" }
        encoded_len :: len.checked_mul(2) ?? fail "{field} list item length overflows"
