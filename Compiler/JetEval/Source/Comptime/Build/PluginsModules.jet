    pub fn with_api_version(self, api_version: String) -> WasmComponentPluginSpec { self.api_version = ^api_version; ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:51
    pub fn with_capability(self, cap: BuildCapability) -> WasmComponentPluginSpec { _ :: self.requested_caps.insert(cap); ^self }
    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:58
    pub fn load_packaged(manifest_path: OSPath, component_path: OSPath) -> WasmComponentPluginSpec Err! {
