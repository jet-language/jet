// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:498
pub type PackagedPluginRunner = fn(OSPath, OSPath, WasmComponentPluginSpec, String) -> PackagedPluginContribution Err!
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:501
// GATE #4494: real per-thread callback slot, never a process-global replacement.
PACKAGED_PLUGIN_RUNNER :: ThreadLocal<Cell<PackagedPluginRunner?>>.new(fn() { Cell.new(None) })
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:509
pub fn with_packaged_plugin_runner<R>(runner: PackagedPluginRunner, body: fn() -> R) -> R {
    previous :: PACKAGED_PLUGIN_RUNNER.with(fn(slot) { slot.replace(Some(runner)) })
    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:513
    // Scope exit restores the slot on every unwind/error path, including nesting.
    defer -> PACKAGED_PLUGIN_RUNNER.with(fn(slot) { slot.set(previous) })
    body()
}
