impl WasmComponentPluginSpec {
    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:32
    pub fn new(name: String, version: String, component_digest: String) -> WasmComponentPluginSpec {
        WasmComponentPluginSpec{name: ^name, version: ^version, api_version: BUILD_PLUGIN_API_VERSION.to_string(), component_digest: ^component_digest, requested_caps: BTreeSet<BuildCapability>.new()}
    }
