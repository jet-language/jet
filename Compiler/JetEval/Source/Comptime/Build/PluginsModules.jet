fn hex_decode(value: String) -> [U8] Err! {
    if value.len() % 2 != 0 -> fail "plugin wire hex has odd length"
    bytes :: value.as_bytes()
    out := [U8].with_capacity(bytes.len() / 2)
    loop pair in bytes.chunks_exact(2) {
        high :: Char.from(pair[0]).to_digit(16) ?? fail "plugin wire hex is invalid"
        low :: Char.from(pair[1]).to_digit(16) ?? fail "plugin wire hex is invalid"
        out.push(((high << 4) | low) as U8)
    }
    ^out
}
