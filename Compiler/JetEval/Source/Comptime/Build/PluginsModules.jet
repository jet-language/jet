    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:91
    pub fn load_packaged_bytes(manifest: [U8], component: [U8]) -> WasmComponentPluginSpec Err! {
        if manifest.len() > BUILD_PLUGIN_MAX_MANIFEST_BYTES -> fail "plugin manifest exceeds {BUILD_PLUGIN_MAX_MANIFEST_BYTES} bytes"
        if component.len() > BUILD_PLUGIN_MAX_COMPONENT_BYTES -> fail "plugin component exceeds {BUILD_PLUGIN_MAX_COMPONENT_BYTES} bytes"
        manifest_text :: String.from_utf8(manifest) catch _ { fail "plugin manifest is not UTF-8" }
        spec :: WasmComponentPluginSpec.from_manifest_text(manifest_text)!
        actual :: ContentDigest.from_bytes(component).as_str().to_string()
        if spec.component_digest != actual -> fail "plugin component digest mismatch: manifest declares {spec.component_digest}, bytes are {actual}"
        validate_component_binary(component)!
        ^spec
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:118
    pub fn from_manifest_text(text: String) -> WasmComponentPluginSpec Err! {
        if text.len() > BUILD_PLUGIN_MAX_MANIFEST_BYTES -> fail "plugin manifest exceeds {BUILD_PLUGIN_MAX_MANIFEST_BYTES} bytes"
        name := None as String?
        version := None as String?
        api_version := None as String?
        component_digest := None as String?
        requested_caps := BTreeSet<BuildCapability>.new()
        fields := BTreeSet<String>.new()
        loop raw_line in text.lines() {
            line := manifest_line_without_comment(raw_line).trim() // #4303
            if line.is_empty() -> continue
            (raw_key, raw_value) :: line.split_once('=') ?? fail "plugin manifest line {line} needs key = value"
            key := raw_key.trim() // #4303
            value := raw_value.trim() // #4303
            if !fields.insert(key) -> fail "plugin manifest field {key} is declared more than once"
            if key == {
                "name" -> name = Some(manifest_string(value, key)!)
                "version" -> version = Some(manifest_string(value, key)!)
                "api_version" -> api_version = Some(manifest_string(value, key)!)
                "component_digest" -> component_digest = Some(manifest_string(value, key)!)
                "capabilities" -> requested_caps = manifest_capabilities(value)!
                else -> fail "unknown plugin manifest field {key}"
            }
        }
        name :: name ?? fail "plugin manifest is missing name"
        version :: version ?? fail "plugin manifest is missing version"
        api_version :: api_version ?? fail "plugin manifest is missing api_version"
        declared_digest :: component_digest ?? fail "plugin manifest is missing component_digest"
        digest :: ContentDigest.parse(declared_digest) catch error { fail "invalid plugin component digest: {error}" }
        spec :: WasmComponentPluginSpec{name: ^name, version: ^version, api_version: ^api_version, component_digest: digest.as_str().to_string(), requested_caps: ^requested_caps}
        if spec.api_version != BUILD_PLUGIN_API_VERSION -> fail "unsupported build plugin API {spec.api_version}; expected {BUILD_PLUGIN_API_VERSION}"
        ^spec
    }
}

// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:179
fn manifest_line_without_comment(line: String) -> String {
    quoted := false
    escaped := false
    loop (index, ch) in line.char_indices() {
        if escaped { escaped = false; continue }
        if ch == {
            '\\' if quoted -> escaped = true
            '"' -> quoted = !quoted
            '#' if !quoted -> return line[..index]
            else -> {}
        }
    }
    line
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:197
fn reject_plugin_link(path: OSPath, label: String) -> Unit Err! {
    // GATE #4494/#4409: native lstat with its original IO error detail.
    metadata :: fs.symlink_metadata(path) catch error { fail "could not stat plugin {label}: {error}" }
    if metadata.file_type().is_symlink() || !metadata.is_file() -> fail "plugin {label} must be a regular non-symlink file"
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:209
pub fn read_packaged_file_bounded(path: OSPath, label: String, limit: USize) -> [U8] Err! {
    reject_plugin_link(path, label)!
    metadata :: fs.metadata(path) catch error { fail "could not stat plugin {label}: {error}" }
    if metadata.len() > U64.from(limit) -> fail "plugin {label} exceeds {limit} bytes"
    // GATE #4494: descriptor-backed open/read/metadata and scope-close.
    options := fs.OpenOptions.new()
    _ :: options.read(true)
    // GATE #4483: original cfg(unix) dispatch on selected target family.
    if selected_family() == "unix" -> _ :: options.custom_flags(0o400000 | 0o2000000)
    file :: options.open(path) catch error { fail "could not read plugin {label}: {error}" }
    defer -> file.close()
    opened_metadata :: file.metadata() catch error { fail "could not stat plugin {label}: {error}" }
    if !opened_metadata.is_file() -> fail "plugin {label} must be a regular file"
    bytes := [U8].with_capacity(USize.from(metadata.len()))
    file.take(U64.from(limit.saturating_add(1))).read_to_end(&bytes) catch error { fail "could not read plugin {label}: {error}" }
    if bytes.len() > limit -> fail "plugin {label} exceeds {limit} bytes"
    ^bytes
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:249
fn validate_component_binary(bytes: [U8]) -> Unit Err! {
    // Rust byte NUL is a byte value, not a Jet text escape.
    MAGIC :: [U8]{0, 0x61, 0x73, 0x6d}
    COMPONENT_VERSION :: [U8]{0x0d, 0x00, 0x01, 0x00}
    if bytes.len() < 8 || bytes[..4] != MAGIC || bytes[4..8] != COMPONENT_VERSION -> fail "plugin component is not a valid WebAssembly Component Model binary"
    offset := 8 as USize
    loop offset < bytes.len() {
        id :: bytes[offset]
        offset += 1
        if id > 13 -> fail "plugin component uses unknown section id {id}"
        length :: USize.from(read_u32_leb(bytes, &offset)!)
        end :: offset.checked_add(length) ?? fail "plugin component section length overflows"
        if end > bytes.len() -> fail "plugin component section is truncated"
        offset = end
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:281
fn read_u32_leb(bytes: [U8], offset: &USize) -> U32 Err! {
    value := 0 as U32
    loop shift in (0..35).step_by(7) {
        byte :: bytes.get(offset) ?? fail "plugin component section length is truncated"
        offset += 1
        if shift == 28 && byte & 0xf0 != 0 -> fail "plugin component section length overflows u32"
        value |= U32.from(byte & 0x7f) << shift
        if byte & 0x80 == 0 -> return value
    }
    fail "plugin component section length uses an overlong integer"
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:299
fn manifest_string(value: String, field: String) -> String Err! {
    trimmed := value.trim() // #4303
    value := trimmed.strip_prefix('"').and_then(fn(value) { value.strip_suffix('"') }) ?? fail "plugin manifest field {field} must be a quoted string" // #4303
    if value.is_empty() -> fail "plugin manifest field {field} cannot be empty"
    out := String.with_capacity(value.len())
    escaped := false
    loop ch in value.chars() {
        if escaped {
            if ch == { '"', '\\' -> out.push(ch); else -> fail "plugin manifest field {field} contains an unsupported escape" }
            escaped = false
        } else if ch == '\\' -> escaped = true
        else if ch == '"' -> fail "plugin manifest field {field} contains an unescaped quote"
        else -> out.push(ch)
    }
    if escaped -> fail "plugin manifest field {field} ends with an escape"
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/Build/plugins_modules.rs:337
fn manifest_capabilities(value: String) -> BTreeSet<BuildCapability> Err! {
    value := value.strip_prefix('[').and_then(fn(value) { value.strip_suffix(']') }) ?? fail "plugin manifest abilities must be a list" // #4303
    // GATE #4499: capability enum order and equality.
    capabilities := BTreeSet<BuildCapability>.new()
    loop raw_item in value.split(',') {
        item := raw_item.trim() // #4303
        if item.is_empty() -> continue
        name :: manifest_string(item, "abilities")!
        capability :: BuildCapability.parse(name) ?? fail "unknown build ability {name}"
        _ :: capabilities.insert(capability)
    }
    ^capabilities
}
