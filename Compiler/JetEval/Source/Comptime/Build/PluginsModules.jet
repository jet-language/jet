    pub fn load_packaged_with_manifest_digest(manifest_path: OSPath, component_path: OSPath) -> (WasmComponentPluginSpec, String) Err! {
        reject_plugin_link(manifest_path, "manifest")!
        reject_plugin_link(component_path, "component")!
        manifest :: read_packaged_file_bounded(manifest_path, "manifest", BUILD_PLUGIN_MAX_MANIFEST_BYTES)!
        component :: read_packaged_file_bounded(component_path, "component", BUILD_PLUGIN_MAX_COMPONENT_BYTES)!
