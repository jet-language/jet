    fn check_toolchain_ref(self, toolchain: ToolchainHandle) -> Unit BuildError! {
        if toolchain.context != self.context || toolchain.id.0 >= self.toolchains.len() -> fail BuildError.UnknownToolchain(toolchain.id)
    }
