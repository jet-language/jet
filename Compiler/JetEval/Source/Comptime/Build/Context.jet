    fn resolve_packaged_contribution(self, wire: PackagedPluginContribution) -> PluginContribution BuildError! {
        if wire.actions.len() > MAX_ACTIONS.saturating_sub(self.actions.len()) -> fail BuildError.PackagedPlugin("action graph exceeds {MAX_ACTIONS} actions")
        action_names := [String: ActionHandle]{:}
        loop (index, action) in wire.actions.iter().enumerate() {
            if self.action_names.contains(action.name) -> fail BuildError.DuplicateActionName(action.name)
            action_names[action.name] = ActionHandle{id: ActionId(self.actions.len() + index), context: self.context}
        }
        if action_names.len() != wire.actions.len() -> fail BuildError.PackagedPlugin("packaged plugin declares a duplicate action name")
        target_indices := [String: USize]{:}
        loop (index, target) in wire.targets.iter().enumerate() {
            if self.target_names.contains(target.name) -> fail BuildError.DuplicateTargetName(target.name)
            if target_indices.contains_key(target.name) -> fail BuildError.PackagedPlugin("packaged plugin declares a duplicate target name")
            target_indices[target.name] = index
        }
        target_states := [U8].repeat(0, wire.targets.len())
        target_order := [USize].with_capacity(wire.targets.len())
        target_visiting := [USize]{}
        loop index in 0..wire.targets.len() -> visit_packaged_target(index, wire.targets, target_indices, self.target_names, &target_states, &target_visiting, &target_order)!
        target_names := [String: TargetRef]{:}
        loop (order_index, target_index) in target_order.iter().enumerate() {
            target_names[wire.targets[target_index].name] = TargetRef{id: TargetId(self.targets.len() + order_index), context: self.context}
        }
        actions := [(String, ActionSpec)].with_capacity(wire.actions.len())
        loop action in ^wire.actions {
            name :: action.name
            toolchain :: if action.toolchain == { Some(name) -> Some(self.named_toolchain(name)!); None -> None }
            probes :: action.probes.iter().map(fn(name) { self.named_probe(name)! }).collect()!
            signing_identity :: if action.signing_identity == { Some(name) -> Some(self.named_signing_identity(name)!); None -> None }
            cache :: if action.cache == { "cached" -> ActionCache.Cached; "phony", "uncached-phony" -> ActionCache.UncachedPhony; other -> fail BuildError.PackagedPlugin("action {name} has unknown cache mode {other}") }
            kind :: parse_packaged_action_kind(action.kind)!
            // GATE #4499: exact capability/resource-pool enum ordering and equality.
            caps := BTreeSet<BuildCapability>.new()
            loop ability in action.caps {
                cap :: BuildCapability.parse(ability) ?? fail BuildError.PackagedPlugin("action {name} declares unknown ability {ability}")
                _ :: caps.insert(cap)
            }
            resource_pools := BTreeSet<BuildResourcePool>.new()
            loop pool in action.resource_pools -> _ :: resource_pools.insert(parse_packaged_resource_pool(pool))
            legacy_wrapper :: if action.legacy_wrapper == { Some(value) -> Some(parse_packaged_legacy_wrapper(value)!); None -> None }
            spec :: ActionSpec{inputs: packaged_paths(action.inputs)!, outputs: packaged_paths(action.outputs)!, argv: ^action.argv,
                env: ^action.env, env_allowlist: ^action.env_allowlist, caps: ^caps, cache: cache, kind: kind,
                toolchain: toolchain, probes: ^probes, signing_identity: signing_identity, labels: ^action.labels,
                helper_versions: ^action.helper_versions, resource_pools: ^resource_pools, legacy_wrapper: legacy_wrapper, variant_identity: ^action.variant_identity}
            actions.push((^name, ^spec))
        }
        targets := [PluginTargetSpec].with_capacity(target_order.len())
        loop target_index in target_order {
            target :: wire.targets[target_index]
            deps := [TargetRef].with_capacity(target.deps.len())
            loop name in target.deps {
                deps.push(target_names.get(name) ?? self.named_target(name).ok() ?? fail BuildError.PackagedPlugin("target {target.name} references unknown target {name}"))
            }
            target_actions := [ActionHandle].with_capacity(target.actions.len())
            loop name in target.actions {
                target_actions.push(action_names.get(name) ?? self.named_action(name).ok() ?? fail BuildError.PackagedPlugin("target {target.name} references unknown action {name}"))
            }
            probes :: target.probes.iter().map(fn(name) { self.named_probe(name)! }).collect()!
            toolchain :: if target.toolchain == { Some(name) -> Some(self.named_toolchain(name)!); None -> None }
            signing_identity :: if target.signing_identity == { Some(name) -> Some(self.named_signing_identity(name)!); None -> None }
            spec :: TargetSpec{sources: packaged_paths(target.sources)!, inputs: packaged_paths(target.inputs)!, outputs: packaged_paths(target.outputs)!,
                deps: ^deps, actions: ^target_actions, probes: ^probes, toolchain: toolchain, signing_identity: signing_identity, metadata: target.metadata}
            targets.push(PluginTargetSpec{kind: parse_packaged_target_kind(target.kind)!, name: target.name, spec: ^spec})
        }
        PluginContribution{actions: ^actions, targets: ^targets, generated_modules: ^wire.generated_modules}
    }
