    fn snapshot(self, default: TargetRef?) -> BuildPlan BuildError! {
        if self.actions.len() > MAX_ACTIONS -> fail BuildError.PackagedPlugin("action graph exceeds {MAX_ACTIONS} actions")
        loop target in self.targets -> self.validate_refs(target.deps, target.actions)!
        validate_action_output_owners(self.actions)!
