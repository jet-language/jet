// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:507
fn visit_packaged_target(index: USize, targets: [PackagedPluginTarget], target_indices: [String: USize], existing_targets: HashSet<String>, states: &[U8], visiting: &[USize], order: &[USize]) -> Unit BuildError! {
    if states[index] == {
        2 -> return
        1 -> {
            cycle :: closed_cycle(visiting, index, fn(node: USize) { targets[node].name })
            fail BuildError.PackagedPlugin("packaged plugin target dependency cycle: {cycle.chain()}")
        }
        else -> {}
    }
    states[index] = 1
    visiting.push(index)
    loop dependency in targets[index].deps {
        if target_indices.get(dependency) == Some(dependency_index) -> visit_packaged_target(dependency_index, targets, target_indices, existing_targets, &states, &visiting, &order)!
        else if !existing_targets.contains(dependency) -> fail BuildError.PackagedPlugin("target {targets[index].name} references unknown target {dependency}")
    }
    _ :: visiting.pop()
    states[index] = 2
    order.push(index)
}

// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1134
fn packaged_paths(paths: [String]) -> [BuildPath] BuildError! { paths.iter().map(fn(path) { BuildPath.new(path)! }).collect()! }
// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1141
fn parse_packaged_action_kind(value: String) -> ActionKind BuildError! {
    if value == { "compile" -> .Compile; "docs" -> .Docs; "debug" -> .Debug; "source-archive" -> .SourceArchive; "generic" -> .Generic; else -> fail BuildError.PackagedPlugin("unknown action kind {value}") }
}
// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1154
fn parse_packaged_resource_pool(value: String) -> BuildResourcePool {
    if value == { "cpu" -> .CPU; "memory" -> .Memory; "linker" -> .Linker; "console" -> .Console; "gpu" -> .GPU; custom -> .Custom(custom) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1165
fn parse_packaged_legacy_wrapper(value: String) -> LegacyWrapperKind BuildError! {
    if value == { "cmake" -> .CMake; "make" -> .Make; "gradle" -> .Gradle; "npm" -> .Npm; "cargo" -> .Cargo; else -> fail BuildError.PackagedPlugin("unknown legacy wrapper {value}") }
}
// Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1178
fn parse_packaged_target_kind(value: String) -> TargetKind BuildError! {
    if value == { "executable" -> .Executable; "library" -> .Library; "test" -> .Test; "asset-bundle" -> .AssetBundle; "doc" -> .Doc; "install" -> .Install; "package" -> .Package; "publish" -> .Publish; else -> fail BuildError.PackagedPlugin("unknown target kind {value}") }
}
