    fn check_target_ref(self, target: TargetRef) -> Unit BuildError! {
        if target.context != self.context || target.id.0 >= self.targets.len() -> fail BuildError.UnknownTarget(target.id)
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1096
    fn check_action_ref(self, action: ActionHandle) -> Unit BuildError! {
        if action.context != self.context || action.id.0 >= self.actions.len() -> fail BuildError.UnknownAction(action.id)
    }
