        loop probe in spec.probes -> self.check_probe_ref(probe)!
        if spec.signing_identity == Some(identity) -> self.check_signing_identity_ref(identity)!
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:1075
    fn validate_refs(self, deps: [TargetRef], actions: [ActionHandle]) -> Unit BuildError! {
