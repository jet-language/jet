    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:965
    fn push_target(&self, name: String, kind: TargetKind, spec: TargetSpec) -> TargetId BuildError! { self.push_target_with_plugin(name, kind, spec, None)! }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:974
    fn push_target_with_plugin(&self, name: String, kind: TargetKind, spec: TargetSpec, plugin: PluginHandle?) -> TargetId BuildError! {
        name :: check_name(name, .Target)!
        if self.target_names.contains(name) -> fail BuildError.DuplicateTargetName(name)
        self.validate_target_spec(spec)!
        _ :: self.target_names.insert(name)
        toolchain :: spec.toolchain ?? self.default_toolchain
        id :: TargetId(self.targets.len())
        self.targets.push(BuildTarget{id: id, name: ^name, kind: kind, sources: ^spec.sources, inputs: ^spec.inputs,
            outputs: ^spec.outputs, deps: ^spec.deps, actions: ^spec.actions, probes: ^spec.probes,
            toolchain: toolchain, signing_identity: spec.signing_identity, metadata: ^spec.metadata, plugin: plugin})
        id
    }
