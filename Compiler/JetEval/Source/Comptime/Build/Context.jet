    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:780
    fn validate_plugin_policy(self, spec: WasmComponentPluginSpec, policy: BuildPolicy) -> BTreeSet<BuildCapability> BuildError! {
        validate_plugin_spec(spec)!
        if spec.api_version != BUILD_PLUGIN_API_VERSION -> fail BuildError.PluginVersionMismatch(plugin: spec.name, expected: BUILD_PLUGIN_API_VERSION.to_string(), actual: spec.api_version)
        if policy.wasm_plugins == .Deny(reason) -> fail BuildError.PolicyDenied(PolicyExplanation.denied("wasm build plugin {spec.name}", reason, spec.requested_caps.iter().collect()))
        grants :: policy.plugin_grants.get(spec.name).map(fn(row) { row.clone() }) ?? BTreeSet<BuildCapability>.new()
        loop cap in spec.requested_caps {
            if !grants.contains(cap) -> fail BuildError.PolicyDenied(PolicyExplanation.denied("wasm build plugin {spec.name}", "missing ability grant {cap_name(cap)}", spec.requested_caps.iter().collect()))
        }
        grants
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:817
    fn apply_wasm_component_plugin_inner(&self, spec: WasmComponentPluginSpec, contribution: PluginContribution, policy: BuildPolicy) -> PluginApplication BuildError! {
        grants :: self.validate_plugin_policy(spec, policy)!
        loop (_, action) in contribution.actions {
            loop cap in action.caps {
                if !spec.requested_caps.contains(cap) || !grants.contains(cap) {
                    reason :: if !spec.requested_caps.contains(cap) -> "contributed action uses ability {cap_name(cap)} not declared by the plugin manifest" else -> "contributed action uses ungranted ability {cap_name(cap)}"
                    fail BuildError.PolicyDenied(PolicyExplanation.denied("wasm build plugin {spec.name}", reason, action.caps.iter().collect()))
                }
            }
        }
        plugin_id :: PluginId(self.plugins.len())
        plugin :: PluginHandle{id: plugin_id, context: self.context}
        self.plugins.push(BuildPlugin{id: plugin_id, name: ^spec.name, version: ^spec.version, api_version: ^spec.api_version, component_digest: ^spec.component_digest, grants: ^grants})
        action_handles := [ActionHandle]{}
        loop (name, action) in ^contribution.actions -> action_handles.push(self.push_action(name, action, Some(plugin))!)
        target_handles := [TargetRef]{}
        loop target in ^contribution.targets {
            id :: self.push_target_with_plugin(target.name, target.kind, target.spec, Some(plugin))!
            target_handles.push(TargetRef{id: id, context: self.context})
        }
        module_handles := [GeneratedModuleHandle]{}
        loop module in ^contribution.generated_modules {
            validate_generated_module(module)!
            handle :: self.push_generated_module(module, Some(plugin))!
            module_handles.push(GeneratedModuleHandle{id: handle.id(), context: self.context})
        }
        PluginApplication{plugin: plugin, actions: ^action_handles, targets: ^target_handles, generated_modules: ^module_handles}
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:895
    fn push_action(&self, name: String, spec: ActionSpec, plugin: PluginHandle?) -> ActionHandle BuildError! {
        if self.actions.len() >= MAX_ACTIONS -> fail BuildError.PackagedPlugin("action graph exceeds {MAX_ACTIONS} actions")
        name :: check_name(name, .Action)!
        if self.action_names.contains(name) -> fail BuildError.DuplicateActionName(name)
        self.validate_action_spec(name, spec)!
        if self.generated_modules.iter().find(fn(module) { spec.outputs.iter().any(fn(output) { output == module.path }) }) == Some(module) -> fail BuildError.GeneratedModuleCycle(module: module.name, path: module.path.as_str().to_string())
        _ :: self.action_names.insert(name)
        toolchain :: spec.toolchain ?? self.default_toolchain
        id :: ActionId(self.actions.len())
        self.actions.push(BuildAction{id: id, name: ^name, inputs: ^spec.inputs, outputs: ^spec.outputs, argv: ^spec.argv,
            env: ^spec.env, env_allowlist: ^spec.env_allowlist, caps: ^spec.caps, cache: spec.cache, kind: spec.kind,
            toolchain: toolchain, probes: ^spec.probes, signing_identity: spec.signing_identity, labels: ^spec.labels,
            helper_versions: ^spec.helper_versions, resource_pools: ^spec.resource_pools, legacy_wrapper: ^spec.legacy_wrapper,
            plugin: plugin, variant_identity: ^spec.variant_identity, compiler_owned: false})
        ActionHandle{id: id, context: self.context}
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:952
    pub fn plan(self) -> BuildPlan BuildError! { self.snapshot(None)! }
    // Rust: crates/jet-comptime/src/Comptime/Build/context.rs:956
