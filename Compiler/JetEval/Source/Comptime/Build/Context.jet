            context: context, targets: [], actions: [],
            toolchains: [BuildToolchain{id: ToolchainId(0), name: "host", role: .Host,
                host_triple: "host", target_triple: "host", sdk: None, linker: None, sysroot: None,
                tools: [:], resolution: .Ambient, mounts: [], provenance: BuildProvenance.inferred_host()}],
            signing_identities: [], probes: [], plugins: [], generated_modules: [],
            target_names: HashSet<String>.new(), action_names: HashSet<String>.new(), toolchain_names: ^names,
            signing_identity_names: HashSet<String>.new(), probe_names: HashSet<String>.new(),
