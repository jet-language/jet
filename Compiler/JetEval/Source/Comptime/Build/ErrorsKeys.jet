// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:30
#Error
pub enum BuildError {
    EmptyTargetName
    EmptyActionName
    EmptyToolchainName
    EmptySigningIdentityName
    EmptyProbeName
    DuplicateTargetName(String)
    DuplicateActionName(String)
    CompilerPackageDependencyMissing { package: String, dependency: String }
    DuplicateToolchainName(String)
    DuplicateSigningIdentityName(String)
    DuplicateProbeName(String)
    EmptyPath
    InvalidPath(String)
    EmptyToolchainTriple(String)
    EmptyIdentityField(String)
    MissingLockedProvenance(String)
    EmptyProbeField(String)
    EmptyActionArgv(String)
    EmptyEnvName(String)
    UndeclaredEnvName { action: String, key: String }
    CachedActionWithoutOutputs(String)
    PhonyActionWithoutCaps(String)
    PhonyActionWithOutputs(String)
    DuplicateActionOutput { action: String, output: String }
    DuplicateBuildOutput { output: String, first_action: String, second_action: String }
    UnknownTarget(TargetId)
    UnknownAction(ActionId)
    UnknownToolchain(ToolchainId)
    UnknownSigningIdentity(SigningIdentityId)
    UnknownProbe(ProbeId)
    LegacyWrapperWithoutInputs(LegacyWrapperKind)
    LegacyWrapperWithoutOutputs(LegacyWrapperKind)
    LegacyWrapperWithoutCaps(LegacyWrapperKind)
    LegacyWrapperCommandMismatch { wrapper: LegacyWrapperKind, actual: String }
    LegacyProjectFileMissing(LegacyWrapperKind)
    LegacyProjectFileInvalid(String)
    PolicyDenied(PolicyExplanation)
    EmptyPluginField(String)
    InvalidPluginDigest(String)
    PackagedPlugin(String)
    PluginVersionMismatch { plugin: String, expected: String, actual: String }
    EmptyGeneratedModuleField(String)
    InvalidGeneratedModulePath(String)
    DuplicateGeneratedModuleName(String)
    DuplicateGeneratedModulePath(String)
    GeneratedModuleCycle { module: String, path: String }
    TargetDependencyCycle(DependencyCycle)
    ActionDependencyCycle(DependencyCycle)
}

// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:105
// Traversal order, including the repeated node, is the diagnostic.
pub struct DependencyCycle { names: [String] }
impl DependencyCycle {
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:115
    pub fn nodes(self: &DependencyCycle) -> &[String] { &self.names }
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:120
    pub fn chain(self: &DependencyCycle) -> String {
        self.names.iter().map(fn(node) { "`{node}`" }).collect::<[String]>().join(" -> ")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:130
impl std.fmt.Debug for DependencyCycle {
    fn fmt(self: &DependencyCycle, f: &std.fmt.Formatter) -> Unit std.fmt.Error! { f.write_str(self.chain())? }
}

// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:139
fn dependency_cycle_text(kind: &String, cycle: &DependencyCycle) -> String {
    "{kind} dependency graph contains a cycle: {cycle.chain()}; a cycle has no build order, so no {kind} in it can ever start; remove one dependency from that chain"
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:148
fn closed_cycle<N>(stack: &[N], repeated: N, name: fn(N) -> String) -> DependencyCycle {
    start := stack.iter().position(fn(node) { node == repeated }).unwrap_or(0)
    names: [String] = []
    for node in stack[start..] { names.push(name(node)) }
    names.push(name(repeated))
    DependencyCycle { names: ^names }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:168
// GATE #4499: ordered user-type set keys retain their native equality and ordering.
fn stalled_cycle<N>(remaining: &BTreeSet<N>, dependencies: fn(&N) -> [N], name: fn(&N) -> String) -> DependencyCycle {
    settled := BTreeSet<N>.new()
    for node in remaining {
        stack: [N] = []
        if cycle := walk_stalled(node, remaining, dependencies, &stack, &settled) {
            return DependencyCycle { names: cycle.iter().map(name).collect() }
        }
    }
    // A non-cycle stall still names every stuck node, as in the Rust fallback.
    DependencyCycle { names: remaining.iter().map(name).collect() }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:188
fn walk_stalled<N>(node: &N, remaining: &BTreeSet<N>, dependencies: fn(&N) -> [N], stack: &[N], settled: &BTreeSet<N>) -> [N]? {
    if settled.contains(node) { return None }
    if start := stack.iter().position(fn(entry) { entry == node }) {
        cycle := stack[start..].to_vec()
        cycle.push(node.clone())
        return Val(^cycle)
    }
    stack.push(node.clone())
    prerequisites := dependencies(node)
    prerequisites.sort()
    for prerequisite in &prerequisites {
        if !remaining.contains(prerequisite) { continue }
        if cycle := walk_stalled(prerequisite, remaining, dependencies, stack, settled) { return Val(^cycle) }
    }
    _ :: stack.pop()
    _ :: settled.insert(node.clone())
    None
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:221
fn target_cycle_error(plan: &BuildPlan, stack: &[TargetId], repeated: TargetId) -> BuildError {
    BuildError.TargetDependencyCycle(closed_cycle(stack, repeated, fn(target) {
        plan.targets.get(target.0).map(fn(t) { t.name.clone() }).unwrap_or_else(fn() { "target#{target.0}" })
    }))
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:236
fn action_cycle_error(plan: &BuildPlan, remaining: &BTreeSet<ActionId>, prerequisites: &[ActionId:[ActionId]]) -> BuildError {
    BuildError.ActionDependencyCycle(stalled_cycle(remaining,
        fn(action) { prerequisites.get(action).cloned().unwrap_or([]) },
        fn(action) { plan.actions.get(action.0).map(fn(a) { a.name.clone() }).unwrap_or_else(fn() { "action#{action.0}" }) }))
}

// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:253
fn canonical_action_key(plan: &BuildPlan, action: &BuildAction, inputs: &[ActionInputSnapshot]) -> ActionKey {
    w := KeyWriter.new()
    w.str("jet.action-key.v2")
    w.str("kind"); w.str(action.kind.as_str())
    w.str("observe-exact-source"); w.bool(action.kind.observes_exact_source())
    w.str("compiler-owned"); w.bool(action.compiler_owned)
    w.str("argv"); w.vec_str(action.argv.iter())
    w.str("env-allowlist"); env := allowlisted_env(action); w.map_str(&env)
    w.str("inputs"); w.vec_str(action.inputs.iter().map(fn(path) { path.as_str() }))
    w.str("input-snapshots")
    snapshots := inputs.iter().collect::<[&ActionInputSnapshot]>()
    snapshots.sort_by(fn(a, b) { a.path.cmp(&b.path) })
    if action.kind.observes_exact_source() {
        for path in &action.inputs {
            present := snapshots.iter().any(fn(s) { s.path.as_str() == path.as_str() })
            w.str(path.as_str()); w.bool(present)
        }
    }
    w.bytes.extend_from_slice((snapshots.len() as U64).to_be_bytes())
    for snapshot in snapshots {
        w.str(snapshot.path.as_str()); w.str(snapshot.digest.as_str())
        w.bytes.extend_from_slice(snapshot.byte_len.to_be_bytes())
    }
    w.str("outputs"); w.vec_str(action.outputs.iter().map(fn(path) { path.as_str() }))
    w.str("dep-outputs"); dep_outputs := declared_dep_outputs(plan, action); w.vec_str(dep_outputs.iter())
    w.str("caps")
    for cap in &action.caps { encode_capability(&w, cap) }
    w.str("cache"); encode_action_cache(&w, action.cache)
    w.str("compiler-version"); w.str(env!("CARGO_PKG_VERSION"))
    w.str("helper-versions"); w.map_str(&action.helper_versions)
    w.str("generated-modules")
    generated := plan.generated_modules.iter().collect::<[&_]>()
    generated.sort_by(fn(a, b) { a.path.cmp(&b.path) })
    for module in generated {
        w.str(module.path.as_str()); w.str(module.source_digest.as_str())
        if action.kind.observes_exact_source() { w.str(&module.source) }
    }
    w.str("build-fact-contributions")
    contributions := plan.fact_contributions().iter().collect::<[&_]>()
    contributions.sort_by(fn(left, right) {
        left.key.cmp(&right.key)
            .then_with(fn() { left.layer.cmp(&right.layer) })
            .then_with(fn() { left.scope.cmp(&right.scope) })
            .then_with(fn() { left.source.cmp(&right.source) })
            .then_with(fn() { left.reason.cmp(&right.reason) })
            .then_with(fn() { left.force.cmp(&right.force) })
            .then_with(fn() { left.force_reason.cmp(&right.force_reason) })
    })
    for contribution in contributions {
        w.str(&contribution.key); w.str(&format!("{:?}", contribution.value))
        w.str(contribution.scope.name()); w.str(contribution.layer.name()); w.str(&contribution.source)
        w.str(contribution.reason.as_deref().unwrap_or("")); w.bool(contribution.force)
        w.str(contribution.force_reason.as_deref().unwrap_or(""))
    }
    w.str("target")
    target := plan.action_targets().get(&action.id).and_then(fn(id) { plan.targets.get(id.0) })
    target == {
        Val(t) -> {
            w.bool(true); w.str(&t.name); w.str(&format!("{:?}", t.kind)); w.map_str(&t.metadata)
            w.vec_str(t.sources.iter().map(fn(path) { path.as_str() }))
        }
        None -> w.bool(false)
    }
    w.str("toolchain"); encode_toolchain(&w, &plan.toolchains[action.toolchain.id.0])
    w.str("probes")
    for probe in &action.probes { encode_probe(&w, plan, &plan.probes[probe.id.0]) }
    w.str("signing")
    action.signing_identity == {
        Val(identity) -> { w.bool(true); encode_signing_identity(&w, &plan.signing_identities[identity.id.0]) }
        None -> w.bool(false)
    }
    w.str("variant")
    action.variant_identity == { Val(identity) -> { w.bool(true); w.str(identity) }; None -> w.bool(false) }
    w.str("labels"); w.map_str(&action.labels)
    w.str("resource-pools")
    for pool in action_pools(action) { encode_resource_pool(&w, &pool) }
    w.str("legacy")
    action.legacy_wrapper == { Val(wrapper) -> { w.bool(true); w.str(wrapper.as_str()) }; None -> w.bool(false) }
    w.str("plugin")
    action.plugin == {
        Val(handle) -> {
            w.bool(true)
            plugin := &plan.plugins[handle.id.0]
            w.str(&plugin.name); w.str(&plugin.version); w.str(&plugin.api_version); w.str(&plugin.component_digest)
            for grant in &plugin.grants { encode_capability(&w, grant) }
        }
        None -> w.bool(false)
    }
    ActionKey("act-sha256:{SHA256.sha256_hex(&w.bytes)}")
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:409
fn allowlisted_env(action: &BuildAction) -> [String:String] {
    if action.env_allowlist.is_empty() { return action.env.clone() }
    env: [String:String] = [:]
    for (key, value) in &action.env {
        if action.env_allowlist.contains(key) { env.insert(key.clone(), value.clone()) }
    }
    env
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:421
fn declared_dep_outputs(plan: &BuildPlan, action: &BuildAction) -> [String] {
    target_id := plan.action_targets().get(&action.id) == { Val(id) -> id; None -> { return [] } }
    target := plan.targets.get(target_id.0) == { Val(t) -> t; None -> { return [] } }
    outs := BTreeSet<String>.new()
    for dep in &target.deps {
        dep_target := plan.targets.get(dep.id.0) == { Val(t) -> t; None -> { continue } }
        for path in dep_target.outputs.iter().chain(dep_target.inputs.iter()) { _ :: outs.insert(path.as_str().to_string()) }
        for dep_action in &dep_target.actions {
            if a := plan.actions.get(dep_action.id.0) {
                for path in &a.outputs { _ :: outs.insert(path.as_str().to_string()) }
            }
        }
    }
    outs.into_iter().collect()
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:447
fn canonical_effective_action_key(plan: &BuildPlan, action: &BuildAction, inputs: &[ActionInputSnapshot], grants: &BTreeSet<BuildCapability>, _executable: &OSPath, executable_digest: &ContentDigest, probe_facts: &[BuildProbeFact]) -> ActionKey {
    base := canonical_action_key(plan, action, inputs)
    w := KeyWriter.new()
    w.str("jet.effective-action-key.v1"); w.str(base.as_str())
    w.str("effective-policy")
    for grant in grants { encode_capability(&w, grant) }
    // Filesystem location is host-local; only executable bytes contribute identity.
    w.str("resolved-executable-digest"); w.str(executable_digest.as_str())
    w.str("actual-probe-facts")
    for fact in probe_facts {
        w.str(&fact.name); w.bool(fact.success); w.str(&fact.detail)
        w.str(&format!("{:?}", fact.reproducibility))
        w.str("{fact.toolchain.context}:{fact.toolchain.id.0}")
        w.str(fact.toolchain_provenance.as_str())
    }
    w.str("compiler-identity"); w.str("{env!(\"CARGO_PKG_NAME\")}@{env!(\"CARGO_PKG_VERSION\")}")
    ActionKey("act-sha256:{SHA256.sha256_hex(&w.bytes)}")
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:490
fn encode_action_cache(w: &KeyWriter, cache: ActionCache) {
    cache == { Cached -> w.str("cached"); UncachedPhony -> w.str("uncached-phony") }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:497
fn encode_capability(w: &KeyWriter, cap: &BuildCapability) { w.str(cap.flag()) }
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:501
fn encode_resource_pool(w: &KeyWriter, pool: &BuildResourcePool) {
    pool == {
        CPU -> w.str("cpu"); Memory -> w.str("memory"); Linker -> w.str("linker")
        Console -> w.str("console"); GPU -> w.str("gpu")
        Custom(name) -> { w.str("custom"); w.str(name) }
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:515
fn encode_toolchain(w: &KeyWriter, toolchain: &BuildToolchain) {
    w.str(&toolchain.name)
    toolchain.role == { Host -> w.str("host"); Target -> w.str("target") }
    w.str(&toolchain.host_triple); w.str(&toolchain.target_triple)
    toolchain.sdk == {
        Val(sdk) -> { w.bool(true); w.str(&sdk.name); w.str(&sdk.version); encode_provenance(w, &sdk.provenance) }
        None -> w.bool(false)
    }
    toolchain.linker == {
        Val(linker) -> { w.bool(true); w.str(&linker.name); encode_provenance(w, &linker.provenance) }
        None -> w.bool(false)
    }
    toolchain.sysroot == {
        Val(sysroot) -> { w.bool(true); w.str(&sysroot.name); w.str(&sysroot.path_digest); encode_provenance(w, &sysroot.provenance) }
        None -> w.bool(false)
    }
    w.str("tools"); w.map_str(&toolchain.tools)
    w.str("resolution")
    toolchain.resolution == { Ambient -> w.str("ambient"); DeclaredOnly -> w.str("declared-only") }
    w.str("mounts")
    for mount in &toolchain.mounts {
        w.str(&mount.destination)
        if mount.identity.is_empty() { w.str("path"); w.str(&mount.source) }
        else { w.str("identity"); w.str(&mount.identity) }
    }
    encode_provenance(w, &toolchain.provenance)
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:570
fn encode_signing_identity(w: &KeyWriter, identity: &BuildSigningIdentity) {
    w.str(&identity.name); w.str(&identity.label); encode_provenance(w, &identity.provenance)
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:576
fn encode_probe(w: &KeyWriter, plan: &BuildPlan, probe: &BuildProbe) {
    w.str(&probe.name)
    probe.kind == {
        FindProgram { program } -> { w.str("find-program"); w.str(program) }
        PkgConfig { package, min_version } -> {
            w.str("pkg-config"); w.str(package)
            min_version == { Val(version) -> { w.bool(true); w.str(version) }; None -> w.bool(false) }
        }
        HeaderCheck { header } -> { w.str("header-check"); w.str(header) }
        CompileCheck { name, includes, code } -> { w.str("compile-check"); w.str(name); w.vec_str(includes.iter()); w.str(code) }
    }
    probe.reproducibility == { Reproducible -> w.str("reproducible"); Ambient -> w.str("ambient") }
    encode_provenance(w, &probe.provenance)
    encode_toolchain(w, &plan.toolchains[probe.toolchain.id.0])
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:620
fn encode_provenance(w: &KeyWriter, provenance: &BuildProvenance) {
    provenance.source == {
        InferredHost -> w.str("inferred-host")
        JetpackDependency(dep) -> { w.str("jetpack-dependency"); w.str(dep) }
        AmbientRecord(record) -> { w.str("ambient-record"); w.str(record) }
        UserDeclared(source) -> { w.str("user-declared"); w.str(source) }
    }
    provenance.lock == { Val(lock) -> { w.bool(true); w.str(&lock.key); w.str(&lock.digest) }; None -> w.bool(false) }
}
// Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:646
struct KeyWriter { bytes: [U8] }
impl KeyWriter {
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:651
    fn new() -> KeyWriter { KeyWriter { bytes: [] } }
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:655
    fn str(self: &KeyWriter, value: &String) {
        self.bytes.extend_from_slice((value.as_bytes().len() as U64).to_be_bytes())
        self.bytes.extend_from_slice(value.as_bytes())
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:661
    fn bool(self: &KeyWriter, value: Bool) { self.bytes.push(if value { 1 } else { 0 }) }
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:665
    fn vec_str(self: &KeyWriter, values: impl Iterator<&String>) {
        collected := values.collect::<[&String]>()
        self.bytes.extend_from_slice((collected.len() as U64).to_be_bytes())
        for value in collected { self.str(value) }
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/errors_keys.rs:674
    fn map_str(self: &KeyWriter, map: &[String:String]) {
        self.bytes.extend_from_slice((map.len() as U64).to_be_bytes())
        keys := map.keys().collect::<[&String]>()
        keys.sort()
        for key in keys { self.str(key); self.str(&map[key]) }
    }
}
