//RS /// One dependency cycle, in the order the graph walk found it: every node
//RS /// from the first repeated node back to itself.
//RS ///
//RS /// The chain *is* the diagnostic — a cycle is only actionable when the whole
//RS /// loop is named — so `Debug` prints the chain instead of a field list.
//RS /// Reporters render `BuildError` both through `build_error_text` and through
//RS /// `{error:?}`, and both must name every node.
//RS #[derive(Clone, PartialEq, Eq)]
//RS pub struct DependencyCycle(Vec<String>);
//RS 
//RS impl DependencyCycle {
//RS     /// Node names in traversal order. The first name repeats as the last.
//RS     pub fn nodes(&self) -> &[String] {
//RS         &self.0
//RS     }
//RS 
//RS     /// The rendered loop: `` `a` -> `b` -> `a` ``.
//RS     pub fn chain(&self) -> String {
//RS         self.0
//RS             .iter()
//RS             .map(|node| format!("`{node}`"))
//RS             .collect::<Vec<_>>()
//RS             .join(" -> ")
//RS     }
//RS }
