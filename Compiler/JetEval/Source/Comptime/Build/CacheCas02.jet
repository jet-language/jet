        bytes :: secure_read_file_bounded(self.root, path, MAX_REMOTE_WIRE_BYTES + 256) catch error { fail RemoteCacheError.Io(error) }
        request :: decode_remote_execution_request(self.open("execution-request", bytes)!)!
        if request.key != key -> fail RemoteCacheError.InvalidRecord("execution request key does not match lookup key")
        if self.worker_identity == .Val(expected) -> self.validate_worker_identity(request.sandbox, expected)!
        if self.execution_is_cancelled(key, request.attempt_id)! -> fail RemoteCacheError.Io(io.Error.new(io.ErrorKind.NotFound, "remote execution was cancelled"))
        request
    }
