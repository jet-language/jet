fn encode_remote_record(record: ActionResultRecord) -> String {
    outcome :: encode_remote_outcome(record.outcome)
    status :: if record.provenance.status == { .Hit(reason) -> "hit:{reason.debug()}" .Miss(reason) -> "miss:{reason.debug()}" }
    failure :: if record.failure_report == { Val(report) -> hex_encode(report.to_json().bytes()) None -> "" }
    encoded := "version=2\nkey={hex_encode(record.key.as_str().bytes())}\noutcome={outcome}\nstatus={status}\nfailure={failure}\noutputs={record.outputs.len()}\n"
    loop output in record.outputs -> &encoded.push_str("output\t{output.path.as_str()}\t{output.digest.as_str()}\t{output.byte_len}\n")
