fn remove_remote_execution_file(path: OSPath) -> Unit RemoteCacheError! {
    metadata :: symlink_metadata(path) catch error { if error.kind() == io.ErrorKind.NotFound -> return else -> fail RemoteCacheError.Io(error) }
    if metadata.is_symlink || !metadata.is_file -> fail RemoteCacheError.Io(io.Error.new(io.ErrorKind.PermissionDenied, "remote execution path `{path}` is not a regular file"))
    remove(path) catch error { fail RemoteCacheError.Io(error) }
