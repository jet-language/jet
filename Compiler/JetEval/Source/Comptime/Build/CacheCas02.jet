// restore_declared_outputs uses restore_outputs directly; no obsolete forwarding alias.
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3345
pub fn restore_action_outputs(store: BuildArtifactStore, base: OSPath, action: BuildAction, record: ActionResultRecord) -> Unit io.Error! {
    if record.outputs.len() != action.outputs.len() -> fail io.Error.new(io.ErrorKind.InvalidData, "cached output record does not exactly match action declarations")
    loop index in 0..<record.outputs.len() { if record.outputs[index].path != action.outputs[index] -> fail io.Error.new(io.ErrorKind.InvalidData, "cached output record does not exactly match action declarations") }
    restore_outputs(store, base, record)!
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3366
pub fn restore_outputs(store: BuildArtifactStore, base: OSPath, record: ActionResultRecord) -> Unit io.Error! {
    loop output in record.outputs {
        path :: resolve_under(base, output.path.as_str())!
        bytes :: store.get_blob(output.digest)! ?? fail io.Error.new(io.ErrorKind.NotFound, "CAS blob is missing")
        atomic_restore_file(base, path, bytes)!
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3382
pub fn secure_read_file(base: OSPath, path: OSPath) -> [U8] io.Error! {
    if selected_family() != "unix" -> return secure_read_file_nonunix(base, path)!
    // GATE #4494: borrowed descriptor-relative nofollow opens and consuming Close.
    relative :: path.strip_prefix(base) ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path escapes root")
    file_name :: relative.file_name_component() ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path has no file name")
    root :: open_directory(base, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
    held := [Directory]{}
    if relative.parent() == .Val(parent) {
        cursor := components(parent)
        loop {
            part :: next(parent, &cursor) ?? break
            if part.kind != ComponentKind.Normal -> next
            if parent.component_bytes(part).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in cache path")
            // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3393 (openat)
            child :: if held.is_empty() -> root.open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})! else -> held[held.len() - 1].open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
            &held.push(^child)
        }
    }
    if relative.component_bytes(file_name).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in cache path")
    file :: if held.is_empty() -> root.open_reader(relative, file_name, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})! else -> held[held.len() - 1].open_reader(relative, file_name, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
    if !file.stat()!.is_file -> fail io.Error.new(io.ErrorKind.PermissionDenied, "cache entry is not a regular file")
    file.read_to_end()!
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3457
fn secure_read_file_nonunix(base: OSPath, path: OSPath) -> [U8] io.Error! {
    relative :: path.strip_prefix(base) ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path escapes root")
    current := base
    loop component in relative.components() {
        if component == .Normal(part) {
            &current.push(part)
            if symlink_metadata(current)!.is_symlink -> fail io.Error.new(io.ErrorKind.PermissionDenied, "cache path contains a symlink")
        }
    }
    fs.read(current)!
}
