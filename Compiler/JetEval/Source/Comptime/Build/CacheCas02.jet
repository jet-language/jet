    pub fn publish_execution_result(self, result: RemoteExecutionResult, policy: RemoteCachePolicy) -> Unit RemoteCacheError! {
        policy.check(RemoteActionRequest.Execute) catch error { fail RemoteCacheError.Denied(error) }
        self.require_auth(RemoteActionRequest.Execute)!
        self.require_worker_identity()!
        self.validate_policy_identity(policy)!
        self.validate_proof_for_key(policy, result.key, RemoteActionRequest.Execute)!
        self.validate_sandbox_proof(policy, result.sandbox, RemoteActionRequest.Execute)!
        if self.worker_identity == .Val(expected) -> self.validate_worker_identity(result.sandbox, expected)!
        validate_remote_execution_result(result)!
        commit :: remote_execution_commit_lock(self.root)!
        if self.execution_is_cancelled(result.key, result.attempt_id)! -> fail RemoteCacheError.InvalidRecord("remote execution was cancelled before this result was published")
        validate_remote_count(result.outputs.len(), "execution outputs")!
        request :: self.read_execution_request(result.key)!
        if self.execution_is_cancelled(result.key, result.attempt_id)! -> fail RemoteCacheError.InvalidRecord("remote execution was cancelled before this result was published")
        validate_execution_parity(request, result)!
        loop output in result.outputs -> _ :: self.read_remote_blob_with_len(output.digest, output.byte_len)!
        _ :: self.read_remote_blob(result.stdout_digest)!
        _ :: self.read_remote_blob(result.stderr_digest)!
        ensure_real_directory(self.root) catch error { fail RemoteCacheError.Io(error) }
        path :: self.execution_result_path(result.key)!
        existing_wire :: {
            wire :: secure_read_file_bounded(self.root, path, MAX_REMOTE_WIRE_BYTES + 256)!
            Val(wire)
        } catch error {
            if error.kind() == io.ErrorKind.NotFound -> None else -> fail RemoteCacheError.Io(error)
        }
        if existing_wire == .Val(wire) {
            existing :: decode_remote_execution_result(self.open("execution-result", wire)!)!
            if existing == result -> return
            fail RemoteCacheError.InvalidRecord("remote execution result disagrees with the already published result")
        }
        bytes :: self.seal("execution-result", encode_remote_execution_result(result).bytes())!
        atomic_restore_file(self.root, path, bytes) catch error { fail RemoteCacheError.Io(error) }
    }
