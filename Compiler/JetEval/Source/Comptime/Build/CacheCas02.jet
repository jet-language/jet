    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:1933
    fn execution_cancel_state(self, key: ActionKey) -> RemoteCancellationState RemoteCacheError! {
        path :: self.execution_cancel_path(key)!
        bytes :: secure_read_file_bounded(self.root, path, MAX_REMOTE_WIRE_BYTES + 256) catch error {
            if error.kind() == io.ErrorKind.NotFound -> return RemoteCancellationState{} else -> fail RemoteCacheError.Io(error)
        }
        payload :: self.open("execution-cancel", bytes)!
        text :: String.from_bytes(payload) ?? fail RemoteCacheError.InvalidRecord("remote cancellation marker is not UTF-8")
        marker_key := String?{None}
        attempt_ids := [String]{}
        seen_attempts := Set<String>{}
        seen_key := false
        retired := false
        seen_retired := false
        loop line in text.lines() {
            if line.strip_prefix("key=") == .Val(value) {
                if seen_key -> fail duplicate_remote_field("cancellation key")
                seen_key = true
                marker_key = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("remote cancellation marker key is not UTF-8"))
            } else if line.strip_prefix("attempt=") == .Val(value) {
                if value.is_empty() -> fail duplicate_remote_field("cancellation attempt")
                attempt_id :: String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("remote cancellation marker attempt is not UTF-8")
                validate_remote_attempt_id(attempt_id)!
                if !&seen_attempts.insert(attempt_id) -> fail duplicate_remote_field("cancellation attempt")
                &attempt_ids.push(attempt_id)
            } else if line.strip_prefix("retired=") == .Val(value) {
                if seen_retired -> fail duplicate_remote_field("cancellation retired flag")
                seen_retired = true
                if value != "1" -> fail RemoteCacheError.InvalidRecord("remote cancellation retired flag is not 1")
                retired = true
            } else if !line.trim().is_empty() -> fail RemoteCacheError.InvalidRecord("unknown remote cancellation field `{line}`")
        }
        if marker_key != Val(key.as_str()) -> fail RemoteCacheError.InvalidRecord("remote cancellation marker does not match its action")
        if attempt_ids.is_empty() && !retired -> fail RemoteCacheError.InvalidRecord("remote cancellation marker has no attempt id")
        if retired && !attempt_ids.is_empty() -> fail RemoteCacheError.InvalidRecord("retired remote cancellation marker contains attempt history")
        RemoteCancellationState{attempts: attempt_ids, retired: retired}
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2018
    fn execution_is_cancelled(self, key: ActionKey, attempt_id: String) -> Bool RemoteCacheError! {
        state :: self.execution_cancel_state(key)!
        state.retired || state.attempts.contains(attempt_id)
    }
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2031
    fn execution_path(self, kind: String, key: ActionKey) -> OSPath RemoteCacheError! {
        digest :: ContentDigest.from_bytes(key.as_str().bytes())
        hex := digest.as_str().strip_prefix("sha256:") ?? fail RemoteCacheError.InvalidRecord("execution key digest has no sha256 prefix")
        self.root.join("execution").join(kind).join(hex[..<2]).join(hex[2..])
    }
