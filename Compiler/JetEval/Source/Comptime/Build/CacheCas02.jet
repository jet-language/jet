fn constant_time_equal(left: [U8], right: [U8]) -> Bool {
    difference := left.len() ^ right.len()
    loop index in 0..<left.len().max(right.len()) {
        difference |= if (left.get(index) ?? 0) != (right.get(index) ?? 0) -> 1 else -> 0
    }
    difference == 0
}
