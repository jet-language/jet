// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2934
fn ensure_real_directory(path: OSPath) -> Unit io.Error! {
    // GATE #4494/#4409: real native no-follow metadata and exact error kinds.
    current := OSPath.empty()
    loop component in path.components() {
        if component == {
            .Prefix(prefix) -> &current.push(prefix.as_os_str())
            .RootDir -> &current.push(std.path.MAIN_SEPARATOR.to_string())
            .CurDir -> next
            .ParentDir -> fail io.Error.new(io.ErrorKind.InvalidInput, "directory path contains `..`")
            .Normal(part) -> &current.push(part)
        }
        metadata :: symlink_metadata(current) catch error {
            if error.kind() != io.ErrorKind.NotFound -> fail error
            create_dir(current) catch create_error {
                if create_error.kind() != io.ErrorKind.AlreadyExists -> fail create_error
                existing :: symlink_metadata(current)!
                if existing.is_symlink || !existing.is_dir -> fail io.Error.new(io.ErrorKind.PermissionDenied, "directory path `{current}` is not a real directory")
            }
            next
        }
        if metadata.is_symlink -> fail io.Error.new(io.ErrorKind.PermissionDenied, "directory path `{current}` is a symlink")
        if !metadata.is_dir -> fail io.Error.new(io.ErrorKind.NotADirectory, "directory path `{current}` is not a directory")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2987
fn ensure_existing_real_directory(path: OSPath) -> Unit io.Error! {
    current := OSPath.empty()
    loop component in path.components() {
        if component == {
            .Prefix(prefix) -> &current.push(prefix.as_os_str())
            .RootDir -> &current.push(std.path.MAIN_SEPARATOR.to_string())
            .CurDir -> next
            .ParentDir -> fail io.Error.new(io.ErrorKind.InvalidInput, "directory path contains `..`")
            .Normal(part) -> &current.push(part)
        }
        metadata :: symlink_metadata(current)!
        if metadata.is_symlink || !metadata.is_dir -> fail io.Error.new(io.ErrorKind.PermissionDenied, "directory path `{current}` is not a real directory")
    }
}
