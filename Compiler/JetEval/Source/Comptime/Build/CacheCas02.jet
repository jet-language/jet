// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3290
pub fn snapshot_declared_inputs(store: BuildArtifactStore, base: OSPath, action: BuildAction) -> [ActionInputSnapshot] io.Error! {
    inputs := [ActionInputSnapshot]{}
    loop input in action.inputs {
        path :: resolve_under(base, input.as_str())!
        bytes :: secure_read_file(base, path)!
        digest :: store.put_blob(bytes)!
        &inputs.push(ActionInputSnapshot{path: input, digest: digest, byte_len: U64.from_int(bytes.len())})
    }
    inputs
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3309
pub fn capture_declared_outputs(store: BuildArtifactStore, base: OSPath, action: BuildAction, key: ActionKey, outcome: ActionOutcome, provenance: ActionCacheProvenance) -> ActionResultRecord io.Error! {
    outputs := [ActionOutputRecord]{}
    loop output in action.outputs {
        path :: resolve_under(base, output.as_str())!
        bytes :: secure_read_file(base, path)!
        digest :: store.put_blob(bytes)!
        &outputs.push(ActionOutputRecord{path: output, digest: digest, byte_len: U64.from_int(bytes.len())})
    }
    ActionResultRecord{key: key, outcome: outcome, outputs: outputs, failure_report: None, provenance: provenance}
}
