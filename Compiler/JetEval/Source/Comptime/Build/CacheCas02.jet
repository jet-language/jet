fn remote_mac(key: [U8], kind: String, payload: [U8]) -> String {
    BLOCK :: 64
    key_block := [U8].filled(BLOCK, 0)
    if key.len() > BLOCK {
        digest :: sha256(key)
        loop index in 0..<32 -> key_block[index] = digest[index]
    } else { loop index in 0..<key.len() -> key_block[index] = key[index] }
    inner_input := [U8].with_capacity(BLOCK + kind.bytes().len() + payload.len() + 2)
    outer_input := [U8].with_capacity(BLOCK + 32)
    loop byte in key_block { &inner_input.push(byte ^ 0x36); &outer_input.push(byte ^ 0x5c) }
    &inner_input.extend_from_slice(kind.bytes())
    &inner_input.push(0)
    &inner_input.extend_from_slice(payload)
    &outer_input.extend_from_slice(sha256(inner_input))
    hex_encode(sha256(outer_input))
}
