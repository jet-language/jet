// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2046
pub struct RemoteExecutionRequest { pub key: ActionKey, pub attempt_id: String, pub argv: [String], pub inputs: [ActionInputSnapshot], pub outputs: [BuildPath], pub toolchain_digest: ContentDigest, pub sandbox: RemoteSandboxProof }
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2057
pub struct RemoteExecutionResult { pub key: ActionKey, pub attempt_id: String, pub execution_id: ContentDigest, pub outcome: ActionOutcome, pub outputs: [ActionOutputRecord], pub toolchain_digest: ContentDigest, pub sandbox: RemoteSandboxProof, pub stdout_digest: ContentDigest, pub stderr_digest: ContentDigest, pub provenance_signer: String }
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2076
pub fn remote_execution_identity(request: RemoteExecutionRequest) -> ContentDigest {
    encoded :: encode_remote_execution_request(request)
    ContentDigest.from_bytes("jet.remote-execution.v2\nbytes={encoded.bytes().len()}\n{encoded}".bytes())
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2085
fn validate_remote_execution_request(request: RemoteExecutionRequest) -> Unit RemoteCacheError! {
    validate_action_key(request.key)!
    validate_remote_attempt_id(request.attempt_id)!
    validate_remote_count(request.argv.len(), "argv")!
    validate_remote_count(request.inputs.len(), "inputs")!
    validate_remote_count(request.outputs.len(), "outputs")!
    validate_remote_argv(request.argv)!
    _ :: ContentDigest.parse(request.toolchain_digest.as_str())!
    if request.sandbox.action_key != request.key.as_str() -> fail RemoteCacheError.Denied(RemoteCacheDenied{request: RemoteActionRequest.Execute, reason: RemoteDeniedReason.ProofDoesNotMatchAction})
    if request.sandbox.attempt_id != request.attempt_id -> fail RemoteCacheError.InvalidRecord("remote execution request attempt does not match its sandbox proof")
    if !request.sandbox.is_complete() -> fail RemoteCacheError.Denied(RemoteCacheDenied{request: RemoteActionRequest.Execute, reason: RemoteDeniedReason.MissingGrantAndSandboxProof})
    loop input in request.inputs { validate_remote_path(input.path.as_str())!; _ :: ContentDigest.parse(input.digest.as_str())! }
    validate_unique_remote_paths(request.inputs.iter().map(fn(input) { input.path.as_str() }))!
    loop output in request.outputs -> validate_remote_path(output.as_str())!
    validate_unique_remote_paths(request.outputs.iter().map(fn(output) { output.as_str() }))!
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2124
fn validate_remote_execution_result(result: RemoteExecutionResult) -> Unit RemoteCacheError! {
    validate_action_key(result.key)!
    validate_remote_attempt_id(result.attempt_id)!
    validate_remote_count(result.outputs.len(), "execution outputs")!
    _ :: ContentDigest.parse(result.toolchain_digest.as_str())!
    _ :: ContentDigest.parse(result.execution_id.as_str())!
    _ :: ContentDigest.parse(result.stdout_digest.as_str())!
    _ :: ContentDigest.parse(result.stderr_digest.as_str())!
    if result.provenance_signer.is_empty() || result.provenance_signer.bytes().len() > 256 || result.provenance_signer.chars().any(fn(character) { character.is_control() }) -> fail RemoteCacheError.InvalidRecord("remote execution provenance signer is invalid")
    if !result.sandbox.is_complete() -> fail RemoteCacheError.Denied(RemoteCacheDenied{request: RemoteActionRequest.Execute, reason: RemoteDeniedReason.MissingGrantAndSandboxProof})
    if result.sandbox.action_key != result.key.as_str() -> fail RemoteCacheError.Denied(RemoteCacheDenied{request: RemoteActionRequest.Execute, reason: RemoteDeniedReason.ProofDoesNotMatchAction})
    if result.sandbox.attempt_id != result.attempt_id -> fail RemoteCacheError.InvalidRecord("remote execution result attempt does not match its sandbox proof")
    if result.provenance_signer != result.sandbox.worker_id -> fail RemoteCacheError.InvalidRecord("remote execution provenance signer does not match its worker")
    loop output in result.outputs { validate_remote_path(output.path.as_str())!; _ :: ContentDigest.parse(output.digest.as_str())! }
    validate_unique_remote_paths(result.outputs.iter().map(fn(output) { output.path.as_str() }))!
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2175
fn validate_execution_parity(request: RemoteExecutionRequest, result: RemoteExecutionResult) -> Unit RemoteCacheError! {
    if request.key != result.key || request.attempt_id != result.attempt_id || request.toolchain_digest != result.toolchain_digest || request.sandbox != result.sandbox || result.execution_id != remote_execution_identity(request) -> fail RemoteCacheError.InvalidRecord("remote execution result changed action, inputs, outputs, toolchain, or sandbox provenance")
    if request.outputs.len() != result.outputs.len() -> fail RemoteCacheError.InvalidRecord("remote execution result outputs do not match declarations")
    loop index in 0..<request.outputs.len() { if request.outputs[index] != result.outputs[index].path -> fail RemoteCacheError.InvalidRecord("remote execution result outputs do not match declarations") }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2203
fn encode_remote_execution_request(request: RemoteExecutionRequest) -> String {
    encoded := "version=1\nkey={hex_encode(request.key.as_str().bytes())}\nattempt={hex_encode(request.attempt_id.bytes())}\ntoolchain={request.toolchain_digest.as_str()}\nsandbox={hex_encode(request.sandbox.sandbox_id.bytes())}\nsandbox_class={hex_encode(request.sandbox.sandbox_class.bytes())}\nproof_action={hex_encode(request.sandbox.action_key.bytes())}\nproof_provenance={request.sandbox.provenance_digest.as_str()}\nworker_id={hex_encode(request.sandbox.worker_id.bytes())}\nplatform={hex_encode(request.sandbox.platform.bytes())}\nabi={hex_encode(request.sandbox.abi.bytes())}\nworker_receipt={hex_encode(request.sandbox.worker_receipt.bytes())}\nargv={request.argv.len()}\n"
    loop arg in request.argv -> &encoded.push_str("arg={hex_encode(arg.bytes())}\n")
    &encoded.push_str("inputs={request.inputs.len()}\n")
    loop input in request.inputs -> &encoded.push_str("input\t{hex_encode(input.path.as_str().bytes())}\t{input.digest.as_str()}\t{input.byte_len}\n")
    &encoded.push_str("outputs={request.outputs.len()}\n")
    loop output in request.outputs -> &encoded.push_str("output={hex_encode(output.as_str().bytes())}\n")
    encoded
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2242
fn decode_remote_execution_request(bytes: [U8]) -> RemoteExecutionRequest RemoteCacheError! {
    if bytes.len() > MAX_REMOTE_WIRE_BYTES -> fail RemoteCacheError.InvalidRecord("execution request exceeds the wire-size limit")
    text :: String.from_bytes(bytes) ?? fail RemoteCacheError.InvalidRecord("execution request is not UTF-8")
    seen := Set<String>{}
    version := U32?{None}
    key := ActionKey?{None}
    attempt_id := String?{None}
    toolchain_digest := ContentDigest?{None}
    sandbox_id := String?{None}
    sandbox_class := String?{None}
    proof_action := String?{None}
    proof_provenance := ContentDigest?{None}
    worker_id := String?{None}
    platform := String?{None}
    abi := String?{None}
    worker_receipt := String?{None}
    argv_count := Int?{None}
    argv := [String]{}
    input_count := Int?{None}
    inputs := [ActionInputSnapshot]{}
    output_count := Int?{None}
    outputs := [BuildPath]{}
    loop line in text.lines() {
        if line.strip_prefix("version=") == .Val(value) {
            if !&seen.insert("version") -> fail duplicate_remote_field("version")
            version = Val(parse_remote_version(value, "execution request")!)
        } else if line.strip_prefix("key=") == .Val(value) {
            if !&seen.insert("key") -> fail duplicate_remote_field("key")
            key = Val(ActionKey.new(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("execution key is not UTF-8")))
        } else if line.strip_prefix("attempt=") == .Val(value) {
            if !&seen.insert("attempt") -> fail duplicate_remote_field("attempt")
            attempt_id = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("execution attempt id is not UTF-8"))
        } else if line.strip_prefix("toolchain=") == .Val(value) {
            if !&seen.insert("toolchain") -> fail duplicate_remote_field("toolchain")
            toolchain_digest = Val(ContentDigest.parse(value)!)
        } else if line.strip_prefix("sandbox=") == .Val(value) {
            if !&seen.insert("sandbox") -> fail duplicate_remote_field("sandbox")
            sandbox_id = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("sandbox id is not UTF-8"))
        } else if line.strip_prefix("sandbox_class=") == .Val(value) {
            if !&seen.insert("sandbox_class") -> fail duplicate_remote_field("sandbox_class")
            sandbox_class = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("sandbox class is not UTF-8"))
        } else if line.strip_prefix("proof_action=") == .Val(value) {
            if !&seen.insert("proof_action") -> fail duplicate_remote_field("proof_action")
            proof_action = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("proof action key is not UTF-8"))
        } else if line.strip_prefix("proof_provenance=") == .Val(value) {
            if !&seen.insert("proof_provenance") -> fail duplicate_remote_field("proof_provenance")
            proof_provenance = Val(ContentDigest.parse(value)!)
        } else if line.strip_prefix("worker_id=") == .Val(value) {
            if !&seen.insert("worker_id") -> fail duplicate_remote_field("worker_id")
            worker_id = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("worker id is not UTF-8"))
        } else if line.strip_prefix("platform=") == .Val(value) {
            if !&seen.insert("platform") -> fail duplicate_remote_field("platform")
            platform = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("worker platform is not UTF-8"))
        } else if line.strip_prefix("abi=") == .Val(value) {
            if !&seen.insert("abi") -> fail duplicate_remote_field("abi")
            abi = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("worker ABI is not UTF-8"))
        } else if line.strip_prefix("worker_receipt=") == .Val(value) {
            if !&seen.insert("worker_receipt") -> fail duplicate_remote_field("worker_receipt")
            worker_receipt = Val(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("worker receipt is not UTF-8"))
        } else if line.strip_prefix("argv=") == .Val(value) {
            if !&seen.insert("argv") -> fail duplicate_remote_field("argv")
            argv_count = Val(parse_remote_count(value, "argv")!)
        } else if line.strip_prefix("arg=") == .Val(value) -> &argv.push(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("execution argument is not UTF-8"))
        else if line.strip_prefix("inputs=") == .Val(value) {
            if !&seen.insert("inputs") -> fail duplicate_remote_field("inputs")
            input_count = Val(parse_remote_count(value, "inputs")!)
        } else if line.strip_prefix("input\t") == .Val(value) {
            fields :: value.split('\t').collect()
            if fields.len() != 3 -> fail RemoteCacheError.InvalidRecord("execution input needs path, digest, and byte length")
            path :: BuildPath(String.from_bytes(hex_decode(fields[0])!) ?? fail RemoteCacheError.InvalidRecord("execution input path is not UTF-8"))
            digest :: ContentDigest.parse(fields[1])!
            byte_len :: U64.parse(fields[2]) ?? fail RemoteCacheError.InvalidRecord("execution input byte length is not a number")
            &inputs.push(ActionInputSnapshot{path: path, digest: digest, byte_len: byte_len})
        } else if line.strip_prefix("outputs=") == .Val(value) {
            if !&seen.insert("outputs") -> fail duplicate_remote_field("outputs")
            output_count = Val(parse_remote_count(value, "outputs")!)
        } else if line.strip_prefix("output=") == .Val(value) -> &outputs.push(BuildPath(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("execution output path is not UTF-8")))
        else if !line.trim().is_empty() -> fail RemoteCacheError.InvalidRecord("unknown execution request field `{line}`")
    }
    if version != Val(1) || argv_count != Val(argv.len()) || input_count != Val(inputs.len()) || output_count != Val(outputs.len()) -> fail RemoteCacheError.InvalidRecord("execution request count does not match records")
    action_key :: key ?? fail RemoteCacheError.InvalidRecord("missing execution key")
    attempt :: attempt_id ?? fail RemoteCacheError.InvalidRecord("missing execution attempt id")
    sandbox :: RemoteSandboxProof.new(sandbox_id ?? fail RemoteCacheError.InvalidRecord("missing sandbox id"), proof_action ?? fail RemoteCacheError.InvalidRecord("missing proof action key"), proof_provenance ?? fail RemoteCacheError.InvalidRecord("missing proof provenance")).with_sandbox_class(sandbox_class ?? fail RemoteCacheError.InvalidRecord("missing sandbox class")).with_attempt_id(attempt).with_worker_identity(worker_id ?? fail RemoteCacheError.InvalidRecord("missing worker id"), platform ?? fail RemoteCacheError.InvalidRecord("missing worker platform"), abi ?? fail RemoteCacheError.InvalidRecord("missing worker ABI"), worker_receipt ?? fail RemoteCacheError.InvalidRecord("missing worker receipt"))
    request :: RemoteExecutionRequest{key: action_key, attempt_id: attempt, argv: argv, inputs: inputs, outputs: outputs, toolchain_digest: toolchain_digest ?? fail RemoteCacheError.InvalidRecord("missing toolchain digest"), sandbox: sandbox}
    validate_remote_execution_request(request)!
    request
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:2458
fn encode_remote_execution_result(result: RemoteExecutionResult) -> String {
    encoded := "version=2\nkey={hex_encode(result.key.as_str().bytes())}\nattempt={hex_encode(result.attempt_id.bytes())}\nexecution_id={result.execution_id.as_str()}\noutcome={encode_remote_outcome(result.outcome)}\ntoolchain={result.toolchain_digest.as_str()}\nsandbox={hex_encode(result.sandbox.sandbox_id.bytes())}\nsandbox_class={hex_encode(result.sandbox.sandbox_class.bytes())}\nproof_action={hex_encode(result.sandbox.action_key.bytes())}\nproof_provenance={result.sandbox.provenance_digest.as_str()}\nworker_id={hex_encode(result.sandbox.worker_id.bytes())}\nplatform={hex_encode(result.sandbox.platform.bytes())}\nabi={hex_encode(result.sandbox.abi.bytes())}\nworker_receipt={hex_encode(result.sandbox.worker_receipt.bytes())}\nstdout={result.stdout_digest.as_str()}\nstderr={result.stderr_digest.as_str()}\nprovenance_signer={hex_encode(result.provenance_signer.bytes())}\noutputs={result.outputs.len()}\n"
    loop output in result.outputs -> &encoded.push_str("output\t{hex_encode(output.path.as_str().bytes())}\t{output.digest.as_str()}\t{output.byte_len}\n")
    encoded
}
