pub fn secure_read_file_bounded(base: OSPath, path: OSPath, limit: Int) -> [U8] io.Error! {
    if selected_family() != "unix" -> return secure_read_file_bounded_nonunix(base, path, limit)!
    relative :: path.strip_prefix(base) ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path escapes root")
    file_name :: relative.file_name_component() ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path has no file name")
    root :: open_directory(base, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
    held := [Directory]{}
    if relative.parent() == .Val(parent) {
        cursor := components(parent)
        loop {
            part :: next(parent, &cursor) ?? break
            if part.kind != ComponentKind.Normal -> next
            if parent.component_bytes(part).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in cache path")
            // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3492 (openat)
            child :: if held.is_empty() -> root.open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})! else -> held[held.len() - 1].open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
            &held.push(^child)
        }
    }
    if relative.component_bytes(file_name).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in cache path")
    file :: if held.is_empty() -> root.open_reader(relative, file_name, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})! else -> held[held.len() - 1].open_reader(relative, file_name, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
    if !file.stat()!.is_file -> fail io.Error.new(io.ErrorKind.PermissionDenied, "cache entry is not a regular file")
    bytes :: file.read_bounded(U64.from_usize(USize.from_int(limit).saturating_add(1)))!
    if bytes.len() > limit -> fail io.Error.new(io.ErrorKind.InvalidData, "cache entry exceeds its byte limit")
    bytes
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3563
fn secure_read_file_bounded_nonunix(base: OSPath, path: OSPath, limit: Int) -> [U8] io.Error! {
    relative :: path.strip_prefix(base) ?? fail io.Error.new(io.ErrorKind.InvalidInput, "cache path escapes root")
    current := base
    loop component in relative.components() {
        if component == .Normal(part) {
            &current.push(part)
            if symlink_metadata(current)!.is_symlink -> fail io.Error.new(io.ErrorKind.PermissionDenied, "cache path contains a symlink")
        }
    }
    file :: open_reader(current, OpenOptions{nofollow: false, cloexec: false, open_reparse_point: false, read: Val(true)})!
    bytes :: file.read_bounded(U64.from_usize(USize.from_int(limit).saturating_add(1)))!
    if bytes.len() > limit -> fail io.Error.new(io.ErrorKind.InvalidData, "cache entry exceeds its byte limit")
    bytes
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3598-3672
// Unix hostile_tests, atomic counter and temp helper are in paired Tests/Comptime/Build/CacheCas02.jet.
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3675
pub fn atomic_restore_file(base: OSPath, path: OSPath, bytes: [U8]) -> Unit io.Error! {
    if selected_family() != "unix" -> return atomic_restore_file_nonunix(base, path, bytes)!
    // GATE #4494: actual retained descriptor operations, native creation, entropy and Close.
    relative :: path.strip_prefix(base) ?? fail io.Error.new(io.ErrorKind.InvalidInput, "build output escapes root")
    file_name :: relative.file_name_component() ?? fail io.Error.new(io.ErrorKind.InvalidInput, "build output has no file name")
    root :: open_directory(base, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
    held := [Directory]{}
    if relative.parent() == .Val(parent) {
        cursor := components(parent)
        loop {
            part :: next(parent, &cursor) ?? break
            if part.kind != ComponentKind.Normal -> next
            if parent.component_bytes(part).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in build output path")
            child :: {
                owner :: if held.is_empty() -> &root else -> &held[held.len() - 1]
                // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3690 (openat)
                owner.open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)}) catch error {
                    if error.kind() != io.ErrorKind.NotFound -> fail error
                    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3691 (mkdirat)
                    owner.create_dir(parent, part, 0o755) catch mkdir_error { if mkdir_error.kind() != io.ErrorKind.AlreadyExists -> fail mkdir_error }
                    owner.open_directory(parent, part, OpenOptions{nofollow: true, cloexec: true, open_reparse_point: false, read: Val(true)})!
                }
            }
            &held.push(^child)
        }
    }
    owner :: if held.is_empty() -> &root else -> &held[held.len() - 1]
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3695 (name)
    if relative.component_bytes(file_name).contains(U8{0}) -> fail io.Error.new(io.ErrorKind.InvalidInput, "NUL in build output path")
    temp_path := OSPath.empty()
    temp_component := file_name
    writer := {
        loop {
            random := [U8].filled(16, 0)
            entropy :: fs.File.open(OSPath("/dev/urandom"))!
            entropy.read_exact(&random)!
            temp_path = OSPath(".jet-restore-{hex_encode(random)}")
            temp_component = temp_path.file_name_component() ?? panic("generated temp name is normal")
            candidate :: owner.create_file(temp_path, temp_component, CreateOptions{read: false, write: true, mode: Val(0o600), custom_flags: Val(0o400000 | 0o2000000), delete_on_close: false, open_reparse_point: false}) catch error {
                if error.kind() == io.ErrorKind.AlreadyExists -> next else -> fail error
            }
            break ^candidate
        }
    }
    writer.write_all(bytes)!
    writer.sync_all()!
    _ :: writer.close().ok()
    // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3693 (renameat)
    owner.rename(temp_path, temp_component, owner, relative, file_name) catch error {
        // Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3692 (unlinkat)
        _ :: owner.remove_file(temp_path, temp_component).ok()
        fail error
    }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3787
fn atomic_restore_file_nonunix(base: OSPath, path: OSPath, bytes: [U8]) -> Unit io.Error! {
    prepare_output_destination(base, path)!
    random := [U8].filled(16, 0)
    entropy :: fs.File.open(OSPath("/dev/urandom"))!
    entropy.read_exact(&random)!
    nonce :: hex_encode(random)
    temp :: path.with_extension("jet-cache-restore-{nonce}.tmp")
    file :: core.files.host.retained_descriptor.create_new(temp, CreateOptions{read: false, write: true, delete_on_close: false, open_reparse_point: false}, None)!
    file.write_all(bytes)!
    if symlink_metadata(path).ok() != None -> remove(path)!
    rename(temp, path)!
}
