// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3068
fn decode_remote_record(bytes: [U8]) -> ActionResultRecord RemoteCacheError! {
    if bytes.len() > MAX_REMOTE_WIRE_BYTES -> fail RemoteCacheError.InvalidRecord("cache record exceeds the wire-size limit")
    text :: String.from_bytes(bytes) ?? fail RemoteCacheError.InvalidRecord("record is not UTF-8")
    seen := Set<String>{}
    version := U32?{None}
    key := ActionKey?{None}
    outcome := ActionOutcome?{None}
    status := ActionCacheStatus?{None}
    failure_report := JetErrorReport?{None}
    output_count := Int?{None}
    outputs := [ActionOutputRecord]{}
    loop line in text.lines() {
        if line.strip_prefix("version=") == .Val(value) {
            if !&seen.insert("version") -> fail duplicate_remote_field("version")
            version = Val(parse_remote_version(value, "cache record")!)
        } else if line.strip_prefix("key=") == .Val(value) {
            if !&seen.insert("key") -> fail duplicate_remote_field("key")
            key = Val(ActionKey.new(String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("cache record key is not UTF-8")))
        } else if line.strip_prefix("outcome=") == .Val(value) {
            if !&seen.insert("outcome") -> fail duplicate_remote_field("outcome")
            outcome = Val(parse_remote_outcome(value)!)
        } else if line.strip_prefix("status=") == .Val(value) {
            if !&seen.insert("status") -> fail duplicate_remote_field("status")
            status = Val(parse_remote_status(value)!)
        } else if line.strip_prefix("failure=") == .Val(value) {
            if !&seen.insert("failure") -> fail duplicate_remote_field("failure")
            if !value.is_empty() {
                failure_text :: String.from_bytes(hex_decode(value)!) ?? fail RemoteCacheError.InvalidRecord("cache failure report is not UTF-8")
                report :: JetErrorReport.from_json(failure_text) catch error { fail RemoteCacheError.InvalidRecord("cache failure report is invalid: {error}") }
                failure_report = Val(report)
            }
        } else if line.strip_prefix("outputs=") == .Val(value) {
            if !&seen.insert("outputs") -> fail duplicate_remote_field("outputs")
            output_count = Val(parse_remote_count(value, "cache outputs")!)
        } else if line.strip_prefix("output\t") == .Val(value) {
            fields :: value.split('\t').collect()
            if fields.len() != 3 -> fail RemoteCacheError.InvalidRecord("output record needs path, digest, and byte length")
            digest :: ContentDigest.parse(fields[1])!
            byte_len :: U64.parse(fields[2]) ?? fail RemoteCacheError.InvalidRecord("output byte length is not a number")
            &outputs.push(ActionOutputRecord{path: BuildPath(fields[0]), digest: digest, byte_len: byte_len})
        } else if !line.trim().is_empty() -> fail RemoteCacheError.InvalidRecord("unknown cache record field `{line}`")
    }
    if version != Val(2) || output_count != Val(outputs.len()) -> fail RemoteCacheError.InvalidRecord("cache record version or output count is invalid")
    action_key :: key ?? fail RemoteCacheError.InvalidRecord("missing action key")
    validate_action_key(action_key)!
    record :: ActionResultRecord{key: action_key, outcome: outcome ?? fail RemoteCacheError.InvalidRecord("missing action outcome"), outputs: outputs, failure_report: failure_report, provenance: ActionCacheProvenance{status: status ?? fail RemoteCacheError.InvalidRecord("missing cache status"), remote_policy: RemoteCachePolicy.disabled_until_grant_and_sandbox_proof()}}
    validate_action_result_record(record)!
    record
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3178
fn validate_action_result_record(record: ActionResultRecord) -> Unit RemoteCacheError! {
    if record.outcome == .Failed(_) {
        if record.failure_report == None -> fail RemoteCacheError.InvalidRecord("failed action record has no structured failure report")
        if !record.outputs.is_empty() -> fail RemoteCacheError.InvalidRecord("failed action record contains outputs")
    } else if record.failure_report != None -> fail RemoteCacheError.InvalidRecord("successful action record contains a failure report")
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3194
fn duplicate_remote_field(field: String) -> RemoteCacheError { RemoteCacheError.InvalidRecord("remote record field `{field}` appears more than once") }
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3200
fn parse_remote_outcome(value: String) -> ActionOutcome RemoteCacheError! {
    if value == "restored" -> return ActionOutcome.RestoredFromCache
    (kind, code) :: value.split_once(':') ?? fail RemoteCacheError.InvalidRecord("outcome has no exit code")
    exit_code :: I32.parse(code) ?? fail RemoteCacheError.InvalidRecord("outcome exit code is not a number")
    if kind == { "succeeded" -> ActionOutcome.Succeeded{exit_code: exit_code} "failed" -> ActionOutcome.Failed{exit_code: exit_code} else -> fail RemoteCacheError.InvalidRecord("unknown action outcome") }
}
// Rust: crates/jet-comptime/src/Comptime/Build/cache_cas.rs:3219
fn parse_remote_status(value: String) -> ActionCacheStatus RemoteCacheError! {
    (kind, name) :: value.split_once(':') ?? fail RemoteCacheError.InvalidRecord("cache status has no reason")
    if (kind, name) == {
        ("hit", "LocalActionRecordMatched") -> ActionCacheStatus.Hit(CacheHitReason.LocalActionRecordMatched)
        ("hit", "DeclaredOutputsRestored") -> ActionCacheStatus.Hit(CacheHitReason.DeclaredOutputsRestored)
        ("miss", "NoLocalActionRecord") -> ActionCacheStatus.Miss(CacheMissReason.NoLocalActionRecord)
        ("miss", "ActionKeyChanged") -> ActionCacheStatus.Miss(CacheMissReason.ActionKeyChanged)
        ("miss", "DeclaredOutputMissing") -> ActionCacheStatus.Miss(CacheMissReason.DeclaredOutputMissing)
        ("miss", "CacheRecordInvalid") -> ActionCacheStatus.Miss(CacheMissReason.CacheRecordInvalid)
        ("miss", "CacheRestoreFailed") -> ActionCacheStatus.Miss(CacheMissReason.CacheRestoreFailed)
        ("miss", "RemoteDenied") -> ActionCacheStatus.Miss(CacheMissReason.RemoteDenied)
        ("miss", "UncachedAction") -> ActionCacheStatus.Miss(CacheMissReason.UncachedAction)
        ("miss", "FrontEndIncomplete") -> ActionCacheStatus.Miss(CacheMissReason.FrontEndIncomplete)
        else -> fail RemoteCacheError.InvalidRecord("cache status kind does not match reason")
    }
}
