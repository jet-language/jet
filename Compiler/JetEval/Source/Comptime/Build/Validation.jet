use jet_comptime.Comptime.Build.ActionsPolicy.[ActionCache, ActionSpec, BuildAction, BuildCapability]
use jet_comptime.Comptime.Build.CacheCas.ContentDigest
use jet_comptime.Comptime.Build.ErrorsKeys.[BuildError, NameKind]
use jet_comptime.Comptime.Build.PluginsModules.[GeneratedModuleSpec, WasmComponentPluginSpec]
use jet_comptime.Comptime.Build.ProvenanceToolchains.[BuildProvenance, ProbeKind, ProbeSpec, ProvenanceSource, ToolchainSpec, ReproducibilityClass]
use jet_comptime.Comptime.Build.Targets.BuildPath
use jet_foundation.TEXT_NUL
use std.io
use std.path.Component

// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:13
fn resolve_under(base: &OSPath, rel: String) -> OSPath io.Error! {
    // GATE #4483 selected-target native path components; #4409 InvalidInput fidelity.
    path := OSPath.from(rel)
    out := base.to_path_buf()
    for component in path.components() {
        if component == {
            .Normal(part) -> { out.push(part) }
            .CurDir -> {}
            .ParentDir | .RootDir | .Prefix(_) -> return Err(io.Error.new(io.ErrorKind.InvalidInput, "build output path escapes base directory"))
        }
    }
    Ok(^out)
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:31
fn cap_name(cap: &BuildCapability) -> String { cap.name().to_string() }
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:35
fn check_name(name: String, kind: NameKind) -> String BuildError! {
    trimmed := name.trim() // #4303
    if trimmed.is_empty() {
        return if kind == {
            .Target -> Err(BuildError.EmptyTargetName)
            .Action -> Err(BuildError.EmptyActionName)
            .Toolchain -> Err(BuildError.EmptyToolchainName)
            .SigningIdentity -> Err(BuildError.EmptySigningIdentityName)
            .Probe -> Err(BuildError.EmptyProbeName)
        }
    }
    Ok(^name)
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:48
fn validate_plugin_spec(spec: &WasmComponentPluginSpec) -> () BuildError! {
    name := spec.name.trim() // #4303
    if name.is_empty() -> return Err(BuildError.EmptyPluginField("name"))
    version := spec.version.trim() // #4303
    if version.is_empty() -> return Err(BuildError.EmptyPluginField(spec.name.clone()))
    api_version := spec.api_version.trim() // #4303
    if api_version.is_empty() -> return Err(BuildError.EmptyPluginField(spec.name.clone()))
    digest := spec.component_digest.trim() // #4303
    if digest.is_empty() -> return Err(BuildError.EmptyPluginField(spec.name.clone()))
    ContentDigest.parse(spec.component_digest).map_err(fn(error) { BuildError.InvalidPluginDigest(error.to_string()) })?
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:66
fn validate_generated_module(module: &GeneratedModuleSpec) -> () BuildError! {
    name := module.name.trim() // #4303
    path_text := module.path.as_str().trim() // #4303
    source := module.source.trim() // #4303
    if name.is_empty() || path_text.is_empty() || source.is_empty() -> return Err(BuildError.EmptyGeneratedModuleField(module.name.clone()))
    path := OSPath.from(module.path.as_str())
    components := path.components().collect::<[Component]>()
    valid_root := components.len() >= 3
        && (components[0] is .Normal(part) && part == ".jet")
        && (components[1] is .Normal(part) && part == "generated")
        && components[2..].iter().all(fn(component) { component is .Normal })
    if !valid_root || path.extension().and_then(fn(extension) { extension.to_str() }) != Some("jet") {
        return Err(BuildError.InvalidGeneratedModulePath(module.path.as_str().to_string()))
    }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:89
fn validate_toolchain(name: String, spec: &ToolchainSpec) -> () BuildError! {
    host := spec.host_triple.trim() // #4303
    target := spec.target_triple.trim() // #4303
    if host.is_empty() || target.is_empty() -> return Err(BuildError.EmptyToolchainTriple(name.to_string()))
    if spec.sdk is Some(sdk) {
        validate_identity(name, sdk.name, &sdk.provenance)?
        validate_identity(name, sdk.version, &sdk.provenance)?
    }
    if spec.linker is Some(linker) { validate_identity(name, linker.name, &linker.provenance)? }
    tool_names := spec.tools.keys().collect::<[String]>()
    tool_names.sort()
    for tool in tool_names {
        path := spec.tools[tool]
        tool_text := tool.trim() // #4303
        path_text := path.trim() // #4303
        if tool_text.is_empty() || path_text.is_empty() || path.contains(TEXT_NUL) -> return Err(BuildError.EmptyIdentityField(name.to_string()))
    }
    for mount in spec.mounts {
        destination := OSPath.from(mount.destination)
        source_text := mount.source.trim() // #4303
        destination_text := mount.destination.trim() // #4303
        if source_text.is_empty() || mount.source.contains(TEXT_NUL) || destination_text.is_empty() || mount.destination.contains(TEXT_NUL)
            || !destination.is_absolute() || destination.components().any(fn(component) { component is .ParentDir }) {
            return Err(BuildError.InvalidPath("toolchain `{name}` has an invalid read-only mount"))
        }
    }
    validate_provenance(name, &spec.provenance)
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:124
fn validate_identity(name: String, field: String, provenance: &BuildProvenance) -> () BuildError! {
    trimmed := field.trim() // #4303
    if trimmed.is_empty() -> return Err(BuildError.EmptyIdentityField(name.to_string()))
    validate_provenance(name, provenance)
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:135
fn validate_probe(name: String, spec: &ProbeSpec) -> () BuildError! {
    invalid := if spec.kind == {
        .FindProgram(program) -> { trimmed := program.trim(); trimmed.is_empty() }
        .PkgConfig(package, ..) -> { trimmed := package.trim(); trimmed.is_empty() }
        .HeaderCheck(header) -> { trimmed := header.trim(); trimmed.is_empty() || !valid_header_name(header) }
        .CompileCheck(check, includes, code) -> {
            check_text := check.trim() // #4303
            code_text := code.trim() // #4303
            check_text.is_empty() || code_text.is_empty() || includes.iter().any(fn(include) { !valid_header_name(include) })
        }
    }
    if invalid -> return Err(BuildError.EmptyProbeField(name.to_string()))
    validate_provenance(name, &spec.provenance)?
    if spec.reproducibility == ReproducibilityClass.Reproducible && spec.provenance.lock.is_none() -> return Err(BuildError.MissingLockedProvenance(name.to_string()))
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:171
fn valid_header_name(header: String) -> Bool {
    !header.is_empty()
        && !header.contains(TEXT_NUL)
        && !header.chars().any(fn(character) { character == '\n' || character == '\r' || character == '"' || character == '<' || character == '>' })
        && OSPath.from(header).is_relative()
        && OSPath.from(header).components().all(fn(component) { component is .Normal })
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:182
fn validate_provenance(name: String, provenance: &BuildProvenance) -> () BuildError! {
    if provenance.source == {
        .JetpackDependency(dep) | .AmbientRecord(dep) | .UserDeclared(dep) -> {
            trimmed := dep.trim() // #4303
            if trimmed.is_empty() -> return Err(BuildError.EmptyIdentityField(name.to_string()))
        }
        _ -> {}
    }
    if provenance.lock is Some(lock) {
        key := lock.key.trim() // #4303
        digest := lock.digest.trim() // #4303
        if key.is_empty() || digest.is_empty() -> return Err(BuildError.EmptyIdentityField(name.to_string()))
    }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:204
fn validate_action(name: String, spec: &ActionSpec) -> () BuildError! {
    if spec.argv.is_empty() || spec.argv.iter().any(fn(arg) { trimmed := arg.trim(); trimmed.is_empty() }) -> return Err(BuildError.EmptyActionArgv(name.to_string()))
    validate_paths(&spec.inputs)?
    validate_paths(&spec.outputs)?
    env_keys := spec.env.keys().collect::<[String]>()
    env_keys.sort()
    for key in env_keys {
        trimmed := key.trim() // #4303
        if trimmed.is_empty() -> return Err(BuildError.EmptyEnvName(name.to_string()))
    }
    allowlist := spec.env_allowlist.iter().collect::<[String]>()
    allowlist.sort()
    for key in allowlist {
        trimmed := key.trim() // #4303
        if trimmed.is_empty() -> return Err(BuildError.EmptyEnvName(name.to_string()))
        if !spec.env.contains_key(key) -> return Err(BuildError.UndeclaredEnvName(action: name.to_string(), key: key.clone()))
    }
    if spec.cache == {
        .Cached if spec.outputs.is_empty() -> return Err(BuildError.CachedActionWithoutOutputs(name.to_string()))
        .UncachedPhony if !spec.outputs.is_empty() -> return Err(BuildError.PhonyActionWithOutputs(name.to_string()))
        .UncachedPhony if spec.caps.is_empty() -> return Err(BuildError.PhonyActionWithoutCaps(name.to_string()))
        _ -> {}
    }
    outputs := Set<String>.new()
    for output in spec.outputs {
        if !outputs.insert(output.as_str()) -> return Err(BuildError.DuplicateActionOutput(action: name.to_string(), output: output.as_str().to_string()))
    }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:251
fn validate_action_output_owners(actions: &[BuildAction]) -> () BuildError! {
    owners := [String:String].new()
    for action in actions {
        for output in action.outputs {
            if owners.insert(output.as_str(), action.name) is Some(first_action) {
                return Err(BuildError.DuplicateBuildOutput(output: output.as_str().to_string(), first_action: first_action.to_string(), second_action: action.name.clone()))
            }
        }
    }
    Ok(())
}
// Rust: crates/jet-comptime/src/Comptime/Build/validation.rs:267
fn validate_paths(paths: &[BuildPath]) -> () BuildError! {
    for path in paths {
        trimmed := path.as_str().trim() // #4303
        if trimmed.is_empty() -> return Err(BuildError.EmptyPath)
        path_value := OSPath.from(path.as_str())
        if path_value.is_absolute() || path_value.components().any(fn(component) { component is .ParentDir || component is .RootDir || component is .Prefix }) {
            return Err(BuildError.InvalidPath(path.as_str().to_string()))
        }
    }
    Ok(())
}
