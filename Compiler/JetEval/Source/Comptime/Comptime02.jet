// Rust: crates/jet-comptime/src/Comptime/mod.rs:1804
pub fn evaluate_owned_with_imports_opts_collecting_items(init: &Expr, funcs: &[String:Func], extern_names: &HashSet<String>, base_dir: &OSPath, globals: &[String:CtValue], binding_types: &[String:Type], core_imports: &[String:String], gates: GateSet, initial_impure_depth: USize, items: &[Item], checked_nominals: MirFragmentNominalFacts?, mutated: &[String:CtValue]?) -> (CtValue, [ComptimeInput]) Diagnostic! {
    refs: [String:&Func] = [:]
    for (name, function) in funcs { refs.insert(name.clone(), function) }
    structs: [String:&StructDef] = [:]
    methods: [(String, String):&Func] = [:]
    for item in items {
        item == {
            Item.Impl(implementation) -> {
                for method in implementation.methods {
                    key := "{implementation.type_name}::{method.name}"
                    if funcs.get(&key) == Val(method) {
                        insert_item_method_ref(&refs, &methods, &implementation.type_name, implementation.trait_name.as_deref(), method, implementation.is_generated_serde || method.compiler_generated)
                    }
                }
            }
            Item.Struct(definition) -> {
                structs.insert(definition.name.clone(), definition)
                for method in definition.methods {
                    key := "{definition.name}::{method.name}"
                    if funcs.get(&key) == Val(method) { methods.insert((definition.name.clone(), method.name.clone()), method) }
                }
                for block in definition.trait_impls {
                    for method in block.methods {
                        key := "{definition.name}::{method.name}"
                        if funcs.get(&key) == Val(method) {
                            insert_item_method_ref(&refs, &methods, &definition.name, Val(block.trait_name.as_str()), method, block.compiler_generated || method.compiler_generated)
                        }
                    }
                }
            }
            Item.Enum(definition) -> {
                for method in definition.methods {
                    key := "{definition.name}::{method.name}"
                    if funcs.get(&key) == Val(method) { methods.insert((definition.name.clone(), method.name.clone()), method) }
                }
                for block in definition.trait_impls {
                    for method in block.methods {
                        key := "{definition.name}::{method.name}"
                        if funcs.get(&key) == Val(method) {
                            insert_item_method_ref(&refs, &methods, &definition.name, Val(block.trait_name.as_str()), method, block.compiler_generated || method.compiler_generated)
                        }
                    }
                }
            }
            _ -> {}
        }
    }
    // Speculative folding retains only the expression's call closure, including qualified methods.
    candidates := refs.clone()
    for ((owner, name), method) in methods {
        key := "{owner}::{name}"
        if !candidates.contains_key(&key) { candidates.insert(key, method) }
    }
    reachable := reachable_func_names(init, &candidates)
    refs.retain(fn(name, _) { reachable.contains(name) })
    methods.retain(fn(key, _) { reachable.contains(&"{key.0}::{key.1}") })
    evaluate_with_imports_opts_collecting_structs_and_methods(init, &refs, extern_names, base_dir, globals, binding_types, core_imports, gates, initial_impure_depth, &structs, &methods, &item_method_traits(items), empty_distinct(), empty_distinct_bases(), &[], checked_nominals, mutated)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:1934
// Typed derives and marker bodies expand AST templates in the reflected target scope.
pub fn expand_derive_body(body: &[DeriveBodyItem], type_param: &String, type_info: CtValue, funcs: &[String:&Func], base_dir: &OSPath, checked_nominals: MirFragmentNominalFacts?) -> [Item] Diagnostic! {
    scope: [String:CtValue] = [:]
    if type_info == CtValue.Struct { fields, .. } {
        for (field, value) in fields {
            if field == "name" { if value == CtValue.Str(name) { scope.insert("name", CtValue.Str(name.clone())); break } }
        }
    }
    scope.insert(type_param.to_string(), ^type_info)
    expand_template_body_with_nominals(body, &scope, funcs, base_dir, checked_nominals)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:1958
pub fn expand_template_body(body: &[DeriveBodyItem], initial_scope: &[String:CtValue], funcs: &[String:&Func], base_dir: &OSPath) -> [Item] Diagnostic! {
    expand_template_body_with_nominals(body, initial_scope, funcs, base_dir, None)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:1967
fn expand_template_body_with_nominals(body: &[DeriveBodyItem], initial_scope: &[String:CtValue], funcs: &[String:&Func], base_dir: &OSPath, checked_nominals: MirFragmentNominalFacts?) -> [Item] Diagnostic! {
    scope := initial_scope.clone()
    binding_types: [String:Type] = [:]
    for (name, value) in scope { binding_types.insert(name.clone(), value.jet_type()) }
    interp := Interp {
        funcs: funcs, error_conversions: &[], base_dir: base_dir, fuel: FUEL_BUDGET,
        sink: None, checked_nominals: checked_nominals, core_imports: empty_imports(), debugger: None,
        runtime_execution: false, depth: 0, cur_func: "derive", impure_depth: 0,
        gates: GateSet.default(), repl_mode: false, repl_grants: [], repl_authorizer: None,
        repl_interruptible: false, embed_inputs: [], binding_types: ^binding_types,
        globals: empty_globals(), methods: empty_methods(), structs: empty_structs(),
        computed_fields: empty_computed(), distinct_ranges: empty_distinct(),
        distinct_bases: empty_distinct_bases(), migrations: empty_migrations(),
        list_write_windows: [:], data_pipeline: DataPipelineState.default()
    }
    expanded: [Item] = []
    expand_derive_items(body, &interp, &scope, &expanded)?
    Ok(^expanded)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2018
pub fn expand_generated_items(items: [Item]) -> [Item] Diagnostic! {
    body: [DeriveBodyItem] = []
    for item in ^items { body.push(DeriveBodyItem.Item(^item)) }
    expand_template_body(&body, &[:], &[:], &OSPath.new("."))
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2032
// Formatting is only the build module materialization boundary; derives do not re-lex.
pub fn format_template_items(items: [Item]) -> String {
    program := Program {
        imports: [], items: ^items, script_body: [], block_spans: [], fenced_statements: [],
        web_target_ceiling: None, pub_file: false, no_prelude: false, default_target: None,
        html_path: None, policy_declarations: [], user_policy_declarations: [], applied_rules: [], rule_facts: []
    }
    format_synthetic_program(&program)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2054
pub fn format_template_body(body: &[DeriveBodyItem], initial_scope: &[String:CtValue], funcs: &[String:&Func], base_dir: &OSPath) -> String Diagnostic! {
    items := expand_template_body(body, initial_scope, funcs, base_dir)?
    Ok(format_template_items(^items))
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2064
fn template_literal_value(expr: &Expr) -> CtValue? {
    expr == {
        Expr.ComptimeName { value: Val(value), .. } -> Val(value.clone())
        Expr.Bool(value, _) -> Val(CtValue.Bool(value))
        Expr.Int(value, _, _, raw) -> Val(exact_integer_ct_value(value, raw.as_deref()))
        Expr.Float(value, _, is_f32, _) -> Val(CtValue.Float(if is_f32 { CtFloat.F32(value as F32) } else { CtFloat.F64(value) }))
        Expr.Char(value, _) -> Val(CtValue.Char(value))
        Expr.Unit(_) -> Val(CtValue.Unit)
        Expr.Str(parts, _) -> {
            value := String.new()
            for part in parts {
                if part == StrPart.Lit(text) { value.push_str(text) } else { return None }
            }
            Val(CtValue.Str(^value))
        }
        Expr.ListLit(items, _) -> {
            values: [CtValue] = []
            for item in items { if template_literal_value(item) == Val(value) { values.push(^value) } else { return None } }
            Val(CtValue.List(^values))
        }
        Expr.MapLit(entries, _) -> {
            values: [CtKey:CtValue] = [:]
            for (key, item) in entries {
                key_value := template_literal_value(key) == { Val(value) -> value; None -> { return None } }
                key := CtKey.from_value(^key_value) == { Val(key) -> key; None -> { return None } }
                value := template_literal_value(item) == { Val(value) -> value; None -> { return None } }
                values.insert(^key, ^value)
            }
            Val(CtValue.Map(^values))
        }
        Expr.StructLit { type_name, fields, .. } -> {
            values: [(String, CtValue)] = []
            for (name, _, item) in fields {
                value := template_literal_value(item) == { Val(value) -> value; None -> { return None } }
                values.push((name.clone(), ^value))
            }
            Val(CtValue.Struct { type_name: type_name.clone(), fields: ^values })
        }
        Expr.TupleLit(fields, _, _) -> {
            values: [(String, CtValue)] = []
            for (name, item) in fields {
                value := template_literal_value(item) == { Val(value) -> value; None -> { return None } }
                values.push((name.clone(), ^value))
            }
            Val(CtValue.Struct { type_name: "tuple", fields: ^values })
        }
        Expr.EnumLit { type_name, variant, args, .. } if args.is_empty() -> Val(CtValue.Enum { type_name: type_name.clone(), variant: variant.clone(), args: [] })
        Expr.Present(value, _) -> template_literal_value(value) == { Val(value) -> Val(CtValue.Present(^value)); None -> None }
        Expr.Paren(value, _) -> template_literal_value(value)
        _ -> None
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2138
fn sync_template_binding_types(interp: &Interp, scope: &[String:CtValue]) -> {
    interp.binding_types.retain(fn(name, _) { scope.contains_key(name) })
    for (name, value) in scope { interp.binding_types.insert(name.clone(), value.jet_type()) }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2150
fn bind_template_reified_statement(stmt: &Stmt, interp: &Interp, scope: &[String:CtValue]) -> Bool Diagnostic! {
    binding := stmt == { Stmt.Val(binding) -> binding; _ -> { return Ok(false) } }
    value := template_literal_value(&binding.init) == { Val(value) -> value; None -> { return Ok(false) } }
    if binding.pattern == Val(pattern) { interp.bind_pattern(pattern, ^value, scope)? } else { scope.insert(binding.name.clone(), ^value) }
    sync_template_binding_types(interp, scope)
    Ok(true)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2170
fn expand_derive_items(body: &[DeriveBodyItem], interp: &Interp, scope: &[String:CtValue], out: &[Item]) -> Unit Diagnostic! {
    for body_item in body {
        sync_template_binding_types(interp, scope)
        body_item == {
            DeriveBodyItem.Stmt(stmt) -> {
                stmts := [stmt.clone()]
                expand_template_stmts(&stmts, interp, scope)?
                if !bind_template_reified_statement(&stmts[0], interp, scope)? {
                    if stmts[0] == Stmt.Val(binding) {
                        value := interp.eval(&binding.init, scope)?
                        if binding.pattern == Val(pattern) { interp.bind_pattern(pattern, ^value, scope)? } else { scope.insert(binding.name.clone(), ^value) }
                    } else {
                        sync_template_binding_types(interp, scope)
                        _ :: interp.exec_block(&stmts, scope)?
                    }
                    sync_template_binding_types(interp, scope)
                }
            }
            DeriveBodyItem.Item(item) -> {
                item := item.clone()
                expand_template_item(&item, interp, scope)?
                out.push(^item)
            }
            DeriveBodyItem.Loop { var, source, body, .. } -> {
                value := eval_template_loop_source(source, interp, scope)?
                values := value == {
                    CtValue.List(values) -> values
                    _ -> { return Err(Diagnostic.error("E0956", "a `prep loop` source is not a compile-time list", "`prep loop` expands one item template for each value in its source list", "use a reflected/comptime list such as `T.$fields`, or a closed type list like `[TypeA, TypeB]`", Val(source.span()))) }
                }
                previous := scope.get(var).cloned()
                for value in ^values {
                    scope.insert(var.clone(), ^value)
                    sync_template_binding_types(interp, scope)
                    expand_derive_items(body, interp, scope, out)?
                }
                if previous == Val(previous) { scope.insert(var.clone(), ^previous) } else { _ :: scope.remove(var) }
                sync_template_binding_types(interp, scope)
            }
        }
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2237
// Written type names form a closed loop source; sema still checks generated declarations.
fn eval_template_loop_source(source: &Expr, interp: &Interp, scope: &[String:CtValue]) -> CtValue Diagnostic! {
    if source == Expr.Field(base, member, _) {
        binding := base == { Expr.Ident(name, _) -> Val(name); Expr.ComptimeName { name, .. } -> Val(name); _ -> None }
        if binding == Val(binding) {
            bare := binding.trim_start_matches('$') // #4303
            if scope_value(scope, &bare) == Val(CtValue.Struct { fields, .. }) {
                member_name := member.trim_start_matches('$') // #4303
                for (name, value) in fields { if name == member_name { return Ok(value.clone()) } }
            }
        }
    }
    interp.eval(source, scope) == {
        Ok(value) -> Ok(^value)
        Err(diagnostic) -> {
            values := source == { Expr.ListLit(values, _) -> values; _ -> { return Err(^diagnostic) } }
            if values.is_empty() { return Err(^diagnostic) }
            names: [CtValue] = [].with_capacity(values.len())
            for value in values {
                name := value == {
                    Expr.Ident(name, _) -> name.clone()
                    Expr.ComptimeName { name, .. } -> { bare := name.trim_start_matches('$'); bare.to_string() } // #4303
                    _ -> { return Err(^diagnostic) }
                }
                names.push(CtValue.Str(^name))
            }
            Ok(CtValue.List(^names))
        }
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2286
fn expand_template_item(item: &Item, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    item == {
        Item.Func(function) -> expand_template_func(function, interp, scope)?
        Item.Impl(implementation) -> {
            implementation.type_name = expand_template_name(&implementation.type_name, implementation.type_span, interp, scope)?
            trait_span := implementation.trait_span.unwrap_or(implementation.type_span)
            if implementation.trait_name == Val(trait_name) { trait_name = expand_template_name(trait_name, trait_span, interp, scope)? }
            for method in &implementation.methods { expand_template_func(method, interp, scope)? }
            for (_, _, ty) in &implementation.assoc_type_impls { expand_template_type(ty, interp, scope)? }
        }
        Item.ErrorConv(conversion) -> {
            conversion.from_ty = expand_template_name(&conversion.from_ty, conversion.from_span, interp, scope)?
            conversion.to_ty = expand_template_name(&conversion.to_ty, conversion.to_span, interp, scope)?
            expand_template_stmts(&conversion.body, interp, scope)?
        }
        Item.Test(test) -> {
            if test.name_expr == Val(expression) { expand_template_expr(expression, interp, scope)? }
            if test.faults_expr == Val(expression) { expand_template_expr(expression, interp, scope)? }
            if test.expected_fail_expr == Val(expression) { expand_template_expr(expression, interp, scope)? }
            for parameter in &test.params {
                expand_template_type(&parameter.ty, interp, scope)?
                if parameter.default == Val(default) { expand_template_expr(default, interp, scope)? }
            }
            expand_template_stmts(&test.body, interp, scope)?
        }
        Item.Struct(definition) -> {
            definition.name = expand_template_name(&definition.name, definition.name_span, interp, scope)?
            for field in &definition.fields {
                field.name = expand_template_name(&field.name, field.name_span, interp, scope)?
                expand_template_type(&field.ty, interp, scope)?
                if field.computed == Val(value) { expand_template_expr(value, interp, scope)? }
                if field.default == Val(value) { expand_template_expr(value, interp, scope)? }
            }
            expand_template_markers(&definition.serde_markers, interp, scope)?
            expand_template_markers(&definition.type_markers, interp, scope)?
            for method in &definition.methods { expand_template_func(method, interp, scope)? }
            for implementation in &definition.trait_impls { expand_template_trait_impl(implementation, interp, scope)? }
            expand_template_stmts(&definition.validate_block, interp, scope)?
        }
        Item.Enum(definition) -> {
            definition.name = expand_template_name(&definition.name, definition.name_span, interp, scope)?
            for variant in &definition.variants {
                variant.payload == {
                    VariantPayload.Unit -> {}
                    VariantPayload.Single(ty, _) -> expand_template_type(ty, interp, scope)?
                    VariantPayload.Named(fields) -> {
                        for field in &fields {
                            field.name = expand_template_name(&field.name, field.name_span, interp, scope)?
                            expand_template_type(&field.ty, interp, scope)?
                        }
                    }
                }
                if variant.discriminant_expr == Val(discriminant) { expand_template_expr(discriminant, interp, scope)? }
                expand_template_markers(&variant.serde_markers, interp, scope)?
            }
            expand_template_markers(&definition.serde_markers, interp, scope)?
            expand_template_markers(&definition.type_markers, interp, scope)?
            for method in &definition.methods { expand_template_func(method, interp, scope)? }
            for implementation in &definition.trait_impls { expand_template_trait_impl(implementation, interp, scope)? }
        }
        _ -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2401
fn expand_template_markers(markers: &[Marker], interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    for marker in &markers { for arg in &marker.args { if arg.as_expr_mut() == Val(expr) { expand_template_expr(expr, interp, scope)? } } }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2416
fn expand_template_trait_impl(implementation: &TraitImplBlock, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    implementation.trait_name = expand_template_name(&implementation.trait_name, implementation.trait_span, interp, scope)?
    for method in &implementation.methods { expand_template_func(method, interp, scope)? }
    for (_, _, ty) in &implementation.assoc_type_impls { expand_template_type(ty, interp, scope)? }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2436
fn expand_template_func(function: &Func, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    function.name = expand_template_name(&function.name, function.name_span, interp, scope)?
    for param in &function.params {
        expand_template_type(&param.ty, interp, scope)?
        if param.default == Val(default) { expand_template_expr(default, interp, scope)? }
    }
    if function.return_type == Val(ty) { expand_template_type(ty, interp, scope)? }
    if function.head_pattern == Val(pattern) { expand_template_pattern(pattern, interp, scope, None)? }
    for marker in &function.markers { for arg in &marker.args { if arg.as_expr_mut() == Val(expr) { expand_template_expr(expr, interp, scope)? } } }
    for clause in &function.pre { expand_template_expr(&clause.cond, interp, scope)?; expand_template_expr(&clause.message_expr, interp, scope)? }
    for clause in &function.post { expand_template_expr(&clause.cond, interp, scope)?; expand_template_expr(&clause.message_expr, interp, scope)? }
    expand_template_stmts(&function.body, interp, scope)?
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2473
fn expand_template_stmts(stmts: &[Stmt], interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    out: [Stmt] = []
    taken := stmts.take()
    for stmt in ^taken { expand_template_stmt_into(^stmt, interp, scope, &out)? }
    stmts = ^out
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2486
fn expand_template_stmt_into(stmt: Stmt, interp: &Interp, scope: &[String:CtValue], out: &[Stmt]) -> Unit Diagnostic! {
    stmt == {
        Stmt.ComptimeIf { cond, cond_span, then_body, else_body, span, .. } -> {
            chosen := if template_if_selected(&cond, cond_span, interp, scope)? { ^then_body } else { else_body.unwrap_or_default() }
            _ :: span
            expand_template_stmts(&chosen, interp, scope)?
            out.extend(^chosen)
        }
        Stmt.ComptimeBlock { is_template_loop: true, body, span } -> expand_template_loop_block(^body, span, interp, scope, out)?
        _ -> {
            expand_template_nested_bodies(&stmt, interp, scope)?
            expand_template_stmt(&stmt, interp, scope)?
            out.push(^stmt)
        }
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2528
// Select a prep-if branch before copying reused loop templates.
fn expand_template_stmt_ref_into(stmt: &Stmt, interp: &Interp, scope: &[String:CtValue], out: &[Stmt]) -> Unit Diagnostic! {
    if stmt == Stmt.ComptimeIf { cond, cond_span, then_body, else_body, .. } {
        cond := cond.clone()
        chosen := if template_if_selected(&cond, cond_span, interp, scope)? { then_body } else { else_body.as_deref().unwrap_or(&[]) }
        for stmt in chosen { expand_template_stmt_ref_into(stmt, interp, scope, out)? }
        Ok(())
    } else { expand_template_stmt_into(stmt.clone(), interp, scope, out) }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2557
fn template_if_selected(cond: &Expr, cond_span: Span, interp: &Interp, scope: &[String:CtValue]) -> Bool Diagnostic! {
    expand_template_expr(cond, interp, scope)?
    value := interp.eval(cond, scope)?
    value == {
        CtValue.Bool(selected) -> Ok(selected)
        _ -> Err(Diagnostic.error("E0989", "a `prep if` condition must be {Type.Bool.show()}, not another type", "the condition selects a branch at compile time — it must be true or false", "write a Bool known-time expression, like `prep if flag { … }`", Val(cond_span)))
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2581
fn expand_template_loop_block(body: [Stmt], span: Span, interp: &Interp, scope: &[String:CtValue], out: &[Stmt]) -> Unit Diagnostic! {
    if body.first() == Val(Stmt.For { var, kind: ForKind.In { collection, .. }, body: loop_body, .. }) {
        var := var.clone(); collection := collection.clone(); loop_body := loop_body.clone()
        value := eval_template_loop_source(&collection, interp, scope)?
        values := value == {
            CtValue.List(values) -> values
            _ -> { return Err(Diagnostic.error("E0956", "a `prep loop` source is not a compile-time list", "`prep loop` expands one statement template for each value in its source list", "use a reflected/comptime list such as `T.$fields`", Val(span))) }
        }
        previous := scope.get(&var).cloned()
        for value in ^values {
            scope.insert(var.clone(), ^value)
            // Reuse the template; untaken prep-if branches are never cloned.
            for stmt in loop_body { expand_template_stmt_ref_into(stmt, interp, scope, out)? }
        }
        if previous == Val(previous) { scope.insert(^var, ^previous) } else { _ :: scope.remove(&var) }
    } else {
        expand_template_stmts(&body, interp, scope)?
        out.extend(^body)
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2630
fn expand_template_nested_bodies(stmt: &Stmt, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    stmt == {
        Stmt.Switch { subject, arms, else_body, .. } | Stmt.ComptimeSwitch { subject, arms, else_body, .. } -> {
            for arm in &arms {
                expand_template_expr(&arm.cond, interp, scope)?
                coerce_derive_enum_arm(&arm.cond, subject, scope)
                expand_template_pattern_expr(&arm.cond, interp, scope)?
                expand_template_stmts(&arm.body, interp, scope)?
            }
            if else_body == Val(body) { expand_template_stmts(body, interp, scope)? }
        }
        Stmt.While { body, .. } | Stmt.For { body, .. } | Stmt.Loop { body, .. }
        | Stmt.Unsafe { body, .. } | Stmt.Impure { body, .. } | Stmt.Switched { body, .. }
        | Stmt.Shield { body, .. } | Stmt.Reactive { body, .. } | Stmt.Region { body, .. }
        | Stmt.Policy { body, .. } | Stmt.AuthorityScope { body, .. } | Stmt.Live { body, .. }
        | Stmt.Transact { body, .. } | Stmt.Layout { body, .. } | Stmt.ContextBlock { body, .. }
        | Stmt.ComptimeBlock { body, .. } -> expand_template_stmts(body, interp, scope)?
        Stmt.CountedLoop { body, step, .. } -> {
            expand_template_stmts(body, interp, scope)?
            if step == Val(step) {
                stmts := [step.clone()]
                expand_template_stmts(&stmts, interp, scope)?
                if stmts.pop() == Val(next) { step = ^next }
            }
        }
        Stmt.ComptimeIf { then_body, else_body, .. } -> {
            expand_template_stmts(then_body, interp, scope)?
            if else_body == Val(body) { expand_template_stmts(body, interp, scope)? }
        }
        _ -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2703
fn expand_template_stmt(stmt: &Stmt, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    stmt == {
        Stmt.Val(binding) -> expand_template_binding(binding, interp, scope)?
        Stmt.CountedLoop { init, .. } -> expand_template_binding(init, interp, scope)?
        _ -> {}
    }
    error: Diagnostic? = None
    stmt.for_each_expr_mut(fn(expr) {
        if error.is_none() { if expand_template_expr(expr, interp, scope) == Err(diagnostic) { error = Val(^diagnostic) } }
    })
    error == { Val(error) -> Err(^error); None -> Ok(()) }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2730
fn expand_template_binding(binding: &Binding, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    if binding.ty == Val(ty) { expand_template_type(ty, interp, scope)? }
    if binding.pattern == Val(pattern) { expand_template_bind_pattern(pattern, interp, scope)? }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2744
fn expand_template_bind_pattern(pattern: &BindPattern, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    pattern == {
        BindPattern.Struct { type_name, type_span, .. } -> { type_name = expand_template_name(type_name, type_span, interp, scope)? }
        BindPattern.Refutable { pattern, .. } -> expand_template_pattern(pattern, interp, scope, None)?
        BindPattern.List { .. } | BindPattern.Tuple { .. } -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2765
fn expand_template_pattern(pattern: &Pattern, interp: &Interp, scope: &[String:CtValue], subject: &Expr?) -> Unit Diagnostic! {
    pattern == {
        Pattern.Or(patterns, _) -> { for pattern in &patterns { expand_template_pattern(pattern, interp, scope, None)? } }
        Pattern.StrMatch { parts, .. } -> {
            for part in &parts { if part == StrMatchPart.Hole { ty: Val(ty), .. } { expand_template_type(ty, interp, scope)? } }
        }
        Pattern.Variant { variant, bindings, span, .. } -> {
            variant = expand_template_name(variant, span, interp, scope)?
            fill_derive_variant_bindings(variant, bindings, span, scope, subject)
        }
        Pattern.Present { .. } | Pattern.Absent(..) | Pattern.Ok { .. } | Pattern.Err { .. }
        | Pattern.Range { .. } | Pattern.Struct { .. } | Pattern.BinMatch { .. } -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2804
fn expand_template_pattern_expr(expr: &Expr, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    if expr == Expr.PatternTest { subject, pattern, .. } { expand_template_pattern(pattern, interp, scope, Val(subject))? }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2818
fn coerce_derive_enum_arm(cond: &Expr, subject: &Expr, scope: &[String:CtValue]) -> {
    cond == {
        Expr.PatternTest { .. } -> {}
        Expr.EnumLit { variant, args, span, .. } -> { cond = pattern_test_from_enum_lit(subject, variant, args, span, scope) }
        Expr.Binary(BinOp.Eq, _, rhs, _) -> {
            if rhs == Expr.EnumLit { variant, args, span, .. } { cond = pattern_test_from_enum_lit(subject, variant, args, span, scope) }
        }
        _ -> {}
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2849
fn pattern_test_from_enum_lit(subject: &Expr, variant: &String, args: &[EnumLitArg], span: Span, scope: &[String:CtValue]) -> Expr {
    bindings: [PatSlot] = []
    fill_derive_variant_bindings(variant, &bindings, span, scope, Val(subject))
    if bindings.is_empty() {
        for arg in args {
            arg == {
                EnumLitArg.Positional(Expr.Ident(name, bind_span)) | EnumLitArg.Named { expr: Expr.Ident(name, bind_span), .. } -> bindings.push(PatSlot.Bind { name: name.clone(), span: bind_span })
                _ -> {}
            }
        }
    }
    Expr.PatternTest { subject: subject.clone(), pattern: Pattern.Variant { variant: variant.to_string(), bindings: ^bindings, leading_dot: true, span: span }, span: span }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2886
fn derive_loop_side(subject: &Expr?) -> String? {
    if subject == Val(subject) {
        ident := subject == { Expr.Ident(name, _) | Expr.ComptimeName { name, .. } -> name; _ -> { return None } }
        Val(ident == { "self" -> "left"; "rhs" -> "right"; _ -> { bare := ident.trim_start_matches('$'); bare.to_string() } }) // #4303
    } else { None }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2900
fn cartesian_payload_owner(side: &String, variant: &String, scope: &[String:CtValue]) -> String {
    variant := variant.trim_start_matches('$') // #4303
    left := scope_value(scope, "left").and_then(reflected_variant_name)
    right := scope_value(scope, "right").and_then(reflected_variant_name)
    side == {
        "left" -> left == { Val(name) -> "left_{name}"; None -> "left_{variant}" }
        "right" -> (left, right) == {
            (Val(left), Val(right)) -> "right_{left}_{right}"
            (_, Val(right)) -> "right_{right}"
            (Val(left), None) if variant == "left" -> "right_{left}"
            _ -> "right_{variant}"
        }
        _ -> payload_binding_owner(&variant, scope)
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2921
fn payload_owner_for_subject(subject: &Expr?, variant: &String, scope: &[String:CtValue]) -> String {
    derive_loop_side(subject) == { Val(side) -> cartesian_payload_owner(&side, variant, scope); None -> payload_binding_owner(variant, scope) }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2932
fn fill_derive_variant_bindings(variant: &String, bindings: &[PatSlot], span: Span, scope: &[String:CtValue], subject: &Expr?) -> {
    if !bindings.is_empty() { return }
    payload := derive_variant_payload_fields(variant, scope) == { Val(payload) -> payload; None -> { return } }
    owner := payload_owner_for_subject(subject, variant, scope)
    for field in payload {
        field_name := derive_reflected_name(&field).unwrap_or("value")
        bindings.push(PatSlot.Bind { name: "{owner}_{field_name}", span: span })
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2955
fn reflected_variant_name(value: &CtValue) -> String? {
    fields := value == { CtValue.Struct { fields, .. } -> fields; _ -> { return None } }
    if !fields.iter().any(fn(pair) { pair.0 == "index" }) { return None }
    for (field, value) in fields { if field == "name" { if value == CtValue.Str(name) { return Val(name.clone()) } } }
    None
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2970
fn payload_binding_prefix(owner: &String, value: &CtValue) -> String {
    reflected_variant_name(value) == { Val(variant) -> "{owner}_{variant}"; None -> owner.to_string() }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2977
fn payload_binding_owner(variant: &String, scope: &[String:CtValue]) -> String {
    key := variant.trim_start_matches('$') // #4303
    for (name, value) in scope {
        if derive_reflected_name(value) == Val(reflected) {
            bare := name.trim_start_matches('$') // #4303
            if reflected == key || bare == key {
                if value == CtValue.Struct { fields, .. } {
                    if fields.iter().any(fn(pair) { pair.0 == "index" }) { return payload_binding_prefix(&bare, value) }
                }
            }
        }
    }
    key.to_string()
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:2996
fn derive_payload_owner(binding: &String?, scope: &[String:CtValue]) -> String? {
    binding := binding == { Val(binding) -> binding; None -> { return None } }
    side := binding == { "self" -> "left"; "rhs" -> "right"; _ -> { return None } }
    left := scope_value(scope, "left").and_then(reflected_variant_name) == { Val(left) -> left; None -> { return None } }
    Val(side == {
        "left" -> "left_{left}"
        "right" -> scope_value(scope, "right").and_then(reflected_variant_name) == { Val(right) -> "right_{left}_{right}"; None -> "right_{left}" }
        _ -> { return None }
    })
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3016
fn field_info_payload(value: &CtValue) -> [CtValue]? {
    fields := value == { CtValue.Struct { fields, .. } -> fields; _ -> { return None } }
    if !fields.iter().any(fn(pair) { pair.0 == "index" }) { return None }
    for (field, value) in fields {
        if field == "fields" {
            if value == CtValue.List(payload) { return if payload.is_empty() { None } else { Val(payload.clone()) } }
            return None
        }
    }
    None
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3033
fn derive_variant_payload_fields(variant: &String, scope: &[String:CtValue]) -> [CtValue]? {
    key := variant.trim_start_matches('$') // #4303
    if scope_value(scope, &key) == Val(value) {
        if field_info_payload(value) == Val(payload) { return Val(^payload) }
        if type_info_variant_payload(value, &key) == Val(payload) { return Val(^payload) }
    }
    for value in scope.values() {
        if type_info_variant_payload(value, &key) == Val(payload) { return Val(^payload) }
        if derive_reflected_name(value) == Val(reflected) { if reflected == key { if field_info_payload(value) == Val(payload) { return Val(^payload) } } }
    }
    None
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3059
fn type_info_variant_payload(value: &CtValue, variant: &String) -> [CtValue]? {
    if value == CtValue.Struct { type_name, fields, .. } {
        if type_name != "TypeInfo" { return None }
        for (field, value) in fields {
            if field == "fields" {
                if value == CtValue.List(variants) {
                    for variant_info in variants { if derive_reflected_name(variant_info) == Val(reflected) { if reflected == variant { return field_info_payload(variant_info) } } }
                }
                return None
            }
        }
    }
    None
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3080
fn derive_reflected_name(value: &CtValue) -> String? {
    if value == CtValue.Struct { fields, .. } {
        for (name, value) in fields { if name == "name" { if value == CtValue.Str(name) { return Val(name.clone()) } } }
    }
    None
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3092
fn expand_template_name(name: &String, span: Span, interp: &Interp, scope: &[String:CtValue]) -> String Diagnostic! {
    explicit := name.starts_with('$')
    binding := name.strip_prefix('$').unwrap_or(name) // #4303
    scope_value(scope, &binding) == {
        Val(CtValue.Str(value)) -> Ok(value.clone())
        Val(CtValue.Struct { fields, .. }) if explicit -> {
            for (field, value) in fields {
                if field == "name" { if value == CtValue.Str(value) { return Ok(value.clone()) }; break }
            }
            Err(Diagnostic.error("E0956", "compile-time name `${binding}` has no text name", "a generated item name needs the reflected value's `name` field", "bind the name to a String value", Val(span)))
        }
        Val(value) if explicit -> Err(Diagnostic.error("E0956", "compile-time name `{name}` is not text", "a generated item name needs text, but this value is {value.jet_type().name()}", "bind the name to a String value", Val(span)))
        _ -> { _ :: interp; Ok(name.to_string()) }
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3136
fn expand_template_expr(expr: &Expr, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    error: Diagnostic? = None
    expr.for_each_expr_mut(fn(node) {
        if error.is_none() { if expand_template_expr_node(node, interp, scope) == Err(diagnostic) { error = Val(^diagnostic) } }
    })
    error == { Val(error) -> Err(^error); None -> Ok(()) }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3152
fn expand_template_expr_node(expr: &Expr, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    span := expr.span()
    expr == {
        Expr.Field(base, member, _) -> {
            binding := base == { Expr.Ident(name, _) | Expr.ComptimeName { name, .. } -> Val(name); _ -> None }
            if binding == Val(binding) {
                bare := binding.trim_start_matches('$') // #4303
                if scope_value(scope, &bare) == Val(CtValue.Struct { fields, .. }) {
                    member_name := member.trim_start_matches('$') // #4303
                    for (name, value) in fields {
                        if name == member_name {
                            if comptime_literal_expr(value.clone(), span) == Val(literal) { expr = ^literal; return Ok(()) }
                            break
                        }
                    }
                }
            }
            // Unbound $members are compiler facts and remain for sema; bound ones splice.
            if member.strip_prefix('$') == Val(bare) {
                if scope_value(scope, &bare).is_some() {
                    if derive_payload_owner(binding, scope) == Val(payload_owner) {
                        field_name := expand_template_name(member, span, interp, scope)?
                        expr = Expr.Ident("{payload_owner}_{field_name}", span)
                        return Ok(())
                    }
                    member = expand_template_name(member, span, interp, scope)?
                }
            }
        }
        Expr.ComptimeName { name, .. } -> {
            bare := name.trim_start_matches('$') // #4303
            if scope_value(scope, &bare) == Val(value) { if comptime_literal_expr(value.clone(), span) == Val(literal) { expr = ^literal } }
        }
        Expr.Ident(name, _) if name.starts_with('$') -> {
            bare := name.trim_start_matches('$') // #4303
            if scope_value(scope, &bare) == Val(value) { if comptime_literal_expr(value.clone(), span) == Val(literal) { expr = ^literal } }
        }
        Expr.StrMatchLit(parts, _) -> {
            for part in &parts { if part == StrMatchPart.Hole { ty: Val(ty), .. } { expand_template_type(ty, interp, scope)? } }
        }
        Expr.Call(call) -> {
            call.name = expand_template_name(&call.name, call.name_span, interp, scope)?
            for ty in &call.type_args { expand_template_type(ty, interp, scope)? }
        }
        Expr.MethodCall { receiver, method, method_span, owner_type_args, type_args, args, .. } -> {
            if method == "reflect" && args.is_empty() && owner_type_args.is_empty() && type_args.is_empty() {
                binding := receiver == {
                    Expr.Ident(name, _) | Expr.ComptimeName { name, .. } -> { bare := name.trim_start_matches('$'); Val(bare) } // #4303
                    _ -> None
                }
                if binding == Val(binding) {
                    if scope_value(scope, &binding) == Val(value) {
                        if value == CtValue.Struct { type_name, .. } {
                            if type_name == "TypeInfo" { if comptime_literal_expr(value.clone(), span) == Val(literal) { expr = ^literal; return Ok(()) } }
                        }
                    }
                }
            }
            method = expand_template_name(method, method_span, interp, scope)?
            for ty in &owner_type_args { expand_template_type(ty, interp, scope)? }
            for ty in &type_args { expand_template_type(ty, interp, scope)? }
        }
        Expr.Lambda(lambda) -> { for param in &lambda.params { if param.ty == Val(ty) { expand_template_type(ty, interp, scope)? } } }
        Expr.PtrFromAddr { elem, .. } -> expand_template_type(elem, interp, scope)?
        Expr.StructLit { type_name, type_args, .. } -> {
            type_name = expand_template_name(type_name, span, interp, scope)?
            for ty in &type_args { expand_template_type(ty, interp, scope)? }
        }
        Expr.TypedLit { head: Val(head), .. } -> expand_template_type(head, interp, scope)?
        Expr.EnumLit { type_name, variant, args, .. } -> {
            variant_key := variant.clone()
            if args.is_empty() {
                if derive_variant_payload_fields(&variant_key, scope) == Val(payload) {
                    owner := payload_binding_owner(&variant_key, scope)
                    for field in payload {
                        field_name := derive_reflected_name(&field).unwrap_or("value")
                        args.push(EnumLitArg.Positional(Expr.Ident("{owner}_{field_name}", span)))
                    }
                }
            }
            type_name = expand_template_name(type_name, span, interp, scope)?
            variant = expand_template_name(variant, span, interp, scope)?
        }
        Expr.PatternTest { subject, pattern, .. } -> expand_template_pattern(pattern, interp, scope, Val(subject))?
        _ -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3319
fn scope_value(scope: &[String:CtValue], name: &String) -> &CtValue? {
    scope.get(name).or_else(fn() { scope.get(&"${name}") })
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3323
fn comptime_literal_expr(value: CtValue, span: Span) -> Expr? {
    // Preserve unit-enum substitutions until the shared typed boundary folds compiler facts.
    if value == CtValue.Enum { args, .. } {
        if args.is_empty() { return Val(Expr.ComptimeName { name: "", span: span, value: Val(^value) }) }
    }
    build_fact_expr(&value, span)
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3341
fn expand_template_type(ty: &Type, interp: &Interp, scope: &[String:CtValue]) -> Unit Diagnostic! {
    ty == {
        Type.Named(name) -> { name = expand_template_name(name, Span.new(0, 0), interp, scope)? }
        Type.List(inner) | Type.Shared(inner) | Type.Option(inner) | Type.FixedList { elem: inner, .. } | Type.Tagged { inner, .. } -> expand_template_type(inner, interp, scope)?
        Type.Map { key, value, .. } | Type.Result { ok: key, err: value } -> { expand_template_type(key, interp, scope)?; expand_template_type(value, interp, scope)? }
        Type.Fn { params, ret, .. } -> {
            for param in &params { expand_template_type(param, interp, scope)? }
            if ret == Val(ret) { expand_template_type(ret, interp, scope)? }
        }
        Type.Apply { name, args } -> {
            name = expand_template_name(name, Span.new(0, 0), interp, scope)?
            for arg in &args { expand_template_type(arg, interp, scope)? }
        }
        Type.Tuple(fields) -> { for (_, field) in &fields { expand_template_type(field, interp, scope)? } }
        Type.Union(members) -> { for member in &members { expand_template_type(member, interp, scope)? } }
        Type.Quantity { base, .. } | Type.InlineRange { base, .. } -> expand_template_type(base, interp, scope)?
        Type.Int | Type.Float | Type.Bool | Type.String | Type.Char | Type.TraitObject(_) | Type.IntN { .. } | Type.Float32 | Type.Measure(_) -> {}
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3406
// Use the same associated method table as comptime/dev for exact complete checked text.
pub fn evaluate_checked_text_check(type_name: &String, body: String, funcs: &[String:&Func], methods: &[(String, String):&Func], structs: &[String:&StructDef], distinct_bases: &[String:Type], globals: &[String:CtValue], base_dir: &OSPath, core_imports: &[String:String]) -> Unit Diagnostic! {
    span := Span.new(0, 0)
    check := Expr.MethodCall {
        receiver: Expr.Ident(type_name.to_string(), span), method: "check", method_span: span,
        owner_type_args: [], type_args: [],
        args: [CallArg { convention: AccessConvention.Read, expr: Expr.Str([StrPart.Lit(^body)], span), span: span, flags: CallArgFlags.default(), label: None, spread: false }],
        recv_type: Val(type_name.to_string()), resolved_ret: None, operator_rhs: None, checked_widen: false
    }
    (value, _) := evaluate_with_imports_opts_collecting_structs_and_methods(&check, funcs, &HashSet.new(), base_dir, globals, &[:], core_imports, GateSet.default(), 0, structs, methods, empty_method_traits(), &[:], distinct_bases, &[], None, None)?
    value == {
        CtValue.Failed(_) -> Err(Diagnostic.error("E2712", "this checked text type rejected its body", "the type's pure `CheckedText.check` method must accept the complete literal body", "fix the body so it satisfies the type's declared text grammar", Val(span)))
        _ -> Ok(())
    }
}

// Rust: crates/jet-comptime/src/Comptime/mod.rs:3472
// Known-time hole encoding proves the same complete body built by the emitted pure method.
pub fn evaluate_checked_text_hole(type_name: &String, value: &Expr, funcs: &[String:&Func], methods: &[(String, String):&Func], structs: &[String:&StructDef], distinct_bases: &[String:Type], globals: &[String:CtValue], base_dir: &OSPath, core_imports: &[String:String]) -> String Diagnostic! {
    span := value.span()
    call := Expr.MethodCall {
        receiver: Expr.Ident(type_name.to_string(), span), method: "encode_hole", method_span: span,
        owner_type_args: [], type_args: [],
        args: [CallArg { convention: AccessConvention.Read, expr: value.clone(), span: span, flags: CallArgFlags.default(), label: None, spread: false }],
        recv_type: Val(type_name.to_string()), resolved_ret: Val(Type.String), operator_rhs: None, checked_widen: false
    }
    (value, _) := evaluate_with_imports_opts_collecting_structs_and_methods(&call, funcs, &HashSet.new(), base_dir, globals, &[:], core_imports, GateSet.default(), 0, structs, methods, empty_method_traits(), &[:], distinct_bases, &[], None, None)?
    value == {
        CtValue.Str(value) -> Ok(^value)
        CtValue.Present(value) -> value == {
            CtValue.Str(value) -> Ok(^value)
            _ -> Err(Diagnostic.error("E2712", "this checked text type could not encode its hole", "`CheckedText.encode_hole` must return a String for every printable value", "return a String from `encode_hole`", Val(span)))
        }
        CtValue.Failed(_) -> Err(Diagnostic.error("E2712", "this checked text type could not encode its hole", "`CheckedText.encode_hole` must return a String for every printable value", "use a compile-time-known printable hole or construct the value with `Type.from(text)`", Val(span)))
        _ -> Err(Diagnostic.error("E2712", "this checked text type could not encode its hole", "`CheckedText.encode_hole` must return a String for every printable value", "return a String from `encode_hole`", Val(span)))
    }
}
