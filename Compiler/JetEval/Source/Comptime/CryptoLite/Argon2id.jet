}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:246
fn xor_block(dst: &Block, src: &Block) { for i in 0..128 { dst[i] ^= src[i] } }
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:252
fn copy_block(dst: &Block, src: &Block) { dst.copy_from_slice(src) }
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:256
fn fill_block(prev: &Block, reference: &Block, next: &Block, with_xor: Bool) {
    block_r := reference.clone(); xor_block(&block_r, prev)
    block_tmp := block_r.clone(); permute_block(&block_tmp)
    if with_xor { xor_block(next, &block_tmp); xor_block(next, &block_r) }
    else { copy_block(next, &block_tmp); xor_block(next, &block_r) }
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:270
fn le32(value: U32) -> [U8#4] { value.to_le_bytes() }
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:274
fn hash(password: &[U8], salt: &[U8], memory_kib: U32, iterations: U32, lanes: U32, output_length: USize) -> [U8] Unit! {
    if lanes == 0 || memory_kib < 8 * lanes || iterations == 0 || output_length == 0 -> return Err(())
    // GATE #4483: USize truncation/width follows the selected target, never the host.
    m := (memory_kib as USize / lanes as USize) * lanes as USize
    segment_length := m / (lanes as USize * 4)
    lane_length := segment_length * 4
    h0_input := [U8].new()
    h0_input.extend_from_slice(&le32(lanes)); h0_input.extend_from_slice(&le32(output_length as U32))
    h0_input.extend_from_slice(&le32(memory_kib)); h0_input.extend_from_slice(&le32(iterations))
    h0_input.extend_from_slice(&le32(0x13)); h0_input.extend_from_slice(&le32(2))
    h0_input.extend_from_slice(&le32(password.len() as U32)); h0_input.extend_from_slice(password)
    h0_input.extend_from_slice(&le32(salt.len() as U32)); h0_input.extend_from_slice(salt)
    h0_input.extend_from_slice(&le32(0)); h0_input.extend_from_slice(&le32(0))
    h0 := blake2b(&h0_input, 64)
    zero := Block{uninit}; zero.fill(0)
    memory := [Block].with_capacity(m); memory.resize(m, zero)
    for lane in 0..lanes as USize {
        for i in 0..2 {
            input := h0.clone()
            input.extend_from_slice(&le32(i as U32)); input.extend_from_slice(&le32(lane as U32))
            block_bytes := blake2b_long(&input, BLOCK_SIZE)
            memory[lane * lane_length + i] = load_block(&block_bytes)
        }
    }
    for pass in 0..iterations {
        for slice in 0..4 {
            data_independent := pass == 0 && slice < 2
            for lane in 0..lanes as USize {
                address_block := Block{uninit}; address_block.fill(0)
                input_block := Block{uninit}; input_block.fill(0)
                zero_block := Block{uninit}; zero_block.fill(0)
                if data_independent {
                    input_block[..6].copy_from_slice(&[pass as U64, lane as U64, slice as U64, m as U64, iterations as U64, U64{2}])
                }
                first_block := if pass == 0 && slice == 0 {
                    if data_independent { update_address_block(&address_block, &input_block, &zero_block) }
                    2
                } else { 0 }
                for index in first_block..segment_length {
                    pos := lane * lane_length + slice * segment_length + index
                    prev_index := if index == 0 && slice == 0 -> lane * lane_length + lane_length - 1
                        else if index == 0 -> lane * lane_length + slice * segment_length - 1 else -> pos - 1
                    prev := memory[prev_index].clone()
                    rand := if data_independent {
                        address_index := index % 128
                        if address_index == 0 { update_address_block(&address_block, &input_block, &zero_block) }
                        address_block[address_index]
                    } else { prev[0] }
                    ref_lane := if pass == 0 && slice == 0 -> lane else -> ((rand >> 32) as USize) % lanes as USize
                    (start, area) := ref_area(pass, slice, index, lane, ref_lane, segment_length, lane_length)
                    ref_index := ref_lane * lane_length + (start + mapping(rand as U32, area)) % lane_length
                    reference := memory[ref_index].clone()
                    with_xor := pass != 0
                    next := if with_xor -> memory[pos].clone() else -> zero.clone()
                    fill_block(&prev, &reference, &next, with_xor)
                    memory[pos] = next
                }
            }
        }
    }
    blockhash := memory[lane_length - 1].clone()
    for lane in 1..lanes as USize { xor_block(&blockhash, &memory[lane * lane_length + lane_length - 1]) }
    bytes := [U8#BLOCK_SIZE]{uninit}
    store_block(&blockhash, &bytes)
    Ok(blake2b_long(&bytes, output_length))
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:399
fn mapping(j1: U32, area: USize) -> USize {
    x := (j1 as U64).wrapping_mul(j1 as U64) >> 32
    y := (area as U64 * x) >> 32
    (area as U64 - 1 - y) as USize
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:405
fn update_address_block(address_block: &Block, input_block: &Block, zero_block: &Block) {
    input_block[6] = input_block[6].wrapping_add(1)
    fill_block(zero_block, input_block, address_block, false)
    address_source := address_block.clone()
    fill_block(zero_block, &address_source, address_block, false)
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:412
fn ref_area(pass: U32, slice: USize, index: USize, lane: USize, ref_lane: USize, segment_length: USize, lane_length: USize) -> (USize, USize) {
    same_lane := ref_lane == lane
    area := if pass == 0 {
        if slice == 0 -> index - 1
        else if same_lane -> slice * segment_length + index - 1
        else -> slice * segment_length - (if index == 0 -> USize{1} else -> USize{0})
    } else if same_lane -> lane_length - segment_length + index - 1
    else -> lane_length - segment_length - (if index == 0 -> USize{1} else -> USize{0})
    start := if pass != 0 && slice != 3 -> (slice + 1) * segment_length else -> 0
    (start, area)
}
