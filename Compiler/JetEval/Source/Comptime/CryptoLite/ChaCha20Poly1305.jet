// Std-only XChaCha20-Poly1305 matching draft-irtf-cfrg-xchacha and RustCrypto.
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:3
fn quarter_round(state: &[U32#16], a: USize, b: USize, c: USize, d: USize) {
    state[a] = state[a].wrapping_add(state[b]); state[d] ^= state[a]; state[d] = state[d].rotate_left(16)
    state[c] = state[c].wrapping_add(state[d]); state[b] ^= state[c]; state[b] = state[b].rotate_left(12)
    state[a] = state[a].wrapping_add(state[b]); state[d] ^= state[a]; state[d] = state[d].rotate_left(8)
    state[c] = state[c].wrapping_add(state[d]); state[b] ^= state[c]; state[b] = state[b].rotate_left(7)
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:18
fn chacha20_block(key: &[U8#32], counter: U32, nonce: &[U8#12]) -> [U8#64] {
    state: [U32#16] = [0x6170_7865, 0x3320_646e, 0x7962_2d32, 0x6b20_6574,
        U32.from_le_bytes(key[0..4].try_into().unwrap()), U32.from_le_bytes(key[4..8].try_into().unwrap()),
        U32.from_le_bytes(key[8..12].try_into().unwrap()), U32.from_le_bytes(key[12..16].try_into().unwrap()),
        U32.from_le_bytes(key[16..20].try_into().unwrap()), U32.from_le_bytes(key[20..24].try_into().unwrap()),
        U32.from_le_bytes(key[24..28].try_into().unwrap()), U32.from_le_bytes(key[28..32].try_into().unwrap()), counter,
        U32.from_le_bytes(nonce[0..4].try_into().unwrap()), U32.from_le_bytes(nonce[4..8].try_into().unwrap()), U32.from_le_bytes(nonce[8..12].try_into().unwrap())]
    initial := state.clone()
    for _ in 0..10 {
        quarter_round(&state, 0, 4, 8, 12); quarter_round(&state, 1, 5, 9, 13)
        quarter_round(&state, 2, 6, 10, 14); quarter_round(&state, 3, 7, 11, 15)
        quarter_round(&state, 0, 5, 10, 15); quarter_round(&state, 1, 6, 11, 12)
        quarter_round(&state, 2, 7, 8, 13); quarter_round(&state, 3, 4, 9, 14)
    }
    out := [U8#64]{uninit}
    for index in 0..16 {
        state[index] = state[index].wrapping_add(initial[index])
        out[index * 4..(index + 1) * 4].copy_from_slice(&state[index].to_le_bytes())
    }
    out
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:56
fn hchacha20(key: &[U8#32], nonce: &[U8#16]) -> [U8#32] {
    state: [U32#16] = [0x6170_7865, 0x3320_646e, 0x7962_2d32, 0x6b20_6574,
        U32.from_le_bytes(key[0..4].try_into().unwrap()), U32.from_le_bytes(key[4..8].try_into().unwrap()),
        U32.from_le_bytes(key[8..12].try_into().unwrap()), U32.from_le_bytes(key[12..16].try_into().unwrap()),
        U32.from_le_bytes(key[16..20].try_into().unwrap()), U32.from_le_bytes(key[20..24].try_into().unwrap()),
        U32.from_le_bytes(key[24..28].try_into().unwrap()), U32.from_le_bytes(key[28..32].try_into().unwrap()),
        U32.from_le_bytes(nonce[0..4].try_into().unwrap()), U32.from_le_bytes(nonce[4..8].try_into().unwrap()),
        U32.from_le_bytes(nonce[8..12].try_into().unwrap()), U32.from_le_bytes(nonce[12..16].try_into().unwrap())]
    for _ in 0..10 {
        quarter_round(&state, 0, 4, 8, 12); quarter_round(&state, 1, 5, 9, 13)
        quarter_round(&state, 2, 6, 10, 14); quarter_round(&state, 3, 7, 11, 15)
        quarter_round(&state, 0, 5, 10, 15); quarter_round(&state, 1, 6, 11, 12)
        quarter_round(&state, 2, 7, 8, 13); quarter_round(&state, 3, 4, 9, 14)
    }
    out := [U8#32]{uninit}
    words: [U32#8] = [state[0], state[1], state[2], state[3], state[12], state[13], state[14], state[15]]
    for (index, word) in words.iter().enumerate() { out[index * 4..(index + 1) * 4].copy_from_slice(&word.to_le_bytes()) }
    out
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:97
fn chacha20_xor(key: &[U8#32], nonce: &[U8#12], counter: U32, input: &[U8]) -> [U8] {
    out := [U8].with_capacity(input.len()); block_counter := counter
    for chunk in input.chunks(64) {
        keystream := chacha20_block(key, block_counter, nonce)
        for (byte, mask) in chunk.iter().zip(keystream.iter()) { out.push(byte ~| mask) }
        block_counter = block_counter.wrapping_add(1)
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:111
fn poly1305_mac(key: &[U8#32], message: &[U8]) -> [U8#16] {
    r := [U32#5]{uninit}; h := [U32#5]{uninit}; h.fill(0)
    pad := [U32#4]{uninit}
    r[0] = U32.from_le_bytes(key[0..4].try_into().unwrap()) & 0x3ff_ffff
    r[1] = (U32.from_le_bytes(key[3..7].try_into().unwrap()) >> 2) & 0x3ff_ff03
    r[2] = (U32.from_le_bytes(key[6..10].try_into().unwrap()) >> 4) & 0x3ff_c0ff
    r[3] = (U32.from_le_bytes(key[9..13].try_into().unwrap()) >> 6) & 0x3f0_3fff
    r[4] = (U32.from_le_bytes(key[12..16].try_into().unwrap()) >> 8) & 0x00f_ffff
    pad[0] = U32.from_le_bytes(key[16..20].try_into().unwrap()); pad[1] = U32.from_le_bytes(key[20..24].try_into().unwrap())
    pad[2] = U32.from_le_bytes(key[24..28].try_into().unwrap()); pad[3] = U32.from_le_bytes(key[28..32].try_into().unwrap())
    compute_block := fn(h: &[U32#5], block: &[U8#16], partial: Bool) {
        hibit := if partial -> U32{0} else -> U32{1} << 24
        r0 := r[0]; r1 := r[1]; r2 := r[2]; r3 := r[3]; r4 := r[4]
        s1 := r1 * 5; s2 := r2 * 5; s3 := r3 * 5; s4 := r4 * 5
        h0 := h[0]; h1 := h[1]; h2 := h[2]; h3 := h[3]; h4 := h[4]
        h0 += U32.from_le_bytes(block[0..4].try_into().unwrap()) & 0x3ff_ffff
        h1 += (U32.from_le_bytes(block[3..7].try_into().unwrap()) >> 2) & 0x3ff_ffff
        h2 += (U32.from_le_bytes(block[6..10].try_into().unwrap()) >> 4) & 0x3ff_ffff
        h3 += (U32.from_le_bytes(block[9..13].try_into().unwrap()) >> 6) & 0x3ff_ffff
        h4 += (U32.from_le_bytes(block[12..16].try_into().unwrap()) >> 8) | hibit
        d0 := h0 as U64 * r0 as U64 + h1 as U64 * s4 as U64 + h2 as U64 * s3 as U64 + h3 as U64 * s2 as U64 + h4 as U64 * s1 as U64
        d1 := h0 as U64 * r1 as U64 + h1 as U64 * r0 as U64 + h2 as U64 * s4 as U64 + h3 as U64 * s3 as U64 + h4 as U64 * s2 as U64
        d2 := h0 as U64 * r2 as U64 + h1 as U64 * r1 as U64 + h2 as U64 * r0 as U64 + h3 as U64 * s4 as U64 + h4 as U64 * s3 as U64
        d3 := h0 as U64 * r3 as U64 + h1 as U64 * r2 as U64 + h2 as U64 * r1 as U64 + h3 as U64 * r0 as U64 + h4 as U64 * s4 as U64
        d4 := h0 as U64 * r4 as U64 + h1 as U64 * r3 as U64 + h2 as U64 * r2 as U64 + h3 as U64 * r1 as U64 + h4 as U64 * r0 as U64
        c := (d0 >> 26) as U32; h0 = d0 as U32 & 0x3ff_ffff; d1 += c as U64
        c = (d1 >> 26) as U32; h1 = d1 as U32 & 0x3ff_ffff; d2 += c as U64
        c = (d2 >> 26) as U32; h2 = d2 as U32 & 0x3ff_ffff; d3 += c as U64
        c = (d3 >> 26) as U32; h3 = d3 as U32 & 0x3ff_ffff; d4 += c as U64
        c = (d4 >> 26) as U32; h4 = d4 as U32 & 0x3ff_ffff; h0 += c * 5
        c = h0 >> 26; h0 &= 0x3ff_ffff; h1 += c
        h[0] = h0; h[1] = h1; h[2] = h2; h[3] = h3; h[4] = h4
    }
    offset := USize{0}
    while offset + 16 <= message.len() {
        block := message[offset..offset + 16].try_into::<[U8#16]>().unwrap()
        compute_block(&h, &block, false); offset += 16
    }
    if offset < message.len() {
        block := [U8#16]{uninit}; block.fill(0)
        rem := &message[offset..]
        block[..rem.len()].copy_from_slice(rem); block[rem.len()] = 1
        compute_block(&h, &block, true)
    }
    h0 := h[0]; h1 := h[1]; h2 := h[2]; h3 := h[3]; h4 := h[4]
    c := h1 >> 26; h1 &= 0x3ff_ffff; h2 += c
    c = h2 >> 26; h2 &= 0x3ff_ffff; h3 += c
    c = h3 >> 26; h3 &= 0x3ff_ffff; h4 += c
    c = h4 >> 26; h4 &= 0x3ff_ffff; h0 += c * 5
    c = h0 >> 26; h0 &= 0x3ff_ffff; h1 += c
    g0 := h0.wrapping_add(5); c = g0 >> 26; g0 &= 0x3ff_ffff
    g1 := h1.wrapping_add(c); c = g1 >> 26; g1 &= 0x3ff_ffff
    g2 := h2.wrapping_add(c); c = g2 >> 26; g2 &= 0x3ff_ffff
    g3 := h3.wrapping_add(c); c = g3 >> 26; g3 &= 0x3ff_ffff
    g4 := h4.wrapping_add(c).wrapping_sub(1 << 26)
    mask := (g4 >> 31).wrapping_sub(1)
    g0 &= mask; g1 &= mask; g2 &= mask; g3 &= mask; g4 &= mask
    mask = !mask
    h0 = (h0 & mask) | g0; h1 = (h1 & mask) | g1; h2 = (h2 & mask) | g2; h3 = (h3 & mask) | g3; h4 = (h4 & mask) | g4
    h0 |= h1 << 26; h1 = (h1 >> 6) | (h2 << 20); h2 = (h2 >> 12) | (h3 << 14); h3 = (h3 >> 18) | (h4 << 8)
    f := h0 as U64 + pad[0] as U64; h0 = f as U32
    f = h1 as U64 + pad[1] as U64 + (f >> 32); h1 = f as U32
    f = h2 as U64 + pad[2] as U64 + (f >> 32); h2 = f as U32
    f = h3 as U64 + pad[3] as U64 + (f >> 32); h3 = f as U32
    tag := [U8#16]{uninit}
    tag[0..4].copy_from_slice(&h0.to_le_bytes()); tag[4..8].copy_from_slice(&h1.to_le_bytes())
    tag[8..12].copy_from_slice(&h2.to_le_bytes()); tag[12..16].copy_from_slice(&h3.to_le_bytes())
    tag
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:286
fn pad16(buf: &[U8]) { while buf.len() % 16 != 0 { buf.push(0) } }
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:292
fn chacha20poly1305_seal(key: &[U8#32], nonce: &[U8#12], plaintext: &[U8], aad: &[U8]) -> [U8] {
    poly_key := [U8#32]{uninit}
    poly_key.copy_from_slice(&chacha20_block(key, 0, nonce)[..32])
    ciphertext := chacha20_xor(key, nonce, 1, plaintext)
    mac_data := [U8].with_capacity(aad.len() + 16 + ciphertext.len() + 16 + 16)
    mac_data.extend_from_slice(aad); pad16(&mac_data); mac_data.extend_from_slice(&ciphertext); pad16(&mac_data)
    mac_data.extend_from_slice(&(aad.len() as U64).to_le_bytes()); mac_data.extend_from_slice(&(ciphertext.len() as U64).to_le_bytes())
    tag := poly1305_mac(&poly_key, &mac_data)
    out := ^ciphertext; out.extend_from_slice(&tag)
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:314
fn chacha20poly1305_open(key: &[U8#32], nonce: &[U8#12], ciphertext: &[U8], aad: &[U8]) -> [U8] Unit! {
    if ciphertext.len() < 16 -> return Err(())
    (body, tag) := ciphertext.split_at(ciphertext.len() - 16)
    poly_key := [U8#32]{uninit}
    poly_key.copy_from_slice(&chacha20_block(key, 0, nonce)[..32])
    mac_data := [U8].with_capacity(aad.len() + 16 + body.len() + 16 + 16)
    mac_data.extend_from_slice(aad); pad16(&mac_data); mac_data.extend_from_slice(body); pad16(&mac_data)
    mac_data.extend_from_slice(&(aad.len() as U64).to_le_bytes()); mac_data.extend_from_slice(&(body.len() as U64).to_le_bytes())
    expected := poly1305_mac(&poly_key, &mac_data); diff := U8{0}
    for (left, right) in expected.iter().zip(tag.iter()) { diff |= left ~| right }
    if diff != 0 -> return Err(())
    Ok(chacha20_xor(key, nonce, 1, body))
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:344
fn xchacha20poly1305_seal(key: &[U8], nonce: &[U8], plaintext: &[U8], aad: &[U8]) -> [U8] Unit! {
    key := key.try_into::<[U8#32]>().map_err(fn(_) { () })?
    nonce := nonce.try_into::<[U8#24]>().map_err(fn(_) { () })?
    subkey := hchacha20(&key, nonce[..16].try_into().unwrap())
    sub_nonce := [U8#12]{uninit}; sub_nonce.fill(0)
    sub_nonce[4..].copy_from_slice(&nonce[16..])
    Ok(chacha20poly1305_seal(&subkey, &sub_nonce, plaintext, aad))
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:358
fn xchacha20poly1305_open(key: &[U8], nonce: &[U8], ciphertext: &[U8], aad: &[U8]) -> [U8] Unit! {
    key := key.try_into::<[U8#32]>().map_err(fn(_) { () })?
    nonce := nonce.try_into::<[U8#24]>().map_err(fn(_) { () })?
    subkey := hchacha20(&key, nonce[..16].try_into().unwrap())
    sub_nonce := [U8#12]{uninit}; sub_nonce.fill(0)
    sub_nonce[4..].copy_from_slice(&nonce[16..])
    chacha20poly1305_open(&subkey, &sub_nonce, ciphertext, aad)
}
