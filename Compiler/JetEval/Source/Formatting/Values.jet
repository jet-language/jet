// Compiler-time string formatting.
//
// Display and Debug interpolation port MIREval's BuildString rendering: the
// `core.text.fmt.display`/`debug` routes render through `display_core_pure_value`
// (CorePureParity `display`), `mir_show` for checked user nominals, the plain-enum
// native print path, and CorePureParity `debug`. Numeric and padding selectors
// invoke the corresponding source-owned Core/Text/fmt function and otherwise
// fail closed.

fn jet_eval_format_char_text(code: Int) -> String Never! {
    bytes := [U8]{}
    if {
        code < 128 -> &bytes.push(U8{code})
        code < 2048 -> {
            &bytes.push(U8{(192).bit_or((code >> 6))})
            &bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
        code < 65536 -> {
            &bytes.push(U8{(224).bit_or((code >> 12))})
            &bytes.push(U8{(128).bit_or((((code >> 6)).bit_and(63)))})
            &bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
        else -> {
            &bytes.push(U8{(240).bit_or((code >> 18))})
            &bytes.push(U8{(128).bit_or((((code >> 12)).bit_and(63)))})
            &bytes.push(U8{(128).bit_or((((code >> 6)).bit_and(63)))})
            &bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
    }
    String.from_bytes(bytes) ?? ""
}
