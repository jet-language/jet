// Formatting adapters for interpolation selectors.
//
// Float and String selectors invoke the source-owned Core/text/fmt function
// directly: checked MIR keeps the selector on the BuildString part, so no
// Prelude row is interned for it. Exact-integer selectors port the shared
// `Prelude/Core/Fmt.rs` decimal-spelling kernels (`jet_fmt_decimal_int`,
// `jet_fmt_grouped_int`, `jet_fmt_hex_decimal`, `jet_fmt_bin_decimal`,
// `jet_fmt_oct_decimal`) that MIREval's `core.text.fmt` route applies to Int
// and BigInt, because Core/text/fmt has no exact-integer source function.
use jet_foundation.[
    Span,
    TComptimeValue,
]

fn jet_eval_format_core_source_call(
    machine: &JetEvalMachine,
    member: String,
    args: [TComptimeValue],
    span: Span,
) -> String? {
    function :: jet_eval_source_member_function(machine.program, member, args.len()) ?? {
        jet_eval_unsupported(&machine, span, "core.text.fmt.{member} source function is unavailable")
        return None
    }
    runtime_args :: loop arg in args -> JetEvalRuntimeValue.Data{value: arg}
    runtime :: jet_eval_invoke(&machine, function, runtime_args, [JetEvalRuntimeValue]{}, span) ?? return None
    data :: jet_eval_data(runtime, &machine, span) ?? return None
    if data == {
        .String(text) -> Val(text)
        else -> {
            jet_eval_unsupported(&machine, span, "core.text.fmt.{member} source function did not return String")
            None
        }
    }
}

// The exact decimal spelling of an Int/BigInt carrier.
fn jet_eval_format_exact_spelling(value: TComptimeValue) -> String? {
    if value == {
        .Int(number) -> Val("{number}")
        .BigInt(decimal) -> Val(decimal)
        else -> None
    }
}

fn jet_eval_format_is_ascii_digits(bytes: [U8]) -> Bool Never! {
    loop byte in bytes {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return false
    }
    true
}

// `format_decimal_int`: sign, optional thousands grouping, and `precision`
// zero fraction digits over an exact decimal spelling.
fn jet_eval_format_decimal_int(spelling: String, precision: Int, grouped: Bool) -> String Never! {
    text := spelling.trim()
    negative := false
    digits := text
    if text.starts_with("-") {
        negative = true
        digits = text.slice(1, text.len())
    } else if text.starts_with("+") {
        digits = text.slice(1, text.len())
    }
    raw := digits.bytes()
    if raw.len() == 0 || !jet_eval_format_is_ascii_digits(raw) -> return text
    start := 0
    loop start < raw.len() && Int.from_u8(raw[start]) == 48 -> start += 1
    kept := [U8]{}
    loop index in start..<raw.len() -> &kept.push(raw[index])
    if kept.len() == 0 -> &kept.push(U8{48})
    zero :: kept.len() == 1 && Int.from_u8(kept[0]) == 48
    out := [U8]{}
    if negative && !zero -> &out.push(U8{45})
    loop index in 0..<kept.len() {
        if grouped && index > 0 && (kept.len() - index) % 3 == 0 -> &out.push(U8{44})
        &out.push(kept[index])
    }
    if precision > 0 {
        &out.push(U8{46})
        loop _ in 0..<precision -> &out.push(U8{48})
    }
    String.from_bytes(out) ?? text
}

// `jet_fmt_radix_decimal`: long division of the exact decimal spelling into
// lowercase `radix` digits, zero-padded to `width`, keeping a non-zero sign.
fn jet_eval_format_radix_decimal(spelling: String, radix: Int, width: Int) -> String Never! {
    text := spelling.trim()
    negative := false
    digits := text
    if text.starts_with("-") {
        negative = true
        digits = text.slice(1, text.len())
    } else if text.starts_with("+") {
        digits = text.slice(1, text.len())
    }
    decimal := [Int]{}
    loop byte in digits.bytes() {
        digit :: Int.from_u8(byte) - 48
        if digit < 0 || digit > 9 -> return text
        if digit != 0 || decimal.len() != 0 -> &decimal.push(digit)
    }
    if decimal.len() == 0 {
        if digits.len() == 0 -> return text
        &decimal.push(0)
    }
    alphabet :: "0123456789abcdef".bytes()
    converted := [U8]{}
    loop {
        nonzero := false
        loop digit in decimal {
            if digit != 0 -> nonzero = true
        }
        if !nonzero -> break
        carry := 0
        quotient := [Int]{}
        loop digit in decimal {
            current :: carry * 10 + digit
            next_digit :: current /% radix
            carry = current % radix
            if quotient.len() != 0 || next_digit != 0 -> &quotient.push(next_digit)
        }
        &converted.push(alphabet[carry])
        decimal = quotient
    }
    if converted.len() == 0 -> &converted.push(U8{48})
    zero :: converted.len() == 1 && Int.from_u8(converted[0]) == 48
    out := [U8]{}
    if negative && !zero -> &out.push(U8{45})
    padding :: if width > converted.len() -> width - converted.len() else -> 0
    loop _ in 0..<padding -> &out.push(U8{48})
    index := converted.len() - 1
    loop index >= 0 {
        &out.push(converted[index])
        index -= 1
    }
    String.from_bytes(out) ?? text
}

fn jet_eval_format_fixed_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    precision: Int,
    grouped: Bool,
    span: Span,
) -> String? {
    member :: if grouped -> "grouped" else -> "decimal"
    if value == {
        .Float(number, _) -> jet_eval_format_core_source_call(
            &machine,
            member,
            [TComptimeValue]{TComptimeValue.Float{value: number, bits: 64}, TComptimeValue.Int{value: precision}},
            span,
        )
        else -> {
            spelling :: jet_eval_format_exact_spelling(value) ?? {
                jet_eval_unsupported(&machine, span, "core.text.fmt.{member} formatting requires a Float or Int")
                return None
            }
            Val(jet_eval_format_decimal_int(spelling, precision, grouped))
        }
    }
}

fn jet_eval_format_radix_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    base: Int,
    width: Int,
    span: Span,
) -> String? {
    spelling :: jet_eval_format_exact_spelling(value) ?? {
        jet_eval_unsupported(&machine, span, "core.text.fmt radix formatting requires an Int")
        return None
    }
    Val(jet_eval_format_radix_decimal(spelling, base, width))
}

// MIREval's `sci`/`percent` read their operand with `as_float`, so an exact
// Int formats through the Float source function.
fn jet_eval_format_float_operand(value: TComptimeValue) -> Float? {
    if value == {
        .Float(number, _) -> Val(number)
        .Int(number) -> Val(Float.from_int(number))
        else -> None
    }
}

fn jet_eval_format_scientific_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    precision: Int,
    span: Span,
) -> String? {
    number :: jet_eval_format_float_operand(value) ?? {
        jet_eval_unsupported(&machine, span, "core.text.fmt.sci formatting requires a Float or Int")
        return None
    }
    jet_eval_format_core_source_call(
        &machine,
        "sci",
        [TComptimeValue]{TComptimeValue.Float{value: number, bits: 64}, TComptimeValue.Int{value: precision}},
        span,
    )
}

fn jet_eval_format_percent_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    precision: Int,
    span: Span,
) -> String? {
    number :: jet_eval_format_float_operand(value) ?? {
        jet_eval_unsupported(&machine, span, "core.text.fmt.percent formatting requires a Float or Int")
        return None
    }
    jet_eval_format_core_source_call(
        &machine,
        "percent",
        [TComptimeValue]{TComptimeValue.Float{value: number, bits: 64}, TComptimeValue.Int{value: precision}},
        span,
    )
}

fn jet_eval_format_padding_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    width: Int,
    fill: String,
    left: Bool,
    span: Span,
) -> String? {
    if value == {
        .String(text) -> {
            member :: if left -> "pad_left" else -> "pad"
            jet_eval_format_core_source_call(
                &machine,
                member,
                [TComptimeValue]{TComptimeValue.String{value: text}, TComptimeValue.Int{value: width}, TComptimeValue.String{value: fill}},
                span,
            )
        }
        else -> {
            jet_eval_unsupported(&machine, span, "core.text.fmt padding source formatting requires String")
            None
        }
    }
}

fn jet_eval_format_pretty_value(
    machine: &JetEvalMachine,
    value: TComptimeValue,
    span: Span,
) -> String? {
    if value == {
        .String(text) -> jet_eval_format_core_source_call(&machine, "pretty", [TComptimeValue]{TComptimeValue.String{value: text}}, span)
        else -> {
            jet_eval_unsupported(&machine, span, "core.text.fmt.pretty source formatting requires String")
            None
        }
    }
}
