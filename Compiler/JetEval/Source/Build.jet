use std.[env, fs]
use core.path.OSPath

// Rust: crates/jet-comptime/build.rs:3
// GATE #4494: build-time environment and filesystem use canonical native providers.
fn main() {
    manifest :: OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    write_web_kernel_std(manifest)
    write_native_scheduler(manifest)
    write_clock_rt(manifest)
    write_pool_rt(manifest)
}

// Rust: crates/jet-comptime/build.rs:11
fn write_pool_rt(manifest: &OSPath) {
    source :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs")
    println("cargo:rerun-if-changed={source.display()}")
    pool :: extract_pool(fs.read_to_string(source).expect("read canonical Pool kernel"))
    body := String.from("pub mod jet_std {\nuse jet_foundation::Outcome::{JetAbsent, JetOutcome};\n")
    body.push_str(pool)
    body.push_str("\n}\n")
    out :: OSPath.from(env.var("OUT_DIR").unwrap()).join("pool_rt.rs")
    fs.write(out, body).expect("write pool_rt.rs")
}

// Rust: crates/jet-comptime/build.rs:24
fn write_clock_rt(manifest: &OSPath) {
    types_path :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/CommonTypes.rs")
    operations_path :: manifest.join("../jet-codegen/src/Prelude/CoreLib/Top/MathRandomTime.rs")
    println("cargo:rerun-if-changed={types_path.display()}")
    println("cargo:rerun-if-changed={operations_path.display()}")
    types :: fs.read_to_string(types_path).expect("read canonical Clock types")
    start :: types.find("#[derive(Debug)]\npub enum ClockState {").expect("ClockState")
    end :: types.find("#[derive(Clone, Debug, PartialEq)]\npub struct Rng {").expect("Rng")
    body := String.from("pub mod jet_std {\n")
    body.push_str(types[start..end])
    body.push_str("\n}\n")
    operations :: fs.read_to_string(operations_path).expect("read canonical Clock operations")
    operation_start :: operations.find("fn jet_std_clock_new(").expect("Clock.new")
    operation_end :: operations.find("fn jet_clock_wait(").expect("Clock.wait")
    body.push_str(operations[operation_start..operation_end].replace("fn jet_", "pub fn jet_"))
    out :: OSPath.from(env.var("OUT_DIR").unwrap()).join("clock_rt.rs")
    fs.write(out, body).expect("write clock_rt.rs")
}

// Rust: crates/jet-comptime/build.rs:43
fn write_web_kernel_std(manifest: &OSPath) {
    reactive_src :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/ReactiveEventWatch.rs")
    encoding_types_src :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs")
    json_codec_src :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/JSONCodec.rs")
    math_task_src :: manifest.join("../jet-codegen/src/Prelude/CoreLib/JetStd/MathTaskMem.rs")
    for source in [reactive_src, encoding_types_src, json_codec_src, math_task_src] {
        println("cargo:rerun-if-changed={source.display()}")
    }
    reactive :: extract_reactive(fs.read_to_string(reactive_src).expect("read ReactiveEventWatch.rs"))
    encoding_types :: unindent(fs.read_to_string(encoding_types_src).expect("read EncodingTypes.rs"))
    json_codec :: unindent(fs.read_to_string(json_codec_src).expect("read JSONCodec.rs"))
    native_task :: extract_native_task(fs.read_to_string(math_task_src).expect("read MathTaskMem.rs"))
    shared :: extract_shared(fs.read_to_string(math_task_src).expect("read MathTaskMem.rs"))
    body := String.with_capacity(native_task.len() + shared.len() + reactive.len() + encoding_types.len() + json_codec.len() + 4)
    body.push_str("use jet_foundation::Outcome::{JetAbsent, JetOutcome};\n")
    body.push_str(native_task)
    body.push('\n')
    body.push_str(shared)
    body.push('\n')
    body.push_str(reactive)
    body.push('\n')
    body.push_str(encoding_types)
    body.push('\n')
    body.push_str(json_codec)
    out :: OSPath.from(env.var("OUT_DIR").unwrap()).join("web_kernel_std.rs")
    fs.write(out, body).expect("write web_kernel_std.rs")
}

// Rust: crates/jet-comptime/build.rs:81
fn write_native_scheduler(manifest: &OSPath) {
    runtime_control_src :: manifest.join("../jet-codegen/src/Prelude/Core/RuntimeControl.rs")
    sources :: [
        (manifest.join("../jet-codegen/src/Prelude/Deadline.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/WorkflowWait.rs"), false),
        (manifest.join("../jet-codegen/src/SchedulerHost.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/TimeMonotonic.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/TimeInstant.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/Realtime.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/CoreLib/Top/TimeSleep.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Scheduler.rs"), true),
        (manifest.join("../jet-codegen/src/Prelude/CoreLib/Top/WorkflowSleep.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Stream.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/Duration.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/Time.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Core/Stream.rs"), false),
        (manifest.join("../jet-codegen/src/Prelude/Observe.rs"), false),
    ]
    println("cargo:rerun-if-changed={runtime_control_src.display()}")
    body := String.new()
    for (source, native_cfg) in sources {
        println("cargo:rerun-if-changed={source.display()}")
        text := fs.read_to_string(source).unwrap_or_else(fn(error) { panic("read {source.display()}: {error}") })
        if native_cfg { text = text.replace("feature = \"jet_native_io\"", "all()") }
        body.push_str(text)
        body.push_str("\n\n")
    }
    body.push_str(extract_stm(fs.read_to_string(runtime_control_src).unwrap_or_else(fn(error) {
        panic("read {runtime_control_src.display()}: {error}")
    })))
    body.push_str("\n\n")
    out :: OSPath.from(env.var("OUT_DIR").unwrap()).join("web_kernel_native_scheduler.rs")
    fs.write(out, body).expect("write web_kernel_native_scheduler.rs")
}

// Rust: crates/jet-comptime/build.rs:123
fn unindent(source: String) -> String {
    source.lines().map(fn(line) { line.strip_prefix("    ").unwrap_or(line) }).collect::<[String]>().join("\n")
}

// Rust: crates/jet-comptime/build.rs:131
fn extract_reactive(raw: String) -> String {
    start :: raw.find("// ── D-REACT1=B + D-DATARACE1=C").expect("reactive marker")
    end_sync :: raw.find("    pub struct JetAsyncPolicy").expect("JetAsyncPolicy marker")
    start_hooks :: raw.find("    struct JetHookListener<").expect("JetHookListener marker")
    end_hooks :: raw.find("    pub struct WatchHandle").expect("WatchHandle marker")
    body := unindent(raw[start..end_sync])
    strip_orphan_derives(&body)
    body.push('\n')
    body.push_str(unindent(raw[start_hooks..end_hooks]))
    strip_orphan_derives(&body)
    body
}

// Rust: crates/jet-comptime/build.rs:153
fn extract_native_task(raw: String) -> String {
    start :: raw.find("    struct JetTaskState<T: Send + 'static> {").expect("JetTaskState marker")
    end :: raw.find("    fn jet_task_entries<T: Send + 'static>(").expect("jet_task_entries marker")
    unindent(raw[start..end])
}

// Rust: crates/jet-comptime/build.rs:162
fn extract_pool(raw: String) -> String {
    pool_start :: raw.find("    enum JetPoolSlot<T>").expect("JetPoolSlot marker")
    pool_end :: pool_start + raw[pool_start..].find("    // D-MEM1 S6: an opaque-handle placeholder").expect("JetPool display marker")
    id_start :: raw.find("    pub struct JetId<T>").expect("JetId marker")
    id_end :: raw.find("    impl<T> super::__jet_Equatable").expect("JetId semantic adapter marker")
    body := unindent(raw[pool_start..pool_end])
    body.push('\n')
    body.push_str(unindent(raw[id_start..id_end]))
    body
}

// Rust: crates/jet-comptime/build.rs:181
fn extract_shared(raw: String) -> String {
    start :: raw.find("    #[derive(Clone, Copy, Debug, Eq, PartialEq)]\n    pub enum JetSharedRevisionError").expect("JetSharedRevisionError marker")
    end :: raw.find("    enum JetPoolSlot<T>").expect("JetPoolSlot marker")
    shared := raw[start..end].to_string()
    jit_start :: shared.find("    // jet:source-shared-interop-jit-begin\n").expect("SourceSharedInterop begin marker")
    jit_end :: shared[jit_start..].find("    // jet:source-shared-interop-jit-end\n")
        .map(fn(offset) { jit_start + offset }).expect("SourceSharedInterop end marker")
    jit_line_end :: shared[jit_end..].find('\n').map(fn(offset) { jit_end + offset + 1 }).unwrap_or(shared.len())
    shared.replace_range(jit_start..jit_line_end, "")
    unindent(shared).replace("crate::", "super::super::")
}

// Rust: crates/jet-comptime/build.rs:206
fn extract_stm(raw: String) -> String {
    start :: raw.find("mod jet_stm {\n").expect("jet_stm marker")
    end :: raw[start..].find("\n}\ntrait __jet_Serialize").map(fn(offset) { start + offset + 2 }).expect("jet_stm end marker")
    raw[start..end].replace("crate::", "super::super::")
}

// Rust: crates/jet-comptime/build.rs:215
fn strip_orphan_derives(body: &String) {
    loop {
        trimmed := body.trim_end() // #4303
        orphan :: trimmed.ends_with("#[derive(Clone)]") || trimmed.ends_with("#[derive(Clone, Copy)]") ||
            trimmed.ends_with("#[derive(Clone, Copy, Debug, Eq, PartialEq)]") ||
            trimmed.ends_with("#[derive(Clone, Copy, Debug, PartialEq, Eq)]")
        if !orphan { break }
        if body.rfind("#[derive") == Val(index) {
            body.truncate(index)
            text := body.trim_end() // #4303
            body = text.to_string()
        } else { break }
    }
}
