// Compile-time code runs natively. Each comptime batch (and each fn-build,
// fn-dev or `jet eval` entry) is compiled to x86-64 at O0, bound in memory
// to the runtime image `jet build` links (JetBackend MemoryLink.jet), and
// loaded into a long-lived child of the compiler that runs that image's own
// runtime (owner ruling A3). The child serves the compiler over two pipes
// (JetBackend Image/SessionHost.jet, JetRuntime ComptimeServe.jet):
// - the compiler CALLs an item's wrapper, which stores the result in a
//   cell the compiler then READs back as compiler data (Values.jet);
// - host routes (compiler values, comptime inputs: JetIR ir_host_route)
//   come back as HOST requests, which the compiler answers by writing
//   runtime values into the child (Host.jet) before it RETURNs;
// - runtime stops come back as STOPs carrying their texts, and a seccomp
//   filter turns every host effect into a REFUSED report.
// Evaluation limits stay: fuel is a time budget per call (the child is
// killed when it runs out), call depth is the child's stack.
//
// One session holds two children: the comptime child, whose effects are
// refused, and the runtime child of fn build and fn dev, which may write its
// standard output. Each child is spawned on first use and again after it
// ended; a batch whose child was replaced is loaded again at the same
// addresses (each batch has its own, above the last one).
use core.math as math
use jet_foundation.[Span, TComptimeValue, compiler_take_rows, compiler_threads_single, diagnostic_from_registry, diagnostic_registry_row, diagnostic_with_rights]
use jet_ir.[IRFunction, IRModule, IROp, IRProgram, IRSlotKind, IRType, ir_align8, ir_args, ir_emit, ir_function_new, ir_intern_name, ir_intern_text, ir_module_new, ir_pointer_row, ir_slot, ir_string_row, ir_word_row, ir_x64_compile_module, ir_x64_object]
use jet_backend.[
    X64ComptimeChild,
    X64ComptimeCode,
    X64Segment,
    X64_COMPTIME_ALLOC,
    X64_COMPTIME_CALL,
    X64_COMPTIME_DONE,
    X64_COMPTIME_HOST,
    X64_COMPTIME_HOST_FIELD,
    X64_COMPTIME_HOST_INPUT,
    X64_COMPTIME_HOST_METHOD,
    X64_COMPTIME_HOST_MISSING,
    X64_COMPTIME_INT,
    X64_COMPTIME_READ,
    X64_COMPTIME_REFUSED,
    X64_COMPTIME_RETURN,
    X64_COMPTIME_STOP,
    X64_COMPTIME_STOP_LIST_BOUNDS,
    X64_COMPTIME_STOP_MESSAGE,
    X64_COMPTIME_STOP_REQUIRE,
    X64_COMPTIME_STOP_SHIFT,
    X64_COMPTIME_TEXT,
    X64_COMPTIME_WRITE,
    os_page_round,
    x64_comptime_close,
    x64_comptime_code,
    x64_comptime_frame,
    x64_comptime_load,
    x64_comptime_put_word,
    x64_comptime_reap,
    x64_comptime_receive,
    x64_comptime_receive_bytes,
    x64_comptime_send,
    x64_comptime_settle,
    x64_comptime_spawn,
    x64_comptime_symbols,
    x64_comptime_word,
    x64_image_segments,
    x64_link_with_runtime_image,
    x64_link_with_runtime_image_at,
]

JET_EVAL_IR_INLINE_MIN :: -4611686018427387904
JET_EVAL_IR_INLINE_MAX :: 4611686018427387903
// The page the compiler reads child memory by.
JET_EVAL_NATIVE_PAGE :: 4096
// The end of the user address space: no word at or above it is an address.
JET_EVAL_NATIVE_USER_END :: 140737488355328
// The most bytes one value read may span.
JET_EVAL_NATIVE_READ_MAX :: 4294967296
// Units of fuel per millisecond of a comptime call: the default fuel is a
// five-second budget.
JET_EVAL_NATIVE_FUEL_PER_MS :: 2000
// A native call passes its cell and at most four parameter words.
JET_EVAL_NATIVE_MAX_PARAMS :: 4
JET_EVAL_NATIVE_PREFIX :: "__jet_comptime_"

// A compile's native children over the runtime image `image`: `sealed`
// runs compile-time code (every effect refused), `runtime` fn build and
// fn dev (standard output admitted).
struct JetEvalNativeSession {
    image: Shared<JetEvalNativeImage>
    sealed: Shared<JetEvalNativeChild>
    runtime: Shared<JetEvalNativeChild>
}

// The runtime image file, read when a batch first needs it, so a compile
// without compile-time code never reads it: `bytes` once read, `read` once
// tried (`bytes` stays None when the file can't be read).
struct JetEvalNativeImage {
    file: String
    reader: JetEvalNativeImageReader
    read: Bool
    bytes: [U8]?
}

// The host's read of the runtime image file; `None` when it can't be read.
trait JetEvalNativeImageReader {
    fn read(self, file: String) -[FS.Read]> [U8]?
}

// One child: the entry program bound to the image (`stub`, bound once) and
// its global symbols (`defined`, what a batch's runtime calls resolve to);
// `base` the page the next batch loads at, `generation` counting the
// child's spawns, so a batch knows when it must load again.
struct JetEvalNativeChild {
    child: X64ComptimeChild
    stub: [U8]
    defined: [String:Int]
    base: Int
    generation: Int
    failure: String
}

// One loaded batch: per item its wrapper's address (0: none), result row
// and parameter rows; `types` the batch module's rows (functions dropped),
// in which host values intern their rows, and `layouts` (its one row) the
// program the batch was built from.
struct JetEvalNativeProgram {
    types: Shared<IRModule>
    layouts: Shared<[IRProgram]>
    entries: [Int]
    results: [Int]
    sizes: [Int]
    params: [[Int]]
    code: X64ComptimeCode
    generation: Int
    runtime_execution: Bool
    // Why the batch can't run ("" when it can); `missing` when the
    // toolchain has no runtime image.
    failure: String
    missing: Bool
}

// One call's state: the child (taken from the session for the call) and
// the pages of its memory read since its last command.
struct JetEvalIRState {
    child: X64ComptimeChild
    pages: [[U8]]
    page_rows: [Int:Int]
    budget: Int
    stdout: String
    stderr: String
    max_depth: Int
    runtime_execution: Bool
    // config.eval_entry: ambient effects are refused as `jet eval` refuses them.
    eval_entry: Bool
    span: Span
    failure: JetEvalError?
    internal_problem: JetEvalInternalProblem?
    exit_code: Int?
    // The compiler's answer to `embed_file` / `embed_bytes` / `find`.
    inputs: JetEvalComptimeInputAdapter?
    // The batch's type rows and layouts host values are read and written
    // by, the build host of a fn-build or fn-dev invocation, and the
    // compiler values its code holds (a host word is index + 1).
    host_types: Shared<IRModule>?{None}
    host_layouts: Shared<[IRProgram]>?{None}
    host_adapter: JetEvalBuildHostAdapter?{None}
    host_values: [TComptimeValue]{[TComptimeValue]{}}
}

fn jet_eval_native_session(file: String, reader: ^JetEvalNativeImageReader) -> Shared<JetEvalNativeSession> Never! {
    image :: shared JetEvalNativeImage{file: file, reader: ^reader, read: false, bytes: None}
    shared JetEvalNativeSession{image: image, sealed: jet_eval_native_child_new(), runtime: jet_eval_native_child_new()}
}

// Reads the runtime image file on the first call.
fn jet_eval_native_image_read(image: &JetEvalNativeImage) Never! {
    if image.read -> return
    image.read = true
    image.bytes = image.reader.read(image.file)
}

// A copy of the session's runtime image, read on the first call; None when
// the file can't be read. The image cell serializes the read, so build
// threads sharing the session read the file once.
fn jet_eval_native_image(session: JetEvalNativeSession) -> [U8]? Never! {
    permit := session.image.guard_edit()
    jet_eval_native_image_read(&permit.value)
    if permit.value.bytes == .Val(bytes) -> return Val(bytes.copy())
    None
}

// Whether the session's runtime image can be read (reading it on first use).
fn jet_eval_native_image_present(session: JetEvalNativeSession) -> Bool Never! {
    permit := session.image.guard_edit()
    jet_eval_native_image_read(&permit.value)
    permit.value.bytes != None
}

fn jet_eval_native_child_new() -> Shared<JetEvalNativeChild> Never! {
    shared JetEvalNativeChild{child: X64ComptimeChild{}, stub: [U8]{}, defined: [String:Int]{}, base: 0, generation: 0, failure: ""}
}

// ---------------------------------------------------------------------------
// Children.

// Starts the child of `c` unless one runs: the entry program is bound to
// the session's image once, then each spawn runs it with effects refused
// (unless `stdout`, the runtime child's standard output). False with
// `c.failure`.
fn jet_eval_native_start(c: &JetEvalNativeChild, session: JetEvalNativeSession, stdout: Bool) -> Bool {
    if c.child.pid > 0 -> return true
    if c.stub.len() == 0 {
        compiled := ir_x64_object(ir_x64_compile_module(jet_eval_native_entry_module(), compiler_threads_single()), true)
        if compiled.errors.len() > 0 {
            c.failure = "the comptime entry program doesn't compile: {compiled.errors.join("; ")}"
            return false
        }
        runtime := jet_eval_native_image(session) ?? {
            c.failure = "the runtime image (jet_runtime.image) can't be read"
            return false
        }
        bound := x64_link_with_runtime_image("jet-comptime", ^compiled.bytes, ^runtime)
        if bound.errors.len() > 0 {
            c.failure = "the comptime entry program doesn't bind to the runtime image: {bound.errors.join("; ")}"
            return false
        }
        plan :: x64_image_segments(bound.bytes)
        if plan.failure != "" {
            c.failure = "the bound comptime entry program is not an image: {plan.failure}"
            return false
        }
        high :: os_page_round(plan.high)
        if high > c.base -> c.base = high
        c.defined = x64_comptime_symbols(bound.bytes, "", true)
        c.stub = ^bound.bytes
    }
    x64_comptime_close(&c.child)
    spawned := x64_comptime_spawn(c.stub, stdout, -1)
    if spawned.failure != "" {
        c.failure = spawned.failure
        x64_comptime_close(&spawned)
        return false
    }
    // What the runtime's start wrote is no item's output.
    spawned.stdout = [U8]{}
    spawned.stderr = [U8]{}
    c.child = spawned
    c.generation += 1
    c.failure = ""
    true
}

// The entry program: `__jet_comptime_main` hands the runtime's server its
// table, whose one entry is the SIGSYS handler `__jet_comptime_refusal`.
fn jet_eval_native_entry_module() -> IRModule {
    m := ir_module_new()
    pointer :: ir_pointer_row(&m)
    word :: ir_word_row(&m)
    refusal := ir_function_new("__jet_comptime_refusal", "__jet_comptime_refusal", "__jet_comptime_refusal", "", 0)
    _ := ir_slot(&refusal, word, IRSlotKind.Param, ir_intern_name(&m, "signal"), 0)
    info :: ir_slot(&refusal, pointer, IRSlotKind.Param, ir_intern_name(&m, "info"), 0)
    context :: ir_slot(&refusal, pointer, IRSlotKind.Param, ir_intern_name(&m, "context"), 0)
    refusal_args :: ir_args(&refusal, [Int]{info, context})
    _ := ir_emit(&refusal, IROp.CallRuntime, -1, ir_intern_name(&m, "jet_rt_comptime_refused"), refusal_args, 2, 0)
    _ := ir_emit(&refusal, IROp.Return, -1, -1, -1, -1, 0)
    main := ir_function_new("__jet_comptime_main", "__jet_comptime_main", "__jet_comptime_main", "", 0)
    area :: ir_slot(&main, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&main, IROp.StackAddress, area, 8, 8, -1, 0)
    handler :: ir_slot(&main, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&main, IROp.FunctionAddress, handler, 0, -1, -1, 0)
    _ := ir_emit(&main, IROp.Store, -1, area, 0, handler, 0)
    count :: ir_slot(&main, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&main, IROp.Const, count, 1, -1, -1, 0)
    serve_args :: ir_args(&main, [Int]{area, count})
    _ := ir_emit(&main, IROp.CallRuntime, -1, ir_intern_name(&m, "jet_rt_comptime_serve"), serve_args, 2, 0)
    _ := ir_emit(&main, IROp.Return, -1, -1, -1, -1, 0)
    _ := jet_eval_native_add(&m, ^refusal)
    m.entry = jet_eval_native_add(&m, ^main)
    m
}

// Adds `f` to `m`; its function id.
fn jet_eval_native_add(m: &IRModule, f: ^IRFunction) -> Int Never! {
    owned := ^f
    id :: m.functions.len()
    m.function_rows[owned.key.copy()] = id
    &m.functions.push(^owned)
    id
}

// ---------------------------------------------------------------------------
// Loading.

// Compiles `built` (moved in) for the child of `config` and loads it there.
// A batch that can't load carries why; each run of it reports that.
fn jet_eval_native_load(built: ^JetEvalIRComptime, config: JetEvalConfig) -> JetEvalNativeProgram {
    owned := ^built
    code := ^owned.code
    layouts := ^owned.layouts
    pointer :: ir_pointer_row(&code)
    entries := [Int]{}
    results := [Int]{}
    sizes := [Int]{}
    params := [[Int]]{}
    names := [String]{}
    loop (index, id) in owned.items {
        &entries.push(0)
        if id < 0 || id >= code.functions.len() {
            &results.push(-1)
            &sizes.push(8)
            &params.push([Int]{})
            &names.push("")
            next
        }
        rows := [Int]{}
        loop slot in 0..<code.functions[id].param_count -> &rows.push(code.functions[id].slot_type[slot])
        result :: code.functions[id].result
        size :: if result >= 0 && code.types[result].size > 8 -> code.types[result].size else -> 8
        name :: "{JET_EVAL_NATIVE_PREFIX}item_{index}"
        wrapper := jet_eval_native_wrapper(&code, name, id, rows, result, pointer)
        _ := jet_eval_native_add(&code, ^wrapper)
        &results.push(result)
        &sizes.push(size)
        &params.push(^rows)
        &names.push(name)
    }
    program := JetEvalNativeProgram{types: shared ir_module_new(), layouts: ^layouts, entries: [Int]{}, results: ^results, sizes: ^sizes, params: ^params, code: X64ComptimeCode{segments: [X64Segment]{}, bytes: [U8]{}, high: 0, failure: ""}, generation: 0, runtime_execution: config.runtime_execution, failure: "", missing: false}
    session_cell :: config.native ?? {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = ^entries
        return program
    }
    session :: session_cell.guard_read()
    if !jet_eval_native_image_present(session.value) {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = ^entries
        return program
    }
    cell :: if config.runtime_execution -> session.value.runtime.copy() else -> session.value.sealed.copy()
    permit := cell.guard_edit()
    if !jet_eval_native_start(&permit.value, session.value, config.runtime_execution) {
        program.failure = permit.value.failure.copy()
        program.entries = ^entries
        return program
    }
    jet_eval_native_missing(&code, permit.value.defined)
    // The executable's entry, which the binder requires; it names every
    // wrapper so none is dropped as unreachable.
    none := ir_function_new("{JET_EVAL_NATIVE_PREFIX}none", "{JET_EVAL_NATIVE_PREFIX}none", "{JET_EVAL_NATIVE_PREFIX}none", "", 0)
    loop name in names {
        if name == "" -> next
        target :: code.function_rows.get(name) ?? next
        address :: ir_slot(&none, pointer, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&none, IROp.FunctionAddress, address, target, -1, -1, 0)
    }
    _ := ir_emit(&none, IROp.Return, -1, -1, -1, -1, 0)
    code.entry = jet_eval_native_add(&code, ^none)
    // The rows outlive the code: values are read and written by them.
    functions := compiler_take_rows<IRFunction>(&code.functions)
    program.types = shared code.copy()
    code.functions = ^functions
    compiled := ir_x64_object(ir_x64_compile_module(^code, compiler_threads_single()), true)
    if compiled.errors.len() > 0 {
        program.failure = "the batch doesn't compile to x86-64: {compiled.errors.join("; ")}"
        program.entries = ^entries
        return program
    }
    runtime := jet_eval_native_image(session.value) ?? {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = ^entries
        return program
    }
    bound := x64_link_with_runtime_image_at("jet-comptime", ^compiled.bytes, ^runtime, permit.value.base)
    if bound.errors.len() > 0 {
        program.failure = "the batch doesn't bind to the runtime image: {bound.errors.join("; ")}"
        program.entries = ^entries
        return program
    }
    addresses :: x64_comptime_symbols(bound.bytes, JET_EVAL_NATIVE_PREFIX, false)
    loop (index, name) in names {
        if name == "" -> next
        entries[index] = addresses.get(name) ?? 0
        if entries[index] == 0 {
            program.failure = "the bound batch has no `{name}`"
            program.entries = ^entries
            return program
        }
    }
    program.entries = ^entries
    program.code = x64_comptime_code(bound.bytes, permit.value.base)
    if program.code.failure != "" {
        program.failure = "the bound batch is not an image: {program.code.failure}"
        return program
    }
    permit.value.base = program.code.high
    loaded :: x64_comptime_load(&permit.value.child, program.code)
    if loaded != "" {
        x64_comptime_reap(&permit.value.child, true)
        program.failure = loaded
        return program
    }
    program.generation = permit.value.generation
    program
}

// `__jet_comptime_item_{index}(cell, params...)`: calls item function `id`
// and stores its result in `cell` (an aggregate's bytes, else its word).
fn jet_eval_native_wrapper(code: &IRModule, name: String, id: Int, params: [Int], result: Int, pointer: Int) -> IRFunction {
    w := ir_function_new(name, name, name, "", 0)
    cell :: ir_slot(&w, pointer, IRSlotKind.Param, ir_intern_name(&code, "cell"), 0)
    args := [Int]{}
    loop (index, row) in params {
        slot :: ir_slot(&w, row, IRSlotKind.Param, ir_intern_name(&code, "a{index}"), 0)
        &args.push(slot)
    }
    start :: ir_args(&w, args)
    if result < 0 || code.types[result].kind == .Unit {
        _ := ir_emit(&w, IROp.Call, -1, id, start, args.len(), 0)
    } else {
        value :: ir_slot(&w, result, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&w, IROp.Call, value, id, start, args.len(), 0)
        if code.types[result].kind == .Aggregate {
            _ := ir_emit(&w, IROp.CopyBytes, -1, cell, value, code.types[result].size, 0)
        } else {
            _ := ir_emit(&w, IROp.Store, -1, cell, 0, value, 0)
        }
    }
    _ := ir_emit(&w, IROp.Return, -1, -1, -1, -1, 0)
    w
}

// Each runtime call of `code` to a symbol neither the runtime image
// (`defined`) nor the batch defines calls a stub of its own instead, which
// asks the compiler (HOST_MISSING): such a call is unsupported where it
// runs, as it was before the batch ran, and the rest of the batch binds.
fn jet_eval_native_missing(code: &IRModule, defined: [String:Int]) {
    own := [String:Bool]{}
    loop id in 0..<code.functions.len() {
        own[code.functions[id].symbol.copy()] = true
        own[code.functions[id].name.copy()] = true
    }
    sites := [Int]{}
    loop id in 0..<code.functions.len() {
        loop at in 0..<code.functions[id].op.len() {
            if code.functions[id].op[at] != .CallRuntime -> next
            symbol :: code.names[code.functions[id].a[at]]
            if defined.get(symbol) != None || own.get(symbol) != None -> next
            &sites.push(id)
            &sites.push(at)
        }
    }
    index := 0
    loop index < sites.len() {
        id :: sites[index]
        at :: sites[index + 1]
        index += 2
        symbol :: code.names[code.functions[id].a[at]].copy()
        start :: code.functions[id].b[at]
        rows := [Int]{}
        loop arg in start..<(start + code.functions[id].c[at]) -> &rows.push(code.functions[id].slot_type[code.functions[id].args[arg]])
        dst :: code.functions[id].dst[at]
        result :: if dst >= 0 -> code.functions[id].slot_type[dst] else -> -1
        stub := jet_eval_native_missing_stub(&code, "{JET_EVAL_NATIVE_PREFIX}missing_{index /% 2}", symbol, rows, result)
        target :: jet_eval_native_add(&code, ^stub)
        code.functions[id].op[at] = IROp.Call
        code.functions[id].a[at] = target
    }
}

fn jet_eval_native_missing_stub(code: &IRModule, name: String, symbol: String, params: [Int], result: Int) -> IRFunction {
    f := ir_function_new(name, name, name, "", 0)
    loop (index, row) in params {
        _ := ir_slot(&f, row, IRSlotKind.Param, ir_intern_name(&code, "a{index}"), 0)
    }
    f.result = result
    pointer :: ir_pointer_row(&code)
    word :: ir_word_row(&code)
    area :: ir_slot(&f, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&f, IROp.StackAddress, area, 8, 8, -1, 0)
    text :: ir_slot(&f, ir_string_row(&code), IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&f, IROp.ConstText, text, ir_intern_text(&code, symbol), -1, -1, 0)
    _ := ir_emit(&f, IROp.Store, -1, area, 0, text, 0)
    kind :: ir_slot(&f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&f, IROp.Const, kind, X64_COMPTIME_HOST_MISSING, -1, -1, 0)
    count :: ir_slot(&f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&f, IROp.Const, count, 1, -1, -1, 0)
    answer :: ir_slot(&f, word, IRSlotKind.Temp, -1, 0)
    host_args :: ir_args(&f, [Int]{kind, area, count})
    _ := ir_emit(&f, IROp.CallRuntime, answer, ir_intern_name(&code, "jet_comptime_host"), host_args, 3, 0)
    _ := ir_emit(&f, IROp.Unreachable, -1, -1, -1, -1, 0)
    f
}

// ---------------------------------------------------------------------------
// Running.

// Runs item `item` of `program` on `args` (a fn-build or fn-dev entry's
// context; none for a constant).
fn jet_eval_native_run(program: &JetEvalNativeProgram, item: Int, args: [TComptimeValue], config: JetEvalConfig, span: Span) -> JetEvalIRResult {
    s := JetEvalIRState{
        child: X64ComptimeChild{}, pages: [[U8]]{}, page_rows: [Int:Int]{},
        budget: if program.runtime_execution -> -1 else -> config.fuel /% JET_EVAL_NATIVE_FUEL_PER_MS,
        stdout: "", stderr: "", max_depth: config.max_call_depth, runtime_execution: program.runtime_execution, eval_entry: config.eval_entry, span: span,
        failure: None, internal_problem: None, exit_code: None,
        inputs: if config.comptime_input_adapter == .Val(adapter) -> Val(adapter.clone_input_adapter()) else -> None,
        host_types: Val(program.types.copy()), host_layouts: Val(program.layouts.copy()),
        host_adapter: if config.build_host_adapter == .Val(installed) -> Val(installed.clone_adapter()) else -> None,
    }
    if program.failure != "" {
        if program.missing {
            jet_eval_ir_unsupported(&s, "compile-time code without the runtime image (jet_runtime.image)")
        } else {
            jet_eval_ir_problem(&s, "compile-time code doesn't run natively: {program.failure}")
        }
        return jet_eval_ir_result(s, None)
    }
    if item < 0 || item >= program.entries.len() || program.entries[item] == 0 {
        jet_eval_ir_problem(&s, "item {item} has no native entry")
        return jet_eval_ir_result(s, None)
    }
    session_cell :: config.native ?? {
        jet_eval_ir_unsupported(&s, "compile-time code without the runtime image (jet_runtime.image)")
        return jet_eval_ir_result(s, None)
    }
    session :: session_cell.guard_read()
    cell :: if program.runtime_execution -> session.value.runtime.copy() else -> session.value.sealed.copy()
    permit := cell.guard_edit()
    if permit.value.child.pid <= 0 || permit.value.generation != program.generation {
        if !jet_eval_native_start(&permit.value, session.value, program.runtime_execution) {
            jet_eval_ir_problem(&s, permit.value.failure)
            return jet_eval_ir_result(s, None)
        }
        loaded :: x64_comptime_load(&permit.value.child, program.code)
        if loaded != "" {
            x64_comptime_reap(&permit.value.child, true)
            jet_eval_ir_problem(&s, loaded)
            return jet_eval_ir_result(s, None)
        }
        program.generation = permit.value.generation
    }
    s.child = permit.value.child.copy()
    value :: jet_eval_native_call(&s, program, item, args)
    x64_comptime_settle(&s.child)
    s.stdout = "{s.stdout}{String.from_bytes_lossy(s.child.stdout)}"
    s.stderr = "{s.stderr}{String.from_bytes_lossy(s.child.stderr)}"
    s.child.stdout = [U8]{}
    s.child.stderr = [U8]{}
    s.child.budget = -1
    s.child.exhausted = false
    permit.value.child = s.child.copy()
    // Standard error no runtime stop read back is the evaluated code's own
    // output, an effect a comptime evaluation refuses.
    if !s.runtime_execution && s.stderr != "" && !jet_eval_ir_failed(s) -> jet_eval_ir_effect_refused(&s, "standard error", false)
    jet_eval_ir_result(s, value)
}

fn jet_eval_native_call(s: &JetEvalIRState, program: JetEvalNativeProgram, item: Int, args: [TComptimeValue]) -> TComptimeValue? {
    rows :: program.params[item]
    if args.len() > 0 && args.len() != rows.len() {
        jet_eval_ir_problem(&s, "the entry takes {rows.len()} parameters, given {args.len()}")
        return None
    }
    if rows.len() > JET_EVAL_NATIVE_MAX_PARAMS {
        jet_eval_ir_problem(&s, "the entry takes {rows.len()} parameters; a native call passes at most {JET_EVAL_NATIVE_MAX_PARAMS}")
        return None
    }
    words :: jet_eval_ir_host_arguments(&s, rows, args) ?? return None
    cell :: jet_eval_native_alloc(&s, program.sizes[item], 8) ?? return None
    operands := [Int]{program.entries[item], cell}
    &operands.extend(words)
    s.child.budget = s.budget
    s.child.exhausted = false
    if !jet_eval_native_command(&s, X64_COMPTIME_CALL, operands, [U8]{}) {
        jet_eval_native_ended(&s)
        return None
    }
    if !jet_eval_native_serve(&s) -> return None
    s.child.budget = -1
    row :: program.results[item]
    if row < 0 -> return Val(TComptimeValue.Unit)
    types := program.types.guard_edit()
    layouts :: program.layouts.guard_read()
    ty :: types.value.types[row]
    if ty.kind == .Unit -> return Val(TComptimeValue.Unit)
    word := cell
    if ty.kind != .Aggregate {
        width :: jet_eval_ir_width(ty)
        raw :: jet_eval_ir_read(&s, cell, width) ?? return None
        word = jet_eval_ir_canonical(ty, raw, width)
    }
    value :: jet_eval_ir_data(&types.value, layouts.value[0], &s, word, row) ?? return None
    if jet_eval_ir_failed(s) -> return None
    Val(value)
}

// Answers the child until the call's DONE: true then, false once the call
// failed (its failure recorded).
fn jet_eval_native_serve(s: &JetEvalIRState) -> Bool {
    loop {
        reply :: x64_comptime_receive(&s.child) ?? {
            jet_eval_native_ended(&s)
            return false
        }
        jet_eval_native_forget(&s)
        kind :: x64_comptime_word(reply, 0)
        if kind == X64_COMPTIME_DONE -> return true
        if kind == X64_COMPTIME_HOST {
            answer :: jet_eval_native_host(&s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16), x64_comptime_word(reply, 24), x64_comptime_word(reply, 32))
            if answer == .Val(word) && !jet_eval_ir_failed(s) {
                if jet_eval_native_command(&s, X64_COMPTIME_RETURN, [Int]{word}, [U8]{}) -> next
                jet_eval_native_ended(&s)
                return false
            }
            // The code can't go on without its answer: the child ends with it.
            x64_comptime_reap(&s.child, true)
            if !jet_eval_ir_failed(s) -> jet_eval_ir_problem(&s, "a host route of compile-time code has no answer")
            return false
        }
        if kind == X64_COMPTIME_STOP {
            jet_eval_native_stop(&s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16), x64_comptime_word(reply, 24), x64_comptime_word(reply, 32), x64_comptime_word(reply, 40))
            if !jet_eval_ir_failed(s) -> jet_eval_ir_problem(&s, "a runtime stop of compile-time code has no report")
            return false
        }
        if kind == X64_COMPTIME_REFUSED {
            x64_comptime_reap(&s.child, false)
            jet_eval_native_refused(&s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16))
            return false
        }
        x64_comptime_reap(&s.child, true)
        jet_eval_ir_problem(&s, "the comptime child sent frame {kind}")
        return false
    }
}

// The call's child ended before its DONE: out of fuel, out of stack, a
// runtime exit (a stop's report on standard error, or a program's exit).
fn jet_eval_native_ended(s: &JetEvalIRState) {
    if jet_eval_ir_failed(s) -> return
    if s.child.exhausted {
        _ := jet_eval_ir_out_of_fuel(&s)
        return
    }
    failure :: s.child.failure.copy()
    if failure != "" {
        jet_eval_ir_problem(&s, failure)
        return
    }
    signal :: s.child.status.bit_and(127)
    if signal == 11 {
        depth :: s.max_depth
        jet_eval_ir_source_fail(&s, "compile-time call depth exceeds {depth}")
        return
    }
    if signal != 0 {
        jet_eval_ir_problem(&s, "the comptime child ended on signal {signal}")
        return
    }
    code :: (s.child.status >> 8).bit_and(255)
    if s.runtime_execution {
        s.exit_code = Val(code)
        return
    }
    report :: String.from_bytes_lossy(s.child.stderr).trim()
    s.child.stderr = [U8]{}
    jet_eval_ir_source_fail(&s, if report == "" -> "the runtime exited with status {code}" else -> report)
}

// A runtime stop (JetRuntime Trap.jet) of kind `kind` and its words; the
// child keeps serving above the stopped frames.
fn jet_eval_native_stop(s: &JetEvalIRState, kind: Int, a: Int, b: Int, c: Int, d: Int) {
    if kind == X64_COMPTIME_STOP_MESSAGE {
        message :: jet_eval_ir_bytes(&s, a, b) ?? return
        jet_eval_ir_source_fail(&s, String.from_bytes_lossy(message))
        return
    }
    if kind == X64_COMPTIME_STOP_SHIFT {
        count :: jet_eval_ir_wrap(a, 64, b == 0)
        jet_eval_ir_source_fail(&s, "shift count {count} is outside 0..<{c}")
        return
    }
    if kind == X64_COMPTIME_STOP_LIST_BOUNDS {
        index :: jet_eval_ir_int_value(&s, b) ?? return
        jet_eval_ir_source_fail(&s, "the list has {a} items, so position {index} doesn't exist")
        return
    }
    // A `panic`/`assert`/`require` stop (Trap.jet jet_rt_require_stop), which
    // a comptime item's unhandled failure raises too (JetIR
    // ir_comptime_item_failure): an equality stop (kind 1) carries its two
    // sides, every other its message. In a comptime evaluation it is a
    // user-authored compile error (S26).
    if kind == X64_COMPTIME_STOP_REQUIRE {
        message := ""
        if a == 1 {
            right :: jet_eval_ir_text(&s, d) ?? return
            left :: jet_eval_ir_text(&s, c) ?? return
            message = "expected: {right}, got: {left}"
        } else if b != 0 {
            message = jet_eval_ir_text(&s, b) ?? return
        }
        if s.runtime_execution {
            jet_eval_ir_source_fail(&s, message)
            return
        }
        if s.failure == None -> s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3010", Val(s.span), "`{message}`", "compile-time code stopped the build: a `panic`, a failed check or an unhandled failure in a `comptime` value is a compile error", "handle the failure inside the `comptime` block (`??` or an `.Ok`/`.Err` match), or fix the value the check rejects")})
        return
    }
    jet_eval_ir_problem(&s, "the comptime child stopped with kind {kind} ({a}, {b}, {c}, {d})")
}

// System call `number` (first argument `first`) the filter refused. Runtime
// execution has no host for it (unsupported). A comptime evaluation refuses
// it as the effect it is: ambient time and randomness are E3403, any other
// effect is observable outside the program, so folding it would bake one
// build-time result into every run (E3410).
fn jet_eval_native_refused(s: &JetEvalIRState, number: Int, first: Int) {
    if s.runtime_execution {
        jet_eval_ir_unsupported(&s, "system call {number}")
        return
    }
    // The runtime's process abort (JetRuntime Alloc.jet alloc_abort) resets
    // SIGABRT's handler: the served code hit a defect, not a host effect.
    if number == 13 && first == 6 {
        report :: String.from_bytes_lossy(s.child.stderr).trim()
        s.child.stderr = [U8]{}
        jet_eval_ir_problem(&s, if report == "" -> "the comptime child aborted" else -> "the comptime child aborted: {report}")
        return
    }
    what :: if number == {
        1 | 20 -> if first == 1 -> "standard output" else -> "system call {number}"
        257 | 2 -> "opening a file"
        0 -> "reading a file"
        3 -> "closing a file"
        13 -> "a signal handler"
        291 -> "an event poller"
        228 -> "the clock"
        318 -> "OS randomness"
        else -> "system call {number}"
    }
    jet_eval_ir_effect_refused(&s, what, number == 228 || number == 318)
}

// A comptime evaluation's refusal of host effect `what` (`nondeterministic`:
// ambient time or randomness); `jet eval` refuses every one as its evaluator
// mode does.
fn jet_eval_ir_effect_refused(s: &JetEvalIRState, what: String, nondeterministic: Bool) Never! {
    if s.failure != None -> return
    if s.eval_entry {
        s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Effect, s.span, what, "this effect is not permitted in the current evaluator mode", "run the effect in an authorized runtime ambient context"))
        return
    }
    if nondeterministic {
        entry :: diagnostic_registry_row("E3403") ?? panic("E3403 has no registry row")
        refusal :: diagnostic_from_registry("E3403", Val(s.span), entry.what.replace("{{what}}", what), entry.why, entry.fix)
        s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Effect, diagnostic: diagnostic_with_rights(refusal, "pure", [String]{what}, [String]{}, None)})
        return
    }
    s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Effect, diagnostic: diagnostic_from_registry("E3410", Val(s.span), "`{what}` is a Tier-2 comptime effect — it requires a `#Impure` gate", "effectful Core APIs are not allowed in pure comptime evaluation", "wrap the comptime binding in `#Impure(\"reason\") {{ … }}` and pass `--gate impure=allow` to the build, or keep the call at runtime")})
}

fn jet_eval_ir_result(s: JetEvalIRState, value: TComptimeValue?) -> JetEvalIRResult Never! {
    complete :: value != None && !jet_eval_ir_failed(s)
    JetEvalIRResult{value: if complete -> value else -> None, complete: complete, error: s.failure, internal_problem: s.internal_problem, stdout: s.stdout, stderr: s.stderr, exit_code: s.exit_code, steps: 0}
}

// ---------------------------------------------------------------------------
// Host routes.

// HOST(kind, operands, count, result): the route's `count` words at
// `operands` are its answer row's key, then its operands (JetIR
// ir_host_route); the answer is the RETURN word, an aggregate or Float one
// written to `result`.
fn jet_eval_native_host(s: &JetEvalIRState, kind: Int, operands: Int, count: Int, result: Int) -> Int? {
    if count < 1 || count > 4096 -> return jet_eval_ir_primitive_shape(&s, "jet_comptime_host")
    bytes :: jet_eval_ir_bytes(&s, operands, 8 * count) ?? return None
    words := [Int]{}
    loop index in 0..<count -> &words.push(x64_comptime_word(bytes, 8 * index))
    if kind == X64_COMPTIME_HOST_MISSING {
        symbol :: jet_eval_ir_text(&s, words[0]) ?? return None
        jet_eval_ir_unsupported(&s, "IR runtime route `{symbol}`")
        return None
    }
    types_cell :: jet_eval_ir_host_types(&s) ?? return None
    row :: jet_eval_native_answer_row(&s, types_cell, words[0]) ?? return None
    args := [Int]{}
    loop index in 1..<count -> &args.push(words[index])
    answer :: if kind == {
        X64_COMPTIME_HOST_METHOD -> jet_eval_ir_host_method_route(&s, args, row, result)
        X64_COMPTIME_HOST_FIELD -> jet_eval_ir_host_field_route(&s, args, row, result)
        X64_COMPTIME_HOST_INPUT -> jet_eval_ir_comptime_input_route(&s, args, row)
        else -> jet_eval_ir_primitive_shape(&s, "jet_comptime_host")
    } ?? return None
    reads :: types_cell.guard_read()
    ty :: reads.value.types[row]
    if ty.kind == .Float || ty.kind == .Float32 {
        if result == 0 {
            jet_eval_ir_problem(&s, "a Float host answer has no result cell")
            return None
        }
        if !jet_eval_ir_write(&s, result, jet_eval_ir_width(ty), answer) -> return None
        return Val(result)
    }
    if ty.kind == .Aggregate && result != 0 && answer != result {
        moved :: jet_eval_ir_bytes(&s, answer, ty.size) ?? return None
        if !jet_eval_native_put(&s, result, moved) -> return None
        return Val(result)
    }
    Val(answer)
}

// The type row whose intern key is the String at `key`.
fn jet_eval_native_answer_row(s: &JetEvalIRState, types_cell: Shared<IRModule>, key: Int) -> Int? {
    reads :: types_cell.guard_read()
    jet_eval_ir_host_row(reads.value, &s, key)
}

// A host route called with operands it doesn't take: a compiler defect.
fn jet_eval_ir_primitive_shape(s: &JetEvalIRState, name: String) -> Int? Never! {
    jet_eval_ir_problem(&s, "host primitive {name} called with the wrong operands")
    None
}

// jet_comptime_input(builtin, literal path): the value the compiler's
// comptime input host reads and records, as the IR value of type row
// `dst_row`.
fn jet_eval_ir_comptime_input_route(s: &JetEvalIRState, args: [Int], dst_row: Int) -> Int? {
    if args.len() != 2 -> return jet_eval_ir_primitive_shape(&s, "jet_comptime_input")
    if s.runtime_execution {
        jet_eval_ir_problem(&s, "a comptime input reached runtime evaluation")
        return None
    }
    builtin :: jet_eval_ir_text(&s, args[0]) ?? return None
    path :: jet_eval_ir_text(&s, args[1]) ?? return None
    adapter :: if s.inputs == {
        .Val(installed) -> installed.clone_input_adapter()
        .None -> {
            if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Effect, s.span, "`{builtin}` can't read files here", "this compile has no comptime input host, so it can't read `{path}`", "build the program with `jet build` or `jet run`, which read comptime inputs"))
            return None
        }
    }
    value :: if adapter.comptime_input(builtin, path, s.span) == {
        .Ok(read) -> read
        .Err(error) -> {
            if s.failure == None -> s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: error.diagnostic})
            return None
        }
    }
    jet_eval_ir_store_data(&s, value, dst_row)
}

// The IR word of compile-time data of type row `row`, for the shapes a
// comptime input produces: a String, the bytes of a [U8], a [String]. Texts
// and buffers are the runtime's own, so the program owns and drops them as
// any other.
fn jet_eval_ir_store_data(s: &JetEvalIRState, value: TComptimeValue, row: Int) -> Int? {
    if value == {
        .String(text) -> return jet_eval_ir_store_text(&s, text)
        .Bytes(bytes) -> {
            data := 0
            if bytes.len() > 0 {
                data = jet_eval_native_alloc(&s, bytes.len(), 1) ?? return None
                if !jet_eval_native_put(&s, data, bytes) -> return None
            }
            return jet_eval_ir_list_header(&s, data, bytes.len())
        }
        .List(values) -> {
            words := [U8]{}
            loop item in values {
                if item == .String(text) {
                    word :: jet_eval_ir_store_text(&s, text) ?? return None
                    x64_comptime_put_word(&words, word)
                } else {
                    jet_eval_ir_unsupported(&s, "a comptime input list of {item}")
                    return None
                }
            }
            data := 0
            if values.len() > 0 {
                data = jet_eval_native_alloc(&s, words.len(), 8) ?? return None
                if !jet_eval_native_put(&s, data, words) -> return None
            }
            return jet_eval_ir_list_header(&s, data, values.len())
        }
        else -> {}
    }
    types_cell :: jet_eval_ir_host_types(&s) ?? return None
    reads :: types_cell.guard_read()
    jet_eval_ir_unsupported(&s, "writing comptime data {value} as an IR value of {reads.value.types[row].ty}")
    None
}

// A List header {len, cap, data} in its own storage.
fn jet_eval_ir_list_header(s: &JetEvalIRState, data: Int, length: Int) -> Int? {
    header :: jet_eval_native_alloc(&s, 24, 8) ?? return None
    words := [U8]{}
    x64_comptime_put_word(&words, length)
    x64_comptime_put_word(&words, length)
    x64_comptime_put_word(&words, data)
    if !jet_eval_native_put(&s, header, words) -> return None
    Val(header)
}

// A runtime String of `text`'s bytes.
fn jet_eval_ir_store_text(s: &JetEvalIRState, text: String) -> Int? {
    bytes :: text.bytes()
    jet_eval_native_ask(&s, X64_COMPTIME_TEXT, [Int]{bytes.len()}, bytes)
}

// An Int word: inline, or a runtime node built from its decimal text.
fn jet_eval_ir_host_int(s: &JetEvalIRState, number: Int) -> Int? {
    if jet_eval_ir_inline(number) -> return Val(number)
    decimal :: "{number}".bytes()
    jet_eval_native_ask(&s, X64_COMPTIME_INT, [Int]{decimal.len()}, decimal)
}

// A runtime box of `bytes` bytes (the builder's ir_box_alloc).
fn jet_eval_ir_host_alloc(s: &JetEvalIRState, bytes: Int) -> Int? {
    jet_eval_native_alloc(&s, ir_align8(bytes), 8)
}

// ---------------------------------------------------------------------------
// The child's memory.

// Sends a command; the pages read before it may change, so they go.
fn jet_eval_native_command(s: &JetEvalIRState, kind: Int, operands: [Int], payload: [U8]) -> Bool {
    jet_eval_native_forget(&s)
    x64_comptime_send(&s.child, x64_comptime_frame(kind, operands), payload)
}

fn jet_eval_native_forget(s: &JetEvalIRState) {
    if s.pages.len() == 0 -> return
    s.pages = [[U8]]{}
    s.page_rows = [Int:Int]{}
}

// Command `kind`'s DONE word.
fn jet_eval_native_ask(s: &JetEvalIRState, kind: Int, operands: [Int], payload: [U8]) -> Int? {
    if !jet_eval_native_command(&s, kind, operands, payload) {
        jet_eval_native_lost(&s, "command {kind}")
        return None
    }
    reply :: x64_comptime_receive(&s.child) ?? {
        jet_eval_native_lost(&s, "command {kind}")
        return None
    }
    if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
        x64_comptime_reap(&s.child, true)
        jet_eval_ir_problem(&s, "the comptime child answered command {kind} with frame {x64_comptime_word(reply, 0)}")
        return None
    }
    Val(x64_comptime_word(reply, 8))
}

// The child ended while the compiler worked on its memory.
fn jet_eval_native_lost(s: &JetEvalIRState, during: String) {
    if s.child.exhausted {
        _ := jet_eval_ir_out_of_fuel(&s)
        return
    }
    report :: String.from_bytes_lossy(s.child.stderr).trim()
    detail :: if report == "" -> "" else -> ": {report}"
    status :: s.child.status
    jet_eval_ir_problem(&s, "the comptime child ended during {during} (status {status}){detail}")
}

// `size` bytes of the child's runtime heap, aligned to `align`.
fn jet_eval_native_alloc(s: &JetEvalIRState, size: Int, align: Int) -> Int? {
    jet_eval_native_ask(&s, X64_COMPTIME_ALLOC, [Int]{if size < 8 -> 8 else -> size, align}, [U8]{})
}

// Whether `count` bytes from `pointer` may be child memory.
fn jet_eval_native_address(s: &JetEvalIRState, pointer: Int, count: Int) -> Bool Never! {
    if pointer > 0 && count <= JET_EVAL_NATIVE_READ_MAX && pointer + count <= JET_EVAL_NATIVE_USER_END -> return true
    jet_eval_ir_problem(&s, if pointer == 0 -> "memory access through a null pointer" else -> "memory access through a word that is not an address")
    false
}

// The row of the page at `page` in the read pages, read now if it isn't.
fn jet_eval_native_page(s: &JetEvalIRState, page: Int) -> Int? {
    found :: s.page_rows.get(page) ?? -1
    if found >= 0 -> return Val(found)
    if !x64_comptime_send(&s.child, x64_comptime_frame(X64_COMPTIME_READ, [Int]{page, JET_EVAL_NATIVE_PAGE}), [U8]{}) {
        jet_eval_native_unreadable(&s, page)
        return None
    }
    bytes := x64_comptime_receive_bytes(&s.child, JET_EVAL_NATIVE_PAGE) ?? {
        jet_eval_native_unreadable(&s, page)
        return None
    }
    row :: s.pages.len()
    &s.pages.push(^bytes)
    s.page_rows[page] = row
    Val(row)
}

// A READ the child died on: the page is not its memory.
fn jet_eval_native_unreadable(s: &JetEvalIRState, page: Int) {
    if s.child.exhausted {
        _ := jet_eval_ir_out_of_fuel(&s)
        return
    }
    jet_eval_ir_problem(&s, "memory access through a word that is not an address (page {page})")
}

// The bytes at `pointer`.
fn jet_eval_ir_bytes(s: &JetEvalIRState, pointer: Int, count: Int) -> [U8]? {
    bytes := [U8]{}
    if count <= 0 -> return Val(bytes)
    if !jet_eval_native_address(&s, pointer, count) -> return None
    at := pointer
    end :: pointer + count
    loop at < end {
        page :: at - at % JET_EVAL_NATIVE_PAGE
        row :: jet_eval_native_page(&s, page) ?? return None
        stop :: if end < page + JET_EVAL_NATIVE_PAGE -> end else -> page + JET_EVAL_NATIVE_PAGE
        &bytes.extend(s.pages[row][(at - page)..<(stop - page)])
        at = stop
    }
    Val(bytes)
}

// The unsigned little-endian value of `width` bytes at `pointer`.
fn jet_eval_ir_read(s: &JetEvalIRState, pointer: Int, width: Int) -> Int? {
    if width == 0 -> return Val(0)
    bytes :: jet_eval_ir_bytes(&s, pointer, width) ?? return None
    value := 0
    index := width - 1
    loop index >= 0 {
        value = (value << 8).bit_or(Int.from_u8(bytes[index]))
        index -= 1
    }
    Val(value)
}

// The signed 64-bit word at `pointer`.
fn jet_eval_ir_read_word(s: &JetEvalIRState, pointer: Int) -> Int? {
    raw :: jet_eval_ir_read(&s, pointer, 8) ?? return None
    Val(jet_eval_ir_wrap(raw, 64, true))
}

// Writes `bytes` at `pointer` in the child.
fn jet_eval_native_put(s: &JetEvalIRState, pointer: Int, bytes: [U8]) -> Bool {
    if bytes.len() == 0 -> return true
    if !jet_eval_native_address(&s, pointer, bytes.len()) -> return false
    if jet_eval_native_command(&s, X64_COMPTIME_WRITE, [Int]{pointer, bytes.len()}, bytes) -> return true
    jet_eval_native_lost(&s, "a write of its memory")
    false
}

fn jet_eval_ir_write(s: &JetEvalIRState, pointer: Int, width: Int, value: Int) -> Bool {
    bytes := [U8]{}
    bits := if value < 0 -> value + 18446744073709551616 else -> value
    loop _ in 0..<width {
        &bytes.push(U8{bits.bit_and(255)})
        bits = bits >> 8
    }
    jet_eval_native_put(&s, pointer, bytes)
}

// The text of the String whose header is at `header`.
fn jet_eval_ir_text(s: &JetEvalIRState, header: Int) -> String? {
    data :: jet_eval_ir_read_word(&s, header) ?? return None
    length :: jet_eval_ir_read_word(&s, header + 8) ?? return None
    bytes :: jet_eval_ir_bytes(&s, data, length) ?? return None
    Val(String.from_bytes_lossy(bytes))
}

// ---------------------------------------------------------------------------
// Failures.

fn jet_eval_ir_failed(s: JetEvalIRState) -> Bool Never! { s.failure != None || s.internal_problem != None || s.exit_code != None }

fn jet_eval_ir_problem(s: &JetEvalIRState, message: String) Never! {
    if s.internal_problem == None -> s.internal_problem = Val(JetEvalInternalProblem{span: Val(s.span), message: "IR evaluation: {message}"})
}

fn jet_eval_ir_source_fail(s: &JetEvalIRState, what: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_source_error(s.runtime_execution, s.span, what))
}

fn jet_eval_ir_unsupported(s: &JetEvalIRState, operation: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Unsupported, s.span, "compile-time evaluation does not implement `{operation}`", "this operation has no compiler-time evaluator yet", "do not treat the incomplete evaluation as successful"))
}

fn jet_eval_ir_out_of_fuel(s: &JetEvalIRState) -> Int? Never! {
    if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Fuel, s.span, "compile-time evaluation exhausted its fuel", "compile-time evaluation is bounded to keep compilation finite", "increase the evaluator fuel or simplify the evaluated program"))
    None
}

// ---------------------------------------------------------------------------
// Words.

fn jet_eval_ir_pow2(bits: Int) -> Int Never! { 1 << bits }

// `value` reduced to the fixed-width integer of `bits` (two's complement),
// sign-extended when `signed`.
fn jet_eval_ir_wrap(value: Int, bits: Int, signed: Bool) -> Int Never! {
    modulus :: jet_eval_ir_pow2(bits)
    low :: value.bit_and(modulus - 1)
    if signed && low >= modulus /% 2 -> return low - modulus
    low
}

fn jet_eval_ir_in_range(value: Int, bits: Int, signed: Bool) -> Bool Never! {
    if signed {
        half :: jet_eval_ir_pow2(bits - 1)
        return value >= 0 - half && value < half
    }
    value >= 0 && value < jet_eval_ir_pow2(bits)
}

fn jet_eval_ir_inline(word: Int) -> Bool Never! { word >= JET_EVAL_IR_INLINE_MIN && word <= JET_EVAL_IR_INLINE_MAX }

// The exact integer an Int word holds: inline, or its runtime node's u32
// base-1e9 limbs (Int.jet: negative@16, limbs@24, len@32).
fn jet_eval_ir_int_value(s: &JetEvalIRState, word: Int) -> Int? {
    if jet_eval_ir_inline(word) -> return Val(word)
    node :: word.bit_and(JET_EVAL_IR_INLINE_MAX)
    negative :: jet_eval_ir_read(&s, node + 16, 8) ?? return None
    limbs :: jet_eval_ir_read(&s, node + 24, 8) ?? return None
    length :: jet_eval_ir_read(&s, node + 32, 8) ?? return None
    digits :: jet_eval_ir_bytes(&s, limbs, 4 * length) ?? return None
    value := 0
    at := length - 1
    loop at >= 0 {
        limb :: Int.from_u8(digits[4 * at]) + (Int.from_u8(digits[4 * at + 1]) << 8) + (Int.from_u8(digits[4 * at + 2]) << 16) + (Int.from_u8(digits[4 * at + 3]) << 24)
        value = value * 1000000000 + limb
        at -= 1
    }
    Val(if negative != 0 -> 0 - value else -> value)
}

fn jet_eval_ir_float(word: Int) -> Float Never! { math.from_bits(word) }

// The Float of binary32 `bits` (exact: every binary32 is a binary64).
fn jet_eval_ir_float32(bits: Int) -> Float Never! {
    sign :: bits.bit_and(2147483648) != 0
    exponent :: (bits >> 23).bit_and(255)
    fraction :: bits.bit_and(8388607)
    magnitude := math.from_bits(0)
    if exponent == 255 {
        if fraction != 0 -> return math.from_bits(9221120237041090560)
        magnitude = math.from_bits(9218868437227405312)
    } else if exponent == 0 {
        // Subnormal: fraction * 2^-149.
        magnitude = Float.from_int(fraction) * math.from_bits(3936146074321813504)
    } else {
        wide :: (exponent - 127 + 1023) << 52
        magnitude = math.from_bits(wide.bit_or(fraction << 29))
    }
    if sign -> return -magnitude
    magnitude
}

// Bytes a value of `ty` occupies in memory (IR Load/Store).
fn jet_eval_ir_width(ty: IRType) -> Int Never! {
    if ty.kind == {
        .Unit -> 0
        .Bool -> 1
        .Float32 -> 4
        .Word -> if ty.size == 1 || ty.size == 2 || ty.size == 4 -> ty.size else -> 8
        else -> 8
    }
}

// The canonical word of the unsigned `raw` loaded as `width` bytes of `ty`.
fn jet_eval_ir_canonical(ty: IRType, raw: Int, width: Int) -> Int Never! {
    signed :: ty.kind == .Int || ty.kind == .Float || (ty.kind == .Word && ty.signed)
    if !signed || width == 0 -> return raw
    jet_eval_ir_wrap(raw, 8 * width, true)
}
