// Compile-time code runs natively. Each comptime batch (and each fn-build,
// fn-dev or `jet eval` entry) is compiled to x86-64 at O0, bound in memory
// to the runtime image `jet build` links (JetBackend MemoryLink.jet), and
// loaded into a long-lived child of the compiler that runs that image's own
// runtime (owner ruling A3). The child serves the compiler over two pipes
// (JetBackend Image/SessionHost.jet, JetRuntime ComptimeServe.jet):
// - the compiler CALLs an item's wrapper, which stores the result in a
//   cell the compiler then READs back as compiler data (Values.jet);
// - host routes (compiler values, inputs: JetIR ir_host_route)
//   come back as HOST requests, which the compiler answers by writing
//   runtime values into the child (Host.jet) before it RETURNs;
// - runtime stops come back as STOPs carrying their texts, and a seccomp
//   filter turns every host effect into a REFUSED report.
// Evaluation limits stay: fuel is a count of steps per call (each loop
// iteration and each recursive body's entry spends one, inline in the
// batch's code), call depth is the child's stack.
//
// One session holds two children: the comptime child, whose effects are
// refused, and the runtime child of fn build, fn dev and `jet eval`, which
// may write its standard output. Each child is spawned on first use and
// again after it ended; a batch whose child was replaced is loaded again at
// the same addresses (each batch has its own, above the last one).
use {
    math: core.math
    jet_foundation.[BuildDebugEvent, CompilerThreads, NameTable, Span, TComptimeValue, build_debug_ask, build_debug_on, build_debug_tell, build_debug_tracer, compiler_take_rows, compiler_threads_single, diagnostic_from_registry, diagnostic_registry_row_of, diagnostic_stop_parse, diagnostic_with_rights, name_find, name_index, name_intern, name_table_sized]
    jet_ir.[IRFunction, IRMember, IRModule, IROp, IRProgram, IRSlotKind, IRType, IRX64Program, IR_X64_COMPTIME_STEPS_SYMBOL, ir_align8, ir_args, ir_emit, ir_function_bind, ir_function_new, ir_intern_name, ir_intern_text, ir_keyed_function, ir_module_new, ir_opt_inline_marked_module, ir_opt_report, ir_pointer_row, ir_row_ty, ir_slot, ir_string_row, ir_word_row, ir_x64_compile_module, ir_x64_debug_program, ir_x64_object, ir_x64_program]
    jet_backend.[
        X64BindResult,
        X64ComptimeChild,
        X64ComptimeCode,
        X64ComptimeFunction,
        X64Executable,
        X64ImageFile,
        X64Segment,
        X64_COMPTIME_ALLOC,
        X64_COMPTIME_CALL,
        X64_COMPTIME_DONE,
        X64_COMPTIME_HOST,
        X64_COMPTIME_HOST_CONSTANT,
        X64_COMPTIME_HOST_FIELD,
        X64_COMPTIME_HOST_INPUT,
        X64_COMPTIME_HOST_LITERAL,
        X64_COMPTIME_HOST_METHOD,
        X64_COMPTIME_HOST_MISSING,
        X64_COMPTIME_HOST_TRACE,
        X64_COMPTIME_INT,
        X64_COMPTIME_REFUSED,
        X64_COMPTIME_REFUSED_ENVIRONMENT,
        X64_COMPTIME_REFUSED_PROCESS,
        X64_COMPTIME_RETURN,
        X64_COMPTIME_SHM_SIZE,
        X64_COMPTIME_STOP,
        X64_COMPTIME_STOP_LIST_BOUNDS,
        X64_COMPTIME_STOP_MESSAGE,
        X64_COMPTIME_STOP_REQUIRE,
        X64_COMPTIME_STOP_SHIFT,
        X64_COMPTIME_STOP_STEPS,
        X64_COMPTIME_STOP_TODO,
        X64_COMPTIME_TEXT,
        X64_COMPTIME_WRITE,
        os_page_round,
        x64_bind_functions_at,
        x64_bind_functions_debug_at,
        x64_bind_runtime_image,
        x64_comptime_admit,
        x64_comptime_close,
        x64_comptime_code,
        x64_comptime_facts,
        x64_comptime_frame,
        x64_comptime_function_at,
        x64_comptime_functions,
        x64_comptime_load,
        x64_comptime_put_word,
        x64_comptime_read_memory,
        x64_comptime_reap,
        x64_comptime_receive,
        x64_comptime_send,
        x64_comptime_settle,
        x64_comptime_shm_text,
        x64_comptime_shm_write,
        x64_comptime_spawn,
        x64_comptime_symbol_address,
        x64_comptime_symbols,
        x64_comptime_word,
        x64_executable_header,
        x64_executable_image_head,
        x64_executable_segments,
        x64_executable_whole,
        x64_runtime_image_defines,
        x64_runtime_image_export,
    ]
}

JET_EVAL_IR_INLINE_MIN: -4611686018427387904

JET_EVAL_IR_INLINE_MAX: 4611686018427387903

// The page the compiler reads child memory by.
JET_EVAL_NATIVE_PAGE: 4096

// The end of the user address space: no word at or above it is an address.
JET_EVAL_NATIVE_USER_END: 140737488355328

// The most bytes one value read may span.
JET_EVAL_NATIVE_READ_MAX: 4294967296

// A native call passes its cell and at most four parameter words.
JET_EVAL_NATIVE_MAX_PARAMS: 4

JET_EVAL_NATIVE_PREFIX: "__jet_comptime_"

// A compile's native children over the runtime image `image`: `sealed`
// runs compile-time code (every effect refused), `runtime` fn build, fn dev
// and `jet eval` (standard output admitted).
JetEvalNativeSession: struct {
    image: Shared<JetEvalNativeImage>,
    sealed: Shared<JetEvalNativeChild>,
    runtime: Shared<JetEvalNativeChild>,
}

// The runtime image file, read when a batch first needs it, so a compile
// without compile-time code never reads it: `bytes` holds it once read
// (nothing when the file can't be read), `read` once tried. It is read as
// the host reads it for a bind (JetBackend Image/Loader.jet X64ImageFile):
// lent from the jet that carries it, or without its loaded segments (its
// bytes [gap_at, gap_at + gap)), which no bind reads and the loader maps
// from the file `file`, where it lies from offset `at`, while that file
// has the identity `stamp`. A bind takes it out and puts it back
// (jet_eval_native_bind).
JetEvalNativeImage: struct {
    file: String,
    reader: JetEvalNativeImageReader,
    read: Bool,
    bytes: [[U8]],
    at: Int,
    stamp: [Int],
    gap_at: Int,
    gap: Int,
    defined_names: NameTable{name_table_sized(128)},
    defined_hits: [Int]{[Int]{}},
}

// The host's read of the runtime image file; `None` when it can't be read.
// A read may wait for an image still being linked (JetCLI Request.jet
// JetCLICoreImageReader). `loaded` tells the host child `pid` runs code no
// file holds, its entry program's or a batch's, whose functions `listing`
// names, one a line: its start and end address, its declaration's line
// and file, and its name, tab-separated, for a sampler outside the
// compiler to name that code by.
JetEvalNativeImageReader: trait {
    read: fn(self, file: String) -[FS.Read, Env, FFI.Asm, Time.Wait]> X64ImageFile?,
    loaded: fn(self, pid: Int, listing: String) -[FS, Env]> Never!,
}

// One child: the entry program bound to the image (`stub`, bound once,
// its image part mapped from the image's file when it spawns); `base` the
// page the next batch loads at, `generation` counting the child's spawns,
// so a batch knows when it must load again.
JetEvalNativeChild: struct {
    child: X64ComptimeChild,
    stub: X64Executable,
    base: Int,
    generation: Int,
    failure: String,
}

// One loaded batch: per item its wrapper's address (0: none), result row
// and parameter rows; `types` the batch module's rows (functions dropped),
// in which host values intern their rows, and `layouts` (its one row) the
// program the batch was built from.
JetEvalNativeProgram: struct {
    types: Shared<IRModule>,
    layouts: Shared<[IRProgram]>,
    entries: [Int],
    results: [Int],
    sizes: [Int],
    params: [[Int]],
    code: X64ComptimeCode,
    generation: Int,
    runtime_execution: Bool,
    // Why the batch can't run ("" when it can); `missing` when the
    // toolchain has no runtime image.
    failure: String,
    missing: Bool,
    // The bound batch's functions by start address, each with its symbol's
    // id (x64_comptime_functions), and each id's function name: a stack
    // overflow the child reports by address only, as its location table has
    // no batch code, is named from them (jet_eval_native_overflow_name).
    functions: [X64ComptimeFunction]{[X64ComptimeFunction]{}},
    function_names: [String]{[String]{}},
    // The listing of those functions the host is told of once the batch
    // loads (JetEvalNativeImageReader.loaded).
    listing: String{""},
    // Under `jet debug --build` (JetFoundation BuildDebug.jet): the batch's
    // debug facts (x64_comptime_facts) and the address of the child's step
    // word, which the console reads at a stop; empty and 0 otherwise.
    facts: [U8]{[U8]{}},
    steps: Int{0},
}

// One call's state: the child (taken from the session for the call) and
// the pages of its memory read since its last command.
JetEvalIRState: struct {
    child: X64ComptimeChild,
    pages: [[U8]],
    page_rows: [Int:Int],
    last_page: Int{-1},
    last_page_row: Int{-1},
    struct_row_index: [Int:Int]{[Int:Int]{}},
    struct_members_cache: [[IRMember]]{[[IRMember]]{}},
    struct_name_cache: [String]{[String]{}},
    // config.fuel: the call's step limit, the CALL's last operand, named when
    // the call runs out of it (jet_eval_ir_out_of_fuel); negative for none.
    step_limit: Int,
    stdout: String,
    stderr: String,
    // JetEvalIRResult.debug_trace.
    debug_trace: String{""},
    max_depth: Int,
    runtime_execution: Bool,
    // config.eval_entry: ambient effects other than the runtime child's
    // standard output are refused as `jet eval` refuses them.
    eval_entry: Bool,
    // config.impure: a Tier-2 effect of an item inside `#Impure` is refused
    // for the `Meta.Host` its package doesn't hold (E3411);
    // config.host_held: the package holds it, so the child admits the file
    // calls the item makes (jet_eval_native_admit).
    impure: Bool,
    host_held: Bool,
    // The `#Impure` calls of a build invocation now running (the host marks
    // Impure.enter and Impure.leave, IRProgram.invocation): the child admits
    // their file calls under the gate, and a system call refused inside one
    // is refused as `impure` refuses it.
    impure_sites: Int{0},
    // config.effect_call: the call a refused system call is named by.
    effect_call: String?{None},
    span: Span,
    failure: JetEvalError?,
    internal_problem: JetEvalInternalProblem?,
    exit_code: Int?,
    // The compiler's answer to `embed_file` / `embed_bytes` / `find`.
    inputs: JetEvalComptimeInputAdapter?,
    // The compiler's answer to a `core.compiler` query.
    compiler: JetEvalCompilerQueryHost?{None},
    // The batch's type rows and layouts host values are read and written
    // by, the build host of a fn-build or fn-dev invocation, and the
    // compiler values its code holds (a host word is index + 1).
    host_types: Shared<IRModule>?{None},
    host_layouts: Shared<[IRProgram]>?{None},
    host_adapter: JetEvalBuildHostAdapter?{None},
    host_values: [TComptimeValue]{[TComptimeValue]{}},
    // The call's type table (JetIR ir_type_handle): the address of the row
    // the compiler wrote into the child for each distinct TypeId, a column
    // over the names of the values' keys (JetIR ir_static_literal_key), so
    // one TypeId is one handle.
    type_row_keys: NameTable{name_table_sized(16)},
    type_rows: [Int]{[Int]{}},
    // The address an E3012 stop of the call names no function at (-1:
    // none), named once the call ends (jet_eval_native_overflow_name).
    overflow_at: Int{-1},
}

jet_eval_native_session: fn(file: String, reader: ^^JetEvalNativeImageReader) -> Shared<JetEvalNativeSession> Never! {
    image: Shared{JetEvalNativeImage{file: file, reader: reader.move(), read: false, bytes: [[U8]]{}, at: 0, stamp: [Int]{}, gap_at: 0, gap: 0}}
    Shared{JetEvalNativeSession{image: image, sealed: jet_eval_native_child_new(), runtime: jet_eval_native_child_new()}}
}

// Reads the runtime image file on the first call.
jet_eval_native_image_read: fn(image: ^JetEvalNativeImage) Never! {
    if image.read {
        return
    }
    image.read = true
    found: image.reader.read(image.file) ?? return
    image.at = found.at
    image.stamp = found.stamp.move()
    image.gap_at = found.gap_at
    image.gap = found.gap
    image.bytes.push(found.bytes.move())
}

// Whether the session's runtime image can be read (reading it on first use).
jet_eval_native_image_present: fn(session: JetEvalNativeSession) -> Bool Never! {
    permit := session.image.guard_edit()
    jet_eval_native_image_read(permit.value)
    permit.value.bytes.len() > 0
}

// Binds the entry program's object `object` to the session's runtime image
// (MemoryLink.jet x64_bind_runtime_image), which the bind takes out of the
// image cell instead of a copy and which goes back unchanged whether the
// program bound or not. The entry program keeps the image's first page, and
// its image part is mapped from the image's file when it spawns
// (Image/Loader.jet x64_executable_image_head); an image with no file
// identity it keeps whole. None when the image can't be read. The cell
// stays locked for the bind, so a bind of the other child waits for it.
jet_eval_native_bind: fn(session: JetEvalNativeSession, object: ^^[U8]) -> X64BindResult? Never! {
    permit := session.image.guard_edit()
    jet_eval_native_bind_image(permit.value, object.move())
}

jet_eval_native_bind_image: fn(image: ^JetEvalNativeImage, object: ^^[U8]) -> X64BindResult? Never! {
    jet_eval_native_image_read(image)
    // The cell holds the image alone, or nothing when it can't be read.
    runtime: image.bytes.pop() ?? return None
    bound := x64_bind_runtime_image("jet-comptime", object.move(), runtime, image.file, image.stamp.copy(), image.at, image.gap_at, image.gap, true)
    if bound.errors.len() > 0 {
        image.bytes.push(bound.executable.image.move())
        bound.executable.image = [U8]{}
        return Val(bound.move())
    }
    if image.stamp.len() == 0 {
        // copy: an image with no file identity can't be mapped, so the entry program keeps it whole.
        image.bytes.push(bound.executable.image.copy())
        return Val(bound.move())
    }
    taken: bound.executable.image.move()
    bound.executable.image = [U8]{}
    x64_executable_image_head(bound.executable, taken)
    image.bytes.push(taken)
    Val(bound.move())
}

// Binds a batch's program `built` to the session's runtime image, its part at
// `base`, straight from its functions (JetBackend Image/DirectBind.jet
// x64_bind_functions_at), the image taken out of the cell and put back as
// jet_eval_native_bind does. The batch gets no image part: the child runs
// the image already. With `debug` it binds with its debug facts
// (x64_bind_functions_debug_at), whose loaded bytes are the same. None when
// the image can't be read.
jet_eval_native_bind_batch: fn(session: JetEvalNativeSession, built: ^^IRX64Program, base: Int, debug: Bool{false}) -> X64BindResult? Never! {
    permit := session.image.guard_edit()
    jet_eval_native_image_read(permit.value)
    runtime: permit.value.bytes.pop() ?? return None
    bound := if debug -> x64_bind_functions_debug_at("jet-comptime", built.program.move(), built.functions.move(), built.debug.move(), built.threads, runtime, base, permit.value.gap_at, permit.value.gap) else -> x64_bind_functions_at("jet-comptime", built.program.move(), built.functions.move(), built.debug.move(), built.threads, runtime, base, permit.value.gap_at, permit.value.gap)
    permit.value.bytes.push(bound.executable.image.move())
    bound.executable.image = [U8]{}
    Val(bound.move())
}

// The address of the child's step word (JetRuntime ComptimeServe.jet
// comptime_serve_steps) in the session's runtime image; 0 when it has none.
jet_eval_native_steps_word: fn(session: JetEvalNativeSession) -> Int Never! {
    permit := session.image.guard_edit()
    jet_eval_native_image_read(permit.value)
    x64_runtime_image_export(permit.value.bytes, permit.value.gap_at, permit.value.gap, IR_X64_COMPTIME_STEPS_SYMBOL) ?? 0
}

// Tells the console of `jet debug --build` that child `pid` loaded
// `program`, and waits while it places the breakpoints the batch's code
// holds; nothing for a batch bound without debug facts.
jet_eval_native_watch: fn(program: JetEvalNativeProgram, pid: Int) {
    if program.facts.len() == 0 -> return
    build_debug_ask(BuildDebugEvent{kind: .Loaded, pid: pid, facts: program.facts.copy(), steps: program.steps, what: jet_eval_native_what(program)})
}

// What a batch is to the console: a package's `build: fn` (its runtime
// child) or compile-time code a build runs in the compiler's child.
jet_eval_native_what: fn(program: JetEvalNativeProgram) -> String Never! {
    if program.runtime_execution -> "build" else -> "prep"
}

jet_eval_native_child_new: fn() -> Shared<JetEvalNativeChild> Never! {
    Shared{JetEvalNativeChild{child: X64ComptimeChild{}, stub: x64_executable_whole([U8]{}), base: 0, generation: 0, failure: ""}}
}

// ---------------------------------------------------------------------------
// Children.

// Starts the child of `c` unless one runs: the entry program is bound to
// the session's image once, then each spawn runs it with effects refused
// (unless `stdout`, the runtime child's standard output). False with
// `c.failure`.
jet_eval_native_start: fn(c: ^JetEvalNativeChild, session: JetEvalNativeSession, stdout: Bool) -> Bool {
    if c.child.pid > 0 -> return true
    if c.stub.tail.len() == 0 {
        entry := jet_eval_native_entry_module()
        entry.fast_o0 = true
        compiled: ir_x64_object(ir_x64_compile_module(entry, compiler_threads_single()), true)
        if compiled.errors.len() > 0 {
            c.failure = "the comptime entry program doesn't compile: {compiled.errors.join("; ")}"
            return false
        }
        bound: jet_eval_native_bind(session, compiled.bytes.move()) ?? {
            c.failure = "the runtime image (jet_runtime.image) can't be read"
            return false
        }
        if bound.errors.len() > 0 {
            c.failure = "the comptime entry program doesn't bind to the runtime image: {bound.errors.join("; ")}"
            return false
        }
        plan: x64_executable_segments(bound.executable)
        if plan.failure != "" {
            c.failure = "the bound comptime entry program is not an image: {plan.failure}"
            return false
        }
        high: os_page_round(plan.high)
        if high > c.base -> c.base = high
        c.stub = bound.executable.move()
    }
    x64_comptime_close(c.child)
    spawned := x64_comptime_spawn(c.stub, stdout, build_debug_tracer())
    if spawned.failure != "" {
        c.failure = spawned.failure
        x64_comptime_close(spawned)
        return false
    }
    // What the runtime's start wrote is no item's output.
    spawned.stdout = [U8]{}
    spawned.stderr = [U8]{}
    c.child = spawned
    // The entry program's functions, `main` among them, which the child's
    // first stack starts in.
    jet_eval_native_loaded(session, c.child.pid, jet_eval_native_stub_listing(c.stub))
    c.generation += 1
    c.failure = ""
    true
}

// The listing (JetEvalNativeImageReader.loaded) of the functions of the
// bound entry program `stub`, which declare no source.
jet_eval_native_stub_listing: fn(stub: X64Executable) -> String {
    names := name_table_sized(8)
    listed: loop function in x64_comptime_functions(x64_executable_header(stub), stub.tail, stub.tail_at, names, every: true) -> "{function.start}\t{function.end}\t0\t\t{names.texts[function.name]}\n"
    listed.join("")
}

// Ends both children of `session` (EXIT, then wait4) once its compile is
// done; a later batch spawns a fresh one. An unreaped child would outlive
// the compile, and a program `jet run` starts in this process would reap it
// through its own `wait()`.
jet_eval_native_session_close: fn(session: Shared<JetEvalNativeSession>) {
    cells: session.guard_read()
    sealed := cells.value.sealed.guard_edit()
    x64_comptime_close(sealed.value.child)
    runtime := cells.value.runtime.guard_edit()
    x64_comptime_close(runtime.value.child)
}

// The entry program: `__jet_comptime_main` hands the runtime's server its
// table, whose one entry is the SIGSYS handler `__jet_comptime_refusal`.
jet_eval_native_entry_module: fn() -> IRModule {
    m := ir_module_new()
    pointer: ir_pointer_row(m)
    word: ir_word_row(m)
    refusal := ir_function_new("__jet_comptime_refusal", "__jet_comptime_refusal", "__jet_comptime_refusal", "", 0)
    _ := ir_slot(refusal, word, IRSlotKind.Param, ir_intern_name(m, "signal"), 0)
    info: ir_slot(refusal, pointer, IRSlotKind.Param, ir_intern_name(m, "info"), 0)
    context: ir_slot(refusal, pointer, IRSlotKind.Param, ir_intern_name(m, "context"), 0)
    refusal_args: ir_args(refusal, [Int]{info, context})
    _ := ir_emit(refusal, IROp.CallRuntime, -1, ir_intern_name(m, "jet_rt_comptime_refused"), refusal_args, 2, 0)
    _ := ir_emit(refusal, IROp.Return, -1, -1, -1, -1, 0)
    main := ir_function_new("__jet_comptime_main", "__jet_comptime_main", "__jet_comptime_main", "", 0)
    area: ir_slot(main, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(main, IROp.StackAddress, area, 8, 8, -1, 0)
    handler: ir_slot(main, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(main, IROp.FunctionAddress, handler, 0, -1, -1, 0)
    _ := ir_emit(main, IROp.Store, -1, area, 0, handler, 0)
    count: ir_slot(main, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(main, IROp.Const, count, 1, -1, -1, 0)
    serve_args: ir_args(main, [Int]{area, count})
    _ := ir_emit(main, IROp.CallRuntime, -1, ir_intern_name(m, "jet_rt_comptime_serve"), serve_args, 2, 0)
    _ := ir_emit(main, IROp.Return, -1, -1, -1, -1, 0)
    _ := jet_eval_native_add(m, refusal)
    m.entry = jet_eval_native_add(m, main)
    m
}

// Adds `f` to `m`; its function id.
jet_eval_native_add: fn(m: ^IRModule, f: ^^IRFunction) -> Int Never! {
    owned: f.move()
    id: m.functions.len()
    ir_function_bind(m, owned.key, id)
    m.functions.push(owned)
    id
}

// ---------------------------------------------------------------------------
// Loading.

// Compiles `built` (moved in) for the child of `config` and loads it there.
// A batch that can't load carries why; each run of it reports that.
// `threads` lint and select the batch as they do a program's
// (ir_x64_compile_module admits them by its instruction count): the code is
// the same for any thread count.
jet_eval_native_load: fn(built: ^^JetEvalIRComptime, config: JetEvalConfig, threads: CompilerThreads{compiler_threads_single()}) -> JetEvalNativeProgram {
    owned: built.move()
    code := owned.code.move()
    layouts: owned.layouts.move()
    pointer: ir_pointer_row(code)
    entries := [Int]{}
    results := [Int]{}
    sizes := [Int]{}
    params := [[Int]]{}
    names := [String]{}
    loop (index, id) in owned.items {
        entries.push(0)
        if id < 0 || id >= code.functions.len() {
            results.push(-1)
            sizes.push(8)
            params.push([Int]{})
            names.push("")
            next
        }
        rows: loop slot in 0..<code.functions[id].param_count -> code.functions[id].slot_type[slot]
        result: code.functions[id].result
        size: if result >= 0 && code.types[result].size > 8 -> code.types[result].size else -> 8
        name: "{JET_EVAL_NATIVE_PREFIX}item_{index}"
        wrapper: jet_eval_native_wrapper(code, name, id, rows, result, pointer)
        _ := jet_eval_native_add(code, wrapper)
        results.push(result)
        sizes.push(size)
        params.push(rows)
        names.push(name)
    }
    program := JetEvalNativeProgram{types: Shared{ir_module_new()}, layouts: layouts.move(), entries: [Int]{}, results: results.move(), sizes: sizes.move(), params: params.move(), code: X64ComptimeCode{segments: [X64Segment]{}, bytes: [U8]{}, high: 0, failure: ""}, generation: 0, runtime_execution: config.runtime_execution, failure: "", missing: false}
    session_cell: config.native ?? {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = entries.move()
        return program
    }
    session: session_cell.guard_read()
    if !jet_eval_native_image_present(session.value) {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = entries.move()
        return program
    }
    cell: if config.runtime_execution -> session.value.runtime.copy() else -> session.value.sealed.copy()
    permit := cell.guard_edit()
    if !jet_eval_native_start(permit.value, session.value, config.runtime_execution) {
        program.failure = permit.value.failure.copy()
        program.entries = entries.move()
        return program
    }
    jet_eval_native_missing(code, session.value)
    // The executable's entry, which the binder requires; it names every
    // wrapper so none is dropped as unreachable.
    none := ir_function_new("{JET_EVAL_NATIVE_PREFIX}none", "{JET_EVAL_NATIVE_PREFIX}none", "{JET_EVAL_NATIVE_PREFIX}none", "", 0)
    loop name in names {
        if name == "" -> next
        target: ir_keyed_function(code, name) ?? next
        address: ir_slot(none, pointer, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(none, IROp.FunctionAddress, address, target, -1, -1, 0)
    }
    _ := ir_emit(none, IROp.Return, -1, -1, -1, -1, 0)
    code.entry = jet_eval_native_add(code, none)
    // Compile-time code keeps the `#Inline(Always)` guarantee as every
    // tier does: each direct call of a marked callee is its body.
    marked_report := ir_opt_report(0)
    ir_opt_inline_marked_module(code, marked_report, threads)
    // The rows outlive the code: values are read and written by them.
    functions: compiler_take_rows<IRFunction>(code.functions)
    data: compiler_take_rows<[U8]>(code.data)
    program.types = Shared{code.copy()}
    code.functions = functions.move()
    code.data = data.move()
    // The function names by the id of the object symbol each one's code
    // goes by (JetIR X64Select.jet), for a fault's report, and each one's
    // declaration, for the listing of the batch (JetEvalNativeProgram).
    symbols := name_table_sized(code.functions.len() * 2)
    labels := [String]{}
    places := [String]{}
    loop function in code.functions {
        id: name_index(name_intern(symbols, if {
            function.symbol != "" -> function.symbol
            function.key != "" -> function.key
            else -> function.name
        }))
        loop labels.len() <= id {
            labels.push("")
            places.push("")
        }
        if labels[id] == "" {
            labels[id] = function.name
            places[id] = "{function.line}\t{function.source_file}"
        }
    }
    code.fast_o0 = true
    // Each turn poll spends a step of the CALL's limit.
    code.step_count = true
    // Under `jet debug --build` the batch is bound with its debug facts; its
    // code is the code it has without them (jet_eval_native_bind_batch).
    watched: build_debug_on()
    compiled: ir_x64_compile_module(code, threads)
    prepared: if watched -> ir_x64_debug_program(compiled.move()) else -> ir_x64_program(compiled.move())
    if prepared.errors.len() > 0 {
        program.failure = "the batch doesn't compile to x86-64: {prepared.errors.join("; ")}"
        program.entries = entries.move()
        return program
    }
    // The batch binds to the session's image itself, not a copy, and only
    // its program part is put together: the child runs the image already.
    bound: jet_eval_native_bind_batch(session.value, prepared.move(), permit.value.base, watched) ?? {
        program.failure = "no runtime image"
        program.missing = true
        program.entries = entries.move()
        return program
    }
    if bound.errors.len() > 0 {
        doing: if bound.unwritten -> "compile to x86-64" else -> "bind to the runtime image"
        program.failure = "the batch doesn't {doing}: {bound.errors.join("; ")}"
        program.entries = entries.move()
        return program
    }
    addresses: x64_comptime_symbols(x64_executable_header(bound.executable), bound.executable.tail, bound.executable.tail_at, JET_EVAL_NATIVE_PREFIX, false)
    loop (index, name) in names {
        if name == "" -> next
        entries[index] = x64_comptime_symbol_address(addresses, name) ?? 0
        if entries[index] == 0 {
            program.failure = "the bound batch has no `{name}`"
            program.entries = entries.move()
            return program
        }
    }
    program.entries = entries.move()
    program.code = x64_comptime_code(bound.executable, permit.value.base)
    if program.code.failure != "" {
        program.failure = "the bound batch is not an image: {program.code.failure}"
        return program
    }
    program.functions = x64_comptime_functions(x64_executable_header(bound.executable), bound.executable.tail, bound.executable.tail_at, symbols)
    if watched {
        program.facts = x64_comptime_facts(bound.executable)
        program.steps = jet_eval_native_steps_word(session.value)
    }
    listed := [String]{}
    loop function in program.functions {
        if labels[function.name] != "" {
            listed.push("{function.start}\t{function.end}\t{places[function.name]}\t{labels[function.name]}\n")
        }
    }
    program.listing = listed.join("")
    program.function_names = labels.move()
    permit.value.base = program.code.high
    loaded: x64_comptime_load(permit.value.child, program.code)
    if loaded != "" {
        x64_comptime_reap(permit.value.child, true)
        program.failure = loaded
        return program
    }
    jet_eval_native_loaded(session.value, permit.value.child.pid, program.listing)
    jet_eval_native_watch(program, permit.value.child.pid)
    program.generation = permit.value.generation
    program
}

// Tells the session's host that child `pid` loaded a batch whose functions
// `listing` names (JetEvalNativeImageReader.loaded).
jet_eval_native_loaded: fn(session: JetEvalNativeSession, pid: Int, listing: String) {
    if listing == "" {
        return
    }
    permit: session.image.guard_edit()
    permit.value.reader.loaded(pid, listing)
}

// `__jet_comptime_item_{index}(cell, params...)`: calls item function `id`
// and stores its result in `cell` (an aggregate's bytes, else its word).
// With `loads`, every param is passed as the address of its bytes, which
// the wrapper loads (a debugger's evaluated expression, whose captures it
// reads from a stopped frame); an aggregate's address is the param itself.
// With `table` as well, the wrapper is `(cell, table)`: the params'
// addresses are the words of `table`, in order, for more captures than a
// call's registers hold.
jet_eval_native_wrapper: fn(code: ^IRModule, name: String, id: Int, params: [Int], result: Int, pointer: Int, loads: Bool{false}, table: Bool{false}) -> IRFunction {
    w := ir_function_new(name, name, name, "", 0)
    cell: ir_slot(w, pointer, IRSlotKind.Param, ir_intern_name(code, "cell"), 0)
    listed: if loads && table -> ir_slot(w, pointer, IRSlotKind.Param, ir_intern_name(code, "table"), 0) else -> -1
    held := [Int]{}
    loop (index, row) in params {
        aggregate: code.types[row].kind == .Aggregate
        if listed >= 0 {
            address: ir_slot(w, if aggregate -> row else -> pointer, IRSlotKind.Temp, -1, 0)
            if {
                aggregate -> {
                    word: ir_slot(w, pointer, IRSlotKind.Temp, -1, 0)
                    _ := ir_emit(w, IROp.Load, word, listed, 8 * index, -1, 0)
                    _ := ir_emit(w, IROp.Offset, address, word, 0, -1, 0)
                }
                else -> { _ := ir_emit(w, IROp.Load, address, listed, 8 * index, -1, 0) }
            }
            held.push(address)
            next
        }
        loaded: loads && !aggregate
        held.push(ir_slot(w, if loaded -> pointer else -> row, IRSlotKind.Param, ir_intern_name(code, "a{index}"), 0))
    }
    args := [Int]{}
    loop (index, row) in params {
        if !loads || code.types[row].kind == .Aggregate {
            args.push(held[index])
            next
        }
        value: ir_slot(w, row, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(w, IROp.Load, value, held[index], 0, -1, 0)
        args.push(value)
    }
    start: ir_args(w, args)
    if {
        result < 0 || code.types[result].kind == .Unit -> {
            _ := ir_emit(w, IROp.Call, -1, id, start, args.len(), 0)
        }
        else -> {
            value: ir_slot(w, result, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(w, IROp.Call, value, id, start, args.len(), 0)
            if {
                code.types[result].kind == .Aggregate -> {
                    _ := ir_emit(w, IROp.CopyBytes, -1, cell, value, code.types[result].size, 0)
                }
                else -> { _ := ir_emit(w, IROp.Store, -1, cell, 0, value, 0) }
            }
        }
    }
    _ := ir_emit(w, IROp.Return, -1, -1, -1, -1, 0)
    w
}

// Each runtime call of `code` to a symbol neither the runtime image
// defines nor the batch does calls a stub of its own instead, which asks
// the compiler (HOST_MISSING): such a call is unsupported where it runs, as
// it was before the batch ran, and the rest of the batch binds. The image is
// asked once for each name the batch calls (x64_runtime_image_defines), as
// its bind looks the name up.
jet_eval_native_missing: fn(code: ^IRModule, session: JetEvalNativeSession) {
    own := name_table_sized(64)
    loop id in 0..<code.functions.len() {
        _ := name_intern(own, code.functions[id].symbol)
        _ := name_intern(own, code.functions[id].name)
    }
    calls := [Int]{}
    // The names asked of the image, and each one's place among them.
    asked := [Int]{}
    asked_at := [Int:Int]{}
    loop id in 0..<code.functions.len() {
        loop at in 0..<code.functions[id].op.len() {
            if code.functions[id].op[at] != .CallRuntime -> next
            name: code.functions[id].a[at]
            if name_find(own, code.names[name]) != None -> next
            if asked_at.get(name) == None {
                asked_at[name] = asked.len()
                asked.push(name)
            }
            calls.push(id)
            calls.push(at)
        }
    }
    if calls.len() == 0 {
        return
    }
    permit := session.image.guard_edit()
    jet_eval_native_image_read(permit.value)
    defined := [Bool]{}
    defined.try_reserve(asked.len()) ?? ()
    uncached := [Int]{}
    uncached_places := [Int]{}
    uncached_ids := [Int]{}
    loop (place, name_row) in asked {
        id: name_index(name_intern(permit.value.defined_names, code.names[name_row]))
        loop permit.value.defined_hits.len() <= id -> permit.value.defined_hits.push(0)
        cached: permit.value.defined_hits[id]
        if cached != 0 -> defined.push(cached == 2) else {
            defined.push(false)
            uncached.push(name_row)
            uncached_places.push(place)
            uncached_ids.push(id)
        }
    }
    if uncached.len() > 0 {
        found: x64_runtime_image_defines(permit.value.bytes, permit.value.gap_at, permit.value.gap, code.names, uncached)
        loop (index, place) in uncached_places {
            hit: index < found.len() && found[index]
            defined[place] = hit
            permit.value.defined_hits[uncached_ids[index]] = if hit -> 2 else -> 1
        }
    }
    sites := [Int]{}
    loop index in 0..<(calls.len() /% 2) {
        place: asked_at.get(code.functions[calls[2 * index]].a[calls[2 * index + 1]]) ?? -1
        if place >= 0 && place < defined.len() && defined[place] -> next
        sites.push(calls[2 * index])
        sites.push(calls[2 * index + 1])
    }
    index := 0
    loop index < sites.len() {
        id: sites[index]
        at: sites[index + 1]
        index += 2
        symbol: code.names[code.functions[id].a[at]].copy()
        start: code.functions[id].b[at]
        rows: loop arg in start..<(start + code.functions[id].c[at]) -> code.functions[id].slot_type[code.functions[id].args[arg]]
        dst: code.functions[id].dst[at]
        result: if dst >= 0 -> code.functions[id].slot_type[dst] else -> -1
        stub: jet_eval_native_missing_stub(code, "{JET_EVAL_NATIVE_PREFIX}missing_{index /% 2}", symbol, rows, result)
        target: jet_eval_native_add(code, stub)
        code.functions[id].op[at] = IROp.Call
        code.functions[id].a[at] = target
    }
}

jet_eval_native_missing_stub: fn(code: ^IRModule, name: String, symbol: String, params: [Int], result: Int) -> IRFunction {
    f := ir_function_new(name, name, name, "", 0)
    loop (index, row) in params {
        _ := ir_slot(f, row, IRSlotKind.Param, ir_intern_name(code, "a{index}"), 0)
    }
    f.result = result
    pointer: ir_pointer_row(code)
    word: ir_word_row(code)
    area: ir_slot(f, pointer, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.StackAddress, area, 8, 8, -1, 0)
    text: ir_slot(f, ir_string_row(code), IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.ConstText, text, ir_intern_text(code, symbol), -1, -1, 0)
    _ := ir_emit(f, IROp.Store, -1, area, 0, text, 0)
    kind: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, kind, X64_COMPTIME_HOST_MISSING, -1, -1, 0)
    count: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, count, 1, -1, -1, 0)
    answer: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    host_args: ir_args(f, [Int]{kind, area, count})
    _ := ir_emit(f, IROp.CallRuntime, answer, ir_intern_name(code, "jet_comptime_host"), host_args, 3, 0)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 0)
    f
}

// ---------------------------------------------------------------------------
// Running.

// Runs item `item` of `program` on `args` (a fn-build or fn-dev entry's
// context; none for a constant).
jet_eval_native_run: fn(program: ^JetEvalNativeProgram, item: Int, args: [TComptimeValue], config: JetEvalConfig, span: Span) -> JetEvalIRResult {
    s := JetEvalIRState{
        child: X64ComptimeChild{},
        pages: [[U8]]{},
        page_rows: [Int:Int]{},
        step_limit: config.fuel,
        stdout: "",
        stderr: "",
        max_depth: config.max_call_depth,
        runtime_execution: program.runtime_execution,
        eval_entry: config.eval_entry,
        impure: config.impure,
        host_held: config.host_held,
        effect_call: config.effect_call,
        span: span,
        failure: None,
        internal_problem: None,
        exit_code: None,
        inputs: if config.comptime_input_adapter == .Val(adapter) -> Val(adapter.clone_input_adapter()) else -> None,
        compiler: if config.compiler_query_host == .Val(host) -> Val(host.clone_compiler_host()) else -> None,
        host_types: Val(program.types.copy()),
        host_layouts: Val(program.layouts.copy()),
        host_adapter: if config.build_host_adapter == .Val(installed) -> Val(installed.clone_adapter()) else -> None,
    }
    if program.failure != "" {
        if {
            program.missing -> {
                jet_eval_ir_unsupported(s, "compile-time code without the runtime image (jet_runtime.image)")
            }
            else -> {
                jet_eval_ir_problem(s, "compile-time code doesn't run natively: {program.failure}")
            }
        }
        return jet_eval_ir_result(s, None)
    }
    if item < 0 || item >= program.entries.len() || program.entries[item] == 0 {
        jet_eval_ir_problem(s, "item {item} has no native entry")
        return jet_eval_ir_result(s, None)
    }
    session_cell: config.native ?? {
        jet_eval_ir_unsupported(s, "compile-time code without the runtime image (jet_runtime.image)")
        return jet_eval_ir_result(s, None)
    }
    session: session_cell.guard_read()
    cell: if program.runtime_execution -> session.value.runtime.copy() else -> session.value.sealed.copy()
    permit := cell.guard_edit()
    if permit.value.child.pid <= 0 || permit.value.generation != program.generation {
        if !jet_eval_native_start(permit.value, session.value, program.runtime_execution) {
            jet_eval_ir_problem(s, permit.value.failure)
            return jet_eval_ir_result(s, None)
        }
        loaded: x64_comptime_load(permit.value.child, program.code)
        if loaded != "" {
            x64_comptime_reap(permit.value.child, true)
            jet_eval_ir_problem(s, loaded)
            return jet_eval_ir_result(s, None)
        }
        jet_eval_native_loaded(session.value, permit.value.child.pid, program.listing)
        jet_eval_native_watch(program, permit.value.child.pid)
        program.generation = permit.value.generation
    }
    s.child = permit.value.child.copy()
    // The console of `jet debug --build` names the call's limit and what
    // runs at a stop inside it; the call itself is the same.
    if program.facts.len() > 0 {
        build_debug_tell(BuildDebugEvent{kind: .Calling, pid: s.child.pid, steps: program.steps, limit: if s.step_limit < 0 -> 9223372036854775807 else -> s.step_limit, what: jet_eval_native_what(program)})
    }
    value: jet_eval_native_call(s, program, item, args)
    if s.overflow_at >= 0 -> jet_eval_native_overflow_name(s, program)
    x64_comptime_settle(s.child)
    s.stdout = "{s.stdout}{String.from_bytes_lossy(s.child.stdout)}"
    s.stderr = "{s.stderr}{String.from_bytes_lossy(s.child.stderr)}"
    s.child.stdout = [U8]{}
    s.child.stderr = [U8]{}
    // The child goes back to its cell, and the state keeps an empty one.
    permit.value.child = s.child.move()
    s.child = X64ComptimeChild{}
    // Standard error no runtime stop read back is the evaluated code's own
    // output, an effect a comptime evaluation refuses.
    if !s.runtime_execution && s.stderr != "" && !jet_eval_ir_failed(s) {
        jet_eval_ir_effect_refused(s, "standard error", false)
    }
    jet_eval_ir_result(s, value)
}

jet_eval_native_call: fn(s: ^JetEvalIRState, program: JetEvalNativeProgram, item: Int, args: [TComptimeValue]) -> TComptimeValue? {
    rows: program.params[item]
    if args.len() > 0 && args.len() != rows.len() {
        jet_eval_ir_problem(s, "the entry takes {rows.len()} parameters, given {args.len()}")
        return None
    }
    if rows.len() > JET_EVAL_NATIVE_MAX_PARAMS {
        jet_eval_ir_problem(s, "the entry takes {rows.len()} parameters; a native call passes at most {JET_EVAL_NATIVE_MAX_PARAMS}")
        return None
    }
    words: jet_eval_ir_host_arguments(s, rows, args) ?? return None
    cell: jet_eval_native_alloc(s, program.sizes[item], 8) ?? return None
    operands := [Int]{program.entries[item], cell}
    operands.extend(words)
    // The entry's System V words are padded to five arguments, so the step
    // limit is the frame's last operand (JetRuntime ComptimeServe.jet
    // comptime_serve_steps).
    loop operands.len() < 6 -> operands.push(0)
    operands.push(if s.step_limit < 0 -> 9223372036854775807 else -> s.step_limit)
    // A stop above an admitted block left the child admitting: each call
    // starts as its item admits.
    if !jet_eval_native_admit(s) || !jet_eval_native_command(s, X64_COMPTIME_CALL, operands, [U8]{}) {
        jet_eval_native_ended(s)
        return None
    }
    if !jet_eval_native_serve(s) -> return None
    row: program.results[item]
    if row < 0 -> return Val(TComptimeValue.Unit)
    types := program.types.guard_edit()
    layouts: program.layouts.guard_read()
    ty: types.value.types[row]
    if ty.kind == .Unit -> return Val(TComptimeValue.Unit)
    word := cell
    if ty.kind != .Aggregate {
        width: jet_eval_ir_width(ty)
        word = jet_eval_ir_load(s, ty, cell, width) ?? return None
    }
    value: jet_eval_ir_data(types.value, layouts.value[0], s, word, row) ?? return None
    if jet_eval_ir_failed(s) -> return None
    Val(value)
}

// Answers the child until the call's DONE: true then, false once the call
// failed (its failure recorded).
jet_eval_native_serve: fn(s: ^JetEvalIRState) -> Bool {
    loop {
        reply: x64_comptime_receive(s.child) ?? {
            jet_eval_native_ended(s)
            return false
        }
        jet_eval_native_forget(s)
        kind: x64_comptime_word(reply, 0)
        if kind == X64_COMPTIME_DONE -> return true
        if kind == X64_COMPTIME_HOST {
            answer: jet_eval_native_host(s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16), x64_comptime_word(reply, 24), x64_comptime_word(reply, 32))
            if answer == .Val(word) && !jet_eval_ir_failed(s) {
                if jet_eval_native_command(s, X64_COMPTIME_RETURN, [Int]{word}, [U8]{}) -> next
                jet_eval_native_ended(s)
                return false
            }
            // The code can't go on without its answer: the child ends with it.
            x64_comptime_reap(s.child, true)
            if !jet_eval_ir_failed(s) {
                jet_eval_ir_problem(s, "a host route of compile-time code has no answer")
            }
            return false
        }
        if kind == X64_COMPTIME_STOP {
            jet_eval_native_stop(s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16), x64_comptime_word(reply, 24), x64_comptime_word(reply, 32), x64_comptime_word(reply, 40))
            if !jet_eval_ir_failed(s) {
                jet_eval_ir_problem(s, "a runtime stop of compile-time code has no report")
            }
            return false
        }
        if kind == X64_COMPTIME_REFUSED {
            x64_comptime_reap(s.child, false)
            jet_eval_native_refused(s, x64_comptime_word(reply, 8), x64_comptime_word(reply, 16))
            return false
        }
        x64_comptime_reap(s.child, true)
        jet_eval_ir_problem(s, "the comptime child sent frame {kind}")
        return false
    }
}

// The call's child ended before its DONE: out of stack, a runtime exit (a
// stop's report on standard error, or a program's exit), or a signal from
// outside jet (jet_eval_native_outside_signal), which is no defect of jet's
// and no failure of the code: the build stops with E3007, whose command
// ends with 128 plus the signal.
jet_eval_native_ended: fn(s: ^JetEvalIRState) {
    if jet_eval_ir_failed(s) {
        return
    }
    failure: s.child.failure.copy()
    if failure != "" {
        jet_eval_ir_problem(s, failure)
        return
    }
    signal: s.child.status & 127
    if signal == 11 {
        depth: s.max_depth
        jet_eval_ir_source_fail(s, "compile-time call depth exceeds {depth}")
        return
    }
    if jet_eval_native_outside_signal(signal) == .Val(name) {
        diagnostic := diagnostic_from_registry("E3007", Val(s.span), "compile-time code was ended by {name} from outside jet", "jet runs compile-time code in a process of its own, and another process or the system (as when memory runs out) sent that process {name}, so the code never finished; jet and the program did not raise it", "build again without stopping it; if the system ended it because memory ran out, free memory or make the compile-time work smaller")
        diagnostic.outside_signal = Val(signal)
        s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic})
        return
    }
    if signal != 0 {
        jet_eval_ir_problem(s, "the comptime child ended on signal {signal}")
        return
    }
    code: (s.child.status >> 8) & 255
    if s.runtime_execution {
        s.exit_code = Val(code)
        return
    }
    report: String.from_bytes_lossy(s.child.stderr).trim()
    s.child.stderr = [U8]{}
    if jet_eval_native_overflow(s, report) {
        return
    }
    jet_eval_ir_source_fail(s, if report == "" -> "the runtime exited with status {code}" else -> report)
}

// The name of `signal` when it is one that something outside a process
// sends to end it: the terminal closing (SIGHUP), an interrupt (SIGINT), a
// kill (SIGKILL, also the kernel's when memory runs out) or a request to
// stop (SIGTERM). A signal a process raises on itself, as a fault's SIGSEGV
// or an abort's SIGABRT, is none of these and stays a defect. The compiler
// ends its child only with SIGKILL, and then records why first (a failed
// wait, a host route without an answer), so an unexplained one came
// from outside.
jet_eval_native_outside_signal: fn(signal: Int) -> String? Never! {
    if signal == {
        1 -> Val("SIGHUP")
        2 -> Val("SIGINT")
        9 -> Val("SIGKILL")
        15 -> Val("SIGTERM")
        else -> None
    }
}

// The child's E3012 stop (JetRuntime FaultReport report.S) names the
// overflowing function by its address alone when the child's location table
// doesn't hold it, as for all batch code.
JET_EVAL_NATIVE_UNNAMED_AT: "`??` at 0x"

// A stack overflow in compile-time code: one E3012 at the comptime site,
// without the address the child names its function by; the call's end
// names it from the batch (jet_eval_native_overflow_name). False when
// `report` is no E3012 stop.
jet_eval_native_overflow: fn(s: ^JetEvalIRState, report: String) -> Bool Never! {
    lines: report.split("\n").to_list()
    if lines.len() == 0 -> return false
    stop: diagnostic_stop_parse(lines[0]) ?? return false
    if stop.code != "E3012" -> return false
    at: stop.what.find(JET_EVAL_NATIVE_UNNAMED_AT)
    if at >= 0 {
        digits: stop.what.bytes()
        address := 0
        loop index in at + JET_EVAL_NATIVE_UNNAMED_AT.bytes().len()..<digits.len() {
            digit: Int{digits[index]}
            if {
                digit >= 48 && digit <= 57 -> address = address * 16 + digit - 48
                digit >= 97 && digit <= 102 -> {
                    address = address * 16 + digit - 87
                }
                else -> { break }
            }
        }
        s.overflow_at = address
    }
    if s.failure == None {
        s.failure = Val(jet_eval_native_overflow_error(s.span, if at >= 0 -> "Stack overflow" else -> stop.what))
    }
    true
}

// The E3012 of compile-time code at `span`, its first line `what`.
jet_eval_native_overflow_error: fn(span: Span, what: String) -> JetEvalError Never! {
    why: "compile-time code kept calling deeper without returning until it ran out of stack, so the `#run` value has no result"
    fix: "end the recursion or make each call progress toward a base case, or compute the value at run time"
    JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3012", Val(span), what, why, fix)}
}

// A call's unnamed stack overflow (JetEvalIRState.overflow_at) names the
// batch function whose code holds its address.
jet_eval_native_overflow_name: fn(s: ^JetEvalIRState, program: JetEvalNativeProgram) Never! {
    id: x64_comptime_function_at(program.functions, s.overflow_at) ?? return
    if id >= program.function_names.len() || program.function_names[id] == "" {
        return
    }
    s.failure = Val(jet_eval_native_overflow_error(s.span, "Stack overflow in `{program.function_names[id]}`"))
}

// A runtime stop (JetRuntime Trap.jet) of kind `kind` and its words; the
// child keeps serving above the stopped frames.
jet_eval_native_stop: fn(s: ^JetEvalIRState, kind: Int, a: Int, b: Int, c: Int, d: Int) {
    if kind == X64_COMPTIME_STOP_STEPS {
        _ := jet_eval_ir_out_of_fuel(s)
        return
    }
    if kind == X64_COMPTIME_STOP_MESSAGE {
        message: jet_eval_ir_bytes(s, a, b) ?? return
        jet_eval_ir_source_fail(s, String.from_bytes_lossy(message))
        return
    }
    if kind == X64_COMPTIME_STOP_SHIFT {
        count: jet_eval_ir_wrap(a, 64, b == 0)
        jet_eval_ir_source_fail(s, "shift count {count} is outside 0..<{c}")
        return
    }
    if kind == X64_COMPTIME_STOP_LIST_BOUNDS {
        index: jet_eval_ir_int_value(s, b) ?? return
        noun: if a == 1 -> "item" else -> "items"
        jet_eval_ir_source_fail(s, "the list has {a} {noun}, so position {index} doesn't exist")
        return
    }
    // A `panic`/`assert`/`require` stop (Trap.jet jet_rt_require_stop), which
    // a comptime item's unhandled failure raises too (JetIR
    // ir_failure_stop): an equality stop (kind 1) carries its two
    // sides, every other its message. In code the build runs it is a
    // user-authored compile error (S26): a comptime evaluation, and a
    // `build: fn` or `dev: fn` invocation with the `meta.events` handlers
    // it registers, which run as a program does. Only `jet eval`'s run
    // (`eval_entry`) is the program's own stop.
    if kind == X64_COMPTIME_STOP_REQUIRE {
        message := ""
        if {
            a == 1 -> {
                right: jet_eval_ir_text(s, d) ?? return
                left: jet_eval_ir_text(s, c) ?? return
                message = "expected: {right}, got: {left}"
            }
            b != 0 -> { message = jet_eval_ir_text(s, b) ?? return }
        }
        if s.runtime_execution && s.eval_entry {
            jet_eval_ir_source_fail(s, message)
            return
        }
        if s.failure == None {
            s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3010", Val(s.span), "`{message}`", "compile-time code stopped the build: a `panic`, a failed check or an unhandled failure in code the build runs (a `#run` value, a `build: fn` or a handler it registers) is a compile error", "handle the failure where the compile-time code meets it (`??` or an `.Ok`/`.Err` match), or fix the value the check rejects")})
        }
        return
    }
    // A reached `#Todo` (Trap.jet jet_todo_stop): the E3011 stop at its file
    // and line, naming the type it stands for. A comptime value it reaches
    // has no value to fold, so it stops the build.
    if kind == X64_COMPTIME_STOP_TODO {
        file: jet_eval_ir_text(s, a) ?? return
        expected: jet_eval_ir_text(s, c) ?? return
        what: "`#Todo at {file}:{b} — expected {expected}`"
        why: if s.runtime_execution -> "this code is deliberately incomplete and reached a running program." else -> "compile-time code reached a `#Todo`, so the `#run` value has no result: the code it stands for is deliberately incomplete."
        fix: if s.runtime_execution -> "implement the missing code before running the program." else -> "implement the missing code, or keep the `#Todo` out of the code a `#run` value runs."
        if s.failure == None {
            s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3011", Val(s.span), what, why, fix)})
        }
        return
    }
    jet_eval_ir_problem(s, "the comptime child stopped with kind {kind} ({a}, {b}, {c}, {d})")
}

// System call `number` (first argument `first`) the filter refused, or an
// effect the child's runtime refused itself (a negative `number`,
// JetRuntime ComptimeServe.jet comptime_serve_refuse). Runtime execution has
// no host for it (unsupported), except under `jet eval`, whose evaluator
// mode refuses it as an ambient effect (E3401), and inside a build
// invocation's `#Impure` Core call, which is a Tier-2 effect (E3411). A
// comptime evaluation refuses it as the effect it is: ambient time and
// randomness are E3403, any other effect is observable outside the program,
// so folding it would bake one build-time result into every run (E3410).
// The refusal names the item's effectful call (s.effect_call) when sema found
// one, else the effect's class.
jet_eval_native_refused: fn(s: ^JetEvalIRState, number: Int, first: Int) {
    class: jet_eval_native_refused_class(number, first)
    if s.runtime_execution && !s.eval_entry && s.impure_sites == 0 {
        jet_eval_ir_unsupported(s, class)
        return
    }
    // The runtime's process abort (JetRuntime Alloc.jet alloc_abort) resets
    // SIGABRT's handler: the served code hit a defect, not a host effect.
    if number == 13 && first == 6 {
        report: String.from_bytes_lossy(s.child.stderr).trim()
        s.child.stderr = [U8]{}
        jet_eval_ir_problem(s, if report == "" -> "the comptime child aborted" else -> "the comptime child aborted: {report}")
        return
    }
    what: s.effect_call ?? class
    jet_eval_ir_effect_refused(s, what, number == 228 || number == 318)
}

jet_eval_native_refused_class: fn(number: Int, first: Int) -> String {
    if number == X64_COMPTIME_REFUSED_ENVIRONMENT -> return "reading or changing the environment"
    if number == X64_COMPTIME_REFUSED_PROCESS -> return "launching a process"
    if number == {
        1 | 20 -> if first == 1 -> "standard output" else -> "system call {number}"
        257 | 2 -> "opening a file"
        0 -> "reading a file"
        3 -> "closing a file"
        13 -> "a signal handler"
        291 -> "an event poller"
        228 -> "the clock"
        318 -> "OS randomness"
        else -> "system call {number}"
    }
}

// A comptime evaluation's refusal of host effect `what` (`nondeterministic`:
// ambient time or randomness); `jet eval` refuses every one as its evaluator
// mode does.
jet_eval_ir_effect_refused: fn(s: ^JetEvalIRState, what: String, nondeterministic: Bool) Never! {
    if s.failure != None {
        return
    }
    if s.eval_entry {
        s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Effect, s.span, what, "this effect is not permitted in the current evaluator mode", "run the effect in an authorized runtime ambient context"))
        return
    }
    if nondeterministic {
        entry: diagnostic_registry_row_of("E3403")
        refusal: diagnostic_from_registry("E3403", Val(s.span), entry.what.replace("{{what_text}}", what), entry.why, entry.fix)
        s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Effect, diagnostic: diagnostic_with_rights(refusal, "pure", [String]{what}, [String]{}, None)})
        return
    }
    impure: s.impure || s.impure_sites > 0
    if impure && s.host_held {
        s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Effect, s.span, "`{what}` inside `#Impure` is a Tier-2 comptime effect the compile-time child doesn't admit", "`Meta.Host` admits the file system calls of an `#Impure` block, which run natively as they do at run time; other host effects stay refused", "keep the call at runtime"))
        return
    }
    if impure {
        entry: diagnostic_registry_row_of("E3411")
        s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Effect, diagnostic: diagnostic_from_registry("E3411", Val(s.span), "`{what}` inside `#Impure` is a Tier-2 comptime effect, but its package doesn't hold `Meta.Host`", entry.why, entry.fix)})
        return
    }
    s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Effect, diagnostic: diagnostic_from_registry("E3410", Val(s.span), "`{what}` is a Tier-2 comptime effect — it requires a `#Impure` gate", "effectful Core APIs are not allowed in pure comptime evaluation", "wrap the comptime binding in `#Impure(\"reason\") {{ … }}` and name `Meta.Host` in the main package's `authority: {{ allow: [...] }}` row, or keep the call at runtime")})
}

jet_eval_ir_result: fn(s: JetEvalIRState, value: TComptimeValue?) -> JetEvalIRResult Never! {
    complete: value != None && !jet_eval_ir_failed(s)
    JetEvalIRResult{value: if complete -> value else -> None, complete: complete, error: s.failure, internal_problem: s.internal_problem, stdout: s.stdout, stderr: s.stderr, debug_trace: s.debug_trace, exit_code: s.exit_code, steps: 0}
}

// ---------------------------------------------------------------------------
// Host routes.

// HOST(kind, operands, count, result): the route's `count` words at
// `operands` are its answer row's key, then its operands (JetIR
// ir_host_route); the answer is the RETURN word, an aggregate or Float one
// written to `result`.
jet_eval_native_host: fn(s: ^JetEvalIRState, kind: Int, operands: Int, count: Int, result: Int) -> Int? {
    if count < 1 || count > 4096 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_host")
    bytes: jet_eval_ir_bytes(s, operands, 8 * count) ?? return None
    words := [Int]{}
    loop index in 0..<count -> words.push(x64_comptime_word(bytes, 8 * index))
    if kind == X64_COMPTIME_HOST_MISSING {
        symbol: jet_eval_ir_text(s, words[0]) ?? return None
        jet_eval_ir_unsupported(s, "IR runtime route `{symbol}`")
        return None
    }
    types_cell: jet_eval_ir_host_types(s) ?? return None
    row: jet_eval_native_answer_row(s, types_cell, words[0]) ?? return None
    args := [Int]{}
    loop index in 1..<count -> args.push(words[index])
    answer: if kind == {
        X64_COMPTIME_HOST_METHOD -> jet_eval_ir_host_method_route(s, args, row, result)
        X64_COMPTIME_HOST_FIELD -> jet_eval_ir_host_field_route(s, args, row, result)
        X64_COMPTIME_HOST_INPUT -> jet_eval_ir_comptime_input_route(s, args, row, result)
        X64_COMPTIME_HOST_CONSTANT -> jet_eval_ir_host_constant_route(s, args, row, result)
        X64_COMPTIME_HOST_LITERAL -> jet_eval_ir_host_literal_route(s, args, row, result)
        X64_COMPTIME_HOST_TRACE -> jet_eval_ir_debug_trace_route(s, args)
        else -> jet_eval_ir_primitive_shape(s, "jet_comptime_host")
    } ?? return None
    reads: types_cell.guard_read()
    ty: reads.value.types[row]
    if ty.kind == .Float || ty.kind == .Float32 {
        if result == 0 {
            jet_eval_ir_problem(s, "a Float host answer has no result cell")
            return None
        }
        if !jet_eval_ir_write(s, result, jet_eval_ir_width(ty), answer) -> return None
        return Val(result)
    }
    if ty.kind == .Aggregate && result != 0 && answer != result {
        moved: jet_eval_ir_bytes(s, answer, ty.size) ?? return None
        if !jet_eval_native_put(s, result, moved) -> return None
        return Val(result)
    }
    Val(answer)
}

// The type row whose intern key is the String at `key`.
jet_eval_native_answer_row: fn(s: ^JetEvalIRState, types_cell: Shared<IRModule>, key: Int) -> Int? {
    reads: types_cell.guard_read()
    jet_eval_ir_host_row(reads.value, s, key)
}

// A host route called with operands it doesn't take: a compiler defect.
jet_eval_ir_primitive_shape: fn(s: ^JetEvalIRState, name: String) -> Int? Never! {
    jet_eval_ir_problem(s, "host primitive {name} called with the wrong operands")
    None
}

// `debug(value)` in compile-time code (JetIR THostCall.DebugTrace): its one
// operand is the trace line's String, which the compiler prints while
// compiling (JetEvalIRResult.debug_trace), so it is no output of the
// evaluated code's own.
jet_eval_ir_debug_trace_route: fn(s: ^JetEvalIRState, args: [Int]) -> Int? {
    if args.len() != 1 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_debug_trace")
    line: jet_eval_ir_text(s, args[0]) ?? return None
    s.debug_trace = "{s.debug_trace}{line}\n"
    Val(0)
}

// jet_comptime_input(builtin, path): the value the compiler's comptime input
// host reads and records for the path's String, a checked literal or the
// value the comptime code computed, as the IR value of type row `dst_row`.
// `net.fetch(url, sha256:)` takes the route as ("fetch", url, sha256): the
// host fetches the URL and checks its content against the pin. A `build: fn`
// runs as runtime code with the build file's input host installed, so it
// reads through the same host. A running program has no input host: there
// the route is E0956, as check-time refuses a runtime path to the input.
jet_eval_ir_comptime_input_route: fn(s: ^JetEvalIRState, args: [Int], dst_row: Int, result: Int{0}) -> Int? {
    if args.len() != 2 && args.len() != 3 {
        return jet_eval_ir_primitive_shape(s, "jet_comptime_input")
    }
    builtin: jet_eval_ir_text(s, args[0]) ?? return None
    path: jet_eval_ir_text(s, args[1]) ?? return None
    pin := String?{None}
    if args.len() == 3 -> pin = Val(jet_eval_ir_text(s, args[2]) ?? return None)
    adapter: if s.inputs == {
        .Val(installed) -> installed.clone_input_adapter()
        .None -> {
            if s.failure == None {
                s.failure = Val(jet_eval_ir_comptime_input_without_host(s.runtime_execution, s.span, builtin, path))
            }
            return None
        }
    }
    value: if jet_eval_ir_comptime_input_read(adapter, builtin, path, pin, s.span) == {
        .Ok(read) -> read
        .Err(error) -> {
            if s.failure == None {
                s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: error.diagnostic})
            }
            return None
        }
    }
    jet_eval_ir_store_data(s, value, dst_row, result)
}

// The report for a comptime input read where no input host is installed:
// E0956 in a running program (check-time refuses that path, so this is the
// net under a program that skipped it), E3401 in a compile that has no host.
jet_eval_ir_comptime_input_without_host: fn(runtime_execution: Bool, span: Span, builtin: String, path: String) -> JetEvalError {
    shown: if builtin == "fetch" -> "net.fetch" else -> builtin
    if runtime_execution {
        return jet_eval_diagnostic(JetEvalErrorKind.Source, span, "a running program can't call `{shown}`", "`{shown}` reads a compile-time input, which only comptime code and `build: fn` read", "call `{shown}` in a `#run` item and use its value in the program")
    }
    jet_eval_diagnostic(JetEvalErrorKind.Effect, span, "`{shown}` can't read files here", "this compile has no comptime input host, so it can't read `{path}`", "build the program with `jet build` or `jet run`, which read comptime inputs")
}

// The comptime input host's answer for one route: the pinned fetch of the
// URL `path` when `pin` is present, otherwise the read `builtin` names.
jet_eval_ir_comptime_input_read: fn(adapter: JetEvalComptimeInputAdapter, builtin: String, path: String, pin: String?, span: Span) -[FS.Read, Net, Time.Wait]> TComptimeValue JetEvalComptimeInputError! {
    if pin == .Val(sha256) -> return adapter.comptime_fetch(path, sha256, span)
    adapter.comptime_input(builtin, path, span)
}

// The IR word of compile-time data of type row `row`, for the shapes a
// comptime input produces: a String, the bytes of a [U8], a [String]. Texts
// and buffers are the runtime's own, so the program owns and drops them as
// any other.
jet_eval_ir_store_data: fn(s: ^JetEvalIRState, value: TComptimeValue, row: Int, target: Int{0}) -> Int? {
    if value == {
        .String(text) -> return jet_eval_ir_store_text(s, text)
        .Bytes(bytes) -> {
            data := 0
            if bytes.len() > 0 {
                data = jet_eval_native_alloc(s, bytes.len(), 1) ?? return None
                if !jet_eval_native_put(s, data, bytes) -> return None
            }
            return jet_eval_ir_list_header(s, data, bytes.len(), target)
        }
        .List(values) -> {
            words := [U8]{}
            loop item in values {
                if {
                    item == .String(text) -> {
                        word: jet_eval_ir_store_text(s, text) ?? return None
                        x64_comptime_put_word(words, word)
                    }
                    else -> {
                        jet_eval_ir_unsupported(s, "a comptime input list of {item}")
                        return None
                    }
                }
            }
            data := 0
            if values.len() > 0 {
                data = jet_eval_native_alloc(s, words.len(), 8) ?? return None
                if !jet_eval_native_put(s, data, words) -> return None
            }
            return jet_eval_ir_list_header(s, data, values.len(), target)
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .BigInt(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Function(_) -> {}
    }
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    reads: types_cell.guard_read()
    layouts: layouts_cell.guard_read()
    jet_eval_ir_unsupported(s, "writing comptime data {value} as an IR value of {ir_row_ty(reads.value, layouts.value[0], row)}")
    None
}

// A List header {len, cap, data} in `target` (or fresh storage when 0).
jet_eval_ir_list_header: fn(s: ^JetEvalIRState, data: Int, length: Int, target: Int{0}) -> Int? {
    header: if target != 0 -> target else -> jet_eval_native_alloc(s, 24, 8) ?? return None
    words := [U8]{}
    x64_comptime_put_word(words, length)
    x64_comptime_put_word(words, length)
    x64_comptime_put_word(words, data)
    if !jet_eval_native_put(s, header, words) -> return None
    Val(header)
}

// A runtime String of `text`'s bytes.
jet_eval_ir_store_text: fn(s: ^JetEvalIRState, text: String) -> Int? {
    bytes: text.bytes()
    if s.child.shm_ready && bytes.len() <= X64_COMPTIME_SHM_SIZE - 8 {
        jet_eval_native_forget(s)
        if x64_comptime_shm_text(s.child, bytes) == .Val(word) -> return Val(word)
        jet_eval_native_lost(s, "SHM_TEXT")
        return None
    }
    jet_eval_native_ask(s, X64_COMPTIME_TEXT, [Int]{bytes.len()}, bytes)
}

// An Int word: inline, or a runtime node built from its decimal text.
jet_eval_ir_host_int: fn(s: ^JetEvalIRState, number: Int) -> Int? {
    if jet_eval_ir_inline(number) -> return Val(number)
    decimal: "{number}".bytes()
    jet_eval_native_ask(s, X64_COMPTIME_INT, [Int]{decimal.len()}, decimal)
}

// A runtime box of `bytes` bytes (the builder's ir_box_alloc).
jet_eval_ir_host_alloc: fn(s: ^JetEvalIRState, bytes: Int) -> Int? {
    jet_eval_native_alloc(s, ir_align8(bytes), 8)
}

// ---------------------------------------------------------------------------
// The child's memory.

// Sends a command; the pages read before it may change, so they go.
jet_eval_native_command: fn(s: ^JetEvalIRState, kind: Int, operands: [Int], payload: [U8]) -> Bool {
    jet_eval_native_forget(s)
    x64_comptime_send(s.child, x64_comptime_frame(kind, operands), payload)
}

// Opens the child's admission of file calls while the code it runs is an
// `#Impure` item or block whose package holds `Meta.Host`, and closes it
// otherwise: an admitted file call runs natively, as the same call does at
// run time. Sema checked the block's authority, so a denied effect never
// reaches the child. False once the child is gone.
jet_eval_native_admit: fn(s: ^JetEvalIRState) -> Bool {
    x64_comptime_admit(s.child, open: s.host_held && !s.eval_entry && (s.impure || s.impure_sites > 0))
}

jet_eval_native_forget: fn(s: ^JetEvalIRState) {
    if s.pages.len() == 0 {
        return
    }
    s.pages = [[U8]]{}
    s.page_rows = [Int:Int]{}
    s.last_page = -1
    s.last_page_row = -1
}

// Command `kind`'s DONE word.
jet_eval_native_ask: fn(s: ^JetEvalIRState, kind: Int, operands: [Int], payload: [U8]) -> Int? {
    if !jet_eval_native_command(s, kind, operands, payload) {
        jet_eval_native_lost(s, "command {kind}")
        return None
    }
    reply: x64_comptime_receive(s.child) ?? {
        jet_eval_native_lost(s, "command {kind}")
        return None
    }
    if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
        x64_comptime_reap(s.child, true)
        jet_eval_ir_problem(s, "the comptime child answered command {kind} with frame {x64_comptime_word(reply, 0)}")
        return None
    }
    Val(x64_comptime_word(reply, 8))
}

// The child ended while the compiler worked on its memory.
jet_eval_native_lost: fn(s: ^JetEvalIRState, during: String) {
    report: String.from_bytes_lossy(s.child.stderr).trim()
    detail: if report == "" -> "" else -> ": {report}"
    status: s.child.status
    jet_eval_ir_problem(s, "the comptime child ended during {during} (status {status}){detail}")
}

// `size` bytes of the child's runtime heap, aligned to `align`.
jet_eval_native_alloc: fn(s: ^JetEvalIRState, size: Int, align: Int) -> Int? {
    jet_eval_native_ask(s, X64_COMPTIME_ALLOC, [Int]{if size < 8 -> 8 else -> size, align}, [U8]{})
}

// Whether `count` bytes from `pointer` may be child memory.
jet_eval_native_address: fn(s: ^JetEvalIRState, pointer: Int, count: Int) -> Bool Never! {
    if pointer > 0 && count <= JET_EVAL_NATIVE_READ_MAX && pointer + count <= JET_EVAL_NATIVE_USER_END {
        return true
    }
    jet_eval_ir_problem(s, if pointer == 0 -> "the compiler read the child's memory through a null pointer" else -> "the compiler read the child's memory through a word that is not an address")
    false
}

// The row of the page at `page` in the read pages, read now if it isn't.
jet_eval_native_page: fn(s: ^JetEvalIRState, page: Int) -> Int? {
    if s.last_page == page -> return Val(s.last_page_row)
    found: s.page_rows.get(page) ?? -1
    if found >= 0 {
        s.last_page = page
        s.last_page_row = found
        return Val(found)
    }
    bytes: x64_comptime_read_memory(s.child, page, JET_EVAL_NATIVE_PAGE) ?? {
        jet_eval_native_unreadable(s, page)
        return None
    }
    row: s.pages.len()
    s.pages.push(bytes)
    s.page_rows[page] = row
    s.last_page = page
    s.last_page_row = row
    Val(row)
}

// A READ the child died on: the page is not its memory.
jet_eval_native_unreadable: fn(s: ^JetEvalIRState, page: Int) {
    jet_eval_ir_problem(s, "the compiler read the child's memory through a word that is not an address (page {page})")
}

// The bytes at `pointer`.
jet_eval_ir_bytes: fn(s: ^JetEvalIRState, pointer: Int, count: Int) -> [U8]? {
    bytes := [U8]{}
    if count <= 0 -> return Val(bytes)
    if !jet_eval_native_address(s, pointer, count) -> return None
    if count > 64 && s.child.vm_read_ok {
        got: x64_comptime_read_memory(s.child, pointer, count) ?? {
            jet_eval_native_unreadable(s, pointer - pointer % JET_EVAL_NATIVE_PAGE)
            return None
        }
        return Val(got)
    }
    at := pointer
    end: pointer + count
    loop at < end {
        page: at - at % JET_EVAL_NATIVE_PAGE
        row: jet_eval_native_page(s, page) ?? return None
        stop: if end < page + JET_EVAL_NATIVE_PAGE -> end else -> page + JET_EVAL_NATIVE_PAGE
        bytes.extend(s.pages[row][(at - page)..<(stop - page)])
        at = stop
    }
    Val(bytes)
}

// The unsigned little-endian value of `width` bytes at `pointer`.
jet_eval_ir_read: fn(s: ^JetEvalIRState, pointer: Int, width: Int) -> Int? {
    jet_eval_ir_read_as(s, pointer, width, false)
}

// The signed 64-bit word at `pointer`.
jet_eval_ir_read_word: fn(s: ^JetEvalIRState, pointer: Int) -> Int? {
    jet_eval_ir_read_as(s, pointer, 8, true)
}

// The little-endian value of `width` bytes at `pointer`: two's complement
// when `signed`, else unsigned. Every word of a value read back passes here,
// so a read within one page takes its bytes from the page in place.
jet_eval_ir_read_as: fn(s: ^JetEvalIRState, pointer: Int, width: Int, signed: Bool) -> Int? {
    if width <= 0 -> return Val(0)
    if !jet_eval_native_address(s, pointer, width) -> return None
    page: pointer - pointer % JET_EVAL_NATIVE_PAGE
    if pointer + width > page + JET_EVAL_NATIVE_PAGE {
        bytes: jet_eval_ir_bytes(s, pointer, width) ?? return None
        return Val(jet_eval_ir_bytes_value(bytes, 0, width, signed))
    }
    row: jet_eval_native_page(s, page) ?? return None
    Val(jet_eval_ir_bytes_value(s.pages[row], pointer - page, width, signed))
}

// The little-endian value of `bytes[at..<at + width]`, accumulated from the
// top byte down; a signed top byte starts it negative, so a signed word stays
// in the 64-bit range throughout.
jet_eval_ir_bytes_value: fn(bytes: [U8], at: Int, width: Int, signed: Bool) -> Int Never! {
    if width == 8 {
        top := Int{bytes[at + 7]}
        if signed && top >= 128 -> top -= 256
        hi: (top << 24) + (Int{bytes[at + 6]} << 16) + (Int{bytes[at + 5]} << 8) + Int{bytes[at + 4]}
        lo: (Int{bytes[at + 3]} << 24) + (Int{bytes[at + 2]} << 16) + (Int{bytes[at + 1]} << 8) + Int{bytes[at]}
        return (hi << 32) + lo
    }
    value := Int{bytes[at + width - 1]}
    if signed && value >= 128 -> value -= 256
    index := width - 2
    loop index >= 0 {
        value = value * 256 + Int{bytes[at + index]}
        index -= 1
    }
    value
}

// Writes `bytes` at `pointer` in the child.
jet_eval_native_put: fn(s: ^JetEvalIRState, pointer: Int, bytes: [U8]) -> Bool {
    if bytes.len() == 0 -> return true
    if !jet_eval_native_address(s, pointer, bytes.len()) -> return false
    if bytes.len() >= 4096 && s.child.shm_ready && bytes.len() <= X64_COMPTIME_SHM_SIZE - 8 {
        jet_eval_native_forget(s)
        if x64_comptime_shm_write(s.child, pointer, bytes) -> return true
        jet_eval_native_lost(s, "a write of its memory")
        return false
    }
    if jet_eval_native_command(s, X64_COMPTIME_WRITE, [Int]{pointer, bytes.len()}, bytes) {
        return true
    }
    jet_eval_native_lost(s, "a write of its memory")
    false
}

jet_eval_ir_write: fn(s: ^JetEvalIRState, pointer: Int, width: Int, value: Int) -> Bool {
    bytes := [U8]{}
    bits := if value < 0 -> value + 18446744073709551616 else -> value
    loop _ in 0..<width {
        bytes.push(U8{bits & 255})
        bits = bits >> 8
    }
    jet_eval_native_put(s, pointer, bytes)
}

// The text of the String whose header is at `header`.
jet_eval_ir_text: fn(s: ^JetEvalIRState, header: Int) -> String? {
    data: jet_eval_ir_read_word(s, header) ?? return None
    length: jet_eval_ir_read_word(s, header + 8) ?? return None
    bytes: jet_eval_ir_bytes(s, data, length) ?? return None
    Val(String.from_bytes_lossy(bytes))
}

// ---------------------------------------------------------------------------
// Failures.

jet_eval_ir_failed: fn(s: JetEvalIRState) -> Bool Never! {
    s.failure != None || s.internal_problem != None || s.exit_code != None
}

// A compiler defect met while running compile-time code natively: there is
// no interpreter, and the IR in these names is the JetIR program the child
// runs. Each caller names the native run around the message (#6725), so it
// carries no prefix of its own.
jet_eval_ir_problem: fn(s: ^JetEvalIRState, message: String) Never! {
    if s.internal_problem == None {
        s.internal_problem = Val(JetEvalInternalProblem{span: Val(s.span), message: message})
    }
}

jet_eval_ir_source_fail: fn(s: ^JetEvalIRState, what: String) Never! {
    if s.failure == None {
        s.failure = Val(jet_eval_source_error(s.runtime_execution, s.span, what))
    }
}

jet_eval_ir_unsupported: fn(s: ^JetEvalIRState, operation: String) Never! {
    if s.failure == None {
        s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Unsupported, s.span, "compile-time evaluation does not implement `{operation}`", "this operation has no compiler-time evaluator yet", "do not treat the incomplete evaluation as successful"))
    }
}

// E1020: the value read back is a function that running code made (a
// closure, or a function a call returned), shown as `shown`.
jet_eval_ir_function_value_refused: fn(s: ^JetEvalIRState, shown: String) Never! {
    if s.failure == None {
        row: diagnostic_registry_row_of("E1020")
        s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Unsupported, diagnostic: diagnostic_from_registry("E1020", Val(s.span), row.what.replace("{{type}}", shown), row.why, row.fix)})
    }
}

jet_eval_ir_out_of_fuel: fn(s: ^JetEvalIRState) -> Int? Never! {
    if s.failure == None {
        s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Fuel, s.span, "compile-time code ran past its step limit of {s.step_limit} steps", "compile-time code runs under a step limit, 10000000 steps unless its binding sets another, so a runaway loop can't stall the build", "split the work so it fits; a binding computed while building raises its own limit above {s.step_limit} with `#StepLimit(n)`"))
    }
    None
}

// ---------------------------------------------------------------------------
// Words.

jet_eval_ir_pow2: fn(bits: Int) -> Int Never! { 1 << bits }

// `value` reduced to the fixed-width integer of `bits` (two's complement),
// sign-extended when `signed`.
jet_eval_ir_wrap: fn(value: Int, bits: Int, signed: Bool) -> Int Never! {
    modulus: jet_eval_ir_pow2(bits)
    low: value & modulus - 1
    if signed && low >= modulus /% 2 -> return low - modulus
    low
}

jet_eval_ir_in_range: fn(value: Int, bits: Int, signed: Bool) -> Bool Never! {
    if signed {
        half: jet_eval_ir_pow2(bits - 1)
        return value >= 0 - half && value < half
    }
    value >= 0 && value < jet_eval_ir_pow2(bits)
}

jet_eval_ir_inline: fn(word: Int) -> Bool Never! {
    word >= JET_EVAL_IR_INLINE_MIN && word <= JET_EVAL_IR_INLINE_MAX
}

// The exact integer an Int word holds: inline, or its runtime node's u32
// base-1e9 limbs (Int.jet: negative@16, limbs@24, len@32).
jet_eval_ir_int_value: fn(s: ^JetEvalIRState, word: Int) -> Int? {
    if jet_eval_ir_inline(word) -> return Val(word)
    node: word & JET_EVAL_IR_INLINE_MAX
    negative: jet_eval_ir_read(s, node + 16, 8) ?? return None
    limbs: jet_eval_ir_read(s, node + 24, 8) ?? return None
    length: jet_eval_ir_read(s, node + 32, 8) ?? return None
    digits: jet_eval_ir_bytes(s, limbs, 4 * length) ?? return None
    value := 0
    at := length - 1
    loop at >= 0 {
        limb: Int{digits[4 * at]} + (Int{digits[4 * at + 1]} << 8) + (Int{digits[4 * at + 2]} << 16) + (Int{digits[4 * at + 3]} << 24)
        value = value * 1000000000 + limb
        at -= 1
    }
    Val(if negative != 0 -> 0 - value else -> value)
}

jet_eval_ir_float: fn(word: Int) -> Float Never! { math.from_bits(word) }

// The Float of binary32 `bits` (exact: every binary32 is a binary64). A NaN
// keeps its sign, quiet bit and payload, the fraction 29 bits up, so a
// signaling NaN folded at compile time reads back with the same bits
// (ir_float_constant_bits).
jet_eval_ir_float32: fn(bits: Int) -> Float Never! {
    sign: bits & 2147483648 != 0
    exponent: (bits >> 23) & 255
    fraction: bits & 8388607
    magnitude := math.from_bits(0)
    if {
        exponent == 255 -> {
            if fraction != 0 {
                nan: 9218868437227405312 | fraction << 29
                return math.from_bits(if sign -> nan - 9223372036854775807 - 1 else -> nan)
            }
            magnitude = math.from_bits(9218868437227405312)
        }
        exponent == 0 -> {
            // Subnormal: fraction * 2^-149.
            magnitude = Float.from_int(fraction) * math.from_bits(3936146074321813504)
        }
        else -> {
            wide: (exponent - 127 + 1023) << 52
            magnitude = math.from_bits(wide | fraction << 29)
        }
    }
    if sign -> return -magnitude
    magnitude
}

// Bytes a value of `ty` occupies in memory (IR Load/Store).
jet_eval_ir_width: fn(ty: IRType) -> Int Never! {
    if ty.kind == {
        .Unit -> 0
        .Bool -> 1
        .Float32 -> 4
        .Word -> if ty.size == 1 || ty.size == 2 || ty.size == 4 -> ty.size else -> 8
        .Int | .Float | .Char | .String | .Pointer | .Aggregate -> 8
    }
}

// The canonical word of the `width` bytes of `ty` at `pointer`: a signed
// kind's sign-extended, any other's unsigned.
jet_eval_ir_load: fn(s: ^JetEvalIRState, ty: IRType, pointer: Int, width: Int) -> Int? {
    signed: ty.kind == .Int || ty.kind == .Float || (ty.kind == .Word && ty.signed)
    jet_eval_ir_read_as(s, pointer, width, signed)
}
