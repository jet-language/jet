// The slot IR interpreter: compile-time evaluation runs the same IR the
// machine code is selected from (Compiler/JetIR/Source/IR.jet), so comptime
// and run time share one meaning. Two modules run side by side: the
// evaluated item's (unit 0) and the runtime pack's own (unit 1: runtime.ir,
// the O1 module the runtime object is compiled from; JetIR Codec.jet). Every
// runtime route is the runtime's code; only the host primitives beneath it
// (`#FFI(asm)` leaves and Linux system calls) and the stops are the
// machine's (Runtime.jet).
//
// Words. A slot holds one machine word, as the x86-64 selection keeps it:
// an exact Int is inline (bits 63 and 62 agree) or its runtime node's
// address tagged with bit 62 (Int.jet); a fixed-width integer its sign- or
// zero-extended value; a Float its IEEE bits (signed), a Float32 its 32
// bits; a Bool 0/1; a String the address of its [data, len, cap] header
// (Text.jet). A memory address is `region << 32 | offset` (region 0 is
// null). A function address is a handle (JET_EVAL_IR_FUNCTION_TAG + unit *
// JET_EVAL_IR_UNIT + function), never an address, so a Load through it is
// an internal problem, never silent garbage.
use core.math as math
use jet_foundation.[Span, TComptimeValue]
use jet_ir.[
    IRFunction,
    IRModule,
    IRProgram,
    IROp,
    IRType,
    IRTypeKind,
    IR_OVERFLOW_WRAP,
    ir_box_share,
    ir_float_constant_bits,
]

JET_EVAL_IR_REGION :: 4294967296
JET_EVAL_IR_FUNCTION_TAG :: 2305843009213693952
JET_EVAL_IR_UNIT :: 4294967296
JET_EVAL_IR_INT_TAG :: 4611686018427387904
JET_EVAL_IR_INLINE_MIN :: -4611686018427387904
JET_EVAL_IR_INLINE_MAX :: 4611686018427387903
// The stack pointer os_stack_address_i64 reads: a band no region reaches.
JET_EVAL_IR_STACK :: 1152921504606781440
// Runtime-module steps per unit of fuel: a runtime route is many IR steps
// where the item's own code is one.
JET_EVAL_IR_RUNTIME_FUEL :: 64

// One module's state beside its read-only code: `data_regions[row]` the
// address of data row `row`, `data_texts[row]` the String header a
// ConstText of it reads (0 until first used), `statics` the address of a
// name row's bytes (a ConstBigInt decimal), `routes` the resolved target of
// a CallRuntime name row (Runtime.jet jet_eval_ir_resolve), `prims[f]` the
// host primitive function f is (0: none); `targets[f]`, `frames[f]` and
// `frame_sizes[f]` function f's branch targets and frame layout (built on
// its first call, `ready[f]`).
struct JetEvalIRUnit {
    data_regions: [Int]
    data_texts: [Int]
    statics: [Int:Int]
    routes: [Int:Int]
    prims: [Int]
    targets: [[Int]]
    frames: [[Int]]
    frame_sizes: [Int]
    ready: [Bool]
}

// The interpreter's mutable state; the modules are read-only beside it.
// `regions[r]` is the bytes of region r (0 unused), `live[r]` whether it may
// still be read, `spare` released regions a new mapping reuses. `runtime`
// is 0 before the runtime unit starts, 1 once its init hooks ran, 2 when it
// can't run; `hooks` is set while they run. `gs_base` is the GS base
// arch_prctl set (Thread.jet's TCB).
struct JetEvalIRState {
    regions: [[U8]]
    live: [Bool]
    spare: [Int]
    units: [JetEvalIRUnit]
    runtime: Int
    hooks: Bool
    sources: [String:Int]
    gs_base: Int
    stdout: String
    stderr: String
    steps: Int
    fuel: Int
    runtime_steps: Int
    runtime_fuel: Int
    depth: Int
    max_depth: Int
    runtime_execution: Bool
    // config.eval_entry: ambient effects are refused as `jet eval` refuses them.
    eval_entry: Bool
    span: Span
    failure: JetEvalError?
    internal_problem: JetEvalInternalProblem?
    exit_code: Int?
    // The compiler's answer to `embed_file` / `embed_bytes` / `find`.
    inputs: JetEvalComptimeInputAdapter?
    // A build or dev invocation's host (Host.jet): the type rows and
    // layouts its values are read and written by, its build host, and the
    // compiler values its code holds (a host word is index + 1).
    host_types: Shared<IRModule>?{None}
    host_layouts: Shared<IRProgram>?{None}
    host_adapter: JetEvalBuildHostAdapter?{None}
    host_values: [TComptimeValue]{[TComptimeValue]{}}
}

fn jet_eval_ir_state_new(m: IRModule, config: JetEvalConfig, span: Span) -> JetEvalIRState Never! {
    s := JetEvalIRState{
        regions: [[U8]]{[U8]{}}, live: [Bool]{false}, spare: [Int]{}, units: [JetEvalIRUnit]{}, runtime: 0, hooks: false, sources: [String:Int]{}, gs_base: 0,
        stdout: "", stderr: "", steps: 0, fuel: config.fuel, runtime_steps: 0, runtime_fuel: config.fuel * JET_EVAL_IR_RUNTIME_FUEL,
        depth: 0, max_depth: config.max_call_depth, runtime_execution: config.runtime_execution, eval_entry: config.eval_entry, span: span, failure: None, internal_problem: None, exit_code: None,
        inputs: if config.comptime_input_adapter == .Val(adapter) -> Val(adapter.clone_input_adapter()) else -> None,
    }
    jet_eval_ir_unit_open(m, &s, jet_eval_ir_module_primitives(m, [String:Int]{}))
    s
}

// Opens the next unit over module `code`: its data rows copied into regions
// and their static address words (JetIR BuildStatic.jet) resolved.
fn jet_eval_ir_unit_open(code: IRModule, s: &JetEvalIRState, prims: [Int]) Never! {
    unit := JetEvalIRUnit{data_regions: [Int]{}, data_texts: [Int]{}, statics: [Int:Int]{}, routes: [Int:Int]{}, prims: prims, targets: [[Int]]{}, frames: [[Int]]{}, frame_sizes: [Int]{}, ready: [Bool]{}}
    loop row in code.data {
        &unit.data_regions.push(jet_eval_ir_region_new(&s, row.copy()))
        &unit.data_texts.push(0)
    }
    loop _ in code.functions {
        &unit.targets.push([Int]{})
        &unit.frames.push([Int]{})
        &unit.frame_sizes.push(0)
        &unit.ready.push(false)
    }
    index :: s.units.len()
    &s.units.push(unit)
    loop row in 0..<code.data.len() {
        relocs :: code.data_relocs.get(row) ?? next
        loop reloc in relocs {
            if reloc.target < 0 || reloc.target >= code.data.len() -> next
            word :: if reloc.text -> jet_eval_ir_data_text(code, &s, index, reloc.target) else -> s.units[index].data_regions[reloc.target] + reloc.addend
            at :: s.units[index].data_regions[row] + reloc.offset
            _ := jet_eval_ir_write(&s, at, 8, word)
        }
    }
}

// The immortal String header of data row `row` of `unit` (X64Module.jet's
// text header): [data, len, cap 0], built on first use.
fn jet_eval_ir_data_text(code: IRModule, s: &JetEvalIRState, unit: Int, row: Int) -> Int Never! {
    existing :: s.units[unit].data_texts[row]
    if existing != 0 -> return existing
    header :: jet_eval_ir_region_new(&s, jet_eval_ir_zeroes(24))
    text :: s.units[unit].data_regions[row]
    _ := jet_eval_ir_write(&s, header, 8, text)
    _ := jet_eval_ir_write(&s, header + 8, 8, code.data[row].len())
    s.units[unit].data_texts[row] = header
    header
}

// The address of name row `row`'s bytes in static storage.
fn jet_eval_ir_name_bytes(code: IRModule, s: &JetEvalIRState, unit: Int, row: Int) -> Int Never! {
    if s.units[unit].statics.get(row) == .Val(address) -> return address
    address :: jet_eval_ir_region_new(&s, code.names[row].bytes())
    s.units[unit].statics[row] = address
    address
}

// The address of `text`'s bytes in static storage (a source path a located
// runtime route reports).
fn jet_eval_ir_text_bytes(s: &JetEvalIRState, text: String) -> Int Never! {
    if s.sources.get(text) == .Val(address) -> return address
    address :: jet_eval_ir_region_new(&s, text.bytes())
    s.sources[text.copy()] = address
    address
}

fn jet_eval_ir_failed(s: JetEvalIRState) -> Bool Never! { s.failure != None || s.internal_problem != None || s.exit_code != None }

fn jet_eval_ir_problem(s: &JetEvalIRState, message: String) Never! {
    if s.internal_problem == None -> s.internal_problem = Val(JetEvalInternalProblem{span: Val(s.span), message: "IR evaluation: {message}"})
}

fn jet_eval_ir_source_fail(s: &JetEvalIRState, what: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_source_error(s.runtime_execution, s.span, what))
}

fn jet_eval_ir_unsupported(s: &JetEvalIRState, operation: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Unsupported, s.span, "compile-time evaluation does not implement `{operation}`", "this operation has no compiler-time evaluator yet", "do not treat the incomplete evaluation as successful"))
}

// ---------------------------------------------------------------------------
// Words.

fn jet_eval_ir_pow2(bits: Int) -> Int Never! { 1 << bits }

// `value` reduced to the fixed-width integer of `bits` (two's complement),
// sign-extended when `signed`.
fn jet_eval_ir_wrap(value: Int, bits: Int, signed: Bool) -> Int Never! {
    modulus :: jet_eval_ir_pow2(bits)
    low :: value.bit_and(modulus - 1)
    if signed && low >= modulus /% 2 -> return low - modulus
    low
}

fn jet_eval_ir_word_bits(ty: IRType) -> Int Never! {
    if ty.kind == .Word && ty.bits > 0 && ty.bits < 64 -> return ty.bits
    64
}

fn jet_eval_ir_in_range(value: Int, bits: Int, signed: Bool) -> Bool Never! {
    if signed {
        half :: jet_eval_ir_pow2(bits - 1)
        return value >= 0 - half && value < half
    }
    value >= 0 && value < jet_eval_ir_pow2(bits)
}

fn jet_eval_ir_inline(word: Int) -> Bool Never! { word >= JET_EVAL_IR_INLINE_MIN && word <= JET_EVAL_IR_INLINE_MAX }

// The exact integer an Int word holds: inline, or its runtime node's u32
// base-1e9 limbs (Int.jet: negative@16, limbs@24, len@32).
fn jet_eval_ir_int_value(s: &JetEvalIRState, word: Int) -> Int? Never! {
    if jet_eval_ir_inline(word) -> return Val(word)
    node :: word.bit_and(JET_EVAL_IR_INLINE_MAX)
    negative :: jet_eval_ir_read(&s, node + 16, 8) ?? return None
    limbs :: jet_eval_ir_read(&s, node + 24, 8) ?? return None
    length :: jet_eval_ir_read(&s, node + 32, 8) ?? return None
    value := 0
    at := length - 1
    loop at >= 0 {
        limb :: jet_eval_ir_read(&s, limbs + 4 * at, 4) ?? return None
        value = value * 1000000000 + limb
        at -= 1
    }
    Val(if negative != 0 -> 0 - value else -> value)
}

fn jet_eval_ir_float(word: Int) -> Float Never! { math.from_bits(word) }

fn jet_eval_ir_float_word(value: Float) -> Int Never! { math.to_bits(value) }

// The Float of binary32 `bits` (exact: every binary32 is a binary64).
fn jet_eval_ir_float32(bits: Int) -> Float Never! {
    sign :: bits.bit_and(2147483648) != 0
    exponent :: (bits >> 23).bit_and(255)
    fraction :: bits.bit_and(8388607)
    magnitude := math.from_bits(0)
    if exponent == 255 {
        if fraction != 0 -> return math.from_bits(9221120237041090560)
        magnitude = math.from_bits(9218868437227405312)
    } else if exponent == 0 {
        // Subnormal: fraction * 2^-149.
        magnitude = Float.from_int(fraction) * math.from_bits(3936146074321813504)
    } else {
        wide :: (exponent - 127 + 1023) << 52
        magnitude = math.from_bits(wide.bit_or(fraction << 29))
    }
    if sign -> return -magnitude
    magnitude
}

// The binary32 bits of `value`, rounded once to nearest-even.
fn jet_eval_ir_float32_word(value: Float) -> Int Never! {
    ir_float_constant_bits(value, true)
}

// The word `raw` as a value of `ty` holds it in a register: a Bool its low
// byte's truth, a narrow integer its wrapped value.
fn jet_eval_ir_fit(ty: IRType, raw: Int) -> Int Never! {
    if ty.kind == .Bool -> return if raw.bit_and(255) != 0 -> 1 else -> 0
    if ty.kind == .Word && (ty.bits < 64 || !ty.signed) -> return jet_eval_ir_wrap(raw, jet_eval_ir_word_bits(ty), ty.signed)
    raw
}

// ---------------------------------------------------------------------------
// Memory.

fn jet_eval_ir_zeroes(size: Int) -> [U8] Never! {
    bytes := [U8]{}
    loop _ in 0..<(if size > 0 -> size else -> 0) -> &bytes.push(U8{0})
    bytes
}

// A fresh region holding `bytes`: a released one's number when one is spare.
fn jet_eval_ir_region_new(s: &JetEvalIRState, bytes: [U8]) -> Int Never! {
    if s.spare.len() > 0 {
        region :: &s.spare.pop() ?? 0
        s.regions[region] = bytes
        s.live[region] = true
        return region * JET_EVAL_IR_REGION
    }
    region :: s.regions.len()
    &s.regions.push(bytes)
    &s.live.push(true)
    region * JET_EVAL_IR_REGION
}

fn jet_eval_ir_alloc(s: &JetEvalIRState, size: Int) -> Int Never! { jet_eval_ir_region_new(&s, jet_eval_ir_zeroes(size)) }

// Releases the region `pointer` starts (a frame, an unmapped mapping).
fn jet_eval_ir_release(s: &JetEvalIRState, pointer: Int) Never! {
    region :: pointer /% JET_EVAL_IR_REGION
    if pointer <= 0 || pointer >= JET_EVAL_IR_FUNCTION_TAG || region >= s.regions.len() || !s.live[region] -> return
    if pointer != region * JET_EVAL_IR_REGION -> return
    s.live[region] = false
    s.regions[region] = [U8]{}
    &s.spare.push(region)
}

// The region of `pointer` when `width` bytes from it are readable.
fn jet_eval_ir_region(s: &JetEvalIRState, pointer: Int, width: Int) -> Int? Never! {
    if pointer <= 0 || pointer >= JET_EVAL_IR_FUNCTION_TAG {
        jet_eval_ir_problem(&s, if pointer == 0 -> "memory access through a null pointer" else -> "memory access through a word that is not an address")
        return None
    }
    region :: pointer /% JET_EVAL_IR_REGION
    offset :: pointer - region * JET_EVAL_IR_REGION
    if region >= s.regions.len() || !s.live[region] {
        jet_eval_ir_problem(&s, "memory access through a released address")
        return None
    }
    if offset + width > s.regions[region].len() {
        size :: s.regions[region].len()
        jet_eval_ir_problem(&s, "memory access of {width} bytes at offset {offset} past its {size}-byte storage")
        return None
    }
    Val(region)
}

// The unsigned little-endian value of `width` bytes at `pointer`.
fn jet_eval_ir_read(s: &JetEvalIRState, pointer: Int, width: Int) -> Int? Never! {
    region :: jet_eval_ir_region(&s, pointer, width) ?? return None
    offset :: pointer - region * JET_EVAL_IR_REGION
    value := 0
    index := width - 1
    loop index >= 0 {
        value = (value << 8).bit_or(Int.from_u8(s.regions[region][offset + index]))
        index -= 1
    }
    Val(value)
}

// The signed 64-bit word at `pointer`.
fn jet_eval_ir_read_word(s: &JetEvalIRState, pointer: Int) -> Int? Never! {
    raw :: jet_eval_ir_read(&s, pointer, 8) ?? return None
    Val(jet_eval_ir_wrap(raw, 64, true))
}

fn jet_eval_ir_write(s: &JetEvalIRState, pointer: Int, width: Int, value: Int) -> Bool Never! {
    region :: jet_eval_ir_region(&s, pointer, width) ?? return false
    offset :: pointer - region * JET_EVAL_IR_REGION
    loop index in 0..<width -> s.regions[region][offset + index] = U8{(value >> (8 * index)).bit_and(255)}
    true
}

// `count` bytes from `from` to `to`; overlapping ranges move as memmove does.
fn jet_eval_ir_move_bytes(s: &JetEvalIRState, to: Int, from: Int, count: Int) -> Bool Never! {
    if count <= 0 -> return true
    source :: jet_eval_ir_region(&s, from, count) ?? return false
    target :: jet_eval_ir_region(&s, to, count) ?? return false
    from_offset :: from - source * JET_EVAL_IR_REGION
    to_offset :: to - target * JET_EVAL_IR_REGION
    copied := [U8]{}
    loop index in 0..<count -> &copied.push(s.regions[source][from_offset + index])
    loop index in 0..<count -> s.regions[target][to_offset + index] = copied[index]
    true
}

// The bytes at `pointer`.
fn jet_eval_ir_bytes(s: &JetEvalIRState, pointer: Int, count: Int) -> [U8]? Never! {
    bytes := [U8]{}
    if count <= 0 -> return Val(bytes)
    region :: jet_eval_ir_region(&s, pointer, count) ?? return None
    offset :: pointer - region * JET_EVAL_IR_REGION
    loop index in 0..<count -> &bytes.push(s.regions[region][offset + index])
    Val(bytes)
}

// The text of the String whose header is at `header`.
fn jet_eval_ir_text(s: &JetEvalIRState, header: Int) -> String? Never! {
    data :: jet_eval_ir_read_word(&s, header) ?? return None
    length :: jet_eval_ir_read_word(&s, header + 8) ?? return None
    bytes :: jet_eval_ir_bytes(&s, data, length) ?? return None
    Val(String.from_bytes_lossy(bytes))
}

// Bytes a value of `ty` occupies in memory (IR Load/Store).
fn jet_eval_ir_width(ty: IRType) -> Int Never! {
    if ty.kind == {
        .Unit -> 0
        .Bool -> 1
        .Float32 -> 4
        .Word -> if ty.size == 1 || ty.size == 2 || ty.size == 4 -> ty.size else -> 8
        else -> 8
    }
}

// The canonical word of the unsigned `raw` loaded as `width` bytes of `ty`.
fn jet_eval_ir_canonical(ty: IRType, raw: Int, width: Int) -> Int Never! {
    signed :: ty.kind == .Int || ty.kind == .Float || (ty.kind == .Word && ty.signed)
    if !signed || width == 0 -> return raw
    jet_eval_ir_wrap(raw, 8 * width, true)
}

// ---------------------------------------------------------------------------
// Structured control and frames.

// The instruction a Br or BrIf at `at` continues at (a Loop's first body
// instruction, else the instruction after the construct's End), and the
// frame offset of each instruction's storage: a StackAddress area, or an
// aggregate call result's (-1 none).
fn jet_eval_ir_prepare(code: IRModule, s: &JetEvalIRState, unit: Int, id: Int) Never! {
    if s.units[unit].ready[id] -> return
    f :: code.functions[id]
    targets := [Int]{}
    frames := [Int]{}
    open := [Int]{}
    size := 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        target := -1
        if op == .Br || op == .BrIf {
            depth :: if op == .Br -> f.a[at] else -> f.b[at]
            row :: open.len() - 1 - depth
            if row >= 0 {
                opener :: open[row]
                target = if f.op[opener] == {
                    .Loop -> opener + 1
                    .If -> f.c[opener] + 1
                    else -> f.a[opener] + 1
                }
            }
        }
        &targets.push(target)
        need := -1
        align := 8
        if op == .StackAddress {
            need = if f.a[at] > 0 -> f.a[at] else -> 8
            if f.b[at] > 8 -> align = f.b[at]
        }
        if (op == .Call || op == .CallIndirect || op == .CallRuntime) && f.dst[at] >= 0 && code.types[f.slot_type[f.dst[at]]].kind == .Aggregate {
            need = code.types[f.slot_type[f.dst[at]]].size
            if need <= 0 -> need = 8
        }
        if need > 0 {
            size = (size + align - 1) /% align * align
            &frames.push(size)
            size += need
        } else {
            &frames.push(-1)
        }
        if op == .Block || op == .Loop || op == .If -> &open.push(at)
        if op == .End -> _ := &open.pop()
    }
    s.units[unit].targets[id] = targets
    s.units[unit].frames[id] = frames
    s.units[unit].frame_sizes[id] = size
    s.units[unit].ready[id] = true
}

// ---------------------------------------------------------------------------
// Calls.

// Runs function `id` of `unit` on `args` (one word per parameter). An
// Aggregate result's bytes go to `result_area`, which is the returned word.
fn jet_eval_ir_invoke(m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, unit: Int, id: Int, args: [Int], result_area: Int) -> Int? {
    if unit == 0 -> return jet_eval_ir_invoke_in(m, m, rt, &s, 0, id, args, result_area)
    jet_eval_ir_invoke_in(rt.code, m, rt, &s, 1, id, args, result_area)
}

fn jet_eval_ir_invoke_in(code: IRModule, m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, unit: Int, id: Int, args: [Int], result_area: Int) -> Int? {
    if id < 0 || id >= code.functions.len() {
        jet_eval_ir_problem(&s, "call of function {id}, which is not in the module")
        return None
    }
    prim :: s.units[unit].prims[id]
    if prim != 0 -> return jet_eval_ir_primitive(m, rt, &s, prim, code.functions[id].name, args, -1)
    if s.depth >= s.max_depth {
        limit :: s.max_depth
        jet_eval_ir_source_fail(&s, "compile-time call depth exceeds {limit}")
        return None
    }
    jet_eval_ir_prepare(code, &s, unit, id)
    f :: code.functions[id]
    if args.len() != f.param_count {
        jet_eval_ir_problem(&s, "{f.name} takes {f.param_count} arguments, the call passes {args.len()}")
        return None
    }
    slots := [Int]{}
    loop index in 0..<f.slot_type.len() -> &slots.push(if index < args.len() -> args[index] else -> 0)
    size :: s.units[unit].frame_sizes[id]
    frame :: if size > 0 -> jet_eval_ir_alloc(&s, size) else -> 0
    s.depth += 1
    returned := jet_eval_ir_exec(code, m, rt, &s, unit, id, &slots, frame, result_area)
    s.depth -= 1
    if frame != 0 -> jet_eval_ir_release(&s, frame)
    returned
}

// The function a handle word names, as (unit, function), or None.
fn jet_eval_ir_handle(s: &JetEvalIRState, word: Int) -> (unit: Int, id: Int)? Never! {
    index :: word - JET_EVAL_IR_FUNCTION_TAG
    unit :: index /% JET_EVAL_IR_UNIT
    if word < JET_EVAL_IR_FUNCTION_TAG || unit >= s.units.len() {
        jet_eval_ir_problem(&s, "indirect call through a word that is not a function address")
        return None
    }
    Val((unit: unit, id: index - unit * JET_EVAL_IR_UNIT))
}

fn jet_eval_ir_call_args(f: IRFunction, slots: [Int], at: Int) -> [Int] Never! {
    args := [Int]{}
    start :: f.b[at]
    loop index in start..<(start + f.c[at]) -> &args.push(slots[f.args[index]])
    args
}

fn jet_eval_ir_area(s: &JetEvalIRState, unit: Int, id: Int, frame: Int, at: Int) -> Int Never! {
    offset :: s.units[unit].frames[id][at]
    if offset < 0 -> return 0
    frame + offset
}

fn jet_eval_ir_exec(code: IRModule, m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, unit: Int, id: Int, slots: &[Int], frame: Int, result_area: Int) -> Int? {
    f :: code.functions[id]
    count :: f.op.len()
    ip := 0
    loop {
        if jet_eval_ir_failed(s) -> return None
        if ip >= count {
            jet_eval_ir_problem(&s, "{f.name} ran past its last instruction")
            return None
        }
        if unit == 0 {
            s.steps += 1
            if !s.runtime_execution && s.steps > s.fuel -> return jet_eval_ir_out_of_fuel(&s)
        } else {
            s.runtime_steps += 1
            if !s.runtime_execution && s.runtime_steps > s.runtime_fuel -> return jet_eval_ir_out_of_fuel(&s)
        }
        at :: ip
        ip += 1
        op :: f.op[at]
        dst :: f.dst[at]
        if op == {
            .Nop | .Block | .Loop | .End -> {}
            .Const -> {
                if dst >= 0 -> slots[dst] = jet_eval_ir_const(code.types[f.slot_type[dst]], f.a[at])
            }
            .ConstText -> {
                if f.a[at] < 0 || f.a[at] >= code.data.len() {
                    jet_eval_ir_problem(&s, "data row {f.a[at]} is not in the module")
                    return None
                }
                slots[dst] = jet_eval_ir_data_text(code, &s, unit, f.a[at])
            }
            .ConstBigInt -> {
                decimal :: jet_eval_ir_name_bytes(code, &s, unit, f.a[at])
                slots[dst] = jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_int_from_static", [Int]{decimal, code.names[f.a[at]].bytes().len()}) ?? return None
            }
            .Copy -> slots[dst] = jet_eval_ir_copy(code, m, rt, &s, f, slots[f.a[at]], f.a[at]) ?? return None
            .Move -> slots[dst] = slots[f.a[at]]
            .Drop -> {
                if !jet_eval_ir_drop(code, m, rt, &s, unit, f, slots[f.a[at]], f.a[at]) -> return None
            }
            .Close -> {
                _ := jet_eval_ir_route(code, m, rt, &s, unit, f.b[at], [Int]{slots[f.a[at]]}, -1, 0) ?? return None
            }
            .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> {
                ty :: code.types[f.slot_type[f.a[at]]]
                if ty.kind == .Int {
                    slots[dst] = jet_eval_ir_int_binary(m, rt, &s, op, slots[f.a[at]], slots[f.b[at]], f.source_file, f.code_line[at]) ?? return None
                } else if ty.kind == .String {
                    slots[dst] = jet_eval_ir_text_compare(m, rt, &s, op, slots[f.a[at]], slots[f.b[at]]) ?? return None
                } else {
                    slots[dst] = jet_eval_ir_binary(&s, op, ty, slots[f.a[at]], slots[f.b[at]], f.c[at]) ?? return None
                }
            }
            .Neg -> {
                ty :: code.types[f.slot_type[f.a[at]]]
                if ty.kind == .Int {
                    slots[dst] = jet_eval_ir_int_binary(m, rt, &s, IROp.Sub, 0, slots[f.a[at]], f.source_file, f.code_line[at]) ?? return None
                } else {
                    slots[dst] = jet_eval_ir_negate(&s, ty, slots[f.a[at]], f.c[at]) ?? return None
                }
            }
            .Not -> {
                ty :: code.types[f.slot_type[f.a[at]]]
                if ty.kind == .Int {
                    slots[dst] = jet_eval_ir_int_binary(m, rt, &s, IROp.BitXor, slots[f.a[at]], -1, f.source_file, f.code_line[at]) ?? return None
                } else {
                    slots[dst] = jet_eval_ir_not(&s, ty, slots[f.a[at]]) ?? return None
                }
            }
            .Convert -> slots[dst] = jet_eval_ir_convert(&s, code.types[f.slot_type[f.a[at]]], code.types[f.slot_type[dst]], slots[f.a[at]]) ?? return None
            .Concat -> slots[dst] = jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_string_concat", [Int]{slots[f.a[at]], slots[f.b[at]]}) ?? return None
            .Call -> {
                args :: jet_eval_ir_call_args(f, slots, at)
                area :: jet_eval_ir_area(&s, unit, id, frame, at)
                value :: jet_eval_ir_invoke(m, rt, &s, unit, f.a[at], args, area) ?? return None
                if dst >= 0 -> slots[dst] = value
            }
            .CallIndirect -> {
                target :: jet_eval_ir_handle(&s, slots[f.a[at]]) ?? return None
                args :: jet_eval_ir_call_args(f, slots, at)
                area :: jet_eval_ir_area(&s, unit, id, frame, at)
                value :: jet_eval_ir_invoke(m, rt, &s, target.unit, target.id, args, area) ?? return None
                if dst >= 0 -> slots[dst] = value
            }
            .CallRuntime -> {
                args :: jet_eval_ir_call_args(f, slots, at)
                row :: if dst >= 0 -> f.slot_type[dst] else -> -1
                area :: jet_eval_ir_area(&s, unit, id, frame, at)
                value :: jet_eval_ir_route(code, m, rt, &s, unit, f.a[at], args, row, area) ?? return None
                if dst >= 0 -> slots[dst] = jet_eval_ir_fit(code.types[row], value)
            }
            .FunctionAddress -> slots[dst] = JET_EVAL_IR_FUNCTION_TAG + unit * JET_EVAL_IR_UNIT + f.a[at]
            .DataAddress -> {
                if f.a[at] < 0 || f.a[at] >= code.data.len() {
                    jet_eval_ir_problem(&s, "data row {f.a[at]} is not in the module")
                    return None
                }
                slots[dst] = s.units[unit].data_regions[f.a[at]]
            }
            .Load -> {
                ty :: code.types[f.slot_type[dst]]
                width :: jet_eval_ir_width(ty)
                if width > 0 {
                    raw :: jet_eval_ir_read(&s, slots[f.a[at]] + f.b[at], width) ?? return None
                    slots[dst] = jet_eval_ir_canonical(ty, raw, width)
                }
            }
            .Store -> {
                ty :: code.types[f.slot_type[f.c[at]]]
                width :: jet_eval_ir_width(ty)
                if width > 0 && !jet_eval_ir_write(&s, slots[f.a[at]] + f.b[at], width, slots[f.c[at]]) -> return None
            }
            .StackAddress -> slots[dst] = jet_eval_ir_area(&s, unit, id, frame, at)
            .Offset -> slots[dst] = slots[f.a[at]] + f.b[at]
            .CopyBytes -> {
                if !jet_eval_ir_move_bytes(&s, slots[f.a[at]], slots[f.b[at]], f.c[at]) -> return None
            }
            .If -> {
                if slots[f.a[at]] == 0 -> ip = if f.b[at] >= 0 -> f.b[at] + 1 else -> f.c[at] + 1
            }
            .Else -> ip = f.a[at] + 1
            .Br -> ip = s.units[unit].targets[id][at]
            .BrIf -> {
                if slots[f.a[at]] != 0 -> ip = s.units[unit].targets[id][at]
            }
            .Return -> {
                if f.a[at] < 0 -> return Val(0)
                value :: slots[f.a[at]]
                if f.result >= 0 && code.types[f.result].kind == .Aggregate {
                    if result_area == 0 {
                        jet_eval_ir_problem(&s, "{f.name} returns an aggregate without result storage")
                        return None
                    }
                    if !jet_eval_ir_move_bytes(&s, result_area, value, code.types[f.result].size) -> return None
                    return Val(result_area)
                }
                return Val(value)
            }
            .Unreachable -> {
                jet_eval_ir_problem(&s, "{f.name} reached an unreachable instruction (line {f.code_line[at]})")
                return None
            }
        }
        if ip < 0 {
            jet_eval_ir_problem(&s, "{f.name}: branch at instruction {at} leaves the function")
            return None
        }
    }
}

fn jet_eval_ir_out_of_fuel(s: &JetEvalIRState) -> Int? Never! {
    if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Fuel, s.span, "compile-time evaluation exhausted its fuel", "compile-time evaluation is bounded to keep compilation finite", "increase the evaluator fuel or simplify the evaluated program"))
    None
}

// The word of a Const of type `ty`: an exact Int, a fixed-width integer, a
// Bool, a Char or Float bits, as the builder wrote it.
fn jet_eval_ir_const(ty: IRType, value: Int) -> Int Never! {
    if ty.kind == .Word -> return jet_eval_ir_wrap(value, jet_eval_ir_word_bits(ty), ty.signed)
    value
}

// ---------------------------------------------------------------------------
// Ownership, as the selection's transfer and drop (X64Select.jet
// ir_x64_transfer, ir_x64_drop).

// A Copy of slot `slot` holding `word`: a counted Int or String is cloned by
// the runtime; an aggregate (its address) and a shared box alias.
fn jet_eval_ir_copy(code: IRModule, m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, f: IRFunction, word: Int, slot: Int) -> Int? {
    ty :: code.types[f.slot_type[slot]]
    if ty.drop == "" || ty.kind == .Aggregate || ty.clone == ir_box_share() -> return Val(word)
    if ty.kind == .Int {
        if jet_eval_ir_inline(word) -> return Val(word)
        return jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_int_clone", [Int]{word})
    }
    if ty.kind == .String -> return jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_string_clone", [Int]{word})
    jet_eval_ir_problem(&s, "Copy of {ir_kind_text(ty.kind)} with drop {ty.drop} has no clone route")
    None
}

// A Drop of slot `slot` holding `word`: its type's drop routine, the
// module's own glue when it built one under that symbol, else the runtime's.
fn jet_eval_ir_drop(code: IRModule, m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, unit: Int, f: IRFunction, word: Int, slot: Int) -> Bool {
    ty :: code.types[f.slot_type[slot]]
    if ty.drop == "" -> return true
    if ty.kind == .Int && jet_eval_ir_inline(word) -> return true
    if code.function_rows.get(ty.drop) == .Val(glue) {
        _ := jet_eval_ir_invoke(m, rt, &s, unit, glue, [Int]{word}, 0) ?? return false
        return true
    }
    _ := jet_eval_ir_runtime_call(m, rt, &s, ty.drop, [Int]{word}) ?? return false
    true
}

// ---------------------------------------------------------------------------
// Arithmetic. The left operand's type row selects the meaning (IR.jet).

fn jet_eval_ir_bool(value: Bool) -> Int Never! { if value -> 1 else -> 0 }

fn jet_eval_ir_compare(op: IROp, order: Int) -> Int Never! {
    jet_eval_ir_bool(if op == {
        .Eq -> order == 0
        .Ne -> order != 0
        .Lt -> order < 0
        .Le -> order <= 0
        .Gt -> order > 0
        else -> order >= 0
    })
}

fn jet_eval_ir_is_compare(op: IROp) -> Bool Never! {
    op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge
}

fn jet_eval_ir_order(left: Int, right: Int) -> Int Never! {
    if left < right -> return -1
    if left > right -> return 1
    0
}

// Exact Int, as the selection: inline operands with an inline result take
// the fast path, everything else the runtime's jet_int_* kernel (Int.jet),
// located kernels with the instruction's source file and line.
fn jet_eval_ir_int_binary(m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, op: IROp, left: Int, right: Int, file: String, line: Int) -> Int? {
    inline :: jet_eval_ir_inline(left) && jet_eval_ir_inline(right)
    if jet_eval_ir_is_compare(op) {
        if inline -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(left, right)))
        order :: jet_eval_ir_runtime_call(m, rt, &s, "jet_int_compare", [Int]{left, right}) ?? return None
        return Val(jet_eval_ir_compare(op, jet_eval_ir_wrap(order, 64, true)))
    }
    located :: op == .Div || op == .Rem || op == .FloorDiv || op == .Mod || op == .Shl || op == .Shr
    if inline {
        if jet_eval_ir_exact_inline(op, left, right) == .Val(value) {
            if jet_eval_ir_inline(value) -> return Val(value)
        }
    }
    symbol :: if op == {
        .Add -> "jet_int_add"
        .Sub -> "jet_int_sub"
        .Mul -> "jet_int_mul"
        .Div -> "jet_int_div"
        .Rem -> "jet_int_rem"
        .FloorDiv -> "jet_int_floor_div"
        .Mod -> "jet_int_mod"
        .Shl -> "jet_int_shl"
        .Shr -> "jet_int_shr"
        .BitAnd -> "jet_int_bit_and"
        .BitOr -> "jet_int_bit_or"
        else -> "jet_int_bit_xor"
    }
    if !located -> return jet_eval_ir_runtime_call(m, rt, &s, symbol, [Int]{left, right})
    path :: jet_eval_ir_text_bytes(&s, file)
    jet_eval_ir_runtime_call(m, rt, &s, symbol, [Int]{left, right, path, file.bytes().len(), line})
}

// The exact result of an operator on two inline Ints, or None when the
// runtime kernel computes it: a zero divisor and a negative or wide shift
// count take the located route, which keeps their stops.
fn jet_eval_ir_exact_inline(op: IROp, a: Int, b: Int) -> Int? Never! {
    if (op == .Div || op == .Rem || op == .FloorDiv || op == .Mod) && b == 0 -> return None
    if (op == .Shl || op == .Shr) && (b < 0 || b >= 64) -> return None
    if op == {
        .Add -> Val(a + b)
        .Sub -> Val(a - b)
        .Mul -> Val(a * b)
        .Div -> Val((a - a %% b) /% b)
        .Rem -> Val(a %% b)
        .FloorDiv -> Val(a /% b)
        .Mod -> Val(a - b * (a /% b))
        .BitAnd -> Val(a.bit_and(b))
        .BitOr -> Val(a.bit_or(b))
        .BitXor -> Val(a.bit_xor(b))
        .Shl -> Val(a << b)
        .Shr -> Val(a >> b)
        else -> None
    }
}

// String comparison: Eq/Ne by the runtime's equality, ordering by the sign
// of its three-way order.
fn jet_eval_ir_text_compare(m: IRModule, rt: JetEvalRuntimeIR, s: &JetEvalIRState, op: IROp, left: Int, right: Int) -> Int? {
    if !jet_eval_ir_is_compare(op) {
        jet_eval_ir_problem(&s, "String operands take Concat or a comparison")
        return None
    }
    if op == .Eq || op == .Ne {
        equal :: jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_string_eq", [Int]{left, right}) ?? return None
        same :: equal.bit_and(255) != 0
        return Val(jet_eval_ir_bool(if op == .Eq -> same else -> !same))
    }
    order :: jet_eval_ir_runtime_call(m, rt, &s, "jet_rt_string_compare", [Int]{left, right}) ?? return None
    Val(jet_eval_ir_compare(op, jet_eval_ir_wrap(order, 64, true)))
}

fn jet_eval_ir_binary(s: &JetEvalIRState, op: IROp, ty: IRType, left: Int, right: Int, overflow: Int) -> Int? {
    if ty.kind == {
        .Word -> jet_eval_ir_fixed(&s, op, ty, left, right, overflow != IR_OVERFLOW_WRAP)
        .Bool | .Char | .Pointer | .Unit -> {
            if jet_eval_ir_is_compare(op) -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(left, right)))
            if op == {
                .BitAnd -> Val(left.bit_and(right))
                .BitOr -> Val(left.bit_or(right))
                .BitXor -> Val(left.bit_xor(right))
                else -> {
                    jet_eval_ir_problem(&s, "{ir_kind_text(ty.kind)} operands take only comparisons and bitwise operators")
                    None
                }
            }
        }
        .Float | .Float32 -> jet_eval_ir_float_binary(&s, op, ty.kind == .Float32, left, right)
        else -> {
            jet_eval_ir_problem(&s, "arithmetic on {ir_kind_text(ty.kind)}")
            None
        }
    }
}

fn ir_kind_text(kind: IRTypeKind) -> String Never! { "{kind}" }

// Fixed-width arithmetic: wrapping, or (trap) stopping when the result
// leaves the type's range; a shift count outside 0..<bits stops when
// checked and is masked to the word when wrapping (the selection's shl/sar).
fn jet_eval_ir_fixed(s: &JetEvalIRState, op: IROp, ty: IRType, left: Int, right: Int, trap: Bool) -> Int? {
    bits :: jet_eval_ir_word_bits(ty)
    signed :: ty.signed
    if jet_eval_ir_is_compare(op) -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(left, right)))
    result := 0
    if op == {
        .Add -> result = left + right
        .Sub -> result = left - right
        .Mul -> result = left * right
        .Div | .Rem | .FloorDiv | .Mod -> {
            if right == 0 {
                jet_eval_ir_source_fail(&s, "division by zero")
                return None
            }
            if signed && right == -1 {
                // MIN / -1: the quotient is the negation; the remainder 0.
                if op == .Rem || op == .Mod -> return Val(0)
                result = 0 - left
            } else {
                result = if op == {
                    .Div -> (left - left %% right) /% right
                    .Rem -> left %% right
                    .FloorDiv -> left /% right
                    else -> left - right * (left /% right)
                }
            }
        }
        .BitAnd -> return Val(jet_eval_ir_wrap(left.bit_and(right), bits, signed))
        .BitOr -> return Val(jet_eval_ir_wrap(left.bit_or(right), bits, signed))
        .BitXor -> return Val(jet_eval_ir_wrap(left.bit_xor(right), bits, signed))
        .Shl | .Shr -> {
            count := right
            if trap {
                if count < 0 || count >= bits {
                    jet_eval_ir_source_fail(&s, "shift count {count} is outside 0..<{bits}")
                    return None
                }
            } else {
                count = count.bit_and(63)
            }
            if op == .Shl -> return Val(jet_eval_ir_wrap(left << count, bits, signed))
            unsigned_left :: if signed -> left else -> jet_eval_ir_wrap(left, bits, false)
            return Val(jet_eval_ir_wrap(unsigned_left >> count, bits, signed))
        }
        else -> {
            jet_eval_ir_problem(&s, "no fixed-width form of this operator")
            return None
        }
    }
    if trap && !jet_eval_ir_in_range(result, bits, signed) {
        jet_eval_ir_source_fail(&s, jet_eval_ir_overflow_message(op))
        return None
    }
    Val(jet_eval_ir_wrap(result, bits, signed))
}

fn jet_eval_ir_overflow_message(op: IROp) -> String Never! {
    if op == {
        .Add -> "This addition overflows the value's type (the result is outside its range)"
        .Sub -> "This subtraction overflows the value's type (the result is outside its range)"
        .Mul -> "This multiplication overflows the value's type (the result is outside its range)"
        else -> "This division overflows the value's type (the result is outside its range)"
    }
}

fn jet_eval_ir_float_binary(s: &JetEvalIRState, op: IROp, single: Bool, left: Int, right: Int) -> Int? {
    a :: if single -> jet_eval_ir_float32(left) else -> jet_eval_ir_float(left)
    b :: if single -> jet_eval_ir_float32(right) else -> jet_eval_ir_float(right)
    if jet_eval_ir_is_compare(op) {
        // Ordered comparisons are false on NaN; Ne is true.
        return Val(jet_eval_ir_bool(if op == {
            .Eq -> a == b
            .Ne -> a != b
            .Lt -> a < b
            .Le -> a <= b
            .Gt -> a > b
            else -> a >= b
        }))
    }
    result :: if op == {
        .Add -> a + b
        .Sub -> a - b
        .Mul -> a * b
        .Div -> a / b
        .FloorDiv -> math.floor(a / b)
        .Rem -> jet_eval_ir_fmod(a, b)
        else -> {
            jet_eval_ir_problem(&s, "no Float form of this operator")
            return None
        }
    }
    Val(if single -> jet_eval_ir_float32_word(result) else -> jet_eval_ir_float_word(result))
}

// C fmod: the exact remainder of `a / b` truncated toward zero, with the
// dividend's sign. Both operands are integers times powers of two, so the
// remainder is computed exactly on their significands and is representable.
fn jet_eval_ir_fmod(a: Float, b: Float) -> Float Never! {
    if a != a || b != b || !math.is_finite(a) || b == 0.0 -> return math.from_bits(9221120237041090560)
    if !math.is_finite(b) || a == 0.0 -> return a
    left :: math.to_bits(a)
    right :: math.to_bits(b)
    left_exponent :: (left >> 52).bit_and(2047)
    right_exponent :: (right >> 52).bit_and(2047)
    left_significand :: if left_exponent == 0 -> left.bit_and(4503599627370495) else -> left.bit_and(4503599627370495).bit_or(4503599627370496)
    right_significand :: if right_exponent == 0 -> right.bit_and(4503599627370495) else -> right.bit_and(4503599627370495).bit_or(4503599627370496)
    left_power :: (if left_exponent == 0 -> 1 else -> left_exponent) - 1075
    right_power :: (if right_exponent == 0 -> 1 else -> right_exponent) - 1075
    power :: if left_power < right_power -> left_power else -> right_power
    scaled_left :: left_significand << (left_power - power)
    scaled_right :: right_significand << (right_power - power)
    remainder :: scaled_left %% scaled_right
    magnitude :: jet_eval_ir_scale2(Float.from_int(remainder), power)
    if a < 0.0 -> return -magnitude
    magnitude
}

// `value * 2^power`, exact when the product is representable.
fn jet_eval_ir_scale2(value: Float, power: Int) -> Float Never! {
    result := value
    step := power
    loop step > 0 {
        chunk :: if step > 1000 -> 1000 else -> step
        result = result * math.from_bits((chunk + 1023) << 52)
        step -= chunk
    }
    loop step < 0 {
        chunk :: if step < -1000 -> -1000 else -> step
        result = result * math.from_bits((chunk + 1023) << 52)
        step -= chunk
    }
    result
}

fn jet_eval_ir_negate(s: &JetEvalIRState, ty: IRType, value: Int, overflow: Int) -> Int? {
    if ty.kind == {
        .Float -> Val(jet_eval_ir_float_word(-jet_eval_ir_float(value)))
        .Float32 -> Val(value.bit_xor(2147483648))
        .Word -> jet_eval_ir_fixed(&s, IROp.Sub, ty, 0, value, overflow != IR_OVERFLOW_WRAP)
        else -> {
            jet_eval_ir_problem(&s, "no negation of {ir_kind_text(ty.kind)}")
            None
        }
    }
}

fn jet_eval_ir_not(s: &JetEvalIRState, ty: IRType, value: Int) -> Int? {
    if ty.kind == {
        .Bool -> Val(value.bit_xor(1))
        .Word -> Val(jet_eval_ir_wrap(value.bit_xor(-1), jet_eval_ir_word_bits(ty), ty.signed))
        else -> {
            jet_eval_ir_problem(&s, "no `not` of {ir_kind_text(ty.kind)}")
            None
        }
    }
}

// Convert by the slot types: a Float or Float32 truncates toward zero into a
// signed 64-bit word (NaN and out of range give the minimum), wrapped to the
// Word; a Word, read as signed 64-bit, rounds to nearest into a Float; the
// Float widths convert into each other.
fn jet_eval_ir_convert(s: &JetEvalIRState, from: IRType, to: IRType, value: Int) -> Int? {
    float_from :: from.kind == .Float || from.kind == .Float32
    float_to :: to.kind == .Float || to.kind == .Float32
    if float_from && to.kind == .Word {
        x :: if from.kind == .Float32 -> jet_eval_ir_float32(value) else -> jet_eval_ir_float(value)
        return Val(jet_eval_ir_wrap(jet_eval_ir_truncate(x), jet_eval_ir_word_bits(to), to.signed))
    }
    if from.kind == .Word && float_to {
        word :: jet_eval_ir_wrap(value, 64, true)
        if to.kind == .Float32 -> return Val(jet_eval_ir_float32_word(Float.from_int(jet_eval_ir_round_significand(word, 24))))
        return Val(jet_eval_ir_float_word(Float.from_int(word)))
    }
    if float_from && float_to {
        x :: if from.kind == .Float32 -> jet_eval_ir_float32(value) else -> jet_eval_ir_float(value)
        return Val(if to.kind == .Float32 -> jet_eval_ir_float32_word(x) else -> jet_eval_ir_float_word(x))
    }
    jet_eval_ir_problem(&s, "no conversion from {ir_kind_text(from.kind)} to {ir_kind_text(to.kind)}")
    None
}

// cvttsd2si: `x` truncated toward zero, the minimum signed 64-bit word when
// it is NaN or outside [-2^63, 2^63).
fn jet_eval_ir_truncate(x: Float) -> Int Never! {
    if x != x || x >= 9223372036854775808.0 || x < -9223372036854775808.0 -> return -9223372036854775807 - 1
    bits :: math.to_bits(x)
    exponent :: (bits >> 52).bit_and(2047)
    if exponent < 1023 -> return 0
    significand :: bits.bit_and(4503599627370495).bit_or(4503599627370496)
    shift :: exponent - 1075
    magnitude :: if shift >= 0 -> significand << shift else -> significand >> (0 - shift)
    if x < 0.0 -> return 0 - magnitude
    magnitude
}

// `value` rounded to nearest-even at `keep` significant bits, so a later
// Float conversion of it is exact (one rounding, as cvtsi2ss does).
fn jet_eval_ir_round_significand(value: Int, keep: Int) -> Int Never! {
    magnitude :: if value < 0 -> 0 - value else -> value
    if magnitude < jet_eval_ir_pow2(keep) -> return value
    length := keep
    loop magnitude >= jet_eval_ir_pow2(length) -> length += 1
    shift :: length - keep
    kept := magnitude >> shift
    rest :: magnitude - (kept << shift)
    half :: jet_eval_ir_pow2(shift - 1)
    if rest > half || (rest == half && kept.bit_and(1) == 1) -> kept += 1
    rounded :: kept << shift
    if value < 0 -> return 0 - rounded
    rounded
}
