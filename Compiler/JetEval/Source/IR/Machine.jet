// The slot IR interpreter: compile-time evaluation runs the same IR the
// machine code is selected from (Compiler/JetIR/Source/IR.jet), so comptime
// and run time share one meaning. Every instruction does what the x86-64
// selection makes of it: a slot holds one machine word, memory is bytes in
// the native layout, and runtime routes are the runtime's symbols with its
// semantics.
//
// Words. An exact Int slot holds an inline integer (bits 63 and 62 agree)
// or a big-integer handle; a fixed-width integer its sign- or zero-extended
// value; a Float its IEEE bits (signed), a Float32 its 32 bits; a Bool 0/1.
// Pointers are words too: a memory address is `region << 32 | offset`
// (region 0 is null), a String is a text handle, a function address a
// function handle, a String builder a builder handle. Handles never alias an
// address, so a Load through a String or a dangling address is an internal
// problem, never silent garbage.
use core.math as math
use jet_foundation.[Span]
use jet_backend.[lower_float_constant_bits]
use jet_ir.[IRFunction, IRModule, IROp, IRType, IRTypeKind, IR_OVERFLOW_WRAP]

JET_EVAL_IR_REGION :: 4294967296
JET_EVAL_IR_TEXT_TAG :: 1152921504606846976
JET_EVAL_IR_FUNCTION_TAG :: 2305843009213693952
JET_EVAL_IR_BUILDER_TAG :: 3458764513820540928
JET_EVAL_IR_BIG_TAG :: 4611686018427387904
JET_EVAL_IR_INLINE_MIN :: -4611686018427387904
JET_EVAL_IR_INLINE_MAX :: 4611686018427387903

// The interpreter's mutable state; the module is read-only beside it.
// `regions[r]` is the bytes of region r (0 unused), `live[r]` whether it
// may still be read; `targets[f]` the branch target of each instruction of
// function f (built on its first call, `ready[f]`).
struct JetEvalIRState {
    regions: [[U8]]
    live: [Bool]
    texts: [String]
    bigs: [Int]
    builders: [[U8]]
    data_regions: [Int]
    data_texts: [Int]
    targets: [[Int]]
    // The owner count of each counted buffer (by data address) shared by more
    // than one owner; a buffer missing here has one (Refcount.jet's count word).
    owners: [Int:Int]
    ready: [Bool]
    stdout: String
    stderr: String
    steps: Int
    fuel: Int
    depth: Int
    max_depth: Int
    runtime_execution: Bool
    span: Span
    failure: JetEvalError?
    internal_problem: JetEvalInternalProblem?
    exit_code: Int?
    // The compiler's answer to `embed_file` / `embed_bytes` / `find`.
    inputs: JetEvalComptimeInputAdapter?
}

fn jet_eval_ir_state_new(m: IRModule, config: JetEvalConfig, span: Span) -> JetEvalIRState Never! {
    s := JetEvalIRState{
        regions: [[U8]]{[U8]{}}, live: [Bool]{false}, texts: [String]{}, bigs: [Int]{}, builders: [[U8]]{},
        data_regions: [Int]{}, data_texts: [Int]{}, targets: [[Int]]{}, owners: [Int:Int]{}, ready: [Bool]{},
        stdout: "", stderr: "", steps: 0, fuel: config.fuel, depth: 0, max_depth: config.max_call_depth,
        runtime_execution: config.runtime_execution, span: span, failure: None, internal_problem: None, exit_code: None,
        inputs: if config.comptime_input_adapter == .Val(adapter) -> Val(adapter.clone_input_adapter()) else -> None,
    }
    loop row in m.data {
        region :: s.regions.len()
        &s.regions.push(row.copy())
        &s.live.push(true)
        &s.data_regions.push(region * JET_EVAL_IR_REGION)
        text :: jet_eval_ir_text_new(&s, String.from_bytes_lossy(row))
        &s.data_texts.push(text)
    }
    // A static object's address words (JetIR BuildStatic.jet): a data row's
    // address, or the text a ConstText of the target row reads.
    loop row in 0..<m.data.len() {
        relocs :: m.data_relocs.get(row) ?? next
        loop reloc in relocs {
            if reloc.target < 0 || reloc.target >= s.data_regions.len() -> next
            word :: if reloc.text -> s.data_texts[reloc.target] else -> s.data_regions[reloc.target] + reloc.addend
            at :: s.data_regions[row] + reloc.offset
            _ := jet_eval_ir_write(&s, at, 8, word)
        }
    }
    loop _ in m.functions {
        &s.targets.push([Int]{})
        &s.ready.push(false)
    }
    s
}

// Whether `pointer` is in a data row: static storage, never released.
fn jet_eval_ir_static(s: JetEvalIRState, pointer: Int) -> Bool Never! {
    if pointer <= 0 || pointer >= JET_EVAL_IR_TEXT_TAG -> return false
    region :: pointer /% JET_EVAL_IR_REGION
    region >= 1 && region <= s.data_regions.len()
}

fn jet_eval_ir_failed(s: JetEvalIRState) -> Bool Never! { s.failure != None || s.internal_problem != None || s.exit_code != None }

fn jet_eval_ir_problem(s: &JetEvalIRState, message: String) Never! {
    if s.internal_problem == None -> s.internal_problem = Val(JetEvalInternalProblem{span: Val(s.span), message: "IR evaluation: {message}"})
}

fn jet_eval_ir_source_fail(s: &JetEvalIRState, what: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_source_error(s.runtime_execution, s.span, what))
}

fn jet_eval_ir_unsupported(s: &JetEvalIRState, operation: String) Never! {
    if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Unsupported, s.span, "MIR evaluation does not implement `{operation}`", "this operation has no compiler-time evaluator yet", "do not treat the incomplete evaluation as successful"))
}

// ---------------------------------------------------------------------------
// Words.

fn jet_eval_ir_pow2(bits: Int) -> Int Never! { 1 << bits }

// `value` reduced to the fixed-width integer of `bits` (two's complement),
// sign-extended when `signed`.
fn jet_eval_ir_wrap(value: Int, bits: Int, signed: Bool) -> Int Never! {
    modulus :: jet_eval_ir_pow2(bits)
    low :: value.bit_and(modulus - 1)
    if signed && low >= modulus /% 2 -> return low - modulus
    low
}

fn jet_eval_ir_word_bits(ty: IRType) -> Int Never! {
    if ty.kind == .Word && ty.bits > 0 && ty.bits < 64 -> return ty.bits
    64
}

fn jet_eval_ir_in_range(value: Int, bits: Int, signed: Bool) -> Bool Never! {
    if signed {
        half :: jet_eval_ir_pow2(bits - 1)
        return value >= 0 - half && value < half
    }
    value >= 0 && value < jet_eval_ir_pow2(bits)
}

// The exact integer an Int word holds.
fn jet_eval_ir_int_value(s: &JetEvalIRState, word: Int) -> Int? Never! {
    if word < JET_EVAL_IR_BIG_TAG -> return Val(word)
    index :: word - JET_EVAL_IR_BIG_TAG
    if index >= s.bigs.len() {
        jet_eval_ir_problem(&s, "an Int word is neither inline nor a live big integer")
        return None
    }
    Val(s.bigs[index])
}

// The Int word of an exact integer: inline when it fits 62 bits.
fn jet_eval_ir_int_word(s: &JetEvalIRState, value: Int) -> Int Never! {
    if value >= JET_EVAL_IR_INLINE_MIN && value <= JET_EVAL_IR_INLINE_MAX -> return value
    index :: s.bigs.len()
    &s.bigs.push(value)
    JET_EVAL_IR_BIG_TAG + index
}

fn jet_eval_ir_text_new(s: &JetEvalIRState, text: String) -> Int Never! {
    index :: s.texts.len()
    &s.texts.push(text)
    JET_EVAL_IR_TEXT_TAG + index
}

fn jet_eval_ir_text(s: &JetEvalIRState, word: Int) -> String? Never! {
    index :: word - JET_EVAL_IR_TEXT_TAG
    if word < JET_EVAL_IR_TEXT_TAG || index >= s.texts.len() {
        jet_eval_ir_problem(&s, "a String word is not a live text")
        return None
    }
    Val(s.texts[index].copy())
}

fn jet_eval_ir_float(word: Int) -> Float Never! { math.from_bits(word) }

fn jet_eval_ir_float_word(value: Float) -> Int Never! { math.to_bits(value) }

// The Float of binary32 `bits` (exact: every binary32 is a binary64).
fn jet_eval_ir_float32(bits: Int) -> Float Never! {
    sign :: bits.bit_and(2147483648) != 0
    exponent :: (bits >> 23).bit_and(255)
    fraction :: bits.bit_and(8388607)
    magnitude := math.from_bits(0)
    if exponent == 255 {
        if fraction != 0 -> return math.from_bits(9221120237041090560)
        magnitude = math.from_bits(9218868437227405312)
    } else if exponent == 0 {
        // Subnormal: fraction * 2^-149.
        magnitude = Float.from_int(fraction) * math.from_bits(3936146074321813504)
    } else {
        wide :: (exponent - 127 + 1023) << 52
        magnitude = math.from_bits(wide.bit_or(fraction << 29))
    }
    if sign -> return -magnitude
    magnitude
}

// The binary32 bits of `value`, rounded once to nearest-even.
fn jet_eval_ir_float32_word(value: Float) -> Int Never! {
    lower_float_constant_bits(value, true)
}

// ---------------------------------------------------------------------------
// Memory.

fn jet_eval_ir_alloc(s: &JetEvalIRState, size: Int) -> Int Never! {
    region :: s.regions.len()
    bytes := [U8]{}
    loop _ in 0..<(if size > 0 -> size else -> 0) -> &bytes.push(U8{0})
    &s.regions.push(bytes)
    &s.live.push(true)
    region * JET_EVAL_IR_REGION
}

fn jet_eval_ir_release(s: &JetEvalIRState, pointer: Int) Never! {
    region :: pointer /% JET_EVAL_IR_REGION
    if pointer <= 0 || pointer >= JET_EVAL_IR_TEXT_TAG || region >= s.regions.len() -> return
    s.live[region] = false
    s.regions[region] = [U8]{}
}

// The region of `pointer` when `width` bytes from it are readable.
fn jet_eval_ir_region(s: &JetEvalIRState, pointer: Int, width: Int) -> Int? Never! {
    if pointer <= 0 || pointer >= JET_EVAL_IR_TEXT_TAG {
        jet_eval_ir_problem(&s, if pointer == 0 -> "memory access through a null pointer" else -> "memory access through a word that is not an address")
        return None
    }
    region :: pointer /% JET_EVAL_IR_REGION
    offset :: pointer - region * JET_EVAL_IR_REGION
    if region >= s.regions.len() || !s.live[region] {
        jet_eval_ir_problem(&s, "memory access through a released address")
        return None
    }
    if offset + width > s.regions[region].len() {
        size :: s.regions[region].len()
        jet_eval_ir_problem(&s, "memory access of {width} bytes at offset {offset} past its {size}-byte storage")
        return None
    }
    Val(region)
}

// The unsigned little-endian value of `width` bytes at `pointer`.
fn jet_eval_ir_read(s: &JetEvalIRState, pointer: Int, width: Int) -> Int? Never! {
    region :: jet_eval_ir_region(&s, pointer, width) ?? return None
    offset :: pointer - region * JET_EVAL_IR_REGION
    value := 0
    index := width - 1
    loop index >= 0 {
        value = (value << 8).bit_or(Int.from_u8(s.regions[region][offset + index]))
        index -= 1
    }
    Val(value)
}

fn jet_eval_ir_write(s: &JetEvalIRState, pointer: Int, width: Int, value: Int) -> Bool Never! {
    region :: jet_eval_ir_region(&s, pointer, width) ?? return false
    offset :: pointer - region * JET_EVAL_IR_REGION
    loop index in 0..<width -> s.regions[region][offset + index] = U8{(value >> (8 * index)).bit_and(255)}
    true
}

fn jet_eval_ir_move_bytes(s: &JetEvalIRState, to: Int, from: Int, count: Int) -> Bool Never! {
    if count <= 0 -> return true
    source :: jet_eval_ir_region(&s, from, count) ?? return false
    target :: jet_eval_ir_region(&s, to, count) ?? return false
    from_offset :: from - source * JET_EVAL_IR_REGION
    to_offset :: to - target * JET_EVAL_IR_REGION
    copied := [U8]{}
    loop index in 0..<count -> &copied.push(s.regions[source][from_offset + index])
    loop index in 0..<count -> s.regions[target][to_offset + index] = copied[index]
    true
}

// Bytes a value of `ty` occupies in memory (IR Load/Store).
fn jet_eval_ir_width(ty: IRType) -> Int Never! {
    if ty.kind == {
        .Unit -> 0
        .Bool -> 1
        .Float32 -> 4
        .Word -> if ty.size == 1 || ty.size == 2 || ty.size == 4 -> ty.size else -> 8
        else -> 8
    }
}

// The canonical word of the unsigned `raw` loaded as `width` bytes of `ty`.
fn jet_eval_ir_canonical(ty: IRType, raw: Int, width: Int) -> Int Never! {
    signed :: ty.kind == .Int || ty.kind == .Float || (ty.kind == .Word && ty.signed)
    if !signed || width == 0 -> return raw
    jet_eval_ir_wrap(raw, 8 * width, true)
}

// ---------------------------------------------------------------------------
// Structured control.

// The instruction a Br or BrIf at `at` continues at: a Loop's first body
// instruction, else the instruction after the construct's End.
fn jet_eval_ir_prepare(m: IRModule, s: &JetEvalIRState, id: Int) Never! {
    if s.ready[id] -> return
    f :: m.functions[id]
    targets := [Int]{}
    open := [Int]{}
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        target := -1
        if op == .Br || op == .BrIf {
            depth :: if op == .Br -> f.a[at] else -> f.b[at]
            row :: open.len() - 1 - depth
            if row >= 0 {
                opener :: open[row]
                target = if f.op[opener] == {
                    .Loop -> opener + 1
                    .If -> f.c[opener] + 1
                    else -> f.a[opener] + 1
                }
            }
        }
        &targets.push(target)
        if op == .Block || op == .Loop || op == .If -> &open.push(at)
        if op == .End -> _ := &open.pop()
    }
    s.targets[id] = targets
    s.ready[id] = true
}

// ---------------------------------------------------------------------------
// Calls.

// Runs function `id` on `args` (one word per parameter). An Aggregate
// result's bytes go to `result_area`, which is the returned word.
fn jet_eval_ir_invoke(m: IRModule, s: &JetEvalIRState, id: Int, args: [Int], result_area: Int) -> Int? {
    if id < 0 || id >= m.functions.len() {
        jet_eval_ir_problem(&s, "call of function {id}, which is not in the module")
        return None
    }
    if s.depth >= s.max_depth {
        limit :: s.max_depth
        jet_eval_ir_source_fail(&s, "compile-time call depth exceeds {limit}")
        return None
    }
    jet_eval_ir_prepare(m, &s, id)
    f :: m.functions[id]
    if args.len() != f.param_count {
        jet_eval_ir_problem(&s, "{f.name} takes {f.param_count} arguments, the call passes {args.len()}")
        return None
    }
    slots := [Int]{}
    loop index in 0..<f.slot_type.len() -> &slots.push(if index < args.len() -> args[index] else -> 0)
    areas := [Int:Int]{}
    s.depth += 1
    returned := jet_eval_ir_run(m, &s, id, &slots, &areas, result_area)
    s.depth -= 1
    loop (_, pointer) in areas -> jet_eval_ir_release(&s, pointer)
    returned
}

// Frame storage of instruction `at`: one area per instruction, the same
// address each time the instruction runs, live until the function returns.
fn jet_eval_ir_area(s: &JetEvalIRState, areas: &[Int:Int], at: Int, size: Int) -> Int Never! {
    if areas.get(at) == .Val(pointer) -> return pointer
    pointer :: jet_eval_ir_alloc(&s, if size > 0 -> size else -> 8)
    areas[at] = pointer
    pointer
}

fn jet_eval_ir_call_args(f: IRFunction, slots: [Int], at: Int) -> [Int] Never! {
    args := [Int]{}
    start :: f.b[at]
    loop index in start..<(start + f.c[at]) -> &args.push(slots[f.args[index]])
    args
}

fn jet_eval_ir_run(m: IRModule, s: &JetEvalIRState, id: Int, slots: &[Int], areas: &[Int:Int], result_area: Int) -> Int? {
    f :: m.functions[id]
    count :: f.op.len()
    ip := 0
    loop {
        if jet_eval_ir_failed(s) -> return None
        if ip >= count {
            jet_eval_ir_problem(&s, "{f.name} ran past its last instruction")
            return None
        }
        s.steps += 1
        if !s.runtime_execution && s.steps > s.fuel {
            if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Fuel, s.span, "MIR evaluation exhausted its fuel", "compile-time evaluation is bounded to keep compilation finite", "increase the evaluator fuel or simplify the evaluated program"))
            return None
        }
        at :: ip
        ip += 1
        op :: f.op[at]
        dst :: f.dst[at]
        if op == {
            .Nop | .Block | .Loop | .End -> {}
            .Const -> {
                if dst >= 0 -> slots[dst] = jet_eval_ir_const(m.types[f.slot_type[dst]], f.a[at])
            }
            .ConstText -> {
                if f.a[at] < 0 || f.a[at] >= s.data_texts.len() {
                    jet_eval_ir_problem(&s, "data row {f.a[at]} is not in the module")
                    return None
                }
                slots[dst] = s.data_texts[f.a[at]]
            }
            .ConstBigInt -> {
                text :: m.names[f.a[at]]
                value :: Int.parse(text) ?? {
                    jet_eval_ir_problem(&s, "big integer constant `{text}` is not a decimal")
                    return None
                }
                slots[dst] = jet_eval_ir_int_word(&s, value)
            }
            .Copy | .Move -> slots[dst] = slots[f.a[at]]
            .Drop -> {}
            .Close -> {
                routine :: m.names[f.b[at]]
                _ := jet_eval_ir_runtime(m, &s, routine, [Int]{slots[f.a[at]]}, -1, f.source_file, f.code_line[at]) ?? return None
            }
            .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> {
                slots[dst] = jet_eval_ir_binary(&s, op, m.types[f.slot_type[f.a[at]]], slots[f.a[at]], slots[f.b[at]], f.c[at]) ?? return None
            }
            .Neg -> slots[dst] = jet_eval_ir_negate(&s, m.types[f.slot_type[f.a[at]]], slots[f.a[at]], f.c[at]) ?? return None
            .Not -> slots[dst] = jet_eval_ir_not(&s, m.types[f.slot_type[f.a[at]]], slots[f.a[at]]) ?? return None
            .Convert -> slots[dst] = jet_eval_ir_convert(&s, m.types[f.slot_type[f.a[at]]], m.types[f.slot_type[dst]], slots[f.a[at]]) ?? return None
            .Concat -> {
                left :: jet_eval_ir_text(&s, slots[f.a[at]]) ?? return None
                right :: jet_eval_ir_text(&s, slots[f.b[at]]) ?? return None
                slots[dst] = jet_eval_ir_text_new(&s, "{left}{right}")
            }
            .Call -> {
                args :: jet_eval_ir_call_args(f, slots, at)
                area := 0
                if dst >= 0 && m.types[f.slot_type[dst]].kind == .Aggregate -> area = jet_eval_ir_area(&s, &areas, at, m.types[f.slot_type[dst]].size)
                value :: jet_eval_ir_invoke(m, &s, f.a[at], args, area) ?? return None
                if dst >= 0 -> slots[dst] = value
            }
            .CallIndirect -> {
                code :: slots[f.a[at]]
                if code < JET_EVAL_IR_FUNCTION_TAG || code >= JET_EVAL_IR_BUILDER_TAG {
                    jet_eval_ir_problem(&s, "indirect call through a word that is not a function address")
                    return None
                }
                args :: jet_eval_ir_call_args(f, slots, at)
                area := 0
                if dst >= 0 && m.types[f.slot_type[dst]].kind == .Aggregate -> area = jet_eval_ir_area(&s, &areas, at, m.types[f.slot_type[dst]].size)
                value :: jet_eval_ir_invoke(m, &s, code - JET_EVAL_IR_FUNCTION_TAG, args, area) ?? return None
                if dst >= 0 -> slots[dst] = value
            }
            .CallRuntime -> {
                args :: jet_eval_ir_call_args(f, slots, at)
                result_ty := -1
                if dst >= 0 -> result_ty = f.slot_type[dst]
                value :: jet_eval_ir_runtime(m, &s, m.names[f.a[at]], args, result_ty, f.source_file, f.code_line[at]) ?? return None
                if dst >= 0 -> slots[dst] = value
            }
            .FunctionAddress -> slots[dst] = JET_EVAL_IR_FUNCTION_TAG + f.a[at]
            .DataAddress -> {
                if f.a[at] < 0 || f.a[at] >= s.data_regions.len() {
                    jet_eval_ir_problem(&s, "data row {f.a[at]} is not in the module")
                    return None
                }
                slots[dst] = s.data_regions[f.a[at]]
            }
            .Load -> {
                ty :: m.types[f.slot_type[dst]]
                width :: jet_eval_ir_width(ty)
                if width > 0 {
                    raw :: jet_eval_ir_read(&s, slots[f.a[at]] + f.b[at], width) ?? return None
                    slots[dst] = jet_eval_ir_canonical(ty, raw, width)
                }
            }
            .Store -> {
                ty :: m.types[f.slot_type[f.c[at]]]
                width :: jet_eval_ir_width(ty)
                if width > 0 && !jet_eval_ir_write(&s, slots[f.a[at]] + f.b[at], width, slots[f.c[at]]) -> return None
            }
            .StackAddress -> slots[dst] = jet_eval_ir_area(&s, &areas, at, f.a[at])
            .Offset -> slots[dst] = slots[f.a[at]] + f.b[at]
            .CopyBytes -> {
                if !jet_eval_ir_move_bytes(&s, slots[f.a[at]], slots[f.b[at]], f.c[at]) -> return None
            }
            .If -> {
                if slots[f.a[at]] == 0 -> ip = if f.b[at] >= 0 -> f.b[at] + 1 else -> f.c[at] + 1
            }
            .Else -> ip = f.a[at] + 1
            .Br -> ip = s.targets[id][at]
            .BrIf -> {
                if slots[f.a[at]] != 0 -> ip = s.targets[id][at]
            }
            .Return -> {
                if f.a[at] < 0 -> return Val(0)
                value :: slots[f.a[at]]
                if f.result >= 0 && m.types[f.result].kind == .Aggregate {
                    if result_area == 0 {
                        jet_eval_ir_problem(&s, "{f.name} returns an aggregate without result storage")
                        return None
                    }
                    if !jet_eval_ir_move_bytes(&s, result_area, value, m.types[f.result].size) -> return None
                    return Val(result_area)
                }
                return Val(value)
            }
            .Unreachable -> {
                jet_eval_ir_problem(&s, "{f.name} reached an unreachable instruction (line {f.code_line[at]})")
                return None
            }
        }
        if ip < 0 {
            jet_eval_ir_problem(&s, "{f.name}: branch at instruction {at} leaves the function")
            return None
        }
    }
}

// The word of a Const of type `ty`: an exact Int, a fixed-width integer, a
// Bool, a Char or Float bits, as the builder wrote it.
fn jet_eval_ir_const(ty: IRType, value: Int) -> Int Never! {
    if ty.kind == .Word -> return jet_eval_ir_wrap(value, jet_eval_ir_word_bits(ty), ty.signed)
    value
}

// ---------------------------------------------------------------------------
// Arithmetic. The left operand's type row selects the meaning (IR.jet).

fn jet_eval_ir_bool(value: Bool) -> Int Never! { if value -> 1 else -> 0 }

fn jet_eval_ir_compare(op: IROp, order: Int) -> Int Never! {
    jet_eval_ir_bool(if op == {
        .Eq -> order == 0
        .Ne -> order != 0
        .Lt -> order < 0
        .Le -> order <= 0
        .Gt -> order > 0
        else -> order >= 0
    })
}

fn jet_eval_ir_is_compare(op: IROp) -> Bool Never! {
    op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge
}

fn jet_eval_ir_order(left: Int, right: Int) -> Int Never! {
    if left < right -> return -1
    if left > right -> return 1
    0
}

fn jet_eval_ir_binary(s: &JetEvalIRState, op: IROp, ty: IRType, left: Int, right: Int, overflow: Int) -> Int? {
    if ty.kind == {
        .Int -> {
            a :: jet_eval_ir_int_value(&s, left) ?? return None
            b :: jet_eval_ir_int_value(&s, right) ?? return None
            if jet_eval_ir_is_compare(op) -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(a, b)))
            exact :: jet_eval_ir_exact(&s, op, a, b) ?? return None
            Val(jet_eval_ir_int_word(&s, exact))
        }
        .Word -> jet_eval_ir_fixed(&s, op, ty, left, right, overflow != IR_OVERFLOW_WRAP)
        .Bool | .Char | .Pointer | .Unit -> {
            if jet_eval_ir_is_compare(op) -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(left, right)))
            if op == {
                .BitAnd -> Val(left.bit_and(right))
                .BitOr -> Val(left.bit_or(right))
                .BitXor -> Val(left.bit_xor(right))
                else -> {
                    jet_eval_ir_problem(&s, "{ir_kind_text(ty.kind)} operands take only comparisons and bitwise operators")
                    None
                }
            }
        }
        .Float | .Float32 -> jet_eval_ir_float_binary(&s, op, ty.kind == .Float32, left, right)
        .String -> {
            if !jet_eval_ir_is_compare(op) {
                jet_eval_ir_problem(&s, "String operands take Concat or a comparison")
                return None
            }
            a :: jet_eval_ir_text(&s, left) ?? return None
            b :: jet_eval_ir_text(&s, right) ?? return None
            Val(jet_eval_ir_compare(op, jet_eval_ir_text_order(a, b)))
        }
        .Aggregate -> {
            jet_eval_ir_problem(&s, "arithmetic on an aggregate")
            None
        }
    }
}

fn ir_kind_text(kind: IRTypeKind) -> String Never! { "{kind}" }

// Byte-wise order of two texts (jet_rt_string_compare).
fn jet_eval_ir_text_order(left: String, right: String) -> Int Never! {
    a :: left.bytes()
    b :: right.bytes()
    shorter :: if a.len() < b.len() -> a.len() else -> b.len()
    loop index in 0..<shorter {
        x :: Int.from_u8(a[index])
        y :: Int.from_u8(b[index])
        if x != y -> return if x < y -> -1 else -> 1
    }
    jet_eval_ir_order(a.len(), b.len())
}

// Exact Int Add .. Shr (the runtime's jet_int_* routes).
fn jet_eval_ir_exact(s: &JetEvalIRState, op: IROp, a: Int, b: Int) -> Int? {
    if op == {
        .Add -> Val(a + b)
        .Sub -> Val(a - b)
        .Mul -> Val(a * b)
        .Div | .Rem | .FloorDiv | .Mod -> {
            if b == 0 {
                jet_eval_ir_source_fail(&s, "division by zero")
                return None
            }
            Val(jet_eval_ir_divide(op, a, b))
        }
        .BitAnd -> Val(a.bit_and(b))
        .BitOr -> Val(a.bit_or(b))
        .BitXor -> Val(a.bit_xor(b))
        .Shl | .Shr -> {
            if b < 0 {
                jet_eval_ir_source_fail(&s, "shift count is negative")
                return None
            }
            Val(if op == .Shl -> a << b else -> a >> b)
        }
        else -> {
            jet_eval_ir_problem(&s, "no exact Int form of this operator")
            None
        }
    }
}

// The runtime's int_division: Div truncates toward zero, Rem takes the
// dividend's sign, FloorDiv rounds toward negative infinity and Mod takes
// the divisor's sign.
fn jet_eval_ir_divide(op: IROp, a: Int, b: Int) -> Int Never! {
    if op == {
        .Div -> (a - a %% b) /% b
        .Rem -> a %% b
        .FloorDiv -> a /% b
        else -> a - b * (a /% b)
    }
}

// Fixed-width arithmetic: wrapping, or (trap) stopping when the result
// leaves the type's range; a shift count outside 0..<bits stops when
// checked and is masked to the word when wrapping (the selection's shl/sar).
fn jet_eval_ir_fixed(s: &JetEvalIRState, op: IROp, ty: IRType, left: Int, right: Int, trap: Bool) -> Int? {
    bits :: jet_eval_ir_word_bits(ty)
    signed :: ty.signed
    if jet_eval_ir_is_compare(op) -> return Val(jet_eval_ir_compare(op, jet_eval_ir_order(left, right)))
    result := 0
    if op == {
        .Add -> result = left + right
        .Sub -> result = left - right
        .Mul -> result = left * right
        .Div | .Rem | .FloorDiv | .Mod -> {
            if right == 0 {
                jet_eval_ir_source_fail(&s, "division by zero")
                return None
            }
            if signed && right == -1 {
                // MIN / -1: the quotient is the negation; the remainder 0.
                if op == .Rem || op == .Mod -> return Val(0)
                result = 0 - left
            } else {
                result = if op == {
                    .Div -> (left - left %% right) /% right
                    .Rem -> left %% right
                    .FloorDiv -> left /% right
                    else -> left - right * (left /% right)
                }
            }
        }
        .BitAnd -> return Val(jet_eval_ir_wrap(left.bit_and(right), bits, signed))
        .BitOr -> return Val(jet_eval_ir_wrap(left.bit_or(right), bits, signed))
        .BitXor -> return Val(jet_eval_ir_wrap(left.bit_xor(right), bits, signed))
        .Shl | .Shr -> {
            count := right
            if trap {
                if count < 0 || count >= bits {
                    jet_eval_ir_source_fail(&s, "shift count {count} is outside 0..<{bits}")
                    return None
                }
            } else {
                count = count.bit_and(63)
            }
            if op == .Shl -> return Val(jet_eval_ir_wrap(left << count, bits, signed))
            unsigned_left :: if signed -> left else -> jet_eval_ir_wrap(left, bits, false)
            return Val(jet_eval_ir_wrap(unsigned_left >> count, bits, signed))
        }
        else -> {
            jet_eval_ir_problem(&s, "no fixed-width form of this operator")
            return None
        }
    }
    if trap && !jet_eval_ir_in_range(result, bits, signed) {
        jet_eval_ir_source_fail(&s, jet_eval_ir_overflow_message(op))
        return None
    }
    Val(jet_eval_ir_wrap(result, bits, signed))
}

fn jet_eval_ir_overflow_message(op: IROp) -> String Never! {
    if op == {
        .Add -> "This addition overflows the value's type (the result is outside its range)"
        .Sub -> "This subtraction overflows the value's type (the result is outside its range)"
        .Mul -> "This multiplication overflows the value's type (the result is outside its range)"
        else -> "This division overflows the value's type (the result is outside its range)"
    }
}

fn jet_eval_ir_float_binary(s: &JetEvalIRState, op: IROp, single: Bool, left: Int, right: Int) -> Int? {
    a :: if single -> jet_eval_ir_float32(left) else -> jet_eval_ir_float(left)
    b :: if single -> jet_eval_ir_float32(right) else -> jet_eval_ir_float(right)
    if jet_eval_ir_is_compare(op) {
        // Ordered comparisons are false on NaN; Ne is true.
        return Val(jet_eval_ir_bool(if op == {
            .Eq -> a == b
            .Ne -> a != b
            .Lt -> a < b
            .Le -> a <= b
            .Gt -> a > b
            else -> a >= b
        }))
    }
    result :: if op == {
        .Add -> a + b
        .Sub -> a - b
        .Mul -> a * b
        .Div -> a / b
        .FloorDiv -> math.floor(a / b)
        .Rem -> jet_eval_ir_fmod(a, b)
        else -> {
            jet_eval_ir_problem(&s, "no Float form of this operator")
            return None
        }
    }
    Val(if single -> jet_eval_ir_float32_word(result) else -> jet_eval_ir_float_word(result))
}

// C fmod: the exact remainder of `a / b` truncated toward zero, with the
// dividend's sign. Both operands are integers times powers of two, so the
// remainder is computed exactly on their significands and is representable.
fn jet_eval_ir_fmod(a: Float, b: Float) -> Float Never! {
    if a != a || b != b || !math.is_finite(a) || b == 0.0 -> return math.from_bits(9221120237041090560)
    if !math.is_finite(b) || a == 0.0 -> return a
    left :: math.to_bits(a)
    right :: math.to_bits(b)
    left_exponent :: (left >> 52).bit_and(2047)
    right_exponent :: (right >> 52).bit_and(2047)
    left_significand :: if left_exponent == 0 -> left.bit_and(4503599627370495) else -> left.bit_and(4503599627370495).bit_or(4503599627370496)
    right_significand :: if right_exponent == 0 -> right.bit_and(4503599627370495) else -> right.bit_and(4503599627370495).bit_or(4503599627370496)
    left_power :: (if left_exponent == 0 -> 1 else -> left_exponent) - 1075
    right_power :: (if right_exponent == 0 -> 1 else -> right_exponent) - 1075
    power :: if left_power < right_power -> left_power else -> right_power
    scaled_left :: left_significand << (left_power - power)
    scaled_right :: right_significand << (right_power - power)
    remainder :: scaled_left %% scaled_right
    magnitude :: jet_eval_ir_scale2(Float.from_int(remainder), power)
    if a < 0.0 -> return -magnitude
    magnitude
}

// `value * 2^power`, exact when the product is representable.
fn jet_eval_ir_scale2(value: Float, power: Int) -> Float Never! {
    result := value
    step := power
    loop step > 0 {
        chunk :: if step > 1000 -> 1000 else -> step
        result = result * math.from_bits((chunk + 1023) << 52)
        step -= chunk
    }
    loop step < 0 {
        chunk :: if step < -1000 -> -1000 else -> step
        result = result * math.from_bits((chunk + 1023) << 52)
        step -= chunk
    }
    result
}

fn jet_eval_ir_negate(s: &JetEvalIRState, ty: IRType, value: Int, overflow: Int) -> Int? {
    if ty.kind == {
        .Int -> {
            a :: jet_eval_ir_int_value(&s, value) ?? return None
            Val(jet_eval_ir_int_word(&s, 0 - a))
        }
        .Float -> Val(jet_eval_ir_float_word(-jet_eval_ir_float(value)))
        .Float32 -> Val(value.bit_xor(2147483648))
        .Word -> jet_eval_ir_fixed(&s, IROp.Sub, ty, 0, value, overflow != IR_OVERFLOW_WRAP)
        else -> {
            jet_eval_ir_problem(&s, "no negation of {ir_kind_text(ty.kind)}")
            None
        }
    }
}

fn jet_eval_ir_not(s: &JetEvalIRState, ty: IRType, value: Int) -> Int? {
    if ty.kind == {
        .Bool -> Val(value.bit_xor(1))
        .Word -> Val(jet_eval_ir_wrap(value.bit_xor(-1), jet_eval_ir_word_bits(ty), ty.signed))
        .Int -> {
            a :: jet_eval_ir_int_value(&s, value) ?? return None
            Val(jet_eval_ir_int_word(&s, a.bit_xor(-1)))
        }
        else -> {
            jet_eval_ir_problem(&s, "no `not` of {ir_kind_text(ty.kind)}")
            None
        }
    }
}

// Convert by the slot types: a Float or Float32 truncates toward zero into a
// signed 64-bit word (NaN and out of range give the minimum), wrapped to the
// Word; a Word, read as signed 64-bit, rounds to nearest into a Float; the
// Float widths convert into each other.
fn jet_eval_ir_convert(s: &JetEvalIRState, from: IRType, to: IRType, value: Int) -> Int? {
    float_from :: from.kind == .Float || from.kind == .Float32
    float_to :: to.kind == .Float || to.kind == .Float32
    if float_from && to.kind == .Word {
        x :: if from.kind == .Float32 -> jet_eval_ir_float32(value) else -> jet_eval_ir_float(value)
        return Val(jet_eval_ir_wrap(jet_eval_ir_truncate(x), jet_eval_ir_word_bits(to), to.signed))
    }
    if from.kind == .Word && float_to {
        word :: jet_eval_ir_wrap(value, 64, true)
        if to.kind == .Float32 -> return Val(jet_eval_ir_float32_word(Float.from_int(jet_eval_ir_round_significand(word, 24))))
        return Val(jet_eval_ir_float_word(Float.from_int(word)))
    }
    if float_from && float_to {
        x :: if from.kind == .Float32 -> jet_eval_ir_float32(value) else -> jet_eval_ir_float(value)
        return Val(if to.kind == .Float32 -> jet_eval_ir_float32_word(x) else -> jet_eval_ir_float_word(x))
    }
    jet_eval_ir_problem(&s, "no conversion from {ir_kind_text(from.kind)} to {ir_kind_text(to.kind)}")
    None
}

// cvttsd2si: `x` truncated toward zero, the minimum signed 64-bit word when
// it is NaN or outside [-2^63, 2^63).
fn jet_eval_ir_truncate(x: Float) -> Int Never! {
    if x != x || x >= 9223372036854775808.0 || x < -9223372036854775808.0 -> return -9223372036854775807 - 1
    bits :: math.to_bits(x)
    exponent :: (bits >> 52).bit_and(2047)
    if exponent < 1023 -> return 0
    significand :: bits.bit_and(4503599627370495).bit_or(4503599627370496)
    shift :: exponent - 1075
    magnitude :: if shift >= 0 -> significand << shift else -> significand >> (0 - shift)
    if x < 0.0 -> return 0 - magnitude
    magnitude
}

// `value` rounded to nearest-even at `keep` significant bits, so a later
// Float conversion of it is exact (one rounding, as cvtsi2ss does).
fn jet_eval_ir_round_significand(value: Int, keep: Int) -> Int Never! {
    magnitude :: if value < 0 -> 0 - value else -> value
    if magnitude < jet_eval_ir_pow2(keep) -> return value
    length := keep
    loop magnitude >= jet_eval_ir_pow2(length) -> length += 1
    shift :: length - keep
    kept := magnitude >> shift
    rest :: magnitude - (kept << shift)
    half :: jet_eval_ir_pow2(shift - 1)
    if rest > half || (rest == half && kept.bit_and(1) == 1) -> kept += 1
    rounded :: kept << shift
    if value < 0 -> return 0 - rounded
    rounded
}
