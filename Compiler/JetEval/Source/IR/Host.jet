// The compiler values of a fn-build or fn-dev invocation in native
// compile-time code (Native.jet). The builder lays a compiler value type
// with no declaration (`Build`, `BuildTarget`, `ProgramInfo`, ...:
// ir_host_value_name) out as a host word, a handle (index + 1) into the
// state's host_values, and lowers its methods and fields to host routes
// (JetIR ir_host_route): a method's operands are (member, impure, (row key,
// word)...), a field's (field, row key, word). A route reads its operands
// back as compiler data by their type rows, answers the call (reflection
// and compiler value projections here, Build, BuildPlan and Dev methods by
// the invocation's build host), and writes the answer into the child as the
// IR value of the call's result row: as the builder lays the checked type
// out, with the runtime's own texts, buffers and boxes so the program owns
// and drops them as any other. Rows are read and interned in the batch's
// own rows (host_types), whose existing rows are the module's.
use {
    jet_foundation.[Span, TComptimeValue, Type, name_rows_value, type_name]
    jet_ir.[IRMember, IRModule, IRProgram, IR_OPTION_INT_NONE, ir_align8, ir_default_err, ir_enum_box_size, ir_enum_def, ir_fixed_shape, ir_host_value_row, ir_list_stride, ir_option_inline, ir_row_args, ir_struct_members, ir_tuple_members, ir_type_args, ir_type_def, ir_untag, ir_value_type, ir_variant_members]
}

// The compiler value host word `word` holds.
jet_eval_ir_host_value: fn(s: &JetEvalIRState, word: Int) -> TComptimeValue? Never! {
    if word < 1 || word > s.host_values.len() {
        jet_eval_ir_problem(s, "compiler value handle {word} is not live")
        return None
    }
    Val(s.host_values[word - 1].copy())
}

jet_eval_ir_host_types: fn(s: &JetEvalIRState) -> Shared<IRModule>? Never! {
    if s.host_types == {
        .Val(cell) -> Val(cell.copy())
        .None -> {
            jet_eval_ir_unsupported(s, "compiler values outside a fn-build or fn-dev invocation")
            None
        }
    }
}

jet_eval_ir_host_layouts: fn(s: &JetEvalIRState) -> Shared<[IRProgram]>? Never! {
    if s.host_layouts == {
        .Val(cell) -> Val(cell.copy())
        .None -> {
            jet_eval_ir_unsupported(s, "compiler values outside a fn-build or fn-dev invocation")
            None
        }
    }
}

// The words of an entry's parameters (type rows `params`) for `args`, none
// for an entry run without arguments.
jet_eval_ir_host_arguments: fn(s: &JetEvalIRState, params: [Int], args: [TComptimeValue]) -> [Int]? {
    if args.len() == 0 -> return Val([Int]{})
    if args.len() != params.len() {
        jet_eval_ir_problem(s, "the entry takes {params.len()} parameters, given {args.len()}")
        return None
    }
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    types := types_cell.guard_edit()
    layouts: layouts_cell.guard_read()
    words := [Int]{}
    loop (index, value) in args {
        words.push(jet_eval_ir_host_store(types.value, layouts.value[0], s, value, params[index], 0) ?? return None)
    }
    Val(words)
}

// jet_comptime_host_method(member, impure, start, end, (row key, word)...):
// method `member` (`Owner.method`, or `compiler.query` for a `core.compiler`
// query) on the receiver and arguments, each a word of the type row its key
// names; `impure` when the call sits in an `#Impure` block; `start` and
// `end` the call's span (ir_host_method).
jet_eval_ir_host_method_route: fn(s: &JetEvalIRState, args: [Int], dst_row: Int, area: Int) -> Int? {
    if args.len() < 4 || args.len() % 2 != 0 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_host_method")
    member: jet_eval_ir_text(s, args[0]) ?? return None
    // A build invocation's Core call inside an `#Impure` block runs between
    // the marks Impure.enter and Impure.leave (IRProgram.invocation): a
    // system call the child's filter refuses in between is that block's
    // Tier-2 effect. Impure.refuse:<what> names one such effect that makes
    // no system call, refused as it is reached.
    if member == "Impure.enter" || member == "Impure.leave" {
        s.impure_sites += if member == "Impure.enter" -> 1 else -> -1
        return Val(0)
    }
    if member.starts_with("Impure.refuse:") {
        jet_eval_ir_effect_refused(s, member.removeprefix("Impure.refuse:"), false)
        return None
    }
    parts: jet_eval_compiler_value_method_owner(member) ?? return jet_eval_ir_primitive_shape(s, "jet_comptime_host_method")
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    types := types_cell.guard_edit()
    layouts: layouts_cell.guard_read()
    values := [TComptimeValue]{}
    at := 4
    loop at < args.len() {
        row: jet_eval_ir_host_row(types.value, s, args[at]) ?? return None
        values.push(jet_eval_ir_data(types.value, layouts.value[0], s, args[at + 1], row) ?? return None)
        at += 2
    }
    fallible: dst_row >= 0 && ir_untag(types.value.types[dst_row].ty) == .Result(_, _)
    answer: jet_eval_ir_host_answer(s, parts[0], parts[1], member, values, fallible, args[1] != 0, Span{start: args[2], end: args[3]}) ?? return None
    if dst_row < 0 -> return Val(0)
    jet_eval_ir_host_store(types.value, layouts.value[0], s, answer, dst_row, area)
}

// jet_comptime_host_field(field, row key, word): field `field` of the
// compiler value `word` of the type row its key names.
jet_eval_ir_host_field_route: fn(s: &JetEvalIRState, args: [Int], dst_row: Int, area: Int) -> Int? {
    if args.len() != 3 || dst_row < 0 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_host_field")
    field: jet_eval_ir_text(s, args[0]) ?? return None
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    types := types_cell.guard_edit()
    layouts: layouts_cell.guard_read()
    row: jet_eval_ir_host_row(types.value, s, args[1]) ?? return None
    base: jet_eval_ir_data(types.value, layouts.value[0], s, args[2], row) ?? return None
    found := TComptimeValue?{None}
    if base == .Struct(_, fields) -> found = jet_eval_compiler_value_field(fields, field)
    value: found ?? {
        jet_eval_ir_problem(s, "compiler value {type_name(types.value.types[row].ty)} has no field `{field}`")
        return None
    }
    jet_eval_ir_host_store(types.value, layouts.value[0], s, value, dst_row, area)
}

// jet_comptime_host_constant(key): comptime constant `key`, whose value
// holds a compiler value: its computed value, from the constant row the
// batch was built over (ir_host_constant).
jet_eval_ir_host_constant_route: fn(s: &JetEvalIRState, args: [Int], dst_row: Int, area: Int) -> Int? {
    if args.len() != 1 || dst_row < 0 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_host_constant")
    key: jet_eval_ir_text(s, args[0]) ?? return None
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    types := types_cell.guard_edit()
    layouts: layouts_cell.guard_read()
    at: layouts.value[0].constants.get(key) ?? {
        jet_eval_ir_problem(s, "compiler value constant {key} has no constant row")
        return None
    }
    jet_eval_ir_host_store(types.value, layouts.value[0], s, layouts.value[0].constant_defs[at].value, dst_row, area)
}

// jet_comptime_host_literal(key): a compile-time literal that is a compiler
// value, which the built module keeps under `key` (ir_host_literal).
jet_eval_ir_host_literal_route: fn(s: &JetEvalIRState, args: [Int], dst_row: Int, area: Int) -> Int? {
    if args.len() != 1 || dst_row < 0 -> return jet_eval_ir_primitive_shape(s, "jet_comptime_host_literal")
    key: jet_eval_ir_text(s, args[0]) ?? return None
    types_cell: jet_eval_ir_host_types(s) ?? return None
    layouts_cell: jet_eval_ir_host_layouts(s) ?? return None
    types := types_cell.guard_edit()
    layouts: layouts_cell.guard_read()
    found: types.value.host_literals.get(key) ?? {
        jet_eval_ir_problem(s, "compiler value literal {key} is not in the built module")
        return None
    }
    // copy: the store below edits the module `found` reads
    value: found.copy()
    jet_eval_ir_host_store(types.value, layouts.value[0], s, value, dst_row, area)
}

// The type row of `types` whose intern key is the String at `key` (the
// builder's ir_host_row_key).
jet_eval_ir_host_row: fn(types: IRModule, s: &JetEvalIRState, key: Int) -> Int? Never! {
    text: jet_eval_ir_text(s, key) ?? return None
    if name_rows_value(types.type_rows, text) == .Val(row) -> return Val(row)
    jet_eval_ir_problem(s, "host operand type `{text}` is not a row of the module")
    None
}

// The answer of `owner.method` (`member`) on `values`, the receiver first:
// a reflection predicate or compiler value projection, a `core.compiler`
// query (owner `compiler`, no receiver) the compiler's query host answers,
// or the build host's, which places its record or failure at the call's
// `span`. `BuildError.into_err` is the default Err a BuildError converts to
// (JetIR ir_try_reraise): its own record, which already is that Err.
jet_eval_ir_host_answer: fn(s: &JetEvalIRState, owner: String, method: String, member: String, values: [TComptimeValue], fallible: Bool, impure: Bool, span: Span) -> TComptimeValue? {
    if owner == "compiler" -> return jet_eval_ir_compiler_query(s, method, values, span)
    if member == "BuildError.into_err" && values.len() == 1 -> return Val(values[0])
    if jet_eval_reflection_metadata_supported(owner, method) -> return jet_eval_ir_host_projection(s, jet_eval_reflection_answer(owner, method, values))
    if jet_eval_compiler_value_method_supported(owner, method, values.len() - 1) -> return jet_eval_ir_host_projection(s, jet_eval_compiler_value_answer(owner, method, values))
    adapter: if s.host_adapter == {
        .Val(installed) -> installed.clone_adapter()
        .None -> {
            jet_eval_ir_unsupported(s, "compiler host method {member} without a build host")
            return None
        }
    }
    reply: adapter.build_call(member, values, fallible, impure, span) ?? {
        jet_eval_ir_unsupported(s, "compiler host method {member}")
        return None
    }
    jet_eval_ir_host_reply(s, reply)
}

// `core.compiler` query `query` on `values`: the compiler's query host
// answers it, the typed result (a CompilerError failure included) or the
// diagnostic that stops the evaluation.
jet_eval_ir_compiler_query: fn(s: &JetEvalIRState, query: String, values: [TComptimeValue], span: Span) -> TComptimeValue? {
    host: if s.compiler == {
        .Val(installed) -> installed.clone_compiler_host()
        .None -> {
            if s.failure == None -> s.failure = Val(jet_eval_diagnostic(JetEvalErrorKind.Effect, span, "`compiler.{query}` can't run here", "this evaluation has no compiler query host", "call `core.compiler` from a comptime item or fn build that `jet build` or `jet run` compiles"))
            return None
        }
    }
    reply: host.compiler_query(query, values, span) ?? {
        jet_eval_ir_unsupported(s, "compiler query compiler.{query}")
        return None
    }
    jet_eval_ir_host_reply(s, reply)
}

jet_eval_ir_host_reply: fn(s: &JetEvalIRState, reply: JetEvalBuildReply) -> TComptimeValue? Never! {
    if reply == {
        .Value(value) -> Val(value)
        .Failure(diagnostic) -> {
            if s.failure == None -> s.failure = Val(JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic})
            None
        }
    }
}

jet_eval_ir_host_projection: fn(s: &JetEvalIRState, answer: JetEvalCompilerValueAnswer) -> TComptimeValue? Never! {
    if answer == {
        .Value(value) -> Val(value)
        .Fault(message) -> {
            jet_eval_ir_problem(s, message)
            None
        }
    }
}

jet_eval_ir_host_unwritable: fn(s: &JetEvalIRState, value: TComptimeValue, ty: Type) Never! {
    jet_eval_ir_unsupported(s, "writing compiler value {value} as an IR value of {type_name(ty)}")
}

// The IR word of compiler value `value` as type row `row` of `types`, laid
// out by `p`: a host row's handle, a scalar, a runtime text or box; an
// aggregate written to `area` (its own storage when 0), which is its word.
jet_eval_ir_host_store: fn(types: &IRModule, p: IRProgram, s: &JetEvalIRState, value: TComptimeValue, row: Int, area: Int) -> Int? {
    if ir_host_value_row(types, p, row) != None {
        s.host_values.push(value.copy())
        return Val(s.host_values.len())
    }
    ty: types.types[row]
    checked: ir_untag(ty.ty)
    if ir_default_err(p, checked) -> return jet_eval_ir_err_word(s, p, checked, value)
    if ty.kind == {
        .Unit -> return Val(0)
        .Bool -> {
            if value == .Bool(flag) -> return Val(if flag -> 1 else -> 0)
        }
        .Int -> {
            if value == .Int(number) -> return jet_eval_ir_host_int(s, number)
        }
        .Char -> {
            if value == .Char(code) -> return Val(code)
        }
        .String -> {
            if value == .String(text) -> return jet_eval_ir_store_text(s, text)
        }
        .Word -> {
            // An inline Option: None is the niche word, Some its payload's word.
            if checked == .Option(inner) && ir_option_inline(types, row) {
                if value == .Failed(_) -> return Val(IR_OPTION_INT_NONE)
                payload: if value == .Present(present) -> present else -> value
                inner_row: ir_value_type(types, p, inner) ?? {
                    jet_eval_ir_host_unwritable(s, value, checked)
                    return None
                }
                return jet_eval_ir_host_store(types, p, s, payload, inner_row, 0)
            }
            if ir_enum_def(types, p, row) == .Val(definition) {
                if value == .Enum(_, variant, _) -> return jet_eval_ir_host_variant(s, p, definition, variant)
            } else if value == .Int(number) {
                return Val(number)
            }
        }
        .Pointer -> return jet_eval_ir_host_box(types, p, s, value, row)
        .Aggregate -> {
            target: if area != 0 -> area else -> jet_eval_native_alloc(s, ty.size, 8) ?? return None
            if !jet_eval_ir_host_fill(types, p, s, value, row, target) -> return None
            return Val(target)
        }
        else -> {}
    }
    jet_eval_ir_host_unwritable(s, value, checked)
    None
}

// The index of variant `variant` of enum declaration `definition`.
jet_eval_ir_host_variant: fn(s: &JetEvalIRState, p: IRProgram, definition: Int, variant: String) -> Int? Never! {
    declaration: p.types[definition]
    if declaration.kind == .Enum(variants, _) {
        loop (index, row) in variants {
            if row.name == variant -> return Val(index)
        }
    }
    jet_eval_ir_problem(s, "{declaration.name} has no variant {variant}")
    None
}

// The word of a pointer row: an Option (0 when absent), a Result box
// (selector 1 for success at 0, the payload at 8) or a boxed enum case
// (discriminant at 0, its payload members).
jet_eval_ir_host_box: fn(types: &IRModule, p: IRProgram, s: &JetEvalIRState, value: TComptimeValue, row: Int) -> Int? {
    checked: ir_untag(types.types[row].ty)
    if checked == .Option(inner) {
        if value == .Failed(_) -> return Val(0)
        payload: if value == .Present(present) -> present else -> value
        inner_row: ir_value_type(types, p, inner) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        boxed: jet_eval_ir_host_alloc(s, types.types[inner_row].size) ?? return None
        if !jet_eval_ir_host_put(types, p, s, payload, inner_row, boxed) -> return None
        return Val(boxed)
    }
    if checked == .Result(ok_ty, err_ty) {
        success := true
        if value == .Failed(_) -> success = false
        payload: if value == {
            .Present(present) -> present
            .Failed(report) -> {
                if report == .Told(told) -> told else -> {
                    jet_eval_ir_host_unwritable(s, value, checked)
                    return None
                }
            }
            else -> value
        }
        ok_row: ir_value_type(types, p, ok_ty) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        err_row: ir_value_type(types, p, err_ty) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        widest: if types.types[ok_row].size > types.types[err_row].size -> types.types[ok_row].size else -> types.types[err_row].size
        boxed: jet_eval_ir_host_alloc(s, 8 + ir_align8(widest)) ?? return None
        if !jet_eval_ir_write(s, boxed, 8, if success -> 1 else -> 0) -> return None
        if !jet_eval_ir_host_put(types, p, s, payload, if success -> ok_row else -> err_row, boxed + 8) -> return None
        return Val(boxed)
    }
    if ir_enum_def(types, p, row) == .Val(definition) && value == .Enum(_, variant, cases) {
        index: jet_eval_ir_host_variant(s, p, definition, variant) ?? return None
        type_args: ir_row_args(types, row)
        size: ir_enum_box_size(types, p, definition, type_args) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        members: ir_variant_members(types, p, definition, type_args, index) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        if members.len() != cases.len() {
            jet_eval_ir_host_unwritable(s, value, checked)
            return None
        }
        boxed: jet_eval_ir_host_alloc(s, size) ?? return None
        if !jet_eval_ir_write(s, boxed, 8, index) -> return None
        loop (position, member) in members {
            if !jet_eval_ir_host_member(types, p, s, cases[position].value, member, boxed) -> return None
        }
        return Val(boxed)
    }
    jet_eval_ir_host_unwritable(s, value, checked)
    None
}

// Writes `value` of type row `row` at `address`: an aggregate in place,
// anything else as its word.
jet_eval_ir_host_put: fn(types: &IRModule, p: IRProgram, s: &JetEvalIRState, value: TComptimeValue, row: Int, address: Int) -> Bool {
    if types.types[row].kind == .Aggregate -> return jet_eval_ir_host_fill(types, p, s, value, row, address)
    word: jet_eval_ir_host_store(types, p, s, value, row, 0) ?? return false
    width: jet_eval_ir_width(types.types[row])
    width == 0 || jet_eval_ir_write(s, address, width, word)
}

// Writes `value` as member `member` of the storage at `base`: in place, or
// in a box of its own when the member is boxed.
jet_eval_ir_host_member: fn(types: &IRModule, p: IRProgram, s: &JetEvalIRState, value: TComptimeValue, member: IRMember, base: Int) -> Bool {
    if !member.boxed -> return jet_eval_ir_host_put(types, p, s, value, member.ty, base + member.offset)
    holder: jet_eval_ir_host_alloc(s, types.types[member.ty].size) ?? return false
    if !jet_eval_ir_write(s, base + member.offset, 8, holder) -> return false
    jet_eval_ir_host_put(types, p, s, value, member.ty, holder)
}

// Writes the aggregate `value` of type row `row` at `address`: a List
// header over a runtime buffer, or a tuple's or struct's members.
jet_eval_ir_host_fill: fn(types: &IRModule, p: IRProgram, s: &JetEvalIRState, value: TComptimeValue, row: Int, address: Int) -> Bool {
    checked: ir_untag(types.types[row].ty)
    if ir_fixed_shape(types, p, row) == .Val(shape) {
        // An inline `[T#N]` takes its N elements in place.
        items: if value == .List(values) -> values else -> {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
        if items.len() != shape.count {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
        loop (index, item) in items {
            if !jet_eval_ir_host_put(types, p, s, item, shape.element, address + index * shape.stride) -> return false
        }
        return true
    }
    if checked == .List(element) {
        items: if value == .List(values) -> values else -> {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
        element_row: ir_value_type(types, p, element) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
        stride: ir_list_stride(types, element_row)
        data := 0
        if items.len() > 0 -> data = jet_eval_native_alloc(s, stride * items.len(), 8) ?? return false
        loop (index, item) in items {
            if !jet_eval_ir_host_put(types, p, s, item, element_row, data + index * stride) -> return false
        }
        return jet_eval_ir_write(s, address, 8, items.len()) && jet_eval_ir_write(s, address + 8, 8, items.len()) && jet_eval_ir_write(s, address + 16, 8, data)
    }
    members := [IRMember]{}
    if checked == .Tuple(tuple_fields) {
        members = ir_tuple_members(types, p, tuple_fields) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
    } else {
        name: if checked == {
            .Named(name) -> name
            .Apply(name, _) -> name
            else -> {
                jet_eval_ir_host_unwritable(s, value, checked)
                return false
            }
        }
        definition: ir_type_def(p, name) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
        members = ir_struct_members(types, p, definition, ir_type_args(checked)) ?? {
            jet_eval_ir_host_unwritable(s, value, checked)
            return false
        }
    }
    fields: if value == .Struct(_, written) -> written else -> {
        jet_eval_ir_host_unwritable(s, value, checked)
        return false
    }
    loop member in members {
        field: jet_eval_compiler_value_field(fields, member.name) ?? {
            jet_eval_ir_problem(s, "compiler value {type_name(checked)} lacks member `{member.name}`")
            return false
        }
        if !jet_eval_ir_host_member(types, p, s, field, member, address) -> return false
    }
    true
}
