// Value transport between native compile-time memory (Native.jet) and
// checked compile-time data: the result of an evaluation read back by its
// checked type through the builder's layouts (JetIR Build.jet): a struct by
// its declaration's name, an enum case by its variant name, Some/Ok as
// Present, None as a clean failure and Err as a told one, a fixed-width
// integer as an Int.
use {
    jet_foundation.[DeclTable, TComptimeEnumArg, TComptimeField, TComptimeKey, TComptimeKeyField, TComptimeMapEntry, TComptimeReport, TComptimeValue, TConstantDef, TImplDef, TTypeDef, Type, compiler_threads_single, checked_comptime_integer_key, name_rows_value, type_name, FnBody]
    jet_ir.[IRBuildFailure, IRMember, IRModule, IRProgram, IR_OPTION_INT_NONE, ir_build_roots_in, ir_declared_field_type, ir_default_err, ir_default_err_drift, ir_enum_def, ir_fixed_shape, ir_foreign_index, ir_host_value_row, ir_list_stride, ir_map_row_hashed, ir_map_shape, ir_option_inline, ir_program_bind, ir_program_new, ir_program_put_constant, ir_row_args, ir_static_map_order, ir_struct_members, ir_tuple_members, ir_type_args, ir_type_def, ir_untag, ir_value_type, ir_variant_members]
    jet_sema.[SemaCheckedForeignFunction]
    jet_backend.[ERR_BYTES, ERR_CAUSE, ERR_CODE, ERR_CONTEXT, ERR_CONTEXT_BYTES, ERR_CONVERSIONS, ERR_CONVERSION_BYTES, ERR_DETAILS, ERR_DETAILS_BYTES, ERR_DETAILS_END, ERR_DETAILS_FIELDS, ERR_DETAILS_HAS_SPAN, ERR_DETAILS_START, ERR_DETAILS_VARIANT, ERR_FIELD_BYTES, ERR_IDENTITY, ERR_MESSAGE]
}

// What one IR evaluation produced: its value (when it completed with data),
// the failure it reports, and its output.
JetEvalIRResult: struct {
    value: TComptimeValue?
    complete: Bool
    error: JetEvalError?
    internal_problem: JetEvalInternalProblem?
    stdout: String
    stderr: String
    exit_code: Int?
    steps: Int
}

// The IR of comptime items: the checked functions they reach and the item
// functions (zero-parameter functions returning the items' expressions)
// built together, `items` holding each item's function, in order, and
// `layouts` (its one row) the program they were built from, which their
// values read back by; or the builder failures (`build_failures`, one line
// per failing function) that keep them from running at all.
JetEvalIRComptime: struct {
    code: IRModule
    layouts: Shared<[IRProgram]>
    items: [Int]
    build_failures: [String]
}

// Builds `functions` from the roots `item_keys`; `type_defs`, `impls` and
// `constants` are the checked modules' declarations the builder lays values
// out by, `decls` the run's declaration table their direct calls name. A
// comptime value reads no source text (a `#Todo` stop carries the line the
// checker gave it) and links no C closure, so the build has no source files
// and its `foreign` rows (the foreign functions the checked closure reaches)
// lower to a stop (ir_foreign_comptime_stop).
// `comptime_values` when the roots compute compile-time values (not a build
// invocation): ambient reads with no system call are refused while building
// (IRProgram.comptime_values); otherwise the roots are a build invocation
// (IRProgram.invocation).
jet_eval_ir_comptime_build: fn(functions: &&[FnBody], decls: DeclTable, item_keys: [String], type_defs: &&[TTypeDef], impls: &&[TImplDef], constants: &&[TConstantDef], foreign: &&[SemaCheckedForeignFunction], comptime_values: Bool) -> JetEvalIRComptime {
    program := ir_program_new(functions, decls, type_defs, impls, [String:String]{}, constants)
    program.comptime_values = comptime_values
    program.invocation = !comptime_values
    ir_foreign_index(program, foreign, decls)
    jet_eval_ir_comptime_roots(shared [IRProgram]{}, program, item_keys)
}

// Builds `functions` from the roots `item_keys` over the declared program
// `declared` holds (ir_program_declared, its one row), which holds it again
// after, bound to them and to their `foreign` rows: one program serves a
// run's every batch. `landed` (rows of compile-time values landed since its
// last build) take over its constant rows first, each key once (`taken`:
// the keys taken over).
jet_eval_ir_comptime_build_over: fn(declared: Shared<[IRProgram]>, functions: &&[FnBody], decls: DeclTable, item_keys: [String], landed: &&[TConstantDef], foreign: &&[SemaCheckedForeignFunction], taken: &[String:Bool]) -> JetEvalIRComptime {
    program := jet_eval_ir_program_take(declared)
    program.comptime_values = true
    loop definition in landed.move() -> ir_program_put_constant(program, definition, taken)
    ir_program_bind(program, functions, decls)
    ir_foreign_index(program, foreign, decls)
    jet_eval_ir_comptime_roots(declared, program, item_keys)
}

// Builds the roots `item_keys` of `program`, which `cell` then holds.
jet_eval_ir_comptime_roots: fn(cell: Shared<[IRProgram]>, program: &&IRProgram, item_keys: [String]) -> JetEvalIRComptime {
    kept := ir_build_roots_in(program, item_keys, compiler_threads_single())
    jet_eval_ir_program_put(cell, kept.program.move())
    built := kept.result.move()
    lines := [String]{}
    loop failure in built.failures -> lines.push(jet_eval_ir_build_failure_text(failure))
    items := [Int]{}
    loop key in item_keys -> items.push(name_rows_value(built.program.function_rows, key) ?? -1)
    JetEvalIRComptime{code: built.program.move(), layouts: cell, items: items.move(), build_failures: lines.move()}
}

// The program `cell` holds (its one row), moved out.
jet_eval_ir_program_take: fn(cell: Shared<[IRProgram]>) -> IRProgram Never! {
    held := cell.guard_edit()
    program := held.value.pop() ?? panic("the comptime program cell is empty")
    program.move()
}

jet_eval_ir_program_put: fn(cell: Shared<[IRProgram]>, program: &&IRProgram) {
    held := cell.guard_edit()
    held.value.push(program)
}

jet_eval_ir_build_failure_text: fn(failure: IRBuildFailure) -> String Never! {
    "{failure.name} [{failure.key}]: {failure.message}"
}

// The data of the word `word` of type row `row`.
jet_eval_ir_data: fn(m: &IRModule, p: IRProgram, s: &JetEvalIRState, word: Int, row: Int) -> TComptimeValue? {
    ty: m.types[row]
    checked: ir_untag(ty.ty)
    if ty.kind == {
        .Unit -> return Val(TComptimeValue.Unit)
        .Bool -> return Val(TComptimeValue.Bool{value: word != 0})
        .Int -> {
            value: jet_eval_ir_int_value(s, word) ?? return None
            // An Int outside 64 bits is a BigInt decimal.
            if !jet_eval_ir_in_range(value, 64, true) -> return Val(TComptimeValue.BigInt{decimal: "{value}"})
            return Val(TComptimeValue.Int{value: value})
        }
        .Char -> return Val(TComptimeValue.Char{value: word})
        .Float -> return Val(TComptimeValue.Float{value: jet_eval_ir_float(word), bits: 64})
        .Float32 -> return Val(TComptimeValue.Float{value: jet_eval_ir_float32(word), bits: 32})
        .String -> {
            text: jet_eval_ir_text(s, word) ?? return None
            return Val(TComptimeValue.String{value: text})
        }
        .Word -> {
            // An inline Option: the niche word is None, any other its payload's.
            if checked == .Option(inner) && ir_option_inline(m, row) {
                if word == IR_OPTION_INT_NONE -> return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: jet_eval_ir_type_display(inner)}}})
                inner_row: ir_value_type(m, p, inner) ?? return jet_eval_ir_transport_fail(s, checked)
                value: jet_eval_ir_data(m, p, s, word, inner_row) ?? return None
                return Val(TComptimeValue.Present{value: value})
            }
            if ir_host_value_row(m, p, row) != None -> return jet_eval_ir_host_value(s, word)
            if ir_enum_def(m, p, row) == .Val(definition) {
                args: ir_row_args(m, row)
                return jet_eval_ir_enum_data(m, p, s, definition, args, word, word, false)
            }
            return Val(TComptimeValue.Int{value: word})
        }
        .Pointer -> {
            if checked == .Option(inner) {
                inner_row: ir_value_type(m, p, inner) ?? return jet_eval_ir_transport_fail(s, checked)
                if word == 0 -> return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: jet_eval_ir_type_display(inner)}}})
                payload: jet_eval_ir_member_word(m, s, word, 0, inner_row) ?? return None
                value: jet_eval_ir_data(m, p, s, payload, inner_row) ?? return None
                return Val(TComptimeValue.Present{value: value})
            }
            if checked == .Result(ok_ty, err_ty) {
                selector: jet_eval_ir_read(s, word, 8) ?? return None
                payload_ty: if selector == 1 -> ok_ty else -> err_ty
                payload_row: ir_value_type(m, p, payload_ty) ?? return jet_eval_ir_transport_fail(s, checked)
                payload: jet_eval_ir_member_word(m, s, word, 8, payload_row) ?? return None
                value: jet_eval_ir_data(m, p, s, payload, payload_row) ?? return None
                if selector == 1 -> return Val(TComptimeValue.Present{value: value})
                return Val(TComptimeValue.Failed{report: TComptimeReport.Told{value: value}})
            }
            if ir_enum_def(m, p, row) == .Val(definition) {
                discriminant: jet_eval_ir_read(s, word, 8) ?? return None
                args: ir_row_args(m, row)
                return jet_eval_ir_enum_data(m, p, s, definition, args, discriminant, word, true)
            }
            // A Fraction of a program without core.math is its runtime
            // handle: two exact-Int words, numerator@0 and denominator@8
            // (JetRuntime RoutePrecise.jet). It reads back as the Core
            // declaration's fields, the value a core.math program lays out.
            if checked == (Type.Named{name: "Fraction"}) && ir_type_def(p, "Fraction") == None {
                int_row: ir_value_type(m, p, Type.Int) ?? return jet_eval_ir_transport_fail(s, checked)
                top: jet_eval_ir_member_word(m, s, word, 0, int_row) ?? return None
                bottom: jet_eval_ir_member_word(m, s, word, 8, int_row) ?? return None
                numerator: jet_eval_ir_data(m, p, s, top, int_row) ?? return None
                denominator: jet_eval_ir_data(m, p, s, bottom, int_row) ?? return None
                return Val(TComptimeValue.Struct{type_name: "Fraction", fields: [TComptimeField]{TComptimeField{name: "num_value", value: numerator}, TComptimeField{name: "den_value", value: denominator}}})
            }
            // A Decimal of a program without core.math is its runtime handle:
            // the signed exact-Int coefficient@0 and the plain-word scale@8
            // (RoutePrecise.jet). It reads back as the Core declaration's
            // fields.
            if checked == (Type.Named{name: "Decimal"}) && ir_type_def(p, "Decimal") == None {
                int_row: ir_value_type(m, p, Type.Int) ?? return jet_eval_ir_transport_fail(s, checked)
                top: jet_eval_ir_member_word(m, s, word, 0, int_row) ?? return None
                coefficient: jet_eval_ir_int_value(s, top) ?? return None
                scale: jet_eval_ir_read(s, word + 8, 8) ?? return None
                magnitude: if coefficient < 0 -> -coefficient else -> coefficient
                digits: if jet_eval_ir_in_range(magnitude, 64, true) -> TComptimeValue.Int{value: magnitude} else -> TComptimeValue.BigInt{decimal: "{magnitude}"}
                return Val(TComptimeValue.Struct{type_name: "Decimal", fields: [TComptimeField]{TComptimeField{name: "negative", value: TComptimeValue.Bool{value: coefficient < 0}}, TComptimeField{name: "magnitude", value: digits}, TComptimeField{name: "scale", value: TComptimeValue.Int{value: scale}}}})
            }
            if ir_default_err(p, checked) -> return jet_eval_ir_err_data(s, p, checked, word)
            return jet_eval_ir_transport_fail(s, checked)
        }
        .Aggregate -> {
            if ir_fixed_shape(m, p, row) == .Val(shape) {
                // An inline `[T#N]` holds its N elements in place.
                values := [TComptimeValue]{}
                loop index in 0..<shape.count {
                    item: jet_eval_ir_member_word(m, s, word, index * shape.stride, shape.element) ?? return None
                    values.push(jet_eval_ir_data(m, p, s, item, shape.element) ?? return None)
                }
                return Val(TComptimeValue.List{values: values})
            }
            if checked == .List(element) {
                element_row: ir_value_type(m, p, element) ?? return jet_eval_ir_transport_fail(s, checked)
                length: jet_eval_ir_read(s, word, 8) ?? return None
                values := [TComptimeValue]{}
                if length > 0 {
                    data: jet_eval_ir_read(s, word + 16, 8) ?? return None
                    stride: ir_list_stride(m, element_row)
                    loop index in 0..<length {
                        item: jet_eval_ir_member_word(m, s, data, index * stride, element_row) ?? return None
                        values.push(jet_eval_ir_data(m, p, s, item, element_row) ?? return None)
                    }
                }
                return Val(TComptimeValue.List{values: values})
            }
            if checked == .Map(_, _, _) {
                // A Map is the List of its (key, value) entries in key order.
                shape: ir_map_shape(m, p, row) ?? return jet_eval_ir_transport_fail(s, checked)
                key_ty: m.types[shape.key.ty].ty.copy()
                length: jet_eval_ir_read(s, word, 8) ?? return None
                entries := [TComptimeMapEntry]{}
                if length > 0 {
                    data: jet_eval_ir_read(s, word + 16, 8) ?? return None
                    loop index in 0..<length {
                        entry: jet_eval_ir_member_word(m, s, data, index * shape.stride, shape.entry) ?? return None
                        key_value: jet_eval_ir_member_value(m, p, s, entry, shape.key) ?? return None
                        key: jet_eval_ir_key(m, p, key_value, key_ty) ?? return jet_eval_ir_transport_fail(s, checked)
                        value: jet_eval_ir_member_value(m, p, s, entry, shape.value) ?? return None
                        entries.push(TComptimeMapEntry{key: key, value: value})
                    }
                }
                // A hashed Map keeps entries it gained after its last
                // rebuild out of key order.
                if ir_map_row_hashed(m, p, row) {
                    order: ir_static_map_order(shape.kind, entries) ?? return jet_eval_ir_transport_fail(s, checked)
                    ordered := [TComptimeMapEntry]{}
                    loop at in order -> ordered.push(entries[at].copy())
                    return Val(TComptimeValue.Map{entries: ordered})
                }
                return Val(TComptimeValue.Map{entries: entries})
            }
            if checked == .Tuple(fields) {
                members: ir_tuple_members(m, p, fields) ?? return jet_eval_ir_transport_fail(s, checked)
                output: jet_eval_ir_fields(m, p, s, word, members) ?? return None
                return Val(TComptimeValue.Struct{type_name: type_name(checked), fields: output})
            }
            name: if checked == {
                .Named(name) -> name
                .Apply(name, _) -> name
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> { return jet_eval_ir_transport_fail(s, checked) }
            }
            definition: ir_type_def(p, name) ?? return jet_eval_ir_transport_fail(s, checked)
            members: ir_struct_members(m, p, definition, ir_type_args(checked)) ?? return jet_eval_ir_transport_fail(s, checked)
            output: jet_eval_ir_fields(m, p, s, word, members) ?? return None
            return Val(TComptimeValue.Struct{type_name: p.types[definition].name.copy(), fields: output})
        }
    }
}

jet_eval_ir_transport_fail: fn(s: &JetEvalIRState, ty: Type) -> TComptimeValue? Never! {
    jet_eval_ir_unsupported(s, "materializing an IR value of type {type_name(ty)}")
    None
}

// A default Err read back from its native JetErr (JetBackend ErrLayout.jet)
// as the record its checked declaration spells, which ir_default_err_drift
// holds to that layout: message, code, cause and the metadata record (typed
// identity, context frames, conversion history, details).
jet_eval_ir_err_data: fn(s: &JetEvalIRState, p: IRProgram, ty: Type, error: Int) -> TComptimeValue? {
    if ir_default_err_drift(p, ty) == .Val(drift) {
        jet_eval_ir_problem(s, "the default Err declaration against the native JetErr: {drift}")
        return None
    }
    message: jet_eval_ir_err_text(s, error, ERR_MESSAGE) ?? return None
    code: jet_eval_ir_err_optional_text(s, error, ERR_CODE) ?? return None
    cause_word: jet_eval_ir_read_word(s, error + Int.from_i64(ERR_CAUSE)) ?? return None
    cause: if cause_word == 0 -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: ty.copy()}} else -> TComptimeValue.Present{value: jet_eval_ir_err_data(s, p, ty, cause_word) ?? return None}
    identity: jet_eval_ir_err_optional_text(s, error, ERR_IDENTITY) ?? return None
    frames: jet_eval_ir_err_rows(s, error + Int.from_i64(ERR_CONTEXT), Int.from_i64(ERR_CONTEXT_BYTES), "__jet_ErrorContextFrame", [String]{"text", "file"}, Val("line")) ?? return None
    conversions: jet_eval_ir_err_rows(s, error + Int.from_i64(ERR_CONVERSIONS), Int.from_i64(ERR_CONVERSION_BYTES), "__jet_ErrorConversion", [String]{"source", "target"}, None) ?? return None
    details_word: jet_eval_ir_read_word(s, error + Int.from_i64(ERR_DETAILS)) ?? return None
    details := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "__jet_ErrorDetails"}}}
    if details_word != 0 {
        variant: jet_eval_ir_err_text(s, details_word, ERR_DETAILS_VARIANT) ?? return None
        fields: jet_eval_ir_err_rows(s, details_word + Int.from_i64(ERR_DETAILS_FIELDS), Int.from_i64(ERR_FIELD_BYTES), "__jet_ErrorField", [String]{"name", "value"}, None) ?? return None
        has_span: jet_eval_ir_read_word(s, details_word + Int.from_i64(ERR_DETAILS_HAS_SPAN)) ?? return None
        source_span := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "__jet_ErrorSpan"}}}
        if has_span != 0 {
            start: jet_eval_ir_read_word(s, details_word + Int.from_i64(ERR_DETAILS_START)) ?? return None
            end: jet_eval_ir_read_word(s, details_word + Int.from_i64(ERR_DETAILS_END)) ?? return None
            source_span = TComptimeValue.Present{value: TComptimeValue.Struct{type_name: "__jet_ErrorSpan", fields: [TComptimeField]{
                {name: "start", value: TComptimeValue.Int{value: start}},
                {name: "end", value: TComptimeValue.Int{value: end}},
            }}}
        }
        details = TComptimeValue.Present{value: TComptimeValue.Struct{type_name: "__jet_ErrorDetails", fields: [TComptimeField]{
            {name: "variant", value: variant},
            {name: "fields", value: fields},
            {name: "source_span", value: source_span},
        }}}
    }
    metadata: TComptimeValue.Struct{type_name: "__jet_ErrorMetadata", fields: [TComptimeField]{
        {name: "typed_identity", value: identity},
        {name: "context_frames", value: frames},
        {name: "conversion_history", value: conversions},
        {name: "details", value: details},
    }}
    Val(TComptimeValue.Struct{type_name: type_name(ty), fields: [TComptimeField]{
        {name: "message", value: message},
        {name: "code", value: code},
        {name: "cause", value: cause},
        {name: "__jet___memo_error_metadata", value: metadata},
    }})
}

// The String whose header word is at byte `offset` of `base`.
jet_eval_ir_err_text: fn(s: &JetEvalIRState, base: Int, offset: I64) -> TComptimeValue? {
    header: jet_eval_ir_read_word(s, base + Int.from_i64(offset)) ?? return None
    text: jet_eval_ir_text(s, header) ?? return None
    Val(TComptimeValue.String{value: text})
}

// The `String?` whose header word (0: none) is at byte `offset` of `base`.
jet_eval_ir_err_optional_text: fn(s: &JetEvalIRState, base: Int, offset: I64) -> TComptimeValue? {
    header: jet_eval_ir_read_word(s, base + Int.from_i64(offset)) ?? return None
    if header == 0 -> return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.String}})
    text: jet_eval_ir_text(s, header) ?? return None
    Val(TComptimeValue.Present{value: TComptimeValue.String{value: text}})
}

// The native inline List at `list` (length, capacity, data) of `stride`-byte
// rows, each read as a `record` of the texts `texts` names in order, then the
// Int `number` names.
jet_eval_ir_err_rows: fn(s: &JetEvalIRState, list: Int, stride: Int, record: String, texts: [String], number: String?) -> TComptimeValue? {
    count: jet_eval_ir_read_word(s, list) ?? return None
    data: jet_eval_ir_read_word(s, list + 16) ?? return None
    rows := [TComptimeValue]{}
    loop index in 0..<count {
        row: data + index * stride
        fields := [TComptimeField]{}
        loop (position, name) in texts {
            header: jet_eval_ir_read_word(s, row + position * 8) ?? return None
            text: jet_eval_ir_text(s, header) ?? return None
            fields.push(TComptimeField{name: name.copy(), value: TComptimeValue.String{value: text}})
        }
        if number == .Val(name) {
            word: jet_eval_ir_read_word(s, row + texts.len() * 8) ?? return None
            fields.push(TComptimeField{name: name.copy(), value: TComptimeValue.Int{value: word}})
        }
        rows.push(TComptimeValue.Struct{type_name: record.copy(), fields: fields.move()})
    }
    Val(TComptimeValue.List{values: rows.move()})
}

// The native JetErr of default Err record `value`, the inverse of
// jet_eval_ir_err_data: a compiler value that is an Err (a BuildError's
// record) keeps its typed identity, context, conversions and details when
// compile-time code converts it to the default Err.
jet_eval_ir_err_word: fn(s: &JetEvalIRState, p: IRProgram, ty: Type, value: TComptimeValue) -> Int? {
    if ir_default_err_drift(p, ty) == .Val(drift) {
        jet_eval_ir_problem(s, "the default Err declaration against the native JetErr: {drift}")
        return None
    }
    fields: jet_eval_ir_err_record(s, value) ?? return None
    error: jet_eval_ir_err_zeroed(s, Int.from_i64(ERR_BYTES)) ?? return None
    message: jet_eval_ir_err_member(s, fields, "message") ?? return None
    if !jet_eval_ir_err_put_text(s, error + Int.from_i64(ERR_MESSAGE), message) -> return None
    code: jet_eval_ir_err_member(s, fields, "code") ?? return None
    if !jet_eval_ir_err_put_optional_text(s, error + Int.from_i64(ERR_CODE), code) -> return None
    cause: jet_eval_ir_err_member(s, fields, "cause") ?? return None
    if cause == .Present(inner) {
        cause_word: jet_eval_ir_err_word(s, p, ty, inner) ?? return None
        if !jet_eval_ir_write(s, error + Int.from_i64(ERR_CAUSE), 8, cause_word) -> return None
    }
    metadata_value: jet_eval_ir_err_member(s, fields, "__jet___memo_error_metadata") ?? return None
    metadata: jet_eval_ir_err_record(s, metadata_value) ?? return None
    identity: jet_eval_ir_err_member(s, metadata, "typed_identity") ?? return None
    if !jet_eval_ir_err_put_optional_text(s, error + Int.from_i64(ERR_IDENTITY), identity) -> return None
    frames: jet_eval_ir_err_member(s, metadata, "context_frames") ?? return None
    if !jet_eval_ir_err_put_rows(s, error + Int.from_i64(ERR_CONTEXT), Int.from_i64(ERR_CONTEXT_BYTES), frames, [String]{"text", "file"}, Val("line")) -> return None
    conversions: jet_eval_ir_err_member(s, metadata, "conversion_history") ?? return None
    if !jet_eval_ir_err_put_rows(s, error + Int.from_i64(ERR_CONVERSIONS), Int.from_i64(ERR_CONVERSION_BYTES), conversions, [String]{"source", "target"}, None) -> return None
    details: jet_eval_ir_err_member(s, metadata, "details") ?? return None
    if details == .Failed(_) -> return Val(error)
    holder: jet_eval_ir_err_details(s, details) ?? return None
    if !jet_eval_ir_write(s, error + Int.from_i64(ERR_DETAILS), 8, holder) -> return None
    Val(error)
}

// The native details holder of the present `__jet_ErrorDetails` `value`.
jet_eval_ir_err_details: fn(s: &JetEvalIRState, value: TComptimeValue) -> Int? {
    record: if value == .Present(inner) -> inner else -> value
    details: jet_eval_ir_err_record(s, record) ?? return None
    holder: jet_eval_ir_err_zeroed(s, Int.from_i64(ERR_DETAILS_BYTES)) ?? return None
    variant: jet_eval_ir_err_member(s, details, "variant") ?? return None
    if !jet_eval_ir_err_put_text(s, holder + Int.from_i64(ERR_DETAILS_VARIANT), variant) -> return None
    rows: jet_eval_ir_err_member(s, details, "fields") ?? return None
    if !jet_eval_ir_err_put_rows(s, holder + Int.from_i64(ERR_DETAILS_FIELDS), Int.from_i64(ERR_FIELD_BYTES), rows, [String]{"name", "value"}, None) -> return None
    located: jet_eval_ir_err_member(s, details, "source_span") ?? return None
    if located == .Failed(_) -> return Val(holder)
    bounds_value: if located == .Present(inner) -> inner else -> located
    bounds: jet_eval_ir_err_record(s, bounds_value) ?? return None
    start: jet_eval_ir_err_int(s, bounds, "start") ?? return None
    end: jet_eval_ir_err_int(s, bounds, "end") ?? return None
    if !jet_eval_ir_write(s, holder + Int.from_i64(ERR_DETAILS_HAS_SPAN), 8, 1) || !jet_eval_ir_write(s, holder + Int.from_i64(ERR_DETAILS_START), 8, start) || !jet_eval_ir_write(s, holder + Int.from_i64(ERR_DETAILS_END), 8, end) -> return None
    Val(holder)
}

// The fields of record `value`.
jet_eval_ir_err_record: fn(s: &JetEvalIRState, value: TComptimeValue) -> [TComptimeField]? Never! {
    if value == .Struct(_, fields) -> return Val(fields)
    jet_eval_ir_problem(s, "a default Err part that is not a record: {value}")
    None
}

// Field `name` of an Err record part.
jet_eval_ir_err_member: fn(s: &JetEvalIRState, fields: [TComptimeField], name: String) -> TComptimeValue? Never! {
    loop field in fields {
        if field.name == name -> return Val(field.value)
    }
    jet_eval_ir_problem(s, "a default Err part has no field `{name}`")
    None
}

jet_eval_ir_err_int: fn(s: &JetEvalIRState, fields: [TComptimeField], name: String) -> Int? Never! {
    value: jet_eval_ir_err_member(s, fields, name) ?? return None
    if value == .Int(number) -> return Val(number)
    jet_eval_ir_problem(s, "default Err field `{name}` is not an Int: {value}")
    None
}

// `bytes` zeroed bytes of the child's runtime heap.
jet_eval_ir_err_zeroed: fn(s: &JetEvalIRState, bytes: Int) -> Int? {
    base: jet_eval_native_alloc(s, bytes, 8) ?? return None
    at := 0
    loop at < bytes {
        if !jet_eval_ir_write(s, base + at, 8, 0) -> return None
        at += 8
    }
    Val(base)
}

// Writes the runtime String of text `value` as the header word at `at`.
jet_eval_ir_err_put_text: fn(s: &JetEvalIRState, at: Int, value: TComptimeValue) -> Bool {
    text: if value == .String(raw) -> raw else -> {
        jet_eval_ir_problem(s, "a default Err text that is not a String: {value}")
        return false
    }
    header: jet_eval_ir_store_text(s, text) ?? return false
    jet_eval_ir_write(s, at, 8, header)
}

// Writes the `String?` `value` at `at`: its header word, or 0 when absent.
jet_eval_ir_err_put_optional_text: fn(s: &JetEvalIRState, at: Int, value: TComptimeValue) -> Bool {
    if value == .Failed(_) -> return true
    if value == .Present(present) -> return jet_eval_ir_err_put_text(s, at, present)
    jet_eval_ir_err_put_text(s, at, value)
}

// Writes the records of list `value` as the native inline List at `list` of
// `stride`-byte rows (the inverse of jet_eval_ir_err_rows).
jet_eval_ir_err_put_rows: fn(s: &JetEvalIRState, list: Int, stride: Int, value: TComptimeValue, texts: [String], number: String?) -> Bool {
    rows: if value == .List(values) -> values else -> {
        jet_eval_ir_problem(s, "a default Err row list that is not a List: {value}")
        return false
    }
    data := 0
    if rows.len() > 0 -> data = jet_eval_native_alloc(s, rows.len() * stride, 8) ?? return false
    if !jet_eval_ir_write(s, list, 8, rows.len()) || !jet_eval_ir_write(s, list + 8, 8, rows.len()) || !jet_eval_ir_write(s, list + 16, 8, data) -> return false
    loop (index, row) in rows {
        fields: jet_eval_ir_err_record(s, row) ?? return false
        base: data + index * stride
        loop (position, name) in texts {
            text: jet_eval_ir_err_member(s, fields, name) ?? return false
            if !jet_eval_ir_err_put_text(s, base + position * 8, text) -> return false
        }
        if number == .Val(name) {
            word: jet_eval_ir_err_int(s, fields, name) ?? return false
            if !jet_eval_ir_write(s, base + texts.len() * 8, 8, word) -> return false
        }
    }
    true
}

// The map key of `value`, a key of type `ty` read back (the inverse of
// JetIR ir_comptime_key_value); None for a value no key spells.
jet_eval_ir_key: fn(m: IRModule, p: IRProgram, value: TComptimeValue, ty: Type) -> TComptimeKey? Never! {
    if value == {
        .Int(number) -> return Val(checked_comptime_integer_key(number))
        .BigInt(decimal) -> return Val(TComptimeKey.BigInt{decimal: decimal})
        .String(text) -> return Val(TComptimeKey.String{value: text})
        .Bool(flag) -> return Val(TComptimeKey.Bool{value: flag})
        .Char(code) -> return Val(TComptimeKey.Char{value: code})
        .Enum(name, variant, args) -> {
            if args.len() > 0 -> return None
            return Val(TComptimeKey.Enum{type_name: name, variant: variant})
        }
        .Struct(name, fields) -> {
            keys := [TComptimeKeyField]{}
            loop field in fields {
                field_ty: ir_declared_field_type(m, p, ty, field.name) ?? return None
                key: jet_eval_ir_key(m, p, field.value, field_ty) ?? return None
                keys.push(TComptimeKeyField{name: field.name, key: key})
            }
            if ir_untag(ty) == .Tuple(_) -> return Val(TComptimeKey.Tuple{fields: keys})
            return Val(TComptimeKey.Struct{type_name: name, fields: keys})
        }
        .Float(_, _) | .Bytes(_) | .List(_) | .Map(_) | .Present(_) | .Failed(_) | .Unit -> return None
    }
}

// The display name a clean absence names its element by: a nominal names its
// arguments in angle brackets, none as `Name<>`, so the message is the same
// for a bare nominal and its applications.
jet_eval_ir_type_display: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> "{name}<>"
        .Apply(name, args) -> {
            names: loop arg in args -> jet_eval_ir_type_display(arg)
            "{name}<{names.join(", ")}>"
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> type_name(ty)
    }
}

// The word of a member of type row `row` at byte `offset` of `base`: an
// aggregate is its address, anything else is loaded.
jet_eval_ir_member_word: fn(m: &IRModule, s: &JetEvalIRState, base: Int, offset: Int, row: Int) -> Int? Never! {
    ty: m.types[row]
    if ty.kind == .Aggregate -> return Val(base + offset)
    width: jet_eval_ir_width(ty)
    if width == 0 -> return Val(0)
    jet_eval_ir_load(s, ty, base + offset, width)
}

jet_eval_ir_fields: fn(m: &IRModule, p: IRProgram, s: &JetEvalIRState, base: Int, members: [IRMember]) -> [TComptimeField]? {
    output := [TComptimeField]{}
    loop member in members {
        value: jet_eval_ir_member_value(m, p, s, base, member) ?? return None
        output.push(TComptimeField{name: member.name.copy(), value: value})
    }
    Val(output)
}

jet_eval_ir_member_value: fn(m: &IRModule, p: IRProgram, s: &JetEvalIRState, base: Int, member: IRMember) -> TComptimeValue? {
    if member.boxed {
        boxed: jet_eval_ir_read(s, base + member.offset, 8) ?? return None
        word: jet_eval_ir_member_word(m, s, boxed, 0, member.ty) ?? return None
        return jet_eval_ir_data(m, p, s, word, member.ty)
    }
    word: jet_eval_ir_member_word(m, s, base, member.offset, member.ty) ?? return None
    jet_eval_ir_data(m, p, s, word, member.ty)
}

// An enum case: variant `index` of declaration `definition` instanced at
// `type_args`, its payload read from the box at `boxed` when the enum is boxed.
jet_eval_ir_enum_data: fn(m: &IRModule, p: IRProgram, s: &JetEvalIRState, definition: Int, type_args: [Type], index: Int, boxed: Int, has_box: Bool) -> TComptimeValue? {
    declaration: p.types[definition]
    if declaration.kind == .Enum(variants, _) {
        if index < 0 || index >= variants.len() {
            jet_eval_ir_problem(s, "enum {declaration.name} holds discriminant {index}, outside its {variants.len()} variants")
            return None
        }
        args := [TComptimeEnumArg]{}
        if has_box {
            members: ir_variant_members(m, p, definition, type_args, index) ?? return jet_eval_ir_transport_fail(s, Type.Named{name: declaration.name.copy()})
            single: variants[index].payload == .Single(_)
            loop member in members {
                value: jet_eval_ir_member_value(m, p, s, boxed, member) ?? return None
                args.push(TComptimeEnumArg{name: if single -> None else -> Val(member.name.copy()), value: value})
            }
        }
        return Val(TComptimeValue.Enum{type_name: declaration.name.copy(), variant: variants[index].name.copy(), args: args})
    }
    jet_eval_ir_problem(s, "{declaration.name} is not an enum")
    None
}
