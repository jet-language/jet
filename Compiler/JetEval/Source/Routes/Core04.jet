// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:909
fn repl_native_only_module(module: &String) -> String? {
    match module {
        "core.http" | "core.http.client" | "core.http.server" => Val("the HTTP client/server (`core.http`)")
        "core.db" => Val("`core.db` (SQLite)")
        "core.net" => Val("network sockets (`core.net`)")
        "core.crypto" => Val("`core.crypto`")
        "core.auth" => Val("`core.auth` token verification")
        "core.tasks" | "core.channels" => Val("tasks/channels (`core.tasks`)")
        "core.mem" => Val("`core.mem` (low-level memory tier)")
        "core.log" => Val("`core.log`")
        _ => None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:925
fn repl_native_module_diag(module: &String, method: &String, span: Span) -> Diagnostic {
    feature := repl_native_only_module(module).unwrap_or("a native-only core module")
    Diagnostic.error("E1802", "the REPL interpreter can't run `{module}.{method}()`", "the REPL is an interpreter for learning Jet; {feature} needs the real compiler and native runtime", "run `jet run <file.jet>` or `jet build <file.jet>` to use the full compiler", Val(span))
}
