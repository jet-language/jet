// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:405
use jet_codegen.Prelude.CoreLib.Top.FakeData as fake_data_kernel
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:409
struct Fake { state: U64, locale: U8 }
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:414
use jet_codegen.Prelude.Core.SeededRandom.jet_seeded_rng_int
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:418
pub fn apply_fake_method(recv: &CtValue, method: &String, args: &[CtValue], span: Span) -> Result<CtValue, Diagnostic> {
    (type_name, fields) := match recv { .Struct { type_name, fields } => (type_name, fields); _ => return Err(unsupported("Fake receiver", span)) }
    if type_name != Syntax.FAKE_TYPE { return Err(unsupported("Fake receiver", span)) }
    state := fields.iter().find_map(fn((name, value)) { match (name, value) { ("state", .Int(value)) => Val(value as U64); _ => None } }).unwrap_or(0)
    locale := fields.iter().find_map(fn((name, value)) { match (name, value) { ("locale", .Int(value)) => Val(value as U8); _ => None } }).unwrap_or(0)
    fake := Fake { state: state, locale: locale }
    result := match method {
        "locale" => {
            locale := as_string(args.first().ok_or_else(fn() { unsupported("Fake.locale argument", span) })?, span)?.to_string()
            next := fake_data_kernel.jet_fake_locale(&fake, &locale)
            CtValue.Struct { type_name: Syntax.FAKE_TYPE.to_string(), fields: [("state", CtValue.Int(next.state as I64)), ("locale", CtValue.Int(next.locale as I64))] }
        }
        "name" => CtValue.Str(fake_data_kernel.jet_fake_name(&fake))
        "email" => CtValue.Str(fake_data_kernel.jet_fake_email(&fake))
        "host" => CtValue.Str(fake_data_kernel.jet_fake_host(&fake))
        "address" => CtValue.Str(fake_data_kernel.jet_fake_address(&fake))
        _ => return Err(unsupported("this Fake method", span))
    }
    if method != "locale" {
        *recv = CtValue.Struct { type_name: Syntax.FAKE_TYPE.to_string(), fields: [("state", CtValue.Int(fake.state as I64)), ("locale", CtValue.Int(fake.locale as I64))] }
    }
    Ok(^result)
}

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:480
use jet_codegen.Prelude.Core.NetPure as net_pure_kernel
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:484
use jet_codegen.Prelude.Core.Loadable as loadable_kernel
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:488
fn loadable_variant(state: &String) -> String {
    tag := match state {
        "idle" => loadable_kernel.JET_LOADABLE_IDLE
        "loading" => loadable_kernel.JET_LOADABLE_LOADING
        "loaded" => loadable_kernel.JET_LOADABLE_LOADED
        _ => loadable_kernel.JET_LOADABLE_FAILED
    }
    match tag {
        loadable_kernel.JET_LOADABLE_IDLE => "Idle"
        loadable_kernel.JET_LOADABLE_LOADING => "Loading"
        loadable_kernel.JET_LOADABLE_LOADED => "Loaded"
        _ => "Failed"
    }
}
