// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:26
fn core_call_allows_pure_parity(row: &Syntax.CoreCallRecord) -> Bool {
    row.coverage.contains(Syntax.CoreCallCoverage.COMPTIME)
        && match row.interpreter_route { .Pure(_) | .Ambient => true; _ => false }
        && row.pure_route != Syntax.CoreCallPureRoute.None
        && !row.is_receiver() && row.effect().is_none()
}

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:39
fn csv_row_value(record: CsvRecord) -> CtValue {
    CtValue.Struct { type_name: "CSVRow", fields: [
        ("fields", CtValue.List(record.fields.into_iter().map(CtValue.Str).collect())),
        ("line", CtValue.Int(record.line)),
    ] }
}

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:52
fn validate_interpreter_route(module: &String, method: &String, span: Span) -> Result<Unit, Diagnostic> {
    if row := Syntax.core_call(module, method) {
        if row.coverage.contains(Syntax.CoreCallCoverage.INTERPRETER) && !row.interpreter_route.is_executable() {
            return Err(unsupported("{module}.{method}(): no interpreter route is declared", span))
        }
    }
    Ok(())
}

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:68
fn validate_core_call_projection(module: &String, method: &String, actual_arity: USize, projection: U8, span: Span) -> Result<Unit, Diagnostic> {
    if Syntax.core_call(module, method).is_none() { return Ok(()) }
    match Syntax.core_call_projection(module, method, projection, actual_arity) {
        Ok(_) => Ok(())
        Err(.Arity { expected, actual }) => Err(unsupported("{module}.{method}(): expected {expected} argument(s), got {actual}", span))
        // The adapter also serves default jet run, not just comptime.
        Err(.Uncovered { .. }) => Err(unsupported("{module}.{method}(): no shared-evaluator projection is declared", span))
        Err(.Unknown) => Err(unsupported("{module}.{method}(): unknown Core-call row", span))
    }
}

// Marshal typed Path values; ordinary strings are not implicitly converted.
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:109
pub fn normalize_path_args(module: &String, method: &String, args: [CtValue], span: Span) -> Result<[CtValue], Diagnostic> {
    row := Syntax.core_call(module, method) else { return Ok(^args) }
    args.into_iter().enumerate().map(fn((index, value)) -> Result<CtValue, Diagnostic> {
        if !row.path_arg(index) { return Ok(^value) }
        (type_name, fields) := match &value { .Struct { type_name, fields } => (type_name, fields); _ => return Ok(^value) }
        if type_name != "Path" { return Ok(^value) }
        path := fields.iter().find_map(fn((name, value)) {
            match (name, value) { ("inner", .Str(path)) => Val(path.clone()); _ => None }
        }) else { return Err(unsupported("malformed Path value", span)) }
        Ok(CtValue.Str(^path))
    }).collect()
}

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:143
use jet_codegen.Prelude.Core.Path as path_kernel
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:147
fn apply_path_call(method: &String, args: &[CtValue], span: Span) -> Result<CtValue, Diagnostic> {
    text := fn(index: USize) -> Result<&String, Diagnostic> {
        match args.get(index) {
            Val(.Str(value)) => Ok(value)
            Val(.Struct { type_name, fields }) if type_name == "Path" => fields.iter().find_map(fn((name, value)) {
                match (name, value) { ("inner", .Str(value)) => Val(value); _ => None }
            }).ok_or_else(fn() { unsupported("malformed Path value", span) })
            _ => Err(unsupported("Path operation requires a checked path or text value", span))
        }
    }
    path := fn(value: String) { CtValue.Struct { type_name: "Path", fields: [("inner", CtValue.Str(^value))] } }
    Ok(match method {
        "path.from" => path(text(0)?.clone())
        "path.home" => path(path_kernel.jet_std_path_home())
        "path.join" => path(path_kernel.jet_std_path_join(text(0)?, text(1)?))
        "path.to_string" => CtValue.Str(text(0)?.clone())
        "path.normalize" => path(path_kernel.jet_std_path_normalize(text(0)?))
        "path.is_within" => CtValue.Bool(path_kernel.jet_std_path_is_within(text(0)?, text(1)?))
        "path.parent" => path_kernel.jet_std_path_parent_opt(text(0)?).map(fn(value) { CtValue.Present(path(^value)) }).unwrap_or_else(fn() { CtValue.absent(Type.Named("Path")) })
        "path.extension" | "path.stem" => {
            value := if method == "path.extension" { path_kernel.jet_std_path_extension_opt(text(0)?) } else { path_kernel.jet_std_path_stem_opt(text(0)?) }
            value.map(fn(value) { CtValue.Present(CtValue.Str(^value)) }).unwrap_or_else(fn() { CtValue.absent(Type.String) })
        }
        "path.walk" => CtValue.List(path_kernel.jet_std_path_walk(text(0)?).into_iter().map(path).collect())
        _ => return Err(unsupported("Path operation has no interpreter binding", span))
    })
}
