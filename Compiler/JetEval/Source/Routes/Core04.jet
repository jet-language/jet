pub fn io_error_value(operation: IoErrorOperation, path: &String, e: std.io.Error) -> CtValue { TextLite.io_error_value(operation, path, ^e) }

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:951
fn text_width_policy_flags(policy: &CtValue) -> (Bool, Bool) {
    fields := match policy { .Struct { fields, .. } => fields; _ => return (false, false) }
    is_var := fn(v: &CtValue, name: &String) -> Bool {
        match v {
            .Enum { variant, .. } => variant == name
            .Struct { type_name, .. } => type_name == name || type_name.ends_with(".{name}")
            _ => false
        }
    }
    ambiguous_wide := fields.iter().find(fn((n, _)) { n == "ambiguous" }).is_some_and(fn((_, v)) { is_var(v, "Wide") })
    controls_reject := fields.iter().find(fn((n, _)) { n == "controls" }).is_some_and(fn((_, v)) { is_var(v, "Reject") })
    (ambiguous_wide, controls_reject)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:974
fn raylib_field(fields: &[(String, CtValue)], name: &String) -> &CtValue? {
    fields.iter().find_map(fn((field, value)) { if field == name { Val(value) } else { None } })
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:983
fn raylib_atlas_value(spec: raylib_kernel.JetRaylibAtlasSpec) -> CtValue {
    regions := spec.regions.into_iter().map(fn(region) {
        CtValue.Struct { type_name: "RaylibAtlasRegion", fields: [("name", CtValue.Str(^region.name)), ("x", CtValue.Int(region.x)), ("y", CtValue.Int(region.y)), ("width", CtValue.Int(region.width)), ("height", CtValue.Int(region.height))] }
    }).collect()
    texture_path := spec.texture_path.map(fn(path) { CtValue.Present(CtValue.Str(^path)) }).unwrap_or_else(fn() { CtValue.absent(Type.String) })
    CtValue.Struct { type_name: "RaylibTextureAtlas", fields: [("path", CtValue.Str(^spec.path)), ("name", CtValue.Str(^spec.name)), ("texture_path", ^texture_path), ("regions", CtValue.List(^regions))] }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:1013
fn raylib_atlas_spec(value: &CtValue, span: Span) -> Result<raylib_kernel.JetRaylibAtlasSpec, Diagnostic> {
    (type_name, fields) := match value { .Struct { type_name, fields } => (type_name, fields); _ => return Err(unsupported("expected a RaylibTextureAtlas", span)) }
    if type_name != "RaylibTextureAtlas" { return Err(unsupported("expected a RaylibTextureAtlas", span)) }
    path := match raylib_field(fields, "path") { Val(.Str(path)) => path.clone(); _ => return Err(unsupported("malformed RaylibTextureAtlas path", span)) }
    name := match raylib_field(fields, "name") { Val(.Str(name)) => name.clone(); _ => return Err(unsupported("malformed RaylibTextureAtlas name", span)) }
    texture_path := match raylib_field(fields, "texture_path") {
        Val(.Present(value)) => match value.as_ref() { .Str(path) => Val(path.clone()); _ => return Err(unsupported("malformed RaylibTextureAtlas texture", span)) }
        Val(.Failed(.Clean(_))) => None
        _ => return Err(unsupported("malformed RaylibTextureAtlas texture", span))
    }
    region_values := match raylib_field(fields, "regions") { Val(.List(region_values)) => region_values; _ => return Err(unsupported("malformed RaylibTextureAtlas regions", span)) }
    regions := [raylib_kernel.JetRaylibAtlasRegion].with_capacity(region_values.len())
    for value in region_values {
        (type_name, fields) := match value { .Struct { type_name, fields } => (type_name, fields); _ => return Err(unsupported("malformed RaylibTextureAtlas region", span)) }
        if type_name != "RaylibAtlasRegion" { return Err(unsupported("malformed RaylibTextureAtlas region", span)) }
        int_field := fn(name: &String) -> Result<I64, Diagnostic> { match raylib_field(fields, name) { Val(.Int(value)) => Ok(value); _ => Err(unsupported("malformed RaylibTextureAtlas region", span)) } }
        name := match raylib_field(fields, "name") { Val(.Str(name)) => name.clone(); _ => return Err(unsupported("malformed RaylibTextureAtlas region", span)) }
        regions.push(raylib_kernel.JetRaylibAtlasRegion { name: ^name, x: int_field("x")?, y: int_field("y")?, width: int_field("width")?, height: int_field("height")? })
    }
    Ok(raylib_kernel.JetRaylibAtlasSpec { path: ^path, name: ^name, texture_path: ^texture_path, regions: ^regions })
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:1078
fn apply_raylib_core_call(module: &String, method: &String, args: &[CtValue], span: Span) -> Result<CtValue, Diagnostic>? {
    if module != "core.game.raylib" { return None }
    one := fn(index: USize) -> Result<&CtValue, Diagnostic> { args.get(index).ok_or_else(fn() { unsupported("`{module}.{method}` (wrong number of arguments)", span) }) }
    // These are the reference interpreter's intentional headless semantics.
    Val((fn() -> Result<CtValue, Diagnostic> {
        match method {
            "window_open" => Ok(CtValue.Struct { type_name: "RaylibWindow", fields: [("width", CtValue.Int(as_int(one(0)?, span)?)), ("height", CtValue.Int(as_int(one(1)?, span)?)), ("title", CtValue.Str(as_string(one(2)?, span)?.to_string())), ("native", CtValue.Bool(false))] })
            "window_should_close" => { _ :: one(0)?; Ok(CtValue.Bool(true)) }
            "window_ready" => { _ :: one(0)?; Ok(CtValue.Bool(false)) }
            "begin_drawing" | "close_window" => { _ :: one(0)?; Ok(CtValue.Unit) }
            "clear_background" => { _ :: one(0)?; Ok(CtValue.Unit) }
            "draw_rectangle" => { for index in 0..4 { _ :: as_int(one(index)?, span)? }; _ :: one(4)?; Ok(CtValue.Unit) }
            "draw_text" => { _ :: as_string(one(0)?, span)?; for index in 1..4 { _ :: as_int(one(index)?, span)? }; _ :: one(4)?; Ok(CtValue.Unit) }
            "end_drawing" => Ok(CtValue.Unit)
            "key_down" => { _ :: as_string(one(0)?, span)?; Ok(CtValue.Bool(false)) }
            "set_target_fps" => { _ :: as_int(one(0)?, span)?; Ok(CtValue.Unit) }
            "color" => Ok(CtValue.Struct { type_name: "RaylibColor", fields: [("r", CtValue.Int(as_int(one(0)?, span)?)), ("g", CtValue.Int(as_int(one(1)?, span)?)), ("b", CtValue.Int(as_int(one(2)?, span)?)), ("a", CtValue.Int(as_int(one(3)?, span)?))] })
            "gamepad_down" => {
                gamepad := as_int(one(0)?, span)?
                button := as_string(one(1)?, span)?
                _ :: I32.try_from(gamepad).ok().filter(fn(value) { value >= 0 }).and_then(fn(_) { raylib_kernel.jet_raylib_button_code(button) })
                Ok(CtValue.Bool(false))
            }
            "gamepad_axis" => {
                gamepad := as_int(one(0)?, span)?
                axis := as_string(one(1)?, span)?
                _ :: I32.try_from(gamepad).ok().filter(fn(value) { value >= 0 }).and_then(fn(_) { raylib_kernel.jet_raylib_axis_code(axis) })
                Ok(CtValue.Float(CtFloat.f64(0.0)))
            }
            "load_sound" => Ok(CtValue.Struct { type_name: "RaylibSound", fields: [("path", CtValue.Str(as_string(one(0)?, span)?.to_string()))] })
            "play_sound" => {
                (type_name, fields) := match one(0)? { .Struct { type_name, fields } => (type_name, fields); _ => return Err(unsupported("expected a RaylibSound", span)) }
                if type_name != "RaylibSound" { return Err(unsupported("expected a RaylibSound", span)) }
                path := match raylib_field(fields, "path") { Val(.Str(path)) => path; _ => return Err(unsupported("malformed RaylibSound", span)) }
                Ok(CtValue.Bool(!path.is_empty()))
            }
            "load_texture_atlas" => Ok(raylib_atlas_value(raylib_kernel.jet_raylib_load_texture_atlas_spec(as_string(one(0)?, span)?)))
            "draw_sprite" => {
                atlas := raylib_atlas_spec(one(0)?, span)?
                region := as_string(one(1)?, span)?
                x := as_int(one(2)?, span)?
                y := as_int(one(3)?, span)?
                if call := raylib_kernel.jet_raylib_sprite_draw_call(&atlas.name, &atlas.regions, region, x, y) { raylib_kernel.jet_raylib_record_draw_call(^call) }
                Ok(CtValue.Unit)
            }
            _ => Err(unsupported("`{module}.{method}()`", span))
        }
    })())
}
// Direct adapter avoids recursive ambient dispatch.
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:1218
pub fn apply_raylib_ambient_core_call(module: &String, method: &String, args: [CtValue], span: Span, _resolved_ret: Type?, _sink: &jet_comptime.Comptime.DevSink?) -> Result<CtValue, Diagnostic>? {
    apply_raylib_core_call(module, method, &args, span)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:1229
fn realtime_stream_fields(value: &CtValue, span: Span) -> Result<&[(String, CtValue)], Diagnostic> {
    (type_name, fields) := match value { .Struct { type_name, fields } => (type_name, fields); _ => return Err(unsupported("realtime stream method expects a RealtimeStream", span)) }
    if type_name != "RealtimeStream" { return Err(unsupported("realtime stream method expects a RealtimeStream", span)) }
    Ok(fields)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:1242
fn realtime_stream_field(value: &CtValue, name: &String, span: Span) -> Result<&CtValue, Diagnostic> {
    realtime_stream_fields(value, span)?.iter().find_map(fn((field, value)) { if field == name { Val(value) } else { None } }).ok_or_else(fn() { unsupported("malformed RealtimeStream value", span) })
}
