//RS const PERF_DEFAULT_FIDELITY_BITS: u32 = 1.0f32.to_bits();
//RS // D-FIDELITY-API1=A: this signal must behave like the AOT binary's
//RS // process-global static (fresh default per program run, persists across
//RS // reads/writes within one run). This compiler process hosts many concurrent
//RS // or sequential "runs" on separate threads (parallel test threads, distinct
//RS // compiles) but a session (REPL turns, a dev watch loop) is always driven
//RS // from a single thread start to finish — so thread-local scoping gives each
//RS // concurrent run its own signal (fixing a real cross-thread race a
//RS // process-wide static had) while preserving the existing single-thread
//RS // persistence a REPL session or dev run relies on.
//RS thread_local! {
//RS     static PERF_FIDELITY: Cell<u32> = const { Cell::new(PERF_DEFAULT_FIDELITY_BITS) };
//RS }
//RS 
//RS // ---------------------------------------------------------------------------
//RS // D-META-EFFECT1: this is the implementation dispatch for Core calls that the
//RS // shared effect facts admit at comptime. Eligibility is decided by
//RS // `Effects::core_effect`; this table only supplies evaluator implementations.
//RS // ---------------------------------------------------------------------------
