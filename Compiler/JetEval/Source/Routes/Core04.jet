const PERF_DEFAULT_FIDELITY_BITS: U32 = 0x3f800000
// Per-thread run/session state, not process-global: concurrent compiler runs are isolated.
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:800
// GATE #4494: retained thread-local Cell storage.
static PERF_FIDELITY: std.thread.Local<Cell<U32>> = std.thread.Local.new(fn() { Cell.new(PERF_DEFAULT_FIDELITY_BITS) })

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:810
pub fn as_float(v: &CtValue, span: Span) -> Result<F64, Diagnostic> {
    match v {
        .Float(value) => Ok(value.as_f64())
        .Int(n) => Ok(n as F64)
        _ => Err(unsupported("non-numeric argument to a Core math call", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls.rs:823
fn as_ct_float(v: &CtValue, span: Span) -> Result<CtFloat, Diagnostic> {
    match v {
        .Float(value) => Ok(value)
        .Struct { type_name, .. } if type_name == Syntax.TYPE_FRACTION => {
            fraction := jet_comptime.Numeric.CtFraction.from_value(v).map_err(fn(_) { unsupported("malformed Fraction", span) })?
            Ok(CtFloat.F64(fraction.to_float()))
        }
        .Struct { type_name, .. } if type_name == Syntax.TYPE_DECIMAL => {
            decimal := jet_comptime.Numeric.CtDecimal.from_value(v).map_err(fn(_) { unsupported("malformed Decimal", span) })?
            Ok(CtFloat.F64(decimal.to_f64()))
        }
        _ => Err(unsupported("non-float argument to a Core math call", span))
    }
}
