                .Bytes(values) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: values.len() == 0}})
                .Map(values) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: values.len() == 0}})
                .String(text) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: text.len() == 0}})
                .Struct(_, _) -> {
