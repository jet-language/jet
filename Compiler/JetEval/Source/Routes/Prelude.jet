            if values.len() == 0 -> return jet_eval_route_direct_absent(result_ty, &machine, span)
            index :: if member == "first" -> 0 else -> values.len() - 1
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: values[index]}})
        }
        "contains" -> {
            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "contains without a receiver")
            if args[0] == {
                .List(values) -> {
