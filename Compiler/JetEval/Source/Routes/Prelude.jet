            items :: jet_eval_route_unique_items(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "{member} on this value")
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: items}})
        }
        // `jet_iter_indexes(n)`: every valid index `0..<n` of a sequence of
        // length `n` (a negative length has none).
        "indexes" -> {
