        "list_slice" -> {
            if args.len() != 3 -> return jet_eval_route_not_supported(&machine, span, "List.slice without a start and end")
            start :: jet_eval_route_int_value(args[1], &machine, span) ?? return None
            end :: jet_eval_route_int_value(args[2], &machine, span) ?? return None
            if args[0] == .Bytes(bytes) {
                window :: jet_eval_route_clamped_window(bytes.len(), start, end)
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bytes{value: bytes[window.from..<window.to]}})
            }
            items :: jet_eval_route_list(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "List.slice on a non-list")
            window :: jet_eval_route_clamped_window(items.len(), start, end)
