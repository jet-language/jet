        "string_slice" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            if args.len() != 3 -> return jet_eval_route_not_supported(&machine, span, "String.slice without a start and end")
            start :: if args[1] == .Int(number) -> number else -> { return jet_eval_route_not_supported(&machine, span, "slice with a non-Int start") }
            end :: if args[2] == .Int(number) -> number else -> { return jet_eval_route_not_supported(&machine, span, "slice with a non-Int end") }
            chars :: text.chars()
            if start < 0 || end < 0 || start > end || end > chars.len() {
