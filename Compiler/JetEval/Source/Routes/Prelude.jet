            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "Map.merge without two maps")
            merged := jet_eval_route_map_entries(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "Map.merge on a non-map")
            other :: jet_eval_route_map_entries(args[1]) ?? return jet_eval_route_not_supported(&machine, span, "Map.merge with a non-map")
            loop entry in other {
                found := false
                loop index in 0..<merged.len() {
                    if merged[index].key == entry.key {
                        merged[index].value = entry.value
                        found = true
                    }
                }
                if !found -> merged = jet_eval_insert_map_entry(merged, entry.key, entry.value)
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Map{entries: merged}})
        }
        // `jet_map_from_keys_kernel`: every key maps to the default.
        "map_from_keys" -> {
            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "Map.from_keys without keys and a default")
