// Pure Prelude dispatch. The row and symbol are checked before any route body is
// selected; route names are only used after the canonical MIR row is found.
use jet_foundation.[
    MIRCallFallibility,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRType,
    MIRTypeKind,
    Span,
    TComptimeEnumArg,
    TComptimeField,
    TComptimeKey,
    TComptimeKeyField,
    TComptimeMapEntry,
    TComptimeReport,
    TComptimeValue,
    mir_symbol_name,
    mir_type_from_kind,
]

fn jet_eval_route_is_exact_integer_member(member: String) -> Bool Never! {
    if member == {
        "add" | "sub" | "mul" | "div" | "rem" | "floor_div" | "mod" | "pow" | "shl" | "shr" | "bit_and" | "bit_or" | "bit_xor" | "div_euclid" | "rem_euclid" -> true
        else -> false
    }
}

fn jet_eval_route_exact_integer_symbol(member: String, symbol: String) -> Bool Never! {
    if member == {
        "add" -> symbol == "jet_std::jet_int_add"
        "sub" -> symbol == "jet_std::jet_int_sub"
        "mul" -> symbol == "jet_std::jet_int_mul"
        "div" -> symbol == "jet_std::jet_int_div"
        "rem" -> symbol == "jet_std::jet_int_rem"
        "floor_div" -> symbol == "jet_std::jet_int_floor_div"
        "mod" -> symbol == "jet_std::jet_int_mod"
        "pow" -> symbol == "jet_std::jet_int_pow"
        "shl" -> symbol == "jet_std::jet_int_shl"
        "shr" -> symbol == "jet_std::jet_int_shr"
        "bit_and" -> symbol == "jet_std::jet_int_bit_and"
        "bit_or" -> symbol == "jet_std::jet_int_bit_or"
        "bit_xor" -> symbol == "jet_std::jet_int_bit_xor"
        "div_euclid" -> symbol == "jet_std::jet_int_div_euclid"
        "rem_euclid" -> symbol == "jet_std::jet_int_rem_euclid"
        else -> false
    }
}

fn jet_eval_route_fixed_symbol(parts: [String], symbol: String) -> Bool Never! {
    if parts.len() != 3 -> return false
    mode :: if parts[1] == "checked_policy" -> "trap" else -> parts[1]
    expected :: "jet_{parts[0]}_{mode}_{parts[2]}"
    symbol == expected
}

fn jet_eval_route_ascii_case(text: String, upper: Bool) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if {
            upper -> {
                if code >= 97 && code <= 122 -> bytes[index] = U8{code - 32}
            }
            else -> {
                if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
            }
        }
    }
    String.from_bytes(bytes) ?? text
}

fn jet_eval_route_order(left: TComptimeValue, right: TComptimeValue, machine: &JetEvalMachine, span: Span) -> Int? {
    if jet_eval_route_is_exact_integer(left) && jet_eval_route_is_exact_integer(right) -> return jet_eval_route_exact_order(left, right, &machine, span)
    if left == {
        .Float(left_number, _) -> if right == {
            .Float(right_number, _) -> {
                if left_number != left_number || right_number != right_number {
                    jet_eval_source_fail(&machine, span, "comparison with NaN")
                    return None
                }
                return if {
                    left_number < right_number -> Val(-1)
                    left_number > right_number -> Val(1)
                    else -> Val(0)
                }
            }
            else -> {}
        }
        .String(left_text) -> if right == {
            .String(right_text) -> return if {
                left_text < right_text -> Val(-1)
                left_text > right_text -> Val(1)
                else -> Val(0)
            }
            else -> {}
        }
        .Char(left_char) -> if right == {
            .Char(right_char) -> return if {
                left_char < right_char -> Val(-1)
                left_char > right_char -> Val(1)
                else -> Val(0)
            }
            else -> {}
        }
        .Bool(left_flag) -> if right == {
            .Bool(right_flag) -> return if {
                left_flag == right_flag -> Val(0)
                !left_flag -> Val(-1)
                else -> Val(1)
            }
            else -> {}
        }
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "comparison route received incompatible values")
    None
}

fn jet_eval_route_compare(member: String, args: [TComptimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if args.len() != 2 {
        jet_eval_compiler_fail(&machine, span, "comparison route requires two operands")
        return None
    }
    if member == {
        "eq" -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: args[0] == args[1]}})
        "ne" -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: args[0] != args[1]}})
        else -> {}
    }
    order :: jet_eval_route_order(args[0], args[1], &machine, span) ?? return None
    if member == {
        "lt" -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order < 0}})
        "gt" -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order > 0}})
        "le" -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order <= 0}})
        "ge" -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order >= 0}})
        "compare" -> {
            variant :: if {
                order < 0 -> "Less"
                order > 0 -> "Greater"
                else -> "Equal"
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Enum{type_name: "Ordering", variant: variant, args: [TComptimeEnumArg]{}}})
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "unknown comparison route member")
            None
        }
    }
}

fn jet_eval_route_radix_digit(byte: U8) -> Int Never! {
    code :: Int.from_u8(byte)
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 65 && code <= 90 -> code - 55
        code >= 97 && code <= 122 -> code - 87
        else -> -1
    }
}

// `Int.from_radix` mirrors the shared `CtBigInt::from_radix` kernel (I9): the
// text is trimmed, may carry one leading sign, and every digit is an ASCII
// digit or letter below `radix`. Any other input is the `!ParseError` side.
fn jet_eval_route_parse_integer(text: String, radix: Int) -> TComptimeValue? {
    if radix < 2 || radix > 36 -> return None
    raw := text.trim()
    negative :: raw.starts_with("-")
    if negative || raw.starts_with("+") -> raw = raw.slice(1, raw.len())
    if raw == "" -> return None
    value := 0
    loop byte in raw.bytes() {
        digit :: jet_eval_route_radix_digit(byte)
        if digit < 0 || digit >= radix -> return None
        value = value * radix + digit
    }
    if negative -> value = 0 - value
    Val(TComptimeValue.Int{value: value})
}

// The failure text for input `jet_eval_route_parse_integer` rejected; it
// matches the message every other tier's radix kernel reports.
fn jet_eval_route_parse_integer_failure(text: String, radix: Int) -> String Never! {
    if radix < 2 || radix > 36 -> return "integer radix must be between 2 and 36, got {radix}"
    trimmed :: text.trim()
    if trimmed == "" || trimmed == "-" || trimmed == "+" -> return "integer radix text is empty"
    "invalid base-{radix} integer `{trimmed}`"
}

// The receiver-first String rows of `string_method_route` and the zero-copy
// text-view rows. The evaluator calls the same String operations the compiled
// program calls, so `find` stays a byte offset and a view reads as the text it
// borrows on every tier (I9; MIREval's builtin table and
// `TextLite::string_route`).
fn jet_eval_route_is_text_member(member: String) -> Bool Never! {
    if member == {
        "title" | "casefold" | "find" | "rfind" | "strip" | "lstrip" | "rstrip" | "zfill" | "center" | "ljust" | "rjust" | "expandtabs" | "partition" | "rpartition" -> true
        "isalnum" | "isalpha" | "isascii" | "isdecimal" | "isdigit" | "isidentifier" | "isnumeric" | "isprintable" | "isspace" | "istitle" | "islower" | "isupper" -> true
        "is_lower" | "is_upper" | "capitalize" | "swapcase" | "reverse" | "normalize" | "remove_prefix" | "remove_suffix" -> true
        "string_before_view" | "string_after_view" | "string_trim_view" | "string_index_of" | "last_index_of" -> true
        else -> false
    }
}

fn jet_eval_route_text_triple(head: String, sep: String, tail: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "(head,sep,tail)", fields: [TComptimeField]{
        TComptimeField{name: "head", value: TComptimeValue.String{value: head}},
        TComptimeField{name: "sep", value: TComptimeValue.String{value: sep}},
        TComptimeField{name: "tail", value: TComptimeValue.String{value: tail}},
    }}
}

fn jet_eval_route_position(position: Int?) -> JetEvalRuntimeValue Never! {
    found :: position ?? return JetEvalRuntimeValue.Absent{element: mir_type_from_kind(MIRTypeKind.Int)}
    JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: TComptimeValue.Int{value: found}}}
}

fn jet_eval_route_text_method(member: String, args: [TComptimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if args.len() == 0 -> return jet_eval_route_not_supported(&machine, span, "String route {member} without a receiver")
    receiver :: jet_eval_route_string(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "String route {member} on a non-String receiver")
    texts := [String]{}
    numbers := [Int]{}
    loop index in 1..<args.len() {
        if args[index] == {
            .String(text) -> &texts.push(text)
            else -> &numbers.push(jet_eval_route_int_value(args[index], &machine, span) ?? return None)
        }
    }
    want_text :: if member == {
        "find" | "rfind" | "partition" | "rpartition" | "remove_prefix" | "remove_suffix" | "string_before_view" | "string_after_view" | "string_index_of" | "last_index_of" | "center" | "ljust" | "rjust" -> 1
        else -> 0
    }
    want_number :: if member == {
        "zfill" | "expandtabs" | "center" | "ljust" | "rjust" -> 1
        else -> 0
    }
    if texts.len() != want_text || numbers.len() != want_number -> return jet_eval_route_not_supported(&machine, span, "String route {member} with these operands")
    needle :: if want_text == 1 -> texts[0] else -> ""
    width :: if want_number == 1 -> numbers[0] else -> 0
    if member == "string_index_of" -> return Val(jet_eval_route_position(receiver.index_of(needle)))
    if member == "last_index_of" -> return Val(jet_eval_route_position(receiver.last_index_of(needle)))
    value :: if member == {
        "title" -> TComptimeValue.String{value: receiver.title()}
        "casefold" -> TComptimeValue.String{value: receiver.casefold()}
        "find" -> TComptimeValue.Int{value: receiver.find(needle)}
        "rfind" -> TComptimeValue.Int{value: receiver.rfind(needle)}
        "strip" -> TComptimeValue.String{value: receiver.strip()}
        "lstrip" -> TComptimeValue.String{value: receiver.lstrip()}
        "rstrip" -> TComptimeValue.String{value: receiver.rstrip()}
        "zfill" -> TComptimeValue.String{value: receiver.zfill(width)}
        "center" -> TComptimeValue.String{value: receiver.center(width, needle)}
        "ljust" -> TComptimeValue.String{value: receiver.ljust(width, needle)}
        "rjust" -> TComptimeValue.String{value: receiver.rjust(width, needle)}
        "expandtabs" -> TComptimeValue.String{value: receiver.expandtabs(width)}
        "partition" -> {
            parts :: receiver.partition(needle)
            jet_eval_route_text_triple(parts.head, parts.sep, parts.tail)
        }
        "rpartition" -> {
            parts :: receiver.rpartition(needle)
            jet_eval_route_text_triple(parts.head, parts.sep, parts.tail)
        }
        "isalnum" -> TComptimeValue.Bool{value: receiver.isalnum()}
        "isalpha" -> TComptimeValue.Bool{value: receiver.isalpha()}
        "isascii" -> TComptimeValue.Bool{value: receiver.isascii()}
        "isdecimal" -> TComptimeValue.Bool{value: receiver.isdecimal()}
        "isdigit" -> TComptimeValue.Bool{value: receiver.isdigit()}
        "isidentifier" -> TComptimeValue.Bool{value: receiver.isidentifier()}
        "isnumeric" -> TComptimeValue.Bool{value: receiver.isnumeric()}
        "isprintable" -> TComptimeValue.Bool{value: receiver.isprintable()}
        "isspace" -> TComptimeValue.Bool{value: receiver.isspace()}
        "istitle" -> TComptimeValue.Bool{value: receiver.istitle()}
        "islower" -> TComptimeValue.Bool{value: receiver.islower()}
        "isupper" -> TComptimeValue.Bool{value: receiver.isupper()}
        "is_lower" -> TComptimeValue.Bool{value: receiver.is_lower()}
        "is_upper" -> TComptimeValue.Bool{value: receiver.is_upper()}
        "capitalize" -> TComptimeValue.String{value: receiver.capitalize()}
        "swapcase" -> TComptimeValue.String{value: receiver.swapcase()}
        "reverse" -> TComptimeValue.String{value: receiver.reverse()}
        "normalize" -> TComptimeValue.String{value: receiver.normalize()}
        "remove_prefix" -> TComptimeValue.String{value: receiver.removeprefix(needle)}
        "remove_suffix" -> TComptimeValue.String{value: receiver.removesuffix(needle)}
        "string_before_view" -> TComptimeValue.String{value: receiver.before(needle)}
        "string_after_view" -> TComptimeValue.String{value: receiver.after(needle)}
        "string_trim_view" -> TComptimeValue.String{value: receiver.trim()}
        else -> TComptimeValue.Unit
    }
    if value == TComptimeValue.Unit -> return jet_eval_route_not_supported(&machine, span, "String route {member}")
    Val(JetEvalRuntimeValue.Data{value: value})
}

// Receiver-writing collection rows (MIREval `direct_mutating_collection`):
// the row computes the updated receiver and the call result separately; the
// caller writes the receiver back to its place.
struct JetEvalRouteMutation {
    receiver: TComptimeValue
    result: JetEvalRuntimeValue
}

fn jet_eval_route_is_mutating_member(member: String) -> Bool Never! {
    if member == {
        "map_insert" | "set_insert" | "set_remove" | "set_replace" | "set_pop" | "sorted_set_insert" | "sorted_set_remove" -> true
        "set_update" | "set_difference_update" | "set_intersection_update" | "set_symmetric_difference_update" -> true
        "list_push" | "list_extend" | "list_reverse" | "list_sort" | "list_sort_desc" | "list_clear" | "list_try_push" | "list_try_reserve" -> true
        "list_pop" | "list_insert" | "list_remove_value" | "list_remove_slot" | "priority_queue_pop" -> true
        "map_add_new" | "map_setdefault" | "map_try_insert" | "map_remove" | "map_pop_first" | "string_try_push" -> true
        else -> false
    }
}

// The `V?` a displacing write reports: the row's Option result, or the Option
// success side of a Result row. A Unit-typed row has none.
fn jet_eval_route_outcome_option(result_ty: MIRType?) -> MIRType? {
    ty :: result_ty ?? return None
    if ty.kind == {
        .Option(_) -> Val(ty)
        .Result(ok, _) -> if ok.kind == {
            .Option(_) -> Val(ok)
            else -> None
        }
        else -> None
    }
}

// A `Set` (and its ordered `Rank` form) is the `{items}` struct MIREval and the
// comptime collection kernels share: `items` keeps one copy of each value.
fn jet_eval_route_collection_items(value: TComptimeValue, type_name: String) -> [TComptimeValue]? {
    if value == {
        .Struct(name, fields) -> {
            if name != type_name -> return None
            loop field in fields {
                if field.name == "items" -> return jet_eval_route_list(field.value)
            }
            None
        }
        else -> None
    }
}

fn jet_eval_route_collection_value(type_name: String, items: [TComptimeValue]) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: type_name, fields: [TComptimeField]{TComptimeField{name: "items", value: TComptimeValue.List{values: items}}}}
}

fn jet_eval_route_has_item(items: [TComptimeValue], value: TComptimeValue) -> Bool Never! {
    loop item in items {
        if item == value -> return true
    }
    false
}

// The items of a `Set` or `Rank` receiver.
fn jet_eval_route_unique_items(value: TComptimeValue) -> [TComptimeValue]? {
    if jet_eval_route_collection_items(value, "Set") == {
        Val(items) -> Val(items)
        None -> jet_eval_route_collection_items(value, "Rank")
    }
}

fn jet_eval_route_map_entries(value: TComptimeValue) -> [TComptimeMapEntry]? {
    if value == {
        .Map(entries) -> Val(entries)
        else -> None
    }
}

// `jet_set_insert`, `jet_set_remove`, `jet_set_replace_kernel`,
// `jet_set_pop_kernel` and the `jet_set_*_update` kernels (MIREval
// `direct_mutating_collection`).
fn jet_eval_route_mutating_set(member: String, receiver: TComptimeValue, args: [TComptimeValue], result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRouteMutation? {
    if args.len() != 1 {
        jet_eval_compiler_fail(&machine, span, "MIR receiver-writing route {member} has an invalid ABI")
        return None
    }
    type_name := "Set"
    items := jet_eval_route_collection_items(receiver, "Set") ?? [TComptimeValue]{}
    if jet_eval_route_collection_items(receiver, "Set") == None {
        if member != "set_pop" {
            jet_eval_compiler_fail(&machine, span, "MIR set write receiver is not a Set")
            return None
        }
        items = jet_eval_route_collection_items(receiver, "Rank") ?? {
            jet_eval_compiler_fail(&machine, span, "MIR set pop receiver is not a Set")
            return None
        }
        type_name = "Rank"
    }
    value :: args[0]
    unit :: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}
    position := -1
    loop index in 0..<items.len() {
        if position < 0 && items[index] == value -> position = index
    }
    kept := [TComptimeValue]{}
    loop index in 0..<items.len() {
        if index != position -> &kept.push(items[index])
    }
    if member == {
        "set_insert" -> {
            if position < 0 -> &items.push(value)
            Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value(type_name, items), result: unit})
        }
        "set_remove" -> Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value(type_name, kept), result: unit})
        "set_replace" | "set_pop" -> {
            option_ty :: jet_eval_route_outcome_option(result_ty) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR set {member} outcome is not an Option carrier")
                return None
            }
            if position < 0 {
                if member == "set_replace" -> &items.push(value)
                return Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value(type_name, items), result: JetEvalRuntimeValue.Absent{element: jet_eval_option_element(option_ty)}})
            }
            previous :: items[position]
            if member == "set_replace" {
                items[position] = value
            } else {
                items = kept
            }
            Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value(type_name, items), result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: previous}}})
        }
        else -> {
            other :: jet_eval_route_collection_items(value, "Set") ?? {
                jet_eval_compiler_fail(&machine, span, "MIR set update operand is not a Set")
                return None
            }
            updated := [TComptimeValue]{}
            if member == {
                "set_update" -> {
                    updated = items
                    loop item in other {
                        if !jet_eval_route_has_item(updated, item) -> &updated.push(item)
                    }
                }
                "set_difference_update" -> {
                    loop item in items {
                        if !jet_eval_route_has_item(other, item) -> &updated.push(item)
                    }
                }
                "set_intersection_update" -> {
                    loop item in items {
                        if jet_eval_route_has_item(other, item) -> &updated.push(item)
                    }
                }
                "set_symmetric_difference_update" -> {
                    loop item in items {
                        if !jet_eval_route_has_item(other, item) -> &updated.push(item)
                    }
                    loop item in other {
                        if !jet_eval_route_has_item(items, item) && !jet_eval_route_has_item(updated, item) -> &updated.push(item)
                    }
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR receiver-writing route {member} is unknown")
                    return None
                }
            }
            Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value(type_name, updated), result: unit})
        }
    }
}

// `jet_sorted_set_insert` / `jet_sorted_set_remove`: `Rank` keeps one copy of
// each item in ascending order, so an insert lands before the first larger item.
fn jet_eval_route_mutating_rank(member: String, receiver: TComptimeValue, args: [TComptimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRouteMutation? {
    if args.len() != 1 {
        jet_eval_compiler_fail(&machine, span, "MIR receiver-writing route {member} has an invalid ABI")
        return None
    }
    items :: jet_eval_route_collection_items(receiver, "Rank") ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Rank write receiver is not a Rank")
        return None
    }
    value :: args[0]
    unit :: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}
    present :: jet_eval_route_has_item(items, value)
    updated := [TComptimeValue]{}
    if member == "sorted_set_remove" {
        loop item in items {
            if item != value -> &updated.push(item)
        }
        return Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value("Rank", updated), result: unit})
    }
    if present -> return Val(JetEvalRouteMutation{receiver: receiver, result: unit})
    placed := false
    loop item in items {
        if !placed {
            order :: jet_eval_route_order(value, item, &machine, span) ?? return None
            if order < 0 {
                &updated.push(value)
                placed = true
            }
        }
        &updated.push(item)
    }
    if !placed -> &updated.push(value)
    Val(JetEvalRouteMutation{receiver: jet_eval_route_collection_value("Rank", updated), result: unit})
}

// MIREval `direct_absent_value`: the clean absence of the row's checked
// Option outcome (or the Option success side of a Result row).
fn jet_eval_route_direct_absent(result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    option_ty :: jet_eval_route_outcome_option(result_ty) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Prelude route absence has no checked Option outcome")
        return None
    }
    Val(JetEvalRuntimeValue.Absent{element: jet_eval_option_element(option_ty)})
}

// Map writes that add a key place it at its sorted position, as every other
// evaluator map insertion does (Rust MIREval.rs::insert_map_entry).
fn jet_eval_route_map_put(entries: &[TComptimeMapEntry], key: TComptimeKey, value: TComptimeValue) Never! {
    inserted :: jet_eval_insert_map_entry(entries, key, value)
    loop index in 0..<entries.len() -> entries[index] = inserted[index]
    &entries.push(inserted[inserted.len() - 1])
}

fn jet_eval_route_rank_order(left: Int, right: Int) -> Int Never! {
    if left < right -> return -1
    if left > right -> return 1
    0
}

fn jet_eval_route_text_order(left: String, right: String) -> Int Never! {
    if left < right -> return -1
    if left > right -> return 1
    0
}

fn jet_eval_route_key_rank(key: TComptimeKey) -> Int Never! {
    if key == {
        .Int(_) -> 0
        .String(_) -> 1
        .Bool(_) -> 2
        .Char(_) -> 3
        .Tuple(_) -> 4
        .Struct(_, _) -> 5
        .Enum(_, _) -> 6
    }
}

fn jet_eval_route_key_fields_order(left: [TComptimeKeyField], right: [TComptimeKeyField]) -> Int Never! {
    common :: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<common {
        name :: jet_eval_route_text_order(left[index].name, right[index].name)
        if name != 0 -> return name
        order :: jet_eval_route_key_order(left[index].key, right[index].key)
        if order != 0 -> return order
    }
    jet_eval_route_rank_order(left.len(), right.len())
}

// The derived `Ord` of MIREval's `MirConstKey` (variant order, then payload).
fn jet_eval_route_key_order(left: TComptimeKey, right: TComptimeKey) -> Int Never! {
    rank :: jet_eval_route_rank_order(jet_eval_route_key_rank(left), jet_eval_route_key_rank(right))
    if rank != 0 -> return rank
    if left == {
        .Int(a) -> if right == .Int(b) -> return jet_eval_route_rank_order(a, b)
        .String(a) -> if right == .String(b) -> return jet_eval_route_text_order(a, b)
        .Bool(a) -> if right == .Bool(b) -> return jet_eval_route_rank_order(if a -> 1 else -> 0, if b -> 1 else -> 0)
        .Char(a) -> if right == .Char(b) -> return jet_eval_route_rank_order(a, b)
        .Tuple(a) -> if right == .Tuple(b) -> return jet_eval_route_key_fields_order(a, b)
        .Struct(a_name, a_fields) -> if right == .Struct(b_name, b_fields) {
            name :: jet_eval_route_text_order(a_name, b_name)
            if name != 0 -> return name
            return jet_eval_route_key_fields_order(a_fields, b_fields)
        }
        .Enum(a_name, a_variant) -> if right == .Enum(b_name, b_variant) {
            name :: jet_eval_route_text_order(a_name, b_name)
            if name != 0 -> return name
            return jet_eval_route_text_order(a_variant, b_variant)
        }
    }
    0
}

// Map entries in the key order MIREval's ordered maps iterate in.
fn jet_eval_route_entries_by_key(entries: [TComptimeMapEntry]) -> [TComptimeMapEntry] Never! {
    sorted := [TComptimeMapEntry]{}
    loop entry in entries {
        placed := false
        next_sorted := [TComptimeMapEntry]{}
        loop held in sorted {
            if !placed && jet_eval_route_key_order(entry.key, held.key) < 0 {
                &next_sorted.push(entry)
                placed = true
            }
            &next_sorted.push(held)
        }
        if !placed -> &next_sorted.push(entry)
        sorted = next_sorted
    }
    sorted
}

// MIREval `mir_compare` for the sort rows: numeric/text/Char/Bool order and
// lists compared lexicographically, then by length.
fn jet_eval_route_sort_order(left: TComptimeValue, right: TComptimeValue, machine: &JetEvalMachine, span: Span) -> Int? {
    if left == .List(left_items) {
        if right == .List(right_items) {
            common :: if left_items.len() < right_items.len() -> left_items.len() else -> right_items.len()
            loop index in 0..<common {
                order :: jet_eval_route_sort_order(left_items[index], right_items[index], &machine, span) ?? return None
                if order != 0 -> return Val(order)
            }
            if left_items.len() < right_items.len() -> return Val(-1)
            if left_items.len() > right_items.len() -> return Val(1)
            return Val(0)
        }
    }
    jet_eval_route_order(left, right, &machine, span)
}

// Stable merge sort (Rust `sort_by`); `descending` reverses the comparator.
fn jet_eval_route_sorted(items: [TComptimeValue], descending: Bool, machine: &JetEvalMachine, span: Span) -> [TComptimeValue]? {
    if items.len() < 2 -> return Val(items)
    middle :: items.len() /% 2
    left :: jet_eval_route_sorted(items[0..<middle], descending, &machine, span) ?? return None
    right :: jet_eval_route_sorted(items[middle..<items.len()], descending, &machine, span) ?? return None
    merged := [TComptimeValue]{}
    left_index := 0
    right_index := 0
    loop left_index < left.len() && right_index < right.len() {
        order := jet_eval_route_sort_order(left[left_index], right[right_index], &machine, span) ?? return None
        if descending -> order = 0 - order
        if order > 0 {
            &merged.push(right[right_index])
            right_index += 1
        } else {
            &merged.push(left[left_index])
            left_index += 1
        }
    }
    loop left_index < left.len() {
        &merged.push(left[left_index])
        left_index += 1
    }
    loop right_index < right.len() {
        &merged.push(right[right_index])
        right_index += 1
    }
    Val(merged)
}

fn jet_eval_route_mutation_fail(member: String, detail: String, machine: &JetEvalMachine, span: Span) -> JetEvalRouteMutation? {
    jet_eval_compiler_fail(&machine, span, "MIR {member} {detail}")
    None
}

// MIREval `direct_mutating_collection` for the List, PriorityQueue, Map and
// String receiver-writing rows.
fn jet_eval_route_mutating_collection(member: String, receiver: TComptimeValue, args: [TComptimeValue], result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRouteMutation? {
    unit :: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}
    present_unit :: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: TComptimeValue.Unit}}
    if member == "string_try_push" {
        text :: jet_eval_route_string(receiver) ?? return jet_eval_route_mutation_fail(member, "receiver is not a String", &machine, span)
        if args.len() != 1 -> return jet_eval_route_mutation_fail(member, "is missing its value", &machine, span)
        addition :: jet_eval_route_string(args[0]) ?? return jet_eval_route_mutation_fail(member, "value is not a String", &machine, span)
        return Val(JetEvalRouteMutation{receiver: TComptimeValue.String{value: "{text}{addition}"}, result: present_unit})
    }
    if member == "priority_queue_pop" {
        if receiver == .Struct(type_name, fields) {
            if type_name == "PriorityQueue" {
                loop index in 0..<fields.len() {
                    if fields[index].name != "items" -> next
                    items :: jet_eval_route_list(fields[index].value) ?? return jet_eval_route_mutation_fail(member, "has no List items field", &machine, span)
                    if items.len() == 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None})
                    updated := fields
                    updated[index].value = TComptimeValue.List{values: items[1..<items.len()]}
                    return Val(JetEvalRouteMutation{receiver: TComptimeValue.Struct{type_name: type_name, fields: updated}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: items[0]}}})
                }
                return jet_eval_route_mutation_fail(member, "has no List items field", &machine, span)
            }
        }
        return jet_eval_route_mutation_fail(member, "receiver is not a PriorityQueue", &machine, span)
    }
    if member.starts_with("map_") {
        entries := jet_eval_route_map_entries(receiver) ?? return jet_eval_route_mutation_fail(member, "receiver is not a Map", &machine, span)
        if member == "map_pop_first" {
            if entries.len() == 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None})
            first := 0
            loop index in 1..<entries.len() {
                if jet_eval_route_key_order(entries[index].key, entries[first].key) < 0 -> first = index
            }
            popped :: entries[first].value
            remaining := [TComptimeMapEntry]{}
            loop index in 0..<entries.len() {
                if index != first -> &remaining.push(entries[index])
            }
            return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: remaining}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: popped}}})
        }
        if args.len() == 0 -> return jet_eval_route_mutation_fail(member, "is missing its key", &machine, span)
        key :: jet_eval_data_key(args[0], &machine, span) ?? return None
        position := -1
        loop index in 0..<entries.len() {
            if position < 0 && entries[index].key == key -> position = index
        }
        if member == "map_remove" {
            if position < 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None})
            removed :: entries[position].value
            kept := [TComptimeMapEntry]{}
            loop index in 0..<entries.len() {
                if index != position -> &kept.push(entries[index])
            }
            return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: kept}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: removed}}})
        }
        if args.len() != 2 -> return jet_eval_route_mutation_fail(member, "is missing its value", &machine, span)
        value :: args[1]
        if member == {
            "map_add_new" -> {
                if position >= 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}}})
                jet_eval_route_map_put(&entries, key, value)
                return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: entries}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: true}}})
            }
            "map_setdefault" -> {
                if position >= 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: JetEvalRuntimeValue.Data{value: entries[position].value}})
                jet_eval_route_map_put(&entries, key, value)
                return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: entries}, result: JetEvalRuntimeValue.Data{value: value}})
            }
            else -> {
                // map_try_insert: `Present(previous?)`.
                if position >= 0 {
                    previous :: entries[position].value
                    entries[position].value = value
                    return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: entries}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: TComptimeValue.Present{value: previous}}}})
                }
                jet_eval_route_map_put(&entries, key, value)
                absent :: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None
                return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: entries}, result: JetEvalRuntimeValue.Result{ok: true, value: absent}})
            }
        }
    }
    if member == "list_clear" {
        if receiver == {
            .List(_) -> return Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: [TComptimeValue]{}}, result: unit})
            .Map(_) -> return Val(JetEvalRouteMutation{receiver: TComptimeValue.Map{entries: [TComptimeMapEntry]{}}, result: unit})
            else -> return jet_eval_route_mutation_fail(member, "receiver is not a collection", &machine, span)
        }
    }
    items := jet_eval_route_list(receiver) ?? return jet_eval_route_mutation_fail(member, "receiver is not a List", &machine, span)
    if member == {
        "list_push" | "list_try_push" -> {
            if args.len() != 1 -> return jet_eval_route_mutation_fail(member, "is missing its value", &machine, span)
            &items.push(args[0])
            result :: if member == "list_push" -> unit else -> present_unit
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: items}, result: result})
        }
        "list_extend" -> {
            if args.len() != 1 -> return jet_eval_route_mutation_fail(member, "is missing its source", &machine, span)
            other :: jet_eval_route_list(args[0]) ?? return jet_eval_route_mutation_fail(member, "requires two Lists", &machine, span)
            loop item in other -> &items.push(item)
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: items}, result: unit})
        }
        "list_reverse" -> {
            reversed := [TComptimeValue]{}
            index := items.len() - 1
            loop index >= 0 {
                &reversed.push(items[index])
                index -= 1
            }
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: reversed}, result: unit})
        }
        "list_sort" | "list_sort_desc" -> {
            sorted :: jet_eval_route_sorted(items, member == "list_sort_desc", &machine, span) ?? return None
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: sorted}, result: unit})
        }
        "list_try_reserve" -> {
            if args.len() != 1 -> return jet_eval_route_mutation_fail(member, "amount is not a nonnegative Int", &machine, span)
            additional :: jet_eval_route_int_value(args[0], &machine, span) ?? return None
            if additional < 0 -> return jet_eval_route_mutation_fail(member, "amount is not a nonnegative Int", &machine, span)
            Val(JetEvalRouteMutation{receiver: receiver, result: present_unit})
        }
        "list_pop" -> {
            if items.len() == 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None})
            last :: items[items.len() - 1]
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: items[0..<items.len() - 1]}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: last}}})
        }
        "list_insert" -> {
            if args.len() != 2 -> return jet_eval_route_mutation_fail(member, "is missing its index or value", &machine, span)
            position :: if args[0] == .Int(number) -> number else -> { return jet_eval_route_mutation_fail(member, "index is not an Int", &machine, span) }
            if position < 0 || position > items.len() -> return jet_eval_route_mutation_fail(member, "index is out of bounds", &machine, span)
            inserted := [TComptimeValue]{}
            loop index in 0..<items.len() {
                if index == position -> &inserted.push(args[1])
                &inserted.push(items[index])
            }
            if position == items.len() -> &inserted.push(args[1])
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: inserted}, result: unit})
        }
        "list_remove_value" | "list_remove_slot" -> {
            if args.len() != 1 -> return jet_eval_route_mutation_fail(member, "is missing its operand", &machine, span)
            position := -1
            if member == "list_remove_value" {
                loop index in 0..<items.len() {
                    if position < 0 && items[index] == args[0] -> position = index
                }
                if position < 0 -> return Val(JetEvalRouteMutation{receiver: receiver, result: jet_eval_route_direct_absent(result_ty, &machine, span) ?? return None})
            } else {
                position = if args[0] == .Int(number) -> number else -> { return jet_eval_route_mutation_fail(member, "index is not a nonnegative Int", &machine, span) }
                if position < 0 -> return jet_eval_route_mutation_fail(member, "index is not a nonnegative Int", &machine, span)
                if position >= items.len() -> return jet_eval_route_mutation_fail(member, "index is out of bounds", &machine, span)
            }
            removed :: items[position]
            kept := [TComptimeValue]{}
            loop index in 0..<items.len() {
                if index != position -> &kept.push(items[index])
            }
            Val(JetEvalRouteMutation{receiver: TComptimeValue.List{values: kept}, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: removed}}})
        }
        else -> jet_eval_route_mutation_fail(member, "is not a receiver-writing collection route", &machine, span)
    }
}

fn jet_eval_route_mutating_builtin(member: String, receiver: TComptimeValue, args: [TComptimeValue], result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRouteMutation? {
    if member.starts_with("sorted_set_") -> return jet_eval_route_mutating_rank(member, receiver, args, &machine, span)
    if member.starts_with("set_") -> return jet_eval_route_mutating_set(member, receiver, args, result_ty, &machine, span)
    if member != "map_insert" -> return jet_eval_route_mutating_collection(member, receiver, args, result_ty, &machine, span)
    if args.len() != 2 {
        jet_eval_compiler_fail(&machine, span, "MIR receiver-writing route {member} has an invalid ABI")
        return None
    }
    entries := if receiver == {
        .Map(values) -> values
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR map insert receiver is not a Map")
            return None
        }
    }
    key :: jet_eval_data_key(args[0], &machine, span) ?? return None
    previous := TComptimeValue?{None}
    loop index in 0..<entries.len() {
        if entries[index].key == key {
            previous = Val(entries[index].value)
            entries[index].value = args[1]
        }
    }
    if previous == None -> entries = jet_eval_insert_map_entry(entries, key, args[1])
    updated :: TComptimeValue.Map{entries: entries}
    // `jet_map_insert` returns the displaced value (`replace`/`add` read it
    // as `V?`); a Unit-typed row discards it.
    option_ty :: jet_eval_route_outcome_option(result_ty) ?? return Val(JetEvalRouteMutation{receiver: updated, result: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}})
    element :: jet_eval_option_element(option_ty)
    result :: if previous == {
        Val(value) -> JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: value}}
        None -> JetEvalRuntimeValue.Absent{element: element}
    }
    Val(JetEvalRouteMutation{receiver: updated, result: result})
}

// One UTF-8 scalar at `index` (Rust `run_utf8_validation`): its byte length
// when valid, `-n` for an invalid sequence of `n` bytes, or 0 when the input
// ends inside an incomplete sequence.
fn jet_eval_route_utf8_step(bytes: [U8], index: Int) -> Int Never! {
    first :: Int.from_u8(bytes[index])
    if first < 128 -> return 1
    width :: if {
        first >= 194 && first <= 223 -> 2
        first >= 224 && first <= 239 -> 3
        first >= 240 && first <= 244 -> 4
        else -> 0
    }
    if width == 0 -> return -1
    if index + 1 >= bytes.len() -> return 0
    second :: Int.from_u8(bytes[index + 1])
    low := 128
    high := 191
    if first == 224 -> low = 160
    if first == 237 -> high = 159
    if first == 240 -> low = 144
    if first == 244 -> high = 143
    if second < low || second > high -> return -1
    if width == 2 -> return 2
    if index + 2 >= bytes.len() -> return 0
    third :: Int.from_u8(bytes[index + 2])
    if third < 128 || third > 191 -> return -2
    if width == 3 -> return 3
    if index + 3 >= bytes.len() -> return 0
    fourth :: Int.from_u8(bytes[index + 3])
    if fourth < 128 || fourth > 191 -> return -3
    4
}

// `String::from_utf8(..).map_err(|error| error.to_string())`: the
// `Utf8Error` Display text of the first invalid position, or None when valid.
fn jet_eval_route_utf8_error(bytes: [U8]) -> String? {
    index := 0
    loop index < bytes.len() {
        step :: jet_eval_route_utf8_step(bytes, index)
        if step == 0 -> return Val("incomplete utf-8 byte sequence from index {index}")
        if step < 0 -> return Val("invalid utf-8 sequence of {0 - step} bytes from index {index}")
        index += step
    }
    None
}

// `String::from_utf8_lossy`: every invalid sequence (and a trailing
// incomplete one) becomes one U+FFFD.
fn jet_eval_route_utf8_lossy(bytes: [U8]) -> String Never! {
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        step :: jet_eval_route_utf8_step(bytes, index)
        if step > 0 {
            loop offset in 0..<step -> &out.push(bytes[index + offset])
            index += step
        } else {
            &out.push(U8{239})
            &out.push(U8{191})
            &out.push(U8{189})
            index = if step == 0 -> bytes.len() else -> index + (0 - step)
        }
    }
    String.from_bytes(out) ?? ""
}

// Rust `str::lines`: split on `\n`, drop one `\r` before it, and no empty
// final line after a trailing newline.
fn jet_eval_route_lines(text: String) -> [TComptimeValue] Never! {
    bytes :: text.bytes()
    lines := [TComptimeValue]{}
    start := 0
    loop index in 0..<bytes.len() {
        if Int.from_u8(bytes[index]) != 10 -> next
        end := index
        if end > start && Int.from_u8(bytes[end - 1]) == 13 -> end -= 1
        &lines.push(TComptimeValue.String{value: String.from_bytes(bytes[start..<end]) ?? ""})
        start = index + 1
    }
    if start < bytes.len() -> &lines.push(TComptimeValue.String{value: String.from_bytes(bytes[start..<bytes.len()]) ?? ""})
    lines
}

fn jet_eval_route_byte_find(haystack: [U8], needle: [U8]) -> Int? {
    if needle.len() > haystack.len() -> return None
    loop start in 0..<(haystack.len() - needle.len() + 1) {
        matched := true
        loop offset in 0..<needle.len() {
            if haystack[start + offset] != needle[offset] {
                matched = false
                break
            }
        }
        if matched -> return Val(start)
    }
    None
}

// The `jet_list_slice` window: start and end clamp into `0..len`, and an end
// before the start is an empty window at the start.
fn jet_eval_route_clamped_window(len: Int, start: Int, end: Int) -> (from: Int, to: Int) Never! {
    from :: if {
        start < 0 -> 0
        start > len -> len
        else -> start
    }
    to :: if {
        end < from -> from
        end > len -> len
        else -> end
    }
    (from: from, to: to)
}

fn jet_eval_route_string_operand(args: [TComptimeValue], index: Int, member: String, machine: &JetEvalMachine, span: Span) -> String? {
    if index >= args.len() {
        jet_eval_compiler_fail(&machine, span, "MIR {member} route is missing a String operand")
        return None
    }
    text :: jet_eval_route_string(args[index]) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR {member} route requires String operands")
        return None
    }
    Val(text)
}

fn jet_eval_route_string_result(text: String) -> JetEvalRuntimeValue? {
    Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: text}})
}

fn jet_eval_route_ordering(variant: String) -> TComptimeValue Never! {
    TComptimeValue.Enum{type_name: "Ordering", variant: variant, args: [TComptimeEnumArg]{}}
}

fn jet_eval_route_ordering_variant(value: TComptimeValue) -> String? {
    if value == .Enum(type_name, variant, args) {
        if type_name == "Ordering" && args.len() == 0 -> return Val(variant)
    }
    None
}

// Builtins `sum`/`product` over a List: an exact integer fold through the
// canonical exact-integer adapter, or a same-width Float sum.
fn jet_eval_route_fold(member: String, items: [TComptimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    int_ty :: Val(mir_type_from_kind(MIRTypeKind.Int))
    if member == "sum" && items.len() > 0 {
        if items[0] == .Float(_, bits) {
            float_total := Float{0}
            loop item in items {
                if item == .Float(number, item_bits) {
                    if item_bits != bits -> return jet_eval_route_not_supported(&machine, span, "sum on mixed float widths")
                    float_total = float_total + number
                } else {
                    return jet_eval_route_not_supported(&machine, span, "sum on mixed numeric types")
                }
            }
            if bits == 32 -> return jet_eval_route_not_supported(&machine, span, "Float32 sum without width-preserving arithmetic")
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: float_total, bits: bits}})
        }
    }
    total := JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: if member == "sum" -> 0 else -> 1}}
    operation :: if member == "sum" -> "add" else -> "mul"
    loop item in items {
        if !jet_eval_route_is_exact_integer(item) -> return jet_eval_route_not_supported(&machine, span, "{member} on mixed numeric types")
        total = jet_eval_route_exact_integer_member_host(operation, [JetEvalRuntimeValue]{total, JetEvalRuntimeValue.Data{value: item}}, &machine, int_ty, span) ?? return None
    }
    Val(total)
}

fn jet_eval_route_builtin(member: String, symbol: String, args: [TComptimeValue], fallibility: MIRCallFallibility, result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if jet_eval_route_is_text_member(member) -> return jet_eval_route_text_method(member, args, &machine, span)
    if member == {
        "string_ascii_lower" | "string_ascii_upper" -> {
            if args.len() != 1 {
                jet_eval_compiler_fail(&machine, span, "ASCII string route requires one String")
                return None
            }
            text :: jet_eval_route_string(args[0]) ?? {
                jet_eval_compiler_fail(&machine, span, "ASCII string route requires one String")
                return None
            }
            output :: jet_eval_route_ascii_case(text, member == "string_ascii_upper")
            Val(jet_eval_route_success(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: output}}, fallibility))
        }
        "string_starts_with" -> {
            if args.len() != 2 {
                jet_eval_compiler_fail(&machine, span, "String.starts_with route requires two Strings")
                return None
            }
            text :: jet_eval_route_string(args[0]) ?? {
                jet_eval_compiler_fail(&machine, span, "String.starts_with route requires two Strings")
                return None
            }
            prefix :: jet_eval_route_string(args[1]) ?? {
                jet_eval_compiler_fail(&machine, span, "String.starts_with route requires two Strings")
                return None
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: text.starts_with(prefix)}})
        }
        // MIREval `string_from_bytes`/`_lossy`: strict decoding reports the
        // typed `UTF8Error { message }`; lossy decoding substitutes U+FFFD.
        "string_from_bytes" | "string_from_bytes_lossy" -> {
            if args.len() != 1 {
                jet_eval_compiler_fail(&machine, span, "String.from_bytes route requires one buffer")
                return None
            }
            bytes := [U8]{}
            if args[0] == {
                .Bytes(values) -> bytes = values
                .List(values) -> loop value in values {
                    number :: jet_eval_route_int_value(value, &machine, span) ?? return None
                    if number < 0 || number > 255 {
                        jet_eval_compiler_fail(&machine, span, "MIR String.from_bytes byte list contains a value outside U8")
                        return None
                    }
                    &bytes.push(U8{number})
