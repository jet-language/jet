                    if entry.key == key -> found = true
                }
                if !found -> entries = jet_eval_insert_map_entry(entries, key, args[1])
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Map{entries: entries}})
        }
        "string_ends_with" -> {
            if symbol != "jet_string_ends_with" {
                jet_eval_compiler_fail(&machine, span, "MIR String prefix/suffix route has an unknown checked symbol")
                return None
            }
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            suffix :: jet_eval_route_string_operand(args, 1, member, &machine, span) ?? return None
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: text.ends_with(suffix)}})
        }
        "string_trim" | "string_upper" | "upper" | "string_lower" | "lower" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            if member == "string_trim" -> return jet_eval_route_string_result(text.trim())
            if member.ends_with("upper") -> return jet_eval_route_string_result(text.to_upper())
            jet_eval_route_string_result(text.to_lower())
        }
        "string_replace" | "replace" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            from :: jet_eval_route_string_operand(args, 1, member, &machine, span) ?? return None
            to :: jet_eval_route_string_operand(args, 2, member, &machine, span) ?? return None
            jet_eval_route_string_result(text.replace(from, to))
        }
        "string_repeat" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "String.repeat without a count")
            count :: jet_eval_route_int_value(args[1], &machine, span) ?? return None
            jet_eval_route_string_result(text.repeat(if count < 0 -> 0 else -> count))
        }
        "string_lines" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: jet_eval_route_lines(text)}})
        }
        "string_chars" -> {
            text :: jet_eval_route_string_operand(args, 0, member, &machine, span) ?? return None
            chars :: loop character in text.chars() -> jet_eval_char_value(character)
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: chars}})
        }
        // Builtins `slice` on String: scalar offsets, with the shared panic
