        "list_replace" -> {
            if args.len() != 3 -> return jet_eval_route_not_supported(&machine, span, "List.replace without an index and value")
            items := jet_eval_route_list(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "List.replace on a non-list")
            index :: jet_eval_route_int_value(args[1], &machine, span) ?? return None
            if index >= 0 && index < items.len() -> items[index] = args[2]
