        }
        "map_top_n" -> {
            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "Map.top_n without a count")
            entries :: jet_eval_route_map_entries(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "top_n on a non-map")
            count := jet_eval_route_int_value(args[1], &machine, span) ?? return None
            if count <= 0 -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: [TComptimeValue]{}}})
            ranked := [TComptimeMapEntry]{}
            loop entry in entries {
                placed := false
                next_ranked := [TComptimeMapEntry]{}
                loop held in ranked {
                    if !placed {
                        order :: jet_eval_route_order(held.value, entry.value, &machine, span) ?? return None
                        if order < 0 || (order == 0 && jet_eval_route_key_order(entry.key, held.key) < 0) {
                            &next_ranked.push(entry)
                            placed = true
                        }
                    }
                    &next_ranked.push(held)
                }
                if !placed -> &next_ranked.push(entry)
                ranked = next_ranked
            }
            rows := [TComptimeValue]{}
            loop index in 0..<ranked.len() {
                if index >= count -> break
                &rows.push(TComptimeValue.Struct{type_name: "", fields: [TComptimeField]{
                    TComptimeField{name: "key", value: jet_eval_iterator_key_value(ranked[index].key)},
                    TComptimeField{name: "value", value: ranked[index].value},
                }})
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: rows}})
        }
        "ordering_reverse" -> {
            if args.len() != 1 -> return jet_eval_route_not_supported(&machine, span, "Ordering.reverse without a receiver")
            variant :: jet_eval_route_ordering_variant(args[0]) ?? return jet_eval_route_not_supported(&machine, span, "Ordering.reverse on a non-Ordering")
            reversed :: if variant == {
                "Less" -> "Greater"
                "Greater" -> "Less"
                else -> variant
            }
            Val(JetEvalRuntimeValue.Data{value: jet_eval_route_ordering(reversed)})
        }
        "compare" | "eq" | "ne" | "lt" | "gt" | "le" | "ge" -> jet_eval_route_compare(member, args, &machine, span)
        "string_split" | "iter_to_list" | "iter_collect" -> jet_eval_route_not_supported(&machine, span, "stream-producing builtin route")
        else -> jet_eval_route_not_supported(&machine, span, "Prelude builtin {member}")
    }
}

fn jet_eval_route_prelude(machine: &JetEvalMachine, call: MIRPreludeCallID, args: [JetEvalRuntimeValue], type_args: [MIRType], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if !jet_eval_route_signature_prelude(row, args.len(), &machine, span) -> return None
    if row.abi == MIRPreludeABI.Control || row.abi == MIRPreludeABI.Effect -> return jet_eval_route_not_supported(&machine, span, "effectful or control Prelude route")
    if row.module_name == "core.prelude" && row.member == "keep" {
        symbol :: mir_symbol_name(row.symbol)
        if symbol != "jet_keep" || args.len() != 1 -> return jet_eval_route_not_supported(&machine, span, "invalid core.prelude.keep ABI")
        return jet_eval_copy_value(args[0], &machine, span)
    }
    symbol :: jet_eval_route_symbol_prelude(row, &machine, span) ?? return None
    data :: jet_eval_route_args(args, &machine, span) ?? return None
    // MIREval `core.text.fmt` display/debug: the evaluator-owned structural
    // renderers (Formatting/Values.jet), never a source target.
    if row.family == MIRPreludeFamily.StaticPrelude && row.module_name == "core.text.fmt" && (row.member == "display" || row.member == "debug") {
        expected :: if row.member == "display" -> "jet_fmt_display" else -> "jet_fmt_debug"
        if symbol != expected || data.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR core.text.fmt.{row.member} route has non-canonical metadata")
            return None
        }
        shown :: if row.member == "display" -> jet_eval_format_display(&machine, data[0], span) else -> jet_eval_format_debug(&machine, data[0], span)
        rendered :: shown ?? return None
        return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: rendered}})
    }
    if row.family == MIRPreludeFamily.StaticPrelude && row.module_name == "core.host" && symbol == "jet_comptime_host_method" {
        parts :: jet_eval_compiler_value_method_owner(row.member) ?? return jet_eval_route_not_supported(&machine, span, "invalid compiler host method member")
        if jet_eval_reflection_metadata_supported(parts[0], parts[1]) -> return jet_eval_route_reflection_host(row, data, &machine, span)
        if jet_eval_compiler_value_method_supported(parts[0], parts[1], data.len() - 1) -> return jet_eval_route_compiler_value_host(row, data, &machine, span)
    }
    if row.family == MIRPreludeFamily.Overflow && row.module_name == "core.numeric" && jet_eval_route_is_exact_integer_member(row.member) && jet_eval_route_exact_integer_symbol(row.member, symbol) -> return jet_eval_route_exact_integer_host(row, args, &machine, result_ty, span)
    if row.family == MIRPreludeFamily.Overflow {
        fixed :: jet_eval_route_fixed_member(row.member)
        if fixed != None && jet_eval_route_fixed_symbol(fixed, symbol) -> return jet_eval_route_fixed_host(row, args, &machine, result_ty, span)
    }
    if row.family == MIRPreludeFamily.BuiltinMethod && row.module_name == "core.compare" && symbol == "jet_int_compare" -> return jet_eval_route_exact_compare_member_host(row.member, args, &machine, result_ty, span)
    if row.family == MIRPreludeFamily.BuiltinMethod && row.module_name == "core.numeric" && (row.member == "bit_count" || row.member == "int_bit_count") -> return jet_eval_route_numeric_conversion(row, args, &machine, result_ty, span)
    if row.family == MIRPreludeFamily.BuiltinMethod || row.family == MIRPreludeFamily.MathBuiltin -> return jet_eval_route_builtin(row.member, symbol, data, row.fallibility, result_ty, &machine, span)
    if row.family == MIRPreludeFamily.PreciseBuiltin {
        if jet_eval_route_precise_operator(row.module_name, row.member) && jet_eval_route_precise_symbol(row.module_name, row.member, symbol) -> return jet_eval_host_row(&machine, row, args, result_ty, span)
        return jet_eval_route_not_supported(&machine, span, "PreciseBuiltin route has no canonical numeric adapter")
    }
    if row.family == MIRPreludeFamily.StaticPrelude && symbol.starts_with("jet_") -> return jet_eval_route_numeric_conversion(row, args, &machine, result_ty, span)
    jet_eval_route_not_supported(&machine, span, "Prelude route {row.module_name}.{row.member}")
}
