            if member == "list_equal" -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left == right}})
            if right.len() > left.len() -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
            offset :: if member == "list_ends_with" -> left.len() - right.len() else -> 0
