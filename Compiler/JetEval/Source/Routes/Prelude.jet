            if args.len() != 2 -> return jet_eval_route_told_failure("invalid integer text", fallibility)
            text :: jet_eval_route_string(args[0]) ?? return jet_eval_route_told_failure("invalid integer text", fallibility)
            radix :: jet_eval_route_int_value(args[1], &machine, span) ?? return None
            parsed :: jet_eval_route_parse_integer(text, radix) ?? return jet_eval_route_told_failure(jet_eval_route_parse_integer_failure(text, radix), fallibility)
            Val(jet_eval_route_success(JetEvalRuntimeValue.Data{value: parsed}, fallibility))
        }
        "list_count" -> {
            if args.len() != 2 {
                jet_eval_compiler_fail(&machine, span, "list_count route requires a List and value")
                return None
