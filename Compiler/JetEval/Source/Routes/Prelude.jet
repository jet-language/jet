            Val(jet_eval_route_position(None))
        }
        "int_to_radix" -> {
            if args.len() != 2 -> return jet_eval_route_not_supported(&machine, span, "Int.to_radix expects one radix")
            number :: jet_eval_route_int_value(args[0], &machine, span) ?? return None
            radix :: jet_eval_route_int_value(args[1], &machine, span) ?? return None
            if radix < 2 || radix > 36 -> return jet_eval_route_not_supported(&machine, span, "integer radix must be between 2 and 36, got {radix}")
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: number.to_radix(radix)}})
        }
