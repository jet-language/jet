                .Bytes(values) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: values.len()}})
                .Map(values) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: values.len()}})
                .String(text) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: text.chars().len()}})
                .Struct(_, _) -> {
