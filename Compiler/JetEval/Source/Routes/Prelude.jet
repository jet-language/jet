                error :: TComptimeValue.Struct{type_name: "UTF8Error", fields: [TComptimeField]{TComptimeField{name: "message", value: TComptimeValue.String{value: message}}}}
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Failed{report: TComptimeReport.Told{value: error}}})
