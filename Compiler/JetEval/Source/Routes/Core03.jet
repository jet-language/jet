fn xml_shape_error(reason: String) -> CtValue { EncodingLite.xml_shape_error_value(reason) }

// Email uses the shared Prelude kernel through EmailAdapter.
// CtValue adapters for the shared sketch kernel.
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4311
fn hll_from_value(value: &CtValue, span: Span) -> sketch_kernel.JetHyperLogLog Diagnostic! {
    registers :: if field(value, "HyperLogLog", "registers") == {
        .Val(.List(registers)) -> registers
        else -> return .Err(unsupported("malformed HyperLogLog.registers value", span))
    }
    bytes := [U8].with_capacity(registers.len())
    loop value in registers {
        if value == {
            .Int(value) if value >= 0 && value <= 255 -> bytes.push(value as U8)
            else -> return .Err(unsupported("malformed HyperLogLog register", span))
        }
    }
    sketch_kernel.JetHyperLogLog.from_registers(^bytes)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4332
fn hll_value(sketch: &sketch_kernel.JetHyperLogLog) -> CtValue {
    structure("HyperLogLog", [("registers", CtValue.List(sketch.registers().into_iter().map(fn(value) { CtValue.Int(value as I64) }).collect()))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4348
fn hll_new() -> CtValue { hll_value(&sketch_kernel.JetHyperLogLog.new()) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4352
fn hll_add(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch := hll_from_value(recv, span)?
    sketch.add(string_arg(args, 0, span)?)
    hll_value(&sketch)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4358
fn hll_count(recv: &CtValue, span: Span) -> CtValue Diagnostic! { CtValue.Int(hll_from_value(recv, span)?.count()) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4362
fn tdigest_from_value(value: &CtValue, span: Span) -> sketch_kernel.JetTDigest Diagnostic! {
    items :: if field(value, "TDigest", "centroids") == {
        .Val(.List(items)) -> items
        else -> return .Err(unsupported("malformed TDigest.centroids value", span))
    }
    centroids := [(F64, F64)].with_capacity(items.len())
    loop item in items {
        if item == {
            .List(pair) if pair.len() == 2 -> centroids.push((as_float(&pair[0], span)?, as_float(&pair[1], span)?))
            else -> return .Err(unsupported("malformed TDigest centroid", span))
        }
    }
    sketch_kernel.JetTDigest.from_centroids(^centroids)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4383
fn tdigest_value(sketch: &sketch_kernel.JetTDigest) -> CtValue {
    structure("TDigest", [("centroids", CtValue.List(sketch.centroids().into_iter().map(fn(pair) {
        (mean, weight) :: pair
        CtValue.List([CtValue.Float(CtFloat.f64(mean)), CtValue.Float(CtFloat.f64(weight))])
    }).collect()))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4404
fn tdigest_new() -> CtValue { tdigest_value(&sketch_kernel.JetTDigest.new()) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4408
fn tdigest_add(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch := tdigest_from_value(recv, span)?
    sketch.add(float_arg(args, 0, span)?)
    tdigest_value(&sketch)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4414
fn tdigest_quantile(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch :: tdigest_from_value(recv, span)?
    CtValue.Float(CtFloat.f64(sketch.quantile(float_arg(args, 0, span)?)))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4421
fn cms_from_value(value: &CtValue, span: Span) -> sketch_kernel.JetCountMinSketch Diagnostic! {
    rows :: if field(value, "CountMinSketch", "rows") == {
        .Val(.List(rows)) -> rows
        else -> return .Err(unsupported("malformed CountMinSketch.rows value", span))
    }
    if rows.len() != 4 -> return .Err(unsupported("malformed CountMinSketch.rows value", span))
    out := [[U32; sketch_kernel.JET_CMS_COLS]; 4].filled(0)
    loop (row_index, row) in rows.iter().enumerate() {
        columns :: if row == { .List(columns) -> columns; else -> return .Err(unsupported("malformed CountMinSketch row", span)) }
        if columns.len() != sketch_kernel.JET_CMS_COLS -> return .Err(unsupported("malformed CountMinSketch row", span))
        loop (column_index, cell) in columns.iter().enumerate() {
            value :: if cell == { .Int(value) -> value; else -> return .Err(unsupported("malformed CountMinSketch cell", span)) }
            if value < 0 || value > U32.MAX as I64 -> return .Err(unsupported("malformed CountMinSketch cell", span))
            out[row_index][column_index] = value as U32
        }
    }
    sketch_kernel.JetCountMinSketch.from_rows(^out)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4454
fn cms_value(sketch: &sketch_kernel.JetCountMinSketch) -> CtValue {
    structure("CountMinSketch", [("rows", CtValue.List(sketch.rows().into_iter().map(fn(row) {
        CtValue.List(row.into_iter().map(fn(value) { CtValue.Int(value as I64) }).collect())
    }).collect()))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4476
fn cms_new() -> CtValue { cms_value(&sketch_kernel.JetCountMinSketch.new()) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4480
fn cms_add(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch := cms_from_value(recv, span)?
    sketch.add(string_arg(args, 0, span)?)
    cms_value(&sketch)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4486
fn cms_count(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch :: cms_from_value(recv, span)?
    CtValue.Int(sketch.count(string_arg(args, 0, span)?))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4491
fn reservoir_from_value(value: &CtValue, span: Span) -> sketch_kernel.JetReservoirSampler Diagnostic! {
    capacity :: int_field(value, "ReservoirSampler", "capacity", span)?
    count :: int_field(value, "ReservoirSampler", "count", span)?
    rng :: int_field(value, "ReservoirSampler", "rng", span)?
    items :: if value_field(value, "ReservoirSampler", "reservoir", span)? == {
        .List(items) -> items
        else -> return .Err(unsupported("malformed ReservoirSampler.reservoir value", span))
    }
    reservoir := [String].with_capacity(items.len())
    loop item in items {
        if item == { .Str(text) -> reservoir.push(^text); else -> return .Err(unsupported("malformed ReservoirSampler item", span)) }
    }
    sketch_kernel.JetReservoirSampler.from_parts(capacity as USize, ^reservoir, count as U64, rng as U64)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4519
fn reservoir_value(sketch: &sketch_kernel.JetReservoirSampler) -> CtValue {
    (capacity, reservoir, count, rng) :: sketch.parts()
    structure("ReservoirSampler", [("capacity", CtValue.Int(capacity as I64)), ("count", CtValue.Int(count as I64)), ("rng", CtValue.Int(rng as I64)), ("reservoir", CtValue.List(reservoir.into_iter().map(CtValue.Str).collect()))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4535
fn reservoir_new(args: &[CtValue], span: Span) -> CtValue Diagnostic! { reservoir_value(&sketch_kernel.JetReservoirSampler.new(int_arg(args, 0, span)?)) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4541
fn reservoir_add(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    sketch := reservoir_from_value(recv, span)?
    sketch.add(string_arg(args, 0, span)?.to_string())
    reservoir_value(&sketch)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4547
fn reservoir_sample(recv: &CtValue, span: Span) -> CtValue Diagnostic! { CtValue.List(reservoir_from_value(recv, span)?.sample().into_iter().map(CtValue.Str).collect()) }

// CtValue adapter for the shared solver kernel.
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4559
fn solver_from_value(value: &CtValue, span: Span) -> solver_kernel.jet_std.Solver Diagnostic! {
    solver_kernel.jet_std.Solver{seed: int_field(value, Syntax.SOLVER_TYPE, "seed", span)?, checked: int_field(value, Syntax.SOLVER_TYPE, "checked", span)?, failures: int_field(value, Syntax.SOLVER_TYPE, "failures", span)?}
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4570
fn solver_value(solver: solver_kernel.jet_std.Solver) -> CtValue {
    structure(Syntax.SOLVER_TYPE, [("seed", CtValue.Int(solver.seed)), ("checked", CtValue.Int(solver.checked)), ("failures", CtValue.Int(solver.failures))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4581
fn solver_require_update(recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    solver := solver_from_value(recv, span)?
    ok :: as_bool(one(args, 0, "Solver", "require", span)?, span)?
    solver_kernel.jet_solver_require(&solver, ok)
    solver_value(^solver)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4588
fn solver_failure_count(recv: &CtValue, span: Span) -> CtValue Diagnostic! {
    solver :: solver_from_value(recv, span)?
    CtValue.Int(solver_kernel.jet_solver_failure_count(&solver))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4595
fn solver_status(recv: &CtValue, span: Span) -> CtValue Diagnostic! {
    solver :: solver_from_value(recv, span)?
    CtValue.Str(solver_kernel.jet_solver_status(&solver))
}
