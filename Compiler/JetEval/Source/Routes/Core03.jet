            actual :: actual.strip_prefix(Syntax.GENERATED_NAME_PREFIX) ?? actual // #4303
            if (type_name == "Date" || type_name == "LocalDate") && (actual == "Date" || actual == "LocalDate") -> actual else -> type_name
