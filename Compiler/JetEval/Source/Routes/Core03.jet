// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4188
fn measurement_arithmetic(left: &CtValue, method: String, right: &CtValue, span: Span) -> CtValue Diagnostic! {
    left_value :: if field(left, "Measurement", "value") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.value value", span)) }
    left_uncertainty :: if field(left, "Measurement", "uncertainty") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.uncertainty value", span)) }
    right_value :: if field(right, "Measurement", "value") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.value value", span)) }
    right_uncertainty :: if field(right, "Measurement", "uncertainty") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.uncertainty value", span)) }
    left :: (left_value, left_uncertainty)
    right :: (right_value, right_uncertainty)
    (value, uncertainty) :: if method == {
        "add" -> measurement_kernel.jet_measurement_kernel_add(left, right)
        "sub" -> measurement_kernel.jet_measurement_kernel_sub(left, right)
        "mul" -> measurement_kernel.jet_measurement_kernel_mul(left, right)
        "div" -> measurement_kernel.jet_measurement_kernel_div(left, right)
        else -> panic("unreachable measurement arithmetic method")
    }
    structure("Measurement", [("value", CtValue.Float(CtFloat.f64(value))), ("uncertainty", CtValue.Float(CtFloat.f64(uncertainty)))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4222
fn measurement_sqrt(value: &CtValue, span: Span) -> CtValue Diagnostic! {
    measured :: if field(value, "Measurement", "value") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.value value", span)) }
    uncertainty :: if field(value, "Measurement", "uncertainty") == { .Val(.Float(value)) -> value.as_f64(); else -> return .Err(unsupported("malformed Measurement.uncertainty value", span)) }
    (value, uncertainty) :: measurement_kernel.jet_measurement_kernel_sqrt((measured, uncertainty))
    structure("Measurement", [("value", CtValue.Float(CtFloat.f64(value))), ("uncertainty", CtValue.Float(CtFloat.f64(uncertainty)))])
}

// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4244
fn xml_canonical(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    tree :: one(args, 0, "core.encoding.xml", "canonical", span)?
    options :: one(args, 1, "core.encoding.xml", "canonical", span)?
    value :: if EncodingLite.xml_from_ct(tree) == {
        .Ok(value) -> value
        .Err(_) -> return CtValue.failed(xml_shape_error("XML tree cannot contain Float or Bytes values"))
    }
    (mode, comments, inclusive_prefixes) :: xml_canonical_options(options, span)?
    canonical :: XmlKernel.canonical_document(&value, &XmlPull.CanonicalOptions{mode: mode, comments: comments, inclusive_prefixes: ^inclusive_prefixes})
    if canonical == {
        .Ok(value) -> CtValue.Present(CtValue.Str(^value))
        .Err(error) -> CtValue.failed(EncodingLite.xml_error_value(^error))
    }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4272
fn xml_canonical_options(value: &CtValue, span: Span) -> (XmlPull.CanonicalMode, Bool, [String]) Diagnostic! {
    mode :: if field(value, "XMLCanonical", "mode") == {
        .Val(.Enum{variant, ..}) if variant == "Inclusive11" -> XmlPull.CanonicalMode.Inclusive11
        .Val(.Enum{variant, ..}) if variant == "Exclusive10" -> XmlPull.CanonicalMode.Exclusive10
        else -> return .Err(unsupported("XML canonical mode is invalid", span))
    }
    comments :: if field(value, "XMLCanonical", "comments") == {
        .Val(.Bool(value)) -> value
        else -> return .Err(unsupported("XML canonical comments flag is invalid", span))
    }
    values :: if field(value, "XMLCanonical", "inclusive_prefixes") == {
        .Val(.List(values)) -> values
        else -> return .Err(unsupported("XML canonical prefixes are invalid", span))
    }
    inclusive_prefixes := [String].with_capacity(values.len())
    loop value in values {
        if value == { .Str(text) -> inclusive_prefixes.push(text.clone()); else -> return .Err(unsupported("XML canonical prefix must be String", span)) }
    }
    (mode, comments, ^inclusive_prefixes)
}
