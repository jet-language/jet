// Canonical default-error facts and journey operations. Execution-state custody
// belongs to the evaluator; capture never drains a journey or copies an error.
use jet_foundation.[
    DiagnosticErrorContextFrame,
    DiagnosticErrorConversion,
    DiagnosticErrorDetails,
    DiagnosticErrorField,
    DiagnosticErrorSpan,
    MIRPreludeCall,
    MIRPreludeFamily,
    Span,
    TComptimeField,
    TComptimeValue,
    Type,
    mir_symbol_name,
    diagnostic_escape_terminal_text,
    diagnostic_registry_row,
    diagnostic_theme_dim,
]

struct JetEvalErrorJourneyFrame {
    fn_name: String
    file: String
    line: Int
    column: Int
    note: String
    hops: Int
}
struct JetEvalErrorJourney {
    origin: JetEvalErrorJourneyFrame?
    hops: [JetEvalErrorJourneyFrame]
}
struct JetEvalDefaultErrorReport {
    code: String?
    message: String
    typed_identity: String?
    causes: [JetEvalDefaultErrorReport]
    context_frames: [DiagnosticErrorContextFrame]
    origin: JetEvalErrorJourneyFrame?
    source_journey: [JetEvalErrorJourneyFrame]
    conversion_history: [DiagnosticErrorConversion]
    details: DiagnosticErrorDetails?
}
enum JetEvalDefaultErrorCapture {
    Report(report: JetEvalDefaultErrorReport)
    InternalProblem(problem: JetEvalInternalProblem)
}

fn jet_eval_error_journey_new() -> JetEvalErrorJourney Never! {
    JetEvalErrorJourney{origin: None, hops: [],}
}
fn jet_eval_error_journey_reset(journey: &JetEvalErrorJourney) Never! {
    journey.origin = None
    &journey.hops.clear()
}
fn jet_eval_error_journey_origin(journey: &JetEvalErrorJourney, file: String, line: Int, column: Int, fn_name: String) Never! {
    &journey.hops.clear()
    journey.origin = Val(JetEvalErrorJourneyFrame{
        fn_name: fn_name, file: file, line: line, column: column, note: "", hops: 1,
    })
}
fn jet_eval_error_journey_frame(journey: &JetEvalErrorJourney, file: String, line: Int, column: Int, fn_name: String, note: String) Never! {
    if journey.origin == None && journey.hops.len() == 0 {
        journey.origin = Val(JetEvalErrorJourneyFrame{
            fn_name: fn_name, file: file, line: line, column: column, note: note, hops: 1,
        })
        return
    }
    last :: journey.hops.len() - 1
    if last >= 0 {
        if journey.hops[last].file == file && journey.hops[last].line == line && journey.hops[last].fn_name == fn_name {
            journey.hops[last].hops += 1
            return
        }
    }
    &journey.hops.push(JetEvalErrorJourneyFrame{
        fn_name: fn_name, file: file, line: line, column: column, note: note, hops: 1,
    })
}
fn jet_eval_error_report_new(message: ^String) -> JetEvalDefaultErrorReport Never! {
    JetEvalDefaultErrorReport{code: None, message: ^message, typed_identity: None,
        causes: [], context_frames: [], origin: None, source_journey: [],
        conversion_history: [], details: None}
}
fn jet_eval_error_capture_problem(span: Span, message: String) -> JetEvalDefaultErrorCapture Never! {
    JetEvalDefaultErrorCapture.InternalProblem{problem: JetEvalInternalProblem{span: Val(span), message: message}}
}
fn jet_eval_error_metadata_new() -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "__jet_ErrorMetadata", fields: [TComptimeField]{
        {name: "typed_identity", value: jet_eval_error_optional_text(None)},
        {name: "context_frames", value: TComptimeValue.List{values: []}},
        {name: "conversion_history", value: TComptimeValue.List{values: []}},
        {name: "details", value: TComptimeValue.Failed{report: .Clean{ty: Type.Named{name: "__jet_ErrorDetails"}}}},
    }}
}
fn jet_eval_error_from_message(message: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "Err", fields: [TComptimeField]{
        {name: "message", value: TComptimeValue.String{value: message}},
        {name: "code", value: TComptimeValue.Failed{report: .Clean{ty: Type.String}}},
        {name: "cause", value: TComptimeValue.Failed{report: .Clean{ty: Type.Named{name: "Err"}}}},
        {name: "__jet___memo_error_metadata", value: jet_eval_error_metadata_new()},
    }}
}
fn jet_eval_errors_owns_row(row: MIRPreludeCall) -> Bool Never! {
    if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.errors" -> return false
    symbol :: mir_symbol_name(row.symbol)
    if row.member == {
        "from_message" -> symbol == "jet_err_from_message"
        "apply_conversion" -> symbol == "jet_err_apply_conversion"
        "err_with_context_frame" -> symbol == "jet_err_with_context_frame"
        "journey_origin" -> symbol == "jet_journey_origin"
        "journey_frame_text" -> symbol == "jet_journey_frame_text"
        "journey_reset" -> symbol == "jet_journey_reset"
        "entry_error_exit" -> symbol == "jet_entry_error_exit_jet"
        else -> false
    }
}

// Scalar positions and owned report facts only: never return a carrier window.
fn jet_eval_error_data_field(fields: [TComptimeField], name: String) -> Int Never! {
    loop index in 0..<fields.len() {
        if fields[index].name == name -> return index
    }
    -1
}
fn jet_eval_error_data_string(value: TComptimeValue) -> String? Never! {
    if value == .String(text) -> return Val(text)
    None
}
fn jet_eval_error_data_int(value: TComptimeValue) -> Int? Never! {
    if value == .Int(number) -> return Val(number)
    None
}
fn jet_eval_error_data_optional_string(value: TComptimeValue, target: &String?) -> Bool Never! {
    if value == .Present(inner) {
        if inner == .String(text) {
            target = Val(text)
            return true
        }
        return false
    }
    if value == .Failed(report) {
        if report == .Clean(_) {
            target = None
            return true
        }
    }
    false
}
fn jet_eval_error_data_context_frame(value: TComptimeValue, target: &[DiagnosticErrorContextFrame]) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorContextFrame" -> return false
        text :: jet_eval_error_data_field(fields, "text")
        file :: jet_eval_error_data_field(fields, "file")
        line :: jet_eval_error_data_field(fields, "line")
        if text < 0 || file < 0 || line < 0 -> return false
        text_fact :: jet_eval_error_data_string(fields[text].value) ?? return false
        file_fact :: jet_eval_error_data_string(fields[file].value) ?? return false
        line_fact :: jet_eval_error_data_int(fields[line].value) ?? return false
        if line_fact < 0 || line_fact > 4294967295 -> return false
        &target.push(DiagnosticErrorContextFrame{text: ^text_fact, file: ^file_fact, line: line_fact})
        return true
    }
    false
}
fn jet_eval_error_data_context(value: TComptimeValue, target: &[DiagnosticErrorContextFrame]) -> Bool Never! {
    if value == .List(frames) {
        loop index in 0..<frames.len() {
            if !jet_eval_error_data_context_frame(frames[index], &target) -> return false
        }
        return true
    }
    false
}
fn jet_eval_error_data_conversion(value: TComptimeValue, target: &[DiagnosticErrorConversion]) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorConversion" -> return false
        source :: jet_eval_error_data_field(fields, "source")
        destination :: jet_eval_error_data_field(fields, "target")
        if source < 0 || destination < 0 -> return false
        source_fact :: jet_eval_error_data_string(fields[source].value) ?? return false
        target_fact :: jet_eval_error_data_string(fields[destination].value) ?? return false
        &target.push(DiagnosticErrorConversion{source: ^source_fact, target: ^target_fact})
        return true
    }
    false
}
fn jet_eval_error_data_conversions(value: TComptimeValue, target: &[DiagnosticErrorConversion]) -> Bool Never! {
    if value == .List(conversions) {
        loop index in 0..<conversions.len() {
            if !jet_eval_error_data_conversion(conversions[index], &target) -> return false
        }
        return true
    }
    false
}
fn jet_eval_error_data_span_value(value: TComptimeValue, target: &DiagnosticErrorSpan?) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorSpan" -> return false
        start :: jet_eval_error_data_field(fields, "start")
        end :: jet_eval_error_data_field(fields, "end")
        if start < 0 || end < 0 -> return false
        start_fact :: jet_eval_error_data_int(fields[start].value) ?? return false
        end_fact :: jet_eval_error_data_int(fields[end].value) ?? return false
        if start_fact < 0 || end_fact < 0 -> return false
        target = Val(DiagnosticErrorSpan{start: start_fact, end: end_fact})
        return true
    }
    false
}
fn jet_eval_error_data_span(value: TComptimeValue, target: &DiagnosticErrorSpan?) -> Bool Never! {
    if value == .Failed(report) {
        if report == .Clean(_) {
            target = None
            return true
        }
    }
    if value == .Present(inner) -> return jet_eval_error_data_span_value(inner, &target)
    false
}
fn jet_eval_error_data_detail_field(value: TComptimeValue, target: &[DiagnosticErrorField]) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorField" -> return false
        field_name :: jet_eval_error_data_field(fields, "name")
        field_value :: jet_eval_error_data_field(fields, "value")
        if field_name < 0 || field_value < 0 -> return false
        name_fact :: jet_eval_error_data_string(fields[field_name].value) ?? return false
        value_fact :: jet_eval_error_data_string(fields[field_value].value) ?? return false
        &target.push(DiagnosticErrorField{name: ^name_fact, value: ^value_fact})
        return true
    }
    false
}
fn jet_eval_error_data_detail_fields(value: TComptimeValue, target: &[DiagnosticErrorField]) -> Bool Never! {
    if value == .List(items) {
        loop index in 0..<items.len() {
            if !jet_eval_error_data_detail_field(items[index], &target) -> return false
        }
        return true
    }
    false
}
fn jet_eval_error_data_details_value(value: TComptimeValue, target: &DiagnosticErrorDetails?) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorDetails" -> return false
        variant :: jet_eval_error_data_field(fields, "variant")
        items :: jet_eval_error_data_field(fields, "fields")
        source_span :: jet_eval_error_data_field(fields, "source_span")
        if variant < 0 || items < 0 || source_span < 0 -> return false
        variant_fact :: jet_eval_error_data_string(fields[variant].value) ?? return false
        detail := DiagnosticErrorDetails{variant: ^variant_fact, fields: [], source_span: None}
        if !jet_eval_error_data_detail_fields(fields[items].value, &detail.fields) -> return false
        if !jet_eval_error_data_span(fields[source_span].value, &detail.source_span) -> return false
        target = Val(^detail)
        return true
    }
    false
}
fn jet_eval_error_data_details(value: TComptimeValue, target: &DiagnosticErrorDetails?) -> Bool Never! {
    if value == .Failed(report) {
        if report == .Clean(_) {
            target = None
            return true
        }
    }
    if value == .Present(inner) -> return jet_eval_error_data_details_value(inner, &target)
    false
}
fn jet_eval_error_data_metadata(value: TComptimeValue, target: &JetEvalDefaultErrorReport) -> Bool Never! {
    if value == .Struct(name, fields) {
        if name != "__jet_ErrorMetadata" -> return false
        identity :: jet_eval_error_data_field(fields, "typed_identity")
        context :: jet_eval_error_data_field(fields, "context_frames")
        conversions :: jet_eval_error_data_field(fields, "conversion_history")
        details :: jet_eval_error_data_field(fields, "details")
        if identity < 0 || context < 0 || conversions < 0 -> return false
        if !jet_eval_error_data_optional_string(fields[identity].value, &target.typed_identity) -> return false
        if !jet_eval_error_data_context(fields[context].value, &target.context_frames) -> return false
        if !jet_eval_error_data_conversions(fields[conversions].value, &target.conversion_history) -> return false
        if details >= 0 -> return jet_eval_error_data_details(fields[details].value, &target.details)
        target.details = None
        return true
    }
    false
}
fn jet_eval_error_capture_data(value: TComptimeValue, span: Span) -> JetEvalDefaultErrorCapture Never! {
    if value == .Failed(failure) {
        if failure == .Told(inner) -> return jet_eval_error_capture_data(inner, span)
    }
    if value == .Enum(_, _, args) {
        if args.len() != 1 -> return jet_eval_error_capture_problem(span, "checked default error union does not have one carrier member")
        return jet_eval_error_capture_data(args[0].value, span)
    }
    if value == .Struct(name, fields) {
        if name != "Err" -> return jet_eval_error_capture_problem(span, "checked default error has a non-canonical carrier")
        message :: jet_eval_error_data_field(fields, "message")
        code :: jet_eval_error_data_field(fields, "code")
        cause :: jet_eval_error_data_field(fields, "cause")
        if message < 0 || code < 0 || cause < 0 -> return jet_eval_error_capture_problem(span, "checked default error is missing its canonical fields")
        message_fact :: jet_eval_error_data_string(fields[message].value) ?? return jet_eval_error_capture_problem(span, "checked default error message is not text")
        report := jet_eval_error_report_new(^message_fact)
        if !jet_eval_error_data_optional_string(fields[code].value, &report.code) -> return jet_eval_error_capture_problem(span, "checked default error code has an invalid optional carrier")
        if fields[cause].value == {
            .Present(nested) -> {
                captured :: jet_eval_error_capture_data(nested, span)
                if ^captured == {
                    .Report(child) -> &report.causes.push(^child)
                    .InternalProblem(problem) -> return JetEvalDefaultErrorCapture.InternalProblem{problem: ^problem}
                }
            }
            .Failed(failure) -> {
                if failure == .Told(_) -> return jet_eval_error_capture_problem(span, "checked default error cause has an invalid optional carrier")
            }
            else -> return jet_eval_error_capture_problem(span, "checked default error cause has an invalid optional carrier")
        }
        metadata :: jet_eval_error_data_field(fields, "__jet___memo_error_metadata")
        if metadata < 0 -> return jet_eval_error_capture_problem(span, "checked default error metadata is missing")
        if !jet_eval_error_data_metadata(fields[metadata].value, &report) -> return jet_eval_error_capture_problem(span, "checked default error metadata is not canonical")
        return JetEvalDefaultErrorCapture.Report{report: ^report}
    }
    jet_eval_error_capture_problem(span, "checked entry failure requires the canonical default error carrier")
}

// Consuming operations preserve the original checked carrier's entire storage.
// Report projection is deliberately not an error reconstruction codec.
fn jet_eval_error_optional_text(value: String?) -> TComptimeValue Never! {
    if value == .Val(text) -> return TComptimeValue.Present{value: TComptimeValue.String{value: text}}
    TComptimeValue.Failed{report: .Clean{ty: Type.String}}
}

enum JetEvalErrorOperation {
    Value(value: TComptimeValue)
    InternalProblem(problem: JetEvalInternalProblem)
}
fn jet_eval_error_operation_problem(span: Span, message: String) -> JetEvalErrorOperation Never! {
    JetEvalErrorOperation.InternalProblem{problem: JetEvalInternalProblem{span: Val(span), message: message}}
}
fn jet_eval_error_append_metadata(error: TComptimeValue, identity: String?, member: String, item: ^TComptimeValue, span: Span) -> JetEvalErrorOperation Never! {
    metadata_index := -1
    identity_index := -1
    member_index := -1
    identity_absent := false
    // Check the original through READ patterns before any owned carrier copy.
    // Only scalar positions and the absence flag survive those read windows.
    if error == .Struct(name, fields) {
        if name != "Err" -> return jet_eval_error_operation_problem(span, "checked error operation requires the canonical default error carrier")
        metadata_index = jet_eval_error_data_field(fields, "__jet___memo_error_metadata")
        if metadata_index < 0 -> return jet_eval_error_operation_problem(span, "checked default error metadata is missing")
        if fields[metadata_index].value == .Struct(metadata_name, metadata_fields) {
            if metadata_name != "__jet_ErrorMetadata" -> return jet_eval_error_operation_problem(span, "checked default error metadata is not canonical")
            identity_index = jet_eval_error_data_field(metadata_fields, "typed_identity")
            member_index = jet_eval_error_data_field(metadata_fields, member)
            if identity_index < 0 || member_index < 0 -> return jet_eval_error_operation_problem(span, "checked default error metadata is incomplete")
            if metadata_fields[identity_index].value == {
                .Failed(report) -> {
                    if report == .Clean(_) -> identity_absent = true
                    else -> return jet_eval_error_operation_problem(span, "checked default error identity is not an optional text")
                }
                .Present(inner) -> {
                    if inner == {
                        .String(_) -> {}
                        else -> return jet_eval_error_operation_problem(span, "checked default error identity is not an optional text")
                    }
                }
                else -> return jet_eval_error_operation_problem(span, "checked default error identity is not an optional text")
            }
            if metadata_fields[member_index].value == {
                .List(_) -> {}
                else -> return jet_eval_error_operation_problem(span, "checked default error metadata history is not a list")
            }
        } else { return jet_eval_error_operation_problem(span, "checked default error metadata is not canonical") }
    } else { return jet_eval_error_operation_problem(span, "checked error operation requires the canonical default error carrier") }
    // One necessary owned result copy; never reconstruct from a Report.
    result := error
    if &result == .Struct(_, fields) {
        if &fields[metadata_index].value == .Struct(_, metadata_fields) {
            if identity_absent {
                if identity == .Val(source) {
                    metadata_fields[identity_index].value = jet_eval_error_optional_text(Val(source))
                }
            }
            if &metadata_fields[member_index].value == .List(items) {
                &items.push(^item)
            } else { return jet_eval_error_operation_problem(span, "checked default error metadata history is not a list") }
        } else { return jet_eval_error_operation_problem(span, "checked default error metadata is not canonical") }
    } else { return jet_eval_error_operation_problem(span, "checked error operation requires the canonical default error carrier") }
    JetEvalErrorOperation.Value{value: ^result}
}
fn jet_eval_error_apply_conversion(error: TComptimeValue, source: String, target: String, span: Span) -> JetEvalErrorOperation Never! {
    conversion :: TComptimeValue.Struct{type_name: "__jet_ErrorConversion", fields: [TComptimeField]{
        {name: "source", value: TComptimeValue.String{value: source}},
        {name: "target", value: TComptimeValue.String{value: target}},
    }}
    jet_eval_error_append_metadata(error, Val(source), "conversion_history", ^conversion, span)
}
fn jet_eval_error_with_context(error: TComptimeValue, text: String, file: String, line: Int, span: Span) -> JetEvalErrorOperation Never! {
    context :: TComptimeValue.Struct{type_name: "__jet_ErrorContextFrame", fields: [TComptimeField]{
        {name: "text", value: TComptimeValue.String{value: text}},
        {name: "file", value: TComptimeValue.String{value: file}},
        {name: "line", value: TComptimeValue.Int{value: line}},
    }}
    jet_eval_error_append_metadata(error, None, "context_frames", ^context, span)
}

fn jet_eval_error_push(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &out.push(byte)
}
fn jet_eval_error_indent(out: &[U8], depth: Int) Never! {
    loop index in 0..<depth -> jet_eval_error_push(&out, "  ")
}
fn jet_eval_error_site_text(frame: JetEvalErrorJourneyFrame, label: String, path_start: Int, path_elided: Bool, note_count: Int, note_elided: Bool) -> String Never! {
    function :: diagnostic_escape_terminal_text(frame.fn_name)
    path :: diagnostic_escape_terminal_text(frame.file.slice(path_start, frame.file.len()))
    prefix :: if path_elided -> "…/" else -> ""
    column :: if frame.column != 0 -> ":{frame.column}" else -> ""
    repetitions :: if frame.hops > 1 -> " ×{frame.hops}" else -> ""
    note :: diagnostic_escape_terminal_text(frame.note.slice(0, note_count))
    comment :: if note_count > 0 || note_elided -> " — {note}{if note_elided -> "…" else -> ""}" else -> ""
    "  {label} {function} ({prefix}{path}:{frame.line}{column}){repetitions}{comment}"
}
fn jet_eval_error_path_start(file: String, budget: Int) -> Int Never! {
    length :: file.len()
    if length <= budget -> return 0
    position := 0
    last := 0
    loop byte in file.bytes() {
        if byte >= (U8{128}) && byte < (U8{192}) -> next
        position += 1
        if byte != (U8{47}) -> next
        last = position
        if length - position + 2 <= budget -> return position
    }
    // A basename is never truncated, even when it exceeds the terminal width.
    last
}
fn jet_eval_error_site_line(frame: JetEvalErrorJourneyFrame, label: String, width: Int?, path_budget: Int) -> String Never! {
    if width == .Val(columns) {
        start :: jet_eval_error_path_start(frame.file, path_budget)
        elided :: start > 0 && frame.file.len() - start + 2 <= path_budget
        full :: jet_eval_error_site_text(frame, label, start, elided, frame.note.len(), false)
        if full.len() <= columns -> return full
        fixed :: jet_eval_error_site_text(frame, label, start, elided, 0, false)
        room :: columns - fixed.len() - 4
        if room <= 0 -> return fixed
        count :: if room < frame.note.len() -> room else -> frame.note.len()
        return jet_eval_error_site_text(frame, label, start, elided, count, true)
    }
    jet_eval_error_site_text(frame, label, 0, false, frame.note.len(), false)
}
fn jet_eval_error_journey_line(out: &[U8], line: String, color: Bool, depth: Int) Never! {
    jet_eval_error_indent(&out, depth)
    jet_eval_error_push(&out, diagnostic_theme_dim(color, line))
    jet_eval_error_push(&out, "\n")
}
fn jet_eval_error_render_journey(report: JetEvalDefaultErrorReport, out: &[U8], color: Bool, width: Int?, depth: Int) Never! {
    widest := 0
    if width != None && report.origin == .Val(frame) {
        fixed :: jet_eval_error_site_text(frame, "failed here", frame.file.len(), false, frame.note.len(), false).len()
        widest = fixed
    }
    total := 0
    loop index in 0..<report.source_journey.len() {
        frame :: report.source_journey[index]
        total += frame.hops
        if width != None {
            fixed :: jet_eval_error_site_text(frame, "{index + 1}", frame.file.len(), false, frame.note.len(), false).len()
            if fixed > widest -> widest = fixed
        }
    }
    budget :: if width == .Val(columns) -> if columns > widest -> columns - widest else -> 0 else -> 0
    if report.origin == .Val(frame) {
        jet_eval_error_journey_line(&out, jet_eval_error_site_line(frame, "failed here", width, budget), color, depth)
    }
    if report.source_journey.len() > 0 {
        plural :: if total == 1 -> "" else -> "s"
        full :: " Trail [E3002] ({total} hop{plural} via ?, origin first):"
        header :: if width == .Val(columns) -> if full.len() > columns -> " Trail [E3002] ({total} hop{plural}):" else -> full else -> full
        jet_eval_error_journey_line(&out, header, color, depth)
        loop index in 0..<report.source_journey.len() {
            jet_eval_error_journey_line(&out, jet_eval_error_site_line(report.source_journey[index], "{index + 1}", width, budget), color, depth)
        }
    }
}
fn jet_eval_error_render_facts(report: JetEvalDefaultErrorReport, out: &[U8], color: Bool, width: Int?, depth: Int) Never! {
    if depth == 0 {
        if report.code == .Val(code) -> jet_eval_error_push(&out, "error code: {diagnostic_escape_terminal_text(code)}\n")
        if report.typed_identity == .Val(identity) -> jet_eval_error_push(&out, "type: {diagnostic_escape_terminal_text(identity)}\n")
    } else {
        jet_eval_error_indent(&out, depth)
        jet_eval_error_push(&out, "cause: {diagnostic_escape_terminal_text(report.message)}")
        if report.typed_identity == {
            .Val(identity) -> {
                jet_eval_error_push(&out, " (type: {diagnostic_escape_terminal_text(identity)}")
                if report.code == .Val(code) -> jet_eval_error_push(&out, "; error code: {diagnostic_escape_terminal_text(code)}")
                jet_eval_error_push(&out, ")")
            }
            None -> if report.code == .Val(code) -> jet_eval_error_push(&out, " (error code: {diagnostic_escape_terminal_text(code)})")
        }
        jet_eval_error_push(&out, "\n")
    }
    loop index in 0..<report.causes.len() -> jet_eval_error_render_facts(report.causes[index], &out, color, width, depth + 1)
    loop index in 0..<report.context_frames.len() {
        frame :: report.context_frames[index]
        jet_eval_error_indent(&out, depth + 1)
        jet_eval_error_push(&out, "context ({diagnostic_escape_terminal_text(frame.file)}:{frame.line}): {diagnostic_escape_terminal_text(frame.text)}\n")
    }
    loop index in 0..<report.conversion_history.len() {
        conversion :: report.conversion_history[index]
        jet_eval_error_indent(&out, depth + 1)
        jet_eval_error_push(&out, "conversion: {diagnostic_escape_terminal_text(conversion.source)} -> {diagnostic_escape_terminal_text(conversion.target)}\n")
    }
    if report.details == .Val(details) {
        jet_eval_error_indent(&out, depth + 1)
        jet_eval_error_push(&out, "variant: {diagnostic_escape_terminal_text(details.variant)}\n")
        loop index in 0..<details.fields.len() {
            jet_eval_error_indent(&out, depth + 1)
            jet_eval_error_push(&out, "{diagnostic_escape_terminal_text(details.fields[index].name)}: {diagnostic_escape_terminal_text(details.fields[index].value)}\n")
        }
        if details.source_span == .Val(location) {
            jet_eval_error_indent(&out, depth + 1)
            jet_eval_error_push(&out, "source span: {location.start}..{location.end}\n")
        }
    }
    if depth != 0 -> jet_eval_error_render_journey(report, &out, color, width, depth)
}
fn jet_eval_default_entry_error_render(report: JetEvalDefaultErrorReport, color: Bool, width: Int?) -> String Never! {
    row :: diagnostic_registry_row("E3015") ?? panic("registered entry error row is missing")
    message :: diagnostic_escape_terminal_text(report.message)
    out := [U8]{}
    jet_eval_error_push(&out, "Error [{row.code}]: {row.what.replace("{{msg}}", message)}\n")
    jet_eval_error_push(&out, " Why: {row.why.replace("{{msg}}", message)}\n")
    jet_eval_error_push(&out, " Fix: {row.fix.replace("{{msg}}", message)}\n")
    jet_eval_error_render_facts(report, &out, color, width, 0)
    jet_eval_error_render_journey(report, &out, color, width, 0)
    jet_eval_error_push(&out, "More: jet-lang.dev/e/{row.code}\n")
    String.from_bytes(out) ?? panic("canonical error report is UTF-8")
}
