use jet_comptime.Comptime.Methods.CoreCalls.*
use jet_comptime.Comptime.CorePureParity as core_pure_parity
use jet_foundation.AST.[CtValue, CtFloat, Type, HistoryCommandSchema]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_foundation.Syntax
use jet_foundation.Numeric.CtBigInt
use jet_comptime.Comptime.Builtins
use jet_comptime.Comptime.TextLite

// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:2
fn apply_duration_in(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    if args.len() != 2 -> return Err(unsupported("core.handle.duration.in expects a Duration and a DurationUnit", span))
    Builtins.apply_method(&args[0], Syntax.METHOD_DURATION_IN, [args[1].clone()], span)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:20
pub fn apply_core_call(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool) -> CtValue Diagnostic! {
    apply_core_call_with_type(module, method, ^args, span, repl_mode, None)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:33
pub fn apply_core_pure_call(module: String, method: String, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? {
    row := match Syntax.core_call(module, method).filter(fn(row) { row.pure_route != Syntax.CoreCallPureRoute.None && !row.is_receiver() }) { Some(row) => row, None => return None }
    core_pure_parity.evaluate(row, args, span)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:48
pub fn apply_core_call_with_type(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool, resolved_ret: (&Type)?) -> CtValue Diagnostic! {
    apply_core_call_with_type_args(module, method, ^args, span, repl_mode, &[], resolved_ret)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:70
pub fn apply_core_call_with_type_args(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool, type_args: &[Type], resolved_ret: (&Type)?) -> CtValue Diagnostic! {
    args := normalize_path_args(module, method, ^args, span)?
    validate_core_call_projection(module, method, args.len(), Syntax.CoreCallCoverage.COMPTIME, span)?
    validate_interpreter_route(module, method, span)?
    route := Syntax.core_call(module, method).map(fn(row) { row.interpreter_route })
    if route.is_none() || route == Some(Syntax.CoreCallInterpreterRoute.Ambient) {
        if jet_comptime.Comptime.try_ambient_core_call_typed(module, method, args.clone(), span, resolved_ret.cloned()) is Some(result) -> return result
    }
    apply_core_call_without_ambient_with_type_args(module, method, ^args, span, repl_mode, type_args, resolved_ret)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:121
pub fn apply_core_call_without_ambient(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool) -> CtValue Diagnostic! {
    apply_core_call_without_ambient_with_type(module, method, ^args, span, repl_mode, None)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:133
pub fn apply_core_call_without_ambient_with_type(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool, resolved_ret: (&Type)?) -> CtValue Diagnostic! {
    apply_core_call_without_ambient_with_type_args(module, method, ^args, span, repl_mode, &[], resolved_ret)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:155
pub fn apply_core_call_without_ambient_with_type_args(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool, type_args: &[Type], resolved_ret: (&Type)?) -> CtValue Diagnostic! {
    apply_core_call_without_ambient_with_type_args_and_history_schema(module, method, ^args, span, repl_mode, type_args, resolved_ret, None)
}
// Rust: crates/jet-comptime/src/Comptime/Methods/core_calls/plain_calls.rs:178
pub fn apply_core_call_without_ambient_with_type_args_and_history_schema(module: String, method: String, args: [CtValue], span: Span, repl_mode: Bool, type_args: &[Type], resolved_ret: (&Type)?, history_schema: (&HistoryCommandSchema)?) -> CtValue Diagnostic! {
    args := normalize_path_args(module, method, ^args, span)?
    validate_core_call_projection(module, method, args.len(), Syntax.CoreCallCoverage.COMPTIME, span)?
    if Syntax.core_call(module, method).filter(core_call_allows_pure_parity) is Some(row) {
        if core_pure_parity.evaluate(row, &args, span) is Some(result) -> return result
    }
    if repl_mode && repl_native_only_module(module).is_some() -> return Err(repl_native_module_diag(module, method, span))
    if module == "core.testing" && method == "histories" -> return apply_testing_histories(^args, type_args, span, history_schema)
    if apply_raylib_core_call(module, method, &args, span) is Some(result) -> return result
    if module == "core.handle" && ["path.from", "path.join", "path.to_string", "path.parent", "path.extension", "path.stem", "path.normalize", "path.is_within"].contains(method) -> return apply_path_call(method, &args, span)
    one := fn(i: USize) { args.get(i).ok_or_else(fn() { unsupported("{module}.{method}(): missing arg {i}", span) }) }
    args_bool := fn(index: USize, default: Bool) -> Bool Diagnostic! {
        match args.get(index) {
            Some(CtValue.Bool(value)) => Ok(value),
            Some(_) => Err(unsupported("{module}.{method}(): argument {index + 1} must be Bool", span)),
            None => Ok(default)
        }
    }
    csv_options := fn() -> (String,Bool,Bool) Diagnostic! {
        delimiter := args.get(1).map(fn(value) { as_string(value, span).map(fn(s) { s.to_owned() }) }).transpose()?.unwrap_or(",")
        Ok((^delimiter, args_bool(2, false)?, args_bool(3, false)?))
    }
    match (module, method) {
        ("core.log", "set_trace_id") => { log_kernel.set_trace_id(as_string(one(0)?, span)?); Ok(CtValue.Unit) },
        ("core.prelude", "keep") => Ok(args.first().cloned().unwrap_or(CtValue.Unit)),
        ("core.builtin", "len_string") => Ok(CtValue.Int(as_string(one(0)?, span)?.chars().count() as I64)),
        ("core.builtin", "map_keys" | "map_values") => Builtins.apply_method(one(0)?, if method == "map_keys" { "keys" } else { "values" }, [], span),
        ("jet.unit", "magnitude") => Ok(CtValue.Str(as_float(one(0)?, span)?.to_string())),
        ("core.reactive.loadable", "idle" | "loading") => Ok(CtValue.Enum{type_name: "Loadable", variant: loadable_variant(method), args: []}),
        ("core.reactive.loadable", "loaded" | "failed") => Ok(CtValue.Enum{type_name: "Loadable", variant: loadable_variant(method), args: [(None, one(0)?.clone())]}),
        // GATE #4494: evaluator-local fidelity TLS remains a real Cell-backed slot.
        ("core.perf", "fidelity") => Ok(CtValue.Float(CtFloat.f64(F32.from_bits(PERF_FIDELITY.with(Cell.get)) as F64))),
        ("core.perf", "default_fidelity") => Ok(CtValue.Float(CtFloat.f64(F32.from_bits(PERF_DEFAULT_FIDELITY_BITS) as F64))),
        ("core.perf", "override_fidelity") => {
            value := as_float(one(0)?, span)?
            if !value.is_finite() || value < 0.0 || value > 1.0 -> return Ok(CtValue.failed(Box.new(CtValue.Str("core.perf.Perf.override_fidelity needs 0.0 through 1.0, got {value}"))))
            PERF_FIDELITY.with(fn(c) { c.set((value as F32).to_bits()) })
            Ok(CtValue.Present(Box.new(CtValue.Unit)))
        },
        ("core.perf", "reset_fidelity") => { PERF_FIDELITY.with(fn(c) { c.set(PERF_DEFAULT_FIDELITY_BITS) }); Ok(CtValue.Unit) },
        ("core.math", "sqrt") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.sqrt())),
        ("core.math", "floor") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.floor())),
        ("core.math", "ceil") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.ceil())),
        ("core.math", "round") => Ok(CtValue.Int(as_ct_float(one(0)?, span)?.round_i64())),
        ("core.math", "abs") => match one(0)? {
            value if exact_big(value).is_some() => Ok(exact_int_value(exact_big(value).expect("whole-number abs").abs())),
            CtValue.Float(f) => Ok(CtValue.Float(core_math_float_abs(f))),
            value if value is CtValue.Struct{type_name, ..} && type_name == Syntax.TYPE_COMPLEX => jet_comptime.Comptime.ComplexParity.abs(value).map(fn(magnitude) { CtValue.Float(CtFloat.f64(magnitude)) }).ok_or_else(fn() { unsupported("malformed Complex value", span) }),
            _ => Err(unsupported("core.math.abs: non-numeric argument", span))
        },
        ("core.math", "fabs") => Ok(CtValue.Float(core_math_float_abs(as_ct_float(one(0)?, span)?))),
        ("core.math", "pow") => {
            a := as_ct_float(one(0)?, span)?; b := as_ct_float(one(1)?, span)?
            Ok(CtValue.Float(a.powf(b).ok_or_else(fn() { unsupported("mixing float widths", span) })?))
        },
        ("core.math", "min") => {
            left := one(0)?; right := one(1)?
            match (left, right) {
                (CtValue.Int(left), CtValue.Int(right)) => Ok(CtValue.Int(math_lib_pure.jet_std_math_min_i64(left, right))),
                (CtValue.Float(left), CtValue.Float(right)) => Ok(CtValue.Float(core_math_float_min(left, right, span)?)),
                _ => Ok(CtValue.Float(core_math_float_min(as_ct_float(left, span).map_err(fn(_) { unsupported("core.math.min: non-numeric arguments", span) })?, as_ct_float(right, span).map_err(fn(_) { unsupported("core.math.min: non-numeric arguments", span) })?, span)?))
            }
        },
        ("core.math", "max") => {
            left := one(0)?; right := one(1)?
            match (left, right) {
                (CtValue.Int(left), CtValue.Int(right)) => Ok(CtValue.Int(math_lib_pure.jet_std_math_max_i64(left, right))),
                (CtValue.Float(left), CtValue.Float(right)) => Ok(CtValue.Float(core_math_float_max(left, right, span)?)),
                _ => Ok(CtValue.Float(core_math_float_max(as_ct_float(left, span).map_err(fn(_) { unsupported("core.math.max: non-numeric arguments", span) })?, as_ct_float(right, span).map_err(fn(_) { unsupported("core.math.max: non-numeric arguments", span) })?, span)?))
            }
        },
        ("core.math", "clamp") => match (one(0)?, one(1)?, one(2)?) {
            (CtValue.Int(value), CtValue.Int(low), CtValue.Int(high)) => Ok(CtValue.Int(math_lib_pure.jet_std_math_clamp_i64(value, low, high))),
            (CtValue.Float(value), CtValue.Float(low), CtValue.Float(high)) => Ok(CtValue.Float(core_math_float_clamp(value, low, high, span)?)),
            _ => Err(unsupported("core.math.clamp: non-numeric arguments", span))
        },
        ("core.math", "log2") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.log2())),
        ("core.math", "log10") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.log10())),
        ("core.math", "sin") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.sin())),
        ("core.math", "cos") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.cos())),
        ("core.math", "tan") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.tan())),
        ("core.math", "asin") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.asin())),
        ("core.math", "acos") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.acos())),
        ("core.math", "atan") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.atan())),
        ("core.math", "sinh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.sinh())),
        ("core.math", "cosh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.cosh())),
        ("core.math", "tanh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.tanh())),
        ("core.math", "exp") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.exp())),
        ("core.math", "ln") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.ln())),
        ("core.math", "acosh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.acosh())),
        ("core.math", "asinh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.asinh())),
        ("core.math", "atanh") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.atanh())),
        ("core.math", "cbrt") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.cbrt())),
        ("core.math", "exp2") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.exp2())),
        ("core.math", "exp_m1") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.exp_m1())),
        ("core.math", "ln_1p") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.ln_1p())),
        ("core.math", "signum") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.signum())),
        ("core.math", "trunc") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.trunc())),
        ("core.math", "fract") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.fract())),
        ("core.math", "degrees") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.to_degrees())),
        ("core.math", "radians") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?.to_radians())),
        ("core.math", "atan2") => {
            left := as_ct_float(one(0)?, span)?; right := as_ct_float(one(1)?, span)?
            Ok(CtValue.Float(left.atan2(right).ok_or_else(fn() { unsupported("mixing float widths", span) })?))
        },
        ("core.math", "copysign") => {
            left := as_ct_float(one(0)?, span)?; right := as_ct_float(one(1)?, span)?
            Ok(CtValue.Float(left.copysign(right).ok_or_else(fn() { unsupported("mixing float widths", span) })?))
        },
        ("core.math", "log") => {
            left := as_ct_float(one(0)?, span)?; right := as_ct_float(one(1)?, span)?
            Ok(CtValue.Float(left.log(right).ok_or_else(fn() { unsupported("mixing float widths", span) })?))
        },
        ("core.math", "fma") => {
            a := as_ct_float(one(0)?, span)?; b := as_ct_float(one(1)?, span)?; c := as_ct_float(one(2)?, span)?
            Ok(CtValue.Float(a.mul_add(b, c).ok_or_else(fn() { unsupported("mixing float widths", span) })?))
        },
        ("core.math", "factorial") => {
            value := exact_big(one(0)?).ok_or_else(fn() { unsupported("this operation on a value that is not a whole number", span) })?
            if value.negative -> return Ok(CtValue.absent(Type.Int))
            current := CtBigInt.from_int(2); result := CtBigInt.from_int(1)
            while current.compare(&value) != Ordering.Greater { result = result.mul(&current); current = current.add(&CtBigInt.from_int(1)) }
            Ok(CtValue.Present(Box.new(exact_int_value(^result))))
        },
        ("core.math", "isqrt" | "checked_abs" | "checked_neg") => {
            value := exact_big(one(0)?).ok_or_else(fn() { unsupported("this operation on a value that is not a whole number", span) })?
            result := match method { "isqrt" => value.isqrt(), "checked_abs" => Some(value.abs()), _ => Some(value.neg()) }
            Ok(match result { Some(value) => CtValue.Present(Box.new(exact_int_value(^value))), None => CtValue.absent(Type.Int) })
        },
        ("core.math", "is_even" | "is_odd") => {
            value := exact_big(one(0)?).ok_or_else(fn() { unsupported("parity of a value that is not a whole number", span) })?
            Ok(CtValue.Bool(if method == "is_even" { value.is_even() } else { value.is_odd() }))
        },
        ("core.math", "leading_ones" | "trailing_ones" | "digits") => {
            value := exact_big(one(0)?).ok_or_else(fn() { unsupported("this operation needs a whole number", span) })?
            Ok(CtValue.Int(if method == "leading_ones" { value.leading_ones() } else if method == "trailing_ones" { value.trailing_ones() } else { value.digits() }))
        },
        ("core.math", "binomial") => {
            n := exact_big(one(0)?).ok_or_else(fn() { unsupported("binomial needs whole numbers", span) })?
            k := exact_big(one(1)?).ok_or_else(fn() { unsupported("binomial needs whole numbers", span) })?
            Ok(match CtBigInt.binomial(&n, &k) { Some(value) => CtValue.Present(Box.new(exact_int_value(^value))), None => CtValue.absent(Type.Int) })
        },
        ("core.math", "checked_add" | "checked_sub" | "checked_mul") => {
            left := exact_big(one(0)?).ok_or_else(fn() { unsupported("checked arithmetic needs whole numbers", span) })?
            right := exact_big(one(1)?).ok_or_else(fn() { unsupported("checked arithmetic needs whole numbers", span) })?
            value := match method { "checked_add" => left.add(&right), "checked_sub" => left.sub(&right), _ => left.mul(&right) }
            Ok(CtValue.Present(Box.new(exact_int_value(^value))))
        },
        ("core.math", "checked_div" | "checked_rem") => {
            left := exact_big(one(0)?).ok_or_else(fn() { unsupported("checked division needs whole numbers", span) })?
            right := exact_big(one(1)?).ok_or_else(fn() { unsupported("checked division needs whole numbers", span) })?
            Ok(match left.div_rem(&right) { Some((quotient, remainder)) => CtValue.Present(Box.new(exact_int_value(if method == "checked_div" { ^quotient } else { ^remainder }))), None => CtValue.absent(Type.Int) })
        },
        ("core.math", "checked_pow") => {
            base := exact_big(one(0)?).ok_or_else(fn() { unsupported("checked power needs whole numbers", span) })?
            exponent := exact_big(one(1)?).ok_or_else(fn() { unsupported("checked power needs whole numbers", span) })?
            Ok(match base.pow(&exponent) { Some(value) => CtValue.Present(Box.new(exact_int_value(^value))), None => CtValue.absent(Type.Int) })
        },
        ("core.math", "saturating_add" | "saturating_sub" | "saturating_mul") => {
            left := exact_big(one(0)?).ok_or_else(fn() { unsupported("arithmetic needs whole numbers", span) })?
            right := exact_big(one(1)?).ok_or_else(fn() { unsupported("arithmetic needs whole numbers", span) })?
            value := match method { "saturating_add" => left.add(&right), "saturating_sub" => left.sub(&right), "saturating_mul" => left.mul(&right), _ => unreachable("whole-number arithmetic guard") }
            Ok(exact_int_value(^value))
        },
        ("core.math", "int_pow") => {
            base := exact_big(one(0)?).ok_or_else(fn() { unsupported("integer power needs whole numbers", span) })?
            exponent := exact_big(one(1)?).ok_or_else(fn() { unsupported("integer power needs whole numbers", span) })?
            Ok(exact_int_value(base.pow(&exponent).unwrap_or_else(fn() { CtBigInt.from_int(0) })))
        },
        ("core.math", "gcd" | "lcm") => {
            left := exact_big(one(0)?).ok_or_else(fn() { unsupported("number theory needs whole numbers", span) })?
            right := exact_big(one(1)?).ok_or_else(fn() { unsupported("number theory needs whole numbers", span) })?
            Ok(exact_int_value(if method == "gcd" { CtBigInt.gcd(&left, &right) } else { CtBigInt.lcm(&left, &right) }))
        },
        ("core.math", "div_mod" | "div_rem") => {
            left := exact_big(one(0)?).ok_or_else(fn() { unsupported("division needs whole numbers", span) })?
            right := exact_big(one(1)?).ok_or_else(fn() { unsupported("division needs whole numbers", span) })?
            (quotient, remainder) := match left.div_rem(&right) { Some(pair) => pair, None => return Err(unsupported("division by zero", span)) }
            if method == "div_mod" && !remainder.is_zero() && left.negative != right.negative { quotient = quotient.sub(&CtBigInt.from_int(1)); remainder = remainder.add(&right) }
            Ok(named_tuple(&[("quot", exact_int_value(^quotient)), ("rem", exact_int_value(^remainder))]))
        },
        ("core.math", "is_normal") => Ok(CtValue.Bool(as_ct_float(one(0)?, span)?.as_f64().is_normal())),
        ("core.math", "is_subnormal") => Ok(CtValue.Bool(as_ct_float(one(0)?, span)?.as_f64().is_subnormal())),
        ("core.math", "is_canonical") => { x := as_ct_float(one(0)?, span)?; Ok(CtValue.Bool(x.is_finite() || x.is_nan())) },
        ("core.math", "is_signed" | "sign_bit") => Ok(CtValue.Bool(as_ct_float(one(0)?, span)?.as_f64().is_sign_negative())),
        ("core.math", "is_zero") => Ok(CtValue.Bool(as_ct_float(one(0)?, span)?.as_f64() == 0.0)),
        ("core.math", "is_integer") => { x := as_ct_float(one(0)?, span)?; Ok(CtValue.Bool(x.is_finite() && x.as_f64().fract() == 0.0)) },
        ("core.math", "next_up") => Ok(CtValue.Float(CtFloat.f64(as_ct_float(one(0)?, span)?.as_f64().next_up()))),
        ("core.math", "next_down") => Ok(CtValue.Float(CtFloat.f64(as_ct_float(one(0)?, span)?.as_f64().next_down()))),
        ("core.math", "copy") => Ok(CtValue.Float(as_ct_float(one(0)?, span)?)),
        ("core.math", "cot") => { x := as_ct_float(one(0)?, span)?.as_f64(); Ok(CtValue.Float(CtFloat.f64(1.0 / x.tan()))) },
        ("core.math", "inv") => { x := as_ct_float(one(0)?, span)?.as_f64(); Ok(CtValue.Float(CtFloat.f64(1.0 / x))) },
        ("core.math", "zero") => Ok(CtValue.Float(CtFloat.f64(0.0))),
        ("core.math", "radix") => Ok(CtValue.Int(2)),
        ("core.math", "cmp") => { a := as_ct_float(one(0)?, span)?.as_f64(); b := as_ct_float(one(1)?, span)?.as_f64(); Ok(CtValue.Int(math_lib_pure.jet_std_math_cmp(a, b))) },
        ("core.math", "next_after") => { a := as_ct_float(one(0)?, span)?.as_f64(); b := as_ct_float(one(1)?, span)?.as_f64(); Ok(CtValue.Float(CtFloat.f64(math_lib_pure.jet_std_math_next_after(a, b)))) },
        ("core.math", "ldexp" | "scaleb") => {
            x := as_ct_float(one(0)?, span)?.as_f64()
            exp := match one(1)? { CtValue.Int(v) => v, _ => return Err(unsupported("ldexp needs a whole-number exponent", span)) }
            Ok(CtValue.Float(CtFloat.f64(math_lib_pure.jet_std_math_ldexp(x, exp))))
        },
        ("core.math", "ilogb") => { x := as_ct_float(one(0)?, span)?.as_f64(); Ok(match math_lib_pure.jet_std_math_ilogb(x) { Some(e) => CtValue.Present(Box.new(CtValue.Int(e))), None => CtValue.absent(Type.Int) }) },
