        ("core.data", "rolling_mean") => {
            values := as_float_list(one(0)?, span)?; width := as_int(one(1)?, span)?
            Ok(data_result_value(data_kernel.jet_data_rolling_mean_checked(&values, width), fn() { data_kernel.jet_data_rolling_mean(&values, width) }, fn(means) { CtValue.List(means.into_iter().map(data_float_value).collect()) }))
        },
        ("core.data", "describe") => {
            values := as_float_list(one(0)?, span)?
            Ok(data_result_value_for_type(data_kernel.jet_data_describe_checked(&values), fn() { data_kernel.jet_data_describe(&values) }, data_summary_value, resolved_ret))
        },
        ("core.data", "status") => Ok(CtValue.List(data_kernel.jet_data_status().into_iter().map(fn(row) {
            CtValue.Struct{type_name: "DataStatus", fields: [
                ("step", CtValue.Str(row.step)), ("path", CtValue.Str(row.path)), ("clone_value", CtValue.Str(row.clone_value)),
                ("ownership", CtValue.Str(row.ownership)), ("trust", CtValue.Str(row.trust)), ("fallback", CtValue.Str(row.fallback)), ("replacement", CtValue.Str(row.replacement))
            ]}
        }).collect())),
        ("core.data", "require_bridge") => {
            provider := as_string(one(0)?, span)?.to_string()
            Ok(match data_kernel.jet_data_require_bridge(&provider) { Ok(()) => CtValue.Present(Box.new(CtValue.Unit)), Err(error) => CtValue.failed(Box.new(data_error_value(&error))) })
        },
        ("core.data", "bar_text") => {
            groups := as_data_bar_groups(one(0)?, span)?
            Ok(data_result_value_for_type(data_kernel.jet_data_bar_text_checked(&groups), fn() { data_kernel.jet_data_bar_text(&groups) }, CtValue.Str, resolved_ret))
        },
        ("core.data", "bar_svg") => {
            groups := as_data_bar_groups(one(0)?, span)?
            Ok(data_result_value_for_type(data_kernel.jet_data_bar_svg_checked(&groups), fn() { data_kernel.jet_data_bar_svg(&groups) }, CtValue.Str, resolved_ret))
        },
        ("core.data", "line_text" | "line_svg") => apply_data_line_call(method, ^args, resolved_ret, span),
        ("core.files", _) | ("core.sys", _) | ("core.term", _) | ("core.net", _) | ("core.net.tls", _) => Err(Diagnostic.error(
            "E3410",
            "`{module}.{method}()` is a Tier-2 comptime effect — it requires a `#Impure` gate",
            "ambient I/O (filesystem, environment, process) is not allowed in pure comptime evaluation",
            "wrap the comptime binding in `#Impure(\"reason\") \{ … \}` and pass `--gate impure=allow` to the build",
            Some(span)
        )),
        _ => {
            if repl_mode && repl_native_only_module(module).is_some() -> return Err(repl_native_module_diag(module, method, span))
            Err(unsupported("`{module}.{method}()`", span))
        }
    }
}

