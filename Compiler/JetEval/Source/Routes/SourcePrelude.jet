// Canonical source-backed Prelude routes for the Jet evaluator.
//
// This file only resolves an already-registered MIR route to the matching
// Core source function. It does not reimplement formatting, numeric, or unit
// policy and it never reconstructs a route from a free-form symbol.
use jet_foundation.[
    Effect,
    MIRCallFallibility,
    MIRCallSignature,
    MIRFunctionID,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRProgram,
    MIRSymbol,
    mir_symbol_name,
    stable_id,
]

pub struct JetEvalSourceTarget {
    pub function: MIRFunctionID
    pub route: MIRPreludeCallID
    pub signature: MIRCallSignature
    pub fallibility: MIRCallFallibility
    pub abi: MIRPreludeABI
    pub module_name: String
    pub member: String
}

pub enum JetEvalSourceLookup {
    Unavailable
    Invalid(reason: String)
    Target(value: JetEvalSourceTarget)
}

// Resolve a Core/text/fmt source function by member for an interpolation
// selector. Checked MIR keeps selectors on the BuildString part, so no
// Prelude row is interned for them; the function's own arity and interpreter
// applicability are the ABI facts that remain to check.
pub fn jet_eval_source_member_function(program: MIRProgram, member: String, arity: Int) -> MIRFunctionID? {
    function :: jet_eval_source_find_function(program, member) ?? return None
    if function.arity != arity || !function.interpreter -> return None
    Val(function.id)
}

// Resolve a registered Prelude row to a loaded Core source function. A route
// in the known Core formatting family which has no source equivalent is
// Invalid rather than silently falling through to a second evaluator policy;
// `display`/`debug` are evaluator-owned structural renderers (MIREval
// `display_core_pure_value` / `mir_show` / CorePureParity `debug`), so their
// rows fall through to the Prelude dispatcher.
pub fn jet_eval_source_lookup(program: MIRProgram, row: MIRPreludeCall) -> JetEvalSourceLookup Never! {
    source_member :: jet_eval_source_member(row) ?? {
        if row.module_name == "core.text.fmt" && row.member != "display" && row.member != "debug" -> return JetEvalSourceLookup.Invalid{reason: "Core formatting route has no source-backed evaluator target"}
        return JetEvalSourceLookup.Unavailable
    }
    function :: jet_eval_source_find_function(program, source_member) ?? return JetEvalSourceLookup.Unavailable
    if {
        !jet_eval_source_route_shape_valid(row) -> JetEvalSourceLookup.Invalid{reason: "MIR Prelude route has an invalid source evaluator ABI"}
        function.arity != row.signature.arity || row.signature.max_arity != row.signature.arity -> JetEvalSourceLookup.Invalid{reason: "Core source target arity does not match the registered Prelude ABI"}
        !function.interpreter -> JetEvalSourceLookup.Invalid{reason: "Core source target is disabled for the interpreter"}
        else -> JetEvalSourceLookup.Target{value: JetEvalSourceTarget{
            function: function.id,
            route: row.id,
            signature: row.signature,
            fallibility: row.fallibility,
            abi: row.abi,
            module_name: function.module_name,
            member: source_member,
        }}
    }
}

struct JetEvalSourceFunction {
    id: MIRFunctionID
    module_name: String
    arity: Int
    interpreter: Bool
}

fn jet_eval_source_find_function(program: MIRProgram, member: String) -> JetEvalSourceFunction? {
    fmt_modules := [Int]{}
    loop index in 0..<program.modules.len() {
        if program.modules[index].name == "core_text_fmt" && program.modules[index].path == "Core/text/fmt.jet" -> &fmt_modules.push(index)
    }
    loop index in 0..<program.functions.len() {
        loop position in 0..<fmt_modules.len() {
            fmt_module :: fmt_modules[position]
            if program.modules[fmt_module].id == program.functions[index].module_id && program.functions[index].name == member && program.functions[index].module_name == program.modules[fmt_module].key {
                return Val(JetEvalSourceFunction{
                    id: program.functions[index].id,
                    module_name: program.functions[index].module_name,
                    arity: program.functions[index].params.len(),
                    interpreter: program.functions[index].target_applicability.interpreter,
                })
            }
        }
    }
    None
}

fn jet_eval_source_route_shape_valid(row: MIRPreludeCall) -> Bool Never! {
    if row.signature.arity < 0 || row.signature.max_arity != row.signature.arity -> false else -> row.signature.borrow_mask.len() == row.signature.arity
}

// This table mirrors only the checked Core route rows. The native symbol is
// part of the match so interpolation adapters (for example decimal_int) can
// never be mistaken for the Float source implementation.
fn jet_eval_source_mask_1(mask: [Bool], first: Bool) -> Bool Never! {
    mask.len() == 1 && mask[0] == first
}

fn jet_eval_source_mask_2(mask: [Bool], first: Bool, second: Bool) -> Bool Never! {
    mask.len() == 2 && mask[0] == first && mask[1] == second
}

fn jet_eval_source_mask_3(mask: [Bool], first: Bool, second: Bool, third: Bool) -> Bool Never! {
    mask.len() == 3 && mask[0] == first && mask[1] == second && mask[2] == third
}

fn jet_eval_source_member(row: MIRPreludeCall) -> String? {
    if row.module_name != "core.text.fmt" -> return None
    symbol :: mir_symbol_name(row.symbol)
    if {
        row.member == "number" && symbol == "jet_fmt_number" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("number")
        row.member == "pretty" && symbol == "jet_fmt_pretty" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, true) -> Val("pretty")
        (row.member == "decimal" || row.member == "fixed") && symbol == "jet_fmt_decimal" && row.signature.arity == 2 && jet_eval_source_mask_2(row.signature.borrow_mask, false, false) -> Val("decimal")
        row.member == "grouped" && symbol == "jet_fmt_grouped" && row.signature.arity == 2 && jet_eval_source_mask_2(row.signature.borrow_mask, false, false) -> Val("grouped")
        row.member == "hex" && symbol == "jet_fmt_hex" && row.signature.arity == 2 && jet_eval_source_mask_2(row.signature.borrow_mask, false, false) -> Val("hex")
        row.member == "sci" && symbol == "jet_fmt_sci" && row.signature.arity == 2 && jet_eval_source_mask_2(row.signature.borrow_mask, false, false) -> Val("sci")
        row.member == "percent" && symbol == "jet_fmt_percent" && row.signature.arity == 2 && jet_eval_source_mask_2(row.signature.borrow_mask, false, false) -> Val("percent")
        row.member == "bin" && symbol == "jet_fmt_bin" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("bin")
        row.member == "oct" && symbol == "jet_fmt_oct" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("oct")
        row.member == "bytes" && symbol == "jet_fmt_bytes" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("bytes")
        row.member == "duration" && symbol == "jet_fmt_duration" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("duration")
        row.member == "ordinal" && symbol == "jet_fmt_ordinal" && row.signature.arity == 1 && jet_eval_source_mask_1(row.signature.borrow_mask, false) -> Val("ordinal")
        row.member == "plural" && symbol == "jet_fmt_plural" && row.signature.arity == 3 && jet_eval_source_mask_3(row.signature.borrow_mask, false, true, true) -> Val("plural")
        row.member == "pad" && symbol == "jet_fmt_pad" && row.signature.arity == 3 && jet_eval_source_mask_3(row.signature.borrow_mask, true, false, true) -> Val("pad")
        row.member == "pad_left" && symbol == "jet_fmt_pad_left" && row.signature.arity == 3 && jet_eval_source_mask_3(row.signature.borrow_mask, true, false, true) -> Val("pad_left")
        row.member == "pad_right" && symbol == "jet_fmt_pad_right" && row.signature.arity == 3 && jet_eval_source_mask_3(row.signature.borrow_mask, true, false, true) -> Val("pad_right")
        row.member == "pad_center" && symbol == "jet_fmt_pad_center" && row.signature.arity == 3 && jet_eval_source_mask_3(row.signature.borrow_mask, true, false, true) -> Val("pad_center")
        else -> None
    }
}

// Return the canonical descriptor used when checked MIR keeps an exact integer
// operation primitive instead of carrying an explicit Prelude call ID. The
// symbol, family, ABI, and stable identity are the same registry facts used by
// jet_codegen_add_binary_prelude; the caller supplies the operation's checked
// arity rather than inventing a route.
pub fn jet_eval_exact_integer_row(member: String, arity: Int) -> MIRPreludeCall? {
    supported :: if member == {
        "add" | "sub" | "mul" | "div" | "rem" | "floor_div" | "mod" | "pow" | "shl" | "shr" | "bit_and" | "bit_or" | "bit_xor" | "div_euclid" | "rem_euclid" -> true
        else -> false
    }
    if !supported -> return None
    if arity != 2 && arity != 4 -> return None
    symbol :: "jet_std::jet_int_{member}"
    mask :: loop index in 0..<arity -> false
    mask_names :: loop item in mask -> if item -> "true" else -> "false"
    route_effect :: if arity == 4 -> Val(Effect.Panic) else -> None
    effect_identity :: if arity == 4 -> "Some(Panic)" else -> "None"
    identity :: "Overflow:core.numeric:{member}:{symbol}:{arity}:{arity}:[{mask_names.join(", ")}]:{effect_identity}:Infallible:Value"
    Val(MIRPreludeCall{
        id: MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)},
        family: MIRPreludeFamily.Overflow,
        module_name: "core.numeric",
        member: member,
        symbol: MIRSymbol.Prelude{name: symbol},
        signature: MIRCallSignature{arity: arity, max_arity: arity, borrow_mask: mask},
        effect_kind: route_effect,
        fallibility: MIRCallFallibility.Infallible,
        abi: MIRPreludeABI.Value,
        authority: None,
        db_metadata: None,
    })
}

// Comparison primitives use the checked core.compare BuiltinMethod row even
// when MIR keeps the operation structural. This descriptor mirrors the
// registered route exactly; it does not define a second comparison policy.
pub fn jet_eval_exact_compare_row(member: String) -> MIRPreludeCall? {
    supported :: if member == {
        "eq" | "ne" | "lt" | "gt" | "le" | "ge" | "compare" -> true
        else -> false
    }
    if !supported -> return None
    identity :: "BuiltinMethod:core.compare:{member}:jet_int_compare:2:2:[true, true]:None:Infallible:Value"
    Val(MIRPreludeCall{
        id: MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)},
        family: MIRPreludeFamily.BuiltinMethod,
        module_name: "core.compare",
        member: member,
        symbol: MIRSymbol.Prelude{name: "jet_int_compare"},
        signature: MIRCallSignature{arity: 2, max_arity: 2, borrow_mask: [Bool]{true, true}},
        effect_kind: None,
        fallibility: MIRCallFallibility.Infallible,
        abi: MIRPreludeABI.Value,
        authority: None,
        db_metadata: None,
    })
}
