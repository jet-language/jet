// Rust: crates/jet-comptime/src/Comptime/TextLite.rs:594
fn io_error_ct(error: IOError) -> CtValue {
    operation_value := fn(operation: IOOperation) -> CtValue {
        variant := match operation { .Read => "Read"; .Write => "Write"; .Flush => "Flush"; .Connect => "Connect"; .Accept => "Accept"; .Close => "Close"; .Resolve => "Resolve"; .Codec => "Codec" }
        CtValue.Enum { type_name: "IOOperation", variant: variant.to_string(), args: [] }
    }
    context_value := fn(context: IOContext) -> CtValue {
        optional_string := fn(value: String?) { value.map(fn(value) { CtValue.Present(CtValue.Str(^value)) }).unwrap_or_else(fn() { CtValue.absent(Type.String) }) }
        optional_int := fn(value: I64?) { value.map(fn(value) { CtValue.Present(CtValue.Int(value)) }).unwrap_or_else(fn() { CtValue.absent(Type.Int) }) }
        CtValue.Struct { type_name: "IOContext", fields: [("operation", operation_value(context.operation)), ("resource", optional_string(^context.resource)), ("os_code", optional_int(context.os_code)), ("cause", optional_string(^context.cause))] }
    }
    (variant, context) := match error { .InvalidInput(context) => ("InvalidInput", ^context); .NotFound(context) => ("NotFound", ^context); .PermissionDenied(context) => ("PermissionDenied", ^context); .TimedOut(context) => ("TimedOut", ^context); .Cancelled(context) => ("Cancelled", ^context); .Closed(context) => ("Closed", ^context); .Protocol(context) => ("Protocol", ^context); .Other(context) => ("Other", ^context) }
    CtValue.Enum { type_name: "IOError", variant: variant.to_string(), args: [(None, context_value(^context))] }
}
