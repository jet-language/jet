impl IOError {
    // Rust: crates/jet-comptime/src/Comptime/TextLite.rs:54
    fn other(operation: IOOperation, resource: String?, cause: String) -> IOError { IOError.Other(IOContext.new(operation, ^resource, None, Val(^cause))) }
}
// Rust: crates/jet-comptime/src/Comptime/TextLite.rs:68
fn io_error_at(operation: IOOperation, path: &String, error: std.io.Error) -> IOError {
    // GATE #4494: native errno projection; #4409: invalid-data UTF8 errors.
    context := IOContext.new(operation, Val(path.to_string()), error.raw_os_error().map(fn(code) { code as I64 }), Val(error.to_string()))
    match error.kind() {
        .InvalidInput | .InvalidData => IOError.InvalidInput(^context)
        .NotFound => IOError.NotFound(^context)
        .PermissionDenied => IOError.PermissionDenied(^context)
        .TimedOut => IOError.TimedOut(^context)
        .NotConnected | .BrokenPipe => IOError.Closed(^context)
        _ => IOError.Other(^context)
    }
}
