// Rust: crates/jet-comptime/src/Comptime/TextLite.rs:524
enum MirFileOwnerKind { TempDir(text_kernel.JetTempDirOwner), TempFile(text_kernel.JetTempFileOwner), FileLock(text_kernel.JetFileLockOwner) }
// Rust: crates/jet-comptime/src/Comptime/TextLite.rs:533
pub struct MirFileOwner { inner: MirFileOwnerKind }
impl MirFileOwner {
    // Rust: crates/jet-comptime/src/Comptime/TextLite.rs:538
    pub fn path(self: &MirFileOwner) -> &String { match self.inner { .TempDir(owner) => &owner.path; .TempFile(owner) => &owner.path; .FileLock(owner) => &owner.path } }
}
