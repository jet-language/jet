    // Rust: crates/jet-comptime/src/Comptime/TextLite.rs:478
    fn fs_walk_parallel_with_ignore(path: &String, ignore_name: &String?) -> Result<[WalkEntry], IOError> {
        entries := fs_walk_kernel.jet_fs_walk_parallel_with_ignore(path, path, ignore_name,
            fn(path, relative, is_dir, depth) { WalkEntry { path: ^path, relative: ^relative, is_dir: is_dir, depth: depth } },
            fn(shown, error) { io_error_at(IOOperation.Read, shown, ^error) })?
        entries.sort_by(fn(left, right) { left.path.cmp(&right.path) })
        Ok(^entries)
    }
