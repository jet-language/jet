pub fn apply_file_handle(receiver: &CtValue, method: &String, args: &[CtValue], span: Span) -> Result<CtValue, Diagnostic>? {
    if handle := file_reader_handle(receiver) {
        return Val(match method {
            "file_reader.path" if args.is_empty() => {
                path := handle.inner.lock().ok().and_then(fn(reader) { reader.as_ref().map(fn(reader) { reader.path.clone() }) })
                match path { Val(path) => Ok(CtValue.Str(^path)); None => Err(unsupported("FileReader.path requires a live handle", span)) }
            }
            "file_reader.path" => Err(unsupported("FileReader.path takes no arguments", span))
            "file_reader.read_line" | "read_line" if args.is_empty() => Ok(reader_line_value(handle))
            "file_reader.read_line" | "read_line" => Err(unsupported("FileReader.read_line expects no arguments", span))
            _ => Err(unsupported("FileReader.{method}", span))
        })
    }
    if handle := file_writer_handle(receiver) {
        return Val(match method {
            "file_writer.path" if args.is_empty() => {
                path := handle.inner.lock().ok().and_then(fn(writer) { writer.as_ref().map(fn(writer) { writer.path.clone() }) })
                match path { Val(path) => Ok(CtValue.Str(^path)); None => Err(unsupported("FileWriter.path requires a live handle", span)) }
            }
            "file_writer.path" => Err(unsupported("FileWriter.path takes no arguments", span))
            "file_writer.write_line" | "write_line" => {
                if args.len() != 1 { return Val(Err(unsupported("FileWriter.write_line expects one String argument", span))) }
                line := match args[0] { .Str(line) => line; _ => return Val(Err(unsupported("FileWriter.write_line expects one String argument", span))) }
                Ok(writer_result(writer_line(handle, line)))
            }
            "file_writer.flush" | "flush" if args.is_empty() => Ok(writer_result(writer_flush(handle)))
            "file_writer.flush" | "flush" => Err(unsupported("FileWriter.flush expects no arguments", span))
            _ => Err(unsupported("FileWriter.{method}", span))
        })
    }
