    // Rust: crates/jet-comptime/src/Comptime/TextLite.rs:361
    fn string_route(s: &String, member: &String, args: &[CtValue]) -> CtValue? {
        str_arg := fn(index: USize) -> &String? { match args.get(index) { Val(.Str(value)) => Val(value); _ => None } }
        int_arg := fn(index: USize) -> I64? { match args.get(index) { Val(.Int(value)) => Val(value); _ => None } }
        triple := fn((head, sep, tail): (String, String, String)) { CtValue.Struct { type_name: "(head,sep,tail)", fields: [("head", CtValue.Str(^head)), ("sep", CtValue.Str(^sep)), ("tail", CtValue.Str(^tail))] } }
        width := fn(index: USize) { int_arg(index).map(JetInt.from_i64) }
        Val(match (member, args.len()) {
            ("casefold", 0) => CtValue.Str(text_kernel.jet_text_casefold(s))
            ("strip", 0) => CtValue.Str(text_kernel.jet_text_parse_strip(s))
            ("lstrip", 0) => CtValue.Str(text_kernel.jet_text_parse_lstrip(s))
            ("rstrip", 0) => CtValue.Str(text_kernel.jet_text_parse_rstrip(s))
            ("isalnum", 0) => CtValue.Bool(text_kernel.jet_text_isalnum(s))
            ("isalpha", 0) => CtValue.Bool(text_kernel.jet_text_is_alphabetic(s))
            ("isascii", 0) => CtValue.Bool(text_kernel.jet_text_unicode_is_ascii(s))
            ("isdecimal", 0) => CtValue.Bool(text_kernel.jet_text_isdecimal(s))
            ("isdigit", 0) => CtValue.Bool(text_kernel.jet_text_isdigit(s))
            ("isidentifier", 0) => CtValue.Bool(text_kernel.jet_text_isidentifier(s))
            ("isnumeric", 0) => CtValue.Bool(text_kernel.jet_text_isnumeric(s))
            ("isprintable", 0) => CtValue.Bool(text_kernel.jet_text_isprintable(s))
            ("isspace", 0) => CtValue.Bool(text_kernel.jet_text_is_whitespace(s))
            ("istitle", 0) => CtValue.Bool(text_kernel.jet_text_istitle(s))
            ("islower", 0) => CtValue.Bool(text_kernel.jet_text_is_lower(s))
            ("isupper", 0) => CtValue.Bool(text_kernel.jet_text_is_upper(s))
            ("find", 1) => CtValue.Int(text_kernel.jet_text_parse_find(s, str_arg(0)?))
            ("rfind", 1) => CtValue.Int(text_kernel.jet_text_parse_rfind(s, str_arg(0)?))
            ("partition", 1) => triple(text_kernel.jet_text_parse_partition(s, str_arg(0)?))
            ("rpartition", 1) => triple(text_kernel.jet_text_parse_rpartition(s, str_arg(0)?))
            ("zfill", 1) => CtValue.Str(text_kernel.jet_text_zfill(s, int_arg(0)?))
            ("expandtabs", 1) => CtValue.Str(text_kernel.jet_text_expandtabs(s, width(0)?))
            ("center", 2) => CtValue.Str(text_kernel.jet_text_center(s, width(0)?, str_arg(1)?))
            ("ljust", 2) => CtValue.Str(text_kernel.jet_text_pad_end(s, width(0)?, str_arg(1)?))
            ("rjust", 2) => CtValue.Str(text_kernel.jet_text_pad_start(s, width(0)?, str_arg(1)?))
            _ => return None
        })
    }
