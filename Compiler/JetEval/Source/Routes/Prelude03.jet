    fn fs_scope_read(rights: &Set<String>, path: &String) -> Result<String, IOError> {
        ordered_rights := rights.iter().cloned().collect(); ordered_rights.sort()
        authority := JetAuthority.from_rights(^ordered_rights)
        scope := text_kernel.jet_std_fs_scope(&authority)
        text_kernel.jet_std_fs_scope_read(&scope, path)
    }
