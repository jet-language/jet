use jet_comptime.Builtins.[apply_authority_method, exact_big, exact_int_value, carrier_fact, is_datatree, datatree_payload, datatree_failure, datatree_render, program_info_list, cmp, cmp_ref, cmp_for_sort_ref, extreme_ref, list_values_equal, map_values_equal, as_int, as_string]
use jet_comptime.[TextLite, MathLayout, Methods, CollectionEval, SyncLite, regex_kernel]
use jet_comptime.Numeric.[CtBigInt]
use jet_foundation.[range_semantics, loadable_semantics, duration_semantics]

// The canonical AST map carrier is an ordered entry vector. Index once for
// Rust BTreeMap operations, and sort keys once when publishing the carrier.
// GATE #4499: CtKey equality/hash/order must retain composite-key semantics.
fn prelude_method_map(entries: &[CtMapEntry]) -> [CtKey:CtValue] Never! {
    out := [CtKey:CtValue]{}
    loop entry in entries { out[entry.key] = entry.value }
    out
}
fn prelude_method_map_value(entries: [CtKey:CtValue]) -> CtValue Never! {
    keys := entries.keys().to_list()
    keys.sort()
    out := [CtMapEntry]{}
    loop key in keys { out.push(CtMapEntry{key: key, value: entries[key]}) }
    CtValue.Map{entries: ^out}
}
fn prelude_method_field(fields: &[NamedCtValue], name: String) -> CtValue? {
    loop field in fields { if field.name == name -> return Val(field.value) }
    None
}
fn prelude_method_list_field(fields: &[NamedCtValue], name: String) -> [CtValue]? {
    value :: prelude_method_field(fields, name) ?? return None
    if value == { .List(items) -> Val(items) else -> None }
}
fn prelude_method_arg(args: &[CtValue], index: Int, fallback: CtValue) -> CtValue Never! {
    if index < args.len() -> args[index] else -> fallback
}
fn prelude_method_present(value: CtValue) -> CtValue Never! { CtValue.Present{value: ^value} }
fn prelude_method_absent(ty: Type) -> CtValue Never! { CtValue.Failed{report: CtReport.Clean{ty: ty}} }
fn prelude_method_pair(name: String, a_name: String, a: CtValue, b_name: String, b: CtValue) -> CtValue Never! {
    CtValue.Struct{type_name: name, fields: [NamedCtValue]{NamedCtValue{name: a_name, value: ^a}, NamedCtValue{name: b_name, value: ^b}}}
}
fn prelude_method_match_span(fields: &[NamedCtValue], index: Int, field: String) -> Int? {
    spans :: prelude_method_list_field(fields, "spans") ?? return None
    if index < 0 || index >= spans.len() -> return None
    if spans[index] == {
        .Present(value) -> if value == {
            .Struct(_, members) -> {
                value :: prelude_method_field(&members, field) ?? return None
                if value == { .Int(n) -> Val(n) else -> None }
            }
            else -> None
        }
        else -> None
    }
}

