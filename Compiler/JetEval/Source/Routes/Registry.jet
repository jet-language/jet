// Checked route registry and ABI guards shared by the Jet evaluator route families.
// Route identity always comes from MirProgram; this file never reconstructs rows
// from textual names.
use jet_foundation.[
    MIRCallFallibility,
    MIRCoreCall,
    MIRCoreCallID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRSourceFileID,
    Span,
    TComptimeReport,
    TComptimeValue,
]

fn jet_eval_route_prelude_row(machine: &JetEvalMachine, call: MIRPreludeCallID, span: Span) -> MIRPreludeCall? {
    loop row in machine.program.prelude_calls {
        if row.id == call -> return Val(row)
    }
    jet_eval_compiler_fail(&machine, span, "MIR Prelude route is missing from the program registry")
    None
}

fn jet_eval_route_core_row(machine: &JetEvalMachine, call: MIRCoreCallID, span: Span) -> MIRCoreCall? {
    loop row in machine.program.core_calls {
        if row.id == call -> return Val(row)
    }
    jet_eval_compiler_fail(&machine, span, "MIR Core route is missing from the program registry")
    None
}

fn jet_eval_route_arity(arity: Int, minimum: Int, maximum: Int, name: String, machine: &JetEvalMachine, span: Span) -> Bool Never! {
    if {
        minimum < 0 || maximum < minimum || arity < minimum || arity > maximum -> {
            jet_eval_compiler_fail(&machine, span, "MIR {name} route arity is outside its registered ABI")
            false
        }
        else -> true
    }
}

fn jet_eval_route_signature_prelude(row: MIRPreludeCall, count: Int, machine: &JetEvalMachine, span: Span) -> Bool Never! {
    if {
        !jet_eval_route_arity(count, row.signature.arity, row.signature.max_arity, "Prelude", &machine, span) -> false
        row.signature.borrow_mask.len() != count -> {
            jet_eval_compiler_fail(&machine, span, "MIR Prelude route borrow mask does not match its ABI")
            false
        }
        else -> true
    }
}

fn jet_eval_route_signature_core(row: MIRCoreCall, count: Int, machine: &JetEvalMachine, span: Span) -> Bool Never! {
    if {
        !jet_eval_route_arity(count, row.arity, row.max_arity, "Core", &machine, span) -> false
        row.borrow_mask.len() != count -> {
            jet_eval_compiler_fail(&machine, span, "MIR Core route borrow mask does not match its ABI")
            false
        }
        else -> true
    }
}

fn jet_eval_route_symbol_prelude(row: MIRPreludeCall, machine: &JetEvalMachine, span: Span) -> String? {
    if row.symbol == {
        .Prelude(name) -> Val(name)
        else -> {
            jet_eval_unsupported(&machine, span, "a Runtime symbol in a pure Prelude route")
            None
        }
    }
}

fn jet_eval_route_data(value: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> TComptimeValue? {
    jet_eval_data(value, &machine, span)
}

fn jet_eval_route_string(value: TComptimeValue) -> String? {
    if value == {
        .String(text) -> Val(text)
        else -> None
    }
}

fn jet_eval_route_list(value: TComptimeValue) -> [TComptimeValue]? {
    if value == {
        .List(values) -> Val(values)
        else -> None
    }
}

fn jet_eval_route_args(values: [JetEvalRuntimeValue], machine: &JetEvalMachine, span: Span) -> [TComptimeValue]? {
    output := [TComptimeValue]{}
    loop value in values {
        &output.push(jet_eval_route_data(value, &machine, span) ?? return None)
    }
    Val(output)
}

fn jet_eval_route_source_path(machine: &JetEvalMachine, file: MIRSourceFileID, span: Span) -> String? {
    loop source in machine.program.source_files {
        if source.id == file -> return Val(source.path)
    }
    jet_eval_compiler_fail(&machine, span, "MIR route location refers to a missing source file")
    None
}

fn jet_eval_route_failure_is_optional(fallibility: MIRCallFallibility) -> Bool Never! {
    if fallibility == {
        .Failure(failure) -> if failure == {
            .Optional(_) -> true
            else -> false
        }
        else -> false
    }
}

fn jet_eval_route_failure_is_result(fallibility: MIRCallFallibility) -> Bool Never! {
    if fallibility == {
        .Failure(failure) -> if failure == {
            .Result(_, _) -> true
            else -> false
        }
        else -> false
    }
}

fn jet_eval_route_success(value: JetEvalRuntimeValue, fallibility: MIRCallFallibility) -> JetEvalRuntimeValue Never! {
    if fallibility == MIRCallFallibility.Infallible -> return ~value
    if value == {
        .Absent(_) | .Result(_, _) -> value
        .Data(data) -> if data == {
            .Present(_) | .Failed(_) -> value
            else -> {
                wrap :: jet_eval_route_failure_is_optional(fallibility) || jet_eval_route_failure_is_result(fallibility)
                if wrap -> JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: data}} else -> value
            }
        }
        else -> {
            wrap :: jet_eval_route_failure_is_optional(fallibility) || jet_eval_route_failure_is_result(fallibility)
            if wrap -> JetEvalRuntimeValue.Result{ok: true, value: value} else -> value
        }
    }
}

fn jet_eval_route_told_failure(message: String, fallibility: MIRCallFallibility) -> JetEvalRuntimeValue? {
    if {
        jet_eval_route_failure_is_optional(fallibility) || jet_eval_route_failure_is_result(fallibility) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Failed{report: TComptimeReport.Told{value: TComptimeValue.String{value: message}}}})
        else -> None
    }
}

fn jet_eval_route_not_supported(machine: &JetEvalMachine, span: Span, detail: String) -> JetEvalRuntimeValue? {
    jet_eval_unsupported(&machine, span, detail)
    None
}
