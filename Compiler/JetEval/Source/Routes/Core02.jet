}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2195
fn ui_node_role(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    role := args.get(3).cloned().ok_or_else(fn() { unsupported("core.ui.node_role(): missing role", span) })?
    kind := match &role { .Enum { variant, .. } if variant == "Button" => "Button"; .Enum { variant, .. } if variant == "TextInput" => "TextInput"; _ => "Custom" }
    ui_node(args, span, Val(^role), None, kind)?
}
