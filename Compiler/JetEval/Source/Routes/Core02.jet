// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2383
fn tui_color(args: &[CtValue], span: Span, variant: String, arity: USize) -> CtValue Diagnostic! {
    values: [I64] = []
    for index in 0..<arity { values.push(int_arg(args, index, span)?) }
    color := match (variant, values.as_slice()) {
        ("ANSI16", [index]) => tui_kernel.color_ansi16(*index)
        ("ANSI256", [index]) => tui_kernel.color_ansi256(*index)
        ("RGB", [red, green, blue]) => tui_kernel.color_rgb(*red, *green, *blue)
        _ => throw unsupported("malformed TUIColor value", span)
    }
    tui_kernel_color_value(color)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2395
fn tui_enum_parts(value: &CtValue, expected: String, span: Span) -> (&String, &[(String?, CtValue)]) Diagnostic! {
    match value {
        .Enum { type_name, variant, args } if type_name == expected => (variant, args)
        _ => throw unsupported("core.tui expected {expected}", span)
    }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2420
fn tui_kernel_profile(value: &CtValue, span: Span) -> tui_kernel.ColorProfile Diagnostic! {
    (variant, args) := tui_enum_parts(value, "TUIColorProfile", span)?
    if !args.is_empty() { throw unsupported("core.tui color profile takes no arguments", span) }
    match variant { "ANSI16" => .Ansi16; "ANSI256" => .Ansi256; "TrueColor" => .TrueColor; "ASCII" => .Ascii; _ => throw unsupported("unknown TUIColorProfile variant", span) }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2434
fn tui_kernel_color(value: &CtValue, span: Span) -> tui_kernel.Color Diagnostic! {
    (variant, args) := tui_enum_parts(value, "TUIColor", span)?
    values: [I64] = []
    for (_, value) in args { values.push(as_int(value, span)?) }
    match (variant, values.as_slice()) {
        ("ANSI16", [index]) => tui_kernel.color_ansi16(*index)
        ("ANSI256", [index]) => tui_kernel.color_ansi256(*index)
        ("RGB", [red, green, blue]) => tui_kernel.color_rgb(*red, *green, *blue)
        _ => throw unsupported("malformed TUIColor value", span)
    }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2448
fn tui_kernel_color_value(color: tui_kernel.Color) -> CtValue {
    (variant, values): (String, [I64]) = match color { .Ansi16(index) => ("ANSI16", [index as I64]); .Ansi256(index) => ("ANSI256", [index as I64]); .Rgb(red, green, blue) => ("RGB", [red as I64, green as I64, blue as I64]) }
    .Enum { type_name: "TUIColor", variant: ^variant, args: values.into_iter().map(fn(value) { (None, CtValue.Int(value)) }).collect() }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2466
fn tui_kernel_bool_field(value: &CtValue, name: String, span: Span) -> Bool Diagnostic! {
    match field(value, "TUICapabilities", name).or_else(fn() { field(value, "TUIStyle", name) }) { Val(.Bool(value)) => *value; _ => throw unsupported("malformed core.tui boolean field `{name}`", span) }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2476
fn tui_kernel_int_field(value: &CtValue, type_name: String, name: String, span: Span) -> I64 Diagnostic! {
    as_int(field(value, type_name, name).ok_or_else(fn() { unsupported("malformed {type_name}.{name} value", span) })?, span)?
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2484
fn tui_kernel_capabilities(value: &CtValue, span: Span) -> tui_kernel.Capabilities Diagnostic! {
    profile := tui_kernel_profile(field(value, "TUICapabilities", "profile").ok_or_else(fn() { unsupported("malformed TUICapabilities.profile value", span) })?, span)?
    tui_kernel.Capabilities {
        profile: profile, color: tui_kernel_bool_field(value, "color", span)?, unicode: tui_kernel_bool_field(value, "unicode", span)?,
        mouse: tui_kernel_bool_field(value, "mouse", span)?, resize: tui_kernel_bool_field(value, "resize", span)?, clipboard: tui_kernel_bool_field(value, "clipboard", span)?,
        width: tui_kernel_int_field(value, "TUICapabilities", "width", span)?.max(1) as USize,
        height: tui_kernel_int_field(value, "TUICapabilities", "height", span)?.max(1) as USize
    }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2504
fn tui_kernel_capabilities_value(capabilities: tui_kernel.Capabilities) -> CtValue {
    profile := match capabilities.profile { .Ansi16 => tui_profile("ANSI16"); .Ansi256 => tui_profile("ANSI256"); .TrueColor => tui_profile("TrueColor"); .Ascii => tui_profile("ASCII") }
    structure("TUICapabilities", [("profile", ^profile), ("color", .Bool(capabilities.color)), ("unicode", .Bool(capabilities.unicode)),
        ("mouse", .Bool(capabilities.mouse)), ("resize", .Bool(capabilities.resize)), ("clipboard", .Bool(capabilities.clipboard)),
        ("width", .Int(capabilities.width as I64)), ("height", .Int(capabilities.height as I64))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2526
fn tui_kernel_optional_color(value: &CtValue, name: String, span: Span) -> tui_kernel.Color? Diagnostic! {
    match field(value, "TUIStyle", name) { Val(.Present(inner)) => Val(tui_kernel_color(inner, span)?); Val(.Failed(.Clean(_))) => None; _ => throw unsupported("malformed TUIStyle.{name} value", span) }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2541
fn tui_kernel_style(value: &CtValue, span: Span) -> tui_kernel.Style Diagnostic! {
    tui_kernel.Style { foreground: tui_kernel_optional_color(value, "foreground", span)?, background: tui_kernel_optional_color(value, "background", span)?,
        bold: tui_kernel_bool_field(value, "bold", span)?, dim: tui_kernel_bool_field(value, "dim", span)?, underline: tui_kernel_bool_field(value, "underline", span)? }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2551
fn tui_kernel_constraint(value: &CtValue, span: Span) -> tui_kernel.Constraint Diagnostic! {
    (variant, args) := tui_enum_parts(value, "TUIConstraint", span)?
    amount := if first := args.first() { as_float(&first.1, span)? } else { 1.0 }
    match variant { "Length" => tui_kernel.length(amount); "Min" => tui_kernel.min(amount); "Max" => tui_kernel.max(amount); "Percent" => tui_kernel.percent(amount); "Fill" => tui_kernel.fill(amount); _ => throw unsupported("unknown TUIConstraint variant", span) }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2571
fn tui_kernel_rect(value: &CtValue, span: Span) -> tui_kernel.Rect Diagnostic! {
    tui_kernel.Rect {
        x: as_float(field(value, "Rect", "x").ok_or_else(fn() { unsupported("core.tui.layout() needs Rect", span) })?, span)?,
        y: as_float(field(value, "Rect", "y").ok_or_else(fn() { unsupported("core.tui.layout() needs Rect", span) })?, span)?,
        width: as_float(field(value, "Rect", "width").ok_or_else(fn() { unsupported("core.tui.layout() needs Rect", span) })?, span)?,
        height: as_float(field(value, "Rect", "height").ok_or_else(fn() { unsupported("core.tui.layout() needs Rect", span) })?, span)?
    }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2596
