// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2816
fn tui_table(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    headers := match one(args, 0, "core.tui", "table", span)? { .List(values) => values; _ => throw unsupported("core.tui.table() needs [String] headers", span) }
    rows := match one(args, 1, "core.tui", "table", span)? { .List(values) => values; _ => throw unsupported("core.tui.table() needs [[String]] rows", span) }
    lines := [CtValue].with_capacity(rows.len() + 1)
    join := fn(row: &[CtValue]) -> CtValue Diagnostic! {
        line := String.new()
        for (index, value) in row.iter().enumerate() { if index != 0 { line.push_str(" | ") }; line.push_str(string_arg(std.slice.from_ref(value), 0, span)?) }
        .Str(^line)
    }
    lines.push(join(headers)?)
    for row in rows { values := match row { .List(values) => values; _ => throw unsupported("core.tui.table() needs [[String]] rows", span) }; lines.push(join(values)?) }
    tui_list(&[CtValue.List(^lines)], span)?
}
