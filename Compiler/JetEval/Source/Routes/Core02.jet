// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:1848
fn io_error_display(value: &CtValue) -> String? {
    (type_name, variant, args) := match value { .Enum { type_name, variant, args } => (type_name, variant, args); _ => return None }
    actual := type_name.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(type_name)
    if actual != "IOError" { return None }
    variant_name := variant.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(variant)
    if variant_name == "ResourceLimit" {
        (limit_type, limit_variant) := match args.first() {
            Val((_, .Enum { type_name: limit_type, variant: limit_variant, .. })) => (limit_type, limit_variant)
            _ => return None
        }
        actual_limit := limit_type.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(limit_type)
        if actual_limit != "ProcessResourceLimit" { return None }
        limit_name := limit_variant.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(limit_variant)
        limit := Syntax.PROCESS_RESOURCE_LIMIT_VARIANTS.iter().position(fn(name) { name == limit_name }) else { return None }
        return Val("process resource limit exceeded: {StructuralDebug.jet_show_process_resource_limit(limit as I64)}")
    }
    code := match variant_name {
        "InvalidInput" => 0; "NotFound" => 1; "PermissionDenied" => 2; "TimedOut" => 3
        "Cancelled" => 4; "Closed" => 5; "Protocol" => 6; "Other" => 7; _ => return None
    }
    (context_type, fields) := match args.first() {
        Val((_, .Struct { type_name, fields })) => (type_name, fields)
        _ => return None
    }
    if context_type.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(context_type) != "IOContext" { return None }
    context_field := fn(wanted: String) -> &CtValue? {
        fields.iter().find_map(fn((name, value)) {
            if name == wanted || name.strip_prefix(Syntax.GENERATED_NAME_PREFIX) == Val(wanted) { Val(value) } else { None }
        })
    }
    operation_variant := match context_field("operation") { Val(.Enum { variant, .. }) => variant; _ => return None }
    operation := match operation_variant.strip_prefix(Syntax.GENERATED_NAME_PREFIX).unwrap_or(operation_variant) {
        "Read" => 0; "Write" => 1; "Flush" => 2; "Connect" => 3; "Accept" => 4
        "Close" => 5; "Resolve" => 6; "Codec" => 7; _ => return None
    }
    optional_text := fn(wanted: String) -> (&String?)? {
        match context_field(wanted) {
            Val(.Present(inner)) => match inner.as_ref() { .Str(text) => Val(Val(text)); _ => None }
            Val(.Failed(.Clean(_))) => Val(None)
            Val(.Str(text)) => Val(Val(text))
            _ => None
        }
    }
    resource := optional_text("resource") else { return None }
    cause := optional_text("cause") else { return None }
    Val(StructuralDebug.jet_show_io_error(code, operation, resource, cause))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:1962
fn path_string(value: &CtValue, span: Span) -> String Diagnostic! {
    fields := match value { .Struct { fields, .. } => fields; _ => throw unsupported("malformed Path value", span) }
    for (name, value) in fields {
        match (name, value) { ("inner", .Str(path)) => return path.clone(); _ => {} }
    }
    throw unsupported("malformed Path value", span)
}
