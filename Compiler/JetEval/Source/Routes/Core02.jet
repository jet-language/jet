fn tui_list(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    items := match one(args, 0, "core.tui", "list", span)? { .List(values) => values; _ => throw unsupported("core.tui.list() needs [String]", span) }
    children: [CtValue] = []
    for item in items { text := match item { .Str(value) => value.clone(); _ => throw unsupported("core.tui.list() needs [String]", span) }; children.push(ui_text(&[CtValue.Str(^text)], span)?) }
