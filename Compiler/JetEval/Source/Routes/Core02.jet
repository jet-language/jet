// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2604
fn tui_capabilities() -> CtValue { tui_kernel_capabilities_value(tui_kernel.capabilities(.Ascii, 80, 24)) }
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2612
fn tui_constraint(args: &[CtValue], span: Span, variant: String) -> CtValue Diagnostic! {
    amount := float_arg(args, 0, span)?
    constraint := match variant { "Length" => tui_kernel.length(amount); "Min" => tui_kernel.min(amount); "Max" => tui_kernel.max(amount); "Percent" => tui_kernel.percent(amount); "Fill" => tui_kernel.fill(amount); _ => throw unsupported("unknown TUIConstraint variant", span) }
    normalized := match constraint { .Length(value) | .Min(value) | .Max(value) | .Percent(value) => value; .Fill(weight) => weight as F64 }
    tui_event_for_type("TUIConstraint", ^variant, [(None, .Float(CtFloat.f64(normalized)))])?
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2636
fn tui_style_default() -> CtValue {
    structure("TUIStyle", [("foreground", CtValue.absent(.Named("TUIColor"))), ("background", CtValue.absent(.Named("TUIColor"))),
        ("bold", .Bool(false)), ("dim", .Bool(false)), ("underline", .Bool(false))])
