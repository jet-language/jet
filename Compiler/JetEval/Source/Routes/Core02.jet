// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3001
fn crypto_ed25519_verify(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    public := as_bytes(one(args, 0, "core.crypto.expert", "ed25519_verify_strict", span)?, span)?
    message := as_bytes(one(args, 1, "core.crypto.expert", "ed25519_verify_strict", span)?, span)?
    signature := as_bytes(one(args, 2, "core.crypto.expert", "ed25519_verify_strict", span)?, span)?
    if public.len() != 32 { return CtValue.failed(Box.new(crypto_error("expert.ed25519_verify_strict: public must be exactly 32; got {public.len()}"))) }
    if signature.len() != 64 { return CtValue.failed(Box.new(crypto_error("expert.ed25519_verify_strict: signature must be exactly 64; got {signature.len()}"))) }
    if message.len() > 1073741824 { return CtValue.failed(Box.new(crypto_error("expert.ed25519_verify_strict: message must be at most 1073741824; got {message.len()}"))) }
    public_key: [U8;32] = public.try_into().expect("length checked")
    signature_bytes: [U8;64] = signature.try_into().expect("length checked")
    valid := CryptoLite.ed25519_verify_strict(&public_key, &message, &signature_bytes) catch _ {
        return CtValue.failed(Box.new(crypto_error("expert.ed25519_verify_strict: Ed25519 public key is not canonical")))
    }
    .Present(Box.new(CtValue.Bool(valid)))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3042
fn crypto_ed25519_sign(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    seed := as_bytes(one(args, 0, "core.crypto.expert", "ed25519_sign", span)?, span)?
    message := as_bytes(one(args, 1, "core.crypto.expert", "ed25519_sign", span)?, span)?
    if seed.len() != 32 { return CtValue.failed(Box.new(crypto_error("expert.ed25519_sign: seed must be exactly 32; got {seed.len()}"))) }
    if message.len() > 1073741824 { return CtValue.failed(Box.new(crypto_error("expert.ed25519_sign: message must be at most 1073741824; got {message.len()}"))) }
    seed_bytes: [U8;32] = seed.try_into().expect("length checked")
    signature := CryptoLite.ed25519_sign(&seed_bytes, &message)
    .Present(Box.new(crypto_secret("Signature", signature.to_vec())))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3071
fn crypto_aead_lengths(operation: String, key: &[U8], nonce: &[U8], nonce_length: USize, input: &[U8], aad: &[U8], opening: Bool) -> CtValue? {
    if key.len() != 32 { return Val(CtValue.failed(Box.new(crypto_error("{operation}: key must be exactly 32; got {key.len()}")))) }
    nonce_expected := if nonce_length == 24 { "exactly 24" } else { "exactly 12" }
    if nonce.len() != nonce_length { return Val(CtValue.failed(Box.new(crypto_error("{operation}: nonce must be {nonce_expected}; got {nonce.len()}")))) }
    (minimum, maximum, label, expected) := if opening { (16, 1073741840, "ciphertext", "16..=1073741840") } else { (0, 1073741824, "plaintext", "at most 1073741824") }
    if input.len() < minimum || input.len() > maximum { return Val(CtValue.failed(Box.new(crypto_error("{operation}: {label} must be {expected}; got {input.len()}")))) }
    if aad.len() > 16777216 { return Val(CtValue.failed(Box.new(crypto_error("{operation}: aad must be at most 16777216; got {aad.len()}")))) }
    None
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3122
fn crypto_aead_seal(args: &[CtValue], span: Span, operation: String, nonce_length: USize, aes: Bool) -> CtValue Diagnostic! {
    key := as_bytes(one(args, 0, "core.crypto.expert", operation, span)?, span)?
    nonce := as_bytes(one(args, 1, "core.crypto.expert", operation, span)?, span)?
    plaintext := as_bytes(one(args, 2, "core.crypto.expert", operation, span)?, span)?
    aad := as_bytes(one(args, 3, "core.crypto.expert", operation, span)?, span)?
    if error := crypto_aead_lengths(operation, &key, &nonce, nonce_length, &plaintext, &aad, false) { return ^error }
    bytes := (if aes { CryptoLite.aes256gcm_seal(&key, &nonce, &plaintext, &aad) } else { CryptoLite.xchacha20poly1305_seal(&key, &nonce, &plaintext, &aad) }) catch _ {
        algorithm := if aes { "aes" } else { "xchacha" }
        return CtValue.failed(Box.new(crypto_error("Jet could not preserve a cryptographic invariant; incident expert-{algorithm}-seal")))
    }
    .Present(Box.new(CtValue.Bytes(^bytes)))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3158
fn crypto_aead_open(args: &[CtValue], span: Span, operation: String, nonce_length: USize) -> CtValue Diagnostic! {
    key := as_bytes(one(args, 0, "core.crypto.expert", operation, span)?, span)?
    nonce := as_bytes(one(args, 1, "core.crypto.expert", operation, span)?, span)?
    ciphertext := as_bytes(one(args, 2, "core.crypto.expert", operation, span)?, span)?
    aad := as_bytes(one(args, 3, "core.crypto.expert", operation, span)?, span)?
    if error := crypto_aead_lengths(operation, &key, &nonce, nonce_length, &ciphertext, &aad, true) { return ^error }
    bytes := (if nonce_length == 12 { CryptoLite.aes256gcm_open(&key, &nonce, &ciphertext, &aad) } else { CryptoLite.xchacha20poly1305_open(&key, &nonce, &ciphertext, &aad) }) catch _ {
        return CtValue.failed(Box.new(crypto_error("encrypted data could not be opened")))
    }
    .Present(Box.new(CtValue.Bytes(^bytes)))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3192
fn crypto_argon2id(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    password := match field(one(args, 0, "core.crypto.expert", "argon2id", span)?, "Secret", "bytes") {
        Val(.Bytes(bytes)) => bytes.clone()
        Val(.List(bytes)) => as_bytes(&CtValue.List(bytes.clone()), span)?
        _ => throw unsupported("core.crypto.expert.argon2id() needs a Secret password", span)
    }
    salt := as_bytes(one(args, 1, "core.crypto.expert", "argon2id", span)?, span)?
    memory_kib := int_arg(args, 2, span)?
    iterations := int_arg(args, 3, span)?
    lanes := int_arg(args, 4, span)?
    output_length := int_arg(args, 5, span)?
    if password.len() > 1048576 { return CtValue.failed(Box.new(crypto_error("password hash is outside Jet's accepted policy"))) }
    if salt.len() < 8 || salt.len() > 64 { return CtValue.failed(Box.new(crypto_error("expert.argon2id: salt must be 8..=64; got {salt.len()}"))) }
    if memory_kib < 8192 || memory_kib > 262144 || iterations < 1 || iterations > 10 || lanes < 1 || lanes > 8 || memory_kib < 8 * lanes || memory_kib.checked_mul(iterations).is_none_or(fn(value) { value > 1048576 }) {
        return CtValue.failed(Box.new(crypto_error("password hash is outside Jet's accepted policy")))
    }
    if output_length < 16 || output_length > 64 { return CtValue.failed(Box.new(crypto_error("expert.argon2id: output length must be 16..64; got {output_length}"))) }
    bytes := CryptoLite.argon2id(&password, &salt, memory_kib as U32, iterations as U32, lanes as U32, output_length as USize) catch _ {
        return CtValue.failed(Box.new(crypto_error("password hash is outside Jet's accepted policy")))
    }
    .Present(Box.new(crypto_secret("Secret", ^bytes)))
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3255
fn crypto_x25519(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    secret := as_bytes(one(args, 0, "core.crypto.expert", "x25519_raw", span)?, span)?
    public := as_bytes(one(args, 1, "core.crypto.expert", "x25519_raw", span)?, span)?
    if secret.len() != 32 || public.len() != 32 { return CtValue.failed(Box.new(crypto_error("X25519 keys must contain exactly 32 bytes"))) }
    shared := CryptoLite.x25519(&secret, &public).expect("length checked")
    if shared == [U8{0};32] { return CtValue.failed(Box.new(crypto_error("X25519 peer key does not contribute to a shared secret"))) }
    .Present(Box.new(crypto_secret("Secret", shared.to_vec())))
}
