// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3331
fn parse_mime(input: &String) -> CtValue Err! {
    parts := mime_kernel.jet_mime_parse_parts(input)?
    params := parts.params.into_iter().map(fn((key, value)) { CtValue.List([CtValue.Str(^key), CtValue.Str(^value)]) }).collect()
    structure("MIME", [("top", .Str(^parts.top)), ("sub", .Str(^parts.sub)), ("parameters", .List(^params))])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3348
fn mime_parts(value: &CtValue, span: Span) -> mime_kernel.JetMimeParts Diagnostic! {
    top_value := field(value, "MIME", "top").ok_or_else(fn() { unsupported("malformed MIME.top value", span) })?
    top := match top_value { .Str(top) => top; _ => throw unsupported("malformed Mime.top value", span) }
    sub_value := field(value, "MIME", "sub").ok_or_else(fn() { unsupported("malformed MIME.sub value", span) })?
    sub := match sub_value { .Str(sub) => sub; _ => throw unsupported("malformed Mime.sub value", span) }
    values := match field(value, "MIME", "parameters") { Val(.List(values)) => values; _ => throw unsupported("malformed MIME.parameters value", span) }
    params := [(String, String)].with_capacity(values.len())
    for value in values {
        pair := match value { .List(pair) => pair; _ => throw unsupported("malformed Mime parameter", span) }
        match pair.as_slice() { [.Str(key), .Str(value)] => params.push((key.clone(), value.clone())); _ => throw unsupported("malformed Mime parameter", span) }
    }
    mime_kernel.JetMimeParts { top: top.clone(), sub: sub.clone(), params: ^params }
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3379
fn mime_essence(value: &CtValue, span: Span) -> String Diagnostic! {
    parts := mime_parts(value, span)?
    mime_kernel.jet_mime_essence(&parts.top, &parts.sub)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:3384
fn mime_string(value: &CtValue, span: Span) -> String Diagnostic! {
    parts := mime_parts(value, span)?
