    normalized: [tui_kernel.Constraint] = []
    for constraint in constraints { normalized.push(tui_kernel_constraint(constraint, span)?) }
    rects := tui_kernel.layout(tui_kernel_rect(rect, span)?, axis, &normalized)
    .List(rects.into_iter().map(fn(rect) { tui_rect_value(rect.x, rect.y, rect.width, rect.height) }).collect())
}
