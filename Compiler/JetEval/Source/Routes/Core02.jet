// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2101
fn ui_node_value_with_metadata(label: String, width: F64, height: F64, role: CtValue?, color: String?, kind: String, children: [CtValue], accessibility: CtValue?, shortcut: CtValue?) -> CtValue {
    structure("UINode", [
        ("label", .Str(^label)), ("width", .Float(CtFloat.f64(width))), ("height", .Float(CtFloat.f64(height))),
        ("role", role.map_or(CtValue.absent(.Named("UIAriaRole")), fn(role) { .Present(Box.new(^role)) })),
        ("accessibility", accessibility.map_or(CtValue.absent(.Named("UIAccessibility")), fn(metadata) { .Present(Box.new(^metadata)) })),
        ("ime", CtValue.absent(.Named("UIIMEMode"))),
        ("color", color.map_or(CtValue.absent(.String), fn(color) { .Present(Box.new(CtValue.Str(^color))) })),
        ("kind", ui_kind(^kind)), ("children", .List(^children)),
        ("shortcut", shortcut.map_or(CtValue.absent(.Named("UIShortcut")), fn(shortcut) { .Present(Box.new(^shortcut)) }))
    ])
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2155
fn ui_node_value(label: String, width: F64, height: F64, role: CtValue?, color: String?, kind: String, children: [CtValue]) -> CtValue {
    ui_node_value_with_metadata(^label, width, height, ^role, ^color, ^kind, ^children, None, None)
}
