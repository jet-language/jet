// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2226
fn ui_button(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    label := string_arg(args, 0, span)?.clone()
    shortcut := match args.get(1) { Val(.Present(inner)) => Val(inner.as_ref().clone()); _ => None }
    accessible_label := match args.get(2) { Val(.Present(inner)) => match inner.as_ref() { .Str(value) => Val(value.clone()); _ => None }; _ => None }
    accessibility := accessible_label.map(fn(name) {
        structure("UIAccessibility", [("name", .Present(Box.new(CtValue.Str(^name)))), ("description", CtValue.absent(.String)), ("states", .List([]))])
    })
    ui_node_value_with_metadata(label.clone(), label.chars().count() as F64 + 4.0, 1.0, Val(ui_role("Button")), None, "Button", [], ^accessibility, ^shortcut)
}
// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:2268
fn ui_box(args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    children := match args.first() { Val(.List(children)) => children.clone(); _ => throw unsupported("core.ui.box() needs [UINode]", span) }
    width: F64 = 0.0
    height: F64 = 0.0
    for child in &children {
        width = width.max(as_float(field(child, "UINode", "width").ok_or_else(fn() { unsupported("core.ui.box() needs UINode children", span) })?, span)?)
        height += as_float(field(child, "UINode", "height").ok_or_else(fn() { unsupported("core.ui.box() needs UINode children", span) })?, span)?
    }
    ui_node_value("", width, height, Val(ui_role("Container")), None, "Box", ^children)
}
