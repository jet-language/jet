// Numeric Prelude routes and conversion operations. These branches mirror the
// canonical MIR route identities; unsupported carrier shapes fail explicitly.
use jet_foundation.[
    MIRConversion,
    MIRPreludeCall,
    MIRPreludeFamily,
    MIRType,
    MIRTypeKind,
    Span,
    TComptimeValue,
    mir_symbol_name,
    mir_type_from_kind,
]

fn jet_eval_route_integer(value: TComptimeValue, machine: &JetEvalMachine, span: Span) -> String? {
    jet_eval_decimal_text(value) ?? {
        jet_eval_compiler_fail(&machine, span, "numeric route requires an exact integer")
        return None
    }
}

fn jet_eval_route_float_value(value: TComptimeValue, machine: &JetEvalMachine, span: Span) -> Float? {
    if value == {
        .Float(number, _) -> Val(number)
        else -> {
            jet_eval_compiler_fail(&machine, span, "numeric route requires a Float")
            None
        }
    }
}

fn jet_eval_route_int_value(value: TComptimeValue, machine: &JetEvalMachine, span: Span) -> Int? {
    if value == {
        .Int(number) -> Val(number)
        .BigInt(decimal) -> {
            parsed :: Int.parse(decimal) ?? {
                jet_eval_compiler_fail(&machine, span, "numeric route integer does not fit its Int carrier")
                return None
            }
            Val(parsed)
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "numeric route requires an integer")
            None
        }
    }
}

fn jet_eval_route_numeric_cast_data(value: TComptimeValue, target: MIRType, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if target.kind == {
        .Tagged(_, inner) -> jet_eval_route_numeric_cast_data(value, inner, &machine, span)
        .Quantity(base, _) -> jet_eval_route_numeric_cast_data(value, base, &machine, span)
        .Int -> {
            decimal :: jet_eval_route_integer(value, &machine, span) ?? return None
            Val(JetEvalRuntimeValue.Data{value: jet_eval_decimal_value(decimal)})
        }
        .Float | .Float32 -> {
            bits :: if target.kind == MIRTypeKind.Float32 -> 32 else -> 64
            if value == {
                .Int(number) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: Float.from_int(number), bits: bits}})
                .BigInt(decimal) -> {
                    number :: decimal.to_float() ?? {
                        jet_eval_compiler_fail(&machine, span, "MIR BigInt-to-Float conversion failed")
                        return None
                    }
                    Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: number, bits: bits}})
                }
                .Float(number, _) -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: number, bits: bits}})
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR numeric cast to Float requires a numeric operand")
                    None
                }
            }
        }
        else -> Val(JetEvalRuntimeValue.Data{value: value})
    }
}

fn jet_eval_route_convert(machine: &JetEvalMachine, value: JetEvalRuntimeValue, parameters: [JetEvalRuntimeValue], target: MIRType, conversion: MIRConversion, span: Span) -> JetEvalRuntimeValue? {
    if conversion == {
        .Transparent -> jet_eval_copy_value(value, &machine, span)
        .NumericCast -> {
            data :: jet_eval_route_data(value, &machine, span) ?? return None
            jet_eval_route_numeric_cast_data(data, target, &machine, span)
        }
        .SendFn -> jet_eval_route_not_supported(&machine, span, "SendFn numeric conversion")
        .Prelude(call, location, fallibility) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            args := [JetEvalRuntimeValue]{value}
            loop parameter in parameters -> &args.push(parameter)
            delta :: row.signature.arity - args.len()
            if {
                delta == 2 -> {
                    path :: jet_eval_route_source_path(&machine, location.file, span) ?? return None
                    &args.push(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: path}})
                    &args.push(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: location.line}})
                }
                delta != 0 -> {
                    jet_eval_compiler_fail(&machine, span, "MIR conversion Prelude route has an invalid location ABI")
                    return None
                }
                else -> {}
            }
            if !jet_eval_route_signature_prelude(row, args.len(), &machine, span) -> return None
            output :: jet_eval_route_numeric_conversion(row, args, &machine, Val(target), span) ?? return None
            Val(jet_eval_route_success(output, fallibility))
        }
    }
}

fn jet_eval_route_exact_integer_host(row: MIRPreludeCall, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if row.signature.arity != args.len() || row.signature.max_arity != args.len() {
        jet_eval_compiler_fail(&machine, span, "exact integer Prelude adapter ABI disagrees with its registered row")
        return None
    }
    jet_eval_host_row(&machine, row, args, result_ty, span)
}

fn jet_eval_route_exact_integer_member_host(member: String, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    loop row in machine.program.prelude_calls {
        if row.family == MIRPreludeFamily.Overflow && row.module_name == "core.numeric" && row.member == member && jet_eval_route_exact_integer_symbol(member, mir_symbol_name(row.symbol)) {
            return jet_eval_route_exact_integer_host(row, args, &machine, result_ty, span)
        }
    }
    descriptor :: jet_eval_exact_integer_row(member, args.len()) ?? {
        jet_eval_unsupported(&machine, span, "exact integer operation has no canonical numeric adapter")
        return None
    }
    jet_eval_route_exact_integer_host(descriptor, args, &machine, result_ty, span)
}

fn jet_eval_route_is_exact_integer(value: TComptimeValue) -> Bool Never! {
    if value == {
        .Int(_) | .BigInt(_) -> true
        else -> false
    }
}

fn jet_eval_route_exact_compare_member_host(member: String, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    loop row in machine.program.prelude_calls {
        if row.family == MIRPreludeFamily.BuiltinMethod && row.module_name == "core.compare" && row.member == member && mir_symbol_name(row.symbol) == "jet_int_compare" {
            return jet_eval_host_row(&machine, row, args, result_ty, span)
        }
    }
    descriptor :: jet_eval_exact_compare_row(member) ?? {
        jet_eval_unsupported(&machine, span, "exact integer comparison has no canonical numeric adapter")
        return None
    }
    jet_eval_host_row(&machine, descriptor, args, result_ty, span)
}

fn jet_eval_route_exact_order(left: TComptimeValue, right: TComptimeValue, machine: &JetEvalMachine, span: Span) -> Int? {
    args :: [JetEvalRuntimeValue]{
        JetEvalRuntimeValue.Data{value: left},
        JetEvalRuntimeValue.Data{value: right},
    }
    result_ty :: Val(mir_type_from_kind(MIRTypeKind.Bool))
    less :: jet_eval_route_exact_compare_member_host("lt", args, &machine, result_ty, span) ?? return None
    less_data :: jet_eval_data(less, &machine, span) ?? return None
    if less_data == (TComptimeValue.Bool{value: true}) -> return Val(-1)
    greater :: jet_eval_route_exact_compare_member_host("gt", args, &machine, result_ty, span) ?? return None
    greater_data :: jet_eval_data(greater, &machine, span) ?? return None
    if greater_data == (TComptimeValue.Bool{value: true}) -> return Val(1)
    if less_data == (TComptimeValue.Bool{value: false}) && greater_data == (TComptimeValue.Bool{value: false}) -> return Val(0)
    jet_eval_compiler_fail(&machine, span, "exact integer comparison produced a non-Boolean carrier")
    None
}

fn jet_eval_route_fixed_host(row: MIRPreludeCall, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if row.signature.arity != args.len() || row.signature.max_arity != args.len() {
        jet_eval_compiler_fail(&machine, span, "fixed integer Prelude adapter ABI disagrees with its registered row")
        return None
    }
    jet_eval_host_row(&machine, row, args, result_ty, span)
}

fn jet_eval_route_precise_operator(module_name: String, member: String) -> Bool Never! {
    if module_name == {
        "Decimal" -> if member == {
            "from_str" | "add" | "sub" | "mul" -> true
            else -> false
        }
        "Fraction" -> if member == {
            "new" | "from_parts" | "add" | "sub" | "mul" | "div" -> true
            else -> false
        }
        else -> false
    }
}

fn jet_eval_route_precise_symbol(module_name: String, member: String, symbol: String) -> Bool Never! {
    if module_name == {
        "Decimal" -> {
            expected :: if member == {
                "from_str" -> "jet_decimal_from_str"
                "add" -> "jet_decimal_add"
                "sub" -> "jet_decimal_sub"
                "mul" -> "jet_decimal_mul"
                else -> ""
            }
            expected != "" && symbol == expected
        }
        "Fraction" -> {
            expected :: if member == {
                "new" -> "jet_fraction_new"
                "from_parts" -> "jet_fraction_from_parts"
                "add" -> "jet_fraction_add"
                "sub" -> "jet_fraction_sub"
                "mul" -> "jet_fraction_mul"
                "div" -> "jet_fraction_div"
                else -> ""
            }
            expected != "" && symbol == expected
        }
        else -> false
    }
}

fn jet_eval_route_precise_member_host(module_name: String, member: String, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    loop row in machine.program.prelude_calls {
        if row.family == MIRPreludeFamily.PreciseBuiltin && row.module_name == module_name && row.member == member && row.signature.arity == args.len() && jet_eval_route_precise_symbol(module_name, member, mir_symbol_name(row.symbol)) {
            return jet_eval_host_row(&machine, row, args, result_ty, span)
        }
    }
    jet_eval_unsupported(&machine, span, "precise numeric operation has no canonical Prelude adapter")
    None
}

fn jet_eval_route_fixed_member(member: String) -> [String]? {
    parts := member.split(".").to_list()
    if parts.len() != 3 -> return None
    if parts[1] != "trap" && parts[1] != "checked" && parts[1] != "checked_policy" && parts[1] != "wrapping" && parts[1] != "saturating" -> return None
    Val(parts)
}

fn jet_eval_route_numeric_conversion(row: MIRPreludeCall, args: [JetEvalRuntimeValue], machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_row(&machine, row, args, result_ty, span)
}
