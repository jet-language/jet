// Typed reflection projections; shared value and layout builders live in Reflect.
use jet_foundation.[CtValue, Span]
use jet_foundation.AST.[Item, Expr, Func, Type, StructDef, DistinctDef, EnumDef, Variant, VariantPayload, TypeParam, ProgramBundle, ArithmeticPolicyFact, ArithmeticOperation, arithmetic_policy_facts]
use jet_foundation.Facts.[BuildFactSnapshot, BuildFactValue, FactRegistry, StateGraph]
use jet_foundation.Registry.[FactRead, build_setting_key, build_fact_read, fact_read]
use jet_foundation.Policy.MarkerVocabulary
use jet_foundation.Names.NameLedger
use jet_foundation.Reflection
use jet_foundation.Syntax
use jet_comptime.Comptime.Reflect.*

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1803
pub fn reflect_type_fact_value_with_target_and_graph_and_facts(items: &[Item], type_name: String, module: String, target: &TargetLayout, graph: (&StateGraph)?, facts: (&FactRegistry)?, read: FactRead) -> CtValue? {
    field :: if read == { .Layout -> "layout"; .Name -> "name"; .Fields -> "fields"; _ -> return None }
    info :: reflect_type_value_with_target_and_graph_and_facts(items, type_name, module, target, graph, facts)?
    reflected_struct_field(&info, field).cloned()
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1828
pub fn fact_read_value(expr: &Expr, items: &[Item], build_facts: &BuildFactSnapshot) -> CtValue? {
    registry :: FactRegistry.from_state_items(items)
    fact_read_value_with_registry(expr, items, build_facts, &registry)
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1837
pub fn fact_read_value_with_registry(expr: &Expr, items: &[Item], build_facts: &BuildFactSnapshot, fact_registry: &FactRegistry) -> CtValue? {
    if expr == .MethodCall { receiver, method, args, .. } {
        if method == "reflect" && args.is_empty() {
            if receiver == .Ident(type_name, _) {
                target :: TargetLayout.from_build_facts(build_facts)
                return reflect_type_value_with_target_and_graph_and_facts(items, type_name, "main", &target, None, Val(fact_registry))
            }
        }
    }
    if expr != .Field(subject, member, _) { return None }
    if fact_path(expr) == .Val(path) {
        if build_setting_key(path) == .Val(key) { return build_setting_value(build_facts, key) }
        if build_fact_read(path) == .Val(read) { return build_fact_value(build_facts, read) }
    }
    is_build_subject :: if subject == { .ComptimeName { name, .. } -> name == "$build"; _ -> false }
    read :: if member == Syntax.BUILD_INFO_PROFILE {
        if !is_build_subject { return None }
        fact_read(Syntax.COMPILER_BUILD_FACT_PROFILE)?
    } else {
        if fact_read(member) == {
            .Val(read) -> read
            .None -> {
                nested :: fact_read_value_with_registry(subject, items, build_facts, fact_registry)?
                if nested != .Struct { fields, .. } { return None }
                return fields.into_iter().find(fn((field, _)) { field == member }).map(fn((_, value)) { ^value })
            }
        }
    }
    subject_name :: if subject == { .Ident(name, _) -> name; _ -> return None }
    if read == {
        .Range -> items.iter().find_map(fn(item) {
            if item == {
                .Distinct(def) if def.name == subject_name -> def.range.map(fn((start, end, _)) { build_range_info(start, end) })
                .UnitFamily(family) -> family.distinct_defs().into_iter().find(fn(def) { def.name == subject_name }).and_then(fn(def) { def.range }).map(fn((start, end, _)) { build_range_info(start, end) })
                _ -> None
            }
        })
        .Dimension -> items.iter().find_map(fn(item) {
            if item == {
                .Distinct(def) if def.name == subject_name -> def.quantity.as_ref().map(fn((dimension, _)) { build_dimension_info(dimension) })
                .UnitFamily(family) -> family.distinct_defs().into_iter().find(fn(def) { def.name == subject_name }).and_then(fn(def) { def.quantity }).map(fn((dimension, _)) { build_dimension_info(&dimension) })
                _ -> None
            }
        })
        .States -> fact_registry.state_members(subject_name).map(fn(states) {
            build_state_infos_with_graph(subject_name, states, fact_registry.state_graph("{subject_name}.State"))
        })
        .Effects -> items.iter().find_map(fn(item) {
            if item == {
                .Func(function) if function.name == subject_name -> Val(build_effect_info(&function.declared_effects.as_ref().map(fn(effects) { effects.iter().map(fn((name, _)) { name.clone() }).collect<[String]>() }).unwrap_or_default()))
                _ -> None
            }
        })
        .Sendability | .Movedness | .Attribution | .Origin | .ViewProvenance | .UnitScaleProvenance | .Maturity | .Measure | .Exactness | .Classification | .Obligation -> registered_fact_value(read, subject_name, items)
        .RegisteredPlane(_) | .BuildProfile | .BuildPackageName | .BuildPackageVersion | .BuildOS | .BuildStampGit | .BuildStampDirty | .BuildStampToolchain | .BuildStampAt -> build_fact_value(build_facts, read).or_else(fn() { registered_fact_value(read, subject_name, items) })
        .Layout | .Name | .Fields -> reflect_type_fact_value_with_target_and_graph_and_facts(items, subject_name, "main", &TargetLayout.from_build_facts(build_facts), None, Val(fact_registry), read)
    }
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1992
fn fact_path(expr: &Expr) -> String? {
    if expr == {
        .ComptimeName { name, .. } | .Ident(name, _) -> Val(name.clone())
        .Field(base, member, _) -> Val("{fact_path(base)?}.{member}")
        _ -> None
    }
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2002
pub fn build_fact_value(snapshot: &BuildFactSnapshot, read: FactRead) -> CtValue? { build_fact_scalar(snapshot.value(read)?) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2012
pub fn build_setting_value(snapshot: &BuildFactSnapshot, key: String) -> CtValue? { build_fact_scalar(snapshot.setting(key)?.value.clone()) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2019
fn build_fact_scalar(value: BuildFactValue) -> CtValue? {
    if value == {
        .Text(value) -> Val(CtValue.Str(^value))
        .OptionalText(.Val(value)) -> Val(CtValue.Present(Box.new(CtValue.Str(^value))))
        .OptionalText(.None) -> Val(CtValue.absent(Type.String))
        .Bool(value) -> Val(CtValue.Bool(value))
        .Int(value) -> Val(CtValue.Int(value))
        .Char(value) -> Val(CtValue.Char(value))
        .Enum { type_name, variant } -> Val(CtValue.Enum { type_name: ^type_name, variant: ^variant, args: [] })
    }
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2039
fn transition_info(owner: String, method: &Func) -> CtValue? {
    transition :: method.state_transition.as_ref()?
    Val(ct_struct("TransitionInfo", &[
        ("operation", ct_str(method.name.clone())),
        ("from", build_state_ref(owner, transition.from.as_deref().unwrap_or("_"))),
        ("to", build_state_ref(owner, transition.to)),
    ]))
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2054
fn reflected_state_fact(owner: String, state: String) -> CtValue {
    path :: state_path(owner, state)
    value := fact_value("State", state, [path.clone()], None, None)
    if value == .Struct { fields, .. } {
        if fields.iter_mut().find(fn((name, _)) { name == "state" }) == .Val((_, field)) {
            field = CtValue.Present(Box.new(build_state_ref(owner, state)))
        }
    }
    fact_info("State", state, ^path, ^value)
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2067
fn reflected_facts(registry: &FactRegistry) -> [CtValue] {
    registry.iter().flat_map(fn(fact) {
        if fact.members.is_empty() {
            [fact_info(fact.kind.name(), fact.name, fact.name.clone(), fact_value(fact.kind.name(), fact.name, [], None, None))]
        } else {
            fact.members.iter().map(fn(member) {
                path :: "{fact.name}.{member}"
                fact_info(fact.kind.name(), member, path.clone(), fact_value(fact.kind.name(), member, [^path], None, None))
            }).collect<[CtValue]>()
        }
    }).collect()
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2103
pub fn build_struct_type_info(s: &StructDef) -> CtValue {
    states :: s.state.as_ref().map(fn(state) { state.states.iter().map(fn((name, _)) { name.clone() }).collect<[String]>() }).unwrap_or_default()
    build_struct_type_info_with_states(s, &states)
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2118
pub fn build_struct_type_info_with_states(s: &StructDef, states: &[String]) -> CtValue { build_struct_type_info_with_path(s, states, s.name) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2122
pub fn build_struct_type_info_with_path(s: &StructDef, states: &[String], path: String) -> CtValue { build_struct_type_info_with_path_and_vocabulary(s, states, path, None) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2129
pub fn build_struct_type_info_with_path_and_vocabulary(s: &StructDef, states: &[String], path: String, vocabulary: (&MarkerVocabulary)?) -> CtValue {
    // GATE #4483: TargetLayout.host must resolve selected-target facts, not compiler-host facts.
    engine :: TargetLayoutEngine.new([&Item]{}, TargetLayout.host())
    build_struct_type_info_with_path_and_vocabulary_and_engine(s, states, path, vocabulary, &engine)
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2141
pub fn build_struct_type_info_with_path_and_vocabulary_and_engine(s: &StructDef, states: &[String], path: String, vocabulary: (&MarkerVocabulary)?, layout_engine: &TargetLayoutEngine) -> CtValue {
    build_struct_type_info_with_path_and_vocabulary_and_engine_and_graph(s, states, path, vocabulary, layout_engine, None)
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2158
pub fn build_struct_type_info_with_path_and_vocabulary_and_engine_and_graph(s: &StructDef, states: &[String], path: String, vocabulary: (&MarkerVocabulary)?, layout_engine: &TargetLayoutEngine, graph: (&StateGraph)?) -> CtValue {
    reflection_fields :: Reflection.fields(s)
    fields_info :: reflection_fields.iter().map(fn(field) { build_reflection_field_info(field, vocabulary) }).collect<[CtValue]>()
    dimensions :: s.reflection_fields().flat_map(fn(field) { type_dimensions(&field.ty) }).collect<[CtValue]>()
    layout :: build_struct_layout_info_with_engine(s, layout_engine)
    methods_info :: s.methods.iter().map(fn(method) { build_method_info_with_vocabulary(method, vocabulary) }).collect<[CtValue]>()
    type_params_info :: s.type_params.iter().map(build_type_param_info).collect<[CtValue]>()
    state_info :: if build_state_infos_with_graph(s.name, states, graph) == { .List(rows) -> ^rows; _ -> panic("state info builder always returns a list") }
    transitions :: s.methods.iter().chain(s.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() })).filter_map(fn(method) { transition_info(s.name, method) }).collect<[CtValue]>()
    facts := states.iter().map(fn(state) { reflected_state_fact(s.name, state) }).collect<[CtValue]>()
    loop field in s.reflection_fields() { facts.extend(type_fact_rows("{s.name}.{field.name}", &field.ty)) }
    (markers, expanded_markers) :: type_level_marker_views_with_vocabulary(&s.type_markers, &s.serde_markers, &s.derives, vocabulary)
    ct_struct("TypeInfo", &[
        ("name", ct_str(s.name.clone())), ("path", ct_str(path)), ("layout", ^layout),
        ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(s.name_span.start as I64)), ("end", CtValue.Int(s.name_span.end as I64))])),
        ("fields", ct_list(^fields_info)), ("methods", ct_list(^methods_info)), ("type_params", ct_list(^type_params_info)),
        ("markers", ct_list(^markers)), ("expanded_markers", ct_list(^expanded_markers)), ("states", ct_list(^state_info)),
        ("transitions", ct_list(^transitions)), ("facts", ct_list(^facts)), ("dimensions", ct_list(^dimensions)),
        ("implements", ct_list(s.trait_impls.iter().map(fn(implementation) { ct_str(implementation.trait_name.clone()) }).collect())),
        ("trait_contracts", ct_list([])),
    ])
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2254
pub fn build_distinct_type_info(d: &DistinctDef, module: String) -> CtValue { build_distinct_type_info_with_path(d, module, "{module}.{d.name}") }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2259
pub fn build_distinct_type_info_with_path(d: &DistinctDef, module: String, path: String) -> CtValue {
    // GATE #4483: selected-target layout.
    engine :: TargetLayoutEngine.new([&Item]{}, TargetLayout.host())
    layout :: layout_info("default", "physical layout unspecified", "distinct declaration", engine.target(), [], &LayoutFacts { bytes: None, fields: [] }, None)
    dimensions :: d.quantity.as_ref().map(fn((dimension, _)) { [build_dimension_info(dimension)] }).unwrap_or_default()
    (markers, expanded_markers) :: type_level_marker_views(&d.type_markers, &[], &d.derives)
    qualify_info(ct_struct("TypeInfo", &[
        ("name", ct_str(d.name.clone())), ("layout", ^layout),
        ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(d.name_span.start as I64)), ("end", CtValue.Int(d.name_span.end as I64))])),
        ("fields", ct_list([])), ("methods", ct_list([])), ("type_params", ct_list([])),
        ("markers", ct_list(^markers)), ("expanded_markers", ct_list(^expanded_markers)), ("states", ct_list([])),
        ("transitions", ct_list([])), ("facts", ct_list(distinct_fact_rows(d))), ("dimensions", ct_list(^dimensions)),
        ("base", ct_str(d.base.name())), ("implements", ct_list([])), ("trait_contracts", ct_list([])),
    ]), module, d.name, "distinct", path)
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2316
fn append_trait_contracts_from_items(info: &CtValue, items: &[Item], owner: String, module: String, identity: String) {
    contracts :: trait_contracts_from_items(items, owner, module, identity)
    if info != .Struct { fields, .. } { return }
    {
        slot :: fields.iter_mut().find(fn((name, _)) { name == "trait_contracts" }) ?? return
        if slot.1 != .List(contract_values) { return }
        loop contract in contracts {
            trait_name :: if reflected_struct_field(&contract, "name") == { .Val(.Str(name)) -> name; _ -> continue }
            duplicate :: contract_values.iter().any(fn(existing) { if reflected_struct_field(existing, "name") == { .Val(.Str(name)) -> name == trait_name; _ -> false } })
            if !duplicate { contract_values.push(^contract) }
        }
    }
    contract_names :: fields.iter().find(fn((name, _)) { name == "trait_contracts" }).and_then(fn((_, value)) {
        if value == { .List(values) -> Val(values.iter().filter_map(fn(value) { if reflected_struct_field(value, "name") == { .Val(.Str(name)) -> Val(name.clone()); _ -> None } }).collect<[String]>()); _ -> None }
    }).unwrap_or_default()
    if fields.iter_mut().find(fn((name, _)) { name == "implements" }) == .Val((_, .List(implemented))) {
        loop name in contract_names {
            if !implemented.iter().any(fn(value) { if value == { .Str(existing) -> existing == name; _ -> false } }) { implemented.push(ct_str(^name)) }
        }
    }
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2379
fn trait_contracts_from_items(items: &[Item], owner: String, module: String, identity: String) -> [CtValue] {
    contracts := [CtValue]{}
    loop item in items {
        if item == {
            .Impl(implementation) if type_leaf(implementation.type_name) == owner -> {
                if implementation.trait_name == .Val(trait_name) { contracts.push(trait_contract_info(trait_name, &implementation.assoc_type_impls, &implementation.methods, module, identity)) }
            }
            .Struct(definition) if definition.name == owner -> {
                loop implementation in definition.trait_impls { contracts.push(trait_contract_info(implementation.trait_name, &implementation.assoc_type_impls, &implementation.methods, module, identity)) }
            }
            .Enum(definition) if definition.name == owner -> {
                loop implementation in definition.trait_impls { contracts.push(trait_contract_info(implementation.trait_name, &implementation.assoc_type_impls, &implementation.methods, module, identity)) }
            }
            .CodeModule(module_def) -> { if module_def.body == .Val(body) { contracts.extend(trait_contracts_from_items(body, owner, module, identity)) } }
            .GenericModule(module_def) -> contracts.extend(trait_contracts_from_items(&module_def.body, owner, module, identity))
            _ -> {}
        }
    }
    ^contracts
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2440
fn trait_contract_info(trait_name: String, associated_types: &[(String, Span, Type)], methods: &[Func], module: String, identity: String) -> CtValue {
    types :: associated_types.iter().map(fn((name, _, ty)) { ct_struct("AssociatedTypeInfo", &[("name", ct_str(name.clone())), ("type", ct_str(ty.name()))]) }).collect()
    method_rows :: methods.iter().map(fn(method) { qualified_method_info(method, module, identity) }).collect()
    ct_struct("TraitContractInfo", &[("name", ct_str(trait_name)), ("associated_types", ct_list(^types)), ("methods", ct_list(^method_rows))])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2470
fn type_leaf(name: String) -> String { name.rsplit_once('.').map_or(name, fn((_, leaf)) { leaf }) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2474
fn qualify_info(info: CtValue, module: String, identity: String, kind: String, path: String) -> CtValue {
    if info == .Struct { fields, .. } {
        if fields.iter_mut().find(fn((name, _)) { name == "path" }) == .Val((_, value)) { value = ct_str(path) }
        else { fields.push(("path", ct_str(path))) }
        fields.push(("module", ct_str(module)))
        fields.push(("identity", ct_str(identity)))
        fields.push(("kind", ct_str(kind)))
    }
    ^info
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2494
fn qualified_method_info(method: &Func, module: String, identity: String) -> CtValue {
    info := build_method_info(method)
    if info == .Struct { fields, .. } {
        fields.push(("module", ct_str(module)))
        fields.push(("identity", ct_str("{identity}.{method.name}")))
    }
    ^info
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2506
fn enum_payload_field_info(name: String, ty: &Type, span: Span, path: String, is_pub: Bool) -> CtValue {
    ct_struct("FieldInfo", &[
        ("name", ct_str(name)), ("ty", ct_str(ty.name())), ("markers", ct_list([])),
        ("dimensions", ct_list(type_dimensions(ty))), ("facts", ct_list(type_fact_rows(path, ty))), ("is_pub", ct_bool(is_pub)),
        ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(span.start as I64)), ("end", CtValue.Int(span.end as I64))])),
    ])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2536
fn enum_payload_fields(definition: &EnumDef, variant: &Variant) -> [CtValue] {
    if variant.payload == {
        .Unit -> []
        .Single(ty, span) -> [enum_payload_field_info("value", ty, span, "{definition.name}.{variant.name}", definition.is_pub)]
        .Named(fields) -> fields.iter().map(fn(field) { enum_payload_field_info(field.name.clone(), &field.ty, field.name_span, "{definition.name}.{variant.name}.{field.name}", definition.is_pub) }).collect()
    }
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2568
pub fn build_enum_type_info(e: &EnumDef) -> CtValue {
    // GATE #4483: selected-target layout.
    engine :: TargetLayoutEngine.new([&Item]{}, TargetLayout.host())
    build_enum_type_info_with_engine(e, "", e.name, e.name, &engine)
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2573
fn build_enum_type_info_with_engine(def: &EnumDef, module: String, identity: String, path: String, layout_engine: &TargetLayoutEngine) -> CtValue {
    layout :: build_enum_layout_info_with_engine(def, layout_engine)
    dimensions := [CtValue]{}
    facts := [CtValue]{}
    loop variant in def.variants {
        if variant.payload == {
            .Unit -> {}
            .Single(ty, _) -> { dimensions.extend(type_dimensions(ty)); facts.extend(type_fact_rows("{def.name}.{variant.name}", ty)) }
            .Named(fields) -> { loop field in fields { dimensions.extend(type_dimensions(&field.ty)); facts.extend(type_fact_rows("{def.name}.{variant.name}.{field.name}", &field.ty)) } }
        }
    }
    variants :: def.variants.iter().enumerate().map(fn((index, variant)) {
        ty :: if variant.payload == {
            .Unit -> "Unit"
            .Single(ty, _) -> ty.name()
            .Named(fields) -> "{{{fields.iter().map(fn(field) { "{field.name}: {field.ty.name()}" }).collect<[String]>().join(", ")}}}"
        }
        variant_dimensions :: if variant.payload == {
            .Unit -> []
            .Single(ty, _) -> type_dimensions(ty)
            .Named(fields) -> fields.iter().flat_map(fn(field) { type_dimensions(&field.ty) }).collect()
        }
        variant_facts :: if variant.payload == {
            .Unit -> []
            .Single(ty, _) -> type_fact_rows("{def.name}.{variant.name}", ty)
            .Named(fields) -> fields.iter().flat_map(fn(field) { type_fact_rows("{def.name}.{variant.name}.{field.name}", &field.ty) }).collect()
        }
        ct_struct("FieldInfo", &[
            ("name", ct_str(variant.name.clone())), ("ty", ct_str(^ty)), ("index", CtValue.Int(index as I64)),
            ("fields", ct_list(enum_payload_fields(def, variant))), ("markers", ct_list(marker_infos(&variant.serde_markers, None))),
            ("dimensions", ct_list(^variant_dimensions)), ("facts", ct_list(^variant_facts)), ("is_pub", ct_bool(def.is_pub)),
            ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(variant.name_span.start as I64)), ("end", CtValue.Int(variant.name_span.end as I64))])),
        ])
    }).collect()
    methods :: def.methods.iter().chain(def.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() })).map(fn(method) { qualified_method_info(method, module, identity) }).collect()
    params :: def.type_params.iter().map(build_type_param_info).collect()
    (markers, expanded_markers) :: type_level_marker_views(&def.type_markers, &def.serde_markers, &def.derives)
    transitions :: def.methods.iter().chain(def.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() })).filter_map(fn(method) { transition_info(def.name, method) }).collect()
    qualify_info(ct_struct("TypeInfo", &[
        ("name", ct_str(def.name.clone())), ("layout", ^layout),
        ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(def.name_span.start as I64)), ("end", CtValue.Int(def.name_span.end as I64))])),
        ("fields", ct_list(^variants)), ("methods", ct_list(^methods)), ("type_params", ct_list(^params)),
        ("markers", ct_list(^markers)), ("expanded_markers", ct_list(^expanded_markers)), ("states", ct_list([])),
        ("transitions", ct_list(^transitions)), ("facts", ct_list(^facts)), ("dimensions", ct_list(^dimensions)),
        ("implements", ct_list(def.trait_impls.iter().map(fn(implementation) { ct_str(implementation.trait_name.clone()) }).collect())),
        ("trait_contracts", ct_list([])),
    ]), module, identity, "enum", path)
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2742
fn ledger_path(ledger: &NameLedger, module: USize, module_name: String, symbol: String) -> String { ledger.canonical_path(module, symbol).unwrap_or_else(fn() { "{module_name}.{symbol}" }) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2753
fn ledger_module_name(ledger: &NameLedger, module: USize, fallback: String) -> String { ledger.module_alias(module).map(fn(name) { name.to_string() }).unwrap_or_else(fn() { fallback.to_string() }) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2766
pub fn build_program_info(bundle: &ProgramBundle, facts: &ProgramSemanticFacts) -> CtValue { build_program_info_with_index(bundle, facts, None) }

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:2777
pub fn build_program_info_with_index(bundle: &ProgramBundle, facts: &ProgramSemanticFacts, index: (&ProgramIndexView)?) -> CtValue {
    layout_engine :: TargetLayoutEngine.new(bundle.modules.iter().flat_map(fn(module) { module.items.iter() }), TargetLayout.from_build_facts(&bundle.build_facts))
    // GATE #4499: tuple keys retain structural equality/hash, not encoded strings.
    external_impls := [(String, String):([String], [CtValue], [CtValue])]{}
    loop (module_idx, module) in bundle.modules.iter().enumerate() {
        module_name :: ledger_module_name(&facts.name_ledger, module_idx, module.alias)
        loop item in module.items {
            if item == .Impl(implementation) {
                entry :: external_impls.entry((module_name.clone(), implementation.type_name.clone())).or_default()
                if implementation.trait_name == .Val(trait_name) { entry.0.push(trait_name.clone()) }
                entry.1.extend(implementation.methods.iter().map(fn(method) {
                    qualified_method_info(method, module_name, program_reflection_identity(&facts.name_ledger, module_idx, module_name, implementation.type_name))
                }))
                entry.2.extend(implementation.methods.iter().filter_map(fn(method) { transition_info(implementation.type_name, method) }))
            }
        }
    }
    types := [CtValue]{}
    functions := [CtValue]{}
    packages := [CtValue]{}
    loop (module_idx, module) in bundle.modules.iter().enumerate() {
        module_name :: ledger_module_name(&facts.name_ledger, module_idx, module.alias)
        package_types := [CtValue]{}
        package_functions := [CtValue]{}
        loop item in module.items {
            if item == {
                .Struct(def) -> {
                    states :: facts.fact_registry.state_members(def.name).map_or_else(fn() { [String]{} }, fn(states) { states.to_vec() })
                    state_graph :: facts.fact_registry.state_graph("{def.name}.State")
                    identity :: program_reflection_identity(&facts.name_ledger, module_idx, module_name, def.name)
                    info := qualify_info(build_struct_type_info_with_path_and_vocabulary_and_engine_and_graph(def, &states, def.name, None, &layout_engine, state_graph), module_name, identity, "struct", ledger_path(&facts.name_ledger, module_idx, module_name, def.name))
                    if info == .Struct { fields, .. } {
                        if fields.iter_mut().find(fn((name, _)) { name == "methods" }) == .Val((_, .List(methods))) {
                            methods = def.methods.iter().chain(def.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() })).map(fn(method) { qualified_method_info(method, module_name, identity) }).collect()
                        }
                        if fields.iter_mut().find(fn((name, _)) { name == "facts" }) == .Val((_, .List(values))) { values.extend(reflected_facts(&facts.fact_registry)) }
                    }
                    if external_impls.get(&(module_name.clone(), def.name.clone())) == .Val((traits, methods, transitions)) {
                        if info == .Struct { fields, .. } {
                            if fields.iter_mut().find(fn((name, _)) { name == "implements" }) == .Val((_, .List(values))) { values.extend(traits.iter().cloned().map(ct_str)) }
                            if fields.iter_mut().find(fn((name, _)) { name == "methods" }) == .Val((_, .List(values))) { values.extend(methods.iter().cloned()) }
                            if fields.iter_mut().find(fn((name, _)) { name == "transitions" }) == .Val((_, .List(values))) { values.extend(transitions.iter().cloned()) }
                        }
                    }
                    append_trait_contracts_from_items(&info, &module.items, def.name, module_name, identity)
                    types.push(info.clone())
                    package_types.push(^info)
                }
                .Enum(def) -> {
                    identity :: program_reflection_identity(&facts.name_ledger, module_idx, module_name, def.name)
                    info := build_enum_type_info_with_engine(def, module_name, identity, ledger_path(&facts.name_ledger, module_idx, module_name, def.name), &layout_engine)
                    if info == .Struct { fields, .. } {
                        if fields.iter_mut().find(fn((name, _)) { name == "facts" }) == .Val((_, .List(values))) { values.extend(reflected_facts(&facts.fact_registry)) }
                    }
                    if external_impls.get(&(module_name.clone(), def.name.clone())) == .Val((traits, methods, transitions)) {
                        if info == .Struct { fields, .. } {
                            if fields.iter_mut().find(fn((name, _)) { name == "implements" }) == .Val((_, .List(values))) { values.extend(traits.iter().cloned().map(ct_str)) }
                            if fields.iter_mut().find(fn((name, _)) { name == "methods" }) == .Val((_, .List(values))) { values.extend(methods.iter().cloned()) }
                            if fields.iter_mut().find(fn((name, _)) { name == "transitions" }) == .Val((_, .List(values))) { values.extend(transitions.iter().cloned()) }
                        }
                    }
                    append_trait_contracts_from_items(&info, &module.items, def.name, module_name, identity)
                    types.push(info.clone())
                    package_types.push(^info)
                }
                .Distinct(def) -> {
                    info := build_distinct_type_info_with_path(def, module_name, ledger_path(&facts.name_ledger, module_idx, module_name, def.name))
                    if info == .Struct { fields, .. } {
                        if fields.iter_mut().find(fn((name, _)) { name == "facts" }) == .Val((_, .List(values))) { values.extend(reflected_facts(&facts.fact_registry)) }
                    }
                    if external_impls.get(&(module_name.clone(), def.name.clone())) == .Val((traits, methods, transitions)) {
                        if info == .Struct { fields, .. } {
                            if fields.iter_mut().find(fn((name, _)) { name == "implements" }) == .Val((_, .List(values))) { values.extend(traits.iter().cloned().map(ct_str)) }
                            if fields.iter_mut().find(fn((name, _)) { name == "methods" }) == .Val((_, .List(values))) { values.extend(methods.iter().cloned()) }
                            if fields.iter_mut().find(fn((name, _)) { name == "transitions" }) == .Val((_, .List(values))) { values.extend(transitions.iter().cloned()) }
                        }
                    }
                    append_trait_contracts_from_items(&info, &module.items, def.name, module_name, program_reflection_identity(&facts.name_ledger, module_idx, module_name, def.name))
                    types.push(info.clone())
                    package_types.push(^info)
                }
                .Func(func) if func.name != "build" -> {
                    info :: build_function_info(func, module_idx, module_name, facts)
                    functions.push(info.clone())
                    package_functions.push(^info)
                }
                _ -> {}
            }
        }
        packages.push(ct_struct("PackageInfo", &[("name", ct_str(module_name.clone())), ("identity", ct_str(^module_name)), ("types", ct_list(^package_types)), ("functions", ct_list(^package_functions))]))
    }
    (definitions, references, call_edges, structural_nodes) :: index.map_or(([CtValue]{}, [CtValue]{}, [CtValue]{}, [CtValue]{}), fn(index) {
        (index.definitions(), index.references(), index.call_edges(), index.structural_nodes())
    })
    ct_struct(Syntax.TYPE_PROGRAM_INFO, &[
        ("packages", ct_list(^packages)), ("types", ct_list(^types)), ("functions", ct_list(^functions)),
        ("definitions", ct_list(^definitions)), ("references", ct_list(^references)), ("call_edges", ct_list(^call_edges)), ("structural_nodes", ct_list(^structural_nodes)),
    ])
}

// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:3071
fn build_function_info(func: &Func, module_idx: USize, module: String, facts: &ProgramSemanticFacts) -> CtValue {
    qualified :: program_reflection_identity(&facts.name_ledger, module_idx, module, func.name)
    effects :: facts.effects.get(qualified).cloned().unwrap_or_default()
    arithmetic :: facts.arithmetic.get(qualified).map(fn(rows) { rows.iter().map(arithmetic_operation_info).collect<[CtValue]>() }).unwrap_or_else(fn() { arithmetic_policy_facts(&func.body).iter().map(arithmetic_operation_info).collect() })
    declared_facts :: declared_function_facts(qualified, func.maturity, func.return_view_provenance.as_ref())
    ct_struct("FunctionInfo", &[
        ("name", ct_str(func.name.clone())), ("module", ct_str(module)), ("identity", ct_str(qualified.clone())),
        ("failure_contract", ct_str(func.failure_contract().effective_type().name())), ("failure_source", ct_str(func.failure_contract().source())),
        ("params", ct_list(func.params.iter().map(fn(param) { ct_str(param.name.clone()) }).collect())),
        ("span", ct_struct(Syntax.TYPE_SOURCE_SPAN, &[("start", CtValue.Int(func.name_span.start as I64)), ("end", CtValue.Int(func.name_span.end as I64))])),
        ("effects", ct_struct("EffectInfo", &[("values", ct_list(effects.into_iter().map(ct_str).collect()))])),
        ("reaches_panic", ct_bool(facts.reaches_panic.contains(qualified))), ("arithmetic", ct_list(^arithmetic)), ("facts", ct_list(^declared_facts)),
    ])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:3141
fn arithmetic_operation_info(fact: &ArithmeticPolicyFact) -> CtValue {
    ct_struct("ArithmeticOperationInfo", &[
        ("operation", ct_str(fact.operation.map_or("operation", ArithmeticOperation.as_str))),
        ("policy", ct_str(".{fact.mode.as_str()}")), ("operation_span", source_span_value(fact.operation_span)), ("scope_span", source_span_value(fact.scope_span)),
    ])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:3163
pub fn build_function_type_info(func: &Func) -> CtValue {
    info := build_function_info(func, 0, "", &ProgramSemanticFacts.default())
    if info == .Struct { fields, .. } {
        if fields.iter_mut().find(fn((name, _)) { name == "effects" }) == .Val((_, effects)) {
            declared :: func.declared_effects.as_ref().map(fn(effects) { effects.iter().map(fn((name, _)) { name.clone() }).collect<[String]>() }).unwrap_or_default()
            effects = build_effect_info(&declared)
        }
    }
    ^info
}
