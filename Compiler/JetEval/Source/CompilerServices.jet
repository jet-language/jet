// Source-owned front-end facts reusable by the compile-time Core services.
// The upstream inline-package source preparer must preserve original UTF-8 byte
// offsets. Missing preparation is not treated as unmodified-source success.
use jet_foundation.[
    DIAGNOSTIC_ERROR,
    DIAGNOSTIC_LINT,
    Diagnostic,
    Func,
    Item,
    ParseResult,
    Span,
    TComptimeField,
    TComptimeReport,
    TComptimeValue,
    Type,
    ast_program,
]
use jet_lexer.[
    Lexed,
    TOKEN_AMP,
    TOKEN_AMP_EQ,
    TOKEN_AND_AND,
    TOKEN_AT,
    TOKEN_BANG,
    TOKEN_BLOCK_COMMENT,
    TOKEN_BREAK,
    TOKEN_CARET,
    TOKEN_CARET_EQ,
    TOKEN_CHAR,
    TOKEN_COLON,
    TOKEN_COLON_COLON,
    TOKEN_COLON_EQ,
    TOKEN_COMMA,
    TOKEN_COMPARE,
    TOKEN_DOLLAR,
    TOKEN_DOT,
    TOKEN_DOT_DOT,
    TOKEN_DOT_DOT_DOT,
    TOKEN_DOT_DOT_LT,
    TOKEN_EOF,
    TOKEN_EQ,
    TOKEN_EQ_EQ,
    TOKEN_FALSE,
    TOKEN_FENCE_CLOSE,
    TOKEN_FENCE_OPEN,
    TOKEN_FLOAT,
    TOKEN_GE,
    TOKEN_GT,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_INT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_COPY,
    TOKEN_KW_DERIVE,
    TOKEN_KW_EFFECT,
    TOKEN_KW_ELSE,
    TOKEN_KW_ENUM,
    TOKEN_KW_EXTERN,
    TOKEN_KW_FN,
    TOKEN_KW_IF,
    TOKEN_KW_IMPL,
    TOKEN_KW_IN,
    TOKEN_KW_IT,
    TOKEN_KW_LOOP,
    TOKEN_KW_MODULE,
    TOKEN_KW_MOVE,
    TOKEN_KW_MUTATE,
    TOKEN_KW_PRIV,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_KW_TRAIT,
    TOKEN_KW_USE,
    TOKEN_KW_YIELD,
    TOKEN_LAMBDA_ARROW,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LE,
    TOKEN_LINE_COMMENT,
    TOKEN_LPAREN,
    TOKEN_LT,
    TOKEN_MINUS,
    TOKEN_MINUS_EQ,
    TOKEN_MINUS_MINUS,
    TOKEN_NOT_EQ,
    TOKEN_NULL,
    TOKEN_OR_OR,
    TOKEN_PERCENT,
    TOKEN_PERCENT_EQ,
    TOKEN_PERCENT_PERCENT,
    TOKEN_PERCENT_PERCENT_EQ,
    TOKEN_PIPE,
    TOKEN_PIPE_EQ,
    TOKEN_PLUS,
    TOKEN_PLUS_EQ,
    TOKEN_PLUS_PLUS,
    TOKEN_QUESTION,
    TOKEN_QUESTION_DOT,
    TOKEN_QUESTION_QUESTION,
    TOKEN_RAW_STRING,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RETURN,
    TOKEN_RPAREN,
    TOKEN_SELF,
    TOKEN_SEMI,
    TOKEN_SHL,
    TOKEN_SHL_EQ,
    TOKEN_SHR,
    TOKEN_SHR_EQ,
    TOKEN_SLASH,
    TOKEN_SLASH_EQ,
    TOKEN_SLASH_PERCENT,
    TOKEN_SLASH_PERCENT_EQ,
    TOKEN_STAR,
    TOKEN_STAR_EQ,
    TOKEN_STRING,
    TOKEN_TILDE,
    TOKEN_TILDE_PIPE,
    TOKEN_TILDE_PIPE_EQ,
