// Source-owned front-end facts reusable by the compile-time Core services.
// The upstream inline-package source preparer must preserve original UTF-8 byte
// offsets. Missing preparation is not treated as unmodified-source success.
use {
    jet_foundation.[
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        Diagnostic,
        Func,
        Item,
        ParseResult,
        Span,
        TComptimeField,
        TComptimeReport,
        TComptimeValue,
        Type,
        ast_program,
        type_name,
    ]
    jet_foundation.[TAppliedRule, TAppliedRuleArgumentMenu, TAppliedRuleCatalog, record_key_digest]
    jet_sema.[sema_compiler_identity, sema_comptime_reflection_type_info]
    jet_lexer.[
        Lexed,
        TOKEN_AMP,
        TOKEN_AMP_EQ,
        TOKEN_AND_AND,
        TOKEN_AT,
        TOKEN_BANG,
        TOKEN_BLOCK_COMMENT,
        TOKEN_BREAK,
        TOKEN_CARET,
        TOKEN_CARET_EQ,
        TOKEN_CHAR,
        TOKEN_COLON,
        TOKEN_COLON_COLON,
        TOKEN_COLON_EQ,
        TOKEN_COMMA,
        TOKEN_COMPARE,
        TOKEN_DOLLAR,
        TOKEN_DOT,
        TOKEN_DOT_DOT,
        TOKEN_DOT_DOT_DOT,
        TOKEN_DOT_DOT_LT,
        TOKEN_EOF,
        TOKEN_EQ,
        TOKEN_EQ_EQ,
        TOKEN_FALSE,
        TOKEN_FENCE_CLOSE,
        TOKEN_FENCE_OPEN,
        TOKEN_FLOAT,
        TOKEN_GE,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_CONST,
        TOKEN_KW_COPY,
        TOKEN_KW_DERIVE,
        TOKEN_KW_EFFECT,
        TOKEN_KW_ELSE,
        TOKEN_KW_ENUM,
        TOKEN_KW_EXTERN,
        TOKEN_KW_FN,
        TOKEN_KW_IF,
        TOKEN_KW_IMPL,
        TOKEN_KW_IN,
        TOKEN_KW_IT,
        TOKEN_KW_LOOP,
        TOKEN_KW_MODULE,
        TOKEN_KW_MOVE,
        TOKEN_KW_MUTATE,
        TOKEN_KW_PRIV,
        TOKEN_KW_PUB,
        TOKEN_KW_STRUCT,
        TOKEN_KW_TAG,
        TOKEN_KW_TRAIT,
        TOKEN_KW_USE,
        TOKEN_KW_YIELD,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LE,
        TOKEN_LINE_COMMENT,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_LT_GT,
        TOKEN_MINUS,
        TOKEN_MINUS_EQ,
        TOKEN_NOT_EQ,
        TOKEN_NULL,
        TOKEN_OR_OR,
        TOKEN_PERCENT,
        TOKEN_PERCENT_EQ,
        TOKEN_PERCENT_PERCENT,
        TOKEN_PERCENT_PERCENT_EQ,
        TOKEN_PIPE,
        TOKEN_PIPE_EQ,
        TOKEN_PIPE_GT,
        TOKEN_PLUS,
        TOKEN_PLUS_EQ,
        TOKEN_PLUS_PLUS,
        TOKEN_PREP,
        TOKEN_MINUS_MINUS,
        TOKEN_QUESTION,
        TOKEN_QUESTION_DOT,
        TOKEN_QUESTION_QUESTION,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RETURN,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SHL,
        TOKEN_SHL_EQ,
        TOKEN_SHR,
        TOKEN_SHR_EQ,
        TOKEN_SLASH,
        TOKEN_SLASH_EQ,
        TOKEN_SLASH_PERCENT,
        TOKEN_SLASH_PERCENT_EQ,
        TOKEN_STAR,
        TOKEN_STAR_EQ,
        TOKEN_STRING,
        TOKEN_TILDE,
        TOKEN_TILDE_PIPE,
        TOKEN_TILDE_PIPE_EQ,
        TOKEN_TILDE_TILDE,
        TOKEN_TRUE,
        TOKEN_UNIFIED_ARROW,
        TOKEN_UNIT_NUMBER,
        Token,
        TokenTables,
        lex,
        token_tables,
        token_text,
    ]
    jet_parser.[
        parse_lexed,
    ]
    jet_sema.[
        JET_CANONICAL_EFFECT_PACKAGE_IDENTITY,
        SemaCheckedForeignFunction,
        SemaCheckedForeignOwner,
        SemaCheckedForeignProvider,
        SemaCompilerModuleSource,
        SemaComptimeReflectionSource,
        SemaGraphModuleResult,
        SemaGraphResult,
        SemaRegistrationGraph,
        SemaRegistrationModule,
        SemaSourceSegment,
        SemaScopeMembersMarkerRegistry,
        sema_checked_foreign_basis_verified,
        sema_compiler_semantic_index_from_checked,
        sema_comptime_reflection_arithmetic_facts,
        sema_comptime_reflection_callable_signature,
        sema_comptime_reflection_declared_effect_names,
        sema_comptime_reflection_declared_function_facts,
        sema_comptime_reflection_doc_source,
        sema_comptime_reflection_documentation,
        sema_comptime_reflection_effect_info,
        sema_comptime_reflection_location,
        sema_comptime_reflection_module_of,
        sema_comptime_reflection_setting_infos,
        sema_comptime_reflection_source,
        sema_comptime_reflection_type_id_record,
        sema_comptime_reflection_written_comments,
        sema_comptime_reflection_written_markers,
        sema_module_is_core_source,
        sema_registration_module_index,
        sema_source_location_at,
        sema_type_graph_lookup_symbol_at,
        sema_type_lookup_nominal_row,
        sema_type_resolve_nominal_row_at,
    ]
}

JET_COMPILER_SERVICES_SCHEMA_VERSION: 1

JetCompilerServicesSourcePreparation: enum {
    Masked(source: String)
    Rejected(diagnostic: Diagnostic)
}

JetCompilerServicesSourceInput: struct {
    source: String
    preparation: JetCompilerServicesSourcePreparation?
}

JetCompilerServicesLexFacts: struct {
    source: String
    compiler_source: String
    lexed: Lexed
    value: TComptimeValue
}

JetCompilerServicesParseFacts: struct {
    source: String
    compiler_source: String
    lexed: Lexed
    parsed: ParseResult
    value: TComptimeValue
}

JetCompilerServicesCheckedInput: struct {
    parsed: JetCompilerServicesParseFacts
    registration: SemaRegistrationGraph
    graph: SemaGraphResult
    module_sources: [SemaCompilerModuleSource]
    diagnostics: [Diagnostic]
}

JetCompilerServicesCheckedFacts: struct {
    value: TComptimeValue
    semantic_index_complete: Bool
}

jet_eval_compiler_services_int: fn(value: Int) -> TComptimeValue Never! {
    TComptimeValue.Int{value: value}
}

jet_eval_compiler_services_string: fn(value: String) -> TComptimeValue Never! {
    TComptimeValue.String{value: value}
}

// `span` as a SourceSpan of the text of `file`. A text a query was given as a
// value (`compiler.lex`, `compiler.parse`) and a query's own call site name
// no file: their `file` is empty.
jet_eval_compiler_services_span: fn(span: Span, file: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "SourceSpan", fields: [TComptimeField]{
        TComptimeField{name: "file", value: jet_eval_compiler_services_string(file)},
        TComptimeField{name: "start", value: jet_eval_compiler_services_int(span.start)},
        TComptimeField{name: "end", value: jet_eval_compiler_services_int(span.end)},

    }}
}

jet_eval_compiler_services_option_string: fn(value: String?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: jet_eval_compiler_services_string(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.String}}
}

jet_eval_compiler_services_option_span: fn(value: Span?, file: String) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: jet_eval_compiler_services_span(item, file)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "SourceSpan"}}}
}

jet_eval_compiler_services_diagnostic_value: fn(diagnostic: Diagnostic) -> TComptimeValue Never! {
    severity := if diagnostic.severity == DIAGNOSTIC_LINT -> "lint" else -> "error"
    TComptimeValue.Struct{type_name: "CompilerDiagnostic", fields: [TComptimeField]{
        TComptimeField{name: "code", value: jet_eval_compiler_services_string(diagnostic.code)},
        TComptimeField{name: "severity", value: jet_eval_compiler_services_string(severity)},
        TComptimeField{name: "message", value: jet_eval_compiler_services_string(diagnostic.what)},
        TComptimeField{name: "why", value: jet_eval_compiler_services_string(diagnostic.why)},
        TComptimeField{name: "fix", value: jet_eval_compiler_services_string(diagnostic.fix)},
        TComptimeField{name: "span", value: jet_eval_compiler_services_option_span(diagnostic.span, diagnostic.source_path ?? "")},
    }}
}

jet_eval_compiler_services_diagnostic_values: fn(diagnostics: [Diagnostic]) -> TComptimeValue Never! {
    values := [TComptimeValue]{}
    loop diagnostic in diagnostics -> values.push(jet_eval_compiler_services_diagnostic_value(diagnostic))
    TComptimeValue.List{values: values}
}

jet_eval_compiler_services_token_kind: fn(kind: Int) -> String? {
    if kind == TOKEN_IDENT -> return Val("identifier")
    if kind == TOKEN_RAW_STRING -> return Val("literal.raw_string")
    if kind == TOKEN_STRING -> return Val("literal.string")
    if kind == TOKEN_INT -> return Val("literal.int")
    if kind == TOKEN_FLOAT -> return Val("literal.float")
    if kind == TOKEN_UNIT_NUMBER -> return Val("literal.unit_number")
    if kind == TOKEN_CHAR -> return Val("literal.char")
    if kind == TOKEN_TRUE -> return Val("literal.true")
    if kind == TOKEN_FALSE -> return Val("literal.false")
    if kind == TOKEN_SELF -> return Val("keyword.self")
    if kind == TOKEN_NULL -> return Val("literal.null")
    if kind == TOKEN_BREAK -> return Val("keyword.break")
    if kind == TOKEN_RETURN -> return Val("keyword.return")
    if kind == TOKEN_RPAREN -> return Val("punctuation.right_paren")
    if kind == TOKEN_RBRACKET -> return Val("punctuation.right_bracket")
    if kind == TOKEN_RBRACE -> return Val("punctuation.right_brace")
    if kind == TOKEN_QUESTION -> return Val("operator.try")
    if kind == TOKEN_PLUS_PLUS -> return Val("operator.plus_plus")
    if kind == TOKEN_MINUS_MINUS -> return Val("operator.minus_minus")
    if kind == TOKEN_GT -> return Val("operator.greater")
    if kind == TOKEN_SHR -> return Val("operator.shift_right")
    if kind == TOKEN_FENCE_CLOSE -> return Val("operator.fence_close")
    if kind == TOKEN_DOT -> return Val("punctuation.dot")
    if kind == TOKEN_QUESTION_DOT -> return Val("operator.optional_field")
    if kind == TOKEN_AND_AND -> return Val("operator.and")
    if kind == TOKEN_OR_OR -> return Val("operator.or")
    if kind == TOKEN_PLUS -> return Val("operator.add")
    if kind == TOKEN_MINUS -> return Val("operator.subtract")
    if kind == TOKEN_STAR -> return Val("operator.star")
    if kind == TOKEN_SLASH -> return Val("operator.divide")
    if kind == TOKEN_SLASH_PERCENT -> return Val("operator.floor_divide")
    if kind == TOKEN_PERCENT -> return Val("operator.modulo")
    if kind == TOKEN_PERCENT_PERCENT -> return Val("operator.remainder")
    if kind == TOKEN_EQ_EQ -> return Val("operator.equal")
    if kind == TOKEN_NOT_EQ -> return Val("operator.not_equal")
    if kind == TOKEN_LT -> return Val("operator.less")
    if kind == TOKEN_LE -> return Val("operator.less_equal")
    if kind == TOKEN_GE -> return Val("operator.greater_equal")
    if kind == TOKEN_COMPARE -> return Val("operator.compare")
    if kind == TOKEN_AMP -> return Val("operator.amp")
    if kind == TOKEN_PIPE -> return Val("operator.alternative")
    if kind == TOKEN_CARET -> return Val("operator.caret")
    if kind == TOKEN_TILDE_PIPE -> return Val("operator.tilde_pipe")
    if kind == TOKEN_SHL -> return Val("operator.shift_left")
    if kind == TOKEN_QUESTION_QUESTION -> return Val("operator.fallback")
    if kind == TOKEN_LBRACE -> return Val("punctuation.left_brace")
    if kind == TOKEN_LPAREN -> return Val("punctuation.left_paren")
    if kind == TOKEN_LBRACKET -> return Val("punctuation.left_bracket")
    if kind == TOKEN_EOF -> return Val("eof")
    if kind == TOKEN_BANG -> return Val("operator.not")
    if kind == TOKEN_UNIFIED_ARROW -> return Val("operator.unified_arrow")
    if kind == TOKEN_EQ -> return Val("operator.assign")
    if kind == TOKEN_LINE_COMMENT -> return Val("comment.line")
    if kind == TOKEN_BLOCK_COMMENT -> return Val("comment.block")
    if kind == TOKEN_KW_FN -> return Val("keyword.fn")
    if kind == TOKEN_KW_PUB -> return Val("keyword.pub")
    if kind == TOKEN_KW_PRIV -> return Val("keyword.priv")
    if kind == TOKEN_KW_IF -> return Val("keyword.if")
    if kind == TOKEN_KW_ELSE -> return Val("keyword.else")
    if kind == TOKEN_KW_IN -> return Val("keyword.in")
    if kind == TOKEN_KW_MUTATE -> return Val("keyword.mutate")
    if kind == TOKEN_KW_MOVE -> return Val("keyword.move")
    if kind == TOKEN_KW_COPY -> return Val("keyword.copy")
    if kind == TOKEN_KW_STRUCT -> return Val("keyword.struct")
    if kind == TOKEN_KW_ENUM -> return Val("keyword.enum")
    if kind == TOKEN_KW_IMPL -> return Val("keyword.impl")
    if kind == TOKEN_KW_TRAIT -> return Val("keyword.trait")
    if kind == TOKEN_KW_TAG -> return Val("keyword.tag")
    if kind == TOKEN_KW_EFFECT -> return Val("keyword.effect")
    if kind == TOKEN_KW_DERIVE -> return Val("keyword.derive")
    if kind == TOKEN_KW_IT -> return Val("keyword.it")
    if kind == TOKEN_KW_CONST -> return Val("keyword.const")
    if kind == TOKEN_PREP -> return Val("keyword.comptime")
    if kind == TOKEN_KW_LOOP -> return Val("keyword.loop")
    if kind == TOKEN_KW_YIELD -> return Val("keyword.yield")
    if kind == TOKEN_KW_USE -> return Val("keyword.use")
    if kind == TOKEN_KW_EXTERN -> return Val("keyword.extern")
    if kind == TOKEN_KW_MODULE -> return Val("keyword.module")
    if kind == TOKEN_FENCE_OPEN -> return Val("operator.fence_open")
    if kind == TOKEN_COLON -> return Val("punctuation.colon")
    if kind == TOKEN_COLON_COLON -> return Val("punctuation.colon_colon")
    if kind == TOKEN_COLON_EQ -> return Val("operator.bind_mutable")
    if kind == TOKEN_COMMA -> return Val("punctuation.comma")
    if kind == TOKEN_SEMI -> return Val("terminator")
    if kind == TOKEN_DOT_DOT -> return Val("operator.range")
    if kind == TOKEN_DOT_DOT_LT -> return Val("operator.range_exclusive")
    if kind == TOKEN_DOT_DOT_DOT -> return Val("operator.spread")
    if kind == TOKEN_AT -> return Val("punctuation.at")
    if kind == TOKEN_TILDE -> return Val("operator.tilde")
    if kind == TOKEN_TILDE_PIPE_EQ -> return Val("operator.tilde_pipe_assign")
    if kind == TOKEN_TILDE_TILDE -> return Val("operator.trait_attach")
    if kind == TOKEN_PLUS_EQ -> return Val("operator.add_assign")
    if kind == TOKEN_MINUS_EQ -> return Val("operator.subtract_assign")
    if kind == TOKEN_STAR_EQ -> return Val("operator.multiply_assign")
    if kind == TOKEN_SLASH_EQ -> return Val("operator.divide_assign")
    if kind == TOKEN_SLASH_PERCENT_EQ -> return Val("operator.floor_divide_assign")
    if kind == TOKEN_PERCENT_EQ -> return Val("operator.modulo_assign")
    if kind == TOKEN_PERCENT_PERCENT_EQ -> return Val("operator.remainder_assign")
    if kind == TOKEN_AMP_EQ -> return Val("operator.amp_assign")
    if kind == TOKEN_PIPE_EQ -> return Val("operator.bit_or_assign")
    if kind == TOKEN_CARET_EQ -> return Val("operator.caret_assign")
    if kind == TOKEN_SHL_EQ -> return Val("operator.shift_left_assign")
    if kind == TOKEN_SHR_EQ -> return Val("operator.shift_right_assign")
    if kind == TOKEN_HASH -> return Val("punctuation.hash")
    if kind == TOKEN_DOLLAR -> return Val("punctuation.dollar")
    if kind == TOKEN_PIPE_GT -> return Val("operator.pipe")
    if kind == TOKEN_LT_GT -> return Val("operator.pipe_value")
    None
}

jet_eval_compiler_services_string_values: fn(values: [String]) -> TComptimeValue Never! {
    output := [TComptimeValue]{}
    loop value in values -> output.push(jet_eval_compiler_services_string(value))
    TComptimeValue.List{values: output}
}

jet_eval_compiler_services_token_value: fn(tables: TokenTables, token: Token) -> TComptimeValue? {
    kind: jet_eval_compiler_services_token_kind(token.kind) ?? return None
    TComptimeValue.Struct{type_name: "CompilerToken", fields: [TComptimeField]{
        TComptimeField{name: "kind", value: jet_eval_compiler_services_string(kind)},
        TComptimeField{name: "text", value: jet_eval_compiler_services_string(token_text(tables, token))},
        TComptimeField{name: "span", value: jet_eval_compiler_services_span(token.span, "")},
    }}
}

jet_eval_compiler_services_lex_value: fn(source: String, lexed: Lexed) -> TComptimeValue? {
    tokens := [TComptimeValue]{}
    loop token in lexed.tokens {
        value: jet_eval_compiler_services_token_value(lexed.tables, token) ?? return None
        tokens.push(value)
    }
    TComptimeValue.Struct{type_name: "CompilerLexed", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(JET_COMPILER_SERVICES_SCHEMA_VERSION)},
        TComptimeField{name: "source", value: jet_eval_compiler_services_string(source)},
        TComptimeField{name: "tokens", value: TComptimeValue.List{values: tokens}},
        TComptimeField{name: "diagnostics", value: jet_eval_compiler_services_diagnostic_values(lexed.diagnostics)},
    }}
}

jet_eval_compiler_services_lex: fn(input: JetCompilerServicesSourceInput) -> JetCompilerServicesLexFacts? {
    preparation: input.preparation ?? return None
    compiler_source := ""
    lexed := Lexed{tokens: [Token]{}, tables: token_tables(), diagnostics: [Diagnostic]{}}
    if preparation == {
        .Masked(source) -> {
            compiler_source = source
            bytes := source.bytes()
            lexed = lex(bytes)
        }
        .Rejected(diagnostic) -> lexed.diagnostics.push(diagnostic.copy())
    }
    value: jet_eval_compiler_services_lex_value(input.source, lexed) ?? return None
    Val(JetCompilerServicesLexFacts{source: input.source, compiler_source: compiler_source, lexed: lexed, value: value})
}

jet_eval_compiler_services_syntax_node: fn(item: Item) -> TComptimeValue Never! {
    kind := ""
    name := String?{None}
    span := Span{start: 0, end: 0}
    if item == {
        .Func(value) -> {
            kind = "function"
            name = Val(value.name)
            span = value.name_span
        }
        .Struct(value) -> {
            kind = "struct"
            name = Val(value.name)
            span = value.name_span
        }
        .Enum(value) -> {
            kind = "enum"
            name = Val(value.name)
            span = value.name_span
        }
        .Distinct(value) -> {
            kind = "distinct"
            name = Val(value.name)
            span = value.name_span
        }
        .TypeAlias(value) -> {
            kind = "type_alias"
            name = Val(value.name)
            span = value.name_span
        }
        .UnitFamily(value) -> {
            kind = "unit_family"
            name = Val(value.family)
            span = value.family_span
        }
        .Trait(value) -> {
            kind = "trait"
            name = Val(value.name)
            span = value.name_span
        }
        .Tag(value) -> {
            kind = "tag"
            name = Val(value.name)
            span = value.name_span
        }
        .EffectDecl(value) -> {
            kind = "effect"
            name = Val(value.name)
            span = value.name_span
        }
        .Impl(value) -> {
            kind = "impl"
            name = Val(value.type_name)
            span = value.type_span
        }
        .Const(value) -> {
            kind = "const"
            name = Val(value.name)
            span = value.name_span
        }
        .Test(value) -> {
            kind = "test"
            name = value.name
            span = value.name_span
        }
        .ExternRust(value) -> {
            kind = "extern_rust"
            name = Val(value.crate_spec)
            span = value.span
        }
        .Module(value) -> {
            kind = "module"
            name = Val(value.name)
            span = value.name_span
        }
        .CModule(value) -> {
            kind = "c_module"
            name = Val(value.lib)
            span = value.path_span
        }
        .CodeModule(value) -> {
            kind = "code_module"
            name = Val(value.name)
            span = value.name_span
        }
        .ErrorConv(value) -> {
            kind = "error_conversion"
            name = Val("{value.from_ty} -> {value.to_ty}")
            span = value.from_span
        }
        .Migration(value) -> {
            kind = "migration"
            name = Val(value.type_name)
            span = value.type_span
        }
        .ProtocolDecl(value) -> {
            kind = "protocol"
            name = Val(value.name)
            span = value.name_span
        }
        .TemplateLoop(value) -> {
            kind = "template_loop"
            span = value.span
        }
        .GenericModule(value) -> {
            kind = "generic_module"
            name = Val(value.name)
            span = value.name_span
        }
        .ModuleAlias(value) -> {
            kind = "module_alias"
            name = Val(value.name)
            span = value.name_span
        }
        .MarkerDecl(value) -> {
            kind = "marker"
            name = Val(value.name)
            span = value.name_span
        }
        .FactDecl(value) -> {
            kind = "fact"
            name = Val(value.name)
            span = value.name_span
        }
    }
    TComptimeValue.Struct{type_name: "CompilerNode", fields: [TComptimeField]{
        TComptimeField{name: "kind", value: jet_eval_compiler_services_string(kind)},
        TComptimeField{name: "name", value: jet_eval_compiler_services_option_string(name)},
        TComptimeField{name: "span", value: jet_eval_compiler_services_span(span, "")},
    }}
}

jet_eval_compiler_services_syntax_value: fn(source: String, parsed: ParseResult) -> TComptimeValue Never! {
    items := [TComptimeValue]{}
    has_error := false
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> has_error = true
    }
    if !has_error {
        loop item in parsed.program.items -> items.push(jet_eval_compiler_services_syntax_node(item))
    }
    TComptimeValue.Struct{type_name: "CompilerSyntaxTree", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(JET_COMPILER_SERVICES_SCHEMA_VERSION)},
        TComptimeField{name: "source", value: jet_eval_compiler_services_string(source)},
        TComptimeField{name: "items", value: TComptimeValue.List{values: items}},
        TComptimeField{name: "diagnostics", value: jet_eval_compiler_services_diagnostic_values(parsed.diagnostics)},
    }}
}

jet_eval_compiler_services_parse: fn(input: JetCompilerServicesSourceInput) -> JetCompilerServicesParseFacts? {
    lex_facts: jet_eval_compiler_services_lex(input) ?? return None
    parsed := if {
        lex_facts.lexed.diagnostics.len() > 0 -> {
            ParseResult{program: ast_program(), diagnostics: lex_facts.lexed.diagnostics}
        }
        else -> parse_lexed(lex_facts.lexed.copy())
    }
    value := jet_eval_compiler_services_syntax_value(input.source, parsed)
    Val(JetCompilerServicesParseFacts{source: input.source, compiler_source: lex_facts.compiler_source, lexed: lex_facts.lexed, parsed: parsed, value: value})
}

// `package` is the identity of the package that declares the function, as
// the loader gives it; `module_index` is the row of its module in
// `registration`. `markers` are the function's written MarkerInfo rows
// (sema_comptime_reflection_written_markers); `source` is its module's text,
// read for the function's documentation.
jet_eval_compiler_services_function_info: fn(registration: SemaRegistrationGraph, module_index: Int, function: Func, source: SemaComptimeReflectionSource, checked_module: SemaGraphModuleResult?, function_key: String?, markers: [TComptimeValue]) -> TComptimeValue {
    registration_module: registration.modules[module_index]
    // The solved row, when the check solved this function (a failed check
    // leaves it None, read as not yet inferred).
    solved_effects := [String]?{None}
    reaches_panic := false
    if checked_module == .Val(checked) {
        if function_key == .Val(key) {
            loop checked_function in checked.functions {
                if checked_function.key != key -> next
                solved_effects = Val(checked_function.effects.solved)
                loop effect_name in checked_function.effects.solved {
                    if effect_name == "Panic" -> reaches_panic = true
                }
            }
        }
    }
    arithmetic := sema_comptime_reflection_arithmetic_facts(function, registration_module.source_file)
    identity := "{registration_module.module_name}.{function.name}"
    facts := sema_comptime_reflection_declared_function_facts(function, identity)
    TComptimeValue.Struct{type_name: "FunctionInfo", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(function.name)},
        TComptimeField{name: "module", value: jet_eval_compiler_services_string(registration_module.module_name)},
        TComptimeField{name: "identity", value: jet_eval_compiler_services_string(identity)},
        TComptimeField{name: "package", value: jet_eval_compiler_services_string(registration_module.package_identity)},
        TComptimeField{name: "signature", value: sema_comptime_reflection_callable_signature(registration, module_index, function, solved_effects, registration_module.source_file)},
        TComptimeField{name: "span", value: jet_eval_compiler_services_span(function.name_span, registration_module.source_file)},
        TComptimeField{name: "reaches_panic", value: TComptimeValue.Bool{value: reaches_panic}},
        TComptimeField{name: "arithmetic", value: TComptimeValue.List{values: arithmetic}},
        TComptimeField{name: "facts", value: TComptimeValue.List{values: facts}},
        TComptimeField{name: "markers", value: TComptimeValue.List{values: markers}},
        TComptimeField{name: "location", value: sema_comptime_reflection_location(registration_module.source_segments, sema_comptime_reflection_module_of(registration_module), Val(function.name_span))},
        TComptimeField{name: "documentation", value: TComptimeValue.List{values: sema_comptime_reflection_documentation(source, Val(function.name_span))}},
    }}
}

// The ForeignInfo of one checked foreign declaration: its Jet name, the
// symbol it links, its declaring module, language, library, calling
// convention and checked signature (each parameter's type and the return
// type), and the evidence its binding provider recorded. `providers` are the
// checked providers of the declaring module; only a C module's declaration
// has one. Evidence comes only from the provider's boundary record: one
// ForeignEvidence row per obligation, naming the checker, its basis and the
// assumptions it rests on, beside the target, the loaded artifact and the
// artifact coverage digest the record is bound to. A declaration is verified
// only when it has evidence and every row's basis verifies it
// (sema_checked_foreign_basis_verified); one with no boundary record has no
// evidence and is never verified. The span indexes the file it was written
// in (jet_eval_compiler_services_segment_span).
jet_eval_compiler_services_foreign_info: fn(function: SemaCheckedForeignFunction, providers: [SemaCheckedForeignProvider], segments: [SemaSourceSegment], file: String) -> TComptimeValue {
    params := [TComptimeValue]{}
    loop parameter in function.params -> params.push(jet_eval_compiler_services_string(type_name(parameter.ty)))
    returns := String?{None}
    if function.return_type == .Val(ty) -> returns = Val(type_name(ty))
    library := ""
    target := ""
    artifact := ""
    coverage := ""
    evidence := [TComptimeValue]{}
    verified := false
    if function.owner == SemaCheckedForeignOwner.CModule {
        loop provider in providers {
            if provider.module_identity != function.module_identity -> next
            library = provider.library.copy() // copy: the checked graph keeps its providers
            if provider.boundary == .Val(boundary) {
                target = boundary.target.copy() // copy: the checked graph keeps its providers
                artifact = boundary.loaded_artifact.copy() // copy: the checked graph keeps its providers
                coverage = boundary.artifact_coverage_digest.copy() // copy: the checked graph keeps its providers
                verified = boundary.obligations.len() > 0
                loop obligation in boundary.obligations {
                    checked: sema_checked_foreign_basis_verified(obligation.basis)
                    if !checked -> verified = false
                    evidence.push(TComptimeValue.Struct{type_name: "ForeignEvidence", fields: [TComptimeField]{
                        {name: "name", value: jet_eval_compiler_services_string(obligation.name)},
                        {name: "basis", value: jet_eval_compiler_services_string(obligation.basis)},
                        {name: "checker", value: jet_eval_compiler_services_string(obligation.checker)},
                        {name: "assumptions", value: jet_eval_compiler_services_string_values(obligation.assumptions)},
                        {name: "verified", value: TComptimeValue.Bool{value: checked}},
                    }})
                }
            }
            break
        }
    }
    TComptimeValue.Struct{type_name: "ForeignInfo", fields: [TComptimeField]{
        {name: "name", value: jet_eval_compiler_services_string(function.name)},
        {name: "symbol", value: jet_eval_compiler_services_string(function.symbol)},
        {name: "module", value: jet_eval_compiler_services_string(function.module_name)},
        {name: "language", value: jet_eval_compiler_services_string(function.language)},
        {name: "library", value: jet_eval_compiler_services_string(library)},
        {name: "abi", value: jet_eval_compiler_services_string(function.abi)},
        {name: "params", value: TComptimeValue.List{values: params}},
        {name: "returns", value: jet_eval_compiler_services_option_string(returns)},
        {name: "target", value: jet_eval_compiler_services_string(target)},
        {name: "artifact", value: jet_eval_compiler_services_string(artifact)},
        {name: "coverage", value: jet_eval_compiler_services_string(coverage)},
        {name: "evidence", value: TComptimeValue.List{values: evidence}},
        {name: "verified", value: TComptimeValue.Bool{value: verified}},
        {name: "span", value: jet_eval_compiler_services_segment_span(function.span, segments, file)},
    }}
}

// `span` of a module's text as a SourceSpan of the file it was written in. A
// module assembled from several files (a C binding's cache, its overlays and
// close adapters) indexes the assembly; the segment `span` falls in names
// that file and where in it the segment starts. A span no written segment
// holds indexes the module's `file` as given.
jet_eval_compiler_services_segment_span: fn(span: Span, segments: [SemaSourceSegment], file: String) -> TComptimeValue Never! {
    location: sema_source_location_at(segments, span) ?? return jet_eval_compiler_services_span(span, file)
    shift: location.source_start - location.aggregate_start
    jet_eval_compiler_services_span(Span{start: span.start + shift, end: span.end + shift}, location.source_path)
}

jet_eval_compiler_services_error_diagnostic: fn(diagnostic: Diagnostic) -> Bool Never! {
    diagnostic.severity == DIAGNOSTIC_ERROR
}

jet_eval_compiler_services_function_key: fn(function: Func, registration_module: SemaRegistrationModule) -> String? {
    loop registered in registration_module.functions {
        if registered.declaration.name == function.name && registered.declaration.name_span.start == function.name_span.start && registered.declaration.name_span.end == function.name_span.end {
            return Val(registered.symbol.id.key)
        }
    }
    None
}

// A module the compiler supplies, which no compiler-API view lists: a
// Core-source module (one a reflected record's layout loads beside the
// program) or a module of the canonical Prelude's error and effect
// declarations.
jet_eval_compiler_services_module_is_supplied: fn(module_row: SemaRegistrationModule) -> Bool Never! {
    sema_module_is_core_source(module_row.module_identity) || module_row.package_identity == JET_CANONICAL_EFFECT_PACKAGE_IDENTITY
}

// The checked source's own functions and their effects; a module the
// compiler supplies adds none.
jet_eval_compiler_services_checked: fn(input: JetCompilerServicesCheckedInput) -> JetCompilerServicesCheckedFacts {
    diagnostics := input.diagnostics
    functions := [TComptimeValue]{}
    effects := [TComptimeValue]{}
    catalog: TAppliedRuleCatalog{rows: [TAppliedRule]{}, argument_menus: [TAppliedRuleArgumentMenu]{}}
    loop (module_index, registration_module) in input.registration.modules {
        if jet_eval_compiler_services_module_is_supplied(registration_module) -> next
        module_text: sema_comptime_reflection_doc_source(registration_module.source, registration_module.source_file)
        checked_module := SemaGraphModuleResult?{None}
        loop candidate in input.graph.modules {
            if candidate.module_identity == registration_module.module_identity -> checked_module = Val(candidate)
        }
        registry := SemaScopeMembersMarkerRegistry?{None}
        loop item in registration_module.program.items {
            if item == .Func(function) {
                if function.name == "build" -> next
                function_key := jet_eval_compiler_services_function_key(function, registration_module)
                // A failed check leaves the registration incomplete, with no
                // marker registry; like the failed-check FunctionInfo
                // (JetDriver ComptimeCompiler.jet), its markers then read empty.
                markers: sema_comptime_reflection_written_markers(input.registration, registration_module.module_identity, registration_module.program, catalog, function.markers, registry) ?? [TComptimeValue]{}
                functions.push(jet_eval_compiler_services_function_info(input.registration, module_index, function, module_text, checked_module, function_key, markers))
            }
        }
        if checked_module == .Val(checked) {
            loop function in checked.functions {
                declared := [String]?{None}
                loop registered in registration_module.functions {
                    if registered.symbol.id.key == function.key -> declared = sema_comptime_reflection_declared_effect_names(registered.declaration)
                }
                effects.push(sema_comptime_reflection_effect_info(declared, Val(function.effects.solved)))
            }
        }
    }
    index := sema_compiler_semantic_index_from_checked(input.registration, input.graph, input.parsed.source, input.module_sources)
    has_errors := false
    loop diagnostic in diagnostics {
        if jet_eval_compiler_services_error_diagnostic(diagnostic) -> has_errors = true
    }
    semantic_index := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "CompilerSemanticIndex"}}}
    if !has_errors && index.complete -> semantic_index = TComptimeValue.Present{value: index.value}
    value := TComptimeValue.Struct{type_name: "CompilerChecked", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(JET_COMPILER_SERVICES_SCHEMA_VERSION)},
        TComptimeField{name: "source", value: jet_eval_compiler_services_string(input.parsed.source)},
        TComptimeField{name: "syntax", value: input.parsed.value},
        TComptimeField{name: "diagnostics", value: jet_eval_compiler_services_diagnostic_values(diagnostics)},
        TComptimeField{name: "functions", value: TComptimeValue.List{values: functions}},
        TComptimeField{name: "effects", value: TComptimeValue.List{values: effects}},
        TComptimeField{name: "semantic_index", value: semantic_index},
    }}
    JetCompilerServicesCheckedFacts{value: value, semantic_index_complete: !has_errors && index.complete}
}

// The build context's whole-program view, or the first producer fact it lacks.
JetCompilerServicesProgramInfo: enum {
    Ready(value: TComptimeValue)
    Missing(fact: String)
}

// The build context reads this immutable, fully checked whole-program view.
// Reuse the same TypeInfo, FunctionInfo and semantic-index producers as the
// compiler API; a missing producer fact refuses the snapshot and is named.
// `root_calls`, `root_types` and `scope_types`, which no source can spell:
// `root_calls` holds the CompilerCall of each checked call written in the
// root package's own source outside its `build` functions, an ambient
// call's callee being its name (`print`), in the order the checker met
// them; `meta.events(watch: .Calls{to: f}, …)` reads it.
// `root_types` holds a TypeId for each spelling the root module names a
// declared type by, bare (`Point`) or through its import (`geo.Point`),
// its `name` that spelling; `meta.find_type` reads it. `scope_types` holds
// one, its `name` bare, for each declared type a module the build makes
// sees, which shares the root module's namespace and imports nothing: a
// type of the root module or of its namespace, or one the prelude names
// bare; `meta.add_struct` writes its fields' types with it
// (jet_eval_compiler_services_type_names).
// `packages` holds one PackageInfo per package, its modules in load order,
// each listing every comment of its file; the built package's also lists
// its effective settings with their origins.
// `foreign` holds the ForeignInfo of every checked foreign declaration, in
// module order (jet_eval_compiler_services_foreign_info). The view is the
// program's own: a module the compiler supplies adds no row.
jet_eval_compiler_services_program_info: fn(registration: SemaRegistrationGraph, graph: SemaGraphResult, source: String, module_sources: [SemaCompilerModuleSource]) -> JetCompilerServicesProgramInfo {
    if !registration.complete -> return .Missing(fact: "the registration graph is incomplete")
    if !graph.complete -> return .Missing(fact: "the checked graph is incomplete")
    index: sema_compiler_semantic_index_from_checked(registration, graph, source, module_sources)
    if !index.complete -> return .Missing(fact: "semantic index: {index.missing}")
    catalog: TAppliedRuleCatalog{rows: [TAppliedRule]{}, argument_menus: [TAppliedRuleArgumentMenu]{}}
    types := [TComptimeValue]{}
    functions := [TComptimeValue]{}
    packages := [JetCompilerServicesPackageRows]{}
    foreign := [TComptimeValue]{}
    build_keys := [String]{}
    loop (module_index, module_row) in registration.modules {
        if jet_eval_compiler_services_module_is_supplied(module_row) -> next
        // Lexed whole: the ModuleInfo lists every comment, and each
        // FunctionInfo its documentation.
        module_text: sema_comptime_reflection_source(module_row.source, module_row.source_file)
        checked := SemaGraphModuleResult?{None}
        loop candidate in graph.modules { if candidate.module_identity == module_row.module_identity -> checked = Val(candidate) }
        if checked == None -> return .Missing(fact: "module `{module_row.module_identity}` has no checked result")
        module_types := [TComptimeValue]{}
        module_functions := [TComptimeValue]{}
        registry := SemaScopeMembersMarkerRegistry?{None}
        loop item in module_row.program.items {
            name := String?{None}
            if item == {
                .Struct(definition) -> name = Val(definition.name)
                .Enum(definition) -> name = Val(definition.name)
                .Distinct(definition) -> name = Val(definition.name)
                .Func(function) -> {
                    if function.name == "build" {
                        if jet_eval_compiler_services_function_key(function, module_row) == .Val(key) -> build_keys.push(key)
                        next
                    }
                    key: jet_eval_compiler_services_function_key(function, module_row) ?? return .Missing(fact: "function `{module_row.module_name}.{function.name}` is not registered")
                    markers: sema_comptime_reflection_written_markers(registration, module_row.module_identity, module_row.program, catalog, function.markers, registry) ?? return .Missing(fact: "module `{module_row.module_name}` has no marker registry")
                    value: jet_eval_compiler_services_function_info(registration, module_index, function, module_text, checked, Val(key), markers)
                    functions.push(value.copy())
                    module_functions.push(value)
                }
                .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
            if name == .Val(type_name) {
                value: sema_comptime_reflection_type_info(registration, module_row.module_identity, type_name, catalog, [Type]{}) ?? return .Missing(fact: "type `{module_row.module_name}.{type_name}` has no TypeInfo")
                types.push(value.copy())
                module_types.push(value)
            }
        }
        if checked == .Val(module_result) {
            loop function in module_result.foreign_functions -> foreign.push(jet_eval_compiler_services_foreign_info(function, module_result.foreign_providers, module_row.source_segments, module_row.source_file))
        }
        at := -1
        loop (row, package) in packages {
            if package.identity == module_row.package_identity -> at = row
        }
        if at < 0 {
            at = packages.len()
            packages.push(jet_eval_compiler_services_package_rows(registration, module_row))
        }
        packages[at].types.extend(module_types.copy())
        packages[at].functions.extend(module_functions.copy())
        // A file module carries no written markers; a code module's
        // ModuleInfo (in a marker body) lists its own.
        packages[at].modules.push(TComptimeValue.Struct{type_name: "ModuleInfo", fields: [TComptimeField]{
            {name: "name", value: jet_eval_compiler_services_string(module_row.module_name)},
            {name: "identity", value: jet_eval_compiler_services_string(module_row.module_name)},
            {name: "types", value: TComptimeValue.List{values: module_types}},
            {name: "functions", value: TComptimeValue.List{values: module_functions}},
            {name: "markers", value: TComptimeValue.List{values: [TComptimeValue]{}}},
            {name: "comments", value: TComptimeValue.List{values: sema_comptime_reflection_written_comments(module_text, module_row.source_segments)}},
        }})
    }
    package_values := [TComptimeValue]{}
    // Settings belong to the build, which takes them from the built package
    // alone; any other package lists none.
    settings: sema_comptime_reflection_setting_infos(registration, registration.build_facts.settings)
    loop package in packages {
        package_settings := [TComptimeValue]{}
        // copy: a loop body can't move a list every pass reads.
        if package.identity == registration.package_identity -> package_settings = settings.copy()
        package_values.push(TComptimeValue.Struct{type_name: "PackageInfo", fields: [TComptimeField]{
            {name: "name", value: jet_eval_compiler_services_string(package.name)},
            {name: "identity", value: jet_eval_compiler_services_string(package.identity)},
            {name: "version", value: jet_eval_compiler_services_string(package.version)},
            {name: "modules", value: TComptimeValue.List{values: package.modules}},
            {name: "types", value: TComptimeValue.List{values: package.types}},
            {name: "functions", value: TComptimeValue.List{values: package.functions}},
            {name: "settings", value: TComptimeValue.List{values: package_settings}},
        }})
    }
    // The revision is the content hash of the checked sources: each module's
    // identity and text, in load order.
    revision_fields := [String]{}
    loop module_source in module_sources {
        revision_fields.push(module_source.module_identity.copy())
        revision_fields.push(module_source.source.copy())
    }
    type_names: jet_eval_compiler_services_type_names(registration)
    fields := [TComptimeField]{
        {name: "types", value: TComptimeValue.List{values: types}},
        {name: "functions", value: TComptimeValue.List{values: functions}},
        {name: "packages", value: TComptimeValue.List{values: package_values}},
        {name: "revision", value: jet_eval_compiler_services_string(record_key_digest(revision_fields))},
        {name: "foreign", value: TComptimeValue.List{values: foreign}},
        {name: "root_calls", value: TComptimeValue.List{values: jet_eval_compiler_services_root_calls(registration, graph, build_keys)}},
        {name: "root_types", value: TComptimeValue.List{values: type_names.root}},
        {name: "scope_types", value: TComptimeValue.List{values: type_names.scope}},
    }
    if index.value == .Struct(_, index_fields) {
        loop name in ([String]{"definitions", "references", "calls", "structural_nodes"}) {
            value := TComptimeValue?{None}
            loop field in index_fields { if field.name == name -> value = Val(field.value) }
            fields.push(TComptimeField{name: if name == "calls" -> "call_edges" else -> name, value: value ?? return .Missing(fact: "the semantic index has no `{name}`")})
        }
    } else { return .Missing(fact: "the semantic index is not a struct") }
    .Ready(value: TComptimeValue.Struct{type_name: "ProgramInfo", fields: fields})
}

jet_eval_compiler_services_root_calls: fn(registration: SemaRegistrationGraph, graph: SemaGraphResult, build_keys: [String]) -> [TComptimeValue] {
    calls := [TComptimeValue]{}
    loop module_row in registration.modules {
        if module_row.package_identity != registration.package_identity -> next
        loop checked in graph.modules {
            if checked.module_identity != module_row.module_identity -> next
            loop call in checked.call_facts {
                if build_keys.contains(call.caller_key) -> next
                callee := call.intrinsic_api.copy() // copy: the checked graph keeps its call facts
                if call.callee == .Val(id) -> callee = Val(id.key.copy()) // copy: the checked graph keeps its call facts
                name: callee ?? next
                calls.push(TComptimeValue.Struct{type_name: "CompilerCall", fields: [TComptimeField]{
                    {name: "caller", value: jet_eval_compiler_services_string(sema_compiler_identity(registration, call.caller_key))},
                    {name: "callee", value: jet_eval_compiler_services_string(sema_compiler_identity(registration, name))},
                    {name: "module", value: jet_eval_compiler_services_string(checked.module_path)},
                    {name: "span", value: jet_eval_compiler_services_span(call.span, module_row.source_file)},
                }})
            }
        }
    }
    calls
}

JetCompilerServicesTypeNames: struct {
    root: [TComptimeValue]
    scope: [TComptimeValue]
}

// ProgramInfo's `root_types` and `scope_types`. A type's identity is its
// module and name, as TypeId.identity spells it. A root spelling is one the
// checker resolves from the root module to that very type.
jet_eval_compiler_services_type_names: fn(registration: SemaRegistrationGraph) -> JetCompilerServicesTypeNames {
    names := JetCompilerServicesTypeNames{root: [TComptimeValue]{}, scope: [TComptimeValue]{}}
    root: sema_registration_module_index(registration, registration.entry_module_identity) ?? return names
    namespace: registration.modules[root].namespace
    aliases := [String]{}
    loop import in registration.modules[root].program.imports {
        if import.alias != "" && !aliases.contains(import.alias) -> aliases.push(import.alias.copy())
    }
    loop (module_index, module_row) in registration.modules {
        loop (row, nominal) in module_row.nominals {
            name: nominal.symbol.name
            identity: "{module_row.module_name}.{name}"
            spellings := [String]{name.copy()}
            loop alias in aliases -> spellings.push("{alias}.{name}")
            loop spelling in spellings {
                found: sema_type_resolve_nominal_row_at(registration, Type.Named{name: spelling}, root) ?? next
                if found.module_index == module_index && found.row == row -> names.root.push(sema_comptime_reflection_type_id_record(identity.copy(), spelling.copy()))
            }
            if module_index == root || (namespace != "" && module_row.namespace == namespace) {
                names.scope.push(sema_comptime_reflection_type_id_record(identity, name.copy()))
                next
            }
            // The prelude's bare names, read from no module's scope.
            bare: sema_type_graph_lookup_symbol_at(registration, -1, name) ?? next
            found: sema_type_lookup_nominal_row(registration, Val(bare), name, -1) ?? next
            if found.module_index == module_index && found.row == row -> names.scope.push(sema_comptime_reflection_type_id_record(identity, name.copy()))
        }
    }
    names
}

// The whole-program view of a build no body can read (no source outside
// Core spells `program` or `compiler`): ProgramInfo's fields, every one
// empty, so the build skips the snapshot.
jet_eval_compiler_services_program_unread: fn() -> TComptimeValue Never! {
    fields := [TComptimeField]{}
    loop name in ([String]{"types", "functions", "packages", "foreign", "root_calls", "root_types", "scope_types", "definitions", "references", "call_edges", "structural_nodes"}) {
        fields.push(TComptimeField{name: name, value: TComptimeValue.List{values: [TComptimeValue]{}}})
    }
    TComptimeValue.Struct{type_name: "ProgramInfo", fields: fields}
}

// One package of ProgramInfo while its modules are gathered.
JetCompilerServicesPackageRows: struct {
    identity: String
    name: String
    version: String
    modules: [TComptimeValue]
    types: [TComptimeValue]
    functions: [TComptimeValue]
}

// The package `module_row` belongs to, with no modules yet. The entry
// package is named by the build facts (a source without a manifest takes
// its file's name there); another package by the manifest the loader read,
// and a package without one (a Core source) by its module.
jet_eval_compiler_services_package_rows: fn(registration: SemaRegistrationGraph, module_row: SemaRegistrationModule) -> JetCompilerServicesPackageRows Never! {
    entry: module_row.package_identity == registration.package_identity
    name: if {
        entry -> registration.build_facts.package_name.copy()
        module_row.package.name != "" -> module_row.package.name.copy()
        else -> module_row.module_name.copy()
    }
    version: if entry -> registration.build_facts.package_version.copy() else -> module_row.package.version.copy()
    JetCompilerServicesPackageRows{identity: module_row.package_identity.copy(), name: name, version: version, modules: [TComptimeValue]{}, types: [TComptimeValue]{}, functions: [TComptimeValue]{}}
}
// Package and build call sites must consume Jetpack's typed host query result;
// this helper deliberately defines no package view, lock/profile, or graph facts.
// A package query carrier must preserve the pinned-root authority, checked-read
// provenance, and per-view success versus typed-error state. A graph query must
// accept only a BuildPlan handle from the active build session and return the
// canonical checked BuildGraph projection; receipt_diff stays source-owned by
// Core/Build and must consume those exact typed graph values.

// One `// jet:line <n>` marker of generated Rust: its 1-based line, the
// source the nearest `// jet:source-map source=` marker above it opened, and
// the source line it names.
JetCompilerServicesGeneratedLine: struct {
    generated_line: Int
    source: String?
    source_line: Int
}

// `SourceMap`: every opened source once, in first-seen order.
JetCompilerServicesSourceMap: struct {
    sources: [String]
    generated_lines: [JetCompilerServicesGeneratedLine]
}

// Rust `str::trim_start` over ASCII whitespace.
jet_eval_compiler_services_trim_start: fn(line: String) -> String Never! {
    bytes: line.bytes()
    start := 0
    loop start < bytes.len() {
        code: Int.from_u8(bytes[start])
        if code != 32 && code != 9 && code != 10 && code != 11 && code != 12 && code != 13 -> break
        start += 1
    }
    line.slice(start..<line.len())
}

// A Rust `usize` parse: ASCII digits after an optional `+`.
jet_eval_compiler_services_count: fn(text: String) -> Int? Never! {
    bytes: text.bytes()
    start := 0
    if bytes.len() > 0 && bytes[0] == (U8{43}) -> start = 1
    if start >= bytes.len() -> return None
    value := 0
    loop index in start..<bytes.len() {
        digit: Int.from_u8(bytes[index]) - 48
        if digit < 0 || digit > 9 -> return None
        value = value * 10 + digit
    }
    Val(value)
}

// `source_map_from_generated_rust`: the one reader of generated Rust markers,
// for `jet inspect compiler source-map` and `core.compiler.source_map`. Lines
// split as Rust `str::lines` does.
jet_eval_compiler_services_source_map: fn(rust_source: String) -> JetCompilerServicesSourceMap Never! {
    sources := [String]{}
    current := String?{None}
    lines := [JetCompilerServicesGeneratedLine]{}
    raw_lines := rust_source.split("\n").to_list()
    if rust_source.ends_with("\n") -> _ := raw_lines.pop()
    loop (index, raw) in raw_lines {
        raw_bytes: raw.bytes()
        carriage: raw_bytes.len() > 0 && Int.from_u8(raw_bytes[raw_bytes.len() - 1]) == 13
        line: if carriage -> raw.slice(0..<(raw.len() - 1)) else -> raw
        trimmed: jet_eval_compiler_services_trim_start(line)
        source_marker: "// jet:source-map source="
        if trimmed.starts_with(source_marker) {
            source: trimmed.slice(source_marker.len()..<trimmed.len())
            current = Val(source)
            if !sources.contains(source) -> sources.push(source)
            next
        }
        line_marker: "// jet:line "
        if trimmed.starts_with(line_marker) {
            number: jet_eval_compiler_services_count(trimmed.slice(line_marker.len()..<trimmed.len()).trim()) ?? next
            lines.push(JetCompilerServicesGeneratedLine{generated_line: index + 1, source: current.copy(), source_line: number})
        }
    }
    JetCompilerServicesSourceMap{sources: sources, generated_lines: lines}
}

// `source_map_value`: the `CompilerSourceMap` comptime value.
jet_eval_compiler_services_source_map_value: fn(map: JetCompilerServicesSourceMap) -> TComptimeValue Never! {
    lines := [TComptimeValue]{}
    loop line in map.generated_lines {
        lines.push(TComptimeValue.Struct{type_name: "CompilerGeneratedLine", fields: [TComptimeField]{
            TComptimeField{name: "generated_line", value: jet_eval_compiler_services_int(line.generated_line)},
            TComptimeField{name: "source", value: jet_eval_compiler_services_option_string(line.source)},
            TComptimeField{name: "source_line", value: jet_eval_compiler_services_int(line.source_line)},
        }})
    }
    TComptimeValue.Struct{type_name: "CompilerSourceMap", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(JET_COMPILER_SERVICES_SCHEMA_VERSION)},
        TComptimeField{name: "sources", value: jet_eval_compiler_services_string_values(map.sources)},
        TComptimeField{name: "generated_lines", value: TComptimeValue.List{values: lines}},
    }}
}
