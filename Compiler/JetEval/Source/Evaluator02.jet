pub type AmbientMirHandle = fn(String, I64?, [MirRuntimeValue], Span) -> (AmbientMirHandleResult Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:160
pub enum AmbientMirPreludeResult {
    Value(MirRuntimeValue)
    Effect { value: MirRuntimeValue, stdout: [U8], stderr: [U8] }
    Control { value: MirRuntimeValue, stdout: [U8], stderr: [U8], exit_code: I32 }
