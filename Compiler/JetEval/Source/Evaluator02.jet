// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:179
pub type AmbientMirPreludeCall = fn(&MirPreludeCall, [MirRuntimeValue], MirType?, Span) -> (AmbientMirPreludeResult Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:192
pub struct AmbientMirExternWriteback { pub parameter: USize, pub value: MirRuntimeValue }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:204
pub struct AmbientMirExternResult { pub value: MirRuntimeValue, pub writebacks: [AmbientMirExternWriteback] }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:213
pub type AmbientMirExternCall = fn(&MirForeign, [MirRuntimeValue], Span) -> (AmbientMirExternResult Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:218
pub type AmbientWorkerContext = Arc<dyn Any + Send + Sync>
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:221
pub struct AmbientRuntimeSnapshot {
    core_call: AmbientCoreCall? = None
    core_closure_call: AmbientCoreClosureCall? = None
    handle: AmbientHandle? = None
    extern_call: AmbientExternCall? = None
    mir_handle_call: AmbientMirHandle? = None
    mir_extern_call: AmbientMirExternCall? = None
    mir_prelude_call: AmbientMirPreludeCall? = None
    worker_context: AmbientWorkerContext? = None
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:231
// GATE #4494: actual thread-local cells, refcells, Arc/downcast and Drop unwind restoration.
CORE_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientCoreCall?{None}) })
CORE_CLOSURE_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientCoreClosureCall?{None}) })
HANDLE :: ThreadLocal.new(fn() { Cell.new(AmbientHandle?{None}) })
EXTERN_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientExternCall?{None}) })
MIR_HANDLE_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientMirHandle?{None}) })
MIR_EXTERN_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientMirExternCall?{None}) })
MIR_PRELUDE_CALL :: ThreadLocal.new(fn() { Cell.new(AmbientMirPreludeCall?{None}) })
WORKER_CONTEXT :: ThreadLocal.new(fn() { RefCell.new(AmbientWorkerContext?{None}) })
PACKAGE_READ_CONTEXT :: ThreadLocal.new(fn() { RefCell.new(PackageReadContext?{None}) })
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:242
struct AmbientHooksGuard { core_call: AmbientCoreCall?, handle: AmbientHandle?, extern_call: AmbientExternCall? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:249
impl Drop for AmbientHooksGuard {
    fn drop(self: &AmbientHooksGuard) -> Unit Never! {
        CORE_CALL.with(fn(slot) { slot.set(self.core_call) })
        HANDLE.with(fn(slot) { slot.set(self.handle) })
        EXTERN_CALL.with(fn(slot) { slot.set(self.extern_call) })
    }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:255
struct AmbientWorkerContextGuard { previous: AmbientWorkerContext? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:258
impl Drop for AmbientWorkerContextGuard {
    fn drop(self: &AmbientWorkerContextGuard) -> Unit Never! { WORKER_CONTEXT.with(fn(slot) { _ :: slot.replace(self.previous.take()) }) }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:265
pub fn with_ambient_worker_context<R>(context: AmbientWorkerContext?, body: fn() -> R) -> R Never! {
    previous :: WORKER_CONTEXT.with(fn(slot) { slot.replace(^context) })
    _guard :: AmbientWorkerContextGuard(previous: ^previous)
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:274
pub fn ambient_worker_context<T: Any + Send + Sync>() -> Arc<T>? Never! {
    WORKER_CONTEXT.with(fn(slot) { slot.borrow().clone() }).and_then(fn(context) { Arc.downcast<T>(^context).ok() })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:280
struct PackageReadContext { root: OSPath, inputs: [ComptimeInput] }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:290
pub fn with_package_read_context<R>(root: &OSPath, body: fn() -> R) -> (R, [ComptimeInput]) Never! {
    previous :: PACKAGE_READ_CONTEXT.with(fn(slot) { slot.replace(Val(PackageReadContext(root: root.clone(), inputs: []))) })
    result :: body()
    current :: PACKAGE_READ_CONTEXT.with(fn(slot) { slot.replace(^previous) })
    inputs :: if current == { .Val(context) -> ^context.inputs; .None -> [] }
    PACKAGE_READ_CONTEXT.with(fn(slot) {
        parent_slot := slot.borrow_mut()
        if parent_slot.as_mut() == {
            .Val(parent) -> {
                for input in &inputs {
                    if !parent.inputs.iter().any(fn(existing) { existing.path == input.path }) -> parent.inputs.push(input.clone())
                }
            }
            .None -> {}
        }
    })
    (result, ^inputs)
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:322
pub fn package_read_root() -> OSPath? Never! {
    PACKAGE_READ_CONTEXT.with(fn(slot) { slot.borrow().as_ref().map(fn(context) { context.root.clone() }) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:329
pub fn record_package_input(path: String, hash: String) -> Unit Never! {
    PACKAGE_READ_CONTEXT.with(fn(slot) {
        context_slot := slot.borrow_mut()
        if context_slot.as_mut() == {
            .Val(context) -> {
                input :: ComptimeInput(path: ^path, hash: ^hash)
                if !context.inputs.iter().any(fn(existing) { existing.path == input.path }) -> context.inputs.push(^input)
            }
            .None -> {}
        }
    })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:351
pub fn with_ambient<R>(core_call: AmbientCoreCall?, handle: AmbientHandle?, extern_call: AmbientExternCall?, body: fn() -> R) -> R Never! {
    _previous :: AmbientHooksGuard(
        core_call: CORE_CALL.with(fn(slot) { slot.replace(core_call) }),
        handle: HANDLE.with(fn(slot) { slot.replace(handle) }),
        extern_call: EXTERN_CALL.with(fn(slot) { slot.replace(extern_call) }))
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:365
struct AmbientCoreClosureGuard { previous: AmbientCoreClosureCall? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:368
impl Drop for AmbientCoreClosureGuard {
    fn drop(self: &AmbientCoreClosureGuard) -> Unit Never! { CORE_CLOSURE_CALL.with(fn(slot) { slot.set(self.previous) }) }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:374
pub fn with_ambient_core_closure<R>(core_closure_call: AmbientCoreClosureCall?, body: fn() -> R) -> R Never! {
    _previous :: AmbientCoreClosureGuard(previous: CORE_CLOSURE_CALL.with(fn(slot) { slot.replace(core_closure_call) }))
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:384
pub fn try_ambient_core_closure(module: String, method: String, call: MirPreludeCallId, kind: MirCoreClosureKind,
    args: [MirRuntimeValue], closure: MirRuntimeValue?, site: MirSiteId, label: String, span: Span
) -> (MirRuntimeValue Diagnostic!)? Never! {
    CORE_CLOSURE_CALL.with(fn(slot) { slot.get().and_then(fn(hook) { hook(module, method, call, kind, ^args, ^closure, site, label, span) }) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:404
struct AmbientMirExternGuard { previous: AmbientMirExternCall? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:407
impl Drop for AmbientMirExternGuard {
    fn drop(self: &AmbientMirExternGuard) -> Unit Never! { MIR_EXTERN_CALL.with(fn(slot) { slot.set(self.previous) }) }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:415
pub fn with_ambient_mir_extern<R>(mir_extern_call: AmbientMirExternCall?, body: fn() -> R) -> R Never! {
    _previous :: AmbientMirExternGuard(previous: MIR_EXTERN_CALL.with(fn(slot) { slot.replace(mir_extern_call) }))
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:423
struct AmbientMirPreludeGuard { previous: AmbientMirPreludeCall? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:426
impl Drop for AmbientMirPreludeGuard {
    fn drop(self: &AmbientMirPreludeGuard) -> Unit Never! { MIR_PRELUDE_CALL.with(fn(slot) { slot.set(self.previous) }) }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:432
pub fn with_ambient_mir_prelude<R>(mir_prelude_call: AmbientMirPreludeCall?, body: fn() -> R) -> R Never! {
    _previous :: AmbientMirPreludeGuard(previous: MIR_PRELUDE_CALL.with(fn(slot) { slot.replace(mir_prelude_call) }))
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:442
pub fn try_ambient_mir_prelude(row: &MirPreludeCall, args: [MirRuntimeValue], result_ty: MirType?, span: Span) -> (AmbientMirPreludeResult Diagnostic!)? Never! {
    MIR_PRELUDE_CALL.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(row, ^args, ^result_ty, span) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:454
pub fn ambient_mir_prelude_hook() -> AmbientMirPreludeCall? Never! { MIR_PRELUDE_CALL.with(fn(slot) { slot.get() }) }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:458
struct AmbientMirHandleGuard { previous: AmbientMirHandle? }
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:461
impl Drop for AmbientMirHandleGuard {
    fn drop(self: &AmbientMirHandleGuard) -> Unit Never! { MIR_HANDLE_CALL.with(fn(slot) { slot.set(self.previous) }) }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:467
pub fn with_ambient_mir_handle<R>(mir_handle: AmbientMirHandle?, body: fn() -> R) -> R Never! {
    _previous :: AmbientMirHandleGuard(previous: MIR_HANDLE_CALL.with(fn(slot) { slot.replace(mir_handle) }))
    body()
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:477
pub fn try_ambient_mir_handle(operation: String, handle: I64?, args: [MirRuntimeValue], span: Span) -> (AmbientMirHandleResult Diagnostic!)? Never! {
    MIR_HANDLE_CALL.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(operation, handle, ^args, span) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:490
pub fn ambient_runtime_snapshot() -> AmbientRuntimeSnapshot Never! {
    AmbientRuntimeSnapshot(core_call: CORE_CALL.with(fn(slot) { slot.get() }),
        core_closure_call: CORE_CLOSURE_CALL.with(fn(slot) { slot.get() }),
        handle: HANDLE.with(fn(slot) { slot.get() }), extern_call: EXTERN_CALL.with(fn(slot) { slot.get() }),
        mir_handle_call: MIR_HANDLE_CALL.with(fn(slot) { slot.get() }),
        mir_extern_call: MIR_EXTERN_CALL.with(fn(slot) { slot.get() }),
        mir_prelude_call: MIR_PRELUDE_CALL.with(fn(slot) { slot.get() }),
        worker_context: WORKER_CONTEXT.with(fn(slot) { slot.borrow().clone() }))
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:503
pub fn with_ambient_runtime_snapshot<R>(snapshot: AmbientRuntimeSnapshot, body: fn() -> R) -> R Never! {
    with_ambient(snapshot.core_call, snapshot.handle, snapshot.extern_call, fn() {
        with_ambient_core_closure(snapshot.core_closure_call, fn() {
            with_ambient_mir_handle(snapshot.mir_handle_call, fn() {
                with_ambient_mir_extern(snapshot.mir_extern_call, fn() {
                    with_ambient_mir_prelude(snapshot.mir_prelude_call, fn() {
                        with_ambient_worker_context(^snapshot.worker_context, ^body)
                    })
                })
            })
        })
    })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:526
pub fn ambient_hooks() -> (AmbientCoreCall?, AmbientHandle?, AmbientExternCall?) Never! {
    (CORE_CALL.with(fn(slot) { slot.get() }), HANDLE.with(fn(slot) { slot.get() }), EXTERN_CALL.with(fn(slot) { slot.get() }))
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:538
pub fn try_core_call(module: String, method: String, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? Never! {
    try_core_call_typed(module, method, ^args, span, None)
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:547
pub fn try_core_call_typed(module: String, method: String, args: [CtValue], span: Span, resolved_ret: Type?) -> (CtValue Diagnostic!)? Never! {
    try_core_call_typed_with_sink(module, method, ^args, span, ^resolved_ret, None)
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:557
pub fn try_core_call_typed_with_sink(module: String, method: String, args: [CtValue], span: Span, resolved_ret: Type?, sink: &DevSink?) -> (CtValue Diagnostic!)? Never! {
    CORE_CALL.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(module, method, ^args, span, ^resolved_ret, sink) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:570
pub fn try_handle(op: String, recv: &CtValue, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? Never! {
    HANDLE.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(op, recv, args, span) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:581
pub fn try_extern_call(wrapper: String, args: [CtValue], span: Span, resolved_ret: Type?) -> (CtValue Diagnostic!)? Never! {
    EXTERN_CALL.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(wrapper, ^args, span, ^resolved_ret) })
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:594
pub fn try_mir_extern_call(foreign: &MirForeign, args: [MirRuntimeValue], span: Span) -> (AmbientMirExternResult Diagnostic!)? Never! {
    MIR_EXTERN_CALL.with(fn(slot) { slot.get() }).and_then(fn(hook) { hook(foreign, ^args, span) })
}
