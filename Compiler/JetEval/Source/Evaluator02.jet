// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:21
pub type AmbientCoreCall = fn(String, String, [CtValue], Span, Type?, &DevSink?) -> (CtValue Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:34
pub type AmbientCoreClosureCall = fn(String, String, MirPreludeCallId, MirCoreClosureKind, [MirRuntimeValue], MirRuntimeValue?, MirSiteId, String, Span) -> (MirRuntimeValue Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:45
pub type AmbientHandle = fn(String, &CtValue, &[CtValue], Span) -> (CtValue Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:47
pub type AmbientExternCall = fn(String, [CtValue], Span, Type?) -> (CtValue Diagnostic!)?
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:53
pub trait StandaloneClosureHost: Send + Sync {
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:54
    fn invoke(self: &Self, args: [CtValue], span: Span) -> CtValue Diagnostic!
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:59
    fn invoke_mut(self: &Self, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
        self.invoke(args.clone(), span)
    }
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:69
    fn history_callback_identity(self: &Self) -> String Err!
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:73
pub struct AmbientStandaloneClosure { host: Arc<dyn StandaloneClosureHost> }
impl AmbientStandaloneClosure {
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:76
    pub fn new<T: StandaloneClosureHost>(host: T) -> AmbientStandaloneClosure Never! {
        AmbientStandaloneClosure(host: Arc.new(^host))
    }
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:83
    pub fn invoke(self: &AmbientStandaloneClosure, args: [CtValue], span: Span) -> CtValue Diagnostic! {
        self.host.invoke(^args, span)
    }
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:91
    pub fn invoke_mut(self: &AmbientStandaloneClosure, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
        self.host.invoke_mut(args, span)
    }
    // Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:98
    pub fn history_callback_identity(self: &AmbientStandaloneClosure) -> String Err! { self.host.history_callback_identity() }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:106
pub fn try_ambient_standalone_closure(closure: &CtValue, args: [CtValue], span: Span) -> (CtValue Diagnostic!)? Never! {
    if closure == {
        .Closure(data) -> {
            host :: data.opaque.as_ref()?.downcast_ref<AmbientStandaloneClosure>()?
            Val(host.invoke(^args, span))
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:121
pub fn try_ambient_standalone_closure_mut(closure: &CtValue, args: &[CtValue], span: Span) -> (CtValue Diagnostic!)? Never! {
    if closure == {
        .Closure(data) -> {
            host :: data.opaque.as_ref()?.downcast_ref<AmbientStandaloneClosure>()?
            Val(host.invoke_mut(args, span))
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/AmbientRuntime.rs:139
pub enum AmbientMirHandleResult { Value(MirRuntimeValue), Handle(I64) }
