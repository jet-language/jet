// MIR operation semantics. This file owns pure scalar/aggregate behavior and
// checked frame/place access; registered Core/Prelude routes live in Routes.
use jet_foundation.[
    MIRAccess,
    MIRBinaryOp,
    MIRBlockID,
    MIRCallArg,
    MIRFieldID,
    MIRFunction,
    MIRFunctionID,
    MIRIndexKind,
    MIRLocalID,
    MIRMapEntry,
    MIRMeasure,
    MIRPanicLoc,
    MIRPreludeCallID,
    MIRPayloadKind,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRProjection,
    MIRStringPart,
    MIRSharedSite,
    MIRSharedLifetime,
    MIRType,
    MIRTypeKind,
    MIRUnaryOp,
    MIRValueID,
    Span,
    TComptimeEnumArg,
    TComptimeField,
    TComptimeMapEntry,
    TComptimeReport,
    TComptimeValue,
    mir_measure_literal_value,
    mir_type_from_kind,
    mir_source_file_id,
]
use jet_sema.[
    sema_checked_const_char,
]

// Lookups borrow machine.program through the machine's row maps
// (jet_eval_program_rows): only the selected row, or field, is copied out.
fn jet_eval_function_row(machine: JetEvalMachine, id: MIRFunctionID) -> Int? {
    machine.rows.functions.get(id.value)
}

fn jet_eval_find_function(machine: JetEvalMachine, id: MIRFunctionID) -> MIRFunction? {
    row :: jet_eval_function_row(machine, id) ?? return None
    Val(machine.program.functions[row])
}

// Fill one function's id rows on its first lookup (see JetEvalFunctionRows).
fn jet_eval_function_rows_ready(machine: &JetEvalMachine, function: Int) {
    if machine.rows.function_rows[function].built -> return
    blocks := [U64:Int]{}
    loop index in 0..<machine.program.functions[function].blocks.len() {
        key :: machine.program.functions[function].blocks[index].id.value
        if blocks.get(key) == None -> blocks[key] = index
    }
    places := [U64:Int]{}
    loop index in 0..<machine.program.functions[function].places.len() {
        key :: machine.program.functions[function].places[index].id.value
        if places.get(key) == None -> places[key] = index
    }
    values := [U64:Int]{}
    values_next := [Int]{}
    values_tail := [U64:Int]{}
    loop index in 0..<machine.program.functions[function].values.len() {
        key :: machine.program.functions[function].values[index].id.value
        &values_next.push(-1)
        tail := values_tail.get(key) ?? -1
        if tail >= 0 -> values_next[tail] = index
        if tail < 0 -> values[key] = index
        values_tail[key] = index
    }
    locals := [U64:Int]{}
    locals_next := [Int]{}
    locals_tail := [U64:Int]{}
    loop index in 0..<machine.program.functions[function].locals.len() {
        key :: machine.program.functions[function].locals[index].id.value
        &locals_next.push(-1)
        tail := locals_tail.get(key) ?? -1
        if tail >= 0 -> locals_next[tail] = index
        if tail < 0 -> locals[key] = index
        locals_tail[key] = index
    }
    machine.rows.function_rows[function] = JetEvalFunctionRows{built: true, blocks: blocks, places: places, values: values, values_next: values_next, locals: locals, locals_next: locals_next}
}

fn jet_eval_function_block_row(machine: &JetEvalMachine, function: Int, id: MIRBlockID) -> Int? {
    jet_eval_function_rows_ready(&machine, function)
    machine.rows.function_rows[function].blocks.get(id.value)
}

fn jet_eval_function_place(machine: &JetEvalMachine, function: Int, id: MIRPlaceID) -> MIRPlace? {
    jet_eval_function_rows_ready(&machine, function)
    row :: machine.rows.function_rows[function].places.get(id.value) ?? return None
    Val(machine.program.functions[function].places[row])
}

// First row of an SSA value fact in `function`.
fn jet_eval_function_value_row(machine: &JetEvalMachine, function: Int, id: MIRValueID) -> Int? {
    jet_eval_function_rows_ready(&machine, function)
    machine.rows.function_rows[function].values.get(id.value)
}

// Last row of an SSA value fact in `function`.
fn jet_eval_function_value_last_row(machine: &JetEvalMachine, function: Int, id: MIRValueID) -> Int? {
    row := jet_eval_function_value_row(&machine, function, id) ?? return None
    loop machine.rows.function_rows[function].values_next[row] >= 0 {
        row = machine.rows.function_rows[function].values_next[row]
    }
    Val(row)
}

// First row of a local in `function`; `locals_next` chains its later rows.
fn jet_eval_function_local_row(machine: &JetEvalMachine, function: Int, id: MIRLocalID) -> Int? {
    jet_eval_function_rows_ready(&machine, function)
    machine.rows.function_rows[function].locals.get(id.value)
}

// Last row of a local in `function`.
fn jet_eval_function_local_last_row(machine: &JetEvalMachine, function: Int, id: MIRLocalID) -> Int? {
    row := jet_eval_function_local_row(&machine, function, id) ?? return None
    loop machine.rows.function_rows[function].locals_next[row] >= 0 {
        row = machine.rows.function_rows[function].locals_next[row]
    }
    Val(row)
}

// Read a shared capture cell: the payload snapshot is copied, so the caller
// owns one alias of every reference inside the result.
fn jet_eval_shared_read(machine: &JetEvalMachine, index: Int, span: Span) -> JetEvalRuntimeValue? {
    if !jet_eval_shared_cell_live(&machine, index, span) -> return None
    payload :: jet_eval_shared_cell_read_payload(machine, index) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR shared capture cell is unavailable")
        return None
    }
    jet_eval_copy_value(payload, &machine, span)
}

// Consumes the replacement on every path. A false result can follow a committed
// swap if disposing the previous payload fails; that payload is discharged
// exactly once.
fn jet_eval_shared_write(machine: &JetEvalMachine, index: Int, access: MIRAccess, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if access != MIRAccess.Write {
        jet_eval_ownership_fail(&machine, span, "MIR write uses a read-only shared capture cell")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    if jet_eval_runtime_contains_address(value) {
        jet_eval_ownership_fail(&machine, span, "MIR shared write cannot publish a stack address")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    previous :: jet_eval_shared_cell_swap_payload(&machine, index, value, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    jet_eval_drop_value(&machine, previous, span)
}

fn jet_eval_field_name(machine: JetEvalMachine, id: MIRFieldID) -> String? {
    row :: machine.rows.fields.get(id.value) ?? return None
    Val(machine.program.fields[row].field.name)
}

fn jet_eval_static(machine: &JetEvalMachine, name: String, span: Span) -> JetEvalRuntimeValue? {
    if machine.config.globals.get(name) == .Val(provided) -> return Val(JetEvalRuntimeValue.Data{value: provided})
    row :: machine.rows.constants.get(name) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR global `{name}` is not provided by the evaluation")
        return None
    }
    // copy: the constant value (owner: the machine) is handed to jet_eval_constant_runtime /
    // jet_eval_global_shared beside `&machine`; a view into machine would be live across that
    // exclusive borrow (E0212), and the machine keeps its own row.
    constant :: machine.program.constants[row].value.copy()
    if constant == .SharedSite(site) {
        // copy: the constant type (owner: the machine) is handed to jet_eval_global_shared beside
        // `&machine`; a view into machine would be live across that exclusive borrow (E0212), and
        // the machine keeps its own row.
        ty :: machine.program.constants[row].ty.copy()
        return jet_eval_global_shared(&machine, site, ty, span)
    }
    jet_eval_constant_runtime(constant, &machine, span)
}

fn jet_eval_global_shared(machine: &JetEvalMachine, site: MIRSharedSite, ty: MIRType, span: Span) -> JetEvalRuntimeValue? {
    if machine.config.runtime_execution {
        // The adapter admits the factory's expected namespace/schema against
        // the parent's pinned Core image before invoking its canonical getter.
        return jet_eval_host_target_exchange(&machine, JetEvalHostCallTarget.SharedSite{site: site, ty: ty},
            [JetEvalRuntimeValue]{}, Val(ty), [JetEvalHostTypeShape]{}, [Bool]{}, None, span)
    }
    cached := JetEvalRuntimeValue?{None}
    if true {
        permit :: machine.registry.storage.guard_read()
        loop entry in permit.value.comptime_shared_sites {
            if entry.site.initializer == site.initializer {
                if entry.site.lifetime != site.lifetime -> panic("checked initializer has inconsistent publication lifetime")
                cached = Val(entry.value)
                break
            }
        }
    }
    if cached == .Val(winner) -> return jet_eval_copy_value(winner, &machine, span)
    candidate :: jet_eval_invoke(&machine, site.initializer, [JetEvalRuntimeValue]{}, [JetEvalRuntimeValue]{}, span) ?? return None
    shared :: if candidate == {
        .Shared(_) -> true
        else -> false
    }
    if !shared -> panic("checked publication initializer did not return Shared")
    selected := candidate
    won := true
    if true {
        permit :: machine.registry.storage.guard_edit()
        loop entry in permit.value.comptime_shared_sites {
            if entry.site.initializer == site.initializer {
                if entry.site.lifetime != site.lifetime -> panic("checked initializer has inconsistent publication lifetime")
                selected = entry.value
                won = false
                break
            }
        }
        if won -> &permit.value.comptime_shared_sites.push(JetEvalComptimeSharedSiteEntry{site: site, value: candidate})
    }
    if !won && !jet_eval_drop_value(&machine, candidate, span) -> return None
    jet_eval_copy_value(selected, &machine, span)
}

fn jet_eval_pop_comptime_shared_site(machine: &JetEvalMachine) -> JetEvalComptimeSharedSiteEntry? Never! {
    permit :: machine.registry.storage.guard_edit()
    &permit.value.comptime_shared_sites.pop()
}

fn jet_eval_retire_comptime_shared_sites(machine: &JetEvalMachine, span: Span) -> Bool {
    ok := true
    loop {
        retired :: jet_eval_pop_comptime_shared_site(&machine) ?? break
        if !jet_eval_drop_value(&machine, retired.value, span) -> ok = false
    }
    ok
}

// Ordinary Source unit attempts retire after their callbacks, frames and guards.
// World and Thread boundaries belong to the host/native runtime, never a session.
fn jet_eval_native_attempt_reset(machine: &JetEvalMachine, span: Span) -> Bool {
    result :: jet_eval_host_target_exchange(&machine,
        JetEvalHostCallTarget.SharedSiteReset{lifetime: MIRSharedLifetime.Attempt},
        [JetEvalRuntimeValue]{}, None, [JetEvalHostTypeShape]{}, [Bool]{}, None, span) ?? return false
    if result != (JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) -> panic("native Attempt reset returned a value")
    true
}

fn jet_eval_field(value: JetEvalRuntimeValue, field: MIRFieldID, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    name :: jet_eval_field_name(machine, field) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR field ID is missing")
        return None
    }
    if value == .Aggregate(aggregate) {
        if aggregate == .Struct(_, fields) {
            loop item in fields {
                if item.name == name -> return Val(item.value)
            }
        }
        jet_eval_compiler_fail(&machine, span, "MIR field is not present in the runtime aggregate")
        return None
    }
    data :: jet_eval_data(value, &machine, span) ?? return None
    result :: jet_eval_find_field(data, name) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR field `{name}` is not present")
        return None
    }
    Val(JetEvalRuntimeValue.Data{value: result})
}

fn jet_eval_fixed_backing_index(machine: &JetEvalMachine, value: JetEvalRuntimeValue, location: MIRPanicLoc, span: Span) -> Int? {
    _ := jet_eval_route_source_path(&machine, location.file, span) ?? return None
    data :: jet_eval_data(value, &machine, span) ?? return None
    if data == {
        .Int(index) -> return Val(index)
        .BigInt(decimal) -> {
            index :: Int.parse(decimal) ?? {
                jet_eval_source_fail(&machine, span, "index exceeds host range")
                return None
            }
            return Val(index)
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR FixedListProof index is not an integer")
            return None
        }
    }
}
fn jet_eval_fixed_list_position(machine: &JetEvalMachine, value: JetEvalRuntimeValue, location: MIRPanicLoc, length: Int, span: Span) -> Int? {
    index :: jet_eval_fixed_backing_index(&machine, value, location, span) ?? return None
    jet_eval_list_position(&machine, index, length, span)
}

fn jet_eval_list_position(machine: &JetEvalMachine, index: Int, length: Int, span: Span) -> Int? {
    if index < 0 || index >= length {
        jet_eval_source_fail(&machine, span, "the list has {length} items, so position {index} doesn't exist")
        return None
    }
    Val(index)
}

fn jet_eval_index(value: JetEvalRuntimeValue, index: JetEvalRuntimeValue, kind: MIRIndexKind, location: MIRPanicLoc, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if value == .ForeignHandle(_, _, token) {
        token_kind :: jet_eval_foreign_token_kind(machine, token) ?? return None
        if token_kind == .FixedBackingRoot(_, _) {
            if kind != MIRIndexKind.FixedListProof {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed backing root was indexed without its checked FixedListProof kind")
                return None
            }
            // Native MIR place reads form an `as_array()` view before
            // `jet_index_vec_ref`; preserve its all-slots-ready-before-bounds
            // ordering rather than reading a single backing slot here.
            root :: jet_eval_fixed_backing_storage(&machine, value, span) ?? return None
            array :: jet_eval_fixed_backing_array(&machine, value, false, span) ?? return None
            position :: jet_eval_fixed_list_position(&machine, index, location, root.length, span) ?? return None
            if array == .Aggregate(aggregate) {
                if aggregate == .List(values) -> return Val(values[position])
            }
            jet_eval_compiler_fail(&machine, span, "MIR Fixed backing array materialization is not a runtime list")
            return None
        }
    }
    if kind == MIRIndexKind.FixedListProof {
        if value == .Aggregate(aggregate) {
            if aggregate == .List(values) {
                if jet_eval_runtime_contains_moved(value) {
                    jet_eval_source_fail(&machine, span, "fixed list read before every element was initialized")
                    return None
                }
                position :: jet_eval_fixed_list_position(&machine, index, location, values.len(), span) ?? return None
                return Val(values[position])
            }
        }
        if value == .Data(data) {
            if data == {
                .List(values) -> {
                    position :: jet_eval_fixed_list_position(&machine, index, location, values.len(), span) ?? return None
                    return Val(JetEvalRuntimeValue.Data{value: values[position]})
                }
                .Bytes(values) -> {
                    position :: jet_eval_fixed_list_position(&machine, index, location, values.len(), span) ?? return None
                    return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: Int.from_u8(values[position])}})
                }
                else -> {}
            }
        }
    }
    index_data :: jet_eval_data(index, &machine, span) ?? return None
    if value == .Aggregate(aggregate) {
        if aggregate == {
            .Map(entries) -> {
                key :: jet_eval_data_key(index_data, &machine, span) ?? return None
                loop entry in entries {
                    entry_key :: jet_eval_data(entry.key, &machine, span) ?? return None
                    entry_key_data :: jet_eval_data_key(entry_key, &machine, span) ?? return None
                    if entry_key_data == key -> return Val(entry.value)
                }
                jet_eval_source_fail(&machine, span, "MIR map key is absent")
                return None
            }
            .List(values) -> {
                index_value :: jet_eval_int(JetEvalRuntimeValue.Data{value: index_data}, &machine, span) ?? return None
                _ := jet_eval_list_position(&machine, index_value, values.len(), span) ?? return None
                return Val(values[index_value])
            }
            else -> {}
        }
    }
    data :: jet_eval_data(value, &machine, span) ?? return None
    if data == .Map(entries) {
        key :: jet_eval_data_key(index_data, &machine, span) ?? return None
        loop entry in entries {
            if entry.key == key -> return Val(JetEvalRuntimeValue.Data{value: entry.value})
        }
        jet_eval_source_fail(&machine, span, "MIR map key is absent")
        return None
    }
    index_value :: jet_eval_int(JetEvalRuntimeValue.Data{value: index_data}, &machine, span) ?? return None
    if index_value < 0 && !(if data == .List(_) -> true else -> false) {
        jet_eval_source_fail(&machine, span, "MIR index is negative")
        return None
    }
    if data == {
        .List(values) -> {
            _ := jet_eval_list_position(&machine, index_value, values.len(), span) ?? return None
            Val(JetEvalRuntimeValue.Data{value: values[index_value]})
        }
        .Bytes(values) -> {
            if index_value >= values.len() {
                jet_eval_source_fail(&machine, span, "MIR byte index is out of bounds")
                return None
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: Int.from_u8(values[index_value])}})
        }
        .String(text) -> {
            chars :: text.chars()
            if index_value >= chars.len() {
                jet_eval_source_fail(&machine, span, "MIR string index is out of bounds")
                return None
            }
            Val(JetEvalRuntimeValue.Data{value: jet_eval_char_value(chars[index_value])})
        }
        else -> {
            jet_eval_unsupported(&machine, span, "indexing a value of this kind")
            None
        }
    }
}

// Comptime Char data carries the Unicode scalar value, as sema's checked
// constants do.
fn jet_eval_char_value(character: Char) -> TComptimeValue Never! {
    code :: sema_checked_const_char("{character}") ?? panic("a Char always encodes one UTF-8 scalar")
    TComptimeValue.Char{value: code}
}

fn jet_eval_replace_index(data: TComptimeValue, index: TComptimeValue, replacement: TComptimeValue, machine: &JetEvalMachine, span: Span) -> TComptimeValue? {
    if data == .Map(entries) {
        key :: jet_eval_data_key(index, &machine, span) ?? return None
        updated := entries
        loop entry_index in 0..<updated.len() {
            if updated[entry_index].key == key {
                updated[entry_index].value = replacement
                return Val(TComptimeValue.Map{entries: updated})
            }
        }
        // Rust replace_data_steps: a write to an absent terminal key inserts it.
        return Val(TComptimeValue.Map{entries: jet_eval_insert_map_entry(entries, key, replacement)})
    }
    index_value :: jet_eval_int(JetEvalRuntimeValue.Data{value: index}, &machine, span) ?? return None
    if index_value < 0 {
        jet_eval_source_fail(&machine, span, "MIR indexed write uses a negative index")
        return None
    }
    if data == {
        .List(values) -> {
            length :: values.len()
            if index_value >= length {
                jet_eval_source_fail(&machine, span, "the list has {length} items, so position {index_value} doesn't exist")
                return None
            }
            updated := values
            updated[index_value] = replacement
            Val(TComptimeValue.List{values: updated})
        }
        else -> {
            jet_eval_unsupported(&machine, span, "writing through this index projection")
            None
        }
    }
}

// Project a borrowed base through a place path and return an OWNED copy of the
// selected part. Intermediate dereferences produce owned temporaries that are
// discharged here, so only the selected part's aliases leave this function.
fn jet_eval_map_lookup_window(value: JetEvalRuntimeValue, result: JetEvalRuntimeValue, optional: Bool, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if result == .Absent(_) {
        if optional -> return Val(result)
        jet_eval_compiler_fail(&machine, span, "required map pattern entry is absent")
        return None
    }
    if result == .Result(present, slot) {
        if !present {
            jet_eval_compiler_fail(&machine, span, "map lookup has no checked absence type")
            return None
        }
        index_data :: jet_eval_data(slot, &machine, span) ?? return None
        data :: jet_eval_data(value, &machine, span) ?? return None
        if index_data == .Int(index) && data == .Map(entries) {
            if index >= 0 && index < entries.len() {
                selected :: entries[index].value
                return Val(JetEvalRuntimeValue.Data{value: if optional -> TComptimeValue.Present{value: selected} else -> selected})
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "map lookup outlived its read window")
    None
}

fn jet_eval_project_value(value: JetEvalRuntimeValue, projections: [MIRProjection], frame_index: Int, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    path :: jet_eval_window_path(&machine, frame_index, projections, span) ?? return None
    jet_eval_project_operands(value, projections, path.operands, &machine, span)
}

fn jet_eval_project_operands(value: JetEvalRuntimeValue, projections: [MIRProjection], operands: [U64:JetEvalRuntimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    output := value
    owned := JetEvalRuntimeValue?{None}
    loop projection in projections {
        if projection == {
            .Field(field, _) -> output = jet_eval_field(output, field, &machine, span) ?? {
                jet_eval_discharge_temporary(&machine, owned, span)
                return None
            }
            .Index(kind, index, _, _, location, _, projection_span) -> {
                index_value :: operands.get(index.value) ?? {
                    jet_eval_compiler_fail(&machine, span, "MIR projection index value is unavailable")
                    jet_eval_discharge_temporary(&machine, owned, span)
                    return None
                }
                output = jet_eval_index(output, index_value, kind, location, &machine, projection_span) ?? {
                    jet_eval_discharge_temporary(&machine, owned, projection_span)
                    return None
                }
            }
            .Deref(_) -> {
                fresh := JetEvalRuntimeValue?{None}
                if output == {
                    .Address(target_frame, target_place, access) -> {
                        if access == MIRAccess.Move {
                            jet_eval_ownership_fail(&machine, span, "MIR read dereference uses a move-only address")
                            jet_eval_discharge_temporary(&machine, owned, span)
                            return None
                        }
                        fresh = jet_eval_read_place(&machine, target_frame, target_place, span)
                    }
                    .Window(_, _) -> fresh = jet_eval_read_window(&machine, output, span)
                    .SharedCell(index, access) -> {
                        if access == MIRAccess.Move {
                            jet_eval_ownership_fail(&machine, span, "MIR read dereference uses a move-only shared capture cell")
                            jet_eval_discharge_temporary(&machine, owned, span)
                            return None
                        }
                        fresh = jet_eval_shared_read(&machine, index, span)
                    }
                    else -> {
                        jet_eval_compiler_fail(&machine, span, "MIR dereference requires an address")
                        jet_eval_discharge_temporary(&machine, owned, span)
                        return None
                    }
                }
                dereferenced :: fresh ?? {
                    jet_eval_discharge_temporary(&machine, owned, span)
                    return None
                }
                jet_eval_discharge_temporary(&machine, owned, span)
                owned = Val(dereferenced)
                output = dereferenced
            }
            .Payload(kind, _) -> output = jet_eval_payload(output, kind, &machine, span) ?? {
                jet_eval_discharge_temporary(&machine, owned, span)
                return None
            }
            .Range(range, _, projection_span) -> output = jet_eval_range_operands(output, range, operands, &machine, projection_span) ?? {
                jet_eval_discharge_temporary(&machine, owned, projection_span)
                return None
            }
            .MapLookup(lookup, optional, projection_span) -> {
                result :: operands.get(lookup.value) ?? {
                    jet_eval_compiler_fail(&machine, projection_span, "MIR map lookup operand is unavailable")
                    jet_eval_discharge_temporary(&machine, owned, projection_span)
                    return None
                }
                output = jet_eval_map_lookup_window(output, result, optional, &machine, projection_span) ?? {
                    jet_eval_discharge_temporary(&machine, owned, projection_span)
                    return None
                }
            }
        }
    }
    result :: jet_eval_copy_value(output, &machine, span)
    jet_eval_discharge_temporary(&machine, owned, span)
    result
}

// The owner bounds `[start, end]` (end exclusive) of the range window `range`
// over a list of `len` items. A window outside the list is the user's
// view-bounds stop, as on AOT and the JIT.
fn jet_eval_range_window_bounds(machine: &JetEvalMachine, frame_index: Int, range: MIRValueID, len: Int, span: Span) -> [Int]? {
    value :: jet_eval_value(&machine, frame_index, range, span) ?? return None
    jet_eval_range_bounds_value(&machine, value, len, span)
}

fn jet_eval_range_bounds_operands(machine: &JetEvalMachine, operands: [U64:JetEvalRuntimeValue], range: MIRValueID, len: Int, span: Span) -> [Int]? {
    value :: operands.get(range.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR range window value is unavailable")
        return None
    }
    jet_eval_range_bounds_value(&machine, value, len, span)
}

fn jet_eval_range_bounds_value(machine: &JetEvalMachine, value: JetEvalRuntimeValue, len: Int, span: Span) -> [Int]? {
    data :: jet_eval_data(value, &machine, span) ?? return None
    parts :: jet_eval_range_parts(&machine, data, span) ?? return None
    bounds :: jet_eval_range_bounds(parts, len) ?? {
        jet_eval_source_fail(&machine, span, "can't view {len} items from {parts.start} to {parts.end} ({if parts.exclusive -> "exclusive" else -> "inclusive"})")
        return None
    }
    Val(bounds)
}

// The items of the range window `range` of a list value, sharing the owner's
// element values.
fn jet_eval_range_window(value: JetEvalRuntimeValue, range: MIRValueID, frame_index: Int, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    range_value :: jet_eval_value(&machine, frame_index, range, span) ?? return None
    jet_eval_range_value(value, range_value, &machine, span)
}

fn jet_eval_range_operands(value: JetEvalRuntimeValue, range: MIRValueID, operands: [U64:JetEvalRuntimeValue], machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    range_value :: operands.get(range.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR range window value is unavailable")
        return None
    }
    jet_eval_range_value(value, range_value, &machine, span)
}

fn jet_eval_range_value(value: JetEvalRuntimeValue, range_value: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if value == .Aggregate(aggregate) {
        if aggregate == .List(values) {
            bounds :: jet_eval_range_bounds_value(&machine, range_value, values.len(), span) ?? return None
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: values.slice(bounds[0], bounds[1])}})
        }
    }
    if value == .Data(data) {
        if data == .List(items) {
            bounds :: jet_eval_range_bounds_value(&machine, range_value, items.len(), span) ?? return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: items.slice(bounds[0], bounds[1])}})
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR range window requires a list")
    None
}

// (#3974): which Result/Optional side a payload projection
// enters; None for an enum payload.
fn jet_eval_payload_side(kind: MIRPayloadKind) -> Bool? {
    if kind == {
        .Option -> Val(true)
        .Result(ok) -> Val(ok)
        .Enum(_, _, _) -> None
    }
}

// The payload slot `kind` names inside a checked variant value, borrowed like
// a field. The variant test has already run, so a mismatch is a compiler bug.
fn jet_eval_payload(value: JetEvalRuntimeValue, kind: MIRPayloadKind, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    side :: jet_eval_payload_side(kind)
    if value == .Result(found, nested) {
        if side == (Val(found)) -> return Val(nested)
    }
    if value == .Data(data) {
        if side == (Val(true)) {
            if data == .Present(inner) -> return Val(JetEvalRuntimeValue.Data{value: inner})
            if kind == .Option {
                if data == .Failed(_) {
                    jet_eval_compiler_fail(&machine, span, "MIR optional payload place reads an absent value")
                    return None
                }
                return Val(value)
            }
        }
        if side == (Val(false)) {
            if data == .Failed(report) {
                if report == .Told(inner) -> return Val(JetEvalRuntimeValue.Data{value: inner})
            }
        }
        if kind == .Enum(_, variant, index) {
            if data == .Enum(_, found, args) {
                if found == variant && index >= 0 && index < args.len() -> return Val(JetEvalRuntimeValue.Data{value: args[index].value})
            }
        }
    }
    if value == .Aggregate(aggregate) {
        if kind == .Enum(_, variant, index) {
            if aggregate == .Enum(_, found, args) {
                if found == variant && index >= 0 && index < args.len() -> return Val(args[index].value)
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR payload place does not match its checked variant")
    None
}

fn jet_eval_discharge_temporary(machine: &JetEvalMachine, owned: JetEvalRuntimeValue?, span: Span) {
    if owned == {
        Val(value) -> jet_eval_drop_value(&machine, value, span)
        None -> {}
    }
}

fn jet_eval_read_base_raw(machine: &JetEvalMachine, frame_index: Int, base: MIRPlaceBase, span: Span) -> JetEvalRuntimeValue? {
    if base == {
        .Local(local) -> {
            result :: machine.frames[frame_index].locals.get(local.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR local is unavailable")
                return None
            }
            jet_eval_borrow_value(result, &machine, span)
        }
        .Parameter(value) | .Temporary(value) | .Capture(value) -> {
            result :: machine.frames[frame_index].values.get(value.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR place base value is unavailable")
                return None
            }
            jet_eval_borrow_value(result, &machine, span)
        }
        .Static(name) -> jet_eval_static(&machine, name, span)
    }
}

fn jet_eval_read_base(machine: &JetEvalMachine, frame_index: Int, base: MIRPlaceBase, span: Span) -> JetEvalRuntimeValue? {
    if base == {
        .Local(local) -> {
            result :: machine.frames[frame_index].locals.get(local.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR local is unavailable")
                return None
            }
            if result == .Window(_, _) -> return jet_eval_read_window(&machine, result, span)
            jet_eval_copy_value(result, &machine, span)
        }
        .Parameter(value) | .Temporary(value) | .Capture(value) -> {
            result :: machine.frames[frame_index].values.get(value.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR place base value is unavailable")
                return None
            }
            if result == {
                .Address(target_frame, target_place, access) -> {
                    if access == MIRAccess.Move {
                        jet_eval_ownership_fail(&machine, span, "MIR place read uses a move-only address")
                        return None
                    }
                    jet_eval_read_place(&machine, target_frame, target_place, span)
                }
                .Window(_, _) -> jet_eval_read_window(&machine, result, span)
                .SharedCell(index, access) -> {
                    if access == MIRAccess.Move {
                        jet_eval_ownership_fail(&machine, span, "MIR place read uses a move-only shared capture cell")
                        return None
                    }
                    jet_eval_shared_read(&machine, index, span)
                }
                else -> jet_eval_copy_value(result, &machine, span)
            }
        }
        .Static(name) -> jet_eval_static(&machine, name, span)
    }
}

// Read a place: the base is borrowed and only the projected part is copied.
// A base that is itself an address or shared capture cell is read through
// first; that temporary is discharged before returning.
fn jet_eval_read_place(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR frame function is unavailable")
        return None
    }
    place :: jet_eval_function_place(&machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR place is unavailable")
        return None
    }
    if place.projections.len() == 0 && place.base == .Local(local) {
        uninit_fixed := false
        at := jet_eval_function_local_row(&machine, function, local) ?? -1
        loop at >= 0 {
            if machine.program.functions[function].locals[at].uninit && machine.program.functions[function].locals[at].ty.kind == .FixedList(_, _) -> uninit_fixed = true
            at = machine.rows.function_rows[function].locals_next[at]
        }
        current :: machine.frames[frame_index].locals.get(local.value) ?? return None
        if uninit_fixed && current == .Aggregate(aggregate) {
            if aggregate == .List(_) && jet_eval_runtime_contains_moved(current) {
                jet_eval_source_fail(&machine, span, "fixed list read before every element was initialized")
                return None
            }
        }
    }
    raw :: jet_eval_read_base_raw(&machine, frame_index, place.base, span) ?? return None
    through := JetEvalRuntimeValue?{None}
    if raw == .Window(_, _) -> through = Val(jet_eval_read_window(&machine, raw, span) ?? return None)
    if place.base == {
        .Parameter(_) | .Temporary(_) | .Capture(_) -> {
            if raw == {
                .Address(target_frame, target_place, access) -> {
                    if access == MIRAccess.Move {
                        jet_eval_ownership_fail(&machine, span, "MIR place read uses a move-only address")
                        return None
                    }
                    through = Val(jet_eval_read_place(&machine, target_frame, target_place, span) ?? return None)
                }
                .SharedCell(index, access) -> {
                    if access == MIRAccess.Move {
                        jet_eval_ownership_fail(&machine, span, "MIR place read uses a move-only shared capture cell")
                        return None
                    }
                    through = Val(jet_eval_shared_read(&machine, index, span) ?? return None)
                }
                else -> {}
            }
        }
        else -> {}
    }
    if through == {
        Val(owned) -> {
            projected :: jet_eval_project_value(owned, place.projections, frame_index, &machine, span)
            jet_eval_drop_value(&machine, owned, span)
            projected
        }
        None -> jet_eval_project_value(raw, place.projections, frame_index, &machine, span)
    }
}

fn jet_eval_replace_value(data: TComptimeValue, projections: [MIRProjection], position: Int, frame_index: Int, replacement: TComptimeValue, machine: &JetEvalMachine, span: Span) -> TComptimeValue? {
    path :: jet_eval_window_path(&machine, frame_index, projections, span) ?? return None
    jet_eval_replace_data_operands(data, projections, position, path.operands, replacement, &machine, span)
}

fn jet_eval_replace_data_operands(data: TComptimeValue, projections: [MIRProjection], position: Int, operands: [U64:JetEvalRuntimeValue], replacement: TComptimeValue, machine: &JetEvalMachine, span: Span) -> TComptimeValue? {
    if position >= projections.len() -> return Val(replacement)
    projection :: projections[position]
    if projection == {
        .Field(field, _) -> {
            name :: jet_eval_field_name(machine, field) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR field ID is missing")
                return None
            }
            child :: jet_eval_find_field(data, name) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR projected field is absent")
                return None
            }
            updated :: jet_eval_replace_data_operands(child, projections, position + 1, operands, replacement, &machine, span) ?? return None
            jet_eval_replace_field(data, name, updated)
        }
        .Index(kind, index, _, _, location, _, projection_span) -> {
            index_value :: operands.get(index.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR projected index value is unavailable")
                return None
            }
            index_data :: jet_eval_data(index_value, &machine, projection_span) ?? return None
            // The terminal write replaces (or, for a map, inserts) the slot
            // without first reading it.
            if position + 1 >= projections.len() -> return jet_eval_replace_index(data, index_data, replacement, &machine, projection_span)
            child :: jet_eval_index(JetEvalRuntimeValue.Data{value: data}, JetEvalRuntimeValue.Data{value: index_data}, kind, location, &machine, projection_span) ?? return None
            child_data :: jet_eval_data(child, &machine, projection_span) ?? return None
            updated :: jet_eval_replace_data_operands(child_data, projections, position + 1, operands, replacement, &machine, projection_span) ?? return None
            jet_eval_replace_index(data, index_data, updated, &machine, projection_span)
        }
        .Deref(_) -> {
            jet_eval_unsupported(&machine, span, "projected dereference writes")
            None
        }
        .Payload(kind, _) -> {
            side :: jet_eval_payload_side(kind)
            if side == (Val(true)) {
                if data == .Present(inner) {
                    updated :: jet_eval_replace_data_operands(inner, projections, position + 1, operands, replacement, &machine, span) ?? return None
                    return Val(TComptimeValue.Present{value: updated})
                }
                if kind == .Option {
                    if data == .Failed(_) {
                        jet_eval_compiler_fail(&machine, span, "MIR optional payload place writes an absent value")
                        return None
                    }
                    return jet_eval_replace_data_operands(data, projections, position + 1, operands, replacement, &machine, span)
                }
            }
            if side == (Val(false)) {
                if data == .Failed(report) {
                    if report == .Told(inner) {
                        updated :: jet_eval_replace_data_operands(inner, projections, position + 1, operands, replacement, &machine, span) ?? return None
                        return Val(TComptimeValue.Failed{report: TComptimeReport.Told{value: updated}})
                    }
                }
            }
            if kind == .Enum(_, variant, index) {
                if data == .Enum(type_name, found, args) {
                    if found == variant && index >= 0 && index < args.len() {
                        updated_args := args
                        updated_args[index].value = jet_eval_replace_data_operands(args[index].value, projections, position + 1, operands, replacement, &machine, span) ?? return None
                        return Val(TComptimeValue.Enum{type_name: type_name, variant: found, args: updated_args})
                    }
                }
            }
            jet_eval_compiler_fail(&machine, span, "MIR payload write does not match its checked variant")
            None
        }
        .MapLookup(_, _, _) -> {
            jet_eval_compiler_fail(&machine, span, "map lookup windows are read-only")
            None
        }
        // A range window write lands in the owner's items; the window keeps
        // its fixed length.
        .Range(range, _, projection_span) -> {
            if data == .List(items) {
                bounds :: jet_eval_range_bounds_operands(&machine, operands, range, items.len(), projection_span) ?? return None
                window :: items.slice(bounds[0], bounds[1])
                updated :: jet_eval_replace_data_operands(TComptimeValue.List{values: window}, projections, position + 1, operands, replacement, &machine, projection_span) ?? return None
                if updated == .List(written) {
                    if written.len() == window.len() {
                        spliced := items
                        loop (offset, item) in written -> spliced[bounds[0] + offset] = item
                        return Val(TComptimeValue.List{values: spliced})
                    }
                }
                jet_eval_compiler_fail(&machine, projection_span, "MIR range window write changes its length")
                return None
            }
            jet_eval_compiler_fail(&machine, span, "MIR range window requires a list")
            None
        }
    }
}

// Replace the part of an OWNED value selected by the path with `replacement`
// (moved in). The replaced part is discharged here; the rest of the value keeps
// its aliases in the returned result.
fn jet_eval_replace_runtime(value: JetEvalRuntimeValue, projections: [MIRProjection], position: Int, frame_index: Int, replacement: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    path :: jet_eval_window_path(&machine, frame_index, projections, span) ?? return None
    jet_eval_replace_operands(value, projections, position, path.operands, replacement, &machine, span)
}

fn jet_eval_replace_operands(value: JetEvalRuntimeValue, projections: [MIRProjection], position: Int, operands: [U64:JetEvalRuntimeValue], replacement: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if position >= projections.len() {
        if !jet_eval_drop_value(&machine, value, span) -> return None
        return Val(replacement)
    }
    if value == .Result(found, nested) {
        if projections[position] == .Payload(kind, _) {
            if jet_eval_payload_side(kind) == (Val(found)) {
                updated :: jet_eval_replace_operands(nested, projections, position + 1, operands, replacement, &machine, span) ?? return None
                return Val(JetEvalRuntimeValue.Result{ok: found, value: updated})
            }
        }
        jet_eval_compiler_fail(&machine, span, "MIR payload write does not match its Result carrier")
        return None
    }
    if value == .Data(data) {
        replacement_data :: jet_eval_data(replacement, &machine, span) ?? return None
        updated :: jet_eval_replace_data_operands(data, projections, position, operands, replacement_data, &machine, span) ?? return None
        return Val(JetEvalRuntimeValue.Data{value: updated})
    }
    if value == .Aggregate(aggregate) {
        projection :: projections[position]
        if projection == {
            .Field(field, _) -> {
                name :: jet_eval_field_name(machine, field) ?? return None
                if aggregate == .Struct(type_name, fields) {
                    updated_fields := fields
                    loop index in 0..<updated_fields.len() {
                        if updated_fields[index].name == name {
                            updated :: jet_eval_replace_operands(updated_fields[index].value, projections, position + 1, operands, replacement, &machine, span) ?? return None
                            updated_fields[index].value = updated
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: type_name, fields: updated_fields}})
                        }
                    }
                }
                jet_eval_compiler_fail(&machine, span, "MIR projected runtime field is absent")
                return None
            }
            .Index(kind, index, _, _, _, _, _) -> {
                index_value :: operands.get(index.value) ?? return None
                index_data :: jet_eval_data(index_value, &machine, span) ?? return None
                if aggregate == .List(values) {
                    position_value :: jet_eval_int(JetEvalRuntimeValue.Data{value: index_data}, &machine, span) ?? return None
                    length :: values.len()
                    if position_value < 0 || position_value >= length {
                        jet_eval_source_fail(&machine, span, "the list has {length} items, so position {position_value} doesn't exist")
                        return None
                    }
                    updated_values := values
                    updated_values[position_value] = jet_eval_replace_operands(values[position_value], projections, position + 1, operands, replacement, &machine, span) ?? return None
                    return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: updated_values}})
                }
                if aggregate == .Map(entries) {
                    key :: jet_eval_data_key(index_data, &machine, span) ?? return None
                    updated_entries := entries
                    insert_at := updated_entries.len()
                    loop entry_index in 0..<updated_entries.len() {
                        entry_data :: jet_eval_data(updated_entries[entry_index].key, &machine, span) ?? return None
                        entry_key :: jet_eval_data_key(entry_data, &machine, span) ?? return None
                        if entry_key == key {
                            updated_entries[entry_index].value = jet_eval_replace_operands(updated_entries[entry_index].value, projections, position + 1, operands, replacement, &machine, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Map{entries: updated_entries}})
                        }
                        if insert_at == updated_entries.len() && jet_eval_key_compare(entry_key, key) >= 0 -> insert_at = entry_index
                    }
                    // Rust replace_path: a write to an absent terminal key
                    // inserts it at its sorted position; a nested absent key
                    // is still a stop.
                    if position + 1 < projections.len() {
                        jet_eval_source_fail(&machine, span, "MIR runtime map write key is absent")
                        return None
                    }
                    inserted := [JetEvalRuntimeMapEntry]{}
                    loop entry_index in 0..<updated_entries.len() {
                        if entry_index == insert_at -> &inserted.push(JetEvalRuntimeMapEntry{key: JetEvalRuntimeValue.Data{value: index_data}, value: replacement})
                        &inserted.push(updated_entries[entry_index])
                    }
                    if insert_at == updated_entries.len() -> &inserted.push(JetEvalRuntimeMapEntry{key: JetEvalRuntimeValue.Data{value: index_data}, value: replacement})
                    return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Map{entries: inserted}})
                }
                jet_eval_unsupported(&machine, span, "writing through this runtime projection")
                return None
            }
            .Deref(_) -> {
                jet_eval_unsupported(&machine, span, "projected dereference writes")
                return None
            }
            .Payload(kind, _) -> {
                if kind == .Enum(_, variant, index) {
                    if aggregate == .Enum(type_name, found, args) {
                        if found == variant && index >= 0 && index < args.len() {
                            updated_args := args
                            updated_args[index].value = jet_eval_replace_operands(args[index].value, projections, position + 1, operands, replacement, &machine, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Enum{type_name: type_name, variant: found, args: updated_args}})
                        }
                    }
                }
                jet_eval_compiler_fail(&machine, span, "MIR payload write does not match the runtime variant")
                return None
            }
            .MapLookup(_, _, _) -> {
                jet_eval_compiler_fail(&machine, span, "map lookup windows are read-only")
                return None
            }
            .Range(range, _, projection_span) -> {
                if aggregate == .List(values) {
                    bounds :: jet_eval_range_bounds_operands(&machine, operands, range, values.len(), projection_span) ?? return None
                    window :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: values.slice(bounds[0], bounds[1])}}
                    updated :: jet_eval_replace_operands(window, projections, position + 1, operands, replacement, &machine, projection_span) ?? return None
                    written := [JetEvalRuntimeValue]{}
                    if updated == .Aggregate(updated_aggregate) {
                        if updated_aggregate == .List(items) -> written = items
                    }
                    if updated == .Data(data) {
                        if data == .List(items) {
                            loop item in items -> &written.push(JetEvalRuntimeValue.Data{value: item})
                        }
                    }
                    if written.len() != bounds[1] - bounds[0] {
                        jet_eval_compiler_fail(&machine, projection_span, "MIR range window write changes its length")
                        return None
                    }
                    updated_values := values
                    loop (offset, item) in written -> updated_values[bounds[0] + offset] = item
                    return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: updated_values}})
                }
                jet_eval_compiler_fail(&machine, span, "MIR range window requires a list")
                return None
            }
        }
    }
    jet_eval_unsupported(&machine, span, "writing through a non-aggregate runtime value")
    None
}

fn jet_eval_write_deref_place(machine: &JetEvalMachine, frame_index: Int, place: MIRPlace, value: JetEvalRuntimeValue, span: Span) -> Bool {
    first :: place.projections[0]
    if first == .Deref(_) {
        rest :: loop index in 1..<place.projections.len() -> place.projections[index]
        raw :: jet_eval_read_base_raw(&machine, frame_index, place.base, span) ?? {
            jet_eval_drop_value(&machine, value, span)
            return false
        }
        if raw == .Window(_, _) {
            path :: jet_eval_window_path(&machine, frame_index, rest, span) ?? {
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            return jet_eval_write_window(&machine, JetEvalRuntimeValue.Window{owner: raw, path: path}, value, span)
        }
        if raw == .Address(target_frame, target_place, access) {
            if access != MIRAccess.Write {
                jet_eval_ownership_fail(&machine, span, "MIR projected dereference write uses a read-only address")
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            if rest.len() == 0 -> return jet_eval_write_place(&machine, target_frame, target_place, value, span)
            target :: jet_eval_read_place(&machine, target_frame, target_place, span) ?? {
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            updated :: jet_eval_replace_runtime(target, rest, 0, target_frame, value, &machine, span) ?? {
                jet_eval_drop_value(&machine, target, span)
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            return jet_eval_write_place(&machine, target_frame, target_place, updated, span)
        }
        if raw == .SharedCell(cell, access) {
            if access != MIRAccess.Write {
                jet_eval_ownership_fail(&machine, span, "MIR projected dereference write uses a read-only shared capture cell")
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            if rest.len() == 0 -> return jet_eval_shared_write(&machine, cell, access, value, span)
            target :: jet_eval_shared_read(&machine, cell, span) ?? {
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            updated :: jet_eval_replace_runtime(target, rest, 0, frame_index, value, &machine, span) ?? {
                jet_eval_drop_value(&machine, target, span)
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            return jet_eval_shared_write(&machine, cell, access, updated, span)
        }
        jet_eval_compiler_fail(&machine, span, "MIR projected dereference write requires an address")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    jet_eval_compiler_fail(&machine, span, "MIR projected dereference write has a non-canonical projection path")
    jet_eval_drop_value(&machine, value, span)
    false
}

fn jet_eval_write_base(machine: &JetEvalMachine, frame_index: Int, base: MIRPlaceBase, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if base == {
        .Local(local) -> {
            current := machine.frames[frame_index].locals.get(local.value)
            if current != None {
                existing :: current ?? {
                    jet_eval_drop_value(&machine, value, span)
                    return false
                }
                if existing == .SharedCell(index, access) {
                    return jet_eval_shared_write(&machine, index, access, value, span)
                }
                if existing == .Window(_, _) && value != JetEvalRuntimeValue.Moved -> return jet_eval_write_window(&machine, existing, value, span)
                if value != JetEvalRuntimeValue.Moved && !jet_eval_drop_value(&machine, existing, span) {
                    jet_eval_drop_value(&machine, value, span)
                    return false
                }
            }
            machine.frames[frame_index].locals[local.value] = value
            true
        }
        .Parameter(source) | .Temporary(source) | .Capture(source) -> {
            existing := machine.frames[frame_index].values.get(source.value)
            if existing != None {
                current :: existing ?? {
                    jet_eval_drop_value(&machine, value, span)
                    return false
                }
                if current == .Address(target_frame, target_place, access) {
                    if access != MIRAccess.Write {
                        jet_eval_ownership_fail(&machine, span, "MIR write uses a read-only address")
                        jet_eval_drop_value(&machine, value, span)
                        return false
                    }
                    return jet_eval_write_place(&machine, target_frame, target_place, value, span)
                }
                if current == .Window(_, _) -> return jet_eval_write_window(&machine, current, value, span)
                if current == .SharedCell(index, access) {
                    return jet_eval_shared_write(&machine, index, access, value, span)
                }
                if value != JetEvalRuntimeValue.Moved && !jet_eval_drop_value(&machine, current, span) {
                    jet_eval_drop_value(&machine, value, span)
                    return false
                }
            }
            machine.frames[frame_index].values[source.value] = value
            true
        }
        .Static(_) -> {
            jet_eval_unsupported(&machine, span, "writing a static MIR value")
            jet_eval_drop_value(&machine, value, span)
            false
        }
    }
}

fn jet_eval_take_partial_fixed_list_base(machine: &JetEvalMachine, frame_index: Int, base: MIRPlaceBase, span: Span) -> JetEvalRuntimeValue? {
    if base == {
        .Local(local_id) -> {
            function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return None
            at :: jet_eval_function_local_last_row(&machine, function, local_id) ?? return None
            row := machine.program.functions[function].locals[at]
            length := MIRMeasure?{None}
            if row.ty.kind == {
                .FixedList(_, count) -> {
                    length = Val(count)
                }
                else -> return None
            }
            value :: machine.frames[frame_index].locals.get(local_id.value) ?? return None
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .List(_) -> {}
                        else -> return None
                    }
                }
                else -> return None
            }
            if !jet_eval_runtime_contains_moved(value) -> return None
            measure :: length ?? return None
            expected :: mir_measure_literal_value(measure) ?? {
                jet_eval_compiler_fail(&machine, span, "uninitialized fixed-list length is not a checked static measure")
                return None
            }
            list_length := Int?{None}
            if value == .Aggregate(aggregate) {
                if aggregate == {
                    .List(values) -> {
                        list_length = Val(values.len())
                    }
                    else -> return None
                }
            }
            if list_length != (Val(expected)) {
                jet_eval_compiler_fail(&machine, span, "uninitialized fixed-list backing disagrees with its checked length")
                return None
            }
            machine.frames[frame_index].locals[local_id.value] = JetEvalRuntimeValue.Moved
            return Val(value)
        }
        else -> return None
    }
}

// Consumes value on success and failure. A SharedCell swap can commit the new
// payload before disposal of the previous value reports failure.
fn jet_eval_fixed_backing_write(machine: &JetEvalMachine, frame_index: Int, root_value: JetEvalRuntimeValue, index_id: MIRValueID, location: MIRPanicLoc, value: JetEvalRuntimeValue, span: Span) -> Bool {
    root :: jet_eval_fixed_backing_storage(&machine, root_value, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    index_value :: machine.frames[frame_index].values.get(index_id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR FixedListProof write index is unavailable")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    index :: jet_eval_fixed_backing_index(&machine, index_value, location, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    byte :: jet_eval_int(value, &machine, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    access :: jet_eval_fixed_backing_access(&machine, root_value, JetEvalHostFixedBackingOperation.Write{index: index, value: byte}, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    if access == {
        .Unit -> return jet_eval_drop_value(&machine, value, span)
        .OutOfBounds -> {
            jet_eval_source_fail(&machine, span, "fixed-list index out of range")
            jet_eval_drop_value(&machine, value, span)
            return false
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "native Fixed backing write returned an invalid typed result")
            jet_eval_drop_value(&machine, value, span)
            return false
        }
    }
}

fn jet_eval_write_place(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, value: JetEvalRuntimeValue, span: Span) -> Bool {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR frame function is unavailable")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    place :: jet_eval_function_place(&machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR write targets an unavailable place")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    // Rust `MIREval::write_place` has no access gate: an immutable binding's
    // place is `Read` and its `Let` initializes it with this very write.
    // Write legality is MIR verification's job, not the evaluator's.
    if place.projections.len() == 1 && place.base == .Local(local) {
            root_value :: machine.frames[frame_index].locals.get(local.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed backing local is unavailable")
                jet_eval_drop_value(&machine, value, span)
                return false
            }
            if root_value == .ForeignHandle(_, _, token) {
                token_kind :: jet_eval_foreign_token_kind(machine, token) ?? {
                    jet_eval_compiler_fail(&machine, span, "MIR Fixed backing local has no evaluator token")
                    jet_eval_drop_value(&machine, value, span)
                    return false
                }
                if token_kind == .FixedBackingRoot(_, _) {
                    if place.projections[0] == {
                        .Index(kind, index, _, _, location, _, projection_span) -> {
                            if kind != MIRIndexKind.FixedListProof {
                                jet_eval_compiler_fail(&machine, span, "MIR Fixed backing write lacks its checked FixedListProof kind")
                                jet_eval_drop_value(&machine, value, span)
                                return false
                            }
                            return jet_eval_fixed_backing_write(&machine, frame_index, root_value, index, location, value, projection_span)
                        }
                        else -> {
                            jet_eval_compiler_fail(&machine, span, "MIR Fixed backing write is not a single fixed-list index")
                            jet_eval_drop_value(&machine, value, span)
                            return false
                        }
                    }
                }
            }
    }
    if place.projections.len() == 0 {
        written :: jet_eval_write_base(&machine, frame_index, place.base, value, span)
        return written && !jet_eval_has_failure(machine)
    }
    if place.projections[0] == .Deref(_) -> return jet_eval_write_deref_place(&machine, frame_index, place, value, span)
    partial_base :: jet_eval_take_partial_fixed_list_base(&machine, frame_index, place.base, span)
    if partial_base == None && jet_eval_has_failure(machine) {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    base := partial_base
    if base == None -> base = jet_eval_read_base(&machine, frame_index, place.base, span)
    owned_base :: base ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    updated :: jet_eval_replace_runtime(owned_base, place.projections, 0, frame_index, value, &machine, span) ?? {
        jet_eval_drop_value(&machine, owned_base, span)
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    written :: jet_eval_write_base(&machine, frame_index, place.base, updated, span)
    written && !jet_eval_has_failure(machine)
}

fn jet_eval_mark_base_moved(machine: &JetEvalMachine, frame_index: Int, base: MIRPlaceBase, span: Span) -> Bool {
    if base == {
        .Local(local) -> {
            if machine.frames[frame_index].locals.get(local.value) == None {
                jet_eval_compiler_fail(&machine, span, "MIR moved local is unavailable")
                return false
            }
            machine.frames[frame_index].locals[local.value] = JetEvalRuntimeValue.Moved
            true
        }
        .Parameter(source) | .Temporary(source) | .Capture(source) -> {
            if machine.frames[frame_index].values.get(source.value) == None {
                jet_eval_compiler_fail(&machine, span, "MIR moved place base value is unavailable")
                return false
            }
            machine.frames[frame_index].values[source.value] = JetEvalRuntimeValue.Moved
            true
        }
        .Static(_) -> {
            jet_eval_unsupported(&machine, span, "moving a static MIR value")
            false
        }
    }
}

fn jet_eval_partial_fixed_list_move_is_drop(machine: &JetEvalMachine, frame_index: Int) -> Bool Never! {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return false
    current_block :: machine.frames[frame_index].block
    block :: jet_eval_function_block_row(&machine, function, current_block) ?? return false
    ip :: machine.frames[frame_index].ip
    if ip <= 0 || ip >= machine.program.functions[function].blocks[block].instructions.len() -> return false
    result :: machine.program.functions[function].blocks[block].instructions[ip - 1].result ?? return false
    if machine.program.functions[function].blocks[block].instructions[ip].operation == {
        .Drop(value, _) -> value == result
        else -> false
    }
}

fn jet_eval_move_place(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR frame function is unavailable")
        return None
    }
    place :: jet_eval_function_place(&machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR move targets an unavailable place")
        return None
    }
    if place.projections.len() == 0 {
        raw :: jet_eval_read_base_raw(&machine, frame_index, place.base, span) ?? return None
        if raw == .Window(_, _) {
            if !jet_eval_mark_base_moved(&machine, frame_index, place.base, span) -> return None
            return Val(raw)
        }
        if raw == .Address(target_frame, target_place, _) {
            value :: jet_eval_move_place(&machine, target_frame, target_place, span) ?? return None
            if !jet_eval_mark_base_moved(&machine, frame_index, place.base, span) -> return None
            return Val(value)
        }
        if raw == .SharedCell(cell, _) {
            if !jet_eval_shared_cell_claim_sole(&machine, cell, span) -> return None
            value :: jet_eval_shared_cell_take_payload(machine, cell)
            if !jet_eval_validate_borrow(value, &machine, span) {
                jet_eval_drop_value(&machine, value, span)
                return None
            }
            if !jet_eval_mark_base_moved(&machine, frame_index, place.base, span) {
                jet_eval_drop_value(&machine, value, span)
                return None
            }
            return Val(value)
        }
        if raw == .ForeignHandle(_, _, token) {
            token_kind :: jet_eval_foreign_token_kind(machine, token) ?? return None
            if token_kind == .FixedBackingRoot(_, _) {
                if jet_eval_partial_fixed_list_move_is_drop(&machine, frame_index) {
                    if !jet_eval_mark_base_moved(&machine, frame_index, place.base, span) -> return None
                    return Val(raw)
                }
                moved :: jet_eval_fixed_backing_array(&machine, raw, true, span) ?? return None
                if !jet_eval_drop_value(&machine, raw, span) {
                    jet_eval_drop_value(&machine, moved, span)
                    return None
                }
                if !jet_eval_mark_base_moved(&machine, frame_index, place.base, span) {
                    jet_eval_drop_value(&machine, moved, span)
                    return None
                }
                return Val(moved)
            }
        }
        partial_fixed_list := false
        fixed_list :: if place.ty.kind == {.FixedList(_, _) -> true else -> false}
        if fixed_list && raw == .Aggregate(aggregate) {
            if aggregate == .List(_) && jet_eval_runtime_contains_moved(raw) -> partial_fixed_list = true
        }
        if partial_fixed_list && !jet_eval_partial_fixed_list_move_is_drop(&machine, frame_index) {
            jet_eval_compiler_fail(&machine, span, "partially initialized fixed list move is not immediately consumed by its root Drop")
            return None
        }
        value :: (if partial_fixed_list -> Val(raw) else -> jet_eval_borrow_value(raw, &machine, span)) ?? return None
        if !jet_eval_write_base(&machine, frame_index, place.base, JetEvalRuntimeValue.Moved, span) -> return None
        return Val(value)
    }
    partial_base :: jet_eval_take_partial_fixed_list_base(&machine, frame_index, place.base, span)
    if partial_base == None && jet_eval_has_failure(machine) -> return None
    base_result := partial_base
    if base_result == None -> base_result = jet_eval_read_base(&machine, frame_index, place.base, span)
    base :: base_result ?? return None
    moved :: jet_eval_project_value(base, place.projections, frame_index, &machine, span) ?? {
        jet_eval_drop_value(&machine, base, span)
        return None
    }
    updated :: jet_eval_replace_runtime(base, place.projections, 0, frame_index, JetEvalRuntimeValue.Moved, &machine, span) ?? {
        jet_eval_drop_value(&machine, base, span)
        jet_eval_drop_value(&machine, moved, span)
        return None
    }
    if !jet_eval_write_base(&machine, frame_index, place.base, updated, span) {
        jet_eval_drop_value(&machine, moved, span)
        return None
    }
    Val(moved)
}

fn jet_eval_decimal_zero() -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "Decimal", fields: [TComptimeField]{
        TComptimeField{name: "negative", value: TComptimeValue.Bool{value: false}},
        TComptimeField{name: "digits", value: TComptimeValue.String{value: "0"}},
        TComptimeField{name: "scale", value: TComptimeValue.Int{value: 0}},
    }}
}

fn jet_eval_fixed_primitive(machine: &JetEvalMachine, op: MIRBinaryOp, lhs: TComptimeValue, rhs: TComptimeValue, span: Span) -> JetEvalRuntimeValue? {
    left :: jet_eval_int(JetEvalRuntimeValue.Data{value: lhs}, &machine, span) ?? return None
    right :: jet_eval_int(JetEvalRuntimeValue.Data{value: rhs}, &machine, span) ?? return None
    if op == {
        .Eq -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left == right}})
        .Ne -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left != right}})
        .Lt -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left < right}})
        .Gt -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left > right}})
        .Le -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left <= right}})
        .Ge -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left >= right}})
        .Compare -> {
            variant :: if {
                left < right -> "Less"
                left > right -> "Greater"
                else -> "Equal"
            }
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Enum{type_name: "Ordering", variant: variant, args: [TComptimeEnumArg]{}}})
        }
        .Add -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left + right}})
        .Sub -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left - right}})
        .Mul -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left * right}})
        .Div -> {
            if right == 0 {
                jet_eval_source_fail(&machine, span, "division by zero")
                return None
            }
            // Fixed-width `Div` truncates toward zero; `/%` alone would floor.
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: (left - left %% right) /% right}})
        }
        .Rem -> {
            if right == 0 {
                jet_eval_source_fail(&machine, span, "division by zero")
                return None
            }
            // Fixed-width `Rem` is the truncated remainder (dividend's sign), like MIR `Rem`.
            Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left %% right}})
        }
        .BitAnd -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: (left).bit_and(right)}})
        .BitOr -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: (left).bit_or(right)}})
        .BitXor -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: (left).bit_xor(right)}})
        .Shl -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left << right}})
        .Shr -> Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: left >> right}})
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR fixed primitive operator has no direct Core kernel")
            None
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs MirOperation::Unary and
// mir_unary_not. Negation follows the operand carrier; bitwise and logical
// negation follow the operand's checked type with numeric wrappers removed.
fn jet_eval_unary(machine: &JetEvalMachine, op: MIRUnaryOp, value: JetEvalRuntimeValue, operand_ty: MIRType, span: Span) -> JetEvalRuntimeValue? {
    data :: jet_eval_data(value, &machine, span) ?? return None
    if op == MIRUnaryOp.Neg {
        if data == {
            .Float(number, bits) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: -number, bits: bits}})
            .Int(number) -> {
                if number == -9223372036854775807 - 1 {
                    jet_eval_source_fail(&machine, span, "integer negation overflow")
                    return None
                }
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 0 - number}})
            }
            .BigInt(_) -> {
                return jet_eval_route_exact_integer_member_host("sub", [JetEvalRuntimeValue]{
                    JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 0}},
                    JetEvalRuntimeValue.Data{value: data},
                }, &machine, Val(mir_type_from_kind(MIRTypeKind.Int)), span)
            }
            .Struct(type_name, _) -> {
                if type_name == "Decimal" {
                    return jet_eval_route_precise_member_host("Decimal", "sub", [JetEvalRuntimeValue]{
                        JetEvalRuntimeValue.Data{value: jet_eval_decimal_zero()},
                        JetEvalRuntimeValue.Data{value: data},
                    }, &machine, Val(operand_ty), span)
                }
            }
            else -> {}
        }
        jet_eval_compiler_fail(&machine, span, "MIR unary negation requires a number")
        return None
    }
    ty :: jet_eval_unary_kernel_type(operand_ty)
    if ty.kind == {
        .Bool -> {
            if data == .Bool(flag) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: !flag}})
            jet_eval_compiler_fail(&machine, span, "MIR logical negation requires Bool")
            return None
        }
        .Int -> {
            if !jet_eval_route_is_exact_integer(data) {
                jet_eval_compiler_fail(&machine, span, "MIR bitwise negation requires an exact integer")
                return None
            }
            one_more :: jet_eval_route_exact_integer_member_host("add", [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: data},
                JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 1}},
            }, &machine, Val(mir_type_from_kind(MIRTypeKind.Int)), span) ?? return None
            one_data :: jet_eval_data(one_more, &machine, span) ?? return None
            return jet_eval_route_exact_integer_member_host("sub", [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 0}},
                JetEvalRuntimeValue.Data{value: one_data},
            }, &machine, Val(mir_type_from_kind(MIRTypeKind.Int)), span)
        }
        .IntN(signed, bits) -> {
            if bits <= 0 || bits > 64 {
                jet_eval_compiler_fail(&machine, span, "MIR fixed integer bitwise-not has invalid width")
                return None
            }
            number :: jet_eval_route_core_wrapping_bits(data, &machine, span) ?? return None
            mask :: if bits == 64 -> -1 else -> (1 << bits) - 1
            inverted := number.bit_not().bit_and(mask)
            if signed && bits < 64 && inverted.bit_and(1 << (bits - 1)) != 0 -> inverted = inverted.bit_or(mask.bit_not())
            result :: if signed || bits < 64 -> TComptimeValue.Int{value: inverted} else -> jet_eval_integer_constant_value(inverted, false, bits)
            return Val(JetEvalRuntimeValue.Data{value: result})
        }
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "MIR bitwise negation requires an integer or Bool")
    None
}

// The checked numeric kernel type under InlineRange, Tagged and Quantity.
fn jet_eval_unary_kernel_type(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .InlineRange(base, _, _) -> return jet_eval_unary_kernel_type(base)
        .Tagged(_, inner) -> return jet_eval_unary_kernel_type(inner)
        .Quantity(base, _) -> return jet_eval_unary_kernel_type(base)
        else -> {}
    }
    // copy: the caller keeps its operand type (owner: the read parameter) and gets the kernel type
    // as its own result (owner: the returned MIRType); other kinds map to a different type.
    ty.copy()
}

fn jet_eval_binary(machine: &JetEvalMachine, op: MIRBinaryOp, left: JetEvalRuntimeValue, right: JetEvalRuntimeValue, result_ty: MIRType?, left_ty: MIRType, right_ty: MIRType, span: Span) -> JetEvalRuntimeValue? {
    lhs :: jet_eval_data(left, &machine, span) ?? return None
    rhs :: jet_eval_data(right, &machine, span) ?? return None
    if op == MIRBinaryOp.Add {
        if lhs == .String(a) {
            if rhs == .String(b) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: "{a}{b}"}})
        }
    }
    if op == MIRBinaryOp.And || op == MIRBinaryOp.Or {
        if lhs == .Bool(a) {
            if rhs == .Bool(b) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: if op == MIRBinaryOp.And -> a && b else -> a || b}})
        }
        jet_eval_compiler_fail(&machine, span, "MIR logical operator requires Bool operands")
        return None
    }
    if left_ty.kind == .IntN(_, _) {
        if lhs == .Int(_) {
            if rhs == .Int(_) -> return jet_eval_fixed_primitive(&machine, op, lhs, rhs, span)
        }
    }
    if right_ty.kind == .IntN(_, _) {
        if lhs == .Int(_) {
            if rhs == .Int(_) -> return jet_eval_fixed_primitive(&machine, op, lhs, rhs, span)
        }
    }
    if result_ty != None {
        ty :: result_ty
        if ty.kind == .IntN(_, _) {
            if lhs == .Int(_) {
                if rhs == .Int(_) -> return jet_eval_fixed_primitive(&machine, op, lhs, rhs, span)
            }
        }
    }
    if jet_eval_route_is_exact_integer(lhs) && jet_eval_route_is_exact_integer(rhs) {
        if op == MIRBinaryOp.Eq || op == MIRBinaryOp.Ne || op == MIRBinaryOp.Lt || op == MIRBinaryOp.Gt || op == MIRBinaryOp.Le || op == MIRBinaryOp.Ge || op == MIRBinaryOp.Compare {
            compared :: jet_eval_route_exact_order(lhs, rhs, &machine, span) ?? return None
            result :: if op == {
                .Eq -> TComptimeValue.Bool{value: compared == 0}
                .Ne -> TComptimeValue.Bool{value: compared != 0}
                .Lt -> TComptimeValue.Bool{value: compared < 0}
                .Gt -> TComptimeValue.Bool{value: compared > 0}
                .Le -> TComptimeValue.Bool{value: compared <= 0}
                .Ge -> TComptimeValue.Bool{value: compared >= 0}
                else -> {
                    variant :: if {
                        compared < 0 -> "Less"
                        compared > 0 -> "Greater"
                        else -> "Equal"
                    }
                    TComptimeValue.Enum{type_name: "Ordering", variant: variant, args: [TComptimeEnumArg]{}}
                }
            }
            return Val(JetEvalRuntimeValue.Data{value: result})
        }
        // Rust eval_mir_binary: FloorDiv is the Euclidean quotient, Mod the
        // floored remainder, Rem the truncated remainder.
        if op == MIRBinaryOp.FloorDiv || op == MIRBinaryOp.Mod || op == MIRBinaryOp.Rem {
            if rhs == (TComptimeValue.Int{value: 0}) {
                jet_eval_source_fail(&machine, span, "division by zero")
                return None
            }
        }
        if op == MIRBinaryOp.Pow {
            if rhs == .BigInt(_) {
                jet_eval_source_fail(&machine, span, "integer exponent does not fit Int")
                return None
            }
            if rhs == .Int(exponent) {
                if exponent < 0 {
                    jet_eval_source_fail(&machine, span, "integer exponent cannot be negative")
                    return None
                }
            }
        }
        member :: if op == {
            .Add -> "add"
            .Sub -> "sub"
            .Mul -> "mul"
            .FloorDiv -> "div_euclid"
            .Mod -> "mod"
            .Rem -> "rem"
            .Pow -> "pow"
            .BitAnd -> "bit_and"
            .BitOr -> "bit_or"
            .BitXor -> "bit_xor"
            .Shl -> "shl"
            .Shr -> "shr"
            else -> ""
        }
        if member != "" {
            return jet_eval_route_exact_integer_member_host(member, [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: lhs},
                JetEvalRuntimeValue.Data{value: rhs},
            }, &machine, result_ty, span)
        }
        if op == MIRBinaryOp.Div {
            return jet_eval_route_precise_member_host("Fraction", "from_parts", [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: lhs},
                JetEvalRuntimeValue.Data{value: rhs},
            }, &machine, result_ty, span)
        }
        jet_eval_compiler_fail(&machine, span, "MIR exact integer operator has no checked Prelude dispatch")
        return None
    }
    if lhs == .Struct(type_name, _) {
        if (type_name == "Decimal" || type_name == "Fraction") && (op == MIRBinaryOp.Add || op == MIRBinaryOp.Sub || op == MIRBinaryOp.Mul || op == MIRBinaryOp.Div) {
            member :: if op == {
                .Add -> "add"
                .Sub -> "sub"
                .Mul -> "mul"
                else -> "div"
            }
            return jet_eval_route_precise_member_host(type_name, member, [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: lhs},
                JetEvalRuntimeValue.Data{value: rhs},
            }, &machine, result_ty, span)
        }
    }
    if lhs == .Float(left_number, left_bits) {
        if rhs == .Float(right_number, right_bits) {
            if op == MIRBinaryOp.Eq -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left_bits == right_bits && left_number == right_number}})
            if op == MIRBinaryOp.Ne -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: left_bits != right_bits || left_number != right_number}})
            if left_bits != right_bits {
                jet_eval_compiler_fail(&machine, span, "MIR primitive operation mixes float widths")
                return None
            }
            if op == MIRBinaryOp.Lt || op == MIRBinaryOp.Gt || op == MIRBinaryOp.Le || op == MIRBinaryOp.Ge {
                result :: if op == {
                    .Lt -> left_number < right_number
                    .Gt -> left_number > right_number
                    .Le -> left_number <= right_number
                    else -> left_number >= right_number
                }
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: result}})
            }
            if op == MIRBinaryOp.Compare {
                if left_number != left_number || right_number != right_number {
                    jet_eval_source_fail(&machine, span, "comparing NaN")
                    return None
                }
                variant :: if {
                    left_number < right_number -> "Less"
                    left_number > right_number -> "Greater"
                    else -> "Equal"
                }
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Enum{type_name: "Ordering", variant: variant, args: [TComptimeEnumArg]{}}})
            }
            result :: if op == {
                .Add -> Val(left_number + right_number)
                .Sub -> Val(left_number - right_number)
                .Mul -> Val(left_number * right_number)
                .Div -> Val(left_number / right_number)
                .Pow -> Val((left_number).pow(right_number))
                else -> Float?{None}
            }
            // Rust MirFloat::binop: an F32 operation rounds to binary32.
            if result == .Val(result_value) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Float{value: if left_bits == 32 -> jet_eval_round_f32(result_value) else -> result_value, bits: left_bits}})
        }
    }
    if op == MIRBinaryOp.Eq -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: jet_eval_value_equal(lhs, rhs)}})
    if op == MIRBinaryOp.Ne -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: !jet_eval_value_equal(lhs, rhs)}})
    jet_eval_compiler_fail(&machine, span, "MIR primitive operator has incompatible operands")
    None
}

fn jet_eval_value_type(machine: &JetEvalMachine, frame_index: Int, value: MIRValueID, span: Span) -> MIRType? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR interpolation function is unavailable")
        return None
    }
    row := jet_eval_function_value_row(&machine, function, value)
    if row == .Val(at) -> return Val(machine.program.functions[function].values[at].ty)
    jet_eval_compiler_fail(&machine, span, "MIR interpolation value has no type fact")
    None
}

fn jet_eval_build_string(machine: &JetEvalMachine, parts: [MIRStringPart], frame_index: Int, span: Span) -> JetEvalRuntimeValue? {
    output := ""
    loop part in parts {
        if part.kind == {
            .Literal(text) -> output = "{output}{text}"
            .Interpolation(value, format) -> {
                runtime_value :: machine.frames[frame_index].values.get(value.value) ?? {
                    jet_eval_compiler_fail(&machine, span, "MIR string interpolation value is unavailable")
                    return None
                }
                value_ty :: jet_eval_value_type(&machine, frame_index, value, span) ?? return None
                rendered :: jet_eval_render_runtime_value(&machine, runtime_value, format, value_ty, span) ?? return None
                output = "{output}{rendered}"
            }
        }
    }
    Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: output}})
}

fn jet_eval_build_list(machine: &JetEvalMachine, values: [MIRValueID], frame_index: Int, span: Span) -> JetEvalRuntimeValue? {
    if values.len() > machine.config.max_collection_len {
        jet_eval_fuel_fail(&machine, span)
        return None
    }
    // Rust: crates/jet-codegen/src/Codegen/MIREval.rs MirOperation::BuildList.
    // Data items build a data list; any runtime item keeps an owned runtime list.
    items := [JetEvalRuntimeValue]{}
    all_data := true
    loop value in values {
        item :: machine.frames[frame_index].values.get(value.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR list value is unavailable")
            return None
        }
        if jet_eval_runtime_contains_moved(item) {
            jet_eval_compiler_fail(&machine, span, "MIR value was moved")
            return None
        }
        if !jet_eval_runtime_is_data(item) -> all_data = false
        &items.push(item)
    }
    if all_data {
        output := [TComptimeValue]{}
        loop item in items -> &output.push(jet_eval_data(item, &machine, span) ?? return None)
        return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: output}})
    }
    owned :: jet_eval_copy_values(&machine, items, span) ?? return None
    Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: owned}})
}

fn jet_eval_build_map(machine: &JetEvalMachine, entries: [MIRMapEntry], frame_index: Int, span: Span) -> JetEvalRuntimeValue? {
    if entries.len() > machine.config.max_collection_len {
        jet_eval_fuel_fail(&machine, span)
        return None
    }
    output := [TComptimeMapEntry]{}
    loop entry in entries {
        key_value :: machine.frames[frame_index].values.get(entry.key.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR map key value is unavailable")
            return None
        }
        value :: machine.frames[frame_index].values.get(entry.value.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR map value is unavailable")
            return None
        }
        key_data :: jet_eval_data(key_value, &machine, span) ?? return None
        data :: jet_eval_data_key(key_data, &machine, span) ?? return None
        value_data :: jet_eval_data(value, &machine, span) ?? return None
        replaced := false
        loop index in 0..<output.len() {
            if output[index].key == data {
                output[index].value = value_data
                replaced = true
            }
        }
        if !replaced -> output = jet_eval_insert_map_entry(output, data, value_data)
    }
    Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Map{entries: output}})
}

fn jet_eval_copy_or_move(machine: &JetEvalMachine, frame_index: Int, value: MIRValueID, copy_value: Bool, span: Span) -> JetEvalRuntimeValue? {
    if copy_value {
        item :: machine.frames[frame_index].values.get(value.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR copy reads an unavailable SSA value")
            return None
        }
        return jet_eval_copy_value(item, &machine, span)
    }
    jet_eval_take(&machine, frame_index, value, span)
}

fn jet_eval_move_argument(machine: &JetEvalMachine, frame_index: Int, arg: MIRCallArg, span: Span) -> JetEvalRuntimeValue? {
    if arg.access == MIRAccess.Write {
        place :: arg.place ?? {
            jet_eval_compiler_fail(&machine, arg.span, "MIR write call argument has no checked place")
            return None
        }
        return Val(JetEvalRuntimeValue.Address{frame: frame_index, place: place, access: MIRAccess.Write})
    }
    if arg.access == MIRAccess.Move {
        return jet_eval_take(&machine, frame_index, arg.value, span)
    }
    item :: machine.frames[frame_index].values.get(arg.value.value) ?? {
        jet_eval_compiler_fail(&machine, arg.span, "MIR call argument value is unavailable")
        return None
    }
    jet_eval_borrow_value(item, &machine, span)
}

// Discharge every value in an owned list; cleanup continues past a failed drop.
fn jet_eval_drop_values(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], span: Span) -> Bool {
    ok := true
    loop value in values {
        if !jet_eval_drop_value(&machine, value, span) -> ok = false
    }
    ok
}

// Discharge only values marked owned by call preparation or temporary materialization.
fn jet_eval_drop_call_values(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], owned: [Bool], span: Span) -> Bool {
    ok := true
    loop index in 0..<values.len() {
        if index < owned.len() && owned[index] && !jet_eval_drop_value(&machine, values[index], span) -> ok = false
    }
    ok
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::marshal_call_arg
fn jet_eval_marshal_union_argument(machine: &JetEvalMachine, value: JetEvalRuntimeValue, arg: MIRCallArg, span: Span) -> JetEvalRuntimeValue? {
    coercion :: arg.widen_to_union ?? return Val(value)
    type_name :: jet_eval_type_name(&machine, coercion.union, arg.span) ?? return None
    data :: jet_eval_data(value, &machine, span) ?? return None
    if data == .Enum(existing_name, existing_variant, _) {
        if existing_name == type_name && jet_eval_variant_name_matches(existing_variant, coercion.variant) {
            return Val(value)
        }
    }
    payload :: TComptimeEnumArg{name: None, value: data}
    wrapped :: TComptimeValue.Enum{type_name: type_name, variant: coercion.variant, args: [TComptimeEnumArg]{payload}}
    Val(JetEvalRuntimeValue.Data{value: wrapped})
}

fn jet_eval_call_arguments(machine: &JetEvalMachine, frame_index: Int, args: [MIRCallArg], span: Span) -> JetEvalPreparedCallArguments? {
    output := [JetEvalRuntimeValue]{}
    owned := [Bool]{}
    loop arg in args {
        source :: jet_eval_move_argument(&machine, frame_index, arg, span) ?? {
            jet_eval_drop_call_values(&machine, output, owned, span)
            return None
        }
        value :: jet_eval_marshal_union_argument(&machine, source, arg, span) ?? {
            if arg.access == MIRAccess.Move -> jet_eval_drop_value(&machine, source, span)
            jet_eval_drop_call_values(&machine, output, owned, span)
            return None
        }
        if {
            arg.spread -> {
                data :: jet_eval_data(value, &machine, span) ?? {
                    if arg.access == MIRAccess.Move -> jet_eval_drop_value(&machine, value, span)
                    jet_eval_drop_call_values(&machine, output, owned, span)
                    return None
                }
                if data == {.List(items) -> {
                    loop item in items {
                        &output.push(JetEvalRuntimeValue.Data{value: item})
                        &owned.push(false)
                    }
                } else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR spread argument is not a List")
                    if arg.access == MIRAccess.Move -> jet_eval_drop_value(&machine, value, span)
                    jet_eval_drop_call_values(&machine, output, owned, span)
                    return None
                }}
                if arg.access == MIRAccess.Move && !jet_eval_drop_value(&machine, value, span) {
                    jet_eval_drop_call_values(&machine, output, owned, span)
                    return None
                }
            }
            else -> {
                &output.push(value)
                &owned.push(arg.access == MIRAccess.Move)
            }
        }
    }
    Val(JetEvalPreparedCallArguments{values: output, move_permissions: owned})
}

fn jet_eval_window_path(machine: &JetEvalMachine, frame_index: Int, projections: [MIRProjection], span: Span) -> JetEvalWindowPath? {
    operands := [U64:JetEvalRuntimeValue]{}
    loop projection in projections {
        source := MIRValueID?{None}
        if projection == .Index(_, index, _, _, _, _, _) -> source = Val(index)
        if projection == .Range(range, _, _) -> source = Val(range)
        if projection == .MapLookup(lookup, _, _) {
            result :: jet_eval_value(&machine, frame_index, lookup, span) ?? return None
            if result == .Result(lookup_ok, _) && !lookup_ok {
                ty :: jet_eval_value_type(&machine, frame_index, lookup, span) ?? return None
                if ty.kind == .Option(pointer) {
                    if pointer.kind == .Apply(_, args) && args.len() > 0 {
                        operands[lookup.value] = JetEvalRuntimeValue.Absent{element: args[0]}
                        next
                    }
                }
                jet_eval_compiler_fail(&machine, span, "MIR map lookup has no checked pointer element type")
                return None
            }
            operands[lookup.value] = result
        }
        if source == .Val(id) {
            // copy: the frame's operand value (owner: the machine) is handed to the window path
            // walk beside `&machine`; a view into machine would be live across that exclusive
            // borrow (E0212), and the machine keeps its own row.
            value :: machine.frames[frame_index].values.get(id.value).copy() ?? {
                jet_eval_compiler_fail(&machine, span, "MIR window projection operand is unavailable")
                return None
            }
            // Index/range operands are ordinary data, never retained stack
            // capabilities or registry-owned aliases.
            data :: jet_eval_data(value, &machine, span) ?? return None
            operands[id.value] = JetEvalRuntimeValue.Data{value: data}
        }
    }
    Val(JetEvalWindowPath{projections: projections, operands: operands})
}

fn jet_eval_window_from_place(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return None
    place :: jet_eval_function_place(&machine, function, place_id) ?? return None
    held :: jet_eval_read_base_raw(&machine, frame_index, place.base, span) ?? return None
    owner := JetEvalRuntimeValue.Address{frame: frame_index, place: place_id, access: MIRAccess.Write}
    if held == .Address(_, _, _) || held == .Window(_, _) {
        owner = held
        projections := place.projections
        if projections.len() > 0 && projections[0] == .Deref(_) {
            projections = projections.slice(1, projections.len())
        }
        path :: jet_eval_window_path(&machine, frame_index, projections, span) ?? return None
        return Val(JetEvalRuntimeValue.Window{owner: owner, path: path})
    }
    // Even an unprojected exclusive view has capability semantics: pure
    // kernels may inspect it, but copying the capability never copies storage.
    Val(JetEvalRuntimeValue.Window{owner: owner, path: JetEvalWindowPath{projections: [MIRProjection]{}, operands: [U64:JetEvalRuntimeValue]{}}})
}

fn jet_eval_read_window(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> JetEvalRuntimeValue? {
    if value == .Address(frame, place, access) {
        if access == MIRAccess.Move {
            jet_eval_ownership_fail(&machine, span, "MIR window reads a move-only address")
            return None
        }
        return jet_eval_read_place(&machine, frame, place, span)
    }
    if value == .Window(owner, path) {
        selected :: jet_eval_read_window(&machine, owner, span) ?? return None
        result := jet_eval_project_operands(selected, path.projections, path.operands, &machine, span)
        jet_eval_drop_value(&machine, selected, span)
        return result
    }
    jet_eval_compiler_fail(&machine, span, "MIR window has no owner address")
    None
}

// The data behind an address or window, read through it.
fn jet_eval_window_data(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> TComptimeValue? {
    selected :: jet_eval_read_window(&machine, value, span) ?? return None
    data := jet_eval_data(selected, &machine, span)
    jet_eval_drop_value(&machine, selected, span)
    data
}

// Consumes the replacement just like write_place. Window paths are composed
// by ordinary projected replacement, including nested ranges and fields.
fn jet_eval_write_window(machine: &JetEvalMachine, target: JetEvalRuntimeValue, replacement: JetEvalRuntimeValue, span: Span) -> Bool {
    if target == .Address(frame, place, access) {
        if access == MIRAccess.Write -> return jet_eval_write_place(&machine, frame, place, replacement, span)
        jet_eval_ownership_fail(&machine, span, "MIR window writes a read-only address")
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    if target == .Window(owner, path) {
        selected :: jet_eval_read_window(&machine, owner, span) ?? {
            jet_eval_drop_value(&machine, replacement, span)
            return false
        }
        updated :: jet_eval_replace_operands(selected, path.projections, 0, path.operands, replacement, &machine, span) ?? {
            jet_eval_drop_value(&machine, selected, span)
            jet_eval_drop_value(&machine, replacement, span)
            return false
        }
        return jet_eval_write_window(&machine, owner, updated, span)
    }
    jet_eval_compiler_fail(&machine, span, "MIR window has no writable owner")
    jet_eval_drop_value(&machine, replacement, span)
    false
}

fn jet_eval_write_subrange(machine: &JetEvalMachine, route: MIRPreludeCallID, args: [MIRCallArg], values: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, route, span) ?? return None
    if row.module_name != "core.builtin" || row.member != "view_mut_new" -> return None
    if values.len() < 2 || args.len() != values.len() -> return None
    owner :: values[0]
    if owner == {
        .Address(_, _, _) | .Window(_, _) -> {}
        else -> return None
    }
    parts := JetEvalRangeParts{start: 0, end: 0, exclusive: false}
    if values.len() == 2 {
        data :: jet_eval_data(values[1], &machine, span) ?? return None
        parts = jet_eval_range_parts(&machine, data, span) ?? return None
    } else {
        parts.start = jet_eval_int(values[1], &machine, span) ?? return None
        parts.end = jet_eval_int(values[2], &machine, span) ?? return None
    }
    selected :: jet_eval_read_window(&machine, owner, span) ?? return None
    data := jet_eval_data(selected, &machine, span)
    jet_eval_drop_value(&machine, selected, span)
    items :: data ?? return None
    length :: if items == {
        .List(list) -> list.len()
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR write window owner is not a list")
            return None
        }
    }
    bounds :: jet_eval_range_bounds(parts, length) ?? {
        jet_eval_source_fail(&machine, span, "can't view {length} items from {parts.start} to {parts.end} ({if parts.exclusive -> "exclusive" else -> "inclusive"})")
        return None
    }
    range :: args[1].value
    frozen :: TComptimeValue.Struct{type_name: "Range", fields: [
        TComptimeField{name: "start", value: TComptimeValue.Int{value: bounds[0]}},
        TComptimeField{name: "end", value: TComptimeValue.Int{value: bounds[1]}},
        TComptimeField{name: "exclusive", value: TComptimeValue.Bool{value: true}},
    ]}
    operands := [U64:JetEvalRuntimeValue]{}
    operands[range.value] = JetEvalRuntimeValue.Data{value: frozen}
    location :: MIRPanicLoc{file: mir_source_file_id(""), line: 0, column: 0}
    path :: JetEvalWindowPath{projections: [MIRProjection]{MIRProjection.Range{range: range, location: location, span: span}}, operands: operands}
    Val(JetEvalRuntimeValue.Window{owner: owner, path: path})
}
