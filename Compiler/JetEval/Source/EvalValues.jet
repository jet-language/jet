pub struct JetEvalError {
    pub kind: JetEvalErrorKind
    pub diagnostic: Diagnostic
}
// Callback output is a scoped transcript. Each host Effect/Control append
// already publishes one event to the shared output context; the native owner
// must merge this transcript into its local result only, never publish it a
// second time.
 
pub enum JetEvalCallbackOutcome {
    Value(value: JetEvalRuntimeValue)
    Failure(error: JetEvalError)
    InternalProblem(problem: JetEvalInternalProblem)
    SoftStop
    Exit(code: Int)
}

pub struct JetEvalCallbackResult {
    pub outcome: JetEvalCallbackOutcome
    pub stdout: String
    pub stderr: String
}
pub struct JetEvalTaskCallbackInvokeResult {
    pub root: JetEvalTaskRoot
    pub result: JetEvalCallbackResult
    pub reusable: Bool
    // Fresh execution root that owns returned aliases independently of `root.origin`.
    pub cleanup_root: JetEvalOwnedRoot
}


trait JetEvalHostAdapter {
    fn new_session(self) -> JetEvalHostAdapter
    fn clone_adapter(self) -> JetEvalHostAdapter
    fn poll_callbacks(self, machine: &JetEvalMachine) -> Bool
    fn drain_callbacks(self, machine: &JetEvalMachine) -> Bool
    fn host_call(self, machine: &JetEvalMachine, target: JetEvalHostCallTarget, static_operand: JetEvalHostStaticOperand?, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, arg_shapes: [JetEvalHostTypeShape], span: Span) -> JetEvalHostResult?
    fn foreign_call(self, machine: &JetEvalMachine, row: MirForeign, args: ^[JetEvalHostArgument], span: Span) -> JetEvalHostResult?
    fn handle_call(self, machine: &JetEvalMachine, operation: String, handle: MirHandleId, raw: Int, span: Span) -> JetEvalHostResult?
    // Cleanup-only path for Source backing-root refs and provisional owner
    // leases. A committed allocator lease is released by the allocator's
    // normal handle drop instead.
    fn fixed_backing_release(self, machine: &JetEvalMachine, handle: MirHandleId, raw: Int, lease: Int?, span: Span) -> JetEvalHostResult?
    fn fixed_backing_access(self, machine: &JetEvalMachine, root: JetEvalHostFixedBackingStorage, operation: JetEvalHostFixedBackingOperation, span: Span) -> JetEvalHostFixedBackingAccessResult?
    fn physical_binding(self) -> JetEvalHostValue
    fn native_call(self, machine: &JetEvalMachine, binding: JetEvalNativeCallBinding, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -> JetEvalHostResult?
    fn channel_select(self, machine: &JetEvalMachine, row: MirPreludeCall, kind: MirSelectKind, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -> JetEvalHostResult?
    fn task_group(self, machine: &JetEvalMachine, row: MirPreludeCall, kind: MirTaskGroupKind, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -> JetEvalHostResult?
    fn shared_call(self, machine: &JetEvalMachine, operation: JetEvalSharedPhysicalOp, row: MirPreludeCall, map_row: MirPreludeCall?, shared: JetEvalRuntimeValue, guard: JetEvalRuntimeValue?, condition: JetEvalRuntimeValue?, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -> JetEvalHostResult?
}

pub struct JetEvalConfig {
    // Step budget for compile-time evaluation. Runtime execution (a program
    // run) has no step limit, like a built binary (D-INTERP-BUDGET1).
    pub fuel: Int
    pub max_call_depth: Int
    pub max_collection_len: Int
    pub globals: [String:TComptimeValue]
    pub runtime_execution: Bool
    pub host_adapter: JetEvalHostAdapter?
    pub output_context: JetEvalOutputContext?
    pub numeric_unit_conversion_exact: (fn(Float, String, String, String, String) -> Float?)?
    pub typed_boundary_literal_validate: (fn(MirTypedHeadKind, [String]) -> String?)?
}
pub fn jet_eval_default_config() -> JetEvalConfig Never! {
    JetEvalConfig{fuel: 10000000, max_call_depth: 1024, max_collection_len: 1000000, globals: [String:TComptimeValue]{}, runtime_execution: false, host_adapter: None, output_context: None, numeric_unit_conversion_exact: None, typed_boundary_literal_validate: None}
}
