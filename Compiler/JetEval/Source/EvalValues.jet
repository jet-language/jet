// Runtime state and exact scalar/aggregate values for canonical MIR evaluation.
// TComptimeValue is the shared Foundation carrier; Eval-owned variants keep
// move/address/shared-cell/call-frame state out of that semantic schema.

pub enum JetEvalRuntimeValue {
    Moved
    Data(value: TComptimeValue)
    Absent(element: MirType)
    Result(ok: Bool, value: JetEvalRuntimeValue)
    Closure(function: MirFunctionId, captures: [JetEvalRuntimeValue])
    Address(frame: Int, place: MirPlaceId, access: MirAccess)
    SharedCell(index: Int, access: MirAccess)
    Shared(index: Int)
    SharedWeak(index: Int)
    SharedGuard(index: Int)
    SharedSnapshot(index: Int)
    Condition(index: Int)
    RangeCursor(start: Int, end: Int, current: Int, step: Int, exclusive: Bool)
    ListCursor(values: [JetEvalRuntimeValue], index: Int, step: Int)
    ForeignHandle(handle: MirHandleId, raw: Int, token: Int)
    Aggregate(value: JetEvalRuntimeAggregate)
    RuntimeFailure(value: JetEvalRuntimeValue, span: Span)
    HostCursor(value: JetEvalRuntimeValue, has_next: MirPreludeCallId, value_call: MirPreludeCallId, advance: MirPreludeCallId)
}
pub struct JetEvalCallbackRoot {
    pub value: JetEvalRuntimeValue
    pub reusable: Bool
    pub invoked: Bool
}

// One owned logical reference per registry-naming runtime value. Each
// SharedCell/ForeignHandle value held by a slot (SSA value, local, parameter,
// capture, aggregate element, closure capture, callback root, cell or token
// payload, task root, result) owns exactly one alias: jet_eval_copy_value mints
// one, jet_eval_drop_value discharges one, moves transfer without counting.
// Payload and ownership metadata use separate physical permits so retaining or
// transferring a handle never waits on a payload guard. Every metadata
// check-and-update runs under one edit permit.
pub struct JetEvalSharedCellData {
    pub value: JetEvalRuntimeValue
}
pub struct JetEvalSharedCellMeta {
    pub access: MirAccess
    pub aliases: Int
    pub dropped: Bool
}
pub struct JetEvalSharedCell {
    pub storage: Shared<JetEvalSharedCellData>
    pub metadata: Shared<JetEvalSharedCellMeta>
}

pub struct JetEvalOutputEvent {
    pub stdout: String
    pub stderr: String
}
pub struct JetEvalOutputState {
    pub events: [JetEvalOutputEvent]
}
pub struct JetEvalOutputContext {
    pub storage: Shared<JetEvalOutputState>
}

// Session-local canonical identity registry. Every machine of one session
// (root, deopt resume, child tasks, native callbacks) shares this physical
// storage; no machine sweeps it. Index and token allocation happens under one
// registry edit permit so concurrent machines never collide.
pub struct JetEvalRegistryData {
    pub shared_cells: [JetEvalSharedCell]
    pub foreign_tokens: [Int:JetEvalForeignToken]
    pub next_foreign_token: Int
    pub next_callback_lease: Int
    pub next_machine_identity: Int
}
pub struct JetEvalRegistry {
    pub storage: Shared<JetEvalRegistryData>
    pub shared_runtime: JetEvalSharedRuntime
}
// Transport-only Source task root. Native scheduling owns task control and
// ambient context; this carrier owns exactly the callback root moved (FnOnce)
// or retained (reusable) out of the parent machine plus the shared registry
// handle. It deliberately contains no HostAdapter, Machine, frame, stack
// address, or inventory list.
pub struct JetEvalTaskRoot {
    pub origin: JetEvalOwnedRoot
    pub callback_lease: Int
    pub callback: JetEvalCallbackRoot
}
// Outcome of discharging one owned alias of a registry entry.
pub enum JetEvalAliasRelease { Remaining Last Detached }


pub struct JetEvalRuntimeMapEntry {
    pub key: JetEvalRuntimeValue
    pub value: JetEvalRuntimeValue
}
pub struct JetEvalRuntimeField {
    pub name: String
    pub value: JetEvalRuntimeValue
}
pub struct JetEvalRuntimeEnumArg {
    pub name: String?
    pub value: JetEvalRuntimeValue
}
pub enum JetEvalRuntimeAggregate {
    List(values: [JetEvalRuntimeValue])
    Map(entries: [JetEvalRuntimeMapEntry])
    Struct(type_name: String, fields: [JetEvalRuntimeField])
    Enum(type_name: String, variant: String, args: [JetEvalRuntimeEnumArg])
}

pub struct JetEvalHostMapEntry {
