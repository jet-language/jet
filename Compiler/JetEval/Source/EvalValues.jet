}
pub struct JetEvalHostField {
    pub name: String
    pub value: JetEvalHostValue
}
pub struct JetEvalHostEnumArg {
    pub name: String?
    pub value: JetEvalHostValue
}
pub struct JetEvalHostTypeFieldShape {
    pub name: String
    pub node: Int
}
pub struct JetEvalHostTypeArgShape {
    pub name: String?
    pub node: Int
}
pub struct JetEvalHostTypeVariantShape {
    pub name: String
    pub args: [JetEvalHostTypeArgShape]
}
pub enum JetEvalHostTypeNode {
    Scalar(ty: MirType)
    Option(inner: Int)
    Result(ok: Int, error: Int)
    List(inner: Int)
    Map(key: Int, value: Int)
    Tuple(fields: [JetEvalHostTypeFieldShape])
    Struct(type_id: MirTypeId, type_name: String, args: [Int], fields: [JetEvalHostTypeFieldShape])
    Enum(type_id: MirTypeId, type_name: String, args: [Int], variants: [JetEvalHostTypeVariantShape])
    Closure(ty: MirType, function: MirFunctionId, captures: [Int])
    Handle(ty: MirType, owner: JetEvalHostOwner)
}
pub struct JetEvalHostTypeShape {
    pub root: Int
    pub nodes: [JetEvalHostTypeNode]
}
enum JetEvalHostCoreOwnerCheck { Missing Valid(owner: MirCoreOwner) Invalid(message: String) }
pub struct JetEvalNativeCallableBinding {
    pub key: String
    pub callable_type: MirType
}
pub enum JetEvalNativeBindingIdentity {
    Callable(binding: JetEvalNativeCallableBinding)
    Interface(receiver_type: MirType)
}
pub struct JetEvalNativeInterfaceBinding {
    pub trait_ref: MirTraitRef
    pub method_id: MirTraitMethodId
    pub method_name: String
    pub receiver_type: MirType
    pub receiver_access: MirAccess
}
pub enum JetEvalNativeCallBinding {
    Callable(binding: JetEvalNativeCallableBinding)
    Interface(binding: JetEvalNativeInterfaceBinding)
}

pub struct JetEvalHostFixedBackingKey {
    pub machine_identity: Int
    pub frame: Int
    pub function: MirFunctionId
    pub local: MirLocalId
    pub place: MirPlaceId
}
pub enum JetEvalHostFixedBackingSlot { Uninitialized Initialized(value: Int) }
pub struct JetEvalHostFixedBackingStorage {
    pub handle: MirHandleId
    pub raw: Int
    // Source registry token for this alias; never a provider storage ID.
    pub token: Int
    pub element_type: MirType
    pub length: Int
}
pub struct JetEvalHostFixedBackingRequest {
    pub key: JetEvalHostFixedBackingKey
    pub element_type: MirType
    pub length: Int
    pub span: Span
    pub existing: JetEvalHostFixedBackingStorage?
    // Present only on first materialization; this transfers initialized U8
    // slots once while preserving uninitialized slots as such.
    pub initial_slots: [JetEvalHostFixedBackingSlot]
}
// Read checks one bitmap slot. ReadArray/TakeArray mirror JetUninitFixed's
// canonical full-array view/move operations; writes update provider-owned
// initialization state, never deriving it from bytes written by Fixed.over.
pub enum JetEvalHostFixedBackingOperation {
    Read(index: Int)
    Write(index: Int, value: Int)
    ReadArray
    TakeArray
}
// Read/Write may report bounds failure; read operations may report an
// uninitialized slot. Array operations only return bytes after all slots pass
// the canonical readiness check.
pub enum JetEvalHostFixedBackingAccessResult {
    Byte(value: Int)
    Bytes(values: [Int])
    Unit
    OutOfBounds
    Uninitialized
}
pub enum JetEvalHostValue {
    Data(value: TComptimeValue)
    Handle(handle: MirHandleId, raw: Int, owner: JetEvalHostOwner, payload: JetEvalHostValue)
    Absent(element: MirType)
    Present(value: JetEvalHostValue)
    Failed(value: JetEvalHostValue)
    List(values: [JetEvalHostValue])
    Map(entries: [JetEvalHostMapEntry])
    Struct(type_name: String, fields: [JetEvalHostField])
    Enum(type_name: String, variant: String, args: [JetEvalHostEnumArg])
    Closure(function: MirFunctionId, captures: [JetEvalHostValue])
    SourceCallback(lease: Int)
    FixedBacking(request: JetEvalHostFixedBackingRequest)
    SharedCarrier(carrier: JetEvalSharedHostCarrier)
}
// Canonical static MIR operands cross the existing host-call boundary as
// typed metadata; they are never fabricated runtime values.
pub enum JetEvalHostStaticOperand {
    TextPattern(parts: [MirTextPatternPart])
    BinaryPattern(parts: [MirBinaryPatternPart])
    CellGuardProject(paths: [[MirFieldId]], editable: Bool, edit_paths_disjoint: Bool, split_route: MirPreludeCall?)
    GcEdit(kind: MirGcEditKind, site: MirGcEditSiteId, edge_count: Int, has_index: Bool, edge_shapes: [JetEvalHostTypeShape])
    HandleMethodSchedule(frame_schedule: MirFrameSchedule?, frame_schedule_derivation: MirDerivationRef?)
    PluginInvoke(export_name: String, signature: MirComponentSignatureDescriptor)
    HttpRouterRegister(method: MirHttpMethod, handler_param_names: [String], contract_json: String, location: MirPanicLoc)
    AllocNew(kind: MirAllocatorKind, inline_size: Int?, checked_args: [MirCallArg], physical_ranges: [JetEvalHostArgumentRange])
}
pub struct JetEvalHostArgumentRange {
    pub start: Int
    pub count: Int
}
pub enum JetEvalHostCallTarget {
    Prelude(row: MirPreludeCall)
    CursorTakePattern(receiver_place: MirPlaceId, parts: [MirTextPatternPart])
    ReaderTakePattern(receiver_place: MirPlaceId, parts: [MirBinaryPatternPart])
}
// One prepared native argument: the Source carrier (borrowed, still owned by
// the call site), its host projection, and whether the checked call site lets
// the native side consume it through a transfer receipt.
pub struct JetEvalHostArgument {
    pub value: JetEvalRuntimeValue
    pub host: JetEvalHostValue
    pub moved: Bool
}
struct JetEvalPreparedCallArguments {
    values: [JetEvalRuntimeValue]
    move_permissions: [Bool]
}
struct JetEvalPreparedValues {
    values: [JetEvalRuntimeValue]
    owned: [Bool]
}


pub struct JetEvalHostCoreOwner {
    pub fact: MirCoreOwner
    pub ty: MirType
}
// Native identity is a checked Fn value or interface VALUE type. Method
// identity belongs to JetEvalNativeCallBinding.Interface, not this retained
// physical owner identity. `handle`/`raw` are the binding scope's real arena
// capability, never a MIR identity.
pub enum JetEvalHostOwner { Cursor Declared(ty: MirType) Core(owner: JetEvalHostCoreOwner) Native(binding: JetEvalNativeBindingIdentity) FixedBackingRoot(element_type: MirType, length: Int) }
pub enum JetEvalForeignTokenKind { Foreign Cursor Declared(ty: MirType) Core(owner: JetEvalHostCoreOwner) Native(binding: JetEvalNativeBindingIdentity) FixedBackingRoot(element_type: MirType, length: Int) }

pub struct JetEvalHostWriteback {
    pub argument: Int
    pub value: JetEvalHostValue
}

pub struct JetEvalEntryWriteback {
    pub argument: Int
    pub ty: MirType
    pub value: JetEvalRuntimeValue
}

pub struct JetEvalEntryWritebackBatch {
