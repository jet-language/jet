// The compile-time evaluator's configuration, host adapters and failure
// carriers. Compile-time code runs natively in a child of the compiler
// (IR/Native.jet); values are the shared Foundation carrier TComptimeValue.
use {
    jet_foundation.[
        Diagnostic,
        Span,
        TComptimeValue,
        diagnostic_from_registry,
    ]
    jet_sema.[
        SemaRegistrationHostHooks,
        sema_checked_const_char,
        sema_numeric_unit_conversion_exact_service,
    ]
}

JetEvalErrorKind: enum { Source Compiler Unsupported Fuel Ownership Effect ComptimePanic }

JetEvalInternalProblem: struct {
    span: Span?
    message: String
}

JetEvalError: struct {
    kind: JetEvalErrorKind
    diagnostic: Diagnostic
}

// Installed only for a checked fn-build or fn-dev invocation, which the IR
// machine runs (IR/Host.jet). The ordinary comptime evaluation deliberately
// cannot acquire network or wait rights.
JetEvalBuildHostAdapter: trait {
    clone_adapter: fn(self) -[]> JetEvalBuildHostAdapter
    // Build host method `member` (`Build.add_executable`, `BuildPlan.graph`,
    // `Dev.watch`) on `args`, the receiver first; `fallible` when the checked
    // call returns a Result, `impure` when it sits in an `#Impure` block.
    // None: no method of this host.
    build_call: fn(self, member: String, args: [TComptimeValue], fallible: Bool, impure: Bool, span: Span) -[FS.Read, Net, Time.Wait]> JetEvalBuildReply?
}

// A host method's answer (a build host's, a compiler query host's): its
// value (a fallible method's success as Present, its typed failure as a
// told Failed), or the diagnostic that stops the evaluation.
JetEvalBuildReply: enum {
    Value(value: TComptimeValue)
    Failure(diagnostic: Diagnostic)
}

// The compiler's answer to a Tier-1 comptime input (`embed_file`,
// `embed_bytes`, `find`) named by a checked literal path relative to the
// source file being compiled, and to the pinned `net.fetch(url, sha256:)`.
// The driver installs it for comptime evaluation: it owns the rooted,
// no-follow read, the bounded fetch, their bounds and the input record. A
// failure is the diagnostic the read (E0955) or the fetch (E3413, E3414)
// reports.
#Error
JetEvalComptimeInputError: struct {
    diagnostic: Diagnostic
}

JetEvalComptimeInputAdapter: trait {
    clone_input_adapter: fn(self) -[]> JetEvalComptimeInputAdapter
    comptime_input: fn(self, builtin: String, path: String, span: Span) -[FS.Read]> TComptimeValue JetEvalComptimeInputError!
    comptime_fetch: fn(self, url: String, sha256: String, span: Span) -[FS.Read, Net, Time.Wait]> TComptimeValue JetEvalComptimeInputError!
}

// The compiler's answer to a `core.compiler` query (`compiler.lex(source)`,
// `compiler.parse`, `compiler.check(syntax)`, `compiler.profiles()`) in
// compile-time code: the compiler's own lexer, parser and checker over the
// query's source, and its package model over the pinned package root. The
// driver installs it for comptime evaluation and fn-build invocations; a
// check is a whole compile of its source, with that compile's effects, and
// the profile view evaluates `env.jet`, whose compile-time expressions run
// through the compiler service (Exec, Time.Wait); a check's trace spans read
// the task CPU clock (Time).
JetEvalCompilerQueryHost: trait {
    clone_compiler_host: fn(self) -[]> JetEvalCompilerQueryHost
    // Query `query` on `args`: its typed Result (Present, or a told Failed
    // CompilerError). None: no query of this host.
    compiler_query: fn(self, query: String, args: [TComptimeValue], span: Span) -[Env, Exec, FFI.Asm, FS, Net, Time]> JetEvalBuildReply?
}

JetEvalConfig: struct {
    // Budget for one compile-time call: a native call has fuel /% 2000
    // milliseconds (IR/Native.jet). Build-time code keeps it: a `build: fn`
    // or `dev: fn` run is one call, so the `meta.events` handlers a build
    // runs spend the build's budget. A negative fuel has no limit: a program
    // run, like a built binary.
    fuel: Int
    max_call_depth: Int
    max_collection_len: Int
    globals: [String:TComptimeValue]
    runtime_execution: Bool
    build_host_adapter: JetEvalBuildHostAdapter?{None}
    comptime_input_adapter: JetEvalComptimeInputAdapter?{None}
    compiler_query_host: JetEvalCompilerQueryHost?{None}
    // Compiler-service callbacks live behind one Shared cell: a config copy
    // shares the hooks instead of copying function values.
    host_hooks: Shared<SemaRegistrationHostHooks>
    // The compile session's native children over the runtime image
    // (IR/Native.jet); None: this toolchain has no runtime image, so
    // compile-time code can't run.
    native: Shared<JetEvalNativeSession>?{None}
    // `jet eval`'s `run`: an ambient effect is refused as the evaluator mode
    // refuses it (E3401, jet_eval_effect_fail), not as a comptime effect a
    // gate admits (E3410).
    eval_entry: Bool{false}
    // The evaluated item sits inside an `#Impure` block: a Tier-2 effect is
    // refused for the missing invocation gate (E3411), not the block (E3410).
    impure: Bool{false}
    // The invocation opened the impure gate (`--gate impure=allow`): the file
    // calls of code inside `#Impure` run natively in the comptime child, and
    // any other Tier-2 effect there is refused as one the child doesn't admit
    // (E3401), never as a missing gate.
    impure_gate: Bool{false}
    // The evaluated item's first call with a host effect, written as its
    // source names it (`core.files.read()`): a refused system call names it
    // in place of the effect class.
    effect_call: String?{None}
}

jet_eval_default_config: fn() -> JetEvalConfig Never! {
    JetEvalConfig{fuel: 10000000, max_call_depth: 1024, max_collection_len: 1000000, globals: [String:TComptimeValue]{}, runtime_execution: false, host_hooks: Shared{SemaRegistrationHostHooks{numeric_unit_conversion_exact: Val(sema_numeric_unit_conversion_exact_service)}}}
}

// Read-fork a fresh runtime configuration before an owning request is moved.
// Every field is reconstructed; adapter cloning is the sole host-session copy.
jet_eval_runtime_config: fn(config: JetEvalConfig) -> JetEvalConfig {
    build_host_adapter: if config.build_host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    JetEvalConfig{
        fuel: config.fuel,
        max_call_depth: config.max_call_depth,
        max_collection_len: config.max_collection_len,
        globals: config.globals,
        runtime_execution: true,
        build_host_adapter: build_host_adapter,
        host_hooks: config.host_hooks,
        native: config.native,
    }
}

jet_eval_diagnostic: fn(kind: JetEvalErrorKind, span: Span, what: String, why: String, fix: String) -> JetEvalError {
    code := "E0956"
    if kind == JetEvalErrorKind.Fuel -> code = "E0952"
    if kind == JetEvalErrorKind.Effect -> code = "E3401"
    if kind == JetEvalErrorKind.ComptimePanic -> code = "E0953"
    JetEvalError{kind: kind, diagnostic: diagnostic_from_registry(code, Val(span), what, why, fix)}
}

// A source failure is the program's own stop (E3010). Running a program, it
// names the runtime result; computing a compile-time value, it is the same
// stop the program would make at run time, reported once in the registry's
// words, with no compile-time cascade.
jet_eval_source_error: fn(runtime_execution: Bool, span: Span, what: String) -> JetEvalError Never! {
    if !runtime_execution {
        return JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3010", Val(span), "`{what}`", "the operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.", "check the operands or bounds before the operation, or use a checked operation that returns an outcome.")}
    }
    JetEvalError{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3010", Val(span), what, "the operands or position do not produce a valid runtime result", "check the operands or bounds before the operation")}
}

// Comptime Char data carries the Unicode scalar value, as sema's checked
// constants do.
jet_eval_char_value: fn(character: Char) -> TComptimeValue Never! {
    code: sema_checked_const_char("{character}") ?? panic("a Char always encodes one UTF-8 scalar")
    TComptimeValue.Char{value: code}
}
