    pub function: MirFunctionId
    pub block: MirBlockId
    pub ip: Int
    pub predecessor: MirBlockId?
    pub params: [JetEvalRuntimeValue]
    pub captures: [JetEvalRuntimeValue]
    pub values: [Int:JetEvalRuntimeValue]
    pub borrowed_values: [Int:Bool]
    pub locals: [Int:JetEvalRuntimeValue]
    pub scopes: [MirScopeId]
    pub entry_accesses: [MirAccess]
    pub entry_shared_loans: [JetEvalSharedEntryLoan]
