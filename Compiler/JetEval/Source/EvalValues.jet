    pub program: MirProgram
    pub registry: JetEvalRegistry
    config: JetEvalConfig
}
pub enum JetEvalOwnedRootDropDisposition { Cleaned ConsumedFailure }
pub struct JetEvalOwnedRootDropResult {
    pub disposition: JetEvalOwnedRootDropDisposition
    pub failure: JetEvalError?
    pub internal_problem: JetEvalInternalProblem?
    pub stdout: String
    pub stderr: String
}


