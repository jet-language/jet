// Retained checked-MIR steps. The executor is jet_eval_run_until, the same
// instruction/terminator/callback/drop path used by every JetEval entry.
use jet_foundation.[MIRAccess, MIRBlockID, MIRFunctionID, MIRProgram, MIRValueID, diagnostic_with_detail, mir_type_is_unit]

struct JetEvalRunBoundary {
    function: MIRFunctionID
    block: MIRBlockID
}

struct JetEvalReplSession {
    machine: JetEvalMachine
    valid: Bool
}

struct JetEvalReplStepResult {
    complete: Bool
    echo: String?
    echo_type: String?{None}
    stdout: String
    stderr: String
    steps: Int
    error: JetEvalError?
    internal_problem: JetEvalInternalProblem?
    bindings_reset: Bool
}

fn jet_eval_repl_session_new(program: ^MIRProgram, config: ^JetEvalConfig, root: MIRFunctionID) -> JetEvalReplSession {
    runtime_config := config
    runtime_config.runtime_execution = true
    machine := jet_eval_machine(^program, ^runtime_config)
    machine.bound_runtime_fuel = true
    function :: jet_eval_find_function(machine, root) ?? {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "REPL checked MIR root is missing")
        return JetEvalReplSession{machine: ^machine, valid: false}
    }
    if function.params.len() != 0 || !function.target_applicability.interpreter {
        jet_eval_compiler_fail(&machine, function.span, "REPL root must be an interpreter-applicable zero-parameter function")
        return JetEvalReplSession{machine: ^machine, valid: false}
    }
    &machine.frames.push(jet_eval_frame(root, function.entry, [JetEvalRuntimeValue]{}, [JetEvalRuntimeValue]{}, [MIRAccess]{}, [JetEvalSharedEntryLoan]{}, false))
    JetEvalReplSession{machine: ^machine, valid: true}
}

fn jet_eval_repl_step_result(session: JetEvalReplSession, complete: Bool, echo: String?, reset: Bool) -> JetEvalReplStepResult Never! {
    JetEvalReplStepResult{complete: complete, echo: echo, stdout: session.machine.stdout, stderr: session.machine.stderr, steps: session.machine.steps, error: session.machine.failure, internal_problem: session.machine.internal_problem, bindings_reset: reset}
}

fn jet_eval_repl_run_step(session: &JetEvalReplSession, program: ^MIRProgram, boundary: JetEvalRunBoundary, echo: MIRValueID?) -> JetEvalReplStepResult {
    if !session.valid -> return jet_eval_repl_step_result(session, false, None, true)
    session.machine.program = program
    session.machine.rows = jet_eval_program_rows(session.machine.program)
    session.machine.steps = 0
    session.machine.stdout = ""
    session.machine.stderr = ""
    returned :: jet_eval_run_until(&session.machine, 0, Val(boundary))
    stopped := false
    if session.machine.frames.len() == 1 {
        frame :: session.machine.frames[0]
        stopped = frame.function == boundary.function && frame.block == boundary.block && frame.ip == 0
    }
    shown := String?{None}
    shown_type := String?{None}
    if stopped && session.machine.failure == .None && session.machine.internal_problem == .None && !session.machine.soft_stop {
        if echo == .Val(value) {
            if jet_eval_value_type(&session.machine, 0, value, jet_eval_empty_span()) == .Val(ty) {
                if !mir_type_is_unit(ty) {
                    shown = jet_eval_semantic_display(&session.machine, 0, value, jet_eval_empty_span())
                    shown_type = Val(jet_eval_type_display_name(session.machine, ty))
                }
            }
        }
        if session.machine.failure == .None && session.machine.internal_problem == .None {
            result := jet_eval_repl_step_result(session, true, shown, false)
            result.echo_type = shown_type
            return result
        }
    }
    // No false rollback: owned host resources cannot be cloned. The failed
    // machine is retired, its drops run, and no stale binding may be reused.
    if returned == .Val(value) {
        _ :: jet_eval_drop_value(&session.machine, value, jet_eval_empty_span())
    }
    _ :: jet_eval_retire_machine(&session.machine, jet_eval_empty_span())
    session.valid = false
    if session.machine.failure == .Val(error) {
        failure := error
        detail :: error.diagnostic.detail ?? ""
        failure.diagnostic = diagnostic_with_detail(error.diagnostic, "{detail}\nREPL runtime bindings were reset after this failed step; start a new session.")
        session.machine.failure = Val(failure)
    }
    jet_eval_repl_step_result(session, returned != None && session.machine.failure == .None && session.machine.internal_problem == .None, None, true)
}

fn jet_eval_repl_session_close(session: &JetEvalReplSession, program: ^MIRProgram) -> JetEvalReplStepResult {
    if !session.valid -> return jet_eval_repl_step_result(session, false, None, true)
    session.machine.program = program
    session.machine.rows = jet_eval_program_rows(session.machine.program)
    session.machine.steps = 0
    session.machine.stdout = ""
    session.machine.stderr = ""
    returned :: jet_eval_run(&session.machine, 0)
    if returned == .Val(value) {
        _ :: jet_eval_drop_value(&session.machine, value, jet_eval_empty_span())
    }
    ok :: jet_eval_retire_machine(&session.machine, jet_eval_empty_span())
    session.valid = false
    jet_eval_repl_step_result(session, ok && returned != None, None, true)
}
