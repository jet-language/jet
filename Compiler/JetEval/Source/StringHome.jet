use jet_foundation.[
    Field,
]

struct JetEvalStringHome { pointer: U64, length: Int }
enum JetEvalStringHomeRoot {
    Local(frame: Int, local: U64)
    Value(frame: Int, value: U64)
    Parameter(frame: Int, index: Int)
    Capture(frame: Int, index: Int)
    Global(name: String)
}
enum JetEvalStringHomeSelector { Field(index: Int) List(index: Int) Map(index: Int) Enum(index: Int) Present Told Result(ok: Bool) }
struct JetEvalStringHomeRequest { root: JetEvalStringHomeRoot, selectors: [JetEvalStringHomeSelector] }