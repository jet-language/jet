// This file is generated by Compiler/Toolchain/CompilerValueMethods.jet, which `jet build Compiler`
// runs, from Compiler/JetFoundation/Source/Registry/CoreRecordRows.jet; do not edit.
// Source-owned projections for compiler query values.
// These methods consume immutable TComptimeValue packets produced by the
// compiler service; they never re-run a checker or call native Builtins.
use jet_foundation.[
    TComptimeField,
    TComptimeValue,
    type_name,
]

// The owner and method of a host method member `Owner.method`. The owner is a
// type name, which has no dot; the method is the rest, which may hold one: a
// hidden method that no source can spell, such as `Compiler`'s
// `events.functions` (JetSema Calls/Build.jet).
jet_eval_compiler_value_method_owner: fn(member: String) -> [String]? {
    parts: member.partition(".")
    if parts.head == "" || parts.tail == "" -> return None
    Val([String]{parts.head, parts.tail})
}

jet_eval_compiler_value_method_record: fn(owner: String, method: String) -> Bool Never! {
    if owner == "CompilerPackageError" {
        return method == "code" || method == "message" || method == "file" || method == "cause"
    }
    if owner == "CompilerDependency" -> return method == "name" || method == "source"
    if owner == "CompilerPackageTarget" -> return method == "name" || method == "targets"
    if owner == "CompilerPackageOutput" {
        return method == "name" || method == "kind" || method == "entry"
    }
    if owner == "CompilerBuildProfile" {
        return method == "name" || method == "optimize" || method == "debug_info" || method == "small" || method == "panic"
    }
    if owner == "CompilerManifest" {
        return method == "schema_version" || method == "file" || method == "jet" || method == "edition" || method == "description" || method == "license" || method == "repository" || method == "layer" || method == "target" || method == "dependencies" || method == "packages" || method == "outputs" || method == "build_profiles"
    }
    if owner == "CompilerPackage" {
        return method == "schema_version" || method == "file" || method == "jet" || method == "edition" || method == "description" || method == "license" || method == "repository" || method == "layer" || method == "target" || method == "dependencies" || method == "packages" || method == "outputs" || method == "build_profiles"
    }
    if owner == "CompilerLockedPackage" {
        return method == "name" || method == "version" || method == "source_kind" || method == "fingerprint" || method == "source" || method == "revision" || method == "content_hash" || method == "layer" || method == "inferred_layer" || method == "dependencies"
    }
    if owner == "CompilerLock" {
        return method == "schema_version" || method == "version" || method == "file" || method == "root_dependencies" || method == "packages"
    }
    if owner == "CompilerKeyValue" -> return method == "key" || method == "value"
    if owner == "CompilerProfile" {
        return method == "name" || method == "extends" || method == "packages" || method == "sources" || method == "collisions"
    }
    if owner == "CompilerProfileSet" {
        return method == "schema_version" || method == "file" || method == "profiles"
    }
    if owner == "CompilerToken" -> return method == "kind" || method == "text" || method == "span"
    if owner == "CompilerLexed" {
        return method == "source" || method == "schema_version" || method == "tokens" || method == "diagnostics"
    }
    if owner == "CompilerSyntaxTree" {
        return method == "source" || method == "schema_version" || method == "items" || method == "diagnostics"
    }
    if owner == "CompilerChecked" {
        return method == "source" || method == "schema_version" || method == "syntax" || method == "diagnostics" || method == "functions" || method == "effects" || method == "semantic_index"
    }
    if owner == "CompilerSourceMap" {
        return method == "schema_version" || method == "sources" || method == "generated_lines"
    }
    if owner == "CompilerNode" -> return method == "kind" || method == "name" || method == "span"
    if owner == "CompilerDiagnostic" {
        return method == "code" || method == "severity" || method == "message" || method == "why" || method == "fix" || method == "span" || method == "origin" || method == "fix_edits"
    }
    if owner == "CompilerDiagnosticOrigin" -> return method == "path" || method == "source_digest"
    if owner == "CompilerFixEdit" {
        return method == "span" || method == "new_text" || method == "safety"
    }
    if owner == "CompilerGeneratedLine" {
        return method == "generated_line" || method == "source_line" || method == "source"
    }
    if owner == "CompilerSemanticIndex" {
        return method == "schema_version" || method == "source_digest" || method == "definitions" || method == "references" || method == "calls" || method == "structural_nodes" || method == "effects" || method == "arithmetic" || method == "outputs" || method == "state_graphs" || method == "fact_registry" || method == "derivations"
    }
    if owner == "CompilerDefinition" {
        return method == "identity" || method == "path" || method == "scope" || method == "name" || method == "module" || method == "span" || method == "kind" || method == "view_provenance"
    }
    if owner == "CompilerArithmeticOperation" {
        return method == "operation" || method == "policy" || method == "module" || method == "operation_span" || method == "scope_span"
    }
    if owner == "CompilerSymbolKind" {
        return method == "kind" || method == "params" || method == "ret" || method == "parent" || method == "type" || method == "fields" || method == "variants" || method == "mutable"
    }
    if owner == "CompilerParam" -> return method == "name" || method == "type"
    if owner == "CompilerField" -> return method == "name" || method == "type"
    if owner == "CompilerViewProvenance" {
        return method == "output_path" || method == "sources" || method == "mutable"
    }
    if owner == "CompilerViewSourcePath" -> return method == "source" || method == "projections"
    if owner == "CompilerViewSource" {
        return method == "kind" || method == "index" || method == "module" || method == "name"
    }
    if owner == "CompilerViewProjection" -> return method == "kind" || method == "name"
    if owner == "CompilerReference" {
        return method == "name" || method == "module" || method == "scope_identity" || method == "target" || method == "span"
    }
    if owner == "CompilerDefinitionAnchor" {
        return method == "module" || method == "kind" || method == "semantic_identity" || method == "span"
    }
    if owner == "CompilerCall" {
        return method == "caller" || method == "callee" || method == "module" || method == "span"
    }
    if owner == "CompilerStructuralNode" {
        return method == "id" || method == "ordinal" || method == "parent" || method == "slot" || method == "slot_kind" || method == "class" || method == "shape" || method == "module" || method == "span"
    }
    if owner == "CompilerEffect" {
        return method == "function" || method == "direct" || method == "callees" || method == "inferred" || method == "maximal" || method == "provenance"
    }
    if owner == "CompilerEffectProvenance" {
        return method == "effect" || method == "call_path" || method == "spans"
    }
    if owner == "CompilerOutput" {
        return method == "binding" || method == "kind" || method == "name" || method == "module" || method == "span" || method == "entry"
    }
    if owner == "CompilerOutputEntry" {
        return method == "identity" || method == "name" || method == "module" || method == "failure_contract" || method == "failure_source" || method == "authority" || method == "definition_span" || method == "reference_span" || method == "params" || method == "effects" || method == "return_type"
    }
    if owner == "CompilerStateGraph" {
        return method == "owner" || method == "module" || method == "states" || method == "transitions"
    }
    if owner == "CompilerStateNode" {
        return method == "name" || method == "terminal" || method == "reachable" || method == "span"
    }
    if owner == "CompilerStateTransition" {
        return method == "operation" || method == "from" || method == "to"
    }
    if owner == "CompilerFactDeclaration" {
        return method == "kind" || method == "name" || method == "members" || method == "deny" || method == "from"
    }
    if owner == "CompilerDerivationRecord" {
        return method == "id" || method == "subject" || method == "claim" || method == "producer" || method == "method" || method == "rule" || method == "premises" || method == "identity" || method == "assumptions" || method == "disposition" || method == "observation" || method == "payload"
    }
    if owner == "CompilerDerivationIdentity" {
        return method == "source" || method == "build" || method == "run" || method == "target"
    }
    if owner == "CompilerDerivationObservation" {
        return method == "counterexample" || method == "event"
    }
    if owner == "CompilerDerivationPayload" -> return method == "kind" || method == "json"
    if owner == "CompilerError" {
        return method == "code" || method == "message" || method == "span"
    }
    false
}

jet_eval_compiler_value_method_supported: fn(owner: String, method: String, arg_count: Int) -> Bool Never! {
    if arg_count != 0 && owner != "EffectInfo" -> return false
    if owner == "ProgramInfo" {
        return method == "types" || method == "functions" || method == "traits" || method == "constants" || method == "packages" || method == "foreign" || method == "definitions" || method == "references" || method == "call_edges" || method == "structural_nodes" || method == "revision" || method == "complete"
    }
    if jet_eval_compiler_value_method_record(owner, method) -> return true
    if owner == "FunctionInfo" -> return method == "reaches_panic"
    if owner == "EffectInfo" -> return method == "has" && arg_count == 1
    false
}

// What a compiler value or reflection method answers on its checked
// receiver: the projected value, or the defect (`Fault`) that keeps the
// receiver from one.
JetEvalCompilerValueAnswer: enum {
    Value(value: TComptimeValue),
    Fault(message: String),
}

jet_eval_compiler_value_fault: fn(message: String) -> JetEvalCompilerValueAnswer Never! {
    JetEvalCompilerValueAnswer.Fault{message: message}
}

jet_eval_compiler_value_field: fn(fields: [TComptimeField], name: String) -> TComptimeValue? Never! {
    loop field in fields {
        if field.name == name -> return Val(field.value)
    }
    None
}

// The fields of `value` when it is the checked record `owner`.
jet_eval_compiler_value_fields: fn(value: TComptimeValue, owner: String) -> [TComptimeField]? Never! {
    if value == .Struct(type_name, fields) {
        if type_name == owner -> return Val(fields)
    }
    None
}

// Compiler value method `owner.method` (one jet_eval_compiler_value_method_supported
// accepts) on `args`, the receiver first.
jet_eval_compiler_value_answer: fn(owner: String, method: String, args: [TComptimeValue]) -> JetEvalCompilerValueAnswer Never! {
    if args.len() == 0 {
        return jet_eval_compiler_value_fault("compiler value route has no receiver")
    }
    fields: jet_eval_compiler_value_fields(args[0], owner) ?? return jet_eval_compiler_value_fault("compiler value route receiver is not {owner}")
    if owner == "EffectInfo" && method == "has" {
        wanted: if args.len() == 2 && args[1] == .String(text) -> text else -> {
            return jet_eval_compiler_value_fault("EffectInfo.has requires a String argument")
        }
        list: jet_eval_compiler_value_field(fields, "values") ?? return jet_eval_compiler_value_fault("EffectInfo.values projection is missing from its checked value")
        if list == .List(values) {
            loop value in values {
                if value == .String(text) {
                    if text == wanted {
                        return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: true}}
                    }
                } else {
                    return jet_eval_compiler_value_fault("EffectInfo.has projection field values must contain only Strings")
                }
            }
            return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: false}}
        }
        return jet_eval_compiler_value_fault("EffectInfo.has projection field values is not a list")
    }
    projected: jet_eval_compiler_value_field(fields, method) ?? return jet_eval_compiler_value_fault("{owner}.{method} projection is missing from its checked value")
    if owner != "ProgramInfo" -> return JetEvalCompilerValueAnswer.Value{value: projected}
    if method == "revision" {
        if projected == .String(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
        return jet_eval_compiler_value_fault("ProgramInfo.revision projection is not a String")
    }
    if method == "complete" {
        if projected == .Bool(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
        return jet_eval_compiler_value_fault("ProgramInfo.complete projection is not a Bool")
    }
    if projected == .List(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
    jet_eval_compiler_value_fault("{owner}.{method} projection is not a list")
}
