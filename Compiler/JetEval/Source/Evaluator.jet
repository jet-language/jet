// Bounded interpreter for checked MIR. Every operation either produces a
// concrete Eval-owned value or records an explicit source/compiler/unsupported
// failure; there is no successful placeholder path.
use core.math as math
use jet_foundation.[
    MIRFailureCarrier,
    MIRFunctionID,
    MIRProgram,
    TComptimeValue,
]

// Read-fork a fresh runtime configuration before an owning request is moved.
// Every field is reconstructed; adapter cloning is the sole host-session copy.
fn jet_eval_runtime_config(config: JetEvalConfig) -> JetEvalConfig {
    host_adapter := if config.host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    build_host_adapter :: if config.build_host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    JetEvalConfig{
        fuel: config.fuel,
        max_call_depth: config.max_call_depth,
        max_collection_len: config.max_collection_len,
        globals: config.globals,
        runtime_execution: true,
        host_adapter: host_adapter,
        build_host_adapter: build_host_adapter,
        output_context: config.output_context,
        host_hooks: config.host_hooks,
        runtime_ir: config.runtime_ir,
    }
}

fn jet_eval_function_result(failure: MIRFailureCarrier, data: ^TComptimeValue) -> TComptimeValue Never! {
    if failure == {
        .Result(_, _) | .Optional(_) -> {
            if data == .Present(_) -> return data
            if data == .Failed(_) -> return data
            return TComptimeValue.Present{value: data}
        }
        else -> {}
    }
    data
}
fn jet_eval_session_result(session: ^JetEvalRuntimeSession, value: JetEvalRuntimeValue?, complete: Bool) -> JetEvalResult Never! {
    stdout := session.machine.stdout
    stderr := session.machine.stderr
    output_context := session.machine.config.output_context
    steps := session.machine.steps
    soft_stop := session.machine.soft_stop
    exit_code := session.machine.exit_code
    error := session.machine.failure
    internal_problem := session.machine.internal_problem
    JetEvalResult{complete: complete, value: value, session: Val(session), stdout: stdout, stderr: stderr, output_context: output_context, steps: steps, soft_stop: soft_stop, exit_code: exit_code, error: error, internal_problem: internal_problem}
}
fn jet_eval_is_unit_attempt(program: MIRProgram, function_id: MIRFunctionID, runtime: Bool) -> Bool Never! {
    if !runtime -> return false
    loop test in program.tests {
        if test.function == function_id && test.kind == .Unit -> return true
    }
    false
}
