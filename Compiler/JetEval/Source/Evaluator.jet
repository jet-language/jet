enum JetEvalStep { Continue Return(value: JetEvalRuntimeValue) }

fn jet_eval_empty_span() -> Span Never! { Span{start: 0, end: 0} }

fn jet_eval_new_session_config(config: ^JetEvalConfig) -> JetEvalConfig {
    session := config
    if session.host_adapter == {
        None -> {}
        Val(adapter) -> {
            fresh := adapter.new_session()
            session.host_adapter = Val(fresh)
        }
    }
    if session.output_context == None {
        session.output_context = Val(jet_eval_output_context_new())
    }
    session
}

// Read-fork a fresh runtime configuration before an owning request is moved.
// Every field is reconstructed; adapter cloning is the sole host-session copy.
pub fn jet_eval_runtime_config(config: JetEvalConfig) -> JetEvalConfig {
    host_adapter := if config.host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    JetEvalConfig{
        fuel: config.fuel,
        max_call_depth: config.max_call_depth,
        max_collection_len: config.max_collection_len,
        globals: config.globals,
        runtime_execution: true,
        host_adapter: host_adapter,
        output_context: config.output_context,
        host_hooks: config.host_hooks,
    }
}


fn jet_eval_machine(program: ^MIRProgram, config: ^JetEvalConfig) -> JetEvalMachine {
    active_config := jet_eval_new_session_config(^config)
    registry := jet_eval_registry_new()
    identity := jet_eval_registry_machine_identity(registry)
    rows := jet_eval_program_rows(program)
    JetEvalMachine{program: program, rows: rows, config: active_config, registry: registry, identity: identity, frames: [JetEvalFrame]{}, callback_roots: [Int:JetEvalCallbackRoot]{}, entry_access: None, entry_shared_loans: [JetEvalSharedEntryLoan]{}, steps: 0, stdout: "", stderr: "", soft_stop: false, exit_code: None, failure: None, internal_problem: None}
}
pub fn jet_eval_owned_root(machine: JetEvalMachine) -> JetEvalOwnedRoot Never! {
    config := JetEvalConfig{
        fuel: machine.config.fuel,
        max_call_depth: machine.config.max_call_depth,
        max_collection_len: machine.config.max_collection_len,
        globals: machine.config.globals,
        runtime_execution: machine.config.runtime_execution,
        host_adapter: None,
        output_context: machine.config.output_context,
        host_hooks: machine.config.host_hooks,
    }
    jet_eval_owned_root_from_parts(machine.program, machine.registry, config)
}
pub fn jet_eval_owned_root_new_session(program: ^MIRProgram, config: ^JetEvalConfig) -> JetEvalOwnedRoot {
    machine := jet_eval_machine(^program, ^config)
    jet_eval_owned_root(machine)
}

// Checked root transport uses these Source-owned accessors so the private
// configuration can be recursively encoded without retaining the typed root.
pub fn jet_eval_owned_root_config(root: JetEvalOwnedRoot) -> JetEvalConfig Never! {
    JetEvalConfig{
        fuel: root.config.fuel,
        max_call_depth: root.config.max_call_depth,
        max_collection_len: root.config.max_collection_len,
        globals: root.config.globals,
        runtime_execution: root.config.runtime_execution,
        host_adapter: None,
        output_context: root.config.output_context,
        host_hooks: root.config.host_hooks,
    }
}
pub fn jet_eval_owned_root_from_parts(program: MIRProgram, registry: JetEvalRegistry, config: JetEvalConfig) -> JetEvalOwnedRoot Never! {
    active_config := config
    active_config.host_adapter = None
    JetEvalOwnedRoot{program: program, registry: registry, config: active_config}
}

pub fn jet_eval_owned_root_cleanup_clone(root: &JetEvalOwnedRoot) -> JetEvalOwnedRoot Never! {
    jet_eval_owned_root_from_parts(root.program, root.registry, jet_eval_owned_root_config(root))
}
fn jet_eval_owned_root_machine(root: JetEvalOwnedRoot, adapter: JetEvalHostAdapter) -> JetEvalMachine {
    root_config := jet_eval_owned_root_config(root)
    root_config.host_adapter = Val(adapter)
    active_config := jet_eval_new_session_config(^root_config)
    identity := jet_eval_registry_machine_identity(root.registry)
    rows := jet_eval_program_rows(root.program)
    JetEvalMachine{
        program: root.program,
        rows: rows,
        config: active_config,
        registry: root.registry,
        identity: identity,
        frames: [JetEvalFrame]{},
        callback_roots: [Int:JetEvalCallbackRoot]{},
        entry_access: None,
        entry_shared_loans: [JetEvalSharedEntryLoan]{},
        steps: 0,
        stdout: "",
        stderr: "",
        soft_stop: false,
        exit_code: None,
        failure: None,
        internal_problem: None,
    }
}
fn jet_eval_owned_root_drop_result(machine: &JetEvalMachine, cleaned: Bool, span: Span) -> JetEvalOwnedRootDropResult Never! {
    disposition := JetEvalOwnedRootDropDisposition.ConsumedFailure
    if cleaned && !jet_eval_has_failure(&machine) -> disposition = JetEvalOwnedRootDropDisposition.Cleaned
    internal_problem := machine.internal_problem
    if disposition == JetEvalOwnedRootDropDisposition.ConsumedFailure && machine.failure == None && internal_problem == None {
        internal_problem = Val(JetEvalInternalProblem{span: Val(span), message: "native owned-root cleanup failed without a diagnostic"})
    }
    JetEvalOwnedRootDropResult{
        disposition: disposition,
        failure: machine.failure,
        internal_problem: internal_problem,
        stdout: machine.stdout,
        stderr: machine.stderr,
    }
}
pub fn jet_eval_owned_root_drop(root: &JetEvalOwnedRoot, value: JetEvalRuntimeValue, adapter: JetEvalHostAdapter, span: Span) -> JetEvalOwnedRootDropResult {
    jet_eval_owned_root_drop_value(root, value, adapter, span)
}

fn jet_eval_owned_root_drop_value(root: JetEvalOwnedRoot, value: JetEvalRuntimeValue, adapter: JetEvalHostAdapter, span: Span) -> JetEvalOwnedRootDropResult {
    machine := jet_eval_owned_root_machine(root, adapter)
    valid := jet_eval_validate_borrow(value, &machine, span)
    cleaned := jet_eval_drop_value(&machine, value, span)
    jet_eval_owned_root_drop_result(&machine, valid && cleaned, span)
}

pub fn jet_eval_owned_root_drop_values(root: &JetEvalOwnedRoot, values: ^[JetEvalRuntimeValue], adapter: JetEvalHostAdapter, span: Span) -> JetEvalOwnedRootDropResult {
    machine := jet_eval_owned_root_machine(root, adapter)
    cleaned := true
    loop value in values {
        valid := jet_eval_validate_borrow(value, &machine, span)
        dropped := jet_eval_drop_value(&machine, value, span)
        if !valid || !dropped -> cleaned = false
    }
    jet_eval_owned_root_drop_result(&machine, cleaned, span)
}
// A disconnected callback reply owns its result independently of the retired
// parent session; output is already published, so only a returned value needs cleanup.
pub fn jet_eval_owned_root_drop_callback_result(root: &JetEvalOwnedRoot, result: JetEvalCallbackResult, adapter: JetEvalHostAdapter, span: Span) -> JetEvalOwnedRootDropResult {
    if result.outcome == {
        .Value(value) -> return jet_eval_owned_root_drop(&root, value, adapter, span)
        else -> {}
    }
    JetEvalOwnedRootDropResult{disposition: JetEvalOwnedRootDropDisposition.Cleaned, failure: None, internal_problem: None, stdout: "", stderr: ""}
}
pub fn jet_eval_owned_root_drop_host(root: &JetEvalOwnedRoot, value: JetEvalHostValue, adapter: JetEvalHostAdapter, span: Span) -> JetEvalOwnedRootDropResult {
    machine := jet_eval_owned_root_machine(root, adapter)
    cleaned := jet_eval_owned_host_value_discard(&machine, value, span)
    jet_eval_owned_root_drop_result(&machine, cleaned, span)
}
fn jet_eval_owned_host_value_collect(machine: &JetEvalMachine, value: JetEvalHostValue, pending: &[JetEvalRuntimeValue], span: Span) -> Bool {
    if value == {
        .Handle(handle, raw, owner, payload) -> {
            alias := JetEvalRuntimeValue?{None}
            if {
                owner != JetEvalHostOwner.Cursor -> {
                    alias = jet_eval_host_handle_new_mode(&machine, None, None, owner, handle, raw, JetEvalHostValue.Data{value: TComptimeValue.Unit}, true, span)
                }
                handle != jet_eval_loop_cursor_handle_id() -> {
                    jet_eval_compiler_fail(&machine, span, "transport cleanup cursor has a non-canonical handle identity")
                }
                else -> {
                    existing := jet_eval_resource_handle_alias(machine, handle, raw, JetEvalForeignTokenKind.Cursor)
                    if {
                        existing == None -> {
                            alias = Val(jet_eval_cursor_handle_new(machine, handle, raw, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}))
                        }
                        else -> {
                            token :: existing ?? return false
                            alias = Val(JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token})
                        }
                    }
                }
            }
            alias_ok := false
            if alias != None {
                &pending.push(alias ?? JetEvalRuntimeValue.Moved)
                alias_ok = true
            }
            payload_ok := jet_eval_owned_host_value_collect(&machine, payload, &pending, span)
            return alias_ok && payload_ok
        }
        .Present(inner) -> return jet_eval_owned_host_value_collect(&machine, inner, &pending, span)
        .Failed(inner) -> return jet_eval_owned_host_value_collect(&machine, inner, &pending, span)
        .List(values) -> {
            ok := true
            loop item in values {
                if !jet_eval_owned_host_value_collect(&machine, item, &pending, span) -> ok = false
            }
            return ok
        }
        .Map(entries) -> {
            ok := true
            loop entry in entries {
                if !jet_eval_owned_host_value_collect(&machine, entry.key, &pending, span) -> ok = false
                if !jet_eval_owned_host_value_collect(&machine, entry.value, &pending, span) -> ok = false
            }
            return ok
        }
        .Struct(_, fields) -> {
            ok := true
            loop field in fields {
                if !jet_eval_owned_host_value_collect(&machine, field.value, &pending, span) -> ok = false
            }
            return ok
        }
        .Enum(_, _, args) -> {
            ok := true
            loop arg in args {
                if !jet_eval_owned_host_value_collect(&machine, arg.value, &pending, span) -> ok = false
            }
            return ok
        }
        .Closure(_, captures) -> {
            ok := true
            loop capture in captures {
                if !jet_eval_owned_host_value_collect(&machine, capture, &pending, span) -> ok = false
            }
            return ok
        }
        .SourceCallback(_) -> {
            jet_eval_ownership_fail(&machine, span, "native host result returned a Source callback lease outside its registration acknowledgment")
            return false
        }
        .FixedBacking(_) -> {
            jet_eval_ownership_fail(&machine, span, "native host result returned a Fixed backing request outside allocator construction")
            return false
        }
        .SharedCarrier(carrier) -> {
            // Adoption moves the host's reference into Source, so the pending
            // drop releases it exactly once.
            adopted :: jet_eval_shared_runtime_host_adopt(&machine, carrier, None, span) ?? return false
            &pending.push(adopted)
            return true
        }
        .Data(_) | .Absent(_) -> return true
    }
    true
}
fn jet_eval_owned_host_value_discard(machine: &JetEvalMachine, value: JetEvalHostValue, span: Span) -> Bool {
    pending := [JetEvalRuntimeValue]{}
    ok := jet_eval_owned_host_value_collect(&machine, value, &pending, span)
    loop alias in pending {
        if !jet_eval_drop_value(&machine, alias, span) -> ok = false
    }
    ok
}
fn jet_eval_drop_borrowed_value(machine: JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .ForeignHandle(_, _, token) -> {
            if !jet_eval_foreign_token_is_borrowed(machine, token) -> return true
            payload := jet_eval_foreign_token_take_payload(machine, token)
            jet_eval_foreign_handle_retire(machine, token)
            return jet_eval_drop_borrowed_value(machine, payload, span)
        }
        .SharedCell(_, _) | .Shared(_) | .SharedWeak(_) | .SharedGuard(_) | .SharedSnapshot(_) | .Condition(_) -> return true
        .Result(_, nested) | .RuntimeFailure(nested, _) -> return jet_eval_drop_borrowed_value(machine, nested, span)
        .Closure(_, captures) | .Stream(_, _, _, captures) -> {
            ok := true
            loop capture in captures {
                if !jet_eval_drop_borrowed_value(machine, capture, span) -> ok = false
            }
            return ok
        }
        .Aggregate(aggregate) -> {
            ok := true
            if aggregate == {
                .List(values) -> loop item in values { if !jet_eval_drop_borrowed_value(machine, item, span) -> ok = false }
                .Map(entries) -> loop entry in entries {
                    if !jet_eval_drop_borrowed_value(machine, entry.key, span) -> ok = false
                    if !jet_eval_drop_borrowed_value(machine, entry.value, span) -> ok = false
                }
                .Struct(_, fields) -> loop field in fields { if !jet_eval_drop_borrowed_value(machine, field.value, span) -> ok = false }
                .Enum(_, _, args) -> loop arg in args { if !jet_eval_drop_borrowed_value(machine, arg.value, span) -> ok = false }
            }
            return ok
        }
        .HostCursor(inner, _, _, _) -> return jet_eval_drop_borrowed_value(machine, inner, span)
        else -> {}
    }
    true
}

fn jet_eval_drop_adopted_prefix(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], span: Span) -> Bool {
    if machine.entry_access == (Val(MIRAccess.Read)) {
        ok := true
        loop value in values {
            if !jet_eval_drop_borrowed_value(machine, value, span) -> ok = false
        }
        return ok
    }
    jet_eval_drop_values(&machine, values, span)
}

fn jet_eval_entry_adoption_rollback(machine: &JetEvalMachine, function: MIRFunction, values: [JetEvalRuntimeValue], span: Span) -> Bool {
    ok := true
    loop index in 0..<values.len() {
        if {
            index < function.params.len() && function.params[index].access == MIRAccess.Read -> {
                if !jet_eval_drop_borrowed_value(machine, values[index], span) -> ok = false
            }
            else -> {
                if !jet_eval_drop_value(&machine, values[index], span) -> ok = false
            }
        }
    }
    loans := machine.entry_shared_loans
    machine.entry_shared_loans = [JetEvalSharedEntryLoan]{}
    loop loans.len() > 0 {
        index := loans.len() - 1
        loan := loans[index]
        _ := &loans.pop()
        if !jet_eval_shared_runtime_host_entry_loan_end(&machine, loan, span) -> ok = false
    }
    machine.entry_access = None
    ok
}

fn jet_eval_frame(function: MIRFunction, args: [JetEvalRuntimeValue], captures: [JetEvalRuntimeValue], entry_accesses: [MIRAccess], entry_shared_loans: [JetEvalSharedEntryLoan], captures_borrowed: Bool) -> JetEvalFrame Never! {
    JetEvalFrame{
        function: function.id,
        block: function.entry,
        ip: 0,
        predecessor: None,
        params: args,
        captures: captures,
        values: [U64:JetEvalRuntimeValue]{},
        borrowed_values: [U64:Bool]{},
        locals: [U64:JetEvalRuntimeValue]{},
        scopes: [MIRScopeID]{},
        entry_accesses: entry_accesses,
        entry_shared_loans: entry_shared_loans,
        captures_borrowed: captures_borrowed,
    }
}

fn jet_eval_function_result(failure: MIRFailureCarrier, data: TComptimeValue) -> TComptimeValue Never! {
    if failure == {
        .Result(_, _) | .Optional(_) -> {
            if data == .Present(_) -> return ~data
            if data == .Failed(_) -> return ~data
            return TComptimeValue.Present{value: data}
        }
        else -> {}
    }
    ~data
}
fn jet_eval_result(machine: ^JetEvalMachine, value: JetEvalRuntimeValue?, complete: Bool) -> JetEvalResult Never! {
    stdout := machine.stdout
    stderr := machine.stderr
    output_context := machine.config.output_context
    steps := machine.steps
    soft_stop := machine.soft_stop
    exit_code := machine.exit_code
    error := machine.failure
    internal_problem := machine.internal_problem
    session := JetEvalRuntimeSession{machine: machine, retired: false}
    JetEvalResult{complete: complete, value: value, session: Val(session), stdout: stdout, stderr: stderr, output_context: output_context, steps: steps, soft_stop: soft_stop, exit_code: exit_code, error: error, internal_problem: internal_problem}
}
// Discharge one owned alias per registry reference inside `value`. Terminal
// state from the physical closer is isolated so cleanup never masks or is
// masked by the machine's earlier outcome.
pub fn jet_eval_drop_value(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    original_failure := machine.failure
    original_internal := machine.internal_problem
    original_soft_stop := machine.soft_stop
    original_exit_code := machine.exit_code
    machine.failure = None
    machine.internal_problem = None
    machine.soft_stop = false
    machine.exit_code = None
    close_ok := jet_eval_close_foreign_value(&machine, value, span)
    close_failure := machine.failure
    close_internal := machine.internal_problem
    close_soft_stop := machine.soft_stop
    close_exit_code := machine.exit_code
    machine.failure = original_failure
    machine.internal_problem = original_internal
    machine.soft_stop = original_soft_stop
    machine.exit_code = original_exit_code
    if !close_ok || close_failure != None || close_internal != None || close_soft_stop || close_exit_code != None {
        if machine.internal_problem == None {
            if {
                close_internal != None -> {
                    machine.internal_problem = close_internal
                }
                machine.failure != None -> {
                    machine.internal_problem = Val(JetEvalInternalProblem{span: Val(span), message: "resource cleanup failed after an earlier terminal failure"})
                }
                close_failure != None -> {
                    machine.failure = close_failure
                }
                else -> {
                    machine.internal_problem = Val(JetEvalInternalProblem{span: Val(span), message: "resource cleanup reached a terminal control outcome"})
                }
            }
        }
    }
    close_ok && close_failure == None && close_internal == None && !close_soft_stop && close_exit_code == None
}
// Abort every Transaction scope still active in a frame that is leaving
// without its ScopeExit (failure, unwind, or callback abandonment).
fn jet_eval_abort_frame_scopes(machine: &JetEvalMachine, frame_index: Int, function: Int, span: Span) -> Bool {
    ok := true
    scopes := machine.frames[frame_index].scopes
    machine.frames[frame_index].scopes = [MIRScopeID]{}
    index := scopes.len()
    loop index > 0 {
        index -= 1
        scope := scopes[index]
        scope_row :: jet_eval_function_scope(machine, function, scope) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR frame cleanup references an unavailable scope")
            ok = false
            next
        }
        if scope_row.kind == MIRScopeKind.Transaction {
            if !jet_eval_shared_runtime_scope_abort(&machine, frame_index, scope, span) -> ok = false
        }
    }
    ok
}

// Discharge every owned value exactly once. Borrowed SSA/local slots leave
// their caller-owned resources untouched; entry loans end after frame values.
fn jet_eval_cleanup_frame(machine: &JetEvalMachine, frame_index: Int, span: Span) -> Bool {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR cleanup frame function is unavailable")
        return false
    }
    ok := jet_eval_abort_frame_scopes(&machine, frame_index, function, span)
    loop index in 0..<machine.program.functions[function].locals.len() {
        local_id :: machine.program.functions[function].locals[index].id.value
        ownership_mode :: machine.program.functions[function].locals[index].ownership.mode
        removed := &machine.frames[frame_index].locals.remove(local_id)
        if removed != None {
            value :: removed ?? next
            if ownership_mode != MIROwnershipMode.ReadBorrow && ownership_mode != MIROwnershipMode.WriteBorrow
                && !jet_eval_drop_value(&machine, value, span) -> ok = false
        }
    }
    loop index in 0..<machine.program.functions[function].values.len() {
        value_id :: machine.program.functions[function].values[index].id.value
        removed := &machine.frames[frame_index].values.remove(value_id)
        borrowed := &machine.frames[frame_index].borrowed_values.remove(value_id) == (Val(true))
        if removed != None {
            value :: removed ?? next
            if !borrowed && !jet_eval_drop_value(&machine, value, span) -> ok = false
        }
    }
    params := machine.frames[frame_index].params
    captures := machine.frames[frame_index].captures
    captures_borrowed := machine.frames[frame_index].captures_borrowed
    entry_accesses := machine.frames[frame_index].entry_accesses
    loans := machine.frames[frame_index].entry_shared_loans
    machine.frames[frame_index].params = [JetEvalRuntimeValue]{}
    machine.frames[frame_index].captures = [JetEvalRuntimeValue]{}
    machine.frames[frame_index].entry_shared_loans = [JetEvalSharedEntryLoan]{}
    loop index in 0..<params.len() {
        if index < machine.program.functions[function].params.len() && machine.program.functions[function].params[index].access == MIRAccess.Read {
            if index < entry_accesses.len() && entry_accesses[index] == MIRAccess.Read {
                if !jet_eval_drop_borrowed_value(machine, params[index], span) -> ok = false
            }
            next
        }
        if !jet_eval_drop_value(&machine, params[index], span) -> ok = false
    }
    if !captures_borrowed {
        loop value in captures {
            if !jet_eval_drop_value(&machine, value, span) -> ok = false
        }
    }
    loop loans.len() > 0 {
        index := loans.len() - 1
        loan := loans[index]
        _ := &loans.pop()
        if !jet_eval_shared_runtime_host_entry_loan_end(&machine, loan, span) -> ok = false
    }
    ok && !jet_eval_has_failure(machine)
}

// Retire a machine: it discharges only what it owns (its frames and callback
// roots). The session registry is shared with sibling and child machines and
// is never swept; entries die when their last owned alias is released.
fn jet_eval_retire_machine(machine: &JetEvalMachine, span: Span) -> Bool {
    ok := true
    loop machine.frames.len() > 0 {
        frame_index := machine.frames.len() - 1
        if !jet_eval_cleanup_frame(&machine, frame_index, span) -> ok = false
        _ := &machine.frames.pop()
    }
    callback_leases := [Int]{}
    loop (lease, _) in machine.callback_roots -> &callback_leases.push(lease)
    loop lease in callback_leases {
        root := &machine.callback_roots.remove(lease)
        if root != None {
            retained :: root ?? next
            if retained.value != JetEvalRuntimeValue.Moved {
                if !jet_eval_drop_value(&machine, retained.value, span) -> ok = false
            }
        }
    }
    ok && !jet_eval_has_failure(machine)
}

pub fn jet_eval_retire_result(result: &JetEvalResult, span: Span) -> Bool {
    ok := true
    if &result.session == {
        None -> return true
        .Val(session) -> {
            if !session.retired {
                if !jet_eval_drain_callbacks(&session.machine, span) {
                    result.error = session.machine.failure
                    result.internal_problem = session.machine.internal_problem
                    result.stdout = session.machine.stdout
                    result.stderr = session.machine.stderr
                    result.output_context = session.machine.config.output_context
                    return false
                }
                value := result.value
                if value != None {
                    if !jet_eval_drop_value(&session.machine, value ?? JetEvalRuntimeValue.Moved, span) -> ok = false
                }
                if !jet_eval_retire_machine(&session.machine, span) -> ok = false
                result.error = session.machine.failure
                result.internal_problem = session.machine.internal_problem
                result.stdout = session.machine.stdout
                result.stderr = session.machine.stderr
                result.output_context = session.machine.config.output_context
                session.retired = true
                ok = ok && !jet_eval_has_failure(&session.machine)
            }
        }
    }
    result.session = None
    result.value = None
    ok
}

// Move the produced value out of a result before the session retires. The
// caller now owns that value's aliases (valid on any machine sharing the same
// session registry, e.g. the parent of a task); the child session still
// retires only its own frames and callback roots.
pub fn jet_eval_result_take_value(result: &JetEvalResult, span: Span) -> JetEvalRuntimeValue? {
    if &result.session == {
        None -> return None
        .Val(session) -> {
            if session.retired -> return None
            if !jet_eval_validate_borrow(result.value ?? JetEvalRuntimeValue.Moved, &session.machine, span) -> return None
        }
    }
    taken := result.value
    result.value = None
    taken
}

pub fn jet_eval_comptime_value(result: &JetEvalResult, span: Span) -> TComptimeValue? {
    if result.internal_problem != None {
        jet_eval_retire_result(&result, span)
        return None
    }
    value :: result.value ?? return None
    data_result := TComptimeValue?{None}
    if &result.session == {
        None -> return None
        .Val(session) -> {
            data_result = jet_eval_data(value, &session.machine, span)
            if data_result == None {
                result.error = session.machine.failure
                result.internal_problem = session.machine.internal_problem
            }
        }
    }
    data :: data_result ?? {
        jet_eval_retire_result(&result, span)
        return None
    }
    if !jet_eval_retire_result(&result, span) -> return None
    Val(data)
}


pub fn jet_eval_function(program: ^MIRProgram, function_id: MIRFunctionID, args: [TComptimeValue], config: ^JetEvalConfig) -> JetEvalResult {
    machine := jet_eval_machine(^program, ^config)
    function :: jet_eval_find_function(machine, function_id) ?? {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "requested MIR function is unavailable")
        return jet_eval_result(^machine, None, false)
    }
    if !function.target_applicability.interpreter {
        jet_eval_unsupported(&machine, function.span, "evaluating a function disabled for the interpreter target")
        return jet_eval_result(^machine, None, false)
    }
    runtime_args := [JetEvalRuntimeValue]{}
    loop arg in args -> &runtime_args.push(JetEvalRuntimeValue.Data{value: arg})
    value :: jet_eval_invoke(&machine, function_id, runtime_args, [JetEvalRuntimeValue]{}, function.span) ?? {
        if machine.soft_stop && !jet_eval_has_failure(machine) -> return jet_eval_result(^machine, Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}), true)
        if !jet_eval_has_failure(machine) -> jet_eval_compiler_fail(&machine, function.span, "MIR evaluation of `{function.key}` returned no value without a diagnostic")
        return jet_eval_result(^machine, None, false)
    }
    if jet_eval_has_failure(machine) {
        jet_eval_drop_value(&machine, value, function.span)
        return jet_eval_result(^machine, None, false)
    }
    if machine.soft_stop {
        jet_eval_drop_value(&machine, value, function.span)
        return jet_eval_result(^machine, Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}), true)
    }
    if machine.config.runtime_execution {
        return jet_eval_result(^machine, Val(value), true)
    }
    data :: jet_eval_data(value, &machine, function.span) ?? {
        if !jet_eval_has_failure(machine) -> jet_eval_compiler_fail(&machine, function.span, "the value of `{function.key}` is not compile-time data")
        jet_eval_drop_value(&machine, value, function.span)
        return jet_eval_result(^machine, None, false)
    }
    if !jet_eval_drop_value(&machine, value, function.span) {
        if !jet_eval_has_failure(machine) -> jet_eval_compiler_fail(&machine, function.span, "the value of `{function.key}` did not retire cleanly")
        return jet_eval_result(^machine, None, false)
    }
    result_data := jet_eval_function_result(function.failure, data)
    jet_eval_result(^machine, Val(JetEvalRuntimeValue.Data{value: result_data}), true)
}

// A pure evaluation's data value and the program its machine ran on.
pub struct JetEvalProgramData {
    pub program: MIRProgram
    pub value: TComptimeValue?
}

fn jet_eval_program_data(program: ^MIRProgram, value: TComptimeValue?) -> JetEvalProgramData Never! {
    JetEvalProgramData{program: program, value: value}
}

// Run `function_id` with no arguments as one pure evaluation: read its value
// as data, retire the session, and hand the program back. A caller that
// evaluates many functions of one program (pure-call folding) moves the
// program through every evaluation instead of copying it per call. The value
// is None when the evaluation failed, stopped, printed, or left a resource
// that did not retire cleanly.
pub fn jet_eval_pure_function(program: ^MIRProgram, function_id: MIRFunctionID, config: ^JetEvalConfig) -> JetEvalProgramData {
    span := jet_eval_empty_span()
    machine := jet_eval_machine(^program, ^config)
    data := TComptimeValue?{None}
    if jet_eval_find_function(machine, function_id) == .Val(function) {
        if function.target_applicability.interpreter {
            if jet_eval_invoke(&machine, function_id, [JetEvalRuntimeValue]{}, [JetEvalRuntimeValue]{}, function.span) == .Val(value) {
                if !jet_eval_has_failure(machine) && !machine.soft_stop -> data = jet_eval_data(value, &machine, span)
                if !jet_eval_drop_value(&machine, value, span) -> data = None
            }
        }
    }
    if !jet_eval_drain_callbacks(&machine, span) || !jet_eval_retire_machine(&machine, span) -> data = None
    if jet_eval_has_failure(machine) || machine.soft_stop || machine.stdout != "" || machine.stderr != "" -> data = None
    jet_eval_program_data(^machine.program, data)
}
// Resume a suspended Source-MIR machine supplied by a native deoptimization
// boundary. No frame or resource is reconstructed here: the returned session
// retains the exact frame values and callback roots (the machine's only owned
// references) until jet_eval_retire_result is called by the runtime owner.
pub fn jet_eval_resume(request: ^JetEvalResumeRequest) -> JetEvalResult {
    target_depth := request.target_depth

    identity := jet_eval_registry_machine_identity(request.registry)
    rows := jet_eval_program_rows(request.program)
    machine := JetEvalMachine{
        program: request.program,
        rows: rows,
        config: request.config,
        registry: request.registry,
        identity: identity,
        frames: request.frames,
        callback_roots: request.callback_roots,
        entry_access: None,
        entry_shared_loans: [JetEvalSharedEntryLoan]{},
        steps: request.steps,
        stdout: request.stdout,
        stderr: request.stderr,
        soft_stop: request.soft_stop,
        exit_code: request.exit_code,
        failure: request.failure,
        internal_problem: request.internal_problem,
    }
    if target_depth < 0 || target_depth >= machine.frames.len() {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "Source-MIR resume target depth is outside the checked frame stack")
        return jet_eval_result(^machine, None, false)
    }
    value :: jet_eval_run(&machine, target_depth) ?? {

        return jet_eval_result(^machine, None, false)
    }
    if machine.internal_problem != None || machine.failure != None -> return jet_eval_result(^machine, None, false)
    jet_eval_result(^machine, Val(value), true)
}
fn jet_eval_deopt_scalar_matches(ty: MIRType, value: JetEvalRuntimeValue, bits: Int) -> Bool {
    base := ty
    if base.kind == {
        .Tagged(_, inner) -> base = inner
        .InlineRange(inner, _, _) -> base = inner
        .Quantity(inner, _) -> base = inner
        else -> {}
    }
    if value == {
        .Data(data) -> {
            if base.kind == {
                .Int | .IntN(_, _) | .Measure(_) -> {
                    if data == .Int(actual) -> return actual == bits
                    return false
                }
                .Char -> {
                    if data == .Char(actual) -> return actual == bits
                    return false
                }
                .Float -> {
                    if data == .Float(actual, bits_width) {
                        if bits_width != 64 -> return false
                        return math.to_bits(actual) == bits
                    }
                    return false
                }
                .Float32 -> {
                    if data == .Float(actual, bits_width) {
                        if bits_width != 32 -> return false
                        return math.to_bits(actual) == bits
                    }
                    return false
                }
                .Bool -> {
                    if bits != 0 && bits != 1 -> return false
                    if data == .Bool(actual) -> return actual == (bits == 1)
                    return false
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}

fn jet_eval_validate_deopt(machine: &JetEvalMachine, deopt: JetEvalDeoptRequest, span: Span?) -> Bool {
    if deopt.argc < 0 || deopt.argc > deopt.args.len() {
        jet_eval_internal_problem(&machine, span, "native deopt argument count is not an exact Source-MIR ABI row")
        return false
    }
    if deopt.argc != machine.frames[machine.frames.len() - 1].params.len() {
        jet_eval_internal_problem(&machine, span, "native deopt arguments do not match the existing Source-MIR frame")
        return false
    }
    frame_index := machine.frames.len() - 1
    if machine.frames[frame_index].function != deopt.function {
        jet_eval_internal_problem(&machine, span, "native deopt function identity does not match the existing Source-MIR frame")
        return false
    }
    function :: jet_eval_find_function(machine, deopt.function) ?? {
        jet_eval_internal_problem(&machine, span, "native deopt function is missing from the checked Source-MIR program")
        return false
    }
    if function.params.len() != deopt.argc {
        jet_eval_internal_problem(&machine, span, "native deopt argument count disagrees with the checked function signature")
        return false
    }
    index := 0
    loop index < deopt.argc {
        if !jet_eval_deopt_scalar_matches(function.params[index].ty, machine.frames[frame_index].params[index], deopt.args[index]) {
            jet_eval_internal_problem(&machine, Val(function.params[index].span), "native deopt ABI carrier is not the exact checked scalar frame value")
            return false
        }
        index += 1
    }
    true
}

pub fn jet_eval_resume_deopt(request: ^JetEvalResumeRequest, deopt: JetEvalDeoptRequest) -> JetEvalResult {
    target_depth := request.target_depth

    identity := jet_eval_registry_machine_identity(request.registry)
    rows := jet_eval_program_rows(request.program)
    machine := JetEvalMachine{
        program: request.program,
        rows: rows,
        config: request.config,
        registry: request.registry,
        identity: identity,
        frames: request.frames,
        callback_roots: request.callback_roots,
        entry_access: None,
        entry_shared_loans: [JetEvalSharedEntryLoan]{},
        steps: request.steps,
        stdout: request.stdout,
        stderr: request.stderr,
        soft_stop: request.soft_stop,
        exit_code: request.exit_code,
        failure: request.failure,
        internal_problem: request.internal_problem,
    }
    deopt_span := Span?{None}
    function := jet_eval_find_function(machine, deopt.function)
    if function != None {
        found :: function ?? {
            jet_eval_internal_problem(&machine, None, "native deopt function lookup lost its checked function row")
            return jet_eval_result(^machine, None, false)
        }
        deopt_span = Val(found.span)
    }
    if machine.frames.len() == 0 {
        jet_eval_internal_problem(&machine, deopt_span, "native deopt supplied no existing Source-MIR frame")
        return jet_eval_result(^machine, None, false)
    }
    if !jet_eval_validate_deopt(&machine, deopt, deopt_span) -> return jet_eval_result(^machine, None, false)
    if target_depth != machine.frames.len() - 1 {
        jet_eval_internal_problem(&machine, deopt_span, "native deopt target depth is not the existing Source-MIR frame")
        return jet_eval_result(^machine, None, false)
    }
    value :: jet_eval_run(&machine, target_depth) ?? return jet_eval_result(^machine, None, false)
    if machine.internal_problem != None || machine.failure != None -> return jet_eval_result(^machine, None, false)
    jet_eval_result(^machine, Val(value), true)
}
// Start a native deopt at a checked function entry when no Source frame exists.
// The Foundation boundary supplies recursively decoded, typed host values; this
// path never reconstructs aggregates, closures, or owned resources from words.
pub fn jet_eval_start_deopt(program: ^MIRProgram, entry_config: ^JetEvalConfig, function_id: MIRFunctionID, args: [JetEvalHostValue]) -> JetEvalResult {
    config := entry_config
    config.runtime_execution = true
    machine := jet_eval_machine(^program, ^config)
    function :: jet_eval_find_function(machine, function_id) ?? {
        jet_eval_internal_problem(&machine, None, "native deopt entry function is missing from the checked Source-MIR program")
        return jet_eval_result(^machine, None, false)
    }
    span := Val(function.span)
    if !function.target_applicability.interpreter {
        jet_eval_unsupported(&machine, function.span, "deopt entry function is disabled for the interpreter target")
        return jet_eval_result(^machine, None, false)
    }
    if args.len() != function.params.len() {
        jet_eval_internal_problem(&machine, span, "native deopt entry arguments disagree with the checked function signature")
        return jet_eval_result(^machine, None, false)
    }
    index := 0
    loop index < args.len() {
        parameter := function.params[index]
        if parameter.index != index {
            jet_eval_internal_problem(&machine, Val(parameter.span), "native deopt entry parameter index disagrees with its checked position")
            return jet_eval_result(^machine, None, false)
        }
        access_ownership := mir_ownership_from_access(parameter.access)
        if parameter.ownership.mode != access_ownership.mode || parameter.ownership.drop != access_ownership.drop {
            jet_eval_internal_problem(&machine, Val(parameter.span), "native deopt entry parameter ownership disagrees with its checked access mode")
            return jet_eval_result(^machine, None, false)
        }
        machine.entry_access = Val(parameter.access)
        preflight_ok := jet_eval_host_value_preflight(&machine, None, Val(parameter.ty), args[index], false, parameter.span)
        machine.entry_access = None
        if !preflight_ok {
            if machine.internal_problem == None -> jet_eval_internal_problem(&machine, Val(parameter.span), "native deopt entry host value disagrees with its complete checked parameter type")
            return jet_eval_result(^machine, None, false)
        }
        index += 1
    }
    runtime_args := [JetEvalRuntimeValue]{}
    index = 0
    loop index < args.len() {
        parameter := function.params[index]
        machine.entry_access = Val(parameter.access)
        value :: jet_eval_host_value_adopt(&machine, None, Val(parameter.ty), args[index], false, parameter.span) ?? {
            machine.entry_access = None
            if machine.internal_problem == None -> jet_eval_internal_problem(&machine, Val(parameter.span), "native deopt entry host value could not be staged under its checked parameter access")
            _ := jet_eval_entry_adoption_rollback(&machine, function, runtime_args, parameter.span)
            return jet_eval_result(^machine, None, false)
        }
        machine.entry_access = None
        &runtime_args.push(value)
        index += 1
    }
    entry_accesses := [MIRAccess]{}
    loop parameter in function.params -> &entry_accesses.push(parameter.access)
    entry_shared_loans := machine.entry_shared_loans
    machine.entry_shared_loans = [JetEvalSharedEntryLoan]{}
    &machine.frames.push(jet_eval_frame(function, runtime_args, [JetEvalRuntimeValue]{}, entry_accesses, entry_shared_loans, false))
    value :: jet_eval_run(&machine, 0) ?? return jet_eval_result(^machine, None, false)
    if machine.internal_problem != None || machine.failure != None -> return jet_eval_result(^machine, None, false)
    jet_eval_result(^machine, Val(value), true)
}

// Move the installed entry frame's Write parameters out before result retirement.
// Other access modes and the result session remain owned by the Source machine.
pub fn jet_eval_result_entry_writebacks(result: &JetEvalResult, function_id: MIRFunctionID, span: Span) -> JetEvalEntryWritebackBatch? {
    if &result.session == {
        .Val(session) -> jet_eval_session_entry_writebacks(&session, function_id, span)
        None -> None
    }
}

fn jet_eval_session_entry_writebacks(session: &JetEvalRuntimeSession, function_id: MIRFunctionID, span: Span) -> JetEvalEntryWritebackBatch? {
    if session.retired -> return None
    if !session.machine.config.runtime_execution {
        jet_eval_internal_problem(&session.machine, Val(span), "entry writeback extraction requires a runtime-execution result")
        return None
    }
    if session.machine.frames.len() == 0 -> return Val(JetEvalEntryWritebackBatch{installed: false, writebacks: [JetEvalEntryWriteback]{}})
    function :: jet_eval_find_function(session.machine, function_id) ?? {
        jet_eval_internal_problem(&session.machine, Val(span), "entry writeback function is missing from the checked Source-MIR program")
        return None
    }
    if session.machine.frames[0].function != function_id {
        jet_eval_internal_problem(&session.machine, Val(span), "entry writeback result does not retain the requested frame zero")
        return None
    }
    if session.machine.frames[0].params.len() != function.params.len() {
        jet_eval_internal_problem(&session.machine, Val(span), "entry writeback parameter frame disagrees with the checked function signature")
        return None
    }
    writebacks := [JetEvalEntryWriteback]{}
    source_ids := [U64?]{}
    loop index in 0..<function.params.len() {
        parameter := function.params[index]
        if parameter.index != index {
            jet_eval_internal_problem(&session.machine, Val(parameter.span), "entry writeback parameter index disagrees with its checked position")
            return None
        }
        if parameter.access != MIRAccess.Write -> next
        parameter_result := MIRValueID?{None}
        parameter_found := false
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .Parameter(parameter_index, _) {
                    if parameter_index == index {
                        if parameter_found {
                            jet_eval_internal_problem(&session.machine, Val(parameter.span), "entry writeback parameter has duplicate Source-MIR Parameter operations")
                            return None
                        }
                        parameter_found = true
                        parameter_result = instruction.result
                    }
                }
            }
        }
        source_id := U64?{None}
        if parameter_result != None {
            value_id :: parameter_result ?? return None
            if session.machine.frames[0].values.get(value_id.value) != None -> source_id = Val(value_id.value)
        }
        current := if source_id == {
            .Val(slot) -> {
                session.machine.frames[0].values.get(slot) ?? {
                    jet_eval_internal_problem(&session.machine, Val(parameter.span), "entry writeback SSA value disappeared during preflight")
                    return None
                }
            }
            None -> {
                session.machine.frames[0].params[index]
            }
        }
        if {
            current == JetEvalRuntimeValue.Moved -> {
                jet_eval_ownership_fail(&session.machine, parameter.span, "entry writeback parameter was moved before the borrowed result was extracted")
                return None
            }
        }
        if !jet_eval_validate_borrow(current, &session.machine, parameter.span) -> return None
        loop prior_id in source_ids {
            if source_id != None && prior_id == source_id {
                jet_eval_internal_problem(&session.machine, Val(parameter.span), "entry writeback parameters share one mutable SSA slot")
                return None
            }
        }
        &source_ids.push(source_id)
        &writebacks.push(JetEvalEntryWriteback{argument: index, ty: parameter.ty, value: current})
    }
    loop index in 0..<writebacks.len() {
        argument := writebacks[index].argument
        source_id := source_ids[index]
        if source_id == {
            .Val(slot) -> {
                original := session.machine.frames[0].params[argument]
                session.machine.frames[0].params[argument] = JetEvalRuntimeValue.Moved
                session.machine.frames[0].values[slot] = JetEvalRuntimeValue.Moved
                _ := jet_eval_drop_value(&session.machine, original, span)
            }
            None -> {
                session.machine.frames[0].params[argument] = JetEvalRuntimeValue.Moved
            }
        }
    }
    Val(JetEvalEntryWritebackBatch{installed: true, writebacks: writebacks})
}


// A callee frame owns Move arguments and any retained closure captures. Read
// arguments and borrowed closure captures remain owned by their caller.
fn jet_eval_drop_invoke_inputs(machine: &JetEvalMachine, function: MIRFunction, args: [JetEvalRuntimeValue], captures: [JetEvalRuntimeValue], captures_borrowed: Bool, span: Span) {
    loop index in 0..<args.len() {
        if index >= function.params.len() || function.params[index].access == MIRAccess.Move {
            _ := jet_eval_drop_value(&machine, args[index], span)
        }
    }
    if !captures_borrowed -> _ := jet_eval_drop_values(&machine, captures, span)
}

fn jet_eval_invoke_with_borrowed_captures(machine: &JetEvalMachine, function_id: MIRFunctionID, args: [JetEvalRuntimeValue], captures: [JetEvalRuntimeValue], captures_borrowed: Bool, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_find_function(machine, function_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR call target is unavailable")
        return None
    }
    if machine.frames.len() >= machine.config.max_call_depth {
        jet_eval_fuel_fail(&machine, span)
        jet_eval_drop_invoke_inputs(&machine, function, args, captures, captures_borrowed, span)
        return None
    }
    if !function.target_applicability.interpreter {
        jet_eval_unsupported(&machine, span, "calling a function disabled for the interpreter target")
        jet_eval_drop_invoke_inputs(&machine, function, args, captures, captures_borrowed, span)
        return None
    }
    depth := machine.frames.len()
    &machine.frames.push(jet_eval_frame(function, args, captures, [MIRAccess]{}, [JetEvalSharedEntryLoan]{}, captures_borrowed))
    value :: jet_eval_run(&machine, depth) ?? {
        loop machine.frames.len() > depth {
            frame_index := machine.frames.len() - 1
            jet_eval_cleanup_frame(&machine, frame_index, span)
            _ := &machine.frames.pop()
        }
        return None
    }
    Val(value)
}

fn jet_eval_invoke(machine: &JetEvalMachine, function_id: MIRFunctionID, args: [JetEvalRuntimeValue], captures: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    jet_eval_invoke_with_borrowed_captures(&machine, function_id, args, captures, false, span)
}
pub fn jet_eval_invoke_host_callback(machine: &JetEvalMachine, closure: ^JetEvalRuntimeValue, args: ^[JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    if closure == .Closure(function, captures) -> return jet_eval_invoke(&machine, function, args, captures, span)
    jet_eval_compiler_fail(&machine, span, "native host callback value is not a checked Source closure")
    jet_eval_drop_value(&machine, closure, span)
    jet_eval_drop_values(&machine, args, span)
    None
}
fn jet_eval_callback_unwind(machine: &JetEvalMachine, depth: Int, span: Span) -> Bool {
    if depth < 0 || depth > machine.frames.len() {
        jet_eval_internal_problem(&machine, Val(span), "native callback frame stack escaped its saved depth")
        return false
    }
    ok := true
    loop machine.frames.len() > depth {
        frame_index := machine.frames.len() - 1
        if !jet_eval_cleanup_frame(&machine, frame_index, span) -> ok = false
        _ := &machine.frames.pop()
    }
    if machine.frames.len() != depth {
        jet_eval_internal_problem(&machine, Val(span), "native callback frame unwind lost the outer Source-MIR frame stack")
        ok = false
    }
    ok
}

fn jet_eval_callback_validate_root(machine: &JetEvalMachine, value: JetEvalRuntimeValue, reusable: Bool, span: Span) -> Bool {
    if value == .Closure(function, captures) {
        function_row :: jet_eval_find_function(machine, function) ?? {
            jet_eval_compiler_fail(&machine, span, "native callback closure has no checked function facts")
            return false
        }
        if captures.len() != function_row.capture_params.len() {
            jet_eval_compiler_fail(&machine, span, "native callback closure capture count disagrees with checked function facts")
            return false
        }
        if function_row.captures != None {
            facts :: function_row.captures ?? return false
            if captures.len() != 0 && !facts.escapes {
                jet_eval_ownership_fail(&machine, span, "native callback closure captures do not have escaping lifetime facts")
                return false
            }
            if reusable && facts.moved.len() != 0 {
                jet_eval_ownership_fail(&machine, span, "native callback retains a move-only closure")
                return false
            }
        }
        if !jet_eval_value_transferable(&machine, value, span) -> return false
        return jet_eval_validate_borrow(value, &machine, span)
    }
    jet_eval_compiler_fail(&machine, span, "native callback root is not a checked Source closure")
    false
}

// The callback root takes ownership of the closure value (moved in); its
// captured aliases are discharged when the root is released or retired.
fn jet_eval_callback_root_insert(machine: &JetEvalMachine, value: ^JetEvalRuntimeValue, reusable: Bool, span: Span) -> Int? {
    lease := jet_eval_registry_callback_lease(machine)
    if lease <= 0 {
        jet_eval_drop_value(&machine, value, span)
        jet_eval_internal_problem(&machine, Val(span), "native callback lease counter is invalid")
        return None
    }
    machine.callback_roots[lease] = JetEvalCallbackRoot{value: value, reusable: reusable, invoked: false}
    Val(lease)
}

pub fn jet_eval_callback_transfer(machine: &JetEvalMachine, closure: ^JetEvalRuntimeValue, span: Span) -> Int? {
    if !jet_eval_callback_validate_root(&machine, closure, false, span) {
        jet_eval_drop_value(&machine, closure, span)
        return None
    }
    jet_eval_callback_root_insert(&machine, ^closure, false, span)
}

pub fn jet_eval_callback_retain(machine: &JetEvalMachine, closure: ^JetEvalRuntimeValue, span: Span) -> Int? {
    if !jet_eval_callback_validate_root(&machine, closure, true, span) {
        jet_eval_drop_value(&machine, closure, span)
        return None
    }
    retained :: jet_eval_copy_value(closure, &machine, span) ?? {
        jet_eval_drop_value(&machine, closure, span)
        return None
    }
    if !jet_eval_drop_value(&machine, closure, span) {
        jet_eval_drop_value(&machine, retained, span)
        return None
    }
    jet_eval_callback_root_insert(&machine, ^retained, true, span)
}

pub fn jet_eval_callback_invoke(machine: &JetEvalMachine, lease: Int, args: ^[JetEvalRuntimeValue], span: Span) -> JetEvalCallbackResult {
    original_failure := machine.failure
    original_internal := machine.internal_problem
    original_soft_stop := machine.soft_stop
    original_exit_code := machine.exit_code
    original_stdout := machine.stdout
    original_stderr := machine.stderr
    machine.failure = None
    machine.internal_problem = None
    machine.soft_stop = false
    machine.exit_code = None
    machine.stdout = ""
    machine.stderr = ""
    callback_frame_depth := machine.frames.len()

    callback_value := JetEvalRuntimeValue?{None}
    callback_failure := JetEvalError?{None}
    callback_internal := JetEvalInternalProblem?{None}
    root := machine.callback_roots.get(lease)
    if root == {
        None -> {
            loop arg in args -> jet_eval_drop_value(&machine, arg, span)
            callback_internal = Val(JetEvalInternalProblem{span: Val(span), message: "native callback lease is unknown"})
        }
        Val(current) -> {
            if {
                current.value == JetEvalRuntimeValue.Moved -> {
                    loop arg in args -> jet_eval_drop_value(&machine, arg, span)
                    callback_internal = Val(JetEvalInternalProblem{span: Val(span), message: "native callback lease has already been consumed"})
                }
                current.reusable -> {
                    closure :: jet_eval_copy_value(current.value, &machine, span)
                    if {
                        closure == None -> {
                            loop arg in args -> jet_eval_drop_value(&machine, arg, span)
                            callback_failure = machine.failure
                            callback_internal = machine.internal_problem
                        }
                        else -> {
                            closure_value :: closure
                            callback_value = jet_eval_invoke_host_callback(&machine, ^closure_value, ^args, span)
                        }
                    }
                }
                current.invoked -> {
                    loop arg in args -> jet_eval_drop_value(&machine, arg, span)
                    callback_internal = Val(JetEvalInternalProblem{span: Val(span), message: "native callback lease invokes a move-only closure more than once"})
                }
                else -> {
                    updated := current
                    updated.invoked = true
                    closure := updated.value
                    updated.value = JetEvalRuntimeValue.Moved
                    machine.callback_roots[lease] = updated
                    callback_value = jet_eval_invoke_host_callback(&machine, ^closure, ^args, span)
                }
            }
        }
    }
    callback_unwound := jet_eval_callback_unwind(&machine, callback_frame_depth, span)
    if !callback_unwound && callback_value != None {
        value :: callback_value ?? JetEvalRuntimeValue.Moved
        jet_eval_drop_value(&machine, value, span)
        callback_value = None
    }

    callback_failure = if callback_failure != None -> callback_failure else -> machine.failure
    callback_internal = if callback_internal != None -> callback_internal else -> machine.internal_problem
    callback_soft_stop := machine.soft_stop
    callback_exit_code := machine.exit_code
    callback_stdout := machine.stdout
    callback_stderr := machine.stderr
    machine.failure = original_failure
    machine.internal_problem = original_internal
    machine.soft_stop = original_soft_stop
    machine.exit_code = original_exit_code
    machine.stdout = original_stdout
    machine.stderr = original_stderr
    if callback_internal != None {
        problem :: callback_internal ?? JetEvalInternalProblem{span: Val(span), message: "native callback internal failure"}
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.InternalProblem{problem: problem}, stdout: callback_stdout, stderr: callback_stderr}
    }
    if callback_failure != None {
        failure :: callback_failure ?? {
            problem := JetEvalInternalProblem{span: Val(span), message: "native callback failure disappeared"}
            return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.InternalProblem{problem: problem}, stdout: callback_stdout, stderr: callback_stderr}
        }
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Failure{error: failure}, stdout: callback_stdout, stderr: callback_stderr}
    }
    if callback_exit_code != None {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Exit{code: callback_exit_code ?? 0}, stdout: callback_stdout, stderr: callback_stderr}
    }
    if callback_soft_stop {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.SoftStop, stdout: callback_stdout, stderr: callback_stderr}
    }
    if callback_value != None {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Value{value: callback_value ?? JetEvalRuntimeValue.Moved}, stdout: callback_stdout, stderr: callback_stderr}
    }
    JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.InternalProblem{problem: JetEvalInternalProblem{span: Val(span), message: "native callback produced no terminal result"}}, stdout: callback_stdout, stderr: callback_stderr}
}

pub fn jet_eval_callback_release(machine: &JetEvalMachine, lease: Int, span: Span) -> Bool {
    root :: &machine.callback_roots.remove(lease) ?? {
        jet_eval_ownership_fail(&machine, span, "native callback lease was released more than once or is unknown")
        return false
    }
    if root.value == JetEvalRuntimeValue.Moved -> return true
    jet_eval_drop_value(&machine, root.value, span)
}
// Build the child machine for a task root. The child shares the session
// registry and output context but forks one fresh native callback scope from
// the retained physical services and binding roots.
fn jet_eval_task_machine(root: ^JetEvalTaskRoot, config: ^JetEvalConfig) -> JetEvalMachine {
    lease := root.callback_lease
    program := root.origin.program
    registry := root.origin.registry
    callback := root.callback
    output_context := root.origin.config.output_context
    active_config := config
    active_config.runtime_execution = true
    if output_context == .Val(_) {
        active_config.output_context = output_context
    }
    session_config := jet_eval_new_session_config(^active_config)
    identity := jet_eval_registry_machine_identity(registry)
    rows := jet_eval_program_rows(program)
    machine := JetEvalMachine{
        program: program,
        rows: rows,
        config: session_config,
        registry: registry,
        identity: identity,
        frames: [JetEvalFrame]{},
        callback_roots: [Int:JetEvalCallbackRoot]{},
        entry_access: None,
        entry_shared_loans: [JetEvalSharedEntryLoan]{},
        steps: 0,
        stdout: "",
        stderr: "",
        soft_stop: false,
        exit_code: None,
        failure: None,
        internal_problem: None,
    }
    machine.callback_roots[lease] = callback
    machine
}

// Take a task root out of the parent machine. A FnOnce root is moved: the
// parent stops owning it and its captured aliases travel unchanged. A reusable
// root is copied: one more alias per captured reference is minted for the
// child and the parent keeps its own. Nothing else in the parent changes; the
// registry stays canonical for both.
pub fn jet_eval_task_root_take(machine: &JetEvalMachine, lease: Int, span: Span) -> JetEvalTaskRoot? {
    if lease <= 0 {
        jet_eval_compiler_fail(&machine, span, "native task callback lease is invalid")
        return None
    }
    current :: machine.callback_roots.get(lease) ?? {
        jet_eval_compiler_fail(&machine, span, "native task callback lease is unknown")
        return None
    }
    if current.value == JetEvalRuntimeValue.Moved {
        jet_eval_ownership_fail(&machine, span, "native task callback lease has already been consumed")
        return None
    }
    if !jet_eval_callback_validate_root(&machine, current.value, current.reusable, span) -> return None
    callback := current
    if {
        current.reusable -> {
            retained :: jet_eval_copy_value(current.value, &machine, span) ?? return None
            callback.value = retained
            callback.invoked = false
        }
        else -> {
            callback = &machine.callback_roots.remove(lease) ?? {
                jet_eval_compiler_fail(&machine, span, "native task callback lease disappeared during transfer")
                return None
            }
        }
    }
    Val(JetEvalTaskRoot{
        origin: jet_eval_owned_root(machine),
        callback_lease: lease,
        callback: callback,
    })
}
pub fn jet_eval_task_config(machine: JetEvalMachine) -> JetEvalConfig {
    jet_eval_runtime_config(machine.config)
}

pub fn jet_eval_task_root_config(root: &JetEvalTaskRoot) -> JetEvalConfig Never! {
    jet_eval_owned_root_config(root.origin)
}

pub fn jet_eval_task_root_cleanup_root(root: &JetEvalTaskRoot) -> JetEvalOwnedRoot Never! {
    jet_eval_owned_root_cleanup_clone(&root.origin)
}



fn jet_eval_task_root_sync_origin(root: &JetEvalTaskRoot, machine: JetEvalMachine) Never! {
    root.origin.config.host_adapter = None
    root.origin.config.output_context = machine.config.output_context
}
pub fn jet_eval_task_callback_invoke(task_root: ^JetEvalTaskRoot, args: ^[JetEvalRuntimeValue], adapter: JetEvalHostAdapter, span: Span) -> JetEvalTaskCallbackInvokeResult {
    root := task_root
    machine := jet_eval_owned_root_machine(root.origin, adapter)
    callback := root.callback
    if {
        callback.reusable -> {
            retained :: jet_eval_copy_value(callback.value, &machine, span) ?? {
                cleanup_root := jet_eval_owned_root(machine)
                ok := jet_eval_retire_machine(&machine, span)
                result := jet_eval_task_cleanup_result(machine, ok, span)
                jet_eval_task_root_sync_origin(&root, machine)
                reusable :: root.callback.reusable
                return JetEvalTaskCallbackInvokeResult{root: root, result: result, reusable: reusable, cleanup_root: cleanup_root}
            }
            callback.value = retained
            callback.invoked = false
        }
        else -> {
            root.callback.value = JetEvalRuntimeValue.Moved
            root.callback.invoked = false
        }
    }
    machine.callback_roots[root.callback_lease] = callback
    callback_result := jet_eval_callback_invoke(&machine, root.callback_lease, ^args, span)
    if !root.callback.reusable {
        updated := machine.callback_roots.get(root.callback_lease)
        if updated != None -> root.callback = updated ?? root.callback
    }
    jet_eval_merge_callback_output(&machine, callback_result.stdout, callback_result.stderr)
    cleanup_root := jet_eval_owned_root(machine)
    ok := jet_eval_retire_machine(&machine, span)
    result := if {
        ok -> {
            JetEvalCallbackResult{outcome: callback_result.outcome, stdout: machine.stdout, stderr: machine.stderr}
        }
        else -> {
            jet_eval_task_cleanup_result(machine, false, span)
        }
    }
    jet_eval_task_root_sync_origin(&root, machine)
    reusable :: root.callback.reusable
    JetEvalTaskCallbackInvokeResult{root: root, result: result, reusable: reusable, cleanup_root: cleanup_root}
}


pub fn jet_eval_task_start(root: ^JetEvalTaskRoot, config: ^JetEvalConfig, args: [JetEvalRuntimeValue], span: Span) -> JetEvalResult {
    lease := root.callback_lease
    machine := jet_eval_task_machine(^root, ^config)
    callback_root :: machine.callback_roots.get(lease) ?? {
        loop arg in args -> jet_eval_drop_value(&machine, arg, span)
        jet_eval_internal_problem(&machine, Val(span), "native task root lost its callback lease")
        return jet_eval_result(^machine, None, false)
    }
    if callback_root.value == {
        .Closure(function, _) -> {
            function_row :: jet_eval_find_function(machine, function) ?? {
                loop arg in args -> jet_eval_drop_value(&machine, arg, span)
                jet_eval_internal_problem(&machine, Val(span), "native task callback function disappeared from its checked program")
                return jet_eval_result(^machine, None, false)
            }
            if args.len() != function_row.params.len() {
                loop arg in args -> jet_eval_drop_value(&machine, arg, span)
                jet_eval_internal_problem(&machine, Val(span), "native task callback arguments disagree with its checked function signature")
                return jet_eval_result(^machine, None, false)
            }
        }
        else -> {
            loop arg in args -> jet_eval_drop_value(&machine, arg, span)
            jet_eval_internal_problem(&machine, Val(span), "native task root is not a checked Source closure")
            return jet_eval_result(^machine, None, false)
        }
    }
    callback := jet_eval_callback_invoke(&machine, lease, ^args, span)
    jet_eval_merge_callback_output(&machine, callback.stdout, callback.stderr)
    if callback.outcome == {
        .Value(value) -> return jet_eval_result(^machine, Val(value), true)
        .Failure(error) -> {
            machine.failure = Val(error)
            return jet_eval_result(^machine, None, false)
        }
        .InternalProblem(problem) -> {
            machine.internal_problem = Val(problem)
            return jet_eval_result(^machine, None, false)
        }
        .SoftStop -> {
            machine.soft_stop = true
            return jet_eval_result(^machine, Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}), true)
        }
        .Exit(code) -> {
            machine.soft_stop = true
            machine.exit_code = Val(code)
            return jet_eval_result(^machine, Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}), true)
        }
    }
    jet_eval_internal_problem(&machine, Val(span), "native task callback produced an unknown outcome")
    jet_eval_result(^machine, None, false)
}

fn jet_eval_task_cleanup_result(machine: JetEvalMachine, ok: Bool, span: Span) -> JetEvalCallbackResult {
    if machine.internal_problem != None {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.InternalProblem{problem: machine.internal_problem ?? JetEvalInternalProblem{span: Val(span), message: "native task root cleanup failed"}}, stdout: machine.stdout, stderr: machine.stderr}
    }
    if machine.failure != None {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Failure{error: machine.failure ?? JetEvalError{kind: JetEvalErrorKind.Compiler, diagnostic: diagnostic_from_registry("E3401", Val(span), "native task root cleanup failed", "Source resource cleanup did not complete", "inspect the owning native resource boundary")}}, stdout: machine.stdout, stderr: machine.stderr}
    }
    if machine.exit_code != None {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Exit{code: machine.exit_code ?? 0}, stdout: machine.stdout, stderr: machine.stderr}
    }
    if machine.soft_stop {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.SoftStop, stdout: machine.stdout, stderr: machine.stderr}
    }
    if !ok {
        return JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.InternalProblem{problem: JetEvalInternalProblem{span: Val(span), message: "native task root cleanup failed without a diagnostic"}}, stdout: machine.stdout, stderr: machine.stderr}
    }
    JetEvalCallbackResult{outcome: JetEvalCallbackOutcome.Value{value: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}}, stdout: machine.stdout, stderr: machine.stderr}
}

pub fn jet_eval_task_root_release(task_root: ^JetEvalTaskRoot, adapter: JetEvalHostAdapter, span: Span) -> JetEvalCallbackResult {
    root := task_root
    machine := jet_eval_owned_root_machine(root.origin, adapter)
    if root.callback.value == JetEvalRuntimeValue.Moved {
        if root.callback.reusable || !root.callback.invoked {
            jet_eval_ownership_fail(&machine, span, "native task root was released more than once or was already consumed")
            _ := jet_eval_retire_machine(&machine, span)
            jet_eval_task_root_sync_origin(&root, machine)
            return jet_eval_task_cleanup_result(machine, false, span)
        }
        root.callback.invoked = false
        ok := jet_eval_retire_machine(&machine, span)
        jet_eval_task_root_sync_origin(&root, machine)
        return jet_eval_task_cleanup_result(machine, ok, span)
    }
    callback := root.callback.value
    root.callback.value = JetEvalRuntimeValue.Moved
    root.callback.invoked = false
    ok := jet_eval_drop_value(&machine, callback, span)
    ok = jet_eval_retire_machine(&machine, span) && ok
    jet_eval_task_root_sync_origin(&root, machine)
    jet_eval_task_cleanup_result(machine, ok, span)
}

fn jet_eval_run(machine: &JetEvalMachine, target_depth: Int) -> JetEvalRuntimeValue? {
    loop machine.frames.len() > target_depth && machine.failure == None && machine.internal_problem == None && !machine.soft_stop {
        if !jet_eval_poll_callbacks(&machine, jet_eval_empty_span()) -> break
        if !machine.config.runtime_execution && machine.steps >= machine.config.fuel {
            jet_eval_fuel_fail(&machine, jet_eval_empty_span())
            break
        }
        machine.steps += 1
        action :: jet_eval_step(&machine) ?? break
        if action == .Continue {}
        if action == .Return(value) {
            if machine.config.runtime_execution && target_depth == 0 {
                return Val(value)
            }
            frame_index := machine.frames.len() - 1
            if !jet_eval_cleanup_frame(&machine, frame_index, jet_eval_empty_span()) {
                if !jet_eval_has_failure(machine) -> jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "MIR frame cleanup failed without a diagnostic")
                _ := &machine.frames.pop()
                return None
            }
            _ := &machine.frames.pop()
            if machine.frames.len() == target_depth -> return Val(value)
        }
    }
    None
}

fn jet_eval_step(machine: &JetEvalMachine) -> JetEvalStep? {
    if machine.frames.len() == 0 {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "MIR evaluator has no active frame")
        return None
    }
    frame_index := machine.frames.len() - 1
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "MIR evaluator frame function is unavailable")
        return None
    }
    block :: jet_eval_function_block_row(machine, function, machine.frames[frame_index].block) ?? {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "MIR evaluator block is unavailable")
        return None
    }
    ip :: machine.frames[frame_index].ip
    stepped := JetEvalStep?{None}
    step_span := machine.program.functions[function].span
    if {
        ip < machine.program.functions[function].blocks[block].instructions.len() -> {
            instruction := machine.program.functions[function].blocks[block].instructions[ip]
            step_span = instruction.span
            machine.frames[frame_index].ip += 1
            stepped = jet_eval_instruction(&machine, frame_index, instruction)
        }
        else -> {
            terminator := machine.program.functions[function].blocks[block].terminator
            stepped = jet_eval_terminator(&machine, frame_index, terminator)
        }
    }
    // A step that stops evaluation names why: a failure, an internal problem,
    // or a soft stop. One that stopped with none of them would leave the run
    // unexplained, so it is reported here at the step that stopped.
    if stepped == None && !jet_eval_has_failure(machine) && !machine.soft_stop {
        block_number :: machine.frames[frame_index].block.value
        function_key :: machine.program.functions[function].key
        jet_eval_compiler_fail(&machine, step_span, "MIR step {ip} of block {block_number} in `{function_key}` stopped without a diagnostic")
    }
    stepped
}

fn jet_eval_mir_ownership_is_borrowed(ownership: MIROwnership) -> Bool Never! {
    ownership.mode == MIROwnershipMode.ReadBorrow || ownership.mode == MIROwnershipMode.WriteBorrow
}

fn jet_eval_store(machine: &JetEvalMachine, frame_index: Int, result: MIRValueID?, value: JetEvalRuntimeValue, operation: MIROperation, span: Span) -> Bool {
    if result == None -> return true
    id :: result
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR result function is unavailable")
        return false
    }
    borrowed := false
    loop index in 0..<machine.program.functions[function].values.len() {
        if machine.program.functions[function].values[index].id == id -> borrowed = jet_eval_mir_ownership_is_borrowed(machine.program.functions[function].values[index].ownership)
    }
    if operation == {
        .Parameter(index, _) -> {
            if index >= 0 && index < machine.frames[frame_index].entry_accesses.len()
                && machine.frames[frame_index].entry_accesses[index] == MIRAccess.Write {
                borrowed = false
            }
        }
        .Capture(_) -> {
            if machine.frames[frame_index].captures_borrowed {
                borrowed = true
            }
        }
        else -> {}
    }
    existing := machine.frames[frame_index].values.get(id.value)
    if existing != None {
        previous :: existing ?? return false
        previous_borrowed := machine.frames[frame_index].borrowed_values.get(id.value) == (Val(true))
        if value != JetEvalRuntimeValue.Moved && !previous_borrowed && !jet_eval_drop_value(&machine, previous, span) -> return false
    }
    machine.frames[frame_index].values[id.value] = value
    if {
        borrowed -> {
            machine.frames[frame_index].borrowed_values[id.value] = true
        }
        else -> {
            _ := &machine.frames[frame_index].borrowed_values.remove(id.value)
        }
    }
    true
}

fn jet_eval_value(machine: &JetEvalMachine, frame_index: Int, id: MIRValueID, span: Span) -> JetEvalRuntimeValue? {
    value :: machine.frames[frame_index].values.get(id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR SSA value is unavailable")
        return None
    }
    if machine.frames[frame_index].borrowed_values.get(id.value) == (Val(true)) {
        return jet_eval_borrow_value(value, &machine, span)
    }
    jet_eval_copy_value(value, &machine, span)
}

fn jet_eval_parameter(machine: &JetEvalMachine, frame_index: Int, index: Int, span: Span) -> JetEvalRuntimeValue? {
    if index < 0 || index >= machine.frames[frame_index].params.len() {
        jet_eval_compiler_fail(&machine, span, "MIR parameter index is outside the call argument list")
        return None
    }
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return None
    if index >= machine.program.functions[function].params.len() {
        jet_eval_compiler_fail(&machine, span, "MIR parameter metadata is unavailable")
        return None
    }
    if machine.program.functions[function].params[index].access == MIRAccess.Read {
        value := machine.frames[frame_index].params[index]
        return jet_eval_borrow_value(value, &machine, span)
    }
    value := machine.frames[frame_index].params[index]
    machine.frames[frame_index].params[index] = JetEvalRuntimeValue.Moved
    jet_eval_borrow_value(value, &machine, span)
}

fn jet_eval_capture(machine: &JetEvalMachine, frame_index: Int, slot: Int, span: Span) -> JetEvalRuntimeValue? {
    if slot < 0 || slot >= machine.frames[frame_index].captures.len() {
        jet_eval_compiler_fail(&machine, span, "MIR capture slot is outside the closure capture list")
        return None
    }
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return None
    if slot >= machine.program.functions[function].capture_params.len() {
        jet_eval_compiler_fail(&machine, span, "MIR capture metadata is unavailable")
        return None
    }
    access := machine.program.functions[function].capture_params[slot].access
    if machine.frames[frame_index].captures_borrowed {
        if access == MIRAccess.Move {
            jet_eval_ownership_fail(&machine, span, "MIR cannot move a capture from a borrowed closure")
            return None
        }
        value := machine.frames[frame_index].captures[slot]
        return jet_eval_borrow_value(value, &machine, span)
    }
    if access == MIRAccess.Move {
        value := machine.frames[frame_index].captures[slot]
        machine.frames[frame_index].captures[slot] = JetEvalRuntimeValue.Moved
        return jet_eval_borrow_value(value, &machine, span)
    }
    value := machine.frames[frame_index].captures[slot]
    jet_eval_borrow_value(value, &machine, span)
}

fn jet_eval_phi(machine: &JetEvalMachine, frame_index: Int, incoming: [MIRPhiIncoming], span: Span) -> JetEvalRuntimeValue? {
    predecessor := machine.frames[frame_index].predecessor ?? {
        jet_eval_compiler_fail(&machine, span, "MIR phi operation has no predecessor block")
        return None
    }
    loop row in incoming {
        if row.block == predecessor -> return jet_eval_transfer(&machine, frame_index, row.value, span)
    }
    jet_eval_compiler_fail(&machine, span, "MIR phi operation has no incoming value for its predecessor")
    None
}

// Writes, phis and carrier extraction consume owned SSA values just as native
// MIR emission does; Copy-typed values stay available to later uses of their
// SSA ID. A borrowed slot leaves the frame without minting an owned alias.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::transfer_value
fn jet_eval_transfer(machine: &JetEvalMachine, frame_index: Int, value: MIRValueID, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR transfer function is unavailable")
        return None
    }
    mode := MIROwnershipMode?{None}
    loop index in 0..<machine.program.functions[function].values.len() {
        if machine.program.functions[function].values[index].id == value {
            mode = Val(machine.program.functions[function].values[index].ownership.mode)
            break
        }
    }
    checked_mode :: mode ?? {
        jet_eval_compiler_fail(&machine, span, "MIR value ID has no ownership fact")
        return None
    }
    if checked_mode == MIROwnershipMode.Copy -> return jet_eval_value(&machine, frame_index, value, span)
    if machine.frames[frame_index].borrowed_values.get(value.value) == (Val(true)) {
        item :: machine.frames[frame_index].values.get(value.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR move reads an unavailable SSA value")
            return None
        }
        borrowed :: jet_eval_borrow_value(item, &machine, span) ?? return None
        _ := &machine.frames[frame_index].values.remove(value.value)
        _ := &machine.frames[frame_index].borrowed_values.remove(value.value)
        return Val(borrowed)
    }
    jet_eval_take(&machine, frame_index, value, span)
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::type_instance_name
fn jet_eval_type_name(machine: &JetEvalMachine, id: MIRTypeID, span: Span) -> String? {
    instances :: machine.rows.type_instances.get(id.value) ?? [Int]{}
    if instances.len() > 0 -> return Val(jet_eval_type_display_name(machine, machine.program.type_instances[instances[0]]))
    row :: machine.rows.types.get(id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR aggregate type identity is unavailable")
        return None
    }
    Val(machine.program.types[row].name)
}

// The owner name a value built here carries: a nominal spells its checked
// declaration's display name, with type arguments only when it has some, and
// a tag never changes the owner. Emission, fact enums and folded constants
// resolve a prepared value's owner by this spelling (`Row`, not `Row<>`).
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::mir_type_display_name
fn jet_eval_type_display_name(machine: JetEvalMachine, ty: MIRType) -> String Never! {
    if ty.kind == {
        .Apply(name, args) -> {
            head :: jet_eval_checked_nominal_name(machine, name.id, name.name)
            if args.len() == 0 -> return head
            pieces := [String]{}
            loop arg in args -> &pieces.push(jet_eval_type_display_name(machine, arg))
            return "{head}<{pieces.join(", ")}>"
        }
        .Tagged(_, inner) -> return jet_eval_type_display_name(machine, inner)
        else -> {}
    }
    mir_type_display_name(ty)
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::checked_nominal_name
fn jet_eval_checked_nominal_name(machine: JetEvalMachine, id: MIRTypeID, raw: String) -> String Never! {
    if machine.rows.types.get(id.value) == .Val(row) -> return machine.program.types[row].name
    loop index in 0..<machine.program.types.len() {
        if machine.program.types[index].key == raw || machine.program.types[index].name == raw -> return machine.program.types[index].name
    }
    ~raw
}
fn jet_eval_trait_box_target(machine: &JetEvalMachine, target: MIRTypeID, result_ty: MIRType?, span: Span) -> Bool Never! {
    instances :: machine.rows.type_instances.get(target.value) ?? [Int]{}
    if instances.len() > 1 {
        jet_eval_compiler_fail(&machine, span, "MIR trait boxing target identity is ambiguous")
        return false
    }
    if instances.len() == 0 {
        jet_eval_compiler_fail(&machine, span, "MIR trait boxing target type is unavailable")
        return false
    }
    checked :: machine.program.type_instances[instances[0]]
    if checked.kind == {.TraitObject(bounds) -> {
        if bounds.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR trait boxing target must name exactly one trait")
            return false
        }
    } else -> {
        jet_eval_compiler_fail(&machine, span, "MIR trait boxing target is not a trait-object type")
        return false
    }}
    if result_ty != None {
        result :: result_ty
        if result.identity != (Val(target)) {
            jet_eval_compiler_fail(&machine, span, "MIR trait boxing result type disagrees with its target")
            return false
        }
    }
    true
}

fn jet_eval_enum_args(machine: &JetEvalMachine, args: [MIREnumArg], frame_index: Int, span: Span) -> [TComptimeEnumArg]? {
    output := [TComptimeEnumArg]{}
    loop arg in args {
        value :: jet_eval_value(&machine, frame_index, arg.value, span) ?? return None
        data :: jet_eval_data(value, &machine, span) ?? return None
        name := if arg.field == None -> None else -> Val(jet_eval_field_name(machine, arg.field ?? MIRFieldID{value: 0}) ?? "")
        &output.push(TComptimeEnumArg{name: name, value: data})
    }
    output
}

// A runtime value that materializes as compile-time data without a
// diagnostic. A runtime aggregate, closure, address or native carrier is
// never data. Rust: crates/jet-codegen/src/Codegen/MIREval.rs::runtime_to_data
fn jet_eval_runtime_is_data(value: JetEvalRuntimeValue) -> Bool Never! {
    if value == {
        .Data(data) -> return !jet_eval_data_contains_moved(data)
        .Absent(_) -> return true
        .Result(_, nested) -> return jet_eval_runtime_is_data(nested)
        else -> return false
    }
}

fn jet_eval_drop_runtime_fields(machine: &JetEvalMachine, fields: [JetEvalRuntimeField], span: Span) {
    loop field in fields -> _ := jet_eval_drop_value(&machine, field.value, span)
}

// Struct-shaped builders keep compile-time data when every field is data and
// otherwise preserve an owned runtime aggregate. `transfer` consumes owned
// field values (struct literals); otherwise each field is copied (tuples).
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::aggregate_or_data
fn jet_eval_aggregate_or_data(machine: &JetEvalMachine, type_name: String, fields: [MIRFieldValue], frame_index: Int, transfer: Bool, span: Span) -> JetEvalRuntimeValue? {
    runtime := [JetEvalRuntimeField]{}
    all_data := true
    loop field in fields {
        name :: jet_eval_field_name(machine, field.field) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR aggregate field ID is missing")
            jet_eval_drop_runtime_fields(&machine, runtime, span)
            return None
        }
        borrowed := machine.frames[frame_index].borrowed_values.get(field.value.value) == (Val(true))
        value := JetEvalRuntimeValue.Moved
        if {
            transfer -> {
                value = jet_eval_transfer(&machine, frame_index, field.value, span) ?? {
                    jet_eval_drop_runtime_fields(&machine, runtime, span)
                    return None
                }
                if borrowed && !jet_eval_retain_value(&machine, value, span) {
                    jet_eval_drop_runtime_fields(&machine, runtime, span)
                    return None
                }
            }
            else -> {
                item :: machine.frames[frame_index].values.get(field.value.value) ?? {
                    jet_eval_compiler_fail(&machine, span, "MIR value is unavailable at its use")
                    jet_eval_drop_runtime_fields(&machine, runtime, span)
                    return None
                }
                value = jet_eval_copy_value(item, &machine, span) ?? {
                    jet_eval_drop_runtime_fields(&machine, runtime, span)
                    return None
                }
            }
        }
        &runtime.push(JetEvalRuntimeField{name: name, value: value})
        if jet_eval_runtime_contains_moved(value) {
            jet_eval_compiler_fail(&machine, span, "MIR value was moved")
            jet_eval_drop_runtime_fields(&machine, runtime, span)
            return None
        }
        if !jet_eval_runtime_is_data(value) -> all_data = false
    }
    if !all_data -> return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: type_name, fields: runtime}})
    output := [TComptimeField]{}
    loop field in runtime {
        data :: jet_eval_data(field.value, &machine, span) ?? return None
        &output.push(TComptimeField{name: field.name, value: data})
    }
    Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Struct{type_name: type_name, fields: output}})
}

fn jet_eval_constant_instruction(machine: &JetEvalMachine, constant: MIRConstant, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_constant_runtime(constant, &machine, span)
}

fn jet_eval_option_element(ty: MIRType) -> MIRType Never! {
    if ty.kind == .Option(inner) -> return inner
    ~ty
}

fn jet_eval_binary_route_args(machine: &JetEvalMachine, call: MIRPreludeCallID, left: JetEvalRuntimeValue, right: JetEvalRuntimeValue, location: MIRPanicLoc?, span: Span) -> [JetEvalRuntimeValue]? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    output := [JetEvalRuntimeValue]{left, right}
    delta := row.signature.arity - output.len()
    if {
        delta == 2 -> {
            panic_location :: location ?? {
                jet_eval_compiler_fail(&machine, span, "MIR binary Prelude route is missing its source location")
                return None
            }
            path :: jet_eval_route_source_path(&machine, panic_location.file, span) ?? return None
            &output.push(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: path}})
            &output.push(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: panic_location.line}})
        }
        delta != 0 -> {
            jet_eval_compiler_fail(&machine, span, "MIR binary Prelude route has an invalid location ABI")
            return None
        }
    }
    Val(output)
}
// Mint one owned copy of each borrowed argument (undoing on failure) so a
// callee frame can take ownership while the caller still discharges its own.
fn jet_eval_copy_values(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], span: Span) -> [JetEvalRuntimeValue]? {
    output := [JetEvalRuntimeValue]{}
    loop arg in args {
        copied :: jet_eval_copy_value(arg, &machine, span) ?? {
            jet_eval_drop_values(&machine, output, span)
            return None
        }
        &output.push(copied)
    }
    Val(output)
}

// Prelude route dispatch BORROWS `args`; the call site that produced the
// owned values discharges them after this returns. Route bodies copy what
// they keep and never release an argument.
fn jet_eval_route_prelude_dispatch(machine: &JetEvalMachine, call: MIRPreludeCallID, args: [JetEvalRuntimeValue], type_args: [MIRType], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    lookup := jet_eval_source_lookup(machine.program, row)
    if lookup == {
        .Target(target) -> {
            owned :: jet_eval_copy_values(&machine, args, span) ?? return None
            return jet_eval_invoke(&machine, target.function, owned, [JetEvalRuntimeValue]{}, span)
        }
        .Invalid(reason) -> {
            jet_eval_unsupported(&machine, span, reason)
            return None
        }
        .Unavailable -> {}
    }
    if jet_eval_stream_owns_row(row, args) -> return jet_eval_stream_route(&machine, row, args, span)
    if jet_eval_shared_runtime_owns_row(row) -> return jet_eval_shared_runtime_route(&machine, row, args, type_args, result_ty, span)
    jet_eval_route_prelude(&machine, call, args, type_args, result_ty, span)
}

// Native Fn values reach the evaluator only as Native-owner tokens (the private
// binding transport); the checked Fn type of the binding is validated at the
// call site against the callee's checked type.
fn jet_eval_native_binding_callable(machine: &JetEvalMachine, frame_index: Int, callee: MIRValueID, identity: JetEvalNativeBindingIdentity, span: Span) -> JetEvalNativeCallBinding? {
    binding := JetEvalNativeCallableBinding?{None}
    if identity == {
        .Callable(callable) -> binding = Val(callable)
        .Interface(_) -> {
            jet_eval_compiler_fail(&machine, span, "MIR native interface carrier is not an indirect Fn value")
            return None
        }
    }
    callable :: binding ?? return None
    checked_type :: jet_eval_value_type(&machine, frame_index, callee, span) ?? return None
    if !mir_type_same_checked_type(checked_type, callable.callable_type) {
        jet_eval_compiler_fail(&machine, span, "MIR native binding callee disagrees with its checked Fn type")
        return None
    }
    if callable.callable_type.kind == {
        .Fn(_) | .SendFn(_, _, _) -> {}
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR native binding carrier does not have a checked Fn type")
            return None
        }
    }
    Val(JetEvalNativeCallBinding.Callable{binding: callable})
}
fn jet_eval_native_interface_binding(machine: &JetEvalMachine, receiver: JetEvalRuntimeValue, call_access: MIRAccess, method_id: MIRTraitMethodID, trait_ref: MIRTraitRef, receiver_ty: MIRType, span: Span) -> JetEvalNativeCallBinding? {
    receiver_value := receiver
    temporary := false
    receiver_carrier_access := MIRAccess?{None}
    if receiver == {
        .Address(frame, place, access) -> {
            if access == MIRAccess.Move {
                jet_eval_ownership_fail(&machine, span, "MIR native interface receiver uses a move-only address")
                return None
            }
            receiver_value = jet_eval_read_place(&machine, frame, place, span) ?? return None
            temporary = true
            receiver_carrier_access = Val(access)
        }
        .SharedCell(cell, access) -> {
            if access == MIRAccess.Move {
                jet_eval_ownership_fail(&machine, span, "MIR native interface receiver uses a move-only shared capture cell")
                return None
            }
            receiver_value = jet_eval_shared_read(&machine, cell, span) ?? return None
            temporary = true
            receiver_carrier_access = Val(access)
        }
        else -> {}
    }
    native_receiver_type := MIRType?{None}
    if receiver_value == {
        .ForeignHandle(handle, raw, token) -> {
            if !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) {
                if temporary -> jet_eval_drop_value(&machine, receiver_value, span)
                return None
            }
            kind := jet_eval_foreign_token_kind(machine, token)
            if kind == {
                Val(native_identity) -> {
                    if native_identity == {
                        .Native(interface_identity) -> {
                            if interface_identity == .Interface(checked_type) -> native_receiver_type = Val(checked_type)
                        }
                        else -> {}
                    }
                }
                None -> {}
            }
        }
        else -> {}
    }
    if temporary && !jet_eval_drop_value(&machine, receiver_value, span) -> return None
    checked_receiver_type :: native_receiver_type ?? return None
    if !mir_type_same_checked_type(checked_receiver_type, receiver_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR native interface receiver disagrees with its checked trait-object VALUE type")
        return None
    }
    if receiver_ty.kind == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 || bounds[0].id != trait_ref.id {
                jet_eval_compiler_fail(&machine, span, "MIR native interface receiver does not carry the called checked trait bound")
                return None
            }
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR native interface receiver type is not a checked trait object")
            return None
        }
    }
    trait_fact :: machine.rows.traits.get(trait_ref.id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR native interface call references a missing trait")
        return None
    }
    method_row := MIRTraitMethod?{None}
    loop index in 0..<machine.program.traits[trait_fact].methods.len() {
        if machine.program.traits[trait_fact].methods[index].id == method_id -> method_row = Val(machine.program.traits[trait_fact].methods[index])
    }
    method :: method_row ?? {
        jet_eval_compiler_fail(&machine, span, "MIR native interface call references a missing method")
        return None
    }
    receiver_access := method.self_access ?? MIRAccess.Read
    if receiver_access != call_access {
        jet_eval_ownership_fail(&machine, span, "MIR native interface receiver access disagrees with its checked method self access")
        return None
    }
    if receiver_carrier_access != None && (receiver_carrier_access ?? call_access) != call_access {
        jet_eval_ownership_fail(&machine, span, "MIR native interface address access disagrees with its checked method self access")
        return None
    }
    Val(JetEvalNativeCallBinding.Interface{binding: JetEvalNativeInterfaceBinding{
        trait_ref: trait_ref,
        method_id: method_id,
        method_name: method.name,
        receiver_type: receiver_ty,
        receiver_access: receiver_access,
    }})
}
fn jet_eval_native_call_exchange(machine: &JetEvalMachine, binding: JetEvalNativeCallBinding, args: [JetEvalRuntimeValue], move_permissions: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    host_args :: jet_eval_native_host_arguments(&machine, args, move_permissions, span) ?? return None
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    reply :: adapter.native_call(&machine, binding, ^host_args, result_shape, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR checked native callable is unavailable to the canonical host adapter")
        return None
    }
    jet_eval_apply_native_reply(&machine, binding, reply, args, move_permissions, result_ty, span)
}

fn jet_eval_native_call(machine: &JetEvalMachine, binding: JetEvalNativeCallBinding, args: [JetEvalRuntimeValue], move_permissions: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    result := jet_eval_native_call_exchange(&machine, binding, args, move_permissions, result_ty, span)
    jet_eval_discharge_call_boundary(&machine, args, move_permissions, result, span)
}

fn jet_eval_trait_method_function(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], method_id: MIRTraitMethodID, trait_ref: MIRTraitRef, receiver_ty: MIRType, span: Span) -> MIRFunctionID? {
    if values.len() == 0 {
        jet_eval_compiler_fail(&machine, span, "MIR trait method call has no receiver")
        return None
    }
    receiver := values[0]
    temporary := false
    if receiver == {
        .Address(frame, place, access) -> {
            if access == MIRAccess.Move {
                jet_eval_ownership_fail(&machine, span, "MIR trait method receiver uses a move-only address")
                return None
            }
            receiver = jet_eval_read_place(&machine, frame, place, span) ?? return None
            temporary = true
        }
        .SharedCell(cell, access) -> {
            if access == MIRAccess.Move {
                jet_eval_ownership_fail(&machine, span, "MIR trait method receiver uses a move-only shared capture cell")
                return None
            }
            receiver = jet_eval_shared_read(&machine, cell, span) ?? return None
            temporary = true
        }
        else -> {}
    }
    concrete_type := MIRType?{None}
    concrete_name := ""
    if receiver == {.ForeignHandle(_, _, token) -> {
        kind :: jet_eval_foreign_token_kind(machine, token) ?? {
            if temporary -> jet_eval_drop_value(&machine, receiver, span)
            return None
        }
        if kind == {
            .Declared(ty) -> concrete_type = Val(ty)
            .Core(owner) -> concrete_type = Val(owner.ty)
            .Native(identity) -> {
                if identity == {
                    .Callable(callable) -> concrete_type = Val(callable.callable_type)
                    .Interface(interface_type) -> concrete_type = Val(interface_type)
                }
            }
            else -> {}
        }
    } else -> {
        data :: jet_eval_data(receiver, &machine, span) ?? {
            if temporary -> jet_eval_drop_value(&machine, receiver, span)
            return None
        }
        concrete_name = if data == {
            .Struct(type_name, _) | .Enum(type_name, _, _) -> type_name
            else -> {
                if temporary -> jet_eval_drop_value(&machine, receiver, span)
                jet_eval_compiler_fail(&machine, span, "MIR trait method receiver is not a nominal value")
                return None
            }
        }
        loop index in 0..<machine.program.type_instances.len() {
            if machine.program.type_instances[index].kind == .Apply(_, _) && jet_eval_type_display_name(machine, machine.program.type_instances[index]) == concrete_name {
                if concrete_type != None {
                    if temporary -> jet_eval_drop_value(&machine, receiver, span)
                    jet_eval_compiler_fail(&machine, span, "MIR trait method receiver `{concrete_name}` has an ambiguous canonical nominal type")
                    return None
                }
                concrete_type = Val(machine.program.type_instances[index])
            }
        }
    }
    }
    if temporary && !jet_eval_drop_value(&machine, receiver, span) -> return None
    nominal :: concrete_type ?? {
        jet_eval_compiler_fail(&machine, span, "MIR trait method receiver `{concrete_name}` has no checked nominal type")
        return None
    }
    if concrete_name == "" -> concrete_name = jet_eval_type_display_name(machine, nominal)
    trait_fact :: machine.rows.traits.get(trait_ref.id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR trait method references a missing trait")
        return None
    }
    method_row := MIRTraitMethod?{None}
    loop index in 0..<machine.program.traits[trait_fact].methods.len() {
        if machine.program.traits[trait_fact].methods[index].id == method_id -> method_row = Val(machine.program.traits[trait_fact].methods[index])
    }
    method :: method_row ?? {
        jet_eval_compiler_fail(&machine, span, "MIR trait method references a missing method")
        return None
    }
    candidates := [MIRFunctionID]{}
    impl_rows :: machine.rows.impls_by_trait.get(trait_ref.id.value) ?? [Int]{}
    loop impl_index in impl_rows {
        if !mir_type_same_checked_type(machine.program.impls[impl_index].self_type, nominal) -> next
        loop function_id in machine.program.impls[impl_index].methods {
            function :: jet_eval_function_row(machine, function_id) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR trait implementation references a missing function")
                return None
            }
            if machine.program.functions[function].name != method.name -> next
            if machine.program.functions[function].form == {
                .TraitMethod(_, function_trait, _, _) -> {
                    if function_trait.id == trait_ref.id {
                        duplicate := false
                        loop existing in candidates {
                            if existing == function_id -> duplicate = true
                        }
                        if !duplicate -> &candidates.push(function_id)
                    }
                }
                else -> {}
            }
        }
    }
    if candidates.len() == 1 -> return Val(candidates[0])
    if candidates.len() == 0 {
        default :: method.default ?? {
            jet_eval_compiler_fail(&machine, span, "MIR trait method `{method.name}` has no implementation for `{concrete_name}`")
            return None
        }
        if jet_eval_function_row(machine, default) == None {
            jet_eval_compiler_fail(&machine, span, "MIR trait method default implementation is missing")
            return None
        }
        return Val(default)
    }
    jet_eval_compiler_fail(&machine, span, "MIR trait method `{method.name}` has ambiguous implementations for `{concrete_name}`")
    None
}

fn jet_eval_call(machine: &JetEvalMachine, frame_index: Int, callee: MIRCallee, args: [MIRCallArg], type_args: [MIRType], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
    values := prepared.values
    if callee == {
        .User(function) -> return jet_eval_invoke(&machine, function, values, [JetEvalRuntimeValue]{}, span)
        .Associated(function, _) -> return jet_eval_invoke(&machine, function, values, [JetEvalRuntimeValue]{}, span)
        .Method(function, _) -> return jet_eval_invoke(&machine, function, values, [JetEvalRuntimeValue]{}, span)
        .Prelude(call) -> {
            result := jet_eval_route_prelude_dispatch(&machine, call, values, type_args, result_ty, span)
            return jet_eval_discharge_call_boundary(&machine, values, prepared.move_permissions, result, span)
        }
        .TraitMethod(method, trait_ref, receiver) -> {
            if values.len() > 0 {
                call_access := args[0].access
                native_binding := jet_eval_native_interface_binding(&machine, values[0], call_access, method, trait_ref, receiver, span)
                if native_binding != None {
                    return jet_eval_native_call(&machine, native_binding ?? return None, values, prepared.move_permissions, result_ty, span)
                }
                if jet_eval_has_failure(&machine) {
                    jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
                    return None
                }
            }
            function :: jet_eval_trait_method_function(&machine, values, method, trait_ref, receiver, span) ?? {
                jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
                return None
            }
            return jet_eval_invoke(&machine, function, values, [JetEvalRuntimeValue]{}, span)
        }
        .Core(_) -> {
            jet_eval_unsupported(&machine, span, "direct Core MIR call")
            jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
            return None
        }
        .Foreign(foreign) -> return jet_eval_foreign_call(&machine, frame_index, foreign, args, values, span)
        .Indirect(callee_value) -> {
            callee_borrowed := machine.frames[frame_index].borrowed_values.get(callee_value.value) == (Val(true))
            closure_result := jet_eval_value(&machine, frame_index, callee_value, span)
            if closure_result == None {
                jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
                return None
            }
            closure :: closure_result ?? return None
            if closure == .ForeignHandle(_, _, token) {
                if jet_eval_foreign_token_kind(machine, token) == {
                    Val(kind) -> if kind == .Native(binding) {
                        callable :: jet_eval_native_binding_callable(&machine, frame_index, callee_value, binding, span) ?? {
                            if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
                            jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
                            return None
                        }
                        result := jet_eval_native_call(&machine, callable, values, prepared.move_permissions, result_ty, span)
                        if callee_borrowed -> return result
                        return jet_eval_discharge_boundary(&machine, [JetEvalRuntimeValue]{closure}, result, span)
                    }
                    None -> {}
                }
            }
            if closure == .Closure(function, captures) {
                wrap_ok :: jet_eval_indirect_call_wraps_ok(&machine, function, result_ty, span) ?? {
                    if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
                    jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
                    return None
                }
                returned :: jet_eval_invoke_with_borrowed_captures(&machine, function, values, captures, callee_borrowed, span) ?? return None
                if wrap_ok -> return Val(JetEvalRuntimeValue.Result{ok: true, value: returned})
                return Val(returned)
            }
            if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
            jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
            jet_eval_compiler_fail(&machine, span, "MIR indirect call target is not a checked callable")
            return None
        }
    }
}


fn jet_eval_loop_cursor(machine: &JetEvalMachine, frame_index: Int, id: MIRValueID, span: Span) -> JetEvalRuntimeValue? {
    value :: machine.frames[frame_index].values.get(id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR iterator cursor value is unavailable")
        return None
    }
    jet_eval_borrow_value(value, &machine, span)
}

fn jet_eval_has_next(value: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> Bool? {
    if value == .RangeCursor(_, end, current, step, exclusive) {
        if step == 0 {
            jet_eval_compiler_fail(&machine, span, "MIR range cursor has zero step")
            return None
        }
        return Val(if step > 0 -> if exclusive -> current < end else -> current <= end else -> if exclusive -> current > end else -> current >= end)
    }
    if value == .ListCursor(values, index, step) -> return Val(index >= 0 && index < values.len())
    if value == .Stream(values, index, _, _) -> return Val(index >= 0 && index < values.len())
    jet_eval_compiler_fail(&machine, span, "MIR iterator operation does not have a cursor")
    None
}

fn jet_eval_cursor_value(value: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if value == .RangeCursor(_, _, current, _, _) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: current}})
    if value == .ListCursor(values, index, _) {
        if index < 0 || index >= values.len() {
            jet_eval_compiler_fail(&machine, span, "MIR iterator is exhausted")
            return None
        }
        return jet_eval_copy_value(values[index], &machine, span)
    }
    if value == .Stream(values, index, _, stages) {
        if index < 0 || index >= values.len() {
            jet_eval_compiler_fail(&machine, span, "MIR iterator is exhausted")
            return None
        }
        return jet_eval_stream_row(&machine, values[index], index, stages, span)
    }
    jet_eval_compiler_fail(&machine, span, "MIR iterator value operation does not have a cursor")
    None
}

fn jet_eval_advance_cursor(machine: &JetEvalMachine, frame_index: Int, id: MIRValueID, span: Span) -> Bool Never! {
    current :: machine.frames[frame_index].values.get(id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR iterator cursor value is unavailable")
        return false
    }
    if current == .RangeCursor(start, end, position, step, exclusive) {
        machine.frames[frame_index].values[id.value] = JetEvalRuntimeValue.RangeCursor{start: start, end: end, current: position + step, step: step, exclusive: exclusive}
        return true
    }
    if current == .ListCursor(values, index, step) {
        machine.frames[frame_index].values[id.value] = JetEvalRuntimeValue.ListCursor{values: values, index: index + step, step: step}
        return true
    }
    if current == .Stream(values, index, step, stages) {
        machine.frames[frame_index].values[id.value] = JetEvalRuntimeValue.Stream{values: values, index: index + step, step: step, stages: stages}
        return true
    }
    jet_eval_compiler_fail(&machine, span, "MIR iterator advance value is not a cursor")
    false
}

// One pulled `Stream` row: the source item passed through every
// `iter_enumerate` stage as `(position, row)`. The stages stay owned by the
// stream, so each call borrows their captures.
fn jet_eval_stream_row(machine: &JetEvalMachine, item: TComptimeValue, position: Int, stages: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    row := JetEvalRuntimeValue.Data{value: item}
    loop stage in stages {
        if stage == .Closure(function, captures) {
            args := [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: position}}, row}
            row = jet_eval_invoke_with_borrowed_captures(&machine, function, args, captures, true, span) ?? return None
            next
        }
        jet_eval_compiler_fail(&machine, span, "MIR indexed stream stage is not a checked closure")
        jet_eval_drop_value(&machine, row, span)
        return None
    }
    Val(row)
}

// `jet_iter_enumerate` (`.indexed()` and the two-binding list loop): a lazy
// source gains one row stage; a list receiver becomes a lazy source first.
// `values` is borrowed; the call boundary discharges it.
fn jet_eval_stream_enumerate(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    if values.len() != 2 {
        jet_eval_compiler_fail(&machine, span, "MIR indexed route requires one row callback")
        return None
    }
    source :: jet_eval_iterator_host_value(values[0], &machine, span) ?? return None
    if source == .Stream(items, index, step, stages) {
        callback :: jet_eval_copy_value(values[1], &machine, span) ?? {
            jet_eval_drop_value(&machine, source, span)
            return None
        }
        staged := stages
        &staged.push(callback)
        return Val(JetEvalRuntimeValue.Stream{values: items, index: index, step: step, stages: staged})
    }
    if source == .Data(data) {
        if data == .List(items) {
            callback :: jet_eval_copy_value(values[1], &machine, span) ?? return None
            return Val(JetEvalRuntimeValue.Stream{values: items, index: 0, step: 1, stages: [JetEvalRuntimeValue]{callback}})
        }
    }
    jet_eval_drop_value(&machine, source, span)
    jet_eval_compiler_fail(&machine, span, "MIR indexed receiver is not an Iter")
    None
}

fn jet_eval_stream_owns_row(row: MIRPreludeCall, args: [JetEvalRuntimeValue]) -> Bool Never! {
    if row.family != MIRPreludeFamily.BuiltinMethod || row.module_name != "core.builtin" -> return false
    if row.member == "iter_enumerate" || row.member == "list_lazy" -> return true
    if (row.member == "iter_to_list" || row.member == "iter_collect") && args.len() == 1 {
        if args[0] == .Stream(_, _, _, _) -> return true
    }
    false
}

// The lazy-stream builtin rows; `args` is borrowed.
fn jet_eval_stream_route(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    if row.member == "iter_enumerate" -> return jet_eval_stream_enumerate(&machine, args, span)
    if row.member == "list_lazy" {
        if args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR lazy route requires one List receiver")
            return None
        }
        source :: jet_eval_iterator_host_value(args[0], &machine, span) ?? return None
        if source == .Data(data) {
            if data == .List(items) -> return Val(JetEvalRuntimeValue.Stream{values: items, index: 0, step: 1, stages: [JetEvalRuntimeValue]{}})
        }
        jet_eval_drop_value(&machine, source, span)
        jet_eval_compiler_fail(&machine, span, "MIR lazy route receiver is not a List")
        return None
    }
    jet_eval_stream_collect(&machine, args[0], span)
}

// `iter_to_list`/`iter_collect` over a `Stream`: pull every remaining row.
// `stream` is borrowed.
fn jet_eval_stream_collect(machine: &JetEvalMachine, stream: JetEvalRuntimeValue, span: Span) -> JetEvalRuntimeValue? {
    if stream == .Stream(values, index, step, stages) {
        rows := [TComptimeValue]{}
        position := index
        loop position >= 0 && position < values.len() {
            row :: jet_eval_stream_row(&machine, values[position], position, stages, span) ?? return None
            data := jet_eval_data(row, &machine, span)
            jet_eval_drop_value(&machine, row, span)
            &rows.push(data ?? return None)
            position += step
        }
        return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: rows}})
    }
    jet_eval_compiler_fail(&machine, span, "MIR iterator collect receiver is not a Stream")
    None
}

// A checked `Range` carrier read as its bounds.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::mir_range_parts
pub struct JetEvalRangeParts {
    pub start: Int
    pub end: Int
    pub exclusive: Bool
}

fn jet_eval_range_parts(machine: &JetEvalMachine, range: TComptimeValue, span: Span) -> JetEvalRangeParts? {
    if range == .Struct(type_name, _) {
        if type_name != "Range" {
            jet_eval_compiler_fail(&machine, span, "MIR range operand has the wrong type")
            return None
        }
        start_data :: jet_eval_find_field(range, "start") ?? {
            jet_eval_compiler_fail(&machine, span, "MIR range has no `start` field")
            return None
        }
        end_data :: jet_eval_find_field(range, "end") ?? {
            jet_eval_compiler_fail(&machine, span, "MIR range has no `end` field")
            return None
        }
        exclusive_data :: jet_eval_find_field(range, "exclusive") ?? {
            jet_eval_compiler_fail(&machine, span, "MIR range has no `exclusive` field")
            return None
        }
        start :: jet_eval_int(JetEvalRuntimeValue.Data{value: start_data}, &machine, span) ?? return None
        end :: jet_eval_int(JetEvalRuntimeValue.Data{value: end_data}, &machine, span) ?? return None
        if exclusive_data == .Bool(exclusive) -> return Val(JetEvalRangeParts{start: start, end: end, exclusive: exclusive})
        jet_eval_compiler_fail(&machine, span, "MIR range exclusive flag is not Bool")
        return None
    }
    jet_eval_compiler_fail(&machine, span, "MIR range operand is not a Range")
    None
}

// The owner bounds `[start, end_exclusive]` of a range over `len` items.
// Rust: crates/jet-codegen/src/Prelude/Core/RangeBounds.rs::jet_range_bounds
fn jet_eval_range_bounds(parts: JetEvalRangeParts, len: Int) -> [Int]? {
    if parts.start < 0 || parts.end < 0 || parts.start > parts.end -> return None
    end_exclusive :: if parts.exclusive -> parts.end else -> parts.end + 1
    if end_exclusive > len -> return None
    Val([Int]{parts.start, end_exclusive})
}

// D-RANGE-VALUE1=A: owned range slices share the Prelude bounds kernel
// (`jet_slice_vec_range` / `jet_slice_range`); every other slice route runs
// through canonical Prelude dispatch.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs eval_prelude range slices
fn jet_eval_slice_range(machine: &JetEvalMachine, call: MIRPreludeCallID, base: TComptimeValue, range: TComptimeValue, path: String, line: Int, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    symbol :: mir_symbol_name(row.symbol)
    range_route := row.family == MIRPreludeFamily.StaticPrelude && row.module_name == "core.collections"
        && ((row.member == "slice_list_range" && symbol == "jet_slice_vec_range") || (row.member == "slice_string_range" && symbol == "jet_slice_range"))
    if !range_route {
        args := [JetEvalRuntimeValue]{
            JetEvalRuntimeValue.Data{value: base},
            JetEvalRuntimeValue.Data{value: range},
            JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: path}},
            JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: line}},
        }
        return jet_eval_route_prelude_dispatch(&machine, call, args, [MIRType]{}, result_ty, span)
    }
    parts :: jet_eval_range_parts(&machine, range, span) ?? return None
    mode :: if parts.exclusive -> "exclusive" else -> "inclusive"
    if base == {
        .String(text) -> {
            characters := [String]{}
            loop character in text.chars() -> &characters.push("{character}")
            bounds :: jet_eval_range_bounds(parts, characters.len()) ?? {
                jet_eval_source_fail(&machine, span, "can't slice {characters.len()} characters from {parts.start} to {parts.end} ({mode})")
                return None
            }
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: characters.slice(bounds[0], bounds[1]).join("")}})
        }
        .List(items) -> {
            bounds :: jet_eval_range_bounds(parts, items.len()) ?? {
                jet_eval_source_fail(&machine, span, "can't slice {items.len()} items from {parts.start} to {parts.end} ({mode})")
                return None
            }
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: items.slice(bounds[0], bounds[1])}})
        }
        .Bytes(bytes) -> {
            bounds :: jet_eval_range_bounds(parts, bytes.len()) ?? {
                jet_eval_source_fail(&machine, span, "can't slice {bytes.len()} items from {parts.start} to {parts.end} ({mode})")
                return None
            }
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bytes{value: bytes.slice(bounds[0], bounds[1])}})
        }
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "MIR range slice base is not a String or List")
    None
}

// A function value's checked type fixes its call-site carrier: a call through
// a fallible `fn(..) -> T` reads a Result. When the value resolves to an
// infallible function, its plain return is that Result's `Ok`.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::indirect_call_wraps_ok
fn jet_eval_indirect_call_wraps_ok(machine: &JetEvalMachine, function: MIRFunctionID, result_ty: MIRType?, span: Span) -> Bool? {
    target :: jet_eval_find_function(machine, function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR call target is unavailable")
        return None
    }
    infallible := if target.failure == {
        .Infallible -> true
        else -> false
    }
    if !infallible || result_ty == None -> return Val(false)
    checked :: result_ty ?? return Val(false)
    if checked.kind == {
        .Result(_, _) -> return Val(true)
        else -> {}
    }
    Val(false)
}

// An enum value names its owner by the display name of the row that built it
// or, for a value prepared in another module, by that row's canonical key.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::enum_owner_matches
fn jet_eval_enum_owner_matches(machine: JetEvalMachine, type_name: String, owner: String) -> Bool Never! {
    if type_name == owner -> return true
    loop index in 0..<machine.program.types.len() {
        if machine.program.types[index].key == type_name && machine.program.types[index].name == owner -> return true
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::variant_name_matches
fn jet_eval_variant_name_matches(actual: String, expected: String) -> Bool Never! {
    if actual == expected -> return true
    actual_parts :: actual.split("::").to_list()
    expected_parts :: expected.split("::").to_list()
    actual_parts[actual_parts.len() - 1] == expected_parts[expected_parts.len() - 1]
}

// A text or binary pattern match yields a typed capture tuple: a tuple type
// whose fields are named by position.
fn jet_eval_capture_tuple_canonical(type_name: String, fields: [TComptimeField]) -> Bool Never! {
    if !type_name.starts_with("(") -> return false
    loop index in 0..<fields.len() {
        if fields[index].name != "{index}" -> return false
    }
    true
}

// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::marshal_pattern_capture
fn jet_eval_marshal_pattern_capture(machine: &JetEvalMachine, value: TComptimeValue, ty: MIRType, span: Span) -> TComptimeValue? {
    if ty.kind == {
        .String -> {
            if value == .String(_) -> return Val(value)
            jet_eval_compiler_fail(&machine, span, "MIR text pattern capture is not String")
        }
        .Char -> {
            if value == .Char(_) -> return Val(value)
            if value == .String(text) {
                characters := [Char]{}
                loop character in text.chars() -> &characters.push(character)
                if characters.len() == 1 -> return Val(jet_eval_char_value(characters[0]))
                jet_eval_compiler_fail(&machine, span, "MIR text pattern capture is not one Char")
                return None
            }
            jet_eval_compiler_fail(&machine, span, "MIR text pattern capture is not Char")
        }
        .Int | .IntN(_, _) | .InlineRange(_, _, _) -> {
            if value == .Int(_) -> return Val(value)
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture is not an integer")
        }
        .Float | .Measure(_) -> {
            if value == .Float(number, _) -> return Val(TComptimeValue.Float{value: number, bits: 64})
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture is not Float")
        }
        .Float32 -> {
            if value == .Float(number, _) -> return Val(TComptimeValue.Float{value: jet_eval_round_f32(number), bits: 32})
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture is not Float32")
        }
        .Bool -> {
            if value == .Bool(_) -> return Val(value)
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture is not Bool")
        }
        .List(inner) -> {
            byte_list := if inner.kind == {
                .IntN(signed, bits) -> !signed && bits == 8
                else -> false
            }
            if !byte_list {
                jet_eval_compiler_fail(&machine, span, "MIR pattern capture result type is not sema-admitted")
                return None
            }
            if value == .Bytes(_) -> return Val(value)
            jet_eval_compiler_fail(&machine, span, "MIR binary rest capture is not [U8]")
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture result type is not sema-admitted")
        }
    }
    None
}

fn jet_eval_initialize_range(machine: &JetEvalMachine, frame_index: Int, start_id: MIRValueID, end_id: MIRValueID, step_id: MIRValueID?, exclusive: Bool, span: Span) -> JetEvalRuntimeValue? {
    start :: jet_eval_int(jet_eval_value(&machine, frame_index, start_id, span) ?? return None, &machine, span) ?? return None
    end :: jet_eval_int(jet_eval_value(&machine, frame_index, end_id, span) ?? return None, &machine, span) ?? return None
    step := 1
    if step_id != None -> step = jet_eval_int(jet_eval_value(&machine, frame_index, step_id, span) ?? return None, &machine, span) ?? return None
    if step == 0 {
        jet_eval_compiler_fail(&machine, span, "MIR range step cannot be zero")
        return None
    }
    Val(JetEvalRuntimeValue.RangeCursor{start: start, end: end, current: start, step: step, exclusive: exclusive})
}

fn jet_eval_iterator_key_value(key: TComptimeKey) -> TComptimeValue Never! {
    if key == {
        .Int(value) -> return TComptimeValue.Int{value: value}
        .String(value) -> return TComptimeValue.String{value: value}
        .Bool(value) -> return TComptimeValue.Bool{value: value}
        .Char(value) -> return TComptimeValue.Char{value: value}
        .Tuple(fields) -> {
            output := [TComptimeField]{}
            loop field in fields -> &output.push(TComptimeField{name: field.name, value: jet_eval_iterator_key_value(field.key)})
            return TComptimeValue.Struct{type_name: "Tuple", fields: output}
        }
        .Struct(type_name, fields) -> {
            output := [TComptimeField]{}
            loop field in fields -> &output.push(TComptimeField{name: field.name, value: jet_eval_iterator_key_value(field.key)})
            return TComptimeValue.Struct{type_name: type_name, fields: output}
        }
        .Enum(type_name, variant) -> return TComptimeValue.Enum{type_name: type_name, variant: variant, args: [TComptimeEnumArg]{}}
    }
}

fn jet_eval_loop_source_wire(source_kind: MIRLoopSourceKind) -> String Never! {
    if source_kind == MIRLoopSourceKind.Plain -> return "plain"
    if source_kind == MIRLoopSourceKind.Chars -> return "chars"
    if source_kind == MIRLoopSourceKind.LinesFile -> return "lines:file"
    if source_kind == MIRLoopSourceKind.LinesStdin -> return "lines:stdin"
    if source_kind == MIRLoopSourceKind.LinesProcessStream -> return "lines:process"
    if source_kind == MIRLoopSourceKind.ChannelReceiver -> return "channel"
    if source_kind == .EncodingReader(reader_type) -> return "encoding:{reader_type.len()}:{reader_type}"
    if source_kind == .Iterable(coll_type, iter_type, iter_symbol, next_symbol) -> return "iterable:{coll_type.len()}:{coll_type}:{iter_type.len()}:{iter_type}:{iter_symbol.len()}:{iter_symbol}:{next_symbol.len()}:{next_symbol}"
    ""
}

fn jet_eval_loop_prelude_row(machine: &JetEvalMachine, member: String, span: Span) -> MIRPreludeCall? {
    expected_symbol :: "jet_{member}"
    loop index in 0..<machine.program.prelude_calls.len() {
        if machine.program.prelude_calls[index].module_name == "core.prelude" && machine.program.prelude_calls[index].member == member {
            if machine.program.prelude_calls[index].symbol == {
                .Prelude(symbol) -> {
                    if symbol == expected_symbol -> return Val(machine.program.prelude_calls[index])
                }
                else -> {}
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR iterator Prelude row `{member}` is unavailable")
    None
}

// Produce an OWNED host-facing value for an iterator source: addresses are
// read through, everything else is copied.
fn jet_eval_iterator_host_value(value: JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    if value == .Address(frame, place, access) {
        if access == MIRAccess.Move {
            jet_eval_ownership_fail(&machine, span, "MIR iterator source uses a move-only address")
            return None
        }
        return jet_eval_read_place(&machine, frame, place, span)
    }
    if value == .SharedCell(cell, access) {
        if access == MIRAccess.Move {
            jet_eval_ownership_fail(&machine, span, "MIR iterator source uses a move-only shared capture cell")
            return None
        }
    }
    jet_eval_copy_value(value, &machine, span)
}

fn jet_eval_initialize_iterator(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, collection: MIRValueID, step_id: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind, span: Span) -> JetEvalRuntimeValue? {
    source_runtime :: jet_eval_value(&machine, frame_index, collection, span) ?? return None
    result := jet_eval_initialize_iterator_from(&machine, frame_index, call, source_runtime, step_id, by_value, source_kind, span)
    owned := machine.frames[frame_index].borrowed_values.get(collection.value) != (Val(true))
    jet_eval_discharge_call_boundary(&machine, [JetEvalRuntimeValue]{source_runtime}, [Bool]{owned}, result, span)
}

// `source_runtime` is borrowed; every owned temporary built here (step value,
// host-facing init arguments) is discharged before returning.
fn jet_eval_initialize_iterator_from(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, source_runtime: JetEvalRuntimeValue, step_id: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind, span: Span) -> JetEvalRuntimeValue? {
    step := 1
    step_runtime := JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}
    has_step := false
    if step_id != None {
        step_value_id :: step_id
        step_slot :: machine.frames[frame_index].values.get(step_value_id.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR iterator step value is unavailable")
            return None
        }
        step = jet_eval_int(step_slot, &machine, span) ?? return None
        step_runtime = jet_eval_iterator_host_value(step_slot, &machine, span) ?? return None
        has_step = true
    }
    if step <= 0 {
        jet_eval_compiler_fail(&machine, span, "MIR iterator step must be positive")
        jet_eval_drop_value(&machine, step_runtime, span)
        return None
    }
    if source_kind == MIRLoopSourceKind.Chars {
        jet_eval_drop_value(&machine, step_runtime, span)
        source_data :: jet_eval_data(source_runtime, &machine, span) ?? return None
        if source_data == .String(text) {
            values := [JetEvalRuntimeValue]{}
            loop character in text.chars() -> &values.push(JetEvalRuntimeValue.Data{value: jet_eval_char_value(character)})
            return Val(JetEvalRuntimeValue.ListCursor{values: values, index: 0, step: step})
        }
        jet_eval_compiler_fail(&machine, span, "MIR char iterator requires a String")
        return None
    }
    // A lazy `Iter` walks its own rows by the loop stride.
    if source_runtime == .Stream(_, _, _, _) {
        jet_eval_drop_value(&machine, step_runtime, span)
        cursor :: jet_eval_copy_value(source_runtime, &machine, span) ?? return None
        if cursor == .Stream(values, index, _, stages) -> return Val(JetEvalRuntimeValue.Stream{values: values, index: index, step: step, stages: stages})
        return None
    }
    if source_kind != MIRLoopSourceKind.Plain {
        init_row :: jet_eval_route_prelude_row(&machine, call, span) ?? {
            jet_eval_drop_value(&machine, step_runtime, span)
            return None
        }
        if init_row.module_name != "core.prelude" || init_row.member != "loop_iter_init" || mir_symbol_name(init_row.symbol) != "jet_loop_iter_init" || init_row.signature.arity != 5 || init_row.signature.max_arity != 5 {
            jet_eval_compiler_fail(&machine, span, "MIR iterator init has a non-canonical Prelude row")
            jet_eval_drop_value(&machine, step_runtime, span)
            return None
        }
        host_source :: jet_eval_iterator_host_value(source_runtime, &machine, span) ?? {
            jet_eval_drop_value(&machine, step_runtime, span)
            return None
        }
        init_args := [JetEvalRuntimeValue]{
            host_source,
            step_runtime,
            JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: has_step}},
            JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: by_value}},
            JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: jet_eval_loop_source_wire(source_kind)}},
        }
        exchanged := jet_eval_host_row_with_moves(&machine, init_row, init_args, None, [Bool]{by_value, false, false, false, false}, span)
        cursor :: jet_eval_discharge_boundary(&machine, init_args, exchanged, span) ?? return None
        if cursor == {
            .ForeignHandle(handle, raw, token) -> {
                if !jet_eval_cursor_handle_matches(&machine, handle, raw, token, span) {
                    jet_eval_drop_value(&machine, cursor, span)
                    return None
                }
            }
            else -> {
                jet_eval_compiler_fail(&machine, span, "MIR iterator initializer did not return the canonical native cursor handle")
                jet_eval_drop_value(&machine, cursor, span)
                return None
            }
        }
        has_next_row :: jet_eval_loop_prelude_row(&machine, "loop_iter_has_next", span) ?? {
            jet_eval_drop_value(&machine, cursor, span)
            return None
        }
        value_row :: jet_eval_loop_prelude_row(&machine, "loop_iter_value", span) ?? {
            jet_eval_drop_value(&machine, cursor, span)
            return None
        }
        advance_row :: jet_eval_loop_prelude_row(&machine, "loop_iter_advance", span) ?? {
            jet_eval_drop_value(&machine, cursor, span)
            return None
        }
        return Val(JetEvalRuntimeValue.HostCursor{value: cursor, has_next: has_next_row.id, value_call: value_row.id, advance: advance_row.id})
    }
    // A `Range` value (a parameter or binding, not a literal `a..b` loop
    // header) walks the same cursor `LoopRangeInit` builds.
    if source_runtime == .Data(range_data) {
        if range_data == .Struct(range_type, _) {
            if range_type == "Range" {
                jet_eval_drop_value(&machine, step_runtime, span)
                parts :: jet_eval_range_parts(&machine, range_data, span) ?? return None
                return Val(JetEvalRuntimeValue.RangeCursor{start: parts.start, end: parts.end, current: parts.start, step: step, exclusive: parts.exclusive})
            }
        }
    }
    jet_eval_drop_value(&machine, step_runtime, span)
    source_data :: jet_eval_data(source_runtime, &machine, span) ?? return None
    if source_data == .List(items) {
        values := [JetEvalRuntimeValue]{}
        loop item in items -> &values.push(JetEvalRuntimeValue.Data{value: item})
        return Val(JetEvalRuntimeValue.ListCursor{values: values, index: 0, step: step})
    }
    if source_data == .Bytes(items) {
        values := [JetEvalRuntimeValue]{}
        loop item in items -> &values.push(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: Int.from_u8(item)}})
        return Val(JetEvalRuntimeValue.ListCursor{values: values, index: 0, step: step})
    }
    if source_data == .Map(entries) {
        values := [JetEvalRuntimeValue]{}
        loop entry in entries {
            pair := TComptimeValue.Struct{type_name: "Tuple", fields: [TComptimeField]{
                TComptimeField{name: "key", value: jet_eval_iterator_key_value(entry.key)},
                TComptimeField{name: "value", value: entry.value},
            }}
            &values.push(JetEvalRuntimeValue.Data{value: pair})
        }
        return Val(JetEvalRuntimeValue.ListCursor{values: values, index: 0, step: step})
    }
    jet_eval_unsupported(&machine, span, "iterating this MIR collection")
    None
}

fn jet_eval_uninitialized_value(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, span: Span) -> JetEvalRuntimeValue? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? return None
    place :: jet_eval_function_place(machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR uninitialized write targets an unavailable place")
        return None
    }
    if place.projections.len() != 0 {
        jet_eval_compiler_fail(&machine, span, "MIR uninitialized initialization must target a local root")
        return None
    }
    if place.base == {
        .Local(local_id) -> {
            local := MIRLocal?{None}
            loop index in 0..<machine.program.functions[function].locals.len() {
                if machine.program.functions[function].locals[index].id == local_id -> local = Val(machine.program.functions[function].locals[index])
            }
            row :: local ?? {
                jet_eval_compiler_fail(&machine, span, "MIR uninitialized root has no local facts")
                return None
            }
            if !row.uninit {
                jet_eval_compiler_fail(&machine, span, "MIR uninitialized root disagrees with its checked local fact")
                return None
            }
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR uninitialized initialization does not target a local")
            return None
        }
    }
    if place.ty.kind == {
        .FixedList(_, length) -> {
            count :: mir_measure_literal_value(length) ?? {
                jet_eval_compiler_fail(&machine, span, "uninitialized fixed-list length is not a checked static measure")
                return None
            }
            if count < 0 {
                jet_eval_compiler_fail(&machine, span, "uninitialized fixed-list length is negative")
                return None
            }
            if count > machine.config.max_collection_len {
                jet_eval_fuel_fail(&machine, span)
                return None
            }
            values := [JetEvalRuntimeValue]{}
            index := 0
            loop index < count {
                &values.push(JetEvalRuntimeValue.Moved)
                index += 1
            }
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: values}})
        }
        else -> return Val(JetEvalRuntimeValue.Moved)
    }
}
fn jet_eval_instruction(machine: &JetEvalMachine, frame_index: Int, instruction: MIRInstruction) -> JetEvalStep? {
    span := instruction.span
    value := jet_eval_operation(&machine, frame_index, instruction.operation, instruction.ty, span) ?? return None
    if instruction.result != None {
        result :: instruction.result ?? return None
        if !jet_eval_store(&machine, frame_index, Val(result), value, instruction.operation, span) -> return None
    }
    Val(JetEvalStep.Continue)
}

fn jet_eval_closure_captures(machine: &JetEvalMachine, frame_index: Int, function_id: MIRFunctionID, operands: [MIRCaptureOperand], span: Span) -> [JetEvalRuntimeValue]? {
    target :: jet_eval_function_row(machine, function_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR closure target is unavailable")
        return None
    }
    source :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR closure source is unavailable")
        return None
    }
    if operands.len() != machine.program.functions[target].capture_params.len() {
        jet_eval_compiler_fail(&machine, span, "MIR closure capture count disagrees with its target")
        return None
    }
    output := [JetEvalRuntimeValue]{}
    index := 0
    loop index < operands.len() {
        parameter :: ~machine.program.functions[target].capture_params[index]
        operand := operands[index]
        if operand == {
            .Value(value) -> {
                if {
                    parameter.access == MIRAccess.Move -> {
                        &output.push(jet_eval_take(&machine, frame_index, value, span) ?? {
                            jet_eval_drop_values(&machine, output, span)
                            return None
                        })
                    }
                    else -> {
                        if parameter.ownership.mode != MIROwnershipMode.Owned {
                            jet_eval_ownership_fail(&machine, span, "MIR read/write closure value capture requires owned ownership")
                            jet_eval_drop_values(&machine, output, span)
                            return None
                        }
                        captured :: jet_eval_take(&machine, frame_index, value, span) ?? {
                            jet_eval_drop_values(&machine, output, span)
                            return None
                        }
                        if captured == {.SharedCell(cell, source_access) -> {
                            if parameter.access == MIRAccess.Write && source_access != MIRAccess.Write {
                                jet_eval_ownership_fail(&machine, span, "MIR write closure capture aliases a read-only shared cell")
                                jet_eval_drop_value(&machine, captured, span)
                                jet_eval_drop_values(&machine, output, span)
                                return None
                            }
                            // The taken alias is re-labelled with the capture access; it is
                            // still the same single owned alias.
                            &output.push(JetEvalRuntimeValue.SharedCell{index: cell, access: parameter.access})
                        } else -> {
                            if jet_eval_runtime_contains_address(captured) {
                                jet_eval_ownership_fail(&machine, span, "MIR shared capture cannot retain a stack address")
                                jet_eval_drop_value(&machine, captured, span)
                                jet_eval_drop_values(&machine, output, span)
                                return None
                            }
                            &output.push(jet_eval_new_shared_cell(machine, captured, parameter.access))
                        }
                    }
                }
            }
        }
            .Place(place) -> {
                if parameter.access == MIRAccess.Move {
                    jet_eval_ownership_fail(&machine, span, "MIR closure place capture cannot use move access")
                    jet_eval_drop_values(&machine, output, span)
                    return None
                }
                if jet_eval_function_place(machine, source, place) == None {
                    jet_eval_compiler_fail(&machine, span, "MIR closure capture place is unavailable")
                    jet_eval_drop_values(&machine, output, span)
                    return None
                }
                &output.push(JetEvalRuntimeValue.Address{frame: frame_index, place: place, access: parameter.access})
            }
        }
        index += 1
    }
    Val(output)
}

fn jet_eval_host_shape_key(ty: MIRType) -> String? {
    if ty.identity != None -> return Val(mir_type_identity_key(ty))
    if ty.kind == .Apply(name, args) {
        if args.len() == 0 -> return Val("nominal:{name.id.value}")
        pieces := [String]{}
        loop arg in args -> &pieces.push(mir_type_display_name(arg))
        return Val("nominal:{name.id.value}<{pieces.join(",")}>")
    }
    None
}

fn jet_eval_host_shape_node_from_program(program: MIRProgram, rows: JetEvalProgramRows, ty: MIRType, nodes: &[JetEvalHostTypeNode], seen: &[String:Int]) -> Int? {
    if ty.kind == {
        .Apply(name, args) -> {
            key := jet_eval_host_shape_key(ty)
            if key != None {
                cached :: seen.get(key ?? "")
                if cached != None -> return cached
            }
            if jet_eval_core_owner_check(program, rows, ty) == {
                .Valid(owner) -> {
                    index := nodes.len()
                    &nodes.push(JetEvalHostTypeNode.Handle{ty: ty, owner: JetEvalHostOwner.Core{owner: JetEvalHostCoreOwner{fact: owner, ty: ty}}})
                    if key != None -> seen[key ?? ""] = index
                    return Val(index)
                }
                .Invalid(_) -> return None
                .Missing -> {}
            }
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Scalar{ty: ty})
            if key != None -> seen[key ?? ""] = index
            arg_nodes := [Int]{}
            loop arg in args {
                &arg_nodes.push(jet_eval_host_shape_node_from_program(program, rows, arg, &nodes, &seen) ?? return None)
            }
            definition :: rows.types.get(name.id.value) ?? return Val(index)
            owner :: program.types[definition]
            if owner.kind == {
                .Struct(fields, _) -> {
                    output := [JetEvalHostTypeFieldShape]{}
                    loop field in fields {
                        field_ty := field.ty
                        if args.len() > 0 -> field_ty = jet_eval_host_substitute_type(field_ty, owner.generic_params, args)
                        field_node :: jet_eval_host_shape_node_from_program(program, rows, field_ty, &nodes, &seen) ?? return None
                        &output.push(JetEvalHostTypeFieldShape{name: field.name, node: field_node})
                    }
                    nodes[index] = JetEvalHostTypeNode.Struct{type_id: name.id, type_name: name.name, args: arg_nodes, fields: output}
                }
                .Enum(variants, _) -> {
                    output := [JetEvalHostTypeVariantShape]{}
                    loop variant in variants {
                        variant_args := [JetEvalHostTypeArgShape]{}
                        if variant.payload == .Single(inner) {
                            single_ty := inner
                            if args.len() > 0 -> single_ty = jet_eval_host_substitute_type(single_ty, owner.generic_params, args)
                            single_node :: jet_eval_host_shape_node_from_program(program, rows, single_ty, &nodes, &seen) ?? return None
                            &variant_args.push(JetEvalHostTypeArgShape{name: None, node: single_node})
                        }
                        if variant.payload == .Named(fields) {
                            loop field in fields {
                                field_ty := field.ty
                                if args.len() > 0 -> field_ty = jet_eval_host_substitute_type(field_ty, owner.generic_params, args)
                                field_node :: jet_eval_host_shape_node_from_program(program, rows, field_ty, &nodes, &seen) ?? return None
                                &variant_args.push(JetEvalHostTypeArgShape{name: Val(field.name), node: field_node})
                            }
                        }
                        &output.push(JetEvalHostTypeVariantShape{name: variant.name, args: variant_args})
                    }
                    nodes[index] = JetEvalHostTypeNode.Enum{type_id: name.id, type_name: name.name, args: arg_nodes, variants: output}
                }
                else -> {}
            }
            return Val(index)
        }
        .Option(inner) -> {
            child :: jet_eval_host_shape_node_from_program(program, rows, inner, &nodes, &seen) ?? return None
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Option{inner: child})
            return Val(index)
        }
        .Result(ok, error) -> {
            ok_node :: jet_eval_host_shape_node_from_program(program, rows, ok, &nodes, &seen) ?? return None
            error_node :: jet_eval_host_shape_node_from_program(program, rows, error, &nodes, &seen) ?? return None
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Result{ok: ok_node, error: error_node})
            return Val(index)
        }
        .List(inner) | .FixedList(inner, _) -> {
            child :: jet_eval_host_shape_node_from_program(program, rows, inner, &nodes, &seen) ?? return None
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.List{inner: child})
            return Val(index)
        }
        .Map(key, value) -> {
            key_node :: jet_eval_host_shape_node_from_program(program, rows, key, &nodes, &seen) ?? return None
            value_node :: jet_eval_host_shape_node_from_program(program, rows, value, &nodes, &seen) ?? return None
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Map{key: key_node, value: value_node})
            return Val(index)
        }
        .Tuple(fields) -> {
            output := [JetEvalHostTypeFieldShape]{}
            loop field in fields {
                field_node :: jet_eval_host_shape_node_from_program(program, rows, field.ty, &nodes, &seen) ?? return None
                &output.push(JetEvalHostTypeFieldShape{name: field.name, node: field_node})
            }
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Tuple{fields: output})
            return Val(index)
        }
        else -> {
            index := nodes.len()
            &nodes.push(JetEvalHostTypeNode.Scalar{ty: ty})
            return Val(index)
        }
    }
}

fn jet_eval_host_shape_node(machine: &JetEvalMachine, ty: MIRType, nodes: &[JetEvalHostTypeNode], seen: &[String:Int], span: Span) -> Int? {
    node := jet_eval_host_shape_node_from_program(machine.program, machine.rows, ty, &nodes, &seen)
    if node == None -> jet_eval_compiler_fail(&machine, span, "checked MIR type cannot be represented by the canonical Source host shape")
    node
}

// The native host entry has no machine, so it indexes the program per query.
pub fn jet_eval_host_type_shape_from_program(program: &MIRProgram, checked_type: MIRType, span: Span) -> JetEvalHostTypeShape? {
    rows :: jet_eval_program_rows(program)
    jet_eval_host_type_shape_from_rows(program, rows, checked_type)
}

fn jet_eval_host_type_shape_from_rows(program: MIRProgram, rows: JetEvalProgramRows, checked_type: MIRType) -> JetEvalHostTypeShape? {
    nodes := [JetEvalHostTypeNode]{}
    seen := [String:Int]{}
    root :: jet_eval_host_shape_node_from_program(program, rows, checked_type, &nodes, &seen) ?? return None
    Val(JetEvalHostTypeShape{root: root, nodes: nodes})
}

fn jet_eval_host_type_shape(machine: &JetEvalMachine, ty: MIRType?, span: Span) -> JetEvalHostTypeShape? {
    expected :: ty ?? return None
    jet_eval_host_type_shape_from_rows(machine.program, machine.rows, expected) ?? {
        jet_eval_compiler_fail(&machine, span, "checked MIR type cannot be represented by the canonical Source host shape")
        return None
    }
}
fn jet_eval_host_data_matches_type(machine: &JetEvalMachine, data: TComptimeValue, ty: MIRType?, span: Span) -> Bool Never! {
    expected :: ty ?? return true
    if expected.kind == {
        .Tagged(_, inner) | .Quantity(inner, _) -> return jet_eval_host_data_matches_type(&machine, data, Val(inner), span)
        .InlineRange(base, _, _) -> return jet_eval_host_data_matches_type(&machine, data, Val(base), span)
        .Int | .IntN(_, _) -> {
            if data == {
                .Int(_) | .BigInt(_) -> return true
                else -> {}
            }
        }
        .Float | .Float32 -> if data == .Float(_, _) -> return true
        .Bool -> if data == .Bool(_) -> return true
        .Char -> if data == .Char(_) -> return true
        .String -> if data == .String(_) -> return true
        .List(_) | .FixedList(_, _) -> if data == .List(_) -> return jet_eval_host_data_matches_type(&machine, data, None, span)
        .Map(_, _) -> if data == .Map(_) -> return true
        .Shared(inner) -> return jet_eval_host_data_matches_type(&machine, data, Val(inner), span)
        .Option(inner) -> {
            if data == .Present(value) -> return jet_eval_host_data_matches_type(&machine, value, Val(inner), span)
        }
        .Result(ok, error) -> {
            if data == .Present(value) -> return jet_eval_host_data_matches_type(&machine, value, Val(ok), span)
            if data == .Failed(report) {
                if report == .Told(value) -> return jet_eval_host_data_matches_type(&machine, value, Val(error), span)
                return true
            }
        }
        .Tuple(fields) -> {
            if data == .Struct(_, _) {
                loop field in fields {
                    value :: jet_eval_find_field(data, field.name) ?? return false
                    if !jet_eval_host_data_matches_type(&machine, value, Val(field.ty), span) -> return false
                }
                return true
            }
        }
        .Apply(name, args) -> {
            if name.name == "Unit" && data == TComptimeValue.Unit -> return true
            if name.name == "String" {
                if data == .String(_) -> return true
            }
            if name.name == "Bytes" {
                if data == .Bytes(_) -> return true
            }
            definition :: machine.rows.types.get(name.id.value) ?? return true
            owner :: ~machine.program.types[definition]
            if owner.kind == {
                .Struct(fields, _) -> {
                    if data == {
                        .Struct(_, _) -> {}
                        else -> return false
                    }
                    loop field in fields {
                        value :: jet_eval_find_field(data, field.name) ?? return false
                        field_ty := field.ty
                        if args.len() > 0 -> field_ty = jet_eval_host_substitute_type(field_ty, owner.generic_params, args)
                        if !jet_eval_host_data_matches_type(&machine, value, Val(field_ty), span) -> return false
                    }
                    return true
                }
                .Enum(variants, _) -> {
                    data_variant := ""
                    data_args := [TComptimeEnumArg]{}
                    if data == {.Enum(_, variant, values) -> {
                        data_variant = variant
                        data_args = values
                    } else -> return false
                    }
                    loop variant in variants {
                        if variant.name != data_variant -> next
                        if variant.payload == .Unit -> return data_args.len() == 0
                        if variant.payload == .Single(inner) {
                            if data_args.len() != 1 -> return false
                            field_ty := inner
                            if args.len() > 0 -> field_ty = jet_eval_host_substitute_type(field_ty, owner.generic_params, args)
                            return jet_eval_host_data_matches_type(&machine, data_args[0].value, Val(field_ty), span)
                        }
                        if variant.payload == .Named(fields) {
                            loop field in fields {
                                value := TComptimeValue?{None}
                                loop arg in data_args {
                                    if arg.name == (Val(field.name)) -> value = Val(arg.value)
                                }
                                child :: value ?? return false
                                field_ty := field.ty
                                if args.len() > 0 -> field_ty = jet_eval_host_substitute_type(field_ty, owner.generic_params, args)
                                if !jet_eval_host_data_matches_type(&machine, child, Val(field_ty), span) -> return false
                            }
                            return true
                        }
                    }
                }
                else -> return true
            }
        }
        else -> return true
    }
    jet_eval_compiler_fail(&machine, span, "native host scalar/aggregate value disagrees with its checked type shape")
    false
}

fn jet_eval_host_shared_carrier_preflight(machine: &JetEvalMachine, carrier: JetEvalSharedHostCarrier, result_ty: MIRType?, span: Span) -> Bool Never! {
    valid := if {
        machine.entry_access == (Val(MIRAccess.Read)) -> {
            jet_eval_shared_runtime_host_entry_loan_preflight(carrier, result_ty)
        }
        else -> {
            jet_eval_shared_runtime_host_adopt_preflight(carrier, result_ty)
        }
    }
    if !valid {
        jet_eval_compiler_fail(&machine, span, "native Shared carrier disagrees with its checked type or parameter access")
        return false
    }
    true
}

fn jet_eval_host_value_preflight(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, value: JetEvalHostValue, allow_cursor: Bool, span: Span) -> Bool Never! {
    if value == {
        .Data(data) -> return jet_eval_host_data_matches_type(&machine, data, result_ty, span)
        .Handle(handle, raw, owner, payload) -> {
            if {
                owner == JetEvalHostOwner.Cursor -> {
                    if !allow_cursor || handle != jet_eval_loop_cursor_handle_id() {
                        jet_eval_compiler_fail(&machine, span, "native cursor owner is not allowed in this checked entry parameter")
                        return false
                    }
                    checked_row :: row ?? {
                        jet_eval_compiler_fail(&machine, span, "native cursor owner has no checked iterator Prelude row")
                        return false
                    }
                    if !jet_eval_host_handle_is_loop(checked_row) {
                        jet_eval_compiler_fail(&machine, span, "native cursor owner has a non-canonical iterator Prelude row")
                        return false
                    }
                }
                else -> {
                    if !jet_eval_host_handle_validate(&machine, row, result_ty, owner, handle, raw, span) {
                        return false
                    }
                }
            }
            return jet_eval_host_value_preflight(&machine, None, None, payload, false, span)
        }
        .Absent(_) -> return true
        .Present(inner) -> {
            child_ty := MIRType?{None}
            if result_ty != None -> child_ty = Val(jet_eval_host_option_child_type(&machine, result_ty, true, span) ?? return false)
            return jet_eval_host_value_preflight(&machine, row, child_ty, inner, false, span)
        }
        .Failed(inner) -> {
            child_ty := MIRType?{None}
            if result_ty != None -> child_ty = Val(jet_eval_host_option_child_type(&machine, result_ty, false, span) ?? return false)
            return jet_eval_host_value_preflight(&machine, row, child_ty, inner, false, span)
        }
        .List(values) -> {
            child_ty := MIRType?{None}
            if result_ty != None -> child_ty = Val(jet_eval_host_sequence_element_type(&machine, result_ty, span) ?? return false)
            if result_ty != None {
                expected :: result_ty
                if expected.kind == {
                    .FixedList(_, length) -> if mir_measure_literal_value(length) != (Val(values.len())) {
                        jet_eval_compiler_fail(&machine, span, "native host fixed-list entry length disagrees with its checked parameter type")
                        return false
                    }
                    else -> {}
                }
            }
            loop item in values {
                if !jet_eval_host_value_preflight(&machine, row, child_ty, item, false, span) -> return false
            }
            return true
        }
        .Map(entries) -> {
            key_ty := MIRType?{None}
            value_ty := MIRType?{None}
            if result_ty != None {
                types :: jet_eval_host_map_types(&machine, result_ty, span) ?? return false
                key_ty = Val(types[0])
                value_ty = Val(types[1])
            }
            loop entry in entries {
                if !jet_eval_host_value_preflight(&machine, row, key_ty, entry.key, false, span)
                    || !jet_eval_host_value_preflight(&machine, row, value_ty, entry.value, false, span) -> return false
            }
            return true
        }
        .Struct(_, fields) -> {
            loop field in fields {
                field_ty := MIRType?{None}
                if result_ty != None -> field_ty = Val(jet_eval_host_struct_field_type(&machine, result_ty, field.name, span) ?? return false)
                if !jet_eval_host_value_preflight(&machine, row, field_ty, field.value, false, span) -> return false
            }
            return true
        }
        .Enum(_, variant, args) -> {
            loop index in 0..<args.len() {
                arg_ty := MIRType?{None}
                if result_ty != None -> arg_ty = Val(jet_eval_host_enum_arg_type(&machine, result_ty, variant, args[index].name, index, span) ?? return false)
                if !jet_eval_host_value_preflight(&machine, row, arg_ty, args[index].value, false, span) -> return false
            }
            return true
        }
        .Closure(function, captures) -> {
            function_row :: jet_eval_find_function(machine, function) ?? {
                jet_eval_compiler_fail(&machine, span, "native host closure has no checked function facts")
                return false
            }
            if captures.len() != function_row.capture_params.len() {
                jet_eval_compiler_fail(&machine, span, "native host closure capture count disagrees with checked function facts")
                return false
            }
            loop index in 0..<captures.len() {
                capture_ty := Val(function_row.capture_params[index].ty)
                if !jet_eval_host_value_preflight(&machine, row, capture_ty, captures[index], false, span) -> return false
            }
            return true
        }
        .SourceCallback(_) -> {
            jet_eval_ownership_fail(&machine, span, "native Source callback lease cannot be adopted as a host value")
            return false
        }
        .FixedBacking(_) -> {
            jet_eval_ownership_fail(&machine, span, "native Fixed backing request cannot be adopted as a host value")
            return false
        }
        .SharedCarrier(carrier) -> return jet_eval_host_shared_carrier_preflight(&machine, carrier, result_ty, span)
    }
    true
}

pub fn jet_eval_host_value_adopt(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, value: JetEvalHostValue, allow_cursor: Bool, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_value_adopt_mode(&machine, row, result_ty, value, allow_cursor, false, span)
}
fn jet_eval_host_value_adopt_cleanup(machine: &JetEvalMachine, value: JetEvalHostValue, span: Span) -> JetEvalRuntimeValue? {
    staged := [JetEvalRuntimeValue]{}
    stage_ok := jet_eval_owned_host_value_collect(&machine, value, &staged, span)
    adopted := jet_eval_host_value_adopt_mode(&machine, None, None, value, false, true, span)
    staged_ok := true
    loop alias in staged {
        if !jet_eval_drop_value(&machine, alias, span) -> staged_ok = false
    }
    if adopted == {
        Val(runtime) -> {
            if stage_ok && staged_ok -> return Val(runtime)
            jet_eval_drop_value(&machine, runtime, span)
            return None
        }
        None -> return None
    }
    None
}
// A host payload with no logical content is exactly `Data(Unit)`. The payload
// may hold host values that do not support `==`, so this matches its shape.
fn jet_eval_host_value_is_unit(value: JetEvalHostValue) -> Bool Never! {
    if value == .Data(data) {
        if data == .Unit -> return true
    }
    false
}

fn jet_eval_host_value_adopt_mode(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, value: JetEvalHostValue, allow_cursor: Bool, cleanup: Bool, span: Span) -> JetEvalRuntimeValue? {
    if value == {
        .Data(data) -> return Val(JetEvalRuntimeValue.Data{value: data})
        .Handle(handle, raw, owner, payload) -> {
            if cleanup {
                if owner == JetEvalHostOwner.Cursor {
                    if handle != jet_eval_loop_cursor_handle_id() {
                        jet_eval_compiler_fail(&machine, span, "transport cleanup cursor has a non-canonical handle identity")
                        jet_eval_owned_host_value_discard(&machine, payload, span)
                        return None
                    }
                    existing := jet_eval_resource_handle_alias(machine, handle, raw, JetEvalForeignTokenKind.Cursor)
                    if existing != None {
                        token :: existing ?? return None
                        alias := JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token}
                        if !jet_eval_host_value_is_unit(payload) {
                            jet_eval_drop_value(&machine, alias, span)
                            jet_eval_owned_host_value_discard(&machine, payload, span)
                            jet_eval_ownership_fail(&machine, span, "native cursor alias carries a distinct logical payload")
                            return None
                        }
                        return Val(alias)
                    }
                    payload_value := jet_eval_host_value_adopt_mode(&machine, None, None, payload, false, true, span)
                    if payload_value == {
                        Val(nested) -> return Val(jet_eval_cursor_handle_new(machine, handle, raw, nested))
                        None -> {
                            cursor := jet_eval_cursor_handle_new(machine, handle, raw, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
                            jet_eval_drop_value(&machine, cursor, span)
                            return None
                        }
                    }
                }
                if !jet_eval_host_handle_validate(&machine, row, result_ty, owner, handle, raw, span) {
                    jet_eval_owned_host_value_discard(&machine, payload, span)
                    return None
                }
                adopted := jet_eval_host_handle_new_mode(&machine, row, result_ty, owner, handle, raw, payload, true, span)
                if adopted == {
                    Val(runtime) -> return Val(runtime)
                    None -> {}
                }
                closer := jet_eval_host_handle_new_mode(&machine, row, result_ty, owner, handle, raw, JetEvalHostValue.Data{value: TComptimeValue.Unit}, true, span)
                if closer == {
                    Val(runtime) -> jet_eval_drop_value(&machine, runtime, span)
                    None -> {}
                }
                return None
            }
            if owner == JetEvalHostOwner.Cursor {
                if !allow_cursor {
                    jet_eval_compiler_fail(&machine, span, "native cursor owner appeared inside a non-cursor host aggregate")
                    return None
                }
                checked_row :: row ?? {
                    jet_eval_compiler_fail(&machine, span, "native cursor owner has no checked iterator Prelude row")
                    return None
                }
                return jet_eval_host_handle_result(&machine, checked_row, result_ty, handle, raw, owner, payload, span)
            }
            if machine.entry_access == (Val(MIRAccess.Read)) {
                return jet_eval_host_handle_borrowed(&machine, row, result_ty, owner, handle, raw, payload, span)
            }
            return jet_eval_host_handle_new(&machine, row, result_ty, owner, handle, raw, payload, span)
        }
        .Absent(element) -> return Val(JetEvalRuntimeValue.Absent{element: element})
        .Present(inner) -> {
            child_ty := MIRType?{None}
            if result_ty != None -> child_ty = Val(jet_eval_host_option_child_type(&machine, result_ty, true, span) ?? return None)
            nested :: jet_eval_host_value_adopt_mode(&machine, row, child_ty, inner, false, cleanup, span) ?? return None
            if result_ty != None {
                checked_ty :: result_ty
                if checked_ty.kind == .Result(_, _) -> return Val(JetEvalRuntimeValue.Result{ok: true, value: nested})
            }
            if nested == .Data(data) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: data}})
            return Val(JetEvalRuntimeValue.Result{ok: true, value: nested})
        }
        .Failed(inner) -> {
            child_ty := MIRType?{None}
            if result_ty != None -> child_ty = Val(jet_eval_host_option_child_type(&machine, result_ty, false, span) ?? return None)
            nested :: jet_eval_host_value_adopt_mode(&machine, row, child_ty, inner, false, cleanup, span) ?? return None
            if result_ty != None {
                checked_ty :: result_ty
                if checked_ty.kind == .Result(_, _) -> return Val(JetEvalRuntimeValue.Result{ok: false, value: nested})
            }
            if nested == .Data(data) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Failed{report: TComptimeReport.Told{value: data}}})
            return Val(JetEvalRuntimeValue.Result{ok: false, value: nested})
        }
        .List(values) -> {
            child_ty := MIRType?{None}
            if result_ty != None {
                element_ty := jet_eval_host_sequence_element_type(&machine, result_ty, span)
                if element_ty == {
                    None -> {
                        if cleanup -> loop item in values -> jet_eval_owned_host_value_discard(&machine, item, span)
                        return None
                    }
                    Val(ty) -> child_ty = Val(ty)
                }
            }
            output := [JetEvalRuntimeValue]{}
            data_output := [TComptimeValue]{}
            all_data := true
            index := 0
            loop index < values.len() {
                nested := jet_eval_host_value_adopt_mode(&machine, row, child_ty, values[index], false, cleanup, span)
                if nested == {
                    None -> {
                        jet_eval_drop_adopted_prefix(&machine, output, span)
                        if cleanup {
                            index += 1
                            loop index < values.len() {
                                jet_eval_owned_host_value_discard(&machine, values[index], span)
                                index += 1
                            }
                        }
                        return None
                    }
                    else -> {}
                }
                nested_value :: nested ?? JetEvalRuntimeValue.Moved
                &output.push(nested_value)
                if nested_value == {
                    .Data(data) -> &data_output.push(data)
                    else -> all_data = false
                }
                index += 1
            }
            if all_data -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: data_output}})
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: output}})
        }
        .Map(entries) -> {
            map_types := jet_eval_host_map_types(&machine, result_ty, span)
            key_ty := MIRType?{None}
            value_ty := MIRType?{None}
            if map_types != None {
                types :: map_types ?? return None
                key_ty = Val(types[0])
                value_ty = Val(types[1])
            }
            output := [JetEvalRuntimeMapEntry]{}
            adopted := [JetEvalRuntimeValue]{}
            data_output := [TComptimeMapEntry]{}
            all_data := true
            index := 0
            loop index < entries.len() {
                entry :: entries[index]
                key_result := jet_eval_host_value_adopt_mode(&machine, row, key_ty, entry.key, false, cleanup, span)
                if key_result == None {
                    jet_eval_drop_adopted_prefix(&machine, adopted, span)
                    if cleanup {
                        jet_eval_owned_host_value_discard(&machine, entry.value, span)
                        index += 1
                        loop index < entries.len() {
                            jet_eval_owned_host_value_discard(&machine, entries[index].key, span)
                            jet_eval_owned_host_value_discard(&machine, entries[index].value, span)
                            index += 1
                        }
                    }
                    return None
                }
                key_runtime :: key_result ?? JetEvalRuntimeValue.Moved
                &adopted.push(key_runtime)
                value_result := jet_eval_host_value_adopt_mode(&machine, row, value_ty, entry.value, false, cleanup, span)
                if value_result == None {
                    jet_eval_drop_adopted_prefix(&machine, adopted, span)
                    if cleanup {
                        index += 1
                        loop index < entries.len() {
                            jet_eval_owned_host_value_discard(&machine, entries[index].key, span)
                            jet_eval_owned_host_value_discard(&machine, entries[index].value, span)
                            index += 1
                        }
                    }
                    return None
                }
                value_runtime :: value_result ?? JetEvalRuntimeValue.Moved
                &adopted.push(value_runtime)
                &output.push(JetEvalRuntimeMapEntry{key: key_runtime, value: value_runtime})
                if key_runtime == {
                    .Data(key_data) -> {
                        key :: jet_eval_data_key(key_data, &machine, span) ?? {
                            jet_eval_drop_adopted_prefix(&machine, adopted, span)
                            if cleanup {
                                index += 1
                                loop index < entries.len() {
                                    jet_eval_owned_host_value_discard(&machine, entries[index].key, span)
                                    jet_eval_owned_host_value_discard(&machine, entries[index].value, span)
                                    index += 1
                                }
                            }
                            return None
                        }
                        if value_runtime == {
                            .Data(value_data) -> &data_output.push(TComptimeMapEntry{key: key, value: value_data})
                            else -> all_data = false
                        }
                    }
                    else -> all_data = false
                }
                index += 1
            }
            if all_data -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Map{entries: data_output}})
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Map{entries: output}})
        }
        .Struct(type_name, fields) -> {
            output := [JetEvalRuntimeField]{}
            adopted := [JetEvalRuntimeValue]{}
            data_output := [TComptimeField]{}
            all_data := true
            index := 0
            loop index < fields.len() {
                field :: fields[index]
                field_ty := MIRType?{None}
                if result_ty != None {
                    field_type := jet_eval_host_struct_field_type(&machine, result_ty, field.name, span)
                    if field_type == {
                        None -> {
                            jet_eval_drop_adopted_prefix(&machine, adopted, span)
                            if cleanup {
                                loop index < fields.len() {
                                    jet_eval_owned_host_value_discard(&machine, fields[index].value, span)
                                    index += 1
                                }
                            }
                            return None
                        }
                        Val(ty) -> field_ty = Val(ty)
                    }
                }
                nested_result := jet_eval_host_value_adopt_mode(&machine, row, field_ty, field.value, false, cleanup, span)
                if nested_result == None {
                    jet_eval_drop_adopted_prefix(&machine, adopted, span)
                    if cleanup {
                        index += 1
                        loop index < fields.len() {
                            jet_eval_owned_host_value_discard(&machine, fields[index].value, span)
                            index += 1
                        }
                    }
                    return None
                }
                nested :: nested_result ?? JetEvalRuntimeValue.Moved
                &adopted.push(nested)
                &output.push(JetEvalRuntimeField{name: field.name, value: nested})
                if nested == {
                    .Data(data) -> &data_output.push(TComptimeField{name: field.name, value: data})
                    else -> all_data = false
                }
                index += 1
            }
            if all_data -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Struct{type_name: type_name, fields: data_output}})
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: type_name, fields: output}})
        }
        .Enum(type_name, variant, args) -> {
            output := [JetEvalRuntimeEnumArg]{}
            adopted := [JetEvalRuntimeValue]{}
            data_output := [TComptimeEnumArg]{}
            all_data := true
            index := 0
            loop index < args.len() {
                arg :: args[index]
                arg_ty := MIRType?{None}
                if result_ty != None {
                    arg_type := jet_eval_host_enum_arg_type(&machine, result_ty, variant, arg.name, index, span)
                    if arg_type == {
                        None -> {
                            jet_eval_drop_adopted_prefix(&machine, adopted, span)
                            if cleanup {
                                loop index < args.len() {
                                    jet_eval_owned_host_value_discard(&machine, args[index].value, span)
                                    index += 1
                                }
                            }
                            return None
                        }
                        Val(ty) -> arg_ty = Val(ty)
                    }
                }
                nested_result := jet_eval_host_value_adopt_mode(&machine, row, arg_ty, arg.value, false, cleanup, span)
                if nested_result == None {
                    jet_eval_drop_adopted_prefix(&machine, adopted, span)
                    if cleanup {
                        index += 1
                        loop index < args.len() {
                            jet_eval_owned_host_value_discard(&machine, args[index].value, span)
                            index += 1
                        }
                    }
                    return None
                }
                nested :: nested_result ?? JetEvalRuntimeValue.Moved
                &adopted.push(nested)
                &output.push(JetEvalRuntimeEnumArg{name: arg.name, value: nested})
                if nested == {
                    .Data(data) -> &data_output.push(TComptimeEnumArg{name: arg.name, value: data})
                    else -> all_data = false
                }
                index += 1
            }
            if all_data -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Enum{type_name: type_name, variant: variant, args: data_output}})
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Enum{type_name: type_name, variant: variant, args: output}})
        }
        .Closure(function, captures) -> {
            function_row := jet_eval_find_function(machine, function)
            if function_row == None {
                jet_eval_compiler_fail(&machine, span, "native host closure has no checked function facts")
                if cleanup -> loop capture in captures -> jet_eval_owned_host_value_discard(&machine, capture, span)
                return None
            }
            checked_function :: function_row ?? return None
            if captures.len() != checked_function.capture_params.len() {
                jet_eval_compiler_fail(&machine, span, "native host closure capture count disagrees with checked function facts")
                if cleanup -> loop capture in captures -> jet_eval_owned_host_value_discard(&machine, capture, span)
                return None
            }
            output := [JetEvalRuntimeValue]{}
            index := 0
            loop index < captures.len() {
                capture_ty := MIRType?{None}
                if !cleanup -> capture_ty = Val(checked_function.capture_params[index].ty)
                nested_result := jet_eval_host_value_adopt_mode(&machine, row, capture_ty, captures[index], false, cleanup, span)
                if nested_result == None {
                    jet_eval_drop_adopted_prefix(&machine, output, span)
                    if cleanup {
                        index += 1
                        loop index < captures.len() {
                            jet_eval_owned_host_value_discard(&machine, captures[index], span)
                            index += 1
                        }
                    }
                    return None
                }
                nested :: nested_result ?? JetEvalRuntimeValue.Moved
                &output.push(nested)
                index += 1
            }
            return Val(JetEvalRuntimeValue.Closure{function: function, captures: output})
        }
        .SourceCallback(_) -> {
            jet_eval_ownership_fail(&machine, span, "native host returned a Source callback lease instead of adopting it through the callback receipt")
            return None
        }
        .FixedBacking(_) -> {
            jet_eval_ownership_fail(&machine, span, "native host returned a Fixed backing request instead of acknowledging an allocator receipt")
            return None
        }
        .SharedCarrier(carrier) -> {
            if machine.entry_access == (Val(MIRAccess.Read)) {
                loan :: jet_eval_shared_runtime_host_entry_loan(&machine, carrier, result_ty, span) ?? return None
                &machine.entry_shared_loans.push(loan)
                if loan.kind == JetEvalSharedHostKind.Guard {
                    selector :: if carrier.physical == {
                        .Guard(guard) -> guard.metadata.guard_read().value.physical_borrow_selector
                        else -> None
                    } ?? {
                        jet_eval_compiler_fail(&machine, span, "checked Read SharedGuard entry lost its physical-borrow selector")
                        return None
                    }
                    if !jet_eval_shared_runtime_host_entry_loan_set_physical_borrow_selector(&machine, loan, selector) {
                        jet_eval_compiler_fail(&machine, span, "checked Read SharedGuard entry could not bind its receiver-local physical view")
                        return None
                    }
                }
                return Val(jet_eval_shared_runtime_host_entry_loan_value(loan))
            }
            if cleanup && carrier.owner_alias_token != None {
                if carrier.physical == .Shared(entry) {
                    // jet_eval_host_value_adopt_cleanup already staged this
                    // carrier, which adopted its host owner token; adopting it
                    // again would register one token twice. Retain a fresh
                    // owner alias instead; dropping the staged alias then
                    // releases the host token exactly once.
                    return jet_eval_shared_runtime_host_import_shared(&machine, entry, None, false, span)
                }
            }
            return jet_eval_shared_runtime_host_adopt(&machine, carrier, result_ty, span)
        }
    }
}

fn jet_eval_host_transfer_projection(machine: &JetEvalMachine, value: JetEvalRuntimeValue, projection: JetEvalHostProjection, span: Span) -> JetEvalRuntimeValue? {
    if projection == {
        .Present -> {
            if value == {
                .Result(ok, nested) -> {
                    if ok -> return Val(nested)
                    jet_eval_compiler_fail(&machine, span, "host transfer path selects Present from a failed result")
                    return None
                }
                else -> {}
            }
        }
        .Failed -> {
            if value == {
                .Result(ok, nested) -> {
                    if !ok -> return Val(nested)
                    jet_eval_compiler_fail(&machine, span, "host transfer path selects Failed from a successful result")
                    return None
                }
                else -> {}
            }
        }
        .List(index) -> {
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .List(values) -> {
                            if index >= 0 && index < values.len() -> return Val(values[index])
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .MapKey(index) -> {
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .Map(entries) -> {
                            if index >= 0 && index < entries.len() -> return Val(entries[index].key)
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .MapValue(index) -> {
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .Map(entries) -> {
                            if index >= 0 && index < entries.len() -> return Val(entries[index].value)
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .StructField(name) -> {
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .Struct(_, fields) -> {
                            loop field in fields {
                                if field.name == name -> return Val(field.value)
                            }
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .EnumArg(index) -> {
            if value == {
                .Aggregate(aggregate) -> {
                    if aggregate == {
                        .Enum(_, _, args) -> {
                            if index >= 0 && index < args.len() -> return Val(args[index].value)
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .HandlePayload -> {
            if value == {
                .ForeignHandle(_, _, token) -> {
                    payload :: jet_eval_foreign_token_read_payload(machine, token) ?? return None
                    return Val(payload)
                }
                else -> {}
            }
        }
        .Capture(index) -> {
            if value == {
                .Closure(_, captures) -> {
                    if index >= 0 && index < captures.len() -> return Val(captures[index])
                }
                else -> {}
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "host transfer path does not select a value in the prepared input")
    None
}

fn jet_eval_host_transfer_value(machine: &JetEvalMachine, value: JetEvalRuntimeValue, path: [JetEvalHostProjection], span: Span) -> JetEvalRuntimeValue? {
    current := value
    loop projection in path {
        current = jet_eval_host_transfer_projection(&machine, current, projection, span) ?? return None
    }
    Val(current)
}
fn jet_eval_result_host_transfer_owner_matches(owner: JetEvalHostOwner, kind: JetEvalForeignTokenKind) -> Bool Never! {
    if kind == {
        .Cursor -> {
            if owner == {
                .Cursor -> return true
                else -> return false
            }
        }
        .Declared(checked) -> {
            if owner == .Declared(actual) -> return mir_type_same_checked_type(checked, actual)
            return false
        }
        .Core(checked) -> {
            if owner == .Core(actual) -> return checked.fact == actual.fact && mir_type_same_checked_type(checked.ty, actual.ty)
            return false
        }
        .Native(checked) -> {
            if owner == .Native(actual) -> return checked == actual
            return false
        }
        .FixedBackingRoot(_, _) -> return false
        .Foreign -> return false
    }
    false
}

fn jet_eval_result_host_shared_transfer_collect(machine: &JetEvalMachine, source_root: JetEvalRuntimeValue, carrier: JetEvalSharedHostCarrier, path: &[JetEvalHostProjection], shared_transfers: &[JetEvalResultHostSharedTransfer], span: Span) -> Bool {
    if carrier.kind != JetEvalSharedHostKind.Shared -> return true
    source :: jet_eval_host_transfer_value(&machine, source_root, path, span) ?? return false
    index :: if source == {.Shared(value) -> Val(value) else -> None} ?? {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer does not select a Source Shared root")
        return false
    }
    if carrier.index != (Val(index)) || !carrier.registry.storage.same(machine.registry.shared_runtime.storage) {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer does not belong to this result's live Shared root")
        return false
    }
    if !carrier.owns_root_capability || carrier.owner_alias_token_pre_adopted {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer carrier does not own an untransferred root capability")
        return false
    }
    entry :: jet_eval_shared_runtime_value(machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer names an unavailable Source root")
        return false
    }
    if carrier.physical == {
        .Shared(carrier_entry) -> {
            if !carrier_entry.storage.same(entry.storage) || !carrier_entry.metadata.same(entry.metadata) {
                jet_eval_ownership_fail(&machine, span, "Shared host transfer physical root differs from its Source owner")
                return false
            }
        }
        else -> {
            jet_eval_ownership_fail(&machine, span, "Shared host transfer has a mismatched physical root kind")
            return false
        }
    }
    metadata := entry.metadata
    state := metadata.guard_read().value
    if carrier.origin != state.origin {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer capability has a mismatched origin")
        return false
    }
    capability :: state.physical_root ?? {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer has no generation-bearing physical capability")
        return false
    }
    if carrier.physical == .Shared(carrier_entry) {
        carrier_capability :: carrier_entry.metadata.guard_read().value.physical_root ?? {
            jet_eval_ownership_fail(&machine, span, "Shared host transfer carrier lost its physical capability")
            return false
        }
        if !jet_eval_shared_runtime_same_root_capability(Val(capability), Val(carrier_capability)) {
            jet_eval_ownership_fail(&machine, span, "Shared host transfer carrier capability changed")
            return false
        }
    }
    token :: carrier.owner_alias_token ?? {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer has no reserved owner-alias token")
        return false
    }
    token_count := 0
    loop active_token in state.owner_alias_tokens {
        if active_token == token -> token_count += 1
    }
    if token_count != 1 {
        jet_eval_ownership_fail(&machine, span, "Shared host transfer token is not uniquely owned by its Source root")
        return false
    }
    loop prior in shared_transfers {
        if prior.index == index && prior.owner_alias_token == token {
            jet_eval_ownership_fail(&machine, span, "Shared host transfer repeats a one-use owner-alias token")
            return false
        }
    }
    if !jet_eval_shared_runtime_owner_alias_transfer_stage(&machine, index, token, capability, span) -> return false
    &shared_transfers.push(JetEvalResultHostSharedTransfer{
        path: path,
        index: index,
        owner_alias_token: token,
        handle: capability.handle,
        raw: capability.raw,
        type_identity: capability.type_identity,
        generation: capability.generation,
        physical_identity: capability.physical_identity,
        staged: true,
        transferred: false,
    })
    true
}

fn jet_eval_result_host_transfer_collect(machine: &JetEvalMachine, source_root: JetEvalRuntimeValue, host_value: JetEvalHostValue, path: &[JetEvalHostProjection], transfers: &[JetEvalHostTransfer], shared_transfers: &[JetEvalResultHostSharedTransfer], span: Span) -> Bool {
    if host_value == {
        .Handle(handle, raw, owner, payload) -> {
            source :: jet_eval_host_transfer_value(&machine, source_root, path, span) ?? return false
            token := Int?{None}
            if source == {
                .ForeignHandle(source_handle, source_raw, source_token) -> {
                    if source_handle != handle || source_raw != raw {
                        jet_eval_ownership_fail(&machine, span, "host handle projection disagrees with its Source-owned result")
                        return false
                    }
                    token = Val(source_token)
                }
                else -> {
                    jet_eval_ownership_fail(&machine, span, "host handle projection does not select a Source-owned handle")
                    return false
                }
            }
            source_token :: token ?? return false
            kind :: jet_eval_foreign_token_kind(machine, source_token) ?? return false
            if !jet_eval_result_host_transfer_owner_matches(owner, kind) {
                jet_eval_ownership_fail(&machine, span, "host transfer owner disagrees with its Source token")
                return false
            }
            if owner != JetEvalHostOwner.Cursor && !jet_eval_host_handle_validate(&machine, None, None, owner, handle, raw, span) -> return false
            &path.push(JetEvalHostProjection.HandlePayload)
            payload_ok := jet_eval_result_host_transfer_collect(&machine, source_root, payload, &path, &transfers, &shared_transfers, span)
            _ := &path.pop()
            if !payload_ok -> return false
            &transfers.push(JetEvalHostTransfer{argument: 0, path: path, token: source_token, handle: handle, raw: raw})
            return true
        }
        .Present(inner) -> {
            &path.push(JetEvalHostProjection.Present)
            ok := jet_eval_result_host_transfer_collect(&machine, source_root, inner, &path, &transfers, &shared_transfers, span)
            _ := &path.pop()
            return ok
        }
        .Failed(inner) -> {
            &path.push(JetEvalHostProjection.Failed)
            ok := jet_eval_result_host_transfer_collect(&machine, source_root, inner, &path, &transfers, &shared_transfers, span)
            _ := &path.pop()
            return ok
        }
        .List(values) -> {
            index := 0
            loop index < values.len() {
                &path.push(JetEvalHostProjection.List{index: index})
                ok := jet_eval_result_host_transfer_collect(&machine, source_root, values[index], &path, &transfers, &shared_transfers, span)
                _ := &path.pop()
                if !ok -> return false
                index += 1
            }
            return true
        }
        .Map(entries) -> {
            index := 0
            loop index < entries.len() {
                &path.push(JetEvalHostProjection.MapKey{index: index})
                key_ok := jet_eval_result_host_transfer_collect(&machine, source_root, entries[index].key, &path, &transfers, &shared_transfers, span)
                _ := &path.pop()
                if !key_ok -> return false
                &path.push(JetEvalHostProjection.MapValue{index: index})
                value_ok := jet_eval_result_host_transfer_collect(&machine, source_root, entries[index].value, &path, &transfers, &shared_transfers, span)
                _ := &path.pop()
                if !value_ok -> return false
                index += 1
            }
            return true
        }
        .Struct(_, fields) -> {
            loop index in 0..<fields.len() {
                &path.push(JetEvalHostProjection.StructField{name: fields[index].name})
                ok := jet_eval_result_host_transfer_collect(&machine, source_root, fields[index].value, &path, &transfers, &shared_transfers, span)
                _ := &path.pop()
                if !ok -> return false
            }
            return true
        }
        .Enum(_, _, args) -> {
            loop index in 0..<args.len() {
                &path.push(JetEvalHostProjection.EnumArg{index: index})
                ok := jet_eval_result_host_transfer_collect(&machine, source_root, args[index].value, &path, &transfers, &shared_transfers, span)
                _ := &path.pop()
                if !ok -> return false
            }
            return true
        }
        .Closure(_, _) -> return true
        .SharedCarrier(carrier) -> return jet_eval_result_host_shared_transfer_collect(&machine, source_root, carrier, &path, &shared_transfers, span)
        .SourceCallback(_) -> {
            jet_eval_ownership_fail(&machine, span, "Source callback lease cannot be returned as a host result value")
            return false
        }
        .FixedBacking(_) -> {
            jet_eval_ownership_fail(&machine, span, "Fixed backing request cannot be returned as a host result value")
            return false
        }
        .Data(_) | .Absent(_) -> return true
    }
    true
}

fn jet_eval_result_host_closure_transfer_collect(machine: &JetEvalMachine, source_root: JetEvalRuntimeValue, host_value: JetEvalHostValue, path: &[JetEvalHostProjection], closure_transfers: &[JetEvalResultHostClosureTransfer], span: Span) -> Bool {
    if host_value == {
        .Closure(function, captures) -> {
            source :: jet_eval_host_transfer_value(&machine, source_root, path, span) ?? return false
            if source == {
                .Closure(source_function, source_captures) -> {
                    if source_function != function || source_captures.len() != captures.len() {
                        jet_eval_ownership_fail(&machine, span, "prepared Source closure transfer no longer matches its physical projection")
                        return false
                    }
                }
                else -> {
                    jet_eval_ownership_fail(&machine, span, "prepared Source closure transfer path no longer selects a closure")
                    return false
                }
            }
            if !jet_eval_callback_validate_root(&machine, source, false, span) -> return false
            &closure_transfers.push(JetEvalResultHostClosureTransfer{path: path, function: function, capture_count: captures.len(), transferred: false})
            return true
        }
        .Present(inner) -> {
            &path.push(JetEvalHostProjection.Present)
            ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, inner, &path, &closure_transfers, span)
            _ := &path.pop()
            return ok
        }
        .Failed(inner) -> {
            &path.push(JetEvalHostProjection.Failed)
            ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, inner, &path, &closure_transfers, span)
            _ := &path.pop()
            return ok
        }
        .List(values) -> {
            loop index in 0..<values.len() {
                &path.push(JetEvalHostProjection.List{index: index})
                ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, values[index], &path, &closure_transfers, span)
                _ := &path.pop()
                if !ok -> return false
            }
            return true
        }
        .Map(entries) -> {
            loop index in 0..<entries.len() {
                &path.push(JetEvalHostProjection.MapKey{index: index})
                key_ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, entries[index].key, &path, &closure_transfers, span)
                _ := &path.pop()
                if !key_ok -> return false
                &path.push(JetEvalHostProjection.MapValue{index: index})
                value_ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, entries[index].value, &path, &closure_transfers, span)
                _ := &path.pop()
                if !value_ok -> return false
            }
            return true
        }
        .Struct(_, fields) -> {
            loop field in fields {
                &path.push(JetEvalHostProjection.StructField{name: field.name})
                ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, field.value, &path, &closure_transfers, span)
                _ := &path.pop()
                if !ok -> return false
            }
            return true
        }
        .Enum(_, _, args) -> {
            loop index in 0..<args.len() {
                &path.push(JetEvalHostProjection.EnumArg{index: index})
                ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, args[index].value, &path, &closure_transfers, span)
                _ := &path.pop()
                if !ok -> return false
            }
            return true
        }
        .Handle(_, _, _, payload) -> {
            &path.push(JetEvalHostProjection.HandlePayload)
            ok := jet_eval_result_host_closure_transfer_collect(&machine, source_root, payload, &path, &closure_transfers, span)
            _ := &path.pop()
            return ok
        }
        .SourceCallback(_) -> {
            jet_eval_ownership_fail(&machine, span, "Source callback lease cannot be returned as a host closure result")
            return false
        }
        .FixedBacking(_) -> {
            jet_eval_ownership_fail(&machine, span, "Fixed backing request cannot be returned as a host closure result")
            return false
        }
        else -> {}
    }
    true
}

fn jet_eval_result_host_closure_transfer_validate(machine: &JetEvalMachine, source_root: JetEvalRuntimeValue, host_value: JetEvalHostValue, transfer: JetEvalResultHostClosureTransfer, span: Span) -> Bool {
    source :: jet_eval_host_transfer_value(&machine, source_root, transfer.path, span) ?? return false
    if source == {
        .Closure(function, captures) -> {
            if function != transfer.function || captures.len() != transfer.capture_count {
                jet_eval_ownership_fail(&machine, span, "prepared Source closure changed before host transfer commit")
                return false
            }
        }
        else -> {
            jet_eval_ownership_fail(&machine, span, "prepared Source closure path no longer selects its checked closure")
            return false
        }
    }
    checked :: jet_eval_result_host_value_transfer_read(&machine, host_value, transfer.path, 0, JetEvalHostTransferRead.Closure{function: transfer.function, capture_count: transfer.capture_count}, span) ?? return false
    jet_eval_callback_validate_root(&machine, source, false, span)
}

fn jet_eval_callback_closure_reusable(machine: JetEvalMachine, closure: JetEvalRuntimeValue) -> Bool Never! {
    if closure == .Closure(function, captures) {
        function_row :: jet_eval_function_row(machine, function) ?? return false
        if captures.len() == 0 -> return true
        facts :: machine.program.functions[function_row].captures ?? return false
        return facts.moved.len() == 0
    }
    false
}

// Walk the borrowed host tree to its leaf before checking it. Returning each
// intermediate subtree would copy every remaining capture and cleanup program.
// Only pre-adoption constructs an independently mutable carrier at the leaf.
enum JetEvalHostTransferRead {
    Closure(function: MIRFunctionID, capture_count: Int)
    Shared(index: Int, owner_alias_token: Int, capability: JetEvalSharedHostRootCapability, pre_adopted: Bool)
}
fn jet_eval_result_host_value_transfer_read(machine: &JetEvalMachine, value: JetEvalHostValue, path: [JetEvalHostProjection], position: Int, read: JetEvalHostTransferRead, span: Span) -> JetEvalHostValue? {
    if position >= path.len() {
        if read == {
            .Closure(expected_function, capture_count) -> {
                if value == .Closure(function, captures) {
                    if function != expected_function || captures.len() != capture_count {
                        jet_eval_ownership_fail(&machine, span, "prepared physical closure changed before Source transfer commit")
                        return None
                    }
                    return Val(JetEvalHostValue.Data{value: TComptimeValue.Unit})
                }
                jet_eval_ownership_fail(&machine, span, "prepared physical closure path no longer selects its checked closure")
                return None
            }
            .Shared(index, token, capability, pre_adopted) -> {
                if pre_adopted -> return jet_eval_result_host_shared_transfer_pre_adopted_leaf(&machine, value, index, token, span)
                if !jet_eval_result_host_shared_transfer_validate_leaf(&machine, value, index, token, capability, span) -> return None
                return Val(JetEvalHostValue.Data{value: TComptimeValue.Unit})
            }
        }
    }
    projection :: path[position]
    if projection == {
        .Present -> if value == .Present(inner) -> return jet_eval_result_host_value_transfer_read(&machine, inner, path, position + 1, read, span)
        .Failed -> if value == .Failed(inner) -> return jet_eval_result_host_value_transfer_read(&machine, inner, path, position + 1, read, span)
        .List(index) -> if value == .List(values) {
            if index >= 0 && index < values.len() -> return jet_eval_result_host_value_transfer_read(&machine, values[index], path, position + 1, read, span)
        }
        .MapKey(index) -> if value == .Map(entries) {
            if index >= 0 && index < entries.len() -> return jet_eval_result_host_value_transfer_read(&machine, entries[index].key, path, position + 1, read, span)
        }
        .MapValue(index) -> if value == .Map(entries) {
            if index >= 0 && index < entries.len() -> return jet_eval_result_host_value_transfer_read(&machine, entries[index].value, path, position + 1, read, span)
        }
        .StructField(name) -> if value == .Struct(_, fields) {
            loop index in 0..<fields.len() {
                field :: fields[index]
                if field.name == name -> return jet_eval_result_host_value_transfer_read(&machine, field.value, path, position + 1, read, span)
            }
        }
        .EnumArg(index) -> if value == .Enum(_, _, args) {
            if index >= 0 && index < args.len() -> return jet_eval_result_host_value_transfer_read(&machine, args[index].value, path, position + 1, read, span)
        }
        .Capture(index) -> if value == .Closure(_, captures) {
            if index >= 0 && index < captures.len() -> return jet_eval_result_host_value_transfer_read(&machine, captures[index], path, position + 1, read, span)
        }
        .HandlePayload -> if value == .Handle(_, _, _, payload) -> return jet_eval_result_host_value_transfer_read(&machine, payload, path, position + 1, read, span)
    }
    jet_eval_ownership_fail(&machine, span, "prepared host transfer path no longer selects a value")
    None
}

fn jet_eval_result_host_value_transfer_replace(machine: &JetEvalMachine, value: JetEvalHostValue, path: [JetEvalHostProjection], position: Int, token: Int, index: Int, replacement: ^JetEvalHostValue, span: Span) -> JetEvalHostValue? {
    if position >= path.len() {
        if value == .SharedCarrier(carrier) {
            if carrier.kind == JetEvalSharedHostKind.Shared && carrier.index == (Val(index)) && carrier.owner_alias_token == (Val(token)) {
                if replacement == .SharedCarrier(committed) {
                    if committed.kind == JetEvalSharedHostKind.Shared && committed.index == (Val(index)) && committed.owner_alias_token == (Val(token)) && committed.owner_alias_token_pre_adopted -> return Val(JetEvalHostValue.SharedCarrier{carrier: ^committed})
                }
            }
        }
        jet_eval_ownership_fail(&machine, span, "prepared host Shared transfer no longer matches its staged owner alias")
        return None
    }
    projection := path[position]
    if value == {
        .Present(inner) -> if projection == {
            .Present -> {
                updated :: jet_eval_result_host_value_transfer_replace(&machine, inner, path, position + 1, token, index, ^replacement, span) ?? return None
                return Val(JetEvalHostValue.Present{value: updated})
            }
            else -> {}
        }
        .Failed(inner) -> if projection == {
            .Failed -> {
                updated :: jet_eval_result_host_value_transfer_replace(&machine, inner, path, position + 1, token, index, ^replacement, span) ?? return None
                return Val(JetEvalHostValue.Failed{value: updated})
            }
            else -> {}
        }
        .List(values) -> if projection == {
            .List(child) -> {
                if child >= 0 && child < values.len() {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, values[child], path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_values := values
                    updated_values[child] = replaced
                    return Val(JetEvalHostValue.List{values: updated_values})
                }
            }
            else -> {}
        }
        .Map(entries) -> if projection == {
            .MapKey(child) -> {
                if child >= 0 && child < entries.len() {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, entries[child].key, path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_entries := entries
                    updated_entries[child].key = replaced
                    return Val(JetEvalHostValue.Map{entries: updated_entries})
                }
            }
            .MapValue(child) -> {
                if child >= 0 && child < entries.len() {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, entries[child].value, path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_entries := entries
                    updated_entries[child].value = replaced
                    return Val(JetEvalHostValue.Map{entries: updated_entries})
                }
            }
            else -> {}
        }
        .Struct(name, fields) -> if projection == {
            .StructField(field_name) -> {
                found := Int?{None}
                loop child in 0..<fields.len() {
                    if fields[child].name == field_name {
                        found = Val(child)
                        break
                    }
                }
                if found == .Val(child) {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, fields[child].value, path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_fields := fields
                    updated_fields[child].value = replaced
                    return Val(JetEvalHostValue.Struct{type_name: name, fields: updated_fields})
                }
            }
            else -> {}
        }
        .Enum(name, variant, args) -> if projection == {
            .EnumArg(child) -> {
                if child >= 0 && child < args.len() {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, args[child].value, path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_args := args
                    updated_args[child].value = replaced
                    return Val(JetEvalHostValue.Enum{type_name: name, variant: variant, args: updated_args})
                }
            }
            else -> {}
        }
        .Closure(function, captures) -> if projection == {
            .Capture(child) -> {
                if child >= 0 && child < captures.len() {
                    replaced :: jet_eval_result_host_value_transfer_replace(&machine, captures[child], path, position + 1, token, index, ^replacement, span) ?? return None
                    updated_captures := captures
                    updated_captures[child] = replaced
                    return Val(JetEvalHostValue.Closure{function: function, captures: updated_captures})
                }
            }
            else -> {}
        }
        .Handle(handle, raw, owner, payload) -> if projection == {
            .HandlePayload -> {
                updated :: jet_eval_result_host_value_transfer_replace(&machine, payload, path, position + 1, token, index, ^replacement, span) ?? return None
                return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: owner, payload: updated})
            }
            else -> {}
        }
        else -> {}
    }
    jet_eval_ownership_fail(&machine, span, "prepared host Shared transfer path changed before commit")
    None
}

fn jet_eval_result_host_runtime_transfer_replace(machine: &JetEvalMachine, value: JetEvalRuntimeValue, path: [JetEvalHostProjection], position: Int, expected: JetEvalRuntimeValue, span: Span) -> JetEvalRuntimeValue? {
    if position >= path.len() {
        if value == expected -> return Val(JetEvalRuntimeValue.Moved)
        jet_eval_ownership_fail(&machine, span, "prepared Source transfer no longer selects its exact value")
        return None
    }
    projection := path[position]
    if value == {
        .Result(ok, inner) -> {
            if projection == {
                .Present -> {
                    if ok {
                        updated :: jet_eval_result_host_runtime_transfer_replace(&machine, inner, path, position + 1, expected, span) ?? return None
                        return Val(JetEvalRuntimeValue.Result{ok: true, value: updated})
                    }
                }
                .Failed -> {
                    if !ok {
                        updated :: jet_eval_result_host_runtime_transfer_replace(&machine, inner, path, position + 1, expected, span) ?? return None
                        return Val(JetEvalRuntimeValue.Result{ok: false, value: updated})
                    }
                }
                else -> {}
            }
        }
        .Aggregate(aggregate) -> {
            if aggregate == {
                .List(values) -> if projection == {
                    .List(child) -> {
                        if child >= 0 && child < values.len() {
                            updated_values := values
                            updated_values[child] = jet_eval_result_host_runtime_transfer_replace(&machine, values[child], path, position + 1, expected, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: updated_values}})
                        }
                    }
                    else -> {}
                }
                .Map(entries) -> if projection == {
                    .MapKey(child) -> {
                        if child >= 0 && child < entries.len() {
                            updated_entries := entries
                            updated_entries[child].key = jet_eval_result_host_runtime_transfer_replace(&machine, entries[child].key, path, position + 1, expected, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Map{entries: updated_entries}})
                        }
                    }
                    .MapValue(child) -> {
                        if child >= 0 && child < entries.len() {
                            updated_entries := entries
                            updated_entries[child].value = jet_eval_result_host_runtime_transfer_replace(&machine, entries[child].value, path, position + 1, expected, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Map{entries: updated_entries}})
                        }
                    }
                    else -> {}
                }
                .Struct(name, fields) -> if projection == {
                    .StructField(field_name) -> {
                        loop child in 0..<fields.len() {
                            if fields[child].name == field_name {
                                updated_fields := fields
                                updated_fields[child].value = jet_eval_result_host_runtime_transfer_replace(&machine, fields[child].value, path, position + 1, expected, span) ?? return None
                                return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: name, fields: updated_fields}})
                            }
                        }
                    }
                    else -> {}
                }
                .Enum(name, variant, args) -> if projection == {
                    .EnumArg(child) -> {
                        if child >= 0 && child < args.len() {
                            updated_args := args
                            updated_args[child].value = jet_eval_result_host_runtime_transfer_replace(&machine, args[child].value, path, position + 1, expected, span) ?? return None
                            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Enum{type_name: name, variant: variant, args: updated_args}})
                        }
                    }
                    else -> {}
                }
            }
        }
        .Closure(function, captures) -> if projection == {
            .Capture(child) -> {
                if child >= 0 && child < captures.len() {
                    updated_captures := captures
                    updated_captures[child] = jet_eval_result_host_runtime_transfer_replace(&machine, captures[child], path, position + 1, expected, span) ?? return None
                    return Val(JetEvalRuntimeValue.Closure{function: function, captures: updated_captures})
                }
            }
            else -> {}
        }
        .ForeignHandle(_, _, token) -> if projection == {
            .HandlePayload -> {
                payload :: jet_eval_foreign_token_read_payload(machine, token) ?? return None
                updated :: jet_eval_result_host_runtime_transfer_replace(&machine, payload, path, position + 1, expected, span) ?? return None
                if !jet_eval_foreign_token_replace_payload(machine, token, updated) {
                    jet_eval_ownership_fail(&machine, span, "prepared Source handle payload disappeared before transfer commit")
                    return None
                }
                return Val(value)
            }
            else -> {}
        }
        else -> {}
    }
    jet_eval_ownership_fail(&machine, span, "prepared Source transfer path changed before commit")
    None
}

fn jet_eval_result_host_shared_transfer_capability(transfer: JetEvalResultHostSharedTransfer) -> JetEvalSharedHostRootCapability Never! {
    JetEvalSharedHostRootCapability{
        handle: transfer.handle,
        raw: transfer.raw,
        generation: transfer.generation,
        type_identity: transfer.type_identity,
        physical_identity: transfer.physical_identity,
    }
}

fn jet_eval_result_host_shared_transfer_validate(machine: &JetEvalMachine, source_root: JetEvalRuntimeValue, host_value: JetEvalHostValue, transfer: JetEvalResultHostSharedTransfer, span: Span) -> Bool {
    source :: jet_eval_host_transfer_value(&machine, source_root, transfer.path, span) ?? return false
    if source != (JetEvalRuntimeValue.Shared{index: transfer.index}) {
        jet_eval_ownership_fail(&machine, span, "prepared Shared transfer no longer selects its Source root")
        return false
    }
    read :: JetEvalHostTransferRead.Shared{index: transfer.index, owner_alias_token: transfer.owner_alias_token, capability: jet_eval_result_host_shared_transfer_capability(transfer), pre_adopted: false}
    checked :: jet_eval_result_host_value_transfer_read(&machine, host_value, transfer.path, 0, read, span) ?? return false
    true
}
fn jet_eval_result_host_shared_transfer_validate_leaf(machine: &JetEvalMachine, host_value: JetEvalHostValue, index: Int, token: Int, capability: JetEvalSharedHostRootCapability, span: Span) -> Bool {
    if host_value == .SharedCarrier(carrier) {
        if carrier.kind != JetEvalSharedHostKind.Shared || carrier.index != (Val(index)) || carrier.owner_alias_token != (Val(token)) || carrier.owner_alias_token_pre_adopted || !carrier.owns_root_capability {
            jet_eval_ownership_fail(&machine, span, "prepared Shared transfer no longer matches its host carrier")
            return false
        }
        if !carrier.registry.storage.same(machine.registry.shared_runtime.storage) {
            jet_eval_ownership_fail(&machine, span, "prepared Shared transfer host carrier belongs to another evaluator registry")
            return false
        }
        entry :: jet_eval_shared_runtime_value(machine, index) ?? return false
        if carrier.physical == {
            .Shared(carrier_entry) -> {
                if !carrier_entry.storage.same(entry.storage) || !carrier_entry.metadata.same(entry.metadata) {
                    jet_eval_ownership_fail(&machine, span, "prepared Shared transfer host carrier changed its physical root")
                    return false
                }
            }
            else -> {
                jet_eval_ownership_fail(&machine, span, "prepared Shared transfer host carrier changed its physical root kind")
                return false
            }
        }
        state := entry.metadata.guard_read().value
        if carrier.origin != state.origin || !jet_eval_shared_runtime_same_root_capability(state.physical_root, Val(capability)) {
            jet_eval_ownership_fail(&machine, span, "prepared Shared transfer capability is stale or has a mismatched origin")
            return false
        }
        active_count := 0
        pending_count := 0
        loop owner_token in state.owner_alias_tokens {
            if token == owner_token -> active_count += 1
        }
        loop owner_token in state.pending_owner_alias_transfers {
            if token == owner_token -> pending_count += 1
        }
        if state.dropped || state.references != state.owner_alias_tokens.len() || active_count != 1 || pending_count != 1 {
            jet_eval_ownership_fail(&machine, span, "prepared Shared transfer no longer owns one staged Source alias")
            return false
        }
        return true
    }
    jet_eval_ownership_fail(&machine, span, "prepared Shared transfer path no longer selects a Shared carrier")
    false
}

fn jet_eval_result_host_shared_transfer_pre_adopted_value(machine: &JetEvalMachine, host_value: JetEvalHostValue, transfer: JetEvalResultHostSharedTransfer, span: Span) -> JetEvalHostValue? {
    read :: JetEvalHostTransferRead.Shared{index: transfer.index, owner_alias_token: transfer.owner_alias_token, capability: jet_eval_result_host_shared_transfer_capability(transfer), pre_adopted: true}
    jet_eval_result_host_value_transfer_read(&machine, host_value, transfer.path, 0, read, span)
}
fn jet_eval_result_host_shared_transfer_pre_adopted_leaf(machine: &JetEvalMachine, host_value: JetEvalHostValue, index: Int, token: Int, span: Span) -> JetEvalHostValue? {
    if host_value == .SharedCarrier(carrier) {
        if carrier.kind == JetEvalSharedHostKind.Shared && carrier.index == (Val(index)) && carrier.owner_alias_token == (Val(token)) && !carrier.owner_alias_token_pre_adopted && carrier.owns_root_capability {
            adopted := carrier
            adopted.owner_alias_token_pre_adopted = true
            return Val(JetEvalHostValue.SharedCarrier{carrier: adopted})
        }
    }
    jet_eval_ownership_fail(&machine, span, "prepared Shared transfer cannot mark its exact host owner alias as pre-adopted")
    None
}

fn jet_eval_result_host_transfer_shared_stage_dispose(machine: &JetEvalMachine, transfers: &[JetEvalResultHostSharedTransfer], span: Span) -> Bool {
    ok := true
    loop index in 0..<transfers.len() {
        transfer := transfers[index]
        if !transfer.staged || transfer.transferred -> next
        capability := jet_eval_result_host_shared_transfer_capability(transfer)
        if {
            jet_eval_shared_runtime_owner_alias_transfer_dispose(&machine, transfer.index, transfer.owner_alias_token, capability, span) -> {
                transfer.staged = false
                transfers[index] = transfer
            }
            else -> {
                ok = false
            }
        }
    }
    ok
}

fn jet_eval_result_host_transfer_paths_equal(left: [JetEvalHostProjection], right: [JetEvalHostProjection]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

pub fn jet_eval_result_host_transfer_handle_info(receipt: &JetEvalResultHostTransferReceipt, path: [JetEvalHostProjection], span: Span) -> JetEvalHostTransfer? {
    if !receipt.committed || !receipt.foreign_committed -> return None
    loop transfer in receipt.transfers {
        if transfer.argument == 0 && jet_eval_result_host_transfer_paths_equal(transfer.path, path) -> return Val(transfer)
    }
    None
}

pub fn jet_eval_result_host_transfer_shared_info(receipt: &JetEvalResultHostTransferReceipt, path: [JetEvalHostProjection], span: Span) -> JetEvalResultHostSharedTransfer? {
    if !receipt.committed -> return None
    loop transfer in receipt.shared_transfers {
        if transfer.transferred && jet_eval_result_host_transfer_paths_equal(transfer.path, path) -> return Val(transfer)
    }
    None
}

pub fn jet_eval_result_host_transfer_callback_take(receipt: &JetEvalResultHostTransferReceipt, path: [JetEvalHostProjection], span: Span) -> JetEvalTaskRoot? {
    if !receipt.committed || receipt.active -> return None
    loop index in 0..<receipt.closure_transfers.len() {
        transfer :: receipt.closure_transfers[index]
        if !jet_eval_result_host_transfer_paths_equal(transfer.path, path) -> next
        if !transfer.transferred -> return None
        return &receipt.closure_roots.remove(index)
    }
    None
}

pub fn jet_eval_result_host_transfer_prepare(result: &JetEvalResult, host_value: &JetEvalHostValue, checked_type: MIRType, span: Span) -> JetEvalResultHostTransferReceipt? {
    if &result.session == {
        None -> return None
        .Val(session) -> {
            if session.retired {
                jet_eval_ownership_fail(&session.machine, span, "cannot prepare a host transfer from a retired Source result")
                return None
            }
            current :: result.value ?? return None
            if current == JetEvalRuntimeValue.Moved {
                jet_eval_ownership_fail(&session.machine, span, "cannot prepare a host transfer from a moved Source result")
                return None
            }
        }
    }
    jet_eval_result_host_type_shape(&result, checked_type, span) ?? return None
    value :: result.value ?? return None
    transfers := [JetEvalHostTransfer]{}
    shared_transfers := [JetEvalResultHostSharedTransfer]{}
    closure_transfers := [JetEvalResultHostClosureTransfer]{}
    path := [JetEvalHostProjection]{}
    machine_identity := 0
    if &result.session == {
        None -> return None
        .Val(session) -> {
            if !jet_eval_result_host_transfer_collect(&session.machine, value, host_value, &path, &transfers, &shared_transfers, span) {
                jet_eval_result_host_transfer_shared_stage_dispose(&session.machine, &shared_transfers, span)
                return None
            }
            if !jet_eval_result_host_closure_transfer_collect(&session.machine, value, host_value, &path, &closure_transfers, span) {
                jet_eval_result_host_transfer_shared_stage_dispose(&session.machine, &shared_transfers, span)
                return None
            }
            if !jet_eval_validate_host_transfers(&session.machine, transfers, [JetEvalRuntimeValue]{value}, [Bool]{true}, span) {
                jet_eval_result_host_transfer_shared_stage_dispose(&session.machine, &shared_transfers, span)
                return None
            }
            machine_identity = session.machine.identity
        }
    }
    Val(JetEvalResultHostTransferReceipt{
        machine_identity: machine_identity,
        transfers: transfers,
        shared_transfers: shared_transfers,
        closure_transfers: closure_transfers,
        closure_roots: [Int:JetEvalTaskRoot]{},
        foreign_committed: false,
        committed: false,
        consumed_failure: false,
        active: true,
    })
}

pub fn jet_eval_result_host_transfer_commit(result: &JetEvalResult, host_value: &JetEvalHostValue, receipt: &JetEvalResultHostTransferReceipt, span: Span) -> JetEvalResultHostTransferCommitDisposition {
    disposition := JetEvalResultHostTransferCommitDisposition.Rejected
    if &result.session == {
        None -> return JetEvalResultHostTransferCommitDisposition.Rejected
        .Val(session) -> disposition = jet_eval_result_host_transfer_commit_session(&session, &result.value, &host_value, &receipt, span)
    }
    disposition
}

// Commit body run inside the result's session write window; `result_value`
// is the result's disjoint value field.
fn jet_eval_result_host_transfer_commit_session(session: &JetEvalRuntimeSession, result_value: &JetEvalRuntimeValue?, host_value: &JetEvalHostValue, receipt: &JetEvalResultHostTransferReceipt, span: Span) -> JetEvalResultHostTransferCommitDisposition {
    if receipt.consumed_failure -> return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
    if session.retired || !receipt.active || receipt.committed || receipt.machine_identity != session.machine.identity {
        jet_eval_ownership_fail(&session.machine, span, "Source host transfer receipt is stale, consumed, or belongs to another result")
        return JetEvalResultHostTransferCommitDisposition.Rejected
    }
    value :: result_value ?? return JetEvalResultHostTransferCommitDisposition.Rejected
    if value == JetEvalRuntimeValue.Moved {
        jet_eval_ownership_fail(&session.machine, span, "Source result was moved before its prepared host transfer committed")
        return JetEvalResultHostTransferCommitDisposition.Rejected
    }
    if !receipt.foreign_committed && !jet_eval_validate_host_transfers(&session.machine, receipt.transfers, [JetEvalRuntimeValue]{value}, [Bool]{true}, span) -> return JetEvalResultHostTransferCommitDisposition.Rejected
    loop transfer in receipt.shared_transfers {
        if transfer.transferred -> next
        if !transfer.staged || !jet_eval_result_host_shared_transfer_validate(&session.machine, value, host_value, transfer, span) -> return JetEvalResultHostTransferCommitDisposition.Rejected
        if jet_eval_shared_runtime_host_payload_shape(&session.machine, JetEvalSharedHostKind.Shared, transfer.index, span) == None -> return JetEvalResultHostTransferCommitDisposition.Rejected
    }
    loop transfer in receipt.closure_transfers {
        if transfer.transferred -> next
        if !jet_eval_result_host_closure_transfer_validate(&session.machine, value, host_value, transfer, span) -> return JetEvalResultHostTransferCommitDisposition.Rejected
    }
    consumed := receipt.foreign_committed && receipt.transfers.len() > 0
    loop index in 0..<receipt.shared_transfers.len() {
        transfer := receipt.shared_transfers[index]
        if transfer.transferred -> next
        source_root :: result_value ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        prepared_host :: jet_eval_result_host_shared_transfer_pre_adopted_value(&session.machine, host_value, transfer, span) ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        replaced_host :: jet_eval_result_host_value_transfer_replace(&session.machine, host_value, transfer.path, 0, transfer.owner_alias_token, transfer.index, ^prepared_host, span) ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        capability := jet_eval_result_host_shared_transfer_capability(transfer)
        committed :: jet_eval_shared_runtime_owner_alias_transfer_commit(&session.machine, transfer.index, transfer.owner_alias_token, capability, span) ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        consumed = true
        transfer.transferred = true
        transfer.staged = false
        receipt.shared_transfers[index] = transfer
        host_value = replaced_host
        expected := JetEvalRuntimeValue.Shared{index: transfer.index}
        replaced_source :: jet_eval_result_host_runtime_transfer_replace(&session.machine, source_root, transfer.path, 0, expected, span) ?? {
            receipt.consumed_failure = true
            return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
        }
        result_value = Val(replaced_source)
        committed_matches := false
        if committed == .SharedCarrier(carrier) {
            committed_matches = carrier.kind == JetEvalSharedHostKind.Shared
                && carrier.index == (Val(transfer.index))
                && carrier.owner_alias_token == (Val(transfer.owner_alias_token))
                && carrier.owner_alias_token_pre_adopted
                && carrier.owns_root_capability
        }
        if !committed_matches {
            jet_eval_ownership_fail(&session.machine, span, "Shared owner transfer returned a carrier that disagrees with its prepared receipt")
            receipt.consumed_failure = true
            return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
        }
    }
    loop index in 0..<receipt.closure_transfers.len() {
        transfer := receipt.closure_transfers[index]
        if transfer.transferred -> next
        source_root :: result_value ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        closure :: jet_eval_host_transfer_value(&session.machine, source_root, transfer.path, span) ?? {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
        consumed = true
        replaced_source :: jet_eval_result_host_runtime_transfer_replace(&session.machine, source_root, transfer.path, 0, closure, span) ?? {
            receipt.consumed_failure = true
            return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
        }
        result_value = Val(replaced_source)
        transfer.transferred = true
        receipt.closure_transfers[index] = transfer
        lease := Int?{None}
        if {
            jet_eval_callback_closure_reusable(session.machine, closure) -> {
                lease = jet_eval_callback_retain(&session.machine, ^closure, span)
            }
            else -> {
                lease = jet_eval_callback_transfer(&session.machine, ^closure, span)
            }
        }
        lease_id :: lease ?? {
            receipt.consumed_failure = true
            return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
        }
        callback_root :: jet_eval_task_root_take(&session.machine, lease_id, span) ?? {
            _ := jet_eval_callback_release(&session.machine, lease_id, span)
            receipt.consumed_failure = true
            return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
        }
        receipt.closure_roots[index] = callback_root
    }
    if !receipt.foreign_committed {
        if receipt.transfers.len() > 0 -> consumed = true
        foreign_ok := jet_eval_retire_host_transfers(&session.machine, receipt.transfers, span)
        receipt.foreign_committed = true
        if !foreign_ok {
            if consumed {
                receipt.consumed_failure = true
                return JetEvalResultHostTransferCommitDisposition.ConsumedFailure
            }
            return JetEvalResultHostTransferCommitDisposition.Rejected
        }
    }

    receipt.committed = true
    receipt.active = false
    JetEvalResultHostTransferCommitDisposition.Committed
}

fn jet_eval_result_host_task_root_cleanup_ok(result: JetEvalCallbackResult) -> Bool Never! {
    if result.outcome == .Value(_) -> return true
    false
}

pub fn jet_eval_result_host_transfer_dispose(result: &JetEvalResult, receipt: &JetEvalResultHostTransferReceipt, span: Span) -> Bool {
    cleaned := false
    if &result.session == {
        None -> return false
        .Val(session) -> {
            if session.retired || !receipt.active || receipt.committed || receipt.machine_identity != session.machine.identity {
                jet_eval_ownership_fail(&session.machine, span, "Source host transfer receipt is stale, consumed, or belongs to another result")
                return false
            }
            cleaned = jet_eval_result_host_transfer_shared_stage_dispose(&session.machine, &receipt.shared_transfers, span)
            loop index in 0..<receipt.closure_transfers.len() {
                root := &receipt.closure_roots.remove(index) ?? next
                adapter :: jet_eval_host_adapter_clone(&session.machine, span) ?? {
                    receipt.closure_roots[index] = root
                    cleaned = false
                    next
                }
                release := jet_eval_task_root_release(&root, adapter, span)
                if !jet_eval_result_host_task_root_cleanup_ok(release) {
                    cleaned = false
                    receipt.consumed_failure = true
                }
            }
        }
    }
    remaining := receipt.closure_roots.len() > 0
    loop transfer in receipt.shared_transfers {
        if transfer.staged && !transfer.transferred -> remaining = true
    }
    if !cleaned -> receipt.consumed_failure = true
    receipt.active = remaining
    cleaned && !remaining
}

fn jet_eval_result_host_type_unit(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, args) -> return name.name == "Unit" && args.len() == 0
    false
}

fn jet_eval_result_host_callable_signature_matches(machine: &JetEvalMachine, function: MIRFunction, params: [MIRType], return_type: MIRType?, conventions: [MIRAccess]?, span: Span) -> Bool Never! {
    if params.len() != function.params.len() {
        jet_eval_compiler_fail(&machine, span, "Source result closure parameter count disagrees with its checked Fn type")
        return false
    }
    loop index in 0..<params.len() {
        if !mir_type_same_checked_type(params[index], function.params[index].ty) {
            jet_eval_compiler_fail(&machine, span, "Source result closure parameter type disagrees with its checked Fn type")
            return false
        }
    }
    if conventions != None {
        expected :: conventions
        if expected.len() != function.params.len() {
            jet_eval_compiler_fail(&machine, span, "Source result closure calling convention count disagrees with its checked Fn type")
            return false
        }
        loop index in 0..<expected.len() {
            if expected[index] != function.params[index].access {
                jet_eval_compiler_fail(&machine, span, "Source result closure calling convention disagrees with its checked Fn type")
                return false
            }
        }
    }
    if {
        return_type == None -> {
            if !jet_eval_result_host_type_unit(function.return_type) {
                jet_eval_compiler_fail(&machine, span, "Source result closure return type disagrees with its checked Fn type")
                return false
            }
        }
        else -> {
            expected :: return_type
            if !mir_type_same_checked_type(expected, function.return_type) {
                jet_eval_compiler_fail(&machine, span, "Source result closure return type disagrees with its checked Fn type")
                return false
            }
        }
    }
    true
}

fn jet_eval_result_host_closure_shape_node(machine: &JetEvalMachine, ty: MIRType, function_id: MIRFunctionID, captures: [JetEvalRuntimeValue], nodes: &[JetEvalHostTypeNode], seen: &[String:Int], span: Span) -> Int? {
    function :: jet_eval_find_function(machine, function_id) ?? {
        jet_eval_compiler_fail(&machine, span, "Source result closure has no live checked guest function")
        return None
    }
    if ty.kind == {
        .Fn(signature) -> {
            if !jet_eval_result_host_callable_signature_matches(&machine, function, signature.params, signature.ret, None, span) -> return None
        }
        .SendFn(params, ret, conventions) -> {
            if !jet_eval_result_host_callable_signature_matches(&machine, function, params, ret, Val(conventions), span) -> return None
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "Source result closure does not have a checked Fn or SendFn type")
            return None
        }
    }
    if captures.len() != function.capture_params.len() {
        jet_eval_compiler_fail(&machine, span, "Source result closure capture count disagrees with its live checked guest function")
        return None
    }
    capture_nodes := [Int]{}
    loop index in 0..<captures.len() {
        capture_ty := function.capture_params[index].ty
        capture_node :: jet_eval_result_host_type_shape_node(&machine, captures[index], capture_ty, &nodes, &seen, span) ?? return None
        &capture_nodes.push(capture_node)
    }
    closure_node := nodes.len()
    &nodes.push(JetEvalHostTypeNode.Closure{ty: ty, function: function_id, captures: capture_nodes})
    return Val(closure_node)
}

fn jet_eval_result_host_type_shape_node(machine: &JetEvalMachine, value: JetEvalRuntimeValue, ty: MIRType, nodes: &[JetEvalHostTypeNode], seen: &[String:Int], span: Span) -> Int? {
    if value == .Closure(function, captures) -> return jet_eval_result_host_closure_shape_node(&machine, ty, function, captures, &nodes, &seen, span)
    if value == .Result(ok, nested) {
        if ty.kind == {
            .Option(inner) -> {
                child :: jet_eval_result_host_type_shape_node(&machine, nested, inner, &nodes, &seen, span) ?? return None
                node := nodes.len()
                &nodes.push(JetEvalHostTypeNode.Option{inner: child})
                return Val(node)
            }
            .Result(ok_type, error_type) -> {
                if ok {
                    child :: jet_eval_result_host_type_shape_node(&machine, nested, ok_type, &nodes, &seen, span) ?? return None
                    other :: jet_eval_host_shape_node(&machine, error_type, &nodes, &seen, span) ?? return None
                    node := nodes.len()
                    &nodes.push(JetEvalHostTypeNode.Result{ok: child, error: other})
                    return Val(node)
                }
                child :: jet_eval_result_host_type_shape_node(&machine, nested, error_type, &nodes, &seen, span) ?? return None
                other :: jet_eval_host_shape_node(&machine, ok_type, &nodes, &seen, span) ?? return None
                node := nodes.len()
                &nodes.push(JetEvalHostTypeNode.Result{ok: other, error: child})
                return Val(node)
            }
            else -> {}
        }
    }
    if value == .Aggregate(aggregate) {
        if aggregate == {
            .Struct(_, runtime_fields) -> {
                base :: jet_eval_host_shape_node(&machine, ty, &nodes, &seen, span) ?? return None
                if nodes[base] == .Struct(type_id, type_name, type_args, shape_fields) {
                    if runtime_fields.len() != shape_fields.len() {
                        jet_eval_compiler_fail(&machine, span, "Source result struct fields disagree with its checked host type shape")
                        return None
                    }
                    updated_fields := shape_fields
                    loop runtime_field in runtime_fields {
                        field_ty :: jet_eval_host_struct_field_type(&machine, Val(ty), runtime_field.name, span) ?? return None
                        child :: jet_eval_result_host_type_shape_node(&machine, runtime_field.value, field_ty, &nodes, &seen, span) ?? return None
                        found := false
                        loop field_index in 0..<shape_fields.len() {
                            if shape_fields[field_index].name == runtime_field.name {
                                updated_fields[field_index].node = child
                                found = true
                            }
                        }
                        if !found {
                            jet_eval_compiler_fail(&machine, span, "Source result struct field is absent from its checked host type shape")
                            return None
                        }
                    }
                    node := nodes.len()
                    &nodes.push(JetEvalHostTypeNode.Struct{type_id: type_id, type_name: type_name, args: type_args, fields: updated_fields})
                    return Val(node)
                }
                if nodes[base] == .Tuple(shape_fields) {
                    if runtime_fields.len() != shape_fields.len() {
                        jet_eval_compiler_fail(&machine, span, "Source result tuple fields disagree with its checked host type shape")
                        return None
                    }
                    updated_fields := shape_fields
                    loop runtime_field in runtime_fields {
                        field_ty :: jet_eval_host_struct_field_type(&machine, Val(ty), runtime_field.name, span) ?? return None
                        child :: jet_eval_result_host_type_shape_node(&machine, runtime_field.value, field_ty, &nodes, &seen, span) ?? return None
                        found := false
                        loop field_index in 0..<shape_fields.len() {
                            if shape_fields[field_index].name == runtime_field.name {
                                updated_fields[field_index].node = child
                                found = true
                            }
                        }
                        if !found {
                            jet_eval_compiler_fail(&machine, span, "Source result tuple field is absent from its checked host type shape")
                            return None
                        }
                    }
                    node := nodes.len()
                    &nodes.push(JetEvalHostTypeNode.Tuple{fields: updated_fields})
                    return Val(node)
                }
            }
            .Enum(_, runtime_variant, runtime_args) -> {
                base :: jet_eval_host_shape_node(&machine, ty, &nodes, &seen, span) ?? return None
                if nodes[base] == .Enum(type_id, type_name, type_args, variants) {
                    variant_index := -1
                    loop index in 0..<variants.len() {
                        if variants[index].name == runtime_variant -> variant_index = index
                    }
                    if variant_index < 0 || runtime_args.len() != variants[variant_index].args.len() {
                        jet_eval_compiler_fail(&machine, span, "Source result enum payload disagrees with its checked host type shape")
                        return None
                    }
                    updated_variants := variants
                    loop arg_index in 0..<runtime_args.len() {
                        arg := runtime_args[arg_index]
                        arg_ty :: jet_eval_host_enum_arg_type(&machine, Val(ty), runtime_variant, arg.name, arg_index, span) ?? return None
                        child :: jet_eval_result_host_type_shape_node(&machine, arg.value, arg_ty, &nodes, &seen, span) ?? return None
                        shape_arg_index := -1
                        loop candidate_index in 0..<variants[variant_index].args.len() {
                            if variants[variant_index].args[candidate_index].name == arg.name -> shape_arg_index = candidate_index
                        }
                        if shape_arg_index < 0 {
                            jet_eval_compiler_fail(&machine, span, "Source result enum argument is absent from its checked host type shape")
                            return None
                        }
                        updated_variants[variant_index].args[shape_arg_index].node = child
                    }
                    node := nodes.len()
                    &nodes.push(JetEvalHostTypeNode.Enum{type_id: type_id, type_name: type_name, args: type_args, variants: updated_variants})
                    return Val(node)
                }
            }
            else -> {}
        }
    }
    jet_eval_host_shape_node(&machine, ty, &nodes, &seen, span)
}

pub fn jet_eval_result_host_type_shape(result: &JetEvalResult, checked_type: MIRType, span: Span) -> JetEvalHostTypeShape? {
    nodes := [JetEvalHostTypeNode]{}
    seen := [String:Int]{}
    root := Int?{None}
    if &result.session == {
        None -> return None
        .Val(session) -> {
            if session.retired -> return None
            value :: result.value ?? return None
            root = jet_eval_result_host_type_shape_node(&session.machine, value, checked_type, &nodes, &seen, span)
        }
    }
    root_node :: root ?? return None
    Val(JetEvalHostTypeShape{root: root_node, nodes: nodes})
}

fn jet_eval_validate_host_transfers(machine: &JetEvalMachine, transfers: [JetEvalHostTransfer], args: [JetEvalRuntimeValue], move_permissions: [Bool], span: Span) -> Bool Never! {
    if transfers.len() == 0 -> return true
    if move_permissions.len() != args.len() {
        jet_eval_compiler_fail(&machine, span, "host transfer reply has no complete checked move facts")
        return false
    }
    seen := [Int]{}
    loop transfer in transfers {
        if transfer.argument < 0 || transfer.argument >= args.len() {
            jet_eval_compiler_fail(&machine, span, "host transfer reply names an argument outside the prepared inputs")
            return false
        }
        if !move_permissions[transfer.argument] {
            jet_eval_ownership_fail(&machine, span, "host transfer reply consumes an input without a checked move permission")
            return false
        }
        value :: jet_eval_host_transfer_value(&machine, args[transfer.argument], transfer.path, span) ?? return false
        if value == {
            .ForeignHandle(handle, raw, token) -> {
                if token != transfer.token || handle != transfer.handle || raw != transfer.raw {
                    jet_eval_ownership_fail(&machine, span, "host transfer reply token disagrees with its prepared input")
                    return false
                }
                if !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) -> return false
                aliases :: jet_eval_foreign_token_aliases(machine, token) ?? return false
                if aliases != 1 {
                    jet_eval_ownership_fail(&machine, span, "host transfer reply consumes a resource with logical aliases")
                    return false
                }
                loop existing in seen {
                    if existing == token {
                        jet_eval_ownership_fail(&machine, span, "host transfer reply consumes one source token more than once")
                        return false
                    }
                }
                &seen.push(token)
            }
            else -> {
                jet_eval_compiler_fail(&machine, span, "host transfer reply path does not select a native handle")
                return false
            }
        }
    }
    true
}

fn jet_eval_retire_host_transfers(machine: &JetEvalMachine, transfers: [JetEvalHostTransfer], span: Span) -> Bool {
    ok := true
    loop transfer in transfers {
        if !jet_eval_foreign_handle_transfer_retire(&machine, transfer.token, span) -> ok = false
    }
    ok
}

fn jet_eval_host_outcome_collect(machine: &JetEvalMachine, outcome: JetEvalHostOutcome, pending: &[JetEvalRuntimeValue], span: Span) -> Bool {
    if outcome == {
        .Value(value) -> return jet_eval_owned_host_value_collect(&machine, value, &pending, span)
        .Effect(value, _, _) -> return jet_eval_owned_host_value_collect(&machine, value, &pending, span)
        .Control(value, _, _, _) -> return jet_eval_owned_host_value_collect(&machine, value, &pending, span)
        .RuntimeFailure(value, _) -> return jet_eval_owned_host_value_collect(&machine, value, &pending, span)
        .InternalProblem(_) -> return true
        .Failure(_, _) -> return true
    }
    true
}
fn jet_eval_host_outcome_release(machine: &JetEvalMachine, held: ^[JetEvalRuntimeValue], span: Span) -> Bool {
    ok := true
    loop alias in held {
        if !jet_eval_drop_value(&machine, alias, span) -> ok = false
    }
    ok
}

fn jet_eval_host_outcome_discard(machine: &JetEvalMachine, outcome: JetEvalHostOutcome, span: Span) -> Bool {
    pending := [JetEvalRuntimeValue]{}
    ok := jet_eval_host_outcome_collect(&machine, outcome, &pending, span)
    loop alias in pending {
        if !jet_eval_drop_value(&machine, alias, span) -> ok = false
    }
    ok
}
fn jet_eval_host_result_discard(machine: &JetEvalMachine, reply: JetEvalHostResult, span: Span) -> Bool {
    pending := [JetEvalRuntimeValue]{}
    ok := true
    loop writeback in reply.writebacks {
        if !jet_eval_owned_host_value_collect(&machine, writeback.value, &pending, span) -> ok = false
    }
    if !jet_eval_host_outcome_collect(&machine, reply.outcome, &pending, span) -> ok = false
    loop alias in pending {
        if !jet_eval_drop_value(&machine, alias, span) -> ok = false
    }
    ok
}

fn jet_eval_apply_host_outcome(machine: &JetEvalMachine, outcome: JetEvalHostOutcome, row: MIRPreludeCall?, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if outcome == {
        .Value(value) -> return jet_eval_host_value_adopt(&machine, row, result_ty, value, true, span)
        .Effect(value, stdout, stderr) -> {
            if !jet_eval_append_output(&machine, stdout, stderr, span) -> return None
            return jet_eval_host_value_adopt(&machine, row, result_ty, value, true, span)
        }
        .Control(value, stdout, stderr, exit_code) -> {
            if !jet_eval_append_output(&machine, stdout, stderr, span) -> return None
            machine.soft_stop = true
            machine.exit_code = Val(exit_code)
            return jet_eval_host_value_adopt(&machine, row, result_ty, value, true, span)
        }
        .RuntimeFailure(value, failure_span) -> {
            nested :: jet_eval_host_value_adopt(&machine, row, None, value, false, span) ?? return None
            return Val(JetEvalRuntimeValue.RuntimeFailure{value: nested, span: failure_span})
        }
        .InternalProblem(problem) -> {
            if machine.internal_problem == None -> machine.internal_problem = Val(problem)
            return None
        }
        .Failure(kind, diagnostic) -> {
            if kind == JetEvalErrorKind.Compiler || kind == JetEvalErrorKind.Ownership {
                jet_eval_internal_problem(&machine, None, "native host adapter returned an evaluator invariant failure")
                return None
            }
            if machine.failure == None {
                machine.failure = Val(JetEvalError{kind: kind, diagnostic: diagnostic})
            }
            return None
        }
    }
}

fn jet_eval_apply_host_reply(machine: &JetEvalMachine, reply: JetEvalHostResult, row: MIRPreludeCall?, args: [JetEvalRuntimeValue], move_permissions: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if !jet_eval_validate_host_transfers(&machine, reply.transfers, args, move_permissions, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        return None
    }
    if !jet_eval_retire_host_transfers(&machine, reply.transfers, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        return None
    }
    held := [JetEvalRuntimeValue]{}
    if !jet_eval_host_outcome_collect(&machine, reply.outcome, &held, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    if !jet_eval_host_writebacks(&machine, args, reply.writebacks, span) {
        jet_eval_host_outcome_discard(&machine, reply.outcome, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    result := jet_eval_apply_host_outcome(&machine, reply.outcome, row, result_ty, span)
    if !jet_eval_host_outcome_release(&machine, ^held, span) {
        if result == .Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        return None
    }
    result
}
fn jet_eval_host_success_type(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .Option(inner) -> return jet_eval_host_success_type(inner)
        .Result(ok, _) -> return jet_eval_host_success_type(ok)
        else -> {}
    }
    ~ty
}
fn jet_eval_host_retype(source: MIRType, kind: MIRTypeKind) -> MIRType Never! {
    output := mir_type_from_kind(kind)
    if source.identity != None {
        return mir_type_with_identity(output, source.identity ?? MIRTypeID{value: 0})
    }
    output
}

fn jet_eval_host_substitute_type(ty: MIRType, params: [MIRGenericParam], args: [MIRType]) -> MIRType Never! {
    if ty.kind == {
        .Apply(name, nested) -> {
            if nested.len() == 0 {
                loop index in 0..<params.len() {
                    if params[index].name == name.name && index < args.len() -> return args[index]
                }
            }
            output := [MIRType]{}
            loop item in nested -> &output.push(jet_eval_host_substitute_type(item, params, args))
            return jet_eval_host_retype(ty, MIRTypeKind.Apply{name: name, args: output})
        }
        .List(inner) -> return jet_eval_host_retype(ty, MIRTypeKind.List{inner: jet_eval_host_substitute_type(inner, params, args)})
        .Map(key, value) -> return jet_eval_host_retype(ty, MIRTypeKind.Map{key: jet_eval_host_substitute_type(key, params, args), value: jet_eval_host_substitute_type(value, params, args)})
        .Shared(inner) -> return jet_eval_host_retype(ty, MIRTypeKind.Shared{inner: jet_eval_host_substitute_type(inner, params, args)})
        .Option(inner) -> return jet_eval_host_retype(ty, MIRTypeKind.Option{inner: jet_eval_host_substitute_type(inner, params, args)})
        .Result(ok, err) -> return jet_eval_host_retype(ty, MIRTypeKind.Result{ok: jet_eval_host_substitute_type(ok, params, args), err: jet_eval_host_substitute_type(err, params, args)})
        .Tuple(fields) -> {
            output := [MIRTupleField]{}
            loop field in fields {
                &output.push(MIRTupleField{name: field.name, ty: jet_eval_host_substitute_type(field.ty, params, args)})
            }
            return jet_eval_host_retype(ty, MIRTypeKind.Tuple{fields: output})
        }
        .FixedList(inner, length) -> return jet_eval_host_retype(ty, MIRTypeKind.FixedList{elem: jet_eval_host_substitute_type(inner, params, args), len: length})
        .InlineRange(inner, lo, hi) -> return jet_eval_host_retype(ty, MIRTypeKind.InlineRange{base: jet_eval_host_substitute_type(inner, params, args), lo: lo, hi: hi})
        .Tagged(marker, inner) -> return jet_eval_host_retype(ty, MIRTypeKind.Tagged{marker: marker, inner: jet_eval_host_substitute_type(inner, params, args)})
        .Union(types) -> {
            output := [MIRType]{}
            loop item in types -> &output.push(jet_eval_host_substitute_type(item, params, args))
            return jet_eval_host_retype(ty, MIRTypeKind.Union{members: output})
        }
        .Quantity(inner, dimension) -> return jet_eval_host_retype(ty, MIRTypeKind.Quantity{base: jet_eval_host_substitute_type(inner, params, args), dimension: dimension})
        else -> return ~ty
    }
}

fn jet_eval_host_nominal_definition(machine: &JetEvalMachine, ty: MIRType, span: Span) -> MIRTypeDef? {
    id := if ty.kind == {.Apply(name, _) -> Val(name.id) else -> ty.identity}
    nominal_id :: id ?? return None
    row :: machine.rows.types.get(nominal_id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "native host aggregate type has no checked nominal definition")
        return None
    }
    Val(machine.program.types[row])
}

fn jet_eval_host_struct_field_type(machine: &JetEvalMachine, ty: MIRType?, name: String, span: Span) -> MIRType? {
    expected :: ty ?? return None
    if expected.kind == .Tuple(fields) {
        loop field in fields {
            if field.name == name -> return Val(field.ty)
        }
        jet_eval_compiler_fail(&machine, span, "native host tuple aggregate field has no checked type")
        return None
    }
    definition :: jet_eval_host_nominal_definition(&machine, expected, span) ?? return None
    if definition.kind == .Struct(fields, _) {
        loop field in fields {
            if field.name == name {
                if expected.kind == .Apply(_, args) -> return Val(jet_eval_host_substitute_type(field.ty, definition.generic_params, args))
                return Val(field.ty)
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "native host struct aggregate field has no checked type")
    None
}

fn jet_eval_host_sequence_element_type(machine: &JetEvalMachine, ty: MIRType?, span: Span) -> MIRType? {
    expected :: ty ?? return None
    if expected.kind == {
        .List(inner) | .FixedList(inner, _) -> return Val(inner)
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "native host list aggregate has no checked element type")
    None
}

fn jet_eval_host_map_types(machine: &JetEvalMachine, ty: MIRType?, span: Span) -> [MIRType]? {
    expected :: ty ?? return None
    if expected.kind == .Map(key, value) -> return Val([MIRType]{key, value})
    jet_eval_compiler_fail(&machine, span, "native host map aggregate has no checked key/value types")
    None
}

fn jet_eval_host_option_child_type(machine: &JetEvalMachine, ty: MIRType?, ok: Bool, span: Span) -> MIRType? {
    expected :: ty ?? return None
    if expected.kind == .Option(inner) -> return Val(inner)
    if expected.kind == .Result(result, error) -> return Val(if ok -> result else -> error)
    jet_eval_compiler_fail(&machine, span, "native host failure carrier has no checked Option/Result type")
    None
}

fn jet_eval_host_enum_arg_type(machine: &JetEvalMachine, ty: MIRType?, variant_name: String, arg_name: String?, index: Int, span: Span) -> MIRType? {
    expected :: ty ?? return None
    definition :: jet_eval_host_nominal_definition(&machine, expected, span) ?? return None
    if definition.kind == .Enum(variants, _) {
        loop variant in variants {
            if variant.name == variant_name {
                if variant.payload == .Single(inner) {
                    if index == 0 {
                        if expected.kind == {
                            .Apply(_, args) -> {
                                return Val(jet_eval_host_substitute_type(inner, definition.generic_params, args))
                            }
                            else -> {}
                        }
                        return Val(inner)
                    }
                }
                if variant.payload == .Named(fields) {
                    field_index := 0
                    loop field in fields {
                        matches := if arg_name != None -> field.name == (arg_name) else -> field_index == index
                        if matches {
                            if expected.kind == {
                                .Apply(_, args) -> {
                                    return Val(jet_eval_host_substitute_type(field.ty, definition.generic_params, args))
                                }
                                else -> {}
                            }
                            return Val(field.ty)
                        }
                        field_index += 1
                    }
                }
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "native host enum aggregate argument has no checked type")
    None
}


fn jet_eval_core_owner_check(program: MIRProgram, rows: JetEvalProgramRows, ty: MIRType) -> JetEvalHostCoreOwnerCheck Never! {
    nominal :: if ty.kind == {
        .Apply(name, _) -> Val(name)
        else -> None
    }
    name :: nominal ?? return JetEvalHostCoreOwnerCheck.Missing
    nominal_id := name.id
    matches :: rows.core_owners_by_nominal.get(nominal_id.value) ?? [Int]{}
    if matches.len() == 0 -> return JetEvalHostCoreOwnerCheck.Missing
    if matches.len() > 1 -> return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner registration is ambiguous"}
    owner :: program.core_owners[matches[0]]
    if owner.id.value == 0 || owner.nominal_id.value == 0 {
        return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner registration has a zero identity"}
    }
    if owner.nominal_id != nominal_id || owner.name == "" || owner.key == "" || owner.name != name.name {
        return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact disagrees with its checked nominal name"}
    }
    if owner.id != mir_type_id(owner.key) {
        return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact ID disagrees with its checked key"}
    }
    registered_matches :: rows.core_owners_by_id.get(owner.id.value) ?? [Int]{}
    if registered_matches.len() != 1 {
        return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner registered ID is ambiguous"}
    }
    if owner.ownership != MIROwnershipMode.Owned && owner.ownership != MIROwnershipMode.Move {
        return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact is not an owned nominal"}
    }
    if rows.types.get(owner.id.value) == .Val(checked_definition) {
        if program.types[checked_definition].key != owner.key || program.types[checked_definition].name != owner.name || (program.types[checked_definition].ownership != MIROwnershipMode.Owned && program.types[checked_definition].ownership != MIROwnershipMode.Move) {
            return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact disagrees with its checked type definition"}
        }
        if owner.module_id != (Val(program.types[checked_definition].module_id)) {
            return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact module disagrees with its checked type definition"}
        }
    }
    if owner.module_id != None {
        module_id :: owner.module_id ?? return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact has an invalid source module"}
        if rows.modules.get(module_id.value) == None -> return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner fact has no checked source module"}
    }
    lifecycle_found := false
    loop index in 0..<program.handles.len() {
        if program.handles[index].ownership == MIRHandleOwnership.Owned && mir_type_same_checked_type(program.handles[index].ty, ty) {
            lifecycle_found = true
            break
        }
    }
    if !lifecycle_found -> return JetEvalHostCoreOwnerCheck.Invalid{message: "native Core owner has no exact registered owned lifecycle"}
    JetEvalHostCoreOwnerCheck.Valid{owner: owner}
}

fn jet_eval_core_owner_fact(machine: &JetEvalMachine, ty: MIRType, span: Span) -> MIRCoreOwner? {
    if jet_eval_core_owner_check(machine.program, machine.rows, ty) == {
        .Missing -> return None
        .Valid(owner) -> return Val(owner)
        .Invalid(message) -> {
            jet_eval_compiler_fail(&machine, span, message)
            return None
        }
    }
    None
}
fn jet_eval_core_owner_registration_matches(machine: &JetEvalMachine, owner: JetEvalHostCoreOwner, span: Span) -> Bool Never! {
    checked :: jet_eval_core_owner_fact(&machine, owner.ty, span) ?? {
        jet_eval_compiler_fail(&machine, span, "native Core owner has no unique checked registration")
        return false
    }
    if checked.id != owner.fact.id || checked.nominal_id != owner.fact.nominal_id || checked.module_id != owner.fact.module_id || checked.key != owner.fact.key || checked.name != owner.fact.name || checked.ownership != owner.fact.ownership {
        jet_eval_compiler_fail(&machine, span, "native Core owner registration disagrees with its checked program row")
        return false
    }
    true
}
fn jet_eval_host_handle_validate(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, owner: JetEvalHostOwner, handle: MIRHandleID, raw: Int, span: Span) -> Bool Never! {
    success_type := MIRType?{None}
    if result_ty != None {
        checked_result :: result_ty
        success_type = Val(jet_eval_host_success_type(checked_result))
    }
    if owner == {
        .FixedBackingRoot(_, _) -> {
            jet_eval_compiler_fail(&machine, span, "native Fixed backing roots can only be adopted from an allocator receipt")
            return false
        }
        .Cursor -> {
            jet_eval_compiler_fail(&machine, span, "native cursor handle reached the ordinary Core owner validator")
            return false
        }
        // Native identity is checked callable type or checked interface VALUE
        // type; the method being invoked is carried separately at call sites.
        .Native(binding) -> {
            if binding == {
                .Callable(callable) -> {
                    if callable.callable_type.kind == {
                        .Fn(_) | .SendFn(_, _, _) -> {}
                        else -> {
                            jet_eval_compiler_fail(&machine, span, "native callable carrier does not have a checked Fn type")
                            return false
                        }
                    }
                    if success_type != None && !mir_type_same_checked_type(success_type ?? callable.callable_type, callable.callable_type) {
                        jet_eval_compiler_fail(&machine, span, "native callable carrier type disagrees with the checked result type")
                        return false
                    }
                }
                .Interface(receiver_type) -> {
                    if receiver_type.kind == {
                        .TraitObject(bounds) -> {
                            if bounds.len() != 1 {
                                jet_eval_compiler_fail(&machine, span, "native interface carrier must have one checked trait-object bound")
                                return false
                            }
                        }
                        else -> {
                            jet_eval_compiler_fail(&machine, span, "native interface carrier does not have a checked trait-object type")
                            return false
                        }
                    }
                    checked_type := false
                    loop index in 0..<machine.program.type_instances.len() {
                        if mir_type_same_checked_type(machine.program.type_instances[index], receiver_type) {
                            checked_type = true
                            break
                        }
                    }
                    if !checked_type {
                        jet_eval_compiler_fail(&machine, span, "native interface carrier type is not present in the checked program")
                        return false
                    }
                    if success_type != None && !mir_type_same_checked_type(success_type ?? receiver_type, receiver_type) {
                        jet_eval_compiler_fail(&machine, span, "native interface carrier type disagrees with the checked result type")
                        return false
                    }
                }
            }
            return true
        }
        .Declared(declared_ty) -> {
            lifecycle := jet_eval_handle_lifecycle(machine, handle)
            lifecycle_row :: lifecycle ?? {
                jet_eval_compiler_fail(&machine, span, "native declared handle has no canonical lifecycle row")
                return false
            }
            if !mir_type_same_checked_type(lifecycle_row.ty, declared_ty) {
                jet_eval_compiler_fail(&machine, span, "native declared handle owner type disagrees with its lifecycle")
                return false
            }
            if lifecycle_row.ownership != MIRHandleOwnership.Owned {
                jet_eval_compiler_fail(&machine, span, "native declared handle result is not an owned resource")
                return false
            }
            if success_type != None && !mir_type_same_checked_type(lifecycle_row.ty, success_type ?? lifecycle_row.ty) {
                jet_eval_compiler_fail(&machine, span, "native declared handle result type disagrees with its lifecycle")
                return false
            }
            if lifecycle_row.payload.close == "" {
                jet_eval_compiler_fail(&machine, span, "native declared handle lifecycle has no checked close member")
                return false
            }
        }
        .Core(core_owner) -> {
            if row != None {
                checked_row :: row
                if checked_row.symbol == {
                    .Runtime(_) -> {
                        jet_eval_compiler_fail(&machine, span, "native Core owner result came from a Runtime symbol")
                        return false
                    }
                    else -> {}
                }
            }
            if !jet_eval_core_owner_registration_matches(&machine, core_owner, span) -> return false
            if success_type != None && !mir_type_same_checked_type(core_owner.ty, success_type ?? core_owner.ty) {
                jet_eval_compiler_fail(&machine, span, "native Core owner type disagrees with its checked result type")
                return false
            }
        }
    }
    true
}

fn jet_eval_host_owner_token_kind(owner: JetEvalHostOwner, machine: &JetEvalMachine, span: Span) -> JetEvalForeignTokenKind? {
    if owner == {
        .Declared(ty) -> return Val(JetEvalForeignTokenKind.Declared{ty: ty})
        .Core(core_owner) -> return Val(JetEvalForeignTokenKind.Core{owner: core_owner})
        .Native(binding) -> return Val(JetEvalForeignTokenKind.Native{binding: binding})
        .FixedBackingRoot(element_type, length) -> return Val(JetEvalForeignTokenKind.FixedBackingRoot{element_type: element_type, length: length})
        .Cursor -> {}
    }
    jet_eval_compiler_fail(&machine, span, "native cursor owner cannot be stored as an ordinary handle token")
    None
}

// Adopt a native handle as one owned alias: a resource identity the session
// already tracks gains one more alias of its token; otherwise a fresh token
// with a single alias is registered and the adopted payload moves into it.
fn jet_eval_host_handle_new(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, owner: JetEvalHostOwner, handle: MIRHandleID, raw: Int, payload: JetEvalHostValue, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_handle_new_mode(&machine, row, result_ty, owner, handle, raw, payload, false, span)
}
fn jet_eval_host_handle_borrowed(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, owner: JetEvalHostOwner, handle: MIRHandleID, raw: Int, payload: JetEvalHostValue, span: Span) -> JetEvalRuntimeValue? {
    if !jet_eval_host_handle_validate(&machine, row, result_ty, owner, handle, raw, span) -> return None
    token_kind :: jet_eval_host_owner_token_kind(owner, &machine, span) ?? return None
    payload_value :: jet_eval_host_value_adopt_mode(&machine, row, None, payload, false, false, span) ?? return None
    Val(jet_eval_borrowed_foreign_handle_new(machine, handle, raw, token_kind, payload_value))
}

fn jet_eval_host_handle_new_mode(machine: &JetEvalMachine, row: MIRPreludeCall?, result_ty: MIRType?, owner: JetEvalHostOwner, handle: MIRHandleID, raw: Int, payload: JetEvalHostValue, cleanup: Bool, span: Span) -> JetEvalRuntimeValue? {
    if !jet_eval_host_handle_validate(&machine, row, result_ty, owner, handle, raw, span) -> return None
    token_kind :: jet_eval_host_owner_token_kind(owner, &machine, span) ?? return None
    if jet_eval_canonical_handle_token_kind(token_kind) {
        existing := jet_eval_resource_handle_alias(machine, handle, raw, token_kind)
        if existing == {
            Val(token) -> {
                alias := JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token}
                if !jet_eval_host_value_is_unit(payload) {
                    jet_eval_ownership_fail(&machine, span, "native resource alias carries a distinct logical payload")
                    jet_eval_drop_value(&machine, alias, span)
                    if cleanup -> jet_eval_owned_host_value_discard(&machine, payload, span)
                    return None
                }
                return Val(alias)
            }
            None -> {}
        }
    }
    payload_value :: jet_eval_host_value_adopt_mode(&machine, row, None, payload, false, cleanup, span) ?? return None
    token := jet_eval_registry_insert_token(machine, handle, raw, token_kind, payload_value, false)
    Val(JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token})
}


fn jet_eval_host_handle_is_loop(row: MIRPreludeCall) -> Bool Never! {
    row.module_name == "core.prelude" && row.member == "loop_iter_init" && mir_symbol_name(row.symbol) == "jet_loop_iter_init" && row.signature.arity == 5 && row.signature.max_arity == 5
}
fn jet_eval_host_handle_result(machine: &JetEvalMachine, row: MIRPreludeCall, result_ty: MIRType?, handle: MIRHandleID, raw: Int, owner: JetEvalHostOwner, payload: JetEvalHostValue, span: Span) -> JetEvalRuntimeValue? {
    if jet_eval_host_handle_is_loop(row) {
        if owner != JetEvalHostOwner.Cursor {
            jet_eval_compiler_fail(&machine, span, "native iterator initializer returned a non-cursor owner descriptor")
            return None
        }
        if row.family != MIRPreludeFamily.StaticPrelude || row.abi != MIRPreludeABI.Value {
            jet_eval_compiler_fail(&machine, span, "native iterator initializer returned a non-canonical Prelude row")
            return None
        }
        if handle != jet_eval_loop_cursor_handle_id() {
            jet_eval_compiler_fail(&machine, span, "native iterator initializer returned a non-canonical handle identity")
            return None
        }
        payload_value :: jet_eval_host_value_adopt(&machine, Val(row), None, payload, false, span) ?? return None
        return Val(jet_eval_cursor_handle_new(machine, handle, raw, payload_value))
    }
    if owner == JetEvalHostOwner.Cursor {
        jet_eval_compiler_fail(&machine, span, "native cursor owner was returned by a non-iterator Core route")
        return None
    }
    jet_eval_host_handle_new(&machine, row, result_ty, owner, handle, raw, payload, span)
}

fn jet_eval_host_unit_reply(machine: &JetEvalMachine, reply: JetEvalHostResult, transfer_message: String, non_unit_message: String, span: Span) -> Bool {
    if reply.transfers.len() != 0 {
        jet_eval_compiler_fail(&machine, span, transfer_message)
        jet_eval_host_result_discard(&machine, reply, span)
        return false
    }
    held := [JetEvalRuntimeValue]{}
    if !jet_eval_host_outcome_collect(&machine, reply.outcome, &held, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return false
    }
    if !jet_eval_host_writebacks(&machine, [JetEvalRuntimeValue]{}, reply.writebacks, span) {
        jet_eval_host_outcome_discard(&machine, reply.outcome, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return false
    }
    value := jet_eval_apply_host_outcome(&machine, reply.outcome, None, None, span)
    if !jet_eval_host_outcome_release(&machine, ^held, span) {
        if value == .Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        return false
    }
    produced :: value ?? return false
    if produced != (JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) {
        jet_eval_compiler_fail(&machine, span, non_unit_message)
        jet_eval_drop_value(&machine, produced, span)
        return false
    }
    true
}

fn jet_eval_host_handle_release(machine: &JetEvalMachine, lifecycle: MIRHandleLifecycle, handle: MIRHandleID, raw: Int, span: Span) -> Bool {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return false
    reply :: adapter.handle_call(&machine, lifecycle.payload.close, handle, raw, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR Core handle close is unavailable to the typed native adapter")
        return false
    }
    jet_eval_host_unit_reply(&machine, reply, "MIR handle close returned a committed source transfer", "MIR Core handle close returned a non-Unit value", span)
}

pub fn jet_eval_host_projection(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> JetEvalHostValue? {
    if value == {
        .Moved -> {
            jet_eval_ownership_fail(&machine, span, "native host argument contains a moved Source value")
            return None
        }
        .Data(data) -> return Val(JetEvalHostValue.Data{value: data})
        .Absent(element) -> return Val(JetEvalHostValue.Absent{element: element})
        .Result(ok, nested) -> {
            child :: jet_eval_host_projection(&machine, nested, span) ?? return None
            if ok -> return Val(JetEvalHostValue.Present{value: child})
            return Val(JetEvalHostValue.Failed{value: child})
        }
        .Closure(function, captures) -> {
            output := [JetEvalHostValue]{}
            loop capture in captures -> &output.push(jet_eval_host_projection(&machine, capture, span) ?? return None)
            return Val(JetEvalHostValue.Closure{function: function, captures: ^output})
        }
        .Aggregate(aggregate) -> {
            if aggregate == {
                .List(values) -> {
                    output := [JetEvalHostValue]{}
                    loop item in values -> &output.push(jet_eval_host_projection(&machine, item, span) ?? return None)
                    return Val(JetEvalHostValue.List{values: ^output})
                }
                .Map(entries) -> {
                    output := [JetEvalHostMapEntry]{}
                    loop entry in entries {
                        key :: jet_eval_host_projection(&machine, entry.key, span) ?? return None
                        item :: jet_eval_host_projection(&machine, entry.value, span) ?? return None
                        &output.push(JetEvalHostMapEntry{key: key, value: item})
                    }
                    return Val(JetEvalHostValue.Map{entries: output})
                }
                .Struct(type_name, fields) -> {
                    output := [JetEvalHostField]{}
                    loop field in fields {
                        item :: jet_eval_host_projection(&machine, field.value, span) ?? return None
                        &output.push(JetEvalHostField{name: field.name, value: item})
                    }
                    return Val(JetEvalHostValue.Struct{type_name: type_name, fields: output})
                }
                .Enum(type_name, variant, args) -> {
                    output := [JetEvalHostEnumArg]{}
                    loop arg in args {
                        item :: jet_eval_host_projection(&machine, arg.value, span) ?? return None
                        &output.push(JetEvalHostEnumArg{name: arg.name, value: item})
                    }
                    return Val(JetEvalHostValue.Enum{type_name: type_name, variant: variant, args: output})
                }
            }
        }
        .ForeignHandle(handle, raw, token) -> {
            meta :: jet_eval_foreign_token_meta(machine, token) ?? {
                jet_eval_compiler_fail(&machine, span, "native host argument handle has no evaluator token")
                return None
            }
            if meta.retired {
                jet_eval_ownership_fail(&machine, span, "native host argument handle is retired")
                return None
            }
            stored :: jet_eval_foreign_token_read_payload(machine, token) ?? return None
            payload :: jet_eval_host_projection(&machine, stored, span) ?? return None
            if meta.kind == {
                .Foreign -> {
                    jet_eval_compiler_fail(&machine, span, "native host argument carries an ordinary foreign handle")
                    return None
                }
                .Cursor -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Cursor, payload: payload})
                .Declared(ty) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Declared{ty: ty}, payload: payload})
                .Core(owner) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Core{owner: owner}, payload: payload})
                .Native(binding) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Native{binding: binding}, payload: payload})
                .FixedBackingRoot(_, _) -> {
                    jet_eval_compiler_fail(&machine, span, "native Fixed backing root cannot be projected as an ordinary host argument")
                    return None
                }
            }
        }
        .HostCursor(inner, _, _, _) -> return jet_eval_host_projection(&machine, inner, span)
        .Shared(_) | .SharedWeak(_) | .SharedGuard(_) | .SharedSnapshot(_) | .Condition(_) -> return jet_eval_shared_runtime_host_projection(&machine, value, span)
        .Address(_, _, _) | .SharedCell(_, _) | .RangeCursor(_, _, _, _, _) | .ListCursor(_, _, _) | .Stream(_, _, _, _) -> {
            jet_eval_compiler_fail(&machine, span, "native host argument requires a materialized Source value")
            return None
        }
        .RuntimeFailure(_, _) -> {
            jet_eval_compiler_fail(&machine, span, "terminal Source runtime failure cannot cross a native host boundary")
            return None
        }
    }
    None
}

// Project a completed result while its owning evaluator session still holds
// the Source aliases. This is a read-only boundary view; retirement remains
// the caller's explicit ownership transition.
pub fn jet_eval_result_host_projection(result: &JetEvalResult, span: Span) -> JetEvalHostValue? {
    projected := JetEvalHostValue?{None}
    if &result.session == {
        None -> return None
        .Val(session) -> {
            if session.retired -> return None
            value :: result.value ?? return None
            projected = jet_eval_host_projection(&session.machine, value, span)
        }
    }
    projected
}
// Borrow-only projection of an owned argument for the native boundary; the
// argument keeps its aliases and the boundary discharges them afterwards.
fn jet_eval_host_argument(machine: &JetEvalMachine, value: JetEvalRuntimeValue, moved: Bool, span: Span) -> JetEvalHostArgument? {
    materialized := value
    if value == .SharedCell(index, _) {
        if !jet_eval_shared_cell_live(&machine, index, span) -> return None
        materialized = jet_eval_shared_cell_read_payload(machine, index) ?? {
            jet_eval_ownership_fail(&machine, span, "native host argument shared capture cell is unavailable")
            return None
        }
    }
    host :: jet_eval_host_projection(&machine, materialized, span) ?? return None
    Val(JetEvalHostArgument{value: value, host: host, moved: moved})
}
fn jet_eval_host_arguments(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], move_permissions: [Bool], span: Span) -> [JetEvalHostArgument]? {
    output := [JetEvalHostArgument]{}
    index := 0
    loop value in args {
        moved := index < move_permissions.len() && move_permissions[index]
        &output.push(jet_eval_host_argument(&machine, value, moved, span) ?? return None)
        index += 1
    }
    Val(^output)
}
fn jet_eval_task_host_projection(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> JetEvalHostValue? {
    if value == {
        .Moved -> {
            jet_eval_ownership_fail(&machine, span, "native scheduler argument contains a moved Source value")
            return None
        }
        .Data(data) -> {
            if jet_eval_data_contains_moved(data) {
                jet_eval_ownership_fail(&machine, span, "native scheduler argument aggregate contains a moved value")
                return None
            }
            return Val(JetEvalHostValue.Data{value: data})
        }
        .Absent(element) -> return Val(JetEvalHostValue.Absent{element: element})
        .Result(ok, nested) -> {
            projected :: jet_eval_task_host_projection(&machine, nested, span) ?? return None
            if ok -> return Val(JetEvalHostValue.Present{value: projected})
            return Val(JetEvalHostValue.Failed{value: projected})
        }
        .Closure(function, captures) -> {
            output := [JetEvalHostValue]{}
            loop capture in captures -> &output.push(jet_eval_task_host_projection(&machine, capture, span) ?? return None)
            return Val(JetEvalHostValue.Closure{function: function, captures: ^output})
        }
        .Aggregate(aggregate) -> {
            if aggregate == {
                .List(values) -> {
                    output := [JetEvalHostValue]{}
                    loop item in values -> &output.push(jet_eval_task_host_projection(&machine, item, span) ?? return None)
                    return Val(JetEvalHostValue.List{values: ^output})
                }
                .Map(entries) -> {
                    output := [JetEvalHostMapEntry]{}
                    loop entry in entries {
                        key_value := jet_eval_task_host_projection(&machine, entry.key, span) ?? return None
                        entry_value := jet_eval_task_host_projection(&machine, entry.value, span) ?? return None
                        &output.push(JetEvalHostMapEntry{key: key_value, value: entry_value})
                    }
                    return Val(JetEvalHostValue.Map{entries: output})
                }
                .Struct(type_name, fields) -> {
                    output := [JetEvalHostField]{}
                    loop field in fields {
                        projected := jet_eval_task_host_projection(&machine, field.value, span) ?? return None
                        &output.push(JetEvalHostField{name: field.name, value: projected})
                    }
                    return Val(JetEvalHostValue.Struct{type_name: type_name, fields: output})
                }
                .Enum(type_name, variant, args) -> {
                    output := [JetEvalHostEnumArg]{}
                    loop arg in args {
                        projected := jet_eval_task_host_projection(&machine, arg.value, span) ?? return None
                        &output.push(JetEvalHostEnumArg{name: arg.name, value: projected})
                    }
                    return Val(JetEvalHostValue.Enum{type_name: type_name, variant: variant, args: output})
                }
            }
        }
        .ForeignHandle(handle, raw, token) -> {
            meta :: jet_eval_foreign_token_meta(machine, token) ?? {
                jet_eval_compiler_fail(&machine, span, "native scheduler argument handle has no evaluator token")
                return None
            }
            if meta.retired {
                jet_eval_ownership_fail(&machine, span, "native scheduler argument handle is retired")
                return None
            }
            placeholder := JetEvalHostValue.Data{value: TComptimeValue.Unit}
            if meta.kind == {
                .Foreign -> return Val(placeholder)
                .Cursor -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Cursor, payload: placeholder})
                .Declared(ty) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Declared{ty: ty}, payload: placeholder})
                .Core(owner) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Core{owner: owner}, payload: placeholder})
                .Native(binding) -> return Val(JetEvalHostValue.Handle{handle: handle, raw: raw, owner: JetEvalHostOwner.Native{binding: binding}, payload: placeholder})
                .FixedBackingRoot(_, _) -> {
                    jet_eval_ownership_fail(&machine, span, "native Fixed backing root cannot cross a scheduler boundary")
                    return None
                }
            }
        }
        .SharedCell(index, _) -> {
            if !jet_eval_shared_cell_live(&machine, index, span) -> return None
            return Val(JetEvalHostValue.Data{value: TComptimeValue.Unit})
        }
        .Shared(_) | .SharedWeak(_) | .SharedGuard(_) | .SharedSnapshot(_) | .Condition(_) -> return jet_eval_shared_runtime_host_projection(&machine, value, span)
        .HostCursor(inner, _, _, _) -> return jet_eval_task_host_projection(&machine, inner, span)
        .Address(_, _, _) | .RangeCursor(_, _, _, _, _) | .ListCursor(_, _, _) | .Stream(_, _, _, _) -> {
            jet_eval_ownership_fail(&machine, span, "native scheduler argument has an invalid Source carrier")
            return None
        }
        .RuntimeFailure(_, _) -> {
            jet_eval_compiler_fail(&machine, span, "terminal Source runtime failure cannot cross the scheduler boundary")
            return None
        }
    }
    None
}

fn jet_eval_task_host_arguments(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], move_permissions: [Bool], span: Span) -> [JetEvalHostArgument]? {
    output := [JetEvalHostArgument]{}
    index := 0
    loop value in args {
        host := jet_eval_task_host_projection(&machine, value, span) ?? return None
        moved := index < move_permissions.len() && move_permissions[index]
        &output.push(JetEvalHostArgument{value: value, host: host, moved: moved})
        index += 1
    }
    Val(output)
}
// Native-call arguments carry the checked move permission so the adapter can
// decide which inputs it may consume; Source still validates every transfer.
fn jet_eval_native_host_arguments(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], move_permissions: [Bool], span: Span) -> [JetEvalHostArgument]? {
    output := [JetEvalHostArgument]{}
    index := 0
    loop value in args {
        host :: if value == {
            .Address(frame, place, access) -> {
                if access != MIRAccess.Write {
                    jet_eval_ownership_fail(&machine, span, "native call address argument is not writable")
                    return None
                }
                materialized :: jet_eval_read_place(&machine, frame, place, span) ?? return None
                projected := jet_eval_host_projection(&machine, materialized, span)
                jet_eval_drop_value(&machine, materialized, span)
                projected ?? return None
            }
            else -> jet_eval_task_host_projection(&machine, value, span) ?? return None
        }
        moved := index < move_permissions.len() && move_permissions[index]
        &output.push(JetEvalHostArgument{value: value, host: host, moved: moved})
        index += 1
    }
    Val(^output)
}

fn jet_eval_host_adapter_clone(machine: &JetEvalMachine, span: Span) -> JetEvalHostAdapter? {
    if machine.config.host_adapter == .Val(adapter) -> return Val(adapter.clone_adapter())
    jet_eval_unsupported(&machine, span, "MIR native host adapter is unavailable")
    None
}

fn jet_eval_poll_callbacks(machine: &JetEvalMachine, span: Span) -> Bool {
    if machine.config.host_adapter == None -> return true
    current :: jet_eval_host_adapter_clone(&machine, span) ?? return true
    if current.poll_callbacks(&machine) -> return true
    jet_eval_internal_problem(&machine, Val(span), "native callback polling failed")
    false
}

fn jet_eval_drain_callbacks(machine: &JetEvalMachine, span: Span) -> Bool {
    if machine.config.host_adapter == None -> return true
    current :: jet_eval_host_adapter_clone(&machine, span) ?? return true
    current.drain_callbacks(&machine)
}
// Every native boundary owns its argument list: the exchange borrows it and
// the boundary discharges each owned alias exactly once afterwards, whether
// or not the exchange produced a value.
fn jet_eval_discharge_boundary(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], result: JetEvalRuntimeValue?, span: Span) -> JetEvalRuntimeValue? {
    if jet_eval_drop_values(&machine, args, span) -> return ~result
    if result == {
        Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        None -> {}
    }
    None
}
fn jet_eval_discharge_call_boundary(machine: &JetEvalMachine, args: [JetEvalRuntimeValue], move_permissions: [Bool], result: JetEvalRuntimeValue?, span: Span) -> JetEvalRuntimeValue? {
    if jet_eval_drop_call_values(&machine, args, move_permissions, span) -> return ~result
    if result == {
        Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        None -> {}
    }
    None
}


fn jet_eval_host_target_exchange(machine: &JetEvalMachine, target: JetEvalHostCallTarget, args: [JetEvalRuntimeValue], result_ty: MIRType?, arg_shapes: [JetEvalHostTypeShape], move_permissions: [Bool], static_operand: JetEvalHostStaticOperand?, span: Span) -> JetEvalRuntimeValue? {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    host_args :: jet_eval_host_arguments(&machine, args, move_permissions, span) ?? return None
    reply :: adapter.host_call(&machine, target, static_operand, ^host_args, result_shape, arg_shapes, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR ambient route is unavailable to the canonical host adapter")
        return None
    }
    take_pattern_target := if target == {
        .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) -> true
        else -> false
    }
    effect_or_control := if reply.outcome == {
        .Effect(_, _, _) | .Control(_, _, _, _) -> true
        else -> false
    }
    if take_pattern_target && effect_or_control {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern host target returned an effect or control outcome")
        return None
    }
    route := MIRPreludeCall?{None}
    if target == .Prelude(row) -> route = Val(row)
    jet_eval_apply_host_reply(&machine, reply, route, args, move_permissions, result_ty, span)
}
fn jet_eval_host_row_exchange(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], result_ty: MIRType?, arg_shapes: [JetEvalHostTypeShape], move_permissions: [Bool], static_operand: JetEvalHostStaticOperand?, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_target_exchange(&machine, JetEvalHostCallTarget.Prelude{row: row}, args, result_ty, arg_shapes, move_permissions, static_operand, span)
}
fn jet_eval_host_static_row(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], result_ty: MIRType?, arg_shapes: [JetEvalHostTypeShape], move_permissions: [Bool], static_operand: JetEvalHostStaticOperand, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_row_exchange(&machine, row, args, result_ty, arg_shapes, move_permissions, Val(static_operand), span)
}

// Ambient host route exchange. `args` are BORROWED: the producing call site
// discharges them after this returns.
fn jet_eval_host_row_with_shapes(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], result_ty: MIRType?, arg_shapes: [JetEvalHostTypeShape], move_permissions: [Bool], span: Span) -> JetEvalRuntimeValue? {
    if jet_eval_shared_runtime_owns_row(row) -> return jet_eval_shared_runtime_route(&machine, row, args, [MIRType]{}, result_ty, span)
    jet_eval_host_row_exchange(&machine, row, args, result_ty, arg_shapes, move_permissions, None, span)
}


fn jet_eval_host_row_with_moves(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], result_ty: MIRType?, move_permissions: [Bool], span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_row_with_shapes(&machine, row, args, result_ty, [JetEvalHostTypeShape]{}, move_permissions, span)
}

fn jet_eval_host_row(machine: &JetEvalMachine, row: MIRPreludeCall, args: [JetEvalRuntimeValue], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_host_row_with_moves(&machine, row, args, result_ty, [Bool]{}, span)
}
fn jet_eval_foreign_row(machine: &JetEvalMachine, id: MIRForeignID, span: Span) -> MIRForeign? {
    row :: machine.rows.foreign.get(id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR foreign call ID has no canonical foreign row")
        return None
    }
    Val(machine.program.foreign[row])
}

fn jet_eval_handle_lifecycle(machine: JetEvalMachine, handle: MIRHandleID) -> MIRHandleLifecycle? {
    row :: machine.rows.handles.get(handle.value) ?? return None
    Val(machine.program.handles[row])
}

fn jet_eval_foreign_return_value(machine: &JetEvalMachine, row: MIRForeign, value: JetEvalRuntimeValue, span: Span) -> JetEvalRuntimeValue? {
    if row.handle == None && row.return_type == None {
        if value == .ForeignHandle(handle, raw, token) {
            if !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) -> return None
        }
        return Val(value)
    }
    if row.handle == None || row.return_type == None {
        jet_eval_compiler_fail(&machine, span, "MIR foreign handle return row has incomplete lifecycle facts")
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    handle :: row.handle ?? return None
    return_ty :: row.return_type ?? return None
    lifecycle_row :: machine.rows.handles.get(handle.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR foreign handle return row references a missing lifecycle")
        return None
    }
    lifecycle :: machine.program.handles[lifecycle_row].ty
    if !mir_type_same_checked_type(lifecycle, return_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR foreign handle return type disagrees with its lifecycle")
        return None
    }
    if value == .Data(data) {
        if data == .Int(raw) -> return Val(jet_eval_foreign_handle_new(machine, handle, raw))
    }
    if value == .ForeignHandle(result_handle, raw, token) {
        if result_handle == handle {
            if !jet_eval_foreign_handle_matches(&machine, result_handle, raw, token, span) -> return None
            return Val(JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token})
        }
        jet_eval_compiler_fail(&machine, span, "MIR foreign hook returned a handle with the wrong lifecycle")
        return None
    }
    jet_eval_compiler_fail(&machine, span, "MIR foreign handle call returned a non-integer native value")
    None
}


fn jet_eval_host_writeback_value(machine: &JetEvalMachine, target: JetEvalRuntimeValue, value: JetEvalRuntimeValue, span: Span) -> JetEvalRuntimeValue? {
    current := JetEvalRuntimeValue?{None}
    if target == {
        .Address(frame, place, _) -> current = jet_eval_read_place(&machine, frame, place, span)
        .SharedCell(cell, _) -> current = jet_eval_shared_read(&machine, cell, span)
        else -> {}
    }
    if current == None -> return Val(value)
    current_value :: current ?? return Val(value)
    if current_value == .ForeignHandle(handle, raw, token) {
        if value == .Data(data) {
            if data == .Int(returned_raw) {
                if returned_raw != raw {
                    jet_eval_drop_value(&machine, current_value, span)
                    jet_eval_drop_value(&machine, value, span)
                    jet_eval_ownership_fail(&machine, span, "MIR host writeback changed a live handle identity")
                    return None
                }
                if !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) {
                    jet_eval_drop_value(&machine, current_value, span)
                    jet_eval_drop_value(&machine, value, span)
                    return None
                }
                jet_eval_drop_value(&machine, value, span)
                return Val(current_value)
            }
        }
        if value == .ForeignHandle(returned_handle, returned_raw, returned_token) {
            if returned_handle != handle || returned_raw != raw || returned_token != token {
                jet_eval_drop_value(&machine, current_value, span)
                jet_eval_drop_value(&machine, value, span)
                jet_eval_ownership_fail(&machine, span, "MIR host writeback changed a live handle identity")
                return None
            }
            if !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) {
                jet_eval_drop_value(&machine, current_value, span)
                jet_eval_drop_value(&machine, value, span)
                return None
            }
            if !jet_eval_drop_value(&machine, value, span) {
                jet_eval_drop_value(&machine, current_value, span)
                return None
            }
            return Val(current_value)
        }
        jet_eval_drop_value(&machine, current_value, span)
        jet_eval_drop_value(&machine, value, span)
        jet_eval_compiler_fail(&machine, span, "MIR host handle writeback has an invalid carrier")
        return None
    }
    if !jet_eval_drop_value(&machine, current_value, span) {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    Val(value)
}

fn jet_eval_host_writebacks_discard_from(machine: &JetEvalMachine, writebacks: [JetEvalHostWriteback], start: Int, span: Span) -> Bool {
    pending := [JetEvalRuntimeValue]{}
    ok := true
    index := start
    loop index < writebacks.len() {
        if !jet_eval_owned_host_value_collect(&machine, writebacks[index].value, &pending, span) -> ok = false
        index += 1
    }
    loop alias in pending {
        if !jet_eval_drop_value(&machine, alias, span) -> ok = false
    }
    ok
}

// Stage all host aliases before adopting any writeback, just as aggregate
// cleanup does, but read directly through the writebacks rather than building
// an owned host List containing copies of their cleanup programs.
fn jet_eval_host_writebacks_adopt_cleanup(machine: &JetEvalMachine, writebacks: [JetEvalHostWriteback], span: Span) -> [JetEvalRuntimeValue]? {
    staged := [JetEvalRuntimeValue]{}
    stage_ok := true
    loop index in 0..<writebacks.len() {
        if !jet_eval_owned_host_value_collect(&machine, writebacks[index].value, &staged, span) -> stage_ok = false
    }
    adopted := [JetEvalRuntimeValue]{}
    adopted_ok := true
    index := 0
    loop index < writebacks.len() {
        nested := jet_eval_host_value_adopt_mode(&machine, None, None, writebacks[index].value, false, true, span)
        if nested == None {
            jet_eval_drop_adopted_prefix(&machine, adopted, span)
            adopted = [JetEvalRuntimeValue]{}
            adopted_ok = false
            index += 1
            loop index < writebacks.len() {
                jet_eval_owned_host_value_discard(&machine, writebacks[index].value, span)
                index += 1
            }
            break
        }
        value :: nested ?? JetEvalRuntimeValue.Moved
        &adopted.push(value)
        index += 1
    }
    staged_ok := true
    loop alias in staged {
        if !jet_eval_drop_value(&machine, alias, span) -> staged_ok = false
    }
    if !adopted_ok -> return None
    if stage_ok && staged_ok -> return Val(adopted)
    jet_eval_drop_values(&machine, adopted, span)
    None
}

fn jet_eval_host_writeback_target_writable(target: JetEvalRuntimeValue) -> Bool Never! {
    if target == {
        .Address(_, _, access) | .SharedCell(_, access) -> return access == MIRAccess.Write
        else -> return false
    }
    false
}

fn jet_eval_host_writebacks_from(machine: &JetEvalMachine, targets: [JetEvalRuntimeValue], writebacks: [JetEvalHostWriteback], first_writable: Int, span: Span) -> Bool {
    if first_writable < 0 || first_writable > targets.len() {
        jet_eval_compiler_fail(&machine, span, "MIR host call has an invalid first writable argument")
        jet_eval_host_writebacks_discard_from(&machine, writebacks, 0, span)
        return false
    }
    seen := [Bool]{}
    loop _ in targets -> &seen.push(false)
    valid := true
    loop writeback in writebacks {
        index := writeback.argument
        if index < 0 || index >= targets.len() {
            jet_eval_compiler_fail(&machine, span, "MIR host hook returned an invalid writable argument index")
            valid = false
            next
        }
        if seen[index] {
            jet_eval_compiler_fail(&machine, span, "MIR host hook returned duplicate writable argument writeback")
            valid = false
            next
        }
        seen[index] = true
        if index < first_writable {
            jet_eval_ownership_fail(&machine, span, "MIR host hook attempted to rewrite a protected receiver argument")
            valid = false
            next
        }
        if targets[index] == JetEvalRuntimeValue.Moved {
            jet_eval_ownership_fail(&machine, span, "MIR host hook returned a writeback for a moved argument")
            valid = false
            next
        }
        if !jet_eval_host_writeback_target_writable(targets[index]) {
            jet_eval_ownership_fail(&machine, span, "MIR host hook returned a writeback for a non-writable argument")
            valid = false
        }
    }
    index := first_writable
    loop index < targets.len() {
        if targets[index] != JetEvalRuntimeValue.Moved && jet_eval_host_writeback_target_writable(targets[index]) && !seen[index] {
            jet_eval_compiler_fail(&machine, span, "MIR host hook lost a writable argument writeback")
            valid = false
        }
        index += 1
    }
    if !valid {
        jet_eval_host_writebacks_discard_from(&machine, writebacks, 0, span)
        return false
    }
    adopted := jet_eval_host_writebacks_adopt_cleanup(&machine, writebacks, span) ?? return false
    index = 0
    loop index < writebacks.len() {
        value := adopted[index]
        adopted[index] = JetEvalRuntimeValue.Moved
        target := targets[writebacks[index].argument]
        replacement :: jet_eval_host_writeback_value(&machine, target, value, span) ?? {
            jet_eval_drop_values(&machine, adopted, span)
            return false
        }
        adopted[index] = replacement
        index += 1
    }
    index = 0
    loop index < writebacks.len() {
        replacement := adopted[index]
        adopted[index] = JetEvalRuntimeValue.Moved
        target := targets[writebacks[index].argument]
        written := if target == {
            .Address(frame, place, _) -> jet_eval_write_place(&machine, frame, place, replacement, span)
            .SharedCell(cell, access) -> jet_eval_shared_write(&machine, cell, access, replacement, span)
            else -> {
                jet_eval_drop_value(&machine, replacement, span)
                false
            }
        }
        if !written {
            jet_eval_drop_values(&machine, adopted, span)
            return false
        }
        index += 1
    }
    true
}

fn jet_eval_host_writebacks(machine: &JetEvalMachine, targets: [JetEvalRuntimeValue], writebacks: [JetEvalHostWriteback], span: Span) -> Bool {
    jet_eval_host_writebacks_from(&machine, targets, writebacks, 0, span)
}
// Physical close of a cursor/Core resource token. Called only by the owner of
// the last alias (the token is already marked closing); alias accounting never
// happens here.
fn jet_eval_resource_release(machine: &JetEvalMachine, handle: MIRHandleID, raw: Int, token: Int, span: Span) -> Bool {
    if !jet_eval_resource_handle_matches(&machine, handle, raw, token, span) -> return false
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return false
    reply :: adapter.handle_call(&machine, "resource_release", handle, raw, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR resource release is unavailable to the typed native handle adapter")
        return false
    }
    jet_eval_host_unit_reply(&machine, reply, "MIR resource release returned a committed source transfer", "MIR resource release returned a non-Unit value", span)
}
fn jet_eval_host_fixed_backing_release(machine: &JetEvalMachine, handle: MIRHandleID, raw: Int, lease: Int?, span: Span) -> Bool {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return false
    reply :: adapter.fixed_backing_release(&machine, handle, raw, lease, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR Fixed backing cleanup is unavailable to the typed host adapter")
        return false
    }
    jet_eval_host_unit_reply(&machine, reply, "MIR Fixed backing cleanup returned a committed source transfer", "MIR Fixed backing cleanup returned a non-Unit value", span)
}
fn jet_eval_fixed_backing_storage(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> JetEvalHostFixedBackingStorage? {
    if value == {
        .ForeignHandle(handle, raw, token) -> {
            meta :: jet_eval_foreign_token_meta(machine, token) ?? {
                jet_eval_ownership_fail(&machine, span, "MIR Fixed backing root has no evaluator token")
                return None
            }
            if meta.retired || meta.borrowed || meta.handle != handle || meta.raw != raw
                || !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) {
                jet_eval_ownership_fail(&machine, span, "MIR Fixed backing root alias is not live")
                return None
            }
            if meta.kind == {
                .FixedBackingRoot(element_type, length) -> {
                    element :: jet_eval_host_component_unwrap_type(machine, element_type, span) ?? return None
                    element_is_u8 := if element.kind == {
                        .IntN(signed, width) -> !signed && width == 8
                        else -> false
                    }
                    if !element_is_u8 || length <= 0 || length > machine.config.max_collection_len {
                        jet_eval_compiler_fail(&machine, span, "MIR Fixed backing token has an invalid checked U8 length")
                        return None
                    }
                    return Val(JetEvalHostFixedBackingStorage{
                        handle: handle,
                        raw: raw,
                        token: token,
                        element_type: element,
                        length: length,
                    })
                }
                else -> {
                    jet_eval_ownership_fail(&machine, span, "MIR value is not a canonical Fixed backing root")
                    return None
                }
            }
        }
        else -> {
            jet_eval_ownership_fail(&machine, span, "MIR Fixed backing access requires a canonical root handle")
            return None
        }
    }
}

fn jet_eval_fixed_backing_bytes_valid(values: [Int], length: Int) -> Bool Never! {
    if values.len() != length -> return false
    loop value in values {
        if value < 0 || value > 255 -> return false
    }
    true
}

fn jet_eval_fixed_backing_access(machine: &JetEvalMachine, root_value: JetEvalRuntimeValue, operation: JetEvalHostFixedBackingOperation, span: Span) -> JetEvalHostFixedBackingAccessResult? {
    root :: jet_eval_fixed_backing_storage(&machine, root_value, span) ?? return None
    if operation == {
        .Write(_, value) -> {
            if value < 0 || value > 255 {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed backing write is outside its checked U8 element type")
                return None
            }
        }
        else -> {}
    }
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    result :: adapter.fixed_backing_access(&machine, root, operation, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR Fixed backing access is unavailable to the typed host adapter")
        return None
    }
    valid := if operation == {
        .Read(_) -> {
            if result == {
                .Byte(value) -> value >= 0 && value <= 255
                .OutOfBounds | .Uninitialized -> true
                else -> false
            }
        }
        .Write(_, _) -> {
            if result == {
                .Unit -> true
                .OutOfBounds -> true
                else -> false
            }
        }
        .ReadArray | .TakeArray -> {
            if result == {
                .Bytes(values) -> jet_eval_fixed_backing_bytes_valid(values, root.length)
                .Uninitialized -> true
                else -> false
            }
        }
    }
    if !valid {
        jet_eval_compiler_fail(&machine, span, "native Fixed backing access returned a value inconsistent with its typed operation")
        return None
    }
    Val(result)
}


fn jet_eval_fixed_backing_array(machine: &JetEvalMachine, root_value: JetEvalRuntimeValue, take_array: Bool, span: Span) -> JetEvalRuntimeValue? {
    operation := if take_array -> JetEvalHostFixedBackingOperation.TakeArray else -> JetEvalHostFixedBackingOperation.ReadArray
    result :: jet_eval_fixed_backing_access(&machine, root_value, operation, span) ?? return None
    if result == {
        .Bytes(values) -> {
            output := [JetEvalRuntimeValue]{}
            loop value in values -> &output.push(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: value}})
            return Val(JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: output}})
        }
        .Uninitialized -> {
            message := if take_array -> "fixed list moved before every element was initialized" else -> "fixed list read before every element was initialized"
            jet_eval_source_fail(&machine, span, message)
            return None
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "native Fixed backing array access returned an invalid result")
            return None
        }
    }
}

fn jet_eval_close_foreign_lifecycle(machine: &JetEvalMachine, lifecycle: MIRHandleLifecycle?, kind: JetEvalForeignTokenKind, handle: MIRHandleID, raw: Int, token: Int, span: Span) -> Bool {
    // A native binding carrier has no MIR lifecycle row: its physical lifetime
    // is the retained binding scope, released through the typed handle adapter.
    if kind == .FixedBackingRoot(_, _) -> return jet_eval_host_fixed_backing_release(&machine, handle, raw, None, span)
    if kind == .Native(_) {
        adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return false
        reply :: adapter.handle_call(&machine, "native_binding_release", handle, raw, span) ?? {
            jet_eval_unsupported(&machine, span, "MIR native binding release is unavailable to the typed native handle adapter")
            return false
        }
        return jet_eval_host_unit_reply(&machine, reply, "MIR native binding release returned a committed source transfer", "MIR native binding release returned a non-Unit value", span)
    }
    row :: lifecycle ?? {
        jet_eval_compiler_fail(&machine, span, "MIR foreign handle has no lifecycle row")
        return false
    }
    if kind == .Declared(declared_ty) {
        if !mir_type_same_checked_type(row.ty, declared_ty) {
            jet_eval_compiler_fail(&machine, span, "MIR declared host handle token type disagrees with its lifecycle")
            return false
        }
        if row.payload.close == "" {
            jet_eval_compiler_fail(&machine, span, "MIR declared host handle has no checked close member")
            return false
        }
        return jet_eval_host_handle_release(&machine, row, handle, raw, span)
    }
    if row.close_foreign == None && row.close == None {
        if row.ownership == MIRHandleOwnership.Owned {
            jet_eval_compiler_fail(&machine, span, "MIR owned foreign handle has no checked close path")
            return false
        }
        return true
    }
    if row.close_foreign != None {
        close_id :: row.close_foreign ?? return false
        close_row :: jet_eval_foreign_row(&machine, close_id, span) ?? return false
        adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return false
        close_args :: jet_eval_host_arguments(&machine, [JetEvalRuntimeValue]{JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token}}, [Bool]{true}, span) ?? return false
        reply :: adapter.foreign_call(&machine, close_row, ^close_args, span) ?? {
            jet_eval_unsupported(&machine, span, "MIR foreign handle close is unavailable to the canonical host adapter")
            return false
        }
        return jet_eval_host_unit_reply(&machine, reply, "MIR foreign handle close returned a committed source transfer", "MIR foreign handle close returned a non-Unit value", span)
    }
    close_function :: row.close ?? return false
    // The Source closer receives one lent alias; discharging it inside the
    // closer resolves to Detached because the token is already closing.
    if !jet_eval_foreign_token_lend_closer(&machine, token, span) -> return false
    _ :: jet_eval_invoke(&machine, close_function, [JetEvalRuntimeValue]{JetEvalRuntimeValue.ForeignHandle{handle: handle, raw: raw, token: token}}, [JetEvalRuntimeValue]{}, span) ?? return false
    true
}

fn jet_eval_close_foreign_value(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .Result(_, nested) | .RuntimeFailure(nested, _) -> return jet_eval_drop_value(&machine, nested, span)
        .Aggregate(aggregate) -> {
            ok := true
            if aggregate == {
                .List(values) -> loop item in values { if !jet_eval_drop_value(&machine, item, span) -> ok = false }
                .Map(entries) -> loop entry in entries {
                    if !jet_eval_drop_value(&machine, entry.key, span) -> ok = false
                    if !jet_eval_drop_value(&machine, entry.value, span) -> ok = false
                }
                .Struct(_, fields) -> loop field in fields { if !jet_eval_drop_value(&machine, field.value, span) -> ok = false }
                .Enum(_, _, args) -> loop arg in args { if !jet_eval_drop_value(&machine, arg.value, span) -> ok = false }
            }
            return ok
        }
        .Closure(_, captures) | .Stream(_, _, _, captures) -> {
            ok := true
            loop capture in captures {
                if !jet_eval_drop_value(&machine, capture, span) -> ok = false
            }
            return ok
        }
        .HostCursor(inner, _, _, _) -> {
            if inner == {
                .ForeignHandle(handle, raw, token) -> {
                    if !jet_eval_cursor_handle_matches(&machine, handle, raw, token, span) -> return false
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR host cursor carries a non-native cursor value")
                    return false
                }
            }
            return jet_eval_drop_value(&machine, inner, span)
        }
        .SharedCell(index, _) -> {
            release :: jet_eval_shared_cell_release(&machine, index, span) ?? return false
            if release != JetEvalAliasRelease.Last -> return true
            payload := jet_eval_shared_cell_take_payload(machine, index)
            return jet_eval_drop_value(&machine, payload, span)
        }
        .Shared(_) | .SharedWeak(_) | .SharedGuard(_) | .SharedSnapshot(_) | .Condition(_) -> return jet_eval_shared_runtime_release(&machine, value, span)
        .ForeignHandle(handle, raw, token) -> {
            release :: jet_eval_foreign_token_release(&machine, token, span) ?? return false
            if release != JetEvalAliasRelease.Last -> return true
            token_kind :: jet_eval_foreign_token_kind(machine, token) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR foreign handle carries an unknown evaluator token")
                return false
            }
            if jet_eval_foreign_token_is_borrowed(machine, token) {
                payload := jet_eval_foreign_token_take_payload(machine, token)
                payload_ok := jet_eval_drop_borrowed_value(machine, payload, span)
                jet_eval_foreign_handle_retire(machine, token)
                return payload_ok
            }
            physical_ok := true
            if {
                !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) -> {
                    physical_ok = false
                }
                jet_eval_resource_token_kind(token_kind) -> {
                    physical_ok = jet_eval_resource_release(&machine, handle, raw, token, span)
                }
                else -> {
                    lifecycle := jet_eval_handle_lifecycle(machine, handle)
                    physical_ok = jet_eval_close_foreign_lifecycle(&machine, lifecycle, token_kind, handle, raw, token, span)
                }
            }
            payload := jet_eval_foreign_token_take_payload(machine, token)
            payload_ok := jet_eval_drop_value(&machine, payload, span)
            jet_eval_foreign_handle_retire(machine, token)
            return physical_ok && payload_ok
        }
        else -> {}
    }
    true
}
// A foreign close row consumes the handle it receives: the token's physical
// ownership ends there, and the argument alias resolves to Detached when the
// call boundary discharges it.
fn jet_eval_retire_foreign_close_result(machine: &JetEvalMachine, row: MIRForeign, args: [JetEvalRuntimeValue], span: Span) -> Bool {
    ok := true
    loop index in 0..<machine.program.handles.len() {
        close_id :: machine.program.handles[index].close_foreign ?? next
        if close_id != row.id -> next
        lifecycle_id :: machine.program.handles[index].id
        loop value in args {
            if value == .ForeignHandle(handle, _, token) {
                if handle == lifecycle_id {
                    if !jet_eval_foreign_handle_transfer_retire(&machine, token, span) -> ok = false
                }
            }
        }
    }
    ok
}



// Exchange with the native foreign adapter. `host_args` are borrowed here;
// the caller discharges them after the reply is applied.
fn jet_eval_foreign_call_exchange(machine: &JetEvalMachine, row: MIRForeign, host_args: [JetEvalRuntimeValue], targets: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    move_permissions := [Bool]{}
    loop parameter in row.params -> &move_permissions.push(parameter.access == MIRAccess.Move)
    callback_args :: jet_eval_host_arguments(&machine, host_args, move_permissions, span) ?? return None
    reply :: adapter.foreign_call(&machine, row, ^callback_args, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR foreign call is unavailable to the canonical host adapter")
        return None
    }
    if !jet_eval_validate_host_transfers(&machine, reply.transfers, host_args, move_permissions, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_retire_foreign_close_result(&machine, row, host_args, span)
        return None
    }
    if !jet_eval_retire_host_transfers(&machine, reply.transfers, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_retire_foreign_close_result(&machine, row, host_args, span)
        return None
    }
    held := [JetEvalRuntimeValue]{}
    if !jet_eval_host_outcome_collect(&machine, reply.outcome, &held, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_retire_foreign_close_result(&machine, row, host_args, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    writebacks_ok := jet_eval_host_writebacks(&machine, targets, reply.writebacks, span)
    close_ok := jet_eval_retire_foreign_close_result(&machine, row, host_args, span)
    if !writebacks_ok || !close_ok {
        jet_eval_host_outcome_discard(&machine, reply.outcome, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    result := jet_eval_apply_host_outcome(&machine, reply.outcome, None, row.return_type, span)
    if !jet_eval_host_outcome_release(&machine, ^held, span) {
        if result == .Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        return None
    }
    produced :: result ?? return None
    jet_eval_foreign_return_value(&machine, row, produced, span)
}

// Foreign call boundary. `values` are owned call arguments: plain values move
// into the host argument list, address and shared-cell carriers are read
// through, and every owned alias on both lists is discharged exactly once
// after the exchange (transferred or closed handles resolve as Detached).
fn jet_eval_foreign_call(machine: &JetEvalMachine, frame_index: Int, id: MIRForeignID, args: [MIRCallArg], values: [JetEvalRuntimeValue], span: Span) -> JetEvalRuntimeValue? {
    carriers := values
    move_permissions := [Bool]{}
    loop argument in args -> &move_permissions.push(argument.access == MIRAccess.Move)
    row :: jet_eval_foreign_row(&machine, id, span) ?? {
        jet_eval_drop_call_values(&machine, carriers, move_permissions, span)
        return None
    }
    if !row.target_applicability.interpreter {
        jet_eval_unsupported(&machine, row.span, "foreign call is disabled for the interpreter target")
        jet_eval_drop_call_values(&machine, carriers, move_permissions, span)
        return None
    }
    if args.len() != row.params.len() || values.len() != row.params.len() {
        jet_eval_compiler_fail(&machine, span, "MIR foreign call argument count disagrees with its canonical row")
        jet_eval_drop_call_values(&machine, carriers, move_permissions, span)
        return None
    }
    host_args := [JetEvalRuntimeValue]{}
    host_args_owned := [Bool]{}
    targets := [JetEvalRuntimeValue]{}
    index := 0
    prepared := true
    loop index < args.len() && prepared {
        value := carriers[index]
        target := JetEvalRuntimeValue.Moved
        if {
            args[index].access != row.params[index].access -> {
                jet_eval_compiler_fail(&machine, span, "MIR foreign call argument access disagrees with its canonical row")
                prepared = false
            }
            else -> {
                if value == {
                    .Address(target_frame, target_place, access) -> {
                        if {
                            access == MIRAccess.Move -> {
                                jet_eval_ownership_fail(&machine, span, "MIR foreign call uses a move-only address")
                                prepared = false
                            }
                            row.params[index].access == MIRAccess.Write && access != MIRAccess.Write -> {
                                jet_eval_ownership_fail(&machine, span, "MIR foreign write parameter is not writable")
                                prepared = false
                            }
                            else -> {
                                materialized := jet_eval_read_place(&machine, target_frame, target_place, span)
                                if materialized == {
                                    Val(read) -> {
                                        &host_args.push(read)
                                        &host_args_owned.push(true)
                                        if row.params[index].access == MIRAccess.Write -> target = value
                                    }
                                    None -> prepared = false
                                }
                            }
                        }
                    }
                    .SharedCell(cell, access) -> {
                        if {
                            access == MIRAccess.Move -> {
                                jet_eval_ownership_fail(&machine, span, "MIR foreign call uses a move-only shared capture cell")
                                prepared = false
                            }
                            row.params[index].access == MIRAccess.Write && access != MIRAccess.Write -> {
                                jet_eval_ownership_fail(&machine, span, "MIR foreign write parameter is not writable")
                                prepared = false
                            }
                            else -> {
                                materialized := jet_eval_shared_read(&machine, cell, span)
                                if materialized == {
                                    Val(read) -> {
                                        &host_args.push(read)
                                        &host_args_owned.push(true)
                                        if row.params[index].access == MIRAccess.Write -> target = value
                                    }
                                    None -> prepared = false
                                }
                            }
                        }
                    }
                    else -> {
                        if {
                            row.params[index].access == MIRAccess.Write -> {
                                jet_eval_compiler_fail(&machine, span, "MIR foreign write parameter has no evaluator address carrier")
                                prepared = false
                            }
                            else -> {
                                &host_args.push(value)
                                carriers[index] = JetEvalRuntimeValue.Moved
                                &host_args_owned.push(args[index].access == MIRAccess.Move)
                            }
                        }
                    }
                }
            }
        }
        if prepared {
            &targets.push(target)
            index += 1
        }
    }
    result := JetEvalRuntimeValue?{None}
    if prepared -> result = jet_eval_foreign_call_exchange(&machine, row, host_args, targets, span)
    discharged := jet_eval_drop_call_values(&machine, host_args, host_args_owned, span)
    if !jet_eval_drop_call_values(&machine, carriers, move_permissions, span) -> discharged = false
    if !discharged {
        if result == {
            Val(produced) -> jet_eval_drop_value(&machine, produced, span)
            None -> {}
        }
        return None
    }
    result
}


fn jet_eval_host_handle_method(machine: &JetEvalMachine, frame_index: Int, row: MIRPreludeCall, receiver: MIRValueID, args: [MIRValueID], frame_schedule: MIRFrameSchedule?, frame_schedule_derivation: MIRDerivationRef?, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if row.family != MIRPreludeFamily.HandleMethod || row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR handle method has a non-canonical host route")
        return None
    }
    db_query := row.module_name == "core.handle" && (row.member == "query" || row.member == "query_one" || row.member == "execute")
    static_operand := JetEvalHostStaticOperand?{None}
    if {
        db_query -> {
            expected_symbol := if {
                row.member == "query" -> "jet_db_scope_query_with_metadata"
                row.member == "query_one" -> "jet_db_scope_query_one_with_metadata"
                else -> "jet_db_scope_execute_with_metadata"
            }
            if mir_symbol_name(row.symbol) != expected_symbol
                || row.effect_kind != (Val(Effect.DB))
                || row.signature.arity != 3
                || row.signature.max_arity != 3
                || row.signature.borrow_mask.len() != 3 {
                jet_eval_compiler_fail(&machine, span, "MIR database query route has non-canonical handle metadata")
                return None
            }
            loop borrowed in row.signature.borrow_mask {
                if !borrowed {
                    jet_eval_compiler_fail(&machine, span, "MIR database query route has non-canonical ownership metadata")
                    return None
                }
            }
            if frame_schedule != None || frame_schedule_derivation != None {
                jet_eval_compiler_fail(&machine, span, "MIR database query route carries unrelated frame schedule metadata")
                return None
            }
            static_operand = Val(JetEvalHostStaticOperand.DBQuery{metadata: row.db_metadata})
        }
        else -> {
            if row.db_metadata != None {
                jet_eval_compiler_fail(&machine, span, "MIR non-database handle method carries database query metadata")
                return None
            }
            if frame_schedule != None || frame_schedule_derivation != None || !jet_eval_shared_runtime_owns_row(row) {
                static_operand = Val(JetEvalHostStaticOperand.HandleMethodSchedule{frame_schedule: frame_schedule, frame_schedule_derivation: frame_schedule_derivation})
            }
        }
    }
    // `Path.home()` is receiver-free: the TIR handle method carries a Unit
    // placeholder receiver the nullary Prelude row never takes.
    if row.member == "path.home" {
        if args.len() > 0 {
            jet_eval_compiler_fail(&machine, span, "MIR path.home handle method received unexpected arguments")
            return None
        }
        if static_operand == None -> return jet_eval_host_row_with_shapes(&machine, row, [JetEvalRuntimeValue]{}, result_ty, [JetEvalHostTypeShape]{}, [Bool]{}, span)
        return jet_eval_host_row_exchange(&machine, row, [JetEvalRuntimeValue]{}, result_ty, [JetEvalHostTypeShape]{}, [Bool]{}, static_operand, span)
    }
    dynamic_arity := args.len() + 1
    expected_arity := dynamic_arity
    if db_query -> expected_arity += 1
    if row.signature.arity != expected_arity || row.signature.max_arity != expected_arity || row.signature.borrow_mask.len() != expected_arity {
        jet_eval_compiler_fail(&machine, span, "MIR handle method signature disagrees with its checked route")
        return None
    }
    values := [JetEvalRuntimeValue]{}
    temporary_owned := [Bool]{}
    receiver_value :: jet_eval_value(&machine, frame_index, receiver, span) ?? return None
    &values.push(receiver_value)
    &temporary_owned.push(machine.frames[frame_index].borrowed_values.get(receiver.value) != (Val(true)))
    arg_shapes := [JetEvalHostTypeShape]{}
    receiver_ty :: jet_eval_value_type(&machine, frame_index, receiver, span) ?? {
        jet_eval_drop_call_values(&machine, values, temporary_owned, span)
        return None
    }
    &arg_shapes.push(jet_eval_host_type_shape(&machine, Val(receiver_ty), span) ?? {
        jet_eval_drop_call_values(&machine, values, temporary_owned, span)
        return None
    })
    loop argument in args {
        argument_value := jet_eval_value(&machine, frame_index, argument, span)
        if argument_value == None {
            jet_eval_drop_call_values(&machine, values, temporary_owned, span)
            return None
        }
        &values.push(argument_value ?? JetEvalRuntimeValue.Moved)
        &temporary_owned.push(machine.frames[frame_index].borrowed_values.get(argument.value) != (Val(true)))
        argument_ty :: jet_eval_value_type(&machine, frame_index, argument, span) ?? {
            jet_eval_drop_call_values(&machine, values, temporary_owned, span)
            return None
        }
        &arg_shapes.push(jet_eval_host_type_shape(&machine, Val(argument_ty), span) ?? {
            jet_eval_drop_call_values(&machine, values, temporary_owned, span)
            return None
        })
    }
    move_permissions := [Bool]{}
    loop index in 0..<values.len() -> &move_permissions.push(!row.signature.borrow_mask[index])
    result := if {
        static_operand == None -> {
            jet_eval_host_row_with_shapes(&machine, row, values, result_ty, arg_shapes, move_permissions, span)
        }
        else -> {
            jet_eval_host_row_exchange(&machine, row, values, result_ty, arg_shapes, move_permissions, static_operand, span)
        }
    }
    jet_eval_discharge_call_boundary(&machine, values, temporary_owned, result, span)
}

fn jet_eval_host_call(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, args: [MIRCallArg], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
    values := prepared.values
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR host call frame function is unavailable")
        jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
        return None
    }
    arg_shapes := [JetEvalHostTypeShape]{}
    move_permissions := prepared.move_permissions
    loop call_arg in args {
        fact := MIRType?{None}
        loop index in 0..<machine.program.functions[function].values.len() {
            if machine.program.functions[function].values[index].id == call_arg.value -> fact = Val(machine.program.functions[function].values[index].ty)
        }
        argument_ty :: fact ?? {
            jet_eval_compiler_fail(&machine, span, "MIR host call argument has no checked type fact")
            jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
            return None
        }
        &arg_shapes.push(jet_eval_host_type_shape(&machine, Val(argument_ty), span) ?? {
            jet_eval_drop_call_values(&machine, values, prepared.move_permissions, span)
            return None
        })
    }
    result := jet_eval_host_row_with_shapes(&machine, row, values, result_ty, arg_shapes, move_permissions, span)
    jet_eval_discharge_call_boundary(&machine, values, prepared.move_permissions, result, span)
}
fn jet_eval_semantic_values_prepared(machine: &JetEvalMachine, frame_index: Int, values: [MIRValueID], span: Span) -> JetEvalPreparedValues? {
    output := [JetEvalRuntimeValue]{}
    owned := [Bool]{}
    loop value in values {
        adopted := jet_eval_value(&machine, frame_index, value, span)
        if adopted == None {
            jet_eval_drop_call_values(&machine, output, owned, span)
            return None
        }
        &output.push(adopted ?? JetEvalRuntimeValue.Moved)
        &owned.push(machine.frames[frame_index].borrowed_values.get(value.value) != (Val(true)))
    }
    Val(JetEvalPreparedValues{values: output, owned: owned})
}
fn jet_eval_pattern_result_shape_valid(machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> Bool Never! {
    checked :: result_ty ?? {
        jet_eval_compiler_fail(&machine, span, "MIR pattern match has no result type fact")
        return false
    }
    tuple_type := if checked.kind == {
        .Option(inner) -> inner
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR pattern match result is not an Option")
            return false
        }
    }
    tuple_payload := if tuple_type.kind == {
        .Tuple(_) -> true
        else -> false
    }
    if !tuple_payload {
        jet_eval_compiler_fail(&machine, span, "MIR pattern match result Option payload is not a typed tuple")
        return false
    }
    true
}

fn jet_eval_semantic_pattern_match(
    machine: &JetEvalMachine,
    frame_index: Int,
    call: MIRPreludeCallID,
    subject: MIRValueID,
    pattern: JetEvalHostStaticOperand,
    member: String,
    symbol: String,
    binary: Bool,
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    pattern_kind :: if binary -> "binary" else -> "text"
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.pattern" || row.member != member || mir_symbol_name(row.symbol) != symbol || row.signature.arity != 2 || row.signature.max_arity != 2 || row.signature.borrow_mask.len() != 2 || !row.signature.borrow_mask[0] || row.signature.borrow_mask[1] || row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR {pattern_kind} pattern route has non-canonical Prelude metadata")
        return None
    }
    if !jet_eval_pattern_result_shape_valid(&machine, result_ty, span) -> return None
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, [MIRValueID]{subject}, span) ?? return None
    subject_data_result := jet_eval_data(prepared.values[0], &machine, span)
    if subject_data_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    subject_data := subject_data_result ?? TComptimeValue.Unit
    // A `[U8]` subject is a Bytes carrier or a list of U8 items.
    if binary && subject_data == .List(_) {
        bytes :: jet_eval_byte_list(subject_data) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR binary pattern subject has a non-U8 item")
            jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
            return None
        }
        subject_data = TComptimeValue.Bytes{value: bytes}
    }
    subject_matches := if {
        binary -> {
            if subject_data == {.Bytes(_) -> true else -> false}
        }
        else -> {
            if subject_data == {.String(_) -> true else -> false}
        }
    }
    if !subject_matches {
        expected :: if binary -> "Bytes" else -> "String"
        jet_eval_compiler_fail(&machine, span, "MIR {pattern_kind} pattern subject is not {expected}")
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    result := jet_eval_host_static_row(&machine, row, [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: subject_data}}, result_ty, [JetEvalHostTypeShape]{}, [Bool]{false}, pattern, span)
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}

fn jet_eval_byte_list(value: TComptimeValue) -> [U8]? {
    bytes := [U8]{}
    if value == .List(items) {
        loop item in items {
            if item == .Int(number) {
                if number >= 0 && number <= 255 {
                    &bytes.push(U8{number})
                    next
                }
            }
            return None
        }
    }
    Val(bytes)
}
fn jet_eval_take_pattern_result_shape_valid(machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> Bool Never! {
    checked :: result_ty ?? {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern operation has no result type fact")
        return false
    }
    tuple_type := if checked.kind == {
        .Result(inner, _) -> inner
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR take-pattern result is not a Result")
            return false
        }
    }
    tuple_payload := if tuple_type.kind == {
        .Tuple(_) -> true
        else -> false
    }
    if !tuple_payload {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern Result payload is not a typed tuple")
        return false
    }
    true
}

fn jet_eval_host_take_pattern(
    machine: &JetEvalMachine,
    frame_index: Int,
    receiver: MIRValueID,
    receiver_place: MIRPlaceID,
    target: JetEvalHostCallTarget,
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    if !jet_eval_take_pattern_result_shape_valid(&machine, result_ty, span) -> return None
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern frame function is unavailable")
        return None
    }
    place :: jet_eval_function_place(machine, function, receiver_place) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern receiver place is unavailable")
        return None
    }
    if place.access != MIRAccess.Write {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern receiver place is not writable")
        return None
    }
    receiver_ty :: jet_eval_value_type(&machine, frame_index, receiver, span) ?? return None
    if !mir_type_same_checked_type(place.ty, receiver_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR take-pattern receiver value disagrees with its writable place")
        return None
    }
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, [MIRValueID]{receiver}, span) ?? return None
    receiver_shape_result := jet_eval_host_type_shape(&machine, Val(receiver_ty), span)
    if receiver_shape_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    receiver_shape :: receiver_shape_result ?? return None
    result := jet_eval_host_target_exchange(
        &machine,
        target,
        [JetEvalRuntimeValue]{prepared.values[0]},
        result_ty,
        [JetEvalHostTypeShape]{receiver_shape},
        [Bool]{false},
        None,
        span,
    )
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}
fn jet_eval_host_semantic_arg_shapes(machine: &JetEvalMachine, frame_index: Int, values: [MIRValueID], span: Span) -> [JetEvalHostTypeShape]? {
    shapes := [JetEvalHostTypeShape]{}
    loop value in values {
        ty :: jet_eval_value_type(&machine, frame_index, value, span) ?? return None
        shape :: jet_eval_host_type_shape(&machine, Val(ty), span) ?? return None
        &shapes.push(shape)
    }
    Val(shapes)
}

fn jet_eval_host_component_unwrap_type(machine: JetEvalMachine, ty: MIRType, span: Span) -> MIRType? {
    if ty.kind == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return jet_eval_host_component_unwrap_type(machine, inner, span)
        .Apply(name, _) -> {
            row :: machine.rows.types.get(name.id.value) ?? return Val(ty)
            if machine.program.types[row].kind == .Alias(target) -> return jet_eval_host_component_unwrap_type(machine, target, span)
            return Val(ty)
        }
        else -> return Val(ty)
    }
}

fn jet_eval_host_plugin_result_valid(machine: &JetEvalMachine, result_ty: MIRType?, span: Span) -> Bool Never! {
    checked :: result_ty ?? {
        jet_eval_compiler_fail(&machine, span, "MIR plugin invocation has no checked result type")
        return false
    }
    error_ty := if checked.kind == {
        .Result(_, error) -> error
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR plugin invocation result is not a checked Result")
            return false
        }
    }
    error :: jet_eval_host_component_unwrap_type(machine, error_ty, span) ?? return false
    error_is_string := if error.kind == {
        .String -> true
        else -> false
    }
    if !error_is_string {
        jet_eval_compiler_fail(&machine, span, "MIR plugin invocation Result error is not checked String")
        return false
    }
    true
}

fn jet_eval_host_plugin_invoke(
    machine: &JetEvalMachine,
    frame_index: Int,
    call: MIRPreludeCallID,
    handle: MIRValueID,
    export_name: String,
    signature: MIRComponentSignatureDescriptor,
    args: [MIRValueID],
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if row.family != MIRPreludeFamily.HandleMethod
        || row.module_name != "core.handle"
        || row.member != "plugin.invoke"
        || mir_symbol_name(row.symbol) != "jet_plugin_call"
        || row.signature.arity != 3
        || row.signature.max_arity != 3
        || row.signature.borrow_mask != ([Bool]{true, true, true})
        || row.effect_kind != (Val(Effect.FFI))
        || row.authority != (Val(mir_authority_plugin_call()))
        || row.db_metadata != None
        || row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR plugin invocation has non-canonical host route metadata")
        return None
    }
    if signature.params.len() != args.len() {
        jet_eval_compiler_fail(&machine, span, "MIR plugin invocation parameters disagree with its checked Component signature")
        return None
    }
    if !jet_eval_host_plugin_result_valid(&machine, result_ty, span) -> return None
    values := [MIRValueID]{handle}
    loop argument in args -> &values.push(argument)
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, values, span) ?? return None
    shape_result := jet_eval_host_semantic_arg_shapes(&machine, frame_index, values, span)
    if shape_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    shapes :: shape_result ?? return None
    move_permissions := [Bool]{}
    loop _ in prepared.values -> &move_permissions.push(false)
    // The route has three logical borrowed slots: handle, export name, and
    // packed parameters. Each Component parameter remains a separate physical
    // host argument; signature.params defines the exact packed-list boundary.
    result := jet_eval_host_row_exchange(
        &machine,
        row,
        prepared.values,
        result_ty,
        shapes,
        move_permissions,
        Val(JetEvalHostStaticOperand.PluginInvoke{export_name: export_name, signature: signature}),
        span,
    )
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}

fn jet_eval_host_nominal_type_name(ty: MIRType) -> String? {
    if ty.kind == {
        .Tagged(_, inner) -> return jet_eval_host_nominal_type_name(inner)
        .Apply(name, _) -> return Val(name.name)
        else -> return None
    }
}

fn jet_eval_host_http_callback_root(
    machine: &JetEvalMachine,
    closure: JetEvalRuntimeValue,
    span: Span,
) -> Int? {
    if !jet_eval_callback_validate_root(&machine, closure, true, span) -> return None
    retained :: jet_eval_copy_value(closure, &machine, span) ?? return None
    jet_eval_callback_root_insert(&machine, ^retained, true, span)
}

fn jet_eval_host_http_registration_succeeded(
    machine: &JetEvalMachine,
    result: JetEvalRuntimeValue?,
    result_ty: MIRType?,
    span: Span,
) -> Bool Never! {
    value :: result ?? return false
    if value == .RuntimeFailure(_, _) -> return false
    checked_is_result := false
    if result_ty != None {
        checked :: result_ty
        unwrapped :: jet_eval_host_component_unwrap_type(machine, checked, span) ?? return false
        if unwrapped.kind == .Result(_, _) -> checked_is_result = true
    }
    if checked_is_result {
        if value == .Result(ok, _) -> return ok
        if value == .Data(data) {
            if data == .Present(_) -> return true
            return false
        }
        return false
    }
    if value == .Result(ok, _) -> return ok
    if value == .Data(data) {
        if data == .Failed(_) -> return false
    }
    true
}

fn jet_eval_host_http_callback_exchange(
    machine: &JetEvalMachine,
    row: MIRPreludeCall,
    args: [JetEvalRuntimeValue],
    host_args: ^[JetEvalHostArgument],
    result_ty: MIRType?,
    arg_shapes: [JetEvalHostTypeShape],
    move_permissions: [Bool],
    static_operand: JetEvalHostStaticOperand,
    lease: Int,
    span: Span,
) -> JetEvalHostCallbackExchange {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return JetEvalHostCallbackExchange{result: None, adopted: false}
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return JetEvalHostCallbackExchange{result: None, adopted: false})
    reply :: adapter.host_call(&machine, JetEvalHostCallTarget.Prelude{row: row}, Val(static_operand), ^host_args, result_shape, arg_shapes, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR ambient route is unavailable to the canonical host adapter")
        return JetEvalHostCallbackExchange{result: None, adopted: false}
    }
    callback_acknowledged := reply.callback_transfers.len() == 1
    callback_reply_valid := reply.callback_transfers.len() == 0
        || (callback_acknowledged
            && reply.callback_transfers[0].argument == 2
            && reply.callback_transfers[0].lease == lease)
    result := jet_eval_apply_host_reply(&machine, reply, Val(row), args, move_permissions, result_ty, span)
    if !callback_reply_valid {
        if result == .Val(value) -> jet_eval_drop_value(&machine, value, span)
        jet_eval_compiler_fail(&machine, span, "HTTP route registration callback receipt does not name its exact handler argument and lease")
        return JetEvalHostCallbackExchange{result: None, adopted: false}
    }
    succeeded := jet_eval_host_http_registration_succeeded(&machine, result, result_ty, span)
    if callback_acknowledged {
        if !succeeded {
            if result == .Val(value) -> jet_eval_drop_value(&machine, value, span)
            jet_eval_compiler_fail(&machine, span, "HTTP route registration acknowledged callback adoption without a successful result")
            return JetEvalHostCallbackExchange{result: None, adopted: false}
        }
        return JetEvalHostCallbackExchange{result: result, adopted: true}
    }
    if succeeded {
        if result == .Val(value) -> jet_eval_drop_value(&machine, value, span)
        jet_eval_compiler_fail(&machine, span, "HTTP route registration succeeded without acknowledging callback adoption")
        return JetEvalHostCallbackExchange{result: None, adopted: false}
    }
    JetEvalHostCallbackExchange{result: result, adopted: false}
}

fn jet_eval_host_http_router_register(
    machine: &JetEvalMachine,
    frame_index: Int,
    call: MIRPreludeCallID,
    receiver: MIRValueID,
    path: MIRValueID,
    handler: MIRValueID,
    method: MIRHTTPMethod,
    handler_param_names: [String],
    contract_json: String,
    location: MIRPanicLoc,
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    receiver_ty :: jet_eval_value_type(&machine, frame_index, receiver, span) ?? return None
    receiver_name :: jet_eval_host_nominal_type_name(receiver_ty) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR HTTP router receiver has no checked nominal type")
        return None
    }
    is_mux := receiver_name == "HTTPMux"
    is_router := receiver_name == "HTTPRouter"
    if !is_mux && !is_router {
        jet_eval_compiler_fail(&machine, span, "MIR HTTP route receiver is not a checked HTTPMux or HTTPRouter")
        return None
    }
    expected_member := if {
        is_router -> "router_register"
        handler_param_names.len() == 0 -> "mux_add_zero"
        else -> "mux_add"
    }
    expected_symbol := if {
        is_router -> "jet_http_router_register"
        handler_param_names.len() == 0 -> "jet_http_mux_add_zero_handler"
        else -> "jet_http_mux_add_handler"
    }
    expected_mask := if is_router -> [Bool]{true, false, false, false, true, false, false} else -> [Bool]{true, false, false, false}
    if row.family != MIRPreludeFamily.StaticPrelude
        || row.module_name != "core.http"
        || row.member != expected_member
        || mir_symbol_name(row.symbol) != expected_symbol
        || row.signature.arity != expected_mask.len()
        || row.signature.max_arity != expected_mask.len()
        || row.signature.borrow_mask != expected_mask
        || row.effect_kind != None
        || row.authority != None
        || row.db_metadata != None
        || row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR HTTP route registration has non-canonical host route metadata")
        return None
    }
    if result_ty == None {
        jet_eval_compiler_fail(&machine, span, "MIR HTTP route registration has no checked result type")
        return None
    }
    values := [MIRValueID]{receiver, path, handler}
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, values, span) ?? return None
    shape_result := jet_eval_host_semantic_arg_shapes(&machine, frame_index, values, span)
    if shape_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    shapes :: shape_result ?? return None
    // Native lowering's logical route slots are [receiver, method, path,
    // handler] for muxes and [receiver, method, path, handler, file, line,
    // contract] for routers. The dynamic positions are 0, 2, and 3.
    move_permissions := [Bool]{false, !row.signature.borrow_mask[2], !row.signature.borrow_mask[3]}
    callback_lease_result := jet_eval_host_http_callback_root(&machine, prepared.values[2], span)
    if callback_lease_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    callback_lease :: callback_lease_result ?? 0
    host_args := [JetEvalHostArgument]{}
    loop index in 0..<prepared.values.len() {
        if {
            index == 2 -> {
                &host_args.push(JetEvalHostArgument{
                    value: prepared.values[index],
                    host: JetEvalHostValue.SourceCallback{lease: callback_lease},
                    moved: move_permissions[index],
                })
            }
            else -> {
                argument := jet_eval_host_argument(&machine, prepared.values[index], move_permissions[index], span)
                if argument == None {
                    jet_eval_callback_release(&machine, callback_lease, span)
                    jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
                    return None
                }
                prepared_argument :: argument ?? return None
                &host_args.push(prepared_argument)
            }
        }
    }
    static_operand := JetEvalHostStaticOperand.HTTPRouterRegister{method: method, handler_param_names: handler_param_names, contract_json: contract_json, location: location}
    exchange := jet_eval_host_http_callback_exchange(
        &machine,
        row,
        prepared.values,
        ^host_args,
        result_ty,
        shapes,
        move_permissions,
        static_operand,
        callback_lease,
        span,
    )
    if !exchange.adopted {
        if !jet_eval_callback_release(&machine, callback_lease, span) {
            if exchange.result == .Val(value) -> jet_eval_drop_value(&machine, value, span)
            exchange.result = None
        }
    }
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, exchange.result, span)
}

fn jet_eval_host_allocator_type_name(ty: MIRType) -> String? {
    if ty.kind == {
        .Tagged(_, inner) -> return jet_eval_host_allocator_type_name(inner)
        .Apply(name, _) -> return Val(name.name)
        else -> return None
    }
}

fn jet_eval_host_allocator_physical_ranges(
    machine: &JetEvalMachine,
    frame_index: Int,
    args: [MIRCallArg],
    span: Span,
) -> [JetEvalHostArgumentRange]? {
    ranges := [JetEvalHostArgumentRange]{}
    start := 0
    loop argument in args {
        count := 1
        if {
            argument.spread -> {
                value :: jet_eval_value(&machine, frame_index, argument.value, span) ?? return None
                data_result := jet_eval_data(value, &machine, span)
                if data_result == None {
                    if machine.frames[frame_index].borrowed_values.get(argument.value.value) != (Val(true)) -> jet_eval_drop_value(&machine, value, span)
                    return None
                }
                data :: data_result ?? return None
                if data == {
                    .List(items) -> count = items.len()
                    else -> {
                        if machine.frames[frame_index].borrowed_values.get(argument.value.value) != (Val(true)) -> jet_eval_drop_value(&machine, value, span)
                        jet_eval_compiler_fail(&machine, span, "MIR allocator spread argument is not a checked List")
                        return None
                    }
                }
                if machine.frames[frame_index].borrowed_values.get(argument.value.value) != (Val(true)) && !jet_eval_drop_value(&machine, value, span) -> return None
            }
        }
        &ranges.push(JetEvalHostArgumentRange{start: start, count: count})
        start += count
    }
    Val(ranges)
}

fn jet_eval_host_allocator_arg_shapes(
    machine: &JetEvalMachine,
    frame_index: Int,
    args: [MIRCallArg],
    ranges: [JetEvalHostArgumentRange],
    span: Span,
) -> [JetEvalHostTypeShape]? {
    if ranges.len() != args.len() {
        jet_eval_compiler_fail(&machine, span, "MIR allocator argument ranges disagree with checked MIR arguments")
        return None
    }
    shapes := [JetEvalHostTypeShape]{}
    loop index in 0..<args.len() {
        argument := args[index]
        ty :: jet_eval_value_type(&machine, frame_index, argument.value, span) ?? return None
        if {
            argument.spread -> {
                inner := if ty.kind == {
                    .List(value) | .FixedList(value, _) -> value
                    else -> {
                        jet_eval_compiler_fail(&machine, span, "MIR allocator spread argument has no checked sequence element type")
                        return None
                    }
                }
                shape :: jet_eval_host_type_shape(&machine, Val(inner), span) ?? return None
                loop _ in 0..<ranges[index].count -> &shapes.push(shape)
            }
            else -> {
                shape :: jet_eval_host_type_shape(&machine, Val(ty), span) ?? return None
                &shapes.push(shape)
            }
        }
    }
    Val(shapes)
}

fn jet_eval_host_fixed_backing_runtime_slot(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> JetEvalHostFixedBackingSlot? {
    if value == {
        .Moved -> return Val(JetEvalHostFixedBackingSlot.Uninitialized)
        .Data(data) -> {
            byte :: jet_eval_int(JetEvalRuntimeValue.Data{value: data}, &machine, span) ?? return None
            if byte < 0 || byte > 255 {
                jet_eval_compiler_fail(&machine, span, "MIR uninitialized U8 backing contains a value outside its checked element type")
                return None
            }
            return Val(JetEvalHostFixedBackingSlot.Initialized{value: byte})
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR uninitialized U8 backing contains a non-scalar runtime value")
            return None
        }
    }
}

fn jet_eval_host_fixed_backing_runtime_slots(machine: &JetEvalMachine, values: [JetEvalRuntimeValue], length: Int, span: Span) -> [JetEvalHostFixedBackingSlot]? {
    if values.len() != length {
        jet_eval_compiler_fail(&machine, span, "MIR uninitialized fixed-list backing length disagrees with its checked type")
        return None
    }
    output := [JetEvalHostFixedBackingSlot]{}
    loop value in values -> &output.push(jet_eval_host_fixed_backing_runtime_slot(&machine, value, span) ?? return None)
    Val(output)
}

fn jet_eval_host_fixed_backing_initial_slots(machine: &JetEvalMachine, value: JetEvalRuntimeValue, length: Int, span: Span) -> [JetEvalHostFixedBackingSlot]? {
    if value == {
        .Aggregate(aggregate) -> {
            if aggregate == {
                .List(values) -> return jet_eval_host_fixed_backing_runtime_slots(&machine, values, length, span)
                else -> {}
            }
        }
        .Data(data) -> {
            if data == {
                .List(values) -> {
                    if values.len() != length {
                        jet_eval_compiler_fail(&machine, span, "MIR uninitialized fixed-list backing length disagrees with its checked type")
                        return None
                    }
                    output := [JetEvalHostFixedBackingSlot]{}
                    loop item in values {
                        &output.push(jet_eval_host_fixed_backing_runtime_slot(&machine, JetEvalRuntimeValue.Data{value: item}, span) ?? return None)
                    }
                    return Val(output)
                }
                else -> {}
            }
        }
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "MIR Fixed.over local is neither an uninitialized fixed list nor a canonical backing root")
    None
}

fn jet_eval_host_fixed_backing_request(machine: &JetEvalMachine, frame_index: Int, args: [MIRCallArg], prepared: JetEvalRuntimeValue, span: Span) -> JetEvalHostFixedBackingRequest? {
    if args.len() != 1 || args[0].spread || args[0].access != MIRAccess.Write {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over argument is not its single writable root place")
        return None
    }
    place_id :: args[0].place ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over argument has no checked root place")
        return None
    }
    if prepared != (JetEvalRuntimeValue.Address{frame: frame_index, place: place_id, access: MIRAccess.Write}) {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over argument did not preserve its checked writable place")
        return None
    }
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over frame function is unavailable")
        return None
    }
    place :: jet_eval_function_place(machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over root place is unavailable")
        return None
    }
    local_id :: if place.base == {.Local(local) -> local else -> {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over root place is not a local")
        return None
    }}
    if place.projections.len() != 0 || place.access != MIRAccess.Write {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over requires an unprojected writable local root")
        return None
    }
    local := MIRLocal?{None}
    loop index in 0..<machine.program.functions[function].locals.len() {
        if machine.program.functions[function].locals[index].id == local_id -> local = Val(machine.program.functions[function].locals[index])
    }
    local_row :: local ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over root local has no checked local row")
        return None
    }
    if !local_row.uninit {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over root local is not checked as uninitialized storage")
        return None
    }
    local_type :: jet_eval_host_component_unwrap_type(machine, local_row.ty, span) ?? return None
    place_type :: jet_eval_host_component_unwrap_type(machine, place.ty, span) ?? return None
    if !mir_type_same_checked_type(local_type, place_type) {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over local and place types disagree")
        return None
    }
    element_type := MIRType?{None}
    fixed_length := Int?{None}
    if local_type.kind == {
        .FixedList(element, measure) -> {
            element_type = Val(element)
            fixed_length = Val(mir_measure_literal_value(measure) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed.over length is not a checked static measure")
                return None
            })
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Fixed.over root is not a checked FixedList")
            return None
        }
    }
    element :: jet_eval_host_component_unwrap_type(machine, element_type ?? return None, span) ?? return None
    length :: fixed_length ?? return None
    element_is_u8 := if element.kind == {
        .IntN(signed, width) -> !signed && width == 8
        else -> false
    }
    if !element_is_u8 || length <= 0 || length > machine.config.max_collection_len {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over requires a nonempty checked FixedList<U8, N> root")
        return None
    }
    root_value :: machine.frames[frame_index].locals.get(local_id.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over uninitialized local value is unavailable")
        return None
    }
    existing := JetEvalHostFixedBackingStorage?{None}
    initial_slots := [JetEvalHostFixedBackingSlot]{}
    if root_value == {
        .ForeignHandle(handle, raw, token) -> {
            meta :: jet_eval_foreign_token_meta(machine, token) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed.over backing root has no evaluator token")
                return None
            }
            if meta.retired || meta.borrowed || meta.handle != handle || meta.raw != raw
                || !jet_eval_foreign_handle_matches(&machine, handle, raw, token, span) {
                jet_eval_compiler_fail(&machine, span, "MIR Fixed.over backing root alias is not live")
                return None
            }
            if meta.kind == {
                .FixedBackingRoot(root_element, root_length) -> {
                    if !mir_type_same_checked_type(root_element, element) || root_length != length {
                        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over backing root type or length changed")
                        return None
                    }
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR Fixed.over local contains a non-backing foreign handle")
                    return None
                }
            }
            existing = Val(JetEvalHostFixedBackingStorage{
                handle: handle,
                raw: raw,
                token: token,
                element_type: element,
                length: length,
            })
        }
        else -> {
            initial_slots = jet_eval_host_fixed_backing_initial_slots(&machine, root_value, length, span) ?? return None
        }
    }
    Val(JetEvalHostFixedBackingRequest{
        key: JetEvalHostFixedBackingKey{
            machine_identity: machine.identity,
            frame: frame_index,
            function: machine.program.functions[function].id,
            local: local_id,
            place: place_id,
        },
        element_type: element,
        length: length,
        span: span,
        existing: existing,
        initial_slots: initial_slots,
    })
}

fn jet_eval_host_fixed_backing_outcome_owner_matches_value(value: JetEvalHostValue, handle: MIRHandleID, raw: Int) -> Bool Never! {
    if value == {
        .Handle(value_handle, value_raw, _, _) -> return value_handle == handle && value_raw == raw
        .Present(inner) -> return jet_eval_host_fixed_backing_outcome_owner_matches_value(inner, handle, raw)
        else -> return false
    }
}

fn jet_eval_host_fixed_backing_outcome_owner_matches(outcome: JetEvalHostOutcome, handle: MIRHandleID, raw: Int) -> Bool Never! {
    if outcome == {
        .Value(value) | .Effect(value, _, _) | .Control(value, _, _, _) -> return jet_eval_host_fixed_backing_outcome_owner_matches_value(value, handle, raw)
        else -> return false
    }
}

fn jet_eval_host_fixed_backing_outcome_succeeded(outcome: JetEvalHostOutcome) -> Bool Never! {
    if outcome == {
        .Value(_) | .Effect(_, _, _) | .Control(_, _, _, _) -> return true
        else -> {}
    }
    false
}

fn jet_eval_host_fixed_backing_handle_available(machine: &JetEvalMachine, handle: MIRHandleID, raw: Int, span: Span) -> Bool {
    loop token in jet_eval_registry_token_ids(machine) {
        meta :: jet_eval_foreign_token_meta(machine, token) ?? next
        if !meta.retired && meta.handle == handle && meta.raw == raw {
            jet_eval_compiler_fail(&machine, span, "native Fixed backing root reuses a live evaluator handle identity")
            return false
        }
    }
    true
}

fn jet_eval_host_fixed_backing_transfer_validate(machine: &JetEvalMachine, request: JetEvalHostFixedBackingRequest, transfer: JetEvalHostFixedBackingTransfer, outcome: JetEvalHostOutcome, span: Span) -> Bool {
    if transfer.argument != 0 || transfer.lease <= 0 {
        jet_eval_compiler_fail(&machine, span, "native Fixed backing receipt has an invalid argument or lease identity")
        return false
    }
    if transfer.backing_owner == {
        .FixedBackingRoot(element_type, length) -> {
            unwrapped :: jet_eval_host_component_unwrap_type(machine, element_type, span) ?? return false
            if !mir_type_same_checked_type(unwrapped, request.element_type) || length != request.length {
                jet_eval_compiler_fail(&machine, span, "native Fixed backing receipt type or length disagrees with its request")
                return false
            }
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "native Fixed backing receipt has no typed backing-root owner")
            return false
        }
    }
    if !jet_eval_host_fixed_backing_outcome_owner_matches(&outcome, transfer.owner_handle, transfer.owner_raw) {
        jet_eval_compiler_fail(&machine, span, "native Fixed backing lease is not attached to the exact returned allocator owner")
        return false
    }
    if request.existing == {
        Val(existing) -> {
            if transfer.backing_handle != existing.handle || transfer.backing_raw != existing.raw {
                jet_eval_compiler_fail(&machine, span, "native Fixed.over retry did not reuse its canonical Source backing root")
                return false
            }
        }
        None -> if !jet_eval_host_fixed_backing_handle_available(&machine, transfer.backing_handle, transfer.backing_raw, span) -> return false
    }
    true
}

fn jet_eval_host_fixed_backing_receipts_cleanup(machine: &JetEvalMachine, request: JetEvalHostFixedBackingRequest, transfers: [JetEvalHostFixedBackingTransfer], outcome: JetEvalHostOutcome, release_roots: Bool, span: Span) -> Bool {
    ok := true
    released_handles := [MIRHandleID]{}
    released_raws := [Int]{}
    if release_roots {
        loop transfer in transfers {
            if request.existing == {
                Val(existing) -> if transfer.backing_handle == existing.handle && transfer.backing_raw == existing.raw -> next
                None -> {}
            }
            duplicate := false
            loop index in 0..<released_handles.len() {
                if released_handles[index] == transfer.backing_handle && released_raws[index] == transfer.backing_raw -> duplicate = true
            }
            if !duplicate {
                &released_handles.push(transfer.backing_handle)
                &released_raws.push(transfer.backing_raw)
                if !jet_eval_host_fixed_backing_release(&machine, transfer.backing_handle, transfer.backing_raw, None, span) -> ok = false
            }
        }
    }
    released_leases := [Int]{}
    loop transfer in transfers {
        if transfer.lease <= 0 -> next
        duplicate := false
        loop lease in released_leases {
            if lease == transfer.lease -> duplicate = true
        }
        if duplicate -> next
        &released_leases.push(transfer.lease)
        attached := false
        loop candidate in transfers {
            if candidate.lease == transfer.lease
                && jet_eval_host_fixed_backing_outcome_owner_matches(&outcome, candidate.owner_handle, candidate.owner_raw) -> attached = true
        }
        if !attached
            && !jet_eval_host_fixed_backing_release(&machine, transfer.backing_handle, transfer.backing_raw, Val(transfer.lease), span) -> ok = false
    }
    ok
}

fn jet_eval_host_fixed_backing_reply_reject(machine: &JetEvalMachine, request: JetEvalHostFixedBackingRequest, reply: JetEvalHostResult, message: String, span: Span) -> JetEvalRuntimeValue? {
    _ := jet_eval_host_result_discard(&machine, reply, span)
    _ := jet_eval_host_fixed_backing_receipts_cleanup(&machine, request, reply.fixed_backing_transfers, reply.outcome, true, span)
    loop callback in reply.callback_transfers -> _ := jet_eval_callback_release(&machine, callback.lease, span)
    jet_eval_compiler_fail(&machine, span, message)
    None
}

fn jet_eval_host_fixed_backing_runtime_owner_matches(value: JetEvalRuntimeValue, handle: MIRHandleID, raw: Int) -> Bool Never! {
    if value == .ForeignHandle(value_handle, value_raw, _) -> return value_handle == handle && value_raw == raw
    false
}

fn jet_eval_host_fixed_backing_allocator_exchange(
    machine: &JetEvalMachine,
    row: MIRPreludeCall,
    request: JetEvalHostFixedBackingRequest,
    args: [JetEvalRuntimeValue],
    result_ty: MIRType?,
    arg_shapes: [JetEvalHostTypeShape],
    move_permissions: [Bool],
    static_operand: JetEvalHostStaticOperand,
    span: Span,
) -> JetEvalRuntimeValue? {
    if args.len() != 1 || move_permissions.len() != 1 || move_permissions[0] {
        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over route lost its borrowed root argument")
        return None
    }
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    host_args := [JetEvalHostArgument]{JetEvalHostArgument{
        value: args[0],
        host: JetEvalHostValue.FixedBacking{request: request},
        moved: false,
    }}
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    reply :: adapter.host_call(&machine, JetEvalHostCallTarget.Prelude{row: row}, Val(static_operand), ^host_args, result_shape, arg_shapes, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR Fixed.over is unavailable to the typed host backing adapter")
        return None
    }
    if reply.transfers.len() != 0 || reply.writebacks.len() != 0 || reply.callback_transfers.len() != 0 {
        return jet_eval_host_fixed_backing_reply_reject(&machine, request, reply, "native Fixed.over returned an unrelated transfer, writeback, or callback acknowledgment", span)
    }
    succeeded := jet_eval_host_fixed_backing_outcome_succeeded(reply.outcome)
    if {
        succeeded -> {
            if reply.fixed_backing_transfers.len() != 1 {
                return jet_eval_host_fixed_backing_reply_reject(&machine, request, reply, "native Fixed.over must return exactly one typed backing lease receipt", span)
            }
            transfer := reply.fixed_backing_transfers[0]
            if !jet_eval_host_fixed_backing_transfer_validate(&machine, request, transfer, reply.outcome, span) {
                return jet_eval_host_fixed_backing_reply_reject(&machine, request, reply, "native Fixed.over returned an invalid backing lease receipt", span)
            }
        }
        reply.fixed_backing_transfers.len() != 0 -> {
            return jet_eval_host_fixed_backing_reply_reject(&machine, request, reply, "failed native Fixed.over returned a committed backing lease receipt", span)
        }
    }
    applied := jet_eval_apply_host_reply(&machine, reply, Val(row), args, move_permissions, result_ty, span)
    if !succeeded -> return applied
    if applied == None {
        _ := jet_eval_host_fixed_backing_receipts_cleanup(&machine, request, reply.fixed_backing_transfers, reply.outcome, true, span)
        return None
    }
    result :: applied ?? return None
    transfer := reply.fixed_backing_transfers[0]
    if !jet_eval_host_fixed_backing_runtime_owner_matches(result, transfer.owner_handle, transfer.owner_raw) {
        _ := jet_eval_drop_value(&machine, result, span)
        _ := jet_eval_host_fixed_backing_receipts_cleanup(&machine, request, reply.fixed_backing_transfers, reply.outcome, true, span)
        jet_eval_compiler_fail(&machine, span, "native Fixed.over host result disagrees with its acknowledged allocator owner")
        return None
    }
    if request.existing == None {
        token := jet_eval_registry_insert_token(
            machine,
            transfer.backing_handle,
            transfer.backing_raw,
            JetEvalForeignTokenKind.FixedBackingRoot{element_type: request.element_type, length: request.length},
            JetEvalRuntimeValue.Data{value: TComptimeValue.Unit},
            false,
        )
        backing := JetEvalRuntimeValue.ForeignHandle{handle: transfer.backing_handle, raw: transfer.backing_raw, token: token}
        if !jet_eval_write_place(&machine, request.key.frame, request.key.place, backing, span) {
            _ := jet_eval_drop_value(&machine, result, span)
            _ := jet_eval_host_fixed_backing_receipts_cleanup(&machine, request, reply.fixed_backing_transfers, reply.outcome, false, span)
            return None
        }
    }
    Val(result)
}

fn jet_eval_host_alloc_new(
    machine: &JetEvalMachine,
    frame_index: Int,
    call: MIRPreludeCallID,
    kind: MIRAllocatorKind,
    inline_size: Int?,
    args: [MIRCallArg],
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    checked_result :: result_ty ?? {
        jet_eval_compiler_fail(&machine, span, "MIR allocator constructor has no checked result type")
        return None
    }
    owner_name :: jet_eval_host_allocator_type_name(checked_result) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR allocator constructor result has no checked allocator type")
        return None
    }
    expected_owner := if kind == {
        .Arena -> "Arena"
        .Bump -> "Bump"
        .Pool -> "Pool"
        .Fixed -> "Fixed"
    }
    if owner_name != expected_owner {
        jet_eval_compiler_fail(&machine, span, "MIR allocator constructor kind disagrees with its checked result type")
        return None
    }
    expected_member := ""
    expected_symbol := ""
    expected_mask := [Bool]{}
    if kind == {
        .Arena -> {
            if inline_size != None || args.len() > 1 {
                jet_eval_compiler_fail(&machine, span, "MIR Arena constructor has invalid checked size metadata")
                return None
            }
            expected_member = "arena.new"
            expected_symbol = if args.len() == 0 -> "jet_mem::JetArena::new" else -> "jet_mem::JetArena::with_capacity"
            if args.len() == 1 -> expected_mask = [Bool]{false}
        }
        .Bump -> {
            if inline_size != None || args.len() > 1 {
                jet_eval_compiler_fail(&machine, span, "MIR Bump constructor has invalid checked size metadata")
                return None
            }
            expected_member = "bump.new"
            expected_symbol = if args.len() == 0 -> "jet_mem::JetBump::new" else -> "jet_mem::JetBump::with_capacity"
            if args.len() == 1 -> expected_mask = [Bool]{false}
        }
        .Pool -> {
            if inline_size != None || args.len() != 1 {
                jet_eval_compiler_fail(&machine, span, "MIR Pool constructor has invalid checked size metadata")
                return None
            }
            expected_member = "pool.new"
            expected_symbol = "jet_mem::JetPool::with_slots"
            expected_mask = [Bool]{false}
        }
        .Fixed -> {
            if {
                inline_size == None -> {
                    if args.len() != 1 {
                        jet_eval_compiler_fail(&machine, span, "MIR Fixed.over has invalid checked argument count")
                        return None
                    }
                    expected_member = "fixed.over"
                    expected_symbol = "jet_mem::JetFixed::over"
                    expected_mask = [Bool]{true}
                }
                else -> {
                    if (inline_size) <= 0 || args.len() != 1 {
                        jet_eval_compiler_fail(&machine, span, "MIR Fixed.new has invalid checked size or argument count")
                        return None
                    }
                    expected_member = "fixed.new"
                    expected_symbol = "jet_mem::JetFixed::new"
                    expected_mask = [Bool]{false}
                }
            }
        }
    }
    if row.family != MIRPreludeFamily.StaticPrelude
        || row.module_name != "core.mem"
        || row.member != expected_member
        || mir_symbol_name(row.symbol) != expected_symbol
        || row.signature.arity != expected_mask.len()
        || row.signature.max_arity != expected_mask.len()
        || row.signature.borrow_mask != expected_mask
        || row.effect_kind != None
        || row.authority != None
        || row.db_metadata != None
        || row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR allocator constructor has non-canonical host route metadata")
        return None
    }
    ranges :: jet_eval_host_allocator_physical_ranges(&machine, frame_index, args, span) ?? return None
    prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
    physical_count := if ranges.len() == 0 -> 0 else -> ranges[ranges.len() - 1].start + ranges[ranges.len() - 1].count
    if physical_count != prepared.values.len() || physical_count != row.signature.arity {
        jet_eval_compiler_fail(&machine, span, "MIR allocator physical arguments disagree with its checked route")
        jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
        return None
    }
    // Fixed.over accepts only a checked unprojected uninitialized
    // FixedList<U8, N> local. The typed host request carries the current slot
    // initialization state on first materialization and thereafter reuses the
    // Source root token. The local is replaced only after the provider returns
    // the matching root/owner lease receipt; ordinary list copying/writeback is
    // not a backing-storage implementation.
    shape_result := jet_eval_host_allocator_arg_shapes(&machine, frame_index, args, ranges, span)
    if shape_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
        return None
    }
    shapes :: shape_result ?? return None
    move_permissions := prepared.move_permissions
    if move_permissions.len() != prepared.values.len() {
        jet_eval_compiler_fail(&machine, span, "MIR allocator ownership metadata does not cover its physical arguments")
        jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
        return None
    }
    static_operand := JetEvalHostStaticOperand.AllocNew{kind: kind, inline_size: inline_size, checked_args: args, physical_ranges: ranges}
    if kind == MIRAllocatorKind.Fixed && inline_size == None {
        request :: jet_eval_host_fixed_backing_request(&machine, frame_index, args, prepared.values[0], span) ?? {
            jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
            return None
        }
        fixed_result := jet_eval_host_fixed_backing_allocator_exchange(
            &machine,
            row,
            request,
            prepared.values,
            result_ty,
            shapes,
            move_permissions,
            static_operand,
            span,
        )
        return jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.move_permissions, fixed_result, span)
    }
    result := jet_eval_host_row_exchange(&machine, row, prepared.values, result_ty, shapes, move_permissions, Val(static_operand), span)
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.move_permissions, result, span)
}


fn jet_eval_cell_guard_route_valid(row: MIRPreludeCall, editable: Bool, split: Bool) -> Bool Never! {
    member :: if {
        split -> {
            if editable -> "split_edit" else -> "split_read"
        }
        else -> {
            if editable -> "map_edit" else -> "map_read"
        }
    }
    symbol :: if split -> "jet_cell_guard_split" else -> "jet_cell_guard_map"
    borrow_mask :: if split -> [Bool]{true, false, false} else -> [Bool]{true, false}
    row.family == MIRPreludeFamily.StaticPrelude
        && row.module_name == "core.cell_guard"
        && row.member == member
        && mir_symbol_name(row.symbol) == symbol
        && row.signature.arity == borrow_mask.len()
        && row.signature.max_arity == borrow_mask.len()
        && row.signature.borrow_mask == borrow_mask
        && row.abi == MIRPreludeABI.Value
}

fn jet_eval_cell_guard_paths_distinct(first: [MIRFieldID], second: [MIRFieldID]) -> Bool Never! {
    common := 0
    loop common < first.len() && common < second.len() && first[common] == second[common] -> common += 1
    common != first.len() && common != second.len()
}

fn jet_eval_cell_guard_project(
    machine: &JetEvalMachine,
    frame_index: Int,
    map_call: MIRPreludeCallID,
    split_call: MIRPreludeCallID?,
    guard: MIRValueID,
    paths: [[MIRFieldID]],
    editable: Bool,
    edit_paths_disjoint: Bool,
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    if paths.len() < 1 || paths.len() > 2 {
        jet_eval_compiler_fail(&machine, span, "MIR Cell guard projection has an invalid checked path shape")
        return None
    }
    loop path in paths {
        if path.len() == 0 {
            jet_eval_compiler_fail(&machine, span, "MIR Cell guard projection has an invalid checked path shape")
            return None
        }
    }
    split := paths.len() == 2
    if (split_call != None) != split {
        jet_eval_compiler_fail(&machine, span, "MIR Cell guard projection path arity disagrees with its split row")
        return None
    }
    if edit_paths_disjoint && (!editable || !split) {
        jet_eval_compiler_fail(&machine, span, "MIR Cell guard edit disjointness proof has an invalid shape")
        return None
    }
    if editable && split && !edit_paths_disjoint {
        jet_eval_compiler_fail(&machine, span, "MIR editable Cell guard split is missing disjoint paths proof")
        return None
    }
    if split && !jet_eval_cell_guard_paths_distinct(paths[0], paths[1]) {
        jet_eval_compiler_fail(&machine, span, "MIR Cell guard split paths are identical or prefix-related")
        return None
    }
    map_row :: jet_eval_route_prelude_row(&machine, map_call, span) ?? return None
    if !jet_eval_cell_guard_route_valid(map_row, editable, false) {
        jet_eval_compiler_fail(&machine, span, "MIR Cell guard map route has non-canonical Prelude metadata")
        return None
    }
    split_route := MIRPreludeCall?{None}
    if split_call != None {
        split_id :: split_call
        if split_id == map_call {
            jet_eval_compiler_fail(&machine, span, "MIR Cell guard projection reuses its map route")
            return None
        }
        route :: jet_eval_route_prelude_row(&machine, split_id, span) ?? return None
        if !jet_eval_cell_guard_route_valid(route, editable, true) {
            jet_eval_compiler_fail(&machine, span, "MIR Cell guard split route has non-canonical Prelude metadata")
            return None
        }
        split_route = Val(route)
    }
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, [MIRValueID]{guard}, span) ?? return None
    guard_type_result := jet_eval_value_type(&machine, frame_index, guard, span)
    if guard_type_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    guard_type :: guard_type_result ?? return None
    guard_shape_result := jet_eval_host_type_shape(&machine, Val(guard_type), span)
    if guard_shape_result == None {
        jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
        return None
    }
    guard_shape :: guard_shape_result ?? return None
    result := jet_eval_host_static_row(
        &machine,
        map_row,
        [JetEvalRuntimeValue]{prepared.values[0]},
        result_ty,
        [JetEvalHostTypeShape]{guard_shape},
        [Bool]{false},
        JetEvalHostStaticOperand.CellGuardProject{paths: paths, editable: editable, edit_paths_disjoint: edit_paths_disjoint, split_route: split_route},
        span,
    )
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}

fn jet_eval_gc_edit_route_valid(row: MIRPreludeCall, kind: MIRGCEditKind) -> Bool Never! {
    member :: if kind == {
        .Clear -> "edit_clear"
        .Pop -> "edit_pop"
        .RemoveIndex -> "edit_remove_index"
        .InsertIndex -> "edit_insert_index"
        .Prepend -> "edit_prepend"
        .Additive -> "edit_additive"
        .Plain -> "edit_plain"
        .EdgeSlot -> "edit_edge_slot"
    }
    borrow_mask :: if kind == {
        .Clear | .Pop | .Plain -> [Bool]{true, false}
        .RemoveIndex -> [Bool]{true, false, false}
        .InsertIndex -> [Bool]{true, false, true, false}
        .Prepend | .Additive -> [Bool]{true, true, false}
        .EdgeSlot -> [Bool]{true, true, false, false}
    }
    if row.signature.borrow_mask.len() != borrow_mask.len() -> return false
    loop index in 0..<borrow_mask.len() {
        if row.signature.borrow_mask[index] != borrow_mask[index] -> return false
    }
    expected_symbol :: "jet_gc_{member}"
    row.family == MIRPreludeFamily.StaticPrelude
        && row.module_name == "core.gc"
        && row.member == member
        && mir_symbol_name(row.symbol) == expected_symbol
        && row.signature.arity == borrow_mask.len()
        && row.signature.max_arity == borrow_mask.len()
        && row.abi == MIRPreludeABI.Value
}

fn jet_eval_gc_edit(
    machine: &JetEvalMachine,
    frame_index: Int,
    call: MIRPreludeCallID,
    root: MIRValueID,
    edges: [MIRValueID],
    edit: MIRValueID,
    index: MIRValueID?,
    kind: MIRGCEditKind,
    site: MIRGCEditSiteID,
    result_ty: MIRType?,
    span: Span,
) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if !jet_eval_gc_edit_route_valid(row, kind) {
        jet_eval_compiler_fail(&machine, span, "MIR GC edit route metadata is inconsistent")
        return None
    }
    if site.value == 0 {
        jet_eval_compiler_fail(&machine, span, "MIR GC edit has an invalid site")
        return None
    }
    operands_valid := if kind == {
        .Clear | .Pop | .Plain -> edges.len() == 0 && index == None
        .RemoveIndex -> edges.len() == 0 && index != None
        .InsertIndex -> index != None
        .Prepend | .Additive -> index == None
        .EdgeSlot -> edges.len() > 0 && index == None
    }
    if !operands_valid {
        jet_eval_compiler_fail(&machine, span, "MIR GC edit carries operands inconsistent with its checked kind")
        return None
    }

    edge_shapes := [JetEvalHostTypeShape]{}
    loop edge in edges {
        edge_type :: jet_eval_value_type(&machine, frame_index, edge, span) ?? return None
        edge_shape :: jet_eval_host_type_shape(&machine, Val(edge_type), span) ?? return None
        &edge_shapes.push(edge_shape)
    }

    source_values := [MIRValueID]{root}
    loop edge in edges -> &source_values.push(edge)
    &source_values.push(edit)
    if index != None -> &source_values.push(index)
    prepared := jet_eval_semantic_values_prepared(&machine, frame_index, source_values, span) ?? return None
    edit_slot := edges.len() + 1
    index_slot := edit_slot + 1

    edge_values := [JetEvalRuntimeValue]{}
    loop edge_index in 0..<edges.len() {
        source_slot := edge_index + 1
        if {
            prepared.owned[source_slot] -> {
                &edge_values.push(prepared.values[source_slot])
                prepared.values[source_slot] = JetEvalRuntimeValue.Moved
                prepared.owned[source_slot] = false
            }
            else -> {
                copied_result := jet_eval_copy_value(prepared.values[source_slot], &machine, span)
                if copied_result == None {
                    jet_eval_drop_value(&machine, JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: edge_values}}, span)
                    jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
                    return None
                }
                &edge_values.push(copied_result ?? JetEvalRuntimeValue.Moved)
            }
        }
    }
    edges_value := JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: edge_values}}

    edit_value := prepared.values[edit_slot]
    if !prepared.owned[edit_slot] {
        copied_edit := jet_eval_copy_value(edit_value, &machine, span)
        if copied_edit == None {
            jet_eval_drop_value(&machine, edges_value, span)
            jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
            return None
        }
        edit_value = copied_edit ?? JetEvalRuntimeValue.Moved
    }

    args := [JetEvalRuntimeValue]{prepared.values[0]}
    owned := [Bool]{prepared.owned[0]}
    move_permissions := [Bool]{false}
    if kind == .RemoveIndex || kind == .InsertIndex {
        &args.push(prepared.values[index_slot])
        &owned.push(prepared.owned[index_slot])
        &move_permissions.push(true)
    }
    if kind == .InsertIndex || kind == .Prepend || kind == .Additive || kind == .EdgeSlot {
        &args.push(edges_value)
        &owned.push(true)
        &move_permissions.push(false)
    }
    &args.push(edit_value)
    &owned.push(true)
    &move_permissions.push(true)
    static_operand := JetEvalHostStaticOperand.GCEdit{kind: kind, site: site, edge_count: edges.len(), has_index: index != None, edge_shapes: edge_shapes}
    result := jet_eval_host_static_row(&machine, row, args, result_ty, [JetEvalHostTypeShape]{}, move_permissions, static_operand, span)
    jet_eval_discharge_call_boundary(&machine, args, owned, result, span)
}




fn jet_eval_semantic_prelude(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, values: [MIRValueID], type_args: [MIRType], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, values, span) ?? return None
    result := jet_eval_route_prelude_dispatch(&machine, call, prepared.values, type_args, result_ty, span)
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}
fn jet_eval_semantic_route_values(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, receiver: MIRValueID?, values: [MIRValueID], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    output := [JetEvalRuntimeValue]{}
    owned := [Bool]{}
    if receiver != None {
        receiver_id :: receiver
        receiver_value :: jet_eval_value(&machine, frame_index, receiver_id, span) ?? return None
        &output.push(receiver_value)
        &owned.push(machine.frames[frame_index].borrowed_values.get(receiver_id.value) != (Val(true)))
    }
    more := jet_eval_semantic_values_prepared(&machine, frame_index, values, span)
    if more == None {
        jet_eval_drop_call_values(&machine, output, owned, span)
        return None
    }
    prepared :: more ?? return None
    loop index in 0..<prepared.values.len() {
        &output.push(prepared.values[index])
        &owned.push(prepared.owned[index])
    }
    result := jet_eval_route_prelude_dispatch(&machine, call, output, [MIRType]{}, result_ty, span)
    jet_eval_discharge_call_boundary(&machine, output, owned, result, span)
}
fn jet_eval_hardware(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, operation: MIRHardwareOp, receiver: MIRValueID?, args: [MIRCallArg], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if row.module_name != "core.hardware" {
        jet_eval_compiler_fail(&machine, span, "MIR hardware call has a non-canonical module")
        return None
    }
    if operation == {
        .RegisterRead(profile_id, block, register, width) -> {
            if receiver != None || args.len() != 0 {
                jet_eval_compiler_fail(&machine, span, "MIR hardware register read has unexpected operands")
                return None
            }
            symbol := mir_symbol_name(row.symbol)
            if symbol != "jet_hardware_register_read" {
                jet_eval_compiler_fail(&machine, span, "MIR hardware register read has a non-canonical symbol")
                return None
            }
            width_bytes := if {
                width == MIRRegisterWidth.U8 -> 1
                width == MIRRegisterWidth.U16 -> 2
                width == MIRRegisterWidth.U32 -> 4
                else -> 8
            }
            values := [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: profile_id}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: block}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: register}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: width_bytes}},
            }
            return jet_eval_route_prelude_dispatch(&machine, call, values, [MIRType]{}, result_ty, span)
        }
        .RegisterWrite(profile_id, block, register, width) -> {
            if receiver != None || args.len() != 1 {
                jet_eval_compiler_fail(&machine, span, "MIR hardware register write has invalid operands")
                return None
            }
            symbol := mir_symbol_name(row.symbol)
            if symbol != "jet_hardware_register_write" {
                jet_eval_compiler_fail(&machine, span, "MIR hardware register write has a non-canonical symbol")
                return None
            }
            width_bytes := if {
                width == MIRRegisterWidth.U8 -> 1
                width == MIRRegisterWidth.U16 -> 2
                width == MIRRegisterWidth.U32 -> 4
                else -> 8
            }
            values := [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: profile_id}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: block}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: register}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: width_bytes}},
            }
            prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
            loop value in prepared.values -> &values.push(value)
            move_permissions := [Bool]{false, false, false, false}
            loop permission in prepared.move_permissions -> &move_permissions.push(permission)
            result := jet_eval_route_prelude_dispatch(&machine, call, values, [MIRType]{}, result_ty, span)
            return jet_eval_discharge_call_boundary(&machine, values, move_permissions, result, span)
        }
        .DMAStart(_, _, _) | .DMAWait(_, _, _) -> {
            loop argument in args -> jet_eval_value(&machine, frame_index, argument.value, span) ?? return None
            jet_eval_unsupported(&machine, span, "MIR hardware DMA operation")
            return None
        }
    }
}

fn jet_eval_columnar_read(machine: &JetEvalMachine, frame_index: Int, base: MIRValueID, index: MIRValueID, column: MIRFieldID, accessor: MIRPreludeCallID, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, accessor, span) ?? return None
    if row.family != MIRPreludeFamily.ColumnarAccess || row.module_name != "core.columnar" || mir_symbol_name(row.symbol) != "jet_columns_gather_cell" || row.signature.arity != 3 || row.signature.max_arity != 3 {
        jet_eval_compiler_fail(&machine, span, "MIR columnar accessor has a non-canonical Prelude route")
        return None
    }
    if row.signature.borrow_mask.len() != 3 || !row.signature.borrow_mask[0] || row.signature.borrow_mask[1] || row.signature.borrow_mask[2] {
        jet_eval_compiler_fail(&machine, span, "MIR columnar accessor has an invalid borrow mask")
        return None
    }
    rows :: jet_eval_data(jet_eval_value(&machine, frame_index, base, span) ?? return None, &machine, span) ?? return None
    row_values := if rows == {.List(values) -> values else -> {
        jet_eval_compiler_fail(&machine, span, "MIR columnar read receiver is not a List")
        return None
    }}
    position :: jet_eval_int(jet_eval_value(&machine, frame_index, index, span) ?? return None, &machine, span) ?? return None
    if position < 0 || position >= row_values.len() {
        jet_eval_compiler_fail(&machine, span, "MIR columnar read index is outside the checked row range")
        return None
    }
    field_name :: jet_eval_field_name(machine, column) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR columnar field ID is missing")
        return None
    }
    row_value := row_values[position]
    if row_value == .Struct(_, fields) {
        loop field in fields {
            if field.name == field_name {
                return Val(JetEvalRuntimeValue.Data{value: field.value})
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR columnar row does not contain its checked field")
    None
}
fn jet_eval_core_closure_call(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, kind: MIRCoreClosureKind, values: [MIRValueID], closure: MIRValueID?, site: MIRSiteID, label: String, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if row.abi != MIRPreludeABI.Value || row.fallibility != MIRCallFallibility.Infallible {
        jet_eval_compiler_fail(&machine, span, "MIR CoreClosureCall route has unsupported ABI or fallibility")
        return None
    }
    if kind == MIRCoreClosureKind.Guard {
        if values.len() != 0 || closure == None || row.module_name != "core.mem.scope" || row.member != "guard" {
            jet_eval_compiler_fail(&machine, span, "MIR Guard CoreClosureCall has an invalid checked shape")
            return None
        }
        callback :: jet_eval_value(&machine, frame_index, closure ?? MIRValueID{value: 0}, span) ?? return None
        if callback == .Closure(_, _) -> return Val(callback)
        jet_eval_compiler_fail(&machine, span, "MIR Guard CoreClosureCall closure is not callable")
        return None
    }
    loop value in values -> jet_eval_value(&machine, frame_index, value, span) ?? return None
    if closure != None {
        callback :: jet_eval_value(&machine, frame_index, closure, span) ?? return None
        callback_valid := if callback == {.Closure(_, _) -> true else -> {
            jet_eval_compiler_fail(&machine, span, "MIR CoreClosureCall closure is not callable")
            return None
        }}
        if !callback_valid -> return None
        }
    jet_eval_unsupported(&machine, span, "MIR CoreClosureCall")
    None
}
fn jet_eval_typed_text_interp(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, kind: MIRTypedHeadKind, literals: [String], holes: [MIRValueID], trusted_html: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if literals.len() != holes.len() + 1 || trusted_html.len() != holes.len() {
        jet_eval_compiler_fail(&machine, span, "MIR typed text interpolation metadata has inconsistent arity")
        return None
    }
    if kind != MIRTypedHeadKind.HTML {
        loop trusted in trusted_html {
            if trusted {
                jet_eval_compiler_fail(&machine, span, "non-HTML typed text interpolation carries HTML trust metadata")
                return None
            }
        }
    }
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    expected_member := "datetime_literal"
    expected_symbol := "jet_typed_datetime_literal"
    expected_arity := 2
    expected_borrow_mask := [Bool]{true, false}
    if {
        kind == MIRTypedHeadKind.SQL -> {
            expected_member = "sql_interpolate"
            expected_symbol = "jet_typed_sql_interpolate"
        }
        kind == MIRTypedHeadKind.HTML -> {
            expected_member = "html_interpolate"
            expected_symbol = "jet_typed_html_interpolate"
            expected_arity = 3
            expected_borrow_mask = [Bool]{true, false, true}
        }
        kind == MIRTypedHeadKind.Sh -> {
            expected_member = "sh_interpolate"
            expected_symbol = "jet_typed_sh_interpolate"
        }
        kind == MIRTypedHeadKind.URL -> {
            expected_member = "url_literal"
            expected_symbol = "jet_std::jet_typed_url_literal"
        }
        kind == MIRTypedHeadKind.Path -> {
            expected_member = "path_literal"
            expected_symbol = "jet_typed_path_literal"
        }
    }
    if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.typed_text" || row.member != expected_member || mir_symbol_name(row.symbol) != expected_symbol || row.signature.arity != expected_arity || row.signature.max_arity != expected_arity {
        jet_eval_compiler_fail(&machine, span, "MIR typed text route has non-canonical Prelude metadata")
        return None
    }
    if row.signature.borrow_mask.len() != expected_borrow_mask.len() {
        jet_eval_compiler_fail(&machine, span, "MIR typed text route has an invalid borrow mask")
        return None
    }
    loop index in 0..<expected_borrow_mask.len() {
        if row.signature.borrow_mask[index] != expected_borrow_mask[index] {
            jet_eval_compiler_fail(&machine, span, "MIR typed text route has an invalid borrow mask")
            return None
        }
    }
    if row.abi != MIRPreludeABI.Value {
        jet_eval_compiler_fail(&machine, span, "MIR typed text route has unsupported ABI")
        return None
    }
    if (kind == MIRTypedHeadKind.URL || kind == MIRTypedHeadKind.Path || kind == MIRTypedHeadKind.DateTime) && result_ty == None {
        jet_eval_compiler_fail(&machine, span, "MIR typed boundary result has no canonical type fact")
        return None
    }
    literal_values := [TComptimeValue]{}
    loop literal in literals -> &literal_values.push(TComptimeValue.String{value: literal})
    hole_values := [TComptimeValue]{}
    loop hole in holes {
        runtime :: jet_eval_value(&machine, frame_index, hole, span) ?? return None
        data :: jet_eval_data(runtime, &machine, span) ?? return None
        if {
            kind == MIRTypedHeadKind.SQL -> {
                &hole_values.push(data)
            }
            else -> {
                ty :: jet_eval_value_type(&machine, frame_index, hole, span) ?? return None
                shown :: jet_eval_format_string_value_full(&machine, data, MIRStringFormat.Display, Val(ty), span) ?? return None
                &hole_values.push(TComptimeValue.String{value: shown})
            }
        }
    }
    values := [JetEvalRuntimeValue]{
        JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: literal_values}},
        JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: hole_values}},
    }
    if kind == MIRTypedHeadKind.HTML {
        trust_values := [TComptimeValue]{}
        loop trusted in trusted_html -> &trust_values.push(TComptimeValue.Bool{value: trusted})
        &values.push(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: trust_values}})
    }
    lookup := jet_eval_source_lookup(machine.program, row)
    if lookup == .Unavailable {
        jet_eval_unsupported(&machine, span, "MIR typed text interpolation has no source-backed canonical Prelude adapter")
        return None
    }
    jet_eval_route_prelude_dispatch(&machine, call, values, [MIRType]{}, result_ty, span)
}
fn jet_eval_semantic_unavailable(machine: &JetEvalMachine, frame_index: Int, values: [MIRValueID], operation: String, span: Span) -> JetEvalRuntimeValue? {
    loop value in values {
        borrowed :: machine.frames[frame_index].values.get(value.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR SSA value is unavailable")
            return None
        }
        if !jet_eval_validate_borrow(borrowed, &machine, span) -> return None
    }
    jet_eval_unsupported(&machine, span, operation)
    None
}
fn jet_eval_semantic_unavailable_args(machine: &JetEvalMachine, frame_index: Int, args: [MIRCallArg], operation: String, span: Span) -> JetEvalRuntimeValue? {
    prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
    jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
    jet_eval_unsupported(&machine, span, operation)
    None
}

// Layout equality is canonical value equality; ordering is numeric and an
// unordered or non-numeric pair is false, never a diagnostic.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::layout_compare
fn jet_eval_semantic_compare(machine: &JetEvalMachine, op: MIRLayoutCompareOp, left: TComptimeValue, right: TComptimeValue, span: Span) -> JetEvalRuntimeValue? {
    if op == MIRLayoutCompareOp.Equal -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: jet_eval_value_equal(left, right)}})
    order :: jet_eval_numeric_compare(&machine, left, right, span) ?? return None
    if op == MIRLayoutCompareOp.LessEqual -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order.len() == 1 && order[0] <= 0}})
    if op == MIRLayoutCompareOp.GreaterEqual -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: order.len() == 1 && order[0] >= 0}})
    jet_eval_compiler_fail(&machine, span, "MIR layout comparison operation is unavailable")
    None
}

// The numeric order of two values as `[sign]`, or `[]` when they are
// unordered (NaN, mixed float widths, or non-numeric carriers).
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::numeric_compare
fn jet_eval_numeric_compare(machine: &JetEvalMachine, left: TComptimeValue, right: TComptimeValue, span: Span) -> [Int]? {
    if jet_eval_route_is_exact_integer(left) && jet_eval_route_is_exact_integer(right) {
        order :: jet_eval_route_exact_order(left, right, &machine, span) ?? return None
        return Val([Int]{order})
    }
    if left == .Float(left_number, left_bits) {
        if right == .Float(right_number, right_bits) {
            if left_bits != right_bits -> return Val([Int]{})
            return Val(jet_eval_float_order(left_number, right_number))
        }
        if right == .Int(right_int) -> return Val(jet_eval_float_order(left_number, Float.from_int(right_int)))
    }
    if left == .Int(left_int) {
        if right == .Float(right_number, _) -> return Val(jet_eval_float_order(Float.from_int(left_int), right_number))
    }
    Val([Int]{})
}

// The nearest binary32 value (ties to even), as Rust's `value as f32`:
// NaN and infinities pass through, overflow saturates to infinity and the
// sign of zero is kept.
fn jet_eval_round_f32(value: Float) -> Float Never! {
    if value != value || !math.is_finite(value) || value == 0.0 -> return value
    negative :: value < 0.0
    magnitude :: if negative -> -value else -> value
    parts :: math.frexp(magnitude)
    exponent :: parts.exp - 1
    scale := 23 - exponent
    if exponent < -126 -> scale = 149
    scaled :: math.ldexp(magnitude, scale)
    lower :: math.floor(scaled)
    fraction :: scaled - lower
    round_up := fraction > 0.5
    if fraction == 0.5 && math.fmod(lower, 2.0) != 0.0 -> round_up = true
    rounded :: if round_up -> lower + 1.0 else -> lower
    result := math.ldexp(rounded, 0 - scale)
    if result > 3.4028234663852886e38 -> result = math.infinity()
    if negative -> return -result
    result
}

fn jet_eval_float_order(left: Float, right: Float) -> [Int] Never! {
    if left != left || right != right -> return [Int]{}
    if left < right -> return [Int]{-1}
    if left > right -> return [Int]{1}
    [Int]{0}
}
fn jet_eval_semantic_display(machine: &JetEvalMachine, frame_index: Int, value: MIRValueID, span: Span) -> String? {
    runtime :: jet_eval_value(&machine, frame_index, value, span) ?? return None
    data :: jet_eval_data(runtime, &machine, span) ?? return None
    ty :: jet_eval_value_type(&machine, frame_index, value, span) ?? return None
    jet_eval_format_string_value_full(&machine, data, MIRStringFormat.Display, Val(ty), span)
}
fn jet_eval_semantic_debug(machine: &JetEvalMachine, frame_index: Int, value: MIRValueID, span: Span) -> String? {
    runtime :: jet_eval_value(&machine, frame_index, value, span) ?? return None
    data :: jet_eval_data(runtime, &machine, span) ?? return None
    ty :: jet_eval_value_type(&machine, frame_index, value, span) ?? return None
    jet_eval_format_string_value_full(&machine, data, MIRStringFormat.Debug, Val(ty), span)
}

fn jet_eval_require_locals(machine: &JetEvalMachine, frame_index: Int, context: MIRPanicContext, span: Span) -> String? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR RequireStop context has no owning function")
        return None
    }
    output := [String]{}
    loop local in context.locals {
        definition := MIRLocal?{None}
        loop index in 0..<machine.program.functions[function].locals.len() {
            if machine.program.functions[function].locals[index].id == local.local {
                definition = Val(machine.program.functions[function].locals[index])
                break
            }
        }
        local_definition :: definition ?? {
            jet_eval_compiler_fail(&machine, span, "MIR RequireStop context refers to a missing local")
            return None
        }
        runtime :: machine.frames[frame_index].locals.get(local.local.value) ?? {
            jet_eval_compiler_fail(&machine, span, "MIR RequireStop context local has no runtime value")
            return None
        }
        data :: jet_eval_data(runtime, &machine, span) ?? return None
        debug :: jet_eval_format_string_value_full(&machine, data, MIRStringFormat.Debug, Val(local_definition.ty), span) ?? return None
        &output.push("{local.name} = {debug}")
    }
    output.join(", ")
}



fn jet_eval_apply_scheduler_reply(machine: &JetEvalMachine, reply: JetEvalHostResult, row: MIRPreludeCall, args: [JetEvalRuntimeValue], move_permissions: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    jet_eval_apply_host_reply(&machine, reply, Val(row), args, move_permissions, result_ty, span)
}
fn jet_eval_apply_native_reply(machine: &JetEvalMachine, binding: JetEvalNativeCallBinding, reply: JetEvalHostResult, args: [JetEvalRuntimeValue], move_permissions: [Bool], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if !jet_eval_validate_host_transfers(&machine, reply.transfers, args, move_permissions, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        return None
    }
    if !jet_eval_retire_host_transfers(&machine, reply.transfers, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        return None
    }
    held := [JetEvalRuntimeValue]{}
    if !jet_eval_host_outcome_collect(&machine, reply.outcome, &held, span) {
        jet_eval_host_result_discard(&machine, reply, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    first_writable := if binding == {.Interface(_) -> 1 else -> 0}
    if !jet_eval_host_writebacks_from(&machine, args, reply.writebacks, first_writable, span) {
        jet_eval_host_outcome_discard(&machine, reply.outcome, span)
        jet_eval_host_outcome_release(&machine, ^held, span)
        return None
    }
    result := jet_eval_apply_host_outcome(&machine, reply.outcome, None, result_ty, span)
    if !jet_eval_host_outcome_release(&machine, ^held, span) {
        if result == .Val(produced) -> jet_eval_drop_value(&machine, produced, span)
        return None
    }
    result
}

fn jet_eval_task_group_exchange(machine: &JetEvalMachine, call: MIRPreludeCallID, kind: MIRTaskGroupKind, tasks: [JetEvalRuntimeValue], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.tasks" || row.abi != MIRPreludeABI.Value || row.signature.arity != 1 || row.signature.max_arity != 1 || row.signature.borrow_mask.len() != 1 || row.signature.borrow_mask[0] {
        jet_eval_compiler_fail(&machine, span, "MIR task-group route has unsupported ABI, family, or ownership facts")
        return None
    }
    expected_member := ""
    expected_symbol := ""
    if kind == {
        .All -> {
            if {
                row.member == "all" -> {
                    expected_member = "all"
                    expected_symbol = "jet_std::jet_task_all"
                }
                row.member == "all_result" -> {
                    expected_member = "all_result"
                    expected_symbol = "jet_std::jet_task_all_result"
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR task-group all route has a non-canonical member")
                    return None
                }
            }
        }
        .Race -> {
            if {
                row.member == "race" -> {
                    expected_member = "race"
                    expected_symbol = "jet_std::jet_task_race"
                }
                row.member == "race_result" -> {
                    expected_member = "race_result"
                    expected_symbol = "jet_std::jet_task_race_result"
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR task-group race route has a non-canonical member")
                    return None
                }
            }
        }
        .Any -> {
            if {
                row.member == "any" -> {
                    expected_member = "any"
                    expected_symbol = "jet_std::jet_task_any"
                }
                row.member == "any_result" -> {
                    expected_member = "any_result"
                    expected_symbol = "jet_std::jet_task_any_result"
                }
                else -> {
                    jet_eval_compiler_fail(&machine, span, "MIR task-group any route has a non-canonical member")
                    return None
                }
            }
        }
    }
    if mir_symbol_name(row.symbol) != expected_symbol || tasks.len() != 1 {
        jet_eval_compiler_fail(&machine, span, "MIR task-group route has an invalid symbol or operand arity")
        return None
    }
    if kind != MIRTaskGroupKind.All {
        if tasks[0] == {
            .Aggregate(aggregate) -> {
                if aggregate == .List(values) {
                    if values.len() == 0 {
                        jet_eval_compiler_fail(&machine, span, "MIR task-group race/any requires at least one task")
                        return None
                    }
                }
            }
            .Data(data) -> {
                if data == .List(values) {
                    if values.len() == 0 {
                        jet_eval_compiler_fail(&machine, span, "MIR task-group race/any requires at least one task")
                        return None
                    }
                }
            }
            else -> {}
        }
    }
    move_permissions := [Bool]{}
    loop borrowed in row.signature.borrow_mask -> &move_permissions.push(!borrowed)
    host_args :: jet_eval_task_host_arguments(&machine, tasks, move_permissions, span) ?? return None
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    reply :: adapter.task_group(&machine, row, kind, ^host_args, result_shape, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR task-group scheduler is unavailable to the canonical host adapter")
        return None
    }
    jet_eval_apply_scheduler_reply(&machine, reply, row, tasks, move_permissions, result_ty, span)
}

fn jet_eval_task_group(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, kind: MIRTaskGroupKind, task_ids: [MIRValueID], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, task_ids, span) ?? return None
    result := jet_eval_task_group_exchange(&machine, call, kind, prepared.values, result_ty, span)
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}

fn jet_eval_channel_select_exchange(machine: &JetEvalMachine, call: MIRPreludeCallID, kind: MIRSelectKind, values: [JetEvalRuntimeValue], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    expected_symbol := ""
    if {
        row.member == "select_wait_tagged" -> {
            expected_symbol = "jet_std::jet_select_wait_tagged"
        }
        row.member == "select_try_wait_tagged" -> {
            expected_symbol = "jet_std::jet_select_try_wait_tagged"
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR channel select route has a non-canonical member")
            return None
        }
    }
    if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.tasks" || row.abi != MIRPreludeABI.Value || mir_symbol_name(row.symbol) != expected_symbol || row.signature.arity != 2 || row.signature.max_arity != 2 || row.signature.borrow_mask.len() != 2 || !row.signature.borrow_mask[0] || row.signature.borrow_mask[1] {
        jet_eval_compiler_fail(&machine, span, "MIR channel select route has unsupported ABI, family, or ownership facts")
        return None
    }
    if values.len() != 2 {
        jet_eval_compiler_fail(&machine, span, "MIR channel select has an invalid checked operand count")
        return None
    }
    if values[0] == .Aggregate(aggregate) {
        if aggregate == .List(receivers) {
            if values[1] == .Aggregate(timer_aggregate) {
                if timer_aggregate == .List(timers) {
                    if receivers.len() == 0 && timers.len() == 0 {
                        jet_eval_compiler_fail(&machine, span, "MIR channel select has no registered arms")
                        return None
                    }
                }
            }
        }
    }
    if values[0] == .Data(receiver_data) {
        if receiver_data == .List(receivers) {
            if values[1] == .Data(timer_data) {
                if timer_data == .List(timers) {
                    if receivers.len() == 0 && timers.len() == 0 {
                        jet_eval_compiler_fail(&machine, span, "MIR channel select has no registered arms")
                        return None
                    }
                }
            }
        }
    }
    move_permissions := [Bool]{}
    loop borrowed in row.signature.borrow_mask -> &move_permissions.push(!borrowed)
    host_args :: jet_eval_task_host_arguments(&machine, values, move_permissions, span) ?? return None
    result_shape := JetEvalHostTypeShape?{None}
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    reply :: adapter.channel_select(&machine, row, kind, ^host_args, result_shape, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR channel select scheduler is unavailable to the canonical host adapter")
        return None
    }
    jet_eval_apply_scheduler_reply(&machine, reply, row, values, move_permissions, result_ty, span)
}

// Scheduler boundaries own the operand values they read and discharge them
// after the exchange; the exchange itself only borrows.
fn jet_eval_channel_select(machine: &JetEvalMachine, frame_index: Int, call: MIRPreludeCallID, kind: MIRSelectKind, value_ids: [MIRValueID], result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    prepared :: jet_eval_semantic_values_prepared(&machine, frame_index, value_ids, span) ?? return None
    result := jet_eval_channel_select_exchange(&machine, call, kind, prepared.values, result_ty, span)
    jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.owned, result, span)
}

fn jet_eval_semantic(machine: &JetEvalMachine, frame_index: Int, operation: MIRSemanticOp, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if operation == {
        .DataEntriesToMap(call, local) -> {
            value :: machine.frames[frame_index].locals.get(local.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR data-entry local is unavailable")
                return None
            }
            copy_value :: jet_eval_copy_value(value, &machine, span) ?? return None
            return jet_eval_route_prelude_dispatch(&machine, call, [JetEvalRuntimeValue]{copy_value}, [MIRType]{}, result_ty, span)
        }
        .MathBuiltin(_, call, args) | .PreciseBuiltin(_, call, args) -> return jet_eval_semantic_prelude(&machine, frame_index, call, args, [MIRType]{}, result_ty, span)
        .Print(call, value) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.term" || row.member != "print" || mir_symbol_name(row.symbol) != "jet_term_write_stdout_line" || row.abi != MIRPreludeABI.Effect || row.signature.arity != 2 || row.signature.max_arity != 2 {
                jet_eval_compiler_fail(&machine, span, "MIR print route has a non-canonical ABI")
                return None
            }
            if row.signature.borrow_mask.len() != 2 || !row.signature.borrow_mask[0] || row.signature.borrow_mask[1] {
                jet_eval_compiler_fail(&machine, span, "MIR print route has an invalid borrow mask")
                return None
            }
            if row.fallibility != MIRCallFallibility.Infallible {
                jet_eval_compiler_fail(&machine, span, "MIR print route has unsupported fallibility")
                return None
            }
            if !machine.config.runtime_execution {
                jet_eval_effect_fail(&machine, span, "core.term.print")
                return None
            }
            text :: jet_eval_semantic_display(&machine, frame_index, value, span) ?? return None
            values := [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: text}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: true}},
            }
            return jet_eval_host_row(&machine, row, values, result_ty, span)
        }
        .AmbientInput(call, prompt) -> {
            string_ty := mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("String"), args: [MIRType]{}})
            input := JetEvalRuntimeValue.Absent{element: string_ty}
            if prompt == .Val(prompt_value) -> input = jet_eval_value(&machine, frame_index, prompt_value, span) ?? return None
            return jet_eval_route_prelude_dispatch(&machine, call, [JetEvalRuntimeValue]{input}, [MIRType]{}, result_ty, span)
        }
        .RequireStop(call, kind, condition, location, context, values, always_stops) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            if row.abi != MIRPreludeABI.Control || row.fallibility != MIRCallFallibility.Infallible {
                jet_eval_compiler_fail(&machine, span, "MIR RequireStop route has unsupported ABI")
                return None
            }
            if (kind == MIRRequireKind.Require && values.len() > 1) || (kind == MIRRequireKind.RequireEq && values.len() != 2) || (kind == MIRRequireKind.Panic && values.len() != 1) {
                jet_eval_compiler_fail(&machine, span, "MIR RequireStop diagnostic payload has invalid shape")
                return None
            }
            expected_member := "require"
            expected_symbol := "jet_require"
            expected_arity := 9
            expected_borrow_mask := [Bool]{false, true, true, false, true, true, false, false, true}
            if {
                kind == MIRRequireKind.RequireEq -> {
                    expected_member = "require_eq"
                    expected_symbol = "jet_require_eq"
                    expected_arity = 10
                    expected_borrow_mask = [Bool]{false, true, true, true, false, true, true, false, false, true}
                }
                kind == MIRRequireKind.Panic -> {
                    expected_member = "panic"
                    expected_symbol = "jet_panic_rich"
                    expected_arity = 8
                    expected_borrow_mask = [Bool]{true, false, true, true, false, false, true, true}
                }
            }
            if row.family != MIRPreludeFamily.StaticPrelude || row.module_name != "core.require" || row.member != expected_member || mir_symbol_name(row.symbol) != expected_symbol || row.signature.arity != expected_arity || row.signature.max_arity != expected_arity {
                jet_eval_compiler_fail(&machine, span, "MIR RequireStop route has non-canonical Prelude metadata")
                return None
            }
            if row.signature.borrow_mask.len() != expected_borrow_mask.len() {
                jet_eval_compiler_fail(&machine, span, "MIR RequireStop route has an invalid borrow mask")
                return None
            }
            loop index in 0..<expected_borrow_mask.len() {
                if row.signature.borrow_mask[index] != expected_borrow_mask[index] {
                    jet_eval_compiler_fail(&machine, span, "MIR RequireStop route has an invalid borrow mask")
                    return None
                }
            }
            condition_runtime :: if {
                kind == MIRRequireKind.Panic -> {
                    if condition != None {
                        jet_eval_compiler_fail(&machine, span, "MIR panic carries an unexpected checked condition")
                        return None
                    }
                    None
                }
                else -> {
                    checked :: condition ?? {
                        jet_eval_compiler_fail(&machine, span, "MIR RequireStop route has no checked condition")
                        return None
                    }
                    Val(jet_eval_value(&machine, frame_index, checked, span) ?? return None)
                }
            }
            condition_ok :: if {
                condition_runtime == None -> None
                else -> {
                    runtime :: condition_runtime
                    data :: jet_eval_data(runtime, &machine, span) ?? return None
                    if data == {.Bool(value) -> Val(value) else -> {
                        jet_eval_compiler_fail(&machine, span, "MIR RequireStop condition is not Bool")
                        return None
                    }}
                }
            }
            failed :: if kind == MIRRequireKind.Panic -> true else -> !(condition_ok ?? false)
            if !machine.config.runtime_execution && failed {
                jet_eval_unsupported(&machine, span, "MIR RequireStop has no canonical comptime Control adapter")
                return None
            }
            string_ty := mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("String"), args: [MIRType]{}})
            file :: jet_eval_route_source_path(&machine, location.file, span) ?? return None
            locals :: jet_eval_require_locals(&machine, frame_index, context, span) ?? return None
            file_value := JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: file}}
            line_value := JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: location.line}}
            function_value := JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: context.function}}
            source_line_value := JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: context.source_line}}
            column_value := JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: location.column}}
            caret_value := JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: context.caret}}
            locals_value := JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: locals}}
            args :: if {
                kind == MIRRequireKind.Require -> {
                    checked :: condition_runtime ?? return None
                    message :: if values.len() == 0 -> JetEvalRuntimeValue.Absent{element: string_ty} else -> jet_eval_value(&machine, frame_index, values[0], span) ?? return None
                    [JetEvalRuntimeValue]{checked, message, file_value, line_value, function_value, source_line_value, column_value, caret_value, locals_value}
                }
                kind == MIRRequireKind.RequireEq -> {
                    checked :: condition_runtime ?? return None
                    left :: jet_eval_semantic_debug(&machine, frame_index, values[0], span) ?? return None
                    right :: jet_eval_semantic_debug(&machine, frame_index, values[1], span) ?? return None
                    [JetEvalRuntimeValue]{
                        checked,
                        JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: left}},
                        JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: right}},
                        file_value,
                        line_value,
                        function_value,
                        source_line_value,
                        column_value,
                        caret_value,
                        locals_value,
                    }
                }
                else -> {
                    message :: jet_eval_value(&machine, frame_index, values[0], span) ?? return None
                    [JetEvalRuntimeValue]{file_value, line_value, function_value, source_line_value, column_value, caret_value, message, locals_value}
                }
            }
            return jet_eval_host_row(&machine, row, args, result_ty, span)
        }
        .ConditionNotify(call, condition, all) -> {
            values := [JetEvalRuntimeValue]{
                jet_eval_value(&machine, frame_index, condition, span) ?? return None,
                JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: all}},
            }
            return jet_eval_route_prelude_dispatch(&machine, call, values, [MIRType]{}, result_ty, span)
        }
        .LayoutLiteral(inner) -> return jet_eval_value(&machine, frame_index, inner, span)
        .StructLiteral(type_id, fields, _, _, _) -> {
            name :: jet_eval_type_name(&machine, type_id, span) ?? return None
            return jet_eval_aggregate_or_data(&machine, name, fields, frame_index, true, span)
        }
        .LayoutCompare(call, op, left, right) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            if row.abi != MIRPreludeABI.Value {
                jet_eval_compiler_fail(&machine, span, "MIR LayoutCompare route has unsupported ABI")
                return None
            }
            left_data :: jet_eval_data(jet_eval_value(&machine, frame_index, left, span) ?? return None, &machine, span) ?? return None
            right_data :: jet_eval_data(jet_eval_value(&machine, frame_index, right, span) ?? return None, &machine, span) ?? return None
            return jet_eval_semantic_compare(&machine, op, left_data, right_data, span)
        }
        .ReflectOf(type_name, path, display, fields) -> {
            display_value :: jet_eval_data(jet_eval_value(&machine, frame_index, display, span) ?? return None, &machine, span) ?? return None
            display_text :: if display_value == {.String(text) -> text else -> {
                jet_eval_compiler_fail(&machine, span, "MIR reflection display projection is not String")
                return None
            }}
            reflected := [TComptimeValue]{}
            loop field in fields {
                value_display :: jet_eval_semantic_display(&machine, frame_index, field.value, span) ?? return None
                reflected_value := TComptimeValue.Struct{type_name: "Value", fields: [TComptimeField]{
                    TComptimeField{name: "type_name", value: TComptimeValue.String{value: field.type_name}},
                    TComptimeField{name: "path", value: TComptimeValue.String{value: field.path}},
                    TComptimeField{name: "display", value: TComptimeValue.String{value: value_display}},
                    TComptimeField{name: "fields", value: TComptimeValue.List{values: [TComptimeValue]{}}},
                }}
                &reflected.push(TComptimeValue.Struct{type_name: "Field", fields: [TComptimeField]{
                    TComptimeField{name: "name", value: TComptimeValue.String{value: field.name}},
                    TComptimeField{name: "value", value: reflected_value},
                }})
            }
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Struct{type_name: "Value", fields: [TComptimeField]{
                TComptimeField{name: "type_name", value: TComptimeValue.String{value: type_name}},
                TComptimeField{name: "path", value: TComptimeValue.String{value: path}},
                TComptimeField{name: "display", value: TComptimeValue.String{value: display_text}},
                TComptimeField{name: "fields", value: TComptimeValue.List{values: reflected}},
            }}})
        }
        .StaticPreludeCall(call, args, _, type_args) -> {
            prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
            result := jet_eval_route_prelude_dispatch(&machine, call, prepared.values, type_args, result_ty, span)
            return jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.move_permissions, result, span)
        }
        .HardwareCall(call, hardware_operation, receiver, args) -> return jet_eval_hardware(&machine, frame_index, call, hardware_operation, receiver, args, result_ty, span)
        .CoreClosureCall(call, kind, values, closure, site, label) -> return jet_eval_core_closure_call(&machine, frame_index, call, kind, values, closure, site, label, span)
        .BuiltinMethod(call, receiver, receiver_place, args, _) -> {
            if receiver_place != None {
                row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
                if jet_eval_route_is_mutating_member(row.member) {
                    receiver_data :: jet_eval_data(jet_eval_value(&machine, frame_index, receiver, span) ?? return None, &machine, span) ?? return None
                    operands := [TComptimeValue]{}
                    loop arg in args {
                        &operands.push(jet_eval_data(jet_eval_value(&machine, frame_index, arg, span) ?? return None, &machine, span) ?? return None)
                    }
                    mutation :: jet_eval_route_mutating_builtin(row.member, receiver_data, operands, result_ty, &machine, span) ?? return None
                    if !jet_eval_write_place(&machine, frame_index, receiver_place, JetEvalRuntimeValue.Data{value: mutation.receiver}, span) -> return None
                    return Val(mutation.result)
                }
            }
            result :: jet_eval_semantic_route_values(&machine, frame_index, call, Val(receiver), args, result_ty, span) ?? return None
            if receiver_place != None {
                writable :: jet_eval_copy_value(result, &machine, span) ?? {
                    jet_eval_drop_value(&machine, result, span)
                    return None
                }
                if !jet_eval_write_place(&machine, frame_index, receiver_place, writable, span) {
                    jet_eval_drop_value(&machine, result, span)
                    return None
                }
            }
            return Val(result)
        }
        .ColumnarRead(base, index, column, _, accessor) -> return jet_eval_columnar_read(&machine, frame_index, base, index, column, accessor, span)
        .TypedTextInterp(call, kind, literals, holes, trusted_html) -> return jet_eval_typed_text_interp(&machine, frame_index, call, kind, literals, holes, trusted_html, result_ty, span)
        .TextPatternMatch(call, subject, parts) -> return jet_eval_semantic_pattern_match(&machine, frame_index, call, subject, JetEvalHostStaticOperand.TextPattern{parts: parts}, "text_match", "jet_text_pattern_match", false, result_ty, span)
        .BinaryPatternMatch(call, subject, parts) -> return jet_eval_semantic_pattern_match(&machine, frame_index, call, subject, JetEvalHostStaticOperand.BinaryPattern{parts: parts}, "binary_match", "jet_binary_pattern_match", true, result_ty, span)
        .CarrierFact(call, receiver, field, notes) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            if row.abi != MIRPreludeABI.Value {
                jet_eval_compiler_fail(&machine, span, "MIR carrier fact route has unsupported ABI")
                return None
            }
            field_name :: jet_eval_field_name(machine, field) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR carrier fact field ID is missing")
                return None
            }
            receiver_data :: jet_eval_data(jet_eval_value(&machine, frame_index, receiver, span) ?? return None, &machine, span) ?? return None
            report_value := TComptimeValue?{None}
            if receiver_data == .Failed(report) {
                if report == .Told(value) {
                    report_value = Val(value)
                }
            }
            source := if report_value != None -> report_value ?? TComptimeValue.Unit else -> receiver_data
            if notes {
                if source == .Struct(_, fields) {
                    loop item in fields {
                        if item.name == field_name {
                            if item.value == .List(values) {
                                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: values}})
                            }
                        }
                    }
                }
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: [TComptimeValue]{}}})
            }
            if report_value != None {
                element :: result_ty ?? {
                    jet_eval_compiler_fail(&machine, span, "MIR carrier partial route has no Option element type fact")
                    return None
                }
                return Val(JetEvalRuntimeValue.Absent{element: jet_eval_option_element(element)})
            }
            if receiver_data == .Struct(_, fields) {
                loop item in fields {
                    if item.name == field_name {
                        return Val(JetEvalRuntimeValue.Result{ok: true, value: JetEvalRuntimeValue.Data{value: item.value}})
                    }
                }
            }
            jet_eval_compiler_fail(&machine, span, "MIR carrier report has no requested partial field")
            return None
        }
        .ClosureMethod(receiver, args, call) -> {
            receiver_value :: jet_eval_value(&machine, frame_index, receiver, span) ?? return None
            values := [JetEvalRuntimeValue]{receiver_value}
            owned := [Bool]{machine.frames[frame_index].borrowed_values.get(receiver.value) != (Val(true))}
            prepared_result := jet_eval_call_arguments(&machine, frame_index, args, span)
            if prepared_result == None {
                jet_eval_drop_call_values(&machine, values, owned, span)
                return None
            }
            prepared :: prepared_result ?? return None
            loop index in 0..<prepared.values.len() {
                &values.push(prepared.values[index])
                &owned.push(prepared.move_permissions[index])
            }
            result := jet_eval_route_prelude_dispatch(&machine, call, values, [MIRType]{}, result_ty, span)
            return jet_eval_discharge_call_boundary(&machine, values, owned, result, span)
        }
        .HostBorrowCallback(callable, _) -> {
            value :: jet_eval_value(&machine, frame_index, callable, span) ?? return None
            if value == .Closure(_, _) -> return Val(value)
            jet_eval_compiler_fail(&machine, span, "MIR host-borrow callback is not callable")
            return None
        }
        .CCallback(call, callback, lambda) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            if row.abi != MIRPreludeABI.Value {
                jet_eval_compiler_fail(&machine, span, "MIR C callback route has unsupported ABI")
                return None
            }
            adapter_value := MIRCallbackAdapter?{None}
            loop index in 0..<machine.program.callbacks.len() {
                if machine.program.callbacks[index].id == callback {
                    adapter_value = Val(machine.program.callbacks[index])
                    break
                }
            }
            adapter :: adapter_value ?? {
                jet_eval_compiler_fail(&machine, span, "MIR callback adapter ID has no canonical row")
                return None
            }
            value :: jet_eval_value(&machine, frame_index, lambda, span) ?? return None
            if value == .Closure(function, _) {
                if function != adapter.function {
                    jet_eval_compiler_fail(&machine, span, "MIR C callback lambda does not match its adapter function")
                    return None
                }
                return Val(value)
            }
            jet_eval_compiler_fail(&machine, span, "MIR C callback lambda is not callable")
            return None
        }
        .PolicyFunction(policy, values) | .InterruptFunction(policy, values) -> {
            closure_borrowed := machine.frames[frame_index].borrowed_values.get(policy.value) == (Val(true))
            closure_result := jet_eval_value(&machine, frame_index, policy, span)
            if closure_result == None -> return None
            closure :: closure_result ?? return None
            prepared_result := jet_eval_semantic_values_prepared(&machine, frame_index, values, span)
            if prepared_result == None {
                if !closure_borrowed -> jet_eval_drop_value(&machine, closure, span)
                return None
            }
            prepared :: prepared_result ?? return None
            if closure == .Closure(function_id, captures) {
                function :: jet_eval_function_row(machine, function_id) ?? {
                    if !closure_borrowed -> jet_eval_drop_value(&machine, closure, span)
                    jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
                    jet_eval_compiler_fail(&machine, span, "MIR policy/interrupt function is unavailable")
                    return None
                }
                read_temporaries := [Bool]{}
                loop index in 0..<prepared.values.len() {
                    is_read := index < machine.program.functions[function].params.len() && machine.program.functions[function].params[index].access == MIRAccess.Read
                    &read_temporaries.push(is_read && prepared.owned[index])
                }
                invoked := jet_eval_invoke_with_borrowed_captures(&machine, function_id, prepared.values, captures, closure_borrowed, span)
                return jet_eval_discharge_call_boundary(&machine, prepared.values, read_temporaries, invoked, span)
            }
            if !closure_borrowed -> jet_eval_drop_value(&machine, closure, span)
            jet_eval_drop_call_values(&machine, prepared.values, prepared.owned, span)
            jet_eval_compiler_fail(&machine, span, "MIR policy/interrupt function is not callable")
            return None
        }
        .DecodeUnder(call, segment, inner) -> return jet_eval_semantic_prelude(&machine, frame_index, call, [MIRValueID]{segment, inner}, [MIRType]{}, result_ty, span)
        .NumericMethod(call, receiver) -> return jet_eval_semantic_prelude(&machine, frame_index, call, [MIRValueID]{receiver}, [MIRType]{}, result_ty, span)
        .NumericBinaryMethod(call, receiver, argument) -> return jet_eval_semantic_prelude(&machine, frame_index, call, [MIRValueID]{receiver, argument}, [MIRType]{}, result_ty, span)
        .OverflowOption(call, left, right, _) -> return jet_eval_semantic_prelude(&machine, frame_index, call, [MIRValueID]{left, right}, [MIRType]{}, result_ty, span)
        .OptionLift2(call, function, left, right) -> return jet_eval_semantic_prelude(&machine, frame_index, call, [MIRValueID]{left, right, function}, [MIRType]{}, result_ty, span)
        .CellGuardProject(map_call, split_call, guard, paths, editable, disjoint) -> return jet_eval_cell_guard_project(&machine, frame_index, map_call, split_call, guard, paths, editable, disjoint, result_ty, span)
        .SharedGuardMap(_, _, _, _) | .SharedGuardSplit(_, _, _, _, _, _) | .SharedGuardWait(_, _, _, _) -> return jet_eval_shared_runtime_semantic(&machine, frame_index, operation, result_ty, span)
        .AllocNew(call, kind, inline_size, args) -> return jet_eval_host_alloc_new(&machine, frame_index, call, kind, inline_size, args, result_ty, span)
        .HandleMethod(call, receiver, args, frame_schedule, frame_schedule_derivation) -> {
            row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
            return jet_eval_host_handle_method(&machine, frame_index, row, receiver, args, frame_schedule, frame_schedule_derivation, result_ty, span)
        }
        .PluginInvoke(call, handle, export_name, signature, args) -> return jet_eval_host_plugin_invoke(&machine, frame_index, call, handle, export_name, signature, args, result_ty, span)
        .HTTPRouterRegister(call, receiver, path, handler, method, handler_param_names, contract_json, location) -> return jet_eval_host_http_router_register(&machine, frame_index, call, receiver, path, handler, method, handler_param_names, contract_json, location, result_ty, span)
        .TaskGroup(call, kind, tasks) -> return jet_eval_task_group(&machine, frame_index, call, kind, tasks, result_ty, span)
        .Select(call, kind, values) -> return jet_eval_channel_select(&machine, frame_index, call, kind, values, result_ty, span)
        .GCEdit(call, root, edges, edit, index, kind, site) -> return jet_eval_gc_edit(&machine, frame_index, call, root, edges, edit, index, kind, site, result_ty, span)
        .CursorTakePattern(receiver, receiver_place, parts) -> return jet_eval_host_take_pattern(&machine, frame_index, receiver, receiver_place, JetEvalHostCallTarget.CursorTakePattern{receiver_place: receiver_place, parts: parts}, result_ty, span)
        .ReaderTakePattern(receiver, receiver_place, parts) -> return jet_eval_host_take_pattern(&machine, frame_index, receiver, receiver_place, JetEvalHostCallTarget.ReaderTakePattern{receiver_place: receiver_place, parts: parts}, result_ty, span)
        .HostCall(call, args) -> return jet_eval_host_call(&machine, frame_index, call, args, result_ty, span)
        else -> {}
    }
    jet_eval_unsupported(&machine, span, "MIR semantic operation")
    None
}

// These helpers intentionally use the checked Jet `~` operation over a full
// proven window. Their lowered MIR is MaterializeView, so the evaluator's own
// generated code reaches the shared ViewCopy Prelude kernels instead of
// carrying a second recursive clone policy.
fn jet_eval_materialize_string_window(value: String) -> String {
    window :: value.after("")
    ~window
}

fn jet_eval_materialize_list_window(value: [TComptimeValue]) -> [TComptimeValue] Never! {
    window :: value[0..<value.len()]
    ~window
}

fn jet_eval_materialize_bytes_window(value: [U8]) -> [U8] Never! {
    window :: value[0..<value.len()]
    ~window
}


fn jet_eval_materialize_view_value(value: JetEvalRuntimeValue, source_ty: MIRType, result_ty: MIRType?, machine: &JetEvalMachine, span: Span) -> JetEvalRuntimeValue? {
    kind :: mir_view_copy_kind(source_ty) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR view materialization source has no canonical copy kernel")
        return None
    }
    if result_ty != None && !mir_view_copy_target_matches(kind, result_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR view materialization destination does not own the source window")
        return None
    }
    checked :: jet_eval_copy_value(value, &machine, span) ?? return None
    if checked == .Data(data) {
        if kind == MIRViewCopyKind.String {
            if data == .String(text) {
                copied := jet_eval_materialize_string_window(text)
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: copied}})
            }
        }
        if data == {
            .List(values) -> {
                if kind == MIRViewCopyKind.List {
                    copied := jet_eval_materialize_list_window(values)
                    return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.List{values: copied}})
                }
            }
            .Bytes(values) -> {
                if kind == MIRViewCopyKind.List {
                    copied := jet_eval_materialize_bytes_window(values)
                    return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bytes{value: copied}})
                }
            }
            else -> {}
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR view materialization received an incompatible data value")
    None
}

fn jet_eval_host_runtime_failure(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == .RuntimeFailure(nested, failure_span) {
        if nested == .Data(data) {
            if data == .Failed(_) {
                jet_eval_source_fail(&machine, failure_span, "native Prelude operation returned a checked failure carrier")
                return false
            }
        }
        jet_eval_compiler_fail(&machine, failure_span, "native Prelude operation returned an invalid failure carrier")
        return false
    }
    true
}

fn jet_eval_host_loop_cursor_call(machine: &JetEvalMachine, cursor: JetEvalRuntimeValue, expected: MIRPreludeCallID, call: MIRPreludeCallID, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if cursor == .HostCursor(inner, _, _, _) {
        if expected != call {
            jet_eval_compiler_fail(&machine, span, "MIR iterator operation uses a non-canonical cursor route")
            return None
        }
        if inner == {.ForeignHandle(handle, raw, token) -> {
            if !jet_eval_cursor_handle_matches(&machine, handle, raw, token, span) -> return None
        } else -> {
            jet_eval_compiler_fail(&machine, span, "MIR host cursor carries a non-native cursor value")
            return None
        }}
        row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
        live_inner :: jet_eval_borrow_value(inner, &machine, span) ?? return None
        output :: jet_eval_host_row(&machine, row, [JetEvalRuntimeValue]{live_inner}, result_ty, span) ?? return None
        if !jet_eval_host_runtime_failure(&machine, output, span) -> return None
        return Val(output)
    }
    jet_eval_compiler_fail(&machine, span, "MIR host iterator operation does not have a host cursor")
    None
}

fn jet_eval_host_loop_advance(machine: &JetEvalMachine, frame_index: Int, cursor: MIRValueID, call: MIRPreludeCallID, result_ty: MIRType?, span: Span) -> Bool {
    current :: machine.frames[frame_index].values.get(cursor.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR iterator cursor value is unavailable")
        return false
    }
    if current == .HostCursor(inner, has_next, value_call, advance) {
        if advance != call {
            jet_eval_compiler_fail(&machine, span, "MIR iterator advance uses a non-canonical cursor route")
            return false
        }
        if inner == {.ForeignHandle(handle, raw, token) -> {
            if !jet_eval_cursor_handle_matches(&machine, handle, raw, token, span) -> return false
        } else -> {
            jet_eval_compiler_fail(&machine, span, "MIR host cursor carries a non-native cursor value")
            return false
        }}
        row :: jet_eval_route_prelude_row(&machine, call, span) ?? return false
        live_inner :: jet_eval_borrow_value(inner, &machine, span) ?? return false
        result :: jet_eval_host_row(&machine, row, [JetEvalRuntimeValue]{live_inner}, result_ty, span) ?? return false
        if !jet_eval_host_runtime_failure(&machine, result, span) -> return false
        if result != (JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) {
            jet_eval_compiler_fail(&machine, span, "MIR iterator advance returned a non-Unit value")
            return false
        }
        machine.frames[frame_index].values[cursor.value] = current
        return true
    }
    jet_eval_compiler_fail(&machine, span, "MIR iterator advance value is not a host cursor")
    false
}

fn jet_eval_operation(machine: &JetEvalMachine, frame_index: Int, operation: MIROperation, result_ty: MIRType?, span: Span) -> JetEvalRuntimeValue? {
    if operation == {
        .Parameter(index, _) -> return jet_eval_parameter(&machine, frame_index, index, span)
        .Capture(slot) -> return jet_eval_capture(&machine, frame_index, slot, span)
        .Global(name) -> {
            if name == "stm" -> return jet_eval_shared_runtime_global(&machine, frame_index, name, span)
            return jet_eval_static(&machine, name, span)
        }
        .Phi(incoming) -> return jet_eval_phi(&machine, frame_index, incoming, span)
        .ReadPlace(place) -> return jet_eval_read_place(&machine, frame_index, place, span)
        .MovePlace(place) -> return jet_eval_move_place(&machine, frame_index, place, span)
        .WritePlace(place, source) | .ReplacePlace(place, source) -> {
            value :: jet_eval_transfer(&machine, frame_index, source, span) ?? return None
            if !jet_eval_write_place(&machine, frame_index, place, value, span) -> return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .InitializeUninit(place) -> {
            value :: jet_eval_uninitialized_value(&machine, frame_index, place, span) ?? return None
            if !jet_eval_write_place(&machine, frame_index, place, value, span) -> return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .Copy(source, fact) -> {
            item :: machine.frames[frame_index].values.get(source.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR copy reads an unavailable SSA value")
                return None
            }
            value :: jet_eval_copy_value(item, &machine, span) ?? return None
            if fact == MIRCopyFact.ViewMaterialize {
                source_ty :: jet_eval_value_type(&machine, frame_index, source, span) ?? return None
                return jet_eval_materialize_view_value(value, source_ty, result_ty, &machine, span)
            }
            return Val(value)
        }
        .Move(source) -> return jet_eval_take(&machine, frame_index, source, span)
        .TraitBox(source, target) -> {
            if !jet_eval_trait_box_target(&machine, target, result_ty, span) -> return None
            value :: jet_eval_take(&machine, frame_index, source, span) ?? return None
            return Val(value)
        }
        .Constant(constant) -> return jet_eval_constant_instruction(&machine, constant, span)
        .Unary(op, source) -> {
            operand_ty :: jet_eval_value_type(&machine, frame_index, source, span) ?? return None
            value_2 :: jet_eval_value(&machine, frame_index, source, span) ?? return None
            return jet_eval_unary(&machine, op, value_2, operand_ty, span)
        }
        .Binary(op, dispatch, _, left, right) -> {
            left_ty :: jet_eval_value_type(&machine, frame_index, left, span) ?? return None
            right_ty :: jet_eval_value_type(&machine, frame_index, right, span) ?? return None
            left_value :: jet_eval_value(&machine, frame_index, left, span) ?? return None
            right_value :: jet_eval_value(&machine, frame_index, right, span) ?? {
                jet_eval_drop_value(&machine, left_value, span)
                return None
            }
            if dispatch == {
                .Prelude(call, location) -> {
                    route_args :: jet_eval_binary_route_args(&machine, call, left_value, right_value, location, span) ?? {
                        jet_eval_drop_value(&machine, left_value, span)
                        jet_eval_drop_value(&machine, right_value, span)
                        return None
                    }
                    result := jet_eval_route_prelude_dispatch(&machine, call, route_args, [MIRType]{}, result_ty, span)
                    return jet_eval_discharge_boundary(&machine, route_args, result, span)
                }
                else -> {}
            }
            result := jet_eval_binary(&machine, op, left_value, right_value, result_ty, left_ty, right_ty, span)
            jet_eval_discharge_boundary(&machine, [JetEvalRuntimeValue]{left_value, right_value}, result, span)
        }
        .BuildString(parts) -> return jet_eval_build_string(&machine, parts, frame_index, span)
        .BuildList(values, _) -> return jet_eval_build_list(&machine, values, frame_index, span)
        .BuildMap(entries) -> return jet_eval_build_map(&machine, entries, frame_index, span)
        .EnumIs(subject, owner, variant) -> {
            data :: jet_eval_data(jet_eval_value(&machine, frame_index, subject, span) ?? return None, &machine, span) ?? return None
            owner_name :: jet_eval_type_name(&machine, owner, span) ?? return None
            if data == .Enum(type_name, found, _) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: jet_eval_enum_owner_matches(machine, type_name, owner_name) && jet_eval_variant_name_matches(found, variant)}})
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
        }
        .EnumPayload(subject, owner, variant, index) -> {
            data :: jet_eval_data(jet_eval_value(&machine, frame_index, subject, span) ?? return None, &machine, span) ?? return None
            owner_name :: jet_eval_type_name(&machine, owner, span) ?? return None
            if data == .Enum(type_name, found, args) {
                if !jet_eval_enum_owner_matches(machine, type_name, owner_name) || !jet_eval_variant_name_matches(found, variant) {
                    jet_eval_compiler_fail(&machine, span, "MIR enum payload variant does not match")
                    return None
                }
                if index < 0 || index >= args.len() {
                    jet_eval_compiler_fail(&machine, span, "MIR enum payload index is out of range")
                    return None
                }
                return Val(JetEvalRuntimeValue.Data{value: args[index].value})
            }
            jet_eval_compiler_fail(&machine, span, "MIR enum payload requires an enum value")
            return None
        }
.OptionIsSome(subject) -> {
    value :: jet_eval_value(&machine, frame_index, subject, span) ?? return None
    if value == .Absent(_) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
    if value == .Data(data) {
        if data == .Failed(_) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
    }
    return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: true}})
}
.OptionValue(subject) -> {
    value :: jet_eval_transfer(&machine, frame_index, subject, span) ?? return None
    if value == .Data(data) {
        if data == .Present(inner) -> return Val(JetEvalRuntimeValue.Data{value: inner})
        return Val(JetEvalRuntimeValue.Data{value: data})
    }
    if value == .Result(ok, nested) {
        if ok -> return Val(nested)
    }
    jet_eval_source_fail(&machine, span, "MIR OptionValue reads an absent option")
    return None
}
.ResultIsOk(subject) -> {
    value :: jet_eval_value(&machine, frame_index, subject, span) ?? return None
    if value == .Result(ok, _) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: ok}})
    if value == .Data(data) {
        if data == .Present(_) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: true}})
        if data == .Failed(_) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
    }
    jet_eval_compiler_fail(&machine, span, "MIR ResultIsOk subject is not a Result")
    return None
}
.ResultValue(subject, ok) -> {
    value :: jet_eval_transfer(&machine, frame_index, subject, span) ?? return None
    if value == .Result(found, nested) {
        if found != ok {
            jet_eval_source_fail(&machine, span, "MIR ResultValue reads the wrong result branch")
            return None
        }
        return Val(nested)
    }
    if value == .Data(data) {
        if {
            ok -> {
                if data == .Present(inner) -> return Val(JetEvalRuntimeValue.Data{value: inner})
            }
            else -> {
                if data == .Failed(report) {
                    if report == .Told(inner) -> return Val(JetEvalRuntimeValue.Data{value: inner})
                }
            }
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR ResultValue reads an unavailable result branch")
    return None
}
.PatternCapture(matched, index) -> {
    value :: jet_eval_value(&machine, frame_index, matched, span) ?? return None
    payload := TComptimeValue?{None}
    if value == .Data(data) {
        if data == .Present(inner) -> payload = Val(inner)
    }
    tuple :: payload ?? {
        jet_eval_compiler_fail(&machine, span, "MIR pattern capture requires a matched carrier")
        return None
    }
    if tuple == .Struct(type_name, fields) {
        if !jet_eval_capture_tuple_canonical(type_name, fields) {
            jet_eval_compiler_fail(&machine, span, "MIR pattern match carrier is not a canonical capture tuple")
            return None
        }
        if index < 0 || index >= fields.len() {
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture index is out of range")
            return None
        }
        extraction_ty :: result_ty ?? {
            jet_eval_compiler_fail(&machine, span, "MIR pattern capture has no extraction type")
            return None
        }
        captured :: jet_eval_marshal_pattern_capture(&machine, fields[index].value, extraction_ty, span) ?? return None
        return Val(JetEvalRuntimeValue.Data{value: captured})
    }
    jet_eval_compiler_fail(&machine, span, "MIR pattern match carrier is not a typed capture tuple")
    return None
}
.PatternMatched(matched) -> {
    value :: jet_eval_value(&machine, frame_index, matched, span) ?? return None
    if value == .Absent(_) -> return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: false}})
    if value == .Data(data) {
        if data == .Present(inner) {
            if inner == .Struct(type_name, fields) {
                if !jet_eval_capture_tuple_canonical(type_name, fields) {
                    jet_eval_compiler_fail(&machine, span, "MIR pattern match carrier payload is not a canonical capture tuple")
                    return None
                }
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: true}})
            }
            jet_eval_compiler_fail(&machine, span, "MIR pattern match carrier payload is not a typed capture tuple")
            return None
        }
    }
    jet_eval_compiler_fail(&machine, span, "MIR pattern match requires its canonical outcome carrier")
    return None
}
.ProjectMembers(base, members) -> {
    output := jet_eval_value(&machine, frame_index, base, span) ?? return None
    loop member in members -> output = jet_eval_field(output, member, &machine, span) ?? return None
    return Val(output)
}
        .Index(_, base, index, kind, _, location, _) -> {
            base_value :: jet_eval_value(&machine, frame_index, base, span) ?? return None
            index_value :: jet_eval_value(&machine, frame_index, index, span) ?? return None
            return jet_eval_index(base_value, index_value, kind, location, &machine, span)
        }
        .Slice(call, base, start, end, range, location) -> {
            path :: jet_eval_route_source_path(&machine, location.file, span) ?? return None
            base_data :: jet_eval_data(jet_eval_value(&machine, frame_index, base, span) ?? return None, &machine, span) ?? return None
            if range == .Val(range_id) {
                range_data :: jet_eval_data(jet_eval_value(&machine, frame_index, range_id, span) ?? return None, &machine, span) ?? return None
                return jet_eval_slice_range(&machine, call, base_data, range_data, path, location.line, result_ty, span)
            }
            start_data :: jet_eval_data(jet_eval_value(&machine, frame_index, start, span) ?? return None, &machine, span) ?? return None
            end_data :: jet_eval_data(jet_eval_value(&machine, frame_index, end, span) ?? return None, &machine, span) ?? return None
            args := [JetEvalRuntimeValue]{
                JetEvalRuntimeValue.Data{value: base_data},
                JetEvalRuntimeValue.Data{value: start_data},
                JetEvalRuntimeValue.Data{value: end_data},
                JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: path}},
                JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: location.line}},
            }
            return jet_eval_route_prelude_dispatch(&machine, call, args, [MIRType]{}, result_ty, span)
        }
        // D-RANGE-VALUE1=A: a Range value is checked data; only LoopRangeInit
        // builds an iteration cursor. Rust: MIREval.rs MirOperation::Range
        .Range(start, end, exclusive) -> {
            start_data :: jet_eval_data(jet_eval_value(&machine, frame_index, start, span) ?? return None, &machine, span) ?? return None
            end_data :: jet_eval_data(jet_eval_value(&machine, frame_index, end, span) ?? return None, &machine, span) ?? return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Struct{type_name: "Range", fields: [TComptimeField]{
                TComptimeField{name: "start", value: start_data},
                TComptimeField{name: "end", value: end_data},
                TComptimeField{name: "exclusive", value: TComptimeValue.Bool{value: exclusive}},
            }}})
        }
        .Field(base, field) -> return jet_eval_field(jet_eval_value(&machine, frame_index, base, span) ?? return None, field, &machine, span)
        .Struct(type_id, fields) -> {
            name :: jet_eval_type_name(&machine, type_id, span) ?? return None
            return jet_eval_aggregate_or_data(&machine, name, fields, frame_index, true, span)
        }
        .Enum(type_id, variant, args) -> {
            name :: jet_eval_type_name(&machine, type_id, span) ?? return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Enum{type_name: name, variant: variant, args: jet_eval_enum_args(&machine, args, frame_index, span) ?? return None}})
        }
        .Tuple(type_id, fields) -> {
            name :: jet_eval_type_name(&machine, type_id, span) ?? return None
            return jet_eval_aggregate_or_data(&machine, name, fields, frame_index, false, span)
        }
        // A closure or runtime aggregate payload stays a runtime carrier;
        // every other payload must be compile-time data.
        // Rust: MIREval.rs MirOperation::Present
        .Present(source) -> {
            item :: machine.frames[frame_index].values.get(source.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR value is unavailable at its use")
                return None
            }
            if item == {
                .Closure(_, _) | .Aggregate(_) -> {
                    owned :: jet_eval_copy_value(item, &machine, span) ?? return None
                    return Val(JetEvalRuntimeValue.Result{ok: true, value: owned})
                }
                else -> {}
            }
            value :: jet_eval_value(&machine, frame_index, source, span) ?? return None
            data :: jet_eval_data(value, &machine, span) ?? return None
            return Val(JetEvalRuntimeValue.Result{ok: true, value: JetEvalRuntimeValue.Data{value: data}})
        }
        .Convert(source, parameters, target, conversion) -> {
            value :: jet_eval_value(&machine, frame_index, source, span) ?? return None
            converted_parameters := [JetEvalRuntimeValue]{}
            loop parameter in parameters -> &converted_parameters.push(jet_eval_value(&machine, frame_index, parameter, span) ?? return None)
            source_ty :: jet_eval_value_type(&machine, frame_index, source, span) ?? return None
            return jet_eval_route_convert(&machine, value, source_ty, converted_parameters, target, conversion, span)
        }
        .Absent -> {
            fallback :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}})
            return Val(JetEvalRuntimeValue.Absent{element: jet_eval_option_element(result_ty ?? fallback)})
        }
        .ResultOk(source) -> return Val(JetEvalRuntimeValue.Result{ok: true, value: jet_eval_value(&machine, frame_index, source, span) ?? return None})
        .ResultErr(source) -> return Val(JetEvalRuntimeValue.Result{ok: false, value: jet_eval_value(&machine, frame_index, source, span) ?? return None})
        .Call(callee, args, type_args) -> return jet_eval_call(&machine, frame_index, callee, args, type_args, result_ty, span)
        .IndirectCall(callee, args, _) -> {
            callee_borrowed := machine.frames[frame_index].borrowed_values.get(callee.value) == (Val(true))
            closure :: jet_eval_value(&machine, frame_index, callee, span) ?? return None
            prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? {
                if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
                return None
            }
            if closure == .Closure(function, captures) {
                wrap_ok :: jet_eval_indirect_call_wraps_ok(&machine, function, result_ty, span) ?? {
                    if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
                    jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
                    return None
                }
                returned :: jet_eval_invoke_with_borrowed_captures(&machine, function, prepared.values, captures, callee_borrowed, span) ?? return None
                if wrap_ok -> return Val(JetEvalRuntimeValue.Result{ok: true, value: returned})
                return Val(returned)
            }
            if !callee_borrowed -> jet_eval_drop_value(&machine, closure, span)
            jet_eval_drop_call_values(&machine, prepared.values, prepared.move_permissions, span)
            jet_eval_compiler_fail(&machine, span, "MIR indirect call target is not a closure")
            return None
        }
        .Closure(function, captures, _) -> {
            output :: jet_eval_closure_captures(&machine, frame_index, function, captures, span) ?? return None
            return Val(JetEvalRuntimeValue.Closure{function: function, captures: output})
        }
        .PtrFromAddr(address, _) -> return jet_eval_value(&machine, frame_index, address, span)
        .Deref(address) -> {
            value :: jet_eval_value(&machine, frame_index, address, span) ?? return None
            if value == .Address(target_frame, target_place, access) {
                if access == MIRAccess.Move {
                    jet_eval_ownership_fail(&machine, span, "MIR dereference uses a move-only address")
                    return None
                }
                return jet_eval_read_place(&machine, target_frame, target_place, span)
            }
            if value == .SharedCell(index, access) {
                if access == MIRAccess.Move {
                    jet_eval_ownership_fail(&machine, span, "MIR dereference uses a move-only shared capture cell")
                    return None
                }
                return jet_eval_shared_read(&machine, index, span)
            }
            jet_eval_compiler_fail(&machine, span, "MIR dereference requires an address")
            return None
        }
        .RawAddressOf(place) -> return Val(JetEvalRuntimeValue.Address{frame: frame_index, place: place, access: MIRAccess.Read})
        .AddressOf(place, access) -> {
            if access == MIRAccess.Read -> return jet_eval_read_place(&machine, frame_index, place, span)
            return Val(JetEvalRuntimeValue.Address{frame: frame_index, place: place, access: access})
        }
        .CoreCall(call, route, args, type_args, fallibility, _) -> {
            prepared :: jet_eval_call_arguments(&machine, frame_index, args, span) ?? return None
            result := jet_eval_route_core(&machine, call, route, prepared.values, type_args, fallibility, result_ty, span)
            return jet_eval_discharge_call_boundary(&machine, prepared.values, prepared.move_permissions, result, span)
        }
        .AttachTag(source, _) -> return jet_eval_value(&machine, frame_index, source, span)
        .Todo(_, _, _) -> {
            jet_eval_unsupported(&machine, span, "MIR Todo operation")
            return None
        }
        .Never(reason) -> {
            jet_eval_compiler_fail(&machine, span, "MIR reached a never operation: {reason}")
            return None
        }
        .Semantic(semantic_operation) -> return jet_eval_semantic(&machine, frame_index, semantic_operation, result_ty, span)
        .LoopRangeInit(_, start, end, step, exclusive) -> return jet_eval_initialize_range(&machine, frame_index, start, end, step, exclusive, span)
        .LoopRangeHasNext(_, cursor) -> {
            value :: jet_eval_loop_cursor(&machine, frame_index, cursor, span) ?? return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: jet_eval_has_next(value, &machine, span) ?? return None}})
        }
        .LoopIterHasNext(call, cursor) -> {
            value :: jet_eval_loop_cursor(&machine, frame_index, cursor, span) ?? return None
            if value == .HostCursor(_, has_next, _, _) -> return jet_eval_host_loop_cursor_call(&machine, value, has_next, call, result_ty, span)
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Bool{value: jet_eval_has_next(value, &machine, span) ?? return None}})
        }
        .LoopRangeValue(_, cursor) -> return jet_eval_cursor_value(jet_eval_loop_cursor(&machine, frame_index, cursor, span) ?? return None, &machine, span)
        .LoopIterValue(call, cursor) -> {
            value :: jet_eval_loop_cursor(&machine, frame_index, cursor, span) ?? return None
            if value == .HostCursor(_, _, value_call, _) -> return jet_eval_host_loop_cursor_call(&machine, value, value_call, call, result_ty, span)
            return jet_eval_cursor_value(value, &machine, span)
        }
        .LoopRangeAdvance(_, cursor) -> {
            if !jet_eval_advance_cursor(&machine, frame_index, cursor, span) -> return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .LoopIterAdvance(call, cursor) -> {
            current :: machine.frames[frame_index].values.get(cursor.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR iterator cursor value is unavailable")
                return None
            }
            if current == .HostCursor(_, _, _, _) {
                if !jet_eval_host_loop_advance(&machine, frame_index, cursor, call, result_ty, span) -> return None
                return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
            }
            if !jet_eval_advance_cursor(&machine, frame_index, cursor, span) -> return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .LoopIterInit(call, collection, step, by_value, source_kind) -> return jet_eval_initialize_iterator(&machine, frame_index, call, collection, step, by_value, source_kind, span)
        .ScopeEnter(scope, test_member) -> {
            function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR scope enter has no owning function")
                return None
            }
            scope_row :: jet_eval_function_scope(machine, function, scope) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR scope enter references an unavailable scope")
                return None
            }
            if test_member != None || scope_row.deadline != None || scope_row.kind == MIRScopeKind.Shield {
                jet_eval_unsupported(&machine, span, "MIR scope control requires runtime scheduler or test state")
                return None
            }
            if scope_row.kind == MIRScopeKind.Transaction {
                if !jet_eval_shared_runtime_scope_enter(&machine, frame_index, scope, span) -> return None
            }
            &machine.frames[frame_index].scopes.push(scope)
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .ScopeExit(scope) -> {
            function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR scope exit has no owning function")
                return None
            }
            scope_row :: jet_eval_function_scope(machine, function, scope) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR scope exit references an unavailable scope")
                return None
            }
            if scope_row.deadline != None || scope_row.kind == MIRScopeKind.Shield {
                jet_eval_unsupported(&machine, span, "MIR scope control requires runtime scheduler or test state")
                return None
            }
            found := -1
            index := 0
            loop index < machine.frames[frame_index].scopes.len() {
                if machine.frames[frame_index].scopes[index] == scope -> found = index
                index += 1
            }
            if found < 0 {
                jet_eval_compiler_fail(&machine, span, "MIR scope exit has no active scope")
                return None
            }
            _ := &machine.frames[frame_index].scopes.remove(found, .Slot)
            if scope_row.kind == MIRScopeKind.Transaction {
                if !jet_eval_shared_runtime_scope_exit(&machine, frame_index, scope, span) -> return None
            }
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
        .Drop(source, _) -> {
            dropped :: jet_eval_take(&machine, frame_index, source, span) ?? return None
            if !jet_eval_close_foreign_value(&machine, dropped, span) -> return None
            return Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
        }
    }
}

fn jet_eval_function_scope(machine: JetEvalMachine, function: Int, id: MIRScopeID) -> MIRScope? {
    loop index in 0..<machine.program.functions[function].scopes.len() {
        if machine.program.functions[function].scopes[index].id == id -> return Val(machine.program.functions[function].scopes[index])
    }
    None
}
fn jet_eval_drop_edge_matches(action: MIRDropEdge, edge: MIRDropEdge) -> Bool Never! {
    if action == .Normal {
        if edge == .Normal -> return true
        return false
    }
    if action == .Return {
        if edge == .Return -> return true
        return false
    }
    if action == .Failure(expected) {
        if edge == .Failure(actual) -> return expected == actual
        return false
    }
    if action == .Unwind(expected) {
        if edge == .Unwind(actual) -> return expected == actual
        return false
    }
    false
}

fn jet_eval_drop_place(machine: &JetEvalMachine, frame_index: Int, place_id: MIRPlaceID, span: Span) -> Bool {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR drop frame function is unavailable")
        return false
    }
    place :: jet_eval_function_place(machine, function, place_id) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR drop targets an unavailable place")
        return false
    }
    if place.projections.len() != 0 -> return true
    removed := JetEvalRuntimeValue?{None}
    if place.base == {
        .Local(local) -> removed = &machine.frames[frame_index].locals.remove(local.value)
        .Parameter(value) | .Temporary(value) -> removed = &machine.frames[frame_index].values.remove(value.value)
        .Capture(_) | .Static(_) -> {}
        else -> {}
    }
    if removed != None {
        dropped :: removed ?? return false
        if !jet_eval_close_foreign_value(&machine, dropped, span) -> return false
    }
    true
}

fn jet_eval_run_drops(machine: &JetEvalMachine, frame_index: Int, edge: MIRDropEdge, span: Span) -> Bool {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR drop frame function is unavailable")
        return false
    }
    loop index in 0..<machine.program.functions[function].drops.len() {
        if jet_eval_drop_edge_matches(machine.program.functions[function].drops[index].edge, edge) {
            place :: machine.program.functions[function].drops[index].place
            if !jet_eval_drop_place(&machine, frame_index, place, span) -> return false
        }
    }
    !jet_eval_has_failure(machine)
}


fn jet_eval_jump(machine: &JetEvalMachine, frame_index: Int, target: MIRBlockID) -> Bool Never! {
    machine.frames[frame_index].predecessor = Val(machine.frames[frame_index].block)
    machine.frames[frame_index].block = target
    machine.frames[frame_index].ip = 0
    true
}

// Every terminator reports at its owning function's span.
// Rust: crates/jet-codegen/src/Codegen/MIREval.rs::execute_terminator
fn jet_eval_terminator(machine: &JetEvalMachine, frame_index: Int, terminator: MIRTerminator) -> JetEvalStep? {
    function :: jet_eval_function_row(machine, machine.frames[frame_index].function) ?? {
        jet_eval_compiler_fail(&machine, jet_eval_empty_span(), "MIR terminator function is unavailable")
        return None
    }
    span :: machine.program.functions[function].span
    if terminator == {
        .Jump(target) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            jet_eval_jump(&machine, frame_index, target)
            return Val(JetEvalStep.Continue)
        }
        .Branch(condition, then_target, else_target) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            value :: jet_eval_bool(jet_eval_value(&machine, frame_index, condition, span) ?? return None, &machine, span) ?? return None
            jet_eval_jump(&machine, frame_index, if value -> then_target else -> else_target)
            return Val(JetEvalStep.Continue)
        }
        .Switch(subject, arms, otherwise) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            subject_value :: machine.frames[frame_index].values.get(subject.value) ?? {
                jet_eval_compiler_fail(&machine, span, "MIR switch subject is unavailable")
                return None
            }
            if !jet_eval_validate_borrow(subject_value, &machine, span) -> return None
            selected := otherwise
            loop arm in arms {
                matches :: jet_eval_bool(jet_eval_value(&machine, frame_index, arm.condition, arm.span) ?? return None, &machine, arm.span) ?? return None
                if matches {
                    selected = arm.target
                    break
                }
            }
            jet_eval_jump(&machine, frame_index, selected)
            return Val(JetEvalStep.Continue)
        }
        // The return value is read before the return drop edge runs. A
        // block-bodied fallible Unit function returns its implicit `Ok(())`.
        .Return(value) -> {
            result := JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}
            owned := false
            if value == .Val(id) {
                result = jet_eval_value(&machine, frame_index, id, span) ?? return None
                owned = machine.frames[frame_index].borrowed_values.get(id.value) != (Val(true))
            }
            if value == None {
                fallible_unit := if machine.program.functions[function].failure == {
                    .Result(success, _) -> mir_type_is_unit(success)
                    else -> false
                }
                if fallible_unit -> result = JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: TComptimeValue.Unit}}
            }
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Return, span) {
                if owned -> jet_eval_drop_value(&machine, result, span)
                return None
            }
            return Val(JetEvalStep.Return{value: result})
        }
        .Yield(_, _) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            jet_eval_unsupported(&machine, span, "MIR generator yield")
            return None
        }
        .Break(target, _) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            jet_eval_jump(&machine, frame_index, target)
            return Val(JetEvalStep.Continue)
        }
        .Continue(target) -> {
            if !jet_eval_run_drops(&machine, frame_index, MIRDropEdge.Normal, span) -> return None
            jet_eval_jump(&machine, frame_index, target)
            return Val(JetEvalStep.Continue)
        }
        .Unreachable(reason) -> {
            jet_eval_compiler_fail(&machine, span, "MIR reached an unreachable terminator: {reason}")
            return None
        }
    }
}
