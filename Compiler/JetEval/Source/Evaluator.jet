    MIRGCEditSiteID,
    MIRGenericParam,
    MIRHTTPMethod,
    MIRHandleID,
    MIRHandleLifecycle,
    MIRHandleOwnership,
    MIRHardwareOp,
    MIRInstruction,
    MIRLayoutCompareOp,
    MIRLocal,
    MIRLoopSourceKind,
    MIROperation,
    MIROwnership,
    MIROwnershipMode,
    MIRPanicContext,
    MIRPanicLoc,
    MIRPhiIncoming,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRProgram,
    MIRRegisterWidth,
