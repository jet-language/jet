name: "jet_eval"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_lexer: ../JetLexer,
    jet_parser: ../JetParser,
    jet_sema: ../JetSema,
    jet_ir: ../JetIR,
    jet_backend: ../JetBackend,
}
layers: {
    foundation: ["jet_foundation"]
    syntax: ["jet_lexer", "jet_parser", "jet_backend"]
    sema: ["jet_sema"]
    codegen: ["jet_ir", "jet_eval"]
}
