use jet_comptime.Comptime.CryptoLite.SHA512.digest
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/SHA512.rs:168
#Test("sha512_abc") {
    actual := digest(b"abc")
    expected := "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
    hex := actual.iter().map(fn(byte) { "{byte:02x}" }).collect::<String>()
    assert(hex == expected)
}
