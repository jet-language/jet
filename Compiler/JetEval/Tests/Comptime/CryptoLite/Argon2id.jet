use jet_comptime.Comptime.CryptoLite.Argon2id.[blake2b, hash]
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:448
#Test("blake2b_matches_rfc7693_abc") {
    actual := blake2b(b"abc", 64)
    expected: [U8] = [
        0xba, 0x80, 0xa5, 0x3f, 0x98, 0x1c, 0x4d, 0x0d, 0x6a, 0x27, 0x97, 0xb6, 0x9f, 0x12,
        0xf6, 0xe9, 0x4c, 0x21, 0x2f, 0x14, 0x68, 0x5a, 0xc4, 0xb7, 0x4b, 0x12, 0xbb, 0x6f,
        0xdb, 0xff, 0xa2, 0xd1, 0x7d, 0x87, 0xc5, 0x39, 0x2a, 0xab, 0x79, 0x2d, 0xc2, 0x52,
        0xd5, 0xde, 0x45, 0x33, 0xcc, 0x95, 0x18, 0xd3, 0x8a, 0xa8, 0xdb, 0xf1, 0x92, 0x5a,
        0xb9, 0x23, 0x86, 0xed, 0xd4, 0x00, 0x99, 0x23,
    ]
    assert(actual == expected)
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:461
#Test("blake2b_exact_block_matches_standard_kat") {
    zero := [U8#128]{uninit}; zero.fill(0)
    actual := blake2b(&zero, 64)
    expected: [U8] = [
        0x86, 0x59, 0x39, 0xe1, 0x20, 0xe6, 0x80, 0x54, 0x38, 0x47, 0x88, 0x41, 0xaf, 0xb7,
        0x39, 0xae, 0x42, 0x50, 0xcf, 0x37, 0x26, 0x53, 0x07, 0x8a, 0x06, 0x5c, 0xdc, 0xff,
        0xfc, 0xa4, 0xca, 0xf7, 0x98, 0xe6, 0xd4, 0x62, 0xb6, 0x5d, 0x65, 0x8f, 0xc1, 0x65,
        0x78, 0x26, 0x40, 0xed, 0xed, 0x70, 0x96, 0x34, 0x49, 0xae, 0x15, 0x00, 0xfb, 0x0f,
        0x24, 0x98, 0x1d, 0x77, 0x27, 0xe2, 0x2c, 0x41,
    ]
    assert(actual == expected)
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/Argon2id.rs:474
#Test("argon2id_matches_standard_known_answer") {
    password := b"password"; salt := b"somesalt"
    out := hash(password, salt, 65_536, 2, 1, 32).expect("argon2id")
    expected: [U8] = [
        0x09, 0x31, 0x61, 0x15, 0xd5, 0xcf, 0x24, 0xed, 0x5a, 0x15, 0xa3, 0x1a, 0x3b, 0xa3,
        0x26, 0xe5, 0xcf, 0x32, 0xed, 0xc2, 0x47, 0x02, 0x98, 0x7c, 0x02, 0xb6, 0x56, 0x6f,
        0x61, 0x91, 0x3c, 0xf7,
    ]
    assert(out == expected)
}
