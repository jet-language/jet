use jet_comptime.Comptime.CryptoLite.ChaCha20Poly1305.[xchacha20poly1305_seal, xchacha20poly1305_open]
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:376
fn hex(text: String) -> [U8] {
    text.as_bytes().chunks_exact(2).map(fn(pair) {
        digit := fn(byte: U8) -> U8 { if byte <= b'9' -> byte - b'0' else -> byte - b'a' + 10 }
        digit(pair[0]) * 16 + digit(pair[1])
    }).collect::<[U8]>()
}
// Rust: crates/jet-comptime/src/Comptime/CryptoLite/ChaCha20Poly1305.rs:393
#Test("cfrg_xchacha_appendix_a31") {
    key := hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    nonce := hex("404142434445464748494a4b4c4d4e4f5051525354555657")
    plaintext := hex("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e")
    aad := hex("50515253c0c1c2c3c4c5c6c7")
    expected := hex("bd6d179d3e83d43b9576579493c0e939572a1700252bfaccbed2902c21396cbb731c7f1b0b4aa6440bf3a82f4eda7e39ae64c6708c54c216cb96b72e1213b4522f8c9ba40db5d945b11b69b982c1bb9e3f3fac2bc369488f76b2383565d3fff921f9664c97637da9768812f615c68b13b52ec0875924c1c7987947deafd8780acf49")
    sealed := xchacha20poly1305_seal(&key, &nonce, &plaintext, &aad).unwrap()
    assert(sealed == expected)
    assert(xchacha20poly1305_open(&key, &nonce, &sealed, &aad).unwrap() == plaintext)
}
