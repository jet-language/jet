use jet_comptime.Comptime.EventLite.*
use jet_foundation.AST.[CtValue, CtReport]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use std.cell.Cell
use std.rc.Rc
use std.collections.VecDeque

// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:39
#Test("subscription_cleanup_runs_once_and_shares_activity") {
    calls := Rc.new(Cell.new(0))
    sub := Subscription.new()
    cleanup_calls := calls.clone()
    sub.set_cleanup(fn() { cleanup_calls.set(cleanup_calls.get() + 1) })
    alias := sub.clone()
    assert(sub.active())
    sub.unsubscribe()
    alias.unsubscribe()
    assert(!alias.active())
    assert_eq(calls.get(), 1)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:326
#Test("scope_cancellation_removes_listeners_and_is_idempotent") {
    reset()
    scope := core_event_scope()
    event := core_event_new()
    sid := handle_id(&scope, "EventScope").unwrap()
    eid := handle_id(&event, "Event").unwrap()
    _ :: event_add(eid, sid, 0, false, CtValue.Unit)
    assert_eq(scope_active_count(sid), 1)
    scope_cancel(sid)
    scope_cancel(sid)
    assert_eq(scope_active_count(sid), 0)
    EVENTS.with(fn(slot) { assert_eq(slot.borrow().get(0).unwrap().as_ref().unwrap().listeners.len(), 0) })
    sub := scope_track(sid, Subscription.new())
    assert(!sub.active())
    reset()
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:518
#Test("dispatch_orders_priority_then_id_and_excludes_inactive") {
    active := Subscription.new()
    inactive := Subscription.new()
    inactive.unsubscribe()
    listeners := [
        Listener { id: 3, priority: 10, once: false, sub: active.clone(), handler: CtValue.Int(3) },
        Listener { id: 2, priority: 10, once: true, sub: active.clone(), handler: CtValue.Int(2) },
        Listener { id: 4, priority: 20, once: false, sub: active.clone(), handler: CtValue.Int(4) },
        Listener { id: 1, priority: 30, once: false, sub: inactive.clone(), handler: CtValue.Int(1) }
    ]
    entries := collect_dispatch(&listeners)
    assert_eq(entries.len(), 3)
    assert_eq(entries[0].1, 4)
    assert_eq(entries[1].1, 2)
    assert_eq(entries[2].1, 3)
    assert(entries[1].2)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:845
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:1079
#Test("async_emit_queues_until_join_and_join_consumes_task") {
    reset()
    event_id := push_async_event(AsyncEventState { listeners: [], capacity: 1, overflow: .Block, failure_policy: .Collect, queued: VecDeque.new(), blocked: VecDeque.new(), running: None, closed: false, cancelled: false })
    scope_id := handle_id(&core_event_scope(), "EventScope").unwrap()
    _ :: async_event_add(event_id, scope_id, 0, false, CtValue.Int(17))
    task := async_event_emit(event_id, CtValue.Int(23))
    id := task_id(&task).unwrap()
    snapshot := task_snapshot(id).unwrap()
    assert_eq(snapshot.3, AsyncPhase.Queued)
    assert(snapshot.4)
    assert(snapshot.5.is_none())
    calls := Cell.new(0)
    invoke := fn(handler: CtValue, args: [CtValue]) -> CtValue Diagnostic! {
        assert_eq(handler, CtValue.Int(17))
        assert_eq(args, [CtValue.Int(23)])
        calls.set(calls.get() + 1)
        CtValue.Unit
    }
    assert_eq(calls.get(), 0)
    result := join_event_task(&task, Span.new(0, 0), &invoke).unwrap()
    assert(match result { .Present(_) => true; _ => false })
    assert_eq(calls.get(), 1)
    assert_eq(task_snapshot(id).unwrap().3, AsyncPhase.Terminal)
    assert(task_snapshot(id).unwrap().6)
    assert(join_event_task(&task, Span.new(0, 0), &invoke).is_err())
    reset()
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:845
#Test("drop_oldest_and_scope_cancel_preserve_task_reports") {
    reset()
    eid := push_async_event(AsyncEventState { listeners: [], capacity: 1, overflow: .DropOldest, failure_policy: .StopFirst, queued: VecDeque.new(), blocked: VecDeque.new(), running: None, closed: false, cancelled: false })
    first := async_event_emit(eid, CtValue.Int(1))
    second := async_event_emit(eid, CtValue.Int(2))
    first_report := task_snapshot(task_id(&first).unwrap()).unwrap().5.unwrap()
    rid := handle_id(&first_report, "DispatchReport").unwrap()
    REPORTS.with(fn(slot) { report := slot.borrow().get(rid.saturating_sub(1) as USize).unwrap().as_ref().unwrap(); assert_eq(report.state, "DroppedOldest"); assert(report.accepted) })
    cancel_async_event(eid)
    second_report := task_snapshot(task_id(&second).unwrap()).unwrap().5.unwrap()
    rid2 := handle_id(&second_report, "DispatchReport").unwrap()
    REPORTS.with(fn(slot) { report := slot.borrow().get(rid2.saturating_sub(1) as USize).unwrap().as_ref().unwrap(); assert_eq(report.state, "Cancelled"); assert(report.accepted) })
    reset()
}
