use jet_foundation.Span
use jet_comptime.CtValue

// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4607
#Test("xml_canonical_rejects_internal_bytes_with_aot_shape_reason") {
    options :: structure("XMLCanonical", [
        ("mode", CtValue.Enum{type_name: "XMLCanonicalMode", variant: "Inclusive11", args: []}),
        ("comments", CtValue.Bool(false)),
        ("inclusive_prefixes", CtValue.List([])),
    ])
    actual :: xml_canonical(&[CtValue.Bytes([U8]{1, 2, 3}), ^options], Span.new(0, 0)).expect("invalid DataTree is a user Result error")
    assert_eq(actual, CtValue.failed(xml_shape_error("XML tree cannot contain Float or Bytes values")))
}

// Rust: crates/jet-comptime/src/Comptime/CorePureParity.rs:4634
#Test("service_lifecycle_display_and_json_use_typed_facts") {
    receipt :: CtValue.Struct{type_name: "DeliveryReceipt", fields: [
        ("id", CtValue.Str("d-1")),
        ("state", CtValue.Enum{type_name: "DeliveryState", variant: "Accepted", args: []}),
        ("attempts", CtValue.Int(1)),
        ("retention_until", CtValue.Int(20)),
        ("deadline", CtValue.Int(30)),
        ("idempotency_key", CtValue.Str("order-1")),
        ("duplicate", CtValue.Bool(false)),
        ("authority", CtValue.Str("orders")),
        ("generation", CtValue.Int(2)),
        ("signature", CtValue.Str("sig")),
    ]}
    assert_eq(display(&receipt), Val("DeliveryReceipt(id=d-1, state=Accepted, attempts=1, retention_until=20, deadline=30, key=order-1, duplicate=false, authority=orders, generation=2, signature=sig)"))
    assert_eq(receipt.to_json(), "{\"id\":\"d-1\",\"state\":\"Accepted\",\"attempts\":1,\"retention_until\":20,\"deadline\":30,\"idempotency_key\":\"order-1\",\"duplicate\":false,\"authority\":\"orders\",\"generation\":2,\"signature\":\"sig\"}")
    error :: CtValue.Enum{type_name: "ServiceError", variant: "Partitioned", args: [(None, CtValue.Str("authority partitioned"))]}
    assert_eq(display(&error), Val("authority partitioned"))
}
