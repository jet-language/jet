// The slot IR interpreter on hand-built modules: structured control and
// calls, the exact Int spill to big integers, fixed-width wrap and trap,
// text routes, frame storage and a List read back as checked data.
use jet_foundation.[Span, TComptimeValue, TTypeDef, Type]
use jet_ir.[IRFunction, IRModule, IROp, IRSlotKind, IRType, IRTypeKind, IRClass, IR_OVERFLOW_TRAP, IR_OVERFLOW_WRAP, ir_args, ir_depth, ir_emit, ir_end, ir_function_new, ir_intern_name, ir_intern_text, ir_intern_type, ir_module_new, ir_open, ir_open_if, ir_slot]
use jet_eval.[JetEvalIRResult, jet_eval_default_config, jet_eval_ir_entry]

fn ir_machine_require(ok: Bool, message: String) Never! {
    if !ok -> panic("IRMachine: {message}")
}

fn ir_machine_int_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "Int", IRType{ty: Type.Int, kind: IRTypeKind.Int, size: 8, align: 8, class: IRClass.Integer, signed: true, bits: 64, drop: "jet_rt_int_drop"})
}

fn ir_machine_bool_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "Bool", IRType{ty: Type.Bool, kind: IRTypeKind.Bool, size: 1, align: 1, class: IRClass.Integer, signed: false, bits: 8, drop: ""})
}

fn ir_machine_u8_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "U8", IRType{ty: Type.IntN{signed: false, bits: 8}, kind: IRTypeKind.Word, size: 1, align: 1, class: IRClass.Integer, signed: false, bits: 8, drop: ""})
}

fn ir_machine_word_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "I64", IRType{ty: Type.IntN{signed: true, bits: 64}, kind: IRTypeKind.Word, size: 8, align: 8, class: IRClass.Integer, signed: true, bits: 64, drop: ""})
}

fn ir_machine_string_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "String", IRType{ty: Type.String, kind: IRTypeKind.String, size: 8, align: 8, class: IRClass.Pointer, signed: false, bits: 64, drop: "jet_rt_string_drop"})
}

fn ir_machine_run(built: ^IRModule) -> JetEvalIRResult {
    jet_eval_ir_entry(^built, [TTypeDef]{}, jet_eval_default_config(), Span{start: 0, end: 0})
}

// fn sum(n: Int) -> Int: the sum of 0..<n by a Block/Loop walk.
fn ir_machine_sum(m: &IRModule) -> IRFunction Never! {
    int :: ir_machine_int_row(&m)
    bool :: ir_machine_bool_row(&m)
    f := ir_function_new("sum", "sum", "sum", "ir.jet", 1)
    n :: ir_slot(&f, int, IRSlotKind.Param, ir_intern_name(&m, "n"), 1)
    f.result = int
    total :: ir_slot(&f, int, IRSlotKind.Local, ir_intern_name(&m, "total"), 1)
    i :: ir_slot(&f, int, IRSlotKind.Local, ir_intern_name(&m, "i"), 1)
    one :: ir_slot(&f, int, IRSlotKind.Temp, -1, 1)
    done :: ir_slot(&f, bool, IRSlotKind.Temp, -1, 1)
    ir_emit(&f, IROp.Const, total, 0, -1, -1, 1)
    ir_emit(&f, IROp.Const, i, 0, -1, -1, 1)
    ir_emit(&f, IROp.Const, one, 1, -1, -1, 1)
    exit :: ir_open(&f, IROp.Block, 2)
    head :: ir_open(&f, IROp.Loop, 2)
    ir_emit(&f, IROp.Ge, done, i, n, -1, 2)
    ir_emit(&f, IROp.BrIf, -1, done, ir_depth(f, exit), -1, 2)
    ir_emit(&f, IROp.Add, total, total, i, IR_OVERFLOW_TRAP, 3)
    ir_emit(&f, IROp.Add, i, i, one, IR_OVERFLOW_TRAP, 3)
    ir_emit(&f, IROp.Br, -1, ir_depth(f, head), -1, -1, 3)
    ir_end(&f, 3)
    ir_end(&f, 3)
    ir_emit(&f, IROp.Return, -1, total, -1, -1, 4)
    f
}

#Test("ir_machine_control_and_calls") {
    m := ir_module_new()
    int :: ir_machine_int_row(&m)
    &m.functions.push(ir_machine_sum(&m))
    run := ir_function_new("run", "run", "run", "ir.jet", 5)
    run.result = int
    ten :: ir_slot(&run, int, IRSlotKind.Temp, -1, 5)
    out :: ir_slot(&run, int, IRSlotKind.Temp, -1, 5)
    ir_emit(&run, IROp.Const, ten, 10, -1, -1, 5)
    start :: ir_args(&run, [Int]{ten})
    ir_emit(&run, IROp.Call, out, 0, start, 1, 5)
    ir_emit(&run, IROp.Return, -1, out, -1, -1, 5)
    &m.functions.push(run)
    m.entry = 1
    result :: ir_machine_run(^m)
    ir_machine_require(result.complete, "sum(10) completes: {result.internal_problem} {result.error}")
    ir_machine_require(result.value == (Val(TComptimeValue.Int{value: 45})), "sum(10) is 45, got {result.value}")
}

#Test("ir_machine_exact_int_spill") {
    m := ir_module_new()
    int :: ir_machine_int_row(&m)
    run := ir_function_new("run", "run", "run", "ir.jet", 1)
    run.result = int
    a :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    b :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    c :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    d :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    ir_emit(&run, IROp.Const, a, 4611686018427387903, -1, -1, 1)
    ir_emit(&run, IROp.Const, b, 4611686018427387903, -1, -1, 1)
    ir_emit(&run, IROp.Mul, c, a, b, IR_OVERFLOW_TRAP, 1)
    ir_emit(&run, IROp.FloorDiv, d, c, a, IR_OVERFLOW_TRAP, 1)
    ir_emit(&run, IROp.Return, -1, c, -1, -1, 1)
    &m.functions.push(run)
    m.entry = 0
    result :: ir_machine_run(^m)
    expected :: 4611686018427387903 * 4611686018427387903
    ir_machine_require(result.value == (Val(TComptimeValue.Int{value: expected})), "a big product spills exactly, got {result.value}")
}

#Test("ir_machine_fixed_width") {
    m := ir_module_new()
    u8 :: ir_machine_u8_row(&m)
    wrap := ir_function_new("run", "run", "run", "ir.jet", 1)
    wrap.result = u8
    a :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    b :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    c :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    ir_emit(&wrap, IROp.Const, a, 250, -1, -1, 1)
    ir_emit(&wrap, IROp.Const, b, 10, -1, -1, 1)
    ir_emit(&wrap, IROp.Add, c, a, b, IR_OVERFLOW_WRAP, 1)
    ir_emit(&wrap, IROp.Return, -1, c, -1, -1, 1)
    &m.functions.push(wrap)
    m.entry = 0
    wrapped :: ir_machine_run(^m)
    ir_machine_require(wrapped.value == (Val(TComptimeValue.Int{value: 4})), "250 + 10 wraps to 4 in U8, got {wrapped.value}")
    t := ir_module_new()
    t8 :: ir_machine_u8_row(&t)
    trap := ir_function_new("run", "run", "run", "ir.jet", 1)
    trap.result = t8
    x :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    y :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    z :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    ir_emit(&trap, IROp.Const, x, 250, -1, -1, 1)
    ir_emit(&trap, IROp.Const, y, 10, -1, -1, 1)
    ir_emit(&trap, IROp.Add, z, x, y, IR_OVERFLOW_TRAP, 1)
    ir_emit(&trap, IROp.Return, -1, z, -1, -1, 1)
    &t.functions.push(trap)
    t.entry = 0
    trapped :: ir_machine_run(^t)
    ir_machine_require(!trapped.complete && trapped.error != None, "a checked U8 overflow stops")
}

#Test("ir_machine_text_and_list") {
    m := ir_module_new()
    text :: ir_machine_string_row(&m)
    word :: ir_machine_word_row(&m)
    list :: ir_intern_type(&m, "[String]", IRType{ty: Type.List{element: Type.String}, kind: IRTypeKind.Aggregate, size: 24, align: 8, class: IRClass.Pointer, signed: false, bits: 64, drop: ""})
    run := ir_function_new("run", "run", "run", "ir.jet", 1)
    run.result = list
    hello :: ir_slot(&run, text, IRSlotKind.Temp, -1, 1)
    world :: ir_slot(&run, text, IRSlotKind.Temp, -1, 1)
    joined :: ir_slot(&run, text, IRSlotKind.Temp, -1, 1)
    upper :: ir_slot(&run, text, IRSlotKind.Temp, -1, 1)
    header :: ir_slot(&run, list, IRSlotKind.Temp, -1, 1)
    data :: ir_slot(&run, word, IRSlotKind.Temp, -1, 1)
    two :: ir_slot(&run, word, IRSlotKind.Temp, -1, 1)
    bytes :: ir_slot(&run, word, IRSlotKind.Temp, -1, 1)
    align :: ir_slot(&run, word, IRSlotKind.Temp, -1, 1)
    ir_emit(&run, IROp.ConstText, hello, ir_intern_text(&m, "hello, "), -1, -1, 1)
    ir_emit(&run, IROp.ConstText, world, ir_intern_text(&m, "world"), -1, -1, 1)
    ir_emit(&run, IROp.Concat, joined, hello, world, -1, 1)
    start :: ir_args(&run, [Int]{joined})
    ir_emit(&run, IROp.CallRuntime, upper, ir_intern_name(&m, "jet_unicode_upper"), start, 1, 1)
    ir_emit(&run, IROp.StackAddress, header, 24, 8, -1, 1)
    ir_emit(&run, IROp.Const, two, 2, -1, -1, 1)
    ir_emit(&run, IROp.Const, bytes, 16, -1, -1, 1)
    ir_emit(&run, IROp.Const, align, 8, -1, -1, 1)
    alloc :: ir_args(&run, [Int]{bytes, align})
    ir_emit(&run, IROp.CallRuntime, data, ir_intern_name(&m, "jet_rt_alloc"), alloc, 2, 1)
    ir_emit(&run, IROp.Store, -1, data, 0, joined, 1)
    ir_emit(&run, IROp.Store, -1, data, 8, upper, 1)
    ir_emit(&run, IROp.Store, -1, header, 0, two, 1)
    ir_emit(&run, IROp.Store, -1, header, 8, two, 1)
    ir_emit(&run, IROp.Store, -1, header, 16, data, 1)
    ir_emit(&run, IROp.Return, -1, header, -1, -1, 1)
    &m.functions.push(run)
    m.entry = 0
    result :: ir_machine_run(^m)
    expected :: TComptimeValue.List{values: [TComptimeValue]{TComptimeValue.String{value: "hello, world"}, TComptimeValue.String{value: "HELLO, WORLD"}}}
    ir_machine_require(result.value == Val(expected), "a List of two texts reads back, got {result.value} {result.internal_problem}")
}
