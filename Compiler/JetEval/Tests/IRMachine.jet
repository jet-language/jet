// The slot IR interpreter on hand-built modules: structured control and
// calls, fixed-width wrap and trap, and runtime routes run on a hand-built
// runtime module installed as the runtime pack's IR (an init hook, exports,
// `#FFI(asm)` leaves over an anonymous mapping, a ConstText String).
use jet_foundation.[Span, TComptimeValue, Type]
use jet_ir.[IRAsmLeaf, IRFunction, IRLibraryExport, IRModule, IROp, IRSlotKind, IRType, IRTypeKind, IRClass, IR_OVERFLOW_TRAP, IR_OVERFLOW_WRAP, ir_args, ir_depth, ir_emit, ir_end, ir_function_new, ir_intern_name, ir_intern_text, ir_intern_type, ir_module_encode, ir_module_new, ir_open, ir_slot]
use jet_eval.[JetEvalConfig, JetEvalIRResult, jet_eval_default_config, jet_eval_ir_entry, jet_eval_runtime_ir]

fn ir_machine_require(ok: Bool, message: String) Never! {
    if !ok -> panic("IRMachine: {message}")
}

// The headline of the diagnostic a stopped run reports ("" when none).
fn ir_machine_error_what(result: JetEvalIRResult) -> String Never! {
    if result.error == .Val(error) -> return error.diagnostic.what.copy()
    ""
}

fn ir_machine_int_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "Int", IRType{ty: Type.Int, kind: IRTypeKind.Int, size: 8, align: 8, class: IRClass.Integer, signed: true, bits: 64, drop: "jet_rt_int_drop"})
}

fn ir_machine_bool_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "Bool", IRType{ty: Type.Bool, kind: IRTypeKind.Bool, size: 1, align: 1, class: IRClass.Integer, signed: false, bits: 8, drop: ""})
}

fn ir_machine_u8_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "U8", IRType{ty: Type.IntN{signed: false, bits: 8}, kind: IRTypeKind.Word, size: 1, align: 1, class: IRClass.Integer, signed: false, bits: 8, drop: ""})
}

fn ir_machine_word_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "I64", IRType{ty: Type.IntN{signed: true, bits: 64}, kind: IRTypeKind.Word, size: 8, align: 8, class: IRClass.Integer, signed: true, bits: 64, drop: ""})
}

fn ir_machine_string_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "String", IRType{ty: Type.String, kind: IRTypeKind.String, size: 8, align: 8, class: IRClass.Pointer, signed: false, bits: 64, drop: "jet_rt_string_drop"})
}

fn ir_machine_run(built: ^IRModule) -> JetEvalIRResult {
    ir_machine_run_with(^built, jet_eval_default_config())
}

fn ir_machine_run_with(built: ^IRModule, config: JetEvalConfig) -> JetEvalIRResult {
    entry :: built.entry
    jet_eval_ir_entry(^built, entry, config, Span{start: 0, end: 0})
}

// fn sum(n: Int) -> Int: the sum of 0..<n by a Block/Loop walk.
fn ir_machine_sum(m: &IRModule) -> IRFunction Never! {
    int :: ir_machine_int_row(&m)
    bool :: ir_machine_bool_row(&m)
    f := ir_function_new("sum", "sum", "sum", "ir.jet", 1)
    n :: ir_slot(&f, int, IRSlotKind.Param, ir_intern_name(&m, "n"), 1)
    f.result = int
    total :: ir_slot(&f, int, IRSlotKind.Local, ir_intern_name(&m, "total"), 1)
    i :: ir_slot(&f, int, IRSlotKind.Local, ir_intern_name(&m, "i"), 1)
    one :: ir_slot(&f, int, IRSlotKind.Temp, -1, 1)
    done :: ir_slot(&f, bool, IRSlotKind.Temp, -1, 1)
    ir_emit(&f, IROp.Const, total, 0, -1, -1, 1)
    ir_emit(&f, IROp.Const, i, 0, -1, -1, 1)
    ir_emit(&f, IROp.Const, one, 1, -1, -1, 1)
    exit :: ir_open(&f, IROp.Block, 2)
    head :: ir_open(&f, IROp.Loop, 2)
    ir_emit(&f, IROp.Ge, done, i, n, -1, 2)
    exit_depth :: ir_depth(f, exit)
    ir_emit(&f, IROp.BrIf, -1, done, exit_depth, -1, 2)
    ir_emit(&f, IROp.Add, total, total, i, IR_OVERFLOW_TRAP, 3)
    ir_emit(&f, IROp.Add, i, i, one, IR_OVERFLOW_TRAP, 3)
    head_depth :: ir_depth(f, head)
    ir_emit(&f, IROp.Br, -1, head_depth, -1, -1, 3)
    ir_end(&f, 3)
    ir_end(&f, 3)
    ir_emit(&f, IROp.Return, -1, total, -1, -1, 4)
    f
}

#Test("ir_machine_control_and_calls") {
    m := ir_module_new()
    int :: ir_machine_int_row(&m)
    sum :: ir_machine_sum(&m)
    &m.functions.push(sum)
    run := ir_function_new("run", "run", "run", "ir.jet", 5)
    run.result = int
    ten :: ir_slot(&run, int, IRSlotKind.Temp, -1, 5)
    out :: ir_slot(&run, int, IRSlotKind.Temp, -1, 5)
    ir_emit(&run, IROp.Const, ten, 10, -1, -1, 5)
    start :: ir_args(&run, [Int]{ten})
    ir_emit(&run, IROp.Call, out, 0, start, 1, 5)
    ir_emit(&run, IROp.Return, -1, out, -1, -1, 5)
    &m.functions.push(run)
    m.entry = 1
    result :: ir_machine_run(^m)
    ir_machine_require(result.complete, "sum(10) completes: {result.internal_problem} {result.error}")
    ir_machine_require(result.value == (Val(TComptimeValue.Int{value: 45})), "sum(10) is 45, got {result.value}")
}


#Test("ir_machine_fixed_width") {
    m := ir_module_new()
    u8 :: ir_machine_u8_row(&m)
    wrap := ir_function_new("run", "run", "run", "ir.jet", 1)
    wrap.result = u8
    a :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    b :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    c :: ir_slot(&wrap, u8, IRSlotKind.Temp, -1, 1)
    ir_emit(&wrap, IROp.Const, a, 250, -1, -1, 1)
    ir_emit(&wrap, IROp.Const, b, 10, -1, -1, 1)
    ir_emit(&wrap, IROp.Add, c, a, b, IR_OVERFLOW_WRAP, 1)
    ir_emit(&wrap, IROp.Return, -1, c, -1, -1, 1)
    &m.functions.push(wrap)
    m.entry = 0
    wrapped :: ir_machine_run(^m)
    ir_machine_require(wrapped.value == (Val(TComptimeValue.Int{value: 4})), "250 + 10 wraps to 4 in U8, got {wrapped.value}")
    t := ir_module_new()
    t8 :: ir_machine_u8_row(&t)
    trap := ir_function_new("run", "run", "run", "ir.jet", 1)
    trap.result = t8
    x :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    y :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    z :: ir_slot(&trap, t8, IRSlotKind.Temp, -1, 1)
    ir_emit(&trap, IROp.Const, x, 250, -1, -1, 1)
    ir_emit(&trap, IROp.Const, y, 10, -1, -1, 1)
    ir_emit(&trap, IROp.Add, z, x, y, IR_OVERFLOW_TRAP, 1)
    ir_emit(&trap, IROp.Return, -1, z, -1, -1, 1)
    &t.functions.push(trap)
    t.entry = 0
    trapped :: ir_machine_run(^t)
    ir_machine_require(!trapped.complete && trapped.error != None, "a checked U8 overflow stops")
}


// An exact Int product past the inline range is the runtime's jet_int_mul:
// without the runtime pack's IR it is unsupported, never computed by hand.
#Test("ir_machine_exact_int_needs_runtime") {
    m := ir_module_new()
    int :: ir_machine_int_row(&m)
    run := ir_function_new("run", "run", "run", "ir.jet", 1)
    run.result = int
    a :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    small :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    c :: ir_slot(&run, int, IRSlotKind.Temp, -1, 1)
    ir_emit(&run, IROp.Const, a, 4611686018427387903, -1, -1, 1)
    ir_emit(&run, IROp.Const, small, 3, -1, -1, 1)
    ir_emit(&run, IROp.Mul, c, small, small, IR_OVERFLOW_TRAP, 1)
    ir_emit(&run, IROp.Mul, c, a, c, IR_OVERFLOW_TRAP, 1)
    ir_emit(&run, IROp.Return, -1, c, -1, -1, 1)
    &m.functions.push(run)
    m.entry = 0
    result :: ir_machine_run(^m)
    ir_machine_require(!result.complete && result.error != None && result.internal_problem == None, "a spilling product without the runtime is unsupported, got {result.value} {result.internal_problem}")
    what :: ir_machine_error_what(result)
    ir_machine_require(what == "Compile-time evaluation of runtime route `jet_int_mul` needs the runtime pack's IR", "a runtime route without the runtime IR names the missing pack, got {what}")
}

// An `#FFI(asm)` leaf: no body; the machine answers it by name.
fn ir_machine_leaf(m: &IRModule, name: String, params: Int, word: Int) -> IRFunction Never! {
    f := ir_function_new(name, name, name, "Linux.jet", 1)
    loop index in 0..<params {
        param :: ir_slot(&f, word, IRSlotKind.Param, ir_intern_name(&m, "p{index}"), 1)
    }
    f.result = word
    f.asm = Val(IRAsmLeaf{code: [U8]{}, regs: [Int]{}, result: 0})
    f
}

// A runtime module: rt_init (init hook) maps a page through the syscall
// leaf, keeps its address in data row `cell` and stores 42 there through
// os_store_i64; jet_test_answer loads it back through os_load_i64;
// jet_test_hello returns a ConstText String.
fn ir_machine_runtime() -> [U8] Never! {
    r := ir_module_new()
    word :: ir_machine_word_row(&r)
    text :: ir_machine_string_row(&r)
    cell :: r.data.len()
    &r.data.push([U8]{U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}})
    syscall_leaf := ir_machine_leaf(&r, "os_syscall_i64", 7, word)
    &r.functions.push(syscall_leaf)
    store_leaf := ir_machine_leaf(&r, "os_store_i64", 2, word)
    &r.functions.push(store_leaf)
    load_leaf := ir_machine_leaf(&r, "os_load_i64", 1, word)
    &r.functions.push(load_leaf)
    init := ir_function_new("rt_init", "rt_init", "rt_init", "rt.jet", 1)
    number :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    zero :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    size :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    prot :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    flags :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    none :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    page :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    at :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    answer :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    ignored :: ir_slot(&init, word, IRSlotKind.Temp, -1, 1)
    ir_emit(&init, IROp.Const, number, 9, -1, -1, 1)
    ir_emit(&init, IROp.Const, zero, 0, -1, -1, 1)
    ir_emit(&init, IROp.Const, size, 4096, -1, -1, 1)
    ir_emit(&init, IROp.Const, prot, 3, -1, -1, 1)
    ir_emit(&init, IROp.Const, flags, 34, -1, -1, 1)
    ir_emit(&init, IROp.Const, none, -1, -1, -1, 1)
    map :: ir_args(&init, [Int]{number, zero, size, prot, flags, none, zero})
    ir_emit(&init, IROp.Call, page, 0, map, 7, 1)
    ir_emit(&init, IROp.DataAddress, at, cell, -1, -1, 1)
    ir_emit(&init, IROp.Store, -1, at, 0, page, 1)
    ir_emit(&init, IROp.Const, answer, 42, -1, -1, 1)
    store :: ir_args(&init, [Int]{page, answer})
    ir_emit(&init, IROp.Call, ignored, 1, store, 2, 1)
    ir_emit(&init, IROp.Return, -1, -1, -1, -1, 1)
    &r.functions.push(init)
    read := ir_function_new("rt_answer", "rt_answer", "jet_test_answer", "rt.jet", 1)
    read.result = word
    slot :: ir_slot(&read, word, IRSlotKind.Temp, -1, 1)
    held :: ir_slot(&read, word, IRSlotKind.Temp, -1, 1)
    value :: ir_slot(&read, word, IRSlotKind.Temp, -1, 1)
    ir_emit(&read, IROp.DataAddress, slot, cell, -1, -1, 1)
    ir_emit(&read, IROp.Load, held, slot, 0, -1, 1)
    load :: ir_args(&read, [Int]{held})
    ir_emit(&read, IROp.Call, value, 2, load, 1, 1)
    ir_emit(&read, IROp.Return, -1, value, -1, -1, 1)
    &r.functions.push(read)
    hello := ir_function_new("rt_hello", "rt_hello", "jet_test_hello", "rt.jet", 1)
    hello.result = text
    greeting :: ir_slot(&hello, text, IRSlotKind.Temp, -1, 1)
    ir_emit(&hello, IROp.ConstText, greeting, ir_intern_text(&r, "hello"), -1, -1, 1)
    ir_emit(&hello, IROp.Return, -1, greeting, -1, -1, 1)
    &r.functions.push(hello)
    exports :: [IRLibraryExport]{
        IRLibraryExport{function: 3, symbol: "rt_init", init_priority: 0, fini_priority: -1},
        IRLibraryExport{function: 4, symbol: "jet_test_answer", init_priority: -1, fini_priority: -1},
        IRLibraryExport{function: 5, symbol: "jet_test_hello", init_priority: -1, fini_priority: -1},
    }
    ir_module_encode(r, exports)
}

// An item module calling runtime route `symbol` (no arguments) and
// returning its result (a String when `string`, else an I64).
fn ir_machine_route_item(symbol: String, string: Bool) -> IRModule Never! {
    m := ir_module_new()
    row :: if string -> ir_machine_string_row(&m) else -> ir_machine_word_row(&m)
    run := ir_function_new("run", "run", "run", "ir.jet", 1)
    run.result = row
    out :: ir_slot(&run, row, IRSlotKind.Temp, -1, 1)
    start :: ir_args(&run, [Int]{})
    ir_emit(&run, IROp.CallRuntime, out, ir_intern_name(&m, symbol), start, 0, 1)
    ir_emit(&run, IROp.Return, -1, out, -1, -1, 1)
    &m.functions.push(run)
    m.entry = 0
    m
}

fn ir_machine_runtime_config() -> JetEvalConfig Never! {
    config := jet_eval_default_config()
    config.runtime_ir = Val(jet_eval_runtime_ir(ir_machine_runtime()))
    config
}

#Test("ir_machine_runtime_routes") {
    answer :: ir_machine_run_with(ir_machine_route_item("jet_test_answer", false), ir_machine_runtime_config())
    ir_machine_require(answer.value == (Val(TComptimeValue.Int{value: 42})), "the init hook's page holds 42, got {answer.value} {answer.internal_problem} {answer.error}")
    hello :: ir_machine_run_with(ir_machine_route_item("jet_test_hello", true), ir_machine_runtime_config())
    ir_machine_require(hello.value == (Val(TComptimeValue.String{value: "hello"})), "a runtime ConstText reads back, got {hello.value} {hello.internal_problem} {hello.error}")
    missing :: ir_machine_run_with(ir_machine_route_item("jet_test_missing", false), ir_machine_runtime_config())
    ir_machine_require(!missing.complete && missing.error != None && missing.internal_problem == None, "an unknown runtime symbol is unsupported, got {missing.value} {missing.internal_problem}")
    unknown :: ir_machine_error_what(missing)
    ir_machine_require(unknown == "Compile-time evaluation does not implement `IR runtime route `jet_test_missing``", "an unknown runtime symbol is named, got {unknown}")
}
