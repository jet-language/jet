use jet_comptime.Comptime.CryptoLite.[Aes256Gcm, Argon2id]

// Rust: crates/jet-comptime/tests/crypto_lite.rs:7
// GATE #4494: compile-time source embedding reads the canonical Jet implementation, never Rust.
AES_SOURCE :: include_str("../../Source/Comptime/CryptoLite/Aes256Gcm.jet")
// Rust: crates/jet-comptime/tests/crypto_lite.rs:8
ARGON2_SOURCE :: include_str("../../Source/Comptime/CryptoLite/Argon2id.jet")

// Rust: crates/jet-comptime/tests/crypto_lite.rs:10
fn hex(text: String) -> [U8] {
    bytes := [U8]{}
    loop pair in text.as_bytes().chunks_exact(2) {
        digit :: fn(byte: U8) -> U8 {
            if byte >= b'0' && byte <= b'9' -> byte - b'0'
            else if byte >= b'a' && byte <= b'f' -> byte - b'a' + 10
            else -> panic("invalid hex test vector")
        }
        bytes.push(digit(pair[0]) * 16 + digit(pair[1]))
    }
    ^bytes
}
// Rust: crates/jet-comptime/tests/crypto_lite.rs:25
#Test("aes256gcm_known_answer_has_no_secret_table_or_ghash_branch") {
    key :: hex("b52c505a37d78eda5dd34f20c22540ea1b58963cf8e5bf8ffa85f9f2492505b4")
    nonce :: hex("516c33929df5a3284ff463d7")
    expected :: hex("bdc1ac884d332457a1d2664f168c76f0")
    sealed :: Aes256Gcm.seal(&key, &nonce, &[U8]{}, &[U8]{})!
    assert_eq(sealed, expected)
    assert_eq(Aes256Gcm.open(&key, &nonce, &sealed, &[U8]{})!, [U8]{})
    assert(!AES_SOURCE.contains("SBOX["), "secret-indexed AES table was reintroduced")
    ghash :: AES_SOURCE.split_once("fn ghash_mul").and_then(fn((_, rest)) -> rest.split_once("fn ghash(")).map(fn((body, _)) -> body).expect("GHASH implementation must remain present")
    assert(!ghash.contains("if "), "GHASH must not branch on secret state")
}
// Rust: crates/jet-comptime/tests/crypto_lite.rs:43
#Test("argon2id_matches_the_canonical_expert_known_answer") {
    actual :: Argon2id.hash(b"password", b"somesalt", 65_536, 2, 1, 32)!
    expected :: hex("09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7")
    assert_eq(actual, expected)
    assert(!ARGON2_SOURCE.contains("Simplified independent address generation"), "the non-standard address generator must not return")
    assert(ARGON2_SOURCE.contains("update_address_block") && ARGON2_SOURCE.contains("address_block[address_index]") && ARGON2_SOURCE.contains("area as U64 * x"), "the standard address generator must be wired into the block loop")
}
// Rust: crates/jet-comptime/tests/crypto_lite.rs:60
#Test("argon2id_parallel_lanes_match_the_expert_known_answer") {
    actual :: Argon2id.hash(b"password", b"somesalt", 8_192, 2, 2, 32)!
    expected :: hex("d1e83aa7383f70873a171b453206a00daca5340f3505542e17b41ed62d3b110e")
    assert_eq(actual, expected)
}
