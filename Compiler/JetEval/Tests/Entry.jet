use jet_comptime.Entry.JetShow
use jet_foundation.AST.CtValue

// Behavioral control for Rust lib.rs:27-31; no original inline Rust tests.
#Test("comptime_jet_show_trait_uses_canonical_value_display") {
    value :: CtValue.Int(42)
    assert_eq(JetShow.jet_show(value), CtValue.jet_show(value))
    assert_eq(JetShow.jet_show(value), "42")
    text :: CtValue.Str("group key")
    assert_eq(JetShow.jet_show(text), CtValue.jet_show(text))
}
