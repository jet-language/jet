// Focused Source evaluator fixture for owned-reference task-root ownership.
// This file is loaded only by the bootstrap fixture harness, never by
// sources.list. Every registry-naming runtime value is one owned alias:
// jet_eval_copy_value mints one, jet_eval_drop_value discharges one, moves
// transfer without counting. The fixture asserts exact alias arithmetic across
// a parent machine, a FnOnce task child, a reusable-root failure child, and
// the shared session registry; no machine inventory ledger exists to assert.
//
// Child and unrelated cursor tokens whose last aliases die in this fixture
// are first marked consumed by native, so their last discharge resolves as
// Detached. The primary cursor is supplied by the harness as a real
// arena-registered handle/raw pair; its final alias exercises the
// adapter-backed physical release path and Last-alias close.

struct JetEvalTaskRootsSharedPayload {
    marker: Int
    nested: Shared<Int>
}

fn jet_eval_task_roots_fixture_contains_target(value: JetEvalRuntimeValue, target: Int, cell_target: Bool) -> Bool {
    if value == {
        .SharedCell(index, _) -> return cell_target && index == target
        .ForeignHandle(_, _, token) -> return !cell_target && token == target
        .Result(_, nested) | .RuntimeFailure(nested, _) -> return jet_eval_task_roots_fixture_contains_target(nested, target, cell_target)
        .Closure(_, captures) -> loop capture in captures {
            if jet_eval_task_roots_fixture_contains_target(capture, target, cell_target) -> return true
        }
        .Aggregate(aggregate) -> {
            if aggregate == {
                .List(values) -> loop item in values {
                    if jet_eval_task_roots_fixture_contains_target(item, target, cell_target) -> return true
                }
                .Map(entries) -> loop entry in entries {
                    if jet_eval_task_roots_fixture_contains_target(entry.key, target, cell_target) || jet_eval_task_roots_fixture_contains_target(entry.value, target, cell_target) -> return true
                }
                .Struct(_, fields) -> loop field in fields {
                    if jet_eval_task_roots_fixture_contains_target(field.value, target, cell_target) -> return true
                }
                .Enum(_, _, args) -> loop arg in args {
                    if jet_eval_task_roots_fixture_contains_target(arg.value, target, cell_target) -> return true
                }
            }
        }
        else -> {}
    }
    false
}

fn jet_eval_task_roots_fixture_list_contains(value: JetEvalRuntimeValue, cell: Int, token: Int) -> Bool {
    jet_eval_task_roots_fixture_contains_target(value, cell, true) && jet_eval_task_roots_fixture_contains_target(value, token, false)
}

fn jet_eval_task_roots_fixture_shared_cell_index(value: JetEvalRuntimeValue) -> Int? {
    if value == {
        .SharedCell(index, _) -> Val(index)
        else -> None
    }
}

fn jet_eval_task_roots_fixture_foreign_token(value: JetEvalRuntimeValue) -> Int? {
    if value == {
        .ForeignHandle(_, _, token) -> Val(token)
        else -> None
    }
}

fn jet_eval_task_roots_fixture_int_data(value: JetEvalRuntimeValue) -> Int? {
    if value == .Data(.Int(number)) -> return Val(number)
    None
}

fn jet_eval_task_roots_fixture_ok_payload(value: JetEvalRuntimeValue) -> JetEvalRuntimeValue? {
    if value == .Result(ok, payload) && ok -> return Val(payload)
    None
}

// Stable owner for the real checked callback selected by the fixture harness.
// Returning the lambda makes its capture escape; the generated lambda MIR row
// has one capture parameter and escaping capture facts.
pub fn jet_eval_task_roots_fixture_escaping_callback_owner(seed: Int) -> fn(Int) -> Int {
    (value: Int) -> seed + value
}

fn jet_eval_task_roots_fixture_cell_aliases(machine: &JetEvalMachine, index: Int, expected: Int) -> Bool {
    jet_eval_shared_cell_aliases(&machine, index) == Val(expected)
}

fn jet_eval_task_roots_fixture_token_aliases(machine: &JetEvalMachine, token: Int, expected: Int) -> Bool {
    jet_eval_foreign_token_aliases(&machine, token) == Val(expected)
}

fn jet_eval_task_roots_fixture_register_weak(registry: JetEvalSharedRuntime, weak: JetEvalSharedWeak) -> Bool {
    permit := registry.storage.guard_edit()
    &permit.value.weaks.push(weak)
    true
}

fn jet_eval_task_roots_fixture_set_element_type(metadata: Shared<JetEvalSharedValueMeta>, element_type: MirType) -> Bool {
    permit := metadata.guard_edit()
    permit.value.element_type = element_type
    true
}

fn jet_eval_task_roots_fixture_weak_count(registry: JetEvalSharedRuntime) -> Int {
    permit :: registry.storage.guard_read()
    permit.value.weaks.len()
}

fn jet_eval_task_roots_fixture_clean(machine: &JetEvalMachine) -> Bool {
    machine.failure == None && machine.internal_problem == None
}

fn jet_eval_task_roots_fixture_shared_row(module_name: String, member: String, symbol: String, borrow_mask: ^[Bool]) -> MirPreludeCall? {
    row := jet_eval_exact_integer_row("add", 2) ?? return None
    arity :: borrow_mask.len()
    row.id = MirPreludeCallId{value: stable_id("mir-prelude-call", "task-root-shared:{module_name}:{member}:{symbol}")}
    row.family = MirPreludeFamily.StaticPrelude
    row.module_name = ~module_name
    row.member = ~member
    row.symbol = MirSymbol.Prelude{name: ~symbol}
    row.signature = MirCallSignature{arity: arity, max_arity: arity, borrow_mask: ~borrow_mask}
    Val(row)
}

fn jet_eval_task_roots_fixture_shared_field(value: JetEvalRuntimeValue, name: String) -> JetEvalRuntimeValue? {
    if value == {
        .Aggregate(aggregate) -> if aggregate == {
            .Struct(_, fields) -> loop field in fields {
                if field.name == name -> return Val(field.value)
            }
            else -> return None
        }
        else -> return None
    }
    None
}

fn jet_eval_task_roots_fixture_checked_nominal(machine: &JetEvalMachine, name: String, span: Span) -> MirType? {
    found := None
    loop candidate in machine.program.type_instances {
        if candidate.kind == .Apply(_, _) && mir_type_display_name(candidate) == name {
            if found != None {
                jet_eval_compiler_fail(&machine, span, "TaskRoots fixture nominal type is ambiguous in the checked program")
                return None
            }
            found = Val(candidate)
        }
    }
    found
}

// This producer owns the Source Machine only for the duration of creating and
// exporting one pre-adopted Shared carrier. Its OwnedRoot is the only Source
// runtime authority that survives the return.
pub fn jet_eval_task_roots_fixture_shared_produce(program: ^MirProgram, config: ^JetEvalConfig, span: Span) -> JetEvalSharedHostCarrier? {
    source_config :: jet_eval_runtime_config(^config)
    source_machine := jet_eval_machine(^program, ^source_config)
    int_type :: mir_type_from_kind(MirTypeKind.Int)
    inner_shared_type :: mir_type_from_kind(MirTypeKind.Shared{inner: int_type})
    payload_type :: jet_eval_task_roots_fixture_checked_nominal(&source_machine, "JetEvalTaskRootsSharedPayload", span) ?? return None
    payload_name :: mir_type_display_name(payload_type)
    shared_type :: mir_type_from_kind(MirTypeKind.Shared{inner: payload_type})
    option_shared_type :: mir_type_from_kind(MirTypeKind.Option{inner: shared_type})
    new_row :: jet_eval_task_roots_fixture_shared_row("jet_std::JetShared", "new", "jet_std::JetShared::new", [Bool]{false}) ?? return None
    set_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.set", "jet_shared_set", [Bool]{true, false}) ?? return None
    count_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.strong_count", "jet_shared_strong_count", [Bool]{true}) ?? return None
    downgrade_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.downgrade", "jet_shared_downgrade", [Bool]{true}) ?? return None
    upgrade_row := jet_eval_task_roots_fixture_shared_row("core.host", "Shared.Weak.upgrade", "jet_shared_weak_upgrade", [Bool]{true}) ?? return None
    upgrade_row.fallibility = MirCallFallibility.Failure{failure: MirFailureCarrier.Optional{value: shared_type}}

    inner_source :: jet_eval_shared_runtime_route(
        &source_machine,
        new_row,
        [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 11}}},
        [MirType]{int_type},
        Val(inner_shared_type),
        span,
    ) ?? return None
    initial_nested_alias :: jet_eval_copy_value(inner_source, &source_machine, span) ?? return None
    initial_payload :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: payload_name, fields: [JetEvalRuntimeField]{
        JetEvalRuntimeField{name: "marker", value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 7}}},
        JetEvalRuntimeField{name: "nested", value: initial_nested_alias},
    }}}
    source_value :: jet_eval_shared_runtime_route(
        &source_machine,
        new_row,
        [JetEvalRuntimeValue]{initial_payload},
        [MirType]{payload_type},
        Val(shared_type),
        span,
    ) ?? return None
    if !jet_eval_drop_value(&source_machine, initial_payload, span) -> return None
    source_index :: if source_value == {.Shared(index) -> Val(index) else -> None} ?? return None
    source_entry :: jet_eval_shared_runtime_value(&source_machine, source_index) ?? return None
    source_capability :: source_entry.metadata.guard_read().value.physical_root ?? return None
    source_owner_tokens := source_entry.metadata.guard_read().value.owner_alias_tokens
    if source_owner_tokens.len() != 1 -> return None

    // The canonical payload graph gains a nested Shared after the outer
    // finalizer's Source runtime view has been captured.
    late_inner_source :: jet_eval_shared_runtime_route(
        &source_machine,
        new_row,
        [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 19}}},
        [MirType]{int_type},
        Val(inner_shared_type),
        span,
    ) ?? return None
    late_nested_alias :: jet_eval_copy_value(late_inner_source, &source_machine, span) ?? return None
    late_payload :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: payload_name, fields: [JetEvalRuntimeField]{
        JetEvalRuntimeField{name: "marker", value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 7}}},
        JetEvalRuntimeField{name: "nested", value: late_nested_alias},
    }}}
    if jet_eval_shared_runtime_route(
        &source_machine,
        set_row,
        [JetEvalRuntimeValue]{source_value, late_payload},
        [MirType]{},
        Val(mir_type_from_kind(MirTypeKind.Unit)),
        span,
    ) != Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) -> return None
    if !jet_eval_drop_value(&source_machine, late_payload, span) -> return None

    // Make a fresh rootcap and owner token for B, then move the exact
    // pre-adopted token into the exported carrier without another retain.
    guard :: jet_eval_shared_runtime_guard_acquire(&source_machine, source_index, set_row, true, span) ?? return None
    guard_index :: if guard == {.SharedGuard(index) -> Val(index) else -> None} ?? return None
    guard_record :: jet_eval_shared_runtime_guard(&source_machine, guard_index) ?? return None
    if !guard_record.metadata.guard_read().value.active -> return None
    count_before :: jet_eval_shared_runtime_route(
        &source_machine,
        count_row,
        [JetEvalRuntimeValue]{source_value},
        [MirType]{},
        Val(int_type),
        span,
    ) ?? return None
    count_before_value :: jet_eval_task_roots_fixture_int_data(count_before) ?? return None
    if count_before_value != 1 -> return None
    source_weak_value :: jet_eval_shared_runtime_route(
        &source_machine, downgrade_row, [JetEvalRuntimeValue]{source_value}, [MirType]{}, None, span,
    ) ?? return None
    source_initial_upgrade_result := jet_eval_shared_runtime_route(
        &source_machine,
        upgrade_row,
        [JetEvalRuntimeValue]{source_weak_value},
        [MirType]{},
        Val(option_shared_type),
        span,
    ) ?? return None
    source_initial_upgrade_payload :: jet_eval_task_roots_fixture_ok_payload(source_initial_upgrade_result) ?? return None
    source_initial_upgrade_value :: if source_initial_upgrade_payload == {.Shared(_) -> Val(source_initial_upgrade_payload) else -> None} ?? return None
    transfer_index :: if source_initial_upgrade_value == {.Shared(index) -> Val(index) else -> None} ?? return None
    transfer_entry :: jet_eval_shared_runtime_value(&source_machine, transfer_index) ?? return None
    transfer_capability :: transfer_entry.metadata.guard_read().value.physical_root ?? return None
    if !jet_eval_shared_runtime_same_physical_owner(Val(source_capability), Val(transfer_capability)) -> return None
    if transfer_capability.raw == source_capability.raw
        && transfer_capability.generation == source_capability.generation -> return None
    transfer_meta := transfer_entry.metadata.guard_read().value
    if transfer_meta.owner_alias_tokens.len() != 1 -> return None
    transfer_token := transfer_meta.owner_alias_tokens[0]
    if transfer_token == source_owner_tokens[0] -> return None
    if !jet_eval_shared_runtime_owner_alias_transfer_stage(&source_machine, transfer_index, transfer_token, transfer_capability, span) -> return None
    if transfer_entry.metadata.guard_read().value.pending_owner_alias_transfers.len() != 1 -> return None
    if program.core_owners.len() == 0 -> return None
    invalid_owner := program.core_owners[0]
    invalid_payload_type :: mir_type_from_kind(MirTypeKind.Apply{name: MirNominalRef{
        id: invalid_owner.nominal_id,
        name: "{invalid_owner.name}__task_roots_invalid",
    }, args: [MirType]{}})
    shape_failure_machine := jet_eval_machine(^program, ^source_config)
    isolated_shared_runtime := shape_failure_machine.registry.shared_runtime
    shape_failure_machine.registry.shared_runtime = source_machine.registry.shared_runtime
    if !jet_eval_task_roots_fixture_set_element_type(transfer_entry.metadata, invalid_payload_type) -> return None
    invalid_shape :: jet_eval_shared_runtime_host_payload_shape(&shape_failure_machine, JetEvalSharedHostKind.Shared, transfer_index, span)
    if invalid_shape != None -> return None
    shape_failure_machine.failure = None
    failed_prepare :: jet_eval_shared_runtime_owner_alias_transfer_commit(&shape_failure_machine, transfer_index, transfer_token, transfer_capability, span)
    if !jet_eval_task_roots_fixture_set_element_type(transfer_entry.metadata, transfer_meta.element_type) -> return None
    shape_failure_machine.registry.shared_runtime = isolated_shared_runtime
    shape_failure_machine.failure = None
    shape_failure_machine.internal_problem = None
    if failed_prepare != None -> return None
    if !jet_eval_retire_machine(&shape_failure_machine, span) -> return None
    retained_transfer := transfer_entry.metadata.guard_read().value
    active_transfer_tokens := 0
    pending_transfer_tokens := 0
    loop existing in retained_transfer.owner_alias_tokens {
        if existing == transfer_token -> active_transfer_tokens += 1
    }
    loop existing in retained_transfer.pending_owner_alias_transfers {
        if existing == transfer_token -> pending_transfer_tokens += 1
    }
    if retained_transfer.references != transfer_meta.references
        || active_transfer_tokens != 1
        || pending_transfer_tokens != 1 -> return None
    if !jet_eval_shared_runtime_owner_alias_transfer_dispose(&source_machine, transfer_index, transfer_token, transfer_capability, span) -> return None
    disposed_transfer := transfer_entry.metadata.guard_read().value
    if disposed_transfer.references != transfer_meta.references
        || disposed_transfer.owner_alias_tokens.len() != transfer_meta.owner_alias_tokens.len()
        || disposed_transfer.pending_owner_alias_transfers.len() != 0 -> return None
    if !jet_eval_shared_runtime_owner_alias_transfer_stage(&source_machine, transfer_index, transfer_token, transfer_capability, span) -> return None
    if transfer_entry.metadata.guard_read().value.pending_owner_alias_transfers.len() != 1 -> return None
    transfer_host :: jet_eval_shared_runtime_owner_alias_transfer_commit(&source_machine, transfer_index, transfer_token, transfer_capability, span) ?? return None
    transfer_carrier :: if transfer_host == {.SharedCarrier(value) -> Val(value) else -> None} ?? return None
    if transfer_carrier.owner_alias_token != Val(transfer_token)
        || !transfer_carrier.owner_alias_token_pre_adopted
        || !transfer_carrier.owns_root_capability -> return None
    source_initial_upgrade_result = JetEvalRuntimeValue.Moved

    if !jet_eval_shared_runtime_guard_release(&source_machine, guard_index, span) -> return None
    if !jet_eval_drop_value(&source_machine, source_value, span) -> return None
    retired_source := source_entry.metadata.guard_read().value
    if retired_source.references != 0 || !retired_source.dropped || retired_source.physical_root != None -> return None
    if source_entry.storage.guard_read().value.value != JetEvalRuntimeValue.Moved -> return None
    if !jet_eval_drop_value(&source_machine, source_weak_value, span) -> return None
    if !jet_eval_drop_value(&source_machine, inner_source, span) -> return None
    if !jet_eval_drop_value(&source_machine, late_inner_source, span) -> return None
    if !jet_eval_retire_machine(&source_machine, span) -> return None
    if !jet_eval_task_roots_fixture_clean(&source_machine) -> return None
    Val(transfer_carrier)
}

// B runs with its own Source Machine after the producer's Machine has returned.
// Its final strong release must run the Source-owned payload finalizer, then its
// weak capability must observe the missing physical owner.
pub fn jet_eval_task_roots_fixture_shared_consume(
    program: ^MirProgram,
    config: ^JetEvalConfig,
    carrier: ^JetEvalSharedHostCarrier,
    span: Span,
) -> Bool {
    updated := carrier
    receiver_config :: jet_eval_runtime_config(^config)
    receiver := jet_eval_machine(^program, ^receiver_config)
    int_type :: mir_type_from_kind(MirTypeKind.Int)
    payload_type :: jet_eval_task_roots_fixture_checked_nominal(&receiver, "JetEvalTaskRootsSharedPayload", span) ?? return false
    payload_name :: mir_type_display_name(payload_type)
    shared_type :: mir_type_from_kind(MirTypeKind.Shared{inner: payload_type})
    option_shared_type :: mir_type_from_kind(MirTypeKind.Option{inner: shared_type})
    get_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.get", "jet_shared_get", [Bool]{true}) ?? return false
    set_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.set", "jet_shared_set", [Bool]{true, false}) ?? return false
    count_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.strong_count", "jet_shared_strong_count", [Bool]{true}) ?? return false
    downgrade_row :: jet_eval_task_roots_fixture_shared_row("core.host", "Shared.downgrade", "jet_shared_downgrade", [Bool]{true}) ?? return false
    upgrade_row := jet_eval_task_roots_fixture_shared_row("core.host", "Shared.Weak.upgrade", "jet_shared_weak_upgrade", [Bool]{true}) ?? return false
    upgrade_row.fallibility = MirCallFallibility.Failure{failure: MirFailureCarrier.Optional{value: shared_type}}

    if updated.kind != JetEvalSharedHostKind.Shared
        || updated.origin != JetEvalSharedHostOrigin.Native
        || !updated.owner_alias_token_pre_adopted
        || !updated.owns_root_capability
        || updated.owner_alias_token == None -> return false
    transfer_token :: updated.owner_alias_token ?? return false
    transfer_capability :: if updated.physical == {
        .Shared(entry) -> entry.metadata.guard_read().value.physical_root
        else -> None
    } ?? return false
    carrier_metadata :: if updated.physical == {
        .Shared(entry) -> Val(entry.metadata.guard_read().value)
        else -> None
    } ?? return false
    carrier_metadata_before := carrier_metadata
    if !jet_eval_shared_runtime_host_entry_loan_preflight(updated, Val(shared_type))
        || jet_eval_shared_runtime_host_entry_loan_preflight(updated, Val(int_type)) -> return false
    carrier_metadata_after := carrier_metadata
    if carrier_metadata_after.references != carrier_metadata_before.references
        || carrier_metadata_after.owner_alias_tokens.len() != carrier_metadata_before.owner_alias_tokens.len()
        || carrier_metadata_after.pending_owner_alias_transfers.len() != carrier_metadata_before.pending_owner_alias_transfers.len() -> return false
    loop index in 0..<carrier_metadata_before.owner_alias_tokens.len() {
        if carrier_metadata_after.owner_alias_tokens[index] != carrier_metadata_before.owner_alias_tokens[index] -> return false
    }
    loop index in 0..<carrier_metadata_before.pending_owner_alias_transfers.len() {
        if carrier_metadata_after.pending_owner_alias_transfers[index] != carrier_metadata_before.pending_owner_alias_transfers[index] -> return false
    }
    updated.index = None
    updated.registry = receiver.registry.shared_runtime
    received_value :: jet_eval_shared_runtime_host_adopt(&receiver, updated, Val(shared_type), span) ?? return false
    receiver_index :: if received_value == {.Shared(index) -> Val(index) else -> None} ?? return false
    receiver_entry :: jet_eval_shared_runtime_value(&receiver, receiver_index) ?? return false
    received_metadata := receiver_entry.metadata.guard_read().value
    received_capability :: received_metadata.physical_root ?? return false
    if !jet_eval_shared_runtime_same_root_capability(Val(transfer_capability), Val(received_capability)) -> return false
    if received_metadata.references != 1
        || received_metadata.owner_alias_tokens.len() != 1
        || received_metadata.owner_alias_tokens[0] != transfer_token -> return false

    // The Source parent is gone, but the transferred owner still exposes its
    // full checked payload graph, including the late nested Shared identity.
    count_after_receive :: jet_eval_shared_runtime_route(
        &receiver,
        count_row,
        [JetEvalRuntimeValue]{received_value},
        [MirType]{},
        Val(int_type),
        span,
    ) ?? return false
    count_after_receive_value :: jet_eval_task_roots_fixture_int_data(count_after_receive) ?? return false
    if count_after_receive_value != 1 -> return false

    read_projection :: jet_eval_shared_runtime_host_projection(&receiver, received_value, span) ?? return false
    read_carrier :: if read_projection == {
        .SharedCarrier(value) -> Val(value)
        else -> None
    } ?? return false
    read_loan :: jet_eval_shared_runtime_host_entry_loan(&receiver, read_carrier, Val(shared_type), span) ?? return false
    read_value :: jet_eval_shared_runtime_host_entry_loan_value(read_loan)
    read_count :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{read_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if read_count != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 1}}) -> return false
    cloned_read_value :: jet_eval_copy_value(read_value, &receiver, span) ?? return false
    cloned_read_count :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{cloned_read_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if cloned_read_count != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 2}}) -> return false
    if !jet_eval_shared_runtime_host_entry_loan_end(&receiver, read_loan, span) -> return false
    if !jet_eval_drop_value(&receiver, cloned_read_value, span) -> return false
    restored_read_count :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if restored_read_count != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 1}}) -> return false
    borrowed_metadata := receiver_entry.metadata.guard_read().value
    if borrowed_metadata.references != 1
        || borrowed_metadata.owner_alias_tokens.len() != 1
        || borrowed_metadata.owner_alias_tokens[0] != transfer_token -> return false

    guard_value :: jet_eval_shared_runtime_guard_acquire(&receiver, receiver_index, set_row, true, span) ?? return false
    guard_index :: if guard_value == {.SharedGuard(index) -> Val(index) else -> None} ?? return false
    guard_record :: jet_eval_shared_runtime_guard(&receiver, guard_index) ?? return false
    source_guard_metadata := guard_record.metadata.guard_read().value
    source_guard_lease := source_guard_metadata.lease
    source_lease_metadata := source_guard_lease.metadata.guard_read().value
    source_shared_index := source_lease_metadata.shared
    root_metadata_before_guard_loan := receiver_entry.metadata.guard_read().value
    physical_guard_carrier :: jet_eval_shared_runtime_host_physical_carrier(
        &receiver,
        guard_value,
        span,
    ) ?? return false
    payload_nominal :: if payload_type.kind == {.Apply(name, _) -> Val(name) else -> None} ?? return false
    guard_type :: mir_type_from_kind(MirTypeKind.Apply{
        name: MirNominalRef{id: payload_nominal.id, name: "SharedGuard"},
        args: [MirType]{payload_type},
    })
    selector :: 41
    carrier_guard :: JetEvalSharedGuard{
        metadata: shared JetEvalSharedGuardMeta{
            references: source_guard_metadata.references,
            dropped: source_guard_metadata.dropped,
            active: source_guard_metadata.active,
            editable: false,
            path: source_guard_metadata.path,
            owner_row: source_guard_metadata.owner_row,
            physical_borrow_selector: Val(selector),
            lease: source_guard_metadata.lease,
        },
    }
    physical_guard_carrier.physical = JetEvalSharedHostPhysicalRoot.Guard{value: carrier_guard}
    physical_guard_carrier.index = None
    carrier_guard_metadata_before := carrier_guard.metadata.guard_read().value
    values_before_guard_preflight := receiver.registry.shared_runtime.storage.guard_read().value.values.len()
    guards_before_guard_preflight := receiver.registry.shared_runtime.storage.guard_read().value.guards.len()
    if !jet_eval_shared_runtime_host_entry_loan_preflight(physical_guard_carrier, Val(guard_type))
        || jet_eval_shared_runtime_host_entry_loan_preflight(physical_guard_carrier, Val(int_type)) -> return false
    physical_guard_carrier.owner_alias_token = Val(transfer_token)
    if jet_eval_shared_runtime_host_entry_loan_preflight(physical_guard_carrier, Val(guard_type)) -> return false
    physical_guard_carrier.owner_alias_token = None
    physical_guard_carrier.owns_root_capability = true
    if jet_eval_shared_runtime_host_entry_loan_preflight(physical_guard_carrier, Val(guard_type)) -> return false
    physical_guard_carrier.owns_root_capability = false
    carrier_guard_metadata_after := carrier_guard.metadata.guard_read().value
    root_metadata_after_guard_preflight := receiver_entry.metadata.guard_read().value
    source_lease_after_guard_preflight := source_guard_lease.metadata.guard_read().value
    if receiver.registry.shared_runtime.storage.guard_read().value.values.len() != values_before_guard_preflight
        || receiver.registry.shared_runtime.storage.guard_read().value.guards.len() != guards_before_guard_preflight
        || carrier_guard_metadata_after.references != carrier_guard_metadata_before.references
        || carrier_guard_metadata_after.active != carrier_guard_metadata_before.active
        || carrier_guard_metadata_after.physical_borrow_selector != carrier_guard_metadata_before.physical_borrow_selector
        || source_lease_after_guard_preflight.handles != source_lease_metadata.handles
        || source_lease_after_guard_preflight.released != source_lease_metadata.released
        || root_metadata_after_guard_preflight.references != root_metadata_before_guard_loan.references
        || root_metadata_after_guard_preflight.owner_alias_tokens.len() != root_metadata_before_guard_loan.owner_alias_tokens.len()
        || root_metadata_after_guard_preflight.pending_owner_alias_transfers.len() != root_metadata_before_guard_loan.pending_owner_alias_transfers.len() -> return false
    loop index in 0..<root_metadata_before_guard_loan.owner_alias_tokens.len() {
        if root_metadata_after_guard_preflight.owner_alias_tokens[index] != root_metadata_before_guard_loan.owner_alias_tokens[index] -> return false
    }

    guard_count_before_loan :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    entry_loan_count :: receiver.entry_shared_loans.len()
    receiver.entry_access = Val(MirAccess.Read)
    adopted_guard :: jet_eval_host_value_adopt(
        &receiver, None, Val(guard_type), JetEvalHostValue.SharedCarrier{carrier: physical_guard_carrier}, false, span,
    )
    receiver.entry_access = None
    borrowed_guard_value :: adopted_guard ?? return false
    if receiver.entry_shared_loans.len() != entry_loan_count + 1 -> return false
    guard_loan := receiver.entry_shared_loans[entry_loan_count]
    borrowed_guard_index :: if borrowed_guard_value == {.SharedGuard(index) -> Val(index) else -> None} ?? return false
    borrowed_guard_record :: jet_eval_shared_runtime_guard(&receiver, borrowed_guard_index) ?? return false
    borrowed_guard_metadata := borrowed_guard_record.metadata.guard_read().value
    borrowed_guard_lease := borrowed_guard_metadata.lease.metadata.guard_read().value
    if borrowed_guard_lease.shared == source_shared_index
        || borrowed_guard_metadata.physical_borrow_selector != Val(selector) -> return false
    borrowed_root :: jet_eval_shared_runtime_value(&receiver, borrowed_guard_lease.shared) ?? return false
    borrowed_root_capability :: borrowed_root.metadata.guard_read().value.physical_root ?? return false
    source_root_capability :: root_metadata_before_guard_loan.physical_root ?? return false
    if !jet_eval_shared_runtime_same_root_capability(Val(borrowed_root_capability), Val(source_root_capability)) -> return false
    if borrowed_guard_record.metadata.guard_read().value.physical_borrow_selector != Val(selector) -> return false
    if borrowed_guard_metadata.editable || !borrowed_guard_lease.editable -> return false
    borrowed_child_index :: jet_eval_shared_runtime_guard_create(
        &receiver,
        borrowed_guard_lease.shared,
        borrowed_guard_metadata.owner_row,
        borrowed_guard_metadata.editable,
        borrowed_guard_metadata.path,
        borrowed_guard_metadata.lease,
        false,
        None,
    )
    if !jet_eval_shared_runtime_entry_read_guard_loan_link(&receiver, borrowed_child_index, guard_loan.index)
        || !jet_eval_shared_runtime_guard_set_active(&receiver, borrowed_child_index, true, span) -> return false
    borrowed_child_receipt :: JetEvalSharedEntryLoan{
        kind: JetEvalSharedHostKind.Guard,
        index: borrowed_child_index,
        registry: receiver.registry.shared_runtime,
    }
    if !jet_eval_shared_runtime_host_entry_loan_set_physical_borrow_selector(
        &receiver,
        borrowed_child_receipt,
        selector + 1,
    ) -> return false
    borrowed_child_guard :: jet_eval_shared_runtime_guard(&receiver, borrowed_child_index) ?? return false
    if borrowed_guard_record.metadata.guard_read().value.physical_borrow_selector != Val(selector)
        || borrowed_child_guard.metadata.guard_read().value.physical_borrow_selector != Val(selector + 1) -> return false
    if jet_eval_shared_runtime_guard_consume(&receiver, borrowed_guard_index, 1, span) == None -> return false
    root_metadata_after_guard_loan := receiver_entry.metadata.guard_read().value
    if root_metadata_after_guard_loan.references != root_metadata_before_guard_loan.references
        || root_metadata_after_guard_loan.owner_alias_tokens.len() != root_metadata_before_guard_loan.owner_alias_tokens.len()
        || root_metadata_after_guard_loan.pending_owner_alias_transfers.len() != root_metadata_before_guard_loan.pending_owner_alias_transfers.len() -> return false
    loop index in 0..<root_metadata_before_guard_loan.owner_alias_tokens.len() {
        if root_metadata_after_guard_loan.owner_alias_tokens[index] != root_metadata_before_guard_loan.owner_alias_tokens[index] -> return false
    }

    guard_count_during_loan :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if guard_count_during_loan != guard_count_before_loan -> return false
    if !jet_eval_shared_runtime_host_entry_loan_end(&receiver, guard_loan, span) -> return false
    _ := receiver.entry_shared_loans.remove(entry_loan_count)
    if receiver.entry_shared_loans.len() != entry_loan_count -> return false
    root_metadata_after_guard_loan_end := receiver_entry.metadata.guard_read().value
    if root_metadata_after_guard_loan_end.references != root_metadata_before_guard_loan.references
        || root_metadata_after_guard_loan_end.owner_alias_tokens.len() != root_metadata_before_guard_loan.owner_alias_tokens.len()
        || root_metadata_after_guard_loan_end.pending_owner_alias_transfers.len() != root_metadata_before_guard_loan.pending_owner_alias_transfers.len() -> return false
    loop index in 0..<root_metadata_before_guard_loan.owner_alias_tokens.len() {
        if root_metadata_after_guard_loan_end.owner_alias_tokens[index] != root_metadata_before_guard_loan.owner_alias_tokens[index] -> return false
    }

    retired_borrowed_guard := borrowed_guard_record.metadata.guard_read().value
    retired_borrowed_lease := borrowed_guard_metadata.lease.metadata.guard_read().value
    retired_borrowed_child := borrowed_child_guard.metadata.guard_read().value
    if !retired_borrowed_child.dropped || retired_borrowed_child.active
        || retired_borrowed_child.references != 0
        || retired_borrowed_child.physical_borrow_selector != None -> return false
    parent_guard_after_loan := guard_record.metadata.guard_read().value
    parent_lease_after_loan := source_guard_lease.metadata.guard_read().value
    if !retired_borrowed_guard.dropped || retired_borrowed_guard.active
        || retired_borrowed_guard.references != 0
        || retired_borrowed_guard.physical_borrow_selector != None
        || !retired_borrowed_lease.released || retired_borrowed_lease.handles != 0
        || parent_guard_after_loan.dropped || !parent_guard_after_loan.active
        || parent_lease_after_loan.released || parent_lease_after_loan.handles != source_lease_metadata.handles -> return false
    guard_count_after_loan :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if guard_count_after_loan != guard_count_before_loan -> return false
    if !jet_eval_shared_runtime_guard_release(&receiver, guard_index, span) -> return false
    released_guard_count :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if released_guard_count != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 1}}) -> return false
    receiver_payload :: jet_eval_shared_runtime_route(
        &receiver,
        get_row,
        [JetEvalRuntimeValue]{received_value},
        [MirType]{},
        Val(payload_type),
        span,
    ) ?? return false
    receiver_marker :: jet_eval_task_roots_fixture_shared_field(receiver_payload, "marker") ?? return false
    if receiver_marker != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 7}}) -> return false
    receiver_nested_borrowed :: jet_eval_task_roots_fixture_shared_field(receiver_payload, "nested") ?? return false
    receiver_nested :: jet_eval_copy_value(receiver_nested_borrowed, &receiver, span) ?? return false
    if !jet_eval_drop_value(&receiver, receiver_payload, span) -> return false
    receiver_nested_initial :: jet_eval_shared_runtime_route(
        &receiver, get_row, [JetEvalRuntimeValue]{receiver_nested}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    if receiver_nested_initial != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 19}}) -> return false

    receiver_nested_for_write :: jet_eval_copy_value(receiver_nested, &receiver, span) ?? return false
    receiver_payload_for_write :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: payload_name, fields: [JetEvalRuntimeField]{
        JetEvalRuntimeField{name: "marker", value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 31}}},
        JetEvalRuntimeField{name: "nested", value: receiver_nested_for_write},
    }}}
    if jet_eval_shared_runtime_route(
        &receiver,
        set_row,
        [JetEvalRuntimeValue]{received_value, receiver_payload_for_write},
        [MirType]{},
        Val(mir_type_from_kind(MirTypeKind.Unit)),
        span,
    ) != Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) -> return false
    if !jet_eval_drop_value(&receiver, receiver_payload_for_write, span) -> return false
    receiver_payload_after_write :: jet_eval_shared_runtime_route(
        &receiver, get_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(payload_type), span,
    ) ?? return false
    receiver_marker_after_write :: jet_eval_task_roots_fixture_shared_field(receiver_payload_after_write, "marker") ?? return false
    if receiver_marker_after_write != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 31}}) -> return false
    if !jet_eval_drop_value(&receiver, receiver_payload_after_write, span) -> return false
    if jet_eval_shared_runtime_route(
        &receiver,
        set_row,
        [JetEvalRuntimeValue]{receiver_nested, JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 42}}},
        [MirType]{},
        Val(mir_type_from_kind(MirTypeKind.Unit)),
        span,
    ) != Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) -> return false
    if jet_eval_shared_runtime_route(
        &receiver, get_row, [JetEvalRuntimeValue]{receiver_nested}, [MirType]{}, Val(int_type), span,
    ) != Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 42}}) -> return false

    weak_value :: jet_eval_shared_runtime_route(
        &receiver, downgrade_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, None, span,
    ) ?? return false
    count_before_upgrade :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    count_before_upgrade_value :: jet_eval_task_roots_fixture_int_data(count_before_upgrade) ?? return false
    upgraded_result :: jet_eval_shared_runtime_route(
        &receiver, upgrade_row, [JetEvalRuntimeValue]{weak_value}, [MirType]{}, Val(option_shared_type), span,
    ) ?? return false
    upgraded_payload :: jet_eval_task_roots_fixture_ok_payload(upgraded_result) ?? return false
    upgraded_value :: if upgraded_payload == {.Shared(_) -> Val(upgraded_payload) else -> None} ?? return false
    upgraded_index :: if upgraded_value == {.Shared(index) -> Val(index) else -> None} ?? return false
    upgraded_entry :: jet_eval_shared_runtime_value(&receiver, upgraded_index) ?? return false
    upgraded_capability :: upgraded_entry.metadata.guard_read().value.physical_root ?? return false
    if upgraded_capability.type_identity != received_capability.type_identity
        || upgraded_capability.physical_identity != received_capability.physical_identity -> return false
    if upgraded_capability.raw == received_capability.raw
        && upgraded_capability.generation == received_capability.generation -> return false
    count_after_upgrade :: jet_eval_shared_runtime_route(
        &receiver, count_row, [JetEvalRuntimeValue]{upgraded_value}, [MirType]{}, Val(int_type), span,
    ) ?? return false
    count_after_upgrade_value :: jet_eval_task_roots_fixture_int_data(count_after_upgrade) ?? return false
    if count_after_upgrade_value != count_before_upgrade_value + 1 -> return false

    upgraded_nested_for_write :: jet_eval_copy_value(receiver_nested, &receiver, span) ?? return false
    upgraded_payload_for_write :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.Struct{type_name: payload_name, fields: [JetEvalRuntimeField]{
        JetEvalRuntimeField{name: "marker", value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 42}}},
        JetEvalRuntimeField{name: "nested", value: upgraded_nested_for_write},
    }}}
    if jet_eval_shared_runtime_route(
        &receiver,
        set_row,
        [JetEvalRuntimeValue]{upgraded_value, upgraded_payload_for_write},
        [MirType]{},
        Val(mir_type_from_kind(MirTypeKind.Unit)),
        span,
    ) != Val(JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}) -> return false
    if !jet_eval_drop_value(&receiver, upgraded_payload_for_write, span) -> return false
    receiver_payload_after_upgrade :: jet_eval_shared_runtime_route(
        &receiver, get_row, [JetEvalRuntimeValue]{received_value}, [MirType]{}, Val(payload_type), span,
    ) ?? return false
    receiver_marker_after_upgrade :: jet_eval_task_roots_fixture_shared_field(receiver_payload_after_upgrade, "marker") ?? return false
    if receiver_marker_after_upgrade != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 42}}) -> return false
    if !jet_eval_drop_value(&receiver, receiver_payload_after_upgrade, span) -> return false

    // Distinct rootcaps for one canonical physical owner are one transaction
    // participant, so ordered acquisition takes its permit only once.
    transaction :: jet_eval_shared_runtime_allocate_transaction(&receiver, JetEvalSharedTransaction{
        storage: shared JetEvalSharedTransactionState{
            machine: receiver.identity,
            frame_index: 0,
            scope: MirScopeId{value: stable_id("mir-scope", "task-roots-shared-alias-transaction")},
            parent: None,
            active: true,
            participants: [JetEvalSharedTransactionPart]{},
            snapshots: [Int]{},
        },
    })
    first_part :: jet_eval_shared_runtime_transaction_touch(&receiver, transaction, receiver_index, get_row, span) ?? return false
    second_part :: jet_eval_shared_runtime_transaction_touch(&receiver, transaction, upgraded_index, get_row, span) ?? return false
    if first_part != second_part -> return false
    transaction_state :: jet_eval_shared_runtime_transaction_take(&receiver, transaction, span) ?? return false
    if !jet_eval_shared_runtime_transaction_commit(&receiver, transaction_state, span) -> return false

    if !jet_eval_drop_value(&receiver, receiver_nested, span) -> return false
    if !jet_eval_drop_value(&receiver, received_value, span) -> return false
    if !jet_eval_drop_value(&receiver, upgraded_result, span) -> return false
    no_owner_upgrade :: jet_eval_shared_runtime_route(
        &receiver, upgrade_row, [JetEvalRuntimeValue]{weak_value}, [MirType]{}, Val(option_shared_type), span,
    ) ?? return false
    no_owner_absent :: if no_owner_upgrade == {
        .Absent(_) -> true
        .Result(ok, _) -> !ok
        else -> false
    }
    if !no_owner_absent -> return false
    if !jet_eval_drop_value(&receiver, no_owner_upgrade, span) -> return false
    if !jet_eval_drop_value(&receiver, weak_value, span) -> return false
    jet_eval_retire_machine(&receiver, span) && jet_eval_task_roots_fixture_clean(&receiver)
}

// Keep the original end-to-end fixture convenient while exercising the same
// producer/consumer boundary used by the ResourceSession retirement proof.
fn jet_eval_task_roots_fixture_shared_roundtrip(machine: &JetEvalMachine, span: Span) -> Bool {
    config :: jet_eval_task_config(&machine)
    carrier :: jet_eval_task_roots_fixture_shared_produce(^machine.program, ^config, span) ?? return false
    jet_eval_task_roots_fixture_shared_consume(^machine.program, ^config, ^carrier, span)
}

// Interleaved retain/release of one cell and one token from two machines that
// share the registry: every retain from either machine is one alias, every
// release discharges one, and the final counts are the exact arithmetic sum.
fn jet_eval_task_roots_fixture_interleaved(parent: &JetEvalMachine, child: &JetEvalMachine, cell: JetEvalRuntimeValue, cursor: JetEvalRuntimeValue, cell_id: Int, cursor_token: Int, span: Span) -> Bool {
    parent_cells := [JetEvalRuntimeValue]{}
    child_cells := [JetEvalRuntimeValue]{}
    parent_cursors := [JetEvalRuntimeValue]{}
    child_cursors := [JetEvalRuntimeValue]{}
    base_cell :: jet_eval_shared_cell_aliases(&parent, cell_id) ?? return false
    base_cursor :: jet_eval_foreign_token_aliases(&parent, cursor_token) ?? return false
    loop _ in 0..<4 {
        &parent_cells.push(jet_eval_copy_value(cell, &parent, span) ?? return false)
        &child_cells.push(jet_eval_copy_value(cell, &child, span) ?? return false)
        &child_cursors.push(jet_eval_copy_value(cursor, &child, span) ?? return false)
        &parent_cursors.push(jet_eval_copy_value(cursor, &parent, span) ?? return false)
    }
    if !jet_eval_task_roots_fixture_cell_aliases(&child, cell_id, base_cell + 8) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&child, cursor_token, base_cursor + 8) -> return false
    loop index in 0..<4 {
        if !jet_eval_drop_value(&child, parent_cells[index], span) -> return false
        if !jet_eval_drop_value(&parent, child_cells[index], span) -> return false
        if !jet_eval_drop_value(&parent, child_cursors[index], span) -> return false
        if !jet_eval_drop_value(&child, parent_cursors[index], span) -> return false
    }
    if !jet_eval_task_roots_fixture_cell_aliases(&parent, cell_id, base_cell) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&parent, cursor_token, base_cursor) -> return false
    jet_eval_task_roots_fixture_clean(&parent) && jet_eval_task_roots_fixture_clean(&child)
}

// Failure paths run on a separate child machine built from a reusable root so
// the ownership failures they provoke never poison the parent machine.
fn jet_eval_task_roots_fixture_failures(machine: &JetEvalMachine, callback: MirFunctionId, span: Span) -> Bool {
    plain_callback :: JetEvalRuntimeValue.Closure{function: callback, captures: [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}}}
    reusable_lease :: jet_eval_callback_retain(&machine, ^plain_callback, span) ?? return false
    failure_root :: jet_eval_task_root_take(&machine, reusable_lease, span) ?? return false
    // A reusable root stays with the parent: the parent lease is intact and
    // the child received its own copy.
    if machine.callback_roots.get(reusable_lease) == None -> return false
    failure_config :: jet_eval_task_config(&machine)
    failure_child := jet_eval_task_machine(^failure_root, ^failure_config)
    if failure_child.identity == machine.identity -> return false
    if !jet_eval_task_roots_fixture_shared_roundtrip(&failure_child, span) -> return false

    // Failed transfer cleanup: a closure that captures a stack address is
    // rejected and every other alias it carried is discharged.
    fail_cell :: jet_eval_new_shared_cell(&failure_child, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}, MirAccess.Write)
    fail_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(fail_cell) ?? return false
    fail_capture :: jet_eval_copy_value(fail_cell, &failure_child, span) ?? return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, fail_cell_id, 2) -> return false
    bad_payload :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: [JetEvalRuntimeValue]{
        JetEvalRuntimeValue.Address{frame: 0, place: MirPlaceId{value: 0}, access: MirAccess.Read},
        fail_capture,
    }}}
    bad_callback :: JetEvalRuntimeValue.Closure{function: callback, captures: [JetEvalRuntimeValue]{bad_payload}}
    if jet_eval_callback_transfer(&failure_child, ^bad_callback, span) != None -> return false
    if failure_child.internal_problem == None -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, fail_cell_id, 1) -> return false
    failure_child.internal_problem = None
    if !jet_eval_drop_value(&failure_child, fail_cell, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, fail_cell_id, 0) -> return false

    // A second release is invalid only after the aggregate alias count reaches
    // zero; the registry cannot distinguish two copies while another alias is live.
    double_cell :: jet_eval_new_shared_cell(&failure_child, JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 5}}, MirAccess.Read)
    double_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(double_cell) ?? return false
    double_copy :: jet_eval_copy_value(double_cell, &failure_child, span) ?? return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, double_cell_id, 2) -> return false
    if !jet_eval_drop_value(&failure_child, double_copy, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, double_cell_id, 1) -> return false
    if !jet_eval_drop_value(&failure_child, double_cell, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, double_cell_id, 0) -> return false
    if jet_eval_drop_value(&failure_child, double_copy, span) -> return false
    if failure_child.internal_problem == None -> return false
    failure_child.internal_problem = None

    // Re-adopting one exact Native binding identity reuses its live token.
    native_callable_type :: mir_type_from_kind(MirTypeKind.Fn{signature: MirFunctionSignature{
        params: [MirType]{},
        ret: None,
        effect_bound: None,
        param_contract: None,
        call_metadata: None,
        return_view_provenance: None,
    }})
    native_owner :: JetEvalHostOwner.Native{binding: JetEvalNativeBindingIdentity.Callable{binding: JetEvalNativeCallableBinding{
        key: "task-root-native-alias",
        callable_type: native_callable_type,
    }}}
    native_handle :: MirHandleId{value: stable_id("mir-handle", "task-root-native-alias")}
    native_first :: jet_eval_host_handle_new_mode(&failure_child, None, None, native_owner, native_handle, 31, JetEvalHostValue.Data{value: TComptimeValue.Unit}, true, span) ?? return false
    native_token :: jet_eval_task_roots_fixture_foreign_token(native_first) ?? return false
    native_second :: jet_eval_host_handle_new_mode(&failure_child, None, None, native_owner, native_handle, 31, JetEvalHostValue.Data{value: TComptimeValue.Unit}, true, span) ?? return false
    if native_second != (JetEvalRuntimeValue.ForeignHandle{handle: native_handle, raw: 31, token: native_token}) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&failure_child, native_token, 2) -> return false
    if !jet_eval_foreign_handle_transfer_retire(&failure_child, native_token, span) -> return false
    if !jet_eval_drop_value(&failure_child, native_first, span) -> return false
    if !jet_eval_drop_value(&failure_child, native_second, span) -> return false

    // A malformed first field does not prevent duplicate canonical native
    // handles from being collected and released exactly once at last alias.
    native_identity :: if native_owner == {
        .Native(identity) -> Val(identity)
        else -> None
    } ?? return false
    duplicate_native_root :: JetEvalHostValue.Struct{type_name: "TaskRootDuplicateDropFixture", fields: [JetEvalHostField]{
        JetEvalHostField{
            name: "malformed",
            value: JetEvalHostValue.Handle{
                handle: MirHandleId{value: stable_id("mir-handle", "task-root-duplicate-malformed-cursor")},
                raw: 47,
                owner: JetEvalHostOwner.Cursor,
                payload: JetEvalHostValue.Data{value: TComptimeValue.Unit},
            },
        },
        JetEvalHostField{name: "first", value: JetEvalHostValue.Handle{handle: native_handle, raw: 31, owner: native_owner, payload: JetEvalHostValue.Data{value: TComptimeValue.Unit}}},
        JetEvalHostField{name: "second", value: JetEvalHostValue.Handle{handle: native_handle, raw: 31, owner: native_owner, payload: JetEvalHostValue.Data{value: TComptimeValue.Unit}}},
    }}
    duplicate_drop_adapter :: jet_eval_host_adapter_clone(&failure_child, span) ?? return false
    duplicate_drop_root := jet_eval_owned_root(&failure_child)
    duplicate_drop :: jet_eval_owned_root_drop_host(&duplicate_drop_root, duplicate_native_root, duplicate_drop_adapter, span)
    if duplicate_drop.disposition != JetEvalOwnedRootDropDisposition.ConsumedFailure || duplicate_drop.internal_problem == None -> return false
    if jet_eval_resource_handle_alias(&failure_child, native_handle, 31, JetEvalForeignTokenKind.Native{binding: native_identity}) != None -> return false
    failure_child.internal_problem = None

    // A token whose physical ownership left Source (committed native transfer)
    // still discharges its single Source alias exactly once, as Detached.
    detached :: jet_eval_cursor_handle_new(&failure_child, jet_eval_loop_cursor_handle_id(), 13, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    detached_token :: jet_eval_task_roots_fixture_foreign_token(detached) ?? return false
    if !jet_eval_foreign_handle_transfer_retire(&failure_child, detached_token, span) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&failure_child, detached_token, 0) -> return false
    if jet_eval_copy_value(detached, &failure_child, span) != None -> return false
    failure_child.internal_problem = None
    if !jet_eval_drop_value(&failure_child, detached, span) -> return false
    if jet_eval_drop_value(&failure_child, detached, span) -> return false
    if failure_child.internal_problem == None -> return false
    failure_child.internal_problem = None

    // A borrowed Native Shared.Weak physical root can be imported from an
    // independent registry; malformed earlier host fields must not skip it.
    weak_capability :: JetEvalSharedHostWeakCapability{
        handle: MirHandleId{value: stable_id("mir-handle", "task-root-external-weak")},
        raw: 53,
        generation: 1,
        type_identity: stable_id("mir-type", "task-root-external-weak-i32"),
        physical_identity: stable_id("source-shared-physical-owner", "task-root-external-weak"),
    }
    weak_element_type :: mir_type_from_kind(MirTypeKind.Int)
    weak_payload_shape :: jet_eval_host_type_shape(&failure_child, Val(weak_element_type), span) ?? return false
    weak_root :: JetEvalSharedWeak{
        metadata: shared JetEvalSharedWeakMeta{
            references: 1,
            dropped: false,
            element_type: weak_element_type,
            origin: JetEvalSharedHostOrigin.Native,
            physical_root: Val(weak_capability),
        },
    }
    external_shared_registry :: jet_eval_shared_runtime_new()
    if !jet_eval_task_roots_fixture_register_weak(external_shared_registry, weak_root) -> return false
    weak_carrier :: JetEvalSharedHostCarrier{
        kind: JetEvalSharedHostKind.Weak,
        index: None,
        registry: external_shared_registry,
        origin: JetEvalSharedHostOrigin.Native,
        physical: JetEvalSharedHostPhysicalRoot.Weak{value: weak_root},
        payload_finalizer: None,
        payload_shape: weak_payload_shape,
        owner_alias_token: None,
        owner_alias_token_pre_adopted: false,
        owns_root_capability: false,
    }

    // A writeback to a checked address adopts and installs exactly one weak
    // alias; retiring the replacement discharges that alias once.
    address_function := jet_eval_find_function(failure_child.program, callback) ?? return false
    address_value_id :: MirValueId{value: stable_id("mir-value", "task-root-writeback-address")}
    address_place :: MirPlace{
        id: MirPlaceId{value: stable_id("mir-place", "task-root-writeback-address")},
        span: span,
        ty: mir_type_from_kind(MirTypeKind.Int),
        base: MirPlaceBase.Temporary{value: address_value_id},
        projections: [MirProjection]{},
        access: MirAccess.Write,
        persist_key: None,
    }
    &address_function.places.push(address_place)
    address_program := failure_child.program
    address_function_found := false
    loop index in 0..<address_program.functions.len() {
        if address_program.functions[index].id == callback {
            address_program.functions[index] = address_function
            address_function_found = true
        }
    }
    if !address_function_found -> return false
    failure_child.program = address_program
    address_frame :: failure_child.frames.len()
    &failure_child.frames.push(jet_eval_frame(address_function, [JetEvalRuntimeValue]{}, [JetEvalRuntimeValue]{}))
    failure_child.frames[address_frame].values[address_value_id.value] = JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 5}}
    address_target :: [JetEvalRuntimeValue]{JetEvalRuntimeValue.Address{frame: address_frame, place: address_place.id, access: MirAccess.Write}}
    address_writeback :: [JetEvalHostWriteback]{JetEvalHostWriteback{
        argument: 0,
        value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier},
    }}
    if !jet_eval_host_writebacks_from(&failure_child, address_target, address_writeback, 0, span) -> return false
    if weak_root.metadata.guard_read().value.references != 2 -> return false
    address_replacement :: failure_child.frames[address_frame].values.get(address_value_id.value) ?? return false
    if address_replacement != .SharedWeak(_) -> return false
    failure_child.frames[address_frame].values[address_value_id.value] = JetEvalRuntimeValue.Moved
    if !jet_eval_drop_value(&failure_child, address_replacement, span) -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false
    &failure_child.frames.pop()

    // The same replacement path through a SharedCell retains the adopted
    // alias until the cell retires, and a read owns a separate temporary alias.
    writeback_cell :: jet_eval_new_shared_cell(&failure_child, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}, MirAccess.Write)
    writeback_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(writeback_cell) ?? return false
    cell_writeback :: [JetEvalHostWriteback]{JetEvalHostWriteback{
        argument: 0,
        value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier},
    }}
    cell_target :: [JetEvalRuntimeValue]{JetEvalRuntimeValue.SharedCell{index: writeback_cell_id, access: MirAccess.Write}}
    if !jet_eval_host_writebacks_from(&failure_child, cell_target, cell_writeback, 0, span) -> return false
    if weak_root.metadata.guard_read().value.references != 2 -> return false
    cell_replacement :: jet_eval_shared_read(&failure_child, writeback_cell_id, span) ?? return false
    if cell_replacement != .SharedWeak(_) -> return false
    if weak_root.metadata.guard_read().value.references != 3 -> return false
    if !jet_eval_drop_value(&failure_child, cell_replacement, span) -> return false
    if weak_root.metadata.guard_read().value.references != 2 -> return false
    if !jet_eval_drop_value(&failure_child, writeback_cell, span) -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false

    // A writeback can commit before dropping the previous payload reports a
    // physical cursor-close error. The replacement remains in the cell and is
    // still consumed exactly once when that cell retires.
    old_cursor := jet_eval_cursor_handle_new(&failure_child, jet_eval_loop_cursor_handle_id(), 13, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    old_cursor_token :: jet_eval_task_roots_fixture_foreign_token(old_cursor) ?? return false
    failing_cell :: jet_eval_new_shared_cell(&failure_child, old_cursor, MirAccess.Write)
    failing_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(failing_cell) ?? return false
    old_cursor = JetEvalRuntimeValue.Moved
    failing_target :: [JetEvalRuntimeValue]{JetEvalRuntimeValue.SharedCell{index: failing_cell_id, access: MirAccess.Write}}
    failing_writeback :: [JetEvalHostWriteback]{JetEvalHostWriteback{
        argument: 0,
        value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier},
    }}
    if jet_eval_host_writebacks_from(&failure_child, failing_target, failing_writeback, 0, span) -> return false
    if failure_child.internal_problem == None && failure_child.failure == None -> return false
    if jet_eval_foreign_token_aliases(&failure_child, old_cursor_token) != None -> return false
    if weak_root.metadata.guard_read().value.references != 2 -> return false
    failure_child.internal_problem = None
    failure_child.failure = None
    committed_after_close_failure :: jet_eval_shared_read(&failure_child, failing_cell_id, span) ?? return false
    if committed_after_close_failure != .SharedWeak(_) -> return false
    if weak_root.metadata.guard_read().value.references != 3 -> return false
    if !jet_eval_drop_value(&failure_child, committed_after_close_failure, span) -> return false
    if weak_root.metadata.guard_read().value.references != 2 -> return false
    if !jet_eval_drop_value(&failure_child, failing_cell, span) -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false

    // A Write address may still target a read-only/unsupported place. Its
    // replacement remains owned until the place accepts it.
    writeback_function := jet_eval_find_function(failure_child.program, callback) ?? return false
    writeback_place :: MirPlace{
        id: MirPlaceId{value: stable_id("mir-place", "task-root-writeback-reject")},
        span: span,
        ty: mir_type_from_kind(MirTypeKind.Int),
        base: MirPlaceBase.Static{name: "task_root_writeback"},
        projections: [MirProjection]{},
        access: MirAccess.Write,
        persist_key: None,
    }
    &writeback_function.places.push(writeback_place)
    writeback_program := failure_child.program
    function_found := false
    loop index in 0..<writeback_program.functions.len() {
        if writeback_program.functions[index].id == callback {
            writeback_program.functions[index] = writeback_function
            function_found = true
        }
    }
    if !function_found -> return false
    failure_child.program = writeback_program
    failure_child.config.globals["task_root_writeback"] = TComptimeValue.Unit
    writeback_frame :: failure_child.frames.len()
    &failure_child.frames.push(jet_eval_frame(writeback_function, [JetEvalRuntimeValue]{}, [JetEvalRuntimeValue]{}))
    failed_writeback :: [JetEvalHostWriteback]{JetEvalHostWriteback{
        argument: 0,
        value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier},
    }}
    failed_target :: [JetEvalRuntimeValue]{JetEvalRuntimeValue.Address{frame: writeback_frame, place: writeback_place.id, access: MirAccess.Write}}
    if jet_eval_host_writebacks_from(&failure_child, failed_target, failed_writeback, 0, span) -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false
    if failure_child.internal_problem == None && failure_child.failure == None -> return false
    failure_child.internal_problem = None
    failure_child.failure = None
    owned_outcome_writeback :: [JetEvalHostWriteback]{JetEvalHostWriteback{
        argument: 0,
        value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier},
    }}
    malformed_reply :: JetEvalHostResult{
        transfers: [JetEvalHostTransfer]{},
        writebacks: owned_outcome_writeback,
        outcome: JetEvalHostOutcome.Value{value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier}},
    }
    if jet_eval_apply_host_reply(&failure_child, malformed_reply, None, failed_target, [Bool]{false}, None, span) != None -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false
    if failure_child.internal_problem == None && failure_child.failure == None -> return false
    failure_child.internal_problem = None
    failure_child.failure = None
    &failure_child.frames.pop()

    source_weak_count :: jet_eval_task_roots_fixture_weak_count(failure_child.registry.shared_runtime)
    malformed_host_root :: JetEvalHostValue.Struct{type_name: "TaskRootDropFixture", fields: [JetEvalHostField]{
        JetEvalHostField{
            name: "malformed",
            value: JetEvalHostValue.Handle{
                handle: MirHandleId{value: stable_id("mir-handle", "task-root-malformed-cursor")},
                raw: 47,
                owner: JetEvalHostOwner.Cursor,
                payload: JetEvalHostValue.Data{value: TComptimeValue.Unit},
            },
        },
        JetEvalHostField{name: "later", value: JetEvalHostValue.SharedCarrier{carrier: weak_carrier}},
    }}
    host_drop_adapter :: jet_eval_host_adapter_clone(&failure_child, span) ?? return false
    host_drop_root := jet_eval_owned_root(&failure_child)
    host_drop :: jet_eval_owned_root_drop_host(&host_drop_root, malformed_host_root, host_drop_adapter, span)
    if host_drop.disposition != JetEvalOwnedRootDropDisposition.ConsumedFailure || host_drop.internal_problem == None -> return false
    if weak_root.metadata.guard_read().value.references != 1 -> return false
    after_host_drop_weak_count :: jet_eval_task_roots_fixture_weak_count(failure_child.registry.shared_runtime)
    if after_host_drop_weak_count != source_weak_count -> return false

    // A failed whole-root validation still consumes every valid alias in it.
    drop_cell :: jet_eval_new_shared_cell(&failure_child, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}, MirAccess.Read)
    drop_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(drop_cell) ?? return false
    invalid_handle :: JetEvalRuntimeValue.ForeignHandle{handle: jet_eval_loop_cursor_handle_id(), raw: 13, token: detached_token}
    malformed_runtime_root :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: [JetEvalRuntimeValue]{drop_cell, invalid_handle}}}
    runtime_drop_adapter :: jet_eval_host_adapter_clone(&failure_child, span) ?? return false
    runtime_drop_root := jet_eval_owned_root(&failure_child)
    runtime_drop :: jet_eval_owned_root_drop(&runtime_drop_root, malformed_runtime_root, runtime_drop_adapter, span)
    if runtime_drop.disposition != JetEvalOwnedRootDropDisposition.ConsumedFailure || runtime_drop.internal_problem == None -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, drop_cell_id, 0) -> return false

    // The consuming invoke result returns the FnOnce root's post-invoke state,
    // and its first subsequent release is distinct from a duplicate release.
    once_callback :: JetEvalRuntimeValue.Closure{function: callback, captures: [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 5}}}}
    once_lease :: jet_eval_callback_transfer(&failure_child, ^once_callback, span) ?? return false
    once_root :: jet_eval_task_root_take(&failure_child, once_lease, span) ?? return false
    invoke_adapter :: jet_eval_host_adapter_clone(&failure_child, span) ?? return false
    invoke_args :: [JetEvalRuntimeValue]{JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 2}}}
    invoked := jet_eval_task_callback_invoke(^once_root, ^invoke_args, invoke_adapter, span)
    if invoked.reusable || invoked.root.callback.value != JetEvalRuntimeValue.Moved || !invoked.root.callback.invoked -> return false
    if invoked.result.outcome != (JetEvalCallbackOutcome.Value{value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 7}}}) -> return false
    release_adapter :: jet_eval_host_adapter_clone(&failure_child, span) ?? return false
    released :: jet_eval_task_root_release(^invoked.root, release_adapter, span)
    if released.outcome != (JetEvalCallbackOutcome.Value{value: JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}}) -> return false

    // Checked Result carriers remain runtime Results even when their payloads
    // are scalar data; Option retains the compile-time Present representation.
    checked_result_ty :: mir_type_from_kind(MirTypeKind.Result{ok: mir_type_from_kind(MirTypeKind.Int), err: mir_type_from_kind(MirTypeKind.String)})
    checked_option_ty :: mir_type_from_kind(MirTypeKind.Option{inner: mir_type_from_kind(MirTypeKind.Int)})
    result_success :: jet_eval_host_value_adopt(&failure_child, None, Val(checked_result_ty), JetEvalHostValue.Present{value: JetEvalHostValue.Data{value: TComptimeValue.Int{value: 73}}}, false, span) ?? return false
    if result_success != (JetEvalRuntimeValue.Result{ok: true, value: JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 73}}}) -> return false
    result_failure :: jet_eval_host_value_adopt(&failure_child, None, Val(checked_result_ty), JetEvalHostValue.Failed{value: JetEvalHostValue.Data{value: TComptimeValue.String{value: "failed"}}}, false, span) ?? return false
    if result_failure != (JetEvalRuntimeValue.Result{ok: false, value: JetEvalRuntimeValue.Data{value: TComptimeValue.String{value: "failed"}}}) -> return false
    option_success :: jet_eval_host_value_adopt(&failure_child, None, Val(checked_option_ty), JetEvalHostValue.Present{value: JetEvalHostValue.Data{value: TComptimeValue.Int{value: 73}}}, false, span) ?? return false
    if option_success != (JetEvalRuntimeValue.Data{value: TComptimeValue.Present{value: TComptimeValue.Int{value: 73}}}) -> return false

    // A physical host failure still carries committed transfer receipts and
    // writable-argument replacements; apply receipts and writebacks before
    // surfacing the operation's Source diagnostic.
    writeback_cell :: jet_eval_new_shared_cell(&failure_child, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}, MirAccess.Write)
    writeback_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(writeback_cell) ?? return false
    transferred_cursor :: jet_eval_cursor_handle_new(&failure_child, jet_eval_loop_cursor_handle_id(), 17, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    transferred_token :: jet_eval_task_roots_fixture_foreign_token(transferred_cursor) ?? return false
    writeback_args :: [JetEvalRuntimeValue]{writeback_cell, transferred_cursor}
    failed_reply :: JetEvalHostResult{
        transfers: [JetEvalHostTransfer]{JetEvalHostTransfer{argument: 1, path: [JetEvalHostProjection]{}, token: transferred_token, handle: jet_eval_loop_cursor_handle_id(), raw: 17}},
        writebacks: [JetEvalHostWriteback]{JetEvalHostWriteback{argument: 0, value: JetEvalHostValue.Data{value: TComptimeValue.Int{value: 73}}}},
        outcome: JetEvalHostOutcome.Failure{kind: JetEvalErrorKind.Source, diagnostic: diagnostic_from_registry("E3010", Val(span), "fixture host operation failed", "the fixture injects an operation failure after its committed effects", "observe the committed writeback before handling the failure")},
    }
    if jet_eval_apply_host_reply(&failure_child, failed_reply, None, writeback_args, [Bool]{false, true}, None, span) != None -> return false
    if failure_child.failure == None || failure_child.internal_problem != None -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, writeback_cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&failure_child, transferred_token, 1) -> return false
    written_value :: jet_eval_shared_read(&failure_child, writeback_cell_id, span) ?? return false
    if written_value != (JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 73}}) -> return false
    if !jet_eval_drop_value(&failure_child, written_value, span) -> return false
    failure_child.failure = None
    if !jet_eval_drop_value(&failure_child, writeback_cell, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&failure_child, writeback_cell_id, 0) -> return false
    if !jet_eval_drop_value(&failure_child, transferred_cursor, span) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&failure_child, transferred_token, 0) -> return false

    // The failure child owns only its copied reusable root and retires cleanly;
    // the parent still holds the original lease and releases it once.
    if !jet_eval_retire_machine(&failure_child, span) -> return false
    if !jet_eval_task_roots_fixture_clean(&failure_child) -> return false
    if !jet_eval_callback_release(&machine, reusable_lease, span) -> return false
    if jet_eval_callback_release(&machine, reusable_lease, span) -> return false
    if machine.internal_problem == None -> return false
    machine.internal_problem = None
    true
}

// `callback` must be a real checked escaping closure function with one capture
// parameter. The harness supplies its ID from the fixture MIR; this function
// deliberately never fabricates capture facts for a zero-capture function.
pub fn jet_eval_task_roots_fixture(program: ^MirProgram, config: ^JetEvalConfig, callback: MirFunctionId, resource_handle: MirHandleId, resource_raw: Int, span: Span) -> Bool {
    // A Cursor-kind token closes only under the canonical loop-cursor identity,
    // so the harness must register its capability under that handle id; the
    // raw capability must be a live arena registration the adapter can release.
    if resource_handle != jet_eval_loop_cursor_handle_id() -> return false
    machine := jet_eval_machine(^program, ^config)
    cell :: jet_eval_new_shared_cell(&machine, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit}, MirAccess.Write)
    cell_id :: jet_eval_task_roots_fixture_shared_cell_index(cell) ?? return false
    cursor :: jet_eval_cursor_handle_new(&machine, resource_handle, resource_raw, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    cursor_token :: jet_eval_task_roots_fixture_foreign_token(cursor) ?? return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 1) -> return false

    // Duplicate captures count twice; the parent keeps one alias of each.
    cell_copy :: jet_eval_copy_value(cell, &machine, span) ?? return false
    cursor_copy :: jet_eval_copy_value(cursor, &machine, span) ?? return false
    parent_cell :: jet_eval_copy_value(cell, &machine, span) ?? return false
    parent_cursor :: jet_eval_copy_value(cursor, &machine, span) ?? return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 3) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 3) -> return false
    duplicate :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: [JetEvalRuntimeValue]{cell, cell_copy, cursor, cursor_copy}}}
    unrelated_cell :: jet_eval_new_shared_cell(&machine, JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 3}}, MirAccess.Write)
    unrelated_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(unrelated_cell) ?? return false
    unrelated_cursor :: jet_eval_cursor_handle_new(&machine, jet_eval_loop_cursor_handle_id(), 9, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    unrelated_cursor_token :: jet_eval_task_roots_fixture_foreign_token(unrelated_cursor) ?? return false

    // FnOnce transfer moves the closure into the callback root: no count change.
    callback_value :: JetEvalRuntimeValue.Closure{function: callback, captures: [JetEvalRuntimeValue]{duplicate}}
    lease :: jet_eval_callback_transfer(&machine, ^callback_value, span) ?? return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 3) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 3) -> return false

    // Taking the FnOnce root moves it out of the parent; the parent's own
    // aliases and unrelated entries are untouched.
    root :: jet_eval_task_root_take(&machine, lease, span) ?? return false
    if machine.callback_roots.get(lease) != None -> return false
    if !jet_eval_task_roots_fixture_list_contains(root.callback.value, cell_id, cursor_token) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 3) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 3) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, unrelated_cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, unrelated_cursor_token, 1) -> return false
    if jet_eval_task_root_take(&machine, lease, span) != None -> return false
    machine.internal_problem = None

    // The child shares the registry with a fresh identity and owns the root.
    child_config :: jet_eval_task_config(&machine)
    child := jet_eval_task_machine(^root, ^child_config)
    if child.identity == machine.identity -> return false
    if child.callback_roots.get(lease) == None -> return false
    if !jet_eval_task_roots_fixture_interleaved(&machine, &child, parent_cell, parent_cursor, cell_id, cursor_token, span) -> return false

    // Child-created entries published into the parent's cell resolve in the
    // parent, both before and after the child retires.
    child_cell :: jet_eval_new_shared_cell(&child, JetEvalRuntimeValue.Data{value: TComptimeValue.Int{value: 41}}, MirAccess.Write)
    child_cell_id :: jet_eval_task_roots_fixture_shared_cell_index(child_cell) ?? return false
    child_cursor :: jet_eval_cursor_handle_new(&child, jet_eval_loop_cursor_handle_id(), 11, JetEvalRuntimeValue.Data{value: TComptimeValue.Unit})
    child_cursor_token :: jet_eval_task_roots_fixture_foreign_token(child_cursor) ?? return false
    published :: JetEvalRuntimeValue.Aggregate{value: JetEvalRuntimeAggregate.List{values: [JetEvalRuntimeValue]{child_cell, child_cursor}}}
    if !jet_eval_shared_write(&child, cell_id, MirAccess.Write, published, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&child, child_cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&child, child_cursor_token, 1) -> return false
    resolved :: jet_eval_shared_read(&machine, cell_id, span) ?? return false
    if !jet_eval_task_roots_fixture_list_contains(resolved, child_cell_id, child_cursor_token) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, child_cell_id, 2) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, child_cursor_token, 2) -> return false

    // Child retirement discharges exactly the closure's captures (two of each);
    // the parent alias survives and the registry is not swept.
    if !jet_eval_retire_machine(&child, span) -> return false
    if !jet_eval_task_roots_fixture_clean(&child) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 1) -> return false
    if !jet_eval_shared_cell_live(&machine, cell_id, span) -> return false
    if !jet_eval_foreign_handle_matches(&machine, resource_handle, resource_raw, cursor_token, span) -> return false
    resolved_after :: jet_eval_shared_read(&machine, cell_id, span) ?? return false
    if !jet_eval_task_roots_fixture_list_contains(resolved_after, child_cell_id, child_cursor_token) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, child_cell_id, 3) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, child_cursor_token, 3) -> return false
    if !jet_eval_drop_value(&machine, resolved, span) -> return false
    if !jet_eval_drop_value(&machine, resolved_after, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, child_cell_id, 1) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, child_cursor_token, 1) -> return false

    if !jet_eval_task_roots_fixture_failures(&machine, callback, span) -> return false

    // Native consumes the child and unrelated cursor tokens whose last aliases
    // die below; their Source aliases then discharge as Detached. The primary
    // arena-backed cursor remains live so its final parent alias exercises the
    // real Last-alias close path.
    if !jet_eval_foreign_handle_transfer_retire(&machine, child_cursor_token, span) -> return false
    if !jet_eval_foreign_handle_transfer_retire(&machine, unrelated_cursor_token, span) -> return false

    // Dropping the parent's last cell alias closes the cell once and discharges
    // the published payload: the child cell dies with it.
    if !jet_eval_drop_value(&machine, parent_cell, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, cell_id, 0) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, child_cell_id, 0) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, child_cursor_token, 0) -> return false
    if jet_eval_shared_cell_live(&machine, cell_id, span) -> return false
    machine.internal_problem = None
    if !jet_eval_drop_value(&machine, parent_cursor, span) -> return false
    if !jet_eval_task_roots_fixture_token_aliases(&machine, cursor_token, 0) -> return false
    if !jet_eval_drop_value(&machine, unrelated_cell, span) -> return false
    if !jet_eval_drop_value(&machine, unrelated_cursor, span) -> return false
    if !jet_eval_task_roots_fixture_cell_aliases(&machine, unrelated_cell_id, 0) -> return false

    // The parent owns nothing else; retirement is clean and sweeps nothing.
    if !jet_eval_retire_machine(&machine, span) -> return false
    jet_eval_task_roots_fixture_clean(&machine)
}
