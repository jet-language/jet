// The Jet backend's optimization levels over LIR (Compiler/JetBackend/Docs/O1.md).
// Level 0 (`jet run`, `jet dev`, compile-time code) compiles the lowered LIR
// as is; level 1 (`jet build`) runs the O1 pipeline on every function and
// level 2 (`--release`) adds the O2 passes. The result must lint like any
// lowered module: x64_compile_module lints it again, so an optimizer bug
// refuses the build instead of producing wrong code.

fn lir_optimize_module(program: LIRModule, level: Int) -> LIRModule Never! {
    if level <= 0 -> return program.copy()
    // Bottom-up over the call graph (callees first, Opt/Inline.jet): each
    // function inlines the final, already optimized bodies of its callees
    // (P5/P4), then runs the per-function passes, and only then becomes
    // inlinable itself, so wrapper chains collapse into their callers.
    state := lir_inline_start(program)
    loop position in 0..<state.order.len() {
        // copy: plain Int function id; lir_inline_finish writes `state`, so the id
        // cannot stay a view into `state.order`.
        id :: state.order[position].copy()
        inlined :: lir_inline_step(state, id)
        optimized :: opt_function_passes(inlined, level)
        lir_inline_finish(&state, id, ^optimized)
    }
    lir_inline_result(^state)
}

// The per-function passes. Strength reduction before Simplify: Simplify
// folds its constants and removes what it leaves dead. P3 facts before
// Simplify, so Simplify folds the inline tests P3 proved and drops their slow
// paths; P6 CSE on the simplified function, then Simplify again removes what
// CSE aliased. Level 2: scalar replacement on the simplified function
// (inlined struct returns are local slots by then), Simplify propagates the
// promoted fields, CSE, LICM hoists what is invariant, and Simplify cleans up.
fn opt_function_passes(function: LIRFunction, level: Int) -> LIRFunction Never! {
    simplified :: lir_simplify_function(lir_inline_facts_function(lir_strength_function(function)))
    if level == 1 -> return lir_simplify_function(lir_cse_function(simplified))
    promoted :: lir_simplify_function(lir_scalar_replace_function(simplified))
    lir_simplify_function(lir_licm_function(lir_cse_function(promoted)))
}

// Unknown source positions stay zero, including generated instructions.
fn opt_debug_line(block: LIRBlock, index: Int) -> Int Never! {
    if block.lines.len() != block.insts.len() + 1 -> return 0
    block.lines[index]
}
