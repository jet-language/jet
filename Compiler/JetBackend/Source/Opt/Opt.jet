// The Jet backend's optimization levels over LIR (Compiler/JetBackend/Docs/O1.md).
// Level 0 (`jet run`, `jet dev`, compile-time code) compiles the lowered LIR
// as is; level 1 (`jet build`) and level 2 (`--release`, until O2 adds its own
// passes) run the O1 pipeline on every function. The result must lint like any
// lowered module: x64_compile_module lints it again, so an optimizer bug
// refuses the build instead of producing wrong code.

pub fn lir_optimize_module(program: LIRModule, level: Int) -> LIRModule Never! {
    if level <= 0 -> return ~program
    functions := [LIRFunction]{}
    loop function in program.functions -> &functions.push(lir_simplify_function(function))
    LIRModule{signatures: program.signatures, functions: functions, data: program.data}
}
