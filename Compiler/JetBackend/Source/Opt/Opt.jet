// The Jet backend's optimization levels over LIR (Compiler/JetBackend/Docs/O1.md),
// and the streaming per-function back end that applies them.
// Level 0 (`jet run`, `jet dev`, compile-time code) compiles the lowered LIR
// as is; level 1 (`jet build`) runs the O1 pipeline on every function and
// level 2 (`--release`) adds the O2 passes. The result must lint like any
// lowered module: the streaming back end lints each function's lowered body
// once, before its passes, and its final body again only when a pass changed
// it (opt_stream_job; SPEED-500K D6), so a lowering bug and an optimizer bug
// both refuse the build instead of producing wrong code.

use jet_foundation.[CompilerThreads, compiler_take_rows, compiler_threads_admit, compiler_threads_failure_text]

// The module moves in and the optimized module out, so the lowered and the
// optimized module are never both resident. This is the serial form of the
// levels (the runtime library, the native test harness, fixtures); the
// native route runs the same passes per function inside
// x64_compile_module_owned, whose result is the same by construction.
fn lir_optimize_module(program: ^LIRModule, level: Int) -> LIRModule Never! {
    if level <= 0 -> return ^program
    // Bottom-up over the call graph (callees first, Opt/Inline.jet): each
    // function inlines the final, already optimized bodies of its callees
    // (P5/P4), then runs the per-function passes, and only then becomes
    // inlinable itself, so wrapper chains collapse into their callers.
    state := lir_inline_start(^program)
    loop position in 0..<state.order.len() {
        // copy: plain Int function id; lir_inline_finish writes `state`, so the id
        // cannot stay a view into `state.order`.
        id :: state.order[position].copy()
        inlined :: lir_inline_step(state, id)
        optimized :: opt_function_passes(inlined, level)
        lir_inline_finish(&state, id, ^optimized)
    }
    lir_inline_result(^state)
}

// The per-function passes. Strength reduction before Simplify: Simplify
// folds its constants and removes what it leaves dead. P3 facts before
// Simplify, so Simplify folds the inline tests P3 proved and drops their slow
// paths; P6 CSE on the simplified function, then Simplify again removes what
// CSE aliased. Level 2: scalar replacement on the simplified function
// (inlined struct returns are local slots by then), Simplify propagates the
// promoted fields, CSE, LICM hoists what is invariant, and Simplify cleans up.
fn opt_function_passes(function: LIRFunction, level: Int) -> LIRFunction Never! {
    simplified :: lir_simplify_function(lir_inline_facts_function(lir_strength_function(function)))
    if level == 1 -> return lir_simplify_function(lir_cse_function(simplified))
    promoted :: lir_simplify_function(lir_scalar_replace_function(simplified))
    lir_simplify_function(lir_licm_function(lir_cse_function(promoted)))
}

// Unknown source positions stay zero, including generated instructions.
fn opt_debug_line(block: LIRBlock, index: Int) -> Int Never! {
    if block.lines.len() != block.insts.len() + 1 -> return 0
    block.lines[index]
}

// ---------------------------------------------------------------------------
// The streaming per-function back end (SPEED-500K §8 #10): the module's
// functions compile as one job each on the threads `threads` admits, and a
// job is a function's whole back end: the LIR lint of its lowered body, its
// inline step and passes at the level (level > 0), the lint of its final body
// when a pass changed it, and its x64 selection and encoding. No LIR module
// beyond the lowered one is ever materialized: a job takes its lowered body
// out of the module for its duration, puts the final body back when it
// settles, and a body is released (opt_stream_release) once its own job and
// every caller's inline step have read it, so the resident LIR only shrinks
// from the lowering on.
//
// Jobs are scheduled by dependency, not in waves (opt_schedule): a function's
// inline step reads only the final bodies of its non-recursive direct callees
// (Opt/Inline.jet inline_caller), so a function is runnable once every such
// callee has settled, and a claiming thread takes the runnable function with
// the longest remaining dependency chain (OptSchedule.priority) from the ready
// queue. Each job is a pure function of its lowered body and those final
// bodies; lir_optimize_module visits the same functions in a Tarjan order
// with the same property, and lir_lint_function and x64_compile_function
// read of other functions only their name and signature, which no pass
// changes. Results sit in slots by function id and file in id order: the
// functions, debug rows and errors are those the calling thread produces
// alone with lir_optimize_module, lir_lint_module and x64_compile_module,
// for any thread count and any order of completion.
//
// A thread with nothing ready does not poll: it blocks on the job token
// (OptStreamJob) of the running job most likely to end next, whose edit
// guard its thread holds for the job's duration, and reconsiders when that
// guard is released. A job that stops (a panic in a pass or the selector)
// releases its guard without marking the token done, which the thread that
// wakes on it reports: without JET_KEEP_GOING the compile stops and the
// panic text is re-raised at the stopped thread's join; with it the function
// becomes a trap and the compile continues.
//
// JET_KEEP_GOING (the bootstrap native feed): nothing stops the compile. A
// function a lint finding names, whose selection reports gaps, or whose job
// stops compiles as a trap (x64_trap_function) with one error naming it, its
// lowered body stays in the module and is never inlined, so the function
// table stays whole and the object, link and every later function still run
// and report. Its output is never shipped.

// Function compiling threads (D-JOBS1, compiler_threads_admit): a thread is
// admitted for at least this many LIR instructions, so a small module
// compiles on the calling thread.
X64_COMPILE_MIN_INSTRUCTIONS_PER_THREAD :: 20000

// x64_compile_module_owned's result: the compiled functions, and the module
// moved back out of the jobs' shared store with every function body
// released (its name, signature and debug facts remain: the object writer
// reads those), except the bodies of `faults`: the functions (ascending)
// whose job reported a lint finding or a compile error, kept in their final
// form (the lowered one when the job stopped) for a fault dump.
struct X64CompiledModule {
    program: LIRModule
    compiled: X64ModuleResult
    faults: [Int]
}

// The call-graph schedule of a compile at level > 0. `deps[f]` are f's
// non-recursive direct callees (each once), whose final bodies f's inline
// step reads; `callers[g]` counts the functions whose `deps` hold g and
// `dependents[g]` lists them; `priority[f]` is the instruction weight of f
// plus the heaviest chain of dependents above it (the remaining critical
// path through f), so when several functions are ready the one that gates
// the most work goes first. Ids are rows of the module's function table, so
// the schedule is the same for any thread count.
struct OptSchedule {
    recursive: [Bool]
    deps: [[Int]]
    callers: [Int]
    dependents: [[Int]]
    priority: [Int]
}

// The schedule of `program` after P5 (inline_direct) over every function, in
// place: the rows move out and back, uncopied. `weights` are the functions'
// instruction weights (x64_compile_weights, after P5).
fn opt_schedule(program: &LIRModule) -> OptSchedule Never! {
    signatures := [LIRSignatureID]{}
    loop function in program.functions -> &signatures.push(function.signature)
    functions := compiler_take_rows<LIRFunction>(&program.functions)
    reversed := [LIRFunction]{}
    loop functions.len() > 0 {
        function := &functions.pop() ?? { break }
        &reversed.push(inline_direct(signatures, ^function))
    }
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        &program.functions.push(^function)
    }
    graph :: inline_graph(program.functions)
    count :: program.functions.len()
    deps := [[Int]]{}
    callers := [Int]{}
    dependents := [[Int]]{}
    priority := [Int]{}
    // mark[g] is the last caller whose deps took g: each callee once per caller.
    mark := [Int]{}
    loop function in program.functions {
        &deps.push([Int]{})
        &callers.push(0)
        &dependents.push([Int]{})
        &priority.push(opt_stream_weight(function))
        &mark.push(-1)
    }
    loop node in 0..<count {
        loop target in graph.edges[node] {
            if graph.recursive[target] || mark[target] == node -> next
            mark[target] = node
            &deps[node].push(target)
            &dependents[target].push(node)
            callers[target] = callers[target] + 1
        }
    }
    // Tarjan's order finishes every callee's SCC before its caller's, so
    // walking it backwards takes every dependent's priority before the
    // function's own.
    position := graph.order.len()
    loop position > 0 {
        position -= 1
        node :: graph.order[position].copy()
        above := 0
        loop dependent in dependents[node] {
            if priority[dependent] > above -> above = priority[dependent]
        }
        priority[node] = priority[node] + above
    }
    OptSchedule{recursive: graph.recursive.copy(), deps: deps, callers: callers, dependents: dependents, priority: priority}
}

// The schedule of a level 0 compile: no function reads another, every
// function is ready at once, heaviest first.
fn opt_schedule_flat(program: LIRModule) -> OptSchedule Never! {
    recursive := [Bool]{}
    deps := [[Int]]{}
    callers := [Int]{}
    dependents := [[Int]]{}
    priority := [Int]{}
    loop function in program.functions {
        &recursive.push(false)
        &deps.push([Int]{})
        &callers.push(0)
        &dependents.push([Int]{})
        &priority.push(opt_stream_weight(function))
    }
    OptSchedule{recursive: recursive, deps: deps, callers: callers, dependents: dependents, priority: priority}
}

// Each function's instructions (and one per block), in function order.
fn x64_compile_weights(program: LIRModule) -> [Int] Never! {
    weights := [Int]{}
    loop function in program.functions -> &weights.push(opt_stream_weight(function))
    weights
}

fn opt_stream_weight(function: LIRFunction) -> Int Never! {
    size := 0
    loop block in function.blocks -> size += block.insts.len() + 1
    size
}

// What every job reads and nothing writes while jobs run: the module with
// its function bodies taken out (each row keeps its id, name and signature,
// which the lint of a caller reads, and empty values and blocks), the level
// and whether the module's tables have lint findings (then the compile stops
// at the findings: every job lints its lowered body and compiles nothing).
// The bodies come back into this module after the last job.
struct OptStreamTables {
    programs: [LIRModule]
    level: Int
    lint_only: Bool
}

// The function bodies and the results, under one guard taken briefly per
// job: `functions[id]` is a one-row list holding function `id`'s body (the
// lowered one, then the final one once its job settles; empty while its own
// job holds it; values and blocks empty once released), with the inline
// facts of its final body (`sizes` 41 until then, as lir_inline_start starts
// them); `callers[g]` counts the dependents whose inline step has not run
// yet; `lints` and `outcomes` are each job's rows, filed by id.
struct OptStreamStore {
    functions: [[LIRFunction]]
    recursive: [Bool]
    sizes: [Int]
    consumed: [[Bool]]
    deps: [[Int]]
    callers: [Int]
    faulted: [Bool]
    lints: [[String]]
    outcomes: [X64CompileResult]
}

// The ready queue and the seats, under one guard taken briefly per claim and
// per settle. `ready` is a max-heap of runnable function ids by `priority`
// (ties: the lower id); `waiting[f]` counts f's unsettled deps; `remaining`
// the unsettled functions; `stopped` ends every claim (a job stopped without
// JET_KEEP_GOING). Per seat (one per claiming thread): whether a job runs
// there, its token and its weight.
struct OptStreamQueue {
    ready: [Int]
    priority: [Int]
    waiting: [Int]
    dependents: [[Int]]
    remaining: Int
    stopped: Bool
    busy: [Bool]
    tokens: [Shared<OptStreamJob>]
    weights: [Int]
}

// One job's token. Its thread holds the edit guard from before the claim
// until after the settle, with the function's lowered body inside for the
// job's duration, so a thread that stops leaves the body for the fault
// dump, and `done` false tells the thread that wakes on the released guard
// that the job stopped rather than settled. `seat` is the claiming seat,
// recorded with the claim, so a keep-going trap settles that seat without
// reading any other token (their guards are held by running jobs).
struct OptStreamJob {
    id: Int
    seat: Int
    done: Bool
    function: [LIRFunction]
}

// One claim: the function to compile, or the token of a running job to
// wait on when nothing is ready, or neither when the compile is over.
struct OptStreamClaim {
    id: Int
    wait: Shared<OptStreamJob>?
}

// The one LIR lint and the compile of every function of a module it owns,
// with the LIR passes of `level`, on as many threads as `threads` admits for
// its instructions (see the section comment above). The result's rows are
// x64_compile_module's over lir_optimize_module's module, with `keep_going`
// (JET_KEEP_GOING) as that section describes.
fn x64_compile_module_owned(program: ^LIRModule, threads: CompilerThreads, level: Int, keep_going: Bool) -> X64CompiledModule Never! {
    owned := ^program
    lint := [String]{}
    loop issue in lir_lint_module_rows(owned) -> &lint.push(x64_lint_error(issue))
    lint_only :: lint.len() > 0 && !keep_going
    count :: owned.functions.len()
    schedule := if level > 0 -> opt_schedule(&owned) else -> opt_schedule_flat(owned)
    weights :: x64_compile_weights(owned)
    total := 0
    loop weight in weights -> total += weight
    workers :: compiler_threads_admit(threads, count, total, X64_COMPILE_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    // The bodies move out of the module into the store; the module keeps
    // each function's identity row for the lints of its callers.
    rows := compiler_take_rows<LIRFunction>(&owned.functions)
    bodies := [[LIRFunction]]{}
    loop rows.len() > 0 {
        row := &rows.pop() ?? { break }
        &owned.functions.push(LIRFunction{id: row.id, name: row.name, signature: row.signature, values: [LIRValue]{}, blocks: [LIRBlock]{}, debug: lir_function_debug_none()})
        &bodies.push([LIRFunction]{^row})
    }
    &owned.functions.reverse()
    &bodies.reverse()
    sizes := [Int]{}
    consumed := [[Bool]]{}
    faulted := [Bool]{}
    lints := [[String]]{}
    outcomes := [X64CompileResult]{}
    waiting := [Int]{}
    ready := [Int]{}
    loop id in 0..<count {
        &sizes.push(41)
        &consumed.push([Bool]{})
        &faulted.push(false)
        &lints.push([String]{})
        &outcomes.push(X64CompileResult{function: None, debug: None, errors: [String]{}})
        &waiting.push(schedule.deps[id].len())
        if schedule.deps[id].len() == 0 -> &ready.push(id)
    }
    tables :: shared OptStreamTables{programs: [LIRModule]{^owned}, level: level, lint_only: lint_only}
    store :: shared OptStreamStore{functions: ^bodies, recursive: ^schedule.recursive, sizes: ^sizes, consumed: ^consumed, deps: ^schedule.deps, callers: ^schedule.callers, faulted: ^faulted, lints: ^lints, outcomes: ^outcomes}
    // Without JET_KEEP_GOING a stop stops the compile, so the calling thread
    // claims too, from the last seat; with it every claiming thread is a task
    // whose stop is caught at its join.
    tasks :: if keep_going -> workers else -> workers - 1
    seats :: tasks + 1
    busy := [Bool]{}
    tokens := [Shared<OptStreamJob>]{}
    seat_weights := [Int]{}
    loop _ in 0..<seats {
        &busy.push(false)
        &tokens.push(shared OptStreamJob{id: -1, seat: -1, done: true, function: [LIRFunction]{}})
        &seat_weights.push(0)
    }
    heap := [Int]{}
    priority :: ^schedule.priority
    loop id in ready -> opt_heap_push(&heap, priority, id)
    queue :: shared OptStreamQueue{ready: ^heap, priority: ^priority, waiting: ^waiting, dependents: ^schedule.dependents, remaining: count, stopped: false, busy: ^busy, tokens: ^tokens, weights: ^weights}
    _ := opt_stream_claimers(tables, store, queue, 0, tasks, !keep_going, keep_going) ?? panic("the x64 compile threads failed")
    // JET_KEEP_GOING: a job whose thread stopped before any other thread
    // woke on its token (the last claiming thread, say) is still unsettled;
    // a fresh claiming task finds it and traps it, until nothing remains.
    loop keep_going && opt_stream_remaining(queue) > 0 {
        _ := opt_stream_claimers(tables, store, queue, tasks, 1, false, true) ?? panic("the x64 compile threads failed")
    }
    program_back := opt_stream_take_program(tables)
    results := opt_stream_take_store(store)
    // Each body (final, or lowered where the job stopped or compiled at
    // level 0; released unless faulted) moves back into its row.
    id := 0
    loop results.functions.len() > 0 {
        row := &results.functions.pop() ?? { break }
        at :: count - 1 - id
        if (&row.pop()) == .Val(body) -> program_back.functions[at] = ^body
        id += 1
    }
    faults := [Int]{}
    loop row in 0..<count { if results.faulted[row] -> &faults.push(row) }
    errors := ^lint
    loop row in 0..<count -> &errors.extend(compiler_take_rows<String>(&results.lints[row]))
    if !keep_going && errors.len() > 0 -> return X64CompiledModule{program: program_back, compiled: X64ModuleResult{functions: [X64CompiledFunction]{}, debug: [X64FunctionDebug]{}, errors: errors}, faults: faults}
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    // The outcomes file in id order: popped once into reverse order, then
    // popped again, each moved, never copied.
    reversed := [X64CompileResult]{}
    loop results.outcomes.len() > 0 {
        outcome := &results.outcomes.pop() ?? { break }
        &reversed.push(^outcome)
    }
    id = 0
    loop reversed.len() > 0 {
        outcome := &reversed.pop() ?? { break }
        x64_compile_file_result(^outcome, keep_going, program_back.functions[id], &functions, &debug, &errors)
        id += 1
    }
    X64CompiledModule{program: program_back, compiled: X64ModuleResult{functions: functions, debug: debug, errors: errors}, faults: faults}
}

fn opt_stream_take_program(tables: Shared<OptStreamTables>) -> LIRModule {
    permit :: tables.guard_edit()
    &permit.value.programs.pop() ?? panic("the x64 compile module left its shared tables")
}

fn opt_stream_take_store(store: Shared<OptStreamStore>) -> OptStreamStore {
    permit := store.guard_edit()
    OptStreamStore{functions: compiler_take_rows<[LIRFunction]>(&permit.value.functions), recursive: [Bool]{}, sizes: [Int]{}, consumed: [[Bool]]{}, deps: [[Int]]{}, callers: [Int]{}, faulted: compiler_take_rows<Bool>(&permit.value.faulted), lints: compiler_take_rows<[String]>(&permit.value.lints), outcomes: compiler_take_rows<X64CompileResult>(&permit.value.outcomes)}
}

fn opt_stream_remaining(queue: Shared<OptStreamQueue>) -> Int {
    permit :: queue.guard_read()
    permit.value.remaining
}

// The ready heap: a binary max-heap over `heap` ordered by priority, then
// by the lower id, so the pop order is a function of the schedule alone.
fn opt_heap_before(priority: [Int], left: Int, right: Int) -> Bool Never! {
    if priority[left] != priority[right] -> return priority[left] > priority[right]
    left < right
}

fn opt_heap_push(heap: &[Int], priority: [Int], id: Int) Never! {
    &heap.push(id)
    at := heap.len() - 1
    loop at > 0 {
        parent :: (at - 1) /% 2
        if !opt_heap_before(priority, heap[at], heap[parent]) -> break
        moved :: heap[parent].copy()
        heap[parent] = heap[at]
        heap[at] = moved
        at = parent
    }
}

fn opt_heap_pop(heap: &[Int], priority: [Int]) -> Int Never! {
    top :: heap[0].copy()
    last :: &heap.pop() ?? panic("the x64 compile ready heap was empty")
    if heap.len() == 0 -> return top
    heap[0] = last
    at := 0
    loop {
        left :: 2 * at + 1
        if left >= heap.len() -> break
        child := left
        right :: left + 1
        if right < heap.len() && opt_heap_before(priority, heap[right], heap[left]) -> child = right
        if !opt_heap_before(priority, heap[child], heap[at]) -> break
        moved :: heap[child].copy()
        heap[child] = heap[at]
        heap[at] = moved
        at = child
    }
    top
}

// Runs `tasks` claiming threads from seat `seat` on, one task each, and one
// more on this thread when `inline` (the seat after the tasks'); returns how
// many functions they compiled. A claiming task that stops re-raises its
// panic here unless `keep_going`. A task group is a failure source of its
// own: the claimers fail only when their group does, which stops the
// compile.
fn opt_stream_claimers(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, seat: Int, tasks: Int, inline: Bool, keep_going: Bool) -> Int {
    if tasks <= 0 {
        if inline -> return opt_stream_claimed(tables, store, queue, seat, keep_going)
        return 0
    }
    compiled := 0
    task.group x64_compile {
        head :: task opt_stream_claimed(tables, store, queue, seat, keep_going)
        compiled = opt_stream_claimers(tables, store, queue, seat + 1, tasks - 1, inline, keep_going)
        compiled += head.join() ?? opt_stream_stopped(keep_going, err)
    }
    compiled
}

// A stopped claiming thread: its panic text, re-raised unchanged so an
// internal error reads the same with any thread count; under JET_KEEP_GOING
// its job was trapped by the thread that woke on its token.
fn opt_stream_stopped(keep_going: Bool, failure: TaskFailure) -> Int Never! {
    if !keep_going -> panic(compiler_threads_failure_text(failure))
    0
}

// One thread at `seat`: claims and compiles ready functions until the
// compile is over, waiting on a running job's token when nothing is ready.
fn opt_stream_claimed(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, seat: Int, keep_going: Bool) -> Int {
    compiled := 0
    loop {
        claim :: opt_stream_turn(tables, store, queue, seat)
        if claim.id >= 0 {
            compiled += 1
            next
        }
        waited :: claim.wait ?? break
        opt_stream_await(tables, store, queue, waited, keep_going)
    }
    compiled
}

// One turn of a claiming thread: a fresh token, held from before the claim
// so no thread sees it unheld before its job settles, and the job when a
// function is ready. The claim's wait (or neither) comes back otherwise.
fn opt_stream_turn(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, seat: Int) -> OptStreamClaim {
    token :: shared OptStreamJob{id: -1, seat: -1, done: false, function: [LIRFunction]{}}
    permit := token.guard_edit()
    claim :: opt_stream_claim(queue, seat, token)
    if claim.id < 0 {
        permit.value.done = true
        return OptStreamClaim{id: -1, wait: claim.wait}
    }
    permit.value.id = claim.id
    permit.value.seat = seat
    opt_stream_job(tables, store, queue, seat, claim.id, &permit.value)
    permit.value.done = true
    OptStreamClaim{id: claim.id, wait: None}
}

// The claim itself: the highest-priority ready function, registered at
// `seat` with `token`; else, while jobs run, the token of the lightest
// running job (the one most likely to end next) to wait on; else nothing.
fn opt_stream_claim(queue: Shared<OptStreamQueue>, seat: Int, token: Shared<OptStreamJob>) -> OptStreamClaim {
    permit := queue.guard_edit()
    if permit.value.stopped -> return OptStreamClaim{id: -1, wait: None}
    // A seat still marked busy here held a job whose thread stopped (the
    // keep-going follow-up claimer reuses its seat): trap that job first,
    // never overwrite its token.
    if permit.value.busy[seat] -> return OptStreamClaim{id: -1, wait: Val(permit.value.tokens[seat])}
    if permit.value.ready.len() > 0 {
        id :: opt_queue_pop(&permit.value)
        permit.value.busy[seat] = true
        permit.value.tokens[seat] = token
        return OptStreamClaim{id: id, wait: None}
    }
    if permit.value.remaining == 0 -> return OptStreamClaim{id: -1, wait: None}
    lightest :: opt_queue_lightest(permit.value, seat)
    if lightest < 0 -> panic("the x64 compile stalled: {permit.value.remaining} functions left, none ready, none running")
    OptStreamClaim{id: -1, wait: Val(permit.value.tokens[lightest])}
}

fn opt_queue_pop(state: &OptStreamQueue) -> Int Never! {
    opt_heap_pop(&state.ready, state.priority)
}

// The busy seat other than `seat` with the lightest job, or -1.
fn opt_queue_lightest(state: OptStreamQueue, seat: Int) -> Int Never! {
    lightest := -1
    loop (index, flag) in state.busy {
        if !flag || index == seat -> next
        if lightest < 0 || state.weights[index] < state.weights[lightest] -> lightest = index
    }
    lightest
}

// Waits for the job holding `token` to end. A job that settled marked its
// token done; one that stopped did not: without JET_KEEP_GOING every claim
// then ends and the stopped task's join re-raises its panic; with it the
// function becomes a trap and the compile goes on.
fn opt_stream_await(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, token: Shared<OptStreamJob>, keep_going: Bool) {
    permit := token.guard_edit()
    if permit.value.done -> return
    permit.value.done = true
    if !keep_going {
        opt_stream_stop(queue)
        return
    }
    opt_stream_trap(tables, store, queue, &permit.value)
}

fn opt_stream_stop(queue: Shared<OptStreamQueue>) {
    permit := queue.guard_edit()
    permit.value.stopped = true
}

// JET_KEEP_GOING: the function of a stopped job becomes one error and a
// trap; its lowered body (in the token when the job had taken it) stays in
// the module, never inlined (its size stays 41).
fn opt_stream_trap(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, job: &OptStreamJob) {
    id :: job.id
    name :: opt_stream_name(tables, id)
    seat :: job.seat
    result := X64CompileResult{function: None, debug: None, errors: [String]{"x64: {name}: keep-going trap: compiling it stopped"}}
    opt_stream_settle(store, queue, seat, id, [LIRFunction]{}, 0, [Bool]{}, [String]{}, ^result, &job.function)
}

fn opt_stream_name(tables: Shared<OptStreamTables>, id: Int) -> String {
    read :: tables.guard_read()
    read.value.programs[0].functions[id].name
}

// One job: function `id`'s back end at the tables' level, with the lowered
// body in `job` for its duration (opt_stream_take_body) and every result
// filed by opt_stream_settle. The lint of the lowered body runs first and
// always; findings (or `lint_only`) end the job there, so a lowering bug is
// reported on the body the lowering produced. Level 0 compiles that body.
// Otherwise the inline step and the passes run, the final body is linted
// again only when it differs from the lowered one (an unchanged body is the
// same body), and a clean final body is selected and encoded.
fn opt_stream_job(tables: Shared<OptStreamTables>, store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, seat: Int, id: Int, job: &OptStreamJob) {
    opt_stream_take_body(store, id, &job.function)
    level :: opt_stream_level(tables)
    lint := opt_stream_lint(tables, id, job.function[0])
    if lint.len() > 0 || level < 0 {
        none := X64CompileResult{function: None, debug: None, errors: [String]{}}
        opt_stream_settle(store, queue, seat, id, [LIRFunction]{}, 0, [Bool]{}, ^lint, ^none, &job.function)
        return
    }
    if level == 0 {
        result := opt_stream_compile(tables, job.function[0])
        opt_stream_settle(store, queue, seat, id, [LIRFunction]{}, 0, [Bool]{}, ^lint, ^result, &job.function)
        return
    }
    inlined :: opt_stream_inline(store, job.function[0])
    optimized := opt_function_passes(inlined, level)
    facts := lir_inline_measure(optimized)
    if opt_stream_changed(job.function[0], optimized) {
        lint = opt_stream_lint(tables, id, optimized)
    }
    result := if lint.len() > 0 -> X64CompileResult{function: None, debug: None, errors: [String]{}} else -> opt_stream_compile(tables, optimized)
    opt_stream_settle(store, queue, seat, id, [LIRFunction]{^optimized}, facts.size, ^facts.consumed, ^lint, ^result, &job.function)
}

// The level, or -1 when the module's tables have findings (lint_only).
fn opt_stream_level(tables: Shared<OptStreamTables>) -> Int {
    read :: tables.guard_read()
    if read.value.lint_only -> -1 else -> read.value.level
}

// Function `id`'s lowered body moves out of the store into `into`.
fn opt_stream_take_body(store: Shared<OptStreamStore>, id: Int, into: &[LIRFunction]) {
    permit := store.guard_edit()
    body := &permit.value.functions[id].pop() ?? panic("the x64 compile store has no body for function {id}")
    &into.push(^body)
}

fn opt_stream_lint(tables: Shared<OptStreamTables>, id: Int, function: LIRFunction) -> [String] {
    read :: tables.guard_read()
    lint := [String]{}
    loop issue in lir_lint_function_row(read.value.programs[0], id, function) -> &lint.push(x64_lint_error(issue))
    lint
}

fn opt_stream_compile(tables: Shared<OptStreamTables>, function: LIRFunction) -> X64CompileResult {
    read :: tables.guard_read()
    x64_compile_function(read.value.programs[0], function)
}

// The inline step reads the final bodies of the function's callees in the
// store, whose guard is held for exactly that long.
fn opt_stream_inline(store: Shared<OptStreamStore>, original: LIRFunction) -> LIRFunction {
    read :: store.guard_read()
    inline_caller(read.value.functions, original, read.value.recursive, read.value.sizes, read.value.consumed)
}

// Whether a pass changed the function: a different shape (value, block or
// instruction counts) settles it at once, else the bodies compare whole.
fn opt_stream_changed(before: LIRFunction, after: LIRFunction) -> Bool Never! {
    if before.values.len() != after.values.len() || before.blocks.len() != after.blocks.len() -> return true
    loop (index, block) in before.blocks {
        if block.insts.len() != after.blocks[index].insts.len() -> return true
    }
    before != after
}

// After a job: the body that stays in the module (`final`, a one-row list,
// with its inline facts; else the lowered body in `lowered`) goes back into
// the function's row, its rows into its slots, and the bodies no later job
// reads are released: every callee of the function whose callers have all
// taken their inline step, and the function's own body when it has no
// callers. A function whose job reported a lint finding or an error is
// faulted and keeps its body. Then the function's dependents that have no
// unsettled dep left become ready, and the seat is free.
fn opt_stream_settle(store: Shared<OptStreamStore>, queue: Shared<OptStreamQueue>, seat: Int, id: Int, final: ^[LIRFunction], size: Int, consumed: ^[Bool], lint: ^[String], result: ^X64CompileResult, lowered: &[LIRFunction]) {
    faulted :: lint.len() > 0 || result.errors.len() > 0
    kept := ^final
    opt_stream_file(store, id, &kept, size, ^consumed, faulted, ^lint, ^result, &lowered)
    opt_stream_ready(queue, seat, id)
}

fn opt_stream_file(store: Shared<OptStreamStore>, id: Int, final: &[LIRFunction], size: Int, consumed: ^[Bool], faulted: Bool, lint: ^[String], result: ^X64CompileResult, lowered: &[LIRFunction]) {
    permit := store.guard_edit()
    if (&final.pop()) == .Val(body) {
        &permit.value.functions[id].push(^body)
        permit.value.sizes[id] = size
        permit.value.consumed[id] = ^consumed
    } else {
        if (&lowered.pop()) == .Val(body) -> &permit.value.functions[id].push(^body)
    }
    permit.value.faulted[id] = faulted
    permit.value.lints[id] = lint
    permit.value.outcomes[id] = ^result
    loop at in 0..<permit.value.deps[id].len() {
        target :: permit.value.deps[id][at].copy()
        permit.value.callers[target] = permit.value.callers[target] - 1
        if permit.value.callers[target] == 0 && !permit.value.faulted[target] -> opt_stream_release(&permit.value.functions, target)
    }
    if permit.value.callers[id] == 0 && !faulted -> opt_stream_release(&permit.value.functions, id)
}

// Releases function `id`'s body: no job reads it again. Its name, signature
// and debug facts stay for the object writer.
fn opt_stream_release(rows: &[[LIRFunction]], id: Int) Never! {
    if rows[id].len() == 0 -> return
    rows[id][0].values = [LIRValue]{}
    rows[id][0].blocks = [LIRBlock]{}
}

fn opt_stream_ready(queue: Shared<OptStreamQueue>, seat: Int, id: Int) {
    permit := queue.guard_edit()
    permit.value.busy[seat] = false
    permit.value.remaining = permit.value.remaining - 1
    loop at in 0..<permit.value.dependents[id].len() {
        dependent :: permit.value.dependents[id][at].copy()
        permit.value.waiting[dependent] = permit.value.waiting[dependent] - 1
        if permit.value.waiting[dependent] == 0 -> opt_queue_push(&permit.value, dependent)
    }
}

fn opt_queue_push(state: &OptStreamQueue, id: Int) Never! {
    opt_heap_push(&state.ready, state.priority, id)
}

// x64_relocatable_object_owned's result: the object, and the final LIR of
// every function whose job reported a lint finding or a compile error
// (ascending by id; empty when the object compiled), for the host's fault
// dump. Costs nothing when nothing failed.
struct X64ObjectOutcome {
    object: X64ExecutableResult
    faults: [LIRFunction]
}

fn x64_object_outcome_failed(errors: [String]) -> X64ObjectOutcome Never! {
    X64ObjectOutcome{object: X64ExecutableResult{bytes: [U8]{}, errors: errors}, faults: [LIRFunction]{}}
}

// The faulted functions moved out of the compiled module, in id order.
fn x64_object_faults(kept: &X64CompiledModule) -> [LIRFunction] Never! {
    faults := [LIRFunction]{}
    if kept.faults.len() == 0 -> return faults
    wanted := [Bool]{}
    loop _ in kept.program.functions -> &wanted.push(false)
    loop id in kept.faults -> wanted[id] = true
    rows := compiler_take_rows<LIRFunction>(&kept.program.functions)
    reversed := [LIRFunction]{}
    loop rows.len() > 0 {
        row := &rows.pop() ?? { break }
        &reversed.push(^row)
    }
    id := 0
    loop reversed.len() > 0 {
        row := &reversed.pop() ?? { break }
        if wanted[id] -> &faults.push(^row)
        id += 1
    }
    faults
}

// x64_relocatable_object over a module it owns, compiled on as many threads
// as `threads` admits with the LIR passes of `level`
// (x64_compile_module_owned): the object bytes are the same for any thread
// count. The module moves through the compile, uncopied. `keep_going`
// (JET_KEEP_GOING, the bootstrap native feed): every function is present (a
// trap where compiling it failed), so the object is written whenever its own
// writer succeeds, and the result keeps the compile errors before the
// writer's. It is never shipped.
fn x64_relocatable_object_owned(program: ^LIRModule, entry: LIRFunctionID, threads: CompilerThreads, level: Int, keep_going: Bool) -> X64ObjectOutcome Never! {
    if entry.value < 0 || entry.value >= program.functions.len() -> return x64_object_outcome_failed([String]{"entry function {entry.value} is not in the module"})
    signature :: lir_signature(program, program.functions[entry.value].signature) ?? return x64_object_outcome_failed([String]{"entry function has no signature"})
    if signature.params.len() != 0 || signature.result != None -> return x64_object_outcome_failed([String]{"entry function {program.functions[entry.value].name} must take no parameters and return nothing"})
    kept := x64_compile_module_owned(^program, threads, level, keep_going)
    if !keep_going && kept.compiled.errors.len() > 0 {
        errors :: compiler_take_rows<String>(&kept.compiled.errors)
        return X64ObjectOutcome{object: X64ExecutableResult{bytes: [U8]{}, errors: errors}, faults: x64_object_faults(&kept)}
    }
    main :: x64_object_main(entry)
    functions := [X64CompiledFunction]{main}
    &functions.extend(compiler_take_rows<X64CompiledFunction>(&kept.compiled.functions))
    debug := [X64FunctionDebug]{x64_object_main_debug(main)}
    &debug.extend(compiler_take_rows<X64FunctionDebug>(&kept.compiled.debug))
    written := x64_object_functions_threads(kept.program, functions, debug, [X64RuntimeExport]{X64RuntimeExport{function: LIRFunctionID{value: -1}, symbol: "main"}}, threads)
    if !keep_going -> return X64ObjectOutcome{object: ^written, faults: [LIRFunction]{}}
    errors := compiler_take_rows<String>(&kept.compiled.errors)
    &errors.extend(compiler_take_rows<String>(&written.errors))
    written.errors = errors
    X64ObjectOutcome{object: ^written, faults: x64_object_faults(&kept)}
}
