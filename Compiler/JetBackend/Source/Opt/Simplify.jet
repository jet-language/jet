// O1 scalar simplification of one LIR function (Compiler/JetBackend/Docs/O1.md):
// copy and move propagation, constant folding, algebraic identities, branch
// folding, unreachable-block removal, empty-block threading, straight-line
// block merging and dead-code elimination, repeated until nothing changes
// (bounded). The result is a valid LIR function: every remaining value is
// defined once and the value table is renumbered densely.
//
// Folding follows the LIR operator definitions in LIR.jet exactly: integer
// words are 64-bit two's complement, and a fold that would need wrapping (an
// exact result outside the signed 64-bit range) is left to the machine.
// Float operations are never folded (signed zeros, NaN payloads).

use jet_foundation.[compiler_take_rows]

OPT_I64_MIN :: prep { -9223372036854775808 }
OPT_I64_MAX :: prep { 9223372036854775807 }

// Per-value facts of one sweep: `alias[v]` is the value v was replaced by
// (-1 for none); `known[v]` marks a value defined by Const with `consts[v]`.
struct OptFacts {
    alias: [Int]
    known: [Bool]
    consts: [Int]
}

fn opt_facts(count: Int) -> OptFacts Never! {
    facts := OptFacts{alias: [Int]{}, known: [Bool]{}, consts: [Int]{}}
    loop _ in 0..<count {
        &facts.alias.push(-1)
        &facts.known.push(false)
        &facts.consts.push(0)
    }
    facts
}

fn opt_root(facts: OptFacts, value: Int) -> Int Never! {
    at := value
    loop facts.alias[at] >= 0 -> at = facts.alias[at]
    at
}

fn opt_id(facts: OptFacts, value: LIRValueID) -> LIRValueID Never! {
    LIRValueID{value: opt_root(facts, value.value)}
}

fn opt_ids(facts: OptFacts, values: [LIRValueID]) -> [LIRValueID] Never! {
    out := [LIRValueID]{}
    loop value in values -> &out.push(opt_id(facts, value))
    out
}

fn opt_target(facts: OptFacts, target: LIRJumpTarget) -> LIRJumpTarget Never! {
    LIRJumpTarget{block: target.block, args: opt_ids(facts, target.args)}
}

// `inst` with every use replaced by its alias root.
fn opt_rename_inst(facts: OptFacts, inst: LIRInst) -> LIRInst Never! {
    if inst == {
        .Const(_, _) -> inst
        .Binary(dst, op, left, right) -> LIRInst.Binary{dst: dst, op: op, left: opt_id(facts, left), right: opt_id(facts, right)}
        .Compare(dst, condition, left, right) -> LIRInst.Compare{dst: dst, condition: condition, left: opt_id(facts, left), right: opt_id(facts, right)}
        .Move(dst, src) -> LIRInst.Move{dst: dst, src: opt_id(facts, src)}
        // Consuming conversion: retain the destination's new drop obligation.
        .Reown(dst, src) -> LIRInst.Reown{dst: dst, src: opt_id(facts, src)}
        .Copy(dst, src) -> LIRInst.Copy{dst: dst, src: opt_id(facts, src)}
        // Pure, but never an alias: the destination may change ABI class.
        .Bitcast(dst, src) -> LIRInst.Bitcast{dst: dst, src: opt_id(facts, src)}
        .Call(dst, signature, callee, args) -> {
            renamed :: if callee == {
                .Value(target) -> LIRCallee.Value{value: opt_id(facts, target)}
                else -> callee
            }
            LIRInst.Call{dst: dst, signature: signature, callee: renamed, args: opt_ids(facts, args)}
        }
        // copy: `dst` is a payload of read parameter `inst`, which keeps the original; field `dst` of the new LIRInst.InlineAsm owns this one
        .InlineAsm(dst, args, regs, result, code) -> LIRInst.InlineAsm{dst: dst.copy(), args: opt_ids(facts, args), regs: regs, result: result, code: code}
        .Drop(value) -> LIRInst.Drop{value: opt_id(facts, value)}
        .Overflows(dst, op, left, right) -> LIRInst.Overflows{dst: dst, op: op, left: opt_id(facts, left), right: opt_id(facts, right)}
        .Load(dst, base, offset) -> LIRInst.Load{dst: dst, base: opt_id(facts, base), offset: offset}
        .PointerAdd(dst, base, offset) -> LIRInst.PointerAdd{dst: dst, base: opt_id(facts, base), offset: opt_id(facts, offset)}
        .Store(base, offset, value) -> LIRInst.Store{base: opt_id(facts, base), offset: offset, value: opt_id(facts, value)}
        .DataAddress(_, _) -> inst
        .FunctionAddress(_, _) -> inst
        .Convert(dst, src) -> LIRInst.Convert{dst: dst, src: opt_id(facts, src)}
        .StackSlot(_, _, _) -> inst
        .ThreadWord(_, _) -> inst
    }
}

fn opt_rename_terminator(facts: OptFacts, terminator: LIRTerminator) -> LIRTerminator Never! {
    if terminator == {
        .Jump(target) -> LIRTerminator.Jump{target: opt_target(facts, target)}
        .Branch(condition, then_target, else_target) -> LIRTerminator.Branch{condition: opt_id(facts, condition), then_target: opt_target(facts, then_target), else_target: opt_target(facts, else_target)}
        .Return(value) -> {
            if value == .Val(returned) -> return LIRTerminator.Return{value: Val(opt_id(facts, returned))}
            terminator
        }
        .Unreachable -> terminator
    }
}

fn opt_fits(value: Int) -> Bool Never! {
    value >= OPT_I64_MIN && value <= OPT_I64_MAX
}

// Truncating signed division of two words; None when the machine traps
// (zero divisor) or the quotient leaves the word (MIN / -1).
fn opt_div(left: Int, right: Int) -> Int? {
    if right == 0 -> return None
    if left == OPT_I64_MIN && right == -1 -> return None
    magnitude :: (if left < 0 -> 0 - left else -> left) /% (if right < 0 -> 0 - right else -> right)
    if (left < 0) != (right < 0) -> return Val(0 - magnitude)
    Val(magnitude)
}

// The folded word of `left op right`, or None when it is not folded.
fn opt_fold_binary(op: LIRBinaryOp, left: Int, right: Int) -> Int? {
    if op == {
        .Add | .UAdd -> {
            sum :: left + right
            if opt_fits(sum) -> return Val(sum)
            None
        }
        .Sub | .USub -> {
            difference :: left - right
            if opt_fits(difference) -> return Val(difference)
            None
        }
        .Mul | .UMul -> {
            product :: left * right
            if opt_fits(product) -> return Val(product)
            None
        }
        .Div -> opt_div(left, right)
        .Rem -> {
            quotient :: opt_div(left, right) ?? return None
            Val(left - quotient * right)
        }
        .UDiv -> {
            if left < 0 || right <= 0 -> return None
            Val(left /% right)
        }
        .URem -> {
            if left < 0 || right <= 0 -> return None
            Val(left - (left /% right) * right)
        }
        .And -> Val(left.bit_and(right))
        .Or -> Val(left.bit_or(right))
        .Xor -> Val(left.bit_xor(right))
        .Shl -> {
            if right < 0 || right > 63 -> return None
            shifted :: left << right
            if opt_fits(shifted) -> return Val(shifted)
            None
        }
        .Shr -> {
            if right < 0 || right > 63 -> return None
            Val(left >> right)
        }
        .UShr -> {
            if right < 0 || right > 63 || left < 0 -> return None
            Val(left >> right)
        }
    }
}

// Whether `left op right` overflows, as Overflows defines it; None when not folded.
fn opt_fold_overflows(op: LIRBinaryOp, left: Int, right: Int) -> Bool? {
    if op == {
        .Add -> Val(!opt_fits(left + right))
        .Sub -> Val(!opt_fits(left - right))
        .Mul -> Val(!opt_fits(left * right))
        .UAdd -> {
            if left < 0 || right < 0 -> return None
            // Both below 2^63: the unsigned sum stays below 2^64.
            Val(false)
        }
        .USub -> {
            if left < 0 || right < 0 -> return None
            Val(left < right)
        }
        .UMul -> {
            if left < 0 || right < 0 -> return None
            // Both below 2^63; the unsigned product overflows from 2^64 on.
            Val(left * right > 2 * OPT_I64_MAX + 1)
        }
        else -> None
    }
}

// Unsigned order of two words given as signed values.
fn opt_unsigned_less(left: Int, right: Int) -> Bool Never! {
    if (left < 0) == (right < 0) -> return left < right
    right < 0
}

fn opt_fold_compare(condition: LIRCondition, left: Int, right: Int) -> Bool Never! {
    if condition == {
        .Eq -> left == right
        .Ne -> left != right
        .Lt -> left < right
        .Le -> left <= right
        .Gt -> left > right
        .Ge -> left >= right
        .ULt -> opt_unsigned_less(left, right)
        .ULe -> !opt_unsigned_less(right, left)
        .UGt -> opt_unsigned_less(right, left)
        .UGe -> !opt_unsigned_less(left, right)
    }
}

fn opt_is_word(function: LIRFunction, value: LIRValueID) -> Bool Never! {
    function.values[value.value].layout == lir_layout_word()
}

fn opt_bool(flag: Bool) -> Int Never! { if flag -> 1 else -> 0 }

// What one instruction becomes after folding: kept as it is (`kept`), replaced
// by `inst`, or dropped (`kept` false, `inst` None) with its result replaced by
// the value `replaced_by`.
struct OptRewrite {
    kept: Bool
    inst: LIRInst?
    replaced_by: Int
}

fn opt_keep() -> OptRewrite Never! { OptRewrite{kept: true, inst: None, replaced_by: -1} }

fn opt_become(inst: ^LIRInst) -> OptRewrite Never! { OptRewrite{kept: false, inst: Val(^inst), replaced_by: -1} }

fn opt_replace(by: LIRValueID) -> OptRewrite Never! { OptRewrite{kept: false, inst: None, replaced_by: by.value} }

fn opt_const(dst: LIRValueID, value: Int) -> OptRewrite Never! { opt_become(LIRInst.Const{dst: dst, value: value}) }

// Integer identities on word operands (never Float: `x + 0.0` is not `x`).
fn opt_identity(facts: OptFacts, dst: LIRValueID, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> OptRewrite? {
    right_known :: facts.known[right.value]
    left_known :: facts.known[left.value]
    r :: facts.consts[right.value]
    l :: facts.consts[left.value]
    if op == {
        .Add | .UAdd | .Or | .Xor -> {
            if right_known && r == 0 -> return Val(opt_replace(left))
            if left_known && l == 0 -> return Val(opt_replace(right))
        }
        .Sub | .USub | .Shl | .Shr | .UShr -> {
            if right_known && r == 0 -> return Val(opt_replace(left))
        }
        .Mul | .UMul -> {
            if right_known && r == 1 -> return Val(opt_replace(left))
            if left_known && l == 1 -> return Val(opt_replace(right))
            if (right_known && r == 0) || (left_known && l == 0) -> return Val(opt_const(dst, 0))
        }
        .And -> {
            if right_known && r == -1 -> return Val(opt_replace(left))
            if left_known && l == -1 -> return Val(opt_replace(right))
            if (right_known && r == 0) || (left_known && l == 0) -> return Val(opt_const(dst, 0))
        }
        .Div | .UDiv -> {
            if right_known && r == 1 -> return Val(opt_replace(left))
        }
        else -> {}
    }
    if left == right {
        if op == .Sub || op == .USub || op == .Xor -> return Val(opt_const(dst, 0))
        if op == .And || op == .Or -> return Val(opt_replace(left))
    }
    None
}

// Where every value is defined: the block row and instruction index of its
// defining instruction, -1 for a parameter or an undefined value. Valid
// while the function keeps its shape.
struct OptDefs {
    block: [Int]
    index: [Int]
}

fn opt_defs(function: LIRFunction) -> OptDefs Never! {
    block := [Int]{}
    index := [Int]{}
    loop _ in function.values {
        &block.push(-1)
        &index.push(-1)
    }
    loop (row, defining) in function.blocks {
        loop (at, inst) in defining.insts {
            if lir_inst_def(inst) == .Val(dst) {
                block[dst.value] = row
                index[dst.value] = at
            }
        }
    }
    OptDefs{block: block, index: index}
}

// The word of every value a Const defines (`known[v]`: `consts[v]`), as the
// function stands when the table is taken; a pass that moves or folds
// instructions keeps reading the table.
struct OptConsts {
    known: [Bool]
    consts: [Int]
}

fn opt_const_defs(function: LIRFunction) -> OptConsts Never! {
    known := [Bool]{}
    consts := [Int]{}
    loop _ in function.values {
        &known.push(false)
        &consts.push(0)
    }
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .Const(dst, value) {
                known[dst.value] = true
                consts[dst.value] = value
            }
        }
    }
    OptConsts{known: known, consts: consts}
}

// The operands of every value a `Binary(Or, left, right)` defines (-1 for
// any other value), as the function stands when the table is taken: the
// sweep's sign test reads the definition as it was before the sweep.
struct OptSignDefs {
    left: [Int]
    right: [Int]
}

fn opt_sign_defs(function: LIRFunction) -> OptSignDefs Never! {
    left := [Int]{}
    right := [Int]{}
    loop _ in function.values {
        &left.push(-1)
        &right.push(-1)
    }
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .Binary(dst, op, a, b) {
                if op == .Or {
                    left[dst.value] = a.value
                    right[dst.value] = b.value
                }
            }
        }
    }
    OptSignDefs{left: left, right: right}
}

// `Compare(Ge|Lt, Or(x, c), 0)` with a non-negative constant c tests the sign
// of x alone: or-ing a word whose sign bit is clear never changes the sign.
fn opt_sign_test(facts: OptFacts, defs: OptSignDefs, function: LIRFunction, dst: LIRValueID, condition: LIRCondition, left: LIRValueID, right: LIRValueID) -> OptRewrite? {
    if condition != .Ge && condition != .Lt -> return None
    if !facts.known[right.value] || facts.consts[right.value] != 0 -> return None
    if !opt_is_word(function, left) -> return None
    a :: defs.left[left.value]
    if a < 0 -> return None
    b :: defs.right[left.value]
    if facts.known[b] && facts.consts[b] >= 0 -> return Val(opt_become(LIRInst.Compare{dst: dst, condition: condition, left: LIRValueID{value: opt_root(facts, a)}, right: right}))
    if facts.known[a] && facts.consts[a] >= 0 -> return Val(opt_become(LIRInst.Compare{dst: dst, condition: condition, left: LIRValueID{value: opt_root(facts, b)}, right: right}))
    None
}

fn opt_rewrite(facts: OptFacts, defs: OptSignDefs, function: LIRFunction, inst: LIRInst) -> OptRewrite Never! {
    if inst == {
        .Move(_, src) -> return opt_replace(src)
        .Copy(_, src) -> return opt_replace(src)
        .Binary(dst, op, left, right) -> {
            if !opt_is_word(function, dst) -> return opt_keep()
            if facts.known[left.value] && facts.known[right.value] {
                if opt_fold_binary(op, facts.consts[left.value], facts.consts[right.value]) == .Val(value) -> return opt_const(dst, value)
            }
            if opt_identity(facts, dst, op, left, right) == .Val(rewrite) -> return rewrite
            opt_keep()
        }
        .Compare(dst, condition, left, right) -> {
            layout :: function.values[left.value].layout
            if layout.class == .Float -> return opt_keep()
            if facts.known[left.value] && facts.known[right.value] -> return opt_const(dst, opt_bool(opt_fold_compare(condition, facts.consts[left.value], facts.consts[right.value])))
            if left == right && layout.class != .Float {
                if condition == .Eq || condition == .Le || condition == .Ge || condition == .ULe || condition == .UGe -> return opt_const(dst, 1)
                return opt_const(dst, 0)
            }
            if opt_sign_test(facts, defs, function, dst, condition, left, right) == .Val(rewrite) -> return rewrite
            opt_keep()
        }
        .Overflows(dst, op, left, right) -> {
            if facts.known[left.value] && facts.known[right.value] {
                if opt_fold_overflows(op, facts.consts[left.value], facts.consts[right.value]) == .Val(flag) -> return opt_const(dst, opt_bool(flag))
            }
            if facts.known[right.value] && facts.consts[right.value] == 0 && (op == .Add || op == .Sub || op == .UAdd || op == .USub) -> return opt_const(dst, 0)
            opt_keep()
        }
        else -> opt_keep()
    }
}

// One folding sweep over every block in order, in place: a dropped
// instruction leaves its block (with its line), the rest stay where they
// are. Returns whether anything changed.
fn opt_fold_sweep(function: &LIRFunction, facts: &OptFacts) -> Bool Never! {
    changed := false
    defs :: opt_sign_defs(function)
    loop row in 0..<function.blocks.len() {
        if opt_fold_block(&function, &facts, defs, row) -> changed = true
    }
    changed
}

fn opt_fold_block(function: &LIRFunction, facts: &OptFacts, defs: OptSignDefs, row: Int) -> Bool Never! {
    changed := false
    lined :: function.blocks[row].lines.len() == function.blocks[row].insts.len() + 1
    at := 0
    loop at < function.blocks[row].insts.len() {
        if opt_rename_slot(facts, &function.blocks[row].insts, at) -> changed = true
        rewrite := opt_rewrite(facts, defs, function, function.blocks[row].insts[at])
        if rewrite.kept {
            if function.blocks[row].insts[at] == .Const(dst, value) {
                facts.known[dst.value] = true
                facts.consts[dst.value] = value
            }
            at += 1
            next
        }
        changed = true
        if rewrite.inst != None {
            kept :: ^rewrite.inst ?? panic("a rewrite with an instruction lost it")
            if kept == .Const(dst, value) {
                facts.known[dst.value] = true
                facts.consts[dst.value] = value
            }
            function.blocks[row].insts[at] = ^kept
            at += 1
            next
        }
        if lir_inst_def(function.blocks[row].insts[at]) == .Val(dst) -> facts.alias[dst.value] = opt_root(facts, rewrite.replaced_by)
        _ := &function.blocks[row].insts.remove(at, .Slot)
        if lined -> _ := &function.blocks[row].lines.remove(at, .Slot)
    }
    // Unknown source positions stay zero (opt_debug_line).
    if !lined {
        function.blocks[row].lines = [Int]{}
        loop _ in 0..<(function.blocks[row].insts.len() + 1) -> &function.blocks[row].lines.push(0)
    }
    if opt_rename_terminator_slot(facts, &function.blocks[row]) -> changed = true
    folded := LIRJumpTarget?{None}
    if function.blocks[row].terminator == .Branch(condition, then_target, else_target) {
        if facts.known[condition.value] {
            folded = Val(if facts.consts[condition.value] != 0 -> then_target.copy() else -> else_target.copy())
        } else {
            if then_target == else_target -> folded = Val(then_target.copy())
        }
    }
    target := ^folded ?? { return changed }
    function.blocks[row].terminator = LIRTerminator.Jump{target: ^target}
    true
}

// Whether any use of `inst` has an alias root other than itself.
fn opt_renames(facts: OptFacts, inst: LIRInst) -> Bool Never! {
    if inst == {
        .Const(_, _) -> false
        .Binary(_, _, left, right) -> opt_aliased(facts, left) || opt_aliased(facts, right)
        .Compare(_, _, left, right) -> opt_aliased(facts, left) || opt_aliased(facts, right)
        .Move(_, src) -> opt_aliased(facts, src)
        .Reown(_, src) -> opt_aliased(facts, src)
        .Copy(_, src) -> opt_aliased(facts, src)
        .Bitcast(_, src) -> opt_aliased(facts, src)
        .Call(_, _, callee, args) -> {
            if callee == .Value(target) { if opt_aliased(facts, target) -> return true }
            opt_any_aliased(facts, args)
        }
        .InlineAsm(_, args, _, _, _) -> opt_any_aliased(facts, args)
        .Drop(value) -> opt_aliased(facts, value)
        .Overflows(_, _, left, right) -> opt_aliased(facts, left) || opt_aliased(facts, right)
        .Load(_, base, _) -> opt_aliased(facts, base)
        .PointerAdd(_, base, offset) -> opt_aliased(facts, base) || opt_aliased(facts, offset)
        .Store(base, _, value) -> opt_aliased(facts, base) || opt_aliased(facts, value)
        .DataAddress(_, _) -> false
        .FunctionAddress(_, _) -> false
        .Convert(_, src) -> opt_aliased(facts, src)
        .StackSlot(_, _, _) -> false
        .ThreadWord(_, _) -> false
    }
}

fn opt_aliased(facts: OptFacts, value: LIRValueID) -> Bool Never! {
    facts.alias[value.value] >= 0
}

fn opt_any_aliased(facts: OptFacts, values: [LIRValueID]) -> Bool Never! {
    loop value in values { if opt_aliased(facts, value) -> return true }
    false
}

fn opt_renames_target(facts: OptFacts, target: LIRJumpTarget) -> Bool Never! {
    opt_any_aliased(facts, target.args)
}

fn opt_renames_terminator(facts: OptFacts, terminator: LIRTerminator) -> Bool Never! {
    if terminator == {
        .Jump(target) -> opt_renames_target(facts, target)
        .Branch(condition, then_target, else_target) -> opt_aliased(facts, condition) || opt_renames_target(facts, then_target) || opt_renames_target(facts, else_target)
        .Return(value) -> {
            if value == .Val(returned) -> return opt_aliased(facts, returned)
            false
        }
        .Unreachable -> false
    }
}

// Names every use of `insts[index]` by its alias root, in place; an
// instruction with no aliased use stays untouched. Returns whether it changed.
fn opt_rename_slot(facts: OptFacts, insts: &[LIRInst], index: Int) -> Bool Never! {
    if !opt_renames(facts, insts[index]) -> return false
    renamed :: opt_rename_inst(facts, insts[index])
    insts[index] = ^renamed
    true
}

// Names every use of the block's terminator by its alias root, in place.
fn opt_rename_terminator_slot(facts: OptFacts, block: &LIRBlock) -> Bool Never! {
    if !opt_renames_terminator(facts, block.terminator) -> return false
    renamed :: opt_rename_terminator(facts, block.terminator)
    block.terminator = ^renamed
    true
}

// Block id -> index in `function.blocks` (lir_block_rows).
fn opt_block_rows(function: LIRFunction) -> [Int:Int] Never! {
    lir_block_rows(function)
}

// Keep the blocks reachable from the entry, in their order.
fn opt_drop_unreachable(function: &LIRFunction) -> Bool Never! {
    rows :: opt_block_rows(function)
    reached := [Bool]{}
    loop _ in function.blocks -> &reached.push(false)
    reached[0] = true
    pending := [Int]{0}
    cursor := 0
    loop cursor < pending.len() {
        current :: pending[cursor].copy()
        cursor += 1
        loop target in lir_terminator_targets(function.blocks[current].terminator) {
            row :: rows.get(target.block.value) ?? -1
            if row >= 0 && !reached[row] {
                reached[row] = true
                &pending.push(row)
            }
        }
    }
    if pending.len() == function.blocks.len() -> return false
    blocks := compiler_take_rows<LIRBlock>(&function.blocks)
    index := 0
    loop block in ^blocks {
        if reached[index] -> &function.blocks.push(^block)
        index += 1
    }
    true
}

fn opt_predecessor_counts(function: LIRFunction, rows: [Int:Int]) -> [Int] Never! {
    counts := [Int]{}
    loop _ in function.blocks -> &counts.push(0)
    loop block in function.blocks {
        loop target in lir_terminator_targets(block.terminator) {
            row :: rows.get(target.block.value) ?? -1
            if row >= 0 -> counts[row] = counts[row] + 1
        }
    }
    counts
}

// An edge into a block with no instructions that only jumps on goes straight
// to that block's target; its parameters become the edge's own arguments.
// A value the empty block passes through dominates it, hence every
// predecessor's jump as well. A parameter of the empty block that any other
// block reads directly (the empty block dominates the reader) refuses the
// bypass: that read would lose its definition (`outside`, opt_outside_uses).
fn opt_thread_target(function: LIRFunction, rows: [Int:Int], outside: [Bool], target: LIRJumpTarget) -> LIRJumpTarget Never! {
    // copy: the threaded target is a new owned jump target. With no row it equals `target`, the
    // caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    row :: rows.get(target.block.value) ?? return target.copy()
    // copy: the threaded target is a new owned jump target. For the entry row it equals `target`,
    // the caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    if row == 0 -> return target.copy()
    hop :: function.blocks[row]
    // copy: the threaded target is a new owned jump target. For a non-empty hop it equals `target`,
    // the caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    if hop.insts.len() != 0 -> return target.copy()
    // copy: the threaded target is a new owned jump target. When a hop parameter escapes it equals
    // `target`, the caller's terminator edge (a read parameter), which stays in the block being
    // rebuilt.
    loop param in hop.params { if outside[param.value] -> return target.copy() }
    if hop.terminator == .Jump(onward) {
        // copy: the threaded target is a new owned jump target. For a self-loop it equals `target`,
        // the caller's terminator edge (a read parameter), which stays in the block being rebuilt.
        if onward.block == hop.id -> return target.copy()
        args := [LIRValueID]{}
        loop arg in onward.args {
            mapped := arg
            loop (position, param) in hop.params {
                if param == arg -> mapped = target.args[position]
            }
            &args.push(mapped)
        }
        return LIRJumpTarget{block: onward.block, args: args}
    }
    // copy: the threaded target is a new owned jump target. Otherwise it equals `target`, the
    // caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    target.copy()
}

// Values read by an instruction or terminator of a block other than the one
// whose parameter they are (every non-parameter use counts).
fn opt_outside_uses(function: LIRFunction) -> [Bool] Never! {
    owner := [Int]{}
    outside := [Bool]{}
    loop _ in function.values {
        &owner.push(-1)
        &outside.push(false)
    }
    loop (index, block) in function.blocks {
        loop param in block.params -> owner[param.value] = index
    }
    operands := [LIRValueID]{}
    loop (index, block) in function.blocks {
        loop inst in block.insts {
            lir_inst_uses_into(inst, &operands)
            loop used in operands { if owner[used.value] != index -> outside[used.value] = true }
        }
        lir_terminator_uses_into(block.terminator, &operands)
        loop used in operands { if owner[used.value] != index -> outside[used.value] = true }
    }
    outside
}

// Whether any edge of `function` can thread: a block after the entry with
// no instructions that jumps on to another block (opt_thread_target's
// shape tests before the parameter escape test).
fn opt_has_hop(function: LIRFunction) -> Bool Never! {
    loop (row, block) in function.blocks {
        if row == 0 || block.insts.len() != 0 -> next
        if block.terminator == .Jump(onward) {
            if onward.block != block.id -> return true
        }
    }
    false
}

// Threads every block's edges, reading the function as it was before this
// pass (a hop threaded earlier in the pass is still read as the hop), then
// writes the changed terminators back in place. With no hop in the
// function no edge changes, and the use scan is skipped.
fn opt_thread(function: &LIRFunction) -> Bool Never! {
    if !opt_has_hop(function) -> return false
    rows :: opt_block_rows(function)
    outside :: opt_outside_uses(function)
    threaded_rows := [Int]{}
    threaded := [LIRTerminator]{}
    loop (row, block) in function.blocks {
        found := LIRTerminator?{None}
        if block.terminator == {
            .Jump(target) -> found = Val(LIRTerminator.Jump{target: opt_thread_target(function, rows, outside, target)})
            .Branch(condition, then_target, else_target) -> {
                then_next :: opt_thread_target(function, rows, outside, then_target)
                else_next :: opt_thread_target(function, rows, outside, else_target)
                found = Val(if then_next == else_next -> LIRTerminator.Jump{target: then_next} else -> LIRTerminator.Branch{condition: condition, then_target: then_next, else_target: else_next})
            }
            else -> {}
        }
        terminator :: found ?? { next }
        if terminator != block.terminator {
            &threaded_rows.push(row)
            &threaded.push(terminator)
        }
    }
    loop (at, row) in threaded_rows -> function.blocks[row].terminator = threaded[at].copy()
    threaded_rows.len() > 0
}

// A block that jumps to a block with no other predecessor absorbs it: the
// successor's parameters become aliases of the jump's arguments. An edge that
// adopts an argument into a parameter with other drop glue (lower_adopt: a
// trivial word or pointer into an owner) is the only spelling of that
// adoption, so it is never merged; aliasing would drop the obligation
// (inline_alias_safe refuses the same change at call entries).
//
// One pass in block order: a block absorbs its successor, then (its
// terminator is now the successor's) the next, until its jump no longer
// qualifies; an absorbed block is skipped and the list is compacted once.
// This is the result of rescanning from the first block after every merge:
// a merge moves the successor's edges to the block, so no other block's
// terminator, edge count or drop comparison changes (the successor's
// parameters alias arguments of the same drop glue), and the rescan's first
// candidate is the merging block again or a later one.
fn opt_merge(function: &LIRFunction, facts: &OptFacts) -> Bool Never! {
    rows :: opt_block_rows(function)
    counts :: opt_predecessor_counts(function, rows)
    absorbed := [Bool]{}
    loop _ in function.blocks -> &absorbed.push(false)
    changed := false
    loop index in 0..<function.blocks.len() {
        if absorbed[index] -> next
        loop {
            jump := LIRJumpTarget?{None}
            if function.blocks[index].terminator == .Jump(found) -> jump = Val(found.copy())
            target :: jump ?? { break }
            row :: rows.get(target.block.value) ?? -1
            if row <= 0 || row == index || absorbed[row] || counts[row] != 1 || !opt_merge_keeps_drops(function, facts, function.blocks[row], target) -> break
            loop (position, param) in function.blocks[row].params -> facts.alias[param.value] = opt_root(facts, target.args[position].value)
            // The block's own source lines stay when they describe its
            // instructions, else they are unknown (opt_debug_line); then the
            // successor's, for its instructions and its terminator.
            block_count :: function.blocks[index].insts.len()
            successor_count :: function.blocks[row].insts.len()
            if function.blocks[index].lines.len() == block_count + 1 {
                _ := &function.blocks[index].lines.pop()
            } else {
                function.blocks[index].lines = [Int]{}
                loop _ in 0..<block_count -> &function.blocks[index].lines.push(0)
            }
            if function.blocks[row].lines.len() == successor_count + 1 {
                successor_lines := compiler_take_rows<Int>(&function.blocks[row].lines)
                &function.blocks[index].lines.extend(^successor_lines)
            } else {
                loop _ in 0..<(successor_count + 1) -> &function.blocks[index].lines.push(0)
            }
            successor_insts := compiler_take_rows<LIRInst>(&function.blocks[row].insts)
            &function.blocks[index].insts.extend(^successor_insts)
            terminator :: function.blocks[row].terminator.copy()
            function.blocks[index].terminator = terminator
            absorbed[row] = true
            changed = true
        }
    }
    if !changed -> return false
    blocks := compiler_take_rows<LIRBlock>(&function.blocks)
    index := 0
    loop block in ^blocks {
        if !absorbed[index] -> &function.blocks.push(^block)
        index += 1
    }
    true
}

// Every parameter of `successor` has the drop glue of its argument's root.
fn opt_merge_keeps_drops(function: LIRFunction, facts: OptFacts, successor: LIRBlock, target: LIRJumpTarget) -> Bool Never! {
    loop (position, param) in successor.params {
        if function.values[param.value].drop != function.values[opt_root(facts, target.args[position].value)].drop -> return false
    }
    true
}

fn opt_inst_has_effect(inst: LIRInst) -> Bool Never! {
    if inst == {
        .Call(_, _, _, _) | .InlineAsm(_, _, _, _, _) -> true
        .Drop(_) -> true
        .Store(_, _, _) -> true
        .Reown(_, _) -> true
        else -> false
    }
}

// Remove instructions whose results nothing uses and parameters no live use
// reads (with their arguments on every incoming edge; entry parameters stay).
fn opt_dead_code(function: &LIRFunction) -> Bool Never! {
    live := [Bool]{}
    loop _ in function.values -> &live.push(false)
    rows :: opt_block_rows(function)
    defs :: opt_defs(function)
    loop param in function.blocks[0].params -> live[param.value] = true
    pending := [Int]{}
    operands := [LIRValueID]{}
    loop block in function.blocks {
        loop inst in block.insts {
            if opt_inst_has_effect(inst) {
                lir_inst_uses_into(inst, &operands)
                loop used in operands {
                    if !live[used.value] {
                        live[used.value] = true
                        &pending.push(used.value)
                    }
                }
            }
        }
        if block.terminator == {
            .Branch(condition, _, _) -> {
                if !live[condition.value] {
                    live[condition.value] = true
                    &pending.push(condition.value)
                }
            }
            .Return(value) -> {
                if value == .Val(returned) {
                    if !live[returned.value] {
                        live[returned.value] = true
                        &pending.push(returned.value)
                    }
                }
            }
            else -> {}
        }
    }
    // Parameter p of block b at `position`: every edge into b makes its
    // argument at `position` live once p is.
    param_block := [Int]{}
    param_position := [Int]{}
    loop _ in function.values {
        &param_block.push(-1)
        &param_position.push(-1)
    }
    loop (index, block) in function.blocks {
        loop (position, param) in block.params {
            param_block[param.value] = index
            param_position[param.value] = position
        }
    }
    // Edge `at` of block `row`'s terminator (a Jump's target, a Branch's
    // then and else targets) enters `incoming_rows[row][at]`.
    incoming_rows := [[Int]]{}
    incoming_edges := [[Int]]{}
    loop _ in function.blocks {
        &incoming_rows.push([Int]{})
        &incoming_edges.push([Int]{})
    }
    loop (index, block) in function.blocks {
        loop (at, target) in lir_terminator_targets(block.terminator) {
            row :: rows.get(target.block.value) ?? -1
            if row >= 0 {
                &incoming_rows[row].push(index)
                &incoming_edges[row].push(at)
            }
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        value :: pending[cursor].copy()
        cursor += 1
        if defs.block[value] >= 0 {
            lir_inst_uses_into(function.blocks[defs.block[value]].insts[defs.index[value]], &operands)
            loop used in operands {
                if !live[used.value] {
                    live[used.value] = true
                    &pending.push(used.value)
                }
            }
        }
        if param_block[value] >= 0 {
            into :: param_block[value]
            loop (edge, source) in incoming_rows[into] {
                arg :: opt_edge_arg(function.blocks[source].terminator, incoming_edges[into][edge], param_position[value])
                if !live[arg] {
                    live[arg] = true
                    &pending.push(arg)
                }
            }
        }
    }
    // Drop the arguments of removed parameters on every edge into a block
    // that loses a parameter (opt_live_args reads the parameter lists from
    // before the removal), then the dead parameters and instructions, each
    // block compacted in place.
    pruned := [Bool]{}
    loop (index, block) in function.blocks {
        prune := false
        if index > 0 {
            loop param in block.params { if !live[param.value] -> prune = true }
        }
        &pruned.push(prune)
    }
    rewired_rows := [Int]{}
    rewired := [LIRTerminator]{}
    loop (index, block) in function.blocks {
        if !opt_prunes_edge(rows, pruned, block.terminator) -> next
        &rewired_rows.push(index)
        &rewired.push(if block.terminator == {
            .Jump(target) -> LIRTerminator.Jump{target: opt_live_args(function, rows, live, target)}
            .Branch(condition, then_target, else_target) -> LIRTerminator.Branch{condition: condition, then_target: opt_live_args(function, rows, live, then_target), else_target: opt_live_args(function, rows, live, else_target)}
            else -> block.terminator.copy()
        })
    }
    changed := false
    loop row in 0..<function.blocks.len() {
        if opt_dead_block(&function, live, row) -> changed = true
    }
    loop (at, row) in rewired_rows -> function.blocks[row].terminator = rewired[at].copy()
    changed
}

// Whether an edge of `terminator` enters a block of `pruned`.
fn opt_prunes_edge(rows: [Int:Int], pruned: [Bool], terminator: LIRTerminator) -> Bool Never! {
    if terminator == {
        .Jump(target) -> opt_pruned_row(rows, pruned, target)
        .Branch(_, then_target, else_target) -> opt_pruned_row(rows, pruned, then_target) || opt_pruned_row(rows, pruned, else_target)
        else -> false
    }
}

fn opt_pruned_row(rows: [Int:Int], pruned: [Bool], target: LIRJumpTarget) -> Bool Never! {
    row :: rows.get(target.block.value) ?? return false
    pruned[row]
}

// The argument at `position` of edge `at` of `terminator` (lir_terminator_targets' order).
fn opt_edge_arg(terminator: LIRTerminator, at: Int, position: Int) -> Int Never! {
    if terminator == {
        .Jump(target) -> target.args[position].value
        .Branch(_, then_target, else_target) -> if at == 0 -> then_target.args[position].value else -> else_target.args[position].value
        else -> -1
    }
}

// Removes block `row`'s dead parameters (the entry's stay) and dead
// instructions in place; returns whether it removed any.
fn opt_dead_block(function: &LIRFunction, live: [Bool], row: Int) -> Bool Never! {
    changed := false
    kept := 0
    loop index in 0..<function.blocks[row].params.len() {
        param :: function.blocks[row].params[index].copy()
        if row == 0 || live[param.value] {
            function.blocks[row].params[kept] = param
            kept += 1
        } else {
            changed = true
        }
    }
    loop function.blocks[row].params.len() > kept -> _ := &function.blocks[row].params.pop()
    lined :: function.blocks[row].lines.len() == function.blocks[row].insts.len() + 1
    at := 0
    loop at < function.blocks[row].insts.len() {
        keep := opt_inst_has_effect(function.blocks[row].insts[at])
        if !keep {
            if lir_inst_def(function.blocks[row].insts[at]) == .Val(dst) -> keep = live[dst.value]
        }
        if keep {
            at += 1
            next
        }
        changed = true
        _ := &function.blocks[row].insts.remove(at, .Slot)
        if lined -> _ := &function.blocks[row].lines.remove(at, .Slot)
    }
    // Unknown source positions stay zero (opt_debug_line).
    if !lined {
        function.blocks[row].lines = [Int]{}
        loop _ in 0..<(function.blocks[row].insts.len() + 1) -> &function.blocks[row].lines.push(0)
    }
    changed
}

// `target` without the arguments of its block's dead parameters; `function`
// still holds the parameter lists from before the removal.
fn opt_live_args(function: LIRFunction, rows: [Int:Int], live: [Bool], target: LIRJumpTarget) -> LIRJumpTarget Never! {
    // copy: the pruned target is a new owned jump target. With no row it equals `target`, the
    // caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    row :: rows.get(target.block.value) ?? return target.copy()
    // copy: the pruned target is a new owned jump target. For the entry row it equals `target`, the
    // caller's terminator edge (a read parameter), which stays in the block being rebuilt.
    if row == 0 -> return target.copy()
    args := [LIRValueID]{}
    loop (position, param) in function.blocks[row].params {
        if live[param.value] -> &args.push(target.args[position])
    }
    LIRJumpTarget{block: target.block, args: args}
}

// Renumber the defined values densely, in their old order, in place. With
// every value defined the numbering is already dense and the function comes
// back untouched (the renumbering would be the identity).
fn opt_compact(function: ^LIRFunction) -> LIRFunction Never! {
    owned := ^function
    defined := [Bool]{}
    loop _ in owned.values -> &defined.push(false)
    loop block in owned.blocks {
        loop param in block.params -> defined[param.value] = true
        loop inst in block.insts {
            if lir_inst_def(inst) == .Val(dst) -> defined[dst.value] = true
        }
    }
    map := [Int]{}
    count := 0
    loop flag in defined {
        if flag {
            &map.push(count)
            count += 1
        } else {
            &map.push(-1)
        }
    }
    if count == owned.values.len() -> return owned
    values := compiler_take_rows<LIRValue>(&owned.values)
    index := 0
    loop value in ^values {
        if map[index] >= 0 {
            kept := ^value
            kept.id = LIRValueID{value: map[index]}
            &owned.values.push(^kept)
        }
        index += 1
    }
    loop row in 0..<owned.blocks.len() {
        loop at in 0..<owned.blocks[row].params.len() -> owned.blocks[row].params[at] = opt_n(map, owned.blocks[row].params[at])
        loop at in 0..<owned.blocks[row].insts.len() {
            renumbered :: opt_renumber_inst(map, owned.blocks[row].insts[at])
            owned.blocks[row].insts[at] = ^renumbered
        }
        terminator :: opt_renumber_terminator(map, owned.blocks[row].terminator)
        owned.blocks[row].terminator = ^terminator
    }
    bindings := compiler_take_rows<LIRDebugBinding>(&owned.debug.bindings)
    loop binding in ^bindings {
        if map[binding.value.value] < 0 -> next
        kept := ^binding
        kept.value = opt_n(map, kept.value)
        &owned.debug.bindings.push(^kept)
    }
    owned
}

fn opt_n(map: [Int], value: LIRValueID) -> LIRValueID Never! { LIRValueID{value: map[value.value]} }

fn opt_ns(map: [Int], values: [LIRValueID]) -> [LIRValueID] Never! {
    out := [LIRValueID]{}
    loop value in values -> &out.push(opt_n(map, value))
    out
}

fn opt_renumber_inst(map: [Int], inst: LIRInst) -> LIRInst Never! {
    if inst == {
        .Const(dst, value) -> LIRInst.Const{dst: opt_n(map, dst), value: value}
        .Binary(dst, op, left, right) -> LIRInst.Binary{dst: opt_n(map, dst), op: op, left: opt_n(map, left), right: opt_n(map, right)}
        .Compare(dst, condition, left, right) -> LIRInst.Compare{dst: opt_n(map, dst), condition: condition, left: opt_n(map, left), right: opt_n(map, right)}
        .Move(dst, src) -> LIRInst.Move{dst: opt_n(map, dst), src: opt_n(map, src)}
        .Reown(dst, src) -> LIRInst.Reown{dst: opt_n(map, dst), src: opt_n(map, src)}
        .Copy(dst, src) -> LIRInst.Copy{dst: opt_n(map, dst), src: opt_n(map, src)}
        .Bitcast(dst, src) -> LIRInst.Bitcast{dst: opt_n(map, dst), src: opt_n(map, src)}
        .Call(dst, signature, callee, args) -> {
            result :: if dst == .Val(value) -> Val(opt_n(map, value)) else -> None
            renamed :: if callee == {
                .Value(target) -> LIRCallee.Value{value: opt_n(map, target)}
                else -> callee
            }
            LIRInst.Call{dst: result, signature: signature, callee: renamed, args: opt_ns(map, args)}
        }
        .InlineAsm(dst, args, regs, result, code) -> {
            output :: if dst == .Val(value) -> Val(opt_n(map, value)) else -> None
            LIRInst.InlineAsm{dst: output, args: opt_ns(map, args), regs: regs, result: result, code: code}
        }
        .Drop(value) -> LIRInst.Drop{value: opt_n(map, value)}
        .Overflows(dst, op, left, right) -> LIRInst.Overflows{dst: opt_n(map, dst), op: op, left: opt_n(map, left), right: opt_n(map, right)}
        .Load(dst, base, offset) -> LIRInst.Load{dst: opt_n(map, dst), base: opt_n(map, base), offset: offset}
        .PointerAdd(dst, base, offset) -> LIRInst.PointerAdd{dst: opt_n(map, dst), base: opt_n(map, base), offset: opt_n(map, offset)}
        .Store(base, offset, value) -> LIRInst.Store{base: opt_n(map, base), offset: offset, value: opt_n(map, value)}
        .DataAddress(dst, data) -> LIRInst.DataAddress{dst: opt_n(map, dst), data: data}
        .FunctionAddress(dst, target) -> LIRInst.FunctionAddress{dst: opt_n(map, dst), function: target}
        .Convert(dst, src) -> LIRInst.Convert{dst: opt_n(map, dst), src: opt_n(map, src)}
        .StackSlot(dst, size, align) -> LIRInst.StackSlot{dst: opt_n(map, dst), size: size, align: align}
        .ThreadWord(dst, offset) -> LIRInst.ThreadWord{dst: opt_n(map, dst), offset: offset}
    }
}

fn opt_renumber_target(map: [Int], target: LIRJumpTarget) -> LIRJumpTarget Never! {
    LIRJumpTarget{block: target.block, args: opt_ns(map, target.args)}
}

fn opt_renumber_terminator(map: [Int], terminator: LIRTerminator) -> LIRTerminator Never! {
    if terminator == {
        .Jump(target) -> LIRTerminator.Jump{target: opt_renumber_target(map, target)}
        .Branch(condition, then_target, else_target) -> LIRTerminator.Branch{condition: opt_n(map, condition), then_target: opt_renumber_target(map, then_target), else_target: opt_renumber_target(map, else_target)}
        .Return(value) -> {
            if value == .Val(returned) -> return LIRTerminator.Return{value: Val(opt_n(map, returned))}
            terminator
        }
        .Unreachable -> terminator
    }
}

OPT_SIMPLIFY_ROUNDS :: prep { 8 }

// Simplify one function to a fixed point (at most OPT_SIMPLIFY_ROUNDS rounds).
// The function moves through: every round edits it in place.
fn lir_simplify_function(function: ^LIRFunction) -> LIRFunction Never! {
    owned := ^function
    facts := opt_facts(owned.values.len())
    loop _ in 0..<OPT_SIMPLIFY_ROUNDS {
        changed := opt_fold_sweep(&owned, &facts)
        if opt_drop_unreachable(&owned) -> changed = true
        // Threading reads uses: name every use by its alias root first, so a
        // downstream read of an empty block's parameter is seen even through
        // an alias the sweep has not renamed yet.
        opt_rename_all(&owned, facts)
        if opt_thread(&owned) -> changed = true
        if opt_drop_unreachable(&owned) -> changed = true
        if opt_merge(&owned, &facts) -> changed = true
        if !changed -> break
    }
    // A sweep that removed a definition renamed only the uses after it, and
    // merging adds aliases: rename every use once more (renaming alone creates
    // no aliases and folds no branch) before liveness. One dead-code pass is
    // the fixed point: its live set is the closure over the kept effects,
    // definitions and edges, which the removal leaves whole.
    opt_rename_all(&owned, facts)
    _ := opt_dead_code(&owned)
    opt_compact(^owned)
}

// Names every use by its alias root, in place; an instruction or terminator
// with no aliased use stays untouched.
fn opt_rename_all(function: &LIRFunction, facts: OptFacts) Never! {
    loop row in 0..<function.blocks.len() {
        loop index in 0..<function.blocks[row].insts.len() -> _ := opt_rename_slot(facts, &function.blocks[row].insts, index)
        _ := opt_rename_terminator_slot(facts, &function.blocks[row])
    }
    loop index in 0..<function.debug.bindings.len() {
        root :: opt_root(facts, function.debug.bindings[index].value.value)
        function.debug.bindings[index].value = LIRValueID{value: root}
    }
}
