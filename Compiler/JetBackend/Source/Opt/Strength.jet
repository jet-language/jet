// P2: word-only strength reduction. Const definitions are the only facts used;
// no Float operation, trap, control-flow edge or ownership action is changed.
// Signed division uses the sign bias so the arithmetic shift truncates to zero.
use jet_foundation.[compiler_take_rows]

fn strength_power(value: Int) -> Int Never! {
    if value < 2 || value > 4611686018427387904 -> return 0
    if (value.bit_and((value - 1))) != 0 -> return 0
    shift := 0
    rest := value
    loop rest > 1 {
        rest = rest >> 1
        shift = shift + 1
    }
    shift
}

fn strength_word(values: [LIRValue], id: LIRValueID) -> Bool Never! {
    values[id.value].layout == lir_layout_word()
}

fn strength_value(values: &[LIRValue]) -> LIRValueID Never! {
    id :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: id, layout: lir_layout_word(), drop: LIRDrop.Trivial, jet_type: None})
    id
}

fn strength_const(values: &[LIRValue], insts: &[LIRInst], value: Int) -> LIRValueID Never! {
    id :: strength_value(&values)
    &insts.push(LIRInst.Const{dst: id, value: value})
    id
}

fn strength_binary(values: &[LIRValue], insts: &[LIRInst], op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> LIRValueID Never! {
    id :: strength_value(&values)
    &insts.push(LIRInst.Binary{dst: id, op: op, left: left, right: right})
    id
}

// The function moves through. A reduction needs a word Const that is a
// power of two: without one the body comes back as it was; with one the
// blocks move out and back, every instruction moved, and only a reduced
// instruction's block is rebuilt (its lines stay those of its instructions).
fn lir_strength_function(function: ^LIRFunction) -> LIRFunction Never! {
    owned := ^function
    powers := [Int]{}
    loop _ in owned.values -> &powers.push(0)
    any := false
    loop block in owned.blocks {
        loop inst in block.insts {
            if inst == .Const(dst, value) {
                if strength_word(owned.values, dst) {
                    power :: strength_power(value)
                    powers[dst.value] = power
                    if power > 0 -> any = true
                }
            }
        }
    }
    if !any -> return owned
    values := compiler_take_rows<LIRValue>(&owned.values)
    blocks := compiler_take_rows<LIRBlock>(&owned.blocks)
    loop block in ^blocks {
        if !strength_reduces(values, powers, block) {
            &owned.blocks.push(^block)
            next
        }
        kept := ^block
        original := compiler_take_rows<LIRInst>(&kept.insts)
        // Unknown source positions stay zero (opt_debug_line).
        lined :: kept.lines.len() == original.len() + 1
        lines := [Int]{}
        index := 0
        loop inst in ^original {
            at :: index
            index += 1
            if inst == .Binary(dst, op, left, right) {
                if strength_word(values, dst) && strength_word(values, left) && strength_word(values, right) {
                    k := powers[right.value]
                    x := left
                    if (op == .Mul || op == .UMul) && k == 0 {
                        k = powers[left.value]
                        x = right
                    }
                    if k > 0 {
                        if op == .Mul || op == .UMul || op == .UDiv || op == .URem {
                            operand :: strength_const(&values, &kept.insts, if op == .URem -> (1 << k) - 1 else -> k)
                            reduced :: if op == .UDiv -> LIRBinaryOp.UShr else if op == .URem -> LIRBinaryOp.And else -> LIRBinaryOp.Shl
                            &kept.insts.push(LIRInst.Binary{dst: dst, op: reduced, left: x, right: operand})
                            loop lines.len() < kept.insts.len() -> &lines.push(if lined -> kept.lines[at] else -> 0)
                            next
                        }
                        if op == .Div || op == .Rem {
                            sign_count :: strength_const(&values, &kept.insts, 63)
                            bias_count :: strength_const(&values, &kept.insts, 64 - k)
                            count :: strength_const(&values, &kept.insts, k)
                            sign :: strength_binary(&values, &kept.insts, LIRBinaryOp.Shr, x, sign_count)
                            bias :: strength_binary(&values, &kept.insts, LIRBinaryOp.UShr, sign, bias_count)
                            biased :: strength_binary(&values, &kept.insts, LIRBinaryOp.Add, x, bias)
                            if op == .Div {
                                &kept.insts.push(LIRInst.Binary{dst: dst, op: LIRBinaryOp.Shr, left: biased, right: count})
                            } else {
                                quotient :: strength_binary(&values, &kept.insts, LIRBinaryOp.Shr, biased, count)
                                multiple :: strength_binary(&values, &kept.insts, LIRBinaryOp.Shl, quotient, count)
                                &kept.insts.push(LIRInst.Binary{dst: dst, op: LIRBinaryOp.Sub, left: x, right: multiple})
                            }
                            loop lines.len() < kept.insts.len() -> &lines.push(if lined -> kept.lines[at] else -> 0)
                            next
                        }
                    }
                }
            }
            &kept.insts.push(^inst)
            &lines.push(if lined -> kept.lines[at] else -> 0)
        }
        &lines.push(if lined -> kept.lines[index] else -> 0)
        kept.lines = ^lines
        &owned.blocks.push(^kept)
    }
    owned.values = ^values
    owned
}

// Whether a block holds an instruction lir_strength_function reduces: a word
// Binary of a reduced operator whose divisor (either factor of a Mul) is a
// power of two.
fn strength_reduces(values: [LIRValue], powers: [Int], block: LIRBlock) -> Bool Never! {
    loop inst in block.insts {
        if inst == .Binary(dst, op, left, right) {
            if !(strength_word(values, dst) && strength_word(values, left) && strength_word(values, right)) -> next
            if op == .Mul || op == .UMul {
                if powers[right.value] > 0 || powers[left.value] > 0 -> return true
                next
            }
            if op == .UDiv || op == .URem || op == .Div || op == .Rem {
                if powers[right.value] > 0 -> return true
            }
        }
    }
    false
}
