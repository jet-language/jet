// P2: word-only strength reduction. Const definitions are the only facts used;
// no Float operation, trap, control-flow edge or ownership action is changed.
// Signed division uses the sign bias so the arithmetic shift truncates to zero.
fn strength_power(value: Int) -> Int Never! {
    if value < 2 || value > 4611686018427387904 -> return 0
    if (value.bit_and((value - 1))) != 0 -> return 0
    shift := 0
    rest := value
    loop rest > 1 {
        rest = rest >> 1
        shift = shift + 1
    }
    shift
}

fn strength_word(function: LIRFunction, id: LIRValueID) -> Bool Never! {
    function.values[id.value].layout == lir_layout_word()
}

fn strength_value(values: &[LIRValue]) -> LIRValueID Never! {
    id :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: id, layout: lir_layout_word(), drop: LIRDrop.Trivial, jet_type: None})
    id
}

fn strength_const(values: &[LIRValue], insts: &[LIRInst], value: Int) -> LIRValueID Never! {
    id :: strength_value(&values)
    &insts.push(LIRInst.Const{dst: id, value: value})
    id
}

fn strength_binary(values: &[LIRValue], insts: &[LIRInst], op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> LIRValueID Never! {
    id :: strength_value(&values)
    &insts.push(LIRInst.Binary{dst: id, op: op, left: left, right: right})
    id
}

fn lir_strength_function(function: LIRFunction) -> LIRFunction Never! {
    powers := [Int]{}
    loop _ in function.values -> &powers.push(0)
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .Const(dst, value) {
                if strength_word(function, dst) -> powers[dst.value] = strength_power(value)
            }
        }
    }
    values := function.values
    blocks := [LIRBlock]{}
    loop block in function.blocks {
        insts := [LIRInst]{}
        lines := [Int]{}
        loop (index, inst) in block.insts {
            if inst == .Binary(dst, op, left, right) {
                if strength_word(function, dst) && strength_word(function, left) && strength_word(function, right) {
                    k := powers[right.value]
                    x := left
                    if (op == .Mul || op == .UMul) && k == 0 {
                        k = powers[left.value]
                        x = right
                    }
                    if k > 0 {
                        if op == .Mul || op == .UMul || op == .UDiv || op == .URem {
                            operand :: strength_const(&values, &insts, if op == .URem -> (1 << k) - 1 else -> k)
                            reduced :: if op == .UDiv -> LIRBinaryOp.UShr else if op == .URem -> LIRBinaryOp.And else -> LIRBinaryOp.Shl
                            &insts.push(LIRInst.Binary{dst: dst, op: reduced, left: x, right: operand})
                            loop lines.len() < insts.len() -> &lines.push(opt_debug_line(block, index))
                            next
                        }
                        if op == .Div || op == .Rem {
                            sign_count :: strength_const(&values, &insts, 63)
                            bias_count :: strength_const(&values, &insts, 64 - k)
                            count :: strength_const(&values, &insts, k)
                            sign :: strength_binary(&values, &insts, LIRBinaryOp.Shr, x, sign_count)
                            bias :: strength_binary(&values, &insts, LIRBinaryOp.UShr, sign, bias_count)
                            biased :: strength_binary(&values, &insts, LIRBinaryOp.Add, x, bias)
                            if op == .Div {
                                &insts.push(LIRInst.Binary{dst: dst, op: LIRBinaryOp.Shr, left: biased, right: count})
                            } else {
                                quotient :: strength_binary(&values, &insts, LIRBinaryOp.Shr, biased, count)
                                multiple :: strength_binary(&values, &insts, LIRBinaryOp.Shl, quotient, count)
                                &insts.push(LIRInst.Binary{dst: dst, op: LIRBinaryOp.Sub, left: x, right: multiple})
                            }
                            loop lines.len() < insts.len() -> &lines.push(opt_debug_line(block, index))
                            next
                        }
                    }
                }
            }
            &insts.push(inst)
            &lines.push(opt_debug_line(block, index))
        }
        &lines.push(opt_debug_line(block, block.insts.len()))
        &blocks.push(LIRBlock{id: block.id, params: block.params, insts: insts, terminator: block.terminator, lines: lines, cold: block.cold})
    }
    LIRFunction{id: function.id, name: function.name, signature: function.signature, values: values, blocks: blocks, debug: function.debug}
}
