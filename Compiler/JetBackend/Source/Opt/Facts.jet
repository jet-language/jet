// P3: exact-Int eligibility facts, restricted to the false edge of lowering's
// inline test (`Overflows(Add, x, x)`: x is inline exactly when doubling it
// does not overflow; Lower.jet lower_inline_branch). A join, true edge, or
// second predecessor never invents a fact. CHK immediate dominators are
// shared with P6; unreachable blocks stay untouched.
struct OptDominators {
    order: [Int]
    parent: [Int]
    predecessors: [[Int]]
}

fn opt_dom_intersect(parent: [Int], rank: [Int], first: Int, second: Int) -> Int Never! {
    left := first
    right := second
    loop left != right {
        loop rank[left] > rank[right] -> left = parent[left]
        loop rank[right] > rank[left] -> right = parent[right]
    }
    left
}

fn opt_dominators(function: LIRFunction) -> OptDominators Never! {
    rows :: opt_block_rows(function)
    successors := [[Int]]{}
    predecessors := [[Int]]{}
    parent := [Int]{}
    rank := [Int]{}
    visited := [Bool]{}
    edge_cursor := [Int]{}
    loop _ in function.blocks {
        &successors.push([Int]{})
        &predecessors.push([Int]{})
        &parent.push(-1)
        &rank.push(-1)
        &visited.push(false)
        &edge_cursor.push(0)
    }
    loop (index, block) in function.blocks {
        loop target in lir_terminator_targets(block.terminator) {
            row :: rows.get(target.block.value) ?? -1
            if row >= 0 {
                &successors[index].push(row)
                &predecessors[row].push(index)
            }
        }
    }
    if function.blocks.len() == 0 -> return OptDominators{order: [Int]{}, parent: parent, predecessors: predecessors}
    // Explicit DFS frames, not a reachability queue: CHK requires reverse
    // postorder, including for backedges and irreducible control flow.
    stack := [Int]{0}
    depth := 1
    visited[0] = true
    postorder := [Int]{}
    loop depth > 0 {
        current :: stack[depth - 1].copy()
        if edge_cursor[current] < successors[current].len() {
            child :: successors[current][edge_cursor[current]].copy()
            edge_cursor[current] = edge_cursor[current] + 1
            if !visited[child] {
                visited[child] = true
                if depth < stack.len() -> stack[depth] = child else -> &stack.push(child)
                depth += 1
            }
        } else {
            &postorder.push(current)
            depth -= 1
        }
    }
    order := [Int]{}
    cursor := postorder.len()
    loop cursor > 0 {
        cursor -= 1
        block :: postorder[cursor].copy()
        rank[block] = order.len()
        &order.push(block)
    }
    parent[0] = 0
    changed := true
    loop changed {
        changed = false
        loop block in order {
            if block != 0 {
                new_parent := -1
                loop predecessor in predecessors[block] {
                    if parent[predecessor] >= 0 {
                        if new_parent < 0 -> new_parent = predecessor
                        else -> new_parent = opt_dom_intersect(parent, rank, new_parent, predecessor)
                    }
                }
                if parent[block] != new_parent {
                    parent[block] = new_parent
                    changed = true
                }
            }
        }
    }
    OptDominators{order: order, parent: parent, predecessors: predecessors}
}

// Dominator-tree preorder with explicit exit events (-row-1). Both passes
// maintain one table and undo only the entries introduced in the active scope.
fn opt_dom_events(dom: OptDominators) -> [Int] Never! {
    if dom.order.len() == 0 -> return [Int]{}
    children := [[Int]]{}
    next_child := [Int]{}
    loop _ in dom.parent {
        &children.push([Int]{})
        &next_child.push(0)
    }
    loop row in dom.order { if row != 0 -> &children[dom.parent[row]].push(row) }
    events := [Int]{0}
    stack := [Int]{0}
    depth := 1
    loop depth > 0 {
        row :: stack[depth - 1].copy()
        if next_child[row] < children[row].len() {
            child :: children[row][next_child[row]].copy()
            next_child[row] = next_child[row] + 1
            if depth < stack.len() -> stack[depth] = child else -> &stack.push(child)
            depth += 1
            &events.push(child)
        } else {
            &events.push(-row - 1)
            depth -= 1
        }
    }
    events
}

fn opt_inline_record(facts: &[Bool], undo: &[Int], count: &Int, value: Int) Never! {
    if facts[value] -> return
    facts[value] = true
    if count < undo.len() -> undo[count] = value else -> &undo.push(value)
    count += 1
}

// The value an inline test instruction tests; None for any other instruction.
fn opt_inline_test_value(function: LIRFunction, inst: LIRInst) -> Int? {
    if inst == .Overflows(_, op, left, right) {
        if op == .Add && left == right && opt_is_word(function, left) -> return Val(left.value)
    }
    None
}

// The function moves through: an inline test P3 proves becomes `Const 0`
// in place, and nothing else changes.
fn lir_inline_facts_function(function: ^LIRFunction) -> LIRFunction Never! {
    owned := ^function
    consts :: opt_const_defs(owned)
    dom :: opt_dominators(owned)
    tests := [Int?]{}
    facts := [Bool]{}
    loop (index, value) in owned.values {
        &tests.push(None)
        inline := false
        if value.layout == lir_layout_word() && consts.known[index] {
            constant :: consts.consts[index]
            inline = constant >= -4611686018427387904 && constant <= 4611686018427387903
        }
        &facts.push(inline)
    }
    loop block in owned.blocks {
        loop inst in block.insts {
            if lir_inst_def(inst) == .Val(dst) -> tests[dst.value] = opt_inline_test_value(owned, inst)
        }
    }
    undo := [Int]{}
    count := 0
    marks := [Int]{}
    loop _ in owned.blocks -> &marks.push(0)
    loop event in opt_dom_events(dom) {
        if event < 0 {
            row :: -event - 1
            loop count > marks[row] {
                count -= 1
                facts[undo[count]] = false
            }
            next
        }
        row :: event
        marks[row] = count
        // Count edges, not distinct predecessor blocks: Branch(t, t) must
        // not claim its condition failed on arrival. Entry has no incoming fact.
        if row != 0 && dom.predecessors[row].len() == 1 {
            predecessor :: dom.predecessors[row][0].copy()
            if owned.blocks[predecessor].terminator == .Branch(condition, then_target, else_target) {
                if else_target.block == owned.blocks[row].id {
                    if tests[condition.value] == .Val(value) -> opt_inline_record(&facts, &undo, &count, value)
                }
                // Preserve facts through single-edge block parameters.
                on_then :: then_target.block == owned.blocks[row].id
                loop (index, param) in owned.blocks[row].params {
                    arg :: if on_then -> then_target.args[index].value else -> else_target.args[index].value
                    if facts[arg] -> opt_inline_record(&facts, &undo, &count, param.value)
                }
            }
        }
        loop index in 0..<owned.blocks[row].insts.len() {
            dst :: lir_inst_def(owned.blocks[row].insts[index]) ?? next
            value :: tests[dst.value] ?? next
            if facts[value] -> owned.blocks[row].insts[index] = LIRInst.Const{dst: dst, value: 0}
        }
    }
    owned
}
