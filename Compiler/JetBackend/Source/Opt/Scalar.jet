// W9: nonescaping, disjoint StackSlot fields become SSA values. Cytron's
// iterated dominance frontier is pruned by field liveness; dead joins must not
// require an initial value. Each slot is transactional: an undefined load on
// any path refuses all fields, never just the offending field.
struct OptScalarField { offset: Int, sample: LIRValue }

fn opt_scalar_field(fields: [OptScalarField], offset: Int) -> Int Never! {
    loop (index, field) in fields { if field.offset == offset -> return index }
    -1
}

fn opt_scalar_fields(function: LIRFunction, slot: LIRValueID, size: Int, dom: OptDominators) -> [OptScalarField]? {
    fields := [OptScalarField]{}
    operands := [LIRValueID]{}
    loop (row, block) in function.blocks {
        lir_terminator_uses_into(block.terminator, &operands)
        loop operand in operands { if operand == slot -> return None }
        loop inst in block.insts {
            offset := -1
            value := LIRValueID{value: -1}
            if inst == {
                .Load(dst, base, at) -> {
                    if base == slot {
                        offset = at
                        value = dst
                    }
                }
                .Store(base, at, src) -> {
                    if src == slot -> return None
                    if base == slot {
                        offset = at
                        value = src
                    }
                }
                else -> {
                    lir_inst_uses_into(inst, &operands)
                    loop operand in operands { if operand == slot -> return None }
                }
            }
            if value.value >= 0 {
                if dom.parent[row] < 0 -> return None
                sample :: function.values[value.value]
                // A subword Store/Load is not an SSA copy: the memory roundtrip
                // truncates/extends bits. Preserve it, even for Bool fields.
                if sample.layout.size != 8 -> return None
                // Subtraction avoids overflow even for large byte offsets.
                if sample.drop != .Trivial || offset < 0 || sample.layout.size > size || offset > size - sample.layout.size -> return None
                index :: opt_scalar_field(fields, offset)
                if index >= 0 {
                    if fields[index].sample.layout != sample.layout -> return None
                } else {
                    loop field in fields {
                        if offset < field.offset + field.sample.layout.size && field.offset < offset + sample.layout.size -> return None
                    }
                    &fields.push(OptScalarField{offset: offset, sample: sample})
                }
            }
        }
    }
    Val(fields)
}

fn opt_scalar_frontiers(dom: OptDominators) -> [[Int]] Never! {
    frontiers := [[Int]]{}
    loop _ in dom.parent -> &frontiers.push([Int]{})
    loop join in dom.order {
        if dom.predecessors[join].len() >= 2 {
            loop predecessor in dom.predecessors[join] {
                runner := predecessor
                loop runner >= 0 && runner != dom.parent[join] {
                    found := false
                    loop previous in frontiers[runner] { if previous == join -> found = true }
                    if !found -> &frontiers[runner].push(join)
                    if runner == dom.parent[runner] -> break
                    runner = dom.parent[runner]
                }
            }
        }
    }
    frontiers
}

fn opt_scalar_value(function: &LIRFunction, sample: LIRValue) -> LIRValueID Never! {
    id :: LIRValueID{value: function.values.len()}
    &function.values.push(LIRValue{id: id, layout: sample.layout, drop: LIRDrop.Trivial, jet_type: sample.jet_type})
    id
}

fn opt_scalar_edge(target: LIRJumpTarget, rows: [Int:Int], phis: [[Int]], current: [Int]) -> LIRJumpTarget? {
    args := target.args
    row :: rows.get(target.block.value) ?? -1
    if row >= 0 {
        loop (field, phi) in phis[row] {
            if phi >= 0 {
                if current[field] < 0 -> return None
                &args.push(LIRValueID{value: current[field]})
            }
        }
    }
    Val(LIRJumpTarget{block: target.block, args: args})
}

fn opt_scalar_slot(original: LIRFunction, slot: LIRValueID, fields: [OptScalarField], dom: OptDominators, frontiers: [[Int]]) -> LIRFunction? {
    function := original
    rows :: opt_block_rows(function)
    phis := [[Int]]{}
    loop _ in function.blocks {
        row := [Int]{}
        loop _ in fields -> &row.push(-1)
        &phis.push(row)
    }
    loop (field_index, field) in fields {
        stores := [Bool]{}
        reads := [Bool]{}
        live := [Bool]{}
        initialized := [Bool]{}
        loop (row, block) in function.blocks {
            stored := false
            read := false
            loop inst in block.insts {
                if inst == .Load(_, base, offset) { if base == slot && offset == field.offset && !stored -> read = true }
                if inst == .Store(base, offset, _) { if base == slot && offset == field.offset -> stored = true }
            }
            &stores.push(stored)
            &reads.push(read)
            &live.push(read)
            &initialized.push(row != 0 && dom.parent[row] >= 0)
        }
        // Must-definition analysis starts at top and descends to its greatest
        // fixed point. Entry is undefined; backedges cannot invent an initial store.
        changed := true
        loop changed {
            changed = false
            loop row in dom.order {
                incoming := row != 0
                loop predecessor in dom.predecessors[row] {
                    if dom.parent[predecessor] >= 0 -> incoming = incoming && initialized[predecessor]
                }
                outgoing :: incoming || stores[row]
                if initialized[row] != outgoing {
                    initialized[row] = outgoing
                    changed = true
                }
            }
        }
        loop row in dom.order {
            incoming := row != 0
            loop predecessor in dom.predecessors[row] {
                if dom.parent[predecessor] >= 0 -> incoming = incoming && initialized[predecessor]
            }
            if reads[row] && !incoming -> return None
        }
        changed = true
        loop changed {
            changed = false
            loop row in dom.order {
                needed := reads[row]
                if !stores[row] {
                    loop target in lir_terminator_targets(function.blocks[row].terminator) {
                        successor :: rows.get(target.block.value) ?? -1
                        if successor >= 0 && live[successor] -> needed = true
                    }
                }
                if live[row] != needed {
                    live[row] = needed
                    changed = true
                }
            }
        }
        pending := [Int]{}
        loop row in dom.order { if stores[row] -> &pending.push(row) }
        cursor := 0
        loop cursor < pending.len() {
            definition :: pending[cursor].copy()
            cursor += 1
            loop join in frontiers[definition] {
                if live[join] && phis[join][field_index] < 0 {
                    param :: opt_scalar_value(&function, field.sample)
                    phis[join][field_index] = param.value
                    &pending.push(join)
                }
            }
        }
    }
    // Keep parameter and edge ordering field-major, independent of the IDF's
    // discovery order. Existing block parameters and edge args are preserved.
    loop (row, _) in function.blocks {
        // Unreachable predecessors are absent from the rename walk; never
        // add parameters unless every incoming edge will be rewritten.
        loop phi in phis[row] {
            if phi >= 0 {
                loop predecessor in dom.predecessors[row] { if dom.parent[predecessor] < 0 -> return None }
            }
        }
        loop phi in phis[row] { if phi >= 0 -> &function.blocks[row].params.push(LIRValueID{value: phi}) }
    }
    aliases := opt_facts(function.values.len())
    consumed := [Bool]{}
    loop _ in function.values -> &consumed.push(false)
    loop block in function.blocks { loop inst in block.insts { loop value in lir_inst_consumes(inst) -> consumed[value.value] = true } }
    current := [Int]{}
    loop _ in fields -> &current.push(-1)
    saved := [[Int]]{}
    loop _ in function.blocks -> &saved.push([Int]{})
    loop event in opt_dom_events(dom) {
        if event < 0 {
            current = saved[-event - 1]
            next
        }
        row :: event
        saved[row] = current
        loop (field, phi) in phis[row] { if phi >= 0 -> current[field] = phi }
        insts := [LIRInst]{}
        lines := [Int]{}
        loop (index, inst) in function.blocks[row].insts {
            removed := false
            if inst == {
                .StackSlot(dst, _, _) -> { if dst == slot -> removed = true }
                .Store(base, offset, value) -> {
                    if base == slot {
                        field :: opt_scalar_field(fields, offset)
                        root :: opt_id(aliases, value)
                        // Memory held a snapshot even if its source was later
                        // moved/dropped. Retain that separate trivial lifetime.
                        if consumed[value.value] {
                            // copy: opt_scalar_value writes `&function` (values are appended) while
                            // it reads the sampled value, so a view into function.values would be
                            // live across that write.
                            sample :: function.values[value.value].copy()
                            snapshot :: opt_scalar_value(&function, sample)
                            &aliases.alias.push(-1)
                            &aliases.known.push(false)
                            &aliases.consts.push(0)
                            &insts.push(LIRInst.Copy{dst: snapshot, src: root})
                            current[field] = snapshot.value
                        } else {
                            current[field] = root.value
                        }
                        removed = true
                    }
                }
                .Load(dst, base, offset) -> {
                    if base == slot {
                        field :: opt_scalar_field(fields, offset)
                        if current[field] < 0 -> return None
                        value :: LIRValueID{value: current[field]}
                        if consumed[dst.value] -> &insts.push(LIRInst.Copy{dst: dst, src: value})
                        else -> aliases.alias[dst.value] = value.value
                        removed = true
                    }
                }
                else -> {}
            }
            if !removed -> &insts.push(inst)
            loop lines.len() < insts.len() -> &lines.push(opt_debug_line(function.blocks[row], index))
        }
        &lines.push(opt_debug_line(function.blocks[row], function.blocks[row].insts.len()))
        function.blocks[row].lines = lines
        function.blocks[row].insts = insts
        // copy: the block's terminator is read, then rewritten in the same slot. Jet cannot move an
        // element out of function.blocks (E0225) and has no writable enum-payload binding.
        terminator := function.blocks[row].terminator.copy()
        function.blocks[row].terminator = if terminator == {
            .Jump(target) -> {
                rewritten :: opt_scalar_edge(target, rows, phis, current) ?? return None
                LIRTerminator.Jump{target: rewritten}
            }
            .Branch(condition, yes, no) -> {
                then_target :: opt_scalar_edge(yes, rows, phis, current) ?? return None
                else_target :: opt_scalar_edge(no, rows, phis, current) ?? return None
                LIRTerminator.Branch{condition: condition, then_target: then_target, else_target: else_target}
            }
            else -> terminator
        }
    }
    opt_rename_all(&function, aliases)
    Val(function)
}

// The function moves through; without a slot to replace, or with none
// replaced, the body comes back as it was.
fn lir_scalar_replace_function(function: ^LIRFunction) -> LIRFunction Never! {
    owned := ^function
    slots := [LIRInst]{}
    loop block in owned.blocks { loop inst in block.insts { if inst == .StackSlot(_, _, _) -> &slots.push(inst) } }
    if slots.len() == 0 -> return owned
    dom :: opt_dominators(owned)
    frontiers :: opt_scalar_frontiers(dom)
    changed := false
    loop inst in slots {
        if inst == .StackSlot(slot, size, _) {
            if opt_scalar_fields(owned, slot, size, dom) == .Val(fields) {
                if opt_scalar_slot(owned, slot, fields, dom, frontiers) == .Val(replaced) {
                    owned = replaced
                    changed = true
                }
            }
        }
    }
    if changed -> opt_compact(^owned) else -> owned
}
