// Private native CSVRow16 align8, not Rust layout or Core field-order alias.
// CommonTypes.rs:423-427: fields followed by line; fields owns List24 of E4.
CSV_ROW_BYTES :: comptime { I64{16} }
CSV_ROW_FIELDS :: comptime { I64{0} }
CSV_ROW_LINE :: comptime { I64{8} }
CSV_FIELD_STRIDE :: comptime { I64{8} }
