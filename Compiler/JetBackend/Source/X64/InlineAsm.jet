// Strict Intel-template assembler for audited #FFI(asm) leaves. Never guess an
// encoding: an unsupported form produces no executable bytes. Register binding
// is fixed and the write mask rejects placeholders read after their input died.
X64AsmResult: struct {
    code: [U8]
    regs: [Int]
    result: Int
    error: String?
}

X64AsmState: struct {
    code: [U8]
    names: [String]
    written: [Bool]
    depth: Int
    result: Int
    // The template stack depth of the word `push rbx` saved, -1 for none.
    // rbx is callee-saved and outside the operand vocabulary; a template
    // saves it only so `cpuid` may write ebx.
    rbx_saved: Int
    // `cpuid` wrote rbx and `pop rbx` has not restored the saved word yet.
    rbx_dirty: Bool
}

// The template's operand registers, in binding order: rdi, rsi, rdx, rcx,
// r8, r9, r10.
X64_ASM_INPUTS: [Int]{7, 6, 2, 1, 8, 9, 10}

// The caller-saved registers a template `call` clobbers.
x64_asm_call_clobbers: fn(reg: Int) -> Bool Never! {
    reg == 0 || reg == 1 || reg == 2 || reg == 6 || reg == 7 || (reg >= 8 && reg <= 11)
}

X64AsmMemory: struct {
    base: Int
    disp: Int
}

x64_asm_register: fn(text: String) -> Int Never! {
    if text == {
        "rax" -> 0
        "rcx" -> 1
        "rdx" -> 2
        "rsi" -> 6
        "rdi" -> 7
        "r8" -> 8
        "r9" -> 9
        "r10" -> 10
        "r11" -> 11
        else -> -1
    }
}

x64_asm_byte_register: fn(text: String) -> Int Never! {
    if text == {
        "al" -> 0
        "cl" -> 1
        "dl" -> 2
        "sil" -> 6
        "dil" -> 7
        "r8b" -> 8
        "r9b" -> 9
        "r10b" -> 10
        "r11b" -> 11
        else -> -1
    }
}

x64_asm_reg: fn(s: X64AsmState, text: String, read: Bool) -> Int Never! {
    operand: text.trim()
    if operand.starts_with("{{") && operand.ends_with("}}") {
        tail: operand.after("{{")
        loop (i, input) in s.names {
            if !tail.starts_with(input) -> next
            suffix: tail.after(input)
            if suffix != "}}" -> next
            reg: X64_ASM_INPUTS[i]
            if read && s.written[reg] -> return -1
            return reg
        }
        return -1
    }
    x64_asm_register(operand)
}

x64_asm_memory: fn(s: X64AsmState, text: String, size: String) -> X64AsmMemory? Never! {
    prefix: "{size} ptr ["
    if !text.starts_with(prefix) || !text.ends_with("]") -> return None
    inner: text.slice(prefix.len(), text.len() - 1).trim()
    parts: inner.split("+").to_list()
    if parts.len() > 2 -> return None
    base: x64_asm_reg(s, parts[0], true)
    if base < 0 -> return None
    disp := 0
    if parts.len() == 2 -> disp = Int.parse(parts[1].trim()) ?? return None
    if !x64_fits_i32(disp) -> return None
    Val(X64AsmMemory{base: base, disp: disp})
}

// An xmm register name: a clobber declaration or an SSE/SHA operand, never an
// integer operand. System V may clobber every XMM register.
x64_asm_xmm_clobber: fn(text: String) -> Bool Never! {
    if text == {
        "xmm0" | "xmm1" | "xmm2" | "xmm3" | "xmm4" | "xmm5" | "xmm6" | "xmm7" | "xmm8" | "xmm9" | "xmm10" | "xmm11" | "xmm12" | "xmm13" | "xmm14" | "xmm15" -> true
        else -> false
    }
}

// The number of xmm register `text`, else -1.
x64_asm_xmm: fn(text: String) -> Int Never! {
    if !x64_asm_xmm_clobber(text) -> return -1
    Int.parse(text.slice(3, text.len())) ?? -1
}

// A register-register SSE or SHA instruction: its mandatory prefix (0 for
// none), opcode map (0 for 0F, else the 0F 38 or 0F 3A escape), opcode, and
// whether an imm8 follows the operands.
X64AsmSse: struct {
    prefix: Int
    escape: Int
    opcode: Int
    immediate: Bool
}

x64_asm_sse: fn(mnemonic: String) -> X64AsmSse? Never! {
    if mnemonic == {
        "movaps" -> Val(X64AsmSse{prefix: 0, escape: 0, opcode: 0x28, immediate: false})
        "paddd" -> Val(X64AsmSse{prefix: 0x66, escape: 0, opcode: 0xfe, immediate: false})
        "pshufd" -> Val(X64AsmSse{prefix: 0x66, escape: 0, opcode: 0x70, immediate: true})
        "pshufb" -> Val(X64AsmSse{prefix: 0x66, escape: 0x38, opcode: 0x00, immediate: false})
        "palignr" -> Val(X64AsmSse{prefix: 0x66, escape: 0x3a, opcode: 0x0f, immediate: true})
        "pblendw" -> Val(X64AsmSse{prefix: 0x66, escape: 0x3a, opcode: 0x0e, immediate: true})
        "sha256rnds2" -> Val(X64AsmSse{prefix: 0, escape: 0x38, opcode: 0xcb, immediate: false})
        "sha256msg1" -> Val(X64AsmSse{prefix: 0, escape: 0x38, opcode: 0xcc, immediate: false})
        "sha256msg2" -> Val(X64AsmSse{prefix: 0, escape: 0x38, opcode: 0xcd, immediate: false})
        else -> None
    }
}

x64_asm_line: fn(s: &X64AsmState, line: String) -> String? Never! {
    parts: line.split(";").to_list()
    instruction: parts[0].trim()
    if instruction == "" {
        if parts.len() > 1 {
            comment: parts[1].trim()
            if comment.starts_with("clobbers ") {
                loop token in comment.slice(9, comment.len()).replace(",", " ").split(" ") {
                    if token != "" && x64_asm_register(token) < 0 && !x64_asm_xmm_clobber(token) {
                        return Val("unsupported clobber register")
                    }
                }
            } else if comment.starts_with("->") -> return Val("return anchor has no instruction")
        }
        return None
    }
    // Normalize horizontal whitespace, leaving the operand grammar strict.
    tokens := [String]{}
    loop token in instruction.replace("\t", " ").split(" ") {
        if token != "" -> tokens.push(token)
    }
    mnemonic := tokens[0]
    rest := tokens.slice(1, tokens.len()).join(" ")
    if mnemonic == "lock" {
        if rest.starts_with("cmpxchg ") {
            mnemonic = "cmpxchg"
            rest = rest.slice(8, rest.len())
        } else if rest.starts_with("xadd ") {
            mnemonic = "xadd"
            rest = rest.slice(5, rest.len())
        } else {
            return Val("unsupported lock instruction")
        }
    } else if mnemonic == "cmpxchg" || mnemonic == "xadd" -> return Val("atomic instruction requires lock")
    operands: rest.split(",").to_list()
    first: operands[0].trim()
    second: if operands.len() == 2 -> operands[1].trim() else -> ""
    written := -1
    if (mnemonic == "push" || mnemonic == "pop") && first == "rbx" {
        // The one saved rbx word: `push rbx` before `cpuid`, `pop rbx`
        // restores that same word, and nothing else writes rbx.
        if operands.len() != 1 -> return Val("expected one register operand")
        if mnemonic == "push" {
            if s.rbx_saved >= 0 || s.rbx_dirty -> return Val("rbx is already saved")
            x64_push(s.code, X64_RBX)
            s.rbx_saved = s.depth
            s.depth += 1
        } else {
            if s.depth == 0 || s.depth - 1 != s.rbx_saved -> return Val("pop rbx restores only the word push rbx saved")
            x64_pop(s.code, X64_RBX)
            s.depth -= 1
            s.rbx_saved = -1
            s.rbx_dirty = false
        }
    } else if mnemonic == "push" || mnemonic == "pop" || mnemonic == "call" {
        if operands.len() != 1 -> return Val("expected one register operand")
        reg: x64_asm_reg(s, first, mnemonic != "pop")
        if reg < 0 {
            return Val("unsupported register or operand read after its bound register was written")
        }
        if mnemonic == "push" {
            x64_push(s.code, reg)
            s.depth += 1
        } else if mnemonic == "pop" {
            if s.depth == 0 -> return Val("pop reads outside the template stack")
            x64_pop(s.code, reg)
            s.depth -= 1
            if s.depth == s.rbx_saved {
                if s.rbx_dirty -> return Val("cpuid's rbx must be restored by pop rbx")
                s.rbx_saved = -1
            }
            written = reg
        } else {
            if s.depth % 2 != 0 -> return Val("call requires a 16-byte aligned stack")
            x64_call_reg(s.code, reg)
            loop r in 0..<16 {
                if x64_asm_call_clobbers(r) -> s.written[r] = true
            }
        }
    } else if mnemonic == "syscall" || mnemonic == "pause" {
        if rest != "" -> return Val("instruction takes no operands")
        x64_byte(s.code, if mnemonic == "syscall" -> 0x0f else -> 0xf3)
        x64_byte(s.code, if mnemonic == "syscall" -> 0x05 else -> 0x90)
        if mnemonic == "syscall" {
            s.written[0] = true
            s.written[1] = true
            s.written[11] = true
        }
    } else if mnemonic == "cpuid" {
        // eax selects the leaf and ecx the subleaf; eax, ebx, ecx and edx
        // receive it. ebx is callee-saved, so a saved rbx must exist.
        if rest != "" -> return Val("instruction takes no operands")
        if s.rbx_saved < 0 -> return Val("cpuid writes rbx; save it first with push rbx")
        x64_byte(s.code, 0x0f)
        x64_byte(s.code, 0xa2)
        s.written[0] = true
        s.written[1] = true
        s.written[2] = true
        s.rbx_dirty = true
    } else if mnemonic == "xgetbv" {
        // ecx selects the extended control register; edx:eax receive it.
        if rest != "" -> return Val("instruction takes no operands")
        x64_byte(s.code, 0x0f)
        x64_byte(s.code, 0x01)
        x64_byte(s.code, 0xd0)
        s.written[0] = true
        s.written[2] = true
    } else if mnemonic == "cld" || mnemonic == "std" {
        // The direction flag of a string move; System V requires it clear at
        // every call and return, so a template that sets it clears it again.
        if rest != "" -> return Val("instruction takes no operands")
        x64_byte(s.code, if mnemonic == "cld" -> 0xfc else -> 0xfd)
    } else if mnemonic == "rep" {
        // String moves and the word store: rcx counts and rdi writes, both
        // advance; a move also reads and advances rsi, a store repeats rax.
        // The template's #Unsafe contract owns every range.
        if rest != "movsb" && rest != "movsq" && rest != "stosq" -> return Val("unsupported rep instruction")
        x64_byte(s.code, 0xf3)
        if rest != "movsb" -> x64_byte(s.code, 0x48)
        x64_byte(s.code, if rest == "movsb" -> 0xa4 else if rest == "movsq" -> 0xa5 else -> 0xab)
        s.written[1] = true
        if rest != "stosq" -> s.written[6] = true
        s.written[7] = true
    } else if mnemonic == "mov" || mnemonic == "movzx" {
        if operands.len() != 2 -> return Val("expected two operands")
        dst: x64_asm_reg(s, first, false)
        src: if second == "rbx" -> X64_RBX else -> x64_asm_reg(s, second, true)
        // rsp is read-only here: template-owned pushed words can be passed
        // to syscalls. No other explicit frame-register use is admitted.
        if mnemonic == "mov" && dst >= 0 && second == "rsp" {
            if s.depth == 0 -> return Val("rsp address requires template-owned pushed storage")
            x64_mov_rr(s.code, dst, X64_RSP)
            s.written[dst] = true
            loop comment in parts.slice(1, parts.len()) {
                if comment.trim().starts_with("->") {
                    return Val("rsp address cannot be a return anchor")
                }
            }
            return None
        }
        if dst >= 0 {
            if mnemonic == "mov" && first == "rax" && second == "qword ptr gs:[0]" {
                // The sole admitted segment operand: TCB self pointer at GS:0.
                gs_bytes: [U8]{0x65, 0x48, 0x8b, 0x04, 0x25, 0, 0, 0, 0}
                loop byte in gs_bytes -> s.code.push(byte)
            } else if mnemonic == "mov" && src >= 0 -> x64_mov_rr(s.code, dst, src) else if x64_asm_memory(s, second, if mnemonic == "mov" -> "qword" else -> "byte") == .Val(mem) {
                if mnemonic == "mov" -> x64_load(s.code, dst, mem.base, mem.disp) else {
                    x64_load_u8(s.code, dst, mem.base, mem.disp)
                }
            } else if mnemonic == "mov" {
                imm: Int.parse(second) ?? return Val("unsupported source or operand read after its bound register was written")
                if imm < -9223372036854775808 || imm > 9223372036854775807 {
                    return Val("immediate is outside a machine word")
                }
                x64_mov_ri(s.code, dst, imm)
            } else {
                return Val("unsupported source or operand read after its bound register was written")
            }
            written = dst
        } else if mnemonic == "mov" && src >= 0 && x64_asm_memory(s, first, "qword") == .Val(mem) {
            x64_store(s.code, mem.base, mem.disp, src)
        } else if mnemonic == "mov" && x64_asm_byte_register(second) >= 0 && x64_asm_memory(s, first, "byte") == .Val(mem) {
            byte_reg: x64_asm_byte_register(second)
            x64_store_u8(s.code, mem.base, mem.disp, byte_reg)
        } else { return Val("unsupported mov operands or stale placeholder") }
    } else if mnemonic == "add" || mnemonic == "sub" || mnemonic == "and" || mnemonic == "or" || mnemonic == "xor" {
        if operands.len() != 2 -> return Val("expected two register operands")
        dst: x64_asm_reg(s, first, true)
        src: x64_asm_reg(s, second, true)
        if dst < 0 || src < 0 -> return Val("unsupported register or stale placeholder")
        alu: if mnemonic == {
            "add" -> X64Alu.Add
            "sub" -> X64Alu.Sub
            "and" -> X64Alu.And
            "or" -> X64Alu.Or
            else -> X64Alu.Xor
        }
        x64_alu_rr(s.code, alu, dst, src)
        written = dst
    } else if mnemonic == "cmpxchg" || mnemonic == "xchg" || mnemonic == "xadd" {
        if operands.len() != 2 -> return Val("expected memory and register operands")
        mem: x64_asm_memory(s, first, "qword") ?? return Val("unsupported atomic address or stale placeholder")
        reg: x64_asm_reg(s, second, true)
        if reg < 0 || (mnemonic == "cmpxchg" && mem.disp != 0) {
            return Val("unsupported atomic operand")
        }
        if mnemonic != "xchg" -> x64_byte(s.code, 0xf0)
        x64_rex(s.code, true, reg, mem.base)
        if mnemonic == "cmpxchg" {
            x64_byte(s.code, 0x0f)
            x64_byte(s.code, 0xb1)
        } else if mnemonic == "xadd" {
            x64_byte(s.code, 0x0f)
            x64_byte(s.code, 0xc1)
        } else {
            x64_byte(s.code, 0x87)
        }
        x64_modrm_mem(s.code, reg, mem.base, mem.disp)
        written = if mnemonic == "cmpxchg" -> X64_RAX else -> reg
    } else if mnemonic == "movups" {
        // Sixteen unaligned bytes between an xmm register and memory.
        if operands.len() != 2 -> return Val("expected two operands")
        dst: x64_asm_xmm(first)
        if dst >= 0 {
            mem: x64_asm_memory(s, second, "xmmword") ?? return Val("unsupported vector address or stale placeholder")
            x64_vector_load(s.code, dst, mem.base, mem.disp)
        } else {
            mem: x64_asm_memory(s, first, "xmmword") ?? return Val("unsupported vector address or stale placeholder")
            src: x64_asm_xmm(second)
            if src < 0 -> return Val("expected an xmm register source")
            x64_vector_store(s.code, mem.base, mem.disp, src)
        }
    } else if x64_asm_sse(mnemonic) == .Val(form) {
        // xmm register operands only; sha256rnds2 also reads xmm0.
        expected: if form.immediate -> 3 else -> 2
        if operands.len() != expected -> return Val("expected {expected} operands")
        dst: x64_asm_xmm(first)
        src: x64_asm_xmm(operands[1].trim())
        if dst < 0 || src < 0 -> return Val("expected xmm register operands")
        if form.escape == 0 -> x64_sse(s.code, form.prefix, false, form.opcode, dst, src) else {
            x64_sse_escaped(s.code, form.prefix, form.escape, form.opcode, dst, src)
        }
        if form.immediate {
            imm: Int.parse(operands[2].trim()) ?? return Val("expected a byte immediate")
            if imm < 0 || imm > 255 -> return Val("expected a byte immediate")
            x64_byte(s.code, imm)
        }
    } else { return Val("unsupported mnemonic `{mnemonic}`") }
    if written >= 0 -> s.written[written] = true
    loop comment in parts.slice(1, parts.len()) {
        if comment.trim() == "-> return" {
            if s.result >= 0 -> return Val("multiple return anchors")
            s.result = x64_asm_reg(s, first, false)
            if s.result < 0 || written != s.result {
                return Val("return anchor must name the written destination register")
            }
        } else if comment.trim().starts_with("->") -> return Val("unsupported return annotation")
    }
    None
}

x64_assemble_template: fn(template: String, names: [String], returns: Bool) -> X64AsmResult Never! {
    regs := [Int]{}
    if names.len() > X64_ASM_INPUTS.len() {
        return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: more than seven operands")}
    }
    loop (i, _) in names -> regs.push(X64_ASM_INPUTS[i])
    s := X64AsmState{code: [U8]{}, names: names, written: [Bool]{}, depth: 0, result: -1, rbx_saved: -1, rbx_dirty: false}
    loop _ in 0..<16 -> s.written.push(false)
    lines: template.split("\n").to_list()
    i := 0
    loop i < lines.len() {
        raw: lines[i]
        if raw.trim() == "test rax, rax" {
            // Clone's child stack is not the parent's template stack. Admit
            // only this closed, non-returning child rail, never arbitrary
            // labels/branches or frame mutations. jnz skips all 17 child bytes.
            child: [String]{"test rax, rax", "jnz 2f", "pop rax", "pop rdi", "and rsp, -16", "call rax", "xor edi, edi", "mov eax, 60", "syscall", "2:"}
            if i < 3 || lines[i - 3].trim() != "mov r8, 0" || lines[i - 2].trim() != "mov rax, 56" || lines[i - 1].trim() != "syscall" || s.depth != 6 || i + child.len() > lines.len() {
                return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: clone child rail requires the audited clone prologue")}
            }
            loop (j, expected) in child {
                if lines[i + j].trim() != expected {
                    return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: unsupported clone child rail")}
                }
            }
            child_bytes: [U8]{0x48, 0x85, 0xc0, 0x75, 0x11, 0x58, 0x5f, 0x48, 0x83, 0xe4, 0xf0, 0xff, 0xd0, 0x31, 0xff, 0xb8, 0x3c, 0, 0, 0, 0x0f, 0x05}
            loop byte in child_bytes -> s.code.push(byte)
            i += child.len()
            next
        }
        if x64_asm_line(s, raw.trim()) == .Val(reason) {
            return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: {reason} (line {i + 1}: {raw.trim()})")}
        }
        i += 1
    }
    if s.depth != 0 {
        return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: unbalanced push/pop")}
    }
    if returns != (s.result >= 0) {
        return X64AsmResult{code: [U8]{}, regs: regs, result: -1, error: Val("inline asm: return anchor disagrees with the function signature")}
    }
    X64AsmResult{code: s.code, regs: regs, result: s.result, error: None}
}
