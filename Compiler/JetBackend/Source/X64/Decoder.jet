E3 23 66 W0 | vshuff32x4 Vx,Hx,Wx,Ib
E3 23 66 W1 | vshuff64x2 Vx,Hx,Wx,Ib
E3 25 66 W0 | vpternlogd Vx,Hx,Wx,Ib
E3 25 66 W1 | vpternlogq Vx,Hx,Wx,Ib
V3 30 66 l0 W0 r | kshiftrb Kr,Km,Ib
V3 30 66 l0 W1 r | kshiftrw Kr,Km,Ib
V3 31 66 l0 W0 r | kshiftrd Kr,Km,Ib
V3 31 66 l0 W1 r | kshiftrq Kr,Km,Ib
V3 32 66 l0 W0 r | kshiftlb Kr,Km,Ib
V3 32 66 l0 W1 r | kshiftlw Kr,Km,Ib
V3 33 66 l0 W0 r | kshiftld Kr,Km,Ib
V3 33 66 l0 W1 r | kshiftlq Kr,Km,Ib
V3 38 66 | vinserti128 Vx,Hx,Wo,Ib
V3 39 66 | vextracti128 Wo,Vx,Ib
E3 38 66 W0 | vinserti32x4 Vx,Hx,Wo,Ib
E3 38 66 W1 | vinserti64x2 Vx,Hx,Wo,Ib
E3 39 66 W0 | vextracti32x4 Wo,Vx,Ib
E3 39 66 W1 | vextracti64x2 Wo,Vx,Ib
E3 3a 66 W0 | vinserti32x8 Vx,Hx,Wy,Ib
E3 3a 66 W1 | vinserti64x4 Vx,Hx,Wy,Ib
E3 3b 66 W0 | vextracti32x8 Wy,Vx,Ib
E3 3b 66 W1 | vextracti64x4 Wy,Vx,Ib
E3 3e 66 W0 | vpcmpub Kr,Hx,Wx,Ib
E3 3e 66 W1 | vpcmpuw Kr,Hx,Wx,Ib
E3 3f 66 W0 | vpcmpb Kr,Hx,Wx,Ib
E3 3f 66 W1 | vpcmpw Kr,Hx,Wx,Ib
V3 40 66 | vdpps Vx,Hx,Wx,Ib
V3 41 66 | vdppd Vo,Ho,Wo,Ib
V3 42 66 | vmpsadbw Vx,Hx,Wx,Ib
E3 43 66 W0 | vshufi32x4 Vx,Hx,Wx,Ib
E3 43 66 W1 | vshufi64x2 Vx,Hx,Wx,Ib
VE3 44 66 | vpclmulqdq Vx,Hx,Wx,Ib
V3 46 66 | vperm2i128 Vx,Hx,Wx,Ib
V3 4a 66 W0 | vblendvps Vx,Hx,Wx,Lx
V3 4b 66 W0 | vblendvpd Vx,Hx,Wx,Lx
V3 4c 66 W0 | vpblendvb Vx,Hx,Wx,Lx
V3 60 66 | vpcmpestrm Vo,Wo,Ib
V3 61 66 | vpcmpestri Vo,Wo,Ib
V3 62 66 | vpcmpistrm Vo,Wo,Ib
V3 63 66 | vpcmpistri Vo,Wo,Ib
VE3 df 66 | vaeskeygenassist Vo,Wo,Ib
V3 f0 F2 l0 | rorx Gy,Ey,Ib
``` }

// X64_DECODE_TABLE's rows, ordered by space and opcode (each opcode's in
// table order).
X64_DECODE_ROWS: #run x64_decode_rows(X64_DECODE_TABLE)

// Where each space-and-opcode key's rows start in X64_DECODE_ROWS, one more
// entry than X64_DECODE_KEYS so a key's rows end where the next key's start.
X64_DECODE_INDEX: #run x64_decode_index(X64_DECODE_ROWS)

// Whether each key's instruction takes a ModRM byte: any of its rows tests
// one or names an operand it holds.
X64_DECODE_MODRM: #run x64_decode_modrm_keys(X64_DECODE_ROWS)

// The register names by width (X64_REGISTER_NAMES is the 64-bit one).
X64_DECODE_GPR32: [String]{"eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"}

X64_DECODE_GPR16: [String]{"ax", "cx", "dx", "bx", "sp", "bp", "si", "di", "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w"}

X64_DECODE_GPR8: [String]{"al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"}

// The byte registers 4-7 name without a REX prefix.
X64_DECODE_GPR8_HIGH: [String]{"ah", "ch", "dh", "bh"}

X64_DECODE_SEGMENTS: [String]{"es", "cs", "ss", "ds", "fs", "gs"}

// The predicates cmpps and its kin spell into their names: the legacy forms
// the first 8, VEX and EVEX all 32.
X64_DECODE_CMP_PREDICATES: [String]{"eq", "lt", "le", "unord", "neq", "nlt", "nle", "ord", "eq_uq", "nge", "ngt", "false", "neq_oq", "ge", "gt", "true", "eq_os", "lt_oq", "le_oq", "unord_s", "neq_us", "nlt_uq", "nle_uq", "ord_s", "eq_us", "nge_uq", "ngt_uq", "false_os", "neq_os", "ge_oq", "gt_oq", "true_us"}

// The predicates vpcmp spells into its name; 3 and 7 keep their immediate.
X64_DECODE_VPCMP_PREDICATES: [String]{"eq", "lt", "le", "", "neq", "nlt", "nle", ""}

// The EVEX rounding a register form's L'L names under EVEX.b.
X64_DECODE_ROUNDING: [String]{"{{rn-sae}}", "{{rd-sae}}", "{{ru-sae}}", "{{rz-sae}}"}

// The words of `text` split at spaces.
x64_decode_words: fn(text: String) -> [String] Never! {
    words := [String]{}
    loop word in text.split(" ") {
        if word != "" -> words.push(word)
    }
    words
}

// The value of hex digits `text`, or the build stops naming `row`.
x64_decode_hex_parse: fn(text: String, row: String) -> Int Never! {
    value := 0
    if text == "" -> build_time_refused("X64_DECODE_TABLE: an empty number in `{row}`")
    loop byte in text.bytes() {
        digit: Int{byte}
        value = value * 16 + if {
            digit >= 48 && digit <= 57 -> digit - 48
            digit >= 97 && digit <= 102 -> digit - 87
            digit >= 65 && digit <= 70 -> digit - 55
            else -> build_time_refused("X64_DECODE_TABLE: `{text}` is not hex in `{row}`")
        }
    }
    value
}

// The spaces a row's space word names (X64_DECODE_SPACES).
x64_decode_spaces: fn(word: String, row: String) -> [Int] Never! {
    if {
        word == "L0" -> [Int]{0}
        word == "L1" -> [Int]{1}
        word == "L2" -> [Int]{2}
        word == "L3" -> [Int]{3}
        word == "V1" -> [Int]{4}
        word == "V2" -> [Int]{5}
        word == "V3" -> [Int]{6}
        word == "E1" -> [Int]{7}
        word == "E2" -> [Int]{8}
        word == "E3" -> [Int]{9}
        word == "VE1" -> [Int]{4, 7}
        word == "VE2" -> [Int]{5, 8}
        word == "VE3" -> [Int]{6, 9}
        else -> build_time_refused("X64_DECODE_TABLE: unknown space `{word}` in `{row}`")
    }
}

// The rows of `table` (X64_DECODE_TABLE), ordered by space and opcode. A
// row's conditions: np 66 F3 F2 its mandatory prefix (VEX and EVEX: pp);
// /N its ModRM.reg; r m a register or memory ModRM.rm; =XX its whole ModRM
// byte; W0 W1 its REX.W, VEX.W or EVEX.W; l0 l1 l2 its vector length; o16
// o32 o64 its operand size; B0 B1 its REX.B; a32 a64 its address size; e2
// e4 e8 the bytes of its broadcast element (else 4 or 8 by W); er sae the
// EVEX rounding control or suppress-all-exceptions a register form takes
// under EVEX.b.
x64_decode_rows: fn(table: String) -> [X64DecodeRow] Never! {
    buckets := loop _key in 0..<X64_DECODE_KEYS -> [X64DecodeRow]{}
    loop line in table.split("\n") {
        text: line.trim().copy()
        if text == "" || text.starts_with("#") -> next
        halves: text.split(" | ").to_list()
        if halves.len() != 2 {
            build_time_refused("X64_DECODE_TABLE: a row reads `SPACE OPCODE [CONDITIONS] | NAME [OPERANDS]`, not `{text}`")
        }
        left: x64_decode_words(halves[0])
        right: x64_decode_words(halves[1])
        if left.len() < 2 || right.len() < 1 || right.len() > 2 {
            build_time_refused("X64_DECODE_TABLE: a row reads `SPACE OPCODE [CONDITIONS] | NAME [OPERANDS]`, not `{text}`")
        }
        bounds: left[1].split("-").to_list()
        first: x64_decode_hex_parse(bounds[0], text)
        last: if bounds.len() == 2 -> x64_decode_hex_parse(bounds[1], text) else -> first
        row := X64DecodeRow{space: 0, opcode: 0, name: right[0].copy(), operands: if right.len() == 2 -> right[1].split(",").to_list() else -> [String]{}}
        loop k in 2..<left.len() {
            word: left[k]
            if {
                word == "np" -> row.prefix = 0
                word == "66" -> row.prefix = 0x66
                word == "F3" -> row.prefix = 0xf3
                word == "F2" -> row.prefix = 0xf2
                word == "r" -> row.mode = 3
                word == "m" -> row.mode = 0
                word == "W0" -> row.w = 0
                word == "W1" -> row.w = 1
                word == "l0" -> row.l = 0
                word == "l1" -> row.l = 1
                word == "l2" -> row.l = 2
                word == "o16" -> row.size = 16
                word == "o32" -> row.size = 32
                word == "o64" -> row.size = 64
                word == "B0" -> row.b = 0
                word == "B1" -> row.b = 1
                word == "a32" -> row.addr = 32
                word == "a64" -> row.addr = 64
                word == "e2" -> row.element = 2
                word == "e4" -> row.element = 4
                word == "e8" -> row.element = 8
                word == "er" -> row.rounding = 1
                word == "sae" -> row.rounding = 2
                word.starts_with("/") && word.len() == 2 -> {
                    row.reg = x64_decode_hex_parse(word.slice(1, 2), text)
                }
                word.starts_with("=") -> {
                    row.modrm = x64_decode_hex_parse(word.slice(1, word.len()), text)
                }
                else -> build_time_refused("X64_DECODE_TABLE: unknown condition `{word}` in `{text}`")
            }
        }
        if row.reg > 7 -> build_time_refused("X64_DECODE_TABLE: ModRM.reg past 7 in `{text}`")
        // An st(i) operand is a register form.
        if row.operands.contains("Fi") -> row.mode = 3
        loop space in x64_decode_spaces(left[0], text) {
            loop opcode in first..<last + 1 {
                name: if row.name.contains("{{cc}}") -> row.name.replace("{{cc}}", X64_COND_NAMES[opcode - first]) else -> row.name.copy()
                buckets[space * 256 + opcode].push(x64_decode_row_at(row, space, opcode, name))
            }
        }
    }
    rows := [X64DecodeRow]{}
    loop bucket in buckets {
        loop row in bucket {
            rows.push(x64_decode_row_at(row, row.space, row.opcode, row.name.copy()))
        }
    }
    rows
}

// `row` for opcode `opcode` of space `space`, named `name`.
x64_decode_row_at: fn(row: X64DecodeRow, space: Int, opcode: Int, name: String) -> X64DecodeRow Never! {
    X64DecodeRow{space: space, opcode: opcode, prefix: row.prefix, reg: row.reg, mode: row.mode, modrm: row.modrm, w: row.w, l: row.l, size: row.size, b: row.b, addr: row.addr, element: row.element, rounding: row.rounding, name: name, operands: loop code in row.operands -> code.copy()}
}

// Where each key's rows start in `rows` (ordered by key), and their end.
x64_decode_index: fn(rows: [X64DecodeRow]) -> [Int] Never! {
    starts := [Int]{}
    at := 0
    loop key in 0..<X64_DECODE_KEYS {
        loop at < rows.len() && rows[at].space * 256 + rows[at].opcode < key -> at += 1
        starts.push(at)
    }
    starts.push(rows.len())
    starts
}

// Whether operand code `code` is held in a ModRM byte.
x64_decode_modrm_operand: fn(code: String) -> Bool Never! {
    first: code.slice(0, 1)
    first == "E" || first == "G" || first == "M" || first == "V" || first == "W" || first == "K" || first == "S" || first == "F" || first == "@"
}

// Whether each key (space * 256 + opcode) takes a ModRM byte.
x64_decode_modrm_keys: fn(rows: [X64DecodeRow]) -> [Bool] Never! {
    keys := loop _key in 0..<X64_DECODE_KEYS -> false
    loop row in rows {
        key: row.space * 256 + row.opcode
        // Every VEX and EVEX form but vzeroupper and vzeroall takes one.
        if row.reg >= 0 || row.mode >= 0 || row.modrm >= 0 || (row.space >= 4 && !(row.space == 4 && row.opcode == 0x77)) {
            keys[key] = true
        }
        loop code in row.operands {
            if x64_decode_modrm_operand(code) -> keys[key] = true
        }
    }
    keys
}

// "0x" and the hex digits of `value`, a negative one read as its 64 bits
// unsigned.
x64_hex: fn(value: Int) -> String Never! {
    digits := [U8]{}
    rest := value
    loop {
        digit: rest & 15
        digits.insert(0, U8{if digit < 10 -> 48 + digit else -> 87 + digit})
        rest = (rest >> 4) & 0x0fffffffffffffff
        if rest == 0 -> break
    }
    "0x{String.from_bytes(digits) ?? ""}"
}

// `value` as the `bits`-bit unsigned number with its bits; at 64 bits a
// negative value stays as it is, which x64_hex reads as unsigned.
x64_decode_unsigned: fn(value: Int, bits: Int) -> Int Never! {
    if value < 0 && bits < 64 -> return value + (1 << bits)
    value
}

// The `bits`-bit two's-complement number `value` holds; 0 and 64 bits
// leave it as it is.
x64_decode_signed: fn(value: Int, bits: Int) -> Int Never! {
    if bits > 0 && bits < 64 && value >= 1 << (bits - 1) -> return value - (1 << bits)
    value
}

// The little-endian `size`-byte number at `at` of `bytes`.
x64_decode_le: fn(bytes: [U8], at: Int, size: Int) -> Int Never! {
    value := 0
    loop k in 0..<size -> value = value | (Int{bytes[at + k]} << (8 * k))
    value
}

// Whether `byte` is a legacy prefix: lock, a rep, a segment, the operand or
// the address size.
x64_decode_legacy_prefix: fn(byte: Int) -> Bool Never! {
    byte == 0xf0 || byte == 0xf2 || byte == 0xf3 || byte == 0x2e || byte == 0x36 || byte == 0x3e || byte == 0x26 || byte == 0x64 || byte == 0x65 || byte == 0x66 || byte == 0x67
}

// The mandatory prefix VEX and EVEX pp name.
x64_decode_pp: fn(pp: Int) -> Int Never! {
    if { pp == 1 -> 0x66, pp == 2 -> 0xf3, pp == 3 -> 0xf2, else -> 0 }
}

// One byte that starts no instruction.
x64_decode_bad: fn() -> X64Insn Never! {
    X64Insn{length: 1, named: false, invalid: true, mnemonic: "(bad)", operands: [String]{}, rip: -1, field: -1, width: 0, flow: X64Flow.Plain, cond: 0, indirect: false, reaches: false, reach: 0}
}

// The instruction at `from` of `bytes`, which runs at `address`, or None
// when the bytes end before it does.
x64_decode: fn(bytes: [U8], from: Int, address: Int) -> X64Insn? Never! {
    if from < 0 || from >= bytes.len() -> return None
    d := X64Decoding{from: from, at: from, address: address, prefixes: [Int]{}, immediates: [Int]{}}
    loop d.at < bytes.len() {
        byte: Int{bytes[d.at]}
        if byte >= 0x40 && byte <= 0x4f {
            if d.rex != 0 -> d.voided_rex = d.rex
            d.rex = byte
            d.at += 1
            next
        }
        if !x64_decode_legacy_prefix(byte) -> break
        // A REX counts only right before the opcode.
        if d.rex != 0 {
            d.voided_rex = d.rex
            d.rex = 0
        }
        d.prefixes.push(byte)
        if {
            byte == 0xf0 -> d.lock = true
            byte == 0xf2 || byte == 0xf3 -> d.rep = byte
            byte == 0x66 -> d.opsize = true
            byte == 0x67 -> d.addr32 = true
            else -> d.segment = byte
        }
        d.at += 1
    }
    if d.at >= bytes.len() -> return None
    if d.at - from >= 15 -> return Val(x64_decode_bad())
    d.w = (d.rex >> 3) & 1
    d.r = (d.rex >> 2) & 1
    d.x = (d.rex >> 1) & 1
    d.b = d.rex & 1
    op: Int{bytes[d.at]}
    d.at += 1
    if {
        op == 0xc4 || op == 0xc5 || op == 0x62 -> {
            if d.rex != 0 || d.opsize || d.rep != 0 || d.lock -> return Val(x64_decode_bad())
            read: x64_decode_vex(d, bytes, op)
            if read < 0 -> return None
            if read == 0 -> return Val(x64_decode_bad())
        }
        op == 0x0f -> {
            if d.at >= bytes.len() -> return None
            second: Int{bytes[d.at]}
            d.at += 1
            if {
                second == 0x38 || second == 0x3a -> {
                    if d.at >= bytes.len() -> return None
                    d.space = if second == 0x38 -> 2 else -> 3
                    d.opcode = Int{bytes[d.at]}
                    d.at += 1
                }
                else -> {
                    d.space = 1
                    d.opcode = second
                }
            }
        }
        else -> d.opcode = op
    }
    key: d.space * 256 + d.opcode
    first: X64_DECODE_INDEX[key]
    end: X64_DECODE_INDEX[key + 1]
    modrm: if first < end -> X64_DECODE_MODRM[key] else -> (x64_decode_shape(d) ?? return Val(x64_decode_bad())).modrm
    if modrm && !x64_decode_modrm(d, bytes) -> return None
    loop index in first..<end {
        if x64_decode_holds(d, X64_DECODE_ROWS[index]) {
            return x64_decode_named(d, bytes, X64_DECODE_ROWS[index])
        }
    }
    // No form names it; its shape still gives its length.
    shape: x64_decode_shape(d) ?? return Val(x64_decode_bad())
    if shape.modrm != modrm -> return Val(x64_decode_bad())
    if d.at + shape.imm > bytes.len() -> return None
    length: d.at + shape.imm - from
    if length > 15 -> return Val(x64_decode_bad())
    Val(X64Insn{length: length, named: false, invalid: false, mnemonic: "(bad)", operands: [String]{}, rip: d.rip, field: -1, width: 0, flow: X64Flow.Plain, cond: 0, indirect: false, reaches: false, reach: 0})
}

// Read the VEX (C4, C5) or EVEX (62) prefix whose first byte `op` was just
// read, and the opcode after it: 1 when read, 0 when the bytes can't start
// one, -1 when they end first.
x64_decode_vex: fn(d: ^X64Decoding, bytes: [U8], op: Int) -> Int Never! {
    size: if { op == 0xc5 -> 1, op == 0xc4 -> 2, else -> 3 }
    if d.at + size >= bytes.len() -> return -1
    p0: Int{bytes[d.at]}
    if {
        op == 0xc5 -> {
            d.r = 1 - ((p0 >> 7) & 1)
            d.vvvv = 15 - ((p0 >> 3) & 15)
            d.l = (p0 >> 2) & 1
            d.pp = x64_decode_pp(p0 & 3)
            d.space = 4
            d.kind = 1
        }
        op == 0xc4 -> {
            p1: Int{bytes[d.at + 1]}
            map: p0 & 31
            if map < 1 || map > 3 -> return 0
            d.r = 1 - ((p0 >> 7) & 1)
            d.x = 1 - ((p0 >> 6) & 1)
            d.b = 1 - ((p0 >> 5) & 1)
            d.w = (p1 >> 7) & 1
            d.vvvv = 15 - ((p1 >> 3) & 15)
            d.l = (p1 >> 2) & 1
            d.pp = x64_decode_pp(p1 & 3)
            d.space = 3 + map
            d.kind = 1
        }
        else -> {
            p1: Int{bytes[d.at + 1]}
            p2: Int{bytes[d.at + 2]}
            map: p0 & 7
            if (p0 & 8) != 0 || (p1 & 4) == 0 || map == 0 || map == 4 || map == 7 -> return 0
            d.r = 1 - ((p0 >> 7) & 1)
            d.x = 1 - ((p0 >> 6) & 1)
            d.b = 1 - ((p0 >> 5) & 1)
            d.r2 = 1 - ((p0 >> 4) & 1)
            d.w = (p1 >> 7) & 1
            d.vvvv = 15 - ((p1 >> 3) & 15)
            d.pp = x64_decode_pp(p1 & 3)
            d.z = (p2 >> 7) & 1
            d.l = (p2 >> 5) & 3
            d.bcst = (p2 >> 4) & 1
            d.v2 = 1 - ((p2 >> 3) & 1)
            d.aaa = p2 & 7
            d.space = if map <= 3 -> 6 + map else -> 5 + map
            d.kind = 2
        }
    }
    d.at += size
    d.opcode = Int{bytes[d.at]}
    d.at += 1
    1
}

// Read the ModRM byte at the cursor and the SIB and displacement it names;
// false when the bytes end first.
x64_decode_modrm: fn(d: ^X64Decoding, bytes: [U8]) -> Bool Never! {
    if d.at >= bytes.len() -> return false
    byte: Int{bytes[d.at]}
    d.at += 1
    d.modrm = byte
    d.mod = byte >> 6
    d.reg = (byte >> 3) & 7
    d.rm = byte & 7
    if d.mod == 3 -> return true
    size := if { d.mod == 1 -> 1, d.mod == 2 -> 4, else -> 0 }
    if {
        d.rm == 4 -> {
            if d.at >= bytes.len() -> return false
            sib: Int{bytes[d.at]}
            d.at += 1
            d.sib = true
            d.scale = sib >> 6
            d.index = (sib >> 3) & 7
            d.base = sib & 7
            if d.mod == 0 && d.base == 5 -> size = 4
        }
        d.mod == 0 && d.rm == 5 -> {
            size = 4
            d.rip = d.at - d.from
        }
    }
    if d.at + size > bytes.len() -> return false
    d.disp = x64_decode_signed(x64_decode_le(bytes, d.at, size), 8 * size)
    d.at += size
    true
}

// Whether the instruction takes a ModRM byte, and its immediate's size, by
// its map and opcode alone, for one no row names: the VEX and EVEX maps and
// 0F 38 and 0F 3A take a ModRM byte (an immediate in 0F 3A and in the VEX 0F
// opcodes with one), the 0F map by opcode. None for the one-byte map and the
// 0F opcodes that start no instruction (0F 0F 3DNow!).
x64_decode_shape: fn(d: X64Decoding) -> {modrm: Bool, imm: Int}? Never! {
    op: d.opcode
    if {
        d.space == 0 -> None
        d.space == 2 || d.space == 5 || d.space == 8 || d.space >= 10 -> Val({modrm: true, imm: 0})
        d.space == 3 || d.space == 6 || d.space == 9 -> Val({modrm: true, imm: 1})
        d.space == 4 || d.space == 7 -> {
            if op == 0x77 -> return Val({modrm: false, imm: 0})
            imm: if (op >= 0x70 && op <= 0x73) || op == 0xc2 || op == 0xc4 || op == 0xc5 || op == 0xc6 -> 1 else -> 0
            Val({modrm: true, imm: imm})
        }
        op == 0x0f -> None
        op == 0x05 || op == 0x06 || op == 0x07 || op == 0x08 || op == 0x09 || op == 0x0b || op == 0x0e || op == 0x77 -> Val({modrm: false, imm: 0})
        op >= 0x30 && op <= 0x37 -> Val({modrm: false, imm: 0})
        op == 0xa0 || op == 0xa1 || op == 0xa2 || op == 0xa8 || op == 0xa9 || op == 0xaa -> Val({modrm: false, imm: 0})
        op >= 0xc8 && op <= 0xcf -> Val({modrm: false, imm: 0})
        op >= 0x70 && op <= 0x73 -> Val({modrm: true, imm: 1})
        op == 0xa4 || op == 0xac || op == 0xba || op == 0xc2 || op == 0xc4 || op == 0xc5 || op == 0xc6 -> Val({modrm: true, imm: 1})
        else -> Val({modrm: true, imm: 0})
    }
}

// The prefix that selects a row: VEX and EVEX pp, else the last F2 or F3,
// else 66.
x64_decode_mandatory: fn(d: X64Decoding) -> Int Never! {
    if {
        d.kind != 0 -> d.pp
        d.rep != 0 -> d.rep
        d.opsize -> 0x66
        else -> 0
    }
}

// The vector length bits a row tests: EVEX.b on a register form makes L'L
// the rounding, its length 512 bits.
x64_decode_length_bits: fn(d: X64Decoding) -> Int Never! {
    if d.kind == 2 && d.bcst == 1 && d.mod == 3 && d.modrm >= 0 -> return 2
    d.l
}

// Whether `row` holds for the instruction read so far.
x64_decode_holds: fn(d: X64Decoding, row: X64DecodeRow) -> Bool Never! {
    if row.prefix >= 0 && row.prefix != x64_decode_mandatory(d) -> return false
    if row.reg >= 0 && row.reg != d.reg -> return false
    if row.mode >= 0 && (row.mode == 3) != (d.mod == 3) -> return false
    if row.modrm >= 0 && row.modrm != d.modrm -> return false
    if row.w >= 0 && row.w != d.w -> return false
    if row.l >= 0 && row.l != x64_decode_length_bits(d) -> return false
    if row.size >= 0 && row.size != x64_decode_osize(d, row) -> return false
    if row.b >= 0 && row.b != d.b -> return false
    if row.addr >= 0 && row.addr != (if d.addr32 -> 32 else -> 64) -> return false
    true
}

// The operand size under `row`: 64 under W, 16 under a 66 the row doesn't
// take as its mandatory prefix, else 32.
x64_decode_osize: fn(d: X64Decoding, row: X64DecodeRow) -> Int Never! {
    if {
        d.w == 1 -> 64
        d.opsize && row.prefix != 0x66 -> 16
        else -> 32
    }
}

// The size of a push, a pop and a near branch through memory: 64 bits, 16
// under a 66.
x64_decode_stack: fn(d: X64Decoding, row: X64DecodeRow) -> Int Never! {
    if d.opsize && row.prefix != 0x66 -> 16 else -> 64
}

// The vector length in bytes: 16 for the legacy forms, VEX.L, EVEX L'L
// (512 bits under rounding control).
x64_decode_vl: fn(d: X64Decoding, row: X64DecodeRow) -> Int Never! {
    if {
        d.kind == 0 -> 16
        d.kind == 1 -> if d.l == 1 -> 32 else -> 16
        d.bcst == 1 && d.mod == 3 && row.rounding > 0 -> 64
        d.l == 0 -> 16
        d.l == 1 -> 32
        else -> 64
    }
}

// The bytes of an immediate operand code `code` (0: not an immediate).
x64_decode_immediate_size: fn(d: X64Decoding, row: X64DecodeRow, code: String) -> Int Never! {
    osize: x64_decode_osize(d, row)
    if {
        code == "Ib" || code == "Ibs" || code == "Ibq" || code == "Lx" || code == "Jb" -> 1
        code == "Iw" -> 2
        code == "Iz" -> if osize == 16 -> 2 else -> 4
        code == "Izq" -> if x64_decode_stack(d, row) == 16 -> 2 else -> 4
        code == "Iv" -> osize /% 8
        code == "Jz" -> 4
        code == "Ob" || code == "Ov" -> if d.addr32 -> 4 else -> 8
        else -> 0
    }
}

// How the instruction leaves.
x64_decode_flow: fn(d: X64Decoding) -> X64Flow Never! {
    op: d.opcode
    if {
        d.space == 0 && op >= 0x70 && op <= 0x7f -> X64Flow.Cond
        d.space == 0 && op == 0xe8 -> X64Flow.Call
        d.space == 0 && (op == 0xe9 || op == 0xeb) -> X64Flow.Jump
        d.space == 0 && op >= 0xe0 && op <= 0xe3 -> X64Flow.Loop
        d.space == 0 && (op == 0xc2 || op == 0xc3 || op == 0xca || op == 0xcb || op == 0xcf) -> X64Flow.Return
        d.space == 0 && op == 0xf4 -> X64Flow.Stop
        d.space == 0 && op == 0xff && (d.reg == 2 || d.reg == 3) -> X64Flow.Call
        d.space == 0 && op == 0xff && (d.reg == 4 || d.reg == 5) -> X64Flow.Jump
        d.space == 1 && op >= 0x80 && op <= 0x8f -> X64Flow.Cond
        d.space == 1 && (op == 0x0b || op == 0xb9 || op == 0xff) -> X64Flow.Stop
        else -> X64Flow.Plain
    }
}

// Whether operand code `code` reads its width from the operand size, so a
// 66 is used by it.
x64_decode_sized_operand: fn(code: String) -> Bool Never! {
    code == "Ev" || code == "Gv" || code == "Zv" || code == "Zs" || code == "Es" || code == "Mv" || code == "Iz" || code == "Iv" || code == "Izq" || code == "Ibq" || code == "Ibs" || code == "rAX" || code == "eAX" || code == "Xv" || code == "Yv" || code == "Xz" || code == "Yz"
}

// Whether operand code `code` reads memory through the ModRM byte, a
// string register or an absolute address.
x64_decode_memory_operand: fn(d: X64Decoding, code: String) -> Bool Never! {
    first: code.slice(0, 1)
    if code == "XBX" || code == "Ob" || code == "Ov" || code == "Xb" || code == "Xv" || code == "Xz" || code == "Yb" || code == "Yv" || code == "Yz" {
        return true
    }
    if d.mod == 3 || d.modrm < 0 -> return false
    first == "E" || first == "M" || first == "W" || first == "@" || code.starts_with("Km")
}

// The instruction `row` names, its immediates read from the cursor.
x64_decode_named: fn(d: ^X64Decoding, bytes: [U8], row: X64DecodeRow) -> X64Insn? Never! {
    field := -1
    width := 0
    loop code in row.operands {
        size: x64_decode_immediate_size(d, row, code)
        if size == 0 -> next
        // A 16-bit relative branch truncates rip, which no code here does.
        if code.starts_with("J") && d.opsize -> return Val(x64_decode_bad())
        if d.at + size > bytes.len() -> return None
        if code.starts_with("J") {
            field = d.at - d.from
            width = size
        }
        d.immediates.push(x64_decode_le(bytes, d.at, size))
        d.at += size
    }
    length: d.at - d.from
    if length > 15 -> return Val(x64_decode_bad())
    flow: x64_decode_flow(d)
    insn := X64Insn{length: length, named: true, invalid: false, mnemonic: "", operands: [String]{}, rip: d.rip, field: field, width: width, flow: flow, cond: if flow == .Cond -> d.opcode & 15 else -> 0, indirect: d.space == 0 && d.opcode == 0xff && d.reg >= 2 && d.reg <= 5, reaches: false, reach: 0}
    memory := false
    sized := row.size >= 0
    slot := 0
    loop code in row.operands {
        immediate: if x64_decode_immediate_size(d, row, code) > 0 -> d.immediates[slot] else -> 0
        if x64_decode_immediate_size(d, row, code) > 0 -> slot += 1
        if x64_decode_memory_operand(d, code) -> memory = true
        if x64_decode_sized_operand(code) -> sized = true
        if code.starts_with("J") {
            insn.reaches = true
            insn.reach = d.address + length + x64_decode_signed(immediate, 8 * width)
        }
        insn.operands.push(x64_decode_operand(d, row, code, immediate, length))
    }
    if d.rip >= 0 && memory {
        insn.reaches = true
        insn.reach = d.address + length + d.disp
    }
    if d.kind == 2 && insn.operands.len() > 0 {
        if d.aaa != 0 -> insn.operands[0] = "{insn.operands[0]}{{k{d.aaa}}}"
        if d.z == 1 -> insn.operands[0] = "{insn.operands[0]}{{z}}"
        // objdump writes the rounding or {sae} onto the last register
        // operand, before any immediate.
        if d.bcst == 1 && d.mod == 3 && row.rounding > 0 {
            control: if row.rounding == 1 -> X64_DECODE_ROUNDING[d.l] else -> "{{sae}}"
            last_register := insn.operands.len() - 1
            loop last_register > 0 && insn.operands[last_register].starts_with("0x") {
                last_register -= 1
            }
            insn.operands[last_register] = "{insn.operands[last_register]}{control}"
        }
    }
    name := row.name.copy()
    // The predicate immediates objdump spells into the name.
    last: if d.immediates.len() > 0 -> d.immediates[d.immediates.len() - 1] else -> -1
    predicate := ""
    if d.opcode == 0xc2 && (d.space == 1 || d.space == 4 || d.space == 7) && last >= 0 && last < (if d.space == 1 -> 8 else -> 32) {
        predicate = X64_DECODE_CMP_PREDICATES[last]
        name = name.replace("cmp", "cmp{predicate}")
    }
    if d.opcode == 0x44 && (d.space == 3 || d.space == 6 || d.space == 9) && (last == 0 || last == 1 || last == 0x10 || last == 0x11) {
        predicate = if {
            last == 0 -> "lqlq"
            last == 1 -> "hqlq"
            last == 0x10 -> "lqhq"
            else -> "hqhq"
        }
        name = name.replace("pclmulqdq", "pclmul{predicate}dq")
    }
    if d.space == 9 && (d.opcode == 0x1e || d.opcode == 0x1f || d.opcode == 0x3e || d.opcode == 0x3f) && last >= 0 && last < 8 && X64_DECODE_VPCMP_PREDICATES[last] != "" {
        predicate = X64_DECODE_VPCMP_PREDICATES[last]
        name = name.replace("vpcmp", "vpcmp{predicate}")
    }
    if predicate != "" {
        // The immediate is the row's last operand; EVEX rounding follows it.
        kept := [String]{}
        loop (k, operand) in insn.operands {
            if k != row.operands.len() - 1 -> kept.push(operand.copy())
        }
        insn.operands = kept
    }
    words: x64_decode_prefix_words(d, row, flow, insn.indirect, memory, sized, insn.operands)
    insn.mnemonic = if words == "" -> name else -> "{words} {name}"
    Val(insn)
}

// The prefixes objdump shows before the mnemonic, in byte order: lock, a
// rep the instruction doesn't take as its mandatory prefix (rep, repz,
// repnz; bnd on a branch; xacquire and xrelease under lock), a 66 or 67 no
// operand used (data16, addr32), a cs, ss, ds or es (ignored in 64-bit
// code; notrack on an indirect branch), an fs or gs no memory operand used,
// a REX a later prefix voided, and a bare REX (40) no byte register of
// `operands` needed: only spl, bpl, sil and dil take one.
x64_decode_prefix_words: fn(d: X64Decoding, row: X64DecodeRow, flow: X64Flow, indirect: Bool, memory: Bool, sized: Bool, operands: [String]) -> String Never! {
    words := [String]{}
    if d.voided_rex != 0 {
        bits := ""
        if d.voided_rex & 8 != 0 -> bits = "{bits}W"
        if d.voided_rex & 4 != 0 -> bits = "{bits}R"
        if d.voided_rex & 2 != 0 -> bits = "{bits}X"
        if d.voided_rex & 1 != 0 -> bits = "{bits}B"
        words.push(if bits == "" -> "rex" else -> "rex.{bits}")
    }
    string_op: d.space == 0 && ((d.opcode >= 0x6c && d.opcode <= 0x6f) || (d.opcode >= 0xa4 && d.opcode <= 0xa7) || (d.opcode >= 0xaa && d.opcode <= 0xaf))
    compare_op: d.space == 0 && (d.opcode == 0xa6 || d.opcode == 0xa7 || d.opcode == 0xae || d.opcode == 0xaf)
    branch: flow == .Jump || flow == .Call || flow == .Return || flow == .Cond
    loop (k, byte) in d.prefixes {
        latest := true
        loop later in k + 1..<d.prefixes.len() {
            same: d.prefixes[later] == byte || ((byte == 0xf2 || byte == 0xf3) && (d.prefixes[later] == 0xf2 || d.prefixes[later] == 0xf3)) || (x64_decode_segment_prefix(byte) && x64_decode_segment_prefix(d.prefixes[later]))
            if same -> latest = false
        }
        if {
            byte == 0xf0 -> words.push("lock")
            byte == 0xf2 || byte == 0xf3 -> {
                if latest && d.kind == 0 && row.prefix == byte -> next
                words.push(
                    if {
                        d.lock -> if byte == 0xf2 -> "xacquire" else -> "xrelease"
                        string_op && byte == 0xf3 -> if compare_op -> "repz" else -> "rep"
                        byte == 0xf2 && branch -> "bnd"
                        byte == 0xf2 -> "repnz"
                        else -> "repz"
                    },
                )
            }
            byte == 0x66 -> {
                if !(latest && (row.prefix == 0x66 || sized)) -> words.push("data16")
            }
            byte == 0x67 -> {
                if !(latest && (memory || row.addr >= 0)) -> words.push("addr32")
            }
            byte == 0x64 || byte == 0x65 -> {
                if !(latest && memory) -> words.push(if byte == 0x64 -> "fs" else -> "gs")
            }
            byte == 0x3e && indirect -> words.push("notrack")
            else -> words.push(X64_DECODE_SEGMENTS[x64_decode_segment_number(byte)])
        }
    }
    if d.rex == 0x40 && !operands.contains("spl") && !operands.contains("bpl") && !operands.contains("sil") && !operands.contains("dil") {
        words.push("rex")
    }
    words.join(" ")
}

// Whether `byte` is a segment override.
x64_decode_segment_prefix: fn(byte: Int) -> Bool Never! {
    byte == 0x26 || byte == 0x2e || byte == 0x36 || byte == 0x3e || byte == 0x64 || byte == 0x65
}

// The segment register (X64_DECODE_SEGMENTS) override `byte` names.
x64_decode_segment_number: fn(byte: Int) -> Int Never! {
    if {
        byte == 0x26 -> 0
        byte == 0x2e -> 1
        byte == 0x36 -> 2
        byte == 0x3e -> 3
        byte == 0x64 -> 4
        else -> 5
    }
}

// General register `n` at `bits` wide; a byte register without a REX
// prefix is ah-bh for 4-7.
x64_decode_gpr: fn(n: Int, bits: Int, rex: Bool) -> String Never! {
    if {
        bits == 64 -> X64_REGISTER_NAMES[n]
        bits == 32 -> X64_DECODE_GPR32[n]
        bits == 16 -> X64_DECODE_GPR16[n]
        !rex && n >= 4 && n < 8 -> X64_DECODE_GPR8_HIGH[n - 4]
        else -> X64_DECODE_GPR8[n]
    }
}

// Vector register `n` of `bytes` bytes (at least an xmm).
x64_decode_vreg: fn(n: Int, bytes: Int) -> String Never! {
    if { bytes >= 64 -> "zmm{n}", bytes >= 32 -> "ymm{n}", else -> "xmm{n}" }
}

// The width in bits of a general-register operand of size letters `size`.
x64_decode_gpr_bits: fn(d: X64Decoding, row: X64DecodeRow, size: String) -> Int Never! {
    if {
        size == "b" -> 8
        size == "w" -> 16
        size == "d" || size == "db" || size == "dw" -> 32
        size == "q" -> 64
        size == "y" -> if d.w == 1 -> 64 else -> 32
        size == "s" -> x64_decode_stack(d, row)
        size == "z" -> if x64_decode_osize(d, row) == 16 -> 16 else -> 32
        else -> x64_decode_osize(d, row)
    }
}

// The bytes a memory operand of size letters `size` reads (0: unsized).
x64_decode_memory_bytes: fn(d: X64Decoding, row: X64DecodeRow, size: String) -> Int Never! {
    vl: x64_decode_vl(d, row)
    if {
        size == "" -> 0
        size == "b" || size == "db" -> 1
        size == "w" || size == "dw" -> 2
        size == "d" -> 4
        size == "q" -> 8
        size == "f" -> 6
        size == "t" -> 10
        size == "o" || size == "dq" -> 16
        size == "qq" -> 32
        size == "x" -> vl
        size == "h" -> vl /% 2
        size == "4" -> vl /% 4
        size == "8" -> vl /% 8
        else -> x64_decode_gpr_bits(d, row, size) /% 8
    }
}

// The size word objdump writes before a memory operand of `bytes` bytes.
x64_decode_label: fn(bytes: Int, size: String) -> String Never! {
    if {
        size == "o" -> "OWORD PTR "
        bytes == 1 -> "BYTE PTR "
        bytes == 2 -> "WORD PTR "
        bytes == 4 -> "DWORD PTR "
        bytes == 6 -> "FWORD PTR "
        bytes == 8 -> "QWORD PTR "
        bytes == 10 -> "TBYTE PTR "
        bytes == 16 -> "XMMWORD PTR "
        bytes == 32 -> "YMMWORD PTR "
        bytes == 64 -> "ZMMWORD PTR "
        else -> ""
    }
}

// A displacement as objdump adds it: "+0x8", "-0x8".
x64_decode_disp: fn(disp: Int) -> String Never! {
    if disp < 0 -> "-{x64_hex(-disp)}" else -> "+{x64_hex(disp)}"
}

// The ModRM memory operand: `label` before it, EVEX's disp8 scaled by `n`,
// and a VSIB index of `vsib` bytes (0: a general index).
x64_decode_memory: fn(d: X64Decoding, label: String, n: Int, vsib: Int) -> String Never! {
    segment: if { d.segment == 0x64 -> "fs:", d.segment == 0x65 -> "gs:", else -> "" }
    disp: if d.kind == 2 && d.mod == 1 -> d.disp * n else -> d.disp
    bits: if d.addr32 -> 32 else -> 64
    if !d.sib && d.mod == 0 && d.rm == 5 {
        return "{label}{segment}[{if d.addr32 -> "eip" else -> "rip"}{x64_decode_disp(disp)}]"
    }
    base := -1
    index := -1
    if {
        d.sib -> {
            if !(d.mod == 0 && d.base == 5) -> base = d.base | (d.b << 3)
            number: d.index | (d.x << 3)
            if {
                vsib > 0 -> index = number | (d.v2 << 4)
                number != 4 -> index = number
            }
        }
        else -> base = d.rm | (d.b << 3)
    }
    // An index of 4 (none) shows as riz when the scale or a base other than
    // rsp and r12 says the SIB byte meant one.
    zero: vsib == 0 && index < 0 && d.sib && (d.scale != 0 || (base >= 0 && d.base != 4))
    if base < 0 && index < 0 && !zero {
        return "{label}{if segment == "" -> "ds:" else -> segment}{x64_hex(x64_decode_unsigned(disp, bits))}"
    }
    inner := if base >= 0 -> x64_decode_gpr(base, bits, true) else -> ""
    if index >= 0 || zero {
        name: if {
            vsib > 0 -> x64_decode_vreg(index, vsib)
            zero -> if d.addr32 -> "eiz" else -> "riz"
            else -> x64_decode_gpr(index, bits, true)
        }
        inner = if inner == "" -> "{name}*{1 << d.scale}" else -> "{inner}+{name}*{1 << d.scale}"
    }
    if d.mod != 0 || base < 0 -> inner = "{inner}{x64_decode_disp(disp)}"
    "{label}{segment}[{inner}]"
}

// One operand as objdump writes it, for operand code `code`. The codes:
// E the ModRM.rm general register or memory; G the ModRM.reg general
// register; M memory only; Z the opcode's register; V the ModRM.reg vector
// register; W the ModRM.rm vector register or memory; H VEX.vvvv (Hy a
// general register, Hk a mask); Lx the vector register imm8[7:4] names; Kr
// the ModRM.reg mask, Km the ModRM.rm mask or memory; @ VSIB memory (index
// x the vector length or h half of it, element d or q); Sw the ModRM.reg
// segment register; Fi st(ModRM.rm), F0 st; X and Y the string source
// [rsi] and destination [rdi], XBX xlat's [rbx]; Ib Iw an
// immediate, Iz one of 16 or 32 bits and Iv of 16, 32 or 64 by the operand
// size, Ibs one sign-extended to the operand size, Ibq and Izq to the stack
// size; Jb Jz a relative branch; Ob Ov an absolute address; and the fixed
// registers AL CL DX AX rAX eAX XMM0 and the count 1. The size letters: b w
// d q a byte to a quadword, t a tbyte, f a fword, o an oword, dq an
// xmmword, qq a ymmword, v the operand size, y d or q by W, s the stack
// size, z w or d by the operand size, x the vector length, h 4 8 its half,
// quarter or eighth, db dw a 32-bit register or a byte or word in memory.
x64_decode_operand: fn(d: X64Decoding, row: X64DecodeRow, code: String, immediate: Int, length: Int) -> String Never! {
    osize: x64_decode_osize(d, row)
    first: code.slice(0, 1)
    size: code.slice(1, code.len())
    vl: x64_decode_vl(d, row)
    if {
        code == "AL" || code == "CL" || code == "DX" || code == "AX" || code == "XMM0" -> code.to_lower()
        code == "1" -> "1"
        code == "rAX" -> x64_decode_gpr(0, osize, true)
        code == "eAX" -> if osize == 16 -> "ax" else -> "eax"
        code == "Ib" || code == "Iw" || code == "Iv" -> x64_hex(immediate)
        code == "Ibs" -> x64_hex(x64_decode_unsigned(x64_decode_signed(immediate, 8), osize))
        code == "Ibq" -> x64_hex(x64_decode_unsigned(x64_decode_signed(immediate, 8), x64_decode_stack(d, row)))
        code == "Iz" -> {
            bits: if osize == 16 -> 16 else -> 32
            x64_hex(x64_decode_unsigned(x64_decode_signed(immediate, bits), osize))
        }
        code == "Izq" -> {
            stack: x64_decode_stack(d, row)
            x64_hex(x64_decode_unsigned(x64_decode_signed(immediate, if stack == 16 -> 16 else -> 32), stack))
        }
        code == "Jb" || code == "Jz" -> {
            width: if code == "Jb" -> 8 else -> 32
            x64_hex(x64_decode_unsigned(d.address + length + x64_decode_signed(immediate, width), 64))
        }
        code == "Ob" || code == "Ov" -> {
            segment: if { d.segment == 0x64 -> "fs", d.segment == 0x65 -> "gs", else -> "ds" }
            "{segment}:{x64_hex(immediate)}"
        }
        code == "XBX" -> "BYTE PTR {x64_decode_string_segment(d)}[{if d.addr32 -> "ebx" else -> "rbx"}]"
        first == "X" || first == "Y" -> {
            bytes: x64_decode_gpr_bits(d, row, size) /% 8
            segment: if first == "Y" -> "" else -> x64_decode_string_segment(d)
            register: if {
                first == "Y" && d.addr32 -> "edi"
                first == "Y" -> "rdi"
                d.addr32 -> "esi"
                else -> "rsi"
            }
            "{x64_decode_label(bytes, size)}{segment}[{register}]"
        }
        code == "Sw" -> if d.reg < 6 -> X64_DECODE_SEGMENTS[d.reg] else -> "(bad)"
        code == "F0" -> "st"
        code == "Fi" -> "st({d.rm})"
        code == "Kr" -> "k{d.reg}"
        code == "Hk" -> "k{d.vvvv & 7}"
        code == "Hy" -> x64_decode_gpr(d.vvvv, if d.w == 1 -> 64 else -> 32, true)
        code.starts_with("Km") -> {
            if d.mod == 3 -> return "k{d.rm}"
            bytes: x64_decode_memory_bytes(d, row, code.slice(2, code.len()))
            x64_decode_memory(d, x64_decode_label(bytes, ""), bytes, 0)
        }
        code == "Lx" -> x64_decode_vreg(immediate >> 4, vl)
        first == "G" -> x64_decode_gpr(d.reg | (d.r << 3), x64_decode_gpr_bits(d, row, size), d.rex != 0)
        first == "Z" -> x64_decode_gpr((d.opcode & 7) | (d.b << 3), x64_decode_gpr_bits(d, row, size), d.rex != 0)
        first == "E" -> {
            if d.mod == 3 {
                return x64_decode_gpr(d.rm | (d.b << 3), x64_decode_gpr_bits(d, row, size), d.rex != 0)
            }
            bytes: x64_decode_memory_bytes(d, row, size)
            x64_decode_memory(d, x64_decode_label(bytes, size), bytes, 0)
        }
        first == "M" -> {
            if d.mod == 3 -> return "(bad)"
            bytes: x64_decode_memory_bytes(d, row, size)
            x64_decode_memory(d, x64_decode_label(bytes, size), bytes, 0)
        }
        first == "V" -> x64_decode_vreg(d.reg | (d.r << 3) | (d.r2 << 4), x64_decode_vector_bytes(d, row, size))
        first == "H" -> x64_decode_vreg(d.vvvv | (d.v2 << 4), x64_decode_vector_bytes(d, row, size))
        first == "W" -> {
            if d.mod == 3 {
                extra: if d.kind == 2 -> d.x << 4 else -> 0
                return x64_decode_vreg(d.rm | (d.b << 3) | extra, x64_decode_vector_bytes(d, row, size))
            }
            // A W of size y is a ymm's 32 bytes, not the y of a general register.
            bytes: if size == "y" -> 32 else -> x64_decode_memory_bytes(d, row, size)
            if d.kind == 2 && d.bcst == 1 {
                element: if {
                    row.element > 0 -> row.element
                    d.w == 1 -> 8
                    else -> 4
                }
                word: x64_decode_label(element, "").replace(" PTR ", " BCST ")
                return x64_decode_memory(d, word, element, 0)
            }
            x64_decode_memory(d, x64_decode_label(bytes, size), bytes, 0)
        }
        first == "@" -> {
            if d.mod == 3 -> return "(bad)"
            element: if code.slice(2, 3) == "q" -> 8 else -> 4
            index: if code.slice(1, 2) == "h" && vl > 16 -> vl /% 2 else -> vl
            x64_decode_memory(d, x64_decode_label(element, ""), element, index)
        }
        else -> "(bad)"
    }
}

// The bytes of a vector register operand of size letters `size`, at least
// an xmm's.
x64_decode_vector_bytes: fn(d: X64Decoding, row: X64DecodeRow, size: String) -> Int Never! {
    vl: x64_decode_vl(d, row)
    bytes: if {
        size == "x" -> vl
        size == "y" -> 32
        size == "h" -> vl /% 2
        size == "4" -> vl /% 4
        size == "8" -> vl /% 8
        else -> 16
    }
    if bytes < 16 -> 16 else -> bytes
}

// The segment a string source names: an fs or gs override ("fs:"), else
// none, since 64-bit code ignores ds, es, cs and ss.
x64_decode_string_segment: fn(d: X64Decoding) -> String Never! {
    if { d.segment == 0x64 -> "fs:", d.segment == 0x65 -> "gs:", else -> "" }
}

// The instruction as objdump -M intel writes it: the mnemonic, a space and
// the operands joined by commas.
x64_insn_text: fn(insn: X64Insn) -> String Never! {
    if insn.operands.len() == 0 -> return insn.mnemonic.copy()
    "{insn.mnemonic} {insn.operands.join(",")}"
}

#Test("the decoder spells instructions as objdump -M intel does") {
    cases: [{bytes: [U8], text: String}]{
        {bytes: [U8]{0x48, 0x8b, 0x45, 0xf8}, text: "mov rax,QWORD PTR [rbp-0x8]"},
        {bytes: [U8]{0x48, 0x8b, 0x05, 0x10, 0, 0, 0}, text: "mov rax,QWORD PTR [rip+0x10]"},
        {bytes: [U8]{0x0f, 0x1f, 0x44, 0x00, 0x00}, text: "nop DWORD PTR [rax+rax*1+0x0]"},
        {bytes: [U8]{0x66, 0x2e, 0x0f, 0x1f, 0x84, 0, 0, 0, 0, 0}, text: "cs nop WORD PTR [rax+rax*1+0x0]"},
        {bytes: [U8]{0x66, 0x90}, text: "xchg ax,ax"},
        {bytes: [U8]{0x90}, text: "nop"},
        {bytes: [U8]{0xf3, 0xc3}, text: "repz ret"},
        {bytes: [U8]{0xf3, 0x48, 0xab}, text: "rep stos QWORD PTR [rdi],rax"},
        {bytes: [U8]{0xf3, 0xa4}, text: "rep movs BYTE PTR [rdi],BYTE PTR [rsi]"},
        {bytes: [U8]{0x64, 0xac}, text: "lods al,BYTE PTR fs:[rsi]"},
        {bytes: [U8]{0x40, 0x0f, 0x94, 0xc0}, text: "rex sete al"},
        {bytes: [U8]{0x40, 0x0f, 0x94, 0xc6}, text: "sete sil"},
        {bytes: [U8]{0x62, 0xf1, 0x7c, 0x38, 0x58, 0xc2}, text: "vaddps zmm0,zmm0,zmm2{{rd-sae}}"},
        {bytes: [U8]{0xf0, 0x48, 0xff, 0x00}, text: "lock inc QWORD PTR [rax]"},
        {bytes: [U8]{0x48, 0x83, 0xe4, 0xf0}, text: "and rsp,0xfffffffffffffff0"},
        {bytes: [U8]{0x48, 0xb8, 1, 2, 3, 4, 5, 6, 7, 8}, text: "movabs rax,0x807060504030201"},
        {bytes: [U8]{0x64, 0x48, 0x8b, 0x04, 0x25, 0x28, 0, 0, 0}, text: "mov rax,QWORD PTR fs:0x28"},
        {bytes: [U8]{0x40, 0x88, 0xc6}, text: "mov sil,al"},
        {bytes: [U8]{0x88, 0xc6}, text: "mov dh,al"},
        {bytes: [U8]{0x48, 0xd1, 0xe0}, text: "shl rax,1"},
        {bytes: [U8]{0x48, 0xd3, 0xe0}, text: "shl rax,cl"},
        {bytes: [U8]{0x0f, 0x94, 0xc0}, text: "sete al"},
        {bytes: [U8]{0xf2, 0x0f, 0x10, 0x45, 0xf8}, text: "movsd xmm0,QWORD PTR [rbp-0x8]"},
        {bytes: [U8]{0x44, 0x0f, 0x10, 0x45, 0x20}, text: "movups xmm8,XMMWORD PTR [rbp+0x20]"},
        {bytes: [U8]{0xc5, 0xfe, 0x6f, 0x06}, text: "vmovdqu ymm0,YMMWORD PTR [rsi]"},
        {bytes: [U8]{0xc4, 0xe2, 0xf1, 0xa9, 0xc2}, text: "vfmadd213sd xmm0,xmm1,xmm2"},
        {bytes: [U8]{0xf3, 0x48, 0x0f, 0xae, 0xdf}, text: "wrgsbase rdi"},
        {bytes: [U8]{0x65, 0x48, 0x8b, 0x04, 0x25, 0, 0, 0, 0}, text: "mov rax,QWORD PTR gs:0x0"},
        {bytes: [U8]{0x0f, 0xc2, 0xc1, 0x01}, text: "cmpltps xmm0,xmm1"},
        {bytes: [U8]{0x66, 0x0f, 0x3a, 0x44, 0xc1, 0x11}, text: "pclmulhqhqdq xmm0,xmm1"},
        {bytes: [U8]{0x62, 0xf1, 0x7c, 0x48, 0x58, 0xc2}, text: "vaddps zmm0,zmm0,zmm2"},
        {bytes: [U8]{0x62, 0xf1, 0x7c, 0x4a, 0x58, 0x41, 0x01}, text: "vaddps zmm0{{k2}},zmm0,ZMMWORD PTR [rcx+0x40]"},
        {bytes: [U8]{0xd9, 0xc9}, text: "fxch st(1)"},
        {bytes: [U8]{0xde, 0xc1}, text: "faddp st(1),st"},
        {bytes: [U8]{0x8d, 0x74, 0x26, 0x00}, text: "lea esi,[rsi+riz*1+0x0]"},
    }
    loop item in cases {
        insn: x64_decode(item.bytes, 0, 0) ?? panic("truncated: {item.text}")
        assert_eq(x64_insn_text(insn), item.text)
        assert_eq(insn.length, item.bytes.len())
    }
}

#Test("a relative branch and a rip-relative operand say what they reach") {
    jump: x64_decode([U8]{0xe8, 0xfb, 0xff, 0xff, 0xff}, 0, 0x401000) ?? panic("call")
    assert(jump.flow == X64Flow.Call)
    assert_eq(jump.reach, 0x401000)
    assert_eq(x64_insn_text(jump), "call 0x401000")
    assert_eq(jump.field, 1)
    assert_eq(jump.width, 4)
    load: x64_decode([U8]{0x48, 0x8d, 0x3d, 0x00, 0x01, 0, 0}, 0, 0x2000) ?? panic("lea")
    assert(load.reaches)
    assert_eq(load.reach, 0x2107)
    assert_eq(load.rip, 3)
    cond: x64_decode([U8]{0x0f, 0x85, 0, 0, 0, 0}, 0, 0) ?? panic("jne")
    assert(cond.flow == X64Flow.Cond)
    assert_eq(cond.cond, 5)
    assert((x64_decode([U8]{0xff, 0x24, 0xc5, 0, 0, 0, 0}, 0, 0) ?? panic("jmp")).indirect)
}

#Test("bytes that start no instruction decode as one (bad) byte, and the end of the bytes as None") {
    bad: x64_decode([U8]{0x06, 0x90}, 0, 0) ?? panic("bad")
    assert(bad.invalid)
    assert_eq(bad.length, 1)
    assert_eq(x64_insn_text(bad), "(bad)")
    assert(x64_decode([U8]{0x48, 0x8b}, 0, 0) == None)
    assert(x64_decode([U8]{0xe8, 0, 0}, 0, 0) == None)
    // An EVEX map 5 opcode no row names keeps its length.
    shape: x64_decode([U8]{0x62, 0xf5, 0x7c, 0x48, 0x58, 0xc2}, 0, 0) ?? panic("map 5")
    assert(!shape.named && !shape.invalid)
    assert_eq(shape.length, 6)
}
