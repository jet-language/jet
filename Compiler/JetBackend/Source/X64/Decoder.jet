// x86-64 decoder: the one reader of machine code that jet debug and jet perf
// show. X64_DECODE_TABLE names the user-mode instruction forms of the legacy
// one-byte, 0F, 0F 38 and 0F 3A maps (x87 included) and of the VEX and EVEX
// maps. x64_decode reads one instruction with it, spells it as
// `objdump -M intel` does, and reports what the debugger's placer moves: its
// length, its rip-relative field and its relative branch. Bytes that start
// no instruction decode as one byte, "(bad)". The encoder (Encoder.jet) and
// the template assembler (InlineAsm.jet) do not read the table;
// Compiler/JetBackend/Tests/X64Decode.jet decodes the bytes they write back
// to their own names.
use jet_foundation.[build_time_refused]

// How an instruction leaves: on to the next (Plain), by a jmp, a call, a
// jcc, a loop or jrcxz (Loop, whose rel8 has no long form), a return, or
// not at all (Stop: ud2, ud1, ud0, hlt).
X64Flow: enum {
    Plain,
    Jump,
    Call,
    Cond,
    Loop,
    Return,
    Stop,
}

// One decoded instruction: its length; whether a table form named it
// (`named`), and whether its bytes start no instruction at all (`invalid`:
// one byte, "(bad)"); its mnemonic with any prefixes it shows ("lock
// cmpxchg", "rep stos") and its operands as objdump writes them; the
// offset of its rip-relative displacement (-1: none); the offset and width
// of its relative branch's field (-1 and 0: none); how it leaves; a jcc's
// condition (X64_COND_NAMES); whether it jumps or calls through a register
// or memory; and, when `reaches`, the address its relative branch or
// rip-relative operand reaches.
X64Insn: struct {
    length: Int,
    named: Bool,
    invalid: Bool,
    mnemonic: String,
    operands: [String],
    rip: Int,
    field: Int,
    width: Int,
    flow: X64Flow,
    cond: Int,
    indirect: Bool,
    reaches: Bool,
    reach: Int,
}

// One row of X64_DECODE_TABLE for one opcode: the map (`space`, see
// x64_decode_spaces) and opcode it names, the conditions it holds under (-1:
// any) and the mnemonic and operand codes it names the instruction with.
X64DecodeRow: struct {
    space: Int,
    opcode: Int,
    prefix: Int{-1},
    reg: Int{-1},
    mode: Int{-1},
    modrm: Int{-1},
    w: Int{-1},
    l: Int{-1},
    size: Int{-1},
    b: Int{-1},
    addr: Int{-1},
    element: Int{0},
    rounding: Int{0},
    name: String,
    operands: [String],
}

// What x64_decode has read of one instruction so far.
X64Decoding: struct {
    from: Int,
    at: Int,
    address: Int,
    // The legacy prefix bytes in order, and what they say.
    prefixes: [Int],
    lock: Bool{false},
    rep: Int{0},
    opsize: Bool{false},
    addr32: Bool{false},
    segment: Int{0},
    // The REX byte (0: none) and a REX a later prefix voids.
    rex: Int{0},
    voided_rex: Int{0},
    w: Int{0},
    r: Int{0},
    x: Int{0},
    b: Int{0},
    // 0 legacy, 1 VEX, 2 EVEX, and their fields.
    kind: Int{0},
    vvvv: Int{0},
    l: Int{0},
    pp: Int{0},
    r2: Int{0},
    v2: Int{0},
    aaa: Int{0},
    z: Int{0},
    bcst: Int{0},
    space: Int{0},
    opcode: Int{0},
    // The ModRM byte (-1: none), its SIB and displacement.
    modrm: Int{-1},
    mod: Int{0},
    reg: Int{0},
    rm: Int{0},
    sib: Bool{false},
    scale: Int{0},
    index: Int{0},
    base: Int{0},
    disp: Int{0},
    rip: Int{-1},
    immediates: [Int],
}

// The maps a row's space word names: L0 the one-byte map, L1 0F, L2 0F 38,
// L3 0F 3A (spaces 0-3); V1-V3 the VEX maps 0F, 0F 38, 0F 3A (4-6); E1-E3
// the EVEX ones (7-9); VE1-VE3 both. EVEX maps 5 and 6 are spaces 10 and 11,
// which no row names.
X64_DECODE_SPACES: 12

X64_DECODE_KEYS: 3072

// The x86-64 instruction forms, one per line:
//   SPACE OPCODE[-LAST] [CONDITIONS] | NAME [OPERANDS]
// See x64_decode_rows for the conditions and x64_decode_operand for the
// operand codes. An opcode range gives the row to each opcode of it, and
// `{cc}` in NAME is the condition (X64_COND_NAMES) at the opcode's offset
// from the first. The first row that holds names the instruction.
X64_DECODE_TABLE: #run { ```# The one-byte map.
L0 00 | add Eb,Gb
L0 01 | add Ev,Gv
L0 02 | add Gb,Eb
L0 03 | add Gv,Ev
L0 04 | add AL,Ib
L0 05 | add rAX,Iz
L0 08 | or Eb,Gb
L0 09 | or Ev,Gv
L0 0a | or Gb,Eb
L0 0b | or Gv,Ev
L0 0c | or AL,Ib
L0 0d | or rAX,Iz
L0 10 | adc Eb,Gb
L0 11 | adc Ev,Gv
L0 12 | adc Gb,Eb
L0 13 | adc Gv,Ev
L0 14 | adc AL,Ib
L0 15 | adc rAX,Iz
L0 18 | sbb Eb,Gb
L0 19 | sbb Ev,Gv
L0 1a | sbb Gb,Eb
L0 1b | sbb Gv,Ev
L0 1c | sbb AL,Ib
L0 1d | sbb rAX,Iz
L0 20 | and Eb,Gb
L0 21 | and Ev,Gv
L0 22 | and Gb,Eb
L0 23 | and Gv,Ev
L0 24 | and AL,Ib
L0 25 | and rAX,Iz
L0 28 | sub Eb,Gb
L0 29 | sub Ev,Gv
