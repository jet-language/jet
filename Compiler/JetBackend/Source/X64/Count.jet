// How many elements of a run equal one value, as an asm leaf's body
// (JetIR OptReduce.jet): x64_count_code's bytes run in place, with
//
//   rdi  the address of element 0 of the List's data
//   rsi  the run's first index, as a raw word
//   rdx  the index it ends before, as a raw word
//   rcx  the total so far, as a raw word
//   r8   the value, as a raw word (its low byte for one-byte elements)
//
// and the result in rax: the total plus the number of elements first..<end
// whose bits equal the value's, as an inline Int, or X64_INT_SUM_DECLINED
// (2^62, never an inline Int). The elements are one byte (`stride` 1) or
// one word (`stride` 8). The leaf declines unless 0 <= first < end, end
// and the total are inline Ints, the result is one, and, with `exact`, the
// value is one too: an exact Int equals an inline Int exactly when their
// words are equal, as the runtime keeps every value in the inline range
// inline (Int.jet int_pack), so a big element never matches. An exact
// value against one-byte elements is an Int they are widened to, so it
// must also lie in 0..=255, where its low byte stands for it. The count is
// at most end - first, so total + count cannot wrap 64 bits before the
// result's inline test. On a decline the leaf has written no memory and
// changed nothing the caller sees.
//
// SSE2 (every x86-64 has it). Bytes: xmm7 holds the value in every byte;
// pcmpeqb leaves -1 in a matching byte, so psubb counts matches in the
// sixteen bytes of xmm1, 64 bytes per step and at most 63 steps (252
// matches per byte) before psadbw sums them into the two words of xmm2.
// Words: pcmpeqd compares the halves, pshufd 0xb1 swaps them and pand
// leaves -1 in a word whose halves both match, which psubq counts in xmm2,
// four words per step. The last elements go one at a time. Only
// caller-saved registers are written (rax, rcx, rdx, rsi, rdi, r8-r11 and
// xmm0-xmm7), rsp is untouched, and the code falls through its last byte.

fn x64_count_code(stride: Int, exact: Bool) -> [U8] Never! {
    code := [U8]{}
    declines := [Int]{}
    x64_mov_ri(&code, X64_RAX, X64_INT_SUM_DECLINED)
    // 0 <= first < end, end and the total (and an exact value) inline.
    x64_test_rr(&code, X64_RSI, X64_RSI)
    &declines.push(x64_jcc_rel32(&code, X64Cond.S))
    x64_alu_rr(&code, X64Alu.Cmp, X64_RSI, X64_RDX)
    &declines.push(x64_jcc_rel32(&code, X64Cond.GE))
    x64_int_sum_test(&code, X64_RDX, &declines)
    x64_int_sum_test(&code, X64_RCX, &declines)
    if exact && stride == 8 -> x64_int_sum_test(&code, X64_R8, &declines)
    if exact && stride == 1 {
        // An exact value against bytes widened to Int: 0..=255, as an
        // unsigned word (a negative or big value is above 255).
        x64_alu_ri(&code, X64Alu.Cmp, X64_R8, 255)
        &declines.push(x64_jcc_rel32(&code, X64Cond.A))
    }
    // r9 the elements left, rdi the first one, r10 the scalar count, xmm7
    // the value in every element of a vector, xmm2 the vector counts.
    x64_mov_rr(&code, X64_R9, X64_RDX)
    x64_alu_rr(&code, X64Alu.Sub, X64_R9, X64_RSI)
    if stride == 8 -> x64_shift_ri(&code, X64Shift.Shl, X64_RSI, 3)
    x64_alu_rr(&code, X64Alu.Add, X64_RDI, X64_RSI)
    if stride == 1 {
        // movzx r8, r8b; r10 = r8 * 0x0101010101010101.
        x64_movzx_r8(&code, X64_R8, X64_R8)
        x64_mov_ri(&code, X64_R10, 72340172838076673)
        x64_imul_rr(&code, X64_R10, X64_R8)
        x64_movq_to_xmm(&code, false, 7, X64_R10)
    } else {
        x64_movq_to_xmm(&code, false, 7, X64_R8)
    }
    // punpcklqdq xmm7, xmm7; pxor xmm2, xmm2; pxor xmm6, xmm6.
    x64_sse(&code, 0x66, false, 0x6c, 7, 7)
    x64_sse(&code, 0x66, false, 0xef, 2, 2)
    x64_sse(&code, 0x66, false, 0xef, 6, 6)
    x64_mov_ri(&code, X64_R10, 0)
    if stride == 1 -> x64_count_bytes(&code) else -> x64_count_words(&code)
    // The last elements, one at a time: r10 += (element == value).
    x64_test_rr(&code, X64_R9, X64_R9)
    to_fold :: x64_jcc_rel32(&code, X64Cond.E)
    single :: code.len()
    if stride == 1 -> x64_load_u8(&code, X64_RDX, X64_RDI, 0) else -> x64_load(&code, X64_RDX, X64_RDI, 0)
    x64_alu_rr(&code, X64Alu.Cmp, X64_RDX, X64_R8)
    x64_setcc(&code, X64Cond.E, X64_R11)
    x64_movzx_r8(&code, X64_R11, X64_R11)
    x64_alu_rr(&code, X64Alu.Add, X64_R10, X64_R11)
    x64_alu_ri(&code, X64Alu.Add, X64_RDI, stride)
    x64_alu_ri(&code, X64Alu.Sub, X64_R9, 1)
    more :: x64_jcc_rel32(&code, X64Cond.NE)
    x64_patch_rel32(&code, more, single)
    // The two vector counts into r10, r10 into the total.
    x64_patch_rel32(&code, to_fold, code.len())
    x64_movq_from_xmm(&code, false, X64_RDX, 2)
    x64_alu_rr(&code, X64Alu.Add, X64_R10, X64_RDX)
    x64_sse(&code, 0x66, false, 0x70, 2, 2)
    x64_byte(&code, 0xee)
    x64_movq_from_xmm(&code, false, X64_RDX, 2)
    x64_alu_rr(&code, X64Alu.Add, X64_R10, X64_RDX)
    x64_alu_rr(&code, X64Alu.Add, X64_RCX, X64_R10)
    x64_int_sum_test(&code, X64_RCX, &declines)
    x64_mov_rr(&code, X64_RAX, X64_RCX)
    end :: code.len()
    loop site in declines -> x64_patch_rel32(&code, site, end)
    code
}

// Whole 64-byte blocks: up to 63 at a time into xmm1's byte counts, then
// psadbw (against the zeros of xmm6) adds them into xmm2's two words.
// Leaves r9 the bytes left (under 64) and rdi the first of them.
fn x64_count_bytes(code: &[U8]) Never! {
    outer :: code.len()
    x64_alu_ri(&code, X64Alu.Cmp, X64_R9, 64)
    to_tail :: x64_jcc_rel32(&code, X64Cond.L)
    // rsi = min(r9 / 64, 63) blocks; r9 -= rsi * 64.
    x64_mov_rr(&code, X64_RSI, X64_R9)
    x64_shift_ri(&code, X64Shift.Shr, X64_RSI, 6)
    x64_mov_ri(&code, X64_RDX, 63)
    x64_alu_rr(&code, X64Alu.Cmp, X64_RSI, X64_RDX)
    x64_cmov_rr(&code, X64Cond.A, X64_RSI, X64_RDX)
    x64_mov_rr(&code, X64_RDX, X64_RSI)
    x64_shift_ri(&code, X64Shift.Shl, X64_RDX, 6)
    x64_alu_rr(&code, X64Alu.Sub, X64_R9, X64_RDX)
    // pxor xmm1, xmm1
    x64_sse(&code, 0x66, false, 0xef, 1, 1)
    block :: code.len()
    loop part in 0..<4 {
        xmm :: if part == 0 -> 0 else -> part + 2
        x64_vector_load(&code, xmm, X64_RDI, part * 16)
        // pcmpeqb xmm, xmm7; psubb xmm1, xmm.
        x64_sse(&code, 0x66, false, 0x74, xmm, 7)
        x64_sse(&code, 0x66, false, 0xf8, 1, xmm)
    }
    x64_alu_ri(&code, X64Alu.Add, X64_RDI, 64)
    x64_alu_ri(&code, X64Alu.Sub, X64_RSI, 1)
    again :: x64_jcc_rel32(&code, X64Cond.NE)
    x64_patch_rel32(&code, again, block)
    // psadbw xmm1, xmm6; paddq xmm2, xmm1.
    x64_sse(&code, 0x66, false, 0xf6, 1, 6)
    x64_sse(&code, 0x66, false, 0xd4, 2, 1)
    back :: x64_jmp_rel32(&code)
    x64_patch_rel32(&code, back, outer)
    x64_patch_rel32(&code, to_tail, code.len())
}

// Four words per step into xmm2's two word counts. Leaves r9 the words
// left (under four) and rdi the first of them.
fn x64_count_words(code: &[U8]) Never! {
    x64_alu_ri(&code, X64Alu.Sub, X64_R9, 4)
    to_tail :: x64_jcc_rel32(&code, X64Cond.L)
    body :: code.len()
    x64_vector_load(&code, 0, X64_RDI, 0)
    x64_vector_load(&code, 1, X64_RDI, 16)
    // pcmpeqd x, xmm7; pshufd y, x, 0xb1; pand x, y; psubq xmm2, x.
    x64_sse(&code, 0x66, false, 0x76, 0, 7)
    x64_sse(&code, 0x66, false, 0x76, 1, 7)
    x64_sse(&code, 0x66, false, 0x70, 3, 0)
    x64_byte(&code, 0xb1)
    x64_sse(&code, 0x66, false, 0x70, 4, 1)
    x64_byte(&code, 0xb1)
    x64_sse(&code, 0x66, false, 0xdb, 0, 3)
    x64_sse(&code, 0x66, false, 0xdb, 1, 4)
    x64_sse(&code, 0x66, false, 0xfb, 2, 0)
    x64_sse(&code, 0x66, false, 0xfb, 2, 1)
    x64_alu_ri(&code, X64Alu.Add, X64_RDI, 32)
    x64_alu_ri(&code, X64Alu.Sub, X64_R9, 4)
    again :: x64_jcc_rel32(&code, X64Cond.GE)
    x64_patch_rel32(&code, again, body)
    x64_patch_rel32(&code, to_tail, code.len())
    x64_alu_ri(&code, X64Alu.Add, X64_R9, 4)
}
