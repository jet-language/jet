// Linear-scan register allocation (Poletto and Sarkar) for x86-64 System V.
//
// Blocks are laid out in function order and every block start, instruction and
// terminator gets one position. Block-level liveness extends each value's
// interval over the blocks it is live through, so one conservative interval
// per value covers loops. Intervals are scanned by start; an interval expires
// strictly before the next one starts, so an instruction's result never shares
// a register with its operands. A value live across a call may only take a
// callee-saved register. When no register is free, the interval that ends last
// is spilled to its own frame slot for its whole life.
//
// rax, r10 and r11 are never allocated: instruction selection uses them as the
// result, operand and parallel-move scratch registers. rsp and rbp hold the frame.

pub enum X64Loc {
    Reg(reg: Int)
    Stack(slot: Int)
}

pub struct X64Allocation {
    pub locations: [X64Loc]
    pub spill_slots: Int
    // Callee-saved registers the function writes, in push order.
    pub callee_saved: [Int]
}

X64_CALLER_SAVED_POOL :: prep { [Int]{1, 2, 6, 7, 8, 9} }
X64_CALLEE_SAVED_POOL :: prep { [Int]{3, 12, 13, 14, 15} }

pub fn x64_inst_is_call(inst: LIRInst) -> Bool Never! {
    if inst == {
        .Call(_, _, _, _) -> true
        .Drop(_) -> true
        else -> false
    }
}

// Sparse per-block value sets: block b's live-in values are
// `live_in[in_starts[b]..<in_starts[b + 1]]`, each value once (likewise
// live-out). Sets are built as lists with epoch-stamped scratch marks, so
// work and memory follow the live values instead of blocks x values bit
// matrices. Stored flat: the struct holds no nested lists.
struct X64Liveness {
    pub live_in: [Int]
    pub in_starts: [Int]
    pub live_out: [Int]
    pub out_starts: [Int]
}

fn x64_falses(count: Int) -> [Bool] Never! {
    row := [Bool]{}
    loop _ in 0..<count -> &row.push(false)
    row
}

fn x64_liveness(function: LIRFunction) -> X64Liveness Never! {
    count :: function.values.len()
    // First row per block id, so each CFG edge resolves without a block scan.
    block_rows := [Int:Int]{}
    loop (index, block) in function.blocks {
        if block_rows.get(block.id.value) == None -> &block_rows.add(block.id.value, index).drop("checked absent above")
    }
    // marks[value] == epoch means "in the set being built"; a new epoch clears
    // every set at once.
    defined_marks := [Int]{}
    seen_marks := [Int]{}
    loop _ in 0..<count {
        &defined_marks.push(0)
        &seen_marks.push(0)
    }
    epoch := 0
    gens := [[Int]]{}
    kills := [[Int]]{}
    successors := [[Int]]{}
    loop block in function.blocks {
        epoch += 1
        defined := [Int]{}
        gen := [Int]{}
        loop param in block.params {
            defined_marks[param.value] = epoch
            &defined.push(param.value)
        }
        loop inst in block.insts {
            loop used in lir_inst_uses(inst) {
                if defined_marks[used.value] != epoch && seen_marks[used.value] != epoch {
                    seen_marks[used.value] = epoch
                    &gen.push(used.value)
                }
            }
            if lir_inst_def(inst) == .Val(dst) {
                defined_marks[dst.value] = epoch
                &defined.push(dst.value)
            }
        }
        loop used in lir_terminator_uses(block.terminator) {
            if defined_marks[used.value] != epoch && seen_marks[used.value] != epoch {
                seen_marks[used.value] = epoch
                &gen.push(used.value)
            }
        }
        &gens.push(gen)
        &kills.push(defined)
        targets := [Int]{}
        loop target in lir_terminator_targets(block.terminator) -> &targets.push(block_rows.get(target.block.value) ?? -1)
        &successors.push(targets)
    }
    live_in := [[Int]]{}
    live_out := [[Int]]{}
    predecessors := [[Int]]{}
    loop _ in function.blocks {
        &live_in.push([Int]{})
        &live_out.push([Int]{})
        &predecessors.push([Int]{})
    }
    loop (index, targets) in successors {
        loop successor in targets -> &predecessors[successor].push(index)
    }
    // A worklist (first every block in reverse order, then the predecessors
    // of each block whose live-in set changed) reaches the same least fixed
    // point as whole-CFG sweeps, without re-sweeping unchanged blocks. Sets
    // only grow from empty, so a live-in set changed exactly when it grew.
    pending := [Int]{}
    queued := x64_falses(function.blocks.len())
    seed := function.blocks.len() - 1
    loop seed >= 0 {
        &pending.push(seed)
        queued[seed] = true
        seed -= 1
    }
    cursor := 0
    loop cursor < pending.len() {
        block_index := pending[cursor]
        cursor += 1
        queued[block_index] = false
        epoch += 1
        out := [Int]{}
        loop successor in successors[block_index] {
            loop value in live_in[successor] {
                if seen_marks[value] != epoch {
                    seen_marks[value] = epoch
                    &out.push(value)
                }
            }
        }
        loop value in kills[block_index] -> defined_marks[value] = epoch
        epoch += 1
        incoming := [Int]{}
        loop value in gens[block_index] {
            seen_marks[value] = epoch
            &incoming.push(value)
        }
        loop value in out {
            if defined_marks[value] != epoch - 1 && seen_marks[value] != epoch {
                seen_marks[value] = epoch
                &incoming.push(value)
            }
        }
        grew :: incoming.len() != live_in[block_index].len()
        live_out[block_index] = out
        if grew {
            live_in[block_index] = incoming
            loop predecessor in predecessors[block_index] {
                if !queued[predecessor] {
                    queued[predecessor] = true
                    &pending.push(predecessor)
                }
            }
        }
    }
    flat_in := [Int]{}
    flat_out := [Int]{}
    in_starts := [Int]{0}
    out_starts := [Int]{0}
    loop row in 0..<function.blocks.len() {
        loop value in live_in[row] -> &flat_in.push(value)
        loop value in live_out[row] -> &flat_out.push(value)
        &in_starts.push(flat_in.len())
        &out_starts.push(flat_out.len())
    }
    X64Liveness{live_in: flat_in, in_starts: in_starts, live_out: flat_out, out_starts: out_starts}
}

fn x64_pool_has(pool: [Int], reg: Int) -> Bool Never! {
    loop candidate in pool { if candidate == reg -> return true }
    false
}

pub fn x64_allocate(function: LIRFunction) -> X64Allocation Never! {
    count :: function.values.len()
    liveness :: x64_liveness(function)
    starts := [Int]{}
    ends := [Int]{}
    loop _ in 0..<count {
        &starts.push(-1)
        &ends.push(-1)
    }
    calls := [Int]{}
    position := 0
    loop (block_index, block) in function.blocks {
        touched := [Int]{}
        loop at in liveness.in_starts[block_index]..<liveness.in_starts[block_index + 1] -> &touched.push(liveness.live_in[at])
        loop param in block.params -> &touched.push(param.value)
        loop value in touched {
            if starts[value] < 0 || position < starts[value] -> starts[value] = position
            if position > ends[value] -> ends[value] = position
        }
        position += 1
        loop inst in block.insts {
            touched = [Int]{}
            loop used in lir_inst_uses(inst) -> &touched.push(used.value)
            if lir_inst_def(inst) == .Val(dst) -> &touched.push(dst.value)
            loop value in touched {
                if starts[value] < 0 || position < starts[value] -> starts[value] = position
                if position > ends[value] -> ends[value] = position
            }
            if x64_inst_is_call(inst) -> &calls.push(position)
            position += 1
        }
        touched = [Int]{}
        loop used in lir_terminator_uses(block.terminator) -> &touched.push(used.value)
        loop at in liveness.out_starts[block_index]..<liveness.out_starts[block_index + 1] -> &touched.push(liveness.live_out[at])
        loop value in touched {
            if starts[value] < 0 || position < starts[value] -> starts[value] = position
            if position > ends[value] -> ends[value] = position
        }
        position += 1
    }

    // calls_below[p] counts call positions below p, so a value crosses a call
    // when one lies strictly between its start and end.
    is_call := x64_falses(position + 1)
    loop call in calls -> is_call[call] = true
    calls_below := [Int]{0}
    loop at in 0..<(position + 1) -> &calls_below.push(if is_call[at] -> calls_below[at] + 1 else -> calls_below[at])
    crosses := [Bool]{}
    loop value in 0..<count {
        &crosses.push(ends[value] > starts[value] + 1 && calls_below[ends[value]] - calls_below[starts[value] + 1] > 0)
    }

    // Values in start order; ties keep value order: a counting sort over the
    // start positions (-1 for an unused value) replaces repeated minimum scans.
    buckets := [[Int]]{}
    loop _ in 0..<(position + 1) -> &buckets.push([Int]{})
    loop value in 0..<count -> &buckets[starts[value] + 1].push(value)
    order := [Int]{}
    loop bucket in buckets {
        loop value in bucket -> &order.push(value)
    }

    registers := [Int]{}
    slots := [Int]{}
    loop _ in 0..<count {
        &registers.push(-1)
        &slots.push(-1)
    }
    owners := [Int]{}
    loop _ in 0..<16 -> &owners.push(-1)
    spill_slots := 0
    active := [Int]{}
    loop value in order {
        kept := [Int]{}
        loop other in active {
            if ends[other] < starts[value] {
                owners[registers[other]] = -1
            } else {
                &kept.push(other)
            }
        }
        active = kept
        pool := [Int]{}
        if !crosses[value] {
            loop reg in X64_CALLER_SAVED_POOL -> &pool.push(reg)
        }
        loop reg in X64_CALLEE_SAVED_POOL -> &pool.push(reg)
        chosen := -1
        loop reg in pool { if chosen < 0 && owners[reg] < 0 -> chosen = reg }
        if chosen >= 0 {
            registers[value] = chosen
            owners[chosen] = value
            &active.push(value)
        } else {
            victim := -1
            loop other in active {
                if x64_pool_has(pool, registers[other]) && (victim < 0 || ends[other] > ends[victim]) -> victim = other
            }
            if victim >= 0 && ends[victim] > ends[value] {
                reg :: ~registers[victim]
                registers[victim] = -1
                slots[victim] = spill_slots
                spill_slots += 1
                kept = [Int]{}
                loop other in active { if other != victim -> &kept.push(other) }
                active = kept
                registers[value] = reg
                owners[reg] = value
                &active.push(value)
            } else {
                slots[value] = spill_slots
                spill_slots += 1
            }
        }
    }

    locations := [X64Loc]{}
    loop value in 0..<count {
        &locations.push(if registers[value] >= 0 -> X64Loc.Reg{reg: registers[value]} else -> X64Loc.Stack{slot: slots[value]})
    }
    callee_saved := [Int]{}
    loop reg in X64_CALLEE_SAVED_POOL {
        used := false
        loop value in 0..<count { if registers[value] == reg -> used = true }
        if used -> &callee_saved.push(reg)
    }
    X64Allocation{locations: locations, spill_slots: spill_slots, callee_saved: callee_saved}
}
