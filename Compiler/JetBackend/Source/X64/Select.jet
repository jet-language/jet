// x86-64 System V instruction selection for LIR, after linear-scan allocation.
//
// Frame: `push rbp; mov rbp, rsp`, then the callee-saved registers the
// allocator used, then `sub rsp` for spill slots and StackSlot storage,
// padded so rsp stays 16-byte aligned at every call. Spill slot k lives at
// [rbp - 8 * (saved + k + 1)]; StackSlot storage lies below the spill slots,
// each at the next multiple of its alignment (rbp is 16-byte aligned after
// the push). Every return restores rsp with `lea rsp, [rbp - 8 * saved]`,
// pops, and returns.
//
// Block parameters are filled by parallel moves on each edge; a conditional
// branch whose taken edge needs moves gets a small edge stub after the
// fall-through path. A comparison whose only use is the block's branch is
// fused into `cmp` + `jcc`. A Const operand (an immediate location, see
// RegAlloc.jet) that fits a sign-extended imm32 is encoded into `add`, `sub`,
// `and`, `or`, `xor`, `imul`, shifts and `cmp`; elsewhere it is materialized
// in the operand's scratch register. Calls into the module and into the compiled
// runtime are `call rel32`, and data and function addresses are
// `lea [rip + disp32]`, each with a relocation the image linker resolves;
// a call through a code pointer is `call r10`. `Div`/`Rem` need rax and rdx,
// and shifts need cl: rdx and rcx are saved around them with push/pop, so the
// allocator may keep values there.

enum X64RelocTarget {
    Function(id: LIRFunctionID)
    Runtime(symbol: String)
    Data(id: LIRDataID)
}

// A rel32 field at `at` (offset in the function's code) that must hold the
// distance from the end of the field to the target.
struct X64Reloc { at: Int, target: X64RelocTarget }

struct X64CompiledFunction {
    id: LIRFunctionID
    name: String
    code: [U8]
    relocs: [X64Reloc]
}

// Debug facts of one compiled function for Image/Dwarf.jet: a line row
// where each run of code from one source line starts, the end of the
// prologue, the call frame instructions of its FDE, and where each debug
// variable lives over which code range.
struct X64LineRow { at: Int, line: Int }

// A register (hardware number) or a frame slot at `offset` from rbp.
enum X64DebugLocation {
    Register(reg: Int)
    Frame(offset: Int)
}

// LIRFunctionDebug.variables[variable] is at `location` for code offsets
// start..<end.
struct X64VariableRange { variable: Int, start: Int, end: Int, location: X64DebugLocation }

struct X64FunctionDebug {
    lines: [X64LineRow]
    body: Int
    cfi: [U8]
    ranges: [X64VariableRange]
}

struct X64CompileResult {
    function: X64CompiledFunction?
    debug: X64FunctionDebug?
    errors: [String]
}

struct X64ModuleResult {
    functions: [X64CompiledFunction]
    debug: [X64FunctionDebug]
    errors: [String]
}

X64_ARGUMENT_REGISTERS :: prep { [Int]{7, 6, 2, 1, 8, 9} }

struct X64BlockFixup { at: Int, block: Int }

struct X64Move { src: X64Loc, dst: X64Loc }

struct X64Emitter {
    code: [U8]
    relocs: [X64Reloc]
    fixups: [X64BlockFixup]
    saved: [Int]
    // LIR value -> rbp displacement of its StackSlot storage (0 for none).
    stack: [Int]
    // Offset of every `ret`, for the CFI of the epilogues.
    returns: [Int]
}

struct X64Frame { stack: [Int], bytes: Int }

// The displacement of every StackSlot's storage, and the bytes `sub rsp`
// reserves below the callee-saved registers for spills and storage.
fn x64_frame(function: LIRFunction, saved: Int, spills: Int) -> X64Frame Never! {
    stack := [Int]{}
    loop _ in function.values -> &stack.push(0)
    depth := 8 * (saved + spills)
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .StackSlot(dst, size, align) {
                depth = depth + size
                if depth % align != 0 -> depth = depth + align - depth % align
                stack[dst.value] = 0 - depth
            }
        }
    }
    if depth % 16 != 0 -> depth = depth + 16 - depth % 16
    X64Frame{stack: stack, bytes: depth - 8 * saved}
}

fn x64_slot_disp(saved: Int, slot: Int) -> Int Never! {
    0 - 8 * (saved + slot + 1)
}

fn x64_load_slot(emitter: &X64Emitter, reg: Int, slot: Int) Never! {
    disp :: x64_slot_disp(emitter.saved.len(), slot)
    x64_load(&emitter.code, reg, X64_RBP, disp)
}

fn x64_store_slot(emitter: &X64Emitter, slot: Int, reg: Int) Never! {
    disp :: x64_slot_disp(emitter.saved.len(), slot)
    x64_store(&emitter.code, X64_RBP, disp, reg)
}

// Float spill words keep F32's high half zero, irrespective of high xmm lanes.
fn x64_finish_float(emitter: &X64Emitter, loc: X64Loc, reg: Int) Never! {
    if loc == .FloatStack(slot, single) {
        disp :: x64_slot_disp(emitter.saved.len(), slot)
        if single {
            x64_mov_ri(&emitter.code, X64_R11, 0)
            x64_store_slot(&emitter, slot, X64_R11)
        }
        x64_float_store(&emitter.code, single, X64_RBP, disp, reg)
    }
}

fn x64_float_result(loc: X64Loc, scratch: Int) -> Int Never! {
    if loc == .Xmm(reg, _) -> return reg
    scratch
}

fn x64_float_operand(emitter: &X64Emitter, loc: X64Loc, single: Bool, scratch: Int) -> Int Never! {
    if loc == .Xmm(reg, _) -> return reg
    if loc == .FloatStack(slot, _) {
        x64_float_load(&emitter.code, single, scratch, X64_RBP, x64_slot_disp(emitter.saved.len(), slot))
    } else {
        reg :: x64_operand(&emitter, loc, X64_R11)
        if single {
            x64_movd_to_xmm(&emitter.code, scratch, reg)
        } else {
            x64_movq_to_xmm(&emitter.code, scratch, reg)
        }
    }
    scratch
}

fn x64_emit_move(emitter: &X64Emitter, src: X64Loc, dst: X64Loc) Never! {
    if src == dst -> return
    if dst == .Xmm(to, single) {
        from :: x64_float_operand(&emitter, src, single, to)
        if from != to -> x64_float_move(&emitter.code, single, to, from)
        return
    }
    if dst == .FloatStack(_, single) {
        from :: x64_float_operand(&emitter, src, single, 0)
        return x64_finish_float(&emitter, dst, from)
    }
    if dst == .Imm(_) -> return
    from :: x64_operand(&emitter, src, X64_R11)
    if dst == {
        .Reg(to) -> { if from != to -> x64_mov_rr(&emitter.code, to, from) }
        .Stack(slot) -> x64_store_slot(&emitter, slot, from)
        else -> {}
    }
}

// Dependency identity ignores precision: xmmN is one physical register even
// when a mixed F32/F64 argument permutation changes its scalar layout.
fn x64_same_place(left: X64Loc, right: X64Loc) -> Bool Never! {
    if left == .Xmm(a, _) && right == .Xmm(b, _) -> return a == b
    if left == .FloatStack(a, _) && right == .FloatStack(b, _) -> return a == b
    left == right
}

// Entry xmm1 may still be an incoming source. Prefer it when unread, otherwise
// take another unread xmm, never a destination already installed by this move
// set. A pending destination is safe: redirected readers delay its write.
fn x64_parallel_float_scratch(moves: [X64Move], pending: [X64Move]) -> Int Never! {
    loop candidate in 0..<16 {
        reg :: if candidate == 0 -> 1 else if candidate == 1 -> 0 else -> candidate
        loc :: X64Loc.Xmm{reg: reg, single: false}
        blocked := false
        loop move in pending { if x64_same_place(move.src, loc) -> blocked = true }
        loop move in moves {
            if x64_same_place(move.dst, loc) {
                unwritten := false
                loop remaining in pending { if x64_same_place(remaining.dst, loc) -> unwritten = true }
                if !unwritten -> blocked = true
            }
        }
        if !blocked -> return reg
    }
    // Allocator excludes xmm0/1; ABI entry reads only xmm0..7. Thus a Float
    // cycle on every selector move set always has an unread scratch.
    panic("x64 parallel Float move set has no unread scratch register")
}

// Emit `moves` as if all sources were read before any destination is written.
// Each move whose destination no pending move still reads goes first; a pure
// cycle is broken in rax (general) or an unread xmm (prefer xmm1).
fn x64_emit_parallel_moves(emitter: &X64Emitter, moves: [X64Move]) Never! {
    pending := [X64Move]{}
    loop move in moves { if move.src != move.dst -> &pending.push(move) }
    loop pending.len() > 0 {
        ready := -1
        loop (index, move) in pending {
            if ready < 0 {
                blocked := false
                loop (other, reader) in pending { if other != index && x64_same_place(reader.src, move.dst) -> blocked = true }
                // ABI xmm1 is also the cycle scratch: install its final value
                // only after all other moves (and therefore cycles) are done.
                if move.dst == .Xmm(reg, _) {
                    if reg == 1 && pending.len() > 1 -> blocked = true
                }
                if !blocked -> ready = index
            }
        }
        if ready >= 0 {
            x64_emit_move(&emitter, pending[ready].src, pending[ready].dst)
            rest := [X64Move]{}
            loop (index, move) in pending { if index != ready -> &rest.push(move) }
            pending = rest
        } else {
            saved := pending[0].dst
            loop move in pending {
                if move.dst == .Xmm(reg, _) { if reg == 1 -> next }
                saved = move.dst
            }
            scratch :: if saved == {
                .Xmm(_, _) | .FloatStack(_, _) -> X64Loc.Xmm{reg: x64_parallel_float_scratch(moves, pending), single: false}
                else -> X64Loc.Reg{reg: X64_RAX}
            }
            x64_emit_move(&emitter, saved, scratch)
            rest := [X64Move]{}
            loop move in pending {
                &rest.push(if x64_same_place(move.src, saved) -> X64Move{src: scratch, dst: move.dst} else -> move)
            }
            pending = rest
        }
    }
}

// The register holding `loc`, loading a spilled value or materializing an
// immediate into `scratch`.
fn x64_operand(emitter: &X64Emitter, loc: X64Loc, scratch: Int) -> Int Never! {
    if loc == {
        .Reg(reg) -> reg
        .Xmm(reg, single) -> {
            x64_float_from_xmm(&emitter.code, if single -> lir_layout_float32() else -> lir_layout_float(), scratch, reg)
            scratch
        }
        .FloatStack(slot, single) -> {
            if single {
                x64_load32(&emitter.code, scratch, X64_RBP, x64_slot_disp(emitter.saved.len(), slot))
            } else {
                x64_load_slot(&emitter, scratch, slot)
            }
            scratch
        }
        .Stack(slot) -> {
            x64_load_slot(&emitter, scratch, slot)
            scratch
        }
        .Imm(value) -> {
            x64_mov_ri(&emitter.code, scratch, value)
            scratch
        }
        .Folded -> panic("x64 selector read an eliminated address definition")
    }
}

// The immediate `loc` holds when an instruction can encode it (sign-extended imm32).
fn x64_imm32(loc: X64Loc) -> Int? {
    if loc == .Imm(value) {
        if x64_fits_i32(value) -> return Val(value)
    }
    None
}

fn x64_result_register(loc: X64Loc, scratch: Int) -> Int Never! {
    if loc == {
        .Reg(reg) -> reg
        else -> scratch
    }
}

fn x64_finish_result(emitter: &X64Emitter, loc: X64Loc, reg: Int) Never! {
    if loc == .Stack(slot) -> x64_store_slot(&emitter, slot, reg)
}

fn x64_condition(condition: LIRCondition) -> X64Cond Never! {
    if condition == {
        .Eq -> X64Cond.E
        .Ne -> X64Cond.NE
        .Lt -> X64Cond.L
        .Le -> X64Cond.LE
        .Gt -> X64Cond.G
        .Ge -> X64Cond.GE
        .ULt -> X64Cond.B
        .ULe -> X64Cond.BE
        .UGt -> X64Cond.A
        .UGe -> X64Cond.AE
    }
}

fn x64_edge_moves(function: LIRFunction, allocation: X64Allocation, target: LIRJumpTarget) -> [X64Move] Never! {
    params :: function.blocks[lir_block_index(function, target.block)].params
    moves := [X64Move]{}
    loop (position, arg) in target.args -> &moves.push(X64Move{src: allocation.locations[arg.value], dst: allocation.locations[params[position].value]})
    moves
}

fn x64_emit_jump(emitter: &X64Emitter, block: Int) Never! {
    at :: x64_jmp_rel32(&emitter.code)
    &emitter.fixups.push(X64BlockFixup{at: at, block: block})
}

// System V argument passing: Integer and Pointer values take rdi, rsi, rdx,
// rcx, r8, r9 and Float values xmm0-xmm7, each in order of appearance; the
// rest go on the stack, first argument at the lowest address. `regs[i]` is the
// register of argument i (a general register, or an xmm index when
// `floats[i]`), or -1 when it is on the stack; `stack` lists the stack
// arguments in order.
struct X64ArgPlan {
    regs: [Int]
    floats: [Bool]
    stack: [Int]
}

fn x64_arg_plan(layouts: [LIRLayout]) -> X64ArgPlan Never! {
    plan := X64ArgPlan{regs: [Int]{}, floats: [Bool]{}, stack: [Int]{}}
    next_general := 0
    next_float := 0
    loop (index, layout) in layouts {
        is_float :: layout.class == .Float
        &plan.floats.push(is_float)
        if is_float && next_float < 8 {
            &plan.regs.push(next_float)
            next_float += 1
        } else {
            if !is_float && next_general < X64_ARGUMENT_REGISTERS.len() {
                &plan.regs.push(X64_ARGUMENT_REGISTERS[next_general])
                next_general += 1
            } else {
                &plan.regs.push(-1)
                &plan.stack.push(index)
            }
        }
    }
    plan
}

fn x64_value_layouts(function: LIRFunction, values: [LIRValueID]) -> [LIRLayout] Never! {
    layouts := [LIRLayout]{}
    loop value in values -> &layouts.push(function.values[value.value].layout)
    layouts
}

fn x64_is_float(function: LIRFunction, value: LIRValueID) -> Bool Never! {
    function.values[value.value].layout.class == .Float
}

fn x64_is_float32(function: LIRFunction, value: LIRValueID) -> Bool Never! {
    function.values[value.value].layout == lir_layout_float32()
}

// A Float's bits, or a Float32's zero-extended bits, out of `xmm` into `dst`.
fn x64_float_from_xmm(code: &[U8], layout: LIRLayout, dst: Int, xmm: Int) Never! {
    if layout == lir_layout_float32() {
        x64_movd_from_xmm(&code, dst, xmm)
    } else {
        x64_movq_from_xmm(&code, dst, xmm)
    }
}

// What a call jumps to: a relocated `call rel32`, or `call r10` through a
// code pointer value (loaded into r10 first: argument setup only uses rax and
// r11 as scratch).
enum X64CallTarget {
    Direct(target: X64RelocTarget)
    Pointer(value: LIRValueID)
}

// Stack arguments are pushed last to first (with 8 bytes of padding first for
// an odd count, keeping rsp 16-byte aligned at the call), then both register
// classes move in parallel. A Float result comes back in xmm0.
fn x64_emit_call(emitter: &X64Emitter, function: LIRFunction, allocation: X64Allocation, target: X64CallTarget, args: [LIRValueID], dst: LIRValueID?) Never! {
    if target == .Pointer(code) {
        reg :: x64_operand(&emitter, allocation.locations[code.value], X64_R10)
        if reg != X64_R10 -> x64_mov_rr(&emitter.code, X64_R10, reg)
    }
    plan :: x64_arg_plan(x64_value_layouts(function, args))
    pad :: plan.stack.len() % 2
    if pad == 1 -> x64_alu_ri(&emitter.code, X64Alu.Sub, X64_RSP, 8)
    index := plan.stack.len() - 1
    loop index >= 0 {
        reg :: x64_operand(&emitter, allocation.locations[args[plan.stack[index]].value], X64_R11)
        x64_push(&emitter.code, reg)
        index -= 1
    }
    moves := [X64Move]{}
    loop (position, arg) in args {
        if plan.regs[position] < 0 -> next
        destination :: if plan.floats[position] -> X64Loc.Xmm{reg: plan.regs[position], single: x64_is_float32(function, arg)} else -> X64Loc.Reg{reg: plan.regs[position]}
        &moves.push(X64Move{src: allocation.locations[arg.value], dst: destination})
    }
    x64_emit_parallel_moves(&emitter, moves)
    if target == {
        .Direct(relocated) -> {
            at :: x64_call_rel32(&emitter.code)
            &emitter.relocs.push(X64Reloc{at: at, target: relocated})
        }
        .Pointer(_) -> x64_call_reg(&emitter.code, X64_R10)
    }
    if plan.stack.len() + pad > 0 -> x64_alu_ri(&emitter.code, X64Alu.Add, X64_RSP, 8 * (plan.stack.len() + pad))
    if dst == .Val(result) {
        layout :: function.values[result.value].layout
        // System V defines only al for a Bool result; LIR Bools are zero-extended words.
        if layout == lir_layout_bool() -> x64_movzx_r8(&emitter.code, X64_RAX, X64_RAX)
        source :: if layout.class == .Float -> X64Loc.Xmm{reg: 0, single: layout == lir_layout_float32()} else -> X64Loc.Reg{reg: X64_RAX}
        x64_emit_move(&emitter, source, allocation.locations[result.value])
    }
}

fn x64_emit_epilogue(emitter: &X64Emitter) Never! {
    x64_lea(&emitter.code, X64_RSP, X64_RBP, 0 - 8 * emitter.saved.len())
    index := emitter.saved.len() - 1
    loop index >= 0 {
        x64_pop(&emitter.code, emitter.saved[index])
        index -= 1
    }
    x64_pop(&emitter.code, X64_RBP)
    &emitter.returns.push(emitter.code.len())
    x64_ret(&emitter.code)
}

fn x64_layout_supported(layout: LIRLayout) -> Bool Never! {
    if layout == lir_layout_float() || layout == lir_layout_float32() -> return true
    if layout.class != .Integer && layout.class != .Pointer -> return false
    layout.size == 1 || layout.size == 2 || layout.size == 4 || layout.size == 8
}

// What this slice of the generator cannot select yet, as messages.
fn x64_selection_gaps(program: LIRModule, function: LIRFunction) -> [String] Never! {
    gaps := [String]{}
    loop value in function.values {
        if !x64_layout_supported(value.layout) -> &gaps.push("{function.name}: v{value.id.value} has a layout the x86-64 generator does not select yet (size {value.layout.size})")
    }
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .Binary(dst, op, _, _) {
                layout :: function.values[dst.value].layout
                // A Bool is a zero-extended 0/1 word in its register and slot,
                // so And/Or/Xor of two Bools is the word operator's result.
                logical :: layout == lir_layout_bool() && (op == .And || op == .Or || op == .Xor)
                if layout.size != 8 && layout != lir_layout_float32() && !logical -> &gaps.push("{function.name}: arithmetic on v{dst.value} is not word-sized")
            }
        }
    }
    gaps
}


// The line row for code starting at `at`: a new row when the line changes,
// replacing a row at the same offset that no code followed.
fn x64_debug_line(lines: &[X64LineRow], at: Int, line: Int) Never! {
    if line <= 0 -> return
    count :: lines.len()
    if count > 0 {
        last :: lines[count - 1]
        if last.line == line -> return
        if last.at == at {
            lines[count - 1] = X64LineRow{at: at, line: line}
            return
        }
    }
    &lines.push(X64LineRow{at: at, line: line})
}

// Compile one linted function. `program` supplies signatures.
fn x64_compile_function(program: LIRModule, function: LIRFunction) -> X64CompileResult Never! {
    gaps :: x64_selection_gaps(program, function)
    if gaps.len() > 0 -> return X64CompileResult{function: None, debug: None, errors: gaps}
    allocation :: x64_allocate(function)
    uses :: allocation.folds.uses
    frame :: x64_frame(function, allocation.callee_saved.len(), allocation.spill_slots)
    emitter := X64Emitter{code: [U8]{}, relocs: [X64Reloc]{}, fixups: [X64BlockFixup]{}, saved: allocation.callee_saved, stack: frame.stack, returns: [Int]{}}

    // The frame and its call frame instructions: after `push rbp` the CFA
    // is rsp + 16 with rbp saved below the return address; after
    // `mov rbp, rsp` it is rbp + 16; callee-saved register k is saved at
    // CFA - 8 * (3 + k) (data alignment -8).
    cfi := [U8]{}
    x64_push(&emitter.code, X64_RBP)
    dwarf_cfa_advance(&cfi, 0, emitter.code.len())
    dwarf_cfa_def_cfa_offset(&cfi, 16)
    dwarf_cfa_offset(&cfi, x64_dwarf_register(X64_RBP), 2)
    cfa_at := emitter.code.len()
    x64_mov_rr(&emitter.code, X64_RBP, X64_RSP)
    dwarf_cfa_advance(&cfi, cfa_at, emitter.code.len())
    dwarf_cfa_def_cfa_register(&cfi, x64_dwarf_register(X64_RBP))
    cfa_at = emitter.code.len()
    loop (index, reg) in allocation.callee_saved {
        x64_push(&emitter.code, reg)
        dwarf_cfa_advance(&cfi, cfa_at, emitter.code.len())
        dwarf_cfa_offset(&cfi, x64_dwarf_register(reg), 3 + index)
        cfa_at = emitter.code.len()
    }
    if frame.bytes > 0 -> x64_alu_ri(&emitter.code, X64Alu.Sub, X64_RSP, frame.bytes)
    // Import both register classes in parallel before normalizing Bools.
    entry_params :: function.blocks[0].params
    plan :: x64_arg_plan(x64_value_layouts(function, entry_params))
    entry_moves := [X64Move]{}
    loop (position, param) in entry_params {
        if plan.regs[position] >= 0 {
            source :: if plan.floats[position] -> X64Loc.Xmm{reg: plan.regs[position], single: x64_is_float32(function, param)} else -> X64Loc.Reg{reg: plan.regs[position]}
            &entry_moves.push(X64Move{src: source, dst: allocation.locations[param.value]})
        }
    }
    x64_emit_parallel_moves(&emitter, entry_moves)
    loop (slot, position) in plan.stack {
        dst :: allocation.locations[entry_params[position].value]
        reg :: x64_result_register(dst, X64_R11)
        layout :: function.values[entry_params[position].value].layout
        if layout.class == .Float {
            xmm :: x64_float_result(dst, 0)
            x64_float_load(&emitter.code, layout == lir_layout_float32(), xmm, X64_RBP, 16 + 8 * slot)
            x64_finish_float(&emitter, dst, xmm)
            next
        }
        if layout == lir_layout_bool() {
            x64_load_u8(&emitter.code, reg, X64_RBP, 16 + 8 * slot)
        } else {
            x64_load(&emitter.code, reg, X64_RBP, 16 + 8 * slot)
        }
        x64_finish_result(&emitter, dst, reg)
    }
    // Only the low byte belongs to an incoming Bool. Normalize after every
    // parallel/Float/stack import so no pending source register is destroyed.
    loop param in entry_params {
        if function.values[param.value].layout != lir_layout_bool() -> next
        dst :: allocation.locations[param.value]
        if dst == {
            .Reg(reg) -> x64_movzx_r8(&emitter.code, reg, reg)
            .Stack(slot) -> {
                x64_load_u8(&emitter.code, X64_R11, X64_RBP, x64_slot_disp(emitter.saved.len(), slot))
                x64_store_slot(&emitter, slot, X64_R11)
            }
            // Parameters are never Const results.
            else -> {}
        }
    }

    // The prologue ends where the entry block starts; the line table marks
    // it with the function's own line until a body line replaces it.
    body :: emitter.code.len()
    lines := [X64LineRow]{}
    if function.debug.line > 0 {
        &lines.push(X64LineRow{at: 0, line: function.debug.line})
        &lines.push(X64LineRow{at: body, line: function.debug.line})
    }
    // Code offset of every allocation position (block start, instruction,
    // terminator; then the end), and whether a value an interval starts
    // there is defined by the code at that position.
    positions := [Int]{}
    defining := [Bool]{}
    block_offsets := [Int]{}
    loop (block_index, block) in function.blocks {
        &block_offsets.push(emitter.code.len())
        &positions.push(emitter.code.len())
        &defining.push(false)
        located :: block.lines.len() == block.insts.len() + 1
        fused := false
        if block.terminator == .Branch(condition, _, _) {
            if block.insts.len() > 0 {
                if block.insts[block.insts.len() - 1] == .Compare(dst, _, left, _) -> fused = dst == condition && uses[dst.value] == 1 && !x64_is_float(function, left)
            }
        }
        loop (inst_index, inst) in block.insts {
            &positions.push(emitter.code.len())
            &defining.push(true)
            if located -> x64_debug_line(&lines, emitter.code.len(), block.lines[inst_index])
            if !(fused && inst_index == block.insts.len() - 1) -> x64_select_inst(&emitter, function, allocation, inst)
        }
        &positions.push(emitter.code.len())
        &defining.push(false)
        if located -> x64_debug_line(&lines, emitter.code.len(), block.lines[block.insts.len()])
        x64_select_terminator(&emitter, function, allocation, block, block_index, fused)
    }
    &positions.push(emitter.code.len())
    loop fixup in emitter.fixups -> x64_patch_rel32(&emitter.code, fixup.at, block_offsets[fixup.block])
    // Each epilogue's `ret` runs after `pop rbp`: the CFA is rsp + 8 there.
    loop at in emitter.returns {
        dwarf_cfa_advance(&cfi, cfa_at, at)
        dwarf_cfa_remember_state(&cfi)
        dwarf_cfa_def_cfa(&cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_advance(&cfi, at, at + 1)
        dwarf_cfa_restore_state(&cfi)
        cfa_at = at + 1
    }
    debug :: X64FunctionDebug{lines: lines, body: body, cfi: cfi, ranges: x64_variable_ranges(function, allocation, positions, defining)}
    X64CompileResult{
        function: Val(X64CompiledFunction{id: function.id, name: function.name, code: emitter.code, relocs: emitter.relocs}),
        debug: Val(debug),
        errors: [String]{},
    }
}

// Where each debug binding's value lives: its location over the code of its
// interval, from after its definition (or its block's start, for a block
// parameter) through its last position. A value bound twice to one
// variable yields one range.
fn x64_variable_ranges(function: LIRFunction, allocation: X64Allocation, positions: [Int], defining: [Bool]) -> [X64VariableRange] Never! {
    ranges := [X64VariableRange]{}
    seen := [Int:Bool]{}
    count :: function.values.len()
    loop binding in function.debug.bindings {
        value :: binding.value.value
        first :: allocation.starts[value]
        if first < 0 -> next
        key :: binding.variable * count + value
        if seen.get(key) != None -> next
        &seen.add(key, true).drop("checked absent above")
        start :: if defining[first] -> positions[first + 1] else -> positions[first]
        end :: positions[allocation.ends[value] + 1]
        if start >= end -> next
        location :: if allocation.locations[value] == {
            .Reg(reg) -> X64DebugLocation.Register{reg: reg}
            .Xmm(reg, _) -> X64DebugLocation.Register{reg: 16 + reg}
            .Stack(slot) | .FloatStack(slot, _) -> X64DebugLocation.Frame{offset: x64_slot_disp(allocation.callee_saved.len(), slot)}
            .Imm(_) | .Folded -> { next }
        }
        &ranges.push(X64VariableRange{variable: binding.variable, start: start, end: end, location: location})
    }
    ranges
}

// Ordered IEEE comparison of Float (or, `single`, Float32) xmm operands into
// the Bool `reg`. ucomisd/ucomiss set ZF, PF and CF together when either side
// is NaN: `a`/`ae` on the operands ordered greater-first are false then, Eq
// also needs PF clear and Ne is true on PF.
fn x64_float_compare(emitter: &X64Emitter, condition: LIRCondition, single: Bool, left: Int, right: Int, reg: Int) Never! {
    first :: if condition == .Lt || condition == .Le -> right else -> left
    second :: if condition == .Lt || condition == .Le -> left else -> right
    if single {
        x64_ucomiss(&emitter.code, first, second)
    } else {
        x64_ucomisd(&emitter.code, first, second)
    }
    cond :: if condition == {
        .Lt | .Gt -> X64Cond.A
        .Le | .Ge -> X64Cond.AE
        .Eq -> X64Cond.E
        .Ne -> X64Cond.NE
        // LIR lint rejects unsigned conditions on Float operands.
        .ULt | .ULe | .UGt | .UGe -> X64Cond.A
    }
    x64_setcc(&emitter.code, cond, reg)
    x64_movzx_r8(&emitter.code, reg, reg)
    if condition == .Eq || condition == .Ne {
        x64_setcc(&emitter.code, if condition == .Eq -> X64Cond.NP else -> X64Cond.P, X64_R11)
        x64_movzx_r8(&emitter.code, X64_R11, X64_R11)
        x64_alu_rr(&emitter.code, if condition == .Eq -> X64Alu.And else -> X64Alu.Or, reg, X64_R11)
    }
}

fn x64_shift_kind(op: LIRBinaryOp) -> X64Shift Never! {
    if op == .Shl -> return X64Shift.Shl
    if op == .UShr -> return X64Shift.Shr
    X64Shift.Sar
}

fn x64_commutes(op: LIRBinaryOp) -> Bool Never! {
    op == .Add || op == .UAdd || op == .Mul || op == .UMul || op == .And || op == .Or || op == .Xor
}

// The condition that holds for `right <cond'> left` exactly when `left <cond> right` does.
fn x64_mirror(condition: LIRCondition) -> LIRCondition Never! {
    if condition == {
        .Lt -> LIRCondition.Gt
        .Gt -> LIRCondition.Lt
        .Le -> LIRCondition.Ge
        .Ge -> LIRCondition.Le
        .ULt -> LIRCondition.UGt
        .UGt -> LIRCondition.ULt
        .ULe -> LIRCondition.UGe
        .UGe -> LIRCondition.ULe
        else -> condition
    }
}

// `cmp` of two integer or pointer words, with an imm32 operand encoded in
// the instruction (a left immediate swaps the operands and mirrors the
// condition); returns the condition code that is set when `left <condition> right`.
fn x64_emit_compare(emitter: &X64Emitter, locations: [X64Loc], condition: LIRCondition, left: LIRValueID, right: LIRValueID) -> X64Cond Never! {
    if x64_imm32(locations[right.value]) == .Val(imm) {
        left_reg :: x64_operand(&emitter, locations[left.value], X64_R10)
        x64_alu_ri(&emitter.code, X64Alu.Cmp, left_reg, imm)
        return x64_condition(condition)
    }
    if x64_imm32(locations[left.value]) == .Val(imm) {
        right_reg :: x64_operand(&emitter, locations[right.value], X64_R11)
        x64_alu_ri(&emitter.code, X64Alu.Cmp, right_reg, imm)
        return x64_condition(x64_mirror(condition))
    }
    left_reg :: x64_operand(&emitter, locations[left.value], X64_R10)
    right_reg :: x64_operand(&emitter, locations[right.value], X64_R11)
    x64_alu_rr(&emitter.code, X64Alu.Cmp, left_reg, right_reg)
    x64_condition(condition)
}

// Integer `dst = left op right` with an imm32 operand encoded in the
// instruction: the right one, or the left one of a commutative operator.
// Shift counts are taken modulo 64, as `shl/shr/sar r, cl` takes them.
// Returns false (emitting nothing) when no operand is such an immediate or
// the operator has no immediate form (division).
fn x64_select_binary_imm(emitter: &X64Emitter, locations: [X64Loc], dst: LIRValueID, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> Bool Never! {
    source := left
    imm := 0
    if x64_imm32(locations[right.value]) == .Val(value) {
        imm = value
    } else {
        if !x64_commutes(op) -> return false
        if x64_imm32(locations[left.value]) == .Val(value) {
            imm = value
            source = right
        } else {
            return false
        }
    }
    if op == .Div || op == .Rem || op == .UDiv || op == .URem -> return false
    source_reg :: x64_operand(&emitter, locations[source.value], X64_R10)
    reg :: x64_result_register(locations[dst.value], X64_RAX)
    if op == .Mul || op == .UMul {
        x64_imul_rri(&emitter.code, reg, source_reg, imm)
    } else {
        if reg != source_reg -> x64_mov_rr(&emitter.code, reg, source_reg)
        if op == {
            .Add | .UAdd -> x64_alu_ri(&emitter.code, X64Alu.Add, reg, imm)
            .Sub | .USub -> x64_alu_ri(&emitter.code, X64Alu.Sub, reg, imm)
            .And -> x64_alu_ri(&emitter.code, X64Alu.And, reg, imm)
            .Or -> x64_alu_ri(&emitter.code, X64Alu.Or, reg, imm)
            .Xor -> x64_alu_ri(&emitter.code, X64Alu.Xor, reg, imm)
            else -> x64_shift_ri(&emitter.code, x64_shift_kind(op), reg, imm.bit_and(63))
        }
    }
    x64_finish_result(&emitter, locations[dst.value], reg)
    true
}

struct X64SelectedAddress {
    base: Int
    index: Int
    scale: Int
    disp: Int
}

fn x64_select_address(emitter: &X64Emitter, locations: [X64Loc], address: X64Address) -> X64SelectedAddress Never! {
    base :: x64_operand(&emitter, locations[address.base.value], X64_R10)
    index :: if address.index == .Val(value) -> x64_operand(&emitter, locations[value.value], X64_R11) else -> -1
    X64SelectedAddress{base: base, index: index, scale: address.scale, disp: address.disp}
}

fn x64_memory_address(folds: X64AddressFolds, base: LIRValueID, offset: Int) -> X64Address Never! {
    if folds.addresses[base.value] == .Val(address) -> return X64Address{base: address.base, index: address.index, scale: address.scale, disp: address.disp + offset}
    X64Address{base: base, index: None, scale: 1, disp: offset}
}

fn x64_select_lea(emitter: &X64Emitter, locations: [X64Loc], dst: LIRValueID, address: X64Address) Never! {
    selected :: x64_select_address(&emitter, locations, address)
    reg :: x64_result_register(locations[dst.value], X64_RAX)
    if selected.index < 0 && reg == selected.base {
        if selected.disp != 0 -> x64_alu_ri(&emitter.code, .Add, reg, selected.disp)
    } else {
        x64_lea_indexed(&emitter.code, reg, selected.base, selected.index, selected.scale, selected.disp)
    }
    x64_finish_result(&emitter, locations[dst.value], reg)
}

fn x64_select_inst(emitter: &X64Emitter, function: LIRFunction, allocation: X64Allocation, inst: LIRInst) Never! {
    locations :: allocation.locations
    folds :: allocation.folds
    if lir_inst_def(inst) == .Val(dst) && folds.skipped[dst.value] -> return
    if inst == {
        .InlineAsm(dst, args, regs, result, code) -> {
            // Read all operands before overwriting any bound register.
            loop arg in args {
                reg :: x64_operand(&emitter, locations[arg.value], X64_RAX)
                x64_push(&emitter.code, reg)
            }
            i := args.len() - 1
            loop i >= 0 {
                x64_pop(&emitter.code, regs[i])
                i -= 1
            }
            loop byte in code -> &emitter.code.push(byte)
            if dst == .Val(output) -> x64_emit_move(&emitter, X64Loc.Reg{reg: result}, locations[output.value])
        }
        // The allocator gives every Const result its immediate as location (RegAlloc.jet).
        .Const(_, _) -> {}
        .Binary(dst, op, left, right) -> {
            if folds.addresses[dst.value] == .Val(address) -> return x64_select_lea(&emitter, locations, dst, address)
            if x64_is_float(function, dst) {
                single :: x64_is_float32(function, dst)
                left_reg :: x64_float_operand(&emitter, locations[left.value], single, 0)
                right_reg := x64_float_operand(&emitter, locations[right.value], single, 1)
                reg :: x64_float_result(locations[dst.value], 0)
                // Preserve arithmetic operand order, including NaN payloads.
                if reg == right_reg && reg != left_reg {
                    x64_float_move(&emitter.code, single, 1, right_reg)
                    right_reg = 1
                }
                if reg != left_reg -> x64_float_move(&emitter.code, single, reg, left_reg)
                if op == .Xor {
                    x64_float_xor(&emitter.code, single, reg, right_reg)
                } else {
                    float_op :: if op == {
                        .Add -> X64FloatOp.Add
                        .Sub -> X64FloatOp.Sub
                        .Mul -> X64FloatOp.Mul
                        else -> X64FloatOp.Div
                    }
                    x64_float_op(&emitter.code, float_op, single, reg, right_reg)
                }
                return x64_finish_float(&emitter, locations[dst.value], reg)
            }
            if x64_select_binary_imm(&emitter, locations, dst, op, left, right) -> return
            left_reg :: x64_operand(&emitter, locations[left.value], X64_R10)
            right_reg :: x64_operand(&emitter, locations[right.value], X64_R11)
            if op == .Div || op == .Rem || op == .UDiv || op == .URem || op == .Shl || op == .Shr || op == .UShr {
                // Work in rax with the right operand in r11, so rdx and rcx can be saved first.
                x64_mov_rr(&emitter.code, X64_RAX, left_reg)
                if right_reg != X64_R11 -> x64_mov_rr(&emitter.code, X64_R11, right_reg)
                if op == .Div || op == .Rem || op == .UDiv || op == .URem {
                    x64_push(&emitter.code, X64_RDX)
                    if op == .UDiv || op == .URem {
                        x64_alu_rr(&emitter.code, X64Alu.Xor, X64_RDX, X64_RDX)
                        x64_div(&emitter.code, X64_R11)
                    } else {
                        x64_cqo(&emitter.code)
                        x64_idiv(&emitter.code, X64_R11)
                    }
                    if op == .Rem || op == .URem -> x64_mov_rr(&emitter.code, X64_RAX, X64_RDX)
                    x64_pop(&emitter.code, X64_RDX)
                } else {
                    x64_push(&emitter.code, X64_RCX)
                    x64_mov_rr(&emitter.code, X64_RCX, X64_R11)
                    x64_shift_cl(&emitter.code, x64_shift_kind(op), X64_RAX)
                    x64_pop(&emitter.code, X64_RCX)
                }
                return x64_emit_move(&emitter, X64Loc.Reg{reg: X64_RAX}, locations[dst.value])
            }
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            // The allocator lets a commutative result reuse its dying right
            // operand's register (x64_share_candidates): swap so it is the source.
            first := left_reg
            second := right_reg
            if reg == right_reg && reg != left_reg && x64_commutes(op) {
                first = right_reg
                second = left_reg
            }
            if reg != first -> x64_mov_rr(&emitter.code, reg, first)
            if op == {
                .Add | .UAdd -> x64_alu_rr(&emitter.code, X64Alu.Add, reg, second)
                .Sub | .USub -> x64_alu_rr(&emitter.code, X64Alu.Sub, reg, second)
                .Mul | .UMul -> x64_imul_rr(&emitter.code, reg, second)
                .And -> x64_alu_rr(&emitter.code, X64Alu.And, reg, second)
                .Or -> x64_alu_rr(&emitter.code, X64Alu.Or, reg, second)
                .Xor -> x64_alu_rr(&emitter.code, X64Alu.Xor, reg, second)
                else -> {}
            }
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .Compare(dst, condition, left, right) -> {
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            if x64_is_float(function, left) {
                left_reg :: x64_float_operand(&emitter, locations[left.value], x64_is_float32(function, left), 0)
                right_reg :: x64_float_operand(&emitter, locations[right.value], x64_is_float32(function, left), 1)
                x64_float_compare(&emitter, condition, x64_is_float32(function, left), left_reg, right_reg, reg)
                return x64_finish_result(&emitter, locations[dst.value], reg)
            }
            cond :: x64_emit_compare(&emitter, locations, condition, left, right)
            x64_setcc(&emitter.code, cond, reg)
            x64_movzx_r8(&emitter.code, reg, reg)
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .Convert(dst, src) -> {
            to :: function.values[dst.value].layout
            if to.class == .Float {
                reg :: x64_float_result(locations[dst.value], 0)
                if x64_is_float(function, src) {
                    source_single :: x64_is_float32(function, src)
                    src_reg :: x64_float_operand(&emitter, locations[src.value], source_single, 0)
                    if to == function.values[src.value].layout {
                        if reg != src_reg -> x64_float_move(&emitter.code, source_single, reg, src_reg)
                    } else if to == lir_layout_float32() {
                        x64_cvtsd2ss(&emitter.code, reg, src_reg)
                    } else {
                        x64_cvtss2sd(&emitter.code, reg, src_reg)
                    }
                } else {
                    src_reg :: x64_operand(&emitter, locations[src.value], X64_R10)
                    if to == lir_layout_float32() {
                        x64_cvtsi2ss(&emitter.code, reg, src_reg)
                    } else {
                        x64_cvtsi2sd(&emitter.code, reg, src_reg)
                    }
                }
                x64_finish_float(&emitter, locations[dst.value], reg)
            } else if !x64_is_float(function, src) {
                src_reg :: x64_operand(&emitter, locations[src.value], X64_R10)
                reg :: x64_result_register(locations[dst.value], X64_RAX)
                from :: function.values[src.value].layout.size
                x64_integer_width(&emitter.code, reg, src_reg, if from < to.size -> from else -> to.size)
                x64_finish_result(&emitter, locations[dst.value], reg)
            } else {
                src_reg :: x64_float_operand(&emitter, locations[src.value], x64_is_float32(function, src), 0)
                reg :: x64_result_register(locations[dst.value], X64_RAX)
                if x64_is_float32(function, src) {
                    x64_cvttss2si(&emitter.code, reg, src_reg)
                } else {
                    x64_cvttsd2si(&emitter.code, reg, src_reg)
                }
                x64_finish_result(&emitter, locations[dst.value], reg)
            }
        }
        .Move(dst, src) -> x64_emit_move(&emitter, locations[src.value], locations[dst.value])
        .Reown(dst, src) -> x64_emit_move(&emitter, locations[src.value], locations[dst.value])
        .Copy(dst, src) -> x64_emit_move(&emitter, locations[src.value], locations[dst.value])
        .Bitcast(dst, src) -> {
            x64_emit_move(&emitter, locations[src.value], locations[dst.value])
        }
        .Call(dst, _, callee, args) -> {
            target :: if callee == {
                .Function(id) -> X64CallTarget.Direct{target: X64RelocTarget.Function{id: id}}
                .Runtime(symbol) -> X64CallTarget.Direct{target: X64RelocTarget.Runtime{symbol: symbol}}
                .Value(code) -> X64CallTarget.Pointer{value: code}
            }
            x64_emit_call(&emitter, function, allocation, target, args, dst)
        }
        .Drop(value) -> {
            if function.values[value.value].drop == {
                .Runtime(symbol) -> x64_emit_call(&emitter, function, allocation, X64CallTarget.Direct{target: X64RelocTarget.Runtime{symbol: symbol}}, [LIRValueID]{value}, None)
                .Function(id) -> x64_emit_call(&emitter, function, allocation, X64CallTarget.Direct{target: X64RelocTarget.Function{id: id}}, [LIRValueID]{value}, None)
                .Trivial -> {}
            }
        }
        .Overflows(dst, op, left, right) -> {
            left_reg :: x64_operand(&emitter, locations[left.value], X64_R10)
            right_reg :: x64_operand(&emitter, locations[right.value], X64_R11)
            // MUL's carry tests unsigned range; IMUL's overflow tests signed
            // range (FixedArithmetic.rs:318-326). Preserve allocated rdx.
            if op == .UMul && right_reg != X64_R11 -> x64_mov_rr(&emitter.code, X64_R11, right_reg)
            x64_mov_rr(&emitter.code, X64_RAX, left_reg)
            if op == .UMul -> x64_push(&emitter.code, X64_RDX)
            if op == {
                .Add | .UAdd -> x64_alu_rr(&emitter.code, X64Alu.Add, X64_RAX, right_reg)
                .Sub | .USub -> x64_alu_rr(&emitter.code, X64Alu.Sub, X64_RAX, right_reg)
                .UMul -> x64_mul(&emitter.code, X64_R11)
                else -> x64_imul_rr(&emitter.code, X64_RAX, right_reg)
            }
            // POP does not alter MUL's carry flag.
            if op == .UMul -> x64_pop(&emitter.code, X64_RDX)
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            unsigned :: op == .UAdd || op == .USub || op == .UMul
            x64_setcc(&emitter.code, if unsigned -> X64Cond.B else -> X64Cond.O, reg)
            x64_movzx_r8(&emitter.code, reg, reg)
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .Load(dst, base, offset) -> {
            address :: x64_select_address(&emitter, locations, x64_memory_address(folds, base, offset))
            if x64_is_float(function, dst) {
                reg :: x64_float_result(locations[dst.value], 0)
                x64_float_load_indexed(&emitter.code, x64_is_float32(function, dst), reg, address.base, address.index, address.scale, address.disp)
                return x64_finish_float(&emitter, locations[dst.value], reg)
            }
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            x64_load_indexed(&emitter.code, reg, address.base, address.index, address.scale, address.disp, function.values[dst.value].layout.size)
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .PointerAdd(dst, base, offset) -> {
            address := X64Address{base: base, index: Val(offset), scale: 1, disp: 0}
            if x64_imm32(locations[offset.value]) == .Val(imm) {
                address.index = None
                address.disp = imm
            }
            x64_select_lea(&emitter, locations, dst, address)
        }
        .Store(base, offset, value) -> {
            base_reg :: x64_operand(&emitter, locations[base.value], X64_R10)
            value_reg :: x64_operand(&emitter, locations[value.value], X64_R11)
            if function.values[value.value].layout.size == 1 {
                x64_store_u8(&emitter.code, base_reg, offset, value_reg)
            } else if function.values[value.value].layout.size == 2 {
                x64_store_u16(&emitter.code, base_reg, offset, value_reg)
            } else if function.values[value.value].layout.size == 4 {
                x64_store_u32(&emitter.code, base_reg, offset, value_reg)
            } else {
                x64_store(&emitter.code, base_reg, offset, value_reg)
            }
            stored_reg :: x64_operand(&emitter, locations[value.value], X64_RAX)
            address :: x64_select_address(&emitter, locations, x64_memory_address(folds, base, offset))
            x64_store_indexed(&emitter.code, address.base, address.index, address.scale, address.disp, stored_reg, function.values[value.value].layout.size)
        }
        .StackSlot(dst, _, _) -> {
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            x64_lea(&emitter.code, reg, X64_RBP, emitter.stack[dst.value])
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .DataAddress(dst, data) -> {
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            at :: x64_lea_rip(&emitter.code, reg)
            &emitter.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Data{id: data}})
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
        .FunctionAddress(dst, target) -> {
            reg :: x64_result_register(locations[dst.value], X64_RAX)
            at :: x64_lea_rip(&emitter.code, reg)
            &emitter.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Function{id: target}})
            x64_finish_result(&emitter, locations[dst.value], reg)
        }
    }
}

fn x64_select_terminator(emitter: &X64Emitter, function: LIRFunction, allocation: X64Allocation, block: LIRBlock, block_index: Int, fused: Bool) Never! {
    if block.terminator == {
        .Return(value) -> {
            if value == .Val(returned) {
                destination :: if x64_is_float(function, returned) -> X64Loc.Xmm{reg: 0, single: x64_is_float32(function, returned)} else -> X64Loc.Reg{reg: X64_RAX}
                x64_emit_move(&emitter, allocation.locations[returned.value], destination)
            }
            x64_emit_epilogue(&emitter)
        }
        .Jump(target) -> {
            x64_emit_parallel_moves(&emitter, x64_edge_moves(function, allocation, target))
            target_index :: lir_block_index(function, target.block)
            if target_index != block_index + 1 -> x64_emit_jump(&emitter, target_index)
        }
        .Branch(condition, then_target, else_target) -> {
            cond := X64Cond.NE
            if fused {
                if block.insts[block.insts.len() - 1] == .Compare(_, compare, left, right) -> cond = x64_emit_compare(&emitter, allocation.locations, compare, left, right)
            } else {
                reg :: x64_operand(&emitter, allocation.locations[condition.value], X64_R10)
                x64_test_rr(&emitter.code, reg, reg)
            }
            then_index :: lir_block_index(function, then_target.block)
            else_index :: lir_block_index(function, else_target.block)
            then_moves :: x64_edge_moves(function, allocation, then_target)
            stub_at := -1
            if then_moves.len() == 0 {
                at :: x64_jcc_rel32(&emitter.code, cond)
                &emitter.fixups.push(X64BlockFixup{at: at, block: then_index})
            } else {
                stub_at = x64_jcc_rel32(&emitter.code, cond)
            }
            x64_emit_parallel_moves(&emitter, x64_edge_moves(function, allocation, else_target))
            if stub_at >= 0 || else_index != block_index + 1 -> x64_emit_jump(&emitter, else_index)
            if stub_at >= 0 {
                stub :: emitter.code.len()
                x64_patch_rel32(&emitter.code, stub_at, stub)
                x64_emit_parallel_moves(&emitter, then_moves)
                if then_index != block_index + 1 -> x64_emit_jump(&emitter, then_index)
            }
        }
        .Unreachable -> x64_ud2(&emitter.code)
    }
}

// Lint, then compile every function. Lint issues stop compilation.
fn x64_compile_module(program: LIRModule) -> X64ModuleResult Never! {
    errors := [String]{}
    loop issue in lir_lint_module(program) -> &errors.push("LIR lint: {issue.function} b{issue.block}: {issue.message}")
    if errors.len() > 0 -> return X64ModuleResult{functions: [X64CompiledFunction]{}, debug: [X64FunctionDebug]{}, errors: errors}
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    loop function in program.functions {
        result :: x64_compile_function(program, function)
        loop error in result.errors -> &errors.push(error)
        if result.function == .Val(compiled) {
            &functions.push(compiled)
            &debug.push(result.debug ?? X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}})
        }
    }
    X64ModuleResult{functions: functions, debug: debug, errors: errors}
}
