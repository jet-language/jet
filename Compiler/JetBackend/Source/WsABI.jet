// Native websocket carriers, not Rust layout.
WS_ERROR_BYTES: I64{24}
WS_ERROR_TAG: I64{0}
WS_ERROR_LIMIT: I64{8}
WS_ERROR_OPERATION: I64{16}
WS_MESSAGE_BYTES: I64{24}
WS_MESSAGE_TAG: I64{0}
WS_MESSAGE_PAYLOAD: I64{8}
WS_MESSAGE_REASON: I64{16}
// WsError tags in the runtime's variant order.
WS_ERROR_INVALID_URL: I64{0}
WS_ERROR_INVALID_HANDSHAKE: I64{1}
WS_ERROR_PROTOCOL: I64{2}
WS_ERROR_MESSAGE_TOO_LARGE: I64{3}
WS_ERROR_IO: I64{4}
WS_ERROR_TIMEOUT: I64{5}
WS_ERROR_CLOSED: I64{6}
WS_ERROR_CANCELLED: I64{7}
WS_ERROR_UNSUPPORTED_TARGET: I64{8}
// WsConn80: the Stream64 it owns, whether it is the client (which masks the
// frames it sends), closed, the per-operation I/O timeout, the read buffer
// (bytes start..length of capacity are received and not yet decoded), the
// write lock that keeps each frame whole, and whether it joined the live
// transport hub.
WS_CONN_BYTES: I64{80}
WS_CONN_STREAM: I64{0}
WS_CONN_CLIENT: I64{8}
WS_CONN_CLOSED: I64{16}
WS_CONN_TIMEOUT_MS: I64{24}
WS_CONN_BUFFER: I64{32}
WS_CONN_LENGTH: I64{40}
WS_CONN_CAPACITY: I64{48}
WS_CONN_START: I64{56}
WS_CONN_WRITE_LOCK: I64{64}
WS_CONN_HUB: I64{72}
