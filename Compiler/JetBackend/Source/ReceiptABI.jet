// Native-private receipt storage, never Rust struct layout.
// DbPool.rs:13-28 / ServiceAuthority.rs:131-141 declaration order.
// Every numeric receipt field is Rust i64 (not engine's usize counters).
// CAbiRoutes.rs:10198-10277,10351-10412 borrow exact Int/Text inputs.
DB_RECEIPT_BYTES :: I64{104}
DB_RECEIPT_LIFECYCLE :: I64{0}
DB_RECEIPT_MAX :: I64{8}
DB_RECEIPT_AVAILABLE :: I64{16}
DB_RECEIPT_LEASED :: I64{24}
DB_RECEIPT_OPENING :: I64{32}
DB_RECEIPT_READY :: I64{40}
DB_RECEIPT_ACQUIRES :: I64{48}
DB_RECEIPT_RELEASES :: I64{56}
DB_RECEIPT_TIMEOUTS :: I64{64}
DB_RECEIPT_OPEN_FAILURES :: I64{72}
DB_RECEIPT_UNHEALTHY :: I64{80}
DB_RECEIPT_REPLACEMENTS :: I64{88}
DB_RECEIPT_REPLACEMENT_FAILURES :: I64{96}
DELIVERY_RECEIPT_BYTES :: I64{80}
DELIVERY_RECEIPT_ID :: I64{0}
DELIVERY_RECEIPT_STATE :: I64{8}
DELIVERY_RECEIPT_ATTEMPTS :: I64{16}
DELIVERY_RECEIPT_RETENTION :: I64{24}
DELIVERY_RECEIPT_DEADLINE :: I64{32}
DELIVERY_RECEIPT_KEY :: I64{40}
DELIVERY_RECEIPT_DUPLICATE :: I64{48}
DELIVERY_RECEIPT_AUTHORITY :: I64{56}
DELIVERY_RECEIPT_GENERATION :: I64{64}
DELIVERY_RECEIPT_SIGNATURE :: I64{72}
// Standalone lifecycle/state use the shared EncodingABI 8-byte enum owner.
