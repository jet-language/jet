// Native-private receipt storage, never Rust struct layout.
// DbPool.rs:13-28 / ServiceAuthority.rs:131-141 declaration order.
// Every numeric receipt field is Rust i64 (not engine's usize counters).
// CAbiRoutes.rs:10198-10277,10351-10412 borrow exact Int/Text inputs.
DB_RECEIPT_BYTES :: prep { I64{104} }
DB_RECEIPT_LIFECYCLE :: prep { I64{0} }
DB_RECEIPT_MAX :: prep { I64{8} }
DB_RECEIPT_AVAILABLE :: prep { I64{16} }
DB_RECEIPT_LEASED :: prep { I64{24} }
DB_RECEIPT_OPENING :: prep { I64{32} }
DB_RECEIPT_READY :: prep { I64{40} }
DB_RECEIPT_ACQUIRES :: prep { I64{48} }
DB_RECEIPT_RELEASES :: prep { I64{56} }
DB_RECEIPT_TIMEOUTS :: prep { I64{64} }
DB_RECEIPT_OPEN_FAILURES :: prep { I64{72} }
DB_RECEIPT_UNHEALTHY :: prep { I64{80} }
DB_RECEIPT_REPLACEMENTS :: prep { I64{88} }
DB_RECEIPT_REPLACEMENT_FAILURES :: prep { I64{96} }
DELIVERY_RECEIPT_BYTES :: prep { I64{80} }
DELIVERY_RECEIPT_ID :: prep { I64{0} }
DELIVERY_RECEIPT_STATE :: prep { I64{8} }
DELIVERY_RECEIPT_ATTEMPTS :: prep { I64{16} }
DELIVERY_RECEIPT_RETENTION :: prep { I64{24} }
DELIVERY_RECEIPT_DEADLINE :: prep { I64{32} }
DELIVERY_RECEIPT_KEY :: prep { I64{40} }
DELIVERY_RECEIPT_DUPLICATE :: prep { I64{48} }
DELIVERY_RECEIPT_AUTHORITY :: prep { I64{56} }
DELIVERY_RECEIPT_GENERATION :: prep { I64{64} }
DELIVERY_RECEIPT_SIGNATURE :: prep { I64{72} }
// Standalone lifecycle/state use the shared EncodingABI 8-byte enum owner.
