// Native-private receipt storage, never Rust struct layout.
// DbPool.rs:13-28 / ServiceAuthority.rs:131-141 declaration order.
// Every numeric receipt field is Rust i64 (not engine's usize counters).
// CAbiRoutes.rs:10198-10277,10351-10412 borrow exact Int/Text inputs.
DB_RECEIPT_BYTES :: comptime { I64{104} }
DB_RECEIPT_LIFECYCLE :: comptime { I64{0} }
DB_RECEIPT_MAX :: comptime { I64{8} }
DB_RECEIPT_AVAILABLE :: comptime { I64{16} }
DB_RECEIPT_LEASED :: comptime { I64{24} }
DB_RECEIPT_OPENING :: comptime { I64{32} }
DB_RECEIPT_READY :: comptime { I64{40} }
DB_RECEIPT_ACQUIRES :: comptime { I64{48} }
DB_RECEIPT_RELEASES :: comptime { I64{56} }
DB_RECEIPT_TIMEOUTS :: comptime { I64{64} }
DB_RECEIPT_OPEN_FAILURES :: comptime { I64{72} }
DB_RECEIPT_UNHEALTHY :: comptime { I64{80} }
DB_RECEIPT_REPLACEMENTS :: comptime { I64{88} }
DB_RECEIPT_REPLACEMENT_FAILURES :: comptime { I64{96} }
DELIVERY_RECEIPT_BYTES :: comptime { I64{80} }
DELIVERY_RECEIPT_ID :: comptime { I64{0} }
DELIVERY_RECEIPT_STATE :: comptime { I64{8} }
DELIVERY_RECEIPT_ATTEMPTS :: comptime { I64{16} }
DELIVERY_RECEIPT_RETENTION :: comptime { I64{24} }
DELIVERY_RECEIPT_DEADLINE :: comptime { I64{32} }
DELIVERY_RECEIPT_KEY :: comptime { I64{40} }
DELIVERY_RECEIPT_DUPLICATE :: comptime { I64{48} }
DELIVERY_RECEIPT_AUTHORITY :: comptime { I64{56} }
DELIVERY_RECEIPT_GENERATION :: comptime { I64{64} }
DELIVERY_RECEIPT_SIGNATURE :: comptime { I64{72} }
// Standalone lifecycle/state use the shared EncodingABI 8-byte enum owner.
