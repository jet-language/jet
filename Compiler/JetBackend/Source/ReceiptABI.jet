// Native-private receipt storage, never Rust struct layout. Every numeric
// receipt field is Rust i64 (not engine's usize counters). The Rust original
// borrow exact Int/Text inputs.
DELIVERY_RECEIPT_BYTES :: I64{80}
DELIVERY_RECEIPT_ID :: I64{0}
DELIVERY_RECEIPT_STATE :: I64{8}
DELIVERY_RECEIPT_ATTEMPTS :: I64{16}
DELIVERY_RECEIPT_RETENTION :: I64{24}
DELIVERY_RECEIPT_DEADLINE :: I64{32}
DELIVERY_RECEIPT_KEY :: I64{40}
DELIVERY_RECEIPT_DUPLICATE :: I64{48}
DELIVERY_RECEIPT_AUTHORITY :: I64{56}
DELIVERY_RECEIPT_GENERATION :: I64{64}
DELIVERY_RECEIPT_SIGNATURE :: I64{72}
// Standalone lifecycle/state use the shared EncodingABI 8-byte enum owner.
