// Private runtime carrier for the registry-owned service TaskOutcome handle.
// CAbiRoutes.rs:11381-11409: Finished/Panicked/Cancelled/DeadlineBlown = 0/1/2/3.
TASK_OUTCOME_BYTES :: I64{16}
TASK_OUTCOME_TAG :: I64{0}
TASK_OUTCOME_REASON :: I64{8}
TASK_OUTCOME_FINISHED :: I64{0}
TASK_OUTCOME_PANICKED :: I64{1}
TASK_OUTCOME_CANCELLED :: I64{2}
TASK_OUTCOME_DEADLINE :: I64{3}
