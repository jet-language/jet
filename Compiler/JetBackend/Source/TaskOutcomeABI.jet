// Private runtime carrier for the registry-owned service TaskOutcome handle.
// CAbiRoutes.rs:11381-11409: Finished/Panicked/Cancelled/DeadlineBlown = 0/1/2/3.
TASK_OUTCOME_BYTES :: comptime { I64{16} }
TASK_OUTCOME_TAG :: comptime { I64{0} }
TASK_OUTCOME_REASON :: comptime { I64{8} }
TASK_OUTCOME_FINISHED :: comptime { I64{0} }
TASK_OUTCOME_PANICKED :: comptime { I64{1} }
TASK_OUTCOME_CANCELLED :: comptime { I64{2} }
TASK_OUTCOME_DEADLINE :: comptime { I64{3} }
