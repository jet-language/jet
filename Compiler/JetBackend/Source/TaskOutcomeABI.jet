// Private runtime carrier for the registry-owned service TaskOutcome handle.
// CAbiRoutes.rs:11381-11409: Finished/Panicked/Cancelled/DeadlineBlown = 0/1/2/3.
TASK_OUTCOME_BYTES :: prep { I64{16} }
TASK_OUTCOME_TAG :: prep { I64{0} }
TASK_OUTCOME_REASON :: prep { I64{8} }
TASK_OUTCOME_FINISHED :: prep { I64{0} }
TASK_OUTCOME_PANICKED :: prep { I64{1} }
TASK_OUTCOME_CANCELLED :: prep { I64{2} }
TASK_OUTCOME_DEADLINE :: prep { I64{3} }
