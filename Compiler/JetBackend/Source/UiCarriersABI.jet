// Canonical native-private UI scalar/record carriers, not Rust or MIR layouts.
// Lower-facing Node/Accessibility/Shortcut layouts reuse the separate UiABI.jet
// precedent (94c3238e1,78f5f6471); do not reinterpret Node storage through these.
UI_CARRIER_SCALAR_BYTES :: comptime { I64{8} }
UI_CARRIER_TERMINAL_SIZE_BYTES :: comptime { I64{16} }
UI_CARRIER_TERMINAL_SIZE_COLS :: comptime { I64{0} } // Rust i64, CommonTypes.rs:37.
UI_CARRIER_TERMINAL_SIZE_ROWS :: comptime { I64{8} } // Rust i64, CommonTypes.rs:38.
// Rust TerminalPolicy owns TerminalSize by value (CommonTypes.rs:57-59).
// Embedded Size@0 is byte-identical to the 16-byte TerminalSize carrier.
// Ctor consumes/frees its input Size once; getter owns a fresh Size allocation.
UI_CARRIER_TERMINAL_POLICY_BYTES :: comptime { I64{24} }
UI_CARRIER_TERMINAL_POLICY_SIZE :: comptime { I64{0} }
UI_CARRIER_TERMINAL_POLICY_MODE :: comptime { I64{16} }
UI_CARRIER_TEXT_WIDTH_BYTES :: comptime { I64{16} }
UI_CARRIER_TEXT_WIDTH_AMBIGUOUS :: comptime { I64{0} }
UI_CARRIER_TEXT_WIDTH_CONTROLS :: comptime { I64{8} }
UI_CARRIER_BROWSER_PROFILE_BYTES :: comptime { I64{16} }
UI_CARRIER_BROWSER_PROFILE_NAME :: comptime { I64{0} }
UI_CARRIER_BROWSER_PROFILE_VERSION :: comptime { I64{8} }
UI_CARRIER_BROWSER_TIMEOUT_BYTES :: comptime { I64{8} }
UI_CARRIER_BROWSER_TIMEOUT_MS :: comptime { I64{0} } // Rust i64, Browser.rs:111.
UI_CARRIER_BROWSER_ERROR_BYTES :: comptime { I64{8} }
UI_CARRIER_BROWSER_ERROR_KIND :: comptime { I64{0} } // Borrowed process-static E4 view, never String-owned.
UI_CARRIER_BROWSER_LOCKED_BYTES :: comptime { I64{48} }
UI_CARRIER_BROWSER_LOCKED_ENGINE :: comptime { I64{0} }
UI_CARRIER_BROWSER_LOCKED_VERSION :: comptime { I64{8} }
UI_CARRIER_BROWSER_LOCKED_BINARY :: comptime { I64{16} }
UI_CARRIER_BROWSER_LOCKED_PROTOCOL :: comptime { I64{24} }
UI_CARRIER_BROWSER_LOCKED_SIZE :: comptime { I64{32} } // Rust i64, Browser.rs:105.
UI_CARRIER_BROWSER_LOCKED_HASH :: comptime { I64{40} }
