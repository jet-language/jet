// Native HAND layouts only; no Rust memory. All align8.
SCALAR_RANGE_BYTES: I64{24}

SCALAR_RANGE_START: I64{0}

SCALAR_RANGE_END: I64{8}

SCALAR_RANGE_EXCLUSIVE: I64{16}

SCALAR_SOLVER_BYTES: I64{24}

SCALAR_SOLVER_SEED: I64{0}

SCALAR_SOLVER_CHECKED: I64{8}

SCALAR_SOLVER_FAILURES: I64{16}

REFLECT_VALUE_BYTES: I64{56}

REFLECT_VALUE_TYPE: I64{0}

REFLECT_VALUE_PATH: I64{8}

REFLECT_VALUE_DISPLAY: I64{16}

REFLECT_VALUE_FIELDS: I64{24}

REFLECT_VALUE_KIND: I64{32}

REFLECT_VALUE_SCALAR: I64{40}

// The Case of a Value whose type is an enum (0 for any other type): the case
// the value held when it was captured, owned by the Value.
REFLECT_VALUE_CASE: I64{48}

REFLECT_SCALAR_NONE: I64{0}

REFLECT_SCALAR_INT: I64{1}

REFLECT_SCALAR_FLOAT: I64{2}

REFLECT_SCALAR_BOOL: I64{3}

REFLECT_SCALAR_CHAR: I64{4}

REFLECT_SCALAR_STRING: I64{5}

REFLECT_FIELD_BYTES: I64{16}

REFLECT_FIELD_NAME: I64{0}

REFLECT_FIELD_VALUE: I64{8}

REFLECT_CASE_BYTES: I64{24}

REFLECT_CASE_NAME: I64{0}

REFLECT_CASE_PATH: I64{8}

REFLECT_CASE_FIELDS: I64{16}

REFLECT_SEQUENCE_STRIDE: I64{8}
