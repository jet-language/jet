// Raw Linux host leaves only. Execution policy and the codec live in Jet.
// socketpair is a private full-duplex control channel; fd 3 in the child is
// also the canonical runtime stop channel, never user stdout/stderr.
// One compiler-process resource word array and mutex. These leaves supply
// storage/serialization only; Jet decides request, restart and lifetime policy.
#[Unsafe("returns the process-lifetime execution resource words; the caller serializes access"), FFI(c)]
fn os_session_state() -> Int {
    """
    #include <stdint.h>
    int64_t os_session_state(void) {
        static int64_t state[14] = {0, -1, 0, -1, -1};
        return (int64_t)state;
    }
    """
}
#[Unsafe("serializes access to this process's private execution resource"), FFI(c)]
fn os_session_lock() {
    """
    #include <pthread.h>
    pthread_mutex_t jet_execution_mutex = PTHREAD_MUTEX_INITIALIZER;
    void os_session_lock(void) { pthread_mutex_lock(&jet_execution_mutex); }
    """
}
#[Unsafe("releases the private execution mutex acquired by this thread"), FFI(c)]
fn os_session_unlock() {
    """
    #include <pthread.h>
    extern pthread_mutex_t jet_execution_mutex;
    void os_session_unlock(void) { pthread_mutex_unlock(&jet_execution_mutex); }
    """
}
#[Unsafe("posix_spawn creates a fresh process, not a forked copy of compiler/runtime locks; paths and output are caller-owned"), FFI(c)]
fn os_session_spawn(executable: Int, runtime: Int, identity: Int, out: Int) -> Int {
    """
    #include <spawn.h>
    #include <sys/socket.h>
    #include <sys/syscall.h>
    #include <unistd.h>
    #include <stdint.h>
    extern char **environ;
    extern long syscall(long, ...);
    int64_t os_session_spawn(int64_t executable, int64_t runtime, int64_t identity, int64_t out) {
        int sockets[2];
        if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets)) return -1;
        int output = syscall(SYS_memfd_create, "jet-execution-stdout", 1);
        int errors = syscall(SYS_memfd_create, "jet-execution-stderr", 1);
        if (output < 0 || errors < 0) {
            if (output >= 0) close(output);
            if (errors >= 0) close(errors);
            close(sockets[0]); close(sockets[1]); return -1;
        }
        posix_spawn_file_actions_t actions;
        int error = posix_spawn_file_actions_init(&actions);
        if (error) { close(output); close(errors); close(sockets[0]); close(sockets[1]); return -error; }
        error = posix_spawn_file_actions_addclose(&actions, sockets[0]);
        if (!error) error = posix_spawn_file_actions_adddup2(&actions, sockets[1], 3);
        if (!error && sockets[1] != 3) error = posix_spawn_file_actions_addclose(&actions, sockets[1]);
        if (!error) error = posix_spawn_file_actions_adddup2(&actions, output, 1);
        if (!error) error = posix_spawn_file_actions_adddup2(&actions, errors, 2);
        if (!error) error = posix_spawn_file_actions_addclose(&actions, output);
        if (!error) error = posix_spawn_file_actions_addclose(&actions, errors);
        char *argv[] = {(char *)executable, "--native-session-host", (char *)runtime, (char *)identity, 0};
        pid_t pid = 0;
        if (!error) error = posix_spawn(&pid, (char *)executable, &actions, 0, argv, environ);
        posix_spawn_file_actions_destroy(&actions);
        close(sockets[1]);
        if (error) { close(output); close(errors); close(sockets[0]); return -error; }
        ((int64_t *)out)[0] = pid;
        ((int64_t *)out)[1] = sockets[0];
        ((int64_t *)out)[3] = output;
        ((int64_t *)out)[4] = errors;
        return 0;
    }
    """
}

#[Unsafe("waits only for this owned child; status points at one writable word"), FFI(c)]
fn os_session_wait(pid: Int, status: Int) -> Int {
    """
    #include <sys/wait.h>
    #include <errno.h>
    #include <stdint.h>
    int64_t os_session_wait(int64_t pid, int64_t status) {
        int code;
        pid_t result;
        do { result = waitpid((pid_t)pid, &code, 0); } while (result < 0 && errno == EINTR);
        if (result < 0) return -errno;
        *(int64_t *)status = WIFSIGNALED(code) ? -WTERMSIG(code) : WEXITSTATUS(code);
        return 0;
    }
    """
}

// MSG_NOSIGNAL prevents a dead child's socket from killing the compiler.
fn os_session_write(fd: Int, address: Int, count: Int) -> Int {
    #Unsafe("sendto borrows the caller-owned readable bytes; MSG_NOSIGNAL is 0x4000 on Linux") {
        return os_syscall(44, fd, address, count, 16384, 0, 0)
    }
}
fn os_session_close(fd: Int) {
    #Unsafe("fd belongs to this private execution host") {
        _ := os_syscall(3, fd, 0, 0, 0, 0, 0)
    }
}

fn x64_session_write_frame(fd: Int, body: String) -> Bool {
    bytes :: body.bytes()
    if bytes.len() > 16777216 -> return false
    x64_session_write_bytes_frame(fd, bytes)
}

// Binary image chunks use the same byte-length framing without any UTF-8
// conversion or hex expansion. The reader supplies each frame's size limit.
fn x64_session_write_bytes_frame(fd: Int, body: [U8]) -> Bool {
    x64_session_write_bytes_range(fd, body, 0, body.len())
}

fn x64_session_write_bytes_range(fd: Int, body: [U8], start: Int, count: Int) -> Bool {
    if start < 0 || count < 0 || start > body.len() || count > body.len() - start -> return false
    prefix :: "{count}\n".bytes()
    buffer :: os_map(prefix.len() + count + 8, OS_PROT_READ + OS_PROT_WRITE)
    if os_failed(buffer) -> return false
    os_copy_in(buffer, prefix)
    os_copy_in_range(buffer + prefix.len(), body, start, count)
    length :: prefix.len() + count
    at := 0
    success := true
    loop at < length {
        written :: os_session_write(fd, buffer + at, length - at)
        if written == -4 -> next
        if written <= 0 {
            success = false
            break
        }
        at += written
    }
    _ := os_unmap(buffer, length + 8)
    success
}

// Caller-owned header scratch (32 bytes) is reused for the entire native value
// stream. Borrowed runtime bytes go straight to the socket, without materializing
// a compiler String/list or allocating one mmap per chunk.
fn x64_session_write_address_frame(fd: Int, address: Int, count: Int, header: Int) -> Bool {
    if count < 0 || count > 65536 -> return false
    value := count
    digits := 0
    loop {
        #Unsafe("header has32 writable bytes; a chunk count has at most5 decimal digits") {
            os_store_byte(header + digits, 48 + value % 10)
        }
        digits += 1
        value /%= 10
        if value == 0 -> break
    }
    loop index in 0..<(digits /% 2) {
        other :: digits - 1 - index
        #Unsafe("both decimal digits are inside the caller-owned header scratch") {
            left :: os_load_byte(header + index)
            right :: os_load_byte(header + other)
            os_store_byte(header + index, right)
            os_store_byte(header + other, left)
        }
    }
    #Unsafe("the newline follows at most5 digits in32 writable header bytes") { os_store_byte(header + digits, 10) }
    if !x64_session_write_address_all(fd, header, digits + 1) -> return false
    x64_session_write_address_all(fd, address, count)
}
fn x64_session_write_address_all(fd: Int, address: Int, count: Int) -> Bool {
    at := 0
    loop at < count {
        written :: os_session_write(fd, address + at, count - at)
        if written == -4 -> next
        if written <= 0 -> return false
        at += written
    }
    true
}

// Read EXACTLY one frame, leaving following frames untouched. JSON frames
// cannot exceed the canonical parser's16MiB item limit.
fn x64_session_read_frame(fd: Int) -> String? {
    bytes :: x64_session_read_bytes_frame(fd, 16777216) ?? return None
    Val(String.from_bytes(bytes) ?? return None)
}

// EOF is a lifecycle event only before a frame begins. A partial prefix,
// oversized body, invalid digit or short body is always a protocol error.
enum X64SessionFrame { Bytes(bytes: [U8]) EOF Malformed }

fn x64_session_read_bytes_frame(fd: Int, max_length: Int) -> [U8]? {
    frame :: x64_session_read_frame_status(fd, max_length)
    if frame == .Bytes(bytes) -> return Val(bytes)
    None
}

fn x64_session_read_frame_status(fd: Int, max_length: Int) -> X64SessionFrame {
    buffer :: os_map(4096, OS_PROT_READ + OS_PROT_WRITE)
    if os_failed(buffer) -> return X64SessionFrame.Malformed
    length := 0
    digits := 0
    valid := true
    eof := false
    loop {
        got :: os_read(fd, buffer, 1)
        if got == -4 -> next
        if got != 1 {
            eof = got == 0 && digits == 0
            valid = false
            break
        }
        byte := 0
        #Unsafe("one byte was read into this owned mapping") { byte = os_load_byte(buffer) }
        if byte == 10 -> break
        if byte < 48 || byte > 57 || digits >= 10 {
            valid = false
            break
        }
        length = length * 10 + byte - 48
        digits += 1
    }
    bytes := [U8]{}
    if digits == 0 || max_length < 0 || length > max_length -> valid = false
    loop valid && bytes.len() < length {
        count := length - bytes.len()
        if count > 4096 -> count = 4096
        got :: os_read(fd, buffer, count)
        if got == -4 -> next
        if got <= 0 {
            valid = false
            break
        }
        loop index in 0..<got {
            byte := 0
            #Unsafe("index is within the bytes just read into this mapping") { byte = os_load_byte(buffer + index) }
            &bytes.push(U8{byte})
        }
    }
    _ := os_unmap(buffer, 4096)
    if eof -> return X64SessionFrame.EOF
    if !valid -> return X64SessionFrame.Malformed
    X64SessionFrame.Bytes{bytes: bytes}
}
