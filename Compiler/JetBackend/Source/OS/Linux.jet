// Linux AT_EMPTY_PATH refers to the held source inode (FileHandles.rs), never
// reopens an old pathname. The borrowed empty path is one stack-local zero.
#[Unsafe("source and directory are live owned descriptors, name is terminated; linkat borrows a stack-local empty path and retains no pointer"), FFI(asm)]
fn os_link_fd_i64(source: I64, directory: I64, name: I64) -> I64 {
    """
    push {source}
    push {directory}
    push {name}
    pop r10
    pop rdx
    pop rdi
    mov rax, 0
    push rax
    mov rsi, rsp
    mov r8, 4096
    mov rax, 265
    syscall
    pop rdx
    mov rax, rax ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx, r8, r10
    """
}

#[Unsafe("ioctl reads one stack-local machine word with the supplied audited request and live fd; it retains no pointer and all pushes are balanced"), FFI(asm)]
fn os_ioctl_word_i64(fd: I64, request: I64, word: I64) -> I64 {
    """
    push {fd}
    push {request}
    push {word}
    pop rdx
    pop rsi
    pop rdi
    push rdx
    mov rdx, rsp
    mov rax, 16
    syscall
    pop rdx
    mov rax, rax ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx
    """
}

// Translate Linux stat144 to the portable 128-byte scalar StatFacts row.
// Offsets: dev0 ino8 mode16 nlink24 uid32 gid40 rdev48 size56;
// atime64/72 mtime80/88 ctime96/104 blocks112 blockSize120.
// Failed syscalls still copy initialized zeros; callers must inspect errno.
#[Unsafe("object is a live fd for fstat or a terminated path for stat/lstat; output lends 128 writable bytes; the initialized stack stat frame never escapes"), FFI(asm)]
fn os_stat_packed_i64(number: I64, object: I64, output: I64) -> I64 {
    """
    push {number}
    push {object}
    push {output}
    pop r8
    pop rdi
    pop rax
    push r8
    mov rdx, 0
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    push rdx
    mov rsi, rsp
    mov qword ptr [rsi + 136], rdx
    syscall
    mov r8, qword ptr [rsi + 144]
    mov rdx, qword ptr [rsi]
    mov qword ptr [r8], rdx
    mov rdx, qword ptr [rsi + 8]
    mov qword ptr [r8 + 8], rdx
    mov rdx, qword ptr [rsi + 24]
    mov qword ptr [r8 + 16], rdx
    mov rdx, qword ptr [rsi + 16]
    mov qword ptr [r8 + 24], rdx
    mov rdx, qword ptr [rsi + 24]
    mov qword ptr [r8 + 32], rdx
    mov rdx, qword ptr [rsi + 32]
    mov qword ptr [r8 + 40], rdx
    mov rdx, qword ptr [rsi + 40]
    mov qword ptr [r8 + 48], rdx
    mov rdx, qword ptr [rsi + 48]
    mov qword ptr [r8 + 56], rdx
    mov rdx, qword ptr [rsi + 72]
    mov qword ptr [r8 + 64], rdx
    mov rdx, qword ptr [rsi + 80]
    mov qword ptr [r8 + 72], rdx
    mov rdx, qword ptr [rsi + 88]
    mov qword ptr [r8 + 80], rdx
    mov rdx, qword ptr [rsi + 96]
    mov qword ptr [r8 + 88], rdx
    mov rdx, qword ptr [rsi + 104]
    mov qword ptr [r8 + 96], rdx
    mov rdx, qword ptr [rsi + 112]
    mov qword ptr [r8 + 104], rdx
    mov rdx, qword ptr [rsi + 64]
    mov qword ptr [r8 + 112], rdx
    mov rdx, qword ptr [rsi + 56]
    mov qword ptr [r8 + 120], rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    mov rax, rax ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx, r8
    """
}

#Unsafe("the audited caller lends the stat scalar row and valid syscall object")
fn os_stat_facts_i64(number: I64, object: I64, output: I64) -> I64 {
    #Unsafe("packed Linux 32-bit fields become independent portable machine words without any allocation") {
        result :: os_stat_packed_i64(number, object, output)
        os_store_i64(wrapping(output + I64{16}), os_load_i64(wrapping(output + I64{16})).bit_and(I64{4294967295}))
        os_store_i64(wrapping(output + I64{32}), (os_load_i64(wrapping(output + I64{32})) >> I64{32}).bit_and(I64{4294967295}))
        os_store_i64(wrapping(output + I64{40}), os_load_i64(wrapping(output + I64{40})).bit_and(I64{4294967295}))
        return result
    }
}

// Lower/Closures.jet:291-315 indirect calls require a closure header and pass
// it as argument zero; a C void(void) entry address is not that representation.
#[Unsafe("calls a checked System V void(void) process entry that remains executable for the entire call"), FFI(asm)]
fn os_call0_unit(address: I64) {
    """
    push {address}
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
    """
}

#[Unsafe("directory and path identify a source-approved statx object; output lends three writable words; the zeroed 256-byte statx stack buffer never escapes"), FFI(asm)]
fn os_statx_created_i64(directory: I64, path: I64, flags: I64, output: I64) -> I64 {
    """
    push {directory}
