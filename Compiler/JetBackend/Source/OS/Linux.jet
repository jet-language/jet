    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    push rax
    mov r8, rsp
    mov r10, 2048
    mov rax, 332
    syscall
    mov r9, qword ptr [r8 + 256]
    mov rdx, qword ptr [r8]
    mov qword ptr [r9], rdx
    mov rdx, qword ptr [r8 + 80]
    mov qword ptr [r9 + 8], rdx
    mov rdx, qword ptr [r8 + 88]
    mov qword ptr [r9 + 16], rdx
    pop rdx
    pop rdx
