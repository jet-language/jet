// Jet's low-level OS layer for Linux x86-64: the one audited place where Jet
// code talks to the kernel directly (owner ruling 2026-10-01 on #4015). The
// in-process loader (Image/Loader.jet), tiered hot swap and the Jet-written
// runtime are ordinary Jet code on top of it.
//
// The backend assembles this source for the loader; the runtime's independent
// source manifest includes its fixed-width leaves. Runtime heap internals use
// those I64 leaves, not the loader's exact-Int helpers: entering arbitrary-
// precision arithmetic while bootstrapping an allocator could recurse.
// User programs get safe Core APIs, not a direct heap/syscall API.
//
// The machine-level entries are `#FFI(asm)` functions under `#Unsafe`
// sema checks their operand contract and every
// call needs an audited `#Unsafe` gate. A system call returns its result, or
// `-errno` in -4095..-1; `os_failed` tells the two apart. Runtime symbols
// resolve through the dynamic linker for hosted C platform imports. Jet
// runtime leaves and OS boundaries are compiled from this source tree. See
// Docs/research/jet-backend-design-2026-10-01.md.
use core.mem

OS_SYS_READ :: prep { 0 }
OS_SYS_WRITE :: prep { 1 }
OS_SYS_CLOSE :: prep { 3 }
OS_SYS_MMAP :: prep { 9 }
OS_SYS_MPROTECT :: prep { 10 }
OS_SYS_MUNMAP :: prep { 11 }
OS_SYS_BRK :: prep { 12 }
OS_SYS_RT_SIGACTION :: prep { 13 }
OS_SYS_RT_SIGPROCMASK :: prep { 14 }
OS_SYS_PREAD64 :: prep { 17 }
OS_SYS_DUP2 :: prep { 33 }
OS_SYS_NANOSLEEP :: prep { 35 }
OS_SYS_GETPID :: prep { 39 }
OS_SYS_EXECVE :: prep { 59 }
OS_SYS_FORK :: prep { 57 }
OS_SYS_WAIT4 :: prep { 61 }
OS_SYS_KILL :: prep { 62 }
OS_SYS_FCNTL :: prep { 72 }
OS_SYS_SIGALTSTACK :: prep { 131 }
OS_SYS_PRCTL :: prep { 157 }
OS_SYS_ARCH_PRCTL :: prep { 158 }
OS_SYS_EXIT_GROUP :: prep { 231 }
OS_SYS_OPENAT :: prep { 257 }
OS_SYS_PRLIMIT64 :: prep { 302 }
OS_SYS_GETRANDOM :: prep { 318 }
OS_SYS_MEMFD_CREATE :: prep { 319 }
OS_SYS_CLOSE_RANGE :: prep { 436 }

OS_PROT_READ :: prep { 1 }
OS_PROT_WRITE :: prep { 2 }
OS_PROT_EXEC :: prep { 4 }

OS_PAGE_SIZE :: prep { 4096 }

OS_MAP_PRIVATE :: prep { 0x02 }
OS_MAP_PRIVATE_ANONYMOUS :: prep { 0x22 }
OS_MAP_NORESERVE :: prep { 0x4000 }
// Map exactly at the hint or fail with EEXIST; never replace a mapping.
OS_MAP_FIXED_NOREPLACE :: prep { 0x100000 }

OS_AT_FDCWD :: prep { -100 }

OS_EEXIST :: prep { 17 }
OS_EINTR :: prep { 4 }

// One raw system call with up to six arguments. Every input is pushed before
// any argument register is written, so the operands may live in any register;
// the argument registers are restored afterwards.
#[Unsafe("a raw Linux x86-64 system call; the caller passes the call number and arguments that call expects"), FFI(asm)]
fn os_syscall(number: Int, a1: Int, a2: Int, a3: Int, a4: Int, a5: Int, a6: Int) -> Int {
    """
    push rdi
    push rsi
    push rdx
    push r10
    push r8
    push r9
    push {number}
    push {a1}
    push {a2}
    push {a3}
    push {a4}
    push {a5}
    push {a6}
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    pop rax
    syscall
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    mov rax, rax ; -> return
    ; clobbers rcx, r11
    """
}

// Whether a system call result is `-errno` rather than a value.
fn os_failed(result: Int) -> Bool Never! {
    result < 0 && result > -4096
}

fn os_page_round(size: Int) -> Int Never! {
    size + (OS_PAGE_SIZE - size % OS_PAGE_SIZE) % OS_PAGE_SIZE
}

// Read up to `count` bytes from `fd` into the memory at `address`.
fn os_read(fd: Int, address: Int, count: Int) -> Int {
    #Unsafe("the caller owns `count` writable bytes at `address`") {
        return os_syscall(OS_SYS_READ, fd, address, count, 0, 0, 0)
    }
}

// Write up to `count` bytes at `address` to `fd`.
fn os_write(fd: Int, address: Int, count: Int) -> Int {
    #Unsafe("the caller owns `count` readable bytes at `address`") {
        return os_syscall(OS_SYS_WRITE, fd, address, count, 0, 0, 0)
    }
}

// Map `size` bytes (rounded up to whole pages) of fresh zeroed private memory
// with `protection` (a sum of OS_PROT_*). Returns the address.
fn os_map(size: Int, protection: Int) -> Int {
    #Unsafe("an anonymous mapping aliases no existing memory") {
        return os_syscall(OS_SYS_MMAP, 0, os_page_round(size), protection, OS_MAP_PRIVATE_ANONYMOUS, -1, 0)
    }
}

// Change the protection of the whole pages in `address .. address + size`.
fn os_protect(address: Int, size: Int, protection: Int) -> Int {
    #Unsafe("the caller owns the mapping it changes") {
        return os_syscall(OS_SYS_MPROTECT, address, os_page_round(size), protection, 0, 0, 0)
    }
}

fn os_unmap(address: Int, size: Int) -> Int {
    #Unsafe("the caller owns the mapping and nothing uses it any more") {
        return os_syscall(OS_SYS_MUNMAP, address, os_page_round(size), 0, 0, 0, 0)
    }
}

// End the process with `status`; never returns.
fn os_exit(status: Int) {
    #Unsafe("exit_group ends every thread of the process") {
        _ := os_syscall(OS_SYS_EXIT_GROUP, status, 0, 0, 0, 0, 0)
    }
}

#[Unsafe("stores one word at an address the caller owns and has mapped writable"), FFI(asm)]
fn os_store_word(address: Int, value: Int) {
    """
    mov qword ptr [{address}], {value}
    """
}

#[Unsafe("reads one word at an address the caller owns and has mapped readable"), FFI(asm)]
fn os_load_word(address: Int) -> Int {
    """
    mov rax, qword ptr [{address}] ; -> return
    """
}

#[Unsafe("reads one byte at an address the caller owns and has mapped readable"), FFI(asm)]
fn os_load_byte(address: Int) -> Int {
    """
    movzx rax, byte ptr [{address}] ; -> return
    """
}

#[Unsafe("stores one byte at an address the caller owns and has mapped writable"), FFI(asm)]
fn os_store_byte(address: Int, value: Int) {
    """
    mov rax, {value}
    mov byte ptr [{address}], al
    """
}

// Copy `bytes` to `address` one little-endian word at a time. The last word
// is padded with zero bytes, so the destination must hold `bytes.len()`
// rounded up to 8 bytes (a page-rounded mapping always does).
fn os_copy_in(address: Int, bytes: [U8]) {
    os_copy_in_range(address, bytes, 0, bytes.len())
}

// Like os_copy_in, but borrowing one range avoids allocating image chunks.
fn os_copy_in_range(address: Int, bytes: [U8], start: Int, count: Int) {
    at := 0
    loop at < count {
        word := 0
        scale := 1
        loop k in 0..<8 {
            byte := 0
            if at + k < count -> byte = Int.from_u8(bytes[start + at + k])
            // The top byte carries the sign of the 64-bit word.
            if k == 7 && byte >= 128 -> byte = byte - 256
            word = word + byte * scale
            if k < 7 -> scale = scale * 256
        }
        #Unsafe("the caller owns the destination words") {
            os_store_word(address + at, word)
        }
        at = at + 8
    }
}

// The call-code-address primitive: call the System V function at `address`
// with one word argument and return its word result. The caller vouches that
// `address` is executable code with that signature.
#[Unsafe("calls machine code; the caller vouches for the code and its System V signature"), FFI(asm)]
fn os_call_address(address: Int, argument: Int) -> Int {
    """
    push {address}
    push {argument}
    pop rdi
    pop r11
    call r11
    mov rax, rax ; -> return
    ; clobbers rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls machine code; the caller vouches for the code and its two-word System V signature"), FFI(asm)]
fn os_call_address_two(address: Int, first: Int, second: Int) -> Int {
    """
    push {address}
    push {first}
    push {second}
    pop rsi
    pop rdi
    pop r11
    call r11
    mov rax, rax ; -> return
    ; clobbers rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls machine code; the caller holds the mapping and its checked zero-argument Unit System V signature"), FFI(asm)]
fn os_call_address_unit(address: Int) {
    """
    push {address}
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls machine code; the caller holds the mapping and its checked three-word Unit System V signature"), FFI(asm)]
fn os_call_address_three_unit(address: Int, first: Int, second: Int, third: Int) {
    """
    push {address}
    push {first}
    push {second}
    push {third}
    pop rdx
    pop rsi
    pop rdi
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls machine code; the caller holds the mapping and its checked one-word Unit System V signature"), FFI(asm)]
fn os_call_address_one_unit(address: Int, first: Int) {
    """
    push {address}
    push {first}
    pop rdi
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls machine code; the caller holds the mapping and its checked two-word Unit System V signature"), FFI(asm)]
fn os_call_address_two_unit(address: Int, first: Int, second: Int) {
    """
    push {address}
    push {first}
    push {second}
    pop rsi
    pop rdi
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

// Runtime leaves use machine words, never exact Int: an allocator must not
// enter the arbitrary-precision numeric runtime while bootstrapping its heap.
#[Unsafe("a raw Linux x86-64 syscall; the caller supplies the syscall's valid machine-word arguments"), FFI(asm)]
fn os_syscall_i64(number: I64, a1: I64, a2: I64, a3: I64, a4: I64, a5: I64, a6: I64) -> I64 {
    """
    push rdi
    push rsi
    push rdx
    push r10
    push r8
    push r9
    push {number}
    push {a1}
    push {a2}
    push {a3}
    push {a4}
    push {a5}
    push {a6}
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    pop rax
    syscall
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    mov rax, rax ; -> return
    ; clobbers rcx, r11
    """
}

#[Unsafe("reads one aligned machine word in live allocator-owned mapped memory"), FFI(asm)]
fn os_load_i64(address: I64) -> I64 {
    """
    mov rax, qword ptr [{address}] ; -> return
    """
}

#[Unsafe("stores one aligned machine word in live allocator-owned mapped memory; x86 TSO makes this a release store"), FFI(asm)]
fn os_store_i64(address: I64, value: I64) {
    """
    mov qword ptr [{address}], {value}
    """
}

// Returns the previous word. The locked instruction is a full memory barrier,
// so a successful 0 -> 1 exchange acquires a lock released by os_store_i64.
#[Unsafe("atomically compares and exchanges one aligned live machine word; every non-atomic access to protected data holds its lock"), FFI(asm)]
fn os_cas_i64(address: I64, expected: I64, desired: I64) -> I64 {
    """
    push {address}
    push {expected}
    push {desired}
    pop rdx
    pop rax
    pop rcx
    lock cmpxchg qword ptr [rcx], rdx
    mov rax, rax ; -> return
    ; clobbers rcx, rdx
    """
}

#[Unsafe("x86 pause only hints that this thread is waiting in a spin loop"), FFI(asm)]
fn os_spin_pause() {
    """
    pause
    """
}

// The calling thread's stack pointer. Thread stacks are disjoint mappings, so
// its high bits tell threads running at the same time apart (the runtime
// heap's arena choice, Alloc.jet alloc_arena). An rsp read needs a
// template-owned pushed word, which is popped back; nothing is dereferenced.
#[Unsafe("reads the stack pointer register after one balanced push; no memory is read"), FFI(asm)]
fn os_stack_address_i64() -> I64 {
    """
    mov rcx, 0
    push rcx
    mov rax, rsp
    pop rcx
    mov rax, rax ; -> return
    ; clobbers rcx
    """
}

// String moves for the runtime's memmove (Collections.jet jet_rt_mem_move).
// Ascending copies `count` bytes from `source` to `target` in increasing
// address order, so an overlap must have target below source.
#[Unsafe("the caller owns count readable bytes at source and count writable bytes at target; an overlap has target below source"), FFI(asm)]
fn os_copy_ascending_i64(target: I64, source: I64, count: I64) {
    """
    push {target}
    push {source}
    push {count}
    pop rcx
    pop rsi
    pop rdi
    cld
    rep movsb
    ; clobbers rcx, rsi, rdi
    """
}

// Descending copies `count` bytes (movsb) or 8-byte words (movsq) in
// decreasing address order from the units starting at `target_last` and
// `source_last`, then clears the direction flag again: an overlap must have
// target above source.
#[Unsafe("the caller owns count readable bytes ending at source_last and count writable bytes ending at target_last; an overlap has target above source"), FFI(asm)]
fn os_copy_descending_bytes_i64(target_last: I64, source_last: I64, count: I64) {
    """
    push {target_last}
    push {source_last}
    push {count}
    pop rcx
    pop rsi
    pop rdi
    std
    rep movsb
    cld
    ; clobbers rcx, rsi, rdi
    """
}

#[Unsafe("the caller owns count readable words whose last starts at source_last and count writable words whose last starts at target_last; an overlap has target above source"), FFI(asm)]
fn os_copy_descending_words_i64(target_last: I64, source_last: I64, count: I64) {
    """
    push {target_last}
    push {source_last}
    push {count}
    pop rcx
    pop rsi
    pop rdi
    std
    rep movsq
    cld
    ; clobbers rcx, rsi, rdi
    """
}

#[Unsafe("reads one byte from a live readable mapped address supplied by the caller"), FFI(asm)]
fn os_load_u8(address: I64) -> I64 {
    """
    movzx rax, byte ptr [{address}] ; -> return
    """
}

#[Unsafe("writes one byte to a live writable mapped address supplied by the caller"), FFI(asm)]
fn os_store_u8(address: I64, value: I64) {
    """
    push {address}
    push {value}
    pop rdx
    pop rcx
    mov byte ptr [rcx], dl
    ; clobbers rcx, rdx
    """
}

// Heap-free diagnostic transport: the syscall borrows one stack word, and
// balanced push/pop restore rsp before returning. count must be in 0..=8.
#[Unsafe("writes at most eight bytes from a stack-local word while that word is live; the balanced pushes and pops do not expose stack storage after return"), FFI(asm)]
fn os_write_word_i64(fd: I64, word: I64, count: I64) -> I64 {
    """
    push {fd}
    push {word}
    push {count}
    pop rdx
    pop rax
    pop rdi
    push rax
    mov rsi, rsp
    mov rax, 1
    syscall
    pop rdx
    mov rax, rax ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx
    """
}

// Borrow two iovecs and their LF byte only for the synchronous writev call.
// The return count includes the LF if the complete frame was accepted.
#[Unsafe("bytes lends length readable bytes; the second iovec lends a stack-local LF; writev retains neither pointer and every push is balanced"), FFI(asm)]
fn os_write_line_i64(fd: I64, bytes: I64, length: I64) -> I64 {
    """
    push {fd}
    push {bytes}
    push {length}
    pop rdx
    pop rsi
    pop rdi
    mov rax, 10
    push rax
    mov rcx, rsp
    mov rax, 1
    push rax
    push rcx
    push rdx
    push rsi
    mov rsi, rsp
    mov rdx, 2
    mov rax, 20
    syscall
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    pop rdx
    mov rax, rax ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx
    """
}

// Invoke a syscall whose second argument borrows four stack-local words in
// order [w0, w1, w2, w3], whose third argument is null, and whose fourth is a4.
// This permits allocation-free rt_sigprocmask/rt_sigaction even before heap
// initialization; none of the pointers may escape this synchronous syscall.
// Preserve the six argument registers, as os_syscall_i64 does, so seven
// generic inputs do not compete with nine fixed output/clobber registers.
#[Unsafe("the syscall may read at most four initialized stack words and retains no pointer; all pushes are balanced before return"), FFI(asm)]
fn os_syscall_stack4_i64(number: I64, a1: I64, w0: I64, w1: I64, w2: I64, w3: I64, a4: I64) -> I64 {
    """
    push rdi
    push rsi
    push rdx
    push r10
    push r8
    push r9
    push {number}
    push {a1}
    push {w0}
    push {w1}
    push {w2}
    push {w3}
    push {a4}
    pop r10
    pop r9
    pop r8
    pop rdx
    pop rsi
    pop rdi
    pop rax
    push r9
    push r8
    push rdx
    push rsi
    mov rsi, rsp
    mov rdx, 0
    syscall
    pop r10
    pop r10
    pop r10
    pop r10
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    mov rax, rax ; -> return
    ; clobbers rcx, r11
    """
}

// GS is reserved for Jet; musl keeps its independent TLS on FS. Every
// attached TCB stores its own address at offset zero. No lazy attachment probe.
#[Unsafe("the calling thread is attached and GS points at its live Jet TCB"), FFI(asm)]
fn os_tls_base_i64() -> I64 {
    """
    mov rax, qword ptr gs:[0] ; -> return
    """
}

// Cold startup/defect reports may run while GS is deliberately zero. Probe the
// actual base without dereferencing it; attached hot reads keep their leaf above.
#[Unsafe("ARCH_GET_GS writes one initialized aligned stack word only during this syscall; no TLS or heap is read, and the push/pop is balanced"), FFI(asm)]
fn os_tls_base_probe_i64() -> I64 {
    """
    mov rdx, 0
    push rdx
    mov rsi, rsp
    mov rdi, 4100
    mov rax, 158
    syscall
    pop rdx
    or rax, rdx ; -> return
    ; clobbers rcx, r11, rdi, rsi, rdx
    """
}

#[Unsafe("atomically adds to one aligned live word and returns its previous value"), FFI(asm)]
fn os_fetch_add_i64(address: I64, delta: I64) -> I64 {
    """
    push {address}
    push {delta}
    pop rax
    pop rcx
    lock xadd qword ptr [rcx], rax
    mov rax, rax ; -> return
    ; clobbers rcx
    """
}

#[Unsafe("atomically exchanges one aligned live word; xchg has an implicit full barrier"), FFI(asm)]
fn os_swap_i64(address: I64, value: I64) -> I64 {
    """
    push {address}
    push {value}
    pop rax
    pop rcx
    xchg qword ptr [rcx], rax
    mov rax, rax ; -> return
    ; clobbers rcx
    """
}

#[Unsafe("calls executable System V code with one raw word argument"), FFI(asm)]
fn os_call_address_i64(address: I64, argument: I64) -> I64 {
    """
    push {address}
    push {argument}
    pop rdi
    pop r11
    call r11
    mov rax, rax ; -> return
    ; clobbers rcx, rdx, rsi, rdi, r8, r9, r10, r11
    """
}

#[Unsafe("calls a Jet closure's code with the live closure header and one raw word argument"), FFI(asm)]
fn os_call_address_two_i64(address: I64, first: I64, second: I64) -> I64 {
    """
    push {address}
    push {first}
    push {second}
    pop rsi
    pop rdi
    pop r11
    call r11
    mov rax, rax ; -> return
    ; clobbers rcx, rdx, rsi, rdi, r8, r9, r10, r11
    """
}

// Fixture-only until libc leaves the pack: raw clone does not construct musl's
// FS TLS or set __libc.threaded. Child stack is [entry,arg] and has a guard page;
// parent/child TID words live until the kernel's CHILD_CLEARTID and join finish.
#[Unsafe("raw clone child runs only Jet/syscall code, never Rust or musl; supplied stack contains entry and argument"), FFI(asm)]
fn os_clone_i64(flags: I64, stack: I64, parent_tid: I64, child_tid: I64) -> I64 {
    """
    push rdi
    push rsi
    push rdx
    push r10
    push r8
    push r9
    push {flags}
    push {stack}
    push {parent_tid}
    push {child_tid}
    pop r10
    pop rdx
    pop rsi
    pop rdi
    mov r8, 0
    mov rax, 56
    syscall
    test rax, rax
    jnz 2f
    pop rax
    pop rdi
    and rsp, -16
    call rax
    xor edi, edi
    mov eax, 60
    syscall
    2:
    pop r9
    pop r8
    pop r10
    pop rdx
    pop rsi
    pop rdi
    mov rax, rax ; -> return
    ; clobbers rcx, r11
    """
}

#[Unsafe("calls checked System V Unit code; the caller lends one live raw machine-word argument"), FFI(asm)]
fn os_call1_unit_i64(address: I64, a: I64) {
    """
    push {address}
    push {a}
    pop rdi
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

#[Unsafe("calls checked System V Unit code; the caller vouches for both raw machine-word arguments"), FFI(asm)]
fn os_call2_unit_i64(address: I64, a: I64, b: I64) {
    """
    push {address}
    push {a}
    push {b}
    pop rsi
    pop rdi
    pop r11
    call r11
    ; clobbers rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15
    """
}

