// Per-request stdout/stderr capture in anonymous kernel files. The child never
// blocks on an undrained output pipe, and arbitrary user bytes cannot masquerade
// as private control frames. No path or temporary file is exposed to the child.
fn os_session_output_reset(fd: Int) -> Bool {
    truncated := -1
    seek := -1
    #Unsafe("fd is this host's owned anonymous output file; no request is running") {
        truncated = os_syscall(77, fd, 0, 0, 0, 0, 0)
        seek = os_syscall(8, fd, 0, 0, 0, 0, 0)
    }
    truncated == 0 && seek == 0
}
fn os_session_output_read(fd: Int) -> [U8]? {
    length := -1
    seek := -1
    #Unsafe("the child's completed request no longer writes this anonymous file") {
        length = os_syscall(8, fd, 0, 2, 0, 0, 0)
        seek = os_syscall(8, fd, 0, 0, 0, 0, 0)
    }
    if length < 0 || seek != 0 -> return None
    buffer :: os_map(4096, OS_PROT_READ + OS_PROT_WRITE)
    if os_failed(buffer) -> return None
    bytes := [U8]{}
    valid := true
    loop bytes.len() < length {
        count := length - bytes.len()
        if count > 4096 -> count = 4096
        got :: os_read(fd, buffer, count)
        if got == -4 -> next
        if got <= 0 {
            valid = false
            break
        }
        loop index in 0..<got {
            byte := 0
            #Unsafe("index is within the bytes just read into this mapping") { byte = os_load_byte(buffer + index) }
            &bytes.push(U8{byte})
        }
    }
    _ := os_unmap(buffer, 4096)
    if !valid -> return None
    Val(bytes)
}
