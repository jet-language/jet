// Existing native Task.jet failure carrier, single-sourced without a new shape.
// Outcome.rs:2185-2188 and TaskGroup.rs:77-82 ordered variant ordinals.
TASK_FAILURE_BYTES :: I64{16}
TASK_FAILURE_TAG :: I64{0}
TASK_FAILURE_REASON :: I64{8}
TASK_FAILURE_CANCELLED :: I64{0}
TASK_FAILURE_DEADLINE :: I64{1}
TASK_FAILURE_PANICKED :: I64{2}
