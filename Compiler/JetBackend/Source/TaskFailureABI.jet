// Existing native Task.jet failure carrier, single-sourced without a new shape.
// Outcome.rs:2185-2188 and TaskGroup.rs:77-82 ordered variant ordinals.
TASK_FAILURE_BYTES :: comptime { I64{16} }
TASK_FAILURE_TAG :: comptime { I64{0} }
TASK_FAILURE_REASON :: comptime { I64{8} }
TASK_FAILURE_CANCELLED :: comptime { I64{0} }
TASK_FAILURE_DEADLINE :: comptime { I64{1} }
TASK_FAILURE_PANICKED :: comptime { I64{2} }
