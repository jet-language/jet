// Existing native Task.jet failure carrier, single-sourced without a new shape.
// Outcome.rs:2185-2188 and TaskGroup.rs:77-82 ordered variant ordinals.
TASK_FAILURE_BYTES :: prep { I64{16} }
TASK_FAILURE_TAG :: prep { I64{0} }
TASK_FAILURE_REASON :: prep { I64{8} }
TASK_FAILURE_CANCELLED :: prep { I64{0} }
TASK_FAILURE_DEADLINE :: prep { I64{1} }
TASK_FAILURE_PANICKED :: prep { I64{2} }
