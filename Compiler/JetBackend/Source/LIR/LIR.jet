// Jet low-level IR (LIR): the typed, target-independent form every Jet code
// generator level reads (D-EXEC1). It sits below Jet MIR. Every value carries
// its machine layout (size, alignment, ABI class), its drop action, and a link
// back to the checked Jet type; moves and drops are explicit instructions; calls
// name a signature ID and a function in the same module, a symbol in the
// compiled runtime or a code pointer value. Blocks take parameters instead
// of phi nodes, and the entry block's parameters are the function's
// parameters.
use jet_foundation.[MIRTypeID]

struct LIRValueID { value: Int }

struct LIRBlockID { value: Int }

struct LIRSignatureID { value: Int }

struct LIRFunctionID { value: Int }

struct LIRDataID { value: Int }

// System V classification of one value. `Memory` values travel by hidden
// pointer; a function without a result has no result layout.
enum LIRABIClass { Integer Pointer Float Memory }

struct LIRLayout { size: Int, align: Int, class: LIRABIClass }

// What ends a value's life. `Runtime` names the compiled-runtime drop glue that
// receives the value; `Function` names drop glue generated into the module
// (heap boxes); trivially destructible values need no drop.
enum LIRDrop {
    Trivial
    Runtime(symbol: String)
    Function(id: LIRFunctionID)
}

struct LIRValue {
    id: LIRValueID
    layout: LIRLayout
    drop: LIRDrop
    jet_type: MIRTypeID?
}

// Word Div/Rem truncate signed operands and Shr is arithmetic; UDiv/URem
// divide unsigned operands and UShr is logical. Lowering checks zero divisors
// and signed MIN/-1 before division. UAdd/USub/UMul have the same result bits
// as Add/Sub/Mul but use unsigned range tests in Overflows.
// Float Add/Sub/Mul/Div are IEEE double arithmetic, or single precision on
// Float32 operands; Xor acts on their bits.
enum LIRBinaryOp { Add Sub Mul Div Rem And Or Xor Shl Shr UAdd USub UMul UDiv URem UShr }

// Lt/Le/Gt/Ge are signed integer or ordered IEEE comparisons (NaN is false
// except Ne). ULt/ULe/UGt/UGe compare unsigned integers only.
enum LIRCondition { Eq Ne Lt Le Gt Ge ULt ULe UGt UGe }

// `Value` calls through a code pointer (a Pointer value, from
// FunctionAddress or loaded from a closure box).
enum LIRCallee {
    Function(id: LIRFunctionID)
    Runtime(symbol: String)
    Value(value: LIRValueID)
}

LIR_ASM_INPUTS :: prep { [Int]{7, 6, 2, 1, 8, 9, 10} }

fn lir_asm_register(reg: Int) -> Bool Never! {
    reg == 0 || reg == 1 || reg == 2 || reg == 6 || reg == 7 || (reg >= 8 && reg <= 11)
}

enum LIRInst {
    Const(dst: LIRValueID, value: Int)
    Binary(dst: LIRValueID, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID)
    Compare(dst: LIRValueID, condition: LIRCondition, left: LIRValueID, right: LIRValueID)
    // Ownership transfer: `src` is dead after the move.
    Move(dst: LIRValueID, src: LIRValueID)
    // Consuming pointer-owner conversion with a new drop obligation (e.g.
    // closure -> ScopeGuard). Same layout; never a copy or an alias.
    Reown(dst: LIRValueID, src: LIRValueID)
    // Duplicate of a trivially destructible value.
    Copy(dst: LIRValueID, src: LIRValueID)
    // Pure reinterpretation of one trivial 64-bit scalar. Unlike Copy, its
    // destination may have a different ABI class; optimizers must not alias
    // away that layout change.
    Bitcast(dst: LIRValueID, src: LIRValueID)
    Call(dst: LIRValueID?, signature: LIRSignatureID, callee: LIRCallee, args: [LIRValueID])
    // Effectful audited template; inputs bind simultaneously to caller-saved
    // registers. `result` is -1 exactly when dst is absent.
    InlineAsm(dst: LIRValueID?, args: [LIRValueID], regs: [Int], result: Int, code: [U8])
    // Runs the value's drop glue; the value is dead afterwards.
    Drop(value: LIRValueID)
    // Bool: whether Add/Sub/Mul overflow signed, or UAdd/USub/UMul unsigned.
    Overflows(dst: LIRValueID, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID)
    // Reads `dst`'s layout from `base + offset`; `base` is a Pointer.
    Load(dst: LIRValueID, base: LIRValueID, offset: Int)
    // Byte-addressed pointer arithmetic; offset is an Integer word.
    PointerAdd(dst: LIRValueID, base: LIRValueID, offset: LIRValueID)
    // Writes `value` to `base + offset`; `base` is a Pointer.
    Store(base: LIRValueID, offset: Int, value: LIRValueID)
    // The address of a module data object.
    DataAddress(dst: LIRValueID, data: LIRDataID)
    // The code address of a module function.
    FunctionAddress(dst: LIRValueID, function: LIRFunctionID)
    // Numeric conversion: signed word <-> Float, or fixed Integer widths.
    // Integer width changes keep the low min(src,dst) bits, zero-extending.
    Convert(dst: LIRValueID, src: LIRValueID)
    // The address of `size` bytes of storage aligned to `align` (1, 2, 4, 8
    // or 16) in the function's frame, live until the function returns. Each
    // StackSlot instruction names storage of its own.
    StackSlot(dst: LIRValueID, size: Int, align: Int)
    // Reads the word at `offset` of the calling thread's control block
    // (`mov dst, gs:[offset]`). Only programs linked with the runtime pack
    // (LowerModule.native_pack) point GS at the attached thread's Jet TCB.
    // The word may change between any two reads: never CSE'd or hoisted.
    ThreadWord(dst: LIRValueID, offset: Int)
}

struct LIRJumpTarget { block: LIRBlockID, args: [LIRValueID] }

enum LIRTerminator {
    Jump(target: LIRJumpTarget)
    Branch(condition: LIRValueID, then_target: LIRJumpTarget, else_target: LIRJumpTarget)
    Return(value: LIRValueID?)
    // Control never reaches the end of the block (after a call that does not return).
    Unreachable
}

// `lines[i]` is the source line of `insts[i]` and the last entry that of the
// terminator (lines.len() == insts.len() + 1); 0 means no source line.
// A `cold` block is a rarely taken path (a big-integer route, a numeric
// stop): lir_builder_finish lays cold blocks out after every hot one so hot
// code falls through, and register allocation's loop detection ignores
// their edges.
struct LIRBlock {
    id: LIRBlockID
    params: [LIRValueID]
    insts: [LIRInst]
    terminator: LIRTerminator
    lines: [Int]
    cold: Bool
}

enum LIRCallConv { SystemV }

struct LIRSignature {
    id: LIRSignatureID
    convention: LIRCallConv
    params: [LIRLayout]
    result: LIRLayout?
}
fn lir_abi_class_name(class: LIRABIClass) -> String Never! {
    if class == {
        .Integer -> "Integer"
        .Pointer -> "Pointer"
        .Float -> "Float"
        .Memory -> "Memory"
    }
}

// `values[i].id.value == i`; `blocks[0]` is the entry block.
struct LIRFunction {
    id: LIRFunctionID
    name: String
    signature: LIRSignatureID
    values: [LIRValue]
    blocks: [LIRBlock]
    debug: LIRFunctionDebug
}

// Debug facts for the object writer's DWARF (Image/Dwarf.jet): which source
// line every instruction comes from (LIRBlock.lines), which source
// variables LIR values carry, and the source types those variables have,
// described by their machine layout. Lowering records them; code generation
// never reads them.
enum LIRDebugEncoding { Signed Unsigned Float Bool Char }

struct LIRDebugMember { name: String, offset: Int, ty: Int }

struct LIRDebugEnumerator { name: String, value: Int }

// Type references are rows of LIRModuleDebug.types; -1 is no type (an
// untyped pointer). `Opaque` has a name and size but no known contents.
enum LIRDebugTypeKind {
    Base(encoding: LIRDebugEncoding)
    Pointer(target: Int)
    Struct(members: [LIRDebugMember])
    Union(members: [LIRDebugMember])
    Enum(enumerators: [LIRDebugEnumerator])
    Typedef(target: Int)
    Opaque
}

struct LIRDebugType { name: String, size: Int, kind: LIRDebugTypeKind }

// A source variable: a parameter or a named local. `indirect` when the
// carried value is the address of the variable's bytes (an inline aggregate)
// rather than the variable itself.
struct LIRDebugVariable {
    name: String
    ty: Int
    line: Int
    parameter: Bool
    indirect: Bool
}

// From its definition on, `value` carries `variable` while it is live.
struct LIRDebugBinding { variable: Int, value: LIRValueID }

// `file` is a row of LIRModuleDebug.files, -1 for generated code (glue,
// helpers, the generated entry), which has no source name or variables.
struct LIRFunctionDebug {
    name: String
    file: Int
    line: Int
    variables: [LIRDebugVariable]
    bindings: [LIRDebugBinding]
}

// `directory` is the compilation directory relative `files` resolve
// against; "" leaves that to the debugger (its working directory).
struct LIRModuleDebug {
    directory: String
    files: [String]
    types: [LIRDebugType]
}

fn lir_function_debug_none() -> LIRFunctionDebug Never! {
    LIRFunctionDebug{name: "", file: -1, line: 0, variables: [LIRDebugVariable]{}, bindings: [LIRDebugBinding]{}}
}

fn lir_module_debug_none() -> LIRModuleDebug Never! {
    LIRModuleDebug{directory: "", files: [String]{}, types: [LIRDebugType]{}}
}

// Read-only module objects, including immutable aggregate constant trees.
struct LIRDataReloc {
    offset: Int
    target: LIRDataID
    addend: Int
}

struct LIRData {
    id: LIRDataID
    bytes: [U8]
    align: Int
    relocs: [LIRDataReloc]
}

// `signatures[i].id.value == i`, `functions[i].id.value == i` and
// `data[i].id.value == i`.
struct LIRModule {
    signatures: [LIRSignature]
    functions: [LIRFunction]
    data: [LIRData]
    debug: LIRModuleDebug
}

fn lir_layout_word() -> LIRLayout Never! {
    LIRLayout{size: 8, align: 8, class: LIRABIClass.Integer}
}

fn lir_layout_bool() -> LIRLayout Never! {
    LIRLayout{size: 1, align: 1, class: LIRABIClass.Integer}
}

fn lir_layout_pointer() -> LIRLayout Never! {
    LIRLayout{size: 8, align: 8, class: LIRABIClass.Pointer}
}

fn lir_layout_float() -> LIRLayout Never! {
    LIRLayout{size: 8, align: 8, class: LIRABIClass.Float}
}

// An IEEE single (F32): its 32 bits, zero-extended in a word wherever it is
// held, loaded or stored as 4 bytes.
fn lir_layout_float32() -> LIRLayout Never! {
    LIRLayout{size: 4, align: 4, class: LIRABIClass.Float}
}

fn lir_inst_def(inst: LIRInst) -> LIRValueID? {
    if inst == {
        .Const(dst, _) -> Val(dst)
        .Binary(dst, _, _, _) -> Val(dst)
        .Compare(dst, _, _, _) -> Val(dst)
        .Move(dst, _) -> Val(dst)
        .Reown(dst, _) -> Val(dst)
        .Copy(dst, _) -> Val(dst)
        .Bitcast(dst, _) -> Val(dst)
        // copy: `dst` is a payload of read parameter `inst`, which keeps the original; the returned value owns this one
        .Call(dst, _, _, _) -> dst.copy()
        // copy: `dst` is a payload of read parameter `inst`, which keeps the original; the returned value owns this one
        .InlineAsm(dst, _, _, _, _) -> dst.copy()
        .Drop(_) -> None
        .Overflows(dst, _, _, _) -> Val(dst)
        .Load(dst, _, _) -> Val(dst)
        .PointerAdd(dst, _, _) -> Val(dst)
        .Store(_, _, _) -> None
        .DataAddress(dst, _) -> Val(dst)
        .FunctionAddress(dst, _) -> Val(dst)
        .Convert(dst, _) -> Val(dst)
        .StackSlot(dst, _, _) -> Val(dst)
        .ThreadWord(dst, _) -> Val(dst)
    }
}

fn lir_inst_uses(inst: LIRInst) -> [LIRValueID] Never! {
    if inst == {
        .Const(_, _) -> [LIRValueID]{}
        .Binary(_, _, left, right) -> [LIRValueID]{left, right}
        .Compare(_, _, left, right) -> [LIRValueID]{left, right}
        .Move(_, src) -> [LIRValueID]{src}
        .Reown(_, src) -> [LIRValueID]{src}
        .Copy(_, src) -> [LIRValueID]{src}
        .Bitcast(_, src) -> [LIRValueID]{src}
        .Call(_, _, callee, args) -> {
            if callee == .Value(target) {
                uses := [LIRValueID]{target}
                loop arg in args -> &uses.push(arg)
                return uses
            }
            args
        }
        .InlineAsm(_, args, _, _, _) -> args
        .Drop(value) -> [LIRValueID]{value}
        .Overflows(_, _, left, right) -> [LIRValueID]{left, right}
        .Load(_, base, _) -> [LIRValueID]{base}
        .PointerAdd(_, base, offset) -> [LIRValueID]{base, offset}
        .Store(base, _, value) -> [LIRValueID]{base, value}
        .DataAddress(_, _) -> [LIRValueID]{}
        .FunctionAddress(_, _) -> [LIRValueID]{}
        .Convert(_, src) -> [LIRValueID]{src}
        .StackSlot(_, _, _) -> [LIRValueID]{}
        .ThreadWord(_, _) -> [LIRValueID]{}
    }
}

// Values whose life the instruction ends.
fn lir_inst_consumes(inst: LIRInst) -> [LIRValueID] Never! {
    if inst == {
        .Move(_, src) | .Reown(_, src) -> [LIRValueID]{src}
        .Drop(value) -> [LIRValueID]{value}
        else -> [LIRValueID]{}
    }
}

fn lir_terminator_targets(terminator: LIRTerminator) -> [LIRJumpTarget] Never! {
    if terminator == {
        // copy: `target` is a payload of read parameter `terminator`, which keeps the original; the list literal owns this one
        .Jump(target) -> [LIRJumpTarget]{target.copy()}
        // copy: `then_target` and `else_target` are payloads of read parameter `terminator`, which keeps the originals; the list literal owns `then_target` and `else_target`
        .Branch(_, then_target, else_target) -> [LIRJumpTarget]{then_target.copy(), else_target.copy()}
        .Return(_) -> [LIRJumpTarget]{}
        .Unreachable -> [LIRJumpTarget]{}
    }
}

fn lir_terminator_uses(terminator: LIRTerminator) -> [LIRValueID] Never! {
    uses := [LIRValueID]{}
    if terminator == {
        .Branch(condition, _, _) -> &uses.push(condition)
        .Return(value) -> { if value == .Val(returned) -> &uses.push(returned) }
        else -> {}
    }
    loop target in lir_terminator_targets(terminator) {
        loop arg in target.args -> &uses.push(arg)
    }
    uses
}

fn lir_block_index(function: LIRFunction, id: LIRBlockID) -> Int Never! {
    loop (index, block) in function.blocks { if block.id == id -> return index }
    -1
}

fn lir_signature(program: LIRModule, id: LIRSignatureID) -> LIRSignature? {
    if id.value < 0 || id.value >= program.signatures.len() -> return None
    Val(program.signatures[id.value])
}

// Builder used by MIR->LIR lowering and by hand-written LIR: values are
// allocated first, instructions go into the open block, and `lir_builder_seal`
// closes it with its parameters and terminator. Every instruction and
// terminator records the builder's current source `line`. Blocks are kept in
// seal order until `lir_builder_finish`, which moves the ones marked cold
// (`cold`, by block id) after the hot ones.
struct LIRFunctionBuilder {
    id: LIRFunctionID
    name: String
    signature: LIRSignatureID
    values: [LIRValue]
    blocks: [LIRBlock]
    open: [LIRInst]
    open_lines: [Int]
    next_block: Int
    line: Int
    debug: LIRFunctionDebug
    cold: [Int:Bool]
}

fn lir_builder(id: LIRFunctionID, name: String, signature: LIRSignatureID) -> LIRFunctionBuilder Never! {
    LIRFunctionBuilder{id: id, name: name, signature: signature, values: [LIRValue]{}, blocks: [LIRBlock]{}, open: [LIRInst]{}, open_lines: [Int]{}, next_block: 0, line: 0, debug: lir_function_debug_none(), cold: [Int:Bool]{}}
}

fn lir_builder_value(builder: &LIRFunctionBuilder, layout: LIRLayout, drop: LIRDrop, jet_type: MIRTypeID?) -> LIRValueID Never! {
    id :: LIRValueID{value: builder.values.len()}
    &builder.values.push(LIRValue{id: id, layout: layout, drop: drop, jet_type: jet_type})
    id
}

fn lir_builder_word(builder: &LIRFunctionBuilder) -> LIRValueID Never! {
    lir_builder_value(&builder, lir_layout_word(), LIRDrop.Trivial, None)
}

fn lir_builder_bool(builder: &LIRFunctionBuilder) -> LIRValueID Never! {
    lir_builder_value(&builder, lir_layout_bool(), LIRDrop.Trivial, None)
}

fn lir_builder_block_id(builder: &LIRFunctionBuilder) -> LIRBlockID Never! {
    id :: LIRBlockID{value: builder.next_block}
    builder.next_block = builder.next_block + 1
    id
}

// Marks block `id` cold before or after it is sealed (LIRBlock.cold).
fn lir_builder_mark_cold(builder: &LIRFunctionBuilder, id: LIRBlockID) Never! {
    _ := &builder.cold.add(id.value, true)
}

fn lir_builder_is_cold(builder: LIRFunctionBuilder, id: LIRBlockID) -> Bool Never! {
    builder.cold.get(id.value) != None
}

fn lir_builder_push(builder: &LIRFunctionBuilder, inst: LIRInst) Never! {
    &builder.open.push(inst)
    &builder.open_lines.push(builder.line)
}

fn lir_builder_seal(builder: &LIRFunctionBuilder, id: LIRBlockID, params: [LIRValueID], terminator: LIRTerminator) Never! {
    lines := builder.open_lines
    &lines.push(builder.line)
    cold :: builder.cold.get(id.value) != None
    &builder.blocks.push(LIRBlock{id: id, params: params, insts: builder.open, terminator: terminator, lines: lines, cold: cold})
    builder.open = [LIRInst]{}
    builder.open_lines = [Int]{}
}

// The finished function: hot blocks in seal order (the entry block first),
// then the cold ones in seal order.
fn lir_builder_finish(builder: LIRFunctionBuilder) -> LIRFunction Never! {
    if builder.cold.len() == 0 {
        return LIRFunction{id: builder.id, name: builder.name, signature: builder.signature, values: builder.values, blocks: builder.blocks, debug: builder.debug}
    }
    blocks := [LIRBlock]{}
    loop block in builder.blocks { if !block.cold -> &blocks.push(block) }
    loop block in builder.blocks { if block.cold -> &blocks.push(block) }
    LIRFunction{id: builder.id, name: builder.name, signature: builder.signature, values: builder.values, blocks: blocks, debug: builder.debug}
}
