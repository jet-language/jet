// Shared native-private Node160/metadata contract, adapted from 78f5f6471.
// Rust Ui.rs:64-101 has raw Option<i64> callbacks, not Closure24 owners.
// Nullable text/metadata pointers mean None; a present empty text owns E4.
UI_NODE_BYTES :: prep { I64{160} }
UI_NODE_LABEL :: prep { I64{0} }
UI_NODE_WIDTH :: prep { I64{8} }
UI_NODE_HEIGHT :: prep { I64{16} }
UI_NODE_ROLE :: prep { I64{24} } // -1 = None
UI_NODE_KIND :: prep { I64{32} }
UI_NODE_CHILDREN :: prep { I64{40} }
UI_NODE_COLOR :: prep { I64{48} }
UI_NODE_STYLE_PRESENT :: prep { I64{56} }
// Optional inline colors: kind 0 = None, 1/2/3 = ANSI16/ANSI256/RGB.
UI_NODE_FOREGROUND_KIND :: prep { I64{64} }
UI_NODE_FOREGROUND_WORD :: prep { I64{72} }
UI_NODE_BACKGROUND_KIND :: prep { I64{80} }
UI_NODE_BACKGROUND_WORD :: prep { I64{88} }
UI_NODE_STYLE_FLAGS :: prep { I64{96} } // bools packed in bits 0,1,2
UI_NODE_ABSENT_MASK :: prep { I64{104} }
UI_NODE_IME :: prep { I64{112} }
UI_NODE_CLICK_FN :: prep { I64{120} } // raw i64, Some(0) is valid
UI_NODE_DROP_FN :: prep { I64{128} }
UI_NODE_ACCESSIBILITY :: prep { I64{136} }
UI_NODE_SHORTCUT :: prep { I64{144} }
UI_NODE_KEY :: prep { I64{152} }
UI_NODE_SLOT_IME :: prep { I64{2} }
UI_NODE_SLOT_CLICK :: prep { I64{8} }
UI_NODE_SLOT_DROP :: prep { I64{16} }
UI_NODE_OPTION_MASK :: prep { I64{26} }

UI_ACCESSIBILITY_BYTES :: prep { I64{40} }
UI_ACCESSIBILITY_NAME :: prep { I64{0} }
UI_ACCESSIBILITY_DESCRIPTION :: prep { I64{8} }
UI_ACCESSIBILITY_LENGTH :: prep { I64{16} }
UI_ACCESSIBILITY_CAPACITY :: prep { I64{24} }
UI_ACCESSIBILITY_DATA :: prep { I64{32} }
UI_STATE_BYTES :: prep { I64{16} }
UI_STATE_PAYLOAD :: prep { I64{8} }
UI_STATE_DISABLED :: prep { I64{0} }
UI_STATE_BUSY :: prep { I64{1} }
UI_STATE_EXPANDED :: prep { I64{2} }
UI_STATE_CHECKED :: prep { I64{3} }
UI_STATE_SELECTED :: prep { I64{4} }
UI_STATE_REQUIRED :: prep { I64{5} }
UI_STATE_VALUE :: prep { I64{6} }
UI_SHORTCUT_BYTES :: prep { I64{16} }
UI_SHORTCUT_KEY :: prep { I64{0} }
UI_SHORTCUT_MODIFIERS :: prep { I64{8} }
