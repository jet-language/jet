// Shared native-private metadata contract, adapted from 78f5f6471. Nullable
// text/metadata pointers mean None; a present empty text owns E4.

// UIAccessibility: optional name and description texts, then its states as an
// inline List header (length, capacity, data) of UI_STATE_BYTES states; that
// header is also the record's `List.Rec` sequence (DataSequences layout).
UI_ACCESSIBILITY_BYTES: I64{40}
UI_ACCESSIBILITY_NAME: I64{0}
UI_ACCESSIBILITY_DESCRIPTION: I64{8}
UI_ACCESSIBILITY_LENGTH: I64{16}
UI_ACCESSIBILITY_CAPACITY: I64{24}
UI_ACCESSIBILITY_DATA: I64{32}
// UIAccessibilityState: its variant (schema position) and payload.
UI_STATE_BYTES: I64{16}
UI_STATE_PAYLOAD: I64{8}
UI_STATE_DISABLED: I64{0}
UI_STATE_BUSY: I64{1}
UI_STATE_EXPANDED: I64{2}
UI_STATE_CHECKED: I64{3}
UI_STATE_SELECTED: I64{4}
UI_STATE_REQUIRED: I64{5}
UI_STATE_VALUE: I64{6}
UI_SHORTCUT_BYTES: I64{16}
UI_SHORTCUT_KEY: I64{0}
UI_SHORTCUT_MODIFIERS: I64{8}
UI_SHORTCUT_MODIFIERS_BYTES: I64{8}

// UI slice3: seed HostServices74-76/1242-1246, WebTable51-120,
// WebForms1657-1662, WebQuery303-383, WebStore242-249.
UI_FILE_FILTER_BYTES: I64{24}
UI_FILE_FILTER_LABEL: I64{0}
UI_FILE_FILTER_EXTENSIONS: I64{8}
UI_FILE_FILTER_MIME_TYPES: I64{16}
UI_FILE_FILTER_CHILD_BYTES: I64{8}
UI_TABLE_SORT_BYTES: I64{16}
UI_TABLE_SORT_COLUMN: I64{0}
UI_TABLE_SORT_DIRECTION: I64{8}
UI_TABLE_FILTER_BYTES: I64{16}
UI_TABLE_FILTER_COLUMN: I64{0}
UI_TABLE_FILTER_VALUE: I64{8}
UI_TABLE_STATE_BYTES: I64{64}
UI_TABLE_STATE_SORT: I64{0}
UI_TABLE_STATE_FILTER: I64{8}
UI_TABLE_STATE_PAGE_INDEX: I64{16}
UI_TABLE_STATE_PAGE_SIZE: I64{24}
UI_TABLE_STATE_SELECTED_KEYS: I64{32}
UI_TABLE_STATE_SELECTION_ANCHOR: I64{40}
UI_TABLE_STATE_FOCUS_KEY: I64{48}
UI_TABLE_STATE_PAGE_MODE: I64{56}
UI_FORM_LIFECYCLE_BYTES: I64{32}
UI_FORM_LIFECYCLE_STATUS: I64{0}
UI_FORM_LIFECYCLE_RESULT: I64{8}
UI_FORM_LIFECYCLE_ERROR: I64{16}
UI_FORM_LIFECYCLE_GENERATION: I64{24} // raw u64
UI_MUTATION_BYTES: I64{88}
UI_MUTATION_STATUS: I64{0}
UI_MUTATION_GENERATION: I64{8}
UI_MUTATION_OPTIMISTIC: I64{16}
UI_MUTATION_VALUE: I64{24}
UI_MUTATION_RESULT: I64{32}
UI_MUTATION_ERROR: I64{40}
UI_MUTATION_CONTEXT: I64{48}
UI_MUTATION_ROLLBACK: I64{56}
UI_MUTATION_PAUSED: I64{64}
UI_MUTATION_QUEUED: I64{72} // raw usize
UI_MUTATION_REPLAYED: I64{80} // raw u64
UI_QUERY_STATE_BYTES: I64{48}
UI_QUERY_STATE_STATUS: I64{0}
UI_QUERY_STATE_VALUE: I64{8}
UI_QUERY_STATE_ERROR: I64{16}
UI_QUERY_STATE_GENERATION: I64{24}
UI_QUERY_STATE_QUEUED: I64{32}
UI_QUERY_STATE_OFFLINE: I64{40}
UI_STORE_EVENT_BYTES: I64{48}
UI_STORE_EVENT_SEQUENCE: I64{0}
UI_STORE_EVENT_GENERATION: I64{8}
UI_STORE_EVENT_ACTION: I64{16}
UI_STORE_EVENT_CHANGED_FIELDS: I64{24}
UI_STORE_EVENT_CURSOR: I64{32}
UI_STORE_EVENT_KIND: I64{40}

// JetKey private enum: raw u32 Char/Ctrl payload, raw i64 F payload.
UI_KEY_BYTES: I64{16}
UI_KEY_KIND: I64{0}
UI_KEY_PAYLOAD: I64{8}

// InputEvent and TuiEvent: tag plus inline Size16 or owned/scalar pair.
UI_EVENT_BYTES: I64{24}
UI_EVENT_KIND: I64{0}
UI_EVENT_FIRST: I64{8}
UI_EVENT_SECOND: I64{16}

// VirtualPlan twelve raw i64 fields then an owned sequence of inline pairs.
UI_VIRTUAL_BYTES: I64{104}
UI_VIRTUAL_MEASUREMENTS: I64{96}
UI_VIRTUAL_WORD_BYTES: I64{8}
UI_VIRTUAL_PAIR_BYTES: I64{16}

UI_GRANTED_PATH_BYTES: I64{24}
UI_GRANTED_PATH_PATH: I64{0}
UI_GRANTED_PATH_ROOT: I64{8}
UI_GRANTED_PATH_ACCESS: I64{16}
UI_DIALOG_BYTES: I64{56}
UI_DIALOG_KIND: I64{0}
UI_DIALOG_TITLE: I64{8}
UI_DIALOG_GRANT: I64{16}
UI_DIALOG_INITIAL: I64{32}
UI_DIALOG_FILTERS: I64{40}
UI_DIALOG_MULTIPLE: I64{48}

// Native seed UIHostError eight variants, independent of Core UIHostError.
UI_HOST_ERROR_BYTES: I64{32}
UI_HOST_ERROR_KIND: I64{0}
UI_HOST_ERROR_FIRST: I64{8}
UI_HOST_ERROR_SECOND: I64{16}
UI_HOST_ERROR_THIRD: I64{24}

// Seed-native clipboard success payloads; raw usize is not exact Int.
UI_TEXT_RANGE_BYTES: I64{16}
UI_TEXT_RANGE_START: I64{0}
UI_TEXT_RANGE_END: I64{8}
UI_CLIPBOARD_TEXT_BYTES: I64{16}
UI_CLIPBOARD_TEXT_TEXT: I64{0}
UI_CLIPBOARD_TEXT_SELECTION: I64{8}
UI_CLIPBOARD_WRITE_BYTES: I64{8}
UI_CLIPBOARD_WRITE_CHARACTERS: I64{0}

UI_SHORTCUT_BINDING_BYTES: I64{32}
UI_SHORTCUT_BINDING_SHORTCUT: I64{0}
UI_SHORTCUT_BINDING_ACTION: I64{16}
UI_SHORTCUT_BINDING_NODE: I64{24}
UI_SHORTCUT_DISPATCH_BYTES: I64{40}
UI_SHORTCUT_DISPATCH_KIND: I64{0}
UI_SHORTCUT_DISPATCH_BINDING: I64{8}

UI_ACCESSIBILITY_PROJECTION_BYTES: I64{48}
UI_ACCESSIBILITY_PROJECTION_NODE: I64{0}
UI_ACCESSIBILITY_PROJECTION_METADATA: I64{8}

UI_IME_COMPOSITION_BYTES: I64{32}
UI_IME_COMPOSITION_TEXT: I64{0}
UI_IME_COMPOSITION_SELECTION: I64{8}
UI_IME_COMPOSITION_MARKED: I64{24}
UI_IME_EVENT_BYTES: I64{24}
UI_IME_EVENT_TARGET: I64{0}
UI_IME_EVENT_PHASE: I64{8}
UI_IME_EVENT_COMPOSITION: I64{16}

UI_DROP_ITEM_BYTES: I64{32}
UI_DROP_ITEM_KIND: I64{0}
UI_DROP_ITEM_PAYLOAD: I64{8}
UI_DRAG_EVENT_BYTES: I64{32}
UI_DRAG_EVENT_TARGET: I64{0}
UI_DRAG_EVENT_PHASE: I64{8}
UI_DRAG_EVENT_OPERATION: I64{16}
UI_DRAG_EVENT_ITEMS: I64{24}

// Two inline List24 headers and Text8 keys. Keep the shared layout independent
// of runtime-only DataSequences constants.
UI_FORM_ACTION_ERROR_FIELDS: I64{0}
UI_FORM_ACTION_ERROR_FORM: I64{24}
UI_FORM_ACTION_ERROR_BYTES: I64{48}
UI_FORM_ERROR_ENTRY_KEY: I64{0}
UI_FORM_ERROR_ENTRY_MESSAGES: I64{8}
UI_FORM_ERROR_ENTRY_BYTES: I64{32}
