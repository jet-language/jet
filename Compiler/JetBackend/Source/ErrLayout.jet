// Canonical native-pack ABI only. Legacy Rust seed records never use this
// table. Runtime ownership and Lower native Err access share these constants.
ERR_BYTES :: comptime { I64{88} }
ERR_MESSAGE :: comptime { I64{0} }
ERR_CODE :: comptime { I64{8} }
ERR_CAUSE :: comptime { I64{16} }
ERR_IDENTITY :: comptime { I64{24} }
ERR_CONTEXT :: comptime { I64{32} }
ERR_CONVERSIONS :: comptime { I64{56} }
ERR_DETAILS :: comptime { I64{80} }
ERR_CONTEXT_BYTES :: comptime { I64{24} }
ERR_CONVERSION_BYTES :: comptime { I64{16} }
ERR_DETAILS_BYTES :: comptime { I64{56} }
ERR_DETAILS_VARIANT :: comptime { I64{0} }
ERR_DETAILS_FIELDS :: comptime { I64{8} }
ERR_DETAILS_HAS_SPAN :: comptime { I64{32} }
ERR_DETAILS_START :: comptime { I64{40} }
ERR_DETAILS_END :: comptime { I64{48} }
ERR_FIELD_BYTES :: comptime { I64{16} }
JOURNEY_BYTES :: comptime { I64{32} }
JOURNEY_ORIGIN :: comptime { I64{0} }
JOURNEY_HOPS :: comptime { I64{8} }
HOP_BYTES :: comptime { I64{48} }
HOP_FUNCTION :: comptime { I64{0} }
HOP_FILE :: comptime { I64{8} }
HOP_LINE :: comptime { I64{16} }
HOP_COLUMN :: comptime { I64{24} }
