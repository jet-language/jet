// Native hand carriers only. Canonical variant order.
DYN_BYTES: I64{16}

DYN_TAG: I64{0}

DYN_PAYLOAD: I64{8}

DYN_NULL: I64{0}

DYN_BOOL: I64{1}

DYN_INT: I64{2}

DYN_FLOAT: I64{3}

DYN_NUMBER: I64{4}

DYN_TEXT: I64{5}

DYN_BYTE_LIST: I64{6}

DYN_DATETIME: I64{7}

// DynDateTime is not JetDateTime: frozen offset participates in equality.
DYN_DATETIME_BYTES: I64{32}

DYN_DATETIME_SECS: I64{0}

DYN_DATETIME_NANOS: I64{8}

DYN_DATETIME_LEAP: I64{16}

DYN_DATETIME_OFFSET: I64{24}

DYN_ARRAY: I64{8}

DYN_OBJECT: I64{9}

DYN_ELEMENT_BYTES: I64{8}

DYN_ENTRY_BYTES: I64{16}

DYN_ENTRY_KEY: I64{0}

DYN_ENTRY_VALUE: I64{8}

// Private prepared transport data (/dev/null), never a public enum arm: the
// word after ProcessStreamMode's cases (CoreEnumABI's PROCESS_STREAM_*).
PROCESS_STREAM_NULL: I64{4}

// ONE private public ProcessSpec value carrier.
PROCESS_SPEC_BYTES: I64{192}

PROCESS_SPEC_CMD: I64{0}

PROCESS_SPEC_CWD: I64{8}

PROCESS_SPEC_ENV_CLEAR: I64{16}

PROCESS_SPEC_ENV_SET: I64{24}

PROCESS_SPEC_ENV_REMOVE: I64{32}

PROCESS_SPEC_STDIN: I64{40}

PROCESS_SPEC_STDOUT: I64{48}

PROCESS_SPEC_STDERR: I64{56}

PROCESS_SPEC_TIMEOUT: I64{64}

PROCESS_SPEC_OUTPUT_LIMIT: I64{72}

PROCESS_SPEC_CPU_TIME_LIMIT: I64{80}

PROCESS_SPEC_MEMORY_LIMIT: I64{88}

PROCESS_SPEC_OPEN_FILE_LIMIT: I64{96}

PROCESS_SPEC_DETACHED: I64{104}

PROCESS_SPEC_TERMINAL: I64{112}

PROCESS_SPEC_POLICY_WIRE: I64{120}

// Private retained FD72 directory rows; all existing field offsets stay fixed.
PROCESS_SPEC_DIRECTORIES: I64{128}

// process.run_all's private parent-death word (0/1); no public spec field.
PROCESS_SPEC_PARENT_DEATH: I64{136}

// `.cpu_affinity(cpus)`: an owned List24 of the asked CPUs as saturated words
// (0 = unset), checked at launch against the PROCESS_CPU_SET_CPUS set.
PROCESS_SPEC_CPU_AFFINITY: I64{144}

// The runtime's affinity mask: 1024 CPUs, the 128-byte cpu_set_t
// sched_setaffinity reads.
PROCESS_CPU_SET_CPUS: I64{1024}

PROCESS_CPU_SET_BYTES: I64{128}

// `.io_idle()` / `.io_priority(level)`: the class word (PROCESS_IO_PRIORITY_UNSET, _IDLE or
// _BEST_EFFORT) and the best-effort level as a saturated word, checked at
// launch against 0..PROCESS_IO_PRIORITY_LEVELS-1.
PROCESS_SPEC_IO_PRIORITY: I64{152}

PROCESS_SPEC_IO_PRIORITY_LEVEL: I64{160}

PROCESS_IO_PRIORITY_UNSET: I64{0}

PROCESS_IO_PRIORITY_IDLE: I64{1}

PROCESS_IO_PRIORITY_BEST_EFFORT: I64{2}

PROCESS_IO_PRIORITY_LEVELS: I64{8}

// `.memory_scope(bytes)`: 1 when set, and the cap as a saturated word,
// checked at launch to be positive (ProcessScope.jet).
PROCESS_SPEC_MEMORY_SCOPE: I64{168}

PROCESS_SPEC_MEMORY_SCOPE_BYTES: I64{176}

// The first refused `.keep_open(handle, at:)`, reported by spawn, run,
// run_checked and plan before any child exists: 0 none, an errno for a failed
// duplication, or one of the PROCESS_KEEP_REFUSED_* codes below.
PROCESS_SPEC_KEEP_REFUSAL: I64{184}

PROCESS_KEEP_REFUSED_SLOT: I64{-1}

PROCESS_KEEP_REFUSED_TAKEN: I64{-2}

PROCESS_SPEC_DEFAULT_OUTPUT_LIMIT: I64{67108864}

// CR4 #4828 one shared native CMS state, not a cloned snapshot.
CMS_BYTES: I64{4112}

CMS_REFS: I64{0}

CMS_MUTEX: I64{8}

CMS_DATA: I64{16}

CMS_ROWS: I64{4}

CMS_COLUMNS: I64{256}

CMS_COUNTER_BYTES: I64{4}

// #4828: shared TDigest40 embeds the canonical sequence header at16.
TD_BYTES: I64{40}

TD_REFS: I64{0}

TD_MUTEX: I64{8}

TD_SEQUENCE: I64{16}

TD_CENTROID_BYTES: I64{16}

TD_MEAN: I64{0}

TD_WEIGHT: I64{8}

// #4828: shared Reservoir64; count and RNG contain complete U64 bit patterns.
RESERVOIR_BYTES: I64{64}

RESERVOIR_REFS: I64{0}

RESERVOIR_MUTEX: I64{8}

RESERVOIR_LIMIT: I64{16}

RESERVOIR_COUNT: I64{24}

RESERVOIR_RNG: I64{32}

RESERVOIR_SEQUENCE: I64{40}
