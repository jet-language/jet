// #4720 SP4. The one owning child for native comptime and session turns.
// Only compiler-produced images are accepted. Values in live slots never cross
// this channel. Each scalar has an explicit kind; integers and float bits are
// decimal strings, so no JSON number coercion or Display reinjection occurs.
use core.encoding as execution_encoding
use core.encoding.json as execution_json
use core.files as execution_files
use core.crypto as execution_crypto
use jet_foundation.[foundation_json_quote]

struct X64ExecutionScalar {
    kind: String
    value: String
    // The checked callable consumes an owning carrier at its entry, including
    // on Stopped. Borrowed inputs remain ours and are released after the call.
    consumed: Bool{true}
}
enum X64ExecutionMode { Comptime Turn }
struct X64ExecutionRequest {
    image: X64MemoryImage
    mode: X64ExecutionMode
    args: [X64ExecutionScalar]
    result_kind: String
    fuel: Int
    depth: Int
    // Logical retained scopes share one child but never share session slots.
    session: Int{0}
    boundary: X64ValueBoundary?{None}
    release: Int?{None}
    closures: [X64ClosureRegistration]{[X64ClosureRegistration]{}}
    // The compiler's canonical Core producer supplies this image. It is
    // admitted once per child generation, independent of logical session close.
    core: X64MemoryImage?{None}
}
struct X64ExecutionResponse {
    // Exactly one response body: tagged lossless value JSON or the canonical
    // shared JetStopRecord JSON (all optional site fields preserved).
    body: String
    stopped: Bool
    invalidated: Bool
    generation: Int
    stdout: [U8]{[U8]{}}
    stderr: [U8]{[U8]{}}
    errors: [String]
    value: X64NativeValue?{None}
}
struct X64ExecutionScopes {
    closed: [Int:Bool]
    core_identity: String{""}
    core_generation: Int{0}
}
struct X64ExecutionHost {
    executable: String
    runtime: String
    runtime_identity: String
    runtime_identity_words: [Int]
    // [pid, fd, generation, stdout, stderr, SHA-256 as 8 u32s, next session].
    // Copying this descriptor never copies live bindings.
    state: Int
    // Descriptor copies share retirement metadata across child generations.
    // A fatal reset may not silently recreate an explicitly closed scope.
    scopes: Shared<X64ExecutionScopes>
    errors: [String]
}
