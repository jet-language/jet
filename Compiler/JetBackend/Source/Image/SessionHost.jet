// The comptime child: one process per compile running the runtime image
// bound to the comptime entry program (JetRuntime ComptimeServe.jet), which
// the compiler drives over ComptimeWire.jet frames and loads each comptime
// batch's code into. The child runs in its own address space, so a stop, a
// refused effect or a crash never reaches the compiler; seccomp refuses its
// effects. It ends with the compiler however the compiler ends
// (x64_comptime_tie).
use {
    core.mem
    jet_foundation.[NameTable, name_find, name_find_bytes, name_index, name_intern_bytes, name_table_sized]
}

// The child's descriptors are kept above every descriptor the child is given
// (0..5), so moving them into place never collides.
X64_COMPTIME_FD_FLOOR: 100

X64_COMPTIME_BUFFER: 262144

X64ComptimeChild: struct {
    pid: Int{0},
    command: Int{-1},
    reply: Int{-1},
    output: Int{-1},
    errors: Int{-1},
    // One mapping: the poll set and clock (first page), then the read buffer.
    scratch: Int{0},
    // The image's entries, in the compiler's table order.
    entries: [Int]{[Int]{}},
    stdout: [U8]{[U8]{}},
    stderr: [U8]{[U8]{}},
    // Milliseconds of child time left (-1: no limit), and whether it ran out.
    budget: Int{-1},
    exhausted: Bool{false},
    // The wait status once the child ended, else -1.
    status: Int{-1},
    failure: String{""},
    // Write end of the child's lifeline (x64_comptime_tie); -1 once closed.
    lifeline: Int{-1},
    // Spawn cookie for admitted `#Impure` calls, and whether they are admitted.
    cookie: Int{0},
    admitted: Bool{false},
    shm: Int{0},
    shm_ready: Bool{false},
    vm_read_ok: Bool{true},
    write_pending: Bool{false},
}

// Starts the linked executable `image` (Image/Loader.jet
// x64_executable_load) in a child and receives its entries; `stdout` admits
// the child's own standard output. An image this process can't load, as when
// its own image holds the image's range (a compiler `jet run` runs), starts
// from a file instead (x64_executable_spawn_file). A failure leaves `failure`
// set.
x64_comptime_spawn: fn(image: X64Executable, stdout: Bool, budget: Int) -> X64ComptimeChild {
    child := X64ComptimeChild{budget: budget}
    scratch: os_map(4096 + X64_COMPTIME_BUFFER, OS_PROT_READ + OS_PROT_WRITE)
    if os_failed(scratch) {
        child.failure = "can't map the comptime child's buffers ({-scratch})"
        return child
    }
    child.scratch = scratch
    // command, reply, output, errors, lifeline: [read end, write end] each.
    // pipes holds ten descriptors in pairs.
    pipes := [Int]{}
    loop _ in 0..<5 {
        ends := [Int]{}
        #Unsafe("the scratch mapping is the child's own, made above") {
            ends = x64_comptime_pipe(scratch)
        }
        if ends.len() != 2 {
            loop fd in pipes -> x64_comptime_close_fd(fd)
            x64_comptime_close(child)
            child.failure = "can't create the comptime child's pipes"
            return child
        }
        pipes.push(ends[0])
        pipes.push(ends[1])
    }
    // No parent_death: the lifeline ends the child with the compiler instead.
    launch: X64Launch{argv: [String]{"jet-comptime"}, env: Val([String]{}), executable: "", name: "jet-comptime", relaunch: [String]{}, parent_death: false, read_scope: [String]{}}
    shm_fd: x64_comptime_shm_open(child)
    fds: x64_comptime_spawn_fds(pipes, shm_fd)
    loaded: x64_executable_load(image)
    spawned := X64Spawned{pid: -1, failure: ""}
    if loaded.failure == "" {
        spawned = x64_image_spawn(loaded, launch, fds)
        x64_image_unload(loaded)
    } else {
        spawned = x64_executable_spawn_file(image, launch, fds)
        if spawned.failure != "" {
            spawned.failure = "{loaded.failure}; from a file: {spawned.failure}"
        }
    }
    x64_comptime_close_fd(pipes[0])
    x64_comptime_close_fd(pipes[3])
    x64_comptime_close_fd(pipes[5])
    x64_comptime_close_fd(pipes[7])
    x64_comptime_close_fd(shm_fd)
    child.command = pipes[1]
    child.reply = pipes[2]
    child.output = pipes[4]
    child.errors = pipes[6]
    child.lifeline = pipes[9]
    if spawned.failure != "" {
        x64_comptime_close_fd(pipes[8])
        child.failure = "can't start the comptime child: {spawned.failure}"
        x64_comptime_close(child)
        return child
    }
    child.pid = spawned.pid
    tied: x64_comptime_tie(pipes[8], child.pid)
    x64_comptime_close_fd(pipes[8])
    if tied != 0 {
        child.failure = "can't tie the comptime child to this process ({-tied})"
        x64_comptime_close(child)
        return child
    }
    hello: x64_comptime_receive(child) ?? {
        child.failure = x64_comptime_end_text(child, "before it started")
        x64_comptime_close(child)
        return child
    }
    child.shm_ready = child.shm != 0 && x64_comptime_word(hello, 16) != 0
    count: x64_comptime_word(hello, 8)
    table: x64_comptime_receive_bytes(child, 8 * count) ?? {
        child.failure = x64_comptime_end_text(child, "before it started")
        x64_comptime_close(child)
        return child
    }
    loop index in 0..<count -> child.entries.push(x64_comptime_word(table, 8 * index))
    if child.entries.len() == 0 || !x64_comptime_filter_child(child, stdout) {
        if child.failure == "" {
            child.failure = x64_comptime_end_text(child, "before it refused its effects")
        }
        x64_comptime_close(child)
    }
    child
}

// Installs the child's seccomp filter and refusal handler (`stdout` admits stdout).
x64_comptime_filter_child: fn(child: &X64ComptimeChild, stdout: Bool) -> Bool {
    loop child.cookie == 0 {
        filled := 0
        #Unsafe("getrandom fills the first word of our scratch page") {
            filled = os_syscall(OS_SYS_GETRANDOM, child.scratch, 8, 0, 0, 0, 0)
        }
        if filled != 8 {
            child.failure = "the comptime child's cookie can't be drawn ({-filled})"
            return false
        }
        #Unsafe("getrandom wrote the scratch page's first word") {
            child.cookie = os_load_word(child.scratch)
        }
    }
    program: x64_comptime_filter(stdout, child.cookie)
    handler: child.entries[0]
    if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_FILTER, [Int]{handler, program.len(), child.cookie}), program) {
        return false
    }
    done: x64_comptime_receive(child) ?? return false
    loop index in 1..<4 {
        result: x64_comptime_word(done, 8 * index)
        if result != 0 {
            child.failure = "the comptime child couldn't refuse its effects (step {index}: {-result})"
            return false
        }
    }
    true
}

// Opens (`open: true`) or closes the child's admission of the file calls an
// `#Impure` block makes; the child answers nothing.
x64_comptime_admit: fn(child: &X64ComptimeChild, open: Bool{false}) -> Bool {
    if child.admitted == open -> return true
    child.admitted = open
    x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_ADMIT, [Int]{if open -> 1 else -> 0}), [U8]{})
}

// What the child left behind when it ended `when`.
x64_comptime_end_text: fn(child: X64ComptimeChild, when: String) -> String Never! {
    if child.failure != "" -> return child.failure
    report: (String.from_bytes(child.stderr) ?? "").trim()
    if report != "" -> return report
    "the comptime child ended {when} (wait status {child.status})"
}

#Unsafe("pipe2 writes two descriptors into the first word of the caller's scratch page")
x64_comptime_pipe: fn(scratch: Int) -> [Int] {
    result: os_syscall(293, scratch, 524288, 0, 0, 0, 0)
    if os_failed(result) -> return [Int]{}
    packed: os_load_word(scratch)
    ends := [Int]{}
    lows: [Int]{packed & 4294967295, (packed >> 32) & 4294967295}
    loop low in lows {
        // F_DUPFD_CLOEXEC above every descriptor the child is given.
        high := 0
        #Unsafe("fcntl duplicates our own descriptor") {
            high = os_syscall(72, low, 1030, X64_COMPTIME_FD_FLOOR, 0, 0, 0)
        }
        x64_comptime_close_fd(low)
        if os_failed(high) -> return [Int]{}
        ends.push(high)
    }
    ends
}

x64_comptime_close_fd: fn(fd: Int) {
    if fd < 0 {
        return
    }
    #Unsafe("closes our own descriptor") { _ := os_syscall(3, fd, 0, 0, 0, 0, 0) }
}

// Ties child `pid` to this process through its lifeline's read end `fd`,
// which the child holds as descriptor 5: the read end signals SIGIO to the
// child (F_SETOWN, then O_ASYNC through F_SETFL) once the pipe's last write
// end closes, and SIGIO's default action ends the child. Only this process
// holds the write end (X64ComptimeChild.lifeline, close-on-exec, and every
// other child closes the descriptors it isn't given), and the kernel closes
// it when this process ends, by a signal (SIGKILL included) or otherwise:
// the child then ends too, even mid-call in compile-time code that never
// reads its command pipe again. PR_SET_PDEATHSIG can't do this, since it
// follows the thread that spawned the child, which may end first. 0, or the
// failed call's result.
x64_comptime_tie: fn(fd: Int, pid: Int) -> Int {
    owned := 0
    #Unsafe("fcntl F_SETOWN names our own child as the owner of our own descriptor's signals") {
        owned = os_syscall(72, fd, 8, pid, 0, 0, 0)
    }
    if os_failed(owned) -> return owned
    flagged := 0
    #Unsafe("fcntl F_SETFL sets O_ASYNC on our own descriptor") {
        flagged = os_syscall(72, fd, 4, 8192, 0, 0, 0)
    }
    if os_failed(flagged) -> return flagged
    0
}

// Writes all of `bytes` to `fd` through the `size`-byte buffer at `buffer`;
// 0 or a failed call's result.
#Unsafe("the caller owns the `size` bytes at `buffer`, a multiple of 8")
x64_comptime_write_all: fn(fd: Int, bytes: [U8], buffer: Int, size: Int) -> Int {
    at := 0
    loop at < bytes.len() {
        count: if bytes.len() - at < size -> bytes.len() - at else -> size
        os_copy_in_range(buffer, bytes, at, count)
        done := 0
        loop done < count {
            moved: os_write(fd, buffer + done, count - done)
            if moved == -4 -> next
            if os_failed(moved) -> return moved
            done += moved
        }
        at += count
    }
    0
}

// Sends one frame and its payload (or stages payload at child.shm when via_shm).
x64_comptime_send: fn(child: &X64ComptimeChild, frame: [U8], payload: [U8], via_shm: Bool{false}) -> Bool {
    if child.pid <= 0 -> return false
    error := 0
    #Unsafe("the buffer is the child's scratch mapping past its first page") {
        if via_shm && child.shm != 0 && payload.len() > 0 && payload.len() <= X64_COMPTIME_SHM_SIZE - 8 {
            os_copy_in_range(child.shm, payload, 0, payload.len())
        }
        // Always write the 64-byte command frame on the command pipe.
        error = x64_comptime_write_all(child.command, frame, child.scratch + 4096, X64_COMPTIME_BUFFER)
        if error == 0 && !via_shm && payload.len() > 0 {
            error = x64_comptime_write_all(child.command, payload, child.scratch + 4096, X64_COMPTIME_BUFFER)
        }
        // Payload was either staged in child.shm or written over child.command.
    }
    if error == 0 -> return x64_comptime_sent(child, frame, via_shm)
    // The child is gone; its end is what its exit says.
    x64_comptime_reap(child, false)
    false
}

// Exactly `count` reply bytes, draining the child's output meanwhile.
x64_comptime_receive_bytes: fn(child: &X64ComptimeChild, count: Int) -> [U8]? {
    bytes := [U8]{}
    if child.pid <= 0 -> return None
    poll: child.scratch
    loop bytes.len() < count {
        // pollfd {fd: i32, events: POLLIN, revents}; a closed (-1) output is skipped.
        ready := 0
        #Unsafe("the poll set is our scratch page's first three entries, which poll reads and writes; the clock words lie past them") {
            os_store_word(poll, child.reply & 4294967295 | 1 << 32)
            os_store_word(poll + 8, child.output & 4294967295 | 1 << 32)
            os_store_word(poll + 16, child.errors & 4294967295 | 1 << 32)
            started: x64_comptime_clock(child.scratch)
            ready = os_syscall(7, poll, 3, child.budget, 0, 0, 0)
            if child.budget >= 0 {
                spent: x64_comptime_clock(child.scratch) - started
                child.budget = if child.budget > spent -> child.budget - spent else -> 0
            }
        }
        if ready == -4 -> next
        if os_failed(ready) {
            child.failure = "can't wait for the comptime child ({-ready})"
            x64_comptime_reap(child, true)
            return None
        }
        if ready == 0 {
            child.exhausted = true
            x64_comptime_reap(child, true)
            return None
        }
        events := [Int]{}
        #Unsafe("poll wrote the entries' returned events") {
            loop index in 0..<3 { events.push((os_load_word(poll + 8 * index) >> 48) & 65535) }
        }
        if events[1] != 0 -> _ := x64_comptime_drain(child, false)
        if events[2] != 0 -> _ := x64_comptime_drain(child, true)
        if events[0] != 0 {
            want: if count - bytes.len() < X64_COMPTIME_BUFFER -> count - bytes.len() else -> X64_COMPTIME_BUFFER
            moved: os_read(child.reply, child.scratch + 4096, want)
            if moved == -4 -> next
            if moved <= 0 {
                x64_comptime_reap(child, false)
                return None
            }
            #Unsafe("os_read just wrote `moved` bytes past the scratch page's first page") {
                x64_comptime_take(child.scratch + 4096, moved, bytes)
            }
        }
    }
    child.write_pending = false
    Val(bytes)
}

// Drains the child's stdout and stderr until neither holds more.
x64_comptime_settle: fn(child: &X64ComptimeChild) {
    if child.pid <= 0 {
        return
    }
    poll: child.scratch
    loop {
        #Unsafe("the poll set is our scratch page's first two entries") {
            os_store_word(poll, child.output & 4294967295 | 1 << 32)
            os_store_word(poll + 8, child.errors & 4294967295 | 1 << 32)
        }
        ready := 0
        #Unsafe("poll reads and writes the two entries of our scratch page") {
            ready = os_syscall(7, poll, 2, 0, 0, 0, 0)
        }
        if ready == -4 -> next
        if ready <= 0 {
            return
        }
        events := [Int]{}
        #Unsafe("poll wrote the entries' returned events") {
            loop index in 0..<2 { events.push((os_load_word(poll + 8 * index) >> 48) & 65535) }
        }
        if events[0] != 0 -> _ := x64_comptime_drain(child, false)
        if events[1] != 0 -> _ := x64_comptime_drain(child, true)
    }
}

// Reads what the child's stdout (or, `errors`, stderr) holds now; false,
// and the pipe closed, at its end.
x64_comptime_drain: fn(child: &X64ComptimeChild, errors: Bool) -> Bool {
    fd: if errors -> child.errors else -> child.output
    if fd < 0 -> return false
    moved: os_read(fd, child.scratch + 4096, X64_COMPTIME_BUFFER)
    if moved == -4 -> return true
    if moved <= 0 {
        x64_comptime_close_fd(fd)
        if errors -> child.errors = -1 else -> child.output = -1
        return false
    }
    #Unsafe("os_read just wrote `moved` bytes past the scratch page's first page") {
        if errors -> x64_comptime_take(child.scratch + 4096, moved, child.stderr) else {
            x64_comptime_take(child.scratch + 4096, moved, child.stdout)
        }
    }
    true
}

// Appends the `count` bytes at `address` (in our mapping) to `bytes` in one
// move.
#Unsafe("the caller's `count` bytes at `address` lie in our mapping")
x64_comptime_take: fn(address: Int, count: Int, bytes: &[U8]) {
    if !mem.list_append<U8>(bytes, mem.Ptr<U8>.from_addr(address), count) {
        panic("the comptime child's {count} reply bytes don't fit in memory")
    }
}

// Monotonic milliseconds.
#Unsafe("clock_gettime writes two words at scratch + 64, past the poll set of the caller's scratch page")
x64_comptime_clock: fn(scratch: Int) -> Int {
    _ := os_syscall(228, 1, scratch + 64, 0, 0, 0, 0)
    os_load_word(scratch + 64) * 1000 + os_load_word(scratch + 72) /% 1000000
}

// Waits for the child (killing it first when `kill`), collecting what it
// wrote on its way out; then its descriptors close.
x64_comptime_reap: fn(child: &X64ComptimeChild, kill: Bool) {
    if child.pid <= 0 {
        return
    }
    if kill {
        #Unsafe("kills our own child") { _ := os_syscall(62, child.pid, 9, 0, 0, 0, 0) }
    }
    // The output pipes end when the child does.
    loop x64_comptime_drain(child, false) {

    }
    loop x64_comptime_drain(child, true) {

    }
    result := 0
    loop {
        #Unsafe("wait4 writes the status word into our scratch page") {
            result = os_syscall(61, child.pid, child.scratch + 80, 0, 0, 0, 0)
        }
        if result != -4 -> break
    }
    #Unsafe("wait4 wrote the status word") {
        child.status = if result == child.pid -> os_load_word(child.scratch + 80) & 4294967295 else -> 0
    }
    child.pid = 0
    x64_comptime_close_fd(child.command)
    x64_comptime_close_fd(child.reply)
    x64_comptime_close_fd(child.output)
    x64_comptime_close_fd(child.errors)
    // The child is gone, so closing its lifeline signals nothing.
    x64_comptime_close_fd(child.lifeline)
    child.command = -1
    child.reply = -1
    child.output = -1
    child.errors = -1
    child.lifeline = -1
}

// Ends a live child and releases its buffers.
x64_comptime_close: fn(child: &X64ComptimeChild) {
    if child.pid > 0 {
        _ := x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_EXIT, [Int]{}), [U8]{})
        x64_comptime_reap(child, false)
    }
    x64_comptime_close_fd(child.command)
    x64_comptime_close_fd(child.reply)
    x64_comptime_close_fd(child.output)
    x64_comptime_close_fd(child.errors)
    x64_comptime_close_fd(child.lifeline)
    child.command = -1
    child.reply = -1
    child.output = -1
    child.errors = -1
    child.lifeline = -1
    if child.shm != 0 {
        _ := os_unmap(child.shm, X64_COMPTIME_SHM_SIZE)
        child.shm = 0
        child.shm_ready = false
    }
    if child.scratch != 0 {
        _ := os_unmap(child.scratch, 4096 + X64_COMPTIME_BUFFER)
        child.scratch = 0
    }
}

// One reply frame, or None once the child ended or ran out of time.
x64_comptime_receive: fn(child: &X64ComptimeChild) -> [U8]? {
    x64_comptime_receive_bytes(child, X64_COMPTIME_FRAME_BYTES)
}

// Opens and maps the child's shared staging memfd; returns the child-side fd
// (above X64_COMPTIME_FD_FLOOR) or -1 if unavailable.
x64_comptime_shm_open: fn(child: &X64ComptimeChild) -> Int {
    raw: loader_memfd(false)
    if os_failed(raw) -> return -1
    sized: os_pwrite64_i64(I64{raw}, I64{child.scratch + 4096}, I64{1}, I64{X64_COMPTIME_SHM_SIZE - 1})
    if sized != (I64{1}) {
        _ := os_close_i64(I64{raw})
        return -1
    }
    mapped: os_map_with(0, X64_COMPTIME_SHM_SIZE, OS_PROT_READ + OS_PROT_WRITE, 1, raw, 0)
    if os_failed(mapped) {
        _ := os_close_i64(I64{raw})
        return -1
    }
    high: Int{os_fcntl_i64(I64{raw}, I64{1030}, I64{X64_COMPTIME_FD_FLOOR})}
    _ := os_close_i64(I64{raw})
    if os_failed(high) {
        _ := os_unmap(mapped, X64_COMPTIME_SHM_SIZE)
        return -1
    }
    child.shm = mapped
    high
}

x64_comptime_spawn_fds: fn(pipes: [Int], shm_fd: Int) -> [Int] Never! {
    if shm_fd >= 0 -> return [Int]{-1, pipes[5], pipes[7], pipes[0], pipes[3], pipes[8], shm_fd}
    [Int]{-1, pipes[5], pipes[7], pipes[0], pipes[3], pipes[8]}
}

// Records an asynchronous pipe WRITE so process_vm_readv drains it first.
x64_comptime_sent: fn(child: &X64ComptimeChild, frame: [U8], via_shm: Bool) -> Bool Never! {
    if !via_shm && x64_comptime_word(frame, 0) == X64_COMPTIME_WRITE -> child.write_pending = true
    true
}

// Reads `count` bytes from `address` in the child via process_vm_readv (zero
// pipe round-trips, zero child wakeups), falling back to pipe READ if blocked.
x64_comptime_read_memory: fn(child: &X64ComptimeChild, address: Int, count: Int) -> [U8]? {
    if count <= 0 -> return Val([U8]{})
    if !child.write_pending && child.vm_read_ok && child.pid > 0 && child.scratch != 0 {
        trace: X64Trace{pid: child.pid, scratch: child.scratch, failure: "", thread: child.pid}
        if x64_trace_read(trace, address, count, chunk: X64_COMPTIME_BUFFER) == .Val(got) {
            if got.len() == count -> return Val(got)
        }
    }
    was_pending: child.write_pending
    if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_READ, [Int]{address, count}), [U8]{}) {
        return None
    }
    bytes: x64_comptime_receive_bytes(child, count) ?? return None
    if !was_pending && child.vm_read_ok -> child.vm_read_ok = false
    Val(bytes)
}

// Creates a runtime String from `bytes` via the shared staging window when it
// fits, avoiding pipe payload writes and child scratch allocation.
x64_comptime_shm_text: fn(child: &X64ComptimeChild, bytes: [U8]) -> Int? {
    if !child.shm_ready || bytes.len() > X64_COMPTIME_SHM_SIZE - 8 -> return None
    if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_SHM_TEXT, [Int]{bytes.len()}), bytes, via_shm: true) {
        return None
    }
    reply: x64_comptime_receive(child) ?? return None
    if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
        child.failure = "the comptime child answered SHM_TEXT with frame {x64_comptime_word(reply, 0)}"
        x64_comptime_reap(child, true)
        return None
    }
    Val(x64_comptime_word(reply, 8))
}

// Writes `bytes` at `address` in the child through the shared staging window
// when it fits; returns false if SHM is unavailable or the write failed.
x64_comptime_shm_write: fn(child: &X64ComptimeChild, address: Int, bytes: [U8]) -> Bool {
    if !child.shm_ready || bytes.len() > X64_COMPTIME_SHM_SIZE - 8 -> return false
    if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_SHM_WRITE, [Int]{address, bytes.len()}), bytes, via_shm: true) {
        return false
    }
    reply: x64_comptime_receive(child) ?? return false
    if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
        child.failure = "the comptime child answered SHM_WRITE with frame {x64_comptime_word(reply, 0)}"
        x64_comptime_reap(child, true)
        return false
    }
    true
}

// The part of an executable bound at a program base (MemoryLink.jet
// x64_bind_runtime_image_at) from address `from` up: its segments, whose
// offsets index `bytes`, and the page its last one ends before; or why the
// executable has none. Those segments lie in the executable's program part
// (`tail`), so neither its image part nor its file is needed.
X64ComptimeCode: struct {
    segments: [X64Segment],
    bytes: [U8],
    high: Int,
    failure: String,
}

x64_comptime_code: fn(exe: X64Executable, from: Int) -> X64ComptimeCode Never! {
    parsed: loader_segments(x64_executable_header(exe), exe.tail, exe.tail_at, exe.tail_at + exe.tail.len())
    code := X64ComptimeCode{segments: [X64Segment]{}, bytes: [U8]{}, high: from, failure: parsed.failure}
    if parsed.failure != "" -> return code
    first := -1
    last := 0
    loop segment in parsed.segments {
        if segment.vaddr < from -> next
        if first < 0 || segment.offset < first -> first = segment.offset
        if segment.offset + segment.file_size > last -> last = segment.offset + segment.file_size
    }
    if first < 0 -> return code
    if first < exe.tail_at {
        code.failure = "a segment from {from} up lies before the program part"
        return code
    }
    code.bytes.extend(exe.tail[(first - exe.tail_at)..<(last - exe.tail_at)])
    loop segment in parsed.segments {
        if segment.vaddr < from -> next
        code.segments.push(X64Segment{vaddr: segment.vaddr, file_size: segment.file_size, memory_size: segment.memory_size, flags: segment.flags, offset: segment.offset - first})
        end: os_page_round(segment.vaddr + segment.memory_size)
        if end > code.high -> code.high = end
    }
    code
}

// Loads `code` into the child: in one shared-memory round-trip when the batch
// fits in the staging window, else per-segment MAP/WRITE/PROTECT over pipes.
x64_comptime_load: fn(child: &X64ComptimeChild, code: X64ComptimeCode) -> String {
    table_bytes: code.segments.len() * 48
    if child.shm_ready && code.segments.len() > 0 && table_bytes + code.bytes.len() <= X64_COMPTIME_SHM_SIZE - 8 {
        staged := [U8]{}
        staged.try_reserve(table_bytes + code.bytes.len()) ?? panic("reserve failed")
        loop segment in code.segments {
            low: segment.vaddr - segment.vaddr % OS_PAGE_SIZE
            end: os_page_round(segment.vaddr + segment.memory_size)
            protection := 0
            if segment.flags & 1 != 0 -> protection += 4
            if segment.flags & 2 != 0 -> protection += 2
            if segment.flags & 4 != 0 -> protection += 1
            x64_comptime_put_word(staged, low)
            x64_comptime_put_word(staged, end - low)
            x64_comptime_put_word(staged, segment.vaddr)
            x64_comptime_put_word(staged, segment.file_size)
            x64_comptime_put_word(staged, protection)
            x64_comptime_put_word(staged, table_bytes + segment.offset)
        }
        if code.bytes.len() > 0 -> staged.extend(code.bytes)
        if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_SHM_LOAD, [Int]{code.segments.len()}), staged, via_shm: true) {
            return x64_comptime_end_text(child, "while its code loaded")
        }
        reply: x64_comptime_receive(child) ?? return x64_comptime_end_text(child, "while its code loaded")
        if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
            child.failure = "the comptime child answered SHM_LOAD with frame {x64_comptime_word(reply, 0)}"
            x64_comptime_reap(child, true)
            return x64_comptime_end_text(child, "while its code loaded")
        }
        status: x64_comptime_word(reply, 8)
        if status != 0 {
            return "the comptime child couldn't load its code via shared memory ({status})"
        }
        return ""
    }
    loop segment in code.segments {
        low: segment.vaddr - segment.vaddr % OS_PAGE_SIZE
        end: os_page_round(segment.vaddr + segment.memory_size)
        mapped: x64_comptime_ask(child, X64_COMPTIME_MAP, [Int]{low, end - low}) ?? return x64_comptime_end_text(child, "while its code loaded")
        if mapped != low {
            return "the comptime child couldn't map {end - low} bytes at {low} ({mapped})"
        }
        if segment.file_size > 0 {
            bytes := [U8]{}
            bytes.extend(code.bytes[segment.offset..<(segment.offset + segment.file_size)])
            if !x64_comptime_send(child, x64_comptime_frame(X64_COMPTIME_WRITE, [Int]{segment.vaddr, segment.file_size}), bytes) {
                return x64_comptime_end_text(child, "while its code loaded")
            }
        }
        // PF_X, PF_W, PF_R to PROT_EXEC, PROT_WRITE, PROT_READ.
        protection := 0
        if segment.flags & 1 != 0 -> protection += 4
        if segment.flags & 2 != 0 -> protection += 2
        if segment.flags & 4 != 0 -> protection += 1
        protected: x64_comptime_ask(child, X64_COMPTIME_PROTECT, [Int]{low, end - low, protection}) ?? return x64_comptime_end_text(child, "while its code loaded")
        if protected != 0 {
            return "the comptime child couldn't protect its code at {low} ({protected})"
        }
    }
    ""
}

// Sends command `kind` and returns its DONE word; None when the child
// ended or answered anything else.
x64_comptime_ask: fn(child: &X64ComptimeChild, kind: Int, operands: [Int]) -> Int? {
    if !x64_comptime_send(child, x64_comptime_frame(kind, operands), [U8]{}) -> return None
    reply: x64_comptime_receive(child) ?? return None
    if x64_comptime_word(reply, 0) != X64_COMPTIME_DONE {
        child.failure = "the comptime child answered command {kind} with frame {x64_comptime_word(reply, 0)}"
        x64_comptime_reap(child, true)
        return None
    }
    Val(x64_comptime_word(reply, 8))
}

// Symbols by name: each name's address by its id in `names` (-1: no such
// symbol).
X64ComptimeSymbols: struct {
    names: NameTable,
    address: [Int],
}

// The address of the symbol `name`, when `symbols` holds one.
x64_comptime_symbol_address: fn(symbols: X64ComptimeSymbols, name: String) -> Int? Never! {
    id: name_find(symbols.names, name) ?? return None
    at: symbols.address[name_index(id)]
    if at < 0 -> return None
    Val(at)
}

// The defined symbols of an executable (its `.symtab`) whose names start
// with `prefix`, with their addresses: `header` is its ELF header (its first
// 64 bytes) and `file` its bytes from file offset `file_at` on, which hold
// its section headers and symbol table (a whole file from 0, or the program
// part of one bound at a program base). `globals` keeps only the global and
// weak ones, which are what a bound program's imports resolve to.
x64_comptime_symbols: fn(header: [U8], file: [U8], file_at: Int, prefix: String, globals: Bool) -> X64ComptimeSymbols Never! {
    found := X64ComptimeSymbols{names: name_table_sized(1024), address: [Int]{-1}}
    if header.len() < 64 -> return found
    start: prefix.bytes()
    sections: x64_comptime_unsigned(header, 40, 8) - file_at
    header_size: x64_comptime_unsigned(header, 58, 2)
    count: x64_comptime_unsigned(header, 60, 2)
    if sections < 0 -> return found
    loop section in 0..<count {
        section_header: sections + section * header_size
        if section_header + 64 > file.len() -> break
        // SHT_SYMTAB
        if x64_comptime_unsigned(file, section_header + 4, 4) != 2 -> next
        offset: x64_comptime_unsigned(file, section_header + 24, 8) - file_at
        size: x64_comptime_unsigned(file, section_header + 32, 8)
        strings_header: sections + x64_comptime_unsigned(file, section_header + 40, 4) * header_size
        entry_size: x64_comptime_unsigned(file, section_header + 56, 8)
        if entry_size < 24 || offset < 0 || strings_header + 64 > file.len() -> next
        strings: x64_comptime_unsigned(file, strings_header + 24, 8) - file_at
        if strings < 0 -> next
        loop symbol in 0..<(size /% entry_size) {
            entry: offset + symbol * entry_size
            if entry + 24 > file.len() -> break
            // SHN_UNDEF: an import, not a definition.
            if x64_comptime_unsigned(file, entry + 6, 2) == 0 -> next
            // STB_LOCAL
            if globals && file[entry + 4] < (U8{16}) -> next
            at: strings + x64_comptime_unsigned(file, entry, 4)
            matches := at + start.len() <= file.len()
            loop (index, byte) in start {
                if !matches -> break
                if file[at + index] != byte -> matches = false
            }
            if !matches -> next
            end := at
            loop end < file.len() && file[end] != (U8{0}) -> end += 1
            // A name that is not UTF-8 gets an id that no String finds.
            id: name_index(name_intern_bytes(found.names, file, at, end))
            loop found.address.len() <= id -> found.address.push(-1)
            found.address[id] = x64_comptime_unsigned(file, entry + 8, 8)
        }
    }
    found
}

// A function's code in a bound batch, [start, end), and the id its symbol
// has in the table x64_comptime_functions read it by.
X64ComptimeFunction: struct {
    start: Int,
    end: Int,
    name: Int,
}

// The function symbols (STT_FUNC) of an executable's `.symtab` that
// `symbols` holds, by start address; read as x64_comptime_symbols reads it
// (`header` the ELF header, `file` the bytes from file offset `file_at` on).
// With `every`, a function's symbol `symbols` doesn't hold yet is added.
x64_comptime_functions: fn(header: [U8], file: [U8], file_at: Int, symbols: &NameTable, every: Bool{false}) -> [X64ComptimeFunction] Never! {
    found := [X64ComptimeFunction]{}
    if header.len() < 64 -> return found
    sections: x64_comptime_unsigned(header, 40, 8) - file_at
    header_size: x64_comptime_unsigned(header, 58, 2)
    count: x64_comptime_unsigned(header, 60, 2)
    if sections < 0 -> return found
    loop section in 0..<count {
        section_header: sections + section * header_size
        if section_header + 64 > file.len() -> break
        // SHT_SYMTAB
        if x64_comptime_unsigned(file, section_header + 4, 4) != 2 -> next
        offset: x64_comptime_unsigned(file, section_header + 24, 8) - file_at
        size: x64_comptime_unsigned(file, section_header + 32, 8)
        strings_header: sections + x64_comptime_unsigned(file, section_header + 40, 4) * header_size
        entry_size: x64_comptime_unsigned(file, section_header + 56, 8)
        if entry_size < 24 || offset < 0 || strings_header + 64 > file.len() -> next
        strings: x64_comptime_unsigned(file, strings_header + 24, 8) - file_at
        if strings < 0 -> next
        loop symbol in 0..<(size /% entry_size) {
            entry: offset + symbol * entry_size
            if entry + 24 > file.len() -> break
            // STT_FUNC
            if (Int{file[entry + 4]}) & 15 != 2 -> next
            at: strings + x64_comptime_unsigned(file, entry, 4)
            end := at
            loop end < file.len() && file[end] != (U8{0}) -> end += 1
            if at >= end -> next
            held: if every -> Val(name_intern_bytes(symbols, file, at, end)) else -> name_find_bytes(symbols, file, at, end)
            name: held ?? next
            start: x64_comptime_unsigned(file, entry + 8, 8)
            found.push(X64ComptimeFunction{start: start, end: start + x64_comptime_unsigned(file, entry + 16, 8), name: name_index(name)})
        }
    }
    found.sort_by(fn(left: X64ComptimeFunction, right: X64ComptimeFunction) { left.start <=> right.start })
    found
}

// The symbol id of the function of `functions` (x64_comptime_functions)
// whose code holds `address`; None when none does.
x64_comptime_function_at: fn(functions: [X64ComptimeFunction], address: Int) -> Int? Never! {
    low := 0
    high := functions.len()
    loop low < high {
        middle: (low + high) /% 2
        if functions[middle].start <= address -> low = middle + 1 else -> high = middle
    }
    if low == 0 || address >= functions[low - 1].end -> return None
    Val(functions[low - 1].name)
}
