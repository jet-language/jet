// Static archive reading for the in-process linker (Image/StaticLink.jet):
// the System V / GNU `ar` format that rustc rlibs, musl's libc.a and
// libgcc_eh.a all use. An archive is the 8-byte magic `!<arch>\n`, then
// members, each a 60-byte text header (name, dates, mode, decimal size, "`\n")
// followed by its bytes padded to an even offset. Two special members carry
// the symbol index (`/`: big-endian count, member header offsets, then the
// NUL-terminated names; `/SYM64/` is the same with 8-byte words) and the long
// name table (`//`: names ending "/\n", referenced as `/<offset>`). Members
// are read in place: the archive keeps offsets into its own bytes.

pub struct LinkArchive {
    pub path: String
    // Per member, in archive order: its name, where its bytes start and how
    // many there are. Special members are not listed.
    pub names: [String]
    pub starts: [Int]
    pub sizes: [Int]
    // The symbol index in archive order: each name and the ordinal of the
    // member that defines it (an earlier entry wins over a later one).
    pub symbol_names: [String]
    pub symbol_members: [Int]
    pub errors: [String]
}

LINK_AR_HEADER_SIZE :: prep { 60 }

fn link_ar_decimal(bytes: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width {
        code :: Int.from_u8(bytes[at + k])
        if code < 48 || code > 57 -> return value
        value = value * 10 + code - 48
    }
    value
}

fn link_ar_be(bytes: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    loop k in 0..<width -> value = (value << 8) | Int.from_u8(bytes[at + k])
    value
}

// The text of `bytes[at..<end]` up to (not including) the first byte equal
// to `stop`.
fn link_ar_text(bytes: [U8], at: Int, end: Int, stop: Int) -> String Never! {
    last := at
    loop last < end && Int.from_u8(bytes[last]) != stop -> last += 1
    String.from_bytes(bytes[at..<last]) ?? ""
}

fn link_ar_failure(path: String, message: String) -> LinkArchive Never! {
    LinkArchive{path: path, names: [String]{}, starts: [Int]{}, sizes: [Int]{}, symbol_names: [String]{}, symbol_members: [Int]{}, errors: [String]{"{path}: {message}"}}
}

// Read the member table and symbol index of the archive `bytes` (from `path`).
pub fn link_read_archive(path: String, bytes: [U8]) -> LinkArchive Never! {
    magic :: [Int]{0x21, 0x3c, 0x61, 0x72, 0x63, 0x68, 0x3e, 0x0a}
    if bytes.len() < 8 -> return link_ar_failure(path, "not an archive (too short)")
    loop (k, byte) in magic {
        if Int.from_u8(bytes[k]) != byte -> return link_ar_failure(path, "not an `ar` archive (thin and BSD archives are not supported)")
    }
    archive := LinkArchive{path: path, names: [String]{}, starts: [Int]{}, sizes: [Int]{}, symbol_names: [String]{}, symbol_members: [Int]{}, errors: [String]{}}
    // Header offset of every ordinary member, to translate index entries.
    ordinals := [Int:Int]{}
    index_at := -1
    index_size := 0
    index_word := 4
    long_names_at := -1
    long_names_end := -1
    at := 8
    loop at + LINK_AR_HEADER_SIZE <= bytes.len() {
        if Int.from_u8(bytes[at + 58]) != 0x60 || Int.from_u8(bytes[at + 59]) != 0x0a {
            &archive.errors.push("{path}: malformed member header at offset {at}")
            return archive
        }
        size :: link_ar_decimal(bytes, at + 48, 10)
        start :: at + LINK_AR_HEADER_SIZE
        if start + size > bytes.len() {
            &archive.errors.push("{path}: member at offset {at} runs past the end of the archive")
            return archive
        }
        first :: Int.from_u8(bytes[at])
        second :: Int.from_u8(bytes[at + 1])
        if first == 0x2f && second == 0x20 {
            index_at = start
            index_size = size
            index_word = 4
        } else if first == 0x2f && link_ar_text(bytes, at, at + 16, 0x20) == "/SYM64/" {
            index_at = start
            index_size = size
            index_word = 8
        } else if first == 0x2f && second == 0x2f {
            long_names_at = start
            long_names_end = start + size
        } else {
            name := ""
            if first == 0x2f {
                // `/<decimal>`: an offset into the long name table.
                offset :: link_ar_decimal(bytes, at + 1, 15)
                if long_names_at < 0 || long_names_at + offset >= long_names_end {
                    &archive.errors.push("{path}: member at offset {at} names a missing long name")
                    return archive
                }
                name = link_ar_text(bytes, long_names_at + offset, long_names_end, 0x2f)
            } else {
                name = link_ar_text(bytes, at, at + 16, 0x2f)
            }
            &ordinals.add(at, archive.names.len()).drop("member header offsets are unique")
            &archive.names.push(name)
            &archive.starts.push(start)
            &archive.sizes.push(size)
        }
        at = start + size + size % 2
    }
    if index_at < 0 {
        &archive.errors.push("{path}: the archive has no symbol index (run `ranlib` on it)")
        return archive
    }
    count :: link_ar_be(bytes, index_at, index_word)
    names_at := index_at + index_word * (count + 1)
    index_end :: index_at + index_size
    if names_at > index_end {
        &archive.errors.push("{path}: the symbol index is truncated")
        return archive
    }
    loop k in 0..<count {
        header :: link_ar_be(bytes, index_at + index_word * (k + 1), index_word)
        end := names_at
        loop end < index_end && Int.from_u8(bytes[end]) != 0 -> end += 1
        name :: String.from_bytes(bytes[names_at..<end]) ?? ""
        names_at = end + 1
        member :: ordinals.get(header) ?? {
            &archive.errors.push("{path}: symbol `{name}` points at offset {header}, which is not a member")
            next
        }
        &archive.symbol_names.push(name)
        &archive.symbol_members.push(member)
    }
    archive
}
