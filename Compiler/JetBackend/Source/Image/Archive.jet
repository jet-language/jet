// Static archives, read for the in-process linker (Image/StaticLink.jet)
// and written for a native library (x64_static_archive), in
// the System V / GNU `ar` format that rustc rlibs, musl's libc.a and
// libgcc_eh.a all use. An archive is the 8-byte magic `!<arch>\n`, then
// members, each a 60-byte text header (name, dates, mode, decimal size, "`\n")
// followed by its bytes padded to an even offset. Two special members carry
// the symbol index (`/`: big-endian count, member header offsets, then the
// NUL-terminated names; `/SYM64/` is the same with 8-byte words) and the long
// name table (`//`: names ending "/\n", referenced as `/<offset>`). Members
// are read in place: the archive keeps offsets into its own bytes.

LinkArchive: struct {
    path: String,
    // Per member, in archive order: its name, where its bytes start and how
    // many there are. Special members are not listed.
    names: [String],
    starts: [Int],
    sizes: [Int],
    // The symbol index in archive order: each name and the ordinal of the
    // member that defines it (an earlier entry wins over a later one).
    symbol_names: [String],
    symbol_members: [Int],
    errors: [String],
}

LINK_AR_HEADER_SIZE: 60

link_ar_decimal: fn(bytes: [U8], at: Int, width: Int) -> Int Never! {
    ^value: 0
    loop k in 0..<width {
        code: Int{bytes[at + k]}
        if code < 48 || code > 57 -> return value
        value = value * 10 + code - 48
    }
    value
}

link_ar_be: fn(bytes: [U8], at: Int, width: Int) -> Int Never! {
    ^value: 0
    loop k in 0..<width -> value = (value << 8) | Int{bytes[at + k]}
    value
}

// The text of `bytes[at..<end]` up to (not including) the first byte equal
// to `stop`.
link_ar_text: fn(bytes: [U8], at: Int, end: Int, stop: Int) -> String Never! {
    ^last: at
    loop last < end && (Int{bytes[last]}) != stop -> last += 1
    String.from_bytes(bytes[at..<last]) ?? ""
}

link_ar_failure: fn(path: String, message: String) -> LinkArchive Never! {
    LinkArchive{path: path, names: [String]{}, starts: [Int]{}, sizes: [Int]{}, symbol_names: [String]{}, symbol_members: [Int]{}, errors: [String]{"{path}: {message}"}}
}

// Read the member table and symbol index of the archive `bytes` (from `path`).
link_read_archive: fn(path: String, bytes: [U8]) -> LinkArchive Never! {
    magic: [Int]{0x21, 0x3c, 0x61, 0x72, 0x63, 0x68, 0x3e, 0x0a}
    if bytes.len() < 8 -> return link_ar_failure(path, "not an archive (too short)")
    loop (k, byte) in magic {
        if (Int{bytes[k]}) != byte {
            return link_ar_failure(path, "not an `ar` archive (thin and BSD archives are not supported)")
        }
    }
    ^archive: LinkArchive{path: path, names: [String]{}, starts: [Int]{}, sizes: [Int]{}, symbol_names: [String]{}, symbol_members: [Int]{}, errors: [String]{}}
    // Header offset of every ordinary member, to translate index entries.
    ^ordinals: [Int:Int]{}
    ^index_at: -1
    ^index_size: 0
    ^index_word: 4
    ^long_names_at: -1
    ^long_names_end: -1
    ^at: 8
    loop at + LINK_AR_HEADER_SIZE <= bytes.len() {
        if (Int{bytes[at + 58]}) != 0x60 || (Int{bytes[at + 59]}) != 0x0a {
            archive.errors.push("{path}: malformed member header at offset {at}")
            return archive
        }
        size: link_ar_decimal(bytes, at + 48, 10)
        start: at + LINK_AR_HEADER_SIZE
        if start + size > bytes.len() {
            archive.errors.push("{path}: member at offset {at} runs past the end of the archive")
            return archive
        }
        first: Int{bytes[at]}
        second: Int{bytes[at + 1]}
        if {
            first == 0x2f && second == 0x20 -> {
                index_at = start
                index_size = size
                index_word = 4
            }
            first == 0x2f && link_ar_text(bytes, at, at + 16, 0x20) == "/SYM64/" -> {
                index_at = start
                index_size = size
                index_word = 8
            }
            first == 0x2f && second == 0x2f -> {
                long_names_at = start
                long_names_end = start + size
            }
            else -> {
                ^name: ""
                if {
                    first == 0x2f -> {
                        // `/<decimal>`: an offset into the long name table.
                        offset: link_ar_decimal(bytes, at + 1, 15)
                        if long_names_at < 0 || long_names_at + offset >= long_names_end {
                            archive.errors.push("{path}: member at offset {at} names a missing long name")
                            return archive
                        }
                        name = link_ar_text(bytes, long_names_at + offset, long_names_end, 0x2f)
                    }
                    else -> { name = link_ar_text(bytes, at, at + 16, 0x2f) }
                }
                ordinals.add(at, archive.names.len()).drop("member header offsets are unique")
                archive.names.push(name)
                archive.starts.push(start)
                archive.sizes.push(size)
            }
        }
        at = start + size + size % 2
    }
    if index_at < 0 {
        archive.errors.push("{path}: the archive has no symbol index (run `ranlib` on it)")
        return archive
    }
    count: link_ar_be(bytes, index_at, index_word)
    ^names_at: index_at + index_word * (count + 1)
    index_end: index_at + index_size
    if names_at > index_end {
        archive.errors.push("{path}: the symbol index is truncated")
        return archive
    }
    loop k in 0..<count {
        header: link_ar_be(bytes, index_at + index_word * (k + 1), index_word)
        ^end: names_at
        loop end < index_end && (Int{bytes[end]}) != 0 -> end += 1
        name: String.from_bytes(bytes[names_at..<end]) ?? ""
        names_at = end + 1
        member: ordinals.get(header) ?? {
            archive.errors.push("{path}: symbol `{name}` points at offset {header}, which is not a member")
            next
        }
        archive.symbol_names.push(name)
        archive.symbol_members.push(member)
    }
    archive
}

// The global and weak symbols the ELF relocatable object `objects[b]` (the
// member `name`) defines, in symbol table order. A member that is no 64-bit
// little-endian relocatable object is a row in `errors`.
link_ar_defined: fn(objects: [[U8]], b: Int, name: String, errors: ^[String]) -> [String] Never! {
    ^defined: [String]{}
    if objects[b].len() < 64 || link_u32(objects, b, 0) != 0x464c457f || link_u8(objects, b, 4) != 2 || link_u8(objects, b, 5) != 1 || link_u16(objects, b, 16) != 1 {
        errors.push("archive member `{name}` is not a 64-bit little-endian ELF relocatable object")
        return defined
    }
    shoff: link_u64(objects, b, 40)
    ^count: link_u16(objects, b, 60)
    // Extended numbering: the real count lives in section header 0.
    if count == 0 -> count = link_u64(objects, b, shoff + 32)
    loop k in 1..<count {
        header: shoff + 64 * k
        if link_u32(objects, b, header + 4) != LINK_SHT_SYMTAB -> next
        symbols: link_u64(objects, b, header + 24)
        total: link_u64(objects, b, header + 32).div_euclid(24)
        strings: link_u64(objects, b, shoff + 64 * link_u32(objects, b, header + 40) + 24)
        // The locals come first; the header's info is the first global.
        loop index in link_u32(objects, b, header + 44)..<total {
            at: symbols + 24 * index
            bind: link_u8(objects, b, at + 4) >> 4
            // A section index of 0 is an undefined reference.
            if (bind == 1 || bind == 2) && link_u16(objects, b, at + 6) != 0 {
                symbol: link_cstr(objects, b, strings + link_u32(objects, b, at))
                if symbol != "" -> defined.push(symbol)
            }
        }
    }
    defined
}

// `text` left-aligned in a header field of `width` bytes, padded with spaces.
link_ar_field: fn(out: ^[U8], text: String, width: Int) Never! {
    out.extend(text.bytes())
    loop _ in text.len()..<width -> out.push(U8{0x20})
}

link_ar_be32: fn(out: ^[U8], value: Int) Never! {
    out.push(U8{(value >> 24) & 255})
    out.push(U8{(value >> 16) & 255})
    out.push(U8{(value >> 8) & 255})
    out.push(U8{value & 255})
}

// One member: its 60-byte header (`name`, zero dates and owners, mode 644,
// the size), its bytes, and a newline padding it to an even offset.
link_ar_member: fn(out: ^[U8], name: String, bytes: [U8]) Never! {
    link_ar_field(out, name, 16)
    link_ar_field(out, "0", 12)
    link_ar_field(out, "0", 6)
    link_ar_field(out, "0", 6)
    link_ar_field(out, "644", 8)
    link_ar_field(out, "{bytes.len()}", 10)
    out.push(U8{0x60})
    out.push(U8{0x0a})
    loop byte in bytes -> out.push(byte)
    if bytes.len() % 2 == 1 -> out.push(U8{0x0a})
}

// The static archive of the ELF relocatable objects `objects`, member k
// named `names[k]`, as `ar rcs` writes it: the `/` symbol index of every
// global and weak symbol a member defines, so a C linker pulls in the
// members it needs, then the members. A name is 1 to 15 bytes with no `/`,
// so the archive needs no long name table. Each problem is a row in
// `errors`, and then there are no bytes.
x64_static_archive: fn(names: [String], objects: [[U8]]) -> X64ExecutableResult Never! {
    ^errors: [String]{}
    if names.len() != objects.len() {
        errors.push("an archive of {objects.len()} members has {names.len()} names")
        return X64ExecutableResult{bytes: [U8]{}, errors: errors}
    }
    ^symbols: [String]{}
    ^owners: [Int]{}
    loop (k, name) in names {
        if name.len() == 0 || name.len() > 15 || name.contains("/") {
            errors.push("archive member name `{name}` is not 1 to 15 bytes without a `/`")
        }
        loop symbol in link_ar_defined(objects, k, name, errors) {
            symbols.push(symbol)
            owners.push(k)
        }
    }
    if errors.len() > 0 -> return X64ExecutableResult{bytes: [U8]{}, errors: errors}
    // The index: the symbol count, each symbol's member header offset, then
    // the names. Its size places the members.
    ^index_size: 4 + 4 * symbols.len()
    loop symbol in symbols -> index_size += symbol.len() + 1
    ^starts: [Int]{}
    ^at: 8 + LINK_AR_HEADER_SIZE + index_size + index_size % 2
    loop object in objects {
        starts.push(at)
        at += LINK_AR_HEADER_SIZE + object.len() + object.len() % 2
    }
    ^index: [U8]{}
    link_ar_be32(index, symbols.len())
    loop owner in owners -> link_ar_be32(index, starts[owner])
    loop symbol in symbols {
        index.extend(symbol.bytes())
        index.push(U8{0})
    }
    ^out: [U8]{}
    out.extend("!<arch>\n".bytes())
    link_ar_member(out, "/", index)
    loop (k, object) in objects -> link_ar_member(out, "{names[k]}/", object)
    X64ExecutableResult{bytes: out.move(), errors: errors}
}
