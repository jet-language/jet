// The debug sections of a linked image: the dropped functions' records
// leave them, and `.debug_jetline` takes its linked form.
//
// The link drops every function no live section reaches, and a dropped
// function's start relocates below `.text`, to its offset in its own
// section. Its debug records name code the image doesn't hold: its
// subprogram in `.debug_info` with its variables' location lists in
// `.debug_loclists` and its inline runs' range lists in `.debug_rnglists`,
// its sequence in `.debug_line` and its record in `.debug_jetline`. They
// leave together, after relocation: a record goes exactly when its start
// address (a subprogram's DW_AT_low_pc, an index into `.debug_addr`) is
// outside [text_start, text_end). The kept bytes keep their order, and the
// offsets into them (unit lengths, DW_AT_stmt_list, DW_AT_loclists_base,
// DW_AT_rnglists_base and DW_FORM_ref4 values) move with them. A list
// unit keeps its offsets table, so the list indexes (DW_FORM_loclistx,
// DW_FORM_rnglistx) stay; `.debug_addr` stays as linked, a dropped
// function's slot naming its start below `.text`. A `.debug_info` unit the
// walk can't read (a form Image/Dwarf.jet doesn't write) leaves the DWARF
// sections as linked.
//
// `.debug_jetline` arrives as the object blocks Image/Dwarf.jet
// dwarf_jet_line writes, fixed-size records the relocations fill in, and
// leaves as one linked block per object block, which the fault report
// (Compiler/JetRuntime/Assets/FaultReport/report.S `find`) and `jet crash`
// (Image/Jetline.jet) scan:
//   u32 length of the block after this word, u32 function count, u32
//   offset of the strings (from the block's start), u64 base address; then
//   per function, in address order, an sleb, the start's distance from the
//   previous function's end (the first's from the base), then five ulebs:
//   the code length, the name and the file path (string offsets), the
//   declaration line and the byte length of its rows, followed by those
//   rows as the object block holds them. Strings: the compilation
//   directory at 0 (the runtime library's block's is
//   X64_JETLINE_RUNTIME_DIRECTORY, Jetline.jet), then the names and the
//   paths, each string once, NUL terminated.
use jet_foundation.[compiler_take_rows]

// The bytes of each debug group in `debug.names` order, relocated, with
// the dropped functions' records removed.
link_debug_bytes: fn(c: &LinkContext, debug: LinkDebug, pieces: &LinkPieces, text_start: Int, text_end: Int) -> [[U8]] Never! {
    groups := [[U8]]{}
    loop group in 0..<debug.names.len() {
        bytes := [U8]{}
        rows: debug.rows[group]
        if rows.len() == 1 && c.live_addr[rows[0]] == 0 && pieces.bytes.len() > 0 && pieces.chunks[rows[0]].len() == 0 {
            row: rows[0]
            bytes = compiler_take_rows<U8>(pieces.bytes[row])
            c.errors.extend(pieces.errors[row])
        } else {
            if debug.sizes[group] > 0 {
                bytes.try_reserve(debug.sizes[group]) ?? panic("reserve failed")
            }
            loop row in rows {
                link_pad_to(bytes, c.live_addr[row], 0)
                link_place_row(c, bytes, pieces, row)
            }
        }
        link_pad_to(bytes, debug.sizes[group], 0)
        groups.push(bytes.move())
    }
    info := -1
    abbrev := -1
    line := -1
    lists := -1
    ranges := -1
    addr := -1
    loop (group, name) in debug.names {
        if name == ".debug_info" -> info = group
        if name == ".debug_abbrev" -> abbrev = group
        if name == ".debug_line" -> line = group
        if name == ".debug_loclists" -> lists = group
        if name == ".debug_rnglists" -> ranges = group
        if name == ".debug_addr" -> addr = group
        if name == ".debug_jetline" && !link_jetline_link(groups[group], text_start, text_end) {
            c.errors.push("malformed .debug_jetline: a block's records, strings or rows run past it")
        }
    }
    if info < 0 || abbrev < 0 -> return groups
    if link_debug_all_live(c, debug, info, line, addr, groups, text_start, text_end) {
        return groups
    }
    planned: if addr >= 0 -> link_info_plan(groups[info], groups[abbrev], groups[addr], text_start, text_end) else -> link_info_plan(groups[info], groups[abbrev], [U8]{}, text_start, text_end)
    plan: planned ?? return groups
    line_offsets := [Int:Int]{}
    if line >= 0 -> link_line_prune(groups[line], text_start, text_end, line_offsets)
    list_tables := [Int:Int]{}
    if lists >= 0 -> link_lists_prune(groups[lists], plan.list_refs, list_tables)
    range_tables := [Int:Int]{}
    if ranges >= 0 -> link_lists_prune(groups[ranges], plan.range_refs, range_tables, ranges: true)
    link_info_rewrite(groups[info], plan, line_offsets, list_tables, range_tables)
    groups
}

// Whether every DWARF unit in `debug` comes from a Jet object whose executable
// sections are all live and every `.debug_addr` slot falls within
// `[text_start, text_end)`. In that case no subprogram, line sequence, or
// location/range list is dropped, so pruning is an exact identity no-op.
link_debug_all_live: fn(c: LinkContext, debug: LinkDebug, info: Int, line: Int, addr: Int, groups: [[U8]], text_start: Int, text_end: Int) -> Bool Never! {
    if addr < 0 || groups[addr].len() == 0 -> return false
    info_rows: debug.rows[info]
    addr_rows: debug.rows[addr]
    if info_rows.len() == 0 || info_rows.len() != addr_rows.len() -> return false
    if line >= 0 && debug.rows[line].len() != info_rows.len() -> return false
    // Every contributing object must match across info/addr/line and have zero
    // dropped executable sections.
    loop k in 0..<info_rows.len() {
        obj: link_obj_of(c, c.live_secs[info_rows[k]])
        if link_obj_of(c, c.live_secs[addr_rows[k]]) != obj -> return false
        if line >= 0 && link_obj_of(c, c.live_secs[debug.rows[line][k]]) != obj -> return false
        first: c.obj_first_section[obj]
        loop sec_idx in 1..<c.obj_count[obj] {
            s: first + sec_idx
            if (link_sec_flags(c, obj, s) & 4) != 0 && link_sec_size(c, obj, s) > 0 && link_live_row(c, s) < 0 {
                return false
            }
        }
    }
    // Verify every DWARF 5 `.debug_addr` unit is well-formed and every 8-byte
    // function address slot lies inside `[text_start, text_end)`.
    addr_bytes: groups[addr]
    at := 0
    loop at < addr_bytes.len() {
        length: link_debug_le(addr_bytes, at, 4)
        if length < 4 || length >= 0xfffffff0 || at + 4 + length > addr_bytes.len() -> return false
        if link_debug_le(addr_bytes, at + 4, 2) != 5 || (Int{addr_bytes[at + 6]}) != 8 || (Int{addr_bytes[at + 7]}) != 0 {
            return false
        }
        payload: length - 4
        if payload % 8 != 0 -> return false
        slot := at + 8
        end: at + 4 + length
        loop slot < end {
            pc: link_debug_addr(addr_bytes, slot)
            if pc < text_start || pc >= text_end -> return false
            slot += 8
        }
        at = end
    }
    true
}

// ---------------------------------------------------------------------------
// Reading.

// The `width`-byte little-endian value at `at`; -1 past the end.
link_debug_le: fn(bytes: [U8], at: Int, width: Int) -> Int Never! {
    if at < 0 || at + width > bytes.len() -> return -1
    value := 0
    loop k in 0..<width -> value |= Int{bytes[at + k]} << (8 * k)
    value
}

// The 8-byte address at `at`; -1 past the end or at 2^63 and above.
link_debug_addr: fn(bytes: [U8], at: Int) -> Int Never! {
    high: link_debug_le(bytes, at + 4, 4)
    if high < 0 || high >= 0x80000000 -> return -1
    link_debug_le(bytes, at, 4) + high * 0x100000000
}

// The uleb at `at` (advanced past it); -1, with `at` past the end, when it
// runs out.
link_debug_uleb: fn(bytes: [U8], at: &Int) -> Int Never! {
    value := 0
    shift := 0
    loop at < bytes.len() {
        byte: Int{bytes[at]}
        at += 1
        if shift < 56 -> value |= (byte & 127) << shift
        shift += 7
        if byte < 128 -> return value
    }
    at = bytes.len() + 1
    return -1
}

// The offset after the leb at `at`; past the end when it runs out.
link_debug_leb_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at
    _ := link_debug_uleb(bytes, end)
    end
}

// The offset after the NUL-terminated string at `at`; past the end when
// it has no NUL.
link_debug_cstr_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at
    loop end < bytes.len() {
        if (Int{bytes[end]}) == 0 -> return end + 1
        end += 1
    }
    bytes.len() + 1
}

// The offset after a `form` value at `at`; -1 for a form the walk doesn't
// read (one Image/Dwarf.jet doesn't write).
link_debug_form_end: fn(bytes: [U8], at: Int, form: Int) -> Int Never! {
    // DW_FORM_flag_present.
    if form == 0x19 -> return at
    // DW_FORM_data1, DW_FORM_flag.
    if form == 0x0b || form == 0x0c -> return at + 1
    // DW_FORM_data2.
    if form == 0x05 -> return at + 2
    // DW_FORM_data4, DW_FORM_ref4, DW_FORM_sec_offset.
    if form == 0x06 || form == 0x13 || form == 0x17 -> return at + 4
    // DW_FORM_addr (8-byte addresses), DW_FORM_data8.
    if form == 0x01 || form == 0x07 -> return at + 8
    // DW_FORM_string.
    if form == 0x08 -> return link_debug_cstr_end(bytes, at)
    // DW_FORM_sdata, DW_FORM_udata, DW_FORM_addrx, DW_FORM_loclistx,
    // DW_FORM_rnglistx.
    if form == 0x0d || form == 0x0f || form == 0x1b || form == 0x22 || form == 0x23 {
        return link_debug_leb_end(bytes, at)
    }
    // DW_FORM_exprloc.
    if form == 0x18 {
        end := at
        length: link_debug_uleb(bytes, end)
        return if length < 0 -> -1 else -> end + length
    }
    return -1
}

// ---------------------------------------------------------------------------
// .debug_info.

// One abbreviation table: per code its entry, per entry its tag, whether
// it has children and its (attribute, form) pairs, entry k's from
// starts[k] to starts[k + 1].
LinkAbbrevs: struct {
    entries: [Int:Int],
    tags: [Int],
    children: [Bool],
    starts: [Int],
    attributes: [Int],
    forms: [Int],
}

// The abbreviation table at `at`, or None when it runs out or uses an
// implicit constant.
link_debug_abbrevs: fn(bytes: [U8], from: Int) -> LinkAbbrevs? Never! {
    table := LinkAbbrevs{entries: [Int:Int]{}, tags: [Int]{}, children: [Bool]{}, starts: [Int]{}, attributes: [Int]{}, forms: [Int]{}}
    at := from
    loop {
        code: link_debug_uleb(bytes, at)
        if code < 0 -> return None
        if code == 0 {
            table.starts.push(table.attributes.len())
            return Val(table)
        }
        die: link_debug_uleb(bytes, at)
        if die < 0 || at >= bytes.len() -> return None
        if table.entries.get(code) != .None -> return None
        table.entries.add(code, table.tags.len()).drop("checked absent above")
        table.tags.push(die)
        table.children.push(Int{bytes[at]} != 0)
        at += 1
        table.starts.push(table.attributes.len())
        loop {
            attribute: link_debug_uleb(bytes, at)
            form: link_debug_uleb(bytes, at)
            if attribute < 0 || form < 0 || form == 0x21 -> return None
            if attribute == 0 && form == 0 -> break
            table.attributes.push(attribute)
            table.forms.push(form)
        }
    }
}

// What pruning `.debug_info` changes: the dropped subprograms' extents
// (start, end pairs, ascending), each unit's start, the places of the kept
// DIEs' ref4 values (with their unit's start), DW_AT_stmt_list values and
// DW_AT_loclists_base and DW_AT_rnglists_base values, and per kept list
// index (DW_FORM_loclistx, DW_FORM_rnglistx) a pair: its unit's base and
// the index.
LinkInfoPlan: struct {
    drops: [Int],
    units: [Int],
    refs: [Int],
    ref_units: [Int],
    lines: [Int],
    list_bases: [Int],
    range_bases: [Int],
    list_refs: [Int],
    range_refs: [Int],
}

// A unit's DW_AT_addr_base, DW_AT_loclists_base and DW_AT_rnglists_base;
// -1 for none.
LinkUnitBases: struct {
    addr: Int,
    lists: Int,
    ranges: Int,
}

// The attributes of a DIE of abbreviation `entry` from `at`: the offset
// after them, or -1 when the walk can't read one. The unit DIE's bases go
// to `bases`. With `record` its ref4, stmt_list, base and list index
// places join `plan`; `low_pc` is its DW_AT_low_pc address (an index into
// `addr`, the linked `.debug_addr`, past `bases.addr`), or -1.
link_info_attributes: fn(info: [U8], table: LinkAbbrevs, entry: Int, from: Int, unit: Int, addr: [U8], bases: &LinkUnitBases, plan: &LinkInfoPlan, record: Bool, low_pc: &Int) -> Int Never! {
    at := from
    loop pair in table.starts[entry]..<table.starts[entry + 1] {
        attribute: table.attributes[pair]
        form: table.forms[pair]
        if record && form == 0x13 {
            plan.refs.push(at)
            plan.ref_units.push(unit)
        }
        if record && form == 0x17 && attribute == 0x10 -> plan.lines.push(at)
        if form == 0x17 && attribute == 0x73 -> bases.addr = link_debug_le(info, at, 4)
        if form == 0x17 && attribute == 0x8c {
            bases.lists = link_debug_le(info, at, 4)
            if record -> plan.list_bases.push(at)
        }
        if form == 0x17 && attribute == 0x74 {
            bases.ranges = link_debug_le(info, at, 4)
            if record -> plan.range_bases.push(at)
        }
        if record && (form == 0x22 || form == 0x23) {
            index_at := at
            index: link_debug_uleb(info, index_at)
            if {
                form == 0x22 -> {
                    plan.list_refs.push(bases.lists)
                    plan.list_refs.push(index)
                }
                else -> {
                    plan.range_refs.push(bases.ranges)
                    plan.range_refs.push(index)
                }
            }
        }
        if attribute == 0x11 && form == 0x01 -> low_pc = link_debug_addr(info, at)
        if attribute == 0x11 && form == 0x1b {
            slot_at := at
            slot: link_debug_uleb(info, slot_at)
            low_pc = if slot < 0 || bases.addr < 0 -> -1 else -> link_debug_addr(addr, bases.addr + 8 * slot)
        }
        at = link_debug_form_end(info, at, form)
        if at < 0 || at > info.len() -> return -1
    }
    at
}

// The bytes dropped before kept offset `at` (`sums[k]`: the bytes of the
// first k drops); -1 when `at` starts a drop or falls inside one.
link_info_dropped_before: fn(drops: [Int], sums: [Int], at: Int) -> Int Never! {
    low := 0
    high := drops.len() >> 1
    loop low < high {
        middle: (low + high) >> 1
        if drops[2 * middle] < at -> low = middle + 1 else -> high = middle
    }
    if (low > 0 && drops[2 * low - 1] > at) || (low < (drops.len() >> 1) && drops[2 * low] == at) {
        return -1
    }
    sums[low]
}

link_info_sums: fn(drops: [Int]) -> [Int] Never! {
    sums := [Int]{0}
    loop k in 0..<(drops.len() >> 1) -> sums.push(sums[k] + drops[2 * k + 1] - drops[2 * k])
    sums
}

// Walk every unit of `info` (DWARF 5 compile units, 8-byte addresses): a
// subprogram child of the unit whose low_pc (in `addr`, the linked
// `.debug_addr`, for an index) is outside the live text drops with its
// children. None when a unit can't be walked or a kept ref4 refers into a
// drop.
link_info_plan: fn(info: [U8], abbrev: [U8], addr: [U8], text_start: Int, text_end: Int) -> LinkInfoPlan? Never! {
    plan := LinkInfoPlan{drops: [Int]{}, units: [Int]{}, refs: [Int]{}, ref_units: [Int]{}, lines: [Int]{}, list_bases: [Int]{}, range_bases: [Int]{}, list_refs: [Int]{}, range_refs: [Int]{}}
    at := 0
    loop at < info.len() {
        unit: at
        length: link_debug_le(info, unit, 4)
        if length < 8 || length >= 0xfffffff0 || unit + 4 + length > info.len() -> return None
        end: unit + 4 + length
        if link_debug_le(info, unit + 4, 2) != 5 || (Int{info[unit + 6]}) != 1 || (Int{info[unit + 7]}) != 8 {
            return None
        }
        table: link_debug_abbrevs(abbrev, link_debug_le(info, unit + 8, 4)) ?? return None
        plan.units.push(unit)
        pos := unit + 12
        bases := LinkUnitBases{addr: -1, lists: -1, ranges: -1}
        // The level of the next DIE: the unit's children are at 1.
        depth := 0
        drop_start := -1
        loop pos < end {
            die: pos
            code: link_debug_uleb(info, pos)
            if code < 0 -> return None
            if code == 0 {
                depth -= 1
                if depth < 0 -> return None
                if drop_start >= 0 && depth == 1 {
                    plan.drops.push(drop_start)
                    plan.drops.push(pos)
                    drop_start = -1
                }
                next
            }
            entry: table.entries.get(code) ?? return None
            candidate: drop_start < 0 && depth == 1 && table.tags[entry] == 0x2e
            low_pc := -1
            body: pos
            pos = link_info_attributes(info, table, entry, body, unit, addr, bases, plan, drop_start < 0 && !candidate, low_pc)
            if pos < 0 || pos > end -> return None
            if candidate {
                if low_pc >= 0 && (low_pc < text_start || low_pc >= text_end) {
                    if table.children[entry] -> drop_start = die else {
                        plan.drops.push(die)
                        plan.drops.push(pos)
                    }
                } else {
                    _ := link_info_attributes(info, table, entry, body, unit, addr, bases, plan, true, low_pc)
                }
            }
            if table.children[entry] -> depth += 1
        }
        if pos != end || depth != 0 || drop_start >= 0 -> return None
        at = end
    }
    sums: link_info_sums(plan.drops)
    loop (k, place) in plan.refs {
        if link_info_dropped_before(plan.drops, sums, plan.ref_units[k] + link_debug_le(info, place, 4)) < 0 {
            return None
        }
    }
    Val(plan)
}

// `info` without `plan.drops`: unit lengths shrink by their drops, ref4
// values follow the DIEs they name, and stmt_list values the moved
// `.debug_line` units and loclists and rnglists bases the moved offsets
// tables (link_lists_prune; an offset not in the maps stays).
link_info_rewrite: fn(info: &[U8], plan: LinkInfoPlan, lines: [Int:Int], lists: [Int:Int], ranges: [Int:Int]) Never! {
    sums: link_info_sums(plan.drops)
    loop (k, at) in plan.refs {
        unit: plan.ref_units[k]
        target: link_debug_le(info, at, 4)
        moved: link_info_dropped_before(plan.drops, sums, unit + target) - link_info_dropped_before(plan.drops, sums, unit)
        dwarf_patch_u32(info, at, target - moved)
    }
    loop at in plan.lines {
        offset: link_debug_le(info, at, 4)
        dwarf_patch_u32(info, at, lines.get(offset) ?? offset)
    }
    loop at in plan.list_bases {
        offset: link_debug_le(info, at, 4)
        dwarf_patch_u32(info, at, lists.get(offset) ?? offset)
    }
    loop at in plan.range_bases {
        offset: link_debug_le(info, at, 4)
        dwarf_patch_u32(info, at, ranges.get(offset) ?? offset)
    }
    if plan.drops.len() == 0 {
        return
    }
    loop unit in plan.units {
        end: unit + 4 + link_debug_le(info, unit, 4)
        dropped: link_info_dropped_before(plan.drops, sums, end) - link_info_dropped_before(plan.drops, sums, unit)
        dwarf_patch_u32(info, unit, end - unit - 4 - dropped)
    }
    kept := [U8]{}
    from := 0
    loop k in 0..<(plan.drops.len() >> 1) {
        kept.extend(info[from..<plan.drops[2 * k]])
        from = plan.drops[2 * k + 1]
    }
    kept.extend(info[from..<info.len()])
    info = kept
}

// ---------------------------------------------------------------------------
// .debug_line, .debug_loclists and .debug_rnglists.

// Drop each sequence of `line` (DWARF 5 units) whose DW_LNE_set_address is
// outside the live text; `moved` maps each unit's old offset to its new
// one. A unit it can't read leaves `line` and `moved` as they were.
link_line_prune: fn(line: &[U8], text_start: Int, text_end: Int, moved: &[Int:Int]) Never! {
    kept := [U8]{}
    olds := [Int]{}
    news := [Int]{}
    at := 0
    loop at < line.len() {
        unit: at
        length: link_debug_le(line, unit, 4)
        if length < 14 || length >= 0xfffffff0 || unit + 4 + length > line.len() || link_debug_le(line, unit + 4, 2) != 5 || (Int{line[unit + 6]}) != 8 {
            return
        }
        end: unit + 4 + length
        program: unit + 12 + link_debug_le(line, unit + 8, 4)
        opcode_base: Int{line[unit + 17]}
        if opcode_base < 1 || unit + 18 + opcode_base - 1 > program || program > end {
            return
        }
        olds.push(unit)
        news.push(kept.len())
        kept.extend(line[unit..<program])
        pos := program
        loop pos < end {
            sequence: pos
            address := -1
            addressed := false
            ended := false
            loop !ended {
                if pos >= end {
                    return
                }
                op: Int{line[pos]}
                pos += 1
                if op == 0 {
                    size: link_debug_uleb(line, pos)
                    if size < 1 || pos + size > end {
                        return
                    }
                    sub: Int{line[pos]}
                    // DW_LNE_set_address: the sequence's first decides.
                    if sub == 2 && !addressed && size == 9 {
                        address = link_debug_addr(line, pos + 1)
                        addressed = true
                    }
                    ended = sub == 1
                    pos += size
                } else if op == 9 {
                    // DW_LNS_fixed_advance_pc: a uhalf operand.
                    pos += 2
                } else if op < opcode_base {
                    loop _ in 0..<(Int{line[unit + 17 + op]}) -> pos = link_debug_leb_end(line, pos)
                }
            }
            if pos > end {
                return
            }
            if !addressed || (address >= text_start && address < text_end) {
                kept.extend(line[sequence..<pos])
            }
        }
        dwarf_patch_u32(kept, news[news.len() - 1], kept.len() - news[news.len() - 1] - 4)
        at = end
    }
    loop (k, old) in olds {
        if old != news[k] -> moved.add(old, news[k]).drop("unit offsets are unique")
    }
    line = kept
}

// The offset after the location list at `at`; -1 when it runs past `end`.
link_list_end: fn(lists: [U8], from: Int, end: Int) -> Int Never! {
    at := from
    loop at < end {
        kind: Int{lists[at]}
        at += 1
        // DW_LLE_end_of_list.
        if kind == 0 -> return at
        // DW_LLE_base_addressx: one uleb.
        if kind == 1 {
            at = link_debug_leb_end(lists, at)
            next
        }
        // DW_LLE_base_address: an address.
        if kind == 6 {
            at += 8
            next
        }
        // The bounds: startx_endx, startx_length, offset_pair two ulebs,
        // start_end two addresses, start_length an address and a uleb,
        // default_location none.
        if kind == 2 || kind == 3 || kind == 4 {
            at = link_debug_leb_end(lists, link_debug_leb_end(lists, at))
        } else if kind == 7 { at += 16 } else if kind == 8 {
            at = link_debug_leb_end(lists, at + 8)
        } else if kind != 5 { return -1 }
        if at >= end -> return -1
        length: link_debug_uleb(lists, at)
        if length < 0 -> return -1
        at += length
    }
    return -1
}

// The offset after the range list at `at`; -1 when it runs past `end`.
link_range_end: fn(lists: [U8], from: Int, end: Int) -> Int Never! {
    at := from
    loop at < end {
        kind: Int{lists[at]}
        at += 1
        // DW_RLE_end_of_list.
        if kind == 0 -> return at
        if kind > 7 -> return -1
        at = if {
            // DW_RLE_base_addressx: one uleb.
            kind == 1 -> link_debug_leb_end(lists, at)
            // DW_RLE_base_address: an address.
            kind == 5 -> at + 8
            // DW_RLE_start_end: two addresses.
            kind == 6 -> at + 16
            // DW_RLE_start_length: an address and a uleb.
            kind == 7 -> link_debug_leb_end(lists, at + 8)
            // DW_RLE_startx_endx, startx_length, offset_pair: two ulebs.
            else -> link_debug_leb_end(lists, link_debug_leb_end(lists, at))
        }
    }
    return -1
}

// Keep only the referred lists of `lists` (DWARF 5 units, location lists
// or with `ranges` range lists): `referred` holds pairs, an offsets
// table's start (a unit's DW_AT_loclists_base or DW_AT_rnglists_base) and
// an index into it. A unit keeps its table, so the indexes stay: a
// referred entry names its list's kept copy (one per list), an entry
// nothing refers to one empty list at the unit's end. A unit without a
// table stays whole. `moved` maps each table's old start to its new one.
// Lists it can't read leave `lists` and `moved` as they were.
link_lists_prune: fn(lists: &[U8], referred: [Int], moved: &[Int:Int], ranges: Bool{false}) Never! {
    starts := [Int]{}
    counts := [Int]{}
    // Per table start, its unit's number.
    tables := [Int:Int]{}
    at := 0
    loop at < lists.len() {
        length: link_debug_le(lists, at, 4)
        if length < 8 || length >= 0xfffffff0 || at + 4 + length > lists.len() || link_debug_le(lists, at + 4, 2) != 5 {
            return
        }
        count: link_debug_le(lists, at + 8, 4)
        if 8 + 4 * count > length {
            return
        }
        tables.add(at + 12, starts.len()).drop("unit offsets are unique")
        starts.push(at)
        counts.push(count)
        at += 4 + length
    }
    wanted := [[Bool]]{}
    loop count in counts {
        row := [Bool]{}
        loop _ in 0..<count -> row.push(false)
        wanted.push(row)
    }
    loop pair in 0..<(referred.len() >> 1) {
        unit: tables.get(referred[2 * pair]) ?? return
        index: referred[2 * pair + 1]
        if index < 0 || index >= counts[unit] {
            return
        }
        wanted[unit][index] = true
    }
    kept := [U8]{}
    olds := [Int]{}
    news := [Int]{}
    loop (k, unit) in starts {
        end: unit + 4 + link_debug_le(lists, unit, 4)
        table: unit + 12
        new_unit: kept.len()
        new_table: new_unit + 12
        kept.extend(lists[unit..<table])
        if {
            counts[k] == 0 -> kept.extend(lists[table..<end])
            else -> {
                loop _ in 0..<counts[k] -> elf64_u32(kept, 0)
                // Per kept list, its old start and its new offset.
                copied := [Int:Int]{}
                loop index in 0..<counts[k] {
                    if !wanted[k][index] -> next
                    from: table + link_debug_le(lists, table + 4 * index, 4)
                    offset := copied.get(from) ?? -1
                    if offset < 0 {
                        to: if ranges -> link_range_end(lists, from, end) else -> link_list_end(lists, from, end)
                        if from < table + 4 * counts[k] || to < 0 {
                            return
                        }
                        offset = kept.len() - new_table
                        copied.add(from, offset).drop("checked absent above")
                        kept.extend(lists[from..<to])
                    }
                    dwarf_patch_u32(kept, new_table + 4 * index, offset)
                }
                empty := -1
                loop index in 0..<counts[k] {
                    if wanted[k][index] -> next
                    if empty < 0 {
                        empty = kept.len() - new_table
                        kept.push(U8{0})
                    }
                    dwarf_patch_u32(kept, new_table + 4 * index, empty)
                }
            }
        }
        dwarf_patch_u32(kept, new_unit, kept.len() - new_unit - 4)
        olds.push(table)
        news.push(new_table)
    }
    loop (k, old) in olds {
        if old != news[k] -> moved.add(old, news[k]).drop("table offsets are unique")
    }
    lists = kept
}

// ---------------------------------------------------------------------------
// .debug_jetline.

// `table`'s object blocks as linked blocks (the format above), the dropped
// functions' records left out; false when a block's records, strings or
// rows run past it.
link_jetline_link: fn(table: &[U8], text_start: Int, text_end: Int) -> Bool Never! {
    linked := [U8]{}
    at := 0
    loop at < table.len() {
        length: link_debug_le(table, at, 4)
        end: at + 4 + length
        count: link_debug_le(table, at + 4, 4)
        strings: at + link_debug_le(table, at + 8, 4)
        rows: at + link_debug_le(table, at + 12, 4)
        if length < 12 || end > table.len() || at + 16 + 32 * count > strings || strings > rows || rows > end {
            return false
        }
        if !link_jetline_block(linked, table, at + 16, count, strings, rows, end, text_start, text_end) {
            return false
        }
        at = end
    }
    table = linked
    true
}

// One object block's live records (`count` from `records`), as one linked
// block appended to `linked`; nothing when none is live.
link_jetline_block: fn(linked: &[U8], table: [U8], records: Int, count: Int, strings: Int, rows: Int, end: Int, text_start: Int, text_end: Int) -> Bool Never! {
    live := [Int]{}
    starts := [Int]{}
    if count > 64 {
        live.try_reserve(count) ?? panic("reserve failed")
        starts.try_reserve(count) ?? panic("reserve failed")
    }
    sorted := true
    prev_start := -1
    loop k in 0..<count {
        record: records + 32 * k
        start: link_debug_addr(table, record)
        if start >= text_start && start < text_end {
            if live.len() > 0 && start < prev_start -> sorted = false
            prev_start = start
            live.push(record)
            starts.push(start)
        }
    }
    if live.len() == 0 -> return true
    order: if sorted -> live.move() else -> link_sort_by(live, starts)
    texts := [U8]{}
    if rows > strings -> texts.try_reserve(rows - strings) ?? panic("reserve failed")
    // The string offsets, old to new: each string is kept once.
    moved := [Int:Int]{}
    if !link_jetline_string(texts, moved, table, strings, rows) -> return false
    body := [U8]{}
    if end > rows -> body.try_reserve(end - rows + order.len() * 16) ?? panic("reserve failed")
    base: link_debug_addr(table, order[0])
    previous := base
    loop record in order {
        start: link_debug_addr(table, record)
        size: link_debug_le(table, record + 8, 4)
        name: strings + link_debug_le(table, record + 12, 4)
        file: strings + link_debug_le(table, record + 16, 4)
        if !link_jetline_string(texts, moved, table, name, rows) || !link_jetline_string(texts, moved, table, file, rows) {
            return false
        }
        from: rows + link_debug_le(table, record + 24, 4)
        to: from + link_debug_le(table, record + 28, 4)
        if from > end || to > end -> return false
        // Sorted by start, a start is never below the previous start; it is
        // below the previous end only where two records overlap.
        dwarf_sleb(body, start - previous)
        dwarf_uleb(body, size)
        dwarf_uleb(body, moved.get(name) ?? 0)
        dwarf_uleb(body, moved.get(file) ?? 0)
        dwarf_uleb(body, link_debug_le(table, record + 20, 4))
        dwarf_uleb(body, to - from)
        body.extend(table[from..<to])
        previous = start + size
    }
    block: linked.len()
    elf64_u32(linked, 0)
    elf64_u32(linked, order.len())
    elf64_u32(linked, 20 + body.len())
    elf64_u64(linked, base)
    linked.extend(body)
    linked.extend(texts)
    dwarf_patch_length(linked, block)
    true
}

// The string at `at` (ending before `limit`) into `texts` unless `moved`
// has it already; false when it has no NUL before `limit`.
link_jetline_string: fn(texts: &[U8], moved: &[Int:Int], table: [U8], at: Int, limit: Int) -> Bool Never! {
    if moved.get(at) != .None -> return true
    end: link_debug_cstr_end(table, at)
    if end > limit -> return false
    moved.add(at, texts.len()).drop("checked absent above")
    texts.extend(table[at..<end])
    true
}
