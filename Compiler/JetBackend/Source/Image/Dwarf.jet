// DWARF 5 debug information and `.eh_frame` call frame information for the
// relocatable object (Image/Object.jet), so gdb and lldb can break on a
// source line, step, show source, unwind and print a native program's
// parameters and locals. The code generator records the source facts and,
// per compiled function, where each line's code starts, the frame's call
// frame instructions and each variable's location ranges (Emission.jet
// X64ObjectModule, X64FunctionDebug). This file only encodes them:
//
// - `.eh_frame`: one CIE (CFA = rsp + 8, return address at CFA - 8) and one
//   FDE per function with the function's call frame instructions. The
//   in-process linker keeps an FDE exactly when its function is live and
//   the startup object registers the table, so the runtime's unwinder and
//   debuggers both walk through Jet frames. When no unwinder is linked, a
//   split link writes the table to the side debug file as `.debug_frame`
//   instead (StaticLink.jet link_debug_frame), for debuggers and profilers.
// - `.debug_abbrev`, `.debug_info`: one compile unit covering `.text` (with
//   one section per function, a unit without an address range); the
//   types of X64ModuleDebug.types; one subprogram per function (frame base
//   rbp) with its parameters and variables, each located by a location list.
//   Code inlined into a function is an inlined subroutine of an abstract
//   subprogram of the inlined function, so a debugger shows its frame and
//   locals. Generated functions (glue, helpers, `main`) are artificial
//   subprograms.
// - `.debug_line`: one sequence per function with source lines; the row at
//   the end of the prologue carries `prologue_end`.
// - `.debug_jetline`: not DWARF. The location table the runtime's fault
//   report reads (JetRuntime Assets/FaultReport/report.S) instead of
//   parsing the DWARF: per Jet function its address
//   range, name, file, declaration line and the `.debug_line` rows, delta
//   coded (dwarf_jet_line).
// - `.debug_loclists`: offset pairs from the compile unit's base (the start
//   of `.text`), so the lists need no relocations. With one section per
//   function, which a linker places apart or drops, the entries are start
//   addresses and lengths, the addresses relocations.
//
// Addresses and section offsets in the other sections are relocations
// against section symbols, so any ELF linker can place the sections.
use jet_foundation.[CompilerThreads, compiler_threads_admit, compiler_threads_failure_text, compiler_threads_partition, compiler_threads_single]

ELF64_R_X86_64_32: 10

// x86-64 DWARF register numbers by hardware register number.
X64_DWARF_REGISTERS: [Int]{0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15}

x64_dwarf_register: fn(reg: Int) -> Int Never! {
    if reg >= 16 -> return reg + 1
    X64_DWARF_REGISTERS[reg]
}

// Object symbols the debug and unwind relocations name. With `functions`
// empty every function is in `.text`, whose symbol is `text`; otherwise
// function i is alone in the section whose symbol is functions[i].
X64DwarfSymbols: struct {
    text: Int
    abbrev: Int
    line: Int
    loclists: Int
    functions: [Int]
}

X64DwarfSections: struct {
    eh_frame: [U8]
    eh_relas: [X64ObjectRela]
    abbrev: [U8]
    // `.debug_info` and `.debug_loclists` as the pieces their threads built,
    // in order and contiguous (x64_object_file writes them into the file).
    info: [X64ObjectPiece]
    info_relas: [X64ObjectRela]
    line: [U8]
    line_relas: [X64ObjectRela]
    jet_line: [U8]
    jet_line_relas: [X64ObjectRela]
    loclists: [X64ObjectPiece]
    loclists_relas: [X64ObjectRela]
}

// One section's bytes and their relocations.
DwarfSectionRows: struct {
    bytes: [U8]
    relas: [X64ObjectRela]
}

// ---------------------------------------------------------------------------
// Encoding.

dwarf_u8: fn(bytes: &[U8], value: Int) Never! { bytes.push(U8{value.bit_and(255)}) }

dwarf_uleb: fn(bytes: &[U8], value: Int) Never! {
    rest := value
    loop {
        low: rest.bit_and(0x7f)
        rest = rest >> 7
        if rest == 0 {
            bytes.push(U8{low})
            return
        }
        bytes.push(U8{low.bit_or(0x80)})
    }
}

dwarf_sleb: fn(bytes: &[U8], value: Int) Never! {
    rest := value
    loop {
        low: rest.bit_and(0x7f)
        rest = rest >> 7
        if (rest == 0 && (low.bit_and(0x40)) == 0) || (rest == -1 && (low.bit_and(0x40)) != 0) {
            bytes.push(U8{low})
            return
        }
        bytes.push(U8{low.bit_or(0x80)})
    }
}

dwarf_string: fn(bytes: &[U8], text: String) Never! {
    bytes.extend(text.bytes())
    bytes.push(U8{0})
}

dwarf_patch_u32: fn(bytes: &[U8], at: Int, value: Int) Never! {
    bytes[at] = U8{value.bit_and(255)}
    bytes[at + 1] = U8{(value >> 8).bit_and(255)}
    bytes[at + 2] = U8{(value >> 16).bit_and(255)}
    bytes[at + 3] = U8{(value >> 24).bit_and(255)}
}

// The 4-byte length field at `at`: the bytes after it, to the end.
dwarf_patch_length: fn(bytes: &[U8], at: Int) Never! {
    length: bytes.len() - at - 4
    dwarf_patch_u32(bytes, at, length)
}

// ---------------------------------------------------------------------------
// Call frame instructions (data alignment -8, code alignment 1).

dwarf_cfa_advance: fn(cfi: &[U8], from: Int, to: Int) Never! {
    delta: to - from
    if delta <= 0 {
        return
    }
    if {
        delta < 64 -> dwarf_u8(cfi, (0x40).bit_or(delta))
        delta < 256 -> {
            dwarf_u8(cfi, 0x02)
            dwarf_u8(cfi, delta)
        }
        delta < 65536 -> {
            dwarf_u8(cfi, 0x03)
            elf64_u16(cfi, delta)
        }
        else -> {
            dwarf_u8(cfi, 0x04)
            elf64_u32(cfi, delta)
        }
    }
}

dwarf_cfa_def_cfa: fn(cfi: &[U8], reg: Int, offset: Int) Never! {
    dwarf_u8(cfi, 0x0c)
    dwarf_uleb(cfi, reg)
    dwarf_uleb(cfi, offset)
}

dwarf_cfa_def_cfa_register: fn(cfi: &[U8], reg: Int) Never! {
    dwarf_u8(cfi, 0x0d)
    dwarf_uleb(cfi, reg)
}

dwarf_cfa_def_cfa_offset: fn(cfi: &[U8], offset: Int) Never! {
    dwarf_u8(cfi, 0x0e)
    dwarf_uleb(cfi, offset)
}

// `reg` is saved at CFA - 8 * `factored`.
dwarf_cfa_offset: fn(cfi: &[U8], reg: Int, factored: Int) Never! {
    if {
        reg < 64 -> dwarf_u8(cfi, (0x80).bit_or(reg))
        else -> {
            dwarf_u8(cfi, 0x05)
            dwarf_uleb(cfi, reg)
        }
    }
    dwarf_uleb(cfi, factored)
}

dwarf_cfa_remember_state: fn(cfi: &[U8]) Never! { dwarf_u8(cfi, 0x0a) }

dwarf_cfa_restore_state: fn(cfi: &[U8]) Never! { dwarf_u8(cfi, 0x0b) }

// Pad a CIE or FDE with DW_CFA_nop so the record (length field included)
// is a whole number of words.
dwarf_eh_finish: fn(eh: &[U8], start: Int) Never! {
    loop _ in 0..<((8 - (eh.len() - start) % 8) % 8) -> eh.push(U8{0})
    dwarf_patch_length(eh, start)
}

dwarf_eh_frame: fn(functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    eh := [U8]{}
    // CIE: version 1, augmentation "zR" (FDE addresses pcrel sdata4), code
    // alignment 1, data alignment -8, return address column 16 (rip).
    elf64_u32(eh, 0)
    elf64_u32(eh, 0)
    dwarf_u8(eh, 1)
    dwarf_string(eh, "zR")
    dwarf_uleb(eh, 1)
    dwarf_sleb(eh, -8)
    dwarf_u8(eh, 16)
    dwarf_uleb(eh, 1)
    dwarf_u8(eh, 0x1b)
    dwarf_cfa_def_cfa(eh, 7, 8)
    dwarf_cfa_offset(eh, 16, 1)
    dwarf_eh_finish(eh, 0)
    relas := [X64ObjectRela]{}
    loop (index, function) in functions {
        start: eh.len()
        elf64_u32(eh, 0)
        // CIE pointer: the distance back from this field to the CIE.
        cie_pointer: eh.len()
        elf64_u32(eh, cie_pointer)
        relas.push(X64ObjectRela{at: eh.len(), symbol: dwarf_function_symbol(symbols, index), kind: ELF64_R_X86_64_PC32, addend: offsets[index]})
        elf64_u32(eh, 0)
        elf64_u32(eh, function.code.len())
        dwarf_uleb(eh, 0)
        loop byte in debug[index].cfi -> eh.push(byte)
        dwarf_eh_finish(eh, start)
    }
    DwarfSectionRows{bytes: eh.move(), relas: relas.move()}
}

// The symbol function `index`'s address relocations name: `.text`'s or its
// own section's.
dwarf_function_symbol: fn(symbols: X64DwarfSymbols, index: Int) -> Int Never! {
    if symbols.functions.len() == 0 -> return symbols.text
    symbols.functions[index]
}

// ---------------------------------------------------------------------------
// Abbreviations.

DWARF_ABBREV_UNIT: 1

DWARF_ABBREV_BASE: 2

DWARF_ABBREV_POINTER: 3

DWARF_ABBREV_VOID_POINTER: 4

DWARF_ABBREV_STRUCT: 5

DWARF_ABBREV_MEMBER: 6

DWARF_ABBREV_UNION: 7

DWARF_ABBREV_ENUM: 8

DWARF_ABBREV_ENUMERATOR: 9

DWARF_ABBREV_TYPEDEF: 10

DWARF_ABBREV_OPAQUE: 11

DWARF_ABBREV_SUBPROGRAM: 12

DWARF_ABBREV_GENERATED: 13

DWARF_ABBREV_PARAMETER: 14

DWARF_ABBREV_VARIABLE: 15

DWARF_ABBREV_PARAMETER_UNLOCATED: 16

DWARF_ABBREV_VARIABLE_UNLOCATED: 17

DWARF_ABBREV_ANONYMOUS_UNION: 18

DWARF_ABBREV_ABSTRACT: 19

DWARF_ABBREV_ABSTRACT_GENERATED: 20

DWARF_ABBREV_INLINED: 21

// Attribute names and forms.
DW_AT_LOCATION: 0x02

DW_AT_NAME: 0x03

DW_AT_BYTE_SIZE: 0x0b

DW_AT_STMT_LIST: 0x10

DW_AT_LOW_PC: 0x11

DW_AT_HIGH_PC: 0x12

DW_AT_LANGUAGE: 0x13

DW_AT_COMP_DIR: 0x1b

DW_AT_CONST_VALUE: 0x1c

DW_AT_INLINE: 0x20

DW_AT_PRODUCER: 0x25

DW_AT_ABSTRACT_ORIGIN: 0x31

DW_AT_ARTIFICIAL: 0x34

DW_AT_DATA_MEMBER_LOCATION: 0x38

DW_AT_DECL_FILE: 0x3a

DW_AT_DECL_LINE: 0x3b

DW_AT_DECLARATION: 0x3c

DW_AT_ENCODING: 0x3e

DW_AT_EXTERNAL: 0x3f

DW_AT_FRAME_BASE: 0x40

DW_AT_TYPE: 0x49

DW_AT_CALL_FILE: 0x58

DW_AT_CALL_LINE: 0x59

DW_FORM_ADDR: 0x01

DW_FORM_DATA2: 0x05

DW_FORM_DATA8: 0x07

DW_FORM_STRING: 0x08

DW_FORM_DATA1: 0x0b

DW_FORM_SDATA: 0x0d

DW_FORM_UDATA: 0x0f

DW_FORM_REF4: 0x13

DW_FORM_SEC_OFFSET: 0x17

DW_FORM_EXPRLOC: 0x18

DW_FORM_FLAG_PRESENT: 0x19

// One abbreviation: code, DIE tag, whether it has children, then
// (attribute, form) pairs.
dwarf_abbrev: fn(bytes: &[U8], code: Int, die: Int, children: Bool, attributes: [Int]) Never! {
    dwarf_uleb(bytes, code)
    dwarf_uleb(bytes, die)
    dwarf_u8(bytes, if children -> 1 else -> 0)
    loop attribute in attributes -> dwarf_uleb(bytes, attribute)
    dwarf_uleb(bytes, 0)
    dwarf_uleb(bytes, 0)
}

// With `sections` (one section per function) the unit has no address range.
dwarf_abbrevs: fn(sections: Bool) -> [U8] Never! {
    a := [U8]{}
    named_variable: [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_DECL_FILE, DW_FORM_UDATA, DW_AT_DECL_LINE, DW_FORM_UDATA, DW_AT_TYPE, DW_FORM_REF4}
    located := named_variable
    located.push(DW_AT_LOCATION)
    located.push(DW_FORM_SEC_OFFSET)
    unit := [Int]{DW_AT_PRODUCER, DW_FORM_STRING, DW_AT_LANGUAGE, DW_FORM_DATA2, DW_AT_NAME, DW_FORM_STRING, DW_AT_COMP_DIR, DW_FORM_STRING}
    if !sections -> unit.extend([Int]{DW_AT_LOW_PC, DW_FORM_ADDR, DW_AT_HIGH_PC, DW_FORM_DATA8})
    unit.extend([Int]{DW_AT_STMT_LIST, DW_FORM_SEC_OFFSET})
    dwarf_abbrev(a, DWARF_ABBREV_UNIT, 0x11, true, unit)
    dwarf_abbrev(a, DWARF_ABBREV_BASE, 0x24, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_ENCODING, DW_FORM_DATA1, DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_POINTER, 0x0f, false, [Int]{DW_AT_BYTE_SIZE, DW_FORM_DATA1, DW_AT_TYPE, DW_FORM_REF4})
    dwarf_abbrev(a, DWARF_ABBREV_VOID_POINTER, 0x0f, false, [Int]{DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_STRUCT, 0x13, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_MEMBER, 0x0d, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_TYPE, DW_FORM_REF4, DW_AT_DATA_MEMBER_LOCATION, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_UNION, 0x17, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_ENUM, 0x04, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_ENUMERATOR, 0x28, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_CONST_VALUE, DW_FORM_SDATA})
    dwarf_abbrev(a, DWARF_ABBREV_TYPEDEF, 0x16, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_TYPE, DW_FORM_REF4})
    dwarf_abbrev(a, DWARF_ABBREV_OPAQUE, 0x13, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA, DW_AT_DECLARATION, DW_FORM_FLAG_PRESENT})
    dwarf_abbrev(
        a,
        DWARF_ABBREV_SUBPROGRAM,
        0x2e,
        true,
        [Int]{
            DW_AT_NAME,
            DW_FORM_STRING,
            DW_AT_DECL_FILE,
            DW_FORM_UDATA,
            DW_AT_DECL_LINE,
            DW_FORM_UDATA,
            DW_AT_LOW_PC,
            DW_FORM_ADDR,
            DW_AT_HIGH_PC,
            DW_FORM_DATA8,
            DW_AT_FRAME_BASE,
            DW_FORM_EXPRLOC,
            DW_AT_EXTERNAL,
            DW_FORM_FLAG_PRESENT,
        },
    )
    dwarf_abbrev(
        a,
        DWARF_ABBREV_GENERATED,
        0x2e,
        false,
        [Int]{
            DW_AT_NAME,
            DW_FORM_STRING,
            DW_AT_LOW_PC,
            DW_FORM_ADDR,
            DW_AT_HIGH_PC,
            DW_FORM_DATA8,
            DW_AT_FRAME_BASE,
            DW_FORM_EXPRLOC,
            DW_AT_ARTIFICIAL,
            DW_FORM_FLAG_PRESENT,
        },
    )
    dwarf_abbrev(a, DWARF_ABBREV_PARAMETER, 0x05, false, located)
    dwarf_abbrev(a, DWARF_ABBREV_VARIABLE, 0x34, false, located)
    dwarf_abbrev(a, DWARF_ABBREV_PARAMETER_UNLOCATED, 0x05, false, named_variable)
    dwarf_abbrev(a, DWARF_ABBREV_VARIABLE_UNLOCATED, 0x34, false, named_variable)
    dwarf_abbrev(a, DWARF_ABBREV_ANONYMOUS_UNION, 0x17, true, [Int]{DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    // The abstract subprogram of a function inlined somewhere (DW_INL_inlined)
    // and one concrete inlined copy.
    dwarf_abbrev(a, DWARF_ABBREV_ABSTRACT, 0x2e, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_DECL_FILE, DW_FORM_UDATA, DW_AT_DECL_LINE, DW_FORM_UDATA, DW_AT_INLINE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_ABSTRACT_GENERATED, 0x2e, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_ARTIFICIAL, DW_FORM_FLAG_PRESENT, DW_AT_INLINE, DW_FORM_DATA1})
    dwarf_abbrev(
        a,
        DWARF_ABBREV_INLINED,
        0x1d,
        true,
        [Int]{
            DW_AT_ABSTRACT_ORIGIN,
            DW_FORM_REF4,
            DW_AT_LOW_PC,
            DW_FORM_ADDR,
            DW_AT_HIGH_PC,
            DW_FORM_DATA8,
            DW_AT_CALL_FILE,
            DW_FORM_UDATA,
            DW_AT_CALL_LINE,
            DW_FORM_UDATA,
        },
    )
    dwarf_uleb(a, 0)
    a
}

// ---------------------------------------------------------------------------
// Types.

dwarf_encoding: fn(encoding: X64DebugEncoding) -> Int Never! {
    if encoding == {
        .Signed -> 0x05
        .Unsigned -> 0x07
        .Float -> 0x04
        .Bool -> 0x02
        .Char -> 0x10
    }
}

// A ref4 to type `row`, patched once every type has its offset.
dwarf_type_ref: fn(info: &[U8], refs: &[Int], rows: &[Int], row: Int) Never! {
    refs.push(info.len())
    rows.push(row)
    elf64_u32(info, 0)
}

dwarf_members: fn(info: &[U8], refs: &[Int], rows: &[Int], members: [X64DebugMember]) Never! {
    loop member in members {
        if member.ty < 0 -> next
        dwarf_uleb(info, DWARF_ABBREV_MEMBER)
        dwarf_string(info, member.name)
        dwarf_type_ref(info, refs, rows, member.ty)
        dwarf_uleb(info, member.offset)
    }
    dwarf_uleb(info, 0)
}

// Every type DIE, in row order; returns each row's DIE offset.
dwarf_types: fn(info: &[U8], types: [X64DebugType]) -> [Int] Never! {
    offsets := [Int]{}
    refs := [Int]{}
    rows := [Int]{}
    loop ty in types {
        offsets.push(info.len())
        if ty.kind == {
            .Base(encoding) -> {
                dwarf_uleb(info, DWARF_ABBREV_BASE)
                dwarf_string(info, ty.name)
                dwarf_u8(info, dwarf_encoding(encoding))
                dwarf_u8(info, ty.size)
            }
            .Pointer(target) -> {
                if {
                    target >= 0 -> {
                        dwarf_uleb(info, DWARF_ABBREV_POINTER)
                        dwarf_u8(info, 8)
                        dwarf_type_ref(info, refs, rows, target)
                    }
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_VOID_POINTER)
                        dwarf_u8(info, 8)
                    }
                }
            }
            .Struct(members) -> {
                dwarf_uleb(info, DWARF_ABBREV_STRUCT)
                dwarf_string(info, ty.name)
                dwarf_uleb(info, ty.size)
                dwarf_members(info, refs, rows, members)
            }
            .Union(members) -> {
                if {
                    ty.name == "" -> dwarf_uleb(info, DWARF_ABBREV_ANONYMOUS_UNION)
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_UNION)
                        dwarf_string(info, ty.name)
                    }
                }
                dwarf_uleb(info, ty.size)
                dwarf_members(info, refs, rows, members)
            }
            .Enum(enumerators) -> {
                dwarf_uleb(info, DWARF_ABBREV_ENUM)
                dwarf_string(info, ty.name)
                dwarf_u8(info, ty.size)
                loop enumerator in enumerators {
                    dwarf_uleb(info, DWARF_ABBREV_ENUMERATOR)
                    dwarf_string(info, enumerator.name)
                    dwarf_sleb(info, enumerator.value)
                }
                dwarf_uleb(info, 0)
            }
            .Typedef(target) -> {
                if {
                    target >= 0 -> {
                        dwarf_uleb(info, DWARF_ABBREV_TYPEDEF)
                        dwarf_string(info, ty.name)
                        dwarf_type_ref(info, refs, rows, target)
                    }
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_OPAQUE)
                        dwarf_string(info, ty.name)
                        dwarf_uleb(info, ty.size)
                    }
                }
            }
            .Opaque -> {
                dwarf_uleb(info, DWARF_ABBREV_OPAQUE)
                dwarf_string(info, ty.name)
                dwarf_uleb(info, ty.size)
            }
        }
    }
    loop (index, at) in refs -> dwarf_patch_u32(info, at, offsets[rows[index]])
    offsets
}

// ---------------------------------------------------------------------------
// Variable locations.

// The location of a variable carried at `location`: the value itself, or
// for an `indirect` variable the memory its value points at. The frame base
// is rbp. A FrameAddress value is rbp + offset itself: indirect, that is the
// memory at fbreg(offset); direct, the computed address (DW_OP_stack_value).
dwarf_location: fn(location: X64DebugLocation, indirect: Bool) -> [U8] Never! {
    expr := [U8]{}
    if location == {
        .Register(reg) -> {
            // DW_OP_reg0 + n / DW_OP_breg0 + n name registers below 32;
            // DW_OP_regx / DW_OP_bregx the rest (xmm15 is 32).
            number: x64_dwarf_register(reg)
            if {
                indirect && number < 32 -> {
                    dwarf_u8(expr, 0x70 + number)
                    dwarf_sleb(expr, 0)
                }
                indirect -> {
                    dwarf_u8(expr, 0x92)
                    dwarf_uleb(expr, number)
                    dwarf_sleb(expr, 0)
                }
                number < 32 -> dwarf_u8(expr, 0x50 + number)
                else -> {
                    dwarf_u8(expr, 0x90)
                    dwarf_uleb(expr, number)
                }
            }
        }
        .Frame(offset) -> {
            dwarf_u8(expr, 0x91)
            dwarf_sleb(expr, offset)
            if indirect -> dwarf_u8(expr, 0x06)
        }
        .FrameAddress(offset) -> {
            dwarf_u8(expr, 0x91)
            dwarf_sleb(expr, offset)
            if !indirect -> dwarf_u8(expr, 0x9f)
        }
    }
    expr
}

// The ranges of each of a function's `count` variables, in binding order:
// one pass over the function's ranges instead of one per variable.
dwarf_variable_buckets: fn(ranges: [X64VariableRange], count: Int) -> [[X64VariableRange]] Never! {
    buckets := [[X64VariableRange]]{}
    loop _ in 0..<count -> buckets.push([X64VariableRange]{})
    loop range in ranges {
        if range.variable >= 0 && range.variable < count {
            buckets[range.variable].push(range.copy())
        }
    }
    buckets
}

// The ranges of one variable (its bucket, in binding order), by start, a
// stable order (equal starts keep their binding order); where two overlap
// the later binding wins (a new value of the variable is defined while the
// old one is still live).
dwarf_variable_ranges: fn(ranges: [X64VariableRange]) -> [X64VariableRange] Never! {
    order: dwarf_range_order(ranges)
    sorted := [X64VariableRange]{}
    loop index in order -> sorted.push(ranges[index])
    trimmed := [X64VariableRange]{}
    loop (index, range) in sorted {
        end := range.end
        if index + 1 < sorted.len() && sorted[index + 1].start < end {
            end = sorted[index + 1].start
        }
        if end > range.start {
            trimmed.push(X64VariableRange{variable: range.variable, start: range.start, end: end, location: range.location})
        }
    }
    trimmed
}

// The indexes of `ranges` by ascending start, a stable merge of the indexes
// (a right-run range moves before a left-run one only when its start is
// strictly lower), so the order is the insertion sort's.
dwarf_range_order: fn(ranges: [X64VariableRange]) -> [Int] Never! {
    count: ranges.len()
    order := [Int]{}
    loop index in 0..<count -> order.push(index)
    if count < 2 -> return order
    scratch := [Int]{}
    loop _ in 0..<count -> scratch.push(0)
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle := start + width
            if middle > count -> middle = count
            end := start + width + width
            if end > count -> end = count
            left := start
            right := middle
            out := start
            loop left < middle && right < end {
                if ranges[order[right]].start < ranges[order[left]].start {
                    scratch[out] = order[right]
                    right += 1
                } else {
                    scratch[out] = order[left]
                    left += 1
                }
                out += 1
            }
            loop left < middle {
                scratch[out] = order[left]
                left += 1
                out += 1
            }
            loop right < end {
                scratch[out] = order[right]
                right += 1
                out += 1
            }
            start = end
        }
        loop index in 0..<count -> order[index] = scratch[index]
        width += width
    }
    order
}

// ---------------------------------------------------------------------------
// Compile unit, line program and location lists.

dwarf_address: fn(bytes: &[U8], relas: &[X64ObjectRela], symbol: Int, addend: Int) Never! {
    relas.push(X64ObjectRela{at: bytes.len(), symbol: symbol, kind: ELF64_R_X86_64_64, addend: addend})
    elf64_u64(bytes, 0)
}

dwarf_section_offset: fn(bytes: &[U8], relas: &[X64ObjectRela], symbol: Int, addend: Int) Never! {
    relas.push(X64ObjectRela{at: bytes.len(), symbol: symbol, kind: ELF64_R_X86_64_32, addend: addend})
    elf64_u32(bytes, 0)
}

// The source facts of compiled function `function` (`main` has none).
dwarf_function_debug: fn(program: X64ObjectModule, function: X64CompiledFunction) -> X64FunctionSource Never! {
    id: function.id.value
    if id < 0 || id >= program.functions.len() -> return x64_function_source_none()
    program.functions[id]
}

// The compile unit of `.debug_info` and the `.debug_loclists` it refers to:
// the unit header and the types on the calling thread, then one subprogram
// per function (dwarf_info_function), in function order. The subprograms
// are built in consecutive function parts on the threads `threads` admits
// (one part per thread, weighted by the functions' variables, ranges and
// inline runs): each part's bytes, relocations and references to its own
// DIEs are relative to the part's own start. Each part's bytes become a
// piece of its section as they are, in function order, after the unit's
// header (X64DwarfSections); each relocation's offset and each such
// reference (its place and value) shift by the info bytes before its part,
// and the loclists offsets (the relocations against `symbols.loclists`)
// and the loclists relocations' offsets by the loclists bytes before it, so
// the sections are those of the one-thread loop.
dwarf_info: fn(sections: &X64DwarfSections, program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], text_size: Int, symbols: X64DwarfSymbols, threads: CompilerThreads) Never! {
    info := [U8]{}
    relas := [X64ObjectRela]{}
    lists := [U8]{}
    list_relas := [X64ObjectRela]{}
    elf64_u32(lists, 0)
    elf64_u16(lists, 5)
    dwarf_u8(lists, 8)
    dwarf_u8(lists, 0)
    elf64_u32(lists, 0)

    elf64_u32(info, 0)
    elf64_u16(info, 5)
    // DW_UT_compile, 8-byte addresses, the abbreviation table.
    dwarf_u8(info, 1)
    dwarf_u8(info, 8)
    dwarf_section_offset(info, relas, symbols.abbrev, 0)
    paths: program.debug.files
    dwarf_uleb(info, DWARF_ABBREV_UNIT)
    dwarf_string(info, "Jet native backend (O0)")
    // DW_LANG_C11: the closest registered language whose expression syntax
    // (`p.x`, `*p`, `p->x`) reads Jet values.
    elf64_u16(info, 0x1d)
    dwarf_string(info, if paths.len() > 0 -> paths[0] else -> "<generated>")
    dwarf_string(info, if program.debug.directory == "" -> "." else -> program.debug.directory)
    if symbols.functions.len() == 0 {
        dwarf_address(info, relas, symbols.text, 0)
        elf64_u64(info, text_size)
    }
    dwarf_section_offset(info, relas, symbols.line, 0)
    type_offsets: dwarf_types(info, program.debug.types)

    weights := [Int]{}
    total := 0
    loop (index, function) in functions {
        weight: 1 + dwarf_function_debug(program, function).variables.len() + debug[index].ranges.len() + debug[index].inlines.len()
        weights.push(weight)
        total += weight
    }
    workers: compiler_threads_admit(threads, functions.len(), total, DWARF_INFO_MIN_WEIGHT_PER_THREAD, 0, 0)
    if workers <= 1 {
        // The unit starts `info`: the subprograms' own references need no shift.
        refs := [Int]{}
        loop (index, function) in functions {
            dwarf_info_function(info, relas, refs, lists, list_relas, program, function, debug[index], offsets[index], dwarf_function_symbol(symbols, index), type_offsets, symbols)
        }
        dwarf_uleb(info, 0)
        dwarf_patch_length(info, 0)
        dwarf_patch_length(lists, 0)
        sections.info = [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: info.move()}}
        sections.info_relas = relas.move()
        sections.loclists = [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: lists.move()}}
        sections.loclists_relas = list_relas.move()
        return
    }
    bounds: compiler_threads_partition(weights, workers)
    inputs: Shared{DwarfInfoShared{program: program, functions: functions, debug: debug, offsets: offsets, type_offsets: type_offsets, symbols: symbols}}
    parts := [Shared<DwarfInfoPart>]{}
    loop part in 0..<(bounds.len() - 1) {
        parts.push(Shared{DwarfInfoPart{start: bounds[part], end: bounds[part + 1], outputs: [DwarfInfoRows]{}}})
    }
    _ := dwarf_info_parts(inputs, parts, 0) ?? panic("the DWARF info threads failed")
    taken := [DwarfInfoRows]{}
    loop part in parts -> taken.push(dwarf_info_part_take(part))
    // The unit's length counts every part and its closing null entry.
    info_size := info.len() + 1
    lists_size := lists.len()
    loop rows in taken {
        info_size += rows.info.len()
        lists_size += rows.lists.len()
    }
    dwarf_patch_u32(info, 0, info_size - 4)
    dwarf_patch_u32(lists, 0, lists_size - 4)
    // Each part's bytes become a piece of its section as they are; its
    // relocations and references shift by the bytes before it.
    info_base := info.len()
    lists_base := lists.len()
    info_pieces := [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: info.move()}}
    list_pieces := [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: lists.move()}}
    taken.reverse()
    loop taken.len() > 0 {
        rows := taken.pop() ?? {
            break
        }
        loop rela in rows.relas {
            addend: if rela.symbol == symbols.loclists -> rela.addend + lists_base else -> rela.addend
            relas.push(X64ObjectRela{at: rela.at + info_base, symbol: rela.symbol, kind: rela.kind, addend: addend})
        }
        loop rela in rows.list_relas {
            list_relas.push(X64ObjectRela{at: rela.at + lists_base, symbol: rela.symbol, kind: rela.kind, addend: rela.addend})
        }
        loop pair in 0..<(rows.refs.len() >> 1) {
            dwarf_patch_u32(rows.info, rows.refs[2 * pair], info_base + rows.refs[2 * pair + 1])
        }
        info_at: info_base
        lists_at: lists_base
        info_base += rows.info.len()
        lists_base += rows.lists.len()
        info_pieces.push(X64ObjectPiece{at: info_at, bytes: rows.info.move()})
        list_pieces.push(X64ObjectPiece{at: lists_at, bytes: rows.lists.move()})
    }
    info_pieces.push(X64ObjectPiece{at: info_base, bytes: [U8]{U8{0}}})
    sections.info = info_pieces.move()
    sections.info_relas = relas.move()
    sections.loclists = list_pieces.move()
    sections.loclists_relas = list_relas.move()
}

// Fewest weight units (a function, each of its variables, each of its
// ranges and each of its inline runs count one) a subprogram thread is
// admitted for: a few hundred DIEs outweigh a thread's start.
DWARF_INFO_MIN_WEIGHT_PER_THREAD: 400

// The threads' inputs for the subprograms: shared handles of the module,
// the compiled functions, their debug rows and offsets, the type DIE
// offsets and the section symbols; read only.
DwarfInfoShared: struct {
    program: X64ObjectModule
    functions: [X64CompiledFunction]
    debug: [X64FunctionDebug]
    offsets: [Int]
    type_offsets: [Int]
    symbols: X64DwarfSymbols
}

// One thread's consecutive function range and its rows (`outputs` holds
// one row once the thread finished).
DwarfInfoPart: struct {
    start: Int
    end: Int
    outputs: [DwarfInfoRows]
}

// The subprograms of one part: its `.debug_info` bytes, their relocations
// (`at` relative to the part's first byte; a loclists relocation's addend
// relative to the part's first loclists byte), the references to its own
// DIEs (dwarf_info_function `refs`, relative to the part's first byte), its
// `.debug_loclists` bytes and their relocations (`at` relative to the
// part's first loclists byte).
DwarfInfoRows: struct {
    info: [U8]
    relas: [X64ObjectRela]
    refs: [Int]
    lists: [U8]
    list_relas: [X64ObjectRela]
}

// Builds `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts were built.
dwarf_info_parts: fn(inputs: Shared<DwarfInfoShared>, parts: [Shared<DwarfInfoPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return dwarf_info_part(inputs, parts[from])
    built := 0
    task.group dwarf_info_threads {
        head: task dwarf_info_part(inputs, parts[from])
        built = dwarf_info_parts(inputs, parts, from + 1)
        built += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    built
}

// One thread: the subprograms of its function range, in function order.
dwarf_info_part: fn(inputs: Shared<DwarfInfoShared>, part: Shared<DwarfInfoPart>) -> Int {
    permit := part.guard_edit()
    reads: inputs.guard_read()
    info := [U8]{}
    relas := [X64ObjectRela]{}
    refs := [Int]{}
    lists := [U8]{}
    list_relas := [X64ObjectRela]{}
    loop index in permit.value.start..<permit.value.end {
        function: reads.value.functions[index]
        dwarf_info_function(info, relas, refs, lists, list_relas, reads.value.program, function, reads.value.debug[index], reads.value.offsets[index], dwarf_function_symbol(reads.value.symbols, index), reads.value.type_offsets, reads.value.symbols)
    }
    permit.value.outputs.push(DwarfInfoRows{info: info.move(), relas: relas.move(), refs: refs.move(), lists: lists.move(), list_relas: list_relas.move()})
    1
}

// A part's rows, after its thread joined.
dwarf_info_part_take: fn(part: Shared<DwarfInfoPart>) -> DwarfInfoRows {
    permit: part.guard_edit()
    permit.value.outputs.pop() ?? panic("a DWARF info thread left no rows")
}

// One function's subprogram DIE in `info` (its address relocation against
// `symbol` at `offset`, the function's place in its section) and, per
// located variable, its location list in `lists` referred to by a
// relocation against `symbols.loclists` whose addend is the list's offset
// in `lists`; the lists' own relocations, with one section per function,
// go to `list_relas`.
//
// A function with inlined code (X64FunctionSource.inlines) first gets, at
// the unit's level, one abstract subprogram per function inlined into it.
// Inside its subprogram each run of inlined code (X64FunctionDebug.inlines)
// is an inlined subroutine of that origin, nested as the sites are, with
// the variables of its site; a variable of a site left with no code goes
// to the nearest enclosing site with code. Each reference to an abstract
// subprogram is a pair in `refs`: the place of its ref4 in `info` and the
// DIE's offset, both from `info`'s start.
dwarf_info_function: fn(info: &[U8], relas: &[X64ObjectRela], refs: &[Int], lists: &[U8], list_relas: &[X64ObjectRela], program: X64ObjectModule, function: X64CompiledFunction, debug: X64FunctionDebug, offset: Int, symbol: Int, type_offsets: [Int], symbols: X64DwarfSymbols) Never! {
    facts: dwarf_function_debug(program, function)
    if facts.file < 0 {
        dwarf_uleb(info, DWARF_ABBREV_GENERATED)
        dwarf_string(info, function.name)
        dwarf_address(info, relas, symbol, offset)
        elf64_u64(info, function.code.len())
        // Frame base: DW_OP_reg6 (rbp).
        dwarf_uleb(info, 1)
        dwarf_u8(info, 0x56)
        return
    }
    origins: dwarf_inline_origins(info, facts.inlines)
    dwarf_uleb(info, DWARF_ABBREV_SUBPROGRAM)
    dwarf_string(info, facts.name)
    dwarf_uleb(info, facts.file + 1)
    dwarf_uleb(info, facts.line)
    dwarf_address(info, relas, symbol, offset)
    elf64_u64(info, function.code.len())
    dwarf_uleb(info, 1)
    dwarf_u8(info, 0x56)
    // The location lists first, in variable order: a variable of a site
    // with several runs is in each run's DIE, all naming its one list.
    buckets: dwarf_variable_buckets(debug.ranges, facts.variables.len())
    places := [Int]{}
    loop (variable, row) in facts.variables {
        ranges: dwarf_variable_ranges(buckets[variable])
        if ranges.len() == 0 {
            places.push(-1)
            next
        }
        places.push(lists.len())
        loop range in ranges {
            if symbols.functions.len() == 0 {
                // DW_LLE_offset_pair from the unit's base, the start of .text.
                dwarf_u8(lists, 0x04)
                dwarf_uleb(lists, offset + range.start)
                dwarf_uleb(lists, offset + range.end)
            } else {
                // DW_LLE_start_length: the function's own section.
                dwarf_u8(lists, 0x08)
                dwarf_address(lists, list_relas, symbol, offset + range.start)
                dwarf_uleb(lists, range.end - range.start)
            }
            expr: dwarf_location(range.location, row.indirect)
            dwarf_uleb(lists, expr.len())
            lists.extend(expr)
        }
        dwarf_u8(lists, 0)
    }
    // Per site, the variables it holds (site 0: the subprogram).
    count: facts.inlines.len()
    coded := [Bool]{false}
    loop _ in 0..<count -> coded.push(false)
    loop run in debug.inlines {
        if run.site > 0 && run.site <= count -> coded[run.site] = true
    }
    homes := [Int]{0}
    held := [[Int]]{[Int]{}}
    loop site in 1..<(count + 1) {
        parent: facts.inlines[site - 1].parent
        home: if {
            coded[site] -> site
            parent > 0 && parent < site -> homes[parent]
            else -> 0
        }
        homes.push(home)
        held.push([Int]{})
    }
    loop (variable, row) in facts.variables {
        home: if row.site > 0 && row.site <= count -> homes[row.site] else -> 0
        held[home].push(variable)
    }
    loop variable in held[0] {
        dwarf_info_variable(info, relas, facts.variables[variable], facts.file, places[variable], type_offsets, symbols)
    }
    // The runs, each inside the open run that contains it.
    ends := [Int]{}
    loop run in debug.inlines {
        if run.site <= 0 || run.site > count -> next
        loop ends.len() > 0 && run.start >= ends[ends.len() - 1] {
            _ := ends.pop()
            dwarf_uleb(info, 0)
        }
        site: facts.inlines[run.site - 1]
        dwarf_uleb(info, DWARF_ABBREV_INLINED)
        refs.push(info.len())
        refs.push(origins[run.site - 1])
        elf64_u32(info, origins[run.site - 1])
        dwarf_address(info, relas, symbol, offset + run.start)
        elf64_u64(info, run.end - run.start)
        caller_file: if site.parent > 0 && site.parent <= count -> facts.inlines[site.parent - 1].file else -> facts.file
        dwarf_uleb(info, if caller_file >= 0 -> caller_file + 1 else -> 0)
        dwarf_uleb(info, if site.call_line > 0 -> site.call_line else -> 0)
        file: if site.file >= 0 -> site.file else -> facts.file
        loop variable in held[run.site] {
            dwarf_info_variable(info, relas, facts.variables[variable], file, places[variable], type_offsets, symbols)
        }
        ends.push(run.end)
    }
    loop _ in ends -> dwarf_uleb(info, 0)
    dwarf_uleb(info, 0)
}

// The abstract subprograms (DW_INL_inlined) of the functions inlined at
// `sites`, one per function; per site, its function's DIE offset in `info`.
dwarf_inline_origins: fn(info: &[U8], sites: [X64InlineSite]) -> [Int] Never! {
    origins := [Int]{}
    if sites.len() == 0 -> return origins
    firsts := [Int:Int]{}
    loop (index, site) in sites {
        if site.function >= 0 {
            if firsts.get(site.function) == .Val(first) {
                origins.push(origins[first])
                next
            }
            firsts.add(site.function, index).drop("checked absent above")
        }
        origins.push(info.len())
        dwarf_uleb(info, if site.file < 0 -> DWARF_ABBREV_ABSTRACT_GENERATED else -> DWARF_ABBREV_ABSTRACT)
        dwarf_string(info, site.name)
        if site.file >= 0 {
            dwarf_uleb(info, site.file + 1)
            dwarf_uleb(info, site.line)
        }
        // DW_INL_inlined.
        dwarf_u8(info, 1)
    }
    origins
}

// A variable's DIE, declared in `file`; `place` is its location list's
// offset in the part's lists, -1 for none.
dwarf_info_variable: fn(info: &[U8], relas: &[X64ObjectRela], row: X64DebugVariable, file: Int, place: Int, type_offsets: [Int], symbols: X64DwarfSymbols) Never! {
    located: place >= 0
    abbrev: if {
        row.parameter && located -> DWARF_ABBREV_PARAMETER
        row.parameter -> DWARF_ABBREV_PARAMETER_UNLOCATED
        located -> DWARF_ABBREV_VARIABLE
        else -> DWARF_ABBREV_VARIABLE_UNLOCATED
    }
    dwarf_uleb(info, abbrev)
    dwarf_string(info, row.name)
    dwarf_uleb(info, file + 1)
    dwarf_uleb(info, row.line)
    elf64_u32(info, type_offsets[row.ty])
    if located -> dwarf_section_offset(info, relas, symbols.loclists, place)
}

dwarf_line: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    line := [U8]{}
    relas := [X64ObjectRela]{}
    elf64_u32(line, 0)
    elf64_u16(line, 5)
    dwarf_u8(line, 8)
    dwarf_u8(line, 0)
    header_length_at: line.len()
    elf64_u32(line, 0)
    // Minimum instruction length 1, one operation per instruction, rows are
    // statements, line_base -5, line_range 14, opcode_base 13.
    loop byte in ([Int]{1, 1, 1, 0xfb, 14, 13}) -> dwarf_u8(line, byte)
    loop byte in ([Int]{0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1}) -> dwarf_u8(line, byte)
    // Directories: (path, string); the compilation directory only.
    dwarf_u8(line, 1)
    dwarf_uleb(line, 1)
    dwarf_uleb(line, DW_FORM_STRING)
    dwarf_uleb(line, 1)
    dwarf_string(line, if program.debug.directory == "" -> "." else -> program.debug.directory)
    // Files: (path, string), (directory index, udata). File 0 is the
    // primary source file; file i + 1 is X64ModuleDebug.files[i].
    paths: program.debug.files
    dwarf_u8(line, 2)
    dwarf_uleb(line, 1)
    dwarf_uleb(line, DW_FORM_STRING)
    dwarf_uleb(line, 2)
    dwarf_uleb(line, DW_FORM_UDATA)
    dwarf_uleb(line, paths.len() + 1)
    dwarf_string(line, if paths.len() > 0 -> paths[0] else -> "<generated>")
    dwarf_uleb(line, 0)
    loop path in paths {
        dwarf_string(line, path)
        dwarf_uleb(line, 0)
    }
    dwarf_patch_length(line, header_length_at)

    loop (index, function) in functions {
        facts: dwarf_function_debug(program, function)
        rows: debug[index].lines
        if facts.file < 0 || rows.len() == 0 -> next
        // DW_LNE_set_address.
        dwarf_u8(line, 0)
        dwarf_uleb(line, 9)
        dwarf_u8(line, 2)
        dwarf_address(line, relas, dwarf_function_symbol(symbols, index), offsets[index])
        if facts.file != 0 {
            dwarf_u8(line, 0x04)
            dwarf_uleb(line, facts.file + 1)
        }
        current_line := 1
        current_at := 0
        loop row in rows {
            if row.line != current_line {
                dwarf_u8(line, 0x03)
                dwarf_sleb(line, row.line - current_line)
                current_line = row.line
            }
            if row.at != current_at {
                dwarf_u8(line, 0x02)
                dwarf_uleb(line, row.at - current_at)
                current_at = row.at
            }
            if row.at == debug[index].body -> dwarf_u8(line, 0x0a)
            dwarf_u8(line, 0x01)
        }
        if function.code.len() > current_at {
            dwarf_u8(line, 0x02)
            dwarf_uleb(line, function.code.len() - current_at)
        }
        // DW_LNE_end_sequence.
        dwarf_u8(line, 0)
        dwarf_uleb(line, 1)
        dwarf_u8(line, 1)
    }
    dwarf_patch_length(line, 0)
    DwarfSectionRows{bytes: line.move(), relas: relas.move()}
}

// The `.debug_jetline` table of the Jet functions (those with a source file
// and a declaration line: fault reports name no other), the facts
// `.debug_info` and `.debug_line` hold, in one block the fault handler scans
// without a DWARF reader:
//   u32 length of the block after this word, u32 function count, u32 offset
//   of the strings and u32 of the rows (from the block's start), then per
//   function 32 bytes: u64 start address (a relocation), u32 code length,
//   u32 name and u32 file path (string offsets), u32 declaration line,
//   u32 offset of its rows (in the rows) and u32 row count.
//   Strings: the compilation directory (`.` when none) at 0, then the names
//   and the paths (each path once), NUL terminated.
//   Rows: per function, per `.debug_line` row the uleb address and sleb
//   line advance from the previous row (the first from address 0, line 1).
// This is the object form: the linker (Image/DebugPrune.jet) drops the
// records of the functions it dropped and writes the linked form the fault
// report reads, varint records in address order.
dwarf_jet_line: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    table := [U8]{}
    relas := [X64ObjectRela]{}
    strings := [U8]{}
    rows := [U8]{}
    dwarf_string(strings, if program.debug.directory == "" -> "." else -> program.debug.directory)
    paths := [Int]{}
    loop _ in program.debug.files -> paths.push(-1)
    kept := [Int]{}
    loop (index, function) in functions {
        facts: dwarf_function_debug(program, function)
        if facts.file >= 0 && facts.line > 0 -> kept.push(index)
    }
    elf64_u32(table, 0)
    elf64_u32(table, kept.len())
    strings_at: table.len()
    elf64_u32(table, 0)
    rows_at: table.len()
    elf64_u32(table, 0)
    loop index in kept {
        function: functions[index]
        facts: dwarf_function_debug(program, function)
        dwarf_address(table, relas, dwarf_function_symbol(symbols, index), offsets[index])
        elf64_u32(table, function.code.len())
        elf64_u32(table, strings.len())
        dwarf_string(strings, facts.name)
        if paths[facts.file] < 0 {
            paths[facts.file] = strings.len()
            dwarf_string(strings, program.debug.files[facts.file])
        }
        elf64_u32(table, paths[facts.file])
        elf64_u32(table, facts.line)
        elf64_u32(table, rows.len())
        elf64_u32(table, debug[index].lines.len())
        current_line := 1
        current_at := 0
        loop row in debug[index].lines {
            dwarf_uleb(rows, row.at - current_at)
            dwarf_sleb(rows, row.line - current_line)
            current_at = row.at
            current_line = row.line
        }
    }
    strings_start: table.len()
    dwarf_patch_u32(table, strings_at, strings_start)
    table.extend(strings)
    rows_start: table.len()
    dwarf_patch_u32(table, rows_at, rows_start)
    table.extend(rows)
    dwarf_patch_length(table, 0)
    DwarfSectionRows{bytes: table.move(), relas: relas.move()}
}

// The debug and unwind sections for `functions` (placed at `offsets` in a
// `.text` of `text_size` bytes, or with `symbols.functions` each at offset 0
// of its own section; debug[i] belongs to functions[i]); the subprograms of
// `.debug_info` on the threads `threads` admits. With `debug_info` false
// only `.eh_frame` is built; the DWARF sections and `.debug_jetline` stay
// empty. Each section reads only the inputs, so when `threads` admits a
// second thread for the line rows, `.eh_frame`, `.debug_line` and
// `.debug_jetline` are each built on a thread of their own while this
// thread builds `.debug_info`: the bytes are the same for any thread count.
x64_dwarf_sections: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], text_size: Int, symbols: X64DwarfSymbols, threads: CompilerThreads, debug_info: Bool) -> X64DwarfSections Never! {
    sections := X64DwarfSections{
        eh_frame: [U8]{},
        eh_relas: [X64ObjectRela]{},
        abbrev: [U8]{},
        info: [X64ObjectPiece]{},
        info_relas: [X64ObjectRela]{},
        line: [U8]{},
        line_relas: [X64ObjectRela]{},
        jet_line: [U8]{},
        jet_line_relas: [X64ObjectRela]{},
        loclists: [X64ObjectPiece]{},
        loclists_relas: [X64ObjectRela]{},
    }
    rows := 0
    loop row in debug -> rows += 1 + row.lines.len()
    frame := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    line := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    jet_line := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    if debug_info -> sections.abbrev = dwarf_abbrevs(symbols.functions.len() > 0)
    if {
        !debug_info -> frame = dwarf_eh_frame(functions, debug, offsets, symbols)
        compiler_threads_admit(threads, functions.len(), rows, DWARF_LINE_MIN_ROWS_PER_THREAD, 0, 0) <= 1 -> {
            frame = dwarf_eh_frame(functions, debug, offsets, symbols)
            dwarf_info(sections, program, functions, debug, offsets, text_size, symbols, threads)
            line = dwarf_line(program, functions, debug, offsets, symbols)
            jet_line = dwarf_jet_line(program, functions, debug, offsets, symbols)
        }
        else -> {
            task.group dwarf_section_threads {
                framing: task dwarf_eh_frame(functions, debug, offsets, symbols)
                lining: task dwarf_line(program, functions, debug, offsets, symbols)
                jet_lining: task dwarf_jet_line(program, functions, debug, offsets, symbols)
                dwarf_info(sections, program, functions, debug, offsets, text_size, symbols, threads)
                frame = framing.join() ?? panic(compiler_threads_failure_text(err))
                line = lining.join() ?? panic(compiler_threads_failure_text(err))
                jet_line = jet_lining.join() ?? panic(compiler_threads_failure_text(err))
            }
        }
    }
    sections.eh_frame = frame.bytes.move()
    sections.eh_relas = frame.relas.move()
    sections.line = line.bytes.move()
    sections.line_relas = line.relas.move()
    sections.jet_line = jet_line.bytes.move()
    sections.jet_line_relas = jet_line.relas.move()
    sections
}

// Fewest line rows (a function counts one besides its rows) a section
// thread is admitted for: below it `.eh_frame`, `.debug_line` and
// `.debug_jetline` are built on the calling thread, after the subprograms.
DWARF_LINE_MIN_ROWS_PER_THREAD: 20000

// The section rows' relocations as numbers, for comparing them.
dwarf_test_relas: fn(relas: [X64ObjectRela]) -> [Int] Never! {
    out := [Int]{}
    loop rela in relas {
        out.push(rela.at)
        out.push(rela.symbol)
        out.push(rela.kind)
        out.push(rela.addend)
    }
    out
}

// A section's pieces joined, for comparing them; a piece that does not
// start where the one before it ends leaves the bytes empty.
dwarf_test_bytes: fn(pieces: [X64ObjectPiece]) -> [U8] Never! {
    out := [U8]{}
    loop piece in pieces {
        if piece.at != out.len() -> return [U8]{}
        out.extend(piece.bytes)
    }
    out
}

#Test("the debug sections built beside the subprograms are those of one thread") {
    count: 3000
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    sources := [X64FunctionSource]{}
    offsets := [Int]{}
    loop id in 0..<count {
        code := [U8]{}
        lines := [X64LineRow]{}
        loop row in 0..<20 {
            code.push(U8{0x90})
            lines.push(X64LineRow{at: row, line: id + 2 * row + 1})
        }
        code.push(U8{0xc3})
        offsets.push(id * 32)
        functions.push(X64CompiledFunction{id: X64FunctionID{value: id}, name: "f{id}", code: code.move(), relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN})
        debug.push(X64FunctionDebug{lines: lines.move(), body: 1, cfi: [U8]{U8{0x0e}, U8{0x10}}, ranges: [X64VariableRange]{}})
        sources.push(X64FunctionSource{name: "f{id}", file: id % 2, line: id + 1, variables: [X64DebugVariable]{}})
    }
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{"a.jet", "b.jet"}, types: [X64DebugType]{}}, functions: sources.move()}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, functions: [Int]{}}
    one: x64_dwarf_sections(program, functions, debug, offsets, count * 32, symbols, compiler_threads_single(), true)
    many: x64_dwarf_sections(program, functions, debug, offsets, count * 32, symbols, CompilerThreads{cap: Val(8), cores: 8, memory_available: None}, true)
    assert(one.line.len() > 0 && one.jet_line.len() > 0 && one.eh_frame.len() > 0)
    assert_eq(many.eh_frame, one.eh_frame)
    assert_eq(dwarf_test_relas(many.eh_relas), dwarf_test_relas(one.eh_relas))
    assert(many.info.len() > 2 && one.info.len() == 1)
    assert(dwarf_test_bytes(one.info).len() > 0)
    assert_eq(dwarf_test_bytes(many.info), dwarf_test_bytes(one.info))
    assert_eq(dwarf_test_relas(many.info_relas), dwarf_test_relas(one.info_relas))
    assert_eq(many.line, one.line)
    assert_eq(dwarf_test_relas(many.line_relas), dwarf_test_relas(one.line_relas))
    assert_eq(many.jet_line, one.jet_line)
    assert_eq(dwarf_test_relas(many.jet_line_relas), dwarf_test_relas(one.jet_line_relas))
    assert_eq(dwarf_test_bytes(many.loclists), dwarf_test_bytes(one.loclists))
}
