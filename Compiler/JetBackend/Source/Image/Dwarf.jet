// DWARF 5 debug information and `.eh_frame` call frame information for the
// relocatable object (Image/Object.jet), so gdb and lldb can break on a
// source line, step, show source, unwind and print a native program's
// parameters and locals. The code generator records the source facts and,
// per compiled function, where each line's code starts, the frame's call
// frame instructions and each variable's location ranges (Emission.jet
// X64ObjectModule, X64FunctionDebug). This file only encodes them:
//
// - `.eh_frame`: one CIE (CFA = rsp + 8, return address at CFA - 8) and one
//   FDE per function with the function's call frame instructions. The
//   in-process linker keeps an FDE exactly when its function is live and
//   the startup object registers the table, so the runtime's unwinder and
//   debuggers both walk through Jet frames. When no unwinder is linked, a
//   split link writes the table to the side debug file as `.debug_frame`
//   instead (StaticLink.jet link_debug_frame), for debuggers and profilers.
// - `.debug_abbrev`, `.debug_info`: one compile unit covering `.text` (with
//   one section per function, a unit without an address range); the
//   types of X64ModuleDebug.types; one subprogram per function (frame base
//   rbp) with its parameters and variables, each located by a location list.
//   Code inlined into a function is an inlined subroutine of an abstract
//   subprogram of the inlined function, so a debugger shows its frame and
//   locals. Generated functions (glue, helpers, `main`) are artificial
//   subprograms. Each call whose caller keeps some of its arguments while
//   it runs is a call site of its subprogram with its return address, the
//   line and column of its source node and a call site parameter per kept
//   argument (X64FunctionDebug.calls); past its register's range a
//   parameter its body never writes is located by its entry value, which
//   `jet debug` reads from those. A `--checked-alloc` image's allocating
//   calls are call sites of their subprogram, each with its return address
//   and the type of what its block holds (X64FunctionDebug.allocs), which
//   `jet perf` names a heap snapshot's blocks by.
// - `.debug_line`: one sequence per function with source lines, its
//   statement rows (X64LineRow); the row at the end of the prologue carries
//   `prologue_end`.
// - `.debug_jetline`: not DWARF. The location table the runtime's fault
//   report reads (JetRuntime Assets/FaultReport/report.S) instead of
//   parsing the DWARF: per Jet function its address range, name, file,
//   declaration line and every row, the call rows too, delta coded
//   (dwarf_jet_line, Image/Jetline.jet x64_jetline_rows). A caller's frame
//   is the row at its return address - 1: its call's line and column.
// - `.debug_addr`: one address per function, its start, in function order;
//   the subprogram's DW_AT_low_pc is its index (DW_FORM_addrx). Each is a
//   relocation against the function's section, the only one the function's
//   address costs outside its call sites.
// - `.debug_loclists`, `.debug_rnglists`: an offsets table, then the lists
//   (DW_FORM_loclistx, DW_FORM_rnglistx index the table from the unit's
//   DW_AT_loclists_base and DW_AT_rnglists_base). A variable's location list
//   and an inlined run's range list start from their function's address
//   (DW_LLE_base_addressx, DW_RLE_base_addressx), and each range is an
//   offset pair from it, so the lists need no relocations.
// - `.debug_jetsource`: not DWARF. The sources the image was compiled from
//   (X64ModuleDebug.sources), each its path, a NUL and the 32 bytes of its
//   sha256, so path length + 33 bytes a source (dwarf_sources): `jet debug`
//   proves a source reads as the image's build read it, so its code is the
//   image's, before it binds to that code (JetDebug NativeFacts.jet).
//
// The other addresses (`.debug_addr`'s, the call sites', `.debug_line`'s and
// `.debug_jetline`'s) and the section offsets are relocations against
// section symbols, so any ELF linker can place the sections.
use jet_foundation.[CompilerThreads, compiler_threads_admit, compiler_threads_joined, compiler_threads_taken, compiler_threads_partition, compiler_threads_single]

ELF64_R_X86_64_32: 10

// x86-64 DWARF register numbers by hardware register number.
X64_DWARF_REGISTERS: [Int]{0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15}

x64_dwarf_register: fn(reg: Int) -> Int Never! {
    if reg >= 16 -> return reg + 1
    X64_DWARF_REGISTERS[reg]
}

// Object symbols the debug and unwind relocations name. With `functions`
// empty every function is in `.text`, whose symbol is `text`; otherwise
// function i is alone in the section whose symbol is functions[i].
X64DwarfSymbols: struct {
    text: Int,
    abbrev: Int,
    line: Int,
    loclists: Int,
    addr: Int,
    rnglists: Int,
    functions: [Int],
}

X64DwarfSections: struct {
    eh_frame: [U8],
    eh_relas: [X64ObjectRela],
    abbrev: [U8],
    // `.debug_info`, `.debug_loclists` and `.debug_rnglists` as the pieces
    // their threads built, in order and contiguous (x64_object_file writes
    // them into the file).
    info: [X64ObjectPiece],
    info_relas: [X64ObjectRela],
    line: [U8],
    line_relas: [X64ObjectRela],
    jet_line: [U8],
    jet_line_relas: [X64ObjectRela],
    loclists: [X64ObjectPiece],
    addr: [U8],
    addr_relas: [X64ObjectRela],
    rnglists: [X64ObjectPiece],
    // `.debug_jetsource` (dwarf_sources).
    sources: [U8]{[U8]{}},
}

// One section's bytes and their relocations.
DwarfSectionRows: struct {
    bytes: [U8],
    relas: [X64ObjectRela],
}

// ---------------------------------------------------------------------------
// Encoding.

dwarf_u8: fn(bytes: ^[U8], value: Int) Never! { bytes.push(U8{value & 255}) }

dwarf_uleb: fn(bytes: ^[U8], value: Int) Never! {
    rest := value
    loop {
        low: rest & 0x7f
        rest = rest >> 7
        if rest == 0 {
            bytes.push(U8{low})
            return
        }
        bytes.push(U8{low | 0x80})
    }
}

dwarf_sleb: fn(bytes: ^[U8], value: Int) Never! {
    rest := value
    loop {
        low: rest & 0x7f
        rest = rest >> 7
        if (rest == 0 && (low & 0x40) == 0) || (rest == -1 && (low & 0x40) != 0) {
            bytes.push(U8{low})
            return
        }
        bytes.push(U8{low | 0x80})
    }
}

dwarf_string: fn(bytes: ^[U8], text: String) Never! {
    bytes.extend(text.bytes())
    bytes.push(U8{0})
}

dwarf_patch_u32: fn(bytes: ^[U8], at: Int, value: Int) Never! {
    bytes[at] = U8{value & 255}
    bytes[at + 1] = U8{(value >> 8) & 255}
    bytes[at + 2] = U8{(value >> 16) & 255}
    bytes[at + 3] = U8{(value >> 24) & 255}
}

// The 4-byte length field at `at`: the bytes after it, to the end.
dwarf_patch_length: fn(bytes: ^[U8], at: Int) Never! {
    length: bytes.len() - at - 4
    dwarf_patch_u32(bytes, at, length)
}

// The bytes a uleb of `value` takes.
dwarf_uleb_size: fn(value: Int) -> Int Never! {
    size := 1
    rest := value >> 7
    loop rest != 0 {
        size += 1
        rest = rest >> 7
    }
    size
}

// `value` as a uleb of exactly `width` bytes at `at` (the high groups zero
// with their continuation bits set), so the bytes a later index takes are
// known before it is: a `.debug_info` part writes its list indexes before
// it knows how many lists the parts before it have (dwarf_info).
dwarf_patch_uleb: fn(bytes: ^[U8], at: Int, value: Int, width: Int) Never! {
    loop k in 0..<width {
        low: (value >> (7 * k)) & 0x7f
        bytes[at + k] = U8{if k + 1 < width -> low | 0x80 else -> low}
    }
}

// ---------------------------------------------------------------------------
// Call frame instructions (data alignment -8, code alignment 1).

dwarf_cfa_advance: fn(cfi: ^[U8], from: Int, to: Int) Never! {
    delta: to - from
    if delta <= 0 {
        return
    }
    if {
        delta < 64 -> dwarf_u8(cfi, (0x40) | delta)
        delta < 256 -> {
            dwarf_u8(cfi, 0x02)
            dwarf_u8(cfi, delta)
        }
        delta < 65536 -> {
            dwarf_u8(cfi, 0x03)
            elf64_u16(cfi, delta)
        }
        else -> {
            dwarf_u8(cfi, 0x04)
            elf64_u32(cfi, delta)
        }
    }
}

dwarf_cfa_def_cfa: fn(cfi: ^[U8], reg: Int, offset: Int) Never! {
    dwarf_u8(cfi, 0x0c)
    dwarf_uleb(cfi, reg)
    dwarf_uleb(cfi, offset)
}

dwarf_cfa_def_cfa_register: fn(cfi: ^[U8], reg: Int) Never! {
    dwarf_u8(cfi, 0x0d)
    dwarf_uleb(cfi, reg)
}

dwarf_cfa_def_cfa_offset: fn(cfi: ^[U8], offset: Int) Never! {
    dwarf_u8(cfi, 0x0e)
    dwarf_uleb(cfi, offset)
}

// `reg` is saved at CFA - 8 * `factored`.
dwarf_cfa_offset: fn(cfi: ^[U8], reg: Int, factored: Int) Never! {
    if {
        reg < 64 -> dwarf_u8(cfi, (0x80) | reg)
        else -> {
            dwarf_u8(cfi, 0x05)
            dwarf_uleb(cfi, reg)
        }
    }
    dwarf_uleb(cfi, factored)
}

// `reg` holds its caller's value (DW_CFA_same_value).
dwarf_cfa_same_value: fn(cfi: ^[U8], reg: Int) Never! {
    dwarf_u8(cfi, 0x08)
    dwarf_uleb(cfi, reg)
}

dwarf_cfa_remember_state: fn(cfi: ^[U8]) Never! { dwarf_u8(cfi, 0x0a) }

dwarf_cfa_restore_state: fn(cfi: ^[U8]) Never! { dwarf_u8(cfi, 0x0b) }

// Pad a CIE or FDE with DW_CFA_nop so the record (length field included)
// is a whole number of words.
dwarf_eh_finish: fn(eh: ^[U8], start: Int) Never! {
    loop _ in 0..<((8 - (eh.len() - start) % 8) % 8) -> eh.push(U8{0})
    dwarf_patch_length(eh, start)
}

dwarf_eh_frame: fn(debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    dwarf_eh_frame_threads(debug, offsets, sizes, symbols, compiler_threads_single())
}

DwarfEhChunk: struct {
    bytes: [U8],
    relas: [X64ObjectRela],
    patches: [Int],
}

dwarf_eh_chunk: fn(debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, start: Int, end: Int) -> DwarfEhChunk Never! {
    count: end - start
    eh := [U8]{}
    relas := [X64ObjectRela]{}
    patches := [Int]{}
    eh.try_reserve(count * 32) ?? ()
    relas.try_reserve(count) ?? ()
    patches.try_reserve(count) ?? ()
    loop index in start..<end {
        f_start: eh.len()
        elf64_u32(eh, 0)
        cie_pointer: eh.len()
        patches.push(cie_pointer)
        elf64_u32(eh, 0)
        relas.push(X64ObjectRela{at: eh.len(), symbol: dwarf_function_symbol(symbols, index), kind: ELF64_R_X86_64_PC32, addend: offsets[index]})
        elf64_u32(eh, 0)
        elf64_u32(eh, sizes[index])
        dwarf_uleb(eh, 0)
        eh.extend(debug[index].cfi)
        dwarf_eh_finish(eh, f_start)
    }
    DwarfEhChunk{bytes: eh.move(), relas: relas.move(), patches: patches.move()}
}

dwarf_eh_chunks: fn(debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, bounds: [Int], at: Int) -> [DwarfEhChunk] Never! {
    last: bounds.len() - 2
    if at > last -> return [DwarfEhChunk]{}
    if at == last {
        return [DwarfEhChunk]{dwarf_eh_chunk(debug, offsets, sizes, symbols, bounds[at], bounds[at + 1])}
    }
    done := [DwarfEhChunk]{}
    task.group dwarf_eh_threads {
        head: task dwarf_eh_chunk(debug, offsets, sizes, symbols, bounds[at], bounds[at + 1])
        rest: dwarf_eh_chunks(debug, offsets, sizes, symbols, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop item in rest.move() -> done.push(item)
    }
    done
}

dwarf_eh_frame_threads: fn(debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, threads: CompilerThreads) -> DwarfSectionRows Never! {
    eh := [U8]{}
    // CIE: version 1, augmentation "zR" (FDE addresses pcrel sdata4), code
    // alignment 1, data alignment -8, return address column 16 (rip).
    elf64_u32(eh, 0)
    elf64_u32(eh, 0)
    dwarf_u8(eh, 1)
    dwarf_string(eh, "zR")
    dwarf_uleb(eh, 1)
    dwarf_sleb(eh, -8)
    dwarf_u8(eh, 16)
    dwarf_uleb(eh, 1)
    dwarf_u8(eh, 0x1b)
    dwarf_cfa_def_cfa(eh, 7, 8)
    dwarf_cfa_offset(eh, 16, 1)
    dwarf_eh_finish(eh, 0)
    count: sizes.len()
    admitted: compiler_threads_admit(threads, count, count, 2048, 0, 0)
    workers: if admitted > 8 -> 8 else -> admitted
    if workers <= 1 {
        relas := [X64ObjectRela]{}
        relas.try_reserve(count) ?? ()
        eh.try_reserve(eh.len() + count * 32) ?? ()
        loop (index, size) in sizes {
            start: eh.len()
            elf64_u32(eh, 0)
            // CIE pointer: the distance back from this field to the CIE.
            cie_pointer: eh.len()
            elf64_u32(eh, cie_pointer)
            relas.push(X64ObjectRela{at: eh.len(), symbol: dwarf_function_symbol(symbols, index), kind: ELF64_R_X86_64_PC32, addend: offsets[index]})
            elf64_u32(eh, 0)
            elf64_u32(eh, size)
            dwarf_uleb(eh, 0)
            eh.extend(debug[index].cfi)
            dwarf_eh_finish(eh, start)
        }
        return DwarfSectionRows{bytes: eh.move(), relas: relas.move()}
    }
    bounds := [Int]{}
    loop p in 0..<workers -> bounds.push((count * p) /% workers)
    bounds.push(count)
    chunks := dwarf_eh_chunks(debug, offsets, sizes, symbols, bounds, 0)
    total_bytes := eh.len()
    total_relas := 0
    loop c in chunks {
        total_bytes += c.bytes.len()
        total_relas += c.relas.len()
    }
    eh.try_reserve(total_bytes) ?? ()
    relas := [X64ObjectRela]{}
    relas.try_reserve(total_relas) ?? ()
    loop chunk in chunks.move() {
        base: eh.len()
        eh.extend(chunk.bytes)
        loop p in chunk.patches {
            at: base + p
            dwarf_patch_u32(eh, at, at)
        }
        loop r in chunk.relas {
            relas.push(X64ObjectRela{at: base + r.at, symbol: r.symbol, kind: r.kind, addend: r.addend})
        }
    }
    DwarfSectionRows{bytes: eh.move(), relas: relas.move()}
}

// The symbol function `index`'s address relocations name: `.text`'s or its
// own section's.
dwarf_function_symbol: fn(symbols: X64DwarfSymbols, index: Int) -> Int Never! {
    if symbols.functions.len() == 0 -> return symbols.text
    symbols.functions[index]
}

// ---------------------------------------------------------------------------
// Abbreviations.

DWARF_ABBREV_UNIT: 1

DWARF_ABBREV_BASE: 2

DWARF_ABBREV_POINTER: 3

DWARF_ABBREV_VOID_POINTER: 4

DWARF_ABBREV_STRUCT: 5

DWARF_ABBREV_MEMBER: 6

DWARF_ABBREV_UNION: 7

DWARF_ABBREV_ENUM: 8

DWARF_ABBREV_ENUMERATOR: 9

DWARF_ABBREV_TYPEDEF: 10

DWARF_ABBREV_OPAQUE: 11

DWARF_ABBREV_SUBPROGRAM: 12

DWARF_ABBREV_GENERATED: 13

DWARF_ABBREV_PARAMETER: 14

DWARF_ABBREV_VARIABLE: 15

DWARF_ABBREV_PARAMETER_UNLOCATED: 16

DWARF_ABBREV_VARIABLE_UNLOCATED: 17

DWARF_ABBREV_ANONYMOUS_UNION: 18

DWARF_ABBREV_ABSTRACT: 19

DWARF_ABBREV_ABSTRACT_GENERATED: 20

DWARF_ABBREV_INLINED: 21

DWARF_ABBREV_VARIANT_PART: 22

DWARF_ABBREV_VARIANT: 23

DWARF_ABBREV_DEFAULT_VARIANT: 24

DWARF_ABBREV_CALL_SITE: 25

DWARF_ABBREV_GENERATED_SITES: 26

DWARF_ABBREV_CALL_ARGUMENTS: 27

DWARF_ABBREV_CALL_ARGUMENT: 28

// Attribute names and forms.
DW_AT_LOCATION: 0x02

DW_AT_NAME: 0x03

DW_AT_BYTE_SIZE: 0x0b

DW_AT_STMT_LIST: 0x10

DW_AT_LOW_PC: 0x11

DW_AT_HIGH_PC: 0x12

DW_AT_LANGUAGE: 0x13

DW_AT_DISCR: 0x15

DW_AT_DISCR_VALUE: 0x16

DW_AT_COMP_DIR: 0x1b

DW_AT_CONST_VALUE: 0x1c

DW_AT_INLINE: 0x20

DW_AT_PRODUCER: 0x25

DW_AT_ABSTRACT_ORIGIN: 0x31

DW_AT_ARTIFICIAL: 0x34

DW_AT_DATA_MEMBER_LOCATION: 0x38

DW_AT_DECL_FILE: 0x3a

DW_AT_DECL_LINE: 0x3b

DW_AT_DECLARATION: 0x3c

DW_AT_ENCODING: 0x3e

DW_AT_EXTERNAL: 0x3f

DW_AT_FRAME_BASE: 0x40

DW_AT_TYPE: 0x49

DW_AT_RANGES: 0x55

DW_AT_CALL_COLUMN: 0x57

DW_AT_CALL_FILE: 0x58

DW_AT_CALL_LINE: 0x59

DW_AT_ADDR_BASE: 0x73

DW_AT_RNGLISTS_BASE: 0x74

DW_AT_CALL_RETURN_PC: 0x7d

DW_AT_CALL_VALUE: 0x7e

DW_AT_LOCLISTS_BASE: 0x8c

DW_FORM_ADDR: 0x01

DW_FORM_DATA2: 0x05

DW_FORM_DATA8: 0x07

DW_FORM_STRING: 0x08

DW_FORM_DATA1: 0x0b

DW_FORM_SDATA: 0x0d

DW_FORM_UDATA: 0x0f

DW_FORM_REF4: 0x13

DW_FORM_SEC_OFFSET: 0x17

DW_FORM_EXPRLOC: 0x18

DW_FORM_FLAG_PRESENT: 0x19

DW_FORM_ADDRX: 0x1b

DW_FORM_LOCLISTX: 0x22

DW_FORM_RNGLISTX: 0x23

// One abbreviation: code, DIE tag, whether it has children, then
// (attribute, form) pairs.
dwarf_abbrev: fn(bytes: ^[U8], code: Int, die: Int, children: Bool, attributes: [Int]) Never! {
    dwarf_uleb(bytes, code)
    dwarf_uleb(bytes, die)
    dwarf_u8(bytes, if children -> 1 else -> 0)
    loop attribute in attributes -> dwarf_uleb(bytes, attribute)
    dwarf_uleb(bytes, 0)
    dwarf_uleb(bytes, 0)
}

// With `sections` (one section per function) the unit has no address range.
// With `sites` (a `--checked-alloc` image's X64FunctionDebug.allocs) a
// generated subprogram may hold call sites too. A subprogram's start is its
// `.debug_addr` index and its end its length; a variable's location list and
// an inlined run's range list are indexes into their offsets tables.
dwarf_abbrevs: fn(sections: Bool, sites: Bool) -> [U8] Never! {
    a := [U8]{}
    named_variable: [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_DECL_FILE, DW_FORM_UDATA, DW_AT_DECL_LINE, DW_FORM_UDATA, DW_AT_TYPE, DW_FORM_REF4}
    located := named_variable
    located.push(DW_AT_LOCATION)
    located.push(DW_FORM_LOCLISTX)
    unit := [Int]{DW_AT_PRODUCER, DW_FORM_STRING, DW_AT_LANGUAGE, DW_FORM_DATA2, DW_AT_NAME, DW_FORM_STRING, DW_AT_COMP_DIR, DW_FORM_STRING}
    if !sections -> unit.extend([Int]{DW_AT_LOW_PC, DW_FORM_ADDR, DW_AT_HIGH_PC, DW_FORM_DATA8})
    unit.extend([Int]{DW_AT_STMT_LIST, DW_FORM_SEC_OFFSET, DW_AT_ADDR_BASE, DW_FORM_SEC_OFFSET, DW_AT_LOCLISTS_BASE, DW_FORM_SEC_OFFSET, DW_AT_RNGLISTS_BASE, DW_FORM_SEC_OFFSET})
    dwarf_abbrev(a, DWARF_ABBREV_UNIT, 0x11, true, unit)
    dwarf_abbrev(a, DWARF_ABBREV_BASE, 0x24, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_ENCODING, DW_FORM_DATA1, DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_POINTER, 0x0f, false, [Int]{DW_AT_BYTE_SIZE, DW_FORM_DATA1, DW_AT_TYPE, DW_FORM_REF4})
    dwarf_abbrev(a, DWARF_ABBREV_VOID_POINTER, 0x0f, false, [Int]{DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_STRUCT, 0x13, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_MEMBER, 0x0d, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_TYPE, DW_FORM_REF4, DW_AT_DATA_MEMBER_LOCATION, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_UNION, 0x17, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_ENUM, 0x04, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_ENUMERATOR, 0x28, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_CONST_VALUE, DW_FORM_SDATA})
    dwarf_abbrev(a, DWARF_ABBREV_TYPEDEF, 0x16, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_TYPE, DW_FORM_REF4})
    dwarf_abbrev(a, DWARF_ABBREV_OPAQUE, 0x13, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_BYTE_SIZE, DW_FORM_UDATA, DW_AT_DECLARATION, DW_FORM_FLAG_PRESENT})
    dwarf_abbrev(
        a,
        DWARF_ABBREV_SUBPROGRAM,
        0x2e,
        true,
        [Int]{
            DW_AT_NAME,
            DW_FORM_STRING,
            DW_AT_DECL_FILE,
            DW_FORM_UDATA,
            DW_AT_DECL_LINE,
            DW_FORM_UDATA,
            DW_AT_LOW_PC,
            DW_FORM_ADDRX,
            DW_AT_HIGH_PC,
            DW_FORM_UDATA,
            DW_AT_FRAME_BASE,
            DW_FORM_EXPRLOC,
            DW_AT_EXTERNAL,
            DW_FORM_FLAG_PRESENT,
        },
    )
    dwarf_abbrev(
        a,
        DWARF_ABBREV_GENERATED,
        0x2e,
        false,
        [Int]{
            DW_AT_NAME,
            DW_FORM_STRING,
            DW_AT_LOW_PC,
            DW_FORM_ADDRX,
            DW_AT_HIGH_PC,
            DW_FORM_UDATA,
            DW_AT_FRAME_BASE,
            DW_FORM_EXPRLOC,
            DW_AT_ARTIFICIAL,
            DW_FORM_FLAG_PRESENT,
        },
    )
    dwarf_abbrev(a, DWARF_ABBREV_PARAMETER, 0x05, false, located)
    dwarf_abbrev(a, DWARF_ABBREV_VARIABLE, 0x34, false, located)
    dwarf_abbrev(a, DWARF_ABBREV_PARAMETER_UNLOCATED, 0x05, false, named_variable)
    dwarf_abbrev(a, DWARF_ABBREV_VARIABLE_UNLOCATED, 0x34, false, named_variable)
    dwarf_abbrev(a, DWARF_ABBREV_ANONYMOUS_UNION, 0x17, true, [Int]{DW_AT_BYTE_SIZE, DW_FORM_UDATA})
    // The abstract subprogram of a function inlined somewhere (DW_INL_inlined)
    // and one concrete inlined copy.
    dwarf_abbrev(a, DWARF_ABBREV_ABSTRACT, 0x2e, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_DECL_FILE, DW_FORM_UDATA, DW_AT_DECL_LINE, DW_FORM_UDATA, DW_AT_INLINE, DW_FORM_DATA1})
    dwarf_abbrev(a, DWARF_ABBREV_ABSTRACT_GENERATED, 0x2e, false, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_ARTIFICIAL, DW_FORM_FLAG_PRESENT, DW_AT_INLINE, DW_FORM_DATA1})
    dwarf_abbrev(
        a,
        DWARF_ABBREV_INLINED,
        0x1d,
        true,
        [Int]{
            DW_AT_ABSTRACT_ORIGIN,
            DW_FORM_REF4,
            DW_AT_RANGES,
            DW_FORM_RNGLISTX,
            DW_AT_CALL_FILE,
            DW_FORM_UDATA,
            DW_AT_CALL_LINE,
            DW_FORM_UDATA,
        },
    )
    // A variant part, selected by the discriminant member it names, and
    // its variants: one per discriminant value and the default.
    dwarf_abbrev(a, DWARF_ABBREV_VARIANT_PART, 0x33, true, [Int]{DW_AT_DISCR, DW_FORM_REF4})
    dwarf_abbrev(a, DWARF_ABBREV_VARIANT, 0x19, true, [Int]{DW_AT_DISCR_VALUE, DW_FORM_SDATA})
    dwarf_abbrev(a, DWARF_ABBREV_DEFAULT_VARIANT, 0x19, true, [Int]{})
    // A call its caller keeps arguments of: its return address, the line
    // and column of the source node that made it and, as its children,
    // each kept argument's register (DW_OP_reg*) and value there
    // (DW_AT_call_value).
    dwarf_abbrev(a, DWARF_ABBREV_CALL_ARGUMENTS, 0x48, true, [Int]{DW_AT_CALL_RETURN_PC, DW_FORM_ADDR, DW_AT_CALL_LINE, DW_FORM_UDATA, DW_AT_CALL_COLUMN, DW_FORM_UDATA})
    dwarf_abbrev(a, DWARF_ABBREV_CALL_ARGUMENT, 0x49, false, [Int]{DW_AT_LOCATION, DW_FORM_EXPRLOC, DW_AT_CALL_VALUE, DW_FORM_EXPRLOC})
    if sites {
        // An allocating call: its return address and the type of what its
        // block holds (DW_AT_type, beyond DWARF's call site attributes).
        dwarf_abbrev(a, DWARF_ABBREV_CALL_SITE, 0x48, false, [Int]{DW_AT_CALL_RETURN_PC, DW_FORM_ADDR, DW_AT_TYPE, DW_FORM_REF4})
        dwarf_abbrev(a, DWARF_ABBREV_GENERATED_SITES, 0x2e, true, [Int]{DW_AT_NAME, DW_FORM_STRING, DW_AT_LOW_PC, DW_FORM_ADDRX, DW_AT_HIGH_PC, DW_FORM_UDATA, DW_AT_FRAME_BASE, DW_FORM_EXPRLOC, DW_AT_ARTIFICIAL, DW_FORM_FLAG_PRESENT})
    }
    dwarf_uleb(a, 0)
    a
}

// ---------------------------------------------------------------------------
// Types.

dwarf_encoding: fn(encoding: X64DebugEncoding) -> Int Never! {
    if encoding == {
        .Signed -> 0x05
        .Unsigned -> 0x07
        .Float -> 0x04
        .Bool -> 0x02
        .Char -> 0x10
    }
}

// A ref4 to type `row`, patched once every type has its offset.
dwarf_type_ref: fn(info: ^[U8], refs: ^[Int], rows: ^[Int], row: Int) Never! {
    refs.push(info.len())
    rows.push(row)
    elf64_u32(info, 0)
}

dwarf_members: fn(info: ^[U8], refs: ^[Int], rows: ^[Int], members: [X64DebugMember]) Never! {
    loop member in members {
        if member.ty < 0 -> next
        dwarf_uleb(info, DWARF_ABBREV_MEMBER)
        dwarf_string(info, member.name)
        dwarf_type_ref(info, refs, rows, member.ty)
        dwarf_uleb(info, member.offset)
    }
    dwarf_uleb(info, 0)
}

// Every type DIE, in row order; returns each row's DIE offset.
dwarf_types: fn(info: ^[U8], types: [X64DebugType]) -> [Int] Never! {
    offsets := [Int]{}
    refs := [Int]{}
    rows := [Int]{}
    loop ty in types {
        offsets.push(info.len())
        if ty.kind == {
            .Base(encoding) -> {
                dwarf_uleb(info, DWARF_ABBREV_BASE)
                dwarf_string(info, ty.name)
                dwarf_u8(info, dwarf_encoding(encoding))
                dwarf_u8(info, ty.size)
            }
            .Pointer(target) -> {
                if {
                    target >= 0 -> {
                        dwarf_uleb(info, DWARF_ABBREV_POINTER)
                        dwarf_u8(info, 8)
                        dwarf_type_ref(info, refs, rows, target)
                    }
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_VOID_POINTER)
                        dwarf_u8(info, 8)
                    }
                }
            }
            .Struct(members) -> {
                dwarf_uleb(info, DWARF_ABBREV_STRUCT)
                dwarf_string(info, ty.name)
                dwarf_uleb(info, ty.size)
                dwarf_members(info, refs, rows, members)
            }
            .Union(members) -> {
                if {
                    ty.name == "" -> dwarf_uleb(info, DWARF_ABBREV_ANONYMOUS_UNION)
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_UNION)
                        dwarf_string(info, ty.name)
                    }
                }
                dwarf_uleb(info, ty.size)
                dwarf_members(info, refs, rows, members)
            }
            .Enum(enumerators) -> {
                dwarf_uleb(info, DWARF_ABBREV_ENUM)
                dwarf_string(info, ty.name)
                dwarf_u8(info, ty.size)
                loop enumerator in enumerators {
                    dwarf_uleb(info, DWARF_ABBREV_ENUMERATOR)
                    dwarf_string(info, enumerator.name)
                    dwarf_sleb(info, enumerator.value)
                }
                dwarf_uleb(info, 0)
            }
            .Variants(discriminant, variants) -> {
                dwarf_uleb(info, DWARF_ABBREV_STRUCT)
                dwarf_string(info, ty.name)
                dwarf_uleb(info, ty.size)
                // The discriminant member, then the variant part naming it
                // (the unit starts `info`, so its offset is unit-relative).
                selector: info.len()
                dwarf_uleb(info, DWARF_ABBREV_MEMBER)
                dwarf_string(info, discriminant.name)
                dwarf_type_ref(info, refs, rows, discriminant.ty)
                dwarf_uleb(info, discriminant.offset)
                dwarf_uleb(info, DWARF_ABBREV_VARIANT_PART)
                elf64_u32(info, selector)
                loop variant in variants {
                    if variant.value == {
                        .Val(value) -> {
                            dwarf_uleb(info, DWARF_ABBREV_VARIANT)
                            dwarf_sleb(info, value)
                        }
                        .None -> dwarf_uleb(info, DWARF_ABBREV_DEFAULT_VARIANT)
                    }
                    dwarf_members(info, refs, rows, [X64DebugMember]{variant.member})
                }
                dwarf_uleb(info, 0)
                dwarf_uleb(info, 0)
            }
            .Typedef(target) -> {
                if {
                    target >= 0 -> {
                        dwarf_uleb(info, DWARF_ABBREV_TYPEDEF)
                        dwarf_string(info, ty.name)
                        dwarf_type_ref(info, refs, rows, target)
                    }
                    else -> {
                        dwarf_uleb(info, DWARF_ABBREV_OPAQUE)
                        dwarf_string(info, ty.name)
                        dwarf_uleb(info, ty.size)
                    }
                }
            }
            .Opaque -> {
                dwarf_uleb(info, DWARF_ABBREV_OPAQUE)
                dwarf_string(info, ty.name)
                dwarf_uleb(info, ty.size)
            }
        }
    }
    loop (index, at) in refs -> dwarf_patch_u32(info, at, offsets[rows[index]])
    offsets
}

// ---------------------------------------------------------------------------
// Variable locations.

// The location of a variable carried at `location`: the value itself, or
// for an `indirect` variable the memory its value points at. The frame base
// is rbp. A FrameAddress value is rbp + offset itself: indirect, that is the
// memory at fbreg(offset); direct, the computed address (DW_OP_stack_value).
// A Constant is its value (DW_OP_consts), an EntryValue the value its
// register had at the function's entry (DW_OP_entry_value).
dwarf_location_into: fn(expr: ^[U8], location: X64DebugLocation, indirect: Bool) Never! {
    if location == {
        .Register(reg) -> {
            // DW_OP_reg0 + n / DW_OP_breg0 + n name registers below 32;
            // DW_OP_regx / DW_OP_bregx the rest (xmm15 is 32).
            number: x64_dwarf_register(reg)
            if {
                indirect && number < 32 -> {
                    dwarf_u8(expr, 0x70 + number)
                    dwarf_sleb(expr, 0)
                }
                indirect -> {
                    dwarf_u8(expr, 0x92)
                    dwarf_uleb(expr, number)
                    dwarf_sleb(expr, 0)
                }
                number < 32 -> dwarf_u8(expr, 0x50 + number)
                else -> {
                    dwarf_u8(expr, 0x90)
                    dwarf_uleb(expr, number)
                }
            }
        }
        .Frame(offset) -> {
            dwarf_u8(expr, 0x91)
            dwarf_sleb(expr, offset)
            if indirect -> dwarf_u8(expr, 0x06)
        }
        .FrameAddress(offset) -> {
            dwarf_u8(expr, 0x91)
            dwarf_sleb(expr, offset)
            if !indirect -> dwarf_u8(expr, 0x9f)
        }
        .Constant(value) -> {
            dwarf_u8(expr, 0x11)
            dwarf_sleb(expr, value)
            if !indirect -> dwarf_u8(expr, 0x9f)
        }
        .EntryValue(reg) -> {
            number: x64_dwarf_register(reg)
            dwarf_u8(expr, 0xa3)
            if number < 32 {
                dwarf_u8(expr, 1)
                dwarf_u8(expr, 0x50 + number)
            } else {
                start: expr.len()
                dwarf_u8(expr, 0)
                dwarf_u8(expr, 0x90)
                dwarf_uleb(expr, number)
                expr[start] = U8{expr.len() - start - 1}
            }
            if !indirect -> dwarf_u8(expr, 0x9f)
        }
    }
}

dwarf_location: fn(location: X64DebugLocation, indirect: Bool) -> [U8] Never! {
    expr := [U8]{}
    dwarf_location_into(expr, location, indirect)
    expr
}

// The ranges of each of a function's `count` variables, in binding order:
// one pass over the function's ranges instead of one per variable.
dwarf_variable_buckets: fn(ranges: [X64VariableRange], count: Int) -> [[X64VariableRange]] Never! {
    buckets := [[X64VariableRange]]{}
    loop _ in 0..<count -> buckets.push([X64VariableRange]{})
    loop range in ranges {
        if range.variable >= 0 && range.variable < count {
            buckets[range.variable].push(range.copy())
        }
    }
    buckets
}

// The ranges of one variable (its bucket, in binding order), by start, a
// stable order (equal starts keep their binding order); where two overlap
// the later binding wins (a new value of the variable is defined while the
// old one is still live).
dwarf_variable_ranges: fn(ranges: [X64VariableRange]) -> [X64VariableRange] Never! {
    order: dwarf_range_order(ranges)
    sorted := [X64VariableRange]{}
    loop index in order -> sorted.push(ranges[index])
    trimmed := [X64VariableRange]{}
    loop (index, range) in sorted {
        end := range.end
        if index + 1 < sorted.len() && sorted[index + 1].start < end {
            end = sorted[index + 1].start
        }
        if end > range.start {
            trimmed.push(X64VariableRange{variable: range.variable, start: range.start, end: end, location: range.location})
        }
    }
    trimmed
}

// The indexes of `ranges` by ascending start, a stable merge of the indexes
// (a right-run range moves before a left-run one only when its start is
// strictly lower), so the order is the insertion sort's.
dwarf_range_order: fn(ranges: [X64VariableRange]) -> [Int] Never! {
    count: ranges.len()
    order := [Int]{}
    loop index in 0..<count -> order.push(index)
    if count < 2 -> return order
    scratch := [Int]{}
    loop _ in 0..<count -> scratch.push(0)
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle := start + width
            if middle > count -> middle = count
            end := start + width + width
            if end > count -> end = count
            left := start
            right := middle
            out := start
            loop left < middle && right < end {
                if ranges[order[right]].start < ranges[order[left]].start {
                    scratch[out] = order[right]
                    right += 1
                } else {
                    scratch[out] = order[left]
                    left += 1
                }
                out += 1
            }
            loop left < middle {
                scratch[out] = order[left]
                left += 1
                out += 1
            }
            loop right < end {
                scratch[out] = order[right]
                right += 1
                out += 1
            }
            start = end
        }
        loop index in 0..<count -> order[index] = scratch[index]
        width += width
    }
    order
}

// ---------------------------------------------------------------------------
// Compile unit, line program and location lists.

dwarf_address: fn(bytes: ^[U8], relas: ^[X64ObjectRela], symbol: Int, addend: Int) Never! {
    relas.push(X64ObjectRela{at: bytes.len(), symbol: symbol, kind: ELF64_R_X86_64_64, addend: addend})
    elf64_u64(bytes, 0)
}

dwarf_section_offset: fn(bytes: ^[U8], relas: ^[X64ObjectRela], symbol: Int, addend: Int) Never! {
    relas.push(X64ObjectRela{at: bytes.len(), symbol: symbol, kind: ELF64_R_X86_64_32, addend: addend})
    elf64_u32(bytes, 0)
}

// The source facts of compiled function `function` (`main` has none).
dwarf_function_debug: fn(program: X64ObjectModule, function: X64CompiledFunction) -> X64FunctionSource Never! {
    id: function.id.value
    if id < 0 || id >= program.functions.len() -> return x64_function_source_none()
    program.functions[id]
}

// The compile unit of `.debug_info` and the `.debug_addr`, `.debug_loclists`
// and `.debug_rnglists` it refers to: the unit header, the types and the
// address table on the calling thread, then one subprogram per function
// (dwarf_info_function), in function order. The subprograms are built in
// consecutive function parts, one per thread `threads` admits (weighted by
// the functions' variables, ranges and inline runs; one part on the calling
// thread when it admits one): each part's bytes, relocations, references
// to its own DIEs and list indexes are relative to the part's own start and
// lists. Each part's bytes become a piece of its section as they are, in
// function order, after the unit's header (X64DwarfSections) and the lists'
// offsets tables; each relocation's offset and each such reference (its
// place and value) shift by the info bytes before its part, and each list
// index by the lists before it, so the sections are the same for any
// thread count.
dwarf_info: fn(sections: ^X64DwarfSections, program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], text_size: Int, symbols: X64DwarfSymbols, threads: CompilerThreads) Never! {
    info := [U8]{}
    relas := [X64ObjectRela]{}
    elf64_u32(info, 0)
    elf64_u16(info, 5)
    // DW_UT_compile, 8-byte addresses, the abbreviation table.
    dwarf_u8(info, 1)
    dwarf_u8(info, 8)
    dwarf_section_offset(info, relas, symbols.abbrev, 0)
    paths: program.debug.files
    dwarf_uleb(info, DWARF_ABBREV_UNIT)
    // The producer names the optimization level, which a debugger compiles
    // its expressions at (JetDebug NativeFacts.jet native_producer_level).
    dwarf_string(info, "Jet native backend (O{program.debug.level})")
    // DW_LANG_C11: the closest registered language whose expression syntax
    // (`p.x`, `*p`, `p->x`) reads Jet values.
    elf64_u16(info, 0x1d)
    dwarf_string(info, if paths.len() > 0 -> paths[0] else -> "<generated>")
    dwarf_string(info, if program.debug.directory == "" -> "." else -> program.debug.directory)
    if symbols.functions.len() == 0 {
        dwarf_address(info, relas, symbols.text, 0)
        elf64_u64(info, text_size)
    }
    dwarf_section_offset(info, relas, symbols.line, 0)
    // The bases: the address table and the lists' offsets tables, past
    // their sections' headers.
    dwarf_section_offset(info, relas, symbols.addr, DWARF_ADDR_HEADER)
    dwarf_section_offset(info, relas, symbols.loclists, DWARF_LISTS_HEADER)
    dwarf_section_offset(info, relas, symbols.rnglists, DWARF_LISTS_HEADER)
    type_offsets: dwarf_types(info, program.debug.types)

    // The address table: version 5, 8-byte addresses, no segment selector,
    // then function i's start at index i.
    addr := [U8]{}
    addr.try_reserve(DWARF_ADDR_HEADER + 8 * functions.len()) ?? ()
    addr_relas := [X64ObjectRela]{}
    addr_relas.try_reserve(functions.len()) ?? ()
    elf64_u32(addr, 0)
    elf64_u16(addr, 5)
    dwarf_u8(addr, 8)
    dwarf_u8(addr, 0)
    loop index in 0..<functions.len() {
        dwarf_address(addr, addr_relas, dwarf_function_symbol(symbols, index), offsets[index])
    }
    dwarf_patch_length(addr, 0)
    sections.addr = addr.move()
    sections.addr_relas = addr_relas.move()

    weights := [Int]{}
    weights.try_reserve(functions.len()) ?? ()
    total := 0
    variables := 0
    runs := 0
    loop (index, function) in functions {
        named: dwarf_function_debug(program, function).variables.len()
        weight: 1 + named + debug[index].ranges.len() + debug[index].inlines.len() + debug[index].allocs.len() + debug[index].calls.len()
        weights.push(weight)
        total += weight
        variables += named
        runs += debug[index].inlines.len()
    }
    // A variable has at most one location list and an inline run one range
    // list, so indexes this wide hold every list's.
    widths: DwarfListWidths{lists: dwarf_uleb_size(variables), ranges: dwarf_uleb_size(runs)}
    taken := [DwarfInfoRows]{}
    workers: compiler_threads_admit(threads, functions.len(), total, DWARF_INFO_MIN_WEIGHT_PER_THREAD, 0, 0)
    if workers <= 1 {
        taken.push(dwarf_info_rows(program, functions, debug, offsets, sizes, type_offsets, symbols, widths, 0, functions.len()))
    } else {
        bounds: compiler_threads_partition(weights, workers)
        inputs: Shared{DwarfInfoShared{program: program, functions: functions, debug: debug, offsets: offsets, sizes: sizes, type_offsets: type_offsets, symbols: symbols, widths: widths}}
        parts: loop part in 0..<(bounds.len() - 1) -> Shared{DwarfInfoPart{start: bounds[part], end: bounds[part + 1], outputs: [DwarfInfoRows]{}}}
        _ := dwarf_info_parts(inputs, parts, 0) ?? panic("the DWARF info threads failed")
        loop part in parts -> taken.push(dwarf_info_part_take(part))
    }
    // The unit's length counts every part and its closing null entry; an
    // offsets table entry counts from the table's start, past the table.
    info_size := info.len() + 1
    list_count := 0
    range_count := 0
    total_relas := relas.len()
    loop rows in taken {
        info_size += rows.info.len()
        list_count += rows.lists.offsets.len()
        range_count += rows.ranges.offsets.len()
        total_relas += rows.relas.len()
    }
    dwarf_patch_u32(info, 0, info_size - 4)
    lists := dwarf_lists_header(list_count)
    lists.try_reserve(DWARF_LISTS_HEADER + 4 * list_count) ?? ()
    ranges := dwarf_lists_header(range_count)
    ranges.try_reserve(DWARF_LISTS_HEADER + 4 * range_count) ?? ()
    list_end := 4 * list_count
    range_end := 4 * range_count
    loop rows in taken {
        loop offset in rows.lists.offsets -> elf64_u32(lists, list_end + offset)
        loop offset in rows.ranges.offsets -> elf64_u32(ranges, range_end + offset)
        list_end += rows.lists.bytes.len()
        range_end += rows.ranges.bytes.len()
    }
    dwarf_patch_u32(lists, 0, DWARF_LISTS_HEADER - 4 + list_end)
    dwarf_patch_u32(ranges, 0, DWARF_LISTS_HEADER - 4 + range_end)
    // Each part's bytes become a piece of its section as they are; its
    // relocations, references and list indexes shift by what is before it.
    info_base := info.len()
    list_base := lists.len()
    range_base := ranges.len()
    list_index := 0
    range_index := 0
    info_pieces := [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: info.move()}}
    list_pieces := [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: lists.move()}}
    range_pieces := [X64ObjectPiece]{X64ObjectPiece{at: 0, bytes: ranges.move()}}
    patch_jobs := [DwarfInfoPatch]{}
    taken.reverse()
    loop taken.len() > 0 {
        rows := taken.pop() ?? break
        info_at: info_base
        list_at: list_base
        range_at: range_base
        l_idx: list_index
        r_idx: range_index
        info_base += rows.info.len()
        list_base += rows.lists.bytes.len()
        range_base += rows.ranges.bytes.len()
        list_index += rows.lists.offsets.len()
        range_index += rows.ranges.offsets.len()
        patch_jobs.push(DwarfInfoPatch{rows: rows.move(), info_at: info_at, list_at: list_at, range_at: range_at, list_index: l_idx, range_index: r_idx, widths: widths})
    }
    patched := if patch_jobs.len() > 1 -> {
        patch_jobs.reverse()
        dwarf_info_patch_parts(patch_jobs)
    } else -> {
        out_p := [DwarfInfoPatched]{}
        loop patch_jobs.len() > 0 {
            job := patch_jobs.pop() ?? break
            out_p.push(dwarf_info_patch_one(job))
        }
        out_p
    }
    relas.try_reserve(total_relas) ?? ()
    patched.reverse()
    loop patched.len() > 0 {
        item := patched.pop() ?? break
        relas.extend(item.relas.move())
        info_pieces.push(X64ObjectPiece{at: item.info_at, bytes: item.info.move()})
        list_pieces.push(X64ObjectPiece{at: item.list_at, bytes: item.lists.move()})
        range_pieces.push(X64ObjectPiece{at: item.range_at, bytes: item.ranges.move()})
    }
    info_pieces.push(X64ObjectPiece{at: info_base, bytes: [U8]{U8{0}}})
    sections.info = info_pieces.move()
    sections.info_relas = relas.move()
    sections.loclists = list_pieces.move()
    sections.rnglists = range_pieces.move()
}

DwarfInfoPatch: struct {
    rows: DwarfInfoRows,
    info_at: Int,
    list_at: Int,
    range_at: Int,
    list_index: Int,
    range_index: Int,
    widths: DwarfListWidths,
}

DwarfInfoPatched: struct {
    info: [U8],
    lists: [U8],
    ranges: [U8],
    relas: [X64ObjectRela],
    info_at: Int,
    list_at: Int,
    range_at: Int,
}

dwarf_info_patch_one: fn(job: ^^DwarfInfoPatch) -> DwarfInfoPatched Never! {
    item := job.move()
    rows := item.rows.move()
    info_at: item.info_at
    loop pair in 0..<(rows.refs.len() >> 1) {
        dwarf_patch_u32(rows.info, rows.refs[2 * pair], info_at + rows.refs[2 * pair + 1])
    }
    dwarf_lists_index(rows.info, rows.lists.refs, item.list_index, item.widths.lists)
    dwarf_lists_index(rows.info, rows.ranges.refs, item.range_index, item.widths.ranges)
    loop k in 0..<rows.relas.len() -> rows.relas[k].at = rows.relas[k].at + info_at
    DwarfInfoPatched{info: rows.info.move(), lists: rows.lists.bytes.move(), ranges: rows.ranges.bytes.move(), relas: rows.relas.move(), info_at: info_at, list_at: item.list_at, range_at: item.range_at}
}

dwarf_info_patch_parts: fn(jobs: ^[DwarfInfoPatch]) -> [DwarfInfoPatched] Never! {
    if jobs.len() == 0 -> return [DwarfInfoPatched]{}
    head := jobs.pop() ?? return [DwarfInfoPatched]{}
    if jobs.len() == 0 -> return [DwarfInfoPatched]{dwarf_info_patch_one(head)}
    out := [DwarfInfoPatched]{}
    task.group dwarf_info_patch_group {
        done_head: task ^^head { dwarf_info_patch_one(head) }
        rest: dwarf_info_patch_parts(jobs)
        out.push(compiler_threads_joined(done_head))
        loop item in rest.move() -> out.push(item)
    }
    out
}

// The bytes before `.debug_addr`'s first address: the unit length, the
// version, the address size and the segment selector size.
DWARF_ADDR_HEADER: 8

// The bytes before a `.debug_loclists` or `.debug_rnglists` offsets table:
// those and the table's entry count.
DWARF_LISTS_HEADER: 12

// A lists section's header (version 5, 8-byte addresses, no segment
// selector) with `count` offsets to follow; dwarf_info patches its length.
dwarf_lists_header: fn(count: Int) -> [U8] Never! {
    bytes := [U8]{}
    elf64_u32(bytes, 0)
    elf64_u16(bytes, 5)
    dwarf_u8(bytes, 8)
    dwarf_u8(bytes, 0)
    elf64_u32(bytes, count)
    bytes
}

// Move a part's list indexes in its `info` (DwarfLists `refs` pairs) past
// the `before` lists of the parts before it.
dwarf_lists_index: fn(info: ^[U8], refs: [Int], before: Int, width: Int) Never! {
    loop pair in 0..<(refs.len() >> 1) {
        dwarf_patch_uleb(info, refs[2 * pair], before + refs[2 * pair + 1], width)
    }
}

// Fewest weight units (a function, each of its variables, each of its
// ranges, each of its inline runs and each of its allocating calls count
// one) a subprogram thread is admitted for: a few hundred DIEs outweigh a
// thread's start.
DWARF_INFO_MIN_WEIGHT_PER_THREAD: 400

// The bytes of a location list's index (DW_FORM_loclistx) and of a range
// list's (DW_FORM_rnglistx), the same for the whole unit (dwarf_patch_uleb).
DwarfListWidths: struct {
    lists: Int,
    ranges: Int,
}

// The threads' inputs for the subprograms: shared handles of the module,
// the compiled functions, their debug rows, offsets and sizes, the type DIE
// offsets, the section symbols and the list index widths; read only.
DwarfInfoShared: struct {
    program: X64ObjectModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
    offsets: [Int],
    sizes: [Int],
    type_offsets: [Int],
    symbols: X64DwarfSymbols,
    widths: DwarfListWidths,
}

// One thread's consecutive function range and its rows (`outputs` holds
// one row once the thread finished).
DwarfInfoPart: struct {
    start: Int,
    end: Int,
    outputs: [DwarfInfoRows],
}

// One part's location or range lists: their bytes, each list's offset in
// them (a list's number in the part is its place here), and per index the
// part's `.debug_info` names a list by, a pair: the index's place in the
// part's info bytes and the list's number.
DwarfLists: struct {
    bytes: [U8],
    offsets: [Int],
    refs: [Int],
}

// The subprograms of one part: its `.debug_info` bytes, their relocations
// (`at` relative to the part's first byte), the references to its own DIEs
// (dwarf_info_function `refs`, relative to the part's first byte) and its
// location and range lists.
DwarfInfoRows: struct {
    info: [U8],
    relas: [X64ObjectRela],
    refs: [Int],
    lists: DwarfLists,
    ranges: DwarfLists,
}

// Builds `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts were built.
dwarf_info_parts: fn(inputs: Shared<DwarfInfoShared>, parts: [Shared<DwarfInfoPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return dwarf_info_part(inputs, parts[from])
    built := 0
    task.group dwarf_info_threads {
        head: task dwarf_info_part(inputs, parts[from])
        built = dwarf_info_parts(inputs, parts, from + 1)
        built += compiler_threads_joined(head)
    }
    built
}

// One thread: the subprograms of its function range, in function order.
dwarf_info_part: fn(inputs: Shared<DwarfInfoShared>, part: Shared<DwarfInfoPart>) -> Int {
    permit := part.guard_edit()
    reads: inputs.guard_read()
    built: dwarf_info_rows(reads.value.program, reads.value.functions, reads.value.debug, reads.value.offsets, reads.value.sizes, reads.value.type_offsets, reads.value.symbols, reads.value.widths, permit.value.start, permit.value.end)
    permit.value.outputs.push(built)
    1
}

// The subprograms of functions [start, end), in function order.
dwarf_info_rows: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], type_offsets: [Int], symbols: X64DwarfSymbols, widths: DwarfListWidths, start: Int, end: Int) -> DwarfInfoRows Never! {
    info := [U8]{}
    relas := [X64ObjectRela]{}
    refs := [Int]{}
    lists := DwarfLists{bytes: [U8]{}, offsets: [Int]{}, refs: [Int]{}}
    ranges := DwarfLists{bytes: [U8]{}, offsets: [Int]{}, refs: [Int]{}}
    loop index in start..<end {
        dwarf_info_function(info, relas, refs, lists, ranges, program, functions[index], debug[index], index, offsets[index], sizes[index], dwarf_function_symbol(symbols, index), type_offsets, widths)
    }
    DwarfInfoRows{info: info.move(), relas: relas.move(), refs: refs.move(), lists: lists.move(), ranges: ranges.move()}
}

// A part's rows, after its thread joined.
dwarf_info_part_take: fn(part: Shared<DwarfInfoPart>) -> DwarfInfoRows {
    permit: part.guard_edit()
    compiler_threads_taken(permit.value.outputs)
}

// One function's subprogram DIE in `info`: its start is `.debug_addr` index
// `slot` (dwarf_info), `offset` from `symbol` in its section, and it is
// `size` bytes. Per located variable its location list goes to `lists`,
// from that start (DW_LLE_base_addressx, then DW_LLE_offset_pair per
// range), and the variable's DIE names it by index (dwarf_list_ref).
//
// A function with inlined code (X64FunctionSource.inlines) first gets, at
// the unit's level, one abstract subprogram per function inlined into it.
// Inside its subprogram each run of inlined code (X64FunctionDebug.inlines)
// is an inlined subroutine of that origin whose range list in `ranges` is
// the run, nested as the sites are, with the variables of its site; a
// variable of a site left with no code goes to the nearest enclosing site
// with code. Each reference to an abstract subprogram is a pair in `refs`:
// the place of its ref4 in `info` and the DIE's offset, both from `info`'s
// start. Only the call sites' return addresses take relocations.
dwarf_info_function: fn(info: ^[U8], relas: ^[X64ObjectRela], refs: ^[Int], lists: ^DwarfLists, ranges: ^DwarfLists, program: X64ObjectModule, function: X64CompiledFunction, debug: X64FunctionDebug, slot: Int, offset: Int, size: Int, symbol: Int, type_offsets: [Int], widths: DwarfListWidths) Never! {
    facts: dwarf_function_debug(program, function)
    if facts.file < 0 {
        sited: debug.allocs.len() > 0
        dwarf_uleb(info, if sited -> DWARF_ABBREV_GENERATED_SITES else -> DWARF_ABBREV_GENERATED)
        dwarf_string(info, function.name)
        dwarf_uleb(info, slot)
        dwarf_uleb(info, size)
        // Frame base: DW_OP_reg6 (rbp).
        dwarf_uleb(info, 1)
        dwarf_u8(info, 0x56)
        if sited {
            dwarf_info_alloc_sites(info, relas, debug.allocs, offset, symbol, type_offsets)
            dwarf_uleb(info, 0)
        }
        return
    }
    origins: dwarf_inline_origins(info, facts.inlines)
    dwarf_uleb(info, DWARF_ABBREV_SUBPROGRAM)
    dwarf_string(info, facts.name)
    dwarf_uleb(info, facts.file + 1)
    dwarf_uleb(info, facts.line)
    dwarf_uleb(info, slot)
    dwarf_uleb(info, size)
    dwarf_uleb(info, 1)
    dwarf_u8(info, 0x56)
    // The location lists first, in variable order: a variable of a site
    // with several runs is in each run's DIE, all naming its one list.
    buckets: dwarf_variable_buckets(debug.ranges, facts.variables.len())
    places := [Int]{}
    loop (variable, row) in facts.variables {
        covered: dwarf_variable_ranges(buckets[variable])
        if covered.len() == 0 {
            places.push(-1)
            next
        }
        places.push(lists.offsets.len())
        lists.offsets.push(lists.bytes.len())
        // DW_LLE_base_addressx: the function's start.
        dwarf_u8(lists.bytes, 0x01)
        dwarf_uleb(lists.bytes, slot)
        loop range in covered {
            // DW_LLE_offset_pair from it.
            dwarf_u8(lists.bytes, 0x04)
            dwarf_uleb(lists.bytes, range.start)
            dwarf_uleb(lists.bytes, range.end)
            len_at: lists.bytes.len()
            dwarf_u8(lists.bytes, 0)
            dwarf_location_into(lists.bytes, range.location, row.indirect)
            lists.bytes[len_at] = U8{lists.bytes.len() - len_at - 1}
        }
        dwarf_u8(lists.bytes, 0)
    }
    // Per site, the variables it holds (site 0: the subprogram).
    count: facts.inlines.len()
    coded := [Bool]{false}
    loop _ in 0..<count -> coded.push(false)
    loop run in debug.inlines {
        if run.site > 0 && run.site <= count -> coded[run.site] = true
    }
    homes := [Int]{0}
    held := [[Int]]{[Int]{}}
    loop site in 1..<(count + 1) {
        parent: facts.inlines[site - 1].parent
        home: if {
            coded[site] -> site
            parent > 0 && parent < site -> homes[parent]
            else -> 0
        }
        homes.push(home)
        held.push([Int]{})
    }
    loop (variable, row) in facts.variables {
        home: if row.site > 0 && row.site <= count -> homes[row.site] else -> 0
        held[home].push(variable)
    }
    loop variable in held[0] {
        dwarf_info_variable(info, lists, facts.variables[variable], facts.file, places[variable], type_offsets, widths.lists)
    }
    // The runs, each inside the open run that contains it.
    ends := [Int]{}
    loop run in debug.inlines {
        if run.site <= 0 || run.site > count -> next
        loop ends.len() > 0 && run.start >= ends[ends.len() - 1] {
            _ := ends.pop()
            dwarf_uleb(info, 0)
        }
        site: facts.inlines[run.site - 1]
        dwarf_uleb(info, DWARF_ABBREV_INLINED)
        refs.push(info.len())
        refs.push(origins[run.site - 1])
        elf64_u32(info, origins[run.site - 1])
        // DW_RLE_base_addressx, the function's start, then DW_RLE_offset_pair.
        dwarf_list_ref(info, ranges, ranges.offsets.len(), widths.ranges)
        ranges.offsets.push(ranges.bytes.len())
        dwarf_u8(ranges.bytes, 0x01)
        dwarf_uleb(ranges.bytes, slot)
        dwarf_u8(ranges.bytes, 0x04)
        dwarf_uleb(ranges.bytes, run.start)
        dwarf_uleb(ranges.bytes, run.end)
        dwarf_u8(ranges.bytes, 0)
        caller_file: if site.parent > 0 && site.parent <= count -> facts.inlines[site.parent - 1].file else -> facts.file
        dwarf_uleb(info, if caller_file >= 0 -> caller_file + 1 else -> 0)
        dwarf_uleb(info, if site.call_line > 0 -> site.call_line else -> 0)
        file: if site.file >= 0 -> site.file else -> facts.file
        loop variable in held[run.site] {
            dwarf_info_variable(info, lists, facts.variables[variable], file, places[variable], type_offsets, widths.lists)
        }
        ends.push(run.end)
    }
    loop _ in ends -> dwarf_uleb(info, 0)
    dwarf_info_alloc_sites(info, relas, debug.allocs, offset, symbol, type_offsets)
    dwarf_info_call_sites(info, relas, debug.calls, offset, symbol)
    dwarf_uleb(info, 0)
}

// A call site DIE per allocating call `sites` (X64AllocSite) of the
// function at `offset` from `symbol`.
dwarf_info_alloc_sites: fn(info: ^[U8], relas: ^[X64ObjectRela], sites: [X64AllocSite], offset: Int, symbol: Int, type_offsets: [Int]) Never! {
    loop site in sites {
        dwarf_uleb(info, DWARF_ABBREV_CALL_SITE)
        dwarf_address(info, relas, symbol, offset + site.at)
        elf64_u32(info, type_offsets[site.ty])
    }
}

// A call site DIE per call `sites` (X64CallSite) of the function at `offset`
// from `symbol`, holding a call site parameter DIE per argument its caller
// keeps: the argument's register and, as an expression its value
// (DW_AT_call_value), where the caller keeps it (dwarf_location of an
// indirect place: the address it computes is the value).
dwarf_info_call_sites: fn(info: ^[U8], relas: ^[X64ObjectRela], sites: [X64CallSite], offset: Int, symbol: Int) Never! {
    loop i in 0..<sites.len() {
        dwarf_uleb(info, DWARF_ABBREV_CALL_ARGUMENTS)
        dwarf_address(info, relas, symbol, offset + sites[i].at)
        dwarf_uleb(info, sites[i].line)
        dwarf_uleb(info, sites[i].column)
        loop j in 0..<sites[i].arguments.len() {
            dwarf_uleb(info, DWARF_ABBREV_CALL_ARGUMENT)
            number: x64_dwarf_register(sites[i].arguments[j].reg)
            if number < 32 {
                dwarf_u8(info, 1)
                dwarf_u8(info, 0x50 + number)
            } else {
                reg_len_at: info.len()
                dwarf_u8(info, 0)
                dwarf_u8(info, 0x90)
                dwarf_uleb(info, number)
                info[reg_len_at] = U8{info.len() - reg_len_at - 1}
            }
            val_len_at: info.len()
            dwarf_u8(info, 0)
            dwarf_location_into(info, sites[i].arguments[j].value, true)
            info[val_len_at] = U8{info.len() - val_len_at - 1}
        }
        dwarf_uleb(info, 0)
    }
}

// The abstract subprograms (DW_INL_inlined) of the functions inlined at
// `sites`, one per function; per site, its function's DIE offset in `info`.
dwarf_inline_origins: fn(info: ^[U8], sites: [X64InlineSite]) -> [Int] Never! {
    origins := [Int]{}
    if sites.len() == 0 -> return origins
    firsts := [Int:Int]{}
    loop (index, site) in sites {
        if site.function >= 0 {
            if firsts.get(site.function) == .Val(first) {
                origins.push(origins[first])
                next
            }
            firsts.add(site.function, index).drop("checked absent above")
        }
        origins.push(info.len())
        dwarf_uleb(info, if site.file < 0 -> DWARF_ABBREV_ABSTRACT_GENERATED else -> DWARF_ABBREV_ABSTRACT)
        dwarf_string(info, site.name)
        if site.file >= 0 {
            dwarf_uleb(info, site.file + 1)
            dwarf_uleb(info, site.line)
        }
        // DW_INL_inlined.
        dwarf_u8(info, 1)
    }
    origins
}

// A variable's DIE, declared in `file`; `place` is its location list's
// number in the part's `lists`, -1 for none.
dwarf_info_variable: fn(info: ^[U8], lists: ^DwarfLists, row: X64DebugVariable, file: Int, place: Int, type_offsets: [Int], width: Int) Never! {
    located: place >= 0
    abbrev: if {
        row.parameter && located -> DWARF_ABBREV_PARAMETER
        row.parameter -> DWARF_ABBREV_PARAMETER_UNLOCATED
        located -> DWARF_ABBREV_VARIABLE
        else -> DWARF_ABBREV_VARIABLE_UNLOCATED
    }
    dwarf_uleb(info, abbrev)
    dwarf_string(info, row.name)
    dwarf_uleb(info, file + 1)
    dwarf_uleb(info, row.line)
    elf64_u32(info, type_offsets[row.ty])
    if located -> dwarf_list_ref(info, lists, place, width)
}

// A list's index (DW_FORM_loclistx, DW_FORM_rnglistx) in `info`: list
// `number` of the part's `lists`, `width` bytes, which dwarf_info moves
// past the lists of the parts before.
dwarf_list_ref: fn(info: ^[U8], lists: ^DwarfLists, number: Int, width: Int) Never! {
    lists.refs.push(info.len())
    lists.refs.push(number)
    at: info.len()
    loop _ in 0..<width -> info.push(U8{0})
    dwarf_patch_uleb(info, at, number, width)
}

dwarf_line: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    dwarf_line_threads(program, functions, debug, offsets, sizes, symbols, compiler_threads_single())
}

dwarf_line_range: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, start: Int, end: Int) -> DwarfSectionRows Never! {
    line := [U8]{}
    relas := [X64ObjectRela]{}
    relas.try_reserve(end - start) ?? ()
    loop index in start..<end {
        facts: dwarf_function_debug(program, functions[index])
        rows: debug[index].lines
        if facts.file < 0 || rows.len() == 0 -> next
        // DW_LNE_set_address.
        dwarf_u8(line, 0)
        dwarf_uleb(line, 9)
        dwarf_u8(line, 2)
        dwarf_address(line, relas, dwarf_function_symbol(symbols, index), offsets[index])
        if facts.file != 0 {
            dwarf_u8(line, 0x04)
            dwarf_uleb(line, facts.file + 1)
        }
        current_line := 1
        current_at := 0
        loop row in rows {
            if row.call -> next
            if row.line != current_line {
                dwarf_u8(line, 0x03)
                dwarf_sleb(line, row.line - current_line)
                current_line = row.line
            }
            if row.at != current_at {
                dwarf_u8(line, 0x02)
                dwarf_uleb(line, row.at - current_at)
                current_at = row.at
            }
            if row.at == debug[index].body -> dwarf_u8(line, 0x0a)
            dwarf_u8(line, 0x01)
        }
        if sizes[index] > current_at {
            dwarf_u8(line, 0x02)
            dwarf_uleb(line, sizes[index] - current_at)
        }
        // DW_LNE_end_sequence.
        dwarf_u8(line, 0)
        dwarf_uleb(line, 1)
        dwarf_u8(line, 1)
    }
    DwarfSectionRows{bytes: line.move(), relas: relas.move()}
}

dwarf_line_chunks: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, bounds: [Int], at: Int) -> [DwarfSectionRows] Never! {
    last: bounds.len() - 2
    if at > last -> return [DwarfSectionRows]{}
    if at == last {
        return [DwarfSectionRows]{dwarf_line_range(program, functions, debug, offsets, sizes, symbols, bounds[at], bounds[at + 1])}
    }
    done := [DwarfSectionRows]{}
    task.group dwarf_line_parts {
        head: task dwarf_line_range(program, functions, debug, offsets, sizes, symbols, bounds[at], bounds[at + 1])
        rest: dwarf_line_chunks(program, functions, debug, offsets, sizes, symbols, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop item in rest.move() -> done.push(item)
    }
    done
}

dwarf_line_threads: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, threads: CompilerThreads) -> DwarfSectionRows Never! {
    line := [U8]{}
    relas := [X64ObjectRela]{}
    elf64_u32(line, 0)
    elf64_u16(line, 5)
    dwarf_u8(line, 8)
    dwarf_u8(line, 0)
    header_length_at: line.len()
    elf64_u32(line, 0)
    // Minimum instruction length 1, one operation per instruction, rows are
    // statements, line_base -5, line_range 14, opcode_base 13.
    loop byte in ([Int]{1, 1, 1, 0xfb, 14, 13}) -> dwarf_u8(line, byte)
    loop byte in ([Int]{0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1}) -> dwarf_u8(line, byte)
    // Directories: (path, string); the compilation directory only.
    dwarf_u8(line, 1)
    dwarf_uleb(line, 1)
    dwarf_uleb(line, DW_FORM_STRING)
    dwarf_uleb(line, 1)
    dwarf_string(line, if program.debug.directory == "" -> "." else -> program.debug.directory)
    // Files: (path, string), (directory index, udata). File 0 is the
    // primary source file; file i + 1 is X64ModuleDebug.files[i].
    paths: program.debug.files
    dwarf_u8(line, 2)
    dwarf_uleb(line, 1)
    dwarf_uleb(line, DW_FORM_STRING)
    dwarf_uleb(line, 2)
    dwarf_uleb(line, DW_FORM_UDATA)
    dwarf_uleb(line, paths.len() + 1)
    dwarf_string(line, if paths.len() > 0 -> paths[0] else -> "<generated>")
    dwarf_uleb(line, 0)
    loop path in paths {
        dwarf_string(line, path)
        dwarf_uleb(line, 0)
    }
    dwarf_patch_length(line, header_length_at)

    count: functions.len()
    weights := [Int]{}
    weights.try_reserve(count) ?? ()
    total_rows := 0
    loop row in debug {
        w: 1 + row.lines.len()
        weights.push(w)
        total_rows += w
    }
    admitted: compiler_threads_admit(threads, count, total_rows, DWARF_LINE_MIN_ROWS_PER_THREAD, 0, 0)
    workers: if admitted > 8 -> 8 else -> admitted
    if workers <= 1 {
        body := dwarf_line_range(program, functions, debug, offsets, sizes, symbols, 0, count)
        base: line.len()
        line.extend(body.bytes)
        loop r in body.relas {
            relas.push(X64ObjectRela{at: base + r.at, symbol: r.symbol, kind: r.kind, addend: r.addend})
        }
        dwarf_patch_length(line, 0)
        return DwarfSectionRows{bytes: line.move(), relas: relas.move()}
    }
    bounds: compiler_threads_partition(weights, workers)
    chunks := dwarf_line_chunks(program, functions, debug, offsets, sizes, symbols, bounds, 0)
    total_bytes := line.len()
    total_relas := 0
    loop c in chunks {
        total_bytes += c.bytes.len()
        total_relas += c.relas.len()
    }
    line.try_reserve(total_bytes) ?? ()
    relas.try_reserve(total_relas) ?? ()
    loop chunk in chunks.move() {
        base: line.len()
        line.extend(chunk.bytes)
        loop r in chunk.relas {
            relas.push(X64ObjectRela{at: base + r.at, symbol: r.symbol, kind: r.kind, addend: r.addend})
        }
    }
    dwarf_patch_length(line, 0)
    DwarfSectionRows{bytes: line.move(), relas: relas.move()}
}

// The `.debug_jetline` table of the Jet functions (those with a source file
// and a declaration line: fault reports name no other), the facts
// `.debug_info` and `.debug_line` hold, in one block the fault handler scans
// without a DWARF reader:
//   u32 length of the block after this word, u32 function count, u32 offset
//   of the strings and u32 of the rows (from the block's start), then per
//   function 32 bytes: u64 start address (a relocation), u32 code length,
//   u32 name and u32 file path (string offsets), u32 declaration line,
//   u32 offset of its rows (in the rows) and u32 their byte length.
//   Strings: the compilation directory (`.` when none) at 0, then the names
//   and the paths (each path once), NUL terminated.
//   Rows: per function, its rows as Image/Jetline.jet x64_jetline_rows
//   codes them, the `.debug_line` rows and the call rows.
// This is the object form: the linker (Image/DebugPrune.jet) drops the
// records of the functions it dropped and writes the linked form the fault
// report reads, varint records in address order.
dwarf_jet_line: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols) -> DwarfSectionRows Never! {
    dwarf_jet_line_threads(program, functions, debug, offsets, sizes, symbols, compiler_threads_single())
}

DwarfJetLineChunk: struct {
    rows: [U8],
    lens: [Int],
}

dwarf_jet_line_chunk: fn(kept: [Int], debug: [X64FunctionDebug], start: Int, end: Int) -> DwarfJetLineChunk Never! {
    rows := [U8]{}
    lens := [Int]{}
    lens.try_reserve(end - start) ?? ()
    loop pos in start..<end {
        from: rows.len()
        x64_jetline_rows(rows, debug[kept[pos]].lines)
        lens.push(rows.len() - from)
    }
    DwarfJetLineChunk{rows: rows.move(), lens: lens.move()}
}

dwarf_jet_line_chunks: fn(kept: [Int], debug: [X64FunctionDebug], bounds: [Int], at: Int) -> [DwarfJetLineChunk] Never! {
    last: bounds.len() - 2
    if at > last -> return [DwarfJetLineChunk]{}
    if at == last {
        return [DwarfJetLineChunk]{dwarf_jet_line_chunk(kept, debug, bounds[at], bounds[at + 1])}
    }
    done := [DwarfJetLineChunk]{}
    task.group dwarf_jet_line_parts {
        head: task dwarf_jet_line_chunk(kept, debug, bounds[at], bounds[at + 1])
        rest: dwarf_jet_line_chunks(kept, debug, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop item in rest.move() -> done.push(item)
    }
    done
}

dwarf_jet_line_threads: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], symbols: X64DwarfSymbols, threads: CompilerThreads) -> DwarfSectionRows Never! {
    table := [U8]{}
    relas := [X64ObjectRela]{}
    strings := [U8]{}
    rows := [U8]{}
    dwarf_string(strings, if program.debug.directory == "" -> "." else -> program.debug.directory)
    paths := [Int]{}
    loop _ in program.debug.files -> paths.push(-1)
    kept := [Int]{}
    kept.try_reserve(functions.len()) ?? ()
    weights := [Int]{}
    total_rows := 0
    loop (index, function) in functions {
        facts: dwarf_function_debug(program, function)
        if facts.file >= 0 && facts.line > 0 {
            kept.push(index)
            w: 1 + debug[index].lines.len()
            weights.push(w)
            total_rows += w
        }
    }
    table.try_reserve(16 + kept.len() * 32) ?? ()
    relas.try_reserve(kept.len()) ?? ()
    elf64_u32(table, 0)
    elf64_u32(table, kept.len())
    strings_at: table.len()
    elf64_u32(table, 0)
    rows_at: table.len()
    elf64_u32(table, 0)
    admitted: compiler_threads_admit(threads, kept.len(), total_rows, DWARF_LINE_MIN_ROWS_PER_THREAD, 0, 0)
    workers: if admitted > 8 -> 8 else -> admitted
    if workers <= 1 {
        loop index in kept {
            function: functions[index]
            facts: dwarf_function_debug(program, function)
            dwarf_address(table, relas, dwarf_function_symbol(symbols, index), offsets[index])
            elf64_u32(table, sizes[index])
            elf64_u32(table, strings.len())
            dwarf_string(strings, facts.name)
            if paths[facts.file] < 0 {
                paths[facts.file] = strings.len()
                dwarf_string(strings, program.debug.files[facts.file])
            }
            elf64_u32(table, paths[facts.file])
            elf64_u32(table, facts.line)
            elf64_u32(table, rows.len())
            from: rows.len()
            x64_jetline_rows(rows, debug[index].lines)
            elf64_u32(table, rows.len() - from)
        }
    } else {
        bounds: compiler_threads_partition(weights, workers)
        chunks := dwarf_jet_line_chunks(kept, debug, bounds, 0)
        row_lens := [Int]{}
        row_lens.try_reserve(kept.len()) ?? ()
        total_row_bytes := 0
        loop c in chunks -> total_row_bytes += c.rows.len()
        rows.try_reserve(total_row_bytes) ?? ()
        loop chunk in chunks.move() {
            rows.extend(chunk.rows)
            row_lens.extend(chunk.lens)
        }
        row_off := 0
        loop (pos, index) in kept {
            function: functions[index]
            facts: dwarf_function_debug(program, function)
            dwarf_address(table, relas, dwarf_function_symbol(symbols, index), offsets[index])
            elf64_u32(table, sizes[index])
            elf64_u32(table, strings.len())
            dwarf_string(strings, facts.name)
            if paths[facts.file] < 0 {
                paths[facts.file] = strings.len()
                dwarf_string(strings, program.debug.files[facts.file])
            }
            elf64_u32(table, paths[facts.file])
            elf64_u32(table, facts.line)
            elf64_u32(table, row_off)
            row_len: row_lens[pos]
            elf64_u32(table, row_len)
            row_off += row_len
        }
    }
    strings_start: table.len()
    dwarf_patch_u32(table, strings_at, strings_start)
    table.try_reserve(table.len() + strings.len() + rows.len()) ?? ()
    table.extend(strings)
    rows_start: table.len()
    dwarf_patch_u32(table, rows_at, rows_start)
    table.extend(rows)
    dwarf_patch_length(table, 0)
    DwarfSectionRows{bytes: table.move(), relas: relas.move()}
}

// The debug and unwind sections for `functions` (placed at `offsets` in a
// `.text` of `text_size` bytes, or with `symbols.functions` each at offset 0
// of its own section, and `sizes` bytes long: the object writer holds their
// code by then; debug[i] belongs to functions[i]); the subprograms of
// `.debug_info` on the threads `threads` admits. With `debug_info` false
// only `.eh_frame` is built; the DWARF sections, `.debug_jetline` and
// `.debug_jetsource` stay empty. Each section reads only the inputs, so
// when `threads` admits a second thread for the line rows, `.eh_frame`,
// `.debug_line` and `.debug_jetline` are each built on a thread of their
// own while this thread builds `.debug_info`: the bytes are the same for
// any thread count.
x64_dwarf_sections: fn(program: X64ObjectModule, functions: [X64CompiledFunction], debug: [X64FunctionDebug], offsets: [Int], sizes: [Int], text_size: Int, symbols: X64DwarfSymbols, threads: CompilerThreads, debug_info: Bool) -> X64DwarfSections Never! {
    sections := X64DwarfSections{
        eh_frame: [U8]{},
        eh_relas: [X64ObjectRela]{},
        abbrev: [U8]{},
        info: [X64ObjectPiece]{},
        info_relas: [X64ObjectRela]{},
        line: [U8]{},
        line_relas: [X64ObjectRela]{},
        jet_line: [U8]{},
        jet_line_relas: [X64ObjectRela]{},
        loclists: [X64ObjectPiece]{},
        addr: [U8]{},
        addr_relas: [X64ObjectRela]{},
        rnglists: [X64ObjectPiece]{},
    }
    rows := 0
    loop row in debug -> rows += 1 + row.lines.len()
    frame := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    line := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    jet_line := DwarfSectionRows{bytes: [U8]{}, relas: [X64ObjectRela]{}}
    sites := false
    loop row in debug {
        if row.allocs.len() > 0 -> sites = true
    }
    if debug_info {
        sections.abbrev = dwarf_abbrevs(symbols.functions.len() > 0, sites)
        sections.sources = dwarf_sources(program.debug.sources)
    }
    if {
        !debug_info -> frame = dwarf_eh_frame_threads(debug, offsets, sizes, symbols, threads)
        compiler_threads_admit(threads, functions.len(), rows, DWARF_LINE_MIN_ROWS_PER_THREAD, 0, 0) <= 1 -> {
            frame = dwarf_eh_frame_threads(debug, offsets, sizes, symbols, threads)
            dwarf_info(sections, program, functions, debug, offsets, sizes, text_size, symbols, threads)
            line = dwarf_line_threads(program, functions, debug, offsets, sizes, symbols, threads)
            jet_line = dwarf_jet_line_threads(program, functions, debug, offsets, sizes, symbols, threads)
        }
        else -> {
            task.group dwarf_section_threads {
                framing: task dwarf_eh_frame_threads(debug, offsets, sizes, symbols, threads)
                lining: task dwarf_line_threads(program, functions, debug, offsets, sizes, symbols, threads)
                jet_lining: task dwarf_jet_line_threads(program, functions, debug, offsets, sizes, symbols, threads)
                dwarf_info(sections, program, functions, debug, offsets, sizes, text_size, symbols, threads)
                frame = compiler_threads_joined(framing)
                line = compiler_threads_joined(lining)
                jet_line = compiler_threads_joined(jet_lining)
            }
        }
    }
    sections.eh_frame = frame.bytes.move()
    sections.eh_relas = frame.relas.move()
    sections.line = line.bytes.move()
    sections.line_relas = line.relas.move()
    sections.jet_line = jet_line.bytes.move()
    sections.jet_line_relas = jet_line.relas.move()
    sections
}

// The `.debug_jetsource` bytes of `sources`: per source its path, a NUL
// and the 32 bytes of its sha256.
dwarf_sources: fn(sources: [X64DebugSource]) -> [U8] Never! {
    bytes := [U8]{}
    loop source in sources {
        bytes.extend(source.path.bytes())
        bytes.push(U8{0})
        bytes.extend(source.digest)
    }
    bytes
}

// The sources a `.debug_jetsource` section's `bytes` records
// (dwarf_sources); None when they are not such a record.
x64_dwarf_sources_parse: fn(bytes: [U8]) -> [X64DebugSource]? Never! {
    sources := [X64DebugSource]{}
    at := 0
    loop at < bytes.len() {
        end := at
        loop end < bytes.len() && bytes[end] != 0 -> end += 1
        if end + 33 > bytes.len() -> return None
        path: String.from_bytes(bytes[at..<end]) ?? return None
        sources.push(X64DebugSource{path: path, digest: bytes[end + 1..<end + 33]})
        at = end + 33
    }
    Val(sources)
}

// Fewest line rows (a function counts one besides its rows) a section
// thread is admitted for: below it `.eh_frame`, `.debug_line` and
// `.debug_jetline` are built on the calling thread, after the subprograms.
DWARF_LINE_MIN_ROWS_PER_THREAD: 20000

// The section rows' relocations as numbers, for comparing them.
dwarf_test_relas: fn(relas: [X64ObjectRela]) -> [Int] Never! {
    out := [Int]{}
    loop rela in relas {
        out.push(rela.at)
        out.push(rela.symbol)
        out.push(rela.kind)
        out.push(rela.addend)
    }
    out
}

// A section's pieces joined, for comparing them; a piece that does not
// start where the one before it ends leaves the bytes empty.
dwarf_test_bytes: fn(pieces: [X64ObjectPiece]) -> [U8] Never! {
    out := [U8]{}
    loop piece in pieces {
        if piece.at != out.len() -> return [U8]{}
        out.extend(piece.bytes)
    }
    out
}

#Test("the debug sections built beside the subprograms are those of one thread") {
    count: 3000
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    sources := [X64FunctionSource]{}
    offsets := [Int]{}
    sizes := [Int]{}
    loop id in 0..<count {
        code := [U8]{}
        lines := [X64LineRow]{}
        loop row in 0..<20 {
            code.push(U8{0x90})
            lines.push(X64LineRow{at: row, line: id + 2 * row + 1})
        }
        code.push(U8{0xc3})
        offsets.push(id * 32)
        sizes.push(code.len())
        functions.push(X64CompiledFunction{id: X64FunctionID{value: id}, name: "f{id}", code: code.move(), relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN})
        debug.push(X64FunctionDebug{lines: lines.move(), body: 1, cfi: [U8]{U8{0x0e}, U8{0x10}}, ranges: [X64VariableRange]{}})
        sources.push(X64FunctionSource{name: "f{id}", file: id % 2, line: id + 1, variables: [X64DebugVariable]{}})
    }
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{"a.jet", "b.jet"}, types: [X64DebugType]{}}, functions: sources.move()}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{}}
    one: x64_dwarf_sections(program, functions, debug, offsets, sizes, count * 32, symbols, compiler_threads_single(), true)
    many: x64_dwarf_sections(program, functions, debug, offsets, sizes, count * 32, symbols, CompilerThreads{cap: Val(8), cores: 8, memory_available: None}, true)
    assert(one.line.len() > 0 && one.jet_line.len() > 0 && one.eh_frame.len() > 0)
    assert_eq(many.eh_frame, one.eh_frame)
    assert_eq(dwarf_test_relas(many.eh_relas), dwarf_test_relas(one.eh_relas))
    assert(many.info.len() > 3 && one.info.len() == 3)
    assert(dwarf_test_bytes(one.info).len() > 0)
    assert_eq(dwarf_test_bytes(many.info), dwarf_test_bytes(one.info))
    assert_eq(dwarf_test_relas(many.info_relas), dwarf_test_relas(one.info_relas))
    assert_eq(many.line, one.line)
    assert_eq(dwarf_test_relas(many.line_relas), dwarf_test_relas(one.line_relas))
    assert_eq(many.jet_line, one.jet_line)
    assert_eq(dwarf_test_relas(many.jet_line_relas), dwarf_test_relas(one.jet_line_relas))
    assert_eq(dwarf_test_bytes(many.loclists), dwarf_test_bytes(one.loclists))
    assert_eq(dwarf_test_bytes(many.rnglists), dwarf_test_bytes(one.rnglists))
    assert_eq(many.addr, one.addr)
    assert_eq(dwarf_test_relas(many.addr_relas), dwarf_test_relas(one.addr_relas))
}

// A checked-alloc image's allocating calls are call sites at their return
// addresses, in a Jet subprogram and a generated one alike, each naming its
// type; an image with none keeps the abbreviations it had.
#Test("allocating calls are typed call sites of their subprograms") {
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    plain := [X64FunctionDebug]{}
    loop id in 0..<2 {
        functions.push(X64CompiledFunction{id: X64FunctionID{value: id}, name: "f{id}", code: [U8]{U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0xc3}}, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN})
        debug.push(X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}, allocs: [X64AllocSite]{X64AllocSite{at: 5 - id, ty: 0}}})
        plain.push(X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}})
    }
    sources: [X64FunctionSource]{X64FunctionSource{name: "f0", file: 0, line: 1, variables: [X64DebugVariable]{}}, x64_function_source_none()}
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{"a.jet"}, types: [X64DebugType]{X64DebugType{name: "Node", size: 8, kind: X64DebugTypeKind.Opaque}}}, functions: sources}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{}}
    offsets: [Int]{0, 32}
    sizes: [Int]{7, 7}
    sited: x64_dwarf_sections(program, functions, debug, offsets, sizes, 64, symbols, compiler_threads_single(), true)
    bare: x64_dwarf_sections(program, functions, plain, offsets, sizes, 64, symbols, compiler_threads_single(), true)
    assert_eq(bare.abbrev, dwarf_abbrevs(false, false))
    assert_eq(sited.abbrev, dwarf_abbrevs(false, true))
    returns := [Int]{}
    loop rela in sited.info_relas {
        if rela.symbol == symbols.text && rela.kind == ELF64_R_X86_64_64 {
            returns.push(rela.addend)
        }
    }
    // The unit's range, then per function its call site; the functions'
    // starts are their `.debug_addr` slots.
    assert_eq(returns, [Int]{0, 5, 36})
    assert_eq(dwarf_test_relas(sited.addr_relas), [Int]{8, symbols.text, ELF64_R_X86_64_64, 0, 16, symbols.text, ELF64_R_X86_64_64, 32})
    info: dwarf_test_bytes(sited.info)
    assert(info.len() > dwarf_test_bytes(bare.info).len())
    assert(link_info_plan(info, sited.abbrev, sited.addr, 0, 64) != None)
}

// A call whose caller keeps its arguments holds a call site parameter per
// argument, its register and value, which the link's walk reads through;
// a parameter's entry value is DW_OP_entry_value of its register.
#Test("a call keeps its arguments as call site parameters") {
    assert_eq(dwarf_location(X64DebugLocation.EntryValue{reg: X64_RDI}, false), [U8]{0xa3, 1, 0x55, 0x9f})
    function: X64CompiledFunction{id: X64FunctionID{value: 0}, name: "f0", code: [U8]{U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0xc3}}, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN}
    kept: [X64CallArgument]{X64CallArgument{reg: X64_RDI, value: X64DebugLocation.Constant{value: 3}}, X64CallArgument{reg: X64_RSI, value: X64DebugLocation.Frame{offset: -16}}}
    debug: X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}, calls: [X64CallSite]{X64CallSite{at: 5, line: 2, column: 3, arguments: kept}}}
    sources: [X64FunctionSource]{X64FunctionSource{name: "f0", file: 0, line: 1, variables: [X64DebugVariable]{}}}
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{"a.jet"}, types: [X64DebugType]{}}, functions: sources}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{}}
    built: x64_dwarf_sections(program, [X64CompiledFunction]{function}, [X64FunctionDebug]{debug}, [Int]{0}, [Int]{6}, 64, symbols, compiler_threads_single(), true)
    info: dwarf_test_bytes(built.info)
    // rdi (DW_OP_reg5) is 3 (DW_OP_consts); rsi (DW_OP_reg4) the word at
    // fbreg(-16) (DW_OP_deref); then the end of the call's children.
    parameters: [U8]{U8{DWARF_ABBREV_CALL_ARGUMENT}, 1, 0x55, 2, 0x11, 3, U8{DWARF_ABBREV_CALL_ARGUMENT}, 1, 0x54, 3, 0x91, 0x70, 0x06, 0}
    found := false
    loop at in 0..<(info.len() - parameters.len() + 1) {
        same := true
        loop k in 0..<parameters.len() {
            if info[at + k] != parameters[k] -> same = false
        }
        if same -> found = true
    }
    assert(found)
    assert(link_info_plan(info, built.abbrev, built.addr, 0, 64) != None)
}

// The list at `from` (DW_LLE_* entries with `exprs`, else DW_RLE_*) as
// numbers: its DW_*_base_addressx index, then each DW_*_offset_pair's
// bounds; none for any other entry.
dwarf_test_list: fn(bytes: [U8], from: Int, exprs: Bool{false}) -> [Int] Never! {
    out := [Int]{}
    at := from
    if (Int{bytes[at]}) != 1 -> return [Int]{}
    at += 1
    out.push(link_debug_uleb(bytes, at))
    loop at < bytes.len() {
        kind: Int{bytes[at]}
        at += 1
        if kind == 0 -> return out
        if kind != 4 -> return [Int]{}
        out.push(link_debug_uleb(bytes, at))
        out.push(link_debug_uleb(bytes, at))
        if exprs {
            length: link_debug_uleb(bytes, at)
            at += length
        }
    }
    [Int]{}
}

// A function's location lists and inline runs take no relocation: each
// list starts from its function's start, an index into `.debug_addr`
// (DW_LLE_base_addressx, DW_RLE_base_addressx), and the DIEs name the
// lists by index (DW_FORM_loclistx, DW_FORM_rnglistx). With one section
// per function the only relocation a function takes is its `.debug_addr`
// slot's, besides its calls' return addresses. The link's walk reads the
// starts through the slots, and pruning keeps each table's indexes.
#Test("location and range lists take no relocations") {
    code: [U8]{U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0x90}, U8{0xc3}}
    functions: [X64CompiledFunction]{
        X64CompiledFunction{id: X64FunctionID{value: 0}, name: "f0", code: code, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN},
        X64CompiledFunction{id: X64FunctionID{value: 1}, name: "f1", code: code, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN},
    }
    // f0's `x` is in rdi, then in a frame slot; `y`, of the run of `g`
    // inlined at offsets 2..<5, is 7 for part of it.
    ranges: [X64VariableRange]{
        X64VariableRange{variable: 0, start: 0, end: 2, location: X64DebugLocation.Register{reg: X64_RDI}},
        X64VariableRange{variable: 0, start: 2, end: 7, location: X64DebugLocation.Frame{offset: -16}},
        X64VariableRange{variable: 1, start: 3, end: 5, location: X64DebugLocation.Constant{value: 7}},
    }
    debug: [X64FunctionDebug]{
        X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: ranges, inlines: [X64InlineRange]{X64InlineRange{site: 1, start: 2, end: 5}}},
        X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}},
    }
    variables: [X64DebugVariable]{
        X64DebugVariable{name: "x", ty: 0, line: 1, parameter: true, indirect: false},
        X64DebugVariable{name: "y", ty: 0, line: 4, parameter: false, indirect: false, site: 1},
    }
    sites: [X64InlineSite]{X64InlineSite{function: 1, name: "g", file: 0, line: 3, parent: 0, call_line: 2}}
    sources: [X64FunctionSource]{X64FunctionSource{name: "f0", file: 0, line: 1, variables: variables, inlines: sites}, X64FunctionSource{name: "f1", file: 0, line: 3, variables: [X64DebugVariable]{}}}
    types: [X64DebugType]{X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}}}
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{"a.jet"}, types: types}, functions: sources}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{10, 11}}
    built: x64_dwarf_sections(program, functions, debug, [Int]{0, 0}, [Int]{8, 8}, 0, symbols, compiler_threads_single(), true)
    // The unit's own: the abbreviations, the line program and its bases.
    named := [Int]{}
    loop rela in built.info_relas -> named.push(rela.symbol)
    assert_eq(named, [Int]{symbols.abbrev, symbols.line, symbols.addr, symbols.loclists, symbols.rnglists})
    // One relocation per function: its `.debug_addr` slot.
    assert_eq(dwarf_test_relas(built.addr_relas), [Int]{8, 10, ELF64_R_X86_64_64, 0, 16, 11, ELF64_R_X86_64_64, 0})
    assert_eq(built.addr.len(), 8 + 16)
    // `x`'s list and `y`'s, from f0's start (slot 0); the run's range.
    lists: dwarf_test_bytes(built.loclists)
    assert_eq(link_debug_le(lists, 0, 4), lists.len() - 4)
    assert_eq(link_debug_le(lists, 8, 4), 2)
    assert_eq(dwarf_test_list(lists, 12 + link_debug_le(lists, 12, 4), exprs: true), [Int]{0, 0, 2, 2, 7})
    assert_eq(dwarf_test_list(lists, 12 + link_debug_le(lists, 16, 4), exprs: true), [Int]{0, 3, 5})
    ranged: dwarf_test_bytes(built.rnglists)
    assert_eq(link_debug_le(ranged, 0, 4), ranged.len() - 4)
    assert_eq(link_debug_le(ranged, 8, 4), 1)
    assert_eq(dwarf_test_list(ranged, 12 + link_debug_le(ranged, 12, 4)), [Int]{0, 2, 5})

    // Linked with every debug section at 0, f0 at 0x100 and f1 at 0x200.
    info := dwarf_test_bytes(built.info)
    loop rela in built.info_relas -> dwarf_patch_u32(info, rela.at, rela.addend)
    addr := built.addr
    loop rela in built.addr_relas {
        start: if rela.symbol == 10 -> 0x100 else -> 0x200
        loop k in 0..<8 -> addr[rela.at + k] = U8{((start + rela.addend) >> (8 * k)) & 255}
    }
    kept: link_info_plan(info, built.abbrev, addr, 0x100, 0x110) ?? panic("the unit didn't walk")
    assert_eq(kept.drops.len(), 2)
    assert_eq(kept.list_refs, [Int]{12, 0, 12, 1})
    assert_eq(kept.range_refs, [Int]{12, 0})
    whole := lists
    moved := [Int:Int]{}
    link_lists_prune(whole, kept.list_refs, moved)
    assert_eq(whole, lists)
    // With f0 dropped both table entries name one empty list.
    dropped: link_info_plan(info, built.abbrev, addr, 0x200, 0x210) ?? panic("the unit didn't walk")
    assert_eq(dropped.list_refs.len() + dropped.range_refs.len(), 0)
    pruned := lists
    link_lists_prune(pruned, dropped.list_refs, moved)
    assert_eq(pruned.len(), 12 + 8 + 1)
    assert_eq(link_debug_le(pruned, 12, 4), 8)
    assert_eq(link_debug_le(pruned, 16, 4), 8)
    assert_eq(link_debug_le(pruned, 0, 4), pruned.len() - 4)
}

// An image records each source it was compiled from, its path and sha256,
// and reads them back; an image without debug info records none.
#Test("the image records its sources and their digests") {
    digest := [U8]{}
    loop k in 0..<32 -> digest.push(U8{k})
    recorded: [X64DebugSource]{X64DebugSource{path: "prog.jet", digest: digest}, X64DebugSource{path: "../lib/b.jet", digest: digest}}
    bytes: dwarf_sources(recorded)
    assert_eq(bytes.len(), "prog.jet".len() + 33 + "../lib/b.jet".len() + 33)
    read: x64_dwarf_sources_parse(bytes) ?? panic("the record didn't parse")
    assert_eq(read.len(), 2)
    assert_eq(read[1].path, "../lib/b.jet")
    assert_eq(read[1].digest, digest)
    assert(x64_dwarf_sources_parse(bytes[0..<bytes.len() - 1]) == None)
    program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}, sources: recorded}, functions: [X64FunctionSource]{}}
    symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{}}
    built: x64_dwarf_sections(program, [X64CompiledFunction]{}, [X64FunctionDebug]{}, [Int]{}, [Int]{}, 0, symbols, compiler_threads_single(), true)
    assert_eq(built.sources, bytes)
    stripped: x64_dwarf_sections(program, [X64CompiledFunction]{}, [X64FunctionDebug]{}, [Int]{}, [Int]{}, 0, symbols, compiler_threads_single(), false)
    assert_eq(stripped.sources.len(), 0)
}
