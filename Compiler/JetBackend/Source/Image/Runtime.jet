    x64_store(&a.code, X64_RAX, 0, X64_RDX)
    x64_store(&a.code, X64_RBX, 0, X64_RAX)
    x64_mov_ri(&a.code, X64_RDX, X64_IMAGE_BUILDER_START)
    x64_store(&a.code, X64_RBX, 8, X64_RDX)
