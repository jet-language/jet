// jet_rt_bool_to_string(Bool) -> String
fn x64_image_bool_to_string() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    no :: x64_image_label(&a)
    x64_movzx_r8(&a.code, X64_RDI, X64_RDI)
    x64_test_rr(&a.code, X64_RDI, X64_RDI)
