    x64_image_call(&a, "jet_image_write")
    x64_push_i8(&a.code, 10)
    x64_mov_rr(&a.code, X64_RSI, X64_RSP)
    x64_mov_ri(&a.code, X64_RDX, 1)
    x64_mov_ri(&a.code, X64_RDI, 1)
    x64_image_call(&a, "jet_image_write")
    x64_pop(&a.code, X64_RAX)
    x64_pop(&a.code, X64_RBX)
    x64_ret(&a.code)
    x64_image_finish(&a, "jet_term_write_stdout_line")
}

// jet_rt_string_builder_new() -> builder
fn x64_image_builder_new() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    x64_push(&a.code, X64_RBX)
