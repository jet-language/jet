// Freestanding runtime for static x86-64 Linux images: the runtime symbols
// the O0 lowering calls, hand-assembled over raw Linux system calls, for
// images that link neither libc nor the compiled runtime. It implements the
// symbol table of the design doc ("Calls into the compiled runtime") with the
// same System V signatures. Hosted images use compiled C-ABI exports instead;
// frozen module String carriers currently require this freestanding runtime.
//
// Representations, private to this runtime:
// - memory comes from mmap and returns to munmap (`jet_rt_free` passes the size);
// - a String handle points at `[len: word][bytes]`; bit 63 marks frozen static
//   storage, never freed. Readers mask it and clone returns an unflagged owner;
// - a string builder points at `[buffer: String-shaped, capacity: word]`;
// - a range cursor points at `[current, end, step, exclusive, done]` words.
// Int words are inline integers only: a result outside the inline range stops
// the program with a report, because big integers live in the compiled runtime.
// A runtime stop writes `error[CODE]: message` to stderr and exits with 70,
// the compiled runtime's stop status.

use jet_foundation.[JET_RUST_DEBUG_ESCAPED_RANGES]

struct X64ImageFixup { pub at: Int, pub label: Int }

// One hand-assembled function: local labels, rel32 fixups to them, and
// relocations to other runtime symbols. Message text is placed after the code.
struct X64ImageAsm {
    pub code: [U8]
    pub relocs: [X64Reloc]
    pub labels: [Int]
    pub fixups: [X64ImageFixup]
    pub texts: [String]
    pub text_labels: [Int]
}

X64_IMAGE_STOP_STATUS :: prep { 70 }
X64_IMAGE_CURSOR_SIZE :: prep { 40 }
X64_IMAGE_BUILDER_START :: prep { 64 }

fn x64_image_asm() -> X64ImageAsm Never! {
    X64ImageAsm{code: [U8]{}, relocs: [X64Reloc]{}, labels: [Int]{}, fixups: [X64ImageFixup]{}, texts: [String]{}, text_labels: [Int]{}}
}

fn x64_image_label(a: &X64ImageAsm) -> Int Never! {
    &a.labels.push(-1)
    a.labels.len() - 1
}

fn x64_image_set(list: &[Int], index: Int, value: Int) Never! {
    list[index] = value
}

fn x64_image_bind(a: &X64ImageAsm, label: Int) Never! {
    x64_image_set(&a.labels, label, a.code.len())
}

fn x64_image_jmp(a: &X64ImageAsm, label: Int) Never! {
    at :: x64_jmp_rel32(&a.code)
    &a.fixups.push(X64ImageFixup{at: at, label: label})
}

fn x64_image_jcc(a: &X64ImageAsm, cond: X64Cond, label: Int) Never! {
    at :: x64_jcc_rel32(&a.code, cond)
    &a.fixups.push(X64ImageFixup{at: at, label: label})
}

fn x64_image_call(a: &X64ImageAsm, symbol: String) Never! {
    at :: x64_call_rel32(&a.code)
    &a.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Runtime{symbol: symbol}})
}

// Tail call: jmp rel32 to another runtime symbol.
fn x64_image_tail(a: &X64ImageAsm, symbol: String) Never! {
    at :: x64_jmp_rel32(&a.code)
    &a.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Runtime{symbol: symbol}})
}

fn x64_image_jcc_symbol(a: &X64ImageAsm, cond: X64Cond, symbol: String) Never! {
    at :: x64_jcc_rel32(&a.code, cond)
    &a.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Runtime{symbol: symbol}})
}

fn x64_image_byte_len(text: String) -> Int Never! {
    count := 0
    loop _ in text.bytes() -> count += 1
    count
}

// reg = address of `text`, placed after this function's code; `len_reg` = its byte length.
fn x64_image_text(a: &X64ImageAsm, reg: Int, len_reg: Int, text: String) Never! {
    label :: x64_image_label(&a)
    &a.texts.push(text)
    &a.text_labels.push(label)
    at :: x64_lea_rip(&a.code, reg)
    &a.fixups.push(X64ImageFixup{at: at, label: label})
    x64_mov_ri(&a.code, len_reg, x64_image_byte_len(text))
}

// Stop the program with `message` (a full `error[CODE]: ...` line).
fn x64_image_stop_with(a: &X64ImageAsm, message: String) Never! {
    x64_image_text(&a, X64_RDI, X64_RSI, message)
    x64_image_tail(&a, "jet_image_stop")
}

fn x64_image_syscall(a: &X64ImageAsm, number: Int) Never! {
    x64_mov_ri(&a.code, X64_RAX, number)
    x64_syscall(&a.code)
}

fn x64_image_finish(a: &X64ImageAsm, name: String) -> X64CompiledFunction Never! {
    texts :: ~a.texts
    text_labels :: ~a.text_labels
    loop (index, text) in texts {
        x64_image_bind(&a, text_labels[index])
        loop byte in text.bytes() -> &a.code.push(byte)
    }
    loop fixup in a.fixups -> x64_patch_rel32(&a.code, fixup.at, a.labels[fixup.label])
    X64CompiledFunction{id: LIRFunctionID{value: -1}, name: name, code: a.code, relocs: a.relocs}
}

// rcx = rax shifted left once, xor rax: negative exactly when rax is not an
// inline Int (bits 63 and 62 differ); jumps to `outside` then.
fn x64_image_inline_check(a: &X64ImageAsm, outside: Int) Never! {
    x64_mov_rr(&a.code, X64_RCX, X64_RAX)
    x64_alu_rr(&a.code, X64Alu.Add, X64_RCX, X64_RCX)
    x64_alu_rr(&a.code, X64Alu.Xor, X64_RCX, X64_RAX)
    x64_image_jcc(&a, X64Cond.S, outside)
}

// ---------------------------------------------------------------------------
// Process, memory and stops.

// jet_image_write(fd, ptr, len): write every byte, retrying short writes.
fn x64_image_write() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    top :: x64_image_label(&a)
    done :: x64_image_label(&a)
    x64_image_bind(&a, top)
    x64_test_rr(&a.code, X64_RDX, X64_RDX)
    x64_image_jcc(&a, X64Cond.E, done)
    x64_image_syscall(&a, 1)
    x64_test_rr(&a.code, X64_RAX, X64_RAX)
    x64_image_jcc(&a, X64Cond.LE, done)
    x64_alu_rr(&a.code, X64Alu.Add, X64_RSI, X64_RAX)
    x64_alu_rr(&a.code, X64Alu.Sub, X64_RDX, X64_RAX)
    x64_image_jmp(&a, top)
    x64_image_bind(&a, done)
    x64_ret(&a.code)
    x64_image_finish(&a, "jet_image_write")
}

// jet_image_stop(ptr, len): write the message to stderr and exit_group(70).
fn x64_image_stop() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    x64_mov_rr(&a.code, X64_RDX, X64_RSI)
    x64_mov_rr(&a.code, X64_RSI, X64_RDI)
    x64_mov_ri(&a.code, X64_RDI, 2)
    x64_image_call(&a, "jet_image_write")
    x64_mov_ri(&a.code, X64_RDI, X64_IMAGE_STOP_STATUS)
    x64_image_syscall(&a, 231)
    x64_ud2(&a.code)
    x64_image_finish(&a, "jet_image_stop")
}

// jet_rt_panic_list_bounds(len, index): the E3010 List bounds stop with
// Outcome.rs jet_list_bounds_message's wording; the process exits, so the
// rendered numbers are never freed.
fn x64_image_list_bounds_stop() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    x64_mov_rr(&a.code, X64_R12, X64_RDI)
    x64_mov_rr(&a.code, X64_R13, X64_RSI)
    pieces :: [String]{"error[E3010]: the list has ", " items, so position "}
    loop (ordinal, piece) in pieces {
        x64_mov_ri(&a.code, X64_RDI, 2)
        x64_image_text(&a, X64_RSI, X64_RDX, piece)
        x64_image_call(&a, "jet_image_write")
        x64_mov_rr(&a.code, X64_RDI, if ordinal == 0 -> X64_R12 else -> X64_R13)
        x64_image_call(&a, "jet_rt_i64_to_string")
        x64_load(&a.code, X64_RDX, X64_RAX, 0)
        x64_lea(&a.code, X64_RSI, X64_RAX, 8)
        x64_mov_ri(&a.code, X64_RDI, 2)
        x64_image_call(&a, "jet_image_write")
    }
    x64_image_stop_with(&a, " doesn't exist\n")
    x64_image_finish(&a, "jet_rt_panic_list_bounds")
}

// require/panic's borrowed String carrier, written without a trailing newline.
fn x64_image_require_write_string(a: &X64ImageAsm, handle: Int) Never! {
    x64_load(&a.code, X64_RDX, handle, 0)
    x64_image_string_length(&a.code, X64_RDX)
    x64_lea(&a.code, X64_RSI, handle, 8)
    x64_mov_ri(&a.code, X64_RDI, 2)
    x64_image_call(&a, "jet_image_write")
}

fn x64_image_require_write_text(a: &X64ImageAsm, text: String) Never! {
    x64_image_text(&a, X64_RSI, X64_RDX, text)
    x64_mov_ri(&a.code, X64_RDI, 2)
    x64_image_call(&a, "jet_image_write")
}

// jet_rt_require_stop(kind, descriptor, message, left_debug, right_debug, locals).
// Core.rs:jet_require/jet_require_eq/jet_panic_rich; RuntimeDiagnosticCore.rs:
// jet_write_runtime_stop. The static context box is rendered by Require.jet.
fn x64_image_require_stop() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    equal :: x64_image_label(&a)
    context :: x64_image_label(&a)
    tail :: x64_image_label(&a)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RSP, 8)
    x64_store(&a.code, X64_RSP, 0, X64_RDI)
    x64_mov_rr(&a.code, X64_R12, X64_RSI)
    x64_mov_rr(&a.code, X64_R13, X64_RDX)
    x64_mov_rr(&a.code, X64_R14, X64_RCX)
    x64_mov_rr(&a.code, X64_R15, X64_R8)
    x64_mov_rr(&a.code, X64_RBX, X64_R9)
    x64_image_require_write_text(&a, "Stop [E3001]: `panic: ")
    x64_load(&a.code, X64_RAX, X64_RSP, 0)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_RAX, 1)
    x64_image_jcc(&a, X64Cond.E, equal)
    x64_image_require_write_string(&a, X64_R13)
    x64_image_jmp(&a, context)
    x64_image_bind(&a, equal)
    x64_image_require_write_text(&a, "expected: ")
    x64_image_require_write_string(&a, X64_R15)
    x64_image_require_write_text(&a, ", got: ")
    x64_image_require_write_string(&a, X64_R14)
    x64_image_bind(&a, context)
    x64_image_require_write_text(&a, "`\n")
    x64_load(&a.code, X64_RSI, X64_R12, 72)
    x64_load(&a.code, X64_RDX, X64_R12, 80)
    x64_mov_ri(&a.code, X64_RDI, 2)
    x64_image_call(&a, "jet_image_write")
    x64_test_rr(&a.code, X64_RBX, X64_RBX)
    x64_image_jcc(&a, X64Cond.E, tail)
    x64_load(&a.code, X64_RAX, X64_RBX, 0)
    x64_image_string_length(&a.code, X64_RAX)
    x64_test_rr(&a.code, X64_RAX, X64_RAX)
    x64_image_jcc(&a, X64Cond.E, tail)
    x64_image_require_write_text(&a, "locals: ")
    x64_image_require_write_string(&a, X64_RBX)
    x64_image_require_write_text(&a, "\n")
    x64_image_bind(&a, tail)
    x64_image_stop_with(&a, " Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n")
    x64_image_finish(&a, "jet_rt_require_stop")
}

// Values.rs:JetDebug for String = format!("{self:?}"). Decode each scalar,
// binary-search the shared Rust Debug ranges, then write directly into one
// output mapping. Return surplus whole pages, so String drop's len+8 unmaps
// the entire remaining mapping without a second allocation or payload copy.
fn x64_image_require_debug_string() -> X64CompiledFunction Never! {
    ranges :: JET_RUST_DEBUG_ESCAPED_RANGES
    a := x64_image_asm()
    top :: x64_image_label(&a)
    done :: x64_image_label(&a)
    next :: x64_image_label(&a)
    literal :: x64_image_label(&a)
    copy_loop :: x64_image_label(&a)
    unicode :: x64_image_label(&a)
    decoded :: x64_image_label(&a)
    decode :: x64_image_label(&a)
    width3 :: x64_image_label(&a)
    width4 :: x64_image_label(&a)
    short :: x64_image_label(&a)
    search :: x64_image_label(&a)
    search_done :: x64_image_label(&a)
    search_lower :: x64_image_label(&a)
    hex_start :: x64_image_label(&a)
    hex :: x64_image_label(&a)
    hex_digit :: x64_image_label(&a)
    hex_store :: x64_image_label(&a)
    returned :: x64_image_label(&a)
    table :: x64_image_label(&a)
    saved :: [Int]{X64_RBX, X64_R12, X64_R13, X64_R14, X64_R15}
    loop reg in saved -> x64_push(&a.code, reg)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RSP, 16)
    x64_load(&a.code, X64_R13, X64_RDI, 0)
    x64_image_string_length(&a.code, X64_R13)
    x64_lea(&a.code, X64_R12, X64_RDI, 8)
    x64_mov_rr(&a.code, X64_RDI, X64_R13)
    x64_mov_ri(&a.code, X64_RAX, 10)
    x64_imul_rr(&a.code, X64_RDI, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RDI, 10)
    x64_store(&a.code, X64_RSP, 0, X64_RDI)
    x64_mov_ri(&a.code, X64_RSI, 8)
    x64_image_call(&a, "jet_rt_alloc")
    x64_mov_rr(&a.code, X64_R14, X64_RAX)
    x64_lea(&a.code, X64_R15, X64_R14, 8)
    x64_mov_ri(&a.code, X64_RAX, 34)
    x64_store_u8(&a.code, X64_R15, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 1)
    x64_image_bind(&a, top)
    x64_test_rr(&a.code, X64_R13, X64_R13)
    x64_image_jcc(&a, X64Cond.E, done)
    x64_load_u8(&a.code, X64_R9, X64_R12, 0)
    x64_mov_ri(&a.code, X64_R8, 1)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, 128)
    x64_image_jcc(&a, X64Cond.B, decoded)
    x64_mov_ri(&a.code, X64_R8, 2)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, 224)
    x64_image_jcc(&a, X64Cond.AE, width3)
    x64_alu_ri(&a.code, X64Alu.And, X64_R9, 31)
    x64_image_jmp(&a, decode)
    x64_image_bind(&a, width3)
    x64_mov_ri(&a.code, X64_R8, 3)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, 240)
    x64_image_jcc(&a, X64Cond.AE, width4)
    x64_alu_ri(&a.code, X64Alu.And, X64_R9, 15)
    x64_image_jmp(&a, decode)
    x64_image_bind(&a, width4)
    x64_mov_ri(&a.code, X64_R8, 4)
    x64_alu_ri(&a.code, X64Alu.And, X64_R9, 7)
    x64_image_bind(&a, decode)
    x64_mov_ri(&a.code, X64_RCX, 1)
    x64_lea(&a.code, X64_R10, X64_R12, 1)
    decode_loop :: x64_image_label(&a)
    x64_image_bind(&a, decode_loop)
    x64_shift_ri(&a.code, X64Shift.Shl, X64_R9, 6)
    x64_load_u8(&a.code, X64_RAX, X64_R10, 0)
    x64_alu_ri(&a.code, X64Alu.And, X64_RAX, 63)
    x64_alu_rr(&a.code, X64Alu.Or, X64_R9, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R10, 1)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RCX, 1)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_RCX, X64_R8)
    x64_image_jcc(&a, X64Cond.B, decode_loop)
    x64_image_bind(&a, decoded)
    specials :: [Int]{0, 9, 10, 13, 34, 92}
    escapes :: [Int]{48, 116, 110, 114, 34, 92}
    loop (index, scalar) in specials {
        skip :: x64_image_label(&a)
        x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, scalar)
        x64_image_jcc(&a, X64Cond.NE, skip)
        x64_mov_ri(&a.code, X64_RAX, escapes[index])
        x64_image_jmp(&a, short)
        x64_image_bind(&a, skip)
    }
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, 32)
    x64_image_jcc(&a, X64Cond.B, unicode)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_R9, 127)
    x64_image_jcc(&a, X64Cond.E, unicode)
    x64_image_jcc(&a, X64Cond.B, literal)
    at :: x64_lea_rip(&a.code, X64_RSI)
    &a.fixups.push(X64ImageFixup{at: at, label: table})
    x64_mov_ri(&a.code, X64_RDX, 0)
    x64_mov_ri(&a.code, X64_RDI, ranges.len() /% 2)
    x64_image_bind(&a, search)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_RDX, X64_RDI)
    x64_image_jcc(&a, X64Cond.AE, search_done)
    x64_mov_rr(&a.code, X64_RCX, X64_RDX)
    x64_alu_rr(&a.code, X64Alu.Add, X64_RCX, X64_RDI)
    x64_shift_ri(&a.code, X64Shift.Shr, X64_RCX, 1)
    x64_mov_rr(&a.code, X64_R10, X64_RCX)
    x64_shift_ri(&a.code, X64Shift.Shl, X64_R10, 4)
    x64_alu_rr(&a.code, X64Alu.Add, X64_R10, X64_RSI)
    x64_load(&a.code, X64_RAX, X64_R10, 8)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_RAX, X64_R9)
    x64_image_jcc(&a, X64Cond.B, search_lower)
    x64_mov_rr(&a.code, X64_RDI, X64_RCX)
    x64_image_jmp(&a, search)
    x64_image_bind(&a, search_lower)
    x64_lea(&a.code, X64_RDX, X64_RCX, 1)
    x64_image_jmp(&a, search)
    x64_image_bind(&a, search_done)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_RDX, ranges.len() /% 2)
    x64_image_jcc(&a, X64Cond.AE, literal)
    x64_shift_ri(&a.code, X64Shift.Shl, X64_RDX, 4)
    x64_alu_rr(&a.code, X64Alu.Add, X64_RDX, X64_RSI)
    x64_load(&a.code, X64_RAX, X64_RDX, 0)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_RAX, X64_R9)
    x64_image_jcc(&a, X64Cond.BE, unicode)
    x64_image_jmp(&a, literal)
    x64_image_bind(&a, short)
    x64_mov_ri(&a.code, X64_RDX, 92)
    x64_store_u8(&a.code, X64_R15, 0, X64_RDX)
    x64_store_u8(&a.code, X64_R15, 1, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 2)
    x64_image_jmp(&a, next)
    x64_image_bind(&a, unicode)
    loop (index, byte) in "\\u{{".bytes() {
        x64_mov_ri(&a.code, X64_RAX, Int.from_u8(byte))
        x64_store_u8(&a.code, X64_R15, index, X64_RAX)
    }
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 3)
    x64_mov_ri(&a.code, X64_RCX, 20)
    x64_image_bind(&a, hex_start)
    x64_mov_rr(&a.code, X64_RAX, X64_R9)
    x64_shift_cl(&a.code, X64Shift.Shr, X64_RAX)
    x64_test_rr(&a.code, X64_RAX, X64_RAX)
    x64_image_jcc(&a, X64Cond.NE, hex)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RCX, 4)
    x64_image_jmp(&a, hex_start)
    x64_image_bind(&a, hex)
    x64_mov_rr(&a.code, X64_RAX, X64_R9)
    x64_shift_cl(&a.code, X64Shift.Shr, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.And, X64_RAX, 15)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_RAX, 10)
    x64_image_jcc(&a, X64Cond.B, hex_digit)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RAX, 87)
    x64_image_jmp(&a, hex_store)
    x64_image_bind(&a, hex_digit)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RAX, 48)
    x64_image_bind(&a, hex_store)
    x64_store_u8(&a.code, X64_R15, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 1)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RCX, 4)
    x64_image_jcc(&a, X64Cond.NS, hex)
    x64_mov_ri(&a.code, X64_RAX, 125)
    x64_store_u8(&a.code, X64_R15, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 1)
    x64_image_jmp(&a, next)
    x64_image_bind(&a, literal)
    x64_mov_rr(&a.code, X64_R10, X64_R12)
    x64_mov_rr(&a.code, X64_RCX, X64_R8)
    x64_image_bind(&a, copy_loop)
    x64_load_u8(&a.code, X64_RAX, X64_R10, 0)
    x64_store_u8(&a.code, X64_R15, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R10, 1)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 1)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RCX, 1)
    x64_image_jcc(&a, X64Cond.NE, copy_loop)
    x64_image_bind(&a, next)
    x64_alu_rr(&a.code, X64Alu.Add, X64_R12, X64_R8)
    x64_alu_rr(&a.code, X64Alu.Sub, X64_R13, X64_R8)
    x64_image_jmp(&a, top)
    x64_image_bind(&a, done)
    x64_mov_ri(&a.code, X64_RAX, 34)
    x64_store_u8(&a.code, X64_R15, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 1)
    x64_alu_rr(&a.code, X64Alu.Sub, X64_R15, X64_R14)
    x64_lea(&a.code, X64_RAX, X64_R15, -8)
    x64_store(&a.code, X64_R14, 0, X64_RAX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_R15, 4095)
    x64_alu_ri(&a.code, X64Alu.And, X64_R15, -4096)
    x64_load(&a.code, X64_RSI, X64_RSP, 0)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RSI, 4095)
    x64_alu_ri(&a.code, X64Alu.And, X64_RSI, -4096)
    x64_alu_rr(&a.code, X64Alu.Sub, X64_RSI, X64_R15)
    x64_image_jcc(&a, X64Cond.E, returned)
    x64_mov_rr(&a.code, X64_RDI, X64_R14)
    x64_alu_rr(&a.code, X64Alu.Add, X64_RDI, X64_R15)
    x64_mov_ri(&a.code, X64_RDX, 8)
    x64_image_call(&a, "jet_rt_free")
    x64_image_bind(&a, returned)
    x64_mov_rr(&a.code, X64_RAX, X64_R14)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RSP, 16)
    index := saved.len() - 1
