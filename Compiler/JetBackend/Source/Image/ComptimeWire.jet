// Lossless native value transport. Only canonical compiler-owned descriptors
// may reach these readers; addresses are child-local borrowed storage.
use jet_foundation.[foundation_json_quote]
use core.encoding.json as execution_json

struct X64ClosureValueLayout {
    snapshot: String
    function: String
    boundary: X64ValueBoundary
    captures: [X64ValueMember]
}
struct X64ClosureRegistration {
    offset: Int
    layout: X64ClosureValueLayout
}

struct X64NativeValue {
    kind: String
    attributes: [String]
    text: String
    children: [X64NativeValue]
}
