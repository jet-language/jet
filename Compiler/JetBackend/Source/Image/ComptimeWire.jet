// The wire between the compiler and the comptime child (JetRuntime
// ComptimeServe.jet): frames of eight little-endian words, the first the
// frame's kind, and the seccomp program that refuses a comptime run's
// effects. The child serves; the compiler reads and writes its memory.

// Compiler -> child commands.
X64_COMPTIME_CALL :: 1
X64_COMPTIME_READ :: 2
X64_COMPTIME_WRITE :: 3
X64_COMPTIME_ALLOC :: 4
X64_COMPTIME_TEXT :: 5
X64_COMPTIME_INT :: 6
X64_COMPTIME_RETURN :: 7
X64_COMPTIME_EXIT :: 8
X64_COMPTIME_FILTER :: 9
X64_COMPTIME_MAP :: 10
X64_COMPTIME_PROTECT :: 11

// Child -> compiler replies.
X64_COMPTIME_HELLO :: 0
X64_COMPTIME_DONE :: 1
X64_COMPTIME_HOST :: 2
X64_COMPTIME_STOP :: 3
X64_COMPTIME_REFUSED :: 4

X64_COMPTIME_FRAME_BYTES :: 64

// Host route kinds (JetIR ir_host_route): a compiler value's method or
// field, a comptime input; and a call of a runtime export the image lacks,
// whose one operand is the String of the symbol (JetEval IR/Native.jet).
X64_COMPTIME_HOST_METHOD :: 1
X64_COMPTIME_HOST_FIELD :: 2
X64_COMPTIME_HOST_INPUT :: 3
X64_COMPTIME_HOST_MISSING :: 4

// Stop kinds (JetRuntime Trap.jet's comptime_serve_stop calls): a message
// (data, length), a shift (count, count unsigned, bits), a list bound
// (length, index), a require stop (kind, message, left, right).
X64_COMPTIME_STOP_MESSAGE :: 1
X64_COMPTIME_STOP_SHIFT :: 2
X64_COMPTIME_STOP_LIST_BOUNDS :: 3
X64_COMPTIME_STOP_REQUIRE :: 4

// The descriptors the child serves on.
X64_COMPTIME_COMMAND_FD :: 3
X64_COMPTIME_REPLY_FD :: 4

// One frame: `kind` and up to seven operands.
fn x64_comptime_frame(kind: Int, operands: [Int]) -> [U8] Never! {
    bytes := [U8]{}
    x64_comptime_put_word(&bytes, kind)
    loop index in 0..<7 {
        x64_comptime_put_word(&bytes, if index < operands.len() -> operands[index] else -> 0)
    }
    bytes
}

fn x64_comptime_put_word(bytes: &[U8], value: Int) Never! {
    bits := if value < 0 -> value + 18446744073709551616 else -> value
    loop _ in 0..<8 {
        &bytes.push(U8{bits.bit_and(255)})
        bits = bits >> 8
    }
}

// The signed word of the eight bytes at `at`.
fn x64_comptime_word(bytes: [U8], at: Int) -> Int Never! {
    value := 0
    index := 7
    loop index >= 0 {
        value = value * 256 + Int.from_u8(bytes[at + index])
        index -= 1
    }
    if value >= 9223372036854775808 -> value - 18446744073709551616 else -> value
}

// The unsigned little-endian value of `width` bytes at `at`.
fn x64_comptime_unsigned(bytes: [U8], at: Int, width: Int) -> Int Never! {
    value := 0
    index := width - 1
    loop index >= 0 {
        value = value * 256 + Int.from_u8(bytes[at + index])
        index -= 1
    }
    value
}

// The system calls a comptime run makes freely: memory, threads and their
// waits, its own identity, and the exits. Reading the command descriptor,
// writing the reply descriptor and standard error (and, for a run that is
// not compile-time evaluation, standard output) are checked by descriptor;
// every other call traps to the refusal handler.
X64_COMPTIME_ALLOWED :: prep { [Int]{9, 10, 11, 12, 14, 15, 16, 24, 25, 28, 39, 56, 60, 131, 158, 186, 200, 202, 218, 231, 234, 273, 334, 435} }

// One classic BPF instruction and its symbolic jump targets (-1: next).
struct X64ComptimeBpf {
    code: Int
    k: Int
    jt: Int
    jf: Int
}

X64_BPF_LD_W_ABS :: 32
X64_BPF_JEQ_K :: 21
X64_BPF_RET_K :: 6
X64_SECCOMP_RET_ALLOW :: 2147418112
X64_SECCOMP_RET_TRAP :: 196608
X64_SECCOMP_RET_KILL_PROCESS :: 2147483648
X64_AUDIT_ARCH_X86_64 :: 3221225534

// The seccomp program of a comptime child; `stdout` admits writes to
// standard output (a fn-build or fn-dev invocation, whose output is its own).
fn x64_comptime_filter(stdout: Bool) -> [U8] Never! {
    // Labels are instruction indices, fixed by this layout; classic BPF
    // jumps only forward, so each check ends in its own trap.
    allowed :: X64_COMPTIME_ALLOWED
    trap :: 7 + allowed.len()
    read_check :: trap + 1
    write_check :: read_check + 3
    fds := [Int]{X64_COMPTIME_REPLY_FD, 2}
    if stdout -> &fds.push(1)
    allow :: write_check + 1 + fds.len() + 1
    program := [X64ComptimeBpf]{
        X64ComptimeBpf{code: X64_BPF_LD_W_ABS, k: 4, jt: -1, jf: -1},
        X64ComptimeBpf{code: X64_BPF_JEQ_K, k: X64_AUDIT_ARCH_X86_64, jt: 3, jf: 2},
        X64ComptimeBpf{code: X64_BPF_RET_K, k: X64_SECCOMP_RET_KILL_PROCESS, jt: -1, jf: -1},
        X64ComptimeBpf{code: X64_BPF_LD_W_ABS, k: 0, jt: -1, jf: -1},
        X64ComptimeBpf{code: X64_BPF_JEQ_K, k: 0, jt: read_check, jf: 5},
        X64ComptimeBpf{code: X64_BPF_JEQ_K, k: 1, jt: write_check, jf: 6},
        X64ComptimeBpf{code: X64_BPF_JEQ_K, k: 20, jt: write_check, jf: 7},
    }
    loop (index, number) in allowed {
        &program.push(X64ComptimeBpf{code: X64_BPF_JEQ_K, k: number, jt: allow, jf: 8 + index})
    }
    &program.push(X64ComptimeBpf{code: X64_BPF_RET_K, k: X64_SECCOMP_RET_TRAP, jt: -1, jf: -1})
    // read: only the command descriptor.
    &program.push(X64ComptimeBpf{code: X64_BPF_LD_W_ABS, k: 16, jt: -1, jf: -1})
    &program.push(X64ComptimeBpf{code: X64_BPF_JEQ_K, k: X64_COMPTIME_COMMAND_FD, jt: allow, jf: read_check + 2})
    &program.push(X64ComptimeBpf{code: X64_BPF_RET_K, k: X64_SECCOMP_RET_TRAP, jt: -1, jf: -1})
    // write, writev: the reply descriptor, standard error and, admitted,
    // standard output.
    &program.push(X64ComptimeBpf{code: X64_BPF_LD_W_ABS, k: 16, jt: -1, jf: -1})
    loop (index, fd) in fds {
        &program.push(X64ComptimeBpf{code: X64_BPF_JEQ_K, k: fd, jt: allow, jf: write_check + 2 + index})
    }
    &program.push(X64ComptimeBpf{code: X64_BPF_RET_K, k: X64_SECCOMP_RET_TRAP, jt: -1, jf: -1})
    &program.push(X64ComptimeBpf{code: X64_BPF_RET_K, k: X64_SECCOMP_RET_ALLOW, jt: -1, jf: -1})
    if program.len() != allow + 1 -> panic("comptime seccomp layout: allow is {allow}, the program has {program.len()} instructions")
    x64_comptime_bpf_bytes(program)
}

// Encodes `program`: a jump target becomes its offset past the next
// instruction.
fn x64_comptime_bpf_bytes(program: [X64ComptimeBpf]) -> [U8] Never! {
    bytes := [U8]{}
    loop (at, row) in program {
        jt :: if row.jt < 0 -> 0 else -> row.jt - at - 1
        jf :: if row.jf < 0 -> 0 else -> row.jf - at - 1
        if jt < 0 || jt > 255 || jf < 0 || jf > 255 -> panic("comptime seccomp jump out of range at {at}")
        &bytes.push(U8{row.code.bit_and(255)})
        &bytes.push(U8{(row.code >> 8).bit_and(255)})
        &bytes.push(U8{jt})
        &bytes.push(U8{jf})
        loop shift in 0..<4 -> &bytes.push(U8{(row.k >> (8 * shift)).bit_and(255)})
    }
    bytes
}
