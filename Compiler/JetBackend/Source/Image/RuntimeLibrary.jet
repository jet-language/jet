// The library feed consumes checked MIR in-process. Its exports are exactly
// the checked NativeLibrary artifact's `#Export(c)` rows; no list, name
// heuristic or source scan selects them. Compiler/JetRuntime/lifecycle.list
// only orders the constructor/destructor hooks among those exports.
use jet_foundation.[MIRProgram, MIRExport, MIRFunction, MIRFunctionID, MIRType, MIRCPrimitive, mir_c_primitive, mir_c_void, mir_type_display_name, foundation_json_quote]

struct CoreSharedRuntimeExportABI {
    symbol: String
    parameters: [LIRLayout]
    result: LIRLayout?
}

fn runtime_export_layout_json(layout: LIRLayout) -> String Never! {
    "{{\"size\":{layout.size},\"align\":{layout.align},\"class\":{foundation_json_quote(lir_abi_class_name(layout.class))}}}"
}

fn x64_runtime_export_abi_json(rows: [CoreSharedRuntimeExportABI]) -> String Never! {
    encoded := [String]{}
    loop row in rows {
        parameters :: loop layout in row.parameters -> runtime_export_layout_json(layout)
        result :: if row.result == .Val(layout) -> runtime_export_layout_json(layout) else -> "null"
        &encoded.push("{{\"symbol\":{foundation_json_quote(row.symbol)},\"parameters\":[{parameters.join(",")}],\"result\":{result}}}")
    }
    "[{encoded.join(",")}]"
}

struct X64RuntimeLibraryResult {
    object: X64ExecutableResult
    exports: [MIRExport]
    export_abis: [CoreSharedRuntimeExportABI]
}

struct RuntimeExportSpec {
    int_index_seam: Bool
    init_priority: Int
    fini_priority: Int
}


fn runtime_export_error(message: String) -> X64RuntimeLibraryResult Never! {
    runtime_export_errors([String]{message})
}

fn runtime_export_errors(messages: [String]) -> X64RuntimeLibraryResult Never! {
    X64RuntimeLibraryResult{object: X64ExecutableResult{bytes: [U8]{}, errors: messages}, exports: [MIRExport]{}, export_abis: [CoreSharedRuntimeExportABI]{}}
}

// The C primitives the native object writer lowers: integer words of every
// fixed width (narrow arguments are normalized at the export entry), Bool and
// F64. Text needs the JetText bridge and F32 has no native O0 lowering, so
// the writer refuses them by name rather than emitting a wrong C ABI.
fn runtime_export_native_type(ty: MIRType) -> String? {
    primitive :: mir_c_primitive(ty) ?? return Val("{mir_type_display_name(ty)} is not a C primitive")
    if primitive == {
        .Text -> Val("Text is not lowered by the native runtime object writer")
        .F32 -> Val("F32 is not lowered by the native runtime object writer")
        else -> None
    }
}

// The native object has no generated boundary, so an export is an
// infallible top-level C function: by-value primitive parameters and a
// primitive or void result. Every problem of the signature is listed.
fn runtime_export_signature_problems(function: MIRFunction) -> [String] Never! {
    problems := [String]{}
    if function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 {
        &problems.push("is not a monomorphic top-level function")
    }
    if function.failure != .Infallible -> &problems.push("has a failure carrier; a native C export is infallible")
    loop param in function.params {
        if param.access == .Write {
            &problems.push("parameter `{param.name}` is written; C exports take primitives by value")
            next
        }
        problem :: runtime_export_native_type(param.ty) ?? next
        &problems.push("parameter `{param.name}`: {problem}")
    }
    if !mir_c_void(function.return_type) {
        if runtime_export_native_type(function.return_type) == .Val(problem) -> &problems.push("result: {problem}")
    }
    problems
}

enum RuntimeIntrinsicShape {
    FloatBits
    FloatFromBits
    FunctionAddress(symbol: String, arity: Int)
    StaticText
}

struct RuntimeIntrinsicSpec {
    name: String
    shape: RuntimeIntrinsicShape
}

// One reviewed recognizer table; every address row uses the same I64-only
// target validation and existing FunctionAddress lowering.
fn runtime_intrinsic_specs() -> [RuntimeIntrinsicSpec] Never! {
    [RuntimeIntrinsicSpec]{
        RuntimeIntrinsicSpec{name: "rt_f64_bits", shape: .FloatBits},
        RuntimeIntrinsicSpec{name: "rt_f64_from_bits", shape: .FloatFromBits},
        RuntimeIntrinsicSpec{name: "rt_static_text", shape: .StaticText},
        RuntimeIntrinsicSpec{name: "rt_thread_entry_address", shape: .FunctionAddress{symbol: "jet_rt_thread_entry", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_tls_shared_destructor_address", shape: .FunctionAddress{symbol: "jet_rt_tls_shared_destructor", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_layout_registry_drop_address", shape: .FunctionAddress{symbol: "jet_rt_layout_registry_drop", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_scheduler_worker_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_worker", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_scheduler_timer_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_timer", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_observe_writer_address", shape: .FunctionAddress{symbol: "jet_rt_observe_writer", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_parallel_worker_address", shape: .FunctionAddress{symbol: "jet_rt_native_para_worker", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_task_exit_destructor_address", shape: .FunctionAddress{symbol: "jet_rt_task_exit_destructor", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_test_capture_abort_address", shape: .FunctionAddress{symbol: "jet_rt_test_capture_abort", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_test_suite_state_drop_address", shape: .FunctionAddress{symbol: "jet_rt_test_suite_state_drop", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_fault_allocation_drop_address", shape: .FunctionAddress{symbol: "jet_rt_fault_allocation_drop", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_crypto_entropy_drop_address", shape: .FunctionAddress{symbol: "jet_rt_crypto_entropy_drop", arity: 2}},
        RuntimeIntrinsicSpec{name: "rt_world_monotonic_provider_address", shape: .FunctionAddress{symbol: "jet_rt_world_monotonic_provider", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_net_resolver_worker_address", shape: .FunctionAddress{symbol: "jet_rt_net_resolver_worker", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_net_poller_worker_address", shape: .FunctionAddress{symbol: "jet_rt_net_poller_worker", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_net_unix_connect_worker_address", shape: .FunctionAddress{symbol: "jet_rt_net_unix_connect_worker", arity: 1}},
        RuntimeIntrinsicSpec{name: "rt_process_execution_worker_address", shape: .FunctionAddress{symbol: "jet_rt_process_execution_worker", arity: 1}},
    }
}

// Runtime-only, ordinary Jet reference functions. A mismatched declaration
// never becomes an unchecked bitcast; normal lowering has no such override.
fn runtime_bitcast_signature(function: MIRFunction, to_bits: Bool) -> Bool Never! {
    if function.kind != .Jet || function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 || function.failure != .Infallible || function.params.len() != 1 {
        return false
    }
    param :: function.params[0]
    if param.access != .Read -> return false
    input_word := false
    output_word := false
    if param.ty.kind == .IntN(signed, bits) -> input_word = signed && bits == 64
    if function.return_type.kind == .IntN(signed, bits) -> output_word = signed && bits == 64
    if to_bits -> return param.ty.kind == .Float && output_word
    input_word && function.return_type.kind == .Float
}

fn runtime_address_signature(function: MIRFunction) -> Bool Never! {
    if function.kind != .Jet || function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 || function.failure != .Infallible || function.params.len() != 0 {
        return false
    }
    if function.return_type.kind == .IntN(signed, bits) -> return signed && bits == 64
    false
}

fn runtime_static_text_signature(function: MIRFunction) -> Bool Never! {
    if function.kind != .Jet || function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 || function.failure != .Infallible || function.params.len() != 1 -> return false
    if function.params[0].access != .Read || function.params[0].ty.kind != .String -> return false
    if function.return_type.kind == .IntN(signed, bits) -> return signed && bits == 64
    false
}


fn runtime_address_target_signature(function: MIRFunction, arity: Int) -> Bool Never! {
    if function.kind != .Jet || function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 || function.failure != .Infallible || function.params.len() != arity {
        return false
    }
    loop param in function.params {
        if param.access != .Read -> return false
        word := false
        if param.ty.kind == .IntN(signed, bits) -> word = signed && bits == 64
        if !word -> return false
    }
    output_word := false
    if function.return_type.kind == .IntN(signed, bits) -> output_word = signed && bits == 64
    output_word
}

// Ordered process-lifecycle hooks of the runtime object. Each row is
// `<symbol> init <priority>` or `<symbol> fini <priority>`; the symbol must be
// one of the checked `#Export(c)` rows and take no parameters and return
// nothing. The rows order constructors/destructors; they never select exports.
struct RuntimeLifecycle {
    init_priority: Int
    fini_priority: Int
}

fn runtime_lifecycle_rows(lines: [String], lifecycle: &[String:RuntimeLifecycle]) -> String? {
    loop line in lines {
        text :: line.trim()
        if text == "" || text.starts_with("#") -> next
        fields := [String]{}
        loop field in text.split(" ").to_list() {
            if field != "" -> &fields.push(field)
        }
        if fields.len() != 3 || (fields[1] != "init" && fields[1] != "fini") {
            return Val("invalid runtime lifecycle row `{text}`")
        }
        priority :: Int.parse(fields[2]) ?? return Val("invalid runtime lifecycle priority in `{text}`")
        if priority < 0 || priority > 65535 -> return Val("runtime lifecycle priority must be in 0..65535 in `{text}`")
        if lifecycle.get(fields[0]) != None -> return Val("duplicate runtime lifecycle row `{fields[0]}`")
        row :: if fields[1] == "init" -> RuntimeLifecycle{init_priority: priority, fini_priority: -1} else -> RuntimeLifecycle{init_priority: -1, fini_priority: priority}
        &lifecycle.add(fields[0], row).drop("checked absent above")
    }
    None
}

fn x64_runtime_library(program: MIRProgram, lifecycle_rows: [String]) -> X64RuntimeLibraryResult Never! {
    exports := [MIRExport]{}
    library := false
    loop artifact in program.artifacts {
        if artifact.kind != .NativeLibrary -> next
        library = true
        loop entry_row in artifact.exports -> &exports.push(entry_row)
    }
    if !library {
        return runtime_export_error("runtime feed requires a checked NativeLibrary artifact")
    }
    if exports.len() == 0 {
        return runtime_export_error("the checked NativeLibrary artifact has no #Export(c) functions")
    }
    rows := [U64:Int]{}
    loop (index, function) in program.functions {
        &rows.add(function.id.value, index).drop("checked function IDs are unique")
    }
    symbols := [String:Bool]{}
    functions := [U64:Bool]{}
    roots := [MIRFunctionID]{}
    // Every export problem is collected, so one run lists them all.
    problems := [String]{}
    loop entry_row in exports {
        if symbols.get(entry_row.symbol) != None {
            &problems.push("duplicate checked export symbol {entry_row.symbol}")
        } else {
            &symbols.add(entry_row.symbol, true).drop("checked absent above")
        }
        if functions.get(entry_row.function.value) != None {
            &problems.push("duplicate checked export function {entry_row.symbol}")
        } else {
            &functions.add(entry_row.function.value, true).drop("checked absent above")
        }
        if entry_row.abi != .C -> &problems.push("export {entry_row.symbol} is not a C export")
        index :: rows.get(entry_row.function.value) ?? {
            &problems.push("export {entry_row.symbol} names a missing checked function")
            next
        }
        loop problem in runtime_export_signature_problems(program.functions[index]) -> &problems.push("export {entry_row.symbol} {problem}")
        &roots.push(entry_row.function)
    }
    if problems.len() != 0 -> return runtime_export_errors(problems)
    lifecycle := [String:RuntimeLifecycle]{}
    if runtime_lifecycle_rows(lifecycle_rows, &lifecycle) == .Val(problem) -> return runtime_export_error(problem)
    hooked := 0
    loop entry_row in exports {
        if lifecycle.get(entry_row.symbol) == None -> next
        hooked += 1
        index :: rows.get(entry_row.function.value) ?? return runtime_export_error("runtime lifecycle export {entry_row.symbol} is missing")
        function :: program.functions[index]
        if function.params.len() != 0 || !mir_c_void(function.return_type) {
            return runtime_export_error("runtime lifecycle export {entry_row.symbol} must take no parameters and return nothing")
        }
    }
    if hooked != lifecycle.len() -> return runtime_export_error("a runtime lifecycle row names no checked #Export(c) function")
    intrinsics := [U64:LowerRuntimeIntrinsic]{}
    bits := MIRFunctionID?{None}
    from_bits := MIRFunctionID?{None}
    loop spec in runtime_intrinsic_specs() {
        selected := MIRFunctionID?{None}
        loop function in program.functions {
            if function.name != spec.name -> next
            if selected != None {
                return runtime_export_error("ambiguous checked runtime intrinsic {spec.name}")
            }
            selected = Val(function.id)
            if spec.shape == {
                .StaticText -> {
                    if !runtime_static_text_signature(function) -> return runtime_export_error("runtime intrinsic rt_static_text must read one String and return I64")
                    &intrinsics.add(function.id.value, LowerRuntimeIntrinsic.StaticText).drop("unique checked static-text intrinsic ID")
                }
                .FloatBits | .FloatFromBits -> {
                    to_bits :: spec.shape == .FloatBits
                    if !runtime_bitcast_signature(function, to_bits) {
                        return runtime_export_error("runtime bitcast {spec.name} has an invalid checked scalar signature")
                    }
                    if to_bits -> bits = Val(function.id) else -> from_bits = Val(function.id)
                    &intrinsics.add(function.id.value, if to_bits -> LowerRuntimeIntrinsic.FloatBits else -> LowerRuntimeIntrinsic.FloatFromBits).drop("unique checked bitcast ID")
                }
                .FunctionAddress(symbol, arity) -> {
                    if !runtime_address_signature(function) {
                        return runtime_export_error("runtime intrinsic {spec.name} has an invalid checked scalar signature")
                    }
                    target := MIRFunctionID?{None}
                    loop entry_row in exports {
                        if entry_row.symbol != symbol -> next
                        index :: rows.get(entry_row.function.value) ?? return runtime_export_error("runtime address target {symbol} is missing")
                        if entry_row.abi != .C || !runtime_address_target_signature(program.functions[index], arity) {
                            return runtime_export_error("runtime address target {symbol} must export an infallible C function with {arity} I64 parameters and an I64 result")
                        }
                        target = Val(entry_row.function)
                    }
                    target_id :: target ?? return runtime_export_error("runtime intrinsic {spec.name} requires #Export(c) {symbol}")
                    &intrinsics.add(function.id.value, LowerRuntimeIntrinsic.FunctionAddress{function: target_id}).drop("unique checked address intrinsic ID")
                }
            }
        }
    }
    if (bits == .None) != (from_bits == .None) {
        return runtime_export_error("runtime bitcast definitions must be present as one validated pair")
    }
    lowered :: lir_lower_runtime_callables(program, roots, ^intrinsics)
    if lowered.issues.len() > 0 {
        errors :: loop issue in lowered.issues -> "{issue.function}\t{issue.message}"
        return X64RuntimeLibraryResult{object: X64ExecutableResult{bytes: [U8]{}, errors: errors}, exports: exports, export_abis: [CoreSharedRuntimeExportABI]{}}
    }
    globals := [X64RuntimeExport]{}
    export_abis := [CoreSharedRuntimeExportABI]{}
    loop entry_row in exports {
        function :: lowered.callables.get(entry_row.function.value) ?? return runtime_export_error("export {entry_row.symbol} has no lowered callable")
        hook :: lifecycle.get(entry_row.symbol) ?? RuntimeLifecycle{init_priority: -1, fini_priority: -1}
        &globals.push(X64RuntimeExport{function: function, symbol: entry_row.symbol, init_priority: hook.init_priority, fini_priority: hook.fini_priority})
        signature :: lowered.lir.signatures[lowered.lir.functions[function.value].signature.value]
        if signature.convention != .SystemV -> return runtime_export_error("export {entry_row.symbol} has no SystemV C signature")
        &export_abis.push(CoreSharedRuntimeExportABI{symbol: entry_row.symbol, parameters: signature.params, result: signature.result})
    }
    &export_abis.sort_by((a: CoreSharedRuntimeExportABI, b: CoreSharedRuntimeExportABI) -> a.symbol <=> b.symbol)
    // The shared runtime is a build artifact: use the canonical O1 pipeline.
    // It preserves callable IDs/signatures, so audited exports still name the
    // same functions. x64_runtime_object lints the optimized module again.
    optimized :: lir_optimize_module(lowered.lir, 1)
    X64RuntimeLibraryResult{object: x64_runtime_object(optimized, globals), exports: exports, export_abis: export_abis}
}
