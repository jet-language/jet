// Canonical Core source schema. Physical facts come only from ordinary lowering;
// linked code addresses belong to the separate binding, never to this digest.
use core.crypto as core_shared_crypto
use jet_foundation.[MIRFunctionID, MIRProgram, MIRSharedLifetime, MIRType, MIRTypeKind, foundation_json_quote, mir_program_digest, mir_shared_site_getter_symbol, mir_type_display_name, mir_type_from_kind]

struct CoreSharedSource {
    module_owner_key: String
    path: String
    source: String
    owned_members: [String]
}
struct CoreSharedSiteSchema {
    canonical_site_key: String
    initializer_semantic_id: MIRFunctionID
    getter_canonical_symbol: String
    lifetime: MIRSharedLifetime
    payload_layout_key: String
}
struct CoreSharedLayoutMember {
    name: String
    offset: Int
    boxed: Bool
    type_key: String
    storage_type_key: String
}
struct CoreSharedLayoutVariant {
    name: String
    selector: Int
    box_size: Int
    named: Bool
    members: [CoreSharedLayoutMember]
}
struct CoreSharedNativeLayout {
    type_key: String
    nominal_key: String
    display_name: String
    representation: String
    kind: Int
    stride: Int
    payload_size: Int
    align: Int
    box_size: Int
    clone_identity: String
    drop_identity: String
    child_keys: [String]
    members: [CoreSharedLayoutMember]
    variants: [CoreSharedLayoutVariant]
}
struct CoreSharedManifest {
    namespace_owner_key: String
    seal: String
    sorted_sites: [CoreSharedSiteSchema]
    keyed_native_layout_inventory: [CoreSharedNativeLayout]
    digest: String
    errors: [String]
}
struct CoreSharedLayoutBuilder {
    rows: [String:Int]
    layouts: [CoreSharedNativeLayout]
    errors: [String]
    close_methods: [U64:[LowerCloseImpl]]
}

// Sort a local receipt copy; neither installed source order nor the caller's
// owned-member lists are changed. Length-framed JSON prevents delimiter aliases.
fn core_shared_source_seal(sources: [CoreSharedSource]) -> String Never! {
    ordered := sources.copy()
    ordered = loop fresh_item in ordered -> fresh_item
    &ordered.sort_by((a: CoreSharedSource, b: CoreSharedSource) -> (a.module_owner_key <=> b.module_owner_key).then(a.path <=> b.path))
    rows := [String]{}
    loop source in ordered {
        members := source.owned_members
        &members.sort()
        quoted :: loop member in members -> foundation_json_quote(member)
        &rows.push("[{foundation_json_quote(source.module_owner_key)},{foundation_json_quote(source.path)},{foundation_json_quote(source.source)},[{quoted.join(",")}]]")
    }
    core_shared_crypto.sha256("[\"<corelib>\",[{rows.join(",")}]]".bytes()).hex()
}

// The established lowering fingerprint uses semantic MIR nominal identities,
// never image rows. The qualified declaration key is also sealed in each row.
fn core_shared_layout_key(ty: MIRType) -> String Never! { lower_mono_fingerprint(ty) }
fn core_shared_layout_members(program: MIRProgram, state: &CoreSharedLayoutBuilder, members: [LowerMember]) -> [CoreSharedLayoutMember] Never! {
    result := [CoreSharedLayoutMember]{}
    loop member in members {
        key :: core_shared_layout_visit(program, &state, member.ty)
        storage_key :: core_shared_layout_visit(program, &state, lower_member_storage_type(member))
        &result.push(CoreSharedLayoutMember{name: member.name, offset: member.offset, boxed: member.boxed, type_key: key, storage_type_key: storage_key})
    }
    result
}
fn core_shared_layout_visit(program: MIRProgram, state: &CoreSharedLayoutBuilder, ty: MIRType) -> String Never! {
    key :: core_shared_layout_key(ty)
    if state.rows.get(key) != None -> return key
    at :: state.layouts.len()
    &state.rows.add(key, at).drop("checked absent above")
    size :: lower_size(program, ty)
    clone :: if lower_lazy_type_can_clone(program, ty) -> "lazy.clone:{key}" else -> ""
    drop :: if lower_needs_drop_index(program, state.close_methods, ty) -> "lazy.drop:{key}" else -> ""
    row := CoreSharedNativeLayout{type_key: key, nominal_key: "", display_name: mir_type_display_name(ty), representation: "", kind: lower_lazy_kind(program, ty), stride: lower_list_stride(program, ty), payload_size: size.size, align: size.align, box_size: lower_box_size(program, ty), clone_identity: clone, drop_identity: drop, child_keys: [String]{}, members: [CoreSharedLayoutMember]{}, variants: [CoreSharedLayoutVariant]{}}
    // Reserve before visiting owning/recursive nominal edges.
    &state.layouts.push(row)
    if lower_repr(program, ty) == {
        .Absent -> row.representation = "Absent"
        .Word -> row.representation = "Word"
        .ExactInt -> row.representation = "ExactInt"
        .Flag -> row.representation = "Flag"
        .FloatBits -> row.representation = "FloatBits"
        .Float32Bits -> row.representation = "Float32Bits"
        .Discriminant -> row.representation = "Discriminant"
        .Inline(_) -> row.representation = "Inline"
        .Boxed(_) -> row.representation = "Boxed"
        .Handle(drop_leaf, clone_leaf) -> row.representation = "Handle:{drop_leaf}:{clone_leaf}"
        .Unsupported(reason) -> &state.errors.push("native Core layout {key}: {reason}")
    }
    if ty.kind == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) | .List(inner) | .FixedList(inner, _) | .Option(inner) | .Shared(inner) -> {
            &row.child_keys.push(core_shared_layout_visit(program, &state, inner))
        }
        .Map(key_ty, value_ty) -> {
            &row.child_keys.push(core_shared_layout_visit(program, &state, key_ty))
            &row.child_keys.push(core_shared_layout_visit(program, &state, value_ty))
            entry :: lower_map_entry(ty) ?? panic("checked Map has no native entry tuple")
            row.members = core_shared_layout_members(program, &state, lower_inline_members(program, entry))
            // The entry tuple is an ordinary native layout row. Its stride is
            // required by codecs; never recompute it from member offsets.
            &row.child_keys.push(core_shared_layout_visit(program, &state, entry))
        }
        .Result(ok, error) -> {
            &row.child_keys.push(core_shared_layout_visit(program, &state, ok))
            &row.child_keys.push(core_shared_layout_visit(program, &state, error))
        }
        .Tuple(_) -> row.members = core_shared_layout_members(program, &state, lower_inline_members(program, ty))
        .Fn(signature) -> {
            loop parameter in signature.params -> &row.child_keys.push(core_shared_layout_visit(program, &state, parameter))
            if signature.ret == .Val(result) -> &row.child_keys.push(core_shared_layout_visit(program, &state, result))
        }
        .SendFn(parameters, result, _) -> {
            loop parameter in parameters -> &row.child_keys.push(core_shared_layout_visit(program, &state, parameter))
            if result == .Val(value) -> &row.child_keys.push(core_shared_layout_visit(program, &state, value))
        }
        else -> {}
    }
    if lower_type_def(program, ty) == .Val(definition) {
        row.nominal_key = definition.key
        if definition.kind == {
            .Alias(inner) | .Distinct(inner, _) -> &row.child_keys.push(core_shared_layout_visit(program, &state, inner))
            .Struct(_, _) -> row.members = core_shared_layout_members(program, &state, lower_inline_members(program, ty))
            .Enum(variants, _) -> {
                loop (index, variant) in variants {
                    members :: core_shared_layout_members(program, &state, lower_variant_members(program, definition, variant))
                    named :: if variant.payload == {.Named(_) -> true else -> false}
                    &row.variants.push(CoreSharedLayoutVariant{name: variant.name, selector: lower_discriminant(index), box_size: lower_enum_box_size(program, definition), named: named, members: members})
                }
            }
            else -> {}
        }
    }
    state.layouts[at] = row
    key
}
fn core_shared_lifetime_key(lifetime: MIRSharedLifetime) -> String Never! {
    if lifetime == {
        .Process -> "Process"
        .World -> "World"
        .Thread -> "Thread"
        .Attempt -> "Attempt"
    }
}
fn core_shared_member_json(member: CoreSharedLayoutMember) -> String Never! {
    "[{foundation_json_quote(member.name)},{member.offset},{member.boxed},{foundation_json_quote(member.type_key)},{foundation_json_quote(member.storage_type_key)}]"
}
fn core_shared_layout_json(row: CoreSharedNativeLayout) -> String Never! {
    children :: loop key in row.child_keys -> foundation_json_quote(key)
    members :: loop member in row.members -> core_shared_member_json(member)
    variants := [String]{}
    loop variant in row.variants {
        fields :: loop member in variant.members -> core_shared_member_json(member)
        &variants.push("[{foundation_json_quote(variant.name)},{variant.selector},{variant.box_size},{variant.named},[{fields.join(",")}]]")
    }
    "[{foundation_json_quote(row.type_key)},{foundation_json_quote(row.nominal_key)},{foundation_json_quote(row.display_name)},{foundation_json_quote(row.representation)},{row.kind},{row.stride},{row.payload_size},{row.align},{row.box_size},{foundation_json_quote(row.clone_identity)},{foundation_json_quote(row.drop_identity)},[{children.join(",")}],[{members.join(",")}],[{variants.join(",")}]]"
}
fn core_shared_manifest_body(manifest: CoreSharedManifest) -> String Never! {
    sites := [String]{}
    loop site in manifest.sorted_sites {
        &sites.push("[{foundation_json_quote(site.canonical_site_key)},{foundation_json_quote("{site.initializer_semantic_id.value}")},{foundation_json_quote(site.getter_canonical_symbol)},{foundation_json_quote(core_shared_lifetime_key(site.lifetime))},{foundation_json_quote(site.payload_layout_key)}]")
    }
    layouts :: loop row in manifest.keyed_native_layout_inventory -> core_shared_layout_json(row)
    "[\"CoreSharedManifest\",2,{foundation_json_quote(manifest.namespace_owner_key)},{foundation_json_quote(manifest.seal)},[{sites.join(",")}],[{layouts.join(",")}]]"
}

// The producer's source inventory must cover its complete checked Core recipe,
// not merely the modules reached by one importing user program. Installation
// prefixes are transport paths and therefore do not enter the canonical seal.
fn core_shared_source_inventory_errors(program: MIRProgram, sources: [CoreSharedSource]) -> [String] Never! {
    errors := [String]{}
    if sources.len() == 0 -> &errors.push("CoreSharedSourceInventoryMissing")
    paths := [String:Bool]{}
    owners := [String:Bool]{}
    loop source in sources {
        if !source.module_owner_key.starts_with("<corelib>") || !source.path.starts_with("Core/") || paths.get(source.path) != None || owners.get(source.module_owner_key) != None {
            &errors.push("CoreSharedSourceInventoryInvalid: {source.module_owner_key}: {source.path}")
        }
        paths[source.path] = true
        owners[source.module_owner_key] = true
        matches := 0
        loop file in program.source_files {
            if file.path == source.path || file.path.ends_with("/{source.path}") {
                matches += 1
                if file.source != source.source -> &errors.push("CoreSharedSourceBytesMismatch: {source.path}")
            }
        }
        if matches != 1 -> &errors.push("CoreSharedSourceRecipeMissing: {source.path}")
    }
    loop file in program.source_files {
        matches := 0
        loop source in sources { if file.path == source.path || file.path.ends_with("/{source.path}") -> matches += 1 }
        if matches != 1 -> &errors.push("CoreSharedSourceRecipeUnowned: {file.path}")
    }
    errors
}

// This schema walk never lowers an image, maps code, or calls a getter. A new
// compiler factory can compare checked semantic/physical facts before admission.
fn core_shared_expected_manifest(program: MIRProgram, sources: [CoreSharedSource]) -> CoreSharedManifest Never! {
    functions := [U64:Int]{}
    loop (row, function) in program.functions -> &functions.add(function.id.value, row).drop("checked function identity")
    state := CoreSharedLayoutBuilder{rows: [String:Int]{}, layouts: [CoreSharedNativeLayout]{}, errors: [String]{}, close_methods: lower_close_index(program, functions)}
    manifest := CoreSharedManifest{namespace_owner_key: "<corelib>", seal: core_shared_source_seal(sources), sorted_sites: [CoreSharedSiteSchema]{}, keyed_native_layout_inventory: [CoreSharedNativeLayout]{}, digest: "", errors: core_shared_source_inventory_errors(program, sources)}
    seen := [String:Int]{}
    loop definition in program.constants {
        if definition.value == .SharedSite(site) {
            site_key :: "shared-site:{site.initializer.value}"
            initializer := MIRFunctionID?{None}
            loop function in program.functions { if function.id == site.initializer -> initializer = Val(function.id) }
            if initializer == None -> &manifest.errors.push("CoreSharedInitializerMissing: {site_key}")
            if definition.ty.kind == .Shared(payload) {
                key :: core_shared_layout_visit(program, &state, payload)
                row :: CoreSharedSiteSchema{canonical_site_key: site_key, initializer_semantic_id: site.initializer, getter_canonical_symbol: mir_shared_site_getter_symbol(site.initializer), lifetime: site.lifetime, payload_layout_key: key}
                if seen.get(site_key) == Val(at) {
                    prior :: manifest.sorted_sites[at]
                    if prior.lifetime != row.lifetime || prior.payload_layout_key != row.payload_layout_key -> &manifest.errors.push("CoreSharedSiteInventoryInvalid: {site_key}")
                } else {
                    seen[site_key] = manifest.sorted_sites.len()
                    &manifest.sorted_sites.push(row)
                }
            } else {
                &manifest.errors.push("CoreSharedSitePayloadNotShared: {site_key}")
            }
        }
    }
    manifest.sorted_sites = loop fresh_item in manifest.sorted_sites -> fresh_item
    &manifest.sorted_sites.sort_by((a: CoreSharedSiteSchema, b: CoreSharedSiteSchema) -> a.canonical_site_key <=> b.canonical_site_key)
    state.layouts = loop fresh_item in state.layouts -> fresh_item
    &state.layouts.sort_by((a: CoreSharedNativeLayout, b: CoreSharedNativeLayout) -> a.type_key <=> b.type_key)
    manifest.keyed_native_layout_inventory = state.layouts
    loop error in state.errors -> &manifest.errors.push(error)
    if manifest.errors.len() == 0 -> manifest.digest = core_shared_crypto.sha256(core_shared_manifest_body(manifest).bytes()).hex()
    manifest
}

// A producing LIR must export exactly the schema computed from checked Core
// declarations. LIR IDs, offsets and pointers cannot influence that schema.
fn core_shared_manifest(program: MIRProgram, lowered: LIRLowering, sources: [CoreSharedSource]) -> CoreSharedManifest Never! {
    manifest := core_shared_expected_manifest(program, sources)
    loop issue in lowered.issues -> &manifest.errors.push("CoreSharedLoweringFailed: {issue.message}")
    seen := [String:Bool]{}
    loop exported in lowered.shared_sites {
        if seen.get(exported.site_key) != None -> &manifest.errors.push("CoreSharedSiteInventoryInvalid: {exported.site_key}")
        seen[exported.site_key] = true
        matched := false
        loop expected in manifest.sorted_sites {
            if expected.canonical_site_key == exported.site_key {
                matched = exported.initializer == expected.initializer_semantic_id && exported.symbol == expected.getter_canonical_symbol && exported.lifetime == expected.lifetime
                if exported.ty.kind == .Shared(payload) {
                    matched = matched && lower_mono_fingerprint(payload) == expected.payload_layout_key
                } else {
                    matched = false
                }
            }
        }
        if !matched -> &manifest.errors.push("CoreSharedSiteExportMismatch: {exported.site_key}")
    }
    loop expected in manifest.sorted_sites {
        if seen.get(expected.canonical_site_key) == None -> &manifest.errors.push("CoreSharedSiteExportMissing: {expected.canonical_site_key}")
    }
    if manifest.errors.len() != 0 -> manifest.digest = ""
    manifest
}

struct CoreSharedGetterBinding {
    canonical_site_key: String
    getter_canonical_symbol: String
    function: LIRFunctionID
    linked_offset: Int
}
struct CoreSharedCallableBinding {
    semantic_identity: String
    role: String
    type_key: String
    symbol: String
    function: LIRFunctionID
    signature: LIRSignature
    linked_offset: Int
}

struct CoreSharedBinding {
    manifest_digest: String
    source_seal: String
    producing_program: MIRProgram
    original_sources: [CoreSharedSource]
    producing_program_digest: String
    producer_identity: String
    compiled_image_sha: String
    image: X64MemoryImage
    getters: [CoreSharedGetterBinding]
    callables: [CoreSharedCallableBinding]
    callable_digest: String
    errors: [String]
}

fn core_shared_callable_rows_digest(rows: [CoreSharedCallableBinding]) -> String Never! {
    encoded := [String]{}
    loop row in rows {
        parameters :: loop layout in row.signature.params -> "[{layout.size},{layout.align},{foundation_json_quote(lir_abi_class_name(layout.class))}]"
        result :: if row.signature.result == .Val(layout) -> "[{layout.size},{layout.align},{foundation_json_quote(lir_abi_class_name(layout.class))}]" else -> "null"
        &encoded.push("[{foundation_json_quote(row.semantic_identity)},{foundation_json_quote(row.role)},{foundation_json_quote(row.type_key)},{foundation_json_quote(row.symbol)},{row.function.value},{row.signature.id.value},\"SystemV\",[{parameters.join(",")}],{result},{row.linked_offset}]")
    }
    core_shared_crypto.sha256("[{encoded.join(",")}]".bytes()).hex()
}

fn core_shared_callable_digest_error(rows: [CoreSharedCallableBinding], digest: String) -> String Never! {
    if digest != core_shared_callable_rows_digest(rows) -> "CoreSharedCallableBindingIdentityMismatch" else -> ""
}
fn core_shared_callable_required_error(rows: [CoreSharedCallableBinding], identity: String) -> String Never! {
    loop row in rows { if row.semantic_identity == identity -> return "" }
    "CoreSharedCallableBindingMissing: {identity}"
}

fn core_shared_callable_inventory_error(binding: CoreSharedBinding) -> String Never! {
    digest_error :: core_shared_callable_digest_error(binding.callables, binding.callable_digest)
    if digest_error != "" -> return digest_error
    seen := [String:Bool]{}
    symbols := [String:Bool]{}
    loop row in binding.callables {
        if row.role != "lazy.clone" && row.role != "lazy.drop" && row.role != "closure.code" && row.role != "closure.release" -> return "CoreSharedCallableBindingInvalid: {row.semantic_identity}"
        if row.signature.convention != .SystemV -> return "CoreSharedCallableSignatureMismatch: {row.semantic_identity}"
        if row.role != "closure.code" {
            count :: if row.role == "lazy.clone" -> 2 else -> 1
            if row.signature.params.len() != count || row.signature.result != None -> return "CoreSharedCallableSignatureMismatch: {row.semantic_identity}"
            loop parameter in row.signature.params {
                if parameter != lir_layout_pointer() -> return "CoreSharedCallableSignatureMismatch: {row.semantic_identity}"
            }
        }
        if seen.get(row.semantic_identity) != None -> return "CoreSharedClosureConcreteProvenanceGap: {row.semantic_identity}"
        seen[row.semantic_identity] = true
        if row.semantic_identity != "{row.role}:{row.type_key}" || row.symbol != "jet_core_callable_{row.function.value}" -> return "CoreSharedCallableBindingInvalid: {row.semantic_identity}"
        if row.function.value < 0 || row.function.value >= binding.image.functions.len() -> return "CoreSharedCallableBindingMissing: {row.semantic_identity}"
        if binding.image.functions[row.function.value] != row.linked_offset || binding.image.exports.get(row.symbol) != Val(row.linked_offset) -> return "CoreSharedCallableBindingIdentityMismatch"
        symbols[row.symbol] = true
    }
    if binding.image.exports.len() != binding.getters.len() + symbols.len() -> return "CoreSharedExportInventoryMismatch"
    ""
}

// Caller has already admitted/validated this binding; lookup never rehashes
// a complete compiler image while a physical payload permit is held.
fn core_shared_callable_binding(binding: CoreSharedBinding, identity: String) -> CoreSharedCallableBinding? Never! {
    loop row in binding.callables { if row.semantic_identity == identity -> return Val(row) }
    None
}

fn core_shared_binding(program: MIRProgram, lowered: LIRLowering, manifest: CoreSharedManifest, sources: [CoreSharedSource], producer_identity: String) -> CoreSharedBinding Never! {
    image :: x64_memory_core_shared_image(lowered)
    binding := CoreSharedBinding{manifest_digest: manifest.digest, source_seal: core_shared_source_seal(sources), producing_program: program, original_sources: sources, producing_program_digest: mir_program_digest(program), producer_identity: producer_identity, compiled_image_sha: core_shared_crypto.sha256(image.text).hex(), image: image, getters: [CoreSharedGetterBinding]{}, callables: [CoreSharedCallableBinding]{}, callable_digest: "", errors: manifest.errors}
    loop error in image.errors -> &binding.errors.push(error)
    if binding.source_seal != manifest.seal || manifest.digest != core_shared_crypto.sha256(core_shared_manifest_body(manifest).bytes()).hex() -> &binding.errors.push("CoreSharedManifestIdentityMismatch")
    if producer_identity == "" -> &binding.errors.push("CoreSharedProducerIdentityMissing")
    loop site in manifest.sorted_sites {
        found := false
        loop exported in lowered.shared_sites {
            if exported.site_key != site.canonical_site_key -> next
            offset :: image.exports.get(exported.symbol) ?? {
                &binding.errors.push("CoreSharedGetterBindingMissing: {exported.symbol}")
                next
            }
            if exported.function.value < 0 || exported.function.value >= image.functions.len() || image.functions[exported.function.value] != offset -> &binding.errors.push("CoreSharedGetterBindingInvalid: {exported.symbol}")
            &binding.getters.push(CoreSharedGetterBinding{canonical_site_key: exported.site_key, getter_canonical_symbol: exported.symbol, function: exported.function, linked_offset: offset})
            found = true
        }
        if !found -> &binding.errors.push("CoreSharedGetterBindingMissing: {site.canonical_site_key}")
    }
    loop row in lowered.core_callables {
        symbol :: "jet_core_callable_{row.function.value}"
        offset :: image.exports.get(symbol) ?? {
            &binding.errors.push("CoreSharedCallableBindingMissing: {row.semantic_identity}")
            next
        }
        function :: lowered.lir.functions[row.function.value]
        signature :: lir_signature(lowered.lir, function.signature) ?? {
            &binding.errors.push("CoreSharedCallableBindingMissing: {row.semantic_identity}")
            next
        }
        &binding.callables.push(CoreSharedCallableBinding{semantic_identity: row.semantic_identity, role: row.role, type_key: row.type_key, symbol: symbol, function: row.function, signature: signature, linked_offset: offset})
    }
    binding.callables = loop fresh_item in binding.callables -> fresh_item
    &binding.callables.sort_by((a: CoreSharedCallableBinding, b: CoreSharedCallableBinding) -> a.semantic_identity <=> b.semantic_identity)
    binding.callable_digest = core_shared_callable_rows_digest(binding.callables)
    error :: core_shared_callable_inventory_error(binding)
    if error != "" -> &binding.errors.push(error)
    binding
}

#Test("Core callable digest refuses a changed linked offset or signature") {
    row :: CoreSharedCallableBinding{semantic_identity: "lazy.drop:checked", role: "lazy.drop", type_key: "checked", symbol: "jet_core_callable_7", function: LIRFunctionID{value: 7}, signature: LIRSignature{id: LIRSignatureID{value: 3}, convention: .SystemV, params: [LIRLayout]{lir_layout_pointer()}, result: None}, linked_offset: 40}
    digest :: core_shared_callable_rows_digest([CoreSharedCallableBinding]{row})
    changed := row.copy()
    changed.linked_offset = 48
    assert_eq(core_shared_callable_digest_error([CoreSharedCallableBinding]{changed}, digest), "CoreSharedCallableBindingIdentityMismatch")
    changed = row.copy()
    changed.signature.params = [LIRLayout]{lir_layout_word()}
    assert_eq(core_shared_callable_digest_error([CoreSharedCallableBinding]{changed}, digest), "CoreSharedCallableBindingIdentityMismatch")
}

#Test("an absent emitted clone or drop callable is a named refusal") {
    rows :: [CoreSharedCallableBinding]{}
    assert_eq(core_shared_callable_required_error(rows, "lazy.clone:checked"), "CoreSharedCallableBindingMissing: lazy.clone:checked")
    assert_eq(core_shared_callable_required_error(rows, "lazy.drop:checked"), "CoreSharedCallableBindingMissing: lazy.drop:checked")
}

#Test("canonical member storage identity participates in the sealed row") {
    member :: CoreSharedLayoutMember{name: "byte", offset: 8, boxed: true, type_key: "integer:false:8", storage_type_key: "option:15:integer:false:8"}
    encoded :: core_shared_member_json(member)
    assert_eq(encoded, "[\"byte\",8,true,\"integer:false:8\",\"option:15:integer:false:8\"]")
    changed := member.copy()
    changed.storage_type_key = member.type_key
    assert(core_shared_member_json(changed) != encoded)
}

#Test("canonical absent-payload display name participates in the sealed row") {
    ty :: mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 8})
    row :: CoreSharedNativeLayout{type_key: lower_mono_fingerprint(ty), nominal_key: "", display_name: mir_type_display_name(ty), representation: "Word", kind: (3).bit_or((8 << 32)), stride: 1, payload_size: 1, align: 1, box_size: 0, clone_identity: "", drop_identity: "", child_keys: [String]{}, members: [CoreSharedLayoutMember]{}, variants: [CoreSharedLayoutVariant]{}}
    encoded :: core_shared_layout_json(row)
    changed := row.copy()
    changed.display_name = "another display name"
    assert(core_shared_layout_json(changed) != encoded)
}
