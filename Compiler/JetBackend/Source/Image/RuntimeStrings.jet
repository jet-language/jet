// String carriers remain private to each runtime. These static implementations
// use [byte length with static flag: word][UTF-8 bytes]; hosted exports borrow
// Box<String> and do not yet accept immutable module String carriers.

// Rust String ordering is unsigned lexicographic bytes, not length-first.
// MIRRust.rs:19994-19999 emits the Rust comparison operators.
fn x64_image_string_compare() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    top :: x64_image_label(&a)
    lengths :: x64_image_label(&a)
    less :: x64_image_label(&a)
    greater :: x64_image_label(&a)
    x64_load(&a.code, X64_R8, X64_RDI, 0)
    x64_load(&a.code, X64_R9, X64_RSI, 0)
    x64_image_string_length(&a.code, X64_R8)
    x64_image_string_length(&a.code, X64_R9)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RDI, 8)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RSI, 8)
    x64_image_bind(&a, top)
    x64_test_rr(&a.code, X64_R8, X64_R8)
    x64_image_jcc(&a, X64Cond.E, lengths)
    x64_test_rr(&a.code, X64_R9, X64_R9)
    x64_image_jcc(&a, X64Cond.E, lengths)
    x64_load_u8(&a.code, X64_RAX, X64_RDI, 0)
    x64_load_u8(&a.code, X64_RDX, X64_RSI, 0)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_RAX, X64_RDX)
    x64_image_jcc(&a, X64Cond.B, less)
    x64_image_jcc(&a, X64Cond.A, greater)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RDI, 1)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RSI, 1)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_R8, 1)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_R9, 1)
    x64_image_jmp(&a, top)
    x64_image_bind(&a, lengths)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_R8, X64_R9)
    x64_image_jcc(&a, X64Cond.B, less)
    x64_image_jcc(&a, X64Cond.A, greater)
    x64_mov_ri(&a.code, X64_RAX, 0)
    x64_ret(&a.code)
    x64_image_bind(&a, less)
    x64_mov_ri(&a.code, X64_RAX, -1)
    x64_ret(&a.code)
    x64_image_bind(&a, greater)
    x64_mov_ri(&a.code, X64_RAX, 1)
    x64_ret(&a.code)
    x64_image_finish(&a, "jet_rt_string_compare")
}

// Core.rs:3307 jet_char_len counts Unicode scalar values, not UTF-8 bytes.
// Valid UTF-8 has one scalar for every non-continuation byte.
fn x64_image_char_len() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    top :: x64_image_label(&a)
    next_byte :: x64_image_label(&a)
    done :: x64_image_label(&a)
    x64_load(&a.code, X64_RCX, X64_RDI, 0)
    x64_image_string_length(&a.code, X64_RCX)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RDI, 8)
    x64_mov_ri(&a.code, X64_RAX, 0)
    x64_image_bind(&a, top)
    x64_test_rr(&a.code, X64_RCX, X64_RCX)
    x64_image_jcc(&a, X64Cond.E, done)
    x64_load_u8(&a.code, X64_RDX, X64_RDI, 0)
    x64_alu_ri(&a.code, X64Alu.And, X64_RDX, 192)
    x64_alu_ri(&a.code, X64Alu.Cmp, X64_RDX, 128)
    x64_image_jcc(&a, X64Cond.E, next_byte)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RAX, 1)
    x64_image_bind(&a, next_byte)
    x64_alu_ri(&a.code, X64Alu.Add, X64_RDI, 1)
    x64_alu_ri(&a.code, X64Alu.Sub, X64_RCX, 1)
    x64_image_jmp(&a, top)
    x64_image_bind(&a, done)
    x64_ret(&a.code)
    x64_image_finish(&a, "jet_char_len")
}

fn x64_image_string_is_empty() -> X64CompiledFunction Never! {
    a := x64_image_asm()
    x64_load(&a.code, X64_RAX, X64_RDI, 0)
    x64_image_string_length(&a.code, X64_RAX)
    x64_test_rr(&a.code, X64_RAX, X64_RAX)
    x64_setcc(&a.code, X64Cond.E, X64_RAX)
    x64_movzx_r8(&a.code, X64_RAX, X64_RAX)
    x64_ret(&a.code)
    x64_image_finish(&a, "jet_string_is_empty")
}

// All three Rust str predicates match raw UTF-8 byte sequences. Empty patterns
// match, and a longer pattern never reads past the end of the receiver.
fn x64_image_string_predicate(symbol: String) -> X64CompiledFunction Never! {
    a := x64_image_asm()
    top :: x64_image_label(&a)
    yes :: x64_image_label(&a)
    no :: x64_image_label(&a)
    x64_load(&a.code, X64_R8, X64_RDI, 0)
    x64_load(&a.code, X64_RDX, X64_RSI, 0)
    x64_image_string_length(&a.code, X64_R8)
    x64_image_string_length(&a.code, X64_RDX)
    x64_test_rr(&a.code, X64_RDX, X64_RDX)
    x64_image_jcc(&a, X64Cond.E, yes)
    x64_alu_rr(&a.code, X64Alu.Cmp, X64_R8, X64_RDX)
    x64_image_jcc(&a, X64Cond.B, no)
    x64_alu_rr(&a.code, X64Alu.Sub, X64_R8, X64_RDX)
    x64_lea(&a.code, X64_R10, X64_RDI, 8)
    x64_lea(&a.code, X64_R9, X64_RSI, 8)
    if symbol == "jet_string_ends_with" -> x64_alu_rr(&a.code, X64Alu.Add, X64_R10, X64_R8)
    x64_image_bind(&a, top)
    x64_mov_rr(&a.code, X64_RDI, X64_R10)
    x64_mov_rr(&a.code, X64_RSI, X64_R9)
    x64_mov_rr(&a.code, X64_RCX, X64_RDX)
    x64_repe_cmpsb(&a.code)
    x64_image_jcc(&a, X64Cond.E, yes)
    if symbol == "jet_string_contains" {
        x64_test_rr(&a.code, X64_R8, X64_R8)
        x64_image_jcc(&a, X64Cond.E, no)
        x64_alu_ri(&a.code, X64Alu.Sub, X64_R8, 1)
        x64_alu_ri(&a.code, X64Alu.Add, X64_R10, 1)
        x64_image_jmp(&a, top)
    }
    x64_image_bind(&a, no)
    x64_mov_ri(&a.code, X64_RAX, 0)
    x64_ret(&a.code)
    x64_image_bind(&a, yes)
    x64_mov_ri(&a.code, X64_RAX, 1)
    x64_ret(&a.code)
    x64_image_finish(&a, symbol)
}
