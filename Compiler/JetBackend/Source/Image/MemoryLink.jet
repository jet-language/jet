// Binding a program to the prelinked runtime image (#4741). `jet run`,
// `jet dev` and compile-time code link a program's object against the
// runtime image its pack carries (Image/RuntimePack.jet
// x64_link_runtime_image) instead of relinking the runtime. The image's
// loaded bytes stay as they are but for a few patched bytes (its ELF header
// and its `main` places, its `.jet.bind` section, pointed at the program),
// the program goes on the pages after them, and the program's runtime
// imports resolve through the image's symbol table (by its `.jet.exports`
// index, RuntimePack.jet link_image_export_index). The result is a
// complete static executable at the image's base, the shape
// x64_link_executable writes (file offset equal to address minus the base,
// a debug tail with `.symtab` and section headers), held in parts
// (X64Executable): the image, the patches, and the program part. So
// Image/Loader.jet maps the image part from the pack file and copies in
// only the program part, and the file fallback writes the file and runs it
// as is.
//
// The program part, from the image's program base:
// - read-only: the program header table of the whole executable (the
//   image's segments, the program's, then the image's other entries: TLS,
//   GNU_STACK), the program's read-only data, its unwind tables;
// - code: the program's text and `__jet_bind_main`;
// - writable: read-only-after-relocation data, GOT, data, bss, commons.
// The image registers only its own unwind tables, the first time libgcc's
// unwinder asks for them (StaticLink.jet link_eh_shims): `__jet_bind_main`, the
// target of the image's `main` places, registers the program's with
// libgcc's `__register_frame_info` when the image links that unwinder, and
// tail-calls `main` with its arguments.
// A program this cannot bind gets errors, and the caller links it in full:
// thread-local data, init/fini arrays, an import the image does not define,
// or a definition of a runtime provider hook, whose calls the image already
// binds to its own.
use jet_foundation.[RUNTIME_PROVIDER_HOOKS]

// What binding reads from a runtime image.
LinkImageView: struct {
    base: Int,
    phoff: Int,
    phnum: Int,
    // End of the loaded bytes in the file.
    load_end: Int,
    program_base: Int,
    // The `main` places: address, relocation type, addend.
    sites: [Int],
    symtab_at: Int,
    symtab_count: Int,
    first_global: Int,
    strtab_at: Int,
    strtab_size: Int,
    // Headers 1 through alloc_headers describe the loaded sections.
    shoff: Int,
    alloc_headers: Int,
    names_at: Int,
    // The `.jet.exports` index (RuntimePack.jet link_image_export_index):
    // its slot table's offset and slot count, 0 slots when the image has none.
    exports_at: Int,
    exports_slots: Int,
}

link_image_u16: fn(bytes: [U8], at: Int) -> Int Never! {
    Int{bytes[at]} | (Int{bytes[at + 1]} << 8)
}

link_image_u32: fn(bytes: [U8], at: Int) -> Int Never! {
    link_image_u16(bytes, at) + link_image_u16(bytes, at + 2) * 0x10000
}

// A two's-complement 64-bit field.
link_image_i64: fn(bytes: [U8], at: Int) -> Int Never! {
    ^high: link_image_u32(bytes, at + 4)
    if high >= 0x80000000 -> high -= 0x100000000
    link_image_u32(bytes, at) + high * 0x100000000
}

// The index in the bytes read of file offset `at` of an image read without
// its bytes [gap_at, gap_at + gap) (Image/Loader.jet x64_image_file_read);
// -1 when `at` lies in that gap.
link_image_at: fn(at: Int, gap_at: Int, gap: Int) -> Int Never! {
    if {
        gap == 0 || at < gap_at -> at
        at < gap_at + gap -> -1
        else -> at - gap
    }
}

// Read the runtime image in buffer `b`, the image file without its bytes
// [gap_at, gap_at + gap) (none when gap is 0); errors are reported on `c`.
// The headers, the program header table and the sections the bind reads
// lie outside the gap; the view's offsets index `b`.
link_image_view: fn(c: ^LinkContext, b: Int, gap_at: Int, gap: Int) -> LinkImageView Never! {
    ^v: LinkImageView{base: -1, phoff: 0, phnum: 0, load_end: 0, program_base: 0, sites: [Int]{}, symtab_at: 0, symtab_count: 0, first_global: 0, strtab_at: 0, strtab_size: 0, shoff: 0, alloc_headers: 0, names_at: 0, exports_at: 0, exports_slots: 0}
    size: c.bufs[b].len()
    head: if gap == 0 -> size else -> gap_at
    if size < LINK_EHDR_SIZE || link_u32(c.bufs, b, 0) != 0x464c457f || link_u16(c.bufs, b, 16) != 2 || link_u16(c.bufs, b, 18) != 62 {
        link_error(c, "runtime image: not an x86-64 ELF executable")
        return v
    }
    v.phoff = link_s64(c.bufs, b, 32)
    v.phnum = link_u16(c.bufs, b, 56)
    v.shoff = link_image_at(link_s64(c.bufs, b, 40), gap_at, gap)
    shnum: link_u16(c.bufs, b, 60)
    shstrndx: link_u16(c.bufs, b, 62)
    if v.phoff < 0 || v.phoff + LINK_PHDR_SIZE * v.phnum > head || v.shoff < 0 || v.shoff + 64 * shnum > size || shstrndx >= shnum {
        link_error(c, "runtime image: truncated headers")
        return v
    }
    loop k in 0..<v.phnum {
        at: v.phoff + LINK_PHDR_SIZE * k
        if link_u32(c.bufs, b, at) != 1 -> next
        offset: link_s64(c.bufs, b, at + 8)
        if v.base < 0 -> v.base = link_s64(c.bufs, b, at + 16) - offset
        end: offset + link_s64(c.bufs, b, at + 32)
        if end > v.load_end -> v.load_end = end
    }
    v.names_at = link_image_at(link_s64(c.bufs, b, v.shoff + 64 * shstrndx + 24), gap_at, gap)
    if v.names_at < 0 {
        link_error(c, "runtime image: malformed section headers")
        return v
    }
    ^bind_at: -1
    ^bind_size: 0
    ^exports_at: -1
    ^exports_size: 0
    loop k in 1..<shnum {
        h: v.shoff + 64 * k
        if v.alloc_headers == k - 1 && (link_s64(c.bufs, b, h + 8) & 2) != 0 -> v.alloc_headers = k
        name: v.names_at + link_u32(c.bufs, b, h)
        if {
            link_u32(c.bufs, b, h + 4) == LINK_SHT_SYMTAB && v.symtab_count == 0 -> {
                strings_index: link_u32(c.bufs, b, h + 40)
                if strings_index < shnum {
                    symtab_at: link_image_at(link_s64(c.bufs, b, h + 24), gap_at, gap)
                    symtab_count: link_s64(c.bufs, b, h + 32).div_euclid(24)
                    first_global: link_u32(c.bufs, b, h + 44)
                    strings: v.shoff + 64 * strings_index
                    strtab_at: link_image_at(link_s64(c.bufs, b, strings + 24), gap_at, gap)
                    strtab_size: link_s64(c.bufs, b, strings + 32)
                    if symtab_at >= 0 && symtab_count >= 1 && symtab_at + 24 * symtab_count <= size && first_global >= 1 && first_global <= symtab_count && strtab_at >= 0 && strtab_size >= 1 && strtab_at + strtab_size <= size {
                        v.symtab_at = symtab_at
                        v.symtab_count = symtab_count
                        v.first_global = first_global
                        v.strtab_at = strtab_at
                        v.strtab_size = strtab_size
                    }
                }
            }
            link_name_has(c.bufs, b, name, LINK_IMAGE_BIND_SECTION, true) -> {
                bind_at = link_image_at(link_s64(c.bufs, b, h + 24), gap_at, gap)
                bind_size = link_s64(c.bufs, b, h + 32)
            }
            link_name_has(c.bufs, b, name, LINK_IMAGE_EXPORTS_SECTION, true) -> {
                exports_at = link_image_at(link_s64(c.bufs, b, h + 24), gap_at, gap)
                exports_size = link_s64(c.bufs, b, h + 32)
            }
            else -> {}
        }
    }
    if v.base < 0 || v.symtab_count == 0 || v.symtab_at < 0 || v.strtab_at < 0 || bind_at < 0 || bind_size < 24 || bind_at + bind_size > size || link_s64(c.bufs, b, bind_at) != LINK_IMAGE_BIND_MAGIC {
        link_error(c, "runtime image: no loaded segments, symbol table or `{LINK_IMAGE_BIND_SECTION}` section")
        return v
    }
    v.program_base = link_s64(c.bufs, b, bind_at + 8)
    count: link_s64(c.bufs, b, bind_at + 16)
    if count < 1 || 24 + 24 * count != bind_size || v.program_base < v.base + v.load_end {
        link_error(c, "runtime image: malformed `{LINK_IMAGE_BIND_SECTION}` section")
        return v
    }
    if exports_at >= 0 && exports_size >= 16 && exports_at + exports_size <= size && link_s64(c.bufs, b, exports_at) == LINK_IMAGE_EXPORTS_MAGIC {
        slots: link_s64(c.bufs, b, exports_at + 8)
        if slots < 1 || slots & slots - 1 != 0 || 16 + 4 * slots != exports_size {
            link_error(c, "runtime image: malformed `{LINK_IMAGE_EXPORTS_SECTION}` section")
            return v
        }
        v.exports_at = exports_at + 16
        v.exports_slots = slots
    }
    loop k in 0..<count {
        at: bind_at + 24 + 24 * k
        v.sites.push(link_s64(c.bufs, b, at))
        v.sites.push(link_s64(c.bufs, b, at + 8))
        v.sites.push(link_s64(c.bufs, b, at + 16))
    }
    v
}

// The image's global symbol defining `name` by its export index; -1 when
// the index has none. The name is compared in the image's string table, so
// an index entry can only miss, never bind a wrong symbol.
link_image_export: fn(c: LinkContext, view: LinkImageView, name: String) -> Int Never! {
    mask: view.exports_slots - 1
    ^slot: link_image_export_hash(name.bytes()) & mask
    loop _ in 0..<view.exports_slots {
        k: link_u32(c.bufs, 1, view.exports_at + 4 * slot)
        if k == 0 -> return -1
        if k >= view.first_global && k < view.symtab_count {
            at: view.symtab_at + 24 * k
            if link_u16(c.bufs, 1, at + 6) != 0 && link_name_has(c.bufs, 1, view.strtab_at + link_u32(c.bufs, 1, at), name, true) {
                return k
            }
        }
        slot = (slot + 1) & mask
    }
    -1
}

// Whether the image defines global `name`: by its export index, or by its
// global symbols for an image packed before the index.
link_image_defines: fn(c: LinkContext, view: LinkImageView, name: String) -> Bool Never! {
    if view.exports_slots > 0 -> return link_image_export(c, view, name) >= 0
    loop k in view.first_global..<view.symtab_count {
        at: view.symtab_at + 24 * k
        if link_u16(c.bufs, 1, at + 6) != 0 && link_name_has(c.bufs, 1, view.strtab_at + link_u32(c.bufs, 1, at), name, true) {
            return true
        }
    }
    false
}

// `__jet_bind_main(argc, argv, envp)`: when `frames`, register the
// program's unwind tables (`__jet_bind_eh`, defined at their address) with
// libgcc, then tail-call `main` with the arguments. An image without
// libgcc's unwinder has nothing that walks them, so its startup is the
// tail call alone.
link_bind_startup: fn(frames: Bool) -> LinkSynth Never! {
    ^s: link_synth()
    link_synth_function(s, "__jet_bind_main")
    if frames {
        // push rdi; push rsi; push rdx; lea rdi, [rip + __jet_bind_eh]
        link_synth_code(s, [Int]{0x57, 0x56, 0x52, 0x48, 0x8d, 0x3d})
        link_synth_rel32(s, "__jet_bind_eh", LINK_R_PC32)
        // lea rsi, [rip + __jet_bind_object]; call __register_frame_info
        link_synth_code(s, [Int]{0x48, 0x8d, 0x35})
        link_synth_rel32(s, "__jet_bind_object", LINK_R_PC32)
        link_synth_code(s, [Int]{0xe8})
        link_synth_rel32(s, "__register_frame_info", LINK_R_PLT32)
        // pop rdx; pop rsi; pop rdi
        link_synth_code(s, [Int]{0x5a, 0x5e, 0x5f})
    }
    // jmp main
    link_synth_code(s, [Int]{0xe9})
    link_synth_rel32(s, "main", LINK_R_PLT32)
    if frames {
        // libgcc's `object: struct` for the registered tables (at most 8 words).
        link_synth_define(s, "__jet_bind_object", 3, 0)
        s.bss = 128
    }
    s
}

// Lay the program out from the image's program base: the combined program
// header table, the part note of the program's zone sites when its code
// has any (StaticLink.jet link_zone_write), then its loaded sections.
link_bind_layout: fn(c: ^LinkContext, view: LinkImageView) -> LinkLayout Never! {
    order: link_order(c)
    ^commons: false
    loop g in 0..<c.g_name.len() {
        if c.g_kind[g] == LINK_G_COMMON -> commons = true
    }
    ^has_rw: c.got_keys.len() > 0 || commons
    loop class in LINK_RELRO..<LINK_CLASSES {
        if order[class].len() > 0 -> has_rw = true
    }
    sites: link_zone_count(c)
    phnum: view.phnum + 2 + (if has_rw -> 1 else -> 0) + (if sites > 0 -> 1 else -> 0)
    ^addr: view.program_base + LINK_PHDR_SIZE * phnum
    zone_note_at: if sites > 0 -> link_align(addr, 8) else -> 0
    if sites > 0 -> addr = zone_note_at + link_zone_note_size(sites)
    addr = link_place(c, order[LINK_RODATA], addr)
    r_end: link_place_eh(c, addr)
    text_start: link_align(r_end, LINK_PAGE)
    text_end: link_place(c, order[LINK_TEXT], text_start)
    rw_start: link_align(text_end, LINK_PAGE)
    addr = link_place(c, order[LINK_RELRO], rw_start)
    got_start: link_align(addr, 8)
    c.got_start = got_start
    addr = got_start + 8 * c.got_keys.len()
    file_end: link_place(c, order[LINK_DATA], addr)
    addr = link_place(c, order[LINK_BSS], file_end)
    loop g in 0..<c.g_name.len() {
        if c.g_kind[g] != LINK_G_COMMON -> next
        addr = link_align(addr, c.g_common_align[g])
        c.g_addr[g] = addr
        addr += c.g_common_size[g]
    }
    LinkLayout{
        order: order,
        phnum: phnum,
        r_end: r_end,
        text_start: text_start,
        text_end: text_end,
        rw_start: rw_start,
        file_end: if has_rw -> file_end else -> rw_start,
        mem_end: if has_rw -> addr else -> rw_start,
        has_rw: has_rw,
        has_tls: false,
        tdata_end: rw_start,
        init_start: rw_start,
        init_end: rw_start,
        fini_start: rw_start,
        fini_end: rw_start,
        preinit_start: rw_start,
        preinit_end: rw_start,
        bss_start: file_end,
        note_at: 0,
        zone_note_at: zone_note_at,
        zone_sites: sites,
        notes: [Int:Int]{},
        packed: false,
        rw_shift: 0,
    }
}

// The program part: the program header table, the zone-site part note,
// then the program's loaded bytes, at file offset `exe.tail_at` (the
// program base); the image part's `main` places bound to `target`. Returns
// the image's ELF header naming the combined program header table, for
// link_bind_sections to finish.
link_bind_write: fn(c: ^LinkContext, exe: ^X64Executable, view: LinkImageView, l: LinkLayout, target: Int) -> [U8] Never! {
    ^out: [U8]{}
    elf: link_bind_header(c, exe, out, view, l, target)
    link_zone_write(c, out, l, view.program_base)
    ^in_place: link_no_pieces()
    link_write_contents(c, out, l, view.program_base, in_place)
    exe.tail = out
    elf
}

// The image's ELF header naming the combined program header table of
// layout `l`, which goes to the end of `out` (the program part's start), and
// the patches of the image part's `main` places bound to `target` in `exe`;
// a place outside the image's loaded bytes or out of range is reported on `c`.
link_bind_header: fn(c: ^LinkContext, exe: ^X64Executable, out: ^[U8], view: LinkImageView, l: LinkLayout, target: Int) -> [U8] Never! {
    ^elf: c.bufs[1][0..<LINK_EHDR_SIZE]
    link_put64(elf, 32, view.program_base - c.base)
    elf[56] = U8{l.phnum & 255}
    elf[57] = U8{(l.phnum >> 8) & 255}
    loop k in 0..<view.sites.len().div_euclid(3) {
        address: view.sites[3 * k]
        kind: view.sites[3 * k + 1]
        addend: view.sites[3 * k + 2]
        at: address - c.base
        width: if kind == LINK_R_64 -> 8 else -> 4
        if at < LINK_EHDR_SIZE || at + width > view.load_end {
            link_error(c, "runtime image: a `main` place at {address} is outside its loaded bytes")
            next
        }
        value: if kind == LINK_R_64 -> target + addend else -> target + addend - address
        if kind != LINK_R_64 && !link_fits32(value) {
            link_error(c, "runtime image: `main` at {target} is out of rel32 range of {address}")
            next
        }
        ^bytes: [U8]{}
        if {
            kind == LINK_R_64 -> elf64_u64(bytes, value)
            else -> elf64_u32(bytes, value)
        }
        exe.patch_at.push(at)
        exe.patch_bytes.push(bytes)
    }
    loop k in 0..<view.phnum {
        at: view.phoff + LINK_PHDR_SIZE * k
        if link_u32(c.bufs, 1, at) == 1 -> out.extend(c.bufs[1][at..<at + LINK_PHDR_SIZE])
    }
    start: view.program_base
    link_phdr(out, start - c.base, 1, 4, start, l.r_end - start, l.r_end - start, LINK_PAGE)
    link_phdr(out, l.text_start - c.base, 1, 5, l.text_start, l.text_end - l.text_start, l.text_end - l.text_start, LINK_PAGE)
    if l.has_rw {
        link_phdr(out, l.rw_start - c.base, 1, 6, l.rw_start, l.file_end - l.rw_start, l.mem_end - l.rw_start, LINK_PAGE)
    }
    link_zone_phdr(out, l, c.base)
    loop k in 0..<view.phnum {
        at: view.phoff + LINK_PHDR_SIZE * k
        if link_u32(c.bufs, 1, at) != 1 -> out.extend(c.bufs[1][at..<at + LINK_PHDR_SIZE])
    }
    elf
}

// The debug tail, appended to `out`, the program part from file offset
// `origin`: the image's loaded-section headers, the program's sections and
// debug sections, then one `.symtab` holding the program's symbols (locals
// first), and the section headers, which `elf` names. The image's symbols
// are left out (link_bind_named_tail).
link_bind_sections: fn(c: ^LinkContext, out: ^[U8], origin: Int, view: LinkImageView, l: LinkLayout, debug: LinkDebug, elf: ^[U8]) Never! {
    ^headers: link_bind_image_headers(c, view)
    ^extents: [[Int]]{}
    loop class in 0..<LINK_CLASSES {
        ^extent: link_class_extent(c, l, class)
        if class == LINK_EH -> extent = [Int]{c.eh_start, c.eh_start + c.eh_size}
        if class == LINK_BSS {
            extent = if l.has_rw -> [Int]{l.bss_start, l.mem_end} else -> [Int]{0, 0}
        }
        extents.push(extent)
    }
    class_headers: link_bind_class_headers(headers, extents, c.got_start, c.got_keys.len(), c.base)
    ^in_place: link_no_pieces()
    sections: link_debug_bytes(c, debug, in_place, l.text_start, l.text_end)
    loop (group, name) in debug.names {
        start: out.len()
        out.extend(sections[group])
        headers.push(LinkSectionHeader{name: name, kind: LINK_SHT_PROGBITS, flags: 0, addr: 0, offset: origin + start, size: sections[group].len(), link: 0, info: 0, align: 1, entry_size: 0})
    }
    // The table starts with the empty name and the null symbol. The
    // program's local and global symbols are made apart first, their names
    // in `symbol_names` past the empty name.
    names_base: 1
    ^symbol_names: [U8]{}
    ^locals: [U8]{}
    loop obj in 0..<c.obj_name.len() {
        b: c.obj_buffer[obj].copy()
        loop k in 1..<c.obj_first_global[obj] {
            at: link_sym_at(c, obj, k)
            info: link_u8(c.bufs, b, at + 4)
            if (info & 15) != 1 && (info & 15) != 2 -> next
            name_offset: link_u32(c.bufs, b, at)
            if name_offset == 0 -> next
            s: link_sym_shndx(c, obj, k)
            header: link_symbol_header(c, class_headers, s)
            if header < 0 -> next
            link_image_symbol(locals, symbol_names, names_base, link_cstr(c.bufs, b, c.obj_strtab[obj] + name_offset), info, header, link_sec_addr(c, s) + link_u64(c.bufs, b, at + 8), link_u64(c.bufs, b, at + 16))
        }
    }
    ^globals: [U8]{}
    loop g in 0..<c.g_name.len() {
        if c.g_kind[g] != LINK_G_FILE || c.g_alias[g] >= 0 -> next
        s: c.g_section[g]
        header: link_symbol_header(c, class_headers, s)
        if header < 0 -> next
        bind: if c.g_weak_def[g] -> 2 else -> 1
        kind: if c.live_class[c.live[s]] == LINK_TEXT -> 2 else -> 1
        link_image_symbol(globals, symbol_names, names_base, c.g_name[g], (bind << 4) | kind, header, link_global_addr(c, g), c.g_size[g])
    }
    link_bind_symbols(out, origin, headers, locals, globals, symbol_names, elf)
}

// The image's headers of its loaded sections, as they are.
link_bind_image_headers: fn(c: LinkContext, view: LinkImageView) -> [LinkSectionHeader] Never! {
    ^headers: [LinkSectionHeader]{}
    loop k in 1..<view.alloc_headers + 1 {
        h: view.shoff + 64 * k
        headers.push(
            LinkSectionHeader{
                name: link_cstr(c.bufs, 1, view.names_at + link_u32(c.bufs, 1, h)),
                kind: link_u32(c.bufs, 1, h + 4),
                flags: link_s64(c.bufs, 1, h + 8),
                addr: link_s64(c.bufs, 1, h + 16),
                offset: link_s64(c.bufs, 1, h + 24),
                size: link_s64(c.bufs, 1, h + 32),
                link: link_u32(c.bufs, 1, h + 40),
                info: link_u32(c.bufs, 1, h + 44),
                align: link_s64(c.bufs, 1, h + 48),
                entry_size: link_s64(c.bufs, 1, h + 56),
            },
        )
    }
    headers
}

// A header per layout class whose address range `extents[class]` is not
// empty, and `.got` after the read-only-after-relocation data when it has
// `got_slots` slots from `got_start`, appended to `headers`; returns per
// class its header's index (-1: none). File offsets are addresses less `base`.
link_bind_class_headers: fn(headers: ^[LinkSectionHeader], extents: [[Int]], got_start: Int, got_slots: Int, base: Int) -> [Int] Never! {
    ^class_headers: [Int]{}
    loop _ in 0..<LINK_CLASSES -> class_headers.push(-1)
    names: [String]{".rodata", ".eh_frame", ".text", ".tdata", ".tbss", ".preinit_array", ".init_array", ".fini_array", ".data.rel.ro", ".data", ".bss"}
    kinds: [Int]{LINK_SHT_PROGBITS, LINK_SHT_PROGBITS, LINK_SHT_PROGBITS, LINK_SHT_PROGBITS, LINK_SHT_NOBITS, LINK_SHT_PREINIT_ARRAY, LINK_SHT_INIT_ARRAY, LINK_SHT_FINI_ARRAY, LINK_SHT_PROGBITS, LINK_SHT_PROGBITS, LINK_SHT_NOBITS}
    flags: [Int]{2, 2, 6, 0x403, 0x403, 3, 3, 3, 3, 3, 3}
    loop class in 0..<LINK_CLASSES {
        extent: extents[class]
        if extent[1] > extent[0] {
            class_headers[class] = headers.len() + 1
            headers.push(LinkSectionHeader{name: names[class], kind: kinds[class], flags: flags[class], addr: extent[0], offset: extent[0] - base, size: extent[1] - extent[0], link: 0, info: 0, align: if class == LINK_TEXT -> 16 else -> 8, entry_size: 0})
        }
        if class == LINK_RELRO && got_slots > 0 {
            headers.push(LinkSectionHeader{name: ".got", kind: LINK_SHT_PROGBITS, flags: 3, addr: got_start, offset: got_start - base, size: 8 * got_slots, link: 0, info: 0, align: 8, entry_size: 8})
        }
    }
    class_headers
}

// The end of the debug tail `out`, the program part from file offset
// `origin`: `.symtab` (the null symbol, then the program's `locals` and
// `globals`) and `.strtab` (the empty name, then `symbol_names`), then the
// section headers, `headers` and theirs, which `elf` names.
link_bind_symbols: fn(out: ^[U8], origin: Int, headers: ^[LinkSectionHeader], locals: ^^[U8], globals: ^^[U8], symbol_names: ^^[U8], elf: ^[U8]) Never! {
    // The padding, both tables, then the section names and headers
    // (link_write_section_headers), with room to spare for the names.
    out.try_reserve(8 + 24 + locals.len() + globals.len() + 1 + symbol_names.len() + 64 * (headers.len() + 3) + 512) ?? ()
    elf64_pad(out, 8)
    symtab_at: origin + out.len()
    loop _ in 0..<24 -> out.push(U8{0})
    first_global: (24 + locals.len()).div_euclid(24)
    out.extend(locals.move())
    out.extend(globals.move())
    symtab_size: origin + out.len() - symtab_at
    strtab_index: headers.len() + 2
    headers.push(LinkSectionHeader{name: ".symtab", kind: LINK_SHT_SYMTAB, flags: 0, addr: 0, offset: symtab_at, size: symtab_size, link: strtab_index, info: first_global, align: 8, entry_size: 24})
    strtab_at: origin + out.len()
    out.push(U8{0})
    out.extend(symbol_names.move())
    strtab_size: origin + out.len() - strtab_at
    headers.push(LinkSectionHeader{name: ".strtab", kind: 3, flags: 0, addr: 0, offset: strtab_at, size: strtab_size, link: 0, info: 0, align: 1, entry_size: 0})
    shoff: link_write_section_headers(out, origin, headers)
    link_elf_sections(elf, shoff, headers.len() + 2)
}

// A linked executable, whole or in two parts. Bound to a runtime image
// (x64_bind_runtime_image), its file is the image's first `image_end` bytes
// with each `patch_bytes[k]` written at file offset `patch_at[k]`, zeros up
// to `tail_at`, then `tail`: the program part and the debug tail. The
// image part is the pack's own bytes, so Image/Loader.jet maps it from the
// file `image_path` (x64_executable_load) instead of copying it, when
// the file still has the identity `image_stamp` (x64_image_file_read) it
// had when `image` was read from it: the image file itself (`image_at` 0)
// or the executable holding it as a part from file offset `image_at` on
// (Image/Loader.jet x64_image_part_file). `image` lacks the image's bytes
// [image_gap_at, image_gap_at + image_gap) when x64_image_file_read left
// them out (image_gap 0 when it holds them all): the mapping reads only the
// ELF header, and Image/Loader.jet x64_executable_complete reads the rest
// for whoever needs the whole file. A whole executable is all `tail`
// (image_end and tail_at 0). A kept program (Image/Loader.jet
// x64_executable_kept) is bound to its image file again, its `image` that
// image's first page. x64_executable_bytes puts the file together. The
// program part names the program's symbols only when `image_symbols_left`
// (a bind at the image's program base, link_bind_named_tail). A
// split link's executable (x64_executable_split) also has its side debug
// file `debug_file` and the build id `build_id` both files' notes hold;
// others have both empty.
X64Executable: struct {
    image: [U8],
    image_path: String,
    image_stamp: [Int],
    image_at: Int,
    image_end: Int,
    image_gap_at: Int,
    image_gap: Int,
    patch_at: [Int],
    patch_bytes: [[U8]],
    tail_at: Int,
    tail: [U8],
    debug_file: [U8],
    build_id: [U8],
    image_symbols_left: Bool{false},
}

// The executable whose file is `bytes`.
x64_executable_whole: fn(bytes: ^^[U8]) -> X64Executable Never! {
    X64Executable{image: [U8]{}, image_path: "", image_stamp: [Int]{}, image_at: 0, image_end: 0, image_gap_at: 0, image_gap: 0, patch_at: [Int]{}, patch_bytes: [[U8]]{}, tail_at: 0, tail: bytes.move(), debug_file: [U8]{}, build_id: [U8]{}}
}

// The executable a split link wrote (x64_link_executable_split).
x64_executable_split: fn(linked: ^^X64SplitExecutableResult) -> X64Executable Never! {
    ^exe: x64_executable_whole(linked.bytes.move())
    exe.debug_file = linked.debug_file.move()
    exe.build_id = linked.build_id.move()
    exe
}

// The ELF header of `exe` as patched, its file's first 64 bytes: the
// image's own, else zeros, under the patches. A bound executable's patches
// rewrite all of it (link_bind_write), so one whose image part its caller
// took back (Native.jet jet_eval_native_bind) has its header too.
x64_executable_header: fn(exe: X64Executable) -> [U8] Never! {
    ^header: if exe.image.len() >= 64 -> exe.image[0..<64] else -> [U8]{}
    loop header.len() < 64 -> header.push(U8{0})
    loop (k, at) in exe.patch_at {
        loop (j, byte) in exe.patch_bytes[k] {
            if at + j < 64 -> header[at + j] = byte
        }
    }
    header
}

// The file of `exe`, whose image part is whole (x64_executable_complete).
x64_executable_bytes: fn(exe: ^^X64Executable) -> [U8] Never! {
    if exe.image_end == 0 -> return exe.tail.move()
    if exe.image_gap > 0 {
        panic("x64_executable_bytes: the image part of {exe.image_path} was read without its loaded segments")
    }
    ^whole: exe.move()
    if whole.image_symbols_left {
        named: link_bind_named_tail(whole, whole.image, 0, 0) ?? panic("x64_executable_bytes: the runtime image {whole.image_path} or its program part has no symbol table")
        whole.tail = named
    }
    ^out: whole.image[0..<whole.image_end]
    loop (k, at) in whole.patch_at {
        loop (j, byte) in whole.patch_bytes[k] -> out[at + j] = byte
    }
    link_pad_to(out, whole.tail_at, 0)
    out.extend(whole.tail)
    out
}

// The file a bind at the image's program base stands for names the image's
// symbols as well as the program's, as a full link's does, but its program
// part leaves them out (`image_symbols_left`, link_bind_sections): a
// program run from memory runs the image's own pages, and the image's
// symbols, megabytes, would be a copy of what the image's file holds (its
// file view maps them from there: Image/Loader.jet loader_view).
// Whoever writes the file (x64_executable_bytes, Image/Loader.jet
// x64_executable_write) puts them in: the program part `exe.tail` with a
// new `.symtab` (the image's locals, the program's, the image's globals,
// the program's) and `.strtab` (the image's names, then the program's) at
// its end, which the two section headers then name; the old tables stay as
// unreferenced bytes. The image's tables are read from `image`, the image
// file without its bytes [gap_at, gap_at + gap). None when either has no
// symbol table.
// Whether both the runtime image (without its bytes [gap_at, gap_at + gap))
// and the program part of `exe` hold readable symbol tables, as
// link_bind_named_tail needs.
link_bind_has_symbol_tables: fn(exe: X64Executable, image: [U8], gap_at: Int, gap: Int) -> Bool Never! {
    ^header: -1
    loop (k, at) in exe.patch_at {
        if at == 0 -> header = k
    }
    if header < 0 -> return false
    link_symbol_tables(image, image, 0, gap_at, gap).len() > 0 && link_symbol_tables(exe.patch_bytes[header], exe.tail, exe.tail_at, 0, 0).len() > 0
}

link_bind_named_tail: fn(exe: X64Executable, image: [U8], gap_at: Int, gap: Int) -> [U8]? Never! {
    ^header: -1
    loop (k, at) in exe.patch_at {
        if at == 0 -> header = k
    }
    if header < 0 -> return None
    tables: link_symbol_tables(image, image, 0, gap_at, gap)
    program: link_symbol_tables(exe.patch_bytes[header], exe.tail, exe.tail_at, 0, 0)
    if tables.len() == 0 || program.len() == 0 -> return None
    image_globals: tables[1] + 24 * tables[3]
    image_end: tables[1] + 24 * tables[2]
    program_globals: program[1] + 24 * program[3]
    program_end: program[1] + 24 * program[2]
    // Each program name moves past the image's names, less the empty name.
    shift: tables[6] - 1
    ^tail: [U8]{}
    tail.try_reserve(exe.tail.len() + 8 + image_end - tables[1] + program_end - program[1] + tables[6] + program[6]) ?? ()
    tail.extend(exe.tail)
    elf64_pad(tail, 8)
    symbols_at: tail.len()
    tail.extend(image[tables[1]..<image_globals])
    link_bind_shifted_symbols(tail, program[1] + 24, program_globals, shift)
    tail.extend(image[image_globals..<image_end])
    link_bind_shifted_symbols(tail, program_globals, program_end, shift)
    names_at: tail.len()
    tail.extend(image[tables[5]..<tables[5] + tables[6]])
    tail.extend(exe.tail[program[5] + 1..<program[5] + program[6]])
    link_put64(tail, program[0] + 24, exe.tail_at + symbols_at)
    link_put64(tail, program[0] + 32, names_at - symbols_at)
    link_put32(tail, program[0] + 44, tables[3] + program[3] - 1)
    link_put64(tail, program[4] + 24, exe.tail_at + names_at)
    link_put64(tail, program[4] + 32, tail.len() - names_at)
    Val(tail)
}

// Where the `.symtab` of the ELF file whose header is `elf` and whose bytes
// from file offset `origin` on are `bytes`, without the file's bytes
// [gap_at, gap_at + gap), lies, as indexes of `bytes`: its section header,
// its offset, symbol count and first global, its `.strtab`'s section
// header, offset and size; empty when `bytes` holds no such tables.
link_symbol_tables: fn(elf: [U8], bytes: [U8], origin: Int, gap_at: Int, gap: Int) -> [Int] Never! {
    size: bytes.len()
    if elf.len() < LINK_EHDR_SIZE -> return [Int]{}
    shoff: link_image_at(link_image_i64(elf, 40) - origin, gap_at, gap)
    shnum: link_image_u16(elf, 60)
    if shoff < 0 || shoff + 64 * shnum > size -> return [Int]{}
    loop k in 1..<shnum {
        h: shoff + 64 * k
        if link_image_u32(bytes, h + 4) != LINK_SHT_SYMTAB -> next
        strings: link_image_u32(bytes, h + 40)
        if strings >= shnum -> return [Int]{}
        s: shoff + 64 * strings
        at: link_image_at(link_image_i64(bytes, h + 24) - origin, gap_at, gap)
        count: link_image_i64(bytes, h + 32).div_euclid(24)
        first: link_image_u32(bytes, h + 44)
        names_at: link_image_at(link_image_i64(bytes, s + 24) - origin, gap_at, gap)
        names_size: link_image_i64(bytes, s + 32)
        if at < 0 || count < 1 || at + 24 * count > size || first < 1 || first > count || names_at < 0 || names_size < 1 || names_at + names_size > size {
            return [Int]{}
        }
        return [Int]{h, at, count, first, s, names_at, names_size}
    }
    [Int]{}
}

// Append the symbols at [from, to) of `tail` to it again, each nonzero name
// offset `shift` further.
link_bind_shifted_symbols: fn(tail: ^[U8], from: Int, to: Int, shift: Int) Never! {
    loop k in 0..<(to - from).div_euclid(24) {
        at: tail.len()
        loop j in 0..<24 {
            byte: tail[from + 24 * k + j]
            tail.push(byte)
        }
        name: link_image_u32(tail, at)
        if name != 0 -> link_put32(tail, at, name + shift)
    }
}

// A bound executable, else (errors not empty) why the program can't be
// bound: with `unwritten`, why its object can't be written
// (x64_bind_functions_at).
X64BindResult: struct {
    executable: X64Executable,
    errors: [String],
    unwritten: Bool{false},
}

// Bind the program object `program` (named `name` in reports) to the
// runtime image `image`, read from the file `image_path` with identity
// `image_stamp` ("" and empty when it came from elsewhere), from its file
// offset `image_at` on, and without its bytes [gap_at, gap_at + gap)
// (Image/Loader.jet x64_image_file_read): a static executable at the
// image's base, in parts, whose debug tail holds `.debug_*` sections only
// under `debug_info` (link_debug_sections) and names the program's symbols
// only, until its file is written (link_bind_named_tail).
x64_bind_runtime_image: fn(name: String, program: ^^[U8], image: ^^[U8], image_path: String, image_stamp: [Int], image_at: Int, gap_at: Int, gap: Int, debug_info: Bool) -> X64BindResult Never! {
    ^bound: link_bind_image(name, program, image, gap_at, gap, None, debug_info)
    if bound.errors.len() == 0 {
        bound.executable.image_path = image_path
        bound.executable.image_stamp = image_stamp
        bound.executable.image_at = image_at
    }
    bound
}

// Link the program object `program` (named `name` in reports) against the
// runtime image `image` into a static executable at the image's base.
x64_link_with_runtime_image: fn(name: String, program: ^^[U8], image: ^^[U8]) -> X64ExecutableResult Never! {
    link_bind_bytes(link_bind_image(name, program, image, 0, 0, None, true))
}

// Bind the program object `program` (named `name` in reports) with its part
// at `program_base`, a page boundary at or above the image's own, for code
// loaded into a process already running the runtime image `image`, read
// without its bytes [gap_at, gap_at + gap) (Image/Loader.jet
// x64_image_file_read; gap 0 when whole) (compile-time batches,
// SessionHost.jet x64_comptime_code), which maps only the loads from
// `program_base` up. The executable's image part is `image` itself,
// unchanged, whether or not the program binds, so a caller binding batch
// after batch keeps one image. It has no `.debug_*` section: none lies in a
// load, so the process would never map one. Its `.symtab` holds the
// program's symbols only: the image's are the image's file's, which the
// process already runs.
x64_bind_runtime_image_at: fn(name: String, program: ^^[U8], image: ^^[U8], program_base: Int, gap_at: Int, gap: Int) -> X64BindResult Never! {
    link_bind_image(name, program, image, gap_at, gap, Val(program_base), false)
}

// Whether the runtime image defines each name `names[rows[k]]`, looked up
// as a bind looks up a program's import (link_image_defines). The image is
// the one row of `images`, read without its bytes [gap_at, gap_at + gap);
// it moves into a context for the reads and back. Nothing is defined when
// the image is absent or can't be read.
x64_runtime_image_defines: fn(images: ^[[U8]], gap_at: Int, gap: Int, names: [String], rows: [Int]) -> [Bool] Never! {
    ^found: [Bool]{}
    if images.len() == 0 -> return found
    image: images.remove(0, .Slot) ?? return found
    ^c: link_context([[U8]]{[U8]{}, image.move()}, LINK_RUN_BASE)
    view: link_image_view(c, 1, gap_at, gap)
    loop row in rows -> found.push(c.errors.len() == 0 && link_image_defines(c, view, names[row]))
    images.push(c.bufs.remove(1, .Slot) ?? [U8]{})
    found
}

// The address the runtime image gives its export `name`, looked up as a
// bind looks up a program's import: in its export index, else in its global
// symbols (the last that names it). The image is the one row of `images`,
// read without its bytes [gap_at, gap_at + gap); it moves into a context
// for the reads and back. None when the image is absent, can't be read or
// defines no `name`.
x64_runtime_image_export: fn(images: ^[[U8]], gap_at: Int, gap: Int, name: String) -> Int? Never! {
    if images.len() == 0 -> return None
    image: images.remove(0, .Slot) ?? return None
    ^c: link_context([[U8]]{[U8]{}, image.move()}, LINK_RUN_BASE)
    view: link_image_view(c, 1, gap_at, gap)
    ^found: Int?{None}
    if c.errors.len() == 0 {
        if {
            view.exports_slots > 0 -> {
                k: link_image_export(c, view, name)
                if k >= 0 -> found = Val(link_s64(c.bufs, 1, view.symtab_at + 24 * k + 8))
            }
            else -> {
                loop k in view.first_global..<view.symtab_count {
                    at: view.symtab_at + 24 * k
                    if link_u16(c.bufs, 1, at + 6) == 0 -> next
                    if link_cstr(c.bufs, 1, view.strtab_at + link_u32(c.bufs, 1, at)) == name {
                        found = Val(link_s64(c.bufs, 1, at + 8))
                    }
                }
            }
        }
    }
    images.push(c.bufs.remove(1, .Slot) ?? [U8]{})
    found
}

link_bind_bytes: fn(bound: ^^X64BindResult) -> X64ExecutableResult Never! {
    if bound.errors.len() > 0 {
        return X64ExecutableResult{bytes: [U8]{}, errors: bound.errors.move()}
    }
    X64ExecutableResult{bytes: x64_executable_bytes(bound.executable.move()), errors: [String]{}}
}

// A bind that failed: its errors, and the image (input 1) as the
// executable's image part, as a bound one has it.
link_bind_failure: fn(c: ^LinkContext) -> X64BindResult Never! {
    ^exe: x64_executable_whole([U8]{})
    exe.image = c.bufs.remove(1, .Slot) ?? [U8]{}
    // copy: a few report lines; the context drops its own with it.
    X64BindResult{executable: exe, errors: c.errors.copy()}
}

link_bind_image: fn(name: String, program: ^^[U8], image: ^^[U8], gap_at: Int, gap: Int, program_base: Int?, debug_info: Bool) -> X64BindResult Never! {
    ^c: link_context([[U8]]{program.move(), image.move()}, LINK_RUN_BASE)
    ^view: link_image_view(c, 1, gap_at, gap)
    if c.errors.len() > 0 -> return link_bind_failure(c)
    if program_base == .Val(chosen) {
        if chosen & LINK_PAGE - 1 != 0 || chosen < view.program_base {
            link_error(c, "runtime image: program base {chosen} is not a page boundary at or above {view.program_base}")
            return link_bind_failure(c)
        }
        view.program_base = chosen
    }
    c.base = view.base
    link_load_inputs(c, [String]{name})
    if c.errors.len() > 0 -> return link_bind_failure(c)
    main_g: link_global_named(c, "main")
    if main_g < 0 || c.g_kind[link_final(c, main_g)] != LINK_G_FILE || c.g_section[link_final(c, main_g)] < 0 {
        link_error(c, "{name}: the program does not define `main`")
        return link_bind_failure(c)
    }
    // The image's calls to a provider hook reach its own definition; only a
    // full link binds them to the program's.
    loop hook in RUNTIME_PROVIDER_HOOKS {
        hook_g: link_global_named(c, hook)
        if hook_g >= 0 && c.g_kind[link_final(c, hook_g)] == LINK_G_FILE {
            link_error(c, "{name}: the program defines the runtime hook `{hook}`, which the runtime image binds to its own; link it in full")
            return link_bind_failure(c)
        }
    }
    // The program's imports, and the binding startup's
    // `__register_frame_info` when the image links libgcc's unwinder,
    // resolve to the image's definitions.
    frames: link_image_defines(c, view, "__register_frame_info")
    link_load_synth(c, link_bind_startup(frames), "<runtime image binding>")
    // Each import is looked up in the image's export index; an image packed
    // by a compiler before the index has its global symbols scanned instead.
    if {
        view.exports_slots > 0 -> {
            loop g in 0..<c.g_name.len() {
                if c.g_kind[g] != LINK_G_NONE || c.g_alias[g] >= 0 -> next
                k: link_image_export(c, view, c.g_name[g])
                if k < 0 -> next
                c.g_kind[g] = LINK_G_LINKER
                c.g_addr[g] = link_s64(c.bufs, 1, view.symtab_at + 24 * k + 8)
            }
        }
        else -> {
            // Whether each global was undefined before binding; a name the
            // image's symbols repeat binds to the last of them.
            imports: loop g in 0..<c.g_name.len() -> c.g_kind[g] == LINK_G_NONE && c.g_alias[g] < 0
            loop k in view.first_global..<view.symtab_count {
                at: view.symtab_at + 24 * k
                if link_u16(c.bufs, 1, at + 6) == 0 -> next
                g: link_global_named(c, link_cstr(c.bufs, 1, view.strtab_at + link_u32(c.bufs, 1, at)))
                if g < 0 || !imports[g] -> next
                c.g_kind[g] = LINK_G_LINKER
                c.g_addr[g] = link_s64(c.bufs, 1, at + 8)
            }
        }
    }
    start_g: link_global_named(c, "__jet_bind_main")
    if start_g < 0 {
        link_error(c, "runtime image binding: no `__jet_bind_main`")
        return link_bind_failure(c)
    }
    entries: [Int]{c.g_section[link_final(c, main_g)], c.g_section[start_g]}
    link_collect(c, entries, [String]{"__jet_bind_eh"}, [Int]{})
    if c.errors.len() > 0 -> return link_bind_failure(c)
    order: link_order(c)
    loop class in ([Int]{LINK_TDATA, LINK_TBSS, LINK_PREINIT, LINK_INIT, LINK_FINI}) {
        if order[class].len() > 0 {
            link_error(c, "{name}: thread-local data and init/fini arrays are not bound to the runtime image; link it in full")
            return link_bind_failure(c)
        }
    }
    layout: link_bind_layout(c, view)
    eh_g: link_global_named(c, "__jet_bind_eh")
    if eh_g >= 0 {
        c.g_kind[eh_g] = LINK_G_LINKER
        c.g_addr[eh_g] = c.eh_start
    }
    debug: link_debug_sections(c, debug_info)
    target: link_global_addr(c, start_g)
    origin: view.program_base - c.base
    ^exe: x64_executable_whole([U8]{})
    exe.image_end = view.load_end
    exe.image_gap_at = gap_at
    exe.image_gap = gap
    exe.tail_at = origin
    ^elf: link_bind_write(c, exe, view, layout, target)
    link_bind_sections(c, exe.tail, origin, view, layout, debug, elf)
    exe.image_symbols_left = program_base == None
    if c.errors.len() > 0 -> return link_bind_failure(c)
    exe.patch_at.push(0)
    exe.patch_bytes.push(elf)
    // The image (input 1) moves out of the context: the executable's image part.
    exe.image = c.bufs.remove(1, .Slot) ?? [U8]{}
    X64BindResult{executable: exe, errors: [String]{}}
}
