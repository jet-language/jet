// The pinned-Core producer depends on typed lowering metadata. Keep it apart
// from scalar memory images and their focused standalone ABI proofs.
use jet_foundation.mir_shared_site_getter_symbol

// Only lir_lower_core_shared supplies this inventory and its explicit
// no-argument Unit startup. Startup initializes static fixups, not user roots;
// the host invokes it once before publishing this permanently pinned image.
fn x64_memory_core_shared_image(lowered: LIRLowering) -> X64MemoryImage Never! {
    if lowered.issues.len() > 0 {
        errors :: loop issue in lowered.issues -> "pinned Core lowering: {issue.message}"
        return x64_memory_image_failure(errors)
    }
    entry :: lowered.entry ?? return x64_memory_image_failure([String]{"pinned Core has no static initialization entry"})
    image := x64_memory_image(lowered.lir, entry)
    if image.errors.len() > 0 -> return image
    loop row in lowered.shared_sites {
        key :: "shared-site:{row.initializer.value}"
        if row.site_key != key -> return x64_memory_image_failure([String]{"pinned Core initializer {row.initializer.value} has noncanonical SiteKey {row.site_key}; expected {key}"})
        expected :: mir_shared_site_getter_symbol(row.initializer)
        if row.symbol != expected -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} has noncanonical getter {row.symbol}; expected {expected}"})
        if image.exports.get(row.symbol) != None -> return x64_memory_image_failure([String]{"duplicate pinned Core getter {row.symbol} for SiteKey {row.site_key}"})
        if row.function.value < 0 || row.function.value >= lowered.lir.functions.len() || row.function.value >= image.functions.len() {
            return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter function {row.function.value} is not in the compiled image"})
        }
        function :: lowered.lir.functions[row.function.value]
        if function.id != row.function -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter function identity does not match its module row"})
        signature :: lir_signature(lowered.lir, function.signature) ?? return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter has no signature"})
        result :: signature.result ?? return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter has no owned handle result"})
        integer_result :: result.class == .Integer || result.class == .Pointer
        if signature.convention != .SystemV || signature.params.len() != 0 || result.size != 8 || result.align != 8 || !integer_result {
            return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter must take no arguments and return an eight-byte owned handle"})
        }
        // functions[] was populated by matching compiled function IDs to
        // x64_link_text's offsets, never by MIR IDs or guessed byte positions.
        at :: image.functions[row.function.value]
        if at < 0 || at >= image.data_offset -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter was not compiled into executable code"})
        &image.exports.add(row.symbol, at).drop("checked absent above")
    }
    seen := [String:Bool]{}
    loop row in lowered.core_callables {
        if seen.get(row.semantic_identity) != None -> return x64_memory_image_failure([String]{"CoreSharedClosureConcreteProvenanceGap: {row.semantic_identity}"})
        seen[row.semantic_identity] = true
        if row.function.value < 0 || row.function.value >= lowered.lir.functions.len() || row.function.value >= image.functions.len() -> return x64_memory_image_failure([String]{"CoreSharedCallableBindingMissing: {row.semantic_identity}"})
        function :: lowered.lir.functions[row.function.value]
        if function.id != row.function -> return x64_memory_image_failure([String]{"CoreSharedCallableBindingInvalid: {row.semantic_identity}"})
        signature :: lir_signature(lowered.lir, function.signature) ?? return x64_memory_image_failure([String]{"CoreSharedCallableBindingMissing: {row.semantic_identity}"})
        if row.role != "closure.code" {
            count :: if row.role == "lazy.clone" -> 2 else -> 1
            if signature.convention != .SystemV || signature.params.len() != count || signature.result != None -> return x64_memory_image_failure([String]{"CoreSharedCallableSignatureMismatch: {row.semantic_identity}"})
            loop parameter in signature.params {
                if parameter != lir_layout_pointer() -> return x64_memory_image_failure([String]{"CoreSharedCallableSignatureMismatch: {row.semantic_identity}"})
            }
        }
        offset :: image.functions[row.function.value]
        if offset < 0 || offset >= image.data_offset -> return x64_memory_image_failure([String]{"CoreSharedCallableBindingMissing: {row.semantic_identity}"})
        symbol :: "jet_core_callable_{row.function.value}"
        if image.exports.get(symbol) == None -> &image.exports.add(symbol, offset).drop("checked absent above")
    }
    image
}

