// `.debug_jetline` read back from a linked ELF file (DebugPrune.jet
// documents its linked form): the Jet functions of an image's location
// table with their names, files, declaration lines and line rows. `jet
// crash` (JetCLI CLI/Crash.jet) names a release program's fault report from
// its side debug file with it. The lookups are the fault report's own
// (Compiler/JetRuntime/Assets/FaultReport/report.S `find` and `line`), so a
// release report named here reads as the dev build's report.
//
// A function's rows (X64LineRow, from its start and line 1), each: a uleb,
// twice the address advance from the row before plus 1 for a call row;
// a call row's character column, a uleb; and an sleb, the line advance.

// One function's record: its link-time code [low, high), its name, file
// path, compilation directory and declaration line, and its rows' bytes
// [rows, rows_end) in the table.
X64JetlineFunction: struct {
    low: Int,
    high: Int,
    name: String,
    file: String,
    dir: String,
    decl: Int,
    rows: Int,
    rows_end: Int,
}

// A linked `.debug_jetline` and its functions in table order; `ascending`
// when each function starts at or past the end of the one before it, so a
// lookup halves the table (x64_jetline_find): an image of the compiler holds
// tens of thousands of functions, and a step looks one up per instruction.
X64Jetline: struct {
    table: [U8],
    functions: [X64JetlineFunction],
    ascending: Bool{false},
}

// The compilation directory the runtime library's block records
// (JetCLI Request.jet jet_cli_runtime_ir): the runtime pack carries its
// rows into every image it links (Image/RuntimePack.jet link_pack_write), so
// a profile names the runtime's functions, but a function in this block is
// the runtime's, never the program's Jet source. A stop's site (JetRuntime
// Fault.jet), the fault report (JetRuntime Assets/FaultReport/report.S
// `find`), the debugger's frames (JetDebug NativeFacts.jet) and `jet crash`
// (JetCLI CLI/Crash.jet) skip it, naming its functions as routines. No
// directory a command records is spelled so.
X64_JETLINE_RUNTIME_DIRECTORY: "<runtime>"

// The location table of the ELF file `elf` (an image or its side debug
// file); None when it has no `.debug_jetline` section.
x64_jetline_read: fn(elf: [U8]) -> X64Jetline? Never! {
    headers: link_debug_addr(elf, 40)
    size: link_debug_le(elf, 58, 2)
    count: link_debug_le(elf, 60, 2)
    names_index: link_debug_le(elf, 62, 2)
    if headers < 0 || size < 64 || names_index < 0 || names_index >= count -> return None
    names: link_debug_addr(elf, headers + names_index * size + 24)
    if names < 0 -> return None
    loop k in 0..<count {
        header: headers + k * size
        name: link_debug_le(elf, header, 4)
        if name < 0 || x64_jetline_text(elf, names + name) != ".debug_jetline" -> next
        offset: link_debug_addr(elf, header + 24)
        length: link_debug_addr(elf, header + 32)
        if offset < 0 || length < 0 || offset + length > elf.len() -> return None
        table := elf[offset..<offset + length]
        return Val(x64_jetline_parse(table))
    }
    None
}

// The functions of the linked blocks in `table`; a block or record that
// runs past its end ends the read.
x64_jetline_parse: fn(table: ^^[U8]) -> X64Jetline Never! {
    functions := [X64JetlineFunction]{}
    ascending := true
    reached := 0
    at := 0
    loop at + 20 <= table.len() {
        end: at + 4 + link_debug_le(table, at, 4)
        if end < at + 20 || end > table.len() -> break
        count: link_debug_le(table, at + 4, 4)
        strings: at + link_debug_le(table, at + 8, 4)
        dir: x64_jetline_text(table, strings)
        address := link_debug_addr(table, at + 12)
        cursor := at + 20
        loop _ in 0..<count {
            if cursor >= end -> break
            low: address + x64_jetline_sleb(table, cursor)
            high: low + link_debug_uleb(table, cursor)
            if low < reached -> ascending = false
            reached = high
            name: link_debug_uleb(table, cursor)
            file: link_debug_uleb(table, cursor)
            decl: link_debug_uleb(table, cursor)
            rows: link_debug_uleb(table, cursor)
            if rows < 0 || cursor + rows > end -> break
            functions.push(
                X64JetlineFunction{
                    low: low,
                    high: high,
                    name: x64_jetline_text(table, strings + name),
                    file: x64_jetline_text(table, strings + file),
                    dir: dir.copy(),
                    decl: decl,
                    rows: cursor,
                    rows_end: cursor + rows,
                },
            )
            cursor += rows
            address = high
        }
        at = end
    }
    X64Jetline{table: table.move(), functions: functions, ascending: ascending}
}

// `lines` without the runtime library's functions, whose block records
// X64_JETLINE_RUNTIME_DIRECTORY: the program's Jet functions, as the fault
// report's `find` sees them. The debugger and `jet crash` read these; a
// profile reads them all.
x64_jetline_program: fn(lines: ^^X64Jetline) -> X64Jetline Never! {
    owned: lines.move()
    kept := [X64JetlineFunction]{}
    loop function in owned.functions.move() {
        if function.dir != X64_JETLINE_RUNTIME_DIRECTORY -> kept.push(function)
    }
    X64Jetline{table: owned.table.move(), functions: kept, ascending: owned.ascending}
}

// The index of the function holding link-time address `pc`, else -1. An
// ascending table is halved down to the last function starting at or before
// `pc`; another is searched in order.
x64_jetline_find: fn(lines: X64Jetline, pc: Int) -> Int Never! {
    if lines.ascending {
        // The first function starting past `pc`.
        low := 0
        high := lines.functions.len()
        loop low < high {
            middle: (low + high) >> 1
            if {
                (lines.functions[middle].low <= pc) -> low = middle + 1
                else -> high = middle
            }
        }
        if low > 0 && pc < lines.functions[low - 1].high -> return low - 1
        return -1
    }
    loop (k, function) in lines.functions {
        if pc >= function.low && pc < function.high -> return k
    }
    -1
}

// Each row of `rows` with a source line, in the table's coding (above),
// onto `out`; the rows are offsets from the function's start.
x64_jetline_rows: fn(out: ^[U8], rows: [X64LineRow]) Never! {
    at := 0
    line := 1
    loop row in rows {
        if row.line <= 0 -> next
        dwarf_uleb(out, if row.call -> 2 * (row.at - at) + 1 else -> 2 * (row.at - at))
        if row.call -> dwarf_uleb(out, row.column)
        dwarf_sleb(out, row.line - line)
        at = row.at
        line = row.line
    }
}

// The row at `at` of `table` after `row` (the one before it, or the
// function's start and line 1 before the first), advancing `at` past it.
x64_jetline_next: fn(table: [U8], at: ^Int, row: ^X64LineRow) Never! {
    advance: link_debug_uleb(table, at)
    row.at += advance >> 1
    row.call = advance & 1 == 1
    row.column = if row.call -> link_debug_uleb(table, at) else -> 0
    row.line += x64_jetline_sleb(table, at)
}

// The line of `pc` in `function` as a statement's: the last statement row
// at or before it (call rows left out), the last reaching the function's
// end; None when no row holds it.
x64_jetline_line: fn(lines: X64Jetline, function: X64JetlineFunction, pc: Int) -> Int? Never! {
    found: x64_jetline_row(lines, function, pc) ?? return None
    Val(found.line)
}

// The row holding `pc` in `function`, call rows too: a caller's frame
// looked up at its return address - 1 stands at its call's line and
// column. None when no row holds it.
x64_jetline_place: fn(lines: X64Jetline, function: X64JetlineFunction, pc: Int) -> X64LineRow? Never! {
    x64_jetline_row(lines, function, pc, calls: true)
}

// The last row (a call row only with `calls`) at or before `pc` in
// `function` whose code reaches it.
x64_jetline_row: fn(lines: X64Jetline, function: X64JetlineFunction, pc: Int, calls: Bool{false}) -> X64LineRow? Never! {
    at := function.rows
    row := X64LineRow{at: function.low, line: 1}
    // The row before `row` that holds code, its start -1 before the first.
    held := X64LineRow{at: -1, line: 0}
    loop at < function.rows_end {
        x64_jetline_next(lines.table, at, row)
        if row.call && !calls -> next
        if held.at >= 0 && pc >= held.at && pc < row.at -> return Val(held)
        held = X64LineRow{at: row.at, line: row.line, column: row.column, call: row.call}
    }
    if held.at >= 0 && pc >= held.at && pc < function.high -> return Val(held)
    None
}

// The sleb at `at` (advanced past it); 0 when it runs out. Every bit of a
// 64-bit value is kept: an absent inline Option's discriminant is 2^62.
x64_jetline_sleb: fn(bytes: [U8], at: ^Int) -> Int Never! {
    value := 0
    shift := 0
    loop at < bytes.len() {
        byte: Int{bytes[at]}
        at += 1
        if shift < 63 -> value |= (byte & 127) << shift
        shift += 7
        if byte < 128 {
            if byte & 64 != 0 && shift < 64 -> value -= 1 << shift
            return value
        }
    }
    0
}

// The NUL-terminated string at `at`; empty when it has no NUL or isn't
// UTF-8.
x64_jetline_text: fn(bytes: [U8], at: Int) -> String Never! {
    end: link_debug_cstr_end(bytes, at)
    if at < 0 || end > bytes.len() -> return ""
    String.from_bytes(bytes[at..<end - 1]) ?? ""
}

// Per function of `functions`, the function a generated entry stands for,
// -1 for every other: a generated entry (JetIR Build.jet
// ir_entry_function) is named `entry`, at the file and declaration line of
// the entry it runs, so it stands for the first function not named `entry`
// with its file, directory and declaration line. `jet debug` (JetDebug
// NativeFacts.jet native_main_entry) starts a run at the function it
// stands for, and `jet perf` (JetCLI Perf/SourceSampling.jet) counts a
// sample in its own code outside the source, as a compiler-emitted
// helper's.
x64_jetline_entry_runs: fn(functions: [X64JetlineFunction]) -> [Int] Never! {
    runs := [Int]{}
    // An image holds a generated entry per program it links, so each
    // scans the functions once.
    loop entry in functions {
        found := -1
        if entry.name == "entry" {
            loop (index, function) in functions {
                if function.name != "entry" && function.decl == entry.decl && function.file == entry.file && function.dir == entry.dir {
                    found = index
                    break
                }
            }
        }
        runs.push(found)
    }
    runs
}

#Test("a function's rows keep their call rows, which only a place lookup reads") {
    rows: [X64LineRow]{
        X64LineRow{at: 0, line: 5},
        X64LineRow{at: 4, line: 6},
        X64LineRow{at: 4, line: 7, column: 9, call: true},
        X64LineRow{at: 9, line: 6, call: true},
        X64LineRow{at: 12, line: 8},
    }
    table := [U8]{}
    x64_jetline_rows(table, rows)
    // uleb(2 * advance + call), a call row's column, then the line's sleb.
    assert_eq(table, [U8]{0, 4, 8, 1, 1, 9, 1, 11, 0, 0x7f, 6, 2})
    size: table.len()
    lines: X64Jetline{table: table, functions: [X64JetlineFunction]{X64JetlineFunction{low: 0x1000, high: 0x1010, name: "run", file: "run.jet", dir: "", decl: 5, rows: 0, rows_end: size}}}
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x1003), Val(5))
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x1004), Val(6))
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x1008), Val(6))
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x100a), Val(6))
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x100f), Val(8))
    assert_eq(x64_jetline_line(lines, lines.functions[0], 0x1010), None)
    first: x64_jetline_place(lines, lines.functions[0], 0x1003) ?? panic("the opening row")
    assert(!first.call && first.line == 5 && first.at == 0x1000)
    call: x64_jetline_place(lines, lines.functions[0], 0x1008) ?? panic("the call's row")
    assert(call.call && call.at == 0x1004 && call.line == 7 && call.column == 9)
    back: x64_jetline_place(lines, lines.functions[0], 0x1009) ?? panic("the restore row")
    assert(back.call && back.line == 6 && back.column == 0)
    after: x64_jetline_place(lines, lines.functions[0], 0x100c) ?? panic("the last row")
    assert(!after.call && after.line == 8 && after.column == 0)
    seen := 0
    at := 0
    row := X64LineRow{at: 0x1000, line: 1}
    loop at < size {
        x64_jetline_next(lines.table, at, row)
        seen += 1
    }
    assert_eq(seen, 5)
    assert_eq(row.at, 0x100c)
}

#Test("a generated entry stands for the function at its file and line") {
    run: X64JetlineFunction{low: 0x1000, high: 0x1010, name: "run", file: "short.jet", dir: "/w", decl: 2, rows: 0, rows_end: 0}
    entry: X64JetlineFunction{low: 0x2000, high: 0x2010, name: "entry", file: "short.jet", dir: "/w", decl: 2, rows: 0, rows_end: 0}
    helper: X64JetlineFunction{low: 0x3000, high: 0x3010, name: "helper", file: "short.jet", dir: "/w", decl: 4, rows: 0, rows_end: 0}
    // An `entry` with no function at its file and line is the program's own.
    alone: X64JetlineFunction{low: 0x4000, high: 0x4010, name: "entry", file: "other.jet", dir: "/w", decl: 2, rows: 0, rows_end: 0}
    assert_eq(x64_jetline_entry_runs([X64JetlineFunction]{entry, helper, run, alone}), [Int]{2, -1, -1, -1})
    assert_eq(x64_jetline_entry_runs([X64JetlineFunction]{}), [Int]{})
}
