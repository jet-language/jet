// `.debug_jetline` read back from a linked ELF file (DebugPrune.jet
// documents its linked form): the Jet functions of an image's location
// table with their names, files, declaration lines and line rows. `jet
// crash` (JetCli Cli/Crash.jet) names a release program's fault report from
// its side debug file with it. The lookups are the fault report's own
// (Compiler/JetRuntime/Assets/FaultReport/report.S `find` and `line`), so a
// release report named here reads as the dev build's report.

// One function's record: its link-time code [low, high), its name, file
// path, compilation directory and declaration line, and its rows' bytes
// [rows, rows_end) in the table.
struct X64JetlineFunction {
    low: Int
    high: Int
    name: String
    file: String
    dir: String
    decl: Int
    rows: Int
    rows_end: Int
}

// A linked `.debug_jetline` and its functions in table order.
struct X64Jetline {
    table: [U8]
    functions: [X64JetlineFunction]
}

// The location table of the ELF file `elf` (an image or its side debug
// file); None when it has no `.debug_jetline` section.
fn x64_jetline_read(elf: [U8]) -> X64Jetline? Never! {
    headers :: link_debug_addr(elf, 40)
    size :: link_debug_le(elf, 58, 2)
    count :: link_debug_le(elf, 60, 2)
    names_index :: link_debug_le(elf, 62, 2)
    if headers < 0 || size < 64 || names_index < 0 || names_index >= count -> return None
    names :: link_debug_addr(elf, headers + names_index * size + 24)
    if names < 0 -> return None
    loop k in 0..<count {
        header :: headers + k * size
        name :: link_debug_le(elf, header, 4)
        if name < 0 || x64_jetline_text(elf, names + name) != ".debug_jetline" -> next
        offset :: link_debug_addr(elf, header + 24)
        length :: link_debug_addr(elf, header + 32)
        if offset < 0 || length < 0 || offset + length > elf.len() -> return None
        table := elf[offset..<offset + length]
        return Val(x64_jetline_parse(^table))
    }
    None
}

// The functions of the linked blocks in `table`; a block or record that
// runs past its end ends the read.
fn x64_jetline_parse(table: ^[U8]) -> X64Jetline Never! {
    functions := [X64JetlineFunction]{}
    at := 0
    loop at + 20 <= table.len() {
        end :: at + 4 + link_debug_le(table, at, 4)
        if end < at + 20 || end > table.len() -> break
        count :: link_debug_le(table, at + 4, 4)
        strings :: at + link_debug_le(table, at + 8, 4)
        dir :: x64_jetline_text(table, strings)
        address := link_debug_addr(table, at + 12)
        cursor := at + 20
        loop _ in 0..<count {
            if cursor >= end -> break
            low :: address + x64_jetline_sleb(table, &cursor)
            high :: low + link_debug_uleb(table, &cursor)
            name :: link_debug_uleb(table, &cursor)
            file :: link_debug_uleb(table, &cursor)
            decl :: link_debug_uleb(table, &cursor)
            rows :: link_debug_uleb(table, &cursor)
            if rows < 0 || cursor + rows > end -> break
            &functions.push(X64JetlineFunction{
                low: low,
                high: high,
                name: x64_jetline_text(table, strings + name),
                file: x64_jetline_text(table, strings + file),
                dir: dir,
                decl: decl,
                rows: cursor,
                rows_end: cursor + rows,
            })
            cursor += rows
            address = high
        }
        at = end
    }
    X64Jetline{table: ^table, functions: functions}
}

// The index of the function holding link-time address `pc`, else -1.
fn x64_jetline_find(lines: X64Jetline, pc: Int) -> Int Never! {
    loop (k, function) in lines.functions {
        if pc >= function.low && pc < function.high -> return k
    }
    -1
}

// The line of `pc` in `function`: the last row at or before it, the last
// row reaching the function's end; None when no row holds it.
fn x64_jetline_line(lines: X64Jetline, function: X64JetlineFunction, pc: Int) -> Int? Never! {
    at := function.rows
    address := function.low
    line := 1
    previous := -1
    previous_line := 0
    loop at < function.rows_end {
        address += link_debug_uleb(lines.table, &at)
        line += x64_jetline_sleb(lines.table, &at)
        if previous >= 0 && pc >= previous && pc < address -> return Val(previous_line)
        previous = address
        previous_line = line
    }
    if previous >= 0 && pc >= previous && pc < function.high -> return Val(previous_line)
    None
}

// The sleb at `at` (advanced past it); 0 when it runs out.
fn x64_jetline_sleb(bytes: [U8], at: &Int) -> Int Never! {
    value := 0
    shift := 0
    loop at < bytes.len() {
        byte :: Int.from_u8(bytes[at])
        at += 1
        if shift < 56 -> value = value.bit_or(byte.bit_and(127) << shift)
        shift += 7
        if byte < 128 {
            if byte.bit_and(64) != 0 && shift < 63 -> value -= 1 << shift
            return value
        }
    }
    0
}

// The NUL-terminated string at `at`; empty when it has no NUL or isn't
// UTF-8.
fn x64_jetline_text(bytes: [U8], at: Int) -> String Never! {
    end :: link_debug_cstr_end(bytes, at)
    if at < 0 || end > bytes.len() -> return ""
    String.from_bytes(bytes[at..<end - 1]) ?? ""
}
