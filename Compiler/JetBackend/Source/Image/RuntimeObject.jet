// ELF64 library objects share the hosted object's sections and relocations,
// but have no generated main. Only the manifest's MIR exports become global.
struct X64RuntimeExport {
    function: LIRFunctionID
    symbol: String
    init_priority: Int
    fini_priority: Int
}

fn x64_runtime_object(program: LIRModule, exports: [X64RuntimeExport]) -> X64ExecutableResult Never! {
    loop entry_row in exports {
        if entry_row.init_priority < 0 && entry_row.fini_priority < 0 -> next
        if entry_row.init_priority > 65535 || entry_row.fini_priority > 65535 {
            return X64ExecutableResult{bytes: [U8]{}, errors: [String]{"runtime lifecycle priority must be in 0..65535"}}
        }
        id :: entry_row.function.value
        if id < 0 || id >= program.functions.len() {
            return X64ExecutableResult{bytes: [U8]{}, errors: [String]{"runtime lifecycle function is not in the module"}}
        }
        signature :: lir_signature(program, program.functions[id].signature) ?? return X64ExecutableResult{bytes: [U8]{}, errors: [String]{"runtime lifecycle function has no signature"}}
        if signature.params.len() != 0 || signature.result != None {
            return X64ExecutableResult{bytes: [U8]{}, errors: [String]{"runtime lifecycle functions must take no parameters and return nothing"}}
        }
    }
    compiled :: x64_compile_module(program)
    if compiled.errors.len() > 0 {
        return X64ExecutableResult{bytes: [U8]{}, errors: compiled.errors}
    }
    x64_object_functions(program, compiled.functions, exports)
}
