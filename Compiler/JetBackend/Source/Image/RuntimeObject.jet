// ELF64 library objects share the hosted object's sections and relocations,
// but have no generated main. Only the manifest's exports become global.
// `guards` are the data ids of a lifecycle hook's guards (none: an
// unconditional hook): per guard, an array section of the hook names that
// data's section (Image/Object.jet).
X64RuntimeExport: struct {
    function: X64FunctionID,
    symbol: String,
    init_priority: Int{-1},
    fini_priority: Int{-1},
    guards: [Int]{[Int]{}},
}

// A global data symbol of a library object: the data object with id `data`,
// named `symbol`. A program's code reads it through an X64RelocTarget
// RuntimeData of that symbol, and so does the library's own code.
X64DataExport: struct {
    data: Int,
    symbol: String,
}

// The data symbol the runtime object exports its task registry's root as
// (JetRuntime Observe.jet observe_root, BuildLibrary.jet ir_build_library):
// `jet debug` finds it in a stopped program's symbol table to list its
// tasks (JetDebug Native.jet NativeSession.tasks_text).
X64_OBSERVE_ROOT_SYMBOL: "jet_rt_observe_root"

// The data symbol the runtime object exports its allocator's root as
// (JetRuntime Alloc.jet alloc_root, the address of its state page;
// BuildLibrary.jet ir_build_library): `jet debug` reads the program
// allocator's counting facts through it as the program exits (JetDebug
// Native.jet NativeSession.allocator_facts).
X64_ALLOC_ROOT_SYMBOL: "jet_rt_alloc_root"

// The allocator's words, the record/replay mode and stdout's direct switch
// by their module storage names (JetRuntime Alloc.jet, RecordReplay.jet,
// Host.jet), which the runtime object exports as the data symbols
// x64_debug_eval_symbols names (BuildLibrary.jet ir_build_library): `jet
// debug` writes them in a stopped program to route an evaluation's
// allocations to its own heap, pause a recording or replay and send its
// output past the program's stdout buffer, and puts them back after
// (JetDebug NativeEval.jet native_eval_routed). Nothing in the program
// writes them for it.
X64_DEBUG_EVAL_STORAGE: [String]{"alloc_class_limit", "alloc_check_take_code", "alloc_check_give_code", "replay_mode", "host_stdout_direct"}

// The data symbol the runtime object exports its word `storage`
// (X64_DEBUG_EVAL_STORAGE) as.
x64_debug_eval_symbol: fn(storage: String) -> String Never! { "jet_rt_{storage}" }

// The data symbols of X64_DEBUG_EVAL_STORAGE's words, in its order.
x64_debug_eval_symbols: fn() -> [String] Never! {
    loop storage in X64_DEBUG_EVAL_STORAGE -> x64_debug_eval_symbol(storage)
}

// The symbol a program built with debug views (IRChecks.debug_views) keeps
// the drop of a DebugView's [DebugItem] list as (JetIR Build.jet
// ir_build_program): `jet debug`, which calls a view in the stopped
// program, calls it on the list the view returned once it has read it
// (JetDebug NativeEval.jet native_eval_view).
X64_DEBUG_ITEMS_DROP_SYMBOL: "jet_debug_items_drop"
