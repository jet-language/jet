// ELF64 library objects share the hosted object's sections and relocations,
// but have no generated main. Only the manifest's exports become global.
// `guards` are the data ids of a lifecycle hook's guards (none: an
// unconditional hook): per guard, an array section of the hook names that
// data's section (Image/Object.jet).
X64RuntimeExport: struct {
    function: X64FunctionID
    symbol: String
    init_priority: Int{-1}
    fini_priority: Int{-1}
    guards: [Int]{[Int]{}}
}
