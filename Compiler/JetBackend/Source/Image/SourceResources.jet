// Canonical Source resource slot/loan/count transitions. The SAME slot owns
// actual T; no parallel payload table, raw-pointer owner or public Scope API.
// These logical receipts are NOT managed external leases. Instantiating T for
// native cells requires the actual qualified Source owner/Meta/code supplier.
// Native operation/frame/escaping-alias guards are not established by these
// logical Read/Write tickets alone. Native callers must pair the real managed
// carrier's complete guards before instantiating this table for native T.
use jet_foundation.[MIRArtifactID, MIRType, mir_type_same_checked_type]

#Error
struct NativeSourceResourceError { message: String }
fn native_source_error(message: ^String) -> NativeSourceResourceError Never! {
    NativeSourceResourceError{message: ^message}
}

struct NativeSourceBindingIdentity {
    scope: Int
    thread: Int
    artifact: MIRArtifactID
    ty: MIRType
    kind: Int
}
struct NativeSourceCapability {
    scope: Int
    slot: Int
    generation: Int
}
enum NativeSourceLoanMode { Read Write }
struct NativeSourceLoanReceipt {
    capability: NativeSourceCapability
    id: Int
    mode: NativeSourceLoanMode
}
struct NativeSourceRootReceipt { scope: Int id: Int }
struct NativeSourceSlot<T> {
    capability: NativeSourceCapability
    binding: NativeSourceBindingIdentity
    loans: [NativeSourceLoanReceipt]
    payload: T
}
struct NativeSourceArena<T> {
    scope: Int
    thread: Int
    next_slot: Int
    next_generation: Int
    next_loan: Int
    next_root: Int
    roots: [NativeSourceRootReceipt]
    slots: [NativeSourceSlot<T>]
    retirement_requested: Bool
}
struct NativeSourceTakenSlot<T> {
    consumed: NativeSourceCapability
    slot: NativeSourceSlot<T>
}
enum NativeSourceRegistration<T> {
    Registered(capability: NativeSourceCapability)
    Refused(binding: NativeSourceBindingIdentity, payload: T, error: NativeSourceResourceError)
}
enum NativeSourceRetirement<T> {
    Waiting(arena: NativeSourceArena<T>)
    Ready(arena: NativeSourceArena<T>)
    Refused(arena: NativeSourceArena<T>, error: NativeSourceResourceError)
}

// The controlled owner producer creates the actual arena. Logical scope or
// thread DATA cannot create an executing image, Source owner or native cell.
fn native_source_arena<T>(scope: Int, thread: Int) -> NativeSourceArena<T> Never! {
    NativeSourceArena<T>{scope: scope, thread: thread, next_slot: 1,
        next_generation: 1, next_loan: 1, next_root: 1,
        roots: [NativeSourceRootReceipt]{}, slots: [NativeSourceSlot<T>]{},
        retirement_requested: false}
}
fn native_source_check_thread<T>(arena: NativeSourceArena<T>, thread: Int) NativeSourceResourceError! {
    if thread != arena.thread -> return Err(native_source_error("Source resource thread mismatch"))
    Ok()
}
fn native_source_same_capability(left: NativeSourceCapability, right: NativeSourceCapability) -> Bool Never! {
    left.scope == right.scope && left.slot == right.slot && left.generation == right.generation
}
fn native_source_slot_row<T>(arena: NativeSourceArena<T>, capability: NativeSourceCapability,
        expected: NativeSourceBindingIdentity) -> Int NativeSourceResourceError! {
    native_source_check_thread(arena, expected.thread)
    if capability.scope != arena.scope || expected.scope != arena.scope -> return Err(native_source_error("Source resource scope mismatch"))
    loop index in 0..<arena.slots.len() {
        if arena.slots[index].capability.slot != capability.slot -> next
        if !native_source_same_capability(arena.slots[index].capability, capability) -> return Err(native_source_error("Source resource generation mismatch"))
        if arena.slots[index].binding.kind != expected.kind || arena.slots[index].binding.artifact != expected.artifact -> return Err(native_source_error("Source resource kind or artifact mismatch"))
        if !mir_type_same_checked_type(arena.slots[index].binding.ty, expected.ty) -> return Err(native_source_error("Source resource checked type mismatch"))
        return Ok(index)
    }
    Err(native_source_error("stale or unknown Source resource capability"))
}

// Caller supplies genuine owned T. This allocates only logical registration;
// it does not qualify T, create a native object or grant authority from DATA.
fn native_source_registration_refused<T>(binding: ^NativeSourceBindingIdentity,
        payload: ^T, error: ^NativeSourceResourceError) -> NativeSourceRegistration<T> Never! {
    NativeSourceRegistration<T>.Refused{binding: ^binding, payload: ^payload, error: ^error}
}
fn native_source_register<T>(arena: &NativeSourceArena<T>, binding: ^NativeSourceBindingIdentity,
        payload: ^T) -> NativeSourceRegistration<T> Never! {
    if binding.thread != arena.thread -> return native_source_registration_refused(^binding, ^payload, native_source_error("Source resource thread mismatch"))
    if binding.scope != arena.scope -> return native_source_registration_refused(^binding, ^payload, native_source_error("Source resource scope mismatch"))
    if arena.retirement_requested -> return native_source_registration_refused(^binding, ^payload, native_source_error("Source resource retirement has been requested"))
    capability :: NativeSourceCapability{scope: arena.scope, slot: arena.next_slot, generation: arena.next_generation}
    arena.next_slot += 1
    arena.next_generation += 1
    &arena.slots.push(NativeSourceSlot<T>{capability: capability, binding: ^binding,
        loans: [NativeSourceLoanReceipt]{}, payload: ^payload})
    NativeSourceRegistration<T>.Registered{capability: capability}
}
fn native_source_borrow<T>(arena: &NativeSourceArena<T>, capability: NativeSourceCapability,
        expected: NativeSourceBindingIdentity, mode: NativeSourceLoanMode) -> NativeSourceLoanReceipt NativeSourceResourceError! {
    index :: native_source_slot_row(arena, capability, expected)
    if mode == .Write && arena.slots[index].loans.len() != 0 -> return Err(native_source_error("Source resource is already borrowed"))
    loop loan_index in 0..<arena.slots[index].loans.len() {
        if arena.slots[index].loans[loan_index].mode == .Write -> return Err(native_source_error("Source resource is exclusively borrowed"))
    }
    receipt :: NativeSourceLoanReceipt{capability: capability, id: arena.next_loan, mode: mode}
    arena.next_loan += 1
    &arena.slots[index].loans.push(receipt)
    Ok(receipt)
}
fn native_source_release_loan<T>(arena: &NativeSourceArena<T>, receipt: NativeSourceLoanReceipt,
        expected: NativeSourceBindingIdentity) NativeSourceResourceError! {
    index :: native_source_slot_row(arena, receipt.capability, expected)
    loop loan_index in 0..<arena.slots[index].loans.len() {
        if arena.slots[index].loans[loan_index].id != receipt.id -> next
        if arena.slots[index].loans[loan_index].mode != receipt.mode -> return Err(native_source_error("Source resource loan mode mismatch"))
        _ := &arena.slots[index].loans.remove(loan_index, .Slot)
        return Ok()
    }
    Err(native_source_error("stale or already released Source resource loan"))
}

// Whole-slot removal is the canonical list .Slot MOVE, not get()/Clone or
// caret-field copy. The controlled caller retains actual T through hooks and
// owns the post-take consumed receipt, including later adoption failure.
fn native_source_take_slot<T>(arena: &NativeSourceArena<T>, capability: NativeSourceCapability,
        expected: NativeSourceBindingIdentity) -> NativeSourceTakenSlot<T> NativeSourceResourceError! {
    index :: native_source_slot_row(arena, capability, expected)
    if arena.slots[index].loans.len() != 0 -> return Err(native_source_error("Source resource owner has active loans"))
    slot := &arena.slots.remove(index, .Slot) ?? panic("validated Source slot disappeared during exclusive edit")
    Ok(NativeSourceTakenSlot<T>{consumed: capability, slot: ^slot})
}
fn native_source_retain_root<T>(arena: &NativeSourceArena<T>, thread: Int) -> NativeSourceRootReceipt NativeSourceResourceError! {
    native_source_check_thread(arena, thread)
    if arena.retirement_requested -> return Err(native_source_error("Source resource retirement has been requested"))
    receipt :: NativeSourceRootReceipt{scope: arena.scope, id: arena.next_root}
    arena.next_root += 1
    &arena.roots.push(receipt)
    Ok(receipt)
}
fn native_source_release_root<T>(arena: &NativeSourceArena<T>, thread: Int,
        receipt: NativeSourceRootReceipt) NativeSourceResourceError! {
    native_source_check_thread(arena, thread)
    if receipt.scope != arena.scope -> return Err(native_source_error("Source resource root scope mismatch"))
    loop index in 0..<arena.roots.len() {
        if arena.roots[index].id != receipt.id -> next
        _ := &arena.roots.remove(index, .Slot)
        return Ok()
    }
    Err(native_source_error("stale or already released Source resource root"))
}
fn native_source_request_retirement<T>(arena: &NativeSourceArena<T>, thread: Int) NativeSourceResourceError! {
    native_source_check_thread(arena, thread)
    arena.retirement_requested = true
    Ok()
}
fn native_source_retirement_unborrowed<T>(arena: NativeSourceArena<T>) -> Bool Never! {
    if !arena.retirement_requested || arena.roots.len() != 0 -> return false
    loop index in 0..<arena.slots.len() {
        if arena.slots[index].loans.len() != 0 -> return false
    }
    true
}
fn native_source_retirement_ready<T>(arena: NativeSourceArena<T>, thread: Int) -> Bool NativeSourceResourceError! {
    native_source_check_thread(arena, thread)
    Ok(native_source_retirement_unborrowed(arena))
}

// Transfers the WHOLE actual owned arena to the real finalization caller.
// Ready is policy readiness, NOT successful drop/fini/unmap. Waiting preserves
// all actual owned payloads. No hooks or fake finalizer run under this edit.
fn native_source_prepare_retirement<T>(arena: ^NativeSourceArena<T>, thread: Int) -> NativeSourceRetirement<T> Never! {
    if thread != arena.thread -> return NativeSourceRetirement<T>.Refused{arena: ^arena, error: native_source_error("Source resource thread mismatch")}
    ready :: native_source_retirement_unborrowed(arena)
    if {
        ready -> NativeSourceRetirement<T>.Ready{arena: ^arena}
        else -> NativeSourceRetirement<T>.Waiting{arena: ^arena}
    }
}
