// The emission boundary: what a code generator hands the object writer
// (Object.jet), its DWARF (Dwarf.jet) and the linkers. Compiled functions
// carry their machine code, relocations and debug facts; the module carries
// its read-only data objects, its debug files and types, and each function's
// source facts.

X64FunctionID: struct {
    value: Int,
}

X64DataID: struct {
    value: Int,
}

// Relocation target kinds (plain Int constants; zero payload-enum heap boxing).
X64_RELOC_FUNCTION: 0

X64_RELOC_DATA: 1

X64_RELOC_RUNTIME: 2

X64_RELOC_RUNTIME_DATA: 3

// A rel32 field at `at` (offset in the function's code) that must hold the
// distance from the end of the field to its target. Unboxed value struct:
// for X64_RELOC_FUNCTION and X64_RELOC_DATA, `target` is the function or data
// row id and `symbol` is ""; for X64_RELOC_RUNTIME and X64_RELOC_RUNTIME_DATA,
// `symbol` names the runtime symbol (or "" when `target >= 0` indexes
// X64ObjectModule.runtime_symbols).
X64Reloc: struct {
    at: Int,
    kind: Int,
    target: Int,
    symbol: String{""},
}

#Inline(Always) x64_reloc_function: fn(at: Int, id: Int) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_FUNCTION, target: id}
}

#Inline(Always) x64_reloc_data: fn(at: Int, id: Int) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_DATA, target: id}
}

#Inline(Always) x64_reloc_runtime: fn(at: Int, symbol: String) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_RUNTIME, target: -1, symbol: symbol}
}

#Inline(Always) x64_reloc_runtime_id: fn(at: Int, id: Int) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_RUNTIME, target: id}
}

#Inline(Always) x64_reloc_runtime_data: fn(at: Int, symbol: String) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_RUNTIME_DATA, target: -1, symbol: symbol}
}

#Inline(Always) x64_reloc_runtime_data_id: fn(at: Int, id: Int) -> X64Reloc Never! {
    X64Reloc{at: at, kind: X64_RELOC_RUNTIME_DATA, target: id}
}

#Inline(Always) x64_reloc_symbol: fn(reloc: X64Reloc, runtime_symbols: [String]) -> String Never! {
    if reloc.symbol != "" -> return reloc.symbol
    if reloc.target >= 0 && reloc.target < runtime_symbols.len() -> return runtime_symbols[reloc.target]
    ""
}

// `align`: the function's start alignment in `.text`, a power of two of at
// least X64_FUNCTION_ALIGN; code inside it aligned to `align` stays aligned.
// `zones`: the offset of each patchable zone site in `code` (JetIR
// X64Select.jet ir_x64_zone_stub), which a program's link lists for the
// runtime to patch in a part note (Image/StaticLink.jet link_zone_write), as
// a library's site table does (JetIR X64Module.jet ir_x64_zone_sites).
// While zones are off a site is `test eax, imm32`, over the rel32 of the
// `jmp` the runtime turns it into while they are on: to the site's stub, laid
// out after the function's epilogue, which ends where `zone_ends` (one per
// site) says.
X64CompiledFunction: struct {
    id: X64FunctionID,
    name: String,
    code: [U8],
    relocs: [X64Reloc],
    align: Int,
    zones: [Int]{[Int]{}},
    zone_ends: [Int]{[Int]{}},
}

// Debug facts of one compiled function for Image/Dwarf.jet: a line row
// where each run of code from one source line starts, the end of the
// prologue, the call frame instructions of its FDE, and where each debug
// variable lives over which code range.
//
// A `call` row (DWARF's is_stmt false) is no statement's start: one is at
// each call instruction with a call-site row (JetIR BuildCallSites.jet),
// naming the line and character column of the source node whose lowering
// made the call, so a caller's frame, looked up at its return address - 1,
// stands at its call. Another at the return goes back to the statement's
// line, column 0 (its first node). Breakpoints and steps read only the
// other rows; `.debug_line` holds only those.
X64LineRow: struct {
    at: Int,
    line: Int,
    column: Int{0},
    call: Bool{false},
}

// A register (hardware number; xmm n as 16 + n), a frame slot at `offset`
// from rbp, the frame address rbp + `offset` itself (a StackSlot's
// address), a constant `value`, or the value the parameter register `reg`
// held when the function was entered (its caller's argument, which the
// debugger reads from the caller's X64CallArgument for that register).
X64DebugLocation: enum {
    Register(reg: Int),
    Frame(offset: Int),
    FrameAddress(offset: Int),
    Constant(value: Int),
    EntryValue(reg: Int),
}

// X64FunctionSource.variables[variable] is at `location` for code offsets
// start..<end.
X64VariableRange: struct {
    variable: Int,
    start: Int,
    end: Int,
    location: X64DebugLocation,
}

// The code offsets start..<end hold code of inline site `site` (a row of
// X64FunctionSource.inlines, from 1) or of a site nested in it.
X64InlineRange: struct {
    site: Int,
    start: Int,
    end: Int,
}

// A call that allocates a heap block in a `--checked-alloc` image: its
// return address `at` (an offset in the function's code) and the type row
// (X64ModuleDebug.types) of what the block holds, which `jet perf` names a
// heap snapshot's blocks by (a DW_TAG_call_site, Image/Dwarf.jet).
X64AllocSite: struct {
    at: Int,
    ty: Int,
}

// A call whose caller still holds some of its arguments while it runs: its
// return address `at` (an offset in the function's code), the line and
// character column of the source node whose lowering made it, and each such
// argument, which `jet debug` reads a callee's parameter's entry value from
// (a DW_TAG_call_site, Image/Dwarf.jet). A call's own place is its call row
// (X64LineRow.call).
X64CallSite: struct {
    at: Int,
    line: Int,
    column: Int,
    arguments: [X64CallArgument]{[X64CallArgument]{}},
}

// An argument a call passes in register `reg` (hardware number) and where
// its caller still holds its value while the call runs: a constant, a
// callee-saved register, a frame slot or a frame address (a
// DW_TAG_call_site_parameter).
X64CallArgument: struct {
    reg: Int,
    value: X64DebugLocation,
}

X64FunctionDebug: struct {
    lines: [X64LineRow],
    body: Int,
    cfi: [U8],
    ranges: [X64VariableRange],
    // The most stack the function's own code holds at once, its return
    // address included and its callees' frames not: `jet inspect memory`
    // adds these up along the call graph (JetIR X64Stack.jet).
    stack: Int{0},
    // Whether it calls through a function value, whose targets the call
    // graph does not name.
    dynamic: Bool{false},
    // The runs of inlined code, by start, each run before the runs nested
    // in it; the slow paths after the epilogue are the function's own code.
    inlines: [X64InlineRange]{[X64InlineRange]{}},
    // The allocating calls (X64AllocSite), by return address.
    allocs: [X64AllocSite]{[X64AllocSite]{}},
    // The calls whose caller keeps arguments (X64CallSite), by return
    // address.
    calls: [X64CallSite]{[X64CallSite]{}},
}

// The source types of the debug variables, described by their machine
// layout.
X64DebugEncoding: enum {
    Signed,
    Unsigned,
    Float,
    Bool,
    Char,
}

X64DebugMember: struct {
    name: String,
    offset: Int,
    ty: Int,
}

X64DebugEnumerator: struct {
    name: String,
    value: Int,
}

// One variant of a value whose type has a variant part: `member` is what
// the value holds while its discriminant is `value` (None: any value no
// other variant names).
X64DebugVariant: struct {
    value: Int?,
    member: X64DebugMember,
}

// Type references are rows of X64ModuleDebug.types; -1 is no type (an
// untyped pointer). `Opaque` has a name and size but no known contents.
// `Variants` is a struct of its `discriminant` member and a variant part
// (DW_TAG_variant_part) that the discriminant's value selects in.
X64DebugTypeKind: enum {
    Base(encoding: X64DebugEncoding),
    Pointer(target: Int),
    Struct(members: [X64DebugMember]),
    Union(members: [X64DebugMember]),
    Enum(enumerators: [X64DebugEnumerator]),
    Variants(discriminant: X64DebugMember, variants: [X64DebugVariant]),
    Typedef(target: Int),
    Opaque,
}

X64DebugType: struct {
    name: String,
    size: Int,
    kind: X64DebugTypeKind,
}

// A source variable: a parameter or a named local. `indirect` when the
// carried value is the address of the variable's bytes (an inline aggregate)
// rather than the variable itself. `site`: the inline site it belongs to
// (X64FunctionSource.inlines, from 1), 0 for the function's own.
X64DebugVariable: struct {
    name: String,
    ty: Int,
    line: Int,
    parameter: Bool,
    indirect: Bool,
    site: Int{0},
}

// `directory` is the compilation directory relative `files` resolve
// against; "" leaves that to the debugger (its working directory). `level`
// is the optimization level the code was built at, which the unit's
// producer names (`Jet native backend (O2)`). `sources`: the sources the
// module was compiled from, which the image records (Dwarf.jet
// dwarf_sources).
X64ModuleDebug: struct {
    directory: String,
    files: [String],
    types: [X64DebugType],
    level: Int{0},
    sources: [X64DebugSource]{[X64DebugSource]{}},
}

// A source a module was compiled from: its path relative to the entry
// package's root, as the compile names it, and the sha256 of its text.
X64DebugSource: struct {
    path: String,
    digest: [U8],
}

// Read-only module objects, including immutable aggregate constant trees.
X64DataReloc: struct {
    offset: Int,
    target: X64DataID,
    addend: Int,
}

// `read_only`: no code writes the object (a text row's bytes). The object
// writer puts such an object in `.rodata`, which loads read-only, when it
// holds no address word; every other object is writable `.data`.
// `cold`: only code on its way to a stop reads it (a bounds stop's site, a
// `panic` report's texts), so the object writer lays it after the objects
// running code reads (Object.jet x64_object_lay).
X64Data: struct {
    id: X64DataID,
    bytes: [U8],
    align: Int,
    relocs: [X64DataReloc],
    read_only: Bool{false},
    cold: Bool{false},
}

// The source facts of one compiled function: `file` is a row of
// X64ModuleDebug.files, -1 for generated code (glue, helpers, the generated
// entry), which has no source name or variables. `inlines[s - 1]` is inline
// site s of its optimized body.
X64FunctionSource: struct {
    name: String,
    file: Int,
    line: Int,
    variables: [X64DebugVariable],
    inlines: [X64InlineSite]{[X64InlineSite]{}},
}

// A function inlined into a compiled one (JetIR OptInline.jet): its row in
// the module (-1 when unknown), which identifies it across sites, its name,
// file (a row of X64ModuleDebug.files, -1 for generated code) and
// declaration line, the site it was inlined in (0: the compiled function's
// own code) and the line of the call there.
X64InlineSite: struct {
    function: Int,
    name: String,
    file: Int,
    line: Int,
    parent: Int,
    call_line: Int,
}

x64_function_source_none: fn() -> X64FunctionSource Never! {
    X64FunctionSource{name: "", file: -1, line: 0, variables: [X64DebugVariable]{}}
}

// What the object writer reads besides the compiled functions: the data
// objects (`data[i].id.value == i`), the debug files and types, and the
// source facts of the function with id `i` at `functions[i]`.
X64ObjectModule: struct {
    data: [X64Data],
    debug: X64ModuleDebug,
    functions: [X64FunctionSource],
    runtime_symbols: [String]{[String]{}},
}
