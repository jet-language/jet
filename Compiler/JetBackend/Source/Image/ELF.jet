// ELF64 output for x86-64 Linux: a static executable whose read+execute
// PT_LOAD segment maps the headers and code at ELF64_BASE_ADDRESS. A module
// with data gets a second, read+write PT_LOAD for it: Image/Link.jet starts
// the data on a page of its own (x64_link_text `data_page`), and startup
// fixups (Lower/Statics.jet) store runtime handles into it. No page is both
// writable and executable. Section headers are omitted; the kernel loads
// executables from program headers alone.

ELF64_HEADER_SIZE :: prep { 64 }
struct X64ExecutableResult {
    bytes: [U8]
    errors: [String]
}

fn elf64_u16(bytes: &[U8], value: Int) Never! {
    loop shift in 0..<2 -> &bytes.push(U8{((value >> (8 * shift))).bit_and(255)})
}

fn elf64_u32(bytes: &[U8], value: Int) Never! {
    loop shift in 0..<4 -> &bytes.push(U8{((value >> (8 * shift))).bit_and(255)})
}

fn elf64_u64(bytes: &[U8], value: Int) Never! {
    loop shift in 0..<8 -> &bytes.push(U8{((value >> (8 * shift))).bit_and(255)})
}
