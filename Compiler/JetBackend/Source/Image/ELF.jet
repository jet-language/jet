// ELF64 output for x86-64 Linux: a static executable whose read+execute
// PT_LOAD segment maps the headers and code at ELF64_BASE_ADDRESS. A module
// with data gets a second, read+write PT_LOAD for it: Image/Link.jet starts
// the data on a page of its own (x64_link_text `data_page`), and startup
// fixups store runtime handles into it. No page is both writable and
// executable. Section headers are omitted; the kernel loads executables from
// program headers alone.

ELF64_HEADER_SIZE: 64
X64ExecutableResult: struct {
    bytes: [U8]
    errors: [String]
    // Of a link that stopped at its undefined symbols (StaticLink.jet
    // link_executable_image): each global live code references and nothing
    // defines, once, in scan order; each has its row in `errors`.
    undefined: [String]{[String]{}}
}

// Little-endian words, byte by byte without a loop: each `U8{x & 255}` is a
// plain move (OptSimplify fold), so a word is its pushes alone.
elf64_u16: fn(bytes: &[U8], value: Int) Never! {
    bytes.push(U8{value.bit_and(255)})
    bytes.push(U8{(value >> 8).bit_and(255)})
}

elf64_u32: fn(bytes: &[U8], value: Int) Never! {
    elf64_u16(bytes, value)
    elf64_u16(bytes, value >> 16)
}

elf64_u64: fn(bytes: &[U8], value: Int) Never! {
    elf64_u32(bytes, value)
    elf64_u32(bytes, value >> 32)
}
