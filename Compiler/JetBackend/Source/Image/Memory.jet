// In-memory x86-64 images: the compiled module laid out as one
// position-independent block that a loader maps into the running process and
// calls, the way Cranelift's JIT module finalizes its definitions. Calls
// between compiled functions and data addresses are resolved inside the
// block. Every runtime call goes to an import stub at the end of the code,
//
//     jmp qword [rip + 2]; int3; int3; <8-byte slot>
//
// whose slot holds the address of the compiled runtime's C-ABI export of that
// name. The block's absolute origin must meet `align`; every import slot is
// then 8-byte aligned and can later be swapped with one store.
//
// Loading (the host primitive, in the loading process):
// 1. map `text.len()` bytes read+write at an `align`-aligned origin and copy
//    `text` in (over-map and trim whole pages when align exceeds a page);
// 2. rebase every data pointer in `relocs` to base+target, and write the address
//    of `imports[i]` into the word at `slots[i]`;
// 3. flip the code pages to read+execute; data stays read+write on disjoint
//    pages (no page is ever writable and executable at once);
// 4. run `jet_rt_main(base + entry)` for a program entry, or invoke the typed
//    call adapter for a compiler function.

use jet_foundation.mir_shared_site_getter_symbol

pub struct X64MemoryImage {
    pub text: [U8]
    // Required alignment of the mapping's absolute origin.
    pub align: Int
    // Offset of the entry function in `text`.
    pub entry: Int
    // Optional zero-argument Unit finalizer, run before unmapping.
    pub finalizer: Int?
    // Compiler-owned callable offsets, keyed by LIR identity. These remain
    // child-local after loading and let typed ownership glue share one image.
    pub functions: [Int]{[Int]{}}
    // Only the canonical pinned Core producer fills these checked code offsets.
    // Dynamic images import the getters and export no site storage of their own.
    pub exports: [String:Int]{[String:Int]{}}
    // First data byte, page-aligned when data exists; text.len() otherwise.
    pub data_offset: Int
    // imports[i] names a runtime symbol; slots[i] is the offset in `text` of
    // the little-endian word that must hold its address.
    pub imports: [String]
    pub slots: [Int]
    pub relocs: [X64ImageDataReloc]
    pub errors: [String]
}

// Offset of the address slot inside an import stub.
X64_IMPORT_SLOT_AT :: prep { 8 }

fn x64_memory_image_failure(errors: [String]) -> X64MemoryImage Never! {
    X64MemoryImage{text: [U8]{}, align: X64_FUNCTION_ALIGN, entry: -1, finalizer: None, data_offset: 0, imports: [String]{}, slots: [Int]{}, relocs: [X64ImageDataReloc]{}, errors: errors}
}

fn x64_import_stub(symbol: String) -> X64CompiledFunction Never! {
    code := [U8]{}
    // jmp qword [rip + 2] (FF 25 disp32), past the two traps to the slot.
    jump :: [Int]{0xff, 0x25, 2, 0, 0, 0}
    loop byte in jump -> &code.push(U8{byte})
    x64_int3(&code)
    x64_int3(&code)
    loop _ in 0..<8 -> &code.push(U8{0})
    X64CompiledFunction{id: LIRFunctionID{value: -1}, name: symbol, code: code, relocs: [X64Reloc]{}}
}

// Compile `program` into an in-memory image whose entry is `entry`, which
// takes no parameters and returns nothing.
pub fn x64_memory_image(program: LIRModule, entry: LIRFunctionID) -> X64MemoryImage Never! {
    if entry.value < 0 || entry.value >= program.functions.len() -> return x64_memory_image_failure([String]{"entry function {entry.value} is not in the module"})
    signature :: lir_signature(program, program.functions[entry.value].signature) ?? return x64_memory_image_failure([String]{"entry function has no signature"})
    returns_nothing := false
    if signature.result == None -> returns_nothing = true
    if signature.params.len() != 0 || !returns_nothing -> return x64_memory_image_failure([String]{"entry function {program.functions[entry.value].name} must take no parameters and return nothing"})
    x64_memory_function_image(program, entry, None)
}

// Only lir_lower_core_shared supplies this inventory and its explicit
// no-argument Unit startup. Startup initializes static fixups, not user roots;
// the host invokes it once before publishing this permanently pinned image.
pub fn x64_memory_core_shared_image(lowered: LIRLowering) -> X64MemoryImage Never! {
    if lowered.issues.len() > 0 {
        errors :: loop issue in lowered.issues -> "pinned Core lowering: {issue.message}"
        return x64_memory_image_failure(errors)
    }
    if lowered.shared_sites.len() == 0 -> return x64_memory_image_failure([String]{"pinned Core has no shared getter exports"})
    entry :: lowered.entry ?? return x64_memory_image_failure([String]{"pinned Core has no static initialization entry"})
    image := x64_memory_image(lowered.lir, entry)
    if image.errors.len() > 0 -> return image
    initializers := [U64:String]{}
    loop row in lowered.shared_sites {
        if row.site_key == "" -> return x64_memory_image_failure([String]{"pinned Core getter {row.symbol} has no SiteKey"})
        expected :: mir_shared_site_getter_symbol(row.initializer)
        if row.symbol != expected -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} has noncanonical getter {row.symbol}; expected {expected}"})
        if initializers.get(row.initializer.value) == .Val(prior) {
            if prior != row.site_key -> return x64_memory_image_failure([String]{"pinned Core initializer {row.initializer.value} names different SiteKeys {prior} and {row.site_key}"})
        }
        if image.exports.get(row.symbol) != None -> return x64_memory_image_failure([String]{"duplicate pinned Core getter {row.symbol} for SiteKey {row.site_key}"})
        if row.function.value < 0 || row.function.value >= lowered.lir.functions.len() || row.function.value >= image.functions.len() {
            return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter function {row.function.value} is not in the compiled image"})
        }
        function :: lowered.lir.functions[row.function.value]
        if function.id != row.function -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter function identity does not match its module row"})
        signature :: lir_signature(lowered.lir, function.signature) ?? return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter has no signature"})
        result :: signature.result ?? return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter has no owned handle result"})
        integer_result :: result.class == .Integer || result.class == .Pointer
        if signature.convention != .SystemV || signature.params.len() != 0 || result.size != 8 || result.align != 8 || !integer_result {
            return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter must take no arguments and return an eight-byte owned handle"})
        }
        // functions[] was populated by matching compiled function IDs to
        // x64_link_text's offsets, never by MIR IDs or guessed byte positions.
        at :: image.functions[row.function.value]
        if at < 0 || at >= image.data_offset -> return x64_memory_image_failure([String]{"pinned Core SiteKey {row.site_key} getter was not compiled into executable code"})
        &image.exports.add(row.symbol, at).drop("checked absent above")
        if initializers.get(row.initializer.value) == None -> &initializers.add(row.initializer.value, row.site_key).drop("checked absent above")
    }
    image
}

// Compile a function with its checked System V signature. Invocation must use
// an adapter that obeys that signature, never the program's jet_rt_main boundary.
fn x64_memory_function_image(program: LIRModule, entry: LIRFunctionID, finalizer: LIRFunctionID?) -> X64MemoryImage Never! {
    if entry.value < 0 || entry.value >= program.functions.len() -> return x64_memory_image_failure([String]{"entry function {entry.value} is not in the module"})
    if finalizer == .Val(id) {
        if id.value < 0 || id.value >= program.functions.len() -> return x64_memory_image_failure([String]{"finalizer function {id.value} is not in the module"})
        signature :: lir_signature(program, program.functions[id.value].signature) ?? return x64_memory_image_failure([String]{"finalizer function has no signature"})
        if signature.params.len() != 0 || signature.result != None -> return x64_memory_image_failure([String]{"finalizer must take no parameters and return nothing"})
    }
    compiled :: x64_compile_module(program)
    if compiled.errors.len() > 0 -> return x64_memory_image_failure(compiled.errors)

    // One import per runtime symbol the code calls, in first-use order.
    imports := [String]{}
    import_rows := [String:Bool]{}
    loop function in compiled.functions {
        loop reloc in function.relocs {
            if reloc.target == {
                .Runtime(symbol) -> {
                    if import_rows.get(symbol) == None {
                        &import_rows.add(symbol, true).drop("checked absent above")
                        &imports.push(symbol)
                    }
                }
                else -> {}
            }
        }
    }
    stubs := [X64CompiledFunction]{}
    loop symbol in imports -> &stubs.push(x64_import_stub(symbol))
    linked :: x64_link_text(compiled.functions, stubs, program.data, true)
    if linked.errors.len() > 0 -> return x64_memory_image_failure(linked.errors)

    entry_at := -1
    loop (index, function) in compiled.functions { if function.id == entry -> entry_at = linked.offsets[index] }
    if entry_at < 0 -> return x64_memory_image_failure([String]{"entry function {entry.value} was not compiled"})
    slots := [Int]{}
    loop at in linked.runtime_offsets -> &slots.push(at + X64_IMPORT_SLOT_AT)
    finalizer_at := Int?{None}
    if finalizer == .Val(id) {
        loop (index, function) in compiled.functions {
            if function.id == id -> finalizer_at = Val(linked.offsets[index])
        }
        if finalizer_at == None -> return x64_memory_image_failure([String]{"finalizer function {id.value} was not compiled"})
    }
    function_offsets := [Int]{}
    loop _ in 0..<program.functions.len() -> &function_offsets.push(-1)
    loop (index, function) in compiled.functions -> function_offsets[function.id.value] = linked.offsets[index]
    X64MemoryImage{text: linked.text, align: linked.align, entry: entry_at, finalizer: finalizer_at, functions: function_offsets, data_offset: linked.data_offset, imports: imports, slots: slots, relocs: linked.data_relocs, errors: [String]{}}
}
