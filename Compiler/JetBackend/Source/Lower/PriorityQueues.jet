// PriorityQueue<T> is a binary max-heap in the owned List header/buffer.
// Heap swaps move bytes (never clone owners); all retirement uses List glue.
// Reference: Prelude/Core/Collections.rs jet_priority_queue_* uses BinaryHeap.
// Ord-equal values have unspecified identity order; native derived Ord compares
// every stored member, so equal keys have identical observable payloads here.
// TextValues.rs BinaryHeap Display/Debug and Values.rs Show sort highest-first.
use jet_foundation.[
    MIRCallArg, MIRInstruction, MIRPlaceID, MIRPreludeCall, MIRPreludeCallID,
    MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_nominal_ref, mir_type_from_kind,
]

fn lower_priority_queue_element(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .Apply(name, args) -> if name.id == mir_nominal_ref("PriorityQueue").id && args.len() == 1 -> Val(args[0]) else -> None
        .Tagged(_, inner) -> lower_priority_queue_element(inner)
        else -> None
    }
}

fn lower_priority_queue_list(elem: MIRType) -> MIRType {
    mir_type_from_kind(MIRTypeKind.List{inner: elem})
}

fn lower_priority_queue_repr(p: MIRProgram, ty: MIRType, elem: MIRType) -> LowerRepr Never! {
    if lower_map_key_kind(p, elem) == "" -> return LowerRepr.Unsupported{reason: "PriorityQueue element has no native Ord"}
    if lower_priority_queue_custom_order(p, elem) -> return LowerRepr.Unsupported{reason: "PriorityQueue user-defined Comparable ordering is not lowered at O0 yet"}
    lower_list_repr(p, ty, elem)
}

// Do not substitute structural order for a checked user Comparable impl,
// including one on a member of a derived aggregate key.
fn lower_priority_queue_custom_order(p: MIRProgram, ty: MIRType) -> Bool Never! {
    loop implementation in p.impls {
        bound :: implementation.trait_ref ?? next
        if bound.name != "Comparable" -> next
        if mir_type_same_checked_type(implementation.self_type, ty) || lower_nominal_impl_template(p, implementation.self_type, ty) -> return true
    }
    if ty.kind == .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return lower_priority_queue_custom_order(p, inner)
    if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Alias(base) | .Distinct(base, _) -> return lower_priority_queue_custom_order(p, base)
    }
    if lower_is_inline(p, ty) {
        loop member in lower_inline_members(p, ty) {
            if lower_priority_queue_custom_order(p, member.ty) -> return true
        }
    }
    false
}

fn lower_priority_queue_from(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, source_id: MIRValueID) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "PriorityQueue construction has no checked type")
    elem :: lower_priority_queue_element(ty) ?? return lower_fail(&m, &f, "PriorityQueue construction has no checked element")
    source_ty :: lower_value_type(c, source_id) ?? return
    if lower_list_element(source_ty) != Val(elem) -> return lower_fail(&m, &f, "PriorityQueue source is not its element List")
    source :: lower_use(&m, &f, source_id) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    if lower_value_owned(c, source_id) {
        lower_copy_bytes(&f, dst, 0, source, 0, 24)
        zero :: lower_const(&f, 0)
        offsets :: [Int]{0, 8, 16}
        loop offset in offsets -> lower_emit(&f, LIRInst.Store{base: source, offset: offset, value: zero})
    } else {
        lower_inline_clone(p, &m, &f, source, dst, lower_priority_queue_list(elem))
    }
    lower_call_helper(&m, &f, "priority_queue.heapify", ty, [LIRValueID]{dst}, None)
}

fn lower_priority_queue_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    ty :: lower_checked_type(c, instruction) ?? return false
    if lower_priority_queue_element(ty) == None -> return false
    row :: lower_prelude_row(p, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    if symbol == "jet_priority_queue_from" && args.len() == 1 {
        lower_priority_queue_from(p, c, &m, &f, instruction, args[0].value)
        return true
    }
    if symbol != "std::collections::BinaryHeap::new" || args.len() != 0 -> return false
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, ty)
    zero :: lower_const(&f, 0)
    offsets :: [Int]{0, 8, 16}
    loop offset in offsets -> lower_emit(&f, LIRInst.Store{base: dst, offset: offset, value: zero})
    true
}

fn lower_priority_queue_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    symbol :: lower_runtime_symbol(row)
    if symbol == "jet_priority_queue_from" && args.len() == 0 {
        lower_priority_queue_from(p, c, &m, &f, instruction, receiver)
        return true
    }
    ty :: lower_value_type(c, receiver) ?? return false
    elem :: lower_priority_queue_element(ty) ?? return false
    if row.family != .BuiltinMethod || row.module_name != "core.builtin" -> return false
    push :: symbol == "jet_list_push" || symbol == "std::collections::BinaryHeap::push"
    pop :: symbol == "jet_priority_queue_pop_kernel"
    remove :: symbol == "jet_priority_queue_remove_value" || symbol == "jet_priority_queue_remove_slot_canonical"
    clear :: symbol == "std::collections::BinaryHeap::clear"
    if !push && !pop && !remove && !clear && !symbol.starts_with("jet_priority_queue_") -> return false
    heap :: if push || pop || remove || clear -> lower_receiver_header(p, c, &m, &f, receiver_place, "PriorityQueue") ?? return true else -> lower_use(&m, &f, receiver) ?? return true
    list_ty :: lower_priority_queue_list(elem)
    if symbol == "jet_priority_queue_len" || symbol == "jet_priority_queue_is_empty" {
        if args.len() != 0 -> return false
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        length :: lower_list_word(&f, heap, 0)
        if symbol == "jet_priority_queue_is_empty" {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        } else {
            lower_native_count(p, c, &m, &f, instruction, dst, length)
        }
        return true
    }
    if push {
        if args.len() != 1 -> return false
        value :: lower_use(&m, &f, args[0]) ?? return true
        offered := value
        if !lower_value_owned(c, args[0]) {
            offered = lower_new_like(&f, value)
            lower_clone_into(p, &m, &f, value, offered, elem)
        }
        lower_call_helper(&m, &f, "priority_queue.push", ty, [LIRValueID]{heap, offered}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if clear {
        if args.len() != 0 -> return false
        length :: lower_list_word(&f, heap, 0)
        data :: lower_list_data(&f, heap)
        counted :: lower_record_loop_start(&f, length)
        address :: lower_list_address(&f, data, counted.index, lower_list_stride(p, elem))
        lower_drop_stored(p, &m, &f, address, 0, elem)
        lower_record_loop_end(&f, counted)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: heap, offset: 0, value: zero})
        lower_alias_absent(&f, instruction)
        return true
    }
    if remove {
        if args.len() != 1 -> return false
        operand :: if symbol == "jet_priority_queue_remove_slot_canonical" -> lower_list_native_index(c, &m, &f, args[0]) ?? return true else -> lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        // Canonical removal slots are highest-first, not physical heap slots.
        // A descending sequence is itself a valid max-heap after removal.
        lower_call_helper(&m, &f, "list.sort_desc", list_ty, [LIRValueID]{heap}, None)
        lower_call_helper(&m, &f, if symbol == "jet_priority_queue_remove_slot_canonical" -> "list.remove_slot" else -> "list.remove_value", list_ty, [LIRValueID]{heap, operand}, Val(dst))
        return true
    }
    if args.len() != 0 -> return false
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    if symbol == "jet_priority_queue_to_sorted_list" {
        lower_storage_into(p, &f, dst, list_ty)
        lower_inline_clone(p, &m, &f, heap, dst, list_ty)
        lower_call_helper(&m, &f, "list.sort_desc", list_ty, [LIRValueID]{dst}, None)
    } else if symbol == "jet_priority_queue_peek" {
        zero :: lower_const(&f, 0)
        lower_call_helper(&m, &f, "list.get", list_ty, [LIRValueID]{heap, zero}, Val(dst))
    } else if pop {
        lower_call_helper(&m, &f, "priority_queue.pop", ty, [LIRValueID]{heap}, Val(dst))
    } else {
        return false
    }
    true
}

fn lower_priority_queue_swap(p: MIRProgram, f: &LowerFunction, data: LIRValueID, left: LIRValueID, right: LIRValueID, elem: MIRType, scratch: LIRValueID) Never! {
    a :: lower_list_address(&f, data, left, lower_list_stride(p, elem))
    b :: lower_list_address(&f, data, right, lower_list_stride(p, elem))
    lower_list_move(p, &f, scratch, a, elem)
    lower_list_move(p, &f, a, b, elem)
    lower_list_move(p, &f, b, scratch, elem)
}

// Sift one existing slot upward. Every comparison reads live element storage.
fn lower_priority_queue_sift_up(p: MIRProgram, m: &LowerModule, f: &LowerFunction, data: LIRValueID, start: LIRValueID, elem: MIRType) Never! {
    scratch :: lower_new_storage(p, &f, elem)
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    swap :: lower_new_block(&f)
    done :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{start})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Gt, left: at, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    previous :: lower_word(&f)
    parent :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: previous, op: LIRBinaryOp.Sub, left: at, right: one})
    lower_emit(&f, LIRInst.Binary{dst: parent, op: LIRBinaryOp.Shr, left: previous, right: one})
    a :: lower_list_address(&f, data, parent, lower_list_stride(p, elem))
    b :: lower_list_address(&f, data, at, lower_list_stride(p, elem))
    left :: lower_read_at(p, &f, a, 0, elem) ?? return
    right :: lower_read_at(p, &f, b, 0, elem) ?? return
    order :: lower_map_key_order(p, &m, &f, elem, left, right)
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(swap, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, swap, [LIRValueID]{})
    lower_priority_queue_swap(p, &f, data, at, parent, elem, scratch)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{parent})})
    lower_start(&f, done, [LIRValueID]{})
}

fn lower_priority_queue_sift_down(p: MIRProgram, m: &LowerModule, f: &LowerFunction, data: LIRValueID, start: LIRValueID, length: LIRValueID, elem: MIRType) Never! {
    scratch :: lower_new_storage(p, &f, elem)
    one :: lower_const(&f, 1)
    two :: lower_const(&f, 2)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    compare_right :: lower_new_block(&f)
    choose :: lower_new_block(&f)
    compare_parent :: lower_new_block(&f)
    swap :: lower_new_block(&f)
    done :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{start})})
    lower_start(&f, head, [LIRValueID]{at})
    doubled :: lower_word(&f)
    child :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: doubled, op: LIRBinaryOp.Mul, left: at, right: two})
    lower_emit(&f, LIRInst.Binary{dst: child, op: LIRBinaryOp.Add, left: doubled, right: one})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: child, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    sibling :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: sibling, op: LIRBinaryOp.Add, left: child, right: one})
    has_right :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: has_right, condition: LIRCondition.Lt, left: sibling, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: has_right, then_target: lower_target(compare_right, [LIRValueID]{}), else_target: lower_target(compare_parent, [LIRValueID]{child})})
    lower_start(&f, compare_right, [LIRValueID]{})
    a :: lower_list_address(&f, data, child, lower_list_stride(p, elem))
    b :: lower_list_address(&f, data, sibling, lower_list_stride(p, elem))
    left :: lower_read_at(p, &f, a, 0, elem) ?? return
    right :: lower_read_at(p, &f, b, 0, elem) ?? return
    order :: lower_map_key_order(p, &m, &f, elem, left, right)
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(choose, [LIRValueID]{}), else_target: lower_target(compare_parent, [LIRValueID]{child})})
    lower_start(&f, choose, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(compare_parent, [LIRValueID]{sibling})})
    best :: lower_word(&f)
    lower_start(&f, compare_parent, [LIRValueID]{best})
    parent_address :: lower_list_address(&f, data, at, lower_list_stride(p, elem))
    child_address :: lower_list_address(&f, data, best, lower_list_stride(p, elem))
    parent_value :: lower_read_at(p, &f, parent_address, 0, elem) ?? return
    child_value :: lower_read_at(p, &f, child_address, 0, elem) ?? return
    parent_order :: lower_map_key_order(p, &m, &f, elem, parent_value, child_value)
    lower_seal(&f, LIRTerminator.Branch{condition: parent_order.less, then_target: lower_target(swap, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, swap, [LIRValueID]{})
    lower_priority_queue_swap(p, &f, data, at, best, elem, scratch)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{best})})
    lower_start(&f, done, [LIRValueID]{})
}

fn lower_helper_priority_queue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_priority_queue_element(glue.ty) ?? panic("PriorityQueue helper has no checked element")
    layouts := [LIRLayout]{lir_layout_pointer()}
    // push takes the offered value over (lower_helper_start_taking).
    taken := [LIRDrop]{LIRDrop.Trivial}
    if glue.helper == "priority_queue.push" {
        &layouts.push(lower_repr_layout(lower_repr(p, elem)) ?? lir_layout_pointer())
        &taken.push(lower_drop(&m, lower_repr(p, elem), true))
    }
    f := lower_helper_start_taking(&m, glue, layouts, taken, if glue.helper == "priority_queue.pop" -> Val(lir_layout_pointer()) else -> None)
    heap :: f.open_params[0].copy()
    incoming :: if layouts.len() == 2 -> Val(f.open_params[1].copy()) else -> None
    if glue.helper == "priority_queue.push" {
        length :: lower_list_reserve(p, &m, &f, heap, elem)
        data :: lower_list_data(&f, heap)
        address :: lower_list_address(&f, data, length, lower_list_stride(p, elem))
        if incoming == .Val(value) -> lower_write_at(p, &f, address, 0, value, elem)
        one :: lower_const(&f, 1)
        count :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: count, op: LIRBinaryOp.Add, left: length, right: one})
        lower_emit(&f, LIRInst.Store{base: heap, offset: 0, value: count})
        lower_priority_queue_sift_up(p, &m, &f, data, length, elem)
    } else if glue.helper == "priority_queue.heapify" {
        length :: lower_list_word(&f, heap, 0)
        data :: lower_list_data(&f, heap)
        one :: lower_const(&f, 1)
        parents :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: parents, op: LIRBinaryOp.Shr, left: length, right: one})
        counted :: lower_record_loop_start(&f, parents)
        last_parent :: lower_word(&f)
        at :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: last_parent, op: LIRBinaryOp.Sub, left: parents, right: one})
        lower_emit(&f, LIRInst.Binary{dst: at, op: LIRBinaryOp.Sub, left: last_parent, right: counted.index})
        lower_priority_queue_sift_down(p, &m, &f, data, at, length, elem)
        lower_record_loop_end(&f, counted)
    } else if glue.helper == "priority_queue.pop" {
        length :: lower_list_word(&f, heap, 0)
        zero :: lower_const(&f, 0)
        empty :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: length, right: zero})
        absent :: lower_new_block(&f)
        present :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(absent, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
        lower_start(&f, absent, [LIRValueID]{})
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
        lower_start(&f, present, [LIRValueID]{})
        result :: lower_pointer(&f)
        lower_alloc(&m, &f, result, lower_option_box_size(p, elem))
        data :: lower_list_data(&f, heap)
        lower_list_move(p, &f, result, data, elem)
        one :: lower_const(&f, 1)
        last :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
        lower_emit(&f, LIRInst.Store{base: heap, offset: 0, value: last})
        // With one element, the copied stale slot lies outside the live prefix.
        tail :: lower_list_address(&f, data, last, lower_list_stride(p, elem))
        lower_list_move(p, &f, data, tail, elem)
        lower_priority_queue_sift_down(p, &m, &f, data, zero, last, elem)
        lower_seal(&f, LIRTerminator.Return{value: Val(result)})
        return lir_builder_finish(f.builder)
    } else {
        lower_fail(&m, &f, "PriorityQueue helper {glue.helper} has no generator")
    }
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_priority_queue_render(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_priority_queue_element(glue.ty) ?? panic("PriorityQueue rendering has no checked element")
    list_ty :: lower_priority_queue_list(elem)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    heap :: f.open_params[0].copy()
    snapshot :: lower_new_storage(p, &f, list_ty)
    lower_inline_clone(p, &m, &f, heap, snapshot, list_ty)
    lower_call_helper(&m, &f, "list.sort_desc", list_ty, [LIRValueID]{snapshot}, None)
    text :: lower_render_string(&f)
    lower_call_helper(&m, &f, glue.helper, list_ty, [LIRValueID]{snapshot}, Val(text))
    lower_map_drop_value(p, &m, &f, snapshot, list_ty)
    lower_seal(&f, LIRTerminator.Return{value: Val(text)})
    lir_builder_finish(f.builder)
}
