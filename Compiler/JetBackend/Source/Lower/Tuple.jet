// Tuples are inline aggregates like structs: elements at natural offsets in
// declaration order (Values.jet lower_inline_members).
use jet_foundation.[
    MIRFieldID,
    MIRFieldValue,
    MIRInstruction,
    MIRProgram,
    MIRTypeID,
    MIRValueID,
    mir_field_id,
    mir_type_display_name,
    mir_type_identity_key,
]

// TIR/mir.rs:tuple_type_fields (:3643) and field_id_for_type (:6281)
// resolve a numeric source projection to the element's declared name first;
// the MIR field ID is the tuple's checked identity plus that name, not an index.
fn lower_tuple(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, type_id: MIRTypeID, fields: [MIRFieldValue]) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "tuple type {type_id.value} has no checked type")
    declared :: if ty.kind == {
        .Tuple(rows) -> rows
        else -> {
            lower_fail(&m, &f, "tuple construction of {mir_type_display_name(ty)} is not lowered at O0 yet")
            return
        }
    }
    if fields.len() != declared.len() -> return lower_fail(&m, &f, "tuple construction with missing elements is not lowered at O0 yet")
    identity :: mir_type_identity_key(ty)
    // MIRRust.rs:operation Tuple arm (:18346) consumes elements in MIR order.
    loop (index, row) in fields {
        if row.field != mir_field_id("{identity}::{declared[index].name}") -> return lower_fail(&m, &f, "tuple construction outside checked element order is not lowered at O0 yet")
        if lower_repr(p, declared[index].ty) == .Unsupported(reason) -> return lower_fail(&m, &f, "tuple element of {reason} is not lowered at O0 yet")
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    loop row in fields {
        found :: lower_struct_field(p, ty, row.field) ?? return lower_fail(&m, &f, "tuple element {row.field.value} has no storage")
        lower_store_value(p, &m, &f, dst, found.offset, row.value, found.ty)
    }
}

// MIRRust.rs:project_members (:20445) is a chained field path, not a
// multi-element selection or a new aggregate. Nested inline members add
// offsets; a recursive edge enters its wrapper.
fn lower_project_members(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, base: MIRValueID, members: [MIRFieldID]) Never! {
    if members.len() == 0 -> return lower_forward(c, &m, &f, instruction, base)
    ty := lower_value_type(c, base) ?? return lower_fail(&m, &f, "member projection base {base.value} has no checked type")
    storage := lower_use(&m, &f, base) ?? return
    offset := 0
    loop (index, member) in members {
        found :: lower_struct_field(p, ty, member) ?? return lower_fail(&m, &f, "member projection of field {member.value} from {mir_type_display_name(ty)} is not lowered at O0 yet")
        repr :: lower_repr(p, found.ty)
        if repr == .Unsupported(reason) -> return lower_fail(&m, &f, "member projection of {reason} is not lowered at O0 yet")
        address :: lower_struct_storage_address(&f, storage, LowerFieldInfo{offset: offset + found.offset, ty: found.ty, boxed: found.boxed})
        if index + 1 == members.len() {
            if repr == .Absent -> return lower_alias_absent(&f, instruction)
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            lower_read_into(p, &f, dst, address.base, address.offset, found.ty)
            return
        }
        if !lower_is_inline(p, found.ty) -> return lower_fail(&m, &f, "member projection through {mir_type_display_name(found.ty)} is not lowered at O0 yet")
        storage = address.base
        offset = address.offset
        ty = found.ty
    }
}
