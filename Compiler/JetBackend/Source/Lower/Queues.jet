// Queue<T>: owned ring [len, cap, data, head]. Buffers and element storage
// use the same allocation/free and packed-stride contract as native Lists.
use jet_foundation.[
    MIRCallArg, MIRInstruction, MIRPlaceID, MIRPreludeCall, MIRPreludeCallID,
    MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_nominal_ref,
    mir_type_from_kind,
]

fn lower_queue_element(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .Apply(name, args) -> if name.id == mir_nominal_ref("Queue").id && args.len() == 1 -> Val(args[0]) else -> None
        .Tagged(_, inner) -> lower_queue_element(inner)
        else -> None
    }
}

fn lower_queue_repr(p: MIRProgram, ty: MIRType, elem: MIRType) -> LowerRepr Never! {
    if lower_repr(p, elem) == .Unsupported(reason) -> return LowerRepr.Unsupported{reason: "Queue element {reason}"}
    LowerRepr.Inline{ty: ty}
}

fn lower_queue_address(f: &LowerFunction, data: LIRValueID, head: LIRValueID, cap: LIRValueID, at: LIRValueID, stride: Int) -> LIRValueID Never! {
    offset :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Add, left: head, right: at})
    slot :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: slot, op: LIRBinaryOp.Rem, left: offset, right: cap})
    lower_list_address(&f, data, slot, stride)
}

fn lower_queue_zero(f: &LowerFunction, queue: LIRValueID) Never! {
    zero :: lower_const(&f, 0)
    offsets :: [Int]{0, 8, 16, 24}
    loop offset in offsets -> lower_emit(&f, LIRInst.Store{base: queue, offset: offset, value: zero})
}

// From can take the List allocation directly (head zero); a borrowed List
// is cloned with ordinary List glue. Retiring a moved source cannot free it.
fn lower_queue_from(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, source_id: MIRValueID) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Queue construction has no checked type")
    elem :: lower_queue_element(ty) ?? return lower_fail(&m, &f, "Queue construction has no checked element")
    source_ty :: lower_value_type(c, source_id) ?? return lower_fail(&m, &f, "Queue construction has no checked source type")
    if lower_list_element(source_ty) != Val(elem) -> return lower_fail(&m, &f, "Queue construction source is not its checked element List")
    source :: lower_use(&m, &f, source_id) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    if lower_value_owned(c, source_id) {
        lower_copy_bytes(&f, dst, 0, source, 0, 24)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: source, offset: 0, value: zero})
        lower_emit(&f, LIRInst.Store{base: source, offset: 8, value: zero})
        lower_emit(&f, LIRInst.Store{base: source, offset: 16, value: zero})
    } else {
        list_ty :: mir_type_from_kind(MIRTypeKind.List{inner: elem})
        lower_inline_clone(p, &m, &f, source, dst, list_ty)
    }
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 24, value: zero})
}

fn lower_queue_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    ty :: lower_checked_type(c, instruction) ?? return false
    if lower_queue_element(ty) == None -> return false
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    if symbol == "jet_deque_from" && args.len() == 1 {
        lower_queue_from(p, c, &m, &f, instruction, args[0].value)
        return true
    }
    if symbol != "std::collections::VecDeque::new" || args.len() != 0 -> return false
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, ty)
    lower_queue_zero(&f, dst)
    true
}

fn lower_queue_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    symbol :: lower_runtime_symbol(row)
    if symbol == "jet_deque_from" && args.len() == 0 {
        lower_queue_from(p, c, &m, &f, instruction, receiver)
        return true
    }
    ty :: lower_value_type(c, receiver) ?? return false
    elem :: lower_queue_element(ty) ?? return false
    if row.family != .BuiltinMethod || row.module_name != "core.builtin" -> return false
    if !symbol.starts_with("jet_deque_") && symbol != "std::collections::VecDeque::clear" -> return false
    push :: symbol == "jet_deque_push_front" || symbol == "jet_deque_push_back"
    pop :: symbol == "jet_deque_pop_front_kernel" || symbol == "jet_deque_pop_back_kernel"
    mutates :: push || pop || symbol == "jet_deque_delete" || symbol == "jet_deque_reverse" || symbol == "jet_deque_split" || symbol == "std::collections::VecDeque::clear"
    queue :: if mutates -> lower_receiver_header(p, c, &m, &f, receiver_place, "Queue") ?? return true else -> lower_use(&m, &f, receiver) ?? return true
    if symbol == "jet_deque_len" || symbol == "jet_deque_capacity" || symbol == "jet_deque_is_empty" {
        if args.len() != 0 -> return false
        length :: lower_list_word(&f, queue, if symbol == "jet_deque_capacity" -> 8 else -> 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_deque_is_empty" {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        } else {
            lower_native_count(p, c, &m, &f, instruction, dst, length)
        }
        return true
    }
    if push {
        if args.len() != 1 -> return false
        values := [LIRValueID]{queue}
        if lower_repr(p, elem) != .Absent {
            value :: lower_use(&m, &f, args[0]) ?? return true
            offered := value
            if !lower_value_owned(c, args[0]) {
                offered = lower_new_like(&f, value)
                lower_clone_into(p, &m, &f, value, offered, elem)
            }
            &values.push(offered)
        }
        lower_call_helper(&m, &f, if symbol == "jet_deque_push_front" -> "queue.push.front" else -> "queue.push.back", ty, values, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if pop || symbol == "jet_deque_peek_front" || symbol == "jet_deque_peek_back" || symbol == "jet_deque_get" {
        if args.len() != (if symbol == "jet_deque_get" -> 1 else -> 0) -> return false
        values := [LIRValueID]{queue}
        if symbol == "jet_deque_get" {
            index :: lower_list_native_index(c, &m, &f, args[0]) ?? return true
            &values.push(index)
        }
        helper :: if symbol == "jet_deque_get" -> "queue.get" else if symbol == "jet_deque_pop_front_kernel" -> "queue.pop.front" else if symbol == "jet_deque_pop_back_kernel" -> "queue.pop.back" else if symbol == "jet_deque_peek_front" -> "queue.peek.front" else -> "queue.peek.back"
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, helper, ty, values, Val(dst))
        return true
    }
    if symbol == "jet_deque_to_list" || symbol == "jet_deque_join" || symbol == "jet_deque_split" {
        if args.len() != (if symbol == "jet_deque_to_list" -> 0 else -> 1) -> return false
        values := [LIRValueID]{queue}
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_deque_join" {
            separator :: lower_use(&m, &f, args[0]) ?? return true
            &values.push(separator)
            lower_call_helper(&m, &f, "queue.join", ty, values, Val(dst))
        } else {
            result_ty :: lower_checked_type(c, instruction) ?? return true
            lower_storage_into(p, &f, dst, result_ty)
            if symbol == "jet_deque_split" {
                index :: lower_list_native_index(c, &m, &f, args[0]) ?? return true
                &values.push(index)
            }
            &values.push(dst)
            lower_call_helper(&m, &f, if symbol == "jet_deque_split" -> "queue.split" else -> "queue.list", ty, values, None)
        }
        return true
    }
    if symbol == "jet_deque_contains" || symbol == "jet_deque_delete" {
        if args.len() != 1 -> return false
        value :: if lower_repr(p, elem) == .Absent -> lower_const(&f, 0) else -> lower_use(&m, &f, args[0]) ?? return true
        if symbol == "jet_deque_contains" {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return true
            lower_call_helper(&m, &f, "queue.contains", ty, [LIRValueID]{queue, value}, Val(dst))
        } else {
            lower_call_helper(&m, &f, "queue.delete", ty, [LIRValueID]{queue, value}, None)
            if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, value, elem)
            lower_alias_absent(&f, instruction)
        }
        return true
    }
    if symbol == "jet_deque_reverse" || symbol == "std::collections::VecDeque::clear" {
        if args.len() != 0 -> return false
        lower_call_helper(&m, &f, if symbol == "jet_deque_reverse" -> "queue.reverse" else -> "queue.clear", ty, [LIRValueID]{queue}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    false
}

fn lower_queue_reserve(p: MIRProgram, m: &LowerModule, f: &LowerFunction, queue: LIRValueID, elem: MIRType) Never! {
    length :: lower_list_word(&f, queue, 0)
    cap :: lower_list_word(&f, queue, 8)
    full :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: full, condition: LIRCondition.Eq, left: length, right: cap})
    grow :: lower_new_block(&f)
    ready :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: full, then_target: lower_target(grow, [LIRValueID]{}), else_target: lower_target(ready, [LIRValueID]{})})
    lower_start(&f, grow, [LIRValueID]{})
    stride :: lower_list_stride(p, elem)
    maximum :: lower_const(&f, 9223372036854775807)
    divisor :: lower_const(&f, stride * 2)
    limit :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: limit, op: LIRBinaryOp.Div, left: maximum, right: divisor})
    too_large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_large, condition: LIRCondition.Gt, left: cap, right: limit})
    lower_check(&m, &f, too_large, "jet_rt_panic_list_capacity")
    zero :: lower_const(&f, 0)
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: cap, right: zero})
    first :: lower_new_block(&f)
    double :: lower_new_block(&f)
    allocate :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(first, [LIRValueID]{}), else_target: lower_target(double, [LIRValueID]{})})
    lower_start(&f, first, [LIRValueID]{})
    one :: lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(allocate, [LIRValueID]{one})})
    lower_start(&f, double, [LIRValueID]{})
    two :: lower_const(&f, 2)
    doubled :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: doubled, op: LIRBinaryOp.Mul, left: cap, right: two})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(allocate, [LIRValueID]{doubled})})
    new_cap :: lower_word(&f)
    lower_start(&f, allocate, [LIRValueID]{new_cap})
    data :: lower_list_data(&f, queue)
    head :: lower_list_word(&f, queue, 24)
    room :: lower_list_buffer(&m, &f, new_cap, stride)
    counted :: lower_record_loop_start(&f, length)
    from :: lower_queue_address(&f, data, head, cap, counted.index, stride)
    to :: lower_list_address(&f, room, counted.index, stride)
    lower_list_move(p, &f, to, from, elem)
    lower_record_loop_end(&f, counted)
    lower_list_free_buffer(&m, &f, data, cap, stride)
    lower_emit(&f, LIRInst.Store{base: queue, offset: 8, value: new_cap})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 16, value: room})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 24, value: zero})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ready, [LIRValueID]{})})
    lower_start(&f, ready, [LIRValueID]{})
}

fn lower_helper_queue_push(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    layouts := [LIRLayout]{lir_layout_pointer()}
    if lower_repr_layout(lower_repr(p, elem)) == .Val(layout) -> &layouts.push(layout)
    f := lower_helper_start(&m, glue, layouts, None)
    queue :: f.open_params[0].copy()
    value :: if f.open_params.len() == 2 -> Val(f.open_params[1].copy()) else -> None
    lower_queue_reserve(p, &m, &f, queue, elem)
    length :: lower_list_word(&f, queue, 0)
    cap :: lower_list_word(&f, queue, 8)
    data :: lower_list_data(&f, queue)
    head :: lower_list_word(&f, queue, 24)
    one :: lower_const(&f, 1)
    if glue.helper == "queue.push.front" {
        end :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: end, op: LIRBinaryOp.Add, left: head, right: cap})
        previous :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: previous, op: LIRBinaryOp.Sub, left: end, right: one})
        next_head :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next_head, op: LIRBinaryOp.Rem, left: previous, right: cap})
        target :: lower_list_address(&f, data, next_head, lower_list_stride(p, elem))
        if value == .Val(offered) -> lower_write_at(p, &f, target, 0, offered, elem)
        lower_emit(&f, LIRInst.Store{base: queue, offset: 24, value: next_head})
    } else {
        target :: lower_queue_address(&f, data, head, cap, length, lower_list_stride(p, elem))
        if value == .Val(offered) -> lower_write_at(p, &f, target, 0, offered, elem)
    }
    grown :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: grown, op: LIRBinaryOp.Add, left: length, right: one})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 0, value: grown})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue_get(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    layouts := [LIRLayout]{lir_layout_pointer()}
    if glue.helper == "queue.get" -> &layouts.push(lir_layout_word())
    f := lower_helper_start(&m, glue, layouts, Val(lir_layout_pointer()))
    queue :: f.open_params[0].copy()
    length :: lower_list_word(&f, queue, 0)
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    index := zero
    if glue.helper == "queue.get" {
        index = f.open_params[1].copy()
    } else if glue.helper.ends_with(".back") {
        index = lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: index, op: LIRBinaryOp.Sub, left: length, right: one})
    }
    negative :: lower_flag(&f)
    outside :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: index, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: outside, condition: LIRCondition.Ge, left: index, right: length})
    invalid :: lower_flag(&f)
    lower_logic(&f, invalid, false, negative, outside)
    miss :: lower_new_block(&f)
    hit :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(miss, [LIRValueID]{}), else_target: lower_target(hit, [LIRValueID]{})})
    lower_start(&f, miss, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    lower_start(&f, hit, [LIRValueID]{})
    data :: lower_list_data(&f, queue)
    cap :: lower_list_word(&f, queue, 8)
    head :: lower_list_word(&f, queue, 24)
    from :: lower_queue_address(&f, data, head, cap, index, lower_list_stride(p, elem))
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, lower_option_box_size(p, elem))
    if glue.helper.starts_with("queue.pop.") {
        lower_list_move(p, &f, boxed, from, elem)
        remaining :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: length, right: one})
        lower_emit(&f, LIRInst.Store{base: queue, offset: 0, value: remaining})
        if glue.helper == "queue.pop.front" {
            advanced :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: advanced, op: LIRBinaryOp.Add, left: head, right: one})
            next_head :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: next_head, op: LIRBinaryOp.Rem, left: advanced, right: cap})
            lower_emit(&f, LIRInst.Store{base: queue, offset: 24, value: next_head})
        }
    } else {
        lower_list_clone_element(p, &m, &f, from, boxed, elem)
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
    lir_builder_finish(f.builder)
}

// Drop/clear walks only live ring slots; a copy (queue.list, queue.unique) is
// a linear buffer, so discarded/spare slots never own another copy of an
// element.
fn lower_queue_retire(p: MIRProgram, m: &LowerModule, f: &LowerFunction, queue: LIRValueID, elem: MIRType, free: Bool) Never! {
    length :: lower_list_word(&f, queue, 0)
    cap :: lower_list_word(&f, queue, 8)
    head :: lower_list_word(&f, queue, 24)
    data :: lower_list_data(&f, queue)
    if lower_needs_drop(p, m, elem) {
        counted :: lower_record_loop_start(&f, length)
        address :: lower_queue_address(&f, data, head, cap, counted.index, lower_list_stride(p, elem))
        lower_drop_stored(p, &m, &f, address, 0, elem)
        lower_record_loop_end(&f, counted)
    }
    if free -> lower_list_free_buffer(&m, &f, data, cap, lower_list_stride(p, elem))
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: queue, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 24, value: zero})
    if free {
        lower_emit(&f, LIRInst.Store{base: queue, offset: 8, value: zero})
        lower_emit(&f, LIRInst.Store{base: queue, offset: 16, value: zero})
    }
}

fn lower_helper_queue_copy(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType, ring: Bool) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    source :: f.open_params[0].copy()
    dst :: f.open_params[1].copy()
    lower_queue_copy_into(p, &m, &f, source, dst, elem, ring)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Fills the header at `dst` with a linear buffer holding a clone of each of
// `source`'s live elements in queue order (head 0 when `ring`).
fn lower_queue_copy_into(p: MIRProgram, m: &LowerModule, f: &LowerFunction, source: LIRValueID, dst: LIRValueID, elem: MIRType, ring: Bool) Never! {
    length :: lower_list_word(&f, source, 0)
    cap :: lower_list_word(&f, source, 8)
    head :: lower_list_word(&f, source, 24)
    source_data :: lower_list_data(&f, source)
    stride :: lower_list_stride(p, elem)
    data :: lower_list_buffer(&m, &f, length, stride)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
    if ring {
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: dst, offset: 24, value: zero})
    }
    counted :: lower_record_loop_start(&f, length)
    from :: lower_queue_address(&f, source_data, head, cap, counted.index, stride)
    to :: lower_list_address(&f, data, counted.index, stride)
    lower_list_clone_element(p, &m, &f, from, to, elem)
    lower_record_loop_end(&f, counted)
}

// Queue clone glue shares the ring buffer (#5041 P2): the four header words
// and one more owner of an allocated buffer.
fn lower_helper_queue_clone(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    source :: f.open_params[0].copy()
    target :: f.open_params[1].copy()
    lower_copy_bytes(&f, target, 0, source, 0, 32)
    lower_list_retain(&m, &f, target)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Queue drop releases this owner of the ring; the last owner drops the live
// slots and frees it.
fn lower_helper_queue_drop(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    queue :: f.open_params[0].copy()
    cap :: lower_list_word(&f, queue, 8)
    zero :: lower_const(&f, 0)
    owned :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: owned, condition: LIRCondition.Ne, left: cap, right: zero})
    counted :: lower_new_block(&f)
    drop :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: owned, then_target: lower_target(counted, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, counted, [LIRValueID]{})
    data :: lower_list_data(&f, queue)
    last :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_rt_block_release", [LIRValueID]{data}, Val(last))
    lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(drop, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, drop, [LIRValueID]{})
    lower_queue_retire(p, &m, &f, queue, elem, true)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_queue_zero(&f, queue)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// queue.unique(header): the copy half of lower_list_make_unique for a ring.
// A shared ring is replaced by a private linear copy (head 0); the old ring
// loses this owner and is dropped here if every other owner released it.
fn lower_helper_queue_unique(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    queue :: f.open_params[0].copy()
    cap :: lower_list_word(&f, queue, 8)
    zero :: lower_const(&f, 0)
    owned :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: owned, condition: LIRCondition.Ne, left: cap, right: zero})
    counted :: lower_new_block(&f)
    detach :: lower_new_block(&f)
    drop :: lower_new_block(&f)
    install :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: owned, then_target: lower_target(counted, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, counted, [LIRValueID]{})
    data :: lower_list_data(&f, queue)
    sole :: lower_list_sole_owner(&f, data)
    lower_seal(&f, LIRTerminator.Branch{condition: sole, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(detach, [LIRValueID]{})})
    lower_start(&f, detach, [LIRValueID]{})
    fresh :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: fresh, size: 32, align: 8})
    lower_queue_copy_into(p, &m, &f, queue, fresh, elem, true)
    last :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_rt_block_release", [LIRValueID]{data}, Val(last))
    lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(drop, [LIRValueID]{}), else_target: lower_target(install, [LIRValueID]{})})
    lower_start(&f, drop, [LIRValueID]{})
    lower_queue_retire(p, &m, &f, queue, elem, true)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(install, [LIRValueID]{})})
    lower_start(&f, install, [LIRValueID]{})
    lower_copy_bytes(&f, queue, 0, fresh, 0, 32)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue_search(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    layout :: lower_repr_layout(lower_repr(p, elem)) ?? lir_layout_word()
    deletes :: glue.helper == "queue.delete"
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), layout}, if deletes -> None else -> Val(lir_layout_bool()))
    queue :: f.open_params[0].copy()
    key :: f.open_params[1].copy()
    length :: lower_list_word(&f, queue, 0)
    cap :: lower_list_word(&f, queue, 8)
    head :: lower_list_word(&f, queue, 24)
    data :: lower_list_data(&f, queue)
    stride :: lower_list_stride(p, elem)
    hit :: lower_new_block(&f)
    counted :: lower_record_loop_start(&f, length)
    address :: lower_queue_address(&f, data, head, cap, counted.index, stride)
    value :: lower_read_at(p, &f, address, 0, elem)
    same :: lower_equal_values(p, &m, &f, elem, value, if lower_repr(p, elem) == .Absent -> None else -> Val(key)) ?? {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    next_item :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(hit, [LIRValueID]{counted.index}), else_target: lower_target(next_item, [LIRValueID]{})})
    lower_start(&f, next_item, [LIRValueID]{})
    lower_record_loop_end(&f, counted)
    if deletes {
        lower_seal(&f, LIRTerminator.Return{value: None})
    } else {
        no :: lower_const_flag(&f, 0)
        lower_seal(&f, LIRTerminator.Return{value: Val(no)})
    }
    found :: lower_word(&f)
    lower_start(&f, hit, [LIRValueID]{found})
    if !deletes {
        yes :: lower_const_flag(&f, 1)
        lower_seal(&f, LIRTerminator.Return{value: Val(yes)})
        return lir_builder_finish(f.builder)
    }
    removed :: lower_queue_address(&f, data, head, cap, found, stride)
    lower_drop_stored(p, &m, &f, removed, 0, elem)
    one :: lower_const(&f, 1)
    after :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: after, op: LIRBinaryOp.Add, left: found, right: one})
    // Shift the shorter side, like VecDeque::remove. Preserve logical order.
    tail_count :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: tail_count, op: LIRBinaryOp.Sub, left: length, right: after})
    front_shorter :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: front_shorter, condition: LIRCondition.Lt, left: found, right: tail_count})
    front :: lower_new_block(&f)
    back :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: front_shorter, then_target: lower_target(front, [LIRValueID]{}), else_target: lower_target(back, [LIRValueID]{})})
    lower_start(&f, front, [LIRValueID]{})
    prefix :: lower_record_loop_start(&f, found)
    to_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: to_at, op: LIRBinaryOp.Sub, left: found, right: prefix.index})
    from_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: from_at, op: LIRBinaryOp.Sub, left: to_at, right: one})
    from :: lower_queue_address(&f, data, head, cap, from_at, stride)
    to :: lower_queue_address(&f, data, head, cap, to_at, stride)
    lower_list_move(p, &f, to, from, elem)
    lower_record_loop_end(&f, prefix)
    advanced :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: advanced, op: LIRBinaryOp.Add, left: head, right: one})
    next_head :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_head, op: LIRBinaryOp.Rem, left: advanced, right: cap})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 24, value: next_head})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, back, [LIRValueID]{})
    suffix :: lower_record_loop_start(&f, tail_count)
    suffix_from_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: suffix_from_at, op: LIRBinaryOp.Add, left: after, right: suffix.index})
    suffix_to_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: suffix_to_at, op: LIRBinaryOp.Sub, left: suffix_from_at, right: one})
    suffix_from :: lower_queue_address(&f, data, head, cap, suffix_from_at, stride)
    suffix_to :: lower_queue_address(&f, data, head, cap, suffix_to_at, stride)
    lower_list_move(p, &f, suffix_to, suffix_from, elem)
    lower_record_loop_end(&f, suffix)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    remaining :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: length, right: one})
    lower_emit(&f, LIRInst.Store{base: queue, offset: 0, value: remaining})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue_split(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word(), lir_layout_pointer()}, None)
    queue :: f.open_params[0].copy()
    index :: f.open_params[1].copy()
    dst :: f.open_params[2].copy()
    length :: lower_list_word(&f, queue, 0)
    zero :: lower_const(&f, 0)
    at :: lower_list_clamp(&f, index, zero, length)
    count :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: count, op: LIRBinaryOp.Sub, left: length, right: at})
    stride :: lower_list_stride(p, elem)
    room :: lower_list_buffer(&m, &f, count, stride)
    data :: lower_list_data(&f, queue)
    head :: lower_list_word(&f, queue, 24)
    cap :: lower_list_word(&f, queue, 8)
    counted :: lower_record_loop_start(&f, count)
    source_index :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: source_index, op: LIRBinaryOp.Add, left: at, right: counted.index})
    from :: lower_queue_address(&f, data, head, cap, source_index, stride)
    to :: lower_list_address(&f, room, counted.index, stride)
    lower_list_move(p, &f, to, from, elem)
    lower_record_loop_end(&f, counted)
    lower_emit(&f, LIRInst.Store{base: queue, offset: 0, value: at})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: count})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: count})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: room})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 24, value: zero})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue_reverse(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    queue :: f.open_params[0].copy()
    length :: lower_list_word(&f, queue, 0)
    data :: lower_list_data(&f, queue)
    head :: lower_list_word(&f, queue, 24)
    cap :: lower_list_word(&f, queue, 8)
    one :: lower_const(&f, 1)
    half :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: half, op: LIRBinaryOp.Shr, left: length, right: one})
    // Inline values require scratch bytes: their register is an address, so
    // writing one slot before preserving its bytes would overwrite the other.
    scratch :: lower_new_storage(p, &f, elem)
    counted :: lower_record_loop_start(&f, half)
    last :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
    other :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: other, op: LIRBinaryOp.Sub, left: last, right: counted.index})
    left :: lower_queue_address(&f, data, head, cap, counted.index, lower_list_stride(p, elem))
    right :: lower_queue_address(&f, data, head, cap, other, lower_list_stride(p, elem))
    lower_list_move(p, &f, scratch, left, elem)
    lower_list_move(p, &f, left, right, elem)
    lower_list_move(p, &f, right, scratch, elem)
    lower_record_loop_end(&f, counted)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue_render(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    joining :: glue.helper == "queue.join"
    layouts := [LIRLayout]{lir_layout_pointer()}
    if joining -> &layouts.push(lir_layout_pointer())
    f := lower_helper_start(&m, glue, layouts, Val(lir_layout_pointer()))
    queue :: f.open_params[0].copy()
    separator :: if joining -> Val(f.open_params[1].copy()) else -> None
    mode :: if glue.helper == "debug" -> LowerRenderMode.Debug else if glue.helper == "display" -> LowerRenderMode.Display else -> LowerRenderMode.Show
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    if !joining -> lower_render_static(&m, &f, builder, "[")
    length :: lower_list_word(&f, queue, 0)
    data :: lower_list_data(&f, queue)
    head :: lower_list_word(&f, queue, 24)
    cap :: lower_list_word(&f, queue, 8)
    zero :: lower_const(&f, 0)
    counted :: lower_record_loop_start(&f, length)
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Eq, left: counted.index, right: zero})
    item :: lower_new_block(&f)
    comma :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(item, [LIRValueID]{}), else_target: lower_target(comma, [LIRValueID]{})})
    lower_start(&f, comma, [LIRValueID]{})
    if separator == .Val(text) {
        lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, text}, None)
    } else {
        lower_render_static(&m, &f, builder, ", ")
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(item, [LIRValueID]{})})
    lower_start(&f, item, [LIRValueID]{})
    address :: lower_queue_address(&f, data, head, cap, counted.index, lower_list_stride(p, elem))
    value :: lower_render_load(p, &f, address, 0, elem, false)
    lower_render_push(p, &m, &f, builder, elem, value, mode)
    lower_record_loop_end(&f, counted)
    if !joining -> lower_render_static(&m, &f, builder, "]")
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    lower_seal(&f, LIRTerminator.Return{value: Val(text)})
    lir_builder_finish(f.builder)
}

fn lower_helper_queue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_queue_element(glue.ty) ?? panic("Queue helper has no checked element")
    if glue.helper.starts_with("queue.push.") -> return lower_helper_queue_push(p, &m, glue, elem)
    if glue.helper.starts_with("queue.pop.") || glue.helper.starts_with("queue.peek.") || glue.helper == "queue.get" -> return lower_helper_queue_get(p, &m, glue, elem)
    if glue.helper == "queue.list" -> return lower_helper_queue_copy(p, &m, glue, elem, false)
    if glue.clone -> return lower_helper_queue_clone(&m, glue)
    if glue.helper == "queue.unique" -> return lower_helper_queue_unique(p, &m, glue, elem)
    if glue.helper == "" -> return lower_helper_queue_drop(p, &m, glue, elem)
    if glue.helper == "queue.contains" || glue.helper == "queue.delete" -> return lower_helper_queue_search(p, &m, glue, elem)
    if glue.helper == "queue.split" -> return lower_helper_queue_split(p, &m, glue, elem)
    if glue.helper == "queue.reverse" -> return lower_helper_queue_reverse(p, &m, glue, elem)
    if glue.helper == "queue.join" || glue.helper == "show" || glue.helper == "display" || glue.helper == "debug" -> return lower_helper_queue_render(p, &m, glue, elem)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    queue :: f.open_params[0].copy()
    if glue.helper == "queue.clear" {
        lower_queue_retire(p, &m, &f, queue, elem, false)
    } else {
        lower_fail(&m, &f, "Queue helper {glue.helper} has no generator")
    }
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}
