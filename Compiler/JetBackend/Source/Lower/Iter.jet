// List iteration uses one IterCursor box for every source: [list, index, step,
// release-id, taken, transferred]. A Map walks its entry list (Maps.jet) the
// same way. RangeCursor remains its distinct runtime type.
// ByteIterCursor (a `loop b in bytes` over a borrowed [U8], MIRRust.rs
// loop_iter_init's byte-slice fast path) walks the same box: its observable
// order, values and stops are a List cursor's.
use jet_foundation.[
    MIRInstruction, MIRLoopSourceKind, MIRPreludeCallID, MIRProgram, MIRType, MIRTypeKind, MIRValueID,
    mir_nominal_ref, mir_type_display_name, mir_type_from_kind,
]

fn lower_is_iter_cursor(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, args) -> return (name.name == "IterCursor" || name.name == "ByteIterCursor") && args.len() == 0
    false
}

// A failed check stops like the Prelude cursor init it replaces:
// `jet_panic("<core.prelude>", 0, message)` (Collections.rs:1517-1518).
fn lower_iter_check(m: &LowerModule, f: &LowerFunction, failed: LIRValueID, message: String) Never! {
    stop :: lower_new_block(&f)
    valid :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    args :: lower_static_text(&m, &f, message)
    lower_noreturn_call(&m, &f, "jet_rt_panic_message", args)
    lower_start(&f, valid, [LIRValueID]{})
}

fn lower_iter_route(p: MIRProgram, m: &LowerModule, f: &LowerFunction, call: MIRPreludeCallID, symbol: String, arity: Int) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? {
        lower_fail(&m, &f, "iterator Prelude route is not lowered at O0 yet")
        return false
    }
    if lower_runtime_symbol(row) != symbol || row.signature.arity != arity {
        lower_fail(&m, &f, "this iterator Prelude route is not lowered at O0 yet")
        return false
    }
    true
}

// MIRRust.rs:23860 moves a value source; Collections.rs:1666 snapshots a borrowed
// Vec by cloning it. Both cursors consequently own an independent element walk.
fn lower_iter_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind) Never! {
    if lower_lazy_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value, source_kind) -> return
    if lower_channel_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value, source_kind) -> return
    if source_kind == .Chars -> return lower_chars_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value)
    if source_kind == .LinesProcessStream -> return lower_pipe_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value)
    if source_kind == .Iterable(_, _, iter_symbol, next_symbol) -> return lower_iterable_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value, iter_symbol, next_symbol)
    if lower_line_cursor_init(p, c, &m, &f, instruction, call, collection, step, by_value, source_kind) -> return
    if source_kind != .Plain -> return lower_fail(&m, &f, "this iterator source kind is not lowered at O0 yet")
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return
    ty :: lower_value_type(c, collection) ?? return lower_fail(&m, &f, "iterator collection without a checked type is not lowered at O0 yet")
    range :: lower_range_members(p, ty)
    if range == None && lower_sequence_element(ty) == None -> return lower_fail(&m, &f, "non-List, non-Map iteration is not lowered at O0 yet")
    if lower_sequence_element(ty) == .Val(elem) {
        if lower_task_element(elem) != None && !by_value -> return lower_fail(&m, &f, "borrowed iteration over owning Task handles is not lowered at O0 yet")
    }
    // A View owns neither its buffer nor its elements. The slice loop source
    // snapshots with `to_vec()` (Collections.rs JetLoopSource for &mut &[T]),
    // including owning fields: Trace/Validate.jet:6,389 walks JSON field views.
    snapshot_ty := ty
    if lower_view_element(ty) == .Val(elem) {
        snapshot_ty = mir_type_from_kind(MIRTypeKind.List{inner: elem})
    }
    cursor_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "iterator cursor without a checked type is not lowered at O0 yet")
    if !lower_is_iter_cursor(cursor_ty) -> return lower_fail(&m, &f, "this iterator cursor type is not lowered at O0 yet")
    source :: lower_use(&m, &f, collection) ?? return
    stride := LIRValueID{value: -1}
    if step == .Val(value) {
        stride = lower_use(&m, &f, value) ?? return
        if lower_value_layout(f, stride) != lir_layout_word() -> return lower_fail(&m, &f, "non-word iterator stride is not lowered at O0 yet")
        step_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "iterator stride without a checked type is not lowered at O0 yet")
        if lower_is_exact_int(step_ty) {
            // MIRRust.rs:index_operand :23161 narrows exact steps to native
            // i64 before LoopCursor.rs:62 checks positivity / usize range.
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, stride, "jet_int_owned_to_i64", false)
            stride = native
        }
    } else {
        stride = lower_const(&f, 1)
    }
    zero :: lower_const(&f, 0)
    invalid :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: invalid, condition: LIRCondition.Le, left: stride, right: zero})
    lower_iter_check(&m, &f, invalid, "iterator loop stride must be positive")
    if range == .Val(members) -> return lower_range_cursor_init(p, c, &m, &f, instruction, ty, source, members, stride)
    list := source
    // A read loop over a collection read only here takes it as a by-value
    // loop does (Lower.jet lower_iter_takes, MIRRust.rs `consumed`).
    taken :: by_value || c.iter_takes.get(collection.value) != None
    if !taken || lower_view_element(ty) != None {
        // A View's window (cap 0, data inside its owner's buffer) is
        // materialized element by element (lower_list_make_unique below):
        // List clone glue would share the window header, leaving
        // Advance/Drop destroying the source owners. A List shares.
        list = lower_new_storage(p, &f, snapshot_ty)
        if lower_view_element(ty) != None {
            lower_copy_bytes(&f, list, 0, source, 0, 24)
        } else {
            lower_inline_clone(p, &m, &f, source, list, snapshot_ty)
        }
    }
    // The cursor moves elements out and frees the buffer: it must own the
    // buffer alone (#5041 P2), so a shared one is detached here.
    lower_list_make_unique(p, &m, &f, list, snapshot_ty)
    // Register every typed release while lowering user MIR, before generic glue
    // is generated. Its function ID is a stable dispatch key, not a code pointer.
    release :: lower_helper_id(&m, "iter.release", snapshot_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: list})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: stride})
    lower_store_word(&f, dst, 24, release.value)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 32, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 40, value: zero})
}

// `loop c in text.chars()`: MIRRust.rs loop_iter_init walks JetStringChars,
// the text's Unicode scalars in order. Natively the cursor walks the List of
// them (the jet_string_chars route, String.chars's adapter) it owns, as a
// by-value List cursor. A moved text is released once its scalars are copied.
fn lower_chars_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool) Never! {
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return
    ty :: lower_value_type(c, collection) ?? return lower_fail(&m, &f, "character iteration without a checked source type is not lowered at O0 yet")
    if !lower_text_type(ty) -> return lower_fail(&m, &f, "character iteration over {mir_type_display_name(ty)} is not lowered at O0 yet")
    if step != None -> return lower_fail(&m, &f, "stepped character iteration is not lowered at O0 yet")
    route :: lower_runtime_route("jet_string_chars") ?? return lower_fail(&m, &f, "character iteration has no runtime C-ABI route (jet_string_chars)")
    cursor_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "iterator cursor without a checked type is not lowered at O0 yet")
    if !lower_is_iter_cursor(cursor_ty) -> return lower_fail(&m, &f, "this iterator cursor type is not lowered at O0 yet")
    text :: lower_use(&m, &f, collection) ?? return
    out :: lower_route_tagged_call(&m, &f, route.export, [LIRValueID]{text}, 1)
    if by_value && lower_value_owned(c, collection) -> lower_emit(&f, LIRInst.Drop{value: text})
    list_ty :: mir_type_from_kind(MIRTypeKind.List{inner: mir_type_from_kind(MIRTypeKind.Char)})
    data :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: data, base: out.slot, offset: 0})
    list :: lower_new_storage(p, &f, list_ty)
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: out.word})
    lower_emit(&f, LIRInst.Store{base: list, offset: 8, value: out.word})
    lower_emit(&f, LIRInst.Store{base: list, offset: 16, value: data})
    release :: lower_helper_id(&m, "iter.release", list_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    zero :: lower_const(&f, 0)
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: list})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_store_word(&f, dst, 16, 1)
    lower_store_word(&f, dst, 24, release.value)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 32, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 40, value: zero})
}

// File/stdin sources retain CollectionIoSources.rs ownership and snapshot
// semantics. The shared LoopCursor still owns strides, lookahead and release.
fn lower_line_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind) -> Bool Never! {
    file :: source_kind == .LinesFile
    if !file && source_kind != .LinesStdin -> return false
    ty :: lower_value_type(c, collection) ?? return true
    runtime :: if file -> "JetFileReader" else -> "JetStdinReader"
    if lower_route_carrier_of(p, ty) != .Val(LowerRouteCarrier.Handle{name: runtime}) {
        lower_fail(&m, &f, "line iterator source does not match its checked runtime carrier")
        return true
    }
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return true
    source :: lower_use(&m, &f, collection) ?? return true
    stride := lower_const(&f, 1)
    if step == .Val(value) -> stride = lower_lazy_native_int(p, c, &m, &f, value) ?? return true
    has_step :: lower_const_flag(&f, if step != None -> 1 else -> 0)
    moved :: lower_const_flag(&f, if by_value && lower_value_owned(c, collection) -> 1 else -> 0)
    elem :: mir_type_from_kind(MIRTypeKind.String)
    meta :: lower_lazy_meta(p, &m, &f, elem)
    iter :: lower_pointer(&f)
    export :: if file -> "jet_rt_native_iter_file_lines" else -> "jet_rt_native_iter_stdin_lines"
    lower_call_runtime(&m, &f, export, [LIRValueID]{source, moved, meta}, Val(iter))
    handle :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_iter_cursor_init", [LIRValueID]{iter, stride, has_step}, Val(handle))
    iter_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Iter"), args: [MIRType]{elem}})
    release :: lower_helper_id(&m, "iter.release", iter_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: handle})
    lower_store_word(&f, dst, 8, -1)
    lower_store_word(&f, dst, 16, 0)
    lower_store_word(&f, dst, 24, release.value)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
    true
}

fn lower_iter_more(f: &LowerFunction, cursor: LIRValueID) -> LIRValueID Never! {
    list :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: list, base: cursor, offset: 0})
    length :: lower_list_word(&f, list, 0)
    at :: lower_list_word(&f, cursor, 8)
    taken :: lower_list_word(&f, cursor, 32)
    zero :: lower_const(&f, 0)
    within :: lower_flag(&f)
    ready :: lower_flag(&f)
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: within, condition: LIRCondition.Lt, left: at, right: length})
    lower_emit(&f, LIRInst.Compare{dst: ready, condition: LIRCondition.Eq, left: taken, right: zero})
    lower_logic(&f, more, true, within, ready)
    more
}

fn lower_iter_operation(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, cursor: MIRValueID, operation: String) Never! {
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_{operation}", 1) -> return
    ty :: lower_value_type(c, cursor) ?? return lower_fail(&m, &f, "iterator cursor without a checked type is not lowered at O0 yet")
    if !lower_is_iter_cursor(ty) -> return lower_fail(&m, &f, "this iterator cursor type is not lowered at O0 yet")
    handle :: lower_use(&m, &f, cursor) ?? return
    if operation == "advance" {
        lower_call_helper(&m, &f, "iter.advance", ty, [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return
    }
    more :: lower_lazy_cursor_more(&m, &f, handle)
    if operation == "has_next" {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        lower_emit(&f, LIRInst.Move{dst: dst, src: more})
        return
    }
    no :: lower_const_flag(&f, 0)
    invalid :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: invalid, condition: LIRCondition.Eq, left: more, right: no})
    lower_iter_check(&m, &f, invalid, "iterator loop value requested after exhaustion")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "iterator value without a checked type is not lowered at O0 yet")
    lower_lazy_cursor_value(p, c, &m, &f, instruction, handle, result_ty)
    lower_store_word(&f, handle, 32, 1)
    // Borrowed results remain owned by the snapshot until Advance/Drop. Owned
    // results move out; their slots are excluded, never dropped as fake nulls.
    lower_store_word(&f, handle, 40, if lower_value_owned(c, instruction.result ?? cursor) -> 1 else -> 0)
}

fn lower_iter_drop_range(p: MIRProgram, m: &LowerModule, f: &LowerFunction, list: LIRValueID, elem: MIRType, first: LIRValueID, last: LIRValueID) Never! {
    if !lower_needs_drop(p, m, elem) -> return
    data :: lower_list_data(&f, list)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{first})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: last})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    address :: lower_list_address(&f, data, at, lower_list_stride(p, elem))
    lower_drop_stored(p, &m, &f, address, 0, elem)
    one :: lower_const(&f, 1)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
}

// LoopCursor.rs:116 takes the current owner; :133-149 drops skipped elements.
// Destruction drops only current/remaining owners, including on early exit.
fn lower_helper_iter_typed(p: MIRProgram, m: &LowerModule, glue: LowerGlue, advance: Bool) -> LIRFunction Never! {
    if lower_lazy_element(glue.ty) != None -> return lower_lazy_cursor_helper(p, &m, glue, advance)
    if lower_range_members(p, glue.ty) != None -> return lower_range_cursor_helper(&m, glue, advance)
    if lower_iterable_next(p, glue.ty) == .Val(next) -> return lower_iterable_cursor_helper(p, &m, glue, next, advance)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    cursor :: f.open_params[0].copy()
    elem :: lower_sequence_element(glue.ty) ?? {
        lower_fail(&m, &f, "non-List iterator helper is not lowered at O0 yet")
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    list :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: list, base: cursor, offset: 0})
    at :: lower_list_word(&f, cursor, 8)
    transferred :: lower_list_word(&f, cursor, 40)
    first :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: first, op: LIRBinaryOp.Add, left: at, right: transferred})
    length :: lower_list_word(&f, list, 0)
    last := length
    if advance {
        stride :: lower_list_word(&f, cursor, 16)
        remaining :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: length, right: at})
        ends :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: ends, condition: LIRCondition.Ge, left: stride, right: remaining})
        exhausted :: lower_new_block(&f)
        increment :: lower_new_block(&f)
        join :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: ends, then_target: lower_target(exhausted, [LIRValueID]{}), else_target: lower_target(increment, [LIRValueID]{})})
        lower_start(&f, exhausted, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{length})})
        lower_start(&f, increment, [LIRValueID]{})
        next_at :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: stride})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{next_at})})
        last = lower_word(&f)
        lower_start(&f, join, [LIRValueID]{last})
    }
    lower_iter_drop_range(p, &m, &f, list, elem, first, last)
    if advance {
        lower_emit(&f, LIRInst.Store{base: cursor, offset: 8, value: last})
        lower_store_word(&f, cursor, 32, 0)
        lower_store_word(&f, cursor, 40, 0)
    } else {
        cap :: lower_list_word(&f, list, 8)
        data :: lower_list_data(&f, list)
        lower_list_free_buffer(&m, &f, data, cap, lower_list_stride(p, elem))
        // The header belongs to its holder's storage, never to the cursor.
    }
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// LIR has only direct calls. A closed dispatch over the types registered by
// LoopIterInit keeps IterCursor's destructor type-erased without a new ABI.
fn lower_iter_dispatch(p: MIRProgram, m: &LowerModule, f: &LowerFunction, cursor: LIRValueID, advance: Bool) Never! {
    key :: lower_list_word(&f, cursor, 24)
    done :: lower_new_block(&f)
    count :: m.glue.len()
    loop index in 0..<count {
        // copy: the glue row is read while the dispatch emits into `&f` and registers helpers in
        // `m`. A view into m.glue would dangle when that list grows.
        row :: m.glue[index].copy()
        if row.helper != "iter.release" -> next
        expected :: lower_const(&f, row.id.value)
        matches :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: matches, condition: LIRCondition.Eq, left: key, right: expected})
        selected :: lower_new_block(&f)
        next_block :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: matches, then_target: lower_target(selected, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
        lower_start(&f, selected, [LIRValueID]{})
        lower_call_helper(&m, &f, if advance -> "iter.advance.typed" else -> "iter.release", row.ty, [LIRValueID]{cursor}, None)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, next_block, [LIRValueID]{})
    }
    args :: lower_static_text(&m, &f, "invalid iterator cursor source")
    lower_noreturn_call(&m, &f, "jet_rt_unreachable", args)
    lower_start(&f, done, [LIRValueID]{})
}

fn lower_iter_drop_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    cursor :: f.open_params[0].copy()
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: cursor, right: null})
    done :: lower_new_block(&f)
    release :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, release, [LIRValueID]{})
    lower_iter_dispatch(p, &m, &f, cursor, false)
    size :: lower_const(&f, 48)
    align :: lower_const(&f, 8)
    lower_call_runtime(&m, &f, "jet_rt_free", [LIRValueID]{cursor, size, align}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_iter_advance(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    cursor :: f.open_params[0].copy()
    lower_iter_dispatch(p, &m, &f, cursor, true)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_iter_clone_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    lower_fail(&m, &f, "iterator cursor clone is not lowered at O0 yet")
    lower_seal(&f, LIRTerminator.Unreachable)
    lir_builder_finish(f.builder)
}

// A `Range` value's fields (Values.rs JetRange {start, end, exclusive}), None
// for any other type.
fn lower_range_members(p: MIRProgram, ty: MIRType) -> [LowerMember]? {
    members :: lower_inline_members(p, ty)
    if members.len() != 3 -> return None
    found := [LowerMember]{}
    names :: [String]{"start", "end", "exclusive"}
    loop name in names {
        index := -1
        loop (at, member) in members { if member.name == name -> index = at }
        if index < 0 -> return None
        &found.push(members[index])
    }
    loop index in 0..<2 {
        repr :: lower_repr(p, found[index].ty)
        if repr != .Word && repr != .ExactInt -> return None
    }
    if lower_repr(p, found[2].ty) != .Flag -> return None
    Val(found)
}

// A Range bound as its native word (exact Ints narrow like the Rust i64 field).
fn lower_range_bound(p: MIRProgram, m: &LowerModule, f: &LowerFunction, range: LIRValueID, member: LowerMember) -> LIRValueID? {
    value :: lower_read_at(p, &f, range, member.offset, member.ty) ?? return None
    if !lower_is_exact_int(member.ty) -> return Val(value)
    native :: lower_word(&f)
    lower_convert_exact(&m, &f, native, value, "jet_int_owned_to_i64", false)
    Val(native)
}

// `loop n in range` over a Range value (Collections.rs JetLoopSource for
// JetRange: the Ints start..end, the end one further, saturating, when
// inclusive). The IterCursor box holds native words, no element buffer:
// [current, -1 - stride, end, release-id, taken, owned flag]. The stride's
// encoding (< -1) is the marker: List positions are >= 0, an Iter's is -1.
fn lower_range_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, ty: MIRType, source: LIRValueID, members: [LowerMember], stride: LIRValueID) Never! {
    start :: lower_range_bound(p, &m, &f, source, members[0]) ?? return
    last :: lower_range_bound(p, &m, &f, source, members[1]) ?? return
    exclusive :: lower_read_at(p, &f, source, members[2].offset, members[2].ty) ?? return
    inclusive :: lower_new_block(&f)
    widen :: lower_new_block(&f)
    join :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: exclusive, then_target: lower_target(join, [LIRValueID]{last}), else_target: lower_target(inclusive, [LIRValueID]{})})
    lower_start(&f, inclusive, [LIRValueID]{})
    max :: lower_const(&f, 9223372036854775807)
    saturated :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: saturated, condition: LIRCondition.Eq, left: last, right: max})
    lower_seal(&f, LIRTerminator.Branch{condition: saturated, then_target: lower_target(join, [LIRValueID]{last}), else_target: lower_target(widen, [LIRValueID]{})})
    lower_start(&f, widen, [LIRValueID]{})
    one :: lower_const(&f, 1)
    widened :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: widened, op: LIRBinaryOp.Add, left: last, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{widened})})
    end :: lower_word(&f)
    lower_start(&f, join, [LIRValueID]{end})
    release :: lower_helper_id(&m, "iter.release", ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: start})
    minus_one :: lower_const(&f, -1)
    marker :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: marker, op: LIRBinaryOp.Sub, left: minus_one, right: stride})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: marker})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: end})
    lower_store_word(&f, dst, 24, release.value)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
}

// Whether `cursor` is a Range value's (marker < -1 at offset 8).
fn lower_iter_range_test(f: &LowerFunction, cursor: LIRValueID) -> LIRValueID Never! {
    marker :: lower_list_word(&f, cursor, 8)
    ranged :: lower_flag(&f)
    minus_one :: lower_const(&f, -1)
    lower_emit(&f, LIRInst.Compare{dst: ranged, condition: LIRCondition.Lt, left: marker, right: minus_one})
    ranged
}

// A Range cursor has a value while `current < end` and it is not yet taken.
fn lower_iter_range_more(f: &LowerFunction, cursor: LIRValueID) -> LIRValueID Never! {
    current :: lower_list_word(&f, cursor, 0)
    end :: lower_list_word(&f, cursor, 16)
    taken :: lower_list_word(&f, cursor, 32)
    zero :: lower_const(&f, 0)
    within :: lower_flag(&f)
    ready :: lower_flag(&f)
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: within, condition: LIRCondition.Lt, left: current, right: end})
    lower_emit(&f, LIRInst.Compare{dst: ready, condition: LIRCondition.Eq, left: taken, right: zero})
    lower_logic(&f, more, true, within, ready)
    more
}

// LoopCursor.rs jet_loop_iter_typed_advance: `stride` more steps, or the end
// when fewer remain. A release owns nothing beyond the box.
fn lower_range_cursor_helper(m: &LowerModule, glue: LowerGlue, advance: Bool) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    cursor :: f.open_params[0].copy()
    if advance {
        current :: lower_list_word(&f, cursor, 0)
        marker :: lower_list_word(&f, cursor, 8)
        minus_one :: lower_const(&f, -1)
        stride :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: stride, op: LIRBinaryOp.Sub, left: minus_one, right: marker})
        end :: lower_list_word(&f, cursor, 16)
        live :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: live, condition: LIRCondition.Lt, left: current, right: end})
        step :: lower_new_block(&f)
        stepped :: lower_new_block(&f)
        join :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: live, then_target: lower_target(step, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{end})})
        lower_start(&f, step, [LIRValueID]{})
        // end - current fits an unsigned word whenever current < end.
        remaining :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: end, right: current})
        fits :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.ULt, left: stride, right: remaining})
        lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(stepped, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{end})})
        lower_start(&f, stepped, [LIRValueID]{})
        advanced :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: advanced, op: LIRBinaryOp.Add, left: current, right: stride})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{advanced})})
        moved :: lower_word(&f)
        lower_start(&f, join, [LIRValueID]{moved})
        lower_emit(&f, LIRInst.Store{base: cursor, offset: 0, value: moved})
        lower_store_word(&f, cursor, 32, 0)
    }
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}
