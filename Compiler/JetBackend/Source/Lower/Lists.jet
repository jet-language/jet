// A List is an inline [len, cap, data] header (24 bytes) in its holder's
// storage, like a struct: the value is the header's address, and List drop
// glue frees the buffer, never the header. Elements occupy
// `lower_list_stride` bytes each (fixed integers packed at their ABI width;
// an inline aggregate element is its padded bytes) in a separately allocated buffer; growth
// moves elements, not owners.
use jet_foundation.[
    MIRAccess, MIRCallArg, MIRIndexKind, MIRInstruction, MIRPanicLoc, MIRPlaceID, MIRPreludeCall,
    MIRPreludeCallID, MIRPreludeFamily, MIRProgram, MIRTupleField, MIRType, MIRTypeID, MIRTypeKind, MIRValueID, mir_symbol_name,
    mir_type_display_name, mir_type_from_kind, mir_type_identity_key,
]

fn lower_list_element(ty: MIRType) -> MIRType? {
    if lower_typed_nominal(ty, "Sh") -> return Val(mir_type_from_kind(MIRTypeKind.String))
    if ty.kind == {
        // copy: `elem` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .List(elem) -> Val(elem.copy())
        // A fixed `[T#N]` (MIRRust.rs `[T; N]`) is carried as a List of N
        // elements: its reads, iteration, display and widening are a List's.
        // copy: `elem` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .FixedList(elem, _) -> Val(elem.copy())
        .Tagged(_, inner) -> lower_list_element(inner)
        .InlineRange(inner, _, _) -> lower_list_element(inner)
        else -> lower_view_element(ty)
    }
}

// View<T> / ViewMut<T> (MIRRust.rs: `&[T]` / `&mut [T]`, D-DYNARRAY1) is a
// borrowed window into a List's buffer, laid out as the List header
// [len, 0, data] in its holder's storage, data at the window's first
// element. The zero capacity marks a buffer the header does not own (as for a
// frozen List, Statics.jet): a window owns neither buffer nor elements, so it
// has no drop glue and a copy is its three words. List reads (index, len,
// iteration, display, route arguments) read it unchanged, and ViewMut writes
// land in the owner's buffer. A View<str> is text (Strings.jet).
fn lower_view_element(ty: MIRType) -> MIRType? {
    if lower_string_view(ty) -> return None
    if ty.kind == .Apply(name, args) {
        if (name.name == "View" || name.name == "ViewMut") && args.len() == 1 -> return Val(args[0])
    }
    None
}

fn lower_list_repr(p: MIRProgram, ty: MIRType, elem: MIRType) -> LowerRepr Never! {
    repr :: lower_repr(p, elem)
    if repr == .Unsupported(reason) -> return LowerRepr.Unsupported{reason: "List element {reason}"}
    LowerRepr.Inline{ty: ty}
}

fn lower_list_word(f: &LowerFunction, base: LIRValueID, offset: Int) -> LIRValueID Never! {
    dst :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: dst, base: base, offset: offset})
    dst
}

fn lower_list_data(f: &LowerFunction, list: LIRValueID) -> LIRValueID Never! {
    data :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: data, base: list, offset: 16})
    data
}

fn lower_list_address(f: &LowerFunction, data: LIRValueID, index: LIRValueID, stride: Int) -> LIRValueID Never! {
    bytes :: lower_word(&f)
    width :: lower_const(&f, stride)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: LIRBinaryOp.Mul, left: index, right: width})
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.PointerAdd{dst: address, base: data, offset: bytes})
    address
}

fn lower_list_buffer(m: &LowerModule, f: &LowerFunction, cap: LIRValueID, stride: Int) -> LIRValueID Never! {
    zero :: lower_const(&f, 0)
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: cap, right: zero})
    absent :: lower_new_block(&f)
    allocate :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(absent, [LIRValueID]{}), else_target: lower_target(allocate, [LIRValueID]{})})
    lower_start(&f, absent, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{null})})
    lower_start(&f, allocate, [LIRValueID]{})
    bytes :: lower_word(&f)
    width :: lower_const(&f, stride)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: LIRBinaryOp.Mul, left: cap, right: width})
    eight :: lower_const(&f, 8)
    data :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_alloc", [LIRValueID]{bytes, eight}, Val(data))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{data})})
    result :: lower_pointer(&f)
    lower_start(&f, done, [LIRValueID]{result})
    result
}

fn lower_list_free_buffer(m: &LowerModule, f: &LowerFunction, data: LIRValueID, cap: LIRValueID, stride: Int) Never! {
    zero :: lower_const(&f, 0)
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: cap, right: zero})
    release :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, release, [LIRValueID]{})
    bytes :: lower_word(&f)
    width :: lower_const(&f, stride)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: LIRBinaryOp.Mul, left: cap, right: width})
    eight :: lower_const(&f, 8)
    lower_call_runtime(&m, &f, "jet_rt_free", [LIRValueID]{data, bytes, eight}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// MIRRust.rs:build_list moves the supplied element values into the new List.
fn lower_build_list(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, values: [MIRValueID], trait_coercion: MIRTypeID?) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "List construction without a checked type is not lowered at O0 yet")
    elem :: lower_list_element(ty) ?? return lower_fail(&m, &f, "non-List BuildList is not lowered at O0 yet")
    stride :: lower_list_stride(p, elem)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    count :: lower_const(&f, values.len())
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: count})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: count})
    data :: lower_pointer(&f)
    if values.len() == 0 {
        lower_emit(&f, LIRInst.Const{dst: data, value: 0})
    } else {
        lower_alloc(&m, &f, data, stride * values.len())
    }
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
    loop (index, value) in values {
        if trait_coercion != None {
            source_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "List trait payload has no checked type")
            if lower_trait_ref(p, source_ty) != None {
                lower_store_value(p, &m, &f, data, stride * index, value, elem)
                next
            }
            source :: if lower_repr(p, source_ty) == .Absent -> None else -> lower_use(&m, &f, value)
            boxed :: lower_pointer(&f)
            lower_trait_box_value(p, &m, &f, source, source_ty, elem, boxed)
            lower_emit(&f, LIRInst.Store{base: data, offset: stride * index, value: boxed})
        } else {
            lower_store_value(p, &m, &f, data, stride * index, value, elem)
        }
        if f.failed -> return
    }
}

fn lower_index_address(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, list: LIRValueID, list_ty: MIRType, index: MIRValueID) -> LowerFieldAddress? {
    elem :: lower_list_element(list_ty) ?? {
        lower_fail(&m, &f, "non-List indexed place is not lowered at O0 yet")
        return None
    }
    at :: lower_use(&m, &f, index) ?? return None
    if lower_value_layout(f, at) != lir_layout_word() {
        lower_fail(&m, &f, "non-word List index is not lowered at O0 yet")
        return None
    }
    length :: lower_list_word(&f, list, 0)
    negative :: lower_flag(&f)
    past :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: at, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Ge, left: at, right: length})
    invalid :: lower_flag(&f)
    lower_logic(&f, invalid, false, negative, past)
    stop :: lower_new_block(&f)
    valid :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    lower_call_runtime(&m, &f, "jet_rt_panic_list_bounds", [LIRValueID]{length, at}, None)
    lower_numeric_stopped(p, Val(c), &m, &f)
    lower_start(&f, valid, [LIRValueID]{})
    data :: lower_list_data(&f, list)
    Val(LowerFieldAddress{base: lower_list_address(&f, data, at, lower_list_stride(p, elem)), offset: 0})
}

// A borrowed indexed element never inherits the List's ownership. An owned
// result clones handles/boxes, just as an owned Copy does (MIRRust.rs:index);
// an owned inline element is cloned into storage of its own.
fn lower_list_index(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, base: MIRValueID, index: MIRValueID, kind: MIRIndexKind, access: MIRAccess) Never! {
    if (kind != .List && kind != .FixedListProof) || access != .Read -> return lower_fail(&m, &f, "this indexed access is not lowered at O0 yet")
    list :: lower_use(&m, &f, base) ?? return
    ty :: lower_value_type(c, base) ?? return lower_fail(&m, &f, "List index without a checked base type is not lowered at O0 yet")
    elem :: lower_list_element(ty) ?? return lower_fail(&m, &f, "non-List indexed access is not lowered at O0 yet")
    address :: lower_index_address(p, c, &m, &f, list, ty, index) ?? return
    lower_index_result(p, c, &m, &f, instruction, base, address.base, elem)
}

// The result of an indexed read of the element of `elem` stored at `address`
// (a List element or a Map value).
fn lower_index_result(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, base: MIRValueID, address: LIRValueID, elem: MIRType) Never! {
    if lower_repr(p, elem) == .Absent -> return lower_alias_absent(&f, instruction)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if lower_value_owned(c, instruction.result ?? base) {
        if lower_repr(p, elem) == {
            .ExactInt -> {
                source :: lower_word(&f)
                lower_emit(&f, LIRInst.Load{dst: source, base: address, offset: 0})
                lower_call_runtime(&m, &f, "jet_rt_int_clone", [LIRValueID]{source}, Val(dst))
                return
            }
            .Handle(_, clone) -> {
                if clone == "" -> return lower_fail(&m, &f, "List element clone is not lowered at O0 yet")
                source :: lower_pointer(&f)
                lower_emit(&f, LIRInst.Load{dst: source, base: address, offset: 0})
                lower_call_runtime(&m, &f, clone, [LIRValueID]{source}, Val(dst))
                return
            }
            .Boxed(inner) -> {
                source :: lower_pointer(&f)
                lower_emit(&f, LIRInst.Load{dst: source, base: address, offset: 0})
                lower_call_clone_glue(&m, &f, inner, source, dst)
                return
            }
            .Inline(aggregate) -> {
                lower_storage_into(p, &f, dst, aggregate)
                lower_inline_clone(p, &m, &f, address, dst, aggregate)
                return
            }
            else -> {}
        }
    }
    lower_read_into(p, &f, dst, address, 0, elem)
}

// The [len, cap, data] header a mutating builtin method's Write receiver
// place names (a List or Map), None when reported.
fn lower_receiver_header(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, receiver_place: MIRPlaceID?, what: String) -> LIRValueID? {
    place :: receiver_place ?? {
        lower_fail(&m, &f, "{what} mutation without a Write receiver place is not lowered at O0 yet")
        return None
    }
    row_place :: lower_place_row(c.mir, c.place_rows, place) ?? {
        lower_fail(&m, &f, "{what} receiver place is missing")
        return None
    }
    slot :: c.place_slots.get(place.value) ?? {
        lower_fail(&m, &f, "{what} receiver place has no lowered root")
        return None
    }
    root :: lower_slot_root(p, c, &m, &f, slot) ?? {
        lower_fail(&m, &f, "{what} receiver place has no value")
        return None
    }
    if row_place.projections.len() == 0 -> return Val(root)
    address :: lower_walk_projections(p, c, &m, &f, root, c.slots[slot].ty, row_place.projections) ?? return None
    Val(lower_address(&f, address.base, address.offset))
}

// Raw allocation leaves operate on this backend's own List header.
fn lower_encoding_list_leaf(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg], type_args: [MIRType]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    if row.module_name != "core.mem" || (row.member != "__list_capacity" && row.member != "__list_reserve_exact" && row.member != "__type_size") -> return false
    if type_args.len() != 1 {
        lower_fail(&m, &f, "raw List layout leaf requires its checked element type")
        return true
    }
    element :: type_args[0]
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    if row.member == "__type_size" {
        size :: lower_const(&f, lower_list_stride(p, element))
        lower_emit(&f, LIRInst.Move{dst: dst, src: size})
        return true
    }
    if args.len() != (if row.member == "__list_reserve_exact" -> 2 else -> 1) {
        lower_fail(&m, &f, "raw List layout leaf has invalid checked arity")
        return true
    }
    if row.member == "__list_capacity" {
        list :: lower_use(&m, &f, args[0].value) ?? return true
        capacity :: lower_list_word(&f, list, 8)
        lower_native_count(p, c, &m, &f, instruction, dst, capacity)
        return true
    }
    list :: lower_receiver_header(p, c, &m, &f, args[0].place, "List") ?? return true
    additional :: lower_list_native_index(c, &m, &f, args[1].value) ?? return true
    stride :: lower_const(&f, lower_list_stride(p, element))
    lower_call_runtime(&m, &f, "jet_rt_encoding_list_reserve_exact", [LIRValueID]{list, stride, additional}, Val(dst))
    true
}

// Route identities come from BuiltinMethods.jet:142,163,477,485, not display names.
fn lower_list_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    ty :: lower_value_type(c, receiver) ?? return false
    _ := lower_list_element(ty) ?? return false
    if row.family != .BuiltinMethod || row.module_name != "core.builtin" -> return false
    symbol :: lower_runtime_symbol(row)
    if row.member == "split_write" && symbol == "jet_split_write" {
        lower_disjoint_split(p, c, &m, &f, instruction, receiver, ty, receiver_place, args)
        return true
    }
    if row.member == "get_disjoint_write" && symbol == "jet_get_disjoint_write" {
        lower_disjoint_get(p, c, &m, &f, instruction, receiver, ty, receiver_place, args)
        return true
    }
    if row.member == "list_reverse" && symbol == "jet_list_reverse" {
        if args.len() != 0 {
            lower_fail(&m, &f, "List.reverse requires no arguments")
            return true
        }
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        lower_call_helper(&m, &f, "list.reverse", ty, [LIRValueID]{list}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if row.member == "last" && symbol == "jet_list_last" {
        if args.len() != 0 {
            lower_fail(&m, &f, "List.last requires no arguments")
            return true
        }
        list :: lower_use(&m, &f, receiver) ?? return true
        length :: lower_list_word(&f, list, 0)
        one :: lower_const(&f, 1)
        index :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: index, op: LIRBinaryOp.Sub, left: length, right: one})
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "list.get", ty, [LIRValueID]{list, index}, Val(dst))
        return true
    }
    if row.member == "list_extend" && symbol == "jet_list_extend" {
        if args.len() != 1 {
            lower_fail(&m, &f, "List.extend requires one owned List")
            return true
        }
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        source :: lower_use(&m, &f, args[0]) ?? return true
        lower_call_helper(&m, &f, "list.extend", ty, [LIRValueID]{list, source}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if row.member == "list_try_reserve" && symbol == "jet_list_try_reserve" {
        if args.len() != 1 {
            lower_fail(&m, &f, "List.try_reserve requires one additional capacity")
            return true
        }
        result_ty :: lower_checked_type(c, instruction) ?? return true
        if result_ty.kind == .Result(ok, err) {
            if lower_repr(p, ok) != .Absent || lower_record_handle(p, err) != Val("AllocError") {
                lower_fail(&m, &f, "List.try_reserve requires Unit success and canonical AllocError")
                return true
            }
        } else {
            lower_fail(&m, &f, "List.try_reserve requires its checked Result")
            return true
        }
        additional_ty :: lower_value_type(c, args[0]) ?? return true
        if !lower_is_exact_int(additional_ty) {
            lower_fail(&m, &f, "List.try_reserve requires an exact Int capacity")
            return true
        }
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        additional :: lower_use(&m, &f, args[0]) ?? return true
        key :: mir_type_from_kind(MIRTypeKind.Tuple{fields: [MIRTupleField]{MIRTupleField{name: "list", ty: ty}, MIRTupleField{name: "result", ty: result_ty}}})
        dst :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
        lower_call_helper(&m, &f, "list.try_reserve", key, [LIRValueID]{list, additional}, Val(dst))
        if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, additional, additional_ty)
        if instruction.result == None -> lower_map_drop_value(p, &m, &f, dst, result_ty)
        return true
    }
    if row.member == "list_swap" && symbol == "jet_list_swap" {
        if args.len() != 2 {
            lower_fail(&m, &f, "List.__swap requires two indices")
            return true
        }
        elem :: lower_list_element(ty) ?? return true
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        length :: lower_list_word(&f, list, 0)
        indices := [LIRValueID]{}
        loop arg in args {
            arg_ty :: lower_value_type(c, arg) ?? return true
            value :: lower_use(&m, &f, arg) ?? return true
            index := value
            if lower_is_exact_int(arg_ty) {
                index = lower_word(&f)
                lower_convert_exact(&m, &f, index, value, "jet_int_owned_to_i64", false)
            }
            zero :: lower_const(&f, 0)
            negative :: lower_flag(&f)
            past :: lower_flag(&f)
            invalid :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: index, right: zero})
            lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Ge, left: index, right: length})
            lower_logic(&f, invalid, false, negative, past)
            stop :: lower_new_block(&f)
            valid :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
            lower_start(&f, stop, [LIRValueID]{})
            lower_noreturn_call(&m, &f, "jet_rt_panic_list_bounds", [LIRValueID]{length, index})
            lower_start(&f, valid, [LIRValueID]{})
            &indices.push(index)
        }
        same :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: indices[0], right: indices[1]})
        move :: lower_new_block(&f)
        done :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(move, [LIRValueID]{})})
        lower_start(&f, move, [LIRValueID]{})
        data :: lower_list_data(&f, list)
        stride :: lower_list_stride(p, elem)
        if stride %% 8 != 0 {
            lower_fail(&m, &f, "List.__swap requires a word-padded element layout")
            return true
        }
        first :: lower_list_address(&f, data, indices[0], stride)
        second :: lower_list_address(&f, data, indices[1], stride)
        // Move the complete padded element layout, including inline owners.
        // No temporary owner, Clone, Close, allocation or drop is introduced.
        loop word in 0..<(stride /% 8) {
            offset :: word * 8
            left :: lower_list_word(&f, first, offset)
            right :: lower_list_word(&f, second, offset)
            lower_emit(&f, LIRInst.Store{base: first, offset: offset, value: right})
            lower_emit(&f, LIRInst.Store{base: second, offset: offset, value: left})
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
        lower_alias_absent(&f, instruction)
        return true
    }
    if (row.member == "view_new" && symbol == "jet_view_new") || (row.member == "view_mut_new" && symbol == "jet_view_mut_new") {
        lower_view_new(p, c, &m, &f, instruction, receiver, ty, receiver_place, args)
        return true
    }
    if row.member == "get" && symbol == "jet_list_get_opt" {
        if args.len() != 1 {
            lower_fail(&m, &f, "List.get without one index is not lowered at O0 yet")
            return true
        }
        list :: lower_use(&m, &f, receiver) ?? return true
        index_ty :: lower_value_type(c, args[0]) ?? {
            lower_fail(&m, &f, "List.get without a checked index type is not lowered at O0 yet")
            return true
        }
        index :: lower_use(&m, &f, args[0]) ?? return true
        native := index
        if lower_is_exact_int(index_ty) {
            native = lower_word(&f)
            lower_convert_exact(&m, &f, native, index, "jet_int_owned_to_i64", false)
        }
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "list.get", ty, [LIRValueID]{list, native}, Val(dst))
        return true
    }
    if lower_list_method_more(p, c, &m, &f, instruction, row, symbol, receiver, receiver_place, args, ty) -> return true
    if lower_list_method_shape(p, c, &m, &f, instruction, row, symbol, receiver, receiver_place, args, ty) -> return true
    if lower_list_method_window(p, c, &m, &f, instruction, row, symbol, receiver, args, ty) -> return true
    length_route :: row.member == "len" && symbol == "jet_list_len"
    empty_route :: row.member == "is_empty" && symbol == "jet_list_is_empty"
    push_route :: row.member == "list_push" && symbol == "jet_list_push"
    pop_route :: row.member == "list_pop" && symbol == "jet_list_pop_kernel"
    clear_route :: row.member == "list_clear" && symbol == "jet_list_clear"
    join_route :: row.member == "join" && symbol == "jet_list_join"
    if !length_route && !empty_route && !push_route && !pop_route && !join_route && !clear_route -> return false
    if args.len() != (if push_route || join_route -> 1 else -> 0) {
        lower_fail(&m, &f, "this List method arity is not lowered at O0 yet")
        return true
    }
    list := LIRValueID{value: -1}
    if push_route || pop_route || clear_route {
        list = lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
    } else {
        list = lower_use(&m, &f, receiver) ?? return true
    }
    if push_route {
        value :: args[0]
        elem :: lower_list_element(ty) ?? return true
        if lower_repr(p, elem) == .Absent {
            lower_call_helper(&m, &f, "list.push", ty, [LIRValueID]{list}, None)
        } else {
            source_ty :: lower_value_type(c, value) ?? return true
            lowered := lower_use(&m, &f, value) ?? return true
            if lower_trait_ref(p, elem) != None && lower_trait_ref(p, source_ty) == None {
                boxed :: lower_pointer(&f)
                lower_trait_box_value(p, &m, &f, Val(lowered), source_ty, elem, boxed)
                lowered = boxed
            }
            lower_call_helper(&m, &f, "list.push", ty, [LIRValueID]{list, lowered}, None)
        }
        lower_alias_absent(&f, instruction)
    } else if pop_route {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "list.pop", ty, [LIRValueID]{list}, Val(dst))
    } else if clear_route {
        elem :: lower_list_element(ty) ?? return true
        if lower_needs_drop(p, m, elem) {
            data :: lower_list_data(&f, list)
            cap :: lower_list_word(&f, list, 8)
            done :: lower_new_block(&f)
            lower_static_list_drop_guard(&f, cap, data, done)
            lower_list_drop_elements(p, &m, &f, list, data, elem)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
            lower_start(&f, done, [LIRValueID]{})
        }
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: zero})
        lower_alias_absent(&f, instruction)
    } else if join_route {
        separator :: lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "list.join", ty, [LIRValueID]{list, separator}, Val(dst))
    } else {
        length :: lower_list_word(&f, list, 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if length_route {
            lower_native_count(p, c, &m, &f, instruction, dst, length)
        } else {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        }
    }
    true
}

// Range fields are read using the checked declaration's layout. Bare bounds
// differ by kernel: List/View are inclusive, jet_string_slice is exclusive.
struct LowerSliceBounds { start: LIRValueID, end: LIRValueID, exclusive: LIRValueID }

fn lower_slice_bounds(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, args: [MIRValueID], bare_exclusive: Bool) -> LowerSliceBounds? {
    bounds := [LIRValueID]{}
    bound_types := [MIRType]{}
    exclusive := LIRValueID{value: -1}
    if args.len() == 2 {
        loop arg in args {
            bound_ty :: lower_value_type(c, arg) ?? {
                lower_fail(&m, &f, "a slice bound without a checked type is not lowered at O0 yet")
                return None
            }
            bound :: lower_use(&m, &f, arg) ?? return None
            &bounds.push(bound)
            &bound_types.push(bound_ty)
        }
        exclusive = lower_const_flag(&f, if bare_exclusive -> 1 else -> 0)
    } else if args.len() == 1 {
        range_ty :: lower_value_type(c, args[0]) ?? {
            lower_fail(&m, &f, "a slice range without a checked type is not lowered at O0 yet")
            return None
        }
        range :: lower_use(&m, &f, args[0]) ?? return None
        members :: lower_inline_members(p, range_ty)
        names :: [String]{"start", "end", "exclusive"}
        loop name in names {
            found := -1
            loop (index, member) in members { if member.name == name -> found = index }
            if found < 0 {
                lower_fail(&m, &f, "a slice range of type {mir_type_display_name(range_ty)} has no {name} field")
                return None
            }
            member :: members[found]
            value :: lower_read_at(p, &f, range, member.offset, member.ty) ?? {
                lower_fail(&m, &f, "a slice range field without a layout is not lowered at O0 yet")
                return None
            }
            if name == "exclusive" -> exclusive = value
            else {
                &bounds.push(value)
                &bound_types.push(member.ty)
            }
        }
    } else {
        lower_fail(&m, &f, "this slice bound arity is not lowered at O0 yet")
        return None
    }
    if lower_value_layout(f, exclusive) != lir_layout_bool() {
        lower_fail(&m, &f, "a non-Bool slice end flag is not lowered at O0 yet")
        return None
    }
    natives := [LIRValueID]{}
    loop (index, bound) in bounds {
        if lower_value_layout(f, bound) != lir_layout_word() {
            lower_fail(&m, &f, "a non-word slice bound is not lowered at O0 yet")
            return None
        }
        if lower_is_exact_int(bound_types[index]) {
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, bound, "jet_int_owned_to_i64", false)
            &natives.push(native)
        } else {
            &natives.push(bound)
        }
    }
    Val(LowerSliceBounds{start: natives[0], end: natives[1], exclusive: exclusive})
}

// Only the shared runtime checks bounds and chooses the exclusive stop.
// The backend marshals a window header; owned slices clone its elements.
fn lower_slice_window(p: MIRProgram, m: &LowerModule, f: &LowerFunction, list: LIRValueID, elem: MIRType, bounds: LowerSliceBounds, site: MIRPanicLoc, view: Bool, dst: LIRValueID) Never! {
    length :: lower_list_word(&f, list, 0)
    args := [LIRValueID]{bounds.start, bounds.end, bounds.exclusive, length}
    loop arg in lower_location(p, &m, &f, site) -> &args.push(arg)
    stop_at :: lower_word(&f)
    lower_call_runtime(&m, &f, if view -> "jet_rt_view_end" else -> "jet_rt_slice_end", args, Val(stop_at))
    count :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: count, op: LIRBinaryOp.Sub, left: stop_at, right: bounds.start})
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: count})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    data :: lower_list_data(&f, list)
    first :: lower_list_address(&f, data, bounds.start, lower_list_stride(p, elem))
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: first})
}

fn lower_view_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, receiver_ty: MIRType, receiver_place: MIRPlaceID?, args: [MIRValueID]) Never! {
    elem :: lower_list_element(receiver_ty) ?? return lower_fail(&m, &f, "a view of a non-List is not lowered at O0 yet")
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "a view without a checked type is not lowered at O0 yet")
    if lower_view_element(ty) == None -> return lower_fail(&m, &f, "a view of type {mir_type_display_name(ty)} is not lowered at O0 yet")
    bounds :: lower_slice_bounds(p, c, &m, &f, args, false) ?? return
    list :: (if receiver_place != None -> lower_receiver_header(p, c, &m, &f, receiver_place, "View") else -> lower_use(&m, &f, receiver)) ?? return
    site :: MIRPanicLoc{file: c.mir.source_file, line: lower_source_line(p, &m, c.mir.source_file, c.mir.span.start), column: 0}
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    lower_slice_window(p, &m, &f, list, elem, bounds, site, true, dst)
}

fn lower_slice(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, base: MIRValueID, start: MIRValueID, end: MIRValueID, range: MIRValueID?, site: MIRPanicLoc) Never! {
    symbol :: lower_runtime_symbol(row)
    if symbol != "jet_slice_vec" && symbol != "jet_slice_vec_range" && symbol != "jet_slice_range" && symbol != "jet_string_slice"
        && symbol != "jet_view_new" && symbol != "jet_view_new_range" && symbol != "jet_view_mut_new" && symbol != "jet_view_mut_new_range" {
        return lower_fail(&m, &f, "Slice runtime kernel {symbol} is not lowered at O0 yet")
    }
    args :: if range == .Val(value) -> [MIRValueID]{value} else -> [MIRValueID]{start, end}
    bounds :: lower_slice_bounds(p, c, &m, &f, args, symbol == "jet_string_slice") ?? return
    base_ty :: lower_value_type(c, base) ?? return lower_fail(&m, &f, "Slice without a checked base type is not lowered at O0 yet")
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Slice without a checked result type is not lowered at O0 yet")
    source :: lower_use(&m, &f, base) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if lower_string_type(base_ty) {
        call_args := [LIRValueID]{source, bounds.start, bounds.end, bounds.exclusive}
        loop arg in lower_location(p, &m, &f, site) -> &call_args.push(arg)
        return lower_call_runtime(&m, &f, "jet_rt_string_slice_range", call_args, Val(dst))
    }
    elem :: lower_list_element(base_ty) ?? return lower_fail(&m, &f, "Slice of {mir_type_display_name(base_ty)} is not lowered at O0 yet")
    if lower_list_element(ty) == None -> return lower_fail(&m, &f, "Slice result {mir_type_display_name(ty)} is not lowered at O0 yet")
    lower_storage_into(p, &f, dst, ty)
    if lower_view_element(ty) != None {
        return lower_slice_window(p, &m, &f, source, elem, bounds, site, true, dst)
    }
    window :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: window, size: 24, align: 8})
    lower_slice_window(p, &m, &f, source, elem, bounds, site, false, window)
    lower_inline_clone(p, &m, &f, window, dst, ty)
}

// Moves one element's value (an inline aggregate's bytes) from `from` to `to`.
fn lower_list_move(p: MIRProgram, f: &LowerFunction, to: LIRValueID, from: LIRValueID, elem: MIRType) Never! {
    value :: lower_read_at(p, &f, from, 0, elem) ?? return
    lower_write_at(p, &f, to, 0, value, elem)
}

// The same element walk serves drop and clone. Trivial elements use their
// actual layout, including byte Bool and float; Unit occupies an unused slot.
fn lower_list_drop_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    list :: f.open_params[0].copy()
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: list, right: null})
    done :: lower_new_block(&f)
    live :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
    lower_start(&f, live, [LIRValueID]{})
    cap :: lower_list_word(&f, list, 8)
    data :: lower_list_data(&f, list)
    lower_static_list_drop_guard(&f, cap, data, done)
    stride :: lower_list_stride(p, elem)
    lower_list_drop_elements(p, &m, &f, list, data, elem)
    lower_list_free_buffer(&m, &f, data, cap, stride)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Vec::clear and List drop visit the same owned elements in index order.
// Clear leaves capacity and the allocation intact, so later push reuses it.
fn lower_list_drop_elements(p: MIRProgram, m: &LowerModule, f: &LowerFunction, list: LIRValueID, data: LIRValueID, elem: MIRType) Never! {
    if !lower_needs_drop(p, m, elem) -> return
    length :: lower_list_word(&f, list, 0)
    zero :: lower_const(&f, 0)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    release :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    address :: lower_list_address(&f, data, at, lower_list_stride(p, elem))
    lower_drop_stored(p, &m, &f, address, 0, elem)
    next_at :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, release, [LIRValueID]{})
}

// Inline clone glue: fills the header at `target` with a copy of `source`.
fn lower_list_clone_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue, elem: MIRType) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    source :: f.open_params[0].copy()
    target :: f.open_params[1].copy()
    length :: lower_list_word(&f, source, 0)
    source_data :: lower_list_data(&f, source)
    lower_emit(&f, LIRInst.Store{base: target, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: target, offset: 8, value: length})
    stride :: lower_list_stride(p, elem)
    target_data :: lower_list_buffer(&m, &f, length, stride)
    lower_emit(&f, LIRInst.Store{base: target, offset: 16, value: target_data})
    zero :: lower_const(&f, 0)
    at :: lower_word(&f)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    from :: lower_list_address(&f, source_data, at, stride)
    to :: lower_list_address(&f, target_data, at, stride)
    lower_list_move(p, &f, to, from, elem)
    if lower_needs_drop(p, m, elem) -> lower_glue_clone_fields(p, &m, &f, from, to, [LowerGlueField]{LowerGlueField{offset: 0, ty: elem}})
    next_at :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// `list.join(separator)`: every element shown (Printable, as MIRRust.rs
// jet_list_join's JetShow) with the separator between them.
fn lower_helper_list_join(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.join helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    separator :: f.open_params[1].copy()
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_data(&f, list)
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    at :: lower_word(&f)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    between :: lower_new_block(&f)
    item :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Eq, left: at, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(item, [LIRValueID]{}), else_target: lower_target(between, [LIRValueID]{})})
    lower_start(&f, between, [LIRValueID]{})
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, separator}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(item, [LIRValueID]{})})
    lower_start(&f, item, [LIRValueID]{})
    address :: lower_list_address(&f, data, at, stride)
    value :: lower_render_load(p, &f, address, 0, elem, false)
    lower_render_push(p, &m, &f, builder, elem, value, LowerRenderMode.Show)
    next_at :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    lower_seal(&f, LIRTerminator.Return{value: Val(text)})
    lir_builder_finish(f.builder)
}

// The pushed value is taken over (lower_helper_start_taking).
fn lower_helper_list_push(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.push helper has no List type")
    params := [LIRLayout]{lir_layout_pointer()}
    if lower_repr_layout(lower_repr(p, elem)) == .Val(layout) -> &params.push(layout)
    taken :: lower_drop(&m, lower_repr(p, elem), true)
    f := lower_helper_start_taking(&m, glue, params, [LIRDrop]{LIRDrop.Trivial, taken}, None)
    list :: f.open_params[0].copy()
    incoming :: if f.open_params.len() == 2 -> Val(f.open_params[1].copy()) else -> None
    length :: lower_list_reserve(p, &m, &f, list, elem)
    data :: lower_list_data(&f, list)
    address :: lower_list_address(&f, data, length, lower_list_stride(p, elem))
    if incoming == .Val(value) -> lower_write_at(p, &f, address, 0, value, elem)
    new_length :: lower_word(&f)
    increment :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: new_length, op: LIRBinaryOp.Add, left: length, right: increment})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: new_length})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Makes room for one more element of `elem` in the [len, cap, data] header at
// `list`, doubling a full buffer (moving its elements); returns the length,
// with the open block continuing once the room exists.
fn lower_list_reserve(p: MIRProgram, m: &LowerModule, f: &LowerFunction, list: LIRValueID, elem: MIRType) -> LIRValueID Never! {
    stride :: lower_list_stride(p, elem)
    length :: lower_list_word(&f, list, 0)
    cap :: lower_list_word(&f, list, 8)
    old_data :: lower_list_data(&f, list)
    full :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: full, condition: LIRCondition.Eq, left: length, right: cap})
    grow :: lower_new_block(&f)
    append :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: full, then_target: lower_target(grow, [LIRValueID]{}), else_target: lower_target(append, [LIRValueID]{})})
    lower_start(&f, grow, [LIRValueID]{})
    // Keep capacities byte-addressable in signed word arithmetic before doubling.
    limit :: lower_const(&f, 576460752303423487)
    too_large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_large, condition: LIRCondition.Gt, left: cap, right: limit})
    lower_check(&m, &f, too_large, "jet_rt_panic_overflow")
    zero :: lower_const(&f, 0)
    is_zero :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_zero, condition: LIRCondition.Eq, left: cap, right: zero})
    nonempty :: lower_new_block(&f)
    empty :: lower_new_block(&f)
    allocate :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_zero, then_target: lower_target(empty, [LIRValueID]{}), else_target: lower_target(nonempty, [LIRValueID]{})})
    lower_start(&f, empty, [LIRValueID]{})
    one_cap :: lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(allocate, [LIRValueID]{one_cap})})
    lower_start(&f, nonempty, [LIRValueID]{})
    doubled :: lower_word(&f)
    two :: lower_const(&f, 2)
    lower_emit(&f, LIRInst.Binary{dst: doubled, op: LIRBinaryOp.Mul, left: cap, right: two})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(allocate, [LIRValueID]{doubled})})
    new_cap :: lower_word(&f)
    lower_start(&f, allocate, [LIRValueID]{new_cap})
    new_data :: lower_list_buffer(&m, &f, new_cap, stride)
    at :: lower_word(&f)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    moved :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(moved, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    from :: lower_list_address(&f, old_data, at, stride)
    to :: lower_list_address(&f, new_data, at, stride)
    lower_list_move(p, &f, to, from, elem)
    next_at :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, moved, [LIRValueID]{})
    lower_list_free_buffer(&m, &f, old_data, cap, stride)
    lower_emit(&f, LIRInst.Store{base: list, offset: 8, value: new_cap})
    lower_emit(&f, LIRInst.Store{base: list, offset: 16, value: new_data})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(append, [LIRValueID]{})})
    lower_start(&f, append, [LIRValueID]{})
    length
}

// Collections.rs:jet_list_pop_kernel transfers the last element into Option.
fn lower_helper_list_pop(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.pop helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    length :: lower_list_word(&f, list, 0)
    zero :: lower_const(&f, 0)
    is_empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_empty, condition: LIRCondition.Eq, left: length, right: zero})
    empty :: lower_new_block(&f)
    present :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_empty, then_target: lower_target(empty, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
    lower_start(&f, empty, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    lower_start(&f, present, [LIRValueID]{})
    last :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: last})
    stride :: lower_list_stride(p, elem)
    result :: lower_pointer(&f)
    lower_alloc(&m, &f, result, lower_option_box_size(p, elem))
    data :: lower_list_data(&f, list)
    address :: lower_list_address(&f, data, last, stride)
    lower_list_move(p, &f, result, address, elem)
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}

// jet_list_get_opt: a borrowed read returns an owned copy of the selected
// element, or None for a negative/past-end native index. The Option owns
// only its cloned payload, never the List's header or buffer.
fn lower_helper_list_get(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.get helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word()}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    index :: f.open_params[1].copy()
    length :: lower_list_word(&f, list, 0)
    zero :: lower_const(&f, 0)
    negative :: lower_flag(&f)
    past :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: index, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Ge, left: index, right: length})
    invalid :: lower_flag(&f)
    lower_logic(&f, invalid, false, negative, past)
    absent :: lower_new_block(&f)
    present :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(absent, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
    lower_start(&f, absent, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    lower_start(&f, present, [LIRValueID]{})
    result :: lower_pointer(&f)
    lower_alloc(&m, &f, result, lower_option_box_size(p, elem))
    if lower_repr(p, elem) != .Absent {
        data :: lower_list_data(&f, list)
        address :: lower_list_address(&f, data, index, lower_list_stride(p, elem))
        if lower_is_inline(p, elem) {
            lower_inline_clone(p, &m, &f, address, result, elem)
        } else {
            value :: lower_read_at(p, &f, address, 0, elem) ?? return lir_builder_finish(f.builder)
            layout :: lower_repr_layout(lower_repr(p, elem)) ?? return lir_builder_finish(f.builder)
            owned :: lower_new_value(&f, layout, LIRDrop.Trivial, elem.identity)
            lower_clone_into(p, &m, &f, value, owned, elem)
            lower_write_at(p, &f, result, 0, owned, elem)
        }
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}

// An exact Int List position as its native word (jet_int_owned_to_i64).
fn lower_list_native_index(c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID) -> LIRValueID? {
    index_ty :: lower_value_type(c, value) ?? {
        lower_fail(&m, &f, "a List position without a checked type is not lowered at O0 yet")
        return None
    }
    index :: lower_use(&m, &f, value) ?? return None
    if !lower_is_exact_int(index_ty) -> return Val(index)
    native :: lower_word(&f)
    lower_convert_exact(&m, &f, native, index, "jet_int_owned_to_i64", false)
    Val(native)
}

// Comparison, search, ordering and insertion builtins over a List or View
// header (Core/Collections.rs jet_list_equal/starts_with/ends_with/index_of/
// sort/sum, Core.rs jet_list_insert), as generated LIR. False when `row` is
// not one.
fn lower_list_method_more(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, symbol: String, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    elem :: lower_list_element(ty) ?? return false
    equal_route :: row.member == "list_equal" && symbol == "jet_list_equal"
    prefix_route :: row.member == "list_starts_with" && symbol == "jet_list_starts_with"
    suffix_route :: row.member == "list_ends_with" && symbol == "jet_list_ends_with"
    index_route :: row.member == "list_index_of" && symbol == "jet_list_index_of"
    sort_route :: (row.member == "list_sort" && symbol == "jet_list_sort") || (row.member == "list_sort_desc" && symbol == "jet_list_sort_desc")
    insert_route :: row.member == "list_insert" && symbol == "jet_list_insert"
    sum_route :: row.member == "sum" && symbol == "jet_list_sum"
    product_route :: row.member == "product" && symbol == "jet_list_product"
    if !equal_route && !prefix_route && !suffix_route && !index_route && !sort_route && !insert_route && !sum_route && !product_route -> return false
    arity :: if sort_route || sum_route || product_route -> 0 else if insert_route -> 2 else -> 1
    if args.len() != arity {
        lower_fail(&m, &f, "List {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, elem) == .Absent {
        lower_fail(&m, &f, "List {row.member} over {mir_type_display_name(elem)} is not lowered at O0 yet")
        return true
    }
    if sort_route {
        if lower_map_key_kind(p, elem) == "" {
            lower_fail(&m, &f, "List sort of {mir_type_display_name(elem)} is not lowered at O0 yet")
            return true
        }
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        lower_call_helper(&m, &f, if row.member == "list_sort_desc" -> "list.sort_desc" else -> "list.sort", ty, [LIRValueID]{list}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if insert_route {
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        index :: lower_list_native_index(c, &m, &f, args[0]) ?? return true
        value :: lower_use(&m, &f, args[1]) ?? return true
        lower_call_helper(&m, &f, "list.insert", ty, [LIRValueID]{list, index, value}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    list :: lower_use(&m, &f, receiver) ?? return true
    if sum_route || product_route {
        total :: lower_list_reduce_int(p, &m, &f, list, elem, product_route, row.member) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_each_result(&f, dst, total)
        return true
    }
    other :: lower_use(&m, &f, args[0]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    if equal_route {
        same :: lower_equal_values(p, &m, &f, ty, Val(list), Val(other)) ?? return true
        lower_emit(&f, LIRInst.Move{dst: dst, src: same})
    } else {
        helper :: if prefix_route -> "list.starts_with" else if suffix_route -> "list.ends_with" else -> "list.index_of"
        lower_call_helper(&m, &f, helper, ty, [LIRValueID]{list, other}, Val(dst))
    }
    true
}

// The exact Int sum (from 0) or product (from 1) of a List header's elements,
// in order (Collections.rs jet_list_sum/jet_list_product over JetInt: no
// partial result narrows). None (reported) for any other element type.
fn lower_list_reduce_int(p: MIRProgram, m: &LowerModule, f: &LowerFunction, list: LIRValueID, elem: MIRType, product: Bool, member: String) -> LIRValueID? {
    if !lower_is_exact_int(elem) {
        lower_fail(&m, &f, "List {member} of {mir_type_display_name(elem)} is not lowered at O0 yet")
        return None
    }
    start :: lower_const(&f, if product -> 1 else -> 0)
    each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{start})
    item :: lower_read_at(p, &f, each.address, 0, elem) ?? return None
    total :: lower_word(&f)
    if product {
        lower_exact_arithmetic(&m, &f, total, LIRBinaryOp.Mul, each.state[0], item, "jet_int_mul")
    } else {
        lower_exact_arithmetic(&m, &f, total, LIRBinaryOp.Add, each.state[0], item, "jet_int_add")
    }
    lower_each_end(&f, each, [LIRValueID]{total})
    Val(each.exit[0])
}

// The lexicographic order of two Lists of `glue.ty` (Rust Vec Ord) as a
// negative, zero or positive word: the first differing element pair decides
// (-1 / 1), else the length difference.
fn lower_helper_list_compare(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("{glue.helper} helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_word()))
    left :: f.open_params[0].copy()
    right :: f.open_params[1].copy()
    left_len :: lower_list_word(&f, left, 0)
    right_len :: lower_list_word(&f, right, 0)
    stride :: lower_list_stride(p, elem)
    left_data :: lower_list_data(&f, left)
    right_data :: lower_list_data(&f, right)
    zero :: lower_const(&f, 0)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    differ :: lower_new_block(&f)
    before :: lower_new_block(&f)
    after :: lower_new_block(&f)
    step :: lower_new_block(&f)
    ended :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    in_left :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: in_left, condition: LIRCondition.Lt, left: at, right: left_len})
    in_right :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: in_right, condition: LIRCondition.Lt, left: at, right: right_len})
    both :: lower_flag(&f)
    lower_logic(&f, both, true, in_left, in_right)
    lower_seal(&f, LIRTerminator.Branch{condition: both, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(ended, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    a_address :: lower_list_address(&f, left_data, at, stride)
    a :: lower_read_at(p, &f, a_address, 0, elem) ?? panic("list.compare element has no layout")
    b_address :: lower_list_address(&f, right_data, at, stride)
    b :: lower_read_at(p, &f, b_address, 0, elem) ?? panic("list.compare element has no layout")
    order :: lower_map_key_order(p, &m, &f, elem, a, b)
    lower_seal(&f, LIRTerminator.Branch{condition: order.same, then_target: lower_target(step, [LIRValueID]{}), else_target: lower_target(differ, [LIRValueID]{})})
    lower_start(&f, differ, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(before, [LIRValueID]{}), else_target: lower_target(after, [LIRValueID]{})})
    lower_start(&f, before, [LIRValueID]{})
    minus_one :: lower_const(&f, -1)
    lower_seal(&f, LIRTerminator.Return{value: Val(minus_one)})
    lower_start(&f, after, [LIRValueID]{})
    plus_one :: lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Return{value: Val(plus_one)})
    lower_start(&f, step, [LIRValueID]{})
    one :: lower_const(&f, 1)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, ended, [LIRValueID]{})
    // Equal prefixes: the length difference's sign decides.
    difference :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: difference, op: LIRBinaryOp.Sub, left: left_len, right: right_len})
    lower_seal(&f, LIRTerminator.Return{value: Val(difference)})
    lir_builder_finish(f.builder)
}

// `xs.starts_with(prefix)` / `xs.ends_with(suffix)`: no longer than the List,
// every position of the List's first / last `count` elements equal.
fn lower_helper_list_starts_with(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("{glue.helper} helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_bool()))
    list :: f.open_params[0].copy()
    prefix :: f.open_params[1].copy()
    yes_block :: lower_new_block(&f)
    no_block :: lower_new_block(&f)
    length :: lower_list_word(&f, list, 0)
    count :: lower_list_word(&f, prefix, 0)
    too_long :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_long, condition: LIRCondition.Gt, left: count, right: length})
    scan :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: too_long, then_target: lower_target(no_block, [LIRValueID]{}), else_target: lower_target(scan, [LIRValueID]{})})
    lower_start(&f, scan, [LIRValueID]{})
    stride :: lower_list_stride(p, elem)
    data := lower_list_data(&f, list)
    if glue.helper == "list.ends_with" {
        skipped :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: skipped, op: LIRBinaryOp.Sub, left: length, right: count})
        data = lower_list_address(&f, data, skipped, stride)
    }
    prefix_data :: lower_list_data(&f, prefix)
    zero :: lower_const(&f, 0)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: count})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(yes_block, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    a :: lower_list_address(&f, data, at, stride)
    b :: lower_list_address(&f, prefix_data, at, stride)
    lower_equal_member(p, &m, &f, elem, a, b, 0, false, no_block)
    if f.failed {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    one :: lower_const(&f, 1)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, yes_block, [LIRValueID]{})
    yes :: lower_const_flag(&f, 1)
    lower_seal(&f, LIRTerminator.Return{value: Val(yes)})
    lower_start(&f, no_block, [LIRValueID]{})
    no :: lower_const_flag(&f, 0)
    lower_seal(&f, LIRTerminator.Return{value: Val(no)})
    lir_builder_finish(f.builder)
}

// `xs.index_of(item)`: the first equal position as an `Int?` box, else None.
fn lower_helper_list_index_of(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.index_of helper has no List type")
    needle_layout :: lower_repr_layout(lower_repr(p, elem)) ?? lir_layout_pointer()
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), needle_layout}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    needle :: f.open_params[1].copy()
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_data(&f, list)
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    found :: lower_new_block(&f)
    next_block :: lower_new_block(&f)
    absent :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(absent, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    address :: lower_list_address(&f, data, at, stride)
    item :: lower_render_load(p, &f, address, 0, elem, false)
    same :: lower_equal_values(p, &m, &f, elem, item, Val(needle)) ?? {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(found, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, next_block, [LIRValueID]{})
    one :: lower_const(&f, 1)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, found, [LIRValueID]{})
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, 8)
    lower_emit(&f, LIRInst.Store{base: boxed, offset: 0, value: at})
    lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
    lower_start(&f, absent, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    lir_builder_finish(f.builder)
}

// `xs.insert(at, value)` (Collections.rs jet_list_insert_kernel): a position
// in 0...len, else the List bounds stop; later elements move up one slot.
// The inserted value is taken over (lower_helper_start_taking).
fn lower_helper_list_insert(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.insert helper has no List type")
    value_layout :: lower_repr_layout(lower_repr(p, elem)) ?? lir_layout_pointer()
    taken :: lower_drop(&m, lower_repr(p, elem), true)
    f := lower_helper_start_taking(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word(), value_layout}, [LIRDrop]{LIRDrop.Trivial, LIRDrop.Trivial, taken}, None)
    list :: f.open_params[0].copy()
    index :: f.open_params[1].copy()
    value :: f.open_params[2].copy()
    length :: lower_list_word(&f, list, 0)
    zero :: lower_const(&f, 0)
    negative :: lower_flag(&f)
    past :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: index, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Gt, left: index, right: length})
    invalid :: lower_flag(&f)
    lower_logic(&f, invalid, false, negative, past)
    stop :: lower_new_block(&f)
    valid :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    lower_noreturn_call(&m, &f, "jet_rt_panic_list_bounds", [LIRValueID]{length, index})
    lower_start(&f, valid, [LIRValueID]{})
    count :: lower_list_reserve(p, &m, &f, list, elem)
    data :: lower_list_data(&f, list)
    stride :: lower_list_stride(p, elem)
    one :: lower_const(&f, 1)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    place :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{count})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Gt, left: at, right: index})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(place, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    previous :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: previous, op: LIRBinaryOp.Sub, left: at, right: one})
    from :: lower_list_address(&f, data, previous, stride)
    to :: lower_list_address(&f, data, at, stride)
    lower_list_move(p, &f, to, from, elem)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{previous})})
    lower_start(&f, place, [LIRValueID]{})
    slot :: lower_list_address(&f, data, index, stride)
    lower_write_at(p, &f, slot, 0, value, elem)
    grown :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: grown, op: LIRBinaryOp.Add, left: count, right: one})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: grown})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// `xs.sort()` (Collections.rs jet_list_sort, a stable sort): a bottom-up
// merge sort under the element's Ord (lower_map_key_order), O(n log n)
// compares. Runs of `width` elements merge pairwise from one buffer into the
// other (the list's data and a scratch buffer of the same length, swapping
// roles each pass); a merge takes the right run's element only when it
// orders strictly before the left run's, so equal elements keep their input
// order like Rust's stable `sort`. `xs.sort_desc()` (jet_list_sort_desc, the
// stable sort under the reversed Ord) takes the right element only when it
// is strictly greater. Elements move as bytes; nothing is cloned or dropped.
fn lower_helper_list_sort(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    descending :: glue.helper == "list.sort_desc"
    elem :: lower_list_element(glue.ty) ?? panic("list.sort helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    list :: f.open_params[0].copy()
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_data(&f, list)
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    two :: lower_const(&f, 2)
    sorting :: lower_new_block(&f)
    done :: lower_new_block(&f)
    several :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: several, condition: LIRCondition.Gt, left: length, right: one})
    lower_seal(&f, LIRTerminator.Branch{condition: several, then_target: lower_target(sorting, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, sorting, [LIRValueID]{})
    scratch :: lower_list_buffer(&m, &f, length, stride)
    pass :: lower_new_block(&f)
    runs :: lower_new_block(&f)
    run :: lower_new_block(&f)
    run_body :: lower_new_block(&f)
    mid_short :: lower_new_block(&f)
    mid_full :: lower_new_block(&f)
    mid_join :: lower_new_block(&f)
    hi_short :: lower_new_block(&f)
    hi_full :: lower_new_block(&f)
    hi_join :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    merge_body :: lower_new_block(&f)
    left_check :: lower_new_block(&f)
    compare :: lower_new_block(&f)
    take_left :: lower_new_block(&f)
    take_right :: lower_new_block(&f)
    next_pass :: lower_new_block(&f)
    finish :: lower_new_block(&f)
    copy_back :: lower_new_block(&f)
    copy_head :: lower_new_block(&f)
    copy_body :: lower_new_block(&f)
    release :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(pass, [LIRValueID]{one, data, scratch})})
    // pass(width, source, target): merge runs of `width` from source into target.
    width :: lower_word(&f)
    source :: lower_pointer(&f)
    target :: lower_pointer(&f)
    lower_start(&f, pass, [LIRValueID]{width, source, target})
    unsorted :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: unsorted, condition: LIRCondition.Lt, left: width, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: unsorted, then_target: lower_target(runs, [LIRValueID]{}), else_target: lower_target(finish, [LIRValueID]{})})
    lower_start(&f, runs, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(run, [LIRValueID]{zero})})
    // run(lo): the pair of runs starting at `lo`.
    lo :: lower_word(&f)
    lower_start(&f, run, [LIRValueID]{lo})
    remaining :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: remaining, condition: LIRCondition.Lt, left: lo, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: remaining, then_target: lower_target(run_body, [LIRValueID]{}), else_target: lower_target(next_pass, [LIRValueID]{})})
    lower_start(&f, run_body, [LIRValueID]{})
    mid_end :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: mid_end, op: LIRBinaryOp.Add, left: lo, right: width})
    mid_inside :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: mid_inside, condition: LIRCondition.Lt, left: mid_end, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: mid_inside, then_target: lower_target(mid_full, [LIRValueID]{}), else_target: lower_target(mid_short, [LIRValueID]{})})
    lower_start(&f, mid_full, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(mid_join, [LIRValueID]{mid_end})})
    lower_start(&f, mid_short, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(mid_join, [LIRValueID]{length})})
    mid :: lower_word(&f)
    lower_start(&f, mid_join, [LIRValueID]{mid})
    hi_end :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: hi_end, op: LIRBinaryOp.Add, left: mid, right: width})
    hi_inside :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: hi_inside, condition: LIRCondition.Lt, left: hi_end, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: hi_inside, then_target: lower_target(hi_full, [LIRValueID]{}), else_target: lower_target(hi_short, [LIRValueID]{})})
    lower_start(&f, hi_full, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(hi_join, [LIRValueID]{hi_end})})
    lower_start(&f, hi_short, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(hi_join, [LIRValueID]{length})})
    hi :: lower_word(&f)
    lower_start(&f, hi_join, [LIRValueID]{hi})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{lo, mid, lo})})
    // merge(a, b, k): the next element of target[lo..hi) from source[a..mid)
    // or source[b..hi).
    a :: lower_word(&f)
    b :: lower_word(&f)
    k :: lower_word(&f)
    lower_start(&f, merge, [LIRValueID]{a, b, k})
    filling :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: filling, condition: LIRCondition.Lt, left: k, right: hi})
    lower_seal(&f, LIRTerminator.Branch{condition: filling, then_target: lower_target(merge_body, [LIRValueID]{}), else_target: lower_target(run, [LIRValueID]{hi})})
    lower_start(&f, merge_body, [LIRValueID]{})
    left_open :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: left_open, condition: LIRCondition.Lt, left: a, right: mid})
    lower_seal(&f, LIRTerminator.Branch{condition: left_open, then_target: lower_target(left_check, [LIRValueID]{}), else_target: lower_target(take_right, [LIRValueID]{})})
    lower_start(&f, left_check, [LIRValueID]{})
    right_open :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: right_open, condition: LIRCondition.Lt, left: b, right: hi})
    lower_seal(&f, LIRTerminator.Branch{condition: right_open, then_target: lower_target(compare, [LIRValueID]{}), else_target: lower_target(take_left, [LIRValueID]{})})
    lower_start(&f, compare, [LIRValueID]{})
    left_address :: lower_list_address(&f, source, a, stride)
    right_address :: lower_list_address(&f, source, b, stride)
    left :: lower_read_at(p, &f, left_address, 0, elem) ?? panic("list.sort element has no layout")
    right :: lower_read_at(p, &f, right_address, 0, elem) ?? panic("list.sort element has no layout")
    order :: if descending -> lower_map_key_order(p, &m, &f, elem, left, right) else -> lower_map_key_order(p, &m, &f, elem, right, left)
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(take_right, [LIRValueID]{}), else_target: lower_target(take_left, [LIRValueID]{})})
    lower_start(&f, take_left, [LIRValueID]{})
    left_slot :: lower_list_address(&f, target, k, stride)
    left_from :: lower_list_address(&f, source, a, stride)
    lower_list_move(p, &f, left_slot, left_from, elem)
    next_a :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_a, op: LIRBinaryOp.Add, left: a, right: one})
    left_k :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: left_k, op: LIRBinaryOp.Add, left: k, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{next_a, b, left_k})})
    lower_start(&f, take_right, [LIRValueID]{})
    right_slot :: lower_list_address(&f, target, k, stride)
    right_from :: lower_list_address(&f, source, b, stride)
    lower_list_move(p, &f, right_slot, right_from, elem)
    next_b :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_b, op: LIRBinaryOp.Add, left: b, right: one})
    right_k :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: right_k, op: LIRBinaryOp.Add, left: k, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{a, next_b, right_k})})
    lower_start(&f, next_pass, [LIRValueID]{})
    doubled :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: doubled, op: LIRBinaryOp.Mul, left: width, right: two})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(pass, [LIRValueID]{doubled, target, source})})
    // finish: the sorted elements are in `source`; move them home when that
    // is the scratch buffer, then release the scratch buffer.
    lower_start(&f, finish, [LIRValueID]{})
    home :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: home, condition: LIRCondition.Eq, left: source, right: data})
    lower_seal(&f, LIRTerminator.Branch{condition: home, then_target: lower_target(release, [LIRValueID]{}), else_target: lower_target(copy_back, [LIRValueID]{})})
    lower_start(&f, copy_back, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(copy_head, [LIRValueID]{zero})})
    at :: lower_word(&f)
    lower_start(&f, copy_head, [LIRValueID]{at})
    copying :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: copying, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: copying, then_target: lower_target(copy_body, [LIRValueID]{}), else_target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, copy_body, [LIRValueID]{})
    home_slot :: lower_list_address(&f, data, at, stride)
    sorted_from :: lower_list_address(&f, source, at, stride)
    lower_list_move(p, &f, home_slot, sorted_from, elem)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(copy_head, [LIRValueID]{next_at})})
    lower_start(&f, release, [LIRValueID]{})
    lower_list_free_buffer(&m, &f, scratch, length, stride)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// A fresh, dropless LIR value with `value`'s layout (a copy's holder).
fn lower_new_like(f: &LowerFunction, value: LIRValueID) -> LIRValueID Never! {
    layout :: lower_value_layout(f, value)
    lower_new_value(&f, layout, LIRDrop.Trivial, None)
}

// Copies the element of `elem` at `from` into the slot at `to` as an owned
// copy: the clone glue's byte copy, then its member clones.
fn lower_list_clone_element(p: MIRProgram, m: &LowerModule, f: &LowerFunction, from: LIRValueID, to: LIRValueID, elem: MIRType) Never! {
    lower_list_move(p, &f, to, from, elem)
    if lower_needs_drop(p, m, elem) -> lower_glue_clone_fields(p, &m, &f, from, to, [LowerGlueField]{LowerGlueField{offset: 0, ty: elem}})
}

// `xs.slice(start, end)` (Collections.rs jet_list_slice: both bounds clamp
// into 0..len, an empty window when end <= start, the window's elements
// cloned) and `xs.min()` / `xs.max()` (jet_list_min / jet_list_max:
// Iterator::min keeps the first least item, max the last greatest; a `T?`
// box of a copy, None when empty). False when `row` is not one.
fn lower_list_method_window(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, symbol: String, receiver: MIRValueID, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    elem :: lower_list_element(ty) ?? return false
    slice_route :: row.member == "list_slice" && symbol == "jet_list_slice"
    min_route :: row.member == "min" && symbol == "jet_list_min"
    max_route :: row.member == "max" && symbol == "jet_list_max"
    if !slice_route && !min_route && !max_route -> return false
    if args.len() != (if slice_route -> 2 else -> 0) {
        lower_fail(&m, &f, "List {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, elem) == .Absent {
        lower_fail(&m, &f, "List {row.member} over {mir_type_display_name(elem)} is not lowered at O0 yet")
        return true
    }
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    if slice_route {
        result_ty :: lower_checked_type(c, instruction) ?? {
            lower_fail(&m, &f, "List slice without a checked result type is not lowered at O0 yet")
            return true
        }
        start :: lower_list_native_index(c, &m, &f, args[0]) ?? return true
        end :: lower_list_native_index(c, &m, &f, args[1]) ?? return true
        list :: lower_use(&m, &f, receiver) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        length :: lower_list_word(&f, list, 0)
        first :: lower_list_clamp(&f, start, zero, length)
        last :: lower_list_clamp(&f, end, first, length)
        count :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: count, op: LIRBinaryOp.Sub, left: last, right: first})
        window :: lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: window, size: 24, align: 8})
        lower_emit(&f, LIRInst.Store{base: window, offset: 0, value: count})
        lower_emit(&f, LIRInst.Store{base: window, offset: 8, value: zero})
        list_data :: lower_list_data(&f, list)
        window_data :: lower_list_address(&f, list_data, first, stride)
        lower_emit(&f, LIRInst.Store{base: window, offset: 16, value: window_data})
        lower_storage_into(p, &f, dst, result_ty)
        lower_inline_clone(p, &m, &f, window, dst, result_ty)
        return true
    }
    if lower_map_key_kind(p, elem) == "" || lower_is_inline(p, elem) {
        lower_fail(&m, &f, "List {row.member} of {mir_type_display_name(elem)} is not lowered at O0 yet")
        return true
    }
    list :: lower_use(&m, &f, receiver) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    data :: lower_list_data(&f, list)
    none_at :: lower_const(&f, -1)
    each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{none_at})
    best_at :: each.state[0]
    item :: lower_read_at(p, &f, each.address, 0, elem) ?? return true
    chosen_block :: lower_new_block(&f)
    weigh :: lower_new_block(&f)
    join :: lower_new_block(&f)
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Lt, left: best_at, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(chosen_block, [LIRValueID]{}), else_target: lower_target(weigh, [LIRValueID]{})})
    lower_start(&f, weigh, [LIRValueID]{})
    best_address :: lower_list_address(&f, data, best_at, stride)
    best :: lower_read_at(p, &f, best_address, 0, elem) ?? return true
    // min replaces the best only when item < best; max keeps it only then.
    order :: lower_map_key_order(p, &m, &f, elem, item, best)
    if min_route {
        lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(chosen_block, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{best_at})})
    } else {
        lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(join, [LIRValueID]{best_at}), else_target: lower_target(chosen_block, [LIRValueID]{})})
    }
    lower_start(&f, chosen_block, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{each.at})})
    next_at :: lower_word(&f)
    lower_start(&f, join, [LIRValueID]{next_at})
    lower_each_end(&f, each, [LIRValueID]{next_at})
    chosen :: each.exit[0]
    found :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: found, condition: LIRCondition.Ge, left: chosen, right: zero})
    some :: lower_new_block(&f)
    done :: lower_new_block(&f)
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Branch{condition: found, then_target: lower_target(some, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{null})})
    lower_start(&f, some, [LIRValueID]{})
    chosen_address :: lower_list_address(&f, data, chosen, stride)
    value := lower_read_at(p, &f, chosen_address, 0, elem) ?? return true
    if lower_needs_drop(p, m, elem) {
        copied :: lower_new_like(&f, value)
        lower_clone_into(p, &m, &f, value, copied, elem)
        value = copied
    }
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, lower_option_box_size(p, elem))
    lower_write_at(p, &f, boxed, 0, value, elem)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{boxed})})
    lower_start(&f, done, [LIRValueID]{dst})
    true
}

// `value` clamped into `low..=high` (low <= high).
fn lower_list_clamp(f: &LowerFunction, value: LIRValueID, low: LIRValueID, high: LIRValueID) -> LIRValueID Never! {
    below :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: below, condition: LIRCondition.Lt, left: value, right: low})
    above :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: above, condition: LIRCondition.Gt, left: value, right: high})
    check :: lower_new_block(&f)
    within :: lower_new_block(&f)
    join :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: below, then_target: lower_target(join, [LIRValueID]{low}), else_target: lower_target(check, [LIRValueID]{})})
    lower_start(&f, check, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Branch{condition: above, then_target: lower_target(join, [LIRValueID]{high}), else_target: lower_target(within, [LIRValueID]{})})
    lower_start(&f, within, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{value})})
    clamped :: lower_word(&f)
    lower_start(&f, join, [LIRValueID]{clamped})
    clamped
}

// Flatten, removal by value or slot, count and Map.from_keys over a List
// receiver (Collections.rs jet_list_flatten, jet_list_remove_value_kernel,
// jet_list_remove_slot_kernel, jet_list_count_kernel,
// jet_map_from_keys_kernel), as generated LIR. A receiver or operand moved
// into the route is dropped once its elements are copied out. False when
// `row` is not one.
fn lower_list_method_shape(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, symbol: String, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    elem :: lower_list_element(ty) ?? return false
    flatten_route :: row.member == "list_flatten" && symbol == "jet_list_flatten"
    value_route :: row.member == "list_remove_value" && symbol == "jet_list_remove_value"
    slot_route :: row.member == "list_remove_slot" && symbol == "jet_list_remove_slot"
    count_route :: row.member == "list_count" && symbol == "jet_list_count"
    keys_route :: row.member == "map_from_keys" && (symbol == "jet_map_from_keys_kernel" || symbol == "jet_map_from_keys_int" || symbol == "jet_map_from_keys_composite")
    if !flatten_route && !value_route && !slot_route && !count_route && !keys_route -> return false
    if args.len() != (if flatten_route -> 0 else -> 1) {
        lower_fail(&m, &f, "List {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, elem) == .Absent {
        lower_fail(&m, &f, "List {row.member} over {mir_type_display_name(elem)} is not lowered at O0 yet")
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "List {row.member} without a checked result type is not lowered at O0 yet")
        return true
    }
    if value_route || slot_route {
        if lower_option_inner(result_ty) == None {
            lower_fail(&m, &f, "List {row.member} with result {mir_type_display_name(result_ty)} is not lowered at O0 yet")
            return true
        }
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "List") ?? return true
        operand :: (if slot_route -> lower_list_native_index(c, &m, &f, args[0]) else -> lower_use(&m, &f, args[0])) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, if slot_route -> "list.remove_slot" else -> "list.remove_value", ty, [LIRValueID]{list, operand}, Val(dst))
        if value_route && lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, operand, elem)
        return true
    }
    list :: lower_use(&m, &f, receiver) ?? return true
    zero :: lower_const(&f, 0)
    if count_route {
        needle :: lower_use(&m, &f, args[0]) ?? return true
        each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{zero})
        item :: lower_render_load(p, &f, each.address, 0, elem, false)
        same :: lower_equal_values(p, &m, &f, elem, item, Val(needle)) ?? return true
        current :: each.state[0]
        counted :: lower_new_block(&f)
        join :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(counted, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{current})})
        lower_start(&f, counted, [LIRValueID]{})
        one :: lower_const(&f, 1)
        increased :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: increased, op: LIRBinaryOp.Add, left: current, right: one})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{increased})})
        stepped :: lower_word(&f)
        lower_start(&f, join, [LIRValueID]{stepped})
        lower_each_end(&f, each, [LIRValueID]{stepped})
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_native_count(p, c, &m, &f, instruction, dst, each.exit[0])
        return true
    }
    if flatten_route {
        leaf :: lower_list_element(elem) ?? {
            lower_fail(&m, &f, "List flatten of {mir_type_display_name(elem)} is not lowered at O0 yet")
            return true
        }
        if lower_repr(p, leaf) == .Absent {
            lower_fail(&m, &f, "List flatten of {mir_type_display_name(elem)} is not lowered at O0 yet")
            return true
        }
        // One buffer of the summed lengths, filled in order with copies.
        sizes :: lower_each_begin(p, &f, list, elem, [LIRValueID]{zero})
        count :: lower_list_word(&f, sizes.address, 0)
        total :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: total, op: LIRBinaryOp.Add, left: sizes.state[0], right: count})
        lower_each_end(&f, sizes, [LIRValueID]{total})
        length :: sizes.exit[0]
        stride :: lower_list_stride(p, leaf)
        data :: lower_list_buffer(&m, &f, length, stride)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_storage_into(p, &f, dst, result_ty)
        lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: length})
        lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: length})
        lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
        outer :: lower_each_begin(p, &f, list, elem, [LIRValueID]{zero})
        inner :: lower_each_begin(p, &f, outer.address, leaf, [LIRValueID]{outer.state[0]})
        to :: lower_list_address(&f, data, inner.state[0], stride)
        lower_list_clone_element(p, &m, &f, inner.address, to, leaf)
        one :: lower_const(&f, 1)
        written :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: written, op: LIRBinaryOp.Add, left: inner.state[0], right: one})
        lower_each_end(&f, inner, [LIRValueID]{written})
        lower_each_end(&f, outer, [LIRValueID]{inner.exit[0]})
        if lower_value_owned(c, receiver) -> lower_map_drop_value(p, &m, &f, list, ty)
        return true
    }
    // Map.from_keys(keys, default): every key, in List order, set to a copy
    // of the default (a later duplicate key replaces the earlier entry).
    shape :: lower_map_shape(p, result_ty) ?? {
        lower_fail(&m, &f, "Map.from_keys into {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, shape.value) == .Absent {
        lower_fail(&m, &f, "Map.from_keys with a {mir_type_display_name(shape.value)} default is not lowered at O0 yet")
        return true
    }
    fallback :: lower_use(&m, &f, args[0]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, result_ty)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: zero})
    each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, 0, elem) ?? return true
    owned_key :: lower_new_like(&f, key)
    lower_clone_into(p, &m, &f, key, owned_key, elem)
    owned_value :: lower_new_like(&f, fallback)
    lower_clone_into(p, &m, &f, fallback, owned_value, shape.value)
    lower_call_helper(&m, &f, "map.set", result_ty, [LIRValueID]{dst, owned_key, owned_value}, None)
    lower_each_end(&f, each, [LIRValueID]{})
    if lower_value_owned(c, receiver) -> lower_map_drop_value(p, &m, &f, list, ty)
    if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, fallback, shape.value)
    true
}

// `core.builtin.list_concat(left, right)` (Core.rs jet_list_concat: a new
// List of copies of left's elements, then right's). A List moved into the
// call is dropped once its elements are copied out. False when `call` is not it.
fn lower_list_concat(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    if row.module_name != "core.builtin" || row.member != "list_concat" || mir_symbol_name(row.symbol) != "jet_list_concat" -> return false
    unsupported :: "StaticPreludeCall core.builtin.list_concat of this shape is not lowered at O0 yet"
    if args.len() != 2 {
        lower_fail(&m, &f, unsupported)
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, unsupported)
        return true
    }
    elem :: lower_list_element(result_ty) ?? {
        lower_fail(&m, &f, unsupported)
        return true
    }
    if lower_repr(p, elem) == .Absent || lower_repr(p, elem) == .Unsupported(_) {
        lower_fail(&m, &f, unsupported)
        return true
    }
    types := [MIRType]{}
    loop arg in args {
        ty :: lower_value_type(c, arg.value) ?? {
            lower_fail(&m, &f, unsupported)
            return true
        }
        inner :: lower_list_element(ty) ?? {
            lower_fail(&m, &f, unsupported)
            return true
        }
        if mir_type_identity_key(inner) != mir_type_identity_key(elem) {
            lower_fail(&m, &f, unsupported)
            return true
        }
        &types.push(ty)
    }
    left :: lower_use(&m, &f, args[0].value) ?? return true
    right :: lower_use(&m, &f, args[1].value) ?? return true
    stride :: lower_list_stride(p, elem)
    left_length :: lower_list_word(&f, left, 0)
    right_length :: lower_list_word(&f, right, 0)
    length :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: length, op: LIRBinaryOp.Add, left: left_length, right: right_length})
    data :: lower_list_buffer(&m, &f, length, stride)
    // The result is named after the copy loops, in the block they end in, so
    // the release plan can release it (Lower.jet lower_mark_releasable).
    header :: lower_new_storage(p, &f, result_ty)
    lower_emit(&f, LIRInst.Store{base: header, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: header, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: header, offset: 16, value: data})
    zero :: lower_const(&f, 0)
    sources :: [LIRValueID]{left, right}
    written := zero
    loop list in sources {
        each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{written})
        to :: lower_list_address(&f, data, each.state[0], stride)
        lower_list_clone_element(p, &m, &f, each.address, to, elem)
        one :: lower_const(&f, 1)
        next :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next, op: LIRBinaryOp.Add, left: each.state[0], right: one})
        lower_each_end(&f, each, [LIRValueID]{next})
        written = each.exit[0]
    }
    // Only a List the call takes by Move is its to release; a Read-lent local stays its owner's.
    if args[0].access == .Move && lower_value_owned(c, args[0].value) -> lower_map_drop_value(p, &m, &f, left, types[0])
    if args[1].access == .Move && lower_value_owned(c, args[1].value) -> lower_map_drop_value(p, &m, &f, right, types[1])
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_emit(&f, LIRInst.Move{dst: dst, src: header})
    true
}

// `xs.remove(value, .Val)` (jet_list_remove_value_kernel: the first equal
// element, None when there is none) and `xs.remove(at, .Slot)`
// (jet_list_remove_slot_kernel: a position in 0..<len, else the List bounds
// stop): the element moves into an Option box and every later element moves
// down one slot.
fn lower_helper_list_remove(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("{glue.helper} helper has no List type")
    by_slot :: glue.helper == "list.remove_slot"
    operand_layout :: if by_slot -> lir_layout_word() else -> lower_repr_layout(lower_repr(p, elem)) ?? lir_layout_pointer()
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), operand_layout}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    operand :: f.open_params[1].copy()
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_data(&f, list)
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    removal :: lower_new_block(&f)
    if by_slot {
        negative :: lower_flag(&f)
        past :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: operand, right: zero})
        lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Ge, left: operand, right: length})
        invalid :: lower_flag(&f)
        lower_logic(&f, invalid, false, negative, past)
        stop :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(removal, [LIRValueID]{operand})})
        lower_start(&f, stop, [LIRValueID]{})
        lower_call_runtime(&m, &f, "jet_rt_panic_list_bounds", [LIRValueID]{length, operand}, None)
        // The borrowed list and scalar index remain untouched. Its caller's
        // Propagate edge runs before this unwritten Optional is inspected.
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    } else {
        head :: lower_new_block(&f)
        body :: lower_new_block(&f)
        next_block :: lower_new_block(&f)
        absent :: lower_new_block(&f)
        at :: lower_word(&f)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
        lower_start(&f, head, [LIRValueID]{at})
        more :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
        lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(absent, [LIRValueID]{})})
        lower_start(&f, body, [LIRValueID]{})
        address :: lower_list_address(&f, data, at, stride)
        item :: lower_render_load(p, &f, address, 0, elem, false)
        same :: lower_equal_values(p, &m, &f, elem, item, Val(operand)) ?? {
            lower_seal(&f, LIRTerminator.Unreachable)
            return lir_builder_finish(f.builder)
        }
        lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(removal, [LIRValueID]{at}), else_target: lower_target(next_block, [LIRValueID]{})})
        lower_start(&f, next_block, [LIRValueID]{})
        next_at :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
        lower_start(&f, absent, [LIRValueID]{})
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    }
    index :: lower_word(&f)
    lower_start(&f, removal, [LIRValueID]{index})
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, lower_option_box_size(p, elem))
    taken :: lower_list_address(&f, data, index, stride)
    lower_list_move(p, &f, boxed, taken, elem)
    last :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
    shift :: lower_new_block(&f)
    moving :: lower_new_block(&f)
    done :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(shift, [LIRValueID]{index})})
    lower_start(&f, shift, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: last})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(moving, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, moving, [LIRValueID]{})
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    to :: lower_list_address(&f, data, at, stride)
    from :: lower_list_address(&f, data, next_at, stride)
    lower_list_move(p, &f, to, from, elem)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(shift, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: last})
    lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
    lir_builder_finish(f.builder)
}

// D-MEMDISJOINT1: the proof is complete before any mutable descriptor exists.
// Result owns its box (and a selected-view List owns only its descriptor
// buffer); each ViewMut header borrows the original receiver's elements.
fn lower_disjoint_header(f: &LowerFunction, dst: LIRValueID, count: LIRValueID, data: LIRValueID) Never! {
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: count})
    lower_store_word(&f, dst, 8, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
}

fn lower_disjoint_error(m: &LowerModule, f: &LowerFunction, kind: String, index: LIRValueID, length: LIRValueID) -> LIRValueID Never! {
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    if kind == "cardinality" {
        lower_render_static(&m, &f, builder, "edit_disjoint needs exactly two indexes")
    } else {
        number :: lower_render_string(&f)
        lower_call_runtime(&m, &f, "jet_rt_i64_to_string", [LIRValueID]{index}, Val(number))
        lower_render_static(&m, &f, builder, if kind == "duplicate" -> "duplicate index " else if kind == "split" -> "split point " else -> "index ")
        lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, number}, None)
        lower_emit(&f, LIRInst.Drop{value: number})
        if kind == "duplicate" {
            lower_render_static(&m, &f, builder, " overlaps itself")
        } else {
            count :: lower_render_string(&f)
            lower_call_runtime(&m, &f, "jet_rt_i64_to_string", [LIRValueID]{length}, Val(count))
            lower_render_static(&m, &f, builder, if kind == "split" -> " is outside 0..=" else -> " is outside 0..")
            lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, count}, None)
            lower_render_static(&m, &f, builder, " for ")
            lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, count}, None)
            lower_render_static(&m, &f, builder, " items")
            lower_emit(&f, LIRInst.Drop{value: count})
        }
    }
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    text
}

fn lower_disjoint_fail(p: MIRProgram, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, err: MIRType, kind: String, index: LIRValueID, length: LIRValueID) Never! {
    text :: lower_disjoint_error(&m, &f, kind, index, length)
    lower_store_word(&f, dst, 0, lower_result_selector(false))
    lower_write_at(p, &f, dst, lower_result_payload_offset(), text, err)
}

fn lower_disjoint_invalid(f: &LowerFunction, index: LIRValueID, length: LIRValueID, split: Bool) -> LIRValueID Never! {
    zero :: lower_const(&f, 0)
    negative :: lower_flag(&f)
    past :: lower_flag(&f)
    invalid :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: index, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: past, condition: if split -> LIRCondition.Gt else -> LIRCondition.Ge, left: index, right: length})
    lower_logic(&f, invalid, false, negative, past)
    invalid
}

fn lower_disjoint_split(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, receiver_ty: MIRType, receiver_place: MIRPlaceID?, args: [MIRValueID]) Never! {
    if args.len() != 1 -> return lower_fail(&m, &f, "split_write needs one checked split point")
    ty :: lower_checked_type(c, instruction) ?? return
    if ty.kind == .Result(ok, err) {
        fields :: lower_inline_members(p, ok)
        if fields.len() != 2 || lower_view_element(fields[0].ty) == None || lower_view_element(fields[1].ty) == None || err.kind != .String -> return lower_fail(&m, &f, "split_write requires its checked two-view/String result")
        elem :: lower_list_element(receiver_ty) ?? return
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "split_write") ?? return
        at :: lower_list_native_index(c, &m, &f, args[0]) ?? return
        length :: lower_list_word(&f, list, 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        lower_alloc(&m, &f, dst, lower_result_box_size(p, ok, err))
        invalid :: lower_disjoint_invalid(&f, at, length, true)
        failure :: lower_new_block(&f)
        success :: lower_new_block(&f)
        done :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(success, [LIRValueID]{})})
        lower_start(&f, failure, [LIRValueID]{})
        lower_disjoint_fail(p, &m, &f, dst, err, "split", at, length)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, success, [LIRValueID]{})
        lower_store_word(&f, dst, 0, lower_result_selector(true))
        data :: lower_list_data(&f, list)
        left :: lower_address(&f, dst, lower_result_payload_offset() + fields[0].offset)
        right :: lower_address(&f, dst, lower_result_payload_offset() + fields[1].offset)
        remaining :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: length, right: at})
        from :: lower_list_address(&f, data, at, lower_list_stride(p, elem))
        lower_disjoint_header(&f, left, at, data)
        lower_disjoint_header(&f, right, remaining, from)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
    } else { lower_fail(&m, &f, "split_write requires its checked Result") }
}

// The eventual 24-byte descriptor buffer doubles as proof scratch:
// [native index, original position, unused]. Heap sort is allocation-free
// O(n log n); permutation cycles restore input order in O(n), after checking
// adjacent duplicates in sorted order (the Rust error precedence).
fn lower_disjoint_swap(f: &LowerFunction, buffer: LIRValueID, left: LIRValueID, right: LIRValueID) Never! {
    a :: lower_list_address(&f, buffer, left, 24)
    b :: lower_list_address(&f, buffer, right, 24)
    loop offset in ([Int]{0, 8}) {
        x :: lower_list_word(&f, a, offset)
        y :: lower_list_word(&f, b, offset)
        lower_emit(&f, LIRInst.Store{base: a, offset: offset, value: y})
        lower_emit(&f, LIRInst.Store{base: b, offset: offset, value: x})
    }
}

fn lower_disjoint_key(f: &LowerFunction, buffer: LIRValueID, index: LIRValueID) -> LIRValueID Never! {
    row :: lower_list_address(&f, buffer, index, 24)
    lower_list_word(&f, row, 0)
}

fn lower_disjoint_sift(f: &LowerFunction, buffer: LIRValueID, length: LIRValueID, root: LIRValueID) Never! {
    head :: lower_new_block(&f)
    choose :: lower_new_block(&f)
    right_test :: lower_new_block(&f)
    take_right :: lower_new_block(&f)
    selected :: lower_new_block(&f)
    swap :: lower_new_block(&f)
    done :: lower_new_block(&f)
    cursor :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{root})})
    lower_start(&f, head, [LIRValueID]{cursor})
    two :: lower_const(&f, 2)
    one :: lower_const(&f, 1)
    twice :: lower_word(&f)
    child :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: twice, op: LIRBinaryOp.Mul, left: cursor, right: two})
    lower_emit(&f, LIRInst.Binary{dst: child, op: LIRBinaryOp.Add, left: twice, right: one})
    exists :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: exists, condition: LIRCondition.Lt, left: child, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: exists, then_target: lower_target(choose, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, choose, [LIRValueID]{})
    right :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: right, op: LIRBinaryOp.Add, left: child, right: one})
    has_right :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: has_right, condition: LIRCondition.Lt, left: right, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: has_right, then_target: lower_target(right_test, [LIRValueID]{}), else_target: lower_target(selected, [LIRValueID]{child})})
    lower_start(&f, right_test, [LIRValueID]{})
    a :: lower_disjoint_key(&f, buffer, child)
    b :: lower_disjoint_key(&f, buffer, right)
    greater :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: greater, condition: LIRCondition.Gt, left: b, right: a})
    lower_seal(&f, LIRTerminator.Branch{condition: greater, then_target: lower_target(take_right, [LIRValueID]{}), else_target: lower_target(selected, [LIRValueID]{child})})
    lower_start(&f, take_right, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(selected, [LIRValueID]{right})})
    best :: lower_word(&f)
    lower_start(&f, selected, [LIRValueID]{best})
    parent :: lower_disjoint_key(&f, buffer, cursor)
    biggest :: lower_disjoint_key(&f, buffer, best)
    ordered :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: ordered, condition: LIRCondition.Ge, left: parent, right: biggest})
    lower_seal(&f, LIRTerminator.Branch{condition: ordered, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(swap, [LIRValueID]{})})
    lower_start(&f, swap, [LIRValueID]{})
    lower_disjoint_swap(&f, buffer, cursor, best)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{best})})
    lower_start(&f, done, [LIRValueID]{})
}

fn lower_disjoint_sort(f: &LowerFunction, buffer: LIRValueID, length: LIRValueID) Never! {
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    two :: lower_const(&f, 2)
    parents :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: parents, op: LIRBinaryOp.Div, left: length, right: two})
    build :: lower_sort_loop(&f, zero, parents)
    last :: lower_word(&f)
    root :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: parents, right: one})
    lower_emit(&f, LIRInst.Binary{dst: root, op: LIRBinaryOp.Sub, left: last, right: build.at})
    lower_disjoint_sift(&f, buffer, length, root)
    lower_each_end(&f, build, [LIRValueID]{})
    drain :: lower_sort_loop(&f, one, length)
    remaining :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: remaining, op: LIRBinaryOp.Sub, left: length, right: drain.at})
    lower_disjoint_swap(&f, buffer, zero, remaining)
    lower_disjoint_sift(&f, buffer, remaining, zero)
    lower_each_end(&f, drain, [LIRValueID]{})
}

fn lower_disjoint_get(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, receiver_ty: MIRType, receiver_place: MIRPlaceID?, args: [MIRValueID]) Never! {
    if args.len() != 1 -> return lower_fail(&m, &f, "get_disjoint_write needs one checked index list")
    ty :: lower_checked_type(c, instruction) ?? return
    if ty.kind == .Result(ok, err) {
        view :: lower_list_element(ok) ?? return lower_fail(&m, &f, "get_disjoint_write result must be a view List")
        elem :: lower_view_element(view) ?? return lower_fail(&m, &f, "get_disjoint_write result must contain checked views")
        if err.kind != .String -> return lower_fail(&m, &f, "get_disjoint_write error must be String")
        indices_ty :: lower_value_type(c, args[0]) ?? return
        index_ty :: lower_list_element(indices_ty) ?? return
        indices :: lower_use(&m, &f, args[0]) ?? return
        list :: lower_receiver_header(p, c, &m, &f, receiver_place, "get_disjoint_write") ?? return
        length :: lower_list_word(&f, list, 0)
        count :: lower_list_word(&f, indices, 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        lower_alloc(&m, &f, dst, lower_result_box_size(p, ok, err))
        buffer :: lower_list_buffer(&m, &f, count, 24)
        zero :: lower_const(&f, 0)
        one :: lower_const(&f, 1)
        done :: lower_new_block(&f)
        scan :: lower_each_begin(p, &f, indices, index_ty, [LIRValueID]{})
        offered :: lower_read_at(p, &f, scan.address, 0, index_ty) ?? return
        at := offered
        if lower_is_exact_int(index_ty) {
            at = lower_word(&f)
            lower_convert_exact(&m, &f, at, offered, "jet_int_owned_to_i64", false)
        }
        invalid :: lower_disjoint_invalid(&f, at, length, false)
        failure :: lower_new_block(&f)
        valid :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: invalid, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
        lower_start(&f, failure, [LIRValueID]{})
        lower_list_free_buffer(&m, &f, buffer, count, 24)
        lower_disjoint_fail(p, &m, &f, dst, err, "index", at, length)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, valid, [LIRValueID]{})
        row :: lower_list_address(&f, buffer, scan.at, 24)
        lower_emit(&f, LIRInst.Store{base: row, offset: 0, value: at})
        lower_emit(&f, LIRInst.Store{base: row, offset: 8, value: scan.at})
        lower_each_end(&f, scan, [LIRValueID]{})
        lower_disjoint_sort(&f, buffer, count)
        pairs :: lower_sort_loop(&f, one, count)
        before :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: before, op: LIRBinaryOp.Sub, left: pairs.at, right: one})
        previous :: lower_disjoint_key(&f, buffer, before)
        current :: lower_disjoint_key(&f, buffer, pairs.at)
        duplicate :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: duplicate, condition: LIRCondition.Eq, left: previous, right: current})
        overlap :: lower_new_block(&f)
        distinct :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: duplicate, then_target: lower_target(overlap, [LIRValueID]{}), else_target: lower_target(distinct, [LIRValueID]{})})
        lower_start(&f, overlap, [LIRValueID]{})
        lower_list_free_buffer(&m, &f, buffer, count, 24)
        lower_disjoint_fail(p, &m, &f, dst, err, "duplicate", current, length)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, distinct, [LIRValueID]{})
        lower_each_end(&f, pairs, [LIRValueID]{})
        restore :: lower_sort_loop(&f, zero, count)
        head :: lower_new_block(&f)
        cycle :: lower_new_block(&f)
        restored :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{})})
        lower_start(&f, head, [LIRValueID]{})
        from :: lower_list_address(&f, buffer, restore.at, 24)
        position :: lower_list_word(&f, from, 8)
        placed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: placed, condition: LIRCondition.Eq, left: position, right: restore.at})
        lower_seal(&f, LIRTerminator.Branch{condition: placed, then_target: lower_target(restored, [LIRValueID]{}), else_target: lower_target(cycle, [LIRValueID]{})})
        lower_start(&f, cycle, [LIRValueID]{})
        lower_disjoint_swap(&f, buffer, restore.at, position)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{})})
        lower_start(&f, restored, [LIRValueID]{})
        lower_each_end(&f, restore, [LIRValueID]{})
        data :: lower_list_data(&f, list)
        construct :: lower_sort_loop(&f, zero, count)
        window :: lower_list_address(&f, buffer, construct.at, 24)
        selected :: lower_list_word(&f, window, 0)
        address :: lower_list_address(&f, data, selected, lower_list_stride(p, elem))
        lower_disjoint_header(&f, window, one, address)
        lower_each_end(&f, construct, [LIRValueID]{})
        lower_store_word(&f, dst, 0, lower_result_selector(true))
        output :: lower_address(&f, dst, lower_result_payload_offset())
        lower_emit(&f, LIRInst.Store{base: output, offset: 0, value: count})
        lower_emit(&f, LIRInst.Store{base: output, offset: 8, value: count})
        lower_emit(&f, LIRInst.Store{base: output, offset: 16, value: buffer})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
    } else { lower_fail(&m, &f, "get_disjoint_write requires its checked Result") }
}

// Reverse relocates owners in place. Inline elements are padded words; packed
// scalars use their actual storage width. Neither case allocates or clones.
fn lower_helper_list_reverse(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.reverse helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    if lower_repr(p, elem) != .Absent {
        list :: f.open_params[0].copy()
        length :: lower_list_word(&f, list, 0)
        data :: lower_list_data(&f, list)
        one :: lower_const(&f, 1)
        half :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: half, op: .Shr, left: length, right: one})
        last :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: last, op: .Sub, left: length, right: one})
        stride :: lower_list_stride(p, elem)
        each :: lower_record_loop_start(&f, half)
        other :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: other, op: .Sub, left: last, right: each.index})
        left :: lower_list_address(&f, data, each.index, stride)
        right :: lower_list_address(&f, data, other, stride)
        if lower_is_inline(p, elem) {
            loop word in 0..<(stride /% 8) {
                offset :: word * 8
                a :: lower_list_word(&f, left, offset)
                b :: lower_list_word(&f, right, offset)
                lower_emit(&f, LIRInst.Store{base: left, offset: offset, value: b})
                lower_emit(&f, LIRInst.Store{base: right, offset: offset, value: a})
            }
        } else {
            a :: lower_read_at(p, &f, left, 0, elem) ?? panic("list.reverse element has no storage")
            b :: lower_read_at(p, &f, right, 0, elem) ?? panic("list.reverse element has no storage")
            lower_write_at(p, &f, left, 0, b, elem)
            lower_write_at(p, &f, right, 0, a, elem)
        }
        lower_record_loop_end(&f, each)
    }
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_list_move_buffer(p: MIRProgram, f: &LowerFunction, to: LIRValueID, from: LIRValueID, count: LIRValueID, elem: MIRType) Never! {
    if lower_repr(p, elem) == .Absent -> return
    stride :: lower_list_stride(p, elem)
    each :: lower_record_loop_start(&f, count)
    source :: lower_list_address(&f, from, each.index, stride)
    destination :: lower_list_address(&f, to, each.index, stride)
    lower_list_move(p, &f, destination, source, elem)
    lower_record_loop_end(&f, each)
}

// Geometric growth bounded before multiplication, with the requested capacity
// as the lower bound. This is shared by fatal extend and fallible reserve.
fn lower_list_growth_capacity(f: &LowerFunction, cap: LIRValueID, required: LIRValueID, limit: Int) -> LIRValueID Never! {
    threshold :: lower_const(&f, limit /% 2)
    large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: large, condition: .Gt, left: cap, right: threshold})
    exact :: lower_new_block(&f)
    grow :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: large, then_target: lower_target(exact, [LIRValueID]{}), else_target: lower_target(grow, [LIRValueID]{})})
    lower_start(&f, exact, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{required})})
    lower_start(&f, grow, [LIRValueID]{})
    two :: lower_const(&f, 2)
    doubled :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: doubled, op: .Mul, left: cap, right: two})
    insufficient :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: insufficient, condition: .Lt, left: doubled, right: required})
    enough :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: insufficient, then_target: lower_target(exact, [LIRValueID]{}), else_target: lower_target(enough, [LIRValueID]{})})
    lower_start(&f, enough, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{doubled})})
    result :: lower_word(&f)
    lower_start(&f, done, [LIRValueID]{result})
    result
}

fn lower_helper_list_extend(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.extend helper has no List type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    list :: f.open_params[0].copy()
    source :: f.open_params[1].copy()
    length :: lower_list_word(&f, list, 0)
    cap :: lower_list_word(&f, list, 8)
    data :: lower_list_data(&f, list)
    added :: lower_list_word(&f, source, 0)
    source_cap :: lower_list_word(&f, source, 8)
    source_data :: lower_list_data(&f, source)
    stride :: lower_list_stride(p, elem)
    zero :: lower_const(&f, 0)
    empty_source :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty_source, condition: .Eq, left: added, right: zero})
    retire :: lower_new_block(&f)
    append :: lower_new_block(&f)
    consumed :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty_source, then_target: lower_target(retire, [LIRValueID]{}), else_target: lower_target(append, [LIRValueID]{})})
    lower_start(&f, append, [LIRValueID]{})
    empty_length :: lower_flag(&f)
    empty_cap :: lower_flag(&f)
    adopt :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty_length, condition: .Eq, left: length, right: zero})
    lower_emit(&f, LIRInst.Compare{dst: empty_cap, condition: .Eq, left: cap, right: zero})
    lower_logic(&f, adopt, true, empty_length, empty_cap)
    take_buffer :: lower_new_block(&f)
    combine :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: adopt, then_target: lower_target(take_buffer, [LIRValueID]{}), else_target: lower_target(combine, [LIRValueID]{})})
    lower_start(&f, take_buffer, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: added})
    lower_emit(&f, LIRInst.Store{base: list, offset: 8, value: source_cap})
    lower_emit(&f, LIRInst.Store{base: list, offset: 16, value: source_data})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(consumed, [LIRValueID]{})})
    lower_start(&f, combine, [LIRValueID]{})
    limit :: 9223372036854775800 /% stride
    maximum :: lower_const(&f, limit)
    available :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: available, op: .Sub, left: maximum, right: length})
    overflow :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: overflow, condition: .Gt, left: added, right: available})
    lower_check(&m, &f, overflow, "jet_rt_panic_overflow")
    required :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: required, op: .Add, left: length, right: added})
    grow :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: grow, condition: .Gt, left: required, right: cap})
    allocate :: lower_new_block(&f)
    fill :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: grow, then_target: lower_target(allocate, [LIRValueID]{}), else_target: lower_target(fill, [LIRValueID]{data})})
    lower_start(&f, allocate, [LIRValueID]{})
    new_cap :: lower_list_growth_capacity(&f, cap, required, limit)
    new_data :: lower_list_buffer(&m, &f, new_cap, stride)
    lower_list_move_buffer(p, &f, new_data, data, length, elem)
    lower_list_free_buffer(&m, &f, data, cap, stride)
    lower_emit(&f, LIRInst.Store{base: list, offset: 8, value: new_cap})
    lower_emit(&f, LIRInst.Store{base: list, offset: 16, value: new_data})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(fill, [LIRValueID]{new_data})})
    target_data :: lower_pointer(&f)
    lower_start(&f, fill, [LIRValueID]{target_data})
    target :: lower_list_address(&f, target_data, length, stride)
    lower_list_move_buffer(p, &f, target, source_data, added, elem)
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: required})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(retire, [LIRValueID]{})})
    lower_start(&f, retire, [LIRValueID]{})
    // Only the source buffer is retired: all elements have moved, not cloned.
    lower_list_free_buffer(&m, &f, source_data, source_cap, stride)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(consumed, [LIRValueID]{})})
    lower_start(&f, consumed, [LIRValueID]{})
    loop offset in ([Int]{0, 8, 16}) -> lower_emit(&f, LIRInst.Store{base: source, offset: offset, value: zero})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// D-ALLOCFAIL1: negative sizes fail without consuming the fault rail; every
// nonnegative reservation consults it exactly once, even when capacity suffices.
// Allocation failure leaves the existing buffer and all its owners untouched.
fn lower_helper_list_try_reserve(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    fields :: if glue.ty.kind == .Tuple(rows) -> rows else -> panic("list.try_reserve helper key")
    elem :: lower_list_element(fields[0].ty) ?? panic("list.try_reserve helper List")
    result_ty :: fields[1].ty
    ok_ty :: if result_ty.kind == .Result(ok, _) -> ok else -> panic("list.try_reserve checked Result")
    err_ty :: if result_ty.kind == .Result(_, err) -> err else -> panic("list.try_reserve checked Result")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word()}, Val(lir_layout_pointer()))
    list :: f.open_params[0].copy()
    additional :: f.open_params[1].copy()
    result :: lower_pointer(&f)
    lower_alloc(&m, &f, result, lower_result_box_size(p, ok_ty, err_ty))
    zero :: lower_const(&f, 0)
    maximum :: lower_const(&f, 9223372036854775807)
    failed :: lower_new_block(&f)
    nonnegative :: lower_new_block(&f)
    normalized :: lower_new_block(&f)
    negative :: lower_flag(&f)
    lower_exact_compare(&m, &f, negative, .Lt, additional, zero)
    lower_seal(&f, LIRTerminator.Branch{condition: negative, then_target: lower_target(failed, [LIRValueID]{zero}), else_target: lower_target(nonnegative, [LIRValueID]{})})
    lower_start(&f, nonnegative, [LIRValueID]{})
    inline_capacity :: lower_inline_test(&f, [LIRValueID]{additional})
    large :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: inline_capacity, then_target: lower_target(normalized, [LIRValueID]{additional}), else_target: lower_target(large, [LIRValueID]{})})
    lower_start(&f, large, [LIRValueID]{})
    exact_maximum :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    lower_exact_int_constant(&m, &f, exact_maximum, 9223372036854775807)
    above :: lower_flag(&f)
    lower_exact_compare(&m, &f, above, .Gt, additional, exact_maximum)
    lower_emit(&f, LIRInst.Drop{value: exact_maximum})
    clamped :: lower_new_block(&f)
    fitting :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: above, then_target: lower_target(clamped, [LIRValueID]{}), else_target: lower_target(fitting, [LIRValueID]{})})
    lower_start(&f, clamped, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(normalized, [LIRValueID]{maximum})})
    lower_start(&f, fitting, [LIRValueID]{})
    native :: lower_word(&f)
    lower_convert_exact(&m, &f, native, additional, "jet_int_owned_to_i64", false)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(normalized, [LIRValueID]{native})})
    amount :: lower_word(&f)
    lower_start(&f, normalized, [LIRValueID]{amount})
    unit_element :: lower_repr(p, elem) == .Absent
    stride :: if unit_element -> 1 else -> lower_list_stride(p, elem)
    stride_value :: lower_const(&f, stride)
    requested_limit :: lower_const(&f, 9223372036854775807 /% stride)
    saturated :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: saturated, condition: .Gt, left: amount, right: requested_limit})
    saturated_bytes :: lower_new_block(&f)
    product :: lower_new_block(&f)
    request_ready :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: saturated, then_target: lower_target(saturated_bytes, [LIRValueID]{}), else_target: lower_target(product, [LIRValueID]{})})
    lower_start(&f, saturated_bytes, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(request_ready, [LIRValueID]{maximum})})
    lower_start(&f, product, [LIRValueID]{})
    bytes :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: .Mul, left: amount, right: stride_value})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(request_ready, [LIRValueID]{bytes})})
    requested :: lower_word(&f)
    lower_start(&f, request_ready, [LIRValueID]{requested})
    length :: lower_list_word(&f, list, 0)
    cap :: lower_list_word(&f, list, 8)
    data :: lower_list_data(&f, list)
    limit :: if unit_element -> 9223372036854775807 else -> 9223372036854775800 /% stride
    maximum_capacity :: lower_const(&f, limit)
    available :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: available, op: .Sub, left: maximum_capacity, right: length})
    overflow :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: overflow, condition: .Gt, left: amount, right: available})
    impossible :: lower_new_block(&f)
    valid :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: overflow, then_target: lower_target(impossible, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
    lower_start(&f, impossible, [LIRValueID]{})
    ignored_fault :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_fault_should_fail_allocation", [LIRValueID]{}, Val(ignored_fault))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(failed, [LIRValueID]{requested})})
    lower_start(&f, valid, [LIRValueID]{})
    required :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: required, op: .Add, left: length, right: amount})
    grow :: lower_flag(&f)
    if unit_element -> lower_emit(&f, LIRInst.Const{dst: grow, value: 0})
    else -> lower_emit(&f, LIRInst.Compare{dst: grow, condition: .Gt, left: required, right: cap})
    allocate :: lower_new_block(&f)
    enough :: lower_new_block(&f)
    success :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: grow, then_target: lower_target(allocate, [LIRValueID]{}), else_target: lower_target(enough, [LIRValueID]{})})
    lower_start(&f, enough, [LIRValueID]{})
    fault :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_fault_should_fail_allocation", [LIRValueID]{}, Val(fault))
    lower_seal(&f, LIRTerminator.Branch{condition: fault, then_target: lower_target(failed, [LIRValueID]{requested}), else_target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, allocate, [LIRValueID]{})
    new_cap :: lower_list_growth_capacity(&f, cap, required, limit)
    allocation_bytes :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: allocation_bytes, op: .Mul, left: new_cap, right: stride_value})
    align :: lower_const(&f, 8)
    new_data :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_alloc_try", [LIRValueID]{allocation_bytes, align}, Val(new_data))
    nil :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: nil, value: 0})
    no_memory :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: no_memory, condition: .Eq, left: new_data, right: nil})
    move :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: no_memory, then_target: lower_target(failed, [LIRValueID]{requested}), else_target: lower_target(move, [LIRValueID]{})})
    lower_start(&f, move, [LIRValueID]{})
    lower_list_move_buffer(p, &f, new_data, data, length, elem)
    lower_list_free_buffer(&m, &f, data, cap, stride)
    lower_emit(&f, LIRInst.Store{base: list, offset: 8, value: new_cap})
    lower_emit(&f, LIRInst.Store{base: list, offset: 16, value: new_data})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
    lower_store_word(&f, result, 0, lower_result_selector(true))
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    error_bytes :: lower_word(&f)
    lower_start(&f, failed, [LIRValueID]{error_bytes})
    exact_requested :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    lower_convert_exact(&m, &f, exact_requested, error_bytes, "jet_int_owned_from_i64", false)
    allocator :: lower_render_string(&f)
    allocator_text :: lower_static_text(&m, &f, "List")
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", allocator_text, Val(allocator))
    error_handle :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_alloc_error"}, None)
    lower_call_runtime(&m, &f, "jet_rt_record_new_alloc_error", [LIRValueID]{exact_requested, allocator}, Val(error_handle))
    lower_emit(&f, LIRInst.Drop{value: exact_requested})
    lower_emit(&f, LIRInst.Drop{value: allocator})
    error :: lower_pointer(&f)
    lower_record_from_runtime(p, &m, &f, err_ty, error_handle, Val(error))
    lower_store_word(&f, result, 0, lower_result_selector(false))
    lower_write_at(p, &f, result, lower_result_payload_offset(), error, err_ty)
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}
