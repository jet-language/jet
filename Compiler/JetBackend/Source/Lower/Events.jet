// Synchronous typed events (D-EVENT1=D) over the Jet runtime's Events.jet
// provider: an Event<T> is its EventCore handle, Subscription, EventScope and
// EventTrace are its other handles (RuntimeRoutes.jet rows), EventPolicy is
// EncodingABI's enum box. Every method arrives as a checked ClosureMethod row
// of `core.event` (JetCodegen HandleMethods.jet jet_codegen_handle_event_route).
// A handler is the moved closure box the provider retains; it is invoked through
// the typed `lazy.callback` adapter with the emitted payload's slot lent for the
// call (the handler reads its payload), and released once by `lazy.callback.drop`.
use jet_foundation.[MIRCallArg, MIRInstruction, MIRPreludeCall, MIRProgram, MIRType, MIRValueID, mir_nominal_ref, mir_symbol_name]

// The compiler-known `Event<T>` (no source declaration of that name).
fn lower_event_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> name.id == mir_nominal_ref("Event").id && args.len() == 1
        .Tagged(_, inner) -> lower_event_type(inner)
        else -> false
    }
}

fn lower_event_repr(p: MIRProgram, ty: MIRType) -> LowerRepr? {
    if !lower_event_type(ty) || lower_type_def_exists(p, ty) -> return None
    Val(LowerRepr.Handle{drop: "jet_rt_handle_drop_jet_event", clone: "jet_rt_handle_clone_jet_event"})
}

// `core.event.__event_with_policy<T>(policy)` (Core/event/event.jet with_policy):
// the provider borrows the policy ordinal; the consumed policy is released here.
fn lower_event_constructor(row: MIRPreludeCall) -> Bool Never! {
    mir_symbol_name(row.symbol) == "jet_std::JetEvent::with_policy"
}

fn lower_event_with_policy(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, args: [MIRValueID]) -> Bool Never! {
    if !lower_event_constructor(row) -> return false
    if args.len() != 1 {
        lower_fail(&m, &f, "Event.with_policy must pass exactly its checked policy")
        return true
    }
    policy_ty :: lower_value_type(c, args[0]) ?? {
        lower_fail(&m, &f, "Event.with_policy policy has no checked type")
        return true
    }
    if lower_route_carrier_of(p, policy_ty) != .Val(LowerRouteCarrier.Handle{name: "JetEventPolicy"}) {
        lower_fail(&m, &f, "Event.with_policy policy does not cross as the runtime EventPolicy handle")
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Event.with_policy result has no checked type")
        return true
    }
    if lower_event_repr(p, result_ty) == None {
        lower_fail(&m, &f, "Event.with_policy result is not the compiler-known Event<T>")
        return true
    }
    policy :: lower_use(&m, &f, args[0]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_jet_event"}, None)
    lower_call_runtime(&m, &f, "jet_event_with_policy", [LIRValueID]{policy}, Val(dst))
    if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, policy, policy_ty)
    if instruction.result == None -> lower_emit(&f, LIRInst.Drop{value: dst})
    true
}

// Every `core.event` ClosureMethod row the synchronous provider implements.
fn lower_event_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg], row: MIRPreludeCall) -> Bool Never! {
    if row.module_name != "core.event" -> return false
    symbol :: mir_symbol_name(row.symbol)
    if symbol == {
        "jet_std::JetEvent::on" -> lower_event_listen(p, c, &m, &f, instruction, receiver, args, false, false)
        "jet_std::JetEvent::once" -> lower_event_listen(p, c, &m, &f, instruction, receiver, args, false, true)
        "jet_std::JetEvent::on_priority" -> lower_event_listen(p, c, &m, &f, instruction, receiver, args, true, false)
        "jet_std::JetEvent::emit" -> lower_event_emit(p, c, &m, &f, instruction, receiver, args)
        "jet_std::JetEvent::listener_count" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_listener_count")
        "jet_std::JetEvent::trace" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_trace")
        "jet_std::JetEventScope::cancel" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_scope_cancel")
        "jet_std::JetEventScope::active_count" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_scope_active_count")
        "jet_std::JetSubscription::unsubscribe" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_subscription_unsubscribe")
        "jet_std::JetSubscription::active" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_subscription_active")
        "jet_std::JetEventTrace::summary" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_trace_summary")
        "jet_std::JetEventTrace::delivered" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_trace_delivered")
        "jet_std::JetEventTrace::queued" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_trace_queued")
        "jet_std::JetEventTrace::dropped" -> lower_event_query(p, c, &m, &f, instruction, receiver, args, "jet_event_trace_dropped")
        else -> return false
    }
    true
}

// A receiver-only method: Unit, an owned exact Int, a Bool or an owned String.
fn lower_event_query(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg], export: String) Never! {
    if args.len() != 0 -> return lower_fail(&m, &f, "{export} takes only its checked receiver")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "{export} result has no checked type")
    handle :: lower_use(&m, &f, receiver) ?? return
    repr :: lower_repr(p, result_ty)
    layout :: lower_repr_layout(repr) ?? {
        lower_call_runtime(&m, &f, export, [LIRValueID]{handle}, None)
        return lower_alias_absent(&f, instruction)
    }
    if lower_result(p, c, &m, &f, instruction) == .Val(dst) -> return lower_call_runtime(&m, &f, export, [LIRValueID]{handle}, Val(dst))
    drop :: if repr == {
        .ExactInt -> LIRDrop.Runtime{symbol: "jet_rt_int_drop"}
        .Handle(symbol, _) -> LIRDrop.Runtime{symbol: symbol}
        else -> LIRDrop.Trivial
    }
    discarded :: lower_new_value(&f, layout, drop, None)
    lower_call_runtime(&m, &f, export, [LIRValueID]{handle}, Val(discarded))
    lower_emit(&f, LIRInst.Drop{value: discarded})
}

// on / once / on_priority: [scope, (priority,) handler]. The provider takes the
// moved closure box; a borrowed handler is cloned for it first.
fn lower_event_listen(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg], prioritized: Bool, once: Bool) Never! {
    if args.len() != (if prioritized -> 3 else -> 2) -> return lower_fail(&m, &f, "Event listener registration has inconsistent checked operands")
    closure_arg :: args[args.len() - 1]
    closure_ty :: lower_value_type(c, closure_arg.value) ?? return lower_fail(&m, &f, "Event handler has no checked type")
    if closure_ty.kind == {
        .Fn(signature) -> {
            if signature.params.len() != 1 -> return lower_fail(&m, &f, "Event handler must take exactly its payload")
            if signature.ret == .Val(ret) {
                if lower_repr(p, ret) != .Absent -> return lower_fail(&m, &f, "Event handler must return Unit")
            }
        }
        else -> return lower_fail(&m, &f, "Event handler is not a checked closure")
    }
    event :: lower_use(&m, &f, receiver) ?? return
    scope :: lower_use(&m, &f, args[0].value) ?? return
    priority := lower_const(&f, 0)
    if prioritized {
        value :: lower_use(&m, &f, args[1].value) ?? return
        priority_ty :: lower_value_type(c, args[1].value) ?? return lower_fail(&m, &f, "Event priority has no checked type")
        priority = value
        if lower_is_exact_int(priority_ty) {
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, value, "jet_int_owned_to_i64", false)
            priority = native
        }
    }
    closure := lower_use(&m, &f, closure_arg.value) ?? return
    if closure_arg.access != .Move {
        held :: lower_pointer(&f)
        lower_clone_into(p, &m, &f, closure, held, closure_ty)
        closure = held
    }
    invoke :: lower_lazy_helper_address(&m, &f, "lazy.callback", closure_ty)
    release :: lower_lazy_helper_address(&m, &f, "lazy.callback.drop", closure_ty)
    once_word :: lower_const(&f, if once -> 1 else -> 0)
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_jet_subscription"}, None)
    lower_call_runtime(&m, &f, "jet_event_listen", [LIRValueID]{event, scope, priority, once_word, closure, invoke, release}, Val(dst))
    if instruction.result == None -> lower_emit(&f, LIRInst.Drop{value: dst})
}

// emit(payload): the payload's native slot is lent to every handler; a
// consumed owned payload is released after the dispatch (Rust drops it there).
// A handler's stop leaves the trace null (its drop glue ignores null).
fn lower_event_emit(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg]) Never! {
    if args.len() != 1 -> return lower_fail(&m, &f, "Event.emit must pass exactly its checked payload")
    payload_ty :: lower_value_type(c, args[0].value) ?? return lower_fail(&m, &f, "Event.emit payload has no checked type")
    event :: lower_use(&m, &f, receiver) ?? return
    slot := lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: slot, value: 0})
    payload := LIRValueID?{None}
    if lower_repr_layout(lower_repr(p, payload_ty)) != None {
        value :: lower_use(&m, &f, args[0].value) ?? return
        slot = lower_lazy_value_slot(p, &m, &f, value, payload_ty)
        payload = Val(value)
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_jet_event_trace"}, None)
    lower_call_runtime(&m, &f, "jet_event_emit", [LIRValueID]{event, slot}, Val(dst))
    if payload == .Val(value) {
        if args[0].access == .Move && lower_value_owned(c, args[0].value) -> lower_map_drop_value(p, &m, &f, value, payload_ty)
    }
    if instruction.result == None -> lower_emit(&f, LIRInst.Drop{value: dst})
}

// A `core.event` method only reads its receiver and Read operands: the
// provider keeps its own counts, and every result is a fresh owner.
fn lower_event_reads_operand(row: MIRPreludeCall, receiver: MIRValueID, args: [MIRCallArg], value: MIRValueID) -> Bool Never! {
    if row.module_name != "core.event" -> return false
    if receiver == value -> return true
    loop arg in args {
        if arg.value == value -> return arg.access == .Read && arg.place == None
    }
    false
}
