// `#Transact(name) { ... }` handles. MIR opens the
// handle with Global "transaction", registers hooks through the
// core.transaction on_commit/on_rollback closure calls, marks a clean end with
// the HandleMethod commit, and drops the handle at the scope's end or on an
// early exit (after its auto-snapshots are restored as plain MIR).
// Prelude/Core/RuntimeControl.rs JetTransaction's Drop runs the commit hooks
// LIFO when committed, else the rollback hooks LIFO; the other stack is
// dropped un-run. Natively a Transaction is a box of three words:
// [committed, commit hook list, rollback hook list], each list a chain of
// 16-byte nodes [closure box, next] with the newest first, so a walk from the
// head is LIFO. A hook is a `() -> Unit` closure box (Closures.jet), called
// with the box and released through its reference count, without its type.
use jet_foundation.[MIRBlockID, MIRCallArg, MIRCoreClosureKind, MIRFunction, MIRInstruction, MIRLocal, MIRPreludeCall, MIRPreludeCallID, MIRProgram, MIRScope, MIRType, MIRValueID, mir_nominal_ref, mir_type_display_name, mir_type_identity_key]

fn lower_is_transaction(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, args) -> return args.len() == 0 && name.name == "Transaction"
    false
}

fn lower_transaction_size() -> Int Never! { 24 }

// Global "transaction" (jet_transaction()): a new uncommitted handle.
fn lower_transaction_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "global constant transaction has no checked type")
    if !lower_is_transaction(ty) -> return lower_fail(&m, &f, "global constant transaction of type {mir_type_display_name(ty)} is not lowered at O0 yet")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, lower_transaction_size())
    lower_store_word(&f, dst, 0, 0)
    lower_store_word(&f, dst, 8, 0)
    lower_store_word(&f, dst, 16, 0)
}

// `name.on_commit(f)` / `name.on_rollback(f)`: the owned callback box goes on
// the front of its list.
fn lower_transaction_hook(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, kind: MIRCoreClosureKind, values: [MIRValueID], closure: MIRValueID?) Never! {
    member :: if kind == .OnCommit -> "on_commit" else -> "on_rollback"
    row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "transaction {member} names missing Prelude call {call.value}")
    if lower_runtime_symbol(row) != "jet_transaction_{member}" || values.len() != 1 -> return lower_fail(&m, &f, "transaction {member} of this shape is not lowered at O0 yet")
    handle_ty :: lower_value_type(c, values[0]) ?? return lower_fail(&m, &f, "transaction {member} handle has no checked type")
    if !lower_is_transaction(handle_ty) -> return lower_fail(&m, &f, "transaction {member} on {mir_type_display_name(handle_ty)} is not lowered at O0 yet")
    body :: closure ?? return lower_fail(&m, &f, "transaction {member} without a callback is not lowered at O0 yet")
    closure_ty :: lower_value_type(c, body) ?? return lower_fail(&m, &f, "transaction {member} callback has no checked type")
    result :: lower_task_body_result(closure_ty) ?? return lower_fail(&m, &f, "transaction {member} callback {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
    if lower_repr(p, result) != .Absent -> return lower_fail(&m, &f, "transaction {member} callback {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
    handle :: lower_use(&m, &f, values[0]) ?? return
    env :: lower_task_owned_closure(p, c, &m, &f, body, closure_ty) ?? return
    offset :: if kind == .OnCommit -> 8 else -> 16
    node :: lower_pointer(&f)
    lower_alloc(&m, &f, node, 16)
    lower_emit(&f, LIRInst.Store{base: node, offset: 0, value: env})
    head :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: head, base: handle, offset: offset})
    lower_emit(&f, LIRInst.Store{base: node, offset: 8, value: head})
    lower_emit(&f, LIRInst.Store{base: handle, offset: offset, value: node})
    lower_alias_absent(&f, instruction)
}

// HandleMethod core.transaction.commit: the block ended cleanly.
fn lower_transaction_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, args: [MIRValueID]) -> Bool Never! {
    ty :: lower_value_type(c, receiver) ?? return false
    if !lower_is_transaction(ty) -> return false
    row :: lower_prelude_row(p, m, call) ?? return false
    if lower_runtime_symbol(row) != "jet_transaction_commit" || args.len() != 0 {
        lower_fail(&m, &f, "Transaction method {row.member} is not lowered at O0 yet")
        return true
    }
    handle :: lower_use(&m, &f, receiver) ?? return true
    lower_store_word(&f, handle, 0, 1)
    lower_alias_absent(&f, instruction)
    true
}

// Walk the hook list at `head`: each node's callback runs (when `run`) and is
// released, then the node is freed.
fn lower_transaction_walk(m: &LowerModule, f: &LowerFunction, head: LIRValueID, run: Bool) Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    loop_head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    node :: lower_pointer(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(loop_head, [LIRValueID]{head})})
    lower_start(&f, loop_head, [LIRValueID]{node})
    end :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: end, condition: LIRCondition.Eq, left: node, right: null})
    lower_seal(&f, LIRTerminator.Branch{condition: end, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    boxed :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: boxed, base: node, offset: 0})
    following :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: following, base: node, offset: 8})
    if run {
        code :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: code, base: boxed, offset: 8})
        lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Value{value: code}, args: [LIRValueID]{boxed}})
    }
    lower_closure_box_unref(&m, &f, boxed)
    lower_free_shell(&m, &f, node, 16)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(loop_head, [LIRValueID]{following})})
    lower_start(&f, done, [LIRValueID]{})
}

// Drop glue of a Transaction: the chosen stack runs, the other is released
// un-run, and the box is freed. In a stop-point module the hooks (user
// callbacks) and the rest of the glue run inside the session Shield (#4720).
fn lower_transaction_drop_glue(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "drop.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    boxed :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{boxed})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: boxed, right: null})
    done :: lower_new_block(&f)
    live :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
    lower_start(&f, live, [LIRValueID]{})
    if m.stop_points -> lower_call_runtime(&m, &f, "jet_rt_session_shield_enter", [LIRValueID]{}, None)
    committed :: lower_list_word(&f, boxed, 0)
    commit_hooks :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: commit_hooks, base: boxed, offset: 8})
    rollback_hooks :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: rollback_hooks, base: boxed, offset: 16})
    zero :: lower_const(&f, 0)
    clean :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: clean, condition: LIRCondition.Ne, left: committed, right: zero})
    commit_path :: lower_new_block(&f)
    rollback_path :: lower_new_block(&f)
    release :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: clean, then_target: lower_target(commit_path, [LIRValueID]{}), else_target: lower_target(rollback_path, [LIRValueID]{})})
    lower_start(&f, commit_path, [LIRValueID]{})
    lower_transaction_walk(&m, &f, commit_hooks, true)
    lower_transaction_walk(&m, &f, rollback_hooks, false)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, rollback_path, [LIRValueID]{})
    lower_transaction_walk(&m, &f, rollback_hooks, true)
    lower_transaction_walk(&m, &f, commit_hooks, false)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, release, [LIRValueID]{})
    lower_free_shell(&m, &f, boxed, lower_transaction_size())
    if m.stop_points -> lower_call_runtime(&m, &f, "jet_rt_session_shield_leave", [LIRValueID]{}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// A transaction handle is never copied (JetTransaction has no Clone).
fn lower_transaction_clone_glue(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    lower_fail(&m, &f, "Transaction clone is not lowered at O0 yet")
    lower_seal(&f, LIRTerminator.Unreachable)
    lir_builder_finish(f.builder)
}

// Expert Shared guards retain the runtime's canonical cell owner and permit.
// Their read/edit provenance survives MIR's transparent tags: it determines
// which permit is released on Drop. The payload is never copied for a field
// projection, and the token has no Clone operation.
fn lower_shared_guard_element(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .Tagged(_, inner) -> lower_shared_guard_element(inner)
        .Apply(name, args) -> if name.name == "SharedGuard" && args.len() == 1 -> Val(args[0]) else -> None
        else -> None
    }
}

fn lower_shared_guard_editable(ty: MIRType) -> Bool? {
    if ty.kind == .Tagged(marker, inner) {
        if lower_shared_guard_element(inner) == None -> return None
        if marker == .Internal(internal_tag) {
            if internal_tag == .SharedGuardRead -> return Val(false)
            if internal_tag == .SharedGuardEdit -> return Val(true)
        }
        return lower_shared_guard_editable(inner)
    }
    None
}

fn lower_shared_guard_repr(ty: MIRType) -> LowerRepr? {
    if lower_shared_guard_element(ty) == None -> return None
    editable :: lower_shared_guard_editable(ty) ?? return Val(LowerRepr.Unsupported{reason: "SharedGuard without checked read/edit provenance"})
    Val(LowerRepr.Handle{drop: if editable -> "jet_rt_native_shared_edit_guard_drop" else -> "jet_rt_native_shared_read_guard_drop", clone: ""})
}

fn lower_shared_guard_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    editable :: symbol == "jet_shared_guard_edit"
    if !editable && symbol != "jet_shared_guard_read" -> return false
    if args.len() != 1 {
        lower_fail(&m, &f, "Shared guard acquisition requires one checked receiver")
        return true
    }
    ty :: lower_checked_type(c, instruction) ?? return true
    if lower_shared_guard_editable(ty) != Val(editable) {
        lower_fail(&m, &f, "Shared guard acquisition lost its checked read/edit provenance")
        return true
    }
    shared :: lower_use(&m, &f, args[0].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_call_runtime(&m, &f, if editable -> "jet_rt_native_shared_guard_edit" else -> "jet_rt_native_shared_guard_read", [LIRValueID]{shared}, Val(dst))
    true
}

// The provider returns the borrowed NativeValue slot, not a copied value or
// another guard. Both scalar and aggregate pointees keep their byte layout.
fn lower_shared_guard_payload(m: &LowerModule, f: &LowerFunction, guard: LIRValueID, ty: MIRType) -> LIRValueID? Never! {
    editable :: lower_shared_guard_editable(ty) ?? {
        lower_fail(&m, &f, "Shared guard dereference lost its checked read/edit provenance")
        return None
    }
    payload :: lower_pointer(&f)
    lower_call_runtime(&m, &f, if editable -> "jet_rt_native_shared_edit_guard_edit" else -> "jet_rt_native_shared_read_guard_deref", [LIRValueID]{guard}, Val(payload))
    Val(payload)
}

fn lower_shared_guard_deref(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID) -> Bool Never! {
    ty :: lower_value_type(c, value) ?? return false
    elem :: lower_shared_guard_element(ty) ?? return false
    guard :: lower_use(&m, &f, value) ?? return true
    payload :: lower_shared_guard_payload(&m, &f, guard, ty) ?? return true
    if lower_repr(p, elem) == .Absent {
        lower_alias_absent(&f, instruction)
        return true
    }
    layout :: lower_repr_layout(lower_repr(p, elem)) ?? return true
    held :: lower_new_value(&f, layout, LIRDrop.Trivial, elem.identity)
    lower_read_into(p, &f, held, payload, 0, elem)
    if lower_read_owns(p, c, m, instruction, elem) {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_clone_into(p, &m, &f, held, dst, elem)
    } else {
        lower_alias(c, &f, instruction, held)
    }
    true
}

// Shared transactions own a provider state, distinct from #Transact's hook
// box. Drop rolls back; normal ScopeExit consumes the state through commit.
fn lower_is_stm(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, args) -> return name.name == "Stm" && args.len() == 0
    false
}

fn lower_stm_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "global stm has no checked type")
    if !lower_is_stm(ty) -> return lower_fail(&m, &f, "global stm must produce a checked Stm")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_call_runtime(&m, &f, "jet_rt_native_stm_begin", [LIRValueID]{}, Val(dst))
}

// Scope names are generated local names. Resolve exactly one Stm local,
// matching the hosted emitter's named Transaction ScopeExit.
fn lower_stm_local(function: MIRFunction, scope: MIRScope) -> MIRLocal? Never! {
    name :: scope.name ?? return None
    found := MIRLocal?{None}
    loop local in function.locals {
        if local.name == name {
            if found != None -> return None
            found = Val(local)
        }
    }
    local :: found ?? return None
    if !lower_is_stm(local.ty) -> return None
    Val(local)
}

fn lower_stm_scope_exit(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, scope: MIRScope) Never! {
    local :: lower_stm_local(c.mir, scope) ?? return lower_fail(&m, &f, "transaction scope must own one uniquely named Stm local")
    slot :: c.local_slots.get(local.id.value) ?? return lower_fail(&m, &f, "transaction Stm local has no lowered slot")
    handle :: lower_slot_root(p, c, &m, &f, slot) ?? return lower_fail(&m, &f, "transaction Stm local has no current owner")
    lower_call_runtime(&m, &f, "jet_rt_native_stm_commit", [LIRValueID]{handle}, None)
    // Commit consumes the state. Clear without a second rollback Drop.
    // Early exits instead use MIR's existing MovePlace + rollback Drop.
    if c.slots[slot].cell {
        // copy: the Stm cell pointer is read while the scope exit emits into `&f`, so a view into
        // f.cells would be live across those writes.
        cell :: (f.cells[slot].copy()) ?? return lower_fail(&m, &f, "transaction Stm cell has no storage")
        lower_clear_at(p, &f, cell, 0, local.ty)
    } else {
        lower_clear_slot(p, c, &f, slot)
    }
}

// Providers may leave their result slot unwritten on the delivered-stop rail.
// Reuse the checked MIR cleanup edge before any caller reads that slot.
fn lower_shared_output_ready(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    position :: c.block_index.get(f.mir_block.value) ?? return lower_fail(&m, &f, "Shared callback has no current MIR block")
    stop := MIRBlockID?{None}
    if c.mir.blocks[position].terminator == .Poll(.Propagate, _, cleanup) -> stop = Val(cleanup)
    cleanup :: stop ?? return lower_fail(&m, &f, "Shared callback needs a checked native Propagate cleanup edge")
    status :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_session_propagate", [LIRValueID]{}, Val(status))
    zero :: lower_const(&f, 0)
    stopped :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: stopped, condition: LIRCondition.Ne, left: status, right: zero})
    pending := [LIRBlockID]{}
    targets := [MIRBlockID]{}
    edge :: lower_branch_target(p, c, &m, &f, cleanup, &pending, &targets) ?? return
    ready :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: stopped, then_target: edge, else_target: lower_target(ready, [LIRValueID]{})})
    lower_fill_pending(p, c, &m, &f, pending, targets)
    lower_start(&f, ready, [LIRValueID]{})
}

fn lower_is_condition(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> name.id == mir_nominal_ref("Condition").id && args.len() == 0
        .Tagged(_, inner) -> lower_is_condition(inner)
        else -> false
    }
}

fn lower_condition_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, args: [MIRCallArg]) -> Bool Never! {
    if lower_runtime_symbol(row) != "jet_std::JetCondition::new" -> return false
    ty :: lower_checked_type(c, instruction) ?? return true
    if !lower_is_condition(ty) || args.len() != 0 {
        lower_fail(&m, &f, "Condition.new requires its checked zero-argument constructor")
        return true
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_call_runtime(&m, &f, "jet_rt_native_condition_new", [LIRValueID]{}, Val(dst))
    true
}

fn lower_condition_notify(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, condition: MIRValueID, all: Bool) Never! {
    ty :: lower_value_type(c, condition) ?? return
    if !lower_is_condition(ty) -> return lower_fail(&m, &f, "Condition notification has no checked Condition receiver")
    value :: lower_use(&m, &f, condition) ?? return
    lower_call_runtime(&m, &f, if all -> "jet_rt_native_condition_notify_all" else -> "jet_rt_native_condition_notify_one", [LIRValueID]{value}, None)
    lower_alias_absent(&f, instruction)
}

// The provider mutates the caller's held/unheld guard token in place.
// Write it back before any stop cleanup, so Drop cannot release another
// writer's permit. Its scratch is a Bool byte on success, an owned String
// only on error, and remains uninitialized on the delivered-stop rail.
fn lower_condition_wait(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, guard: MIRValueID, condition: MIRValueID, predicate: MIRValueID) Never! {
    guard_ty :: lower_value_type(c, guard) ?? return
    elem :: lower_shared_guard_element(guard_ty) ?? return lower_fail(&m, &f, "Condition wait requires a checked SharedGuard")
    editable :: lower_shared_guard_editable(guard_ty) ?? return lower_fail(&m, &f, "Condition wait lost the guard's checked read/edit provenance")
    condition_ty :: lower_value_type(c, condition) ?? return
    if !lower_is_condition(condition_ty) -> return lower_fail(&m, &f, "Condition wait requires a checked Condition")
    predicate_ty :: lower_value_type(c, predicate) ?? return
    if predicate_ty.kind == .Fn(signature) {
        if signature.params.len() != 1 || signature.ret == None -> return lower_fail(&m, &f, "Condition predicate requires one borrowed payload and a Bool result")
        if mir_type_identity_key(signature.params[0]) != mir_type_identity_key(elem) || lower_lazy_callback_access(signature, 0) != .Read -> return lower_fail(&m, &f, "Condition predicate must borrow its checked guard payload")
        result :: signature.ret ?? return
        if lower_repr(p, result) != .Flag -> return lower_fail(&m, &f, "Condition predicate has no native Bool result")
    } else { return lower_fail(&m, &f, "Condition predicate is not a checked function") }
    result_ty :: lower_checked_type(c, instruction) ?? return
    if result_ty.kind == .Result(ok, err) {
        if lower_repr(p, ok) != .Absent || err.kind != .String -> return lower_fail(&m, &f, "Condition wait requires Result<Unit, String>")
    } else { return lower_fail(&m, &f, "Condition wait has no checked Result<Unit, String>") }
    original :: lower_use(&m, &f, guard) ?? return
    changed :: lower_use(&m, &f, condition) ?? return
    body :: lower_use(&m, &f, predicate) ?? return
    writeback := LowerWriteBack?{None}
    guard_slot := LIRValueID{value: -1}
    if lower_value_place(c, guard) == .Val(place) {
        lent :: lower_write_place_arg(p, c, &m, &f, place) ?? return
        writeback = Val(lent)
        guard_slot = lent.cell
    } else {
        // An unnamed temporary has no place, but its MIR owner must likewise
        // be rebound to the token returned by wait before its eventual Drop.
        guard_slot = lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: guard_slot, size: 8, align: 8})
        lower_write_at(p, &f, guard_slot, 0, original, guard_ty)
    }
    scratch :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: scratch, size: 8, align: 8})
    invoke :: lower_lazy_helper_address(&m, &f, "lazy.callback", predicate_ty)
    mode :: lower_const(&f, if editable -> 1 else -> 0)
    verdict :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_shared_guard_wait", [LIRValueID]{guard_slot, mode, changed, body, invoke, scratch}, Val(verdict))
    if writeback == .Val(lent) -> lower_write_back(p, c, &m, &f, lent, Val(guard))
    else {
        updated :: lower_new_like(&f, original)
        lower_read_into(p, &f, updated, guard_slot, 0, guard_ty)
        lower_define(c, &f, guard, updated)
    }
    if lower_value_owned(c, predicate) -> lower_map_drop_value(p, &m, &f, body, predicate_ty)
    if m.stop_points -> lower_shared_output_ready(p, c, &m, &f)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, lower_box_size(p, result_ty))
    one :: lower_const(&f, 1)
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: selector, op: LIRBinaryOp.Sub, left: one, right: verdict})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: selector})
    failed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: failed, condition: LIRCondition.Eq, left: verdict, right: one})
    failure :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    reason :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: reason, base: scratch, offset: 0})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: reason})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}
