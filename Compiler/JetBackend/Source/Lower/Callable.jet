// Compiler invocation preserves the callee's checked signature and failure
// carrier, unlike executable entry normalization. Hidden aggregate output
// pointers are forwarded unchanged. Each compiler image is invoked serially.
use jet_foundation.[MIRProgram]

fn lower_callable_init(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature_id :: ~m.mir_signatures[glue.function]
    signature :: ~m.signatures[signature_id.value]
    f := lower_helper_start(&m, glue, signature.params, signature.result)
    params :: ~f.open_params
    // The loader gives module data writable, non-executable pages. This flag
    // avoids re-allocating runtime-owned statics on repeated compiler calls.
    flag_data :: lower_static_object(&m, 8)
    flag_address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: flag_address, data: flag_data})
    initialized :: lower_flag(&f)
    lower_emit(&f, LIRInst.Load{dst: initialized, base: flag_address, offset: 0})
    initialize :: lower_new_block(&f)
    invoke :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: initialized, then_target: lower_target(invoke, [LIRValueID]{}), else_target: lower_target(initialize, [LIRValueID]{})})
    lower_start(&f, initialize, [LIRValueID]{})
    lower_static_fixups(&m, &f)
    ready :: lower_flag(&f)
    lower_emit(&f, LIRInst.Const{dst: ready, value: 1})
    lower_emit(&f, LIRInst.Store{base: flag_address, offset: 0, value: ready})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(invoke, [LIRValueID]{})})
    lower_start(&f, invoke, [LIRValueID]{})
    result := LIRValueID?{None}
    if signature.result == .Val(layout) -> result = Val(lower_new_value(&f, layout, LIRDrop.Trivial, None))
    lower_emit(&f, LIRInst.Call{dst: result, signature: signature_id, callee: LIRCallee.Function{id: LIRFunctionID{value: glue.function}}, args: params})
    lower_seal(&f, LIRTerminator.Return{value: result})
    lir_builder_finish(f.builder)
}
