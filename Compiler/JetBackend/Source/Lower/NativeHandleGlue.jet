// C-ABI shells for source-owned Core declarations. The shell owns exactly
// Lower's native storage; it never contains a Rust value or a mirrored layout.
// Only a surviving boundary caller registers these helpers. Ordinary Jet
// clone/drop/compare/render operations continue using their existing glue.
use jet_foundation.[MIRProgram, MIRType]
// The shared native-export resolver supplies the concrete checked MIR type.
// Helper interning uses the existing nominal fingerprint (declaration+args).
fn lower_native_handle_id(m: &LowerModule, ty: MIRType, op: String) -> LIRFunctionID? {
    helper :: "native.handle.{op}"
    if lower_native_handle_operation(helper) == None -> return None
    Val(lower_helper_id(&m, helper, ty))
}

fn lower_native_handle_operation(helper: String) -> String? {
    if helper == "native.handle.clone" -> return Val("clone")
    if helper == "native.handle.drop" -> return Val("drop")
    if helper == "native.handle.eq" -> return Val("eq")
    if helper == "native.handle.display" -> return Val("display")
    if helper == "native.handle.show" -> return Val("show")
    if helper == "native.handle.debug" -> return Val("debug")
    None
}



fn lower_native_handle_operand(p: MIRProgram, f: &LowerFunction, ty: MIRType, shell: LIRValueID) -> LIRValueID? {
    if lower_repr(p, ty) == {
        .Absent -> None
        .Inline(_) | .Boxed(_) -> Val(shell)
        else -> lower_read_at(p, &f, shell, 0, ty)
    }
}

fn lower_native_handle_shell_size(p: MIRProgram, ty: MIRType) -> Int Never! {
    bytes :: lower_size(p, ty).size
    if bytes < 8 -> 8 else -> bytes
}

fn lower_native_handle_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue, op: String) -> LIRFunction Never! {
    params := [LIRLayout]{lir_layout_pointer()}
    if op == "eq" -> &params.push(lir_layout_pointer())
    result :: if op == "drop" -> None else if op == "eq" -> Val(lir_layout_bool()) else -> Val(lir_layout_pointer())
    f := lower_helper_start(&m, glue, params, result)
    shell :: f.open_params[0].copy()
    ty :: glue.ty
    repr :: lower_repr(p, ty)
    if repr == .Handle(_, _) || repr == .Unsupported(_) {
        lower_fail(&m, &f, "native handle glue requires the Jet declaration's native representation")
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    if op == "drop" {
        // The C-ABI accepts null on drop, including payload-enum shells.
        zero :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
        absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: shell, right: zero})
        done :: lower_new_block(&f)
        live :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
        lower_start(&f, live, [LIRValueID]{})
        if repr == .Boxed(_) {
            signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
            id :: lower_glue_id(&m, ty)
            lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: id}, args: [LIRValueID]{shell}})
        } else {
            lower_drop_stored(p, &m, &f, shell, 0, ty)
            size :: lower_const(&f, lower_native_handle_shell_size(p, ty))
            align :: lower_const(&f, 8)
            lower_call_runtime(&m, &f, "jet_rt_free", [LIRValueID]{shell, size, align}, None)
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Return{value: None})
    } else if op == "clone" {
        target :: lower_pointer(&f)
        if repr == .Boxed(_) -> lower_call_clone_glue(&m, &f, ty, shell, target) else {
            lower_alloc(&m, &f, target, lower_native_handle_shell_size(p, ty))
            if repr == .Inline(_) -> lower_inline_clone(p, &m, &f, shell, target, ty) else {
                lower_copy_bytes(&f, target, 0, shell, 0, lower_size(p, ty).size)
                lower_glue_clone_fields(p, &m, &f, shell, target, [LowerGlueField]{LowerGlueField{offset: 0, ty: ty}})
            }
        }
        lower_seal(&f, LIRTerminator.Return{value: Val(target)})
    } else if op == "eq" {
        left :: lower_native_handle_operand(p, &f, ty, shell)
        right :: lower_native_handle_operand(p, &f, ty, f.open_params[1].copy())
        equal :: lower_equal_values(p, &m, &f, ty, left, right)
        if equal == .Val(value) -> lower_seal(&f, LIRTerminator.Return{value: Val(value)}) else {
            lower_seal(&f, LIRTerminator.Unreachable)
        }
    } else if op == "display" || op == "show" || op == "debug" {
        mode :: if op == "show" -> LowerRenderMode.Show else if op == "debug" -> LowerRenderMode.Debug else -> LowerRenderMode.Display
        operand :: lower_native_handle_operand(p, &f, ty, shell)
        if lower_render_value(p, &m, &f, ty, operand, mode) == .Val(text) {
            owned := text.value
            if !text.owned {
                owned = lower_pointer(&f)
                lower_call_runtime(&m, &f, "jet_rt_string_clone", [LIRValueID]{text.value}, Val(owned))
            }
            lower_seal(&f, LIRTerminator.Return{value: Val(owned)})
        } else { lower_seal(&f, LIRTerminator.Unreachable) }
    } else {
        lower_fail(&m, &f, "unknown native handle operation {op}")
        lower_seal(&f, LIRTerminator.Unreachable)
    }
    lir_builder_finish(f.builder)
}
