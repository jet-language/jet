// Tasks: `Task<T>` is an owned runtime JetTask<NativeValue> handle
// (crates/jet-codegen/src/Prelude/Core/CAbiTask.rs); a task body is the native
// SendFn closure box. The scheduler kernels own spawning, joining, fail-fast
// and cancellation; the lowering only marshals bodies and typed result slots
// through the shared NativeMeta descriptors (LazyIter.jet lower_lazy_meta).
//
// A body runs through the generated "task.body" helper (env, out) -> 0, which
// calls the closure box and writes its result to `out`; "task.release" drops
// the box on the thread that ran it. A flattened `T E!` body renders its
// failure for the TaskFailure reason with "task.debug" (Rust `{:?}`).
use jet_foundation.[
    MIRCallArg,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIRLoopSourceKind,
    MIROperation,
    MIRPreludeCallID,
    MIRProgram,
    MIRSelectKind,
    MIRTaskGroupKind,
    MIRType,
    MIRTypeKind,
    MIRValueID,
    mir_nominal_ref,
    mir_symbol_name,
    mir_type_display_name,
    mir_type_from_kind,
    mir_type_identity_key,
    MIRPreludeCall,
]

fn lower_task_element(ty: MIRType) -> MIRType? {
    lower_task_handle_element(ty, "Task")
}

fn lower_task_handle_element(ty: MIRType, handle: String) -> MIRType? {
    if ty.kind == .Apply(name, args) {
        if name.name == handle && args.len() == 1 -> return Val(args[0])
    }
    None
}

// Task, Sender and Receiver are owned runtime handles over NativeValue.
fn lower_task_handle_repr(ty: MIRType) -> LowerRepr? {
    if lower_task_element(ty) != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_task_drop", clone: ""})
    if lower_task_handle_element(ty, "Sender") != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_sender_drop", clone: "jet_rt_native_sender_clone"})
    if lower_task_handle_element(ty, "Receiver") != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_receiver_drop", clone: "jet_rt_native_receiver_clone"})
    None
}

// The result a task body of closure type `ty` produces.
fn lower_task_body_result(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .SendFn(params, ret, _) -> if params.len() == 0 -> Val(ret ?? mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: []})) else -> None
        .Fn(signature) -> if signature.params.len() == 0 -> Val(signature.ret ?? mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: []})) else -> None
        else -> None
    }
}

// Cancellation needs a wholly instrumented native call graph, not merely one
// unrelated Poll somewhere in the module. Cached AOT MIR remains refused at
// race/any/cancel sites. Source stops masked inside a Shield/transaction stay
// refused until they have their own safe stop edge.
fn lower_task_stop_program(p: MIRProgram, prepared: [LowerPreparedFunction]) -> Bool Never! {
    loop descriptor in prepared {
        if descriptor.source_row < 0 -> next
        source :: p.functions[descriptor.source_row]
        entry_checked := false
        loop block in source.blocks {
            if block.id == source.entry {
                if block.terminator == .Poll(.Check, _, _) -> entry_checked = true
            }
            loop instruction in block.instructions {
                if instruction.operation == .Semantic(.RequireStop(_, _, _, _, _, _, _)) {
                    propagated := false
                    if block.terminator == .Poll(.Propagate, _, _) -> propagated = true
                    if !propagated -> return false
                }
            }
        }
        if !entry_checked -> return false
    }
    true
}

fn lower_task_template_source(p: MIRProgram, function: MIRFunctionID) -> MIRFunction? {
    loop source in p.functions {
        // copy: the task template is returned as an owned MIRFunction, while `p` is the caller's
        // MIR program (a read parameter), which keeps its function rows.
        if source.id == function -> return Val(source.copy())
    }
    None
}

// A cached unwind-based graph may still spawn bodies statically known not to
// stop. Native instrumented graphs use the runtime rail instead of unwinding.
fn lower_task_can_stop(p: MIRProgram, m: LowerModule, function: MIRFunctionID, seen: &[U64:Bool]) -> Bool Never! {
    if m.task_stop_points -> return false
    if seen.get(function.value) != None -> return false
    &seen.add(function.value, true).drop("checked absent above")
    // A generic callee is named by its template ID in the borrowed source
    // body, while Mono registers only concrete instance IDs. Stop facts do not
    // depend on type arguments, so the template's own body decides.
    index :: lower_function_index(m, function)
    source :: if index >= 0 -> lower_row_source(p, m, index) else -> {
        lower_task_template_source(p, function) ?? return true
    }
    // Core wait points have checked argument guards, not user task stops.
    // Cancellation itself is rejected at Task.cancel and race/any sites.
    if source.key.starts_with("<corelib>") -> return false
    loop block in source.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .Semantic(semantic) -> {
                    // A checked failure-edge fallback is conditional, not an
                    // unconditional task panic. Keep ordinary guarded waits.
                    if block.id == source.entry && semantic == .RequireStop(_, _, _, _, _, _, _) -> return true
                }
                .Call(callee, _, _) -> {
                    child := MIRFunctionID?{None}
                    if callee == {
                        .User(id) | .Method(id, _) | .Associated(id, _) -> child = Val(id)
                        else -> {}
                    }
                    if child == .Val(id) {
                        if lower_task_can_stop(p, m, id, &seen) -> return true
                    }
                }
                .Closure(id, _, _) -> {
                    if lower_task_can_stop(p, m, id, &seen) -> return true
                }
                else -> {}
            }
        }
    }
    false
}

fn lower_task_stop_body(p: MIRProgram, c: LowerContext, m: LowerModule, value: MIRValueID) -> Bool Never! {
    loop block in c.mir.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if result != value -> next
                if instruction.operation == .Closure(id, _, _) {
                    seen := [U64:Bool]{}
                    return lower_task_can_stop(p, m, id, &seen)
                }
            }
        }
    }
    // An indirect callback's stop behavior cannot be established statically.
    true
}

// A descriptor for a body result: a flattened `T E!` body's error member
// gets the Debug helper in its show slot.
fn lower_task_body_meta(p: MIRProgram, m: &LowerModule, f: &LowerFunction, body: MIRType, flatten: Bool) -> LIRValueID Never! {
    meta :: lower_lazy_meta(p, &m, &f, body)
    if flatten && body.kind == .Result(_, err) {
        child :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: child, base: meta, offset: 64})
        debug :: lower_lazy_helper_address(&m, &f, "task.debug", err)
        lower_emit(&f, LIRInst.Store{base: child, offset: 24, value: debug})
    }
    meta
}

// The owned closure box of `closure` for a runtime that consumes it.
fn lower_task_owned_closure(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, closure: MIRValueID, ty: MIRType) -> LIRValueID? {
    value :: lower_use(&m, &f, closure) ?? return None
    if lower_value_takeable(c, closure) -> return Val(value)
    held :: lower_pointer(&f)
    lower_clone_into(p, &m, &f, value, held, ty)
    Val(held)
}

fn lower_task_kind(kind: MIRTaskGroupKind) -> Int Never! {
    if kind == {
        .All -> 0
        .Any -> 1
        .Race -> 2
    }
}

// `task.all` / `task.any` / `task.race` over one List of tasks or of SendFn
// bodies (spawned first); the checked worker element remains the payload.
fn lower_task_group(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, kind: MIRTaskGroupKind, tasks: [MIRValueID]) Never! {
    row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "task group names missing Prelude call {call.value}")
    if kind != .All && !m.task_stop_points -> return lower_fail(&m, &f, "task.any/task.race requires checked native Poll/Stopped cleanup edges")
    if tasks.len() != 1 -> return lower_fail(&m, &f, "task group over {tasks.len()} operands is not lowered at O0 yet")
    list_ty :: lower_value_type(c, tasks[0]) ?? return lower_fail(&m, &f, "task group operand has no checked type")
    if list_ty.kind == .Tuple(_) {
        if kind != .All -> return lower_fail(&m, &f, "heterogeneous task.any/task.race has no single success carrier")
        return lower_task_tuple_all(p, c, &m, &f, instruction, row, tasks[0], list_ty)
    }
    elem :: lower_list_element(list_ty) ?? return lower_fail(&m, &f, "task group over {mir_type_display_name(list_ty)} is not lowered at O0 yet")
    // The runtime takes the List's buffer and leaves an empty header.
    if !lower_value_owned(c, tasks[0]) -> return lower_fail(&m, &f, "task group over a borrowed List is not lowered at O0 yet")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "task group has no checked result type")
    ok := MIRType?{None}
    if result_ty.kind == .Result(success, _) -> ok = Val(success)
    ok_ty :: ok ?? return lower_fail(&m, &f, "task group result {mir_type_display_name(result_ty)} is not lowered at O0 yet")
    spawn := false
    body := MIRType?{None}
    if lower_task_element(elem) == .Val(inner) {
        body = Val(inner)
    } else {
        body = lower_task_body_result(elem)
        spawn = true
    }
    body_ty :: body ?? return lower_fail(&m, &f, "task group element {mir_type_display_name(elem)} is not lowered at O0 yet")
    list :: lower_use(&m, &f, tasks[0]) ?? return
    body_meta :: lower_task_body_meta(p, &m, &f, body_ty, false)
    zero :: lower_const(&f, 0)
    invoke :: if spawn -> lower_lazy_helper_address(&m, &f, "task.body", elem) else -> zero
    release :: if spawn -> lower_lazy_helper_address(&m, &f, "task.release", elem) else -> zero
    ok_meta :: lower_lazy_meta(p, &m, &f, ok_ty)
    args :: [LIRValueID]{lower_const(&f, lower_task_kind(kind)), lower_const_flag(&f, 0), list, lower_const_flag(&f, if spawn -> 1 else -> 0), body_meta, invoke, release, ok_meta}
    lower_task_outcome(p, c, &m, &f, instruction, "jet_rt_native_task_group", args, result_ty)
}

// A heterogeneous task.all owns the tuple's handles but returns its individual
// result slots. The runtime still uses the same task-all failure policy.
fn lower_task_tuple_all(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, tasks: MIRValueID, tuple_ty: MIRType) Never! {
    if !lower_value_owned(c, tasks) -> return lower_fail(&m, &f, "task.all over a borrowed tuple is not lowered at O0 yet")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "task.all tuple has no checked result")
    success := MIRType?{None}
    if result_ty.kind == .Result(ok, _) -> success = Val(ok)
    ok_ty :: success ?? return lower_fail(&m, &f, "task.all tuple has no failure carrier")
    tuple_result := false
    if ok_ty.kind == .Tuple(_) -> tuple_result = true
    if !tuple_result -> return lower_fail(&m, &f, "task.all tuple has no tuple success carrier")
    fields :: lower_inline_members(p, tuple_ty)
    outputs :: lower_inline_members(p, ok_ty)
    if fields.len() != outputs.len() -> return lower_fail(&m, &f, "task.all tuple success arity does not match its handles")
    flatten :: lower_runtime_symbol(row).ends_with("_result")
    handles :: lower_pointer(&f)
    offsets :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: handles, size: fields.len() * 8, align: 8})
    lower_emit(&f, LIRInst.StackSlot{dst: offsets, size: fields.len() * 8, align: 8})
    source :: lower_use(&m, &f, tasks) ?? return
    loop (index, field) in fields {
        body :: lower_task_element(field.ty) ?? return lower_fail(&m, &f, "task.all tuple field is not a Task")
        payload := body
        if flatten {
            if body.kind == .Result(ok, _) -> payload = ok
        }
        if mir_type_identity_key(payload) != mir_type_identity_key(outputs[index].ty) -> return lower_fail(&m, &f, "task.all tuple field has a mismatched result carrier")
        handle :: lower_read_at(p, &f, source, field.offset, field.ty) ?? return
        lower_emit(&f, LIRInst.Store{base: handles, offset: index * 8, value: handle})
        lower_store_word(&f, offsets, index * 8, outputs[index].offset)
    }
    count :: lower_const(&f, fields.len())
    mode :: lower_const_flag(&f, if flatten -> 1 else -> 0)
    lower_task_outcome(p, c, &m, &f, instruction, "jet_rt_native_task_all_tuple", [LIRValueID]{handles, count, mode, offsets}, result_ty)
}

// A runtime outcome `export(args..., out) -> verdict` as the instruction's native
// Result box using the ordinary Result payload offset. The error crosses as a runtime handle: a
// Core record (TaskFailure) is rebuilt in its native layout (Records.jet); an
// opaque runtime handle error type is kept as the handle; any other error
// layout is reported instead of reinterpreting runtime bytes.
fn lower_task_outcome(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, export: String, args: [LIRValueID], result_ty: MIRType) Never! {
    err := MIRType?{None}
    // copy: `failure` is a payload of read parameter `result_ty`, which keeps the original; the Val carrier owns this one
    if result_ty.kind == .Result(_, failure) -> err = Val(failure.copy())
    err_ty :: err ?? return lower_fail(&m, &f, "{export} result {mir_type_display_name(result_ty)} is not lowered at O0 yet")
    runtime :: lower_record_handle(p, err_ty)
    if runtime == None {
        if lower_repr(p, err_ty) == {
            .Handle(_, _) -> {}
            else -> return lower_fail(&m, &f, "{export} failure {mir_type_display_name(err_ty)} has no runtime record marshaling")
        }
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, lower_box_size(p, result_ty))
    out :: lower_address(&f, dst, lower_result_payload_offset())
    call_args := [LIRValueID]{}
    loop arg in args -> &call_args.push(arg)
    &call_args.push(out)
    verdict :: lower_word(&f)
    done :: lower_new_block(&f)
    lower_call_runtime(&m, &f, export, call_args, Val(verdict))
    if m.stop_points {
        status :: lower_word(&f)
        lower_call_runtime(&m, &f, "jet_rt_session_propagate", [LIRValueID]{}, Val(status))
        running :: lower_flag(&f)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: running, condition: LIRCondition.Eq, left: status, right: zero})
        resume :: lower_new_block(&f)
        stopped :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: running, then_target: lower_target(resume, [LIRValueID]{}), else_target: lower_target(stopped, [LIRValueID]{})})
        lower_start(&f, stopped, [LIRValueID]{})
        // The runtime left the payload unwritten; release only its container.
        lower_free_shell(&m, &f, dst, lower_box_size(p, result_ty))
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, resume, [LIRValueID]{})
    }
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: verdict})
    if runtime == .Val(record) {
        zero :: lower_const(&f, lower_result_selector(false))
        failed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: failed, condition: LIRCondition.Eq, left: verdict, right: zero})
        failure :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, failure, [LIRValueID]{})
        lower_record_store_from_slot(p, &m, &f, err_ty, record, out, dst, lower_result_payload_offset())
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// `spawn`: values are [site, label] or [group, site, label]; the closure box
// moves into the task.
fn lower_task_spawn(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, values: [MIRValueID], closure: MIRValueID?) Never! {
    body :: closure ?? return lower_fail(&m, &f, "spawn without a closure is not lowered at O0 yet")
    if lower_task_stop_body(p, c, m, body) -> return lower_fail(&m, &f, "task body with a checked stop across native frames is not lowered at O0 yet")
    if values.len() != 2 && values.len() != 3 -> return lower_fail(&m, &f, "spawn with {values.len()} operands is not lowered at O0 yet")
    closure_ty :: lower_value_type(c, body) ?? return lower_fail(&m, &f, "spawn closure has no checked type")
    result_ty :: lower_task_body_result(closure_ty) ?? return lower_fail(&m, &f, "spawn of {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
    task_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "spawn has no checked result type")
    if lower_task_element(task_ty) == None -> return lower_fail(&m, &f, "spawn producing {mir_type_display_name(task_ty)} is not lowered at O0 yet")
    first :: values.len() - 2
    site :: lower_use(&m, &f, values[first]) ?? return
    label :: lower_use(&m, &f, values[first + 1]) ?? return
    env :: lower_task_owned_closure(p, c, &m, &f, body, closure_ty) ?? return
    invoke :: lower_lazy_helper_address(&m, &f, "task.body", closure_ty)
    release :: lower_lazy_helper_address(&m, &f, "task.release", closure_ty)
    fallible := false
    if result_ty.kind == .Result(_, _) -> fallible = true
    meta :: lower_task_body_meta(p, &m, &f, result_ty, fallible)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    args := [LIRValueID]{}
    symbol := "jet_rt_native_task_spawn"
    if values.len() == 3 {
        &args.push(lower_use(&m, &f, values[0]) ?? return)
        symbol = "jet_rt_native_group_spawn"
    }
    &args.push(site)
    &args.push(label)
    &args.push(env)
    &args.push(invoke)
    &args.push(release)
    &args.push(meta)
    lower_call_runtime(&m, &f, symbol, args, Val(dst))
}

// `task.group` builds its owning group with `JetTaskGroup.new()` or
// `.with_limit(limit)`; the group crosses as the runtime JetTaskGroup handle
// (RuntimeRoutes.jet `Group`), whose drop joins every child. The scope's
// deferred `JetTaskGroup.close(&group)` (Statements.jet task group) joins them
// at the scope exit through the borrowed handle, as MathTaskMem.rs close.
fn lower_task_group_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: mir_symbol_name(row.symbol)
    if symbol == "jet_std::JetTaskGroup::close" {
        if args.len() != 1 || args[0].access == .Write {
            lower_fail(&m, &f, "JetTaskGroup.close requires one borrowed group")
            return true
        }
        group :: lower_use(&m, &f, args[0].value) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_task_group_close", [LIRValueID]{group}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    limited :: symbol == "jet_std::JetTaskGroup::with_limit"
    if symbol != "jet_std::JetTaskGroup::new" && !limited -> return false
    if args.len() != (if limited -> 1 else -> 0) {
        lower_fail(&m, &f, "JetTaskGroup.{row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    values := [LIRValueID]{}
    if limited -> &values.push(lower_use(&m, &f, args[0].value) ?? return true)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_call_runtime(&m, &f, if limited -> "jet_rt_native_task_group_with_limit" else -> "jet_rt_native_task_group_new", values, Val(dst))
    true
}

// `core.sys.atexit(callback)`: the callback's owned closure box joins the
// runtime's exit handlers (CAbiTask.rs jet_rt_native_atexit), which run at
// the process exit boundary (jet_runtime_boundary / jet_runtime_process_exit).
fn lower_atexit_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    if mir_symbol_name(row.symbol) != "jet_std_os_atexit" -> return false
    if args.len() != 1 {
        lower_fail(&m, &f, "core.sys.atexit with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    closure_ty :: lower_value_type(c, args[0].value) ?? {
        lower_fail(&m, &f, "core.sys.atexit callback has no checked type")
        return true
    }
    result :: lower_task_body_result(closure_ty) ?? {
        lower_fail(&m, &f, "core.sys.atexit over {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, result) != .Absent {
        lower_fail(&m, &f, "core.sys.atexit over {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
        return true
    }
    env :: lower_task_owned_closure(p, c, &m, &f, args[0].value, closure_ty) ?? return true
    lower_call_runtime(&m, &f, "jet_rt_native_atexit", [LIRValueID]{env}, None)
    lower_alias_absent(&f, instruction)
    true
}

// Task handle methods by Prelude member; false when `receiver` is no Task.
fn lower_task_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, args: [MIRValueID]) -> Bool Never! {
    receiver_ty :: lower_value_type(c, receiver) ?? return false
    if lower_channel_method(p, c, &m, &f, instruction, call, receiver, args, receiver_ty) -> return true
    if lower_task_element(receiver_ty) == None -> return false
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    handle :: lower_use(&m, &f, receiver) ?? return true
    if symbol == "cancel" {
        if !m.task_stop_points {
            lower_fail(&m, &f, "Task.cancel requires checked native Poll/Stopped cleanup edges")
            return true
        }
        lower_call_runtime(&m, &f, "jet_rt_native_task_cancel", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if symbol == "pause_with_mode" {
        if args.len() != 1 {
            lower_fail(&m, &f, "Task.pause_with_mode requires its checked mode argument")
            return true
        }
        mode :: lower_lazy_native_int(p, c, &m, &f, args[0]) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_task_pause_with_mode", [LIRValueID]{handle, mode}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if symbol == "pause" || symbol == "resume" {
        lower_call_runtime(&m, &f, if row.member == "pause" -> "jet_rt_native_task_pause" else -> "jet_rt_native_task_resume", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    consumes :: symbol == "join" || symbol == "jet_task_join_result" || symbol == "detach"
    if !consumes -> return false
    if !lower_value_owned(c, receiver) {
        lower_fail(&m, &f, "Task.{row.member} on a borrowed task is not lowered at O0 yet")
        return true
    }
    if symbol == "detach" {
        lower_call_runtime(&m, &f, "jet_rt_native_task_detach", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Task.join has no checked result type")
        return true
    }
    flatten :: lower_const_flag(&f, if symbol == "jet_task_join_result" -> 1 else -> 0)
    lower_task_outcome(p, c, &m, &f, instruction, "jet_rt_native_task_join", [LIRValueID]{handle, flatten}, result_ty)
    true
}

// ---------------------------------------------------------------------------
// Generated helpers (for the closure type, or the error type of task.debug).

fn lower_helper_task_body(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_word()))
    env :: f.open_params[0].copy()
    out :: f.open_params[1].copy()
    result_ty :: lower_task_body_result(glue.ty) ?? panic("task.body is requested for zero-argument closures")
    if lower_call_closure_box(p, &m, &f, env, [LIRValueID]{}, result_ty) == .Val(result) -> lower_callback_store(p, &m, &f, out, result, result_ty)
    zero :: lower_const(&f, 0)
    lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    lir_builder_finish(f.builder)
}

fn lower_helper_task_release(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    env :: f.open_params[0].copy()
    lower_map_drop_value(p, &m, &f, env, glue.ty)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// (slot) -> owned String: the Debug text of the value stored at slot.
fn lower_helper_task_debug(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    slot :: f.open_params[0].copy()
    value :: lower_read_at(p, &f, slot, 0, glue.ty)
    text :: lower_render_value(p, &m, &f, glue.ty, value, LowerRenderMode.Debug) ?? {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    owned := text.value
    if !text.owned {
        owned = lower_render_string(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_clone", [LIRValueID]{text.value}, Val(owned))
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(owned)})
    lir_builder_finish(f.builder)
}

// The operands task and channel operations consume (as MIRRust moves them):
// an owned place read that lands here is a copy of its own (LowerContext.sunk).
fn lower_task_stored_operands(p: MIRProgram, m: LowerModule, operation: MIROperation) -> [MIRValueID] Never! {
    stored := [MIRValueID]{}
    if operation == .Semantic(semantic) {
        if semantic == .SharedGuardWait(_, _, _, predicate) -> &stored.push(predicate)
        if semantic == .TaskGroup(_, _, tasks) {
            loop value in tasks -> &stored.push(value)
        }
        if semantic == .Select(_, _, values) {
            loop value in values -> &stored.push(value)
        }
        if semantic == .CoreClosureCall(_, kind, _, closure, _, _) {
            if kind == .Spawn || kind == .Realtime {
                if closure == .Val(value) -> &stored.push(value)
            }
        }
        if semantic == .HandleMethod(call, receiver, args, _, _) {
            row :: lower_prelude_row(p, m, call) ?? return stored
            symbol :: mir_symbol_name(row.symbol)
            if symbol == "jet_std::JetTask::join" || symbol == "jet_std::jet_task_join_result" || symbol == "jet_task_join_result" || symbol == "jet_std::JetTask::detach" -> &stored.push(receiver)
            if symbol == "jet_std::JetSender::send" && args.len() == 1 -> &stored.push(args[0])
        }
        // Shared.new takes its initial value and Shared.read / Shared.edit
        // their callback when MIR moves them.
        if semantic == .StaticPreludeCall(call, args, _, _) {
            row :: lower_prelude_row(p, m, call) ?? return stored
            if mir_symbol_name(row.symbol) == "jet_std::JetShared::new" {
                loop arg in args { if arg.access == .Move -> &stored.push(arg.value) }
            }
        }
        if semantic == .HostCall(call, args) {
            row :: lower_prelude_row(p, m, call) ?? return stored
            symbol :: mir_symbol_name(row.symbol)
            if symbol == "jet_shared_read" || symbol == "jet_shared_edit" || symbol == "jet_shared_read_txn" || symbol == "jet_shared_edit_txn" {
                loop arg in args { if arg.access == .Move -> &stored.push(arg.value) }
            }
        }
    }
    stored
}

// ---------------------------------------------------------------------------
// Shared<T>: Jet-native cell. `shared x` builds the cell
// from the native slot of `x`; a field read or write is `Shared.read` /
// `Shared.edit` with a callback run under the shared lock on the cell's slot.

// The native slot of a call argument the runtime takes: the value's own when
// MIR moves an owned value, else a clone.
fn lower_shared_taken_slot(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, arg: MIRCallArg, ty: MIRType) -> LIRValueID? {
    if arg.access == .Move && lower_value_owned(c, arg.value) {
        lowered :: lower_use(&m, &f, arg.value) ?? return None
        return Val(lower_lazy_value_slot(p, &m, &f, lowered, ty))
    }
    lowered :: lower_use(&m, &f, arg.value) ?? return None
    if lower_is_inline(p, ty) {
        held :: lower_new_storage(p, &f, ty)
        lower_inline_clone(p, &m, &f, lowered, held, ty)
        return Val(held)
    }
    layout :: lower_value_layout(f, lowered)
    copied :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_clone_into(p, &m, &f, lowered, copied, ty)
    Val(lower_lazy_value_slot(p, &m, &f, copied, ty))
}

fn lower_shared_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    if mir_symbol_name(row.symbol) != "jet_std::JetShared::new" -> return false
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Shared.new has no checked result type")
        return true
    }
    inner := MIRType?{None}
    if result_ty.kind == .Shared(value) -> inner = Val(value)
    inner_ty :: inner ?? {
        lower_fail(&m, &f, "Shared.new producing {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    if args.len() != 1 {
        lower_fail(&m, &f, "Shared.new with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    slot :: lower_shared_taken_slot(p, c, &m, &f, args[0], inner_ty) ?? return true
    meta :: lower_lazy_meta(p, &m, &f, inner_ty)
    // The descriptor already holds the mono address-based ordinary drop role
    // (zero for trivial T). Last release owns invoking it, not Meta16 fallback.
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    // The runtime owns this exact typed destructor, including a consuming
    // Close implementation. Do not invent zero or a second cleanup callback.
    drop_fn :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: drop_fn, base: meta, offset: 16})
    lower_call_runtime(&m, &f, "jet_rt_native_shared_new", [LIRValueID]{slot, meta, drop_fn}, Val(dst))
    true
}

// `Shared.same(a, b)`: Rust JetShared::same is Arc::ptr_eq. A native Shared
// handle is its cell address (jet_rt_native_shared_clone returns the same
// cell), so identity is equality of the two borrowed handle words.
fn lower_shared_same(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    if mir_symbol_name(row.symbol) != "jet_shared_same" -> return false
    if args.len() != 2 {
        lower_fail(&m, &f, "Shared.same requires two checked Shared operands")
        return true
    }
    shared_repr :: LowerRepr.Handle{drop: "jet_rt_native_shared_drop", clone: "jet_rt_native_shared_clone"}
    loop arg in args {
        ty :: lower_value_type(c, arg.value) ?? return true
        if lower_repr(p, ty) != shared_repr {
            lower_fail(&m, &f, "Shared.same over {mir_type_display_name(ty)} has no native Shared handle")
            return true
        }
    }
    left :: lower_use(&m, &f, args[0].value) ?? return true
    right :: lower_use(&m, &f, args[1].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: left, right: right})
    true
}

// `Shared.read(shared, callback)` / `Shared.edit(shared, callback)`: the
// callback (LazyIter.jet "lazy.callback.owned": a Write parameter receives the
// cell's slot itself) runs under the lock and writes its result to `out`.
fn lower_shared_access(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: mir_symbol_name(row.symbol)
    transaction :: symbol == "jet_shared_read_txn" || symbol == "jet_shared_edit_txn"
    edits :: symbol == "jet_shared_edit" || symbol == "jet_shared_edit_txn"
    if symbol != "jet_shared_read" && !edits && !transaction -> return false
    callback_index :: if transaction -> 2 else -> 1
    if args.len() != callback_index + 1 {
        lower_fail(&m, &f, "{symbol} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    shared_ty :: lower_value_type(c, args[0].value) ?? return true
    is_shared := false
    if shared_ty.kind == .Shared(_) -> is_shared = true
    if !is_shared {
        lower_fail(&m, &f, "{symbol} over {mir_type_display_name(shared_ty)} is not lowered at O0 yet")
        return true
    }
    closure_ty :: lower_value_type(c, args[callback_index].value) ?? return true
    params := 0
    if closure_ty.kind == .Fn(signature) -> params = signature.params.len()
    if params != 1 {
        lower_fail(&m, &f, "{symbol} callback {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
        return true
    }
    shared :: lower_use(&m, &f, args[0].value) ?? return true
    closure :: lower_use(&m, &f, args[callback_index].value) ?? return true
    invoke :: lower_lazy_helper_address(&m, &f, "lazy.callback.owned", closure_ty)
    result_ty :: lower_checked_type(c, instruction)
    value_ty := MIRType?{None}
    if result_ty == .Val(ty) {
        if lower_repr(p, ty) == .Absent -> lower_alias_absent(&f, instruction) else -> value_ty = Val(ty)
    }
    // An inline result is written straight into its own frame storage; any
    // other result goes through one word slot.
    stored := LIRValueID?{None}
    dst := LIRValueID?{None}
    if value_ty == .Val(ty) {
        if lower_is_inline(p, ty) {
            storage :: lower_result(p, c, &m, &f, instruction) ?? return true
            lower_storage_into(p, &f, storage, ty)
            stored = Val(storage)
        } else {
            dst = lower_result(p, c, &m, &f, instruction)
        }
    }
    out :: stored ?? lower_pointer(&f)
    if stored == None -> lower_emit(&f, LIRInst.StackSlot{dst: out, size: 8, align: 8})
    if transaction {
        state_ty :: lower_value_type(c, args[1].value) ?? return true
        if !lower_is_stm(state_ty) {
            lower_fail(&m, &f, "{symbol} requires a checked Stm owner")
            return true
        }
        state :: lower_use(&m, &f, args[1].value) ?? return true
        lower_call_runtime(&m, &f, if edits -> "jet_rt_native_shared_edit_txn" else -> "jet_rt_native_shared_read_txn", [LIRValueID]{shared, state, closure, invoke, out}, None)
    } else {
        lower_call_runtime(&m, &f, if edits -> "jet_rt_native_shared_edit" else -> "jet_rt_native_shared_read", [LIRValueID]{shared, closure, invoke, out}, None)
    }
    // A stopped body/failed staged clone leaves out uninitialized. Release a
    // moved synchronous body before taking the existing MIR cleanup edge.
    if args[callback_index].access == .Move && lower_value_owned(c, args[callback_index].value) -> lower_map_drop_value(p, &m, &f, closure, closure_ty)
    if transaction && m.stop_points -> lower_shared_output_ready(p, c, &m, &f)
    if dst == .Val(value) {
        if value_ty == .Val(ty) -> lower_read_into(p, &f, value, out, 0, ty)
    }
    true
}

// ---------------------------------------------------------------------------
// Channels: `channel<T>()` / `channel<T>(capacity:)` CoreCalls build the
// (Sender<T>, Receiver<T>) tuple; endpoint methods and `loop value in rx`
// go to the runtime's JetSender / JetReceiver over NativeValue.

fn lower_channel_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, m, route) ?? return false
    symbol :: mir_symbol_name(row.symbol)
    bounded :: symbol == "jet_std::channel_bounded"
    if symbol != "jet_std::channel" && !bounded -> return false
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "channel has no checked result type")
        return true
    }
    members :: lower_inline_members(p, result_ty)
    if members.len() != 2 || lower_task_handle_element(members[0].ty, "Sender") == None || lower_task_handle_element(members[1].ty, "Receiver") == None {
        lower_fail(&m, &f, "channel producing {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    if args.len() != (if bounded -> 1 else -> 0) {
        lower_fail(&m, &f, "channel with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    capacity := lower_const(&f, 0)
    if bounded -> capacity = lower_use(&m, &f, args[0].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, result_ty)
    tx :: lower_address(&f, dst, members[0].offset)
    rx :: lower_address(&f, dst, members[1].offset)
    flag :: lower_const_flag(&f, if bounded -> 1 else -> 0)
    lower_call_runtime(&m, &f, "jet_rt_native_channel", [LIRValueID]{flag, capacity, tx, rx}, None)
    true
}

// An owned native slot holding `value` of `ty` for a runtime that takes it;
// a borrowed value is cloned first.
fn lower_channel_owned_slot(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID, ty: MIRType) -> LIRValueID? {
    lowered :: lower_use(&m, &f, value) ?? return None
    if lower_value_owned(c, value) -> return Val(lower_lazy_value_slot(p, &m, &f, lowered, ty))
    if lower_is_inline(p, ty) {
        held :: lower_new_storage(p, &f, ty)
        lower_inline_clone(p, &m, &f, lowered, held, ty)
        return Val(held)
    }
    layout :: lower_value_layout(f, lowered)
    copied :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_clone_into(p, &m, &f, lowered, copied, ty)
    Val(lower_lazy_value_slot(p, &m, &f, copied, ty))
}

fn lower_channel_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, args: [MIRValueID], receiver_ty: MIRType) -> Bool Never! {
    sender :: lower_task_handle_element(receiver_ty, "Sender")
    receiving :: lower_task_handle_element(receiver_ty, "Receiver")
    elem :: sender ?? (receiving ?? return false)
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    endpoint :: if sender != None -> "sender" else -> "receiver"
    handle :: lower_use(&m, &f, receiver) ?? return true
    if symbol == "close" {
        lower_call_runtime(&m, &f, "jet_rt_native_{runtime_abi_atom(endpoint)}_close", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if sender != None && symbol == "send" {
        if args.len() != 1 {
            lower_fail(&m, &f, "Sender.send with {args.len()} arguments is not lowered at O0 yet")
            return true
        }
        slot :: lower_channel_owned_slot(p, c, &m, &f, args[0], elem) ?? return true
        meta :: lower_lazy_meta(p, &m, &f, elem)
        lower_call_runtime(&m, &f, "jet_rt_native_sender_send", [LIRValueID]{handle, slot, meta}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if sender != None -> return false
    if symbol == "is_ready" {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_receiver_is_ready", [LIRValueID]{handle}, Val(dst))
        return true
    }
    if symbol == "try_receive" {
        meta :: lower_lazy_meta(p, &m, &f, elem)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_receiver_try_receive", [LIRValueID]{handle, meta}, Val(dst))
        return true
    }
    if symbol == "receive" {
        result_ty :: lower_checked_type(c, instruction) ?? {
            lower_fail(&m, &f, "Receiver.receive has no checked result type")
            return true
        }
        lower_task_outcome(p, c, &m, &f, instruction, "jet_rt_native_receiver_receive", [LIRValueID]{handle}, result_ty)
        return true
    }
    false
}

// `loop value in rx`: the receiver becomes a lazy runtime iterator in the
// native cursor wrapper LazyIter.jet lower_lazy_cursor_init builds.
fn lower_channel_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind) -> Bool Never! {
    if source_kind != .ChannelReceiver -> return false
    ty :: lower_value_type(c, collection) ?? return false
    elem :: lower_task_handle_element(ty, "Receiver") ?? return false
    if step != None {
        lower_fail(&m, &f, "a stepped channel loop is not lowered at O0 yet")
        return true
    }
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return true
    receiver :: lower_use(&m, &f, collection) ?? return true
    moved :: lower_const_flag(&f, if by_value && lower_value_owned(c, collection) -> 1 else -> 0)
    source :: lower_pointer(&f)
    meta :: lower_lazy_meta(p, &m, &f, elem)
    lower_call_runtime(&m, &f, "jet_rt_native_receiver_iter", [LIRValueID]{receiver, moved, meta}, Val(source))
    stride :: lower_const(&f, 1)
    has_step :: lower_const_flag(&f, 0)
    handle :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_iter_cursor_init", [LIRValueID]{source, stride, has_step}, Val(handle))
    iter_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Iter"), args: [MIRType]{elem}})
    release :: lower_helper_id(&m, "iter.release", iter_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: handle})
    lower_store_word(&f, dst, 8, -1)
    lower_store_word(&f, dst, 16, 0)
    lower_store_function_key(&m, &f, dst, 24, release)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
    true
}

// A readiness table is normalized by the producer to owned receiver/timer
// Lists and one Wait. The canonical kernel writes (arm, value: T?).
fn lower_task_select(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, kind: MIRSelectKind, values: [MIRValueID]) Never! {
    if kind != .Wait || values.len() != 2 -> return lower_fail(&m, &f, "select has no normalized readiness table")
    row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "select names a missing Prelude call")
    symbol :: lower_runtime_symbol(row)
    probing :: symbol == "jet_select_try_wait_tagged"
    if symbol != "jet_select_wait_tagged" && !probing -> return lower_fail(&m, &f, "select has no canonical wait route")
    if !lower_value_owned(c, values[0]) || !lower_value_owned(c, values[1]) -> return lower_fail(&m, &f, "select readiness Lists must be owned")
    receiver_ty :: lower_value_type(c, values[0]) ?? return lower_fail(&m, &f, "select has no receiver List type")
    receiver :: lower_list_element(receiver_ty) ?? return lower_fail(&m, &f, "select receivers are not a List")
    if lower_task_handle_element(receiver, "Receiver") == None -> return lower_fail(&m, &f, "select source is not a Receiver")
    timer_ty :: lower_value_type(c, values[1]) ?? return lower_fail(&m, &f, "select has no timer List type")
    timer :: lower_list_element(timer_ty) ?? return lower_fail(&m, &f, "select timers are not a List")
    if !lower_is_exact_int(timer) -> return lower_fail(&m, &f, "select timers must be exact nanosecond integers")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "select has no checked result")
    members :: lower_inline_members(p, result_ty)
    if members.len() != 2 -> return lower_fail(&m, &f, "select result is not its arm/payload tuple")
    if !lower_is_exact_int(members[0].ty) || lower_option_inner(members[1].ty) == None -> return lower_fail(&m, &f, "select result has no canonical arm/payload slots")
    recvs :: lower_use(&m, &f, values[0]) ?? return
    timers :: lower_use(&m, &f, values[1]) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, result_ty)
    mode :: lower_const_flag(&f, if probing -> 1 else -> 0)
    arm :: lower_address(&f, dst, members[0].offset)
    value :: lower_address(&f, dst, members[1].offset)
    lower_call_runtime(&m, &f, "jet_rt_native_select_wait", [LIRValueID]{recvs, timers, mode, arm, value}, None)
}
