// Tasks: `Task<T>` is an owned runtime JetTask<NativeValue> handle
// (crates/jet-codegen/src/Prelude/Core/CAbiTask.rs); a task body is the native
// SendFn closure box. The scheduler kernels own spawning, joining, fail-fast
// and cancellation; the lowering only marshals bodies and typed result slots
// through the shared NativeMeta descriptors (LazyIter.jet lower_lazy_meta).
//
// A body runs through the generated "task.body" helper (env, out) -> 0, which
// calls the closure box and writes its result to `out`; "task.release" drops
// the box on the thread that ran it. A flattened `T E!` body renders its
// failure for the TaskFailure reason with "task.debug" (Rust `{:?}`).
use jet_foundation.[
    MIRCallArg, MIRInstruction, MIRLoopSourceKind, MIROperation, MIRPreludeCallID,
    MIRProgram, MIRTaskGroupKind, MIRType, MIRTypeKind, MIRValueID, mir_nominal_ref,
    mir_symbol_name, mir_type_display_name, mir_type_from_kind,
]

fn lower_task_element(ty: MIRType) -> MIRType? {
    lower_task_handle_element(ty, "Task")
}

fn lower_task_handle_element(ty: MIRType, handle: String) -> MIRType? {
    if ty.kind == .Apply(name, args) {
        if name.name == handle && args.len() == 1 -> return Val(args[0])
    }
    None
}

// Task, Sender and Receiver are owned runtime handles over NativeValue.
fn lower_task_handle_repr(ty: MIRType) -> LowerRepr? {
    if lower_task_element(ty) != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_task_drop", clone: ""})
    if lower_task_handle_element(ty, "Sender") != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_sender_drop", clone: "jet_rt_native_sender_clone"})
    if lower_task_handle_element(ty, "Receiver") != None -> return Val(LowerRepr.Handle{drop: "jet_rt_native_receiver_drop", clone: "jet_rt_native_receiver_clone"})
    None
}

// The result a task body of closure type `ty` produces.
fn lower_task_body_result(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .SendFn(params, ret, _) -> if params.len() == 0 -> ret else -> None
        .Fn(signature) -> if signature.params.len() == 0 -> signature.ret else -> None
        else -> None
    }
}

// A descriptor for a body result: a flattened `T E!` body's error member
// gets the Debug helper in its show slot.
fn lower_task_body_meta(p: MIRProgram, m: &LowerModule, f: &LowerFunction, body: MIRType, flatten: Bool) -> LIRValueID Never! {
    meta :: lower_lazy_meta(p, &m, &f, body)
    if flatten && body.kind == .Result(_, err) {
        child :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: child, base: meta, offset: 64})
        debug :: lower_lazy_helper_address(&m, &f, "task.debug", err)
        lower_emit(&f, LIRInst.Store{base: child, offset: 24, value: debug})
    }
    meta
}

// The owned closure box of `closure` for a runtime that consumes it.
fn lower_task_owned_closure(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, closure: MIRValueID, ty: MIRType) -> LIRValueID? {
    value :: lower_use(&m, &f, closure) ?? return None
    if lower_value_owned(c, closure) -> return Val(value)
    held :: lower_pointer(&f)
    lower_clone_into(p, &m, &f, value, held, ty)
    Val(held)
}

fn lower_task_kind(kind: MIRTaskGroupKind) -> Int Never! {
    if kind == {
        .All -> 0
        .Any -> 1
        .Race -> 2
    }
}

// `task.all` / `task.any` / `task.race` over one List of tasks or of SendFn
// bodies (spawned first); `*_result` routes flatten `T E!` bodies.
fn lower_task_group(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, kind: MIRTaskGroupKind, tasks: [MIRValueID]) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "task group names missing Prelude call {call.value}")
    if tasks.len() != 1 -> return lower_fail(&m, &f, "task group over {tasks.len()} operands is not lowered at O0 yet")
    list_ty :: lower_value_type(c, tasks[0]) ?? return lower_fail(&m, &f, "task group operand has no checked type")
    elem :: lower_list_element(list_ty) ?? return lower_fail(&m, &f, "task group over {mir_type_display_name(list_ty)} is not lowered at O0 yet")
    // The runtime takes the List's buffer and leaves an empty header.
    if !lower_value_owned(c, tasks[0]) -> return lower_fail(&m, &f, "task group over a borrowed List is not lowered at O0 yet")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "task group has no checked result type")
    ok := MIRType?{None}
    if result_ty.kind == .Result(success, _) -> ok = Val(success)
    ok_ty :: ok ?? return lower_fail(&m, &f, "task group result {mir_type_display_name(result_ty)} is not lowered at O0 yet")
    flatten :: lower_runtime_symbol(row).ends_with("_result")
    spawn := false
    body := MIRType?{None}
    if lower_task_element(elem) == .Val(inner) {
        body = Val(inner)
    } else {
        body = lower_task_body_result(elem)
        spawn = true
    }
    body_ty :: body ?? return lower_fail(&m, &f, "task group element {mir_type_display_name(elem)} is not lowered at O0 yet")
    list :: lower_use(&m, &f, tasks[0]) ?? return
    body_meta :: lower_task_body_meta(p, &m, &f, body_ty, flatten)
    zero :: lower_const(&f, 0)
    invoke :: if spawn -> lower_lazy_helper_address(&m, &f, "task.body", elem) else -> zero
    release :: if spawn -> lower_lazy_helper_address(&m, &f, "task.release", elem) else -> zero
    ok_meta :: lower_lazy_meta(p, &m, &f, ok_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    args :: [LIRValueID]{lower_const(&f, lower_task_kind(kind)), lower_const_flag(&f, if flatten -> 1 else -> 0), list, lower_const_flag(&f, if spawn -> 1 else -> 0), body_meta, invoke, release, ok_meta}
    lower_call_runtime(&m, &f, "jet_rt_native_task_group", args, Val(dst))
}

// `spawn`: values are [site, label] or [group, site, label]; the closure box
// moves into the task.
fn lower_task_spawn(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, values: [MIRValueID], closure: MIRValueID?) Never! {
    body :: closure ?? return lower_fail(&m, &f, "spawn without a closure is not lowered at O0 yet")
    if values.len() != 2 && values.len() != 3 -> return lower_fail(&m, &f, "spawn with {values.len()} operands is not lowered at O0 yet")
    closure_ty :: lower_value_type(c, body) ?? return lower_fail(&m, &f, "spawn closure has no checked type")
    result_ty :: lower_task_body_result(closure_ty) ?? return lower_fail(&m, &f, "spawn of {mir_type_display_name(closure_ty)} is not lowered at O0 yet")
    task_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "spawn has no checked result type")
    if lower_task_element(task_ty) == None -> return lower_fail(&m, &f, "spawn producing {mir_type_display_name(task_ty)} is not lowered at O0 yet")
    first :: values.len() - 2
    site :: lower_use(&m, &f, values[first]) ?? return
    label :: lower_use(&m, &f, values[first + 1]) ?? return
    env :: lower_task_owned_closure(p, c, &m, &f, body, closure_ty) ?? return
    invoke :: lower_lazy_helper_address(&m, &f, "task.body", closure_ty)
    release :: lower_lazy_helper_address(&m, &f, "task.release", closure_ty)
    fallible := false
    if result_ty.kind == .Result(_, _) -> fallible = true
    meta :: lower_task_body_meta(p, &m, &f, result_ty, fallible)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    args := [LIRValueID]{}
    symbol := "jet_rt_native_task_spawn"
    if values.len() == 3 {
        &args.push(lower_use(&m, &f, values[0]) ?? return)
        symbol = "jet_rt_native_group_spawn"
    }
    &args.push(site)
    &args.push(label)
    &args.push(env)
    &args.push(invoke)
    &args.push(release)
    &args.push(meta)
    lower_call_runtime(&m, &f, symbol, args, Val(dst))
}

// Task handle methods by Prelude member; false when `receiver` is no Task.
fn lower_task_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, args: [MIRValueID]) -> Bool Never! {
    receiver_ty :: lower_value_type(c, receiver) ?? return false
    if lower_channel_method(p, c, &m, &f, instruction, call, receiver, args, receiver_ty) -> return true
    if lower_task_element(receiver_ty) == None -> return false
    row :: lower_prelude_row(p, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    handle :: lower_use(&m, &f, receiver) ?? return true
    if symbol == "cancel" {
        lower_call_runtime(&m, &f, "jet_rt_native_task_cancel", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    consumes :: symbol == "join" || symbol == "jet_task_join_result" || symbol == "detach"
    if !consumes -> return false
    if !lower_value_owned(c, receiver) {
        lower_fail(&m, &f, "Task.{row.member} on a borrowed task is not lowered at O0 yet")
        return true
    }
    if symbol == "detach" {
        lower_call_runtime(&m, &f, "jet_rt_native_task_detach", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Task.join has no checked result type")
        return true
    }
    ok_ty :: if result_ty.kind == .Result(ok, _) -> ok else -> {
        lower_fail(&m, &f, "Task.join result {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    flatten :: lower_const_flag(&f, if symbol == "jet_task_join_result" -> 1 else -> 0)
    ok_meta :: lower_lazy_meta(p, &m, &f, ok_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_call_runtime(&m, &f, "jet_rt_native_task_join", [LIRValueID]{handle, flatten, ok_meta}, Val(dst))
    true
}

// ---------------------------------------------------------------------------
// Generated helpers (for the closure type, or the error type of task.debug).

fn lower_helper_task_body(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_word()))
    env :: ~f.open_params[0]
    out :: ~f.open_params[1]
    result_ty :: lower_task_body_result(glue.ty) ?? panic("task.body is requested for zero-argument closures")
    if lower_call_closure_box(p, &m, &f, env, [LIRValueID]{}, result_ty) == .Val(result) -> lower_write_at(p, &f, out, 0, result, result_ty)
    zero :: lower_const(&f, 0)
    lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    lir_builder_finish(f.builder)
}

fn lower_helper_task_release(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    env :: ~f.open_params[0]
    lower_map_drop_value(p, &m, &f, env, glue.ty)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// (slot) -> owned String: the Debug text of the value stored at slot.
fn lower_helper_task_debug(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    slot :: ~f.open_params[0]
    value :: lower_read_at(p, &f, slot, 0, glue.ty)
    text :: lower_render_value(p, &m, &f, glue.ty, value, LowerRenderMode.Debug) ?? {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    owned := text.value
    if !text.owned {
        owned = lower_render_string(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_clone", [LIRValueID]{text.value}, Val(owned))
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(owned)})
    lir_builder_finish(f.builder)
}

// The operands task and channel operations consume (as MIRRust moves them):
// an owned place read that lands here is a copy of its own (LowerContext.sunk).
fn lower_task_stored_operands(p: MIRProgram, operation: MIROperation) -> [MIRValueID] Never! {
    stored := [MIRValueID]{}
    if operation == .Semantic(semantic) {
        if semantic == .TaskGroup(_, _, tasks) {
            loop value in tasks -> &stored.push(value)
        }
        if semantic == .CoreClosureCall(_, kind, _, closure, _, _) {
            if kind == .Spawn {
                if closure == .Val(value) -> &stored.push(value)
            }
        }
        if semantic == .HandleMethod(call, receiver, args, _, _) {
            row :: lower_prelude_row(p, call) ?? return stored
            symbol :: mir_symbol_name(row.symbol)
            if symbol == "jet_std::JetTask::join" || symbol == "jet_std::jet_task_join_result" || symbol == "jet_task_join_result" || symbol == "jet_std::JetTask::detach" -> &stored.push(receiver)
            if symbol == "jet_std::JetSender::send" && args.len() == 1 -> &stored.push(args[0])
        }
    }
    stored
}

// ---------------------------------------------------------------------------
// Channels: `channel<T>()` / `channel<T>(capacity:)` CoreCalls build the
// (Sender<T>, Receiver<T>) tuple; endpoint methods and `loop value in rx`
// go to the runtime's JetSender / JetReceiver over NativeValue.

fn lower_channel_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    row :: lower_prelude_row(p, route) ?? return false
    symbol :: mir_symbol_name(row.symbol)
    bounded :: symbol == "jet_std::channel_bounded"
    if symbol != "jet_std::channel" && !bounded -> return false
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "channel has no checked result type")
        return true
    }
    members :: lower_inline_members(p, result_ty)
    if members.len() != 2 || lower_task_handle_element(members[0].ty, "Sender") == None || lower_task_handle_element(members[1].ty, "Receiver") == None {
        lower_fail(&m, &f, "channel producing {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    if args.len() != (if bounded -> 1 else -> 0) {
        lower_fail(&m, &f, "channel with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    capacity := lower_const(&f, 0)
    if bounded -> capacity = lower_use(&m, &f, args[0].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, result_ty)
    tx :: lower_address(&f, dst, members[0].offset)
    rx :: lower_address(&f, dst, members[1].offset)
    flag :: lower_const_flag(&f, if bounded -> 1 else -> 0)
    lower_call_runtime(&m, &f, "jet_rt_native_channel", [LIRValueID]{flag, capacity, tx, rx}, None)
    true
}

// An owned native slot holding `value` of `ty` for a runtime that takes it;
// a borrowed value is cloned first.
fn lower_channel_owned_slot(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID, ty: MIRType) -> LIRValueID? {
    lowered :: lower_use(&m, &f, value) ?? return None
    if lower_value_owned(c, value) -> return Val(lower_lazy_value_slot(p, &m, &f, lowered, ty))
    if lower_is_inline(p, ty) {
        held :: lower_new_storage(p, &f, ty)
        lower_inline_clone(p, &m, &f, lowered, held, ty)
        return Val(held)
    }
    layout :: lower_value_layout(f, lowered)
    copied :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_clone_into(p, &m, &f, lowered, copied, ty)
    Val(lower_lazy_value_slot(p, &m, &f, copied, ty))
}

fn lower_channel_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, args: [MIRValueID], receiver_ty: MIRType) -> Bool Never! {
    sender :: lower_task_handle_element(receiver_ty, "Sender")
    receiving :: lower_task_handle_element(receiver_ty, "Receiver")
    elem :: sender ?? (receiving ?? return false)
    row :: lower_prelude_row(p, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    endpoint :: if sender != None -> "sender" else -> "receiver"
    handle :: lower_use(&m, &f, receiver) ?? return true
    if symbol == "close" {
        lower_call_runtime(&m, &f, "jet_rt_native_{endpoint}_close", [LIRValueID]{handle}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if sender != None && symbol == "send" {
        if args.len() != 1 {
            lower_fail(&m, &f, "Sender.send with {args.len()} arguments is not lowered at O0 yet")
            return true
        }
        slot :: lower_channel_owned_slot(p, c, &m, &f, args[0], elem) ?? return true
        meta :: lower_lazy_meta(p, &m, &f, elem)
        lower_call_runtime(&m, &f, "jet_rt_native_sender_send", [LIRValueID]{handle, slot, meta}, None)
        lower_alias_absent(&f, instruction)
        return true
    }
    if sender != None -> return false
    if symbol == "is_ready" {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_receiver_is_ready", [LIRValueID]{handle}, Val(dst))
        return true
    }
    if symbol == "try_receive" || symbol == "receive" {
        meta :: lower_lazy_meta(p, &m, &f, elem)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_receiver_{symbol}", [LIRValueID]{handle, meta}, Val(dst))
        return true
    }
    false
}

// `loop value in rx`: the receiver becomes a lazy runtime iterator in the
// native cursor wrapper LazyIter.jet lower_lazy_cursor_init builds.
fn lower_channel_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool, source_kind: MIRLoopSourceKind) -> Bool Never! {
    if source_kind != .ChannelReceiver -> return false
    ty :: lower_value_type(c, collection) ?? return false
    elem :: lower_task_handle_element(ty, "Receiver") ?? return false
    if step != None {
        lower_fail(&m, &f, "a stepped channel loop is not lowered at O0 yet")
        return true
    }
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return true
    receiver :: lower_use(&m, &f, collection) ?? return true
    moved :: lower_const_flag(&f, if by_value && lower_value_owned(c, collection) -> 1 else -> 0)
    source :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_receiver_iter", [LIRValueID]{receiver, moved}, Val(source))
    stride :: lower_const(&f, 1)
    has_step :: lower_const_flag(&f, 0)
    handle :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_iter_cursor_init", [LIRValueID]{source, stride, has_step}, Val(handle))
    iter_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Iter"), args: [MIRType]{elem}})
    release :: lower_helper_id(&m, "iter.release", iter_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: handle})
    lower_store_word(&f, dst, 8, -1)
    lower_store_word(&f, dst, 16, 0)
    lower_store_word(&f, dst, 24, release.value)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
    true
}
