// MIR conversions at O0: transparent forwards, supported scalar numeric casts,
// and Prelude calls with the same carrier ABI in static and hosted runtimes.
// Exact Int remains a signed inline word or a tagged big-integer handle: never
// feed the latter to a machine conversion or reinterpret it as an I64/Char.
use jet_foundation.[
    MIRCallFallibility,
    MIRConversion,
    MIRInstruction,
    MIRPanicLoc,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRProgram,
    MIRType,
    MIRValueID,
    mir_type_display_name,
]

fn lower_convert_type(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .Tagged(_, inner) -> lower_convert_type(inner)
        .InlineRange(base, _, _) -> lower_convert_type(base)
        .Quantity(base, _) -> lower_convert_type(base)
        else -> ty
    }
}

// Like lower_exact_arithmetic, eligibility selects only the machine fast path.
// The runtime, not lowering, decides what a tagged Int / wide I64 means.
fn lower_convert_exact(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID, symbol: String, to_float: Bool) Never! {
    fast_block :: lower_new_block(&f)
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    layout :: lower_value_layout(f, dst)
    fits :: lower_inline_test(&f, [LIRValueID]{value})
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(fast_block, no_args), else_target: lower_target(slow_block, no_args)})
    lower_start(&f, fast_block, no_args)
    fast :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    if to_float {
        lower_emit(&f, LIRInst.Convert{dst: fast, src: value})
    } else {
        lower_emit(&f, LIRInst.Move{dst: fast, src: value})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})
    lower_start(&f, slow_block, no_args)
    slow :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{value}, Val(slow))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_convert_char(m: &LowerModule, f: &LowerFunction, value: LIRValueID) Never! {
    // A Char is a Unicode scalar, not an arbitrary word: exclude surrogates as
    // well as negative / > U+10FFFF values (MIRRust.rs:21388 char::from_u32).
    // Unsigned compares fold the negative case into each range test: one
    // `value > U+10FFFF` and one `value - U+D800 <= 0x7FF` (surrogates).
    maximum :: lower_const(&f, 1114111)
    too_large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_large, condition: LIRCondition.UGt, left: value, right: maximum})
    lower_check(&m, &f, too_large, "jet_rt_panic_overflow")
    first_surrogate :: lower_const(&f, 55296)
    offset :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Sub, left: value, right: first_surrogate})
    surrogate_span :: lower_const(&f, 2047)
    surrogate :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: surrogate, condition: LIRCondition.ULe, left: offset, right: surrogate_span})
    lower_check(&m, &f, surrogate, "jet_rt_panic_overflow")
}

// The scalar a NumericCast operand is carried as. Narrow is a fixed-width
// integer below 64 bits, already sign- or zero-extended in its word.
enum LowerScalar { Exact I64 Narrow Float Char Other }

fn lower_convert_scalar(ty: MIRType) -> LowerScalar Never! {
    if lower_convert_type(ty).kind == {
        .Int -> LowerScalar.Exact
        .IntN(signed, bits) -> if bits < 64 -> LowerScalar.Narrow else -> if signed -> LowerScalar.I64 else -> LowerScalar.Other
        .Float -> LowerScalar.Float
        .Char -> LowerScalar.Char
        else -> LowerScalar.Other
    }
}

fn lower_convert_numeric(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, target: MIRType) Never! {
    source_type :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "numeric conversion without a checked source type is not lowered at O0 yet")
    source :: lower_convert_scalar(source_type)
    destination :: lower_convert_scalar(target)
    from_exact :: source == .Exact
    to_exact :: destination == .Exact
    from_i64 :: source == .I64
    to_i64 :: destination == .I64
    from_float :: source == .Float
    to_float :: destination == .Float
    from_char :: source == .Char
    to_char :: destination == .Char
    if source != .Other && source == destination -> return lower_forward(c, &m, &f, instruction, value)
    if (from_exact && (to_i64 || to_float || to_char)) || (from_i64 && (to_exact || to_float)) || (from_char && to_exact) {
        operand :: lower_use(&m, &f, value) ?? return
        // MIRRust.rs:23498/:23519 call the owned exact-Int adapters. The
        // C exports borrow/return their raw word carriers, never a Rust owner.
        if from_exact || (from_i64 && to_exact) {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            symbol :: if to_float -> "jet_int_owned_to_f64" else -> if to_exact -> "jet_int_owned_from_i64" else -> "jet_int_owned_to_i64"
            lower_convert_exact(&m, &f, dst, operand, symbol, to_float)
            if to_char -> lower_convert_char(&m, &f, dst)
            return
        }
        if to_float {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        return lower_alias(c, &f, instruction, operand)
    }
    // Sema only widens (Expressions/Constructors.jet:1194): a narrow word is
    // already its value as any wider integer, and inside the inline Int range.
    if source == .Narrow {
        if to_float {
            operand :: lower_use(&m, &f, value) ?? return
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        if to_exact || to_i64 || destination == .Narrow || lower_is_unsigned_word(target) -> return lower_forward(c, &m, &f, instruction, value)
    }
    // Float->integer is not a checked NumericCast producer in Jet sema:
    // Expressions/Constructors.jet:1194 and Expressions.jet:126 only widen.
    // FloatToInt uses a Prelude conversion and its fallibility instead. Do not
    // invent a saturating/trapping rule for an unreachable NumericCast pair.
    lower_fail(&m, &f, "numeric conversion from {mir_type_display_name(source_type)} to {mir_type_display_name(target)} is not lowered at O0 yet")
}

// MIRRust.rs:conversion :23541-23579. The runtime symbol is called like any
// Prelude route (lower_call); a symbol the image runtime lacks is a link error.
fn lower_convert_prelude(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], call: MIRPreludeCallID, location: MIRPanicLoc, fallibility: MIRCallFallibility) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "conversion naming missing Prelude call {call.value} is not lowered at O0 yet")
    symbol :: lower_runtime_symbol(row)
    if fallibility != MIRCallFallibility.Infallible || row.fallibility != MIRCallFallibility.Infallible || row.abi == MIRPreludeABI.Aggregate || row.abi == MIRPreludeABI.Control -> return lower_fail(&m, &f, "Prelude conversion {symbol} with a failure or control adapter is not lowered at O0 yet")
    operand :: lower_use(&m, &f, value) ?? return
    args := [LIRValueID]{operand}
    loop parameter in parameters {
        lowered :: lower_use(&m, &f, parameter) ?? return
        &args.push(lowered)
    }
    // MIRRust.rs:23576 appends file+line only when the row requires context;
    // the native file is a pointer+length pair, as in lower_binary.
    if row.signature.arity == args.len() + 2 {
        loop arg in lower_location(p, &m, &f, location) -> &args.push(arg)
    } else {
        if row.signature.arity != args.len() -> return lower_fail(&m, &f, "Prelude conversion {symbol} with arity {row.signature.arity} is not lowered at O0 yet")
    }
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return
    lower_call_runtime(&m, &f, symbol, args, dst)
}

fn lower_convert(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], target: MIRType, conversion: MIRConversion) Never! {
    if conversion == {
        .Transparent -> lower_forward(c, &m, &f, instruction, value)
        .NumericCast -> {
            if parameters.len() != 0 -> return lower_fail(&m, &f, "numeric conversion with parameters is not lowered at O0 yet")
            lower_convert_numeric(p, c, &m, &f, instruction, value, target)
        }
        .Prelude(call, location, fallibility) -> lower_convert_prelude(p, c, &m, &f, instruction, value, parameters, call, location, fallibility)
        .SendFn -> lower_fail(&m, &f, "SendFn conversion is not lowered at O0 yet")
    }
}
