// MIR conversions at O0: transparent forwards, supported scalar numeric casts,
// and Prelude calls with the same carrier ABI in static and hosted runtimes.
// Exact Int remains a signed inline word or a tagged big-integer handle: never
// feed the latter to a machine conversion or reinterpret it as an I64/Char.
use jet_foundation.[
    MIRCallFallibility,
    MIRConstant,
    MIRConversion,
    MIRFunction,
    MIRInstruction,
    MIRPanicLoc,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRProgram,
    MIRType,
    MIRUnaryOp,
    MIRValueID,
    mir_operation_value_uses,
    mir_terminator_value_uses,
    mir_type_display_name,
]

fn lower_convert_type(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .Tagged(_, inner) -> lower_convert_type(inner)
        .InlineRange(base, _, _) -> lower_convert_type(base)
        .Quantity(base, _) -> lower_convert_type(base)
        else -> ty
    }
}

// A sized integer literal (`I64{5}`, `U8{255}`, `U64{18446744073709551615}`)
// reaches MIR as an exact Int constant converted by the infallible
// `int_checked_fixed` route. Its value is known here, so it is the fixed
// word itself (Rust `5i64`): no exact Int is built and no checked conversion
// runs. That is also what keeps the runtime's own Int kernels, written with
// sized literals, from calling themselves. A constant outside the target's
// range keeps the runtime conversion and its stop.
fn lower_fixed_literal_word(value: Int, target: MIRType) -> Int? Never! {
    if lower_convert_type(target).kind == .IntN(signed, bits) {
        if bits > 64 -> return None
        lowest :: if signed -> 0 - (1 << (bits - 1)) else -> 0
        highest :: if signed -> (1 << (bits - 1)) - 1 else -> (1 << bits) - 1
        if value < lowest || value > highest -> return None
        return Val(lower_wide_word(value))
    }
    None
}

fn lower_fixed_literal_conversion(p: MIRProgram, conversion: MIRConversion) -> Bool Never! {
    if conversion == .Prelude(call, _, fallibility) {
        if fallibility != MIRCallFallibility.Infallible -> return false
        row :: lower_prelude_row(p, call) ?? return false
        return row.member == "int_checked_fixed"
    }
    false
}

fn lower_exact_constant_value(constant: MIRConstant) -> Int? Never! {
    if constant == {
        .Int(number, _, _) -> Val(number)
        .BigInt(decimal) -> {
            value :: Int.parse(decimal) ?? return None
            Val(value)
        }
        else -> None
    }
}

// Exact Int values known at compile time: Int / BigInt constants, and
// negations of such values (`I64{-n}` may reach MIR as Neg(n)).
fn lower_exact_constants(function: MIRFunction) -> [U64:Int] Never! {
    values := [U64:Int]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Constant(constant) {
                result :: instruction.result ?? next
                ty :: instruction.ty ?? next
                if !lower_is_exact_int(ty) -> next
                if lower_exact_constant_value(constant) == .Val(number) -> _ := &values.add(result.value, number)
            }
        }
    }
    if values.len() == 0 -> return values
    // Negations in any block order: repeat until no new value is known.
    changed := true
    loop changed {
        changed = false
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .Unary(op, source) {
                    if op != MIRUnaryOp.Neg -> next
                    result :: instruction.result ?? next
                    if values.get(result.value) != None -> next
                    ty :: instruction.ty ?? next
                    if !lower_is_exact_int(ty) -> next
                    number :: values.get(source.value) ?? next
                    _ := &values.add(result.value, 0 - number)
                    changed = true
                }
            }
        }
    }
    values
}

// MIR value -> its fixed word, for the compile-time exact Int values
// (lower_exact_constants) whose every use folds: an infallible sized-literal
// conversion that fits (lower_fixed_literal_word), or a negation that itself
// folds. Those values lower to nothing (their Constant or Neg emits no code)
// and their conversions to the word, so a sized literal never calls the Int
// runtime. A known value nothing uses (codegen folds `I64{-2^62}` and leaves
// the operand `2^62` behind) also lowers to nothing: beyond the inline range
// it would otherwise build a runtime big integer for no reader, which inside
// the runtime's own Int kernels never returns. A value with any other use
// keeps its ordinary lowering.
fn lower_fixed_literals(p: MIRProgram, function: MIRFunction) -> [U64:Int] Never! {
    known :: lower_exact_constants(function)
    words := [U64:Int]{}
    if known.len() == 0 -> return words
    blocked := [U64:Bool]{}
    // Source value -> the negations it defines.
    derived := [U64:[U64]]{}
    loop place in function.places {
        if place.base == {
            .Parameter(value) | .Temporary(value) | .Capture(value) -> _ := &blocked.add(value.value, true)
            else -> {}
        }
        loop projection in place.projections {
            if projection == {
                .Index(_, index, _, _, _, _, _) -> _ := &blocked.add(index.value, true)
                .Range(range, _, _) -> _ := &blocked.add(range.value, true)
                .MapLookup(lookup, _, _) -> _ := &blocked.add(lookup.value, true)
                else -> {}
            }
        }
    }
    loop scope in function.scopes {
        if scope.deadline == .Val(deadline) -> _ := &blocked.add(deadline.value, true)
    }
    loop block in function.blocks {
        loop used in mir_terminator_value_uses(block.terminator) -> _ := &blocked.add(used.value, true)
        loop instruction in block.instructions {
            folded := U64?{None}
            if instruction.operation == .Convert(value, _, target, conversion) {
                if known.get(value.value) == .Val(number) {
                    if lower_fixed_literal_conversion(p, conversion) {
                        if lower_fixed_literal_word(number, target) == .Val(word) {
                            // Two conversions to different words keep the runtime path.
                            if (words.get(value.value) ?? word) == word {
                                _ := &words.add(value.value, word)
                                folded = Val(value.value)
                            }
                        }
                    }
                }
            }
            if instruction.operation == .Unary(op, source) {
                if instruction.result == .Val(result) {
                    if op == MIRUnaryOp.Neg && known.get(result.value) != None && known.get(source.value) != None {
                        children := derived.get(source.value) ?? [U64]{}
                        &children.push(result.value)
                        _ := &derived.add(source.value, children)
                        folded = Val(source.value)
                    }
                }
            }
            loop used in mir_operation_value_uses(instruction.operation) {
                if folded == .Val(skip) {
                    if used.value == skip -> next
                }
                _ := &blocked.add(used.value, true)
            }
        }
    }
    // A value whose negation keeps its lowering must exist for that Neg.
    changed := true
    loop changed {
        changed = false
        loop (source, children) in derived {
            if blocked.get(source) != None -> next
            loop child in children {
                if blocked.get(child) != None {
                    _ := &blocked.add(source, true)
                    changed = true
                    break
                }
            }
        }
    }
    kept := [U64:Int]{}
    loop (value, _) in known {
        if blocked.get(value) != None -> next
        // Never read as a word (only negated or unused) when it has no
        // folding conversion of its own.
        _ := &kept.add(value, words.get(value) ?? 0)
    }
    kept
}

// Like lower_exact_arithmetic, eligibility selects only the machine fast path.
// The runtime, not lowering, decides what a tagged Int / wide I64 means.
// An inline Int is its own word, so the fast path passes `value` straight to
// the merge: a jump argument reads it without consuming it, and an owning
// exact Int source stays its owner's to drop (a Move would end its life and
// change its drop glue).
fn lower_convert_exact(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID, symbol: String, to_float: Bool) Never! {
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    layout :: lower_value_layout(f, dst)
    fits :: lower_inline_test(&f, [LIRValueID]{value})
    if to_float {
        fast_block :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(fast_block, no_args), else_target: lower_target(slow_block, no_args)})
        lower_start(&f, fast_block, no_args)
        fast :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
        lower_emit(&f, LIRInst.Convert{dst: fast, src: value})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})
    } else {
        lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(merge_block, [LIRValueID]{value}), else_target: lower_target(slow_block, no_args)})
    }
    lower_start(&f, slow_block, no_args)
    slow :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{value}, Val(slow))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

// A native i64 count read from a collection header (Collections.rs
// jet_list_len and kin return i64) as the call's checked result. MIRRust.rs
// native_int_result widens it into an exact Int (JetInt::from_i64); a
// fixed-width result keeps the word.
fn lower_native_count(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, dst: LIRValueID, count: LIRValueID) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "a native count without a checked result type is not lowered at O0 yet")
    if lower_repr(p, ty) == .ExactInt -> return lower_convert_exact(&m, &f, dst, count, "jet_int_owned_from_i64", false)
    lower_emit(&f, LIRInst.Move{dst: dst, src: count})
}

fn lower_convert_u64_exact(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID) Never! {
    no_args :: [LIRValueID]{}
    small_block :: lower_new_block(&f)
    large_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    zero :: lower_const(&f, 0)
    signed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: signed, condition: LIRCondition.Ge, left: value, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: signed, then_target: lower_target(small_block, no_args), else_target: lower_target(large_block, no_args)})
    lower_start(&f, small_block, no_args)
    small :: lower_word(&f)
    lower_convert_exact(&m, &f, small, value, "jet_int_owned_from_i64", false)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{small})})
    lower_start(&f, large_block, no_args)
    mask :: lower_const(&f, 9223372036854775807)
    low :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: low, op: LIRBinaryOp.And, left: value, right: mask})
    // jet_int_add borrows both halves: they are released after the sum.
    low_int :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    lower_call_runtime(&m, &f, "jet_int_owned_from_i64", [LIRValueID]{low}, Val(low_int))
    half :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    two_pow_63 :: lower_static_text(&m, &f, "9223372036854775808")
    lower_call_runtime(&m, &f, "jet_rt_int_from_static", two_pow_63, Val(half))
    large :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_add", [LIRValueID]{low_int, half}, Val(large))
    lower_emit(&f, LIRInst.Drop{value: low_int})
    lower_emit(&f, LIRInst.Drop{value: half})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{large})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_convert_char(m: &LowerModule, f: &LowerFunction, value: LIRValueID) Never! {
    // A Char is a Unicode scalar, not an arbitrary word: exclude surrogates as
    // well as negative / > U+10FFFF values (MIRRust.rs:21388 char::from_u32).
    // Unsigned compares fold the negative case into each range test: one
    // `value > U+10FFFF` and one `value - U+D800 <= 0x7FF` (surrogates).
    maximum :: lower_const(&f, 1114111)
    too_large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_large, condition: LIRCondition.UGt, left: value, right: maximum})
    lower_check(&m, &f, too_large, "jet_rt_panic_overflow")
    first_surrogate :: lower_const(&f, 55296)
    offset :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Sub, left: value, right: first_surrogate})
    surrogate_span :: lower_const(&f, 2047)
    surrogate :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: surrogate, condition: LIRCondition.ULe, left: offset, right: surrogate_span})
    lower_check(&m, &f, surrogate, "jet_rt_panic_overflow")
}

// The scalar a NumericCast operand is carried as. Narrow is a fixed-width
// integer below 64 bits, already sign- or zero-extended in its word.
enum LowerScalar { Exact I64 Narrow Float Float32 Char Other }

fn lower_convert_scalar(ty: MIRType) -> LowerScalar Never! {
    if lower_convert_type(ty).kind == {
        .Int -> LowerScalar.Exact
        .IntN(signed, bits) -> if bits < 64 -> LowerScalar.Narrow else -> if signed -> LowerScalar.I64 else -> LowerScalar.Other
        .Float -> LowerScalar.Float
        .Float32 -> LowerScalar.Float32
        .Char -> LowerScalar.Char
        else -> LowerScalar.Other
    }
}

// Float32Bits is a raw low-32 word at the MIR/runtime boundary, not an
// integer value to numerically convert. Only typed SSE temporaries are Float32.
fn lower_convert_f32_operand(f: &LowerFunction, value: LIRValueID) -> LIRValueID Never! {
    single :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Bitcast{dst: single, src: value})
    single
}

fn lower_convert_f32_result(f: &LowerFunction, dst: LIRValueID, value: LIRValueID) Never! {
    single :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Convert{dst: single, src: value})
    lower_emit(&f, LIRInst.Bitcast{dst: dst, src: single})
}

// Rust's unsigned-to-float cast: a high-bit U64 becomes a signed half with
// a sticky low bit, then doubles after rounding. This avoids double rounding.
fn lower_convert_u64_float(f: &LowerFunction, dst: LIRValueID, value: LIRValueID) Never! {
    no_args :: [LIRValueID]{}
    direct :: lower_new_block(&f)
    high :: lower_new_block(&f)
    done :: lower_new_block(&f)
    sign :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: sign, condition: LIRCondition.Ge, left: value, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: sign, then_target: lower_target(direct, no_args), else_target: lower_target(high, no_args)})
    lower_start(&f, direct, no_args)
    small_layout :: lower_value_layout(f, dst)
    small :: lower_new_value(&f, small_layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Convert{dst: small, src: value})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{small})})
    lower_start(&f, high, no_args)
    one :: lower_const(&f, 1)
    half :: lower_word(&f)
    low :: lower_word(&f)
    sticky :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: half, op: LIRBinaryOp.UShr, left: value, right: one})
    lower_emit(&f, LIRInst.Binary{dst: low, op: LIRBinaryOp.And, left: value, right: one})
    lower_emit(&f, LIRInst.Binary{dst: sticky, op: LIRBinaryOp.Or, left: half, right: low})
    rounded_layout :: lower_value_layout(f, dst)
    rounded :: lower_new_value(&f, rounded_layout, LIRDrop.Trivial, None)
    large_layout :: lower_value_layout(f, dst)
    large :: lower_new_value(&f, large_layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Convert{dst: rounded, src: sticky})
    lower_emit(&f, LIRInst.Binary{dst: large, op: LIRBinaryOp.Add, left: rounded, right: rounded})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{large})})
    lower_start(&f, done, [LIRValueID]{dst})
}

fn lower_convert_numeric(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, target: MIRType) Never! {
    source_type :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "numeric conversion without a checked source type is not lowered at O0 yet")
    source :: lower_convert_scalar(source_type)
    destination :: lower_convert_scalar(target)
    from_exact :: source == .Exact
    to_exact :: destination == .Exact
    from_i64 :: source == .I64
    to_i64 :: destination == .I64
    from_float :: source == .Float
    to_float :: destination == .Float
    from_char :: source == .Char
    to_char :: destination == .Char
    // Numeric casts inspect their input; an exact identity cast still returns
    // an independent owner, unlike a transparent carrier transfer.
    if from_exact && to_exact -> return lower_copy(p, c, &m, &f, instruction, value)
    if lower_convert_fixed(p, c, &m, &f, instruction, value, source_type, target) -> return
    if source != .Other && source == destination -> return lower_forward(c, &m, &f, instruction, value)
    // Reuse the numeric pairs from 08dadc79e; unlike that original lowering,
    // cross the raw-binary32 carrier boundary explicitly.
    to_float32 :: destination == .Float32
    if source == .Float32 && to_float {
        operand :: lower_use(&m, &f, value) ?? return
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        single :: lower_convert_f32_operand(&f, operand)
        return lower_emit(&f, LIRInst.Convert{dst: dst, src: single})
    }
    if to_float32 && (from_float || source == .Narrow || from_i64 || from_exact || lower_is_unsigned_word(lower_convert_type(source_type))) {
        operand :: lower_use(&m, &f, value) ?? return
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        if from_exact {
            // Jet's exact-Int NumericCast uses the same f64 adapter as Float
            // before the final `as f32` (Emit/Operations.jet:4791).
            wide :: lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
            lower_convert_exact(&m, &f, wide, operand, "jet_int_owned_to_f64", true)
            return lower_convert_f32_result(&f, dst, wide)
        }
        if lower_is_unsigned_word(lower_convert_type(source_type)) {
            single :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
            lower_convert_u64_float(&f, single, operand)
            return lower_emit(&f, LIRInst.Bitcast{dst: dst, src: single})
        }
        return lower_convert_f32_result(&f, dst, operand)
    }
    if (from_exact && (to_i64 || to_float || to_char)) || (from_i64 && (to_exact || to_float)) || (from_char && to_exact) {
        operand :: lower_use(&m, &f, value) ?? return
        // MIRRust.rs:23498/:23519 call the owned exact-Int adapters. The
        // C exports borrow/return their raw word carriers, never a Rust owner.
        if from_exact || (from_i64 && to_exact) {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            symbol :: if to_float -> "jet_int_owned_to_f64" else -> if to_exact -> "jet_int_owned_from_i64" else -> "jet_int_owned_to_i64"
            lower_convert_exact(&m, &f, dst, operand, symbol, to_float)
            if to_char -> lower_convert_char(&m, &f, dst)
            return
        }
        if to_float {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        return lower_alias(c, &f, instruction, operand)
    }
    // A narrow word is already its value as an exact Int, inside the inline
    // Int range; a fixed integer target took lower_convert_fixed above.
    if source == .Narrow {
        if to_float {
            operand :: lower_use(&m, &f, value) ?? return
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        if to_exact -> return lower_forward(c, &m, &f, instruction, value)
    }
    // U64 -> Int (MIRRust.rs: jet_int_owned_from_u64): a word below 2^63 is
    // the I64 widening; above it the exact value is (word & I64.MAX) + 2^63.
    if to_exact && lower_is_unsigned_word(lower_convert_type(source_type)) {
        operand :: lower_use(&m, &f, value) ?? return
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        return lower_convert_u64_exact(&m, &f, dst, operand)
    }
    // Float->integer is not a checked NumericCast producer in Jet sema:
    // Expressions/Constructors.jet:1194 and Expressions.jet:126 only widen.
    // FloatToInt uses a Prelude conversion and its fallibility instead. Do not
    // invent a saturating/trapping rule for an unreachable NumericCast pair.
    lower_fail(&m, &f, "numeric conversion from {mir_type_display_name(source_type)} to {mir_type_display_name(target)} is not lowered at O0 yet")
}

// Fixed integer to fixed integer (MIRRust.rs NumericCast: `(value) as T`).
// Rust `as` keeps the low bits of the two's-complement value: a same-width
// cast (I64 <-> U64, I32 <-> U32) reinterprets them, a narrowing cast
// truncates, a widening cast sign- or zero-extends by the source's
// signedness. Every fixed word below 64 bits is carried extended by its own
// signedness, so the result word must be re-extended by the target's unless
// the source word already is that value: a 64-bit target, or a wider target
// whose extension the source's agrees with. False when either side is not a
// fixed integer of at most 64 bits.
fn lower_convert_fixed(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, source_type: MIRType, target: MIRType) -> Bool Never! {
    if lower_convert_type(source_type).kind == .IntN(source_signed, source_bits) {
        if lower_convert_type(target).kind == .IntN(target_signed, target_bits) {
            if source_bits > 64 || target_bits > 64 -> return false
            same :: target_bits == 64 || (target_bits > source_bits && (target_signed || !source_signed)) || (target_bits == source_bits && target_signed == source_signed)
            if same {
                lower_forward(c, &m, &f, instruction, value)
                return true
            }
            operand :: lower_use(&m, &f, value) ?? return true
            dst :: lower_result(p, c, &m, &f, instruction) ?? return true
            lower_narrow_wrap(&f, dst, operand, target_signed, target_bits)
            return true
        }
    }
    false
}

// MIRRust.rs:conversion :23541-23579. The runtime symbol is called like any
// Prelude route (lower_call); a symbol the image runtime lacks is a link error.
fn lower_convert_prelude(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], call: MIRPreludeCallID, location: MIRPanicLoc, fallibility: MIRCallFallibility) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "conversion naming missing Prelude call {call.value} is not lowered at O0 yet")
    if row.member == "int_checked_fixed" {
        if c.fixed_literals.get(value.value) == .Val(word) {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Const{dst: dst, value: word})
        }
        target :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "checked wide constructor has no target")
        if lower_wide_signed(p, target) != None -> return lower_wide_checked_construct(p, c, &m, &f, instruction, value, target, location)
    }
    symbol :: lower_runtime_symbol(row)
    if (row.member == "int_try_from" || row.member == "fixed_try_from") && fallibility != MIRCallFallibility.Infallible -> return lower_convert_try_fixed(p, c, &m, &f, instruction, row.member, value, fallibility)
    if row.member == "inline_range" && fallibility != MIRCallFallibility.Infallible -> return lower_convert_inline_range(p, c, &m, &f, instruction, value, parameters)
    if row.member == "float_to_int" || row.member == "float_narrow" -> return lower_convert_checked_float(p, c, &m, &f, instruction, row.member, value, parameters, fallibility)
    if row.member == "checked_widen" -> return lower_convert_checked_widen(p, c, &m, &f, instruction, value, parameters, symbol, location, fallibility)
    // Unit conversions already name the canonical shared kernel. Their
    // checked Option/Result is the normal runtime route carrier, not a
    // backend-local rounding or failure policy.
    if row.module_name == "core.units" && fallibility == .Failure(_) {
        args := [MIRValueID]{value}
        loop parameter in parameters -> &args.push(parameter)
        return lower_route_call(p, c, &m, &f, instruction, call, args, "Prelude conversion")
    }
    if fallibility != MIRCallFallibility.Infallible || row.fallibility != MIRCallFallibility.Infallible || row.abi == MIRPreludeABI.Aggregate || row.abi == MIRPreludeABI.Control -> return lower_fail(&m, &f, "Prelude conversion {symbol} with a failure or control adapter is not lowered at O0 yet")
    operand :: lower_use(&m, &f, value) ?? return
    args := [LIRValueID]{operand}
    loop parameter in parameters {
        lowered :: lower_use(&m, &f, parameter) ?? return
        &args.push(lowered)
    }
    // MIRRust.rs:23576 appends file+line only when the row requires context;
    // the native file is a pointer+length pair, as in lower_binary.
    if row.signature.arity == args.len() + 2 {
        loop arg in lower_location(p, &m, &f, location) -> &args.push(arg)
    } else {
        if row.signature.arity != args.len() -> return lower_fail(&m, &f, "Prelude conversion {symbol} with arity {row.signature.arity} is not lowered at O0 yet")
    }
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return
    lower_call_runtime(&m, &f, symbol, args, dst)
}

// Checked integer-to-float widening (D-NUMWIDEN-CROSS1=E,
// NumericConversion.rs jet_numeric_checked_widen): an integer crosses only
// when the target holds it exactly, i.e. its magnitude without trailing zero
// bits fits the target precision (53 bits for Float, 24 for Float32);
// otherwise the program stops with the shared widening message. A fixed
// source (and an inline exact Int) is checked and converted inline: routing
// it to the runtime helper made the runtime's own `Float{raw}` widen call
// that helper, which widens through the same route forever. A big exact Int
// keeps the runtime route.
fn lower_convert_checked_widen(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], symbol: String, location: MIRPanicLoc, fallibility: MIRCallFallibility) Never! {
    unsupported :: "checked integer-to-float widening of this shape is not lowered at O0 yet"
    source :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    target :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, unsupported)
    if fallibility != .Infallible -> return lower_fail(&m, &f, unsupported)
    if lower_convert_scalar(target) != .Float && lower_convert_scalar(target) != .Float32 -> return lower_fail(&m, &f, unsupported)
    single :: lower_convert_scalar(target) == .Float32
    exact :: lower_is_exact_int(source)
    signed := true
    bits := 64
    if !exact {
        if lower_convert_type(source).kind == .IntN(source_signed, source_bits) {
            if source_bits > 64 -> return lower_fail(&m, &f, unsupported)
            signed = source_signed
            bits = source_bits
        } else {
            return lower_fail(&m, &f, unsupported)
        }
    }
    if parameters.len() != (if exact -> 1 else -> 2) -> return lower_fail(&m, &f, unsupported)
    operand :: lower_use(&m, &f, value) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    stop_at :: lower_location(p, &m, &f, location)
    // A narrow word is extended by its own signedness and below 2^63, so
    // only a 64-bit unsigned word needs the unsigned conversion.
    unsigned_word :: !signed && bits == 64
    if !exact -> return lower_widen_word(p, c, &m, &f, dst, operand, unsigned_word, single, stop_at)
    layout :: lower_value_layout(f, dst)
    no_args :: [LIRValueID]{}
    fast_block :: lower_new_block(&f)
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    fits :: lower_inline_test(&f, [LIRValueID]{operand})
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(fast_block, no_args), else_target: lower_target(slow_block, no_args)})
    lower_start(&f, fast_block, no_args)
    fast :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_widen_word(p, c, &m, &f, fast, operand, false, single, stop_at)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})
    lower_start(&f, slow_block, no_args)
    args := [LIRValueID]{operand}
    loop parameter in parameters {
        flag :: lower_use(&m, &f, parameter) ?? return
        &args.push(flag)
    }
    file :: lower_pointer(&f)
    source_path :: lower_source_path(p, m, location.file)
    path :: lower_static_text(&m, &f, source_path)
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", path, Val(file))
    &args.push(file)
    &args.push(lower_const(&f, location.line))
    slow :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    if single {
        // Precision24 acceptance returns an exactly representable f64 carrier.
        wide :: lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
        lower_call_runtime(&m, &f, symbol, args, Val(wide))
        lower_convert_f32_result(&f, slow, wide)
    } else {
        lower_call_runtime(&m, &f, symbol, args, Val(slow))
    }
    lower_call_runtime(&m, &f, "jet_rt_string_drop", [LIRValueID]{file}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

// `word` (signed, or the unsigned 64-bit word when `unsigned_word`) widened
// into `dst` after the exactness check: magnitude m, its lowest set bit
// m & -m, and m / lowbit (the magnitude without trailing zeros) must be
// below 2^precision. Zero is exact.
fn lower_widen_word(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, word: LIRValueID, unsigned_word: Bool, single: Bool, stop_at: [LIRValueID]) Never! {
    zero :: lower_const(&f, 0)
    magnitude := word
    if !unsigned_word {
        negative :: lower_numeric_compare(&f, LIRCondition.Lt, word, zero)
        negated :: lower_numeric_binary(&f, LIRBinaryOp.Sub, zero, word)
        magnitude = lower_numeric_choose(&f, negative, negated, word)
    }
    negated_magnitude :: lower_numeric_binary(&f, LIRBinaryOp.Sub, zero, magnitude)
    lowest :: lower_numeric_binary(&f, LIRBinaryOp.And, magnitude, negated_magnitude)
    is_zero :: lower_numeric_compare(&f, LIRCondition.Eq, lowest, zero)
    one :: lower_const(&f, 1)
    divisor :: lower_numeric_choose(&f, is_zero, one, lowest)
    odd :: lower_numeric_binary(&f, LIRBinaryOp.UDiv, magnitude, divisor)
    limit :: lower_const(&f, if single -> 1 << 24 else -> 1 << 53)
    inexact :: lower_numeric_compare(&f, LIRCondition.UGe, odd, limit)
    lower_numeric_check(p, Val(c), &m, &f, inexact, stop_at, "whole number cannot cross into the decimal without losing precision")
    if single {
        if unsigned_word {
            narrow :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
            lower_convert_u64_float(&f, narrow, word)
            return lower_emit(&f, LIRInst.Bitcast{dst: dst, src: narrow})
        }
        return lower_convert_f32_result(&f, dst, word)
    }
    if unsigned_word -> return lower_convert_u64_float(&f, dst, word)
    lower_emit(&f, LIRInst.Convert{dst: dst, src: word})
}

// Shared checked Float policy (NumericConversion.rs:121-141): ordered bounds
// reject NaN/infinity before any truncating machine conversion. F32 first
// widens exactly to F64, as Emit/Operations.jet:4836 does.
fn lower_convert_float_bits(f: &LowerFunction, bits: Int) -> LIRValueID Never! {
    value :: lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Const{dst: value, value: bits})
    value
}

fn lower_convert_float_word(f: &LowerFunction, value: LIRValueID, unsigned: Bool, bits: Int) -> LIRValueID Never! {
    result :: lower_word(&f)
    if !unsigned || bits < 64 {
        lower_emit(&f, LIRInst.Convert{dst: result, src: value})
        return result
    }
    // SSE's signed conversion cannot represent [2^63, 2^64). Subtract the
    // exact 2^63 first, truncate the remainder, then restore its high bit.
    half :: lower_convert_float_bits(&f, (1023 + 63) << 52)
    small :: lower_new_block(&f)
    high :: lower_new_block(&f)
    done :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    fits :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.Lt, left: value, right: half})
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(small, no_args), else_target: lower_target(high, no_args)})
    lower_start(&f, small, no_args)
    direct :: lower_word(&f)
    lower_emit(&f, LIRInst.Convert{dst: direct, src: value})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{direct})})
    lower_start(&f, high, no_args)
    remainder :: lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
    low :: lower_word(&f)
    restored :: lower_word(&f)
    sign :: lower_const(&f, -9223372036854775807 - 1)
    lower_emit(&f, LIRInst.Binary{dst: remainder, op: LIRBinaryOp.Sub, left: value, right: half})
    lower_emit(&f, LIRInst.Convert{dst: low, src: remainder})
    lower_emit(&f, LIRInst.Binary{dst: restored, op: LIRBinaryOp.Or, left: low, right: sign})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{restored})})
    lower_start(&f, done, [LIRValueID]{result})
    result
}

fn lower_convert_checked_float(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, member: String, value: MIRValueID, parameters: [MIRValueID], fallibility: MIRCallFallibility) Never! {
    unsupported :: "Prelude conversion {member} of this shape is not lowered at O0 yet"
    target :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, unsupported)
    source :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    if lower_convert_scalar(source) != .Float && lower_convert_scalar(source) != .Float32 -> return lower_fail(&m, &f, unsupported)
    if fallibility == {
        .Failure(.Result(_, _)) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    if target.kind == {
        .Result(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    ok_ty :: if target.kind == .Result(ok, _) -> ok else -> panic("checked float Result")
    err_ty :: if target.kind == .Result(_, err) -> err else -> panic("checked float Result")
    if !lower_text_type(err_ty) -> return lower_fail(&m, &f, unsupported)
    narrow :: member == "float_narrow"
    scalar :: lower_convert_type(ok_ty)
    exact :: lower_is_exact_int(ok_ty)
    signed := true
    bits := 64
    if narrow {
        if lower_convert_scalar(ok_ty) != .Float32 || parameters.len() != 0 -> return lower_fail(&m, &f, unsupported)
    } else {
        if parameters.len() != 1 -> return lower_fail(&m, &f, unsupported)
        if scalar.kind == .IntN(is_signed, width) {
            signed = is_signed
            bits = width
        } else if !exact -> return lower_fail(&m, &f, unsupported)
        if bits != 8 && bits != 16 && bits != 32 && bits != 64 -> return lower_fail(&m, &f, unsupported)
    }
    operand :: lower_use(&m, &f, value) ?? return
    floating := operand
    if lower_convert_scalar(source) == .Float32 {
        single :: lower_convert_f32_operand(&f, operand)
        floating = lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
        lower_emit(&f, LIRInst.Convert{dst: floating, src: single})
    }
    high_bits :: if narrow -> ((1023 + 127) << 52).bit_or((((1 << 23) - 1) << 29)) else -> (1023 + bits - (if signed -> 1 else -> 0)) << 52
    high :: lower_convert_float_bits(&f, high_bits)
    low :: lower_convert_float_bits(&f, if narrow || signed -> high_bits.bit_or((-9223372036854775807 - 1)) else -> 0)
    above :: lower_flag(&f)
    below :: lower_flag(&f)
    fits :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: above, condition: LIRCondition.Ge, left: floating, right: low})
    lower_emit(&f, LIRInst.Compare{dst: below, condition: if narrow -> LIRCondition.Le else -> LIRCondition.Lt, left: floating, right: high})
    lower_logic(&f, fits, true, above, below)
    ok_block :: lower_new_block(&f)
    err_block :: lower_new_block(&f)
    done :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(ok_block, no_args), else_target: lower_target(err_block, no_args)})
    lower_start(&f, ok_block, no_args)
    converted :: if {
        narrow -> {
            raw :: lower_word(&f)
            lower_convert_f32_result(&f, raw, floating)
            raw
        }
        else -> {
            word :: lower_convert_float_word(&f, floating, !signed, bits)
            if exact -> {
                owned :: lower_word(&f)
                lower_convert_exact(&m, &f, owned, word, "jet_int_owned_from_i64", false)
                owned
            } else -> word
        }
    }
    ok_box :: lower_pointer(&f)
    lower_alloc(&m, &f, ok_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, ok_box, 0, lower_result_selector(true))
    lower_write_at(p, &f, ok_box, lower_result_payload_offset(), converted, ok_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{ok_box})})
    lower_start(&f, err_block, no_args)
    err_box :: lower_pointer(&f)
    lower_alloc(&m, &f, err_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, err_box, 0, lower_result_selector(false))
    text :: lower_pointer(&f)
    message :: lower_static_text(&m, &f, if narrow -> "value doesn't fit in F32" else -> "value doesn't fit in destination type")
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", message, Val(text))
    lower_write_at(p, &f, err_box, lower_result_payload_offset(), text, err_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{err_box})})
    lower_start(&f, done, [LIRValueID]{dst})
}

// MIRRust.rs numeric_conversion `inline_range` from an exact Int: the
// jet_int_owned_inline_range adapter (C export jet_inline_range_from_int,
// Result{exact Int, Text}) checks the interval; its Text error converts into
// the target's String error, the route's own Result carrier.
fn lower_convert_inline_range(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID]) Never! {
    unsupported :: "Prelude conversion inline_range of this shape is not lowered at O0 yet"
    source_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    if !lower_is_exact_int(source_ty) || parameters.len() != 2 -> return lower_fail(&m, &f, unsupported)
    route :: lower_runtime_route("jet_inline_range_from_int") ?? return lower_fail(&m, &f, unsupported)
    lowered := [LIRValueID]{}
    operand :: lower_use(&m, &f, value) ?? return
    &lowered.push(operand)
    loop parameter in parameters {
        bound_ty :: lower_value_type(c, parameter) ?? return lower_fail(&m, &f, unsupported)
        if lower_repr(p, bound_ty) != .Word || lower_is_exact_int(bound_ty) -> return lower_fail(&m, &f, unsupported)
        bound :: lower_use(&m, &f, parameter) ?? return
        &lowered.push(bound)
    }
    lower_route_result(p, c, &m, &f, instruction, route, lowered, "Prelude conversion", "inline_range", [String]{})
}

// MIRRust.rs numeric_conversion for `int_try_from` / `fixed_try_from` with a
// Result carrier: Ok(value) when the exact or fixed-width source fits the
// target's fixed-width range (NumericConversion.rs jet_numeric_fixed_from_i128,
// the host-kind table the kind parameter selects is the target's own width),
// else Err of the shared JET_NUMERIC_CONVERSION_ERROR text.
fn lower_convert_try_fixed(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, member: String, value: MIRValueID, fallibility: MIRCallFallibility) Never! {
    target :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Prelude conversion {member} without a checked result type is not lowered at O0 yet")
    unsupported :: "Prelude conversion {member} into {mir_type_display_name(target)} is not lowered at O0 yet"
    carrier :: if fallibility == {
        .Failure(failure) -> failure
        else -> {
            lower_fail(&m, &f, unsupported)
            return
        }
    }
    if carrier == {
        .Result(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    if target.kind == {
        .Result(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    ok_ty :: if target.kind == .Result(success, _) -> success else -> panic("checked Result conversion shape")
    err_ty :: if target.kind == .Result(_, failure) -> failure else -> panic("checked Result conversion shape")
    if !lower_text_type(err_ty) -> return lower_fail(&m, &f, unsupported)
    if lower_convert_type(ok_ty).kind == {
        .IntN(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    t_signed :: if lower_convert_type(ok_ty).kind == .IntN(signed, _) -> signed else -> panic("checked IntN conversion shape")
    t_bits :: if lower_convert_type(ok_ty).kind == .IntN(_, bits) -> bits else -> panic("checked IntN conversion shape")
    if t_bits < 1 || t_bits > 64 -> return lower_fail(&m, &f, unsupported)
    source_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    exact :: member == "int_try_from"
    source_u64 := false
    if exact {
        if !lower_is_exact_int(source_ty) -> return lower_fail(&m, &f, unsupported)
    } else {
        source :: lower_convert_type(source_ty)
        if source.kind == {
            .IntN(_, _) -> {}
            else -> return lower_fail(&m, &f, unsupported)
        }
        if source.kind == .IntN(signed, bits) {
            if bits > 64 -> return lower_fail(&m, &f, unsupported)
            source_u64 = !signed && bits == 64
        }
    }
    operand :: lower_use(&m, &f, value) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    no_args :: [LIRValueID]{}
    ok_block :: lower_new_block(&f)
    err_block :: lower_new_block(&f)
    done :: lower_new_block(&f)
    if exact {
        small :: lower_new_block(&f)
        big :: lower_new_block(&f)
        inline :: lower_inline_test(&f, [LIRValueID]{operand})
        lower_seal(&f, LIRTerminator.Branch{condition: inline, then_target: lower_target(small, no_args), else_target: lower_target(big, no_args)})
        lower_start(&f, big, no_args)
        lower_convert_try_big(&m, &f, operand, t_signed, t_bits, ok_block, err_block)
        lower_start(&f, small, no_args)
    }
    fits :: lower_convert_fits(&f, operand, source_u64, t_signed, t_bits)
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(ok_block, [LIRValueID]{operand}), else_target: lower_target(err_block, no_args)})
    word :: lower_word(&f)
    lower_start(&f, ok_block, [LIRValueID]{word})
    ok_box :: lower_pointer(&f)
    lower_alloc(&m, &f, ok_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, ok_box, 0, lower_result_selector(true))
    lower_write_at(p, &f, ok_box, lower_result_payload_offset(), word, ok_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{ok_box})})
    lower_start(&f, err_block, no_args)
    err_box :: lower_pointer(&f)
    lower_alloc(&m, &f, err_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, err_box, 0, lower_result_selector(false))
    text :: lower_pointer(&f)
    message :: lower_static_text(&m, &f, "value doesn't fit in destination type")
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", message, Val(text))
    lower_write_at(p, &f, err_box, lower_result_payload_offset(), text, err_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{err_box})})
    lower_start(&f, done, [LIRValueID]{dst})
}

// Whether a word source fits a `t_bits`-wide target: the source is the
// signed (or narrow, already extended) word value, or a U64's raw bits.
fn lower_convert_fits(f: &LowerFunction, word: LIRValueID, source_u64: Bool, t_signed: Bool, t_bits: Int) -> LIRValueID Never! {
    fits :: lower_flag(&f)
    if t_bits == 64 && t_signed == !source_u64 {
        lower_emit(&f, LIRInst.Const{dst: fits, value: 1})
    } else if t_bits == 64 {
        // I64 -> U64: non-negative; U64 -> I64: at most I64.MAX.
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.Ge, left: word, right: zero})
    } else if t_signed && !source_u64 {
        // lo <= v <= hi as one unsigned test of v - lo against hi - lo.
        low :: lower_const(&f, 0 - (1 << (t_bits - 1)))
        span :: lower_const(&f, (1 << t_bits) - 1)
        offset :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Sub, left: word, right: low})
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.ULe, left: offset, right: span})
    } else {
        // An unsigned compare folds a negative source into the miss.
        high :: lower_const(&f, if t_signed -> (1 << (t_bits - 1)) - 1 else -> (1 << t_bits) - 1)
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.ULe, left: word, right: high})
    }
    fits
}

// A spilled exact Int (|x| >= 2^62) fits only a 64-bit target; its word is
// the I64 value, or for a U64 above I64.MAX the bits of x - 2^64.
fn lower_convert_try_big(m: &LowerModule, f: &LowerFunction, value: LIRValueID, t_signed: Bool, t_bits: Int, ok_block: LIRBlockID, err_block: LIRBlockID) Never! {
    no_args :: [LIRValueID]{}
    if t_bits < 64 -> return lower_seal(&f, LIRTerminator.Jump{target: lower_target(err_block, no_args)})
    low :: lower_word(&f)
    lower_big_int_constant(&m, &f, low, if t_signed -> "-9223372036854775808" else -> "0")
    high :: lower_word(&f)
    lower_big_int_constant(&m, &f, high, if t_signed -> "9223372036854775807" else -> "18446744073709551615")
    above :: lower_flag(&f)
    lower_exact_compare(&m, &f, above, LIRCondition.Ge, value, low)
    below :: lower_flag(&f)
    lower_exact_compare(&m, &f, below, LIRCondition.Le, value, high)
    fits :: lower_flag(&f)
    lower_logic(&f, fits, true, above, below)
    convert :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(convert, no_args), else_target: lower_target(err_block, no_args)})
    lower_start(&f, convert, no_args)
    if t_signed {
        word :: lower_word(&f)
        lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{value}, Val(word))
        return lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{word})})
    }
    signed_max :: lower_word(&f)
    lower_big_int_constant(&m, &f, signed_max, "9223372036854775807")
    low_half :: lower_flag(&f)
    lower_exact_compare(&m, &f, low_half, LIRCondition.Le, value, signed_max)
    direct :: lower_new_block(&f)
    wrapped :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: low_half, then_target: lower_target(direct, no_args), else_target: lower_target(wrapped, no_args)})
    lower_start(&f, direct, no_args)
    word :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{value}, Val(word))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{word})})
    lower_start(&f, wrapped, no_args)
    modulus :: lower_word(&f)
    lower_big_int_constant(&m, &f, modulus, "18446744073709551616")
    shifted :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_sub", [LIRValueID]{value, modulus}, Val(shifted))
    bits :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{shifted}, Val(bits))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{bits})})
}

fn lower_convert(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], target: MIRType, conversion: MIRConversion) Never! {
    if conversion == {
        .Transparent -> lower_forward(c, &m, &f, instruction, value)
        .NumericCast -> {
            if parameters.len() != 0 -> return lower_fail(&m, &f, "numeric conversion with parameters is not lowered at O0 yet")
            lower_convert_numeric(p, c, &m, &f, instruction, value, target)
        }
        .Prelude(call, location, fallibility) -> lower_convert_prelude(p, c, &m, &f, instruction, value, parameters, call, location, fallibility)
        // MIRRust: a SendFn conversion retypes the same closure box.
        .SendFn -> lower_forward(c, &m, &f, instruction, value)
    }
}
