// MIR conversions at O0: transparent forwards, supported scalar numeric casts,
// and Prelude calls with the same carrier ABI in static and hosted runtimes.
// Exact Int remains a signed inline word or a tagged big-integer handle: never
// feed the latter to a machine conversion or reinterpret it as an I64/Char.
use jet_foundation.[
    MIRCallFallibility,
    MIRConversion,
    MIRInstruction,
    MIRPanicLoc,
    MIRPreludeABI,
    MIRPreludeCallID,
    MIRProgram,
    MIRType,
    MIRValueID,
    mir_type_display_name,
]

fn lower_convert_type(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .Tagged(_, inner) -> lower_convert_type(inner)
        .InlineRange(base, _, _) -> lower_convert_type(base)
        .Quantity(base, _) -> lower_convert_type(base)
        else -> ty
    }
}

// Like lower_exact_arithmetic, eligibility selects only the machine fast path.
// The runtime, not lowering, decides what a tagged Int / wide I64 means.
fn lower_convert_exact(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID, symbol: String, to_float: Bool) Never! {
    fast_block :: lower_new_block(&f)
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    layout :: lower_value_layout(f, dst)
    fits :: lower_inline_test(&f, [LIRValueID]{value})
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(fast_block, no_args), else_target: lower_target(slow_block, no_args)})
    lower_start(&f, fast_block, no_args)
    fast :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    if to_float {
        lower_emit(&f, LIRInst.Convert{dst: fast, src: value})
    } else {
        lower_emit(&f, LIRInst.Move{dst: fast, src: value})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})
    lower_start(&f, slow_block, no_args)
    slow :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{value}, Val(slow))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_convert_u64_exact(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID) Never! {
    no_args :: [LIRValueID]{}
    small_block :: lower_new_block(&f)
    large_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    zero :: lower_const(&f, 0)
    signed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: signed, condition: LIRCondition.Ge, left: value, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: signed, then_target: lower_target(small_block, no_args), else_target: lower_target(large_block, no_args)})
    lower_start(&f, small_block, no_args)
    small :: lower_word(&f)
    lower_convert_exact(&m, &f, small, value, "jet_int_owned_from_i64", false)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{small})})
    lower_start(&f, large_block, no_args)
    mask :: lower_const(&f, 9223372036854775807)
    low :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: low, op: LIRBinaryOp.And, left: value, right: mask})
    low_int :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_from_i64", [LIRValueID]{low}, Val(low_int))
    half :: lower_word(&f)
    two_pow_63 :: lower_static_text(&m, &f, "9223372036854775808")
    lower_call_runtime(&m, &f, "jet_rt_int_from_static", two_pow_63, Val(half))
    large :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_add", [LIRValueID]{low_int, half}, Val(large))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{large})})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_convert_char(m: &LowerModule, f: &LowerFunction, value: LIRValueID) Never! {
    // A Char is a Unicode scalar, not an arbitrary word: exclude surrogates as
    // well as negative / > U+10FFFF values (MIRRust.rs:21388 char::from_u32).
    // Unsigned compares fold the negative case into each range test: one
    // `value > U+10FFFF` and one `value - U+D800 <= 0x7FF` (surrogates).
    maximum :: lower_const(&f, 1114111)
    too_large :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: too_large, condition: LIRCondition.UGt, left: value, right: maximum})
    lower_check(&m, &f, too_large, "jet_rt_panic_overflow")
    first_surrogate :: lower_const(&f, 55296)
    offset :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Sub, left: value, right: first_surrogate})
    surrogate_span :: lower_const(&f, 2047)
    surrogate :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: surrogate, condition: LIRCondition.ULe, left: offset, right: surrogate_span})
    lower_check(&m, &f, surrogate, "jet_rt_panic_overflow")
}

// The scalar a NumericCast operand is carried as. Narrow is a fixed-width
// integer below 64 bits, already sign- or zero-extended in its word.
enum LowerScalar { Exact I64 Narrow Float Char Other }

fn lower_convert_scalar(ty: MIRType) -> LowerScalar Never! {
    if lower_convert_type(ty).kind == {
        .Int -> LowerScalar.Exact
        .IntN(signed, bits) -> if bits < 64 -> LowerScalar.Narrow else -> if signed -> LowerScalar.I64 else -> LowerScalar.Other
        .Float -> LowerScalar.Float
        .Char -> LowerScalar.Char
        else -> LowerScalar.Other
    }
}

fn lower_convert_numeric(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, target: MIRType) Never! {
    source_type :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "numeric conversion without a checked source type is not lowered at O0 yet")
    source :: lower_convert_scalar(source_type)
    destination :: lower_convert_scalar(target)
    from_exact :: source == .Exact
    to_exact :: destination == .Exact
    from_i64 :: source == .I64
    to_i64 :: destination == .I64
    from_float :: source == .Float
    to_float :: destination == .Float
    from_char :: source == .Char
    to_char :: destination == .Char
    if source != .Other && source == destination -> return lower_forward(c, &m, &f, instruction, value)
    if (from_exact && (to_i64 || to_float || to_char)) || (from_i64 && (to_exact || to_float)) || (from_char && to_exact) {
        operand :: lower_use(&m, &f, value) ?? return
        // MIRRust.rs:23498/:23519 call the owned exact-Int adapters. The
        // C exports borrow/return their raw word carriers, never a Rust owner.
        if from_exact || (from_i64 && to_exact) {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            symbol :: if to_float -> "jet_int_owned_to_f64" else -> if to_exact -> "jet_int_owned_from_i64" else -> "jet_int_owned_to_i64"
            lower_convert_exact(&m, &f, dst, operand, symbol, to_float)
            if to_char -> lower_convert_char(&m, &f, dst)
            return
        }
        if to_float {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        return lower_alias(c, &f, instruction, operand)
    }
    // Sema only widens (Expressions/Constructors.jet:1194): a narrow word is
    // already its value as any wider integer, and inside the inline Int range.
    if source == .Narrow {
        if to_float {
            operand :: lower_use(&m, &f, value) ?? return
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            return lower_emit(&f, LIRInst.Convert{dst: dst, src: operand})
        }
        if to_exact || to_i64 || destination == .Narrow || lower_is_unsigned_word(target) -> return lower_forward(c, &m, &f, instruction, value)
    }
    // U64 -> Int (MIRRust.rs: jet_int_owned_from_u64): a word below 2^63 is
    // the I64 widening; above it the exact value is (word & I64.MAX) + 2^63.
    if to_exact && lower_is_unsigned_word(lower_convert_type(source_type)) {
        operand :: lower_use(&m, &f, value) ?? return
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        return lower_convert_u64_exact(&m, &f, dst, operand)
    }
    // Float->integer is not a checked NumericCast producer in Jet sema:
    // Expressions/Constructors.jet:1194 and Expressions.jet:126 only widen.
    // FloatToInt uses a Prelude conversion and its fallibility instead. Do not
    // invent a saturating/trapping rule for an unreachable NumericCast pair.
    lower_fail(&m, &f, "numeric conversion from {mir_type_display_name(source_type)} to {mir_type_display_name(target)} is not lowered at O0 yet")
}

// MIRRust.rs:conversion :23541-23579. The runtime symbol is called like any
// Prelude route (lower_call); a symbol the image runtime lacks is a link error.
fn lower_convert_prelude(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], call: MIRPreludeCallID, location: MIRPanicLoc, fallibility: MIRCallFallibility) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "conversion naming missing Prelude call {call.value} is not lowered at O0 yet")
    symbol :: lower_runtime_symbol(row)
    if (row.member == "int_try_from" || row.member == "fixed_try_from") && fallibility != MIRCallFallibility.Infallible -> return lower_convert_try_fixed(p, c, &m, &f, instruction, row.member, value, fallibility)
    if row.member == "inline_range" && fallibility != MIRCallFallibility.Infallible -> return lower_convert_inline_range(p, c, &m, &f, instruction, value, parameters)
    // Unit conversions already name the canonical shared kernel. Their
    // checked Option/Result is the normal runtime route carrier, not a
    // backend-local rounding or failure policy.
    if row.module_name == "core.units" && fallibility == .Failure(_) {
        args := [MIRValueID]{value}
        loop parameter in parameters -> &args.push(parameter)
        return lower_route_call(p, c, &m, &f, instruction, call, args, "Prelude conversion")
    }
    if fallibility != MIRCallFallibility.Infallible || row.fallibility != MIRCallFallibility.Infallible || row.abi == MIRPreludeABI.Aggregate || row.abi == MIRPreludeABI.Control -> return lower_fail(&m, &f, "Prelude conversion {symbol} with a failure or control adapter is not lowered at O0 yet")
    operand :: lower_use(&m, &f, value) ?? return
    args := [LIRValueID]{operand}
    loop parameter in parameters {
        lowered :: lower_use(&m, &f, parameter) ?? return
        &args.push(lowered)
    }
    // MIRRust.rs:23576 appends file+line only when the row requires context;
    // the native file is a pointer+length pair, as in lower_binary.
    if row.signature.arity == args.len() + 2 {
        loop arg in lower_location(p, &m, &f, location) -> &args.push(arg)
    } else {
        if row.signature.arity != args.len() -> return lower_fail(&m, &f, "Prelude conversion {symbol} with arity {row.signature.arity} is not lowered at O0 yet")
    }
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return
    lower_call_runtime(&m, &f, symbol, args, dst)
}

// MIRRust.rs numeric_conversion `inline_range` from an exact Int: the
// jet_int_owned_inline_range adapter (C export jet_inline_range_from_int,
// Result{exact Int, Text}) checks the interval; its Text error converts into
// the target's String error, the route's own Result carrier.
fn lower_convert_inline_range(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID]) Never! {
    unsupported :: "Prelude conversion inline_range of this shape is not lowered at O0 yet"
    source_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    if !lower_is_exact_int(source_ty) || parameters.len() != 2 -> return lower_fail(&m, &f, unsupported)
    route :: lower_runtime_route("jet_inline_range_from_int") ?? return lower_fail(&m, &f, unsupported)
    lowered := [LIRValueID]{}
    operand :: lower_use(&m, &f, value) ?? return
    &lowered.push(operand)
    loop parameter in parameters {
        bound_ty :: lower_value_type(c, parameter) ?? return lower_fail(&m, &f, unsupported)
        if lower_repr(p, bound_ty) != .Word || lower_is_exact_int(bound_ty) -> return lower_fail(&m, &f, unsupported)
        bound :: lower_use(&m, &f, parameter) ?? return
        &lowered.push(bound)
    }
    lower_route_result(p, c, &m, &f, instruction, route, lowered, "Prelude conversion", "inline_range")
}

// MIRRust.rs numeric_conversion for `int_try_from` / `fixed_try_from` with a
// Result carrier: Ok(value) when the exact or fixed-width source fits the
// target's fixed-width range (NumericConversion.rs jet_numeric_fixed_from_i128,
// the host-kind table the kind parameter selects is the target's own width),
// else Err of the shared JET_NUMERIC_CONVERSION_ERROR text.
fn lower_convert_try_fixed(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, member: String, value: MIRValueID, fallibility: MIRCallFallibility) Never! {
    target :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Prelude conversion {member} without a checked result type is not lowered at O0 yet")
    unsupported :: "Prelude conversion {member} into {mir_type_display_name(target)} is not lowered at O0 yet"
    carrier :: if fallibility == {
        .Failure(failure) -> failure
        else -> {
            lower_fail(&m, &f, unsupported)
            return
        }
    }
    if carrier == {
        .Result(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    if target.kind == {
        .Result(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    ok_ty :: if target.kind == .Result(success, _) -> success else -> panic("checked Result conversion shape")
    err_ty :: if target.kind == .Result(_, failure) -> failure else -> panic("checked Result conversion shape")
    if !lower_text_type(err_ty) -> return lower_fail(&m, &f, unsupported)
    if lower_convert_type(ok_ty).kind == {
        .IntN(_, _) -> {}
        else -> return lower_fail(&m, &f, unsupported)
    }
    t_signed :: if lower_convert_type(ok_ty).kind == .IntN(signed, _) -> signed else -> panic("checked IntN conversion shape")
    t_bits :: if lower_convert_type(ok_ty).kind == .IntN(_, bits) -> bits else -> panic("checked IntN conversion shape")
    if t_bits < 1 || t_bits > 64 -> return lower_fail(&m, &f, unsupported)
    source_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, unsupported)
    exact :: member == "int_try_from"
    source_u64 := false
    if exact {
        if !lower_is_exact_int(source_ty) -> return lower_fail(&m, &f, unsupported)
    } else {
        source :: lower_convert_type(source_ty)
        if source.kind == {
            .IntN(_, _) -> {}
            else -> return lower_fail(&m, &f, unsupported)
        }
        if source.kind == .IntN(signed, bits) {
            if bits > 64 -> return lower_fail(&m, &f, unsupported)
            source_u64 = !signed && bits == 64
        }
    }
    operand :: lower_use(&m, &f, value) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    no_args :: [LIRValueID]{}
    ok_block :: lower_new_block(&f)
    err_block :: lower_new_block(&f)
    done :: lower_new_block(&f)
    if exact {
        small :: lower_new_block(&f)
        big :: lower_new_block(&f)
        inline :: lower_inline_test(&f, [LIRValueID]{operand})
        lower_seal(&f, LIRTerminator.Branch{condition: inline, then_target: lower_target(small, no_args), else_target: lower_target(big, no_args)})
        lower_start(&f, big, no_args)
        lower_convert_try_big(&m, &f, operand, t_signed, t_bits, ok_block, err_block)
        lower_start(&f, small, no_args)
    }
    fits :: lower_convert_fits(&f, operand, source_u64, t_signed, t_bits)
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(ok_block, [LIRValueID]{operand}), else_target: lower_target(err_block, no_args)})
    word :: lower_word(&f)
    lower_start(&f, ok_block, [LIRValueID]{word})
    ok_box :: lower_pointer(&f)
    lower_alloc(&m, &f, ok_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, ok_box, 0, 1)
    lower_write_at(p, &f, ok_box, 8, word, ok_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{ok_box})})
    lower_start(&f, err_block, no_args)
    err_box :: lower_pointer(&f)
    lower_alloc(&m, &f, err_box, lower_result_box_size(p, ok_ty, err_ty))
    lower_store_word(&f, err_box, 0, 0)
    text :: lower_pointer(&f)
    message :: lower_static_text(&m, &f, "value doesn't fit in destination type")
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", message, Val(text))
    lower_write_at(p, &f, err_box, 8, text, err_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{err_box})})
    lower_start(&f, done, [LIRValueID]{dst})
}

// Whether a word source fits a `t_bits`-wide target: the source is the
// signed (or narrow, already extended) word value, or a U64's raw bits.
fn lower_convert_fits(f: &LowerFunction, word: LIRValueID, source_u64: Bool, t_signed: Bool, t_bits: Int) -> LIRValueID Never! {
    fits :: lower_flag(&f)
    if t_bits == 64 && t_signed == !source_u64 {
        lower_emit(&f, LIRInst.Const{dst: fits, value: 1})
    } else if t_bits == 64 {
        // I64 -> U64: non-negative; U64 -> I64: at most I64.MAX.
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.Ge, left: word, right: zero})
    } else if t_signed && !source_u64 {
        // lo <= v <= hi as one unsigned test of v - lo against hi - lo.
        low :: lower_const(&f, 0 - (1 << (t_bits - 1)))
        span :: lower_const(&f, (1 << t_bits) - 1)
        offset :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: offset, op: LIRBinaryOp.Sub, left: word, right: low})
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.ULe, left: offset, right: span})
    } else {
        // An unsigned compare folds a negative source into the miss.
        high :: lower_const(&f, if t_signed -> (1 << (t_bits - 1)) - 1 else -> (1 << t_bits) - 1)
        lower_emit(&f, LIRInst.Compare{dst: fits, condition: LIRCondition.ULe, left: word, right: high})
    }
    fits
}

// A spilled exact Int (|x| >= 2^62) fits only a 64-bit target; its word is
// the I64 value, or for a U64 above I64.MAX the bits of x - 2^64.
fn lower_convert_try_big(m: &LowerModule, f: &LowerFunction, value: LIRValueID, t_signed: Bool, t_bits: Int, ok_block: LIRBlockID, err_block: LIRBlockID) Never! {
    no_args :: [LIRValueID]{}
    if t_bits < 64 -> return lower_seal(&f, LIRTerminator.Jump{target: lower_target(err_block, no_args)})
    low :: lower_word(&f)
    lower_big_int_constant(&m, &f, low, if t_signed -> "-9223372036854775808" else -> "0")
    high :: lower_word(&f)
    lower_big_int_constant(&m, &f, high, if t_signed -> "9223372036854775807" else -> "18446744073709551615")
    above :: lower_flag(&f)
    lower_exact_compare(&m, &f, above, LIRCondition.Ge, value, low)
    below :: lower_flag(&f)
    lower_exact_compare(&m, &f, below, LIRCondition.Le, value, high)
    fits :: lower_flag(&f)
    lower_logic(&f, fits, true, above, below)
    convert :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(convert, no_args), else_target: lower_target(err_block, no_args)})
    lower_start(&f, convert, no_args)
    if t_signed {
        word :: lower_word(&f)
        lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{value}, Val(word))
        return lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{word})})
    }
    signed_max :: lower_word(&f)
    lower_big_int_constant(&m, &f, signed_max, "9223372036854775807")
    low_half :: lower_flag(&f)
    lower_exact_compare(&m, &f, low_half, LIRCondition.Le, value, signed_max)
    direct :: lower_new_block(&f)
    wrapped :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: low_half, then_target: lower_target(direct, no_args), else_target: lower_target(wrapped, no_args)})
    lower_start(&f, direct, no_args)
    word :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{value}, Val(word))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{word})})
    lower_start(&f, wrapped, no_args)
    modulus :: lower_word(&f)
    lower_big_int_constant(&m, &f, modulus, "18446744073709551616")
    shifted :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_sub", [LIRValueID]{value, modulus}, Val(shifted))
    bits :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{shifted}, Val(bits))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ok_block, [LIRValueID]{bits})})
}

fn lower_convert(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, parameters: [MIRValueID], target: MIRType, conversion: MIRConversion) Never! {
    if conversion == {
        .Transparent -> lower_forward(c, &m, &f, instruction, value)
        .NumericCast -> {
            if parameters.len() != 0 -> return lower_fail(&m, &f, "numeric conversion with parameters is not lowered at O0 yet")
            lower_convert_numeric(p, c, &m, &f, instruction, value, target)
        }
        .Prelude(call, location, fallibility) -> lower_convert_prelude(p, c, &m, &f, instruction, value, parameters, call, location, fallibility)
        // MIRRust: a SendFn conversion retypes the same closure box.
        .SendFn -> lower_forward(c, &m, &f, instruction, value)
    }
}
