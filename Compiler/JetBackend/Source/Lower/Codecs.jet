// Checked codec intrinsic dispatch. Reuses the selected-method discovery from
// BackendBoost2 (52f103e67), not its unwired runtime/container policy. User and
// compiler-generated implementations remain ordinary monomorphic Jet methods;
// scalar adapters invoke the canonical runtime traits without a second codec.
use jet_foundation.[MIRCallArg, MIRFunctionID, MIRInstruction, MIRMeasure, MIRNominalRef, MIRPreludeCallID, MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_measure_literal_value, mir_type_display_name, mir_type_from_kind, mir_type_same_checked_type]

struct LowerCodecMethod { function: MIRFunctionID, owner: MIRType }

fn lower_codec_method(p: MIRProgram, ty: MIRType, encode: Bool) -> LowerCodecMethod? Never! {
    selected := LowerCodecMethod?{None}
    codec :: if encode -> "Encode" else -> "Decode"
    loop implementation in p.impls {
        trait_ref :: implementation.trait_ref ?? next
        if trait_ref.name != codec -> next
        if !implementation.target_applicability.rust_aot -> next
        if implementation.target_os == .Val(os) {
            name :: if os == {
                .Linux -> "linux"
                .MacOS -> "macos"
                .Windows -> "windows"
            }
            if name != p.facts.active_os -> next
        }
        if !mir_type_same_checked_type(implementation.self_type, ty) && !lower_nominal_impl_template(p, implementation.self_type, ty) -> next
        loop id in implementation.methods {
            loop function in p.functions {
                if function.id != id || function.name != (if encode -> "encode" else -> "decode") -> next
                if selected != None -> return None
                selected = Val(LowerCodecMethod{function: id, owner: ty})
            }
        }
    }
    selected
}

fn lower_codec_reach(p: MIRProgram, q: &LowerPrepared, route: MIRPreludeCallID, types: [MIRType], parent: Int, site: String) Never! {
    row :: lower_prepared_prelude_row(p, q, route) ?? return
    if types.len() != 1 -> return
    encode :: row.module_name == "core.encoding.codec" && row.member == "encode"
    decode :: (row.module_name == "core.encoding.codec" && (row.member == "decode" || row.member == "decode_typed"))
        || (row.module_name.starts_with("core.encoding.") && row.member == "decode")
        || (row.module_name == "core.sys" && row.member == "decode")
    if !encode && !decode -> return
    lower_codec_reach_type(p, &q, types[0], encode, parent, site)
}

// A container's element and value codecs are selected like the outer one
// (lower_codec_decode_into / lower_codec_encode_into), so their selected
// methods are reached with it.
fn lower_codec_reach_type(p: MIRProgram, q: &LowerPrepared, ty: MIRType, encode: Bool, parent: Int, site: String) Never! {
    if lower_codec_method(p, ty, encode) == .Val(method) {
        lower_mono_request(p, &q, method.function, Val(method.owner), [MIRType]{}, parent, site).drop("selected codec method")
        return
    }
    if ty.kind == {
        .List(elem) | .FixedList(elem, _) | .Option(elem) -> lower_codec_reach_type(p, &q, elem, encode, parent, site)
        .Map(_, value) -> lower_codec_reach_type(p, &q, value, encode, parent, site)
        else -> {}
    }
}

fn lower_codec_scalar(ty: MIRType) -> String? Never! {
    if ty.kind == {
        .Int -> Val("Int")
        .Bool -> Val("Bool")
        .Float -> Val("Float")
        .String -> Val("String")
        .Char -> Val("Char")
        .IntN(signed, bits) -> {
            if bits != 8 && bits != 16 && bits != 32 && bits != 64 -> return None
            prefix :: if signed -> "I" else -> "U"
            Val("{prefix}{bits}")
        }
        else -> None
    }
}


fn lower_codec_method_call(p: MIRProgram, m: &LowerModule, f: &LowerFunction, method: LowerCodecMethod, source: LIRValueID, dst: LIRValueID) Never! {
    target :: lower_instance_id(method.function, lower_call_bindings(Val(method.owner), [MIRType]{}))
    index :: lower_function_index(m, target)
    if index < 0 -> return lower_fail(&m, &f, "selected codec method {target.value} was not reached")
    signature :: m.mir_signatures[index].copy()
    result_bytes :: m.mir_results[index].copy()
    if result_bytes > 0 {
        lower_emit(&f, LIRInst.StackSlot{dst: dst, size: result_bytes, align: 8})
        lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: LIRFunctionID{value: index}}, args: [LIRValueID]{dst, source}})
    } else {
        lower_emit(&f, LIRInst.Call{dst: Val(dst), signature: signature, callee: LIRCallee.Function{id: LIRFunctionID{value: index}}, args: [LIRValueID]{source}})
    }
}

fn lower_codec_decode_into(p: MIRProgram, m: &LowerModule, f: &LowerFunction, target: MIRType, result: MIRType, tree: MIRType, source: LIRValueID, dst: LIRValueID) Never! {
    if lower_codec_method(p, target, false) == .Val(method) {
        // Callers take the decoded value out of this Result by bytes and free
        // its shell: a user method's Result may be shared (lower_box_owned).
        called :: lower_pointer(&f)
        lower_codec_method_call(p, &m, &f, method, source, called)
        owned :: lower_box_owned(p, &m, &f, called, result)
        return lower_emit(&f, LIRInst.Move{dst: dst, src: owned})
    }
    if lower_codec_container(p, target) -> return lower_call_helper(&m, &f, "codec.decode", result, [LIRValueID]{source}, Val(dst))
    scalar :: lower_codec_scalar(target) ?? return lower_fail(&m, &f, "Decode<{mir_type_display_name(target)}> has no reachable selected method or canonical scalar carrier")
    route :: lower_runtime_route("jet_rt_codec_decode_{runtime_abi_atom(scalar)}") ?? return lower_fail(&m, &f, "canonical scalar Decode adapter is missing")
    if !lower_route_shape_matches(p, result, route.result) -> return lower_fail(&m, &f, "canonical scalar Decode result does not match checked FieldError storage")
    runtime :: lower_dyn_to_runtime(p, &m, &f, tree, source) ?? return
    if route.result == .Result(ok, err) {
        out :: lower_route_result_call(&m, &f, route.export, [LIRValueID]{runtime}, ok, err)
        lower_alloc(&m, &f, dst, lower_box_size(p, result))
        lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: out.word})
        errors :: if result.kind == .Result(_, failure) -> failure else -> panic("checked Decode Result")
        success :: lower_new_block(&f)
        failure :: lower_new_block(&f)
        merge :: lower_new_block(&f)
        yes :: lower_flag(&f)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: yes, condition: LIRCondition.Ne, left: out.word, right: zero})
        lower_seal(&f, LIRTerminator.Branch{condition: yes, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
        lower_start(&f, success, [LIRValueID]{})
        lower_route_store_payload(p, &m, &f, dst, lower_result_payload_offset(), target, ok, out.slot)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
        lower_start(&f, failure, [LIRValueID]{})
        lower_route_store_payload(p, &m, &f, dst, lower_result_payload_offset(), errors, err, out.slot)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
        lower_start(&f, merge, [LIRValueID]{})
    }
    lower_call_runtime(&m, &f, "jet_rt_handle_drop_dyn", [LIRValueID]{runtime}, None)
}

// Defines `dst` as the owned native Dyn `target`'s Encode produces for the
// borrowed `source`: its selected method, a container's "codec.encode"
// helper, or the canonical scalar adapter.
fn lower_codec_encode_into(p: MIRProgram, m: &LowerModule, f: &LowerFunction, target: MIRType, tree: MIRType, source: LIRValueID, dst: LIRValueID) Never! {
    if lower_codec_method(p, target, true) == .Val(method) -> return lower_codec_method_call(p, &m, &f, method, source, dst)
    if lower_codec_container(p, target) -> return lower_call_helper(&m, &f, "codec.encode", target, [LIRValueID]{source}, Val(dst))
    scalar :: lower_codec_scalar(target) ?? return lower_fail(&m, &f, "Encode<{mir_type_display_name(target)}> has no reachable selected method or canonical scalar carrier")
    route :: lower_runtime_route("jet_rt_codec_encode_{runtime_abi_atom(scalar)}") ?? return lower_fail(&m, &f, "canonical scalar Encode adapter is missing")
    if !lower_route_shape_matches(p, tree, route.result) -> return lower_fail(&m, &f, "canonical scalar Encode result does not match checked Dyn storage")
    runtime :: lower_pointer(&f)
    lower_call_runtime(&m, &f, route.export, [LIRValueID]{source}, Val(runtime))
    lower_dyn_from_runtime(p, &m, &f, tree, runtime, dst)
}

fn lower_codec_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg], types: [MIRType]) -> Bool Never! {
    if lower_native_value_call(p, c, &m, &f, instruction, call, args) -> return true
    row :: lower_prelude_row(p, m, call) ?? return false
    if types.len() == 1 && row.module_name == "core.encoding.csv" && row.member == "decode" -> return lower_codec_csv(p, c, &m, &f, instruction, args, types[0])
    if types.len() == 1 && row.module_name == "core.sys" && row.member == "decode" -> return lower_codec_env(p, c, &m, &f, instruction, args, types[0])
    codec :: row.module_name == "core.encoding.codec" && (row.member == "encode" || row.member == "decode" || row.member == "decode_typed")
    parsed :: (row.module_name == "core.encoding.json" || row.module_name == "core.encoding.toml" || row.module_name == "core.encoding.yaml") && row.member == "decode"
    if types.len() != 1 || (!codec && !parsed) -> return false
    source_index :: if codec && row.member != "decode_typed" -> 1 else -> 0
    if args.len() != source_index + 1 {
        lower_fail(&m, &f, "codec intrinsic has an incompatible checked argument list")
        return true
    }
    target :: types[0]
    source :: lower_use(&m, &f, args[source_index].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    if codec && row.member == "encode" {
        result :: lower_checked_type(c, instruction) ?? return true
        lower_codec_encode_into(p, &m, &f, target, result, source, dst)
        return true
    }
    tree :: lower_dyn_program_type(p) ?? {
        lower_fail(&m, &f, "typed Decode has no checked Dyn declaration")
        return true
    }
    result :: lower_checked_type(c, instruction) ?? return true
    if !parsed {
        lower_codec_decode_into(p, &m, &f, target, result, tree, source, dst)
        return true
    }
    format :: row.module_name.split(".").to_list().last() ?? ""
    route :: lower_runtime_route("jet_rt_codec_parse_{runtime_abi_atom(format)}") ?? {
        lower_fail(&m, &f, "canonical typed parser adapter is missing")
        return true
    }
    if route.result == .Result(ok, err) {
        errors :: if result.kind == .Result(_, failure) -> failure else -> {
            lower_fail(&m, &f, "typed parse does not return a checked Result")
            return true
        }
        out :: lower_route_result_call(&m, &f, route.export, [LIRValueID]{source}, ok, err)
        yes :: lower_flag(&f)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: yes, condition: LIRCondition.Ne, left: out.word, right: zero})
        success :: lower_new_block(&f)
        failure :: lower_new_block(&f)
        merge :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: yes, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
        lower_start(&f, failure, [LIRValueID]{})
        failed :: lower_pointer(&f)
        lower_alloc(&m, &f, failed, lower_box_size(p, result))
        lower_emit(&f, LIRInst.Store{base: failed, offset: 0, value: out.word})
        lower_route_store_payload(p, &m, &f, failed, lower_result_payload_offset(), errors, err, out.slot)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{failed})})
        lower_start(&f, success, [LIRValueID]{})
        runtime :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: runtime, base: out.slot, offset: 0})
        native :: lower_pointer(&f)
        lower_dyn_from_runtime(p, &m, &f, tree, runtime, native)
        decoded :: lower_pointer(&f)
        lower_codec_decode_into(p, &m, &f, target, result, tree, native, decoded)
        lower_map_drop_value(p, &m, &f, native, tree)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{decoded})})
        lower_start(&f, merge, [LIRValueID]{dst})
    }
    true
}

fn lower_codec_under(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, segment: MIRValueID, inner: MIRValueID) Never! {
    ty :: lower_value_type(c, inner) ?? return lower_fail(&m, &f, "DecodeUnder has no checked inner Result")
    errors :: if ty.kind == .Result(_, failure) -> failure else -> {
        lower_fail(&m, &f, "DecodeUnder inner value is not a Result")
        return
    }
    route :: lower_codec_under_route(p, &m, &f, errors) ?? return
    value :: lower_use(&m, &f, inner) ?? return
    text :: lower_use(&m, &f, segment) ?? return
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: value, offset: 0})
    yes :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: yes, condition: LIRCondition.Ne, left: selector, right: zero})
    failure :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: yes, then_target: lower_target(merge, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    source :: lower_address(&f, value, 8)
    lower_codec_prefix(p, &m, &f, route, errors, source, text)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, merge, [LIRValueID]{})
    lower_alias(c, &f, instruction, value)
}

// The canonical FieldError prefix adapter, checked against `errors` storage.
fn lower_codec_under_route(p: MIRProgram, m: &LowerModule, f: &LowerFunction, errors: MIRType) -> LowerRoute? {
    route :: lower_runtime_route("jet_rt_codec_under") ?? {
        lower_fail(&m, &f, "canonical FieldError prefix adapter is missing")
        return None
    }
    carrier :: if route.result == .Plain(value) -> value else -> {
        lower_fail(&m, &f, "canonical FieldError prefix adapter has the wrong result rail")
        return None
    }
    if !lower_route_result_matches(p, errors, carrier) {
        lower_fail(&m, &f, "DecodeUnder error storage does not match FieldError")
        return None
    }
    Val(route)
}

// FieldError.under_errors(segment, errors) (FieldError.rs:18-26): replaces
// the owned [FieldError] List header at `source` with its errors framed under
// the borrowed `text` segment.
fn lower_codec_prefix(p: MIRProgram, m: &LowerModule, f: &LowerFunction, route: LowerRoute, errors: MIRType, source: LIRValueID, text: LIRValueID) Never! {
    length :: lower_list_word(&f, source, 0)
    buffer :: lower_pointer(&f)
    lower_call_helper(&m, &f, "list.record_handles", errors, [LIRValueID]{source}, Val(buffer))
    out :: lower_route_out_call(&m, &f, route.export, [LIRValueID]{text, buffer, length}, 1, false)
    lower_call_helper(&m, &f, "list.record_handles_free", errors, [LIRValueID]{buffer, length}, None)
    lower_map_drop_value(p, &m, &f, source, errors)
    data :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: data, base: out.slot, offset: 0})
    lower_record_list_from_runtime(p, &m, &f, errors, data, out.word, source)
}

// The canonical CSV row and env config kernels own source projection and
// error accumulation. Each boundary supplies only its checked native Decode
// callback ("codec.tree.decode") and storage.
fn lower_codec_csv(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, args: [MIRCallArg], target: MIRType) -> Bool Never! {
    if args.len() != 1 {
        lower_fail(&m, &f, "typed CSV intrinsic needs its checked text argument")
        return true
    }
    result :: lower_checked_type(c, instruction) ?? return true
    errors :: if result.kind == .Result(values, failure) -> {
        element :: lower_list_element(values) ?? {
            lower_fail(&m, &f, "typed CSV success is not a List")
            return true
        }
        if !mir_type_same_checked_type(element, target) {
            lower_fail(&m, &f, "typed CSV row type does not match its checked result")
            return true
        }
        failure
    } else -> {
        lower_fail(&m, &f, "typed CSV does not return a checked Result")
        return true
    }
    if !lower_codec_kernel_ready(p, &m, &f, errors, "typed CSV") -> return true
    source :: lower_use(&m, &f, args[0].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    callback_type :: mir_type_from_kind(MIRTypeKind.Result{ok: target, err: errors})
    invoke :: lower_lazy_helper_address(&m, &f, "codec.tree.decode", callback_type)
    meta :: lower_lazy_meta(p, &m, &f, target)
    lower_codec_kernel_call(p, &m, &f, "jet_rt_codec_csv", [LIRValueID]{source, invoke, meta}, result, errors, dst)
    true
}

// D-CONFIG-ENV1 `env.decode<T>(prefix, file, allow)`: the kernel receives
// T's checked shape names as `env=key` lines (MIRRust.rs shape_name_map).
fn lower_codec_env(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, args: [MIRCallArg], target: MIRType) -> Bool Never! {
    if args.len() != 3 {
        lower_fail(&m, &f, "typed env decode needs its checked prefix, file and allow arguments")
        return true
    }
    result :: lower_checked_type(c, instruction) ?? return true
    errors :: if result.kind == .Result(ok, failure) -> {
        if !mir_type_same_checked_type(ok, target) {
            lower_fail(&m, &f, "typed env decode success does not match its checked target")
            return true
        }
        failure
    } else -> {
        lower_fail(&m, &f, "typed env decode does not return a checked Result")
        return true
    }
    if !lower_codec_kernel_ready(p, &m, &f, errors, "typed env decode") -> return true
    definition :: lower_type_def(p, target) ?? {
        lower_fail(&m, &f, "typed env decode target has no definition")
        return true
    }
    names := ""
    if definition.kind == .Struct(fields, _) {
        loop field in fields {
            if field.skip || field.computed -> next
            key :: field.shape_names.json ?? field.shape_names.text
            names = "{names}{field.shape_names.env}={key}\n"
        }
    } else {
        lower_fail(&m, &f, "typed env decode target {mir_type_display_name(target)} is not a struct")
        return true
    }
    lowered := [LIRValueID]{}
    loop arg in args {
        value :: lower_use(&m, &f, arg.value) ?? return true
        &lowered.push(value)
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    names_text :: lower_static_text(&m, &f, names)
    shape :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", names_text, Val(shape))
    &lowered.push(shape)
    callback_type :: mir_type_from_kind(MIRTypeKind.Result{ok: target, err: errors})
    &lowered.push(lower_lazy_helper_address(&m, &f, "codec.tree.decode", callback_type))
    lower_codec_kernel_call(p, &m, &f, "jet_rt_codec_env", lowered, result, errors, dst)
    lower_emit(&f, LIRInst.Drop{value: shape})
    true
}

fn lower_codec_kernel_ready(p: MIRProgram, m: &LowerModule, f: &LowerFunction, errors: MIRType, what: String) -> Bool Never! {
    carrier :: LowerRouteCarrier.List{elem: LowerRouteCarrier.Handle{name: "FieldError"}}
    if !lower_route_result_matches(p, errors, carrier) {
        lower_fail(&m, &f, "{what} failures do not match canonical FieldError storage")
        return false
    }
    if lower_dyn_program_type(p) == None {
        lower_fail(&m, &f, "{what} has no checked Dyn declaration")
        return false
    }
    true
}

// Calls the kernel `symbol` with `args` then (value payload, errors out,
// length out) and fills the Result box `dst`: its status is the selector, a
// failure's handle buffer becomes the native [FieldError].
fn lower_codec_kernel_call(p: MIRProgram, m: &LowerModule, f: &LowerFunction, symbol: String, args: [LIRValueID], result: MIRType, errors: MIRType, dst: LIRValueID) Never! {
    lower_alloc(&m, &f, dst, lower_box_size(p, result))
    failure_out :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: failure_out, size: 16, align: 8})
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: failure_out, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: failure_out, offset: 8, value: zero})
    selector :: lower_word(&f)
    payload :: lower_address(&f, dst, 8)
    length_out :: lower_address(&f, failure_out, 8)
    call_args := args.copy()
    loop value in ([LIRValueID]{payload, failure_out, length_out}) -> &call_args.push(value)
    lower_call_runtime(&m, &f, symbol, call_args, Val(selector))
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: selector})
    succeeded :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: selector, right: zero})
    failure :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(merge, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    buffer :: lower_pointer(&f)
    length :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: buffer, base: failure_out, offset: 0})
    lower_emit(&f, LIRInst.Load{dst: length, base: failure_out, offset: 8})
    lower_record_list_from_runtime(p, &m, &f, errors, buffer, length, payload)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, merge, [LIRValueID]{})
}

// "codec.tree.decode" (borrowed runtime Dyn, value out, status out, errors
// out, length out) -> consumed mask zero, the OCB1 callback both kernels
// invoke inside the text-cell scope. The status/value outs are written only
// after the masked delivered-stop gate succeeds.
fn lower_helper_codec_tree_decode(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    target :: if glue.ty.kind == .Result(ok, _) -> ok else -> panic("tree Decode callback needs its checked Decode Result")
    errors :: if glue.ty.kind == .Result(_, err) -> err else -> panic("tree Decode callback needs its checked failures")
    tree :: lower_dyn_program_type(p) ?? panic("tree Decode callback needs its checked Dyn")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer(), lir_layout_pointer(), lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_word()))
    borrowed :: f.open_params[0].copy()
    output :: f.open_params[1].copy()
    status_out :: f.open_params[2].copy()
    errors_out :: f.open_params[3].copy()
    length_out :: f.open_params[4].copy()
    owned :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_handle_clone_dyn", [LIRValueID]{borrowed}, Val(owned))
    native :: lower_pointer(&f)
    lower_dyn_from_runtime(p, &m, &f, tree, owned, native)
    decoded :: lower_pointer(&f)
    lower_codec_decode_into(p, &m, &f, target, glue.ty, tree, native, decoded)
    stopped :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_session_propagate", [LIRValueID]{}, Val(stopped))
    delivered :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: delivered, condition: LIRCondition.Ne, left: stopped, right: zero})
    stop :: lower_new_block(&f)
    ready :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: delivered, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(ready, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    lower_map_drop_value(p, &m, &f, native, tree)
    lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    lower_start(&f, ready, [LIRValueID]{})
    lower_map_drop_value(p, &m, &f, native, tree)
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: decoded, offset: 0})
    lower_emit(&f, LIRInst.Store{base: status_out, offset: 0, value: selector})
    succeeded :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: selector, right: zero})
    success :: lower_new_block(&f)
    failure :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
    if lower_repr(p, target) != .Absent {
        value :: lower_read_at(p, &f, decoded, 8, target) ?? panic("checked CSV row has native storage")
        lower_write_at(p, &f, output, 0, value, target)
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    source :: lower_address(&f, decoded, 8)
    length :: lower_list_word(&f, source, 0)
    buffer :: lower_pointer(&f)
    lower_call_helper(&m, &f, "list.record_handles", errors, [LIRValueID]{source}, Val(buffer))
    lower_emit(&f, LIRInst.Store{base: errors_out, offset: 0, value: buffer})
    lower_emit(&f, LIRInst.Store{base: length_out, offset: 0, value: length})
    lower_map_drop_value(p, &m, &f, source, errors)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, merge, [LIRValueID]{})
    lower_free_shell(&m, &f, decoded, lower_box_size(p, glue.ty))
    lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    lir_builder_finish(f.builder)
}

// ---------------------------------------------------------------------------
// Container codecs (EncodingTraits.rs:457-535 decode: List, [T#N], ?T, Dyn,
// Map<String, V>). One "codec.decode" helper per checked Result<T,
// [FieldError]> walks the borrowed checked native Dyn enum; every element
// decode recurses through lower_codec_decode_into's one selection (selected
// method, canonical scalar adapter, container helper), so nested containers
// share it.

fn lower_codec_container(p: MIRProgram, ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .List(_) | .FixedList(_, _) | .Option(_) -> true
        .Map(key, _) -> key.kind == .String
        else -> lower_dyn_type(p, ty)
    }
}

// One checked Dyn variant: its native discriminant and payload storage.
struct LowerCodecVariant {
    discriminant: Int
    offset: Int
    boxed: Bool
    ty: MIRType
}

fn lower_codec_tag_of(p: MIRProgram, tree: MIRType, name: String) -> Int? {
    definition :: lower_type_def(p, tree) ?? return None
    found :: lower_variant(definition, name) ?? return None
    Val(lower_discriminant(found.index))
}

fn lower_codec_variant(p: MIRProgram, tree: MIRType, name: String) -> LowerCodecVariant? {
    definition :: lower_type_def(p, tree) ?? return None
    found :: lower_variant(definition, name) ?? return None
    info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? return None
    Val(LowerCodecVariant{discriminant: lower_discriminant(found.index), offset: info.offset, boxed: info.boxed, ty: info.ty})
}

// The payload address of the Dyn box `node` holding `variant` (inside its
// recursive-edge wrapper when the edge is boxed).
fn lower_codec_payload(f: &LowerFunction, node: LIRValueID, variant: LowerCodecVariant) -> LIRValueID Never! {
    address :: lower_address(&f, node, variant.offset)
    if !variant.boxed -> return address
    wrapper :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: wrapper, base: address, offset: 0})
    wrapper
}

// Branches on `word == expected`: opens the matching block and returns the
// other one, still to be started.
fn lower_codec_on_tag(f: &LowerFunction, word: LIRValueID, expected: Int) -> LIRBlockID Never! {
    wanted :: lower_const(&f, expected)
    hit :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: hit, condition: LIRCondition.Eq, left: word, right: wanted})
    taken :: lower_new_block(&f)
    other :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: hit, then_target: lower_target(taken, [LIRValueID]{}), else_target: lower_target(other, [LIRValueID]{})})
    lower_start(&f, taken, [LIRValueID]{})
    other
}

// Opens the success block of the Result box `decoded`; returns its failure
// block, still to be started.
fn lower_codec_on_ok(f: &LowerFunction, decoded: LIRValueID) -> LIRBlockID Never! {
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: decoded, offset: 0})
    lower_codec_on_tag(&f, selector, lower_result_selector(true))
}

fn lower_codec_tag(f: &LowerFunction, node: LIRValueID) -> LIRValueID Never! {
    discriminant :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: discriminant, base: node, offset: 0})
    discriminant
}

// "expected {expected}, found {kind}" with Dyn.rs dyn_kind_for's kind
// vocabulary (DynKind.rs dyn_kind) for the native `discriminant`; owned String.
fn lower_codec_found(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, discriminant: LIRValueID, expected: String) -> LIRValueID Never! {
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "expected {expected}, found ")
    done :: lower_new_block(&f)
    names :: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}
    kinds :: [String]{"null", "Bool", "Int", "Float", "number", "Text", "Bytes", "DateTime", "a list", "an object"}
    loop (index, name) in names {
        known :: lower_codec_tag_of(p, tree, name) ?? next
        other :: lower_codec_on_tag(&f, discriminant, known)
        lower_render_static(&m, &f, builder, kinds[index])
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, other, [LIRValueID]{})
    }
    lower_render_static(&m, &f, builder, "value")
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    text
}

// Err(FieldError.one(reason)) (FieldError.rs): the Result box `box` fails
// with one error at the empty path. Consumes the owned `reason`.
fn lower_codec_fail_one(p: MIRProgram, m: &LowerModule, f: &LowerFunction, errors: MIRType, reason: LIRValueID, box: LIRValueID) Never! {
    empty :: lower_static_text(&m, &f, "")
    path :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_from_static", empty, Val(path))
    handle :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_record_new_field_error", [LIRValueID]{path, reason}, Val(handle))
    lower_emit(&f, LIRInst.Drop{value: path})
    lower_emit(&f, LIRInst.Drop{value: reason})
    one :: lower_const(&f, 1)
    buffer :: lower_list_buffer(&m, &f, one, 8)
    lower_emit(&f, LIRInst.Store{base: buffer, offset: 0, value: handle})
    lower_store_word(&f, box, 0, lower_result_selector(false))
    target :: lower_address(&f, box, lower_result_payload_offset())
    lower_record_list_from_runtime(p, &m, &f, errors, buffer, one, target)
}

// The "[index]" segment jet_decode_sequence frames element errors under;
// owned String.
fn lower_codec_index_segment(m: &LowerModule, f: &LowerFunction, index: LIRValueID) -> LIRValueID Never! {
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "[")
    number :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_i64_to_string", [LIRValueID]{index}, Val(number))
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, number}, None)
    lower_emit(&f, LIRInst.Drop{value: number})
    lower_render_static(&m, &f, builder, "]")
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    text
}

// An empty owned [FieldError] List header in frame storage.
fn lower_codec_failures(p: MIRProgram, f: &LowerFunction, errors: MIRType) -> LIRValueID Never! {
    failures :: lower_new_storage(p, &f, errors)
    zero :: lower_const(&f, 0)
    loop offset in ([Int]{0, 8, 16}) -> lower_emit(&f, LIRInst.Store{base: failures, offset: offset, value: zero})
    failures
}

// Moves the failed element Result `decoded`'s errors, framed under the
// borrowed `segment`, onto the collected `failures`.
fn lower_codec_absorb(p: MIRProgram, m: &LowerModule, f: &LowerFunction, route: LowerRoute, errors: MIRType, failures: LIRValueID, decoded: LIRValueID, segment: LIRValueID) Never! {
    found :: lower_address(&f, decoded, lower_result_payload_offset())
    lower_codec_prefix(p, &m, &f, route, errors, found, segment)
    lower_call_helper(&m, &f, "list.extend", errors, [LIRValueID]{failures, found}, None)
}

// Any collected error fails the whole container with all of them, dropping
// the partial value of `ty` at box+8; otherwise the box succeeds.
fn lower_codec_settle(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, errors: MIRType, failures: LIRValueID, box: LIRValueID) Never! {
    out :: lower_address(&f, box, lower_result_payload_offset())
    count :: lower_list_word(&f, failures, 0)
    zero :: lower_const(&f, 0)
    failed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: failed, condition: LIRCondition.Ne, left: count, right: zero})
    failure :: lower_new_block(&f)
    success :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    lower_map_drop_value(p, &m, &f, out, ty)
    lower_copy_bytes(&f, out, 0, failures, 0, lower_size(p, errors).size)
    lower_store_word(&f, box, 0, lower_result_selector(false))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
    lower_store_word(&f, box, 0, lower_result_selector(true))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, merge, [LIRValueID]{})
}

// "codec.decode" (borrowed native Dyn) -> owned Result<T, [FieldError]> box
// for the container T of the helper's Result type.
fn lower_helper_codec_decode(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    target :: if glue.ty.kind == .Result(ok, _) -> ok else -> panic("codec.decode needs its checked Decode Result")
    errors :: if glue.ty.kind == .Result(_, err) -> err else -> panic("codec.decode needs its checked failures")
    tree :: lower_dyn_program_type(p) ?? panic("codec.decode needs its checked Dyn")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    source :: f.open_params[0].copy()
    box :: lower_pointer(&f)
    lower_alloc(&m, &f, box, lower_box_size(p, glue.ty))
    if target.kind == {
        .List(elem) -> lower_codec_decode_list(p, &m, &f, tree, target, elem, errors, source, box)
        .FixedList(elem, len) -> lower_codec_decode_fixed(p, &m, &f, tree, target, elem, len, errors, source, box)
        .Option(inner) -> lower_codec_decode_option(p, &m, &f, tree, inner, errors, source, box)
        .Map(_, value) -> lower_codec_decode_map(p, &m, &f, tree, target, value, errors, source, box)
        else -> {
            // EncodingTraits.rs:491-493: Dyn decodes as its own clone.
            cloned :: lower_pointer(&f)
            lower_clone_into(p, &m, &f, source, cloned, tree)
            lower_write_at(p, &f, box, lower_result_payload_offset(), cloned, tree)
            lower_store_word(&f, box, 0, lower_result_selector(true))
        }
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(box)})
    lir_builder_finish(f.builder)
}

// EncodingTraits.rs:457-478: a byte (U8) List also accepts Dyn.Bytes and
// base64 Dyn.Text; Dyn.Array decodes through jet_decode_sequence (:222-245),
// which keeps decoding after a failed element and frames each element's
// errors under "[index]"; any other kind is "expected a list, found {kind}".
// Fills the Result box `box` of List `ty`.
fn lower_codec_decode_list(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, ty: MIRType, elem: MIRType, errors: MIRType, source: LIRValueID, box: LIRValueID) Never! {
    array :: lower_codec_variant(p, tree, "Array") ?? return lower_fail(&m, &f, "checked Dyn has no Array payload")
    route :: lower_codec_under_route(p, &m, &f, errors) ?? return
    discriminant :: lower_codec_tag(&f, source)
    done :: lower_new_block(&f)
    if lower_codec_byte(elem) {
        bytes :: lower_codec_variant(p, tree, "Bytes") ?? return lower_fail(&m, &f, "checked Dyn has no Bytes payload")
        text :: lower_codec_variant(p, tree, "Text") ?? return lower_fail(&m, &f, "checked Dyn has no Text payload")
        not_bytes :: lower_codec_on_tag(&f, discriminant, bytes.discriminant)
        // :460-462: jet_decode_byte accepts every byte, so the List is a copy.
        held :: lower_codec_payload(&f, source, bytes)
        copied :: lower_pointer(&f)
        lower_clone_into(p, &m, &f, held, copied, bytes.ty)
        lower_copy_bytes(&f, box, lower_result_payload_offset(), copied, 0, lower_size(p, bytes.ty).size)
        lower_store_word(&f, box, 0, lower_result_selector(true))
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, not_bytes, [LIRValueID]{})
        not_text :: lower_codec_on_tag(&f, discriminant, text.discriminant)
        // :463-468: strict standard base64 Text.
        encoded_at :: lower_codec_payload(&f, source, text)
        encoded :: lower_read_at(p, &f, encoded_at, 0, text.ty) ?? return lower_fail(&m, &f, "Dyn.Text has no storage")
        byte_list :: mir_type_from_kind(MIRTypeKind.List{inner: elem})
        lower_call_helper(&m, &f, "codec.base64", mir_type_from_kind(MIRTypeKind.Result{ok: byte_list, err: errors}), [LIRValueID]{encoded, box}, None)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, not_text, [LIRValueID]{})
    }
    other :: lower_codec_on_tag(&f, discriminant, array.discriminant)
    items :: lower_codec_payload(&f, source, array)
    count :: lower_list_word(&f, items, 0)
    stride :: lower_list_stride(p, elem)
    data :: lower_list_buffer(&m, &f, count, stride)
    out :: lower_address(&f, box, lower_result_payload_offset())
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: out, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: out, offset: 8, value: count})
    lower_emit(&f, LIRInst.Store{base: out, offset: 16, value: data})
    failures :: lower_codec_failures(p, &f, errors)
    decoded_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: elem, err: errors})
    each :: lower_each_begin(p, &f, items, tree, [LIRValueID]{})
    item :: lower_read_at(p, &f, each.address, 0, tree) ?? return lower_fail(&m, &f, "Dyn.Array element has no storage")
    decoded :: lower_pointer(&f)
    lower_codec_decode_into(p, &m, &f, elem, decoded_ty, tree, item, decoded)
    failure :: lower_codec_on_ok(&f, decoded)
    length :: lower_list_word(&f, out, 0)
    if lower_read_at(p, &f, decoded, lower_result_payload_offset(), elem) == .Val(value) {
        slot :: lower_list_address(&f, data, length, stride)
        lower_write_at(p, &f, slot, 0, value, elem)
    }
    one :: lower_const(&f, 1)
    grown :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: grown, op: LIRBinaryOp.Add, left: length, right: one})
    lower_emit(&f, LIRInst.Store{base: out, offset: 0, value: grown})
    next_item :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_item, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    segment :: lower_codec_index_segment(&m, &f, each.at)
    lower_codec_absorb(p, &m, &f, route, errors, failures, decoded, segment)
    lower_emit(&f, LIRInst.Drop{value: segment})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_item, [LIRValueID]{})})
    lower_start(&f, next_item, [LIRValueID]{})
    lower_free_shell(&m, &f, decoded, lower_box_size(p, decoded_ty))
    lower_each_end(&f, each, [LIRValueID]{})
    lower_codec_settle(p, &m, &f, ty, errors, failures, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, other, [LIRValueID]{})
    reason :: lower_codec_found(p, &m, &f, tree, discriminant, "a list")
    lower_codec_fail_one(p, &m, &f, errors, reason, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// T::__JET_IS_BYTE (EncodingTraits.rs:394-406): only U8 codes as a byte.
fn lower_codec_byte(ty: MIRType) -> Bool Never! {
    if ty.kind == .IntN(signed, bits) -> return !signed && bits == 8
    false
}

// EncodingTraits.rs:494-501: Dyn.Null is None; any other Dyn is Some of the
// inner decode, whose errors pass through unframed.
fn lower_codec_decode_option(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, inner: MIRType, errors: MIRType, source: LIRValueID, box: LIRValueID) Never! {
    absent_tag :: lower_codec_tag_of(p, tree, "Null") ?? return lower_fail(&m, &f, "checked Dyn has no Null variant")
    discriminant :: lower_codec_tag(&f, source)
    done :: lower_new_block(&f)
    other :: lower_codec_on_tag(&f, discriminant, absent_tag)
    absent :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: absent, value: 0})
    lower_emit(&f, LIRInst.Store{base: box, offset: lower_result_payload_offset(), value: absent})
    lower_store_word(&f, box, 0, lower_result_selector(true))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, other, [LIRValueID]{})
    decoded_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: inner, err: errors})
    decoded :: lower_pointer(&f)
    lower_codec_decode_into(p, &m, &f, inner, decoded_ty, tree, source, decoded)
    failure :: lower_codec_on_ok(&f, decoded)
    present :: lower_pointer(&f)
    lower_alloc(&m, &f, present, lower_option_box_size(p, inner))
    if lower_read_at(p, &f, decoded, lower_result_payload_offset(), inner) == .Val(value) -> lower_write_at(p, &f, present, 0, value, inner)
    lower_emit(&f, LIRInst.Store{base: box, offset: lower_result_payload_offset(), value: present})
    lower_store_word(&f, box, 0, lower_result_selector(true))
    settled :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(settled, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    lower_copy_bytes(&f, box, lower_result_payload_offset(), decoded, lower_result_payload_offset(), lower_size(p, errors).size)
    lower_store_word(&f, box, 0, lower_result_selector(false))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(settled, [LIRValueID]{})})
    lower_start(&f, settled, [LIRValueID]{})
    lower_free_shell(&m, &f, decoded, lower_box_size(p, decoded_ty))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// EncodingTraits.rs:479-490: decodes as a List, then any length other than
// N fails with "expected a fixed list of length {N}, found {found}".
fn lower_codec_decode_fixed(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, ty: MIRType, elem: MIRType, len: MIRMeasure, errors: MIRType, source: LIRValueID, box: LIRValueID) Never! {
    expected :: mir_measure_literal_value(len) ?? return lower_fail(&m, &f, "Decode<{mir_type_display_name(ty)}> has no literal length")
    list :: mir_type_from_kind(MIRTypeKind.List{inner: elem})
    lower_codec_decode_list(p, &m, &f, tree, list, elem, errors, source, box)
    done :: lower_new_block(&f)
    failed :: lower_codec_on_ok(&f, box)
    out :: lower_address(&f, box, lower_result_payload_offset())
    found :: lower_list_word(&f, out, 0)
    wrong :: lower_codec_on_tag(&f, found, expected)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, wrong, [LIRValueID]{})
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "expected a fixed list of length {expected}, found ")
    number :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_i64_to_string", [LIRValueID]{found}, Val(number))
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, number}, None)
    lower_emit(&f, LIRInst.Drop{value: number})
    reason :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(reason))
    lower_map_drop_value(p, &m, &f, out, list)
    lower_codec_fail_one(p, &m, &f, errors, reason, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, failed, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// EncodingTraits.rs:502-535: each Dyn.Object entry's value decodes in entry
// order and is inserted into the key-ordered Map (BTreeMap insert: a repeated
// key keeps the later value); an entry's errors are framed under its key and
// collected; any other kind is "expected an object, found {kind}".
fn lower_codec_decode_map(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, ty: MIRType, value_ty: MIRType, errors: MIRType, source: LIRValueID, box: LIRValueID) Never! {
    shape :: lower_map_shape(p, ty) ?? return lower_fail(&m, &f, "Decode<{mir_type_display_name(ty)}> has no Map layout")
    object :: lower_codec_variant(p, tree, "Object") ?? return lower_fail(&m, &f, "checked Dyn has no Object payload")
    entry :: lower_list_element(object.ty) ?? return lower_fail(&m, &f, "Dyn.Object payload is not a List")
    members :: lower_inline_members(p, entry)
    if members.len() != 2 || members[0].name != "key" || members[1].name != "value" -> return lower_fail(&m, &f, "Dyn.Object entries need checked key/value members")
    route :: lower_codec_under_route(p, &m, &f, errors) ?? return
    discriminant :: lower_codec_tag(&f, source)
    done :: lower_new_block(&f)
    other :: lower_codec_on_tag(&f, discriminant, object.discriminant)
    entries :: lower_codec_payload(&f, source, object)
    out :: lower_address(&f, box, lower_result_payload_offset())
    zero :: lower_const(&f, 0)
    loop offset in ([Int]{0, 8, 16}) -> lower_emit(&f, LIRInst.Store{base: out, offset: offset, value: zero})
    failures :: lower_codec_failures(p, &f, errors)
    decoded_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: value_ty, err: errors})
    each :: lower_each_begin(p, &f, entries, entry, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, members[0].offset, members[0].ty) ?? return lower_fail(&m, &f, "Dyn.Object key has no storage")
    item :: lower_read_at(p, &f, each.address, members[1].offset, tree) ?? return lower_fail(&m, &f, "Dyn.Object value has no storage")
    decoded :: lower_pointer(&f)
    lower_codec_decode_into(p, &m, &f, value_ty, decoded_ty, tree, item, decoded)
    failure :: lower_codec_on_ok(&f, decoded)
    value :: lower_read_at(p, &f, decoded, lower_result_payload_offset(), value_ty) ?? return lower_fail(&m, &f, "Map value has no storage")
    owned_key :: lower_new_like(&f, key)
    lower_clone_into(p, &m, &f, key, owned_key, shape.key)
    lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{out, owned_key, value}, None)
    next_entry :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_entry, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    lower_codec_absorb(p, &m, &f, route, errors, failures, decoded, key)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_entry, [LIRValueID]{})})
    lower_start(&f, next_entry, [LIRValueID]{})
    lower_free_shell(&m, &f, decoded, lower_box_size(p, decoded_ty))
    lower_each_end(&f, each, [LIRValueID]{})
    lower_codec_settle(p, &m, &f, ty, errors, failures, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, other, [LIRValueID]{})
    reason :: lower_codec_found(p, &m, &f, tree, discriminant, "an object")
    lower_codec_fail_one(p, &m, &f, errors, reason, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// "codec.base64" (borrowed String, Result<[U8], [FieldError]> box to fill):
// decode_base64(text, false, false) (BaseEncodingStrict.rs:51-276), strict
// standard base64 with required padding and no whitespace, whose failure is
// FieldError.one(reason) (EncodingTraits.rs:463-468). Scan and bit assembly
// share one pass; the quantum checks then run in decode_quanta's order, the
// unused-bit check last. Scan state lives in one frame slot:
// [at, first padding offset (-1), padding count, symbols, bit buffer, bits,
// last symbol offset (-1), output length].
fn lower_helper_codec_base64(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    target :: if glue.ty.kind == .Result(ok, _) -> ok else -> panic("codec.base64 needs its checked byte List Result")
    errors :: if glue.ty.kind == .Result(_, err) -> err else -> panic("codec.base64 needs its checked failures")
    byte :: lower_list_element(target) ?? panic("codec.base64 needs its checked byte List")
    stride :: lower_list_stride(p, byte)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    text :: f.open_params[0].copy()
    box :: f.open_params[1].copy()
    data :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_data", [LIRValueID]{text}, Val(data))
    length :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_byte_len", [LIRValueID]{text}, Val(length))
    out :: lower_list_buffer(&m, &f, length, stride)
    state :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: state, size: 64, align: 8})
    zero :: lower_const(&f, 0)
    unset :: lower_const(&f, -1)
    one :: lower_const(&f, 1)
    loop offset in ([Int]{0, 16, 24, 32, 40, 56}) -> lower_emit(&f, LIRInst.Store{base: state, offset: offset, value: zero})
    lower_emit(&f, LIRInst.Store{base: state, offset: 8, value: unset})
    lower_emit(&f, LIRInst.Store{base: state, offset: 48, value: unset})
    exit :: lower_new_block(&f)
    head :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{})})
    lower_start(&f, head, [LIRValueID]{})
    at :: lower_list_word(&f, state, 0)
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    body :: lower_new_block(&f)
    finish :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(finish, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    value :: lower_text_byte(&f, data, at)
    blank :: lower_new_block(&f)
    loop code in ([Int]{9, 10, 11, 12, 13, 32}) -> lower_text_byte_is(&f, value, code, blank)
    padding :: lower_new_block(&f)
    lower_text_byte_is(&f, value, 61, padding)
    first_pad :: lower_list_word(&f, state, 8)
    padded :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: padded, condition: LIRCondition.Ge, left: first_pad, right: zero})
    late :: lower_new_block(&f)
    symbol :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: padded, then_target: lower_target(late, [LIRValueID]{}), else_target: lower_target(symbol, [LIRValueID]{})})
    lower_start(&f, symbol, [LIRValueID]{})
    accept :: lower_new_block(&f)
    upper :: lower_new_block(&f)
    lower_check :: lower_new_block(&f)
    lower_text_byte_between(&f, value, 65, 90, upper, lower_check)
    lower_start(&f, lower_check, [LIRValueID]{})
    lowercase :: lower_new_block(&f)
    digit_check :: lower_new_block(&f)
    lower_text_byte_between(&f, value, 97, 122, lowercase, digit_check)
    lower_start(&f, digit_check, [LIRValueID]{})
    digit :: lower_new_block(&f)
    marks :: lower_new_block(&f)
    lower_text_byte_between(&f, value, 48, 57, digit, marks)
    lower_start(&f, marks, [LIRValueID]{})
    plus :: lower_new_block(&f)
    slash :: lower_new_block(&f)
    lower_text_byte_is(&f, value, 43, plus)
    lower_text_byte_is(&f, value, 47, slash)
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, at, "", Val(value), exit)
    // std_b64: A-Z 0-25, a-z 26-51, 0-9 52-61, '+' (43) 62, '/' (47) 63.
    mapped_blocks :: [LIRBlockID]{upper, lowercase, digit, plus, slash}
    deltas :: [Int]{-65, -71, 4, 19, 16}
    loop (index, block) in mapped_blocks {
        lower_start(&f, block, [LIRValueID]{})
        delta :: lower_const(&f, deltas[index])
        mapped :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: mapped, op: LIRBinaryOp.Add, left: value, right: delta})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(accept, [LIRValueID]{mapped})})
    }
    sextet :: lower_word(&f)
    lower_start(&f, accept, [LIRValueID]{sextet})
    six :: lower_const(&f, 6)
    held :: lower_list_word(&f, state, 32)
    shifted :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: shifted, op: LIRBinaryOp.Shl, left: held, right: six})
    combined :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: combined, op: LIRBinaryOp.Or, left: shifted, right: sextet})
    lower_emit(&f, LIRInst.Store{base: state, offset: 32, value: combined})
    held_bits :: lower_list_word(&f, state, 40)
    bits :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: bits, op: LIRBinaryOp.Add, left: held_bits, right: six})
    lower_emit(&f, LIRInst.Store{base: state, offset: 40, value: bits})
    symbols_before :: lower_list_word(&f, state, 24)
    symbols_after :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: symbols_after, op: LIRBinaryOp.Add, left: symbols_before, right: one})
    lower_emit(&f, LIRInst.Store{base: state, offset: 24, value: symbols_after})
    lower_emit(&f, LIRInst.Store{base: state, offset: 48, value: at})
    eight :: lower_const(&f, 8)
    full :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: full, condition: LIRCondition.Ge, left: bits, right: eight})
    emit :: lower_new_block(&f)
    step :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: full, then_target: lower_target(emit, [LIRValueID]{}), else_target: lower_target(step, [LIRValueID]{})})
    lower_start(&f, emit, [LIRValueID]{})
    rest :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: rest, op: LIRBinaryOp.Sub, left: bits, right: eight})
    lower_emit(&f, LIRInst.Store{base: state, offset: 40, value: rest})
    aligned :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: aligned, op: LIRBinaryOp.UShr, left: combined, right: rest})
    low_byte :: lower_const(&f, 255)
    produced :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: produced, op: LIRBinaryOp.And, left: aligned, right: low_byte})
    written :: lower_list_word(&f, state, 56)
    slot :: lower_list_address(&f, out, written, stride)
    lower_write_at(p, &f, slot, 0, produced, byte)
    grown :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: grown, op: LIRBinaryOp.Add, left: written, right: one})
    lower_emit(&f, LIRInst.Store{base: state, offset: 56, value: grown})
    // Only the unconsumed low `rest` bits stay buffered.
    reach :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: reach, op: LIRBinaryOp.Shl, left: one, right: rest})
    mask :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: mask, op: LIRBinaryOp.Sub, left: reach, right: one})
    kept :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: kept, op: LIRBinaryOp.And, left: combined, right: mask})
    lower_emit(&f, LIRInst.Store{base: state, offset: 32, value: kept})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(step, [LIRValueID]{})})
    lower_start(&f, padding, [LIRValueID]{})
    pad_seen :: lower_list_word(&f, state, 8)
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Lt, left: pad_seen, right: zero})
    mark :: lower_new_block(&f)
    counted :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(mark, [LIRValueID]{}), else_target: lower_target(counted, [LIRValueID]{})})
    lower_start(&f, mark, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: state, offset: 8, value: at})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(counted, [LIRValueID]{})})
    lower_start(&f, counted, [LIRValueID]{})
    pads_before :: lower_list_word(&f, state, 16)
    pads_after :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: pads_after, op: LIRBinaryOp.Add, left: pads_before, right: one})
    lower_emit(&f, LIRInst.Store{base: state, offset: 16, value: pads_after})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(step, [LIRValueID]{})})
    lower_start(&f, step, [LIRValueID]{})
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: next_at})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{})})
    lower_start(&f, blank, [LIRValueID]{})
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, at, "ASCII whitespace is not allowed", None, exit)
    lower_start(&f, late, [LIRValueID]{})
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, at, "padding may appear only at the end", None, exit)
    lower_start(&f, finish, [LIRValueID]{})
    symbols :: lower_list_word(&f, state, 24)
    pads :: lower_list_word(&f, state, 16)
    pad_at :: lower_list_word(&f, state, 8)
    last :: lower_list_word(&f, state, 48)
    total :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: total, op: LIRBinaryOp.Add, left: symbols, right: pads})
    three :: lower_const(&f, 3)
    remainder :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: remainder, op: LIRBinaryOp.And, left: total, right: three})
    // eof: the first padding offset, else one past the last symbol.
    after_last :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: after_last, op: LIRBinaryOp.Add, left: last, right: one})
    has_pad :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: has_pad, condition: LIRCondition.Gt, left: pads, right: zero})
    pad_eof :: lower_new_block(&f)
    symbol_eof :: lower_new_block(&f)
    quanta :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: has_pad, then_target: lower_target(pad_eof, [LIRValueID]{}), else_target: lower_target(symbol_eof, [LIRValueID]{})})
    lower_start(&f, pad_eof, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(quanta, [LIRValueID]{pad_at})})
    lower_start(&f, symbol_eof, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(quanta, [LIRValueID]{after_last})})
    eof :: lower_word(&f)
    lower_start(&f, quanta, [LIRValueID]{eof})
    // decode_quanta: a remainder of 1 symbol is never whole bytes; 2 or 3
    // lack padding.
    remainders :: [Int]{1, 2, 3}
    reasons :: [String]{"encoded length cannot represent whole bytes", "expected 2 padding characters", "expected 1 padding characters"}
    loop (index, rem) in remainders {
        whole :: lower_codec_on_tag(&f, remainder, rem)
        lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, eof, reasons[index], None, exit)
        lower_start(&f, whole, [LIRValueID]{})
    }
    padded_check :: lower_new_block(&f)
    bits_check :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: has_pad, then_target: lower_target(padded_check, [LIRValueID]{}), else_target: lower_target(bits_check, [LIRValueID]{})})
    lower_start(&f, padded_check, [LIRValueID]{})
    tail :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: tail, op: LIRBinaryOp.And, left: symbols, right: three})
    tail_other :: lower_codec_on_tag(&f, tail, 1)
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, pad_at, "expected 0 padding characters", None, exit)
    lower_start(&f, tail_other, [LIRValueID]{})
    // Two trailing symbols need exactly "==", three exactly "=".
    tails :: [Int]{2, 3}
    needed :: [Int]{2, 1}
    loop (index, wanted_tail) in tails {
        next_tail :: lower_codec_on_tag(&f, tail, wanted_tail)
        excess :: lower_codec_on_tag(&f, pads, needed[index])
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(bits_check, [LIRValueID]{})})
        lower_start(&f, excess, [LIRValueID]{})
        lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, pad_at, "unexpected padding", None, exit)
        lower_start(&f, next_tail, [LIRValueID]{})
    }
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, pad_at, "unexpected padding", None, exit)
    lower_start(&f, bits_check, [LIRValueID]{})
    leftover :: lower_list_word(&f, state, 32)
    dirty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: dirty, condition: LIRCondition.Ne, left: leftover, right: zero})
    unused :: lower_new_block(&f)
    success :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: dirty, then_target: lower_target(unused, [LIRValueID]{}), else_target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, unused, [LIRValueID]{})
    lower_codec_base64_fail(p, &m, &f, errors, box, out, length, stride, last, "non-zero unused bits", None, exit)
    lower_start(&f, success, [LIRValueID]{})
    produced_count :: lower_list_word(&f, state, 56)
    lower_emit(&f, LIRInst.Store{base: box, offset: lower_result_payload_offset(), value: produced_count})
    lower_emit(&f, LIRInst.Store{base: box, offset: lower_result_payload_offset() + 8, value: length})
    lower_emit(&f, LIRInst.Store{base: box, offset: lower_result_payload_offset() + 16, value: out})
    lower_store_word(&f, box, 0, lower_result_selector(true))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(exit, [LIRValueID]{})})
    lower_start(&f, exit, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// One decode_base64 failure, "invalid base64 at byte {offset}: {reason}"
// (BaseEncodingStrict.rs:9-11), as FieldError.one after releasing the
// partial output; `foreign` is the byte an alphabet failure names as
// "byte 0x{XX} is not in the standard base64 alphabet". Seals into `exit`.
fn lower_codec_base64_fail(p: MIRProgram, m: &LowerModule, f: &LowerFunction, errors: MIRType, box: LIRValueID, out: LIRValueID, cap: LIRValueID, stride: Int, offset: LIRValueID, reason: String, foreign: LIRValueID?, exit: LIRBlockID) Never! {
    lower_list_free_buffer(&m, &f, out, cap, stride)
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "invalid base64 at byte ")
    number :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_i64_to_string", [LIRValueID]{offset}, Val(number))
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, number}, None)
    lower_emit(&f, LIRInst.Drop{value: number})
    lower_render_static(&m, &f, builder, ": ")
    if foreign == .Val(value) {
        lower_render_static(&m, &f, builder, "byte 0x")
        hex :: lower_static_text(&m, &f, "0123456789ABCDEF")
        one :: lower_const(&f, 1)
        four :: lower_const(&f, 4)
        fifteen :: lower_const(&f, 15)
        high :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: high, op: LIRBinaryOp.UShr, left: value, right: four})
        low :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: low, op: LIRBinaryOp.And, left: value, right: fifteen})
        loop nibble in ([LIRValueID]{high, low}) {
            glyph :: lower_pointer(&f)
            lower_emit(&f, LIRInst.PointerAdd{dst: glyph, base: hex[0], offset: nibble})
            lower_call_runtime(&m, &f, "jet_rt_string_builder_push_static", [LIRValueID]{builder, glyph, one}, None)
        }
        lower_render_static(&m, &f, builder, " is not in the standard base64 alphabet")
    } else {
        lower_render_static(&m, &f, builder, reason)
    }
    message :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(message))
    lower_codec_fail_one(p, &m, &f, errors, message, box)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(exit, [LIRValueID]{})})
}

// ---------------------------------------------------------------------------
// Container Encode (EncodingTraits.rs:128-183): one "codec.encode" helper per
// checked container T, (borrowed T) -> owned native Dyn box; each element
// encodes through lower_codec_encode_into's one selection.

fn lower_helper_codec_encode(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    tree :: lower_dyn_program_type(p) ?? panic("codec.encode needs its checked Dyn")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    source :: f.open_params[0].copy()
    encoded :: if glue.ty.kind == {
        .List(elem) | .FixedList(elem, _) -> lower_codec_encode_list(p, &m, &f, tree, elem, source)
        .Option(inner) -> lower_codec_encode_option(p, &m, &f, tree, inner, source)
        .Map(_, _) -> lower_codec_encode_map(p, &m, &f, tree, glue.ty, source)
        else -> {
            // :181-183: Dyn encodes as its own clone.
            cloned :: lower_pointer(&f)
            lower_clone_into(p, &m, &f, source, cloned, tree)
            cloned
        }
    }
    lower_seal(&f, LIRTerminator.Return{value: Val(encoded)})
    lir_builder_finish(f.builder)
}

// Reports `message` and stands a null Dyn in for the unlowered encoding.
fn lower_codec_encode_fail(m: &LowerModule, f: &LowerFunction, message: String) -> LIRValueID Never! {
    lower_fail(&m, &f, message)
    absent :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: absent, value: 0})
    absent
}

// Defines `node` as a new Dyn box holding `variant`; returns the payload
// address (inside a new recursive-edge wrapper when the edge is boxed).
fn lower_codec_node(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, variant: LowerCodecVariant, node: LIRValueID) -> LIRValueID Never! {
    definition :: lower_type_def(p, tree) ?? panic("checked Dyn has a definition")
    lower_alloc(&m, &f, node, lower_enum_box_size(p, definition))
    lower_store_word(&f, node, 0, variant.discriminant)
    address :: lower_address(&f, node, variant.offset)
    if !variant.boxed -> return address
    wrapper :: lower_pointer(&f)
    lower_alloc(&m, &f, wrapper, lower_option_box_size(p, variant.ty))
    lower_emit(&f, LIRInst.Store{base: address, offset: 0, value: wrapper})
    wrapper
}

// :128-152: a byte (U8) List or [U8#N] is Dyn.Bytes of its bytes; any other
// is Dyn.Array of each element's encoding, in order.
fn lower_codec_encode_list(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, elem: MIRType, source: LIRValueID) -> LIRValueID Never! {
    if lower_codec_byte(elem) {
        bytes :: lower_codec_variant(p, tree, "Bytes") ?? return lower_codec_encode_fail(&m, &f, "checked Dyn has no Bytes payload")
        node :: lower_pointer(&f)
        payload :: lower_codec_node(p, &m, &f, tree, bytes, node)
        copied :: lower_pointer(&f)
        lower_clone_into(p, &m, &f, source, copied, bytes.ty)
        lower_copy_bytes(&f, payload, 0, copied, 0, lower_size(p, bytes.ty).size)
        return node
    }
    array :: lower_codec_variant(p, tree, "Array") ?? return lower_codec_encode_fail(&m, &f, "checked Dyn has no Array payload")
    node :: lower_pointer(&f)
    payload :: lower_codec_node(p, &m, &f, tree, array, node)
    count :: lower_list_word(&f, source, 0)
    stride :: lower_list_stride(p, tree)
    data :: lower_list_buffer(&m, &f, count, stride)
    lower_emit(&f, LIRInst.Store{base: payload, offset: 0, value: count})
    lower_emit(&f, LIRInst.Store{base: payload, offset: 8, value: count})
    lower_emit(&f, LIRInst.Store{base: payload, offset: 16, value: data})
    each :: lower_each_begin(p, &f, source, elem, [LIRValueID]{})
    value :: lower_read_at(p, &f, each.address, 0, elem) ?? return lower_codec_encode_fail(&m, &f, "Encode of a List element without storage is not lowered")
    encoded :: lower_pointer(&f)
    lower_codec_encode_into(p, &m, &f, elem, tree, value, encoded)
    slot :: lower_list_address(&f, data, each.at, stride)
    lower_write_at(p, &f, slot, 0, encoded, tree)
    lower_each_end(&f, each, [LIRValueID]{})
    node
}

// :153-161: None is Dyn.Null; Some(x) encodes as x.
fn lower_codec_encode_option(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, inner: MIRType, source: LIRValueID) -> LIRValueID Never! {
    absent_tag :: lower_codec_tag_of(p, tree, "Null") ?? return lower_codec_encode_fail(&m, &f, "checked Dyn has no Null variant")
    definition :: lower_type_def(p, tree) ?? return lower_codec_encode_fail(&m, &f, "checked Dyn has no definition")
    nothing :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: nothing, value: 0})
    present :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ne, left: source, right: nothing})
    some :: lower_new_block(&f)
    none :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(some, [LIRValueID]{}), else_target: lower_target(none, [LIRValueID]{})})
    lower_start(&f, some, [LIRValueID]{})
    value :: lower_read_at(p, &f, source, 0, inner) ?? return lower_codec_encode_fail(&m, &f, "Encode of an Option without stored value is not lowered")
    encoded :: lower_pointer(&f)
    lower_codec_encode_into(p, &m, &f, inner, tree, value, encoded)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{encoded})})
    lower_start(&f, none, [LIRValueID]{})
    node :: lower_pointer(&f)
    lower_alloc(&m, &f, node, lower_enum_box_size(p, definition))
    lower_store_word(&f, node, 0, absent_tag)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{node})})
    result :: lower_pointer(&f)
    lower_start(&f, merge, [LIRValueID]{result})
    result
}

// :162-178: Dyn.Object of the Map's key-ordered entries, each key copied and
// each value encoded.
fn lower_codec_encode_map(p: MIRProgram, m: &LowerModule, f: &LowerFunction, tree: MIRType, ty: MIRType, source: LIRValueID) -> LIRValueID Never! {
    shape :: lower_map_shape(p, ty) ?? return lower_codec_encode_fail(&m, &f, "Encode<{mir_type_display_name(ty)}> has no Map layout")
    object :: lower_codec_variant(p, tree, "Object") ?? return lower_codec_encode_fail(&m, &f, "checked Dyn has no Object payload")
    entry :: lower_list_element(object.ty) ?? return lower_codec_encode_fail(&m, &f, "Dyn.Object payload is not a List")
    members :: lower_inline_members(p, entry)
    if members.len() != 2 || members[0].name != "key" || members[1].name != "value" -> return lower_codec_encode_fail(&m, &f, "Dyn.Object entries need checked key/value members")
    node :: lower_pointer(&f)
    payload :: lower_codec_node(p, &m, &f, tree, object, node)
    count :: lower_list_word(&f, source, 0)
    stride :: lower_list_stride(p, entry)
    data :: lower_list_buffer(&m, &f, count, stride)
    lower_emit(&f, LIRInst.Store{base: payload, offset: 0, value: count})
    lower_emit(&f, LIRInst.Store{base: payload, offset: 8, value: count})
    lower_emit(&f, LIRInst.Store{base: payload, offset: 16, value: data})
    each :: lower_each_begin(p, &f, source, shape.entry, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, shape.key_offset, shape.key) ?? return lower_codec_encode_fail(&m, &f, "Map key has no storage")
    owned_key :: lower_new_like(&f, key)
    lower_clone_into(p, &m, &f, key, owned_key, shape.key)
    value :: lower_read_at(p, &f, each.address, shape.value_offset, shape.value) ?? return lower_codec_encode_fail(&m, &f, "Map value has no storage")
    encoded :: lower_pointer(&f)
    lower_codec_encode_into(p, &m, &f, shape.value, tree, value, encoded)
    slot :: lower_list_address(&f, data, each.at, stride)
    lower_write_at(p, &f, slot, members[0].offset, owned_key, members[0].ty)
    lower_write_at(p, &f, slot, members[1].offset, encoded, tree)
    lower_each_end(&f, each, [LIRValueID]{})
    node
}
