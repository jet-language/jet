// Native Set<T> and Rank<T> share the ordered Map<T, Unit> carrier.
// Set's iteration order is unspecified; Rank keeps the key's Ord order.
// The stored entry tuple (not the packed source List element) fixes stride.
use jet_foundation.[
    MIRCallArg, MIRInstruction, MIRPlaceID, MIRPreludeCall, MIRPreludeCallID,
    MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_nominal_ref,
    mir_type_display_name, mir_type_from_kind,
]

fn lower_set_element(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .Apply(name, args) -> {
            if (name.id == mir_nominal_ref("Set").id || name.id == mir_nominal_ref("Rank").id) && args.len() == 1 -> Val(args[0]) else -> None
        }
        .Tagged(_, inner) -> lower_set_element(inner)
        else -> None
    }
}

fn lower_rank_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> name.id == mir_nominal_ref("Rank").id && args.len() == 1
        .Tagged(_, inner) -> lower_rank_type(inner)
        else -> false
    }
}

fn lower_set_map(ty: MIRType) -> MIRType Never! {
    elem :: lower_set_element(ty) ?? panic("native Set carrier has no checked element")
    unit :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}})
    mir_type_from_kind(MIRTypeKind.Map{key: elem, value: unit})
}

fn lower_set_repr(p: MIRProgram, ty: MIRType, elem: MIRType) -> LowerRepr Never! {
    if lower_map_key_kind(p, elem) == "" -> return LowerRepr.Unsupported{reason: "Set element type {mir_type_display_name(elem)}"}
    LowerRepr.Inline{ty: ty}
}

fn lower_set_empty(p: MIRProgram, f: &LowerFunction, dst: LIRValueID, ty: MIRType) Never! {
    lower_storage_into(p, &f, dst, ty)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: zero})
}

// map.set consumes its offered key, dropping duplicates. Unit has no bytes
// or drop action; its helper ABI's unused word is zero.
fn lower_set_insert(p: MIRProgram, m: &LowerModule, f: &LowerFunction, set: LIRValueID, ty: MIRType, key: LIRValueID) Never! {
    unit :: lower_const(&f, 0)
    lower_call_helper(&m, &f, "map.set", lower_set_map(ty), [LIRValueID]{set, key, unit}, None)
}

// Copy keys to a genuine packed List; no container header or buffer aliases.
fn lower_set_list(p: MIRProgram, m: &LowerModule, f: &LowerFunction, set: LIRValueID, ty: MIRType, dst: LIRValueID) Never! {
    shape :: lower_map_shape(p, lower_set_map(ty)) ?? panic("native Set entry has no layout")
    length :: lower_list_word(&f, set, 0)
    data :: lower_list_buffer(&m, &f, length, lower_list_stride(p, shape.key))
    lower_emit(&f, LIRInst.StackSlot{dst: dst, size: 24, align: 8})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
    each :: lower_each_begin(p, &f, set, shape.entry, [LIRValueID]{})
    from :: lower_address(&f, each.address, shape.key_offset)
    to :: lower_list_address(&f, data, each.at, lower_list_stride(p, shape.key))
    lower_list_clone_element(p, &m, &f, from, to, shape.key)
    lower_each_end(&f, each, [LIRValueID]{})
}

// From consumes a List's elements once; borrowed inputs clone. An Iter is
// drained with the same canonical runtime boundary as Iter.to_list.
fn lower_set_from(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, source_id: MIRValueID) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Set construction has no checked result type")
    elem :: lower_set_element(ty) ?? return lower_fail(&m, &f, "Set construction has no checked element")
    source_ty :: lower_value_type(c, source_id) ?? return lower_fail(&m, &f, "Set construction has no checked source type")
    source :: lower_use(&m, &f, source_id) ?? return
    source_elem := lower_list_element(source_ty)
    input := source
    moved := lower_value_owned(c, source_id)
    if source_elem == None {
        source_elem = lower_lazy_element(source_ty)
        if source_elem == None -> return lower_fail(&m, &f, "Set construction source is neither List nor Iter")
        input = lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: input, size: 24, align: 8})
        lower_call_runtime(&m, &f, "jet_rt_native_iter_to_list", [LIRValueID]{source, input}, None)
        moved = true
    }
    if source_elem != Val(elem) -> return lower_fail(&m, &f, "Set construction source element differs from its checked result")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_set_empty(p, &f, dst, ty)
    // A consumed List gives up its elements and buffer: it must own them alone.
    if moved -> lower_list_make_unique(p, &m, &f, input, mir_type_from_kind(MIRTypeKind.List{inner: elem}))
    each :: lower_each_begin(p, &f, input, elem, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, 0, elem) ?? return
    owned := key
    if !moved {
        owned = lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned, elem)
    }
    lower_set_insert(p, &m, &f, dst, ty, owned)
    lower_each_end(&f, each, [LIRValueID]{})
    if moved {
        data :: lower_list_data(&f, input)
        cap :: lower_list_word(&f, input, 8)
        lower_list_free_buffer(&m, &f, data, cap, lower_list_stride(p, elem))
        // The MIR can retire the moved header later: it must see no elements
        // or allocation, since insertion already owns/dropped every key.
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: input, offset: 0, value: zero})
        lower_emit(&f, LIRInst.Store{base: input, offset: 8, value: zero})
        lower_emit(&f, LIRInst.Store{base: input, offset: 16, value: zero})
    }
}

fn lower_set_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    ty :: lower_checked_type(c, instruction) ?? return false
    if lower_set_element(ty) == None -> return false
    row :: lower_prelude_row(p, m, call) ?? return false
    symbol :: lower_runtime_symbol(row)
    rank :: lower_rank_type(ty)
    if symbol == (if rank -> "jet_sorted_set_from" else -> "jet_set_from") && args.len() == 1 {
        lower_set_from(p, c, &m, &f, instruction, args[0].value)
        return true
    }
    if symbol != (if rank -> "std::collections::BTreeSet::new" else -> "std::collections::HashSet::new") || args.len() != 0 -> return false
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_set_empty(p, &f, dst, ty)
    true
}

fn lower_set_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    symbol := lower_runtime_symbol(row)
    if symbol == "jet_set_from" || symbol == "jet_sorted_set_from" || symbol == "jet_iter_to_set" {
        if args.len() != 0 -> return false
        result_ty :: lower_checked_type(c, instruction) ?? return false
        if lower_set_element(result_ty) == None -> return false
        lower_set_from(p, c, &m, &f, instruction, receiver)
        return true
    }
    ty :: lower_value_type(c, receiver) ?? return false
    elem :: lower_set_element(ty) ?? return false
    rank :: lower_rank_type(ty)
    if rank {
        symbol = if symbol == {
            "jet_sorted_set_to_list" -> "jet_set_to_list"
            "jet_sorted_set_len" -> "jet_set_len"
            "jet_sorted_set_is_empty" -> "jet_set_is_empty"
            "jet_sorted_set_first" -> "jet_set_first"
            "jet_sorted_set_last" -> "jet_set_last"
            "jet_sorted_set_insert" -> "jet_set_insert"
            "jet_sorted_set_remove" -> "jet_set_remove"
            "jet_sorted_set_union" -> "jet_set_union"
            "jet_sorted_set_intersection" -> "jet_set_intersection"
            "std::collections::BTreeSet::contains" -> "jet_set_has"
            "std::collections::BTreeSet::clear" -> "std::collections::HashSet::clear"
            else -> { return false }
        }
    }
    if row.family != .BuiltinMethod || row.module_name != "core.builtin" -> return false
    if !symbol.starts_with("jet_set_") && symbol != "std::collections::HashSet::clear" -> return false
    shape :: lower_map_shape(p, lower_set_map(ty)) ?? return false
    mutates :: symbol == "jet_set_insert" || symbol == "jet_set_remove" || symbol == "jet_set_pop_kernel" || symbol == "jet_set_replace_kernel" || symbol == "std::collections::HashSet::clear"
    set :: if mutates -> lower_receiver_header(p, c, &m, &f, receiver_place, "Set") ?? return true else -> lower_use(&m, &f, receiver) ?? return true
    if symbol == "std::collections::HashSet::clear" {
        if args.len() != 0 -> return false
        data :: lower_list_data(&f, set)
        lower_list_drop_elements(p, &m, &f, set, data, shape.entry)
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Store{base: set, offset: 0, value: zero})
        lower_alias_absent(&f, instruction)
        return true
    }
    if symbol == "jet_set_len" || symbol == "jet_set_capacity" || symbol == "jet_set_is_empty" {
        if args.len() != 0 -> return false
        length :: lower_list_word(&f, set, if symbol == "jet_set_capacity" -> 8 else -> 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_set_is_empty" {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        } else {
            lower_native_count(p, c, &m, &f, instruction, dst, length)
        }
        return true
    }
    if symbol == "jet_set_to_list" || symbol == "jet_set_sort" || symbol == "jet_set_values" {
        if args.len() != 0 -> return false
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_set_values" {
            items :: lower_pointer(&f)
            lower_set_list(p, &m, &f, set, ty, items)
            meta :: lower_lazy_meta(p, &m, &f, elem)
            moved :: lower_const_flag(&f, 1)
            lower_call_runtime(&m, &f, "jet_rt_native_iter_from_list", [LIRValueID]{items, meta, moved}, Val(dst))
        } else {
            lower_set_list(p, &m, &f, set, ty, dst)
        }
        return true
    }
    if rank && (symbol == "jet_set_first" || symbol == "jet_set_last") {
        if args.len() != 0 -> return false
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, if symbol == "jet_set_first" -> "set.first" else -> "set.last", ty, [LIRValueID]{set}, Val(dst))
        return true
    }
    if rank && symbol == "jet_set_insert" {
        if args.len() != 1 -> return false
        key :: lower_use(&m, &f, args[0]) ?? return true
        offered := key
        if !lower_value_owned(c, args[0]) {
            offered = lower_new_like(&f, key)
            lower_clone_into(p, &m, &f, key, offered, elem)
        }
        lower_set_insert(p, &m, &f, set, ty, offered)
        lower_alias_absent(&f, instruction)
        return true
    }
    if rank && symbol == "jet_set_remove" {
        if args.len() != 1 -> return false
        key :: lower_use(&m, &f, args[0]) ?? return true
        lower_call_helper(&m, &f, "set.remove", ty, [LIRValueID]{set, key}, None)
        if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, key, elem)
        lower_alias_absent(&f, instruction)
        return true
    }
    if symbol == "jet_set_has" || symbol == "jet_set_insert" || symbol == "jet_set_remove" || symbol == "jet_set_pop_kernel" || symbol == "jet_set_replace_kernel" {
        if args.len() != 1 -> return false
        key :: lower_use(&m, &f, args[0]) ?? return true
        if symbol == "jet_set_has" || symbol == "jet_set_insert" {
            found :: lower_word(&f)
            lower_call_helper(&m, &f, "map.find", lower_set_map(ty), [LIRValueID]{set, key}, Val(found))
            zero :: lower_const(&f, 0)
            dst :: lower_result(p, c, &m, &f, instruction) ?? return true
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: if symbol == "jet_set_has" -> LIRCondition.Ge else -> LIRCondition.Lt, left: found, right: zero})
            if symbol == "jet_set_insert" {
                offered := key
                if !lower_value_owned(c, args[0]) {
                    offered = lower_new_like(&f, key)
                    lower_clone_into(p, &m, &f, key, offered, elem)
                }
                lower_set_insert(p, &m, &f, set, ty, offered)
            }
            return true
        }
        if symbol == "jet_set_replace_kernel" {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return true
            lower_call_helper(&m, &f, "set.take", ty, [LIRValueID]{set, key}, Val(dst))
            offered := key
            if !lower_value_owned(c, args[0]) {
                offered = lower_new_like(&f, key)
                lower_clone_into(p, &m, &f, key, offered, elem)
            }
            lower_set_insert(p, &m, &f, set, ty, offered)
        } else {
            if symbol == "jet_set_pop_kernel" {
                dst :: lower_result(p, c, &m, &f, instruction) ?? return true
                lower_call_helper(&m, &f, "set.take", ty, [LIRValueID]{set, key}, Val(dst))
            } else {
                taken :: lower_pointer(&f)
                lower_call_helper(&m, &f, "set.take", ty, [LIRValueID]{set, key}, Val(taken))
                optional :: mir_type_from_kind(MIRTypeKind.Option{inner: elem})
                lower_map_drop_value(p, &m, &f, taken, optional)
                lower_alias_absent(&f, instruction)
            }
        }
        if symbol == "jet_set_remove" && lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, key, elem)
        return true
    }
    if symbol == "jet_set_equal" {
        if args.len() != 1 -> return false
        other :: lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "set.equal", ty, [LIRValueID]{set, other}, Val(dst))
        return true
    }
    if symbol == "jet_set_union" {
        if args.len() != 1 -> return false
        other :: lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_storage_into(p, &f, dst, ty)
        lower_inline_clone(p, &m, &f, set, dst, ty)
        each :: lower_each_begin(p, &f, other, shape.entry, [LIRValueID]{})
        key :: lower_read_at(p, &f, each.address, shape.key_offset, elem) ?? return true
        owned :: lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned, elem)
        lower_set_insert(p, &m, &f, dst, ty, owned)
        lower_each_end(&f, each, [LIRValueID]{})
        return true
    }
    if rank && symbol == "jet_set_intersection" {
        if args.len() != 1 -> return false
        other :: lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_set_empty(p, &f, dst, ty)
        // The Map intersection kernel specialized to Unit: keep shared keys,
        // clone each kept key, and insert through the same ordered carrier.
        each :: lower_each_begin(p, &f, set, shape.entry, [LIRValueID]{})
        key :: lower_read_at(p, &f, each.address, shape.key_offset, elem) ?? return true
        found :: lower_word(&f)
        lower_call_helper(&m, &f, "map.find", lower_set_map(ty), [LIRValueID]{other, key}, Val(found))
        zero :: lower_const(&f, 0)
        shared :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: shared, condition: LIRCondition.Ge, left: found, right: zero})
        keep :: lower_new_block(&f)
        skip :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: shared, then_target: lower_target(keep, [LIRValueID]{}), else_target: lower_target(skip, [LIRValueID]{})})
        lower_start(&f, keep, [LIRValueID]{})
        owned :: lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned, elem)
        lower_set_insert(p, &m, &f, dst, ty, owned)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(skip, [LIRValueID]{})})
        lower_start(&f, skip, [LIRValueID]{})
        lower_each_end(&f, each, [LIRValueID]{})
        return true
    }
    false
}

// Take the stored key, not Unit. The generic map.remove helper owns/drops
// its key and returns its value, so it cannot express Set.pop/replace.
fn lower_helper_set_take(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Set take has no entry layout")
    discard :: glue.helper == "set.remove"
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lower_map_key_layout(p, shape)}, if discard -> None else -> Val(lir_layout_pointer()))
    set :: f.open_params[0].copy()
    key :: f.open_params[1].copy()
    found :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", lower_set_map(glue.ty), [LIRValueID]{set, key}, Val(found))
    zero :: lower_const(&f, 0)
    present :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ge, left: found, right: zero})
    hit :: lower_new_block(&f)
    miss :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
    lower_start(&f, miss, [LIRValueID]{})
    absent := LIRValueID?{None}
    if !discard {
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        absent = Val(null)
    }
    lower_seal(&f, LIRTerminator.Return{value: absent})
    lower_start(&f, hit, [LIRValueID]{})
    data :: lower_list_data(&f, set)
    entry :: lower_list_address(&f, data, found, shape.stride)
    taken := LIRValueID?{None}
    if discard -> lower_drop_stored(p, &m, &f, entry, shape.key_offset, shape.key)
    else {
        boxed :: lower_pointer(&f)
        lower_alloc(&m, &f, boxed, lower_option_box_size(p, shape.key))
        lower_list_move(p, &f, boxed, entry, shape.key)
        taken = Val(boxed)
    }
    length :: lower_list_word(&f, set, 0)
    one :: lower_const(&f, 1)
    last :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{found})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: last})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    from :: lower_list_address(&f, data, next_at, shape.stride)
    to :: lower_list_address(&f, data, at, shape.stride)
    lower_list_move(p, &f, to, from, shape.entry)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: set, offset: 0, value: last})
    lower_seal(&f, LIRTerminator.Return{value: taken})
    lir_builder_finish(f.builder)
}

fn lower_helper_set_edge(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Rank edge has no entry layout")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    set :: f.open_params[0].copy()
    length :: lower_list_word(&f, set, 0)
    zero :: lower_const(&f, 0)
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: length, right: zero})
    miss :: lower_new_block(&f)
    hit :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(miss, [LIRValueID]{}), else_target: lower_target(hit, [LIRValueID]{})})
    lower_start(&f, miss, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    lower_start(&f, hit, [LIRValueID]{})
    at := zero
    if glue.helper == "set.last" {
        at = lower_word(&f)
        one :: lower_const(&f, 1)
        lower_emit(&f, LIRInst.Binary{dst: at, op: LIRBinaryOp.Sub, left: length, right: one})
    }
    data :: lower_list_data(&f, set)
    entry :: lower_list_address(&f, data, at, shape.stride)
    source :: lower_address(&f, entry, shape.key_offset)
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, lower_option_box_size(p, shape.key))
    lower_list_clone_element(p, &m, &f, source, boxed, shape.key)
    lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
    lir_builder_finish(f.builder)
}

// Rank renders the stored key order directly, never sorted rendered text.
fn lower_helper_rank_render(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Rank render has no entry layout")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    set :: f.open_params[0].copy()
    mode :: if glue.helper == "show" -> LowerRenderMode.Show else if glue.helper == "debug" -> LowerRenderMode.Debug else -> LowerRenderMode.Display
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "[")
    each :: lower_each_begin(p, &f, set, shape.entry, [LIRValueID]{})
    zero :: lower_const(&f, 0)
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Eq, left: each.at, right: zero})
    item :: lower_new_block(&f)
    comma :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(item, [LIRValueID]{}), else_target: lower_target(comma, [LIRValueID]{})})
    lower_start(&f, comma, [LIRValueID]{})
    lower_render_static(&m, &f, builder, ", ")
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(item, [LIRValueID]{})})
    lower_start(&f, item, [LIRValueID]{})
    key :: lower_render_load(p, &f, each.address, shape.key_offset, shape.key, false)
    lower_render_push(p, &m, &f, builder, shape.key, key, mode)
    lower_each_end(&f, each, [LIRValueID]{})
    lower_render_static(&m, &f, builder, "]")
    result :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(result))
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}

fn lower_helper_set_equal(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Set equality has no entry layout")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_bool()))
    left :: f.open_params[0].copy()
    right :: f.open_params[1].copy()
    left_len :: lower_list_word(&f, left, 0)
    right_len :: lower_list_word(&f, right, 0)
    equal_len :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: equal_len, condition: LIRCondition.Eq, left: left_len, right: right_len})
    scan :: lower_new_block(&f)
    no :: lower_new_block(&f)
    yes :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: equal_len, then_target: lower_target(scan, [LIRValueID]{}), else_target: lower_target(no, [LIRValueID]{})})
    lower_start(&f, scan, [LIRValueID]{})
    right_data :: lower_list_data(&f, right)
    each :: lower_each_begin(p, &f, left, shape.entry, [LIRValueID]{})
    other :: lower_list_address(&f, right_data, each.at, shape.stride)
    a :: lower_read_at(p, &f, each.address, shape.key_offset, shape.key) ?? panic("Set key has no layout")
    b :: lower_read_at(p, &f, other, shape.key_offset, shape.key) ?? panic("Set key has no layout")
    order :: lower_map_key_order(p, &m, &f, shape.key, a, b)
    step :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: order.same, then_target: lower_target(step, [LIRValueID]{}), else_target: lower_target(no, [LIRValueID]{})})
    lower_start(&f, step, [LIRValueID]{})
    lower_each_end(&f, each, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(yes, [LIRValueID]{})})
    lower_start(&f, yes, [LIRValueID]{})
    same :: lower_const_flag(&f, 1)
    lower_seal(&f, LIRTerminator.Return{value: Val(same)})
    lower_start(&f, no, [LIRValueID]{})
    different :: lower_const_flag(&f, 0)
    lower_seal(&f, LIRTerminator.Return{value: Val(different)})
    lir_builder_finish(f.builder)
}

// HashSet's three render modes sort their rendered strings, not keys:
// Set.from([2, 10]) renders [10, 2] (Values.rs / TextValues.rs).
fn lower_helper_set_render(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    if lower_rank_type(glue.ty) -> return lower_helper_rank_render(p, &m, glue)
    shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Set render has no entry layout")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    set :: f.open_params[0].copy()
    mode :: if glue.helper == "show" -> LowerRenderMode.Show else if glue.helper == "debug" -> LowerRenderMode.Debug else -> LowerRenderMode.Display
    string_ty :: mir_type_from_kind(MIRTypeKind.String)
    list_ty :: mir_type_from_kind(MIRTypeKind.List{inner: string_ty})
    length :: lower_list_word(&f, set, 0)
    data :: lower_list_buffer(&m, &f, length, lower_list_stride(p, string_ty))
    parts :: lower_new_storage(p, &f, list_ty)
    lower_emit(&f, LIRInst.Store{base: parts, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: parts, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: parts, offset: 16, value: data})
    render :: lower_each_begin(p, &f, set, shape.entry, [LIRValueID]{})
    key :: lower_render_load(p, &f, render.address, shape.key_offset, shape.key, false)
    text :: lower_render_value(p, &m, &f, shape.key, key, mode) ?? {
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    owned := text.value
    if !text.owned {
        owned = lower_render_string(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_clone", [LIRValueID]{text.value}, Val(owned))
    }
    target :: lower_list_address(&f, data, render.at, lower_list_stride(p, string_ty))
    lower_write_at(p, &f, target, 0, owned, string_ty)
    lower_each_end(&f, render, [LIRValueID]{})
    lower_call_helper(&m, &f, "list.sort", list_ty, [LIRValueID]{parts}, None)
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    lower_render_static(&m, &f, builder, "[")
    join :: lower_each_begin(p, &f, parts, string_ty, [LIRValueID]{})
    zero :: lower_const(&f, 0)
    first :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: first, condition: LIRCondition.Eq, left: join.at, right: zero})
    item :: lower_new_block(&f)
    comma :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: first, then_target: lower_target(item, [LIRValueID]{}), else_target: lower_target(comma, [LIRValueID]{})})
    lower_start(&f, comma, [LIRValueID]{})
    lower_render_static(&m, &f, builder, ", ")
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(item, [LIRValueID]{})})
    lower_start(&f, item, [LIRValueID]{})
    part :: lower_read_at(p, &f, join.address, 0, string_ty) ?? panic("rendered Set part has no layout")
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, part}, None)
    lower_each_end(&f, join, [LIRValueID]{})
    lower_render_static(&m, &f, builder, "]")
    finished :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(finished))
    lower_map_drop_value(p, &m, &f, parts, list_ty)
    lower_seal(&f, LIRTerminator.Return{value: Val(finished)})
    lir_builder_finish(f.builder)
}

// Tally<T> reuses the ordered Map<T,U64> entry carrier. Counts are nonzero;
// its public length is the sum, not the header's distinct-key length.
fn lower_tally_element(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .Apply(name, args) -> {
            if name.id == mir_nominal_ref("Tally").id && args.len() == 1 -> Val(args[0]) else -> None
        }
        .Tagged(_, inner) -> lower_tally_element(inner)
        else -> None
    }
}

fn lower_tally_count_type() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 64})
}

fn lower_tally_map(ty: MIRType) -> MIRType Never! {
    elem :: lower_tally_element(ty) ?? panic("native Tally carrier has no checked element")
    mir_type_from_kind(MIRTypeKind.Map{key: elem, value: lower_tally_count_type()})
}

fn lower_tally_new(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRCallArg]) -> Bool Never! {
    ty :: lower_checked_type(c, instruction) ?? return false
    if lower_tally_element(ty) == None -> return false
    row :: lower_prelude_row(p, m, call) ?? return false
    if lower_runtime_symbol(row) != "std::collections::HashMap::new" || args.len() != 0 -> return false
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_set_empty(p, &f, dst, ty)
    true
}

fn lower_tally_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    ty :: lower_value_type(c, receiver) ?? return false
    elem :: lower_tally_element(ty) ?? return false
    if row.family != .BuiltinMethod || row.module_name != "core.builtin" -> return false
    symbol :: lower_runtime_symbol(row)
    adding :: symbol == "jet_bag_add"
    removing :: symbol == "jet_bag_remove"
    querying :: symbol == "jet_bag_count" || symbol == "jet_bag_has"
    counted :: symbol == "jet_bag_len" || symbol == "jet_bag_is_empty"
    clearing :: symbol == "std::collections::HashMap::clear"
    if !adding && !removing && !querying && !counted && !clearing -> return false
    if args.len() != (if counted || clearing -> 0 else -> 1) {
        lower_fail(&m, &f, "Tally {row.member} has no checked arguments")
        return true
    }
    carrier :: lower_tally_map(ty)
    shape :: lower_map_shape(p, carrier) ?? return false
    tally :: if adding || removing || clearing -> lower_receiver_header(p, c, &m, &f, receiver_place, "Tally") ?? return true else -> lower_use(&m, &f, receiver) ?? return true
    if clearing {
        data :: lower_list_data(&f, tally)
        lower_list_drop_elements(p, &m, &f, tally, data, shape.entry)
        lower_store_word(&f, tally, 0, 0)
        lower_alias_absent(&f, instruction)
        return true
    }
    if counted {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        zero :: lower_const(&f, 0)
        if symbol == "jet_bag_is_empty" {
            length :: lower_list_word(&f, tally, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        } else {
            each :: lower_each_begin(p, &f, tally, shape.entry, [LIRValueID]{zero})
            count :: lower_list_word(&f, each.address, shape.value_offset)
            sum :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: sum, op: LIRBinaryOp.Add, left: each.state[0], right: count})
            lower_each_end(&f, each, [LIRValueID]{sum})
            lower_native_count(p, c, &m, &f, instruction, dst, each.exit[0])
        }
        return true
    }
    key :: lower_use(&m, &f, args[0]) ?? return true
    if adding {
        offered := key
        if !lower_value_owned(c, args[0]) {
            offered = lower_new_like(&f, key)
            lower_clone_into(p, &m, &f, key, offered, elem)
        }
        one :: lower_const(&f, 1)
        lower_call_helper(&m, &f, "map.increment", carrier, [LIRValueID]{tally, offered, one}, None)
        lower_alias_absent(&f, instruction)
    } else if removing {
        lower_call_helper(&m, &f, "map.decrement", carrier, [LIRValueID]{tally, key}, None)
        if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, key, elem)
        lower_alias_absent(&f, instruction)
    } else {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        count :: lower_word(&f)
        lower_call_helper(&m, &f, "map.count", carrier, [LIRValueID]{tally, key}, Val(count))
        if symbol == "jet_bag_count" -> lower_native_count(p, c, &m, &f, instruction, dst, count)
        else {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ne, left: count, right: zero})
        }
    }
    true
}
