// Typed scans only marshal descriptors and ownership. Matching, numeric
// parsing, error text and failure-atomic advancement belong to the shared runtime.
use jet_foundation.[
    MIRAccess, MIRBinaryPatternPart, MIRInstruction, MIRPlaceID, MIRProgram, MIRTextPatternPart,
    MIRType, MIRValueID,
]

struct LowerScanPart {
    descriptor: Int
    a: LIRValueID
    b: LIRValueID
    width: Int
    storage: Int
    destination: LIRValueID
}

fn lower_scan_slot(f: &LowerFunction, size: Int) -> LIRValueID Never! {
    slot :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: slot, size: if size < 8 -> 8 else -> size, align: 8})
    slot
}

fn lower_scan_storage(p: MIRProgram, ty: MIRType) -> Int Never! {
    if lower_is_exact_int(ty) -> return 1
    if lower_repr(p, ty) == .FloatBits -> return 2
    if lower_repr(p, ty) == .Flag -> return 3
    if lower_text_type(ty) -> return 4
    if lower_list_element(ty) == .Val(elem) && elem.kind == .IntN(signed, bits) && !signed && bits == 8 -> return 6
    if lower_packed_storage_type(p, ty) == .Val(stored) && stored.kind == .IntN(_, _) -> return 0
    return -1
}

fn lower_scan_rows(f: &LowerFunction, parts: [LowerScanPart]) -> LIRValueID Never! {
    rows :: lower_scan_slot(&f, 64 * parts.len())
    loop (index, part) in parts {
        at :: 64 * index
        lower_store_word(&f, rows, at, part.descriptor)
        lower_emit(&f, LIRInst.Store{base: rows, offset: at + 8, value: part.a})
        lower_emit(&f, LIRInst.Store{base: rows, offset: at + 16, value: part.b})
        lower_store_word(&f, rows, at + 24, part.width)
        lower_emit(&f, LIRInst.Store{base: rows, offset: at + 32, value: part.destination})
        lower_store_word(&f, rows, at + 40, part.storage)
        lower_store_word(&f, rows, at + 48, 0)
        lower_store_word(&f, rows, at + 56, 0)
    }
    rows
}

// Captures live in disjoint frame slots until the runtime reports success.
// Only then is the owning Option/Result allocated and populated; a miss never
// reads uninitialized destinations or drops a payload that was not produced.
fn lower_scan_finish(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, hit: LIRValueID, payload: MIRType, parts: [LowerScanPart], error: LIRValueID?) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "typed scan has no checked result type")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    taking :: error != None
    success :: lower_new_block(&f)
    failure :: lower_new_block(&f)
    join :: lower_new_block(&f)
    flag :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: flag, condition: LIRCondition.Ne, left: hit, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: flag, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
    box :: lower_pointer(&f)
    lower_alloc(&m, &f, box, lower_box_size(p, ty))
    offset :: if taking -> 8 else -> 0
    if taking -> lower_store_word(&f, box, 0, 1)
    members :: lower_inline_members(p, payload)
    capture := 0
    loop part in parts {
        if part.descriptor == 0 || part.descriptor == 16 -> next
        if part.storage == 5 -> next
        member :: members[capture]
        if part.storage == 6 {
            header :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Load{dst: header, base: part.destination, offset: 0})
            lower_copy_bytes(&f, box, offset + member.offset, header, 0, 24)
            lower_free_shell(&m, &f, header, 24)
        } else {
            value :: lower_read_at(p, &f, part.destination, 0, member.ty) ?? return
            lower_write_at(p, &f, box, offset + member.offset, value, member.ty)
        }
        capture += 1
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{box})})
    lower_start(&f, failure, [LIRValueID]{})
    missed :: lower_pointer(&f)
    if error == .Val(slot) {
        lower_alloc(&m, &f, missed, lower_box_size(p, ty))
        lower_store_word(&f, missed, 0, 0)
        message :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: message, base: slot, offset: 0})
        lower_emit(&f, LIRInst.Store{base: missed, offset: 8, value: message})
    } else {
        lower_emit(&f, LIRInst.Const{dst: missed, value: 0})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{missed})})
    lower_start(&f, join, [LIRValueID]{dst})
}

fn lower_scan_payload(c: LowerContext, instruction: MIRInstruction, taking: Bool) -> MIRType? {
    ty :: lower_checked_type(c, instruction) ?? return None
    if taking && ty.kind == .Result(ok, err) && err.kind == .String -> return Val(ok)
    if !taking && ty.kind == .Option(inner) -> return Val(inner)
    None
}

fn lower_scan_binary_parts(p: MIRProgram, m: &LowerModule, f: &LowerFunction, payload: MIRType, pattern: [MIRBinaryPatternPart], taking: Bool) -> [LowerScanPart]? {
    members :: lower_inline_members(p, payload)
    discard :: !taking && members.len() == 0
    parts := [LowerScanPart]{}
    capture := 0
    loop part in pattern {
        zero :: lower_const(&f, 0)
        if part == .Literal(bytes) {
            id :: LIRDataID{value: m.data.len()}
            &m.data.push(LIRData{id: id, bytes: bytes.copy(), align: 1, relocs: [LIRDataReloc]{}})
            address :: lower_pointer(&f)
            lower_emit(&f, LIRInst.DataAddress{dst: address, data: id})
            &parts.push(LowerScanPart{descriptor: 16, a: address, b: lower_const(&f, bytes.len()), width: 0, storage: 0, destination: zero})
            next
        }
        if !discard && capture >= members.len() {
            lower_fail(&m, &f, "binary scan captures disagree with its checked tuple")
            return None
        }
        storage := 5
        width := 8
        if !discard {
            ty :: members[capture].ty
            storage = lower_scan_storage(p, ty)
            width = if storage == 6 -> lower_list_stride(p, lower_list_element(ty) ?? return None) else -> lower_size(p, ty).size
        }
        descriptor := 17
        a := zero
        b := zero
        if part == {
            .Bits(bits, _, little, _) -> {
                a = lower_const(&f, Int.from_u8(bits))
                b = lower_const(&f, if little -> 1 else -> 0)
                if !discard && storage != 0 {
                    lower_fail(&m, &f, "binary bit capture requires its checked fixed integer storage")
                    return None
                }
            }
            .Rest(_, _) -> {
                descriptor = 18
                if !discard && storage != 6 {
                    lower_fail(&m, &f, "binary rest capture requires List<U8> storage")
                    return None
                }
            }
            else -> return None
        }
        &parts.push(LowerScanPart{descriptor: descriptor, a: a, b: b, width: width, storage: storage, destination: if discard -> zero else -> lower_scan_slot(&f, 8)})
        capture += 1
    }
    if !discard && capture != members.len() {
        lower_fail(&m, &f, "binary scan has unused checked tuple members")
        return None
    }
    Val(parts)
}

fn lower_scan_text_parts(p: MIRProgram, m: &LowerModule, f: &LowerFunction, payload: MIRType, pattern: [MIRTextPatternPart], taking: Bool) -> [LowerScanPart]? {
    members :: lower_inline_members(p, payload)
    discard :: !taking && members.len() == 0
    parts := [LowerScanPart]{}
    capture := 0
    loop part in pattern {
        zero :: lower_const(&f, 0)
        if part == .Literal(text) {
            literal :: lower_static_text(&m, &f, text)
            &parts.push(LowerScanPart{descriptor: 0, a: literal[0], b: literal[1], width: 0, storage: 0, destination: zero})
            next
        }
        if part == .Hole(kind, _, _) {
            if !discard && capture >= members.len() {
                lower_fail(&m, &f, "text scan captures disagree with its checked tuple")
                return None
            }
            descriptor :: if kind == {
                .Text -> 1
                .Int -> 2
                .Float -> 3
                .Bool -> 4
                .InlineRange(_, _) -> 5
            }
            a := zero
            b := zero
            if kind == .InlineRange(lo, hi) {
                a = lower_const(&f, lo)
                b = lower_const(&f, hi)
            }
            storage :: if discard -> 5 else -> lower_scan_storage(p, members[capture].ty)
            if !discard && storage != (if descriptor == 1 -> 4 else if descriptor == 3 -> 2 else if descriptor == 4 -> 3 else -> 1) {
                lower_fail(&m, &f, "text scan capture representation disagrees with its typed descriptor")
                return None
            }
            &parts.push(LowerScanPart{descriptor: descriptor, a: a, b: b, width: 0, storage: storage, destination: if discard -> zero else -> lower_scan_slot(&f, 8)})
            capture += 1
        }
    }
    if !discard && capture != members.len() {
        lower_fail(&m, &f, "text scan has unused checked tuple members")
        return None
    }
    Val(parts)
}

// The receiver remains an opaque runtime handle. Its current buffer and
// position, lifetime and success-only commit are projected by the provider,
// not by a backend-local guess at Cursor/Reader offsets.
fn lower_scan_take(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, receiver_place: MIRPlaceID, text: [MIRTextPatternPart]?, binary: [MIRBinaryPatternPart]?) Never! {
    taking_binary :: binary != None
    carrier :: if taking_binary -> "JetReader" else -> "JetCursor"
    ty :: lower_value_type(c, receiver) ?? return lower_fail(&m, &f, "scan receiver has no checked type")
    place :: lower_place_row(c.mir, receiver_place) ?? return lower_fail(&m, &f, "scan receiver has no checked place")
    if place.access == .Read || !lower_route_carrier_matches(p, ty, LowerRouteCarrier.HandleMut{name: carrier}) -> return lower_fail(&m, &f, "typed scan requires its canonical writable {carrier} handle")
    payload :: lower_scan_payload(c, instruction, true) ?? return lower_fail(&m, &f, "take_pattern requires its checked Result<Tuple, String> carrier")
    tuple :: if payload.kind == .Tuple(_) -> true else -> false
    if !tuple && lower_repr(p, payload) != .Absent -> return lower_fail(&m, &f, "take_pattern success payload is not a tuple or Unit")
    value :: lower_use(&m, &f, receiver) ?? return
    if binary == None && text == None -> return lower_fail(&m, &f, "take_pattern has no descriptors")
    parts :: (if binary == .Val(pattern) -> lower_scan_binary_parts(p, &m, &f, payload, pattern, true) else if text == .Val(pattern) -> lower_scan_text_parts(p, &m, &f, payload, pattern, true) else -> None) ?? return
    rows :: lower_scan_rows(&f, parts)
    error :: lower_scan_slot(&f, 8)
    hit :: lower_word(&f)
    symbol :: if taking_binary -> "jet_rt_reader_take_pattern" else -> "jet_rt_cursor_take_pattern"
    count :: lower_const(&f, parts.len())
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{value, rows, count, error}, Val(hit))
    lower_scan_finish(p, c, &m, &f, instruction, hit, payload, parts, Val(error))
}

fn lower_scan_match(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, subject: MIRValueID, text: [MIRTextPatternPart]?, binary: [MIRBinaryPatternPart]?) Never! {
    payload :: lower_scan_payload(c, instruction, false) ?? return lower_fail(&m, &f, "pattern match requires its checked Option<Tuple> carrier")
    tuple :: if payload.kind == .Tuple(_) -> true else -> false
    if !tuple -> return lower_fail(&m, &f, "pattern match payload is not a tuple")
    ty :: lower_value_type(c, subject) ?? return lower_fail(&m, &f, "pattern subject has no checked type")
    value :: lower_use(&m, &f, subject) ?? return
    data := lower_pointer(&f)
    length := lower_word(&f)
    stride := 1
    parts := [LowerScanPart]{}
    symbol := "jet_rt_text_pattern_match"
    if binary == .Val(pattern) {
        elem :: lower_list_element(ty) ?? return lower_fail(&m, &f, "binary scan subject is not List<U8>")
        byte :: if elem.kind == .IntN(signed, bits) -> !signed && bits == 8 else -> false
        if !byte -> return lower_fail(&m, &f, "binary scan subject is not List<U8>")
        data = lower_list_data(&f, value)
        length = lower_list_word(&f, value, 0)
        stride = lower_list_stride(p, elem)
        parts = lower_scan_binary_parts(p, &m, &f, payload, pattern, false) ?? return
        symbol = "jet_rt_binary_pattern_match"
    } else if text == .Val(pattern) {
        if !lower_text_type(ty) -> return lower_fail(&m, &f, "text scan subject is not the canonical text carrier")
        lower_call_runtime(&m, &f, "jet_rt_string_data", [LIRValueID]{value}, Val(data))
        lower_call_runtime(&m, &f, "jet_rt_string_byte_len", [LIRValueID]{value}, Val(length))
        parts = lower_scan_text_parts(p, &m, &f, payload, pattern, false) ?? return
    } else {
        return lower_fail(&m, &f, "pattern match has no descriptors")
    }
    rows :: lower_scan_rows(&f, parts)
    hit :: lower_word(&f)
    input_stride :: lower_const(&f, stride)
    count :: lower_const(&f, parts.len())
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{data, length, input_stride, rows, count}, Val(hit))
    lower_scan_finish(p, c, &m, &f, instruction, hit, payload, parts, None)
}

fn lower_pattern_capture(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, matched: MIRValueID, index: Int) Never! {
    ty :: lower_value_type(c, matched) ?? return lower_fail(&m, &f, "pattern capture has no producer type")
    payload :: (if ty.kind == {
        .Option(inner) -> Val(inner)
        .Result(ok, _) -> Val(ok)
        else -> None
    }) ?? return lower_fail(&m, &f, "pattern capture producer is not a scan carrier")
    members :: lower_inline_members(p, payload)
    tuple :: if payload.kind == .Tuple(_) -> true else -> false
    if !tuple || index < 0 || index >= members.len() -> return lower_fail(&m, &f, "pattern capture has no typed descriptor at index {index}")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "pattern capture has no checked result type")
    if result_ty != members[index].ty -> return lower_fail(&m, &f, "pattern capture disagrees with its checked tuple member")
    box :: lower_use(&m, &f, matched) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    // PatternCapture always clones the borrowed match tuple (the seed emitter's
    // as_ref().unwrap().index.clone()), including owning String/List members.
    source :: lower_read_at(p, &f, box, (if ty.kind == .Result(_, _) -> lower_result_payload_offset() else -> 0) + members[index].offset, result_ty) ?? return
    lower_clone_into(p, &m, &f, source, dst, result_ty)
}

// A scan carrier tests like its producer: Option<Tuple> is a nullable box
// (OptionIsSome's pointer compare against a null pointer), Result<Tuple,
// String> stores its selector word at offset 0.
fn lower_pattern_matched(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, matched: MIRValueID) Never! {
    ty :: lower_value_type(c, matched) ?? return lower_fail(&m, &f, "pattern test has no producer type")
    value :: lower_use(&m, &f, matched) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if ty.kind == .Result(_, _) {
        selector :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: selector, base: value, offset: 0})
        failed :: lower_const(&f, lower_result_selector(false))
        return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ne, left: selector, right: failed})
    }
    optional :: if ty.kind == .Option(_) -> true else -> false
    if !optional -> return lower_fail(&m, &f, "pattern test producer is not a scan carrier")
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ne, left: value, right: null})
}
