// Compiler-owned native layouts. This is boundary metadata, not a second
// codec policy: every size/offset comes from the ordinary lowering layout.
use jet_foundation.[MIRFunctionID, MIRProgram, MIRType, MIRTypeKind, mir_nominal_ref, mir_type_display_name, mir_type_from_kind]
struct X64ValueMember {
    name: String
    offset: Int
    descriptor: Int
    boxed: Bool
}
struct X64ValueVariant {
    name: String
    selector: Int
    members: [X64ValueMember]
    named: Bool{true}
}
struct X64ValueDescriptor {
    kind: String
    name: String
    size: Int
    align: Int
    stride: Int{0}
    children: [Int]{[Int]{}}
    members: [X64ValueMember]{[X64ValueMember]{}}
    variants: [X64ValueVariant]{[X64ValueVariant]{}}
}
struct X64ValueBoundary {
    root: Int
    descriptors: [X64ValueDescriptor]
    errors: [String]
}
struct LIRClosureValueLayout {
    code: LIRFunctionID
    release: LIRFunctionID?
    function: MIRFunctionID
    boundary: X64ValueBoundary
    captures: [X64ValueMember]
}

struct LowerValueBoundary {
    rows: [String:Int]
    descriptors: [X64ValueDescriptor]
    errors: [String]
}

fn lower_value_members(p: MIRProgram, state: &LowerValueBoundary, members: [LowerMember]) -> [X64ValueMember] Never! {
    rows := [X64ValueMember]{}
    loop member in members {
        descriptor :: lower_value_descriptor(p, &state, member.ty)
        &rows.push(X64ValueMember{name: member.name, offset: member.offset, descriptor: descriptor, boxed: member.boxed})
    }
    rows
}

fn lower_value_descriptor(p: MIRProgram, state: &LowerValueBoundary, ty: MIRType) -> Int Never! {
    key :: lower_mono_fingerprint(ty)
    if state.rows.get(key) == .Val(row) -> return row
    row :: state.descriptors.len()
    &state.rows.add(key, row).drop("checked absent above")
    size :: lower_size(p, ty)
    descriptor := X64ValueDescriptor{kind: "Resource", name: mir_type_display_name(ty), size: size.size, align: size.align}
    // Reserve the row before visiting children: recursive nominal edges refer
    // to this exact row, rather than copying an unbounded descriptor tree.
    &state.descriptors.push(descriptor)
    if ty.kind == {
        .Int -> descriptor.kind = "Int"
        .Bool -> descriptor.kind = "Bool"
        .Char -> descriptor.kind = "Char"
        .Float -> descriptor.kind = "Float"
        .Float32 -> descriptor.kind = "Float32"
        .String -> descriptor.kind = "String"
        .IntN(signed, bits) -> {
            descriptor.kind = if signed -> "Signed" else -> "Unsigned"
            descriptor.stride = bits
        }
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> {
            descriptor.kind = "Alias"
            descriptor.children = [Int]{lower_value_descriptor(p, &state, inner)}
        }
        .Option(inner) -> {
            descriptor.kind = "Option"
            descriptor.children = [Int]{lower_value_descriptor(p, &state, inner)}
        }
        .Result(ok, err) -> {
            descriptor.kind = "Result"
            descriptor.children = [Int]{lower_value_descriptor(p, &state, ok), lower_value_descriptor(p, &state, err)}
        }
        .List(inner) | .FixedList(inner, _) -> {
            descriptor.kind = "List"
            descriptor.stride = lower_list_stride(p, inner)
            descriptor.children = [Int]{lower_value_descriptor(p, &state, inner)}
        }
        .Map(key_ty, value_ty) -> {
            entry :: lower_map_entry(ty) ?? panic("checked map has no entry tuple")
            descriptor.kind = "Map"
            descriptor.stride = lower_list_stride(p, entry)
            descriptor.children = [Int]{lower_value_descriptor(p, &state, key_ty), lower_value_descriptor(p, &state, value_ty)}
            descriptor.members = lower_value_members(p, &state, lower_inline_members(p, entry))
        }
        .Tuple(_) -> {
            descriptor.kind = "Struct"
            descriptor.name = "Tuple"
            descriptor.members = lower_value_members(p, &state, lower_inline_members(p, ty))
        }
        .Fn(_) | .SendFn(_, _, _) -> descriptor.kind = "Closure"
        .Apply(name, args) -> {
            if args.len() == 0 && (name.name == "Unit" || name.name == "Never") {
                descriptor.kind = "Unit"
            } else if lower_type_def(p, ty) == .Val(definition) {
                if definition.kind == {
                    .Alias(inner) | .Distinct(inner, _) -> {
                        descriptor.kind = "Alias"
                        descriptor.children = [Int]{lower_value_descriptor(p, &state, inner)}
                    }
                    .Struct(_, _) -> {
                        if lower_is_inline(p, ty) {
                            descriptor.kind = "Struct"
                            descriptor.name = definition.name
                            descriptor.members = lower_value_members(p, &state, lower_inline_members(p, ty))
                        }
                    }
                    .Enum(variants, _) -> {
                        descriptor.kind = if lower_enum_is_tag(variants) -> "Tag" else -> "Enum"
                        descriptor.name = definition.name
                        loop (index, variant) in variants {
                            members :: lower_value_members(p, &state, lower_variant_members(p, definition, variant))
                            &descriptor.variants.push(X64ValueVariant{name: variant.name, selector: lower_discriminant(index), members: members, named: variant.payload == .Named(_)})
                        }
                    }
                    else -> {}
                }
            }
        }
        .Union(_) -> {
            definition :: lower_type_def(p, ty)
            if definition == .Val(found) && found.kind == .Enum(variants, _) {
                descriptor.kind = "Enum"
                descriptor.name = found.name
                loop (index, variant) in variants {
                    members :: lower_value_members(p, &state, lower_variant_members(p, found, variant))
                    &descriptor.variants.push(X64ValueVariant{name: variant.name, selector: lower_discriminant(index), members: members, named: variant.payload == .Named(_)})
                }
            }
        }
        else -> {}
    }
    if lower_repr(p, ty) == .Unsupported(reason) -> &state.errors.push("native value {descriptor.name}: {reason}")
    state.descriptors[row] = descriptor
    row
}

fn x64_value_boundary(program: MIRProgram, ty: MIRType) -> X64ValueBoundary Never! {
    state := LowerValueBoundary{rows: [String:Int]{}, descriptors: [X64ValueDescriptor]{}, errors: [String]{}}
    root :: lower_value_descriptor(program, &state, ty)
    X64ValueBoundary{root: root, descriptors: state.descriptors, errors: state.errors}
}

// (out, checked parameters...) -> Unit. The hidden aggregate output parameter
// remains internal to the checked call; scalar carriers are stored only after
// the delivered-stop guard used by ordinary native callback adapters.
fn lower_value_callable(program: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature_id :: m.mir_signatures[glue.function].copy()
    signature :: m.signatures[signature_id.value].copy()
    source :: program.functions[m.mir_sources[glue.function]]
    hidden :: if source.capture_params.len() > 0 -> 1 else -> 0
    inline :: lower_is_inline(program, glue.ty)
    params := [LIRLayout]{lir_layout_pointer()}
    loop (index, layout) in signature.params {
        if inline && index == hidden -> next
        &params.push(layout)
    }
    f := lower_helper_start(&m, glue, params, None)
    out :: f.open_params[0].copy()
    args := [LIRValueID]{}
    input := 1
    loop (index, _) in signature.params {
        if inline && index == hidden -> &args.push(out)
        else {
            &args.push(f.open_params[input])
            input += 1
        }
    }
    target := LIRFunctionID{value: glue.function}
    if m.static_fixups.len() > 0 -> target = lower_closure_helper_id(&m, "callable.init", glue.function, source)
    result := LIRValueID?{None}
    if signature.result == .Val(layout) -> result = Val(lower_new_value(&f, layout, LIRDrop.Trivial, None))
    lower_emit(&f, LIRInst.Call{dst: result, signature: signature_id, callee: LIRCallee.Function{id: target}, args: args})
    if result == .Val(value) -> lower_callback_store(program, &m, &f, out, value, glue.ty)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_value_release(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    out :: f.open_params[0].copy()
    lower_drop_stored(p, &m, &f, out, 0, glue.ty)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_closure_value_layouts(program: MIRProgram, functions: [LowerPreparedFunction], instances: [MIRFunction], m: LowerModule) -> [LIRClosureValueLayout] Never! {
    layouts := [LIRClosureValueLayout]{}
    loop (index, row) in functions {
        original :: program.functions[row.source_row]
        source :: if row.instance_row >= 0 -> instances[row.instance_row] else -> original
        code := LIRFunctionID{value: index}
        if source.capture_params.len() == 0 {
            thunk :: m.glue_rows.get(lower_glue_row_key("h:closure.thunk", "{index}")) ?? next
            code = m.glue[thunk].id
        }
        release := LIRFunctionID?{None}
        if m.glue_rows.get(lower_glue_row_key("h:closure.release", "{index}")) == .Val(release_row) {
            release = Val(m.glue[release_row].id)
        }
        layout :: lower_closure_layout(program, source)
        state := LowerValueBoundary{rows: [String:Int]{}, descriptors: [X64ValueDescriptor]{}, errors: [String]{}}
        unit :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}})
        root :: lower_value_descriptor(program, &state, unit)
        captures := [X64ValueMember]{}
        loop (position, capture) in source.capture_params {
            descriptor :: lower_value_descriptor(program, &state, capture.ty)
            &captures.push(X64ValueMember{name: capture.name, offset: layout.offsets[position], descriptor: descriptor, boxed: layout.by_ref[position]})
        }
        &layouts.push(LIRClosureValueLayout{code: code, release: release, function: original.id, boundary: X64ValueBoundary{root: root, descriptors: state.descriptors, errors: state.errors}, captures: captures})
    }
    layouts
}
