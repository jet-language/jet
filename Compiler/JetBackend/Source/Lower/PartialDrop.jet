// Owner-local drop elaboration for moved Close-bearing fields. A cleared
// inline value is not an absent value: its Close body may observe zero fields.
// These flags live in the current function, never in a value's ABI layout.
use jet_foundation.[MIRInstruction, MIROpID, MIROwnershipMode, MIRProgram, MIRProjection, MIRType, MIRTypeKind, MIRValueID, mir_terminator_targets, mir_type_from_kind, mir_type_identity_key]

struct LowerPartialDrop {
    result: U64
    owner: String
    path: [LowerGlueField]
    live: LIRValueID
    root_ty: MIRType
}

fn lower_option_type(inner: MIRType) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Option{inner: inner})
}

// The walk behind lower_type_contains_close: whether `ty` reaches a Close
// owner. `seen` cuts cycles within one walk (`cuts` counts them); the module
// cache answers a type it already knows, and takes every type the walk
// settles: one it found a Close owner from, or one whose whole closure it
// explored (no cut inside it), so no type's members are laid out twice per
// module. A type cut short of a settled answer stays uncached, since its
// `false` may rest on an owner still being explored.
fn lower_contains_close(p: MIRProgram, m: &LowerModule, ty: MIRType, seen: &[String:Bool], cuts: &Int) -> Bool Never! {
    if ty.identity == .Val(identity) {
        if m.contains_close_ids.get(identity.value) == .Val(known) -> return known
    }
    key :: mir_type_identity_key(ty)
    if ty.identity == None {
        if m.contains_close.get(key) == .Val(known) -> return known
    }
    if seen.get(key) != None {
        cuts += 1
        return false
    }
    &seen.add(key, true).drop("first visit")
    before :: cuts
    found :: lower_contains_close_walk(p, &m, ty, &seen, &cuts)
    if found || cuts == before -> lower_contains_close_record(&m, ty, key, found)
    found
}

fn lower_contains_close_record(m: &LowerModule, ty: MIRType, key: String, found: Bool) Never! {
    if ty.identity == .Val(identity) {
        if m.contains_close_ids.get(identity.value) == None -> &m.contains_close_ids.add(identity.value, found).drop("checked absent above")
        return
    }
    if m.contains_close.get(key) == None -> &m.contains_close.add(key.copy(), found).drop("checked absent above")
}

fn lower_contains_close_walk(p: MIRProgram, m: &LowerModule, ty: MIRType, seen: &[String:Bool], cuts: &Int) -> Bool Never! {
    if lower_close_method(p, m.close_methods, ty) != None -> return true
    if ty.kind == {
        .Tagged(_, inner) | .Option(inner) | .List(inner) | .FixedList(inner, _) -> {
            if lower_contains_close(p, &m, inner, &seen, &cuts) -> return true
        }
        .Result(ok, err) | .Map(ok, err) -> {
            if lower_contains_close(p, &m, ok, &seen, &cuts) || lower_contains_close(p, &m, err, &seen, &cuts) -> return true
        }
        else -> {}
    }
    if lower_is_inline(p, ty) {
        loop member in lower_inline_members(p, ty) {
            if lower_contains_close(p, &m, member.ty, &seen, &cuts) -> return true
        }
    } else if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Enum(variants, _) {
            loop variant in variants {
                loop member in lower_variant_members(p, definition, variant) {
                    if lower_contains_close(p, &m, member.ty, &seen, &cuts) -> return true
                }
            }
        }
    }
    false
}

fn lower_partial_owner(c: LowerContext, value: MIRValueID) -> String Never! {
    root :: lower_move_root(c, value)
    if lower_slot_of_value(c, root) == .Val(slot) -> return "slot.{slot}"
    "value.{root.value}"
}

// Borrowed projections still name the original storage. An owned extraction
// has storage of its own and starts a new owner instead.
fn lower_partial_root_value(c: LowerContext, value: MIRValueID) -> MIRValueID Never! {
    root :: lower_move_root(c, value)
    if lower_value_owned(c, root) -> return root
    loop block in c.mir.blocks {
        loop instruction in block.instructions {
            if instruction.result != Val(root) -> next
            if instruction.operation == {
                .Field(base, _) | .OptionValue(base) | .ResultValue(base, _) | .EnumPayload(base, _, _, _) -> return lower_partial_root_value(c, base)
                else -> return root
            }
        }
    }
    root
}

fn lower_partial_value_path(p: MIRProgram, c: LowerContext, value: MIRValueID) -> [LowerGlueField] Never! {
    root :: lower_move_root(c, value)
    if lower_value_owned(c, root) -> return [LowerGlueField]{}
    loop block in c.mir.blocks {
        loop instruction in block.instructions {
            if instruction.result != Val(root) -> next
            if instruction.operation == {
                .Field(base, field) -> {
                    ty :: lower_value_type(c, base) ?? return [LowerGlueField]{}
                    member :: lower_struct_field(p, ty, field) ?? return [LowerGlueField]{}
                    path := lower_partial_value_path(p, c, base)
                    &path.push(LowerGlueField{offset: member.offset, ty: if member.boxed -> lower_option_type(member.ty) else -> member.ty})
                    if member.boxed -> &path.push(LowerGlueField{offset: 0, ty: member.ty})
                    return path
                }
                .OptionValue(base) | .ResultValue(base, _) -> {
                    ty :: lower_value_type(c, root) ?? return [LowerGlueField]{}
                    path := lower_partial_value_path(p, c, base)
                    &path.push(LowerGlueField{offset: if instruction.operation == .OptionValue(_) -> 0 else -> 8, ty: ty})
                    return path
                }
                .EnumPayload(base, owner, variant, index) -> {
                    ty :: lower_value_type(c, base) ?? return [LowerGlueField]{}
                    definition :: lower_owned_def(p, owner, Val(ty)) ?? return [LowerGlueField]{}
                    found :: lower_variant(definition, variant) ?? return [LowerGlueField]{}
                    member :: lower_enum_payload_info(p, definition, found.variant, index) ?? return [LowerGlueField]{}
                    path := lower_partial_value_path(p, c, base)
                    &path.push(LowerGlueField{offset: member.offset, ty: if member.boxed -> lower_option_type(member.ty) else -> member.ty})
                    if member.boxed -> &path.push(LowerGlueField{offset: 0, ty: member.ty})
                    return path
                }
                else -> return [LowerGlueField]{}
            }
        }
    }
    [LowerGlueField]{}
}

fn lower_partial_field_path(p: MIRProgram, ty: MIRType, projections: [MIRProjection]) -> [LowerGlueField]? {
    path := [LowerGlueField]{}
    current := ty
    loop projection in projections {
        if projection == {
            .Field(id, _) -> {
                field :: lower_struct_field(p, current, id) ?? return None
                storage :: if field.boxed -> lower_option_type(field.ty) else -> field.ty
                &path.push(LowerGlueField{offset: field.offset, ty: storage})
                if field.boxed -> &path.push(LowerGlueField{offset: 0, ty: field.ty})
                current = field.ty
            }
            // A moved match payload (Places.jet lower_payload_info), laid
            // out as lower_partial_value_path lays out an EnumPayload.
            .Payload(kind, _) -> {
                member :: lower_payload_info(p, current, kind) ?? return None
                &path.push(LowerGlueField{offset: member.offset, ty: if member.boxed -> lower_option_type(member.ty) else -> member.ty})
                if member.boxed -> &path.push(LowerGlueField{offset: 0, ty: member.ty})
                current = member.ty
            }
            else -> return None
        }
    }
    Val(path)
}

// Whether `ty` reaches a Close owner, once per type for the whole module
// (by the checked identity when the type has one, else by its identity
// key, the same partition mir_type_identity_key spells). A fresh
// lower_contains_close walk answers exactly that reachability (its `seen`
// set only cuts cycles, and the cached answers it consults are earlier
// walks' own), so the cached answer is the walk's own.
fn lower_type_contains_close(p: MIRProgram, m: &LowerModule, ty: MIRType) -> Bool Never! {
    seen := [String:Bool]{}
    cuts := 0
    found :: lower_contains_close(p, &m, ty, &seen, &cuts)
    lower_contains_close_record(&m, ty, mir_type_identity_key(ty), found)
    found
}

fn lower_partial_frame(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    loop block in c.mir.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            ty :: lower_checked_type(c, instruction) ?? next
            if !lower_value_owned(c, result) -> next
            if !lower_type_contains_close(p, &m, ty) -> next
            owner := ""
            root_ty := ty
            path := [LowerGlueField]{}
            if instruction.operation == {
                .MovePlace(place) -> {
                    row :: lower_place_row(c.mir, c.place_rows, place) ?? next
                    if row.projections.len() == 0 -> next
                    slot :: c.place_slots.get(place.value) ?? next
                    path = lower_partial_field_path(p, c.slots[slot].ty, row.projections) ?? next
                    owner = "slot.{slot}"
                }
                .Field(value, field) -> {
                    source :: lower_value_type(c, value) ?? next
                    found :: lower_struct_field(p, source, field) ?? next
                    root_ty = lower_value_type(c, lower_partial_root_value(c, value)) ?? source
                    path = lower_partial_value_path(p, c, value)
                    &path.push(LowerGlueField{offset: found.offset, ty: if found.boxed -> lower_option_type(found.ty) else -> found.ty})
                    if found.boxed -> &path.push(LowerGlueField{offset: 0, ty: found.ty})
                    owner = lower_partial_owner(c, lower_partial_root_value(c, value))
                    fact :: c.fact_index.get(lower_partial_root_value(c, value).value) ?? next
                    // A taken field (lower_payload_takes) leaves its carrier
                    // like a moved one: the carrier's drop skips that member.
                    if c.mir.values[fact].ownership.mode != MIROwnershipMode.Move && c.payload_takes.get(result.value) == None -> next
                }
                .OptionValue(value) | .ResultValue(value, _) -> {
                    offset :: if instruction.operation == .OptionValue(_) -> 0 else -> 8
                    root_ty = lower_value_type(c, lower_partial_root_value(c, value)) ?? ty
                    path = lower_partial_value_path(p, c, value)
                    &path.push(LowerGlueField{offset: offset, ty: ty})
                    owner = lower_partial_owner(c, lower_partial_root_value(c, value))
                    fact :: c.fact_index.get(lower_partial_root_value(c, value).value) ?? next
                    // A taken payload (lower_payload_takes) leaves its carrier
                    // like a moved one: the carrier's drop skips that member.
                    if c.mir.values[fact].ownership.mode != MIROwnershipMode.Move && c.payload_takes.get(result.value) == None -> next
                }
                .EnumPayload(value, type_id, variant, index) -> {
                    source :: lower_value_type(c, value) ?? next
                    definition :: lower_owned_def(p, type_id, Val(source)) ?? next
                    found :: lower_variant(definition, variant) ?? next
                    member :: lower_enum_payload_info(p, definition, found.variant, index) ?? next
                    root_ty = lower_value_type(c, lower_partial_root_value(c, value)) ?? source
                    path = lower_partial_value_path(p, c, value)
                    &path.push(LowerGlueField{offset: member.offset, ty: if member.boxed -> lower_option_type(member.ty) else -> member.ty})
                    if member.boxed -> &path.push(LowerGlueField{offset: 0, ty: member.ty})
                    owner = lower_partial_owner(c, lower_partial_root_value(c, value))
                    fact :: c.fact_index.get(lower_partial_root_value(c, value).value) ?? next
                    // A taken payload (lower_payload_takes) leaves its carrier
                    // like a moved one, as for OptionValue/ResultValue above.
                    if c.mir.values[fact].ownership.mode != MIROwnershipMode.Move && c.payload_takes.get(result.value) == None -> next
                }
                else -> next
            }
            loop (index, slot) in c.slots {
                if owner == ("slot.{index}") -> root_ty = slot.ty
            }
            &f.partial_drops.push(LowerPartialDrop{result: result.value, owner: owner, path: path, root_ty: root_ty, live: LIRValueID{value: -1}})
        }
    }
    // A whole-owner move can rebind any same-typed local. Reserve its paths
    // before lowering blocks, so the move copies bits rather than losing them.
    seeds :: f.partial_drops.copy()
    loop (slot, definition) in c.slots {
        loop seed in seeds {
            if mir_type_identity_key(seed.root_ty) != mir_type_identity_key(definition.ty) -> next
            owner :: "slot.{slot}"
            present := false
            loop row in f.partial_drops {
                if row.owner == owner && row.path.len() == seed.path.len() && lower_partial_prefix(row.path, seed.path) -> present = true
            }
            if !present -> &f.partial_drops.push(LowerPartialDrop{result: U64.MAX, owner: owner, path: seed.path, root_ty: definition.ty, live: LIRValueID{value: -1}})
        }
    }
    loop (index, row) in f.partial_drops {
        live :: lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: live, size: 1, align: 1})
        one :: lower_flag(&f)
        lower_emit(&f, LIRInst.Const{dst: one, value: 1})
        lower_emit(&f, LIRInst.Store{base: live, offset: 0, value: one})
        f.partial_drops[index] = LowerPartialDrop{result: row.result, owner: row.owner, path: row.path, root_ty: row.root_ty, live: live}
    }
}

fn lower_partial_transfer(f: &LowerFunction, instruction: MIRInstruction) Never! {
    result :: instruction.result ?? return
    loop row in f.partial_drops {
        if row.result != result.value -> next
        zero :: lower_flag(&f)
        lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
        lower_emit(&f, LIRInst.Store{base: row.live, offset: 0, value: zero})
    }
}

fn lower_partial_prefix(path: [LowerGlueField], prefix: [LowerGlueField]) -> Bool Never! {
    if path.len() < prefix.len() -> return false
    loop (index, field) in prefix {
        if field.offset != path[index].offset || mir_type_identity_key(field.ty) != mir_type_identity_key(path[index].ty) -> return false
    }
    true
}

fn lower_partial_reset(f: &LowerFunction, owner: String, prefix: [LowerGlueField]) Never! {
    loop row in f.partial_drops {
        if row.owner != owner || !lower_partial_prefix(row.path, prefix) -> next
        one :: lower_flag(&f)
        lower_emit(&f, LIRInst.Const{dst: one, value: 1})
        lower_emit(&f, LIRInst.Store{base: row.live, offset: 0, value: one})
    }
}

fn lower_partial_assign(f: &LowerFunction, owner: String, source: String) Never! {
    if owner == source -> return
    loop row in f.partial_drops {
        if row.owner != owner -> next
        live := lower_flag(&f)
        lower_emit(&f, LIRInst.Const{dst: live, value: 1})
        loop from in f.partial_drops {
            if from.owner != source || from.path.len() != row.path.len() || !lower_partial_prefix(from.path, row.path) -> next
            bit :: lower_flag(&f)
            lower_emit(&f, LIRInst.Load{dst: bit, base: from.live, offset: 0})
            both :: lower_flag(&f)
            lower_emit(&f, LIRInst.Binary{dst: both, op: .And, left: live, right: bit})
            live = both
        }
        lower_emit(&f, LIRInst.Store{base: row.live, offset: 0, value: live})
    }
}

// Expands only ancestors of a moved field; siblings retain ordinary glue.
fn lower_partial_drop_node(p: MIRProgram, m: &LowerModule, f: &LowerFunction, base: LIRValueID, ty: MIRType, rows: [LowerPartialDrop], depth: Int) Never! {
    done :: lower_new_block(&f)
    loop row in rows {
        if row.path.len() != depth -> next
        live :: lower_flag(&f)
        lower_emit(&f, LIRInst.Load{dst: live, base: row.live, offset: 0})
        body :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: live, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, body, [LIRValueID]{})
    }
    deeper := false
    loop row in rows {
        if row.path.len() > depth -> deeper = true
    }
    if !deeper {
        if lower_close_method(p, m.close_methods, ty) == .Val(method) {
            // The enclosing partial cleanup consumes its LIR owner afterward.
            lower_close_emit(p, &m, &f, base, ty, method)
        } else if lower_is_inline(p, ty) {
            lower_inline_drop(p, &m, &f, base, ty)
        } else {
            layout :: lower_repr_layout(lower_repr(p, ty)) ?? return lower_fail(&m, &f, "partial drop leaf has no carrier")
            // The leaf owner adopts the borrowed field carrier (a Copy may not
            // add drop glue; LIR lint), then drops it.
            owned :: lower_new_value(&f, layout, lower_drop(&m, lower_repr(p, ty), true), ty.identity)
            lower_adopt(&f, owned, base)
            lower_emit(&f, LIRInst.Drop{value: owned})
        }
    } else {
        // Absence is the null carrier of `base`'s own layout: a boxed or
        // inline owner is a pointer, and LIR compares pointers only to pointers.
        base_layout :: lower_value_layout(f, base)
        zero :: lower_new_value(&f, base_layout, LIRDrop.Trivial, None)
        lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
        absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: absent, condition: .Eq, left: base, right: zero})
        body :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
        lower_start(&f, body, [LIRValueID]{})
        if lower_repr(p, ty) == .Boxed(_) {
            // #5041 P2: only the box's last owner drops what is left in it;
            // a move out of a shared box copied instead of taking.
            last :: lower_flag(&f)
            lower_call_runtime(&m, &f, "jet_rt_block_release", [LIRValueID]{base}, Val(last))
            owner :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(owner, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
            lower_start(&f, owner, [LIRValueID]{})
        }
        shapes :: if lower_is_inline(p, ty) -> [LowerGlueShape]{LowerGlueShape{selector: -1, fields: lower_inline_glue_fields(p, ty)}} else -> lower_glue_shapes(p, &m, &f, ty)
        released :: lower_new_block(&f)
        loop shape in shapes {
            // Only a selected shape (an enum variant or Result arm) branches
            // around its fields. A Option/struct/inline shape (selector -1)
            // always applies, so it opens no skip block: one left without a
            // predecessor fails the LIR lint ("block bN is unreachable").
            next_shape := LIRBlockID?{None}
            if shape.selector >= 0 {
                skipped :: lower_new_block(&f)
                discriminant :: lower_word(&f)
                lower_emit(&f, LIRInst.Load{dst: discriminant, base: base, offset: 0})
                expected :: lower_const(&f, shape.selector)
                selected :: lower_flag(&f)
                lower_emit(&f, LIRInst.Compare{dst: selected, condition: .Eq, left: discriminant, right: expected})
                selected_body :: lower_new_block(&f)
                lower_seal(&f, LIRTerminator.Branch{condition: selected, then_target: lower_target(selected_body, [LIRValueID]{}), else_target: lower_target(skipped, [LIRValueID]{})})
                lower_start(&f, selected_body, [LIRValueID]{})
                next_shape = Val(skipped)
            }
            loop field in shape.fields {
                children := [LowerPartialDrop]{}
                loop row in rows {
                    if row.path.len() > depth {
                        candidate :: row.path[depth]
                        if candidate.offset == field.offset && mir_type_identity_key(candidate.ty) == mir_type_identity_key(field.ty) -> &children.push(row)
                    }
                }
                if children.len() == 0 {
                    lower_drop_stored(p, &m, &f, base, field.offset, field.ty)
                } else {
                    // Inline values name their bytes; boxed values name their box.
                    child :: lower_read_at(p, &f, base, field.offset, field.ty) ?? next
                    if lower_is_inline(p, field.ty) || lower_repr(p, field.ty) == .Boxed(_) {
                        lower_partial_drop_node(p, &m, &f, child, field.ty, children, depth + 1)
                    } else {
                        lower_drop_stored(p, &m, &f, base, field.offset, field.ty)
                    }
                }
            }
            if next_shape == .Val(skipped) {
                lower_seal(&f, LIRTerminator.Jump{target: lower_target(released, [LIRValueID]{})})
                lower_start(&f, skipped, [LIRValueID]{})
            }
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(released, [LIRValueID]{})})
        lower_start(&f, released, [LIRValueID]{})
        if lower_repr(p, ty) == .Boxed(_) -> lower_free_box_bytes(&m, &f, base, lower_box_size(p, ty))
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

fn lower_partial_drop_value(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID, lowered: LIRValueID, ty: MIRType) -> Bool Never! {
    receiver :: lower_close_receiver_value(c, f, value)
    lower_partial_drop_owned(p, &m, &f, lower_partial_owner(c, value), [LowerGlueField]{}, lowered, ty, true, receiver)
}

fn lower_partial_drop_owned(p: MIRProgram, m: &LowerModule, f: &LowerFunction, owner: String, prefix: [LowerGlueField], lowered: LIRValueID, ty: MIRType, consume: Bool, receiver: Bool) -> Bool Never! {
    rows := [LowerPartialDrop]{}
    loop row in f.partial_drops {
        if row.owner == owner && lower_partial_prefix(row.path, prefix) -> &rows.push(row)
    }
    if rows.len() == 0 -> return false
    partial :: lower_new_block(&f)
    ordinary :: lower_new_block(&f)
    done :: lower_new_block(&f)
    loop row in rows {
        live :: lower_flag(&f)
        lower_emit(&f, LIRInst.Load{dst: live, base: row.live, offset: 0})
        next_row :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: live, then_target: lower_target(next_row, [LIRValueID]{}), else_target: lower_target(partial, [LIRValueID]{})})
        lower_start(&f, next_row, [LIRValueID]{})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(ordinary, [LIRValueID]{})})
    lower_start(&f, ordinary, [LIRValueID]{})
    if receiver {
        lower_close_value_drop(p, &m, &f, lowered, ty, consume)
    } else if consume {
        lower_map_drop_value(p, &m, &f, lowered, ty)
    } else {
        lower_partial_drop_node(p, &m, &f, lowered, ty, [LowerPartialDrop]{}, 0)
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, partial, [LIRValueID]{})
    if receiver -> lower_close_forget(&f)
    lower_partial_drop_node(p, &m, &f, lowered, ty, rows, prefix.len())
    // The inlined drop-rest already released this owner's parts; end its LIR
    // ownership without running the ordinary glue a second time.
    if consume -> lower_forget(&f, lowered, ty.identity)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    true
}

fn lower_partial_drop_stored(p: MIRProgram, m: &LowerModule, f: &LowerFunction, owner: String, prefix: [LowerGlueField], base: LIRValueID, offset: Int, ty: MIRType, receiver: Bool) Never! {
    guarded := receiver
    loop row in f.partial_drops {
        if row.owner == owner && lower_partial_prefix(row.path, prefix) -> guarded = true
    }
    if guarded {
        stored :: lower_read_at(p, &f, base, offset, ty) ?? return
        if lower_partial_drop_owned(p, &m, &f, owner, prefix, stored, ty, false, receiver) -> return
        if receiver -> return lower_close_value_drop(p, &m, &f, stored, ty, false)
    }
    lower_drop_stored(p, &m, &f, base, offset, ty)
}

// Checked whole-use rejects a partially moved owner. Defend that boundary
// independently: flags cannot follow an owner into a heap aggregate or callee.
// Backward reaching definitions stop at a reset and follow local rebinding.
fn lower_partial_may_clear(p: MIRProgram, c: LowerContext, f: LowerFunction, owner: String, path: [LowerGlueField], block: Int, limit: Int, seen: &[String:Bool]) -> Bool Never! {
    key :: "{owner}:{block}:{limit}"
    if seen.get(key) != None -> return false
    &seen.add(key, true).drop("first reaching-definition visit")
    instructions :: c.mir.blocks[block].instructions
    loop reverse in 0..<limit {
        instruction :: instructions[limit - 1 - reverse]
        if instruction.result == .Val(result) {
            loop row in f.partial_drops {
                if row.result == result.value && row.owner == owner && row.path.len() == path.len() && lower_partial_prefix(row.path, path) -> return true
            }
            if c.moves.get(result.value) == None && c.read_slots.get(result.value) == None && lower_partial_owner(c, result) == owner -> return false
        }
        if instruction.operation == {
            .WritePlace(place, value) | .ReplacePlace(place, value) -> {
                slot :: c.place_slots.get(place.value) ?? next
                if owner != "slot.{slot}" -> next
                target :: lower_place_row(c.mir, c.place_rows, place) ?? next
                prefix :: lower_partial_field_path(p, c.slots[slot].ty, target.projections) ?? next
                if !lower_partial_prefix(path, prefix) -> next
                if prefix.len() != 0 -> return false
                source :: lower_partial_owner(c, value)
                if source == owner -> next
                return lower_partial_may_clear(p, c, f, source, path, block, limit - 1 - reverse, &seen)
            }
            else -> {}
        }
    }
    loop (index, predecessor) in c.mir.blocks {
        // An unranked block is unreachable, unless lower_forward_blocks
        // bypassed it (an empty jump-only block): walk through those, since
        // the partial move may sit before them.
        if c.ranks[index] < 0 && c.forward[index] == index -> next
        loop target in mir_terminator_targets(predecessor.terminator) {
            if target != c.mir.blocks[block].id -> next
            if lower_partial_may_clear(p, c, f, owner, path, index, predecessor.instructions.len(), &seen) -> return true
        }
    }
    false
}

fn lower_partial_escape(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID, before: MIROpID?) Never! {
    if f.partial_drops.len() == 0 -> return
    owner :: lower_partial_owner(c, value)
    block :: c.block_index.get(f.mir_block.value) ?? return
    limit := c.mir.blocks[block].instructions.len()
    if before == .Val(id) {
        loop (index, instruction) in c.mir.blocks[block].instructions {
            if instruction.id == id -> limit = index
        }
    }
    loop row in f.partial_drops {
        if row.owner != owner -> next
        seen := [String:Bool]{}
        if lower_partial_may_clear(p, c, f, owner, row.path, block, limit, &seen) -> return lower_fail(&m, &f, "partially moved owner escapes")
    }
}
