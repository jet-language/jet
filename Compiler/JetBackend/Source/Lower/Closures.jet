// Function values and closures (design doc "Closures").
//
// A function value (MIR `fn` type, LowerRepr.Boxed) is a pointer to a heap
// closure box:
//
//   0: reference count   8: code address   16: release helper address
//   24..: the captures, each at the next multiple of its alignment
//
// The code takes the box as a hidden first parameter, before the hidden
// result pointer and the declared parameters. A closure body (a function
// with capture parameters) is that code itself; any other function used as a
// value (a named function, a lambda without captures) runs through a
// generated thunk that ignores the box and calls it. Copies share the box:
// clone glue counts a reference, and drop glue runs the box's release helper
// when the last one goes, which drops the by-value captures and frees the
// box with its own size.
//
// A capture parameter that borrows (ReadBorrow or WriteBorrow, or Write
// access) is by reference: the box holds the captured place's address.
// Every other capture is by value: its bytes live in the box. Inside a body
// every captured place is a memory cell (LowerSlot.cell): the box field for
// a by-value capture, the referenced storage for a by-reference one. A
// place the creating function captures by reference is a cell there too
// (frame storage, a Write parameter's pointer or an inline parameter's
// storage), so the function and the closure read and write one value.
use jet_foundation.[
    MIRBlockID, MIRCallArg, MIRCaptureOperand, MIRCaptureParam, MIRFunction,
    MIRFunctionID, MIRInstruction, MIROwnershipMode, MIRPlace, MIRPlaceID,
    MIRProgram, MIRValueID,
]

LOWER_CLOSURE_HEADER :: prep { 24 }

struct LowerClosureLayout {
    pub offsets: [Int]
    pub by_ref: [Bool]
    pub size: Int
}

fn lower_capture_by_ref(param: MIRCaptureParam) -> Bool Never! {
    param.access == .Write || param.ownership.mode == MIROwnershipMode.ReadBorrow || param.ownership.mode == MIROwnershipMode.WriteBorrow
}

// The box layout of a closure over `function`'s capture parameters, in
// capture slot order.
fn lower_closure_layout(p: MIRProgram, function: MIRFunction) -> LowerClosureLayout Never! {
    offsets := [Int]{}
    by_ref := [Bool]{}
    offset := LOWER_CLOSURE_HEADER
    loop param in function.capture_params {
        reference :: lower_capture_by_ref(param)
        size :: if reference -> LowerSize{size: 8, align: 8} else -> lower_size(p, param.ty)
        offset = lower_align_up(offset, size.align)
        &offsets.push(offset)
        &by_ref.push(reference)
        offset += size.size
    }
    LowerClosureLayout{offsets: offsets, by_ref: by_ref, size: lower_align_up(offset, 8)}
}

// The position in `function.capture_params` of capture slot `slot`, or -1.
fn lower_capture_index(function: MIRFunction, slot: Int) -> Int Never! {
    loop (index, param) in function.capture_params {
        if param.slot == slot -> return index
    }
    -1
}

// The capture slot whose `Capture` instruction defines `value`, or -1.
fn lower_capture_slot_of(function: MIRFunction, value: MIRValueID) -> Int Never! {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if result == value {
                    if instruction.operation == .Capture(slot) -> return slot
                    return -1
                }
            }
        }
    }
    -1
}

// The index of the parameter whose `Parameter` instruction defines `value`, or -1.
fn lower_param_index(function: MIRFunction, value: MIRValueID) -> Int Never! {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if result == value {
                    if instruction.operation == .Parameter(index, _) -> return index
                    return -1
                }
            }
        }
    }
    -1
}

// The address of capture slot `slot` in the body being lowered: the box
// field, or for a by-reference capture the address the field holds.
fn lower_capture_address(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, slot: Int) -> LIRValueID? {
    index :: lower_capture_index(c.mir, slot)
    if index < 0 {
        lower_fail(&m, &f, "capture slot {slot} has no capture parameter")
        return None
    }
    env :: (~f.env) ?? {
        lower_fail(&m, &f, "capture slot {slot} outside a closure body")
        return None
    }
    layout :: lower_closure_layout(p, c.mir)
    if !layout.by_ref[index] -> return Val(lower_address(&f, env, layout.offsets[index]))
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: address, base: env, offset: layout.offsets[index]})
    Val(address)
}

// `Capture(slot)`: the captured value, read from its cell (an inline
// aggregate's value is the cell itself).
fn lower_capture(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, slot: Int) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_alias_absent(&f, instruction)
    if lower_repr_layout(lower_repr(p, ty)) == None -> return lower_alias_absent(&f, instruction)
    address :: lower_capture_address(p, c, &m, &f, slot) ?? return
    if lower_is_inline(p, ty) -> return lower_alias(c, &f, instruction, address)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_emit(&f, LIRInst.Load{dst: dst, base: address, offset: 0})
}

// The memory cell of every cell slot, made at function entry so it
// dominates every use (None for other slots).
fn lower_frame_cells(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    cells := [LIRValueID?]{}
    loop row in c.slots {
        if !row.cell {
            &cells.push(None)
            next
        }
        cell := LIRValueID?{None}
        if row.base == {
            .Capture(value) -> {
                slot :: lower_capture_slot_of(c.mir, value)
                cell = lower_capture_address(p, c, &m, &f, slot)
            }
            .Parameter(value) -> {
                if row.write_param >= 0 {
                    cell = ~f.params[row.write_param]
                } else {
                    index :: lower_param_index(c.mir, value)
                    if index >= 0 && index < f.params.len() {
                        if f.params[index] == .Val(param) {
                            if lower_is_inline(p, row.ty) {
                                cell = Val(param)
                            } else {
                                storage :: lower_new_storage(p, &f, row.ty)
                                lower_emit(&f, LIRInst.Store{base: storage, offset: 0, value: param})
                                cell = Val(storage)
                            }
                        }
                    }
                }
            }
            else -> {
                storage :: lower_new_storage(p, &f, row.ty)
                lower_clear_at(p, &f, storage, 0, row.ty)
                cell = Val(storage)
            }
        }
        if cell == None -> lower_fail(&m, &f, "a captured place has no storage")
        &cells.push(cell)
    }
    f.cells = cells
}

// The root value a projection walk of `slot` starts from: a cell's inline
// aggregate is the cell, any other cell value is loaded (borrowed); other
// slots hold their current value.
fn lower_slot_root(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, slot: Int) -> LIRValueID? {
    if !c.slots[slot].cell -> return ~f.current[slot]
    cell :: (~f.cells[slot]) ?? {
        lower_fail(&m, &f, "captured slot {slot} has no storage")
        return None
    }
    if lower_is_inline(p, c.slots[slot].ty) -> return Val(cell)
    layout :: lower_repr_layout(lower_repr(p, c.slots[slot].ty)) ?? return None
    value :: lower_new_value(&f, layout, LIRDrop.Trivial, c.slots[slot].ty.identity)
    lower_emit(&f, LIRInst.Load{dst: value, base: cell, offset: 0})
    Val(value)
}

// Where a place of a cell slot lives: the cell itself, or the end of its
// projections from the cell's root.
fn lower_cell_walk(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, slot: Int, row: MIRPlace) -> LowerFieldAddress? {
    if row.projections.len() == 0 {
        cell :: (~f.cells[slot]) ?? {
            lower_fail(&m, &f, "captured place {row.id.value} has no storage")
            return None
        }
        return Val(LowerFieldAddress{base: cell, offset: 0})
    }
    root :: lower_slot_root(p, c, &m, &f, slot) ?? return None
    lower_walk_projections(p, &m, &f, root, c.slots[slot].ty, row.projections)
}

// After a value held by a cell slot is dropped, the cell no longer owns it:
// it is cleared when it still holds that value (an inline aggregate's value
// is the cell's own storage).
fn lower_cell_dropped(p: MIRProgram, c: LowerContext, f: &LowerFunction, slot: Int, value: LIRValueID) Never! {
    cell :: (~f.cells[slot]) ?? return
    ty :: c.slots[slot].ty
    if lower_is_inline(p, ty) -> return lower_clear_at(p, &f, cell, 0, ty)
    layout :: lower_repr_layout(lower_repr(p, ty)) ?? return
    held :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Load{dst: held, base: cell, offset: 0})
    same :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: held, right: value})
    clear :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(clear, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, clear, [LIRValueID]{})
    lower_clear_at(p, &f, cell, 0, ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// The address of a place a closure captures by reference.
fn lower_place_address(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, place: MIRPlaceID) -> LIRValueID? {
    row :: lower_place_row(c.mir, place) ?? {
        lower_fail(&m, &f, "captured place {place.value} is missing")
        return None
    }
    slot :: c.place_slots.get(place.value) ?? {
        lower_fail(&m, &f, "captured place {place.value} has no lowered root")
        return None
    }
    if !c.slots[slot].cell {
        lower_fail(&m, &f, "captured place {place.value} has no storage")
        return None
    }
    walk :: lower_cell_walk(p, c, &m, &f, slot, row) ?? return None
    Val(lower_address(&f, walk.base, walk.offset))
}

// The program function a lowered function row was made from.
fn lower_row_source(p: MIRProgram, m: LowerModule, index: Int) -> MIRFunction Never! {
    p.functions[m.mir_sources[index]]
}

// `Closure(function, captures)`: a new box with one reference, the code
// and release helper addresses, and every capture moved in (by value) or
// its place's address (by reference).
fn lower_closure(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, function: MIRFunctionID, captures: [MIRCaptureOperand]) Never! {
    index :: lower_function_index(m, function)
    if index < 0 -> return lower_fail(&m, &f, "closure over function {function.value}, which is not lowered (a generic instance's closure is not lowered at O0 yet)")
    source :: lower_row_source(p, m, index)
    if captures.len() != source.capture_params.len() -> return lower_fail(&m, &f, "closure passes {captures.len()} captures to {source.name}, which takes {source.capture_params.len()}")
    layout :: lower_closure_layout(p, source)
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
    lower_alloc(&m, &f, dst, layout.size)
    lower_store_word(&f, dst, 0, 1)
    code :: lower_pointer(&f)
    code_id :: if source.capture_params.len() > 0 -> LIRFunctionID{value: index} else -> lower_closure_helper_id(&m, "closure.thunk", index, source)
    lower_emit(&f, LIRInst.FunctionAddress{dst: code, function: code_id})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: code})
    release :: lower_pointer(&f)
    lower_emit(&f, LIRInst.FunctionAddress{dst: release, function: lower_closure_helper_id(&m, "closure.release", index, source)})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: release})
    loop (position, capture) in captures {
        param :: source.capture_params[position]
        offset :: layout.offsets[position]
        if layout.by_ref[position] {
            if capture == .Place(place) {
                address :: lower_place_address(p, c, &m, &f, place) ?? return
                lower_emit(&f, LIRInst.Store{base: dst, offset: offset, value: address})
                next
            }
            return lower_fail(&m, &f, "capture {param.name} borrows a value without a place, which is not lowered at O0 yet")
        }
        if capture == .Value(value) {
            if lower_is_absent(f, value) -> next
            lowered :: lower_use(&m, &f, value) ?? return
            lower_write_at(p, &f, dst, offset, lowered, param.ty)
            next
        }
        return lower_fail(&m, &f, "capture {param.name} copies a place, which is not lowered at O0 yet")
    }
}

// `IndirectCall(callee, args)`: a call through the box's code address with
// the box first, then the result storage for an inline aggregate result,
// then the arguments as for a direct call.
fn lower_indirect_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, callee: MIRValueID, args: [MIRCallArg]) Never! {
    closure :: lower_use(&m, &f, callee) ?? return
    lowered := [LIRValueID]{}
    writebacks := [LowerWriteBack]{}
    if !lower_call_args(p, c, &m, &f, args, &lowered, &writebacks) -> return
    code :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: code, base: closure, offset: 8})
    call_args := [LIRValueID]{closure}
    dst := LIRValueID?{None}
    if lower_checked_type(c, instruction) == .Val(ty) {
        if lower_is_inline(p, ty) {
            storage :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
            lower_storage_into(p, &f, storage, ty)
            &call_args.push(storage)
        } else {
            dst = lower_result(p, c, &m, &f, instruction)
        }
    }
    if f.failed -> return
    loop value in lowered -> &call_args.push(value)
    params := [LIRLayout]{}
    loop value in call_args -> &params.push(lower_value_layout(f, value))
    result :: if dst == .Val(value) -> Val(lower_value_layout(f, value)) else -> None
    signature :: lower_signature(&m, params, result)
    lower_emit(&f, LIRInst.Call{dst: dst, signature: signature, callee: LIRCallee.Value{value: code}, args: call_args})
    loop writeback in writebacks -> lower_write_back(p, c, &m, &f, writeback)
}

// ---------------------------------------------------------------------------
// Generated functions.

// A per-function closure helper ("closure.thunk" or "closure.release") for
// lowered function row `index`.
fn lower_closure_helper_id(m: &LowerModule, helper: String, index: Int, source: MIRFunction) -> LIRFunctionID Never! {
    row_key :: lower_glue_row_key("h:{helper}", "{index}")
    if m.glue_rows.get(row_key) == .Val(row) -> return m.glue[row].id
    row :: m.glue.len()
    id :: LIRFunctionID{value: m.glue_base + row}
    name :: if source.key == "" -> source.name else -> source.key
    &m.glue.push(LowerGlue{key: name, ty: source.return_type, id: id, clone: false, helper: helper, function: index})
    &m.glue_rows.add(row_key, row).drop("checked absent above")
    id
}

// The code of a function value without captures: takes the box first and
// calls the function with the rest of its arguments.
fn lower_closure_thunk(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    target_signature :: ~m.mir_signatures[glue.function]
    target :: ~m.signatures[target_signature.value]
    params := [LIRLayout]{lir_layout_pointer()}
    loop layout in target.params -> &params.push(layout)
    f := lower_helper_start(&m, glue, params, target.result)
    args := [LIRValueID]{}
    loop (position, value) in f.open_params {
        if position > 0 -> &args.push(value)
    }
    result :: if target.result == .Val(layout) -> Val(lower_new_value(&f, layout, LIRDrop.Trivial, None)) else -> None
    lower_emit(&f, LIRInst.Call{dst: result, signature: target_signature, callee: LIRCallee.Function{id: LIRFunctionID{value: glue.function}}, args: args})
    lower_seal(&f, LIRTerminator.Return{value: result})
    lir_builder_finish(f.builder)
}

// The release helper of one closure: drops the by-value captures and frees
// the box.
fn lower_closure_release(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    source :: lower_row_source(p, m, glue.function)
    layout :: lower_closure_layout(p, source)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    boxed :: ~f.open_params[0]
    loop (position, param) in source.capture_params {
        if !layout.by_ref[position] -> lower_drop_stored(p, &m, &f, boxed, layout.offsets[position], param.ty)
    }
    size :: lower_const(&f, layout.size)
    align :: lower_const(&f, 8)
    lower_call_runtime(&m, &f, "jet_rt_free", [LIRValueID]{boxed, size, align}, None)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Drop glue of a function value: one reference fewer; the last runs the
// box's release helper.
fn lower_closure_drop_glue(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "drop.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    boxed :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{boxed})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    is_null :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_null, condition: LIRCondition.Eq, left: boxed, right: null})
    done :: lower_new_block(&f)
    live :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_null, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
    lower_start(&f, live, [LIRValueID]{})
    count :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: count, base: boxed, offset: 0})
    rest :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: rest, op: LIRBinaryOp.Sub, left: count, right: one})
    last :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: last, condition: LIRCondition.Eq, left: rest, right: zero})
    release :: lower_new_block(&f)
    keep :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(release, [LIRValueID]{}), else_target: lower_target(keep, [LIRValueID]{})})
    lower_start(&f, keep, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: boxed, offset: 0, value: rest})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, release, [LIRValueID]{})
    helper :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: helper, base: boxed, offset: 16})
    lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Value{value: helper}, args: [LIRValueID]{boxed}})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Clone glue of a function value: one reference more to the same box.
fn lower_closure_clone_glue(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    f := lower_new_function(glue.id, "clone.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    boxed :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{boxed})
    count :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: count, base: boxed, offset: 0})
    more :: lower_word(&f)
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: more, op: LIRBinaryOp.Add, left: count, right: one})
    lower_emit(&f, LIRInst.Store{base: boxed, offset: 0, value: more})
    lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
    lir_builder_finish(f.builder)
}
