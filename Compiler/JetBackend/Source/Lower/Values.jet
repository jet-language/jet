// Value representation (design doc "Value layouts"). Structs and tuples are
// inline aggregates: a value is a pointer to storage holding the stored
// fields at natural offsets. Whoever holds the storage owns it (a frame stack
// slot, a caller's result slot, a box payload, a list element or static
// data); the value never frees it, so drop glue only drops the owned contents
// and clone glue copies into storage the caller supplies. Box payloads
// (Option, Result, enum) and list elements use the same byte layout, so an
// inline aggregate stored in one is its bytes, not a further box. Recursive
// edges stay boxed through the one-value wrapper.
use jet_foundation.[
    MIRAccess, MIRBlockID, MIRFieldID, MIRFunction, MIRFunctionID, MIRProgram, MIRType, MIRTypeDef, MIRTypeKind,
    MIRVariant, mir_field_id, mir_type_from_kind, mir_type_identity_key, mir_type_same_checked_type,
]

struct LowerSize {
    size: Int
    align: Int
}

// One stored member of an inline aggregate or variant payload at its byte
// offset. A boxed (recursive) edge is one pointer to a wrapper box holding
// the member's value.
struct LowerMember {
    id: MIRFieldID
    name: String
    offset: Int
    ty: MIRType
    boxed: Bool
}

fn lower_align_up(value: Int, align: Int) -> Int Never! {
    if align <= 1 || value % align == 0 -> return value
    value + align - value % align
}

// The aggregate type an inline value of `ty` lays out (through tags,
// aliases and distinct types), or None when `ty` is not inline.
fn lower_inline_type(p: MIRProgram, ty: MIRType) -> MIRType? {
    if lower_repr(p, ty) == .Inline(aggregate) -> return Val(aggregate)
    None
}

fn lower_is_inline(p: MIRProgram, ty: MIRType) -> Bool Never! {
    lower_inline_type(p, ty) != None
}

// Fixed integers and binary32 are normalized low-bit word registers. Stored
// values retain their declared ABI width, through aliases and raw tags.
fn lower_packed_storage_type(p: MIRProgram, ty: MIRType) -> MIRType? {
    if ty.kind == {
        .IntN(_, bits) -> if bits <= 64 -> Val(ty) else -> None
        .Float32 -> Val(ty)
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> lower_packed_storage_type(p, inner)
        else -> {
            definition :: lower_type_def(p, ty) ?? return None
            if definition.kind == {
                .Distinct(inner, _) | .Alias(inner) -> lower_packed_storage_type(p, inner)
                else -> None
            }
        }
    }
}

fn lower_packed_storage_layout(p: MIRProgram, ty: MIRType) -> LIRLayout? {
    stored :: lower_packed_storage_type(p, ty) ?? return None
    bits :: if stored.kind == .Float32 -> 32 else -> if stored.kind == .IntN(_, width) -> width else -> panic("packed storage type")
    bytes :: if bits <= 8 -> 1 else if bits <= 16 -> 2 else if bits <= 32 -> 4 else -> 8
    Val(LIRLayout{size: bytes, align: bytes, class: LIRABIClass.Integer})
}

// Bytes and alignment a value of `ty` occupies in any storage. Inline
// aggregates are 8-aligned and padded to whole words, so copies move words.
fn lower_size(p: MIRProgram, ty: MIRType) -> LowerSize Never! {
    sizes := [String:LowerSize]{}
    lower_size_in(p, ty, &sizes)
}

// lower_size, with each nested type sized once per call (`sizes`, keyed
// exactly by lower_repr_key): a type reached along several member paths
// (record fan-out) is not re-sized per path, which was exponential in the
// nesting depth. lower_size is a pure function of (program, type), so a
// remembered size is the one it would compute.
fn lower_size_in(p: MIRProgram, ty: MIRType, sizes: &[String:LowerSize]) -> LowerSize Never! {
    key :: lower_repr_key(ty)
    if key == .Val(known_key) {
        if sizes.get(known_key) == .Val(known) -> return known
    }
    size :: lower_size_compute(p, ty, &sizes)
    if key == .Val(new_key) -> _ := &sizes.add(new_key, size.copy())
    size
}

fn lower_size_compute(p: MIRProgram, ty: MIRType, sizes: &[String:LowerSize]) -> LowerSize Never! {
    if lower_packed_storage_layout(p, ty) == .Val(layout) -> return LowerSize{size: layout.size, align: layout.align}
    if lower_repr(p, ty) == {
        .Absent -> LowerSize{size: 0, align: 1}
        .Flag -> LowerSize{size: 1, align: 1}
        .Inline(aggregate) -> LowerSize{size: lower_inline_size_in(p, aggregate, &sizes), align: 8}
        else -> LowerSize{size: 8, align: 8}
    }
}

fn lower_member_size(p: MIRProgram, member: LowerMember) -> LowerSize Never! {
    if member.boxed -> return LowerSize{size: 8, align: 8}
    lower_size(p, member.ty)
}

// Members laid out in order from `start`, each at the next multiple of its
// alignment.
fn lower_place_members(p: MIRProgram, members: [LowerMember], start: Int) -> [LowerMember] Never! {
    placed := [LowerMember]{}
    offset := start
    loop member in members {
        size :: lower_member_size(p, member)
        offset = lower_align_up(offset, size.align)
        &placed.push(LowerMember{id: member.id, name: member.name, offset: offset, ty: member.ty, boxed: member.boxed})
        offset += size.size
    }
    placed
}

// One past the last byte any member uses (at least `start`).
fn lower_members_end(p: MIRProgram, members: [LowerMember], start: Int) -> Int Never! {
    end := start
    loop member in members {
        last :: member.offset + lower_member_size(p, member).size
        if last > end -> end = last
    }
    end
}

// The stored members of an inline aggregate (a struct's non-computed fields
// in declaration order, or a tuple's elements), before placement.
fn lower_inline_member_rows(p: MIRProgram, ty: MIRType) -> [LowerMember] Never! {
    rows := [LowerMember]{}
    if ty.kind == .Tuple(fields) {
        identity :: mir_type_identity_key(ty)
        loop row in fields -> &rows.push(LowerMember{id: mir_field_id("{identity}::{row.name}"), name: row.name, offset: 0, ty: row.ty, boxed: false})
    } else if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Struct(fields, _) {
            loop row in lower_stored_fields(fields) -> &rows.push(LowerMember{id: row.id, name: row.name, offset: 0, ty: row.ty, boxed: lower_declared_boxed_edge(definition, row.name)})
        }
    }
    rows
}

// The stored members of an inline aggregate at their offsets.
fn lower_inline_members(p: MIRProgram, ty: MIRType) -> [LowerMember] Never! {
    lower_place_members(p, lower_inline_member_rows(p, ty), 0)
}

// A List or Map is an inline [len, cap, data] header (Lists.jet, Maps.jet), a
// View<T> window the same header borrowing its buffer.
fn lower_inline_size(p: MIRProgram, ty: MIRType) -> Int Never! {
    sizes := [String:LowerSize]{}
    lower_inline_size_in(p, ty, &sizes)
}

// One placement pass: members only ever move forward, so the end of the
// last placed member is the end lower_members_end would find over
// lower_inline_members, without sizing every member twice.
fn lower_inline_size_in(p: MIRProgram, ty: MIRType, sizes: &[String:LowerSize]) -> Int Never! {
    if lower_atomic_scalar(p, ty) != None -> return 8
    if lower_wide_signed(p, ty) != None -> return 16
    if ty.kind == .List(_) | .Map(_, _) | .FixedList(_, _) -> return 24
    if lower_view_element(ty) != None -> return 24
    if lower_set_element(ty) != None -> return 24
    if lower_tally_element(ty) != None -> return 24
    if lower_queue_element(ty) != None -> return 32
    if lower_priority_queue_element(ty) != None -> return 24
    offset := 0
    loop member in lower_inline_member_rows(p, ty) {
        size :: if member.boxed -> LowerSize{size: 8, align: 8} else -> lower_size_in(p, member.ty, &sizes)
        offset = lower_align_up(offset, size.align) + size.size
    }
    lower_align_up(offset, 8)
}

// A variant's stored payload members, laid out after the discriminant word.
fn lower_variant_members(p: MIRProgram, definition: MIRTypeDef, variant: MIRVariant) -> [LowerMember] Never! {
    rows := [LowerMember]{}
    if variant.payload == {
        .Unit -> {}
        .Single(inner) -> &rows.push(LowerMember{id: mir_field_id("{definition.key}.{variant.name}"), name: variant.name, offset: 0, ty: inner, boxed: lower_declared_boxed_edge(definition, variant.name)})
        .Named(fields) -> {
            loop row in lower_stored_fields(fields) -> &rows.push(LowerMember{id: row.id, name: row.name, offset: 0, ty: row.ty, boxed: lower_declared_boxed_edge(definition, "{variant.name}.{row.name}")})
        }
    }
    lower_place_members(p, rows, 8)
}

// Box sizes; construction and glue both use these, so an allocation is
// always freed with its own size.
fn lower_option_box_size(p: MIRProgram, inner: MIRType) -> Int Never! {
    size :: lower_align_up(lower_size(p, inner).size, 8)
    if size < 8 -> 8 else -> size
}

// Ordinary Result construction and payload transport share this one layout.
fn lower_result_selector(ok: Bool) -> Int Never! { if ok -> 1 else -> 0 }
fn lower_result_payload_offset() -> Int Never! { 8 }

fn lower_result_box_size(p: MIRProgram, ok: MIRType, err: MIRType) -> Int Never! {
    ok_size :: lower_size(p, ok).size
    err_size :: lower_size(p, err).size
    widest :: lower_align_up(if ok_size > err_size -> ok_size else -> err_size, 8)
    lower_result_payload_offset() + (if widest < 8 -> 8 else -> widest)
}

fn lower_enum_box_size(p: MIRProgram, definition: MIRTypeDef) -> Int Never! {
    end := 8
    if definition.kind == .Enum(variants, _) {
        loop variant in variants {
            last :: lower_members_end(p, lower_variant_members(p, definition, variant), 8)
            if last > end -> end = last
        }
    }
    lower_align_up(end, 8)
}

// The size of the box a Boxed value of `ty` points at (0 when unknown).
fn lower_box_size(p: MIRProgram, ty: MIRType) -> Int Never! {
    if ty.kind == {
        .Option(inner) -> lower_option_box_size(p, inner)
        .Result(ok, err) -> lower_result_box_size(p, ok, err)
        else -> {
            definition :: lower_type_def(p, ty) ?? return 0
            if definition.kind == .Enum(_, _) -> lower_enum_box_size(p, definition) else -> 0
        }
    }
}

// Bytes between List elements: packed fixed integers/binary32, otherwise words.
fn lower_list_stride(p: MIRProgram, elem: MIRType) -> Int Never! {
    if lower_packed_storage_layout(p, elem) == .Val(layout) -> return layout.size
    lower_option_box_size(p, elem)
}

// The type a member's storage holds: a boxed edge holds its wrapper, which
// has the present Option layout (one box holding the value).
fn lower_member_storage_type(member: LowerMember) -> MIRType Never! {
    if member.boxed -> return mir_type_from_kind(MIRTypeKind.Option{inner: member.ty})
    member.ty
}

// ---------------------------------------------------------------------------
// Moving values in and out of storage.

// base + offset as a new pointer (base itself at offset 0).
fn lower_address(f: &LowerFunction, base: LIRValueID, offset: Int) -> LIRValueID Never! {
    if offset == 0 -> return base.copy()
    bytes :: lower_const(&f, offset)
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.PointerAdd{dst: address, base: base, offset: bytes})
    address
}

// Defines `dst` as the value of `ty` stored at base + offset; an inline
// aggregate's value is the address of its bytes.
fn lower_read_into(p: MIRProgram, f: &LowerFunction, dst: LIRValueID, base: LIRValueID, offset: Int, ty: MIRType) Never! {
    if lower_is_inline(p, ty) {
        bytes :: lower_const(&f, offset)
        lower_emit(&f, LIRInst.PointerAdd{dst: dst, base: base, offset: bytes})
        return
    }
    if lower_packed_storage_layout(p, ty) == .Val(layout) {
        if layout.size < 8 {
            raw :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
            lower_emit(&f, LIRInst.Load{dst: raw, base: base, offset: offset})
            normalized :: lower_word(&f)
            lower_emit(&f, LIRInst.Convert{dst: normalized, src: raw})
            if lower_packed_storage_type(p, ty) == .Val(integer) && integer.kind == .IntN(signed, bits) {
                if signed {
                    amount :: lower_const(&f, 64 - bits)
                    shifted :: lower_word(&f)
                    lower_emit(&f, LIRInst.Binary{dst: shifted, op: LIRBinaryOp.Shl, left: normalized, right: amount})
                    lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Shr, left: shifted, right: amount})
                    return
                }
            }
            lower_emit(&f, LIRInst.Copy{dst: dst, src: normalized})
            return
        }
    }
    lower_emit(&f, LIRInst.Load{dst: dst, base: base, offset: offset})
}

// The value of `ty` stored at base + offset, without a drop action; None
// for Unit.
fn lower_read_at(p: MIRProgram, f: &LowerFunction, base: LIRValueID, offset: Int, ty: MIRType) -> LIRValueID? {
    layout :: lower_repr_layout(lower_repr(p, ty)) ?? return None
    if lower_is_inline(p, ty) -> return Val(lower_address(&f, base, offset))
    value :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_read_into(p, &f, value, base, offset, ty)
    Val(value)
}

// Moves `value` of `ty` into base + offset: an inline aggregate's bytes are
// copied (ownership of its contents moves with them).
fn lower_write_at(p: MIRProgram, f: &LowerFunction, base: LIRValueID, offset: Int, value: LIRValueID, ty: MIRType) Never! {
    if lower_is_inline(p, ty) -> return lower_copy_bytes(&f, base, offset, value, 0, lower_size(p, ty).size)
    if lower_repr_layout(lower_repr(p, ty)) == None -> return
    if lower_packed_storage_layout(p, ty) == .Val(layout) {
        if layout.size < 8 {
            stored :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
            lower_emit(&f, LIRInst.Convert{dst: stored, src: value})
            lower_emit(&f, LIRInst.Store{base: base, offset: offset, value: stored})
            return
        }
    }
    lower_emit(&f, LIRInst.Store{base: base, offset: offset, value: value})
}

fn lower_copy_bytes(f: &LowerFunction, to: LIRValueID, to_offset: Int, from: LIRValueID, from_offset: Int, size: Int) Never! {
    at := 0
    loop at < size {
        word :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: word, base: from, offset: from_offset + at})
        lower_emit(&f, LIRInst.Store{base: to, offset: to_offset + at, value: word})
        at += 8
    }
}

// Zeroes the storage of a moved-out value: every owned handle or box in it
// reads as null, which glue skips.
fn lower_clear_at(p: MIRProgram, f: &LowerFunction, base: LIRValueID, offset: Int, ty: MIRType) Never! {
    if lower_is_inline(p, ty) {
        size :: lower_size(p, ty).size
        zero :: lower_const(&f, 0)
        at := 0
        loop at < size {
            lower_emit(&f, LIRInst.Store{base: base, offset: offset + at, value: zero})
            at += 8
        }
        return
    }
    layout :: lower_repr_layout(lower_repr(p, ty)) ?? return
    empty :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Const{dst: empty, value: 0})
    lower_write_at(p, &f, base, offset, empty, ty)
}

// Frame storage of its own for one inline aggregate of `ty`, defining `dst`.
fn lower_storage_into(p: MIRProgram, f: &LowerFunction, dst: LIRValueID, ty: MIRType) Never! {
    size :: lower_size(p, ty).size
    lower_emit(&f, LIRInst.StackSlot{dst: dst, size: if size < 8 -> 8 else -> size, align: 8})
}

fn lower_new_storage(p: MIRProgram, f: &LowerFunction, ty: MIRType) -> LIRValueID Never! {
    dst :: lower_pointer(&f)
    lower_storage_into(p, &f, dst, ty)
    dst
}

// Heap storage for a box of `size` bytes.
fn lower_alloc_bytes(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, size: Int) Never! {
    bytes :: lower_const(&f, if size < 8 -> 8 else -> size)
    align :: lower_const(&f, 8)
    lower_call_runtime(&m, &f, "jet_rt_alloc", [LIRValueID]{bytes, align}, Val(dst))
}

// ---------------------------------------------------------------------------
// Inline glue: drop glue takes the aggregate's address and drops its owned
// members (null-safe, so a moved-out slot's placeholder is harmless); clone
// glue takes (source, target) and fills the target with a deep copy.

struct LowerCloseImpl {
    self_type: MIRType
    method: MIRFunctionID
}

// Indexed once during preparation; hot layout/drop queries probe only the
// nominal declaration's selected candidates, never the program's functions.
fn lower_close_index(p: MIRProgram, functions: [U64:Int]) -> [U64:[LowerCloseImpl]] Never! {
    index := [U64:[LowerCloseImpl]]{}
    loop implementation in p.impls {
        trait_ref :: implementation.trait_ref ?? next
        if trait_ref.name != "Close" || !implementation.target_applicability.rust_aot -> next
        if implementation.target_os == .Val(os) {
            name :: if os == {
                .Linux -> "linux"
                .MacOS -> "macos"
                .Windows -> "windows"
            }
            if name != p.facts.active_os -> next
        }
        if implementation.self_type.kind == .Apply(nominal, _) {
            loop id in implementation.methods {
                row :: functions.get(id.value) ?? next
                if p.functions[row].name != "close" -> next
                candidates := index.get(nominal.id.value) ?? [LowerCloseImpl]{}
                &candidates.push(LowerCloseImpl{self_type: implementation.self_type, method: id})
                &index.add(nominal.id.value, candidates).drop("append selected checked implementation")
            }
        }
    }
    index
}

// Transparent wrappers share their checked target's Close provenance.
// Distinct declarations retain their nominal implementation selection.
fn lower_close_type(p: MIRProgram, ty: MIRType) -> MIRType Never! {
    if ty.kind == .Tagged(_, inner) -> return lower_close_type(p, inner)
    if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Alias(target) -> return lower_close_type(p, target)
    }
    ty.copy()
}

fn lower_close_method(p: MIRProgram, index: [U64:[LowerCloseImpl]], ty: MIRType) -> MIRFunctionID? Never! {
    receiver :: lower_close_type(p, ty)
    if receiver.kind == .Apply(nominal, _) {
        candidates :: index.get(nominal.id.value) ?? return None
        loop implementation in candidates {
            if mir_type_same_checked_type(implementation.self_type, receiver) || lower_nominal_impl_template(p, implementation.self_type, receiver) -> return Val(implementation.method)
        }
    }
    None
}

fn lower_close_receiver(p: MIRProgram, m: LowerModule, function: MIRFunction) -> MIRType? Never! {
    if function.params.len() != 1 || function.params[0].access != .Move -> return None
    ty :: function.params[0].ty
    method :: lower_close_method(p, m.close_methods, ty) ?? return None
    if function.id != lower_instance_id(method, lower_call_bindings(Val(lower_close_type(p, ty)), [MIRType]{})) -> return None
    Val(ty)
}

fn lower_close_receiver_value(c: LowerContext, f: LowerFunction, value: MIRValueID) -> Bool Never! {
    parameter :: f.close_parameter ?? return false
    root :: lower_move_root(c, value)
    if root == parameter -> return true
    slot :: lower_slot_of_value(c, parameter) ?? return false
    actual :: lower_slot_of_value(c, root) ?? return false
    actual == slot
}

fn lower_close_receiver_slot(c: LowerContext, f: LowerFunction, slot: Int) -> Bool Never! {
    parameter :: f.close_parameter ?? return false
    actual :: lower_slot_of_value(c, parameter) ?? return false
    actual == slot
}

fn lower_close_frame(p: MIRProgram, m: &LowerModule, f: &LowerFunction) Never! {
    ty := (f.closing.copy()) ?? return
    receiver := (f.params[0].copy()) ?? return lower_fail(&m, &f, "Close receiver has no value")
    if !lower_is_inline(p, ty) {
        pointer_receiver :: if lower_repr(p, ty) == {
            .Boxed(_) | .Handle(_, _) -> true
            else -> false
        }
        if !pointer_receiver -> receiver = lower_const(&f, 1)
    }
    cell :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: cell, size: 8, align: 8})
    lower_emit(&f, LIRInst.Store{base: cell, offset: 0, value: receiver})
    f.close_identity = Val(cell)
}

fn lower_close_forget(f: &LowerFunction) Never! {
    cell :: (f.close_identity.copy()) ?? return
    zero :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
    lower_emit(&f, LIRInst.Store{base: cell, offset: 0, value: zero})
}

fn lower_close_transfer(c: LowerContext, f: &LowerFunction, value: MIRValueID) Never! {
    receiver :: lower_close_receiver_value(c, f, value)
    if receiver -> lower_close_forget(&f)
}


// The structural role belongs to the original receiver's storage, not its
// type. A rebind of that slot and every other value of T retain ordinary Close.
fn lower_close_value_drop(p: MIRProgram, m: &LowerModule, f: &LowerFunction, value: LIRValueID, ty: MIRType, consume: Bool) Never! {
    cell :: (f.close_identity.copy()) ?? return lower_fail(&m, &f, "Close receiver has no identity cell")
    receiver :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: receiver, base: cell, offset: 0})
    zero :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
    same := lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: same, condition: .Ne, left: receiver, right: zero})
    pointer_receiver :: lower_is_inline(p, ty) || lower_repr(p, ty) == .Boxed(_) | .Handle(_, _)
    if !lower_is_inline(p, ty) && pointer_receiver {
        address :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: address, condition: .Eq, left: value, right: receiver})
        both :: lower_flag(&f)
        lower_emit(&f, LIRInst.Binary{dst: both, op: .And, left: same, right: address})
        same = both
    }
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    original :: lower_new_block(&f)
    rebound :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(original, [LIRValueID]{}), else_target: lower_target(rebound, [LIRValueID]{})})
    lower_start(&f, original, [LIRValueID]{})
    lower_close_forget(&f)
    if pointer_receiver {
        structural :: lower_helper_id(&m, "drop.structural", ty)
        lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: structural}, args: [LIRValueID]{value}})
    } else {
        lower_structural_value_drop(p, &m, &f, value, ty)
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, rebound, [LIRValueID]{})
    if pointer_receiver {
        ordinary :: lower_glue_id(&m, ty)
        lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: ordinary}, args: [LIRValueID]{value}})
    } else {
        lower_map_drop_value(p, &m, &f, value, ty)
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    if consume && lower_value_drop(f, value) != .Trivial {
        released :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Trivial, ty.identity)
        lower_emit(&f, LIRInst.Reown{dst: released, src: value})
    }
}

// A Distinct owns its transparent base as a member; it does not inherit the
// base's nominal Close. Other scalar representations own no physical parts.
fn lower_structural_value_drop(p: MIRProgram, m: &LowerModule, f: &LowerFunction, value: LIRValueID, ty: MIRType) Never! {
    receiver :: lower_close_type(p, ty)
    if lower_type_def(p, receiver) == .Val(definition) {
        if definition.kind == .Distinct(base, _) -> lower_map_drop_value(p, &m, &f, value, base)
    }
}
// Glue and already-taken values emit the same checked consuming call.
// The caller supplies the receiver's typed carrier, never a copied slot.
fn lower_close_emit(p: MIRProgram, m: &LowerModule, f: &LowerFunction, value: LIRValueID, ty: MIRType, method: MIRFunctionID) Never! {
    key :: mir_type_display_name(ty)
    row :: lower_function_index(m, lower_instance_id(method, lower_call_bindings(Val(lower_close_type(p, ty)), [MIRType]{})))
    if row < 0 -> return lower_fail(&m, &f, "Close implementation of {key} has no reachable instance")
    function :: p.functions[m.mir_sources[row]]
    if function.params.len() != 1 || function.params[0].access != .Move || lower_repr(p, function.return_type) != .Absent -> return lower_fail(&m, &f, "Close implementation of {key} has an invalid consuming signature")
    lower_emit(&f, LIRInst.Call{dst: None, signature: m.mir_signatures[row], callee: LIRCallee.Function{id: LIRFunctionID{value: row}}, args: [LIRValueID]{value}})
}

fn lower_close_drop_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue, method: MIRFunctionID) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "drop.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    value :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{value})
    zero :: lower_const(&f, 0)
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: .Eq, left: value, right: zero})
    done :: lower_new_block(&f)
    live :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
    lower_start(&f, live, [LIRValueID]{})
    receiver :: if lower_is_inline(p, glue.ty) || lower_repr(p, glue.ty) == .Boxed(_) | .Handle(_, _) -> Val(value) else -> lower_read_at(p, &f, value, 0, glue.ty)
    if receiver == .Val(argument) -> lower_close_emit(p, &m, &f, argument, glue.ty, method)
    else -> lower_fail(&m, &f, "Close implementation of {glue.key} has no typed receiver carrier")
    if f.failed -> lower_seal(&f, LIRTerminator.Unreachable)
    else -> lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_needs_drop(p: MIRProgram, m: LowerModule, ty: MIRType) -> Bool Never! {
    lower_needs_drop_index(p, m.close_methods, ty)
}

fn lower_needs_drop_index(p: MIRProgram, close_methods: [U64:[LowerCloseImpl]], ty: MIRType) -> Bool Never! {
    if lower_close_method(p, close_methods, ty) != None -> return true
    if lower_repr(p, ty) == {
        .ExactInt | .Handle(_, _) -> true
        .Boxed(_) -> true
        .Inline(aggregate) -> {
            // A List or Map always owns its buffer.
            if aggregate.kind == .List(_) | .Map(_, _) -> return true
            if lower_set_element(aggregate) != None -> return true
            if lower_tally_element(aggregate) != None -> return true
            if lower_queue_element(aggregate) != None -> return true
            if lower_priority_queue_element(aggregate) != None -> return true
            loop member in lower_inline_members(p, aggregate) {
                if member.boxed || lower_needs_drop_index(p, close_methods, member.ty) -> return true
            }
            false
        }
        else -> false
    }
}

fn lower_inline_drop(p: MIRProgram, m: &LowerModule, f: &LowerFunction, value: LIRValueID, ty: MIRType) Never! {
    if !lower_is_inline(p, ty) || !lower_needs_drop(p, m, ty) -> return
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    id :: lower_glue_id(&m, lower_close_type(p, ty))
    lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: id}, args: [LIRValueID]{value}})
}

fn lower_inline_clone(p: MIRProgram, m: &LowerModule, f: &LowerFunction, source: LIRValueID, target: LIRValueID, ty: MIRType) Never! {
    if !lower_atomic_clone_assert(p, &m, &f, ty) -> return
    aggregate :: lower_inline_type(p, ty) ?? return
    if !lower_needs_drop(p, m, aggregate) -> return lower_copy_bytes(&f, target, 0, source, 0, lower_inline_size(p, aggregate))
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    id :: lower_clone_glue_id(&m, aggregate)
    lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: id}, args: [LIRValueID]{source, target}})
}

fn lower_inline_glue_fields(p: MIRProgram, ty: MIRType) -> [LowerGlueField] Never! {
    rows := [LowerGlueField]{}
    loop member in lower_inline_members(p, ty) -> &rows.push(LowerGlueField{offset: member.offset, ty: lower_member_storage_type(member)})
    rows
}

fn lower_inline_drop_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "drop.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    value :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{value})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: value, right: null})
    done :: lower_new_block(&f)
    live :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
    lower_start(&f, live, [LIRValueID]{})
    lower_glue_drop_fields(p, &m, &f, value, lower_inline_glue_fields(p, glue.ty))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_inline_clone_glue(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "clone.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    source :: lower_pointer(&f)
    target :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{source, target})
    if mir_source_value_hook(p, glue.ty, "clone") == .Val(hook) {
        row :: lower_function_index(m, hook)
        if row < 0 {
            lower_fail(&m, &f, "source clone hook is not reachable")
            lower_seal(&f, LIRTerminator.Unreachable)
            return lir_builder_finish(f.builder)
        }
        // Inline return storage is first, then the read-borrowed receiver.
        lower_emit(&f, LIRInst.Call{dst: None, signature: m.mir_signatures[row], callee: LIRCallee.Function{id: LIRFunctionID{value: row}}, args: [LIRValueID]{target, source}})
        lower_seal(&f, LIRTerminator.Return{value: None})
        return lir_builder_finish(f.builder)
    }
    lower_copy_bytes(&f, target, 0, source, 0, lower_inline_size(p, glue.ty))
    lower_glue_clone_fields(p, &m, &f, source, target, lower_inline_glue_fields(p, glue.ty))
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}
