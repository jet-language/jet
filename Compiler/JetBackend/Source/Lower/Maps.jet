// A Map is a List of its entries kept in ascending key order: the same
// inline [len, cap, data] header (Lists.jet), each element one entry tuple
// (key, value) at the tuple's offsets. Ascending order is BTreeMap's
// (Collections.rs JetMap), so iteration, display and every lookup see the
// entries as the Rust runtime does; a lookup is a binary search. List drop,
// clone, iteration and growth serve the entry list unchanged.
use jet_foundation.[
    MIRAccess, MIRInstruction, MIRLocalID, MIRMapEntry, MIROperation, MIRPlace, MIRPlaceID,
    MIRPreludeCall, MIRProgram, MIRProjection, MIRTupleField, MIRType,
    MIRTypeKind, MIRValueID, mir_type_canonical_key, mir_type_display_name, mir_type_from_kind, mir_type_same_checked_type,
]

// The entry tuple of a Map type, None for any other type.
fn lower_map_entry(ty: MIRType) -> MIRType? {
    if ty.kind == {
        // copy: `key` and `value` are payloads of read parameter `ty`, which keeps the originals; the new MIRTupleField's fields own `key` and `value`
        .Map(key, value) -> Val(mir_type_from_kind(MIRTypeKind.Tuple{fields: [MIRTupleField]{MIRTupleField{name: "key", ty: key.copy()}, MIRTupleField{name: "value", ty: value.copy()}}}))
        .Tagged(_, inner) -> lower_map_entry(inner)
        else -> None
    }
}

fn lower_map_value_type(ty: MIRType) -> MIRType? {
    if ty.kind == {
        // copy: `value` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .Map(_, value) -> Val(value.copy())
        .Tagged(_, inner) -> lower_map_value_type(inner)
        else -> None
    }
}

// The element a List or Map header's buffer holds.
fn lower_sequence_element(ty: MIRType) -> MIRType? {
    if lower_list_element(ty) == .Val(elem) -> return Val(elem)
    lower_map_entry(ty)
}

// How two keys are ordered: "int" (exact Int), "string", "word" (signed
// word, Bool byte or payload-free enum ordinal), "uword" (unsigned word),
// "inline" (a tuple or struct of ordered members lexicographic
// in member order, as the derived Ord of the Rust tuple/struct key), "list"
// (a List of ordered elements: element by element, then by length, as Rust
// Vec Ord), "boxed" (an Option, None before every Some as Rust Option's Ord,
// or a payload enum of ordered members: variant ordinal first, then the same
// variant's payload in order, as the Rust derived Ord), "" (not lowered).
fn lower_map_key_kind(p: MIRProgram, ty: MIRType) -> String Never! {
    seen := [String]{}
    lower_order_kind(p, ty, &seen)
}

// `seen` names the aggregates whose members are being (or were) checked: a
// recursive type orders through its own helper, so a revisit is ordered.
fn lower_order_kind(p: MIRProgram, ty: MIRType, seen: &[String]) -> String Never! {
    if ty.kind == {
        .String -> return "string"
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return lower_order_kind(p, inner, &seen)
        else -> {}
    }
    if lower_is_exact_int(ty) -> return "int"
    if lower_is_unsigned_word(ty) -> return "uword"
    if lower_order_runtime(p, ty) != None -> return "runtime"
    if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == {
            .Alias(base) | .Distinct(base, _) -> return lower_order_kind(p, base, &seen)
            else -> {}
        }
    }
    if lower_repr(p, ty) == {
        .ExactInt -> "int"
        .Word | .Flag | .Discriminant -> "word"
        .Inline(_) -> {
            // A List orders lexicographically, then by length (Rust Vec Ord),
            // when its elements are ordered; a View or Map has no order.
            if lower_list_element(ty) == .Val(elem) {
                if lower_view_element(ty) != None || lower_map_entry(ty) != None -> return ""
                if lower_order_seen(&seen, ty) -> return "list"
                return if lower_order_kind(p, elem, &seen) == "" -> "" else -> "list"
            }
            if lower_sequence_element(ty) != None -> return ""
            members :: lower_inline_members(p, ty)
            if members.len() == 0 -> return ""
            if lower_order_seen(&seen, ty) -> return "inline"
            loop member in members {
                if lower_order_kind(p, member.ty, &seen) == "" -> return ""
            }
            "inline"
        }
        .Boxed(boxed) -> lower_order_boxed_kind(p, boxed, &seen)
        else -> ""
    }
}

// True when `ty` was already reached; else records it.
fn lower_order_seen(seen: &[String], ty: MIRType) -> Bool Never! {
    key :: mir_type_display_name(ty)
    loop name in seen {
        if name == key -> return true
    }
    &seen.push(key)
    false
}

fn lower_order_boxed_kind(p: MIRProgram, ty: MIRType, seen: &[String]) -> String Never! {
    if lower_option_inner(ty) == .Val(inner) -> return if lower_order_kind(p, inner, &seen) == "" -> "" else -> "boxed"
    // A union carrier has no Rust order (type_derive_capability).
    if ty.kind == .Union(_) -> return ""
    definition :: lower_type_def(p, ty) ?? return ""
    variants :: if definition.kind == {
        .Enum(rows, _) -> rows
        else -> {
            return ""
        }
    }
    // A user Comparable impl orders by its own body (MIRRust.rs
    // type_derive_capability derives no Rust Ord); never substitute the
    // structural order for it.
    if lower_order_user_impl(p, ty) -> return ""
    if lower_order_seen(&seen, ty) -> return "boxed"
    loop variant in variants {
        loop member in lower_variant_members(p, definition, variant) {
            if lower_order_kind(p, member.ty, &seen) == "" -> return ""
        }
    }
    "boxed"
}

fn lower_order_user_impl(p: MIRProgram, ty: MIRType) -> Bool Never! {
    loop implementation in p.impls {
        bound :: implementation.trait_ref ?? next
        if bound.name != "Comparable" || implementation.compiler_generated -> next
        if mir_type_same_checked_type(implementation.self_type, ty) || lower_nominal_impl_template(p, implementation.self_type, ty) -> return true
    }
    false
}

fn lower_map_repr(p: MIRProgram, ty: MIRType, key: MIRType, value: MIRType) -> LowerRepr Never! {
    if lower_map_key_kind(p, key) == "" -> return LowerRepr.Unsupported{reason: "Map key type {mir_type_display_name(key)}"}
    if lower_repr(p, value) == {
        .Unsupported(reason) -> LowerRepr.Unsupported{reason: "Map value {reason}"}
        .Absent -> LowerRepr.Unsupported{reason: "Map value type {mir_type_display_name(value)}"}
        else -> LowerRepr.Inline{ty: ty}
    }
}

// The entry layout of one Map type.
struct LowerMapShape {
    entry: MIRType
    key: MIRType
    value: MIRType
    key_offset: Int
    value_offset: Int
    stride: Int
}

fn lower_map_shape(p: MIRProgram, ty: MIRType) -> LowerMapShape? {
    if lower_tally_element(ty) != None -> return lower_map_shape(p, lower_tally_map(ty))
    entry :: lower_map_entry(ty) ?? return None
    members :: lower_inline_members(p, entry)
    if members.len() != 2 -> return None
    Val(LowerMapShape{entry: entry, key: members[0].ty, value: members[1].ty, key_offset: members[0].offset, value_offset: members[1].offset, stride: lower_list_stride(p, entry)})
}

struct LowerMapOrder {
    less: LIRValueID
    same: LIRValueID
}

// `left < right` and `left == right` for two keys of `ty` (Ord of the Rust
// key: Int's exact order, String's byte order, a word's integer order).
fn lower_map_key_order(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, left: LIRValueID, right: LIRValueID) -> LowerMapOrder Never! {
    kind :: lower_map_key_kind(p, ty)
    less :: lower_flag(&f)
    equal :: lower_flag(&f)
    if kind == "runtime" {
        lower_runtime_order(p, &m, &f, ty, left, right, less, equal)
        return LowerMapOrder{less: less, same: equal}
    }
    if kind == "int" {
        lower_exact_compare(&m, &f, less, LIRCondition.Lt, left, right)
        lower_exact_compare(&m, &f, equal, LIRCondition.Eq, left, right)
    } else if kind == "string" {
        order :: lower_word(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_compare", [LIRValueID]{left, right}, Val(order))
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: less, condition: LIRCondition.Lt, left: order, right: zero})
        lower_emit(&f, LIRInst.Compare{dst: equal, condition: LIRCondition.Eq, left: order, right: zero})
    } else if kind == "list" {
        keyed := ty
        if lower_repr(p, ty) == .Inline(list) -> keyed = list
        order :: lower_word(&f)
        lower_call_helper(&m, &f, "list.compare", keyed, [LIRValueID]{left, right}, Val(order))
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: less, condition: LIRCondition.Lt, left: order, right: zero})
        lower_emit(&f, LIRInst.Compare{dst: equal, condition: LIRCondition.Eq, left: order, right: zero})
    } else if kind == "inline" || kind == "boxed" {
        // A box helper is keyed by its representation's own type, as the
        // equality helper is (a distinct or alias enum shares its base's).
        keyed := ty
        if lower_repr(p, ty) == .Boxed(boxed) -> keyed = boxed
        order :: lower_word(&f)
        lower_call_helper(&m, &f, "map.key_compare", keyed, [LIRValueID]{left, right}, Val(order))
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: less, condition: LIRCondition.Lt, left: order, right: zero})
        lower_emit(&f, LIRInst.Compare{dst: equal, condition: LIRCondition.Eq, left: order, right: zero})
    } else {
        lower_emit(&f, LIRInst.Compare{dst: less, condition: if kind == "uword" -> LIRCondition.ULt else -> LIRCondition.Lt, left: left, right: right})
        lower_emit(&f, LIRInst.Compare{dst: equal, condition: LIRCondition.Eq, left: left, right: right})
    }
    LowerMapOrder{less: less, same: equal}
}

// Consumes an already-taken typed value through the canonical Close index
// and call emitter. No temporary stack slot is needed for scalar carriers.
fn lower_map_drop_value(p: MIRProgram, m: &LowerModule, f: &LowerFunction, value: LIRValueID, ty: MIRType) Never! {
    repr :: lower_repr(p, ty)
    if lower_close_method(p, m.close_methods, ty) == .Val(method) {
        if repr == .Boxed(_) | .Handle(_, _) {
            done :: lower_new_block(&f)
            zero :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
            absent :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: absent, condition: .Eq, left: value, right: zero})
            live :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(live, [LIRValueID]{})})
            lower_start(&f, live, [LIRValueID]{})
            lower_close_emit(p, &m, &f, value, ty, method)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
            lower_start(&f, done, [LIRValueID]{})
        } else {
            lower_close_emit(p, &m, &f, value, ty, method)
        }
        lower_forget(&f, value, ty.identity)
        return
    }
    if repr == .Inline(_) -> return lower_inline_drop(p, &m, &f, value, ty)
    drop :: lower_drop(&m, repr, true)
    if drop == .Trivial -> return
    if lower_value_drop(f, value) != .Trivial -> return lower_emit(&f, LIRInst.Drop{value: value})
    owned_layout :: lower_value_layout(f, value)
    owned :: lower_new_value(&f, owned_layout, drop, ty.identity)
    if owned_layout == lir_layout_pointer() -> lower_emit(&f, LIRInst.Reown{dst: owned, src: value})
    else -> lower_adopt(&f, owned, value)
    lower_emit(&f, LIRInst.Drop{value: owned})
}

fn lower_map_key_layout(p: MIRProgram, shape: LowerMapShape) -> LIRLayout Never! {
    lower_repr_layout(lower_repr(p, shape.key)) ?? lir_layout_word()
}

fn lower_map_value_layout(p: MIRProgram, shape: LowerMapShape) -> LIRLayout Never! {
    lower_repr_layout(lower_repr(p, shape.value)) ?? lir_layout_word()
}

// ---------------------------------------------------------------------------
// MIR operations.

// MIRRust.rs BuildMap collects the moved (key, value) pairs into a fresh
// BTreeMap: a later duplicate key replaces the earlier value.
fn lower_build_map(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, entries: [MIRMapEntry]) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Map construction without a checked type is not lowered at O0 yet")
    if lower_map_entry(ty) == None -> return lower_fail(&m, &f, "non-Map BuildMap is not lowered at O0 yet")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: zero})
    loop entry in entries {
        key :: lower_use(&m, &f, entry.key) ?? return
        value :: lower_use(&m, &f, entry.value) ?? return
        lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{dst, key, value}, None)
    }
}

// The address of the value stored under the key `index` in the Map header
// `map` of `ty`; a missing key stops (Core.rs jet_index_map_ref).
fn lower_map_value_address(p: MIRProgram, m: &LowerModule, f: &LowerFunction, map: LIRValueID, ty: MIRType, index: MIRValueID) -> LIRValueID? {
    shape :: lower_map_shape(p, ty) ?? {
        lower_fail(&m, &f, "non-Map indexed place is not lowered at O0 yet")
        return None
    }
    key :: lower_use(&m, &f, index) ?? return None
    found :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{map, key}, Val(found))
    zero :: lower_const(&f, 0)
    missing :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: missing, condition: LIRCondition.Lt, left: found, right: zero})
    lower_iter_check(&m, &f, missing, "the map has no entry for this key")
    data :: lower_list_data(&f, map)
    address :: lower_list_address(&f, data, found, shape.stride)
    Val(lower_address(&f, address, shape.value_offset))
}

// `map[key]` read as a value.
fn lower_map_index(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, base: MIRValueID, index: MIRValueID, access: MIRAccess) Never! {
    if access != .Read -> return lower_fail(&m, &f, "this Map indexed access is not lowered at O0 yet")
    map :: lower_use(&m, &f, base) ?? return
    ty :: lower_value_type(c, base) ?? return lower_fail(&m, &f, "Map index without a checked base type is not lowered at O0 yet")
    value_ty :: lower_map_value_type(ty) ?? return lower_fail(&m, &f, "non-Map indexed access is not lowered at O0 yet")
    address :: lower_map_value_address(p, &m, &f, map, ty, index) ?? return
    lower_index_result(p, c, &m, &f, instruction, base, address, value_ty)
}

// A write whose last projection indexes a Map inserts or replaces that key's
// entry (MIRRust.rs write_place's write_call, jet_map_update_string /
// jet_map_insert): the borrowed key is copied into a new entry, the value
// moves in. False when the place is no such write.
fn lower_map_index_write(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, slot: Int, row: MIRPlace, value: LIRValueID) -> Bool Never! {
    count :: row.projections.len()
    if count == 0 -> return false
    if row.projections[count - 1] == .Index(kind, index, _, _, _, _, _) {
        if kind != .Map -> return false
        root :: lower_slot_root_for_write(p, c, &m, &f, slot) ?? {
            lower_fail(&m, &f, "Map entry of place {row.id.value} is written before the place has a value")
            return true
        }
        header := root
        map_ty := c.slots[slot].ty
        if count > 1 {
            prefix := [MIRProjection]{}
            loop (position, projection) in row.projections {
                if position < count - 1 -> &prefix.push(projection)
            }
            walked :: lower_walk_place(p, c, &m, &f, root, c.slots[slot].ty, prefix, true) ?? return true
            if walked.borrowed {
                lower_fail(&m, &f, "writing through a field of runtime handle is not lowered at O0 yet")
                return true
            }
            header = lower_address(&f, walked.address.base, walked.address.offset)
            map_ty = walked.ty
        }
        shape :: lower_map_shape(p, map_ty) ?? {
            lower_fail(&m, &f, "Map index write into a non-Map place is not lowered at O0 yet")
            return true
        }
        key :: lower_use(&m, &f, index) ?? return true
        key_layout :: lower_value_layout(f, key)
        owned_key :: lower_new_value(&f, key_layout, LIRDrop.Trivial, None)
        lower_clone_into(p, &m, &f, key, owned_key, shape.key)
        // map.set writes the entry list in place: it must own it alone.
        lower_list_make_unique(p, &m, &f, header, map_ty)
        lower_call_helper(&m, &f, "map.set", map_ty, [LIRValueID]{header, owned_key, value}, None)
        return true
    }
    false
}

// Owned key operands consumed by Map insertion and Tally add/remove:
// owned place reads copy before the helper stores or retires the offered key.
fn lower_map_stored_operands(p: MIRProgram, m: LowerModule, operation: MIROperation) -> [MIRValueID] Never! {
    stored := [MIRValueID]{}
    if operation == .Semantic(semantic) {
        if semantic == .BuiltinMethod(call, _, _, args, _) {
            row :: lower_prelude_row(p, m, call) ?? return stored
            symbol :: lower_runtime_symbol(row)
            if symbol == "jet_map_insert" || symbol == "jet_bag_add" || symbol == "jet_bag_remove" {
                loop arg in args -> &stored.push(arg)
            }
        }
    }
    stored
}

// Map.to_list / items (core.map.to_list: Core.rs jet_map_to_list over
// jet_map_entries_kernel) and top_n (Collections.rs jet_map_top_n): the
// entries as `(key, value)` tuples. The Map's ascending entry buffer already
// is that List (lower_map_entry), so the result shares it (copy-on-write,
// #5041 P2). top_n detaches it, orders it by descending value then ascending
// key (list.rank_entries) and keeps the first max(n, 0) entries. False when
// `row` is neither.
fn lower_map_entry_list(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    symbol :: lower_runtime_symbol(row)
    to_list :: row.module_name == "core.map" && row.member == "to_list" && symbol == "jet_map_to_list"
    top_n :: row.module_name == "core.builtin" && row.member == "map_top_n" && symbol == "jet_map_top_n"
    if !to_list && !top_n -> return false
    if args.len() != (if top_n -> 1 else -> 0) {
        lower_fail(&m, &f, "Map {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    shape :: lower_map_shape(p, ty) ?? return false
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Map {row.member} without a checked result is not lowered at O0 yet")
        return true
    }
    elem :: lower_list_element(result_ty) ?? {
        lower_fail(&m, &f, "Map {row.member} into {mir_type_display_name(result_ty)} is not lowered at O0 yet")
        return true
    }
    if !lower_map_entry_layout(p, shape, elem) {
        lower_fail(&m, &f, "Map {row.member} entries as {mir_type_display_name(elem)} are not lowered at O0 yet")
        return true
    }
    if top_n && (lower_map_key_kind(p, shape.value) == "" || shape.stride %% 8 != 0) {
        lower_fail(&m, &f, "Map top_n over {mir_type_display_name(shape.value)} values is not lowered at O0 yet")
        return true
    }
    limit := LIRValueID?{None}
    if top_n -> limit = Val(lower_list_native_index(c, &m, &f, args[0]) ?? return true)
    map :: lower_use(&m, &f, receiver) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, result_ty)
    lower_copy_bytes(&f, dst, 0, map, 0, 24)
    lower_list_retain(&m, &f, dst)
    if limit == .Val(count) {
        lower_list_make_unique(p, &m, &f, dst, result_ty)
        lower_call_helper(&m, &f, "list.rank_entries", result_ty, [LIRValueID]{dst, count}, None)
    }
    true
}

// Whether `elem` stores exactly the entry tuple of `shape`: the same two
// members (key, value) at the same offsets and the same element stride.
fn lower_map_entry_layout(p: MIRProgram, shape: LowerMapShape, elem: MIRType) -> Bool Never! {
    if !lower_is_inline(p, elem) || lower_list_stride(p, elem) != shape.stride -> return false
    members :: lower_inline_members(p, elem)
    if members.len() != 2 -> return false
    if members[0].name != "key" || members[1].name != "value" -> return false
    if members[0].offset != shape.key_offset || members[1].offset != shape.value_offset -> return false
    mir_type_canonical_key(members[0].ty) == mir_type_canonical_key(shape.key) && mir_type_canonical_key(members[1].ty) == mir_type_canonical_key(shape.value)
}

// list.rank_entries(list, limit): orders the `(key, value)` entries of a
// List the header owns alone by descending value, ties by ascending key
// (Collections.rs jet_map_top_n's rank: insertion order of a total order, so
// the same sequence), then drops every entry past max(limit, 0).
fn lower_helper_list_rank_entries(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    elem :: lower_list_element(glue.ty) ?? panic("list.rank_entries helper has no List type")
    members :: lower_inline_members(p, elem)
    if members.len() != 2 -> panic("list.rank_entries helper has no (key, value) entry")
    key :: members[0].copy()
    value :: members[1].copy()
    stride :: lower_list_stride(p, elem)
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word()}, None)
    list :: f.open_params[0].copy()
    limit :: f.open_params[1].copy()
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_data(&f, list)
    zero :: lower_const(&f, 0)
    one :: lower_const(&f, 1)
    outer :: lower_new_block(&f)
    inner :: lower_new_block(&f)
    weigh :: lower_new_block(&f)
    tie :: lower_new_block(&f)
    by_key :: lower_new_block(&f)
    swap :: lower_new_block(&f)
    advance :: lower_new_block(&f)
    ranked :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(outer, [LIRValueID]{one})})
    lower_start(&f, outer, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(inner, [LIRValueID]{at}), else_target: lower_target(ranked, [LIRValueID]{})})
    slot :: lower_word(&f)
    lower_start(&f, inner, [LIRValueID]{slot})
    above :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: above, condition: LIRCondition.Gt, left: slot, right: zero})
    lower_seal(&f, LIRTerminator.Branch{condition: above, then_target: lower_target(weigh, [LIRValueID]{}), else_target: lower_target(advance, [LIRValueID]{})})
    lower_start(&f, weigh, [LIRValueID]{})
    before :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: before, op: LIRBinaryOp.Sub, left: slot, right: one})
    current :: lower_list_address(&f, data, slot, stride)
    previous :: lower_list_address(&f, data, before, stride)
    current_value :: lower_read_at(p, &f, current, value.offset, value.ty) ?? panic("an entry value has a layout")
    previous_value :: lower_read_at(p, &f, previous, value.offset, value.ty) ?? panic("an entry value has a layout")
    // The current entry ranks first when its value is greater.
    values :: lower_map_key_order(p, &m, &f, value.ty, previous_value, current_value)
    lower_seal(&f, LIRTerminator.Branch{condition: values.less, then_target: lower_target(swap, [LIRValueID]{}), else_target: lower_target(tie, [LIRValueID]{})})
    lower_start(&f, tie, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Branch{condition: values.same, then_target: lower_target(by_key, [LIRValueID]{}), else_target: lower_target(advance, [LIRValueID]{})})
    lower_start(&f, by_key, [LIRValueID]{})
    current_key :: lower_read_at(p, &f, current, key.offset, key.ty) ?? panic("an entry key has a layout")
    previous_key :: lower_read_at(p, &f, previous, key.offset, key.ty) ?? panic("an entry key has a layout")
    keys :: lower_map_key_order(p, &m, &f, key.ty, current_key, previous_key)
    lower_seal(&f, LIRTerminator.Branch{condition: keys.less, then_target: lower_target(swap, [LIRValueID]{}), else_target: lower_target(advance, [LIRValueID]{})})
    lower_start(&f, swap, [LIRValueID]{})
    // The whole padded entry moves; no owner is cloned or dropped.
    loop word in 0..<(stride /% 8) {
        offset :: word * 8
        mine :: lower_list_word(&f, current, offset)
        theirs :: lower_list_word(&f, previous, offset)
        lower_emit(&f, LIRInst.Store{base: current, offset: offset, value: theirs})
        lower_emit(&f, LIRInst.Store{base: previous, offset: offset, value: mine})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(inner, [LIRValueID]{before})})
    lower_start(&f, advance, [LIRValueID]{})
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(outer, [LIRValueID]{next_at})})
    // keep = min(max(limit, 0), length); the entries past it are dropped.
    lower_start(&f, ranked, [LIRValueID]{})
    negative :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: negative, condition: LIRCondition.Lt, left: limit, right: zero})
    bounded :: lower_new_block(&f)
    cut :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: negative, then_target: lower_target(cut, [LIRValueID]{zero}), else_target: lower_target(bounded, [LIRValueID]{})})
    lower_start(&f, bounded, [LIRValueID]{})
    over :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: over, condition: LIRCondition.Gt, left: limit, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: over, then_target: lower_target(cut, [LIRValueID]{length}), else_target: lower_target(cut, [LIRValueID]{limit})})
    keep :: lower_word(&f)
    lower_start(&f, cut, [LIRValueID]{keep})
    drop_head :: lower_new_block(&f)
    drop_body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(drop_head, [LIRValueID]{keep})})
    dropping :: lower_word(&f)
    lower_start(&f, drop_head, [LIRValueID]{dropping})
    past :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: past, condition: LIRCondition.Lt, left: dropping, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: past, then_target: lower_target(drop_body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, drop_body, [LIRValueID]{})
    gone :: lower_list_address(&f, data, dropping, stride)
    lower_drop_stored(p, &m, &f, gone, 0, elem)
    next_drop :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_drop, op: LIRBinaryOp.Add, left: dropping, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(drop_head, [LIRValueID]{next_drop})})
    lower_start(&f, done, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: list, offset: 0, value: keep})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Map builtin methods by runtime route (Collections.rs / Core.rs jet_map_*):
// len, is_empty, get (an owned copy of the value), has_key, insert (the
// replaced value) and remove (jet_map_pop_kernel: the removed value).
fn lower_map_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID]) -> Bool Never! {
    ty :: lower_value_type(c, receiver) ?? return false
    if lower_map_entry(ty) == None -> return false
    if row.family != .BuiltinMethod -> return false
    if lower_map_entry_list(p, c, &m, &f, instruction, row, receiver, args, ty) -> return true
    if row.module_name != "core.builtin" -> return false
    symbol :: lower_runtime_symbol(row)
    if lower_map_method_more(p, c, &m, &f, instruction, row, symbol, receiver, receiver_place, args, ty) -> return true
    counted :: symbol == "jet_map_len" || symbol == "jet_map_is_empty"
    keyed :: symbol == "jet_map_get_opt" || symbol == "jet_map_has_key" || symbol == "jet_map_pop_kernel"
    inserting :: symbol == "jet_map_insert"
    if !counted && !keyed && !inserting -> return false
    arity :: if {
        counted -> 0
        keyed -> 1
        else -> 2
    }
    if args.len() != arity {
        lower_fail(&m, &f, "this Map method arity is not lowered at O0 yet")
        return true
    }
    mutating :: inserting || symbol == "jet_map_pop_kernel"
    map := LIRValueID{value: -1}
    if mutating {
        map = lower_receiver_header(p, c, &m, &f, receiver_place, "Map") ?? return true
    } else {
        map = lower_use(&m, &f, receiver) ?? return true
    }
    if counted {
        length :: lower_list_word(&f, map, 0)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_map_len" {
            lower_native_count(p, c, &m, &f, instruction, dst, length)
        } else {
            zero :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: length, right: zero})
        }
        return true
    }
    key :: lower_use(&m, &f, args[0]) ?? return true
    if inserting {
        value :: lower_use(&m, &f, args[1]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_helper(&m, &f, "map.insert", ty, [LIRValueID]{map, key, value}, Val(dst))
        return true
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    if symbol == "jet_map_has_key" {
        found :: lower_word(&f)
        lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{map, key}, Val(found))
        zero :: lower_const(&f, 0)
        lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ge, left: found, right: zero})
    } else {
        lower_call_helper(&m, &f, if symbol == "jet_map_get_opt" -> "map.get" else -> "map.remove", ty, [LIRValueID]{map, key}, Val(dst))
    }
    true
}

// Key/value views, merge and update builtins (Core.rs jet_map_keys,
// jet_map_values, jet_map_merge, jet_map_merge_with, jet_map_update_all),
// as generated LIR. False when `symbol` is not one.
//
// jet_map_keys/values return a lazy JetIter over the map's shared storage
// that later map mutations never reach (the map copies on write): the same
// sequence is a List of the entries' copies, in key order, handed to the
// shared Iter runtime by value.
fn lower_map_method_more(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, symbol: String, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    if lower_map_method_query(p, c, &m, &f, instruction, row, symbol, receiver, receiver_place, args, ty) -> return true
    if symbol == "jet_map_slice_keys_kernel" -> return lower_map_slice(p, c, &m, &f, instruction, row, receiver, args, ty)
    viewing :: symbol == "jet_map_keys" || symbol == "jet_map_values"
    merging :: symbol == "jet_map_merge" || symbol == "jet_map_update_all"
    resolving :: symbol == "jet_map_merge_with"
    if !viewing && !merging && !resolving -> return false
    arity :: if viewing -> 0 else if merging -> 1 else -> 2
    if args.len() != arity {
        lower_fail(&m, &f, "Map {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    shape :: lower_map_shape(p, ty) ?? {
        lower_fail(&m, &f, "Map {row.member} over {mir_type_display_name(ty)} is not lowered at O0 yet")
        return true
    }
    if viewing {
        keys :: symbol == "jet_map_keys"
        item_ty :: if keys -> shape.key else -> shape.value
        offset :: if keys -> shape.key_offset else -> shape.value_offset
        if lower_repr(p, item_ty) == .Absent {
            lower_fail(&m, &f, "Map {row.member} of {mir_type_display_name(item_ty)} is not lowered at O0 yet")
            return true
        }
        map :: lower_use(&m, &f, receiver) ?? return true
        length :: lower_list_word(&f, map, 0)
        stride :: lower_list_stride(p, item_ty)
        data :: lower_list_buffer(&m, &f, length, stride)
        items :: lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: items, size: 24, align: 8})
        lower_emit(&f, LIRInst.Store{base: items, offset: 0, value: length})
        lower_emit(&f, LIRInst.Store{base: items, offset: 8, value: length})
        lower_emit(&f, LIRInst.Store{base: items, offset: 16, value: data})
        each :: lower_each_begin(p, &f, map, shape.entry, [LIRValueID]{})
        from :: lower_address(&f, each.address, offset)
        to :: lower_list_address(&f, data, each.at, stride)
        lower_list_clone_element(p, &m, &f, from, to, item_ty)
        lower_each_end(&f, each, [LIRValueID]{})
        meta :: lower_lazy_meta(p, &m, &f, item_ty)
        moved :: lower_const_flag(&f, 1)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_call_runtime(&m, &f, "jet_rt_native_iter_from_list", [LIRValueID]{items, meta, moved}, Val(dst))
        return true
    }
    if lower_repr(p, shape.value) == .Absent {
        lower_fail(&m, &f, "Map {row.member} of {mir_type_display_name(shape.value)} values is not lowered at O0 yet")
        return true
    }
    other :: lower_use(&m, &f, args[0]) ?? return true
    target := LIRValueID{value: -1}
    if symbol == "jet_map_update_all" {
        target = lower_receiver_header(p, c, &m, &f, receiver_place, "Map") ?? return true
        lower_alias_absent(&f, instruction)
    } else {
        left :: lower_use(&m, &f, receiver) ?? return true
        target = lower_result(p, c, &m, &f, instruction) ?? return true
        lower_storage_into(p, &f, target, ty)
        lower_inline_clone(p, &m, &f, left, target, ty)
    }
    closure := LIRValueID?{None}
    closure_ty := ty
    if resolving {
        // The inline merge loop would consume a stopped callback's unwritten
        // result (#4720; Combinators.jet lower_closure_method).
        if m.stop_points {
            lower_fail(&m, &f, "Map merge with a conflict callback in a stop-point module is not lowered at O0 yet")
            return true
        }
        closure = lower_use(&m, &f, args[1])
        if closure == None -> return true
        closure_ty = lower_value_type(c, args[1]) ?? {
            lower_fail(&m, &f, "Map merge conflict callback without a checked type is not lowered at O0 yet")
            return true
        }
    }
    // Right wins: each entry of `other`, in key order, is set as a copy; with
    // a conflict callback a shared key's value becomes
    // `conflict(&key, left value moved out, copy of right value)`.
    each :: lower_each_begin(p, &f, other, shape.entry, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, shape.key_offset, shape.key) ?? return true
    value :: lower_read_at(p, &f, each.address, shape.value_offset, shape.value) ?? return true
    owned_value :: lower_new_like(&f, value)
    lower_clone_into(p, &m, &f, value, owned_value, shape.value)
    if closure == .Val(callback) {
        found :: lower_word(&f)
        lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{target, key}, Val(found))
        zero :: lower_const(&f, 0)
        shared :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: shared, condition: LIRCondition.Ge, left: found, right: zero})
        resolve :: lower_new_block(&f)
        insert :: lower_new_block(&f)
        next_block :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: shared, then_target: lower_target(resolve, [LIRValueID]{}), else_target: lower_target(insert, [LIRValueID]{})})
        lower_start(&f, resolve, [LIRValueID]{})
        data :: lower_list_data(&f, target)
        entry :: lower_list_address(&f, data, found, shape.stride)
        slot :: lower_address(&f, entry, shape.value_offset)
        left_value :: lower_read_at(p, &f, slot, 0, shape.value) ?? return true
        resolved :: lower_call_closure_box(p, &m, &f, callback, [LIRValueID]{key, left_value, owned_value}, shape.value) ?? return true
        // A value parameter the callback takes by Read stays ours to drop.
        if !lower_closure_param_moves(closure_ty, 1) -> lower_drop_stored(p, &m, &f, slot, 0, shape.value)
        if !lower_closure_param_moves(closure_ty, 2) -> lower_map_drop_value(p, &m, &f, owned_value, shape.value)
        lower_write_at(p, &f, slot, 0, resolved, shape.value)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_block, [LIRValueID]{})})
        lower_start(&f, insert, [LIRValueID]{})
        owned_key :: lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned_key, shape.key)
        lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{target, owned_key, owned_value}, None)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_block, [LIRValueID]{})})
        lower_start(&f, next_block, [LIRValueID]{})
    } else {
        owned_key :: lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned_key, shape.key)
        lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{target, owned_key, owned_value}, None)
    }
    lower_each_end(&f, each, [LIRValueID]{})
    if closure == .Val(callback) {
        if lower_value_owned(c, args[1]) -> lower_map_drop_value(p, &m, &f, callback, closure_ty)
    }
    true
}

// `m.slice(keys)` (Collections.rs jet_map_slice_keys_kernel): each listed key
// the Map holds, in List order, with a copy of its value; a key the Map lacks
// is skipped. The keys List is dropped when moved in.
fn lower_map_slice(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    shape :: lower_map_shape(p, ty) ?? {
        lower_fail(&m, &f, "Map {row.member} over {mir_type_display_name(ty)} is not lowered at O0 yet")
        return true
    }
    if args.len() != 1 || lower_repr(p, shape.value) == .Absent {
        lower_fail(&m, &f, "Map {row.member} with {args.len()} arguments over {mir_type_display_name(ty)} is not lowered at O0 yet")
        return true
    }
    keys_ty :: lower_value_type(c, args[0]) ?? {
        lower_fail(&m, &f, "Map {row.member} keys without a checked type are not lowered at O0 yet")
        return true
    }
    map :: lower_use(&m, &f, receiver) ?? return true
    keys :: lower_use(&m, &f, args[0]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_storage_into(p, &f, dst, ty)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: zero})
    each :: lower_each_begin(p, &f, keys, shape.key, [LIRValueID]{})
    key :: lower_read_at(p, &f, each.address, 0, shape.key) ?? return true
    found :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{map, key}, Val(found))
    held :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: held, condition: LIRCondition.Ge, left: found, right: zero})
    present :: lower_new_block(&f)
    next_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: held, then_target: lower_target(present, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, present, [LIRValueID]{})
    map_data :: lower_list_data(&f, map)
    entry :: lower_list_address(&f, map_data, found, shape.stride)
    value :: lower_read_at(p, &f, entry, shape.value_offset, shape.value) ?? return true
    owned_key :: lower_new_like(&f, key)
    lower_clone_into(p, &m, &f, key, owned_key, shape.key)
    owned_value :: lower_new_like(&f, value)
    lower_clone_into(p, &m, &f, value, owned_value, shape.value)
    lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{dst, owned_key, owned_value}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, next_block, [LIRValueID]{})
    lower_each_end(&f, each, [LIRValueID]{})
    if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, keys, keys_ty)
    true
}

// Query and single-entry builtins (Core.rs / Collections.rs jet_map_equal,
// jet_map_contains_value, jet_map_first_key, jet_map_min/max_value_kernel,
// jet_map_intersection, jet_map_add_new, jet_map_setdefault,
// jet_map_pop_first), as generated LIR. Results that are copies clone out of
// the borrowed entries. False when `symbol` is not one.
fn lower_map_method_query(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, symbol: String, receiver: MIRValueID, receiver_place: MIRPlaceID?, args: [MIRValueID], ty: MIRType) -> Bool Never! {
    nullary :: symbol == "jet_map_first_key" || symbol == "jet_map_min_value_kernel" || symbol == "jet_map_max_value_kernel" || symbol == "jet_map_pop_first"
    unary :: symbol == "jet_map_equal" || symbol == "jet_map_contains_value" || symbol == "jet_map_intersection"
    binary :: symbol == "jet_map_add_new" || symbol == "jet_map_setdefault"
    if !nullary && !unary && !binary -> return false
    if args.len() != (if nullary -> 0 else if unary -> 1 else -> 2) {
        lower_fail(&m, &f, "Map {row.member} with {args.len()} arguments is not lowered at O0 yet")
        return true
    }
    shape :: lower_map_shape(p, ty) ?? {
        lower_fail(&m, &f, "Map {row.member} over {mir_type_display_name(ty)} is not lowered at O0 yet")
        return true
    }
    if lower_repr(p, shape.value) == .Absent {
        lower_fail(&m, &f, "Map {row.member} of {mir_type_display_name(shape.value)} values is not lowered at O0 yet")
        return true
    }
    zero :: lower_const(&f, 0)
    if binary || symbol == "jet_map_pop_first" {
        map :: lower_receiver_header(p, c, &m, &f, receiver_place, "Map") ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        if symbol == "jet_map_pop_first" {
            // The first (least) key's value, moved out; None when empty.
            length :: lower_list_word(&f, map, 0)
            empty :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: length, right: zero})
            removal :: lower_new_block(&f)
            done :: lower_new_block(&f)
            null :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Const{dst: null, value: 0})
            lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(done, [LIRValueID]{null}), else_target: lower_target(removal, [LIRValueID]{})})
            lower_start(&f, removal, [LIRValueID]{})
            data :: lower_list_data(&f, map)
            key :: lower_read_at(p, &f, data, shape.key_offset, shape.key) ?? return true
            taken :: lower_pointer(&f)
            lower_call_helper(&m, &f, "map.remove", ty, [LIRValueID]{map, key}, Val(taken))
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{taken})})
            lower_start(&f, done, [LIRValueID]{dst})
            return true
        }
        key :: lower_use(&m, &f, args[0]) ?? return true
        value :: lower_use(&m, &f, args[1]) ?? return true
        found :: lower_word(&f)
        lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{map, key}, Val(found))
        present :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ge, left: found, right: zero})
        hit :: lower_new_block(&f)
        miss :: lower_new_block(&f)
        join :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
        // A present key keeps its entry: the offered key and value drop.
        lower_start(&f, hit, [LIRValueID]{})
        if lower_value_owned(c, args[0]) -> lower_map_drop_value(p, &m, &f, key, shape.key)
        if lower_value_owned(c, args[1]) -> lower_map_drop_value(p, &m, &f, value, shape.value)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{found})})
        lower_start(&f, miss, [LIRValueID]{})
        owned_key := key
        if !lower_value_owned(c, args[0]) {
            owned_key = lower_new_like(&f, key)
            lower_clone_into(p, &m, &f, key, owned_key, shape.key)
        }
        owned_value := value
        if !lower_value_owned(c, args[1]) {
            owned_value = lower_new_like(&f, value)
            lower_clone_into(p, &m, &f, value, owned_value, shape.value)
        }
        lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{map, owned_key, owned_value}, None)
        minus_one :: lower_const(&f, -1)
        point :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: point, op: LIRBinaryOp.Sub, left: minus_one, right: found})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{point})})
        index :: lower_word(&f)
        lower_start(&f, join, [LIRValueID]{index})
        if symbol == "jet_map_add_new" {
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Lt, left: found, right: zero})
            return true
        }
        // setdefault: a copy of the value now under the key.
        data :: lower_list_data(&f, map)
        entry :: lower_list_address(&f, data, index, shape.stride)
        stored :: lower_read_at(p, &f, entry, shape.value_offset, shape.value) ?? return true
        if lower_is_inline(p, shape.value) {
            lower_storage_into(p, &f, dst, shape.value)
            lower_inline_clone(p, &m, &f, stored, dst, shape.value)
        } else {
            lower_clone_into(p, &m, &f, stored, dst, shape.value)
        }
        return true
    }
    map :: lower_use(&m, &f, receiver) ?? return true
    if symbol == "jet_map_equal" {
        other :: lower_use(&m, &f, args[0]) ?? return true
        same :: lower_equal_values(p, &m, &f, ty, Val(map), Val(other)) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_emit(&f, LIRInst.Move{dst: dst, src: same})
        return true
    }
    if symbol == "jet_map_intersection" {
        other :: lower_use(&m, &f, args[0]) ?? return true
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_storage_into(p, &f, dst, ty)
        lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: zero})
        lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: zero})
        lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: zero})
        each :: lower_each_begin(p, &f, map, shape.entry, [LIRValueID]{})
        key :: lower_read_at(p, &f, each.address, shape.key_offset, shape.key) ?? return true
        found :: lower_word(&f)
        lower_call_helper(&m, &f, "map.find", ty, [LIRValueID]{other, key}, Val(found))
        shared :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: shared, condition: LIRCondition.Ge, left: found, right: zero})
        keep :: lower_new_block(&f)
        skip :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: shared, then_target: lower_target(keep, [LIRValueID]{}), else_target: lower_target(skip, [LIRValueID]{})})
        lower_start(&f, keep, [LIRValueID]{})
        value :: lower_read_at(p, &f, each.address, shape.value_offset, shape.value) ?? return true
        owned_key :: lower_new_like(&f, key)
        lower_clone_into(p, &m, &f, key, owned_key, shape.key)
        owned_value :: lower_new_like(&f, value)
        lower_clone_into(p, &m, &f, value, owned_value, shape.value)
        lower_call_helper(&m, &f, "map.set", ty, [LIRValueID]{dst, owned_key, owned_value}, None)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(skip, [LIRValueID]{})})
        lower_start(&f, skip, [LIRValueID]{})
        lower_each_end(&f, each, [LIRValueID]{})
        return true
    }
    if symbol == "jet_map_contains_value" {
        needle :: lower_use(&m, &f, args[0]) ?? return true
        no :: lower_const_flag(&f, 0)
        done :: lower_new_block(&f)
        each :: lower_each_begin(p, &f, map, shape.entry, [LIRValueID]{})
        value :: lower_render_load(p, &f, each.address, shape.value_offset, shape.value, false)
        same :: lower_equal_values(p, &m, &f, shape.value, value, Val(needle)) ?? return true
        hit :: lower_new_block(&f)
        miss :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
        lower_start(&f, hit, [LIRValueID]{})
        yes :: lower_const_flag(&f, 1)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{yes})})
        lower_start(&f, miss, [LIRValueID]{})
        lower_each_end(&f, each, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{no})})
        found :: lower_flag(&f)
        lower_start(&f, done, [LIRValueID]{found})
        dst :: lower_result(p, c, &m, &f, instruction) ?? return true
        lower_emit(&f, LIRInst.Move{dst: dst, src: found})
        return true
    }
    // first_key / min / max: a copy of the chosen key or value in an Option
    // box, None when the map is empty. min keeps the first least value, max
    // the last greatest (Iterator::min / max); equal values are equal copies.
    keyed :: symbol == "jet_map_first_key"
    item_ty :: if keyed -> shape.key else -> shape.value
    offset :: if keyed -> shape.key_offset else -> shape.value_offset
    if !keyed && lower_map_key_kind(p, item_ty) == "" {
        lower_fail(&m, &f, "Map {row.member} of {mir_type_display_name(item_ty)} values is not lowered at O0 yet")
        return true
    }
    length :: lower_list_word(&f, map, 0)
    empty :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: empty, condition: LIRCondition.Eq, left: length, right: zero})
    pick :: lower_new_block(&f)
    done :: lower_new_block(&f)
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Branch{condition: empty, then_target: lower_target(done, [LIRValueID]{null}), else_target: lower_target(pick, [LIRValueID]{})})
    lower_start(&f, pick, [LIRValueID]{})
    data :: lower_list_data(&f, map)
    chosen := data
    if !keyed {
        // The address of the chosen entry, scanning from the first.
        each :: lower_each_begin(p, &f, map, shape.entry, [LIRValueID]{data})
        best :: each.state[0]
        candidate :: lower_read_at(p, &f, each.address, offset, item_ty) ?? return true
        incumbent :: lower_read_at(p, &f, best, offset, item_ty) ?? return true
        order :: if symbol == "jet_map_min_value_kernel" -> lower_map_key_order(p, &m, &f, item_ty, candidate, incumbent) else -> lower_map_key_order(p, &m, &f, item_ty, incumbent, candidate)
        replace := order.less
        if symbol == "jet_map_max_value_kernel" {
            replace = lower_flag(&f)
            lower_logic(&f, replace, false, order.less, order.same)
        }
        better :: lower_new_block(&f)
        join :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: replace, then_target: lower_target(better, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{best})})
        lower_start(&f, better, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{each.address})})
        kept :: lower_pointer(&f)
        lower_start(&f, join, [LIRValueID]{kept})
        lower_each_end(&f, each, [LIRValueID]{kept})
        chosen = each.exit[0]
    }
    boxed :: lower_pointer(&f)
    lower_alloc(&m, &f, boxed, lower_option_box_size(p, item_ty))
    from :: lower_address(&f, chosen, offset)
    lower_list_clone_element(p, &m, &f, from, boxed, item_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{boxed})})
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    lower_start(&f, done, [LIRValueID]{dst})
    true
}

// ---------------------------------------------------------------------------
// Generated helpers, one per Map type: map.find (the entry index of a key,
// or -1 - its insertion point), map.set, map.insert, map.get, map.remove;
// and map.key_compare, one per tuple, struct, Option or payload enum key type.

// The order of two keys of `glue.ty` (both addresses, or both boxes) as -1, 0
// or 1: the first member pair that differs decides (derived Ord). An Option
// orders None before every Some (Rust Option's Ord), then its payloads; a
// payload enum orders by variant ordinal, then the selected variant's payload
// members in order (Rust derived Ord).
fn lower_helper_map_key_compare(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, Val(lir_layout_word()))
    left :: f.open_params[0].copy()
    right :: f.open_params[1].copy()
    if lower_option_inner(glue.ty) == .Val(inner) {
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        left_absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: left_absent, condition: LIRCondition.Eq, left: left, right: null})
        right_absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: right_absent, condition: LIRCondition.Eq, left: right, right: null})
        // Present-ness orders first: when exactly one is absent, the absent
        // one is Less.
        same :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: left_absent, right: right_absent})
        lower_key_compare_decide(&f, LowerMapOrder{less: left_absent, same: same})
        both_absent :: lower_new_block(&f)
        both_present :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: left_absent, then_target: lower_target(both_absent, [LIRValueID]{}), else_target: lower_target(both_present, [LIRValueID]{})})
        lower_start(&f, both_absent, [LIRValueID]{})
        equal :: lower_const(&f, 0)
        lower_seal(&f, LIRTerminator.Return{value: Val(equal)})
        lower_start(&f, both_present, [LIRValueID]{})
        lower_key_compare_member(p, &m, &f, inner, left, right, 0, false)
    } else if lower_is_inline(p, glue.ty) {
        loop member in lower_inline_members(p, glue.ty) {
            lower_key_compare_member(p, &m, &f, member.ty, left, right, member.offset, member.boxed)
        }
    } else if lower_type_def(p, glue.ty) == .Val(definition) {
        variants :: if definition.kind == {
            .Enum(rows, _) -> rows
            else -> panic("map.key_compare of {mir_type_display_name(glue.ty)} has no ordered definition")
        }
        left_tag :: lower_list_word(&f, left, 0)
        right_tag :: lower_list_word(&f, right, 0)
        lower_key_compare_step(&f, left_tag, right_tag, LIRCondition.Lt)
        loop (index, variant) in variants {
            members :: lower_variant_members(p, definition, variant)
            if members.len() == 0 -> next
            expected :: lower_const(&f, lower_discriminant(index))
            selected :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: selected, condition: LIRCondition.Eq, left: left_tag, right: expected})
            body :: lower_new_block(&f)
            next_block :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: selected, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
            lower_start(&f, body, [LIRValueID]{})
            loop member in members {
                lower_key_compare_member(p, &m, &f, member.ty, left, right, member.offset, member.boxed)
            }
            decided :: lower_const(&f, 0)
            lower_seal(&f, LIRTerminator.Return{value: Val(decided)})
            lower_start(&f, next_block, [LIRValueID]{})
        }
    } else {
        panic("map.key_compare of {mir_type_display_name(glue.ty)} has no ordered definition")
    }
    zero :: lower_const(&f, 0)
    lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    lir_builder_finish(f.builder)
}

// Compare the members of `ty` at `left`/`right` + `offset` (through their
// recursive-edge wrapper when `boxed`); return -1 or 1 when they differ, else
// continue in a new block.
fn lower_key_compare_member(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, left: LIRValueID, right: LIRValueID, offset: Int, boxed: Bool) Never! {
    a :: lower_render_load(p, &f, left, offset, ty, boxed) ?? return
    b :: lower_render_load(p, &f, right, offset, ty, boxed) ?? return
    order :: lower_map_key_order(p, &m, &f, ty, a, b)
    lower_key_compare_decide(&f, order)
}

// Two words ordered by `less` (Lt or ULt): return -1 or 1 when they differ,
// else continue in a new block.
fn lower_key_compare_step(f: &LowerFunction, a: LIRValueID, b: LIRValueID, less: LIRCondition) Never! {
    before :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: before, condition: less, left: a, right: b})
    same :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: a, right: b})
    lower_key_compare_decide(&f, LowerMapOrder{less: before, same: same})
}

fn lower_key_compare_decide(f: &LowerFunction, order: LowerMapOrder) Never! {
    before :: lower_new_block(&f)
    differ :: lower_new_block(&f)
    after :: lower_new_block(&f)
    same :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: order.same, then_target: lower_target(same, [LIRValueID]{}), else_target: lower_target(differ, [LIRValueID]{})})
    lower_start(&f, differ, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(before, [LIRValueID]{}), else_target: lower_target(after, [LIRValueID]{})})
    lower_start(&f, before, [LIRValueID]{})
    minus_one :: lower_const(&f, -1)
    lower_seal(&f, LIRTerminator.Return{value: Val(minus_one)})
    lower_start(&f, after, [LIRValueID]{})
    plus_one :: lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Return{value: Val(plus_one)})
    lower_start(&f, same, [LIRValueID]{})
}

fn lower_helper_map(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    if glue.helper == "map.key_compare" -> return lower_helper_map_key_compare(p, &m, glue)
    shape :: lower_map_shape(p, glue.ty) ?? panic("Map helper {glue.helper} has no Map type")
    if glue.helper == "map.find" -> return lower_helper_map_find(p, &m, glue, shape)
    if glue.helper == "map.set" || glue.helper == "map.insert" || glue.helper == "map.increment" -> return lower_helper_map_insert(p, &m, glue, shape, glue.helper == "map.insert")
    if glue.helper == "map.get" || glue.helper == "map.remove" || glue.helper == "map.count" || glue.helper == "map.decrement" -> return lower_helper_map_take(p, &m, glue, shape, glue.helper == "map.remove" || glue.helper == "map.decrement")
    f := lower_helper_start(&m, glue, [LIRLayout]{}, None)
    lower_fail(&m, &f, "helper {glue.helper} has no generator")
    lower_seal(&f, LIRTerminator.Unreachable)
    lir_builder_finish(f.builder)
}

// Binary search over the ascending entries.
fn lower_helper_map_find(p: MIRProgram, m: &LowerModule, glue: LowerGlue, shape: LowerMapShape) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lower_map_key_layout(p, shape)}, Val(lir_layout_word()))
    map :: f.open_params[0].copy()
    key :: f.open_params[1].copy()
    length :: lower_list_word(&f, map, 0)
    data :: lower_list_data(&f, map)
    zero :: lower_const(&f, 0)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    differ :: lower_new_block(&f)
    above :: lower_new_block(&f)
    below :: lower_new_block(&f)
    found :: lower_new_block(&f)
    missing :: lower_new_block(&f)
    low :: lower_word(&f)
    high :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero, length})})
    lower_start(&f, head, [LIRValueID]{low, high})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: low, right: high})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(missing, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    sum :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: sum, op: LIRBinaryOp.Add, left: low, right: high})
    one :: lower_const(&f, 1)
    middle :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: middle, op: LIRBinaryOp.Shr, left: sum, right: one})
    address :: lower_list_address(&f, data, middle, shape.stride)
    probe :: lower_read_at(p, &f, address, shape.key_offset, shape.key) ?? panic("a Map key has a layout")
    order :: lower_map_key_order(p, &m, &f, shape.key, probe, key)
    lower_seal(&f, LIRTerminator.Branch{condition: order.same, then_target: lower_target(found, [LIRValueID]{}), else_target: lower_target(differ, [LIRValueID]{})})
    lower_start(&f, differ, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Branch{condition: order.less, then_target: lower_target(above, [LIRValueID]{}), else_target: lower_target(below, [LIRValueID]{})})
    lower_start(&f, above, [LIRValueID]{})
    next_low :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_low, op: LIRBinaryOp.Add, left: middle, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_low, high})})
    lower_start(&f, below, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{low, middle})})
    lower_start(&f, found, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: Val(middle)})
    lower_start(&f, missing, [LIRValueID]{})
    minus_one :: lower_const(&f, -1)
    point :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: point, op: LIRBinaryOp.Sub, left: minus_one, right: low})
    lower_seal(&f, LIRTerminator.Return{value: Val(point)})
    lir_builder_finish(f.builder)
}

// Moves the key and value in: an existing key keeps its entry key (the
// incoming one is dropped) and its value is replaced, dropped by map.set and
// returned in an Option box by map.insert (null when the key was new).
// map.increment's count is a word it adds; the key is taken.
fn lower_helper_map_insert(p: MIRProgram, m: &LowerModule, glue: LowerGlue, shape: LowerMapShape, returns_old: Bool) -> LIRFunction Never! {
    result :: if returns_old -> Val(lir_layout_pointer()) else -> None
    increments :: glue.helper == "map.increment"
    taken := [LIRDrop]{LIRDrop.Trivial, lower_drop(&m, lower_repr(p, shape.key), true)}
    if !increments -> &taken.push(lower_drop(&m, lower_repr(p, shape.value), true))
    f := lower_helper_start_taking(&m, glue, [LIRLayout]{lir_layout_pointer(), lower_map_key_layout(p, shape), lower_map_value_layout(p, shape)}, taken, result)
    map :: f.open_params[0].copy()
    key :: f.open_params[1].copy()
    value :: f.open_params[2].copy()
    index :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", glue.ty, [LIRValueID]{map, key}, Val(index))
    zero :: lower_const(&f, 0)
    exists :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: exists, condition: LIRCondition.Ge, left: index, right: zero})
    replace :: lower_new_block(&f)
    add :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: exists, then_target: lower_target(replace, [LIRValueID]{}), else_target: lower_target(add, [LIRValueID]{})})

    lower_start(&f, replace, [LIRValueID]{})
    data :: lower_list_data(&f, map)
    entry :: lower_list_address(&f, data, index, shape.stride)
    slot :: lower_address(&f, entry, shape.value_offset)
    old := LIRValueID?{None}
    if increments {
        count :: lower_list_word(&f, slot, 0)
        next :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next, op: LIRBinaryOp.Add, left: count, right: value})
        lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: next})
        lower_map_drop_value(p, &m, &f, key, shape.key)
        lower_seal(&f, LIRTerminator.Return{value: None})
    } else {
        if returns_old {
            boxed :: lower_pointer(&f)
            lower_alloc(&m, &f, boxed, lower_option_box_size(p, shape.value))
            lower_list_move(p, &f, boxed, slot, shape.value)
            old = Val(boxed)
        } else {
            lower_drop_stored(p, &m, &f, slot, 0, shape.value)
        }
        lower_write_at(p, &f, slot, 0, value, shape.value)
        lower_map_drop_value(p, &m, &f, key, shape.key)
        lower_seal(&f, LIRTerminator.Return{value: old})
    }

    lower_start(&f, add, [LIRValueID]{})
    minus_one :: lower_const(&f, -1)
    point :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: point, op: LIRBinaryOp.Sub, left: minus_one, right: index})
    length :: lower_list_reserve(p, &m, &f, map, shape.entry)
    room :: lower_list_data(&f, map)
    // Shift the entries at and after the insertion point up by one: a single
    // overlapping byte move of their (length - point) * stride bytes.
    target :: lower_list_address(&f, room, point, shape.stride)
    one :: lower_const(&f, 1)
    after :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: after, op: LIRBinaryOp.Add, left: point, right: one})
    shifted :: lower_list_address(&f, room, after, shape.stride)
    tail :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: tail, op: LIRBinaryOp.Sub, left: length, right: point})
    stride :: lower_const(&f, shape.stride)
    bytes :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: LIRBinaryOp.Mul, left: tail, right: stride})
    lower_call_runtime(&m, &f, "jet_rt_mem_move", [LIRValueID]{shifted, target, bytes}, None)
    lower_write_at(p, &f, target, shape.key_offset, key, shape.key)
    lower_write_at(p, &f, target, shape.value_offset, value, shape.value)
    grown :: lower_word(&f)
    increment :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: grown, op: LIRBinaryOp.Add, left: length, right: increment})
    lower_emit(&f, LIRInst.Store{base: map, offset: 0, value: grown})
    if returns_old {
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    } else {
        lower_seal(&f, LIRTerminator.Return{value: None})
    }
    lir_builder_finish(f.builder)
}

// The value under a borrowed key in an Option box (null when absent):
// map.get copies it (jet_map_get_opt's `.cloned()`); map.remove moves it out,
// drops the entry's key and closes the gap (jet_map_pop_kernel).
fn lower_helper_map_take(p: MIRProgram, m: &LowerModule, glue: LowerGlue, shape: LowerMapShape, removes: Bool) -> LIRFunction Never! {
    counting :: glue.helper == "map.count"
    decrementing :: glue.helper == "map.decrement"
    result :: if counting -> Val(lir_layout_word()) else if decrementing -> None else -> Val(lir_layout_pointer())
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lower_map_key_layout(p, shape)}, result)
    map :: f.open_params[0].copy()
    key :: f.open_params[1].copy()
    index :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", glue.ty, [LIRValueID]{map, key}, Val(index))
    zero :: lower_const(&f, 0)
    exists :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: exists, condition: LIRCondition.Ge, left: index, right: zero})
    present :: lower_new_block(&f)
    absent :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: exists, then_target: lower_target(present, [LIRValueID]{}), else_target: lower_target(absent, [LIRValueID]{})})

    lower_start(&f, absent, [LIRValueID]{})
    missing := LIRValueID?{None}
    if counting -> missing = Val(zero)
    else if !decrementing {
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        missing = Val(null)
    }
    lower_seal(&f, LIRTerminator.Return{value: missing})

    lower_start(&f, present, [LIRValueID]{})
    data :: lower_list_data(&f, map)
    entry :: lower_list_address(&f, data, index, shape.stride)
    slot :: lower_address(&f, entry, shape.value_offset)
    taken := LIRValueID?{None}
    if counting {
        count :: lower_list_word(&f, slot, 0)
        lower_seal(&f, LIRTerminator.Return{value: Val(count)})
        return lir_builder_finish(f.builder)
    }
    if decrementing {
        count :: lower_list_word(&f, slot, 0)
        one :: lower_const(&f, 1)
        multiple :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: multiple, condition: LIRCondition.UGt, left: count, right: one})
        reduce :: lower_new_block(&f)
        erase :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: multiple, then_target: lower_target(reduce, [LIRValueID]{}), else_target: lower_target(erase, [LIRValueID]{})})
        lower_start(&f, reduce, [LIRValueID]{})
        next :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: next, op: LIRBinaryOp.Sub, left: count, right: one})
        lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: next})
        lower_seal(&f, LIRTerminator.Return{value: None})
        lower_start(&f, erase, [LIRValueID]{})
    } else {
        boxed :: lower_pointer(&f)
        lower_alloc(&m, &f, boxed, lower_option_box_size(p, shape.value))
        lower_list_move(p, &f, boxed, slot, shape.value)
        taken = Val(boxed)
        if !removes {
            if lower_needs_drop(p, m, shape.value) -> lower_glue_clone_fields(p, &m, &f, slot, boxed, [LowerGlueField]{LowerGlueField{offset: 0, ty: shape.value}})
            lower_seal(&f, LIRTerminator.Return{value: taken})
            return lir_builder_finish(f.builder)
        }
    }
    lower_drop_stored(p, &m, &f, entry, shape.key_offset, shape.key)
    length :: lower_list_word(&f, map, 0)
    one :: lower_const(&f, 1)
    last :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: last, op: LIRBinaryOp.Sub, left: length, right: one})
    // Shift the entries after the removed one down by one: a single
    // overlapping byte move of their (last - index) * stride bytes.
    after :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: after, op: LIRBinaryOp.Add, left: index, right: one})
    from :: lower_list_address(&f, data, after, shape.stride)
    tail :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: tail, op: LIRBinaryOp.Sub, left: last, right: index})
    stride :: lower_const(&f, shape.stride)
    bytes :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: bytes, op: LIRBinaryOp.Mul, left: tail, right: stride})
    lower_call_runtime(&m, &f, "jet_rt_mem_move", [LIRValueID]{entry, from, bytes}, None)
    lower_emit(&f, LIRInst.Store{base: map, offset: 0, value: last})
    lower_seal(&f, LIRTerminator.Return{value: taken})
    lir_builder_finish(f.builder)
}
