// Runtime-only literal -> borrowed E4 view. The raw I64 has no String drop
// action: cap=0 does NOT make the 24-byte header safe for string_drop.
use jet_foundation.[
    MIRCallArg, MIRCallee, MIRFunction, MIRInstruction, MIRProgram, MIRStringPart,
    mir_operation_value_uses, mir_terminator_value_uses,
]

struct LowerStaticTextFacts {
    literals: [U64:String]
    elided: [U64:Bool]
}

fn lower_is_static_text_call(m: LowerModule, callee: MIRCallee) -> Bool Never! {
    if callee == .User(function) {
        if m.runtime_intrinsics.get(function.value) == .Val(intrinsic) -> return intrinsic == .StaticText
    }
    false
}

// Elide only a literal whose sole use is this compile-time argument. A shared
// literal keeps its normal constructor/drop; the intrinsic still reads only
// the checked literal bytes, not the materialized runtime String.
fn lower_static_text_facts(m: LowerModule, function: MIRFunction) -> LowerStaticTextFacts Never! {
    literals := [U64:String]{}
    elided := [U64:Bool]{}
    uses := [U64:Int]{}
    if m.runtime_intrinsics.len() == 0 -> return LowerStaticTextFacts{literals: literals, elided: elided}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Call(callee, args, _) {
                if lower_is_static_text_call(m, callee) && args.len() == 1 -> &elided.add(args[0].value.value, false).drop("records literal argument")
            }
        }
    }
    if elided.len() == 0 -> return LowerStaticTextFacts{literals: literals, elided: elided}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) && elided.get(result.value) != None {
                if instruction.operation == .Constant(constant) {
                    if constant == .String(text) -> &literals.add(result.value, text).drop("unique checked literal result")
                }
                // Codegen lowers every checked string literal as BuildString
                // (Rust tir_to_mir StrLit); one with only literal parts is
                // the same compile-time text as a folded Constant.
                if instruction.operation == .BuildString(parts) {
                    if lower_static_text_literal_parts(parts) == .Val(text) -> &literals.add(result.value, text).drop("unique checked literal result")
                }
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                if elided.get(value.value) != None -> &uses.add(value.value, (uses.get(value.value) ?? 0) + 1).drop("per-function value uses")
            }
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            if elided.get(value.value) != None -> &uses.add(value.value, (uses.get(value.value) ?? 0) + 1).drop("per-function terminator uses")
        }
    }
    loop (value, _) in literals {
        if (uses.get(value) ?? 0) == 1 -> &elided.add(value, true).drop("sole use is StaticText argument")
    }
    LowerStaticTextFacts{literals: literals, elided: elided}
}

// The text of a BuildString whose every part is a literal, or None when a
// part interpolates a runtime value.
fn lower_static_text_literal_parts(parts: [MIRStringPart]) -> String? Never! {
    text := ""
    loop part in parts {
        if part.kind == {
            .Literal(piece) -> text = "{text}{piece}"
            .Interpolation(_, _) -> return None
        }
    }
    Val(text)
}

fn lower_static_text_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, args: [MIRCallArg]) Never! {
    if args.len() != 1 -> return lower_fail(&m, &f, "rt_static_text requires one String literal")
    text :: c.static_text.literals.get(args[0].value.value) ?? return lower_fail(&m, &f, "rt_static_text requires a literal String argument; dynamic text has no static lifetime")
    pointer :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: pointer, data: lower_immortal_text(&m, text)})
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_word(&f)
    lower_emit(&f, LIRInst.Bitcast{dst: dst, src: pointer})
}

// The process-lifetime String header of `text`: [data, byte length, cap 0]
// in rodata over the literal bytes, which Text.jet rt_text_immortal
// recognizes (cap 0 over data other than the empty sentinel). Every owner
// shares it: jet_rt_string_clone returns it and jet_rt_string_drop ignores
// it, so a literal String is one address, never an allocation, and a frozen
// static's String member is a relocation to it. One header per text in the
// module (`static_rows`); a thread's part merges by the same key.
fn lower_immortal_text(m: &LowerModule, text: String) -> LIRDataID Never! {
    key :: "text literal:{text}"
    if m.static_rows.get(key) == .Val(index) -> return LIRDataID{value: index}
    start :: lower_marks(m)
    data :: lower_data(&m, text)
    header :: lower_static_object(&m, 24)
    lower_static_store(&m, header, 0, lower_static_pointer(data))
    lower_static_store(&m, header, 8, lower_static_word(text.bytes().len()))
    // lower_static_object already zeros cap@16; neither object needs a fixup.
    lower_extent_record(&m, true, key, header.value, 0, start)
    lower_keyed_record(&m, LOWER_KEYED_STATIC, header.value, key, U64{0})
    &m.static_rows.add(key, header.value).drop("checked absent above")
    header
}
