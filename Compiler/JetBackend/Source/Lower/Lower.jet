// MIR -> LIR lowering for the Jet-native backend (O0).
//
// One checked MIR program becomes one LIR module. Every value gets its machine
// layout and drop action from its checked type and MIR ownership; root local
// places become SSA values threaded through block parameters; MIR phis become
// block parameters; structs and tuples are inline aggregates in storage of
// their holder (Values.jet); payload enums, Options and Results become heap
// boxes owned by compiled code, with generated drop glue; and everything the
// runtime owns (exact-integer overflow into big integers, strings, printing,
// loop cursors, panics) is a call into the compiled runtime by symbol. The
// mapping is documented in Docs/research/jet-backend-design-2026-10-01.md,
// "MIR -> LIR lowering". A program the lowering cannot express yet yields
// issues naming the function and the construct, never partial machine code.
//
// Every helper takes the program `p` and the function's read-only facts `c`
// by read access, and the module and function state `m` and `f` by write
// access; a value read out of `m` or `f` that outlives a call writing them is
// copied first.
use jet_foundation.[
    MIRBasicBlock,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryOverflow,
    MIRBlockID,
    MIRCallArg,
    MIRCallee,
    MIRConstant,
    MIRDropKind,
    MIRField,
    MIRFieldID,
    MIRFunction,
    MIRFunctionID,
    MIRFunctionKind,
    MIRInstruction,
    MIRReflectField,
    MIRLayout,
    MIROperation,
    MIROutputCheck,
    MIROwnership,
    MIRNominalRef,
    MIROwnershipMode,
    MIRPanicLoc,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPollKind,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRProgram,
    MIRScopeID,
    MIRTestScopeMember,
    MIRSemanticOp,
    MIRSharedLifetime,
    MIRSize,
    MIRStringPart,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRTypeKind,
    MIRUnaryOp,
    MIRValueID,
    MIRVariant,
    MIRVariantPayload,
    CompilerThreads,
    compiler_take_rows,
    compiler_threads_failure_text,
    compiler_threads_single,
    core_source_owns_type,
    mir_operation_can_stop,
    mir_operation_consumption_route,
    mir_operation_stop_operand,
    mir_operation_stop_place,
    mir_operation_value_consumption,
    mir_operation_value_uses,
    mir_value_consumption_transfers,
    mir_symbol_name,
    mir_nominal_ref,
    mir_terminator_targets,
    mir_terminator_value_uses,
    mir_type_canonical_key,
    mir_type_display_name,
    mir_type_from_kind,
    MIRAccess,
    MIRScope,
    MIRSourceFileID,
    MIRTerminator,
    mir_call_arg_consumes,
    mir_operation_place_uses,
    mir_runtime_owned_ownership,
    mir_type_identity_key,
    type_name,
    core_identity_in_module,
]
use core.math as math

struct LIRLoweringIssue {
    function: String
    message: String
}

struct LIRSharedSiteExport {
    initializer: MIRFunctionID
    site_key: String
    function: LIRFunctionID
    symbol: String
    lifetime: MIRSharedLifetime
    ty: MIRType
}

// Semantic keys identify checked types; function IDs remain image-local.
struct LIRCoreCallableExport {
    semantic_identity: String
    role: String
    type_key: String
    function: LIRFunctionID
}

// `lir` is complete only when `issues` is empty. The lowering does not lint
// the module: the one LIR lint runs on the final LIR inside the x64 compile
// (x64_compile_module, x64_compile_module_owned; SPEED-500K D6). `entry` is
// the LIR function of the entry the program was lowered from (None with
// issues).
// `finalizer` is a compiler callable's zero-argument Unit static release,
// run before its image is unmapped, after all native result owners retire.
struct LIRLowering {
    lir: LIRModule
    issues: [LIRLoweringIssue]
    entry: LIRFunctionID?
    // Every requested callable's concrete native entry; empty on any issue.
    callables: [U64:LIRFunctionID]
    finalizer: LIRFunctionID?
    // Typed compiler boundaries write canonical storage supplied by the child.
    // The matching release borrows that storage and drops its initialized value.
    value_callables: [U64:LIRFunctionID]{[U64:LIRFunctionID]{}}
    value_releases: [U64:LIRFunctionID]{[U64:LIRFunctionID]{}}
    closures: [LIRClosureValueLayout]{[LIRClosureValueLayout]{}}
    shared_sites: [LIRSharedSiteExport]{[LIRSharedSiteExport]{}}
    core_callables: [LIRCoreCallableExport]{[LIRCoreCallableExport]{}}
    native_exports: [String:LIRFunctionID]{[String:LIRFunctionID]{}}
}

// How one checked MIR type is carried in LIR.
enum LowerRepr {
    // Unit and Never: no LIR value.
    Absent
    // Exact Int is an inline number or a tagged, reference-counted BigInt.
    ExactInt
    // Char and fixed-width integers are dropless machine words.
    Word
    // Float: the IEEE double's bits in one word (LIR Float layout).
    FloatBits
    // F32: four stored bytes, raw binary32 bits in the low 32 of a word
    // register. Numeric operations bitcast to the single-precision LIR
    // layout and back, preserving the reader/runtime word carrier ABI.
    Float32Bits
    // Bool: one byte holding 0 or 1.
    Flag
    // A runtime-owned object (String, loop cursor): a pointer the runtime
    // releases with `drop` and duplicates with `clone`.
    Handle(drop: String, clone: String)
    // Payload enum, Option or Result: a heap box owned by compiled code and
    // released by generated drop glue.
    Boxed(ty: MIRType)
    // Struct or tuple: a pointer to storage holding the stored fields at
    // natural offsets (Values.jet). The value never frees the storage; drop
    // and clone glue are called explicitly where MIR drops or copies it.
    Inline(ty: MIRType)
    // An enum whose variants carry no payload: its discriminant word.
    Discriminant
    Unsupported(reason: String)
}

// Generated glue for one box type; `id` is its LIR function. Drop glue takes
// the box and frees it; clone glue (`clone`) takes a borrowed box and returns
// a new box owning copies of its contents. A named helper (`helper` non-empty,
// see "Generated helpers") is a module-generated function for `ty`; a
// closure helper (Closures.jet) is one for lowered function row `function`
// (-1 for every other glue).
struct LowerGlue {
    key: String
    ty: MIRType
    id: LIRFunctionID
    clone: Bool
    helper: String
    function: Int
}

// A root place (local, parameter, temporary or capture) carried as an SSA
// value, or kept in a memory cell.
struct LowerSlot {
    base: MIRPlaceBase
    ty: MIRType
    ownership: MIROwnership
    // False for Unit locals, which carry no LIR value, and for cells.
    carried: Bool
    // For a Write parameter's place, the MIR parameter index whose incoming
    // pointer names the caller's storage; -1 otherwise. The slot still carries
    // the current value; every root write also stores through the pointer.
    write_param: Int
    // A place a closure captures by reference, or a captured place inside a
    // closure body: every read and write goes through its memory cell
    // (LowerFunction.cells, Closures.jet).
    cell: Bool
}

// These operations are enabled only for checked IDs selected by RuntimeLibrary.
// They are not MIR operators, language intrinsics, or assembly bindings.
enum LowerRuntimeIntrinsic {
    FloatBits
    FloatFromBits
    FunctionAddress(function: MIRFunctionID)
    StaticText
}

struct LowerModule {
    signatures: [LIRSignature]
    checked_types: LowerTypeIndex
    test_harness: Bool
    test_rows: [Int]
    test_indices: [U64:Int]
    test_serial: Bool
    test_checks: [MIROutputCheck]
    // Empty for ordinary program and callback lowering.
    runtime_intrinsics: [U64:LowerRuntimeIntrinsic]{[U64:LowerRuntimeIntrinsic]{}}
    native_pack: Bool
    native_exports: [String:LIRFunctionID]
    // Signature shape key -> its id (lower_signature_key).
    signature_rows: [String:Int]
    data: [LIRData]
    // Interned text -> its data id, and first program row per MIR function
    // id, so interning and call lowering probe a map instead of scanning.
    data_rows: [String:Int]
    // MIRConstantDef key -> root LIRData of its frozen static tree (Statics.jet).
    static_rows: [String:Int]
    shared_sites_dynamic: Bool
    shared_sites: [LIRSharedSiteExport]
    // String slots of frozen statics the entry fills first (lower_static_entry).
    static_fixups: [LowerStaticFixup]
    // Callable initialization and finalization share this filled-statics flag.
    static_live: LIRDataID?
    // MIR source file id -> its row in `line_starts`, the byte offsets of the
    // file's line starts (Numeric.jet lower_source_line).
    line_rows: [U64:Int]{[U64:Int]{}}
    line_starts: [[Int]]{[[Int]]{}}
    // Type identity key (or checked identity, `*_ids`) -> whether the type
    // reaches a Close owner (PartialDrop.jet lower_type_contains_close) and
    // whether it reaches a member no owner can copy
    // (lower_type_contains_uncopyable), once per module.
    contains_close: [String:Bool]{[String:Bool]{}}
    contains_close_ids: [U64:Bool]{[U64:Bool]{}}
    contains_uncopyable: [String:Bool]{[String:Bool]{}}
    contains_uncopyable_ids: [U64:Bool]{[U64:Bool]{}}
    // The type cache (lower_repr_of), lent to the function being lowered:
    // one row, or none while a function holds it.
    types: [LowerTypeCache]{[LowerTypeCache]{LowerTypeCache{reprs: [String:LowerRepr]{}, sizes: [String:LowerSize]{}, members: [String:[LowerMember]]{}, drops: [String:Bool]{}}}}
    // lower_repr_key -> one lazy descriptor level's type facts (LazyIter.jet
    // lower_lazy_meta_facts), once per module.
    lazy_meta_facts: [String:LowerLazyMetaFacts]{[String:LowerLazyMetaFacts]{}}
    // p.impls rows a Display / Printable render may select, and the first
    // p.functions row per function id (Display.jet lower_render_rows,
    // lower_render_function_rows), once per module on the first render.
    render_rows: [[Int]]{[[Int]]{}}
    function_rows: [U64:Int]{[U64:Int]{}}
    // "k:<key>" / "n:<name>" -> the first p.constants row with that key or
    // name (Constants.jet lower_global_definition), once per module.
    global_rows: [String:Int]{[String:Int]{}}
    // MIR source file id -> its row in program.source_files.
    source_rows: [U64:Int]
    // Shared stop classification indexes checked Prelude effects once.
    prelude_positions: [U64:Int]
    // Trait rows and impls by trait (Traits.jet lower_trait_index), once per lowering.
    traits: LowerTraitIndex
    // Checked foreign ID -> its #FFI(asm) function, and -> its program.foreign row.
    asm_foreign: [U64:MIRFunctionID]
    foreign_rows: [U64:Int]
    // Concrete MIR function ID -> its LIR function row (Mono.jet's inventory
    // order), and per row the program.functions row of its original.
    mir_rows: [U64:Int]
    mir_sources: [Int]
    mir_signatures: [LIRSignatureID]
    // Per LIR function row: the bytes of the inline aggregate it returns
    // through a hidden result pointer (its first parameter), or 0.
    mir_results: [Int]
    // A compiler callable (lir_lower_callables) spends comptime fuel and
    // depth through the runtime's budget hooks (lower_comptime_site); program
    // entries, tests, C exports and the runtime library never do.
    comptime_budget: Bool
    // Jet-compiled code (programs, tests, callables, Core shared and native C
    // callables) enters the memory sentries around its #Unsafe/#Policy
    // regions, gates and raw stack addresses (Pointers.jet). The runtime
    // library never does: it implements those hooks, and Rust's runtime is
    // plain Rust with no sentry instrumentation of itself.
    sentry: Bool{true}
    glue_base: Int
    glue: [LowerGlue]
    close_methods: [U64:[LowerCloseImpl]]
    // Glue/helper key (lower_glue_row_key) -> its row in `glue`.
    glue_rows: [String:Int]
    issues: [LIRLoweringIssue]
    // Debug.jet interns canonical source files and types for LIRModuleDebug.
    debug_files: [String]
    debug_file_rows: [U64:Int]
    debug_types: [LIRDebugType]
    debug_type_rows: [String:Int]
    // Unified host/stop contract (#4720): the reachable MIR carries stop
    // points (only native host compilations produce them). Its generated
    // glue then shields user callbacks, its OCB1 callback adapters leave a
    // stopped callback's result unwritten, and its program entry returns
    // without reading a stopped result.
    stop_points: Bool
    task_stop_points: Bool
    // Parallel lowering (Workers.jet): set in each thread's copy of the
    // module, which then records every keyed registration (its registry, row
    // and key: lower_keyed_record), the extent of every keyed registration
    // that creates other rows, every constant carrying a function ID, and the
    // native export symbols it registers, in order, so the merge can drop,
    // renumber and replay them.
    parted: Bool{false}
    keyed_rows: [LowerKeyedRow]{[LowerKeyedRow]{}}
    // The glue waves lowered on this module so far (lower_workers_glue): a
    // thread module syncs to the merged module once per wave.
    glue_waves: Int{0}
    extents: [LowerExtent]{[LowerExtent]{}}
    function_keys: [LowerFunctionKey]{[LowerFunctionKey]{}}
    export_rows: [String]{[String]{}}
}

// Read-only facts about the MIR function being lowered.
struct LowerContext {
    mir: MIRFunction
    result: LowerRepr
    fact_index: [U64:Int]
    static_text: LowerStaticTextFacts
    block_index: [U64:Int]
    // Per MIR block position: the position an edge into it enters, past any
    // empty jump-only blocks (lower_forward_blocks); its own when it is lowered.
    forward: [Int]
    slots: [LowerSlot]
    place_slots: [U64:Int]
    // MIR place id -> its first row in `mir.places` (lower_place_rows).
    place_rows: [U64:Int]
    // MIR local id -> its root slot (require diagnostics read current local storage).
    local_slots: [U64:Int]
    // MIR value read or moved out of a root place -> its slot.
    read_slots: [U64:Int]
    // MIR value a parameter or temporary place stands for -> its slot.
    defined_slots: [U64:Int]
    // MIR values written into a place, stored into a new aggregate (List,
    // Map, struct, tuple, variant, Option/Result box, closure capture, trait
    // box) or returned: an owned place read that lands there is a copy of its
    // own (MIRRust.rs place_read clones).
    sunk: [U64:Bool]
    // MIR value a `Move` defines -> the value it moves.
    moves: [U64:U64]
    // Field/OptionValue/ResultValue/EnumPayload results MIRRust.rs moves out
    // of their carrier rather than cloning (lower_payload_takes).
    payload_takes: [U64:Bool]
    // Local and local field-path MovePlace results only variant tests and
    // payload reads use (lower_inspect_carriers): the moved subject of a
    // match whose local's drop flag (or owner's field) the move cleared. The
    // release plan frees it (or what a payload take leaves of it) on every
    // path.
    inspect_carriers: [U64:Bool]
    // Collections a read loop's cursor takes instead of snapshotting
    // (lower_iter_takes): an owned List or Map read only by its LoopIterInit.
    iter_takes: [U64:Bool]
    // Compile-time exact Int value (constant or its negation) -> its
    // sized-literal word, emitting no code (Convert.jet lower_fixed_literals).
    fixed_literals: [U64:Int]
    order: [Int]
    lir_blocks: [LIRBlockID]
    split_entry: Bool
    // Per MIR block position: its rank in `order` (-1 when unreachable). An
    // edge to a block of lower or equal rank is a loop's back edge.
    ranks: [Int]
    // Per MIR block position: the carried slots live on entry, ascending
    // (Liveness.jet); its LIR params and every edge into it carry these.
    live: [[Int]]
    // Per back edge: the inline aggregate slots the loop rebinds, which the
    // edge copies into their frame storage (LoopCopies.jet).
    loop_copies: LowerLoopCopies
    // Results nothing reads: no operand, terminator, place base or index,
    // or bound local names them (lower_dead_values). Rust drops such a
    // temporary at the end of its statement; natively a dead owned read is
    // not materialized and a dead owned producer result is released at once
    // (lower_release_plan).
    dead: [U64:Bool]
    // Owned temporaries' releases and the writes that release the value they
    // overwrite (lower_release_plan).
    releases: LowerReleasePlan
}

// A real cleanup entry, not a Shield or an inferred task/root role. The saved
// flags are opaque; zero is valid and leave always restores the exact token.
struct LowerStopCleanupScope {
    saved_flags: LIRValueID
}

// The function being built.
struct LowerFunction {
    name: String
    builder: LIRFunctionBuilder
    // MIR value -> LIR value index; MIR values carried by no LIR value are in `absent`.
    values: [U64:Int]
    absent: [U64:Bool]
    params: [LIRValueID?]
    current: [LIRValueID?]
    mir_block: MIRBlockID
    cleanup_scopes: [U64:LowerStopCleanupScope]
    open: LIRBlockID
    open_params: [LIRValueID]
    failed: Bool
    // The hidden result pointer when the function returns an inline aggregate.
    result_storage: LIRValueID?
    // Per slot: the frame storage a back edge copies an inline aggregate
    // slot's value into, so a carried value is never a temporary that the
    // next loop iteration overwrites. MIR phi value -> its frame storage, likewise.
    storage: [LIRValueID?]
    phi_storage: [U64:Int]
    // The null placeholders slots hold while unassigned, moved out or dropped
    // (lower_clear_slot): one `const 0` per layout, made in the entry block,
    // and the set of their LIR value indexes, so a release or a back-edge
    // copy of a slot known to hold one emits nothing.
    placeholder_layouts: [LIRLayout]
    placeholder_values: [LIRValueID]
    placeholders: [Int:Bool]
    // A closure body's box parameter (Closures.jet).
    env: LIRValueID?
    // Per slot: the debug variable its lowered values carry, or -1.
    debug_slots: [Int]
    // Per slot: the memory cell of a cell slot (LowerSlot.cell), else None.
    cells: [LIRValueID?]
    // Caller-owned saves for sentry scopes and the function's unsafe gate.
    sentry_scopes: [U64:Int]
    sentry_function: LIRValueID?
    // A separate allocation lifetime token, not an unsafe-gate save.
    sentry_stack_frame: LIRValueID?
    // Context deadlines use independent 16-byte caller-owned save slots.
    deadline_scopes: [U64:Int]
    // A consuming Close receiver owns structural cleanup by storage identity.
    closing: MIRType?
    close_parameter: MIRValueID?
    close_identity: LIRValueID?
    partial_drops: [LowerPartialDrop]
    // Release candidates whose definition made a fresh LIR owner in the block
    // the definition ended in (lower_mark_releasable): only these are released.
    releasable: [U64:Bool]
    // LIR values of `releasable` temporaries, and those the lowering itself
    // moved, reowned, dropped or passed to a block parameter while lowering an
    // instruction (lower_emit, lower_seal): those are never released again.
    releasable_lir: [Int:Bool]
    consumed: [Int:Bool]
    // Whether lower_emit and lower_seal record consumption: off while lowering
    // terminators (an edge's own arguments) and the releases themselves.
    track_consumes: Bool
    // The module's type cache while this function is lowered (lower_lend_types).
    types: [LowerTypeCache]
}

// Lowers the functions `entry` reaches (Mono.jet: generic functions and
// methods of generic types once per concrete instance) plus their glue.
fn lir_lower_entry(program: MIRProgram, entry: MIRFunctionID) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    lower_selected(program, [MIRFunctionID]{entry}, true, true, program.native_pack, [String]{}, false, None, [MIROutputCheck]{}, ^intrinsics, false, false, true)
}

// lir_lower_entry over the caller's program in place: the type index is
// attached to `program` for the lowering and detached after, so the native
// route never copies the whole program (it is left exactly as it came). The
// function bodies lower on the threads `threads` admits (Workers.jet).
fn lir_lower_entry_in_place(program: &MIRProgram, entry: MIRFunctionID, threads: CompilerThreads) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    native_pack :: program.native_pack
    lower_selected_in_place(&program, [MIRFunctionID]{entry}, true, true, native_pack, [String]{}, false, None, [MIROutputCheck]{}, ^intrinsics, false, false, true, threads)
}

// JET_KEEP_GOING (the bootstrap native feed): lir_lower_entry_in_place,
// except that a function whose lowering stops is one issue and a trap of its
// signature (lower_keep_going_functions), and the issues leave the entry and
// the module in place, so every later phase still runs and reports. The
// module is never shipped: the caller turns every issue into a census row.
fn lir_lower_entry_keep_going_in_place(program: &MIRProgram, entry: MIRFunctionID, threads: CompilerThreads) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    native_pack :: program.native_pack
    lower_selected_in_place(&program, [MIRFunctionID]{entry}, true, true, native_pack, [String]{}, false, None, [MIROutputCheck]{}, ^intrinsics, true, false, true, threads)
}

// Compiler and test callbacks retain return carriers; only program entries
// consume Option/Result success and turn failure into a process exit.
fn lir_lower_callables(program: MIRProgram, roots: [MIRFunctionID]) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    lower_selected(program, roots, false, true, program.native_pack, [String]{}, false, None, [MIROutputCheck]{}, ^intrinsics, false, true, true)
}

// RuntimeLibrary validates each exact function ID and its signature. Every
// root is a C export, so narrow integer arguments enter through
// `export.entry` (Callable.jet).
// No ordinary program/callback lowering enables runtime-only substitution.
// The runtime library has no sentry instrumentation of its own (`sentry`).
fn lir_lower_runtime_callables(program: MIRProgram, roots: [MIRFunctionID], intrinsics: ^[U64:LowerRuntimeIntrinsic]) -> LIRLowering Never! {
    lower_selected(program, roots, false, true, program.native_pack, [String]{}, true, None, [MIROutputCheck]{}, ^intrinsics, false, false, false)
}

fn lir_lower_core_shared(program: MIRProgram, roots: [MIRFunctionID]) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    lower_selected(program, roots, false, false, program.native_pack, [String]{}, false, None, [MIROutputCheck]{}, ^intrinsics, false, false, true)
}

// Explicit imports are the actual external C consumer closure.
fn lir_lower_native_callables(program: MIRProgram, roots: [MIRFunctionID]) -> LIRLowering Never! {
    lir_lower_native_imports(program, roots, [String]{})
}

fn lir_lower_native_imports(program: MIRProgram, roots: [MIRFunctionID], imports: [String]) -> LIRLowering Never! {
    intrinsics :: [U64:LowerRuntimeIntrinsic]{}
    lower_selected(program, roots, false, true, true, imports, true, None, [MIROutputCheck]{}, ^intrinsics, false, false, true)
}

// `comptime_budget`: only a compiler callable (lir_lower_callables, run by the
// comptime image) spends comptime fuel and depth through the runtime's
// jet_rt_comptime_enter/step/leave hooks. Program entries, test harnesses, C
// exports and the runtime library never do: the runtime library implements
// those hooks, so a hook in it recurses into itself.
// `sentry`: Jet-compiled code enters the memory sentries around its unsafe
// regions (as Rust's emitted code does); the runtime library implements the
// sentry hooks and is never instrumented, else jet_rt_sentry_scope_enter ->
// sentry_save -> thread_base (#Unsafe) re-enters itself.
fn lower_selected(program: MIRProgram, roots: [MIRFunctionID], wrap_entry: Bool, shared_sites_dynamic: Bool, native_pack: Bool, imports: [String], c_exports: Bool, test_serial: Bool?, checks: [MIROutputCheck], runtime_intrinsics: ^[U64:LowerRuntimeIntrinsic], keep_going: Bool, comptime_budget: Bool, sentry: Bool) -> LIRLowering Never! {
    // copy: lowering edits its program in place (the type index is attached, keep-going traps
    // rewrite rows), while these read-parameter entry points leave the caller's MIR intact. Callers
    // that hand theirs over use the *_in_place entry points.
    lowered_program := program.copy()
    lower_selected_in_place(&lowered_program, roots, wrap_entry, shared_sites_dynamic, native_pack, imports, c_exports, test_serial, checks, ^runtime_intrinsics, keep_going, comptime_budget, sentry, compiler_threads_single())
}

// lower_selected over `program` in place: every type lookup of the lowering
// (preparation, bodies, glue, helpers and entry wrappers) resolves through
// the type index attached to `program` (lower_attach_type_index; the index
// answers exactly what a scan of `types` answers, lower_type_row), and the
// caller gets the program back unchanged. The function bodies lower on the
// threads `threads` admits for their size (lower_workers_lower); the result
// is the same for any thread count.
fn lower_selected_in_place(program: &MIRProgram, roots: [MIRFunctionID], wrap_entry: Bool, shared_sites_dynamic: Bool, native_pack: Bool, imports: [String], c_exports: Bool, test_serial: Bool?, checks: [MIROutputCheck], runtime_intrinsics: ^[U64:LowerRuntimeIntrinsic], keep_going: Bool, comptime_budget: Bool, sentry: Bool, threads: CompilerThreads) -> LIRLowering Never! {
    test_indices := [U64:Int]{}
    test_issues := [LIRLoweringIssue]{}
    if test_serial != None {
        loop (index, test) in program.tests -> &test_indices.add(test.function.value, index).drop("checked test functions are unique")
        loop root in roots {
            index :: test_indices.get(root.value) ?? {
                &test_issues.push(LIRLoweringIssue{function: "native test entry", message: "requested callable {root.value} has no checked test identity"})
                next
            }
            test :: program.tests[index]
            if test.kind != .Unit {
                &test_issues.push(LIRLoweringIssue{function: test.name, message: "native property-test generation and shrinking are not implemented in Jet"})
            } else if test.parameters.len() != 0 || test.eligibility != None {
                &test_issues.push(LIRLoweringIssue{function: test.name, message: "native unit-test callbacks must be parameterless and have no generated eligibility predicate"})
            }
        }
    }
    all_roots := roots.copy()
    loop check in checks -> &all_roots.push(check.function)
    // `fn test(t: Test)` configures the suite before the stock harness runs it.
    if test_serial != None {
        if lower_test_override(program) == .Val(override) -> &all_roots.push(override)
    }
    // Preparation, body, glue and entry lowering resolve type definitions
    // through the type index, attached to the program itself instead of to
    // a copy of it (lower_type_row: the index answers exactly what a scan of
    // `types` answers); the caller's own index rows come back at the end.
    caller_id_rows :: program.type_id_rows.copy()
    caller_key_rows :: program.type_key_rows.copy()
    caller_trait_rows :: program.trait_name_rows.copy()
    lower_attach_type_index(&program)
    prepared := lower_prepare_roots(program, all_roots, shared_sites_dynamic, native_pack, imports, ^runtime_intrinsics)
    loop issue in test_issues -> &prepared.issues.push(issue)
    test_harness := false
    loop artifact in program.artifacts {
        if artifact.kind == .TestExecutable || artifact.kind == .TestOverride -> test_harness = true
    }
    stop_points :: lower_has_stop_points(program, prepared.functions)
    task_stop_points :: lower_task_stop_program(program, prepared.functions)
    m := LowerModule{
        signatures: [LIRSignature]{},
        test_harness: test_harness,
        test_rows: [Int]{},
        test_indices: ^test_indices,
        test_serial: test_serial ?? false,
        test_checks: checks,
        runtime_intrinsics: ^prepared.runtime_intrinsics,
        native_pack: native_pack,
        // lower_selected_in_place is the sole origin of both mode fields.
        native_exports: [String:LIRFunctionID]{},
        signature_rows: [String:Int]{},
        data: [LIRData]{},
        data_rows: [String:Int]{},
        static_rows: [String:Int]{},
        shared_sites_dynamic: shared_sites_dynamic,
        shared_sites: [LIRSharedSiteExport]{},
        static_fixups: [LowerStaticFixup]{},
        static_live: None,
        source_rows: [U64:Int]{},
        prelude_positions: lower_prelude_positions(program),
        traits: ^prepared.traits,
        asm_foreign: ^prepared.asm_foreign,
        foreign_rows: ^prepared.foreign_rows,
        mir_rows: [U64:Int]{},
        checked_types: ^prepared.checked_types,
        close_methods: ^prepared.close_methods,
        mir_sources: [Int]{},
        comptime_budget: comptime_budget,
        sentry: sentry,
        mir_signatures: [LIRSignatureID]{},
        mir_results: [Int]{},
        glue_base: prepared.functions.len(),
        glue: [LowerGlue]{},
        glue_rows: [String:Int]{},
        issues: prepared.issues.copy(),
        debug_files: [String]{},
        debug_file_rows: [U64:Int]{},
        debug_types: [LIRDebugType]{},
        debug_type_rows: [String:Int]{},
        stop_points: stop_points,
        task_stop_points: task_stop_points,
    }
    assert(program.native_pack == m.native_pack)
    loop (index, file) in program.source_files {
        if m.source_rows.get(file.id.value) == None -> &m.source_rows.add(file.id.value, index).drop("checked absent above")
    }
    // Every signature is registered before any body is lowered: calls name them.
    loop (index, descriptor) in prepared.functions {
        &m.mir_rows.add(descriptor.id.value, index).drop("concrete IDs are unique")
        &m.mir_sources.push(descriptor.source_row)
        signature :: if descriptor.instance_row >= 0 -> lower_function_signature(program, &m, prepared.instances[descriptor.instance_row]) else -> lower_function_signature(program, &m, program.functions[descriptor.source_row])
        &m.mir_signatures.push(signature)
    }
    functions := [LIRFunction]{}
    failed_functions := prepared.failed_functions.copy()
    // Keep-going: the indexed program copy the body tasks hand back, which
    // the glue tasks then read (lower_keep_going_glue).
    glue_programs := [MIRProgram]{}
    weights :: lower_workers_weights(program, prepared.functions, prepared.instances)
    workers :: lower_workers_admit(threads, weights)
    if workers > 1 {
        // copy: the threads read an indexed program of their own, handed back for the keep-going
        // glue tasks, while `program` (write-borrowed) still feeds the glue phase and the caller.
        // Its rows are shared buffers, not copies of the whole program.
        parted := lower_workers_lower(program.copy(), ^m, ^prepared.functions, ^prepared.instances, ^failed_functions, weights, workers, keep_going) ?? panic("the native lowering threads failed")
        prepared.functions = ^parted.inventory
        prepared.instances = ^parted.instances
        m = ^parted.state
        failed_functions = ^parted.failed
        functions = ^parted.functions
        if keep_going -> glue_programs = ^parted.programs
    } else if keep_going {
        // copy: keep-going lowering hands an indexed program to its body tasks, which return it for
        // the glue tasks, while `program` (write-borrowed) still feeds the in-place path and the
        // caller.
        kept := lower_keep_going_lower(program.copy(), ^m, ^prepared.functions, ^prepared.instances, ^failed_functions) ?? panic("the keep-going native lowering tasks failed")
        prepared.functions = ^kept.inventory
        prepared.instances = ^kept.instances
        m = ^kept.state
        failed_functions = ^kept.failed
        functions = ^kept.functions
        glue_programs = ^kept.programs
    } else {
        loop (index, descriptor) in prepared.functions {
            function :: lower_selected_function(program, &m, descriptor, prepared.instances, index, &failed_functions)
            &functions.push(function)
        }
    }
    // Glue, helpers and entry wrappers resolve types through the same index.
    glue_inputs :: shared LowerGlueInputs{programs: ^glue_programs}
    // Parted glue (lower_glue_waves): from here the module logs the keys it
    // registers, so the glue phase's thread modules (`glue_slots`, one per
    // thread for the whole phase) can adopt them between waves instead of
    // copying the module per wave.
    glue_slots := [Shared<LowerWorker>]{}
    if workers > 1 && !keep_going {
        m.parted = true
        glue_slots = lower_glue_slots(workers)
    }
    if !shared_sites_dynamic {
        loop definition in program.constants {
            if definition.value == .SharedSite(site) {
                if lower_function_index(m, site.initializer) >= 0 {
                    _ := lower_helper_id(&m, definition.key, definition.ty)
                }
            }
        }
    }
    // Program entries normalize failure carriers. Compiler calls retain the
    // checked signature, including any hidden output pointers.
    lowered_entry := LIRFunctionID?{None}
    finalizer := LIRFunctionID?{None}
    value_callables := [U64:LIRFunctionID]{}
    value_releases := [U64:LIRFunctionID]{}
    if shared_sites_dynamic && !wrap_entry && m.static_fixups.len() > 0 -> m.static_live = Val(lower_static_object(&m, 8))
    callables := [U64:LIRFunctionID]{}
    loop root in roots {
        if callables.get(root.value) != None -> next
        // An absent concrete root already has a preparation diagnostic.
        concrete :: prepared.roots.get(root.value) ?? next
        if failed_functions.get(concrete.value) != None && !keep_going -> next
        row :: m.mir_rows.get(concrete.value) ?? {
            &m.issues.push(LIRLoweringIssue{function: "entry preparation", message: "requested concrete root {concrete.value} is absent from the lowered inventory"})
            next
        }
        // Both pinned Core and dynamic callables validate their concrete roots.
        // Only the dynamic mode registers callable/value/release wrappers.
        if !shared_sites_dynamic -> next
        if test_serial != None -> &m.test_rows.push(row)
        lowered := if wrap_entry -> lower_entry_id(program, &m, row) else -> LIRFunctionID{value: row}
        if !wrap_entry && m.static_fixups.len() > 0 {
            source :: lower_row_source(program, m, row)
            lowered = lower_closure_helper_id(&m, "callable.init", row, source)
            if finalizer == None -> finalizer = Val(lower_closure_helper_id(&m, "callable.fini", row, source))
        }
        &callables.add(root.value, lowered).drop("duplicate roots share the concrete callable")
        if !wrap_entry {
            source :: if prepared.functions[row].instance_row >= 0 -> prepared.instances[prepared.functions[row].instance_row] else -> program.functions[prepared.functions[row].source_row]
            &value_callables.add(root.value, lower_closure_helper_id(&m, "callable.value", row, source)).drop("requested roots are unique")
            &value_releases.add(root.value, lower_closure_helper_id(&m, "callable.release", row, source)).drop("requested roots are unique")
        }
        if c_exports {
            source :: lower_row_source(program, m, row)
            if lower_has_narrow_params(source) -> lowered = lower_closure_helper_id(&m, "export.entry", row, source)
        }
        if lowered_entry == None -> lowered_entry = Val(lowered)
    }
    if test_serial != None -> lowered_entry = Val(lower_helper_id(&m, "test.main", lower_test_unit_type()))
    // Concrete trait keys are registered while lowering MIR bodies. Helpers
    // only refer to those keys. Drain ordinary glue before emitting each
    // deferred dispatcher once, including newly registered nested helpers.
    if native_pack {
        loop symbol in imports -> lower_native_glue_import(program, &m, "external C consumer", symbol)
        loop function in functions -> lower_native_glue_rewrite(program, &m, function)
    }
    // Glue and helpers may register more, so the list grows while it is
    // walked: on the threads in waves when the bodies were parted
    // (lower_glue_waves), else row by row here.
    cursor := 0
    dispatchers := [Int]{}
    glue_functions := [LIRFunction?]{}
    emitted := 0
    inventory :: lower_trait_key_count(m)
    loop {
        if workers > 1 && !keep_going {
            waved := lower_glue_waves(program, ^m, cursor, workers, native_pack, glue_slots, &dispatchers, &glue_functions)
            m = ^waved.state
            cursor = waved.cursor
        }
        loop cursor < m.glue.len() {
            // copy: the glue row is read while lowering it pushes more glue and signatures into `m`
            // (`&m`). A view into m.glue would dangle when that list grows.
            glue :: m.glue[cursor].copy()
            if lower_trait_dispatcher(program, glue) {
                &dispatchers.push(cursor)
                &glue_functions.push(None)
            } else if keep_going {
                outcome := lower_keep_going_glue(glue_inputs, ^m, glue, functions, glue_functions) ?? panic("the keep-going native glue task failed")
                m = ^outcome.state
                &glue_functions.push(Val(^outcome.function))
            } else {
                &glue_functions.push(Val(lower_checked_glue_function(program, &m, glue)))
            }
            if native_pack {
                if glue_functions[cursor] == .Val(function) -> lower_native_glue_rewrite(program, &m, function)
            }
            cursor += 1
        }
        if emitted == dispatchers.len() -> break
        // copy: the dispatcher glue row is read while lowering it pushes into `m` (`&m`). A view
        // into m.glue would dangle when that list grows.
        glue :: m.glue[dispatchers[emitted]].copy()
        function := LIRFunction?{None}
        if keep_going {
            outcome := lower_keep_going_glue(glue_inputs, ^m, glue, functions, glue_functions) ?? panic("the keep-going native glue task failed")
            m = ^outcome.state
            function = Val(^outcome.function)
        } else {
            function = Val(lower_checked_glue_function(program, &m, glue))
        }
        if native_pack {
            if function == .Val(emitted_function) -> lower_native_glue_rewrite(program, &m, emitted_function)
        }
        glue_functions[dispatchers[emitted]] = ^function
        emitted += 1
    }
    if inventory != lower_trait_key_count(m) -> &m.issues.push(LIRLoweringIssue{function: "trait dispatch", message: "trait key inventory grew after dispatch emission"})
    // Registration assigns glue_base+row, so emission order must not change
    // the function table's positional ID contract.
    loop function in glue_functions -> &functions.push(function ?? panic("deferred trait dispatcher was not emitted"))
    if functions.len() != m.glue_base + m.glue.len() -> panic("native glue function count does not match its registered rows")
    loop (index, function) in functions {
        if function.id.value != index -> panic("native function ID does not match its table index")
    }
    if !shared_sites_dynamic {
        // Getters are published only after the host runs this noarg Unit
        // startup. Emit it last so helper bodies have discovered every fixup.
        startup :: lower_helper_id(&m, "core.shared.init", mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}}))
        // copy: the startup glue row is read while lowering it pushes into `m` (`&m`). A view into
        // m.glue would dangle when that list grows.
        startup_glue :: m.glue[startup.value - m.glue_base].copy()
        if keep_going {
            outcome := lower_keep_going_glue(glue_inputs, ^m, startup_glue, functions, glue_functions) ?? panic("the keep-going native glue task failed")
            m = ^outcome.state
            &functions.push(^outcome.function)
        } else {
            &functions.push(lower_checked_glue_function(program, &m, startup_glue))
        }
        lowered_entry = Val(startup)
    }
    closures :: if !wrap_entry && m.issues.len() == 0 -> lower_closure_value_layouts(program, prepared.functions, prepared.instances, m) else -> [LIRClosureValueLayout]{}
    core_callables := [LIRCoreCallableExport]{}
    if !shared_sites_dynamic {
        loop glue in m.glue {
            if glue.helper != "lazy.clone" && glue.helper != "lazy.drop" -> next
            key :: lower_mono_fingerprint(glue.ty)
            &core_callables.push(LIRCoreCallableExport{semantic_identity: "{glue.helper}:{key}", role: glue.helper, type_key: key, function: glue.id})
        }
        loop closure in closures {
            key :: "closure:{closure.function.value}"
            &core_callables.push(LIRCoreCallableExport{semantic_identity: "closure.code:{key}", role: "closure.code", type_key: key, function: closure.code})
            if closure.release == .Val(release) {
                &core_callables.push(LIRCoreCallableExport{semantic_identity: "closure.release:{key}", role: "closure.release", type_key: key, function: release})
            }
        }
    }
    // The caller gets its program back as it came.
    lower_restore_type_index(&program, caller_id_rows, caller_key_rows, caller_trait_rows)
    // The module's registries move into the result: nothing reads `m`'s
    // signatures, data, debug tables or issues after this.
    lowered :: LIRModule{signatures: ^m.signatures, functions: functions, data: ^m.data, debug: LIRModuleDebug{directory: "", files: ^m.debug_files, types: ^m.debug_types}}
    issues := ^m.issues
    if issues.len() > 0 && !keep_going {
        lowered_entry = None
        finalizer = None
        callables = [U64:LIRFunctionID]{}
        value_callables = [U64:LIRFunctionID]{}
        value_releases = [U64:LIRFunctionID]{}
        m.native_exports = [String:LIRFunctionID]{}
    }
    LIRLowering{lir: lowered, issues: issues, entry: lowered_entry, finalizer: finalizer, callables: callables, value_callables: value_callables, value_releases: value_releases, closures: if issues.len() == 0 -> closures else -> [LIRClosureValueLayout]{}, shared_sites: m.shared_sites, core_callables: if issues.len() == 0 -> core_callables else -> [LIRCoreCallableExport]{}, native_exports: m.native_exports}
}

// One function row of the inventory: a failed concrete function (or one
// whose body reports an issue) lowers as a trap of its signature.
fn lower_selected_function(program: MIRProgram, m: &LowerModule, descriptor: LowerPreparedFunction, instances: [MIRFunction], index: Int, failed_functions: &[U64:Bool]) -> LIRFunction Never! {
    signature :: m.mir_signatures[index].copy()
    id :: LIRFunctionID{value: index}
    if failed_functions.get(descriptor.id.value) != None -> return lower_failed_function(m, id, descriptor.name, signature)
    before :: m.issues.len()
    lowered :: if descriptor.instance_row >= 0 -> lower_function(program, &m, instances[descriptor.instance_row], id, signature) else -> lower_function(program, &m, program.functions[descriptor.source_row], id, signature)
    if m.issues.len() > before {
        &failed_functions.add(descriptor.id.value, true).drop("a failed body has one inventory slot")
        return lower_failed_function(m, id, descriptor.name, signature)
    }
    lowered
}

// JET_KEEP_GOING: a lowering that stops (a panic) stops only the task that
// runs it, and its join is a TaskFailure. The inventory lowers in a task
// that writes each lowered function, and the position of the next, into
// `state` as it goes; a stopped task leaves `position` at the function it
// was lowering, which becomes one issue and a trap of its signature
// (lower_failed_function), and a new task lowers the rest. The module state
// keeps what the stopped function registered before it stopped (signatures,
// data, glue): those rows are complete, and the trap never names them.
// Without JET_KEEP_GOING lowering never runs here.
struct LowerKeepGoingInputs {
    // The one (indexed) program, moved in and handed back out after.
    programs: [MIRProgram]
    functions: [LowerPreparedFunction]
    instances: [MIRFunction]
}

struct LowerKeepGoingState {
    // The one module state, moved in for the lowering and back out after.
    modules: [LowerModule]
    failed: [U64:Bool]
    functions: [LIRFunction]
    position: Int
}

struct LowerKeepGoingLowered {
    state: LowerModule
    failed: [U64:Bool]
    functions: [LIRFunction]
    // The inventory and instance rows and the program, moved back out of the
    // tasks' inputs.
    inventory: [LowerPreparedFunction]
    instances: [MIRFunction]
    programs: [MIRProgram]
}

// Lowers every inventory function (`functions`, with the instance bodies
// `instances`, both moved in for the lowering and handed back after) against
// `m`; returns the module state, the failed concrete functions and the
// lowered functions in inventory order. The (indexed) program copy moves into
// the tasks' shared inputs and back out (for the glue phase).
fn lower_keep_going_lower(program: ^MIRProgram, m: ^LowerModule, functions: ^[LowerPreparedFunction], instances: ^[MIRFunction], failed: ^[U64:Bool]) -> LowerKeepGoingLowered {
    inputs :: shared LowerKeepGoingInputs{programs: [MIRProgram]{^program}, functions: ^functions, instances: ^instances}
    state :: shared LowerKeepGoingState{modules: [LowerModule]{}, failed: ^failed, functions: [LIRFunction]{}, position: 0}
    lower_keep_going_fill(state, ^m)
    lower_keep_going_functions(inputs, state)
    lowered := lower_keep_going_take(state)
    lower_keep_going_restore(inputs, &lowered)
    lowered
}

fn lower_keep_going_fill(state: Shared<LowerKeepGoingState>, m: ^LowerModule) {
    permit :: state.guard_edit()
    &permit.value.modules.push(^m)
}

fn lower_keep_going_take(state: Shared<LowerKeepGoingState>) -> LowerKeepGoingLowered {
    permit := state.guard_edit()
    taken :: &permit.value.modules.pop() ?? panic("the native lowering module left its keep-going state")
    LowerKeepGoingLowered{state: taken, failed: permit.value.failed.copy(), functions: compiler_take_rows<LIRFunction>(&permit.value.functions), inventory: [LowerPreparedFunction]{}, instances: [MIRFunction]{}, programs: [MIRProgram]{}}
}

fn lower_keep_going_restore(inputs: Shared<LowerKeepGoingInputs>, lowered: &LowerKeepGoingLowered) {
    permit := inputs.guard_edit()
    lowered.inventory = compiler_take_rows<LowerPreparedFunction>(&permit.value.functions)
    lowered.instances = compiler_take_rows<MIRFunction>(&permit.value.instances)
    lowered.programs = compiler_take_rows<MIRProgram>(&permit.value.programs)
}

fn lower_keep_going_functions(inputs: Shared<LowerKeepGoingInputs>, state: Shared<LowerKeepGoingState>) {
    count :: lower_keep_going_count(inputs)
    loop {
        reason :: lower_keep_going_attempt(inputs, state)
        if lower_keep_going_position(state) >= count -> break
        lower_keep_going_trap(inputs, state, reason)
    }
}

fn lower_keep_going_count(inputs: Shared<LowerKeepGoingInputs>) -> Int {
    permit :: inputs.guard_read()
    permit.value.functions.len()
}

fn lower_keep_going_position(state: Shared<LowerKeepGoingState>) -> Int {
    permit :: state.guard_read()
    permit.value.position
}

// One task lowering from the current position to the end; the stop text
// when it stopped, else "".
fn lower_keep_going_attempt(inputs: Shared<LowerKeepGoingInputs>, state: Shared<LowerKeepGoingState>) -> String {
    stopped := ""
    task.group lower_native {
        head :: task lower_keep_going_part(inputs, state)
        stopped = head.join() ?? compiler_threads_failure_text(err)
    }
    stopped
}

fn lower_keep_going_part(inputs: Shared<LowerKeepGoingInputs>, state: Shared<LowerKeepGoingState>) -> String {
    read :: inputs.guard_read()
    permit := state.guard_edit()
    // Passed straight through: a local binding of the guarded program would copy it.
    lower_keep_going_rows(read.value.programs[0], read.value.functions, read.value.instances, &permit.value)
    ""
}

fn lower_keep_going_rows(program: MIRProgram, functions: [LowerPreparedFunction], instances: [MIRFunction], state: &LowerKeepGoingState) Never! {
    loop state.position < functions.len() {
        index :: state.position
        function :: lower_selected_function(program, &state.modules[0], functions[index], instances, index, &state.failed)
        &state.functions.push(function)
        state.position = index + 1
    }
}

fn lower_keep_going_trap(inputs: Shared<LowerKeepGoingInputs>, state: Shared<LowerKeepGoingState>, reason: String) {
    read :: inputs.guard_read()
    permit := state.guard_edit()
    lower_keep_going_trap_row(read.value.functions, &permit.value, reason)
}

// The function at `state.position` stopped: one issue, and its trap.
fn lower_keep_going_trap_row(functions: [LowerPreparedFunction], state: &LowerKeepGoingState, reason: String) Never! {
    index :: state.position
    descriptor :: functions[index]
    if state.failed.get(descriptor.id.value) == None -> &state.failed.add(descriptor.id.value, true).drop("checked absent above")
    &state.modules[0].issues.push(LIRLoweringIssue{function: descriptor.name, message: "keep-going trap: native lowering stopped: {reason}"})
    signature :: state.modules[0].mir_signatures[index].copy()
    trap :: lower_failed_function(state.modules[0], LIRFunctionID{value: index}, descriptor.name, signature)
    &state.functions.push(trap)
    state.position = index + 1
}

// JET_KEEP_GOING for glue and helper generation (after the function
// bodies): each glue function lowers in its own task, against the module
// and the program moved into shared state. A stop there becomes one issue
// and a trap of the glue's call signature, as a stopped function body
// does, so one bad helper no longer ends the whole compile.
struct LowerGlueInputs {
    programs: [MIRProgram]
}

struct LowerGlueState {
    modules: [LowerModule]
    functions: [LIRFunction]
}

struct LowerGlueOutcome {
    state: LowerModule
    function: LIRFunction
}

fn lower_keep_going_glue(inputs: Shared<LowerGlueInputs>, m: ^LowerModule, glue: LowerGlue, lowered: [LIRFunction], glued: [LIRFunction?]) -> LowerGlueOutcome {
    state :: shared LowerGlueState{modules: [LowerModule]{^m}, functions: [LIRFunction]{}}
    stopped := ""
    task.group lower_glue {
        // copy: the spawned task captures its own glue row, while `glue` (a read parameter) is
        // still used by this function after the task group.
        head :: task lower_keep_going_glue_part(inputs, state, glue.copy())
        stopped = head.join() ?? compiler_threads_failure_text(err)
    }
    permit := state.guard_edit()
    taken := &permit.value.modules.pop() ?? panic("the native lowering module left its keep-going glue state")
    lowered_glue := &permit.value.functions.pop()
    if lowered_glue != None {
        function :: lowered_glue ?? panic("checked present above")
        return LowerGlueOutcome{state: ^taken, function: function}
    }
    name :: if glue.helper != "" -> "helper.{glue.helper}.{glue.key}" else -> "glue.{glue.key}"
    &taken.issues.push(LIRLoweringIssue{function: name, message: "keep-going trap: native glue lowering stopped: {stopped}"})
    signature :: lower_glue_trap_signature(&taken, glue.id, lowered, glued)
    trap :: lower_failed_function(taken, glue.id, name, signature)
    LowerGlueOutcome{state: ^taken, function: trap}
}

fn lower_keep_going_glue_part(inputs: Shared<LowerGlueInputs>, state: Shared<LowerGlueState>, glue: LowerGlue) -> String {
    read :: inputs.guard_read()
    permit := state.guard_edit()
    function :: lower_checked_glue_function(read.value.programs[0], &permit.value.modules[0], glue)
    &permit.value.functions.push(function)
    ""
}

// The signature a lowered function calls `id` with (a trapped glue keeps
// its callers' ABI); a no-argument Unit signature when nothing calls it.
fn lower_glue_trap_signature(m: &LowerModule, id: LIRFunctionID, lowered: [LIRFunction], glued: [LIRFunction?]) -> LIRSignatureID Never! {
    loop at in 0..<lowered.len() {
        if lower_call_signature(lowered[at], id) == .Val(signature) -> return signature
    }
    loop at in 0..<glued.len() {
        if glued[at] == .Val(function) {
            if lower_call_signature(function, id) == .Val(signature) -> return signature
        }
    }
    lower_signature(&m, [LIRLayout]{}, None)
}

fn lower_call_signature(function: LIRFunction, id: LIRFunctionID) -> LIRSignatureID? Never! {
    loop block in 0..<function.blocks.len() {
        loop at in 0..<function.blocks[block].insts.len() {
            if function.blocks[block].insts[at] == .Call(_, signature, callee, _) {
                if callee == .Function(target) {
                    if target == id -> return Val(signature)
                }
            }
        }
    }
    None
}

// ---------------------------------------------------------------------------
// Types, layouts and drop actions.

// Attaches the type index to `program` in place (MIRProgram.type_id_rows /
// type_key_rows: the first row of each type id and key), so lower_type_def
// and lower_type_def_by_id find a definition in O(1) instead of scanning
// every declaration. Lowering never edits `types`, so the index stays exact
// while it is attached (lower_selected_in_place).
fn lower_attach_type_index(program: &MIRProgram) Never! {
    id_rows := [U64:Int]{}
    key_rows := [String:Int]{}
    loop (row, definition) in program.types {
        if id_rows.get(definition.id.value) == None -> _ := &id_rows.add(definition.id.value, row)
        if key_rows.get(definition.key) == None -> _ := &key_rows.add(definition.key, row)
    }
    // A source-owned Core nominal is also spelled bare: the compiler-owned
    // Dyn.DateTime payload is `ZonedDateTime` (Rust tir_to_mir_types.rs
    // Dyn payloads, JetCodegen Types.jet), which names the Core declaration
    // CORE_SOURCE_OWNED_TYPES lists. An exact key wins, and a bare name the
    // runtime handle table carries stays that handle.
    bare_rows := [String:Int]{}
    ambiguous := [String:Bool]{}
    loop (row, definition) in program.types {
        if !lower_core_source_bare_name(definition) -> next
        if bare_rows.get(definition.name) == .Val(seen) {
            // Two source-owned declarations sharing a bare name name neither.
            if program.types[seen].key != definition.key && ambiguous.get(definition.name) == None -> _ := &ambiguous.add(definition.name, true)
            next
        }
        _ := &bare_rows.add(definition.name, row)
    }
    loop (row, definition) in program.types {
        first :: bare_rows.get(definition.name) ?? next
        if first != row || ambiguous.get(definition.name) != None -> next
        if key_rows.get(definition.name) == None -> _ := &key_rows.add(definition.name, row)
    }
    // The first row of each trait key or name, as the scan lower_trait_ref
    // made found it: a row is recorded under each of its spellings the first
    // time that spelling is met, so the row under a spelling is the first
    // row whose key or name is that spelling.
    trait_rows := [String:Int]{}
    loop (row, definition) in program.traits {
        if trait_rows.get(definition.key) == None -> _ := &trait_rows.add(definition.key, row)
        if trait_rows.get(definition.name) == None -> _ := &trait_rows.add(definition.name, row)
    }
    program.type_id_rows = ^id_rows
    program.type_key_rows = ^key_rows
    program.trait_name_rows = ^trait_rows
}

// Puts back the index rows `program` carried before lower_attach_type_index.
fn lower_restore_type_index(program: &MIRProgram, id_rows: [U64:Int], key_rows: [String:Int], trait_rows: [String:Int]) Never! {
    program.type_id_rows = id_rows.copy()
    program.type_key_rows = key_rows.copy()
    program.trait_name_rows = trait_rows.copy()
}

// A copy of `program` with its type index attached (lower_attach_type_index).
fn lower_indexed_program(program: MIRProgram) -> MIRProgram Never! {
    indexed := program.copy()
    lower_attach_type_index(&indexed)
    indexed
}

// A source-owned Core declaration (CORE_SOURCE_OWNED_TYPES) whose bare name
// the runtime handle table does not claim: that name may spell it.
fn lower_core_source_bare_name(definition: MIRTypeDef) -> Bool Never! {
    if definition.name == "" || definition.name.contains("::") || definition.name == definition.key -> return false
    if !core_source_owns_type(definition.key) -> return false
    lower_runtime_handle(definition.name) == None
}

// The first row of `types` an Apply's nominal names: by declaration id, by
// key, or by the type's own identity, exactly the first match of a scan.
fn lower_type_row(p: MIRProgram, name: MIRNominalRef, identity: MIRTypeID?) -> Int Never! {
    if p.type_id_rows.len() == 0 {
        loop row in 0..<p.types.len() {
            if p.types[row].id == name.id || p.types[row].key == name.name -> return row
            if identity == .Val(id) {
                if id == p.types[row].id -> return row
            }
        }
        // The bare spelling of a unique source-owned Core declaration, as
        // lower_attach_type_index indexes it.
        bare := -1
        loop row in 0..<p.types.len() {
            if p.types[row].name != name.name || !lower_core_source_bare_name(p.types[row]) -> next
            if bare >= 0 && p.types[bare].key != p.types[row].key -> return -1
            if bare < 0 -> bare = row
        }
        return bare
    }
    best := p.type_id_rows.get(name.id.value) ?? -1
    by_key :: p.type_key_rows.get(name.name) ?? -1
    // The key row joins the first-match choice only when it is an exact key
    // match; a bare-name row (lower_attach_type_index) is the scan's
    // fallback, taken only when no row matches by id, key or identity.
    exact :: by_key >= 0 && p.types[by_key].key == name.name
    if exact && (best < 0 || by_key < best) -> best = by_key
    if identity == .Val(id) {
        by_identity :: p.type_id_rows.get(id.value) ?? -1
        if by_identity >= 0 && (best < 0 || by_identity < best) -> best = by_identity
    }
    if best < 0 && !exact -> best = by_key
    best
}

// The definition of a nominal type, instantiated with its applied arguments
// when the declaration is generic (Mono.jet lower_instantiate_definition).
// Readers that only inspect the declaration take lower_type_def_row and read
// `p.types[row]` in place: this returns an owned copy per lookup.
fn lower_type_def(p: MIRProgram, ty: MIRType) -> MIRTypeDef? {
    if ty.kind == .Union(_) {
        if ty.identity == .Val(identity) -> return lower_type_def_by_id(p, identity)
        return None
    }
    if ty.kind == .Apply(name, args) {
        row :: lower_type_row(p, name, ty.identity)
        if row < 0 -> return None
        // copy: the type definition is returned as an owned MIRTypeDef, while `p` is the caller's
        // MIR program (a read parameter), which keeps its type rows.
        if p.types[row].generic_params.len() == 0 -> return Val(p.types[row].copy())
        if p.types[row].generic_params.len() != args.len() -> return None
        return Val(lower_instantiate_definition(p.types[row], args))
    }
    None
}

// The row of `p.types` that is lower_type_def(p, ty)'s definition itself:
// the declaration an anonymous union's identity names, or the declaration
// an Apply names when it is not generic (a generic one is instantiated per
// use, so it has no row). -1 when lower_type_def(p, ty) is None or an
// instantiation. A reader of the declaration's own fields (its kind, key,
// name, boxed edges) reads `p.types[row]` in place instead of a copy.
fn lower_type_def_row(p: MIRProgram, ty: MIRType) -> Int Never! {
    // An anonymous union is its structural enum declaration (MIRRust.rs
    // structural_type_def_for: the definition named by the type's identity).
    if ty.kind == .Union(_) {
        if ty.identity == .Val(identity) -> return lower_type_row_by_id(p, identity)
        return -1
    }
    if ty.kind == .Apply(name, _) {
        row :: lower_type_row(p, name, ty.identity)
        if row < 0 || p.types[row].generic_params.len() != 0 -> return -1
        return row
    }
    -1
}

// The first row of `p.types` declaring `id`, -1 when none does.
fn lower_type_row_by_id(p: MIRProgram, id: MIRTypeID) -> Int Never! {
    if p.type_id_rows.len() > 0 -> return p.type_id_rows.get(id.value) ?? -1
    loop row in 0..<p.types.len() {
        if p.types[row].id == id -> return row
    }
    -1
}

fn lower_type_def_by_id(p: MIRProgram, id: MIRTypeID) -> MIRTypeDef? {
    row :: lower_type_row_by_id(p, id)
    if row < 0 -> return None
    // copy: the type definition is returned as an owned MIRTypeDef, while `p` is the caller's
    // MIR program (a read parameter), which keeps its type rows.
    Val(p.types[row].copy())
}

// Whether lower_type_def(p, ty) has a definition, without instantiating or
// copying it: an existence test reads one index row.
fn lower_type_def_exists(p: MIRProgram, ty: MIRType) -> Bool Never! {
    if ty.kind == .Union(_) {
        if ty.identity == .Val(identity) {
            if p.type_id_rows.len() > 0 -> return p.type_id_rows.get(identity.value) != None
            loop row in 0..<p.types.len() {
                if p.types[row].id == identity -> return true
            }
        }
        return false
    }
    if ty.kind == .Apply(name, args) {
        row :: lower_type_row(p, name, ty.identity)
        if row < 0 -> return false
        params :: p.types[row].generic_params.len()
        return params == 0 || params == args.len()
    }
    false
}

// The definition a declaration-ID operand (struct, enum, payload owner)
// names, instantiated by the operand's checked type when that type applies
// the declaration.
fn lower_owned_def(p: MIRProgram, id: MIRTypeID, ty: MIRType?) -> MIRTypeDef? {
    if ty == .Val(checked) {
        if checked.kind == .Apply(name, args) {
            if name.id == id && args.len() > 0 -> return lower_type_def(p, checked)
        }
    }
    lower_type_def_by_id(p, id)
}

fn lower_enum_is_tag(variants: [MIRVariant]) -> Bool Never! {
    loop variant in variants {
        if variant.payload != MIRVariantPayload.Unit -> return false
    }
    true
}

// An exact key of `ty` for the module's lower_repr cache: every field of the
// type (kind, nested types, nominal id and name, identity, layout), strings
// length-prefixed so the encoding is a prefix code. None for the kinds it
// does not spell out (functions, traits, measures, tags, quantities); those
// always take lower_repr directly.
fn lower_repr_key(ty: MIRType) -> String? Never! {
    parts := [String]{}
    if !lower_repr_key_into(ty, &parts) -> return None
    Val(parts.join(""))
}

fn lower_repr_key_into(ty: MIRType, parts: &[String]) -> Bool Never! {
    identity :: if ty.identity == .Val(id) -> "i{id.value};" else -> "n;"
    &parts.push(identity)
    &parts.push(lower_repr_key_layout(ty.layout))
    if ty.kind == {
        .Int -> &parts.push("I;")
        .Float -> &parts.push("F;")
        .Bool -> &parts.push("B;")
        .String -> &parts.push("S;")
        .Char -> &parts.push("C;")
        .Float32 -> &parts.push("f;")
        .IntN(signed, bits) -> &parts.push(if signed -> "s{bits};" else -> "u{bits};")
        .List(inner) -> {
            &parts.push("L;")
            return lower_repr_key_into(inner, &parts)
        }
        .Shared(inner) -> {
            &parts.push("H;")
            return lower_repr_key_into(inner, &parts)
        }
        .Option(inner) -> {
            &parts.push("O;")
            return lower_repr_key_into(inner, &parts)
        }
        .Map(key, value) -> {
            &parts.push("M;")
            return lower_repr_key_into(key, &parts) && lower_repr_key_into(value, &parts)
        }
        .Result(ok, err) -> {
            &parts.push("R;")
            return lower_repr_key_into(ok, &parts) && lower_repr_key_into(err, &parts)
        }
        .InlineRange(base, lo, hi) -> {
            &parts.push("G{lo},{hi};")
            return lower_repr_key_into(base, &parts)
        }
        .Apply(name, args) -> {
            &parts.push("A{name.id.value},{name.name.len()}:{name.name}{args.len()};")
            loop arg in args {
                if !lower_repr_key_into(arg, &parts) -> return false
            }
        }
        .Tuple(fields) -> {
            &parts.push("T{fields.len()};")
            loop field in fields {
                &parts.push("{field.name.len()}:{field.name}")
                if !lower_repr_key_into(field.ty, &parts) -> return false
            }
        }
        .Union(members) -> {
            &parts.push("U{members.len()};")
            loop member in members {
                if !lower_repr_key_into(member, &parts) -> return false
            }
        }
        else -> return false
    }
    true
}

fn lower_repr_key_size(size: MIRSize) -> String Never! {
    if size == .Static(bytes) -> return "{bytes},"
    "d,"
}

fn lower_repr_key_scalar(layout: MIRLayout) -> String Never! {
    if layout.abi == .Scalar(kind) {
        if kind == {
            .Int -> return "si"
            .Float -> return "sf"
            .Float32 -> return "sg"
            .Bool -> return "sb"
            .Char -> return "sc"
            .Pointer -> return "sp"
        }
    }
    if layout.abi == {
        .Aggregate -> "a"
        .Sequence -> "q"
        .Function -> "fn"
        .Nominal -> "no"
        .Dynamic -> "dy"
        .Never -> "nv"
        else -> "s?"
    }
}

fn lower_repr_key_layout(layout: MIRLayout) -> String Never! {
    "{lower_repr_key_scalar(layout)},{lower_repr_key_size(layout.size)}{lower_repr_key_size(layout.align)}"
}

// The module's per-type answers, by lower_repr_key: lower_repr, lower_size,
// lower_inline_members and lower_needs_drop. Each is a pure function of the
// program, the module's Close index (fixed when the module is made) and the
// type, so a cached answer is the one it would compute: the cache changes no
// output and is never invalidated. The module holds it (LowerModule.types)
// and lends it to the function being lowered (lower_function), so the value
// helpers that see only the function reach it.
struct LowerTypeCache {
    reprs: [String:LowerRepr]
    sizes: [String:LowerSize]
    members: [String:[LowerMember]]
    drops: [String:Bool]
}

fn lower_type_cache() -> LowerTypeCache Never! {
    LowerTypeCache{reprs: [String:LowerRepr]{}, sizes: [String:LowerSize]{}, members: [String:[LowerMember]]{}, drops: [String:Bool]{}}
}

// Moves the module's type cache into `f` for the length of its lowering.
fn lower_lend_types(m: &LowerModule, f: &LowerFunction) Never! {
    cache := &m.types.pop() ?? lower_type_cache()
    &f.types.push(^cache)
}

// Moves the type cache `f` borrowed back into the module.
fn lower_return_types(m: &LowerModule, f: &LowerFunction) Never! {
    cache := &f.types.pop() ?? return
    if m.types.len() == 0 -> &m.types.push(^cache)
}

// lower_repr through the type cache `f` holds (lower_repr itself when it
// holds none).
fn lower_repr_of(p: MIRProgram, f: &LowerFunction, ty: MIRType) -> LowerRepr Never! {
    if f.types.len() == 0 -> return lower_repr(p, ty)
    // A scalar's repr is read off its kind faster than its key is spelled.
    if ty.kind == .Int | .Float | .Bool | .Char | .String | .Float32 | .IntN(_, _) -> return lower_repr(p, ty)
    key :: lower_repr_key(ty) ?? return lower_repr(p, ty)
    if f.types[0].reprs.get(key) == .Val(known) -> return known
    repr :: lower_repr(p, ty)
    // copy: the computed repr is stored in the function's repr cache and also returned to the
    // caller on the next line.
    &f.types[0].reprs.add(key, repr.copy()).drop("checked absent above")
    repr
}

// lower_size through the type cache `f` holds; nested member types share it.
fn lower_size_of(p: MIRProgram, f: &LowerFunction, ty: MIRType) -> LowerSize Never! {
    if f.types.len() == 0 -> return lower_size(p, ty)
    lower_size_in(p, ty, &f.types[0].sizes)
}

// lower_is_inline through the type cache `f` holds.
fn lower_inline_of(p: MIRProgram, f: &LowerFunction, ty: MIRType) -> Bool Never! {
    lower_repr_of(p, &f, ty) == .Inline(_)
}

// lower_inline_members through the type cache `f` holds.
fn lower_inline_members_of(p: MIRProgram, f: &LowerFunction, ty: MIRType) -> [LowerMember] Never! {
    if f.types.len() == 0 -> return lower_inline_members(p, ty)
    key :: lower_repr_key(ty) ?? return lower_inline_members(p, ty)
    if f.types[0].members.get(key) == .Val(known) -> return known
    members :: lower_inline_members(p, ty)
    &f.types[0].members.add(key, members.copy()).drop("checked absent above")
    members
}

// lower_struct_field through the type cache `f` holds.
fn lower_struct_field_of(p: MIRProgram, f: &LowerFunction, ty: MIRType, field: MIRFieldID) -> LowerFieldInfo? {
    if lower_repr_of(p, &f, ty) == .Inline(aggregate) {
        loop member in lower_inline_members_of(p, &f, aggregate) {
            if member.id == field -> return Val(LowerFieldInfo{offset: member.offset, ty: member.ty, boxed: member.boxed})
        }
    }
    None
}

// lower_needs_drop through the type cache `f` holds.
fn lower_needs_drop_of(p: MIRProgram, m: LowerModule, f: &LowerFunction, ty: MIRType) -> Bool Never! {
    if f.types.len() == 0 -> return lower_needs_drop(p, m, ty)
    key :: lower_repr_key(ty) ?? return lower_needs_drop(p, m, ty)
    if f.types[0].drops.get(key) == .Val(known) -> return known
    needs :: lower_needs_drop(p, m, ty)
    &f.types[0].drops.add(key, needs).drop("checked absent above")
    needs
}

fn lower_repr(p: MIRProgram, ty: MIRType) -> LowerRepr Never! {
    if lower_shared_guard_repr(ty) == .Val(guard) -> return guard
    if lower_atomic_scalar(p, ty) != None -> return LowerRepr.Inline{ty: ty}
    if lower_trait_ref(p, ty) != None -> return LowerRepr.Boxed{ty: ty}
    if ty.kind == {
        .Int -> LowerRepr.ExactInt
        .Char -> LowerRepr.Word
        .Bool -> LowerRepr.Flag
        .Float -> LowerRepr.FloatBits
        .Float32 -> LowerRepr.Float32Bits
        .IntN(_, bits) -> if bits <= 64 -> LowerRepr.Word else if bits == 128 -> LowerRepr.Inline{ty: ty} else -> LowerRepr.Unsupported{reason: "{bits}-bit integers"}
        .String -> LowerRepr.Handle{drop: "jet_rt_string_drop", clone: "jet_rt_string_clone"}
        .Tagged(_, inner) -> lower_repr(p, inner)
        .InlineRange(base, _, _) -> lower_repr(p, base)
        .Quantity(base, _) -> lower_repr(p, base)
        .Option(_) -> LowerRepr.Boxed{ty: ty}
        // `A | B`: a box of its structural enum (one payload per member).
        .Union(_) -> {
            row :: lower_type_def_row(p, ty)
            if row < 0 -> return LowerRepr.Unsupported{reason: "union {mir_type_display_name(ty)} without a definition"}
            if p.types[row].kind == .Enum(_, _) -> LowerRepr.Boxed{ty: ty} else -> LowerRepr.Unsupported{reason: "union {mir_type_display_name(ty)}"}
        }
        .List(elem) -> lower_list_repr(p, ty, elem)
        // `[T#N]` is carried as the List of its N elements (Lists.jet).
        // copy: `elem` is a payload of read parameter `ty`, which keeps the original; field `inner` of the new MIRTypeKind.List owns this one
        .FixedList(elem, _) -> lower_list_repr(p, mir_type_from_kind(MIRTypeKind.List{inner: elem.copy()}), elem)
        .Map(key, value) -> lower_map_repr(p, ty, key, value)
        // Shared<T>: an owned runtime JetShared<NativeValue> handle (Tasks.jet).
        .Shared(_) -> LowerRepr.Handle{drop: "jet_rt_native_shared_drop", clone: "jet_rt_native_shared_clone"}
        .Result(_, _) -> LowerRepr.Boxed{ty: ty}
        .Fn(_) | .SendFn(_, _, _) -> LowerRepr.Boxed{ty: ty}
        .Tuple(_) -> LowerRepr.Inline{ty: ty}
        .Apply(name, args) -> {
            if args.len() == 0 && (name.name == "Unit" || name.name == "Never") -> return LowerRepr.Absent
            if args.len() == 0 && name.name == "RangeCursor" -> return LowerRepr.Handle{drop: "jet_loop_cursor_drop", clone: ""}
            // ScopeGuard: its callback's closure box; the drop glue runs it (Closures.jet).
            if args.len() == 0 && name.name == "ScopeGuard" -> return LowerRepr.Boxed{ty: ty}
            // A #Transact handle is a native box (Transaction.jet), not the runtime's JetTransaction.
            if lower_is_transaction(ty) -> return LowerRepr.Boxed{ty: ty}
            if lower_is_stm(ty) -> return LowerRepr.Handle{drop: "jet_rt_native_stm_rollback", clone: ""}
            if lower_is_condition(ty) && !lower_type_def_exists(p, ty) -> return LowerRepr.Handle{drop: "jet_rt_native_condition_drop", clone: "jet_rt_native_condition_clone"}
            if lower_lazy_element(ty) == .Val(elem) -> return lower_lazy_repr(p, ty, elem)
            if lower_event_repr(p, ty) == .Val(handle) -> return handle
            if lower_task_handle_repr(ty) == .Val(handle) -> return handle
            // Ptr<T>: a raw word address (Pointers.jet).
            if lower_ptr_element(ty) != None -> return LowerRepr.Word
            if lower_is_iter_cursor(ty) -> return LowerRepr.Boxed{ty: ty}
            if lower_string_nominal(ty) -> return LowerRepr.Handle{drop: "jet_rt_string_drop", clone: "jet_rt_string_clone"}
            if lower_view_element(ty) == .Val(elem) -> return lower_list_repr(p, ty, elem)
            if lower_set_element(ty) == .Val(elem) -> return lower_set_repr(p, ty, elem)
            if lower_tally_element(ty) == .Val(elem) -> return lower_map_repr(p, ty, elem, lower_tally_count_type())
            if lower_queue_element(ty) == .Val(elem) -> return lower_queue_repr(p, ty, elem)
            if lower_priority_queue_element(ty) == .Val(elem) -> return lower_priority_queue_repr(p, ty, elem)
            // The checked default Err is the runtime's own JetErr (Err88) in
            // every native lowering (NativeErr.jet), as Rust emits it.
            if lower_default_err_type(p, ty) -> return LowerRepr.Handle{drop: "jet_rt_handle_drop_jet_err", clone: "jet_rt_handle_clone_jet_err"}
            runtime :: lower_runtime_handle_type(p, ty)
            if runtime == None && lower_runtime_missing_application(ty, LOWER_RUNTIME_HANDLES) == .Val(failure) -> return failure
            schema :: lower_record_schema_with_handle(p, ty, runtime)
            if p.native_pack && runtime == .Val(handle) {
                if handle.runtime == "JetErr" && schema != None -> return LowerRepr.Handle{drop: "jet_rt_handle_drop_jet_err", clone: "jet_rt_handle_clone_jet_err"}
            }
            // Compiler-owned process records and the suite snapshot `Test`
            // (JetCodegen Types.jet: bare canonical keys) are the Jet
            // runtime's carriers in every native lowering; their routes and
            // Places.jet fields are handles.
            if runtime == .Val(handle) {
                if lower_native_runtime_carrier(handle, name.name) {
                    clone :: if handle.clone -> "jet_rt_handle_clone_{runtime_abi_atom(handle.runtime)}" else -> ""
                    return LowerRepr.Handle{drop: "jet_rt_handle_drop_{runtime_abi_atom(handle.runtime)}", clone: clone}
                }
            }
            // The canonical runtime name table excludes source-owned Core
            // shapes. Only exact Core paths may override their MIR definition,
            // and a record schema keeps its MIR layout (Records.jet): its
            // fields read natively and it converts only at a route boundary.
            if name.name.starts_with("<corelib>/") && schema == None && !lower_native_declared_shape(p, name.name) {
                if runtime == .Val(handle) {
                    clone :: if handle.clone -> "jet_rt_handle_clone_{runtime_abi_atom(handle.runtime)}" else -> ""
                    return LowerRepr.Handle{drop: "jet_rt_handle_drop_{runtime_abi_atom(handle.runtime)}", clone: clone}
                }
            }
            // The declaration is read in place; only an instantiated
            // (generic) definition is materialized.
            row :: lower_type_def_row(p, ty)
            if row >= 0 -> return lower_repr_declared(p, ty, name, runtime, schema, p.types[row])
            definition :: lower_type_def(p, ty) ?? {
                // A Core type with no Jet definition is the runtime's own
                // value behind an owned handle (RuntimeRoutes.jet).
                handle :: runtime ?? return LowerRepr.Unsupported{reason: "type {name.name} without a definition"}
                clone :: if handle.clone -> "jet_rt_handle_clone_{runtime_abi_atom(handle.runtime)}" else -> ""
                return LowerRepr.Handle{drop: "jet_rt_handle_drop_{runtime_abi_atom(handle.runtime)}", clone: clone}
            }
            lower_repr_declared(p, ty, name, runtime, schema, definition)
        }
        else -> LowerRepr.Unsupported{reason: "type {mir_type_display_name(ty)}"}
    }
}

// lower_repr of an Apply type `ty` naming `name` whose definition is
// `definition` (the declaration itself, or its instantiation): `runtime` and
// `schema` are lower_repr's own lookups for `ty`.
fn lower_repr_declared(p: MIRProgram, ty: MIRType, name: MIRNominalRef, runtime: LowerRuntimeHandle?, schema: LowerRecordSchema?, definition: MIRTypeDef) -> LowerRepr Never! {
    if definition.kind == {
        .Struct(_, _) -> LowerRepr.Inline{ty: ty}
        .Enum(variants, _) -> {
            // A runtime-owned Core enum is not a native enum box,
            // even when its Jet declaration supplies the variants.
            // Only record schemas with explicit ABI adapters retain
            // their native layout at runtime boundaries.
            if definition.key.starts_with("<corelib>/") && schema == None && !lower_native_declared_shape(p, name.name) {
                if runtime == .Val(handle) {
                    clone :: if handle.clone -> "jet_rt_handle_clone_{runtime_abi_atom(handle.runtime)}" else -> ""
                    return LowerRepr.Handle{drop: "jet_rt_handle_drop_{runtime_abi_atom(handle.runtime)}", clone: clone}
                }
            }
            if lower_enum_is_tag(variants) -> LowerRepr.Discriminant else -> LowerRepr.Boxed{ty: ty}
        }
        .Distinct(base, _) -> lower_repr(p, base)
        .Alias(target) -> lower_repr(p, target)
        else -> LowerRepr.Unsupported{reason: "type {name.name}"}
    }
}

// Enum operations require the native discriminant/payload representation.
// Opaque handles may point to a Rust enum or even a zero-sized Box whose
// address is dangling; neither is memory readable using native enum offsets.
fn lower_native_enum_layout(p: MIRProgram, ty: MIRType) -> Bool Never! {
    if lower_repr(p, ty) == {
        .Discriminant | .Boxed(_) -> true
        else -> false
    }
}

fn lower_repr_layout(repr: LowerRepr) -> LIRLayout? {
    if repr == {
        .ExactInt | .Word -> Val(lir_layout_word())
        .Discriminant -> Val(lir_layout_word())
        .Flag -> Val(lir_layout_bool())
        .FloatBits -> Val(lir_layout_float())
        .Float32Bits -> Val(lir_layout_word())
        .Handle(_, _) -> Val(lir_layout_pointer())
        .Boxed(_) | .Inline(_) -> Val(lir_layout_pointer())
        else -> None
    }
}

// An owned runtime handle (its drop/clone are runtime exports).
fn lower_repr_is_handle(repr: LowerRepr) -> Bool Never! {
    if repr == {
        .Handle(_, _) -> true
        else -> false
    }
}

fn lower_is_exact_int(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int -> true
        .Tagged(_, inner) -> lower_is_exact_int(inner)
        .InlineRange(base, _, _) -> lower_is_exact_int(base)
        .Quantity(base, _) -> lower_is_exact_int(base)
        else -> false
    }
}

// U64: the same word as I64, with unsigned order, division, right shift and
// overflow (MIRRust.rs rust_type :5004-5006 keeps IntN signedness).
fn lower_is_unsigned_word(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .IntN(signed, bits) -> !signed && bits == 64
        .Tagged(_, inner) -> lower_is_unsigned_word(inner)
        .InlineRange(base, _, _) -> lower_is_unsigned_word(base)
        .Quantity(base, _) -> lower_is_unsigned_word(base)
        else -> false
    }
}

fn lower_unsigned_condition(condition: LIRCondition) -> LIRCondition Never! {
    if condition == {
        .Lt -> LIRCondition.ULt
        .Le -> LIRCondition.ULe
        .Gt -> LIRCondition.UGt
        .Ge -> LIRCondition.UGe
        else -> condition
    }
}

fn lower_unsigned_overflow_op(op: LIRBinaryOp) -> LIRBinaryOp Never! {
    if op == {
        .Add -> LIRBinaryOp.UAdd
        .Sub -> LIRBinaryOp.USub
        .Mul -> LIRBinaryOp.UMul
        else -> op
    }
}

// Physical ownership is independent of source-language Copy semantics.
fn lower_is_owned(ownership: MIROwnership) -> Bool Never! {
    mir_runtime_owned_ownership(ownership)
}

fn lower_drop(m: &LowerModule, repr: LowerRepr, owned: Bool) -> LIRDrop Never! {
    if !owned -> return LIRDrop.Trivial
    if repr == {
        .ExactInt -> LIRDrop.Runtime{symbol: "jet_rt_int_drop"}
        .Handle(drop, _) -> LIRDrop.Runtime{symbol: drop}
        .Boxed(ty) -> LIRDrop.Function{id: lower_glue_id(&m, ty)}
        else -> LIRDrop.Trivial
    }
}

fn lower_glue_id(m: &LowerModule, ty: MIRType) -> LIRFunctionID Never! {
    lower_glue_entry(&m, ty, false)
}

fn lower_clone_glue_id(m: &LowerModule, ty: MIRType) -> LIRFunctionID Never! {
    lower_glue_entry(&m, ty, true)
}

// One registry row per (role, type key): drop glue "d", clone glue "c", or
// helper "h:<name>" (no role contains "/"); probed through `glue_rows`,
// never by scanning `glue`.
fn lower_glue_row_key(role: String, key: String) -> String Never! {
    "{role}/{key}"
}

fn lower_glue_register(m: &LowerModule, role: String, ty: MIRType, clone: Bool, helper: String) -> LIRFunctionID Never! {
    key :: mir_type_canonical_key(ty)
    // Canonical keys name nominal types by display name; the fingerprint
    // tells two declarations of one name apart.
    row_key :: lower_glue_row_key(role, lower_mono_fingerprint(ty))
    if m.glue_rows.get(row_key) == .Val(row) -> return m.glue[row].id
    row :: m.glue.len()
    id :: LIRFunctionID{value: m.glue_base + row}
    // copy: the glue registry row owns its type, while `ty` is the caller's MIR type (a read
    // parameter), which stays on its MIR node.
    &m.glue.push(LowerGlue{key: key, ty: ty.copy(), id: id, clone: clone, helper: helper, function: -1})
    lower_keyed_record(&m, LOWER_KEYED_GLUE, row, row_key, U64{0})
    &m.glue_rows.add(row_key, row).drop("checked absent above")
    id
}

fn lower_glue_entry(m: &LowerModule, ty: MIRType, clone: Bool) -> LIRFunctionID Never! {
    lower_glue_register(&m, if clone -> "c" else -> "d", ty, clone, "")
}

fn lower_layout_key(layout: LIRLayout) -> String Never! {
    class :: if layout.class == {
        .Integer -> "i"
        .Pointer -> "p"
        .Float -> "f"
        .Memory -> "m"
    }
    "{layout.size}.{layout.align}{class}"
}

// The shape a signature is interned by: parameter layouts, then the result.
fn lower_signature_key(params: [LIRLayout], result: LIRLayout?) -> String Never! {
    parts := [String]{}
    loop layout in params -> &parts.push(lower_layout_key(layout))
    returned :: if result == .Val(layout) -> lower_layout_key(layout) else -> "-"
    "{parts.join(",")}>{returned}"
}

fn lower_signature(m: &LowerModule, params: [LIRLayout], result: LIRLayout?) -> LIRSignatureID Never! {
    key :: lower_signature_key(params, result)
    if m.signature_rows.get(key) == .Val(row) -> return LIRSignatureID{value: row}
    id :: LIRSignatureID{value: m.signatures.len()}
    // copy: the signature row owns its layouts, while `params`/`result` are the caller's layout
    // lists (read parameters), often reused for the call that follows.
    &m.signatures.push(LIRSignature{id: id, convention: LIRCallConv.SystemV, params: params.copy(), result: result.copy()})
    lower_keyed_record(&m, LOWER_KEYED_SIGNATURE, id.value, key, U64{0})
    &m.signature_rows.add(key, id.value).drop("checked absent above")
    id
}

// A Write parameter travels as a pointer to the caller's place (MIRRust.rs
// parameter_type, :5912, emits `&mut T`). An inline aggregate parameter is
// already a pointer to its storage; an inline aggregate result is written
// through a hidden first parameter pointing at the caller's storage. A
// closure body (Closures.jet) takes its closure box before all of these.
fn lower_function_signature(p: MIRProgram, m: &LowerModule, function: MIRFunction) -> LIRSignatureID Never! {
    params := [LIRLayout]{}
    result_bytes :: if lower_is_inline(p, function.return_type) -> lower_size(p, function.return_type).size else -> 0
    &m.mir_results.push(result_bytes)
    if function.capture_params.len() > 0 -> &params.push(lir_layout_pointer())
    if lower_is_inline(p, function.return_type) -> &params.push(lir_layout_pointer())
    loop param in function.params {
        if lower_repr_layout(lower_repr(p, param.ty)) == .Val(layout) -> &params.push(if param.access == .Write -> lir_layout_pointer() else -> layout)
    }
    if lower_is_inline(p, function.return_type) -> return lower_signature(&m, params, None)
    lower_signature(&m, params, lower_repr_layout(lower_repr(p, function.return_type)))
}

fn lower_data(m: &LowerModule, text: String) -> LIRDataID Never! {
    if m.data_rows.get(text) == .Val(index) -> return LIRDataID{value: index}
    bytes := [U8]{}
    loop byte in text.bytes() -> &bytes.push(byte)
    id :: LIRDataID{value: m.data.len()}
    &m.data.push(LIRData{id: id, bytes: bytes, align: 1, relocs: [LIRDataReloc]{}})
    lower_keyed_record(&m, LOWER_KEYED_DATA, id.value, text, U64{0})
    &m.data_rows.add(text.copy(), id.value).drop("checked absent above")
    id
}

// The compiled runtime exports each Prelude route under the last segment of
// its MIR symbol (`jet_std::jet_int_add` -> `jet_int_add`).
fn lower_runtime_symbol(row: MIRPreludeCall) -> String Never! {
    parts :: mir_symbol_name(row.symbol).split("::").to_list()
    parts[parts.len() - 1]
}

// Prelude call ID value -> its first row in `p.prelude_calls`, built once per
// lowering (LowerModule.prelude_positions, LowerPrepared.prelude_positions).
fn lower_prelude_positions(p: MIRProgram) -> [U64:Int] Never! {
    positions := [U64:Int]{}
    loop (index, call) in p.prelude_calls {
        if positions.get(call.id.value) == None -> &positions.add(call.id.value, index).drop("checked absent above")
    }
    positions
}

// The program's Prelude row for `id`: the first row with that ID, found
// through the module's position index (built once per lowering) instead of a
// scan of every Prelude row of the program per lookup.
fn lower_prelude_row(p: MIRProgram, m: LowerModule, id: MIRPreludeCallID) -> MIRPreludeCall? {
    row :: m.prelude_positions.get(id.value) ?? return None
    Val(p.prelude_calls[row])
}

// lower_prelude_row before the module exists: the inventory's own index.
fn lower_prepared_prelude_row(p: MIRProgram, q: LowerPrepared, id: MIRPreludeCallID) -> MIRPreludeCall? {
    row :: q.prelude_positions.get(id.value) ?? return None
    Val(p.prelude_calls[row])
}

// ---------------------------------------------------------------------------
// Function state: issues, values and the open block.

fn lower_fail(m: &LowerModule, f: &LowerFunction, message: String) Never! {
    &m.issues.push(LIRLoweringIssue{function: f.name, message: message})
    f.failed = true
}

fn lower_new_value(f: &LowerFunction, layout: LIRLayout, drop: LIRDrop, jet_type: MIRTypeID?) -> LIRValueID Never! {
    lir_builder_value(&f.builder, layout, drop, jet_type)
}

fn lower_word(f: &LowerFunction) -> LIRValueID Never! {
    lir_builder_word(&f.builder)
}

fn lower_flag(f: &LowerFunction) -> LIRValueID Never! {
    lir_builder_bool(&f.builder)
}

fn lower_pointer(f: &LowerFunction) -> LIRValueID Never! {
    lir_builder_value(&f.builder, lir_layout_pointer(), LIRDrop.Trivial, None)
}

fn lower_emit(f: &LowerFunction, inst: LIRInst) Never! {
    if f.track_consumes && f.releasable_lir.len() > 0 {
        if inst == .Move(_, src) | .Reown(_, src) -> lower_note_consumed(&f, src)
        if inst == .Drop(value) -> lower_note_consumed(&f, value)
    }
    lir_builder_push(&f.builder, inst)
}

fn lower_note_consumed(f: &LowerFunction, value: LIRValueID) Never! {
    if f.releasable_lir.get(value.value) != None -> _ := &f.consumed.add(value.value, true)
}

fn lower_const(f: &LowerFunction, value: Int) -> LIRValueID Never! {
    dst :: lower_word(&f)
    lower_emit(&f, LIRInst.Const{dst: dst, value: value})
    dst
}

fn lower_const_flag(f: &LowerFunction, value: Int) -> LIRValueID Never! {
    dst :: lower_flag(&f)
    lower_emit(&f, LIRInst.Const{dst: dst, value: value})
    dst
}

fn lower_new_block(f: &LowerFunction) -> LIRBlockID Never! {
    lir_builder_block_id(&f.builder)
}

fn lower_seal(f: &LowerFunction, terminator: LIRTerminator) Never! {
    if f.track_consumes && f.releasable_lir.len() > 0 {
        loop target in lir_terminator_targets(terminator) {
            loop arg in target.args -> lower_note_consumed(&f, arg)
        }
    }
    open :: f.open.copy()
    params :: f.open_params.copy()
    lir_builder_seal(&f.builder, open, params, terminator)
}

fn lower_start(f: &LowerFunction, id: LIRBlockID, params: [LIRValueID]) Never! {
    f.open = id
    f.open_params = params.copy()
}

fn lower_target(block: LIRBlockID, args: [LIRValueID]) -> LIRJumpTarget Never! {
    LIRJumpTarget{block: block, args: args.copy()}
}

fn lower_value_type(c: LowerContext, value: MIRValueID) -> MIRType? {
    index :: c.fact_index.get(value.value) ?? return None
    Val(c.mir.values[index].ty)
}

fn lower_operation_can_stop(p: MIRProgram, c: LowerContext, m: LowerModule, operation: MIROperation) -> Bool Never! {
    operand_type := MIRType?{None}
    if mir_operation_stop_operand(operation) == .Val(value) -> operand_type = lower_value_type(c, value)
    accessed_place := MIRPlace?{None}
    if mir_operation_stop_place(operation) == .Val(place) -> accessed_place = lower_place_row(c.mir, c.place_rows, place)
    mir_operation_can_stop(operation, operand_type, accessed_place, p.prelude_calls, m.prelude_positions)
}

fn lower_value_owned(c: LowerContext, value: MIRValueID) -> Bool Never! {
    index :: c.fact_index.get(value.value) ?? return false
    lower_is_owned(c.mir.values[index].ownership)
}

fn lower_set_slot(f: &LowerFunction, slot: Int, value: LIRValueID?) Never! {
    f.current[slot] = value
    if value == .Val(carried) -> lower_debug_bind(&f, slot, carried)
}

fn lower_define(c: LowerContext, f: &LowerFunction, value: MIRValueID, lowered: LIRValueID) Never! {
    if f.partial_drops.len() != 0 && c.moves.get(value.value) == None && c.read_slots.get(value.value) == None {
        lower_partial_reset(&f, lower_partial_owner(c, value), [LowerGlueField]{})
    }
    _ := &f.values.add(value.value, lowered.value)
    slot :: c.defined_slots.get(value.value) ?? return
    lower_set_slot(&f, slot, Val(lowered))
}

fn lower_define_absent(f: &LowerFunction, value: MIRValueID) Never! {
    _ := &f.absent.add(value.value, true)
}

fn lower_is_absent(f: LowerFunction, value: MIRValueID) -> Bool Never! {
    if f.absent.get(value.value) == .Val(_) -> return true
    false
}

// The LIR value carrying `value`; reports and returns None when it has none.
fn lower_use(m: &LowerModule, f: &LowerFunction, value: MIRValueID) -> LIRValueID? {
    if f.values.get(value.value) == .Val(index) -> return Val(LIRValueID{value: index})
    if !lower_is_absent(f, value) -> lower_fail(&m, &f, "MIR value {value.value} is used before it is lowered")
    None
}

fn lower_value_layout(f: LowerFunction, value: LIRValueID) -> LIRLayout Never! {
    f.builder.values[value.value].layout
}

fn lower_value_drop(f: LowerFunction, value: LIRValueID) -> LIRDrop Never! {
    f.builder.values[value.value].drop
}

// The owner `dst` adopts `carried`, a trivial carrier of the same layout, with
// dst's drop glue. A jump argument binds a block parameter of any drop glue
// (lower_exact_arithmetic's merge adopts its words this way); a Move may not
// change drop glue and Reown converts only pointer owners.
fn lower_adopt(f: &LowerFunction, dst: LIRValueID, carried: LIRValueID) Never! {
    adopted :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(adopted, [LIRValueID]{carried})})
    lower_start(&f, adopted, [LIRValueID]{dst})
}

// Ends the LIR ownership of `value` without running its drop glue, after the
// caller has already released its parts by hand (a Close that consumed the
// owner, a partial drop that freed the remaining fields): Rust's
// `mem::forget` of a value whose fields were moved out. The value moves into
// a trivial block parameter of its own layout (lower_adopt); a Reown may only
// produce a new owning pointer, never discard an obligation.
fn lower_forget(f: &LowerFunction, value: LIRValueID, identity: MIRTypeID?) Never! {
    if lower_value_drop(f, value) == .Trivial -> return
    layout :: lower_value_layout(f, value)
    forgotten :: lower_new_value(&f, layout, LIRDrop.Trivial, identity)
    lower_adopt(&f, forgotten, value)
}

fn lower_checked_type(c: LowerContext, instruction: MIRInstruction) -> MIRType? {
    result :: instruction.result ?? return None
    // copy: `ty` is a payload of read parameter `instruction`, which keeps the original; the Val carrier owns this one
    if instruction.ty == .Val(ty) -> return Val(ty.copy())
    lower_value_type(c, result)
}

// A fresh LIR value for the result of `instruction`, typed by its checked type
// and MIR ownership. None when the result is absent (or unsupported, reported).
fn lower_result(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) -> LIRValueID? {
    result :: instruction.result ?? return None
    ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "MIR value {result.value} has no checked type")
        return None
    }
    repr :: lower_repr_of(p, &f, ty)
    if repr == .Absent {
        lower_define_absent(&f, result)
        return None
    }
    if repr == .Unsupported(reason) {
        lower_fail(&m, &f, "{reason} is not lowered at O0 yet")
        return None
    }
    layout :: lower_repr_layout(repr) ?? return None
    drop :: lower_drop(&m, repr, lower_value_owned(c, result))
    dst :: lower_new_value(&f, layout, drop, ty.identity)
    lower_define(c, &f, result, dst)
    Val(dst)
}

// Map the result of `instruction` onto an existing LIR value (moves, borrows,
// transparent conversions).
fn lower_alias(c: LowerContext, f: &LowerFunction, instruction: MIRInstruction, value: LIRValueID) Never! {
    if instruction.result == .Val(result) -> lower_define(c, &f, result, value)
}

fn lower_alias_absent(f: &LowerFunction, instruction: MIRInstruction) Never! {
    if instruction.result == .Val(result) -> lower_define_absent(&f, result)
}

fn lower_call_runtime(m: &LowerModule, f: &LowerFunction, symbol: String, args: [LIRValueID], dst: LIRValueID?) Never! {
    params := [LIRLayout]{}
    loop arg in args -> &params.push(lower_value_layout(f, arg))
    result :: if dst == .Val(value) -> Val(lower_value_layout(f, value)) else -> None
    signature :: lower_signature(&m, params, result)
    // copy: the emitted Call owns its argument list, while `args` is the caller's list (a read
    // parameter; some callers reuse it for a following release).
    lower_emit(&f, LIRInst.Call{dst: dst, signature: signature, callee: LIRCallee.Runtime{symbol: symbol}, args: args.copy()})
}

// A C U32 result defines eax only; LIR narrow integers live in full words.
// Use the checked MIR type, never a symbol-name guess or a new 4B layout.
// lower_narrow_wrap emits a logical zero extension into a distinct SSA value.
fn lower_call_runtime_typed(c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, symbol: String, args: [LIRValueID], dst: LIRValueID?) Never! {
    if dst == .Val(result) {
        if instruction.result == .Val(value) {
            if lower_value_type(c, value) == .Val(ty) {
                if lower_narrow_bits(ty) == 32 && !lower_narrow_signed(ty) {
                    raw :: lower_word(&f)
                    lower_call_runtime(&m, &f, symbol, args, Val(raw))
                    return lower_narrow_wrap(&f, result, raw, false, 32)
                }
            }
        }
    }
    lower_call_runtime(&m, &f, symbol, args, dst)
}

// Comptime budget hook at a MIR source site: `jet_rt_comptime_enter` (one
// call deeper) or `jet_rt_comptime_step` (one unit of fuel). The owner is the
// function's row in the program it was lowered from (`mir_sources` keeps the
// original row for mono clones); glue and helpers never call these hooks.
fn lower_comptime_site(m: &LowerModule, f: &LowerFunction, symbol: String, start: Int, end: Int) Never! {
    if !m.comptime_budget -> return
    function_id := f.builder.id.value
    owner :: lower_const(&f, m.mir_sources[function_id])
    first :: lower_const(&f, start)
    last :: lower_const(&f, end)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{owner, first, last}, None)
}

// Leaves the depth `jet_rt_comptime_enter` entered, at each return.
fn lower_comptime_leave(m: &LowerModule, f: &LowerFunction) Never! {
    if m.comptime_budget -> lower_call_runtime(&m, &f, "jet_rt_comptime_leave", [LIRValueID]{}, None)
}

// A static string's address and byte length, for runtime calls.
fn lower_static_text(m: &LowerModule, f: &LowerFunction, text: String) -> [LIRValueID] Never! {
    address :: lower_pointer(&f)
    data :: lower_data(&m, text)
    lower_emit(&f, LIRInst.DataAddress{dst: address, data: data})
    size :: m.data[data.value].bytes.len().copy()
    length :: lower_const(&f, size)
    [LIRValueID]{address, length}
}

// The path of a MIR source file ("" when the program has no such file).
fn lower_source_path(p: MIRProgram, m: LowerModule, file: MIRSourceFileID) -> String Never! {
    row :: m.source_rows.get(file.value) ?? return ""
    p.source_files[row].path
}

fn lower_location(p: MIRProgram, m: &LowerModule, f: &LowerFunction, location: MIRPanicLoc) -> [LIRValueID] Never! {
    path :: lower_source_path(p, m, location.file)
    args := lower_static_text(&m, &f, path)
    &args.push(lower_const(&f, location.line))
    args
}

// End the open block with a call that does not return.
fn lower_noreturn_call(m: &LowerModule, f: &LowerFunction, symbol: String, args: [LIRValueID]) Never! {
    lower_call_runtime(&m, &f, symbol, args, None)
    lower_seal(&f, LIRTerminator.Unreachable)
}

fn lower_stop_cleanup_enter(m: &LowerModule, f: &LowerFunction) -> LowerStopCleanupScope Never! {
    delivered :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_session_status", [LIRValueID]{}, Val(delivered))
    saved :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_session_cleanup_enter", [LIRValueID]{delivered}, Val(saved))
    LowerStopCleanupScope{saved_flags: saved}
}

fn lower_stop_cleanup_leave(m: &LowerModule, f: &LowerFunction, scope: LowerStopCleanupScope) Never! {
    lower_call_runtime(&m, &f, "jet_rt_session_cleanup_leave", [LIRValueID]{scope.saved_flags}, None)
}

// Branch to a panic when `failed` holds; lowering continues on the other edge.
fn lower_check(m: &LowerModule, f: &LowerFunction, failed: LIRValueID, symbol: String) Never! {
    panic_block :: lower_new_block(&f)
    next_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(panic_block, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, panic_block, [LIRValueID]{})
    lower_noreturn_call(&m, &f, symbol, [LIRValueID]{})
    lower_start(&f, next_block, [LIRValueID]{})
}

// ---------------------------------------------------------------------------
// Functions.

fn lower_new_function(id: LIRFunctionID, name: String, signature: LIRSignatureID, entry: MIRBlockID) -> LowerFunction Never! {
    LowerFunction{
        name: name.copy(),
        builder: lir_builder(id, name, signature),
        values: [U64:Int]{},
        absent: [U64:Bool]{},
        params: [LIRValueID?]{},
        current: [LIRValueID?]{},
        mir_block: entry,
        cleanup_scopes: [U64:LowerStopCleanupScope]{},
        open: LIRBlockID{value: 0},
        open_params: [LIRValueID]{},
        failed: false,
        result_storage: None,
        storage: [LIRValueID?]{},
        phi_storage: [U64:Int]{},
        placeholder_layouts: [LIRLayout]{},
        placeholder_values: [LIRValueID]{},
        placeholders: [Int:Bool]{},
        env: None,
        debug_slots: [Int]{},
        cells: [LIRValueID?]{},
        sentry_scopes: [U64:Int]{},
        sentry_function: None,
        sentry_stack_frame: None,
        deadline_scopes: [U64:Int]{},
        closing: None,
        close_parameter: None,
        close_identity: None,
        partial_drops: [LowerPartialDrop]{},
        releasable: [U64:Bool]{},
        releasable_lir: [Int:Bool]{},
        consumed: [Int:Bool]{},
        track_consumes: true,
        types: [LowerTypeCache]{},
    }
}

// Failed bodies retain their registered ABI and inventory identity. They are
// never callable outputs: lower_selected clears all exports on any issue
// (under JET_KEEP_GOING it keeps them, and the module is never shipped).
fn lower_failed_function(m: LowerModule, id: LIRFunctionID, name: String, signature: LIRSignatureID) -> LIRFunction Never! {
    f := lower_new_function(id, name, signature, MIRBlockID{value: 0})
    params := [LIRValueID]{}
    loop layout in m.signatures[signature.value].params {
        &params.push(lower_new_value(&f, layout, LIRDrop.Trivial, None))
    }
    block :: lower_new_block(&f)
    lower_start(&f, block, params)
    lower_seal(&f, LIRTerminator.Unreachable)
    lir_builder_finish(f.builder)
}

fn lower_checked_glue_function(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    before :: m.issues.len()
    function :: if glue.helper != "" -> lower_helper_function(p, &m, glue) else if glue.clone -> lower_clone_glue_function(p, &m, glue) else -> lower_glue_function(p, &m, glue)
    if m.issues.len() > before -> lower_failed_function(m, function.id, function.name, function.signature) else -> function
}

fn lower_function(p: MIRProgram, m: &LowerModule, function: MIRFunction, id: LIRFunctionID, signature: LIRSignatureID) -> LIRFunction Never! {
    name :: if function.key == "" -> function.name else -> function.key
    f := lower_new_function(id, name, signature, function.entry)
    f.closing = lower_close_receiver(p, m, function)
    if f.closing != None {
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .Parameter(index, _) {
                    if index == 0 -> f.close_parameter = instruction.result
                }
            }
        }
    }
    if m.runtime_intrinsics.get(function.id.value) == .Val(intrinsic) {
        if intrinsic == .StaticText {
            // Valid calls expand at literal callsites; this compile-time-only
            // declaration has no callable body or owned String parameter.
            block :: lower_new_block(&f)
            input :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Trivial, function.params[0].ty.identity)
            lower_start(&f, block, [LIRValueID]{input})
            lower_seal(&f, LIRTerminator.Unreachable)
            return lir_builder_finish(f.builder)
        }
        output_layout :: lower_repr_layout(lower_repr(p, function.return_type)) ?? panic("validated runtime intrinsic result layout")
        output :: lower_new_value(&f, output_layout, LIRDrop.Trivial, function.return_type.identity)
        block :: lower_new_block(&f)
        if intrinsic == {
            .StaticText -> panic("StaticText is handled before callable result allocation")
            .FloatBits | .FloatFromBits -> {
                // SSA Float values preserve all bits; the System V boundary
                // transfers them to/from xmm registers without arithmetic.
                param :: function.params[0]
                input_layout :: lower_repr_layout(lower_repr(p, param.ty)) ?? panic("validated runtime bitcast input layout")
                input :: lower_new_value(&f, input_layout, LIRDrop.Trivial, param.ty.identity)
                lower_start(&f, block, [LIRValueID]{input})
                lower_emit(&f, LIRInst.Bitcast{dst: output, src: input})
            }
            .FunctionAddress(target) -> {
                lower_start(&f, block, [LIRValueID]{})
                row :: m.mir_rows.get(target.value) ?? panic("validated runtime address target is reachable")
                pointer :: lower_pointer(&f)
                lower_emit(&f, LIRInst.FunctionAddress{dst: pointer, function: LIRFunctionID{value: row}})
                lower_emit(&f, LIRInst.Bitcast{dst: output, src: pointer})
            }
        }
        lower_seal(&f, LIRTerminator.Return{value: Val(output)})
        return lir_builder_finish(f.builder)
    }
    if (function.foreign_language ?? "") == "asm" {
        lower_asm_function(p, &m, &f, function)
        return lir_builder_finish(f.builder)
    }
    // Public Unicode casing uses the same pinned full mapping as String's
    // methods, not the bootstrap subset's private map_case implementation.
    lowercase :: name == "<corelib>/core.text::lower"
    uppercase :: name == "<corelib>/core.text::upper"
    if lowercase || uppercase {
        if function.params.len() != 1 || !lower_text_type(function.params[0].ty) || !lower_text_type(function.return_type) {
            lower_fail(&m, &f, "Core text casing has an unsupported checked signature")
            return lir_builder_finish(f.builder)
        }
        param :: function.params[0]
        input :: lower_new_value(&f, lir_layout_pointer(), lower_drop(&m, lower_repr(p, param.ty), lower_is_owned(param.ownership)), param.ty.identity)
        block :: lower_new_block(&f)
        lower_start(&f, block, [LIRValueID]{input})
        output :: lower_pointer(&f)
        lower_call_runtime(&m, &f, if lowercase -> "jet_unicode_lower" else -> "jet_unicode_upper", [LIRValueID]{input}, Val(output))
        if lower_is_owned(param.ownership) -> lower_emit(&f, LIRInst.Drop{value: input})
        lower_seal(&f, LIRTerminator.Return{value: Val(output)})
        return lir_builder_finish(f.builder)
    }
    // The body lowers with the module's type cache lent to it.
    lower_lend_types(&m, &f)
    lower_function_lent(p, &m, &f, function)
    lower_return_types(&m, &f)
    lir_builder_finish(f.builder)
}

fn lower_function_lent(p: MIRProgram, m: &LowerModule, f: &LowerFunction, function: MIRFunction) Never! {
    c :: lower_context(p, &m, &f, function) ?? return
    lower_debug_function(p, c, &m, &f)
    lower_function_body(p, c, &m, &f)
}

// The function's read-only facts: values, blocks, slots, block order and LIR
// block IDs. None (reported) when the function is outside the O0 subset.
fn lower_context(p: MIRProgram, m: &LowerModule, f: &LowerFunction, function: MIRFunction) -> LowerContext? {
    // These Core bodies still disagree with their shared-runtime contracts.
    // Recognize semantic owners, never example names or particular inputs.
    if function.key == "<corelib>/core.compute::ones"
        || function.key == "<corelib>/core.compute::device_auto"
        || function.key == "<corelib>/core.compute::device_vulkan"
        || function.key == "<corelib>/core.compute::profile_show"
        || function.key == "<corelib>/core.compute::matmul"
        || function.key == "<corelib>/core.compute.solve::dense" {
        lower_fail(&m, &f, "Core.compute operation {function.key} lacks native O0 device/numeric parity")
        return None
    }
    if function.key == "<corelib>/core.archive::zip_open"
        || function.key == "<corelib>/core.web.query::invalidate"
        || core_identity_in_module(function.key, "core.testing") {
        lower_fail(&m, &f, "Core operation {function.key} does not have native O0 semantic parity yet")
        return None
    }
    if function.kind == MIRFunctionKind.Foreign {
        lower_fail(&m, &f, "foreign functions are linked, not lowered")
        return None
    }
    result :: lower_repr(p, function.return_type)
    if result == .Unsupported(reason) {
        lower_fail(&m, &f, "return {reason} is not lowered at O0 yet")
        return None
    }
    fact_index := [U64:Int]{}
    loop (index, fact) in function.values -> _ := &fact_index.add(fact.id.value, index)
    block_index := [U64:Int]{}
    loop (index, block) in function.blocks -> _ := &block_index.add(block.id.value, index)
    forward :: lower_forward_blocks(function, block_index, m.comptime_budget)
    declared_entry :: block_index.get(function.entry.value) ?? {
        lower_fail(&m, &f, "entry block b{function.entry.value} is missing")
        return None
    }
    entry :: forward[declared_entry]

    // Root places become slots; projected places name the slot of their root.
    // Roots and locals are found through keyed rows, not by scanning.
    slots := [LowerSlot]{}
    place_slots := [U64:Int]{}
    local_slots := [U64:Int]{}
    defined_slots := [U64:Int]{}
    base_slots := [String:Int]{}
    local_rows := [U64:Int]{}
    loop (index, row) in function.locals -> _ := &local_rows.add(row.id.value, index)
    place_rows := lower_place_rows(function)
    loop place in function.places {
        if place.base == .Static(_) -> next
        slot := -1
        base_key :: if place.base == {
            .Local(local) -> {
                row :: local_rows.get(local.value) ?? {
                    lower_fail(&m, &f, "place {place.id.value} names missing local {local.value}")
                    return None
                }
                if function.locals[row].ssa_value == .Val(value) -> "t{value.value}" else -> "l{local.value}"
            }
            .Parameter(value) -> "p{value.value}"
            .Temporary(value) -> "t{value.value}"
            .Capture(value) -> "c{value.value}"
            else -> ""
        }
        if base_slots.get(base_key) == .Val(existing) -> slot = existing
        if slot < 0 {
            ty := place.ty
            ownership := MIROwnership{mode: MIROwnershipMode.Copy, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
            write_param := -1
            cell := false
            if place.base == {
                .Local(local) -> {
                    row :: local_rows.get(local.value) ?? {
                        lower_fail(&m, &f, "place {place.id.value} names missing local {local.value}")
                        return None
                    }
                    ty = function.locals[row].ty
                    ownership = function.locals[row].ownership
                    if function.locals[row].ssa_value == .Val(value) -> _ := &defined_slots.add(value.value, slots.len())
                    _ := &local_slots.add(local.value, slots.len())
                }
                .Parameter(value) | .Temporary(value) | .Capture(value) -> {
                    index :: fact_index.get(value.value) ?? {
                        lower_fail(&m, &f, "place {place.id.value} names value {value.value} without a fact")
                        return None
                    }
                    ty = function.values[index].ty
                    ownership = function.values[index].ownership
                    _ := &defined_slots.add(value.value, slots.len())
                    if place.base == .Parameter(_) -> write_param = lower_write_param_index(function, value)
                    if place.base == .Capture(_) -> cell = true
                }
                .Static(_) -> {}
            }
            repr :: lower_repr_of(p, &f, ty)
            if repr == .Unsupported(reason) {
                lower_fail(&m, &f, "local of {reason} is not lowered at O0 yet")
                return None
            }
            slot = slots.len()
            &slots.push(LowerSlot{base: place.base, ty: ty, ownership: ownership, carried: !cell && lower_repr_layout(repr) != None, write_param: write_param, cell: cell})
            if base_key != "" -> _ := &base_slots.add(base_key, slot)
        }
        if place.base == {
            .Local(local) -> {
                _ := &local_slots.add(local.value, slot)
                row :: local_rows.get(local.value) ?? {
                    lower_fail(&m, &f, "place {place.id.value} names missing local {local.value}")
                    return None
                }
                if function.locals[row].ssa_value == .Val(value) -> _ := &defined_slots.add(value.value, slot)
            }
            .Temporary(value) -> _ := &defined_slots.add(value.value, slot)
            else -> {}
        }
        _ := &place_slots.add(place.id.value, slot)
    }
    // A parameter's local row names its Parameter place, not a Local one;
    // require diagnostics read it through that place's root slot.
    loop row in function.locals {
        if local_slots.get(row.id.value) == None {
            if place_slots.get(row.place.value) == .Val(slot) -> _ := &local_slots.add(row.id.value, slot)
        }
    }
    // A place a closure captures by reference, or whose raw address is taken
    // (Pointers.jet), makes its root a cell.
    loop block in function.blocks {
        loop instruction in block.instructions {
            addressed := [MIRPlaceID]{}
            if instruction.operation == .Closure(_, captures, _) {
                loop capture in captures {
                    if capture == .Place(place) -> &addressed.push(place)
                }
            }
            if instruction.operation == .RawAddressOf(place) -> &addressed.push(place)
            loop place in addressed {
                if place_slots.get(place.value) == .Val(slot) {
                    if lower_repr_layout(lower_repr(p, slots[slot].ty)) != None {
                        slots[slot].carried = false
                        slots[slot].cell = true
                    }
                }
            }
        }
    }
    read_slots := [U64:Int]{}
    sunk := [U64:Bool]{}
    moves := [U64:U64]{}
    // A Move only variant tests and payload reads use does not land its
    // operand anywhere: a place read under it stays a borrow of the place
    // (no whole-subject clone), and lower_read_member copies or takes only
    // the payload a binding stores.
    inspect_moves :: lower_inspect_moves(function)
    inspect_carriers :: lower_inspect_carriers(function, inspect_moves)
    loop block in function.blocks {
        if block.terminator == .Return(returned) {
            if returned == .Val(value) -> _ := &sunk.add(value.value, true)
        }
        loop instruction in block.instructions {
            if !lower_is_inspect_move(inspect_moves, instruction) {
                loop consumed in lower_consumed_operands(p, m, function, fact_index, instruction.operation) -> _ := &sunk.add(consumed.value, true)
            }
            result_value :: instruction.result ?? next
            if instruction.operation == {
                .ReadPlace(place) | .MovePlace(place) -> {
                    if lower_place_row(function, place_rows, place) == .Val(row) {
                        if row.projections.len() == 0 {
                            if place_slots.get(place.value) == .Val(slot) -> _ := &read_slots.add(result_value.value, slot)
                        }
                    }
                }
                .Move(inner) -> _ := &moves.add(result_value.value, inner.value)
                else -> {}
            }
        }
    }

    // Successors (a block that cannot complete has none; an edge into an
    // empty jump-only block enters where it forwards) and reverse postorder.
    successors := [[Int]]{}
    loop block in function.blocks {
        targets := [Int]{}
        if lower_block_returns(p, m, block) {
            loop target in mir_terminator_targets(block.terminator) {
                position :: block_index.get(target.value) ?? {
                    lower_fail(&m, &f, "block b{block.id.value} jumps to missing block b{target.value}")
                    return None
                }
                &targets.push(forward[position])
            }
        }
        &successors.push(targets)
    }
    order :: lower_reverse_postorder(successors, entry)
    live :: lower_live_slots(function, slots, place_slots, local_slots, defined_slots, sunk, successors, order)

    // LIR block IDs: a separate entry block when the MIR entry is a jump target.
    split_entry := false
    loop position in order {
        if successors[position].contains(entry) -> split_entry = true
    }
    entry_id :: lower_new_block(&f)
    lir_blocks := [LIRBlockID]{}
    ranks := [Int]{}
    loop _ in function.blocks {
        &lir_blocks.push(LIRBlockID{value: -1})
        &ranks.push(-1)
    }
    loop (rank, position) in order {
        lir_blocks[position] = if rank == 0 && !split_entry -> entry_id else -> lower_new_block(&f)
        ranks[position] = rank
    }
    dead :: lower_dead_values(function)
    iter_takes :: lower_iter_takes(function)
    releases :: lower_release_plan(p, m, function, fact_index, dead, sunk, block_index, successors, order, iter_takes, inspect_moves, inspect_carriers, slots, place_slots, live)
    // The slots lower_frame_storage may give frame storage: carried inline
    // aggregates a back edge copies (LoopCopies.jet).
    storage_candidates := [Bool]{}
    loop row in slots -> &storage_candidates.push(row.carried && row.write_param < 0 && lower_inline_of(p, &f, row.ty))
    loop_copies :: lower_loop_copies(function, storage_candidates, place_slots, defined_slots, successors, ranks)
    Val(LowerContext{
        // copy: the lowering context owns its MIR function for the whole body lowering, while
        // `function` is the program's row (a read parameter), which stays in `p` and is read below
        // for the static text facts.
        mir: function.copy(),
        result: result,
        fact_index: fact_index,
        static_text: lower_static_text_facts(m, function),
        block_index: block_index,
        forward: forward,
        slots: slots,
        place_slots: place_slots,
        place_rows: place_rows,
        local_slots: local_slots,
        read_slots: read_slots,
        defined_slots: defined_slots,
        sunk: sunk,
        moves: moves,
        payload_takes: lower_payload_takes(function, block_index),
        inspect_carriers: inspect_carriers,
        iter_takes: iter_takes,
        fixed_literals: lower_fixed_literals(p, m, function),
        order: order,
        lir_blocks: lir_blocks,
        ranks: ranks,
        live: live,
        loop_copies: loop_copies,
        dead: dead,
        releases: releases,
        split_entry: split_entry,
    })
}

// The values `operation` takes over: written or stored into a place or a new
// aggregate, or handed to a consumer that owns them from then on (a consumed
// call or method argument, a phi or carrier transfer, a Drop). An owned read
// landing there is a copy of its own (MIRRust.rs place_read clones). A
// by-value argument a builtin only reads (lower_builtin_reads_operand) is
// not taken over: the caller keeps it and releases it after the call.
fn lower_consumed_operands(p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], operation: MIROperation) -> [MIRValueID] Never! {
    consumed := lower_stored_operands(operation)
    if operation == .WritePlace(_, written) -> &consumed.push(written)
    if operation == .ReplacePlace(_, replaced) -> &consumed.push(replaced)
    loop stored in lower_map_stored_operands(p, m, operation) -> &consumed.push(stored)
    loop stored in lower_lazy_stored_operands(p, m, operation) -> &consumed.push(stored)
    loop stored in lower_task_stored_operands(p, m, operation) -> &consumed.push(stored)
    loop stored in lower_parallel_stored_operands(p, m, operation) -> &consumed.push(stored)
    loop stored in lower_atomic_stored_operands(p, m, operation) -> &consumed.push(stored)
    mask := [Bool]{}
    if mir_operation_consumption_route(operation) == .Val(call) {
        if m.prelude_positions.get(call.value) == .Val(row) -> mask = p.prelude_calls[row].signature.borrow_mask.copy()
    }
    loop used in mir_operation_value_uses(operation) {
        if mir_value_consumption_transfers(mir_operation_value_consumption(operation, used, mask)) && !lower_builtin_reads_operand(p, m, function, fact_index, operation, used) -> &consumed.push(used)
    }
    consumed
}

// Whether a builtin method only reads the argument `value`, which MIR passes
// it by value: any argument of a LOWER_RELEASE_BORROWING_BUILTINS route, or an
// exact Int argument of a LOWER_RELEASE_INT_READING_BUILTINS one. The value
// stays its owner's: a place read passed there borrows the place instead of
// cloning it, and a temporary is released after the call
// (lower_release_semantic_kind).
fn lower_builtin_reads_operand(p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], operation: MIROperation, value: MIRValueID) -> Bool Never! {
    if operation == .Semantic(semantic) {
        if semantic == .BuiltinMethod(call, receiver, _, args, aggregate_fields) {
            if aggregate_fields != None || receiver == value || !args.contains(value) -> return false
            row :: m.prelude_positions.get(call.value) ?? return false
            symbol :: lower_runtime_symbol(p.prelude_calls[row])
            if LOWER_RELEASE_BORROWING_BUILTINS.contains(symbol) -> return true
            fact :: fact_index.get(value.value) ?? return false
            return LOWER_RELEASE_INT_READING_BUILTINS.contains(symbol) && lower_is_exact_int(function.values[fact].ty)
        }
    }
    false
}

// Builtin methods whose exact Int arguments are all positions the lowering
// converts to native words and never drops or stores (Lists.jet
// lower_list_method). Slices read every operand (LOWER_RELEASE_BORROWING_BUILTINS).
LOWER_RELEASE_INT_READING_BUILTINS :: [String]{"jet_list_swap", "jet_list_get_opt"}

// MIR leaves the end of an owned temporary implicit; the Rust emitter drops it
// at the end of its statement, and a Rust assignment drops the value it
// overwrites. The release plan makes both explicit natively.
//
// A temporary is the owned result of an operation that makes a fresh owner
// (lower_release_producer), bound to no local or place. It is released once,
// after its last use, on every path that does not consume it: right after
// its last use in a block it does not outlive, or on an edge out of a block it
// outlives into a block that does not need it (and whose phi does not take
// it). A use whose result may alias the temporary (a borrowed projection or
// copy) extends its life over that result's uses; a use of any other shape,
// or an alias that escapes, keeps the temporary unreleased. Lowering releases
// a candidate only when its definition made a fresh LIR owner in the block
// the definition ends in (lower_mark_releasable), so every release is
// dominated by the definition and never frees a borrow; a value the lowering
// itself moved, reowned, dropped or handed to a block parameter is never
// released again (LowerFunction.consumed).
//
// A copy-value local (an exact Int, lower_release_copy_local) owns its value
// natively, but MIR never drops it: Rust drops a BigInt at the end of its
// scope. Bound to an SSA value, that value is a temporary whose root place
// reads are uses too (a cloning read only reads it, a borrowing one aliases
// it, a move takes it). Kept in a slot, the slot's value is released where
// the slot dies: on each edge out of a block holding it into a block that
// does not need it, and before a return; under the same read rule as an
// overwrite.
//
// A root or projected WritePlace into an owned local releases the value it
// overwrites unless a borrowed read of that local may still be in use: every
// such read and its aliases must be used only later in its own block, and
// not across the write.
struct LowerReleasePlan {
    // Instruction id -> owned temporaries released right after it.
    after: [U64:[MIRValueID]]
    // Edge (source block position * block count + target position) -> owned
    // temporaries released on that edge, before its jump.
    edges: [Int:[MIRValueID]]
    // The temporaries the plan releases.
    candidates: [U64:Bool]
    // Candidates bound to a copy-value local: released although the local's
    // slot names them.
    bound: [U64:Bool]
    // WritePlace instruction ids that release the overwritten value first ->
    // whether only behind a null test (the slot may hold its placeholder).
    write_drops: [U64:Bool]
    // Edge key (as `edges`) -> copy-value local slots whose value dies on it.
    slot_edges: [Int:[Int]]
    // Block position -> copy-value local slots released before its return.
    slot_returns: [Int:[Int]]
    // Candidates made by a root MovePlace: released although the read slot
    // map names their slot, which no longer holds them.
    taken: [U64:Bool]
    // Root reads of an exact Int local that own a copy of the slot's value
    // (lower_release_owning_read; lower_read_owns): released as temporaries
    // although the read slot map names their slot.
    owned_reads: [U64:Bool]
}

// One use of a MIR value: by the instruction at `position`, or by its block's
// terminator (`position` == the block's instruction count).
struct LowerReleaseUse { block: Int, position: Int, kind: Int }

// The use takes the value over.
LOWER_RELEASE_CONSUME :: prep { 0 }
// The use only reads the value; its result owns nothing of it.
LOWER_RELEASE_BORROW :: prep { 1 }
// The use's result may alias the value.
LOWER_RELEASE_ALIAS :: prep { 2 }
// The use's ownership effect is not modelled: the value is never released.
LOWER_RELEASE_KEEP :: prep { 3 }

fn lower_release_plan(p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], dead: [U64:Bool], sunk: [U64:Bool], block_index: [U64:Int], successors: [[Int]], order: [Int], iter_takes: [U64:Bool], inspect_moves: [U64:Bool], inspect_carriers: [U64:Bool], slots: [LowerSlot], place_slots: [U64:Int], live: [[Int]]) -> LowerReleasePlan Never! {
    plan := LowerReleasePlan{after: [U64:[MIRValueID]]{}, edges: [Int:[MIRValueID]]{}, candidates: [U64:Bool]{}, bound: [U64:Bool]{}, write_drops: [U64:Bool]{}, slot_edges: [Int:[Int]]{}, slot_returns: [Int:[Int]]{}, taken: [U64:Bool]{}, owned_reads: [U64:Bool]{}}
    count :: function.blocks.len()
    pinned := [U64:Bool]{}
    // The values a place's projections compute it from (an index, a range,
    // a map key): each instruction naming the place reads them, as an
    // operand of its own (lower_release_projection_operands).
    place_operands := [U64:[MIRValueID]]{}
    loop place in function.places {
        if place.base == .Parameter(value) | .Capture(value) -> _ := &pinned.add(value.value, true)
        operands :: lower_release_projection_operands(place)
        if operands.len() > 0 -> _ := &place_operands.add(place.id.value, operands)
    }
    bound_locals := [U64:Bool]{}
    // Values read through a place of their own (lower_release_slot_places):
    // copy-value locals bound to an SSA value (lower_release_copy_local),
    // local -> value, and temporaries; each such place -> its value.
    copy_locals := [U64:MIRValueID]{}
    slot_values := [U64:Bool]{}
    loop local in function.locals {
        if local.ssa_value == .Val(value) {
            _ := &bound_locals.add(local.id.value, true)
            if {
                lower_release_copy_local(p, local.ownership, local.ty) -> {
                    _ := &copy_locals.add(local.id.value, value)
                    _ := &slot_values.add(value.value, true)
                }
                else -> _ := &pinned.add(value.value, true)
            }
        }
    }
    slot_places := lower_release_slot_places(function, slots, place_slots, copy_locals, &slot_values, &pinned)
    projected_places := [U64:Bool]{}
    loop place in function.places {
        if place.projections.len() > 0 -> _ := &projected_places.add(place.id.value, true)
    }
    reachable := [Bool]{}
    loop _ in function.blocks -> &reachable.push(false)
    loop position in order -> reachable[position] = true
    predecessors := [[Int]]{}
    loop _ in function.blocks -> &predecessors.push([Int]{})
    loop (from, targets) in successors {
        loop target in targets -> &predecessors[target].push(from)
    }
    uses := [U64:[LowerReleaseUse]]{}
    phi_edges := [U64:[Int]]{}
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        loop (position, instruction) in row.instructions {
            if instruction.operation == .Phi(incoming) {
                loop entry in incoming {
                    from :: block_index.get(entry.block.value) ?? next
                    lower_release_add_key(&phi_edges, entry.value, from * count + block)
                }
                next
            }
            // An inspect Move aliases its operand (lower_release_use_kind):
            // the operand's own release follows the tests and payload reads.
            consumed :: if lower_is_inspect_move(inspect_moves, instruction) -> [MIRValueID]{} else -> lower_consumed_operands(p, m, function, fact_index, instruction.operation)
            loop value in lower_operand_values(instruction.operation) {
                kind :: lower_release_use_kind(p, m, function, fact_index, iter_takes, instruction, value, consumed)
                lower_release_add_use(&uses, value, LowerReleaseUse{block: block, position: position, kind: kind})
            }
            if slot_places.len() > 0 || place_operands.len() > 0 {
                loop place in lower_instruction_places(instruction.operation) {
                    operands :: place_operands.get(place.value) ?? [MIRValueID]{}
                    loop operand in operands -> lower_release_add_use(&uses, operand, LowerReleaseUse{block: block, position: position, kind: LOWER_RELEASE_BORROW})
                    value :: slot_places.get(place.value) ?? next
                    projected :: projected_places.get(place.value) != None
                    kind :: lower_release_place_kind(function, fact_index, sunk, instruction, place, projected)
                    lower_release_add_use(&uses, value, LowerReleaseUse{block: block, position: position, kind: kind})
                }
            }
        }
        kind :: lower_release_terminator_kind(row.terminator)
        loop value in mir_terminator_value_uses(row.terminator) {
            lower_release_add_use(&uses, value, LowerReleaseUse{block: block, position: row.instructions.len(), kind: kind})
        }
    }
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        loop (position, instruction) in row.instructions {
            result :: instruction.result ?? next
            carrier :: inspect_carriers.get(result.value) != None
            if (!lower_release_producer(instruction.operation) && !carrier) || pinned.get(result.value) != None -> next
            fact_row :: fact_index.get(result.value) ?? next
            if !lower_is_owned(function.values[fact_row].ownership) -> next
            // An inspect Move forwards its operand (lower_forward), whose own
            // release follows the tests and payload reads: no owner of its own.
            if lower_is_inspect_move(inspect_moves, instruction) -> next
            // A root move owns the value its slot no longer holds
            // (lower_clear_slot). A partial move's field stays with the
            // partial-drop flags of its owner, unless it is an inspect
            // carrier: the move cleared the field, which its owner's drop
            // then skips, and no use takes the value over.
            if instruction.operation == .MovePlace(place) {
                if projected_places.get(place.value) == None {
                    _ := &plan.taken.add(result.value, true)
                } else if !carrier {
                    next
                }
            }
            // A native Err field reads a runtime record (NativeErr.jet); a
            // member of a type with a Close is never released as a copy.
            if instruction.operation == .Field(base, _) {
                base_row :: fact_index.get(base.value) ?? next
                if lower_native_err_type(p, function.values[base_row].ty) -> next
            }
            if lower_release_member_read(instruction.operation) && lower_close_method(p, m.close_methods, function.values[fact_row].ty) != None -> next
            // A view slice points into its base: it owns nothing to release.
            if instruction.operation == .Slice(_, _, _, _, _, _) && lower_view_element(function.values[fact_row].ty) != None -> next
            if dead.get(result.value) != None {
                lower_release_add(&plan.after, instruction.id.value, result)
                _ := &plan.candidates.add(result.value, true)
                next
            }
            effective :: lower_release_effective_uses(function, uses, phi_edges, pinned, result, Val(result)) ?? next
            lower_release_schedule(&plan, function, successors, predecessors, phi_edges.get(result.value) ?? [Int]{}, effective, result, block, position)
            _ := &plan.candidates.add(result.value, true)
            if slot_values.get(result.value) != None -> _ := &plan.bound.add(result.value, true)
        }
    }
    lower_release_write_drops(&plan, p, m, function, fact_index, sunk, uses, phi_edges, pinned, bound_locals, reachable, successors, predecessors, order[0], slots, place_slots, projected_places, live)
    plan
}

// A local whose owned value MIR never drops: Copy-mode (Rust drops it as a
// BigInt at the end of its scope; MIR registers no drop for it) yet owned
// natively, as an exact Int is.
fn lower_release_copy_local(p: MIRProgram, ownership: MIROwnership, ty: MIRType) -> Bool Never! {
    ownership.mode == MIROwnershipMode.Copy && lower_is_owned(ownership) && lower_repr(p, ty) == .ExactInt
}

// The values a place's projections read whenever an instruction lowers the
// place (Places.jet walks them for each naming instruction; an address
// taken of the place is computed once, by the instruction that takes it).
fn lower_release_projection_operands(place: MIRPlace) -> [MIRValueID] Never! {
    operands := [MIRValueID]{}
    loop projection in place.projections {
        if projection == .Index(_, index, _, _, _, _, _) -> &operands.push(index)
        if projection == .Range(range, _, _) -> &operands.push(range)
        if projection == .MapLookup(lookup, _, _) -> &operands.push(lookup)
    }
    operands
}

// The places a value is read through -> that value: the root places of the
// bound copy-value locals, and every place of a temporary (whose value its
// slot names, Lower.jet defined_slots). A local with a projected place, a
// cell (a closure or raw address may read it later) or a stop diagnostic
// reading it keeps its value pinned, as does a temporary in a cell.
fn lower_release_slot_places(function: MIRFunction, slots: [LowerSlot], place_slots: [U64:Int], copy_locals: [U64:MIRValueID], slot_values: &[U64:Bool], pinned: &[U64:Bool]) -> [U64:MIRValueID] Never! {
    places := [U64:MIRValueID]{}
    loop place in function.places {
        temporary :: place.base == .Temporary(_)
        value := MIRValueID{value: U64.MAX}
        if place.base == {
            .Local(local) -> value = copy_locals.get(local.value) ?? next
            .Temporary(read) -> value = read
            else -> next
        }
        slot :: place_slots.get(place.id.value) ?? -1
        if (!temporary && place.projections.len() > 0) || slot < 0 || slots[slot].cell {
            _ := &pinned.add(value.value, true)
            next
        }
        if temporary -> _ := &slot_values.add(value.value, true)
        _ := &places.add(place.id.value, value)
    }
    if copy_locals.len() == 0 -> return places
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Semantic(semantic) {
                if semantic == .RequireStop(_, _, _, _, context, _, _) {
                    loop row in context.locals {
                        if copy_locals.get(row.local.value) == .Val(value) -> _ := &pinned.add(value.value, true)
                    }
                }
            }
        }
    }
    places
}

// How `instruction` uses a value through its place `place` (`projected`
// when the place projects into it): a root move takes it; a read whose owned
// result is stored, returned or consumed clones (Lower.jet lower_read_owns),
// any other read or a read-only address names it or a part of it; a call
// argument passed by the place with Read access borrows it for the call, as
// the same value passed as an operand does (lower_release_result_kind); any
// other place use (a write, a mutable address or argument, a partial move)
// is not modelled.
fn lower_release_place_kind(function: MIRFunction, fact_index: [U64:Int], sunk: [U64:Bool], instruction: MIRInstruction, place: MIRPlaceID, projected: Bool) -> Int Never! {
    if instruction.operation == .MovePlace(_) -> return if projected -> LOWER_RELEASE_KEEP else -> LOWER_RELEASE_CONSUME
    if instruction.operation == .AddressOf(_, access) -> return if access == MIRAccess.Read -> LOWER_RELEASE_ALIAS else -> LOWER_RELEASE_KEEP
    if instruction.operation == .ReadPlace(_) {
        result :: instruction.result ?? return LOWER_RELEASE_BORROW
        row :: fact_index.get(result.value) ?? return LOWER_RELEASE_KEEP
        if sunk.get(result.value) != None && lower_is_owned(function.values[row].ownership) -> return LOWER_RELEASE_BORROW
        return LOWER_RELEASE_ALIAS
    }
    call_args := [MIRCallArg]{}
    if instruction.operation == .Call(_, args, _) | .IndirectCall(_, args, _) -> call_args = args
    if instruction.operation == .CoreCall(_, _, args, _, _, _) -> call_args = args
    named := false
    loop arg in call_args {
        if arg.place != Val(place) -> next
        if arg.access != MIRAccess.Read -> return LOWER_RELEASE_KEEP
        named = true
    }
    if named -> return lower_release_result_kind(function, fact_index, instruction)
    LOWER_RELEASE_KEEP
}

fn lower_release_add(rows: &[U64:[MIRValueID]], at: U64, value: MIRValueID) Never! {
    values := rows.get(at) ?? [MIRValueID]{}
    if values.contains(value) -> return
    &values.push(value)
    _ := &rows.add(at, values)
}

fn lower_release_add_edge(rows: &[Int:[MIRValueID]], key: Int, value: MIRValueID) Never! {
    values := rows.get(key) ?? [MIRValueID]{}
    if values.contains(value) -> return
    &values.push(value)
    _ := &rows.add(key, values)
}

fn lower_release_add_key(rows: &[U64:[Int]], value: MIRValueID, key: Int) Never! {
    keys := rows.get(value.value) ?? [Int]{}
    &keys.push(key)
    _ := &rows.add(value.value, keys)
}

// Records one use per instruction: an operation naming a value twice uses it
// once, with the same kind; named as an operand and through a bound local's
// place with two different kinds, it is not modelled.
fn lower_release_add_use(uses: &[U64:[LowerReleaseUse]], value: MIRValueID, used: LowerReleaseUse) Never! {
    rows := uses.get(value.value) ?? [LowerReleaseUse]{}
    last :: rows.len() - 1
    same :: last >= 0 && rows[last].block == used.block && rows[last].position == used.position
    if same && rows[last].kind == used.kind -> return
    if same -> rows[last] = LowerReleaseUse{block: used.block, position: used.position, kind: LOWER_RELEASE_KEEP} else -> &rows.push(used)
    _ := &uses.add(value.value, rows)
}

// A returned, yielded or break-carried value is taken by the terminator; any
// other terminator operand (a branch condition) is only read.
fn lower_release_terminator_kind(terminator: MIRTerminator) -> Int Never! {
    if terminator == .Return(_) | .Yield(_, _) | .Break(_, _) -> return LOWER_RELEASE_CONSUME
    LOWER_RELEASE_BORROW
}

// Operations whose owned result, when lowered to a fresh LIR value, owns its
// storage outright: a call or builder result, a new aggregate, a constant or
// clone, arithmetic, a String or copied List slice, a loop cursor or range
// value, a phi of owned values, and an owned member or element read (a copy
// of its own, or a take that clears the member in its carrier:
// lower_read_member, lower_index_result). MIR drops an iterator loop's
// cursor where the loop ends, not on an early exit out of its body.
fn lower_release_producer(operation: MIROperation) -> Bool Never! {
    if operation == {
        .Call(_, _, _) | .IndirectCall(_, _, _) | .CoreCall(_, _, _, _, _, _) | .BuildString(_) | .BuildList(_, _) | .BuildMap(_) -> true
        .Struct(_, _) | .Tuple(_, _) | .Enum(_, _, _) | .Present(_) | .ResultOk(_) | .ResultErr(_) | .TraitBox(_, _) | .Closure(_, _, _) -> true
        .Constant(_) | .Global(_) | .Copy(_, _) | .Binary(_, _, _, _, _) | .Unary(_, _) | .Convert(_, _, _, _) | .Range(_, _, _) | .Slice(_, _, _, _, _, _) -> true
        .LoopRangeInit(_, _, _, _, _) | .LoopRangeValue(_, _) | .LoopIterInit(_, _, _, _, _) | .Phi(_) -> true
        .MovePlace(_) | .Move(_) -> true
        .Semantic(semantic) -> lower_release_semantic_producer(semantic)
        else -> lower_release_member_read(operation)
    }
}

// A runtime route's owned result (lower_route_call) is a fresh owner, as is a
// Task join's or a task group's Result box (Tasks.jet lower_task_outcome,
// lower_task_tuple_all).
fn lower_release_semantic_producer(semantic: MIRSemanticOp) -> Bool Never! {
    if semantic == .BuiltinMethod(_, _, _, _, _) | .StaticPreludeCall(_, _, _, _) | .StructLiteral(_, _, _, _) | .HostCall(_, _) | .HandleMethod(_, _, _, _, _) | .TaskGroup(_, _, _) -> return true
    false
}

fn lower_release_member_read(operation: MIROperation) -> Bool Never! {
    if operation == .Field(_, _) | .EnumPayload(_, _, _, _) | .OptionValue(_) | .ResultValue(_, _) | .Index(_, _, _, _, _, _, _) -> return true
    false
}

// Whether a plain read loop's cursor snapshots its collection (Iter.jet
// lower_iter_init clones a List or Map it does not take): the collection is
// then only read, once, by the LoopIterInit.
fn lower_release_iter_snapshots(p: MIRProgram, function: MIRFunction, fact_index: [U64:Int], operation: MIROperation) -> Bool Never! {
    if operation == .LoopIterInit(_, collection, _, by_value, source_kind) {
        if by_value || source_kind != .Plain -> return false
        row :: fact_index.get(collection.value) ?? return false
        ty :: function.values[row].ty
        return lower_lazy_element(ty) == None && lower_range_members(p, ty) == None && lower_sequence_element(ty) != None
    }
    false
}

// How `instruction` uses `value` (LOWER_RELEASE_*); `consumed` is
// lower_consumed_operands of its operation.
fn lower_release_use_kind(p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], iter_takes: [U64:Bool], instruction: MIRInstruction, value: MIRValueID, consumed: [MIRValueID]) -> Int Never! {
    if consumed.contains(value) -> return LOWER_RELEASE_CONSUME
    if instruction.operation == {
        .LoopIterInit(_, collection, _, _, _) -> {
            if collection != value -> return LOWER_RELEASE_BORROW
            if iter_takes.get(value.value) != None -> return LOWER_RELEASE_CONSUME
            if lower_release_iter_snapshots(p, function, fact_index, instruction.operation) -> return LOWER_RELEASE_BORROW
            LOWER_RELEASE_KEEP
        }
        .BuildString(_) | .Binary(_, _, _, _, _) | .Unary(_, _) | .EnumIs(_, _, _) | .OptionIsSome(_) | .ResultIsOk(_) | .Range(_, _, _) -> LOWER_RELEASE_BORROW
        .LoopRangeInit(_, _, _, _, _) | .LoopRangeHasNext(_, _) | .LoopRangeValue(_, _) | .LoopRangeAdvance(_, _) -> LOWER_RELEASE_BORROW
        .LoopIterHasNext(_, _) | .LoopIterValue(_, _) | .LoopIterAdvance(_, _) -> LOWER_RELEASE_BORROW
        .Call(_, _, _) | .IndirectCall(_, _, _) | .CoreCall(_, _, _, _, _, _) | .Convert(_, _, _, _) -> lower_release_result_kind(function, fact_index, instruction)
        // An owned member or element read is a copy of its own, or a take
        // that clears the member in the carrier (lower_read_member,
        // lower_index_result); a borrowed one points into the carrier. A
        // List or Map index only reads its key.
        .Field(_, _) | .EnumPayload(_, _, _, _) | .OptionValue(_) | .ResultValue(_, _) | .ProjectMembers(_, _) -> lower_release_member_kind(p, function, fact_index, instruction)
        .Index(_, base, _, _, _, _, _) -> if base == value -> lower_release_member_kind(p, function, fact_index, instruction) else -> LOWER_RELEASE_BORROW
        // A String or copied List slice copies out of its base; a view
        // points into it (lower_slice). Its bounds are only read.
        .Slice(_, base, _, _, _, _) -> {
            if base != value -> return LOWER_RELEASE_BORROW
            result :: instruction.result ?? return LOWER_RELEASE_BORROW
            row :: fact_index.get(result.value) ?? return LOWER_RELEASE_KEEP
            if lower_view_element(function.values[row].ty) != None -> return LOWER_RELEASE_ALIAS
            LOWER_RELEASE_BORROW
        }
        // lower_copy clones into an owned result, except an inline aggregate
        // no consumer takes, which it aliases.
        .Copy(_, _) -> {
            result :: instruction.result ?? return LOWER_RELEASE_BORROW
            row :: fact_index.get(result.value) ?? return LOWER_RELEASE_KEEP
            if lower_is_owned(function.values[row].ownership) && !lower_is_inline(p, function.values[row].ty) -> return LOWER_RELEASE_BORROW
            LOWER_RELEASE_ALIAS
        }
        // Only an inspect Move reaches here (any other Move consumes its
        // operand): its result names the operand for the tests and payload
        // reads that use it.
        .Move(_) -> LOWER_RELEASE_ALIAS
        // The key is read; the lookup's result is the map place's own row.
        .MapLookup(_, _, _) -> LOWER_RELEASE_BORROW
        .Semantic(semantic) -> lower_release_semantic_kind(p, m, function, fact_index, instruction, value, semantic)
        else -> LOWER_RELEASE_KEEP
    }
}

// An owned member read is a copy or take of its own; a borrowed one points
// into its carrier, unless it is a scalar (a Bool or fixed-width number read
// out of a Result or Option): its bits are copied out, so the carrier dies
// at its own last use (`if fallible() -> ...` reads the Ok Bool, and
// keeping the Result box alive for that alias leaked it on every path).
fn lower_release_member_kind(p: MIRProgram, function: MIRFunction, fact_index: [U64:Int], instruction: MIRInstruction) -> Int Never! {
    result :: instruction.result ?? return LOWER_RELEASE_BORROW
    row :: fact_index.get(result.value) ?? return LOWER_RELEASE_KEEP
    if lower_is_owned(function.values[row].ownership) -> return LOWER_RELEASE_BORROW
    layout :: lower_repr_layout(lower_repr(p, function.values[row].ty)) ?? return LOWER_RELEASE_ALIAS
    if function.values[row].ownership.mode == MIROwnershipMode.Copy && layout.class != .Pointer -> return LOWER_RELEASE_BORROW
    LOWER_RELEASE_ALIAS
}

fn lower_release_semantic_kind(p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], instruction: MIRInstruction, value: MIRValueID, semantic: MIRSemanticOp) -> Int Never! {
    if semantic == .Print(_, _) -> return LOWER_RELEASE_BORROW
    if semantic == .StaticPreludeCall(_, _, _, _) | .HostCall(_, _) -> return lower_release_result_kind(function, fact_index, instruction)
    // A by-value argument the builtin only reads (lower_builtin_reads_operand).
    if lower_builtin_reads_operand(p, m, function, fact_index, instruction.operation, value) -> return lower_release_result_kind(function, fact_index, instruction)
    // `spawn` only reads its group, site and label (Tasks.jet
    // lower_task_spawn: the runtime keeps its own text of the label); the
    // closure it takes over is a consumed operand.
    if semantic == .CoreClosureCall(_, kind, _, _, _, _) {
        if kind == .Spawn -> return lower_release_result_kind(function, fact_index, instruction)
    }
    if semantic == .BuiltinMethod(call, receiver, receiver_place, _, _) {
        // A method on a place (`&rows.push(x)`, `&seen.add(k, v)`) works on
        // the place's value in place for the call: its borrowed receiver (no
        // owner of its own, so never released here) is borrowed for the call
        // like a Read argument, and a later write of the place may release
        // that value (lower_release_write_drops).
        if receiver == value && receiver_place != None && !lower_release_owned_value(function, fact_index, value) -> return lower_release_result_kind(function, fact_index, instruction)
        // A method returning nothing or a scalar (`s.len()`, `t.count(k)`,
        // `bits.has(i)`) cannot hand back a view of its receiver: the receiver
        // is only read for the call (one it takes over is a consumed operand,
        // checked first), so a read of a Set, Tally, Queue or Bits local for
        // `len` no longer pins the local against every write drop and death.
        if receiver == value && lower_release_scalar_result(p, function, fact_index, instruction) -> return LOWER_RELEASE_BORROW
        row :: m.prelude_positions.get(call.value) ?? return LOWER_RELEASE_KEEP
        if LOWER_RELEASE_BORROWING_BUILTINS.contains(lower_runtime_symbol(p.prelude_calls[row])) -> return lower_release_result_kind(function, fact_index, instruction)
    }
    // A Read argument of an Iter adapter is only read (lower_lazy_closure_route:
    // a Read callback is cloned into the adapter; a seed, fill or zip_strict
    // trap-context text is copied by the runtime); the arguments an adapter
    // takes over are consumed operands (lower_lazy_stored_operands). The
    // receiver of `opt.map(f)` (jet_option_map_ref, Combinators.jet
    // lower_closure_method) is only read: its payload is lent to the callback
    // and the result is a fresh box.
    if semantic == .ClosureMethod(receiver, args, call) {
        row :: m.prelude_positions.get(call.value) ?? return LOWER_RELEASE_KEEP
        symbol :: lower_runtime_symbol(p.prelude_calls[row])
        if lower_event_reads_operand(p.prelude_calls[row], receiver, args, value) -> return lower_release_result_kind(function, fact_index, instruction)
        if receiver == value {
            if symbol == "jet_option_map_ref" -> return lower_release_result_kind(function, fact_index, instruction)
            return LOWER_RELEASE_KEEP
        }
        if !lower_lazy_closure_route(symbol) -> return LOWER_RELEASE_KEEP
        loop arg in args {
            if arg.value == value && (arg.access != .Read || arg.place != None) -> return LOWER_RELEASE_KEEP
        }
        return lower_release_result_kind(function, fact_index, instruction)
    }
    LOWER_RELEASE_KEEP
}

// A non-consuming argument of a call whose result owns nothing borrowed: no
// result, or an owned, copied or moved one.
fn lower_release_result_kind(function: MIRFunction, fact_index: [U64:Int], instruction: MIRInstruction) -> Int Never! {
    result :: instruction.result ?? return LOWER_RELEASE_BORROW
    row :: fact_index.get(result.value) ?? return LOWER_RELEASE_KEEP
    mode :: function.values[row].ownership.mode
    if mode == MIROwnershipMode.Owned || mode == MIROwnershipMode.Copy || mode == MIROwnershipMode.Move -> return LOWER_RELEASE_BORROW
    LOWER_RELEASE_KEEP
}

// Whether `instruction` has no result, or a copied one holding no pointer
// (a Bool, Int word or fixed-width number; a zero-sized value).
fn lower_release_scalar_result(p: MIRProgram, function: MIRFunction, fact_index: [U64:Int], instruction: MIRInstruction) -> Bool Never! {
    result :: instruction.result ?? return true
    row :: fact_index.get(result.value) ?? return false
    if function.values[row].ownership.mode != MIROwnershipMode.Copy -> return false
    layout :: lower_repr_layout(lower_repr(p, function.values[row].ty)) ?? return true
    layout.class != .Pointer
}

// Whether `value` owns what it holds (unknown values count as owned).
fn lower_release_owned_value(function: MIRFunction, fact_index: [U64:Int], value: MIRValueID) -> Bool Never! {
    row :: fact_index.get(value.value) ?? return true
    lower_is_owned(function.values[row].ownership)
}

// The uses that keep `value` alive: its own, and those of every result that
// may alias it, transitively. None when a use keeps it unreleased: an
// unmodelled use, or an alias that is consumed, bound to a local, merged by a
// phi or used by a terminator. Every value but `owner` is an alias: a
// borrowed read (no owner) is one itself.
fn lower_release_effective_uses(function: MIRFunction, uses: [U64:[LowerReleaseUse]], phi_edges: [U64:[Int]], pinned: [U64:Bool], value: MIRValueID, owner: MIRValueID?) -> [LowerReleaseUse]? Never! {
    effective := [LowerReleaseUse]{}
    pending := [MIRValueID]{value}
    seen := [U64:Bool]{}
    cursor := 0
    loop cursor < pending.len() {
        current :: pending[cursor].copy()
        cursor += 1
        if seen.get(current.value) != None -> next
        _ := &seen.add(current.value, true)
        alias :: owner != Val(current)
        if alias && (pinned.get(current.value) != None || phi_edges.get(current.value) != None) -> return None
        rows :: uses.get(current.value) ?? [LowerReleaseUse]{}
        loop used in rows {
            if used.kind == LOWER_RELEASE_KEEP -> return None
            if alias && used.kind == LOWER_RELEASE_CONSUME -> return None
            if used.kind == LOWER_RELEASE_ALIAS {
                aliased :: function.blocks[used.block].instructions[used.position].result ?? return None
                &pending.push(aliased)
                &effective.push(LowerReleaseUse{block: used.block, position: used.position, kind: LOWER_RELEASE_BORROW})
                next
            }
            if alias && used.position >= function.blocks[used.block].instructions.len() -> return None
            &effective.push(used.copy())
        }
    }
    Val(effective)
}

// Liveness of one temporary over its effective uses, then its releases:
// after its last use in each block it does not outlive (unless that use takes
// it), and on each edge out of a block it outlives into a block that does not
// need it and whose phi does not take it.
fn lower_release_schedule(plan: &LowerReleasePlan, function: MIRFunction, successors: [[Int]], predecessors: [[Int]], phi_keys: [Int], effective: [LowerReleaseUse], value: MIRValueID, def_block: Int, def_position: Int) Never! {
    count :: function.blocks.len()
    live_in := [Int:Bool]{}
    live_out := [Int:Bool]{}
    pending := [Int]{}
    loop used in effective {
        if used.position >= function.blocks[used.block].instructions.len() && used.kind != LOWER_RELEASE_CONSUME -> _ := &live_out.add(used.block, true)
        if used.block != def_block && live_in.get(used.block) == None {
            _ := &live_in.add(used.block, true)
            &pending.push(used.block)
        }
    }
    loop key in phi_keys {
        from :: key /% count
        _ := &live_out.add(from, true)
        if from != def_block && live_in.get(from) == None {
            _ := &live_in.add(from, true)
            &pending.push(from)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        block :: pending[cursor].copy()
        cursor += 1
        loop predecessor in predecessors[block] {
            _ := &live_out.add(predecessor, true)
            if predecessor != def_block && live_in.get(predecessor) == None {
                _ := &live_in.add(predecessor, true)
                &pending.push(predecessor)
            }
        }
    }
    blocks := [Int]{def_block}
    last_uses :: lower_release_last_uses(effective)
    loop block in pending -> &blocks.push(block)
    loop block in blocks {
        if live_out.get(block) != None {
            loop target in successors[block] {
                if live_in.get(target) != None -> next
                key :: block * count + target
                if !phi_keys.contains(key) -> lower_release_add_edge(&plan.edges, key, value)
            }
            next
        }
        last :: last_uses.get(block)
        at :: if last == .Val(used) -> used.position else -> def_position
        if at >= function.blocks[block].instructions.len() || lower_release_takes(last) -> next
        lower_release_add(&plan.after, function.blocks[block].instructions[at].id.value, value)
    }
}

// The last use of a temporary in each block it is used in, in one pass over
// its uses; of two uses by one instruction, the one that takes it.
fn lower_release_last_uses(effective: [LowerReleaseUse]) -> [Int:LowerReleaseUse] Never! {
    found := [Int:LowerReleaseUse]{}
    loop used in effective {
        if lower_release_follows(used, found.get(used.block)) -> found[used.block] = used.copy()
    }
    found
}

fn lower_release_follows(used: LowerReleaseUse, found: LowerReleaseUse?) -> Bool Never! {
    last :: found ?? return true
    used.position > last.position || (used.position == last.position && used.kind == LOWER_RELEASE_CONSUME)
}

fn lower_release_takes(used: LowerReleaseUse?) -> Bool Never! {
    if used == .Val(last) -> return last.kind == LOWER_RELEASE_CONSUME
    false
}

// WritePlace instructions into an owner (lower_release_write_slot), whole or
// projected, that release the value they overwrite: none while a borrowed
// read of the place, or an alias of one, may still be used after the write.
// A read used only later in its own block leaves no write in that block
// between the read and its last use; a read used in later blocks too
// (lower_release_cross_read) leaves no write or move of the place in its
// block after it, nor in any block its value is live into, unless it owns a
// copy instead (lower_release_owning_read). A local an `uninit`
// initializes is left alone (its unwritten rows hold no owners). Whether the
// place may hold no value at the write follows lower_release_slot_flow: a
// move out of it empties it, a whole-root write fills it. A local carried in
// its slot (lower_release_cleared_slot) holds its zero placeholder when
// unassigned or moved out (lower_clear_slot), so its whole-root write
// releases the old value when one may be there, behind a null test when the
// placeholder may be there too (the plan's Bool). Any other write that may
// follow a move is left alone: a moved-out Write parameter's caller storage
// still holds the moved bits.
fn lower_release_write_drops(plan: &LowerReleasePlan, p: MIRProgram, m: LowerModule, function: MIRFunction, fact_index: [U64:Int], sunk: [U64:Bool], uses: [U64:[LowerReleaseUse]], phi_edges: [U64:[Int]], pinned: [U64:Bool], bound_locals: [U64:Bool], reachable: [Bool], successors: [[Int]], predecessors: [[Int]], entry: Int, slots: [LowerSlot], place_slots: [U64:Int], projected_places: [U64:Bool], live: [[Int]]) Never! {
    eligible := [Int:Bool]{}
    loop (slot, row) in slots {
        if lower_release_write_slot(row, bound_locals) -> _ := &eligible.add(slot, true)
    }
    if eligible.len() == 0 -> return
    // Per block * slot count + slot: block, read position and last use
    // position of each borrowed read of the slot in that block (one short row
    // per block, so adding a read never copies the slot's other blocks' reads).
    // Per block * slot count + slot: the kind of the block's last move
    // (LOWER_SLOT_EMPTIED) or whole-root write (LOWER_SLOT_FILLED) of it;
    // per slot: the blocks with one, chained (event_heads / event_next).
    spans := [Int:[Int]]{}
    count :: slots.len()
    events := [Int:Int]{}
    event_heads := [Int:Int]{}
    event_block := [Int]{}
    event_next := [Int]{}
    crossing := [LowerReleaseCrossRead]{}
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        loop (position, instruction) in row.instructions {
            event :: lower_release_slot_event(projected_places, place_slots, instruction)
            if event != 0 && eligible.get(lower_release_event_slot(event)) != None {
                slot :: lower_release_event_slot(event)
                key :: block * count + slot
                if events.get(key) == None {
                    &event_block.push(block)
                    &event_next.push(event_heads.get(slot) ?? -1)
                    event_heads[slot] = event_block.len() - 1
                }
                _ := &events.add(key, lower_release_event_kind(event))
            }
            if instruction.operation == .InitializeUninit(place) {
                if place_slots.get(place.value) == .Val(slot) -> _ := &eligible.remove(slot)
                next
            }
            if instruction.operation == .MovePlace(_) -> next
            result :: instruction.result ?? next
            if instruction.operation == .ReadPlace(_) && sunk.get(result.value) != None -> next
            if !(instruction.operation == .ReadPlace(_) | .AddressOf(_, _)) {
                // A call or method on a place: its owned result owns nothing borrowed.
                fact_row :: fact_index.get(result.value) ?? -1
                if fact_row >= 0 && lower_is_owned(function.values[fact_row].ownership) -> next
            }
            loop place in lower_instruction_places(instruction.operation) {
                slot :: place_slots.get(place.value) ?? next
                if eligible.get(slot) == None -> next
                span :: lower_release_read_span(function, uses, phi_edges, pinned, result, block, position) ?? {
                    // Used past its block: checked once every write is known.
                    &crossing.push(LowerReleaseCrossRead{slot: slot, read: result.value, block: block, position: position})
                    next
                }
                lower_release_add_row(&spans, block * count + slot, [Int]{block, position, span})
            }
        }
    }
    loop row in crossing {
        if eligible.get(row.slot) == None -> next
        if lower_release_cross_read(function, uses, phi_edges, pinned, reachable, successors, predecessors, place_slots, live, row) -> next
        if lower_release_owning_read(&plan, p, function, uses, phi_edges, pinned, successors, predecessors, slots, place_slots, projected_places, row) -> next
        _ := &eligible.remove(row.slot)
    }
    // Per flowed slot (`flowed`: slot -> its pair of rows in `flows`), per
    // block: whether the slot may enter the block empty (row 2r), or holding
    // a value (row 2r + 1).
    flows := [[Bool]]{}
    flowed := [Int:Int]{}
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        // Slot -> the kind of its last event so far in this block.
        state := [Int:Int]{}
        loop (position, instruction) in row.instructions {
            event :: lower_release_slot_event(projected_places, place_slots, instruction)
            if instruction.operation == .WritePlace(place, _) {
                slot :: place_slots.get(place.value) ?? -1
                if slot >= 0 && eligible.get(slot) != None && !lower_release_span_open(spans.get(block * count + slot) ?? [Int]{}, block, position) {
                    cleared :: lower_release_cleared_slot(slots[slot])
                    empty := false
                    full := true
                    if state.get(slot) == .Val(kind) {
                        empty = kind == LOWER_SLOT_EMPTIED
                        full = kind == LOWER_SLOT_FILLED
                    } else {
                        pair := flowed.get(slot) ?? -1
                        if pair < 0 {
                            pair = flows.len() /% 2
                            _ := &flowed.add(slot, pair)
                            starts := [Int]{}
                            at := event_heads.get(slot) ?? -1
                            loop at >= 0 {
                                &starts.push(event_block[at])
                                at = event_next[at]
                            }
                            &flows.push(lower_release_slot_flow(successors, events, starts, count, slot, LOWER_SLOT_EMPTIED, if cleared -> entry else -> -1))
                            &flows.push(lower_release_slot_flow(successors, events, starts, count, slot, LOWER_SLOT_FILLED, if cleared -> -1 else -> entry))
                        }
                        empty = flows[2 * pair][block]
                        full = flows[2 * pair + 1][block]
                    }
                    if cleared && event != 0 {
                        if full -> _ := &plan.write_drops.add(instruction.id.value, empty)
                    } else if !empty {
                        _ := &plan.write_drops.add(instruction.id.value, false)
                    }
                }
            }
            if event != 0 -> _ := &state.add(lower_release_event_slot(event), lower_release_event_kind(event))
        }
    }
    lower_release_slot_deaths(&plan, p, m, function, uses, eligible, reachable, successors, slots, place_slots, projected_places, live)
}

// Where each copy-value local slot's value dies (lower_release_copy_local;
// the slot passes lower_release_write_drops' read rule): on each edge out
// of a block holding it (live into the block or written in it) into a block
// it is not live into, and before the return of a block holding it. An owned
// local carried in its slot (lower_release_cleared_slot), an inline
// aggregate (List, Map, struct) as well as a boxed value, that passes the
// same rule dies on those edges too: a block that overwrites it before any
// read is not one it is live into, so the write itself finds no old value
// (MIR drops such a local only where its scope ends, behind its drop flag;
// a loop that rebinds a list local each iteration releases each old list
// on the edge into the rebinding block, lower_release_slots).
// It is never released before a return (MIR drops it there), except a
// `View<str>`, which MIR never drops (a borrowed `&str` window there, an
// owned String handle here: lower_string_view), nor when a
// field of it is moved out (its partial-drop flags own that). A slot whose
// whole root is written with a value anything else also uses is left alone;
// a projected write (`seen[k] = v` after `seen = [K:V]{}`) keeps it dying.
fn lower_release_slot_deaths(plan: &LowerReleasePlan, p: MIRProgram, m: LowerModule, function: MIRFunction, uses: [U64:[LowerReleaseUse]], eligible: [Int:Bool], reachable: [Bool], successors: [[Int]], slots: [LowerSlot], place_slots: [U64:Int], projected_places: [U64:Bool], live: [[Int]]) Never! {
    dying := [Int:Bool]{}
    place_rows :: lower_place_rows(function)
    owned := [Int:Bool]{}
    loop (slot, row) in slots {
        if eligible.get(slot) == None || !row.carried || row.cell || row.write_param >= 0 -> next
        if row.base == .Local(_) {
            if lower_release_copy_local(p, row.ownership, row.ty) {
                _ := &dying.add(slot, true)
            } else if lower_needs_drop(p, m, row.ty) && lower_close_method(p, m.close_methods, row.ty) == None {
                _ := &dying.add(slot, true)
                if !lower_string_view(row.ty) -> _ := &owned.add(slot, true)
            }
        }
    }
    if dying.len() == 0 -> return
    written := [[Int]]{}
    loop _ in function.blocks -> &written.push([Int]{})
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        loop instruction in row.instructions {
            if instruction.operation == .MovePlace(place) {
                if projected_places.get(place.value) == None -> next
                if place_slots.get(place.value) == .Val(slot) -> _ := &dying.remove(slot)
            }
            if instruction.operation == .WritePlace(place, value) | .ReplacePlace(place, value) {
                slot :: place_slots.get(place.value) ?? next
                if dying.get(slot) == None -> next
                target :: lower_place_row(function, place_rows, place) ?? next
                // A projected write (`seen[k] = v`, `holder.items = rows`)
                // works on the value the slot holds, in place: a boxed root is
                // made unique and the slot rebound to it first
                // (lower_slot_root_for_write), so the slot still holds its
                // one owner, and the place is a use (lower_live_slots), so the
                // block is one it is live into. It neither fills nor empties the slot.
                if target.projections.len() > 0 -> next
                if (uses.get(value.value) ?? [LowerReleaseUse]{}).len() != 1 {
                    _ := &dying.remove(slot)
                    next
                }
                &written[block].push(slot)
            }
        }
    }
    count :: function.blocks.len()
    loop (block, row) in function.blocks {
        if !reachable[block] -> next
        // The dying slots live into the block or written in it, ascending:
        // only those, not every slot of the function per block.
        held := [Int:Bool]{}
        loop slot in live[block] {
            if dying.get(slot) != None -> held[slot] = true
        }
        loop slot in written[block] {
            if dying.get(slot) != None -> held[slot] = true
        }
        candidates := [Int]{}
        loop (slot, _) in held -> &candidates.push(slot)
        &candidates.sort()
        loop slot in candidates {
            if successors[block].len() == 0 {
                if row.terminator == .Return(_) && owned.get(slot) == None -> lower_release_add_slot(&plan.slot_returns, block, slot)
                next
            }
            loop target in successors[block] {
                if !live[target].contains(slot) -> lower_release_add_slot(&plan.slot_edges, block * count + target, slot)
            }
        }
    }
}

fn lower_release_add_slot(rows: &[Int:[Int]], key: Int, slot: Int) Never! {
    held := rows.get(key) ?? [Int]{}
    if held.contains(slot) -> return
    &held.push(slot)
    _ := &rows.add(key, held)
}

// A place whose value an overwrite must release, as a Rust assignment drops
// the value it replaces: an owned local (not bound to an SSA value), carried
// in its slot or kept in a cell; a Write parameter, whose caller storage owns
// its value; or a captured place inside a closure body. A borrowed
// parameter's cell copy owns nothing.
fn lower_release_write_slot(row: LowerSlot, bound_locals: [U64:Bool]) -> Bool Never! {
    if row.write_param >= 0 -> return true
    if row.base == .Local(local) {
        if bound_locals.get(local.value) != None -> return false
        return lower_is_owned(row.ownership)
    }
    if row.base == .Capture(_) -> return row.cell
    false
}

// A local carried in its slot, neither a cell nor a Write parameter: its
// slot holds the zero placeholder while it has no value (lower_clear_slot).
fn lower_release_cleared_slot(row: LowerSlot) -> Bool Never! {
    row.base == .Local(_) && !row.cell && row.write_param < 0
}

// A move out of a slot leaves it empty; a whole-root write fills it.
LOWER_SLOT_EMPTIED :: prep { 1 }
LOWER_SLOT_FILLED :: prep { 2 }

// The slot event of `instruction` (decoded by lower_release_event_slot and
// lower_release_event_kind): -(slot + 1) for a move out of the slot,
// slot + 1 for a write of its whole root, 0 for neither.
fn lower_release_slot_event(projected_places: [U64:Bool], place_slots: [U64:Int], instruction: MIRInstruction) -> Int Never! {
    if instruction.operation == .MovePlace(place) {
        moved :: place_slots.get(place.value) ?? return 0
        return -moved - 1
    }
    if instruction.operation == .WritePlace(place, _) | .ReplacePlace(place, _) {
        written :: place_slots.get(place.value) ?? return 0
        if projected_places.get(place.value) == None -> return written + 1
    }
    0
}

fn lower_release_event_slot(event: Int) -> Int Never! {
    if event < 0 -> -event - 1 else -> event - 1
}

fn lower_release_event_kind(event: Int) -> Int Never! {
    if event < 0 -> LOWER_SLOT_EMPTIED else -> LOWER_SLOT_FILLED
}

// Per block, whether `slot` may enter it in state `kind` (LOWER_SLOT_EMPTIED
// or LOWER_SLOT_FILLED): a forward may-analysis from the function's `entry`
// block (when >= 0) and from each block (among `starts`) whose last event of
// the slot (`events`, keyed block * `count` + slot) is of that kind; a block
// with no event of the slot passes its entry state on.
fn lower_release_slot_flow(successors: [[Int]], events: [Int:Int], starts: [Int], count: Int, slot: Int, kind: Int, entry: Int) -> [Bool] Never! {
    reached := [Bool]{}
    loop _ in successors -> &reached.push(false)
    pending := [Int]{}
    if entry >= 0 {
        reached[entry] = true
        &pending.push(entry)
    }
    loop block in starts {
        if (events.get(block * count + slot) ?? 0) != kind -> next
        loop target in successors[block] {
            if reached[target] -> next
            reached[target] = true
            &pending.push(target)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        // copy: plain Int block index; the loop below pushes onto `pending`.
        block :: pending[cursor].copy()
        cursor += 1
        if events.get(block * count + slot) != None -> next
        loop target in successors[block] {
            if reached[target] -> next
            reached[target] = true
            &pending.push(target)
        }
    }
    reached
}

// The last position in `block` at which the borrowed read `read` (at
// `position`) or an alias of it is used; None when one is used elsewhere.
fn lower_release_read_span(function: MIRFunction, uses: [U64:[LowerReleaseUse]], phi_edges: [U64:[Int]], pinned: [U64:Bool], read: MIRValueID, block: Int, position: Int) -> Int? Never! {
    effective :: lower_release_effective_uses(function, uses, phi_edges, pinned, read, None) ?? return None
    last := position
    loop used in effective {
        if used.block != block || used.position >= function.blocks[block].instructions.len() -> return None
        last = if used.position > last -> used.position else -> last
    }
    Val(last)
}

// A borrowed read of `slot` (MIR value `read` at `position` of `block`) whose
// value, or an alias of it, is used in later blocks.
struct LowerReleaseCrossRead { slot: Int, read: U64, block: Int, position: Int }

// Whether the cross-block read `row` leaves its slot's overwrites and deaths
// releasable: every use of its value and aliases is modelled, the slot is live
// into every block the value is live into (no death releases it while it is
// in use; lower_live_slots counts those uses as the slot's), and no write,
// replacement or move of the slot's place falls while the value is in use
// (no write drop releases it): none in the read's block after the read, none
// in a block the value is live out of, and none before the last use in a
// block it is live into only. The read dominates its uses, so the blocks it is
// live into are those that reach a use without passing through the read's
// block.
fn lower_release_cross_read(function: MIRFunction, uses: [U64:[LowerReleaseUse]], phi_edges: [U64:[Int]], pinned: [U64:Bool], reachable: [Bool], successors: [[Int]], predecessors: [[Int]], place_slots: [U64:Int], live: [[Int]], row: LowerReleaseCrossRead) -> Bool Never! {
    effective :: lower_release_effective_uses(function, uses, phi_edges, pinned, MIRValueID{value: row.read}, None) ?? return false
    instructions :: function.blocks[row.block].instructions
    if lower_release_block_writes(instructions, place_slots, row.slot, row.position + 1, instructions.len()) -> return false
    // Block -> the last position of a use in it.
    last := [Int:Int]{}
    pending := [Int]{}
    loop used in effective {
        if used.block == row.block -> next
        if last.get(used.block) == .Val(seen_at) {
            if used.position > seen_at -> last[used.block] = used.position
            next
        }
        _ := &last.add(used.block, used.position)
        &pending.push(used.block)
    }
    // The blocks the value is live into: use blocks, then their predecessors
    // up to the read's block (-1: no use of its own).
    cursor := 0
    loop cursor < pending.len() {
        // copy: plain Int block index; the loop below pushes onto `pending`.
        block :: pending[cursor].copy()
        cursor += 1
        loop from in predecessors[block] {
            if from == row.block || !reachable[from] || last.get(from) != None -> next
            _ := &last.add(from, -1)
            &pending.push(from)
        }
    }
    loop block in pending {
        if !live[block].contains(row.slot) -> return false
        live_out := false
        loop target in successors[block] {
            if target != row.block && last.get(target) != None -> live_out = true
        }
        end :: if live_out -> function.blocks[block].instructions.len() else -> (last.get(block) ?? -1) + 1
        if lower_release_block_writes(function.blocks[block].instructions, place_slots, row.slot, 0, end) -> return false
    }
    true
}

// A borrowed read lower_release_cross_read rejects, of an exact Int local
// (lower_release_copy_local, not a cell) through its root place, whose uses
// only read it (merged by no phi, taken by no consumer, every use modelled):
// it owns a copy of the slot's value instead (lower_read_owns clones it, a
// word unless the value is a big integer), released as a temporary after its
// uses (lower_release_schedule), so the slot's writes and deaths still
// release the values they find. `implementation :: p.impls[at]` followed by
// `at = next[at]` names `p.impls[at]` by the old `at` after the write.
fn lower_release_owning_read(plan: &LowerReleasePlan, p: MIRProgram, function: MIRFunction, uses: [U64:[LowerReleaseUse]], phi_edges: [U64:[Int]], pinned: [U64:Bool], successors: [[Int]], predecessors: [[Int]], slots: [LowerSlot], place_slots: [U64:Int], projected_places: [U64:Bool], row: LowerReleaseCrossRead) -> Bool Never! {
    if slots[row.slot].cell || !lower_release_copy_local(p, slots[row.slot].ownership, slots[row.slot].ty) -> return false
    root := false
    if function.blocks[row.block].instructions[row.position].operation == .ReadPlace(place) {
        root = projected_places.get(place.value) == None && place_slots.get(place.value) == Val(row.slot)
    }
    if !root || pinned.get(row.read) != None || phi_edges.get(row.read) != None -> return false
    read :: MIRValueID{value: row.read}
    effective :: lower_release_effective_uses(function, uses, phi_edges, pinned, read, Val(read)) ?? return false
    loop used in effective {
        if used.kind == LOWER_RELEASE_CONSUME -> return false
    }
    lower_release_schedule(&plan, function, successors, predecessors, [Int]{}, effective, read, row.block, row.position)
    _ := &plan.candidates.add(row.read, true)
    _ := &plan.owned_reads.add(row.read, true)
    true
}

// Whether an instruction of `instructions` in `start..<end` writes, replaces or
// moves a place of `slot`, whole or projected.
fn lower_release_block_writes(instructions: [MIRInstruction], place_slots: [U64:Int], slot: Int, start: Int, end: Int) -> Bool Never! {
    loop at in start..<end {
        if instructions[at].operation == .WritePlace(place, _) | .ReplacePlace(place, _) {
            if place_slots.get(place.value) == .Val(written) {
                if written == slot -> return true
            }
        }
        if instructions[at].operation == .MovePlace(place) {
            if place_slots.get(place.value) == .Val(moved) {
                if moved == slot -> return true
            }
        }
    }
    false
}

fn lower_release_add_row(rows: &[Int:[Int]], slot: Int, values: [Int]) Never! {
    row := rows.get(slot) ?? [Int]{}
    loop value in values -> &row.push(value)
    _ := &rows.add(slot, row)
}

// Whether a borrowed read of the slot (block, read position, last use
// triples) is still in use at `position` of `block`.
fn lower_release_span_open(rows: [Int], block: Int, position: Int) -> Bool Never! {
    at := 0
    loop at + 2 < rows.len() {
        if rows[at] == block && rows[at + 1] < position && rows[at + 2] >= position -> return true
        at += 3
    }
    false
}

// Every value an operation reads: mir_operation_value_uses plus the values a
// Closure captures (its captures are not SSA operands there, so a value read
// only to be captured, `task f(jobs)`, would otherwise look unused).
fn lower_operand_values(operation: MIROperation) -> [MIRValueID] Never! {
    values := mir_operation_value_uses(operation)
    if operation == .Closure(_, captures, _) {
        loop capture in captures {
            if capture == .Value(value) -> &values.push(value)
        }
    }
    values
}

// The instruction results no operand, terminator, place (base or index
// projection) or SSA-bound local names: values computed and never read.
fn lower_dead_values(function: MIRFunction) -> [U64:Bool] Never! {
    used := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            loop value in lower_operand_values(instruction.operation) -> _ := &used.add(value.value, true)
        }
        loop value in mir_terminator_value_uses(block.terminator) -> _ := &used.add(value.value, true)
    }
    loop place in function.places {
        if place.base == .Parameter(value) | .Capture(value) | .Temporary(value) -> _ := &used.add(value.value, true)
        loop projection in place.projections {
            if projection == .Index(_, index, _, _, _, _, _) -> _ := &used.add(index.value, true)
            if projection == .Range(range, _, _) -> _ := &used.add(range.value, true)
            if projection == .MapLookup(lookup, _, _) -> _ := &used.add(lookup.value, true)
        }
    }
    loop local in function.locals {
        if local.ssa_value == .Val(value) -> _ := &used.add(value.value, true)
    }
    dead := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            if used.get(result.value) == None -> _ := &dead.add(result.value, true)
        }
    }
    dead
}

fn lower_reverse_postorder(successors: [[Int]], entry: Int) -> [Int] Never! {
    visited := [Bool]{}
    loop _ in successors -> &visited.push(false)
    postorder := [Int]{}
    stack := [Int]{entry}
    cursors := [Int]{0}
    visited[entry] = true
    loop stack.len() > 0 {
        top :: stack.len() - 1
        node :: stack[top].copy()
        next_edge :: cursors[top].copy()
        if next_edge < successors[node].len() {
            cursors[top] = next_edge + 1
            child :: successors[node][next_edge]
            if !visited[child] {
                visited[child] = true
                &stack.push(child)
                &cursors.push(0)
            }
        } else {
            &postorder.push(node)
            _ := &stack.pop()
            _ := &cursors.pop()
        }
    }
    order := [Int]{}
    index := postorder.len() - 1
    loop index >= 0 {
        &order.push(postorder[index])
        index -= 1
    }
    order
}

// The index of the Write parameter whose Parameter instruction defines
// `value`, or -1.
fn lower_write_param_index(function: MIRFunction, value: MIRValueID) -> Int Never! {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if result == value {
                    if instruction.operation == .Parameter(index, _) {
                        if index >= 0 && index < function.params.len() && function.params[index].access == .Write -> return index
                    }
                    return -1
                }
            }
        }
    }
    -1
}

// MIR place id value -> the place's first row in `function.places`, built
// once per function so a place lookup is one map probe, not a row scan.
fn lower_place_rows(function: MIRFunction) -> [U64:Int] Never! {
    rows := [U64:Int]{}
    loop (index, row) in function.places {
        if rows.get(row.id.value) == None -> &rows.add(row.id.value, index).drop("checked absent above")
    }
    rows
}

fn lower_place_row(function: MIRFunction, rows: [U64:Int], place: MIRPlaceID) -> MIRPlace? {
    row :: rows.get(place.value) ?? return None
    Val(function.places[row])
}

// A dynamic trait call that no lowered implementation answers cannot return
// either (lower_trait_dispatches): its successors are not lowered, so the
// dispatch's join is never left without a predecessor.
fn lower_is_noreturn(p: MIRProgram, m: LowerModule, operation: MIROperation) -> Bool Never! {
    if operation == .Semantic(semantic) {
        if semantic == .RequireStop(_, kind, _, _, _, _, always_stops) -> return always_stops || kind == .Panic
    }
    if operation == {
        .Never(_) -> true
        .Todo(_, _, _) -> true
        .Call(callee, args, type_args) -> lower_trait_call_dead(p, m, callee, args, type_args)
        else -> false
    }
}

fn lower_block_returns(p: MIRProgram, m: LowerModule, block: MIRBasicBlock) -> Bool Never! {
    if block.terminator == .Poll(_, _, _) -> return true
    loop instruction in block.instructions {
        if lower_is_noreturn(p, m, instruction.operation) -> return false
    }
    true
}

// Per MIR block position: the block an edge into it really enters. An empty
// block whose terminator only jumps on (MIR `bN: jump bM`: a scope exit, a
// join, a loop exit) forwards to where that jump leads, through a chain of
// such blocks; every edge into it goes straight there (lower_context's
// successors), and the block itself is never lowered. A block that jumps to a
// phi stays: its phi edge is its own. A comptime-budgeted lowering keeps every
// block, since each executed terminator spends fuel (lower_comptime_site).
fn lower_forward_blocks(function: MIRFunction, block_index: [U64:Int], keep: Bool) -> [Int] Never! {
    count :: function.blocks.len()
    next := [Int]{}
    loop (position, block) in function.blocks {
        target := -1
        if !keep && block.instructions.len() == 0 {
            if block.terminator == {
                .Jump(to) | .Continue(to) -> target = block_index.get(to.value) ?? -1
                else -> {}
            }
        }
        if target == position -> target = -1
        if target >= 0 {
            loop instruction in function.blocks[target].instructions {
                if instruction.operation == .Phi(_) -> target = -1
            }
        }
        &next.push(target)
    }
    forward := [Int]{}
    loop position in 0..<count {
        // Follow the chain; a cycle of empty jumps (an empty `loop {}`) is kept.
        at := position
        steps := 0
        loop next[at] >= 0 && steps <= count {
            at = next[at]
            steps += 1
        }
        &forward.push(if steps > count -> position else -> at)
    }
    forward
}

fn lower_function_body(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    entry :: c.order[0]
    // Entry parameters, in MIR parameter order; absent parameters carry nothing.
    entry_params := [LIRValueID]{}
    if c.mir.capture_params.len() > 0 {
        env :: lower_pointer(&f)
        &entry_params.push(env)
        f.env = Val(env)
    }
    if lower_is_inline(p, c.mir.return_type) {
        storage :: lower_pointer(&f)
        &entry_params.push(storage)
        f.result_storage = Val(storage)
    }
    loop param in c.mir.params {
        repr :: lower_repr(p, param.ty)
        if repr == .Unsupported(reason) -> return lower_fail(&m, &f, "parameter {param.name}: {reason} is not lowered at O0 yet")
        if lower_repr_layout(repr) == .Val(layout) {
            value :: if param.access == .Write -> lower_pointer(&f) else -> lower_new_value(&f, layout, lower_drop(&m, repr, lower_is_owned(param.ownership)), param.ty.identity)
            &entry_params.push(value)
            &f.params.push(Val(value))
        } else {
            &f.params.push(None)
        }
    }
    // A parameter's debug variable is its MIR position (lower_debug_function);
    // a Write parameter's entry value is the caller's place, not the value.
    loop (index, param) in c.mir.params {
        if param.access == .Write -> next
        // copy: the parameter value is read while `&f` is written (slot initialization and
        // lower_emit), so a view into f.params would be live across those writes.
        param_value :: f.params[index].copy()
        if param_value == .Val(value) -> lower_debug_bind_variable(&f, index, value)
    }
    current := [LIRValueID?]{}
    loop _ in c.slots -> &current.push(None)
    f.current = current
    if c.split_entry {
        // The function start precedes every MIR block: slots start as placeholders.
        entry_id :: LIRBlockID{value: 0}
        lower_start(&f, entry_id, entry_params)
        lower_comptime_site(&m, &f, "jet_rt_comptime_enter", c.mir.span.start, c.mir.span.end)
        loop slot in 0..<c.slots.len() -> lower_clear_slot(p, c, &f, slot)
        lower_frame_storage(p, c, &f)
        lower_frame_cells(p, c, &m, &f)
        lower_sentry_frame(c, &m, &f)
        lower_deadline_frame(c, &f)
        lower_partial_frame(p, c, &m, &f)
        lower_close_frame(p, &m, &f)
        f.mir_block = MIRBlockID{value: U64.MAX}
        edge :: lower_edge(p, c, &m, &f, c.mir.entry) ?? return
        lower_seal(&f, LIRTerminator.Jump{target: edge})
    }
    loop position in c.order {
        if f.failed -> return
        params :: if position == entry && !c.split_entry -> entry_params else -> [LIRValueID]{}
        lower_block(p, c, &m, &f, position, params)
    }
}

// Frame storage of its own for every inline aggregate slot a back edge copies
// and every inline phi of a loop header (LoopCopies.jet), made in the
// function's entry block so it dominates every use.
fn lower_frame_storage(p: MIRProgram, c: LowerContext, f: &LowerFunction) Never! {
    storage := [LIRValueID?]{}
    loop (slot, row) in c.slots {
        if c.loop_copies.copied[slot] {
            &storage.push(Val(lower_new_storage(p, &f, row.ty)))
        } else {
            &storage.push(None)
        }
    }
    f.storage = storage
    loop (position, block) in c.mir.blocks {
        if !c.loop_copies.headers[position] -> next
        loop instruction in block.instructions {
            if !lower_is_phi(instruction) -> next
            result :: instruction.result ?? next
            ty :: lower_checked_type(c, instruction) ?? next
            if !lower_inline_of(p, &f, ty) -> next
            held :: lower_new_storage(p, &f, ty)
            _ := &f.phi_storage.add(result.value, held.value)
        }
    }
}

fn lower_is_phi(instruction: MIRInstruction) -> Bool Never! {
    if instruction.operation == .Phi(_) -> return true
    false
}

// The slot a dropped value empties: the slot it was read or moved out of, or
// the parameter or temporary slot it stands for.
fn lower_slot_of_value(c: LowerContext, value: MIRValueID) -> Int? {
    if c.read_slots.get(value.value) == .Val(slot) -> return Val(slot)
    c.defined_slots.get(value.value)
}

// The source value at the beginning of a checked chain of Moves.
fn lower_move_root(c: LowerContext, value: MIRValueID) -> MIRValueID Never! {
    inner :: c.moves.get(value.value) ?? return value
    lower_move_root(c, MIRValueID{value: inner})
}

// Every carried slot live into a block (Liveness.jet) holds a value on every
// edge into it, so blocks need no
// definite-assignment analysis: a slot that is unassigned, moved out or
// dropped holds a zero placeholder with no drop action. MIR's checked
// definite assignment and drop-live flags guarantee the placeholder is never
// read as a live value. Slots of one layout share one placeholder, made at
// the function's start (the first clear of every slot), so it dominates
// every later clear.
fn lower_clear_slot(p: MIRProgram, c: LowerContext, f: &LowerFunction, slot: Int) Never! {
    layout :: lower_repr_layout(lower_repr_of(p, &f, c.slots[slot].ty)) ?? return lower_set_slot(&f, slot, None)
    lower_set_slot(&f, slot, Val(lower_placeholder(&f, layout)))
}

fn lower_placeholder(f: &LowerFunction, layout: LIRLayout) -> LIRValueID Never! {
    loop (index, known) in f.placeholder_layouts {
        if known == layout -> return f.placeholder_values[index].copy()
    }
    placeholder :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Const{dst: placeholder, value: 0})
    &f.placeholder_layouts.push(layout)
    &f.placeholder_values.push(placeholder)
    _ := &f.placeholders.add(placeholder.value, true)
    placeholder
}

// Whether `value` is a slot's null placeholder: releasing or copying it
// behind its null test would do nothing.
fn lower_is_placeholder(f: LowerFunction, value: LIRValueID) -> Bool Never! {
    f.placeholders.get(value.value) != None
}

// ---------------------------------------------------------------------------
// Blocks and terminators.

fn lower_block(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, position: Int, entry_params: [LIRValueID]) Never! {
    block :: c.mir.blocks[position]
    poll_block := false
    if block.terminator == .Poll(_, _, _) -> poll_block = true
    f.mir_block = block.id
    params := entry_params.copy()
    // Slots start empty; a phi defines the temporary slot it stands for.
    current := [LIRValueID?]{}
    loop _ in c.slots -> &current.push(None)
    f.current = current
    lower_debug_block_line(p, c, &m, &f, block)
    loop instruction in block.instructions {
        if instruction.operation == .Phi(_) {
            if lower_result(p, c, &m, &f, instruction) == .Val(param) -> &params.push(param)
        }
    }
    function_entry :: position == c.order[0] && !c.split_entry
    if !function_entry {
        loop slot in c.live[position] {
            row :: c.slots[slot]
            repr :: lower_repr_of(p, &f, row.ty)
            layout :: lower_repr_layout(repr) ?? next
            drop :: lower_drop(&m, repr, lower_is_owned(row.ownership))
            param :: lower_new_value(&f, layout, drop, row.ty.identity)
            &params.push(param)
            lower_set_slot(&f, slot, Val(param))
        }
    }
    lower_start(&f, c.lir_blocks[position], params)
    if function_entry {
        lower_comptime_site(&m, &f, "jet_rt_comptime_enter", c.mir.span.start, c.mir.span.end)
        loop slot in 0..<c.slots.len() -> lower_clear_slot(p, c, &f, slot)
        lower_frame_storage(p, c, &f)
        lower_frame_cells(p, c, &m, &f)
        lower_sentry_frame(c, &m, &f)
        lower_deadline_frame(c, &f)
        lower_partial_frame(p, c, &m, &f)
        lower_close_frame(p, &m, &f)
    }
    loop instruction in block.instructions {
        if f.failed -> return
        lower_comptime_site(&m, &f, "jet_rt_comptime_step", instruction.span.start, instruction.span.end)
        if instruction.operation == .Phi(_) {
            // A phi's value is a parameter of this block, which dominates
            // every block lowered for the rest of its MIR block.
            if instruction.result == .Val(phi) {
                if c.releases.candidates.get(phi.value) != None {
                    if f.values.get(phi.value) == .Val(index) {
                        _ := &f.releasable.add(phi.value, true)
                        _ := &f.releasable_lir.add(index, true)
                    }
                }
            }
            released :: c.releases.after.get(instruction.id.value) ?? [MIRValueID]{}
            loop value in released -> lower_temp_release(p, c, &m, &f, value)
            next
        }
        lower_debug_line(p, c, &m, &f, instruction)
        lower_instruction(p, c, &m, &f, instruction)
        if (lower_is_noreturn(p, m, instruction.operation) || lower_open_sealed(f)) && !poll_block -> return
    }
    if f.failed -> return
    f.track_consumes = false
    lower_terminator(p, c, &m, &f, block)
    f.track_consumes = true
}

fn lower_carries(p: MIRProgram, c: LowerContext, instruction: MIRInstruction) -> Bool Never! {
    ty :: lower_checked_type(c, instruction) ?? return false
    lower_repr_layout(lower_repr(p, ty)) != None
}

// Arguments for the edge from the MIR block being lowered to `target`: its
// phis' incoming values from this block, then every carried slot live into
// `target` (Liveness.jet), ascending.
//
// Inline aggregates are carried by pointer, so a value made in one loop
// iteration lives in that iteration's StackSlot storage, which the next
// iteration reuses. A back edge therefore copies every inline phi value and
// every inline slot value its loop rebinds (LoopCopies.jet) into the phi's or
// slot's own frame storage and passes that instead. The copies go through
// temporaries when there are several, so a swap reads every source before
// writing any; a slot holding its null placeholder (unassigned or moved out)
// stays null.
fn lower_edge(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, target: MIRBlockID) -> LIRJumpTarget? {
    position :: lower_entered_block(c, target) ?? return None
    source :: f.mir_block.copy()
    back :: lower_is_back_edge(c, source, target)
    copies :: if back -> lower_edge_copy_slots(c, f, position) else -> [Int]{}
    copied := 0
    args := [LIRValueID]{}
    copy_args := [Int]{}
    copy_targets := [LIRValueID]{}
    copy_types := [MIRType]{}
    copy_nullable := [Bool]{}
    loop instruction in c.mir.blocks[position].instructions {
        if instruction.operation == .Phi(incoming) {
            if !lower_carries(p, c, instruction) -> next
            found := false
            loop row in incoming {
                if row.block == source && !found {
                    found = true
                    value :: lower_use(&m, &f, row.value) ?? return None
                    if back && instruction.result == .Val(result) {
                        if f.phi_storage.get(result.value) == .Val(index) {
                            phi_ty :: lower_checked_type(c, instruction) ?? return None
                            &copy_args.push(args.len())
                            &copy_targets.push(LIRValueID{value: index})
                            &copy_types.push(phi_ty)
                            &copy_nullable.push(false)
                        }
                    }
                    &args.push(value)
                }
            }
            if !found {
                lower_fail(&m, &f, "a phi in b{target.value} has no value from b{source.value}")
                return None
            }
        }
    }
    loop slot in c.live[position] {
        row :: c.slots[slot]
        // copy: the slot's current value is read while the edge writes `&f` (lower_fail and edge
        // copies), so a view into f.current would be live across those writes.
        held :: f.current[slot].copy()
        value :: held ?? {
            lower_fail(&m, &f, "local slot {slot} has no value on the edge b{source.value} -> b{target.value}")
            return None
        }
        if copied < copies.len() && copies[copied] == slot {
            copied += 1
            // copy: the matched storage is used while the edge writes `&f` (f.current and f.storage are
            // updated below), so a payload view into f.storage would be live across those writes.
            if (f.storage[slot].copy()) == .Val(storage) {
                &copy_args.push(args.len())
                &copy_targets.push(storage)
                &copy_types.push(row.ty)
                &copy_nullable.push(true)
            }
        }
        &args.push(value)
    }
    if copy_args.len() > 1 {
        loop index in 0..<copy_args.len() {
            staged :: lower_new_storage(p, &f, copy_types[index])
            args[copy_args[index]] = lower_copy_carried(p, &f, staged, args[copy_args[index]], copy_types[index], copy_nullable[index])
        }
    }
    loop index in 0..<copy_args.len() {
        args[copy_args[index]] = lower_copy_carried(p, &f, copy_targets[index], args[copy_args[index]], copy_types[index], copy_nullable[index])
    }
    Val(lower_target(c.lir_blocks[position], args))
}

fn lower_is_back_edge(c: LowerContext, source: MIRBlockID, target: MIRBlockID) -> Bool Never! {
    from :: c.block_index.get(source.value) ?? return false
    to :: lower_entered_block(c, target) ?? return false
    c.ranks[to] <= c.ranks[from]
}

// The position of the block an edge to `target` enters (LowerContext.forward).
fn lower_entered_block(c: LowerContext, target: MIRBlockID) -> Int? {
    position :: c.block_index.get(target.value) ?? return None
    Val(c.forward[position])
}

// Copies the inline aggregate `value` into `storage` and names the storage;
// a `nullable` value that is null (a slot placeholder) stays null.
fn lower_copy_carried(p: MIRProgram, f: &LowerFunction, storage: LIRValueID, value: LIRValueID, ty: MIRType, nullable: Bool) -> LIRValueID Never! {
    if nullable && lower_is_placeholder(f, value) -> return value.copy()
    if !nullable {
        lower_write_at(p, &f, storage, 0, value, ty)
        return storage.copy()
    }
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: value, right: null})
    copy_block :: lower_new_block(&f)
    join :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(join, [LIRValueID]{null}), else_target: lower_target(copy_block, [LIRValueID]{})})
    lower_start(&f, copy_block, [LIRValueID]{})
    lower_write_at(p, &f, storage, 0, value, ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{storage})})
    carried :: lower_pointer(&f)
    lower_start(&f, join, [LIRValueID]{carried})
    carried
}

// The slots the back edge from the block being lowered into `position`
// copies: those its loop rebinds (LoopCopies.jet) that are live into the
// target, ascending. An edge the block order did not record copies every
// slot with storage.
fn lower_edge_copy_slots(c: LowerContext, f: LowerFunction, position: Int) -> [Int] Never! {
    from :: c.block_index.get(f.mir_block.value) ?? return [Int]{}
    slots := [Int]{}
    rebound :: c.loop_copies.edges.get(from * c.mir.blocks.len() + position) ?? {
        loop slot in c.live[position] {
            if c.loop_copies.copied[slot] -> &slots.push(slot)
        }
        return slots
    }
    at := 0
    loop slot in c.live[position] {
        loop at < rebound.len() && rebound[at] < slot -> at += 1
        if at < rebound.len() && rebound[at] == slot -> &slots.push(slot)
    }
    slots
}

// Whether the edge into `target` copies carried inline aggregates (a back
// edge into a block with inline phis, or one whose loop rebinds a live
// inline slot); such an edge leaves a conditional terminator through a block
// of its own, so the copies run only when the edge is taken.
fn lower_edge_copies(p: MIRProgram, c: LowerContext, f: LowerFunction, target: MIRBlockID) -> Bool Never! {
    if !lower_is_back_edge(c, f.mir_block, target) -> return false
    position :: lower_entered_block(c, target) ?? return false
    if lower_edge_copy_slots(c, f, position).len() > 0 -> return true
    loop instruction in c.mir.blocks[position].instructions {
        if !lower_is_phi(instruction) -> next
        ty :: lower_checked_type(c, instruction) ?? next
        if lower_is_inline(p, ty) -> return true
    }
    false
}

// The target a conditional terminator names for the edge to `target`: the
// edge itself, or a fresh block lowering it (see lower_edge_copies; an edge
// that releases temporaries, lower_release_plan, needs one too), which is
// filled after the terminator seals the current block.
fn lower_branch_target(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, target: MIRBlockID, pending: &[LIRBlockID], pending_targets: &[MIRBlockID]) -> LIRJumpTarget? {
    if !lower_edge_copies(p, c, f, target) && lower_edge_releases(c, f, target).len() == 0 && lower_edge_slot_releases(c, f, target).len() == 0 -> return lower_edge(p, c, &m, &f, target)
    block :: lower_new_block(&f)
    &pending.push(block)
    &pending_targets.push(target)
    Val(lower_target(block, [LIRValueID]{}))
}

// Each pending edge is a separate path out of the block: the slot state one
// edge's releases change (a slot cleared to its placeholder, a partial-drop
// reset) must not leak into its siblings, whose arguments would then name
// values defined only on the other edge.
struct LowerEdgeState {
    current: [LIRValueID?]
    partial_drops: [LowerPartialDrop]
}

fn lower_edge_state(f: LowerFunction) -> LowerEdgeState Never! {
    LowerEdgeState{current: f.current.copy(), partial_drops: f.partial_drops.copy()}
}

fn lower_restore_edge_state(f: &LowerFunction, state: LowerEdgeState) Never! {
    f.current = state.current.copy()
    f.partial_drops = state.partial_drops.copy()
}

fn lower_fill_pending(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, pending: [LIRBlockID], pending_targets: [MIRBlockID]) Never! {
    state :: lower_edge_state(f)
    loop (index, block) in pending {
        lower_restore_edge_state(&f, state)
        lower_start(&f, block, [LIRValueID]{})
        lower_release_edge(p, c, &m, &f, pending_targets[index])
        edge :: lower_edge(p, c, &m, &f, pending_targets[index]) ?? return
        lower_seal(&f, LIRTerminator.Jump{target: edge})
    }
    lower_restore_edge_state(&f, state)
}

fn lower_condition(m: &LowerModule, f: &LowerFunction, value: MIRValueID) -> LIRValueID? {
    condition :: lower_use(&m, &f, value) ?? return None
    if lower_value_layout(f, condition) != lir_layout_bool() {
        lower_fail(&m, &f, "branch condition {value.value} is not a Bool")
        return None
    }
    Val(condition)
}

fn lower_terminator(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, block: MIRBasicBlock) Never! {
    // An empty or backedge-only block still spends fuel on each executed terminator.
    lower_comptime_site(&m, &f, "jet_rt_comptime_step", block.span.start, block.span.end)
    if block.terminator == {
        .Jump(target) | .Continue(target) | .Break(target, _) -> {
            lower_release_edge(p, c, &m, &f, target)
            edge :: lower_edge(p, c, &m, &f, target) ?? return
            lower_seal(&f, LIRTerminator.Jump{target: edge})
        }
        .Branch(condition, then_target, else_target) -> {
            flag :: lower_condition(&m, &f, condition) ?? return
            pending := [LIRBlockID]{}
            pending_targets := [MIRBlockID]{}
            then_edge :: lower_branch_target(p, c, &m, &f, then_target, &pending, &pending_targets) ?? return
            else_edge :: lower_branch_target(p, c, &m, &f, else_target, &pending, &pending_targets) ?? return
            lower_seal(&f, LIRTerminator.Branch{condition: flag, then_target: then_edge, else_target: else_edge})
            lower_fill_pending(p, c, &m, &f, pending, pending_targets)
        }
        .Switch(_, arms, otherwise) -> {
            // Arms are tested in order; each failed test falls to the next.
            loop arm in arms {
                flag :: lower_condition(&m, &f, arm.condition) ?? return
                pending := [LIRBlockID]{}
                pending_targets := [MIRBlockID]{}
                arm_edge :: lower_branch_target(p, c, &m, &f, arm.target, &pending, &pending_targets) ?? return
                next_block :: lower_new_block(&f)
                lower_seal(&f, LIRTerminator.Branch{condition: flag, then_target: arm_edge, else_target: lower_target(next_block, [LIRValueID]{})})
                lower_fill_pending(p, c, &m, &f, pending, pending_targets)
                lower_start(&f, next_block, [LIRValueID]{})
            }
            lower_release_edge(p, c, &m, &f, otherwise)
            edge :: lower_edge(p, c, &m, &f, otherwise) ?? return
            lower_seal(&f, LIRTerminator.Jump{target: edge})
        }
        .Return(value) -> {
            if value == .Val(returned) {
                lower_partial_escape(p, c, &m, &f, returned, None)
                if f.failed -> return lower_seal(&f, LIRTerminator.Unreachable)
                lower_close_transfer(c, &f, returned)
            }
            lower_sentry_function_leave(&m, &f)
            // copy: the result storage is read while the terminator emits into `&f`, so a view into
            // f.result_storage would be live across those writes.
            result_storage :: f.result_storage.copy()
            if result_storage == .Val(storage) {
                // An inline aggregate result moves into the caller's storage.
                returned :: value ?? return lower_fail(&m, &f, "return without a value from a function returning {mir_type_display_name(c.mir.return_type)}")
                lowered :: lower_use(&m, &f, returned) ?? return
                lower_write_at(p, &f, storage, 0, lowered, c.mir.return_type)
                lower_release_return_slots(p, c, &m, &f, None)
                lower_comptime_leave(&m, &f)
                return lower_seal(&f, LIRTerminator.Return{value: None})
            }
            if lower_repr_layout(c.result) == None {
                lower_release_return_slots(p, c, &m, &f, None)
                lower_comptime_leave(&m, &f)
                return lower_seal(&f, LIRTerminator.Return{value: None})
            }
            returned :: value ?? {
                lower_release_return_slots(p, c, &m, &f, None)
                return lower_return_implicit_ok(p, c, &m, &f)
            }
            lowered :: lower_use(&m, &f, returned) ?? return
            lower_release_return_slots(p, c, &m, &f, Val(lowered))
            lower_comptime_leave(&m, &f)
            lower_seal(&f, LIRTerminator.Return{value: Val(lowered)})
        }
        .Unreachable(_) -> lower_seal(&f, LIRTerminator.Unreachable)
        .Yield(_, _) -> lower_fail(&m, &f, "generators are not lowered at O0 yet")
        .Poll(kind, resume, stop) -> lower_poll(p, c, &m, &f, kind, resume, stop)
        .Stopped -> {
            lower_sentry_function_leave(&m, &f)
            lower_stopped(c, &f)
        }
    }
}

// Stop points of the unified execution host (#4720; design doc "Stop points").
// `Check` delivers a pending session interrupt (jet_rt_session_poll); `Propagate`
// reads only the stop the preceding can-stop operation already delivered
// (jet_rt_session_propagate, Shield-masked). A nonzero status word takes the
// stop edge, whose canonical cleanup ends in Stopped; zero resumes.
//
// With the runtime pack (m.native_pack) GS points at the attached thread's
// TCB, whose word 16 is the current control (JetRuntime Scheduler.jet,
// scheduler_control_current), so both kinds test the control inline and call
// only when the runtime could answer nonzero: no control resumes; Propagate
// calls only for a nonzero status@32; Check calls only for status@32,
// pending@48 or pauseMode@24 == 1 (jet_scheduler_native_poll's work). The
// freestanding image has no TCB and keeps the call (its rail answers 0).
fn lower_poll(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, kind: MIRPollKind, resume: MIRBlockID, stop: MIRBlockID) Never! {
    pending := [LIRBlockID]{}
    pending_targets := [MIRBlockID]{}
    stop_edge :: lower_branch_target(p, c, &m, &f, stop, &pending, &pending_targets) ?? return
    resume_edge :: lower_branch_target(p, c, &m, &f, resume, &pending, &pending_targets) ?? return
    lower_session_branch(&m, &f, kind, stop_edge, resume_edge)
    lower_fill_pending(p, c, &m, &f, pending, pending_targets)
}

// Seals the open block with lower_poll's test of `kind`: `stop` when the
// session status is nonzero, else `resume`.
fn lower_session_branch(m: &LowerModule, f: &LowerFunction, kind: MIRPollKind, stop_edge: LIRJumpTarget, resume_edge: LIRJumpTarget) Never! {
    symbol :: if kind == {
        .Check -> "jet_rt_session_poll"
        .Propagate -> "jet_rt_session_propagate"
    }
    zero :: lower_const(&f, 0)
    if m.native_pack {
        control :: lower_pointer(&f)
        lower_emit(&f, LIRInst.ThreadWord{dst: control, offset: 16})
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        attached :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: attached, condition: LIRCondition.Ne, left: control, right: null})
        test_status :: lower_new_block(&f)
        slow :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: attached, then_target: lower_target(test_status, [LIRValueID]{}), else_target: resume_edge})
        lower_start(&f, test_status, [LIRValueID]{})
        status_word :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: status_word, base: control, offset: 32})
        if kind == .Check {
            pending_word :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: pending_word, base: control, offset: 48})
            either :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: either, op: LIRBinaryOp.Or, left: status_word, right: pending_word})
            raised :: lower_numeric_compare(&f, LIRCondition.Ne, either, zero)
            test_pause :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: raised, then_target: lower_target(slow, [LIRValueID]{}), else_target: lower_target(test_pause, [LIRValueID]{})})
            lower_start(&f, test_pause, [LIRValueID]{})
            mode :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: mode, base: control, offset: 24})
            one :: lower_const(&f, 1)
            paused :: lower_numeric_compare(&f, LIRCondition.Eq, mode, one)
            lower_seal(&f, LIRTerminator.Branch{condition: paused, then_target: lower_target(slow, [LIRValueID]{}), else_target: resume_edge})
        } else {
            raised :: lower_numeric_compare(&f, LIRCondition.Ne, status_word, zero)
            lower_seal(&f, LIRTerminator.Branch{condition: raised, then_target: lower_target(slow, [LIRValueID]{}), else_target: resume_edge})
        }
        lower_start(&f, slow, [LIRValueID]{})
    }
    status :: lower_word(&f)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{}, Val(status))
    stopped :: lower_numeric_compare(&f, LIRCondition.Ne, status, zero)
    lower_seal(&f, LIRTerminator.Branch{condition: stopped, then_target: stop_edge, else_target: resume_edge})
}

// Stopped leaves the function with the stop still delivered on the session
// control and no result written: a hidden result pointer's storage stays
// untouched, and a register result is a zero word no caller reads (MIR
// legality puts every use of a call result behind its Propagate's resume edge).
fn lower_stopped(c: LowerContext, f: &LowerFunction) Never! {
    if f.result_storage != None -> return lower_seal(&f, LIRTerminator.Return{value: None})
    layout :: lower_repr_layout(c.result) ?? return lower_seal(&f, LIRTerminator.Return{value: None})
    unwritten :: lir_builder_value(&f.builder, layout, LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Const{dst: unwritten, value: 0})
    lower_seal(&f, LIRTerminator.Return{value: Val(unwritten)})
}

// Whether a function `prepared` lowers carries a MIR stop point.
fn lower_has_stop_points(p: MIRProgram, prepared: [LowerPreparedFunction]) -> Bool Never! {
    loop descriptor in prepared {
        if descriptor.source_row < 0 -> next
        loop block in p.functions[descriptor.source_row].blocks {
            if block.terminator == {
                .Poll(_, _, _) | .Stopped -> return true
                else -> {}
            }
        }
    }
    false
}

// A global native-host program may still contain plain/noreturn functions.
// Arm publication only for this checked operation's immediate real Propagate
// terminator, never merely because some other function has stop points.
fn lower_instruction_has_stop_poll(c: LowerContext, f: LowerFunction, instruction: MIRInstruction) -> Bool Never! {
    at :: c.block_index.get(f.mir_block.value) ?? return false
    block :: c.mir.blocks[at]
    if block.instructions.len() == 0 -> return false
    if block.instructions[block.instructions.len() - 1].id != instruction.id -> return false
    if block.terminator == {
        .Poll(kind, _, _) -> return kind == MIRPollKind.Propagate
        else -> {}
    }
    false
}

fn lower_poll_call_enter(m: &LowerModule, f: &LowerFunction) -> LIRValueID Never! {
    saved :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_poll_call_enter", [LIRValueID]{}, Val(saved))
    saved
}

fn lower_poll_call_leave(m: &LowerModule, f: &LowerFunction, saved: LIRValueID) Never! {
    lower_call_runtime(&m, &f, "jet_rt_poll_call_leave", [LIRValueID]{saved}, None)
}

// A bare return from a fallible function whose success type is Unit returns
// Ok(()) (MIRRust.rs default_return); the box is lower_result_box's layout.
fn lower_return_implicit_ok(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    if c.mir.failure == .Result(success, _) {
        if lower_repr(p, success) == .Absent {
            boxed :: lower_pointer(&f)
            lower_alloc(&m, &f, boxed, lower_box_size(p, c.mir.return_type))
            lower_store_word(&f, boxed, 0, lower_result_selector(true))
            lower_store_word(&f, boxed, lower_result_payload_offset(), 0)
            return lower_seal(&f, LIRTerminator.Return{value: Val(boxed)})
        }
    }
    lower_fail(&m, &f, "return without a value from a function returning {mir_type_display_name(c.mir.return_type)}")
}

// ---------------------------------------------------------------------------
// Instructions.

// A dead owned result (LowerContext.dead) is released as Rust releases an
// unused temporary: a pure read (place, copy, payload) is never
// materialized, so no clone is made; a fresh producer's result is released
// as soon as it is produced (lower_release_plan).
fn lower_instruction(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    if instruction.result == .Val(result) {
        if c.dead.get(result.value) != None && lower_value_owned(c, result) {
            if instruction.operation == .ReadPlace(_) | .Copy(_, _) | .OptionValue(_) | .ResultValue(_, _) | .Constant(_) | .Global(_) -> return lower_alias_absent(&f, instruction)
        }
    }
    values_before :: f.builder.values.len()
    sealed_before :: f.builder.blocks.len()
    open_before :: f.builder.open.len()
    consumed_before :: f.consumed.len()
    lower_instruction_operation(p, c, &m, &f, instruction)
    if f.failed -> return
    if f.consumed.len() > consumed_before -> lower_forget_planned_consumes(p, c, m, &f, instruction)
    // A lowering that ended in a terminator (an unsupported operation's
    // Unreachable, a no-return call) left no open block: nothing after it runs,
    // and anything emitted now would be attached to the next block lowered,
    // which this block's values do not dominate.
    if lower_open_sealed(f) -> return
    if instruction.result == .Val(defined) {
        if c.releases.candidates.get(defined.value) != None {
            from :: if f.builder.blocks.len() == sealed_before -> open_before else -> 0
            // A root move names the value its slot held, a parameter of the
            // open block or defined in it, and the slot no longer holds it.
            if c.releases.taken.get(defined.value) != None -> lower_mark_releasable(&f, defined, 0, 0)
            else -> lower_mark_releasable(&f, defined, values_before, from)
            // A lowering that branched (a host call building its Result on
            // both outcomes, after converting its arguments in branches of
            // their own) may define the value in a block it sealed: when that
            // block dominates the open one, so does the definition.
            if f.releasable.get(defined.value) == None && f.builder.blocks.len() > sealed_before {
                if f.values.get(defined.value) == .Val(index) {
                    if index >= values_before && lower_sealed_defines(f, sealed_before, open_before, index) {
                        _ := &f.releasable.add(defined.value, true)
                        _ := &f.releasable_lir.add(index, true)
                    }
                }
            }
            // A moved root names the slot's current value, which dominates
            // here; the move cleared the slot, so the carrier owns it alone.
            // (A moved field is a fresh value its own lowering defined.)
            if c.inspect_carriers.get(defined.value) != None && c.releases.taken.get(defined.value) != None && f.releasable.get(defined.value) == None {
                if f.values.get(defined.value) == .Val(index) {
                    _ := &f.releasable.add(defined.value, true)
                    _ := &f.releasable_lir.add(index, true)
                }
            }
        }
    }
    released :: c.releases.after.get(instruction.id.value) ?? [MIRValueID]{}
    loop value in released -> lower_temp_release(p, c, &m, &f, value)
}

// A consumption the release plan models (an operand this instruction takes
// over: lower_consumed_operands) ends the operand on this instruction's path
// only, and the plan releases it on every other path (a loop cursor MIR drops
// where the loop ends and the plan releases on each early exit): only a
// consumption the plan does not know of may stop those releases
// (LowerFunction.consumed). A Move keeps its record: an inspect Move is no
// consumption in the plan (lower_is_inspect_move).
fn lower_forget_planned_consumes(p: MIRProgram, c: LowerContext, m: LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    if instruction.operation == .Move(_) -> return
    loop operand in lower_consumed_operands(p, m, c.mir, c.fact_index, instruction.operation) {
        index :: f.values.get(operand.value) ?? next
        _ := &f.consumed.remove(index)
    }
}

// Whether the open block was already sealed: the last block the builder
// sealed is the one lowering is still emitting into.
fn lower_open_sealed(f: LowerFunction) -> Bool Never! {
    count :: f.builder.blocks.len()
    count > 0 && f.builder.blocks[count - 1].id == f.open
}

// Whether LIR value `index` is defined by a block sealed since row `first`
// (the block a lowering started in, at or after its instruction `from`) that
// dominates the open block.
fn lower_sealed_defines(f: LowerFunction, first: Int, from: Int, index: Int) -> Bool Never! {
    row :: lower_sealed_definition_row(f, first, from, index)
    if row < 0 -> return false
    row == first || lower_sealed_dominates_open(f, first, row)
}

// The row of the block sealed since row `first` (from its instruction `from`
// on, in the first block) that defines LIR value `index`; -1 when none does.
fn lower_sealed_definition_row(f: LowerFunction, first: Int, from: Int, index: Int) -> Int Never! {
    loop row in first..<f.builder.blocks.len() {
        start :: if row == first -> from else -> 0
        loop at in start..<f.builder.blocks[row].insts.len() {
            if lir_inst_def(f.builder.blocks[row].insts[at]) == .Val(dst) {
                if dst.value == index -> return row
            }
        }
    }
    -1
}

// Whether every path from sealed row `first` (the block a lowering started
// in) to the open block passes through sealed row `through`: the walk over
// the blocks sealed since `first` that skips `through` never reaches it.
fn lower_sealed_dominates_open(f: LowerFunction, first: Int, through: Int) -> Bool Never! {
    rows := [Int:Int]{}
    loop row in first..<f.builder.blocks.len() -> _ := &rows.add(f.builder.blocks[row].id.value, row)
    seen := [Int:Bool]{}
    pending := [Int]{first}
    cursor := 0
    loop cursor < pending.len() {
        row :: pending[cursor]
        cursor += 1
        if row == through || seen.get(row) != None -> next
        _ := &seen.add(row, true)
        loop target in lir_terminator_targets(f.builder.blocks[row].terminator) {
            if target.block.value == f.open.value -> return false
            reached :: rows.get(target.block.value) ?? next
            &pending.push(reached)
        }
    }
    true
}

// A release candidate is releasable when its lowering made a fresh LIR value
// (not an alias of an earlier one) defined in the open block, at or after
// instruction `from` of it, or as one of its parameters: that block is where
// the definition's lowering ended, so it dominates every later block the
// temporary is used in.
fn lower_mark_releasable(f: &LowerFunction, value: MIRValueID, values_before: Int, from: Int) Never! {
    index :: f.values.get(value.value) ?? return
    if index < values_before || !lower_open_defines(f, index, from) -> return
    _ := &f.releasable.add(value.value, true)
    _ := &f.releasable_lir.add(index, true)
}

// Whether LIR value `index` is a parameter of the open block or defined by
// one of its instructions from `from` on.
fn lower_open_defines(f: LowerFunction, index: Int, from: Int) -> Bool Never! {
    loop param in f.open_params {
        if param.value == index -> return true
    }
    loop at in from..<f.builder.open.len() {
        if lir_inst_def(f.builder.open[at]) == .Val(dst) {
            if dst.value == index -> return true
        }
    }
    false
}

// Builtin runtime routes that only read their operands and return a scalar
// or a fresh value (Lists.jet, Strings.jet, Maps.jet, TextBytes.jet; a
// string split Iter holds copies of its text and separator, Text.jet; the
// Unicode text routes and the `*_view` text cuts copy out what they return,
// Strings.jet lower_route_symbol; `==` compares in place, Builtins.jet
// lower_core_equal and Strings.jet lower_string_method; index_of only
// compares its needle, Lists.jet lower_helper_list_index_of; a Map remove
// only compares its key, Maps.jet lower_helper_map_take; Int.parse and
// Float.parse read their text into a fresh Result; a List slice copies its
// window's elements, Lists.jet lower_list_method_window, and a String slice
// its window's text, Text.jet rt_text_slice, reading only their bounds): a
// temporary they read is still the caller's to release once their owned
// result no longer needs it.
LOWER_RELEASE_BORROWING_BUILTINS :: [String]{"jet_eq", "jet_list_len", "jet_list_is_empty", "jet_list_join", "jet_list_contains", "jet_list_index_of", "jet_list_slice", "jet_char_len", "jet_string_count_bytes", "jet_string_is_empty", "jet_string_contains", "jet_string_starts_with", "jet_string_ends_with", "jet_string_bytes", "jet_string_replace", "jet_string_repeat", "jet_string_from_bytes", "jet_string_from_bytes_lossy", "jet_string_slice_builtin", "jet_string_after", "jet_string_before", "jet_string_after_view", "jet_string_before_view", "jet_string_trim_view", "jet_unicode_trim", "jet_unicode_trim_view", "jet_unicode_lower", "jet_unicode_upper", "jet_unicode_index_of", "jet_unicode_last_index_of", "jet_unicode_count", "jet_iter_string_split", "jet_iter_string_rsplit", "jet_map_len", "jet_map_is_empty", "jet_map_get_opt", "jet_map_has_key", "jet_map_pop_kernel", "jet_int_parse", "jet_float_parse"}

// Releases an owned temporary (lower_release_plan) unless its lowering made
// no fresh owner of it (lower_mark_releasable), a slot holds its LIR value
// (the slot owns it then), or the lowering already ended its life (a Move,
// Reown or Drop of it, or a jump handing it to a block parameter): never a
// second release. A bound copy-value local's value is released through its
// slot (lower_release_bound).
fn lower_temp_release(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID) Never! {
    if f.releasable.get(value.value) == None -> return
    if lower_is_absent(f, value) -> return
    index :: f.values.get(value.value) ?? return
    if f.consumed.get(index) != None -> return
    if c.releases.bound.get(value.value) != None {
        // An inline aggregate's LIR value is its storage pointer, whose drop
        // is trivial: its fields are released by drop glue, which
        // lower_drop_value runs (clearing the slot that names it first).
        inline := false
        if lower_value_type(c, value) == .Val(ty) -> inline = lower_is_inline(p, ty)
        if !inline -> return lower_release_bound(p, c, &f, value, index)
        tracking :: f.track_consumes
        f.track_consumes = false
        lower_drop_value(p, c, &m, &f, value)
        f.track_consumes = tracking
        return
    }
    // A root move cleared its slot (lower_clear_slot, or lower_clear_at for
    // a cell): the moved value it took, a moved match subject included, is
    // released here.
    if lower_slot_of_value(c, value) != None && c.releases.taken.get(value.value) == None && c.releases.owned_reads.get(value.value) == None -> return
    loop slot_value in f.current {
        if slot_value == .Val(holding) && holding.value == index -> return
    }
    tracking :: f.track_consumes
    f.track_consumes = false
    lower_drop_value(p, c, &m, &f, value)
    f.track_consumes = tracking
}

// A bound copy-value local's value after its last use: the block parameter
// its slot carries it in when the slot is live into this block, else the
// value itself; the slot then holds a placeholder.
fn lower_release_bound(p: MIRProgram, c: LowerContext, f: &LowerFunction, value: MIRValueID, index: Int) Never! {
    target := LIRValueID{value: index}
    if lower_slot_of_value(c, value) == .Val(slot) {
        // copy: the held value is read while the release writes `&f` (f.current is cleared below),
        // so a view into f.current would be live across that write.
        held :: f.current[slot].copy()
        if held == .Val(holding) {
            if lower_value_drop(f, holding) != .Trivial -> target = holding
        }
        lower_clear_slot(p, c, &f, slot)
    }
    if lower_value_drop(f, target) == .Trivial -> return
    lower_release_lir(&f, target)
}

// Drops a LIR owner outside an instruction's own lowering: not a consumption
// lower_emit should record.
fn lower_release_lir(f: &LowerFunction, value: LIRValueID) Never! {
    tracking :: f.track_consumes
    f.track_consumes = false
    lower_emit(&f, LIRInst.Drop{value: value})
    f.track_consumes = tracking
}

// The releases of the edge from the MIR block being lowered to `target`.
fn lower_edge_releases(c: LowerContext, f: LowerFunction, target: MIRBlockID) -> [MIRValueID] Never! {
    from :: c.block_index.get(f.mir_block.value) ?? return [MIRValueID]{}
    to :: lower_entered_block(c, target) ?? return [MIRValueID]{}
    c.releases.edges.get(from * c.mir.blocks.len() + to) ?? [MIRValueID]{}
}

// The copy-value local slots whose value dies on that edge.
fn lower_edge_slot_releases(c: LowerContext, f: LowerFunction, target: MIRBlockID) -> [Int] Never! {
    from :: c.block_index.get(f.mir_block.value) ?? return [Int]{}
    to :: lower_entered_block(c, target) ?? return [Int]{}
    c.releases.slot_edges.get(from * c.mir.blocks.len() + to) ?? [Int]{}
}

fn lower_release_edge(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, target: MIRBlockID) Never! {
    dying :: lower_edge_slot_releases(c, f, target)
    lower_release_slots(p, c, &m, &f, dying, None)
    loop value in lower_edge_releases(c, f, target) -> lower_temp_release(p, c, &m, &f, value)
}

// Releases the values local slots hold where they die
// (lower_release_slot_deaths); never `kept`, the value a return hands over.
// A pointer may be the slot's null placeholder (unassigned or moved out):
// it is released only behind a null test. An inline aggregate (a List, Map
// or struct carried as its storage pointer, whose LIR value owns nothing
// itself) is released through its drop glue (lower_inline_drop), as a root
// write that finds it in its slot releases it (lower_write_place).
fn lower_release_slots(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, slots: [Int], kept: LIRValueID?) Never! {
    loop slot in slots {
        // copy: the held value is read while the release writes `&f` (f.current is cleared below),
        // so a view into f.current would be live across that write.
        held :: f.current[slot].copy() ?? next
        // A slot known to hold its placeholder releases nothing.
        if lower_is_placeholder(f, held) -> next
        if kept == .Val(returned) {
            if returned == held -> next
        }
        inline :: lower_is_inline(p, c.slots[slot].ty)
        if !inline && lower_value_drop(f, held) == .Trivial -> next
        if !inline && lower_value_layout(f, held) != lir_layout_pointer() {
            lower_release_lir(&f, held)
            next
        }
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: held, right: null})
        body :: lower_new_block(&f)
        done :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
        lower_start(&f, body, [LIRValueID]{})
        if inline -> lower_inline_drop(p, &m, &f, held, c.slots[slot].ty) else -> lower_release_lir(&f, held)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
    }
}

fn lower_release_return_slots(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, kept: LIRValueID?) Never! {
    position :: c.block_index.get(f.mir_block.value) ?? return
    lower_release_slots(p, c, &m, &f, c.releases.slot_returns.get(position) ?? [Int]{}, kept)
}

fn lower_instruction_operation(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    if f.partial_drops.len() != 0 || f.closing != None {
        stored := lower_stored_operands(instruction.operation)
        loop value in lower_map_stored_operands(p, m, instruction.operation) -> &stored.push(value)
        loop value in lower_lazy_stored_operands(p, m, instruction.operation) -> &stored.push(value)
        loop value in lower_task_stored_operands(p, m, instruction.operation) -> &stored.push(value)
        loop value in lower_parallel_stored_operands(p, m, instruction.operation) -> &stored.push(value)
        loop value in lower_atomic_stored_operands(p, m, instruction.operation) -> &stored.push(value)
        args := [MIRCallArg]{}
        if instruction.operation == {
            .Call(_, call_args, _) | .IndirectCall(_, call_args, _) | .CoreCall(_, _, call_args, _, _, _) -> args = call_args
            .Semantic(semantic) -> {
                if semantic == {
                    .StaticPreludeCall(_, call_args, _, _) | .HardwareCall(_, _, _, call_args) | .ClosureMethod(_, call_args, _) | .AllocNew(_, _, _, call_args) | .HostCall(_, call_args) -> args = call_args
                    else -> {}
                }
            }
            else -> {}
        }
        loop arg in args {
            if arg.access == .Move || arg.owned_last_use -> &stored.push(arg.value)
        }
        loop value in stored {
            lower_partial_escape(p, c, &m, &f, value, Val(instruction.id))
            if f.failed -> return
            lower_close_transfer(c, &f, value)
        }
    }
    if instruction.operation == {
        .Parameter(index, name) -> {
            if index < 0 || index >= f.params.len() -> return lower_fail(&m, &f, "parameter {name} has index {index} outside the signature")
            // copy: the parameter value is read while the operation writes `&f` (lower_emit and the
            // f.current update), so a view into f.params would be live across those writes.
            param :: f.params[index].copy()
            if param == .Val(value) {
                if c.mir.params[index].access != .Write -> return lower_alias(c, &f, instruction, value)
                // A Write parameter's value is the caller place's current
                // value; an inline aggregate's is the caller's storage itself.
                if lower_is_inline(p, c.mir.params[index].ty) -> return lower_alias(c, &f, instruction, value)
                dst :: lower_result(p, c, &m, &f, instruction) ?? return
                lower_read_into(p, &f, dst, value, 0, c.mir.params[index].ty)
            } else {
                lower_alias_absent(&f, instruction)
            }
        }
        .Constant(value) -> lower_constant(p, c, &m, &f, instruction, value)
        .Global(name) -> lower_static_global(p, c, &m, &f, instruction, name)
        .Copy(value, _) -> lower_copy(p, c, &m, &f, instruction, value)
        .Move(value) -> lower_forward(c, &m, &f, instruction, value)
        .AttachTag(value, _) -> lower_forward(c, &m, &f, instruction, value)
        .Convert(value, parameters, target, conversion) -> lower_convert(p, c, &m, &f, instruction, value, parameters, target, conversion)
        .TraitBox(value, _) -> lower_trait_box(p, c, &m, &f, instruction, value)
        .ReadPlace(place) -> lower_read_place(p, c, &m, &f, instruction, place, false)
        .MovePlace(place) -> lower_read_place(p, c, &m, &f, instruction, place, true)
        // A Rust assignment drops the value it overwrites (lower_release_write_drops).
        .WritePlace(place, value) -> {
            release :: c.releases.write_drops.get(instruction.id.value)
            lower_write_place(p, c, &m, &f, place, value, release != None, release ?? false)
        }
        .ReplacePlace(place, value) -> lower_write_place(p, c, &m, &f, place, value, true, false)
        .InitializeUninit(place) -> lower_initialize_uninit(p, c, &m, &f, place)
        .Unary(op, value) -> lower_unary(p, c, &m, &f, instruction, op, value)
        .Binary(op, dispatch, overflow, left, right) -> lower_binary(p, c, &m, &f, instruction, op, dispatch, overflow, left, right)
        .BuildString(parts) -> lower_build_string(p, c, &m, &f, instruction, parts)
        .BuildList(values, trait_coercion) -> lower_build_list(p, c, &m, &f, instruction, values, trait_coercion)
        .BuildMap(entries) -> lower_build_map(p, c, &m, &f, instruction, entries)
        .MapLookup(map, key, cache) -> lower_map_lookup(p, c, &m, &f, instruction, map, key, cache)
        .Range(start, end, exclusive) -> lower_range_value(p, c, &m, &f, instruction, start, end, exclusive)
        .Index(_, base, index, kind, access, _, _) -> {
            if kind == .Map -> return lower_map_index(p, c, &m, &f, instruction, base, index, access)
            lower_list_index(p, c, &m, &f, instruction, base, index, kind, access)
        }
        .AddressOf(place, _) -> {
            // A mutating receiver (BuiltinMethods.jet:742) or Write argument:
            // the place's value, borrowed (a List's stable header pointer,
            // an inline aggregate's storage). A Write argument lends the place
            // itself (lower_write_arg), never this value.
            lower_read_place(p, c, &m, &f, instruction, place, false)
        }
        .Field(base, field) -> lower_field(p, c, &m, &f, instruction, base, field)
        .Struct(type_id, fields) -> lower_struct_construct(p, c, &m, &f, instruction, type_id, fields, [MIRFieldID]{})
        .Tuple(type_id, fields) -> lower_tuple(p, c, &m, &f, instruction, type_id, fields)
        .ProjectMembers(base, members) -> lower_project_members(p, c, &m, &f, instruction, base, members)
        .Enum(type_id, variant, args) -> lower_enum(p, c, &m, &f, instruction, type_id, variant, args)
        .EnumIs(subject, owner, variant) -> lower_enum_is(p, c, &m, &f, instruction, subject, owner, variant)
        .EnumPayload(subject, owner, variant, index) -> lower_enum_payload(p, c, &m, &f, instruction, subject, owner, variant, index)
        .Present(value) -> lower_present(p, c, &m, &f, instruction, value)
        .Absent -> {
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            lower_emit(&f, LIRInst.Const{dst: dst, value: 0})
        }
        .OptionIsSome(subject) -> {
            boxed :: lower_use(&m, &f, subject) ?? return
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            null :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Const{dst: null, value: 0})
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ne, left: boxed, right: null})
        }
        .OptionValue(subject) -> lower_load_payload(p, c, &m, &f, instruction, subject, 0)
        .ResultOk(value) -> lower_result_box(p, c, &m, &f, instruction, value, lower_result_selector(true))
        .ResultErr(value) -> lower_result_box(p, c, &m, &f, instruction, value, lower_result_selector(false))
        .ResultIsOk(subject) -> {
            boxed :: lower_use(&m, &f, subject) ?? return
            dst :: lower_result(p, c, &m, &f, instruction) ?? return
            ok_word :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: ok_word, base: boxed, offset: 0})
            expected :: lower_const(&f, lower_result_selector(true))
            lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: ok_word, right: expected})
        }
        .ResultValue(subject, _) -> lower_load_payload(p, c, &m, &f, instruction, subject, lower_result_payload_offset())
        .PatternCapture(matched, index) -> lower_pattern_capture(p, c, &m, &f, instruction, matched, index)
        .PatternMatched(matched) -> lower_pattern_matched(p, c, &m, &f, instruction, matched)
        .Slice(call, base, start, end, range, location) -> {
            row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "Slice without a checked Prelude route is not lowered at O0 yet")
            lower_slice(p, c, &m, &f, instruction, row, base, start, end, range, location)
        }
        .Call(callee, args, type_args) -> lower_call(p, c, &m, &f, instruction, callee, args, type_args)
        .IndirectCall(callee, args, _) -> lower_indirect_call(p, c, &m, &f, instruction, callee, args)
        .Closure(function, captures, _) -> lower_closure(p, c, &m, &f, instruction, function, captures)
        .Capture(slot) -> lower_capture(p, c, &m, &f, instruction, slot)
        .Semantic(semantic) -> lower_semantic(p, c, &m, &f, instruction, semantic)
        .CoreCall(_, route, args, type_args, _, _) -> {
            if lower_lazy_call(p, c, &m, &f, instruction, route, args) -> return
            if lower_channel_call(p, c, &m, &f, instruction, route, args) -> return
            if lower_atexit_call(p, c, &m, &f, instruction, route, args) -> return
            if lower_codec_call(p, c, &m, &f, instruction, route, args, type_args) -> return
            if lower_encoding_list_leaf(p, c, &m, &f, instruction, route, args, type_args) -> return
            if type_args.len() > 0 {
                route_name :: lower_route_name(p, m.prelude_positions, route)
                return lower_fail(&m, &f, "generic CoreCall {route_name} is not lowered at O0 yet")
            }
            values :: lower_route_values(p, &m, &f, route, args, "CoreCall") ?? return
            lower_route_call(p, c, &m, &f, instruction, route, values, "CoreCall")
        }
        .LoopRangeInit(call, start, end, step, exclusive) -> {
            row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "range loop names missing Prelude call {call.value}")
            first :: lower_use(&m, &f, start) ?? return
            last :: lower_use(&m, &f, end) ?? return
            args := [LIRValueID]{first, last}
            if step == .Val(step_value) {
                stride :: lower_use(&m, &f, step_value) ?? return
                &args.push(stride)
                &args.push(lower_const_flag(&f, 1))
            } else {
                &args.push(lower_const(&f, 0))
                &args.push(lower_const_flag(&f, 0))
            }
            &args.push(lower_const_flag(&f, if exclusive -> 1 else -> 0))
            dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "range loop cursor has no value")
            lower_call_runtime(&m, &f, lower_runtime_symbol(row), args, Val(dst))
        }
        .LoopRangeHasNext(call, cursor) | .LoopRangeValue(call, cursor) | .LoopRangeAdvance(call, cursor) -> {
            row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "range loop names missing Prelude call {call.value}")
            handle :: lower_use(&m, &f, cursor) ?? return
            dst :: lower_result(p, c, &m, &f, instruction)
            lower_call_runtime(&m, &f, lower_runtime_symbol(row), [LIRValueID]{handle}, dst)
        }
        .LoopIterInit(call, collection, step, by_value, source_kind) -> lower_iter_init(p, c, &m, &f, instruction, call, collection, step, by_value, source_kind)
        .LoopIterHasNext(call, cursor) -> lower_iter_operation(p, c, &m, &f, instruction, call, cursor, "has_next")
        .LoopIterValue(call, cursor) -> lower_iter_operation(p, c, &m, &f, instruction, call, cursor, "value")
        .LoopIterAdvance(call, cursor) -> lower_iter_operation(p, c, &m, &f, instruction, call, cursor, "advance")
        .Todo(call, location, _) -> {
            row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "todo names missing Prelude call {call.value}")
            args :: lower_location(p, &m, &f, location)
            lower_noreturn_call(&m, &f, lower_runtime_symbol(row), args)
        }
        .Never(reason) -> {
            args :: lower_static_text(&m, &f, reason)
            lower_noreturn_call(&m, &f, "jet_rt_unreachable", args)
        }
        .ScopeEnter(scope, _) -> lower_scope(p, c, &m, &f, instruction, scope, true)
        .ScopeExit(scope) -> lower_scope(p, c, &m, &f, instruction, scope, false)
        .Drop(value, _) -> lower_drop_value(p, c, &m, &f, value)
        .RawAddressOf(place) -> lower_raw_address_of(p, c, &m, &f, instruction, place)
        .PtrFromAddr(address, _) -> lower_ptr_from_addr(p, c, &m, &f, instruction, address)
        .Deref(value) -> {
            if lower_shared_guard_deref(p, c, &m, &f, instruction, value) -> return
            lower_ptr_deref(p, c, &m, &f, instruction, value)
        }
        else -> lower_fail(&m, &f, "MIR operation {lower_operation_name(instruction.operation)} is not lowered at O0 yet")
    }
}
// Pattern lookups (Codegen/Expressions.jet) cache Option<Ptr<V>> inside an
// outer Option. A present cache also remembers a missing key, so repeated
// arms do not search again. map.find is the same native Map ABI as has_key.
fn lower_map_lookup(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, map_place: MIRPlaceID, key_value: MIRValueID, cache_place: MIRPlaceID) Never! {
    map_row :: lower_place_row(c.mir, c.place_rows, map_place) ?? return lower_fail(&m, &f, "MapLookup map place is missing")
    shape :: lower_map_shape(p, map_row.ty) ?? return lower_fail(&m, &f, "MapLookup requires a Map place")
    cache_row :: lower_place_row(c.mir, c.place_rows, cache_place) ?? return lower_fail(&m, &f, "MapLookup cache place is missing")
    slot :: c.place_slots.get(cache_place.value) ?? return lower_fail(&m, &f, "MapLookup cache has no lowered root")
    cached :: lower_slot_root(p, c, &m, &f, slot) ?? return lower_fail(&m, &f, "MapLookup cache is uninitialized")
    lookup_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "MapLookup has no checked type")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    zero :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
    ready :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: ready, condition: LIRCondition.Ne, left: cached, right: zero})
    reuse :: lower_new_block(&f)
    search :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: ready, then_target: lower_target(reuse, [LIRValueID]{}), else_target: lower_target(search, [LIRValueID]{})})
    lower_start(&f, reuse, [LIRValueID]{})
    previous :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: previous, base: cached, offset: 0})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{previous, cached})})
    lower_start(&f, search, [LIRValueID]{})
    map := LIRValueID{value: -1}
    if map_row.base == .Static(name) {
        address :: lower_static_walk(p, c, &m, &f, map_row, name) ?? return
        map = lower_address(&f, address.base, address.offset)
    } else {
        map = lower_receiver_header(p, c, &m, &f, Val(map_place), "MapLookup") ?? return
    }
    key :: lower_use(&m, &f, key_value) ?? return
    found :: lower_word(&f)
    lower_call_helper(&m, &f, "map.find", map_row.ty, [LIRValueID]{map, key}, Val(found))
    present :: lower_flag(&f)
    zero_index :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ge, left: found, right: zero_index})
    hit :: lower_new_block(&f)
    miss :: lower_new_block(&f)
    publish :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
    lower_start(&f, hit, [LIRValueID]{})
    data :: lower_list_data(&f, map)
    entry :: lower_list_address(&f, data, found, shape.stride)
    address :: lower_address(&f, entry, shape.value_offset)
    lookup :: lower_pointer(&f)
    lower_alloc(&m, &f, lookup, 8)
    lower_emit(&f, LIRInst.Store{base: lookup, offset: 0, value: address})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(publish, [LIRValueID]{lookup})})
    lower_start(&f, miss, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(publish, [LIRValueID]{zero})})
    selected :: lower_pointer(&f)
    lower_start(&f, publish, [LIRValueID]{selected})
    outer :: lower_pointer(&f)
    lower_alloc(&m, &f, outer, lower_option_box_size(p, lookup_ty))
    lower_emit(&f, LIRInst.Store{base: outer, offset: 0, value: selected})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{selected, outer})})
    cache :: lower_pointer(&f)
    result :: lower_pointer(&f)
    lower_start(&f, done, [LIRValueID]{result, cache})
    if c.slots[slot].cell {
        // copy: the cache cell is read while the lookup emits into `&f`, so a view into f.cells
        // would be live across those writes.
        cell :: (f.cells[slot].copy()) ?? return lower_fail(&m, &f, "MapLookup cache cell has no storage")
        lower_write_at(p, &f, cell, 0, cache, cache_row.ty)
    } else {
        lower_set_slot(&f, slot, Val(cache))
    }
    // The cache owns its Option box. Owned MIR results need an independent
    // box even though the Ptr payload itself is borrowed from the Map.
    if lower_value_drop(f, dst) != .Trivial -> lower_clone_into(p, &m, &f, result, dst, lookup_ty)
    else -> lower_emit(&f, LIRInst.Move{dst: dst, src: result})
}

// The checked Range declaration supplies the layout consumed by Iter.jet.
fn lower_range_value(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, start: MIRValueID, end: MIRValueID, exclusive: Bool) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Range has no checked type")
    members :: lower_range_members(p, ty) ?? return lower_fail(&m, &f, "Range has no native range layout")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    bounds :: [MIRValueID]{start, end}
    loop (index, bound) in bounds {
        value := lower_use(&m, &f, bound) ?? return
        bound_ty :: lower_value_type(c, bound) ?? return lower_fail(&m, &f, "Range bound has no checked type")
        if lower_is_exact_int(bound_ty) && !lower_is_exact_int(members[index].ty) {
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, value, "jet_int_owned_to_i64", false)
            value = native
        }
        lower_write_at(p, &f, dst, members[index].offset, value, members[index].ty)
    }
    flag :: lower_const_flag(&f, if exclusive -> 1 else -> 0)
    lower_write_at(p, &f, dst, members[2].offset, flag, members[2].ty)
}

// Scopes whose meaning is fully checked before lowering emit nothing, as in
// the Rust emitter (MIRRust.rs `scope_operation_expression`), which calls the
// runtime only for Shield, a Context with a deadline, Unsafe/Policy sentry
// scopes and test scope members. A Shield scope enters and leaves the
// session's nesting Shield depth (jet_rt_session_shield_enter/_leave, the C-ABI
// form of jet_scheduler_shield_enter/_leave): stop points inside it are masked
// and leaving it delivers what arrived meanwhile.
fn lower_scope(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, scope: MIRScopeID, enter: Bool) Never! {
    loop row in c.mir.scopes {
        if row.id == scope {
            label :: row.name ?? "{scope.value}"
            if row.kind == .Context && row.deadline == None -> return
            if row.kind == .Transaction {
                if !enter && row.name != None -> lower_stm_scope_exit(p, c, &m, &f, row)
                return
            }
            if row.kind == {
                .ScopeMember -> return lower_test_scope(p, c, &m, &f, instruction, scope, enter)
                .Context -> return lower_deadline_scope(c, &m, &f, row, enter)
                .Unsafe | .Policy -> return lower_sentry_scope(c, &m, &f, row, enter)
                .Impure | .AssumeDeterministic | .Layout | .DebugOnly | .Live | .Region | .Authority | .Reactive | .TaskGroup -> return
                .Shield -> return lower_call_runtime(&m, &f, if enter -> "jet_rt_session_shield_enter" else -> "jet_rt_session_shield_leave", [LIRValueID]{}, None)
                .StopCleanup -> {
                    if enter {
                        if f.cleanup_scopes.get(scope.value) != None -> return lower_fail(&m, &f, "StopCleanup scope {scope.value} has more than one entry")
                        token :: lower_stop_cleanup_enter(&m, &f)
                        _ := &f.cleanup_scopes.add(scope.value, token)
                    } else {
                        token :: f.cleanup_scopes.get(scope.value) ?? return lower_fail(&m, &f, "StopCleanup scope {scope.value} has no entry")
                        lower_stop_cleanup_leave(&m, &f, token)
                    }
                    return
                }
                else -> return lower_fail(&m, &f, "scope {label} needs runtime support that O0 does not lower yet")
            }
        }
    }
    lower_fail(&m, &f, "scope {scope.value} is missing")
}

fn lower_forward(c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID) Never! {
    if lower_is_absent(f, value) -> return lower_alias_absent(&f, instruction)
    lowered :: lower_use(&m, &f, value) ?? return
    lower_alias(c, &f, instruction, lowered)
}

fn lower_test_scope_text(m: &LowerModule, f: &LowerFunction, text: String?) -> LIRValueID Never! {
    value :: text ?? return lower_require_null(&f)
    descriptor :: lower_static_object(&m, 24)
    lower_require_static_text(&m, descriptor, 0, value)
    pointer :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: pointer, data: descriptor})
    pointer
}

fn lower_test_scope(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, scope: MIRScopeID, enter: Bool) Never! {
    loop block in c.mir.blocks {
        loop candidate_instruction in block.instructions {
            if candidate_instruction.operation == .ScopeEnter(candidate, .Val(member)) {
                if candidate != scope -> next
                publishes :: lower_instruction_has_stop_poll(c, f, instruction)
                return lower_test_scope_member(p, c, &m, &f, scope, member, enter, publishes)
            }
        }
    }
    lower_fail(&m, &f, "test scope has no checked scope member")
}

fn lower_test_scope_member(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, scope: MIRScopeID, member: MIRTestScopeMember, enter: Bool, publishes: Bool) Never! {
    id :: lower_const(&f, Int.from_u64(scope.value))
    if member == {
        .ExpectFail(code, message) -> {
            expected :: lower_test_scope_text(&m, &f, code)
            expected_message :: lower_test_scope_text(&m, &f, message)
            if enter -> return lower_call_runtime(&m, &f, "jet_rt_test_expect_fail_enter_scope", [LIRValueID]{id, expected, expected_message}, None)
            stopped :: lower_pointer(&f)
            lower_call_runtime(&m, &f, "jet_rt_test_expect_fail_leave_scope", [LIRValueID]{id}, Val(stopped))
            absent :: lower_flag(&f)
            null_pointer :: lower_require_null(&f)
            lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: stopped, right: null_pointer})
            unmet :: lower_new_block(&f)
            completed :: lower_new_block(&f)
            join :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(unmet, [LIRValueID]{}), else_target: lower_target(completed, [LIRValueID]{})})
            lower_start(&f, completed, [LIRValueID]{})
            lower_call_runtime(&m, &f, "jet_rt_string_drop", [LIRValueID]{stopped}, None)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{})})
            lower_start(&f, unmet, [LIRValueID]{})
            status :: lower_word(&f)
            lower_call_runtime(&m, &f, "jet_rt_session_status", [LIRValueID]{}, Val(status))
            pending :: lower_flag(&f)
            zero_word :: lower_const(&f, 0)
            lower_emit(&f, LIRInst.Compare{dst: pending, condition: LIRCondition.Ne, left: status, right: zero_word})
            failed :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: pending, then_target: lower_target(join, [LIRValueID]{}), else_target: lower_target(failed, [LIRValueID]{})})
            lower_start(&f, failed, [LIRValueID]{})
            saved :: lower_word(&f)
            if publishes -> lower_call_runtime(&m, &f, "jet_rt_poll_call_enter", [LIRValueID]{}, Val(saved))
            lower_call_runtime(&m, &f, "jet_rt_test_expect_fail_unmet", [LIRValueID]{expected, expected_message}, None)
            if publishes -> lower_call_runtime(&m, &f, "jet_rt_poll_call_leave", [LIRValueID]{saved}, None)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{})})
            return lower_start(&f, join, [LIRValueID]{})
        }
        .Timeout(duration) -> {
            if enter {
                ty :: lower_value_type(c, duration) ?? return lower_fail(&m, &f, "test timeout has no checked Duration")
                source :: lower_use(&m, &f, duration) ?? return
                exact := source
                found := false
                loop field in lower_inline_members(p, ty) {
                    if field.name != "ns" -> next
                    exact = lower_word(&f)
                    lower_emit(&f, LIRInst.Load{dst: exact, base: source, offset: field.offset})
                    found = true
                }
                if !found -> return lower_fail(&m, &f, "test timeout Duration has no inline ns field")
                nanos :: lower_word(&f)
                lower_convert_exact(&m, &f, nanos, exact, "jet_int_owned_to_i64", false)
                return lower_call_runtime(&m, &f, "jet_rt_test_timeout_enter", [LIRValueID]{id, nanos}, None)
            }
            output :: lower_pointer(&f)
            lower_emit(&f, LIRInst.StackSlot{dst: output, size: 16, align: 8})
            present :: lower_flag(&f)
            lower_call_runtime(&m, &f, "jet_rt_test_timeout_leave", [LIRValueID]{id, output}, Val(present))
            check :: lower_new_block(&f)
            failed :: lower_new_block(&f)
            join :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(check, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{})})
            lower_start(&f, check, [LIRValueID]{})
            elapsed :: lower_word(&f)
            limit :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: elapsed, base: output, offset: 0})
            lower_emit(&f, LIRInst.Load{dst: limit, base: output, offset: 8})
            expired :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: expired, condition: LIRCondition.Gt, left: elapsed, right: limit})
            lower_seal(&f, LIRTerminator.Branch{condition: expired, then_target: lower_target(failed, [LIRValueID]{}), else_target: lower_target(join, [LIRValueID]{})})
            lower_start(&f, failed, [LIRValueID]{})
            saved :: lower_word(&f)
            if publishes -> lower_call_runtime(&m, &f, "jet_rt_poll_call_enter", [LIRValueID]{}, Val(saved))
            lower_call_runtime(&m, &f, "jet_rt_test_timeout_failure", [LIRValueID]{elapsed, limit}, None)
            if publishes -> lower_call_runtime(&m, &f, "jet_rt_poll_call_leave", [LIRValueID]{saved}, None)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{})})
            return lower_start(&f, join, [LIRValueID]{})
        }
        .Skip(whole_test) -> {
            if !enter {
                skip_flag :: lower_const_flag(&f, if whole_test -> 1 else -> 0)
                lower_call_runtime(&m, &f, "jet_rt_test_skip_scope", [LIRValueID]{skip_flag}, None)
            }
        }
        // Like the reference MIR emitter, Measure has no scope runtime action.
        .Measure -> {}
    }
}

fn lower_constant(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, constant: MIRConstant) Never! {
    if instruction.result == .Val(result) {
        if c.static_text.elided.get(result.value) ?? false -> return lower_alias_absent(&f, instruction)
        if c.fixed_literals.get(result.value) != None -> return lower_alias_absent(&f, instruction)
    }
    if constant == .Unit -> return lower_alias_absent(&f, instruction)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    ty :: lower_checked_type(c, instruction) ?? return
    if lower_wide_signed(p, ty) != None -> return lower_constant_into(p, c, &m, &f, instruction, constant, dst)
    if constant == {
        .Int(value, _, _) -> {
            exact :: if instruction.ty != None -> lower_is_exact_int(ty) else -> false
            if exact -> lower_exact_int_constant(&m, &f, dst, value)
            else -> lower_emit(&f, LIRInst.Const{dst: dst, value: value})
        }
        .BigInt(decimal) -> {
            if lower_is_unsigned_word(ty) -> return lower_constant_into(p, c, &m, &f, instruction, constant, dst)
            exact :: if instruction.ty != None -> lower_is_exact_int(ty) else -> false
            if !exact -> return lower_fail(&m, &f, "BigInt constant of a non-Int type is not lowered at O0 yet")
            lower_big_int_constant(&m, &f, dst, decimal)
        }
        .Bool(value) -> lower_emit(&f, LIRInst.Const{dst: dst, value: if value -> 1 else -> 0})
        .Char(value) -> lower_emit(&f, LIRInst.Const{dst: dst, value: value})
        .Float(value, f32, _) -> lower_emit(&f, LIRInst.Const{dst: dst, value: lower_float_constant_bits(value, f32)})
        .String(value) -> lower_emit(&f, LIRInst.DataAddress{dst: dst, data: lower_immortal_text(&m, value)})
        else -> lower_constant_into(p, c, &m, &f, instruction, constant, dst)
    }
}

fn lower_int_inline(value: Int) -> Bool Never! {
    value >= -4611686018427387904 && value <= 4611686018427387903
}

fn lower_copy(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID) Never! {
    if lower_is_absent(f, value) -> return lower_alias_absent(&f, instruction)
    source :: lower_use(&m, &f, value) ?? return
    ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "copied value {value.value} has no checked type")
    // A View<T> copied into a List (Copy materialize_view, MIRRust.rs
    // `.to_vec()`) gets a buffer of its own: list.unique copies the window's
    // elements (List clone glue would share the window header).
    if lower_view_element(ty) != None {
        if lower_checked_type(c, instruction) == .Val(list_ty) {
            if list_ty.kind == .List(_) {
                dst :: lower_result(p, c, &m, &f, instruction) ?? return
                lower_storage_into(p, &f, dst, list_ty)
                lower_copy_bytes(&f, dst, 0, source, 0, 24)
                return lower_list_make_unique(p, &m, &f, dst, list_ty)
            }
        }
    }
    repr :: lower_repr_of(p, &f, ty)
    if repr == {
        .ExactInt | .Handle(_, _) | .Boxed(_) -> { if !lower_value_owned(c, instruction.result ?? value) -> return lower_alias(c, &f, instruction, source) }
        // Dropless inline by-value copies still snapshot their bytes.
        .Inline(_) -> { if !lower_read_owns(p, c, m, instruction, ty) -> return lower_alias(c, &f, instruction, source) }
        else -> return lower_alias(c, &f, instruction, source)
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_clone_into(p, &m, &f, source, dst, ty)
}

// Defines `dst` as an owned copy of the borrowed `source` of `ty`: a runtime
// clone for a handle, clone glue for a box, new storage filled by clone glue
// for an inline aggregate, the same bits for anything else.
fn lower_clone_into(p: MIRProgram, m: &LowerModule, f: &LowerFunction, source: LIRValueID, dst: LIRValueID, ty: MIRType) Never! {
    if lower_repr(p, ty) == {
        .ExactInt -> lower_call_runtime(&m, &f, "jet_rt_int_clone", [LIRValueID]{source}, Val(dst))
        .Handle(_, clone) -> {
            if clone == "" -> return lower_fail(&m, &f, "{mir_type_display_name(ty)} cannot be copied")
            lower_call_runtime(&m, &f, clone, [LIRValueID]{source}, Val(dst))
        }
        .Boxed(box_ty) -> lower_call_clone_glue(&m, &f, box_ty, source, dst)
        .Inline(aggregate) -> {
            lower_storage_into(p, &f, dst, aggregate)
            lower_inline_clone(p, &m, &f, source, dst, aggregate)
        }
        else -> lower_emit(&f, LIRInst.Copy{dst: dst, src: source})
    }
}

fn lower_drop_value(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID) Never! {
    if lower_is_absent(f, value) -> return
    lowered :: lower_use(&m, &f, value) ?? return
    cell_slot := -1
    if lower_slot_of_value(c, value) == .Val(slot) {
        if c.slots[slot].cell {
            cell_slot = slot
        } else {
            // copy: the held value is read while the drop writes `&f` (f.current is cleared below),
            // so a view into f.current would be live across that write.
            held :: f.current[slot].copy()
            if held == .Val(holding) {
                if holding == lowered -> lower_clear_slot(p, c, &f, slot)
            }
        }
    }
    owned_ty := MIRType?{None}
    if lower_value_type(c, value) == .Val(ty) {
        if lower_value_owned(c, value) -> owned_ty = Val(ty)
    }
    if owned_ty == None && lower_value_drop(f, lowered) == .Trivial -> return
    // The cell is cleared while it still holds the value, before the drop
    // ends the value's life (its comparison reads the value). An inline
    // aggregate's value is the cell's own storage: that cell clears after.
    inline_cell :: cell_slot >= 0 && lower_is_inline(p, c.slots[cell_slot].ty)
    if cell_slot >= 0 && !inline_cell -> lower_cell_dropped(p, c, &f, cell_slot, lowered)
    if owned_ty == .Val(ty) {
        if !lower_partial_drop_value(p, c, &m, &f, value, lowered, ty) {
            if lower_close_receiver_value(c, f, value) -> lower_close_value_drop(p, &m, &f, lowered, ty, true) else -> lower_map_drop_value(p, &m, &f, lowered, ty)
        }
    } else {
        lower_emit(&f, LIRInst.Drop{value: lowered})
    }
    if inline_cell -> lower_cell_dropped(p, c, &f, cell_slot, lowered)
}

// ---------------------------------------------------------------------------
// Places.

// Reading or moving a root place names its current value (inline aggregates
// included: a later write rebinds the slot, it never overwrites the storage).
// Moving an inline member out of a projection copies it to storage of its
// own first, since its bytes in the parent are then zeroed. A cell slot's
// places are read from memory like projections (Closures.jet).
fn lower_read_place(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, place: MIRPlaceID, moving: Bool) Never! {
    row :: lower_place_row(c.mir, c.place_rows, place) ?? return lower_fail(&m, &f, "place {place.value} is missing")
    if lower_repr_of(p, &f, row.ty) == .Absent -> return lower_alias_absent(&f, instruction)
    inline :: lower_inline_of(p, &f, row.ty)
    if moving && row.projections.len() > 0 && !lower_projected_move_supported(&m, &f, row.projections) -> return
    walk := LowerFieldAddress{base: LIRValueID{value: -1}, offset: 0}
    if row.base == .Static(name) {
        walk = lower_static_walk(p, c, &m, &f, row, name) ?? return
    } else {
        slot :: c.place_slots.get(place.value) ?? return lower_fail(&m, &f, "place {place.value} has no lowered root")
        if c.slots[slot].cell {
            walk = lower_cell_walk(p, c, &m, &f, slot, row) ?? return
        } else {
            // copy: the held value is read while the place read writes `&f` (a move clears
            // f.current), so a view into f.current would be live across that write.
            held :: f.current[slot].copy()
            root :: held ?? return lower_fail(&m, &f, "place {place.value} has no value")
            if row.projections.len() == 0 {
                if !moving && lower_read_owns(p, c, m, instruction, row.ty) {
                    dst :: lower_result(p, c, &m, &f, instruction) ?? return
                    return lower_clone_into(p, &m, &f, root, dst, row.ty)
                }
                lower_alias(c, &f, instruction, root)
                if moving -> lower_clear_slot(p, c, &f, slot)
                return
            }
            // A move out of an element or payload detaches the buffers and
            // boxes it passes (write walk), the slot's own box included.
            walk_root :: if moving -> (lower_slot_root_for_write(p, c, &m, &f, slot) ?? return) else -> root
            walked :: lower_walk_place(p, c, &m, &f, walk_root, c.slots[slot].ty, row.projections, moving) ?? return
            if moving && walked.borrowed {
                // A runtime handle lends its fields (lower_handle_field_place):
                // a last-use move out of one copies the field, which the
                // handle keeps and releases with itself.
                dst :: lower_result(p, c, &m, &f, instruction) ?? return
                layout :: lower_repr_layout(lower_repr_of(p, &f, row.ty)) ?? return
                lent :: lower_new_value(&f, layout, LIRDrop.Trivial, row.ty.identity)
                lower_read_into(p, &f, lent, walked.address.base, walked.address.offset, row.ty)
                return lower_clone_into(p, &m, &f, lent, dst, row.ty)
            }
            walk = walked.address
        }
    }
    if !moving && !lower_read_owns(p, c, m, instruction, row.ty) {
        // Neither stored, returned nor consumed: the read borrows the
        // projected value, exactly as a root read aliases its slot, so its
        // carrier has no drop glue and only the owner drops it. An Owned
        // result (a map or list element read for `print(m[k])`) given the
        // owner's glue here was dropped twice: once at its last use, once
        // with the owner (MIRRust.rs place_read clones instead).
        ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "MIR value read from place {place.value} has no checked type")
        repr :: lower_repr_of(p, &f, ty)
        if repr == .Unsupported(reason) -> return lower_fail(&m, &f, "{reason} is not lowered at O0 yet")
        layout :: lower_repr_layout(repr) ?? return
        borrowed :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
        lower_read_into(p, &f, borrowed, walk.base, walk.offset, row.ty)
        return lower_alias(c, &f, instruction, borrowed)
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if moving && inline {
        size :: lower_size_of(p, &f, row.ty).size
        lower_storage_into(p, &f, dst, row.ty)
        lower_copy_bytes(&f, dst, 0, walk.base, walk.offset, size)
    } else if !moving {
        layout :: lower_repr_layout(lower_repr_of(p, &f, row.ty)) ?? return
        held :: lower_new_value(&f, layout, LIRDrop.Trivial, row.ty.identity)
        lower_read_into(p, &f, held, walk.base, walk.offset, row.ty)
        lower_clone_into(p, &m, &f, held, dst, row.ty)
    } else {
        lower_read_into(p, &f, dst, walk.base, walk.offset, row.ty)
    }
    if moving {
        lower_partial_transfer(&f, instruction)
        lower_clear_at(p, &f, walk.base, walk.offset, row.ty)
    }
}

// A read (not a move) of a place whose owned result is stored into another
// place or aggregate or returned is a copy of its own, as MIRRust.rs
// place_read's `.clone()`; otherwise the read borrows the place's value. A
// read the release plan makes an owner (lower_release_owning_read) copies too.
// An inline aggregate's value is a pointer to its bytes, so a stored read of
// one owns a copy even when it has no drop glue: a field write through the
// source writes those bytes in place, and an alias would see it
// (`resume := builder.current; builder.current = builder.entry; ...;
// builder.current = resume` restored the entry block).
fn lower_read_owns(p: MIRProgram, c: LowerContext, m: LowerModule, instruction: MIRInstruction, ty: MIRType) -> Bool Never! {
    result :: instruction.result ?? return false
    if c.releases.owned_reads.get(result.value) != None -> return true
    if c.sunk.get(result.value) == None -> return false
    lower_value_owned(c, result) && (lower_needs_drop(p, m, ty) || lower_is_inline(p, ty))
}

// The operands an operation moves into the aggregate it builds.
fn lower_stored_operands(operation: MIROperation) -> [MIRValueID] Never! {
    stored := [MIRValueID]{}
    if operation == {
        .BuildList(values, _) -> { loop value in values -> &stored.push(value) }
        .BuildMap(entries) -> {
            loop entry in entries {
                &stored.push(entry.key)
                &stored.push(entry.value)
            }
        }
        .Struct(_, fields) | .Tuple(_, fields) -> { loop field in fields -> &stored.push(field.value) }
        .Enum(_, _, args) -> { loop arg in args -> &stored.push(arg.value) }
        .Present(value) | .ResultOk(value) | .ResultErr(value) | .TraitBox(value, _) -> &stored.push(value)
        // A record literal moves its field values into the struct like `Struct`.
        .Semantic(semantic) -> {
            if semantic == .StructLiteral(_, fields, _, _) {
                loop field in fields -> &stored.push(field.value)
            }
            if semantic == .ReflectOf(_, _, display, _) -> &stored.push(display)
        }
        .Closure(_, captures, _) -> {
            loop capture in captures {
                if capture == .Value(value) -> &stored.push(value)
            }
        }
        else -> {}
    }
    stored
}

// A root write rebinds the slot to the written value (an inline aggregate's
// pointer: back edges copy it into the slot's storage, lower_edge), after
// publishing the new value before consuming the detached old owner for
// ReplacePlace; a Write parameter moves into the caller's storage. A cell's places are
// written in memory like projections. `replace` releases the overwritten
// value first: a ReplacePlace, or a WritePlace the release plan lets drop it
// as a Rust assignment does (lower_release_write_drops); `guard` releases a
// root slot's value only when it is not the slot's null placeholder.
fn lower_write_place(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, place: MIRPlaceID, value: MIRValueID, replace: Bool, guard: Bool) Never! {
    row :: lower_place_row(c.mir, c.place_rows, place) ?? return lower_fail(&m, &f, "place {place.value} is missing")
    if row.base == .Static(name) {
        if lower_is_absent(f, value) -> return
        stored :: lower_use(&m, &f, value) ?? return
        walk :: lower_static_walk(p, c, &m, &f, row, name) ?? return
        if replace -> lower_drop_stored(p, &m, &f, walk.base, walk.offset, row.ty)
        lower_close_transfer(c, &f, value)
        return lower_write_at(p, &f, walk.base, walk.offset, stored, row.ty)
    }
    slot :: c.place_slots.get(place.value) ?? return lower_fail(&m, &f, "place {place.value} has no lowered root")
    if lower_is_absent(f, value) -> return
    lowered :: lower_use(&m, &f, value) ?? return
    if lower_map_index_write(p, c, &m, &f, slot, row, lowered) -> return
    if c.slots[slot].cell {
        walk :: lower_cell_walk(p, c, &m, &f, slot, row) ?? return
        prefix :: lower_partial_field_path(p, c.slots[slot].ty, row.projections) ?? [LowerGlueField]{}
        receiver :: lower_close_receiver_slot(c, f, slot) && row.projections.len() == 0
        if replace -> lower_partial_drop_stored(p, &m, &f, "slot.{slot}", prefix, walk.base, walk.offset, row.ty, receiver)
        lower_close_transfer(c, &f, value)
        lower_write_at(p, &f, walk.base, walk.offset, lowered, row.ty)
        if row.projections.len() == 0 -> lower_partial_assign(&f, "slot.{slot}", lower_partial_owner(c, value))
        else -> lower_partial_reset(&f, "slot.{slot}", prefix)
        return
    }
    // copy: the previous value is read while the write replaces f.current[slot] and emits into
    // `&f`, so a view of that slot would be live across the write.
    held :: f.current[slot].copy()
    if row.projections.len() == 0 {
        if c.slots[slot].write_param >= 0 {
            // Publish both physical and local ownership before Close re-entry.
            // copy: the write parameter's pointer is read while the store emits into `&f`, so a
            // view into f.params would be live across those writes.
            address :: (f.params[c.slots[slot].write_param].copy()) ?? return lower_fail(&m, &f, "Write parameter of place {place.value} has no pointer")
            receiver :: lower_close_receiver_slot(c, f, slot)
            if replace -> lower_partial_drop_stored(p, &m, &f, "slot.{slot}", [LowerGlueField]{}, address, 0, row.ty, receiver)
            lower_close_transfer(c, &f, value)
            lower_write_at(p, &f, address, 0, lowered, row.ty)
            lower_partial_assign(&f, "slot.{slot}", lower_partial_owner(c, value))
            if lower_is_inline(p, row.ty) -> return lower_set_slot(&f, slot, Val(address))
        } else if replace && lower_is_owned(c.slots[slot].ownership) {
            if held == .Val(old) && old != lowered {
                receiver :: lower_close_receiver_slot(c, f, slot)
                done := LIRBlockID?{None}
                if guard {
                    layout :: lower_value_layout(f, old)
                    null :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
                    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
                    absent :: lower_flag(&f)
                    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: old, right: null})
                    body :: lower_new_block(&f)
                    skip :: lower_new_block(&f)
                    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(skip, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
                    lower_start(&f, body, [LIRValueID]{})
                    done = Val(skip)
                }
                if !lower_partial_drop_owned(p, &m, &f, "slot.{slot}", [LowerGlueField]{}, old, row.ty, true, receiver) {
                    if receiver -> lower_close_value_drop(p, &m, &f, old, row.ty, true)
                    else if lower_is_inline(p, row.ty) -> lower_inline_drop(p, &m, &f, old, row.ty)
                    else if lower_value_drop(f, old) != .Trivial -> lower_emit(&f, LIRInst.Drop{value: old})
                }
                if done == .Val(skip) {
                    lower_seal(&f, LIRTerminator.Jump{target: lower_target(skip, [LIRValueID]{})})
                    lower_start(&f, skip, [LIRValueID]{})
                }
            }
        }
        lower_close_transfer(c, &f, value)
        lower_set_slot(&f, slot, Val(lowered))
        lower_partial_assign(&f, "slot.{slot}", lower_partial_owner(c, value))
        return
    }
    if held == None -> return lower_fail(&m, &f, "field of place {place.value} is written before the place has a value")
    root :: lower_slot_root_for_write(p, c, &m, &f, slot) ?? return
    walk :: lower_walk_projections(p, c, &m, &f, root, c.slots[slot].ty, row.projections) ?? return
    if replace -> lower_drop_stored(p, &m, &f, walk.base, walk.offset, row.ty)
    lower_write_at(p, &f, walk.base, walk.offset, lowered, row.ty)
    if f.partial_drops.len() != 0 {
        if lower_partial_field_path(p, c.slots[slot].ty, row.projections) == .Val(path) -> lower_partial_reset(&f, "slot.{slot}", path)
    }
}

// `[T#N]{ uninit }` the List of its N slots, without
// writing any payload; sema admits reads only after every slot is written.
// Any other uninit place needs no storage before its first write.
fn lower_initialize_uninit(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, place: MIRPlaceID) Never! {
    row :: lower_place_row(c.mir, c.place_rows, place) ?? return lower_fail(&m, &f, "place {place.value} is missing")
    fixed := false
    count := -1
    elem := row.ty
    if row.ty.kind == .FixedList(inner, len) {
        fixed = true
        elem = inner
        if len == .Literal(_, value) -> count = value
    }
    if !fixed -> return
    if count < 0 || row.projections.len() != 0 || row.base == .Static(_) -> return lower_fail(&m, &f, "uninit {mir_type_display_name(row.ty)} of this shape is not lowered at O0 yet")
    slot :: c.place_slots.get(place.value) ?? return lower_fail(&m, &f, "place {place.value} has no lowered root")
    header := LIRValueID?{None}
    if c.slots[slot].cell {
        // copy: the cell header is read while initialization emits into `&f`, so a view into
        // f.cells would be live across those writes.
        header = f.cells[slot].copy()
    } else if c.slots[slot].write_param >= 0 {
        // copy: the write parameter's pointer is read while initialization emits into `&f`, so a
        // view into f.params would be live across those writes.
        header = f.params[c.slots[slot].write_param].copy()
    } else {
        header = Val(lower_new_storage(p, &f, row.ty))
    }
    storage :: header ?? return lower_fail(&m, &f, "uninit {mir_type_display_name(row.ty)} has no checked cell storage")
    length :: lower_const(&f, count)
    data :: lower_list_buffer(&m, &f, length, lower_list_stride(p, elem))
    lower_emit(&f, LIRInst.Store{base: storage, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: storage, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: storage, offset: 16, value: data})
    lower_set_slot(&f, slot, Val(storage))
}

struct LowerFieldAddress {
    base: LIRValueID
    offset: Int
}

struct LowerFieldInfo {
    offset: Int
    ty: MIRType
    // A recursive edge: the field holds a pointer to a wrapper box.
    boxed: Bool
}

// Every stored field and payload member sits at its natural offset
// (Values.jet). A computed field is a getter, not storage, and has no offset
// (MIRRust.rs struct emission, :8134, declares only `!field.computed` fields).
fn lower_stored_fields(fields: [MIRField]) -> [MIRField] Never! {
    stored := [MIRField]{}
    loop field in fields {
        if !field.computed -> &stored.push(field)
    }
    stored
}

fn lower_struct_field(p: MIRProgram, ty: MIRType, field: MIRFieldID) -> LowerFieldInfo? {
    aggregate :: lower_inline_type(p, ty) ?? return None
    loop member in lower_inline_members(p, aggregate) {
        if member.id == field -> return Val(LowerFieldInfo{offset: member.offset, ty: member.ty, boxed: member.boxed})
    }
    None
}

fn lower_field(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, base: MIRValueID, field: MIRFieldID) Never! {
    aggregate :: lower_use(&m, &f, base) ?? return
    ty :: lower_value_type(c, base) ?? return lower_fail(&m, &f, "field base {base.value} has no checked type")
    if lower_native_err_type(p, ty) -> return lower_native_err_field(p, c, &m, &f, instruction, base, aggregate, ty, field)
    found :: lower_struct_field_of(p, &f, ty, field) ?? {
        // A field read in place inside a runtime handle (Places.jet).
        place :: lower_handle_field_place(p, &m, &f, aggregate, ty, field) ?? return lower_fail(&m, &f, "field {field.value} is not a field of {mir_type_display_name(ty)}")
        if c.fact_index.get(lower_move_root(c, base).value) == .Val(index) {
            if c.mir.values[index].ownership.mode == MIROwnershipMode.Move -> return lower_fail(&m, &f, "moving out of a field of runtime handle is not lowered at O0 yet")
        }
        if lower_repr(p, place.ty) == .Absent -> return lower_alias_absent(&f, instruction)
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        // The handle keeps a lent field even when its carrier dies here
        // (lower_payload_takes): an owned result is a copy of it.
        taken :: if instruction.result == .Val(result) -> c.payload_takes.get(result.value) != None else -> false
        if taken && lower_value_owned(c, instruction.result ?? base) && lower_needs_drop_of(p, m, &f, place.ty) {
            layout :: lower_repr_layout(lower_repr_of(p, &f, place.ty)) ?? return
            lent :: lower_new_value(&f, layout, LIRDrop.Trivial, place.ty.identity)
            lower_read_into(p, &f, lent, place.address.base, place.address.offset, place.ty)
            return lower_clone_into(p, &m, &f, lent, dst, place.ty)
        }
        return lower_read_member(p, c, &m, &f, instruction, base, dst, place.address.base, place.address.offset, place.ty)
    }
    if lower_repr(p, found.ty) == .Absent -> return lower_alias_absent(&f, instruction)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    address :: lower_struct_storage_address(&f, aggregate, found)
    // A boxed edge's member lives in its wrapper box; a borrowed aggregate
    // may itself live in boxes (lower_read_box_member checks them all).
    holders :: if found.boxed -> [LIRValueID]{address.base} else -> [LIRValueID]{}
    lower_read_box_member(p, c, &m, &f, instruction, base, dst, holders, address.base, address.offset, found.ty)
}

// ---------------------------------------------------------------------------
// Boxes: payload enums, Options and Results.

fn lower_alloc(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, bytes: Int) Never! {
    lower_alloc_bytes(&m, &f, dst, bytes)
}

fn lower_store_value(p: MIRProgram, m: &LowerModule, f: &LowerFunction, base: LIRValueID, offset: Int, value: MIRValueID, ty: MIRType) Never! {
    if lower_is_absent(f, value) -> return
    // Fixed-width fields remain raw LIR words even when a call produced them.
    // Never retain their bits as exact-Int pointers (#4383); clone/drop glue
    // instead uses the checked field type, not the shared word-sized layout.
    lowered :: lower_use(&m, &f, value) ?? return
    lower_write_at(p, &f, base, offset, lowered, ty)
}

fn lower_store_word(f: &LowerFunction, boxed: LIRValueID, offset: Int, value: Int) Never! {
    word :: lower_const(&f, value)
    lower_emit(&f, LIRInst.Store{base: boxed, offset: offset, value: word})
}

fn lower_variant(definition: MIRTypeDef, name: String) -> (index: Int, variant: MIRVariant)? {
    if definition.kind == .Enum(variants, _) {
        loop (index, variant) in variants {
            if variant.name == name -> return Val((index: index, variant: variant))
        }
    }
    None
}

// The internal tag of a variant is its declaration ordinal within its checked
// enum, so distinct variants never share a tag; an authored numeric value
// (`First = 1`) belongs to explicit numeric conversion only.
fn lower_discriminant(index: Int) -> Int Never! {
    index
}

fn lower_enum_is(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, subject: MIRValueID, owner: MIRTypeID, variant: String) Never! {
    ty :: lower_value_type(c, subject) ?? return lower_fail(&m, &f, "enum subject has no checked type")
    if !lower_native_enum_layout(p, ty) -> return lower_fail(&m, &f, "opaque runtime enum {mir_type_display_name(ty)} has no native enum layout")
    definition :: lower_type_def_by_id(p, owner) ?? return lower_fail(&m, &f, "enum type {owner.value} is missing")
    found :: lower_variant(definition, variant) ?? return lower_fail(&m, &f, "{definition.name} has no variant {variant}")
    value :: lower_use(&m, &f, subject) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    discriminant := value
    if lower_value_layout(f, value) == lir_layout_pointer() {
        discriminant = lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: discriminant, base: value, offset: 0})
    }
    expected :: lower_const(&f, lower_discriminant(found.index))
    lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: discriminant, right: expected})
}

// The payload of type the instruction's result at byte `offset` of the box
// `subject` (an inline payload is its address in the box).
fn lower_load_payload(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, subject: MIRValueID, offset: Int) Never! {
    boxed :: lower_use(&m, &f, subject) ?? return
    ty :: lower_checked_type(c, instruction) ?? return lower_alias_absent(&f, instruction)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_read_box_member(p, c, &m, &f, instruction, subject, dst, [LIRValueID]{boxed}, boxed, offset, ty)
}

// Whether reading `owner`'s member moves it out (the owner is moved, or an
// owned carrier with no later use surrenders its payload, as the MIRRust.rs
// payload arm moves it out, a non-Clone handle included).
fn lower_member_moves(c: LowerContext, instruction: MIRInstruction, owner: MIRValueID) -> Bool Never! {
    if c.fact_index.get(lower_partial_root_value(c, owner).value) == .Val(index) {
        if c.mir.values[index].ownership.mode == MIROwnershipMode.Move -> return true
    }
    if instruction.result == .Val(taken) {
        if c.payload_takes.get(taken.value) != None && lower_value_owned(c, owner) -> return true
    }
    false
}

// Reads the member of type `ty` at base + offset of the value `owner` (a
// field, payload or variant payload). An owned member out of an owner that
// was not moved out of its place is a copy of its own: the owner (a read
// place, or the value a `Move` passes on) still owns and drops the original
// (MIRRust.rs place_read clones the read owner before projecting). That
// holds whether or not the member is stored: an owned `t.label` printed and
// then dropped must not release the label `t` still holds.
// Moving an owned member transfers its bytes before the wrapper can be
// released. In particular an inline List header must not remain an address
// into an Option/Result/enum box: a root write can defer reading those bytes
// until a loop back edge. Clear the transferred member, not the wrapper's
// other fields, so its drop releases only the remaining owners.
fn lower_read_member(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, owner: MIRValueID, dst: LIRValueID, base: LIRValueID, offset: Int, ty: MIRType) Never! {
    if !lower_atomic_check_offset(p, &m, &f, ty, offset) -> return
    moved :: lower_member_moves(c, instruction, owner)
    owned_result :: if instruction.result == .Val(value) -> lower_value_owned(c, value) && lower_needs_drop_of(p, m, &f, ty) else -> false
    if !moved && owned_result {
        layout :: lower_repr_layout(lower_repr_of(p, &f, ty)) ?? return
        held :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
        lower_read_into(p, &f, held, base, offset, ty)
        return lower_clone_into(p, &m, &f, held, dst, ty)
    }
    result :: instruction.result ?? return
    if moved && lower_value_owned(c, result) {
        if lower_inline_of(p, &f, ty) {
            size :: lower_size_of(p, &f, ty).size
            lower_storage_into(p, &f, dst, ty)
            lower_copy_bytes(&f, dst, 0, base, offset, size)
        } else {
            lower_read_into(p, &f, dst, base, offset, ty)
        }
        lower_partial_transfer(&f, instruction)
        lower_clear_at(p, &f, base, offset, ty)
        return
    }
    lower_read_into(p, &f, dst, base, offset, ty)
}

// The boxes holding the storage of `value` when it is a borrowed projection
// (lower_partial_root_value's chain): each OptionValue/ResultValue/
// EnumPayload subject box and each boxed field's wrapper between `value`
// and its owned root. Empty for a value with storage of its own.
fn lower_borrowed_box_hops(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID) -> [LIRValueID] Never! {
    hops := [LIRValueID]{}
    root := lower_move_root(c, value)
    loop !lower_value_owned(c, root) {
        next_root := MIRValueID?{None}
        loop block in c.mir.blocks {
            loop instruction in block.instructions {
                if instruction.result != Val(root) -> next
                if instruction.operation == {
                    .OptionValue(base) | .ResultValue(base, _) | .EnumPayload(base, _, _, _) -> {
                        ty :: lower_value_type(c, base) ?? return hops
                        if lower_repr(p, ty) == .Boxed(_) {
                            holder :: lower_use(&m, &f, base) ?? return hops
                            &hops.push(holder)
                        }
                        next_root = Val(base)
                    }
                    .Field(base, field) -> {
                        ty :: lower_value_type(c, base) ?? return hops
                        found :: lower_struct_field_of(p, &f, ty, field) ?? return hops
                        if found.boxed {
                            aggregate :: lower_use(&m, &f, base) ?? return hops
                            wrapper :: lower_pointer(&f)
                            lower_emit(&f, LIRInst.Load{dst: wrapper, base: aggregate, offset: found.offset})
                            &hops.push(wrapper)
                        }
                        next_root = Val(base)
                    }
                    else -> return hops
                }
            }
        }
        parent :: next_root ?? return hops
        root = lower_move_root(c, parent)
    }
    hops
}

// Whether `ty` reaches a member no owner can copy: a Close owner, a runtime
// handle without clone, or an atomic; once per type for the whole module
// (by the checked identity when the type has one, else by its identity key,
// the same partition mir_type_identity_key spells). A fresh
// lower_contains_uncopyable walk answers exactly that reachability (its
// `seen` set only cuts cycles, and the cached answers it consults are
// earlier walks' own), so the cached answer is the walk's own.
fn lower_type_contains_uncopyable(p: MIRProgram, m: &LowerModule, ty: MIRType) -> Bool Never! {
    seen := [String:Bool]{}
    cuts := 0
    found :: lower_contains_uncopyable(p, &m, ty, &seen, &cuts)
    lower_contains_uncopyable_record(&m, ty, mir_type_identity_key(ty), found)
    found
}

// The walk behind lower_type_contains_uncopyable, cached as
// lower_contains_close caches: a type it settles (found, or its whole
// closure explored without a cut) enters the module cache.
fn lower_contains_uncopyable(p: MIRProgram, m: &LowerModule, ty: MIRType, seen: &[String:Bool], cuts: &Int) -> Bool Never! {
    if ty.identity == .Val(identity) {
        if m.contains_uncopyable_ids.get(identity.value) == .Val(known) -> return known
    }
    key :: mir_type_identity_key(ty)
    if ty.identity == None {
        if m.contains_uncopyable.get(key) == .Val(known) -> return known
    }
    if seen.get(key) != None {
        cuts += 1
        return false
    }
    &seen.add(key, true).drop("first visit")
    before :: cuts
    found :: lower_contains_uncopyable_walk(p, &m, ty, &seen, &cuts)
    if found || cuts == before -> lower_contains_uncopyable_record(&m, ty, key, found)
    found
}

fn lower_contains_uncopyable_record(m: &LowerModule, ty: MIRType, key: String, found: Bool) Never! {
    if ty.identity == .Val(identity) {
        if m.contains_uncopyable_ids.get(identity.value) == None -> &m.contains_uncopyable_ids.add(identity.value, found).drop("checked absent above")
        return
    }
    if m.contains_uncopyable.get(key) == None -> &m.contains_uncopyable.add(key.copy(), found).drop("checked absent above")
}

fn lower_contains_uncopyable_walk(p: MIRProgram, m: &LowerModule, ty: MIRType, seen: &[String:Bool], cuts: &Int) -> Bool Never! {
    if lower_close_method(p, m.close_methods, ty) != None -> return true
    if lower_atomic_scalar(p, ty) != None -> return true
    if lower_repr(p, ty) == .Handle(_, clone) {
        if clone == "" -> return true
    }
    if ty.kind == {
        .Tagged(_, inner) | .Option(inner) | .List(inner) | .FixedList(inner, _) -> {
            if lower_contains_uncopyable(p, &m, inner, &seen, &cuts) -> return true
        }
        .Result(ok, err) | .Map(ok, err) -> {
            if lower_contains_uncopyable(p, &m, ok, &seen, &cuts) || lower_contains_uncopyable(p, &m, err, &seen, &cuts) -> return true
        }
        else -> {}
    }
    if lower_is_inline(p, ty) {
        loop member in lower_inline_members(p, ty) {
            if lower_contains_uncopyable(p, &m, member.ty, &seen, &cuts) -> return true
        }
    } else if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Enum(variants, _) {
            loop variant in variants {
                loop member in lower_variant_members(p, definition, variant) {
                    if lower_contains_uncopyable(p, &m, member.ty, &seen, &cuts) -> return true
                }
            }
        }
    }
    false
}

// lower_read_member for a member stored at base + offset where `holders`
// are the boxes containing that storage directly (a payload's box, a boxed
// edge's wrapper), to which the boxes of a borrowed owner's projection chain
// are added (lower_borrowed_box_hops). A move takes the member's bytes and
// clears its slot only when this owner holds every one of those boxes alone
// (#5041 P2); out of a box another owner shares (or an immortal static or
// frame box), the move copies the member and leaves the box intact: the box
// still owns that member (no partial transfer), and its last release drops it.
fn lower_read_box_member(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, owner: MIRValueID, dst: LIRValueID, holders: [LIRValueID], box: LIRValueID, offset: Int, ty: MIRType) Never! {
    result :: instruction.result ?? return lower_read_member(p, c, &m, &f, instruction, owner, dst, box, offset, ty)
    if !lower_member_moves(c, instruction, owner) || !lower_value_owned(c, result) -> return lower_read_member(p, c, &m, &f, instruction, owner, dst, box, offset, ty)
    // A member Sema never lets anyone copy (a Close owner, a handle without
    // clone, an atomic) never sits in a box another owner holds: taken.
    if lower_type_contains_uncopyable(p, &m, ty) -> return lower_read_member(p, c, &m, &f, instruction, owner, dst, box, offset, ty)
    boxes := lower_borrowed_box_hops(p, c, &m, &f, owner)
    loop holder in holders -> &boxes.push(holder)
    if boxes.len() == 0 -> return lower_read_member(p, c, &m, &f, instruction, owner, dst, box, offset, ty)
    if !lower_atomic_check_offset(p, &m, &f, ty, offset) -> return
    sole := lower_list_sole_owner(&f, boxes[0])
    loop (index, hop) in boxes {
        if index == 0 -> next
        alone :: lower_list_sole_owner(&f, hop)
        both :: lower_flag(&f)
        lower_emit(&f, LIRInst.Binary{dst: both, op: .And, left: sole, right: alone})
        sole = both
    }
    alone_block :: lower_new_block(&f)
    shared_block :: lower_new_block(&f)
    join :: lower_new_block(&f)
    if lower_inline_of(p, &f, ty) {
        // Both arms fill the result's own storage.
        size :: lower_size_of(p, &f, ty).size
        lower_storage_into(p, &f, dst, ty)
        lower_seal(&f, LIRTerminator.Branch{condition: sole, then_target: lower_target(alone_block, [LIRValueID]{}), else_target: lower_target(shared_block, [LIRValueID]{})})
        lower_start(&f, alone_block, [LIRValueID]{})
        lower_copy_bytes(&f, dst, 0, box, offset, size)
        lower_partial_transfer(&f, instruction)
        lower_clear_at(p, &f, box, offset, ty)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{})})
        lower_start(&f, shared_block, [LIRValueID]{})
        member :: lower_address(&f, box, offset)
        lower_inline_clone(p, &m, &f, member, dst, ty)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{})})
        lower_start(&f, join, [LIRValueID]{})
        return
    }
    lower_seal(&f, LIRTerminator.Branch{condition: sole, then_target: lower_target(alone_block, [LIRValueID]{}), else_target: lower_target(shared_block, [LIRValueID]{})})
    layout :: lower_repr_layout(lower_repr_of(p, &f, ty)) ?? return
    lower_start(&f, alone_block, [LIRValueID]{})
    taken :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_read_into(p, &f, taken, box, offset, ty)
    lower_partial_transfer(&f, instruction)
    lower_clear_at(p, &f, box, offset, ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{taken})})
    lower_start(&f, shared_block, [LIRValueID]{})
    held :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_read_into(p, &f, held, box, offset, ty)
    private :: lower_new_value(&f, layout, LIRDrop.Trivial, ty.identity)
    lower_clone_into(p, &m, &f, held, private, ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(join, [LIRValueID]{private})})
    // The join binds dst itself (lower_adopt): a jump argument may bind a
    // parameter of any drop glue, a Move may not change it.
    lower_start(&f, join, [LIRValueID]{dst})
}

// A MIR value's site: block position and instruction position (-1 for the
// block's terminator).
struct LowerUseSite {
    block: Int
    position: Int
}

// The MIRRust.rs FunctionIndex rows carrier_has_later_use reads.
struct LowerUseIndex {
    definitions: [U64:LowerUseSite]
    // Value -> its row in `use_lists`: the sites using it, in block and
    // instruction order (a site once), read in place rather than copied out
    // of a map per query or per added use.
    use_rows: [U64:Int]
    use_lists: [[LowerUseSite]]
    predecessors: [[Int]]
}

fn lower_use_index_add(use_rows: &[U64:Int], use_lists: &[[LowerUseSite]], value: U64, at: LowerUseSite) Never! {
    row := use_rows.get(value) ?? -1
    if row < 0 {
        row = use_lists.len()
        _ := &use_rows.add(value, row)
        &use_lists.push([LowerUseSite]{})
    } else {
        count :: use_lists[row].len()
        if use_lists[row][count - 1].block == at.block && use_lists[row][count - 1].position == at.position -> return
    }
    &use_lists[row].push(at)
}

// MIRRust.rs FunctionIndex::new: definitions, uses (an SSA-bound local's
// place read uses its value), and predecessors along terminator edges.
fn lower_use_index(function: MIRFunction, block_index: [U64:Int]) -> LowerUseIndex Never! {
    bound_locals := [U64:U64]{}
    loop local in function.locals {
        if local.ssa_value == .Val(value) -> _ := &bound_locals.add(local.id.value, value.value)
    }
    bound_places := [U64:U64]{}
    if bound_locals.len() > 0 {
        loop place in function.places {
            if place.base == .Local(local) {
                if bound_locals.get(local.value) == .Val(value) -> _ := &bound_places.add(place.id.value, value)
            }
        }
    }
    definitions := [U64:LowerUseSite]{}
    use_rows := [U64:Int]{}
    use_lists := [[LowerUseSite]]{}
    predecessors := [[Int]]{}
    loop _ in function.blocks -> &predecessors.push([Int]{})
    loop (block, row) in function.blocks {
        loop (position, instruction) in row.instructions {
            if instruction.result == .Val(result) {
                if definitions.get(result.value) == None -> _ := &definitions.add(result.value, LowerUseSite{block: block, position: position})
            }
            loop value in mir_operation_value_uses(instruction.operation) -> lower_use_index_add(&use_rows, &use_lists, value.value, LowerUseSite{block: block, position: position})
            if instruction.operation == .ReadPlace(place) | .MovePlace(place) {
                if bound_places.get(place.value) == .Val(value) -> lower_use_index_add(&use_rows, &use_lists, value, LowerUseSite{block: block, position: position})
            }
        }
        loop value in mir_terminator_value_uses(row.terminator) -> lower_use_index_add(&use_rows, &use_lists, value.value, LowerUseSite{block: block, position: -1})
        loop target in mir_terminator_targets(row.terminator) {
            if block_index.get(target.value) == .Val(at) -> &predecessors[at].push(block)
        }
    }
    LowerUseIndex{definitions: definitions, use_rows: use_rows, use_lists: use_lists, predecessors: predecessors}
}

// Whether each block lies on a cycle of terminator edges (reaches itself
// along one edge or more): a self edge, or a strongly connected component of
// two blocks or more; and each block's component. Kosaraju numbers the
// components in topological order of the condensation, so an edge runs from
// a component to itself or a higher one: a block reaches only blocks of its
// own component or a higher one. One pass per function, so each cycle query
// is a lookup and each reachability walk skips the blocks it cannot reach.
struct LowerBlockCycles { on_cycle: [Bool], component: [Int] }

fn lower_cycle_blocks(index: LowerUseIndex) -> LowerBlockCycles Never! {
    count :: index.predecessors.len()
    successors := [[Int]]{}
    on_cycle := [Bool]{}
    loop _ in 0..<count {
        &successors.push([Int]{})
        &on_cycle.push(false)
    }
    loop block in 0..<count {
        loop predecessor in index.predecessors[block] {
            &successors[predecessor].push(block)
            if predecessor == block -> on_cycle[block] = true
        }
    }
    // Finish order of a depth-first walk along successors.
    visited := (loop _ in 0..<count -> false)
    next_edge := (loop _ in 0..<count -> 0)
    order := [Int]{}
    loop root in 0..<count {
        if visited[root] -> next
        visited[root] = true
        stack := [Int]{root}
        loop stack.len() > 0 {
            at := stack[stack.len() - 1]
            if next_edge[at] < successors[at].len() {
                target :: successors[at][next_edge[at]]
                next_edge[at] = next_edge[at] + 1
                if !visited[target] {
                    visited[target] = true
                    &stack.push(target)
                }
            } else {
                &order.push(at)
                _ := &stack.pop()
            }
        }
    }
    // Components along predecessors, in reverse finish order.
    component := (loop _ in 0..<count -> -1)
    sizes := [Int]{}
    cursor := order.len() - 1
    loop cursor >= 0 {
        root :: order[cursor]
        cursor -= 1
        if component[root] >= 0 -> next
        id :: sizes.len()
        &sizes.push(0)
        component[root] = id
        stack := [Int]{root}
        loop stack.len() > 0 {
            at := &stack.pop() ?? { break }
            sizes[id] = sizes[id] + 1
            loop predecessor in index.predecessors[at] {
                if component[predecessor] < 0 {
                    component[predecessor] = id
                    &stack.push(predecessor)
                }
            }
        }
    }
    loop block in 0..<count {
        if sizes[component[block]] > 1 -> on_cycle[block] = true
    }
    LowerBlockCycles{on_cycle: ^on_cycle, component: ^component}
}

// The test a branch condition names: a trivial phi (every incoming value
// the same) is that value (MIRRust.rs carrier_has_later_use `tested`).
fn lower_use_tested(function: MIRFunction, index: LowerUseIndex, condition: MIRValueID) -> MIRValueID Never! {
    site :: index.definitions.get(condition.value) ?? return condition.copy()
    if function.blocks[site.block].instructions[site.position].operation == .Phi(incoming) {
        if incoming.len() == 0 -> return condition.copy()
        loop row in incoming {
            if row.value != incoming[0].value -> return condition.copy()
        }
        return lower_use_tested(function, index, incoming[0].value)
    }
    condition.copy()
}

// The tested condition when `predecessor` enters `block` on its true edge.
fn lower_use_then_condition(function: MIRFunction, index: LowerUseIndex, block_index: [U64:Int], predecessor: Int, block: Int) -> MIRValueID? Never! {
    if function.blocks[predecessor].terminator == .Branch(condition, then_target, else_target) {
        if then_target != else_target && (block_index.get(then_target.value) ?? -1) == block -> return Val(lower_use_tested(function, index, condition))
    }
    None
}

// The test every entry into `block` branched true on, while no path from
// `block` re-runs its definition (a path re-running the carrier's own
// definition carries a fresh carrier and stops there). A path to the test's
// block passes only blocks of its component or a lower one (`cycles`), so
// the walk skips every other block, and none is needed when the test's
// component precedes the block's.
fn lower_use_known_condition(function: MIRFunction, index: LowerUseIndex, block_index: [U64:Int], cycles: LowerBlockCycles, block: Int, definition_block: Int) -> MIRValueID? Never! {
    entries :: index.predecessors[block]
    if entries.len() == 0 -> return None
    known :: lower_use_then_condition(function, index, block_index, entries[0], block) ?? return None
    loop predecessor in entries {
        condition :: lower_use_then_condition(function, index, block_index, predecessor, block) ?? return None
        if condition != known -> return None
    }
    site :: index.definitions.get(known.value) ?? return None
    test_component :: cycles.component[site.block]
    if test_component < cycles.component[block] -> return Val(known)
    reached := [Int:Bool]{}
    pending := [Int]{block}
    cursor := 0
    loop cursor < pending.len() {
        at :: pending[cursor]
        cursor += 1
        loop target in mir_terminator_targets(function.blocks[at].terminator) {
            position :: block_index.get(target.value) ?? next
            if position == definition_block -> next
            if position == site.block -> return None
            if cycles.component[position] > test_component -> next
            if reached.get(position) == None {
                _ := &reached.add(position, true)
                &pending.push(position)
            }
        }
    }
    Val(known)
}

// The false edge of a re-test of the known condition cannot follow the arm.
fn lower_use_infeasible(function: MIRFunction, index: LowerUseIndex, block_index: [U64:Int], known: MIRValueID?, predecessor: Int, successor: Int) -> Bool Never! {
    tested :: known ?? return false
    if function.blocks[predecessor].terminator == .Branch(condition, then_target, else_target) {
        return then_target != else_target && (block_index.get(else_target.value) ?? -1) == successor && lower_use_tested(function, index, condition) == tested
    }
    false
}

// MIRRust.rs carrier_has_later_use: an owning carrier surrenders its payload
// only at its last reachable use. A match arm is entered only on the true
// edge of its test and the arm chain re-branches on that same test, so a
// later arm's probe of the carrier is no later use of this arm's payload.
// `uses` are the carrier's use sites (in any order), `cycles` the
// function's lower_cycle_blocks. The walk back from the uses skips blocks of
// a component below the projection's: `block` reaches none of them.
fn lower_carrier_has_later_use(function: MIRFunction, index: LowerUseIndex, block_index: [U64:Int], cycles: LowerBlockCycles, subject: MIRValueID, uses: [LowerUseSite], projection: MIRValueID) -> Bool Never! {
    site :: index.definitions.get(projection.value) ?? return true
    block :: site.block
    if uses.len() == 0 -> return false
    loop used in uses {
        if used.block == block && (used.position < 0 || used.position > site.position) -> return true
    }
    definition_block := -1
    if index.definitions.get(subject.value) == .Val(defined) -> definition_block = defined.block
    local := true
    loop used in uses {
        if used.block != block && used.block != definition_block -> local = false
    }
    // A carrier defined outside the loop the projection runs in is read
    // again by the next iteration: never its last use.
    if cycles.on_cycle[block] && (definition_block < 0 || !lower_block_reaches(index, cycles, block, definition_block)) -> return true
    if local -> return false
    known :: lower_use_known_condition(function, index, block_index, cycles, block, definition_block)
    block_component :: cycles.component[block]
    // Visited blocks by map: a query costs what it walks, not the block count.
    seen := [Int:Bool]{}
    pending := [Int]{}
    loop used in uses {
        if used.block != block && cycles.component[used.block] >= block_component && seen.get(used.block) == None {
            _ := &seen.add(used.block, true)
            &pending.push(used.block)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        used_block :: pending[cursor]
        cursor += 1
        if used_block == definition_block -> next
        loop predecessor in index.predecessors[used_block] {
            if lower_use_infeasible(function, index, block_index, known, predecessor, used_block) -> next
            if predecessor == block -> return true
            if cycles.component[predecessor] < block_component -> next
            if seen.get(predecessor) == None {
                _ := &seen.add(predecessor, true)
                &pending.push(predecessor)
            }
        }
    }
    false
}

// Whether `value` is a place read or a transfer of one (MIRRust.rs
// transparent_read): the carrier is then the place's own value here (a
// borrow, or a copy the read owns), so its payload is never taken from it.
// A value no instruction defines (a parameter) is treated likewise.
fn lower_payload_place_read(function: MIRFunction, index: LowerUseIndex, value: MIRValueID) -> Bool Never! {
    site :: index.definitions.get(value.value) ?? return true
    operation :: function.blocks[site.block].instructions[site.position].operation
    if operation == .ReadPlace(_) -> return true
    if operation == .Move(inner) | .Copy(inner, _) {
        read :: index.definitions.get(inner.value) ?? return false
        return function.blocks[read.block].instructions[read.position].operation == .ReadPlace(_)
    }
    false
}

// The Field/OptionValue/ResultValue/EnumPayload results whose owned carrier
// MIRRust.rs moves the member out of (no immutable place read, no later
// carrier use): the member is taken, never cloned, and the carrier's own
// release (or the local's drop) frees only what remains. A field of a
// fresh call result stored into a record is moved out of it this way.
fn lower_payload_takes(function: MIRFunction, block_index: [U64:Int]) -> [U64:Bool] Never! {
    takes := [U64:Bool]{}
    candidate := false
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Field(_, _) | .OptionValue(_) | .ResultValue(_, _) | .EnumPayload(_, _, _, _) -> candidate = true
        }
    }
    if !candidate -> return takes
    index :: lower_use_index(function, block_index)
    cycles :: lower_cycle_blocks(index)
    // Built on the first place-read carrier, once per function.
    facts := lower_payload_local_facts_none()
    facts_built := false
    no_uses :: [LowerUseSite]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            if instruction.operation == .Field(subject, _) | .OptionValue(subject) | .ResultValue(subject, _) | .EnumPayload(subject, _, _, _) {
                if lower_payload_place_read(function, index, subject) {
                    // A subject switch binds its non-place subject to a local
                    // (`it`); the Rust tier's subject is that value itself.
                    if !facts_built {
                        facts = lower_payload_local_facts(function, index)
                        facts_built = true
                    }
                    local_uses :: lower_payload_local_uses(function, index, facts, subject) ?? next
                    if !lower_carrier_has_later_use(function, index, block_index, cycles, subject, local_uses, result) -> _ := &takes.add(result.value, true)
                    next
                }
                row :: index.use_rows.get(subject.value) ?? -1
                later :: if row < 0 -> lower_carrier_has_later_use(function, index, block_index, cycles, subject, no_uses, result) else -> lower_carrier_has_later_use(function, index, block_index, cycles, subject, index.use_lists[row], result)
                if !later -> _ := &takes.add(result.value, true)
            }
        }
    }
    takes
}

// The value a variant test or payload read inspects, if `operation` is one.
fn lower_inspect_subject(operation: MIROperation) -> MIRValueID? Never! {
    if operation == .EnumIs(subject, _, _) | .EnumPayload(subject, _, _, _) | .OptionIsSome(subject) | .OptionValue(subject) | .ResultIsOk(subject) | .ResultValue(subject, _) -> return Val(subject)
    None
}

// The `candidates` whose every use is a variant test or payload read of it,
// or (`inspect_moves`) an inspect Move of it; one use at least, and none by
// a terminator or a phi.
fn lower_inspected_only(function: MIRFunction, candidates: [U64:Bool], inspect_moves: [U64:Bool]) -> [U64:Bool] Never! {
    used := [U64:Bool]{}
    rejected := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            inspected :: lower_inspect_subject(instruction.operation)
            through := MIRValueID?{None}
            if lower_is_inspect_move(inspect_moves, instruction) {
                if instruction.operation == .Move(inner) -> through = Val(inner)
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                if candidates.get(value.value) == None -> next
                if inspected == Val((value)) || through == Val((value)) {
                    _ := &used.add(value.value, true)
                } else {
                    _ := &rejected.add(value.value, true)
                }
            }
        }
        loop value in mir_terminator_value_uses(block.terminator) -> _ := &rejected.add(value.value, true)
    }
    out := [U64:Bool]{}
    loop (key, _) in used {
        if rejected.get(key) == None -> _ := &out.add(key, true)
    }
    out
}

// The Moves only variant tests and payload reads use (the last-use pass's
// `match.payload.take`): result value -> true. Such a Move lands its
// operand nowhere; lowering forwards it and its operand stays what it was.
fn lower_inspect_moves(function: MIRFunction) -> [U64:Bool] Never! {
    moved := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Move(_) {
                if instruction.result == .Val(result) -> _ := &moved.add(result.value, true)
            }
        }
    }
    if moved.len() == 0 -> return moved
    lower_inspected_only(function, moved, [U64:Bool]{})
}

fn lower_is_inspect_move(inspect_moves: [U64:Bool], instruction: MIRInstruction) -> Bool Never! {
    if inspect_moves.len() == 0 -> return false
    if instruction.operation == .Move(_) {
        if instruction.result == .Val(result) -> return inspect_moves.get(result.value) != None
    }
    false
}

// MovePlace results of a local or a field path of one that only variant
// tests, payload reads and inspect Moves use: a match subject the last-use
// pass moved out of its dead local (clearing the local's drop flag) or out
// of a field nothing reads again (clearing the field in its owner, whose
// drop then skips it). Nothing in MIR drops such a carrier, so the release
// plan does (lower_release_plan).
fn lower_inspect_carriers(function: MIRFunction, inspect_moves: [U64:Bool]) -> [U64:Bool] Never! {
    roots := [U64:Bool]{}
    loop place in function.places {
        if !(place.base == .Local(_)) -> next
        fields := true
        loop projection in place.projections {
            if !(projection == .Field(_, _)) -> fields = false
        }
        if fields -> _ := &roots.add(place.id.value, true)
    }
    moved := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .MovePlace(place) {
                if roots.get(place.value) == None -> next
                if instruction.result == .Val(result) -> _ := &moved.add(result.value, true)
            }
        }
    }
    if moved.len() == 0 -> return moved
    lower_inspected_only(function, moved, inspect_moves)
}

// Whether a path of one edge or more leads from block `from` to block `to`.
// By component (`cycles`): none to a lower one; within one, exactly when
// `from` lies on a cycle; to a higher one, walked backwards from `to` over
// the predecessors `from` can reach (no lower component than its own).
fn lower_block_reaches(index: LowerUseIndex, cycles: LowerBlockCycles, from: Int, to: Int) -> Bool Never! {
    from_component :: cycles.component[from]
    if cycles.component[to] < from_component -> return false
    if cycles.component[to] == from_component -> return cycles.on_cycle[from]
    seen := [Int:Bool]{}
    pending := [Int]{}
    loop predecessor in index.predecessors[to] {
        if cycles.component[predecessor] >= from_component && seen.get(predecessor) == None {
            _ := &seen.add(predecessor, true)
            &pending.push(predecessor)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        at :: pending[cursor]
        cursor += 1
        if at == from -> return true
        loop predecessor in index.predecessors[at] {
            if cycles.component[predecessor] >= from_component && seen.get(predecessor) == None {
                _ := &seen.add(predecessor, true)
                &pending.push(predecessor)
            }
        }
    }
    false
}

// One instruction touching a local's places (lower_payload_local_facts):
// its site, and whether it lets the local's address escape (AddressOf,
// RawAddressOf, Closure).
struct LowerLocalTouch {
    site: LowerUseSite
    escape: Bool
}

// Per-function facts of locals that lower_payload_local_uses reads, built
// once per function instead of rescanning every place and instruction per
// carrier.
struct LowerPayloadLocalFacts {
    // Place id -> the local its row is rooted at (any projections).
    place_locals: [U64:U64]
    // Place ids whose row has projections.
    projected: [U64:Bool]
    // Local id -> its row in `touches`: every instruction (in block and
    // instruction order, once each) that uses one of the local's places or
    // passes one as a call argument, except a MovePlace only dropped (the
    // local's cleanup).
    touch_rows: [U64:Int]
    touches: [[LowerLocalTouch]]
    // Local id -> its row in `write_blocks`: the blocks holding a whole
    // write (WritePlace, ReplacePlace or InitializeUninit of an unprojected
    // place) of the local.
    write_rows: [U64:Int]
    write_blocks: [[Int]]
    // Local ids some MIRLocal row of which is not owned (a borrowed local).
    unowned_locals: [U64:Bool]
}

fn lower_payload_local_facts_none() -> LowerPayloadLocalFacts Never! {
    LowerPayloadLocalFacts{place_locals: [U64:U64]{}, projected: [U64:Bool]{}, touch_rows: [U64:Int]{}, touches: [[LowerLocalTouch]]{}, write_rows: [U64:Int]{}, write_blocks: [[Int]]{}, unowned_locals: [U64:Bool]{}}
}

fn lower_payload_local_facts(function: MIRFunction, index: LowerUseIndex) -> LowerPayloadLocalFacts Never! {
    place_locals := [U64:U64]{}
    projected := [U64:Bool]{}
    unowned_locals := [U64:Bool]{}
    loop row in function.locals {
        if !lower_is_owned(row.ownership) -> unowned_locals[row.id.value] = true
    }
    loop row in function.places {
        if row.projections.len() > 0 -> projected[row.id.value] = true
        if row.base == .Local(owner) -> place_locals[row.id.value] = owner.value
    }
    touch_rows := [U64:Int]{}
    touches := [[LowerLocalTouch]]{}
    write_rows := [U64:Int]{}
    write_blocks := [[Int]]{}
    loop (block, row) in function.blocks {
        loop (position, instruction) in row.instructions {
            written := MIRPlaceID?{None}
            if instruction.operation == .WritePlace(place, _) | .ReplacePlace(place, _) -> written = Val(place)
            if instruction.operation == .InitializeUninit(place) -> written = Val(place)
            if written == .Val(place) {
                if projected.get(place.value) == None && place_locals.get(place.value) == .Val(local) {
                    at := write_rows.get(local) ?? -1
                    if at < 0 {
                        at = write_blocks.len()
                        write_rows[local] = at
                        &write_blocks.push([Int]{})
                    }
                    count :: write_blocks[at].len()
                    if count == 0 || write_blocks[at][count - 1] != block -> &write_blocks[at].push(block)
                }
            }
            locals := [U64]{}
            loop used in mir_operation_place_uses(instruction.operation) {
                if place_locals.get(used.value) == .Val(local) {
                    if !locals.contains(local) -> &locals.push(local)
                }
            }
            if instruction.operation == .Call(_, args, _) | .IndirectCall(_, args, _) {
                loop arg in args {
                    if arg.place == .Val(used) {
                        if place_locals.get(used.value) == .Val(local) {
                            if !locals.contains(local) -> &locals.push(local)
                        }
                    }
                }
            }
            if locals.len() == 0 -> next
            escape := false
            if instruction.operation == {
                .AddressOf(_, _) | .RawAddressOf(_) | .Closure(_, _, _) -> escape = true
                .MovePlace(_) -> { if lower_payload_drop_only(function, index, instruction.result) -> next }
                else -> {}
            }
            loop local in locals {
                at := touch_rows.get(local) ?? -1
                if at < 0 {
                    at = touches.len()
                    touch_rows[local] = at
                    &touches.push([LowerLocalTouch]{})
                }
                &touches[at].push(LowerLocalTouch{site: LowerUseSite{block: block, position: position}, escape: escape})
            }
        }
    }
    LowerPayloadLocalFacts{place_locals: place_locals, projected: projected, touch_rows: touch_rows, touches: touches, write_rows: write_rows, write_blocks: write_blocks, unowned_locals: unowned_locals}
}

// Whether the value `local` holds at its read `site` can reach that read
// again along a back edge: a path from the read to itself that no whole
// write of the local (facts.write_blocks) crosses. Walked backwards over
// predecessors from the read's block; a block holding such a write, the
// read's own included, stops the path.
fn lower_local_read_recurs(index: LowerUseIndex, facts: LowerPayloadLocalFacts, local: U64, site: LowerUseSite) -> Bool Never! {
    writes := [Int:Bool]{}
    row :: facts.write_rows.get(local) ?? -1
    if row >= 0 {
        loop block in facts.write_blocks[row] -> writes[block] = true
    }
    if writes.get(site.block) != None -> return false
    seen := [Int:Bool]{}
    pending := [Int]{}
    loop predecessor in index.predecessors[site.block] {
        if seen.get(predecessor) == None {
            _ := &seen.add(predecessor, true)
            &pending.push(predecessor)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        at :: pending[cursor]
        cursor += 1
        if at == site.block -> return true
        if writes.get(at) != None -> next
        loop predecessor in index.predecessors[at] {
            if seen.get(predecessor) == None {
                _ := &seen.add(predecessor, true)
                &pending.push(predecessor)
            }
        }
    }
    false
}

// Jet sema binds a subject switch's non-place subject to the generated local
// `it` (Statements.jet sema_stmt_check_subject_switch), so each arm reads
// `it`'s place where the Rust tier's MIR tests and projects the subject
// value itself (and MIRRust.rs moves the payload out at the carrier's last
// use, a non-Clone FileWriter/FileReader included). For a carrier that is
// such a read (a ReadPlace of a whole local whose places never escape, used
// only by variant tests and payload reads), the carrier's uses widened to
// every access of the local: its later reads then count as later uses of the
// carrier. The local's cleanup moves (a MovePlace feeding only Drop) do not:
// the take clears the payload in the local's carrier (lower_read_member), so
// that drop releases only what remains. None when the carrier is not such a
// read, or when the local's value is live across a back edge into the read
// (lower_local_read_recurs): the next iteration re-reads the same value, and
// the widened uses (which skip the read's own site) cannot see that
// iteration's tests and payload reads. A local written again inside the loop
// before each read (a subject switch's `it` bound to a call made in the loop
// body) holds a fresh value each time, and its payload is still taken.
// Costs the carrier's uses and the local's touches, read from `facts`.
fn lower_payload_local_uses(function: MIRFunction, index: LowerUseIndex, facts: LowerPayloadLocalFacts, subject: MIRValueID) -> [LowerUseSite]? Never! {
    site :: index.definitions.get(subject.value) ?? return None
    read :: function.blocks[site.block].instructions[site.position].operation
    place := MIRPlaceID{value: U64.MAX}
    if read == .ReadPlace(read_place) {
        place = read_place
    } else {
        return None
    }
    if facts.projected.get(place.value) != None -> return None
    local :: facts.place_locals.get(place.value) ?? return None
    // A borrowed local (a ReadBorrow MIRLocal, JetCodegen
    // jet_codegen_bind_borrowed_local) holds what its subject owns: nothing
    // is ever taken from it.
    if facts.unowned_locals.get(local) != None -> return None
    // The carrier is inspected only: it aliases the local's value.
    widened := [LowerUseSite]{}
    row :: index.use_rows.get(subject.value) ?? -1
    if row >= 0 {
        loop used in index.use_lists[row] {
            if used.position < 0 -> return None
            if function.blocks[used.block].instructions[used.position].operation == {
                .OptionIsSome(_) | .OptionValue(_) | .ResultIsOk(_) | .ResultValue(_, _) -> {}
                else -> return None
            }
            &widened.push(used)
        }
    }
    if lower_local_read_recurs(index, facts, local, site) -> return None
    touch_row :: facts.touch_rows.get(local) ?? -1
    if touch_row >= 0 {
        loop touch in facts.touches[touch_row] {
            if touch.site.block == site.block && touch.site.position == site.position -> next
            if touch.escape -> return None
            &widened.push(touch.site)
        }
    }
    Val(widened)
}

// Whether `value` (a MovePlace result) is only dropped: a local's cleanup.
fn lower_payload_drop_only(function: MIRFunction, index: LowerUseIndex, value: MIRValueID?) -> Bool Never! {
    moved :: value ?? return false
    row :: index.use_rows.get(moved.value) ?? return false
    loop used in index.use_lists[row] {
        if used.position < 0 -> return false
        if function.blocks[used.block].instructions[used.position].operation == .Drop(_, _) -> next
        return false
    }
    index.use_lists[row].len() > 0
}

// MIRRust.rs loop_iter_init `consumed` with plan_move_facts `single_use`: a
// plain read loop (`by_value: false`) over a List or Map value read once, in
// its own block, takes that value instead of copying the whole collection;
// so its elements move out and a non-copyable element is never cloned
// (`loop file in ^listed` over a List of structs holding FileReaders). A
// List of U8 walks the byte cursor and is never taken. Natively only a
// value that owns its storage can be handed over: a MovePlace result (its
// slot cleared) or a fresh call or list result; a ReadPlace borrows its place.
fn lower_iter_takes(function: MIRFunction) -> [U64:Bool] Never! {
    takes := [U64:Bool]{}
    if function.optimization.checked_vector_facts.len() > 0 -> return takes
    candidates := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .LoopIterInit(_, collection, _, by_value, source_kind) {
                if !by_value && source_kind == .Plain -> _ := &candidates.add(collection.value, true)
            }
        }
    }
    if candidates.len() == 0 -> return takes
    // Uses as MIRRust.rs plan_move_facts counts them: one per operation
    // operand, two for a terminator operand or a place rooted at the value.
    counts := [U64:Int]{}
    use_blocks := [U64:Int]{}
    definitions := [U64:Int]{}
    owning := [U64:Bool]{}
    loop (at, block) in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if candidates.get(result.value) != None {
                    _ := &definitions.add(result.value, at)
                    if lower_iter_takes_owning(instruction.operation) -> _ := &owning.add(result.value, true)
                }
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                if candidates.get(value.value) == None -> next
                _ := &counts.add(value.value, (counts.get(value.value) ?? 0) + 1)
                _ := &use_blocks.add(value.value, at)
            }
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            if candidates.get(value.value) == None -> next
            _ := &counts.add(value.value, (counts.get(value.value) ?? 0) + 2)
            _ := &use_blocks.add(value.value, at)
        }
    }
    loop place in function.places {
        if place.base == .Temporary(value) | .Parameter(value) | .Capture(value) {
            if candidates.get(value.value) != None -> _ := &counts.add(value.value, (counts.get(value.value) ?? 0) + 2)
        }
        loop projection in place.projections {
            if projection == .Index(_, value, _, _, _, _, _) | .MapLookup(value, _, _) | .Range(value, _, _) {
                if candidates.get(value.value) != None -> _ := &counts.add(value.value, (counts.get(value.value) ?? 0) + 2)
            }
        }
    }
    loop value in function.values {
        if candidates.get(value.id.value) == None || owning.get(value.id.value) == None -> next
        if (counts.get(value.id.value) ?? 0) != 1 || use_blocks.get(value.id.value) != definitions.get(value.id.value) -> next
        if !lower_is_owned(value.ownership) -> next
        if value.ty.kind == {
            .List(inner) -> { if inner.kind == .IntN(signed, bits) && !signed && bits == 8 -> next }
            .Map(_, _) -> {}
            else -> next
        }
        _ := &takes.add(value.id.value, true)
    }
    takes
}

// Whether the native result of `operation` owns its storage when its MIR
// value is owned (a read of a place may alias it instead).
fn lower_iter_takes_owning(operation: MIROperation) -> Bool Never! {
    if operation == {
        .MovePlace(_) | .Call(_, _, _) | .IndirectCall(_, _, _) | .BuildList(_, _) | .BuildMap(_) -> true
        else -> false
    }
}

fn lower_option_inner(ty: MIRType) -> MIRType? {
    if ty.kind == {
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .Option(inner) -> Val(inner.copy())
        .Tagged(_, inner) -> lower_option_inner(inner)
        else -> None
    }
}

// Option: null is absent; a present value is a box holding its bytes. A
// borrowed carrier (a ReadBorrow Present, #5041
// jet_codegen_emit_borrowed_carrier) lends a place's bytes to a read
// parameter or a comparison only: its box is a stack slot of this frame,
// filled with those bytes and never dropped or freed. Its count word (#5041
// P2) is immortal like a static box's, so a callee's clone copies it
// (lower_clone_glue_function) instead of sharing frame storage.
fn lower_present(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID) Never! {
    option :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Present without a checked type")
    inner :: lower_option_inner(option) ?? return lower_fail(&m, &f, "Present of {mir_type_display_name(option)} is not an Option")
    result :: instruction.result ?? return
    borrowed := false
    if c.fact_index.get(result.value) == .Val(index) -> borrowed = c.mir.values[index].ownership.mode == MIROwnershipMode.ReadBorrow
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if borrowed {
        view :: lower_frame_box(&f, lower_option_box_size(p, inner))
        lower_emit(&f, LIRInst.Move{dst: dst, src: view})
    } else {
        lower_alloc(&m, &f, dst, lower_option_box_size(p, inner))
    }
    lower_store_value(p, &m, &f, dst, 0, value, inner)
}

// Ordinary Result layout is defined alongside lower_result_box_size in Values.
fn lower_result_box(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, ok: Int) Never! {
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Result without a checked type")
    if result_ty.kind == .Result(ok_ty, err_ty) {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        lower_alloc(&m, &f, dst, lower_result_box_size(p, ok_ty, err_ty))
        lower_store_word(&f, dst, 0, ok)
        lower_store_value(p, &m, &f, dst, lower_result_payload_offset(), value, if ok == lower_result_selector(true) -> ok_ty else -> err_ty)
        return
    }
    lower_fail(&m, &f, "Result construction of {mir_type_display_name(result_ty)} is not lowered at O0 yet")
}

// ---------------------------------------------------------------------------
// Arithmetic.

// Inline-integer test: a word is an inline Int when bits 63 and 62 agree,
// i.e. when doubling it does not overflow. Each value is tested by the
// overflow flag of `value + value` and a branch to `slow` on it: `mov; add;
// jo slow` (Select fuses the Overflows into the branch), no xor/or/setcc
// round trip. Lowering continues in a block every value reaches inline: the
// last test's else edge is `inline` when given (its arguments ride on that
// edge), else a fresh parameterless block. `slow` takes no arguments; mark
// it cold (lower_start_cold) so the hot code falls through.
fn lower_inline_branch(f: &LowerFunction, values: [LIRValueID], slow: LIRBlockID, inline: LIRJumpTarget?) Never! {
    no_args :: [LIRValueID]{}
    loop (index, value) in values {
        overflowed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Overflows{dst: overflowed, op: LIRBinaryOp.Add, left: value, right: value})
        if index == values.len() - 1 {
            if inline == .Val(target) {
                lower_seal(&f, LIRTerminator.Branch{condition: overflowed, then_target: lower_target(slow, no_args), else_target: lower_target(target.block, target.args)})
                return
            }
        }
        next_block :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: overflowed, then_target: lower_target(slow, no_args), else_target: lower_target(next_block, no_args)})
        lower_continue(&f, next_block, no_args)
    }
}

// Opens block `id` as a cold one (LIRBlock.cold): laid out after the hot
// blocks by lir_builder_finish.
fn lower_start_cold(f: &LowerFunction, id: LIRBlockID, params: [LIRValueID]) Never! {
    lir_builder_mark_cold(&f.builder, id)
    lower_start(&f, id, params)
}

// Opens block `id` as the continuation of the block just sealed: cold when
// that one is (a check inside a cold path stays out of the hot layout).
fn lower_continue(f: &LowerFunction, id: LIRBlockID, params: [LIRValueID]) Never! {
    if lir_builder_is_cold(f.builder, f.open) -> lir_builder_mark_cold(&f.builder, id)
    lower_start(&f, id, params)
}

// Exact Int `left op right` for Add, Sub, Mul: native when both operands and
// the result are inline, else the runtime route (which builds big integers)
// in a cold block. The hot path is straight-line: `jo slow` per operand,
// the operation (Mul with its own `jo slow`: two inline operands cannot
// overflow Add or Sub), and `jo slow` on the result's inline test.
fn lower_exact_arithmetic(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID, symbol: String) Never! {
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    lower_inline_branch(&f, [LIRValueID]{left, right}, slow_block, None)
    fast :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: fast, op: op, left: left, right: right})
    if op == .Mul {
        overflowed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Overflows{dst: overflowed, op: op, left: left, right: right})
        fits_block :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: overflowed, then_target: lower_target(slow_block, no_args), else_target: lower_target(fits_block, no_args)})
        lower_continue(&f, fits_block, no_args)
    }
    lower_inline_branch(&f, [LIRValueID]{fast}, slow_block, Val(lower_target(merge_block, [LIRValueID]{fast})))

    lower_start_cold(&f, slow_block, no_args)
    slow :: lower_word(&f)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{left, right}, Val(slow))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})

    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_condition_of(op: MIRBinaryOp) -> LIRCondition? {
    if op == {
        .Eq -> Val(LIRCondition.Eq)
        .Ne -> Val(LIRCondition.Ne)
        .Lt -> Val(LIRCondition.Lt)
        .Le -> Val(LIRCondition.Le)
        .Gt -> Val(LIRCondition.Gt)
        .Ge -> Val(LIRCondition.Ge)
        else -> None
    }
}

// Exact Int comparison: native when both are inline, else (cold) the sign of
// the runtime's three-way order.
fn lower_exact_compare(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, condition: LIRCondition, left: LIRValueID, right: LIRValueID) Never! {
    slow_block :: lower_new_block(&f)
    merge_block :: lower_new_block(&f)
    no_args :: [LIRValueID]{}
    lower_inline_branch(&f, [LIRValueID]{left, right}, slow_block, None)
    fast :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: fast, condition: condition, left: left, right: right})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})

    lower_start_cold(&f, slow_block, no_args)
    order :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_compare", [LIRValueID]{left, right}, Val(order))
    zero :: lower_const(&f, 0)
    slow :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: slow, condition: condition, left: order, right: zero})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})

    lower_start(&f, merge_block, [LIRValueID]{dst})
}

// `left <=> right` (MIRRust.rs:21936 maps `cmp` onto Ordering): the
// Less/Equal/Greater discriminant of the checked result enum. Exact Ints
// compare inline words natively and big integers by the runtime's three-way
// order; Strings by jet_rt_string_compare; fixed integers and Chars as words.
fn lower_three_way(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, dst: LIRValueID, ty: MIRType, left: LIRValueID, right: LIRValueID) Never! {
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "`<=>` without a checked result type is not lowered at O0 yet")
    definition :: lower_type_def(p, result_ty) ?? return lower_fail(&m, &f, "`<=>` result {mir_type_display_name(result_ty)} has no definition")
    less :: lower_variant(definition, "Less") ?? return lower_fail(&m, &f, "`<=>` result {mir_type_display_name(result_ty)} has no Less variant")
    equal :: lower_variant(definition, "Equal") ?? return lower_fail(&m, &f, "`<=>` result {mir_type_display_name(result_ty)} has no Equal variant")
    greater :: lower_variant(definition, "Greater") ?? return lower_fail(&m, &f, "`<=>` result {mir_type_display_name(result_ty)} has no Greater variant")
    no_args :: [LIRValueID]{}
    a := left
    b := right
    lt := LIRCondition.Lt
    if lower_is_exact_int(ty) {
        slow_block :: lower_new_block(&f)
        merge_block :: lower_new_block(&f)
        lower_inline_branch(&f, [LIRValueID]{left, right}, slow_block, Val(lower_target(merge_block, [LIRValueID]{left, right})))
        lower_start_cold(&f, slow_block, no_args)
        order :: lower_word(&f)
        lower_call_runtime(&m, &f, "jet_int_compare", [LIRValueID]{left, right}, Val(order))
        zero :: lower_const(&f, 0)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{order, zero})})
        a = lower_word(&f)
        b = lower_word(&f)
        lower_start(&f, merge_block, [LIRValueID]{a, b})
    } else if lower_text_type(ty) {
        a = lower_word(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_compare", [LIRValueID]{left, right}, Val(a))
        b = lower_const(&f, 0)
    } else if lower_value_layout(f, left) != lir_layout_word() {
        return lower_fail(&m, &f, "operator <=> on {mir_type_display_name(ty)} is not lowered at O0 yet")
    } else if lower_is_unsigned_word(ty) {
        lt = LIRCondition.ULt
    }
    is_less :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_less, condition: lt, left: a, right: b})
    less_word :: lower_const(&f, lower_discriminant(less.index))
    rest_block :: lower_new_block(&f)
    done_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_less, then_target: lower_target(done_block, [LIRValueID]{less_word}), else_target: lower_target(rest_block, no_args)})
    lower_start(&f, rest_block, no_args)
    is_equal :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_equal, condition: LIRCondition.Eq, left: a, right: b})
    equal_word :: lower_const(&f, lower_discriminant(equal.index))
    greater_word :: lower_const(&f, lower_discriminant(greater.index))
    lower_seal(&f, LIRTerminator.Branch{condition: is_equal, then_target: lower_target(done_block, [LIRValueID]{equal_word}), else_target: lower_target(done_block, [LIRValueID]{greater_word})})
    lower_start(&f, done_block, [LIRValueID]{dst})
}

// Ordering.then / Ordering.reverse (jet_ordering_then / jet_ordering_reverse)
// over the Ordering discriminant: `then` keeps a decided order and takes the
// argument after Equal; `reverse` swaps Less and Greater.
fn lower_ordering_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, receiver: MIRValueID, args: [MIRValueID]) -> Bool Never! {
    symbol :: lower_runtime_symbol(row)
    then_route :: row.member == "ordering_then" && symbol == "jet_ordering_then" && args.len() == 1
    reverse_route :: row.member == "ordering_reverse" && symbol == "jet_ordering_reverse" && args.len() == 0
    if !then_route && !reverse_route -> return false
    ty :: lower_value_type(c, receiver) ?? return false
    definition :: lower_type_def(p, ty) ?? return false
    less :: lower_variant(definition, "Less") ?? return false
    equal :: lower_variant(definition, "Equal") ?? return false
    greater :: lower_variant(definition, "Greater") ?? return false
    order :: lower_use(&m, &f, receiver) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? return true
    merge :: lower_new_block(&f)
    if then_route {
        next :: lower_use(&m, &f, args[0]) ?? return true
        equal_word :: lower_const(&f, lower_discriminant(equal.index))
        decided :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: decided, condition: LIRCondition.Ne, left: order, right: equal_word})
        lower_seal(&f, LIRTerminator.Branch{condition: decided, then_target: lower_target(merge, [LIRValueID]{order}), else_target: lower_target(merge, [LIRValueID]{next})})
    } else {
        less_word :: lower_const(&f, lower_discriminant(less.index))
        greater_word :: lower_const(&f, lower_discriminant(greater.index))
        is_less :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_less, condition: LIRCondition.Eq, left: order, right: less_word})
        rest :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: is_less, then_target: lower_target(merge, [LIRValueID]{greater_word}), else_target: lower_target(rest, [LIRValueID]{})})
        lower_start(&f, rest, [LIRValueID]{})
        is_greater :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_greater, condition: LIRCondition.Eq, left: order, right: greater_word})
        lower_seal(&f, LIRTerminator.Branch{condition: is_greater, then_target: lower_target(merge, [LIRValueID]{less_word}), else_target: lower_target(merge, [LIRValueID]{order})})
    }
    lower_start(&f, merge, [LIRValueID]{dst})
    true
}

// `And`/`Or` of two evaluated Bools, as a branch and a join.
fn lower_logic(f: &LowerFunction, dst: LIRValueID, is_and: Bool, left: LIRValueID, right: LIRValueID) Never! {
    merge_block :: lower_new_block(&f)
    decided :: lower_const_flag(&f, if is_and -> 0 else -> 1)
    then_args :: if is_and -> [LIRValueID]{right} else -> [LIRValueID]{decided}
    else_args :: if is_and -> [LIRValueID]{decided} else -> [LIRValueID]{right}
    lower_seal(&f, LIRTerminator.Branch{condition: left, then_target: lower_target(merge_block, then_args), else_target: lower_target(merge_block, else_args)})
    lower_start(&f, merge_block, [LIRValueID]{dst})
}

fn lower_word_op(op: MIRBinaryOp) -> LIRBinaryOp? {
    if op == {
        .Add -> Val(LIRBinaryOp.Add)
        .Sub -> Val(LIRBinaryOp.Sub)
        .Mul -> Val(LIRBinaryOp.Mul)
        .Div -> Val(LIRBinaryOp.Div)
        .Rem -> Val(LIRBinaryOp.Rem)
        .BitAnd -> Val(LIRBinaryOp.And)
        .BitOr -> Val(LIRBinaryOp.Or)
        .BitXor -> Val(LIRBinaryOp.Xor)
        .Shl -> Val(LIRBinaryOp.Shl)
        .Shr -> Val(LIRBinaryOp.Shr)
        else -> None
    }
}

fn lower_binary(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, op: MIRBinaryOp, dispatch: MIRBinaryDispatch, overflow: MIRBinaryOverflow, left: MIRValueID, right: MIRValueID) Never! {
    left_value :: lower_use(&m, &f, left) ?? return
    right_value :: lower_use(&m, &f, right) ?? return
    left_ty :: lower_value_type(c, left) ?? return lower_fail(&m, &f, "operand {left.value} has no checked type")
    if lower_repr(p, left_ty) == .Float32Bits -> return lower_float32_binary(p, c, &m, &f, instruction, op, left_value, right_value, left_ty)
    exact :: lower_is_exact_int(left_ty)
    unsigned :: lower_is_unsigned_word(left_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "binary operator has no result")
    // A fixed-width trapping route (`jet_u64_trap_add`, ...: Rust checked
    // arithmetic that stops on overflow or an out-of-range shift count) is
    // the native checked operator below.
    fixed_trap := false
    if dispatch == .Prelude(call, _) {
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "binary operator names missing Prelude call {call.value}")
        fixed_trap = !exact && lower_fixed_trap_route(lower_runtime_symbol(row))
    }
    if dispatch == .Prelude(call, location) {
        if !fixed_trap -> return lower_binary_route(p, &m, &f, dst, op, exact, call, location, left_value, right_value)
    }
    if op == .Add && left_ty.kind == .String {
        right_ty :: lower_value_type(c, right) ?? return lower_fail(&m, &f, "operand {right.value} has no checked type")
        if right_ty.kind != .String -> return lower_fail(&m, &f, "String addition requires two checked String operands")
        return lower_call_runtime(&m, &f, "jet_rt_string_concat", [LIRValueID]{left_value, right_value}, Val(dst))
    }
    if lower_duration_binary(p, c, &m, &f, instruction, op, left_ty, right, left_value, right_value, dst) -> return
    left_layout :: lower_value_layout(f, left_value)
    if op == .Compare {
        if left_layout != lower_value_layout(f, right_value) -> return lower_fail(&m, &f, "comparison operands {left.value} and {right.value} differ in layout")
        return lower_three_way(p, c, &m, &f, instruction, dst, left_ty, left_value, right_value)
    }
    if lower_condition_of(op) == .Val(condition) {
        if left_layout != lower_value_layout(f, right_value) -> return lower_fail(&m, &f, "comparison operands {left.value} and {right.value} differ in layout")
        if exact -> return lower_exact_compare(&m, &f, dst, condition, left_value, right_value)
        if lower_order_runtime(p, left_ty) != None {
            order :: lower_map_key_order(p, &m, &f, left_ty, left_value, right_value)
            return lower_order_condition(&f, dst, condition, order)
        }
        if lower_text_type(left_ty) {
            if condition != .Eq && condition != .Ne -> return lower_string_compare(&m, &f, dst, condition, left_value, right_value)
            equal :: lower_flag(&f)
            lower_call_runtime(&m, &f, "jet_rt_string_eq", [LIRValueID]{left_value, right_value}, Val(equal))
            if condition == .Eq -> return lower_emit(&f, LIRInst.Move{dst: dst, src: equal})
            no :: lower_const_flag(&f, 0)
            return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: equal, right: no})
        }
        if (condition == .Eq || condition == .Ne) && left_layout.class != .Integer && left_layout.class != .Float {
            same :: lower_equal_values(p, &m, &f, left_ty, Val(left_value), Val(right_value)) ?? return
            if condition == .Eq -> return lower_emit(&f, LIRInst.Move{dst: dst, src: same})
            no :: lower_const_flag(&f, 0)
            return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: same, right: no})
        }
        // A List of ordered elements compares lexicographically (Rust Vec Ord).
        if lower_list_element(left_ty) == .Val(elem) {
            if lower_map_key_kind(p, elem) != "" && lower_view_element(left_ty) == None {
                order :: lower_word(&f)
                lower_call_helper(&m, &f, "list.compare", left_ty, [LIRValueID]{left_value, right_value}, Val(order))
                zero :: lower_const(&f, 0)
                return lower_emit(&f, LIRInst.Compare{dst: dst, condition: condition, left: order, right: zero})
            }
        }
        // A struct, tuple, Option or payload enum of ordered members orders
        // as its Rust derived PartialOrd (Option: None first; enum: variant
        // ordinal, then payload; aggregates: members in declaration order).
        kind :: lower_map_key_kind(p, left_ty)
        if kind == "inline" || kind == "boxed" {
            order :: lower_map_key_order(p, &m, &f, left_ty, left_value, right_value)
            return lower_order_condition(&f, dst, condition, order)
        }
        if left_layout.class != .Integer && left_layout.class != .Float -> return lower_fail(&m, &f, "comparison of {mir_type_display_name(left_ty)} is not lowered at O0 yet")
        return lower_emit(&f, LIRInst.Compare{dst: dst, condition: if unsigned -> lower_unsigned_condition(condition) else -> condition, left: left_value, right: right_value})
    }
    if op == .And | .Or {
        if left_layout != lir_layout_bool() -> return lower_fail(&m, &f, "logical operator on a non-Bool")
        return lower_logic(&f, dst, op == .And, left_value, right_value)
    }
    if left_layout.class == .Float -> return lower_float_binary(&m, &f, dst, op, left_ty, left_layout == lir_layout_float32(), left_value, right_value)
    // Fixed floor division, floored modulo and power have no word operator.
    if fixed_trap && (op == .FloorDiv || op == .Mod || op == .Pow) {
        site :: if dispatch == .Prelude(_, location) -> location else -> MIRPanicLoc?{None}
        location :: lower_numeric_location(p, c, &m, &f, instruction, site)
        return lower_fixed_trap_floor(p, c, &m, &f, dst, op, left_ty, left_value, right_value, location)
    }
    word_op :: lower_word_op(op) ?? return lower_fail(&m, &f, "operator {lower_binary_name(op)} on {mir_type_display_name(left_ty)} is not lowered at O0 yet")
    // A Primitive exact Int Add, Sub or Mul (codegen's read-list walk index
    // advance and pattern counts) is Rust's JetInt operator, which is the
    // jet_int_* route a Prelude dispatch names: the same exact arithmetic.
    if exact {
        if op == {
            .Add -> return lower_exact_arithmetic(&m, &f, dst, word_op, left_value, right_value, "jet_int_add")
            .Sub -> return lower_exact_arithmetic(&m, &f, dst, word_op, left_value, right_value, "jet_int_sub")
            .Mul -> return lower_exact_arithmetic(&m, &f, dst, word_op, left_value, right_value, "jet_int_mul")
            else -> {}
        }
        return lower_fail(&m, &f, "exact Int operator {lower_binary_name(op)} without a Prelude route")
    }
    if left_layout != lir_layout_word() -> return lower_fail(&m, &f, "operator {lower_binary_name(op)} on {mir_type_display_name(left_ty)} is not lowered at O0 yet")
    narrow :: lower_narrow_bits(left_ty)
    checked :: if fixed_trap -> MIRBinaryOverflow.Trap else -> overflow
    can_trap :: lower_operation_can_stop(p, c, m, instruction.operation)
    site :: if dispatch == .Prelude(_, location) -> location else -> MIRPanicLoc?{None}
    location :: if can_trap -> lower_numeric_location(p, c, &m, &f, instruction, site) else -> [LIRValueID]{}
    if narrow > 0 -> return lower_narrow_binary(p, c, &m, &f, dst, word_op, checked, lower_narrow_signed(left_ty), narrow, left_value, right_value, location)
    if fixed_trap && (word_op == .Shl || word_op == .Shr) {
        // Rust checked_shl/checked_shr: a count outside 0..<64 stops.
        width :: lower_const(&f, 64)
        out_of_range :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: out_of_range, condition: LIRCondition.UGe, left: right_value, right: width})
        lower_numeric_shift_check(p, c, &m, &f, out_of_range, word_op, right_value, unsigned, 64, location)
    }
    if word_op == .Div || word_op == .Rem {
        zero :: lower_const(&f, 0)
        if can_trap {
            is_zero :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: is_zero, condition: LIRCondition.Eq, left: right_value, right: zero})
            lower_numeric_check(p, Val(c), &m, &f, is_zero, location, "divided by zero")
        }
        // Unsigned division has no overflowing quotient (FixedArithmetic.rs:350-396).
        if unsigned -> return lower_emit(&f, LIRInst.Binary{dst: dst, op: if word_op == .Div -> LIRBinaryOp.UDiv else -> LIRBinaryOp.URem, left: left_value, right: right_value})
        if !can_trap && word_op == .Div -> return lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Div, left: left_value, right: right_value})
        minus_one :: lower_const(&f, -1)
        is_minus_one :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_minus_one, condition: LIRCondition.Eq, left: right_value, right: minus_one})
        if word_op == .Rem {
            // `x % -1` is 0 for every x (fixed remainder is wrapping_rem:
            // Prelude/Core/FixedArithmetic.rs:377-396); IDIV faults on
            // MIN % -1, so a -1 divisor skips it.
            rem_block :: lower_new_block(&f)
            merge_block :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: is_minus_one, then_target: lower_target(merge_block, [LIRValueID]{zero}), else_target: lower_target(rem_block, [LIRValueID]{})})
            lower_start(&f, rem_block, [LIRValueID]{})
            remainder :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: remainder, op: LIRBinaryOp.Rem, left: left_value, right: right_value})
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{remainder})})
            return lower_start(&f, merge_block, [LIRValueID]{dst})
        }
        // MIN / -1 is the only overflowing quotient (and faults on x86-64).
        minimum :: lower_const(&f, -9223372036854775807 - 1)
        is_minimum :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_minimum, condition: LIRCondition.Eq, left: left_value, right: minimum})
        both := lower_flag(&f)
        lower_logic(&f, both, true, is_minus_one, is_minimum)
        if can_trap -> lower_numeric_check(p, Val(c), &m, &f, both, location, lower_numeric_overflow_message("div"))
    }
    result_op :: if unsigned && word_op == .Shr -> LIRBinaryOp.UShr else -> word_op
    if checked == .Trap && (word_op == .Add || word_op == .Sub || word_op == .Mul) {
        // The operation first, then its overflow test: Select fuses the pair
        // and the branch into `add; jo stop` (x64_binary_sets_overflow).
        lower_emit(&f, LIRInst.Binary{dst: dst, op: result_op, left: left_value, right: right_value})
        overflowed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Overflows{dst: overflowed, op: if unsigned -> lower_unsigned_overflow_op(word_op) else -> word_op, left: left_value, right: right_value})
        operation :: if word_op == .Add -> "add" else if word_op == .Sub -> "sub" else -> "mul"
        return lower_numeric_check(p, Val(c), &m, &f, overflowed, location, lower_numeric_overflow_message(operation))
    }
    lower_emit(&f, LIRInst.Binary{dst: dst, op: result_op, left: left_value, right: right_value})
}

// F32's public carrier is a word, not an integer value: enter SSE via Bitcast.
fn lower_float32_binary(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, op: MIRBinaryOp, left: LIRValueID, right: LIRValueID, ty: MIRType) Never! {
    a :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
    b :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Bitcast{dst: a, src: left})
    lower_emit(&f, LIRInst.Bitcast{dst: b, src: right})
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if lower_condition_of(op) == .Val(condition) {
        return lower_emit(&f, LIRInst.Compare{dst: dst, condition: condition, left: a, right: b})
    }
    result :: lower_new_value(&f, lir_layout_float32(), LIRDrop.Trivial, None)
    lower_float_binary(&m, &f, result, op, ty, true, a, b)
    if f.failed -> return
    lower_emit(&f, LIRInst.Bitcast{dst: dst, src: result})
}

// Float and F32 arithmetic: SSE2 for `+ - * /`; `%` (truncated remainder) and
// `**` are the C library's fmod/fmodf and pow/powf, which the compiled runtime
// links (-lm).
fn lower_float_binary(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, op: MIRBinaryOp, ty: MIRType, single: Bool, left: LIRValueID, right: LIRValueID) Never! {
    if op == {
        .Add -> lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Add, left: left, right: right})
        .Sub -> lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Sub, left: left, right: right})
        .Mul -> lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Mul, left: left, right: right})
        .Div -> lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Div, left: left, right: right})
        .FloorDiv -> {
            quotient :: lower_new_value(&f, if single -> lir_layout_float32() else -> lir_layout_float(), LIRDrop.Trivial, None)
            lower_emit(&f, LIRInst.Binary{dst: quotient, op: LIRBinaryOp.Div, left: left, right: right})
            lower_call_runtime(&m, &f, if single -> "floorf" else -> "floor", [LIRValueID]{quotient}, Val(dst))
        }
        .Rem -> lower_call_runtime(&m, &f, if single -> "fmodf" else -> "fmod", [LIRValueID]{left, right}, Val(dst))
        .Pow -> lower_call_runtime(&m, &f, if single -> "powf" else -> "pow", [LIRValueID]{left, right}, Val(dst))
        else -> lower_fail(&m, &f, "operator {lower_binary_name(op)} on {mir_type_display_name(ty)} is not lowered at O0 yet")
    }
}

fn lower_unary(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, op: MIRUnaryOp, value: MIRValueID) Never! {
    if instruction.result == .Val(result) {
        if c.fixed_literals.get(result.value) != None -> return lower_alias_absent(&f, instruction)
    }
    operand :: lower_use(&m, &f, value) ?? return
    ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "operand {value.value} has no checked type")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "unary operator has no result")
    layout :: lower_value_layout(f, operand)
    if lower_repr(p, ty) == .Float32Bits {
        if op == .Not -> return lower_fail(&m, &f, "`not` on F32 is not lowered at O0 yet")
        sign :: lower_const(&f, 2147483648)
        return lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Xor, left: operand, right: sign})
    }
    if op == .Not {
        if layout == lir_layout_bool() {
            no :: lower_const_flag(&f, 0)
            return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: operand, right: no})
        }
        if layout == lir_layout_word() && !lower_is_exact_int(ty) {
            // An unsigned narrow value flips only its own `bits`.
            narrow :: lower_narrow_bits(ty)
            ones :: lower_const(&f, if narrow > 0 && !lower_narrow_signed(ty) -> lower_narrow_max(false, narrow) else -> -1)
            return lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Xor, left: operand, right: ones})
        }
        if layout == lir_layout_word() {
            // Exact Int `not v` is `-v - 1` (jet_int_not): an inline word flips
            // in place and stays inline; a big integer takes the runtime's
            // exact xor with -1, which is the same value.
            minus_one :: lower_const(&f, -1)
            slow_block :: lower_new_block(&f)
            merge_block :: lower_new_block(&f)
            no_args :: [LIRValueID]{}
            lower_inline_branch(&f, [LIRValueID]{operand}, slow_block, None)
            fast :: lower_word(&f)
            lower_emit(&f, LIRInst.Binary{dst: fast, op: LIRBinaryOp.Xor, left: operand, right: minus_one})
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{fast})})
            lower_start_cold(&f, slow_block, no_args)
            slow :: lower_word(&f)
            lower_call_runtime(&m, &f, "jet_int_bit_xor", [LIRValueID]{operand, minus_one}, Val(slow))
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge_block, [LIRValueID]{slow})})
            return lower_start(&f, merge_block, [LIRValueID]{dst})
        }
        return lower_fail(&m, &f, "`not` on {mir_type_display_name(ty)} is not lowered at O0 yet")
    }
    if layout.class == .Float {
        // IEEE negation flips the sign bit (so -0.0 and NaN keep their meaning);
        // an F32's is bit 31 of its zero-extended word.
        sign :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
        lower_emit(&f, LIRInst.Const{dst: sign, value: if layout == lir_layout_float32() -> 2147483648 else -> -9223372036854775807 - 1})
        return lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Xor, left: operand, right: sign})
    }
    if layout != lir_layout_word() -> return lower_fail(&m, &f, "negation of {mir_type_display_name(ty)} is not lowered at O0 yet")
    zero :: lower_const(&f, 0)
    if lower_is_exact_int(ty) -> return lower_exact_arithmetic(&m, &f, dst, LIRBinaryOp.Sub, zero, operand, "jet_int_sub")
    location :: lower_numeric_location(p, c, &m, &f, instruction, None)
    narrow :: lower_narrow_bits(ty)
    if narrow > 0 {
        negated :: lower_numeric_binary(&f, LIRBinaryOp.Sub, zero, operand)
        lower_narrow_check(p, c, &m, &f, negated, lower_narrow_signed(ty), narrow, location, lower_numeric_overflow_message("sub"))
        return lower_emit(&f, LIRInst.Move{dst: dst, src: negated})
    }
    // Fixed negation traps on signed MIN or a nonzero unsigned operand, the
    // unrepresentable results (core-library.md:3097-3098), instead of wrapping.
    overflowed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Overflows{dst: overflowed, op: if lower_is_unsigned_word(ty) -> LIRBinaryOp.USub else -> LIRBinaryOp.Sub, left: zero, right: operand})
    lower_numeric_check(p, Val(c), &m, &f, overflowed, location, lower_numeric_overflow_message("sub"))
    lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Sub, left: zero, right: operand})
}

// ---------------------------------------------------------------------------
// Strings, printing and calls.

// Display text of one value as a String; `owned` tells whether the caller
// must drop it. Strings are displayed as themselves.
struct LowerText {
    value: LIRValueID
    owned: Bool
}

fn lower_display(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: MIRValueID) -> LowerText? {
    lowered :: lower_use(&m, &f, value) ?? return None
    ty :: lower_value_type(c, value) ?? {
        lower_fail(&m, &f, "displayed value {value.value} has no checked type")
        return None
    }
    if lower_text_type(ty) -> return Val(LowerText{value: lowered, owned: false})
    // A nominal type's selected Show/Display impl or structural text wins over
    // its erased scalar representation (MIRRust.rs selected_trait_impl_for_type).
    if lower_type_def(p, ty) == .Val(_) -> return lower_display_boxed(p, c, &m, &f, ty, lowered)
    if lower_repr(p, ty) == {
        .Word | .Flag | .FloatBits | .Float32Bits -> {}
        else -> return lower_display_boxed(p, c, &m, &f, ty, lowered)
    }
    symbol :: if lower_repr(p, ty) == {
        .ExactInt -> "jet_rt_int_to_string"
        .Word -> if {
            ty.kind == .Char -> "jet_rt_char_to_string"
            lower_is_unsigned_word(ty) -> "jet_rt_u64_to_string"
            else -> "jet_rt_i64_to_string"
        }
        .Flag -> "jet_rt_bool_to_string"
        .FloatBits -> "jet_rt_float_to_string"
        .Float32Bits -> "jet_rt_float32_to_string"
        else -> "jet_rt_i64_to_string"
    }
    text :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_string_drop"}, None)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{lowered}, Val(text))
    Val(LowerText{value: text, owned: true})
}

fn lower_build_string(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, parts: [MIRStringPart]) Never! {
    // A literal whose sole use is an rt_static_text argument is never built.
    if instruction.result == .Val(result) {
        if c.static_text.elided.get(result.value) ?? false -> return lower_alias_absent(&f, instruction)
    }
    // Every checked string literal is a BuildString (Rust tir_to_mir StrLit);
    // one with only literal parts is its immortal header (StaticText.jet).
    if lower_static_text_literal_parts(parts) == .Val(text) {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "string literal has no result")
        return lower_emit(&f, LIRInst.DataAddress{dst: dst, data: lower_immortal_text(&m, text)})
    }
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    loop part in parts {
        if part.kind == {
            .Literal(text) -> {
                args := [LIRValueID]{builder}
                loop arg in lower_static_text(&m, &f, text) -> &args.push(arg)
                lower_call_runtime(&m, &f, "jet_rt_string_builder_push_static", args, None)
            }
            .Interpolation(value, format) -> {
                if format != .Display && format != .Debug -> return lower_fail(&m, &f, "this interpolation format is not lowered at O0 yet")
                ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "interpolation value has no checked type")
                operand :: if lower_repr(p, ty) == .Absent -> None else -> lower_use(&m, &f, value)
                mode :: if format == .Debug -> LowerRenderMode.Debug else -> LowerRenderMode.Display
                text :: lower_render_value(p, &m, &f, ty, operand, mode) ?? return
                lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, text.value}, None)
                if text.owned -> lower_emit(&f, LIRInst.Drop{value: text.value})
            }
        }
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "string interpolation has no result")
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(dst))
}

fn lower_semantic(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, semantic: MIRSemanticOp) Never! {
    if semantic == .SharedGuardWait(_, guard, condition, predicate) -> return lower_condition_wait(p, c, &m, &f, instruction, guard, condition, predicate)
    if semantic == .ConditionNotify(_, condition, all) -> return lower_condition_notify(p, c, &m, &f, instruction, condition, all)
    if semantic == .TextPatternMatch(_, subject, parts) -> return lower_scan_match(p, c, &m, &f, instruction, subject, Val(parts), None)
    if semantic == .BinaryPatternMatch(_, subject, parts) -> return lower_scan_match(p, c, &m, &f, instruction, subject, None, Val(parts))
    if semantic == .CursorTakePattern(receiver, place, parts) -> return lower_scan_take(p, c, &m, &f, instruction, receiver, place, Val(parts), None)
    if semantic == .ReaderTakePattern(receiver, place, parts) -> return lower_scan_take(p, c, &m, &f, instruction, receiver, place, None, Val(parts))
    if semantic == .DecodeUnder(_, segment, inner) -> return lower_codec_under(p, c, &m, &f, instruction, segment, inner)
    if semantic == .Print(call, value) {
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "print names missing Prelude call {call.value}")
        text :: lower_show(p, c, &m, &f, value) ?? return
        flush :: lower_const_flag(&f, 1)
        symbol :: if m.test_harness -> "jet_rt_test_print" else -> lower_runtime_symbol(row)
        lower_call_runtime(&m, &f, symbol, [LIRValueID]{text.value, flush}, None)
        // A printed temporary is released by the release plan.
        if text.owned -> lower_emit(&f, LIRInst.Drop{value: text.value})
        return lower_alias_absent(&f, instruction)
    }
    if semantic == .StructLiteral(type_id, fields, extra, boxed_fields) -> return lower_struct_literal(p, c, &m, &f, instruction, type_id, fields, extra, boxed_fields)
    if semantic == .RequireStop(call, kind, condition, location, context, values, always_stops) -> return lower_require_stop(p, c, &m, &f, instruction, call, kind, condition, location, context, values, always_stops)
    if semantic == .NumericMethod(call, receiver) -> return lower_numeric_method(p, c, &m, &f, instruction, call, receiver)
    if semantic == .NumericBinaryMethod(call, receiver, argument) -> return lower_numeric_euclid(p, c, &m, &f, instruction, call, receiver, argument)
    if semantic == .OverflowOption(call, left, right, location) -> return lower_numeric_overflow(p, c, &m, &f, instruction, call, left, right, location)
    if semantic == .ClosureMethod(receiver, args, call) -> return lower_closure_method(p, c, &m, &f, instruction, receiver, args, call)
    if semantic == .BuiltinMethod(call, receiver, receiver_place, args, aggregate_fields) {
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "builtin method names missing Prelude call {call.value}")
        if lower_atomic_method(p, c, &m, &f, instruction, row, receiver, args) -> return
        if lower_value_builtin(p, c, &m, &f, instruction, row, receiver, args) -> return
        if lower_lazy_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_string_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args, aggregate_fields) -> return
        if lower_set_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_tally_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_queue_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_priority_queue_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_bits_clear(p, c, &m, &f, instruction, row, receiver, args) -> return
        if lower_list_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_map_method(p, c, &m, &f, instruction, row, receiver, receiver_place, args) -> return
        if lower_ordering_method(p, c, &m, &f, instruction, row, receiver, args) -> return
        if aggregate_fields == None && lower_runtime_route(lower_route_symbol(row)) != None {
            values := [MIRValueID]{receiver}
            loop arg in args -> &values.push(arg)
            return lower_route_call(p, c, &m, &f, instruction, call, values, "BuiltinMethod")
        }
        return lower_fail(&m, &f, "builtin method {row.member} is not lowered at O0 yet")
    }
    // MIRRust.rs HandleMethod: the Prelude kernel called with the receiver
    // then the arguments (prelude_handle_method); Int results widen from the
    // native word, which the generated adapter does. Frame-scheduled methods
    // and kernels that also take a source location are reported (the
    // route's arity check rejects the latter).
    if semantic == .TaskGroup(call, kind, tasks) -> return lower_task_group(p, c, &m, &f, instruction, call, kind, tasks)
    if semantic == .Select(call, kind, values) -> return lower_task_select(p, c, &m, &f, instruction, call, kind, values)
    if semantic == .CoreClosureCall(call, kind, values, closure, _, _) {
        if kind == .Spawn -> return lower_task_spawn(p, c, &m, &f, instruction, call, values, closure)
        if kind == .Realtime -> return lower_realtime_start(p, c, &m, &f, instruction, call, values, closure)
        if kind == .Guard -> return lower_scope_guard(p, c, &m, &f, instruction, closure)
        if kind == .OnCommit || kind == .OnRollback -> return lower_transaction_hook(p, c, &m, &f, instruction, call, kind, values, closure)
    }
    if semantic == .HandleMethod(call, receiver, args, frame_schedule, _) {
        if lower_task_method(p, c, &m, &f, instruction, call, receiver, args) -> return
        if lower_transaction_method(p, c, &m, &f, instruction, call, receiver, args) -> return
        if lower_dyn_len(p, c, &m, &f, instruction, call, receiver, args) -> return
        if lower_dyn_mutation(p, c, &m, &f, instruction, call, receiver, args) -> return
        if frame_schedule != None {
            route_name :: lower_route_name(p, m.prelude_positions, call)
            return lower_fail(&m, &f, "frame-scheduled HandleMethod {route_name} is not lowered at O0 yet")
        }
        values := [MIRValueID]{receiver}
        loop arg in args -> &values.push(arg)
        return lower_route_call(p, c, &m, &f, instruction, call, values, "HandleMethod")
    }
    if semantic == .HostCall(call, args) {
        if lower_shared_guard_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_shared_access(p, c, &m, &f, instruction, call, args) -> return
        if lower_shared_same(p, c, &m, &f, instruction, call, args) -> return
        values :: lower_route_values(p, &m, &f, call, args, "HostCall") ?? return
        return lower_route_call(p, c, &m, &f, instruction, call, values, "HostCall")
    }
    if semantic == .StaticPreludeCall(call, args, owner_type_args, type_args) {
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "static call names missing Prelude row")
        if lower_encoding_list_leaf(p, c, &m, &f, instruction, call, args, type_args) -> return
        if lower_condition_new(p, c, &m, &f, instruction, row, args) -> return
        if lower_atomic_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_set_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_tally_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_queue_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_priority_queue_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_lazy_call(p, c, &m, &f, instruction, call, args) -> return
        if lower_bits_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_shared_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_task_group_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_list_concat(p, c, &m, &f, instruction, call, args) -> return
        if lower_codec_call(p, c, &m, &f, instruction, call, args, type_args) -> return
        if owner_type_args.len() > 0 || type_args.len() > 0 {
            route_name :: lower_route_name(p, m.prelude_positions, call)
            return lower_fail(&m, &f, "generic StaticPreludeCall {route_name} is not lowered at O0 yet")
        }
        if "{row.module_name}.{row.member}" == "core.compare.eq" && args.len() == 2 -> return lower_core_equal(p, c, &m, &f, instruction, args[0].value, args[1].value)
        values :: lower_route_values(p, &m, &f, call, args, "StaticPreludeCall") ?? return
        return lower_route_call(p, c, &m, &f, instruction, call, values, "StaticPreludeCall")
    }
    // MIRRust.rs AllocNew: the allocator constructor is a plain route call
    // (jet_mem::JetArena::new, ...::with_capacity); an inline-backed Fixed
    // has no route and is reported by lower_route_values.
    if semantic == .AllocNew(call, _, inline_size, args) {
        if inline_size != None {
            route_name :: lower_route_name(p, m.prelude_positions, call)
            return lower_fail(&m, &f, "AllocNew {route_name} with inline backing is not lowered at O0 yet")
        }
        values :: lower_route_values(p, &m, &f, call, args, "AllocNew") ?? return
        return lower_route_call(p, c, &m, &f, instruction, call, values, "AllocNew")
    }
    // MIRRust.rs semantic: both are a plain Prelude call with their values.
    if semantic == .MathBuiltin(_, call, args) -> return lower_route_call(p, c, &m, &f, instruction, call, args, "MathBuiltin")
    if semantic == .PreciseBuiltin(_, call, args) -> return lower_route_call(p, c, &m, &f, instruction, call, args, "PreciseBuiltin")
    if semantic == .TypedTextInterp(_, kind, literals, holes, trusted_html) -> return lower_typed_text_interp(p, c, &m, &f, instruction, kind, literals, holes, trusted_html)
    if semantic == .CarrierFact(_, receiver, field, notes) -> return lower_carrier_fact(p, c, &m, &f, instruction, receiver, field, notes)
    if semantic == .ReflectOf(type_name, path, display, fields) -> return lower_reflect_of(p, c, &m, &f, instruction, type_name, path, display, fields)
    if semantic == .HostBorrowCallback(callable, _) -> return lower_forward(c, &m, &f, instruction, callable)
    if semantic == .AmbientInput(call, prompt) {
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "AmbientInput names a missing route")
        route :: lower_runtime_route(mir_symbol_name(row.symbol)) ?? return lower_fail(&m, &f, "AmbientInput has no runtime C-ABI route")
        input :: lower_pointer(&f)
        if prompt == .Val(value) {
            text :: lower_use(&m, &f, value) ?? return
            lower_emit(&f, LIRInst.Copy{dst: input, src: text})
        } else {
            lower_emit(&f, LIRInst.Const{dst: input, value: 0})
        }
        return lower_route_result(p, c, &m, &f, instruction, route, [LIRValueID]{input}, "AmbientInput", row.member, [String]{})
    }
    semantic_name :: lower_semantic_name(p, m.prelude_positions, semantic)
    lower_fail(&m, &f, "semantic operation {semantic_name} is not lowered at O0 yet")
}

// Reflection keeps typed field rows in runtime Value records. The checked
// field's universal Show projection is its display text, not its storage.
fn lower_reflect_record(m: &LowerModule, f: &LowerFunction, type_name: String, path: String, display: LIRValueID, fields: LIRValueID) -> LIRValueID Never! {
    type_text :: lower_require_literal(&m, &f, type_name)
    path_text :: lower_require_literal(&m, &f, path)
    value :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_jet_reflect_value"}, None)
    lower_call_runtime(&m, &f, "jet_rt_record_new_jet_reflect_value", [LIRValueID]{type_text, path_text, display, fields}, Val(value))
    lower_emit(&f, LIRInst.Drop{value: type_text})
    lower_emit(&f, LIRInst.Drop{value: path_text})
    value
}

fn lower_reflect_of(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, type_name: String, path: String, display: MIRValueID, fields: [MIRReflectField]) Never! {
    result_ty :: lower_checked_type(c, instruction) ?? return
    dst :: lower_result(p, c, &m, &f, instruction)
    rows :: lower_pointer(&f)
    count :: lower_const(&f, fields.len())
    lower_call_runtime(&m, &f, "jet_rt_record_seq_list_rec_jet_reflect_field_new", [LIRValueID]{count}, Val(rows))
    loop field in fields {
        text :: lower_show(p, c, &m, &f, field.value) ?? return
        empty :: lower_pointer(&f)
        zero :: lower_const(&f, 0)
        lower_call_runtime(&m, &f, "jet_rt_record_seq_list_rec_jet_reflect_field_new", [LIRValueID]{zero}, Val(empty))
        value :: lower_reflect_record(&m, &f, field.type_name, field.path, text.value, empty)
        if text.owned -> lower_emit(&f, LIRInst.Drop{value: text.value})
        name :: lower_require_literal(&m, &f, field.name)
        row :: lower_pointer(&f)
        lower_call_runtime(&m, &f, "jet_rt_record_new_jet_reflect_field", [LIRValueID]{name, value}, Val(row))
        lower_emit(&f, LIRInst.Drop{value: name})
        lower_call_runtime(&m, &f, "jet_rt_record_seq_list_rec_jet_reflect_field_push", [LIRValueID]{rows, row}, None)
    }
    display_text :: lower_use(&m, &f, display) ?? return
    value :: lower_reflect_record(&m, &f, type_name, path, display_text, rows)
    if lower_value_owned(c, display) -> lower_drop_value(p, c, &m, &f, display)
    if lower_record_handle(p, result_ty) != None -> return lower_record_from_runtime(p, &m, &f, result_ty, value, dst)
    expected :: LowerRepr.Handle{drop: "jet_rt_handle_drop_jet_reflect_value", clone: "jet_rt_handle_clone_jet_reflect_value"}
    if lower_repr(p, result_ty) != expected -> return lower_fail(&m, &f, "ReflectOf result has no checked reflection record layout")
    if dst == .Val(kept) {
        lower_emit(&f, LIRInst.Move{dst: kept, src: value})
    } else {
        lower_emit(&f, LIRInst.Drop{value: value})
    }
}

// A carrier fact borrows the Err report and copies its checked field. The
// success arm has no report: notes is empty and partial is absent.
fn lower_carrier_fact(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, field: MIRFieldID, notes: Bool) Never! {
    receiver_ty :: lower_value_type(c, receiver) ?? return
    report_ty :: if receiver_ty.kind == .Result(_, err) -> err else -> {
        lower_fail(&m, &f, "carrier fact requires a checked Result")
        return
    }
    result_ty :: lower_checked_type(c, instruction) ?? return
    found :: lower_struct_field(p, report_ty, field) ?? return lower_fail(&m, &f, "carrier report field is not stored natively")
    outcome :: lower_use(&m, &f, receiver) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
    if notes -> lower_storage_into(p, &f, dst, result_ty)
    result_tag :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: result_tag, base: outcome, offset: 0})
    failed :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: failed, condition: LIRCondition.Eq, left: result_tag, right: zero})
    failure :: lower_new_block(&f)
    success :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(failure, [LIRValueID]{}), else_target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    report :: lower_read_at(p, &f, outcome, 8, report_ty) ?? return
    address :: lower_struct_storage_address(&f, report, found)
    if notes {
        value :: lower_read_at(p, &f, address.base, address.offset, found.ty) ?? return
        lower_inline_clone(p, &m, &f, value, dst, found.ty)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    } else {
        box :: lower_pointer(&f)
        lower_alloc(&m, &f, box, lower_option_box_size(p, found.ty))
        if lower_repr(p, found.ty) != .Absent {
            value :: lower_read_at(p, &f, address.base, address.offset, found.ty) ?? return
            layout :: lower_repr_layout(lower_repr(p, found.ty)) ?? return
            copied :: lower_new_value(&f, layout, LIRDrop.Trivial, found.ty.identity)
            lower_clone_into(p, &m, &f, value, copied, found.ty)
            lower_write_at(p, &f, box, 0, copied, found.ty)
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{box})})
    }
    lower_start(&f, success, [LIRValueID]{})
    if notes {
        offsets :: [Int]{0, 8, 16}
        loop offset in offsets -> lower_emit(&f, LIRInst.Store{base: dst, offset: offset, value: zero})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
    } else {
        absent :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: absent, value: 0})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{absent})})
        lower_start(&f, done, [LIRValueID]{dst})
    }
    if instruction.result == None -> lower_map_drop_value(p, &m, &f, dst, result_ty)
}

// The variant (and, for Prelude routes, the route) an unlowered semantic
// operation reports, so a count of first blockers names what is missing.
// `positions` is the program's Prelude position index
// (lower_prelude_positions; LowerModule.prelude_positions while lowering),
// so `jet emit --mir` names routes the way lowering reports them.
fn lower_route_name(p: MIRProgram, positions: [U64:Int], call: MIRPreludeCallID) -> String Never! {
    row :: positions.get(call.value) ?? return "?"
    "{p.prelude_calls[row].module_name}.{p.prelude_calls[row].member}"
}

fn lower_semantic_name(p: MIRProgram, positions: [U64:Int], semantic: MIRSemanticOp) -> String Never! {
    if semantic == {
        .MathBuiltin(_, call, _) -> "MathBuiltin {lower_route_name(p, positions, call)}"
        .PreciseBuiltin(_, call, _) -> "PreciseBuiltin {lower_route_name(p, positions, call)}"
        .Print(_, _) -> "Print"
        .AmbientInput(_, _) -> "AmbientInput"
        .RequireStop(_, _, _, _, _, _, _) -> "RequireStop"
        .LayoutCompare(_, _, _, _) -> "LayoutCompare"
        .ReflectOf(_, _, _, _) -> "ReflectOf"
        .LayoutLiteral(_) -> "LayoutLiteral"
        .StructLiteral(_, _, _, _) -> "StructLiteral"
        .CellGuardProject(_, _, _, _, _, _) -> "CellGuardProject"
        .SharedGuardMap(_, _, _, _) -> "SharedGuardMap"
        .SharedGuardSplit(_, _, _, _, _, _) -> "SharedGuardSplit"
        .SharedGuardWait(_, _, _, _) -> "SharedGuardWait"
        .ConditionNotify(_, _, _) -> "ConditionNotify"
        .AllocNew(call, _, _, _) -> "AllocNew {lower_route_name(p, positions, call)}"
        .ColumnarRead(_, _, _, _, _) -> "ColumnarRead"
        .StaticPreludeCall(call, _, _, _) -> "StaticPreludeCall {lower_route_name(p, positions, call)}"
        .DecodeUnder(_, _, _) -> "DecodeUnder"
        .HardwareCall(call, _, _, _) -> "HardwareCall {lower_route_name(p, positions, call)}"
        .BuiltinMethod(call, _, _, _, _) -> "BuiltinMethod {lower_route_name(p, positions, call)}"
        .OptionLift2(call, _, _, _) -> "OptionLift2 {lower_route_name(p, positions, call)}"
        .ClosureMethod(_, _, call) -> "ClosureMethod {lower_route_name(p, positions, call)}"
        .HostBorrowCallback(_, _) -> "HostBorrowCallback"
        .TextPatternMatch(_, _, _) -> "TextPatternMatch"
        .BinaryPatternMatch(_, _, _) -> "BinaryPatternMatch"
        .CursorTakePattern(_, _, _) -> "CursorTakePattern"
        .ReaderTakePattern(_, _, _) -> "ReaderTakePattern"
        .NumericMethod(call, _) -> "NumericMethod {lower_route_name(p, positions, call)}"
        .NumericBinaryMethod(call, _, _) -> "NumericBinaryMethod {lower_route_name(p, positions, call)}"
        .OverflowOption(call, _, _, _) -> "OverflowOption {lower_route_name(p, positions, call)}"
        .HandleMethod(call, _, _, _, _) -> "HandleMethod {lower_route_name(p, positions, call)}"
        .PluginInvoke(_, _, _, _, _) -> "PluginInvoke"
        .HTTPRouterRegister(_, _, _, _, _, _, _, _) -> "HTTPRouterRegister"
        .CoreClosureCall(call, _, _, _, _, _) -> "CoreClosureCall {lower_route_name(p, positions, call)}"
        .TaskGroup(_, _, _) -> "TaskGroup"
        .Select(_, _, _) -> "Select"
        .PolicyFunction(_, _) -> "PolicyFunction"
        .InterruptFunction(_, _) -> "InterruptFunction"
        .CarrierFact(_, _, _, _) -> "CarrierFact"
        .GCEdit(_, _, _, _, _, _, _) -> "GCEdit"
        .TypedTextInterp(_, _, _, _, _) -> "TypedTextInterp"
        .CCallback(_, _, _) -> "CCallback"
        .HostCall(call, _) -> "HostCall {lower_route_name(p, positions, call)}"
    }
}

fn lower_function_index(m: LowerModule, id: MIRFunctionID) -> Int Never! {
    m.mir_rows.get(id.value) ?? -1
}

// Formatting returns its owned render directly; an unquoted borrowed String
// alone needs a clone, not a builder round trip.
fn lower_prelude_render(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, value: MIRValueID, mode: LowerRenderMode) Never! {
    ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "format value has no checked type")
    operand :: if lower_repr(p, ty) == .Absent -> None else -> lower_use(&m, &f, value)
    text :: lower_render_value(p, &m, &f, ty, operand, mode) ?? return
    if text.owned -> return lower_alias(c, &f, instruction, text.value)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return lower_fail(&m, &f, "format text has no result")
    lower_call_runtime(&m, &f, "jet_rt_string_clone", [LIRValueID]{text.value}, Val(dst))
}

fn lower_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, callee: MIRCallee, args: [MIRCallArg], type_args: [MIRType]) Never! {
    if lower_is_static_text_call(m, callee) -> return lower_static_text_call(p, c, &m, &f, instruction, args)
    if callee == .TraitMethod(method, bound, receiver) -> return lower_trait_call(p, c, &m, &f, instruction, method, bound, receiver, args, type_args)
    if callee == .Foreign(foreign) && m.asm_foreign.get(foreign.value) == None {
        lower_c_import_call(p, c, &m, &f, instruction, foreign.value, args, type_args)
        return
    }
    if callee == .Prelude(call) {
        if lower_lazy_call(p, c, &m, &f, instruction, call, args) -> return
        if lower_codec_call(p, c, &m, &f, instruction, call, args, type_args) -> return
        // JetCodegen interns `shared.read` / `shared.edit` (Expressions.jet
        // jet_codegen_lower_host_method) and the Shared owner routes as a
        // Prelude Call, not a HostCall: both reach the native Shared kernels,
        // never an undefined `jet_shared_*` symbol.
        if lower_shared_guard_new(p, c, &m, &f, instruction, call, args) -> return
        if lower_shared_access(p, c, &m, &f, instruction, call, args) -> return
        if lower_shared_same(p, c, &m, &f, instruction, call, args) -> return
        row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "call names missing Prelude call {call.value}")
        if row.module_name == "core.mem" {
            values := [MIRValueID]{}
            loop arg in args -> &values.push(arg.value)
            if lower_c_mem_route(p, c, &m, &f, instruction, call, values) -> return
        }
        symbol :: lower_runtime_symbol(row)
        if lower_typed_call(p, c, &m, &f, instruction, symbol, args) -> return
        if args.len() == 1 {
            if symbol == "jet_fmt_display" -> return lower_prelude_render(p, c, &m, &f, instruction, args[0].value, LowerRenderMode.Display)
            if symbol == "jet_fmt_debug" -> return lower_prelude_render(p, c, &m, &f, instruction, args[0].value, LowerRenderMode.Debug)
            if symbol == "jet_fmt_show" -> return lower_prelude_render(p, c, &m, &f, instruction, args[0].value, LowerRenderMode.Show)
        }
        if type_args.len() > 0 -> return lower_fail(&m, &f, "generic Prelude calls are not lowered at O0 yet")
        lowered := [LIRValueID]{}
        // Budget can-stop operations of a compiler callable (#4720 SP3): the
        // runtime names the spending function by its row in the program
        // being lowered, which MIR cannot know, so it leads the (start, end) span.
        if symbol == "jet_rt_comptime_enter" || symbol == "jet_rt_comptime_step" {
            owner :: m.mir_sources[f.builder.id.value].copy()
            &lowered.push(lower_const(&f, owner))
        }
        loop arg in args {
            if lower_is_absent(f, arg.value) -> next
            value :: lower_use(&m, &f, arg.value) ?? return
            &lowered.push(value)
        }
        dst :: lower_result(p, c, &m, &f, instruction)
        return lower_call_runtime_typed(c, &m, &f, instruction, lower_runtime_symbol(row), lowered, dst)
    }
    // The concrete callee: the instance Mono.jet registered for this call's
    // owner and type arguments (the original when nothing binds). A callee
    // the front end already specialized is registered as itself (a generic
    // original never is), and its listed type arguments bind nothing.
    target :: if callee == {
        .User(function) -> lower_instance_id(function, if lower_function_index(m, function) >= 0 -> [MIRType]{} else -> type_args)
        .Associated(function, owner) | .Method(function, owner) -> lower_instance_id(function, lower_call_bindings(Val(owner), type_args))
        .Foreign(foreign) -> m.asm_foreign.get(foreign.value) ?? {
            lower_fail(&m, &f, "inline asm: foreign callee has no checked assembly function")
            return
        }
        else -> {
            lower_fail(&m, &f, "this callee kind is not lowered at O0 yet")
            return
        }
    }
    index :: lower_function_index(m, target)
    if index < 0 -> return lower_fail(&m, &f, "call to missing function {target.value}")
    lowered := [LIRValueID]{}
    writebacks := [LowerWriteBack]{}
    temporaries := LowerCallTemps{drops: [LIRValueID]{}, taken: [MIRValueID]{}}
    if !lower_call_args(p, c, &m, &f, args, &lowered, &writebacks, &temporaries) -> return
    signature :: m.mir_signatures[index].copy()
    result_bytes :: m.mir_results[index].copy()
    if result_bytes > 0 {
        // An inline aggregate result lands in storage the caller supplies.
        storage :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: storage, size: result_bytes, align: 8})
        call_args := [LIRValueID]{storage}
        loop value in lowered -> &call_args.push(value)
        lower_emit(&f, LIRInst.Call{dst: None, signature: signature, callee: LIRCallee.Function{id: LIRFunctionID{value: index}}, args: call_args})
        loop writeback in writebacks -> lower_write_back(p, c, &m, &f, writeback, None)
        lower_release_call_temps(p, c, &m, &f, temporaries)
        return
    }
    dst := lower_result(p, c, &m, &f, instruction)
    if dst == None {
        // A result the caller ignores still needs a value to land in.
        if m.signatures[signature.value].result == .Val(layout) -> dst = Val(lower_new_value(&f, layout, LIRDrop.Trivial, None))
    }
    lower_emit(&f, LIRInst.Call{dst: dst, signature: signature, callee: LIRCallee.Function{id: LIRFunctionID{value: index}}, args: lowered})
    loop writeback in writebacks -> lower_write_back(p, c, &m, &f, writeback, None)
    lower_release_call_temps(p, c, &m, &f, temporaries)
}

// What a call's argument lowering made for that call alone, released right
// after it (the callee only borrows them).
struct LowerCallTemps {
    // Owned trait boxes.
    drops: [LIRValueID]
    // Arguments a union wrapper the callee only reads took over
    // (lower_call_args): dropped after the call.
    taken: [MIRValueID]
}

fn lower_release_call_temps(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, temporaries: LowerCallTemps) Never! {
    loop temporary in temporaries.drops -> lower_emit(&f, LIRInst.Drop{value: temporary})
    loop payload in temporaries.taken -> lower_drop_value(p, c, &m, &f, payload)
}

// A call's argument values in order: a Write argument lends its place's
// cell, an absent (Unit) argument passes nothing. False when lowering failed.
fn lower_call_args(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, args: [MIRCallArg], lowered: &[LIRValueID], writebacks: &[LowerWriteBack], temporaries: &LowerCallTemps) -> Bool Never! {
    loop arg in args {
        if arg.access != .Write && arg.box_as_trait == .Val(target) {
            ty :: lower_value_type(c, arg.value) ?? return false
            if lower_trait_ref(p, ty) == None {
                boxed :: lower_trait_arg(p, c, &m, &f, arg, target) ?? return false
                &lowered.push(boxed)
                if arg.access == .Read -> &temporaries.drops.push(boxed)
                next
            }
        }
        if arg.access == .Write {
            writeback :: lower_write_arg(p, c, &m, &f, arg) ?? next
            &lowered.push(writeback.cell)
            &writebacks.push(writeback)
            next
        }
        if lower_is_absent(f, arg.value) -> next
        value :: lower_use(&m, &f, arg.value) ?? return false
        // MIRRust call_arg `Union::Variant(value)`: the member value lands
        // in a box of the union's structural enum. A callee that takes the
        // union over owns the box. One that only reads it gets a box in this
        // frame, borrowing the payload: the argument is dropped after the
        // call when it handed the payload over (codegen owned_last_use: a
        // temporary at its last use), else its owner still releases it. The
        // frame box's count is immortal (#5041 P2, as lower_present's), so a
        // callee's clone copies it rather than sharing this frame's storage.
        if arg.widen_to_union == .Val(coercion) {
            definition :: lower_type_def_by_id(p, coercion.union) ?? {
                lower_fail(&m, &f, "union widening to missing type {coercion.union.value}")
                return false
            }
            found :: lower_variant(definition, coercion.variant) ?? {
                lower_fail(&m, &f, "{definition.name} has no union member {coercion.variant}")
                return false
            }
            info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? {
                lower_fail(&m, &f, "{definition.name}.{coercion.variant} has no stored payload")
                return false
            }
            bytes :: lower_enum_box_size(p, definition)
            boxed := LIRValueID{value: -1}
            if arg.access == .Read {
                boxed = lower_frame_box(&f, bytes)
                if mir_call_arg_consumes(arg) -> &temporaries.taken.push(arg.value)
            } else {
                boxed = lower_pointer(&f)
                lower_alloc(&m, &f, boxed, bytes)
            }
            lower_store_word(&f, boxed, 0, lower_discriminant(found.index))
            lower_store_value(p, &m, &f, boxed, info.offset, arg.value, info.ty)
            &lowered.push(boxed)
            next
        }
        // A `[T#N]` widened into a `[T]` parameter is the List it is carried
        // as; a moved widening is MIRRust's `.to_vec()` copy, so the caller
        // keeps its own array.
        if arg.widen_fixed_to_list && arg.access == .Move {
            if lower_value_type(c, arg.value) == .Val(fixed) {
                if lower_list_element(fixed) == .Val(elem) {
                    list_ty :: mir_type_from_kind(MIRTypeKind.List{inner: elem})
                    widened :: lower_new_storage(p, &f, list_ty)
                    lower_inline_clone(p, &m, &f, value, widened, list_ty)
                    &lowered.push(widened)
                    next
                }
            }
        }
        &lowered.push(value)
    }
    !f.failed
}

// A Write argument: `cell` holds the caller place's value while the callee
// runs and points at it; the place takes the cell's value back afterwards.
// The cell is a stack slot of the caller's frame, or, for a Write parameter
// passed on, its own pointer to the original caller's storage.
struct LowerWriteBack {
    place: MIRPlaceID
    slot: Int
    cell: LIRValueID
}

// The checked place a Write argument lends (MIRRust.rs
// call_arg_for_function, :24754: the argument's place, else the place its
// value was read from or the Write parameter it is), as stable storage.
// None when the place carries no value (reported when it is missing).
fn lower_write_arg(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, arg: MIRCallArg) -> LowerWriteBack? {
    place :: lower_write_arg_place(c, arg) ?? {
        lower_fail(&m, &f, "Write argument {arg.value.value} has no checked place")
        return None
    }
    lower_write_place_arg(p, c, &m, &f, place)
}

fn lower_write_place_arg(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, place: MIRPlaceID) -> LowerWriteBack? {
    row :: lower_place_row(c.mir, c.place_rows, place) ?? {
        lower_fail(&m, &f, "place {place.value} is missing")
        return None
    }
    slot :: c.place_slots.get(place.value) ?? {
        lower_fail(&m, &f, "place {place.value} has no lowered root")
        return None
    }
    if lower_repr_layout(lower_repr(p, row.ty)) == None -> return None
    if c.slots[slot].cell {
        // The callee updates the cell's storage in place.
        walk :: lower_cell_walk(p, c, &m, &f, slot, row) ?? return None
        return Val(LowerWriteBack{place: place, slot: slot, cell: lower_address(&f, walk.base, walk.offset)})
    }
    // copy: the root value is read while the write-back setup emits into `&f`, so a view into
    // f.current would be live across those writes.
    root :: (f.current[slot].copy()) ?? {
        lower_fail(&m, &f, "place {place.value} has no value")
        return None
    }
    if row.projections.len() == 0 && c.slots[slot].write_param >= 0 {
        // copy: the write parameter's pointer is read while the write-back setup emits into `&f`,
        // so a view into f.params would be live across those writes.
        address :: (f.params[c.slots[slot].write_param].copy()) ?? {
            lower_fail(&m, &f, "Write parameter of place {place.value} has no pointer")
            return None
        }
        return Val(LowerWriteBack{place: place, slot: slot, cell: address})
    }
    if lower_is_inline(p, row.ty) {
        // The callee updates an inline aggregate in place: its storage is
        // the cell, and nothing is written back.
        if row.projections.len() == 0 -> return Val(LowerWriteBack{place: place, slot: slot, cell: root})
        write_root :: lower_slot_root_for_write(p, c, &m, &f, slot) ?? return None
        walk :: lower_walk_projections(p, c, &m, &f, write_root, c.slots[slot].ty, row.projections) ?? return None
        return Val(LowerWriteBack{place: place, slot: slot, cell: lower_address(&f, walk.base, walk.offset)})
    }
    current := root
    if row.projections.len() > 0 {
        write_root :: lower_slot_root_for_write(p, c, &m, &f, slot) ?? return None
        walk :: lower_walk_projections(p, c, &m, &f, write_root, c.slots[slot].ty, row.projections) ?? return None
        layout :: lower_repr_layout(lower_repr(p, row.ty)) ?? return None
        current = lower_new_value(&f, layout, LIRDrop.Trivial, row.ty.identity)
        lower_read_into(p, &f, current, walk.base, walk.offset, row.ty)
    }
    cell :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: cell, size: 8, align: 8})
    lower_write_at(p, &f, cell, 0, current, row.ty)
    Val(LowerWriteBack{place: place, slot: slot, cell: cell})
}

fn lower_write_arg_place(c: LowerContext, arg: MIRCallArg) -> MIRPlaceID? {
    if arg.place == .Val(place) -> return Val(place)
    lower_value_place(c, arg.value)
}

fn lower_value_place(c: LowerContext, value: MIRValueID) -> MIRPlaceID? {
    loop block in c.mir.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if result == value {
                    if instruction.operation == .ReadPlace(place) | .AddressOf(place, _) -> return Val(place)
                }
            }
        }
    }
    loop row in c.mir.places {
        if row.base == .Parameter(parameter) {
            if parameter == value && row.projections.len() == 0 -> return Val(row.id)
        }
    }
    None
}

// After the call: the place takes the value the callee left in the cell (the
// callee already dropped a replaced value).
fn lower_write_back(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, writeback: LowerWriteBack, rebound: MIRValueID?) Never! {
    row :: lower_place_row(c.mir, c.place_rows, writeback.place) ?? return
    repr :: lower_repr(p, row.ty)
    if repr == .Inline(_) -> return
    if c.slots[writeback.slot].cell {
        if rebound == .Val(value) {
            updated :: lower_read_at(p, &f, writeback.cell, 0, row.ty) ?? return
            lower_define(c, &f, value, updated)
        }
        return
    }
    layout :: lower_repr_layout(repr) ?? return
    if row.projections.len() == 0 {
        holder :: c.slots[writeback.slot]
        updated :: lower_new_value(&f, layout, lower_drop(&m, lower_repr(p, holder.ty), lower_is_owned(holder.ownership)), row.ty.identity)
        lower_read_into(p, &f, updated, writeback.cell, 0, row.ty)
        lower_set_slot(&f, writeback.slot, Val(updated))
        if rebound == .Val(value) -> lower_define(c, &f, value, updated)
    } else {
        // copy: the root value is read while the write-back emits into `&f` and rebinds f.current,
        // so a view of that slot would be live across those writes.
        root :: lower_slot_root_for_write(p, c, &m, &f, writeback.slot) ?? return lower_fail(&m, &f, "place {writeback.place.value} has no value")
        walk :: lower_walk_projections(p, c, &m, &f, root, c.slots[writeback.slot].ty, row.projections) ?? return
        updated :: lower_new_value(&f, layout, LIRDrop.Trivial, row.ty.identity)
        lower_read_into(p, &f, updated, writeback.cell, 0, row.ty)
        lower_write_at(p, &f, walk.base, walk.offset, updated, row.ty)
        if rebound == .Val(value) -> lower_define(c, &f, value, updated)
    }
}

// ---------------------------------------------------------------------------
// Drop glue: one LIR function per box type, taking the box. It releases the
// owned contents of the active shape, then the box itself.

struct LowerGlueField {
    offset: Int
    ty: MIRType
}

// One shape of a box: `selector` is the slot-0 value selecting it, or -1 when
// the box has a single shape and no discriminant.
struct LowerGlueShape {
    selector: Int
    fields: [LowerGlueField]
}

fn lower_glue_function(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    if glue.helper != "drop.structural" {
        if lower_close_method(p, m.close_methods, glue.ty) == .Val(method) -> return lower_close_drop_glue(p, &m, glue, method)
    }
    if lower_atomic_needs_drop(p, glue.ty) -> return lower_atomic_drop_glue(&m, glue)
    if lower_trait_ref(p, glue.ty) != None -> return lower_trait_glue(p, &m, glue)
    if lower_is_transaction(glue.ty) -> return lower_transaction_drop_glue(&m, glue)
    if lower_is_iter_cursor(glue.ty) -> return lower_iter_drop_glue(p, &m, glue)
    if glue.ty.kind == .List(elem) -> return lower_list_drop_glue(p, &m, glue, elem)
    if glue.ty.kind == .FixedList(elem, _) -> return lower_list_drop_glue(p, &m, glue, elem)
    if lower_map_entry(glue.ty) == .Val(entry) -> return lower_list_drop_glue(p, &m, glue, entry)
    if lower_set_element(glue.ty) != None {
        shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Set drop has no entry layout")
        return lower_list_drop_glue(p, &m, glue, shape.entry)
    }
    if lower_tally_element(glue.ty) != None {
        shape :: lower_map_shape(p, lower_tally_map(glue.ty)) ?? panic("Tally drop has no entry layout")
        return lower_list_drop_glue(p, &m, glue, shape.entry)
    }
    if lower_queue_element(glue.ty) != None -> return lower_helper_queue(p, &m, glue)
    if lower_priority_queue_element(glue.ty) == .Val(elem) -> return lower_list_drop_glue(p, &m, glue, elem)
    if glue.ty.kind == .Fn(_) | .SendFn(_, _, _) -> return lower_closure_drop_glue(&m, glue, false)
    if lower_is_scope_guard(glue.ty) -> return lower_closure_drop_glue(&m, glue, true)
    if lower_is_inline(p, glue.ty) -> return lower_inline_drop_glue(p, &m, glue)
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, None)
    f := lower_new_function(glue.id, "drop.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    boxed :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{boxed})
    shapes :: lower_glue_shapes(p, &m, &f, glue.ty)
    bytes :: lower_box_size(p, glue.ty)
    if glue.ty.kind == .Option(_) {
        // A null Option owns nothing.
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        is_null :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_null, condition: LIRCondition.Eq, left: boxed, right: null})
        done :: lower_new_block(&f)
        present :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: is_null, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Return{value: None})
        lower_start(&f, present, [LIRValueID]{})
    }
    // #5041 P2: drop gives up one owner of the box; only the last owner
    // drops the active shape's contents and frees it. A static box carries
    // an immortal count, so its release is never the last.
    owner :: lower_new_block(&f)
    last :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_rt_block_release", [LIRValueID]{boxed}, Val(last))
    shared :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(owner, [LIRValueID]{}), else_target: lower_target(shared, [LIRValueID]{})})
    lower_start(&f, shared, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lower_start(&f, owner, [LIRValueID]{})
    release :: lower_new_block(&f)
    if shapes.len() == 1 && shapes[0].selector < 0 {
        lower_glue_drop_fields(p, &m, &f, boxed, shapes[0].fields)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(release, [LIRValueID]{})})
    } else {
        discriminant :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: discriminant, base: boxed, offset: 0})
        loop shape in shapes {
            if shape.fields.len() == 0 -> next
            expected :: lower_const(&f, shape.selector)
            selected :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: selected, condition: LIRCondition.Eq, left: discriminant, right: expected})
            body :: lower_new_block(&f)
            next_block :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: selected, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
            lower_start(&f, body, [LIRValueID]{})
            lower_glue_drop_fields(p, &m, &f, boxed, shape.fields)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(release, [LIRValueID]{})})
            lower_start(&f, next_block, [LIRValueID]{})
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(release, [LIRValueID]{})})
    }
    lower_start(&f, release, [LIRValueID]{})
    size :: lower_const(&f, if bytes < 8 -> 8 else -> bytes)
    align :: lower_const(&f, 8)
    lower_call_runtime(&m, &f, "jet_rt_free", [LIRValueID]{boxed, size, align}, None)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_call_clone_glue(m: &LowerModule, f: &LowerFunction, ty: MIRType, source: LIRValueID, dst: LIRValueID) Never! {
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    id :: lower_clone_glue_id(&m, ty)
    lower_emit(&f, LIRInst.Call{dst: Val(dst), signature: signature, callee: LIRCallee.Function{id: id}, args: [LIRValueID]{source}})
}

// Box clone glue (#5041 P2): one more owner of the same box; writers detach
// a shared box first (box.unique), so it is never written while shared.
// An absent Option is null, and so is its copy. A box with an immortal count
// (a frozen static or a borrowed carrier's frame slot, lower_present) is not
// heap storage an owner can share: its clone is a private copy.
fn lower_clone_glue_function(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    if lower_trait_ref(p, glue.ty) != None -> return lower_trait_glue(p, &m, glue)
    if lower_is_transaction(glue.ty) -> return lower_transaction_clone_glue(&m, glue)
    if lower_is_iter_cursor(glue.ty) -> return lower_iter_clone_glue(p, &m, glue)
    if glue.ty.kind == .List(elem) -> return lower_list_clone_glue(p, &m, glue, elem)
    if glue.ty.kind == .FixedList(elem, _) -> return lower_list_clone_glue(p, &m, glue, elem)
    if lower_map_entry(glue.ty) == .Val(entry) -> return lower_list_clone_glue(p, &m, glue, entry)
    if lower_set_element(glue.ty) != None {
        shape :: lower_map_shape(p, lower_set_map(glue.ty)) ?? panic("Set clone has no entry layout")
        return lower_list_clone_glue(p, &m, glue, shape.entry)
    }
    if lower_tally_element(glue.ty) != None {
        shape :: lower_map_shape(p, lower_tally_map(glue.ty)) ?? panic("Tally clone has no entry layout")
        return lower_list_clone_glue(p, &m, glue, shape.entry)
    }
    if lower_queue_element(glue.ty) != None -> return lower_helper_queue(p, &m, glue)
    if lower_priority_queue_element(glue.ty) == .Val(elem) -> return lower_list_clone_glue(p, &m, glue, elem)
    if glue.ty.kind == .Fn(_) | .SendFn(_, _, _) -> return lower_closure_clone_glue(&m, glue)
    if lower_is_inline(p, glue.ty) -> return lower_inline_clone_glue(p, &m, glue)
    signature :: lower_signature(&m, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_pointer()))
    f := lower_new_function(glue.id, "clone.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    source :: lower_pointer(&f)
    entry :: lower_new_block(&f)
    lower_start(&f, entry, [LIRValueID]{source})
    if glue.ty.kind == .Option(_) {
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        is_null :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: is_null, condition: LIRCondition.Eq, left: source, right: null})
        absent :: lower_new_block(&f)
        present :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: is_null, then_target: lower_target(absent, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
        lower_start(&f, absent, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
        lower_start(&f, present, [LIRValueID]{})
    }
    count :: lower_box_count(&f, source)
    zero :: lower_const(&f, 0)
    immortal :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: immortal, condition: LIRCondition.Lt, left: count, right: zero})
    copy_block :: lower_new_block(&f)
    shared_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: immortal, then_target: lower_target(copy_block, [LIRValueID]{}), else_target: lower_target(shared_block, [LIRValueID]{})})
    lower_start(&f, copy_block, [LIRValueID]{})
    duplicate :: lower_box_copy(p, &m, &f, source, glue.ty)
    lower_seal(&f, LIRTerminator.Return{value: Val(duplicate)})
    lower_start(&f, shared_block, [LIRValueID]{})
    lower_call_runtime(&m, &f, "jet_rt_block_retain", [LIRValueID]{source}, None)
    lower_seal(&f, LIRTerminator.Return{value: Val(source)})
    lir_builder_finish(f.builder)
}

// A private copy of the present box `source` of `ty`: a new box with every
// word copied, then the owned contents of the active shape replaced by their
// own copies (retains for shared kinds). box.unique and the clone of an
// immortal box copy a box; nothing else does.
fn lower_box_copy(p: MIRProgram, m: &LowerModule, f: &LowerFunction, source: LIRValueID, ty: MIRType) -> LIRValueID Never! {
    shapes :: lower_glue_shapes(p, &m, &f, ty)
    bytes :: lower_box_size(p, ty)
    target :: lower_pointer(&f)
    lower_alloc(&m, &f, target, bytes)
    lower_copy_bytes(&f, target, 0, source, 0, if bytes < 8 -> 8 else -> bytes)
    done :: lower_new_block(&f)
    if shapes.len() == 1 && shapes[0].selector < 0 {
        lower_glue_clone_fields(p, &m, &f, source, target, shapes[0].fields)
    } else {
        discriminant :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: discriminant, base: source, offset: 0})
        loop shape in shapes {
            if shape.fields.len() == 0 -> next
            expected :: lower_const(&f, shape.selector)
            selected :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: selected, condition: LIRCondition.Eq, left: discriminant, right: expected})
            body :: lower_new_block(&f)
            next_block :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: selected, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
            lower_start(&f, body, [LIRValueID]{})
            lower_glue_clone_fields(p, &m, &f, source, target, shape.fields)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
            lower_start(&f, next_block, [LIRValueID]{})
        }
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    target
}

// box.unique(slot): before a write into the box the pointer at `slot` names
// (or into anything reached through it), the slot must hold the box's only
// reference. A null slot (absent Option) or a sole owner is left as is; a
// shared or static box is replaced by a private copy (lower_box_copy) and the
// slot's reference to the old box is released through its drop glue. A box
// of a type no owner can copy (lower_contains_uncopyable) is never shared,
// and its helper does nothing.
fn lower_helper_box_unique(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    if lower_type_contains_uncopyable(p, &m, glue.ty) {
        lower_seal(&f, LIRTerminator.Return{value: None})
        return lir_builder_finish(f.builder)
    }
    slot :: f.open_params[0].copy()
    boxed :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: boxed, base: slot, offset: 0})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: boxed, right: null})
    present :: lower_new_block(&f)
    detach :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(present, [LIRValueID]{})})
    lower_start(&f, present, [LIRValueID]{})
    sole :: lower_list_sole_owner(&f, boxed)
    lower_seal(&f, LIRTerminator.Branch{condition: sole, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(detach, [LIRValueID]{})})
    lower_start(&f, detach, [LIRValueID]{})
    private :: lower_box_copy(p, &m, &f, boxed, glue.ty)
    lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: private})
    lower_map_drop_value(p, &m, &f, boxed, glue.ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_glue_shapes(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType) -> [LowerGlueShape] Never! {
    shapes := [LowerGlueShape]{}
    if ty.kind == {
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; field `ty` of the new LowerGlueField owns this one
        .Option(inner) -> &shapes.push(LowerGlueShape{selector: -1, fields: [LowerGlueField]{LowerGlueField{offset: 0, ty: inner.copy()}}})
        .Result(ok, err) -> {
            &shapes.push(LowerGlueShape{selector: lower_result_selector(true), fields: [LowerGlueField]{LowerGlueField{offset: lower_result_payload_offset(), ty: ok}}})
            &shapes.push(LowerGlueShape{selector: lower_result_selector(false), fields: [LowerGlueField]{LowerGlueField{offset: lower_result_payload_offset(), ty: err}}})
        }
        else -> {
            definition :: lower_type_def(p, ty) ?? {
                lower_fail(&m, &f, "drop glue for {mir_type_display_name(ty)} has no definition")
                return shapes
            }
            if definition.kind == {
                .Enum(variants, _) -> {
                    loop (index, variant) in variants -> &shapes.push(lower_enum_glue_shape(p, definition, variant, index))
                }
                else -> lower_fail(&m, &f, "drop glue for {definition.name} is not generated at O0 yet")
            }
        }
    }
    shapes
}

// ---------------------------------------------------------------------------
// Generated helpers: module functions for work that loops (byte compares,
// element walks, formatting), built in LIR from `lower_helper_function`'s
// generators instead of being new runtime symbols, so every image format
// links them unchanged. One helper per (name, type); `ty` is the type it is
// generated for, or Unit when it is not per type.

fn lower_helper_id(m: &LowerModule, name: String, ty: MIRType) -> LIRFunctionID Never! {
    lower_glue_register(&m, "h:{name}", ty, false, name.copy())
}

// Call helper `name` for `ty` with `args`; its signature is the arguments'
// layouts and `dst`'s, as for runtime calls.
fn lower_call_helper(m: &LowerModule, f: &LowerFunction, name: String, ty: MIRType, args: [LIRValueID], dst: LIRValueID?) Never! {
    params := [LIRLayout]{}
    loop arg in args -> &params.push(lower_value_layout(f, arg))
    result :: if dst == .Val(value) -> Val(lower_value_layout(f, value)) else -> None
    signature :: lower_signature(&m, params, result)
    id :: lower_helper_id(&m, name, ty)
    // copy: the emitted Call owns its argument list, while `args` is the caller's list (a read
    // parameter), which the helper caller still reads.
    lower_emit(&f, LIRInst.Call{dst: dst, signature: signature, callee: LIRCallee.Function{id: id}, args: args.copy()})
}

// A helper function shell: its builder, named `helper.<name>.<type key>`,
// with the entry block open and its parameters (one per `params` layout) in
// `f.open_params`; read them before sealing the entry block.
fn lower_helper_start(m: &LowerModule, glue: LowerGlue, params: [LIRLayout], result: LIRLayout?) -> LowerFunction Never! {
    lower_helper_start_taking(&m, glue, params, [LIRDrop]{}, result)
}

// lower_helper_start for a helper that takes over some of its arguments (a
// pushed or inserted value): parameter `i` carries `taken[i]`'s drop glue
// (Trivial, or missing, for a borrowed one), so the LIR states the hand-off
// at every call and the helper's body ends what it took.
fn lower_helper_start_taking(m: &LowerModule, glue: LowerGlue, params: [LIRLayout], taken: [LIRDrop], result: LIRLayout?) -> LowerFunction Never! {
    signature :: lower_signature(&m, params, result)
    f := lower_new_function(glue.id, "helper.{glue.helper}.{glue.key}", signature, MIRBlockID{value: U64.MAX})
    entry_params := [LIRValueID]{}
    loop (position, layout) in params {
        // copy: the helper builder owns each parameter's drop rule, while `taken` is the caller's
        // drop list (a read parameter), which stays with the glue row.
        drop :: if position < taken.len() -> taken[position].copy() else -> LIRDrop.Trivial
        &entry_params.push(lower_new_value(&f, layout, drop, None))
    }
    entry :: lower_new_block(&f)
    lower_start(&f, entry, entry_params)
    f
}

fn lower_helper_function(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    if glue.helper == "drop.structural" -> return lower_glue_function(p, &m, glue)
    if glue.helper == "trait.drop" || glue.helper == "trait.clone" -> return lower_trait_payload_glue(p, &m, glue)
    if glue.helper == "atomic.try_add" -> return lower_helper_atomic_try_add(p, &m, glue)
    if glue.helper.starts_with("builtin.") -> return lower_helper_value_builtin(p, &m, glue)
    if glue.helper.starts_with("shared-site:") -> return lower_shared_site_helper(p, &m, glue)
    if glue.helper.starts_with("lazy.") -> return lower_lazy_helper(p, &m, glue)
    if glue.helper == "codec.tree.decode" -> return lower_helper_codec_tree_decode(p, &m, glue)
    if glue.helper == "codec.decode" -> return lower_helper_codec_decode(p, &m, glue)
    if glue.helper == "codec.base64" -> return lower_helper_codec_base64(p, &m, glue)
    if glue.helper == "codec.encode" -> return lower_helper_codec_encode(p, &m, glue)
    if glue.helper == "closure.thunk" -> return lower_closure_thunk(&m, glue)
    if glue.helper.starts_with("test.") -> return lower_test_helper(p, &m, glue)
    if glue.helper == "para.map.invoke" -> return lower_helper_parallel_map(p, &m, glue)
    if glue.helper == "para.fold.chunk" || glue.helper == "para.fold.merge" -> return lower_helper_parallel_fold(p, &m, glue)
    if glue.helper == "entry" -> return lower_entry_function(p, &m, glue)
    if glue.helper == "core.shared.init" -> return lower_core_shared_init(p, &m, glue)
    if glue.helper == "callable.init" -> return lower_callable_init(p, &m, glue)
    if glue.helper == "callable.fini" -> return lower_callable_fini(p, &m, glue)
    if glue.helper == "callable.value" -> return lower_value_callable(p, &m, glue)
    if glue.helper == "callable.release" -> return lower_value_release(p, &m, glue)
    if lower_native_handle_operation(glue.helper) == .Val(op) -> return lower_native_handle_glue(p, &m, glue, op)
    if glue.helper.starts_with("native.record.") -> return lower_native_record_glue(p, &m, glue)
    if glue.helper == "export.entry" -> return lower_export_entry(p, &m, glue)
    if glue.helper == "record.in" -> return lower_helper_record_in(p, &m, glue)
    if glue.helper == "record.out" -> return lower_helper_record_out(p, &m, glue)
    if glue.helper == "list.record_handles" -> return lower_helper_record_handles(p, &m, glue)
    if glue.helper == "list.record_handles_free" -> return lower_helper_record_handles_free(p, &m, glue)
    if glue.helper == "task.body" -> return lower_helper_task_body(p, &m, glue)
    if glue.helper == "task.release" -> return lower_helper_task_release(p, &m, glue)
    if glue.helper == "realtime.invoke" -> return lower_helper_realtime_invoke(p, &m, glue)
    if glue.helper == "realtime.worker" -> return lower_helper_realtime_worker(&m, glue)
    if glue.helper == "task.debug" -> return lower_helper_task_debug(p, &m, glue)
    if glue.helper.starts_with("closure.release:") -> return lower_closure_release(p, &m, glue)
    if glue.helper == "iter.release" -> return lower_helper_iter_typed(p, &m, glue, false)
    if glue.helper == "iter.advance.typed" -> return lower_helper_iter_typed(p, &m, glue, true)
    if glue.helper == "iter.advance" -> return lower_helper_iter_advance(p, &m, glue)
    if glue.helper == "display" || glue.helper == "show" || glue.helper == "debug" -> return lower_helper_display(p, &m, glue)
    if glue.helper == "equal" -> return lower_helper_equal(p, &m, glue)
    if glue.helper == "list.unique" -> return lower_helper_list_unique(p, &m, glue)
    if glue.helper == "box.unique" -> return lower_helper_box_unique(p, &m, glue)
    if glue.helper == "list.push" -> return lower_helper_list_push(p, &m, glue)
    if glue.helper == "list.join" -> return lower_helper_list_join(p, &m, glue)
    if glue.helper == "list.pop" -> return lower_helper_list_pop(p, &m, glue)
    if glue.helper == "list.get" -> return lower_helper_list_get(p, &m, glue)
    if glue.helper == "list.compare" -> return lower_helper_list_compare(p, &m, glue)
    if glue.helper == "list.starts_with" || glue.helper == "list.ends_with" -> return lower_helper_list_starts_with(p, &m, glue)
    if glue.helper == "list.remove_value" || glue.helper == "list.remove_slot" -> return lower_helper_list_remove(p, &m, glue)
    if glue.helper == "list.index_of" -> return lower_helper_list_index_of(p, &m, glue)
    if glue.helper == "list.insert" -> return lower_helper_list_insert(p, &m, glue)
    if glue.helper == "list.sort" || glue.helper == "list.sort_desc" -> return lower_helper_list_sort(p, &m, glue)
    if glue.helper == "list.reverse" -> return lower_helper_list_reverse(p, &m, glue)
    if glue.helper == "list.extend" -> return lower_helper_list_extend(p, &m, glue)
    if glue.helper == "list.try_reserve" -> return lower_helper_list_try_reserve(p, &m, glue)
    if glue.helper == "list.union" || glue.helper == "list.intersection" || glue.helper == "list.difference" -> return lower_helper_list_combine(p, &m, glue)
    if glue.helper == "list.rank_entries" -> return lower_helper_list_rank_entries(p, &m, glue)
    if glue.helper.starts_with("map.") -> return lower_helper_map(p, &m, glue)
    if glue.helper == "set.take" || glue.helper == "set.remove" -> return lower_helper_set_take(p, &m, glue)
    if glue.helper == "set.first" || glue.helper == "set.last" -> return lower_helper_set_edge(p, &m, glue)
    if glue.helper.starts_with("queue.") -> return lower_helper_queue(p, &m, glue)
    if glue.helper.starts_with("priority_queue.") -> return lower_helper_priority_queue(p, &m, glue)
    if glue.helper == "set.equal" -> return lower_helper_set_equal(p, &m, glue)
    if glue.helper == "numeric.pow.checked" || glue.helper == "numeric.pow.checked_policy" || glue.helper == "numeric.pow.wrapping" || glue.helper == "numeric.pow.saturating" -> return lower_helper_numeric_pow(p, &m, glue)
    if glue.helper == "text.html_escape" || glue.helper == "text.path_component" -> return lower_helper_typed_text_escape(&m, glue)
    f := lower_helper_start(&m, glue, [LIRLayout]{}, None)
    lower_fail(&m, &f, "helper {glue.helper} has no generator")
    lower_seal(&f, LIRTerminator.Unreachable)
    lir_builder_finish(f.builder)
}

// ---------------------------------------------------------------------------
// Names for issues.

fn lower_binary_name(op: MIRBinaryOp) -> String Never! {
    if op == {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .FloorDiv -> "/%"
        .Mod -> "mod"
        .Rem -> "%"
        .Pow -> "**"
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "^"
        .Shl -> "<<"
        .Shr -> ">>"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Gt -> ">"
        .Le -> "<="
        .Ge -> ">="
        .Compare -> "<=>"
        .And -> "&&"
        .Or -> "||"
    }
}

fn lower_operation_name(operation: MIROperation) -> String Never! {
    if operation == {
        .Parameter(_, _) -> "Parameter"
        .Capture(_) -> "Capture"
        .Global(_) -> "Global"
        .Phi(_) -> "Phi"
        .ReadPlace(_) -> "ReadPlace"
        .MovePlace(_) -> "MovePlace"
        .WritePlace(_, _) -> "WritePlace"
        .ReplacePlace(_, _) -> "ReplacePlace"
        .InitializeUninit(_) -> "InitializeUninit"
        .Copy(_, _) -> "Copy"
        .Move(_) -> "Move"
        .Constant(_) -> "Constant"
        .Unary(_, _) -> "Unary"
        .Binary(_, _, _, _, _) -> "Binary"
        .BuildString(_) -> "BuildString"
        .BuildList(_, _) -> "BuildList"
        .BuildMap(_) -> "BuildMap"
        .MapLookup(_, _, _) -> "MapLookup"
        .EnumIs(_, _, _) -> "EnumIs"
        .EnumPayload(_, _, _, _) -> "EnumPayload"
        .OptionIsSome(_) -> "OptionIsSome"
        .OptionValue(_) -> "OptionValue"
        .ResultIsOk(_) -> "ResultIsOk"
        .ResultValue(_, _) -> "ResultValue"
        .PatternCapture(_, _) -> "PatternCapture"
        .PatternMatched(_) -> "PatternMatched"
        .ProjectMembers(_, _) -> "ProjectMembers"
        .Index(_, _, _, _, _, _, _) -> "Index"
        .Slice(_, _, _, _, _, _) -> "Slice"
        .Range(_, _, _) -> "Range"
        .Field(_, _) -> "Field"
        .Struct(_, _) -> "Struct"
        .Enum(_, _, _) -> "Enum"
        .Tuple(_, _) -> "Tuple"
        .Present(_) -> "Present"
        .Convert(_, _, _, _) -> "Convert"
        .TraitBox(_, _) -> "TraitBox"
        .Absent -> "Absent"
        .ResultOk(_) -> "ResultOk"
        .ResultErr(_) -> "ResultErr"
        .Call(_, _, _) -> "Call"
        .IndirectCall(_, _, _) -> "IndirectCall"
        .Closure(_, _, _) -> "Closure"
        .PtrFromAddr(_, _) -> "PtrFromAddr"
        .Deref(_) -> "Deref"
        .RawAddressOf(_) -> "RawAddressOf"
        .AddressOf(_, _) -> "AddressOf"
        .CoreCall(_, _, _, _, _, _) -> "CoreCall"
        .AttachTag(_, _) -> "AttachTag"
        .Todo(_, _, _) -> "Todo"
        .Never(_) -> "Never"
        .Semantic(_) -> "Semantic"
        .LoopRangeInit(_, _, _, _, _) -> "LoopRangeInit"
        .LoopRangeHasNext(_, _) -> "LoopRangeHasNext"
        .LoopRangeValue(_, _) -> "LoopRangeValue"
        .LoopRangeAdvance(_, _) -> "LoopRangeAdvance"
        .LoopIterInit(_, _, _, _, _) -> "LoopIterInit"
        .LoopIterHasNext(_, _) -> "LoopIterHasNext"
        .LoopIterValue(_, _) -> "LoopIterValue"
        .LoopIterAdvance(_, _) -> "LoopIterAdvance"
        .ScopeEnter(_, _) -> "ScopeEnter"
        .ScopeExit(_) -> "ScopeExit"
        .Drop(_, _) -> "Drop"
    }
}

fn lower_deadline_frame(c: LowerContext, f: &LowerFunction) Never! {
    loop scope in c.mir.scopes {
        if scope.kind != .Context || scope.deadline == None -> next
        save :: lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: save, size: 16, align: 8})
        &f.deadline_scopes.add(scope.id.value, save.value).drop("scope IDs are unique")
    }
}

fn lower_deadline_scope(c: LowerContext, m: &LowerModule, f: &LowerFunction, row: MIRScope, enter: Bool) Never! {
    index :: f.deadline_scopes.get(row.id.value) ?? return lower_fail(&m, &f, "deadline scope has no frame save slot")
    save :: LIRValueID{value: index}
    if !enter -> return lower_call_runtime(&m, &f, "jet_ctx_pop_deadline", [LIRValueID]{save}, None)
    value :: row.deadline ?? return lower_fail(&m, &f, "deadline Context scope has no checked deadline")
    ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "deadline Context value has no checked type")
    source :: lower_use(&m, &f, value) ?? return
    deadline := source
    if lower_is_exact_int(ty) {
        deadline = lower_word(&f)
        lower_convert_exact(&m, &f, deadline, source, "jet_int_owned_to_i64", false)
    }
    lower_call_runtime(&m, &f, "jet_ctx_push_deadline", [LIRValueID]{deadline, save}, None)
}
