pub fn lower_runtime_route(symbol: String) -> LowerRoute? {
    loop route in LOWER_RUNTIME_ROUTES {
        if route.symbol == symbol -> return Val(route)
    }
    None
}

// The runtime handle type a Jet type generated Rust holds natively crosses the
// boundary as, keyed by the Jet name MIR spells it with: a Core table name
// (`LocalDate`), or a canonical Core source identity
// (`<corelib>/Core/net::Core/net/net.jet::TCPStream`) whose own Jet shape
// generated Rust replaces. It is dropped by `jet_rt_handle_drop_<runtime>`;
// copied by `jet_rt_handle_clone_<runtime>` when `clone`; rendered by
// `jet_rt_handle_display_<runtime>` / `jet_rt_handle_show_<runtime>` /
// `jet_rt_handle_debug_<runtime>` when `display` / `show` / `debug`; compared
// by `jet_rt_handle_eq_<runtime>` when `eq`.
pub struct LowerRuntimeHandle { pub jet_name: String, pub runtime: String, pub clone: Bool, pub display: Bool, pub show: Bool, pub debug: Bool, pub eq: Bool }

LOWER_RUNTIME_HANDLES :: prep { [LowerRuntimeHandle]{
    LowerRuntimeHandle{jet_name: "<corelib>/Core/app::Core/app/app.jet::Auth", runtime: "JetAuthApp", clone: true, display: false, show: false, debug: false, eq: false},
    LowerRuntimeHandle{jet_name: "<corelib>/Core/app::Core/app/app.jet::Session", runtime: "JetAuthSession", clone: true, display: false, show: false, debug: false, eq: false},
