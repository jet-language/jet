fn lower_handle_field(runtime: String, field: String) -> LowerHandleField? {
    loop row in LOWER_HANDLE_FIELDS {
        if row.runtime == runtime && row.field == field -> return Val(row.copy())
    }
    None
}
enum LowerEnvironmentOp { Bytes Set Remove Columns Compare Seed Text }
struct LowerEnvironmentRoute { symbol: String, export: String, op: LowerEnvironmentOp, arity: Int }
LOWER_ENVIRONMENT_ROUTES :: prep { [LowerEnvironmentRoute]{
    LowerEnvironmentRoute{symbol: "jet_sys_env_value_raw", export: "jet_rt_logical_env_get_os", op: LowerEnvironmentOp.Bytes, arity: 1},
    LowerEnvironmentRoute{symbol: "jet_std_env_try_set", export: "jet_rt_logical_env_set", op: LowerEnvironmentOp.Set, arity: 2},
    LowerEnvironmentRoute{symbol: "jet_std_env_unset", export: "jet_rt_logical_env_unset", op: LowerEnvironmentOp.Remove, arity: 1},
    LowerEnvironmentRoute{symbol: "jet_sys_env_columns_raw", export: "jet_rt_logical_env_columns", op: LowerEnvironmentOp.Columns, arity: 0},
    LowerEnvironmentRoute{symbol: "jet_sys_startup_env_columns_raw", export: "jet_rt_startup_env_columns", op: LowerEnvironmentOp.Columns, arity: 0},
    LowerEnvironmentRoute{symbol: "jet_sys_env_key_compare_raw", export: "jet_rt_env_key_compare", op: LowerEnvironmentOp.Compare, arity: 2},
    LowerEnvironmentRoute{symbol: "jet_std_env_init", export: "jet_rt_logical_env_seed", op: LowerEnvironmentOp.Seed, arity: 0},
    LowerEnvironmentRoute{symbol: "jet_rt_logical_env_get", export: "jet_rt_logical_env_get", op: LowerEnvironmentOp.Text, arity: 1},
} }
fn lower_environment_route(symbol: String) -> LowerEnvironmentRoute? {
    loop route in LOWER_ENVIRONMENT_ROUTES { if route.symbol == symbol -> return Val(route.copy()) }
    None
}

