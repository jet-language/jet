// BEGIN GENERATED C-ABI ROUTES (Tools/agent/gen-c-abi-routes.mjs; do not hand-edit)
// Shared carriers of runtime C-ABI routes, whether their definition lives
// in CAbiRoutes.rs or a Jet runtime #Export(c), keyed by the route's
// Prelude symbol; `export` is the adapter's C name (its last segment).

// Generated runtime ABI atom projection; nominal identities stay unchanged.
fn runtime_abi_atom(name: String) -> String Never! {
    bytes :: name.bytes()
    out := [U8]{}
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == 46 || code == 95 {
            if out.len() > 0 && out[out.len() - 1] != (U8{95}) -> &out.push(U8{95})
            next
        }
        upper :: code >= 65 && code <= 90
        if upper && index > 0 && out.len() > 0 && out[out.len() - 1] != (U8{95}) {
            previous :: Int.from_u8(bytes[index - 1])
            next_code :: if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> 0
            previous_upper :: previous >= 65 && previous <= 90
            next_lower :: next_code >= 97 && next_code <= 122
            if !previous_upper || next_lower -> &out.push(U8{95})
        }
        &out.push(U8{if upper -> code + 32 else -> code})
    }
    if out.len() > 0 && out[out.len() - 1] == (U8{95}) {
        _ :: &out.pop() ?? panic("a nonempty runtime ABI atom failed to pop")
    }
    String.from_bytes(out) ?? panic("runtime ABI atom is not ASCII")
}

// `HandleMut` lends the handle of the caller's Write place: the runtime
// mutates the value in that box. A Tuple writes its flattened carrier
// slots through out pointers (zeroed eight-byte slots); an Option item
// writes a 0/1 tag followed by its payload slots and returns nothing.
enum LowerRouteCarrier { Word Flag Float Text Unit Handle(name: String) HandleMut(name: String) List(elem: LowerRouteCarrier) Option(some: LowerRouteCarrier) Tag(name: String, variants: String) }

enum LowerRouteResult {
    Plain(carrier: LowerRouteCarrier)
    Option(some: LowerRouteCarrier)
    Result(ok: LowerRouteCarrier, err: LowerRouteCarrier)
    Tuple(items: [LowerRouteCarrier])
}

struct LowerRoute { symbol: String, export: String, native_lists: Bool, params: [LowerRouteCarrier], result: LowerRouteResult }

