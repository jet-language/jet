// Realtime's producer boundary is Jet-owned (Realtime.jet). Callback storage
// moves once; each invocation borrows the worker's reusable List24<Float>.
use jet_foundation.[MIRAccess, MIRInstruction, MIRPreludeCall, MIRPreludeCallID, MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_nominal_ref, mir_type_from_kind]

fn lower_realtime_callback_type(p: MIRProgram, ty: MIRType) -> Bool Never! {
    params := [MIRType]{}
    result := MIRType?{None}
    access := MIRAccess.Read
    if ty.kind == {
        .Fn(signature) -> {
            params = signature.params
            result = signature.ret
            access = lower_lazy_callback_access(signature, 0)
        }
        .SendFn(arguments, ret, conventions) -> {
            params = arguments
            result = ret
            if conventions.len() > 0 -> access = conventions[0]
        }
        else -> return false
    }
    if params.len() != 1 || access != MIRAccess.Read -> return false
    element :: lower_list_element(params[0]) ?? return false
    if element.kind != MIRTypeKind.Float -> return false
    if result == .Val(result_ty) -> return lower_repr(p, result_ty) == LowerRepr.Absent
    true
}

fn lower_realtime_stream(p: MIRProgram, ty: MIRType) -> Bool Never! {
    row :: lower_runtime_handle_type(p, ty) ?? return false
    row.runtime == "JetRealtimeStream" && lower_repr(p, ty) == LowerRepr.Handle{drop: "jet_rt_handle_drop_jet_realtime_stream", clone: "jet_rt_handle_clone_jet_realtime_stream"}
}

fn lower_realtime_start(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, values: [MIRValueID], closure: MIRValueID?) Never! {
    row :: lower_prelude_row(p, m, call) ?? return lower_fail(&m, &f, "Realtime has no checked Core route")
    if lower_runtime_symbol(row) != "jet_rt_callback" -> return lower_fail(&m, &f, "Realtime has no canonical producer route")
    if values.len() != 2 -> return lower_fail(&m, &f, "Realtime must supply rate and frame count")
    loop value in values {
        ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "Realtime rate/frame count has no checked type")
        if !lower_is_exact_int(ty) -> return lower_fail(&m, &f, "Realtime rate/frame count must be canonical Int words")
    }
    body :: closure ?? return lower_fail(&m, &f, "Realtime has no checked callback")
    callback_ty :: lower_value_type(c, body) ?? return lower_fail(&m, &f, "Realtime callback has no checked type")
    if !lower_realtime_callback_type(p, callback_ty) -> return lower_fail(&m, &f, "Realtime callback must borrow List<Float> and return Unit")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "Realtime has no checked stream type")
    if !lower_realtime_stream(p, result_ty) -> return lower_fail(&m, &f, "Realtime must produce the canonical stream handle")
    rate :: lower_use(&m, &f, values[0]) ?? return
    frames :: lower_use(&m, &f, values[1]) ?? return
    env :: lower_task_owned_closure(p, c, &m, &f, body, callback_ty) ?? return
    invoke :: lower_lazy_helper_address(&m, &f, "realtime.invoke", callback_ty)
    release :: lower_lazy_helper_address(&m, &f, "task.release", callback_ty)
    // One generated forwarding helper per module. Thread.jet only CALLS this
    // pointer; it never compares identity with the runtime worker's export.
    worker_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}})
    worker :: lower_lazy_helper_address(&m, &f, "realtime.worker", worker_ty)
    // ABI skipped_word: zero selects the stream's preallocated internal skip
    // signal; no caller-owned Atomic<Bool> is borrowed by this producer.
    skipped_word :: lower_const(&f, 0)
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_jet_realtime_stream"}, result_ty.identity)
    lower_call_runtime(&m, &f, "jet_rt_native_realtime_start", [LIRValueID]{rate, frames, env, invoke, release, worker, skipped_word}, Val(dst))
    // The runtime owns env even on validation/spawn failure and releases it
    // exactly once. Never release it here or clone/drop the borrowed inputs.
    if instruction.result == None -> lower_emit(&f, LIRInst.Drop{value: dst})
}

fn lower_helper_realtime_invoke(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    env :: f.open_params[0].copy()
    buffer :: f.open_params[1].copy()
    unit :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}})
    lower_call_closure_box(p, &m, &f, env, [LIRValueID]{buffer}, unit).drop("Realtime callbacks return Unit")
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_helper_realtime_worker(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, Val(lir_layout_word()))
    stream :: f.open_params[0].copy()
    result :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_realtime_worker", [LIRValueID]{stream}, Val(result))
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}

// The runtime returns owned canonical start_ns, not a Rust Instant box. Keep
// all other runtime routes on their existing shape-aware record boundary.
fn lower_realtime_deadline(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, args: [MIRValueID]) -> Bool Never! {
    if lower_route_symbol(row) != "jet_rt_next_deadline" -> return false
    if args.len() != 1 {
        lower_fail(&m, &f, "Realtime next_deadline must borrow one stream")
        return true
    }
    stream_ty :: lower_value_type(c, args[0]) ?? {
        lower_fail(&m, &f, "Realtime deadline stream has no checked type")
        return true
    }
    if !lower_realtime_stream(p, stream_ty) {
        lower_fail(&m, &f, "Realtime deadline must borrow the canonical stream")
        return true
    }
    ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "Realtime deadline has no checked Instant result")
        return true
    }
    runtime :: lower_record_handle(p, ty) ?? {
        lower_fail(&m, &f, "Realtime deadline must reconstruct the source Instant")
        return true
    }
    members :: lower_inline_members(p, ty)
    if runtime != "JetInstant" || !lower_is_inline(p, ty) || members.len() != 1 || members[0].name != "start_ns" || !lower_is_exact_int(members[0].ty) {
        lower_fail(&m, &f, "Realtime deadline Instant must contain canonical start_ns only")
        return true
    }
    stream :: lower_use(&m, &f, args[0]) ?? return true
    word :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, members[0].ty.identity)
    lower_call_runtime(&m, &f, "jet_rt_next_deadline", [LIRValueID]{stream}, Val(word))
    if lower_result(p, c, &m, &f, instruction) == .Val(dst) {
        lower_storage_into(p, &f, dst, ty)
        lower_write_at(p, &f, dst, members[0].offset, word, members[0].ty)
    } else {
        lower_emit(&f, LIRInst.Drop{value: word})
    }
    true
}
