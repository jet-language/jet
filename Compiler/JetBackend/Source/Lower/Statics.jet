// Module constants are frozen once; Global borrows their data and clones only
// when checked MIR ownership requires an owner. Literal Constant stays separate.
//
// Runtime-owned words inside a frozen tree (String and spilled exact Int)
// cannot be frozen at build time. Their slots stay zero until the entry
// runs the recorded constructor on static text. Program owners live until
// process exit; callable owners live until image finalization. An
// ownership-bearing Global read clones them.
use jet_foundation.[
    MIRConstant, MIRConstantDef, MIRConstMapEntry, MIRInstruction, MIRPlace, MIRProgram, MIRSharedLifetime, MIRType, MIRValueID,
    mir_type_display_name,
    mir_shared_site_getter_symbol,
]
use core.math as math

// `text`: constructor input for a runtime-owned word filled at startup.
struct LowerStaticValue { word: Int, data: LIRDataID?, text: LIRDataID?, constructor: String }

// A frozen slot either receives a runtime scalar or a constructed Map.
enum LowerStaticConstructor {
    Runtime(text: LIRDataID, symbol: String)
    Map(ty: MIRType, entries: [MIRConstMapEntry], capacity: LIRDataID)
}
struct LowerStaticFixup { object: LIRDataID, offset: Int, constructor: LowerStaticConstructor }

fn lower_static_word(value: Int) -> LowerStaticValue Never! {
    LowerStaticValue{word: value, data: None, text: None, constructor: ""}
}

fn lower_static_object(m: &LowerModule, bytes: Int) -> LIRDataID Never! {
    data := [U8]{}
    count :: if bytes > 8 -> lower_align_up(bytes, 8) else -> 8
    loop _ in 0..<count -> &data.push(U8{0})
    id :: LIRDataID{value: m.data.len()}
    &m.data.push(LIRData{id: id, bytes: data, align: 8, relocs: [LIRDataReloc]{}})
    id
}

fn lower_static_pointer(id: LIRDataID) -> LowerStaticValue Never! {
    LowerStaticValue{word: 0, data: Val(id), text: None, constructor: ""}
}

fn lower_static_runtime(m: &LowerModule, value: String, constructor: String) -> LowerStaticValue Never! {
    LowerStaticValue{word: 0, data: None, text: Val(lower_data(&m, value)), constructor: constructor}
}

// Writes the low `size` bytes of a word, a pointer relocation, or a runtime
// constructor fixup at offset.
fn lower_static_store_sized(m: &LowerModule, object: LIRDataID, offset: Int, value: LowerStaticValue, size: Int) Never! {
    if value.text == .Val(text) {
        &m.static_fixups.push(LowerStaticFixup{object: object, offset: offset, constructor: LowerStaticConstructor.Runtime{text: text, symbol: value.constructor}})
    } else if value.data == .Val(target) {
        &m.data[object.value].relocs.push(LIRDataReloc{offset: offset, target: target, addend: 0})
    } else {
        loop byte in 0..<size -> m.data[object.value].bytes[offset + byte] = U8{(value.word >> (8 * byte)).bit_and(255)}
    }
}

fn lower_static_store(m: &LowerModule, object: LIRDataID, offset: Int, value: LowerStaticValue) Never! {
    lower_static_store_sized(&m, object, offset, value, 8)
}

// Freezes `constant` of `ty` at object + offset: an inline aggregate lays its
// members out in place, anything else stores its word (one byte for Bool).
fn lower_static_child(p: MIRProgram, m: &LowerModule, f: &LowerFunction, object: LIRDataID, offset: Int, ty: MIRType, constant: MIRConstant) Never! {
    if lower_is_inline(p, ty) -> return lower_static_fill(p, &m, &f, object, offset, ty, constant)
    size :: lower_size(p, ty).size
    value :: lower_static_tree(p, &m, &f, ty, constant) ?? return
    if size > 0 -> lower_static_store_sized(&m, object, offset, value, size)
}

fn lower_static_payload(p: MIRProgram, m: &LowerModule, f: &LowerFunction, object: LIRDataID, info: LowerPayloadInfo, constant: MIRConstant) Never! {
    if info.boxed {
        wrapper :: lower_static_object(&m, lower_option_box_size(p, info.ty))
        lower_static_child(p, &m, &f, wrapper, 0, info.ty, constant)
        lower_static_store(&m, object, info.offset, lower_static_pointer(wrapper))
    } else {
        lower_static_child(p, &m, &f, object, info.offset, info.ty, constant)
    }
}

// Lays the struct, tuple or List constant out at object + offset (a List is
// its inline [len, cap, data] header).
fn lower_static_fill(p: MIRProgram, m: &LowerModule, f: &LowerFunction, object: LIRDataID, offset: Int, ty: MIRType, constant: MIRConstant) Never! {
    aggregate :: lower_inline_type(p, ty) ?? return lower_fail(&m, &f, "inline constant of {mir_type_display_name(ty)} is not lowered at O0 yet")
    if constant == .List(values) {
        elem :: lower_list_element(aggregate) ?? return lower_fail(&m, &f, "List constant without a List type is not lowered at O0 yet")
        // Lists.jet's constructor: [len, cap, data]. A zero capacity with
        // non-null frozen data distinguishes static storage, even if empty.
        stride :: lower_list_stride(p, elem)
        data :: lower_static_object(&m, stride * values.len())
        lower_static_store(&m, object, offset, lower_static_word(values.len()))
        lower_static_store(&m, object, offset + 16, lower_static_pointer(data))
        loop (index, value) in values {
            lower_static_child(p, &m, &f, data, stride * index, elem, value)
            if f.failed -> return
        }
        return
    }
    if constant == .Bytes(values) {
        if !lower_constant_bytes_type(p, aggregate) -> return lower_fail(&m, &f, "Bytes constant without a U8 List type is not lowered at O0 yet")
        // Even an empty frozen List needs non-null data for its drop guard.
        data :: if values.len() == 0 -> lower_static_object(&m, 0) else -> {
            id :: LIRDataID{value: m.data.len()}
            &m.data.push(LIRData{id: id, bytes: values.copy(), align: 1, relocs: [LIRDataReloc]{}})
            id
        }
        lower_static_store(&m, object, offset, lower_static_word(values.len()))
        lower_static_store(&m, object, offset + 16, lower_static_pointer(data))
        return
    }
    if constant == .Map(entries) {
        if lower_map_shape(p, aggregate) == None -> return lower_fail(&m, &f, "Map constant without a Map type is not lowered at O0 yet")
        if entries.len() == 0 {
            // Empty frozen storage still has the usual non-null sentinel.
            sentinel :: lower_static_object(&m, 0)
            lower_static_store(&m, object, offset + 16, lower_static_pointer(sentinel))
        } else {
            capacity :: lower_static_object(&m, 8)
            &m.static_fixups.push(LowerStaticFixup{object: object, offset: offset,
                constructor: LowerStaticConstructor.Map{ty: aggregate, entries: entries, capacity: capacity}})
        }
        return
    }
    if constant == .Struct(name, fields) {
        if aggregate.kind == .Tuple(_) {
            loop member in lower_inline_members(p, aggregate) {
                value :: lower_constant_field(fields, member.name) ?? return lower_fail(&m, &f, "Tuple constant without field {member.name} is not lowered at O0 yet")
                lower_static_child(p, &m, &f, object, offset + member.offset, member.ty, value)
                if f.failed -> return
            }
            return
        }
        definition :: lower_type_def(p, aggregate) ?? return lower_fail(&m, &f, "Struct constant {name} without a definition is not lowered at O0 yet")
        if !lower_constant_owner(definition, aggregate, name) -> return lower_fail(&m, &f, "Struct constant {name} as {definition.name} is not lowered at O0 yet")
        // A recursive edge freezes its own wrapper box (lower_static_payload).
        loop member in lower_inline_members(p, aggregate) {
            value :: lower_constant_member(fields, name, member.name) ?? return lower_fail(&m, &f, "Struct constant {name} without field {member.name} is not lowered at O0 yet")
            lower_static_payload(p, &m, &f, object, LowerPayloadInfo{offset: offset + member.offset, ty: member.ty, boxed: member.boxed}, value)
            if f.failed -> return
        }
        return
    }
    lower_fail(&m, &f, "this constant form for {mir_type_display_name(ty)} is not lowered at O0 yet")
}

// MIRRust.rs:constant_for_type (:29444), typed_struct_constant (:29278),
// typed_enum_constant (:29327): type-directed layout, declaration-order slots.
// The owner-directed static carrier replaces Rust's accessor clone policy.
fn lower_static_tree(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, constant: MIRConstant) -> LowerStaticValue? {
    if ty.kind == {
        .Tagged(_, inner) -> return lower_static_tree(p, &m, &f, inner, constant)
        .InlineRange(base, _, _) -> return lower_static_tree(p, &m, &f, base, constant)
        .Quantity(base, _) -> return lower_static_tree(p, &m, &f, base, constant)
        .Apply(_, _) -> {
            if lower_type_def(p, ty) == .Val(definition) {
                if definition.kind == {
                    .Alias(target) -> return lower_static_tree(p, &m, &f, target, constant)
                    .Distinct(base, _) -> return lower_static_tree(p, &m, &f, base, constant)
                    else -> {}
                }
            }
        }
        else -> {}
    }
    repr :: lower_repr(p, ty)
    if repr == .Unsupported(reason) {
        lower_fail(&m, &f, "{reason} is not lowered at O0 yet")
        return None
    }
    if constant == {
        .Unit -> return Val(lower_static_word(0))
        .Int(value, _, _) -> {
            if lower_is_exact_int(ty) && !lower_int_inline(value) {
                return Val(lower_static_runtime(&m, "{value}", "jet_rt_int_from_static"))
            }
            return Val(lower_static_word(value))
        }
        .Bool(value) -> return Val(lower_static_word(if value -> 1 else -> 0))
        .Char(value) -> return Val(lower_static_word(value))
        .Float(value, f32, _) -> return Val(lower_static_word(lower_float_constant_bits(value, f32)))
        .String(value) -> return Val(lower_static_runtime(&m, value, "jet_rt_string_from_static"))
        .Struct(_, _) -> {
            id :: lower_static_object(&m, lower_size(p, ty).size)
            lower_static_fill(p, &m, &f, id, 0, ty, constant)
            if f.failed -> return None
            return Val(lower_static_pointer(id))
        }
        .Enum(name, variant, args) -> {
            definition :: lower_type_def(p, ty) ?? {
                lower_fail(&m, &f, "Enum constant {name} without a definition is not lowered at O0 yet")
                return None
            }
            if !lower_constant_owner(definition, ty, name) {
                lower_fail(&m, &f, "Enum constant {name} as {definition.name} is not lowered at O0 yet")
                return None
            }
            found :: lower_variant(definition, variant) ?? {
                lower_fail(&m, &f, "Enum constant {name}.{variant} without a variant is not lowered at O0 yet")
                return None
            }
            selector :: lower_discriminant(found.index)
            if repr == .Discriminant -> return Val(lower_static_word(selector))
            id :: lower_static_object(&m, lower_enum_box_size(p, definition))
            lower_static_store(&m, id, 0, lower_static_word(selector))
            if found.variant.payload == {
                .Unit -> {}
                .Single(_) -> {
                    if args.len() != 1 || args[0].name != None {
                        lower_fail(&m, &f, "Enum constant {name}.{variant} without one positional payload is not lowered at O0 yet")
                        return None
                    }
                    info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? return None
                    lower_static_payload(p, &m, &f, id, info, args[0].value)
                }
                .Named(fields) -> {
                    loop (index, field) in fields {
                        if field.computed -> next
                        value :: lower_constant_arg(args, field.name) ?? {
                            lower_fail(&m, &f, "Enum constant {name}.{variant} without field {field.name} is not lowered at O0 yet")
                            return None
                        }
                        info :: lower_enum_payload_info(p, definition, found.variant, index) ?? return None
                        lower_static_payload(p, &m, &f, id, info, value)
                        if f.failed -> return None
                    }
                }
            }
            if f.failed -> return None
            return Val(lower_static_pointer(id))
        }
        .Present(value) -> {
            if ty.kind == {
                .Option(inner) -> {
                    id :: lower_static_object(&m, lower_option_box_size(p, inner))
                    lower_static_child(p, &m, &f, id, 0, inner, value)
                    if f.failed -> return None
                    return Val(lower_static_pointer(id))
                }
                .Result(ok, err) -> {
                    id :: lower_static_object(&m, lower_result_box_size(p, ok, err))
                    lower_static_store(&m, id, 0, lower_static_word(lower_result_selector(true)))
                    lower_static_child(p, &m, &f, id, lower_result_payload_offset(), ok, value)
                    if f.failed -> return None
                    return Val(lower_static_pointer(id))
                }
                else -> {
                    lower_fail(&m, &f, "Present constant without an Option or Result type is not lowered at O0 yet")
                    return None
                }
            }
        }
        .Failed(report) -> {
            if ty.kind == .Result(ok, err) && report == .Told(value) {
                id :: lower_static_object(&m, lower_result_box_size(p, ok, err))
                lower_static_store(&m, id, 0, lower_static_word(lower_result_selector(false)))
                lower_static_child(p, &m, &f, id, lower_result_payload_offset(), err, value)
                if f.failed -> return None
                return Val(lower_static_pointer(id))
            }
            // A clean failure of an Option is None (MIRRust.rs constant_for_type).
            if lower_option_inner(ty) != None && report == .Clean(_) -> return Val(lower_static_word(0))
            lower_fail(&m, &f, "Failed constant without a Result Told payload is not lowered at O0 yet")
            return None
        }
        .List(_) | .Bytes(_) | .Map(_) -> {
            id :: lower_static_object(&m, 24)
            lower_static_fill(p, &m, &f, id, 0, ty, constant)
            if f.failed -> return None
            return Val(lower_static_pointer(id))
        }
        .BigInt(decimal) -> {
            if lower_is_unsigned_word(ty) -> return Val(lower_static_word(lower_constant_u64_bits(decimal)))
            if !lower_is_exact_int(ty) {
                lower_fail(&m, &f, "BigInt constant of a non-Int type is not lowered at O0 yet")
                return None
            }
            return Val(lower_static_runtime(&m, decimal, "jet_rt_int_from_static"))
        }
        .SharedSite(_) -> lower_fail(&m, &f, "Shared publication sites must be read through their checked getter, not frozen as constant payloads")
    }
    None
}

// MIRRust.rs:global_expression (:6494-6512) resolves the declared constant.
// OWNER DIRECTION: unlike the Rust accessor, a read borrows frozen data and
// only an ownership-bearing checked MIR result clones it.
fn lower_static_global(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, name: String) Never! {
    // jet_transaction(): a fresh #Transact handle (Transaction.jet).
    if name == "transaction" && lower_global_definition(p, name) == None -> return lower_transaction_new(p, c, &m, &f, instruction)
    if name == "stm" && lower_global_definition(p, name) == None -> return lower_stm_new(p, c, &m, &f, instruction)
    definition :: lower_global_definition(p, name) ?? return lower_fail(&m, &f, "global constant {name} without a definition is not lowered at O0 yet")
    if definition.value == .SharedSite(site) {
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        if m.shared_sites_dynamic {
            return lower_call_runtime(&m, &f, mir_shared_site_getter_symbol(site.initializer), [LIRValueID]{}, Val(dst))
        }
        return lower_call_helper(&m, &f, definition.key, definition.ty, [LIRValueID]{}, Val(dst))
    }
    if definition.is_storage {
        // A read of module storage: its current value (lower_static_storage).
        if lower_repr(p, definition.ty) == .Absent -> return lower_alias_absent(&f, instruction)
        cell :: lower_static_storage(p, &m, &f, definition) ?? return
        dst :: lower_result(p, c, &m, &f, instruction) ?? return
        owned :: lower_value_owned(c, instruction.result ?? MIRValueID{value: U64.MAX})
        if owned && lower_needs_drop(p, m, definition.ty) {
            held :: lower_read_at(p, &f, cell, 0, definition.ty) ?? return
            return lower_clone_into(p, &m, &f, held, dst, definition.ty)
        }
        return lower_read_into(p, &f, dst, cell, 0, definition.ty)
    }
    repr :: lower_repr(p, definition.ty)
    if repr == .Absent -> return lower_alias_absent(&f, instruction)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    value :: lower_static_constant_value(p, &m, &f, definition) ?? return
    if value.data == .Val(data) {
        owned := false
        if instruction.result == .Val(result) -> owned = lower_value_owned(c, result)
        source :: if owned -> (if repr == .ExactInt || repr == .Word -> lower_word(&f) else -> lower_pointer(&f)) else -> dst
        if repr == .Handle(_, _) || repr == .ExactInt {
            // Runtime-owned constants point at the cell filled by their fixup.
            cell :: lower_pointer(&f)
            lower_emit(&f, LIRInst.DataAddress{dst: cell, data: data})
            lower_emit(&f, LIRInst.Load{dst: source, base: cell, offset: 0})
        } else {
            lower_emit(&f, LIRInst.DataAddress{dst: source, data: data})
        }
        if owned {
            if repr == {
                .ExactInt -> lower_call_runtime(&m, &f, "jet_rt_int_clone", [LIRValueID]{source}, Val(dst))
                .Handle(_, clone) -> lower_call_runtime(&m, &f, clone, [LIRValueID]{source}, Val(dst))
                .Boxed(ty) -> lower_call_clone_glue(&m, &f, ty, source, dst)
                .Inline(aggregate) -> {
                    lower_storage_into(p, &f, dst, aggregate)
                    lower_inline_clone(p, &m, &f, source, dst, aggregate)
                }
                else -> lower_fail(&m, &f, "owned static constant carrier is not lowered at O0 yet")
            }
        }
    } else {
        lower_emit(&f, LIRInst.Const{dst: dst, value: value.word})
    }
}

// Module storage (`name := value` at module level, MIRConstantDef.is_storage):
// one writable data object per declaration, holding its value, filled once
// from the declared initial value (runtime-owned words by the entry fixups).
// Places rooted at it are read and written in that memory, as a cell's are.
// Only scalar and handle carriers: a frozen List or Map tree would be
// mutated in place. A place rooted at an immutable constant (#5001) only
// reads: it names the constant's one frozen value, never a copy.
fn lower_static_walk(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, row: MIRPlace, name: String) -> LowerFieldAddress? {
    definition :: lower_global_definition(p, name) ?? {
        lower_fail(&m, &f, "module storage {name} without a definition is not lowered at O0 yet")
        return None
    }
    shared_site :: if definition.value == {.SharedSite(_) -> true else -> false}
    if !definition.is_storage && !shared_site {
        // #5001: a constant read in place borrows its one frozen value.
        object :: lower_static_constant_object(p, &m, &f, definition) ?? return None
        cell :: lower_pointer(&f)
        lower_emit(&f, LIRInst.DataAddress{dst: cell, data: object})
        if row.projections.len() == 0 -> return Val(LowerFieldAddress{base: cell, offset: 0})
        root :: lower_read_at(p, &f, cell, 0, definition.ty) ?? return None
        walked :: lower_walk_place(p, c, &m, &f, root, definition.ty, row.projections) ?? return None
        return Val(walked.address)
    }
    cell :: lower_static_storage(p, &m, &f, definition) ?? return None
    if row.projections.len() == 0 -> return Val(LowerFieldAddress{base: cell, offset: 0})
    root :: lower_read_at(p, &f, cell, 0, definition.ty) ?? return None
    lower_walk_projections(p, c, &m, &f, root, definition.ty, row.projections)
}

// The frozen value of module constant `definition`, built once and shared by
// every `Global` read and `Static` place (`static_rows`): a word, or the data
// object holding it (a runtime-owned word's cell filled at startup).
fn lower_static_constant_value(p: MIRProgram, m: &LowerModule, f: &LowerFunction, definition: MIRConstantDef) -> LowerStaticValue? {
    if m.static_rows.get(definition.key) == .Val(index) -> return Val(lower_static_pointer(LIRDataID{value: index}))
    value := lower_static_tree(p, &m, &f, definition.ty, definition.value) ?? return None
    if value.text != None {
        cell :: lower_static_object(&m, 8)
        lower_static_store(&m, cell, 0, value)
        value = lower_static_pointer(cell)
    }
    if value.data == .Val(data) -> &m.static_rows.add(definition.key.copy(), data.value).drop("checked absent above")
    Val(value)
}

// #5001: the frozen object holding constant `definition`'s value at offset 0
// the way a slot of its type holds it, built once (`static_rows`): an inline
// value's own storage, a runtime-owned word's cell, or a cell with the word
// (a scalar, or a box pointer) for any other carrier.
fn lower_static_constant_object(p: MIRProgram, m: &LowerModule, f: &LowerFunction, definition: MIRConstantDef) -> LIRDataID? {
    key :: "place:{definition.key}"
    if m.static_rows.get(key) == .Val(index) -> return Val(LIRDataID{value: index})
    value :: lower_static_constant_value(p, &m, &f, definition) ?? return None
    repr :: lower_repr(p, definition.ty)
    object := LIRDataID{value: -1}
    runtime_cell :: if repr == {
        .Handle(_, _) | .ExactInt -> true
        else -> false
    }
    if (lower_is_inline(p, definition.ty) || runtime_cell) && value.data != None {
        object = value.data ?? LIRDataID{value: -1}
    } else {
        object = lower_static_object(&m, 8)
        size :: lower_size(p, definition.ty).size
        lower_static_store_sized(&m, object, 0, value, if size > 0 && size < 8 -> size else -> 8)
    }
    &m.static_rows.add(key, object.value).drop("checked absent above")
    Val(object)
}

// The address of module storage `definition`'s value.
fn lower_static_storage(p: MIRProgram, m: &LowerModule, f: &LowerFunction, definition: MIRConstantDef) -> LIRValueID? {
    shared_site :: if definition.value == {.SharedSite(_) -> true else -> false}
    if shared_site && m.shared_sites_dynamic -> panic("dynamic image attempted to emit a Core publication cell")
    if lower_repr(p, definition.ty) == {
        .Word | .Flag | .FloatBits | .Float32Bits | .Discriminant | .Handle(_, _) -> {}
        else -> {
            lower_fail(&m, &f, "module storage {definition.name} of {mir_type_display_name(definition.ty)} is not lowered at O0 yet")
            return None
        }
    }
    key :: "storage:{definition.key}"
    object := LIRDataID{value: -1}
    if m.static_rows.get(key) == .Val(index) {
        object = LIRDataID{value: index}
    } else {
        object = lower_static_object(&m, 8)
        if !shared_site {
            lower_static_child(p, &m, &f, object, 0, definition.ty, definition.value)
        }
        if f.failed -> return None
        &m.static_rows.add(key, object.value).drop("checked absent above")
    }
    cell :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: cell, data: object})
    Val(cell)
}

// Fills every runtime-owned slot of the frozen statics before entry. The
// Program handles live until process exit; compiler callable handles live
// until their image finalizer releases them.
fn lower_static_fixups(p: MIRProgram, m: &LowerModule, f: &LowerFunction) Never! {
    fixups :: m.static_fixups.copy()
    loop fixup in fixups {
        object :: lower_pointer(&f)
        lower_emit(&f, LIRInst.DataAddress{dst: object, data: fixup.object})
        if fixup.constructor == {
            .Runtime(text_data, symbol) -> {
                text :: lower_pointer(&f)
                lower_emit(&f, LIRInst.DataAddress{dst: text, data: text_data})
                length :: lower_const(&f, m.data[text_data.value].bytes.len())
                layout :: if symbol == "jet_rt_int_from_static" -> lir_layout_word() else -> lir_layout_pointer()
                handle :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
                lower_call_runtime(&m, &f, symbol, [LIRValueID]{text, length}, Val(handle))
                lower_emit(&f, LIRInst.Store{base: object, offset: fixup.offset, value: handle})
            }
            .Map(ty, entries, capacity_data) -> {
                map :: lower_address(&f, object, fixup.offset)
                lower_constant_map_fill(p, &m, &f, map, ty, entries)
                if f.failed -> return
                capacity :: lower_list_word(&f, map, 8)
                cell :: lower_pointer(&f)
                lower_emit(&f, LIRInst.DataAddress{dst: cell, data: capacity_data})
                lower_emit(&f, LIRInst.Store{base: cell, offset: 0, value: capacity})
                // Readers borrow an immutable tree. Only image finalization
                // restores the allocation's capacity and releases its owners.
                lower_store_word(&f, map, 8, 0)
            }
        }
    }
}

// Release runtime owners, never borrowed frozen storage. A Map constructor
// owns its entry buffer until finalization; its public header has capacity zero.
fn lower_static_release(p: MIRProgram, m: &LowerModule, f: &LowerFunction) Never! {
    loop fixup in m.static_fixups {
        object :: lower_pointer(&f)
        lower_emit(&f, LIRInst.DataAddress{dst: object, data: fixup.object})
        if fixup.constructor == {
            .Runtime(_, symbol) -> {
                if symbol != "jet_rt_string_from_static" && symbol != "jet_rt_int_from_static" -> next
                exact_int :: symbol == "jet_rt_int_from_static"
                layout :: if exact_int -> lir_layout_word() else -> lir_layout_pointer()
                handle :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
                lower_emit(&f, LIRInst.Load{dst: handle, base: object, offset: fixup.offset})
                lower_store_word(&f, object, fixup.offset, 0)
                lower_call_runtime(&m, &f, if exact_int -> "jet_rt_int_drop" else -> "jet_rt_string_drop", [LIRValueID]{handle}, None)
            }
            .Map(ty, _, capacity_data) -> {
                map :: lower_address(&f, object, fixup.offset)
                cell :: lower_pointer(&f)
                lower_emit(&f, LIRInst.DataAddress{dst: cell, data: capacity_data})
                capacity :: lower_list_word(&f, cell, 0)
                lower_emit(&f, LIRInst.Store{base: map, offset: 8, value: capacity})
                lower_inline_drop(p, &m, &f, map, ty)
                zero :: lower_const(&f, 0)
                loop offset in ([Int]{0, 8, 16}) -> lower_emit(&f, LIRInst.Store{base: map, offset: offset, value: zero})
                lower_emit(&f, LIRInst.Store{base: cell, offset: 0, value: zero})
            }
        }
    }
}

// Canonical pinned Core startup (f174690c2), with typed Map fixups.
fn lower_core_shared_init(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{}, None)
    lower_static_fixups(p, &m, &f)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

// Lists.jet clone already copies into a fresh header/buffer and never frees its
// source. Drop must skip the entire frozen tree, not just the data-buffer free.
fn lower_static_list_drop_guard(f: &LowerFunction, cap: LIRValueID, data: LIRValueID, done: LIRBlockID) Never! {
    zero :: lower_const(&f, 0)
    no_capacity :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: no_capacity, condition: LIRCondition.Eq, left: cap, right: zero})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    has_data :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: has_data, condition: LIRCondition.Ne, left: data, right: null})
    frozen :: lower_flag(&f)
    lower_logic(&f, frozen, true, no_capacity, has_data)
    owned :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: frozen, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(owned, [LIRValueID]{})})
    lower_start(&f, owned, [LIRValueID]{})
}

// The sole getter body for a pinned Core publication site. Every local read
// calls this helper; dynamic images import its stable symbol instead.
fn lower_shared_site_helper(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    definition :: lower_global_definition(p, glue.helper) ?? panic("publication helper has no checked site row")
    site :: if definition.value == {.SharedSite(value) -> value else -> panic("publication helper names an ordinary constant")}
    f := lower_helper_start(&m, glue, [LIRLayout]{}, Val(lir_layout_pointer()))
    if m.shared_sites_dynamic -> panic("dynamic image attempted to emit a Core publication getter")
    f.builder.name = mir_shared_site_getter_symbol(site.initializer)
    f.name = f.builder.name.copy()
    loop exported in m.shared_sites {
        if exported.initializer == site.initializer || exported.symbol == f.builder.name {
            message :: "duplicate or colliding Core publication getter {f.builder.name}"
            lower_fail(&m, &f, message)
            return lir_builder_finish(f.builder)
        }
    }
    // copy: the shared-site export row stores the helper's symbol, while the builder keeps its own
    // name to finish the function (lir_builder_finish below).
    &m.shared_sites.push(LIRSharedSiteExport{initializer: site.initializer, site_key: definition.key, function: glue.id, symbol: f.builder.name.copy(), lifetime: site.lifetime, ty: definition.ty})
    cell :: lower_static_storage(p, &m, &f, definition) ?? return lir_builder_finish(f.builder)
    tls :: site.lifetime == MIRSharedLifetime.Thread || site.lifetime == MIRSharedLifetime.Attempt
    key := LIRValueID{value: -1}
    if tls {
        scope :: lower_const(&f, if site.lifetime == MIRSharedLifetime.Attempt -> 1 else -> 0)
        key = lower_word(&f)
        lower_call_runtime(&m, &f, "jet_rt_tls_shared_key", [LIRValueID]{cell, scope}, Val(key))
    }
    existing :: lower_pointer(&f)
    if tls -> lower_call_runtime(&m, &f, "jet_rt_tls_get", [LIRValueID]{key}, Val(existing))
    else {
        // Native lowering currently targets x64 only: this naturally aligned
        // word load has acquire ordering under TSO. An AArch64/native target
        // must introduce an acquire LIR load before enabling publication sites.
        lower_emit(&f, LIRInst.Load{dst: existing, base: cell, offset: 0})
    }
    zero :: lower_const(&f, 0)
    initialized :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: initialized, condition: LIRCondition.Ne, left: existing, right: zero})
    slow :: lower_new_block(&f)
    joined :: lower_new_block(&f)
    winner :: lower_pointer(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: initialized, then_target: lower_target(joined, [LIRValueID]{existing}), else_target: lower_target(slow, [LIRValueID]{})})
    lower_start(&f, slow, [LIRValueID]{})
    row :: lower_function_index(m, site.initializer)
    if row < 0 -> panic("pinned Core publication initializer was pruned")
    candidate :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Call{dst: Val(candidate), signature: m.mir_signatures[row], callee: LIRCallee.Function{id: LIRFunctionID{value: row}}, args: [LIRValueID]{}})
    published := candidate
    if tls {
        lower_call_runtime(&m, &f, "jet_rt_tls_set", [LIRValueID]{key, candidate}, None)
    } else {
        lifetime :: lower_const(&f, if site.lifetime == MIRSharedLifetime.World -> 1 else -> 0)
        published = lower_pointer(&f)
        lower_call_runtime(&m, &f, "jet_rt_shared_site_publish", [LIRValueID]{cell, candidate, lifetime}, Val(published))
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(joined, [LIRValueID]{published})})
    lower_start(&f, joined, [LIRValueID]{winner})
    result :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_native_shared_clone", [LIRValueID]{winner}, Val(result))
    lower_seal(&f, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(f.builder)
}
