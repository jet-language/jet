// Semantic record literals use the ordinary Struct constructor and layout.
use jet_foundation.[
    MIRField,
    MIRFieldID,
    MIRFieldValue,
    MIRInstruction,
    MIRProgram,
    MIRStructExtra,
    MIRTypeDef,
    MIRTypeID,
]

fn lower_struct_literal(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, type_id: MIRTypeID, fields: [MIRFieldValue], extra: MIRStructExtra?, trait_coercion: MIRTypeID?, boxed_fields: [MIRFieldID]) Never! {
    if trait_coercion != None -> return lower_fail(&m, &f, "StructLiteral trait coercion is not lowered at O0 yet")
    // MIRStructExtra has only HTTPRequestParams, not a spread/base value.
    // MIRRust.rs:semantic (26836) ignores that host-only marker;
    // O0 cannot supply its native HTTP request fields and must not omit them.
    if extra != None -> return lower_fail(&m, &f, "StructLiteral HTTPRequestParams extra is not lowered at O0 yet")
    lower_struct_construct(p, c, &m, &f, instruction, type_id, fields, boxed_fields)
}

// Shared by MIROperation.Struct and MIRSemanticOp.StructLiteral: the fields
// are moved into fresh frame storage at their offsets. Recursive edges add a
// wrapper box holding the child value, not another copy of the child
// (MIRRust.rs:rust_struct_literal, 4613; Constants.jet:lower_constant_payload).
fn lower_struct_construct(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, type_id: MIRTypeID, fields: [MIRFieldValue], boxed_fields: [MIRFieldID]) Never! {
    definition :: lower_owned_def(p, type_id, instruction.ty) ?? return lower_fail(&m, &f, "struct type {type_id.value} is missing")
    if lower_struct_def_fields(definition) == None -> return lower_fail(&m, &f, "{definition.name} is not a struct")
    ty :: instruction.ty ?? return lower_fail(&m, &f, "struct literal has no checked type")
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_storage_into(p, &f, dst, ty)
    loop value in fields {
        found :: lower_struct_field(p, ty, value.field) ?? return lower_fail(&m, &f, "field {value.field.value} is not a stored field of {definition.name}")
        indirect := found.boxed
        loop listed in boxed_fields { if listed == value.field -> indirect = true }
        if indirect {
            wrapper :: lower_pointer(&f)
            lower_alloc(&m, &f, wrapper, lower_option_box_size(p, found.ty))
            lower_store_value(p, &m, &f, wrapper, 0, value.value, found.ty)
            lower_emit(&f, LIRInst.Store{base: dst, offset: found.offset, value: wrapper})
        } else {
            lower_store_value(p, &m, &f, dst, found.offset, value.value, found.ty)
        }
        if f.failed -> return
    }
}

// Field reads and place projections must enter the same recursive wrapper.
// `found.offset` is the field's offset from `base`.
fn lower_struct_storage_address(f: &LowerFunction, base: LIRValueID, found: LowerFieldInfo) -> LowerFieldAddress Never! {
    if found.boxed {
        wrapper :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: wrapper, base: base, offset: found.offset})
        return LowerFieldAddress{base: wrapper, offset: 0}
    }
    LowerFieldAddress{base: base, offset: found.offset}
}

fn lower_struct_def_fields(definition: MIRTypeDef) -> [MIRField]? {
    if definition.kind == .Struct(fields, _) -> return Val(fields)
    None
}
