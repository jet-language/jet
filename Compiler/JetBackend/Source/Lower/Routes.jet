// Core calls, static Prelude routes and builtin methods through the runtime's
// generated C-ABI adapters (RuntimeRoutes.jet,
// crates/jet-codegen/src/Prelude/Core/CAbiRoutes.rs, both from
// Tools/agent/gen-c-abi-routes.mjs). Every argument is checked against its
// adapter carrier, so a call never hands the runtime a value of another
// representation. A List argument passes its slot buffer and length; a List
// result comes back as its length with its slot buffer in an out slot; an
// Option or Result result comes back as the adapter's tag word plus one out
// slot. The lowering builds its own List, Option or Result box from them.
use jet_foundation.[
    MIRCallArg, MIRInstruction, MIRPreludeCallID, MIRProgram, MIRType, MIRValueID,
    mir_symbol_name, mir_type_display_name,
]

// The carrier a value of `ty` crosses the runtime boundary as, if any. An
// alias crosses as its target (the seeded `ParseError` is a String).
fn lower_route_carrier_of(p: MIRProgram, ty: MIRType) -> LowerRouteCarrier? {
    if lower_text_type(ty) -> return Val(LowerRouteCarrier.Text)
    if lower_type_def(p, ty) == .Val(definition) {
        if definition.kind == .Alias(target) -> return lower_route_carrier_of(p, target)
    }
    if lower_list_element(ty) == .Val(elem) {
        if lower_route_contains_float32(p, elem) -> return None
        if lower_repr(p, ty) == .Unsupported(_) -> return None
        inner :: lower_route_carrier_of(p, elem) ?? return None
        if inner == .Unit || inner == .List(_) -> return None
        return Val(LowerRouteCarrier.List{elem: inner})
    }
    if lower_repr(p, ty) == {
        .Absent -> Val(LowerRouteCarrier.Unit)
        .Word -> Val(LowerRouteCarrier.Word)
        .Float32Bits -> Val(LowerRouteCarrier.Word)
        .Flag -> Val(LowerRouteCarrier.Flag)
        .FloatBits -> Val(LowerRouteCarrier.Float)
        .Handle(_, _) -> {
            if ty.kind == .Apply(name, args) {
                if args.len() == 0 {
                    runtime :: lower_runtime_handle(name.name) ?? return None
                    return Val(LowerRouteCarrier.Handle{name: runtime.runtime})
                }
            }
            None
        }
        else -> None
    }
}

// Raw binary32 is not a generic Word argument or a word-list element.
fn lower_route_contains_float32(p: MIRProgram, ty: MIRType) -> Bool Never! {
    if lower_repr(p, ty) == .Float32Bits -> return true
    if ty.kind == {
        .List(inner) | .FixedList(inner, _) | .Option(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return lower_route_contains_float32(p, inner)
        .Result(ok, err) -> return lower_route_contains_float32(p, ok) || lower_route_contains_float32(p, err)
        .Tuple(fields) -> {
            loop field in fields { if lower_route_contains_float32(p, field.ty) -> return true }
        }
        else -> {
            if lower_type_def(p, ty) == .Val(definition) {
                if definition.kind == .Alias(inner) | .Distinct(inner, _) -> return lower_route_contains_float32(p, inner)
            }
        }
    }
    false
}

// Extend only when another canonical Jet binary32 producer is approved.
fn lower_route_float32_result(p: MIRProgram, route: LowerRoute, ty: MIRType) -> Bool Never! {
    if route.export != "jet_reader_read_f32_le" && route.export != "jet_reader_read_f32_be" -> return false
    if ty.kind == .Result(ok, err) {
        return lower_repr(p, ok) == .Float32Bits && lower_text_type(err) && route.result == (LowerRouteResult.Result{ok: LowerRouteCarrier.Word, err: LowerRouteCarrier.Text})
    }
    false
}

// These Reader operations accept checked Int but their provider consumes an
// I64 count/position. Reference int_value stops before invoking the method
// when exact Int cannot fit I64; negative and bounds errors stay in Reader.
fn lower_reader_count_route(symbol: String) -> Bool Never! {
    symbol == "jet_reader_take" || symbol == "jet_reader_skip" || symbol == "jet_reader_seek"
}

fn lower_route_carrier_matches(p: MIRProgram, ty: MIRType, carrier: LowerRouteCarrier) -> Bool Never! {
    if carrier == .Tag(_, variants) -> return lower_route_tag_matches(p, ty, variants)
    if carrier == .HandleMut(name) {
        expected :: LowerRouteCarrier.Handle{name: name}
        return lower_route_carrier_of(p, ty) == Val(expected)
    }
    // A Core record crosses as its runtime handle (Records.jet), a List of
    // them as a buffer of handles.
    if carrier == .Handle(name) {
        if lower_record_handle(p, ty) == .Val(runtime) -> return runtime == name
    }
    if lower_record_list_element(p, ty, carrier) != None -> return lower_repr(p, ty) == .Inline(_)
    lower_route_carrier_of(p, ty) == .Val(carrier)
}

// The runtime type a value of `ty` crossing as `carrier` is converted to and
// from (Records.jet), or None when it crosses as itself.
fn lower_route_record(p: MIRProgram, ty: MIRType, carrier: LowerRouteCarrier) -> String? {
    if carrier == .Handle(_) -> return lower_record_handle(p, ty)
    None
}

// A fieldless runtime enum crosses as its variant index: the Jet enum's
// discriminant (lower_repr Discriminant) is that index only when its variants
// are the runtime's, in the same order.
fn lower_route_tag_matches(p: MIRProgram, ty: MIRType, variants: String) -> Bool Never! {
    if lower_repr(p, ty) != .Discriminant -> return false
    definition :: lower_type_def(p, ty) ?? return false
    if definition.kind == .Enum(rows, _) {
        names := [String]{}
        loop row in rows -> &names.push(row.name)
        return names.join(",") == variants
    }
    false
}

fn lower_route_layout(carrier: LowerRouteCarrier) -> LIRLayout Never! {
    if carrier == {
        .Flag -> lir_layout_bool()
        .Float -> lir_layout_float()
        .Text | .Handle(_) | .HandleMut(_) | .List(_) -> lir_layout_pointer()
        else -> lir_layout_word()
    }
}

// The drop of an owned result of `carrier` the caller does not keep.
fn lower_route_drop(carrier: LowerRouteCarrier) -> LIRDrop Never! {
    if carrier == {
        .Text -> LIRDrop.Runtime{symbol: "jet_rt_string_drop"}
        .Handle(name) -> LIRDrop.Runtime{symbol: "jet_rt_handle_drop_{name}"}
        else -> LIRDrop.Trivial
    }
}

// Explicit MIR Write arguments must match an adapter lending the caller's
// handle mutably. The pointer stays in the caller's place; no copy or write-back.
fn lower_route_values(p: MIRProgram, m: &LowerModule, f: &LowerFunction, call: MIRPreludeCallID, args: [MIRCallArg], what: String) -> [MIRValueID]? {
    row :: lower_prelude_row(p, call) ?? return None
    route :: lower_runtime_route(lower_route_symbol(row)) ?? {
        lower_fail(&m, &f, "{what} {row.module_name}.{row.member} has no runtime C-ABI route ({mir_symbol_name(row.symbol)})")
        return None
    }
    if args.len() != route.params.len() {
        lower_fail(&m, &f, "{what} {row.module_name}.{row.member} passes {args.len()} arguments; its runtime route takes {route.params.len()}")
        return None
    }
    values := [MIRValueID]{}
    loop (index, arg) in args {
        mutable :: if route.params[index] == .HandleMut(_) -> true else -> false
        if (arg.access == .Write) != mutable {
            lower_fail(&m, &f, "{what} {row.module_name}.{row.member} argument {index} access does not match its runtime route")
            return None
        }
        &values.push(arg.value)
    }
    Val(values)
}

// `what` names the MIR operation in reports ("CoreCall", "StaticPreludeCall",
// "BuiltinMethod"). A Core record argument crosses as a runtime handle made
// for the call and dropped after it.
fn lower_route_call(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, args: [MIRValueID], what: String) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "{what} names missing Prelude call {call.value}")
    if lower_lazy_route(p, c, &m, &f, instruction, row, args) -> return
    name :: "{row.module_name}.{row.member}"
    route :: lower_runtime_route(lower_route_symbol(row)) ?? return lower_fail(&m, &f, "{what} {name} has no runtime C-ABI route ({mir_symbol_name(row.symbol)})")
    // Native adapters for these operations have not established the same
    // output rail as the shared Core/runtime contract. Never emit a wrong run.
    if route.symbol == "jet_rng_int" || route.symbol == "JetDate::weekday"
        || route.symbol == "jet_services_runtime" || route.symbol == "jet_std_io_progress" {
        return lower_fail(&m, &f, "{what} {name} does not have native O0 runtime parity yet")
    }
    if route.params.len() != args.len() -> return lower_fail(&m, &f, "{what} {name} passes {args.len()} arguments; its runtime route takes {route.params.len()}")
    lowered := [LIRValueID]{}
    temporaries := [LIRValueID]{}
    // Each List of records lent as a handle buffer (Records.jet).
    record_lists := [LowerRecordList]{}
    loop (index, arg) in args {
        ty :: lower_value_type(c, arg) ?? return lower_fail(&m, &f, "{what} {name} argument {index} has no checked type")
        if lower_route_contains_float32(p, ty) -> return lower_fail(&m, &f, "Float32 route parameters are not lowered at O0 yet")
        if index == 1 && lower_reader_count_route(route.symbol) && lower_is_exact_int(ty) {
            value :: lower_use(&m, &f, arg) ?? return
            count :: lower_word(&f)
            lower_convert_exact(&m, &f, count, value, "jet_int_owned_to_i64", false)
            &lowered.push(count)
            next
        }
        // Checked unit conversion MIR carries its rounding mode as the
        // canonical exact-Int ordinal, not a nominal enum value. Marshal that
        // one semantic operand to the runtime's unchanged mode tag.
        rounding_tag := false
        if route.params[index] == .Tag(tag_name, variants) {
            rounding_tag = tag_name == "UnitRoundingMode" && variants == "TowardZero,Floor,Ceiling,NearestEven"
        }
        if row.module_name == "core.units" && (row.member == "conversion_rounded" || row.member == "conversion_rounded_measurement") && index == 5 && rounding_tag && lower_is_exact_int(ty) {
            value :: lower_use(&m, &f, arg) ?? return
            mode :: lower_word(&f)
            lower_convert_exact(&m, &f, mode, value, "jet_int_owned_to_i64", false)
            &lowered.push(mode)
            next
        }
        if !lower_route_carrier_matches(p, ty, route.params[index]) -> return lower_fail(&m, &f, "{what} {name} argument {index} of type {mir_type_display_name(ty)} does not match its runtime route carrier")
        if route.params[index] == .Unit -> next
        value :: lower_use(&m, &f, arg) ?? return
        if route.params[index] == .List(_) {
            if lower_record_list_element(p, ty, route.params[index]) != None {
                length :: lower_list_word(&f, value, 0)
                buffer :: lower_pointer(&f)
                lower_call_helper(&m, &f, "list.record_handles", ty, [LIRValueID]{value}, Val(buffer))
                &lowered.push(buffer)
                &lowered.push(length)
                &record_lists.push(LowerRecordList{ty: ty, buffer: buffer, length: length})
                next
            }
            &lowered.push(lower_list_data(&f, value))
            &lowered.push(lower_list_word(&f, value, 0))
            if route.symbol == "jet_reader_over" || route.symbol == "jet_reader_over_owned" {
                elem :: lower_list_element(ty) ?? return lower_fail(&m, &f, "Reader.over input has no checked List element")
                byte :: if elem.kind == .IntN(signed, bits) -> !signed && bits == 8 else -> false
                if !byte -> return lower_fail(&m, &f, "Reader.over input is not the canonical List<U8>")
                &lowered.push(lower_const(&f, lower_list_stride(p, elem)))
            }
            next
        }
        if lower_route_record(p, ty, route.params[index]) == .Val(runtime) {
            handle :: lower_record_to_runtime(p, &m, &f, ty, runtime, value)
            &lowered.push(handle)
            &temporaries.push(handle)
            next
        }
        &lowered.push(value)
    }
    lower_route_result(p, c, &m, &f, instruction, route, lowered, what, name)
    if f.failed -> return
    loop handle in temporaries -> lower_emit(&f, LIRInst.Drop{value: handle})
    loop lent in record_lists {
        lower_call_helper(&m, &f, "list.record_handles_free", lent.ty, [LIRValueID]{lent.buffer, lent.length}, None)
    }
}

// Result arms are exclusive, so each arm writes to the same payload slot.
// A List on either edge additionally writes its length to the next word.
fn lower_route_result_call(m: &LowerModule, f: &LowerFunction, symbol: String, args: [LIRValueID], ok: LowerRouteCarrier, err: LowerRouteCarrier) -> LowerRouteOut Never! {
    slot :: lower_pointer(&f)
    has_list :: ok == .List(_) || err == .List(_)
    lower_emit(&f, LIRInst.StackSlot{dst: slot, size: if has_list -> 16 else -> 8, align: 8})
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: zero})
    if has_list -> lower_emit(&f, LIRInst.Store{base: slot, offset: 8, value: zero})
    call_args := args
    if ok != .Unit {
        &call_args.push(slot)
        if ok == .List(_) -> &call_args.push(lower_address(&f, slot, 8))
    }
    if err != .Unit {
        &call_args.push(slot)
        if err == .List(_) -> &call_args.push(lower_address(&f, slot, 8))
    }
    selector :: lower_word(&f)
    lower_call_runtime(&m, &f, symbol, call_args, Val(selector))
    LowerRouteOut{word: selector, slot: slot}
}

// Int.to_radix is checked String, while the kernel's raw ABI returns
// Result<Text, Text>. Match MIRRust.rs:31336-31345's caller fault adapter:
// retain the selected text on success, and report faults at the MIR location.
fn lower_route_int_radix(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: LowerRoute, args: [LIRValueID]) Never! {
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return
    out :: lower_route_result_call(&m, &f, route.export, args, LowerRouteCarrier.Text, LowerRouteCarrier.Text)
    text :: dst ?? lower_new_value(&f, lir_layout_pointer(), lower_route_drop(LowerRouteCarrier.Text), None)
    lower_emit(&f, LIRInst.Load{dst: text, base: out.slot, offset: 0})
    zero :: lower_const(&f, 0)
    succeeded :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: out.word, right: zero})
    success :: lower_new_block(&f)
    failure :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    message :: lower_pointer(&f)
    length :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: message, base: text, offset: 0})
    lower_emit(&f, LIRInst.Load{dst: length, base: text, offset: 8})
    site :: lower_numeric_location(p, c, &m, &f, instruction, None)
    lower_noreturn_call(&m, &f, "jet_rt_numeric_stop", [LIRValueID]{site[0], site[1], site[2], message, length})
    lower_start(&f, success, [LIRValueID]{})
    if dst == None -> lower_emit(&f, LIRInst.Drop{value: text})
}

fn lower_route_result(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: LowerRoute, lowered: [LIRValueID], what: String, name: String) Never! {
    result_ty :: lower_checked_type(c, instruction)
    if result_ty == .Val(ty) && lower_route_contains_float32(p, ty) {
        if !lower_route_float32_result(p, route, ty) -> return lower_fail(&m, &f, "Float32 route results outside the approved reader ABI are not lowered at O0 yet")
    }
    if route.result == {
        .Plain(carrier) -> {
            if carrier == .Unit {
                if result_ty == .Val(ty) {
                    if lower_repr(p, ty) != .Absent -> return lower_fail(&m, &f, "{what} {name} result type {mir_type_display_name(ty)} does not match its runtime route")
                }
                lower_call_runtime(&m, &f, route.export, lowered, None)
                return lower_alias_absent(&f, instruction)
            }
            if result_ty == .Val(ty) {
                if !lower_route_result_matches(p, ty, carrier) -> return lower_fail(&m, &f, "{what} {name} result type {mir_type_display_name(ty)} does not match its runtime route")
            }
            dst :: lower_result(p, c, &m, &f, instruction)
            if f.failed -> return
            if carrier == .List(_) {
                // A List is its inline [len, cap, data] header (Lists.jet,
                // Values.jet); the adapter allocated exactly len slots.
                list_ty :: result_ty ?? return lower_fail(&m, &f, "{what} {name} List result has no checked type")
                out :: lower_route_tagged_call(&m, &f, route.export, lowered, 1)
                data :: lower_pointer(&f)
                lower_emit(&f, LIRInst.Load{dst: data, base: out.slot, offset: 0})
                if lower_record_list_element(p, list_ty, carrier) != None {
                    if dst == None -> return lower_call_helper(&m, &f, "list.record_handles_free", list_ty, [LIRValueID]{data, out.word}, None)
                    kept :: dst
                    lower_storage_into(p, &f, kept, list_ty)
                    return lower_record_list_from_runtime(p, &m, &f, list_ty, data, out.word, kept)
                }
                box :: dst ?? lower_pointer(&f)
                lower_storage_into(p, &f, box, list_ty)
                lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: out.word})
                lower_emit(&f, LIRInst.Store{base: box, offset: 8, value: out.word})
                lower_emit(&f, LIRInst.Store{base: box, offset: 16, value: data})
                return
            }
            if result_ty == .Val(ty) {
                if lower_route_record(p, ty, carrier) == .Val(runtime) {
                    handle :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_{runtime}"}, None)
                    lower_call_runtime(&m, &f, route.export, lowered, Val(handle))
                    return lower_record_from_runtime(p, &m, &f, ty, handle, dst)
                }
            }
            if dst == .Val(kept) -> return lower_call_runtime(&m, &f, route.export, lowered, Val(kept))
            unused :: lower_new_value(&f, lower_route_layout(carrier), lower_route_drop(carrier), None)
            lower_call_runtime(&m, &f, route.export, lowered, Val(unused))
            if lower_route_drop(carrier) != .Trivial -> lower_emit(&f, LIRInst.Drop{value: unused})
        }
        .Option(some) -> {
            ty :: result_ty ?? return lower_fail(&m, &f, "{what} {name} Option result has no checked type")
            if !lower_route_shape_matches(p, ty, route.result) -> return lower_fail(&m, &f, "{what} {name} result type {mir_type_display_name(ty)} does not match its runtime route")
            dst :: lower_result(p, c, &m, &f, instruction)
            if f.failed -> return
            list_payload :: if some == .List(_) -> true else -> false
            out :: if list_payload -> lower_route_out_call(&m, &f, route.export, lowered, 2, true) else -> lower_route_tagged_call(&m, &f, route.export, lowered, 1)
            zero :: lower_const(&f, 0)
            present :: lower_flag(&f)
            lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ne, left: out.word, right: zero})
            some_block :: lower_new_block(&f)
            none_block :: lower_new_block(&f)
            merge :: lower_new_block(&f)
            lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(some_block, [LIRValueID]{}), else_target: lower_target(none_block, [LIRValueID]{})})
            lower_start(&f, some_block, [LIRValueID]{})
            inner :: if ty.kind == .Option(payload) -> payload else -> panic("checked Option route shape")
            box :: lower_pointer(&f)
            lower_alloc(&m, &f, box, lower_box_size(p, ty))
            lower_route_store_payload(p, &m, &f, box, 0, inner, some, out.slot)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{box})})
            lower_start(&f, none_block, [LIRValueID]{})
            null :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Const{dst: null, value: 0})
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{null})})
            joined :: dst ?? lower_pointer(&f)
            lower_start(&f, merge, [LIRValueID]{joined})
        }
        .Result(ok, err) -> {
            ty :: result_ty ?? return lower_fail(&m, &f, "{what} {name} Result result has no checked type")
            if route.symbol == "jet_std::jet_int_to_radix" && ty.kind == .String {
                if ok != .Text || err != .Text -> return lower_fail(&m, &f, "Int.to_radix kernel must return the canonical Text/Text Result ABI")
                return lower_route_int_radix(p, c, &m, &f, instruction, route, lowered)
            }
            if !lower_route_shape_matches(p, ty, route.result) -> return lower_fail(&m, &f, "{what} {name} result type {mir_type_display_name(ty)} does not match its runtime route")
            dst :: lower_result(p, c, &m, &f, instruction)
            if f.failed -> return
            // Alternative success/error out pointers share payload storage.
            list_payload :: ok == .List(_) || err == .List(_)
            call_args := lowered
            if route.symbol == "jet_reader_take" {
                success :: if ty.kind == .Result(payload, _) -> payload else -> panic("checked Reader.take result")
                elem :: lower_list_element(success) ?? return lower_fail(&m, &f, "Reader.take result has no checked List element")
                byte :: if elem.kind == .IntN(signed, bits) -> !signed && bits == 8 else -> false
                if !byte -> return lower_fail(&m, &f, "Reader.take result is not the canonical List<U8>")
                &call_args.push(lower_const(&f, lower_list_stride(p, elem)))
            }
            out :: lower_route_result_call(&m, &f, route.export, call_args, ok, err)
            ok_ty :: if ty.kind == .Result(success, _) -> success else -> panic("checked Result route shape")
            err_ty :: if ty.kind == .Result(_, failure) -> failure else -> panic("checked Result route shape")
            box :: dst ?? lower_pointer(&f)
            lower_alloc(&m, &f, box, lower_box_size(p, ty))
            lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: out.word})
            // A List or a Core record payload is built on its own edge.
            branched :: list_payload || lower_route_record(p, ok_ty, ok) != None || lower_route_record(p, err_ty, err) != None
            if branched {
                zero :: lower_const(&f, 0)
                succeeded :: lower_flag(&f)
                lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: out.word, right: zero})
                success :: lower_new_block(&f)
                failure :: lower_new_block(&f)
                merge :: lower_new_block(&f)
                lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
                lower_start(&f, success, [LIRValueID]{})
                lower_route_store_payload(p, &m, &f, box, 8, ok_ty, ok, out.slot)
                lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
                lower_start(&f, failure, [LIRValueID]{})
                lower_route_store_payload(p, &m, &f, box, 8, err_ty, err, out.slot)
                lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
                lower_start(&f, merge, [LIRValueID]{})
            } else {
                payload :: lower_word(&f)
                lower_emit(&f, LIRInst.Load{dst: payload, base: out.slot, offset: 0})
                lower_emit(&f, LIRInst.Store{base: box, offset: 8, value: payload})
            }
        }
        .Tuple(items) -> {
            ty :: result_ty ?? return lower_fail(&m, &f, "{what} {name} tuple result has no checked type")
            if !lower_route_shape_matches(p, ty, route.result) -> return lower_fail(&m, &f, "{what} {name} result type {mir_type_display_name(ty)} does not match its runtime route")
            dst :: lower_result(p, c, &m, &f, instruction)
            if f.failed -> return
            slot :: lower_pointer(&f)
            lower_emit(&f, LIRInst.StackSlot{dst: slot, size: 8 * items.len(), align: 8})
            zero :: lower_const(&f, 0)
            call_args := [LIRValueID]{}
            loop arg in lowered -> &call_args.push(arg)
            loop index in 0..<items.len() {
                lower_emit(&f, LIRInst.Store{base: slot, offset: 8 * index, value: zero})
                &call_args.push(lower_address(&f, slot, 8 * index))
            }
            lower_call_runtime(&m, &f, route.export, call_args, None)
            box :: dst ?? lower_pointer(&f)
            lower_storage_into(p, &f, box, ty)
            members :: lower_inline_members(p, ty)
            loop (index, item) in items {
                address :: lower_address(&f, slot, 8 * index)
                lower_route_store_payload(p, &m, &f, box, members[index].offset, members[index].ty, item, address)
            }
        }
    }
}

// Whether a checked result type `ty` is what the adapter's result shape builds.
fn lower_route_shape_matches(p: MIRProgram, ty: MIRType, result: LowerRouteResult) -> Bool Never! {
    if result == {
        .Plain(carrier) -> lower_route_result_matches(p, ty, carrier)
        .Option(some) -> if ty.kind == {
            .Option(inner) -> lower_route_result_matches(p, inner, some)
            else -> false
        }
        .Result(ok, err) -> if ty.kind == {
            .Result(ok_ty, err_ty) -> lower_route_result_matches(p, ok_ty, ok) && lower_route_result_matches(p, err_ty, err)
            else -> false
        }
        .Tuple(items) -> if ty.kind == {
            .Tuple(elems) -> {
                if elems.len() != items.len() -> return false
                loop (index, item) in items {
                    if !lower_route_result_matches(p, elems[index].ty, item) -> return false
                }
                true
            }
            else -> false
        }
    }
}

// Lists of runtime record handles are rebuilt into native element storage
// before they become owned results (Records.jet).
fn lower_route_result_matches(p: MIRProgram, ty: MIRType, carrier: LowerRouteCarrier) -> Bool Never! {
    lower_route_carrier_matches(p, ty, carrier)
}

// An adapter's tag word and the stack slot its payload was written to.
struct LowerRouteOut {
    pub word: LIRValueID
    pub slot: LIRValueID
}

// Call an adapter that returns a tag word and writes its payload through
// `outs` out pointers, all to one zeroed stack slot.
fn lower_route_tagged_call(m: &LowerModule, f: &LowerFunction, export: String, args: [LIRValueID], outs: Int) -> LowerRouteOut Never! {
    lower_route_out_call(&m, &f, export, args, outs, false)
}

fn lower_route_out_call(m: &LowerModule, f: &LowerFunction, export: String, args: [LIRValueID], outs: Int, list: Bool) -> LowerRouteOut Never! {
    slot :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: slot, size: if list -> 16 else -> 8, align: 8})
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: zero})
    if list -> lower_emit(&f, LIRInst.Store{base: slot, offset: 8, value: zero})
    call_args := [LIRValueID]{}
    loop arg in args -> &call_args.push(arg)
    loop index in 0..<outs -> &call_args.push(lower_address(&f, slot, if list && index == 1 -> 8 else -> 0))
    word :: lower_word(&f)
    lower_call_runtime(&m, &f, export, call_args, Val(word))
    LowerRouteOut{word: word, slot: slot}
}

// An adapter payload owns its result. List slots arrive as (data, length);
// the native holder owns the buffer through its ordinary List drop glue. A
// Core record arrives as its runtime handle, converted and dropped here.
fn lower_route_store_payload(p: MIRProgram, m: &LowerModule, f: &LowerFunction, box: LIRValueID, offset: Int, ty: MIRType, carrier: LowerRouteCarrier, slot: LIRValueID) Never! {
    if carrier == .Unit -> return
    if lower_route_record(p, ty, carrier) == .Val(runtime) -> return lower_record_store_from_slot(p, &m, &f, ty, runtime, slot, box, offset)
    if carrier == .List(_) {
        data :: lower_pointer(&f)
        length :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: data, base: slot, offset: 0})
        lower_emit(&f, LIRInst.Load{dst: length, base: slot, offset: 8})
        if lower_record_list_element(p, ty, carrier) != None {
            target :: lower_address(&f, box, offset)
            return lower_record_list_from_runtime(p, &m, &f, ty, data, length, target)
        }
        lower_emit(&f, LIRInst.Store{base: box, offset: offset, value: length})
        lower_emit(&f, LIRInst.Store{base: box, offset: offset + 8, value: length})
        lower_emit(&f, LIRInst.Store{base: box, offset: offset + 16, value: data})
    } else {
        payload :: lower_new_value(&f, lower_route_layout(carrier), LIRDrop.Trivial, ty.identity)
        lower_emit(&f, LIRInst.Load{dst: payload, base: slot, offset: 0})
        lower_write_at(p, &f, box, offset, payload, ty)
    }
}
