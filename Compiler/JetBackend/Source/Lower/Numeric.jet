// Numeric predicates and 64-bit overflow policies. The Prelude's shared
// FixedArithmetic.rs kernel, not Rust's narrower checked_rem, defines the rules.
use jet_foundation.[
    MIRBinaryOp, MIRBinaryOverflow, MIRInstruction, MIRPanicLoc, MIRPreludeCall, MIRPreludeCallID, MIRProgram, MIRSourceFileID,
    MIRType, MIRTypeKind, MIRValueID, mir_symbol_name, mir_type_display_name, mir_type_from_kind,
]

// Fixed-width trapping arithmetic stays in the native checked operator body:
// every `jet_<width>_trap_<op>` Prelude route Core.rs jet_fixed_route_kernels
// defines. Division/remainder include its zero and signed MIN / -1 checks;
// floor division, floored modulo and power follow lower_fixed_trap_floor.
fn lower_fixed_trap_route(symbol: String) -> Bool Never! {
    widths :: [String]{"u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64"}
    operations :: [String]{"add", "sub", "mul", "div", "rem", "floor_div", "mod", "pow", "shl", "shr"}
    loop width in widths {
        loop operation in operations {
            expected :: "jet_{width}_trap_{operation}"
            if symbol == expected -> return true
        }
    }
    false
}

// `jet_<width>_trap_floor_div`, `_mod` and `_pow` inline: FixedArithmetic.rs
// floor_div / floored_mod and power in TRAP mode (Core.rs
// jet_fixed_route_kernels, Power.rs JetPow::jet_pow). A zero divisor stops
// with "divided by zero"; floor division rounds toward negative infinity and
// overflows only at the signed MIN / -1 quotient; the floored remainder takes
// the divisor's sign and never overflows; unsigned operands floor-divide and
// take the remainder as UDiv / URem. A power goes through the trapping
// 64-bit pow helper of the same signedness, whose products are exact factors
// of the result, then a narrow result is range-checked like a product.
fn lower_fixed_trap_floor(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, op: MIRBinaryOp, ty: MIRType, left: LIRValueID, right: LIRValueID, location: [LIRValueID]) Never! {
    narrow :: lower_narrow_bits(ty)
    bits :: if narrow > 0 -> narrow else -> 64
    signed :: if narrow > 0 -> lower_narrow_signed(ty) else -> !lower_is_unsigned_word(ty)
    if op == .Pow {
        wide :: mir_type_from_kind(MIRTypeKind.IntN{signed: signed, bits: 64})
        args := [LIRValueID]{left, right}
        loop value in location -> &args.push(value)
        if narrow == 0 -> return lower_call_helper(&m, &f, "numeric.pow.checked_policy", wide, args, Val(dst))
        power :: lower_word(&f)
        lower_call_helper(&m, &f, "numeric.pow.checked_policy", wide, args, Val(power))
        lower_narrow_check(p, c, &m, &f, power, signed, bits, location, lower_numeric_overflow_message("pow"))
        return lower_emit(&f, LIRInst.Move{dst: dst, src: power})
    }
    modulo :: op == .Mod
    zero :: lower_const(&f, 0)
    is_zero :: lower_numeric_compare(&f, LIRCondition.Eq, right, zero)
    lower_numeric_check(p, Val(c), &m, &f, is_zero, location, "divided by zero")
    if !signed -> return lower_emit(&f, LIRInst.Binary{dst: dst, op: if modulo -> LIRBinaryOp.URem else -> LIRBinaryOp.UDiv, left: left, right: right})
    // A -1 divisor never reaches IDIV (MIN / -1 faults): the floored
    // quotient is the negation, out of range exactly at the type's MIN, and
    // the floored remainder is 0.
    minus_one :: lower_const(&f, -1)
    is_minus_one :: lower_numeric_compare(&f, LIRCondition.Eq, right, minus_one)
    negate :: lower_new_block(&f)
    divide :: lower_new_block(&f)
    adjust :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_minus_one, then_target: lower_target(negate, [LIRValueID]{}), else_target: lower_target(divide, [LIRValueID]{})})
    lower_start(&f, negate, [LIRValueID]{})
    if modulo {
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{zero})})
    } else {
        minimum :: lower_const(&f, -1 - lower_narrow_max(true, bits))
        overflowed :: lower_numeric_compare(&f, LIRCondition.Eq, left, minimum)
        lower_numeric_check(p, Val(c), &m, &f, overflowed, location, lower_numeric_overflow_message("div"))
        negated :: lower_numeric_binary(&f, LIRBinaryOp.Sub, zero, left)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{negated})})
    }
    lower_start(&f, divide, [LIRValueID]{})
    remainder :: lower_numeric_binary(&f, LIRBinaryOp.Rem, left, right)
    truncated :: if modulo -> remainder else -> lower_numeric_binary(&f, LIRBinaryOp.Div, left, right)
    // Round toward negative infinity when a nonzero remainder's sign differs
    // from the divisor's: the quotient steps down, the remainder up by it.
    inexact :: lower_numeric_compare(&f, LIRCondition.Ne, remainder, zero)
    signs :: lower_numeric_binary(&f, LIRBinaryOp.Xor, remainder, right)
    opposite :: lower_numeric_compare(&f, LIRCondition.Lt, signs, zero)
    floored :: lower_flag(&f)
    lower_logic(&f, floored, true, inexact, opposite)
    lower_seal(&f, LIRTerminator.Branch{condition: floored, then_target: lower_target(adjust, [LIRValueID]{}), else_target: lower_target(merge, [LIRValueID]{truncated})})
    lower_start(&f, adjust, [LIRValueID]{})
    one :: lower_const(&f, 1)
    adjusted :: if modulo -> lower_numeric_binary(&f, LIRBinaryOp.Add, remainder, right) else -> lower_numeric_binary(&f, LIRBinaryOp.Sub, truncated, one)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{adjusted})})
    lower_start(&f, merge, [LIRValueID]{dst})
}

// A binary operator dispatched to its Prelude route: exact Int `+ - *` have an
// inline fast path; every other route is called with the operands (and the
// source location when the row takes one).
fn lower_binary_route(p: MIRProgram, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, op: MIRBinaryOp, exact: Bool, call: MIRPreludeCallID, location: MIRPanicLoc?, left_value: LIRValueID, right_value: LIRValueID) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "binary operator names missing Prelude call {call.value}")
    symbol :: lower_runtime_symbol(row)
    if exact && row.signature.arity == 2 {
        if op == {
            .Add -> return lower_exact_arithmetic(&m, &f, dst, LIRBinaryOp.Add, left_value, right_value, symbol)
            .Sub -> return lower_exact_arithmetic(&m, &f, dst, LIRBinaryOp.Sub, left_value, right_value, symbol)
            .Mul -> return lower_exact_arithmetic(&m, &f, dst, LIRBinaryOp.Mul, left_value, right_value, symbol)
            else -> {}
        }
    }
    args := [LIRValueID]{left_value, right_value}
    if row.signature.arity == 4 {
        site :: location ?? return lower_fail(&m, &f, "binary Prelude route {symbol} needs a source location")
        loop arg in lower_location(p, &m, &f, site) -> &args.push(arg)
    } else {
        if row.signature.arity != 2 -> return lower_fail(&m, &f, "binary Prelude route {symbol} has arity {row.signature.arity}")
    }
    lower_call_runtime(&m, &f, symbol, args, Val(dst))
}

// Duration's canonical add/sub kernels (Duration.rs179–190; historical Jet
// kernel_duration.add/sub) use saturated I64 nanoseconds. Only marshaling is
// emitted here: arithmetic and construction remain shared runtime calls. A
// native Duration is its runtime handle; the C routes carry its ns exact-Int
// word (CAbiRoutes `Duration { ns: native(word) }`), read with the record
// getter and rebuilt with the record constructor.
fn lower_duration_word(m: &LowerModule, f: &LowerFunction, handle: LIRValueID) -> LIRValueID Never! {
    exact :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    lower_call_runtime(&m, &f, "jet_rt_record_get_duration_ns", [LIRValueID]{handle}, Val(exact))
    exact
}

fn lower_duration_nanoseconds(m: &LowerModule, f: &LowerFunction, handle: LIRValueID) -> LIRValueID Never! {
    exact :: lower_duration_word(&m, &f, handle)
    raw :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_int_owned_to_i64", [LIRValueID]{exact}, Val(raw))
    lower_emit(&f, LIRInst.Drop{value: exact})
    raw
}

fn lower_duration_binary(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, op: MIRBinaryOp, left_ty: MIRType, right: MIRValueID, left: LIRValueID, right_value: LIRValueID, dst: LIRValueID) -> Bool Never! {
    duration :: LowerRouteCarrier.Handle{name: "Duration"}
    if !lower_route_carrier_matches(p, left_ty, duration) -> return false
    right_ty :: lower_value_type(c, right) ?? return true
    paired :: lower_route_carrier_matches(p, right_ty, duration)
    if !paired || (op != .Add && op != .Sub && lower_condition_of(op) == None) -> return false
    if lower_runtime_route("jet_rt_int_drop") == None {
        lower_fail(&m, &f, "Duration arithmetic requires the canonical exact-Int lifetime runtime ABI")
        return true
    }
    borrowed := [LIRValueID]{}
    left_handle := left
    right_handle := right_value
    if lower_record_handle(p, left_ty) != None {
        left_handle = lower_record_to_runtime(p, &m, &f, left_ty, "Duration", left)
        &borrowed.push(left_handle)
    }
    if lower_record_handle(p, right_ty) != None {
        right_handle = lower_record_to_runtime(p, &m, &f, right_ty, "Duration", right_value)
        &borrowed.push(right_handle)
    }
    if lower_condition_of(op) == .Val(condition) {
        compare_left :: lower_duration_nanoseconds(&m, &f, left_handle)
        compare_right :: lower_duration_nanoseconds(&m, &f, right_handle)
        lower_emit(&f, LIRInst.Compare{dst: dst, condition: condition, left: compare_left, right: compare_right})
    } else {
        result_ty :: lower_checked_type(c, instruction) ?? return true
        if !lower_route_carrier_matches(p, result_ty, duration) {
            lower_fail(&m, &f, "Duration arithmetic result does not match its canonical carrier")
            return true
        }
        handle :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_duration"}, None)
        if op == .Sub {
            left_word :: lower_duration_word(&m, &f, left_handle)
            right_word :: lower_duration_word(&m, &f, right_handle)
            difference :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
            lower_call_runtime(&m, &f, "jet_duration_difference", [LIRValueID]{left_word, right_word}, Val(difference))
            lower_emit(&f, LIRInst.Drop{value: left_word})
            lower_emit(&f, LIRInst.Drop{value: right_word})
            lower_call_runtime(&m, &f, "jet_rt_record_new_duration", [LIRValueID]{difference}, Val(handle))
            lower_emit(&f, LIRInst.Drop{value: difference})
        } else {
            route :: lower_runtime_route("jet_i64_saturating_add") ?? {
                lower_fail(&m, &f, "Duration addition requires the canonical raw I64 saturated-add runtime ABI")
                return true
            }
            add_left :: lower_duration_nanoseconds(&m, &f, left_handle)
            add_right :: lower_duration_nanoseconds(&m, &f, right_handle)
            sum :: lower_word(&f)
            lower_call_runtime(&m, &f, route.export, [LIRValueID]{add_left, add_right}, Val(sum))
            exact :: lower_new_value(&f, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
            lower_call_runtime(&m, &f, "jet_int_owned_from_i64", [LIRValueID]{sum}, Val(exact))
            // Every I64 nanosecond value is a Duration; the constructor
            // borrows the ns word.
            lower_call_runtime(&m, &f, "jet_rt_record_new_duration", [LIRValueID]{exact}, Val(handle))
            lower_emit(&f, LIRInst.Drop{value: exact})
        }
        if lower_record_handle(p, result_ty) != None {
            lower_record_from_runtime(p, &m, &f, result_ty, handle, Val(dst))
        } else {
            lower_emit(&f, LIRInst.Move{dst: dst, src: handle})
        }
    }
    loop temporary in borrowed -> lower_emit(&f, LIRInst.Drop{value: temporary})
    true
}

fn lower_numeric_compare(f: &LowerFunction, condition: LIRCondition, left: LIRValueID, right: LIRValueID) -> LIRValueID Never! {
    dst :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: dst, condition: condition, left: left, right: right})
    dst
}

fn lower_numeric_binary(f: &LowerFunction, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> LIRValueID Never! {
    dst :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: dst, op: op, left: left, right: right})
    dst
}

fn lower_numeric_choose(f: &LowerFunction, condition: LIRValueID, yes: LIRValueID, no: LIRValueID) -> LIRValueID Never! {
    dst :: lower_word(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: condition, then_target: lower_target(merge, [LIRValueID]{yes}), else_target: lower_target(merge, [LIRValueID]{no})})
    lower_start(&f, merge, [LIRValueID]{dst})
    dst
}

// MIRRust.rs:instruction_location (:6016-6032): source_line wins, otherwise
// locate the span's byte offset. Index each source once for the whole module.
fn lower_source_line(p: MIRProgram, m: &LowerModule, file: MIRSourceFileID, offset: Int) -> Int Never! {
    if m.line_starts.get(file.value) == None {
        starts := [Int]{0}
        if m.source_rows.get(file.value) == .Val(row) {
            position := 0
            loop byte in p.source_files[row].source.bytes() {
                position += 1
                if byte == (U8{10}) -> &starts.push(position)
            }
        }
        &m.line_starts.add(file.value, starts).drop("checked absent above")
    }
    starts :: m.line_starts.get(file.value) ?? return 1
    lo := 0
    hi := starts.len()
    loop lo + 1 < hi {
        mid :: lo + (hi - lo) /% 2
        if starts[mid] <= offset -> lo = mid
        else -> hi = mid
    }
    lo + 1
}

fn lower_numeric_location(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, location: MIRPanicLoc?) -> [LIRValueID] Never! {
    loc :: location ?? MIRPanicLoc{file: c.mir.source_file, line: instruction.source_line ?? lower_source_line(p, &m, c.mir.source_file, instruction.span.start), column: 0}
    lower_location(p, &m, &f, loc)
}

// The same branch-and-stop as lower_check, with the source location retained.
// Core.rs:jet_arithmetic_stop and RuntimeDiagnosticCore.rs:jet_write_runtime_stop.
fn lower_numeric_check(p: MIRProgram, c: LowerContext?, m: &LowerModule, f: &LowerFunction, failed: LIRValueID, location: [LIRValueID], message: String) Never! {
    stop :: lower_new_block(&f)
    next_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    text :: lower_static_text(&m, &f, message)
    lower_call_runtime(&m, &f, "jet_rt_numeric_stop", [LIRValueID]{location[0], location[1], location[2], text[0], text[1]}, None)
    lower_numeric_stopped(p, c, &m, &f)
    lower_start(&f, next_block, [LIRValueID]{})
}

// The enclosing Propagate edge is the one checked stop contract. Numeric
// failure branches enter it directly, before any payload can be consumed.
// Propagation cleanup has no Poll: cd28da09a's rt_task_panic_publish aborts
// on a nonzero delivered status, so its returning continuation is unreachable.
fn lower_numeric_stopped(p: MIRProgram, context: LowerContext?, m: &LowerModule, f: &LowerFunction) Never! {
    c :: context ?? {
        // Generated numeric helpers return an unwritten word; their caller
        // checks delivered status before using it, just like runtime helpers.
        layout :: m.signatures[f.builder.signature.value].result ?? return lower_seal(&f, LIRTerminator.Return{value: None})
        zero :: lower_new_value(&f, layout, LIRDrop.Trivial, None)
        lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
        return lower_seal(&f, LIRTerminator.Return{value: Val(zero)})
    }
    position :: c.block_index.get(f.mir_block.value) ?? return lower_seal(&f, LIRTerminator.Unreachable)
    block :: c.mir.blocks[position]
    if block.terminator == .Poll(kind, _, stop) {
        if kind == .Propagate && block.instructions.len() > 0 {
            last :: block.instructions[block.instructions.len() - 1]
            if lower_operation_can_stop(p, c, m, last.operation) {
                edge :: lower_edge(p, c, &m, &f, stop) ?? return
                return lower_seal(&f, LIRTerminator.Jump{target: edge})
            }
        }
    }
    lower_seal(&f, LIRTerminator.Unreachable)
}

// A helper that publishes internally can return an unwritten carrier. Check
// its delivered status on the slow path, before merging or reading the carrier.
fn lower_numeric_propagate(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    status :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_session_propagate", [LIRValueID]{}, Val(status))
    zero :: lower_const(&f, 0)
    stopped :: lower_numeric_compare(&f, LIRCondition.Ne, status, zero)
    stop :: lower_new_block(&f)
    resume :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: stopped, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(resume, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    lower_numeric_stopped(p, Val(c), &m, &f)
    lower_start(&f, resume, [LIRValueID]{})
}

// FixedArithmetic.rs::ShiftOutOfRange owns the dynamic count/type wording;
// the runtime formats it, and this branch never resumes a failed shift.
fn lower_numeric_shift_check(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, failed: LIRValueID, op: LIRBinaryOp, count: LIRValueID, unsigned: Bool, bits: Int, location: [LIRValueID]) Never! {
    stop :: lower_new_block(&f)
    resume :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(resume, [LIRValueID]{})})
    lower_start(&f, stop, [LIRValueID]{})
    direction :: lower_const(&f, if op == .Shl -> 0 else -> 1)
    signedness :: lower_const(&f, if unsigned -> 1 else -> 0)
    width :: lower_const(&f, bits)
    lower_call_runtime(&m, &f, "jet_rt_fixed_shift_stop", [LIRValueID]{direction, count, signedness, width, location[0], location[1], location[2]}, None)
    lower_numeric_stopped(p, Val(c), &m, &f)
    lower_start(&f, resume, [LIRValueID]{})
}

fn lower_numeric_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "numeric predicate without a Prelude row is not lowered at O0 yet")
    ty :: lower_value_type(c, receiver) ?? return lower_fail(&m, &f, "numeric predicate without a checked receiver type is not lowered at O0 yet")
    symbol :: mir_symbol_name(row.symbol)
    supported :: (row.member == "is_nan" && symbol == "jet_std_math_is_nan") || (row.member == "is_infinite" && symbol == "jet_std_math_is_infinite") || (row.member == "is_finite" && symbol == "jet_std_math_is_finite")
    if !supported || ty.kind != .Float || row.module_name != "core.math" || row.abi != .Value || row.signature.arity != 1 -> return lower_fail(&m, &f, "this numeric predicate is not lowered at O0 yet")
    result_ty :: instruction.ty ?? return lower_fail(&m, &f, "numeric predicate without a checked result type is not lowered at O0 yet")
    if result_ty.kind != .Bool -> return lower_fail(&m, &f, "this numeric predicate result is not lowered at O0 yet")
    value :: lower_use(&m, &f, receiver) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if row.member == "is_nan" -> return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Ne, left: value, right: value})
    // Subtraction is NaN precisely for infinities and NaNs; both signed zeros
    // and every finite value subtract themselves to zero.
    difference :: lower_new_value(&f, lir_layout_float(), LIRDrop.Trivial, None)
    lower_emit(&f, LIRInst.Binary{dst: difference, op: LIRBinaryOp.Sub, left: value, right: value})
    if row.member == "is_finite" -> return lower_emit(&f, LIRInst.Compare{dst: dst, condition: LIRCondition.Eq, left: difference, right: difference})
    not_finite :: lower_numeric_compare(&f, LIRCondition.Ne, difference, difference)
    not_nan :: lower_numeric_compare(&f, LIRCondition.Eq, value, value)
    lower_logic(&f, dst, true, not_finite, not_nan)
}

fn lower_numeric_euclid(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, receiver: MIRValueID, argument: MIRValueID) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "Euclidean arithmetic without a Prelude row is not lowered at O0 yet")
    remainder :: row.member == "rem_euclid"
    symbol :: if remainder -> "jet_int_rem_euclid" else -> "jet_int_div_euclid"
    left_ty :: lower_value_type(c, receiver) ?? return lower_fail(&m, &f, "Euclidean arithmetic without a receiver type is not lowered at O0 yet")
    right_ty :: lower_value_type(c, argument) ?? return lower_fail(&m, &f, "Euclidean arithmetic without an argument type is not lowered at O0 yet")
    result_ty :: instruction.ty ?? return lower_fail(&m, &f, "Euclidean arithmetic without a result type is not lowered at O0 yet")
    if (!remainder && row.member != "div_euclid") || mir_symbol_name(row.symbol) != "jet_std::{symbol}" || row.module_name != "core.numeric" || row.abi != .Value || row.signature.arity != 2 || !lower_is_exact_int(left_ty) || !lower_is_exact_int(right_ty) || !lower_is_exact_int(result_ty) -> return lower_fail(&m, &f, "this Euclidean arithmetic shape is not lowered at O0 yet")
    left :: lower_use(&m, &f, receiver) ?? return
    right :: lower_use(&m, &f, argument) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    location :: lower_numeric_location(p, c, &m, &f, instruction, None)
    fast_block :: lower_new_block(&f)
    slow_block :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    inline :: lower_inline_test(&f, [LIRValueID]{left, right})
    lower_seal(&f, LIRTerminator.Branch{condition: inline, then_target: lower_target(fast_block, [LIRValueID]{}), else_target: lower_target(slow_block, [LIRValueID]{})})
    lower_start(&f, fast_block, [LIRValueID]{})
    zero :: lower_const(&f, 0)
    is_zero :: lower_numeric_compare(&f, LIRCondition.Eq, right, zero)
    lower_numeric_check(p, Val(c), &m, &f, is_zero, location, "divided by zero")
    rest :: lower_numeric_binary(&f, LIRBinaryOp.Rem, left, right)
    initial :: if remainder -> rest else -> lower_numeric_binary(&f, LIRBinaryOp.Div, left, right)
    negative :: lower_numeric_compare(&f, LIRCondition.Lt, rest, zero)
    adjust :: lower_new_block(&f)
    positive :: lower_new_block(&f)
    negative_divisor :: lower_new_block(&f)
    adjusted :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: negative, then_target: lower_target(adjust, [LIRValueID]{}), else_target: lower_target(adjusted, [LIRValueID]{initial})})
    lower_start(&f, adjust, [LIRValueID]{})
    positive_divisor :: lower_numeric_compare(&f, LIRCondition.Gt, right, zero)
    step :: if remainder -> right else -> lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Branch{condition: positive_divisor, then_target: lower_target(positive, [LIRValueID]{}), else_target: lower_target(negative_divisor, [LIRValueID]{})})
    lower_start(&f, positive, [LIRValueID]{})
    positive_value :: lower_numeric_binary(&f, if remainder -> LIRBinaryOp.Add else -> LIRBinaryOp.Sub, initial, step)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(adjusted, [LIRValueID]{positive_value})})
    lower_start(&f, negative_divisor, [LIRValueID]{})
    negative_value :: lower_numeric_binary(&f, if remainder -> LIRBinaryOp.Sub else -> LIRBinaryOp.Add, initial, step)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(adjusted, [LIRValueID]{negative_value})})
    fast :: lower_word(&f)
    lower_start(&f, adjusted, [LIRValueID]{fast})
    fits :: lower_inline_test(&f, [LIRValueID]{fast})
    lower_seal(&f, LIRTerminator.Branch{condition: fits, then_target: lower_target(merge, [LIRValueID]{fast}), else_target: lower_target(slow_block, [LIRValueID]{})})
    lower_start(&f, slow_block, [LIRValueID]{})
    slow :: lower_word(&f)
    lower_call_runtime(&m, &f, symbol, [LIRValueID]{left, right, location[0], location[1], location[2]}, Val(slow))
    lower_numeric_propagate(p, c, &m, &f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{slow})})
    lower_start(&f, merge, [LIRValueID]{dst})
}

fn lower_numeric_overflow_message(operation: String) -> String Never! {
    if operation == {
        "add" -> "This addition overflows the value's type (the result is outside its range)"
        "sub" -> "This subtraction overflows the value's type (the result is outside its range)"
        "mul" -> "This multiplication overflows the value's type (the result is outside its range)"
        "div" -> "This division overflows the value's type (the result is outside its range)"
        else -> "This power overflows the value's type (the result is outside its range)"
    }
}

fn lower_numeric_absent(f: &LowerFunction, block: LIRBlockID, dst: LIRValueID, merge: LIRBlockID) Never! {
    lower_start(&f, block, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{null})})
}

fn lower_numeric_finish(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: LIRValueID, checked: Bool, absent: LIRBlockID, merge: LIRBlockID) Never! {
    if !checked -> return lower_emit(&f, LIRInst.Copy{dst: dst, src: value})
    box :: lower_pointer(&f)
    lower_alloc(&m, &f, box, 8)
    lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: value})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{box})})
    lower_numeric_absent(&f, absent, dst, merge)
    lower_start(&f, merge, [LIRValueID]{dst})
}

fn lower_numeric_guard(f: &LowerFunction, failed: LIRValueID, absent: LIRBlockID) Never! {
    success :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(absent, [LIRValueID]{}), else_target: lower_target(success, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
}

fn lower_numeric_product(p: MIRProgram, c: LowerContext?, m: &LowerModule, f: &LowerFunction, op: LIRBinaryOp, operation: String, mode: String, unsigned: Bool, left: LIRValueID, right: LIRValueID, absent: LIRBlockID, location: [LIRValueID]) -> LIRValueID Never! {
    value :: lower_numeric_binary(&f, op, left, right)
    if mode == "wrapping" -> return value
    overflowed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Overflows{dst: overflowed, op: if unsigned -> lower_unsigned_overflow_op(op) else -> op, left: left, right: right})
    if mode == "checked" {
        lower_numeric_guard(&f, overflowed, absent)
        return value
    }
    if mode == "checked_policy" {
        lower_numeric_check(p, c, &m, &f, overflowed, location, lower_numeric_overflow_message(operation))
        return value
    }
    if unsigned {
        bound :: lower_const(&f, if op == .Sub -> 0 else -> -1)
        return lower_numeric_choose(&f, overflowed, bound, value)
    }
    zero :: lower_const(&f, 0)
    negative := lower_numeric_compare(&f, LIRCondition.Lt, left, zero)
    if op == .Mul {
        right_negative :: lower_numeric_compare(&f, LIRCondition.Lt, right, zero)
        sign :: lower_word(&f)
        // Bool operands cannot be fed to LIR word operations.
        one :: lower_const(&f, 1)
        negative_word :: lower_numeric_choose(&f, negative, one, zero)
        right_word :: lower_numeric_choose(&f, right_negative, one, zero)
        lower_emit(&f, LIRInst.Binary{dst: sign, op: LIRBinaryOp.Xor, left: negative_word, right: right_word})
        negative = lower_numeric_compare(&f, LIRCondition.Ne, sign, zero)
    }
    minimum :: lower_const(&f, -9223372036854775808)
    maximum :: lower_const(&f, 9223372036854775807)
    limit :: lower_numeric_choose(&f, negative, minimum, maximum)
    lower_numeric_choose(&f, overflowed, limit, value)
}

fn lower_numeric_overflow(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, left: MIRValueID, right: MIRValueID, location: MIRPanicLoc?) Never! {
    row :: lower_prelude_row(p, call) ?? return lower_fail(&m, &f, "overflow policy without a Prelude row is not lowered at O0 yet")
    ty :: lower_value_type(c, left) ?? return lower_fail(&m, &f, "overflow policy without a receiver type is not lowered at O0 yet")
    unsigned :: lower_is_unsigned_word(ty)
    if lower_narrow_bits(ty) > 0 -> return lower_narrow_overflow(p, c, &m, &f, instruction, row, ty, left, right, location)
    if ty.kind != (MIRTypeKind.IntN{signed: !unsigned, bits: 64}) -> return lower_fail(&m, &f, "overflow policies on {mir_type_display_name(ty)} are not lowered at O0 yet")
    right_ty :: lower_value_type(c, right) ?? return lower_fail(&m, &f, "overflow policy without an argument type is not lowered at O0 yet")
    parts :: row.member.split(".").to_list()
    if parts.len() != 3 || row.module_name != "core.numeric" || row.abi != .Value -> return lower_fail(&m, &f, "this overflow policy route is not lowered at O0 yet")
    width :: if unsigned -> "u64" else -> "i64"
    mode :: parts[1]
    operation :: parts[2]
    checked :: mode == "checked"
    rotate :: (mode == "rotate_left" || mode == "rotate_right") && operation == "rotate"
    supported :: ((mode == "checked" || mode == "checked_policy") && (operation == "add" || operation == "sub" || operation == "mul" || operation == "div" || operation == "rem" || operation == "pow")) || ((mode == "wrapping" || mode == "saturating") && (operation == "add" || operation == "sub" || operation == "mul" || operation == "div" || operation == "pow")) || rotate
    arity :: if checked || ((mode == "wrapping" || mode == "saturating") && (operation == "add" || operation == "sub" || operation == "mul")) -> 2 else -> 4
    runtime_mode :: if mode == "checked_policy" -> "trap" else -> mode
    symbol :: if rotate -> "jet_{width}_{mode}" else -> "jet_{width}_{runtime_mode}_{operation}"
    if !supported || parts[0] != width || right_ty.kind != ty.kind || mir_symbol_name(row.symbol) != symbol || row.signature.arity != arity || (arity == 4 && location == None) || (arity == 2 && location != None) -> return lower_fail(&m, &f, "this overflow policy signature is not lowered at O0 yet")
    result_ty :: instruction.ty ?? return lower_fail(&m, &f, "overflow policy without a result type is not lowered at O0 yet")
    if checked {
        if result_ty.kind != (MIRTypeKind.Option{inner: ty}) -> return lower_fail(&m, &f, "this checked overflow result type is not lowered at O0 yet")
    } else if result_ty.kind != ty.kind -> return lower_fail(&m, &f, "this overflow result type is not lowered at O0 yet")
    a :: lower_use(&m, &f, left) ?? return
    b :: lower_use(&m, &f, right) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    loc :: if arity == 4 && (!rotate || !unsigned) -> lower_numeric_location(p, c, &m, &f, instruction, location) else -> [LIRValueID]{}
    if operation == "pow" {
        args := [LIRValueID]{a, b}
        if !checked { loop value in loc -> &args.push(value) }
        return lower_call_helper(&m, &f, "numeric.pow.{mode}", ty, args, Val(dst))
    }
    absent :: if checked -> lower_new_block(&f) else -> LIRBlockID{value: -1}
    merge :: if checked -> lower_new_block(&f) else -> LIRBlockID{value: -1}
    value := a
    if rotate {
        zero :: lower_const(&f, 0)
        if !unsigned {
            negative :: lower_numeric_compare(&f, LIRCondition.Lt, b, zero)
            lower_numeric_check(p, Val(c), &m, &f, negative, loc, "A rotation count cannot be negative")
        }
        mask :: lower_const(&f, 63)
        count :: lower_numeric_binary(&f, LIRBinaryOp.And, b, mask)
        word_bits :: lower_const(&f, 64)
        reverse :: lower_numeric_binary(&f, LIRBinaryOp.Sub, word_bits, count)
        l :: lower_numeric_binary(&f, if mode == "rotate_left" -> LIRBinaryOp.Shl else -> LIRBinaryOp.UShr, a, count)
        r :: lower_numeric_binary(&f, if mode == "rotate_left" -> LIRBinaryOp.UShr else -> LIRBinaryOp.Shl, a, reverse)
        rotated :: lower_numeric_binary(&f, LIRBinaryOp.Or, l, r)
        // Machine shifts mask 64 to 0, so count zero returns a | a = a.
        value = rotated
    } else if operation == "add" || operation == "sub" || operation == "mul" {
        op :: if operation == "add" -> LIRBinaryOp.Add else if operation == "sub" -> LIRBinaryOp.Sub else -> LIRBinaryOp.Mul
        value = lower_numeric_product(p, Val(c), &m, &f, op, operation, mode, unsigned, a, b, absent, loc)
    } else {
        zero :: lower_const(&f, 0)
        is_zero :: lower_numeric_compare(&f, LIRCondition.Eq, b, zero)
        if checked -> lower_numeric_guard(&f, is_zero, absent)
        else -> lower_numeric_check(p, Val(c), &m, &f, is_zero, loc, "divided by zero")
        ordinary :: lower_new_block(&f)
        special :: lower_new_block(&f)
        joined :: lower_new_block(&f)
        is_special := lower_const_flag(&f, 0)
        if !unsigned {
            minimum_word :: lower_const(&f, -9223372036854775808)
            minimum :: lower_numeric_compare(&f, LIRCondition.Eq, a, minimum_word)
            minus_one_word :: lower_const(&f, -1)
            minus_one :: lower_numeric_compare(&f, LIRCondition.Eq, b, minus_one_word)
            is_special = lower_flag(&f)
            lower_logic(&f, is_special, true, minimum, minus_one)
        }
        // FixedArithmetic.rs widens to i128: rem(MIN,-1) is Some(0),
        // including checked_rem; division's +2^63 is still out of I64 range.
        if operation == "div" && checked -> lower_numeric_guard(&f, is_special, absent)
        if operation == "div" && mode == "checked_policy" -> lower_numeric_check(p, Val(c), &m, &f, is_special, loc, lower_numeric_overflow_message("div"))
        lower_seal(&f, LIRTerminator.Branch{condition: is_special, then_target: lower_target(special, [LIRValueID]{}), else_target: lower_target(ordinary, [LIRValueID]{})})
        lower_start(&f, special, [LIRValueID]{})
        special_value :: lower_const(&f, if operation == "rem" -> 0 else if mode == "saturating" -> 9223372036854775807 else -> -9223372036854775808)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(joined, [LIRValueID]{special_value})})
        lower_start(&f, ordinary, [LIRValueID]{})
        quotient :: lower_numeric_binary(&f, if operation == "rem" -> if unsigned -> LIRBinaryOp.URem else -> LIRBinaryOp.Rem else -> if unsigned -> LIRBinaryOp.UDiv else -> LIRBinaryOp.Div, a, b)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(joined, [LIRValueID]{quotient})})
        value = lower_word(&f)
        lower_start(&f, joined, [LIRValueID]{value})
    }
    lower_numeric_finish(&m, &f, dst, value, checked, absent, merge)
}

// Narrow (< 64-bit) `+ - *` policies (FixedArithmetic.rs on the narrow Rust
// type): canonical narrow operands make the product exact in the word, so the
// policy tests the type's range. An unsigned word outside it reads above the
// maximum under an unsigned compare (a negative difference included).
fn lower_narrow_overflow(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, ty: MIRType, left: MIRValueID, right: MIRValueID, location: MIRPanicLoc?) Never! {
    signed :: lower_narrow_signed(ty)
    bits :: lower_narrow_bits(ty)
    width :: if signed -> "i{bits}" else -> "u{bits}"
    right_ty :: lower_value_type(c, right) ?? return lower_fail(&m, &f, "overflow policy without an argument type is not lowered at O0 yet")
    parts :: row.member.split(".").to_list()
    if parts.len() != 3 || row.module_name != "core.numeric" || row.abi != .Value -> return lower_fail(&m, &f, "this overflow policy route is not lowered at O0 yet")
    mode :: parts[1]
    operation :: parts[2]
    checked :: mode == "checked"
    if (mode == "rotate_left" || mode == "rotate_right") && operation == "rotate" -> return lower_narrow_rotate(p, c, &m, &f, instruction, row, ty, left, right, location, mode)
    if !(mode == "checked" || mode == "checked_policy" || mode == "wrapping" || mode == "saturating") || !(operation == "add" || operation == "sub" || operation == "mul") -> return lower_fail(&m, &f, "{width} overflow policy {mode} {operation} is not lowered at O0 yet")
    arity :: if mode == "checked_policy" -> 4 else -> 2
    runtime_mode :: if mode == "checked_policy" -> "trap" else -> mode
    if parts[0] != width || right_ty.kind != ty.kind || mir_symbol_name(row.symbol) != "jet_{width}_{runtime_mode}_{operation}" || row.signature.arity != arity || (arity == 4 && location == None) || (arity == 2 && location != None) -> return lower_fail(&m, &f, "this overflow policy signature is not lowered at O0 yet")
    result_ty :: instruction.ty ?? return lower_fail(&m, &f, "overflow policy without a result type is not lowered at O0 yet")
    if checked {
        if result_ty.kind != (MIRTypeKind.Option{inner: ty}) -> return lower_fail(&m, &f, "this checked overflow result type is not lowered at O0 yet")
    } else if result_ty.kind != ty.kind -> return lower_fail(&m, &f, "this overflow result type is not lowered at O0 yet")
    a :: lower_use(&m, &f, left) ?? return
    b :: lower_use(&m, &f, right) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    loc :: if arity == 4 -> lower_numeric_location(p, c, &m, &f, instruction, location) else -> [LIRValueID]{}
    absent :: if checked -> lower_new_block(&f) else -> LIRBlockID{value: -1}
    merge :: if checked -> lower_new_block(&f) else -> LIRBlockID{value: -1}
    op :: if operation == "add" -> LIRBinaryOp.Add else if operation == "sub" -> LIRBinaryOp.Sub else -> LIRBinaryOp.Mul
    exact :: lower_numeric_binary(&f, op, a, b)
    maximum :: lower_const(&f, lower_narrow_max(signed, bits))
    minimum :: lower_const(&f, if signed -> -1 - lower_narrow_max(signed, bits) else -> 0)
    above :: lower_numeric_compare(&f, if signed -> LIRCondition.Gt else -> LIRCondition.UGt, exact, maximum)
    out := above
    below := above
    if signed {
        below = lower_numeric_compare(&f, LIRCondition.Lt, exact, minimum)
        out = lower_flag(&f)
        lower_logic(&f, out, false, above, below)
    }
    value := exact
    if mode == "wrapping" {
        value = lower_word(&f)
        lower_narrow_wrap(&f, value, exact, signed, bits)
    } else if mode == "checked" {
        lower_numeric_guard(&f, out, absent)
    } else if mode == "checked_policy" {
        lower_numeric_check(p, Val(c), &m, &f, out, loc, lower_numeric_overflow_message(operation))
    } else if signed {
        clamped :: lower_numeric_choose(&f, below, minimum, exact)
        value = lower_numeric_choose(&f, above, maximum, clamped)
    } else {
        bound :: if op == .Sub -> minimum else -> maximum
        value = lower_numeric_choose(&f, above, bound, exact)
    }
    lower_numeric_finish(&m, &f, dst, value, checked, absent, merge)
}

// Narrow unsigned rotation (FixedArithmetic.rs jet_u{N}_rotate_*: the
// count modulo N, as the 64-bit path masks with 63). The canonical narrow word
// holds only N bits, so the two shifted halves are or-ed and cut back to N bits.
fn lower_narrow_rotate(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, row: MIRPreludeCall, ty: MIRType, left: MIRValueID, right: MIRValueID, location: MIRPanicLoc?, mode: String) Never! {
    bits :: lower_narrow_bits(ty)
    unsupported :: "{mir_type_display_name(ty)} overflow policy {mode} rotate is not lowered at O0 yet"
    if lower_narrow_signed(ty) || (bits != 8 && bits != 16 && bits != 32) -> return lower_fail(&m, &f, unsupported)
    right_ty :: lower_value_type(c, right) ?? return lower_fail(&m, &f, unsupported)
    result_ty :: instruction.ty ?? return lower_fail(&m, &f, unsupported)
    arity :: row.signature.arity
    if right_ty.kind != ty.kind || result_ty.kind != ty.kind || mir_symbol_name(row.symbol) != "jet_u{bits}_{mode}" || (arity != 2 && arity != 4) || (arity == 4 && location == None) || (arity == 2 && location != None) -> return lower_fail(&m, &f, unsupported)
    a :: lower_use(&m, &f, left) ?? return
    b :: lower_use(&m, &f, right) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    count_mask :: lower_const(&f, bits - 1)
    count :: lower_numeric_binary(&f, LIRBinaryOp.And, b, count_mask)
    width_word :: lower_const(&f, bits)
    reverse :: lower_numeric_binary(&f, LIRBinaryOp.Sub, width_word, count)
    first :: lower_numeric_binary(&f, if mode == "rotate_left" -> LIRBinaryOp.Shl else -> LIRBinaryOp.UShr, a, count)
    second :: lower_numeric_binary(&f, if mode == "rotate_left" -> LIRBinaryOp.UShr else -> LIRBinaryOp.Shl, a, reverse)
    joined :: lower_numeric_binary(&f, LIRBinaryOp.Or, first, second)
    // A count of 0 shifts the other half by N, below the word's 64: it is 0.
    value_mask :: lower_const(&f, (1 << bits) - 1)
    lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.And, left: joined, right: value_mask})
}

// Exponentiation by squaring, with policy applied to each needed product.
// FixedArithmetic.rs:power, wrapping_pow, saturating_pow. Checked/trap products
// cannot have a later fitting result unless the unneeded final square is skipped.
fn lower_helper_numeric_pow(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    mode :: if glue.helper == {
        "numeric.pow.checked" -> "checked"
        "numeric.pow.wrapping" -> "wrapping"
        "numeric.pow.saturating" -> "saturating"
        else -> "checked_policy"
    }
    checked :: mode == "checked"
    unsigned :: lower_is_unsigned_word(glue.ty)
    layouts := [LIRLayout]{lir_layout_word(), lir_layout_word()}
    if !checked {
        &layouts.push(lir_layout_pointer())
        &layouts.push(lir_layout_word())
        &layouts.push(lir_layout_word())
    }
    f := lower_helper_start(&m, glue, layouts, Val(if checked -> lir_layout_pointer() else -> lir_layout_word()))
    base :: f.open_params[0].copy()
    exponent :: f.open_params[1].copy()
    location := [LIRValueID]{}
    if !checked {
        &location.push(f.open_params[2].copy())
        &location.push(f.open_params[3].copy())
        &location.push(f.open_params[4].copy())
    }
    absent :: if checked -> lower_new_block(&f) else -> LIRBlockID{value: -1}
    done :: lower_new_block(&f)
    top :: lower_new_block(&f)
    multiply :: lower_new_block(&f)
    after_multiply :: lower_new_block(&f)
    square :: lower_new_block(&f)
    zero :: lower_const(&f, 0)
    if !unsigned {
        negative :: lower_numeric_compare(&f, LIRCondition.Lt, exponent, zero)
        if checked -> lower_numeric_guard(&f, negative, absent)
        else -> lower_numeric_check(p, None, &m, &f, negative, location, "A negative exponent has no whole-number result (make the base a Float to raise it to a negative power)")
    }
    exponent_limit :: lower_const(&f, 4294967295)
    too_large :: lower_numeric_compare(&f, LIRCondition.UGt, exponent, exponent_limit)
    if checked -> lower_numeric_guard(&f, too_large, absent)
    else -> lower_numeric_check(p, None, &m, &f, too_large, location, lower_numeric_overflow_message("pow"))
    one :: lower_const(&f, 1)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(top, [LIRValueID]{one, base, exponent})})
    result :: lower_word(&f)
    current :: lower_word(&f)
    count :: lower_word(&f)
    lower_start(&f, top, [LIRValueID]{result, current, count})
    finished :: lower_numeric_compare(&f, LIRCondition.Eq, count, zero)
    body :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: finished, then_target: lower_target(done, [LIRValueID]{result}), else_target: lower_target(body, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    low_bit :: lower_numeric_binary(&f, LIRBinaryOp.And, count, one)
    odd :: lower_numeric_compare(&f, LIRCondition.Ne, low_bit, zero)
    lower_seal(&f, LIRTerminator.Branch{condition: odd, then_target: lower_target(multiply, [LIRValueID]{}), else_target: lower_target(after_multiply, [LIRValueID]{result})})
    lower_start(&f, multiply, [LIRValueID]{})
    product :: lower_numeric_product(p, None, &m, &f, LIRBinaryOp.Mul, "pow", mode, unsigned, result, current, absent, location)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(after_multiply, [LIRValueID]{product})})
    accumulated :: lower_word(&f)
    lower_start(&f, after_multiply, [LIRValueID]{accumulated})
    remaining :: lower_numeric_binary(&f, LIRBinaryOp.UShr, count, one)
    last :: lower_numeric_compare(&f, LIRCondition.Eq, remaining, zero)
    lower_seal(&f, LIRTerminator.Branch{condition: last, then_target: lower_target(done, [LIRValueID]{accumulated}), else_target: lower_target(square, [LIRValueID]{})})
    lower_start(&f, square, [LIRValueID]{})
    squared :: lower_numeric_product(p, None, &m, &f, LIRBinaryOp.Mul, "pow", mode, unsigned, current, current, absent, location)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(top, [LIRValueID]{accumulated, squared, remaining})})
    answer :: lower_word(&f)
    lower_start(&f, done, [LIRValueID]{answer})
    if checked {
        box :: lower_pointer(&f)
        lower_alloc(&m, &f, box, 8)
        lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: answer})
        lower_seal(&f, LIRTerminator.Return{value: Val(box)})
        lower_start(&f, absent, [LIRValueID]{})
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        lower_seal(&f, LIRTerminator.Return{value: Val(null)})
    } else {
        lower_seal(&f, LIRTerminator.Return{value: Val(answer)})
    }
    lir_builder_finish(f.builder)
}

// ---------------------------------------------------------------------------
// Fixed-width integers narrower than 64 bits. A value lives in one word,
// sign-extended (signed) or zero-extended (unsigned), so comparison, Display
// and the bitwise operators need nothing extra. Arithmetic is exact in the
// word for these widths (an unsigned 32-bit product stays below 2^64), so a
// trapping operator checks the word against the type's range afterwards, and
// an unchecked one re-extends its low `bits` (MIRRust.rs emits the native
// Rust operator on the narrow Rust type).

// `bits` of a narrow fixed-width integer type, or 0 for any other type.
fn lower_narrow_bits(ty: MIRType) -> Int Never! {
    if ty.kind == {
        .IntN(_, bits) -> if bits < 64 -> bits else -> 0
        .Tagged(_, inner) -> lower_narrow_bits(inner)
        .InlineRange(base, _, _) -> lower_narrow_bits(base)
        .Quantity(base, _) -> lower_narrow_bits(base)
        else -> 0
    }
}

fn lower_narrow_signed(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .IntN(signed, _) -> signed
        .Tagged(_, inner) -> lower_narrow_signed(inner)
        .InlineRange(base, _, _) -> lower_narrow_signed(base)
        .Quantity(base, _) -> lower_narrow_signed(base)
        else -> false
    }
}

fn lower_narrow_max(signed: Bool, bits: Int) -> Int Never! {
    if signed -> (1 << (bits - 1)) - 1 else -> (1 << bits) - 1
}

// Stop with the overflow report when `value` is outside the type's range. An
// unsigned range test is one unsigned compare: negative words read as huge.
fn lower_narrow_check(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, value: LIRValueID, signed: Bool, bits: Int, location: [LIRValueID], message: String) Never! {
    maximum :: lower_const(&f, lower_narrow_max(signed, bits))
    if !signed -> return lower_narrow_stop_if(p, c, &m, &f, LIRCondition.UGt, value, maximum, location, message)
    lower_narrow_stop_if(p, c, &m, &f, LIRCondition.Gt, value, maximum, location, message)
    minimum :: lower_const(&f, -1 - lower_narrow_max(signed, bits))
    lower_narrow_stop_if(p, c, &m, &f, LIRCondition.Lt, value, minimum, location, message)
}

fn lower_narrow_stop_if(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, condition: LIRCondition, left: LIRValueID, right: LIRValueID, location: [LIRValueID], message: String) Never! {
    failed :: lower_numeric_compare(&f, condition, left, right)
    lower_numeric_check(p, Val(c), &m, &f, failed, location, message)
}

// The low `bits` of `value`, sign- or zero-extended back to the word.
fn lower_narrow_wrap(f: &LowerFunction, dst: LIRValueID, value: LIRValueID, signed: Bool, bits: Int) Never! {
    spare :: lower_const(&f, 64 - bits)
    high :: lower_numeric_binary(&f, LIRBinaryOp.Shl, value, spare)
    lower_emit(&f, LIRInst.Binary{dst: dst, op: if signed -> LIRBinaryOp.Shr else -> LIRBinaryOp.UShr, left: high, right: spare})
}

// A word operator on two canonical narrow operands. Division keeps the 64-bit
// rules of lower_binary (a zero divisor stops, `x % -1` is 0); a shift count
// outside 0..<bits stops, as Rust's checked shift on the narrow type does.
fn lower_narrow_binary(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, op: LIRBinaryOp, overflow: MIRBinaryOverflow, signed: Bool, bits: Int, left: LIRValueID, right: LIRValueID, location: [LIRValueID]) Never! {
    if op == .And || op == .Or || op == .Xor -> return lower_emit(&f, LIRInst.Binary{dst: dst, op: op, left: left, right: right})
    if op == .Shl || op == .Shr {
        if overflow == .Trap {
            width :: lower_const(&f, bits)
            failed :: lower_numeric_compare(&f, LIRCondition.UGe, right, width)
            lower_numeric_shift_check(p, c, &m, &f, failed, op, right, !signed, bits, location)
        }
        if op == .Shr -> return lower_emit(&f, LIRInst.Binary{dst: dst, op: if signed -> LIRBinaryOp.Shr else -> LIRBinaryOp.UShr, left: left, right: right})
        shifted :: lower_numeric_binary(&f, LIRBinaryOp.Shl, left, right)
        return lower_narrow_wrap(&f, dst, shifted, signed, bits)
    }
    if op == .Div || op == .Rem {
        if overflow == .Trap {
            zero :: lower_const(&f, 0)
            lower_narrow_stop_if(p, c, &m, &f, LIRCondition.Eq, right, zero, location, "divided by zero")
        }
        if op == .Rem {
            // A -1 divisor never reaches IDIV here (only MIN / -1 of the
            // word faults, and narrow operands never hold it), and its
            // remainder is 0 like the 64-bit rule.
            return lower_emit(&f, LIRInst.Binary{dst: dst, op: LIRBinaryOp.Rem, left: left, right: right})
        }
        quotient :: lower_numeric_binary(&f, LIRBinaryOp.Div, left, right)
        // Signed MIN / -1 is the one quotient outside the range.
        if signed && overflow == .Trap -> lower_narrow_check(p, c, &m, &f, quotient, signed, bits, location, lower_numeric_overflow_message("div"))
        return lower_emit(&f, LIRInst.Move{dst: dst, src: quotient})
    }
    exact :: lower_numeric_binary(&f, op, left, right)
    if overflow == .Trap {
        operation :: if op == .Add -> "add" else if op == .Sub -> "sub" else -> "mul"
        lower_narrow_check(p, c, &m, &f, exact, signed, bits, location, lower_numeric_overflow_message(operation))
        return lower_emit(&f, LIRInst.Move{dst: dst, src: exact})
    }
    lower_narrow_wrap(&f, dst, exact, signed, bits)
}
