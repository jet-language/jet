// Checked typed-text heads (MIR TypedTextInterp). The text is assembled here
// the way crates/jet-codegen/src/Prelude/TypedText.rs interpolates it: each
// literal as written, each hole shown (JetShow) and encoded by the head's law.
// `HTML{...}` escapes untrusted holes and is the text itself; `Path{...}`
// percent-encodes each hole as one component and builds the value through the
// jet_path_from route (jet_typed_path_literal); `DateTime{...}` parses the
// text through the jet_time_parse_rfc3339 route (jet_typed_datetime_literal).
// SQL, Sh and URL heads are reported: their values are not a String
// interpolation (bound parameters, argv, and URL parts placed after parsing).
use jet_foundation.[MIRInstruction, MIRProgram, MIRType, MIRTypeKind, MIRTypedHeadKind, MIRValueID, mir_type_display_name, mir_type_from_kind]

fn lower_typed_text_kind_name(kind: MIRTypedHeadKind) -> String Never! {
    if kind == {
        .SQL -> "SQL"
        .HTML -> "HTML"
        .Sh -> "Sh"
        .URL -> "URL"
        .Path -> "Path"
        .DateTime -> "DateTime"
    }
}

fn lower_typed_text_interp(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, kind: MIRTypedHeadKind, literals: [String], holes: [MIRValueID], trusted_html: [Bool]) Never! {
    what :: "semantic operation TypedTextInterp {lower_typed_text_kind_name(kind)}"
    if kind == .SQL || kind == .Sh || kind == .URL -> return lower_fail(&m, &f, "{what} is not lowered at O0 yet")
    if literals.len() != holes.len() + 1 || trusted_html.len() != holes.len() -> return lower_fail(&m, &f, "{what} has inconsistent literal, hole and trust counts")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "{what} has no checked result type")
    route_symbol :: if kind == .Path -> "jet_path_from" else -> "jet_time_parse_rfc3339"
    if kind == .HTML {
        if !lower_text_type(result_ty) -> return lower_fail(&m, &f, "{what} result type {mir_type_display_name(result_ty)} is not lowered at O0 yet")
    } else {
        runtime :: if kind == .Path -> "JetPath" else -> "JetDateTime"
        if !lower_route_carrier_matches(p, result_ty, LowerRouteCarrier.Handle{name: runtime}) -> return lower_fail(&m, &f, "{what} result type {mir_type_display_name(result_ty)} does not match its runtime route")
        if lower_runtime_route(route_symbol) == None -> return lower_fail(&m, &f, "{what} has no runtime C-ABI route ({route_symbol})")
    }
    text_ty :: mir_type_from_kind(MIRTypeKind.String)
    builder :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_new", [LIRValueID]{}, Val(builder))
    loop (index, literal) in literals {
        if literal != "" -> lower_render_static(&m, &f, builder, literal)
        if index >= holes.len() -> next
        hole :: holes[index]
        ty :: lower_value_type(c, hole) ?? return lower_fail(&m, &f, "{what} hole {index} has no checked type")
        if kind == .HTML && trusted_html[index] {
            // A trusted hole is checked HTML: its markup goes in unescaped.
            if !lower_text_type(ty) -> return lower_fail(&m, &f, "{what} trusted hole of type {mir_type_display_name(ty)} is not lowered at O0 yet")
            markup :: lower_use(&m, &f, hole) ?? return
            lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, markup}, None)
            next
        }
        operand :: if lower_repr(p, ty) == .Absent -> None else -> lower_use(&m, &f, hole)
        shown :: lower_render_value(p, &m, &f, ty, operand, LowerRenderMode.Show) ?? return
        if kind == {
            .HTML -> lower_call_helper(&m, &f, "text.html_escape", text_ty, [LIRValueID]{builder, shown.value}, None)
            .Path -> lower_call_helper(&m, &f, "text.path_component", text_ty, [LIRValueID]{builder, shown.value}, None)
            else -> lower_call_runtime(&m, &f, "jet_rt_string_builder_push", [LIRValueID]{builder, shown.value}, None)
        }
        if shown.owned -> lower_emit(&f, LIRInst.Drop{value: shown.value})
    }
    if kind == .HTML {
        dst :: lower_result(p, c, &m, &f, instruction)
        if f.failed -> return
        text :: dst ?? lower_render_string(&f)
        lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
        if dst == None -> lower_emit(&f, LIRInst.Drop{value: text})
        return
    }
    text :: lower_render_string(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_finish", [LIRValueID]{builder}, Val(text))
    route :: lower_runtime_route(route_symbol) ?? return
    if kind == .Path {
        // The route borrows the text and returns the Path handle.
        lower_route_result(p, c, &m, &f, instruction, route, [LIRValueID]{text}, what, route_symbol)
        if f.failed -> return
        return lower_emit(&f, LIRInst.Drop{value: text})
    }
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return
    out :: lower_route_tagged_call(&m, &f, route.export, [LIRValueID]{text}, 2)
    lower_emit(&f, LIRInst.Drop{value: text})
    zero :: lower_const(&f, 0)
    parsed :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: parsed, condition: LIRCondition.Ne, left: out.word, right: zero})
    success :: lower_new_block(&f)
    failure :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: parsed, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    // Sema accepted only heads that parse (D-BOUND-HEAD1=A), as
    // jet_typed_datetime_literal's unreachable arm states.
    lower_start(&f, failure, [LIRValueID]{})
    reason :: lower_static_text(&m, &f, "sema accepted an invalid DateTime typed head")
    lower_noreturn_call(&m, &f, "jet_rt_unreachable", reason)
    lower_start(&f, success, [LIRValueID]{})
    if dst == .Val(kept) {
        lower_emit(&f, LIRInst.Load{dst: kept, base: out.slot, offset: 0})
        return
    }
    unused :: lower_new_value(&f, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_handle_drop_JetDateTime"}, None)
    lower_emit(&f, LIRInst.Load{dst: unused, base: out.slot, offset: 0})
    lower_emit(&f, LIRInst.Drop{value: unused})
}

// One byte of `data` at `at`, zero-extended to a word (LIR loads a byte only
// into a one-byte value, which never widens by itself).
fn lower_text_byte(f: &LowerFunction, data: LIRValueID, at: LIRValueID) -> LIRValueID Never! {
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.PointerAdd{dst: address, base: data, offset: at})
    byte :: lower_flag(&f)
    lower_emit(&f, LIRInst.Load{dst: byte, base: address, offset: 0})
    slot :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: slot, size: 8, align: 8})
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: byte})
    word :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: word, base: slot, offset: 0})
    word
}

// Branch to `yes` when `lo <= value <= hi`, else to `no`.
fn lower_text_byte_between(f: &LowerFunction, value: LIRValueID, lo: Int, hi: Int, yes: LIRBlockID, no: LIRBlockID) Never! {
    upper :: lower_new_block(&f)
    low :: lower_const(&f, lo)
    above :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: above, condition: LIRCondition.Ge, left: value, right: low})
    lower_seal(&f, LIRTerminator.Branch{condition: above, then_target: lower_target(upper, [LIRValueID]{}), else_target: lower_target(no, [LIRValueID]{})})
    lower_start(&f, upper, [LIRValueID]{})
    high :: lower_const(&f, hi)
    below :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: below, condition: LIRCondition.Le, left: value, right: high})
    lower_seal(&f, LIRTerminator.Branch{condition: below, then_target: lower_target(yes, [LIRValueID]{}), else_target: lower_target(no, [LIRValueID]{})})
}

// Branch to `yes` when `value == byte`; otherwise continue in a new open block.
fn lower_text_byte_is(f: &LowerFunction, value: LIRValueID, byte: Int, yes: LIRBlockID) Never! {
    other :: lower_new_block(&f)
    expected :: lower_const(&f, byte)
    same :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: value, right: expected})
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(yes, [LIRValueID]{}), else_target: lower_target(other, [LIRValueID]{})})
    lower_start(&f, other, [LIRValueID]{})
}

// "text.html_escape" (builder, String) and "text.path_component" (builder,
// String): push the borrowed text's bytes to the builder, encoded as
// TypedText.rs jet_typed_html_escape (`&<>"'` as entities) or
// encode_path_component (bytes outside ALPHA / DIGIT / `-._~` as uppercase
// %XX; a whole `.` or `..` as %2E escapes, so it is never a traversal).
// The escaped bytes are ASCII, so a byte walk keeps every other UTF-8
// sequence intact.
fn lower_helper_typed_text_escape(m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    html :: glue.helper == "text.html_escape"
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_pointer()}, None)
    builder :: ~f.open_params[0]
    text :: ~f.open_params[1]
    data :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_data", [LIRValueID]{text}, Val(data))
    length :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_byte_len", [LIRValueID]{text}, Val(length))
    zero :: lower_const(&f, 0)
    // Path only: whether the text is exactly `.` or `..` (one or two bytes,
    // first and last a dot).
    dots := lower_const_flag(&f, 0)
    if !html {
        dots_check :: lower_new_block(&f)
        dots_last :: lower_new_block(&f)
        dots_done :: lower_new_block(&f)
        no :: lower_const_flag(&f, 0)
        yes :: lower_const_flag(&f, 1)
        one :: lower_const(&f, 1)
        short_enough :: lower_flag(&f)
        two :: lower_const(&f, 2)
        nonempty :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: nonempty, condition: LIRCondition.Ge, left: length, right: one})
        lower_emit(&f, LIRInst.Compare{dst: short_enough, condition: LIRCondition.Le, left: length, right: two})
        sized :: lower_flag(&f)
        lower_emit(&f, LIRInst.Binary{dst: sized, op: LIRBinaryOp.And, left: nonempty, right: short_enough})
        lower_seal(&f, LIRTerminator.Branch{condition: sized, then_target: lower_target(dots_check, [LIRValueID]{}), else_target: lower_target(dots_done, [LIRValueID]{no})})
        lower_start(&f, dots_check, [LIRValueID]{})
        dot :: lower_const(&f, 46)
        first :: lower_text_byte(&f, data, zero)
        first_dot :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: first_dot, condition: LIRCondition.Eq, left: first, right: dot})
        lower_seal(&f, LIRTerminator.Branch{condition: first_dot, then_target: lower_target(dots_last, [LIRValueID]{}), else_target: lower_target(dots_done, [LIRValueID]{no})})
        lower_start(&f, dots_last, [LIRValueID]{})
        last_at :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: last_at, op: LIRBinaryOp.Sub, left: length, right: one})
        last :: lower_text_byte(&f, data, last_at)
        last_dot :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: last_dot, condition: LIRCondition.Eq, left: last, right: dot})
        lower_seal(&f, LIRTerminator.Branch{condition: last_dot, then_target: lower_target(dots_done, [LIRValueID]{yes}), else_target: lower_target(dots_done, [LIRValueID]{no})})
        joined :: lower_flag(&f)
        lower_start(&f, dots_done, [LIRValueID]{joined})
        dots = joined
    }
    at :: lower_word(&f)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    raw :: lower_new_block(&f)
    step :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    byte :: lower_text_byte(&f, data, at)
    if html {
        codes :: [Int]{38, 60, 62, 34, 39}
        entities :: [String]{"&amp;", "&lt;", "&gt;", "&quot;", "&#39;"}
        targets := [LIRBlockID]{}
        loop code in codes {
            target :: lower_new_block(&f)
            &targets.push(target)
            lower_text_byte_is(&f, byte, code, target)
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(raw, [LIRValueID]{})})
        loop (index, entity) in entities {
            lower_start(&f, targets[index], [LIRValueID]{})
            lower_render_static(&m, &f, builder, entity)
            lower_seal(&f, LIRTerminator.Jump{target: lower_target(step, [LIRValueID]{})})
        }
    } else {
        encode :: lower_new_block(&f)
        dot_block :: lower_new_block(&f)
        upper_check :: lower_new_block(&f)
        lower_check :: lower_new_block(&f)
        lower_text_byte_between(&f, byte, 48, 57, raw, upper_check)
        lower_start(&f, upper_check, [LIRValueID]{})
        lower_text_byte_between(&f, byte, 65, 90, raw, lower_check)
        lower_start(&f, lower_check, [LIRValueID]{})
        marks :: lower_new_block(&f)
        lower_text_byte_between(&f, byte, 97, 122, raw, marks)
        lower_start(&f, marks, [LIRValueID]{})
        lower_text_byte_is(&f, byte, 45, raw)
        lower_text_byte_is(&f, byte, 95, raw)
        lower_text_byte_is(&f, byte, 126, raw)
        lower_text_byte_is(&f, byte, 46, dot_block)
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(encode, [LIRValueID]{})})
        // A dot is unreserved unless the whole text is `.` or `..`.
        lower_start(&f, dot_block, [LIRValueID]{})
        lower_seal(&f, LIRTerminator.Branch{condition: dots, then_target: lower_target(encode, [LIRValueID]{}), else_target: lower_target(raw, [LIRValueID]{})})
        lower_start(&f, encode, [LIRValueID]{})
        lower_render_static(&m, &f, builder, "%")
        hex :: lower_static_text(&m, &f, "0123456789ABCDEF")
        one :: lower_const(&f, 1)
        four :: lower_const(&f, 4)
        fifteen :: lower_const(&f, 15)
        high :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: high, op: LIRBinaryOp.UShr, left: byte, right: four})
        low :: lower_word(&f)
        lower_emit(&f, LIRInst.Binary{dst: low, op: LIRBinaryOp.And, left: byte, right: fifteen})
        nibbles :: [LIRValueID]{high, low}
        loop nibble in nibbles {
            digit :: lower_pointer(&f)
            lower_emit(&f, LIRInst.PointerAdd{dst: digit, base: hex[0], offset: nibble})
            lower_call_runtime(&m, &f, "jet_rt_string_builder_push_static", [LIRValueID]{builder, digit, one}, None)
        }
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(step, [LIRValueID]{})})
    }
    lower_start(&f, raw, [LIRValueID]{})
    source :: lower_pointer(&f)
    lower_emit(&f, LIRInst.PointerAdd{dst: source, base: data, offset: at})
    width :: lower_const(&f, 1)
    lower_call_runtime(&m, &f, "jet_rt_string_builder_push_static", [LIRValueID]{builder, source, width}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(step, [LIRValueID]{})})
    lower_start(&f, step, [LIRValueID]{})
    next_at :: lower_word(&f)
    increment :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: increment})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_at})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}
