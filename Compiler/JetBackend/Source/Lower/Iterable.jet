// User `Iterable` loop sources (D-ITER-HOOK; MIRLoopSourceKind.Iterable).
// LoopCursor.rs runs them as jet_iterable_loop_source: `Iterable.iter`
// consumes the collection once, and the cursor pulls `Iterator.next` one item
// ahead: once at init, then `step` times per advance (the skipped items are
// dropped), until the first None. Natively the IterCursor box holds
// [state, -1, 1, release-id, taken, owned flag]: the -1 index groups it with
// the runtime Iter cursors and the 1 (an Iter cursor's word 2 is 0) marks a
// user source. `state` is one heap box: [current item Option box (null when
// none), step, exhausted flag, the iterator value from offset 24]. The typed
// advance/release helpers (keyed by the iterator type) call the user's
// `next` directly.
use jet_foundation.[
    MIRFunction, MIRInstruction, MIRPanicContext, MIRPanicLocal, MIRPanicLoc,
    MIRPreludeCallID, MIRProgram, MIRType, MIRValueID,
    mir_type_display_name, mir_type_identity_key,
]

fn lower_function_with_key(p: MIRProgram, key: String) -> MIRFunction? {
    loop function in p.functions {
        if function.key == key -> return Val(function)
    }
    None
}

// Source-owned process helpers are selected from checked MIR, never by a
// guessed function id or by interpreting the seed's Rc/BufReader storage.
fn lower_pipe_next_name(ty: MIRType) -> String Never! {
    if ty.kind == .Apply(name, args) {
        if args.len() != 0 -> return ""
        if name.name == "ProcessStdoutStream" || name.name.ends_with("::ProcessStdoutStream") -> return "__stdout_next_line"
        if name.name == "ProcessStderrStream" || name.name.ends_with("::ProcessStderrStream") -> return "__stderr_next_line"
    }
    ""
}

fn lower_pipe_next(p: MIRProgram, ty: MIRType) -> MIRFunction? {
    name :: lower_pipe_next_name(ty)
    if name == "" -> return None
    selected := MIRFunction?{None}
    loop function in p.functions {
        if function.name != name || function.params.len() != 1 -> next
        if mir_type_identity_key(function.params[0].ty) != mir_type_identity_key(ty) -> next
        authored := false
        loop source in p.source_files {
            if source.id == function.source_file && (source.path == "Core/process/process.jet" || source.path.ends_with("/Core/process/process.jet")) -> authored = true
        }
        if !authored -> next
        if selected != None -> return None
        selected = Val(function)
    }
    selected
}

fn lower_iterable_item_type(next: MIRFunction) -> MIRType Never! {
    if next.return_type.kind == .Result(ok, _) -> return ok
    next.return_type
}

// The user `Iterator.next` of iterator type `ty`, None when `ty` implements no
// Iterator.
fn lower_iterable_next(p: MIRProgram, ty: MIRType) -> MIRFunction? {
    if lower_pipe_next_name(ty) != "" -> return lower_pipe_next(p, ty)
    identity :: mir_type_identity_key(ty)
    loop implementation in p.impls {
        trait_ref :: implementation.trait_ref ?? next
        if trait_ref.name != "Iterator" || mir_type_identity_key(implementation.self_type) != identity -> next
        loop id in implementation.methods {
            loop function in p.functions {
                if function.id == id && function.name == "next" -> return Val(function)
            }
        }
    }
    None
}

// Bytes of the state box ahead of the iterator value.
fn lower_iterable_state_head() -> Int Never! { 24 }

fn lower_iterable_state_size(p: MIRProgram, iter_ty: MIRType) -> Int Never! {
    size :: lower_align_up(lower_size(p, iter_ty).size, 8)
    lower_iterable_state_head() + (if size < 8 -> 8 else -> size)
}

// Why `next` cannot be called with the iterator stored at a state cell, or
// None when it can: one `&self` (Write) receiver, or a read-only inline one
// (an inline value is its storage's address), returning an `Option` box.
fn lower_iterable_next_problem(p: MIRProgram, m: LowerModule, next: MIRFunction, iter_ty: MIRType) -> String? {
    if next.generic_params.len() > 0 || next.capture_params.len() > 0 || next.params.len() != 1 -> return Val("Iterator.next {next.key} has no plain receiver-only signature")
    if lower_pipe_next_name(iter_ty) != "" {
        if next.params[0].access != .Read -> return Val("process next helper {next.key} does not borrow its stream")
        if next.return_type.kind == .Result(ok, _) {
            if ok.kind == .Option(inner) {
                if inner.kind != .String -> return Val("process next helper {next.key} does not return Result<Option<String>, IOError>")
            } else {
                return Val("process next helper {next.key} does not return Result<Option<String>, IOError>")
            }
        } else {
            return Val("process next helper {next.key} does not return Result<Option<String>, IOError>")
        }
    } else {
        if next.params[0].access != .Write && !(next.params[0].access == .Read && lower_is_inline(p, iter_ty)) -> return Val("Iterator.next {next.key} receiver convention")
        optional :: if next.return_type.kind == .Option(_) -> true else -> false
        if !optional -> return Val("Iterator.next {next.key} result {mir_type_display_name(next.return_type)}")
    }
    index :: lower_function_index(m, next.id)
    if index < 0 -> return Val("Iterator.next {next.key} is not lowered")
    if m.mir_results[index] != 0 -> return Val("Iterator.next {next.key} returns through memory")
    None
}

// One `next` call on the iterator at `cell`: the Option box it returns (null
// for None), owned by the caller.
fn lower_iterable_pull(p: MIRProgram, m: &LowerModule, f: &LowerFunction, next: MIRFunction, cell: LIRValueID) -> LIRValueID Never! {
    index :: lower_function_index(m, next.id)
    signature :: m.mir_signatures[index].copy()
    receiver := cell
    if lower_pipe_next_name(next.params[0].ty) != "" {
        receiver = lower_read_at(p, &f, cell, 0, next.params[0].ty) ?? {
            lower_fail(&m, &f, "process line source has no native stream carrier")
            return cell.copy()
        }
    }
    item :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Call{dst: Val(item), signature: signature, callee: LIRCallee.Function{id: LIRFunctionID{value: index}}, args: [LIRValueID]{receiver}})
    if next.return_type.kind == .Result(ok, err) {
        outcome_tag :: lower_list_word(&f, item, 0)
        zero :: lower_const(&f, lower_result_selector(false))
        failed :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: failed, condition: LIRCondition.Eq, left: outcome_tag, right: zero})
        stop :: lower_new_block(&f)
        valid :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: failed, then_target: lower_target(stop, [LIRValueID]{}), else_target: lower_target(valid, [LIRValueID]{})})
        lower_start(&f, stop, [LIRValueID]{})
        failure :: lower_read_at(p, &f, item, lower_result_payload_offset(), err) ?? {
            lower_fail(&m, &f, "process line source IOError has no native representation")
            return item
        }
        text :: lower_render_value(p, &m, &f, err, Val(failure), LowerRenderMode.Display) ?? {
            lower_fail(&m, &f, "process line source IOError Display is not lowered")
            return item
        }
        // The same native panic route as a checked source panic. Preserve the
        // Prelude location; the helper's returned diagnostic is not replaced.
        context :: MIRPanicContext{function: "", source_line: "", caret: 0, locals: [MIRPanicLocal]{}}
        location :: MIRPanicLoc{file: next.source_file, line: 0, column: 0}
        data :: lower_require_descriptor(&m, "<core.prelude>", location, context)
        descriptor :: lower_pointer(&f)
        lower_emit(&f, LIRInst.DataAddress{dst: descriptor, data: data})
        null :: lower_require_null(&f)
        panic_kind :: lower_const(&f, 2)
        lower_noreturn_call(&m, &f, "jet_rt_require_stop", [LIRValueID]{panic_kind, descriptor, text.value, null, null, null})
        lower_start(&f, valid, [LIRValueID]{})
        optional :: lower_read_at(p, &f, item, lower_result_payload_offset(), ok) ?? {
            lower_fail(&m, &f, "process line source Option has no native representation")
            return item
        }
        lower_free_shell(&m, &f, item, lower_result_box_size(p, ok, err))
        return optional
    }
    item
}

fn lower_iterable_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool, iter_symbol: String, next_symbol: String) Never! {
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return
    unsupported :: "Iterable loop source"
    iter :: lower_function_with_key(p, iter_symbol) ?? return lower_fail(&m, &f, "{unsupported} names missing Iterable.iter {iter_symbol}")
    next :: lower_function_with_key(p, next_symbol) ?? return lower_fail(&m, &f, "{unsupported} names missing Iterator.next {next_symbol}")
    iter_ty :: iter.return_type
    if iter.generic_params.len() > 0 || iter.capture_params.len() > 0 || iter.params.len() != 1 || iter.params[0].access == .Write {
        return lower_fail(&m, &f, "{unsupported} with Iterable.iter {iter_symbol} of this signature is not lowered at O0 yet")
    }
    if lower_iterable_next(p, iter_ty) == .Val(found) {
        if found.id != next.id -> return lower_fail(&m, &f, "{unsupported} {next_symbol} is not the Iterator.next of {mir_type_display_name(iter_ty)}")
    } else {
        return lower_fail(&m, &f, "{unsupported} iterator {mir_type_display_name(iter_ty)} has no Iterator.next")
    }
    if lower_iterable_next_problem(p, m, next, iter_ty) == .Val(problem) -> return lower_fail(&m, &f, "{unsupported}: {problem} is not lowered at O0 yet")
    if lower_repr_layout(lower_repr(p, iter_ty)) == None -> return lower_fail(&m, &f, "{unsupported} iterator {mir_type_display_name(iter_ty)} is not lowered at O0 yet")
    iter_index :: lower_function_index(m, iter.id)
    if iter_index < 0 -> return lower_fail(&m, &f, "{unsupported} Iterable.iter {iter_symbol} is not lowered")
    // jet_iterable_loop_source consumes the collection: a borrowed source
    // would need the snapshot clone a List loop takes.
    if !by_value || !lower_value_owned(c, collection) -> return lower_fail(&m, &f, "{unsupported} over a borrowed collection is not lowered at O0 yet")
    collection_ty :: lower_value_type(c, collection) ?? return lower_fail(&m, &f, "{unsupported} collection has no checked type")
    cursor_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "iterator cursor without a checked type is not lowered at O0 yet")
    if !lower_is_iter_cursor(cursor_ty) -> return lower_fail(&m, &f, "this iterator cursor type is not lowered at O0 yet")
    stride := lower_const(&f, 1)
    if step == .Val(value) {
        stride = lower_use(&m, &f, value) ?? return
        if lower_value_layout(f, stride) != lir_layout_word() -> return lower_fail(&m, &f, "non-word iterator stride is not lowered at O0 yet")
        step_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "iterator stride without a checked type is not lowered at O0 yet")
        if lower_is_exact_int(step_ty) {
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, stride, "jet_int_owned_to_i64", false)
            stride = native
        }
    }
    zero :: lower_const(&f, 0)
    invalid :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: invalid, condition: LIRCondition.Le, left: stride, right: zero})
    lower_iter_check(&m, &f, invalid, "iterator loop stride must be positive")
    source :: lower_use(&m, &f, collection) ?? return
    state :: lower_pointer(&f)
    lower_alloc(&m, &f, state, lower_iterable_state_size(p, iter_ty))
    cell :: lower_address(&f, state, lower_iterable_state_head())
    iter_signature :: m.mir_signatures[iter_index].copy()
    iter_target :: LIRCallee.Function{id: LIRFunctionID{value: iter_index}}
    if m.mir_results[iter_index] > 0 {
        // An inline iterator is built straight into the state box.
        lower_emit(&f, LIRInst.Call{dst: None, signature: iter_signature, callee: iter_target, args: [LIRValueID]{cell, source}})
    } else {
        layout :: lower_repr_layout(lower_repr(p, iter_ty)) ?? return
        made :: lower_new_value(&f, layout, LIRDrop.Trivial, iter_ty.identity)
        lower_emit(&f, LIRInst.Call{dst: Val(made), signature: iter_signature, callee: iter_target, args: [LIRValueID]{source}})
        lower_emit(&f, LIRInst.Store{base: state, offset: lower_iterable_state_head(), value: made})
    }
    // A read-only `iter` borrows the source; the loop still consumes it.
    if iter.params[0].access != .Move -> lower_map_drop_value(p, &m, &f, source, collection_ty)
    first :: lower_iterable_pull(p, &m, &f, next, cell)
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: first})
    lower_emit(&f, LIRInst.Store{base: state, offset: 8, value: stride})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    exhausted :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: exhausted, condition: LIRCondition.Eq, left: first, right: null})
    lower_emit(&f, LIRInst.Store{base: state, offset: 16, value: exhausted})
    release :: lower_helper_id(&m, "iter.release", iter_ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: state})
    lower_store_word(&f, dst, 8, -1)
    lower_store_word(&f, dst, 16, 1)
    lower_store_word(&f, dst, 24, release.value)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
}

fn lower_pipe_carrier_problem(ty: MIRType) -> String? {
    if ty.kind == .Apply(name, args) {
        if args.len() == 0 {
            if lower_runtime_handle(name.name) == .Val(handle) {
                if handle.clone -> return None
            }
        }
    }
    Val("process line source {mir_type_display_name(ty)} has no vetted native clone/drop carrier")
}

// Process streams clone only the native holder; every cursor sees the same
// checked Core buffer/position. They do not use an Iterable.iter shim.
fn lower_pipe_cursor_init(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, call: MIRPreludeCallID, collection: MIRValueID, step: MIRValueID?, by_value: Bool) Never! {
    if !lower_iter_route(p, &m, &f, call, "jet_loop_iter_init", 5) -> return
    ty :: lower_value_type(c, collection) ?? return lower_fail(&m, &f, "process line source has no checked stream type")
    next :: lower_pipe_next(p, ty) ?? return lower_fail(&m, &f, "process line source {mir_type_display_name(ty)} has no checked Core next helper")
    if lower_pipe_carrier_problem(ty) == .Val(problem) -> return lower_fail(&m, &f, problem)
    if lower_iterable_next_problem(p, m, next, ty) == .Val(problem) -> return lower_fail(&m, &f, problem)
    cursor_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "process line cursor has no checked type")
    if !lower_is_iter_cursor(cursor_ty) -> return lower_fail(&m, &f, "process line cursor type is not lowered")
    stride := lower_const(&f, 1)
    if step == .Val(value) {
        stride = lower_use(&m, &f, value) ?? return
        step_ty :: lower_value_type(c, value) ?? return lower_fail(&m, &f, "process line stride has no checked type")
        if lower_is_exact_int(step_ty) {
            native :: lower_word(&f)
            lower_convert_exact(&m, &f, native, stride, "jet_int_owned_to_i64", false)
            stride = native
        }
        if lower_value_layout(f, stride) != lir_layout_word() -> return lower_fail(&m, &f, "process line stride has no native word carrier")
    }
    invalid :: lower_flag(&f)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: invalid, condition: LIRCondition.Le, left: stride, right: zero})
    lower_iter_check(&m, &f, invalid, "iterator loop stride must be positive")
    source :: lower_use(&m, &f, collection) ?? return
    held :: lower_pointer(&f)
    lower_clone_into(p, &m, &f, source, held, ty)
    state :: lower_pointer(&f)
    lower_alloc(&m, &f, state, lower_iterable_state_size(p, ty))
    lower_emit(&f, LIRInst.Store{base: state, offset: lower_iterable_state_head(), value: held})
    if by_value && lower_value_owned(c, collection) -> lower_map_drop_value(p, &m, &f, source, ty)
    cell :: lower_address(&f, state, lower_iterable_state_head())
    first :: lower_iterable_pull(p, &m, &f, next, cell)
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: first})
    lower_emit(&f, LIRInst.Store{base: state, offset: 8, value: stride})
    exhausted :: lower_flag(&f)
    null :: lower_require_null(&f)
    lower_emit(&f, LIRInst.Compare{dst: exhausted, condition: LIRCondition.Eq, left: first, right: null})
    lower_emit(&f, LIRInst.Store{base: state, offset: 16, value: exhausted})
    release :: lower_helper_id(&m, "iter.release", ty)
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    lower_alloc(&m, &f, dst, 48)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: state})
    lower_store_word(&f, dst, 8, -1)
    lower_store_word(&f, dst, 16, 1)
    lower_store_word(&f, dst, 24, release.value)
    lower_store_word(&f, dst, 32, 0)
    lower_store_word(&f, dst, 40, 0)
}

// Whether a cursor with index -1 is a user Iterable's (word 2 is 1).
fn lower_iterable_cursor_test(f: &LowerFunction, cursor: LIRValueID) -> LIRValueID Never! {
    marker :: lower_list_word(&f, cursor, 16)
    zero :: lower_const(&f, 0)
    user :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: user, condition: LIRCondition.Ne, left: marker, right: zero})
    user
}

// LoopCursor.rs has_next: a buffered item not yet taken.
fn lower_iterable_more(f: &LowerFunction, cursor: LIRValueID) -> LIRValueID Never! {
    state :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: state, base: cursor, offset: 0})
    current :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: current, base: state, offset: 0})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    present :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ne, left: current, right: null})
    taken :: lower_list_word(&f, cursor, 32)
    zero :: lower_const(&f, 0)
    ready :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: ready, condition: LIRCondition.Eq, left: taken, right: zero})
    more :: lower_flag(&f)
    lower_logic(&f, more, true, present, ready)
    more
}

// The buffered item into `slot`. An owned binding moves it out (the Option
// shell is freed and the cursor holds none, as LoopCursor.rs value's take);
// a borrowed binding reads it in place until advance drops it.
fn lower_iterable_value(p: MIRProgram, m: &LowerModule, f: &LowerFunction, cursor: LIRValueID, slot: LIRValueID, ty: MIRType, owned: Bool) Never! {
    state :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: state, base: cursor, offset: 0})
    current :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: current, base: state, offset: 0})
    if lower_read_at(p, &f, current, 0, ty) == .Val(value) -> lower_write_at(p, &f, slot, 0, value, ty)
    if !owned -> return
    lower_free_shell(&m, &f, current, lower_option_box_size(p, ty))
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: null})
}

// "iter.advance.typed" / "iter.release" for iterator type glue.ty. Both drop
// a buffered item still held. Advance then pulls `step` items unless the
// source is exhausted, dropping all but the last; release drops the iterator
// and frees the state box.
fn lower_iterable_cursor_helper(p: MIRProgram, m: &LowerModule, glue: LowerGlue, next: MIRFunction, advance: Bool) -> LIRFunction Never! {
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer()}, None)
    cursor :: f.open_params[0].copy()
    if lower_iterable_next_problem(p, m, next, glue.ty) == .Val(problem) {
        lower_fail(&m, &f, "Iterable loop source: {problem} is not lowered at O0 yet")
        lower_seal(&f, LIRTerminator.Unreachable)
        return lir_builder_finish(f.builder)
    }
    item_ty :: lower_iterable_item_type(next)
    head :: lower_iterable_state_head()
    state :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: state, base: cursor, offset: 0})
    lower_drop_stored(p, &m, &f, state, 0, item_ty)
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: null})
    if !advance {
        lower_drop_stored(p, &m, &f, state, head, glue.ty)
        lower_free_shell(&m, &f, state, lower_iterable_state_size(p, glue.ty))
        lower_seal(&f, LIRTerminator.Return{value: None})
        return lir_builder_finish(f.builder)
    }
    cell :: lower_address(&f, state, head)
    exhausted :: lower_flag(&f)
    lower_emit(&f, LIRInst.Load{dst: exhausted, base: state, offset: 16})
    pulling :: lower_new_block(&f)
    finish :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: exhausted, then_target: lower_target(finish, [LIRValueID]{}), else_target: lower_target(pulling, [LIRValueID]{})})
    lower_start(&f, pulling, [LIRValueID]{})
    // step - 1 skipped items, each dropped; a None on the way ends the source.
    stride :: lower_list_word(&f, state, 8)
    one :: lower_const(&f, 1)
    skips :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: skips, op: LIRBinaryOp.Sub, left: stride, right: one})
    zero :: lower_const(&f, 0)
    loop_head :: lower_new_block(&f)
    skip_body :: lower_new_block(&f)
    skip_keep :: lower_new_block(&f)
    ended :: lower_new_block(&f)
    last :: lower_new_block(&f)
    at :: lower_word(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(loop_head, [LIRValueID]{zero})})
    lower_start(&f, loop_head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: skips})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(skip_body, [LIRValueID]{}), else_target: lower_target(last, [LIRValueID]{})})
    lower_start(&f, skip_body, [LIRValueID]{})
    skipped :: lower_iterable_pull(p, &m, &f, next, cell)
    none :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: none, condition: LIRCondition.Eq, left: skipped, right: null})
    lower_seal(&f, LIRTerminator.Branch{condition: none, then_target: lower_target(ended, [LIRValueID]{}), else_target: lower_target(skip_keep, [LIRValueID]{})})
    lower_start(&f, skip_keep, [LIRValueID]{})
    lower_map_drop_value(p, &m, &f, skipped, item_ty)
    next_at :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_at, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(loop_head, [LIRValueID]{next_at})})
    lower_start(&f, ended, [LIRValueID]{})
    yes :: lower_const_flag(&f, 1)
    lower_emit(&f, LIRInst.Store{base: state, offset: 16, value: yes})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(finish, [LIRValueID]{})})
    lower_start(&f, last, [LIRValueID]{})
    pulled :: lower_iterable_pull(p, &m, &f, next, cell)
    lower_emit(&f, LIRInst.Store{base: state, offset: 0, value: pulled})
    done :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: done, condition: LIRCondition.Eq, left: pulled, right: null})
    lower_emit(&f, LIRInst.Store{base: state, offset: 16, value: done})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(finish, [LIRValueID]{})})
    lower_start(&f, finish, [LIRValueID]{})
    lower_store_word(&f, cursor, 32, 0)
    lower_store_word(&f, cursor, 40, 0)
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}
