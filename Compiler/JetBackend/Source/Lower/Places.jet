// Addressable projections and recursive enum edges in the native byte layout.
use jet_foundation.[
    MIREnumArg, MIRField, MIRFieldID, MIRInstruction, MIRPayloadKind, MIRProgram, MIRProjection,
    MIRType, MIRTypeDef, MIRTypeID, MIRValueID, MIRVariant,
    mir_type_display_name,
]

struct LowerPayloadInfo {
    offset: Int
    ty: MIRType
    boxed: Bool
}

fn lower_declared_boxed_edge(definition: MIRTypeDef, edge: String) -> Bool Never! {
    loop candidate in definition.boxed_edges {
        if candidate == edge -> return true
    }
    false
}

// MIRRust.rs:payload_pattern (28961), declared_boxed_edge (24181): Single
// edges use the variant name; Named edges use "Variant.field", not field IDs.
// `index` counts payload fields in declaration order (as MIR EnumPayload and
// Enum arguments do: MIRRust.rs enum_value/enum_payload); a computed field
// has no storage.
fn lower_enum_payload_info(p: MIRProgram, definition: MIRTypeDef, variant: MIRVariant, index: Int) -> LowerPayloadInfo? {
    members :: lower_variant_members(p, definition, variant)
    if variant.payload == {
        .Unit -> None
        .Single(_) -> {
            if index != 0 || members.len() != 1 -> return None
            Val(LowerPayloadInfo{offset: members[0].offset, ty: members[0].ty, boxed: members[0].boxed})
        }
        .Named(fields) -> {
            if index < 0 || index >= fields.len() || fields[index].computed -> return None
            loop member in members {
                if member.id == fields[index].id -> return Val(LowerPayloadInfo{offset: member.offset, ty: member.ty, boxed: member.boxed})
            }
            None
        }
    }
}

fn lower_payload_info(p: MIRProgram, ty: MIRType, kind: MIRPayloadKind) -> LowerPayloadInfo? {
    if kind == {
        .Option -> if ty.kind == .Option(inner) -> Val(LowerPayloadInfo{offset: 0, ty: inner, boxed: false}) else -> None
        .Result(ok) -> if ty.kind == .Result(success, failure) -> Val(LowerPayloadInfo{offset: lower_result_payload_offset(), ty: if ok -> success else -> failure, boxed: false}) else -> None
        .Enum(owner, variant, index) -> {
            definition :: lower_owned_def(p, owner, Val(ty)) ?? return None
            found :: lower_variant(definition, variant) ?? return None
            lower_enum_payload_info(p, definition, found.variant, index)
        }
    }
}

// The storage a projected place names: its value of type `ty` lives at
// base + offset. Nested inline members add offsets; a box (payload enum,
// Option, Result, List) or a recursive edge's wrapper is entered by loading
// its pointer. A checked payload place is entered only after its variant test.
fn lower_walk_projections(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, root: LIRValueID, root_ty: MIRType, projections: [MIRProjection]) -> LowerFieldAddress? {
    walked :: lower_walk_place(p, c, &m, &f, root, root_ty, projections) ?? return None
    if walked.borrowed {
        message :: if walked.ty.kind == .String -> "String field write through a runtime handle is not lowered" else -> "writing through a field of runtime handle is not lowered at O0 yet"
        lower_fail(&m, &f, message)
        return None
    }
    Val(walked.address)
}

// `borrowed`: the place is a field inside a runtime handle's own value
// (lower_handle_field_place), which may be read but not written or moved.
struct LowerPlaceAddress {
    address: LowerFieldAddress
    ty: MIRType
    borrowed: Bool
}

// lower_walk_projections with the type of the named value.
fn lower_walk_place(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, root: LIRValueID, root_ty: MIRType, projections: [MIRProjection]) -> LowerPlaceAddress? {
    base := root
    ty := root_ty
    offset := -1
    borrowed := false
    loop projection in projections {
        if offset >= 0 && !lower_inline_of(p, &f, ty) {
            // Enter the box (or wrapper) whose pointer the location holds;
            // nested inline members stay in the same storage.
            next_base :: lower_pointer(&f)
            lower_emit(&f, LIRInst.Load{dst: next_base, base: base, offset: offset})
            base = next_base
            offset = 0
        }
        if offset < 0 -> offset = 0
        if projection == {
            .Field(id, _) -> {
                if lower_struct_field_of(p, &f, ty, id) == None {
                    // A field of a runtime handle: its place inside the runtime's value.
                    if offset == 0 {
                        if lower_handle_field_place(p, &m, &f, base, ty, id) == .Val(place) {
                            base = place.address.base
                            offset = place.address.offset
                            ty = place.ty
                            borrowed = true
                            next
                        }
                    }
                    lower_fail(&m, &f, "field {id.value} of {mir_type_display_name(ty)} is not lowered at O0 yet")
                    return None
                }
                found :: lower_struct_field_of(p, &f, ty, id) ?? return None
                address :: lower_struct_storage_address(&f, base, LowerFieldInfo{offset: offset + found.offset, ty: found.ty, boxed: found.boxed})
                base = address.base
                offset = address.offset
                ty = found.ty
            }
            .Payload(kind, _) -> {
                if !lower_native_enum_layout(p, ty) {
                    lower_fail(&m, &f, "opaque runtime enum {mir_type_display_name(ty)} has no native enum layout")
                    return None
                }
                found :: lower_payload_info(p, ty, kind) ?? {
                    lower_fail(&m, &f, "payload projection of {mir_type_display_name(ty)} is not lowered at O0 yet")
                    return None
                }
                offset = found.offset
                ty = found.ty
                if found.boxed {
                    wrapper :: lower_pointer(&f)
                    lower_emit(&f, LIRInst.Load{dst: wrapper, base: base, offset: offset})
                    base = wrapper
                    offset = 0
                }
            }
            .Index(kind, index, _, _, _, _, _) -> {
                header :: lower_address(&f, base, offset)
                if kind == .Map {
                    base = lower_map_value_address(p, &m, &f, header, ty, index) ?? return None
                    ty = lower_map_value_type(ty) ?? return None
                    offset = 0
                } else if kind == .List || kind == .FixedListProof {
                    found :: lower_index_address(p, c, &m, &f, header, ty, index) ?? return None
                    ty = lower_list_element(ty) ?? return None
                    base = found.base
                    offset = found.offset
                } else {
                    kind_name :: if kind == {
                        .Lane -> "Lane"
                        .Pool -> "Pool"
                        else -> "other"
                    }
                    lower_fail(&m, &f, "non-List, non-Map index projection ({kind_name} on {mir_type_display_name(ty)}) is not lowered at O0 yet")
                    return None
                }
            }
            .MapLookup(lookup, optional, _) -> {
                value_ty :: lower_map_value_type(ty) ?? {
                    lower_fail(&m, &f, "MapLookup projection requires a Map")
                    return None
                }
                selected :: lower_use(&m, &f, lookup) ?? return None
                address :: lower_pointer(&f)
                if optional {
                    hit :: lower_new_block(&f)
                    miss :: lower_new_block(&f)
                    done :: lower_new_block(&f)
                    zero :: lower_pointer(&f)
                    lower_emit(&f, LIRInst.Const{dst: zero, value: 0})
                    present :: lower_flag(&f)
                    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ne, left: selected, right: zero})
                    lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
                    lower_start(&f, hit, [LIRValueID]{})
                    payload :: lower_pointer(&f)
                    lower_emit(&f, LIRInst.Load{dst: payload, base: selected, offset: 0})
                    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{payload})})
                    lower_start(&f, miss, [LIRValueID]{})
                    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{zero})})
                    lower_start(&f, done, [LIRValueID]{address})
                    // A borrowed Option<V> points directly at the map's V
                    // storage. An owning ReadPlace clones it through normal
                    // Option glue; the map's storage is never transferred.
                    base = lower_pointer(&f)
                    lower_emit(&f, LIRInst.StackSlot{dst: base, size: 8, align: 8})
                    lower_emit(&f, LIRInst.Store{base: base, offset: 0, value: address})
                    ty = lower_option_type(value_ty)
                } else {
                    lower_emit(&f, LIRInst.Load{dst: address, base: selected, offset: 0})
                    base = address
                    ty = value_ty
                }
                offset = 0
                borrowed = true
            }
            .Deref(_) -> {
                elem :: lower_shared_guard_element(ty) ?? {
                    lower_fail(&m, &f, "Deref projection of {mir_type_display_name(ty)} is not lowered at O0 yet")
                    return None
                }
                base = lower_shared_guard_payload(&m, &f, base, ty) ?? return None
                borrowed = lower_shared_guard_editable(ty) != Val(true)
                offset = 0
                ty = elem
            }
            else -> {
                lower_fail(&m, &f, "Deref or Range projection is not lowered at O0 yet")
                return None
            }
        }
    }
    if offset < 0 -> offset = 0
    if !lower_atomic_check_offset(p, &m, &f, ty, offset) -> return None
    Val(LowerPlaceAddress{address: LowerFieldAddress{base: base, offset: offset}, ty: ty, borrowed: borrowed})
}

// ProcessReceipt144/ProcessPlan72 are Jet-owned carriers, never hosted Rust
// records, in pack and program lowering alike (lower_repr makes the
// compiler-owned process records handles). Validate canonical identity and
// actual member types before lending their storage to the typed read/clone glue.
fn lower_native_process_carrier(handle: LowerRuntimeHandle, name: String) -> Bool Never! {
    (handle.runtime == "ProcessReceipt" || handle.runtime == "ProcessPlan" || handle.runtime == "ProcessChild") && name == handle.jet_name
}

fn lower_native_process_place(p: MIRProgram, f: &LowerFunction, handle: LIRValueID, ty: MIRType, id: MIRFieldID) -> LowerPlaceAddress? {
    runtime :: lower_runtime_handle_type(p, ty) ?? return None
    if runtime.runtime != "ProcessReceipt" && runtime.runtime != "ProcessPlan" -> return None
    definition :: lower_type_def(p, ty) ?? return None
    if definition.key != runtime.jet_name && !definition.key.starts_with("<corelib>/") -> return None
    fields :: if definition.kind == { .Struct(stored, _) -> { stored } else -> { return None } }
    loop field in lower_stored_fields(fields) {
        if field.id != id -> next
        offset :: if runtime.runtime == "ProcessReceipt" -> {
            if field.name == {
                "code" -> { 0 }
                "output" -> { 8 }
                "errors" -> { 16 }
                "success" -> { 24 }
                "signal" -> { 32 }
                "timed_out" -> { 40 }
                "executable_identity" -> { 48 }
                "argv" -> { 56 }
                "input_digest" -> { 64 }
                "policy_digest" -> { 72 }
                "backend" -> { 80 }
                "authority" -> { 88 }
                "descendants" -> { 96 }
                "limits" -> { 104 }
                "outputs" -> { 112 }
                "redacted" -> { 120 }
                "pid" -> { 128 }
                "limit_hit" -> { 136 }
                else -> { return None }
            }
        } else -> {
            if field.name == {
                "executable_identity" -> { 0 }
                "argv" -> { 8 }
                "input_digest" -> { 16 }
                "policy_digest" -> { 24 }
                "backend" -> { 32 }
                "authority" -> { 40 }
                "descendants" -> { 48 }
                "limits" -> { 56 }
                "outputs" -> { 64 }
                else -> { return None }
            }
        }
        matches :: if field.name == {
            "code" | "pid" -> { lower_is_exact_int(field.ty) }
            "success" | "timed_out" | "redacted" -> { field.ty.kind == .Bool }
            "argv" | "authority" | "limits" | "outputs" -> {
                element :: lower_list_element(field.ty) ?? return None
                element.kind == .String
            }
            "signal" -> {
                if field.ty.kind == { .Option(inner) -> { lower_is_exact_int(inner) } else -> { false } }
            }
            "limit_hit" -> {
                if field.ty.kind == {
                    .Option(inner) -> {
                        limit :: lower_runtime_handle_type(p, inner) ?? return None
                        limit.runtime == "ProcessResourceLimit"
                    }
                    else -> { false }
                }
            }
            else -> { field.ty.kind == .String }
        }
        if !matches -> return None
        return Val(LowerPlaceAddress{address: LowerFieldAddress{base: handle, offset: offset}, ty: field.ty, borrowed: true})
    }
    None
}

// Field `id` of a runtime handle (RuntimeRoutes.jet LOWER_HANDLE_FIELDS):
// Float/Bool and native-layout nested handles lend storage. String and
// converted canonical carriers write read-only headers into caller stack slots.
// Owning reads clone through the existing typed glue; a borrowed header must
// never be released, grown, moved or passed to an ownership-taking export.
fn lower_handle_field_place(p: MIRProgram, m: &LowerModule, f: &LowerFunction, handle: LIRValueID, ty: MIRType, id: MIRFieldID) -> LowerPlaceAddress? {
    if lower_repr(p, ty) == {
        .Handle(_, _) -> {}
        else -> return None
    }
    if lower_native_err_type(p, ty) -> return lower_native_err_place(p, &f, handle, ty, id)
    if lower_native_process_place(p, &f, handle, ty, id) == .Val(place) -> return Val(place)
    runtime :: lower_runtime_handle_type(p, ty) ?? return None
    definition :: lower_type_def(p, ty) ?? return None
    fields := [MIRField]{}
    if definition.kind == .Struct(listed, _) -> fields = listed
    loop field in lower_stored_fields(fields) {
        if field.id != id -> next
        lent :: lower_handle_field(runtime.runtime, field.name) ?? return None
        expected :: LowerRouteCarrier.Handle{name: lower_record_tail(lent.kind, 7)}
        matches :: if lent.kind == {
            "Text" -> field.ty.kind == .String
            "Float" -> field.ty.kind == .Float
            "Flag" -> field.ty.kind == .Bool
            else -> {
                actual :: lower_route_carrier_of(p, field.ty) ?? return None
                lent.kind.starts_with("Handle.") && actual == expected
            }
        }
        if !matches -> return None
        address :: lower_pointer(&f)
        if (lent.kind == "Text" || lent.header_bytes > 0) {
            bytes :: if lent.kind == "Text" -> 24 else -> lent.header_bytes
            lower_emit(&f, LIRInst.StackSlot{dst: address, size: bytes, align: 8})
            lower_call_runtime(&m, &f, "jet_rt_handle_field_{runtime_abi_atom(runtime.runtime)}_{runtime_abi_atom(field.name)}", [LIRValueID]{handle, address}, None)
        } else {
            lower_call_runtime(&m, &f, "jet_rt_handle_field_{runtime_abi_atom(runtime.runtime)}_{runtime_abi_atom(field.name)}", [LIRValueID]{handle}, Val(address))
        }
        if lent.kind == "Float" || lent.kind == "Flag" {
            return Val(LowerPlaceAddress{address: LowerFieldAddress{base: address, offset: 0}, ty: field.ty, borrowed: true})
        }
        slot :: lower_pointer(&f)
        lower_emit(&f, LIRInst.StackSlot{dst: slot, size: 8, align: 8})
        lower_emit(&f, LIRInst.Store{base: slot, offset: 0, value: address})
        return Val(LowerPlaceAddress{address: LowerFieldAddress{base: slot, offset: 0}, ty: field.ty, borrowed: true})
    }
    None
}

// MIRRust.rs:plan_partial_moves (16915), move_projected_place (28734),
// move_partial_field (17123): a Field path leaves a partial owner, and so does
// a checked payload path (an explicit `^p` of a match payload, entered only
// after its variant test). Its consuming storage is zeroed (lower_clear_at):
// glue skips the null owners there, while retaining all unmoved siblings and
// the carrier itself; a Close-bearing member gets a partial-drop flag
// (PartialDrop.jet lower_partial_field_path).
fn lower_projected_move_supported(m: &LowerModule, f: &LowerFunction, projections: [MIRProjection]) -> Bool Never! {
    loop projection in projections {
        if projection == {
            .Field(_, _) | .Payload(_, _) -> {}
            else -> {
                lower_fail(&m, &f, "moving out of a non-Field, non-payload projection is not lowered at O0 yet")
                return false
            }
        }
    }
    true
}

fn lower_enum(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, type_id: MIRTypeID, variant: String, args: [MIREnumArg]) Never! {
    ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "enum construction has no checked type")
    if !lower_native_enum_layout(p, ty) -> return lower_fail(&m, &f, "opaque runtime enum {mir_type_display_name(ty)} has no native enum layout")
    definition :: lower_owned_def(p, type_id, lower_checked_type(c, instruction)) ?? return lower_fail(&m, &f, "enum type {type_id.value} is missing")
    found :: lower_variant(definition, variant) ?? return lower_fail(&m, &f, "{definition.name} has no variant {variant}")
    // Check every payload has storage before allocating or storing any part
    // of the enum. The declared boxed edges decide boxing, not the argument's
    // flag (MIRRust.rs enum_value: declared_boxed_edge).
    loop (index, _) in args {
        if lower_enum_payload_info(p, definition, found.variant, index) == None -> return lower_fail(&m, &f, "{definition.name}.{variant} has no stored payload {index}")
    }
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    discriminant :: lower_discriminant(found.index)
    if lower_value_layout(f, dst) != lir_layout_pointer() -> return lower_emit(&f, LIRInst.Const{dst: dst, value: discriminant})
    lower_alloc(&m, &f, dst, lower_enum_box_size(p, definition))
    lower_store_word(&f, dst, 0, discriminant)
    loop (index, arg) in args {
        info :: lower_enum_payload_info(p, definition, found.variant, index) ?? return
        if info.boxed {
            wrapper :: lower_pointer(&f)
            lower_alloc(&m, &f, wrapper, lower_option_box_size(p, info.ty))
            lower_store_value(p, &m, &f, wrapper, 0, arg.value, info.ty)
            lower_emit(&f, LIRInst.Store{base: dst, offset: info.offset, value: wrapper})
        } else {
            lower_store_value(p, &m, &f, dst, info.offset, arg.value, info.ty)
        }
    }
}

fn lower_enum_payload(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, subject: MIRValueID, owner: MIRTypeID, variant: String, index: Int) Never! {
    ty :: lower_value_type(c, subject) ?? return lower_fail(&m, &f, "enum subject has no checked type")
    if !lower_native_enum_layout(p, ty) -> return lower_fail(&m, &f, "opaque runtime enum {mir_type_display_name(ty)} has no native enum layout")
    definition :: lower_owned_def(p, owner, lower_value_type(c, subject)) ?? return lower_fail(&m, &f, "enum type {owner.value} is missing")
    found :: lower_variant(definition, variant) ?? return lower_fail(&m, &f, "{definition.name} has no variant {variant}")
    info :: lower_enum_payload_info(p, definition, found.variant, index) ?? return lower_fail(&m, &f, "{definition.name}.{variant} has no stored payload {index}")
    boxed :: lower_use(&m, &f, subject) ?? return
    dst :: lower_result(p, c, &m, &f, instruction) ?? return
    if info.boxed {
        wrapper :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: wrapper, base: boxed, offset: info.offset})
        lower_read_member(p, c, &m, &f, instruction, subject, dst, wrapper, 0, info.ty)
    } else {
        lower_read_member(p, c, &m, &f, instruction, subject, dst, boxed, info.offset, info.ty)
    }
}

// A recursive-edge wrapper has exactly the present Option layout: one box
// holding the value. Reusing that shape makes clone/drop recurse and release
// its allocation without a second wrapper representation or runtime symbol.
fn lower_enum_glue_shape(p: MIRProgram, definition: MIRTypeDef, variant: MIRVariant, index: Int) -> LowerGlueShape Never! {
    rows := [LowerGlueField]{}
    loop member in lower_variant_members(p, definition, variant) -> &rows.push(LowerGlueField{offset: member.offset, ty: lower_member_storage_type(member)})
    LowerGlueShape{selector: lower_discriminant(index), fields: rows}
}

// Stored Int fields own a reference. Plain Int SSA values retain their
// existing ownership policy; these helpers are only for owning glue.
fn lower_glue_clone_int(m: &LowerModule, f: &LowerFunction, value: LIRValueID) -> LIRValueID Never! {
    result :: lower_word(&f)
    inline :: lower_inline_test(&f, [LIRValueID]{value})
    retain :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: inline, then_target: lower_target(done, [LIRValueID]{value}), else_target: lower_target(retain, [LIRValueID]{})})
    lower_start(&f, retain, [LIRValueID]{})
    duplicate :: lower_word(&f)
    lower_call_runtime(&m, &f, "jet_rt_int_clone", [LIRValueID]{value}, Val(duplicate))
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{duplicate})})
    lower_start(&f, done, [LIRValueID]{result})
    result
}

fn lower_glue_drop_int(m: &LowerModule, f: &LowerFunction, value: LIRValueID) Never! {
    inline :: lower_inline_test(&f, [LIRValueID]{value})
    release :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: inline, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(release, [LIRValueID]{})})
    lower_start(&f, release, [LIRValueID]{})
    lower_call_runtime(&m, &f, "jet_rt_int_drop", [LIRValueID]{value}, None)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// Drops the owned value of `ty` stored at base + offset. Null is an absent
// split field, never a handle to pass to the runtime; an inline member's
// glue drops its own members.
fn lower_drop_stored(p: MIRProgram, m: &LowerModule, f: &LowerFunction, base: LIRValueID, offset: Int, ty: MIRType) Never! {
    repr :: lower_repr(p, ty)
    if repr == .Unsupported(reason) -> return lower_fail(&m, &f, "drop glue field of {reason} is not lowered at O0 yet")
    if repr == .ExactInt && lower_is_exact_int(ty) {
        value :: lower_word(&f)
        lower_emit(&f, LIRInst.Load{dst: value, base: base, offset: offset})
        return lower_glue_drop_int(&m, &f, value)
    }
    if repr == .Inline(_) {
        address :: lower_address(&f, base, offset)
        return lower_inline_drop(p, &m, &f, address, ty)
    }
    if lower_close_method(p, m.close_methods, ty) != None {
        value :: lower_read_at(p, &f, base, offset, ty) ?? return
        return lower_map_drop_value(p, &m, &f, value, ty)
    }
    layout :: lower_repr_layout(repr) ?? return
    drop :: lower_drop(&m, repr, true)
    if drop == .Trivial -> return
    value :: lower_new_value(&f, layout, drop, ty.identity)
    lower_emit(&f, LIRInst.Load{dst: value, base: base, offset: offset})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    absent :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: value, right: null})
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    lower_emit(&f, LIRInst.Drop{value: value})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, done, [LIRValueID]{})
}

// A replacement transfers the old bits into an owning slot before publishing
// the new owner. Close may re-enter the destination; it must never find an old
// owner whose lifetime has already been consumed.
fn lower_detach_stored(p: MIRProgram, f: &LowerFunction, base: LIRValueID, offset: Int, ty: MIRType) -> LIRValueID Never! {
    detached :: lower_new_storage(p, &f, ty)
    lower_copy_bytes(&f, detached, 0, base, offset, lower_size(p, ty).size)
    detached
}

fn lower_replace_stored(p: MIRProgram, m: &LowerModule, f: &LowerFunction, base: LIRValueID, offset: Int, value: LIRValueID, ty: MIRType) Never! {
    if !lower_needs_drop(p, m, ty) -> return lower_write_at(p, &f, base, offset, value, ty)
    detached :: lower_detach_stored(p, &f, base, offset, ty)
    lower_write_at(p, &f, base, offset, value, ty)
    lower_drop_stored(p, &m, &f, detached, 0, ty)
}

fn lower_glue_drop_fields(p: MIRProgram, m: &LowerModule, f: &LowerFunction, boxed: LIRValueID, fields: [LowerGlueField]) Never! {
    loop field in fields -> lower_drop_stored(p, &m, &f, boxed, field.offset, field.ty)
}

// After a word copy of the whole storage, replaces every owned member of
// the target by its own copy.
fn lower_glue_clone_fields(p: MIRProgram, m: &LowerModule, f: &LowerFunction, source: LIRValueID, target: LIRValueID, fields: [LowerGlueField]) Never! {
    loop field in fields {
        repr :: lower_repr(p, field.ty)
        if repr == .Unsupported(reason) -> return lower_fail(&m, &f, "clone glue field of {reason} is not lowered at O0 yet")
        if repr == .Word && lower_is_exact_int(field.ty) {
            value :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: value, base: source, offset: field.offset})
            duplicate :: lower_glue_clone_int(&m, &f, value)
            lower_emit(&f, LIRInst.Store{base: target, offset: field.offset, value: duplicate})
            next
        }
        if repr == .Inline(_) {
            if lower_needs_drop(p, m, field.ty) {
                from :: lower_address(&f, source, field.offset)
                to :: lower_address(&f, target, field.offset)
                lower_inline_clone(p, &m, &f, from, to, field.ty)
            }
            next
        }
        if repr == .ExactInt {
            value :: lower_word(&f)
            lower_emit(&f, LIRInst.Load{dst: value, base: source, offset: field.offset})
            duplicate :: lower_word(&f)
            lower_call_runtime(&m, &f, "jet_rt_int_clone", [LIRValueID]{value}, Val(duplicate))
            lower_emit(&f, LIRInst.Store{base: target, offset: field.offset, value: duplicate})
            next
        }
        if repr == {
            .Handle(_, _) | .Boxed(_) -> {}
            else -> next
        }
        value :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: value, base: source, offset: field.offset})
        null :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Const{dst: null, value: 0})
        absent :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: absent, condition: LIRCondition.Eq, left: value, right: null})
        body :: lower_new_block(&f)
        done :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: absent, then_target: lower_target(done, [LIRValueID]{}), else_target: lower_target(body, [LIRValueID]{})})
        lower_start(&f, body, [LIRValueID]{})
        duplicate :: lower_pointer(&f)
        if repr == {
            .Handle(_, clone) -> {
                if clone == "" -> return lower_fail(&m, &f, "{mir_type_display_name(field.ty)} cannot be copied")
                lower_call_runtime(&m, &f, clone, [LIRValueID]{value}, Val(duplicate))
            }
            .Boxed(inner) -> lower_call_clone_glue(&m, &f, inner, value, duplicate)
            else -> {}
        }
        lower_emit(&f, LIRInst.Store{base: target, offset: field.offset, value: duplicate})
        lower_seal(&f, LIRTerminator.Jump{target: lower_target(done, [LIRValueID]{})})
        lower_start(&f, done, [LIRValueID]{})
    }
}
