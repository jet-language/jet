// The checked Dyn remains a Jet enum. Runtime routes borrow an opaque
// runtime tree only at their boundary; this descriptor describes storage,
// never validation or codec policy (D-EXEC1/I9).
// Requested checked codec implementations are lowered by Codecs.jet.
// No unwired runtime/container codec policy is retained here.
use jet_foundation.[
    MIRInstruction, MIRLocalID, MIRNominalRef, MIRProgram, MIRType, MIRTypeKind, MIRValueID,
    mir_type_display_name, mir_type_from_kind,
]

fn lower_dyn_type(p: MIRProgram, ty: MIRType) -> Bool Never! {
    definition :: lower_type_def(p, ty) ?? return false
    if definition.kind == .Alias(base) -> return lower_dyn_type(p, base)
    definition.key == "Dyn" && definition.name == "Dyn"
}

fn lower_dyn_program_type(p: MIRProgram) -> MIRType? Never! {
    loop definition in p.types {
        if definition.key == "Dyn" && definition.name == "Dyn" {
            return Val(mir_type_from_kind(MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.name}, args: [MIRType]{}}))
        }
    }
    None
}


// Two header words [node bytes, row count], followed by rows indexed by the
// runtime variant's semantic identity, not by the checked declaration order.
// Each row is [tag, payload offset, boxed, payload bytes, element stride,
// key offset, value offset, element bytes]. A list is [len, cap, data].
fn lower_dyn_schema(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType) -> LIRValueID? {
    key :: "$native.dyn:{lower_mono_fingerprint(ty)}"
    id := LIRDataID{value: -1}
    if m.static_rows.get(key) == .Val(row) {
        id = LIRDataID{value: row}
    } else {
        definition :: lower_type_def(p, ty) ?? {
            lower_fail(&m, &f, "Dyn marshaling has no checked definition")
            return None
        }
        if !lower_dyn_type(p, ty) {
            lower_fail(&m, &f, "Dyn marshaling of {mir_type_display_name(ty)} has the wrong owner")
            return None
        }
        if definition.kind == .Enum(_, _) {} else {
            lower_fail(&m, &f, "Dyn marshaling requires the checked enum")
            return None
        }
        names :: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}
        words := [Int]{lower_enum_box_size(p, definition), names.len()}
        loop name in names {
            found :: lower_variant(definition, name) ?? {
                lower_fail(&m, &f, "Dyn marshaling has no {name} variant")
                return None
            }
            offset := 0
            boxed := 0
            bytes := 0
            stride := 0
            key_offset := 0
            value_offset := 0
            element_bytes := 0
            if name != "Null" {
                info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? {
                    lower_fail(&m, &f, "Dyn.{name} marshaling has no payload layout")
                    return None
                }
                offset = info.offset
                boxed = if info.boxed -> 1 else -> 0
                bytes = lower_size(p, info.ty).size
                if name == "Bytes" || name == "Array" || name == "Object" {
                    elem :: lower_list_element(info.ty) ?? {
                        lower_fail(&m, &f, "Dyn.{name} marshaling requires a List payload")
                        return None
                    }
                    stride = lower_list_stride(p, elem)
                    element_bytes = lower_size(p, elem).size
                    if name == "Object" {
                        members :: lower_inline_members(p, elem)
                        if members.len() != 2 || members[0].name != "key" || members[1].name != "value" {
                            lower_fail(&m, &f, "Dyn.Object marshaling requires checked key/value entries")
                            return None
                        }
                        key_offset = members[0].offset
                        value_offset = members[1].offset
                    }
                }
            }
            schema_words :: [Int]{lower_discriminant(found.index), offset, boxed, bytes, stride, key_offset, value_offset, element_bytes}
            loop word in schema_words -> &words.push(word)
        }
        id = lower_static_object(&m, words.len() * 8)
        loop (index, word) in words -> lower_static_store(&m, id, index * 8, lower_static_word(word))
        &m.static_rows.add(key, id.value).drop("schema absent above")
    }
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: address, data: id})
    Val(address)
}

fn lower_dyn_to_runtime(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, value: LIRValueID) -> LIRValueID? {
    schema :: lower_dyn_schema(p, &m, &f, ty) ?? return None
    result :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_dyn_from_native", [LIRValueID]{schema, value}, Val(result))
    Val(result)
}

fn lower_dyn_from_runtime(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, value: LIRValueID, dst: LIRValueID) Never! {
    schema :: lower_dyn_schema(p, &m, &f, ty) ?? return
    lower_call_runtime(&m, &f, "jet_rt_dyn_to_native", [LIRValueID]{schema, value}, Val(dst))
    lower_call_runtime(&m, &f, "jet_rt_handle_drop_dyn", [LIRValueID]{value}, None)
}

// `tree.field(name)` (JetStd/Dyn.rs JetDynAccess::field, Rust borrows the
// tree): the first Object entry whose key equals `name` is cloned out of the
// native enum with its ordinary glue, so a hit never converts the tree. Every
// miss (absent key or non-Object receiver) asks the canonical runtime leaf
// for its exact FieldError over a runtime tree built for that call only.
// False when the checked types are not Dyn and Result<Dyn, [FieldError]>.
fn lower_dyn_field(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: LowerRoute, args: [MIRValueID]) -> Bool Never! {
    if args.len() != 2 -> return false
    ty :: lower_value_type(c, args[0]) ?? return false
    if !lower_dyn_type(p, ty) -> return false
    result_ty :: lower_checked_type(c, instruction) ?? return false
    if !lower_route_shape_matches(p, result_ty, route.result) -> return false
    ok :: if route.result == { .Result(success, _) -> { success } else -> { return false } }
    err :: if route.result == { .Result(_, failure) -> { failure } else -> { return false } }
    errors :: if result_ty.kind == { .Result(_, failure) -> { failure } else -> { return false } }
    definition :: lower_type_def(p, ty) ?? return false
    object :: lower_variant(definition, "Object") ?? return false
    payload :: lower_enum_payload_info(p, definition, object.variant, 0) ?? return false
    entry_ty :: lower_list_element(payload.ty) ?? return false
    members :: lower_inline_members(p, entry_ty)
    if members.len() != 2 || members[0].name != "key" || members[1].name != "value" -> return false
    tree :: lower_use(&m, &f, args[0]) ?? return true
    name :: lower_use(&m, &f, args[1]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return true
    // Object test, then a scan of the entries in order.
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: tree, offset: 0})
    object_selector :: lower_const(&f, lower_discriminant(object.index))
    is_object :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: is_object, condition: LIRCondition.Eq, left: selector, right: object_selector})
    scan :: lower_new_block(&f)
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    next_block :: lower_new_block(&f)
    hit :: lower_new_block(&f)
    miss :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: is_object, then_target: lower_target(scan, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
    lower_start(&f, scan, [LIRValueID]{})
    holder := tree
    if payload.boxed {
        wrapper :: lower_pointer(&f)
        lower_emit(&f, LIRInst.Load{dst: wrapper, base: tree, offset: payload.offset})
        holder = wrapper
    }
    entries :: lower_read_at(p, &f, holder, if payload.boxed -> 0 else -> payload.offset, payload.ty) ?? return true
    length :: lower_list_word(&f, entries, 0)
    data :: lower_list_data(&f, entries)
    stride :: lower_list_stride(p, entry_ty)
    zero :: lower_const(&f, 0)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{zero})})
    at :: lower_word(&f)
    lower_start(&f, head, [LIRValueID]{at})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: at, right: length})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(miss, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    entry :: lower_list_address(&f, data, at, stride)
    key :: lower_read_at(p, &f, entry, members[0].offset, members[0].ty) ?? return true
    same :: lower_flag(&f)
    lower_call_runtime(&m, &f, "jet_rt_string_eq", [LIRValueID]{key, name}, Val(same))
    lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(hit, [LIRValueID]{}), else_target: lower_target(next_block, [LIRValueID]{})})
    lower_start(&f, next_block, [LIRValueID]{})
    one :: lower_const(&f, 1)
    following :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: following, op: LIRBinaryOp.Add, left: at, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{following})})
    // Hit: Ok(clone of the borrowed entry value).
    lower_start(&f, hit, [LIRValueID]{})
    value :: lower_read_at(p, &f, entry, members[1].offset, members[1].ty) ?? return true
    cloned :: lower_pointer(&f)
    lower_clone_into(p, &m, &f, value, cloned, ty)
    found :: lower_pointer(&f)
    lower_alloc(&m, &f, found, lower_box_size(p, result_ty))
    ok_tag :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Store{base: found, offset: 0, value: ok_tag})
    lower_write_at(p, &f, found, lower_result_payload_offset(), cloned, ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{found})})
    // Miss: the canonical runtime FieldError (and the same lookup) on a tree.
    lower_start(&f, miss, [LIRValueID]{})
    runtime :: lower_dyn_to_runtime(p, &m, &f, ty, tree) ?? return true
    out :: lower_route_result_call(&m, &f, route.export, [LIRValueID]{runtime, name}, ok, err)
    lower_call_runtime(&m, &f, "jet_rt_handle_drop_dyn", [LIRValueID]{runtime}, None)
    failed :: lower_pointer(&f)
    lower_alloc(&m, &f, failed, lower_box_size(p, result_ty))
    lower_emit(&f, LIRInst.Store{base: failed, offset: 0, value: out.word})
    succeeded :: lower_flag(&f)
    none :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: out.word, right: none})
    ok_block :: lower_new_block(&f)
    err_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(ok_block, [LIRValueID]{}), else_target: lower_target(err_block, [LIRValueID]{})})
    lower_start(&f, ok_block, [LIRValueID]{})
    lower_route_store_payload(p, &m, &f, failed, lower_result_payload_offset(), ty, ok, out.slot, route.native_lists)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{failed})})
    lower_start(&f, err_block, [LIRValueID]{})
    lower_route_store_payload(p, &m, &f, failed, lower_result_payload_offset(), errors, err, out.slot, route.native_lists)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{failed})})
    joined :: dst ?? lower_pointer(&f)
    lower_start(&f, merge, [LIRValueID]{joined})
    if dst == None -> lower_map_drop_value(p, &m, &f, joined, result_ty)
    true
}


// `tree.to_text()` (JetStd/Dyn.rs to_text): Null, Array and Object are None
// without touching the tree; a scalar leaf (O(1) to build) asks the runtime
// leaf for its Show text. False when the checked types do not match.
fn lower_dyn_to_text(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, route: LowerRoute, args: [MIRValueID]) -> Bool Never! {
    if args.len() != 1 -> return false
    ty :: lower_value_type(c, args[0]) ?? return false
    if !lower_dyn_type(p, ty) -> return false
    result_ty :: lower_checked_type(c, instruction) ?? return false
    if !lower_route_shape_matches(p, result_ty, route.result) -> return false
    some :: if route.result == { .Option(payload) -> { payload } else -> { return false } }
    inner :: if result_ty.kind == { .Option(payload) -> { payload } else -> { return false } }
    definition :: lower_type_def(p, ty) ?? return false
    tree :: lower_use(&m, &f, args[0]) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction)
    if f.failed -> return true
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: tree, offset: 0})
    leaf :: lower_new_block(&f)
    none_block :: lower_new_block(&f)
    merge :: lower_new_block(&f)
    loop variant in ([String]{"Null", "Array", "Object"}) {
        found :: lower_variant(definition, variant) ?? return true
        expected :: lower_const(&f, lower_discriminant(found.index))
        same :: lower_flag(&f)
        lower_emit(&f, LIRInst.Compare{dst: same, condition: LIRCondition.Eq, left: selector, right: expected})
        other :: lower_new_block(&f)
        lower_seal(&f, LIRTerminator.Branch{condition: same, then_target: lower_target(none_block, [LIRValueID]{}), else_target: lower_target(other, [LIRValueID]{})})
        lower_start(&f, other, [LIRValueID]{})
    }
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(leaf, [LIRValueID]{})})
    lower_start(&f, leaf, [LIRValueID]{})
    runtime :: lower_dyn_to_runtime(p, &m, &f, ty, tree) ?? return true
    out :: lower_route_tagged_call(&m, &f, route.export, [LIRValueID]{runtime}, 1)
    lower_call_runtime(&m, &f, "jet_rt_handle_drop_dyn", [LIRValueID]{runtime}, None)
    zero :: lower_const(&f, 0)
    present :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: present, condition: LIRCondition.Ne, left: out.word, right: zero})
    some_block :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: present, then_target: lower_target(some_block, [LIRValueID]{}), else_target: lower_target(none_block, [LIRValueID]{})})
    lower_start(&f, some_block, [LIRValueID]{})
    box :: lower_pointer(&f)
    lower_alloc(&m, &f, box, lower_box_size(p, result_ty))
    lower_route_store_payload(p, &m, &f, box, 0, inner, some, out.slot, route.native_lists)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{box})})
    lower_start(&f, none_block, [LIRValueID]{})
    null :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Const{dst: null, value: 0})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{null})})
    joined :: dst ?? lower_pointer(&f)
    lower_start(&f, merge, [LIRValueID]{joined})
    if dst == None -> lower_map_drop_value(p, &m, &f, joined, result_ty)
    true
}
