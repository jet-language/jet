// The checked Dyn remains a Jet enum. Runtime routes borrow an opaque
// runtime tree only at their boundary; this descriptor describes storage,
// never validation or codec policy (D-EXEC1/I9).
// Requested checked codec implementations are lowered by Codecs.jet.
// No unwired runtime/container codec policy is retained here.
use jet_foundation.[
    MIRInstruction, MIRLocalID, MIRNominalRef, MIRProgram, MIRType, MIRTypeKind,
    mir_type_display_name, mir_type_from_kind,
]

fn lower_dyn_type(p: MIRProgram, ty: MIRType) -> Bool Never! {
    definition :: lower_type_def(p, ty) ?? return false
    if definition.kind == .Alias(base) -> return lower_dyn_type(p, base)
    definition.key == "Dyn" && definition.name == "Dyn"
}

fn lower_dyn_program_type(p: MIRProgram) -> MIRType? Never! {
    loop definition in p.types {
        if definition.key == "Dyn" && definition.name == "Dyn" {
            return Val(mir_type_from_kind(MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.name}, args: [MIRType]{}}))
        }
    }
    None
}


// Two header words [node bytes, row count], followed by rows indexed by the
// runtime variant's semantic identity, not by the checked declaration order.
// Each row is [tag, payload offset, boxed, payload bytes, element stride,
// key offset, value offset, element bytes]. A list is [len, cap, data].
fn lower_dyn_schema(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType) -> LIRValueID? {
    key :: "$native.dyn:{lower_mono_fingerprint(ty)}"
    id := LIRDataID{value: -1}
    if m.static_rows.get(key) == .Val(row) {
        id = LIRDataID{value: row}
    } else {
        definition :: lower_type_def(p, ty) ?? {
            lower_fail(&m, &f, "Dyn marshaling has no checked definition")
            return None
        }
        if !lower_dyn_type(p, ty) {
            lower_fail(&m, &f, "Dyn marshaling of {mir_type_display_name(ty)} has the wrong owner")
            return None
        }
        if definition.kind == .Enum(_, _) {} else {
            lower_fail(&m, &f, "Dyn marshaling requires the checked enum")
            return None
        }
        names :: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}
        words := [Int]{lower_enum_box_size(p, definition), names.len()}
        loop name in names {
            found :: lower_variant(definition, name) ?? {
                lower_fail(&m, &f, "Dyn marshaling has no {name} variant")
                return None
            }
            offset := 0
            boxed := 0
            bytes := 0
            stride := 0
            key_offset := 0
            value_offset := 0
            element_bytes := 0
            if name != "Null" {
                info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? {
                    lower_fail(&m, &f, "Dyn.{name} marshaling has no payload layout")
                    return None
                }
                offset = info.offset
                boxed = if info.boxed -> 1 else -> 0
                bytes = lower_size(p, info.ty).size
                if name == "Bytes" || name == "Array" || name == "Object" {
                    elem :: lower_list_element(info.ty) ?? {
                        lower_fail(&m, &f, "Dyn.{name} marshaling requires a List payload")
                        return None
                    }
                    stride = lower_list_stride(p, elem)
                    element_bytes = lower_size(p, elem).size
                    if name == "Object" {
                        members :: lower_inline_members(p, elem)
                        if members.len() != 2 || members[0].name != "key" || members[1].name != "value" {
                            lower_fail(&m, &f, "Dyn.Object marshaling requires checked key/value entries")
                            return None
                        }
                        key_offset = members[0].offset
                        value_offset = members[1].offset
                    }
                }
            }
            schema_words :: [Int]{lower_discriminant(found.index), offset, boxed, bytes, stride, key_offset, value_offset, element_bytes}
            loop word in schema_words -> &words.push(word)
        }
        id = lower_static_object(&m, words.len() * 8)
        loop (index, word) in words -> lower_static_store(&m, id, index * 8, lower_static_word(word))
        &m.static_rows.add(key, id.value).drop("schema absent above")
    }
    address :: lower_pointer(&f)
    lower_emit(&f, LIRInst.DataAddress{dst: address, data: id})
    Val(address)
}

fn lower_dyn_to_runtime(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, value: LIRValueID) -> LIRValueID? {
    schema :: lower_dyn_schema(p, &m, &f, ty) ?? return None
    result :: lower_pointer(&f)
    lower_call_runtime(&m, &f, "jet_rt_dyn_from_native", [LIRValueID]{schema, value}, Val(result))
    Val(result)
}

fn lower_dyn_from_runtime(p: MIRProgram, m: &LowerModule, f: &LowerFunction, ty: MIRType, value: LIRValueID, dst: LIRValueID) Never! {
    schema :: lower_dyn_schema(p, &m, &f, ty) ?? return
    lower_call_runtime(&m, &f, "jet_rt_dyn_to_native", [LIRValueID]{schema, value}, Val(dst))
    lower_call_runtime(&m, &f, "jet_rt_handle_drop_Dyn", [LIRValueID]{value}, None)
}

