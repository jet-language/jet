// Which carried slots each MIR block needs on entry: backward liveness over
// the slots' places, so a block's parameters and every edge into it carry only
// those slots instead of every slot. Lowering then grows with the live values,
// not with blocks × slots (a many-variant enum's derived decode has over a
// thousand blocks and as many temporaries).
//
// A block uses a slot when an instruction names one of its places (reads,
// moves, projected writes, replacements, addresses, receiver and call-argument
// places, require diagnostics' locals) before the block
// defines it; a whole-root WritePlace, or the value a temporary or parameter
// place stands for, defines it. A borrowed read of a slot's place (no
// consumer takes it, so it names the slot's value) is a use of the slot
// wherever that value or a member or copy of it may still be used
// (lower_live_aliases): the slot holds the value until then. A slot no later
// block uses is not carried, so an edge never passes it; the entry still
// starts every slot as its placeholder (Lower.jet lower_clear_slot).
use jet_foundation.[
    MIRCallArg, MIRFunction, MIROperation, MIRPlaceID, MIRScopeKind, MIRSemanticOp, MIRValueID, mir_operation_place_uses,
    mir_operation_value_uses, mir_terminator_value_uses,
]

LOWER_LIVE_BITS :: prep { 48 }

fn lower_live_empty(words: Int) -> [Int] Never! {
    row := [Int]{}
    loop _ in 0..<words -> &row.push(0)
    row
}

fn lower_live_has(bits: [Int], slot: Int) -> Bool Never! {
    ((bits[slot /% LOWER_LIVE_BITS] >> (slot % LOWER_LIVE_BITS)).bit_and(1)) == 1
}

fn lower_live_set(bits: &[Int], slot: Int) Never! {
    word :: slot /% LOWER_LIVE_BITS
    bits[word] = bits[word].bit_or((1 << (slot % LOWER_LIVE_BITS)))
}

fn lower_call_arg_places(args: [MIRCallArg]) -> [MIRPlaceID] Never! {
    places := [MIRPlaceID]{}
    loop arg in args {
        if arg.place == .Val(place) -> &places.push(place)
    }
    places
}

fn lower_semantic_places(semantic: MIRSemanticOp) -> [MIRPlaceID] Never! {
    if semantic == {
        .StaticPreludeCall(_, args, _, _) | .HardwareCall(_, _, _, args) | .ClosureMethod(_, args, _) | .AllocNew(_, _, _, args) | .HostCall(_, args) -> lower_call_arg_places(args)
        .CursorTakePattern(_, place, _) | .ReaderTakePattern(_, place, _) -> [MIRPlaceID]{place}
        else -> [MIRPlaceID]{}
    }
}

// Every place `operation` names: mir_operation_place_uses plus call-argument
// places (a Write argument lends its place) and pattern receivers.
fn lower_instruction_places(operation: MIROperation) -> [MIRPlaceID] Never! {
    places := mir_operation_place_uses(operation)
    extra := [MIRPlaceID]{}
    if operation == {
        .Call(_, args, _) | .IndirectCall(_, args, _) -> extra = lower_call_arg_places(args)
        .CoreCall(_, _, args, _, _, _) -> extra = lower_call_arg_places(args)
        .Semantic(semantic) -> extra = lower_semantic_places(semantic)
        else -> {}
    }
    loop place in extra -> &places.push(place)
    places
}

// Per MIR block position: the carried slots live on entry, ascending. Blocks
// outside `order` (unreachable) need none.
fn lower_live_slots(function: MIRFunction, slots: [LowerSlot], place_slots: [U64:Int], local_slots: [U64:Int], defined_slots: [U64:Int], sunk: [U64:Bool], successors: [[Int]], order: [Int]) -> [[Int]] Never! {
    words :: (slots.len() + LOWER_LIVE_BITS - 1) /% LOWER_LIVE_BITS
    roots := [U64:Bool]{}
    // A place's projection operands (an index, a range, a map key) are read
    // whenever an instruction names the place.
    place_operands := [U64:[MIRValueID]]{}
    loop place in function.places {
        if place.projections.len() == 0 -> _ := &roots.add(place.id.value, true)
        operands :: lower_release_projection_operands(place)
        if operands.len() > 0 -> _ := &place_operands.add(place.id.value, operands)
    }
    aliases :: lower_live_aliases(function, slots, place_slots, sunk)
    uses := [[Int]]{}
    defs := [[Int]]{}
    loop block in function.blocks {
        used := lower_live_empty(words)
        defined := lower_live_empty(words)
        loop instruction in block.instructions {
            if instruction.operation == .Phi(_) {
                // A phi's value is the block's own parameter: it defines the
                // temporary place standing for it before any use, so the slot
                // is never also carried in (which would override the phi).
                if instruction.result == .Val(result) {
                    if defined_slots.get(result.value) == .Val(slot) {
                        if slots[slot].carried -> lower_live_set(&defined, slot)
                    }
                }
                next
            }
            killed := -1
            if instruction.operation == .WritePlace(place, _) {
                if roots.get(place.value) != None -> killed = place_slots.get(place.value) ?? -1
            }
            touched := [Int]{}
            loop place in lower_instruction_places(instruction.operation) {
                slot :: place_slots.get(place.value) ?? next
                if slot != killed -> &touched.push(slot)
            }
            // ScopeExit implicitly consumes only the generated Stm local.
            // Its owner must survive the transaction body's block edges.
            if instruction.operation == .ScopeExit(scope) {
                loop row in function.scopes {
                    if row.id == scope && row.kind == .Transaction && row.name != None {
                        if lower_stm_local(function, row) == .Val(local) {
                            if local_slots.get(local.id.value) == .Val(slot) -> &touched.push(slot)
                        }
                    }
                }
            }
            if instruction.operation == .Semantic(semantic) {
                if semantic == .RequireStop(_, _, _, _, context, _, _) {
                    loop local in context.locals {
                        slot :: local_slots.get(local.local.value) ?? next
                        &touched.push(slot)
                    }
                }
            }
            if aliases.len() > 0 {
                loop value in lower_live_operands(instruction.operation, place_operands) {
                    if aliases.get(value.value) == .Val(slot) -> &touched.push(slot)
                }
            }
            loop slot in touched {
                if slots[slot].carried && !lower_live_has(defined, slot) -> lower_live_set(&used, slot)
            }
            if killed >= 0 && slots[killed].carried -> lower_live_set(&defined, killed)
            if instruction.result == .Val(result) {
                if defined_slots.get(result.value) == .Val(slot) {
                    if slots[slot].carried -> lower_live_set(&defined, slot)
                }
            }
        }
        if aliases.len() > 0 {
            loop value in mir_terminator_value_uses(block.terminator) {
                if aliases.get(value.value) == .Val(slot) {
                    if slots[slot].carried && !lower_live_has(defined, slot) -> lower_live_set(&used, slot)
                }
            }
        }
        &uses.push(used)
        &defs.push(defined)
    }
    // live_in = use ∪ (live_out − def), to a fixed point, sinks first.
    live := [[Int]]{}
    loop _ in function.blocks -> &live.push(lower_live_empty(words))
    changed := true
    loop changed {
        changed = false
        index := order.len() - 1
        loop index >= 0 {
            position :: order[index]
            out := lower_live_empty(words)
            loop target in successors[position] {
                loop word in 0..<words -> out[word] = out[word].bit_or(live[target][word])
            }
            row := [Int]{}
            loop word in 0..<words {
                kept :: out[word] - (out[word].bit_and(defs[position][word]))
                &row.push(uses[position][word].bit_or(kept))
            }
            if row != live[position] {
                live[position] = row
                changed = true
            }
            index -= 1
        }
    }
    // Set bits only, ascending: an empty word costs one test, not one per slot.
    rows := [[Int]]{}
    loop bits in live {
        row := [Int]{}
        loop word in 0..<words {
            set :: bits[word]
            if set == 0 -> next
            base :: word * LOWER_LIVE_BITS
            loop bit in 0..<LOWER_LIVE_BITS {
                if base + bit >= slots.len() -> break
                if ((set >> bit).bit_and(1)) == 1 -> &row.push(base + bit)
            }
        }
        &rows.push(row)
    }
    rows
}

// The values an instruction reads: its operands and the projection operands
// of the places it names.
fn lower_live_operands(operation: MIROperation, place_operands: [U64:[MIRValueID]]) -> [MIRValueID] Never! {
    values := lower_operand_values(operation)
    if place_operands.len() == 0 -> return values
    loop place in lower_instruction_places(operation) {
        operands :: place_operands.get(place.value) ?? next
        loop operand in operands -> &values.push(operand)
    }
    values
}

// MIR value -> the carried slot whose value it may name: a borrowed read
// (ReadPlace or AddressOf no consumer takes, lower_release_place_kind) of any
// place of the slot, and, transitively, a member, element, slice, copy or
// move of such a value (any of which may point into it). Phis are left out:
// the release plan keeps a slot whose read a phi merges.
fn lower_live_aliases(function: MIRFunction, slots: [LowerSlot], place_slots: [U64:Int], sunk: [U64:Bool]) -> [U64:Int] Never! {
    aliases := [U64:Int]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            if sunk.get(result.value) != None -> next
            read := MIRPlaceID{value: U64.MAX}
            if instruction.operation == {
                .ReadPlace(place) -> read = place
                .AddressOf(place, _) -> read = place
                else -> next
            }
            slot :: place_slots.get(read.value) ?? next
            if slots[slot].carried -> _ := &aliases.add(result.value, slot)
        }
    }
    if aliases.len() == 0 -> return aliases
    // Member reads follow their base in block order except across a loop's
    // back edge; a second pass picks those up, a third their own members.
    loop _ in 0..<3 {
        grew := false
        loop block in function.blocks {
            loop instruction in block.instructions {
                result :: instruction.result ?? next
                if aliases.get(result.value) != None || !lower_live_alias_operation(instruction.operation) -> next
                loop value in mir_operation_value_uses(instruction.operation) {
                    if aliases.get(value.value) == .Val(slot) {
                        _ := &aliases.add(result.value, slot)
                        grew = true
                        break
                    }
                }
            }
        }
        if !grew -> break
    }
    aliases
}

// Operations whose result may point into an operand (lower_release_use_kind's
// LOWER_RELEASE_ALIAS uses, and borrowed member reads).
fn lower_live_alias_operation(operation: MIROperation) -> Bool Never! {
    if operation == {
        .Field(_, _) | .EnumPayload(_, _, _, _) | .OptionValue(_) | .ResultValue(_, _) | .ProjectMembers(_, _) | .Index(_, _, _, _, _, _, _) -> true
        .Slice(_, _, _, _, _, _) | .Copy(_, _) | .Move(_) -> true
        else -> false
    }
}
