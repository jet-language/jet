// Collection callback adapters. The parallel range scheduler is a raw runtime
// leaf; all typed storage, ownership and result propagation stays in Jet.
use jet_foundation.[MIRCallArg, MIRInstruction, MIROperation, MIRPreludeCall, MIRProgram, MIRType, MIRTypeKind, MIRValueID, mir_type_from_kind]

struct LowerParallelShape {
    pub input: MIRType
    pub output: MIRType
}

fn lower_parallel_shape(ty: MIRType) -> LowerParallelShape? Never! {
    if ty.kind == {
        .Fn(signature) -> {
            if signature.params.len() != 1 -> return None
            output :: signature.ret ?? return None
            Val(LowerParallelShape{input: signature.params[0], output: output})
        }
        .SendFn(params, ret, _) -> {
            if params.len() != 1 -> return None
            output :: ret ?? return None
            Val(LowerParallelShape{input: params[0], output: output})
        }
        else -> None
    }
}

// The caller lends the closure and input buffer through the joined range
// walk. Output slots are disjoint, written once, and become owned afterwards.
// env: closure at 0, input data at 8, output data at 16.
fn lower_parallel_walk(p: MIRProgram, m: &LowerModule, f: &LowerFunction, closure: LIRValueID, closure_ty: MIRType, list: LIRValueID, output: LIRValueID, limit: LIRValueID) Never! {
    env :: lower_pointer(&f)
    lower_emit(&f, LIRInst.StackSlot{dst: env, size: 24, align: 8})
    lower_emit(&f, LIRInst.Store{base: env, offset: 0, value: closure})
    lower_emit(&f, LIRInst.Store{base: env, offset: 8, value: lower_list_data(&f, list)})
    lower_emit(&f, LIRInst.Store{base: env, offset: 16, value: output})
    invoke :: lower_lazy_helper_address(&m, &f, "para.map.invoke", closure_ty)
    length :: lower_list_word(&f, list, 0)
    lower_call_runtime(&m, &f, "jet_rt_native_para_walk", [LIRValueID]{length, limit, env, invoke}, None)
}

fn lower_helper_parallel_map(p: MIRProgram, m: &LowerModule, glue: LowerGlue) -> LIRFunction Never! {
    shape :: lower_parallel_shape(glue.ty) ?? panic("parallel callback has a checked single-input type")
    f := lower_helper_start(&m, glue, [LIRLayout]{lir_layout_pointer(), lir_layout_word(), lir_layout_word()}, None)
    env :: ~f.open_params[0]
    begin :: ~f.open_params[1]
    end :: ~f.open_params[2]
    closure :: lower_pointer(&f)
    input :: lower_pointer(&f)
    output :: lower_pointer(&f)
    lower_emit(&f, LIRInst.Load{dst: closure, base: env, offset: 0})
    lower_emit(&f, LIRInst.Load{dst: input, base: env, offset: 8})
    lower_emit(&f, LIRInst.Load{dst: output, base: env, offset: 16})
    head :: lower_new_block(&f)
    body :: lower_new_block(&f)
    done :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{begin})})
    index :: lower_word(&f)
    lower_start(&f, head, [LIRValueID]{index})
    more :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: more, condition: LIRCondition.Lt, left: index, right: end})
    lower_seal(&f, LIRTerminator.Branch{condition: more, then_target: lower_target(body, [LIRValueID]{}), else_target: lower_target(done, [LIRValueID]{})})
    lower_start(&f, body, [LIRValueID]{})
    source :: lower_list_address(&f, input, index, lower_list_stride(p, shape.input))
    target :: lower_list_address(&f, output, index, lower_list_stride(p, shape.output))
    item :: lower_read_at(p, &f, source, 0, shape.input) ?? panic("parallel input has storage")
    value :: lower_call_closure_box(p, &m, &f, closure, [LIRValueID]{item}, shape.output) ?? panic("parallel output has storage")
    // List Bool slots cross raw word-carrier boundaries; keep their padding
    // deterministic even though the Bool itself is a one-byte value.
    if shape.output.kind == .Bool -> lower_emit(&f, LIRInst.Store{base: target, offset: 0, value: lower_const(&f, 0)})
    lower_write_at(p, &f, target, 0, value, shape.output)
    one :: lower_const(&f, 1)
    next_index :: lower_word(&f)
    lower_emit(&f, LIRInst.Binary{dst: next_index, op: LIRBinaryOp.Add, left: index, right: one})
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(head, [LIRValueID]{next_index})})
    lower_start(&f, done, [LIRValueID]{})
    lower_seal(&f, LIRTerminator.Return{value: None})
    lir_builder_finish(f.builder)
}

fn lower_parallel_method(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg], row: MIRPreludeCall) -> Bool Never! {
    symbol :: lower_runtime_symbol(row)
    if symbol != "jet_list_para_map" && symbol != "jet_list_try_map" -> return false
    if symbol == "jet_list_try_map" {
        lower_closure_try_map(p, c, &m, &f, instruction, receiver, args)
        return true
    }
    if args.len() != 2 {
        lower_fail(&m, &f, "para_map requires its checked closure and worker limit")
        return true
    }
    closure_arg :: args[0]
    closure_ty :: lower_value_type(c, closure_arg.value) ?? {
        lower_fail(&m, &f, "para_map closure has no checked type")
        return true
    }
    shape :: lower_parallel_shape(closure_ty) ?? {
        lower_fail(&m, &f, "para_map closure has no checked single-input type")
        return true
    }
    if lower_repr(p, shape.input) == .Absent || lower_repr(p, shape.output) == .Absent {
        lower_fail(&m, &f, "para_map requires stored input and output elements")
        return true
    }
    if lower_task_stop_body(p, c, m, closure_arg.value) {
        lower_fail(&m, &f, "parallel callback with a checked stop across native frames is not lowered at O0 yet")
        return true
    }
    list_ty :: lower_value_type(c, receiver) ?? {
        lower_fail(&m, &f, "para_map receiver has no checked type")
        return true
    }
    result_ty :: lower_checked_type(c, instruction) ?? {
        lower_fail(&m, &f, "para_map result has no checked type")
        return true
    }
    list :: lower_use(&m, &f, receiver) ?? return true
    closure :: lower_use(&m, &f, closure_arg.value) ?? return true
    limit :: lower_use(&m, &f, args[1].value) ?? return true
    dst :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
    lower_storage_into(p, &f, dst, result_ty)
    length :: lower_list_word(&f, list, 0)
    data :: lower_list_buffer(&m, &f, length, lower_list_stride(p, shape.output))
    lower_parallel_walk(p, &m, &f, closure, closure_ty, list, data, limit)
    lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: length})
    lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
    lower_map_drop_value(p, &m, &f, list, list_ty)
    if closure_arg.access == .Move -> lower_map_drop_value(p, &m, &f, closure, closure_ty)
    if instruction.result == None -> lower_map_drop_value(p, &m, &f, dst, result_ty)
    true
}

// try_map stops at the first Err, drops the already-produced prefix and every
// unused owned input, and transfers the exact error to the enclosing Result.
fn lower_closure_try_map(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, receiver: MIRValueID, args: [MIRCallArg]) Never! {
    if args.len() != 1 -> return lower_fail(&m, &f, "try_map requires one checked callback")
    list_ty :: lower_value_type(c, receiver) ?? return lower_fail(&m, &f, "try_map receiver has no checked type")
    elem :: lower_list_element(list_ty) ?? return lower_fail(&m, &f, "try_map receiver is not a List")
    result_ty :: lower_checked_type(c, instruction) ?? return lower_fail(&m, &f, "try_map result has no checked type")
    if result_ty.kind != .Result(_, _) -> return lower_fail(&m, &f, "try_map result is not a Result")
    out_ty :: if result_ty.kind == .Result(ok, _) -> ok else -> panic("checked Result")
    err_ty :: if result_ty.kind == .Result(_, err) -> err else -> panic("checked Result")
    produced :: lower_list_element(out_ty) ?? return lower_fail(&m, &f, "try_map success is not a List")
    closure_arg :: args[0]
    closure_ty :: lower_value_type(c, closure_arg.value) ?? return lower_fail(&m, &f, "try_map callback has no checked type")
    shape :: lower_parallel_shape(closure_ty) ?? return lower_fail(&m, &f, "try_map callback has no checked single-input type")
    callback_result :: shape.output
    if callback_result.kind != .Result(_, _) -> return lower_fail(&m, &f, "try_map callback does not return a Result")
    list :: lower_use(&m, &f, receiver) ?? return
    closure :: lower_use(&m, &f, closure_arg.value) ?? return
    output :: lower_new_storage(p, &f, out_ty)
    zero :: lower_const(&f, 0)
    lower_emit(&f, LIRInst.Store{base: output, offset: 0, value: zero})
    lower_emit(&f, LIRInst.Store{base: output, offset: 8, value: zero})
    lower_emit(&f, LIRInst.Store{base: output, offset: 16, value: zero})
    box :: lower_result(p, c, &m, &f, instruction) ?? lower_pointer(&f)
    lower_alloc(&m, &f, box, lower_box_size(p, result_ty))
    merge :: lower_new_block(&f)
    each :: lower_each_begin(p, &f, list, elem, [LIRValueID]{})
    item :: lower_read_at(p, &f, each.address, 0, elem) ?? return lower_fail(&m, &f, "try_map input has no stored value")
    outcome :: lower_call_closure_box(p, &m, &f, closure, [LIRValueID]{item}, callback_result) ?? return
    selector :: lower_word(&f)
    lower_emit(&f, LIRInst.Load{dst: selector, base: outcome, offset: 0})
    succeeded :: lower_flag(&f)
    lower_emit(&f, LIRInst.Compare{dst: succeeded, condition: LIRCondition.Ne, left: selector, right: zero})
    success :: lower_new_block(&f)
    failure :: lower_new_block(&f)
    lower_seal(&f, LIRTerminator.Branch{condition: succeeded, then_target: lower_target(success, [LIRValueID]{}), else_target: lower_target(failure, [LIRValueID]{})})
    lower_start(&f, failure, [LIRValueID]{})
    lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: zero})
    lower_list_move(p, &f, lower_address(&f, box, 8), lower_address(&f, outcome, 8), err_ty)
    lower_free_shell(&m, &f, outcome, lower_box_size(p, callback_result))
    lower_map_drop_value(p, &m, &f, output, out_ty)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, success, [LIRValueID]{})
    value :: lower_read_at(p, &f, outcome, 8, produced) ?? return lower_fail(&m, &f, "try_map output has no stored value")
    lower_call_helper(&m, &f, "list.push", out_ty, [LIRValueID]{output, value}, None)
    lower_free_shell(&m, &f, outcome, lower_box_size(p, callback_result))
    lower_each_end(&f, each, [LIRValueID]{})
    one :: lower_const(&f, 1)
    lower_emit(&f, LIRInst.Store{base: box, offset: 0, value: one})
    lower_copy_bytes(&f, box, 8, output, lower_size(p, out_ty).size)
    lower_seal(&f, LIRTerminator.Jump{target: lower_target(merge, [LIRValueID]{})})
    lower_start(&f, merge, [LIRValueID]{})
    lower_map_drop_value(p, &m, &f, list, list_ty)
    if closure_arg.access == .Move -> lower_map_drop_value(p, &m, &f, closure, closure_ty)
    if instruction.result == None -> lower_map_drop_value(p, &m, &f, box, result_ty)
}

// These routes consume their receiver and moved callback. Owned reads from a
// stable place must acquire their own value before an adapter drops it.
fn lower_parallel_stored_operands(p: MIRProgram, operation: MIROperation) -> [MIRValueID] Never! {
    stored := [MIRValueID]{}
    if operation == .Semantic(.ClosureMethod(receiver, args, call)) {
        row :: lower_prelude_row(p, call) ?? return stored
        symbol :: lower_runtime_symbol(row)
        if symbol != "jet_list_para_map" && symbol != "jet_list_try_map" -> return stored
        &stored.push(receiver)
        loop arg in args {
            if arg.access == .Move -> &stored.push(arg.value)
        }
    }
    stored
}
