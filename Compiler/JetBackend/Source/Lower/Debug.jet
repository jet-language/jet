// Debug facts for the DWARF the object writer emits (LIR.jet "Debug facts",
// Image/Dwarf.jet): the source line of every instruction, the parameters and
// named locals of every lowered function with the LIR values that carry
// them, and their types described by the value layouts of Values.jet.
//
// A type is described in its stored form, the bytes a value of it occupies
// in a frame slot, a field or a box: an inline aggregate (struct, tuple,
// List or Map header) is its bytes; a payload enum or Result is a pointer to
// its box (tag word, then the variant payloads in a union); an Option is a
// pointer to the box holding its value (null for None); a runtime handle is
// a pointer to an opaque type; a closure is an untyped pointer. A variable
// whose type is an inline aggregate is carried by the address of its bytes,
// so its location is that memory (LIRDebugVariable.indirect).
use jet_foundation.[
    MIRBasicBlock,
    MIRInstruction,
    MIRProgram,
    MIRSourceFileID,
    MIRType,
    MIRTypeDef,
    MIRTypeKind,
    MIRVariant,
    Span,
    mir_type_canonical_key,
    mir_type_display_name,
    mir_type_from_kind,
]

// ---------------------------------------------------------------------------
// Source lines.

// The debug file row of a MIR source file, -1 when the program has none.
fn lower_debug_file(p: MIRProgram, m: &LowerModule, file: MIRSourceFileID) -> Int Never! {
    if m.debug_file_rows.get(file.value) == .Val(row) -> return row
    path :: lower_source_path(p, m, file)
    if path == "" -> return -1
    row :: m.debug_files.len()
    &m.debug_files.push(path)
    &m.debug_file_rows.add(file.value, row).drop("checked absent above")
    row
}

// The line of `span` in `file`; 0 for the empty span of generated code.
fn lower_debug_span_line(p: MIRProgram, m: &LowerModule, file: MIRSourceFileID, span: Span) -> Int Never! {
    if span.start == 0 && span.end == 0 -> return 0
    lower_source_line(p, &m, file, span.start)
}

fn lower_debug_instruction_line(p: MIRProgram, c: LowerContext, m: &LowerModule, instruction: MIRInstruction) -> Int Never! {
    instruction.source_line ?? lower_debug_span_line(p, &m, c.mir.source_file, instruction.span)
}

// Instructions lowered for `instruction` take its line; one without a
// location keeps the current line.
fn lower_debug_line(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction) Never! {
    if f.builder.debug.file < 0 -> return
    line :: lower_debug_instruction_line(p, c, &m, instruction)
    if line > 0 -> f.builder.line = line
}

// A block's parameters and slot setup take the line of its first located
// instruction (a block's own span can cover a whole loop statement).
fn lower_debug_block_line(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, block: MIRBasicBlock) Never! {
    if f.builder.debug.file < 0 -> return
    loop instruction in block.instructions {
        if instruction.operation == .Phi(_) -> next
        line :: lower_debug_instruction_line(p, c, &m, instruction)
        if line > 0 {
            f.builder.line = line
            return
        }
    }
}

// ---------------------------------------------------------------------------
// Variables.

// The function's debug facts: its source name, file and line; its
// parameters (variable i is MIR parameter i), then the named locals with a
// carried slot. Per slot, the variable its values carry (f.debug_slots).
// Generated functions without a source file keep lir_function_debug_none.
fn lower_debug_function(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction) Never! {
    function :: c.mir
    file :: lower_debug_file(p, &m, function.source_file)
    if file < 0 -> return
    line :: lower_debug_span_line(p, &m, function.source_file, function.span)
    variables := [LIRDebugVariable]{}
    loop param in function.params -> &variables.push(lower_debug_variable(p, &m, function.source_file, param.name, param.span, param.ty, true))
    // The MIR value a Parameter instruction defines -> its parameter position.
    parameters := [U64:Int]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Parameter(index, _) {
                if instruction.result == .Val(result) -> _ := &parameters.add(result.value, index)
            }
        }
    }
    locals := [U64:Int]{}
    loop (index, local) in function.locals -> _ := &locals.add(local.id.value, index)
    slots := [Int]{}
    loop row in c.slots {
        variable := -1
        if row.carried {
            if row.base == {
                .Parameter(value) -> {
                    index :: parameters.get(value.value) ?? -1
                    if index >= 0 && index < function.params.len() -> variable = index
                }
                .Local(local) -> {
                    if locals.get(local.value) == .Val(index) {
                        declared :: function.locals[index]
                        if declared.name != "" && !declared.is_comptime {
                            variable = variables.len()
                            &variables.push(lower_debug_variable(p, &m, function.source_file, declared.name, declared.span, row.ty, false))
                        }
                    }
                }
                else -> {}
            }
        }
        &slots.push(variable)
    }
    f.debug_slots = slots
    f.builder.debug = LIRFunctionDebug{name: function.name, file: file, line: line, variables: variables, bindings: [LIRDebugBinding]{}}
    f.builder.line = line
}

fn lower_debug_variable(p: MIRProgram, m: &LowerModule, file: MIRSourceFileID, name: String, span: Span, ty: MIRType, parameter: Bool) -> LIRDebugVariable Never! {
    LIRDebugVariable{name: name, ty: lower_debug_type(p, &m, ty), line: lower_debug_span_line(p, &m, file, span), parameter: parameter, indirect: lower_is_inline(p, ty)}
}

// `value` now carries the variable of `slot`, if it has one.
fn lower_debug_bind(f: &LowerFunction, slot: Int, value: LIRValueID) Never! {
    if slot >= f.debug_slots.len() -> return
    variable :: f.debug_slots[slot].copy()
    if variable >= 0 -> lower_debug_bind_variable(&f, variable, value)
}

fn lower_debug_bind_variable(f: &LowerFunction, variable: Int, value: LIRValueID) Never! {
    if variable >= f.builder.debug.variables.len() -> return
    &f.builder.debug.bindings.push(LIRDebugBinding{variable: variable, value: value})
}

// ---------------------------------------------------------------------------
// Types.

// The debug type row of `ty`, described once per canonical type. The row is
// reserved before its description, so recursive types refer to themselves.
fn lower_debug_type(p: MIRProgram, m: &LowerModule, ty: MIRType) -> Int Never! {
    key :: mir_type_canonical_key(ty)
    if m.debug_type_rows.get(key) == .Val(row) -> return row
    row :: lower_debug_reserve(&m, key)
    described :: lower_debug_describe(p, &m, ty)
    m.debug_types[row] = described
    row
}

fn lower_debug_reserve(m: &LowerModule, key: String) -> Int Never! {
    row :: m.debug_types.len()
    &m.debug_types.push(LIRDebugType{name: "", size: 0, kind: LIRDebugTypeKind.Opaque})
    &m.debug_type_rows.add(key, row).drop("checked absent above")
    row
}

// A pointer to `target` (-1: untyped).
fn lower_debug_pointer(m: &LowerModule, target: Int) -> Int Never! {
    key :: "pointer:{target}"
    if m.debug_type_rows.get(key) == .Val(row) -> return row
    row :: lower_debug_reserve(&m, key)
    m.debug_types[row] = LIRDebugType{name: "", size: 8, kind: LIRDebugTypeKind.Pointer{target: target}}
    row
}

// A runtime-owned object with no described contents.
fn lower_debug_opaque(m: &LowerModule, name: String) -> Int Never! {
    key :: "opaque:{name}"
    if m.debug_type_rows.get(key) == .Val(row) -> return row
    row :: lower_debug_reserve(&m, key)
    m.debug_types[row] = LIRDebugType{name: name, size: 0, kind: LIRDebugTypeKind.Opaque}
    row
}

fn lower_debug_int(p: MIRProgram, m: &LowerModule) -> Int Never! {
    lower_debug_type(p, &m, mir_type_from_kind(MIRTypeKind.Int))
}

fn lower_debug_describe(p: MIRProgram, m: &LowerModule, ty: MIRType) -> LIRDebugType Never! {
    name :: lower_debug_type_name(p, ty)
    if ty.kind == .Apply(_, _) {
        if lower_type_def(p, ty) == .Val(definition) {
            if definition.kind == {
                .Distinct(base, _) -> return LIRDebugType{name: name, size: lower_size(p, base).size, kind: LIRDebugTypeKind.Typedef{target: lower_debug_type(p, &m, base)}}
                .Alias(target) -> return LIRDebugType{name: name, size: lower_size(p, target).size, kind: LIRDebugTypeKind.Typedef{target: lower_debug_type(p, &m, target)}}
                else -> {}
            }
        }
    }
    if lower_repr(p, ty) == {
        .Absent -> LIRDebugType{name: name, size: 0, kind: LIRDebugTypeKind.Opaque}
        .Word -> lower_debug_word(name, ty)
        .ExactInt -> LIRDebugType{name: "", size: 8, kind: LIRDebugTypeKind.Pointer{target: lower_debug_opaque(&m, name)}}
        .FloatBits -> LIRDebugType{name: name, size: 8, kind: LIRDebugTypeKind.Base{encoding: LIRDebugEncoding.Float}}
        .Float32Bits -> LIRDebugType{name: name, size: 4, kind: LIRDebugTypeKind.Base{encoding: LIRDebugEncoding.Float}}
        .Flag -> LIRDebugType{name: name, size: 1, kind: LIRDebugTypeKind.Base{encoding: LIRDebugEncoding.Bool}}
        .Handle(_, _) -> LIRDebugType{name: "", size: 8, kind: LIRDebugTypeKind.Pointer{target: lower_debug_opaque(&m, name)}}
        .Boxed(boxed) -> LIRDebugType{name: "", size: 8, kind: LIRDebugTypeKind.Pointer{target: lower_debug_box(p, &m, name, boxed)}}
        .Inline(aggregate) -> lower_debug_inline(p, &m, name, aggregate)
        .Discriminant -> LIRDebugType{name: name, size: 8, kind: LIRDebugTypeKind.Enum{enumerators: lower_debug_enumerators(p, ty)}}
        .Unsupported(_) -> LIRDebugType{name: name, size: 0, kind: LIRDebugTypeKind.Opaque}
    }
}

// A one-word scalar: Int, Char, a fixed-width integer, or one of them
// under a tag, range or quantity.
fn lower_debug_word(name: String, ty: MIRType) -> LIRDebugType Never! {
    if ty.kind == {
        .Char -> LIRDebugType{name: name, size: 4, kind: LIRDebugTypeKind.Base{encoding: LIRDebugEncoding.Char}}
        .IntN(signed, bits) -> LIRDebugType{name: name, size: (bits + 7).div_euclid(8), kind: LIRDebugTypeKind.Base{encoding: if signed -> LIRDebugEncoding.Signed else -> LIRDebugEncoding.Unsigned}}
        .Tagged(_, inner) -> lower_debug_word(name, inner)
        .InlineRange(base, _, _) -> lower_debug_word(name, base)
        .Quantity(base, _) -> lower_debug_word(name, base)
        else -> LIRDebugType{name: name, size: 8, kind: LIRDebugTypeKind.Base{encoding: LIRDebugEncoding.Signed}}
    }
}

// Variant names and discriminants (lower_discriminant) of an enum type.
fn lower_debug_enumerators(p: MIRProgram, ty: MIRType) -> [LIRDebugEnumerator] Never! {
    enumerators := [LIRDebugEnumerator]{}
    definition :: lower_type_def(p, ty) ?? return enumerators
    if definition.kind == .Enum(variants, _) {
        loop (index, variant) in variants -> &enumerators.push(LIRDebugEnumerator{name: variant.name, value: lower_discriminant(index)})
    }
    enumerators
}

// The members of an inline aggregate at their offsets; a List, Map or view
// is its [len, cap, data] header.
fn lower_debug_inline(p: MIRProgram, m: &LowerModule, name: String, aggregate: MIRType) -> LIRDebugType Never! {
    if lower_sequence_element(aggregate) == .Val(elem) -> return lower_debug_list(p, &m, name, elem)
    members := [LIRDebugMember]{}
    loop member in lower_inline_members(p, aggregate) {
        if lower_repr(p, member.ty) == .Absent -> next
        &members.push(LIRDebugMember{name: member.name, offset: member.offset, ty: lower_debug_type(p, &m, lower_member_storage_type(member))})
    }
    LIRDebugType{name: name, size: lower_inline_size(p, aggregate), kind: LIRDebugTypeKind.Struct{members: members}}
}

// `data` points at elements `lower_list_stride` bytes apart: the element
// type itself when it fills its stride, else a slot struct of that size.
fn lower_debug_list(p: MIRProgram, m: &LowerModule, name: String, elem: MIRType) -> LIRDebugType Never! {
    stride :: lower_list_stride(p, elem)
    element := lower_debug_type(p, &m, elem)
    if lower_size(p, elem).size != stride {
        key :: "slot:{mir_type_canonical_key(elem)}"
        element = m.debug_type_rows.get(key) ?? lower_debug_slot(p, &m, key, elem, element, stride)
    }
    word :: lower_debug_int(p, &m)
    data :: lower_debug_pointer(&m, element)
    members :: [LIRDebugMember]{
        LIRDebugMember{name: "len", offset: 0, ty: word},
        LIRDebugMember{name: "cap", offset: 8, ty: word},
        LIRDebugMember{name: "data", offset: 16, ty: data},
    }
    LIRDebugType{name: name, size: 24, kind: LIRDebugTypeKind.Struct{members: members}}
}

// The type a Boxed value's pointer points at (-1: undescribed, as for
// closures and iterator cursors).
fn lower_debug_box(p: MIRProgram, m: &LowerModule, name: String, ty: MIRType) -> Int Never! {
    if ty.kind == {
        .Option(inner) -> return lower_debug_type(p, &m, inner)
        .Result(ok, err) -> return lower_debug_result_box(p, &m, name, ty, ok, err)
        else -> {}
    }
    definition :: lower_type_def(p, ty) ?? return -1
    if definition.kind == {
        .Enum(variants, _) -> lower_debug_enum_box(p, &m, name, ty, definition, variants)
        else -> -1
    }
}

// A slot struct of `stride` bytes holding one list element at offset 0.
fn lower_debug_slot(p: MIRProgram, m: &LowerModule, key: String, elem: MIRType, element: Int, stride: Int) -> Int Never! {
    row :: lower_debug_reserve(&m, key)
    m.debug_types[row] = LIRDebugType{name: "{lower_debug_type_name(p, elem)} slot", size: stride, kind: LIRDebugTypeKind.Struct{members: [LIRDebugMember]{LIRDebugMember{name: "value", offset: 0, ty: element}}}}
    row
}

// A box: the discriminant word (type `discriminant`), then a union of the
// payloads at offset 8.
fn lower_debug_tagged_box(m: &LowerModule, row: Int, name: String, size: Int, discriminant: Int, cases: [LIRDebugMember]) Never! {
    payload :: m.debug_types.len()
    &m.debug_types.push(LIRDebugType{name: "", size: size - 8, kind: LIRDebugTypeKind.Union{members: cases}})
    members :: [LIRDebugMember]{LIRDebugMember{name: "tag", offset: 0, ty: discriminant}, LIRDebugMember{name: "payload", offset: 8, ty: payload}}
    m.debug_types[row] = LIRDebugType{name: name, size: size, kind: LIRDebugTypeKind.Struct{members: members}}
}

// A payload enum's box: its discriminant, then each variant's stored
// members (lower_variant_members) as one struct per variant.
fn lower_debug_enum_box(p: MIRProgram, m: &LowerModule, name: String, ty: MIRType, definition: MIRTypeDef, variants: [MIRVariant]) -> Int Never! {
    key :: "box:{mir_type_canonical_key(ty)}"
    if m.debug_type_rows.get(key) == .Val(found) -> return found
    row :: lower_debug_reserve(&m, key)
    discriminant :: m.debug_types.len()
    &m.debug_types.push(LIRDebugType{name: "{name}.Variant", size: 8, kind: LIRDebugTypeKind.Enum{enumerators: lower_debug_enumerators(p, ty)}})
    cases := [LIRDebugMember]{}
    loop variant in variants {
        placed :: lower_variant_members(p, definition, variant)
        if placed.len() == 0 -> next
        members := [LIRDebugMember]{}
        loop member in placed {
            if lower_repr(p, member.ty) == .Absent -> next
            &members.push(LIRDebugMember{name: member.name, offset: member.offset - 8, ty: lower_debug_type(p, &m, lower_member_storage_type(member))})
        }
        payload :: m.debug_types.len()
        &m.debug_types.push(LIRDebugType{name: "{name}.{variant.name}", size: lower_members_end(p, placed, 8) - 8, kind: LIRDebugTypeKind.Struct{members: members}})
        &cases.push(LIRDebugMember{name: variant.name, offset: 0, ty: payload})
    }
    lower_debug_tagged_box(&m, row, name, lower_enum_box_size(p, definition), discriminant, cases)
    row
}

// A Result box: tag 1 is Ok, 0 is Err; the payload follows at offset 8.
fn lower_debug_result_box(p: MIRProgram, m: &LowerModule, name: String, ty: MIRType, ok: MIRType, err: MIRType) -> Int Never! {
    key :: "box:{mir_type_canonical_key(ty)}"
    if m.debug_type_rows.get(key) == .Val(found) -> return found
    row :: lower_debug_reserve(&m, key)
    discriminant :: m.debug_type_rows.get("result-tag") ?? lower_debug_result_tag(&m)
    cases := [LIRDebugMember]{}
    if lower_repr(p, ok) != .Absent -> &cases.push(LIRDebugMember{name: "ok", offset: 0, ty: lower_debug_type(p, &m, ok)})
    if lower_repr(p, err) != .Absent -> &cases.push(LIRDebugMember{name: "err", offset: 0, ty: lower_debug_type(p, &m, err)})
    lower_debug_tagged_box(&m, row, name, lower_result_box_size(p, ok, err), discriminant, cases)
    row
}

fn lower_debug_result_tag(m: &LowerModule) -> Int Never! {
    row :: lower_debug_reserve(&m, "result-tag")
    m.debug_types[row] = LIRDebugType{name: "Result.Tag", size: 8, kind: LIRDebugTypeKind.Enum{enumerators: [LIRDebugEnumerator]{LIRDebugEnumerator{name: "Err", value: 0}, LIRDebugEnumerator{name: "Ok", value: 1}}}}
    row
}

// Source-like type names: a declaration's own name (not its module key),
// with its type arguments.
fn lower_debug_type_name(p: MIRProgram, ty: MIRType) -> String Never! {
    if ty.kind == {
        .List(inner) -> "[{lower_debug_type_name(p, inner)}]"
        .Map(key, value) -> "[{lower_debug_type_name(p, key)}:{lower_debug_type_name(p, value)}]"
        .Option(inner) -> "{lower_debug_type_name(p, inner)}?"
        .Result(ok, err) -> "Result<{lower_debug_type_name(p, ok)}, {lower_debug_type_name(p, err)}>"
        .Tuple(fields) -> {
            names := [String]{}
            loop field in fields -> &names.push(lower_debug_type_name(p, field.ty))
            "({names.join(", ")})"
        }
        .Tagged(_, inner) -> lower_debug_type_name(p, inner)
        .Apply(name, args) -> {
            base :: if lower_type_def(p, ty) == .Val(definition) -> lower_debug_short_name(definition.name) else -> lower_debug_short_name(name.name)
            if args.len() == 0 -> return base
            names := [String]{}
            loop arg in args -> &names.push(lower_debug_type_name(p, arg))
            "{base}<{names.join(", ")}>"
        }
        else -> mir_type_display_name(ty)
    }
}

// The last segment of a module-qualified name (`.::structs.jet::Point`,
// `<corelib>/time::Duration`).
fn lower_debug_short_name(name: String) -> String Never! {
    parts := name.split("::").to_list()
    last :: &parts.pop() ?? name
    pieces := last.split("/").to_list()
    &pieces.pop() ?? last
}
