// Literal constants use exactly the runtime constructor layouts and build
// owned trees. Module Global constants borrow frozen data in Statics.jet.
use jet_foundation.[
    MIRConstant,
    MIRConstantDef,
    MIRConstEnumArg,
    MIRConstField,
    MIRInstruction,
    MIRProgram,
    MIRType,
    MIRTypeDef,
]
use core.math as math

fn lower_constant_field(fields: [MIRConstField], name: String) -> MIRConstant? Never! {
    loop field in fields {
        if field.name == name -> return Val(field.value)
    }
    None
}

fn lower_constant_arg(args: [MIRConstEnumArg], name: String) -> MIRConstant? Never! {
    loop arg in args {
        if arg.name == .Val(label) {
            if label == name -> return Val(arg.value)
        }
    }
    None
}

fn lower_constant_owner(definition: MIRTypeDef, ty: MIRType, name: String) -> Bool Never! {
    if name == definition.key || name == definition.name -> return true
    if ty.kind == .Apply(nominal, _) -> return name == nominal.name
    false
}

// Unit has no machine value, including inside an allocated aggregate. An
// inline member's bytes are copied into the parent, just as lower_store_value.
fn lower_constant_store(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, boxed: LIRValueID, offset: Int, ty: MIRType, constant: MIRConstant) Never! {
    value :: lower_constant_tree(p, c, &m, &f, ty, constant) ?? return
    lower_write_at(p, &f, boxed, offset, value, ty)
}

// Used before lower_result too: unsupported collection layouts must not hide
// which constant form was rejected.
fn lower_constant_reject(m: &LowerModule, f: &LowerFunction, constant: MIRConstant) -> Bool Never! {
    name :: if constant == {
        .Bytes(_) -> "Bytes"
        .Map(_) -> "Map"
        else -> ""
    }
    if name == "" -> return false
    lower_fail(&m, &f, "{name} constants are not lowered at O0 yet")
    true
}

// An exact Int constant: an inline word, or beyond the inline range a runtime
// big integer, built at use from the word (jet_int_owned_from_i64, as the
// exact conversion of Convert.jet) or from its decimal text.
fn lower_exact_int_constant(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, value: Int) Never! {
    if lower_int_inline(value) -> return lower_emit(&f, LIRInst.Const{dst: dst, value: value})
    raw :: lower_const(&f, value)
    lower_call_runtime(&m, &f, "jet_int_owned_from_i64", [LIRValueID]{raw}, Val(dst))
}

fn lower_big_int_constant(m: &LowerModule, f: &LowerFunction, dst: LIRValueID, decimal: String) Never! {
    args :: lower_static_text(&m, &f, decimal)
    lower_call_runtime(&m, &f, "jet_rt_int_from_static", args, Val(dst))
}

fn lower_constant_tree(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, ty: MIRType, constant: MIRConstant) -> LIRValueID? {
    lower_constant_tree_value(p, c, &m, &f, ty, constant, None)
}

fn lower_constant_tree_value(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, ty: MIRType, constant: MIRConstant, result: LIRValueID?) -> LIRValueID? {
    if lower_constant_reject(&m, &f, constant) -> return None
    if ty.kind == {
        .Tagged(_, inner) -> return lower_constant_tree_value(p, c, &m, &f, inner, constant, result)
        .InlineRange(base, _, _) -> return lower_constant_tree_value(p, c, &m, &f, base, constant, result)
        .Quantity(base, _) -> return lower_constant_tree_value(p, c, &m, &f, base, constant, result)
        .Apply(_, _) -> {
            if lower_type_def(p, ty) == .Val(definition) {
                if definition.kind == {
                    .Alias(target) -> return lower_constant_tree_value(p, c, &m, &f, target, constant, result)
                    .Distinct(base, _) -> return lower_constant_tree_value(p, c, &m, &f, base, constant, result)
                    else -> {}
                }
            }
        }
        else -> {}
    }
    if constant == .Unit -> return None
    repr :: lower_repr(p, ty)
    if repr == .Unsupported(reason) {
        lower_fail(&m, &f, "{reason} is not lowered at O0 yet")
        return None
    }
    layout :: lower_repr_layout(repr) ?? return None
    // Reuse an instruction's ownership-typed destination when supplied. Nested
    // values transfer to the parent's slots and are dropped only by its glue.
    dst :: result ?? lower_new_value(&f, layout, lower_drop(&m, repr, true), ty.identity)
    if constant == {
        .Int(value, _, _) -> {
            if lower_is_exact_int(ty) -> lower_exact_int_constant(&m, &f, dst, value)
            else -> lower_emit(&f, LIRInst.Const{dst: dst, value: value})
        }
        .BigInt(decimal) -> {
            if !lower_is_exact_int(ty) {
                lower_fail(&m, &f, "BigInt constant of a non-Int type is not lowered at O0 yet")
                return None
            }
            lower_big_int_constant(&m, &f, dst, decimal)
        }
        .Bool(value) -> lower_emit(&f, LIRInst.Const{dst: dst, value: if value -> 1 else -> 0})
        .Char(value) -> lower_emit(&f, LIRInst.Const{dst: dst, value: value})
        .Float(value, f32, _) -> {
            if f32 {
                lower_fail(&m, &f, "Float32 values are not lowered at O0 yet")
                return None
            }
            lower_emit(&f, LIRInst.Const{dst: dst, value: math.to_bits(value)})
        }
        .String(value) -> {
            args :: lower_static_text(&m, &f, value)
            lower_call_runtime(&m, &f, "jet_rt_string_from_static", args, Val(dst))
        }
        .Struct(name, fields) -> {
            definition :: lower_type_def(p, ty) ?? {
                lower_fail(&m, &f, "Struct constant {name} without a definition is not lowered at O0 yet")
                return None
            }
            if !lower_constant_owner(definition, ty, name) {
                lower_fail(&m, &f, "Struct constant {name} as {definition.name} is not lowered at O0 yet")
                return None
            }
            declared :: if definition.kind == .Struct(rows, _) -> lower_stored_fields(rows) else -> {
                lower_fail(&m, &f, "Struct constant {name} with a non-struct type is not lowered at O0 yet")
                return None
            }
            lower_storage_into(p, &f, dst, ty)
            // MIRRust.rs:typed_struct_constant (:29305): look up by name,
            // not constant order, and omit computed members entirely.
            loop field in declared {
                // MIRRust.rs:typed_struct_constant (:29309) adds a separate
                // recursive edge box; the ordinary O0 constructor has none.
                loop edge in definition.boxed_edges {
                    if edge == field.name {
                        lower_fail(&m, &f, "boxed Struct constant edges are not lowered at O0 yet")
                        return None
                    }
                }
                value :: lower_constant_field(fields, field.name) ?? {
                    lower_fail(&m, &f, "Struct constant {name} without field {field.name} is not lowered at O0 yet")
                    return None
                }
                found :: lower_struct_field(p, ty, field.id) ?? return None
                lower_constant_store(p, c, &m, &f, dst, found.offset, found.ty, value)
                if f.failed -> return None
            }
        }
        .Enum(name, variant, args) -> {
            definition :: lower_type_def(p, ty) ?? {
                lower_fail(&m, &f, "Enum constant {name} without a definition is not lowered at O0 yet")
                return None
            }
            if !lower_constant_owner(definition, ty, name) {
                lower_fail(&m, &f, "Enum constant {name} as {definition.name} is not lowered at O0 yet")
                return None
            }
            found :: lower_variant(definition, variant) ?? {
                lower_fail(&m, &f, "Enum constant {name}.{variant} without a variant is not lowered at O0 yet")
                return None
            }
            selector :: lower_discriminant(found.index)
            if repr == .Discriminant {
                lower_emit(&f, LIRInst.Const{dst: dst, value: selector})
            } else {
                lower_alloc(&m, &f, dst, lower_enum_box_size(p, definition))
                lower_store_word(&f, dst, 0, selector)
                if found.variant.payload == {
                    .Unit -> {}
                    .Single(inner) -> {
                        if args.len() != 1 || args[0].name != None {
                            lower_fail(&m, &f, "Enum constant {name}.{variant} without one positional payload is not lowered at O0 yet")
                            return None
                        }
                        info :: lower_enum_payload_info(p, definition, found.variant, 0) ?? return None
                        lower_constant_payload(p, c, &m, &f, dst, info, args[0].value)
                    }
                    .Named(fields) -> {
                        // MIRRust.rs:typed_enum_constant (:29425): named
                        // payloads are matched to declaration fields by label.
                        loop (index, field) in fields {
                            if field.computed -> next
                            value :: lower_constant_arg(args, field.name) ?? {
                                lower_fail(&m, &f, "Enum constant {name}.{variant} without field {field.name} is not lowered at O0 yet")
                                return None
                            }
                            info :: lower_enum_payload_info(p, definition, found.variant, index) ?? return None
                            lower_constant_payload(p, c, &m, &f, dst, info, value)
                            if f.failed -> return None
                        }
                    }
                }
            }
        }
        .Present(value) -> {
            // MIRRust.rs:constant_for_type (:29473-29484): Present is Ok
            // for both Option and Result, but their native boxes differ.
            if ty.kind == {
                .Option(inner) -> {
                    lower_alloc(&m, &f, dst, lower_option_box_size(p, inner))
                    lower_constant_store(p, c, &m, &f, dst, 0, inner, value)
                }
                .Result(ok, err) -> {
                    lower_alloc(&m, &f, dst, lower_result_box_size(p, ok, err))
                    lower_store_word(&f, dst, 0, 1)
                    lower_constant_store(p, c, &m, &f, dst, 8, ok, value)
                }
                else -> {
                    lower_fail(&m, &f, "Present constant without an Option or Result type is not lowered at O0 yet")
                    return None
                }
            }
        }
        .List(values) -> {
            // The header and element buffer lower_build_list makes.
            elem :: lower_list_element(ty) ?? {
                lower_fail(&m, &f, "List constant without a List type is not lowered at O0 yet")
                return None
            }
            stride :: lower_list_stride(p, elem)
            lower_storage_into(p, &f, dst, ty)
            count :: lower_const(&f, values.len())
            lower_emit(&f, LIRInst.Store{base: dst, offset: 0, value: count})
            lower_emit(&f, LIRInst.Store{base: dst, offset: 8, value: count})
            data :: lower_pointer(&f)
            if values.len() == 0 {
                lower_emit(&f, LIRInst.Const{dst: data, value: 0})
            } else {
                lower_alloc(&m, &f, data, stride * values.len())
            }
            lower_emit(&f, LIRInst.Store{base: dst, offset: 16, value: data})
            loop (index, value) in values {
                lower_constant_store(p, c, &m, &f, data, stride * index, elem, value)
                if f.failed -> return None
            }
        }
        .Failed(report) -> {
            if ty.kind == .Result(ok, err) && report == .Told(value) {
                lower_alloc(&m, &f, dst, lower_result_box_size(p, ok, err))
                lower_store_word(&f, dst, 0, 0)
                lower_constant_store(p, c, &m, &f, dst, 8, err, value)
            } else if lower_option_inner(ty) != None && report == .Clean(_) {
                // A clean failure of an Option is None (MIRRust.rs constant_for_type).
                lower_emit(&f, LIRInst.Const{dst: dst, value: 0})
            } else {
                lower_fail(&m, &f, "Failed constant without a Result Told payload is not lowered at O0 yet")
                return None
            }
        }
        else -> {
            lower_fail(&m, &f, "this constant form is not lowered at O0 yet")
            return None
        }
    }
    if f.failed -> return None
    Val(dst)
}

fn lower_constant_into(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, instruction: MIRInstruction, constant: MIRConstant, dst: LIRValueID) Never! {
    ty :: lower_checked_type(c, instruction) ?? return
    _ := lower_constant_tree_value(p, c, &m, &f, ty, constant, Val(dst))
}

fn lower_global_definition(p: MIRProgram, name: String) -> MIRConstantDef? Never! {
    // A fully qualified key wins over a coincidentally matching short name.
    loop constant in p.constants {
        if constant.key == name -> return Val(constant)
    }
    loop constant in p.constants {
        if constant.name == name -> return Val(constant)
    }
    None
}

// MIRRust.rs:typed_enum_constant (:29399, :29430): a declared recursive
// edge adds a wrapper allocation, distinct from the child's own value.
fn lower_constant_payload(p: MIRProgram, c: LowerContext, m: &LowerModule, f: &LowerFunction, dst: LIRValueID, info: LowerPayloadInfo, constant: MIRConstant) Never! {
    if info.boxed {
        wrapper :: lower_pointer(&f)
        lower_alloc(&m, &f, wrapper, lower_option_box_size(p, info.ty))
        lower_constant_store(p, c, &m, &f, wrapper, 0, info.ty, constant)
        if f.failed -> return
        lower_emit(&f, LIRInst.Store{base: dst, offset: info.offset, value: wrapper})
    } else {
        lower_constant_store(p, c, &m, &f, dst, info.offset, info.ty, constant)
    }
}
