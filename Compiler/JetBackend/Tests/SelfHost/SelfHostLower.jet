// Self-host probe driver (NativeSelfHostProbe): lowers the Jet compiler's own
// checked MIR (the `.mird` stream selfmird.mjs writes from a JET_DUMP_MIR
// dump) through the native backend and records EVERY blocker in one run:
// preparation (Mono/Reach) issues without stopping at the first one, every
// function's lowering issues, then object/link errors once lowering is clean.
// assemble-lower.mjs assembles it with the MIR schema, the backend and the
// generated decoder; its copy of Mono.jet keeps going past preparation issues.
//
// Environment: SELFHOST_MIRD (input stream), SELFHOST_OUT (output prefix),
// SELFHOST_PACK (runtime pack, optional), SELFHOST_SKIP (file of function
// names an earlier run crashed in, one per line, optional).
// Outputs: <out>.issues (function \t message), <out>.progress (one line per
// function started, so a crash names its function), <out>.slow (functions
// taking >= 500 ms), <out>.stats, and with clean lowering <out>.o,
// <out>.object-issues, <out>.exe / <out>.link-issues.
use core.files as sh_files
use core.math as math
use core.sys as sh_sys
use core.time as sh_time

// The stream as bytes and a cursor: no per-line String list (a compiler-sized
// stream has ~10^8 tokens).
struct MIRDReader {
    bytes: [U8]
    at: Int
    line: Int
}

// The current token's end (its newline, or the end of the stream).
fn mird_end(r: &MIRDReader) -> Int {
    if r.at >= r.bytes.len() -> panic("MIR stream ends at line {r.line}")
    end := r.at
    loop end < r.bytes.len() && r.bytes[end] != (U8{10}) -> end += 1
    end
}

fn mird_next(r: &MIRDReader) -> String {
    end :: mird_end(&r)
    text :: String.from_bytes(r.bytes[r.at..<end]) ?? panic("MIR stream line {r.line} is not UTF-8")
    r.at = end + 1
    r.line = r.line + 1
    text
}

fn mird_int(r: &MIRDReader) -> Int {
    text :: mird_next(&r)
    Int.parse(text) ?? panic("MIR stream line {r.line}: `{text}` is not an integer")
}

fn mird_u64(r: &MIRDReader) -> U64 {
    text :: mird_next(&r)
    value :: Int.parse(text) ?? panic("MIR stream line {r.line}: `{text}` is not an integer")
    U64.from_int(value) ?? panic("MIR stream line {r.line}: `{text}` is not a U64")
}

fn mird_bool(r: &MIRDReader) -> Bool {
    mird_int(&r) != 0
}

fn mird_float(r: &MIRDReader) -> Float {
    math.from_bits(mird_int(&r))
}

fn mird_hex(digit: U8) -> Int {
    if digit >= 97 -> return digit - 87
    digit - 48
}

// `s<text>` holds the text itself; `x<hex>` its UTF-8 bytes in hex.
fn mird_string(r: &MIRDReader) -> String {
    end :: mird_end(&r)
    start :: r.at
    r.at = end + 1
    r.line = r.line + 1
    if end == start -> panic("MIR stream line {r.line}: empty string token")
    if r.bytes[start] == (U8{115}) -> return String.from_bytes(r.bytes[(start + 1)..<end]) ?? panic("MIR stream line {r.line}: string is not UTF-8")
    bytes := [U8]{}
    i := start + 1
    loop i + 1 < end {
        &bytes.push(U8{mird_hex(r.bytes[i]) * 16 + mird_hex(r.bytes[i + 1])})
        i = i + 2
    }
    String.from_bytes(bytes) ?? panic("MIR stream line {r.line}: string is not UTF-8")
}

struct SHInput {
    entry: MIRFunctionID
    program: MIRProgram
}

fn sh_env(name: String) -> String {
    value :: sh_sys.get(name) ?? panic("{name} is not set")
    "{value}"
}

fn sh_note(out: String, suffix: String, line: String) {
    sh_files.append_all("{out}.{suffix}", "{line}\n") ?? panic("cannot append to {out}.{suffix}")
}

// The stream bytes stay local, so they are freed once the program is decoded.
fn sh_decode(path: String) -> SHInput {
    r := MIRDReader{bytes: sh_files.read_bytes(path) ?? panic("cannot read {path}"), at: 0, line: 0}
    entry :: mird_u64(&r)
    SHInput{entry: MIRFunctionID{value: entry}, program: mird_mir_program(&r)}
}

fn sh_skips() -> [String:Bool] {
    skips := [String:Bool]{}
    path :: sh_sys.get("SELFHOST_SKIP") ?? return skips
    text :: sh_files.read("{path}") ?? return skips
    loop line in text.split("\n").to_list() {
        if line != "" -> _ := &skips.add("{line}", true)
    }
    skips
}

fn sh_placeholder(id: LIRFunctionID, name: String, signature: LIRSignatureID) -> LIRFunction {
    LIRFunction{id: id, name: name, signature: signature, values: [LIRValue]{}, blocks: [LIRBlock]{}, debug: lir_function_debug_none()}
}

fn sh_glue_name(glue: LowerGlue) -> String {
    "glue:{glue.helper}/{glue.clone}/{glue.key}"
}

fn sh_write_lines(path: String, lines: [String]) {
    text :: if lines.len() == 0 -> "" else -> "{lines.join("\n")}\n"
    sh_files.write(path, text) ?? panic("cannot write {path}")
}

fn sh_flush_issues(out: String, m: &LowerModule, from: Int) -> Int {
    if m.issues.len() <= from -> return from
    lines := [String]{}
    index := from
    loop index < m.issues.len() {
        &lines.push("{m.issues[index].function}\t{m.issues[index].message}")
        index += 1
    }
    sh_files.append_all("{out}.partial-issues", "{lines.join("\n")}\n") ?? panic("cannot append to {out}.partial-issues")
    m.issues.len()
}

// SELFHOST_ROOTS=all, or a file of decimal MIR function ids: every listed
// non-generic, non-foreign function is requested as a root besides the entry
// (package slices lower code the entry may not reach).
fn sh_request_roots(program: MIRProgram, q: &LowerPrepared, out: String) {
    spec :: sh_sys.get("SELFHOST_ROOTS") ?? return
    ids := [U64]{}
    if spec == "all" {
        loop function in program.functions -> &ids.push(function.id.value)
    } else {
        text :: sh_files.read("{spec}") ?? panic("cannot read SELFHOST_ROOTS {spec}")
        loop line in text.split("\n").to_list() {
            if line == "" -> next
            value :: Int.parse(line) ?? panic("SELFHOST_ROOTS line `{line}` is not an integer")
            &ids.push(U64.from_int(value) ?? panic("SELFHOST_ROOTS line `{line}` is not a U64"))
        }
    }
    requested := 0
    loop value in ids {
        id :: MIRFunctionID{value: value}
        row :: q.source_rows.get(value) ?? next
        if lower_mono_template(program, q, id) -> next
        function :: program.functions[row]
        if function.kind == MIRFunctionKind.Foreign -> next
        owner :: if function.form == {
            .TopLevel -> MIRType?{None}
            .Method(ty, _) | .TraitMethod(ty, _, _, _) -> Val(ty)
        }
        lower_mono_request(program, &q, id, owner, [MIRType]{}, -1, "root").drop("root request")
        requested += 1
    }
    sh_note(out, "stats", "roots_requested\t{requested}")
}

fn run() {
    out :: sh_env("SELFHOST_OUT")
    skips :: sh_skips()
    watch :: sh_time.start()
    input :: sh_decode(sh_env("SELFHOST_MIRD"))
    program :: input.program
    sh_note(out, "stats", "decode_ms\t{watch.elapsed_millis()}")
    sh_note(out, "stats", "mir_functions\t{program.functions.len()}")
    sh_note(out, "stats", "mir_types\t{program.types.len()}")

    // Preparation exactly as lower_prepare_entry, except that the entry is
    // requested even after an index issue and (assemble-lower.mjs) the queue
    // keeps going and keeps its inventory: every preparation issue at once.
    prep_watch :: sh_time.start()
    prepared := lower_mono_empty()
    lower_mono_index(program, &prepared)
    prepared.entry = lower_mono_request(program, &prepared, input.entry, None, [MIRType]{}, -1, "entry")
    sh_request_roots(program, &prepared, out)
    lower_mono_run(program, &prepared)
    sh_note(out, "stats", "prepare_ms\t{prep_watch.elapsed_millis()}")
    sh_note(out, "stats", "prepared_functions\t{prepared.functions.len()}")
    sh_note(out, "stats", "prepared_instances\t{prepared.instances.len()}")
    sh_note(out, "stats", "prepare_issues\t{prepared.issues.len()}")
    issues := [String]{}
    loop issue in prepared.issues -> &issues.push("{issue.function}\tprepare: {issue.message}")
    sh_write_lines("{out}.prepare-issues", issues)

    m := LowerModule{
        signatures: [LIRSignature]{},
        signature_rows: [String:Int]{},
        data: [LIRData]{},
        data_rows: [String:Int]{},
        static_rows: [String:Int]{},
        static_fixups: [LowerStaticFixup]{},
        source_rows: [U64:Int]{},
        mir_rows: [U64:Int]{},
        mir_sources: [Int]{},
        mir_signatures: [LIRSignatureID]{},
        mir_results: [Int]{},
        glue_base: prepared.functions.len(),
        glue: [LowerGlue]{},
        glue_rows: [String:Int]{},
        issues: [LIRLoweringIssue]{},
    }
    loop (index, file) in program.source_files {
        if m.source_rows.get(file.id.value) == None -> &m.source_rows.add(file.id.value, index).drop("checked absent above")
    }
    loop (index, descriptor) in prepared.functions {
        &m.mir_rows.add(descriptor.id.value, index).drop("concrete IDs are unique")
        &m.mir_sources.push(descriptor.source_row)
        signature :: if descriptor.instance_row >= 0 -> lower_function_signature(program, &m, prepared.instances[descriptor.instance_row]) else -> lower_function_signature(program, &m, program.functions[descriptor.source_row])
        &m.mir_signatures.push(signature)
    }
    sh_note(out, "stats", "signatures_ms\t{prep_watch.elapsed_millis()}")
    functions := [LIRFunction]{}
    // Issues are also appended to <out>.partial-issues as they appear, so a
    // run stopped by a timeout or OOM still reports what it found.
    flushed := 0
    lower_watch :: sh_time.start()
    loop (index, descriptor) in prepared.functions {
        signature :: m.mir_signatures[index].copy()
        id :: LIRFunctionID{value: index}
        if skips.get(descriptor.name) != None {
            &m.issues.push(LIRLoweringIssue{function: descriptor.name, message: "probe: lowering crashed in an earlier run"})
            &functions.push(sh_placeholder(id, descriptor.name, signature))
            next
        }
        sh_note(out, "progress", "fn\t{index}\t{descriptor.name}")
        started :: sh_time.start()
        function :: if descriptor.instance_row >= 0 -> lower_function(program, &m, prepared.instances[descriptor.instance_row], id, signature) else -> lower_function(program, &m, program.functions[descriptor.source_row], id, signature)
        took :: started.elapsed_millis()
        if took >= 500 -> sh_note(out, "slow", "{took}\t{descriptor.name}")
        &functions.push(function)
        flushed = sh_flush_issues(out, &m, flushed)
    }
    sh_note(out, "stats", "lower_ms\t{lower_watch.elapsed_millis()}")
    lowered_entry := LIRFunctionID?{None}
    if prepared.entry == .Val(id) {
        if m.mir_rows.get(id.value) == .Val(row) -> lowered_entry = Val(lower_entry_id(program, &m, row))
    }
    // Glue and helpers may register more, so the list grows while it is walked.
    glue_watch :: sh_time.start()
    cursor := 0
    loop cursor < m.glue.len() {
        glue :: m.glue[cursor].copy()
        name :: sh_glue_name(glue)
        if skips.get(name) != None {
            &m.issues.push(LIRLoweringIssue{function: name, message: "probe: glue lowering crashed in an earlier run"})
            &functions.push(sh_placeholder(glue.id, name, LIRSignatureID{value: 0}))
        } else {
            sh_note(out, "progress", "glue\t{cursor}\t{name}")
            if glue.helper != "" {
                &functions.push(lower_helper_function(program, &m, glue))
            } else if glue.clone {
                &functions.push(lower_clone_glue_function(program, &m, glue))
            } else {
                &functions.push(lower_glue_function(program, &m, glue))
            }
        }
        flushed = sh_flush_issues(out, &m, flushed)
        cursor += 1
    }
    sh_note(out, "stats", "glue_ms\t{glue_watch.elapsed_millis()}")
    sh_note(out, "stats", "glue_functions\t{m.glue.len()}")
    lowered :: LIRModule{signatures: m.signatures.copy(), functions: functions, data: m.data.copy(), debug: LIRModuleDebug{directory: "", files: m.debug_files.copy(), types: m.debug_types.copy()}}
    loop issue in m.issues -> &issues.push("{issue.function}\t{issue.message}")
    if issues.len() == 0 {
        loop issue in lir_lint_module(lowered) -> &issues.push("{issue.function}\tLIR lint b{issue.block}: {issue.message}")
    }
    sh_note(out, "stats", "issues\t{issues.len()}")
    sh_write_lines("{out}.issues", issues)
    if issues.len() > 0 -> return
    entry :: lowered_entry ?? panic("clean lowering lost the entry")
    object_watch :: sh_time.start()
    object :: x64_relocatable_object(lowered, entry)
    sh_note(out, "stats", "object_ms\t{object_watch.elapsed_millis()}")
    if object.errors.len() > 0 {
        sh_write_lines("{out}.object-issues", object.errors)
        return
    }
    sh_files.write_bytes("{out}.o", object.bytes) ?? panic("cannot write {out}.o")
    pack_path :: sh_sys.get("SELFHOST_PACK") ?? return
    pack :: sh_files.read_bytes("{pack_path}") ?? panic("cannot read the runtime pack {pack_path}")
    link_watch :: sh_time.start()
    linked :: x64_link_executable([String]{"{out}.o", "{pack_path}"}, ^[[U8]]{object.bytes, pack})
    sh_note(out, "stats", "link_ms\t{link_watch.elapsed_millis()}")
    if linked.errors.len() > 0 {
        sh_write_lines("{out}.link-issues", linked.errors)
        return
    }
    sh_files.write_bytes("{out}.exe", linked.bytes) ?? panic("cannot write {out}.exe")
    sh_files.set_mode("{out}.exe", 0o755) ?? panic("cannot make {out}.exe executable")
}
