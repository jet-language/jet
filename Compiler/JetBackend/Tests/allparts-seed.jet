// All-parts runtime seed: `jet emit --rust` of this program is the runtime
// text Tools/agent/gen-c-abi-routes.mjs reads and the all-parts native pack
// compiles (prepare-call-runtime.mjs --allparts). Every `use` names a Core
// module whose runtime part (crates/jet-codegen/src/Codegen/mod.rs
// runtime_parts_for_used_core) the emitted runtime must carry. Gtk and Game
// (host GUI/raylib libraries) are left out; core.hardware is not a frozen
// core module (EmbeddedHardware part has no `use` spelling).
use core.event as event
use core.rt as rt
use core.ui as ui
use core.devtools as devtools
use core.web as web
use core.http as http
use core.http.client as client
use core.http.server as server
use core.email as email
use core.files as files
use core.watcher as watcher
use core.term as term
use core.sys as sys
use core.process as process
use core.args as args
use core.testing as testing
use core.perf as perf
use core.crypto as crypto
use core.math as math
use core.time as time
use core.units as units
use core.encoding as encoding
use core.encoding.json as json
use core.archive.gzip as gzip
use core.net.ws as ws
use core.encoding.csv as csv
use core.encoding.xml as xml
use core.encoding.cbor as cbor
use core.archive as archive
use core.data as data
use core.db as db
use core.db.sql as sql
use core.text.fmt as fmt
use core.compute as compute
use core.net as net
use core.reflect as reflect
use core.sync as sync
use core.service as service
use core.jobs as jobs
use core.mod as mods

// Importing a module selects its runtime part, but the host bridge macros are
// selected by actual route demand. These seed bodies retain that demand in
// emitted MIR; they are not executed by the all-parts seed.
fn allparts_http_bridge(url: String) {
    client.get(url).drop("all-parts HTTP bridge demand")
}

fn allparts_db_bridge(path: String) {
    db.open(path).drop("all-parts database bridge demand")
}

fn run() {
    print("hello")
}
