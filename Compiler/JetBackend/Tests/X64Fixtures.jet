// Encoder references: GNU as/objdump (binutils via nixpkgs), Intel syntax.
// The concatenated bytes below correspond, in order, to these encoder calls.
use core.files as files
fn x64_fx_bytes(name: String, actual: [U8], expected: [Int]) -> Bool Never! {
    ok := actual.len() == expected.len()
    loop (index, byte) in actual {
        if index >= expected.len() {
            ok = false
        } else {
            expected_byte :: U8{expected[index]}
            if byte != expected_byte -> ok = false
        }
    }
    if !ok -> print("X64 FAIL {name}: {actual}")
    ok
}

fn x64_fx_encoder() -> Bool Never! {
    code := [U8]{}
    x64_float_move(&code, false, 10, 11)
    x64_float_move(&code, true, 10, 11)
    x64_float_load(&code, false, 10, 12, 16)
    x64_float_load(&code, true, 10, 12, 16)
    x64_float_store(&code, false, 13, 256, 14)
    x64_float_store(&code, true, 13, 256, 14)
    x64_float_xor(&code, false, 10, 11)
    x64_float_xor(&code, true, 10, 11)
    x64_movq_to_xmm(&code, 10, 11)
    x64_movq_from_xmm(&code, 11, 10)
    x64_movd_to_xmm(&code, 10, 11)
    x64_movd_from_xmm(&code, 11, 10)
    precisions :: [Bool]{false, true}
    ops :: [X64FloatOp]{.Add, .Sub, .Mul, .Div}
    loop single in precisions {
        loop op in ops -> x64_float_op(&code, op, single, 10, 11)
    }
    x64_ucomisd(&code, 10, 11)
    x64_ucomiss(&code, 10, 11)
    x64_cvtsi2sd(&code, 10, 11)
    x64_cvtsi2ss(&code, 10, 11)
    x64_cvttsd2si(&code, 11, 10)
    x64_cvttss2si(&code, 11, 10)
    x64_cvtss2sd(&code, 10, 11)
    x64_cvtsd2ss(&code, 10, 11)
    x64_float_move(&code, false, 2, 3)
    x64_float_move(&code, true, 2, 3)
    x64_float_load(&code, false, 2, 5, -8)
    x64_float_load(&code, true, 2, 5, -8)
    x64_float_store(&code, false, 4, 0, 3)
    x64_float_store(&code, true, 4, 0, 3)
    x64_float_xor(&code, false, 2, 3)
    x64_float_xor(&code, true, 2, 3)
    x64_movq_to_xmm(&code, 2, 0)
    x64_movq_from_xmm(&code, 0, 2)
    x64_movd_to_xmm(&code, 2, 0)
    x64_movd_from_xmm(&code, 0, 2)
    x64_fx_bytes("SSE reference", code, [Int]{
        0x66,0x45,0x0f,0x28,0xd3, 0x45,0x0f,0x28,0xd3,
        0xf2,0x45,0x0f,0x10,0x54,0x24,0x10, 0xf3,0x45,0x0f,0x10,0x54,0x24,0x10,
        0xf2,0x45,0x0f,0x11,0xb5,0,1,0,0, 0xf3,0x45,0x0f,0x11,0xb5,0,1,0,0,
        0x66,0x45,0x0f,0x57,0xd3, 0x45,0x0f,0x57,0xd3,
        0x66,0x4d,0x0f,0x6e,0xd3, 0x66,0x4d,0x0f,0x7e,0xd3,
        0x66,0x45,0x0f,0x6e,0xd3, 0x66,0x45,0x0f,0x7e,0xd3,
        0xf2,0x45,0x0f,0x58,0xd3, 0xf2,0x45,0x0f,0x5c,0xd3,
        0xf2,0x45,0x0f,0x59,0xd3, 0xf2,0x45,0x0f,0x5e,0xd3,
        0xf3,0x45,0x0f,0x58,0xd3, 0xf3,0x45,0x0f,0x5c,0xd3,
        0xf3,0x45,0x0f,0x59,0xd3, 0xf3,0x45,0x0f,0x5e,0xd3,
        0x66,0x45,0x0f,0x2e,0xd3, 0x45,0x0f,0x2e,0xd3,
        0xf2,0x4d,0x0f,0x2a,0xd3, 0xf3,0x4d,0x0f,0x2a,0xd3,
        0xf2,0x4d,0x0f,0x2c,0xda, 0xf3,0x4d,0x0f,0x2c,0xda,
        0xf3,0x45,0x0f,0x5a,0xd3, 0xf2,0x45,0x0f,0x5a,0xd3,
        0x66,0x0f,0x28,0xd3, 0x0f,0x28,0xd3,
        0xf2,0x0f,0x10,0x55,0xf8, 0xf3,0x0f,0x10,0x55,0xf8,
        0xf2,0x0f,0x11,0x1c,0x24, 0xf3,0x0f,0x11,0x1c,0x24,
        0x66,0x0f,0x57,0xd3, 0x0f,0x57,0xd3,
        0x66,0x48,0x0f,0x6e,0xd0, 0x66,0x48,0x0f,0x7e,0xd0,
        0x66,0x0f,0x6e,0xd0, 0x66,0x0f,0x7e,0xd0
    })
}

fn x64_fx_builder() -> LIRFunctionBuilder Never! {
    LIRFunctionBuilder{id: LIRFunctionID{value: 0}, name: "xmm", signature: LIRSignatureID{value: 0}, values: [LIRValue]{}, blocks: [LIRBlock]{}, open: [LIRInst]{}, next_block: 0}
}

fn x64_fx_allocation() -> Bool Never! {
    ok := true
    layouts :: [LIRLayout]{lir_layout_float(), lir_layout_float32()}
    loop layout in layouts {
        b := x64_fx_builder()
        params := [LIRValueID]{}
        loop _ in 0..<16 -> &params.push(lir_builder_value(&b, layout, .Trivial, None))
        sum := params[0]
        loop index in 1..<16 {
            dst :: lir_builder_value(&b, layout, .Trivial, None)
            lir_builder_push(&b, .Binary{dst: dst, op: .Add, left: sum, right: params[index]})
            sum = dst
        }
        lir_builder_seal(&b, LIRBlockID{value: 0}, params, .Return{value: Val(sum)})
        a :: x64_allocate(lir_builder_finish(b))
        if a.spill_slots < 2 || a.callee_saved.len() != 0 -> ok = false
        loop loc in a.locations {
            if loc == .Reg(_) -> ok = false
            if loc == .Xmm(reg, _) && (reg < 2 || reg > 15) -> ok = false
        }
        b = x64_fx_builder()
        live :: lir_builder_value(&b, layout, .Trivial, None)
        lir_builder_push(&b, .Call{dst: None, signature: LIRSignatureID{value: 1}, callee: .Runtime{symbol: "clobber"}, args: [LIRValueID]{}})
        lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{live}, .Return{value: Val(live)})
        across :: x64_allocate(lir_builder_finish(b))
        spill :: X64Loc.FloatStack{slot: 0, single: layout == lir_layout_float32()}
        if across.locations[live.value] != spill -> ok = false
    }
    if !ok -> print("X64 FAIL allocation")
    ok
}

fn x64_fx_emitter() -> X64Emitter Never! {
    X64Emitter{code: [U8]{}, relocs: [X64Reloc]{}, fixups: [X64BlockFixup]{}, saved: [Int]{}, stack: [Int]{}}
}

// Export a standalone Linux machine witness for the runner to execute. It
// accumulates mismatches in r8 and exits with that word; no runtime or linker.
fn x64_fx_expect(e: &X64Emitter, reg: Int, expected: Int) Never! {
    x64_movq_from_xmm(&e.code, X64_RAX, reg)
    x64_mov_ri(&e.code, X64_R11, expected)
    x64_alu_rr(&e.code, .Cmp, X64_RAX, X64_R11)
    x64_setcc(&e.code, .NE, X64_RAX)
    x64_movzx_r8(&e.code, X64_RAX, X64_RAX)
    x64_alu_rr(&e.code, .Or, X64_R8, X64_RAX)
}

fn x64_fx_write(name: String, code: [U8]) Never! {
    files.write_bytes("{name}.elf", elf64_static_executable(code, 0, 1, code.len())) ?? panic("cannot write x64 witness")
    files.set_mode("{name}.elf", 0o755) ?? panic("cannot make x64 witness executable")
    print("X64 EXEC {name}")
}

fn x64_fx_export(name: String, e: &X64Emitter) Never! {
    x64_mov_rr(&e.code, X64_RDI, X64_R8)
    x64_mov_ri(&e.code, X64_RAX, 60)
    x64_syscall(&e.code)
    x64_fx_write(name, e.code)
}

fn x64_fx_parallel() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    loop reg in 2..<8 {
        x64_mov_ri(&e.code, X64_R11, 100 + reg)
        x64_movq_to_xmm(&e.code, reg, X64_R11)
    }
    // The final ABI xmm1 move precedes two disjoint cycles in the input.
    // Mixed precision must not hide the physical xmm2/xmm3 dependency.
    x64_emit_parallel_moves(&e, [X64Move]{
        X64Move{src: .Xmm{reg: 7, single: false}, dst: .Xmm{reg: 1, single: false}},
        X64Move{src: .Xmm{reg: 2, single: true}, dst: .Xmm{reg: 3, single: true}},
        X64Move{src: .Xmm{reg: 3, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 4, single: false}, dst: .Xmm{reg: 5, single: false}},
        X64Move{src: .Xmm{reg: 5, single: false}, dst: .Xmm{reg: 4, single: false}},
        X64Move{src: .Imm{value: 109}, dst: .Xmm{reg: 0, single: false}}
    })
    expected_regs :: [Int:Int]{0:109, 1:107, 2:103, 3:102, 4:105, 5:104}
    loop (reg, expected) in expected_regs -> x64_fx_expect(&e, reg, expected)
    x64_fx_export("parallel", &e)
}

fn x64_fx_expect_word(e: &X64Emitter, actual: Int, expected: Int) Never! {
    x64_mov_ri(&e.code, X64_R11, expected)
    x64_alu_rr(&e.code, .Cmp, actual, X64_R11)
    x64_setcc(&e.code, .NE, X64_RAX)
    x64_movzx_r8(&e.code, X64_RAX, X64_RAX)
    x64_alu_rr(&e.code, .Or, X64_R8, X64_RAX)
}

fn x64_fx_scalar() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    b := x64_fx_builder()
    left :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    right :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    dst :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    single :: lir_builder_value(&b, lir_layout_float32(), .Trivial, None)
    a :: X64Allocation{locations: [X64Loc]{.Xmm{reg: 10, single: false}, .Xmm{reg: 11, single: false}, .Xmm{reg: 11, single: false}, .Xmm{reg: 12, single: true}}, spill_slots: 0, callee_saved: [Int]{}}
    f :: lir_builder_finish(b)
    x64_emit_move(&e, .Imm{value: 0x3ff0000000000000}, a.locations[left.value])
    x64_emit_move(&e, .Imm{value: 0x4000000000000000}, a.locations[right.value])
    x64_select_inst(&e, f, a, .Binary{dst: dst, op: .Add, left: left, right: right})
    x64_fx_expect(&e, 11, 0x4008000000000000)
    x64_select_inst(&e, f, a, .Convert{dst: single, src: dst})
    x64_movd_from_xmm(&e.code, X64_RAX, 12)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_select_inst(&e, f, a, .Convert{dst: left, src: single})
    x64_fx_expect(&e, 10, 0x4008000000000000)
    // Reusing the right register must not reverse distinct NaN payloads.
    x64_emit_move(&e, .Imm{value: 0x7ff8000000000011}, a.locations[left.value])
    x64_emit_move(&e, .Imm{value: 0x7ff8000000000022}, a.locations[right.value])
    x64_select_inst(&e, f, a, .Binary{dst: dst, op: .Add, left: left, right: right})
    x64_fx_expect(&e, 11, 0x7ff8000000000011)
    precisions :: [Bool]{false, true}
    conditions :: [LIRCondition]{.Eq, .Ne, .Lt, .Le, .Gt, .Ge}
    loop precision in precisions {
        nan :: if precision -> 0x7fc00011 else -> 0x7ff8000000000011
        one :: if precision -> 0x3f800000 else -> 0x3ff0000000000000
        x64_emit_move(&e, .Imm{value: nan}, .Xmm{reg: 10, single: precision})
        x64_emit_move(&e, .Imm{value: one}, .Xmm{reg: 11, single: precision})
        loop condition in conditions {
            x64_float_compare(&e, condition, precision, 10, 11, X64_RAX)
            x64_fx_expect_word(&e, X64_RAX, if condition == .Ne -> 1 else -> 0)
            x64_float_compare(&e, condition, precision, 11, 10, X64_RAX)
            x64_fx_expect_word(&e, X64_RAX, if condition == .Ne -> 1 else -> 0)
        }
    }
    x64_fx_export("scalar", &e)
}

fn x64_fx_spill() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    x64_mov_rr(&e.code, X64_RBP, X64_RSP)
    x64_alu_ri(&e.code, .Sub, X64_RSP, 32)
    // Dirty high xmm lanes must not enter a word-held F32 spill.
    x64_mov_ri(&e.code, X64_R11, 0x3ff0000040400000)
    x64_movq_to_xmm(&e.code, 10, X64_R11)
    x64_emit_move(&e, .Xmm{reg: 10, single: true}, .FloatStack{slot: 0, single: true})
    x64_load_slot(&e, X64_RAX, 0)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_emit_move(&e, .Imm{value: 0x3ff0000000000000}, .FloatStack{slot: 1, single: false})
    x64_emit_move(&e, .FloatStack{slot: 0, single: true}, .Xmm{reg: 12, single: true})
    x64_movd_from_xmm(&e.code, X64_RAX, 12)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_emit_move(&e, .Imm{value: 0x4000000000000000}, .FloatStack{slot: 2, single: false})
    x64_emit_parallel_moves(&e, [X64Move]{
        X64Move{src: .FloatStack{slot: 1, single: false}, dst: .FloatStack{slot: 2, single: false}},
        X64Move{src: .FloatStack{slot: 2, single: false}, dst: .FloatStack{slot: 1, single: false}}
    })
    x64_emit_move(&e, .FloatStack{slot: 1, single: false}, .Xmm{reg: 14, single: false})
    x64_fx_expect(&e, 14, 0x4000000000000000)
    x64_emit_move(&e, .FloatStack{slot: 2, single: false}, .Xmm{reg: 15, single: false})
    x64_fx_expect(&e, 15, 0x3ff0000000000000)
    x64_fx_export("spill", &e)
}

fn x64_fx_abi(single: Bool) -> Bool Never! {
    layout :: if single -> lir_layout_float32() else -> lir_layout_float()
    callee := x64_fx_builder()
    callee.id = LIRFunctionID{value: 1}
    callee.signature = LIRSignatureID{value: 1}
    params := [LIRValueID]{}
    layouts := [LIRLayout]{}
    loop _ in 0..<9 {
        &params.push(lir_builder_value(&callee, layout, .Trivial, None))
        &layouts.push(layout)
    }
    sum := params[0]
    loop index in 1..<9 {
        dst :: lir_builder_value(&callee, layout, .Trivial, None)
        lir_builder_push(&callee, .Binary{dst: dst, op: .Add, left: sum, right: params[index]})
        sum = dst
    }
    lir_builder_seal(&callee, LIRBlockID{value: 0}, params, .Return{value: Val(sum)})
    caller := x64_fx_builder()
    args := [LIRValueID]{}
    loop number in 1..<10 {
        word :: lir_builder_word(&caller)
        arg :: lir_builder_value(&caller, layout, .Trivial, None)
        lir_builder_push(&caller, .Const{dst: word, value: number})
        lir_builder_push(&caller, .Convert{dst: arg, src: word})
        &args.push(arg)
    }
    called :: lir_builder_value(&caller, layout, .Trivial, None)
    lir_builder_push(&caller, .Call{dst: Val(called), signature: LIRSignatureID{value: 1}, callee: .Function{id: LIRFunctionID{value: 1}}, args: args})
    total :: lir_builder_value(&caller, layout, .Trivial, None)
    // args[0] crosses the call and must survive the callee's xmm clobbers.
    lir_builder_push(&caller, .Binary{dst: total, op: .Add, left: called, right: args[0]})
    result :: lir_builder_word(&caller)
    lir_builder_push(&caller, .Convert{dst: result, src: total})
    lir_builder_seal(&caller, LIRBlockID{value: 0}, [LIRValueID]{}, .Return{value: Val(result)})
    module :: LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: layouts, result: Val(layout)}
    }, functions: [LIRFunction]{lir_builder_finish(caller), lir_builder_finish(callee)}, data: [LIRData]{}}
    compiled :: x64_compile_module(module)
    if compiled.errors.len() > 0 {
        print("X64 FAIL ABI lint/selection: {compiled.errors}")
        return false
    }
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    call :: x64_call_rel32(&e.code)
    // Generated callees may use r8, so clear the accumulator after the call.
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    x64_fx_expect_word(&e, X64_RAX, 46)
    x64_mov_rr(&e.code, X64_RDI, X64_R8)
    x64_mov_ri(&e.code, X64_RAX, 60)
    x64_syscall(&e.code)
    offsets := [Int]{}
    loop f in compiled.functions {
        &offsets.push(e.code.len())
        loop byte in f.code -> &e.code.push(byte)
    }
    x64_patch_rel32(&e.code, call, offsets[0])
    loop (index, f) in compiled.functions {
        loop reloc in f.relocs {
            if reloc.target == .Function(id) -> x64_patch_rel32(&e.code, offsets[index] + reloc.at, offsets[id.value])
        }
    }
    name :: if single -> "abi-f32" else -> "abi-f64"
    x64_fx_write(name, e.code)
    true
}

fn x64_fx_entry() -> Bool Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    loop reg in 1..<5 {
        x64_mov_ri(&e.code, X64_R11, 100 + reg)
        x64_movq_to_xmm(&e.code, reg, X64_R11)
    }
    // Reviewer case: xmm1 is unread only after import, not an unconditional
    // scratch. Duplicate dst2 has last-write meaning here, not an ABI plan.
    moves :: [X64Move]{
        X64Move{src: .Xmm{reg: 1, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 2, single: false}, dst: .Xmm{reg: 3, single: false}},
        X64Move{src: .Xmm{reg: 3, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 1, single: false}, dst: .Xmm{reg: 4, single: false}},
        X64Move{src: .Imm{value: 88}, dst: .Xmm{reg: 0, single: false}}
    }
    // xmm0 is unread but is a pending destination. Its completed value must
    // subsequently be excluded when the actual cycle is broken.
    ok :: x64_parallel_float_scratch(moves, moves) == 0
    x64_emit_parallel_moves(&e, moves)
    x64_fx_expect(&e, 0, 88)
    x64_fx_expect(&e, 2, 103)
    x64_fx_expect(&e, 3, 102)
    x64_fx_expect(&e, 4, 101)
    x64_fx_export("entry", &e)
    ok
}

fn x64_fixtures() -> Bool Never! {
    encoder :: x64_fx_encoder()
    allocation :: x64_fx_allocation()
    x64_fx_parallel()
    x64_fx_scalar()
    x64_fx_spill()
    abi64 :: x64_fx_abi(false)
    abi32 :: x64_fx_abi(true)
    entry :: x64_fx_entry()
    encoder && allocation && abi64 && abi32 && entry
}
