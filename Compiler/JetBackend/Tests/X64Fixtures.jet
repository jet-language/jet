// Encoder references: GNU as/objdump (binutils via nixpkgs), Intel syntax.
// The concatenated bytes below correspond, in order, to these encoder calls.
use core.files as files
fn x64_fx_bytes(name: String, actual: [U8], expected: [Int]) -> Bool Never! {
    ok := actual.len() == expected.len()
    loop (index, byte) in actual {
        if index >= expected.len() {
            ok = false
        } else {
            expected_byte :: U8{expected[index]}
            if byte != expected_byte -> ok = false
        }
    }
    if !ok -> print("X64 FAIL {name}: {actual}")
    ok
}

fn x64_fx_encoder() -> Bool Never! {
    code := [U8]{}
    x64_float_move(&code, false, 10, 11)
    x64_float_move(&code, true, 10, 11)
    x64_float_load(&code, false, 10, 12, 16)
    x64_float_load(&code, true, 10, 12, 16)
    x64_float_store(&code, false, 13, 256, 14)
    x64_float_store(&code, true, 13, 256, 14)
    x64_float_xor(&code, false, 10, 11)
    x64_float_xor(&code, true, 10, 11)
    x64_movq_to_xmm(&code, 10, 11)
    x64_movq_from_xmm(&code, 11, 10)
    x64_movd_to_xmm(&code, 10, 11)
    x64_movd_from_xmm(&code, 11, 10)
    precisions :: [Bool]{false, true}
    ops :: [X64FloatOp]{.Add, .Sub, .Mul, .Div}
    loop single in precisions {
        loop op in ops -> x64_float_op(&code, op, single, 10, 11)
    }
    x64_ucomisd(&code, 10, 11)
    x64_ucomiss(&code, 10, 11)
    x64_cvtsi2sd(&code, 10, 11)
    x64_cvtsi2ss(&code, 10, 11)
    x64_cvttsd2si(&code, 11, 10)
    x64_cvttss2si(&code, 11, 10)
    x64_cvtss2sd(&code, 10, 11)
    x64_cvtsd2ss(&code, 10, 11)
    x64_float_move(&code, false, 2, 3)
    x64_float_move(&code, true, 2, 3)
    x64_float_load(&code, false, 2, 5, -8)
    x64_float_load(&code, true, 2, 5, -8)
    x64_float_store(&code, false, 4, 0, 3)
    x64_float_store(&code, true, 4, 0, 3)
    x64_float_xor(&code, false, 2, 3)
    x64_float_xor(&code, true, 2, 3)
    x64_movq_to_xmm(&code, 2, 0)
    x64_movq_from_xmm(&code, 0, 2)
    x64_movd_to_xmm(&code, 2, 0)
    x64_movd_from_xmm(&code, 0, 2)
    x64_fx_bytes("SSE reference", code, [Int]{
        0x66,0x45,0x0f,0x28,0xd3, 0xf3,0x45,0x0f,0x10,0xd3,
        0xf2,0x45,0x0f,0x10,0x54,0x24,0x10, 0xf3,0x45,0x0f,0x10,0x54,0x24,0x10,
        0xf2,0x45,0x0f,0x11,0xb5,0,1,0,0, 0xf3,0x45,0x0f,0x11,0xb5,0,1,0,0,
        0x66,0x45,0x0f,0x57,0xd3, 0x45,0x0f,0x57,0xd3,
        0x66,0x4d,0x0f,0x6e,0xd3, 0x66,0x4d,0x0f,0x7e,0xd3,
        0x66,0x45,0x0f,0x6e,0xd3, 0x66,0x45,0x0f,0x7e,0xd3,
        0xf2,0x45,0x0f,0x58,0xd3, 0xf2,0x45,0x0f,0x5c,0xd3,
        0xf2,0x45,0x0f,0x59,0xd3, 0xf2,0x45,0x0f,0x5e,0xd3,
        0xf3,0x45,0x0f,0x58,0xd3, 0xf3,0x45,0x0f,0x5c,0xd3,
        0xf3,0x45,0x0f,0x59,0xd3, 0xf3,0x45,0x0f,0x5e,0xd3,
        0x66,0x45,0x0f,0x2e,0xd3, 0x45,0x0f,0x2e,0xd3,
        0xf2,0x4d,0x0f,0x2a,0xd3, 0xf3,0x4d,0x0f,0x2a,0xd3,
        0xf2,0x4d,0x0f,0x2c,0xda, 0xf3,0x4d,0x0f,0x2c,0xda,
        0xf3,0x45,0x0f,0x5a,0xd3, 0xf2,0x45,0x0f,0x5a,0xd3,
        0x66,0x0f,0x28,0xd3, 0xf3,0x0f,0x10,0xd3,
        0xf2,0x0f,0x10,0x55,0xf8, 0xf3,0x0f,0x10,0x55,0xf8,
        0xf2,0x0f,0x11,0x1c,0x24, 0xf3,0x0f,0x11,0x1c,0x24,
        0x66,0x0f,0x57,0xd3, 0x0f,0x57,0xd3,
        0x66,0x48,0x0f,0x6e,0xd0, 0x66,0x48,0x0f,0x7e,0xd0,
        0x66,0x0f,0x6e,0xd0, 0x66,0x0f,0x7e,0xd0
    })
}

fn x64_fx_builder() -> LIRFunctionBuilder Never! {
    lir_builder(LIRFunctionID{value: 0}, "xmm", LIRSignatureID{value: 0})
}

fn x64_fx_allocation() -> Bool Never! {
    ok := true
    layouts :: [LIRLayout]{lir_layout_float(), lir_layout_float32()}
    loop layout in layouts {
        b := x64_fx_builder()
        params := [LIRValueID]{}
        loop _ in 0..<16 -> &params.push(lir_builder_value(&b, layout, .Trivial, None))
        sum := params[0]
        loop index in 1..<16 {
            dst :: lir_builder_value(&b, layout, .Trivial, None)
            lir_builder_push(&b, .Binary{dst: dst, op: .Add, left: sum, right: params[index]})
            sum = dst
        }
        lir_builder_seal(&b, LIRBlockID{value: 0}, params, .Return{value: Val(sum)})
        a :: x64_allocate(lir_builder_finish(b))
        if a.spill_slots < 2 || a.callee_saved.len() != 0 -> ok = false
        loop loc in a.locations {
            if loc == .Reg(_) -> ok = false
            if loc == .Xmm(reg, _) && (reg < 2 || reg > 15) -> ok = false
        }
        b = x64_fx_builder()
        live :: lir_builder_value(&b, layout, .Trivial, None)
        lir_builder_push(&b, .Call{dst: None, signature: LIRSignatureID{value: 1}, callee: .Runtime{symbol: "clobber"}, args: [LIRValueID]{}})
        lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{live}, .Return{value: Val(live)})
        across :: x64_allocate(lir_builder_finish(b))
        spill :: X64Loc.FloatStack{slot: 0, single: layout == lir_layout_float32()}
        if across.locations[live.value] != spill -> ok = false
    }
    if !ok -> print("X64 FAIL allocation")
    ok
}

fn x64_fx_emitter() -> X64Emitter Never! {
    X64Emitter{code: [U8]{}, relocs: [X64Reloc]{}, fixups: [X64BlockFixup]{}, saved: [Int]{}, stack: [Int]{}, returns: [Int]{}}
}

// Export a standalone Linux machine witness for the runner to execute. It
// accumulates mismatches in r8 and exits with that word; no runtime or linker.
fn x64_fx_expect(e: &X64Emitter, reg: Int, expected: Int) Never! {
    x64_movq_from_xmm(&e.code, X64_RAX, reg)
    x64_mov_ri(&e.code, X64_R11, expected)
    x64_alu_rr(&e.code, .Cmp, X64_RAX, X64_R11)
    x64_setcc(&e.code, .NE, X64_RAX)
    x64_movzx_r8(&e.code, X64_RAX, X64_RAX)
    x64_alu_rr(&e.code, .Or, X64_R8, X64_RAX)
}

fn x64_fx_write(name: String, code: [U8]) Never! {
    files.write_bytes("{name}.elf", elf64_static_executable(code, 0, 1, code.len())) ?? panic("cannot write x64 witness")
    files.set_mode("{name}.elf", 0o755) ?? panic("cannot make x64 witness executable")
    print("X64 EXEC {name}")
}

fn x64_fx_export(name: String, e: &X64Emitter) Never! {
    x64_mov_rr(&e.code, X64_RDI, X64_R8)
    x64_mov_ri(&e.code, X64_RAX, 60)
    x64_syscall(&e.code)
    x64_fx_write(name, e.code)
}

fn x64_fx_parallel() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    loop reg in 2..<8 {
        x64_mov_ri(&e.code, X64_R11, 100 + reg)
        x64_movq_to_xmm(&e.code, reg, X64_R11)
    }
    // The final ABI xmm1 move precedes two disjoint cycles in the input.
    // Mixed precision must not hide the physical xmm2/xmm3 dependency.
    x64_emit_parallel_moves(&e, [X64Move]{
        X64Move{src: .Xmm{reg: 7, single: false}, dst: .Xmm{reg: 1, single: false}},
        X64Move{src: .Xmm{reg: 2, single: true}, dst: .Xmm{reg: 3, single: true}},
        X64Move{src: .Xmm{reg: 3, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 4, single: false}, dst: .Xmm{reg: 5, single: false}},
        X64Move{src: .Xmm{reg: 5, single: false}, dst: .Xmm{reg: 4, single: false}},
        X64Move{src: .Imm{value: 109}, dst: .Xmm{reg: 0, single: false}}
    })
    expected_regs :: [Int:Int]{0:109, 1:107, 2:103, 3:102, 4:105, 5:104}
    loop (reg, expected) in expected_regs -> x64_fx_expect(&e, reg, expected)
    x64_fx_export("parallel", &e)
}

fn x64_fx_expect_word(e: &X64Emitter, actual: Int, expected: Int) Never! {
    x64_mov_ri(&e.code, X64_R11, expected)
    x64_alu_rr(&e.code, .Cmp, actual, X64_R11)
    x64_setcc(&e.code, .NE, X64_RAX)
    x64_movzx_r8(&e.code, X64_RAX, X64_RAX)
    x64_alu_rr(&e.code, .Or, X64_R8, X64_RAX)
}

fn x64_fx_scalar() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    b := x64_fx_builder()
    left :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    right :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    dst :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    single :: lir_builder_value(&b, lir_layout_float32(), .Trivial, None)
    f :: lir_builder_finish(b)
    a :: X64Allocation{locations: [X64Loc]{.Xmm{reg: 10, single: false}, .Xmm{reg: 11, single: false}, .Xmm{reg: 11, single: false}, .Xmm{reg: 12, single: true}}, spill_slots: 0, callee_saved: [Int]{}, segment_values: [Int]{}, segment_locations: [X64Loc]{}, segment_starts: [Int]{}, segment_ends: [Int]{}, block_segments: [Int]{0, 0}, block_entries: [Int]{0}, folds: x64_address_folds(f)}
    x64_emit_move(&e, .Imm{value: 0x3ff0000000000000}, a.locations[left.value])
    x64_emit_move(&e, .Imm{value: 0x4000000000000000}, a.locations[right.value])
    x64_select_inst(&e, f, a, .Binary{dst: dst, op: .Add, left: left, right: right})
    x64_fx_expect(&e, 11, 0x4008000000000000)
    x64_select_inst(&e, f, a, .Convert{dst: single, src: dst})
    x64_movd_from_xmm(&e.code, X64_RAX, 12)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_select_inst(&e, f, a, .Convert{dst: left, src: single})
    x64_fx_expect(&e, 10, 0x4008000000000000)
    // Reusing the right register must not reverse distinct NaN payloads.
    x64_emit_move(&e, .Imm{value: 0x7ff8000000000011}, a.locations[left.value])
    x64_emit_move(&e, .Imm{value: 0x7ff8000000000022}, a.locations[right.value])
    x64_select_inst(&e, f, a, .Binary{dst: dst, op: .Add, left: left, right: right})
    x64_fx_expect(&e, 11, 0x7ff8000000000011)
    precisions :: [Bool]{false, true}
    conditions :: [LIRCondition]{.Eq, .Ne, .Lt, .Le, .Gt, .Ge}
    loop precision in precisions {
        nan :: if precision -> 0x7fc00011 else -> 0x7ff8000000000011
        one :: if precision -> 0x3f800000 else -> 0x3ff0000000000000
        x64_emit_move(&e, .Imm{value: nan}, .Xmm{reg: 10, single: precision})
        x64_emit_move(&e, .Imm{value: one}, .Xmm{reg: 11, single: precision})
        loop condition in conditions {
            x64_float_compare(&e, condition, precision, 10, 11, X64_RAX)
            x64_fx_expect_word(&e, X64_RAX, if condition == .Ne -> 1 else -> 0)
            x64_float_compare(&e, condition, precision, 11, 10, X64_RAX)
            x64_fx_expect_word(&e, X64_RAX, if condition == .Ne -> 1 else -> 0)
        }
    }
    x64_fx_export("scalar", &e)
}

fn x64_fx_spill() Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    x64_mov_rr(&e.code, X64_RBP, X64_RSP)
    x64_alu_ri(&e.code, .Sub, X64_RSP, 32)
    // Dirty high xmm lanes must not enter a word-held F32 spill.
    x64_mov_ri(&e.code, X64_R11, 0x3ff0000040400000)
    x64_movq_to_xmm(&e.code, 10, X64_R11)
    x64_emit_move(&e, .Xmm{reg: 10, single: true}, .FloatStack{slot: 0, single: true})
    x64_load_slot(&e, X64_RAX, 0)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_emit_move(&e, .Imm{value: 0x3ff0000000000000}, .FloatStack{slot: 1, single: false})
    x64_emit_move(&e, .FloatStack{slot: 0, single: true}, .Xmm{reg: 12, single: true})
    x64_movd_from_xmm(&e.code, X64_RAX, 12)
    x64_fx_expect_word(&e, X64_RAX, 0x40400000)
    x64_emit_move(&e, .Imm{value: 0x4000000000000000}, .FloatStack{slot: 2, single: false})
    x64_emit_parallel_moves(&e, [X64Move]{
        X64Move{src: .FloatStack{slot: 1, single: false}, dst: .FloatStack{slot: 2, single: false}},
        X64Move{src: .FloatStack{slot: 2, single: false}, dst: .FloatStack{slot: 1, single: false}}
    })
    x64_emit_move(&e, .FloatStack{slot: 1, single: false}, .Xmm{reg: 14, single: false})
    x64_fx_expect(&e, 14, 0x4000000000000000)
    x64_emit_move(&e, .FloatStack{slot: 2, single: false}, .Xmm{reg: 15, single: false})
    x64_fx_expect(&e, 15, 0x3ff0000000000000)
    x64_fx_export("spill", &e)
}

fn x64_fx_abi(single: Bool) -> Bool Never! {
    layout :: if single -> lir_layout_float32() else -> lir_layout_float()
    callee := x64_fx_builder()
    callee.id = LIRFunctionID{value: 1}
    callee.signature = LIRSignatureID{value: 1}
    params := [LIRValueID]{}
    layouts := [LIRLayout]{}
    loop _ in 0..<9 {
        &params.push(lir_builder_value(&callee, layout, .Trivial, None))
        &layouts.push(layout)
    }
    sum := params[0]
    loop index in 1..<9 {
        dst :: lir_builder_value(&callee, layout, .Trivial, None)
        lir_builder_push(&callee, .Binary{dst: dst, op: .Add, left: sum, right: params[index]})
        sum = dst
    }
    lir_builder_seal(&callee, LIRBlockID{value: 0}, params, .Return{value: Val(sum)})
    caller := x64_fx_builder()
    args := [LIRValueID]{}
    loop number in 1..<10 {
        word :: lir_builder_word(&caller)
        arg :: lir_builder_value(&caller, layout, .Trivial, None)
        lir_builder_push(&caller, .Const{dst: word, value: number})
        lir_builder_push(&caller, .Convert{dst: arg, src: word})
        &args.push(arg)
    }
    called :: lir_builder_value(&caller, layout, .Trivial, None)
    lir_builder_push(&caller, .Call{dst: Val(called), signature: LIRSignatureID{value: 1}, callee: .Function{id: LIRFunctionID{value: 1}}, args: args})
    total :: lir_builder_value(&caller, layout, .Trivial, None)
    // args[0] crosses the call and must survive the callee's xmm clobbers.
    lir_builder_push(&caller, .Binary{dst: total, op: .Add, left: called, right: args[0]})
    result :: lir_builder_word(&caller)
    lir_builder_push(&caller, .Convert{dst: result, src: total})
    lir_builder_seal(&caller, LIRBlockID{value: 0}, [LIRValueID]{}, .Return{value: Val(result)})
    program :: LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: layouts, result: Val(layout)}
    }, functions: [LIRFunction]{lir_builder_finish(caller), lir_builder_finish(callee)}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable(if single -> "abi-f32" else -> "abi-f64", program, None, 46)
}

fn x64_fx_entry() -> Bool Never! {
    e := x64_fx_emitter()
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    loop reg in 1..<5 {
        x64_mov_ri(&e.code, X64_R11, 100 + reg)
        x64_movq_to_xmm(&e.code, reg, X64_R11)
    }
    // Reviewer case: xmm1 is unread only after import, not an unconditional
    // scratch. Duplicate dst2 has last-write meaning here, not an ABI plan.
    moves :: [X64Move]{
        X64Move{src: .Xmm{reg: 1, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 2, single: false}, dst: .Xmm{reg: 3, single: false}},
        X64Move{src: .Xmm{reg: 3, single: false}, dst: .Xmm{reg: 2, single: false}},
        X64Move{src: .Xmm{reg: 1, single: false}, dst: .Xmm{reg: 4, single: false}},
        X64Move{src: .Imm{value: 88}, dst: .Xmm{reg: 0, single: false}}
    }
    // xmm0 is unread but is a pending destination. Its completed value must
    // subsequently be excluded when the actual cycle is broken.
    ok :: x64_parallel_float_scratch(moves, moves) == 0
    x64_emit_parallel_moves(&e, moves)
    x64_fx_expect(&e, 0, 88)
    x64_fx_expect(&e, 2, 103)
    x64_fx_expect(&e, 3, 102)
    x64_fx_expect(&e, 4, 101)
    x64_fx_export("entry", &e)
    ok
}

fn x64_fixtures() -> Bool Never! {
    encoder :: x64_fx_encoder()
    allocation :: x64_fx_allocation()
    x64_fx_parallel()
    x64_fx_scalar()
    x64_fx_spill()
    abi64 :: x64_fx_abi(false)
    abi32 :: x64_fx_abi(true)
    entry :: x64_fx_entry()
    sib :: x64_fx_sib()
    address_plan :: x64_fx_address_plan()
    memory :: x64_fx_memory()
    arithmetic :: x64_fx_address_arithmetic()
    frame :: x64_fx_frame_branch()
    split :: x64_fx_split_loop()
    fused :: x64_fx_fused_overflow()
    call_loop :: x64_fx_call_loop()
    critical :: x64_fx_critical_edges()
    edge_store :: x64_fx_edge_store()
    shared_slot :: x64_fx_shared_slot()
    encoder && allocation && abi64 && abi32 && entry && sib && address_plan && memory && arithmetic && frame && split && fused && call_loop && critical && edge_store && shared_slot
}

fn x64_fx_executable(name: String, program: LIRModule, argument: Int?, expected: Int) -> Bool Never! {
    compiled :: x64_compile_module(program)
    if compiled.errors.len() > 0 {
        print("X64 FAIL {name} lint/selection: {compiled.errors}")
        return false
    }
    e := x64_fx_emitter()
    if argument == .Val(value) -> x64_mov_ri(&e.code, X64_RDI, value)
    call :: x64_call_rel32(&e.code)
    // Generated callees may use r8; the wrapper starts its check after return.
    x64_alu_rr(&e.code, .Xor, X64_R8, X64_R8)
    x64_fx_expect_word(&e, X64_RAX, expected)
    x64_mov_rr(&e.code, X64_RDI, X64_R8)
    x64_mov_ri(&e.code, X64_RAX, 60)
    x64_syscall(&e.code)
    offsets := [Int]{}
    loop f in compiled.functions {
        &offsets.push(e.code.len())
        loop byte in f.code -> &e.code.push(byte)
    }
    x64_patch_rel32(&e.code, call, offsets[0])
    loop (index, f) in compiled.functions {
        loop reloc in f.relocs {
            if reloc.target == .Function(id) {
                x64_patch_rel32(&e.code, offsets[index] + reloc.at, offsets[id.value])
            } else {
                print("X64 FAIL {name}: unexpected external relocation")
                return false
            }
        }
    }
    x64_fx_write(name, e.code)
    true
}

// GNU as/objdump references: scales 1/2/4/8, rsp/rbp/r12/r13 bases,
// r12 index (not rsp), disp0/disp8 boundaries/disp32 and both REX extensions;
// every access width with base r13 and index r12 (16-bit stores take 66
// before REX, 16-bit loads are movzx, a bare REX selects sil).
fn x64_fx_sib() -> Bool Never! {
    code := [U8]{}
    x64_lea_indexed(&code, 10, 12, 13, 8, 256)
    x64_lea_indexed(&code, 0, 5, 0, 1, 0)
    x64_lea_indexed(&code, 0, 4, 7, 4, -128)
    x64_lea_indexed(&code, 0, 13, 12, 2, 0)
    x64_lea_indexed(&code, 0, 5, -1, 1, 0)
    x64_load_indexed(&code, 10, 12, 13, 8, 256, 8)
    x64_load_indexed(&code, 10, 12, 13, 4, 16, 4)
    x64_load_indexed(&code, 10, 12, 13, 2, -1, 1)
    x64_store_indexed(&code, 13, 12, 8, 127, 14, 8)
    x64_store_indexed(&code, 5, 7, 1, 128, 0, 4)
    x64_store_indexed(&code, 4, 6, 4, -129, 7, 1)
    x64_float_load_indexed(&code, false, 10, 12, 13, 4, 0)
    x64_float_load_indexed(&code, true, 10, 12, 13, 4, 0)
    x64_float_store_indexed(&code, false, 13, 12, 8, 127, 14)
    x64_float_store_indexed(&code, true, 13, 12, 8, 127, 14)
    x64_float_load_indexed(&code, true, 2, 4, 6, 2, 0)
    x64_load_indexed(&code, 8, 9, 12, 1, 2147483647, 8)
    x64_store_indexed(&code, 9, 12, 1, -2147483648, 8, 8)
    x64_store_indexed(&code, 13, 12, 2, 8, 14, 1)
    x64_store_indexed(&code, 13, 12, 2, 8, 6, 1)
    x64_store_indexed(&code, 13, 12, 2, 8, 14, 2)
    x64_store_indexed(&code, 13, 12, 2, 8, 14, 4)
    x64_store_indexed(&code, 13, 12, 2, 8, 14, 8)
    x64_load_indexed(&code, 14, 13, 12, 2, 8, 1)
    x64_load_indexed(&code, 14, 13, 12, 2, 8, 2)
    x64_load_indexed(&code, 14, 13, 12, 2, 8, 4)
    x64_load_indexed(&code, 14, 13, 12, 2, 8, 8)
    x64_fx_bytes("SIB reference", code, [Int]{
        0x4f,0x8d,0x94,0xec,0,1,0,0, 0x48,0x8d,0x44,0x05,0,
        0x48,0x8d,0x44,0xbc,0x80, 0x4b,0x8d,0x44,0x65,0, 0x48,0x8d,0x45,0,
        0x4f,0x8b,0x94,0xec,0,1,0,0, 0x47,0x8b,0x54,0xac,0x10,
        0x4f,0x0f,0xb6,0x54,0x6c,0xff, 0x4f,0x89,0x74,0xe5,0x7f,
        0x89,0x84,0x3d,0x80,0,0,0, 0x40,0x88,0xbc,0xb4,0x7f,0xff,0xff,0xff,
        0xf2,0x47,0x0f,0x10,0x14,0xac, 0xf3,0x47,0x0f,0x10,0x14,0xac,
        0xf2,0x47,0x0f,0x11,0x74,0xe5,0x7f, 0xf3,0x47,0x0f,0x11,0x74,0xe5,0x7f,
        0xf3,0x0f,0x10,0x14,0x74, 0x4f,0x8b,0x84,0x21,0xff,0xff,0xff,0x7f,
        0x4f,0x89,0x84,0x21,0,0,0,0x80,
        0x47,0x88,0x74,0x65,0x08, 0x43,0x88,0x74,0x65,0x08, 0x66,0x47,0x89,0x74,0x65,0x08,
        0x47,0x89,0x74,0x65,0x08, 0x4f,0x89,0x74,0x65,0x08,
        0x4f,0x0f,0xb6,0x74,0x65,0x08, 0x4f,0x0f,0xb7,0x74,0x65,0x08,
        0x47,0x8b,0x74,0x65,0x08, 0x4f,0x8b,0x74,0x65,0x08
    })
}

fn x64_fx_address_lint(function: LIRFunction) -> Bool Never! {
    program :: LIRModule{
        signatures: [LIRSignature]{
            LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: x64_value_layouts(function, function.blocks[0].params), result: Val(lir_layout_word())},
            LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: [LIRLayout]{}, result: None}
        },
        functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()
    }
    issues :: lir_lint_module(program)
    loop issue in issues -> print("X64 FAIL address LIR: {issue.message}")
    issues.len() == 0
}

fn x64_fx_address_plan() -> Bool Never! {
    b := x64_fx_builder()
    base :: lir_builder_value(&b, lir_layout_pointer(), .Trivial, None)
    index :: lir_builder_word(&b)
    count :: lir_builder_word(&b)
    off :: lir_builder_word(&b)
    pointer :: lir_builder_value(&b, lir_layout_pointer(), .Trivial, None)
    result :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: count, value: 3})
    lir_builder_push(&b, .Binary{dst: off, op: .Shl, left: index, right: count})
    lir_builder_push(&b, .PointerAdd{dst: pointer, base: base, offset: off})
    lir_builder_push(&b, .Call{dst: None, signature: LIRSignatureID{value: 1}, callee: .Runtime{symbol: "clobber"}, args: [LIRValueID]{}})
    lir_builder_push(&b, .Load{dst: result, base: pointer, offset: 0})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{base, index}, .Return{value: Val(result)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    ok := x64_fx_address_lint(function) && a.folds.skipped[off.value] && a.folds.skipped[pointer.value]
    if a.folds.addresses[pointer.value] == .Val(address) {
        if address.index != Val(index) || address.scale != 8 -> ok = false
    } else {
        ok = false
    }
    // The eliminated shift used index before the call, but the folded load
    // uses it after the call. It must now be callee-saved or spilled.
    needed :: [LIRValueID]{base, index}
    loop value in needed {
        if a.locations[value.value] == .Reg(reg) {
            if !x64_pools().members[X64_POOL_GENERAL_CROSSING][reg] -> ok = false
        } else if a.locations[value.value] == .Stack(slot) {
            if slot < 0 -> ok = false
        } else {
            ok = false
        }
    }
    // A second use of the shift keeps that definition (the pointer can still
    // use the complete off value as a scale-1 index).
    extra := function
    extra_value :: LIRValueID{value: extra.values.len()}
    &extra.values.push(LIRValue{id: extra_value, layout: lir_layout_word(), drop: .Trivial, jet_type: None})
    &extra.blocks[0].insts.push(.Copy{dst: extra_value, src: off})
    &extra.blocks[0].lines.push(0)
    extra_plan :: x64_address_folds(extra)
    if extra_plan.skipped[off.value] -> ok = false
    if !x64_fx_address_lint(extra) -> ok = false
    // A pointer used outside its defining block must not be eliminated.
    escaped := function
    escaped.blocks[0].insts = escaped.blocks[0].insts.slice(0, 4)
    escaped.blocks[0].lines = [Int]{0, 0, 0, 0, 0}
    escaped.blocks[0].terminator = .Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}}
    &escaped.blocks.push(LIRBlock{id: LIRBlockID{value: 1}, params: [LIRValueID]{}, insts: [LIRInst]{.Load{dst: result, base: pointer, offset: 0}}, terminator: .Return{value: Val(result)}, lines: [Int]{0, 0}, cold: false})
    if x64_address_folds(escaped).skipped[pointer.value] -> ok = false
    if !x64_fx_address_lint(escaped) -> ok = false
    // A non-memory use retains the pointer and its shift.
    copied := function
    copied_value :: LIRValueID{value: copied.values.len()}
    &copied.values.push(LIRValue{id: copied_value, layout: lir_layout_pointer(), drop: .Trivial, jet_type: None})
    &copied.blocks[0].insts.push(.Copy{dst: copied_value, src: pointer})
    &copied.blocks[0].lines.push(0)
    copied_plan :: x64_address_folds(copied)
    if copied_plan.skipped[pointer.value] || copied_plan.skipped[off.value] -> ok = false
    if !x64_fx_address_lint(copied) -> ok = false
    // A shift outside the SIB scale range remains a real definition.
    wide := function
    wide.blocks[0].insts[0] = .Const{dst: count, value: 4}
    wide_plan :: x64_address_folds(wide)
    if wide_plan.skipped[off.value] || !wide_plan.skipped[pointer.value] -> ok = false
    if !x64_fx_address_lint(wide) -> ok = false
    // Both the constant and its combination with every memory displacement
    // must fit disp32 before that constant can replace a pointer definition.
    displaced := function
    displaced.blocks[0].insts[1] = .Const{dst: off, value: 2147483647}
    displaced.blocks[0].insts[4] = .Load{dst: result, base: pointer, offset: 1}
    if x64_address_folds(displaced).skipped[pointer.value] -> ok = false
    if !x64_fx_address_lint(displaced) -> ok = false
    displaced.blocks[0].insts[1] = .Const{dst: off, value: -2147483648}
    displaced.blocks[0].insts[4] = .Load{dst: result, base: pointer, offset: -1}
    if x64_address_folds(displaced).skipped[pointer.value] -> ok = false
    if !x64_fx_address_lint(displaced) -> ok = false
    // A matching later overflow test retains the original Add.
    b = x64_fx_builder()
    x :: lir_builder_word(&b)
    nine :: lir_builder_word(&b)
    sum :: lir_builder_word(&b)
    flag :: lir_builder_bool(&b)
    lir_builder_push(&b, .Const{dst: nine, value: 9})
    lir_builder_push(&b, .Binary{dst: sum, op: .Add, left: x, right: nine})
    lir_builder_push(&b, .Overflows{dst: flag, op: .Add, left: x, right: nine})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x}, .Return{value: Val(sum)})
    overflow_function :: lir_builder_finish(b)
    if x64_address_folds(overflow_function).addresses[sum.value] != None || !x64_fx_address_lint(overflow_function) -> ok = false
    if !ok -> print("X64 FAIL shared address plan")
    ok
}

fn x64_fx_memory() -> Bool Never! {
    b := x64_fx_builder()
    index :: lir_builder_word(&b)
    base :: lir_builder_value(&b, lir_layout_pointer(), .Trivial, None)
    count :: lir_builder_word(&b)
    off :: lir_builder_word(&b)
    pointer :: lir_builder_value(&b, lir_layout_pointer(), .Trivial, None)
    lir_builder_push(&b, .StackSlot{dst: base, size: 64, align: 8})
    lir_builder_push(&b, .Const{dst: count, value: 3})
    lir_builder_push(&b, .Binary{dst: off, op: .Shl, left: index, right: count})
    lir_builder_push(&b, .PointerAdd{dst: pointer, base: base, offset: off})
    pressure := [LIRValueID]{}
    loop number in 1..<16 {
        constant :: lir_builder_word(&b)
        live :: lir_builder_word(&b)
        lir_builder_push(&b, .Const{dst: constant, value: number})
        lir_builder_push(&b, .Copy{dst: live, src: constant})
        &pressure.push(live)
    }
    word :: lir_builder_word(&b)
    loaded :: lir_builder_word(&b)
    single :: lir_builder_value(&b, lir_layout_float32(), .Trivial, None)
    single_load :: lir_builder_value(&b, lir_layout_float32(), .Trivial, None)
    single_word :: lir_builder_word(&b)
    double :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    double_load :: lir_builder_value(&b, lir_layout_float(), .Trivial, None)
    double_word :: lir_builder_word(&b)
    bit :: lir_builder_bool(&b)
    bit_load :: lir_builder_bool(&b)
    equal :: lir_builder_bool(&b)
    lir_builder_push(&b, .Const{dst: word, value: 99})
    lir_builder_push(&b, .Const{dst: single, value: 0x40400000})
    lir_builder_push(&b, .Const{dst: double, value: 0x3ff0000000000000})
    lir_builder_push(&b, .Const{dst: bit, value: 1})
    lir_builder_push(&b, .Store{base: pointer, offset: 0, value: word})
    lir_builder_push(&b, .Store{base: pointer, offset: 8, value: single})
    lir_builder_push(&b, .Store{base: pointer, offset: 16, value: double})
    lir_builder_push(&b, .Store{base: pointer, offset: 24, value: bit})
    lir_builder_push(&b, .Load{dst: loaded, base: pointer, offset: 0})
    lir_builder_push(&b, .Load{dst: single_load, base: pointer, offset: 8})
    lir_builder_push(&b, .Load{dst: double_load, base: pointer, offset: 16})
    lir_builder_push(&b, .Load{dst: bit_load, base: pointer, offset: 24})
    lir_builder_push(&b, .Convert{dst: single_word, src: single_load})
    lir_builder_push(&b, .Convert{dst: double_word, src: double_load})
    &pressure.push(single_word)
    &pressure.push(double_word)
    total := loaded
    loop value in pressure {
        next_total :: lir_builder_word(&b)
        lir_builder_push(&b, .Binary{dst: next_total, op: .Add, left: total, right: value})
        total = next_total
    }
    lir_builder_push(&b, .Compare{dst: equal, condition: .Eq, left: bit_load, right: bit})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{index}, .Branch{condition: equal, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{}, .Return{value: Val(total)})
    zero :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: zero, value: 0})
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{}, .Return{value: Val(zero)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    if !a.folds.skipped[off.value] || !a.folds.skipped[pointer.value] || a.spill_slots == 0 {
        print("X64 FAIL address memory pressure plan")
        return false
    }
    program :: LIRModule{signatures: [LIRSignature]{LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_word())}}, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable("memory-address", program, Val(1), 223)
}

fn x64_fx_address_arithmetic() -> Bool Never! {
    b := x64_fx_builder()
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    count :: lir_builder_word(&b)
    off :: lir_builder_word(&b)
    scaled :: lir_builder_word(&b)
    nine :: lir_builder_word(&b)
    displaced :: lir_builder_word(&b)
    partial :: lir_builder_word(&b)
    total :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: y, value: 7})
    lir_builder_push(&b, .Const{dst: count, value: 3})
    lir_builder_push(&b, .Binary{dst: off, op: .Shl, left: y, right: count})
    lir_builder_push(&b, .Binary{dst: scaled, op: .Add, left: x, right: off})
    lir_builder_push(&b, .Const{dst: nine, value: 9})
    lir_builder_push(&b, .Binary{dst: displaced, op: .Add, left: x, right: nine})
    lir_builder_push(&b, .Binary{dst: partial, op: .Add, left: scaled, right: displaced})
    lir_builder_push(&b, .Binary{dst: total, op: .Add, left: partial, right: x})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x}, .Return{value: Val(total)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    if !a.folds.skipped[off.value] || a.folds.addresses[scaled.value] == None || a.folds.addresses[displaced.value] == None || a.locations[scaled.value] == a.locations[x.value] || a.locations[displaced.value] == a.locations[x.value] {
        print("X64 FAIL distinct-destination LEA plan")
        return false
    }
    program :: LIRModule{signatures: [LIRSignature]{LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_word())}}, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable("address-arithmetic", program, Val(5), 80)
}

// Frame addresses take no register: the StackSlot's stores and loads are
// `[rbp + d]`, and passing it to a call materializes one `lea` straight into
// rdi. Overflows feeding a Branch become `jo`; a then block that follows is
// reached by falling through an inverted jcc; a Const edge argument and the
// spilled values are written with immediate moves. Exit 42 or a wrong path.
fn x64_fx_frame_branch() -> Bool Never! {
    reader := x64_fx_builder()
    reader.id = LIRFunctionID{value: 1}
    reader.signature = LIRSignatureID{value: 1}
    slot_in :: lir_builder_value(&reader, lir_layout_pointer(), .Trivial, None)
    first :: lir_builder_word(&reader)
    second :: lir_builder_word(&reader)
    pair :: lir_builder_word(&reader)
    lir_builder_push(&reader, .Load{dst: first, base: slot_in, offset: 0})
    lir_builder_push(&reader, .Load{dst: second, base: slot_in, offset: 8})
    lir_builder_push(&reader, .Binary{dst: pair, op: .Add, left: first, right: second})
    lir_builder_seal(&reader, LIRBlockID{value: 0}, [LIRValueID]{slot_in}, .Return{value: Val(pair)})

    b := x64_fx_builder()
    slot :: lir_builder_value(&b, lir_layout_pointer(), .Trivial, None)
    seven :: lir_builder_word(&b)
    five :: lir_builder_word(&b)
    sum :: lir_builder_word(&b)
    twelve :: lir_builder_word(&b)
    matched :: lir_builder_bool(&b)
    lir_builder_push(&b, .StackSlot{dst: slot, size: 16, align: 8})
    lir_builder_push(&b, .Const{dst: seven, value: 7})
    lir_builder_push(&b, .Const{dst: five, value: 5})
    lir_builder_push(&b, .Store{base: slot, offset: 0, value: seven})
    lir_builder_push(&b, .Store{base: slot, offset: 8, value: five})
    lir_builder_push(&b, .Call{dst: Val(sum), signature: LIRSignatureID{value: 1}, callee: .Function{id: LIRFunctionID{value: 1}}, args: [LIRValueID]{slot}})
    lir_builder_push(&b, .Const{dst: twelve, value: 12})
    lir_builder_push(&b, .Compare{dst: matched, condition: .Eq, left: sum, right: twelve})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, .Branch{condition: matched, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    // b1 (follows b0): MAX + 1 overflows.
    largest :: lir_builder_word(&b)
    one :: lir_builder_word(&b)
    wrapped :: lir_builder_bool(&b)
    lir_builder_push(&b, .Const{dst: largest, value: 9223372036854775807})
    lir_builder_push(&b, .Const{dst: one, value: 1})
    lir_builder_push(&b, .Overflows{dst: wrapped, op: .Add, left: largest, right: one})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{}, .Branch{condition: wrapped, then_target: LIRJumpTarget{block: LIRBlockID{value: 3}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 4}, args: [LIRValueID]{}}})
    wrong_compare :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: wrong_compare, value: 99})
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{}, .Return{value: Val(wrong_compare)})
    // b3 (follows b2): reload through the frame, then 17 + 1 does not overflow.
    reloaded :: lir_builder_word(&b)
    partial :: lir_builder_word(&b)
    plus :: lir_builder_word(&b)
    unsigned :: lir_builder_bool(&b)
    twenty_four :: lir_builder_word(&b)
    lir_builder_push(&b, .Load{dst: reloaded, base: slot, offset: 8})
    lir_builder_push(&b, .Binary{dst: partial, op: .Add, left: reloaded, right: sum})
    lir_builder_push(&b, .Binary{dst: plus, op: .Add, left: partial, right: one})
    lir_builder_push(&b, .Const{dst: twenty_four, value: 24})
    lir_builder_push(&b, .Overflows{dst: unsigned, op: .UAdd, left: partial, right: one})
    lir_builder_seal(&b, LIRBlockID{value: 3}, [LIRValueID]{}, .Branch{condition: unsigned, then_target: LIRJumpTarget{block: LIRBlockID{value: 5}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 6}, args: [LIRValueID]{plus, twenty_four}}})
    wrong_overflow :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: wrong_overflow, value: 98})
    lir_builder_seal(&b, LIRBlockID{value: 4}, [LIRValueID]{}, .Return{value: Val(wrong_overflow)})
    wrong_unsigned :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: wrong_unsigned, value: 97})
    lir_builder_seal(&b, LIRBlockID{value: 5}, [LIRValueID]{}, .Return{value: Val(wrong_unsigned)})
    left :: lir_builder_word(&b)
    right :: lir_builder_word(&b)
    answer :: lir_builder_word(&b)
    lir_builder_push(&b, .Binary{dst: answer, op: .Add, left: left, right: right})
    lir_builder_seal(&b, LIRBlockID{value: 6}, [LIRValueID]{left, right}, .Return{value: Val(answer)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    if a.locations[slot.value] != (X64Loc.Frame{value: slot.value}) {
        print("X64 FAIL frame address took a location other than its frame")
        return false
    }
    program :: LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: [LIRLayout]{lir_layout_pointer()}, result: Val(lir_layout_word())}
    }, functions: [LIRFunction]{function, lir_builder_finish(reader)}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable("frame-branch", program, None, 42)
}

// Live ranges split at block boundaries (RegAlloc.jet). Six values cross a
// call in the entry block, where only the five callee-saved registers
// survive it, and are read on every turn of a loop with no call: the loop
// holds all six in registers while the entry block keeps one in its frame
// slot (reloaded once, on the edge into the loop), and the back edge moves
// nothing (each loop result takes its dying operand's register, which is its
// parameter's). A value defined before an if/else and read only on its else
// side holds no segment, so no register, in the then block. With seed 1 the
// six values are 1..6: exit 10 * 21 = 210.
fn x64_fx_split_loop() -> Bool Never! {
    clobber := x64_fx_builder()
    clobber.id = LIRFunctionID{value: 1}
    clobber.signature = LIRSignatureID{value: 1}
    nothing :: lir_builder_word(&clobber)
    lir_builder_push(&clobber, .Const{dst: nothing, value: 0})
    lir_builder_seal(&clobber, LIRBlockID{value: 0}, [LIRValueID]{}, .Return{value: Val(nothing)})

    b := x64_fx_builder()
    seed :: lir_builder_word(&b)
    zero :: lir_builder_word(&b)
    one :: lir_builder_word(&b)
    ten :: lir_builder_word(&b)
    ignored :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: zero, value: 0})
    lir_builder_push(&b, .Const{dst: one, value: 1})
    lir_builder_push(&b, .Const{dst: ten, value: 10})
    crossing := [LIRValueID]{}
    loop k in 1..<7 {
        step :: lir_builder_word(&b)
        value :: lir_builder_word(&b)
        lir_builder_push(&b, .Const{dst: step, value: k})
        lir_builder_push(&b, .Binary{dst: value, op: .Mul, left: seed, right: step})
        &crossing.push(value)
    }
    lir_builder_push(&b, .Call{dst: Val(ignored), signature: LIRSignatureID{value: 1}, callee: .Function{id: LIRFunctionID{value: 1}}, args: [LIRValueID]{}})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{seed}, .Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{zero, zero}}})
    turn :: lir_builder_word(&b)
    total :: lir_builder_word(&b)
    sum := total
    loop value in crossing {
        added :: lir_builder_word(&b)
        lir_builder_push(&b, .Binary{dst: added, op: .Add, left: sum, right: value})
        sum = added
    }
    next_turn :: lir_builder_word(&b)
    more :: lir_builder_bool(&b)
    lir_builder_push(&b, .Binary{dst: next_turn, op: .Add, left: turn, right: one})
    lir_builder_push(&b, .Compare{dst: more, condition: .Lt, left: next_turn, right: ten})
    back :: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{next_turn, sum}}
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{turn, total}, .Branch{condition: more, then_target: back, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{sum}}})
    result :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{result}, .Return{value: Val(result)})
    function :: lir_builder_finish(b)

    a := x64_allocate(function)
    ok := a.spill_slots > 0
    loop segment in a.block_segments[1]..<a.block_segments[2] {
        if a.segment_locations[segment] == .Stack(_) -> ok = false
    }
    split := false
    loop value in crossing {
        loop segment in a.block_segments[0]..<a.block_segments[1] {
            if a.segment_values[segment] == value.value && a.segment_locations[segment] == .Stack(_) -> split = true
        }
    }
    if !split -> ok = false
    x64_enter_block(&a, 1)
    if x64_edge_moves(function, a, back, 1).len() != 0 -> ok = false

    h := x64_fx_builder()
    p :: lir_builder_word(&h)
    origin :: lir_builder_word(&h)
    squared :: lir_builder_word(&h)
    taken :: lir_builder_bool(&h)
    five :: lir_builder_word(&h)
    lir_builder_push(&h, .Const{dst: origin, value: 0})
    lir_builder_push(&h, .Binary{dst: squared, op: .Mul, left: p, right: p})
    lir_builder_push(&h, .Compare{dst: taken, condition: .Eq, left: p, right: origin})
    lir_builder_seal(&h, LIRBlockID{value: 0}, [LIRValueID]{p}, .Branch{condition: taken, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    lir_builder_push(&h, .Const{dst: five, value: 5})
    lir_builder_seal(&h, LIRBlockID{value: 1}, [LIRValueID]{}, .Return{value: Val(five)})
    lir_builder_seal(&h, LIRBlockID{value: 2}, [LIRValueID]{}, .Return{value: Val(squared)})
    hole :: x64_allocate(lir_builder_finish(h))
    loop segment in hole.block_segments[1]..<hole.block_segments[2] {
        if hole.segment_values[segment] == squared.value -> ok = false
    }
    if !ok {
        print("X64 FAIL split-loop allocation")
        return false
    }
    program :: LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: [LIRLayout]{}, result: Val(lir_layout_word())}
    }, functions: [LIRFunction]{function, lir_builder_finish(clobber)}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable("split-loop", program, Val(1), 210)
}

// A Binary followed by the Overflows of the same operands and a branch on it
// is `add; jo` / `imul; jo` (x64_binary_sets_overflow), and a block marked
// cold is laid out last without making a loop of the edge back into the hot
// code (lir_builder_finish, x64_block_depths). Entry n: sum = n + 2 (jo
// cold), prod = sum * sum (jo cold), prod inline test (`add prod, prod; jo
// cold`), exit prod; the cold block exits 7. n = 3 exits 25; n = MAX
// overflows the first add and exits 7.
fn x64_fx_fused_overflow() -> Bool Never! {
    b := x64_fx_builder()
    n :: lir_builder_word(&b)
    two :: lir_builder_word(&b)
    sum :: lir_builder_word(&b)
    carried :: lir_builder_bool(&b)
    lir_builder_push(&b, .Const{dst: two, value: 2})
    lir_builder_push(&b, .Binary{dst: sum, op: .Add, left: n, right: two})
    lir_builder_push(&b, .Overflows{dst: carried, op: .Add, left: n, right: two})
    cold :: LIRBlockID{value: 1}
    lir_builder_mark_cold(&b, cold)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{n}, .Branch{condition: carried, then_target: LIRJumpTarget{block: cold, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{sum}}})
    seven :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: seven, value: 7})
    lir_builder_seal(&b, cold, [LIRValueID]{}, .Return{value: Val(seven)})
    s :: lir_builder_word(&b)
    prod :: lir_builder_word(&b)
    wide :: lir_builder_bool(&b)
    lir_builder_push(&b, .Binary{dst: prod, op: .Mul, left: s, right: s})
    lir_builder_push(&b, .Overflows{dst: wide, op: .Mul, left: s, right: s})
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{s}, .Branch{condition: wide, then_target: LIRJumpTarget{block: cold, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 3}, args: [LIRValueID]{}}})
    tagged :: lir_builder_bool(&b)
    lir_builder_push(&b, .Overflows{dst: tagged, op: .Add, left: prod, right: prod})
    lir_builder_seal(&b, LIRBlockID{value: 3}, [LIRValueID]{}, .Branch{condition: tagged, then_target: LIRJumpTarget{block: cold, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 4}, args: [LIRValueID]{prod}}})
    result :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 4}, [LIRValueID]{result}, .Return{value: Val(result)})
    function :: lir_builder_finish(b)
    ok := function.blocks.len() == 5 && function.blocks[4].id == cold && function.blocks[4].cold && !function.blocks[0].cold
    loop depth in x64_block_depths(function, x64_block_rows(function)) { if depth != 0 -> ok = false }
    folds :: x64_address_folds(function)
    if !x64_binary_sets_overflow(function, folds, function.blocks[0].insts[1], .Add, n, two) -> ok = false
    if !x64_binary_sets_overflow(function, folds, function.blocks[1].insts[0], .Mul, s, s) -> ok = false
    if x64_binary_sets_overflow(function, folds, function.blocks[0].insts[1], .UMul, n, two) -> ok = false
    if x64_binary_sets_overflow(function, folds, function.blocks[0].insts[1], .Add, two, n) -> ok = false
    if !ok {
        print("X64 FAIL fused-overflow layout")
        return false
    }
    program :: LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_word())}
    }, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()}
    x64_fx_executable("fused-overflow", program, Val(3), 25) && x64_fx_executable("fused-overflow-cold", program, Val(9223372036854775807), 7)
}

// The `clobber` callee the split witnesses call: returns 0.
fn x64_fx_clobber() -> LIRFunction Never! {
    clobber := x64_fx_builder()
    clobber.id = LIRFunctionID{value: 1}
    clobber.signature = LIRSignatureID{value: 1}
    nothing :: lir_builder_word(&clobber)
    lir_builder_push(&clobber, .Const{dst: nothing, value: 0})
    lir_builder_seal(&clobber, LIRBlockID{value: 0}, [LIRValueID]{}, .Return{value: Val(nothing)})
    lir_builder_finish(clobber)
}

// `seed * k` for k in 1..<last, appended to the open block.
fn x64_fx_multiples(b: &LIRFunctionBuilder, seed: LIRValueID, last: Int) -> [LIRValueID] Never! {
    values := [LIRValueID]{}
    loop k in 1..<last {
        step :: lir_builder_word(&b)
        value :: lir_builder_word(&b)
        lir_builder_push(&b, .Const{dst: step, value: k})
        lir_builder_push(&b, .Binary{dst: value, op: .Mul, left: seed, right: step})
        &values.push(value)
    }
    values
}

// `start + values[0] + values[1] + ...`, appended to the open block.
fn x64_fx_sum(b: &LIRFunctionBuilder, start: LIRValueID, values: [LIRValueID]) -> LIRValueID Never! {
    sum := start
    loop value in values {
        added :: lir_builder_word(&b)
        lir_builder_push(&b, .Binary{dst: added, op: .Add, left: sum, right: value})
        sum = added
    }
    sum
}

fn x64_fx_call_clobber(b: &LIRFunctionBuilder) Never! {
    ignored :: lir_builder_word(&b)
    lir_builder_push(&b, .Call{dst: Val(ignored), signature: LIRSignatureID{value: 1}, callee: .Function{id: LIRFunctionID{value: 1}}, args: [LIRValueID]{}})
}

fn x64_fx_split_program(function: LIRFunction) -> LIRModule Never! {
    LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: .SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: .SystemV, params: [LIRLayout]{}, result: Val(lir_layout_word())}
    }, functions: [LIRFunction]{function, x64_fx_clobber()}, data: [LIRData]{}, debug: lir_module_debug_none()}
}

// Whether any move of `moves` writes a frame slot.
fn x64_fx_stores(moves: [X64Move]) -> Bool Never! {
    loop move in moves { if move.dst == .Stack(_) -> return true }
    false
}

// A call inside a loop body with eight words live across it (the loop
// counter, the running total and six seed multiples): at most five sit in
// callee-saved registers there, the rest in frame slots, and every turn
// reads them back. With seed 1: 10 turns of 21, exit 210.
fn x64_fx_call_loop() -> Bool Never! {
    b := x64_fx_builder()
    seed :: lir_builder_word(&b)
    zero :: lir_builder_word(&b)
    one :: lir_builder_word(&b)
    ten :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: zero, value: 0})
    lir_builder_push(&b, .Const{dst: one, value: 1})
    lir_builder_push(&b, .Const{dst: ten, value: 10})
    crossing :: x64_fx_multiples(&b, seed, 7)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{seed}, .Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{zero, zero}}})
    turn :: lir_builder_word(&b)
    total :: lir_builder_word(&b)
    x64_fx_call_clobber(&b)
    sum :: x64_fx_sum(&b, total, crossing)
    next_turn :: lir_builder_word(&b)
    more :: lir_builder_bool(&b)
    lir_builder_push(&b, .Binary{dst: next_turn, op: .Add, left: turn, right: one})
    lir_builder_push(&b, .Compare{dst: more, condition: .Lt, left: next_turn, right: ten})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{turn, total}, .Branch{condition: more, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{next_turn, sum}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{sum}}})
    result :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{result}, .Return{value: Val(result)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    spilled := false
    loop segment in a.block_segments[1]..<a.block_segments[2] {
        if a.segment_locations[segment] == .Stack(_) -> spilled = true
    }
    if !spilled {
        print("X64 FAIL call-loop allocation")
        return false
    }
    x64_fx_executable("call-loop", x64_fx_split_program(function), Val(1), 210)
}

// A critical edge with resolution moves: seven seed multiples cross a call in
// the entry block (two of them in frame slots there), which branches on
// `seed == 1` to b1 (sums them, no call; every value in a register) or to b2,
// which adds 100 and jumps to b1 too. The b0 -> b1 edge loads the spilled
// values on the jcc stub path. Seed 1: 28; seed 2: 56 + 100 = 156.
fn x64_fx_critical_edge() -> LIRFunction Never! {
    b := x64_fx_builder()
    seed :: lir_builder_word(&b)
    one :: lir_builder_word(&b)
    hundred :: lir_builder_word(&b)
    taken :: lir_builder_bool(&b)
    lir_builder_push(&b, .Const{dst: one, value: 1})
    lir_builder_push(&b, .Const{dst: hundred, value: 100})
    values :: x64_fx_multiples(&b, seed, 8)
    x64_fx_call_clobber(&b)
    lir_builder_push(&b, .Compare{dst: taken, condition: .Eq, left: seed, right: one})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{seed}, .Branch{condition: taken, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{hundred}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    extra :: lir_builder_word(&b)
    total :: x64_fx_sum(&b, extra, values)
    final :: lir_builder_word(&b)
    lir_builder_push(&b, .Binary{dst: final, op: .Sub, left: total, right: hundred})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{extra}, .Return{value: Val(final)})
    two_hundred :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: two_hundred, value: 200})
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{}, .Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{two_hundred}}})
    lir_builder_finish(b)
}

fn x64_fx_critical_edges() -> Bool Never! {
    function :: x64_fx_critical_edge()
    a := x64_allocate(function)
    x64_enter_block(&a, 0)
    edge :: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{LIRValueID{value: 2}}}
    loaded := false
    loop move in x64_edge_moves(function, a, edge, 1) {
        if move.src == .Stack(_) -> loaded = true
    }
    if !loaded {
        print("X64 FAIL critical-edge allocation")
        return false
    }
    taken :: x64_fx_executable("critical-edge-then", x64_fx_split_program(function), Val(1), 28)
    taken && x64_fx_executable("critical-edge-else", x64_fx_split_program(x64_fx_critical_edge()), Val(2), 156)
}

// A register-to-frame edge store: seven seed multiples live in registers in
// the call-free entry block; b1 calls first, so two of them live in frame
// slots there and the b0 -> b1 edge stores them. Seed 1: 28.
fn x64_fx_edge_store() -> Bool Never! {
    b := x64_fx_builder()
    seed :: lir_builder_word(&b)
    zero :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: zero, value: 0})
    values :: x64_fx_multiples(&b, seed, 8)
    target :: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{seed}, .Jump{target: target})
    x64_fx_call_clobber(&b)
    total :: x64_fx_sum(&b, zero, values)
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{}, .Return{value: Val(total)})
    function :: lir_builder_finish(b)
    a := x64_allocate(function)
    x64_enter_block(&a, 0)
    if !x64_fx_stores(x64_edge_moves(function, a, target, 1)) {
        print("X64 FAIL edge-store allocation")
        return false
    }
    x64_fx_executable("edge-store", x64_fx_split_program(function), Val(1), 28)
}

// Two values share one frame slot: seven seed multiples cross a first call
// (two in frame slots) and die summing to `first`; seven multiples of
// `first` then cross a second call (two more in frame slots). The spans are
// disjoint, so the frame holds two slots, not four. Seed 1: 28 * 28 = 784.
fn x64_fx_shared_slot() -> Bool Never! {
    b := x64_fx_builder()
    seed :: lir_builder_word(&b)
    zero :: lir_builder_word(&b)
    lir_builder_push(&b, .Const{dst: zero, value: 0})
    early :: x64_fx_multiples(&b, seed, 8)
    x64_fx_call_clobber(&b)
    first :: x64_fx_sum(&b, zero, early)
    late :: x64_fx_multiples(&b, first, 8)
    x64_fx_call_clobber(&b)
    second :: x64_fx_sum(&b, zero, late)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{seed}, .Return{value: Val(second)})
    function :: lir_builder_finish(b)
    a :: x64_allocate(function)
    early_slots := [Int]{}
    loop value in early { if a.locations[value.value] == .Stack(slot) -> &early_slots.push(slot) }
    shared := false
    loop value in late {
        if a.locations[value.value] == .Stack(slot) {
            loop other in early_slots { if other == slot -> shared = true }
        }
    }
    if !shared || early_slots.len() == 0 {
        print("X64 FAIL shared-slot allocation: {a.spill_slots} slots")
        return false
    }
    x64_fx_executable("shared-slot", x64_fx_split_program(function), Val(1), 784)
}
