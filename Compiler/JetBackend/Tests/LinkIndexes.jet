// Runtime-pack symbol section-index round trips. Real section indexes never
// alias SHN_ABS/SHN_COMMON, including those exact numbers and indexes > 65535.
fn run() {
    indexes :: [Int]{0, 1, 0xfeff, 0xff00, 0xfff0, 0xfff1, 0xfff2, 0xffff, 0x10000, 0x10100, LINK_ABS, LINK_COMMON}
    symtab := [U8]{}
    xindex := [U8]{}
    loop index in indexes -> link_pack_sym(&symtab, &xindex, 0, 0, index, 0, 0)
    xindex_at :: symtab.len()
    &symtab.extend(xindex)
    c := link_context(^[[U8]]{symtab})
    &c.obj_buffer.push(0)
    &c.obj_symtab.push(0)
    &c.obj_shndx.push(xindex_at)
    &c.obj_count.push(0x10101)
    &c.obj_first_section.push(100)
    loop (k, index) in indexes {
        raw :: link_u16(c.bufs, 0, 24 * k + 6)
        expected_raw :: if index >= 0xff00 -> 0xffff else if index == LINK_ABS -> 0xfff1 else if index == LINK_COMMON -> 0xfff2 else -> index
        if raw != expected_raw -> panic("symbol {k}: raw section {raw}, expected {expected_raw}")
        extended :: link_u32(c.bufs, 0, xindex_at + 4 * k)
        if extended != (if index >= 0xff00 -> index else -> 0) -> panic("symbol {k}: wrong extended index")
        decoded :: link_sym_shndx(c, 0, k)
        expected :: if index == 0 -> LINK_UNDEF else if index < 0 -> index else -> 100 + index
        if decoded != expected -> panic("symbol {k}: decoded section {decoded}, expected {expected}")
    }
    c.obj_shndx[0] = -1
    if link_sym_shndx(c, 0, 3) != LINK_UNDEF -> panic("missing extended table must not become a section")
    print("link section indexes: pass")
}
