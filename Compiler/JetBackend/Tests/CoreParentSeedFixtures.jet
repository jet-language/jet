fn run() {
    private_header :: "// [jet-bootstrap private host: Compiler/Bootstrap/Host/Entry.jet]\n"
    ordinary_factory :: "fn jet_bootstrap_compile() {{}}\n"
    per_source_marker :: "// [jet-bootstrap source: Compiler/Bootstrap/Host/Entry.jet]\n"
    assert(jet_rust_core_parent_source_is_private("Compiler/Bootstrap/Host/Entry.jet", ordinary_factory))
    assert(jet_rust_core_parent_source_is_private("/repo/Compiler/Bootstrap/Host/Entry.jet", ordinary_factory))
    assert(jet_rust_core_parent_source_is_private("compiler.jet", "{private_header}{ordinary_factory}"))
    assert(!jet_rust_core_parent_source_is_private("user.jet", "{ordinary_factory}{per_source_marker}"))
    assert(!jet_rust_core_parent_source_is_private("user.jet", "{ordinary_factory}{private_header}"))
    assert(!jet_rust_core_parent_source_is_private("user.jet", "\n{private_header}{ordinary_factory}"))
    assert(!jet_rust_core_parent_source_is_private("user.jet", ordinary_factory))
    print("Core parent private provenance: PASS; exact assembler header, same-name user/comment refused (7/7)")
    bindings :: JetRustCoreParentSeedBindings{
        host_type: "CheckedHost", request_type: "CheckedRequest", getter_type: "CheckedGetter",
        symbols_type: "CheckedMap", int_from_address: "CheckedInt::from_i64(__jet_address)",
        runtime_initializer: "CheckedRuntime {{ receipt: __jet_receipt_identity, library: __jet_library_identity, symbols: __jet_symbols, export_abis: __jet_export_abis }}",
        request_rows_field: "checked_rows",
        new_call: "checked_parent_new(__jet_original_rows, __jet_runtime)",
        request_call: "checked_request(__jet_request, &__jet_host.checked_original_rows)",
        prepare_call: "checked_factory_prepare(__jet_recipe_request)",
        attach_call: "checked_attach(&mut __jet_host, __jet_prepared)",
        getter_call: "checked_getter(&mut __jet_host, __jet_site_key)",
        abis_decode_call: "checked_abis_decode(__jet_export_abi)",
    }
    first :: jet_rust_emit_core_parent_seed(bindings)
    second :: jet_rust_emit_core_parent_seed(bindings)
    assert_eq(first, second)
    assert(first.contains("OnceLock<Result<::std::sync::Mutex<CheckedHost>, String>>"))
    assert(first.contains("checked_factory_prepare(__jet_recipe_request)"))
    assert(first.contains("checked_attach(&mut __jet_host, __jet_prepared)"))
    assert(first.contains("__jet_request.checked_rows.clone()"))
    assert(first.contains("__jet_admission.library().symbol(__jet_name)"))
    assert(first.contains("get(\"exportABI\")"))
    assert(first.contains("checked_abis_decode(__jet_export_abi)"))
    assert(first.contains("export_abis: __jet_export_abis"))
    assert(!first.contains("dlsym"))
    assert(!first.contains("TypeId"))
    assert(!first.contains("std::any"))
    assert(!first.contains("JetEvalContext"))
    print(first)
    print("Core parent seed determinism: PASS; {first.len()} bytes identical across two generator calls")
}
