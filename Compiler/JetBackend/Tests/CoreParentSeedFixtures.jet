fn run() {
    bindings :: JetRustCoreParentSeedBindings{
        host_type: "CheckedHost", request_type: "CheckedRequest", getter_type: "CheckedGetter",
        symbols_type: "CheckedMap", int_from_address: "CheckedInt::from_i64(__jet_address)",
        runtime_initializer: "CheckedRuntime {{ receipt: __jet_receipt_identity, library: __jet_library_identity, symbols: __jet_symbols }}",
        request_rows_field: "checked_rows",
        new_call: "checked_parent_new(__jet_original_rows, __jet_runtime)",
        request_call: "checked_request(__jet_request, &__jet_host.checked_original_rows)",
        prepare_call: "checked_factory_prepare(__jet_recipe_request)",
        attach_call: "checked_attach(&mut __jet_host, __jet_prepared)",
        getter_call: "checked_getter(&mut __jet_host, __jet_site_key)",
    }
    first :: jet_rust_emit_core_parent_seed(bindings)
    second :: jet_rust_emit_core_parent_seed(bindings)
    assert_eq(first, second)
    assert(first.contains("OnceLock<Result<::std::sync::Mutex<CheckedHost>, String>>"))
    assert(first.contains("checked_factory_prepare(__jet_recipe_request)"))
    assert(first.contains("checked_attach(&mut __jet_host, __jet_prepared)"))
    assert(first.contains("__jet_request.checked_rows.clone()"))
    assert(first.contains("__jet_admission.library().symbol(__jet_name)"))
    assert(!first.contains("dlsym"))
    assert(!first.contains("TypeId"))
    assert(!first.contains("std::any"))
    assert(!first.contains("JetEvalContext"))
    print(first)
    print("Core parent seed determinism: PASS; {first.len()} bytes identical across two generator calls")
}
