// Real MIR -> lir_lower_callables -> mapped code String-static lifetime witness.
// Assembled only by run-lower-fixtures.mjs --callable-statics. The explicit
// runtime-library argument must name the admitted canonical runtime pack;
// there is no substitute constructor/drop implementation in this fixture.
use core.process as process
use jet_foundation.[MIRConstant, MIRConstantDef, MIRFunction, MIRFunctionID, MIROperation, MIRTerminator, MIRTypeDef, mir_function_id]
use jet_backend.[LIRData, LIRDataID, LIRDataReloc, LIRFunction, lir_lower_callables, x64_call_image, x64_call_loaded, x64_load_image, x64_runtime_open, x64_unload_image]

fn cs_require(ok: Bool, name: String) {
    if !ok -> panic("native callable statics proof failed: {name}")
}

fn cs_first_data(function: LIRFunction) -> LIRDataID Never! {
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .DataAddress(_, data) -> return data
        }
    }
    panic("{function.name} has no static data address")
}

fn callable_statics() {
    args :: process.args()
    cs_require(args.len() == 1, "pass the admitted libjet_runtime_c.so path")
    runtime :: x64_runtime_open(args[0])
    cs_require(runtime.errors.len() == 0, "open canonical runtime")

    reader := fx_builder()
    greeting :: fx_value(&reader, fx_string(), fx_borrow(), MIROperation.Global{name: "fixture.greeting"})
    fx_print(&reader, greeting)
    fx_block(&reader, 0, MIRTerminator.Return{value: None})
    program := fx_program([MIRFunction]{fx_function("run", reader, fx_unit())}, [MIRTypeDef]{})
    program.constants = [MIRConstantDef]{fx_static_definition("greeting", fx_string(), MIRConstant.String{value: "héllo"})}
    root :: mir_function_id("run")
    lowered :: lir_lower_callables(program, [MIRFunctionID]{root})
    loop issue in lowered.issues -> print("{issue.function}: {issue.message}")
    cs_require(lowered.issues.len() == 0, "production callable lowering")
    // Resolve this checked callable's init wrapper from the root inventory.
    entry :: lowered.callables.get(root.value) ?? panic("missing callable initialization")
    finalizer :: lowered.finalizer ?? panic("missing callable finalization")
    cs_require(entry.value != 0 && finalizer != entry, "generated init and fini surround the MIR reader")
    flag :: cs_first_data(lowered.lir.functions[entry.value])
    owner :: cs_first_data(lowered.lir.functions[0])
    cs_require(flag != owner, "live flag and String owner are separate cells")

    // Assert the production release path selects the canonical drop, after
    // clearing both flag and owner. Physical execution below observes the cells.
    drops := 0
    loop block in lowered.lir.functions[finalizer.value].blocks {
        stores := 0
        loop inst in block.insts {
            if inst == .Store(_, _, _) -> stores += 1
            if inst == .Call(_, _, .Runtime(symbol), _) && symbol == "jet_rt_string_drop" {
                cs_require(stores == 2, "flag and String cell cleared before canonical drop")
                drops += 1
            }
        }
    }
    cs_require(drops == 1, "one canonical String drop in generated fini")

    // A relocatable observer table only exposes the production cells. It adds
    // no target instructions and never intercepts or replaces a runtime import.
    lir := lowered.lir
    zeros := [U8]{}
    loop _ in 0..<16 -> &zeros.push(U8{0})
    &lir.data.push(LIRData{id: LIRDataID{value: lir.data.len()}, bytes: zeros, align: 8, relocs: [LIRDataReloc]{
        {offset: 0, target: flag, addend: 0},
        {offset: 8, target: owner, addend: 0},
    }})
    call :: x64_call_image(lir, entry, Val(finalizer))
    loop error in call.image.errors -> print(error)
    cs_require(call.image.errors.len() == 0 && call.image.relocs.len() == 2, "native image with two observer relocations")
    loaded :: x64_load_image(call.image, runtime)
    loop error in loaded.errors -> print(error)
    cs_require(loaded.errors.len() == 0, "load production callable")
    fini :: loaded.finalizer ?? panic("loader lost production finalizer")
    #Unsafe("the loaded image owns both observer pointers and their writable static cells through unload; fini is the checked zero-argument Unit function") {
        flag_address :: os_load_word(loaded.base + call.image.relocs[0].at)
        owner_address :: os_load_word(loaded.base + call.image.relocs[1].at)
        cs_require(os_load_word(flag_address) == 0 && os_load_word(owner_address) == 0, "statics start uninitialized")
        cs_require(x64_call_loaded(loaded, call, [Int]{}).errors.len() == 0, "first native call")
        first_owner :: os_load_word(owner_address)
        cs_require(os_load_word(flag_address) == 1 && first_owner != 0, "first call constructs and marks live")
        cs_require(x64_call_loaded(loaded, call, [Int]{}).errors.len() == 0, "second native call")
        cs_require(os_load_word(flag_address) == 1 && os_load_word(owner_address) == first_owner, "second call reuses one owner")
        _ := os_call_address_two(fini, 0, 0)
        cs_require(os_load_word(flag_address) == 0 && os_load_word(owner_address) == 0, "fini drops and clears live statics")
        _ := os_call_address_two(fini, 0, 0)
        cs_require(os_load_word(flag_address) == 0 && os_load_word(owner_address) == 0, "repeated fini is harmless")
        cs_require(x64_call_loaded(loaded, call, [Int]{}).errors.len() == 0, "call after fini reconstructs statics")
        cs_require(os_load_word(flag_address) == 1 && os_load_word(owner_address) != 0, "reinitialized owner is live for unload")
        cs_require(x64_unload_image(loaded), "loader runs production fini before unmap")
    }
    print("native callable String statics: pass")
}
