fn source_resource_metadata_method_program() -> MIRProgram Never! {
    program := source_resource_metadata_program()
    method :: source_resource_mir.MIRTraitMethod{id: MIRTraitMethodID{value: U64{3}}, name: "invoke", span: Span{start: 0, end: 0}, self_access: Val(MIRAccess.Read), params: [], declared_return: None, return_type: mir_type_from_kind(.Int), failure: .Infallible, effects: source_resource_mir.MIREffectFacts{direct: [], solved: [], call_edges: [], maximal: false, direct_spans: []}, is_pure: true, return_view_provenance: None, declared_return_view_provenance: None, default: None}
