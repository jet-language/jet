// MIR -> LIR lowering fixtures: small checked-MIR programs built by hand
// (hello, exact-Int arithmetic, control flow with locals, phis, a switch and a
// range loop, structs, payload and tag enums, Options and string
// interpolation). Each program is lowered, its LIR printed, and every lowering
// issue and LIR lint finding reported. The fixture is assembled into a test
// unit by Compiler/JetBackend/Tests/run-lower-fixtures.mjs and is never listed
// in Compiler/Bootstrap/sources.list.
use jet_foundation.[
    mir_integer_constant,
    MIRAccess,
    MIRAllocatorPolicy,
    MIRArtifactPlan,
    MIRBasicBlock,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryOverflow,
    MIRBlockID,
    MIRCImportLink,
    MIRCLIBinding,
    MIRCLib,
    MIRCOverlayOverride,
    MIRCallArg,
    MIRCallFallibility,
    MIRCallSignature,
    MIRCallbackAdapter,
    MIRCallee,
    MIRCaptureParam,
    MIRCffiFacts,
    MIRCloseAdapter,
    MIRConstant,
    MIRConstantDef,
    MIRCoreCall,
    MIRCoreOwner,
    MIRDropAction,
    MIRDropKind,
    MIREffectFacts,
    MIREnumArg,
    MIRFFIBoundaryFacts,
    MIRFailureCarrier,
    MIRField,
    MIRFieldRow,
    MIRFieldValue,
    MIRForeign,
    MIRFunction,
    MIRFunctionForm,
    MIRFunctionID,
    MIRFunctionKind,
    MIRGenericParam,
    MIRHandleLifecycle,
    MIRHardwareSetup,
    MIRHarnessPlan,
    MIRImplDef,
    MIRImport,
    MIRInstruction,
    MIRJob,
    MIRLinkUnit,
    MIRLocal,
    MIRLocalID,
    MIRModule,
    MIRModuleID,
    MIRNameAlias,
    MIRNameDeclaration,
    MIRNameFacts,
    MIRNameModule,
    MIRNameReference,
    MIRNamedSpan,
    MIROpID,
    MIROperation,
    MIROwnership,
    MIROwnershipMode,
    MIRPackageFacts,
    MIRPanicLoc,
    MIRParam,
    MIRPhiIncoming,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRProgram,
    MIRProjection,
    MIRRuntimeLayer,
    MIRRuntimePartID,
    MIRSchemaMigrationPlan,
    MIRScope,
    MIRSemanticOp,
    MIRSerdeAttribute,
    MIRShapeFieldNames,
    MIRSourceFile,
    MIRSourceFileID,
    MIRStringFormat,
    MIRStringPart,
    MIRStringPartKind,
    MIRStructureFact,
    MIRSwitchArm,
    MIRSymbol,
    MIRTargetApplicability,
    MIRTargetDMAOperationFact,
    MIRTargetDossier,
    MIRTargetHardwareUnresolvedReference,
    MIRTargetHardwareUse,
    MIRTargetInterruptHandlerFact,
    MIRTargetRegisterAccessFact,
    MIRTerminator,
    MIRTestCase,
    MIRTraitDef,
    MIRTraitID,
    MIRType,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRTypeKind,
    MIRUnreachable,
    MIRValueFact,
    MIRValueID,
    MIRVariant,
    MIRVariantPayload,
    MIRVisibility,
    MIRWebParamReconstruction,
    MIR_SCHEMA_VERSION,
    Span,
    mir_copy_ownership,
    mir_copy_value_ownership,
    mir_empty_optimization_facts,
    mir_field_id,
    mir_function_id,
    mir_nominal_ref,
    mir_owned_ownership,
    mir_ownership_from_access,
    mir_type_display_name,
    mir_type_from_kind,
