// A diamond chain Lazy0 -> {a, b} -> Lazy1 -> ... -> Lazy{depth}: every level
// is reachable along 2^level paths. `leaf` is the last level's own field.
fn fx_lazy_diamond(depth: Int, leaf: MIRType) -> [MIRTypeDef] Never! {
    types := [MIRTypeDef]{}
    loop level in 0..<depth {
        owner :: "Lazy{level}"
        next :: fx_named("Lazy{level + 1}")
        &types.push(fx_type_def(owner, MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(owner, "a", next), fx_field(owner, "b", next), fx_field(owner, "label", fx_string())}, methods: [MIRFunctionID]{}}))
    }
    last :: "Lazy{depth}"
    &types.push(fx_type_def(last, MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(last, "leaf", leaf)}, methods: [MIRFunctionID]{}}))
    types
}

fn fx_lazy_clone_program(types: ^[MIRTypeDef]) -> MIRProgram Never! {
    b := fx_builder()
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}

fn fx_lazy_clone_case(name: String, program: MIRProgram, root: String, expected: Bool) -> Bool Never! {
    found :: lower_lazy_type_can_clone(program, fx_named(root))
    if found != expected {
        print("lazy-clone {name}: {found}, expected {expected}")
        return false
    }
    print("lazy-clone {name}: {found}")
    true
}

// lower_lazy_can_clone is the conjunction of every reachable type's own test
// with cycles answering true. A depth-25 diamond (2^25 paths) finishes, and
// small cases keep the per-path answers: all-cloneable true, a single-use
// type anywhere below false, a recursive type true.
fn fx_lazy_clone_checks() -> Bool Never! {
    passed := true
    deep :: fx_lazy_clone_program(fx_lazy_diamond(25, fx_int()))
    if !fx_lazy_clone_case("diamond-25", deep, "Lazy0", true) -> passed = false
    sealed := fx_type_def("Sealed", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Sealed", "token", fx_string())}, methods: [MIRFunctionID]{}})
    sealed.single_use = true
    blocked := fx_lazy_diamond(25, fx_named("Sealed"))
    &blocked.push(sealed.copy())
    if !fx_lazy_clone_case("diamond-25-single-use", fx_lazy_clone_program(^blocked), "Lazy0", false) -> passed = false
    small := fx_lazy_diamond(3, fx_named("Sealed"))
    &small.push(sealed)
    if !fx_lazy_clone_case("diamond-3-single-use", fx_lazy_clone_program(^small), "Lazy0", false) -> passed = false
    if !fx_lazy_clone_case("diamond-3", fx_lazy_clone_program(fx_lazy_diamond(3, fx_int())), "Lazy0", true) -> passed = false
    node :: fx_named("LazyNode")
    recursive :: [MIRTypeDef]{fx_type_def("LazyNode", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("LazyNode", "children", fx_list_type(node)), fx_field("LazyNode", "label", fx_string())}, methods: [MIRFunctionID]{}})}
    if !fx_lazy_clone_case("recursive", fx_lazy_clone_program(recursive), "LazyNode", true) -> passed = false
    passed
}

// Nest0 { a: Nest1, b: Nest1, flag: Bool } ... Nest{depth} { n: Int }: every
// level reaches the next along two member paths. Sizing must not re-walk
// per path (2^depth); the sizes are s(depth) = 8 and
// s(i) = align8(2 * s(i + 1) + 1) = 16 * 2^(depth - i) - 8.
fn fx_nested_records(depth: Int) -> MIRProgram Never! {
    types := [MIRTypeDef]{}
    loop level in 0..<depth {
        owner :: "Nest{level}"
        next :: fx_named("Nest{level + 1}")
        &types.push(fx_type_def(owner, MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(owner, "a", next), fx_field(owner, "b", next), fx_field(owner, "flag", fx_bool())}, methods: [MIRFunctionID]{}}))
    }
    last :: "Nest{depth}"
    &types.push(fx_type_def(last, MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(last, "n", fx_int())}, methods: [MIRFunctionID]{}}))
    b := fx_builder()
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}

fn fx_nested_size_case(name: String, program: MIRProgram, depth: Int) -> Bool Never! {
    expected :: 16 * (1 << depth) - 8
    size :: lower_size(program, fx_named("Nest0"))
    inline :: lower_inline_size(program, fx_named("Nest0"))
    members :: lower_inline_members(program, fx_named("Nest0"))
    end :: lower_members_end(program, members, 0)
    // b follows a; flag follows b.
    half :: 16 * (1 << (depth - 1)) - 8
    placed :: members.len() == 3 && members[0].offset == 0 && members[1].offset == half && members[2].offset == 2 * half
    passed :: size.size == expected && size.align == 8 && inline == expected && end == 2 * half + 1 && placed
    print("nested-size {name}: size {size.size}, inline {inline}, end {end}, expected {expected}")
    passed
}

fn fx_nested_size_checks() -> Bool Never! {
    passed := true
    if !fx_nested_size_case("depth-2", fx_nested_records(2), 2) -> passed = false
    if !fx_nested_size_case("depth-30", fx_nested_records(30), 30) -> passed = false
    if !fx_nested_size_case("depth-30-indexed", lower_indexed_program(fx_nested_records(30)), 30) -> passed = false
    passed
}
