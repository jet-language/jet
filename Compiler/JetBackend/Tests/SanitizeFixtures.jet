// Sanitize-mode witnesses (#4619): LIR/Sanitize.jet checks every heap access
// at its effective address and width, leaves the function's own stack slots
// alone, and its output still passes LIR lint and compiles.
fn san_value(id: Int, layout: LIRLayout) -> LIRValue Never! {
    LIRValue{id: LIRValueID{value: id}, layout: layout, drop: LIRDrop.Trivial, jet_type: None}
}

// fn(p: ptr) -> word: slot := p[8] (8 bytes); p[0] = 1 (1 byte); slot
fn san_module() -> LIRModule Never! {
    p :: LIRValueID{value: 0}
    word :: LIRValueID{value: 1}
    slot :: LIRValueID{value: 2}
    flag :: LIRValueID{value: 3}
    back :: LIRValueID{value: 4}
    values :: [LIRValue]{san_value(0, lir_layout_pointer()), san_value(1, lir_layout_word()), san_value(2, lir_layout_pointer()), san_value(3, lir_layout_bool()), san_value(4, lir_layout_word())}
    insts :: [LIRInst]{
        LIRInst.StackSlot{dst: slot, size: 8, align: 8},
        LIRInst.Load{dst: word, base: p, offset: 8},
        LIRInst.Store{base: slot, offset: 0, value: word},
        LIRInst.Const{dst: flag, value: 1},
        LIRInst.Store{base: p, offset: 0, value: flag},
        LIRInst.Load{dst: back, base: slot, offset: 0},
    }
    signature :: LIRSignature{id: LIRSignatureID{value: 0}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_pointer()}, result: Val(lir_layout_word())}
    block :: LIRBlock{id: LIRBlockID{value: 0}, params: [LIRValueID]{p}, insts: insts, terminator: LIRTerminator.Return{value: Val(back)}, lines: loop _ in 0..<(insts.len() + 1) -> 0, cold: false}
    function :: LIRFunction{id: LIRFunctionID{value: 0}, name: "heap_and_frame", signature: signature.id, values: values, blocks: [LIRBlock]{block}, debug: lir_function_debug_none()}
    LIRModule{signatures: [LIRSignature]{signature}, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()}
}

fn sanitize_fixtures() {
    plain :: san_module()
    assert(lir_lint_module(plain).len() == 0)
    instrumented :: lir_sanitize_module(plain)
    assert(lir_lint_module(instrumented).len() == 0)
    calls := [String]{}
    constants := [Int]{}
    loop inst in instrumented.functions[0].blocks[0].insts {
        if inst == {
            .Call(_, _, callee, _) -> { if callee == .Runtime(symbol) -> &calls.push(symbol) }
            .Const(_, value) -> &constants.push(value)
            else -> {}
        }
    }
    // The heap load (8 bytes at p + 8) and the heap store (1 byte at p) are
    // checked, in program order; the stack slot's store and load are not.
    assert(calls == [String]{"__asan_loadN", "__asan_storeN"})
    // Offset 8 and width 8 for the load, the stored flag 1, width 1 for the store.
    assert(constants == [Int]{8, 8, 1, 1})
    compiled :: x64_compile_module(instrumented)
    assert(compiled.errors.len() == 0)
    print("sanitize fixtures: ok")
}
