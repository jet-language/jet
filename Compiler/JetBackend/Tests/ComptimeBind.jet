// A compile-time batch binds to the comptime session's runtime image
// itself, not a copy (Image/MemoryLink.jet x64_bind_runtime_image_at). A
// bind that fails partway, after the program's object loads (it defines no
// `main`), and the next batch's bind both give the image back byte for
// byte. With the image taken back out, as a batch's bind does
// (JetEval Native.jet jet_eval_native_bind), the bound batch's program part
// alone gives the code and symbols (Image/SessionHost.jet x64_comptime_code,
// x64_comptime_symbols) that the whole file it stands for gives. The names
// a batch calls are asked of that image as its bind looks them up
// (MemoryLink.jet x64_runtime_image_defines), and the image goes back
// unchanged.
use {
    jet_backend.[
        LinkContext,
        LINK_RUN_BASE,
        link_context,
        link_image_view,
        link_synth,
        link_synth_code,
        link_synth_function,
        link_synth_object,
        x64_bind_runtime_image,
        x64_bind_runtime_image_at,
        x64_comptime_code,
        x64_comptime_symbol_address,
        x64_comptime_symbols,
        x64_executable_bytes,
        x64_executable_complete,
        x64_executable_header,
        x64_executable_image_head,
        x64_executable_keep,
        x64_executable_kept,
        x64_executable_segments,
        x64_executable_write,
        x64_image_file_read,
        x64_image_segments,
        x64_runtime_image_defines,
    ]
    bind_files: core.files
    bind_process: core.process
    bind_sys: core.sys
}

// The runtime image of the compiler under test, never this test binary's.
comptime_bind_image_path: fn() -> String {
    jet: bind_sys.get("JET") ?? (bind_process.which("jet") ?? panic("set JET to the compiler under test"))
    parts := jet.split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime/jet_runtime.image"
}

comptime_bind_read: fn(path: String) -> [U8] {
    bind_files.read_bytes(path) ?? panic("the compiler under test has no runtime image at {path}")
}

// A program object whose one function, `name`, returns.
comptime_bind_object: fn(name: String) -> [U8] Never! {
    s := link_synth()
    link_synth_function(s, name)
    link_synth_code(s, [Int]{0xc3})
    link_synth_object(s)
}

// Whether `bytes[from..<from + count]` equals `other[at..<at + count]`.
comptime_bind_same: fn(bytes: [U8], from: Int, other: [U8], at: Int, count: Int) -> Bool Never! {
    if from < 0 || at < 0 || from + count > bytes.len() || at + count > other.len() -> return false
    loop k in 0..<count {
        if bytes[from + k] != other[at + k] -> return false
    }
    true
}

// Whether `image` is the image as read, `reference.bufs[1]`.
comptime_bind_unchanged: fn(image: [U8], reference: LinkContext) -> Bool Never! {
    image.len() == reference.bufs[1].len() && comptime_bind_same(image, 0, reference.bufs[1], 0, image.len())
}

#Test("a comptime batch binds to the runtime image itself and gives it back unchanged") {
    path: comptime_bind_image_path()
    reference := link_context([[U8]]{[U8]{}, comptime_bind_read(path)}, LINK_RUN_BASE)
    view: link_image_view(reference, 1, 0, 0)
    assert(reference.errors.len() == 0, "the runtime image has a program base")
    base: view.program_base
    failed: x64_bind_runtime_image_at("no-main", comptime_bind_object("helper"), comptime_bind_read(path), base, 0, 0)
    assert(failed.errors.len() > 0 && failed.errors[0].contains("does not define `main`"), "a batch without `main` fails after its object loads")
    assert(comptime_bind_unchanged(failed.executable.image, reference), "a failed bind gives the image back unchanged")
    bound := x64_bind_runtime_image_at("batch", comptime_bind_object("main"), failed.executable.image.move(), base, 0, 0)
    assert(bound.errors.len() == 0, "the next batch binds: {bound.errors.join("; ")}")
    assert(comptime_bind_unchanged(bound.executable.image, reference), "a bound batch gives the image back unchanged")
    held: bound.executable.image.move()
    bound.executable.image = [U8]{}
    code: x64_comptime_code(bound.executable, base)
    assert(code.failure == "" && code.segments.len() > 0, "the program part has the batch's segments: {code.failure}")
    part: x64_comptime_symbols(x64_executable_header(bound.executable), bound.executable.tail, bound.executable.tail_at, "", true)
    assert(x64_comptime_symbol_address(part, "jet_rt_alloc") == None, "a batch's symbols are its program's only, none of the image's")
    // The whole file the bind stands for: the image, its patches, the
    // program part.
    bound.executable.image = held.move()
    whole: x64_executable_bytes(bound.executable.move())
    plan: x64_image_segments(whole)
    assert(plan.failure == "", "the whole file is an image: {plan.failure}")
    index := 0
    loop segment in plan.segments {
        if segment.vaddr < base -> next
        assert(index < code.segments.len(), "the program part has every segment from the base up")
        mine: code.segments[index]
        assert(mine.vaddr == segment.vaddr && mine.file_size == segment.file_size && mine.memory_size == segment.memory_size && mine.flags == segment.flags, "segment {index} has the whole file's place, sizes and flags")
        assert(comptime_bind_same(code.bytes, mine.offset, whole, segment.offset, segment.file_size), "segment {index} has the whole file's bytes")
        index += 1
    }
    assert(index == code.segments.len(), "the program part has no segment the whole file lacks")
    all: x64_comptime_symbols(whole, whole, 0, "", true)
    loop name in ([String]{"main", "__jet_bind_main"}) {
        found: x64_comptime_symbol_address(part, name) ?? panic("the program part names no `{name}`")
        assert((x64_comptime_symbol_address(all, name) ?? -1) == found, "`{name}` has the whole file's address")
    }
}

// The session reads the image as `jet run` does, without its loaded
// segments (Image/Loader.jet x64_image_file_read). A batch binds to that
// read and gives it back unchanged; the entry program binds to it and gives
// it back too (x64_executable_image_head), keeping only the first page, and
// its segments and program symbols are those of the whole file it stands
// for, whose symbols name the image's too.
#Test("comptime binds read the runtime image without its loaded segments and give it back") {
    path: comptime_bind_image_path()
    read: x64_image_file_read(path)
    assert(read.failure == "" && read.gap > 0 && read.stamp.len() > 0, "the image file is read without its loaded segments: {read.failure}")
    // A second read to compare the one the binds take with.
    again: x64_image_file_read(path)
    reference := link_context([[U8]]{[U8]{}, again.bytes.move()}, LINK_RUN_BASE)
    view: link_image_view(reference, 1, read.gap_at, read.gap)
    assert(reference.errors.len() == 0, "the image read has a program base")
    batch: x64_bind_runtime_image_at("batch", comptime_bind_object("main"), read.bytes.move(), view.program_base, read.gap_at, read.gap)
    assert(batch.errors.len() == 0, "a batch binds to the image read: {batch.errors.join("; ")}")
    assert(comptime_bind_unchanged(batch.executable.image, reference), "the batch gives the image read back unchanged")
    code: x64_comptime_code(batch.executable, view.program_base)
    assert(code.failure == "" && code.segments.len() > 0, "the batch's program part has its segments: {code.failure}")
    size: read.stamp[2]
    entry := x64_bind_runtime_image("entry", comptime_bind_object("main"), batch.executable.image.move(), path, read.stamp.move(), 0, read.gap_at, read.gap, true)
    assert(entry.errors.len() == 0, "the entry program binds to the image read: {entry.errors.join("; ")}")
    given: entry.executable.image.move()
    entry.executable.image = [U8]{}
    x64_executable_image_head(entry.executable, given)
    assert(comptime_bind_unchanged(given, reference), "the entry program gives the image read back unchanged")
    assert(entry.executable.image.len() == 4096 && entry.executable.image_gap_at == 4096, "the entry program keeps the image's first page")
    assert(entry.executable.image.len() + entry.executable.image_gap == size, "the rest of the image file is the entry program's gap")
    plan: x64_executable_segments(entry.executable)
    part: x64_comptime_symbols(x64_executable_header(entry.executable), entry.executable.tail, entry.executable.tail_at, "", true)
    // The whole file the entry program stands for.
    whole := entry.executable.move()
    assert(x64_executable_complete(whole) == "", "the image file reads whole again")
    file: x64_executable_bytes(whole.move())
    expected: x64_image_segments(file)
    assert(plan.failure == "" && expected.failure == "" && plan.segments.len() == expected.segments.len() && plan.high == expected.high && plan.entry == expected.entry, "the entry program's segments are the whole file's")
    all: x64_comptime_symbols(file, file, 0, "", true)
    loop name in ([String]{"main", "__jet_bind_main"}) {
        found: x64_comptime_symbol_address(part, name) ?? panic("the entry program's part names no `{name}`")
        assert((x64_comptime_symbol_address(all, name) ?? -1) == found, "`{name}` has the whole file's address")
    }
    assert(x64_comptime_symbol_address(part, "jet_rt_alloc") == None, "the entry program's part names its program's symbols only")
    image: comptime_bind_read(path)
    defined: x64_comptime_symbols(image, image, 0, "", true)
    image_alloc: x64_comptime_symbol_address(defined, "jet_rt_alloc") ?? panic("the image names no `jet_rt_alloc`")
    assert((x64_comptime_symbol_address(all, "jet_rt_alloc") ?? -1) == image_alloc, "the whole file names the image's `jet_rt_alloc` at the image's address")
}

// A program bound at the image's base (`jet run`) holds its own symbols
// only; the file written of it, as bound or kept and bound again
// (Image/Loader.jet x64_executable_keep, x64_executable_kept), names the
// image's too, at the image's addresses (MemoryLink.jet
// link_bind_named_tail).
#Test("a program bound at the image's base leaves the image's symbols to its written file, kept or not") {
    path: comptime_bind_image_path()
    read: x64_image_file_read(path)
    assert(read.failure == "", "the image file is read: {read.failure}")
    bound: x64_bind_runtime_image("entry", comptime_bind_object("main"), read.bytes.move(), path, read.stamp.move(), 0, read.gap_at, read.gap, true)
    assert(bound.errors.len() == 0, "the program binds: {bound.errors.join("; ")}")
    part: x64_comptime_symbols(x64_executable_header(bound.executable), bound.executable.tail, bound.executable.tail_at, "", true)
    assert(x64_comptime_symbol_address(part, "jet_rt_alloc") == None, "the program part names its program's symbols only")
    main: x64_comptime_symbol_address(part, "main") ?? panic("the program part names no `main`")
    image: comptime_bind_read(path)
    alloc: x64_comptime_symbol_address(x64_comptime_symbols(image, image, 0, "", true), "jet_rt_alloc") ?? panic("the image names no `jet_rt_alloc`")
    scratch: bind_files.temp_dir("jet-bind-image-symbols") ?? panic("bind scratch")
    written: "{scratch.path}/bound"
    assert(x64_executable_write(bound.executable, written) == "", "the bound program is written")
    kept: "{scratch.path}/kept"
    assert(x64_executable_keep(bound.executable, kept) == "", "the bound program is kept")
    again: x64_executable_kept(kept) ?? panic("the kept program binds to its image again")
    rewritten: "{scratch.path}/rewritten"
    assert(x64_executable_write(again, rewritten) == "", "the kept program is written")
    loop file in ([String]{written, rewritten}) {
        bytes: bind_files.read_bytes(file) ?? panic("{file} reads back")
        all: x64_comptime_symbols(bytes, bytes, 0, "", true)
        assert((x64_comptime_symbol_address(all, "jet_rt_alloc") ?? -1) == alloc, "{file} names the image's `jet_rt_alloc` at the image's address")
        assert((x64_comptime_symbol_address(all, "main") ?? -1) == main, "{file} names the program's `main` at its address")
    }
}

#Test("the runtime image read without its loaded segments answers which names it defines and goes back unchanged") {
    path: comptime_bind_image_path()
    read: x64_image_file_read(path)
    assert(read.failure == "" && read.gap > 0, "the image file is read without its loaded segments: {read.failure}")
    again: x64_image_file_read(path)
    reference := link_context([[U8]]{[U8]{}, again.bytes.move()}, LINK_RUN_BASE)
    images := [[U8]]{read.bytes.move()}
    names: [String]{"jet_rt_alloc", "no_such_runtime_symbol"}
    defined: x64_runtime_image_defines(images, read.gap_at, read.gap, names, [Int]{1, 0, 1})
    assert(defined.len() == 3 && !defined[0] && defined[1] && !defined[2], "the image defines its runtime's `jet_rt_alloc` and no unknown name")
    assert(images.len() == 1 && comptime_bind_unchanged(images[0], reference), "the image goes back unchanged")
    absent := [[U8]]{}
    assert(x64_runtime_image_defines(absent, 0, 0, names, [Int]{0}).len() == 0, "an absent image defines nothing")
}
