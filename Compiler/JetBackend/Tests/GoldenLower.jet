// Golden harness driver: lowers real checked MIR, converted from the Rust
// compiler's MIR by Compiler/JetBackend/Tests/mir-debug.mjs, through the Jet
// backend. For every case named in `cases.txt` it reads `<case>.mird` (the
// entry function id, then the program in the line stream the generated
// `mird_*` decoder reads), keeps the functions the entry reaches, lowers the
// program, optimizes it at the level `opt-level.txt` names (0 without one), and
// either writes the relocatable object `<case>.o` plus, when
// `runtime-pack.txt` names a runtime pack, `<case>.exe`: the object linked with
// that pack by the in-process linker, exactly as native `jet build` links
// (wall time in `<case>.link-ms`; or the link error in `<case>.pack-issues`),
// with an explicit freshly admitted Jet runtime pack; or
// the reasons it could not into `<case>.issues`. One line `<case>\t<status>`
// per case goes to stdout as soon as the case is done, so run-goldens.mjs can
// restart after a crash. The unit is assembled by run-goldens.mjs.
use jet_backend.[lir_lower_entry, lir_optimize_module, lir_print_module, lir_sanitize_module, x64_link_executable, x64_relocatable_object]
use core.files as files
use core.math as math
use core.time as time

struct GLPack {
    path: String
    bytes: [U8]
}

struct MIRDReader {
    lines: [String]
    at: Int
}

fn mird_next(r: &MIRDReader) -> String {
    if r.at >= r.lines.len() -> panic("MIR stream ends at line {r.at}")
    line :: r.lines[r.at]
    r.at = r.at + 1
    line
}

fn mird_int(r: &MIRDReader) -> Int {
    text :: mird_next(&r)
    Int.parse(text) ?? panic("MIR stream line {r.at}: `{text}` is not an integer")
}

fn mird_u64(r: &MIRDReader) -> U64 {
    text :: mird_next(&r)
    value :: Int.parse(text) ?? panic("MIR stream line {r.at}: `{text}` is not an integer")
    U64.from_int(value) ?? panic("MIR stream line {r.at}: `{text}` is not a U64")
}

fn mird_bool(r: &MIRDReader) -> Bool {
    mird_int(&r) != 0
}

fn mird_float(r: &MIRDReader) -> Float {
    math.from_bits(mird_int(&r))
}

fn mird_hex(digit: U8) -> Int {
    if digit >= 97 -> return digit - 87
    digit - 48
}

// `s<text>` holds the text itself; `x<hex>` its UTF-8 bytes in hex.
fn mird_string(r: &MIRDReader) -> String {
    raw :: mird_next(&r).bytes()
    if raw.len() == 0 -> panic("MIR stream line {r.at}: empty string token")
    if raw[0] == (U8{115}) -> return String.from_bytes(raw[1..<raw.len()]) ?? panic("MIR stream line {r.at}: string is not UTF-8")
    bytes := [U8]{}
    i := 1
    loop i + 1 < raw.len() {
        &bytes.push(U8{mird_hex(raw[i]) * 16 + mird_hex(raw[i + 1])})
        i = i + 2
    }
    String.from_bytes(bytes) ?? panic("MIR stream line {r.at}: string is not UTF-8")
}

fn gl_write_issues(name: String, lines: [String]) {
    text := ""
    loop line in lines -> text = "{text}{line}\n"
    files.write("{name}.issues", text) ?? panic("cannot write {name}.issues")
}

fn gl_case(name: String, pack: GLPack, level: Int) -> String {
    text :: files.read("{name}.mird") ?? return "missing"
    r := MIRDReader{lines: text.split("\n").to_list(), at: 0}
    entry_id :: mird_u64(&r)
    lowered :: lir_lower_entry(mird_mir_program(&r), MIRFunctionID{value: entry_id})
    if lowered.issues.len() > 0 {
        lines := [String]{}
        loop issue in lowered.issues -> &lines.push("{issue.function}\t{issue.message}")
        gl_write_issues(name, lines)
        return "unsupported"
    }
    entry :: lowered.entry ?? panic("lowering without issues has an entry")
    lir := lir_optimize_module(^lowered.lir, level)
    hosted_entry :: test_pack_entry(&lir, entry)
    // A `<case>.want-lir` marker asks for the (optimized) LIR as `<case>.lir`.
    if files.exists("{name}.want-lir") {
        files.write("{name}.lir", lir_print_module(lir)) ?? panic("cannot write {name}.lir")
    }
    object :: x64_relocatable_object(lir, hosted_entry)
    if object.errors.len() > 0 {
        lines := [String]{}
        loop error in object.errors -> &lines.push("native\t{error}")
        gl_write_issues(name, lines)
        return "unsupported"
    }
    files.write_bytes("{name}.o", object.bytes) ?? panic("cannot write {name}.o")
    // `sanitize.txt` asks for the AddressSanitizer-instrumented object too, as
    // `<case>.asan.o` (run-sanitized.mjs links it with an ASan runtime).
    if files.exists("sanitize.txt") {
        instrumented :: x64_relocatable_object(lir_sanitize_module(lir), hosted_entry)
        if instrumented.errors.len() > 0 {
            files.write("{name}.asan-issues", "{instrumented.errors[0]}\n") ?? panic("cannot write {name}.asan-issues")
        } else {
            files.write_bytes("{name}.asan.o", instrumented.bytes) ?? panic("cannot write {name}.asan.o")
        }
    }
    watch :: time.start()
    linked :: x64_link_executable([String]{"{name}.o", pack.path}, ^[[U8]]{object.bytes, pack.bytes})
        files.write("{name}.link-ms", "{watch.elapsed_millis()}\n") ?? panic("cannot write {name}.link-ms")
        if linked.errors.len() > 0 {
            report := ""
            loop error in linked.errors -> report = "{report}{error}\n"
            files.write("{name}.pack-issues", report) ?? panic("cannot write {name}.pack-issues")
        } else {
            files.write_bytes("{name}.exe", linked.bytes) ?? panic("cannot write {name}.exe")
            files.set_mode("{name}.exe", 0o755) ?? panic("cannot make {name}.exe executable")
        }
    if linked.errors.len() > 0 -> return "object"
    "pack"
}

// The runtime pack `runtime-pack.txt` names, read once for every case.
fn gl_pack() -> GLPack {
    text :: files.read("runtime-pack.txt") ?? panic("runtime-pack.txt must name an admitted fresh Jet pack")
    path :: text.trim()
    GLPack{path: path, bytes: files.read_bytes(path) ?? panic("cannot read the runtime pack {path}")}
}

// The optimization level `opt-level.txt` names (Compiler/JetBackend/Docs/O1.md); 0 without one.
fn gl_level() -> Int {
    text :: files.read("opt-level.txt") ?? return 0
    Int.parse(text.trim()) ?? panic("opt-level.txt holds `{text.trim()}`, not a level")
}

fn run() {
    list :: files.read("cases.txt") ?? panic("cannot read cases.txt")
    pack :: gl_pack()
    level :: gl_level()
    loop name in list.split("\n").to_list() {
        if name == "" -> next
        print("{name}\t{gl_case(name, pack, level)}")
    }
}
