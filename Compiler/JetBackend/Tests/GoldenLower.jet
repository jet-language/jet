// Golden harness driver: lowers real checked MIR, converted from the Rust
// compiler's MIR by Compiler/JetBackend/Tests/mir-debug.mjs, through the Jet
// backend. For every case named in `cases.txt` it reads `<case>.mird` (the
// entry function id, then the program in the line stream the generated
// `mird_*` decoder reads), lowers the program, and either writes the
// relocatable object `<case>.o` or the reasons it could not into
// `<case>.issues`. One line `<case>\t<status>` per case goes to stdout as soon
// as the case is done, so run-goldens.mjs can restart after a crash. The unit
// is assembled by run-goldens.mjs and never listed in
// Compiler/Bootstrap/sources.list.
use jet_backend.[LIRFunctionID, lir_lower_program, x64_relocatable_object]
use core.files as files
use core.math as math

struct MIRDReader {
    pub lines: [String]
    pub at: Int
}

fn mird_next(r: &MIRDReader) -> String {
    if r.at >= r.lines.len() -> panic("MIR stream ends at line {r.at}")
    line :: r.lines[r.at]
    r.at = r.at + 1
    line
}

fn mird_int(r: &MIRDReader) -> Int {
    text :: mird_next(&r)
    Int.parse(text) ?? panic("MIR stream line {r.at}: `{text}` is not an integer")
}

fn mird_bool(r: &MIRDReader) -> Bool {
    mird_int(&r) != 0
}

fn mird_float(r: &MIRDReader) -> Float {
    math.from_bits(mird_int(&r))
}

fn mird_hex(digit: U8) -> Int {
    if digit >= 97 -> return digit - 87
    digit - 48
}

// `s<text>` holds the text itself; `x<hex>` its UTF-8 bytes in hex.
fn mird_string(r: &MIRDReader) -> String {
    raw :: mird_next(&r).bytes()
    if raw.len() == 0 -> panic("MIR stream line {r.at}: empty string token")
    if raw[0] == (U8{115}) -> return String.from_bytes(raw[1..<raw.len()]) ?? panic("MIR stream line {r.at}: string is not UTF-8")
    bytes := [U8]{}
    i := 1
    loop i + 1 < raw.len() {
        &bytes.push(U8{mird_hex(raw[i]) * 16 + mird_hex(raw[i + 1])})
        i = i + 2
    }
    String.from_bytes(bytes) ?? panic("MIR stream line {r.at}: string is not UTF-8")
}

fn gl_write_issues(name: String, lines: [String]) {
    text := ""
    loop line in lines -> text = "{text}{line}\n"
    files.write("{name}.issues", text) ?? panic("cannot write {name}.issues")
}

fn gl_case(name: String) -> String {
    text :: files.read("{name}.mird") ?? return "missing"
    r := MIRDReader{lines: text.split("\n").to_list(), at: 0}
    entry_id :: mird_int(&r)
    program :: mird_mir_program(&r)
    entry := -1
    loop (index, function) in program.functions {
        if function.id.value == entry_id -> entry = index
    }
    if entry < 0 {
        gl_write_issues(name, [String]{"harness\tentry function {entry_id} is not in the program"})
        return "unsupported"
    }
    lowered :: lir_lower_program(program)
    if lowered.issues.len() > 0 {
        lines := [String]{}
        loop issue in lowered.issues -> &lines.push("{issue.function}\t{issue.message}")
        gl_write_issues(name, lines)
        return "unsupported"
    }
    object :: x64_relocatable_object(lowered.lir, LIRFunctionID{value: entry})
    if object.errors.len() > 0 {
        lines := [String]{}
        loop error in object.errors -> &lines.push("native\t{error}")
        gl_write_issues(name, lines)
        return "unsupported"
    }
    files.write_bytes("{name}.o", object.bytes) ?? panic("cannot write {name}.o")
    "object"
}

fn run() {
    list :: files.read("cases.txt") ?? panic("cannot read cases.txt")
    loop name in list.split("\n").to_list() {
        if name == "" -> next
        print("{name}\t{gl_case(name)}")
    }
}
