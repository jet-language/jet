// Checked borrowing, owned callback materialization and collector transfer.
use jet_foundation.[
    MIRCallArg, MIRCaptureOperand, MIRCopyFact, MIRDropKind,
    MIRFunctionSignature, MIROperation, MIRPreludeABI, MIRPreludeFamily,
    MIRProgram, MIRSemanticOp, MIRTerminator, MIRType, MIRTypeKind, MIRValueID,
    mir_function_id, mir_owned_ownership, mir_type_from_kind,
]

// The callback borrows an owning List<Int>, then returns its MIR-owned copy.
// Drop the flat result, read the original, then drop that too. The compiled
// runtime checker also requires real allocator balance (not drop counters).
// expect-stdout flat-map-owned: "1\n2\n3\n2\n"
// expect-runtime-only flat-map-owned
fn fx_flat_map_owned() -> MIRProgram Never! {
    part_ty :: fx_list_type(fx_int())
    nested_ty :: fx_list_type(part_ty)
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{part_ty}, ret: Val(part_ty), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    a := fx_builder()
    item :: fx_param(&a, "xs", part_ty, fx_borrow())
    copied :: fx_owned(&a, part_ty, MIROperation.Copy{value: item, fact: MIRCopyFact.Materialize})
    fx_block(&a, 0, MIRTerminator.Return{value: Val(copied)})
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    three :: fx_int_const(&b, 3)
    first :: fx_owned(&b, part_ty, MIROperation.BuildList{values: [MIRValueID]{one, two}, trait_coercion: None})
    second :: fx_owned(&b, part_ty, MIROperation.BuildList{values: [MIRValueID]{three}, trait_coercion: None})
    source :: fx_owned(&b, nested_ty, MIROperation.BuildList{values: [MIRValueID]{first, second}, trait_coercion: None})
    callback :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id("flat_map_copy"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    flat :: fx_owned(&b, part_ty, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: source, args: [MIRCallArg]{fx_arg(callback, .Move)}, call: fx_prelude_id("core.list", "flat_map")}})
    indices :: [Int]{0, 1, 2}
    loop index in indices {
        at :: fx_int_const(&b, index)
        value :: fx_list_index(&b, flat, at, fx_int(), false)
        fx_print(&b, value)
    }
    fx_do(&b, MIROperation.Drop{value: flat, kind: MIRDropKind.Value})
    zero :: fx_int_const(&b, 0)
    original :: fx_list_index(&b, source, zero, part_ty, false)
    retained :: fx_list_index(&b, original, one, fx_int(), false)
    fx_print(&b, retained)
    fx_do(&b, MIROperation.Drop{value: source, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(b)
    &p.functions.push(fx_function("flat_map_copy", a, part_ty))
    row := fx_prelude(MIRPreludeFamily.ClosureMethod, "core.list", "flat_map", "jet_list_flat_map", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask[0] = true
    &p.prelude_calls.push(row)
    p
}

// Owned success transfers its input. Borrowed failure preserves the source
// and retires the snapshot, including its unvisited owning error carrier.
// expect-stdout list-try-collect: "true\n2\nfalse\nstop\n3\n"
// expect-runtime-only list-try-collect
fn fx_list_try_collect() -> MIRProgram Never! {
    item_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_int(), err: fx_string()})
    input_ty :: fx_list_type(item_ty)
    output_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_list_type(fx_int()), err: fx_string()})
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    first :: fx_owned(&b, item_ty, MIROperation.ResultOk{value: one})
    second :: fx_owned(&b, item_ty, MIROperation.ResultOk{value: two})
    good :: fx_owned(&b, input_ty, MIROperation.BuildList{values: [MIRValueID]{first, second}, trait_coercion: None})
    success :: fx_list_method(&b, "try_collect", good, None, [MIRValueID]{}, output_ty, true)
    ok :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: success})
    fx_print(&b, ok)
    values :: fx_value(&b, fx_list_type(fx_int()), fx_borrow(), MIROperation.ResultValue{subject: success, ok: true})
    length :: fx_list_method(&b, "len", values, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, length)
    fx_do(&b, MIROperation.Drop{value: success, kind: MIRDropKind.Value})
    early :: fx_owned(&b, item_ty, MIROperation.ResultOk{value: one})
    stop :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "stop"}})
    error :: fx_owned(&b, item_ty, MIROperation.ResultErr{value: stop})
    tail :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "unvisited"}})
    remaining :: fx_owned(&b, item_ty, MIROperation.ResultErr{value: tail})
    bad :: fx_owned(&b, input_ty, MIROperation.BuildList{values: [MIRValueID]{early, error, remaining}, trait_coercion: None})
    root :: fx_local(&b, "bad", input_ty, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: root, value: bad})
    borrowed :: fx_value(&b, input_ty, fx_borrow(), MIROperation.ReadPlace{place: root})
    failure :: fx_list_method(&b, "try_collect", borrowed, Val(root), [MIRValueID]{}, output_ty, true)
    failed :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: failure})
    fx_print(&b, failed)
    message :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.ResultValue{subject: failure, ok: false})
    fx_print(&b, message)
    fx_do(&b, MIROperation.Drop{value: failure, kind: MIRDropKind.Value})
    preserved :: fx_list_method(&b, "len", borrowed, Val(root), [MIRValueID]{}, fx_int(), false)
    fx_print(&b, preserved)
    owned :: fx_owned(&b, input_ty, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(b)
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "try_collect", "jet_list_try_collect", 1, MIRPreludeABI.Value))
    p
}
