// Native container codecs use the production per-type codec.decode/encode
// helpers. Dyn and nested containers need no unported scalar Decode adapter.
// Drop borrowed inputs before inspecting decoded/encoded owners; error cases
// retain every failure, including failures under repeated raw object keys.
use jet_foundation.[
    MIRAccess, MIRCallArg, MIRConstant, MIRDropKind, MIREnumArg, MIRField,
    MIRFieldValue, MIRFunctionID, MIRIndexKind, MIRMeasure, MIROperation,
    MIRPanicContext, MIRPanicLoc, MIRPanicLocal, MIRPreludeABI, MIRPreludeFamily,
    MIRPreludeTypeArg, MIRProgram, MIRSemanticOp, MIRTerminator, MIRTupleField,
    MIRType, MIRTypeDefKind, MIRTypeKind, MIRValueID, MIRVariant,
    MIRVariantPayload, mir_field_id, mir_type_from_kind, mir_type_id,
]

fn fx_cc_errors_type() -> MIRType Never! { fx_list_type(fx_named("FieldError")) }
fn fx_cc_entry_type() -> MIRType Never! {
    fx_tuple_type("DataEntryPair", [MIRTupleField]{MIRTupleField{name: "key", ty: fx_string()}, MIRTupleField{name: "value", ty: fx_named("Dyn")}})
}
fn fx_cc_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_list_program(b)
    &p.types.push(fx_bytes_tree_definition())
    error := fx_type_def("FieldError", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("FieldError", "path", fx_string()), fx_field("FieldError", "reason", fx_string())}, methods: [MIRFunctionID]{}})
    error.key = "<corelib>/native-container-codec-fixture::FieldError"
    &p.types.push(error)
    &p.types.push(fx_type_def("EncodingFormat", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("JSON", MIRVariantPayload.Unit)}, methods: [MIRFunctionID]{}}))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.encoding.codec", "decode_typed", "jet_codec_decode_typed", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.encoding.codec", "encode", "jet_codec_encode", 2, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.index", "index_map", "jet_index_map", 4, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "map_len", "jet_map_len", 1, MIRPreludeABI.Value))
    p
}
fn fx_cc_drop(b: &FxBuilder, value: MIRValueID) Never! { fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value}) }
fn fx_cc_node(b: &FxBuilder, variant: String, payload: MIRValueID?) -> MIRValueID Never! {
    args := [MIREnumArg]{}
    if payload == .Val(value) -> &args.push(MIREnumArg{field: None, value: value, boxed: false})
    fx_owned(&b, fx_named("Dyn"), MIROperation.Enum{type_id: mir_type_id("Dyn"), variant: variant, args: args})
}
fn fx_cc_text(b: &FxBuilder, text: String) -> MIRValueID Never! {
    value :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: text}})
    fx_cc_node(&b, "Text", Val(value))
}
fn fx_cc_array(b: &FxBuilder, values: [MIRValueID]) -> MIRValueID Never! {
    payload :: fx_owned(&b, fx_list_type(fx_named("Dyn")), MIROperation.BuildList{values: values, trait_coercion: None})
    fx_cc_node(&b, "Array", Val(payload))
}
fn fx_cc_entry(b: &FxBuilder, key: String, value: MIRValueID) -> MIRValueID Never! {
    ty :: fx_cc_entry_type()
    name :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: key}})
    fx_owned(&b, ty, MIROperation.Tuple{type_id: mir_type_id("DataEntryPair"), fields: [MIRFieldValue]{MIRFieldValue{field: fx_tuple_field_id(ty, "key"), value: name}, MIRFieldValue{field: fx_tuple_field_id(ty, "value"), value: value}}})
}
fn fx_cc_object(b: &FxBuilder, entries: [MIRValueID]) -> MIRValueID Never! {
    payload :: fx_owned(&b, fx_list_type(fx_cc_entry_type()), MIROperation.BuildList{values: entries, trait_coercion: None})
    fx_cc_node(&b, "Object", Val(payload))
}
fn fx_cc_decode(b: &FxBuilder, source: MIRValueID, target: MIRType) -> MIRValueID Never! {
    result :: mir_type_from_kind(MIRTypeKind.Result{ok: target, err: fx_cc_errors_type()})
    fx_owned(&b, result, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.encoding.codec", "decode_typed"), args: [MIRCallArg]{fx_arg(source, MIRAccess.Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{target}}})
}
fn fx_cc_encode(b: &FxBuilder, source: MIRValueID, target: MIRType) -> MIRValueID Never! {
    format :: fx_copy(&b, fx_named("EncodingFormat"), MIROperation.Enum{type_id: mir_type_id("EncodingFormat"), variant: "JSON", args: [MIREnumArg]{}})
    fx_owned(&b, fx_named("Dyn"), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.encoding.codec", "encode"), args: [MIRCallArg]{fx_arg(format, MIRAccess.Read), fx_arg(source, MIRAccess.Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{target}}})
}
fn fx_cc_status(b: &FxBuilder, result: MIRValueID) Never! {
    status :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: result})
    fx_print(&b, status)
}
fn fx_cc_value(b: &FxBuilder, result: MIRValueID, target: MIRType) -> MIRValueID Never! {
    fx_value(&b, target, fx_borrow(), MIROperation.ResultValue{subject: result, ok: true})
}
fn fx_cc_length(b: &FxBuilder, list: MIRValueID) Never! {
    length :: fx_list_method(&b, "len", list, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, length)
}
fn fx_cc_payload(b: &FxBuilder, tree: MIRValueID, variant: String, ty: MIRType) -> MIRValueID Never! {
    fx_value(&b, ty, fx_borrow(), MIROperation.EnumPayload{subject: tree, owner: mir_type_id("Dyn"), variant: variant, index: 0})
}
fn fx_cc_errors(b: &FxBuilder, result: MIRValueID, count: Int) Never! {
    errors :: fx_value(&b, fx_cc_errors_type(), fx_borrow(), MIROperation.ResultValue{subject: result, ok: false})
    fx_cc_length(&b, errors)
    loop index in 0..<count {
        at :: fx_int_const(&b, index)
        error :: fx_list_index(&b, errors, at, fx_named("FieldError"), false)
        path :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: error, field: mir_field_id("FieldError.path")})
        fx_print(&b, path)
        reason :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: error, field: mir_field_id("FieldError.reason")})
        fx_print(&b, reason)
    }
}

// expect-stdout container-codecs-list: "true\n0\ntrue\n2\nfalse\n2\n[1]\nexpected a list, found null\n[2]\nexpected a list, found Text\n"
fn fx_container_codecs_list() -> MIRProgram Never! {
    b := fx_builder()
    target :: fx_list_type(fx_named("Dyn"))
    loop count in ([Int]{0, 2}) {
        values := [MIRValueID]{}
        loop _ in 0..<count -> &values.push(fx_cc_text(&b, "owned"))
        source :: fx_cc_array(&b, values)
        result :: fx_cc_decode(&b, source, target)
        fx_cc_drop(&b, source)
        fx_cc_status(&b, result)
        decoded :: fx_cc_value(&b, result, target)
        fx_cc_length(&b, decoded)
        fx_cc_drop(&b, result)
    }
    good_null :: fx_cc_node(&b, "Null", None)
    good :: fx_cc_array(&b, [MIRValueID]{good_null})
    bad_null :: fx_cc_node(&b, "Null", None)
    bad_text :: fx_cc_text(&b, "bad")
    source :: fx_cc_array(&b, [MIRValueID]{good, bad_null, bad_text})
    result :: fx_cc_decode(&b, source, fx_list_type(target))
    fx_cc_drop(&b, source)
    fx_cc_status(&b, result)
    fx_cc_errors(&b, result, 2)
    fx_cc_drop(&b, result)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

// expect-stdout container-codecs-option: "true\nfalse\ntrue\ntrue\nowned\ntrue\nowned\n"
fn fx_container_codecs_option() -> MIRProgram Never! {
    b := fx_builder()
    target :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_named("Dyn")})
    source :: fx_cc_node(&b, "Null", None)
    absent :: fx_cc_decode(&b, source, target)
    fx_cc_drop(&b, source)
    fx_cc_status(&b, absent)
    option :: fx_cc_value(&b, absent, target)
    is_some :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: option})
    fx_print(&b, is_some)
    encoded_none :: fx_cc_encode(&b, option, target)
    is_null :: fx_copy(&b, fx_bool(), MIROperation.EnumIs{subject: encoded_none, owner: mir_type_id("Dyn"), variant: "Null"})
    fx_print(&b, is_null)
    fx_cc_drop(&b, encoded_none)
    fx_cc_drop(&b, absent)
    text :: fx_cc_text(&b, "owned")
    present :: fx_cc_decode(&b, text, target)
    fx_cc_drop(&b, text)
    fx_cc_status(&b, present)
    some :: fx_cc_value(&b, present, target)
    inner :: fx_value(&b, fx_named("Dyn"), fx_borrow(), MIROperation.OptionValue{subject: some})
    text_payload :: fx_cc_payload(&b, inner, "Text", fx_string())
    fx_print(&b, text_payload)
    encoded :: fx_cc_encode(&b, some, target)
    fx_cc_drop(&b, present)
    is_text :: fx_copy(&b, fx_bool(), MIROperation.EnumIs{subject: encoded, owner: mir_type_id("Dyn"), variant: "Text"})
    fx_print(&b, is_text)
    encoded_text :: fx_cc_payload(&b, encoded, "Text", fx_string())
    fx_print(&b, encoded_text)
    fx_cc_drop(&b, encoded)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

// expect-stdout container-codecs-bytes: "true\n0\ntrue\n3\n0\n128\n255\ntrue\n3\n0\n128\n255\ntrue\n3\n0\n128\n255\nfalse\n1\n\nexpected a list, found null\n"
fn fx_container_codecs_bytes() -> MIRProgram Never! {
    b := fx_builder()
    byte :: fx_narrow(false, 8)
    target :: fx_list_type(byte)
    loop mode in 0..<3 {
        values := [MIRValueID]{}
        if mode == 1 {
            loop number in ([Int]{0, 128, 255}) -> &values.push(fx_narrow_const(&b, false, 8, number))
        }
        payload :: if mode == 2 -> None else -> Val(fx_owned(&b, target, MIROperation.BuildList{values: values, trait_coercion: None}))
        source :: if mode == 2 -> fx_cc_text(&b, "AID/") else -> fx_cc_node(&b, "Bytes", payload)
        result :: fx_cc_decode(&b, source, target)
        fx_cc_drop(&b, source)
        fx_cc_status(&b, result)
        bytes :: fx_cc_value(&b, result, target)
        fx_cc_length(&b, bytes)
        if mode > 0 {
            loop index in 0..<3 {
                at :: fx_int_const(&b, index)
                value :: fx_list_index(&b, bytes, at, byte, false)
                fx_print(&b, value)
            }
        }
        if mode == 1 {
            encoded :: fx_cc_encode(&b, bytes, target)
            fx_cc_drop(&b, result)
            is_bytes :: fx_copy(&b, fx_bool(), MIROperation.EnumIs{subject: encoded, owner: mir_type_id("Dyn"), variant: "Bytes"})
            fx_print(&b, is_bytes)
            copied :: fx_cc_payload(&b, encoded, "Bytes", target)
            fx_cc_length(&b, copied)
            loop index in 0..<3 {
                at :: fx_int_const(&b, index)
                value :: fx_list_index(&b, copied, at, byte, false)
                fx_print(&b, value)
            }
            fx_cc_drop(&b, encoded)
        } else { fx_cc_drop(&b, result) }
    }
    source :: fx_cc_node(&b, "Null", None)
    failure :: fx_cc_decode(&b, source, target)
    fx_cc_drop(&b, source)
    fx_cc_status(&b, failure)
    fx_cc_errors(&b, failure, 1)
    fx_cc_drop(&b, failure)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

// expect-stdout container-codecs-fixed: "true\n2\nfalse\n1\n\nexpected a fixed list of length 2, found 1\nfalse\n1\n[0]\nexpected a list, found null\n"
fn fx_container_codecs_fixed() -> MIRProgram Never! {
    b := fx_builder()
    tree :: fx_named("Dyn")
    target :: mir_type_from_kind(MIRTypeKind.FixedList{elem: tree, len: MIRMeasure.Literal{kind: "Count", value: 2}})
    a :: fx_cc_text(&b, "a")
    b_text :: fx_cc_text(&b, "b")
    source :: fx_cc_array(&b, [MIRValueID]{a, b_text})
    result :: fx_cc_decode(&b, source, target)
    fx_cc_drop(&b, source)
    fx_cc_status(&b, result)
    decoded :: fx_cc_value(&b, result, target)
    encoded :: fx_cc_encode(&b, decoded, target)
    fx_cc_drop(&b, result)
    encoded_items :: fx_cc_payload(&b, encoded, "Array", fx_list_type(tree))
    fx_cc_length(&b, encoded_items)
    fx_cc_drop(&b, encoded)
    short_null :: fx_cc_node(&b, "Null", None)
    short :: fx_cc_array(&b, [MIRValueID]{short_null})
    failure :: fx_cc_decode(&b, short, target)
    fx_cc_drop(&b, short)
    fx_cc_status(&b, failure)
    fx_cc_errors(&b, failure, 1)
    fx_cc_drop(&b, failure)
    // Element errors take precedence over a simultaneous fixed-length mismatch.
    bad_null :: fx_cc_node(&b, "Null", None)
    bad :: fx_cc_array(&b, [MIRValueID]{bad_null})
    nested :: mir_type_from_kind(MIRTypeKind.FixedList{elem: fx_list_type(tree), len: MIRMeasure.Literal{kind: "Count", value: 2}})
    nested_failure :: fx_cc_decode(&b, bad, nested)
    fx_cc_drop(&b, bad)
    fx_cc_status(&b, nested_failure)
    fx_cc_errors(&b, nested_failure, 1)
    fx_cc_drop(&b, nested_failure)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

fn fx_cc_map_at(b: &FxBuilder, map: MIRValueID, key: String, target: MIRType) -> MIRValueID Never! {
    name :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: key}})
    value :: fx_value(&b, target, fx_borrow(), MIROperation.Index{call: fx_prelude_id("core.index", "index_map"), base: map, index: name, kind: MIRIndexKind.Map, access: MIRAccess.Read, location: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0}, context: MIRPanicContext{function: "run", source_line: "map[key]", caret: 1, locals: [MIRPanicLocal]{}}})
    fx_cc_drop(&b, name)
    value
}
// expect-stdout container-codecs-map: "true\n2\n2\nk\n2\na\nfalse\n3\nk[0]\nexpected a list, found null\nk[1]\nexpected a list, found null\nx\nexpected a list, found null\nfalse\n1\nk\nexpected a list, found null\nfalse\n1\n\nexpected an object, found null\n"
fn fx_container_codecs_map() -> MIRProgram Never! {
    b := fx_builder()
    tree :: fx_named("Dyn")
    list :: fx_list_type(tree)
    target :: mir_type_from_kind(MIRTypeKind.Map{key: fx_string(), value: list})
    first_null :: fx_cc_node(&b, "Null", None)
    first_array :: fx_cc_array(&b, [MIRValueID]{first_null})
    first :: fx_cc_entry(&b, "k", first_array)
    middle_array :: fx_cc_array(&b, [MIRValueID]{})
    middle :: fx_cc_entry(&b, "z", middle_array)
    last_a :: fx_cc_text(&b, "a")
    last_b :: fx_cc_text(&b, "b")
    last_array :: fx_cc_array(&b, [MIRValueID]{last_a, last_b})
    last :: fx_cc_entry(&b, "k", last_array)
    source :: fx_cc_object(&b, [MIRValueID]{first, middle, last})
    result :: fx_cc_decode(&b, source, target)
    fx_cc_drop(&b, source)
    fx_cc_status(&b, result)
    map :: fx_cc_value(&b, result, target)
    selected :: fx_cc_map_at(&b, map, "k", list)
    fx_cc_length(&b, selected)
    encoded :: fx_cc_encode(&b, map, target)
    fx_cc_drop(&b, result)
    entries :: fx_cc_payload(&b, encoded, "Object", fx_list_type(fx_cc_entry_type()))
    fx_cc_length(&b, entries)
    zero :: fx_int_const(&b, 0)
    entry :: fx_list_index(&b, entries, zero, fx_cc_entry_type(), false)
    entry_key :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: entry, field: fx_tuple_field_id(fx_cc_entry_type(), "key")})
    fx_print(&b, entry_key)
    nested_tree :: fx_value(&b, tree, fx_borrow(), MIROperation.Field{base: entry, field: fx_tuple_field_id(fx_cc_entry_type(), "value")})
    nested_items :: fx_cc_payload(&b, nested_tree, "Array", list)
    fx_cc_length(&b, nested_items)
    first_index :: fx_int_const(&b, 0)
    first_text :: fx_list_index(&b, nested_items, first_index, tree, false)
    first_payload :: fx_cc_payload(&b, first_text, "Text", fx_string())
    fx_print(&b, first_payload)
    fx_cc_drop(&b, encoded)
    bad_first :: fx_cc_node(&b, "Null", None)
    bad_second :: fx_cc_node(&b, "Null", None)
    bad_values :: fx_cc_array(&b, [MIRValueID]{bad_first, bad_second})
    bad_k :: fx_cc_entry(&b, "k", bad_values)
    bad_x_null :: fx_cc_node(&b, "Null", None)
    bad_x :: fx_cc_entry(&b, "x", bad_x_null)
    bad :: fx_cc_object(&b, [MIRValueID]{bad_k, bad_x})
    nested :: mir_type_from_kind(MIRTypeKind.Map{key: fx_string(), value: fx_list_type(list)})
    failure :: fx_cc_decode(&b, bad, nested)
    fx_cc_drop(&b, bad)
    fx_cc_status(&b, failure)
    fx_cc_errors(&b, failure, 3)
    fx_cc_drop(&b, failure)
    repeat_null :: fx_cc_node(&b, "Null", None)
    repeat_first :: fx_cc_entry(&b, "k", repeat_null)
    repeat_empty :: fx_cc_array(&b, [MIRValueID]{})
    repeat_last :: fx_cc_entry(&b, "k", repeat_empty)
    repeated :: fx_cc_object(&b, [MIRValueID]{repeat_first, repeat_last})
    repeat_failure :: fx_cc_decode(&b, repeated, target)
    fx_cc_drop(&b, repeated)
    fx_cc_status(&b, repeat_failure)
    fx_cc_errors(&b, repeat_failure, 1)
    fx_cc_drop(&b, repeat_failure)
    null :: fx_cc_node(&b, "Null", None)
    wrong_kind :: fx_cc_decode(&b, null, target)
    fx_cc_drop(&b, null)
    fx_cc_status(&b, wrong_kind)
    fx_cc_errors(&b, wrong_kind, 1)
    fx_cc_drop(&b, wrong_kind)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

// expect-stdout container-codecs-base64: "true\n1\n0\nfalse\n1\n\ninvalid base64 at byte 1: non-zero unused bits\nfalse\n1\n\ninvalid base64 at byte 2: expected 2 padding characters\nfalse\n1\n\ninvalid base64 at byte 0: ASCII whitespace is not allowed\n"
fn fx_container_codecs_base64() -> MIRProgram Never! {
    b := fx_builder()
    byte :: fx_narrow(false, 8)
    target :: fx_list_type(byte)
    valid :: fx_cc_text(&b, "AA==")
    result :: fx_cc_decode(&b, valid, target)
    fx_cc_drop(&b, valid)
    fx_cc_status(&b, result)
    bytes :: fx_cc_value(&b, result, target)
    fx_cc_length(&b, bytes)
    zero :: fx_int_const(&b, 0)
    first :: fx_list_index(&b, bytes, zero, byte, false)
    fx_print(&b, first)
    fx_cc_drop(&b, result)
    loop text in ([String]{"Zh==", "AA", " AA=="}) {
        source :: fx_cc_text(&b, text)
        failure :: fx_cc_decode(&b, source, target)
        fx_cc_drop(&b, source)
        fx_cc_status(&b, failure)
        fx_cc_errors(&b, failure, 1)
        fx_cc_drop(&b, failure)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}

// expect-stdout container-codecs-paths: "false\n1\n[0].x\nexpected a list, found null\nfalse\n1\nk.x\nexpected a list, found null\n"
fn fx_container_codecs_paths() -> MIRProgram Never! {
    b := fx_builder()
    values :: fx_list_type(fx_named("Dyn"))
    map :: mir_type_from_kind(MIRTypeKind.Map{key: fx_string(), value: values})
    child_null :: fx_cc_node(&b, "Null", None)
    child_entry :: fx_cc_entry(&b, "x", child_null)
    child :: fx_cc_object(&b, [MIRValueID]{child_entry})
    source :: fx_cc_array(&b, [MIRValueID]{child})
    result :: fx_cc_decode(&b, source, fx_list_type(map))
    fx_cc_drop(&b, source)
    fx_cc_status(&b, result)
    fx_cc_errors(&b, result, 1)
    fx_cc_drop(&b, result)
    inner_null :: fx_cc_node(&b, "Null", None)
    inner_entry :: fx_cc_entry(&b, "x", inner_null)
    inner :: fx_cc_object(&b, [MIRValueID]{inner_entry})
    outer_entry :: fx_cc_entry(&b, "k", inner)
    outer :: fx_cc_object(&b, [MIRValueID]{outer_entry})
    failure :: fx_cc_decode(&b, outer, mir_type_from_kind(MIRTypeKind.Map{key: fx_string(), value: map}))
    fx_cc_drop(&b, outer)
    fx_cc_status(&b, failure)
    fx_cc_errors(&b, failure, 1)
    fx_cc_drop(&b, failure)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_cc_program(b)
}
