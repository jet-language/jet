// Stop points of the unified execution host (#4720; Lower.jet lower_poll,
// lower_stopped, lower_scope's Shield): the MIR a stop-point compilation
// produces (JetCodegen Builder.jet jet_codegen_emit_poll) for
//
// fn twice(n: Int) -> Int { n + n }
// fn label() -> String { "kept" }
// fn run() {
//     print(twice(21))
//     s :: label()
//     loop i in 0..<2 { print(i) }
//     shield { print(twice(3)) }
//     print(twice(5))
//     print(s)
// }
//
// with a Check at each function entry and at the loop's continue target, a
// Propagate after each call outside the Shield, and stop edges that drop
// exactly the values live there (never a call result before its resume edge).
// The static image's runtime is no session child, so nothing ever stops it.
// check-native-fixtures.mjs also links stop-points.o with the compiled runtime
// and a scripted session rail (check-stop-points.c) that stops it at chosen
// polls and counts the String the program owns.
use jet_foundation.[
    MIRAccess, MIRBinaryOp, MIRBlockID, MIRCallArg, MIRCallee, MIRConstant,
    MIRDropKind, MIRFunction, MIROperation, MIRPollKind, MIRProgram, MIRScope,
    MIRScopeFact, MIRScopeID, MIRScopeKind, MIRTerminator, MIRType, MIRTypeDef,
    mir_function_id,
]

// expect-stdout stop-points: "42\n0\n1\n6\n10\nkept\n"
// expect-static-only stop-points
fn fx_stop_points() -> MIRProgram Never! {
    // twice: b0 Check -> b1 | b2 Stopped
    t := fx_builder()
    n :: fx_param(&t, "n", fx_int(), mir_copy_ownership())
    fx_block(&t, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    doubled :: fx_int_op(&t, MIRBinaryOp.Add, "add", n, n)
    fx_block(&t, 1, MIRTerminator.Return{value: Val(doubled)})
    fx_block(&t, 2, MIRTerminator.Stopped)

    // label: b0 Check -> b1 | b2 Stopped; the owned result exists only on b1.
    l := fx_builder()
    fx_block(&l, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    text :: fx_owned(&l, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "kept"}})
    fx_block(&l, 1, MIRTerminator.Return{value: Val(text)})
    fx_block(&l, 2, MIRTerminator.Stopped)

    r := fx_builder()
    stop :: MIRBlockID{value: 20}
    fx_block(&r, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: stop})
    twenty_one :: fx_int_const(&r, 21)
    first :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(twenty_one, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&r, 1, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 2}, stop: stop})
    fx_print(&r, first)
    kept :: fx_owned(&r, fx_string(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("label")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 2, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 3}, stop: stop})
    zero :: fx_int_const(&r, 0)
    two :: fx_int_const(&r, 2)
    cursor :: fx_owned(&r, fx_named("RangeCursor"), MIROperation.LoopRangeInit{call: fx_prelude_id("core.loop", "loop_range_init"), start: zero, end: two, step: None, exclusive: true})
    fx_block(&r, 3, MIRTerminator.Jump{target: MIRBlockID{value: 4}})
    // The loop's continue target: its Check stops with `kept` and the cursor live.
    fx_block(&r, 4, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 5}, stop: MIRBlockID{value: 21}})
    has_next :: fx_copy(&r, fx_bool(), MIROperation.LoopRangeHasNext{call: fx_prelude_id("core.loop", "loop_range_has_next"), cursor: cursor})
    fx_block(&r, 5, MIRTerminator.Branch{condition: has_next, then_target: MIRBlockID{value: 6}, else_target: MIRBlockID{value: 8}})
    item :: fx_copy(&r, fx_int(), MIROperation.LoopRangeValue{call: fx_prelude_id("core.loop", "loop_range_value"), cursor: cursor})
    fx_print(&r, item)
    fx_block(&r, 6, MIRTerminator.Jump{target: MIRBlockID{value: 7}})
    fx_do(&r, MIROperation.LoopRangeAdvance{call: fx_prelude_id("core.loop", "loop_range_advance"), cursor: cursor})
    fx_block(&r, 7, MIRTerminator.Continue{target: MIRBlockID{value: 4}})
    fx_do(&r, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    // Inside the Shield the builder places no stop points; twice's own entry
    // Check is masked there.
    shield :: MIRScopeID{value: 1}
    fx_do(&r, MIROperation.ScopeEnter{scope: shield, test_member: None})
    three :: fx_int_const(&r, 3)
    shielded :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(three, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&r, shielded)
    fx_do(&r, MIROperation.ScopeExit{scope: shield})
    five :: fx_int_const(&r, 5)
    last :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(five, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&r, 8, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 9}, stop: MIRBlockID{value: 22}})
    fx_print(&r, last)
    fx_print(&r, kept)
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 9, MIRTerminator.Return{value: None})
    fx_block(&r, 20, MIRTerminator.Stopped)
    fx_do(&r, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 21, MIRTerminator.Stopped)
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 22, MIRTerminator.Stopped)
    run := fx_function("run", r, fx_unit())
    run.scopes = [MIRScope]{MIRScope{id: shield, kind: MIRScopeKind.Shield, span: fx_span(), name: None, deadline: None, facts: [MIRScopeFact]{}}}
    fx_program([MIRFunction]{fx_function("twice", t, fx_int()), fx_function("label", l, fx_string()), run}, [MIRTypeDef]{})
}
