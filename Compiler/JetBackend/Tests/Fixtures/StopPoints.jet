// Stop points of the unified execution host (#4720; Lower.jet lower_poll,
// lower_stopped, lower_scope's Shield): the MIR a stop-point compilation
// produces (JetCodegen Builder.jet jet_codegen_emit_poll) for
//
// fn twice(n: Int) -> Int { n + n }
// fn label() -> String { "kept" }
// fn run() {
//     print(twice(21))
//     s :: label()
//     loop i in 0..<2 { print(i) }
//     shield { print(twice(3)) }
//     print(twice(5))
//     print(s)
// }
//
// with a Check at each function entry and at the loop's continue target, a
// Propagate after each call outside the Shield, and stop edges that drop
// exactly the values live there (never a call result before its resume edge).
// The static image's runtime is no session child, so nothing ever stops it.
// check-native-fixtures.mjs also links stop-points.o with the compiled runtime
// and a scripted session rail (check-stop-points.c) that stops it at chosen
// polls and counts the String the program owns.
use jet_foundation.[
    MIRAccess, MIRBinaryOp, MIRBlockID, MIRCallArg, MIRCallee, MIRCaptureOperand, MIRConstant,
    MIRDropKind, MIRFunction, MIRFunctionID, MIRFunctionSignature, MIROperation, MIRPollKind,
    MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRScope, MIRScopeFact, MIRScopeID, MIRScopeKind,
    MIRSemanticOp, MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind, MIRUnsafeGate, MIRValueID,
    mir_function_id, mir_type_from_kind,
]
use jet_backend.[LIRModule, lir_lower_callables, lir_optimize_module, x64_compile_module]

// The exact predicate used by Builder and Legality: a raw Source Deref gets
// Propagate; Shared/ref reads and missing operand metadata do not.
fn fx_can_stop_deref_check() -> Bool Never! {
    deref :: MIROperation.Deref{value: MIRValueID{value: 1}}
    raw :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Ptr"), args: [MIRType]{fx_i64()}})
    shared :: mir_type_from_kind(MIRTypeKind.Shared{inner: fx_i64()})
    guard :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("SharedGuard"), args: [MIRType]{fx_i64()}})
    malformed :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Ptr"), args: [MIRType]{}})
    mir_operation_can_stop(deref, Val(raw), None, [MIRPreludeCall]{}, [U64:Int]{}) &&
        !mir_operation_can_stop(deref, Val(shared), None, [MIRPreludeCall]{}, [U64:Int]{}) &&
        !mir_operation_can_stop(deref, Val(guard), None, [MIRPreludeCall]{}, [U64:Int]{}) &&
        !mir_operation_can_stop(deref, Val(fx_i64()), None, [MIRPreludeCall]{}, [U64:Int]{}) &&
        !mir_operation_can_stop(deref, Val(malformed), None, [MIRPreludeCall]{}, [U64:Int]{}) &&
        !mir_operation_can_stop(deref, None, None, [MIRPreludeCall]{}, [U64:Int]{})
}

// expect-stdout stop-points: "42\n0\n1\n6\n10\nkept\n"
// expect-static-only stop-points
fn fx_stop_points() -> MIRProgram Never! {
    if !fx_can_stop_deref_check() -> panic("raw Ptr alone requires Deref Propagate")
    // twice: b0 Check -> b1 | b2 Stopped
    t := fx_builder()
    n :: fx_param(&t, "n", fx_int(), mir_copy_ownership())
    fx_block(&t, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    doubled :: fx_int_op(&t, MIRBinaryOp.Add, "add", n, n)
    fx_block(&t, 1, MIRTerminator.Return{value: Val(doubled)})
    fx_block(&t, 2, MIRTerminator.Stopped)

    // label: b0 Check -> b1 | b2 Stopped; the owned result exists only on b1.
    l := fx_builder()
    fx_block(&l, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    text :: fx_owned(&l, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "kept"}})
    fx_block(&l, 1, MIRTerminator.Return{value: Val(text)})
    fx_block(&l, 2, MIRTerminator.Stopped)

    r := fx_builder()
    stop :: MIRBlockID{value: 20}
    fx_block(&r, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: stop})
    twenty_one :: fx_int_const(&r, 21)
    first :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(twenty_one, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&r, 1, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 2}, stop: stop})
    fx_print(&r, first)
    kept :: fx_owned(&r, fx_string(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("label")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 2, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 3}, stop: stop})
    zero :: fx_int_const(&r, 0)
    two :: fx_int_const(&r, 2)
    cursor :: fx_owned(&r, fx_named("RangeCursor"), MIROperation.LoopRangeInit{call: fx_prelude_id("core.loop", "loop_range_init"), start: zero, end: two, step: None, exclusive: true})
    fx_block(&r, 3, MIRTerminator.Jump{target: MIRBlockID{value: 4}})
    // The loop's continue target: its Check stops with `kept` and the cursor live.
    fx_block(&r, 4, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 5}, stop: MIRBlockID{value: 21}})
    has_next :: fx_copy(&r, fx_bool(), MIROperation.LoopRangeHasNext{call: fx_prelude_id("core.loop", "loop_range_has_next"), cursor: cursor})
    fx_block(&r, 5, MIRTerminator.Branch{condition: has_next, then_target: MIRBlockID{value: 6}, else_target: MIRBlockID{value: 8}})
    item :: fx_copy(&r, fx_int(), MIROperation.LoopRangeValue{call: fx_prelude_id("core.loop", "loop_range_value"), cursor: cursor})
    fx_print(&r, item)
    fx_block(&r, 6, MIRTerminator.Jump{target: MIRBlockID{value: 7}})
    fx_do(&r, MIROperation.LoopRangeAdvance{call: fx_prelude_id("core.loop", "loop_range_advance"), cursor: cursor})
    fx_block(&r, 7, MIRTerminator.Continue{target: MIRBlockID{value: 4}})
    fx_do(&r, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    // Inside the Shield the builder places no stop points; twice's own entry
    // Check is masked there.
    shield :: MIRScopeID{value: 1}
    fx_do(&r, MIROperation.ScopeEnter{scope: shield, test_member: None})
    three :: fx_int_const(&r, 3)
    shielded :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(three, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&r, shielded)
    fx_do(&r, MIROperation.ScopeExit{scope: shield})
    five :: fx_int_const(&r, 5)
    last :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("twice")}, args: [MIRCallArg]{fx_arg(five, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&r, 8, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 9}, stop: MIRBlockID{value: 22}})
    fx_print(&r, last)
    fx_print(&r, kept)
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 9, MIRTerminator.Return{value: None})
    fx_block(&r, 20, MIRTerminator.Stopped)
    fx_do(&r, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 21, MIRTerminator.Stopped)
    fx_do(&r, MIROperation.Drop{value: kept, kind: MIRDropKind.Value})
    fx_block(&r, 22, MIRTerminator.Stopped)
    run := fx_function("run", r, fx_unit())
    run.scopes = [MIRScope]{MIRScope{id: shield, kind: MIRScopeKind.Shield, span: fx_span(), name: None, deadline: None, facts: [MIRScopeFact]{}}}
    fx_program([MIRFunction]{fx_function("twice", t, fx_int()), fx_function("label", l, fx_string()), run}, [MIRTypeDef]{})
}

// [ThreadWord(16) reads, jet_rt_session_poll calls, jet_rt_session_propagate
// calls, rail calls in a block that also reads the thread word].
fn fx_stop_poll_counts(program: LIRModule) -> [Int] Never! {
    words := 0
    polls := 0
    propagates := 0
    shared := 0
    loop function in program.functions {
        loop block in function.blocks {
            reads := false
            calls := 0
            loop instruction in block.insts {
                if instruction == .ThreadWord(_, offset) {
                    if offset == 16 {
                        words += 1
                        reads = true
                    }
                }
                if instruction == .Call(_, _, callee, _) {
                    if callee == .Runtime(symbol) {
                        if symbol == "jet_rt_session_poll" {
                            polls += 1
                            calls += 1
                        }
                        if symbol == "jet_rt_session_propagate" {
                            propagates += 1
                            calls += 1
                        }
                    }
                }
            }
            if reads -> shared += calls
        }
    }
    [Int]{words, polls, propagates, shared}
}

// The same stop points lowered for the runtime pack (Lower.jet lower_poll):
// each of the 7 Polls reads the current control with one ThreadWord(16) and
// calls the session rail only from its own slow block, never from the block
// that reads the control; the freestanding lowering keeps one call per Poll
// and no thread word. Writes each function's O0 and O1 x86-64 as
// `<name>-o<level>.<function>.bin` for disassembly.
fn fx_report_stop_points_pack(name: String) -> Bool {
    print("== {name}")
    program := fx_stop_points()
    roots :: [MIRFunctionID]{mir_function_id("twice"), mir_function_id("label"), mir_function_id("run")}
    plain :: lir_lower_callables(program, roots)
    program.native_pack = true
    packed :: lir_lower_callables(program, roots)
    loop issue in plain.issues -> print("issue freestanding {issue.function}: {issue.message}")
    loop issue in packed.issues -> print("issue pack {issue.function}: {issue.message}")
    if plain.issues.len() > 0 || packed.issues.len() > 0 -> return false
    print(lir_print_module(packed.lir))
    plain_counts :: fx_stop_poll_counts(plain.lir)
    packed_counts :: fx_stop_poll_counts(packed.lir)
    clean := plain_counts == [Int]{0, 4, 3, 0} && packed_counts == [Int]{7, 4, 3, 0}
    print("{name}: freestanding {plain_counts}, runtime pack {packed_counts}")
    loop level in 0..<2 {
        lowered := packed.lir.copy()
        optimized :: lir_optimize_module(^lowered, level)
        if level > 0 {
            counts :: fx_stop_poll_counts(optimized)
            print("{name}: O{level} {counts}")
            if counts[0] != 7 || counts[3] != 0 -> clean = false
        }
        compiled :: x64_compile_module(optimized)
        loop error in compiled.errors -> print("x64 {name} O{level}: {error}")
        if compiled.errors.len() > 0 -> return false
        loop function in compiled.functions {
            path :: "{name}-o{level}.{function.name}.bin"
            files.write_bytes(path, function.code) ?? panic("cannot write {path}")
            print("{name}: O{level} {function.name} {function.code.len()} bytes")
        }
    }
    clean
}

// An inline ClosureMethod in a stop-point module (Combinators.jet
// lower_callback_guard):
//
// fn double(n: Int) -> Int { n + n }      // its own entry Check
// fn run() { xs :: [1, 2, 3]; print(xs.map(double)) }
//
// The map's element loop tests the delivered stop after every callback; a
// stopped callback leaves the partial result and the moved closure released
// and takes the call's Propagate edge (which drops `xs`).
// expect-stdout stop-points-map: "[2, 4, 6]\n"
// expect-static-only stop-points-map
fn fx_stop_points_map() -> MIRProgram Never! {
    ints :: fx_list_type(fx_int())
    d := fx_builder()
    n :: fx_param(&d, "n", fx_int(), mir_copy_ownership())
    fx_block(&d, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    doubled :: fx_int_op(&d, MIRBinaryOp.Add, "add", n, n)
    fx_block(&d, 1, MIRTerminator.Return{value: Val(doubled)})
    fx_block(&d, 2, MIRTerminator.Stopped)
    r := fx_builder()
    items := [MIRValueID]{}
    loop value in ([Int]{1, 2, 3}) -> &items.push(fx_int_const(&r, value))
    xs :: fx_owned(&r, ints, MIROperation.BuildList{values: items, trait_coercion: None})
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{fx_int()}, ret: Val(fx_int()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    callback :: fx_owned(&r, fn_ty, MIROperation.Closure{function: mir_function_id("double"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    mapped :: fx_owned(&r, ints, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: xs, args: [MIRCallArg]{fx_arg(callback, MIRAccess.Move)}, call: fx_prelude_id("core.list", "map")}})
    fx_block(&r, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    fx_print(&r, mapped)
    fx_do(&r, MIROperation.Drop{value: mapped, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: xs, kind: MIRDropKind.Value})
    fx_block(&r, 1, MIRTerminator.Return{value: None})
    fx_do(&r, MIROperation.Drop{value: xs, kind: MIRDropKind.Value})
    fx_block(&r, 2, MIRTerminator.Stopped)
    p := fx_program([MIRFunction]{fx_function("double", d, fx_int()), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
    row := fx_prelude(MIRPreludeFamily.ClosureMethod, "core.list", "map", "jet_list_map", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask[0] = true
    &p.prelude_calls.push(row)
    p
}

// The map loop's callback is followed by a delivered-stop test in both
// lowerings: the session rail call (freestanding) or the inline control read
// (runtime pack), never an unguarded element loop.
fn fx_stop_points_map_check() -> Bool Never! {
    program := fx_stop_points_map()
    roots :: [MIRFunctionID]{mir_function_id("double"), mir_function_id("run")}
    clean := true
    loop pack in ([Bool]{false, true}) {
        program.native_pack = pack
        lowered :: lir_lower_callables(program, roots)
        loop issue in lowered.issues -> print("stop-points-map: {issue.function}: {issue.message}")
        if lowered.issues.len() > 0 -> return false
        counts :: fx_stop_poll_counts(lowered.lir)
        // Polls: double's Check, run's Propagate, and the map loop's guard.
        expected :: if pack -> [Int]{3, 1, 2, 0} else -> [Int]{0, 1, 2, 0}
        if counts != expected {
            print("stop-points-map: native_pack {pack} counts {counts}, expected {expected}")
            clean = false
        }
    }
    clean
}

// A poll can leave nested sentry scopes through either cleanup edge. The
// function unsafe gate surrounds both. Structural witness needs no substitute
// static sentry runtime; real-source execution uses the admitted native ABI.
// Scope witnesses lower explicit callable roots, retaining their checked
// carriers rather than applying program-entry normalization.
fn fx_sentry_scopes_check() -> Bool Never! {
    b := fx_builder()
    unsafe_scope :: MIRScopeID{value: U64{700}}
    policy :: MIRScopeID{value: U64{701}}
    fx_do(&b, MIROperation.ScopeEnter{scope: unsafe_scope, test_member: None})
    fx_do(&b, MIROperation.ScopeEnter{scope: policy, test_member: None})
    fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    fx_do(&b, MIROperation.ScopeExit{scope: policy})
    fx_do(&b, MIROperation.ScopeExit{scope: unsafe_scope})
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    fx_do(&b, MIROperation.ScopeExit{scope: policy})
    fx_do(&b, MIROperation.ScopeExit{scope: unsafe_scope})
    fx_block(&b, 2, MIRTerminator.Stopped)
    run := fx_function("run", b, fx_unit())
    run.unsafe_gate = Val(MIRUnsafeGate{file: "fixture.jet", line: 7, reason: "function gate", enabled: true, fenced: false})
    run.scopes = [MIRScope]{
        MIRScope{id: unsafe_scope, kind: MIRScopeKind.Unsafe, span: fx_span(), name: Val("fenced"), deadline: None, facts: [MIRScopeFact]{
            MIRScopeFact{key: "sentry_enabled", value: "false"},
            MIRScopeFact{key: "sentry_fenced", value: "true"},
        }},
        MIRScope{id: policy, kind: MIRScopeKind.Policy, span: fx_span(), name: Val("disabled"), deadline: None, facts: [MIRScopeFact]{MIRScopeFact{key: "sentry_enabled", value: "false"}}},
    }
    program :: fx_program([MIRFunction]{run}, [MIRTypeDef]{})
    lowered :: lir_lower_callables(program, [MIRFunctionID]{run.id})
    if lowered.issues.len() != 0 {
        loop issue in lowered.issues -> print("sentry-scopes: {issue.message}")
        return false
    }
    saves := 0
    gates := 0
    policies := 0
    leaves := 0
    loop function in lowered.lir.functions {
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .StackSlot(_, size, align) {
                    if size == 64 && align == 8 -> saves += 1
                }
                if instruction == .Call(_, _, callee, args) {
                    if callee == .Runtime(symbol) {
                        if symbol == "jet_rt_sentry_scope_enter" && args.len() == 8 -> gates += 1
                        if symbol == "jet_rt_sentry_policy_enter" && args.len() == 2 -> policies += 1
                        if symbol == "jet_rt_sentry_scope_leave" && args.len() == 1 -> leaves += 1
                    }
                }
            }
        }
    }
    if saves == 3 && gates == 2 && policies == 1 && leaves == 6 -> return true
    print("sentry-scopes: saves {saves}, gates {gates}, policies {policies}, leaves {leaves}")
    false
}

fn fx_deadline_scopes_check() -> Bool Never! {
    b := fx_builder()
    outer :: MIRScopeID{value: U64{710}}
    inner :: MIRScopeID{value: U64{711}}
    deadline :: fx_int_const(&b, 1700000000000)
    fx_do(&b, MIROperation.ScopeEnter{scope: outer, test_member: None})
    fx_do(&b, MIROperation.ScopeEnter{scope: inner, test_member: None})
    fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Check, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    fx_do(&b, MIROperation.ScopeExit{scope: inner})
    fx_do(&b, MIROperation.ScopeExit{scope: outer})
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    fx_do(&b, MIROperation.ScopeExit{scope: inner})
    fx_do(&b, MIROperation.ScopeExit{scope: outer})
    fx_block(&b, 2, MIRTerminator.Stopped)
    run := fx_function("run", b, fx_unit())
    run.scopes = [MIRScope]{
        MIRScope{id: outer, kind: MIRScopeKind.Context, span: fx_span(), name: None, deadline: Val(deadline), facts: [MIRScopeFact]{}},
        MIRScope{id: inner, kind: MIRScopeKind.Context, span: fx_span(), name: None, deadline: Val(deadline), facts: [MIRScopeFact]{}},
    }
    lowered :: lir_lower_callables(fx_program([MIRFunction]{run}, [MIRTypeDef]{}), [MIRFunctionID]{run.id})
    if lowered.issues.len() != 0 {
        loop issue in lowered.issues -> print("deadline-scopes: {issue.message}")
        return false
    }
    saves := 0
    enters := 0
    leaves := 0
    conversions := 0
    loop function in lowered.lir.functions {
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .StackSlot(_, size, align) {
                    if size == 16 && align == 8 -> saves += 1
                }
                if instruction == .Call(_, _, callee, args) {
                    if callee == .Runtime(symbol) {
                        if symbol == "jet_ctx_push_deadline" && args.len() == 2 -> enters += 1
                        if symbol == "jet_ctx_pop_deadline" && args.len() == 1 -> leaves += 1
                        if symbol == "jet_int_owned_to_i64" && args.len() == 1 -> conversions += 1
                    }
                }
            }
        }
    }
    if saves == 2 && enters == 2 && leaves == 4 && conversions == 2 -> return true
    print("deadline-scopes: saves {saves}, enters {enters}, leaves {leaves}, conversions {conversions}")
    false
}
