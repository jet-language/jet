// Structural Show/Display/Debug text and selected user-implementation precedence.
use jet_foundation.[
    MIRAccess, MIRAssociatedTypeValue, MIRConstant, MIRDropKind, MIREnumArg,
    MIRField, MIRFieldValue, MIRFunction, MIRFunctionID, MIRImplDef, MIRImplID,
    MIRModuleID, MIROperation, MIRProgram, MIRStringFormat, MIRStringPart,
    MIRStringPartKind, MIRTargetApplicability, MIRTerminator, MIRTraitRef,
    MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRValueID, MIRVariant,
    MIRVariantPayload, mir_field_id, mir_function_id, mir_trait_id,
    mir_type_from_kind, mir_type_id,
]

fn fx_display_type(name: String, kind: MIRTypeDefKind) -> MIRTypeDef Never! {
    definition := fx_type_def(name, kind)
    definition.auto_printable = true
    definition
}

fn fx_render_interpolation(b: &FxBuilder, value: MIRValueID, format: MIRStringFormat) Never! {
    text :: fx_owned(&b, fx_string(), MIROperation.BuildString{parts: [MIRStringPart]{MIRStringPart{kind: MIRStringPartKind.Interpolation{value: value, format: format}}}})
    fx_print(&b, text)
    fx_do(&b, MIROperation.Drop{value: text, kind: MIRDropKind.Value})
}

// enum Light { Red = 1, Green }
// struct Point { n: Int, computed: String -> "ignored", label: String }
// enum Packet { Empty, Item(Point), Named(n: Int, label: String) }
// fn run() {
//   print(Light.Green)
//   p :: Point{n: 7, label: "hi"}; print(p); print("{p}")
//   print(Packet.Item(p)); print(Packet.Named(n: 7, label: "named"))
//   some :: Val(7); none :: None; print(some); print(none)
//   print(Ok(7)); print(Err("bad")); print(Packet.Empty)
// }
// A String field or payload renders quoted, as the resident engine renders a nested String slot.
// expect-stdout display: "Green\nPoint { n: 7, label: \"hi\" }\nPoint { n: 7, label: \"hi\" }\nItem(Point { n: 7, label: \"hi\" })\nNamed { n: 7, label: \"named\" }\n7\nnull\nOk(7)\nErr(bad)\nEmpty\n"
fn fx_display() -> MIRProgram Never! {
    point :: fx_named("Point")
    light :: fx_named("Light")
    packet :: fx_named("Packet")
    types :: [MIRTypeDef]{
        fx_display_type("Light", MIRTypeDefKind.Enum{variants: [MIRVariant]{
            MIRVariant{name: "Red", wire_name: "Red", span: fx_span(), payload: MIRVariantPayload.Unit, discriminant: Val(1)},
            MIRVariant{name: "Green", wire_name: "Green", span: fx_span(), payload: MIRVariantPayload.Unit, discriminant: None},
        }, methods: [MIRFunctionID]{}}),
        fx_display_type("Point", MIRTypeDefKind.Struct{fields: [MIRField]{
            fx_field("Point", "n", fx_int()),
            fx_stored_or_computed("Point", "computed", fx_string(), true),
            fx_field("Point", "label", fx_string()),
        }, methods: [MIRFunctionID]{}}),
        fx_display_type("Packet", MIRTypeDefKind.Enum{variants: [MIRVariant]{
            MIRVariant{name: "Empty", wire_name: "Empty", span: fx_span(), payload: MIRVariantPayload.Unit, discriminant: None},
            MIRVariant{name: "Item", wire_name: "Item", span: fx_span(), payload: MIRVariantPayload.Single{value: point}, discriminant: None},
            MIRVariant{name: "Named", wire_name: "Named", span: fx_span(), payload: MIRVariantPayload.Named{fields: [MIRField]{fx_field("Packet.Named", "n", fx_int()), fx_field("Packet.Named", "label", fx_string())}}, discriminant: None},
        }, methods: [MIRFunctionID]{}}),
    }
    b := fx_builder()
    green :: fx_copy(&b, light, MIROperation.Enum{type_id: mir_type_id("Light"), variant: "Green", args: [MIREnumArg]{}})
    fx_print(&b, green)
    seven :: fx_int_const(&b, 7)
    label :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "hi"}})
    p :: fx_owned(&b, point, MIROperation.Struct{type_id: mir_type_id("Point"), fields: [MIRFieldValue]{MIRFieldValue{field: mir_field_id("Point.n"), value: seven}, MIRFieldValue{field: mir_field_id("Point.label"), value: label}}})
    fx_print(&b, p)
    fx_render_interpolation(&b, p, MIRStringFormat.Display)
    item :: fx_owned(&b, packet, MIROperation.Enum{type_id: mir_type_id("Packet"), variant: "Item", args: [MIREnumArg]{MIREnumArg{field: None, value: p, boxed: false}}})
    fx_print(&b, item)
    fx_do(&b, MIROperation.Drop{value: item, kind: MIRDropKind.Value})
    named_label :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "named"}})
    named :: fx_owned(&b, packet, MIROperation.Enum{type_id: mir_type_id("Packet"), variant: "Named", args: [MIREnumArg]{MIREnumArg{field: Val(mir_field_id("Packet.Named.n")), value: seven, boxed: false}, MIREnumArg{field: Val(mir_field_id("Packet.Named.label")), value: named_label, boxed: false}}})
    fx_print(&b, named)
    fx_do(&b, MIROperation.Drop{value: named, kind: MIRDropKind.Value})
    option :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_int()})
    some :: fx_owned(&b, option, MIROperation.Present{value: seven})
    none :: fx_owned(&b, option, MIROperation.Absent)
    fx_print(&b, some)
    fx_print(&b, none)
    fx_do(&b, MIROperation.Drop{value: some, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: none, kind: MIRDropKind.Value})
    result :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_int(), err: fx_string()})
    ok_value :: fx_owned(&b, result, MIROperation.ResultOk{value: seven})
    fx_print(&b, ok_value)
    fx_do(&b, MIROperation.Drop{value: ok_value, kind: MIRDropKind.Value})
    bad :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "bad"}})
    err_value :: fx_owned(&b, result, MIROperation.ResultErr{value: bad})
    fx_print(&b, err_value)
    fx_do(&b, MIROperation.Drop{value: err_value, kind: MIRDropKind.Value})
    empty :: fx_owned(&b, packet, MIROperation.Enum{type_id: mir_type_id("Packet"), variant: "Empty", args: [MIREnumArg]{}})
    fx_print(&b, empty)
    fx_do(&b, MIROperation.Drop{value: empty, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}

fn fx_display_impl(name: String, trait_name: String, ty: MIRType, method: MIRFunctionID, ordinal: U64) -> MIRImplDef Never! {
    MIRImplDef{id: MIRImplID{value: ordinal}, module_id: MIRModuleID{value: 0}, key: name, span: fx_span(), self_type: ty,
        trait_ref: Val(MIRTraitRef{id: mir_trait_id(trait_name), name: trait_name}), associated_types: [MIRAssociatedTypeValue]{},
        methods: [MIRFunctionID]{method}, delegation: None, compiler_generated: false, serde: None,
        operator_marker: None, operator_rhs: None, target_os: None,
        target_applicability: MIRTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: false}}
}

// #Printable struct Custom { n: Int }
// impl Printable for Custom { fn show(self) -> String { "user show" } }
// impl Display for Custom { fn display(self) -> String { "user display" } }
// fn run() { c :: Custom{n: 7}; print(c); print("{c}"); print("{c:Debug}") }
// expect-stdout display-custom: "user show\nuser display\nCustom { n: 7 }\n\"quoted\"\nVal(7)\nNone\nOk(7)\nErr(\"bad\")\n"
fn fx_display_custom() -> MIRProgram Never! {
    ty :: fx_named("Custom")
    s := fx_builder()
    fx_param(&s, "self", ty, fx_borrow()).drop("fixture receiver")
    show_text :: fx_owned(&s, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "user show"}})
    fx_block(&s, 0, MIRTerminator.Return{value: Val(show_text)})
    show_function := fx_function("custom_show", s, fx_string())
    show_function.name = "show"
    d := fx_builder()
    fx_param(&d, "self", ty, fx_borrow()).drop("fixture receiver")
    display_text :: fx_owned(&d, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "user display"}})
    fx_block(&d, 0, MIRTerminator.Return{value: Val(display_text)})
    display_function := fx_function("custom_display", d, fx_string())
    display_function.name = "display"
    b := fx_builder()
    seven :: fx_int_const(&b, 7)
    custom :: fx_owned(&b, ty, MIROperation.Struct{type_id: mir_type_id("Custom"), fields: [MIRFieldValue]{MIRFieldValue{field: mir_field_id("Custom.n"), value: seven}}})
    fx_print(&b, custom)
    fx_render_interpolation(&b, custom, MIRStringFormat.Display)
    fx_render_interpolation(&b, custom, MIRStringFormat.Debug)
    quoted :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "quoted"}})
    fx_render_interpolation(&b, quoted, MIRStringFormat.Debug)
    fx_do(&b, MIROperation.Drop{value: quoted, kind: MIRDropKind.Value})
    option :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_int()})
    some :: fx_owned(&b, option, MIROperation.Present{value: seven})
    none :: fx_owned(&b, option, MIROperation.Absent)
    fx_render_interpolation(&b, some, MIRStringFormat.Debug)
    fx_render_interpolation(&b, none, MIRStringFormat.Debug)
    fx_do(&b, MIROperation.Drop{value: some, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: none, kind: MIRDropKind.Value})
    result :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_int(), err: fx_string()})
    ok_value :: fx_owned(&b, result, MIROperation.ResultOk{value: seven})
    bad :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "bad"}})
    err_value :: fx_owned(&b, result, MIROperation.ResultErr{value: bad})
    fx_render_interpolation(&b, ok_value, MIRStringFormat.Debug)
    fx_render_interpolation(&b, err_value, MIRStringFormat.Debug)
    fx_do(&b, MIROperation.Drop{value: ok_value, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: err_value, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: custom, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_program([MIRFunction]{show_function, display_function, fx_function("run", b, fx_unit())}, [MIRTypeDef]{fx_display_type("Custom", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Custom", "n", fx_int())}, methods: [MIRFunctionID]{}})})
    program.impls = [MIRImplDef]{fx_display_impl("custom Printable", "Printable", ty, mir_function_id("custom_show"), 1), fx_display_impl("custom Display", "Display", ty, mir_function_id("custom_display"), 2)}
    program
}
