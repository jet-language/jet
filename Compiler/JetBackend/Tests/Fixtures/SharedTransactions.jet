// Shared STM normal ScopeExit consumes one provider owner; early Return uses
// the existing MIR MovePlace + Drop rollback, including across body branches.
use jet_foundation.[MIRAccess, MIRBlockID, MIRCallArg, MIRCallMetadata, MIRCallablePolicy, MIRCallablePolicyChain, MIRCaptureOperand, MIRConstant, MIRDropKind, MIRFunction, MIRFunctionSignature, MIROperation, MIRPollKind, MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRScope, MIRScopeFact, MIRScopeID, MIRScopeKind, MIRSemanticOp, MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind, MIRValueID, mir_function_id, mir_owned_ownership, mir_type_from_kind]
use jet_backend.[lir_lower_entry, LIRInst, LIRCallee]

fn fx_stm_scope() -> MIRScope Never! {
    MIRScope{id: MIRScopeID{value: U64{800}}, kind: MIRScopeKind.Transaction, span: fx_span(), name: Val("jet_stm_fixture"), deadline: None, facts: [MIRScopeFact]{}}
}

fn fx_stm_body(early: Bool) -> MIRFunction Never! {
    b := fx_builder()
    scope :: fx_stm_scope()
    fx_do(&b, MIROperation.ScopeEnter{scope: scope.id, test_member: None})
    ty :: fx_named("Stm")
    place :: fx_local(&b, "jet_stm_fixture", ty, mir_owned_ownership())
    owner :: fx_owned(&b, ty, MIROperation.Global{name: "stm"})
    fx_do(&b, MIROperation.WritePlace{place: place, value: owner})
    condition :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    fx_block(&b, 0, MIRTerminator.Branch{condition: condition, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    fx_block(&b, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    fx_block(&b, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    if early {
        moved :: fx_owned(&b, ty, MIROperation.MovePlace{place: place})
        fx_do(&b, MIROperation.Drop{value: moved, kind: MIRDropKind.Value})
    } else {
        fx_do(&b, MIROperation.ScopeExit{scope: scope.id})
    }
    fx_block(&b, 3, MIRTerminator.Return{value: None})
    function := fx_function("run", b, fx_unit())
    function.scopes = [MIRScope]{scope}
    function
}

// expect-stdout stm-scope: ""
// expect-runtime-only stm-scope
fn fx_stm_normal() -> MIRProgram Never! {
    fx_program([MIRFunction]{fx_stm_body(false)}, [MIRTypeDef]{})
}

// expect-stdout stm-return: ""
// expect-runtime-only stm-return
fn fx_stm_return() -> MIRProgram Never! {
    fx_program([MIRFunction]{fx_stm_body(true)}, [MIRTypeDef]{})
}

// Both callbacks operate synchronously on the slot supplied by the provider.
// The edit body writes 9 into the stage; read_txn must see that stage at once.
// expect-stdout stm-callbacks: "9\n"
// expect-runtime-only stm-callbacks
fn fx_stm_callbacks() -> MIRProgram Never! { fx_stm_callbacks_program(false) }

// expect-stdout stm-callback-poll: "9\n"
// expect-runtime-only stm-callback-poll
fn fx_stm_callback_poll() -> MIRProgram Never! { fx_stm_callbacks_program(true) }

fn fx_stm_callbacks_program(poll: Bool) -> MIRProgram Never! {
    edit := fx_builder()
    input :: fx_write_param(&edit, "value", fx_int())
    nine :: fx_int_const(&edit, 9)
    fx_do(&edit, MIROperation.WritePlace{place: input, value: nine})
    fx_block(&edit, 0, MIRTerminator.Return{value: None})
    reader := fx_builder()
    value :: fx_param(&reader, "value", fx_int(), fx_borrow())
    fx_block(&reader, 0, MIRTerminator.Return{value: Val(value)})
    edit_fn := fx_function("stm_edit", edit, fx_unit())
    metadata :: MIRCallMetadata{names: [String]{"value"}, defaults: [Bool]{false}, variadic: [Bool]{false}, conventions: [MIRAccess]{MIRAccess.Write}, policies: MIRCallablePolicyChain{policies: [MIRCallablePolicy]{}}}
    edit_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{fx_int()}, ret: Val(fx_unit()), effect_bound: None, param_contract: None, call_metadata: Val(metadata), return_view_provenance: None}})
    read_ty :: fx_fn_int_type()
    b := fx_builder()
    shared_ty :: mir_type_from_kind(MIRTypeKind.Shared{inner: fx_int()})
    seven :: fx_int_const(&b, 7)
    cell :: fx_owned(&b, shared_ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("::JetShared", "new"), args: [MIRCallArg]{fx_arg(seven, MIRAccess.Move)}, owner_type_args: [], type_args: []}})
    scope :: fx_stm_scope()
    fx_do(&b, MIROperation.ScopeEnter{scope: scope.id, test_member: None})
    place :: fx_local(&b, "jet_stm_fixture", fx_named("Stm"), mir_owned_ownership())
    state :: fx_owned(&b, fx_named("Stm"), MIROperation.Global{name: "stm"})
    fx_do(&b, MIROperation.WritePlace{place: place, value: state})
    write :: fx_owned(&b, edit_ty, MIROperation.Closure{function: mir_function_id("stm_edit"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    _ := fx_copy(&b, fx_unit(), MIROperation.Semantic{operation: MIRSemanticOp.HostCall{call: fx_prelude_id("core.host", "Shared.edit_txn"), args: [MIRCallArg]{fx_arg(cell, MIRAccess.Read), fx_arg(state, MIRAccess.Read), fx_arg(write, MIRAccess.Move)}}})
    if poll -> fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 3}})
    read :: fx_owned(&b, read_ty, MIROperation.Closure{function: mir_function_id("stm_read"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    result :: fx_copy(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.HostCall{call: fx_prelude_id("core.host", "Shared.read_txn"), args: [MIRCallArg]{fx_arg(cell, MIRAccess.Read), fx_arg(state, MIRAccess.Read), fx_arg(read, MIRAccess.Move)}}})
    if poll -> fx_block(&b, 1, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 2}, stop: MIRBlockID{value: 3}})
    fx_print(&b, result)
    fx_do(&b, MIROperation.ScopeExit{scope: scope.id})
    fx_do(&b, MIROperation.Drop{value: cell, kind: MIRDropKind.Value})
    fx_block(&b, if poll -> U64{2} else -> U64{0}, MIRTerminator.Return{value: None})
    if poll {
        rolled_back :: fx_owned(&b, fx_named("Stm"), MIROperation.MovePlace{place: place})
        fx_do(&b, MIROperation.Drop{value: rolled_back, kind: MIRDropKind.Value})
        fx_do(&b, MIROperation.Drop{value: cell, kind: MIRDropKind.Value})
        fx_block(&b, 3, MIRTerminator.Stopped)
    }
    run := fx_function("run", b, fx_unit())
    run.scopes = [MIRScope]{scope}
    p := fx_program([MIRFunction]{edit_fn, fx_function("stm_read", reader, fx_int()), run}, [MIRTypeDef]{})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "::JetShared", "new", "jet_std::JetShared::new", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Host, "core.host", "Shared.edit_txn", "jet_shared_edit_txn", 3, MIRPreludeABI.Control))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Host, "core.host", "Shared.read_txn", "jet_shared_read_txn", 3, MIRPreludeABI.Control))
    p
}

fn fx_stm_scope_checks() -> Bool Never! {
    choices :: [Bool]{false, true}
    loop early in choices {
        lowered :: lir_lower_entry(if early -> fx_stm_return() else -> fx_stm_normal(), mir_function_id("run"))
        if lowered.issues.len() != 0 -> return false
        begins := 0
        commits := 0
        rollbacks := 0
        loop function in lowered.lir.functions {
            loop block in function.blocks {
                loop instruction in block.insts {
                    if instruction == .Call(_, _, .Runtime(symbol), _) {
                        if symbol == "jet_rt_native_stm_begin" -> begins += 1
                        if symbol == "jet_rt_native_stm_commit" -> commits += 1
                    }
                    if instruction == .Drop(value) {
                        loop fact in function.values {
                            if fact.id == value && fact.drop == .Runtime(symbol) {
                                if symbol == "jet_rt_native_stm_rollback" -> rollbacks += 1
                            }
                        }
                    }
                }
            }
        }
        if begins != 1 || commits != (if early -> 0 else -> 1) || rollbacks != (if early -> 1 else -> 0) -> return false
    }
    loop ambiguous in choices {
        function := fx_stm_body(false)
        if ambiguous {
            local := function.locals[0]
            local.id.value += U64{1}
            &function.locals.push(local)
        } else {
            function.scopes[0].name = Val("missing_stm_local")
        }
        rejected :: lir_lower_entry(fx_program([MIRFunction]{function}, [MIRTypeDef]{}), mir_function_id("run"))
        found := false
        loop issue in rejected.issues {
            if issue.message == "transaction scope must own one uniquely named Stm local" -> found = true
        }
        if !found -> return false
    }
    lowered :: lir_lower_entry(fx_stm_callback_poll(), mir_function_id("run"))
    if lowered.issues.len() != 0 -> return false
    reads := 0
    edits := 0
    gates := 0
    loop function in lowered.lir.functions {
        if function.name != "run" -> next
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .Call(_, _, .Runtime(symbol), args) {
                    if symbol == "jet_rt_native_shared_read_txn" {
                        if args.len() != 5 -> return false
                        reads += 1
                    }
                    if symbol == "jet_rt_native_shared_edit_txn" {
                        if args.len() != 5 -> return false
                        edits += 1
                    }
                    if symbol == "jet_rt_session_propagate" -> gates += 1
                }
            }
        }
    }
    if reads != 1 || edits != 1 || gates != 4 -> return false
    // Ordinary non-STM call results keep exactly their three original MIR
    // Propagate gates; the STM-local pre-read gate does not change `?` cleanup.
    ordinary :: lir_lower_entry(fx_stop_points(), mir_function_id("run"))
    if ordinary.issues.len() != 0 -> return false
    ordinary_gates := 0
    loop function in ordinary.lir.functions {
        if function.name != "run" -> next
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .Call(_, _, .Runtime(symbol), _) {
                    if symbol == "jet_rt_session_propagate" -> ordinary_gates += 1
                }
            }
        }
    }
    if ordinary_gates != 3 -> return false
    true
}
