// Fixed-width integers narrower than 64 bits (Numeric.jet lower_narrow_*):
// canonical extended words, range-checked trapping arithmetic, re-extended
// unchecked arithmetic and shifts, and widening conversions.
use jet_foundation.[
    MIRAccess, MIRBinaryDispatch, MIRBinaryOp, MIRBinaryOverflow, MIRCallArg,
    MIRCallee, MIRConstant, MIRConversion, MIRFunction, MIRIntegerWidth,
    MIROperation, MIRProgram, MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind,
    MIRUnaryOp, MIRValueID, mir_copy_ownership, mir_function_id, mir_type_from_kind,
]

fn fx_narrow(signed: Bool, bits: Int) -> MIRType Never! { mir_type_from_kind(MIRTypeKind.IntN{signed: signed, bits: bits}) }

fn fx_narrow_const(b: &FxBuilder, signed: Bool, bits: Int, value: Int) -> MIRValueID Never! {
    fx_copy(&b, fx_narrow(signed, bits), MIROperation.Constant{value: MIRConstant.Int{value: value, width: Val(MIRIntegerWidth{signed: signed, bits: bits}), spelling: None}})
}

// fn <name>(a: T, b: T) -> T { a <op> b }
fn fx_narrow_binary_function(name: String, signed: Bool, bits: Int, op: MIRBinaryOp, overflow: MIRBinaryOverflow) -> MIRFunction Never! {
    b := fx_builder()
    a :: fx_param(&b, "a", fx_narrow(signed, bits), mir_copy_ownership())
    c :: fx_param(&b, "b", fx_narrow(signed, bits), mir_copy_ownership())
    result :: fx_copy(&b, fx_narrow(signed, bits), MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Primitive, overflow: overflow, left: a, right: c})
    fx_block(&b, 0, MIRTerminator.Return{value: Val(result)})
    fx_function(name, b, fx_narrow(signed, bits))
}

// fn <name>(a: T) -> T { <op> a }
fn fx_narrow_unary_function(name: String, signed: Bool, bits: Int, op: MIRUnaryOp) -> MIRFunction Never! {
    b := fx_builder()
    a :: fx_param(&b, "a", fx_narrow(signed, bits), mir_copy_ownership())
    result :: fx_copy(&b, fx_narrow(signed, bits), MIROperation.Unary{op: op, value: a})
    fx_block(&b, 0, MIRTerminator.Return{value: Val(result)})
    fx_function(name, b, fx_narrow(signed, bits))
}

// print(<name>(args...)), every argument a constant of the callee's type.
fn fx_narrow_call(r: &FxBuilder, name: String, signed: Bool, bits: Int, args: [Int]) Never! {
    call_args := [MIRCallArg]{}
    loop value in args -> &call_args.push(fx_arg(fx_narrow_const(&r, signed, bits, value), MIRAccess.Read))
    result :: fx_copy(&r, fx_narrow(signed, bits), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id(name)}, args: call_args, type_args: [MIRType]{}})
    fx_print(&r, result)
}

fn fx_narrow_widen(r: &FxBuilder, signed: Bool, bits: Int, value: Int, target: MIRType) Never! {
    source :: fx_narrow_const(&r, signed, bits, value)
    widened :: fx_copy(&r, target, MIROperation.Convert{value: source, parameters: [MIRValueID]{}, target: target, conversion: MIRConversion.NumericCast})
    fx_print(&r, widened)
}

// fn run() {
//     print(i8_add(I8{100}, I8{27})); print(i8_sub(I8{-100}, I8{28}))
//     print(u8_mul(U8{15}, U8{17})); print(u32_mul(U32{65535}, U32{65537}))
//     print(i16_div(I16{-32768}, I16{2})); print(i8_rem(I8{-7}, I8{3}))
//     print(u8_shl(U8{1}, U8{7})); print(i8_shl(I8{1}, I8{7}))
//     print(i8_shr(I8{-128}, I8{7})); print(u8_shr(U8{255}, U8{4}))
//     print(i8_xor(I8{-1}, I8{5}))
//     print(u8_wrapping_add(U8{200}, U8{100})); print(i8_wrapping_mul(I8{100}, I8{3}))
//     print(u8_not(U8{15})); print(i8_neg(I8{5})); print(i8_not(I8{5}))
//     print(Int(I8{-5})); print(U32(U8{255})); print(I8{-1} < I8{1})
// }
// (the wrapping pair are unchecked operators: Rust `wrapping_add`/`wrapping_mul`)
// expect-stdout narrow: "127\n-128\n255\n4294967295\n-16384\n-1\n128\n-128\n-1\n15\n-6\n44\n44\n240\n-5\n-6\n-5\n255\ntrue\n"
fn fx_narrow_program() -> MIRProgram Never! {
    r := fx_builder()
    fx_narrow_call(&r, "i8_add", true, 8, [Int]{100, 27})
    fx_narrow_call(&r, "i8_sub", true, 8, [Int]{-100, 28})
    fx_narrow_call(&r, "u8_mul", false, 8, [Int]{15, 17})
    fx_narrow_call(&r, "u32_mul", false, 32, [Int]{65535, 65537})
    fx_narrow_call(&r, "i16_div", true, 16, [Int]{-32768, 2})
    fx_narrow_call(&r, "i8_rem", true, 8, [Int]{-7, 3})
    fx_narrow_call(&r, "u8_shl", false, 8, [Int]{1, 7})
    fx_narrow_call(&r, "i8_shl", true, 8, [Int]{1, 7})
    fx_narrow_call(&r, "i8_shr", true, 8, [Int]{-128, 7})
    fx_narrow_call(&r, "u8_shr", false, 8, [Int]{255, 4})
    fx_narrow_call(&r, "i8_xor", true, 8, [Int]{-1, 5})
    fx_narrow_call(&r, "u8_wrapping_add", false, 8, [Int]{200, 100})
    fx_narrow_call(&r, "i8_wrapping_mul", true, 8, [Int]{100, 3})
    fx_narrow_call(&r, "u8_not", false, 8, [Int]{15})
    fx_narrow_call(&r, "i8_neg", true, 8, [Int]{5})
    fx_narrow_call(&r, "i8_not", true, 8, [Int]{5})
    fx_narrow_widen(&r, true, 8, -5, fx_int())
    fx_narrow_widen(&r, false, 8, 255, fx_narrow(false, 32))
    minus_one :: fx_narrow_const(&r, true, 8, -1)
    plus_one :: fx_narrow_const(&r, true, 8, 1)
    less :: fx_compare(&r, MIRBinaryOp.Lt, minus_one, plus_one)
    fx_print(&r, less)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{
        fx_narrow_binary_function("i8_add", true, 8, MIRBinaryOp.Add, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i8_sub", true, 8, MIRBinaryOp.Sub, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("u8_mul", false, 8, MIRBinaryOp.Mul, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("u32_mul", false, 32, MIRBinaryOp.Mul, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i16_div", true, 16, MIRBinaryOp.Div, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i8_rem", true, 8, MIRBinaryOp.Rem, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("u8_shl", false, 8, MIRBinaryOp.Shl, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i8_shl", true, 8, MIRBinaryOp.Shl, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i8_shr", true, 8, MIRBinaryOp.Shr, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("u8_shr", false, 8, MIRBinaryOp.Shr, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("i8_xor", true, 8, MIRBinaryOp.BitXor, MIRBinaryOverflow.Trap),
        fx_narrow_binary_function("u8_wrapping_add", false, 8, MIRBinaryOp.Add, MIRBinaryOverflow.Unchecked),
        fx_narrow_binary_function("i8_wrapping_mul", true, 8, MIRBinaryOp.Mul, MIRBinaryOverflow.Unchecked),
        fx_narrow_unary_function("u8_not", false, 8, MIRUnaryOp.Not),
        fx_narrow_unary_function("i8_neg", true, 8, MIRUnaryOp.Neg),
        fx_narrow_unary_function("i8_not", true, 8, MIRUnaryOp.Not),
        fx_function("run", r, fx_unit()),
    }, [MIRTypeDef]{})
}

fn fx_narrow_failure(function: MIRFunction, signed: Bool, bits: Int, args: [Int]) -> MIRProgram Never! {
    r := fx_builder()
    fx_narrow_call(&r, "operation", signed, bits, args)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{function, fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(I8{127} + I8{1}) }
// expect-stdout narrow-add-overflow: ""
// expect-exit narrow-add-overflow: 70
fn fx_narrow_add_overflow() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", true, 8, MIRBinaryOp.Add, MIRBinaryOverflow.Trap), true, 8, [Int]{127, 1})
}

// fn run() { print(U8{0} - U8{1}) }
// expect-stdout narrow-sub-overflow: ""
// expect-exit narrow-sub-overflow: 70
fn fx_narrow_sub_overflow() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", false, 8, MIRBinaryOp.Sub, MIRBinaryOverflow.Trap), false, 8, [Int]{0, 1})
}

// fn run() { print(U16{256} * U16{256}) }
// expect-stdout narrow-mul-overflow: ""
// expect-exit narrow-mul-overflow: 70
fn fx_narrow_mul_overflow() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", false, 16, MIRBinaryOp.Mul, MIRBinaryOverflow.Trap), false, 16, [Int]{256, 256})
}

// fn run() { print(I8{-128} / I8{-1}) }
// expect-stdout narrow-div-overflow: ""
// expect-exit narrow-div-overflow: 70
fn fx_narrow_div_overflow() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", true, 8, MIRBinaryOp.Div, MIRBinaryOverflow.Trap), true, 8, [Int]{-128, -1})
}

// fn run() { print(U8{1} / U8{0}) }
// expect-stdout narrow-div-zero: ""
// expect-exit narrow-div-zero: 70
fn fx_narrow_div_zero() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", false, 8, MIRBinaryOp.Div, MIRBinaryOverflow.Trap), false, 8, [Int]{1, 0})
}

// fn run() { print(U8{1} << U8{8}) }
// expect-stdout narrow-shift-range: ""
// expect-exit narrow-shift-range: 70
fn fx_narrow_shift_range() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_binary_function("operation", false, 8, MIRBinaryOp.Shl, MIRBinaryOverflow.Trap), false, 8, [Int]{1, 8})
}

// fn run() { print(-I8{-128}) }
// expect-stdout narrow-neg-overflow: ""
// expect-exit narrow-neg-overflow: 70
fn fx_narrow_neg_overflow() -> MIRProgram Never! {
    fx_narrow_failure(fx_narrow_unary_function("operation", true, 8, MIRUnaryOp.Neg), true, 8, [Int]{-128})
}
