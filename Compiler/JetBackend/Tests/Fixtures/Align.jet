// Boundary fixture, not ordinary source lowering: the corresponding Jet
// program is `fn run() { print(address_of_aligned_byte % required_align) }`.
// A DataAddress has pointer layout. The checker stores it in an eight-byte
// cell and reads its word bits before taking the remainder; this keeps the
// hand LIR well-typed without assuming a pointer-to-word conversion opcode.
// Reference: retained SolNative2/cases.jet:16 align_case and ELF64 section
// sh_addralign / PT_LOAD congruence rules. No new runtime symbol is needed.
// expect-stdout align16: "0\n"
// expect-stdout align64: "0\n"
// expect-stdout align256: "0\n"
// expect-stdout align8192: "0\n"
// expect-stdout align8388608: "0\n"
fn fx_align_module(align: Int) -> LIRModule Never! {
    r := lir_builder(LIRFunctionID{value: 0}, "run", LIRSignatureID{value: 0})
    address :: lir_builder_value(&r, lir_layout_pointer(), LIRDrop.Trivial, None)
    required :: lir_builder_word(&r)
    remainder :: lir_builder_word(&r)
    text :: lir_builder_value(&r, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_string_drop"}, None)
    flush :: lir_builder_bool(&r)
    lir_builder_push(&r, LIRInst.DataAddress{dst: address, data: LIRDataID{value: 1}})
    lir_builder_push(&r, LIRInst.Const{dst: required, value: align})
    lir_builder_push(&r, LIRInst.Call{dst: Val(remainder), signature: LIRSignatureID{value: 1}, callee: LIRCallee.Function{id: LIRFunctionID{value: 1}}, args: [LIRValueID]{address, required}})
    lir_builder_push(&r, LIRInst.Call{dst: Val(text), signature: LIRSignatureID{value: 4}, callee: LIRCallee.Runtime{symbol: "jet_rt_i64_to_string"}, args: [LIRValueID]{remainder}})
    lir_builder_push(&r, LIRInst.Const{dst: flush, value: 1})
    lir_builder_push(&r, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 5}, callee: LIRCallee.Runtime{symbol: "jet_term_write_stdout_line"}, args: [LIRValueID]{text, flush}})
    lir_builder_push(&r, LIRInst.Drop{value: text})
    lir_builder_seal(&r, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})

    c := lir_builder(LIRFunctionID{value: 1}, "address_remainder", LIRSignatureID{value: 1})
    pointer :: lir_builder_value(&c, lir_layout_pointer(), LIRDrop.Trivial, None)
    divisor :: lir_builder_word(&c)
    size :: lir_builder_word(&c)
    cell :: lir_builder_value(&c, lir_layout_pointer(), LIRDrop.Trivial, None)
    bits :: lir_builder_word(&c)
    result :: lir_builder_word(&c)
    lir_builder_push(&c, LIRInst.Const{dst: size, value: 8})
    lir_builder_push(&c, LIRInst.Call{dst: Val(cell), signature: LIRSignatureID{value: 2}, callee: LIRCallee.Runtime{symbol: "jet_rt_alloc"}, args: [LIRValueID]{size, size}})
    lir_builder_push(&c, LIRInst.Store{base: cell, offset: 0, value: pointer})
    lir_builder_push(&c, LIRInst.Load{dst: bits, base: cell, offset: 0})
    lir_builder_push(&c, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 3}, callee: LIRCallee.Runtime{symbol: "jet_rt_free"}, args: [LIRValueID]{cell, size, size}})
    lir_builder_push(&c, LIRInst.Binary{dst: result, op: LIRBinaryOp.Rem, left: bits, right: divisor})
    lir_builder_seal(&c, LIRBlockID{value: 0}, [LIRValueID]{pointer, divisor}, LIRTerminator.Return{value: Val(result)})

    signatures :: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: LIRCallConv.SystemV, params: [LIRLayout]{}, result: None},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_pointer(), lir_layout_word()}, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 2}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_word(), lir_layout_word()}, result: Val(lir_layout_pointer())},
        LIRSignature{id: LIRSignatureID{value: 3}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_pointer(), lir_layout_word(), lir_layout_word()}, result: None},
        LIRSignature{id: LIRSignatureID{value: 4}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_word()}, result: Val(lir_layout_pointer())},
        LIRSignature{id: LIRSignatureID{value: 5}, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_pointer(), lir_layout_bool()}, result: None},
    }
    // The leading unaligned byte forces padding between data objects too,
    // rather than proving only the first object's trivially zero offset.
    data :: [LIRData]{
        LIRData{id: LIRDataID{value: 0}, bytes: [U8]{U8{17}}, align: 1, relocs: [LIRDataReloc]{}},
        LIRData{id: LIRDataID{value: 1}, bytes: [U8]{U8{42}}, align: align, relocs: [LIRDataReloc]{}},
    }
    LIRModule{signatures: signatures, functions: [LIRFunction]{lir_builder_finish(r), lir_builder_finish(c)}, data: data}
}
