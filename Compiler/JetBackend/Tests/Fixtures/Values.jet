// Inline aggregates (Lower/Values.jet): natural field offsets, by-pointer
// parameters, hidden result pointers, frame storage for loop-carried values,
// and inline values held in box payloads and list elements.
use jet_foundation.[
    MIRAccess,
    MIRBinaryOp,
    MIRCallArg,
    MIRCallee,
    MIRConstant,
    MIRCopyFact,
    MIRDropKind,
    MIREnumArg,
    MIRField,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIROperation,
    MIRPhiIncoming,
    MIRPreludeABI,
    MIRPreludeFamily,
    MIRPreludeTypeArg,
    MIRProgram,
    MIRReflectField,
    MIRSemanticOp,
    MIRTerminator,
    MIRType,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRTypeKind,
    MIRVariant,
    MIRVariantPayload,
    mir_field_id,
    mir_function_id,
    mir_owned_ownership,
    mir_type_from_kind,
    mir_type_id,
]

fn fx_values_struct(b: &FxBuilder, name: String, fields: [MIRFieldValue]) -> MIRValueID Never! {
    fx_owned(&b, fx_named(name), MIROperation.Struct{type_id: mir_type_id(name), fields: fields})
}

fn fx_values_field(b: &FxBuilder, base: MIRValueID, owner: String, name: String, ty: MIRType) -> MIRValueID Never! {
    fx_value(&b, ty, fx_borrow(), MIROperation.Field{base: base, field: mir_field_id("{owner}.{name}")})
}

fn fx_values_set(owner: String, name: String, value: MIRValueID) -> MIRFieldValue Never! {
    MIRFieldValue{field: mir_field_id("{owner}.{name}"), value: value}
}

fn fx_values_show(b: &FxBuilder, base: MIRValueID, owner: String, name: String, ty: MIRType) Never! {
    value :: fx_values_field(&b, base, owner, name, ty)
    fx_print(&b, value)
}

// struct Named { label: String }
// fn run() { t :: Named{label: "red".to_upper()}; print(t.label); print("zzz"); print(t.label); drop(t) }
// MIR reads `t.label` as an Owned Field of the borrowed `t` read and the
// lowering drops the print temp: the member must be a copy (MIRRust.rs
// place_read clones the owner), or the print frees the label `t` holds and
// the reused block prints "zzz" again (native tuple/struct field prints).
// expect-stdout values-owned-field: "red\nzzz\nred\n"
fn fx_values_owned_field() -> MIRProgram Never! {
    types :: [MIRTypeDef]{fx_type_def("Named", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Named", "label", fx_string())}, methods: [MIRFunctionID]{}})}
    b := fx_builder()
    named :: fx_named("Named")
    root :: fx_local(&b, "t", named, mir_owned_ownership())
    label :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "red"}})
    built :: fx_values_struct(&b, "Named", [MIRFieldValue]{fx_values_set("Named", "label", label)})
    fx_do(&b, MIROperation.WritePlace{place: root, value: built})
    first_owner :: fx_owned(&b, named, MIROperation.ReadPlace{place: root})
    first :: fx_owned(&b, fx_string(), MIROperation.Field{base: first_owner, field: mir_field_id("Named.label")})
    fx_print(&b, first)
    other :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "zzz"}})
    fx_print(&b, other)
    fx_do(&b, MIROperation.Drop{value: other, kind: MIRDropKind.Value})
    again_owner :: fx_owned(&b, named, MIROperation.ReadPlace{place: root})
    again :: fx_owned(&b, fx_string(), MIROperation.Field{base: again_owner, field: mir_field_id("Named.label")})
    fx_print(&b, again)
    done :: fx_owned(&b, named, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: done, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}

// struct Flags { on: Bool, off: Bool, count: Int, label: String }
// struct Wrap { inner: Flags, tag: Bool }
// fn make(n: Int) -> Wrap { Wrap{inner: Flags{on: true, off: false, count: n, label: "wrapped"}, tag: true} }
// fn total(w: Wrap) -> Int { w.inner.count + 1 }
// fn run() {
//     w :: make(41)
//     print(w.inner.on); print(w.inner.off); print(w.inner.count)
//     print(w.inner.label); print(w.tag); print(total(w))
//     c :: w.clone(); drop(w); print(c.inner.label); drop(c)
// }
// expect-stdout values-inline: "true\nfalse\n41\nwrapped\ntrue\n42\nwrapped\n"
fn fx_values_inline() -> MIRProgram Never! {
    flags :: fx_named("Flags")
    wrap :: fx_named("Wrap")
    types :: [MIRTypeDef]{
        fx_type_def("Flags", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Flags", "on", fx_bool()), fx_field("Flags", "off", fx_bool()), fx_field("Flags", "count", fx_int()), fx_field("Flags", "label", fx_string())}, methods: [MIRFunctionID]{}}),
        fx_type_def("Wrap", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Wrap", "inner", flags), fx_field("Wrap", "tag", fx_bool())}, methods: [MIRFunctionID]{}}),
    }
    make := fx_builder()
    n :: fx_param(&make, "n", fx_int(), mir_copy_ownership())
    on :: fx_copy(&make, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    off :: fx_copy(&make, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: false}})
    label :: fx_owned(&make, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "wrapped"}})
    inner :: fx_values_struct(&make, "Flags", [MIRFieldValue]{fx_values_set("Flags", "on", on), fx_values_set("Flags", "off", off), fx_values_set("Flags", "count", n), fx_values_set("Flags", "label", label)})
    marked :: fx_copy(&make, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    built :: fx_values_struct(&make, "Wrap", [MIRFieldValue]{fx_values_set("Wrap", "inner", inner), fx_values_set("Wrap", "tag", marked)})
    fx_block(&make, 0, MIRTerminator.Return{value: Val(built)})

    total := fx_builder()
    w_param :: fx_param(&total, "w", wrap, fx_borrow())
    w_inner :: fx_values_field(&total, w_param, "Wrap", "inner", flags)
    count :: fx_values_field(&total, w_inner, "Flags", "count", fx_int())
    one :: fx_int_const(&total, 1)
    sum :: fx_int_op(&total, MIRBinaryOp.Add, "add", count, one)
    fx_block(&total, 0, MIRTerminator.Return{value: Val(sum)})

    r := fx_builder()
    forty_one :: fx_int_const(&r, 41)
    w :: fx_owned(&r, wrap, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("make")}, args: [MIRCallArg]{fx_arg(forty_one, MIRAccess.Read)}, type_args: [MIRType]{}})
    w_flags :: fx_values_field(&r, w, "Wrap", "inner", flags)
    fx_values_show(&r, w_flags, "Flags", "on", fx_bool())
    fx_values_show(&r, w_flags, "Flags", "off", fx_bool())
    fx_values_show(&r, w_flags, "Flags", "count", fx_int())
    fx_values_show(&r, w_flags, "Flags", "label", fx_string())
    fx_values_show(&r, w, "Wrap", "tag", fx_bool())
    summed :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("total")}, args: [MIRCallArg]{fx_arg(w, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&r, summed)
    c :: fx_owned(&r, wrap, MIROperation.Copy{value: w, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: w, kind: MIRDropKind.Value})
    c_flags :: fx_values_field(&r, c, "Wrap", "inner", flags)
    fx_values_show(&r, c_flags, "Flags", "label", fx_string())
    fx_do(&r, MIROperation.Drop{value: c, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("make", make, wrap), fx_function("total", total, fx_int()), fx_function("run", r, fx_unit())}, ^types)
}

// Stored exact Int fields use word carriers even when their value owns bigint
// storage. Their drop glue must test the Int tag, not compare against a pointer.
// expect-stdout values-int-field-drop: "37\n"
// expect-runtime-only values-int-field-drop
fn fx_values_int_field_drop() -> MIRProgram Never! {
    definition :: fx_type_def("IntDropHolder", MIRTypeDefKind.Struct{
        fields: [MIRField]{fx_field("IntDropHolder", "value", fx_int())},
        methods: [MIRFunctionID]{},
    })
    b := fx_builder()
    loop number in ([Int]{0, -37, 9223372036854775808}) {
        value :: fx_int_const(&b, number)
        holder :: fx_values_struct(&b, "IntDropHolder", [MIRFieldValue]{fx_values_set("IntDropHolder", "value", value)})
        fx_do(&b, MIROperation.Drop{value: holder, kind: MIRDropKind.Value})
    }
    marker :: fx_int_const(&b, 37)
    fx_print(&b, marker)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{definition})
}

fn fx_values_int_field_drop_checks() -> Bool Never! {
    lowered :: lir_lower_entry(fx_values_int_field_drop(), mir_function_id("run"))
    if lowered.issues.len() != 0 || lir_lint_module(lowered.lir).len() != 0 -> return false
    loop function in lowered.lir.functions {
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .Call(_, _, .Runtime(symbol), _) && symbol == "jet_rt_int_drop" -> return true
            }
        }
    }
    false
}

// struct Acc { sum: Int, last: Int }
// fn run() {
//     acc := Acc{sum: 0, last: 0}
//     i := 0
//     loop i < 4 { i += 1; acc = Acc{sum: acc.sum + i, last: i} }
//     print(acc.sum); print(acc.last)
//     pick :: if acc.sum > 5 -> Acc{sum: 1, last: 2} else -> Acc{sum: 3, last: 4}
//     print(pick.sum); print(pick.last)
// }
// expect-stdout values-loop: "10\n4\n1\n2\n"
fn fx_values_loop() -> MIRProgram Never! {
    acc_ty :: fx_named("Acc")
    types :: [MIRTypeDef]{fx_type_def("Acc", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Acc", "sum", fx_int()), fx_field("Acc", "last", fx_int())}, methods: [MIRFunctionID]{}})}
    r := fx_builder()
    acc :: fx_local(&r, "acc", acc_ty, mir_owned_ownership())
    i :: fx_local(&r, "i", fx_int(), mir_copy_ownership())
    zero :: fx_int_const(&r, 0)
    start :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", zero), fx_values_set("Acc", "last", zero)})
    fx_do(&r, MIROperation.WritePlace{place: acc, value: start})
    fx_do(&r, MIROperation.WritePlace{place: i, value: zero})
    fx_block(&r, 0, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    i_now :: fx_copy(&r, fx_int(), MIROperation.ReadPlace{place: i})
    four :: fx_int_const(&r, 4)
    more :: fx_compare(&r, MIRBinaryOp.Lt, i_now, four)
    fx_block(&r, 1, MIRTerminator.Branch{condition: more, then_target: MIRBlockID{value: 2}, else_target: MIRBlockID{value: 3}})
    i_old :: fx_copy(&r, fx_int(), MIROperation.ReadPlace{place: i})
    one :: fx_int_const(&r, 1)
    i_next :: fx_int_op(&r, MIRBinaryOp.Add, "add", i_old, one)
    fx_do(&r, MIROperation.WritePlace{place: i, value: i_next})
    acc_old :: fx_value(&r, acc_ty, fx_borrow(), MIROperation.ReadPlace{place: acc})
    old_sum :: fx_values_field(&r, acc_old, "Acc", "sum", fx_int())
    new_sum :: fx_int_op(&r, MIRBinaryOp.Add, "add", old_sum, i_next)
    next :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", new_sum), fx_values_set("Acc", "last", i_next)})
    fx_do(&r, MIROperation.ReplacePlace{place: acc, value: next})
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    acc_end :: fx_value(&r, acc_ty, fx_borrow(), MIROperation.ReadPlace{place: acc})
    end_sum :: fx_values_field(&r, acc_end, "Acc", "sum", fx_int())
    fx_print(&r, end_sum)
    fx_values_show(&r, acc_end, "Acc", "last", fx_int())
    five :: fx_int_const(&r, 5)
    large :: fx_compare(&r, MIRBinaryOp.Gt, end_sum, five)
    fx_block(&r, 3, MIRTerminator.Branch{condition: large, then_target: MIRBlockID{value: 4}, else_target: MIRBlockID{value: 5}})
    one_a :: fx_int_const(&r, 1)
    two_a :: fx_int_const(&r, 2)
    picked_large :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", one_a), fx_values_set("Acc", "last", two_a)})
    fx_block(&r, 4, MIRTerminator.Jump{target: MIRBlockID{value: 6}})
    three_b :: fx_int_const(&r, 3)
    four_b :: fx_int_const(&r, 4)
    picked_small :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", three_b), fx_values_set("Acc", "last", four_b)})
    fx_block(&r, 5, MIRTerminator.Jump{target: MIRBlockID{value: 6}})
    pick :: fx_owned(&r, acc_ty, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 4}, value: picked_large}, MIRPhiIncoming{block: MIRBlockID{value: 5}, value: picked_small}}})
    fx_values_show(&r, pick, "Acc", "sum", fx_int())
    fx_values_show(&r, pick, "Acc", "last", fx_int())
    fx_block(&r, 6, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, ^types)
}

// Loop-carried phis that swap: every iteration's new Acc is built in the same
// frame storage, and `a` takes `b`'s value while `b` takes the new one.
// fn run() {
//     (a, b, n) := (Acc{sum: 1, last: 10}, Acc{sum: 2, last: 20}, 0)
//     loop n < 3 { (a, b, n) = (b, Acc{sum: a.sum + b.sum, last: a.last}, n + 1) }
//     print(a.sum); print(a.last); print(b.sum); print(b.last)
// }
// expect-stdout values-phi: "5\n20\n8\n10\n"
fn fx_values_phi() -> MIRProgram Never! {
    acc_ty :: fx_named("Acc")
    types :: [MIRTypeDef]{fx_type_def("Acc", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Acc", "sum", fx_int()), fx_field("Acc", "last", fx_int())}, methods: [MIRFunctionID]{}})}
    r := fx_builder()
    one :: fx_int_const(&r, 1)
    ten :: fx_int_const(&r, 10)
    a0 :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", one), fx_values_set("Acc", "last", ten)})
    two :: fx_int_const(&r, 2)
    twenty :: fx_int_const(&r, 20)
    b0 :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", two), fx_values_set("Acc", "last", twenty)})
    n0 :: fx_int_const(&r, 0)
    fx_block(&r, 0, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    // Phi operands from block 2 are defined below; their ids are fixed by
    // creation order: b2's `c` and `n1` follow the three phis and `more`.
    a_ids :: r.next
    a :: fx_owned(&r, acc_ty, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 0}, value: a0}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: MIRValueID{value: 100 + a_ids + 2}}}})
    b :: fx_owned(&r, acc_ty, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 0}, value: b0}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: MIRValueID{value: 100 + a_ids + 10}}}})
    n :: fx_copy(&r, fx_int(), MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 0}, value: n0}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: MIRValueID{value: 100 + a_ids + 12}}}})
    three :: fx_int_const(&r, 3)
    more :: fx_compare(&r, MIRBinaryOp.Lt, n, three)
    fx_block(&r, 1, MIRTerminator.Branch{condition: more, then_target: MIRBlockID{value: 2}, else_target: MIRBlockID{value: 3}})
    a_sum :: fx_values_field(&r, a, "Acc", "sum", fx_int())
    b_sum :: fx_values_field(&r, b, "Acc", "sum", fx_int())
    a_last :: fx_values_field(&r, a, "Acc", "last", fx_int())
    new_sum :: fx_int_op(&r, MIRBinaryOp.Add, "add", a_sum, b_sum)
    c :: fx_values_struct(&r, "Acc", [MIRFieldValue]{fx_values_set("Acc", "sum", new_sum), fx_values_set("Acc", "last", a_last)})
    step :: fx_int_const(&r, 1)
    n1 :: fx_int_op(&r, MIRBinaryOp.Add, "add", n, step)
    if b.value != 100 + a_ids + 2 || c.value != 100 + a_ids + 10 || n1.value != 100 + a_ids + 12 -> panic("fx_values_phi: phi operand ids drifted")
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    fx_values_show(&r, a, "Acc", "sum", fx_int())
    fx_values_show(&r, a, "Acc", "last", fx_int())
    fx_values_show(&r, b, "Acc", "sum", fx_int())
    fx_values_show(&r, b, "Acc", "last", fx_int())
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, ^types)
}

// Ordinary Result encode -> decode for both arms, with unlike payload layouts.
// The codec shares the selector/offset definitions used by these operations.
// expect-stdout values-result-roundtrip: "true\n7\nok\nfalse\nfault\n"
fn fx_values_result_roundtrip() -> MIRProgram Never! {
    pt :: fx_named("Pt")
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: pt, err: fx_string()})
    types :: [MIRTypeDef]{fx_type_def("Pt", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Pt", "x", fx_int()), fx_field("Pt", "on", fx_bool()), fx_field("Pt", "name", fx_string())}, methods: [MIRFunctionID]{}})}
    b := fx_builder()
    payload :: fx_values_pt(&b, 7, true, "ok")
    success :: fx_owned(&b, result_ty, MIROperation.ResultOk{value: payload})
    success_tag :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: success})
    fx_print(&b, success_tag)
    decoded_success :: fx_value(&b, pt, fx_borrow(), MIROperation.ResultValue{subject: success, ok: true})
    fx_values_show(&b, decoded_success, "Pt", "x", fx_int())
    fx_values_show(&b, decoded_success, "Pt", "name", fx_string())
    fx_do(&b, MIROperation.Drop{value: success, kind: MIRDropKind.Value})
    error :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "fault"}})
    failure :: fx_owned(&b, result_ty, MIROperation.ResultErr{value: error})
    failure_tag :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: failure})
    fx_print(&b, failure_tag)
    decoded_failure :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.ResultValue{subject: failure, ok: false})
    fx_print(&b, decoded_failure)
    fx_do(&b, MIROperation.Drop{value: failure, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}

// struct Pt { x: Int, on: Bool, name: String }
// enum Holder { Empty, Has(Pt) }
// fn run() {
//     o :: Val(Pt{x: 7, on: true, name: "opt"}); print(o!.name); print(o!.x)
//     h :: Holder.Has(Pt{x: 9, on: false, name: "enum"})
//     if h == .Has(p) { print(p.name); print(p.on) }
//     l :: [Pt{x: 1, on: true, name: "a"}, Pt{x: 2, on: false, name: "b"}]
//     print(l[1].name); print(l[0].x)
//     drop(o); drop(h); drop(l)
// }
// expect-stdout values-payload: "opt\n7\nenum\nfalse\nb\n1\n"
fn fx_values_payload() -> MIRProgram Never! {
    pt :: fx_named("Pt")
    holder :: fx_named("Holder")
    maybe :: mir_type_from_kind(MIRTypeKind.Option{inner: pt})
    list :: mir_type_from_kind(MIRTypeKind.List{inner: pt})
    types :: [MIRTypeDef]{
        fx_type_def("Pt", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Pt", "x", fx_int()), fx_field("Pt", "on", fx_bool()), fx_field("Pt", "name", fx_string())}, methods: [MIRFunctionID]{}}),
        fx_type_def("Holder", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("Empty", MIRVariantPayload.Unit), fx_variant("Has", MIRVariantPayload.Single{value: pt})}, methods: [MIRFunctionID]{}}),
    }
    r := fx_builder()
    o_pt :: fx_values_pt(&r, 7, true, "opt")
    o :: fx_owned(&r, maybe, MIROperation.Present{value: o_pt})
    o_value :: fx_value(&r, pt, fx_borrow(), MIROperation.OptionValue{subject: o})
    fx_values_show(&r, o_value, "Pt", "name", fx_string())
    fx_values_show(&r, o_value, "Pt", "x", fx_int())
    h_pt :: fx_values_pt(&r, 9, false, "enum")
    h :: fx_owned(&r, holder, MIROperation.Enum{type_id: mir_type_id("Holder"), variant: "Has", args: [MIREnumArg]{MIREnumArg{field: None, value: h_pt, boxed: false}}})
    has :: fx_copy(&r, fx_bool(), MIROperation.EnumIs{subject: h, owner: mir_type_id("Holder"), variant: "Has"})
    fx_block(&r, 0, MIRTerminator.Branch{condition: has, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    p :: fx_value(&r, pt, fx_borrow(), MIROperation.EnumPayload{subject: h, owner: mir_type_id("Holder"), variant: "Has", index: 0})
    fx_values_show(&r, p, "Pt", "name", fx_string())
    fx_values_show(&r, p, "Pt", "on", fx_bool())
    fx_block(&r, 1, MIRTerminator.Jump{target: MIRBlockID{value: 2}})
    first :: fx_values_pt(&r, 1, true, "a")
    second :: fx_values_pt(&r, 2, false, "b")
    l :: fx_owned(&r, list, MIROperation.BuildList{values: [MIRValueID]{first, second}, trait_coercion: None})
    index_one :: fx_int_const(&r, 1)
    second_read :: fx_list_index(&r, l, index_one, pt, false)
    fx_values_show(&r, second_read, "Pt", "name", fx_string())
    index_zero :: fx_int_const(&r, 0)
    first_read :: fx_list_index(&r, l, index_zero, pt, false)
    fx_values_show(&r, first_read, "Pt", "x", fx_int())
    fx_do(&r, MIROperation.Drop{value: o, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: h, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: l, kind: MIRDropKind.Value})
    fx_block(&r, 2, MIRTerminator.Return{value: None})
    fx_list_program_with(fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, ^types))
}

fn fx_values_pt(b: &FxBuilder, x: Int, on: Bool, name: String) -> MIRValueID Never! {
    x_value :: fx_int_const(&b, x)
    on_value :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: on}})
    name_value :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: name}})
    fx_values_struct(&b, "Pt", [MIRFieldValue]{fx_values_set("Pt", "x", x_value), fx_values_set("Pt", "on", on_value), fx_values_set("Pt", "name", name_value)})
}

// The List Prelude rows of fx_list_program, added to any program.
fn fx_list_program_with(program: MIRProgram) -> MIRProgram Never! {
    p := program
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.list", "get", "jet_list_get", 4, MIRPreludeABI.Value))
    p
}

// expect-stdout carrier-facts: "kept\nnote\nfalse\n0\n"
fn fx_carrier_facts() -> MIRProgram Never! {
    report_ty :: fx_named("CarrierReport")
    notes_ty :: fx_list_type(fx_string())
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_int(), err: report_ty})
    partial_ty :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_string()})
    b := fx_builder()
    kept :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "kept"}})
    note :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "note"}})
    notes :: fx_owned(&b, notes_ty, MIROperation.BuildList{values: [MIRValueID]{note}, trait_coercion: None})
    report :: fx_values_struct(&b, "CarrierReport", [MIRFieldValue]{fx_values_set("CarrierReport", "partial", kept), fx_values_set("CarrierReport", "notes", notes)})
    failure :: fx_owned(&b, result_ty, MIROperation.ResultErr{value: report})
    partial :: fx_owned(&b, partial_ty, MIROperation.Semantic{operation: MIRSemanticOp.CarrierFact{call: fx_prelude_id("core.outcome", "partial"), receiver: failure, field: mir_field_id("CarrierReport.partial"), notes: false}})
    copied_notes :: fx_owned(&b, notes_ty, MIROperation.Semantic{operation: MIRSemanticOp.CarrierFact{call: fx_prelude_id("core.outcome", "notes"), receiver: failure, field: mir_field_id("CarrierReport.notes"), notes: true}})
    fx_do(&b, MIROperation.Drop{value: failure, kind: MIRDropKind.Value})
    text :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.OptionValue{subject: partial})
    fx_print(&b, text)
    zero :: fx_int_const(&b, 0)
    first_note :: fx_list_index(&b, copied_notes, zero, fx_string(), false)
    fx_print(&b, first_note)
    fx_do(&b, MIROperation.Drop{value: partial, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: copied_notes, kind: MIRDropKind.Value})
    one :: fx_int_const(&b, 1)
    success :: fx_owned(&b, result_ty, MIROperation.ResultOk{value: one})
    absent :: fx_owned(&b, partial_ty, MIROperation.Semantic{operation: MIRSemanticOp.CarrierFact{call: fx_prelude_id("core.outcome", "partial"), receiver: success, field: mir_field_id("CarrierReport.partial"), notes: false}})
    empty_notes :: fx_owned(&b, notes_ty, MIROperation.Semantic{operation: MIRSemanticOp.CarrierFact{call: fx_prelude_id("core.outcome", "notes"), receiver: success, field: mir_field_id("CarrierReport.notes"), notes: true}})
    has_partial :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: absent})
    fx_print(&b, has_partial)
    note_count :: fx_list_method(&b, "len", empty_notes, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, note_count)
    fx_do(&b, MIROperation.Drop{value: success, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: absent, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: empty_notes, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(b)
    &p.types.push(fx_type_def("CarrierReport", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("CarrierReport", "partial", fx_string()), fx_field("CarrierReport", "notes", notes_ty)}, methods: [MIRFunctionID]{}}))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.outcome", "partial", "jet_partial", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.outcome", "notes", "jet_notes", 1, MIRPreludeABI.Value))
    p
}

// expect-stdout reflect-of: "Point\nroot\npoint display\nvalue\n7\n0\n"
// expect-runtime-only reflect-of
fn fx_reflect_of() -> MIRProgram Never! {
    value_ty :: fx_named("Value")
    field_ty :: fx_named("Field")
    fields_ty :: fx_list_type(field_ty)
    b := fx_builder()
    display :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "point display"}})
    seven :: fx_int_const(&b, 7)
    reflected :: fx_owned(&b, value_ty, MIROperation.Semantic{operation: MIRSemanticOp.ReflectOf{type_name: "Point", path: "root", display: display, fields: [MIRReflectField]{MIRReflectField{name: "value", type_name: "Int", path: "root.value", value: seven}}}})
    fx_values_show(&b, reflected, "Value", "type_name", fx_string())
    fx_values_show(&b, reflected, "Value", "path", fx_string())
    fx_values_show(&b, reflected, "Value", "display", fx_string())
    fields :: fx_values_field(&b, reflected, "Value", "fields", fields_ty)
    zero :: fx_int_const(&b, 0)
    first :: fx_list_index(&b, fields, zero, field_ty, false)
    fx_values_show(&b, first, "Field", "name", fx_string())
    child :: fx_values_field(&b, first, "Field", "value", value_ty)
    fx_values_show(&b, child, "Value", "display", fx_string())
    empty :: fx_values_field(&b, child, "Value", "fields", fields_ty)
    count :: fx_list_method(&b, "len", empty, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, count)
    fx_do(&b, MIROperation.Drop{value: reflected, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(b)
    &p.types.push(fx_type_def("Value", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Value", "type_name", fx_string()), fx_field("Value", "path", fx_string()), fx_field("Value", "display", fx_string()), fx_field("Value", "fields", fields_ty)}, methods: [MIRFunctionID]{}}))
    &p.types.push(fx_type_def("Field", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Field", "name", fx_string()), fx_field("Field", "value", value_ty)}, methods: [MIRFunctionID]{}}))
    p
}

fn fx_dir_entry_definition(key: String) -> MIRTypeDef Never! {
    definition := fx_type_def(key, MIRTypeDefKind.Struct{fields: [MIRField]{
        fx_field(key, "name", fx_string()),
        fx_field(key, "path", fx_string()),
        fx_field(key, "is_dir", fx_bool()),
    }, methods: [MIRFunctionID]{}})
    definition.name = "DirEntry"
    definition
}

fn fx_qualified_record_identity_checks() -> Bool Never! {
    core_key :: "<corelib>/core.files::DirEntry"
    core_ty :: fx_named(core_key)
    definition :: fx_dir_entry_definition(core_key)
    program :: fx_program([MIRFunction]{}, [MIRTypeDef]{definition})
    carrier :: LowerRouteCarrier.List{elem: LowerRouteCarrier.Handle{name: "DirEntry"}}
    if lower_record_handle(program, core_ty) != Val("DirEntry") -> return false
    if !lower_route_result_matches(program, fx_list_type(core_ty), carrier) -> return false
    // Matching a runtime short name never authorizes an unrelated nominal.
    user_key :: "user.files::files.jet::DirEntry"
    user_ty :: fx_named(user_key)
    user :: fx_program([MIRFunction]{}, [MIRTypeDef]{fx_dir_entry_definition(user_key)})
    if lower_record_handle(user, user_ty) != None -> return false
    // Declaration identity does not bypass the runtime's stored-field schema.
    changed := fx_dir_entry_definition(core_key)
    changed.kind = MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(core_key, "name", fx_int())}, methods: [MIRFunctionID]{}}
    stale :: fx_program([MIRFunction]{}, [MIRTypeDef]{changed})
    if lower_record_handle(stale, core_ty) != None -> return false
    true
}

// A route-returned record List is a buffer of runtime handles rebuilt into
// native rows (Lower/Routes.jet): read the first entry's fields, so a shape
// drift between the provider and the lowering fails as a wrong value here
// instead of a pointer-sized allocation in the first user of `entry.name`.
// expect-stdout qualified-dir-entries: "true\n2\ntrue\n"
// expect-runtime-only qualified-dir-entries: real directory results rebuild, read and drop native DirEntry slots
// expect-requires-route qualified-dir-entries jet_std_fs_list_dir_raw
fn fx_qualified_dir_entries() -> MIRProgram Never! {
    key :: "<corelib>/core.files::DirEntry"
    entries :: fx_list_type(fx_named(key))
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: entries, err: fx_named("IOError")})
    b := fx_builder()
    path :: fx_strings_literal(&b, ".")
    result :: fx_owned(&b, result_ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.files", "list_dir"), args: [MIRCallArg]{fx_arg(path, .Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    ok :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: result})
    fx_print(&b, ok)
    listed :: fx_value(&b, entries, fx_borrow(), MIROperation.ResultValue{subject: result, ok: true})
    zero :: fx_int_const(&b, 0)
    first :: fx_list_index(&b, listed, zero, fx_named(key), false)
    name :: fx_values_field(&b, first, "DirEntry", "name", fx_string())
    full :: fx_values_field(&b, first, "DirEntry", "path", fx_string())
    name_len :: fx_list_method(&b, "len", name, None, [MIRValueID]{}, fx_int(), false)
    path_len :: fx_list_method(&b, "len", full, None, [MIRValueID]{}, fx_int(), false)
    // `path` is `./<name>`: two bytes longer than `name`, which is never empty.
    extra :: fx_int_op(&b, MIRBinaryOp.Sub, "sub", path_len, name_len)
    fx_print(&b, extra)
    named :: fx_compare(&b, MIRBinaryOp.Gt, name_len, zero)
    fx_print(&b, named)
    fx_do(&b, MIROperation.Drop{value: result, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: path, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{fx_dir_entry_definition(key)})
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.files", "list_dir", "jet_std_fs_list_dir", 1, MIRPreludeABI.Value))
    program
}
