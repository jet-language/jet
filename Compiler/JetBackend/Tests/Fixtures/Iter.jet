use jet_foundation.[
    MIRBinaryOp, MIRBlockID, MIRDropKind, MIRFunction, MIRLoopSourceKind,
    MIROperation, MIRPlaceID, MIRPreludeABI, MIRPreludeFamily, MIRProgram,
    MIRTerminator, MIRType, MIRTypeDef, MIRValueID, mir_owned_ownership,
]

fn fx_iter_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    members :: [String]{"loop_iter_init", "loop_iter_has_next", "loop_iter_value", "loop_iter_advance"}
    loop (index, member) in members {
        row := fx_prelude(MIRPreludeFamily.StaticPrelude, "core.loop", member, "jet_{member}", if index == 0 -> 5 else -> 1, MIRPreludeABI.Value)
        row.signature.borrow_mask[0] = true
        &p.prelude_calls.push(row)
    }
    p
}

fn fx_iter_init(b: &FxBuilder, list: MIRValueID, by_value: Bool, step: MIRValueID?) -> MIRValueID Never! {
    fx_owned(&b, fx_named("IterCursor"), MIROperation.LoopIterInit{
        call: fx_prelude_id("core.loop", "loop_iter_init"), collection: list,
        step: step, by_value: by_value, source_kind: MIRLoopSourceKind.Plain,
    })
}

fn fx_iter_value(b: &FxBuilder, cursor: MIRValueID, elem: MIRType, owned: Bool) -> MIRValueID Never! {
    operation :: MIROperation.LoopIterValue{call: fx_prelude_id("core.loop", "loop_iter_value"), cursor: cursor}
    if owned -> fx_owned(&b, elem, operation) else -> fx_value(&b, elem, fx_borrow(), operation)
}

fn fx_iter_loop(b: &FxBuilder, list: MIRValueID, elem: MIRType, by_value: Bool, step: MIRValueID?, sum: MIRPlaceID?, entry: U64) -> U64 Never! {
    cursor :: fx_iter_init(&b, list, by_value, step)
    fx_block(&b, entry, MIRTerminator.Jump{target: MIRBlockID{value: entry + 1}})
    more :: fx_copy(&b, fx_bool(), MIROperation.LoopIterHasNext{call: fx_prelude_id("core.loop", "loop_iter_has_next"), cursor: cursor})
    fx_block(&b, entry + 1, MIRTerminator.Branch{condition: more, then_target: MIRBlockID{value: entry + 2}, else_target: MIRBlockID{value: entry + 3}})
    item :: fx_iter_value(&b, cursor, elem, by_value)
    if sum == .Val(place) {
        previous :: fx_copy(&b, fx_int(), MIROperation.ReadPlace{place: place})
        next_sum :: fx_int_op(&b, MIRBinaryOp.Add, "add", previous, item)
        fx_do(&b, MIROperation.WritePlace{place: place, value: next_sum})
    } else {
        fx_print(&b, item)
    }
    if by_value -> fx_do(&b, MIROperation.Drop{value: item, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.LoopIterAdvance{call: fx_prelude_id("core.loop", "loop_iter_advance"), cursor: cursor})
    fx_block(&b, entry + 2, MIRTerminator.Jump{target: MIRBlockID{value: entry + 1}})
    fx_do(&b, MIROperation.Drop{value: cursor, kind: MIRDropKind.Value})
    entry + 3
}

fn fx_iter_strings(b: &FxBuilder, values: [String]) -> MIRValueID Never! {
    elements := [MIRValueID]{}
    loop value in values -> &elements.push(fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: value}}))
    fx_owned(&b, fx_list_type(fx_string()), MIROperation.BuildList{values: elements, trait_coercion: None})
}

// fn run() {
//   xs :: [1, 2, 3]; sum := 0; loop n in xs -> sum += n; print(sum);
//   names :: ["red", "blue"]; loop name in names -> print(name);
//   owned :: ["gold", "silver"]; loop name in ^owned -> print(name);
//   steps :: [10, 20, 30, 40, 50]; loop n in steps by 2 -> print(n);
//   skipped :: ["first", "skip", "third", "tail"];
//   loop name in ^skipped by 2 -> print(name);
//   early :: ["keep", "remaining"]; loop name in ^early { print(name); break; }
//   empty :: [String]{}; loop name in ^empty -> print(name);
// }
// expect-stdout iter: "6\nred\nblue\ngold\nsilver\n10\n30\n50\nfirst\nthird\nkeep\n"
fn fx_iter() -> MIRProgram Never! {
    b := fx_builder()
    sum :: fx_local(&b, "sum", fx_int(), mir_owned_ownership())
    zero :: fx_int_const(&b, 0)
    fx_do(&b, MIROperation.WritePlace{place: sum, value: zero})
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    three :: fx_int_const(&b, 3)
    xs :: fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: [MIRValueID]{one, two, three}, trait_coercion: None})
    at := fx_iter_loop(&b, xs, fx_int(), false, None, Val(sum), 0)
    total :: fx_copy(&b, fx_int(), MIROperation.ReadPlace{place: sum})
    fx_print(&b, total)
    fx_do(&b, MIROperation.Drop{value: xs, kind: MIRDropKind.Value})
    names :: fx_iter_strings(&b, [String]{"red", "blue"})
    at = fx_iter_loop(&b, names, fx_string(), false, None, None, at)
    fx_do(&b, MIROperation.Drop{value: names, kind: MIRDropKind.Value})
    owned :: fx_iter_strings(&b, [String]{"gold", "silver"})
    at = fx_iter_loop(&b, owned, fx_string(), true, None, None, at)
    elements := [MIRValueID]{}
    numbers :: [Int]{10, 20, 30, 40, 50}
    loop n in numbers -> &elements.push(fx_int_const(&b, n))
    steps :: fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: elements, trait_coercion: None})
    at = fx_iter_loop(&b, steps, fx_int(), false, Val(two), None, at)
    fx_do(&b, MIROperation.Drop{value: steps, kind: MIRDropKind.Value})
    skipped :: fx_iter_strings(&b, [String]{"first", "skip", "third", "tail"})
    at = fx_iter_loop(&b, skipped, fx_string(), true, Val(two), None, at)
    early :: fx_iter_strings(&b, [String]{"keep", "remaining"})
    early_cursor :: fx_iter_init(&b, early, true, None)
    keep :: fx_iter_value(&b, early_cursor, fx_string(), true)
    // The moved String stays alive after cursor drop frees the remaining owner.
    fx_do(&b, MIROperation.Drop{value: early_cursor, kind: MIRDropKind.Value})
    fx_print(&b, keep)
    fx_do(&b, MIROperation.Drop{value: keep, kind: MIRDropKind.Value})
    empty :: fx_iter_strings(&b, [String]{})
    at = fx_iter_loop(&b, empty, fx_string(), true, None, None, at)
    fx_block(&b, at, MIRTerminator.Return{value: None})
    fx_iter_program(b)
}

// fn run() { xs :: [1]; loop n in xs by 0 -> print(n); }
// expect-stdout iter-zero-step: ""
// expect-exit iter-zero-step: 70
fn fx_iter_zero_step() -> MIRProgram Never! {
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    xs :: fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: [MIRValueID]{one}, trait_coercion: None})
    zero :: fx_int_const(&b, 0)
    at :: fx_iter_loop(&b, xs, fx_int(), false, Val(zero), None, 0)
    fx_do(&b, MIROperation.Drop{value: xs, kind: MIRDropKind.Value})
    fx_block(&b, at, MIRTerminator.Return{value: None})
    fx_iter_program(b)
}

// fn run() { xs :: ["last"]; loop name in ^xs by Int.MAX -> print(name); }
// expect-stdout iter-large-step: "last\n"
fn fx_iter_large_step() -> MIRProgram Never! {
    b := fx_builder()
    xs :: fx_iter_strings(&b, [String]{"last"})
    step :: fx_int_const(&b, 4611686018427387903)
    at :: fx_iter_loop(&b, xs, fx_string(), true, Val(step), None, 0)
    fx_block(&b, at, MIRTerminator.Return{value: None})
    fx_iter_program(b)
}

// fn run() { xs :: ["first", "skip"]; loop n in ^xs by Int{I64{4611686018427387904}} -> print(n); }
// expect-stdout iter-big-step: ""
// expect-exit iter-big-step: 70
// expect-static-only iter-big-step
// Hosted expectation: "first\n", exit 0: big Int still fits native i64.
fn fx_iter_big_step() -> MIRProgram Never! {
    b := fx_builder()
    xs :: fx_iter_strings(&b, [String]{"first", "skip"})
    fixed :: fx_i64_const(&b, 4611686018427387904)
    step :: fx_convert_cast(&b, fixed, fx_int())
    at :: fx_iter_loop(&b, xs, fx_string(), true, Val(step), None, 0)
    fx_block(&b, at, MIRTerminator.Return{value: None})
    fx_iter_program(b)
}

// fn run() { xs :: ["first"]; loop n in ^xs by (Int{I64{9223372036854775807}} + 1) -> print(n); }
// MIRRust.rs:index_operand :23161 rejects a step outside native i64 in the host.
// expect-stdout iter-big-step-overflow: ""
// expect-exit iter-big-step-overflow: 70
fn fx_iter_big_step_overflow() -> MIRProgram Never! {
    b := fx_builder()
    xs :: fx_iter_strings(&b, [String]{"first"})
    maximum :: fx_i64_const(&b, 9223372036854775807)
    exact :: fx_convert_cast(&b, maximum, fx_int())
    one :: fx_int_const(&b, 1)
    step :: fx_int_op(&b, MIRBinaryOp.Add, "add", exact, one)
    at :: fx_iter_loop(&b, xs, fx_string(), true, Val(step), None, 0)
    fx_block(&b, at, MIRTerminator.Return{value: None})
    fx_iter_program(b)
}
