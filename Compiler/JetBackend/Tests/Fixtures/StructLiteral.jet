use jet_foundation.[
    MIRConstant,
    MIRDropKind,
    MIRField,
    MIRFieldID,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIROperation,
    MIRProgram,
    MIRSemanticOp,
    MIRTerminator,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRValueID,
    mir_field_id,
    mir_type_id,
]

fn fx_struct_literal_value(b: &FxBuilder, name: String, fields: [MIRFieldValue], boxed_fields: [MIRFieldID]) -> MIRValueID Never! {
    fx_owned(&b, fx_named(name), MIROperation.Semantic{operation: MIRSemanticOp.StructLiteral{type_id: mir_type_id(name), fields: fields, extra: None, trait_coercion: None, boxed_fields: boxed_fields}})
}

fn fx_struct_literal_field(name: String, value: MIRValueID) -> MIRFieldValue Never! {
    MIRFieldValue{field: mir_field_id(name), value: value}
}

fn fx_struct_literal_print(b: &FxBuilder, record: MIRValueID, name: String) Never! {
    label :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: record, field: mir_field_id("{name}.label")})
    child :: fx_value(&b, fx_named("LiteralLeaf"), fx_borrow(), MIROperation.Field{base: record, field: mir_field_id("{name}.child")})
    text :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: child, field: mir_field_id("LiteralLeaf.text")})
    fx_print(&b, label)
    fx_print(&b, text)
}

fn fx_struct_literal_record_type(name: String) -> MIRTypeDef Never! {
    fx_type_def(name, MIRTypeDefKind.Struct{fields: [MIRField]{
        fx_field(name, "label", fx_string()),
        fx_stored_or_computed(name, "description", fx_string(), true),
        fx_field(name, "unit", fx_unit()),
        fx_field(name, "child", fx_named("LiteralLeaf")),
    }, methods: [MIRFunctionID]{}})
}

// struct LiteralLeaf { text: String }
// struct LiteralRecord { label: String, description: String -> "computed", unit: Unit, child: LiteralLeaf }
// fn run() {
//     base :: LiteralRecord{label: "base", unit: Unit, child: LiteralLeaf{text: "nested"}}
//     print(base.label); print(base.child.text)
//     // A borrowed-base update is explicit field cloning in this MIR schema;
//     // MIRStructExtra is an HTTPRequest marker, never a base value operand.
//     updated :: LiteralRecord{label: "updated", unit: Unit, child: base.child.clone()}
//     print(base.label); print(base.child.text)
//     drop(base)
//     print(updated.label); print(updated.child.text)
//     drop(updated)
//     // LiteralEdgeRecord models the checked recursive-edge wrapper layout.
//     edge :: LiteralEdgeRecord{label: "boxed", unit: Unit, child: LiteralLeaf{text: "edge"}}
//     duplicate :: edge.clone(); drop(edge)
//     print(duplicate.label); print(duplicate.child.text); drop(duplicate)
//     ordinary :: LiteralEdgeRecord{label: "ordinary", unit: Unit, child: LiteralLeaf{text: "shared"}}
//     print(ordinary.label); print(ordinary.child.text); drop(ordinary)
// }
// expect-stdout struct-literal: "base\nnested\nbase\nnested\nupdated\nnested\nboxed\nedge\nordinary\nshared\n"
fn fx_struct_literal() -> MIRProgram Never! {
    leaf_ty :: fx_named("LiteralLeaf")
    edge_ty :: fx_named("LiteralEdgeRecord")
    edge_def := fx_struct_literal_record_type("LiteralEdgeRecord")
    edge_def.boxed_edges = [String]{"label", "unit", "child"}
    types :: [MIRTypeDef]{
        fx_type_def("LiteralLeaf", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("LiteralLeaf", "text", fx_string())}, methods: [MIRFunctionID]{}}),
        fx_struct_literal_record_type("LiteralRecord"),
        edge_def,
    }
    r := fx_builder()
    unit :: fx_copy(&r, fx_unit(), MIROperation.Constant{value: MIRConstant.Unit})
    nested :: fx_strings_literal(&r, "nested")
    child :: fx_struct_literal_value(&r, "LiteralLeaf", [MIRFieldValue]{fx_struct_literal_field("LiteralLeaf.text", nested)}, [MIRFieldID]{})
    label :: fx_strings_literal(&r, "base")
    // Operand order differs from declaration order, and the computed field
    // must not occupy a slot between the String and nested record.
    base :: fx_struct_literal_value(&r, "LiteralRecord", [MIRFieldValue]{
        fx_struct_literal_field("LiteralRecord.child", child),
        fx_struct_literal_field("LiteralRecord.unit", unit),
        fx_struct_literal_field("LiteralRecord.label", label),
    }, [MIRFieldID]{})
    fx_struct_literal_print(&r, base, "LiteralRecord")
    borrowed_child :: fx_value(&r, leaf_ty, fx_borrow(), MIROperation.Field{base: base, field: mir_field_id("LiteralRecord.child")})
    updated_label :: fx_strings_literal(&r, "updated")
    copied_child :: fx_owned(&r, leaf_ty, MIROperation.Copy{value: borrowed_child, fact: MIRCopyFact.Explicit})
    updated :: fx_struct_literal_value(&r, "LiteralRecord", [MIRFieldValue]{
        fx_struct_literal_field("LiteralRecord.label", updated_label),
        fx_struct_literal_field("LiteralRecord.child", copied_child),
        fx_struct_literal_field("LiteralRecord.unit", unit),
    }, [MIRFieldID]{})
    fx_struct_literal_print(&r, base, "LiteralRecord")
    fx_do(&r, MIROperation.Drop{value: base, kind: MIRDropKind.Value})
    fx_struct_literal_print(&r, updated, "LiteralRecord")
    fx_do(&r, MIROperation.Drop{value: updated, kind: MIRDropKind.Value})
    boxed_label :: fx_strings_literal(&r, "boxed")
    edge_text :: fx_strings_literal(&r, "edge")
    edge_child :: fx_struct_literal_value(&r, "LiteralLeaf", [MIRFieldValue]{fx_struct_literal_field("LiteralLeaf.text", edge_text)}, [MIRFieldID]{})
    // Listed label boxing and declaration-only child/Unit boxing both apply.
    edge :: fx_struct_literal_value(&r, "LiteralEdgeRecord", [MIRFieldValue]{
        fx_struct_literal_field("LiteralEdgeRecord.label", boxed_label),
        fx_struct_literal_field("LiteralEdgeRecord.unit", unit),
        fx_struct_literal_field("LiteralEdgeRecord.child", edge_child),
    }, [MIRFieldID]{mir_field_id("LiteralEdgeRecord.label")})
    duplicate :: fx_owned(&r, edge_ty, MIROperation.Copy{value: edge, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: edge, kind: MIRDropKind.Value})
    fx_struct_literal_print(&r, duplicate, "LiteralEdgeRecord")
    fx_do(&r, MIROperation.Drop{value: duplicate, kind: MIRDropKind.Value})
    ordinary_label :: fx_strings_literal(&r, "ordinary")
    ordinary_text :: fx_strings_literal(&r, "shared")
    ordinary_child :: fx_owned(&r, leaf_ty, MIROperation.Struct{type_id: mir_type_id("LiteralLeaf"), fields: [MIRFieldValue]{fx_struct_literal_field("LiteralLeaf.text", ordinary_text)}})
    ordinary :: fx_owned(&r, edge_ty, MIROperation.Struct{type_id: mir_type_id("LiteralEdgeRecord"), fields: [MIRFieldValue]{
        fx_struct_literal_field("LiteralEdgeRecord.child", ordinary_child),
        fx_struct_literal_field("LiteralEdgeRecord.label", ordinary_label),
        fx_struct_literal_field("LiteralEdgeRecord.unit", unit),
    }})
    fx_struct_literal_print(&r, ordinary, "LiteralEdgeRecord")
    fx_do(&r, MIROperation.Drop{value: ordinary, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, ^types)
}
