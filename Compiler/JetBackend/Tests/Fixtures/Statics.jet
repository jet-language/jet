// Frozen module constant reads, nested pointer relocations, and owned clones.
use jet_foundation.[
    MIRAccess, MIRBinaryOp, MIRCallee, MIRCallArg, MIRConstant, MIRConstantDef,
    MIRConstantID, MIRConstEnumArg, MIRConstField, MIRDropKind, MIRField,
    MIRFunction, MIRFunctionID, MIRModuleID, MIROperation, MIRPayloadKind, MIRProgram,
    MIRStringFormat, MIRStringPart, MIRStringPartKind, MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRValueID,
    MIRVariant, MIRVariantPayload, MIRVisibility,
    mir_field_id, mir_function_id, mir_owned_ownership, mir_type_id,
    MIRSharedSite, MIRSharedLifetime, MIRTypeKind, MIRPreludeFamily, MIRPreludeABI, MIRSemanticOp, MIRPreludeTypeArg,
    mir_shared_site_getter_symbol, mir_type_from_kind,
    MIRPlace, MIRPlaceID, MIRProjection, MIRIndexKind, MIRConstMapEntry, MIRPanicLoc,
]
use jet_backend.[
    LIRBlockID,
    LIRCallConv,
    LIRCallee,
    LIRCondition,
    LIRDrop,
    LIRFunction,
    LIRFunctionID,
    LIRInst,
    LIRLayout,
    LIRModule,
    LIRSignature,
    LIRSignatureID,
    LIRTerminator,
    LIRValue,
    LIRValueID,
    lir_layout_bool,
    lir_layout_pointer,
    lir_lower_entry,
    lir_lower_callables,
    lir_lower_core_shared,
    lir_print_module,
    lir_builder,
    lir_builder_push,
    lir_builder_seal,
    lir_builder_finish,
]

fn fx_static_types() -> [MIRTypeDef] Never! {
    [MIRTypeDef]{
        fx_type_def("StaticRecord", MIRTypeDefKind.Struct{fields: [MIRField]{
            fx_field("StaticRecord", "label", fx_string()),
            fx_field("StaticRecord", "choice", fx_named("StaticChoice")),
        }, methods: [MIRFunctionID]{}}),
        fx_type_def("StaticChoice", MIRTypeDefKind.Enum{variants: [MIRVariant]{
            MIRVariant{name: "Empty", wire_name: "Empty", span: fx_span(), payload: MIRVariantPayload.Unit, discriminant: Val(99)},
            fx_variant("Text", MIRVariantPayload.Single{value: fx_string()}),
        }, methods: [MIRFunctionID]{}}),
    }
}

fn fx_static_definition(name: String, ty: MIRType, value: MIRConstant) -> MIRConstantDef Never! {
    MIRConstantDef{id: MIRConstantID{value: 0}, module_id: MIRModuleID{value: 0}, key: "fixture.{name}", name: name,
        span: fx_span(), visibility: MIRVisibility.Private, ty: ty, is_storage: false, value: value}
}

fn fx_static_record() -> MIRConstantDef Never! {
    fx_static_definition("saved", fx_named("StaticRecord"), MIRConstant.Struct{type_name: "StaticRecord", fields: [MIRConstField]{
        MIRConstField{name: "choice", value: MIRConstant.Enum{type_name: "StaticChoice", variant: "Text", args: [MIRConstEnumArg]{
            MIRConstEnumArg{name: None, value: MIRConstant.String{value: "nested"}},
        }}},
        MIRConstField{name: "label", value: MIRConstant.String{value: "frozen"}},
    }})
}

fn fx_static_print(b: &FxBuilder, record: MIRValueID) Never! {
    label :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: record, field: mir_field_id("StaticRecord.label")})
    choice :: fx_value(&b, fx_named("StaticChoice"), fx_borrow(), MIROperation.Field{base: record, field: mir_field_id("StaticRecord.choice")})
    text :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.EnumPayload{subject: choice, owner: mir_type_id("StaticChoice"), variant: "Text", index: 0})
    fx_print(&b, label)
    fx_print(&b, text)
}

// struct StaticRecord { label: String, choice: StaticChoice }
// enum StaticChoice { Empty = 99, Text(String) }
// const saved = StaticRecord{label: "frozen", choice: .Text("nested")}
// const greeting = "héllo"
// fn reader() { print(saved.label) }
// fn run() {
//   read a :: saved; read b :: saved; print(a.label); print(a.choice.Text);
//   print(b.label); print(b.choice.Text);
//   owned := saved; owned.label = "changed"; print(owned.label); print(owned.choice.Text); owned.drop();
//   print(saved.label); print(saved.choice.Text); reader();
//   print(greeting); print(greeting == "héllo");
//   owned_string :: greeting.copy(); owned_string.drop(); print(greeting);
// }
// expect-stdout statics: "frozen\nnested\nfrozen\nnested\nchanged\nnested\nfrozen\nnested\nfrozen\nhéllo\ntrue\nhéllo\n"
// expect-static-only statics
fn fx_statics() -> MIRProgram Never! {
    record :: fx_named("StaticRecord")
    r := fx_builder()
    a :: fx_value(&r, record, fx_borrow(), MIROperation.Global{name: "fixture.saved"})
    b :: fx_value(&r, record, fx_borrow(), MIROperation.Global{name: "saved"})
    fx_static_print(&r, a)
    fx_static_print(&r, b)
    local :: fx_local(&r, "owned", record, mir_owned_ownership())
    owned :: fx_owned(&r, record, MIROperation.Global{name: "fixture.saved"})
    fx_do(&r, MIROperation.WritePlace{place: local, value: owned})
    label_place :: fx_field_place(&r, local, "StaticRecord.label", fx_string())
    changed :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "changed"}})
    fx_do(&r, MIROperation.ReplacePlace{place: label_place, value: changed})
    fx_static_print(&r, owned)
    fx_do(&r, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    fx_static_print(&r, a)
    fx_do(&r, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("reader")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    greeting :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.Global{name: "fixture.greeting"})
    fx_print(&r, greeting)
    expected :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "héllo"}})
    equal :: fx_compare(&r, MIRBinaryOp.Eq, greeting, expected)
    fx_print(&r, equal)
    fx_do(&r, MIROperation.Drop{value: expected, kind: MIRDropKind.Value})
    string_owner :: fx_owned(&r, fx_string(), MIROperation.Global{name: "greeting"})
    fx_do(&r, MIROperation.Drop{value: string_owner, kind: MIRDropKind.Value})
    fx_print(&r, greeting)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    reader := fx_builder()
    saved :: fx_value(&reader, record, fx_borrow(), MIROperation.Global{name: "saved"})
    label :: fx_value(&reader, fx_string(), fx_borrow(), MIROperation.Field{base: saved, field: mir_field_id("StaticRecord.label")})
    fx_print(&reader, label)
    fx_block(&reader, 0, MIRTerminator.Return{value: None})
    p := fx_program([MIRFunction]{fx_function("run", r, fx_unit()), fx_function("reader", reader, fx_unit())}, fx_static_types())
    greeting_def := fx_static_definition("greeting", fx_string(), MIRConstant.String{value: "héllo"})
    greeting_def.id = MIRConstantID{value: 1}
    p.constants = [MIRConstantDef]{fx_static_record(), greeting_def}
    p
}

// #5041 P2 A3: a frozen Option box carries an immortal count word, so an
// owned read copies it (clone glue) and a write to that copy never reaches
// read-only data; a borrowed read sees the frozen payload.
// const maybe: String? = present("frozen")
// fn run() { m := maybe; m.value = "mine"; print(m.value); print(maybe.value) }
// expect-stdout statics-box: "mine\nfrozen\n"
fn fx_statics_box() -> MIRProgram Never! {
    text_maybe :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_string()})
    r := fx_builder()
    local :: fx_local(&r, "m", text_maybe, mir_owned_ownership())
    owned :: fx_owned(&r, text_maybe, MIROperation.Global{name: "fixture.maybe"})
    fx_do(&r, MIROperation.WritePlace{place: local, value: owned})
    window :: fx_payload_place(&r, local, MIRPayloadKind.Option, fx_string(), MIRAccess.Write)
    mine :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "mine"}})
    fx_do(&r, MIROperation.ReplacePlace{place: window, value: mine})
    payload :: fx_payload_place(&r, local, MIRPayloadKind.Option, fx_string(), MIRAccess.Read)
    now :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.ReadPlace{place: payload})
    fx_print(&r, now)
    frozen :: fx_value(&r, text_maybe, fx_borrow(), MIROperation.Global{name: "fixture.maybe"})
    inside :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.OptionValue{subject: frozen})
    fx_print(&r, inside)
    gone :: fx_owned(&r, text_maybe, MIROperation.MovePlace{place: local})
    fx_do(&r, MIROperation.Drop{value: gone, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    p := fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
    p.constants = [MIRConstantDef]{fx_static_definition("maybe", text_maybe, MIRConstant.Present{value: MIRConstant.String{value: "frozen"}})}
    p
}

fn fx_static_lir_value(f: &LIRFunction, layout: LIRLayout, drop: LIRDrop) -> LIRValueID Never! {
    id :: LIRValueID{value: f.values.len()}
    &f.values.push(LIRValue{id: id, layout: layout, drop: drop, jet_type: None})
    id
}

// A boundary LIR probe compares the actual outputs of two borrowed Globals and
// one owned Global, rather than imposing pointer equality semantics on structs.
// Jet-source model: read a :: saved; read b :: saved; owned :: saved;
// print(address(a) == address(b)); print(address(a) == address(owned)); owned.drop();
// expect-stdout statics-addresses: "true\nfalse\n"
// expect-static-only statics-addresses
fn fx_statics_addresses_module() -> LIRModule Never! {
    r := fx_builder()
    record :: fx_named("StaticRecord")
    _ := fx_value(&r, record, fx_borrow(), MIROperation.Global{name: "fixture.saved"})
    _ := fx_value(&r, record, fx_borrow(), MIROperation.Global{name: "saved"})
    owned_global :: fx_owned(&r, record, MIROperation.Global{name: "fixture.saved"})
    // The owned record is inline: frame storage filled by clone glue, and its
    // drop runs drop glue on that storage (Lower/Values.jet).
    fx_do(&r, MIROperation.Drop{value: owned_global, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    p := fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, fx_static_types())
    p.constants = [MIRConstantDef]{fx_static_record()}
    lowered :: lir_lower_entry(p, mir_function_id("run"))
    if lowered.issues.len() != 0 -> panic("statics-addresses lowering: {lowered.issues[0].message}")
    lir := lowered.lir.copy()
    entry := lir.functions[0].copy()
    pointers := [LIRValueID]{}
    roots := [Int]{}
    owners := [LIRValueID]{}
    clones := 0
    loop inst in entry.blocks[0].insts {
        if inst == {
            .DataAddress(dst, data) -> {
                &pointers.push(dst)
                &roots.push(data.value)
            }
            .StackSlot(dst, _, _) -> &owners.push(dst)
            .Call(dst, _, callee, args) -> {
                if callee == .Function(_) && dst == None && args.len() == 2 {
                    if owners.len() == 1 && args[1] == owners[0] -> clones += 1
                }
            }
            else -> {}
        }
    }
    if pointers.len() != 3 || roots[0] != roots[1] || roots[0] != roots[2] -> panic("Globals did not share one frozen root")
    if entry.values[pointers[0].value].drop != .Trivial || entry.values[pointers[1].value].drop != .Trivial -> panic("a borrowed Global owns its static box")
    if owners.len() != 1 || clones != 1 -> panic("owned Global did not clone")
    owned :: owners[0]
    bool_signature :: LIRSignatureID{value: lir.signatures.len()}
    &lir.signatures.push(LIRSignature{id: bool_signature, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_bool()}, result: Val(lir_layout_pointer())})
    print_signature :: LIRSignatureID{value: lir.signatures.len()}
    &lir.signatures.push(LIRSignature{id: print_signature, convention: LIRCallConv.SystemV, params: [LIRLayout]{lir_layout_pointer(), lir_layout_bool()}, result: None})
    flush :: fx_static_lir_value(&entry, lir_layout_bool(), LIRDrop.Trivial)
    &entry.blocks[0].insts.push(LIRInst.Const{dst: flush, value: 1})
    peers :: [LIRValueID]{pointers[1], owned}
    loop peer in peers {
        equal :: fx_static_lir_value(&entry, lir_layout_bool(), LIRDrop.Trivial)
        text :: fx_static_lir_value(&entry, lir_layout_pointer(), LIRDrop.Runtime{symbol: "jet_rt_string_drop"})
        &entry.blocks[0].insts.push(LIRInst.Compare{dst: equal, condition: LIRCondition.Eq, left: pointers[0], right: peer})
        &entry.blocks[0].insts.push(LIRInst.Call{dst: Val(text), signature: bool_signature, callee: LIRCallee.Runtime{symbol: "jet_rt_bool_to_string"}, args: [LIRValueID]{equal}})
        &entry.blocks[0].insts.push(LIRInst.Call{dst: None, signature: print_signature, callee: LIRCallee.Runtime{symbol: "jet_term_write_stdout_line"}, args: [LIRValueID]{text, flush}})
        &entry.blocks[0].insts.push(LIRInst.Drop{value: text})
    }
    // The owned copy was dropped by its MIR Drop above; its storage address
    // stays comparable. The appended checks have no source lines.
    loop _ in entry.blocks[0].lines.len()..<(entry.blocks[0].insts.len() + 1) -> &entry.blocks[0].lines.push(0)
    lir.functions[0] = entry
    lir
}

// const labels = ["red", "blue"]
// fn run() { read a :: labels; print(a[0]); owned :: labels; owned.drop(); print(a[1]); }
// expect-stdout statics-list: "red\nblue\n"
// expect-static-only statics-list
fn fx_statics_list() -> MIRProgram Never! {
    r := fx_builder()
    list :: fx_list_type(fx_string())
    a :: fx_value(&r, list, fx_borrow(), MIROperation.Global{name: "fixture.labels"})
    zero :: fx_int_const(&r, 0)
    first :: fx_list_index(&r, a, zero, fx_string(), false)
    fx_print(&r, first)
    owned :: fx_owned(&r, list, MIROperation.Global{name: "labels"})
    fx_do(&r, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    one :: fx_int_const(&r, 1)
    second :: fx_list_index(&r, a, one, fx_string(), false)
    fx_print(&r, second)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(r)
    p.constants = [MIRConstantDef]{fx_static_definition("labels", list, MIRConstant.List{values: [MIRConstant]{
        MIRConstant.String{value: "red"}, MIRConstant.String{value: "blue"},
    }})}
    p
}

// Owned Global reads detach from packed frozen bytes, including nested Lists.
// expect-stdout statics-bytes: "255\n7\n255\ntrue\n128\n"
// expect-static-only statics-bytes
fn fx_statics_bytes() -> MIRProgram Never! {
    b := fx_builder()
    byte :: fx_narrow(false, 8)
    bytes :: fx_list_type(byte)
    zero :: fx_int_const(&b, 0)
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    borrowed :: fx_value(&b, bytes, fx_borrow(), MIROperation.Global{name: "fixture.bytes"})
    borrowed_last :: fx_list_index(&b, borrowed, two, byte, false)
    fx_print(&b, borrowed_last)
    root :: fx_local(&b, "owned", bytes, mir_owned_ownership())
    owned :: fx_owned(&b, bytes, MIROperation.Global{name: "bytes"})
    fx_do(&b, MIROperation.WritePlace{place: root, value: owned})
    slot :: fx_list_index_place(&b, root, two, byte)
    seven :: fx_narrow_const(&b, false, 8, 7)
    fx_do(&b, MIROperation.ReplacePlace{place: slot, value: seven})
    owned_last :: fx_list_index(&b, owned, two, byte, false)
    fx_print(&b, owned_last)
    fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    unchanged_last :: fx_list_index(&b, borrowed, two, byte, false)
    fx_print(&b, unchanged_last)
    outer :: fx_list_type(bytes)
    nested :: fx_owned(&b, outer, MIROperation.Global{name: "fixture.nested_bytes"})
    empty :: fx_list_index(&b, nested, zero, bytes, false)
    is_empty :: fx_list_method(&b, "is_empty", empty, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, is_empty)
    nonempty :: fx_list_index(&b, nested, one, bytes, false)
    nested_byte :: fx_list_index(&b, nonempty, one, byte, false)
    fx_print(&b, nested_byte)
    fx_do(&b, MIROperation.Drop{value: nested, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_list_program(b)
    p.constants = [MIRConstantDef]{
        fx_static_definition("bytes", bytes, MIRConstant.Bytes{value: [U8]{U8{0}, U8{128}, U8{255}}}),
        fx_static_definition("nested_bytes", outer, MIRConstant.List{values: [MIRConstant]{
            MIRConstant.Bytes{value: [U8]{}}, MIRConstant.Bytes{value: [U8]{U8{0}, U8{128}, U8{255}}},
        }}),
    }
    p
}

// const text = "héllo"; const empty = ""; const pattern = "hé"
// fn run() { print(text.len()); print(empty.is_empty()); print(text.contains(pattern));
//   print(text.starts_with(pattern)); print(text.ends_with("lo")); print(pattern < text);
//   print("[" + text + "]"); }
// expect-stdout statics-strings: "5\ntrue\ntrue\ntrue\ntrue\ntrue\n[héllo]\n"
// expect-static-only statics-strings
fn fx_statics_strings() -> MIRProgram Never! {
    b := fx_builder()
    text :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Global{name: "fixture.text"})
    empty :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Global{name: "fixture.empty"})
    pattern :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Global{name: "fixture.pattern"})
    fx_strings_print_method(&b, "len", text, [MIRValueID]{}, fx_int())
    fx_strings_print_method(&b, "is_empty", empty, [MIRValueID]{}, fx_bool())
    fx_strings_print_method(&b, "contains", text, [MIRValueID]{pattern}, fx_bool())
    fx_strings_print_method(&b, "string_starts_with", text, [MIRValueID]{pattern}, fx_bool())
    tail :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "lo"}})
    fx_strings_print_method(&b, "string_ends_with", text, [MIRValueID]{tail}, fx_bool())
    fx_strings_print_compare(&b, MIRBinaryOp.Lt, pattern, text)
    built :: fx_owned(&b, fx_string(), MIROperation.BuildString{parts: [MIRStringPart]{
        {kind: MIRStringPartKind.Literal{text: "["}},
        {kind: MIRStringPartKind.Interpolation{value: text, format: MIRStringFormat.Display}},
        {kind: MIRStringPartKind.Literal{text: "]"}},
    }})
    fx_print(&b, built)
    fx_do(&b, MIROperation.Drop{value: built, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: tail, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_strings_program(b)
    rows := [MIRConstantDef]{}
    names :: [String]{"text", "empty", "pattern"}
    texts :: [String]{"héllo", "", "hé"}
    loop (index, name) in names {
        row := fx_static_definition(name, fx_string(), MIRConstant.String{value: texts[index]})
        row.id = MIRConstantID{value: fx_word(U64{0}, index)}
        &rows.push(row)
    }
    p.constants = rows
    p
}

// Both images see the same Global row. Only pinned Core owns its cell and init.
fn fx_shared_site_program(lifetime: MIRSharedLifetime) -> MIRProgram Never! {
    ty :: mir_type_from_kind(MIRTypeKind.Shared{inner: fx_string()})
    init := fx_builder()
    frozen :: fx_owned(&init, fx_string(), MIROperation.Global{name: "fixture.shared_text"})
    owner :: fx_owned(&init, ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{
        call: fx_prelude_id("core.mem", "shared_new"), args: [MIRCallArg]{fx_arg(frozen, MIRAccess.Move)},
        owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{},
    }})
    fx_block(&init, 0, MIRTerminator.Return{value: Val(owner)})
    initializer :: fx_function("init_shared_text", init, ty)
    key :: "shared-site:{initializer.id.value}"
    reader := fx_builder()
    alias :: fx_owned(&reader, ty, MIROperation.Global{name: key})
    fx_do(&reader, MIROperation.Drop{value: alias, kind: MIRDropKind.Shared})
    fx_block(&reader, 0, MIRTerminator.Return{value: None})
    program := fx_program([MIRFunction]{fx_function("run", reader, fx_unit()), initializer}, [])
    site := fx_static_definition("shared_text_site", ty, MIRConstant.SharedSite{site: MIRSharedSite{initializer: initializer.id, lifetime: lifetime}})
    site.key = key
    program.constants = [MIRConstantDef]{site, fx_static_definition("shared_text", fx_string(), MIRConstant.String{value: "pinned"})}
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.mem", "shared_new", "jet_std::JetShared::new", 1, MIRPreludeABI.Value))
    program
}

fn fx_shared_site_checks() -> Bool Never! {
    loop lifetime in ([MIRSharedLifetime]{MIRSharedLifetime.Process, MIRSharedLifetime.World, MIRSharedLifetime.Thread, MIRSharedLifetime.Attempt}) {
        program :: fx_shared_site_program(lifetime)
        initializer :: program.functions[1].id
        getter :: mir_shared_site_getter_symbol(initializer)
        dynamic :: lir_lower_entry(program, mir_function_id("run"))
        if dynamic.issues.len() != 0 || dynamic.shared_sites.len() != 0 -> return false
        imported :: lir_print_module(dynamic.lir)
        if !imported.contains(getter) || imported.contains("jet_rt_native_shared_new") -> return false
        pinned :: lir_lower_core_shared(program, [MIRFunctionID]{initializer})
        if pinned.issues.len() != 0 || pinned.shared_sites.len() != 1 -> return false
        if pinned.shared_sites[0].symbol != getter || pinned.shared_sites[0].initializer != initializer -> return false
        if pinned.shared_sites[0].lifetime != lifetime -> return false
        if mir_type_canonical_key(pinned.shared_sites[0].ty) != mir_type_canonical_key(program.constants[0].ty) -> return false
        entry :: pinned.entry ?? return false
        startup :: pinned.lir.functions[entry.value]
        if !startup.name.contains("core.shared.init") -> return false
        startup_text :: lir_print_module(LIRModule{signatures: pinned.lir.signatures, functions: [LIRFunction]{startup}, data: pinned.lir.data, debug: pinned.lir.debug})
        // A frozen String is a relocation to its immortal header: the entry
        // constructs nothing for it, and pinned Core has no finalizer (program
        // owners live until process exit; only a dynamic compiler callable
        // with runtime-filled statics gets one, Lower.jet lower_selected_in_place).
        if startup_text.contains("jet_rt_string_from_static") || startup_text.contains("jet_rt_native_shared_new") -> return false
        if !fx_statics_has_text_header(pinned.lir, "pinned") -> return false
        if pinned.finalizer != None -> return false
        getter_text :: lir_print_module(pinned.lir)
        if !getter_text.contains("jet_rt_native_shared_clone") -> return false
        if lifetime == MIRSharedLifetime.Process || lifetime == MIRSharedLifetime.World {
            if !getter_text.contains("jet_rt_shared_site_publish") -> return false
        } else {
            if !getter_text.contains("jet_rt_tls_shared_key") || !getter_text.contains("jet_rt_tls_set") -> return false
        }
    }
    digits := fx_builder()
    integer :: fx_value(&digits, fx_int(), fx_borrow(), MIROperation.Global{name: "fixture.shared_digits"})
    fx_block(&digits, 0, MIRTerminator.Return{value: Val(integer)})
    root :: fx_function("read_shared_digits", digits, fx_int())
    exact := fx_program([MIRFunction]{root}, [])
    exact.constants = [MIRConstantDef]{fx_static_definition("shared_digits", fx_int(), MIRConstant.BigInt{decimal: "18446744073709551616"})}
    pinned :: lir_lower_core_shared(exact, [MIRFunctionID]{root.id})
    if pinned.issues.len() != 0 || pinned.finalizer != None -> return false
    entry :: pinned.entry ?? return false
    startup :: lir_print_module(LIRModule{signatures: pinned.lir.signatures, functions: [LIRFunction]{pinned.lir.functions[entry.value]}, data: pinned.lir.data, debug: pinned.lir.debug})
    // A spilled exact Int is still a runtime-owned word the entry constructs.
    if !startup.contains("jet_rt_int_from_static") || startup.contains("jet_rt_string_from_static") -> return false
    true
}

// Whether `lir` holds the immortal header of `text` (StaticText.jet
// lower_immortal_text): 24 bytes, one relocation at offset 0 to the literal
// bytes, the byte length at 8 and a zero capacity.
fn fx_statics_has_text_header(lir: LIRModule, text: String) -> Bool Never! {
    loop data in lir.data {
        if fx_statics_text_header_matches(lir, data, text.bytes().len()) -> return true
    }
    false
}

fn fx_statics_text_header_matches(lir: LIRModule, data: LIRData, length: Int) -> Bool Never! {
    if data.bytes.len() != 24 || data.align != 8 || data.relocs.len() != 1 -> return false
    if data.relocs[0].offset != 0 || data.relocs[0].addend != 0 -> return false
    Int.from_u8(data.bytes[8]) == length && lir.data[data.relocs[0].target.value].bytes.len() == length
}

// expect-stdout statics-map: "3\nPASS\nEDIT\nFAIL\n0\nFAIL\n"
// expect-static-only statics-map
fn fx_statics_map() -> MIRProgram Never! {
    b := fx_builder()
    map_ty :: fx_constant_marker_type()
    borrowed :: fx_value(&b, map_ty, fx_borrow(), MIROperation.Global{name: "fixture.status"})
    length :: fx_list_method(&b, "len", borrowed, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, length)
    fx_constant_map_read(&b, borrowed, "a.jet")
    root :: fx_local(&b, "owned_status", map_ty, mir_owned_ownership())
    owned :: fx_owned(&b, map_ty, MIROperation.Global{name: "status"})
    fx_do(&b, MIROperation.WritePlace{place: root, value: owned})
    key :: fx_strings_literal(&b, "z.jet")
    base := b.places[0].base
    loop row in b.places {
        if row.id == root -> base = row.base
    }
    slot :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{id: slot, span: fx_span(), ty: fx_string(), base: base,
        projections: [MIRProjection]{MIRProjection.Index{kind: MIRIndexKind.Map, index: key,
            call: fx_prelude_id("core.list", "get"), write_call: None,
            location: MIRPanicLoc{file: fx_source_file(), line: 1, column: 0}, context: None, span: fx_span()}},
        access: MIRAccess.Write, persist_key: None})
    replacement :: fx_strings_literal(&b, "EDIT")
    fx_do(&b, MIROperation.ReplacePlace{place: slot, value: replacement})
    fx_do(&b, MIROperation.Drop{value: key, kind: MIRDropKind.Value})
    fx_constant_map_read(&b, owned, "z.jet")
    fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    fx_constant_map_read(&b, borrowed, "z.jet")
    empty :: fx_owned(&b, map_ty, MIROperation.Global{name: "fixture.empty_status"})
    empty_length :: fx_list_method(&b, "len", empty, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, empty_length)
    fx_do(&b, MIROperation.Drop{value: empty, kind: MIRDropKind.Value})
    nested_ty :: fx_list_type(map_ty)
    nested :: fx_owned(&b, nested_ty, MIROperation.Global{name: "fixture.nested_status"})
    zero :: fx_int_const(&b, 0)
    inner :: fx_list_index(&b, nested, zero, map_ty, false)
    fx_constant_map_read(&b, inner, "z.jet")
    fx_do(&b, MIROperation.Drop{value: nested, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_constant_map_program(b)
    p.constants = [MIRConstantDef]{
        fx_static_definition("status", map_ty, fx_constant_marker_status()),
        fx_static_definition("empty_status", map_ty, MIRConstant.Map{entries: [MIRConstMapEntry]{}}),
        fx_static_definition("nested_status", nested_ty, MIRConstant.List{values: [MIRConstant]{fx_constant_marker_status()}}),
    }
    p
}

// Repeated callable initialization/finalization builds fresh frozen owners,
// retires them exactly once and permits a new invocation in the same image.
// expect-stdout statics-map-lifetime: "FAIL\nFAIL\n"
// expect-static-only statics-map-lifetime
fn fx_statics_map_lifetime() -> LIRModule Never! {
    b := fx_builder()
    map :: fx_value(&b, fx_constant_marker_type(), fx_borrow(), MIROperation.Global{name: "fixture.status"})
    fx_constant_map_read(&b, map, "z.jet")
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_constant_map_program(b)
    p.constants = [MIRConstantDef]{fx_static_definition("status", fx_constant_marker_type(), fx_constant_marker_status())}
    lowered :: lir_lower_callables(p, [MIRFunctionID]{mir_function_id("run")})
    if lowered.issues.len() > 0 -> panic("Map lifetime fixture lowering failed")
    entry :: lowered.entry ?? panic("Map lifetime fixture has no callable")
    finalizer :: lowered.finalizer ?? panic("Map lifetime fixture has no finalizer")
    module_value := lowered.lir
    loop (index, function) in module_value.functions {
        if function.name == "run" -> module_value.functions[index].name = "read_status"
    }
    signature :: LIRSignatureID{value: module_value.signatures.len()}
    &module_value.signatures.push(LIRSignature{id: signature, convention: LIRCallConv.SystemV, params: [LIRLayout]{}, result: None})
    builder := lir_builder(LIRFunctionID{value: module_value.functions.len()}, "run", signature)
    loop _ in 0..<2 {
        lir_builder_push(&builder, LIRInst.Call{dst: None, signature: module_value.functions[entry.value].signature, callee: LIRCallee.Function{id: entry}, args: [LIRValueID]{}})
        loop _ in 0..<2 -> lir_builder_push(&builder, LIRInst.Call{dst: None, signature: module_value.functions[finalizer.value].signature, callee: LIRCallee.Function{id: finalizer}, args: [LIRValueID]{}})
    }
    lir_builder_seal(&builder, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})
    &module_value.functions.push(lir_builder_finish(builder))
    module_value
}
