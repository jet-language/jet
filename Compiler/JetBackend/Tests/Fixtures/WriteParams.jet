// Write parameters (Core-Host-Native fix spec 2): the callee's writes land
// in the caller's place, for a root local, an owned String replaced in the
// callee, a struct field, and a Write parameter passed on to another call.
use jet_foundation.[
    MIRAccess,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryOverflow,
    MIRCallArg,
    MIRCallee,
    MIRConstant,
    MIRDropKind,
    MIRField,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIROperation,
    MIRParam,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRProgram,
    MIRProjection,
    MIRTerminator,
    MIRType,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRValueID,
    mir_copy_ownership,
    mir_field_id,
    mir_function_id,
    mir_ownership_from_access,
    mir_type_id,
]

// A Write parameter and the root place standing for it.
fn fx_write_param(b: &FxBuilder, name: String, ty: MIRType) -> MIRPlaceID Never! {
    index :: b.params.len()
    ownership :: mir_ownership_from_access(MIRAccess.Write)
    &b.params.push(MIRParam{index: index, name: name, span: fx_span(), ty: ty, access: MIRAccess.Write, ownership: ownership, public_label: name, variadic: false, default_present: false})
    value :: fx_value(&b, ty, ownership, MIROperation.Parameter{index: index, name: name})
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{id: place, span: fx_span(), ty: ty, base: MIRPlaceBase.Parameter{value: value}, projections: [MIRProjection]{}, access: MIRAccess.Write, persist_key: None})
    place
}

// `callee(&place)`: a Write argument lending `place`.
fn fx_call_write(b: &FxBuilder, callee: String, place: MIRPlaceID, ty: MIRType) Never! {
    lent :: fx_value(&b, ty, mir_ownership_from_access(MIRAccess.Write), MIROperation.ReadPlace{place: place})
    arg := fx_arg(lent, MIRAccess.Write)
    arg.place = Val(place)
    _ := fx_copy(&b, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id(callee)}, args: [MIRCallArg]{arg}, type_args: [MIRType]{}})
}

// struct Point { x: I64, y: I64 }
// fn edit(&x: I64) { x = I64{9} }
// fn rename(&s: String) { s = "new" }
// fn add_one(&x: I64) { x = x + I64{1} }
// fn twice(&x: I64) { add_one(&x); add_one(&x) }
// fn run() {
//     n := I64{1}
//     edit(&n)
//     print(n)
//     t := "old"
//     rename(&t)
//     print(t)
//     p := Point{x: I64{1}, y: I64{2}}
//     edit(&p.x)
//     print(p.x)
//     k := I64{5}
//     twice(&k)
//     print(k)
// }
// expect-stdout write-params: "9\nnew\n9\n7\n"
fn fx_write_params() -> MIRProgram Never! {
    point :: fx_named("Point")
    types :: [MIRTypeDef]{
        fx_type_def("Point", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Point", "x", fx_i64()), fx_field("Point", "y", fx_i64())}, methods: [MIRFunctionID]{}}),
    }

    e := fx_builder()
    edited :: fx_write_param(&e, "x", fx_i64())
    nine :: fx_i64_const(&e, 9)
    fx_do(&e, MIROperation.WritePlace{place: edited, value: nine})
    fx_block(&e, 0, MIRTerminator.Return{value: None})

    n := fx_builder()
    named :: fx_write_param(&n, "s", fx_string())
    fresh :: fx_owned(&n, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "new"}})
    fx_do(&n, MIROperation.ReplacePlace{place: named, value: fresh})
    fx_block(&n, 0, MIRTerminator.Return{value: None})

    a := fx_builder()
    counter :: fx_write_param(&a, "x", fx_i64())
    old :: fx_copy(&a, fx_i64(), MIROperation.ReadPlace{place: counter})
    one :: fx_i64_const(&a, 1)
    bumped :: fx_copy(&a, fx_i64(), MIROperation.Binary{op: MIRBinaryOp.Add, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Trap, left: old, right: one})
    fx_do(&a, MIROperation.WritePlace{place: counter, value: bumped})
    fx_block(&a, 0, MIRTerminator.Return{value: None})

    t := fx_builder()
    passed :: fx_write_param(&t, "x", fx_i64())
    fx_call_write(&t, "add_one", passed, fx_i64())
    fx_call_write(&t, "add_one", passed, fx_i64())
    fx_block(&t, 0, MIRTerminator.Return{value: None})

    r := fx_builder()
    local_n :: fx_local(&r, "n", fx_i64(), mir_copy_ownership())
    first :: fx_i64_const(&r, 1)
    fx_do(&r, MIROperation.WritePlace{place: local_n, value: first})
    fx_call_write(&r, "edit", local_n, fx_i64())
    n_now :: fx_copy(&r, fx_i64(), MIROperation.ReadPlace{place: local_n})
    fx_print(&r, n_now)

    local_t :: fx_local(&r, "t", fx_string(), mir_owned_ownership())
    old_text :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "old"}})
    fx_do(&r, MIROperation.WritePlace{place: local_t, value: old_text})
    fx_call_write(&r, "rename", local_t, fx_string())
    t_now :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.ReadPlace{place: local_t})
    fx_print(&r, t_now)
    t_gone :: fx_owned(&r, fx_string(), MIROperation.MovePlace{place: local_t})
    fx_do(&r, MIROperation.Drop{value: t_gone, kind: MIRDropKind.Value})

    local_p :: fx_local(&r, "p", point, mir_owned_ownership())
    p_x :: fx_field_place(&r, local_p, "Point.x", fx_i64())
    x_init :: fx_i64_const(&r, 1)
    y_init :: fx_i64_const(&r, 2)
    built :: fx_owned(&r, point, MIROperation.Struct{type_id: mir_type_id("Point"), fields: [MIRFieldValue]{MIRFieldValue{field: mir_field_id("Point.x"), value: x_init}, MIRFieldValue{field: mir_field_id("Point.y"), value: y_init}}})
    fx_do(&r, MIROperation.WritePlace{place: local_p, value: built})
    fx_call_write(&r, "edit", p_x, fx_i64())
    x_now :: fx_copy(&r, fx_i64(), MIROperation.ReadPlace{place: p_x})
    fx_print(&r, x_now)
    p_gone :: fx_owned(&r, point, MIROperation.MovePlace{place: local_p})
    fx_do(&r, MIROperation.Drop{value: p_gone, kind: MIRDropKind.Value})

    local_k :: fx_local(&r, "k", fx_i64(), mir_copy_ownership())
    five :: fx_i64_const(&r, 5)
    fx_do(&r, MIROperation.WritePlace{place: local_k, value: five})
    fx_call_write(&r, "twice", local_k, fx_i64())
    k_now :: fx_copy(&r, fx_i64(), MIROperation.ReadPlace{place: local_k})
    fx_print(&r, k_now)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("edit", e, fx_unit()), fx_function("rename", n, fx_unit()), fx_function("add_one", a, fx_unit()), fx_function("twice", t, fx_unit()), fx_function("run", r, fx_unit())}, ^types)
}
