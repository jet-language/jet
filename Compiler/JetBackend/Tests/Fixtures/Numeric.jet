// Modeled Jet programs exercise Float predicates, exact Int Euclidean methods,
// and all 64-bit numeric policies, including unsigned high-bit words. Float NaN
// and infinities come from arithmetic, not math.to_bits (Tower #4340).
use jet_foundation.[
    MIRBinaryDispatch, MIRBinaryOp, MIRBinaryOverflow, MIRCallFallibility, MIRConstant, MIRConversion, MIRDropKind,
    MIRCallArg, MIREnumArg, MIRFunction, MIRFunctionID, MIROperation, MIRPanicLoc, MIRPreludeABI, MIRPreludeFamily, MIRPreludeTypeArg,
    MIRProgram, MIRSemanticOp, MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind,
    MIRUnaryOp, MIRValueID, MIRVariant, MIRVariantPayload, mir_function_id, mir_integer_constant, mir_type_from_kind, mir_type_id,
]

fn fx_numeric_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    predicates :: [String]{"is_nan", "is_infinite", "is_finite"}
    loop method in predicates {
        &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.math", method, "jet_std_math_{method}", 1, MIRPreludeABI.Value))
    }
    euclidean :: [String]{"div_euclid", "rem_euclid"}
    loop method in euclidean {
        &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Overflow, "core.numeric", method, "jet_std::jet_int_{method}", 2, MIRPreludeABI.Value))
    }
    widths :: [String]{"i64", "u64"}
    modes :: [String]{"checked", "checked_policy", "wrapping", "saturating"}
    operations :: [String]{"add", "sub", "mul", "div", "rem", "pow"}
    rotations :: [String]{"rotate_left", "rotate_right"}
    loop width in widths {
        loop mode in modes {
            loop op in operations {
                if op == "rem" && (mode == "wrapping" || mode == "saturating") -> next
                arity :: if mode == "checked" || ((mode == "wrapping" || mode == "saturating") && (op == "add" || op == "sub" || op == "mul")) -> 2 else -> 4
                runtime_mode :: if mode == "checked_policy" -> "trap" else -> mode
                &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Overflow, "core.numeric", "{width}.{mode}.{op}", "jet_{width}_{runtime_mode}_{op}", arity, MIRPreludeABI.Value))
            }
        }
        loop mode in rotations {
            &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Overflow, "core.numeric", "{width}.{mode}.rotate", "jet_{width}_{mode}", 4, MIRPreludeABI.Value))
        }
    }
    p
}

fn fx_numeric_label(b: &FxBuilder, text: String) Never! {
    value :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: text}})
    fx_print(&b, value)
    fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
}

fn fx_numeric_float(b: &FxBuilder, value: Float) -> MIRValueID Never! {
    fx_copy(&b, mir_type_from_kind(MIRTypeKind.Float), MIROperation.Constant{value: MIRConstant.Float{value: value, f32: false, spelling: None}})
}

fn fx_numeric_float_binary(b: &FxBuilder, op: MIRBinaryOp, left: MIRValueID, right: MIRValueID) -> MIRValueID Never! {
    fx_copy(&b, mir_type_from_kind(MIRTypeKind.Float), MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: left, right: right})
}

fn fx_numeric_euclid(b: &FxBuilder, op: String, left: Int, right: Int) -> MIRValueID Never! {
    a :: fx_int_const(&b, left)
    c :: fx_int_const(&b, right)
    fx_owned(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.NumericBinaryMethod{call: fx_prelude_id("core.numeric", op), receiver: a, argument: c}})
}

fn fx_numeric_fixed(b: &FxBuilder, unsigned: Bool, mode: String, op: String, left: Int, right: Int) -> MIRValueID Never! {
    ty :: if unsigned -> fx_u64() else -> fx_i64()
    a :: if unsigned -> fx_u64_const(&b, left) else -> fx_i64_const(&b, left)
    c :: if unsigned -> fx_u64_const(&b, right) else -> fx_i64_const(&b, right)
    width :: if unsigned -> "u64" else -> "i64"
    arity :: if mode == "checked" || ((mode == "wrapping" || mode == "saturating") && (op == "add" || op == "sub" || op == "mul")) -> 2 else -> 4
    loc :: if arity == 4 -> Val(MIRPanicLoc{file: fx_source_file(), line: 3, column: 0}) else -> None
    operation :: MIROperation.Semantic{operation: MIRSemanticOp.OverflowOption{call: fx_prelude_id("core.numeric", "{width}.{mode}.{op}"), left: a, right: c, location: loc}}
    if mode == "checked" -> fx_owned(&b, mir_type_from_kind(MIRTypeKind.Option{inner: ty}), operation)
    else -> fx_copy(&b, ty, operation)
}

fn fx_numeric_checked(b: &FxBuilder, unsigned: Bool, op: String, left: Int, right: Int, present: Bool) Never! {
    value :: fx_numeric_fixed(&b, unsigned, "checked", op, left, right)
    some :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: value})
    fx_print(&b, some)
    if present {
        inner :: fx_copy(&b, if unsigned -> fx_u64() else -> fx_i64(), MIROperation.OptionValue{subject: value})
        fx_print(&b, inner)
    }
    fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
}

fn fx_numeric_print_fixed(b: &FxBuilder, unsigned: Bool, mode: String, op: String, left: Int, right: Int) Never! {
    value :: fx_numeric_fixed(&b, unsigned, mode, op, left, right)
    fx_print(&b, value)
}

// The compiler's fixed infix division uses Binary(Prelude), not OverflowOption.
fn fx_numeric_u64_binary(b: &FxBuilder, op: MIRBinaryOp, member: String, left: Int, right: Int) -> MIRValueID Never! {
    a :: fx_u64_const(&b, left)
    divisor :: fx_u64_const(&b, right)
    location :: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0}
    fx_copy(&b, fx_u64(), MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Prelude{call: fx_prelude_id("core.numeric", "u64.trap.{member}"), location: Val(location)}, overflow: MIRBinaryOverflow.Unchecked, left: a, right: divisor})
}

fn fx_numeric_u64_binary_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    loop member in ([String]{"div", "floor_div", "rem"}) {
        &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Overflow, "core.numeric", "u64.trap.{member}", "jet_u64_trap_{member}", 4, MIRPreludeABI.Value))
    }
    p
}

// expect-stdout numeric-u64-binary-division: "2\n2\n1\n9223372036854775807\n9223372036854775807\n1\n"
fn fx_numeric_u64_binary_division() -> MIRProgram Never! {
    b := fx_builder()
    // -1 carries U64.MAX's high-bit word, as in Unsigned.jet's fixtures.
    loop pair in ([(left: Int, right: Int)]{(left: 7, right: 3), (left: -1, right: 2)}) {
        quotient :: fx_numeric_u64_binary(&b, .Div, "div", pair.left, pair.right)
        fx_print(&b, quotient)
        floor_quotient :: fx_numeric_u64_binary(&b, .FloorDiv, "floor_div", pair.left, pair.right)
        fx_print(&b, floor_quotient)
        remainder :: fx_numeric_u64_binary(&b, .Rem, "rem", pair.left, pair.right)
        fx_print(&b, remainder)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_numeric_u64_binary_program(b)
}

fn fx_numeric_u64_binary_zero(op: MIRBinaryOp, member: String) -> MIRProgram Never! {
    b := fx_builder()
    _ := fx_numeric_u64_binary(&b, op, member, 7, 0)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_numeric_u64_binary_program(b)
}

// expect-stdout numeric-u64-binary-div-zero: ""
// expect-exit numeric-u64-binary-div-zero: 70
// expect-stderr numeric-u64-binary-div-zero: "Stop [E3010]: `divided by zero`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_numeric_u64_binary_div_zero() -> MIRProgram Never! { fx_numeric_u64_binary_zero(.Div, "div") }

// expect-stdout numeric-u64-binary-floor-zero: ""
// expect-exit numeric-u64-binary-floor-zero: 70
// expect-stderr numeric-u64-binary-floor-zero: "Stop [E3010]: `divided by zero`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_numeric_u64_binary_floor_zero() -> MIRProgram Never! { fx_numeric_u64_binary_zero(.FloorDiv, "floor_div") }

// expect-stdout numeric-u64-binary-rem-zero: ""
// expect-exit numeric-u64-binary-rem-zero: 70
// expect-stderr numeric-u64-binary-rem-zero: "Stop [E3010]: `divided by zero`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_numeric_u64_binary_rem_zero() -> MIRProgram Never! { fx_numeric_u64_binary_zero(.Rem, "rem") }

// Sized integer literals (`I64{5}`, `U64{18446744073709551615}`): an exact
// Int constant through the infallible int_checked_fixed route is the fixed
// word itself (Rust `5i64`), for every width and both signed bounds.
fn fx_sized_literal(b: &FxBuilder, signed: Bool, bits: Int, constant: MIRConstant) -> MIRValueID Never! {
    number :: fx_copy(&b, fx_int(), MIROperation.Constant{value: constant})
    kind :: fx_int_const(&b, 0)
    target :: fx_narrow(signed, bits)
    fx_copy(&b, target, MIROperation.Convert{value: number, parameters: [MIRValueID]{kind}, target: target, conversion: MIRConversion.Prelude{
        call: fx_prelude_id("core.numeric", "int_checked_fixed"),
        location: MIRPanicLoc{file: fx_source_file(), line: 1, column: 1},
        fallibility: MIRCallFallibility.Infallible,
    }})
}

// `I64{-n}` as MIR may spell it: Neg of the exact constant `n`, then the
// sized-literal conversion.
fn fx_sized_negated(b: &FxBuilder, signed: Bool, bits: Int, constant: MIRConstant) -> MIRValueID Never! {
    number :: fx_copy(&b, fx_int(), MIROperation.Constant{value: constant})
    negated :: fx_copy(&b, fx_int(), MIROperation.Unary{op: MIRUnaryOp.Neg, value: number})
    kind :: fx_int_const(&b, 0)
    target :: fx_narrow(signed, bits)
    fx_copy(&b, target, MIROperation.Convert{value: negated, parameters: [MIRValueID]{kind}, target: target, conversion: MIRConversion.Prelude{
        call: fx_prelude_id("core.numeric", "int_checked_fixed"),
        location: MIRPanicLoc{file: fx_source_file(), line: 1, column: 1},
        fallibility: MIRCallFallibility.Infallible,
    }})
}

// Every width at its bounds, U64 above I64::MAX, I64 MIN, and both shapes of
// Int.jet int_inline's `value >= I64{-4611686018427387904}`: the folded
// negative constant plus a leftover unused `2^62`, and Neg(2^62). Neither
// may build an exact Int (2^62 is beyond the inline range).
// expect-stdout sized-literals: "5\n-9223372036854775808\n9223372036854775807\n18446744073709551615\n9223372036854775808\n255\n-128\n-32768\n4294967295\n2147483647\n0\n-4611686018427387904\n-4611686018427387904\n-9223372036854775808\n-7\ntrue\nfalse\n"
fn fx_sized_literals() -> MIRProgram Never! {
    b := fx_builder()
    rows :: [(signed: Bool, bits: Int, constant: MIRConstant)]{
        (signed: true, bits: 64, constant: mir_integer_constant(5, None, None)),
        (signed: true, bits: 64, constant: mir_integer_constant(-9223372036854775808, None, None)),
        (signed: true, bits: 64, constant: mir_integer_constant(9223372036854775807, None, None)),
        (signed: false, bits: 64, constant: MIRConstant.BigInt{decimal: "18446744073709551615"}),
        (signed: false, bits: 64, constant: MIRConstant.BigInt{decimal: "9223372036854775808"}),
        (signed: false, bits: 8, constant: mir_integer_constant(255, None, None)),
        (signed: true, bits: 8, constant: mir_integer_constant(-128, None, None)),
        (signed: true, bits: 16, constant: mir_integer_constant(-32768, None, None)),
        (signed: false, bits: 32, constant: mir_integer_constant(4294967295, None, None)),
        (signed: true, bits: 32, constant: mir_integer_constant(2147483647, None, None)),
        (signed: false, bits: 16, constant: mir_integer_constant(0, None, None)),
    }
    loop row in rows {
        value :: fx_sized_literal(&b, row.signed, row.bits, row.constant)
        fx_print(&b, value)
    }
    _ := fx_int_const(&b, 4611686018427387904)
    folded :: fx_sized_literal(&b, true, 64, mir_integer_constant(-4611686018427387904, None, None))
    fx_print(&b, folded)
    lowest :: fx_sized_negated(&b, true, 64, mir_integer_constant(4611686018427387904, None, None))
    fx_print(&b, lowest)
    minimum :: fx_sized_negated(&b, true, 64, MIRConstant.BigInt{decimal: "9223372036854775808"})
    fx_print(&b, minimum)
    minus_seven :: fx_sized_negated(&b, true, 8, mir_integer_constant(7, None, None))
    fx_print(&b, minus_seven)
    // int_inline: `value >= I64{-2^62}` for an inline and a non-inline word.
    loop word in ([Int]{5, -4611686018427387905}) {
        value :: fx_i64_const(&b, word)
        bound :: fx_sized_negated(&b, true, 64, mir_integer_constant(4611686018427387904, None, None))
        inline :: fx_compare(&b, MIRBinaryOp.Ge, value, bound)
        fx_print(&b, inline)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.numeric", "int_checked_fixed", "jet_std::jet_int_checked_fixed", 4, MIRPreludeABI.Value))
    p
}

// The literals build no exact Int and call no checked conversion: the
// runtime's own Int kernels are written with them.
fn fx_sized_literals_check() -> Bool Never! {
    program :: fx_sized_literals()
    lowered :: lir_lower_entry(program, mir_function_id("run"))
    text :: lir_print_module(lowered.lir)
    if lowered.issues.len() != 0 || text.contains("jet_int_checked_fixed") || text.contains("jet_int_owned_from_i64") || text.contains("jet_rt_int_from_static") {
        print("sized-literals: a sized literal lowered through a runtime Int conversion")
        return false
    }
    fx_report("sized-literals", program)
}

// `Float{n}` of a fixed integer: the checked_widen route
// (jet_numeric_checked_widen_at, arity 5: value, signed, target_f32, file,
// line) lowered inline, never as a runtime call (the runtime's own widen
// would call itself). Exact values cross; one that loses precision stops.
fn fx_widen_fixed(b: &FxBuilder, signed: Bool, bits: Int, value: Int, single: Bool) -> MIRValueID Never! {
    source :: fx_narrow_const(&b, signed, bits, value)
    signed_flag :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: signed}})
    single_flag :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: single}})
    target :: mir_type_from_kind(if single -> MIRTypeKind.Float32 else -> MIRTypeKind.Float)
    fx_copy(&b, target, MIROperation.Convert{value: source, parameters: [MIRValueID]{signed_flag, single_flag}, target: target, conversion: MIRConversion.Prelude{
        call: fx_prelude_id("core.numeric", "checked_widen"),
        location: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0},
        fallibility: MIRCallFallibility.Infallible,
    }})
}

fn fx_widen_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.numeric", "checked_widen", "jet_numeric_checked_widen_at", 5, MIRPreludeABI.Value))
    p
}

// I64 3, I64 -2^53, I64 MIN, U64 2^63 (its high-bit word), I32 -7 and 0.
// expect-stdout widen-fixed: "3\n-9007199254740992\n-9223372036854775808\n9223372036854775808\n-7\n0\n"
fn fx_widen_fixed_values() -> MIRProgram Never! {
    b := fx_builder()
    rows :: [(signed: Bool, bits: Int, value: Int)]{
        (signed: true, bits: 64, value: 3),
        (signed: true, bits: 64, value: -9007199254740992),
        (signed: true, bits: 64, value: -9223372036854775808),
        (signed: false, bits: 64, value: -9223372036854775808),
        (signed: true, bits: 32, value: -7),
        (signed: true, bits: 64, value: 0),
    }
    loop row in rows {
        value :: fx_widen_fixed(&b, row.signed, row.bits, row.value, false)
        fx_print(&b, value)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_widen_program(b)
}

// The widen is inline: no runtime widen helper is called.
fn fx_widen_fixed_check() -> Bool Never! {
    program :: fx_widen_fixed_values()
    lowered :: lir_lower_entry(program, mir_function_id("run"))
    if lowered.issues.len() != 0 || lir_print_module(lowered.lir).contains("jet_numeric_checked_widen_at") {
        print("widen-fixed: a fixed-width widen lowered through the runtime helper")
        return false
    }
    fx_report("widen-fixed", program)
}

fn fx_widen_stop(signed: Bool, bits: Int, value: Int, single: Bool) -> MIRProgram Never! {
    b := fx_builder()
    _ := fx_widen_fixed(&b, signed, bits, value, single)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_widen_program(b)
}

// fn run() { Float{I64.MAX} }
// expect-stdout widen-i64-max-stop: ""
// expect-exit widen-i64-max-stop: 70
// expect-stderr widen-i64-max-stop: "Stop [E3010]: `whole number cannot cross into the decimal without losing precision`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_widen_i64_max_stop() -> MIRProgram Never! { fx_widen_stop(true, 64, 9223372036854775807, false) }

// fn run() { Float{U64.MAX} }
// expect-stdout widen-u64-max-stop: ""
// expect-exit widen-u64-max-stop: 70
// expect-stderr widen-u64-max-stop: "Stop [E3010]: `whole number cannot cross into the decimal without losing precision`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_widen_u64_max_stop() -> MIRProgram Never! { fx_widen_stop(false, 64, -1, false) }

// fn run() { Float32{I32{16777217}} }
// expect-stdout widen-f32-stop: ""
// expect-exit widen-f32-stop: 70
// expect-stderr widen-f32-stop: "Stop [E3010]: `whole number cannot cross into the decimal without losing precision`\n  --> fixture.jet:3\n Why: The operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data — with Jet file and line.\n Fix: Check the operands or bounds before the operation, or use a checked operation that returns an outcome.\nMore: jet-lang.dev/e/E3010\n"
fn fx_widen_f32_stop() -> MIRProgram Never! { fx_widen_stop(true, 32, 16777217, true) }

// Fixed infix floor division, floored modulo and power are the trapping
// Prelude routes Core.rs jet_fixed_route_kernels defines for every width
// (FixedArithmetic.rs floor_div / floored_mod, Power.rs jet_pow).
fn fx_numeric_fixed_trap(b: &FxBuilder, signed: Bool, bits: Int, op: MIRBinaryOp, member: String, left: Int, right: Int) -> MIRValueID Never! {
    a :: fx_narrow_const(&b, signed, bits, left)
    c :: fx_narrow_const(&b, signed, bits, right)
    width :: if signed -> "i{bits}" else -> "u{bits}"
    location :: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0}
    fx_copy(&b, fx_narrow(signed, bits), MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Prelude{call: fx_prelude_id("core.numeric", "{width}.trap.{member}"), location: Val(location)}, overflow: MIRBinaryOverflow.Trap, left: a, right: c})
}

fn fx_numeric_fixed_trap_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    loop width in ([String]{"i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"}) {
        loop member in ([String]{"floor_div", "mod", "pow"}) {
            &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Overflow, "core.numeric", "{width}.trap.{member}", "jet_{width}_trap_{member}", 4, MIRPreludeABI.Value))
        }
    }
    p
}

// Floor division rounds toward negative infinity and the floored remainder
// takes the divisor's sign (I64 and I8 with negative operands, MIN / 1 and
// MIN mod -1); unsigned operands divide and take the remainder; a power that
// lands on the signed MIN still fits.
// expect-stdout numeric-fixed-floor: "-4\n1\n-4\n-1\n3\n-1\n3\n1\n-9223372036854775808\n0\n-43\n1\n-64\n-1\n127\n1\n9223372036854775807\n1\n-128\n81\n2147483648\n-9223372036854775808\n"
fn fx_numeric_fixed_floor() -> MIRProgram Never! {
    b := fx_builder()
    // -1 as U64 carries U64.MAX's high-bit word, as in Unsigned.jet's fixtures.
    divisions :: [(signed: Bool, bits: Int, left: Int, right: Int)]{
        (signed: true, bits: 64, left: -7, right: 2),
        (signed: true, bits: 64, left: 7, right: -2),
        (signed: true, bits: 64, left: -7, right: -2),
        (signed: true, bits: 64, left: 7, right: 2),
        (signed: true, bits: 8, left: -128, right: 3),
        (signed: true, bits: 8, left: 127, right: -2),
        (signed: false, bits: 8, left: 255, right: 2),
        (signed: false, bits: 64, left: -1, right: 2),
    }
    loop (index, row) in divisions {
        quotient :: fx_numeric_fixed_trap(&b, row.signed, row.bits, .FloorDiv, "floor_div", row.left, row.right)
        fx_print(&b, quotient)
        remainder :: fx_numeric_fixed_trap(&b, row.signed, row.bits, .Mod, "mod", row.left, row.right)
        fx_print(&b, remainder)
        if index == 3 {
            minimum :: fx_numeric_fixed_trap(&b, true, 64, .FloorDiv, "floor_div", -9223372036854775808, 1)
            fx_print(&b, minimum)
            zero :: fx_numeric_fixed_trap(&b, true, 64, .Mod, "mod", -9223372036854775808, -1)
            fx_print(&b, zero)
        }
    }
    powers :: [(signed: Bool, bits: Int, left: Int, right: Int)]{
        (signed: true, bits: 8, left: -2, right: 7),
        (signed: true, bits: 16, left: 3, right: 4),
        (signed: false, bits: 32, left: 2, right: 31),
        (signed: true, bits: 64, left: -2, right: 63),
    }
    loop row in powers {
        power :: fx_numeric_fixed_trap(&b, row.signed, row.bits, .Pow, "pow", row.left, row.right)
        fx_print(&b, power)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_numeric_fixed_trap_program(b)
}

fn fx_numeric_fixed_trap_stop(signed: Bool, bits: Int, op: MIRBinaryOp, member: String, left: Int, right: Int) -> MIRProgram Never! {
    b := fx_builder()
    _ := fx_numeric_fixed_trap(&b, signed, bits, op, member, left, right)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_numeric_fixed_trap_program(b)
}

