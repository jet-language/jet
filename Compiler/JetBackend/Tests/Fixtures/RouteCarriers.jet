// Route carriers the compiler's own MIR crosses per call (Routes.jet): an
// exact Int crosses a Word carrier as its carrier word, and the native Dyn
// enum's `field` scans its own Object entries (jet_rt_string_eq) and clones a
// hit; only a miss crosses the Handle{Dyn} carrier as a runtime tree built for
// the call (lower_dyn_field, lower_route_dyn). A mismatched checked type
// is still refused. Lowering witnesses: Jet lowering and LIR lint only.
use jet_foundation.[
MIRCallArg,
MIRConstant,
MIRDropKind,
MIREnumArg,
MIRField,
MIRFunction,
MIRFunctionID,
MIROperation,
MIRPreludeABI,
MIRPreludeFamily,
MIRPreludeTypeArg,
MIRProgram,
MIRSemanticOp,
MIRTerminator,
MIRTupleField,
MIRType,
MIRTypeDef,
MIRTypeDefKind,
MIRTypeKind,
MIRValueID,
MIRVariant,
MIRVariantPayload,
mir_function_id,
mir_type_from_kind,
mir_type_id,
]

// The prelude Dyn declaration (key "Dyn", lower_dyn_type) with every variant
// Dyn.jet lower_dyn_schema marshals; DateTime keeps one word of storage.
fn fx_route_dyn_definition() -> MIRTypeDef Never! {
    tree :: fx_named("Dyn")
    entry :: fx_tuple_type("RouteDynEntry", [MIRTupleField]{MIRTupleField{name: "key", ty: fx_string()}, MIRTupleField{name: "value", ty: tree}})
    fx_type_def(
    "Dyn",
    MIRTypeDefKind.Enum{
        variants: [MIRVariant]{
            fx_variant("Null", MIRVariantPayload.Unit),
            fx_variant("Bool", MIRVariantPayload.Single{value: fx_bool()}),
            fx_variant("Int", MIRVariantPayload.Single{value: fx_int()}),
            fx_variant("Float", MIRVariantPayload.Single{value: mir_type_from_kind(MIRTypeKind.Float)}),
            fx_variant("Number", MIRVariantPayload.Single{value: fx_string()}),
            fx_variant("Text", MIRVariantPayload.Single{value: fx_string()}),
            fx_variant("Bytes", MIRVariantPayload.Single{value: mir_type_from_kind(MIRTypeKind.List{inner: mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 8})})}),
            fx_variant("DateTime", MIRVariantPayload.Single{value: fx_string()}),
            fx_variant("Array", MIRVariantPayload.Single{value: mir_type_from_kind(MIRTypeKind.List{inner: tree})}),
            fx_variant("Object", MIRVariantPayload.Single{value: mir_type_from_kind(MIRTypeKind.List{inner: entry})}),
        },
        methods: [MIRFunctionID]{},
    },
    )
}

fn fx_route_carriers_program(b: FxBuilder) -> MIRProgram Never! {
    types :: [MIRTypeDef]{
        fx_route_dyn_definition(),
        fx_type_def("FieldError", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("FieldError", "path", fx_string()), fx_field("FieldError", "reason", fx_string())}, methods: [MIRFunctionID]{}}),
    }
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "string_slice", "jet_string_slice_builtin", 3, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "find", "jet_text_parse_find", 2, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "core.encoding.dyn", "field", "jet_dyn_field", 2, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "core.handle", "duration.ns_value", "jet_duration_ns_value", 1, MIRPreludeABI.Value))
    p
}

// `fn ns(d: Duration) -> Int { d.ns_value() }`: Duration has no checked
// declaration (a builtin), so its word crosses through the record getter.
fn fx_route_carriers_duration() -> MIRProgram Never! {
    b := fx_builder()
    duration :: fx_param(&b, "d", fx_named("Duration"), fx_borrow())
    ns :: fx_owned(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: fx_prelude_id("core.handle", "duration.ns_value"), receiver: duration, args: [MIRValueID]{}, frame_schedule: None, frame_schedule_derivation: None}})
    fx_block(&b, 0, MIRTerminator.Return{value: Val(ns)})
    p := fx_route_carriers_program(fx_builder())
    p.functions = [MIRFunction]{fx_function("ns", b, fx_int())}
    p
}

// `duration_from_int(5, .Nanoseconds)`: the adapter's ok word (CAbiRoutes
// `jet_int_from_i64(d.ns)`) becomes the native Duration handle through the
// record constructor on the success edge only.
fn fx_route_carriers_duration_new() -> MIRProgram Never! {
    b := fx_builder()
    integer :: fx_int_const(&b, 5)
    unit :: fx_copy(&b, fx_named("DurationUnit"), MIROperation.Enum{type_id: mir_type_id("DurationUnit"), variant: "Nanoseconds", args: [MIREnumArg]{}})
    result :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_named("Duration"), err: fx_named("RangeError")})
    made :: fx_owned(&b, result, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.time", "duration_from_int"), args: [MIRCallArg]{fx_arg(integer, .Read), fx_arg(unit, .Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    loop value in ([MIRValueID]{made, integer}) {
        fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    variants := [MIRVariant]{}
    loop name in ([String]{"Nanoseconds", "Microseconds", "Milliseconds", "Seconds", "Minutes", "Hours"}) -> &variants.push(fx_variant(name, MIRVariantPayload.Unit))
    definition :: fx_type_def("DurationUnit", MIRTypeDefKind.Enum{variants: variants, methods: [MIRFunctionID]{}})
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{definition})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.time", "duration_from_int", "jet_duration_from_int", 2, MIRPreludeABI.Value))
    p
}

fn fx_route_carrier_text(b: &FxBuilder, text: String) -> MIRValueID Never! {
    fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: text}})
}

// `"carrier".slice(1, 4)`, `"carrier".find("rr")`, `Dyn.Null.field("x")`.
fn fx_route_carriers_admitted() -> MIRProgram Never! {
    b := fx_builder()
    text :: fx_route_carrier_text(&b, "carrier")
    start :: fx_int_const(&b, 1)
    end :: fx_int_const(&b, 4)
    middle :: fx_owned(&b, fx_string(), MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "string_slice"), receiver: text, receiver_place: None, args: [MIRValueID]{start, end}, aggregate_fields: None}})
    fx_print(&b, middle)
    needle :: fx_route_carrier_text(&b, "rr")
    found :: fx_copy(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "find"), receiver: text, receiver_place: None, args: [MIRValueID]{needle}, aggregate_fields: None}})
    fx_print(&b, found)
    tree_ty :: fx_named("Dyn")
    tree :: fx_owned(&b, tree_ty, MIROperation.Enum{type_id: mir_type_id("Dyn"), variant: "Null", args: [MIREnumArg]{}})
    name :: fx_route_carrier_text(&b, "x")
    errors :: mir_type_from_kind(MIRTypeKind.List{inner: fx_named("FieldError")})
    field_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: tree_ty, err: errors})
    field :: fx_owned(&b, field_ty, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: fx_prelude_id("core.encoding.dyn", "field"), receiver: tree, args: [MIRValueID]{name}, frame_schedule: None, frame_schedule_derivation: None}})
    loop value in ([MIRValueID]{field, name, tree, needle, middle, text}) {
        fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_route_carriers_program(b)
}

// An Int-carrying route checked as Bool does not match its Word carrier.
fn fx_route_carriers_refused() -> MIRProgram Never! {
    b := fx_builder()
    text :: fx_route_carrier_text(&b, "carrier")
    needle :: fx_route_carrier_text(&b, "rr")
    found :: fx_copy(&b, fx_bool(), MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "find"), receiver: text, receiver_place: None, args: [MIRValueID]{needle}, aggregate_fields: None}})
    fx_print(&b, found)
    loop value in ([MIRValueID]{needle, text}) {
        fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_route_carriers_program(b)
}

fn fx_route_carrier_runtime_calls(lir: LIRModule) -> [String] Never! {
    calls := [String]{}
    loop function in lir.functions {
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .Call(_, _, .Runtime(symbol), _) -> &calls.push(symbol)
            }
        }
    }
    calls
}

// A miss builds a runtime tree before the route, releases it after, and the
// Ok arm converts back to the native enum.
fn fx_route_carrier_dyn_order(calls: [String]) -> Bool Never! {
    expected :: [String]{"jet_rt_dyn_from_native", "jet_dyn_field", "jet_rt_dyn_to_native", "jet_rt_handle_drop_dyn"}
    at := 0
    loop symbol in calls {
        if at < expected.len() && symbol == expected[at] -> at += 1
    }
    at == expected.len()
}

// Constructor-shaped RHS expressions can bind a fresh payload in ==.
// Cover positive and negative scalar, List and composed Option identities,
// plus mutable-handle and packed-byte record sequence constraints.
fn fx_route_carrier_identity_checks() -> Bool {
    p :: fx_route_carriers_program(fx_builder())
    clean := true
    if !lower_route_carrier_matches(p, fx_bool(), LowerRouteCarrier.Flag)
        || lower_route_carrier_matches(p, fx_bool(), LowerRouteCarrier.Word) {
        print("route-carriers: Bool must cross Flag, not Word")
        clean = false
    }
    if !lower_route_carrier_matches(p, fx_int(), LowerRouteCarrier.Word)
        || lower_route_carrier_matches(p, fx_int(), LowerRouteCarrier.Flag) {
        print("route-carriers: Int must cross Word, not Flag")
        clean = false
    }
    if !lower_route_carrier_matches(p, fx_string(), LowerRouteCarrier.Text)
        || lower_route_carrier_matches(p, fx_string(), LowerRouteCarrier.Word) {
        print("route-carriers: String must cross Text, not Word")
        clean = false
    }
    flags :: mir_type_from_kind(MIRTypeKind.List{inner: fx_bool()})
    if !lower_route_carrier_matches(p, flags, LowerRouteCarrier.List{elem: LowerRouteCarrier.Flag})
        || lower_route_carrier_matches(p, flags, LowerRouteCarrier.List{elem: LowerRouteCarrier.Word}) {
        print("route-carriers: List<Bool> must retain its Flag element carrier")
        clean = false
    }
    optional :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_bool()})
    if !lower_route_carrier_matches(p, optional, LowerRouteCarrier.Option{some: LowerRouteCarrier.Flag})
        || lower_route_carrier_matches(p, optional, LowerRouteCarrier.Option{some: LowerRouteCarrier.Word}) {
        print("route-carriers: Option<Bool> must retain its Flag payload carrier")
        clean = false
    }
    if lower_route_carrier_matches(p, fx_bool(), LowerRouteCarrier.HandleMut{name: "Dyn"})
        || lower_route_carrier_matches(p, fx_int(), LowerRouteCarrier.HandleMut{name: "Dyn"}) {
        print("route-carriers: a mutable Dyn handle must not accept Flag or Word")
        clean = false
    }
    bytes :: mir_type_from_kind(MIRTypeKind.List{inner: mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 8})})
    if !lower_record_kind_matches(p, bytes, "List.Byte")
        || lower_record_kind_matches(p, bytes, "List.Rec.FieldError") {
        print("route-carriers: a packed-byte record sequence must retain its exact kind")
        clean = false
    }
    clean
}

fn fx_route_carrier_checks() -> Bool {
    clean := fx_route_carrier_identity_checks()
    admitted :: lir_lower_entry(fx_route_carriers_admitted(), mir_function_id("run"))
    loop issue in admitted.issues -> print("route-carriers: {issue.function}: {issue.message}")
    if admitted.issues.len() != 0 -> clean = false
    lint :: lir_lint_module(admitted.lir)
    loop issue in lint -> print("route-carriers: {issue.function} b{issue.block}: {issue.message}")
    if lint.len() != 0 -> clean = false
    calls :: fx_route_carrier_runtime_calls(admitted.lir)
    loop symbol in ([String]{"jet_string_slice_builtin", "jet_text_parse_find", "jet_rt_string_eq"}) {
        if !calls.contains(symbol) {
            print("route-carriers: {symbol} was not called")
            clean = false
        }
    }
    if !fx_route_carrier_dyn_order(calls) {
        print("route-carriers: Dyn route boundary order {calls.join(",")}")
        clean = false
    }
    duration :: lir_lower_entry(fx_route_carriers_duration(), mir_function_id("ns"))
    loop issue in duration.issues -> print("route-carriers duration: {issue.message}")
    if duration.issues.len() != 0 -> clean = false
    duration_calls :: fx_route_carrier_runtime_calls(duration.lir)
    getter := false
    loop (index, symbol) in duration_calls {
        if symbol == "jet_rt_record_get_duration_ns" && index + 1 < duration_calls.len() && duration_calls[index + 1] == "jet_duration_ns_value" {
            getter = true
        }
    }
    if !getter {
        print("route-carriers: Duration did not cross as its record getter word ({duration_calls.join(",")})")
        clean = false
    }
    made :: lir_lower_entry(fx_route_carriers_duration_new(), mir_function_id("run"))
    loop issue in made.issues -> print("route-carriers duration_from_int: {issue.message}")
    if made.issues.len() != 0 -> clean = false
    loop issue in lir_lint_module(made.lir) {
        print("route-carriers duration_from_int: {issue.message}")
        clean = false
    }
    made_calls :: fx_route_carrier_runtime_calls(made.lir)
    called := false
    constructed := false
    loop symbol in made_calls {
        if symbol == "jet_duration_from_int" -> called = true
        if called && symbol == "jet_rt_record_new_duration" -> constructed = true
    }
    if !constructed {
        print("route-carriers: Duration result word was not rebuilt by its record constructor ({made_calls.join(",")})")
        clean = false
    }
    refused :: lir_lower_entry(fx_route_carriers_refused(), mir_function_id("run"))
    matched := false
    loop issue in refused.issues {
        if issue.message.contains("does not match its runtime route") -> matched = true
    }
    if !matched || refused.entry != None {
        print("route-carriers: an Int route checked as Bool was not refused")
        loop issue in refused.issues -> print("route-carriers: refusal {issue.function}: {issue.message}")
        clean = false
    }
    print(if clean -> "route-carriers: exact Int and Dyn cross their route carriers" else -> "route-carriers: carrier witnesses failed")
    clean
}
