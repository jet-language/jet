// expect-stdout strings-predicates: "true\nfalse\ntrue\nfalse\nfalse\ntrue\ntrue\nfalse\ntrue\nfalse\nfalse\ntrue\ntrue\nfalse\ntrue\nfalse\nfalse\ntrue\ntrue\nfalse\ntrue\ntrue\nfalse\ntrue\n"
fn fx_strings_predicates() -> MIRProgram Never! {
    b := fx_builder()
    text :: fx_strings_literal(&b, "ababa")
    pattern :: fx_strings_literal(&b, "aba")
    absent :: fx_strings_literal(&b, "xyz")
    empty :: fx_strings_literal(&b, "")
    longer :: fx_strings_literal(&b, "ababa!")
    tail :: fx_strings_literal(&b, "ba")
    unicode :: fx_strings_literal(&b, "é🙂x")
    emoji :: fx_strings_literal(&b, "🙂")
    final_letter :: fx_strings_literal(&b, "x")
    members :: [String]{"contains", "string_starts_with", "string_ends_with"}
    loop member in members {
        fx_strings_print_method(&b, member, text, [MIRValueID]{pattern}, fx_bool())
        fx_strings_print_method(&b, member, text, [MIRValueID]{absent}, fx_bool())
        fx_strings_print_method(&b, member, text, [MIRValueID]{empty}, fx_bool())
        fx_strings_print_method(&b, member, empty, [MIRValueID]{pattern}, fx_bool())
        fx_strings_print_method(&b, member, text, [MIRValueID]{longer}, fx_bool())
        fx_strings_print_method(&b, member, empty, [MIRValueID]{empty}, fx_bool())
    }
    fx_strings_print_method(&b, "contains", text, [MIRValueID]{tail}, fx_bool())
    fx_strings_print_method(&b, "string_starts_with", text, [MIRValueID]{tail}, fx_bool())
    fx_strings_print_method(&b, "string_ends_with", text, [MIRValueID]{tail}, fx_bool())
    fx_strings_print_method(&b, "contains", unicode, [MIRValueID]{emoji}, fx_bool())
    fx_strings_print_method(&b, "string_starts_with", unicode, [MIRValueID]{emoji}, fx_bool())
    fx_strings_print_method(&b, "string_ends_with", unicode, [MIRValueID]{final_letter}, fx_bool())
    owned :: [MIRValueID]{text, pattern, absent, empty, longer, tail, unicode, emoji, final_letter}
    loop value in owned -> fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_strings_program(b)
}
