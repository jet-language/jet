use jet_foundation.[
    MIRBinaryOp,
    MIRConstant,
    MIRDropKind,
    MIRFieldID,
    MIRFunction,
    MIROperation,
    MIRPreludeABI,
    MIRPreludeFamily,
    MIRProgram,
    MIRSemanticOp,
    MIRTerminator,
    MIRType,
    MIRTypeDef,
    MIRValueID,
]

fn fx_strings_literal(b: &FxBuilder, text: String) -> MIRValueID Never! {
    fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: text}})
}

fn fx_strings_method(b: &FxBuilder, member: String, receiver: MIRValueID, args: [MIRValueID], result: MIRType) -> MIRValueID Never! {
    fx_copy(&b, result, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", member), receiver: receiver, receiver_place: None, args: args, aggregate_fields: None}})
}

fn fx_strings_print_compare(b: &FxBuilder, op: MIRBinaryOp, left: MIRValueID, right: MIRValueID) Never! {
    value :: fx_compare(&b, op, left, right)
    fx_print(&b, value)
}

fn fx_strings_print_method(b: &FxBuilder, member: String, receiver: MIRValueID, args: [MIRValueID], result: MIRType) Never! {
    value :: fx_strings_method(&b, member, receiver, args, result)
    fx_print(&b, value)
}

fn fx_strings_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^[MIRTypeDef]{})
    members :: [String]{"len", "len_string", "is_empty", "contains", "string_starts_with", "string_ends_with"}
    loop member in members {
        symbol :: if member == "len" || member == "len_string" -> "jet_char_len" else if member == "is_empty" -> "jet_string_is_empty" else if member == "contains" -> "jet_string_contains" else if member == "string_starts_with" -> "jet_string_starts_with" else -> "jet_string_ends_with"
        arity :: if member == "len" || member == "len_string" || member == "is_empty" -> 1 else -> 2
        row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", member, symbol, arity, MIRPreludeABI.Value)
        row.signature.borrow_mask = if arity == 1 -> [Bool]{true} else -> [Bool]{true, true}
        &p.prelude_calls.push(row)
    }
    p
}

