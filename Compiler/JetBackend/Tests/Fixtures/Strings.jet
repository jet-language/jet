//     print("apple" < "banana"); print("b" > "abc"); print("" < "a")
//     print("abc".len()); print("".is_empty()); print("abc".is_empty())
//     print("abc" < "abc"); print("abc" <= "abc")
//     print("abc" > "abc"); print("abc" >= "abc")
//     print("abc" < "abcd"); print("abcd" > "abc")
//     print("" <= ""); print("" >= ""); print("é" > "z")
//     print("é🙂x".len()); print("".len()); print("abc".len())
