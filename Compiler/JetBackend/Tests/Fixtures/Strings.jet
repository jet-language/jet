// expect-stdout strings: "true\ntrue\ntrue\n3\ntrue\nfalse\nfalse\ntrue\nfalse\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n3\n0\n3\n"
fn fx_strings() -> MIRProgram Never! {
    b := fx_builder()
    apple :: fx_strings_literal(&b, "apple")
    banana :: fx_strings_literal(&b, "banana")
    letter_b :: fx_strings_literal(&b, "b")
    abc :: fx_strings_literal(&b, "abc")
    empty :: fx_strings_literal(&b, "")
    letter_a :: fx_strings_literal(&b, "a")
    abcd :: fx_strings_literal(&b, "abcd")
    accented :: fx_strings_literal(&b, "é")
    letter_z :: fx_strings_literal(&b, "z")
    unicode :: fx_strings_literal(&b, "é🙂x")
    fx_strings_print_compare(&b, MIRBinaryOp.Lt, apple, banana)
    fx_strings_print_compare(&b, MIRBinaryOp.Gt, letter_b, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Lt, empty, letter_a)
    fx_strings_print_method(&b, "len", abc, [MIRValueID]{}, fx_int())
    fx_strings_print_method(&b, "is_empty", empty, [MIRValueID]{}, fx_bool())
    fx_strings_print_method(&b, "is_empty", abc, [MIRValueID]{}, fx_bool())
    fx_strings_print_compare(&b, MIRBinaryOp.Lt, abc, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Le, abc, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Gt, abc, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Ge, abc, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Lt, abc, abcd)
    fx_strings_print_compare(&b, MIRBinaryOp.Gt, abcd, abc)
    fx_strings_print_compare(&b, MIRBinaryOp.Le, empty, empty)
    fx_strings_print_compare(&b, MIRBinaryOp.Ge, empty, empty)
    fx_strings_print_compare(&b, MIRBinaryOp.Gt, accented, letter_z)
    fx_strings_print_method(&b, "len", unicode, [MIRValueID]{}, fx_int())
    fx_strings_print_method(&b, "len", empty, [MIRValueID]{}, fx_int())
    fx_strings_print_method(&b, "len_string", abc, [MIRValueID]{}, fx_int())
    owned :: [MIRValueID]{apple, banana, letter_b, abc, empty, letter_a, abcd, accented, letter_z, unicode}
    loop value in owned -> fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_strings_program(b)
}

