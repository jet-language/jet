// Checked require/require_eq/panic routes, including debug-only local context.
use jet_foundation.[MIRPanicContext, MIRPanicLocal, MIRRequireKind]

fn fx_require_text(b: &FxBuilder, text: String) -> MIRValueID Never! {
    fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: text}})
}

fn fx_require_flag(b: &FxBuilder, flag: Bool) -> MIRValueID Never! {
    fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: flag}})
}

fn fx_require_context(source: String) -> MIRPanicContext Never! {
    MIRPanicContext{function: "run", source_line: source, caret: 8, locals: [MIRPanicLocal]{}}
}

fn fx_require_do(b: &FxBuilder, kind: MIRRequireKind, condition: MIRValueID?, values: [MIRValueID], context: MIRPanicContext, stops: Bool) Never! {
    member :: if kind == .Require -> "require" else -> if kind == .RequireEq -> "require_eq" else -> "panic"
    fx_do(&b, MIROperation.Semantic{operation: MIRSemanticOp.RequireStop{
        call: fx_prelude_id("core.stop", member), kind: kind, condition: condition,
        location: MIRPanicLoc{file: fx_source_file(), line: 3, column: 5},
        context: context, values: values, always_stops: stops,
    }})
}

fn fx_require_program(b: FxBuilder) -> MIRProgram Never! {
    program := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.stop", "require", "jet_require", 9, MIRPreludeABI.Control))
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.stop", "require_eq", "jet_require_eq", 10, MIRPreludeABI.Control))
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.stop", "panic", "jet_panic_rich", 8, MIRPreludeABI.Control))
    program
}

// Jet: print("before"); #require(true); #require_eq("same", "same"); print("after")
// expect-stdout require-pass: "before\nafter\n"
fn fx_require_pass() -> MIRProgram Never! {
    b := fx_builder()
    before :: fx_require_text(&b, "before")
    fx_print(&b, before)
    fx_do(&b, MIROperation.Drop{value: before, kind: MIRDropKind.Value})
    condition :: fx_require_flag(&b, true)
    fx_require_do(&b, MIRRequireKind.Require, Val(condition), [MIRValueID]{}, fx_require_context("    #require(true)"), false)
    left :: fx_require_text(&b, "same")
    right :: fx_require_text(&b, "same")
    fx_require_do(&b, MIRRequireKind.RequireEq, Val(condition), [MIRValueID]{left, right}, fx_require_context("    #require_eq(left, right)"), false)
    fx_do(&b, MIROperation.Drop{value: left, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: right, kind: MIRDropKind.Value})
    after :: fx_require_text(&b, "after")
    fx_print(&b, after)
    fx_do(&b, MIROperation.Drop{value: after, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_require_program(b)
}

// Jet: #require(false, "broken")
// expect-stdout require-fail: ""
// expect-exit require-fail: 70
// expect-stderr require-fail: "Stop [E3001]: `panic: broken`\n  --> fixture.jet:3 in run\n    |\n3 |     #require(false, \"broken\")\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_fail() -> MIRProgram Never! {
    b := fx_builder()
    condition :: fx_require_flag(&b, false)
    message :: fx_require_text(&b, "broken")
    fx_require_do(&b, MIRRequireKind.Require, Val(condition), [MIRValueID]{message}, fx_require_context("    #require(false, \"broken\")"), false)
    // A failed conditional stop must never execute the following print.
    fx_print(&b, message)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_require_program(b)
}

// Jet: #require_eq(-7, 9)
// expect-stdout require-eq-int: ""
// expect-exit require-eq-int: 70
// expect-stderr require-eq-int: "Stop [E3001]: `panic: expected: 9, got: -7`\n  --> fixture.jet:3 in run\n    |\n3 |     #require_eq(-7, 9)\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_eq_int() -> MIRProgram Never! {
    b := fx_builder()
    left :: fx_int_const(&b, -7)
    right :: fx_int_const(&b, 9)
    condition :: fx_compare(&b, MIRBinaryOp.Eq, left, right)
    fx_require_do(&b, MIRRequireKind.RequireEq, Val(condition), [MIRValueID]{left, right}, fx_require_context("    #require_eq(-7, 9)"), false)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_require_program(b)
}

// Jet: #require_eq("a\"\\\n\t" + CR + NUL + "é😀́", "right")
// expect-stdout require-eq-string: ""
// expect-exit require-eq-string: 70
// expect-stderr require-eq-string: "Stop [E3001]: `panic: expected: \"right\", got: \"a\\\"\\\\\\n\\t\\r\\0é😀\\u{301}\"`\n  --> fixture.jet:3 in run\n    |\n3 |     #require_eq(left, right)\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_eq_string() -> MIRProgram Never! {
    b := fx_builder()
    controls :: String.from_bytes([U8]{U8{13}, U8{0}}) ?? ""
    left :: fx_require_text(&b, "a\"\\\n\t{controls}é😀́")
    right :: fx_require_text(&b, "right")
    condition :: fx_compare(&b, MIRBinaryOp.Eq, left, right)
    fx_require_do(&b, MIRRequireKind.RequireEq, Val(condition), [MIRValueID]{left, right}, fx_require_context("    #require_eq(left, right)"), false)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_require_program(b)
}

// Jet: #panic("boom")
// expect-stdout panic-message: ""
// expect-exit panic-message: 70
// expect-stderr panic-message: "Stop [E3001]: `panic: boom`\n  --> fixture.jet:3 in run\n    |\n3 |     #panic(\"boom\")\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_panic_message() -> MIRProgram Never! {
    b := fx_builder()
    message :: fx_require_text(&b, "boom")
    fx_require_do(&b, MIRRequireKind.Panic, None, [MIRValueID]{message}, fx_require_context("    #panic(\"boom\")"), true)
    fx_block(&b, 0, MIRTerminator.Unreachable{reason: "panic"})
    fx_require_program(b)
}

// Jet: #require(false)
// expect-stdout require-default: ""
// expect-exit require-default: 70
// expect-stderr require-default: "Stop [E3001]: `panic: condition failed`\n  --> fixture.jet:3 in run\n    |\n3 |     #require(false)\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_default() -> MIRProgram Never! {
    b := fx_builder()
    condition :: fx_require_flag(&b, false)
    fx_require_do(&b, MIRRequireKind.Require, Val(condition), [MIRValueID]{}, fx_require_context("    #require(false)"), true)
    fx_block(&b, 0, MIRTerminator.Unreachable{reason: "require"})
    fx_require_program(b)
}

// Jet: #require(false, "") -- explicitly empty does not use the omitted default.
// expect-stdout require-empty: ""
// expect-exit require-empty: 70
// expect-stderr require-empty: "Stop [E3001]: `panic: `\n  --> fixture.jet:3 in run\n    |\n3 |     #require(false, \"\")\n    |     ^^^^^^^^\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_empty() -> MIRProgram Never! {
    b := fx_builder()
    condition :: fx_require_flag(&b, false)
    message :: fx_require_text(&b, "")
    fx_require_do(&b, MIRRequireKind.Require, Val(condition), [MIRValueID]{message}, fx_require_context("    #require(false, \"\")"), true)
    fx_block(&b, 0, MIRTerminator.Unreachable{reason: "require"})
    fx_require_program(b)
}

// Jet: n := 1; n = 7; flag := true; letter := 'é'; text := "line\n"; #panic("locals")
// expect-stdout require-locals: ""
// expect-exit require-locals: 70
// expect-stderr require-locals: "Stop [E3001]: `panic: locals`\n  --> fixture.jet:3 in run\n    |\n3 |     #panic(\"locals\")\n    |     ^^^^^^^^\nlocals: n = 7, flag = true, letter = é, text = \"line\\n\"\n Why: The program hit a `panic`, `assert`, or `assert_eq` call that failed, a bounds/key check triggered at runtime, or another program-side stop. The shared report boundary owns the program-side stop; an unhandled entry error is a returned report, not E3001. Jet file and line are shown in Jet terms — never generated-Rust terms (I2).\n Fix: Fix the logic that led to the failure. Program-side stops exit 70 through the shared boundary; unhandled entry errors print their report and exit 1; exit 101 is reserved for Jet defects.\nMore: jet-lang.dev/e/E3001\n"
fn fx_require_locals() -> MIRProgram Never! {
    b := fx_builder()
    n :: fx_local(&b, "n", fx_int(), mir_copy_ownership())
    one :: fx_int_const(&b, 1)
    fx_do(&b, MIROperation.WritePlace{place: n, value: one})
    seven :: fx_int_const(&b, 7)
    fx_do(&b, MIROperation.WritePlace{place: n, value: seven})
    flag :: fx_local(&b, "flag", fx_bool(), mir_copy_ownership())
    truth :: fx_require_flag(&b, true)
    fx_do(&b, MIROperation.WritePlace{place: flag, value: truth})
    character :: mir_type_from_kind(MIRTypeKind.Char)
    letter :: fx_local(&b, "letter", character, mir_copy_ownership())
    e :: fx_copy(&b, character, MIROperation.Constant{value: MIRConstant.Char{value: 233}})
    fx_do(&b, MIROperation.WritePlace{place: letter, value: e})
    text :: fx_local(&b, "text", fx_string(), mir_owned_ownership())
    line :: fx_require_text(&b, "line\n")
    fx_do(&b, MIROperation.WritePlace{place: text, value: line})
    context := fx_require_context("    #panic(\"locals\")")
    loop local in b.locals -> &context.locals.push(MIRPanicLocal{name: local.name, local: local.id})
    message :: fx_require_text(&b, "locals")
    fx_require_do(&b, MIRRequireKind.Panic, None, [MIRValueID]{message}, context, true)
    fx_block(&b, 0, MIRTerminator.Unreachable{reason: "panic"})
    fx_require_program(b)
}
