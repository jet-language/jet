// The checked Atomic scalar set has ONE MIR physical word layout. This pure
// fixture is independent of provider linking and native runtime behavior.
use jet_foundation.[MIRABI, MIRLayout, MIRScalarKind, MIRSize, MIRType, MIRTypeKind, mir_nominal_ref, mir_type_from_kind]

fn fx_atomic_mir_layout_checks() -> Bool Never! {
    word :: MIRLayout{abi: MIRABI.Scalar{kind: MIRScalarKind.Int}, size: MIRSize.Static{bytes: 8}, align: MIRSize.Static{bytes: 8}}
    kinds :: [MIRTypeKind]{MIRTypeKind.Bool, MIRTypeKind.Int, MIRTypeKind.IntN{signed: true, bits: 32}, MIRTypeKind.IntN{signed: false, bits: 32}, MIRTypeKind.IntN{signed: true, bits: 64}, MIRTypeKind.IntN{signed: false, bits: 64}}
    names :: [String]{"Atomic", "core.mem::Atomic", "core.mem.Atomic"}
    loop name in names {
        loop kind in kinds {
            ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref(name), args: [MIRType]{mir_type_from_kind(kind)}})
            if ty.layout != word -> return false
        }
    }
    unsupported :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Atomic"), args: [MIRType]{mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 16})}})
    unsupported.layout.abi == MIRABI.Nominal && unsupported.layout.size == MIRSize.Dynamic
}
