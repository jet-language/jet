// The retired image stub stops when an exact Int leaves the tagged inline
// range. The admitted real Jet provider must instead retain exact values.
// expect-stdout image-overflow-decimal: "4611686018427387904\n9223372036854775808\n18446744073709551616\n-9223372036854775809\n"
fn fx_image_overflow_decimal() -> MIRProgram Never! {
    b := fx_builder()
    inline_max :: fx_int_const(&b, 4611686018427387903)
    one :: fx_int_const(&b, 1)
    outside_inline :: fx_int_op(&b, MIRBinaryOp.Add, "add", inline_max, one)
    fx_print(&b, outside_inline)
    signed_max :: fx_int_const(&b, 9223372036854775807)
    outside_word :: fx_int_op(&b, MIRBinaryOp.Add, "add", signed_max, one)
    fx_print(&b, outside_word)
    two :: fx_int_const(&b, 2)
    product :: fx_int_op(&b, MIRBinaryOp.Mul, "mul", outside_word, two)
    fx_print(&b, product)
    minimum :: fx_int_const(&b, -9223372036854775808)
    negative :: fx_int_op(&b, MIRBinaryOp.Sub, "sub", minimum, one)
    fx_print(&b, negative)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}
