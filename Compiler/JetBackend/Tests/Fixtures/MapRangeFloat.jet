use jet_foundation.[
    MIRAccess, MIRBinaryDispatch, MIRBinaryOp, MIRBinaryOverflow, MIRConstant,
    MIRDropKind, MIRField, MIRFunction, MIRFunctionID, MIRMapEntry, MIROperation, MIRPlace,
    MIRPlaceBase, MIRPlaceID, MIRProjection, MIRProgram, MIRTerminator,
    MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRUnaryOp, MIRValueID,
    mir_nominal_ref, mir_owned_ownership, mir_type_from_kind,
]

// Map pattern emission: Codegen/Expressions.jet:6762; the cache stores both
// hits and misses. Projection reads lend the map value, never transfer it.
fn fx_lookup_projection(b: &FxBuilder, map: MIRPlaceID, lookup: MIRValueID, optional: Bool, ty: MIRType) -> MIRPlaceID Never! {
    base := MIRPlaceBase.Static{name: ""}
    loop row in b.places { if row.id == map -> base = row.base }
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{id: place, span: fx_span(), ty: ty, base: base,
        projections: [MIRProjection]{MIRProjection.MapLookup{lookup: lookup, optional: optional, span: fx_span()}},
        access: MIRAccess.Read, persist_key: None})
    place
}

// expect-stdout map-lookup-cache: "true\n41\ntrue\nfalse\nfalse\ntrue\nfalse\n"
fn fx_map_lookup_cache() -> MIRProgram Never! {
    b := fx_builder()
    value_ty :: fx_i64()
    map_ty :: mir_type_from_kind(MIRTypeKind.Map{key: fx_int(), value: value_ty})
    ptr_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Ptr"), args: [MIRType]{value_ty}})
    lookup_ty :: mir_type_from_kind(MIRTypeKind.Option{inner: ptr_ty})
    cache_ty :: mir_type_from_kind(MIRTypeKind.Option{inner: lookup_ty})
    map :: fx_local(&b, "map", map_ty, mir_owned_ownership())
    key :: fx_int_const(&b, 7)
    missing :: fx_int_const(&b, 9)
    value :: fx_i64_const(&b, 41)
    built :: fx_owned(&b, map_ty, MIROperation.BuildMap{entries: [MIRMapEntry]{MIRMapEntry{key: key, value: value}}})
    fx_do(&b, MIROperation.WritePlace{place: map, value: built})
    hit_cache :: fx_local(&b, "hit_cache", cache_ty, mir_owned_ownership())
    miss_cache :: fx_local(&b, "miss_cache", cache_ty, mir_owned_ownership())
    empty :: fx_owned(&b, cache_ty, MIROperation.Absent)
    fx_do(&b, MIROperation.WritePlace{place: hit_cache, value: empty})
    empty2 :: fx_owned(&b, cache_ty, MIROperation.Absent)
    fx_do(&b, MIROperation.WritePlace{place: miss_cache, value: empty2})
    hit :: fx_owned(&b, lookup_ty, MIROperation.MapLookup{map: map, key: key, cache: hit_cache})
    hit_present :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: hit})
    fx_print(&b, hit_present)
    selected :: fx_lookup_projection(&b, map, hit, false, value_ty)
    selected_value :: fx_copy(&b, value_ty, MIROperation.ReadPlace{place: selected})
    fx_print(&b, selected_value)
    again :: fx_owned(&b, lookup_ty, MIROperation.MapLookup{map: map, key: missing, cache: hit_cache})
    again_present :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: again})
    fx_print(&b, again_present)
    miss :: fx_owned(&b, lookup_ty, MIROperation.MapLookup{map: map, key: missing, cache: miss_cache})
    miss_present :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: miss})
    fx_print(&b, miss_present)
    missed_again :: fx_owned(&b, lookup_ty, MIROperation.MapLookup{map: map, key: key, cache: miss_cache})
    missed_again_present :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: missed_again})
    fx_print(&b, missed_again_present)
    optional_ty :: mir_type_from_kind(MIRTypeKind.Option{inner: value_ty})
    loop lookup in ([MIRValueID]{hit, miss}) {
        place :: fx_lookup_projection(&b, map, lookup, true, optional_ty)
        option :: fx_owned(&b, optional_ty, MIROperation.ReadPlace{place: place})
        present :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: option})
        fx_print(&b, present)
        fx_do(&b, MIROperation.Drop{value: option, kind: MIRDropKind.Value})
    }
    loop lookup in ([MIRValueID]{hit, again, miss, missed_again}) {
        fx_do(&b, MIROperation.Drop{value: lookup, kind: MIRDropKind.Value})
    }
    loop cache in ([MIRPlaceID]{hit_cache, miss_cache}) {
        owned :: fx_owned(&b, cache_ty, MIROperation.MovePlace{place: cache})
        fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    }
    map_value :: fx_owned(&b, map_ty, MIROperation.MovePlace{place: map})
    fx_do(&b, MIROperation.Drop{value: map_value, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}

// Value-range emission: Codegen/Expressions.jet:6669. Match the compiler's
// declaration (Types.jet:737): exact Int bounds and one Bool, not a cursor.
// expect-stdout range-values: "2\n3\n2\n3\n4\n"
fn fx_range_values() -> MIRProgram Never! {
    b := fx_builder()
    range_ty :: fx_named("Range")
    first :: fx_int_const(&b, 2)
    last :: fx_int_const(&b, 4)
    at := U64{0}
    loop exclusive in ([Bool]{true, false}) {
        range :: fx_owned(&b, range_ty, MIROperation.Range{start: first, end: last, exclusive: exclusive})
        at = fx_iter_loop(&b, range, fx_int(), false, None, None, at)
        fx_do(&b, MIROperation.Drop{value: range, kind: MIRDropKind.Value})
    }
    fx_block(&b, at, MIRTerminator.Return{value: None})
    p := fx_iter_program(b)
    &p.types.push(fx_type_def("Range", MIRTypeDefKind.Struct{fields: [MIRField]{
        fx_field("Range", "start", fx_int()), fx_field("Range", "end", fx_int()),
        fx_field("Range", "exclusive", fx_bool()),
    }, methods: [MIRFunctionID]{}}))
    p
}

fn fx_f32_op_constant(b: &FxBuilder, value: Float) -> MIRValueID Never! {
    fx_copy(&b, mir_type_from_kind(MIRTypeKind.Float32), MIROperation.Constant{value: MIRConstant.Float{value: value, f32: true, spelling: None}})
}

fn fx_f32_op(b: &FxBuilder, op: MIRBinaryOp, left: MIRValueID, right: MIRValueID, comparison: Bool) -> MIRValueID Never! {
    ty :: if comparison -> fx_bool() else -> mir_type_from_kind(MIRTypeKind.Float32)
    fx_copy(&b, ty, MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: left, right: right})
}

// F32 carriers occur in Cli/InspectShapes.jet:152 and generated typed codecs
// (Bootstrap/Host/EntryCodec.jet:612,628). Each operation stays binary32.
// expect-stdout f32-operations: "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\nfalse\ntrue\nfalse\n"
fn fx_f32_operations() -> MIRProgram Never! {
    b := fx_builder()
    six :: fx_f32_op_constant(&b, 6.0)
    two :: fx_f32_op_constant(&b, 2.0)
    ops :: [MIRBinaryOp]{.Add, .Sub, .Mul, .Div, .FloorDiv, .Rem, .Pow}
    expected :: [Float]{8.0, 4.0, 12.0, 3.0, 3.0, 0.0, 36.0}
    loop (index, op) in ops {
        actual :: fx_f32_op(&b, op, six, two, false)
        number :: fx_f32_op_constant(&b, expected[index])
        equal :: fx_f32_op(&b, .Eq, actual, number, true)
        fx_print(&b, equal)
    }
    neg :: fx_copy(&b, mir_type_from_kind(MIRTypeKind.Float32), MIROperation.Unary{op: MIRUnaryOp.Neg, value: six})
    minus_six :: fx_f32_op_constant(&b, -6.0)
    neg_equal :: fx_f32_op(&b, .Eq, neg, minus_six, true)
    fx_print(&b, neg_equal)
    large :: fx_f32_op_constant(&b, 16777216.0)
    one :: fx_f32_op_constant(&b, 1.0)
    rounded :: fx_f32_op(&b, .Add, large, one, false)
    rounded_equal :: fx_f32_op(&b, .Eq, rounded, large, true)
    fx_print(&b, rounded_equal)
    zero :: fx_f32_op_constant(&b, 0.0)
    nan :: fx_f32_op(&b, .Div, zero, zero, false)
    nan_equal :: fx_f32_op(&b, .Eq, nan, nan, true)
    fx_print(&b, nan_equal)
    nan_not_equal :: fx_f32_op(&b, .Ne, nan, nan, true)
    fx_print(&b, nan_not_equal)
    nan_less :: fx_f32_op(&b, .Lt, nan, zero, true)
    fx_print(&b, nan_less)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}
