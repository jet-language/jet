// Real typed-MIR Atomic witnesses. Native execution requires the accepted
// 092e36256/417ce17ff/1a0bce583/6b97e269b runtime packet. Owned Int leak-count
// execution additionally requires NativeFeed5's facts + NativeSlice6 consumer
// and the prevailing record Int glue 36b1afbfc; no fake counters/providers.
use jet_foundation.[MIRAccess, MIRCallArg, MIRConstant, MIRCopyFact, MIRDropKind, MIRField, MIRFieldValue, MIRForeign, MIRFunction, MIRFunctionID, MIROperation, MIRPreludeABI, MIRPreludeFamily, MIRPreludeTypeArg, MIRProgram, MIRSemanticOp, MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRValueID, mir_field_id, mir_function_id, mir_nominal_ref, mir_owned_ownership, mir_type_from_kind]

fn fx_atomic_type(scalar: MIRType) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Atomic"), args: [MIRType]{scalar}})
}

fn fx_atomic_scalar(b: &FxBuilder, scalar: MIRType, value: Int) -> MIRValueID Never! {
    constant :: if scalar.kind == .Bool -> MIRConstant.Bool{value: value != 0} else -> MIRConstant.Int{value: value, width: None, spelling: None}
    if scalar.kind == .Int -> return fx_owned(&b, scalar, MIROperation.Constant{value: constant})
    fx_copy(&b, scalar, MIROperation.Constant{value: constant})
}

fn fx_atomic_new(b: &FxBuilder, scalar: MIRType, value: Int, fallible: Bool) -> MIRValueID Never! {
    input :: fx_atomic_scalar(&b, scalar, value)
    atomic_ty :: fx_atomic_type(scalar)
    result :: if fallible -> mir_type_from_kind(MIRTypeKind.Result{ok: atomic_ty, err: fx_named("AllocError")}) else -> atomic_ty
    fx_owned(&b, result, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("::JetAtomic", if fallible -> "try_new" else -> "new"), args: [MIRCallArg]{fx_arg(input, MIRAccess.Move)}, owner_type_args: [MIRPreludeTypeArg]{MIRPreludeTypeArg.Type{ty: scalar}}, type_args: [MIRType]{}}})
}

fn fx_atomic_method(b: &FxBuilder, member: String, cell: MIRValueID, args: [MIRValueID], result: MIRType) -> MIRValueID Never! {
    fx_owned(&b, result, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.mem", member), receiver: cell, receiver_place: None, args: args, aggregate_fields: None}})
}

fn fx_atomic_drop(b: &FxBuilder, value: MIRValueID) Never! {
    fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
}

fn fx_atomic_print(b: &FxBuilder, value: MIRValueID) Never! {
    fx_print(&b, value)
    fx_atomic_drop(&b, value)
}

fn fx_atomic_program(b: FxBuilder, types: [MIRTypeDef]) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
    &p.types.push(fx_type_def("AllocError", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("AllocError", "requested_bytes", fx_int()), fx_field("AllocError", "allocator", fx_string())}, methods: [MIRFunctionID]{}}))
    members :: [String]{"load", "observe", "store", "publish", "add", "try_add", "compare_exchange"}
    loop member in members -> &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.mem", member, "jet_atomic_{member}", if member == "load" || member == "observe" -> 1 else if member == "compare_exchange" -> 3 else -> 2, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "::JetAtomic", "new", "JetAtomic::new", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "::JetAtomic", "try_new", "JetAtomic::try_new", 1, MIRPreludeABI.Value))
    p
}

// expect-stdout atomic-scalars: "false\ntrue\ntrue\nfalse\nfalse\ntrue\nfalse\n7\n9\n9\n12\ntrue\nfalse\n4\ntrue\n7\n7\n9\n9\n12\ntrue\nfalse\n4\ntrue\n7\n7\n9\n9\n12\ntrue\nfalse\n4\ntrue\n7\n7\n9\n9\n12\ntrue\nfalse\n4\ntrue\n7\n7\n9\n9\n12\ntrue\nfalse\n4\ntrue\n7\n"
// expect-runtime-only atomic-scalars: six canonical Atomic providers, owned Int drops
fn fx_atomic_scalars() -> MIRProgram Never! {
    b := fx_builder()
    scalars :: [MIRType]{fx_bool(), mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 32}), mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 32}), mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 64}), mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 64}), fx_int()}
    loop scalar in scalars {
        flag :: scalar.kind == .Bool
        cell :: fx_atomic_new(&b, scalar, if flag -> 0 else -> 7, false)
        loaded :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, scalar)
        fx_atomic_print(&b, loaded)
        nine :: fx_atomic_scalar(&b, scalar, if flag -> 1 else -> 9)
        fx_atomic_method(&b, "publish", cell, [MIRValueID]{nine}, fx_unit()).drop("publish")
        observed :: fx_atomic_method(&b, "observe", cell, [MIRValueID]{}, scalar)
        fx_atomic_print(&b, observed)
        if !flag {
            three :: fx_atomic_scalar(&b, scalar, 3)
            old :: fx_atomic_method(&b, "add", cell, [MIRValueID]{three}, scalar)
            fx_atomic_print(&b, old)
            added :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, scalar)
            fx_atomic_print(&b, added)
        }
        expected :: fx_atomic_scalar(&b, scalar, if flag -> 1 else -> 12)
        replacement :: fx_atomic_scalar(&b, scalar, if flag -> 0 else -> 4)
        exchanged :: fx_atomic_method(&b, "compare_exchange", cell, [MIRValueID]{expected, replacement}, fx_bool())
        fx_atomic_print(&b, exchanged)
        wrong :: fx_atomic_scalar(&b, scalar, if flag -> 1 else -> 12)
        unused :: fx_atomic_scalar(&b, scalar, if flag -> 1 else -> 5)
        unmatched :: fx_atomic_method(&b, "compare_exchange", cell, [MIRValueID]{wrong, unused}, fx_bool())
        fx_atomic_print(&b, unmatched)
        final_value :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, scalar)
        fx_atomic_print(&b, final_value)
        fx_atomic_drop(&b, cell)
        boxed :: fx_atomic_new(&b, scalar, if flag -> 0 else -> 7, true)
        boxed_ok :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: boxed})
        fx_print(&b, boxed_ok)
        lent :: fx_value(&b, fx_atomic_type(scalar), fx_borrow(), MIROperation.ResultValue{subject: boxed, ok: true})
        boxed_value :: fx_atomic_method(&b, "load", lent, [MIRValueID]{}, scalar)
        fx_atomic_print(&b, boxed_value)
        fx_atomic_drop(&b, boxed)
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_atomic_program(b, [MIRTypeDef]{})
}

// expect-stdout atomic-record: "4611686018427387913\n4611686018427387915\ntrue\n4611686018427387915\n4611686018427387918\n"
// expect-runtime-only atomic-record: actual aligned projected cell and ONE exact Int hazard domain
fn fx_atomic_record() -> MIRProgram Never! {
    b := fx_builder()
    atomic_ty :: fx_atomic_type(fx_int())
    holder_ty :: fx_named("AtomicHolder")
    flag :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    cell :: fx_atomic_new(&b, fx_int(), 4611686018427387913, false)
    holder :: fx_owned(&b, holder_ty, MIROperation.Struct{type_id: holder_ty.identity ?? panic("holder identity"), fields: [MIRFieldValue]{MIRFieldValue{field: mir_field_id("AtomicHolder.flag"), value: flag}, MIRFieldValue{field: mir_field_id("AtomicHolder.cell"), value: cell}}})
    place :: fx_local(&b, "holder", holder_ty, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: place, value: holder})
    projected :: fx_field_place(&b, place, "AtomicHolder.cell", atomic_ty)
    first :: fx_value(&b, atomic_ty, fx_borrow(), MIROperation.ReadPlace{place: projected})
    delta :: fx_atomic_scalar(&b, fx_int(), 2)
    old :: fx_atomic_method(&b, "add", first, [MIRValueID]{delta}, fx_int())
    fx_atomic_print(&b, old)
    second :: fx_value(&b, atomic_ty, fx_borrow(), MIROperation.ReadPlace{place: projected})
    observed :: fx_atomic_method(&b, "observe", second, [MIRValueID]{}, fx_int())
    fx_atomic_print(&b, observed)
    // Distinct spilled nodes with equal numerical values must match.
    expected :: fx_atomic_scalar(&b, fx_int(), 4611686018427387915)
    replacement :: fx_atomic_scalar(&b, fx_int(), 4611686018427387915)
    exchanged :: fx_atomic_method(&b, "compare_exchange", first, [MIRValueID]{expected, replacement}, fx_bool())
    fx_atomic_print(&b, exchanged)
    three :: fx_atomic_scalar(&b, fx_int(), 3)
    second_old :: fx_atomic_method(&b, "add", second, [MIRValueID]{three}, fx_int())
    fx_atomic_print(&b, second_old)
    final_value :: fx_atomic_method(&b, "load", first, [MIRValueID]{}, fx_int())
    fx_atomic_print(&b, final_value)
    fx_atomic_drop(&b, holder)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_atomic_program(b, [MIRTypeDef]{fx_type_def("AtomicHolder", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("AtomicHolder", "flag", fx_bool()), fx_field("AtomicHolder", "cell", atomic_ty)}, methods: [MIRFunctionID]{}})})
}

// expect-stdout atomic-try-add: "false\n48\nexact-int\n4611686018427387913\n1\ntrue\n4611686018427387913\n4611686018427387914\n"
// expect-runtime-only atomic-try-add: canonical fault probe, AllocError constructor and exact Int ownership unit
fn fx_atomic_try_add() -> MIRProgram Never! {
    b := fx_builder()
    raw :: fx_capacity_raw_type()
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_int(), err: fx_named("AllocError")})
    cell :: fx_atomic_new(&b, fx_int(), 4611686018427387913, false)
    one :: fx_capacity_raw(&b, 1)
    active :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    fx_capacity_provider_call(&b, U64{9100}, [MIRValueID]{one, active}, fx_unit()).drop("arm real fault")
    delta :: fx_atomic_scalar(&b, fx_int(), 1)
    refused :: fx_atomic_method(&b, "try_add", cell, [MIRValueID]{delta}, result_ty)
    refused_ok :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: refused})
    fx_print(&b, refused_ok)
    error :: fx_value(&b, fx_named("AllocError"), fx_borrow(), MIROperation.ResultValue{subject: refused, ok: false})
    bytes :: fx_copy(&b, fx_int(), MIROperation.Field{base: error, field: mir_field_id("AllocError.requested_bytes")})
    allocator :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.Field{base: error, field: mir_field_id("AllocError.allocator")})
    fx_print(&b, bytes)
    fx_print(&b, allocator)
    fx_atomic_drop(&b, refused)
    unchanged :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, fx_int())
    fx_atomic_print(&b, unchanged)
    index :: fx_capacity_raw(&b, 0)
    probes :: fx_capacity_provider_call(&b, U64{9101}, [MIRValueID]{index}, raw)
    fx_print(&b, probes)
    fx_capacity_provider_call(&b, U64{9102}, [MIRValueID]{}, fx_unit()).drop("clear real fault")
    delta2 :: fx_atomic_scalar(&b, fx_int(), 1)
    succeeded :: fx_atomic_method(&b, "try_add", cell, [MIRValueID]{delta2}, result_ty)
    succeeded_ok :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: succeeded})
    fx_print(&b, succeeded_ok)
    old :: fx_value(&b, fx_int(), fx_borrow(), MIROperation.ResultValue{subject: succeeded, ok: true})
    fx_print(&b, old)
    fx_atomic_drop(&b, succeeded)
    final_value :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, fx_int())
    fx_atomic_print(&b, final_value)
    fx_atomic_drop(&b, cell)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_atomic_program(b, [MIRTypeDef]{})
    p.foreign = [MIRForeign]{fx_capacity_foreign(U64{9100}, "jet_rt_fault_allocation_arm", [MIRType]{raw, fx_bool()}, None), fx_capacity_foreign(U64{9101}, "jet_rt_fault_allocation_fact", [MIRType]{raw}, Val(raw)), fx_capacity_foreign(U64{9102}, "jet_rt_fault_allocation_clear", [MIRType]{}, None)}
    p
}

fn fx_atomic_copy_rejected() -> Bool Never! {
    b := fx_builder()
    cell :: fx_atomic_new(&b, fx_int(), 7, false)
    duplicate :: fx_owned(&b, fx_atomic_type(fx_int()), MIROperation.Copy{value: cell, fact: MIRCopyFact.Explicit})
    fx_atomic_drop(&b, duplicate)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lowered :: lir_lower_entry(fx_atomic_program(b, [MIRTypeDef]{}), mir_function_id("run"))
    loop issue in lowered.issues { if issue.message.contains("non-Clone Atomic") -> return true }
    false
}

// expect-stdout atomic-int-leaks: "0\n"
// expect-runtime-only atomic-int-leaks: real allocator live bytes, requires NativeFeed5/NativeSlice6 OWNED Int unit
fn fx_atomic_int_leaks() -> MIRProgram Never! {
    b := fx_builder()
    raw :: fx_capacity_raw_type()
    // Warm the process-lifetime hazard record BEFORE counting: it is not a
    // publication leak and must not be concealed by resetting live counters.
    warm :: fx_atomic_new(&b, fx_int(), 4611686018427387913, false)
    clone :: fx_atomic_method(&b, "load", warm, [MIRValueID]{}, fx_int())
    fx_atomic_drop(&b, clone)
    fx_atomic_drop(&b, warm)
    counting :: fx_capacity_raw(&b, 1)
    unlimited :: fx_capacity_raw(&b, 0)
    fx_capacity_provider_call(&b, U64{9103}, [MIRValueID]{counting, unlimited}, fx_unit()).drop("enable real allocator accounting")
    cell :: fx_atomic_new(&b, fx_int(), 4611686018427387913, false)
    loaded :: fx_atomic_method(&b, "load", cell, [MIRValueID]{}, fx_int())
    fx_atomic_drop(&b, loaded)
    delta :: fx_atomic_scalar(&b, fx_int(), 4611686018427387913)
    old :: fx_atomic_method(&b, "add", cell, [MIRValueID]{delta}, fx_int())
    fx_atomic_drop(&b, old)
    fx_atomic_drop(&b, cell)
    live_index :: fx_capacity_raw(&b, 2)
    live :: fx_capacity_provider_call(&b, U64{9105}, [MIRValueID]{live_index}, raw)
    system :: fx_capacity_raw(&b, 0)
    fx_capacity_provider_call(&b, U64{9104}, [MIRValueID]{system, unlimited}, fx_unit()).drop("restore only after measuring publication/OLD retirement")
    fx_print(&b, live)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    p := fx_atomic_program(b, [MIRTypeDef]{})
    p.foreign = [MIRForeign]{fx_capacity_foreign(U64{9103}, "jet_rt_program_allocator_configure", [MIRType]{raw, raw}, None), fx_capacity_foreign(U64{9104}, "jet_rt_program_allocator_restore", [MIRType]{raw, raw}, None), fx_capacity_foreign(U64{9105}, "jet_rt_program_allocator_fact", [MIRType]{raw}, Val(raw))}
    p
}
