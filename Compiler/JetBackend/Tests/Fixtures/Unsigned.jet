// Unsigned fixed-word MIR and dirty System V Bool boundary fixtures.
use jet_foundation.[
    MIRAccess, MIRBinaryDispatch, MIRBinaryOp, MIRBinaryOverflow, MIRBlockID,
    MIRCallArg, MIRCallee, MIRConstant, MIRFunction, MIRIntegerWidth,
    MIROperation, MIRProgram, MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind,
    MIRValueID, mir_copy_ownership, mir_function_id, mir_type_from_kind,
]
use jet_backend.[
    LIRBlock, LIRBlockID, LIRCallee, LIRCallConv,
    LIRCondition, LIRData, LIRDataID, LIRDrop, LIRFunction, LIRFunctionID, LIRInst,
    LIRJumpTarget, LIRLayout, LIRModule, LIRSignature, LIRSignatureID,
    LIRTerminator, LIRValue, LIRValueID, X64Alu, X64CompiledFunction,
    X64ExecutableResult, X64Reloc, X64RelocTarget, elf64_static_executable,
    lir_layout_bool, lir_layout_pointer, lir_layout_word, x64_alu_ri, x64_call_rel32,
    x64_compile_module, x64_image_runtime, x64_link_text, x64_mov_ri,
    x64_mov_rr, x64_pop, x64_push, x64_ret, x64_syscall,
]

fn fx_u64() -> MIRType Never! { mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 64}) }

// Negative Int constants carry the same 64 bits as U64 high-bit literals.
fn fx_u64_const(b: &FxBuilder, bits: Int) -> MIRValueID Never! {
    fx_copy(&b, fx_u64(), MIROperation.Constant{value: MIRConstant.Int{value: bits, width: Val(MIRIntegerWidth{signed: false, bits: 64}), spelling: None}})
}

fn fx_u64_op(b: &FxBuilder, op: MIRBinaryOp, left: MIRValueID, right: MIRValueID) -> MIRValueID Never! {
    fx_copy(&b, fx_u64(), MIROperation.Binary{op: op, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Trap, left: left, right: right})
}

fn fx_unsigned_call(b: &FxBuilder, name: String, result: MIRType, args: [MIRValueID]) -> MIRValueID Never! {
    call_args := [MIRCallArg]{}
    loop arg in args -> &call_args.push(fx_arg(arg, MIRAccess.Read))
    fx_copy(&b, result, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id(name)}, args: call_args, type_args: [MIRType]{}})
}

fn fx_unsigned_binary_function(name: String, op: MIRBinaryOp) -> MIRFunction Never! {
    b := fx_builder()
    a :: fx_param(&b, "a", fx_u64(), mir_copy_ownership())
    c :: fx_param(&b, "b", fx_u64(), mir_copy_ownership())
    result :: fx_u64_op(&b, op, a, c)
    fx_block(&b, 0, MIRTerminator.Return{value: Val(result)})
    fx_function(name, b, fx_u64())
}

// fn larger(a: U64, b: U64) -> Bool { a > b }
// fn branch(a: U64, b: U64) -> U64 { if a > b -> U64{9} else -> U64{7} }
// fn run() {
//     print(larger(U64.MAX, U64{0})); print(U64.MAX)
//     print(U64.MAX == U64.MAX); print(U64.MAX < U64{0})
//     print(U64{0} <= U64.MAX); print(U64.MAX >= U64.MAX)
//     print(branch(U64.MAX, U64{0})); print(branch(U64{0}, U64.MAX))
//     print(I64{-1} < I64{0}); print(I64{-1})
//     print(U64.MAX / U64{2}); print(U64.MAX % U64{2})
//     print(U64.MAX / U64.MAX); print(U64.MAX % U64.MAX)
//     print(U64.MAX >> U64{63}); print(U64{0}); print(U64{1} << U64{63})
//     print(U64{9223372036854775807} + U64{1})
//     print(U64{4611686018427387904} * U64{2})
//     print(U64.MAX - U64{1})
// }
// expect-stdout unsigned: "true\n18446744073709551615\ntrue\nfalse\ntrue\ntrue\n9\n7\ntrue\n-1\n9223372036854775807\n1\n1\n0\n1\n0\n9223372036854775808\n9223372036854775808\n9223372036854775808\n18446744073709551614\n"
fn fx_unsigned() -> MIRProgram Never! {
    larger := fx_builder()
    a :: fx_param(&larger, "a", fx_u64(), mir_copy_ownership())
    b :: fx_param(&larger, "b", fx_u64(), mir_copy_ownership())
    gt :: fx_compare(&larger, MIRBinaryOp.Gt, a, b)
    fx_block(&larger, 0, MIRTerminator.Return{value: Val(gt)})

    branch := fx_builder()
    x :: fx_param(&branch, "a", fx_u64(), mir_copy_ownership())
    y :: fx_param(&branch, "b", fx_u64(), mir_copy_ownership())
    test :: fx_compare(&branch, MIRBinaryOp.Gt, x, y)
    fx_block(&branch, 0, MIRTerminator.Branch{condition: test, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    nine :: fx_u64_const(&branch, 9)
    fx_block(&branch, 1, MIRTerminator.Return{value: Val(nine)})
    seven :: fx_u64_const(&branch, 7)
    fx_block(&branch, 2, MIRTerminator.Return{value: Val(seven)})

    r := fx_builder()
    max :: fx_u64_const(&r, -1)
    zero :: fx_u64_const(&r, 0)
    one :: fx_u64_const(&r, 1)
    two :: fx_u64_const(&r, 2)
    called :: fx_unsigned_call(&r, "larger", fx_bool(), [MIRValueID]{max, zero})
    fx_print(&r, called)
    fx_print(&r, max)
    eq :: fx_compare(&r, MIRBinaryOp.Eq, max, max)
    fx_print(&r, eq)
    lt :: fx_compare(&r, MIRBinaryOp.Lt, max, zero)
    fx_print(&r, lt)
    le :: fx_compare(&r, MIRBinaryOp.Le, zero, max)
    fx_print(&r, le)
    ge :: fx_compare(&r, MIRBinaryOp.Ge, max, max)
    fx_print(&r, ge)
    taken :: fx_unsigned_call(&r, "branch", fx_u64(), [MIRValueID]{max, zero})
    fx_print(&r, taken)
    not_taken :: fx_unsigned_call(&r, "branch", fx_u64(), [MIRValueID]{zero, max})
    fx_print(&r, not_taken)
    negative :: fx_i64_const(&r, -1)
    signed_zero :: fx_i64_const(&r, 0)
    signed_lt :: fx_compare(&r, MIRBinaryOp.Lt, negative, signed_zero)
    fx_print(&r, signed_lt)
    fx_print(&r, negative)
    quotient :: fx_unsigned_call(&r, "udiv", fx_u64(), [MIRValueID]{max, two})
    fx_print(&r, quotient)
    remainder :: fx_unsigned_call(&r, "urem", fx_u64(), [MIRValueID]{max, two})
    fx_print(&r, remainder)
    max_quotient :: fx_unsigned_call(&r, "udiv", fx_u64(), [MIRValueID]{max, max})
    fx_print(&r, max_quotient)
    max_remainder :: fx_unsigned_call(&r, "urem", fx_u64(), [MIRValueID]{max, max})
    fx_print(&r, max_remainder)
    count :: fx_u64_const(&r, 63)
    shifted :: fx_unsigned_call(&r, "ushr", fx_u64(), [MIRValueID]{max, count})
    fx_print(&r, shifted)
    fx_print(&r, zero)
    high :: fx_u64_op(&r, MIRBinaryOp.Shl, one, count)
    fx_print(&r, high)
    signed_max :: fx_u64_const(&r, 9223372036854775807)
    sum :: fx_u64_op(&r, MIRBinaryOp.Add, signed_max, one)
    fx_print(&r, sum)
    quarter :: fx_u64_const(&r, 4611686018427387904)
    product :: fx_u64_op(&r, MIRBinaryOp.Mul, quarter, two)
    fx_print(&r, product)
    difference :: fx_u64_op(&r, MIRBinaryOp.Sub, max, one)
    fx_print(&r, difference)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{
        fx_function("larger", larger, fx_bool()), fx_function("branch", branch, fx_u64()),
        fx_unsigned_binary_function("udiv", MIRBinaryOp.Div),
        fx_unsigned_binary_function("urem", MIRBinaryOp.Rem),
        fx_unsigned_binary_function("ushr", MIRBinaryOp.Shr),
        fx_function("run", r, fx_unit()),
    }, [MIRTypeDef]{})
}

fn fx_unsigned_failure(op: MIRBinaryOp, left: Int, right: Int) -> MIRProgram Never! {
    r := fx_builder()
    a :: fx_u64_const(&r, left)
    b :: fx_u64_const(&r, right)
    result :: fx_unsigned_call(&r, "operation", fx_u64(), [MIRValueID]{a, b})
    fx_print(&r, result)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_unsigned_binary_function("operation", op), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(U64.MAX + U64{1}) }
// expect-stdout unsigned-add-overflow: ""
// expect-exit unsigned-add-overflow: 70
fn fx_unsigned_add_overflow() -> MIRProgram Never! { fx_unsigned_failure(MIRBinaryOp.Add, -1, 1) }

// fn run() { print(U64{0} - U64{1}) }
// expect-stdout unsigned-sub-overflow: ""
// expect-exit unsigned-sub-overflow: 70
fn fx_unsigned_sub_overflow() -> MIRProgram Never! { fx_unsigned_failure(MIRBinaryOp.Sub, 0, 1) }

// fn run() { print(U64.MAX * U64{2}) }
// expect-stdout unsigned-mul-overflow: ""
// expect-exit unsigned-mul-overflow: 70
fn fx_unsigned_mul_overflow() -> MIRProgram Never! { fx_unsigned_failure(MIRBinaryOp.Mul, -1, 2) }

// fn run() { print(U64.MAX / U64{0}) }
// expect-stdout unsigned-div-zero: ""
// expect-exit unsigned-div-zero: 70
fn fx_unsigned_div_zero() -> MIRProgram Never! { fx_unsigned_failure(MIRBinaryOp.Div, -1, 0) }

// fn run() { print(U64.MAX % U64{0}) }
// expect-stdout unsigned-rem-zero: ""
// expect-exit unsigned-rem-zero: 70
fn fx_unsigned_rem_zero() -> MIRProgram Never! { fx_unsigned_failure(MIRBinaryOp.Rem, -1, 0) }

// Foreign ABI boundary, not expressible by an all-Jet Bool call:
// choose(false, true, false, true, false, true, false) returns 9, otherwise 7.
// Keep all seven Bools live across pressure(), checking the first argument
// last: only five callee-saved registers exist, so it must spill. Argument
// seven is imported from the stack. The driver supplies 0x100/0x101 words.
// expect-stdout bool-abi: "9\n"
// expect-static-only bool-abi
fn fx_bool_abi_module() -> LIRModule Never! {
    values := [LIRValue]{}
    params := [LIRValueID]{}
    layouts := [LIRLayout]{}
    loop index in 0..<7 {
        id :: LIRValueID{value: index}
        &values.push(LIRValue{id: id, layout: lir_layout_bool(), drop: LIRDrop.Trivial, jet_type: None})
        &params.push(id)
        &layouts.push(lir_layout_bool())
    }
    blocks := [LIRBlock]{}
    insts := [LIRInst]{LIRInst.Call{dst: None, signature: LIRSignatureID{value: 1}, callee: LIRCallee.Function{id: LIRFunctionID{value: 1}}, args: [LIRValueID]{}}}
    loop step in 0..<7 {
        position :: if step == 6 -> 0 else -> step + 1
        expected :: LIRValueID{value: values.len()}
        &values.push(LIRValue{id: expected, layout: lir_layout_bool(), drop: LIRDrop.Trivial, jet_type: None})
        test :: LIRValueID{value: values.len()}
        &values.push(LIRValue{id: test, layout: lir_layout_bool(), drop: LIRDrop.Trivial, jet_type: None})
        &insts.push(LIRInst.Const{dst: expected, value: position % 2})
        &insts.push(LIRInst.Compare{dst: test, condition: LIRCondition.Eq, left: params[position], right: expected})
        &blocks.push(LIRBlock{id: LIRBlockID{value: step}, params: if step == 0 -> params else -> [LIRValueID]{}, insts: insts, terminator: LIRTerminator.Branch{condition: test, then_target: LIRJumpTarget{block: LIRBlockID{value: step + 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 8}, args: [LIRValueID]{}}}})
        insts = [LIRInst]{}
    }
    // Success reads the second word via a dynamic byte offset, covering
    // PointerAdd followed by Load without changing Load's constant offsets.
    base :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: base, layout: lir_layout_pointer(), drop: LIRDrop.Trivial, jet_type: None})
    offset :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: offset, layout: lir_layout_word(), drop: LIRDrop.Trivial, jet_type: None})
    address :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: address, layout: lir_layout_pointer(), drop: LIRDrop.Trivial, jet_type: None})
    result :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: result, layout: lir_layout_word(), drop: LIRDrop.Trivial, jet_type: None})
    &blocks.push(LIRBlock{id: LIRBlockID{value: 7}, params: [LIRValueID]{}, insts: [LIRInst]{
        LIRInst.DataAddress{dst: base, data: LIRDataID{value: 0}},
        LIRInst.Const{dst: offset, value: 8},
        LIRInst.PointerAdd{dst: address, base: base, offset: offset},
        LIRInst.Load{dst: result, base: address, offset: 0},
    }, terminator: LIRTerminator.Return{value: Val(result)}})
    failure :: LIRValueID{value: values.len()}
    &values.push(LIRValue{id: failure, layout: lir_layout_word(), drop: LIRDrop.Trivial, jet_type: None})
    &blocks.push(LIRBlock{id: LIRBlockID{value: 8}, params: [LIRValueID]{}, insts: [LIRInst]{LIRInst.Const{dst: failure, value: 7}}, terminator: LIRTerminator.Return{value: Val(failure)}})
    LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: LIRCallConv.SystemV, params: layouts, result: Val(lir_layout_word())},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: LIRCallConv.SystemV, params: [LIRLayout]{}, result: None},
    }, functions: [LIRFunction]{
        LIRFunction{id: LIRFunctionID{value: 0}, name: "choose", signature: LIRSignatureID{value: 0}, values: values, blocks: blocks},
        LIRFunction{id: LIRFunctionID{value: 1}, name: "pressure", signature: LIRSignatureID{value: 1}, values: [LIRValue]{}, blocks: [LIRBlock]{LIRBlock{id: LIRBlockID{value: 0}, params: [LIRValueID]{}, insts: [LIRInst]{}, terminator: LIRTerminator.Return{value: None}}}},
    }, data: [LIRData]{LIRData{id: LIRDataID{value: 0}, align: 8, bytes: [U8]{U8{7}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{9}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}}, relocs: [LIRDataReloc]{}}}}
}

fn fx_bool_abi_driver() -> X64CompiledFunction Never! {
    code := [U8]{}
    relocs := [X64Reloc]{}
    // Callable System V driver: preserve rbx; after pushing it rsp is aligned.
    x64_push(&code, 3)
    x64_mov_ri(&code, 0, 0x100)
    // Seventh argument occupies the first stack slot (not the padding slot).
    // Push twice instead of a word store: the lower slot is the argument.
    x64_push(&code, 0)
    x64_push(&code, 0)
    registers :: [Int]{7, 6, 2, 1, 8, 9}
    loop (index, reg) in registers -> x64_mov_ri(&code, reg, 0x100 + index % 2)
    choose_at :: x64_call_rel32(&code)
    &relocs.push(X64Reloc{at: choose_at, target: X64RelocTarget.Function{id: LIRFunctionID{value: 0}}})
    x64_alu_ri(&code, X64Alu.Add, 4, 16)
    x64_mov_rr(&code, 7, 0)
    text_at :: x64_call_rel32(&code)
    &relocs.push(X64Reloc{at: text_at, target: X64RelocTarget.Runtime{symbol: "jet_rt_i64_to_string"}})
    x64_mov_rr(&code, 3, 0)
    x64_mov_rr(&code, 7, 0)
    x64_mov_ri(&code, 6, 1)
    print_at :: x64_call_rel32(&code)
    &relocs.push(X64Reloc{at: print_at, target: X64RelocTarget.Runtime{symbol: "jet_term_write_stdout_line"}})
    x64_mov_rr(&code, 7, 3)
    drop_at :: x64_call_rel32(&code)
    &relocs.push(X64Reloc{at: drop_at, target: X64RelocTarget.Runtime{symbol: "jet_rt_string_drop"}})
    x64_pop(&code, 3)
    x64_ret(&code)
    X64CompiledFunction{id: LIRFunctionID{value: 2}, name: "dirty_bool_driver", code: code, relocs: relocs}
}

fn fx_bool_abi_executable() -> X64ExecutableResult Never! {
    choose_module :: fx_bool_abi_module()
    compiled :: x64_compile_module(choose_module)
    if compiled.errors.len() > 0 -> return X64ExecutableResult{bytes: [U8]{}, errors: compiled.errors}
    code := [U8]{}
    at :: x64_call_rel32(&code)
    x64_mov_ri(&code, 7, 0)
    x64_mov_ri(&code, 0, 231)
    x64_syscall(&code)
    functions := [X64CompiledFunction]{X64CompiledFunction{id: LIRFunctionID{value: -1}, name: "_start", code: code, relocs: [X64Reloc]{X64Reloc{at: at, target: X64RelocTarget.Function{id: LIRFunctionID{value: 2}}}}}}
    loop function in compiled.functions -> &functions.push(function)
    &functions.push(fx_bool_abi_driver())
    linked := x64_link_text(functions, x64_image_runtime(), choose_module.data, true)
    if linked.errors.len() > 0 -> return X64ExecutableResult{bytes: [U8]{}, errors: linked.errors}
    x64_link_static_text(&linked)
    X64ExecutableResult{bytes: elf64_static_executable(linked.text, linked.offsets[0], linked.align, linked.data_offset), errors: [String]{}}
}
