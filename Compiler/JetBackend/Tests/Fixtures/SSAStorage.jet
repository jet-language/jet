// expect-stdout ssa-storage-temporary-first: "184467440737095516170\n184467440737095516170\n"
// expect-stdout ssa-storage-local-first: "184467440737095516170\n184467440737095516170\n"
// Schema-7 owning locals alias their existing SSA cell. Both place orders must
// see the same heap-width exact integer and retire exactly that one owner.
use jet_foundation.[MIRAccess, MIRBasicBlock, MIRBlockID, MIRConstant, MIRDropKind, MIRFunction, MIRLocalID, MIROperation, MIRPlace, MIRPlaceBase, MIRPlaceID, MIRProgram, MIRProjection, MIRTerminator, MIRTypeDef, MIRValueID, mir_copy_ownership, mir_ownership_from_access]

fn fx_ssa_temporary(b: &FxBuilder, value: MIRValueID) -> MIRPlaceID Never! {
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{id: place, span: fx_span(), ty: fx_int(), base: MIRPlaceBase.Temporary{value: value}, projections: [MIRProjection]{}, access: MIRAccess.Read, persist_key: None})
    place
}

fn fx_ssa_bound_storage(temporary_first: Bool) -> MIRProgram Never! {
    b := fx_builder()
    live :: fx_local(&b, "$ssa-live", fx_bool(), mir_copy_ownership())
    dead :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: false}})
    fx_do(&b, MIROperation.WritePlace{place: live, value: dead})
    owner :: fx_copy(&b, fx_int(), MIROperation.Constant{value: MIRConstant.BigInt{decimal: "184467440737095516170"}})
    temporary := MIRPlaceID{value: U64{0}}
    if temporary_first -> temporary = fx_ssa_temporary(&b, owner)
    storage :: fx_local(&b, "$ssa-owner", fx_int(), fx_copy_ownership(fx_int()))
    b.locals[b.locals.len() - 1].ssa_value = Val(owner)
    if !temporary_first -> temporary = fx_ssa_temporary(&b, owner)
    // The same canonical row supports the earlier borrows and cleanup move.
    loop index in 0..<b.places.len() {
        if b.places[index].id == storage -> b.places[index].access = MIRAccess.Move
    }
    alive :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    fx_do(&b, MIROperation.WritePlace{place: live, value: alive})
    from_temporary :: fx_value(&b, fx_int(), mir_ownership_from_access(MIRAccess.Read), MIROperation.ReadPlace{place: temporary})
    fx_print(&b, from_temporary)
    from_local :: fx_value(&b, fx_int(), mir_ownership_from_access(MIRAccess.Read), MIROperation.ReadPlace{place: storage})
    fx_print(&b, from_local)
    guard :: fx_copy(&b, fx_bool(), MIROperation.ReadPlace{place: live})
    fx_block(&b, U64{0}, MIRTerminator.Branch{condition: guard, then_target: MIRBlockID{value: U64{1}}, else_target: MIRBlockID{value: U64{2}}})
    cleared :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: false}})
    fx_do(&b, MIROperation.WritePlace{place: live, value: cleared})
    moved :: fx_owned(&b, fx_int(), MIROperation.MovePlace{place: storage})
    fx_do(&b, MIROperation.Drop{value: moved, kind: MIRDropKind.Value})
    fx_block(&b, U64{1}, MIRTerminator.Jump{target: MIRBlockID{value: U64{2}}})
    fx_block(&b, U64{2}, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", fx_unit(), b)}, ^[MIRTypeDef]{})
}

// Inspect the real lowering context rather than inventing a shadow ownership
// model: the flag and original owner are its only slots, in either place order.
fn fx_ssa_storage_checks() -> Bool Never! {
    loop temporary_first in [true, false] {
        p :: fx_ssa_bound_storage(temporary_first)
        function :: p.functions[0]
        m := LowerModule{
            signatures: [LIRSignature]{}, signature_rows: [String:Int]{},
            data: [LIRData]{}, data_rows: [String:Int]{}, static_rows: [String:Int]{},
            static_fixups: [LowerStaticFixup]{}, static_live: None,
            line_starts: [U64:[Int]]{}, source_rows: [U64:Int]{},
            mir_rows: [U64:Int]{}, mir_sources: [Int]{0}, comptime_budget: false,
            mir_signatures: [LIRSignatureID]{}, mir_results: [Int]{},
            glue_base: 1, glue: [LowerGlue]{}, glue_rows: [String:Int]{},
            issues: [LIRLoweringIssue]{},
        }
        signature :: lower_function_signature(p, &m, function)
        f := lower_new_function(LIRFunctionID{value: 0}, "run", signature, function.entry)
        c :: lower_context(p, &m, &f, function) ?? return false
        if c.slots.len() != 2 -> return false
        owner_local :: function.locals[1]
        owner :: owner_local.ssa_value ?? return false
        slot :: c.local_slots.get(owner_local.id.value) ?? return false
        if c.defined_slots.get(owner.value) != (Val(slot)) -> return false
        loop place in function.places {
            if place.base == .Temporary(value) {
                if value == owner && c.place_slots.get(place.id.value) != (Val(slot)) -> return false
            }
        }
    }
    true
}
