// A compiler-owned payload spells a source-owned Core nominal bare: the
// Dyn.DateTime payload is `ZonedDateTime` (JetCodegen Types.jet, Rust
// tir_to_mir_types.rs). That spelling is the Core declaration, so the payload's
// drop, clone and equality glue use its definition.
use jet_foundation.[
    MIRBinaryOp, MIRConstant, MIRCopyFact, MIRDropKind, MIREnumArg, MIRField,
    MIRFieldValue, MIRFunction, MIRFunctionID, MIROperation, MIRProgram,
    MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRValueID,
    MIRVariant, MIRVariantPayload, mir_field_id, mir_nominal_ref,
    mir_type_from_kind, mir_type_id,
]

FX_CORE_BARE_ZONED :: "<corelib>/Core/time::Core/time/time.jet::ZonedDateTime"

fn fx_core_bare_zoned(b: &FxBuilder, bare: MIRType, seconds: Int, zone: String) -> MIRValueID Never! {
    count :: fx_int_const(&b, seconds)
    name :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: zone}})
    fx_owned(&b, bare, MIROperation.Struct{type_id: mir_type_id(FX_CORE_BARE_ZONED), fields: [MIRFieldValue]{
        MIRFieldValue{field: mir_field_id("{FX_CORE_BARE_ZONED}.seconds"), value: count},
        MIRFieldValue{field: mir_field_id("{FX_CORE_BARE_ZONED}.zone"), value: name},
    }})
}

fn fx_core_bare_stamp(b: &FxBuilder, stamp: MIRType, zoned: MIRValueID) -> MIRValueID Never! {
    fx_owned(&b, stamp, MIROperation.Enum{type_id: mir_type_id("CoreBareStamp"), variant: "At", args: [MIREnumArg]{MIREnumArg{field: None, value: zoned, boxed: false}}})
}

// struct <corelib>/Core/time::Core/time/time.jet::ZonedDateTime { seconds: Int, zone: String }
// enum CoreBareStamp { At(ZonedDateTime) } // the payload spelled bare
// fn run() {
//     a :: CoreBareStamp.At(ZonedDateTime{5, "UTC"}); b :: copy a
//     c :: CoreBareStamp.At(ZonedDateTime{5, "Europe/Paris"})
//     print(a == b); print(a == c)
// }
// expect-stdout core-bare-name: "true\nfalse\n"
fn fx_core_bare_name() -> MIRProgram Never! {
    bare :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("ZonedDateTime"), args: [MIRType]{}})
    stamp :: fx_named("CoreBareStamp")
    zoned := fx_type_def(FX_CORE_BARE_ZONED, MIRTypeDefKind.Struct{fields: [MIRField]{fx_field(FX_CORE_BARE_ZONED, "seconds", fx_int()), fx_field(FX_CORE_BARE_ZONED, "zone", fx_string())}, methods: [MIRFunctionID]{}})
    zoned.name = "ZonedDateTime"
    types :: [MIRTypeDef]{
        zoned,
        fx_type_def("CoreBareStamp", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("At", MIRVariantPayload.Single{value: bare})}, methods: [MIRFunctionID]{}}),
    }
    b := fx_builder()
    first :: fx_core_bare_stamp(&b, stamp, fx_core_bare_zoned(&b, bare, 5, "UTC"))
    copied :: fx_owned(&b, stamp, MIROperation.Copy{value: first, fact: MIRCopyFact.Explicit})
    other :: fx_core_bare_stamp(&b, stamp, fx_core_bare_zoned(&b, bare, 5, "Europe/Paris"))
    fx_print(&b, fx_compare(&b, MIRBinaryOp.Eq, first, copied))
    fx_print(&b, fx_compare(&b, MIRBinaryOp.Eq, first, other))
    loop value in ([MIRValueID]{first, copied, other}) -> fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^types)
}
