// Function values and closures (Lower/Closures.jet): a named function as a
// value (through its thunk), a by-value capture and a by-reference capture
// the creating function reads back.
use jet_foundation.[
    MIRAccess, MIRBinaryOp, MIRBlockID, MIRCallArg, MIRCallee, MIRCaptureFacts, MIRCopyFact,
    MIRCaptureOperand, MIRCaptureParam, MIRCoreClosureKind, MIRDropKind, MIREnumArg, MIRFunction,
    MIRFunctionSignature, MIROperation, MIRPhiIncoming, MIRPlace, MIRPlaceBase, MIRPlaceID,
    MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRProjection, MIRSemanticOp, MIRSiteID, MIRTerminator, MIRType, MIRTypeDef,
    MIRTypeDefKind, MIRTypeKind, MIRValueID, MIRVariant, MIRVariantPayload, MIRFunctionID, mir_copy_ownership, mir_function_id,
    mir_owned_ownership, mir_ownership_from_access, mir_type_from_kind, mir_type_id,
]
use jet_backend.[lir_lower_entry, lir_lint_inst, lir_lint_module, lir_layout_pointer, lir_layout_word, lir_optimize_module, LIRInst, LIRCallee, LIRDrop]

fn fx_fn_int_type() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{fx_int()}, ret: Val(fx_int()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
}

fn fx_capture_facts() -> MIRCaptureFacts Never! {
    MIRCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}}
}

// A place whose root is the captured value `value` (a closure body's view
// of capture slot `value`'s Capture instruction).
fn fx_capture_place(b: &FxBuilder, value: MIRValueID, ty: MIRType, access: MIRAccess) -> MIRPlaceID Never! {
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{id: place, span: fx_span(), ty: ty, base: MIRPlaceBase.Capture{value: value}, projections: [MIRProjection]{}, access: access, persist_key: None})
    place
}

// fn add_one(n: Int) -> Int { n + 1 }
// fn apply(f: fn(Int) -> Int, n: Int) -> Int { f(n) }
// fn run() {
//     print(apply(add_one, 9))
//     base :: 5
//     print(apply((n: Int) -> n + base, 9))
//     total := 0
//     add :: (n: Int) -> { total += n }
//     add(2)
//     add(3)
//     print(total)
// }
// expect-stdout closures: "10\n14\n5\n"
fn fx_closures() -> MIRProgram Never! {
    fn_ty :: fx_fn_int_type()

    a := fx_builder()
    n :: fx_param(&a, "n", fx_int(), mir_copy_ownership())
    one :: fx_int_const(&a, 1)
    plus :: fx_int_op(&a, MIRBinaryOp.Add, "add", n, one)
    fx_block(&a, 0, MIRTerminator.Return{value: Val(plus)})

    y := fx_builder()
    f :: fx_param(&y, "f", fn_ty, mir_ownership_from_access(MIRAccess.Read))
    m :: fx_param(&y, "n", fx_int(), mir_copy_ownership())
    applied :: fx_copy(&y, fx_int(), MIROperation.IndirectCall{callee: f, args: [MIRCallArg]{fx_arg(m, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&y, 0, MIRTerminator.Return{value: Val(applied)})

    // (n: Int) -> n + base, base by value.
    lb := fx_builder()
    base_value :: fx_copy(&lb, fx_int(), MIROperation.Capture{slot: 0})
    base_place :: fx_capture_place(&lb, base_value, fx_int(), MIRAccess.Read)
    k :: fx_param(&lb, "n", fx_int(), mir_copy_ownership())
    base_now :: fx_copy(&lb, fx_int(), MIROperation.ReadPlace{place: base_place})
    sum :: fx_int_op(&lb, MIRBinaryOp.Add, "add", k, base_now)
    fx_block(&lb, 0, MIRTerminator.Return{value: Val(sum)})
    lambda_base := fx_function("lambda_base", lb, fx_int())
    lambda_base.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "base", span: fx_span(), ty: fx_int(), access: MIRAccess.Read, ownership: mir_owned_ownership(), place_only: false}}

    // (n: Int) -> { total += n }, total by reference.
    la := fx_builder()
    total_value :: fx_copy(&la, fx_int(), MIROperation.Capture{slot: 0})
    total_place :: fx_capture_place(&la, total_value, fx_int(), MIRAccess.Write)
    j :: fx_param(&la, "n", fx_int(), mir_copy_ownership())
    total_old :: fx_copy(&la, fx_int(), MIROperation.ReadPlace{place: total_place})
    total_new :: fx_int_op(&la, MIRBinaryOp.Add, "add", total_old, j)
    fx_do(&la, MIROperation.WritePlace{place: total_place, value: total_new})
    fx_block(&la, 0, MIRTerminator.Return{value: None})
    lambda_add := fx_function("lambda_add", la, fx_unit())
    lambda_add.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "total", span: fx_span(), ty: fx_int(), access: MIRAccess.Write, ownership: mir_ownership_from_access(MIRAccess.Write), place_only: false}}

    r := fx_builder()
    base :: fx_local(&r, "base", fx_int(), mir_copy_ownership())
    total :: fx_local(&r, "total", fx_int(), mir_copy_ownership())
    nine :: fx_int_const(&r, 9)
    named :: fx_owned(&r, fn_ty, MIROperation.Closure{function: mir_function_id("add_one"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    first :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("apply")}, args: [MIRCallArg]{fx_arg(named, MIRAccess.Read), fx_arg(nine, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&r, first)
    fx_do(&r, MIROperation.Drop{value: named, kind: MIRDropKind.Value})
    five :: fx_int_const(&r, 5)
    fx_do(&r, MIROperation.WritePlace{place: base, value: five})
    base_read :: fx_copy(&r, fx_int(), MIROperation.ReadPlace{place: base})
    adder :: fx_owned(&r, fn_ty, MIROperation.Closure{function: mir_function_id("lambda_base"), captures: [MIRCaptureOperand]{MIRCaptureOperand.Value{value: base_read}}, facts: fx_capture_facts()})
    twin :: fx_owned(&r, fn_ty, MIROperation.Copy{value: adder, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: adder, kind: MIRDropKind.Value})
    second :: fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("apply")}, args: [MIRCallArg]{fx_arg(twin, MIRAccess.Read), fx_arg(nine, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&r, second)
    fx_do(&r, MIROperation.Drop{value: twin, kind: MIRDropKind.Value})
    zero :: fx_int_const(&r, 0)
    fx_do(&r, MIROperation.WritePlace{place: total, value: zero})
    add :: fx_owned(&r, fn_ty, MIROperation.Closure{function: mir_function_id("lambda_add"), captures: [MIRCaptureOperand]{MIRCaptureOperand.Place{place: total}}, facts: fx_capture_facts()})
    two :: fx_int_const(&r, 2)
    _ := fx_copy(&r, fx_unit(), MIROperation.IndirectCall{callee: add, args: [MIRCallArg]{fx_arg(two, MIRAccess.Read)}, type_args: [MIRType]{}})
    three :: fx_int_const(&r, 3)
    _ := fx_copy(&r, fx_unit(), MIROperation.IndirectCall{callee: add, args: [MIRCallArg]{fx_arg(three, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_do(&r, MIROperation.Drop{value: add, kind: MIRDropKind.Value})
    total_now :: fx_copy(&r, fx_int(), MIROperation.ReadPlace{place: total})
    fx_print(&r, total_now)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("add_one", a, fx_int()), fx_function("apply", y, fx_int()), lambda_base, lambda_add, fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// Check the generated whole-class seam, not just the two provider helpers.
// Construction alone may store the initial count; clone/drop glue must never
// race by loading or storing offset 0 itself.
fn fx_closure_atomic_refs_check() -> Bool Never! {
    lowered :: lir_lower_entry(fx_closures(), mir_function_id("run"))
    if lowered.issues.len() != 0 -> return false
    retained := false
    retired := false
    loop function in lowered.lir.functions {
        if !function.name.starts_with("clone.") && !function.name.starts_with("drop.") -> next
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == {
                    .Call(_, _, callee, _) -> {
                        if callee == .Runtime(symbol) {
                            if symbol == "jet_rt_native_closure_retain" -> retained = true
                            if symbol == "jet_rt_native_closure_unref" -> retired = true
                        }
                    }
                    .Load(_, _, offset) -> { if offset == 0 -> return false }
                    .Store(_, offset, _) -> { if offset == 0 -> return false }
                    else -> {}
                }
            }
        }
    }
    retained && retired
}

// Both operand shapes target the same borrowing body. Value captures own
// their cells and survive a closure copy; Place captures keep the outer owner.
// expect-stdout closures-owned-borrow: "owned\nowned\nborrowed\nborrowed\n"
fn fx_closures_owned_borrow() -> MIRProgram Never! {
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    body := fx_builder()
    captured :: fx_value(&body, fx_string(), fx_borrow(), MIROperation.Capture{slot: 0})
    captured_place :: fx_capture_place(&body, captured, fx_string(), MIRAccess.Read)
    read :: fx_value(&body, fx_string(), fx_borrow(), MIROperation.ReadPlace{place: captured_place})
    fx_print(&body, read)
    fx_block(&body, 0, MIRTerminator.Return{value: None})
    target := fx_function("show_capture", body, fx_unit())
    target.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "text", span: fx_span(), ty: fx_string(), access: MIRAccess.Read, ownership: fx_borrow(), place_only: false}}
    b := fx_builder()
    text :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "owned"}})
    owned :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id("show_capture"), captures: [MIRCaptureOperand]{MIRCaptureOperand.Value{value: text}}, facts: fx_capture_facts()})
    twin :: fx_owned(&b, fn_ty, MIROperation.Copy{value: owned, fact: MIRCopyFact.Explicit})
    _ := fx_copy(&b, fx_unit(), MIROperation.IndirectCall{callee: owned, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    _ := fx_copy(&b, fx_unit(), MIROperation.IndirectCall{callee: twin, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_do(&b, MIROperation.Drop{value: twin, kind: MIRDropKind.Value})
    root :: fx_local(&b, "borrowed", fx_string(), mir_owned_ownership())
    outer :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "borrowed"}})
    fx_do(&b, MIROperation.WritePlace{place: root, value: outer})
    borrowed :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id("show_capture"), captures: [MIRCaptureOperand]{MIRCaptureOperand.Place{place: root}}, facts: fx_capture_facts()})
    _ := fx_copy(&b, fx_unit(), MIROperation.IndirectCall{callee: borrowed, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_do(&b, MIROperation.Drop{value: borrowed, kind: MIRDropKind.Value})
    after :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.ReadPlace{place: root})
    fx_print(&b, after)
    moved :: fx_owned(&b, fx_string(), MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: moved, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{target, fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}

// A Value operand captured with Write access owns mutable storage, not a
// borrowed scalar temporary, and each invocation observes previous writes.
// expect-stdout closures-owned-write: "5\n"
fn fx_closures_owned_write() -> MIRProgram Never! {
    a := fx_builder()
    captured :: fx_copy(&a, fx_int(), MIROperation.Capture{slot: 0})
    place :: fx_capture_place(&a, captured, fx_int(), MIRAccess.Write)
    n :: fx_param(&a, "n", fx_int(), mir_copy_ownership())
    old :: fx_copy(&a, fx_int(), MIROperation.ReadPlace{place: place})
    updated :: fx_int_op(&a, MIRBinaryOp.Add, "add", old, n)
    fx_do(&a, MIROperation.WritePlace{place: place, value: updated})
    fx_block(&a, 0, MIRTerminator.Return{value: Val(updated)})
    body := fx_function("owned_add", a, fx_int())
    body.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "total", span: fx_span(), ty: fx_int(), access: MIRAccess.Write, ownership: mir_ownership_from_access(MIRAccess.Write), place_only: false}}
    b := fx_builder()
    zero :: fx_int_const(&b, 0)
    callback :: fx_owned(&b, fx_fn_int_type(), MIROperation.Closure{function: body.id, captures: [MIRCaptureOperand]{MIRCaptureOperand.Value{value: zero}}, facts: fx_capture_facts()})
    two :: fx_int_const(&b, 2)
    _ := fx_copy(&b, fx_int(), MIROperation.IndirectCall{callee: callback, args: [MIRCallArg]{fx_arg(two, MIRAccess.Read)}, type_args: [MIRType]{}})
    three :: fx_int_const(&b, 3)
    sum :: fx_copy(&b, fx_int(), MIROperation.IndirectCall{callee: callback, args: [MIRCallArg]{fx_arg(three, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_print(&b, sum)
    fx_do(&b, MIROperation.Drop{value: callback, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{body, fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}

// guard transfers a closure box to a different drop obligation. The ordinary
// closure copy is released without invoking the callback; the guard runs once.
// expect-stdout scope-guard-reown: "body\ncleanup\n"
fn fx_scope_guard_reown() -> MIRProgram Never! {
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    a := fx_builder()
    cleanup :: fx_owned(&a, fx_string(), MIROperation.Constant{value: .String{value: "cleanup"}})
    fx_print(&a, cleanup)
    fx_do(&a, MIROperation.Drop{value: cleanup, kind: MIRDropKind.Value})
    fx_block(&a, 0, MIRTerminator.Return{value: None})
    b := fx_builder()
    callback :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id("cleanup"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    held :: fx_owned(&b, fn_ty, MIROperation.Copy{value: callback, fact: MIRCopyFact.Explicit})
    guard :: fx_owned(&b, fx_named("ScopeGuard"), MIROperation.Semantic{operation: MIRSemanticOp.CoreClosureCall{call: fx_prelude_id("core.mem.scope", "guard"), kind: MIRCoreClosureKind.Guard, values: [MIRValueID]{}, closure: Val(held), site: MIRSiteID{value: U64{0}}, label: ""}})
    fx_do(&b, MIROperation.Drop{value: callback, kind: MIRDropKind.Value})
    text :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "body"}})
    fx_print(&b, text)
    fx_do(&b, MIROperation.Drop{value: text, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: guard, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("cleanup", a, fx_unit()), fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}

fn fx_scope_guard_reown_checks() -> Bool Never! {
    lowered :: lir_lower_entry(fx_scope_guard_reown(), mir_function_id("run"))
    if lowered.issues.len() != 0 || lir_lint_module(lowered.lir).len() != 0 -> return false
    found := false
    loop function in lowered.lir.functions {
        loop block in function.blocks {
            loop inst in block.insts {
                if inst == .Reown(dst, src) {
                    found = true
                    // Ordinary Move must still reject the changed destructor.
                    move :: LIRInst.Move{dst: dst, src: src}
                    if lir_lint_inst(lowered.lir, function, move, lir_inst_uses(move)).len() == 0 -> return false
                    uses :: lir_inst_uses(inst)
                    bad := function.copy()
                    bad.values[src.value].layout = lir_layout_word()
                    if lir_lint_inst(lowered.lir, bad, inst, uses).len() == 0 -> return false
                    bad = function.copy()
                    bad.values[dst.value].layout = lir_layout_word()
                    if lir_lint_inst(lowered.lir, bad, inst, uses).len() == 0 -> return false
                    bad = function.copy()
                    bad.values[dst.value].drop = LIRDrop.Trivial
                    if lir_lint_inst(lowered.lir, bad, inst, uses).len() == 0 -> return false
                    if function.values[src.value].layout != lir_layout_pointer() -> return false
                }
            }
        }
    }
    optimized :: lir_optimize_module(^lowered.lir, 1)
    if lir_lint_module(optimized).len() != 0 -> return false
    kept := false
    loop function in optimized.functions {
        loop block in function.blocks {
            loop inst in block.insts {
                if inst == .Reown(_, _) -> kept = true
            }
        }
    }
    found && kept
}

// A named comparator (`&xs.sort_by(order)` with `fn order(..) -> Ordering
// Never!`, the self-host unit's `jet_cli_record_link_order`) checks the
// route's `Result<(), Never>`: the caller reads it with ResultIsOk. The sort
// defines that result as its Ok, as MIRRust's sort-then-Ok does.
// fn order(left: Int, right: Int) -> Ordering Never! { if left < right -> .Less else -> .Greater }
// fn run() { xs := [3, 1]; &xs.sort_by(order); print(true); print(xs[0]); print(xs[1]) }
// expect-stdout sort-compare-result: "true\n1\n3\n"
// expect-runtime-only sort-compare-result
fn fx_sort_compare_result() -> MIRProgram Never! {
    ordering :: fx_named("Ordering")
    c := fx_builder()
    left :: fx_param(&c, "left", fx_int(), mir_copy_ownership())
    right :: fx_param(&c, "right", fx_int(), mir_copy_ownership())
    less :: fx_compare(&c, MIRBinaryOp.Lt, left, right)
    fx_block(&c, 0, MIRTerminator.Branch{condition: less, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    before :: fx_copy(&c, ordering, MIROperation.Enum{type_id: mir_type_id("Ordering"), variant: "Less", args: [MIREnumArg]{}})
    fx_block(&c, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    after :: fx_copy(&c, ordering, MIROperation.Enum{type_id: mir_type_id("Ordering"), variant: "Greater", args: [MIREnumArg]{}})
    fx_block(&c, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    verdict :: fx_copy(&c, ordering, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 1}, value: before}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: after}}})
    fx_block(&c, 3, MIRTerminator.Return{value: Val(verdict)})

    ints :: fx_list_type(fx_int())
    b := fx_builder()
    three :: fx_int_const(&b, 3)
    one :: fx_int_const(&b, 1)
    built :: fx_owned(&b, ints, MIROperation.BuildList{values: [MIRValueID]{three, one}, trait_coercion: None})
    root :: fx_local(&b, "xs", ints, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: root, value: built})
    lent :: fx_value(&b, ints, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: root, access: MIRAccess.Write})
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{fx_int(), fx_int()}, ret: Val(ordering), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    callback :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id("order"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    outcome_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: fx_unit(), err: fx_named("Never")})
    outcome :: fx_owned(&b, outcome_ty, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: lent, args: [MIRCallArg]{fx_arg(callback, MIRAccess.Move)}, call: fx_prelude_id("core.list", "sort_by_compare")}})
    sorted :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: outcome})
    fx_print(&b, sorted)
    fx_do(&b, MIROperation.Drop{value: outcome, kind: MIRDropKind.Value})
    borrowed :: fx_value(&b, ints, fx_borrow(), MIROperation.ReadPlace{place: root})
    zero :: fx_int_const(&b, 0)
    first :: fx_list_index(&b, borrowed, zero, fx_int(), false)
    fx_print(&b, first)
    second_at :: fx_int_const(&b, 1)
    second :: fx_list_index(&b, borrowed, second_at, fx_int(), false)
    fx_print(&b, second)
    owned :: fx_owned(&b, ints, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: owned, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})

    p := fx_list_program(b)
    &p.functions.push(fx_function("order", c, ordering))
    p.types = [MIRTypeDef]{fx_type_def("Ordering", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("Less", MIRVariantPayload.Unit), fx_variant("Equal", MIRVariantPayload.Unit), fx_variant("Greater", MIRVariantPayload.Unit)}, methods: [MIRFunctionID]{}})}
    row := fx_prelude(MIRPreludeFamily.ClosureMethod, "core.list", "sort_by_compare", "jet_list_sort_by_compare", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask[0] = true
    &p.prelude_calls.push(row)
    p
}
