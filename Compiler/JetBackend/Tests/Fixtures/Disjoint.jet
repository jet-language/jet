use jet_foundation.[MIRAccess, MIRBinaryOp, MIRCallArg, MIRCaptureOperand, MIRCaptureParam, MIRDropKind, MIRFunctionSignature, MIROperation, MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRSemanticOp, MIRTerminator, MIRTupleField, MIRType, MIRTypeKind, MIRValueID, mir_copy_ownership, mir_function_id, mir_nominal_ref, mir_owned_ownership, mir_ownership_from_access, mir_type_from_kind]

fn fx_disjoint_view() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("ViewMut"), args: [MIRType]{fx_int()}})
}

fn fx_disjoint_values(b: &FxBuilder, values: [Int]) -> MIRValueID Never! {
    items := [MIRValueID]{}
    loop value in values -> &items.push(fx_int_const(&b, value))
    fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: items, trait_coercion: None})
}

fn fx_disjoint_verdict(b: &FxBuilder, result: MIRValueID) {
    verdict :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: result})
    fx_print(&b, verdict)
}

fn fx_disjoint_failure(b: &FxBuilder, result: MIRValueID) {
    error :: fx_value(&b, fx_string(), fx_borrow(), MIROperation.ResultValue{subject: result, ok: false})
    fx_print(&b, error)
}

fn fx_disjoint_drop(b: &FxBuilder, value: MIRValueID) {
    fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
}

// expect-stdout disjoint-split: "true\n[9, 2, 3, 4]\ntrue\ntrue\nsplit point -1 is outside 0..=4 for 4 items\nsplit point 5 is outside 0..=4 for 4 items\n"
fn fx_disjoint_split() -> MIRProgram Never! {
    b := fx_builder()
    ints :: fx_list_type(fx_int())
    view :: fx_disjoint_view()
    pair :: fx_tuple_type("DisjointPair", [MIRTupleField]{MIRTupleField{name: "left", ty: view}, MIRTupleField{name: "right", ty: view}})
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: pair, err: fx_string()})
    root :: fx_local(&b, "values", ints, mir_owned_ownership())
    xs :: fx_disjoint_values(&b, [Int]{1, 2, 3, 4})
    fx_do(&b, MIROperation.WritePlace{place: root, value: xs})
    source :: fx_value(&b, ints, fx_borrow(), MIROperation.ReadPlace{place: root})
    middle :: fx_int_const(&b, 2)
    split :: fx_list_method(&b, "split_write", source, Val(root), [MIRValueID]{middle}, result_ty, true)
    fx_disjoint_verdict(&b, split)
    parts :: fx_value(&b, pair, fx_borrow(), MIROperation.ResultValue{subject: split, ok: true})
    left :: fx_value(&b, view, fx_borrow(), MIROperation.Field{base: parts, field: fx_tuple_field_id(pair, "left")})
    left_root :: fx_local(&b, "left", view, fx_borrow())
    fx_do(&b, MIROperation.WritePlace{place: left_root, value: left})
    zero :: fx_int_const(&b, 0)
    cell :: fx_list_index_place(&b, left_root, zero, fx_int())
    nine :: fx_int_const(&b, 9)
    fx_do(&b, MIROperation.WritePlace{place: cell, value: nine})
    fx_print(&b, source)
    fx_disjoint_drop(&b, split)
    loop at in ([Int]{0, 4, -1, 5}) {
        bound :: fx_int_const(&b, at)
        tested :: fx_list_method(&b, "split_write", source, Val(root), [MIRValueID]{bound}, result_ty, true)
        if at < 0 || at > 4 -> fx_disjoint_failure(&b, tested) else -> fx_disjoint_verdict(&b, tested)
        fx_disjoint_drop(&b, tested)
    }
    finished :: fx_owned(&b, ints, MIROperation.MovePlace{place: root})
    fx_disjoint_drop(&b, finished)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_list_program(b)
    row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "split_write", "jet_split_write", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask[0] = true
    &program.prelude_calls.push(row)
    program
}

// Unsorted inputs preserve request order; empty succeeds; bounds precede
// duplicate checks, and the smallest duplicated index determines the error.
// expect-stdout disjoint-get: "true\n3\n1\ntrue\nduplicate index 0 overlaps itself\nindex 99 is outside 0..4 for 4 items\nindex -1 is outside 0..4 for 4 items\n"
fn fx_disjoint_get() -> MIRProgram Never! {
    b := fx_builder()
    ints :: fx_list_type(fx_int())
    view :: fx_disjoint_view()
    views :: fx_list_type(view)
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: views, err: fx_string()})
    root :: fx_local(&b, "values", ints, mir_owned_ownership())
    xs :: fx_disjoint_values(&b, [Int]{1, 2, 3, 4})
    fx_do(&b, MIROperation.WritePlace{place: root, value: xs})
    source :: fx_value(&b, ints, fx_borrow(), MIROperation.ReadPlace{place: root})
    loop requested in ([[Int]]{[Int]{2, 0}, [Int]{}, [Int]{2, 2, 0, 0}, [Int]{0, 0, 99}, [Int]{-1}}) {
        indices :: fx_disjoint_values(&b, requested)
        selected :: fx_list_method(&b, "get_disjoint_write", source, Val(root), [MIRValueID]{indices}, result_ty, true)
        if requested.len() == 0 || requested == ([Int]{2, 0}) {
            fx_disjoint_verdict(&b, selected)
            if requested.len() == 2 {
                windows :: fx_value(&b, views, fx_borrow(), MIROperation.ResultValue{subject: selected, ok: true})
                loop position in 0..<2 {
                    at :: fx_int_const(&b, position)
                    window :: fx_list_index(&b, windows, at, view, false)
                    zero :: fx_int_const(&b, 0)
                    item :: fx_list_index(&b, window, zero, fx_int(), false)
                    fx_print(&b, item)
                }
            }
        } else { fx_disjoint_failure(&b, selected) }
        fx_disjoint_drop(&b, selected)
        fx_disjoint_drop(&b, indices)
    }
    finished :: fx_owned(&b, ints, MIROperation.MovePlace{place: root})
    fx_disjoint_drop(&b, finished)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_list_program(b)
    row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", "get_disjoint_write", "jet_get_disjoint_write", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask = [Bool]{true, true}
    &program.prelude_calls.push(row)
    program
}

// expect-stdout disjoint-edit: "true\n1\n[9, 2, 8, 4]\nedit_disjoint needs exactly two indexes\n1\nduplicate index 0 overlaps itself\n1\nindex 99 is outside 0..4 for 4 items\n1\n"
fn fx_disjoint_edit() -> MIRProgram Never! {
    view :: fx_disjoint_view()
    callback_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{view, view}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    callback := fx_builder()
    counter :: fx_copy(&callback, fx_int(), MIROperation.Capture{slot: 0})
    counter_place :: fx_capture_place(&callback, counter, fx_int(), MIRAccess.Write)
    before :: fx_copy(&callback, fx_int(), MIROperation.ReadPlace{place: counter_place})
    one :: fx_int_const(&callback, 1)
    incremented :: fx_int_op(&callback, MIRBinaryOp.Add, "add", before, one)
    fx_do(&callback, MIROperation.WritePlace{place: counter_place, value: incremented})
    loop (position, name) in ([String]{"left", "right"}) {
        parameter :: fx_param(&callback, name, view, fx_borrow())
        local :: fx_local(&callback, name, view, fx_borrow())
        fx_do(&callback, MIROperation.WritePlace{place: local, value: parameter})
        zero :: fx_int_const(&callback, 0)
        cell :: fx_list_index_place(&callback, local, zero, fx_int())
        changed :: fx_int_const(&callback, if position == 0 -> 8 else -> 9)
        fx_do(&callback, MIROperation.WritePlace{place: cell, value: changed})
    }
    fx_block(&callback, 0, MIRTerminator.Return{value: None})
    body := fx_function("disjoint_edit", callback, fx_unit())
    body.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "counter", span: fx_span(), ty: fx_int(), access: MIRAccess.Write, ownership: mir_ownership_from_access(MIRAccess.Write), place_only: false}}
    b := fx_builder()
    ints :: fx_list_type(fx_int())
    root :: fx_local(&b, "values", ints, mir_owned_ownership())
    counter_root :: fx_local(&b, "counter", fx_int(), mir_copy_ownership())
    initial :: fx_int_const(&b, 0)
    fx_do(&b, MIROperation.WritePlace{place: counter_root, value: initial})
    xs :: fx_disjoint_values(&b, [Int]{1, 2, 3, 4})
    fx_do(&b, MIROperation.WritePlace{place: root, value: xs})
    source :: fx_value(&b, ints, fx_borrow(), MIROperation.ReadPlace{place: root})
    result_ty :: mir_type_from_kind(MIRTypeKind.Result{ok: mir_type_from_kind(MIRTypeKind.Tuple{fields: [MIRTupleField]{}}), err: fx_string()})
    loop requested in ([[Int]]{[Int]{2, 0}, [Int]{99}, [Int]{0, 0}, [Int]{99, 0}}) {
        indices :: fx_disjoint_values(&b, requested)
        capture :: MIRCaptureOperand.Place{place: counter_root}
        facts := fx_capture_facts()
        facts.needs_fn_mut = true
        facts.mutable = [String]{"counter"}
        closure :: fx_owned(&b, callback_ty, MIROperation.Closure{function: mir_function_id("disjoint_edit"), captures: [MIRCaptureOperand]{capture}, facts: facts})
        result :: fx_owned(&b, result_ty, MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: source, args: [MIRCallArg]{fx_arg(indices, MIRAccess.Read), fx_arg(closure, MIRAccess.Move)}, call: fx_prelude_id("core.collections", "edit_disjoint")}})
        if requested == ([Int]{2, 0}) -> fx_disjoint_verdict(&b, result) else -> fx_disjoint_failure(&b, result)
        calls :: fx_copy(&b, fx_int(), MIROperation.ReadPlace{place: counter_root})
        fx_print(&b, calls)
        if requested == ([Int]{2, 0}) -> fx_print(&b, source)
        fx_disjoint_drop(&b, result)
        fx_disjoint_drop(&b, indices)
    }
    finished :: fx_owned(&b, ints, MIROperation.MovePlace{place: root})
    fx_disjoint_drop(&b, finished)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_list_program(b)
    &program.functions.push(body)
    row := fx_prelude(MIRPreludeFamily.ClosureMethod, "core.collections", "edit_disjoint", "jet_edit_disjoint", 3, MIRPreludeABI.Value)
    row.signature.borrow_mask = [Bool]{true, true, false}
    &program.prelude_calls.push(row)
    program
}

// Pack-free admission gate: use the same production MIR as the native
// witnesses, lower all three bodies, and lint the resulting control flow.
fn fx_disjoint_lowering(name: String, program: MIRProgram) -> Bool {
    lowered :: lir_lower_entry(program, mir_function_id("run"))
    loop issue in lowered.issues -> print("{name}: {issue.message}")
    if lowered.issues.len() != 0 -> return false
    issues :: lir_lint_module(lowered.lir)
    loop issue in issues -> print("{name}: {issue.message}")
    issues.len() == 0
}

fn fx_disjoint_lowering_checks() -> Bool {
    fx_disjoint_lowering("split_write", fx_disjoint_split())
        && fx_disjoint_lowering("get_disjoint_write", fx_disjoint_get())
        && fx_disjoint_lowering("edit_disjoint", fx_disjoint_edit())
}
