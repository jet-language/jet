// TLS transport has no native implementation until the pending owner decision.
// Refuse before route lookup, including TLS leaves not present in the table.
// These are lowering findings reported by Cli/Host through registered E2104;
// they never reach an object/image writer and never supply a transport stub.
fn fx_tls_refusal_program(module_name: String, symbol: String, handle_method: Bool) -> MIRProgram Never! {
    row :: fx_prelude(MIRPreludeFamily.StaticPrelude, module_name, "fixture", symbol, 0, MIRPreludeABI.Value)
    b := fx_builder()
    if {
        handle_method -> {
            receiver :: fx_int_const(&b, 0)
            fx_do(
            &b,
            MIROperation.Semantic{
                operation: MIRSemanticOp.HandleMethod{
                    call: row.id,
                    receiver: receiver,
                    args: [MIRValueID]{},
                    frame_schedule: None,
                    frame_schedule_derivation: None,
                },
            },
            )
        }
        else -> {
            fx_do(
            &b,
            MIROperation.Semantic{
                operation: MIRSemanticOp.StaticPreludeCall{
                    call: row.id,
                    args: [MIRCallArg]{},
                    owner_type_args: [MIRPreludeTypeArg]{},
                    type_args: [MIRType]{},
                },
            },
            )
        }
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    program := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, ^[MIRTypeDef]{})
    program.prelude_calls = [MIRPreludeCall]{row}
    program
}

fn fx_report_tls_refusals(name: String) -> Bool {
    clean := true
    // Every symbol in the generated TLS route families is covered by one
    // predicate. Checking all rows also catches accidental omissions at tails.
    loop route in LOWER_RUNTIME_ROUTES {
        if route.symbol.starts_with("jet_net_tls_") || route.symbol.starts_with("jet_tls_read") || route.symbol.starts_with("jet_tls_write") || route.symbol.starts_with("jet_tls_close") {
            row :: fx_prelude(MIRPreludeFamily.StaticPrelude, "fixture", "tls", route.symbol, 0, MIRPreludeABI.Value)
            if !lower_tls_transport_route(row) -> clean = false
        }
    }
    // One actual lowering witness per family, through both route-call spines.
    families :: [String]{
        "jet_net_tls_read_bytes_deadline",
        "jet_net_tls_client",
        "jet_tls_read",
        "jet_tls_write_all",
        "jet_tls_close",
    }
    method_modes :: [Bool]{false, true}
    loop symbol in families {
        loop handle_method in method_modes {
            lowered :: lir_lower_entry(fx_tls_refusal_program("fixture", symbol, handle_method), mir_function_id("run"))
            if {
                lowered.issues.len() != 1 || lowered.entry != None -> clean = false
                lowered.issues[0].message != lower_tls_transport_message() -> clean = false
            }
        }
    }
    // Client module identity protects a transport even before its route is
    // generated. Pure configuration, ordinary HTTP and SMTP are not refused.
    new_tls :: fx_prelude(MIRPreludeFamily.StaticPrelude, "core.net.tls", "client", "new_tls_leaf", 0, MIRPreludeABI.Value)
    if !lower_tls_transport_route(new_tls) -> clean = false
    plain_routes :: [String]{"jet_net_tcp_read_bytes", "jet_http_client_send", "jet_mail_send", "jet_http_client_request_tls_timeout", "jet_tls_client_config_default", "jet_tls_root_certificates_from_pem", "jet_tls_client_identity_from_pem", "jet_http_srv_tls"}
    loop symbol in plain_routes {
        row :: fx_prelude(MIRPreludeFamily.StaticPrelude, "fixture", "plain", symbol, 0, MIRPreludeABI.Value)
        if lower_tls_transport_route(row) -> clean = false
    }
    tls_config :: fx_prelude(MIRPreludeFamily.StaticPrelude, "core.net.tls", "config", "jet_tls_client_config_default", 0, MIRPreludeABI.Value)
    if lower_tls_transport_route(tls_config) -> clean = false
    print(if clean -> "{name}: no image; {lower_tls_transport_message()}" else -> "{name}: refusal witnesses failed")
    clean
}
