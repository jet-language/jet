use jet_foundation.[
    MIRAccess, MIRDropKind, MIRFunction, MIRIndexKind, MIROperation,
    MIRPanicContext, MIRPanicLoc, MIRPanicLocal, MIRPlace, MIRPlaceID,
    MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRProjection,
    MIRSemanticOp, MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind, MIRValueID,
    mir_owned_ownership, mir_ownership_from_access, mir_type_from_kind,
]

fn fx_list_type(elem: MIRType) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.List{inner: elem})
}

fn fx_list_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    members :: [String]{"len", "is_empty", "list_push", "list_pop"}
    symbols :: [String]{"jet_list_len", "jet_list_is_empty", "jet_list_push", "jet_list_pop_kernel"}
    loop (index, member) in members {
        row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", member, symbols[index], if index == 2 -> 2 else -> 1, MIRPreludeABI.Value)
        row.signature.borrow_mask[0] = true
        &p.prelude_calls.push(row)
    }
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.list", "get", "jet_list_get", 4, MIRPreludeABI.Value))
    p
}

fn fx_list_index(b: &FxBuilder, list: MIRValueID, at: MIRValueID, elem: MIRType, owned: Bool) -> MIRValueID Never! {
    operation :: MIROperation.Index{
        call: fx_prelude_id("core.list", "get"), base: list, index: at,
        kind: MIRIndexKind.List, access: MIRAccess.Read,
        location: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0},
        context: MIRPanicContext{function: "run", source_line: "xs[i]", caret: 1, locals: [MIRPanicLocal]{}},
    }
    if owned -> fx_owned(&b, elem, operation) else -> fx_value(&b, elem, fx_borrow(), operation)
}

fn fx_list_method(b: &FxBuilder, member: String, receiver: MIRValueID, place: MIRPlaceID?, args: [MIRValueID], result: MIRType, owned: Bool) -> MIRValueID Never! {
    operation :: MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{
        call: fx_prelude_id("core.builtin", member), receiver: receiver,
        receiver_place: place, args: args, aggregate_fields: None,
    }}
    if owned -> fx_owned(&b, result, operation) else -> fx_copy(&b, result, operation)
}

fn fx_list_index_place(b: &FxBuilder, root: MIRPlaceID, at: MIRValueID, elem: MIRType) -> MIRPlaceID Never! {
    root_row := b.places[0]
    loop row in b.places {
        if row.id == root -> root_row = row
    }
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    &b.places.push(MIRPlace{
        id: place, span: fx_span(), ty: elem, base: root_row.base,
        projections: [MIRProjection]{MIRProjection.Index{
            kind: MIRIndexKind.List, index: at, call: fx_prelude_id("core.list", "get"),
            write_call: None, location: MIRPanicLoc{file: fx_source_file(), line: 3, column: 0},
            context: None, span: fx_span(),
        }}, access: MIRAccess.Write, persist_key: None,
    })
    place
}

// fn run() {
//   xs := [3, 1, 2]; print(xs.len()); print(xs[1]); xs[1] = 7;
//   print(xs[1]); xs.push(4); print(xs.len()); print(xs.is_empty());
//   strings := ["red", "blue"]; duplicate :: ~strings;
//   strings[0] = "green"; strings.drop();
//   print(duplicate[0]); held :: ~duplicate[1]; duplicate.drop(); print(held);
//   print(xs.pop()!); empty := [Int]{}; print(empty.is_empty());
//   absent :: empty.pop(); print(absent != None); empty_copy :: ~empty;
//   empty.drop(); empty_copy.push(9); print(empty_copy[0]);
// }
// expect-stdout lists: "3\n1\n7\n4\nfalse\nred\nblue\n4\ntrue\nfalse\n9\n"
fn fx_lists() -> MIRProgram Never! {
    b := fx_builder()
    ints :: fx_list_type(fx_int())
    root :: fx_local(&b, "xs", ints, mir_owned_ownership())
    three :: fx_int_const(&b, 3)
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    xs :: fx_owned(&b, ints, MIROperation.BuildList{values: [MIRValueID]{three, one, two}, trait_coercion: None})
    fx_do(&b, MIROperation.WritePlace{place: root, value: xs})
    len :: fx_list_method(&b, "len", xs, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, len)
    original :: fx_list_index(&b, xs, one, fx_int(), false)
    fx_print(&b, original)
    slot :: fx_list_index_place(&b, root, one, fx_int())
    seven :: fx_int_const(&b, 7)
    fx_do(&b, MIROperation.ReplacePlace{place: slot, value: seven})
    edited :: fx_list_index(&b, xs, one, fx_int(), false)
    fx_print(&b, edited)
    four :: fx_int_const(&b, 4)
    lent :: fx_value(&b, ints, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: root, access: MIRAccess.Write})
    _ := fx_list_method(&b, "list_push", lent, Val(root), [MIRValueID]{four}, fx_unit(), false)
    grown_len :: fx_list_method(&b, "len", xs, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, grown_len)
    is_empty :: fx_list_method(&b, "is_empty", xs, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, is_empty)

    strings :: fx_list_type(fx_string())
    text_root :: fx_local(&b, "strings", strings, mir_owned_ownership())
    red :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "red"}})
    blue :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "blue"}})
    text_list :: fx_owned(&b, strings, MIROperation.BuildList{values: [MIRValueID]{red, blue}, trait_coercion: None})
    fx_do(&b, MIROperation.WritePlace{place: text_root, value: text_list})
    duplicate :: fx_owned(&b, strings, MIROperation.Copy{value: text_list, fact: MIRCopyFact.Explicit})
    zero :: fx_int_const(&b, 0)
    text_slot :: fx_list_index_place(&b, text_root, zero, fx_string())
    green :: fx_owned(&b, fx_string(), MIROperation.Constant{value: .String{value: "green"}})
    fx_do(&b, MIROperation.ReplacePlace{place: text_slot, value: green})
    discarded :: fx_owned(&b, strings, MIROperation.MovePlace{place: text_root})
    fx_do(&b, MIROperation.Drop{value: discarded, kind: MIRDropKind.Value})
    borrowed :: fx_list_index(&b, duplicate, zero, fx_string(), false)
    fx_print(&b, borrowed)
    held :: fx_list_index(&b, duplicate, one, fx_string(), true)
    fx_do(&b, MIROperation.Drop{value: duplicate, kind: MIRDropKind.Value})
    fx_print(&b, held)
    fx_do(&b, MIROperation.Drop{value: held, kind: MIRDropKind.Value})

    optional :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_int()})
    popped :: fx_list_method(&b, "list_pop", lent, Val(root), [MIRValueID]{}, optional, true)
    last :: fx_copy(&b, fx_int(), MIROperation.OptionValue{subject: popped})
    fx_print(&b, last)
    fx_do(&b, MIROperation.Drop{value: popped, kind: MIRDropKind.Value})
    gone :: fx_owned(&b, ints, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: gone, kind: MIRDropKind.Value})

    empty_root :: fx_local(&b, "empty", ints, mir_owned_ownership())
    empty_list :: fx_owned(&b, ints, MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
    fx_do(&b, MIROperation.WritePlace{place: empty_root, value: empty_list})
    empty_flag :: fx_list_method(&b, "is_empty", empty_list, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, empty_flag)
    empty_lent :: fx_value(&b, ints, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: empty_root, access: MIRAccess.Write})
    absent :: fx_list_method(&b, "list_pop", empty_lent, Val(empty_root), [MIRValueID]{}, optional, true)
    some :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: absent})
    fx_print(&b, some)
    fx_do(&b, MIROperation.Drop{value: absent, kind: MIRDropKind.Value})
    duplicate_empty :: fx_owned(&b, ints, MIROperation.Copy{value: empty_list, fact: MIRCopyFact.Explicit})
    emptied :: fx_owned(&b, ints, MIROperation.MovePlace{place: empty_root})
    fx_do(&b, MIROperation.Drop{value: emptied, kind: MIRDropKind.Value})
    new_root :: fx_local(&b, "empty_copy", ints, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: new_root, value: duplicate_empty})
    nine :: fx_int_const(&b, 9)
    new_lent :: fx_value(&b, ints, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: new_root, access: MIRAccess.Write})
    _ := fx_list_method(&b, "list_push", new_lent, Val(new_root), [MIRValueID]{nine}, fx_unit(), false)
    new_value :: fx_list_index(&b, duplicate_empty, zero, fx_int(), false)
    fx_print(&b, new_value)
    finished :: fx_owned(&b, ints, MIROperation.MovePlace{place: new_root})
    fx_do(&b, MIROperation.Drop{value: finished, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_list_program(b)
}

// fn run() { xs :: [3]; print(xs[1]); }
// expect-stdout lists-oob: ""
// expect-exit lists-oob: 70
fn fx_lists_oob() -> MIRProgram Never! {
    b := fx_builder()
    three :: fx_int_const(&b, 3)
    xs :: fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: [MIRValueID]{three}, trait_coercion: None})
    one :: fx_int_const(&b, 1)
    invalid :: fx_list_index(&b, xs, one, fx_int(), false)
    fx_print(&b, invalid)
    fx_do(&b, MIROperation.Drop{value: xs, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_list_program(b)
}
