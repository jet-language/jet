use jet_foundation.[
    MIRAccess, MIRCallArg, MIRFunction, MIRFunctionID, MIRNominalRef, MIRPreludeABI,
    MIRPreludeFamily, MIRPreludeTypeArg, MIRProgram, MIRSemanticOp, MIRTerminator,
    MIRTupleField, MIRType, MIRTypeKind, MIROperation,
    mir_function_id, mir_owned_ownership, mir_ownership_from_access,
    mir_type_from_kind, mir_type_id,
]

// The raw Object leaf lends the original ordered backing; its constructor
// transfers that backing. Zeroize must receive the caller's Write buffer.
fn fx_route_native_values_program() -> MIRProgram Never! {
    tree :: fx_named("Dyn")
    entry :: fx_tuple_type("RouteDynEntry", [MIRTupleField]{MIRTupleField{name: "key", ty: fx_string()}, MIRTupleField{name: "value", ty: tree}})
    entries :: mir_type_from_kind(MIRTypeKind.List{inner: entry})
    view :: mir_type_from_kind(MIRTypeKind.Apply{name: MIRNominalRef{id: mir_type_id("View"), name: "View"}, args: [MIRType]{entry}})
    bytes :: mir_type_from_kind(MIRTypeKind.List{inner: mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 8})})
    read := fx_builder()
    borrowed :: fx_param(&read, "tree", tree, fx_borrow())
    window :: fx_value(&read, view, fx_borrow(), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.encoding", "entries_view"), args: [MIRCallArg]{fx_arg(borrowed, MIRAccess.Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_block(&read, 0, MIRTerminator.Return{value: Val(window)})
    transfer := fx_builder()
    owned :: fx_param(&transfer, "entries", entries, mir_owned_ownership())
    transfer.params[0].access = MIRAccess.Move
    object :: fx_owned(&transfer, tree, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.encoding", "from_entries"), args: [MIRCallArg]{fx_arg(owned, MIRAccess.Move)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_block(&transfer, 0, MIRTerminator.Return{value: Val(object)})
    // Core `object_from_entries(entries: ^[..])` reads its place and the
    // scope drops it afterwards: the constructor takes an owned copy
    // (MIRRust's by-value formal), never the caller's allocation.
    lend := fx_builder()
    lent :: fx_param(&lend, "entries", entries, fx_borrow())
    copied :: fx_owned(&lend, tree, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.encoding", "from_entries"), args: [MIRCallArg]{fx_arg(lent, MIRAccess.Read)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_block(&lend, 0, MIRTerminator.Return{value: Val(copied)})
    write := fx_builder()
    buffer :: fx_param(&write, "bytes", bytes, mir_ownership_from_access(MIRAccess.Write))
    write.params[0].access = MIRAccess.Write
    _ := fx_owned(&write, fx_unit(), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.crypto", "zeroize"), args: [MIRCallArg]{fx_arg(buffer, MIRAccess.Write)}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_block(&write, 0, MIRTerminator.Return{value: None})
    p := fx_route_carriers_program(fx_builder())
    p.functions = [MIRFunction]{fx_function("object_view", read, view), fx_function("object_take", transfer, tree), fx_function("object_copy", lend, tree), fx_function("bytes_zeroize", write, fx_unit())}
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.encoding", "entries_view", "jet_raw_object_entries_view", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.encoding", "from_entries", "jet_raw_object_from_entries", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.crypto", "zeroize", "jet_crypto_zeroize", 1, MIRPreludeABI.Effect))
    p
}

fn fx_route_native_values_checks() -> Bool {
    lowered :: lir_lower_callables(fx_route_native_values_program(), [MIRFunctionID]{mir_function_id("object_view"), mir_function_id("object_take"), mir_function_id("object_copy"), mir_function_id("bytes_zeroize")})
    clean := lowered.issues.len() == 0
    loop issue in lowered.issues -> print("native-values: {issue.message}")
    lint :: lir_lint_module(lowered.lir)
    loop issue in lint -> print("native-values lint: {issue.message}")
    if lint.len() != 0 -> clean = false
    calls :: fx_route_carrier_runtime_calls(lowered.lir)
    if !calls.contains("jet_crypto_zeroize") -> clean = false
    if calls.contains("jet_rt_dyn_from_native") || calls.contains("jet_rt_dyn_to_native")
        || calls.contains("jet_raw_object_entries_view") || calls.contains("jet_raw_object_from_entries") {
        print("native-values: Object storage crossed a cloning runtime bridge")
        clean = false
    }
    print(if clean -> "native-values: Object backing stays native and zeroize writes the original buffer" else -> "native-values: lowering witnesses failed")
    clean
}
