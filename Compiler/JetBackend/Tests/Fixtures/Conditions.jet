use jet_foundation.[
    MIRAccess, MIRBlockID, MIRCallArg, MIRCaptureOperand, MIRConstant, MIRCopyFact,
    MIRDropKind, MIRFunction, MIRFunctionSignature, MIROperation, MIRPlaceID,
    MIRPollKind, MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRSemanticOp,
    MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind, MIRValueID,
    mir_function_id, mir_owned_ownership, mir_type_from_kind,
]
use jet_backend.[lir_lower_entry, LIRInst, LIRCallee, LIRValueID]

fn fx_condition_result() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Result{ok: fx_unit(), err: fx_string()})
}

fn fx_condition_predicate_type(bool_result: Bool) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{fx_int()}, ret: Val(if bool_result -> fx_bool() else -> fx_int()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
}

// The owned clone stays live after the original Condition drops. Immediate
// success keeps the edit permit; its guard token is reloaded before later
// dereference and Drop. A read guard reports an error without invoking the
// predicate or releasing its permit. The temporary has no local place.
// expect-stdout condition-immediate: "true\n7\n"
// expect-runtime-only condition-immediate
fn fx_condition_immediate() -> MIRProgram Never! { fx_condition_program(false, true, false, true) }
// expect-stdout condition-temporary: "true\n7\n"
// expect-runtime-only condition-temporary
fn fx_condition_temporary() -> MIRProgram Never! { fx_condition_program(true, true, false, true) }
// expect-stdout condition-read-error: "false\n7\n"
// expect-runtime-only condition-read-error: provider ABI refusal retains the read guard
fn fx_condition_read_error() -> MIRProgram Never! { fx_condition_program(false, false, false, true) }
// The stopped rail owns no initialized wait result. Cleanup moves the updated
// guard token, not the original value the provider may have marked unheld.
// expect-stdout condition-poll: "true\n7\n"
// expect-runtime-only condition-poll
fn fx_condition_poll() -> MIRProgram Never! { fx_condition_program(false, true, true, true) }

fn fx_condition_program(temporary: Bool, editable: Bool, poll: Bool, bool_result: Bool) -> MIRProgram Never! {
    predicate := fx_builder()
    input :: fx_param(&predicate, "value", fx_int(), fx_borrow())
    if poll -> fx_block(&predicate, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    answer :: fx_copy(&predicate, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    fx_block(&predicate, if poll -> U64{1} else -> U64{0}, MIRTerminator.Return{value: Val(if bool_result -> answer else -> input)})
    if poll -> fx_block(&predicate, 2, MIRTerminator.Stopped)
    b := fx_builder()
    shared_ty :: mir_type_from_kind(MIRTypeKind.Shared{inner: fx_int()})
    seven :: fx_int_const(&b, 7)
    cell :: fx_owned(&b, shared_ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("::JetShared", "new"), args: [MIRCallArg]{fx_arg(seven, MIRAccess.Move)}, owner_type_args: [], type_args: []}})
    condition_ty :: fx_named("Condition")
    original :: fx_owned(&b, condition_ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("::jet_std::JetCondition", "new"), args: [], owner_type_args: [], type_args: []}})
    condition :: fx_owned(&b, condition_ty, MIROperation.Copy{value: original, fact: MIRCopyFact.Explicit})
    fx_do(&b, MIROperation.Drop{value: original, kind: MIRDropKind.Value})
    _ := fx_copy(&b, fx_unit(), MIROperation.Semantic{operation: MIRSemanticOp.ConditionNotify{call: fx_prelude_id("core.shared_guard", "notify_one"), condition: condition, all: false}})
    _ := fx_copy(&b, fx_unit(), MIROperation.Semantic{operation: MIRSemanticOp.ConditionNotify{call: fx_prelude_id("core.shared_guard", "notify_all"), condition: condition, all: true}})
    guard_ty :: fx_shared_guard_type(fx_int(), editable)
    guard :: fx_shared_guard_acquire(&b, cell, fx_int(), editable)
    place := MIRPlaceID?{None}
    receiver := guard
    if !temporary {
        root :: fx_local(&b, "guard", guard_ty, mir_owned_ownership())
        place = Val(root)
        fx_do(&b, MIROperation.WritePlace{place: root, value: guard})
        receiver = fx_value(&b, guard_ty, fx_borrow(), MIROperation.ReadPlace{place: root})
    }
    body :: fx_owned(&b, fx_condition_predicate_type(bool_result), MIROperation.Closure{function: mir_function_id("condition_predicate"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    wait :: fx_owned(&b, fx_condition_result(), MIROperation.Semantic{operation: MIRSemanticOp.SharedGuardWait{call: fx_prelude_id("core.shared_guard", "wait"), guard: receiver, condition: condition, predicate: body}})
    if poll -> fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    succeeded :: fx_copy(&b, fx_bool(), MIROperation.ResultIsOk{subject: wait})
    fx_print(&b, succeeded)
    // Deliberately reuse the same MIR receiver id: it must denote the updated
    // token, even when a Write-back generated a new SSA value for the place.
    payload :: fx_value(&b, fx_int(), fx_borrow(), MIROperation.Deref{value: receiver})
    fx_print(&b, payload)
    fx_do(&b, MIROperation.Drop{value: wait, kind: MIRDropKind.Value})
    moved :: if place == .Val(root) -> fx_owned(&b, guard_ty, MIROperation.MovePlace{place: root}) else -> guard
    fx_do(&b, MIROperation.Drop{value: moved, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: condition, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: cell, kind: MIRDropKind.Value})
    fx_block(&b, if poll -> U64{1} else -> U64{0}, MIRTerminator.Return{value: None})
    if poll {
        stopped_guard :: if place == .Val(root) -> fx_owned(&b, guard_ty, MIROperation.MovePlace{place: root}) else -> guard
        fx_do(&b, MIROperation.Drop{value: stopped_guard, kind: MIRDropKind.Value})
        fx_do(&b, MIROperation.Drop{value: condition, kind: MIRDropKind.Value})
        fx_do(&b, MIROperation.Drop{value: cell, kind: MIRDropKind.Value})
        fx_block(&b, 2, MIRTerminator.Stopped)
    }
    p := fx_program([MIRFunction]{fx_function("condition_predicate", predicate, if bool_result -> fx_bool() else -> fx_int()), fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "::JetShared", "new", "jet_std::JetShared::new", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "::jet_std::JetCondition", "new", "jet_std::JetCondition::new", 0, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Host, "core.host", "Shared.guard_read", "jet_shared_guard_read", 1, MIRPreludeABI.Control))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Host, "core.host", "Shared.guard_edit", "jet_shared_guard_edit", 1, MIRPreludeABI.Control))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.shared_guard", "wait", "jet_shared_guard_wait_once", 3, MIRPreludeABI.Control))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "core.shared_guard", "notify_one", "jet_std::JetCondition::notify_one", 1, MIRPreludeABI.Value))
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "core.shared_guard", "notify_all", "jet_std::JetCondition::notify_all", 1, MIRPreludeABI.Value))
    p
}

fn fx_condition_checks() -> Bool Never! {
    lowered :: lir_lower_entry(fx_condition_poll(), mir_function_id("run"))
    if lowered.issues.len() != 0 -> return false
    waits := 0
    notifications := 0
    clones := 0
    byte_outputs := 0
    guard_reloaded := false
    gate_after_reload := false
    loop function in lowered.lir.functions {
        loop block in function.blocks {
            slot := LIRValueID?{None}
            reloaded := false
            loop instruction in block.insts {
                if instruction == .Call(_, _, .Runtime(symbol), args) {
                    if symbol == "jet_rt_native_shared_guard_wait" {
                        if args.len() != 6 -> return false
                        slot = Val(args[0])
                        waits += 1
                    }
                    if symbol == "jet_rt_native_condition_notify_one" || symbol == "jet_rt_native_condition_notify_all" -> notifications += 1
                    if symbol == "jet_rt_native_condition_clone" -> clones += 1
                    if symbol == "JetCondition_notify_one" || symbol == "JetCondition_notify_all" -> return false
                    if slot != None && symbol == "jet_rt_session_propagate" {
                        if !reloaded -> return false
                        gate_after_reload = true
                    }
                }
                if instruction == .Load(_, load_base, offset) {
                    if slot == (Val(load_base)) && offset == 0 {
                        reloaded = true
                        guard_reloaded = true
                    }
                }
                if instruction == .Store(_, _, value) {
                    loop fact in function.values {
                        if fact.id == value && fact.layout.size == 1 -> byte_outputs += 1
                    }
                }
            }
        }
    }
    if waits != 1 || notifications != 2 || clones != 1 || byte_outputs == 0 || !guard_reloaded || !gate_after_reload -> return false
    invalid :: lir_lower_entry(fx_condition_program(false, true, false, false), mir_function_id("run"))
    loop issue in invalid.issues {
        if issue.message.contains("Condition predicate has no native Bool result") -> return true
    }
    false
}
