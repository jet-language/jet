// The actual library feed must use O1, not merely link its optimizer sources.
// Its ELF bytes equal the canonical optimized object and differ from O0;
// export IDs remain stable through the module pipeline.
use jet_foundation.[MIRArtifactID, MIRArtifactKind, MIRArtifactTarget, MIRArtifactBuildMode, MIRExport, MIRForeignABI, MIRLinkUnitID, MIRJobID]
use jet_backend.[lir_lower_callables, lir_optimize_module, x64_runtime_library, x64_runtime_object, X64RuntimeExport]

fn fx_runtime_o1_check() -> Bool Never! {
    b := fx_builder()
    six :: fx_i64_const(&b, 6)
    seven :: fx_i64_const(&b, 7)
    answer :: fx_copy(&b, fx_i64(), MIROperation.Binary{op: MIRBinaryOp.Mul, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: six, right: seven})
    fx_block(&b, 0, MIRTerminator.Return{value: Val(answer)})
    function := fx_function("runtime_o1_answer", b, fx_i64())
    source :: "#Export(c) fn runtime_o1_answer() -> I64 {{ I64{{6}} * I64{{7}} }}"
    function.span = Span{start: 0, end: source.bytes().len()}
    program := fx_program([MIRFunction]{function}, [MIRTypeDef]{})
    program.source_files = [MIRSourceFile]{MIRSourceFile{id: fx_source_file(), path: "runtime-o1.jet", source: source}}
    export :: MIRExport{symbol: "runtime_o1_answer", function: function.id, abi: MIRForeignABI.C}
    program.artifacts = [MIRArtifactPlan]{MIRArtifactPlan{
        id: MIRArtifactID{value: 1}, kind: MIRArtifactKind.NativeLibrary,
        name: "runtime-o1", target: MIRArtifactTarget.RustAOT, mode: MIRArtifactBuildMode.Dev,
        modules: [MIRModuleID]{}, links: [MIRLinkUnitID]{}, jobs: [MIRJobID]{},
        runtime_parts: [MIRRuntimePartID]{}, exports: [MIRExport]{export},
        provider_identity: "", closure_identity: "", artifact_identity: "", entry: None, harness: None,
    }}
    library :: x64_runtime_library(program, [String]{export.symbol})
    loop error in library.object.errors -> print("runtime-o1: {error}")
    if library.object.errors.len() != 0 -> return false
    lowered :: lir_lower_callables(program, [MIRFunctionID]{function.id})
    if lowered.issues.len() != 0 -> return false
    id :: lowered.callables.get(function.id.value) ?? return false
    globals :: [X64RuntimeExport]{X64RuntimeExport{function: id, symbol: export.symbol}}
    optimized :: lir_optimize_module(lowered.lir, 1)
    if optimized.functions[id.value].id != id -> return false
    expected :: x64_runtime_object(optimized, globals)
    before :: x64_runtime_object(lowered.lir, globals)
    if expected.errors.len() != 0 || before.errors.len() != 0 -> return false
    if library.exports.len() != 1 || library.exports[0].function != function.id || library.exports[0].symbol != export.symbol -> return false
    library.object.bytes == expected.bytes && library.object.bytes != before.bytes
}
