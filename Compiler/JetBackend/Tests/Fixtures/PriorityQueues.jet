use jet_foundation.[
    MIRAccess, MIRCallArg, MIRConstant, MIRCopyFact, MIRDropKind, MIRFunction,
    MIROperation, MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRSemanticOp,
    MIRTerminator, MIRType, MIRTypeDef, MIRTypeKind, MIRValueID, mir_nominal_ref,
    mir_owned_ownership, mir_ownership_from_access, mir_type_from_kind,
]

fn fx_priority_queue_type(elem: MIRType) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("PriorityQueue"), args: [MIRType]{elem}})
}

fn fx_priority_queue_program(b: FxBuilder) -> MIRProgram Never! {
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
    members :: [String]{"priority_queue_from", "list_push", "priority_queue_pop", "priority_queue_peek", "priority_queue_to_sorted_list", "priority_queue_remove_value", "priority_queue_remove_slot", "priority_queue_len", "priority_queue_is_empty", "priority_queue_clear"}
    symbols :: [String]{"jet_priority_queue_from", "jet_list_push", "jet_priority_queue_pop_kernel", "jet_priority_queue_peek", "jet_priority_queue_to_sorted_list", "jet_priority_queue_remove_value", "jet_priority_queue_remove_slot_canonical", "jet_priority_queue_len", "jet_priority_queue_is_empty", "std::collections::BinaryHeap::clear"}
    loop (index, member) in members {
        binary :: index == 1 || index == 5 || index == 6
        row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", member, symbols[index], if binary -> 2 else -> 1, MIRPreludeABI.Value)
        row.signature.borrow_mask[0] = index != 0
        if binary -> row.signature.borrow_mask[1] = index == 6
        &p.prelude_calls.push(row)
    }
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.builtin", "priority_queue_new", "std::collections::BinaryHeap::new", 0, MIRPreludeABI.Value))
    p
}

// expect-stdout priority-queues: "[9, 7, 4, 1]\n9\n9\n7\n[4, 1]\n[12, 4, 1]\n4\n12\nNone\n[1]\n1\ntrue\n0\ntrue\nzebra\n[apple]\n[5, 5, 3]\n5\n5\n3\nNone\n"
// expect-runtime-only priority-queues: native max-heap and canonical text/Int ownership exports
fn fx_priority_queues() -> MIRProgram Never! {
    b := fx_builder()
    ty :: fx_priority_queue_type(fx_int())
    option_ty :: mir_type_from_kind(MIRTypeKind.Option{inner: fx_int()})
    root :: fx_local(&b, "heap", ty, mir_owned_ownership())
    values := [MIRValueID]{}
    constants :: [Int]{4, 9, 1, 7}
    loop value in constants -> &values.push(fx_int_const(&b, value))
    list :: fx_owned(&b, fx_list_type(fx_int()), MIROperation.BuildList{values: values, trait_coercion: None})
    heap :: fx_list_method(&b, "priority_queue_from", list, None, [MIRValueID]{}, ty, true)
    fx_do(&b, MIROperation.WritePlace{place: root, value: heap})
    lent :: fx_value(&b, ty, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: root, access: MIRAccess.Write})
    fx_print(&b, heap)
    peek :: fx_list_method(&b, "priority_queue_peek", heap, None, [MIRValueID]{}, option_ty, true)
    fx_print(&b, peek)
    fx_do(&b, MIROperation.Drop{value: peek, kind: MIRDropKind.Value})
    pops :: [Int]{0, 1}
    loop _ in pops {
        value :: fx_list_method(&b, "priority_queue_pop", lent, Val(root), [MIRValueID]{}, option_ty, true)
        fx_print(&b, value)
        fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    }
    fx_print(&b, heap)
    twelve :: fx_int_const(&b, 12)
    _ := fx_list_method(&b, "list_push", lent, Val(root), [MIRValueID]{twelve}, fx_unit(), false)
    saved :: fx_owned(&b, ty, MIROperation.Copy{value: heap, fact: MIRCopyFact.Explicit})
    sorted :: fx_list_method(&b, "priority_queue_to_sorted_list", heap, None, [MIRValueID]{}, fx_list_type(fx_int()), true)
    fx_print(&b, sorted)
    one :: fx_int_const(&b, 1)
    removed :: fx_list_method(&b, "priority_queue_remove_slot", lent, Val(root), [MIRValueID]{one}, option_ty, true)
    fx_print(&b, removed)
    fx_do(&b, MIROperation.Drop{value: removed, kind: MIRDropKind.Value})
    taken :: fx_list_method(&b, "priority_queue_remove_value", lent, Val(root), [MIRValueID]{twelve}, option_ty, true)
    fx_print(&b, taken)
    fx_do(&b, MIROperation.Drop{value: taken, kind: MIRDropKind.Value})
    missing :: fx_list_method(&b, "priority_queue_remove_value", lent, Val(root), [MIRValueID]{twelve}, option_ty, true)
    fx_print(&b, missing)
    fx_do(&b, MIROperation.Drop{value: missing, kind: MIRDropKind.Value})
    fx_print(&b, heap)
    count :: fx_list_method(&b, "priority_queue_len", heap, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, count)
    _ := fx_list_method(&b, "priority_queue_clear", lent, Val(root), [MIRValueID]{}, fx_unit(), false)
    empty :: fx_list_method(&b, "priority_queue_is_empty", heap, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, empty)
    fresh :: fx_owned(&b, ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.builtin", "priority_queue_new"), args: [MIRCallArg]{}, owner_type_args: [], type_args: [MIRType]{}}})
    fresh_count :: fx_list_method(&b, "priority_queue_len", fresh, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, fresh_count)
    fresh_empty :: fx_list_method(&b, "priority_queue_is_empty", fresh, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, fresh_empty)
    text_ty :: fx_priority_queue_type(fx_string())
    apple :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "apple"}})
    zebra :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "zebra"}})
    texts :: fx_owned(&b, fx_list_type(fx_string()), MIROperation.BuildList{values: [MIRValueID]{apple, zebra}, trait_coercion: None})
    text_heap :: fx_list_method(&b, "priority_queue_from", texts, None, [MIRValueID]{}, text_ty, true)
    backup :: fx_owned(&b, text_ty, MIROperation.Copy{value: text_heap, fact: MIRCopyFact.Explicit})
    fx_do(&b, MIROperation.Drop{value: text_heap, kind: MIRDropKind.Value})
    text_root :: fx_local(&b, "texts", text_ty, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: text_root, value: backup})
    text_lent :: fx_value(&b, text_ty, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: text_root, access: MIRAccess.Write})
    text_pop :: fx_list_method(&b, "priority_queue_pop", text_lent, Val(text_root), [MIRValueID]{}, mir_type_from_kind(MIRTypeKind.Option{inner: fx_string()}), true)
    fx_print(&b, text_pop)
    fx_do(&b, MIROperation.Drop{value: text_pop, kind: MIRDropKind.Value})
    fx_print(&b, backup)
    retired :: fx_owned(&b, text_ty, MIROperation.MovePlace{place: text_root})
    fx_do(&b, MIROperation.Drop{value: retired, kind: MIRDropKind.Value})
    lost :: fx_owned(&b, ty, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: lost, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: saved, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: sorted, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: fresh, kind: MIRDropKind.Value})
    duplicates :: fx_owned(&b, ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.builtin", "priority_queue_new"), args: [MIRCallArg]{}, owner_type_args: [], type_args: [MIRType]{}}})
    duplicate_root :: fx_local(&b, "duplicates", ty, mir_owned_ownership())
    fx_do(&b, MIROperation.WritePlace{place: duplicate_root, value: duplicates})
    duplicate_lent :: fx_value(&b, ty, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: duplicate_root, access: MIRAccess.Write})
    offered :: [Int]{5, 3, 5}
    loop item in offered {
        value :: fx_int_const(&b, item)
        _ := fx_list_method(&b, "list_push", duplicate_lent, Val(duplicate_root), [MIRValueID]{value}, fx_unit(), false)
    }
    fx_print(&b, duplicates)
    attempts :: [Int]{0, 1, 2, 3}
    loop _ in attempts {
        value :: fx_list_method(&b, "priority_queue_pop", duplicate_lent, Val(duplicate_root), [MIRValueID]{}, option_ty, true)
        fx_print(&b, value)
        fx_do(&b, MIROperation.Drop{value: value, kind: MIRDropKind.Value})
    }
    duplicate_retired :: fx_owned(&b, ty, MIROperation.MovePlace{place: duplicate_root})
    fx_do(&b, MIROperation.Drop{value: duplicate_retired, kind: MIRDropKind.Value})
    fx_block(&b, U64{0}, MIRTerminator.Return{value: None})
    fx_priority_queue_program(b)
}
