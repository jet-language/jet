// Scalar conversion fixtures. NumericCast is deliberately hand-MIR here.
// Exact-Int inline eligibility chooses a fast path, never a semantic stop:
// the same slow-route symbol serves the static and compiled carrier runtimes.
use jet_foundation.[
    MIRAccess,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryOverflow,
    MIRCallArg,
    MIRCallFallibility,
    MIRCallee,
    MIRConstant,
    MIRConversion,
    MIRDropKind,
    MIRFunction,
    MIROperation,
    MIRPanicLoc,
    MIRProgram,
    MIRTerminator,
    MIRType,
    MIRTypeDef,
    MIRTypeKind,
    MIRValueID,
    mir_copy_ownership,
    mir_function_id,
    mir_type_from_kind,
    mir_type_display_name,
]
use jet_backend.[lir_lower_entry]

fn fx_convert_float_type() -> MIRType Never! { mir_type_from_kind(MIRTypeKind.Float) }
fn fx_convert_char_type() -> MIRType Never! { mir_type_from_kind(MIRTypeKind.Char) }

fn fx_convert_cast(b: &FxBuilder, value: MIRValueID, target: MIRType) -> MIRValueID Never! {
    fx_copy(&b, target, MIROperation.Convert{value: value, parameters: [MIRValueID]{}, target: target, conversion: MIRConversion.NumericCast})
}

fn fx_convert_call(b: &FxBuilder, name: String, value: MIRValueID, target: MIRType) -> MIRValueID Never! {
    fx_copy(&b, target, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id(name)}, args: [MIRCallArg]{fx_arg(value, MIRAccess.Read)}, type_args: [MIRType]{}})
}

fn fx_convert_roundtrip_function() -> MIRFunction Never! {
    b := fx_builder()
    value :: fx_param(&b, "value", fx_i64(), mir_copy_ownership())
    exact :: fx_convert_cast(&b, value, fx_int())
    fixed :: fx_convert_cast(&b, exact, fx_i64())
    result :: fx_convert_cast(&b, fixed, fx_int())
    fx_block(&b, 0, MIRTerminator.Return{value: Val(result)})
    fx_function("roundtrip", b, fx_int())
}

fn fx_convert_float_function() -> MIRFunction Never! {
    b := fx_builder()
    value :: fx_param(&b, "value", fx_int(), mir_copy_ownership())
    result :: fx_convert_cast(&b, value, fx_convert_float_type())
    // Float NumericCast identity and Transparent both preserve the Float ABI.
    identity :: fx_convert_cast(&b, result, fx_convert_float_type())
    forwarded :: fx_copy(&b, fx_convert_float_type(), MIROperation.Convert{value: identity, parameters: [MIRValueID]{}, target: fx_convert_float_type(), conversion: MIRConversion.Transparent})
    fx_block(&b, 0, MIRTerminator.Return{value: Val(forwarded)})
    fx_function("as_float", b, fx_convert_float_type())
}

fn fx_convert_float_compare(b: &FxBuilder, actual: MIRValueID, number: MIRValueID) Never! {
    equal :: fx_copy(&b, fx_bool(), MIROperation.Binary{op: MIRBinaryOp.Eq, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Trap, left: actual, right: number})
    fx_print(&b, equal)
}

fn fx_convert_float_equal(b: &FxBuilder, actual: MIRValueID, expected: Float) Never! {
    number :: fx_copy(&b, fx_convert_float_type(), MIROperation.Constant{value: MIRConstant.Float{value: expected, f32: false, spelling: None}})
    fx_convert_float_compare(&b, actual, number)
}

// Expected Floats of 2.0 and above come from an exact I64 cast, not a Float
// constant: lowering a Float constant runs math.to_bits, which `jet run`
// mis-carries outside the inline Int range (Tower #4340). The cast is exact
// for every `expected` used here (a power of two at most 2^62).
fn fx_convert_float_equal_exact(b: &FxBuilder, actual: MIRValueID, expected: Int) Never! {
    fixed :: fx_i64_const(&b, expected)
    number :: fx_convert_cast(&b, fixed, fx_convert_float_type())
    fx_convert_float_compare(&b, actual, number)
}

// Modeled Jet program (NumericCast operations explicitly selected in MIR):
// fn roundtrip(value: I64) -> Int { Int{I64{Int{value}}} }
// fn as_float(value: Int) -> Float { approx(value) }
// fn run() {
//     loop n in [0, -37, 9007199254740992, 9007199254740993,
//                -9007199254740993, -4611686018427387904, 4611686018427387903] {
//         print(roundtrip(I64{n}))
//     }
//     print(as_float(-37) == -37.0)
//     print(as_float(9007199254740992) == approx(I64{9007199254740992}))
//     print(as_float(9007199254740993) == approx(I64{9007199254740992}))
//     print(as_float(-9007199254740993) == -9007199254740992.0)
//     print(Int{'λ'})
//     print(Char{Int{'λ'}})
//     print(Char{0} == '\0'); print(Char{1114111} == '\u{10ffff}')
//     print(approx(I64{-37}) == -37.0)
// }
// Floats are compared, not printed: the static runtime has no Float formatter.
// Float->integer NumericCast is intentionally not modeled: checked Jet sema
// does not produce this pair; the FloatToInt operation is a Prelude route.
// expect-stdout convert: "0\n-37\n9007199254740992\n9007199254740993\n-9007199254740993\n-4611686018427387904\n4611686018427387903\ntrue\ntrue\ntrue\ntrue\n955\nλ\ntrue\ntrue\ntrue\n"
// `as_float(n) == expected`, printed as a Bool.
fn fx_convert_widened(r: &FxBuilder, n: Int, expected: Float) Never! {
    exact :: fx_int_const(&r, n)
    number :: fx_convert_call(&r, "as_float", exact, fx_convert_float_type())
    fx_convert_float_equal(&r, number, expected)
}

// `as_float(n) == approx(I64{expected})`, printed as a Bool.
fn fx_convert_widened_exact(r: &FxBuilder, n: Int, expected: Int) Never! {
    exact :: fx_int_const(&r, n)
    number :: fx_convert_call(&r, "as_float", exact, fx_convert_float_type())
    fx_convert_float_equal_exact(&r, number, expected)
}

fn fx_convert() -> MIRProgram Never! {
    r := fx_builder()
    roundtrips :: [Int]{0, -37, 9007199254740992, 9007199254740993, -9007199254740993, -4611686018427387904, 4611686018427387903}
    loop n in roundtrips {
        fixed :: fx_i64_const(&r, n)
        exact :: fx_convert_call(&r, "roundtrip", fixed, fx_int())
        fx_print(&r, exact)
    }
    fx_convert_widened(&r, -37, -37.0)
    fx_convert_widened_exact(&r, 9007199254740992, 9007199254740992)
    fx_convert_widened_exact(&r, 9007199254740993, 9007199254740992)
    fx_convert_widened(&r, -9007199254740993, -9007199254740992.0)
    scalar :: fx_copy(&r, fx_convert_char_type(), MIROperation.Constant{value: MIRConstant.Char{value: 955}})
    exact_scalar :: fx_convert_cast(&r, scalar, fx_int())
    fx_print(&r, exact_scalar)
    char_scalar :: fx_convert_cast(&r, exact_scalar, fx_convert_char_type())
    fx_print(&r, char_scalar)
    scalars :: [Int]{0, 1114111}
    loop n in scalars {
        exact :: fx_int_const(&r, n)
        actual :: fx_convert_cast(&r, exact, fx_convert_char_type())
        expected :: fx_copy(&r, fx_convert_char_type(), MIROperation.Constant{value: MIRConstant.Char{value: n}})
        equal :: fx_copy(&r, fx_bool(), MIROperation.Binary{op: MIRBinaryOp.Eq, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Trap, left: actual, right: expected})
        fx_print(&r, equal)
    }
    fixed :: fx_i64_const(&r, -37)
    fixed_float :: fx_convert_cast(&r, fixed, fx_convert_float_type())
    fx_convert_float_equal(&r, fixed_float, -37.0)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_convert_roundtrip_function(), fx_convert_float_function(), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

fn fx_convert_outside_inline(value: Int) -> MIRProgram Never! {
    r := fx_builder()
    fixed :: fx_i64_const(&r, value)
    exact :: fx_convert_call(&r, "roundtrip", fixed, fx_int())
    fx_print(&r, exact)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_convert_roundtrip_function(), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(Int{I64{4611686018427387904}}) }
// expect-stdout convert-big-positive: ""
// expect-exit convert-big-positive: 70
// expect-static-only convert-big-positive
// Hosted expectation: "4611686018427387904\n", exit 0 (constructor + narrowing).
fn fx_convert_big_positive() -> MIRProgram Never! { fx_convert_outside_inline(4611686018427387904) }

// fn run() { print(Int{I64{-4611686018427387905}}) }
// expect-stdout convert-big-negative: ""
// expect-exit convert-big-negative: 70
// expect-static-only convert-big-negative
// Hosted expectation: "-4611686018427387905\n", exit 0 (constructor + narrowing).
fn fx_convert_big_negative() -> MIRProgram Never! { fx_convert_outside_inline(-4611686018427387905) }

// fn run() { print(approx(Int{I64{4611686018427387904}}) == approx(I64{4611686018427387904})) }
// expect-stdout convert-big-float: ""
// expect-exit convert-big-float: 70
// expect-static-only convert-big-float
// Hosted expectation: "true\n", exit 0 (tagged input to the Float adapter).
fn fx_convert_big_float() -> MIRProgram Never! {
    r := fx_builder()
    fixed :: fx_i64_const(&r, 4611686018427387904)
    exact :: fx_convert_cast(&r, fixed, fx_int())
    number :: fx_convert_call(&r, "as_float", exact, fx_convert_float_type())
    fx_convert_float_equal_exact(&r, number, 4611686018427387904)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_convert_float_function(), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(I64{Int{I64{9223372036854775807}} + 1}) }
// This exact result exceeds i64 even in the compiled runtime: both runtimes stop.
// expect-stdout convert-big-i64-overflow: ""
// expect-exit convert-big-i64-overflow: 70
fn fx_convert_big_i64_overflow() -> MIRProgram Never! {
    r := fx_builder()
    maximum :: fx_i64_const(&r, 9223372036854775807)
    exact :: fx_convert_cast(&r, maximum, fx_int())
    one :: fx_int_const(&r, 1)
    too_large :: fx_int_op(&r, MIRBinaryOp.Add, "add", exact, one)
    fixed :: fx_convert_cast(&r, too_large, fx_i64())
    fx_print(&r, fixed)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(Char{Int{I64{4611686018427387904}}}) }
// The tagged Int narrows successfully in the host, but is not a Unicode scalar.
// expect-stdout convert-big-char: ""
// expect-exit convert-big-char: 70
fn fx_convert_big_char() -> MIRProgram Never! {
    r := fx_builder()
    wide :: fx_i64_const(&r, 4611686018427387904)
    exact :: fx_convert_cast(&r, wide, fx_int())
    scalar :: fx_convert_cast(&r, exact, fx_convert_char_type())
    fx_print(&r, scalar)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

fn fx_convert_invalid_char(value: Int) -> MIRProgram Never! {
    r := fx_builder()
    exact :: fx_int_const(&r, value)
    scalar :: fx_convert_cast(&r, exact, fx_convert_char_type())
    fx_print(&r, scalar)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// fn run() { print(Char{55296}) } // Unicode surrogate, not a scalar.
// expect-stdout convert-char-surrogate: ""
// expect-exit convert-char-surrogate: 70
fn fx_convert_char_surrogate() -> MIRProgram Never! { fx_convert_invalid_char(55296) }

// fn run() { print(Char{1114112}) } // Past U+10FFFF.
// expect-stdout convert-char-large: ""
// expect-exit convert-char-large: 70
fn fx_convert_char_large() -> MIRProgram Never! { fx_convert_invalid_char(1114112) }

// fn run() { print(Char{-1}) }
// expect-stdout convert-char-negative: ""
// expect-exit convert-char-negative: 70
fn fx_convert_char_negative() -> MIRProgram Never! { fx_convert_invalid_char(-1) }

// fn run() { print('λ'.to_string()) }
// The checked Prelude row deliberately uses a symbol present in the image.
// expect-stdout convert-prelude: "λ\n"
fn fx_convert_prelude() -> MIRProgram Never! {
    r := fx_builder()
    scalar :: fx_copy(&r, fx_convert_char_type(), MIROperation.Constant{value: MIRConstant.Char{value: 955}})
    text :: fx_owned(&r, fx_string(), MIROperation.Convert{value: scalar, parameters: [MIRValueID]{}, target: fx_string(), conversion: MIRConversion.Prelude{call: fx_prelude_id("core.convert", "char_to_string"), location: MIRPanicLoc{file: fx_source_file(), line: 1, column: 1}, fallibility: MIRCallFallibility.Infallible}})
    fx_print(&r, text)
    fx_do(&r, MIROperation.Drop{value: text, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// Lowering-only rejection cases, not executable fixtures. NumericCast Float
// to integer is not a checked Jet sema producer, and must not acquire invented
// saturating/trapping behavior from an otherwise valid Float LIR layout.
fn fx_convert_float_integer_rejected(target: MIRType) -> MIRProgram Never! {
    r := fx_builder()
    number :: fx_copy(&r, fx_convert_float_type(), MIROperation.Constant{value: MIRConstant.Float{value: -37.5, f32: false, spelling: None}})
    converted :: fx_convert_cast(&r, number, target)
    fx_print(&r, converted)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

fn fx_convert_float_i64_rejected() -> MIRProgram Never! { fx_convert_float_integer_rejected(fx_i64()) }
fn fx_convert_float_int_rejected() -> MIRProgram Never! { fx_convert_float_integer_rejected(fx_int()) }

fn fx_convert_has_issue(program: MIRProgram, message: String) -> Bool Never! {
    lowered :: lir_lower_entry(program, mir_function_id("run"))
    loop issue in lowered.issues {
        if issue.message == message -> return true
    }
    false
}

fn fx_convert_rejection_checks() -> Bool Never! {
    if !fx_convert_has_issue(fx_convert_float_i64_rejected(), "numeric conversion from {mir_type_display_name(fx_convert_float_type())} to {mir_type_display_name(fx_i64())} is not lowered at O0 yet") -> return false
    fx_convert_has_issue(fx_convert_float_int_rejected(), "numeric conversion from {mir_type_display_name(fx_convert_float_type())} to {mir_type_display_name(fx_int())} is not lowered at O0 yet")
}
