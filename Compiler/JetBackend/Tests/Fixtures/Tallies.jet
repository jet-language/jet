use jet_foundation.[
    MIRAccess, MIRBinaryOp, MIRCallArg, MIRCaptureOperand, MIRConstEnumArg, MIRConstant,
    MIRCopyFact, MIRDropKind, MIRFunction, MIRFunctionSignature, MIROperation,
    MIRPreludeABI, MIRPreludeFamily, MIRPreludeTypeArg, MIRProgram, MIRSemanticOp,
    MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRValueID,
    MIRVariant, MIRVariantPayload, mir_function_id, mir_nominal_ref,
    mir_owned_ownership, mir_ownership_from_access, mir_type_from_kind, mir_type_id,
]

fn fx_tally_type(elem: MIRType) -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Tally"), args: [MIRType]{elem}})
}

fn fx_tally_new(b: &FxBuilder, ty: MIRType) -> MIRValueID Never! {
    fx_owned(&b, ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.builtin", "bag_new"), args: [MIRCallArg]{}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
}

fn fx_tally_any(b: &FxBuilder, tally: MIRValueID, elem: MIRType, name: String) -> MIRValueID Never! {
    fn_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{elem}, ret: Val(fx_bool()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    callback :: fx_owned(&b, fn_ty, MIROperation.Closure{function: mir_function_id(name), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
    fx_copy(&b, fx_bool(), MIROperation.Semantic{operation: MIRSemanticOp.ClosureMethod{receiver: tally, args: [MIRCallArg]{fx_arg(callback, .Move)}, call: fx_prelude_id("core.bag", "any")}})
}

// All-unit enum keys exercise the named Damage refusal's word carrier.
// Physical's sole Cut leaf models the ancestor predicate's EnumIs expansion.
// Empty any never calls; true short-circuits; false calls once per distinct key.
// Duplicate Strings are owned, copies survive clear/drop, and remove of absent
// or final occurrences never fabricates a count or allocates an Option box.
// expect-stdout tallies: "false\n2\n3\ntrue\n7\ntrue\n8\n8\nfalse\n1\nfalse\n0\nfalse\n1\n0\ntrue\n3\n2\n0\n2\n"
// expect-runtime-only tallies: native collection ownership and closure exports
fn fx_tallies() -> MIRProgram Never! {
    b := fx_builder()
    damage :: fx_named("Damage")
    ty :: fx_tally_type(damage)
    root :: fx_local(&b, "tally", ty, mir_owned_ownership())
    tally :: fx_tally_new(&b, ty)
    fx_do(&b, MIROperation.WritePlace{place: root, value: tally})
    lent :: fx_value(&b, ty, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: root, access: MIRAccess.Write})
    empty_any :: fx_tally_any(&b, tally, damage, "damage_yes")
    fx_print(&b, empty_any)
    cut :: fx_copy(&b, damage, MIROperation.Constant{value: MIRConstant.Enum{type_name: "Damage", variant: "Physical.Cut", args: [MIRConstEnumArg]{}}})
    fire :: fx_copy(&b, damage, MIROperation.Constant{value: MIRConstant.Enum{type_name: "Damage", variant: "Elemental.Fire", args: [MIRConstEnumArg]{}}})
    absent :: fx_copy(&b, damage, MIROperation.Constant{value: MIRConstant.Enum{type_name: "Damage", variant: "Elemental.Ice", args: [MIRConstEnumArg]{}}})
    values :: [MIRValueID]{cut, fire, cut}
    loop key in values -> _ := fx_set_method(&b, "bag_add", lent, Val(root), [MIRValueID]{key}, fx_unit(), false)
    count :: fx_set_method(&b, "bag_count", tally, None, [MIRValueID]{cut}, fx_int(), false)
    length :: fx_set_method(&b, "bag_len", tally, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, count)
    fx_print(&b, length)
    original :: fx_owned(&b, ty, MIROperation.Copy{value: tally, fact: MIRCopyFact.Explicit})
    same :: fx_compare(&b, MIRBinaryOp.Eq, tally, original)
    fx_print(&b, same)
    yes :: fx_tally_any(&b, tally, damage, "damage_yes")
    fx_print(&b, yes)
    no :: fx_tally_any(&b, tally, damage, "damage_no")
    fx_print(&b, no)
    _ := fx_set_method(&b, "bag_remove", lent, Val(root), [MIRValueID]{absent}, fx_unit(), false)
    _ := fx_set_method(&b, "bag_remove", lent, Val(root), [MIRValueID]{cut}, fx_unit(), false)
    remaining :: fx_set_method(&b, "bag_count", tally, None, [MIRValueID]{cut}, fx_int(), false)
    fx_print(&b, remaining)
    different :: fx_compare(&b, MIRBinaryOp.Eq, tally, original)
    fx_print(&b, different)
    _ := fx_set_method(&b, "bag_remove", lent, Val(root), [MIRValueID]{cut}, fx_unit(), false)
    missing :: fx_set_method(&b, "bag_count", tally, None, [MIRValueID]{cut}, fx_int(), false)
    has :: fx_set_method(&b, "bag_has", tally, None, [MIRValueID]{cut}, fx_bool(), false)
    total :: fx_set_method(&b, "bag_len", tally, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, missing)
    fx_print(&b, has)
    fx_print(&b, total)
    _ := fx_set_method(&b, "bag_clear", lent, Val(root), [MIRValueID]{}, fx_unit(), false)
    zero :: fx_set_method(&b, "bag_len", tally, None, [MIRValueID]{}, fx_int(), false)
    empty :: fx_set_method(&b, "bag_is_empty", tally, None, [MIRValueID]{}, fx_bool(), false)
    fx_print(&b, zero)
    fx_print(&b, empty)
    lost :: fx_owned(&b, ty, MIROperation.MovePlace{place: root})
    fx_do(&b, MIROperation.Drop{value: lost, kind: MIRDropKind.Value})
    saved :: fx_set_method(&b, "bag_len", original, None, [MIRValueID]{}, fx_int(), false)
    fx_print(&b, saved)
    fx_do(&b, MIROperation.Drop{value: original, kind: MIRDropKind.Value})

    texts :: fx_tally_type(fx_string())
    text_root :: fx_local(&b, "texts", texts, mir_owned_ownership())
    strings :: fx_tally_new(&b, texts)
    fx_do(&b, MIROperation.WritePlace{place: text_root, value: strings})
    text_lent :: fx_value(&b, texts, mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: text_root, access: MIRAccess.Write})
    names :: [String]{"blue", "blue"}
    loop name in names {
        key :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: name}})
        _ := fx_set_method(&b, "bag_add", text_lent, Val(text_root), [MIRValueID]{key}, fx_unit(), false)
    }
    probe :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "blue"}})
    text_count :: fx_set_method(&b, "bag_count", strings, None, [MIRValueID]{probe}, fx_int(), false)
    fx_print(&b, text_count)
    snapshot :: fx_owned(&b, texts, MIROperation.Copy{value: strings, fact: MIRCopyFact.Explicit})
    removals :: [String]{"blue", "missing", "blue", "blue"}
    loop name in removals {
        key :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: name}})
        _ := fx_set_method(&b, "bag_remove", text_lent, Val(text_root), [MIRValueID]{key}, fx_unit(), false)
    }
    text_zero :: fx_set_method(&b, "bag_count", strings, None, [MIRValueID]{probe}, fx_int(), false)
    fx_print(&b, text_zero)
    dead :: fx_owned(&b, texts, MIROperation.MovePlace{place: text_root})
    fx_do(&b, MIROperation.Drop{value: dead, kind: MIRDropKind.Value})
    text_saved :: fx_set_method(&b, "bag_count", snapshot, None, [MIRValueID]{probe}, fx_int(), false)
    fx_print(&b, text_saved)
    fx_do(&b, MIROperation.Drop{value: probe, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: snapshot, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    definition :: fx_type_def("Damage", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("Physical.Cut", MIRVariantPayload.Unit), fx_variant("Elemental.Fire", MIRVariantPayload.Unit), fx_variant("Elemental.Ice", MIRVariantPayload.Unit)}, methods: []})
    p := fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{definition})
    modes :: [Bool]{true, false}
    loop mode in modes {
        cb := fx_builder()
        key :: fx_param(&cb, "key", damage, mir_ownership_from_access(MIRAccess.Read))
        marker :: fx_int_const(&cb, if mode -> 7 else -> 8)
        fx_print(&cb, marker)
        verdict :: fx_copy(&cb, fx_bool(), MIROperation.EnumIs{subject: key, owner: mir_type_id("Damage"), variant: if mode -> "Physical.Cut" else -> "Elemental.Ice"})
        fx_block(&cb, 0, MIRTerminator.Return{value: Val(verdict)})
        &p.functions.push(fx_function(if mode -> "damage_yes" else -> "damage_no", cb, fx_bool()))
    }
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.builtin", "bag_new", "std::collections::HashMap::new", 0, MIRPreludeABI.Value))
    members :: [String]{"bag_add", "bag_remove", "bag_count", "bag_has", "bag_len", "bag_is_empty", "bag_clear"}
    symbols :: [String]{"jet_bag_add", "jet_bag_remove", "jet_bag_count", "jet_bag_has", "jet_bag_len", "jet_bag_is_empty", "std::collections::HashMap::clear"}
    loop (index, member) in members {
        unary :: index < 4
        row := fx_prelude(MIRPreludeFamily.BuiltinMethod, "core.builtin", member, symbols[index], if unary -> 2 else -> 1, MIRPreludeABI.Value)
        row.signature.borrow_mask[0] = true
        if unary -> row.signature.borrow_mask[1] = index == 2 || index == 3
        &p.prelude_calls.push(row)
    }
    row := fx_prelude(MIRPreludeFamily.ClosureMethod, "core.bag", "any", "jet_bag_any", 2, MIRPreludeABI.Value)
    row.signature.borrow_mask[0] = true
    &p.prelude_calls.push(row)
    p
}
