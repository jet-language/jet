// Typed-MIR producer witness, real runtime only (edd2a9726 family). Timing
// counts are deliberately not goldened: only requested source facts are.
use jet_foundation.[MIRCaptureOperand, MIRCoreClosureKind, MIRDropKind, MIRField, MIRFunction, MIRFunctionID, MIRFunctionSignature, MIROperation, MIRPreludeABI, MIRPreludeFamily, MIRProgram, MIRSemanticOp, MIRSiteID, MIRTerminator, MIRType, MIRTypeDef, MIRTypeDefKind, MIRTypeKind, MIRValueID, mir_function_id, mir_type_from_kind]

fn fx_realtime_method(b: &FxBuilder, stream: MIRValueID, symbol: String, ty: MIRType) -> MIRValueID Never! {
    fx_owned(&b, ty, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: fx_prelude_id("realtime.fixture", symbol), receiver: stream, args: [MIRValueID]{}, frame_schedule: None, frame_schedule_derivation: None}})
}

fn fx_realtime_start(b: &FxBuilder, callback: MIRValueID) -> MIRValueID Never! {
    rate :: fx_owned(&b, fx_int(), MIROperation.Constant{value: .Int{value: 1000, width: None, spelling: None}})
    frames :: fx_owned(&b, fx_int(), MIROperation.Constant{value: .Int{value: 8, width: None, spelling: None}})
    stream :: fx_owned(&b, fx_named("RealtimeStream"), MIROperation.Semantic{operation: MIRSemanticOp.CoreClosureCall{call: fx_prelude_id("core.rt", "callback"), kind: MIRCoreClosureKind.Realtime, values: [MIRValueID]{rate, frames}, closure: Val(callback), site: MIRSiteID{value: U64{0}}, label: ""}})
    // Runtime borrows these canonical words, including failure paths.
    fx_do(&b, MIROperation.Drop{value: rate, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: frames, kind: MIRDropKind.Value})
    stream
}

// expect-stdout realtime-producer: "1000\n8\ntrue\n1000\n8\ntrue\n"
// expect-runtime-only realtime-producer: actual Jet Realtime worker + record family, no Rust carrier
fn fx_realtime_producer() -> MIRProgram Never! {
    buffer_ty :: fx_list_type(mir_type_from_kind(MIRTypeKind.Float))
    callback_ty :: mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{buffer_ty}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
    a := fx_builder()
    _ := fx_param(&a, "buffer", buffer_ty, fx_borrow())
    fx_block(&a, 0, MIRTerminator.Return{value: None})
    b := fx_builder()
    loop _ in 0..<2 {
        callback :: fx_owned(&b, callback_ty, MIROperation.Closure{function: mir_function_id("realtime_callback"), captures: [MIRCaptureOperand]{}, facts: fx_capture_facts()})
        stream :: fx_realtime_start(&b, callback)
        deadline :: fx_realtime_method(&b, stream, "jet_rt_next_deadline", fx_named("Instant"))
        fx_do(&b, MIROperation.Drop{value: deadline, kind: MIRDropKind.Value})
        receipt :: fx_realtime_method(&b, stream, "jet_rt_receipt", fx_named("RealtimeReceipt"))
        rate :: fx_values_field(&b, receipt, "RealtimeReceipt", "requested_rate_hz", fx_int())
        frames :: fx_values_field(&b, receipt, "RealtimeReceipt", "requested_frames", fx_int())
        fx_print(&b, rate)
        fx_print(&b, frames)
        fx_do(&b, MIROperation.Drop{value: receipt, kind: MIRDropKind.Value})
        fx_realtime_method(&b, stream, "jet_rt_cancel", fx_unit()).drop("cancel")
        cancelled :: fx_realtime_method(&b, stream, "jet_rt_is_cancelled", fx_bool())
        fx_print(&b, cancelled)
        fx_do(&b, MIROperation.Drop{value: stream, kind: MIRDropKind.Value})
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    names :: [String]{"requested_rate_hz", "requested_frames", "completed_callbacks", "completed_frames", "missed", "max_lateness_ns", "start_identity", "end_identity"}
    fields := [MIRField]{}
    loop name in names -> &fields.push(fx_field("RealtimeReceipt", name, fx_int()))
    p := fx_program([MIRFunction]{fx_function("realtime_callback", a, fx_unit()), fx_function("run", b, fx_unit())}, [MIRTypeDef]{fx_type_def("Instant", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Instant", "start_ns", fx_int())}, methods: [MIRFunctionID]{}}), fx_type_def("RealtimeReceipt", MIRTypeDefKind.Struct{fields: fields, methods: [MIRFunctionID]{}})})
    &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.Host, "core.rt", "callback", "jet_rt_callback", 3, MIRPreludeABI.Value))
    symbols :: [String]{"jet_rt_next_deadline", "jet_rt_receipt", "jet_rt_cancel", "jet_rt_is_cancelled"}
    loop symbol in symbols -> &p.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "realtime.fixture", symbol, symbol, 1, MIRPreludeABI.Value))
    p
}

fn fx_realtime_producer_checks() -> Bool Never! {
    p :: fx_realtime_producer()
    lowered :: lir_lower_entry(p, mir_function_id("run"))
    if lowered.issues.len() != 0 || lir_lint_module(lowered.lir).len() != 0 -> return false
    workers := 0
    invokes := 0
    starts := 0
    deadlines := 0
    receipt_getters := 0
    loop function in lowered.lir.functions {
        worker :: function.name.starts_with("helper.realtime.worker.")
        invoke :: function.name.starts_with("helper.realtime.invoke.")
        if worker -> workers += 1
        if invoke -> invokes += 1
        loop block in function.blocks {
            loop instruction in block.insts {
                if instruction == .Call(_, _, callee, args) {
                    if callee == .Runtime(symbol) {
                        if invoke -> return false // invoke must not allocate/clone/drop the list
                        if worker && (symbol != "jet_rt_native_realtime_worker" || args.len() != 1) -> return false
                        if symbol == "jet_rt_native_realtime_start" {
                            if args.len() != 7 -> return false
                            starts += 1
                        }
                        if symbol == "jet_rt_next_deadline" -> deadlines += 1
                        if symbol.starts_with("jet_rt_record_get_jet_realtime_receipt_") -> receipt_getters += 1
                        if symbol.contains("JetInstant") -> return false // no Rust Instant box glue
                    }
                }
                if invoke && instruction == .Drop(_) -> return false
            }
        }
    }
    workers == 1 && invokes == 1 && starts == 2 && deadlines == 2 && receipt_getters == 8
}
