// Hand-built P1 witnesses. Expected bodies are literal golden LIR, not output
// learned from the optimizer. The runner prints and lints both sides of each.
fn ofx_builder(name: String) -> LIRFunctionBuilder Never! {
    lir_builder(LIRFunctionID{value: 0}, name, LIRSignatureID{value: 0})
}

fn ofx_const(b: &LIRFunctionBuilder, value: Int) -> LIRValueID Never! {
    id :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Const{dst: id, value: value})
    id
}

fn ofx_binary(b: &LIRFunctionBuilder, op: LIRBinaryOp, left: LIRValueID, right: LIRValueID) -> LIRValueID Never! {
    id :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Binary{dst: id, op: op, left: left, right: right})
    id
}

fn ofx_finish(b: &LIRFunctionBuilder, params: [LIRValueID], result: LIRValueID) -> LIRFunction Never! {
    lir_builder_seal(&b, LIRBlockID{value: 0}, params, LIRTerminator.Return{value: Val(result)})
    lir_builder_finish(b)
}

fn ofx_result(function: LIRFunction) -> LIRLayout? {
    loop block in function.blocks {
        if block.terminator == .Return(.Val(id)) -> return Val(function.values[id.value].layout)
    }
    None
}

fn ofx_module(function: LIRFunction) -> LIRModule Never! {
    params := [LIRLayout]{}
    loop param in function.blocks[0].params -> &params.push(function.values[param.value].layout)
    result :: ofx_result(function)
    LIRModule{signatures: [LIRSignature]{
        LIRSignature{id: LIRSignatureID{value: 0}, convention: LIRCallConv.SystemV, params: params, result: result},
        LIRSignature{id: LIRSignatureID{value: 1}, convention: LIRCallConv.SystemV, params: [LIRLayout]{}, result: None}
    }, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: lir_module_debug_none()}
}

fn ofx_check(before: LIRFunction, after: LIRFunction, expected: String) -> Bool Never! {
    input :: ofx_module(before)
    output :: LIRModule{signatures: input.signatures, functions: [LIRFunction]{after}, data: input.data, debug: input.debug}
    print("=== {before.name} before ===\n{lir_print_module(input)}=== {before.name} after ===\n{lir_print_module(output)}")
    passed := true
    loop issue in lir_lint_module(input) {
        print("FAIL {before.name} input lint b{issue.block}: {issue.message}")
        passed = false
    }
    loop issue in lir_lint_module(output) {
        print("FAIL {before.name} output lint b{issue.block}: {issue.message}")
        passed = false
    }
    if lir_print_module(output) != expected {
        print("FAIL {before.name} expected:\n{expected}")
        passed = false
    }
    if passed -> print("PASS {before.name}")
    passed
}

fn ofx_expected(before: LIRFunction, body: String) -> String Never! {
    // Print only the unchanged signature declarations; the function and body
    // below are independent literal expectations.
    program :: ofx_module(before)
    header :: lir_print_module(LIRModule{signatures: program.signatures, functions: [LIRFunction]{}, data: [LIRData]{}, debug: program.debug})
    "{header}fn f0 {before.name}: s0\n{body}\n"
}

fn ofx_simplify(function: LIRFunction, body: String) -> Bool Never! {
    ofx_check(function, lir_simplify_function(function), ofx_expected(function, body))
}

fn ofx_fold(name: String, op: LIRBinaryOp, left: Int, right: Int, expected: Int) -> Bool Never! {
    b := ofx_builder(name)
    x :: ofx_const(&b, left)
    y :: ofx_const(&b, right)
    z :: ofx_binary(&b, op, x, y)
    function :: ofx_finish(&b, [LIRValueID]{}, z)
    ofx_simplify(function, "  b0():\n    v0: i64 = const {expected}\n    ret v0")
}

fn ofx_refuse(name: String, op: LIRBinaryOp, left: Int, right: Int) -> Bool Never! {
    b := ofx_builder(name)
    x :: ofx_const(&b, left)
    y :: ofx_const(&b, right)
    z :: ofx_binary(&b, op, x, y)
    function :: ofx_finish(&b, [LIRValueID]{}, z)
    ofx_check(function, lir_simplify_function(function), lir_print_module(ofx_module(function)))
}

fn ofx_identity(name: String, op: LIRBinaryOp, constant: Int, zero: Bool, same: Bool) -> Bool Never! {
    b := ofx_builder(name)
    x :: lir_builder_word(&b)
    y :: if same -> x else -> ofx_const(&b, constant)
    z :: ofx_binary(&b, op, x, y)
    function :: ofx_finish(&b, [LIRValueID]{x}, z)
    body :: if zero -> "  b0(v0: i64):\n    v1: i64 = const 0\n    ret v1" else -> "  b0(v0: i64):\n    ret v0"
    ofx_simplify(function, body)
}

fn ofx_compare() -> Bool Never! {
    b := ofx_builder("compare")
    x :: ofx_const(&b, -4)
    y :: ofx_const(&b, 3)
    z :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Compare{dst: z, condition: LIRCondition.Lt, left: x, right: y})
    ofx_simplify(ofx_finish(&b, [LIRValueID]{}, z), "  b0():\n    v0: i8 = const 1\n    ret v0")
}

fn ofx_overflows() -> Bool Never! {
    b := ofx_builder("overflows")
    x :: ofx_const(&b, 9223372036854775807)
    y :: ofx_const(&b, 1)
    z :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Overflows{dst: z, op: LIRBinaryOp.Add, left: x, right: y})
    ofx_simplify(ofx_finish(&b, [LIRValueID]{}, z), "  b0():\n    v0: i8 = const 1\n    ret v0")
}

fn ofx_copies() -> Bool Never! {
    b := ofx_builder("copy-move")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    z :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Copy{dst: y, src: x})
    lir_builder_push(&b, LIRInst.Move{dst: z, src: y})
    ofx_simplify(ofx_finish(&b, [LIRValueID]{x}, z), "  b0(v0: i64):\n    ret v0")
}

fn ofx_float() -> Bool Never! {
    b := ofx_builder("float-not-folded")
    x :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    y :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    z :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.Const{dst: x, value: 0})
    lir_builder_push(&b, LIRInst.Const{dst: y, value: 0})
    lir_builder_push(&b, LIRInst.Binary{dst: z, op: LIRBinaryOp.Add, left: x, right: y})
    function :: ofx_finish(&b, [LIRValueID]{}, z)
    ofx_check(function, lir_simplify_function(function), lir_print_module(ofx_module(function)))
}

fn ofx_sign() -> Bool Never! {
    b := ofx_builder("sign-test")
    x :: lir_builder_word(&b)
    three :: ofx_const(&b, 3)
    bits :: ofx_binary(&b, LIRBinaryOp.Or, x, three)
    zero :: ofx_const(&b, 0)
    result :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Compare{dst: result, condition: LIRCondition.Ge, left: bits, right: zero})
    ofx_simplify(ofx_finish(&b, [LIRValueID]{x}, result), "  b0(v0: i64):\n    v1: i64 = const 0\n    v2: i8 = ge v0, v1\n    ret v2")
}

fn ofx_branch() -> Bool Never! {
    b := ofx_builder("constant-branch")
    cond :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Const{dst: cond, value: 1})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Branch{condition: cond, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    yes :: ofx_const(&b, 7)
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{}, LIRTerminator.Return{value: Val(yes)})
    no :: ofx_const(&b, 9)
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{}, LIRTerminator.Return{value: Val(no)})
    ofx_simplify(lir_builder_finish(b), "  b0():\n    v0: i64 = const 7\n    ret v0")
}

fn ofx_chain(empty: Bool) -> Bool Never! {
    b := ofx_builder(if empty -> "thread-params" else -> "block-merge")
    x :: lir_builder_word(&b)
    p :: lir_builder_word(&b)
    q :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x}, LIRTerminator.Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{x}}})
    sent := p
    if !empty {
        one :: ofx_const(&b, 1)
        sent = ofx_binary(&b, LIRBinaryOp.Add, p, one)
    }
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{p}, LIRTerminator.Jump{target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{sent}}})
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{q}, LIRTerminator.Return{value: Val(q)})
    expected :: if empty -> "  b0(v0: i64):\n    ret v0" else -> "  b0(v0: i64):\n    v1: i64 = const 1\n    v2: i64 = add v0, v1\n    ret v2"
    ofx_simplify(lir_builder_finish(b), expected)
}

fn ofx_dead_params() -> Bool Never! {
    b := ofx_builder("dead-param-all-edges")
    cond :: lir_builder_bool(&b)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    p :: lir_builder_word(&b)
    dead :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{cond, x, y}, LIRTerminator.Branch{condition: cond, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{x, y}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{y, x}}})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{p, dead}, LIRTerminator.Return{value: Val(p)})
    ofx_simplify(lir_builder_finish(b), "  b0(v0: i8, v1: i64, v2: i64):\n    br v0, b1(v1), b1(v2)\n  b1(v3: i64):\n    ret v3")
}

// An empty block whose parameter a dominated block reads directly must not be
// bypassed (the read would lose its definition); it merges with its single
// successor instead.
fn ofx_thread_param_read() -> Bool Never! {
    b := ofx_builder("thread-param-read-downstream")
    cond :: lir_builder_bool(&b)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    p :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{cond, x, y}, LIRTerminator.Branch{condition: cond, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{x}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{y}}})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{p}, LIRTerminator.Jump{target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    sum :: ofx_binary(&b, LIRBinaryOp.Add, p, p)
    lir_builder_seal(&b, LIRBlockID{value: 2}, [LIRValueID]{}, LIRTerminator.Return{value: Val(sum)})
    ofx_simplify(lir_builder_finish(b), "  b0(v0: i8, v1: i64, v2: i64):\n    br v0, b1(v1), b1(v2)\n  b1(v3: i64):\n    v4: i64 = add v3, v3\n    ret v4")
}

fn ofx_effects() -> Bool Never! {
    b := ofx_builder("effects-kept-in-order")
    ptr :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "drop_fixture"}, None)
    value :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Store{base: ptr, offset: 0, value: value})
    lir_builder_push(&b, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 1}, callee: LIRCallee.Runtime{symbol: "effect_fixture"}, args: [LIRValueID]{}})
    lir_builder_push(&b, LIRInst.Drop{value: ptr})
    ofx_simplify(ofx_finish(&b, [LIRValueID]{ptr, value}, value), "  b0(v0: ptr drop(rt drop_fixture), v1: i64):\n    store v0+0, v1\n    call rt effect_fixture(): s1\n    drop v0\n    ret v1")
}

// lower_exact_arithmetic's merge after its inline tests folded: the folded
// word is adopted into the owned Int parameter, which is dropped. The adopting
// edge keeps its single-predecessor block; merging would alias the owner to
// the trivial word and drop a value without drop glue.
fn ofx_adopting_merge() -> Bool Never! {
    b := ofx_builder("adopting-merge-kept")
    x :: ofx_const(&b, 1)
    y :: ofx_const(&b, 2)
    sum :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Jump{target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{sum}}})
    owned :: lir_builder_value(&b, lir_layout_word(), LIRDrop.Runtime{symbol: "jet_rt_int_drop"}, None)
    lir_builder_push(&b, LIRInst.Drop{value: owned})
    lir_builder_seal(&b, LIRBlockID{value: 1}, [LIRValueID]{owned}, LIRTerminator.Return{value: None})
    ofx_simplify(lir_builder_finish(b), "  b0():\n    v0: i64 = const 3\n    jmp b1(v0)\n  b1(v1: i64 drop(rt jet_rt_int_drop)):\n    drop v1\n    ret")
}

fn opt_fixtures_simplify() -> Bool Never! {
    passed := true
    if !ofx_fold("fold-add", LIRBinaryOp.Add, 7, 5, 12) -> passed = false
    if !ofx_fold("fold-mul", LIRBinaryOp.Mul, -7, 5, -35) -> passed = false
    if !ofx_compare() -> passed = false
    if !ofx_overflows() -> passed = false
    if !ofx_refuse("add-overflow-refused", LIRBinaryOp.Add, 9223372036854775807, 1) -> passed = false
    if !ofx_refuse("div-zero-refused", LIRBinaryOp.Div, 7, 0) -> passed = false
    if !ofx_refuse("div-min-negone-refused", LIRBinaryOp.Div, -9223372036854775808, -1) -> passed = false
    if !ofx_copies() -> passed = false
    if !ofx_identity("add-zero", LIRBinaryOp.Add, 0, false, false) -> passed = false
    if !ofx_identity("mul-one", LIRBinaryOp.Mul, 1, false, false) -> passed = false
    if !ofx_identity("mul-zero", LIRBinaryOp.Mul, 0, true, false) -> passed = false
    if !ofx_identity("sub-self", LIRBinaryOp.Sub, 0, true, true) -> passed = false
    if !ofx_float() -> passed = false
    if !ofx_sign() -> passed = false
    if !ofx_branch() -> passed = false
    if !ofx_chain(true) -> passed = false
    if !ofx_chain(false) -> passed = false
    if !ofx_dead_params() -> passed = false
    if !ofx_thread_param_read() -> passed = false
    if !ofx_effects() -> passed = false
    if !ofx_adopting_merge() -> passed = false
    passed
}
