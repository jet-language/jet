// W8 exact printed expectations, including unchanged value IDs and forwarded
// header parameters. Every witness lints both input and output via ofx_check.
fn olicm_check(function: LIRFunction, body: String) -> Bool Never! {
    ofx_check(function, lir_licm_function(function), ofx_expected(function, body))
}

fn olicm_arithmetic(name: String, op: LIRBinaryOp, divisor: Int?, variant: Bool) -> Bool Never! {
    b := ofx_builder(name)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    p :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{x})})
    rhs :: if divisor == .Val(value) -> ofx_const(&b, value) else -> y
    result :: ofx_binary(&b, op, if variant -> p else -> x, rhs)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{p}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{result})})
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Return{value: Val(result)})
    function :: lir_builder_finish(b)
    operation :: lir_print_binary(op)
    constant :: if divisor == .Val(value) -> "\n    v4: i64 = const {value}" else -> ""
    definition :: "\n    v{result.value}: i64 = {operation} v{if variant -> 3 else -> 0}, v{rhs.value}"
    safe := !variant
    if op == .Div || op == .Rem || op == .UDiv || op == .URem {
        safe = false
        if divisor == .Val(value) -> safe = value != 0 && ((op != .Div && op != .Rem) || value != -1)
    }
    entry_def :: if safe -> definition else -> ""
    header_def :: if safe -> "" else -> definition
    entry :: "  b0(v0: i64, v1: i64, v2: i8):{constant}{entry_def}\n    jmp b10(v0)"
    header :: "  b10(v3: i64):{header_def}\n    br v2, b20(), b30()"
    tail :: "  b20():\n    jmp b10(v{result.value})\n  b30():\n    ret v{result.value}"
    olicm_check(function, "{entry}\n{header}\n{tail}")
}

fn olicm_load(name: String, body_load: Bool, barrier: Int) -> Bool Never! {
    b := ofx_builder(name)
    pointer :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    x :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    loaded :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{pointer, x, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    if !body_load -> lir_builder_push(&b, LIRInst.Load{dst: loaded, base: pointer, offset: 8})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    if body_load -> lir_builder_push(&b, LIRInst.Load{dst: loaded, base: pointer, offset: 8})
    if barrier == 1 -> lir_builder_push(&b, LIRInst.Store{base: pointer, offset: 8, value: x})
    if barrier == 2 -> lir_builder_push(&b, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 1}, callee: LIRCallee.Runtime{symbol: "touch"}, args: [LIRValueID]{}})
    if barrier == 3 {
        owned :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
        lir_builder_push(&b, LIRInst.Const{dst: owned, value: 0})
        lir_builder_push(&b, LIRInst.Drop{value: owned})
    }
    if barrier == 4 {
        moved :: lir_builder_word(&b)
        lir_builder_push(&b, LIRInst.Move{dst: moved, src: x})
    }
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Return{value: Val(if body_load -> x else -> loaded)})
    load :: "\n    v3: i64 = load v0+8"
    hoist :: !body_load && barrier == 0
    entry_load :: if hoist -> load else -> ""
    header_load :: if !body_load && !hoist -> load else -> ""
    body_definition :: if body_load -> load else -> ""
    entry :: "  b0(v0: ptr, v1: i64, v2: i8):{entry_load}\n    jmp b10()"
    header :: "  b10():{header_load}\n    br v2, b20(), b30()"
    barrier_text :: if barrier == {
        1 -> "\n    store v0+8, v1"
        2 -> "\n    call rt touch(): s1"
        3 -> "\n    v4: ptr drop(rt owned_drop) = const 0\n    drop v4"
        4 -> "\n    v4: i64 = move v1"
        else -> ""
    }
    body :: "  b20():{body_definition}{barrier_text}\n    jmp b10()"
    exit :: "  b30():\n    ret v{if body_load -> 1 else -> 3}"
    olicm_check(lir_builder_finish(b), "{entry}\n{header}\n{body}\n{exit}")
}

fn olicm_nested() -> Bool Never! {
    b := ofx_builder("licm-nested-new-inner-preheader")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(50, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(30, [LIRValueID]{}), else_target: ofacts_target(40, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 40}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 50}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    v3: i64 = add v0, v1\n    jmp b10()\n  b10():\n    br v2, b51(), b50()\n  b20():\n    br v2, b30(), b40()\n  b30():\n    jmp b20()\n  b40():\n    jmp b10()\n  b50():\n    ret v0\n  b51():\n    jmp b20()")
}

fn olicm_preheader() -> Bool Never! {
    b := ofx_builder("licm-two-outside-predecessors-header-param")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    p :: lir_builder_value(&b, lir_layout_word(), LIRDrop.Trivial, Val(MIRTypeID{value: 77}))
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{x})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{y})})
    invariant :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    variant :: ofx_binary(&b, LIRBinaryOp.Add, p, x)
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{p}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(40, [LIRValueID]{}), else_target: ofacts_target(50, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 40}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{variant})})
    lir_builder_seal(&b, LIRBlockID{value: 50}, [LIRValueID]{}, LIRTerminator.Return{value: Val(invariant)})
    function :: lir_builder_finish(b)
    after :: lir_licm_function(function)
    expected :: "  b0(v0: i64, v1: i64, v2: i8):\n    br v2, b10(), b20()\n  b10():\n    jmp b51(v0)\n  b20():\n    jmp b51(v1)\n  b30(v3: i64):\n    v5: i64 = add v3, v0\n    br v2, b40(), b50()\n  b40():\n    jmp b30(v5)\n  b50():\n    ret v4\n  b51(v6: i64):\n    v4: i64 = add v0, v1\n    jmp b30(v6)"
    passed := ofx_check(function, after, ofx_expected(function, expected))
    if after.values.len() != 7 -> return false
    original :: function.values[p.value]
    fresh :: after.values[6]
    if fresh.layout != original.layout || fresh.drop != original.drop || fresh.jet_type != original.jet_type {
        print("FAIL licm preheader parameter metadata")
        passed = false
    }
    passed
}

fn olicm_branch_preheader(duplicate: Bool) -> Bool Never! {
    b := ofx_builder(if duplicate -> "licm-duplicate-outside-edges" else -> "licm-single-branch-outside-edge")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(if duplicate -> 10 else -> 20, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    br v2, b21(), b{if duplicate -> 21 else -> 20}()\n  b10():\n    br v2, b10(), b20()\n  b20():\n    ret v0\n  b21():\n    v3: i64 = add v0, v1\n    jmp b10()")
}

fn olicm_irreducible() -> Bool Never! {
    b := ofx_builder("licm-irreducible-two-entry-untouched")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    br v2, b10(), b20()\n  b10():\n    v3: i64 = add v0, v1\n    jmp b20()\n  b20():\n    br v2, b10(), b30()\n  b30():\n    ret v0")
}

fn olicm_float(op: LIRBinaryOp) -> Bool Never! {
    b := ofx_builder("licm-float-{lir_print_binary(op)}-hoisted-not-folded")
    x :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    y :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    result :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.Binary{dst: result, op: op, left: x, right: y})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(result)})
    olicm_check(lir_builder_finish(b), "  b0(v0: f64, v1: f64, v2: i8):\n    v3: f64 = {lir_print_binary(op)} v0, v1\n    jmp b10()\n  b10():\n    br v2, b10(), b20()\n  b20():\n    ret v3")
}

fn olicm_consumed() -> Bool Never! {
    b := ofx_builder("licm-consumed-result-kept")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    sum :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    moved :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Move{dst: moved, src: sum})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(moved)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    jmp b10()\n  b10():\n    v3: i64 = add v0, v1\n    v4: i64 = move v3\n    br v2, b10(), b20()\n  b20():\n    ret v4")
}

fn olicm_effects() -> Bool Never! {
    b := ofx_builder("licm-stackslot-overflows-copy-and-drop-kept")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    slot :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    overflow :: lir_builder_bool(&b)
    copied :: lir_builder_word(&b)
    owned :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    lir_builder_push(&b, LIRInst.StackSlot{dst: slot, size: 8, align: 8})
    lir_builder_push(&b, LIRInst.Overflows{dst: overflow, op: LIRBinaryOp.Add, left: x, right: y})
    lir_builder_push(&b, LIRInst.Copy{dst: copied, src: x})
    lir_builder_push(&b, LIRInst.Const{dst: owned, value: 0})
    lir_builder_push(&b, LIRInst.Drop{value: owned})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    jmp b10()\n  b10():\n    v3: ptr = stack 8 align 8\n    v4: i8 = overflows add v0, v1\n    v5: i64 = copy v0\n    v6: ptr drop(rt owned_drop) = const 0\n    drop v6\n    br v2, b10(), b20()\n  b20():\n    ret v0")
}

fn olicm_body_division(constant: Bool) -> Bool Never! {
    b := ofx_builder(if constant -> "licm-zero-trip-body-div-eight" else -> "licm-zero-trip-body-div-variable-kept")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    rhs :: if constant -> ofx_const(&b, 8) else -> y
    _ :: ofx_binary(&b, LIRBinaryOp.Div, x, rhs)
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    hoisted :: if constant -> "\n    v3: i64 = const 8\n    v4: i64 = div v0, v3" else -> ""
    kept :: if constant -> "" else -> "\n    v3: i64 = div v0, v1"
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):{hoisted}\n    jmp b10()\n  b10():\n    br v2, b20(), b30()\n  b20():{kept}\n    jmp b10()\n  b30():\n    ret v0")
}

// The header is stored after its latch. The second discovery sweep must
// move the dependent expression only after its header-defined constant.
fn olicm_storage_order() -> Bool Never! {
    b := ofx_builder("licm-storage-order-invariant-chain")
    x :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    one :: ofx_const(&b, 1)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, one)
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    function := lir_builder_finish(b)
    function.blocks = [LIRBlock]{function.blocks[0], function.blocks[2], function.blocks[1], function.blocks[3]}
    olicm_check(function, "  b0(v0: i64, v1: i8):\n    v2: i64 = const 1\n    v3: i64 = add v0, v2\n    jmp b10()\n  b20():\n    jmp b10()\n  b10():\n    br v1, b20(), b30()\n  b30():\n    ret v0")
}

fn olicm_pure_chain() -> Bool Never! {
    b := ofx_builder("licm-pure-chain-and-float-bits")
    pointer :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    x :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{pointer, x, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    offset :: ofx_const(&b, 8)
    address :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    loaded :: lir_builder_word(&b)
    converted :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    negative_zero :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    sum :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    compared :: lir_builder_bool(&b)
    code :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.PointerAdd{dst: address, base: pointer, offset: offset})
    lir_builder_push(&b, LIRInst.Load{dst: loaded, base: address, offset: 0})
    lir_builder_push(&b, LIRInst.Convert{dst: converted, src: x})
    lir_builder_push(&b, LIRInst.Const{dst: negative_zero, value: -9223372036854775808})
    lir_builder_push(&b, LIRInst.Binary{dst: sum, op: LIRBinaryOp.Add, left: converted, right: negative_zero})
    lir_builder_push(&b, LIRInst.Compare{dst: compared, condition: LIRCondition.Lt, left: x, right: offset})
    lir_builder_push(&b, LIRInst.FunctionAddress{dst: code, function: LIRFunctionID{value: 0}})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(loaded)})
    olicm_check(lir_builder_finish(b), "  b0(v0: ptr, v1: i64, v2: i8):\n    v3: i64 = const 8\n    v4: ptr = ptradd v0, v3\n    v5: i64 = load v4+0\n    v6: f64 = convert v1\n    v7: f64 = const -9223372036854775808\n    v8: f64 = add v6, v7\n    v9: i8 = lt v1, v3\n    v10: ptr = fnaddr f0\n    jmp b10()\n  b10():\n    br v2, b10(), b20()\n  b20():\n    ret v5")
}

fn olicm_nontrivial_load() -> Bool Never! {
    b := ofx_builder("licm-nontrivial-load-kept")
    pointer :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{pointer, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    loaded :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    lir_builder_push(&b, LIRInst.Load{dst: loaded, base: pointer, offset: 0})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(loaded)})
    olicm_check(lir_builder_finish(b), "  b0(v0: ptr, v1: i8):\n    jmp b10()\n  b10():\n    v2: ptr drop(rt owned_drop) = load v0+0\n    br v1, b10(), b20()\n  b20():\n    ret v2")
}

fn olicm_multiple_latches() -> Bool Never! {
    b := ofx_builder("licm-multiple-latches-merged")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(20, [LIRValueID]{}), else_target: ofacts_target(30, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(40, [LIRValueID]{})})
    _ :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 40}, [LIRValueID]{}, LIRTerminator.Return{value: Val(x)})
    olicm_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    v3: i64 = add v0, v1\n    v4: i64 = add v0, v1\n    jmp b10()\n  b10():\n    br v2, b20(), b30()\n  b20():\n    br v2, b10(), b40()\n  b30():\n    jmp b10()\n  b40():\n    ret v0")
}

fn opt_fixtures_licm() -> Bool Never! {
    passed := true
    if !olicm_arithmetic("licm-invariant-add", LIRBinaryOp.Add, None, false) -> passed = false
    if !olicm_arithmetic("licm-variant-add", LIRBinaryOp.Add, None, true) -> passed = false
    if !olicm_arithmetic("licm-div-variable-kept", LIRBinaryOp.Div, None, false) -> passed = false
    if !olicm_arithmetic("licm-div-eight-hoisted", LIRBinaryOp.Div, Val(8), false) -> passed = false
    if !olicm_arithmetic("licm-div-zero-kept", LIRBinaryOp.Div, Val(0), false) -> passed = false
    if !olicm_arithmetic("licm-div-minus-one-kept", LIRBinaryOp.Div, Val(-1), false) -> passed = false
    if !olicm_arithmetic("licm-rem-eight-hoisted", LIRBinaryOp.Rem, Val(8), false) -> passed = false
    if !olicm_arithmetic("licm-rem-minus-one-kept", LIRBinaryOp.Rem, Val(-1), false) -> passed = false
    if !olicm_arithmetic("licm-udiv-eight-hoisted", LIRBinaryOp.UDiv, Val(8), false) -> passed = false
    if !olicm_arithmetic("licm-urem-zero-kept", LIRBinaryOp.URem, Val(0), false) -> passed = false
    if !olicm_load("licm-header-load-hoisted", false, 0) -> passed = false
    if !olicm_load("licm-header-load-store-kept", false, 1) -> passed = false
    if !olicm_load("licm-header-load-call-kept", false, 2) -> passed = false
    if !olicm_load("licm-header-load-drop-kept", false, 3) -> passed = false
    if !olicm_load("licm-header-load-move-kept", false, 4) -> passed = false
    if !olicm_load("licm-body-load-kept", true, 0) -> passed = false
    if !olicm_nested() -> passed = false
    if !olicm_preheader() -> passed = false
    if !olicm_branch_preheader(false) -> passed = false
    if !olicm_branch_preheader(true) -> passed = false
    if !olicm_irreducible() -> passed = false
    if !olicm_float(LIRBinaryOp.Add) -> passed = false
    if !olicm_float(LIRBinaryOp.Div) -> passed = false
    if !olicm_consumed() -> passed = false
    if !olicm_body_division(false) -> passed = false
    if !olicm_body_division(true) -> passed = false
    if !olicm_storage_order() -> passed = false
    if !olicm_effects() -> passed = false
    if !olicm_pure_chain() -> passed = false
    if !olicm_nontrivial_load() -> passed = false
    if !olicm_multiple_latches() -> passed = false
    passed
}
