// P4/P5 module witnesses: literal caller bodies, untouched original callees.
// This uses W1's shared helpers and runner; every module is printed and linted.
fn ofxi_sig(id: Int, params: [LIRLayout], result: LIRLayout?) -> LIRSignature Never! {
    LIRSignature{id: LIRSignatureID{value: id}, convention: LIRCallConv.SystemV, params: params, result: result}
}

fn ofxi_module(functions: [LIRFunction]) -> LIRModule Never! {
    w :: lir_layout_word()
    p :: lir_layout_pointer()
    LIRModule{signatures: [LIRSignature]{
        ofxi_sig(0, [LIRLayout]{w}, Val(w)),
        ofxi_sig(1, [LIRLayout]{}, None),
        ofxi_sig(2, [LIRLayout]{w, lir_layout_bool()}, Val(w)),
        ofxi_sig(3, [LIRLayout]{}, Val(w)),
        ofxi_sig(4, [LIRLayout]{w}, Val(lir_layout_float())),
        ofxi_sig(5, [LIRLayout]{p}, None),
        ofxi_sig(6, [LIRLayout]{p}, Val(p)),
        ofxi_sig(7, [LIRLayout]{w}, None)
    }, functions: functions, data: [LIRData]{}, debug: lir_module_debug_none()}
}

fn ofxi_builder(id: Int, name: String, signature: Int) -> LIRFunctionBuilder Never! {
    lir_builder(LIRFunctionID{value: id}, name, LIRSignatureID{value: signature})
}

fn ofxi_call(b: &LIRFunctionBuilder, dst: LIRValueID?, signature: Int, callee: LIRCallee, args: [LIRValueID]) Never! {
    lir_builder_push(&b, LIRInst.Call{dst: dst, signature: LIRSignatureID{value: signature}, callee: callee, args: args})
}

fn ofxi_function(id: Int) -> LIRCallee Never! { LIRCallee.Function{id: LIRFunctionID{value: id}} }

fn ofxi_leaf() -> LIRFunction Never! {
    b := ofxi_builder(1, "leaf", 0)
    x :: lir_builder_word(&b)
    one :: ofx_const(&b, 1)
    y :: ofx_binary(&b, LIRBinaryOp.Add, x, one)
    ofx_finish(&b, [LIRValueID]{x}, y)
}

fn ofxi_check(before: LIRModule, caller_body: String) -> Bool Never! {
    // copy: the expected text and the input lint below read `before`.
    after :: lir_inline_module(before.copy())
    header :: lir_print_module(LIRModule{signatures: before.signatures, functions: [LIRFunction]{}, data: before.data, debug: before.debug})
    expected := "{header}{caller_body}\n"
    loop (index, function) in before.functions {
        if index > 0 -> expected = "{expected}{lir_print_module(LIRModule{signatures: [LIRSignature]{}, functions: [LIRFunction]{function}, data: [LIRData]{}, debug: before.debug})}"
    }
    print("=== {before.functions[0].name} before ===\n{lir_print_module(before)}=== {before.functions[0].name} after ===\n{lir_print_module(after)}")
    passed := true
    loop issue in lir_lint_module(before) {
        print("FAIL {before.functions[0].name} input lint b{issue.block}: {issue.message}")
        passed = false
    }
    loop issue in lir_lint_module(after) {
        print("FAIL {before.functions[0].name} output lint b{issue.block}: {issue.message}")
        passed = false
    }
    if lir_print_module(after) != expected {
        print("FAIL {before.functions[0].name} expected:\n{expected}")
        passed = false
    }
    if passed -> print("PASS {before.functions[0].name}")
    passed
}

fn ofxi_leaf_case(pointer: Bool) -> Bool Never! {
    b := ofxi_builder(0, if pointer -> "closure-direct" else -> "leaf-suffix", 0)
    x :: lir_builder_word(&b)
    callee := ofxi_function(1)
    if pointer {
        address :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
        lir_builder_push(&b, LIRInst.FunctionAddress{dst: address, function: LIRFunctionID{value: 1}})
        callee = LIRCallee.Value{value: address}
    }
    y :: lir_builder_word(&b)
    ofxi_call(&b, Val(y), 0, callee, [LIRValueID]{x})
    if pointer {
        before :: ofxi_module([LIRFunction]{ofx_finish(&b, [LIRValueID]{x}, y), ofxi_leaf()})
        return ofxi_check(before, "fn f0 closure-direct: s0\n  b0(v0: i64):\n    v1: ptr = fnaddr f1\n    jmp b1()\n  b1():\n    v3: i64 = const 1\n    v4: i64 = add v0, v3\n    jmp b2(v4)\n  b2(v2: i64):\n    ret v2")
    }
    two :: ofx_const(&b, 2)
    z :: ofx_binary(&b, LIRBinaryOp.Add, y, two)
    // Sparse IDs prove fresh blocks start at max ID + 1, not blocks.len().
    lir_builder_seal(&b, LIRBlockID{value: 7}, [LIRValueID]{x}, LIRTerminator.Return{value: Val(z)})
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), ofxi_leaf()}), "fn f0 leaf-suffix: s0\n  b7(v0: i64):\n    jmp b8()\n  b8():\n    v4: i64 = const 1\n    v5: i64 = add v0, v4\n    jmp b9(v5)\n  b9(v1: i64):\n    v2: i64 = const 2\n    v3: i64 = add v1, v2\n    ret v3")
}

fn ofxi_loop() -> Bool Never! {
    b := ofxi_builder(0, "loop-call", 2)
    x :: lir_builder_word(&b)
    c :: lir_builder_bool(&b)
    p :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    q :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, c}, LIRTerminator.Jump{target: LIRJumpTarget{block: LIRBlockID{value: 5}, args: [LIRValueID]{x}}})
    ofxi_call(&b, Val(y), 0, ofxi_function(1), [LIRValueID]{p})
    lir_builder_seal(&b, LIRBlockID{value: 5}, [LIRValueID]{p}, LIRTerminator.Branch{condition: c, then_target: LIRJumpTarget{block: LIRBlockID{value: 5}, args: [LIRValueID]{y}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 6}, args: [LIRValueID]{y}}})
    lir_builder_seal(&b, LIRBlockID{value: 6}, [LIRValueID]{q}, LIRTerminator.Return{value: Val(q)})
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), ofxi_leaf()}), "fn f0 loop-call: s2\n  b0(v0: i64, v1: i8):\n    jmp b5(v0)\n  b5(v2: i64):\n    jmp b7()\n  b7():\n    v5: i64 = const 1\n    v6: i64 = add v2, v5\n    jmp b8(v6)\n  b8(v3: i64):\n    br v1, b5(v3), b6(v3)\n  b6(v4: i64):\n    ret v4")
}

fn ofxi_two_returns() -> Bool Never! {
    b := ofxi_builder(0, "two-returns", 2)
    x :: lir_builder_word(&b)
    c :: lir_builder_bool(&b)
    y :: lir_builder_word(&b)
    ofxi_call(&b, Val(y), 2, ofxi_function(1), [LIRValueID]{x, c})
    caller :: ofx_finish(&b, [LIRValueID]{x, c}, y)
    leaf := ofxi_builder(1, "choose", 2)
    a :: lir_builder_word(&leaf)
    cond :: lir_builder_bool(&leaf)
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{a, cond}, LIRTerminator.Branch{condition: cond, then_target: LIRJumpTarget{block: LIRBlockID{value: 1}, args: [LIRValueID]{}}, else_target: LIRJumpTarget{block: LIRBlockID{value: 2}, args: [LIRValueID]{}}})
    lir_builder_seal(&leaf, LIRBlockID{value: 1}, [LIRValueID]{}, LIRTerminator.Return{value: Val(a)})
    nine :: ofx_const(&leaf, 9)
    lir_builder_seal(&leaf, LIRBlockID{value: 2}, [LIRValueID]{}, LIRTerminator.Return{value: Val(nine)})
    ofxi_check(ofxi_module([LIRFunction]{caller, lir_builder_finish(leaf)}), "fn f0 two-returns: s2\n  b0(v0: i64, v1: i8):\n    jmp b1()\n  b1():\n    br v1, b2(), b3()\n  b2():\n    jmp b4(v0)\n  b3():\n    v3: i64 = const 9\n    jmp b4(v3)\n  b4(v2: i64):\n    ret v2")
}

fn ofxi_recursion(mutual: Bool, pointer: Bool) -> Bool Never! {
    b := ofxi_builder(0, if mutual -> "mutual-recursion" else -> "self-recursion", 0)
    x :: lir_builder_word(&b)
    target := ofxi_function(if mutual -> 1 else -> 0)
    if pointer {
        p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
        lir_builder_push(&b, LIRInst.FunctionAddress{dst: p, function: LIRFunctionID{value: 0}})
        target = LIRCallee.Value{value: p}
    }
    y :: lir_builder_word(&b)
    ofxi_call(&b, Val(y), 0, target, [LIRValueID]{x})
    functions := [LIRFunction]{ofx_finish(&b, [LIRValueID]{x}, y)}
    if mutual {
        leaf := ofxi_builder(1, "mutual-peer", 0)
        a :: lir_builder_word(&leaf)
        z :: lir_builder_word(&leaf)
        ofxi_call(&leaf, Val(z), 0, ofxi_function(0), [LIRValueID]{a})
        &functions.push(ofx_finish(&leaf, [LIRValueID]{a}, z))
        return ofxi_check(ofxi_module(functions), "fn f0 mutual-recursion: s0\n  b0(v0: i64):\n    v1: i64 = call f1(v0): s0\n    ret v1")
    }
    expected :: if pointer -> "fn f0 self-recursion: s0\n  b0(v0: i64):\n    v1: ptr = fnaddr f0\n    v2: i64 = call f0(v0): s0\n    ret v2" else -> "fn f0 self-recursion: s0\n  b0(v0: i64):\n    v1: i64 = call f0(v0): s0\n    ret v1"
    ofxi_check(ofxi_module(functions), expected)
}

fn ofxi_mismatch() -> Bool Never! {
    b := ofxi_builder(0, "signature-mismatch", 4)
    x :: lir_builder_word(&b)
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    y :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.FunctionAddress{dst: p, function: LIRFunctionID{value: 1}})
    ofxi_call(&b, Val(y), 4, LIRCallee.Value{value: p}, [LIRValueID]{x})
    ofxi_check(ofxi_module([LIRFunction]{ofx_finish(&b, [LIRValueID]{x}, y), ofxi_leaf()}), "fn f0 signature-mismatch: s4\n  b0(v0: i64):\n    v1: ptr = fnaddr f1\n    v2: f64 = call *v1(v0): s4\n    ret v2")
}

fn ofxi_owned(move: Bool) -> Bool Never! {
    sig :: if move -> 6 else -> 5
    b := ofxi_builder(0, if move -> "move-param" else -> "drop-param", sig)
    x :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "fixture_drop"}, None)
    result := inline_no_result()
    if move -> result = Val(lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "fixture_drop"}, None))
    ofxi_call(&b, result, sig, ofxi_function(1), [LIRValueID]{x})
    if !move -> ofxi_call(&b, None, 1, LIRCallee.Runtime{symbol: "after_drop"}, [LIRValueID]{})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x}, LIRTerminator.Return{value: result})
    leaf := ofxi_builder(1, "consume", sig)
    p :: lir_builder_value(&leaf, lir_layout_pointer(), LIRDrop.Runtime{symbol: "fixture_drop"}, None)
    returned := inline_no_result()
    if move {
        q :: lir_builder_value(&leaf, lir_layout_pointer(), LIRDrop.Runtime{symbol: "fixture_drop"}, None)
        lir_builder_push(&leaf, LIRInst.Move{dst: q, src: p})
        returned = Val(q)
    } else {
        lir_builder_push(&leaf, LIRInst.Drop{value: p})
    }
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{p}, LIRTerminator.Return{value: returned})
    expected :: if move -> "fn f0 move-param: s6\n  b0(v0: ptr drop(rt fixture_drop)):\n    jmp b1()\n  b1():\n    v2: ptr drop(rt fixture_drop) = move v0\n    jmp b2(v2)\n  b2(v1: ptr drop(rt fixture_drop)):\n    ret v1" else -> "fn f0 drop-param: s5\n  b0(v0: ptr drop(rt fixture_drop)):\n    jmp b1()\n  b1():\n    drop v0\n    jmp b2()\n  b2():\n    call rt after_drop(): s1\n    ret"
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), lir_builder_finish(leaf)}), expected)
}

fn ofxi_stack() -> Bool Never! {
    b := ofxi_builder(0, "stack-sites", 1)
    ofxi_call(&b, None, 1, ofxi_function(1), [LIRValueID]{})
    ofxi_call(&b, None, 1, ofxi_function(1), [LIRValueID]{})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})
    leaf := ofxi_builder(1, "stack-leaf", 1)
    p :: lir_builder_value(&leaf, lir_layout_pointer(), LIRDrop.Trivial, None)
    lir_builder_push(&leaf, LIRInst.StackSlot{dst: p, size: 8, align: 8})
    seven :: ofx_const(&leaf, 7)
    lir_builder_push(&leaf, LIRInst.Store{base: p, offset: 0, value: seven})
    loaded :: lir_builder_word(&leaf)
    lir_builder_push(&leaf, LIRInst.Load{dst: loaded, base: p, offset: 0})
    ofxi_call(&leaf, None, 7, LIRCallee.Runtime{symbol: "observe"}, [LIRValueID]{loaded})
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), lir_builder_finish(leaf)}), "fn f0 stack-sites: s1\n  b0():\n    jmp b1()\n  b1():\n    v0: ptr = stack 8 align 8\n    v1: i64 = const 7\n    store v0+0, v1\n    v2: i64 = load v0+0\n    call rt observe(v2): s7\n    jmp b2()\n  b2():\n    jmp b3()\n  b3():\n    v3: ptr = stack 8 align 8\n    v4: i64 = const 7\n    store v3+0, v4\n    v5: i64 = load v3+0\n    call rt observe(v5): s7\n    jmp b4()\n  b4():\n    ret")
}

fn ofxi_unreachable() -> Bool Never! {
    b := ofxi_builder(0, "noreturn", 3)
    result :: lir_builder_word(&b)
    ofxi_call(&b, None, 1, ofxi_function(1), [LIRValueID]{})
    lir_builder_push(&b, LIRInst.Const{dst: result, value: 42})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: Val(result)})
    leaf := ofxi_builder(1, "abort", 1)
    ofxi_call(&leaf, None, 1, LIRCallee.Runtime{symbol: "abort"}, [LIRValueID]{})
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Unreachable)
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), lir_builder_finish(leaf)}), "fn f0 noreturn: s3\n  b0():\n    jmp b1()\n  b1():\n    call rt abort(): s1\n    unreachable")
}

// Boundary witnesses keep their generated bodies independent from the pass:
// count calls, clone sites, and exact per-site instruction count, then lint.
fn ofxi_limit(size: Int, calls: Int, expected_sites: Int) -> Bool Never! {
    b := ofxi_builder(0, "limit-{size}-{calls}", 1)
    loop _ in 0..<calls -> ofxi_call(&b, None, 1, ofxi_function(1), [LIRValueID]{})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})
    leaf := ofxi_builder(1, "sized-leaf", 1)
    loop _ in 0..<size -> ofxi_call(&leaf, None, 1, LIRCallee.Runtime{symbol: "effect"}, [LIRValueID]{})
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{}, LIRTerminator.Return{value: None})
    before :: ofxi_module([LIRFunction]{lir_builder_finish(b), lir_builder_finish(leaf)})
    // copy: `before` is printed and linted below.
    after :: lir_inline_module(before.copy())
    print("=== {before.functions[0].name} before ===\n{lir_print_module(before)}=== {before.functions[0].name} after ===\n{lir_print_module(after)}")
    passed := true
    loop issue in lir_lint_module(before) {
        print("FAIL input lint: {issue.message}")
        passed = false
    }
    loop issue in lir_lint_module(after) {
        print("FAIL output lint: {issue.message}")
        passed = false
    }
    direct := 0
    effects := 0
    loop block in after.functions[0].blocks {
        loop inst in block.insts {
            if inst == .Call(_, _, callee, _) {
                if callee == .Function(_) -> direct += 1
                if callee == .Runtime(_) -> effects += 1
            }
        }
    }
    if direct != calls - expected_sites || effects != size * expected_sites || after.functions[0].blocks.len() != 1 + 2 * expected_sites {
        print("FAIL limit-{size}-{calls}: direct={direct}, effects={effects}")
        passed = false
    }
    if passed -> print("PASS limit-{size}-{calls}")
    passed
}

fn ofxi_alias_refusal(different_drop: Bool) -> Bool Never! {
    b := ofxi_builder(0, if different_drop -> "drop-mismatch-refused" else -> "consumed-reuse-refused", 5)
    x :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "caller_drop"}, None)
    ofxi_call(&b, None, 5, ofxi_function(1), [LIRValueID]{x})
    if !different_drop -> ofxi_call(&b, None, 5, LIRCallee.Runtime{symbol: "reuse"}, [LIRValueID]{x})
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x}, LIRTerminator.Return{value: None})
    leaf := ofxi_builder(1, "drop-leaf", 5)
    glue :: if different_drop -> "callee_drop" else -> "caller_drop"
    p :: lir_builder_value(&leaf, lir_layout_pointer(), LIRDrop.Runtime{symbol: glue}, None)
    lir_builder_push(&leaf, LIRInst.Drop{value: p})
    lir_builder_seal(&leaf, LIRBlockID{value: 0}, [LIRValueID]{p}, LIRTerminator.Return{value: None})
    expected :: if different_drop -> "fn f0 drop-mismatch-refused: s5\n  b0(v0: ptr drop(rt caller_drop)):\n    call f1(v0): s5\n    ret" else -> "fn f0 consumed-reuse-refused: s5\n  b0(v0: ptr drop(rt caller_drop)):\n    call f1(v0): s5\n    call rt reuse(v0): s5\n    ret"
    ofxi_check(ofxi_module([LIRFunction]{lir_builder_finish(b), lir_builder_finish(leaf)}), expected)
}

// Bottom-up order: f0 -> f1 (a wrapper) -> f2 (the leaf). f1 is visited
// first and absorbs f2, so f0 inlines f1's final body and keeps no call;
// the one-level inliner left `call f2` in f0. The leaf stays as it was.
fn ofxi_chain_module() -> LIRModule Never! {
    b := ofxi_builder(0, "chain-caller", 0)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    ofxi_call(&b, Val(y), 0, ofxi_function(1), [LIRValueID]{x})
    caller :: ofx_finish(&b, [LIRValueID]{x}, y)
    w := ofxi_builder(1, "chain-wrapper", 0)
    a :: lir_builder_word(&w)
    r :: lir_builder_word(&w)
    ofxi_call(&w, Val(r), 0, ofxi_function(2), [LIRValueID]{a})
    wrapper :: ofx_finish(&w, [LIRValueID]{a}, r)
    leaf := ofxi_leaf()
    leaf.id = LIRFunctionID{value: 2}
    ofxi_module([LIRFunction]{caller, wrapper, leaf})
}

fn ofxi_direct_calls(function: LIRFunction) -> Int Never! {
    count := 0
    loop block in function.blocks {
        loop inst in block.insts {
            if inst == .Call(_, _, callee, _) {
                if callee == .Function(_) -> count += 1
            }
        }
    }
    count
}

fn ofxi_chain(optimized: Bool) -> Bool Never! {
    before :: ofxi_chain_module()
    // copy: the leaf check below compares against `before`.
    after :: if optimized -> lir_optimize_module(before.copy(), 1) else -> lir_inline_module(before.copy())
    label :: if optimized -> "chain-o1" else -> "chain-inline"
    print("=== {label} after ===\n{lir_print_module(after)}")
    passed := true
    loop issue in lir_lint_module(after) {
        print("FAIL {label} output lint f{issue.function} b{issue.block}: {issue.message}")
        passed = false
    }
    if ofxi_direct_calls(after.functions[0]) != 0 || ofxi_direct_calls(after.functions[1]) != 0 {
        print("FAIL {label}: a wrapper call survived")
        passed = false
    }
    leaf_text :: lir_print_module(LIRModule{signatures: [LIRSignature]{}, functions: [LIRFunction]{after.functions[2]}, data: [LIRData]{}, debug: before.debug})
    if leaf_text != lir_print_module(LIRModule{signatures: [LIRSignature]{}, functions: [LIRFunction]{before.functions[2]}, data: [LIRData]{}, debug: before.debug}) {
        print("FAIL {label}: the leaf changed")
        passed = false
    }
    if optimized {
        // O1 folds the whole chain to the leaf's own arithmetic.
        expected :: "fn f0 chain-caller: s0\n  b0(v0: i64):\n    v1: i64 = const 1\n    v2: i64 = add v0, v1\n    ret v2\n"
        caller_text :: lir_print_module(LIRModule{signatures: [LIRSignature]{}, functions: [LIRFunction]{after.functions[0]}, data: [LIRData]{}, debug: before.debug})
        if caller_text != expected {
            print("FAIL {label} expected:\n{expected}")
            passed = false
        }
    }
    if passed -> print("PASS {label}")
    passed
}

fn opt_fixtures_inline() -> Bool Never! {
    passed := true
    if !ofxi_leaf_case(false) -> passed = false
    if !ofxi_leaf_case(true) -> passed = false
    if !ofxi_loop() -> passed = false
    if !ofxi_two_returns() -> passed = false
    if !ofxi_recursion(false, false) -> passed = false
    if !ofxi_recursion(true, false) -> passed = false
    if !ofxi_recursion(false, true) -> passed = false
    if !ofxi_mismatch() -> passed = false
    if !ofxi_owned(false) -> passed = false
    if !ofxi_owned(true) -> passed = false
    if !ofxi_stack() -> passed = false
    if !ofxi_unreachable() -> passed = false
    if !ofxi_limit(40, 6, 5) -> passed = false
    if !ofxi_limit(41, 1, 0) -> passed = false
    if !ofxi_limit(0, 2, 2) -> passed = false
    if !ofxi_alias_refusal(true) -> passed = false
    if !ofxi_alias_refusal(false) -> passed = false
    if !ofxi_chain(false) -> passed = false
    if !ofxi_chain(true) -> passed = false
    passed
}
