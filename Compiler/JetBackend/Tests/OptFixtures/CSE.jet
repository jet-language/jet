// P6 expectations are literal printed LIR (not derived from the pass).
fn ocse_check(function: LIRFunction, body: String) -> Bool Never! {
    ofx_check(function, lir_cse_function(function), ofx_expected(function, body))
}

fn ocse_binary(name: String, op: LIRBinaryOp, swapped: Bool) -> Bool Never! {
    b := ofx_builder(name)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    first :: ofx_binary(&b, op, x, y)
    second :: ofx_binary(&b, op, if swapped -> y else -> x, if swapped -> x else -> y)
    total :: ofx_binary(&b, LIRBinaryOp.Mul, first, second)
    function :: ofx_finish(&b, [LIRValueID]{x, y}, total)
    operation :: lir_print_binary(op)
    if swapped -> return ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
    ocse_check(function, "  b0(v0: i64, v1: i64):\n    v2: i64 = {operation} v0, v1\n    v3: i64 = mul v2, v2\n    ret v3")
}

fn ocse_compare() -> Bool Never! {
    b := ofx_builder("cse-compare")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    a :: lir_builder_bool(&b)
    c :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Compare{dst: a, condition: LIRCondition.Ge, left: x, right: y})
    lir_builder_push(&b, LIRInst.Compare{dst: c, condition: LIRCondition.Ge, left: x, right: y})
    ocse_check(ofx_finish(&b, [LIRValueID]{x, y}, c), "  b0(v0: i64, v1: i64):\n    v2: i8 = ge v0, v1\n    ret v2")
}

fn ocse_pointer_load() -> Bool Never! {
    b := ofx_builder("cse-pointer-load-renamed")
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    offset :: ofx_const(&b, 8)
    a :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    c :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.PointerAdd{dst: a, base: p, offset: offset})
    lir_builder_push(&b, LIRInst.PointerAdd{dst: c, base: p, offset: offset})
    lir_builder_push(&b, LIRInst.Load{dst: x, base: a, offset: 0})
    lir_builder_push(&b, LIRInst.Load{dst: y, base: c, offset: 0})
    ocse_check(ofx_finish(&b, [LIRValueID]{p}, y), "  b0(v0: ptr):\n    v1: i64 = const 8\n    v2: ptr = ptradd v0, v1\n    v3: i64 = load v2+0\n    ret v3")
}

fn ocse_load_barrier(name: String, barrier: Int) -> Bool Never! {
    b := ofx_builder(name)
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    owned :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Load{dst: x, base: p, offset: 0})
    if barrier == 1 -> lir_builder_push(&b, LIRInst.Store{base: p, offset: 0, value: x})
    if barrier == 2 -> lir_builder_push(&b, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 1}, callee: LIRCallee.Runtime{symbol: "touch"}, args: [LIRValueID]{}})
    if barrier == 3 -> lir_builder_push(&b, LIRInst.Drop{value: owned})
    if barrier == 4 -> lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{p, owned}, LIRTerminator.Jump{target: ofacts_target(7, [LIRValueID]{})})
    lir_builder_push(&b, LIRInst.Load{dst: y, base: p, offset: 0})
    if barrier == 4 -> lir_builder_seal(&b, LIRBlockID{value: 7}, [LIRValueID]{}, LIRTerminator.Return{value: Val(y)})
    function :: if barrier == 4 -> lir_builder_finish(b) else -> ofx_finish(&b, [LIRValueID]{p, owned}, y)
    ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
}

fn ocse_convert_float() -> Bool Never! {
    b := ofx_builder("cse-convert-float")
    x :: lir_builder_word(&b)
    a :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    c :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    sum :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.Convert{dst: a, src: x})
    lir_builder_push(&b, LIRInst.Convert{dst: c, src: x})
    lir_builder_push(&b, LIRInst.Binary{dst: sum, op: LIRBinaryOp.Add, left: a, right: c})
    ocse_check(ofx_finish(&b, [LIRValueID]{x}, sum), "  b0(v0: i64):\n    v1: f64 = convert v0\n    v2: f64 = add v1, v1\n    ret v2")
}

fn ocse_function_address() -> Bool Never! {
    b := ofx_builder("cse-function-address")
    a :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    c :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.FunctionAddress{dst: a, function: LIRFunctionID{value: 0}})
    lir_builder_push(&b, LIRInst.FunctionAddress{dst: c, function: LIRFunctionID{value: 0}})
    ocse_check(ofx_finish(&b, [LIRValueID]{}, c), "  b0():\n    v0: ptr = fnaddr f0\n    ret v0")
}

fn ocse_data_address() -> Bool Never! {
    b := ofx_builder("cse-data-address")
    a :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    c :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.DataAddress{dst: a, data: LIRDataID{value: 0}})
    lir_builder_push(&b, LIRInst.DataAddress{dst: c, data: LIRDataID{value: 0}})
    function :: ofx_finish(&b, [LIRValueID]{}, c)
    input := ofx_module(function)
    input.data = [LIRData]{LIRData{id: LIRDataID{value: 0}, bytes: [U8]{U8{42}}, align: 1, relocs: [LIRDataReloc]{}}}
    output :: LIRModule{signatures: input.signatures, functions: [LIRFunction]{lir_cse_function(function)}, data: input.data, debug: input.debug}
    print("=== {function.name} before ===\n{lir_print_module(input)}=== {function.name} after ===\n{lir_print_module(output)}")
    header :: lir_print_module(LIRModule{signatures: input.signatures, functions: [LIRFunction]{}, data: input.data, debug: input.debug})
    passed := lir_print_module(output) == ("{header}fn f0 cse-data-address: s0\n  b0():\n    v0: ptr = data d0\n    ret v0\n")
    loop issue in lir_lint_module(input) {
        print("FAIL input {issue.message}")
        passed = false
    }
    loop issue in lir_lint_module(output) {
        print("FAIL output {issue.message}")
        passed = false
    }
    if passed -> print("PASS cse-data-address") else -> print("FAIL cse-data-address")
    passed
}

fn ocse_dominance(reorder: Bool) -> Bool Never! {
    b := ofx_builder(if reorder -> "cse-storage-order" else -> "cse-dominated-edge")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    a :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    duplicate :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{duplicate})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(a)})
    p :: lir_builder_word(&b)
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{p}, LIRTerminator.Return{value: Val(p)})
    function := lir_builder_finish(b)
    if reorder -> function.blocks = [LIRBlock]{function.blocks[0], function.blocks[3], function.blocks[2], function.blocks[1]}
    entry :: "  b0(v0: i64, v1: i64, v2: i8):\n    v3: i64 = add v0, v1\n    br v2, b10(), b20()"
    ten :: "  b10():\n    jmp b30(v3)"
    twenty :: "  b20():\n    ret v3"
    thirty :: "  b30(v4: i64):\n    ret v4"
    ocse_check(function, if reorder -> "{entry}\n{thirty}\n{twenty}\n{ten}" else -> "{entry}\n{ten}\n{twenty}\n{thirty}")
}

fn ocse_siblings() -> Bool Never! {
    b := ofx_builder("cse-siblings-and-join-refused")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    first :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{first})})
    second :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Jump{target: ofacts_target(30, [LIRValueID]{second})})
    p :: lir_builder_word(&b)
    third :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 30}, [LIRValueID]{p}, LIRTerminator.Return{value: Val(third)})
    function :: lir_builder_finish(b)
    ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
}

fn ocse_consumed(later: Bool) -> Bool Never! {
    b := ofx_builder(if later -> "cse-consumed-later-refused" else -> "cse-consumed-earlier-refused")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    a :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    c :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    moved :: lir_builder_word(&b)
    lir_builder_push(&b, LIRInst.Move{dst: moved, src: if later -> c else -> a})
    function :: ofx_finish(&b, [LIRValueID]{x, y}, if later -> a else -> c)
    ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
}

fn ocse_owned_load() -> Bool Never! {
    b := ofx_builder("cse-owned-load-refused")
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    a :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    c :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    lir_builder_push(&b, LIRInst.Load{dst: a, base: p, offset: 0})
    lir_builder_push(&b, LIRInst.Load{dst: c, base: p, offset: 0})
    lir_builder_push(&b, LIRInst.Drop{value: a})
    function :: ofx_finish(&b, [LIRValueID]{p}, c)
    ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
}

fn ocse_pure_effects() -> Bool Never! {
    b := ofx_builder("cse-pure-across-effects")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    owned :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Runtime{symbol: "owned_drop"}, None)
    a :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_push(&b, LIRInst.Call{dst: None, signature: LIRSignatureID{value: 1}, callee: LIRCallee.Runtime{symbol: "touch"}, args: [LIRValueID]{}})
    lir_builder_push(&b, LIRInst.Store{base: p, offset: 0, value: x})
    lir_builder_push(&b, LIRInst.Drop{value: owned})
    c :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    ocse_check(ofx_finish(&b, [LIRValueID]{x, y, p, owned}, c), "  b0(v0: i64, v1: i64, v2: ptr, v3: ptr drop(rt owned_drop)):\n    v4: i64 = add v0, v1\n    call rt touch(): s1\n    store v2+0, v0\n    drop v3\n    ret v4")
}

fn ocse_loop() -> Bool Never! {
    b := ofx_builder("cse-loop-dominator")
    x :: lir_builder_word(&b)
    y :: lir_builder_word(&b)
    gate :: lir_builder_bool(&b)
    first :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 0}, [LIRValueID]{x, y, gate}, LIRTerminator.Jump{target: ofacts_target(10, [LIRValueID]{})})
    second :: ofx_binary(&b, LIRBinaryOp.Add, x, y)
    lir_builder_seal(&b, LIRBlockID{value: 10}, [LIRValueID]{}, LIRTerminator.Branch{condition: gate, then_target: ofacts_target(10, [LIRValueID]{}), else_target: ofacts_target(20, [LIRValueID]{})})
    lir_builder_seal(&b, LIRBlockID{value: 20}, [LIRValueID]{}, LIRTerminator.Return{value: Val(second)})
    ocse_check(lir_builder_finish(b), "  b0(v0: i64, v1: i64, v2: i8):\n    v3: i64 = add v0, v1\n    jmp b10()\n  b10():\n    br v2, b10(), b20()\n  b20():\n    ret v3")
}

fn ocse_float_identical() -> Bool Never! {
    b := ofx_builder("cse-float-identical-not-reassociated")
    x :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    y :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    a :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    c :: lir_builder_value(&b, lir_layout_float(), LIRDrop.Trivial, None)
    lir_builder_push(&b, LIRInst.Binary{dst: a, op: LIRBinaryOp.Add, left: x, right: y})
    lir_builder_push(&b, LIRInst.Binary{dst: c, op: LIRBinaryOp.Add, left: x, right: y})
    ocse_check(ofx_finish(&b, [LIRValueID]{x, y}, c), "  b0(v0: f64, v1: f64):\n    v2: f64 = add v0, v1\n    ret v2")
}

fn ocse_load_key() -> Bool Never! {
    b := ofx_builder("cse-load-layout-and-offset-key")
    p :: lir_builder_value(&b, lir_layout_pointer(), LIRDrop.Trivial, None)
    a :: lir_builder_word(&b)
    c :: lir_builder_word(&b)
    d :: lir_builder_bool(&b)
    lir_builder_push(&b, LIRInst.Load{dst: a, base: p, offset: 0})
    lir_builder_push(&b, LIRInst.Load{dst: c, base: p, offset: 8})
    lir_builder_push(&b, LIRInst.Load{dst: d, base: p, offset: 0})
    function :: ofx_finish(&b, [LIRValueID]{p}, d)
    ofx_check(function, lir_cse_function(function), lir_print_module(ofx_module(function)))
}

fn opt_fixtures_cse() -> Bool Never! {
    passed := true
    if !ocse_binary("cse-binary-renamed", LIRBinaryOp.Add, false) -> passed = false
    if !ocse_binary("cse-operand-order-refused", LIRBinaryOp.Sub, true) -> passed = false
    if !ocse_compare() -> passed = false
    if !ocse_pointer_load() -> passed = false
    if !ocse_load_barrier("cse-load-store-barrier", 1) -> passed = false
    if !ocse_load_barrier("cse-load-call-barrier", 2) -> passed = false
    if !ocse_load_barrier("cse-load-drop-barrier", 3) -> passed = false
    if !ocse_load_barrier("cse-load-block-barrier", 4) -> passed = false
    if !ocse_convert_float() -> passed = false
    if !ocse_function_address() -> passed = false
    if !ocse_data_address() -> passed = false
    if !ocse_dominance(false) -> passed = false
    if !ocse_dominance(true) -> passed = false
    if !ocse_siblings() -> passed = false
    if !ocse_consumed(false) -> passed = false
    if !ocse_consumed(true) -> passed = false
    if !ocse_owned_load() -> passed = false
    if !ocse_pure_effects() -> passed = false
    if !ocse_loop() -> passed = false
    if !ocse_float_identical() -> passed = false
    if !ocse_load_key() -> passed = false
    passed
}
