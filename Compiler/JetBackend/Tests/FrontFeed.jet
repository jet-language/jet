// Differential front-end feed: checked Jet MIR is passed directly to the
// native backend. The Rust feed is decoded only for the independent comparator.
// run-front-feed.mjs assembles this with the compiler and schema stream codec.
use core.files as ff_files
use jet_driver.[JetDriverCompileMode, jet_driver_present_diagnostics]
use jet_cli.[jet_cli_compile_file]
use jet_foundation.[DIAGNOSTIC_ERROR, MIRProgram, MIRFunctionID, MIRPlaceID, MIRBlockID, MIRInstruction, MIROperation, MIROpID, mir_terminator_targets]

fn ff_native(name: String, program: MIRProgram, entry_id: MIRFunctionID, pack: GLPack) -> String {
    lowered :: lir_lower_entry(program, entry_id)
    if lowered.issues.len() > 0 {
        lines :: loop issue in lowered.issues -> "{issue.function}\t{issue.message}"
        gl_write_issues(name, lines)
        return "unsupported"
    }
    entry :: lowered.entry ?? panic("native lowering lost its checked entry")
    ff_files.write("{name}.lir", lir_print_module(lowered.lir)) ?? panic("cannot write {name}.lir")
    object :: x64_relocatable_object(lowered.lir, entry)
    if object.errors.len() > 0 {
        gl_write_issues(name, object.errors)
        return "object-error"
    }
    ff_files.write_bytes("{name}.o", object.bytes) ?? panic("cannot write {name}.o")
    linked :: x64_link_executable([String]{"{name}.o", pack.path}, ^[[U8]]{object.bytes, pack.bytes})
    if linked.errors.len() > 0 {
        gl_write_issues(name, linked.errors)
        return "link-error"
    }
    ff_files.write_bytes("{name}.exe", linked.bytes) ?? panic("cannot write {name}.exe")
    ff_files.set_mode("{name}.exe", 0o755) ?? panic("cannot make {name}.exe executable")
    "linked"
}

fn ff_case(file: String, name: String, pack: GLPack) -> String {
    compiled :: jet_cli_compile_file(file, false, false, None, JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> {
            ff_files.write("{name}.front-issues", refusal.stderr) ?? panic("cannot write front-end refusal")
            return "front-refused"
        }
        .Compiled(result, snapshot) -> {
            reports := [String]{}
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> &reports.push("{diagnostic.code}\t{diagnostic.what}\t{diagnostic.why}")
            }
            if result.internal_problem == .Val(problem) -> &reports.push("ICE\t{problem}")
            if !result.complete -> &reports.push("INCOMPLETE\tJet front end did not finish")
            if reports.len() > 0 {
                ff_files.write("{name}.front-issues", reports.join("\n")) ?? panic("cannot write front-end issues")
                return "front-error"
            }
            program :: result.mir ?? panic("complete front end has no checked MIR")
            entry :: result.entry_function ?? panic("complete golden has no checked entry")
            stream := [String]{"{entry.value}"}
            mirw_mir_program(program, &stream)
            ff_files.write("{name}.mird", stream.join("\n")) ?? panic("cannot write Jet MIR inventory")
            // Do not round-trip the stream here: the backend receives the live
            // MIR value returned by the Jet driver, not Rust/debug conversion.
            return ff_native(name, program, entry, pack)
        }
    }
    "front-error"
}

// Focused native-host producer witness; never a successful golden or a
// hand-built MIR substitute. Its source is shared with the Rust builder test.
fn ff_cleanup_place(operation: MIROperation, moved: [U64:MIRPlaceID]) -> MIRPlaceID? {
    if operation == .Call(_, args, _) {
        loop arg in args {
            if arg.access == .Move && moved.get(arg.value.value) != None -> return moved.get(arg.value.value)
        }
    }
    None
}

fn ff_cleanup_program(program: MIRProgram) {
    tables :: mir_pass_legality_tables(program)
    loop function in program.functions {
        first := MIRPlaceID?{None}
        remaining := MIRPlaceID?{None}
        loop local in function.locals {
            if local.name == "first" -> first = Val(local.place)
            if local.name == "remaining" -> remaining = Val(local.place)
        }
        if first == None -> next
        if remaining == None -> panic("cleanup witness lost remaining owner")
        moved := [U64:MIRPlaceID]{}
        maximum := U64{0}
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.id.value > maximum -> maximum = instruction.id.value
                if instruction.operation == .MovePlace(place) && instruction.result == .Val(value) -> moved[value.value] = place
            }
        }
        loop block in function.blocks {
            if block.instructions.len() == 0 -> next
            last :: block.instructions[block.instructions.len() - 1]
            if ff_cleanup_place(last.operation, moved) != first -> next
            if block.terminator == .Poll(kind, _, stop) {
                if kind != .Propagate -> panic("first normal cleanup has no propagation edge")
                pending := [MIRBlockID]{stop}
                seen := [U64:Bool]{}
                calls := 0
                loop pending.len() > 0 {
                    id :: &pending.pop() ?? panic("cleanup witness worklist underflow")
                    if seen.get(id.value) != None -> next
                    seen[id.value] = true
                    found := false
                    loop successor in function.blocks {
                        if successor.id != id -> next
                        found = true
                        loop instruction in successor.instructions {
                            place :: ff_cleanup_place(instruction.operation, moved)
                            if place == first -> panic("first cleanup was replayed")
                            if place == remaining -> calls += 1
                        }
                        if successor.terminator == .Poll(_, _, _) -> panic("propagation cleanup recursively polled")
                        loop target in mir_terminator_targets(successor.terminator) -> &pending.push(target)
                    }
                    if !found -> panic("cleanup witness stop edge names a missing block")
                }
                if calls != 1 -> panic("remaining cleanup must run exactly once, found {calls}")
                definitions :: mir_pass_definitions(function)
                dominance :: mir_pass_legality_dominators(function)
                if mir_pass_validate_stop_points(function, definitions, dominance, tables) != None -> panic("clean cleanup witness failed native Legality")
                duplicate := last
                duplicate.id = MIROpID{value: maximum + U64{1}}
                duplicate.result = None
                duplicate.ty = None
                loop index in 0..<function.blocks.len() {
                    if function.blocks[index].id == stop {
                        instructions := [MIRInstruction]{duplicate}
                        loop instruction in function.blocks[index].instructions -> &instructions.push(instruction)
                        function.blocks[index].instructions = instructions
                    }
                }
                failure :: mir_pass_validate_stop_points(function, mir_pass_definitions(function), mir_pass_legality_dominators(function), tables)
                if failure != Val("MIR stop edge reuses an already-consumed cleanup input") -> panic("native Legality accepted replay of the first cleanup: {failure}")
                print("normal cleanup: first consumed; remaining once; duplicate rejected")
                return
            }
        }
        panic("first normal cleanup has no Propagate poll")
    }
    panic("cleanup witness source produced no first owner")
}

fn ff_cleanup_case(file: String) {
    compiled :: jet_cli_compile_file(file, false, false, Val(1), JetDriverCompileMode.Program)
    if compiled == {
        .Refused(refusal) -> panic("cleanup witness refused: {refusal.stderr}")
        .Compiled(result, snapshot) -> {
            loop diagnostic in jet_driver_present_diagnostics(result.diagnostics, snapshot, result.generated_source_files) {
                if diagnostic.severity == DIAGNOSTIC_ERROR -> panic("cleanup witness diagnostic {diagnostic.code}: {diagnostic.what}")
            }
            if result.internal_problem == .Val(problem) -> panic("cleanup witness compiler ICE: {problem}")
            if !result.complete -> panic("cleanup witness front end incomplete")
            ff_cleanup_program(result.mir ?? panic("cleanup witness lost checked MIR"))
        }
    }
}

fn run() {
    if ff_files.read("front-cleanup-stop.txt") == .Val(file) {
        ff_cleanup_case(file.trim())
        return
    }
    pack :: gl_pack() ?? panic("front-feed differential requires the shared runtime pack")
    list :: ff_files.read("front-cases.txt") ?? panic("cannot read front-cases.txt")
    loop row in list.split("\n").to_list() {
        if row == "" -> next
        columns :: row.split("\t").to_list()
        if columns.len() != 2 -> panic("front-feed row must be source path and output prefix")
        name :: columns[1]
        print("{name}\trust\t{gl_case("{name}.rust", Val(pack))}")
        print("{name}\tjet\t{ff_case(columns[0], "{name}.jet", pack)}")
    }
}
