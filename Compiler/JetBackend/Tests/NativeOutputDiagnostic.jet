// The report a native test batch gives for the output checks it never ran,
// because a test body ended the batch in a fatal trap.
use {
    native_output_files: core.files
    jet_cli.[jet_cli_native_test_unrun_check_report]
}

// The Host callback renders the registered E3015 row as the CLI snapshot
// tests/cli/native_output_check_fatal.txt records it.
#Test("native output-check fatal report matches its CLI snapshot") {
    expected: native_output_files.read("tests/cli/native_output_check_fatal.txt") ?? panic("read tests/cli/native_output_check_fatal.txt: {err}")
    assert_eq(jet_cli_native_test_unrun_check_report(), expected)
}
