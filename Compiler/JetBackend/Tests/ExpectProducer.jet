// Appended to the compiler aggregate by run-expect-producer.mjs. The test-only
// dispatch receives the real CLI request; no production bootstrap entry hook.
use jet_driver.[JetDriverCompileRequest, JetDriverCompileResult, JetDriverCompileMode, jet_driver_compile_mir]
use jet_foundation.[MIRProgram, MIRPreludeCallID, MIRBlockID, MIRScopeKind, mir_program_bytes]
use jet_backend.[lir_lower_entry, x64_relocatable_object]

fn fx_expect_producer_route(program: MIRProgram, call: MIRPreludeCallID, symbol: String) -> Bool Never! {
    loop row in program.prelude_calls {
        if row.id == call -> return row.symbol == .Prelude(symbol)
    }
    false
}

fn fx_expect_producer_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult Never! {
    selected := ^request
    selected.mode = JetDriverCompileMode.Test
    selected.native_stop_points = true
    result := jet_driver_compile_mir(^selected) ?? panic("native test producer escaped")
    if !result.complete || result.internal_problem != None -> panic("native test producer did not complete")
    program :: result.mir ?? panic("native test producer has no MIR")
    if program.tests.len() != 1 -> panic("producer fixture must select exactly one real checked test")
    id :: program.tests[0].function
    checked := false
    loop function in program.functions {
        if function.id != id -> next
        matched := false
        loop scope in function.scopes {
            if scope.kind != MIRScopeKind.ScopeMember -> next
            exit := MIRBlockID?{None}
            loop fact in scope.facts {
                if fact.key != "native_test_exit" -> next
                number :: Int.parse(fact.value) ?? panic("producer exit is not an integer")
                word :: U64.from_int(number) ?? panic("producer exit is not a block ID")
                exit = Val(MIRBlockID{value: word})
            }
            canonical :: exit ?? next
            entered := false
            catch_branch := false
            boundary := false
            own_cleanup := false
            scope_exit_poll := false
            loop block in function.blocks {
                loop instruction in block.instructions {
                    if instruction.operation == .ScopeEnter(candidate, .Val(.ExpectFail(_, _))) {
                        if candidate == scope.id -> entered = true
                    }
                    if instruction.operation == .Semantic(.StaticPreludeCall(call, _, _, _)) {
                        if fx_expect_producer_route(program, call, "jet_rt_test_catch_for_scope") {
                            value :: instruction.result ?? panic("native catch has no Bool result")
                            if block.terminator == .Branch(condition, _, _) {
                                if condition == value -> catch_branch = true
                            }
                        }
                        if block.id == canonical && fx_expect_producer_route(program, call, "jet_rt_test_catch_boundary") -> boundary = true
                        if block.id == canonical && fx_expect_producer_route(program, call, "jet_rt_cleanup_enter") {
                            if !boundary -> panic("own cleanup precedes native catch boundary")
                            own_cleanup = true
                        }
                    }
                    if instruction.operation == .ScopeExit(candidate) {
                        if candidate == scope.id {
                            if block.instructions[block.instructions.len() - 1].id != instruction.id -> panic("ScopeExit is not immediately before its poll")
                            if block.terminator == .Poll(.Propagate, _, _) -> scope_exit_poll = true
                        }
                    }
                }
            }
            if !entered || !catch_branch || !boundary || !own_cleanup || !scope_exit_poll -> panic("native expectation producer lacks real enter/branch/boundary/cleanup/exit-poll edges")
            matched = true
        }
        if !matched -> panic("native expectation producer has no expectation scope")
        checked = true
    }
    if !checked -> panic("checked test function missing")
    prefix :: cli_sys.get("JET_EXPECT_PRODUCER_OUTPUT") ?? panic("JET_EXPECT_PRODUCER_OUTPUT required")
    cli_files.write_bytes("{prefix}.mir", mir_program_bytes(program)) ?? panic("cannot write producer MIR")
    lowered :: lir_lower_entry(program, id)
    if lowered.issues.len() != 0 -> panic("native producer fixture has lowering issues")
    entry :: lowered.entry ?? panic("native producer fixture has no entry")
    object :: x64_relocatable_object(lowered.lir, entry)
    if object.errors.len() != 0 -> panic("native producer fixture has object errors")
    cli_files.write_bytes("{prefix}.o", object.bytes) ?? panic("cannot write producer object")
    result
}

fn run() {
    source :: cli_sys.get("JET_EXPECT_PRODUCER_SOURCE") ?? panic("JET_EXPECT_PRODUCER_SOURCE required")
    compiled :: jet_cli_compile_file(source, false, false, Val(1), JetDriverCompileMode.Test)
    if compiled == {
        .Compiled(result, _) -> {
            if !result.complete || result.internal_problem != None -> panic("producer CLI request failed")
        }
        else -> panic("producer source authorization failed")
    }
    print("native expectation producer: CHECK OK")
}
