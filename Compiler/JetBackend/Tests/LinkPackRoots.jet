// Real GNU-as objects, not a hand-built LinkContext or a mocked export registry.
// run-runtime-pack-roots.mjs prepares the isolated input files.
use core.files as files

fn pack_roots_symbol(c: LinkContext, name: String) -> Int Never! {
    loop k in 1..<c.obj_sym_count[0] {
        at :: link_sym_at(c, 0, k)
        found :: link_cstr(c.bufs, 0, c.obj_strtab[0] + link_u32(c.bufs, 0, at))
        if found == name -> return k
    }
    -1
}

fn pack_roots_defined(c: LinkContext, name: String, binding: Int) Never! {
    k :: pack_roots_symbol(c, name)
    if k < 0 -> panic("pack lost symbol {name}")
    at :: link_sym_at(c, 0, k)
    if link_u8(c.bufs, 0, at + 4) >> 4 != binding -> panic("pack changed binding for {name}")
    if link_sym_shndx(c, 0, k) < 0 -> panic("pack lost definition for {name}")
}

fn run() {
    rust_symbols :: [String]{"_RNvRustSymbol", "_ZN3old", "__rust_alloc", "__rdl_alloc"}
    loop name in rust_symbols {
        if !link_pack_rust_symbol(name) -> panic("Rust runtime dependency was not rejected: {name}")
    }
    if link_pack_rust_symbol("jet_rt_alloc") || link_pack_rust_symbol("_Rpack_private_helper") -> panic("ordinary fixture/runtime name mistaken for Rust")
    object :: files.read_bytes("runtime.o") ?? panic("read runtime object")
    archive :: files.read_bytes("runtime.a") ?? panic("read runtime archive")
    consumer :: files.read_bytes("consumer.o") ?? panic("read consumer object")
    missing :: files.read_bytes("missing.o") ?? panic("read missing-import object")
    result :: x64_link_runtime_pack([String]{"runtime.o", "runtime.a"}, ^[[U8]]{object, archive}, [String]{"jet_archive_fixture"})
    if result.errors.len() != 0 -> panic("hybrid pack failed: {result.errors}")
    c := link_context(^[[U8]]{result.bytes})
    link_load_inputs(&c, [String]{"hybrid.pack.o"})
    if c.errors.len() != 0 -> panic("pack is not a valid object: {c.errors}")
    public_names :: [String]{"jet_rt_fixture_export", "jet_rt_fixture_unreferenced", "jet_rt_fixture_protected", "jet_archive_fixture"}
    loop name in public_names {
        pack_roots_defined(c, name, 1)
    }
    pack_roots_defined(c, "jet_rt_fixture_weak", 2)
    // GNU as calls the section directly; its unused local FUNC name is optional.
    // The ELF consumer checks the helper's distinct result, not merely its label.
    if pack_roots_symbol(c, "pack_private_helper") >= 0 -> pack_roots_defined(c, "pack_private_helper", 0)
    private_names :: [String]{"pack_named_local_helper", "jet_pack_hidden_helper", "_Rpack_private_helper"}
    loop name in private_names {
        pack_roots_defined(c, name, 0)
    }
    dead_names :: [String]{"pack_dead_private", "jet_pack_dead_hidden"}
    loop name in dead_names {
        if pack_roots_symbol(c, name) >= 0 -> panic("pack retained dead private symbol {name}")
    }
    main_symbol :: pack_roots_symbol(c, "main")
    if main_symbol < 0 -> panic("pack lost its program import")
    if link_sym_shndx(c, 0, main_symbol) != LINK_UNDEF -> panic("pack defined the program import")
    files.write_bytes("hybrid.pack.o", result.bytes) ?? panic("write hybrid pack")
    linked :: x64_link_executable([String]{"consumer.o", "hybrid.pack.o"}, ^[[U8]]{consumer, result.bytes})
    if linked.errors.len() != 0 -> panic("consumer link failed: {linked.errors}")
    files.write_bytes("consumer", linked.bytes) ?? panic("write consumer")
    files.set_mode("consumer", 0o755) ?? panic("make consumer executable")
    archive_object :: files.read_bytes("archive.o") ?? panic("read standalone platform object")
    object_only :: x64_link_runtime_pack([String]{"runtime.o", "archive.o"}, ^[[U8]]{object, archive_object}, [String]{})
    if object_only.errors.len() != 0 -> panic("object-only runtime pack required an archive: {object_only.errors}")
    o := link_context(^[[U8]]{object_only.bytes})
    link_load_inputs(&o, [String]{"object.pack.o"})
    if o.errors.len() != 0 -> panic("object-only pack is not a valid object")
    loop name in public_names -> pack_roots_defined(o, name, 1)
    archive_only :: x64_link_runtime_pack([String]{"runtime.a"}, ^[[U8]]{archive}, [String]{})
    if archive_only.errors.len() == 0 || archive_only.bytes.len() != 0 -> panic("pack accepted an archive without a Jet runtime object")
    broken :: x64_link_runtime_pack([String]{"runtime.o", "missing.o", "runtime.a"}, ^[[U8]]{object, missing, archive}, [String]{})
    found_missing := false
    loop error in broken.errors {
        if error.contains("undefined symbol `jet_ws_connect`") -> found_missing = true
    }
    if !found_missing || broken.bytes.len() != 0 -> panic("pack accepted a non-native WebSocket member without its provider")
    print("runtime pack object roots: pass")
}
