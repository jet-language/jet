// Tuple return ABI, borrowed field reads, deep clone/drop and member paths.
use jet_foundation.[
    MIRCallee,
    MIRCallArg,
    MIRConstant,
    MIRDropKind,
    MIRField,
    MIRFieldID,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIROperation,
    MIRProgram,
    MIRTerminator,
    MIRTupleField,
    MIRType,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRTypeKind,
    mir_field_id,
    mir_function_id,
    mir_type_from_kind,
    mir_type_id,
    mir_type_identity_key,
    mir_type_with_identity,
]

fn fx_tuple_type(name: String, fields: [MIRTupleField]) -> MIRType Never! {
    mir_type_with_identity(mir_type_from_kind(MIRTypeKind.Tuple{fields: fields}), mir_type_id(name))
}

fn fx_tuple_field_id(ty: MIRType, name: String) -> MIRFieldID Never! {
    mir_field_id("{mir_type_identity_key(ty)}::{name}")
}

// fn pair() -> (Int, String) { (7, "tuple") }
// fn run() {
//     p :: pair()
//     print(p.0)
//     print(p.1)
//     q :: p.clone()
//     drop(p)
//     print(q.0)
//     print(q.1)
//     drop(q)
// }
// expect-stdout tuple: "7\ntuple\n7\ntuple\n"
fn fx_tuple() -> MIRProgram Never! {
    pair :: fx_tuple_type("TuplePair", [MIRTupleField]{MIRTupleField{name: "0", ty: fx_int()}, MIRTupleField{name: "1", ty: fx_string()}})
    first :: fx_tuple_field_id(pair, "0")
    second :: fx_tuple_field_id(pair, "1")
    make := fx_builder()
    seven :: fx_int_const(&make, 7)
    label :: fx_owned(&make, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "tuple"}})
    built :: fx_owned(&make, pair, MIROperation.Tuple{type_id: mir_type_id("TuplePair"), fields: [MIRFieldValue]{MIRFieldValue{field: first, value: seven}, MIRFieldValue{field: second, value: label}}})
    fx_block(&make, 0, MIRTerminator.Return{value: Val(built)})

    r := fx_builder()
    p :: fx_owned(&r, pair, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("pair")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    number :: fx_copy(&r, fx_int(), MIROperation.Field{base: p, field: first})
    text :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.Field{base: p, field: second})
    fx_print(&r, number)
    fx_print(&r, text)
    q :: fx_owned(&r, pair, MIROperation.Copy{value: p, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: p, kind: MIRDropKind.Value})
    copied_number :: fx_copy(&r, fx_int(), MIROperation.Field{base: q, field: first})
    copied_text :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.Field{base: q, field: second})
    fx_print(&r, copied_number)
    fx_print(&r, copied_text)
    fx_do(&r, MIROperation.Drop{value: q, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("pair", make, pair), fx_function("run", r, fx_unit())}, ^[MIRTypeDef]{})
}

// struct TupleHolder { row: (label: String, unit: Unit, number: Int, flag: Bool) }
// fn run() {
//     h :: TupleHolder{row: (label: "nested", unit: Unit{}, number: 9, flag: true)}
//     twin :: h.clone()
//     drop(h)
//     print(twin.row.label)
//     print(twin.row.number)
//     print(twin.row.flag)
//     _ :: twin.row.unit
//     drop(twin)
//     empty :: ()
//     drop(empty.clone())
//     drop(empty)
// }
// expect-stdout tuple-members: "nested\n9\ntrue\n"
fn fx_tuple_members() -> MIRProgram Never! {
    row :: fx_tuple_type("TupleRow", [MIRTupleField]{
        MIRTupleField{name: "label", ty: fx_string()},
        MIRTupleField{name: "unit", ty: fx_unit()},
        MIRTupleField{name: "number", ty: fx_int()},
        MIRTupleField{name: "flag", ty: fx_bool()},
    })
    holder :: fx_named("TupleHolder")
    holder_field :: mir_field_id("TupleHolder.row")
    types :: [MIRTypeDef]{fx_type_def("TupleHolder", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("TupleHolder", "row", row)}, methods: [MIRFunctionID]{}})}
    r := fx_builder()
    label :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "nested"}})
    unit :: fx_copy(&r, fx_unit(), MIROperation.Constant{value: MIRConstant.Unit})
    number :: fx_int_const(&r, 9)
    flag :: fx_copy(&r, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    tuple :: fx_owned(&r, row, MIROperation.Tuple{type_id: mir_type_id("TupleRow"), fields: [MIRFieldValue]{
        MIRFieldValue{field: fx_tuple_field_id(row, "label"), value: label},
        MIRFieldValue{field: fx_tuple_field_id(row, "unit"), value: unit},
        MIRFieldValue{field: fx_tuple_field_id(row, "number"), value: number},
        MIRFieldValue{field: fx_tuple_field_id(row, "flag"), value: flag},
    }})
    h :: fx_owned(&r, holder, MIROperation.Struct{type_id: mir_type_id("TupleHolder"), fields: [MIRFieldValue]{MIRFieldValue{field: holder_field, value: tuple}}})
    twin :: fx_owned(&r, holder, MIROperation.Copy{value: h, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: h, kind: MIRDropKind.Value})
    identity :: fx_value(&r, holder, fx_borrow(), MIROperation.ProjectMembers{base: twin, members: [MIRFieldID]{}})
    projected_label :: fx_value(&r, fx_string(), fx_borrow(), MIROperation.ProjectMembers{base: identity, members: [MIRFieldID]{holder_field, fx_tuple_field_id(row, "label")}})
    projected_number :: fx_copy(&r, fx_int(), MIROperation.ProjectMembers{base: twin, members: [MIRFieldID]{holder_field, fx_tuple_field_id(row, "number")}})
    projected_flag :: fx_copy(&r, fx_bool(), MIROperation.ProjectMembers{base: twin, members: [MIRFieldID]{holder_field, fx_tuple_field_id(row, "flag")}})
    fx_print(&r, projected_label)
    fx_print(&r, projected_number)
    fx_print(&r, projected_flag)
    _ := fx_copy(&r, fx_unit(), MIROperation.ProjectMembers{base: twin, members: [MIRFieldID]{holder_field, fx_tuple_field_id(row, "unit")}})
    fx_do(&r, MIROperation.Drop{value: twin, kind: MIRDropKind.Value})
    empty_type :: fx_tuple_type("EmptyTuple", [MIRTupleField]{})
    empty :: fx_owned(&r, empty_type, MIROperation.Tuple{type_id: mir_type_id("EmptyTuple"), fields: [MIRFieldValue]{}})
    empty_copy :: fx_owned(&r, empty_type, MIROperation.Copy{value: empty, fact: MIRCopyFact.Explicit})
    fx_do(&r, MIROperation.Drop{value: empty_copy, kind: MIRDropKind.Value})
    fx_do(&r, MIROperation.Drop{value: empty, kind: MIRDropKind.Value})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", r, fx_unit())}, ^types)
}
