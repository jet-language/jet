// Include in a native runtime-library fixture and link u32-import.c.
// The C entry points deliberately violate no SysV rule: only eax is defined
// for U32, so their high bits may be dirty. Ordinary checked import lowering
// must zero-extend BEFORE the result can widen into an I64 word.
#Import(c) fixture_dirty_u32_zero: fn() -> U32 = "fixture_dirty_u32_zero"
#Import(c) fixture_dirty_u32_max: fn() -> U32 = "fixture_dirty_u32_max"
#Import(c) fixture_dirty_u32_status: fn() -> U32 = "fixture_dirty_u32_status"

#Export(c) fixture_u32_zero_word: fn() -> I64 { I64{fixture_dirty_u32_zero()} }
#Export(c) fixture_u32_max_word: fn() -> I64 { I64{fixture_dirty_u32_max()} }
#Export(c) fixture_u32_status_word: fn() -> I64 { I64{fixture_dirty_u32_status()} }
