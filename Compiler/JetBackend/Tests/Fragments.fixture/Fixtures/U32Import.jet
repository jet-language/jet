// Include in a native runtime-library fixture and link u32-import.c.
// The C entry points deliberately violate no SysV rule: only eax is defined
// for U32, so their high bits may be dirty. Ordinary checked import lowering
// must zero-extend BEFORE the result can widen into an I64 word.
#Import(c) fn fixture_dirty_u32_zero() -> U32 = "fixture_dirty_u32_zero"
#Import(c) fn fixture_dirty_u32_max() -> U32 = "fixture_dirty_u32_max"
#Import(c) fn fixture_dirty_u32_status() -> U32 = "fixture_dirty_u32_status"

#Export(c) fn fixture_u32_zero_word() -> I64 { I64{fixture_dirty_u32_zero()} }
#Export(c) fn fixture_u32_max_word() -> I64 { I64{fixture_dirty_u32_max()} }
#Export(c) fn fixture_u32_status_word() -> I64 { I64{fixture_dirty_u32_status()} }
