// Prepared Rust helper descriptor ABI witnesses. These lower the production
// path and lint/compile its x64 object without guessing a Rust value layout.
use jet_foundation.[MIRForeignABI, MIRForeignLanguage, MIRLinkArtifact, MIRLinkArtifactKind, MIRLinkUnitID]

fn fx_foreign_descriptor_program(ty: MIRType, access: MIRAccess, prepared: Bool, ignored: Bool) -> MIRProgram Never! {
    b := fx_builder()
    value :: fx_param(&b, "value", ty, fx_borrow())
    signature := fx_builder()
    fx_param(&signature, "value", ty, mir_ownership_from_access(access)).drop("foreign signature only")
    fx_block(&signature, 0, MIRTerminator.Return{value: None})
    declaration :: fx_function("fixture", signature, ty)
    // Sema's Rust row symbol is the module-qualified Rust path, never the
    // helper's exported descriptor name.
    foreign :: MIRForeign{
        id: MIRForeignID{value: U64{9200}}, module_id: declaration.module_id,
        key: declaration.key, module_name: declaration.module_name, name: declaration.name,
        span: declaration.span, symbol: "fixture::identity", path: "fixture::identity",
        params: declaration.params, raw_scalar_abi: false, bridge_eligible: true,
        return_type: Val(ty), foreign_abi: MIRForeignABI.Rust, foreign_language: MIRForeignLanguage.Rust,
        target_applicability: declaration.target_applicability, effects: declaration.effects,
        callback_transport: None, callback_plan_digest: None, callback_identity: None,
        link: if prepared -> Val(MIRLinkUnitID{value: U64{9200}}) else -> None,
        callback: None, handle: None, close_function: None, close_foreign: None,
        undo_function: None, unsafe_gate: None,
    }
    call :: MIROperation.Call{callee: MIRCallee.Foreign{id: foreign.id}, args: [MIRCallArg]{fx_arg(value, access)}, type_args: [MIRType]{}}
    if ignored {
        fx_do(&b, call)
        fx_block(&b, 0, MIRTerminator.Return{value: None})
    } else {
        result :: fx_value(&b, ty, if ty.kind == .String -> mir_owned_ownership() else -> fx_copy_ownership(ty), call)
        fx_block(&b, 0, MIRTerminator.Return{value: Val(result)})
    }
    p := fx_program([MIRFunction]{fx_function("descriptor", b, if ignored -> fx_unit() else -> ty)}, [MIRTypeDef]{})
    p.foreign = [MIRForeign]{foreign}
    if prepared {
        p.links = [MIRLinkUnit]{MIRLinkUnit{
            id: MIRLinkUnitID{value: U64{9200}}, crate_spec: "fixture@1.0.0", cache_identity: "fixture",
            target_applicability: declaration.target_applicability,
            artifacts: [MIRLinkArtifact]{MIRLinkArtifact{kind: MIRLinkArtifactKind.StaticLibrary, path: "fixture.a"}},
            dependency_dirs: [String]{}, link_closure: [MIRLinkUnitID]{},
        }}
    }
    p
}

fn fx_foreign_descriptor_checks() -> Bool Never! {
    types :: [MIRType]{
        fx_int(), fx_bool(), fx_string(),
        mir_type_from_kind(MIRTypeKind.Char),
        mir_type_from_kind(MIRTypeKind.Float),
        mir_type_from_kind(MIRTypeKind.Float32),
        mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 8}),
        mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 16}),
        mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 64}),
        mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: 32}),
        mir_type_from_kind(MIRTypeKind.IntN{signed: false, bits: 64}),
    }
    loop ty in types {
        lowered :: lir_lower_callables(fx_foreign_descriptor_program(ty, .Read, true, false), [MIRFunctionID]{mir_function_id("descriptor")})
        if lowered.issues.len() != 0 || lir_lint_module(lowered.lir).len() != 0 -> return false
        text :: lir_print_module(lowered.lir)
        if !text.contains("jet_ffi_fixture_cabi") || text.contains("fixture::identity_cabi") || !text.contains("jet_ffi_take_failure") || !text.contains("stack 24 align 8") -> return false
        if ty.kind == .String {
            if !text.contains("jet_rt_string_data") || !text.contains("jet_rt_string_byte_len") || !text.contains("jet_rt_string_from_static") || !text.contains("jet_ffi_cabi_free") -> return false
            if text.contains("jet_rt_c_string_pack") -> return false
        }
        object :: x64_runtime_object(lowered.lir, [X64RuntimeExport]{X64RuntimeExport{function: LIRFunctionID{value: 0}, symbol: "fixture_descriptor"}})
        if object.errors.len() != 0 -> return false
    }
    ignored :: lir_lower_callables(fx_foreign_descriptor_program(fx_string(), .Read, true, true), [MIRFunctionID]{mir_function_id("descriptor")})
    if ignored.issues.len() != 0 || lir_lint_module(ignored.lir).len() != 0 || !lir_print_module(ignored.lir).contains("jet_ffi_cabi_free") -> return false
    empty := fx_foreign_descriptor_program(fx_int(), .Read, true, false)
    empty.foreign[0].params = [MIRParam]{}
    empty.foreign[0].return_type = None
    body := fx_builder()
    fx_do(&body, MIROperation.Call{callee: MIRCallee.Foreign{id: empty.foreign[0].id}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&body, 0, MIRTerminator.Return{value: None})
    empty.functions = [MIRFunction]{fx_function("descriptor", body, fx_unit())}
    void :: lir_lower_callables(empty, [MIRFunctionID]{mir_function_id("descriptor")})
    if void.issues.len() != 0 || lir_lint_module(void.lir).len() != 0 || !lir_print_module(void.lir).contains("stack 24 align 8") -> return false
    direct := fx_foreign_descriptor_program(fx_int(), .Read, true, false)
    direct.foreign[0].foreign_language = .C
    direct.foreign[0].foreign_abi = .C
    direct.foreign[0].symbol = "fixture_c"
    direct.foreign[0].raw_scalar_abi = true
    scalar :: lir_lower_callables(direct, [MIRFunctionID]{mir_function_id("descriptor")})
    if scalar.issues.len() != 0 || lir_lint_module(scalar.lir).len() != 0 -> return false
    scalar_text :: lir_print_module(scalar.lir)
    if !scalar_text.contains("fixture_c") || scalar_text.contains("jet_ffi_take_failure") || scalar_text.contains("_cabi") -> return false
    missing :: lir_lower_callables(fx_foreign_descriptor_program(fx_int(), .Read, false, false), [MIRFunctionID]{mir_function_id("descriptor")})
    moved :: lir_lower_callables(fx_foreign_descriptor_program(fx_int(), .Move, true, false), [MIRFunctionID]{mir_function_id("descriptor")})
    missing.issues.len() > 0 && moved.issues.len() > 0
}
