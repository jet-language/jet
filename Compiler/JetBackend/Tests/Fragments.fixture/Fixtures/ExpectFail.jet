// Real ScopeEnter/Exit, Branch and Poll edges compiled by the native backend.
// Static coverage held until native image cutover: no simulated control rail.
use jet_foundation.[MIRScopeID, MIRScopeKind, MIRScopeFact, MIRTestScopeMember]

// expect-stdout expect-match: "own close\nafter\nexpectation task passed\n"
// expect-native-only expect-match
// expect-native-task expect-match
// expect-task-pass expect-match
// expect-stderr expect-match: ""
// expect-stdout expect-mismatch: "fallback close\ntask published; process continued\n"
// expect-native-only expect-mismatch
// expect-native-task expect-mismatch
// expect-task-message expect-mismatch: "expected a stop with E3001 whose message contains \"absent\", got E3001: boom"
// expect-stdout expect-unmet: "own close\ntask published; process continued\n"
// expect-native-only expect-unmet
// expect-native-task expect-unmet
// expect-task-message expect-unmet: "expected this region to stop with E3001, but it passed"
// expect-stdout expect-nested: "own close\nafter inner\nouter close\nafter\nexpectation task passed\n"
// expect-native-only expect-nested
// expect-native-task expect-nested
// expect-task-pass expect-nested
// expect-stderr expect-nested: ""
// expect-stdout expect-r080: "own close\nafter\nexpectation task passed\n"
// expect-native-only expect-r080
// expect-native-task expect-r080
// expect-task-pass expect-r080
// expect-stderr expect-r080: ""
// expect-stdout expect-r080-unarmed: ""
// expect-native-only expect-r080-unarmed
// expect-native-task expect-r080-unarmed
// expect-exit expect-r080-unarmed: 70
// expect-stderr-contains expect-r080-unarmed: "Stop [R0801]:"
// expect-stdout expect-deeper-close: "deeper close\n"
// expect-native-only expect-deeper-close
// expect-native-task expect-deeper-close
// expect-exit expect-deeper-close: 70
// expect-stderr-contains expect-deeper-close: "panic: deeper close stop"
// expect-stdout expect-own-close: "own close\ntask published; process continued\n"
// expect-native-only expect-own-close
// expect-native-task expect-own-close
// expect-task-message expect-own-close: "own close stop"

fn fx_expect_control(b: &FxBuilder, member: String, _symbol: String, ty: MIRType, args: [MIRValueID]) -> MIRValueID Never! {
    expected :: if member == "cleanup_enter" || member == "cleanup_leave" -> "jet_rt_{runtime_abi_atom(member)}" else -> "jet_rt_test_{runtime_abi_atom(member)}"
    if _symbol != expected -> panic("expectation fixture raw route identity mismatch")
    fx_copy(&b, ty, MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.testing", member), args: loop value in args -> fx_arg(value, MIRAccess.Read), owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
}

fn fx_expect_scope(id: U64) -> MIRScope Never! {
    MIRScope{id: MIRScopeID{value: id}, kind: MIRScopeKind.ScopeMember, span: fx_span(), name: Val("expect_fail"), deadline: None, facts: [MIRScopeFact]{}}
}

fn fx_expect_cleanup(b: &FxBuilder, text: String, panic_close: Bool) Never! {
    saved :: fx_expect_control(&b, "cleanup_enter", "jet_rt_cleanup_enter", fx_i64(), [MIRValueID]{})
    line :: fx_require_text(&b, text)
    fx_print(&b, line)
    fx_do(&b, MIROperation.Drop{value: line, kind: MIRDropKind.Value})
    if panic_close {
        _ := fx_copy(&b, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id(text)}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    }
    _ := fx_expect_control(&b, "cleanup_leave", "jet_rt_cleanup_leave", fx_unit(), [MIRValueID]{saved})
}

// A real checked callable Close, not an unarmed inline cleanup panic. Its
// Propagate is masked by its caller's cleanup word; the caller polls on exit.
fn fx_expect_close(text: String) -> MIRFunction Never! {
    b := fx_builder()
    message :: fx_require_text(&b, "{text} stop")
    fx_require_do(&b, MIRRequireKind.Panic, None, [MIRValueID]{message}, fx_require_context("cleanup panic"), true)
    fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 1}, stop: MIRBlockID{value: 2}})
    fx_block(&b, 1, MIRTerminator.Stopped)
    fx_block(&b, 2, MIRTerminator.Stopped)
    fx_function(text, b, fx_unit())
}

fn fx_expect_fail(mode: String) -> MIRProgram Never! {
    b := fx_builder()
    inner :: MIRScopeID{value: 1}
    outer :: MIRScopeID{value: 2}
    unsafe_scope :: MIRScopeID{value: 3}
    raw :: mode == "r080" || mode == "r080-unarmed"
    code :: if raw -> "R0801" else -> "E3001"
    member :: MIRTestScopeMember.ExpectFail{expected_code: Val(code), expected_message: if mode == "mismatch" -> Val("absent") else -> None}
    if mode == "nested" -> fx_do(&b, MIROperation.ScopeEnter{scope: outer, test_member: Val(MIRTestScopeMember.ExpectFail{expected_code: Val("E3001"), expected_message: Val("outer boom")})})
    fx_do(&b, MIROperation.ScopeEnter{scope: inner, test_member: Val(member)})
    if raw -> fx_do(&b, MIROperation.ScopeEnter{scope: unsafe_scope, test_member: None})
    if mode != "unmet" {
        if raw {
            ptr_type :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("Ptr"), args: [MIRType]{fx_i64()}})
            pointer :: fx_copy(&b, ptr_type, MIROperation.Constant{value: MIRConstant.Int{value: 0, width: Val(MIRIntegerWidth{signed: false, bits: 64}), spelling: None}})
            _ := fx_copy(&b, fx_i64(), MIROperation.Deref{value: pointer})
        } else {
            message :: fx_require_text(&b, "boom")
            fx_require_do(&b, MIRRequireKind.Panic, None, [MIRValueID]{message}, fx_require_context("panic(\"boom\")"), true)
        }
    }
    if mode == "r080-unarmed" {
        fx_block(&b, 0, MIRTerminator.Unreachable{reason: "unarmed sentry fault must be process-fatal"})
    } else {
        fx_block(&b, 0, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 3}, stop: MIRBlockID{value: 1}})
    }
    id :: fx_copy(&b, fx_i64(), MIROperation.Constant{value: MIRConstant.Int{value: 1, width: Val(MIRIntegerWidth{signed: true, bits: 64}), spelling: None}})
    caught :: fx_expect_control(&b, "catch_for_scope", "jet_rt_test_catch_for_scope", fx_bool(), [MIRValueID]{id})
    fx_block(&b, 1, MIRTerminator.Branch{condition: caught, then_target: MIRBlockID{value: 2}, else_target: MIRBlockID{value: 9}})
    if mode == "deeper-close" -> fx_expect_cleanup(&b, "deeper close", true)
    if raw -> fx_do(&b, MIROperation.ScopeExit{scope: unsafe_scope})
    fx_block(&b, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    boundary_id :: fx_copy(&b, fx_i64(), MIROperation.Constant{value: MIRConstant.Int{value: 1, width: Val(MIRIntegerWidth{signed: true, bits: 64}), spelling: None}})
    _ := fx_expect_control(&b, "catch_boundary", "jet_rt_test_catch_boundary", fx_unit(), [MIRValueID]{boundary_id})
    fx_expect_cleanup(&b, "own close", mode == "own-close")
    fx_do(&b, MIROperation.ScopeExit{scope: inner})
    fx_block(&b, 3, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 4}, stop: MIRBlockID{value: 10}})
    if mode == "nested" {
        line :: fx_require_text(&b, "after inner")
        fx_print(&b, line)
        fx_do(&b, MIROperation.Drop{value: line, kind: MIRDropKind.Value})
        message :: fx_require_text(&b, "outer boom")
        fx_require_do(&b, MIRRequireKind.Panic, None, [MIRValueID]{message}, fx_require_context("panic(\"outer boom\")"), true)
        fx_block(&b, 4, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 6}, stop: MIRBlockID{value: 5}})
        outer_id :: fx_copy(&b, fx_i64(), MIROperation.Constant{value: MIRConstant.Int{value: 2, width: Val(MIRIntegerWidth{signed: true, bits: 64}), spelling: None}})
        outer_caught :: fx_expect_control(&b, "catch_for_scope", "jet_rt_test_catch_for_scope", fx_bool(), [MIRValueID]{outer_id})
        fx_block(&b, 5, MIRTerminator.Branch{condition: outer_caught, then_target: MIRBlockID{value: 6}, else_target: MIRBlockID{value: 10}})
        exit_id :: fx_copy(&b, fx_i64(), MIROperation.Constant{value: MIRConstant.Int{value: 2, width: Val(MIRIntegerWidth{signed: true, bits: 64}), spelling: None}})
        _ := fx_expect_control(&b, "catch_boundary", "jet_rt_test_catch_boundary", fx_unit(), [MIRValueID]{exit_id})
        fx_expect_cleanup(&b, "outer close", false)
        fx_do(&b, MIROperation.ScopeExit{scope: outer})
        fx_block(&b, 6, MIRTerminator.Poll{kind: MIRPollKind.Propagate, resume: MIRBlockID{value: 7}, stop: MIRBlockID{value: 10}})
    } else {
        fx_block(&b, 4, MIRTerminator.Jump{target: MIRBlockID{value: 7}})
    }
    line :: fx_require_text(&b, "after")
    fx_print(&b, line)
    fx_do(&b, MIROperation.Drop{value: line, kind: MIRDropKind.Value})
    fx_block(&b, 7, MIRTerminator.Return{value: None})
    fx_expect_cleanup(&b, "fallback close", false)
    if raw -> fx_do(&b, MIROperation.ScopeExit{scope: unsafe_scope})
    fx_do(&b, MIROperation.ScopeExit{scope: inner})
    fx_block(&b, 9, MIRTerminator.Stopped)
    fx_block(&b, 10, MIRTerminator.Stopped)
    program := fx_require_program(b)
    program.functions[0].scopes = [MIRScope]{fx_expect_scope(U64{1})}
    if mode == "nested" -> &program.functions[0].scopes.push(fx_expect_scope(U64{2}))
    if raw -> &program.functions[0].scopes.push(MIRScope{id: unsafe_scope, kind: MIRScopeKind.Unsafe, span: fx_span(), name: Val("fixture raw pointer provenance"), deadline: None, facts: [MIRScopeFact]{MIRScopeFact{key: "sentry_enabled", value: "true"}, MIRScopeFact{key: "sentry_fenced", value: "false"}}})
    if mode == "deeper-close" -> &program.functions.push(fx_expect_close("deeper close"))
    if mode == "own-close" -> &program.functions.push(fx_expect_close("own close"))
    routes :: [String]{"catch_for_scope", "catch_boundary", "cleanup_enter", "cleanup_leave"}
    loop route in routes {
        symbol :: if route == "cleanup_enter" || route == "cleanup_leave" -> "jet_rt_{runtime_abi_atom(route)}" else -> "jet_rt_test_{runtime_abi_atom(route)}"
        arity :: if route == "cleanup_enter" -> 0 else -> 1
        &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.StaticPrelude, "core.testing", route, symbol, arity, MIRPreludeABI.Value))
    }
    program
}
