    [U8]{0xf3, 0x0f, 0x1e, 0xfa},
    [U8]{0x0f, 0xc2, 0xc1, 0x01},
    [U8]{0x0f, 0x0d, 0x08},
    [U8]{0xf3, 0x48, 0x0f, 0xb8, 0xc1},
    [U8]{0x0f, 0xc7, 0x0f},
    [U8]{0x48, 0x0f, 0xc7, 0x0f},
    [U8]{0x0f, 0x38, 0xf0, 0x07},
    [U8]{0xf2, 0x48, 0x0f, 0x38, 0xf1, 0xc1},
    [U8]{0x66, 0x0f, 0x3a, 0x16, 0xc0, 0x01},
    [U8]{0x8d, 0x74, 0x26, 0x00},
}

#Test("every encoder form decodes to its own objdump -M intel text") {
    ^problems: [String]{}
    loop form in x64_decode_test_forms() {
        text: x64_decode_test_text(form.bytes)
        if text != form.text {
            problems.push("{x64_decode_test_bytes(form.bytes)}: `{text}`, not `{form.text}`")
        }
    }
    assert(problems.len() == 0, "the decoder misreads encoder forms:\n{problems.join("\n")}")
}

#Test("every template-assembler mnemonic and rail decodes to its own name") {
    ^problems: [String]{}
    ^covered: [String]{}
    loop sample in x64_decode_test_samples() {
        assembled: x64_assemble_template(sample.template, sample.names, false, false)
        if assembled.error == .Val(error) {
            problems.push("`{sample.template}` does not assemble: {error}")
            next
        }
        decoded: x64_decode_test_mnemonics(assembled.code)
        if decoded != sample.decoded {
            problems.push("`{sample.template}` decodes to [{decoded.join(", ")}], not [{sample.decoded.join(", ")}]")
        }
        // A line's mnemonic is its first word, or the word after a lock or
        // rep prefix as well.
        loop line in sample.template.split("\n") {
            words: line.split(" ").to_list()
            covered.push(words[0].copy())
            if (words[0] == "lock" || words[0] == "rep") && words.len() > 1 {
                covered.push(words[1].copy())
            }
        }
    }
    loop mnemonic in INLINE_ASSEMBLY_X64_MNEMONICS {
        if !covered.contains(mnemonic) -> problems.push("no sample assembles `{mnemonic}`")
    }
    ^rail_words: [String]{}
    loop rail in x64_decode_test_rails() {
        ^expected: [String]{}
        loop line in rail.lines {
            word: line.split(" ").to_list()[0]
            if word.ends_with(":") -> next
            rail_words.push(word.copy())
            // objdump spells jnz as its synonym jne.
            expected.push(if word == "jnz" -> "jne" else -> word.copy())
        }
        decoded: x64_decode_test_mnemonics(rail.bytes)
        if decoded != expected {
            problems.push("rail `{rail.lines.join("; ")}` decodes to [{decoded.join(", ")}]")
        }
    }
    loop mnemonic in INLINE_ASSEMBLY_X64_RAIL_MNEMONICS {
        if !rail_words.contains(mnemonic) -> problems.push("no rail spells `{mnemonic}`")
    }
    assert(problems.len() == 0, "the decoder misreads assembled templates:\n{problems.join("\n")}")
}

#Test("the asm leaves and the fault reports decode to named instructions only") {
    ^problems: [String]{}
    loop leaf in x64_decode_test_leaves() {
        found: x64_decode_test_linear(leaf.bytes, leaf.label)
        problems.extend(x64_decode_test_unnamed(leaf.bytes, found, leaf.label))
    }
    reports: [{label: String, bytes: [U8]}]{{label: "fault_report", bytes: X64_FAULT_REPORT}, {label: "fault_report_addresses", bytes: X64_FAULT_REPORT_ADDRESSES}}
    loop report in reports {
        found: x64_decode_test_reached(report.bytes, report.label)
        assert(found.len() > 100, "{report.label}: only {found.len()} instructions reached")
        problems.extend(x64_decode_test_unnamed(report.bytes, found, report.label))
    }
    assert(problems.len() == 0, "instructions no table form names:\n{problems.join("\n")}")
}

// Every instruction the tests above decode, one byte run each.
x64_decode_test_instructions: fn() -> [[U8]] Never! {
    ^runs: [[U8]]{}
    loop form in x64_decode_test_forms() -> x64_decode_test_split(runs, form.bytes)
    loop sample in x64_decode_test_samples() {
        x64_decode_test_split(runs, x64_assemble_template(sample.template, sample.names, false, false).code)
    }
    loop rail in x64_decode_test_rails() -> x64_decode_test_split(runs, rail.bytes)
    loop leaf in x64_decode_test_leaves() -> x64_decode_test_split(runs, leaf.bytes)
    loop spot in X64_DECODE_TEST_SPOTS -> x64_decode_test_split(runs, spot)
    reports: [[U8]]{X64_FAULT_REPORT, X64_FAULT_REPORT_ADDRESSES}
    loop report in reports {
        loop item in x64_decode_test_reached(report, "objdump") {
            runs.push(report.slice(item.at, item.at + item.insn.length))
        }
    }
    runs
}

// objdump's text as the decoder writes it: one space between words, no
// `<symbol>` after a target and no `# address` comment.
x64_decode_test_objdump_text: fn(text: String) -> String Never! {
    ^words: [String]{}
    loop word in text.split(" ") {
        piece: word.trim()
        if piece.starts_with("#") || piece.starts_with("<") -> break
        if piece != "" -> words.push(piece.copy())
    }
    words.join(" ")
}

// Push each instruction of `bytes`, decoded from offset 0, as its own run.
x64_decode_test_split: fn(runs: ^[[U8]], bytes: [U8]) Never! {
    loop item in x64_decode_test_linear(bytes, "objdump") {
        runs.push(bytes.slice(item.at, item.at + item.insn.length))
    }
}

#Test("objdump -M intel decodes every instruction as the decoder does") {
    objdump: kit_require_tool("objdump") ?? return
    runs: x64_decode_test_instructions()
    ^blob: [U8]{}
    ^starts: [Int]{}
    loop run in runs {
        starts.push(blob.len())
        blob.extend(run)
    }
    scratch: x64_decode_test_files.temp_dir("jet-x64-decode") ?? panic("scratch: {err}")
    path: "{scratch.path}/code.bin"
    x64_decode_test_files.write_bytes(path, blob) ?? panic("{path}: {err}")
    receipt: x64_decode_test_process.cmd([String]{objdump, "-D", "-b", "binary", "-m", "i386:x86-64", "-M", "intel", "--insn-width=16", path}).output_limit(256 << 20).run() ?? panic("objdump could not start: {err}")
    assert(receipt.success, "objdump failed: {receipt.errors}")
    ^theirs: [String]{}
    ^at: [Int]{}
    loop line in receipt.output.split("\n") {
        fields: line.split("\t").to_list()
        if fields.len() < 3 || !fields[0].trim().ends_with(":") -> next
        offset: fields[0].trim()
        at.push(x64_decode_hex_parse(offset.slice(0, offset.len() - 1), line))
        theirs.push(x64_decode_test_objdump_text(fields[2]))
    }
    ^problems: [String]{}
    ^k: 0
    loop (index, start) in starts {
        loop k < at.len() && at[k] < start -> k += 1
        insn: x64_decode(blob, start, start) ?? panic("run {index} is cut short")
        ours: x64_insn_text(insn)
        if k >= at.len() || at[k] != start {
            problems.push("{x64_decode_test_bytes(runs[index])}: objdump starts no instruction at {start}; ours `{ours}`")
            next
        }
        if theirs[k] != ours {
            problems.push("{x64_decode_test_bytes(runs[index])}: objdump `{theirs[k]}`, ours `{ours}`")
        }
    }
    assert(problems.len() == 0, "{problems.len()} instructions differ from objdump:\n{problems.join("\n")}")
}
