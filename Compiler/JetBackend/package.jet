name: "jet_backend"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
}
// The memory kernel: the OS layer's raw intrinsics and the image loader and
// session host, which map and run native code.
policy: {
    memory: .Kernel(["Source/OS/Linux.jet", "Source/Image/Loader.jet", "Source/Image/SessionHost.jet"]),
}
