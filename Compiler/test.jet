// The compiler workspace's code suites, run by the test
// profiles of package.jet: `jet test Compiler --profile packages`, `core`,
// `fuzz`, `selfhost` or `perf`. Each runs in its own child, where JET names the jet under test,
// JET_COMPILER_IDENTITY its identity (that jet sets it when the caller didn't)
// and JET_TEST_SUITE_ROOT this package's directory; the checkout is its
// parent. A row is one check; the profile compares the rows with
// `.jet/test/<profile>/<suite>.rows`.
use {
    crypto: core.crypto
    jet_testkit.[kit_exec_select_runs]
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
    time: core.time
    jet_testkit.[kit_claim_jobs, kit_exec_available_memory, kit_execute_budget]
}

// The runs a `packages` or `core` run makes at once (package_jobs): a quarter
// of the CPUs, at least PACKAGE_JOBS and at most PACKAGE_JOBS_MAX, then only as
// many PACKAGE_MEMORY claims as the corpus pool's memory budget holds, and
// never more than the runs there are. One package run can hold about 5.5 GiB.
PACKAGE_JOBS: 4
PACKAGE_JOBS_MAX: 8
PACKAGE_MEMORY: 5905580032

// The trees whose packages a `packages` run tests, from the checkout:
// tests/guards holds the repository guard packages (the top package,
// corpus_ast, dyn_surface, impl_placement and package_manifests).
PACKAGE_TREES: [String]{"Compiler", "Jetpack", "tests/guards"}

// The trees the row COVERAGE_ROW lists #Tests in: PACKAGE_TREES and all of
// tests/, less TEST_INPUT_TREES.
COVERAGE_TREES: [String]{"Compiler", "Jetpack", "tests"}

// The trees under tests/ whose .jet files are another suite's inputs (case
// and agent-workload sources, UI and CLI diagnostic snapshots, goldens,
// conformance witnesses, fuzz corpora): a #Test there is input text, not a
// test some package owes a run.
TEST_INPUT_TREES: [String]{"tests/agent_workloads", "tests/cases", "tests/cli", "tests/conformance", "tests/fuzz", "tests/run", "tests/ui", "tests/ui_lint"}

// The packages the compiler assembles from their sources instead of building
// them as packages, so they have no standalone `jet test`: the bootstrap chain
// links JetRuntime's sources.list into the native runtime library, and the
// `registries` profile runs its Test registries as assembled standalone files
// (Tools/agent/CompilerRegistries.jet). The compiler embeds Prelude's sources
// through the generated registry files; Prelude has no #Test. A `packages` run
// reports each as a skipped row.
ASSEMBLED_PACKAGES: [String]{"Compiler/JetRuntime", "Compiler/Prelude"}

// The tests.list sections whose areas have no package.jet: Store, Provider
// and Recipe (`Engine`, one dependency cycle), Services, Image and CLI. Their
// claims run as one unit Jetpack/Bootstrap/Assemble.jet assembles. JetOS is
// frozen and stays out.
JETPACK_ENGINE_SECTIONS: "Engine,Services,Image,CLI"

// Where the engine unit and the hosted engine are assembled, from the checkout.
JETPACK_ENGINE_SCRATCH: "Jetpack/Bootstrap/.jet/test"

// What the compiler's deepest recursion needs, as the bootstrap chain gives it.
BUILD_STACK: 1073741824

// Where `jet build Compiler` leaves the `jet` executable, from the checkout.
BUILD_OUTPUT: "Compiler/JetCli/.jet/build"

// Held for each suite's builds: selfhost and perf share BUILD_OUTPUT, and
// `full` runs them side by side.
BUILD_LOCK: "Compiler/JetCli/.jet/test-build.lock"

// Where selfhost keeps its s2 and s3 compilers, from the checkout: beside
// BUILD_OUTPUT on the same file system, so each built `jet` moves by rename.
SELFHOST_STAGES: "Compiler/JetCli/.jet/selfhost"

// The SPEED-500K milestone column the self-compile is held to.
PERF_COLUMN: "225K"

test: fn(t: Test) -> Int {
    t.suite("packages", package_suite_rows)
    t.suite("core", core_rows)
    t.suite("fuzz", fuzz_rows)
    t.suite("selfhost", selfhost_rows)
    t.suite("perf", perf_rows)
    t.run()
}

// The jet under test, the checkout, and the `name@version` its builds stamp
// on their identities (as the bootstrap chain does), or a failing `setup` row.
SuiteSetup: struct {
    jet: String
    checkout: String
    version: String
}

suite_setup: fn(rows: TestRows) -> SuiteSetup? {
    jet: sys.get("JET") ?? ""
    root: sys.get("JET_TEST_SUITE_ROOT") ?? ""
    if jet == "" || root == "" {
        rows.fail("setup", "JET or JET_TEST_SUITE_ROOT is unset: run the suite through `jet test Compiler --profile <profile>`")
        return None
    }
    identity: sys.get("JET_COMPILER_IDENTITY") ?? ""
    version: identity.split("#").to_list()[0].copy()
    if !version.contains("@") {
        rows.fail("setup", "JET_COMPILER_IDENTITY `{identity}` names no `name@version`: set the jet under test's identity")
        return None
    }
    absolute: files.absolute(root) ?? {
        rows.fail("setup", "couldn't resolve `{root}`: {err}")
        return None
    }
    Val(SuiteSetup{jet: jet, checkout: files.dirname(absolute), version: version})
}

// A child jet in the checkout, without the profile run's own settings, so a
// child `jet test` runs its own tests and writes its own evidence.
jet_command: fn(setup: SuiteSetup, jet: String, args: [String]) -> ProcessSpec {
    jet_child(setup, jet, args).env("JET_TOOLCHAIN_ROOT", setup.checkout)
}

// A child jet on the engine unit in `project`: it reads the toolchain tree
// Assemble.jet staged beside the project, so it runs without
// JET_TOOLCHAIN_ROOT.
jetpack_unit_command: fn(setup: SuiteSetup, args: [String], project: String) -> ProcessSpec {
    jet_child(setup, setup.jet, args).cwd(project).env_remove("JET_TOOLCHAIN_ROOT")
}

// The child jet of both: the profile run's own settings removed, and the
// checkout as JETPACK_TEST_REPO_ROOT, the repository whose committed files
// the Jetpack claims read.
jet_child: fn(setup: SuiteSetup, jet: String, args: [String]) -> ProcessSpec {
    argv := [String]{jet}
    loop arg in args -> argv.push(arg.copy())
    spec := process.cmd(argv).cwd(setup.checkout).env("JETPACK_TEST_REPO_ROOT", setup.checkout)
    names: sys.vars() ?? [String]{}
    loop name in names {
        if name.starts_with("JET_TEST_") || name.starts_with("JET_NATIVE_TEST_") || name.starts_with("JET_EVIDENCE_") {
            spec = spec.env_remove(name)
        }
    }
    spec
}

// A child's output reduced to a failing row's detail: its first `Error`
// line (a jet diagnostic's header), else its last non-blank line.
failure_line: fn(text: String) -> String {
    found := ""
    loop line in text.split("\n") {
        if line.starts_with("Error") -> return line.trim()
        if line.trim() != "" -> found = line.trim()
    }
    found
}

// ---------------------------------------------------------------------------
// packages: one row per #Test of every package under PACKAGE_TREES that the
// `tests` suite doesn't run, `<package>: <test>`, from `jet test <package>`.
// The `tests` suite runs the workspace members; this suite runs everything
// else: each member's `Tests` package, the tool packages beside the members,
// every Jetpack package, the tests/guards packages, and the Jetpack engine
// areas that have no package (jetpack_engine_rows). A package whose tests
// didn't run (one that doesn't compile, say) is the failing row `<package>`.
// Fixture packages are test data, not packages under test; an
// ASSEMBLED_PACKAGES package is a skipped row. The row `#Test coverage`
// (test_coverage_rows) proves no tracked #Test under COVERAGE_TREES is left
// unrun. Claims that drive the jet CLI run the jet under test, named by
// JET_BIN. Under a filter (TestRows.selects), only the runs holding a row the
// filter selects are built and run, by the #Test names their sources
// declare, and the engine unit only when one of its claims is selected. A
// filtered run reports no coverage row: it ran part of the #Tests.
package_suite_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    members: workspace_members(setup) ?? {
        rows.fail("Compiler", err.message)
        return
    }
    packages := [String]{}
    loop tree in PACKAGE_TREES {
        package_dirs(setup.checkout, tree, members, packages) ?? {
            rows.fail(tree, err.message)
            return
        }
    }
    packages.sort()
    loop package in ASSEMBLED_PACKAGES -> rows.skip(package, "assembled by the compiler from its sources, not built as a package")
    sources := [TestSource]{}
    listing := ""
    if test_sources(setup) == {
        .Ok(found) -> { sources = found }
        .Err(error) -> { listing = error.message.copy() } // copy: the result is dropped
    }
    held: test_names_by_run(setup, sources)
    // A script (a `#!` file) is no package's source: `jet test <script>` runs
    // its #Tests, a run of its own beside the packages.
    candidates := packages.copy()
    loop source in sources {
        if source.script && test_frozen_tree(source.path) == "" -> candidates.push(source.path.copy())
    }
    runs := [String]{}
    loop run in candidates {
        if run_selected(rows, run, held.get(run) ?? [String]{}) -> runs.push(run.copy())
    }
    // The engine unit is assembled first, so the hosted engine's build runs
    // as the batch's first job: it overlaps the package runs instead of
    // following them, and it starts while the host is still quiet.
    engine: engine_selected(rows, sources)
    prep: if engine -> jetpack_prepare(rows, setup) else -> JetpackPrep{assembled: "", map: JetpackMap{claims: [JetpackClaim]{}, files: [String]{}}, engine: "", build: None, error: ""}
    specs := [ProcessSpec]{}
    first := 0
    if prep.build == .Val(build) {
        specs.push(build.copy())
        first = 1
    }
    loop run in runs {
        args := [String]{"test", run}
        if run_filter(rows, run, held.get(run) ?? [String]{}) == .Val(filter) {
            args.push("--filter")
            args.push(filter)
        }
        specs.push(jet_command(setup, setup.jet, args).env("JET_BIN", setup.jet))
    }
    results: process.run_all(specs, package_jobs(specs.len())) ?? {
        rows.fail("packages", "couldn't start the package runs: {err}")
        return
    }
    ran := [String: [String]]{}
    broke := [String]{}
    loop (index, run) in runs {
        if results[index + first] == {
            .Ok(receipt) -> {
                if package_rows(rows, run, receipt) == {
                    .Val(names) -> { ran[run] = names }
                    .None -> broke.push(run.copy())
                }
            }
            .Err(error) -> {
                rows.fail(run, "couldn't run `jet test {run}`: {error}")
                broke.push(run.copy())
            }
        }
    }
    // The hosted engine's build, when the batch ran it: why it left no
    // engine, else "".
    build_failure := ""
    if first == 1 {
        if results[0] == {
            .Ok(receipt) -> {
                if !receipt.success || !files.is_file(prep.engine) {
                    detail: failure_line(receipt.errors)
                    build_failure = "the hosted engine didn't build (exit {receipt.code}): {if detail == "" -> failure_line(receipt.output) else -> detail}"
                }
            }
            .Err(error) -> { build_failure = "couldn't build the hosted engine: {error}" }
        }
    }
    if !engine -> return
    unit: jetpack_engine_rows(rows, setup, prep, build_failure)
    if rows.filter != "" -> return
    if listing != "" {
        rows.fail(COVERAGE_ROW, listing)
        return
    }
    test_coverage_rows(rows, setup, members, sources, TestRuns{ran, broke, unit})
}

// The #Test names of each run's sources: a script's are its own, any other
// source's its owner's (test_owner). Frozen trees hold none a run makes.
test_names_by_run: fn(setup: SuiteSetup, sources: [TestSource]) -> [String: [String]] {
    held := [String: [String]]{}
    loop source in sources {
        if test_frozen_tree(source.path) != "" -> next
        run: if source.script -> source.path.copy() else -> test_owner(setup.checkout, source.path)
        if run == "" -> next
        names := held.get(run) ?? [String]{}
        loop name in source.names -> names.push(name.copy())
        held[run] = names.move()
    }
    held
}

// Whether the run `run`, whose sources declare the #Tests `names`, holds a
// row `rows` selects: its own row `<run>`, or a `<run>: <test>` row.
run_selected: fn(rows: TestRows, run: String, names: [String]) -> Bool {
    rows.selects(run) || names.any(name -> rows.selects("{run}: {name}"))
}

// The `--filter` a selected run's `jet test` gets: the suite's filter when
// every #Test name it selects holds it, so the child runs only those tests.
// None for an unfiltered run, one whose own name holds the filter (all its
// rows are selected), or a filter spanning `<run>: <test>`, which the child
// can't apply: that child runs all its tests and the rows keep the selected.
run_filter: fn(rows: TestRows, run: String, names: [String]) -> String? {
    if rows.filter == "" || rows.selects(run) -> return None
    loop name in names {
        if rows.selects("{run}: {name}") && !name.contains(rows.filter) -> return None
    }
    Val(rows.filter.copy())
}

// Whether the engine unit may have a claim `rows` selects, `Jetpack/<section>:
// <claim>` for a section of JETPACK_ENGINE_SECTIONS and a #Test of a Jetpack
// source: always without a filter. It holds before anything is assembled;
// the unit's map then names the exact claims (jetpack_prepare,
// jetpack_engine_rows).
engine_selected: fn(rows: TestRows, sources: [TestSource]) -> Bool {
    if rows.filter == "" -> return true
    sections: JETPACK_ENGINE_SECTIONS.split(",").to_list()
    loop source in sources {
        if !source.path.starts_with("Jetpack/") || test_frozen_tree(source.path) != "" -> next
        loop name in source.names {
            if sections.any(section -> rows.selects("Jetpack/{section}: {name}")) -> return true
        }
    }
    false
}

// The runs at once, of `runs` (kit_claim_jobs). The budget is the corpus
// pool's (kit_execute_budget): the profile's `memory` setting, which the
// profile run passes in JET_TEST_SUITE_MEMORY, else the room this process may
// still claim under its cgroup's memory.high and memory.max and the host's
// (kit_exec_available_memory).
package_jobs: fn(runs: Int) -[Env, FS]> Int {
    requested: Int.parse(sys.get("JET_TEST_SUITE_MEMORY") ?? "") ?? 0
    kit_claim_jobs(kit_execute_budget(requested, kit_exec_available_memory()), PACKAGE_MEMORY, sys.cpu_count(), PACKAGE_JOBS, PACKAGE_JOBS_MAX, runs)
}

// The engine unit made ready before the package runs: its assembled `aot`
// directory and source map, and the engine its process claims run. Unless
// JETPACK_BIN names an engine, `engine` is the hosted engine's binary and
// `build` its `jet build`, which package_suite_rows runs in the package
// batch. A non-empty `error` leaves no unit to run.
JetpackPrep: struct {
    assembled: String
    map: JetpackMap
    engine: String
    build: ProcessSpec?
    error: String
}

// `jet Jetpack/Bootstrap/Assemble.jet` in `aot` mode and, without
// JETPACK_BIN, in `hosted` mode: the hosted engine is `jet build` of every
// implementation file and Jetpack/run.jet, and jet's own build cache makes an
// unchanged rebuild cheap. A unit whose map holds no claim `rows` selects
// needs no engine.
jetpack_prepare: fn(rows: TestRows, setup: SuiteSetup) -> JetpackPrep {
    scratch: files.join(setup.checkout, JETPACK_ENGINE_SCRATCH)
    prep := JetpackPrep{assembled: "", map: JetpackMap{claims: [JetpackClaim]{}, files: [String]{}}, engine: sys.get("JETPACK_BIN") ?? "", build: None, error: ""}
    assembled: jetpack_assemble(setup, scratch, "aot") ?? {
        prep.error = err.message.copy()
        return prep
    }
    prep.assembled = assembled.copy()
    prep.map = jetpack_map(files.join(scratch, "aot/jetpack.map.json")) ?? {
        prep.error = err.message.copy()
        return prep
    }
    if prep.engine != "" || !prep.map.claims.any(claim -> rows.selects(jetpack_claim_id(claim))) -> return prep
    hosted: jetpack_assemble(setup, scratch, "hosted") ?? {
        prep.error = err.message.copy()
        return prep
    }
    project: files.join(hosted, "project")
    prep.engine = files.join(project, ".jet/build/jetpack")
    prep.build = Val(jetpack_unit_command(setup, [String]{"build", "src/jetpack.jet"}, project))
    prep
}

// The Jetpack engine areas' claims, one row each, `Jetpack/<section>:
// <claim>`: Assemble.jet joins every implementation file and the claims of
// JETPACK_ENGINE_SECTIONS into one unit, and `jet test` runs it serially (the
// claims share process state). JET_BIN names the jet under test; process
// claims run the engine named by JETPACK_BIN, the caller's, else the hosted
// engine `prep` built; `build_failure` says why that build left no engine.
// A unit that didn't run to its summary is the failing row `Jetpack engine`.
// Under a filter the unit runs only when `rows` selects one of its claims,
// with the filter as its `--filter` when every selected claim's name holds
// it. Returns the unit's files and the claims it reported, or a unit that
// didn't run.
jetpack_engine_rows: fn(rows: TestRows, setup: SuiteSetup, prep: JetpackPrep, build_failure: String) -> JetpackUnit {
    unit: "Jetpack engine"
    none: JetpackUnit{ran: false, files: [String]{}, claims: [String]{}}
    if prep.error != "" || build_failure != "" {
        rows.fail(unit, if prep.error != "" -> prep.error else -> build_failure)
        return none
    }
    map: prep.map
    selected: map.claims.filter(claim -> rows.selects(jetpack_claim_id(claim)))
    if selected.len() == 0 -> return none
    args := [String]{"test", "src/jetpack.jet", "--serial"}
    if rows.filter != "" && selected.all(claim -> claim.name.contains(rows.filter)) {
        args.push("--filter")
        args.push(rows.filter.copy())
    }
    receipt: jetpack_unit_command(setup, args, files.join(prep.assembled, "project")).env("JET_BIN", setup.jet).env("JETPACK_BIN", prep.engine).run() ?? {
        rows.fail(unit, "couldn't run `jet test` on the engine unit: {err}")
        return none
    }
    results := [String: String]{}
    summary := false
    loop line in receipt.output.split("\n") {
        if line.contains(" passed, ") && line.contains(" failed") -> summary = true
        at: line.rfind(": ")
        if at <= 0 -> next
        results[line.slice(0, at)] = line.slice(at + 2, line.len()).trim()
    }
    if !summary {
        detail: failure_line(receipt.errors)
        rows.fail(unit, "`jet test` of the engine unit exited {receipt.code}: {if detail == "" -> failure_line(receipt.output) else -> detail}")
        return none
    }
    reported := [String]{}
    loop claim in selected {
        id: jetpack_claim_id(claim)
        verdict: results.get(claim.name) ?? ""
        if verdict != "" -> reported.push(claim.name.copy())
        if {
            verdict == "" -> rows.fail(id, "`jet test` reported no result for it")
            verdict == "pass" -> rows.pass(id)
            verdict.starts_with("skip") -> rows.skip(id, verdict)
            else -> rows.fail(id, verdict)
        }
    }
    JetpackUnit{ran: true, files: map.files, claims: reported}
}

// Whether the engine unit ran to its summary, its source files, from the
// checkout, and the claims its run reported.
JetpackUnit: struct {
    ran: Bool
    files: [String]
    claims: [String]
}

// One claim of the engine unit and its tests.list section.
JetpackClaim: struct {
    name: String
    section: String
}

// A claim's row id, `Jetpack/<section>: <claim>`.
jetpack_claim_id: fn(claim: JetpackClaim) -> String {
    "Jetpack/{claim.section}: {claim.name}"
}

// `jet Jetpack/Bootstrap/Assemble.jet <mode>` into `scratch`, keeping only
// the JETPACK_ENGINE_SECTIONS claims: the mode's directory. The jet under test
// (JET_BIN) runs the assembler and its Jet tool.
jetpack_assemble: fn(setup: SuiteSetup, scratch: String, mode: String) -> String Err! {
    script: files.join(setup.checkout, "Jetpack/Bootstrap/Assemble.jet")
    ran: jet_command(setup, setup.jet, [String]{script, mode}).env("JET_BIN", setup.jet).env("JETPACK_BOOTSTRAP_SCRATCH", scratch).env("JETPACK_BOOTSTRAP_TEST_AREAS", JETPACK_ENGINE_SECTIONS).env_remove("JETPACK_BOOTSTRAP_SOURCE_ROOT").env_remove("JETPACK_BOOTSTRAP_AREAS").env_remove("JETPACK_BOOTSTRAP_OWN_AREA").run() ?? return Err("couldn't run `{setup.jet} {script} {mode}`: {err}")
    if !ran.success -> return Err("`Assemble.jet {mode}` exited {ran.code}: {failure_line(ran.errors)}")
    Ok(files.join(scratch, mode))
}

// The unit's claims in order with their sections, and the source files it
// joins, from its source map.
JetpackMap: struct {
    claims: [JetpackClaim]
    files: [String]
}

jetpack_map: fn(path: String) -> JetpackMap Err! {
    text: files.read(path) ?? return Err("couldn't read `{path}`: {err}")
    tree: json.parse(text) ?? return Err("`{path}` is not JSON: {err}")
    names: json_texts(json_field(tree, "tests"))
    sections: json_texts(json_field(tree, "test_areas"))
    if names.len() == 0 || names.len() != sections.len() -> return Err("`{path}` lists no claims with their sections")
    claims := [JetpackClaim]{}
    loop (index, name) in names -> claims.push(JetpackClaim{name: name.copy(), section: sections[index].copy()})
    sources := [String]{}
    if json_field(tree, "files") == .Array(items) {
        loop item in items {
            if json_field(item, "path") == .Text(source) -> sources.push(source.copy())
        }
    }
    if sources.len() == 0 -> return Err("`{path}` lists no source files")
    Ok(JetpackMap{claims, files: sources})
}

json_field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

json_texts: fn(value: Dyn) -> [String] {
    texts := [String]{}
    if value == .Array(items) {
        loop item in items {
            if item == .Text(text) -> texts.push(text.copy())
        }
    }
    texts
}

// The member directories of the Compiler workspace, `Compiler/<member>`, from
// the `members: [...]` list of its package.jet: the packages the `tests`
// suite runs.
workspace_members: fn(setup: SuiteSetup) -> [String] Err! {
    path: files.join(setup.checkout, "Compiler/package.jet")
    text: files.read(path) ?? return Err("couldn't read `{path}`: {err}")
    start: text.find("members: [")
    if start < 0 -> return Err("`{path}` has no `members: [` list")
    rest: text.slice(start, text.len())
    end: rest.find("]")
    if end < 0 -> return Err("`{path}` doesn't close its `members` list")
    members := [String]{}
    loop (index, part) in rest.slice(0, end).split("\"").to_list() {
        if index % 2 == 1 -> members.push("Compiler/{part}")
    }
    if members.len() == 0 -> return Err("`{path}` lists no members")
    Ok(members)
}

// Adds every package directory at or below `relative` (from `checkout`) to
// `found`, except the workspace root, the `members`, ASSEMBLED_PACKAGES,
// build output, hidden directories and fixtures.
package_dirs: fn(checkout: String, relative: String, members: [String], found: &[String]) Err! {
    directory: files.join(checkout, relative)
    if relative != "Compiler" && !members.contains(relative) && !ASSEMBLED_PACKAGES.contains(relative) && files.is_file(files.join(directory, "package.jet")) {
        found.push(relative.copy())
    }
    listed: files.list_dir(directory) ?? return Err("couldn't list `{relative}`: {err}")
    loop entry in listed {
        if !entry.is_dir || test_data_dir(entry.name) -> next
        package_dirs(checkout, "{relative}/{entry.name}", members, found) ?? return Err(err.message)
    }
}

// A directory no package search enters: hidden, or fixtures, which are test
// data and not packages under test.
test_data_dir: fn(name: String) -> Bool {
    name.starts_with(".") || name.ends_with(".fixture") || name == "fixtures" || name == "Fixtures"
}

// A run's rows, a package's or a script's, from its `<test>: <verdict>`
// lines; a run that ended without a summary, or failed with no failing test,
// is the row `<run>`; a run with no #Test blocks is that row, skipped.
// Returns the names of the tests it reported, none when the row `<run>`
// failed: that row stands for every #Test the run holds.
package_rows: fn(rows: TestRows, package: String, receipt: ProcessReceipt) -> [String]? {
    names := [String]{}
    if receipt.errors.contains("[jet.NoTestsFound]") || receipt.output.contains("[jet.NoTestsFound]") {
        rows.skip(package, "no #Test blocks")
        return Val(names)
    }
    summary := false
    failed := false
    loop line in receipt.output.split("\n") {
        if line.contains(" passed, ") && line.contains(" failed, ") -> summary = true
        at: line.rfind(": ")
        if at <= 0 -> next
        name: line.slice(0, at)
        verdict: line.slice(at + 2, line.len()).trim()
        id: "{package}: {name}"
        if {
            verdict == "pass" || verdict == "expected-fail" -> rows.pass(id)
            verdict.starts_with("skip") -> rows.skip(id, verdict)
            verdict.starts_with("FAIL") || verdict == "unexpected-pass" -> {
                rows.fail(id, verdict)
                failed = true
            }
            else -> next
        }
        names.push(name.copy())
    }
    if !summary || (!receipt.success && !failed) {
        detail: failure_line(receipt.errors)
        rows.fail(package, "`jet test {package}` exited {receipt.code}: {if detail == "" -> failure_line(receipt.output) else -> detail}")
        return None
    }
    Val(names)
}

// The frozen trees: owner-frozen, so no gate runs their #Tests and none
// deletes them. The coverage check reports each as one skipped row.
FROZEN_TREES: [String]{"Jetpack/JetOS"}

COVERAGE_ROW: "#Test coverage"

// A .jet file under COVERAGE_TREES that declares #Tests: its path
// from the checkout, their names, and whether it is a script (a `#!` file),
// whose #Tests only `jet test <script>` runs.
TestSource: struct {
    path: String
    names: [String]
    script: Bool
}

// Every TestSource outside test data and TEST_INPUT_TREES. The trees are
// walked, not asked of git: batches and releases run from an export with no
// repository.
test_sources: fn(setup: SuiteSetup) -> [TestSource] Err! {
    paths := [String]{}
    loop tree in COVERAGE_TREES -> jet_sources(setup.checkout, tree, paths) ?? return Err(err.message)
    paths.sort()
    sources := [TestSource]{}
    loop path in paths {
        text: files.read(files.join(setup.checkout, path)) ?? return Err("couldn't read `{path}`: {err}")
        names: test_names(text)
        if names.len() > 0 -> sources.push(TestSource{path: path.copy(), names: names, script: text.starts_with("#!")})
    }
    Ok(sources)
}

// Adds every .jet file at or below `relative` (from `checkout`) to `found`,
// outside the directories test_data_dir skips and TEST_INPUT_TREES.
jet_sources: fn(checkout: String, relative: String, found: &[String]) Err! {
    listed: files.list_dir(files.join(checkout, relative)) ?? return Err("couldn't list `{relative}`: {err}")
    loop entry in listed {
        path: "{relative}/{entry.name}"
        if entry.is_dir && !test_data_dir(entry.name) && !TEST_INPUT_TREES.contains(path) -> jet_sources(checkout, path, found) ?? return Err(err.message)
        if !entry.is_dir && entry.name.ends_with(".jet") -> found.push(path)
    }
}

// What the packages suite ran: the names each run (a package or a script)
// reported, the runs whose own row failed, and the engine unit.
TestRuns: struct {
    ran: [String: [String]]
    broke: [String]
    unit: JetpackUnit
}

// The row COVERAGE_ROW: every TestSource belongs to a run a suite makes, and
// each of its #Tests reported a result there. A workspace member's sources
// are the `tests` suite's; a script's #Tests are its own run's. Any other
// source's are its owner's, the nearest directory with a package.jet, or the
// engine unit's when the unit's source map lists the file. A run whose own
// row failed stands for all its sources, and an engine unit that didn't run
// for the Jetpack sources no package owns. FROZEN_TREES are named skipped
// rows. Every #Test no run reports is named in the failing row: a package no
// gate should run is deleted, not left unrun.
test_coverage_rows: fn(rows: TestRows, setup: SuiteSetup, members: [String], sources: [TestSource], runs: TestRuns) {
    problems := [String]{}
    frozen := [String: Int]{}
    loop source in sources {
        tree: test_frozen_tree(source.path)
        if tree != "" {
            frozen[tree] = (frozen.get(tree) ?? 0) + 1
            next
        }
        owner: if source.script -> source.path.copy() else -> test_owner(setup.checkout, source.path)
        if members.contains(owner) || runs.broke.contains(owner) -> next
        in_unit: runs.unit.files.contains(source.path)
        reported := [String]{}
        known := false
        if runs.ran.get(owner) == .Val(names) {
            reported = names.copy()
            known = true
        }
        if !known && !in_unit {
            if {
                owner != "" -> problems.push("{source.path}: its package `{owner}` is not run by any suite")
                !runs.unit.ran && source.path.starts_with("Jetpack/") -> {}
                else -> problems.push("{source.path}: in no package and not in the Jetpack engine unit")
            }
            next
        }
        where := "`{owner}`"
        if in_unit -> where = if owner == "" -> "the Jetpack engine unit" else -> "the Jetpack engine unit or `{owner}`"
        loop name in source.names {
            if !(in_unit && runs.unit.claims.contains(name)) && !reported.contains(name) -> problems.push("{source.path}: #Test(\"{name}\") reported no result in {where}")
        }
    }
    loop tree in FROZEN_TREES {
        count: frozen.get(tree) ?? 0
        if count > 0 -> rows.skip(tree, "owner-frozen: no gate runs its {count} #Test files")
    }
    if problems.len() == 0 -> rows.pass(COVERAGE_ROW) else -> rows.fail(COVERAGE_ROW, "{problems.len()} #Tests no suite runs: {problems.join("; ")}")
}

// The FROZEN_TREES entry holding a checkout path, else "".
test_frozen_tree: fn(path: String) -> String {
    loop tree in FROZEN_TREES {
        if path.starts_with("{tree}/") -> return tree.copy()
    }
    ""
}

// The nearest directory above a checkout path with a package.jet, else "".
test_owner: fn(checkout: String, path: String) -> String {
    directory := files.dirname(path)
    loop {
        if directory == "" || directory == "." || directory == "/" -> return ""
        if files.is_file(files.join(files.join(checkout, directory), "package.jet")) -> return directory
        directory = files.dirname(directory)
    }
}

// The names of the `#Test("<name>")` declarations in a source text.
test_names: fn(text: String) -> [String] {
    names := [String]{}
    loop line in text.split("\n") {
        declaration: line.trim()
        if !declaration.starts_with("#Test(\"") -> next
        rest: declaration.slice(7, declaration.len())
        end: rest.find("\"")
        if end >= 0 -> names.push(rest.slice(0, end).copy())
    }
    names
}

// ---------------------------------------------------------------------------
// core: one row per Core #Test at each CORE_LEVELS level, `<file> [<level>]:
// <test>`, from `jet test <file> --optimize=<level>` for every Core source that
// declares #Tests. A Core source tests as the Core unit the compiler loads,
// with Core's privileges; a file whose tests didn't run is the failing row
// `<file> [<level>]`. Under a filter only the runs holding a row it selects
// run (kit_exec_select_runs), each with the filter as its `--filter` when the
// child can apply it (run_filter). CORE_LEVELS copies the `optimize` row's
// values in JetFoundation/Source/Registry/BuildOptions.jet, which a script
// can't import; tests/guards/closed_lists.jet fails when the two differ.
CORE_LEVELS: [String]{"none", "basic", "full"}

core_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    paths := [String]{}
    jet_sources(setup.checkout, "Core", paths) ?? {
        rows.fail("Core", err.message)
        return
    }
    paths.sort()
    tested := [String]{}
    names := [[String]]{}
    loop path in paths {
        text: files.read(files.join(setup.checkout, path)) ?? {
            rows.fail(path, "couldn't read `{path}`: {err}")
            next
        }
        declared: test_names(text)
        if declared.len() == 0 -> next
        tested.push(path.copy())
        names.push(declared)
    }
    candidates := [(id: String, path: String, level: String)]{}
    ids := [String]{}
    held := [[String]]{}
    loop level in CORE_LEVELS {
        loop (index, path) in tested {
            id: "{path} [{level}]"
            candidates.push((id: id.copy(), path: path.copy(), level: level.copy()))
            ids.push(id)
            held.push(names[index].copy()) // copy: each level's run holds the file's tests.
        }
    }
    selected: kit_exec_select_runs(ids, held, rows.filter)
    runs := [(id: String, path: String, level: String)]{}
    specs := [ProcessSpec]{}
    loop (index, run) in candidates {
        if !selected.contains(run.id) -> next
        args := [String]{"test", run.path, "--optimize={run.level}"}
        if run_filter(rows, run.id, held[index]) == .Val(filter) {
            args.push("--filter")
            args.push(filter)
        }
        runs.push((id: run.id.copy(), path: run.path.copy(), level: run.level.copy()))
        specs.push(jet_command(setup, setup.jet, args))
    }
    if specs.len() == 0 -> return
    results: process.run_all(specs, package_jobs(specs.len())) ?? {
        rows.fail("core", "couldn't start the Core runs: {err}")
        return
    }
    loop (index, run) in runs {
        if results[index] == {
            .Ok(receipt) -> { _ := package_rows(rows, run.id, receipt) }
            .Err(error) -> rows.fail(run.id, "couldn't run `jet test {run.path} --optimize={run.level}`: {error}")
        }
    }
}

// ---------------------------------------------------------------------------
// fuzz: the sema fuzz corpus FUZZ_CORPUS, checked differentially by the jet
// under test. Each directory of the corpus holds `.jet` programs, and its
// name is their verdict:
// - FUZZ_REFUSED (`invalid/<name>.<code>.jet`): `jet check --json` refuses
//   the program. The code in the name is the refusal it was written for, and
//   a failing row names it. A `__NUL__` in the file stands for a NUL byte, so
//   the file is checked from a scratch copy that holds one.
// - Every other directory: `jet check --json` accepts the program.
// - FUZZ_RUNS (`differential/`): a program that checks clean also runs at
//   every CORE_LEVELS level. The first level's run exits 0 and, where the
//   directory's FUZZ_MANIFEST pairs the program with an `exact-stdout`
//   output, prints exactly that file. Each later level's run ends as the
//   first one did (exit code and stdout): the optimizer never changes what a
//   program does.
// A check is the row `<corpus>/<dir>/<file>`, and a run adds ` [<level>]`. A
// program the check refuses does not run, so it has no run rows. No jet may
// die by a signal, outlive FUZZ_TIMEOUT_MS, or exit FUZZ_INTERNAL_EXIT (an
// internal compiler error), whatever its row expects. Under a filter only the
// selected rows report; a selected run row checks its program and runs every
// level, so it has the first level to compare with.
FUZZ_CORPUS: "tests/fuzz/sema"
FUZZ_REFUSED: "invalid"
FUZZ_RUNS: "differential"
FUZZ_MANIFEST: "manifest.tsv"
FUZZ_INTERNAL_EXIT: 101
FUZZ_TIMEOUT_MS: 120000
// What one check or run of a fuzz program may hold.
FUZZ_MEMORY: 2147483648

// One corpus program: its row ID, the file jet is given and the directory
// it runs in, whether the check must refuse it, whether it runs, the output
// file its first-level run is pinned to ("" for none) and that file's text,
// and whether its check row is selected.
FuzzProgram: struct {
    id: String
    name: String
    cwd: String
    refused: Bool
    runs: Bool
    pin: String
    pinned: String
    checked: Bool
}

// How one run of a program ended: why it failed outright ("" when it did
// not crash, hang or fail to start), its exit code, its stdout, and the
// first error line of its stderr.
FuzzOutcome: struct {
    failure: String
    code: Int
    output: String
    errors: String
}

fuzz_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    scratch: files.temp_dir("jet-fuzz") ?? {
        rows.fail("fuzz", "couldn't create a scratch directory: {err}")
        return
    }
    listed: files.list_dir(files.join(setup.checkout, FUZZ_CORPUS)) ?? {
        rows.fail(FUZZ_CORPUS, "couldn't list `{FUZZ_CORPUS}`: {err}")
        return
    }
    dirs := [String]{}
    loop entry in listed {
        if entry.is_dir -> dirs.push(entry.name.copy()) // copy: the listing keeps its entries
    }
    dirs.sort()
    programs := [FuzzProgram]{}
    loop dir in dirs -> fuzz_programs(rows, setup.checkout, scratch.path, dir, programs)
    if programs.len() == 0 -> return
    checks := [ProcessSpec]{}
    loop program in programs -> checks.push(fuzz_command(setup, program.cwd, [String]{"check", "--json", program.name}))
    checked: process.run_all(checks, fuzz_jobs(checks.len())) ?? {
        rows.fail("fuzz", "couldn't start the fuzz checks: {err}")
        return
    }
    running := [Int]{}
    runs := [ProcessSpec]{}
    loop (index, program) in programs {
        failure := ""
        if checked[index] == {
            .Ok(receipt) -> failure = fuzz_check_failure(program, receipt)
            .Err(error) -> failure = "couldn't start jet: {error}"
        }
        if program.checked {
            if failure == "" -> rows.pass(program.id) else -> rows.fail(program.id, failure)
        }
        if failure != "" || !program.runs -> next
        running.push(index)
        loop level in CORE_LEVELS -> runs.push(fuzz_command(setup, program.cwd, [String]{"run", "--optimize={level}", program.name}))
    }
    if runs.len() == 0 -> return
    ran: process.run_all(runs, fuzz_jobs(runs.len())) ?? {
        rows.fail("fuzz", "couldn't start the fuzz runs: {err}")
        return
    }
    outcomes := [FuzzOutcome]{}
    loop index in 0..<runs.len() {
        if ran[index] == {
            // copy: the outcome outlives the receipt it is read from
            .Ok(receipt) -> outcomes.push(FuzzOutcome{failure: fuzz_crash(receipt, "jet run"), code: receipt.code, output: receipt.output.copy(), errors: failure_line(receipt.errors)})
            .Err(error) -> outcomes.push(FuzzOutcome{failure: "couldn't start jet: {error}", code: -1, output: "", errors: ""})
        }
    }
    loop (at, index) in running {
        program: programs[index]
        first: at * CORE_LEVELS.len()
        loop (offset, level) in CORE_LEVELS {
            id: "{program.id} [{level}]"
            if !rows.selects(id) -> next
            failure: fuzz_run_failure(program, outcomes[first], outcomes[first + offset], offset == 0)
            if failure == "" -> rows.pass(id) else -> rows.fail(id, failure)
        }
    }
}

// The programs of the corpus directory `dir` whose check or run rows are
// selected, pushed to `programs`.
fuzz_programs: fn(rows: TestRows, checkout: String, scratch: String, dir: String, programs: &[FuzzProgram]) {
    relative: "{FUZZ_CORPUS}/{dir}"
    directory: files.join(checkout, relative)
    listed: files.list_dir(directory) ?? {
        rows.fail(relative, "couldn't list `{relative}`: {err}")
        return
    }
    names := [String]{}
    loop entry in listed {
        if !entry.is_dir && entry.name.ends_with(".jet") -> names.push(entry.name.copy()) // copy: the listing keeps its entries
    }
    names.sort()
    if names.len() == 0 {
        rows.fail(relative, "the corpus directory holds no `.jet` file")
        return
    }
    runs: dir == FUZZ_RUNS
    pins: if runs -> fuzz_pins(directory) else -> [String: String]{}
    loop name in names {
        id: "{relative}/{name}"
        run_selected := false
        if runs {
            loop level in CORE_LEVELS {
                if rows.selects("{id} [{level}]") -> run_selected = true
            }
        }
        checked: rows.selects(id)
        if !checked && !run_selected -> next
        text: files.read(files.join(directory, name)) ?? {
            rows.fail(id, "couldn't read `{id}`: {err}")
            next
        }
        cwd := directory.copy() // copy: every check and run of this file starts in this directory
        if text.contains("__NUL__") {
            files.write(files.join(scratch, name), text.replace("__NUL__", String.from_bytes([U8]{0}) ?? "")) ?? {
                rows.fail(id, "couldn't write its scratch copy: {err}")
                next
            }
            cwd = scratch.copy() // copy: the program holds its own directory
        }
        pin: pins.get(name) ?? ""
        pinned := ""
        if run_selected && pin != "" {
            pinned = files.read(files.join(directory, pin)) ?? {
                rows.fail("{id} [{CORE_LEVELS[0]}]", "couldn't read `{relative}/{pin}`, the output {FUZZ_MANIFEST} pairs it with: {err}")
                next
            }
        }
        // copy: the program row outlives the loop's names and the manifest map
        programs.push(FuzzProgram{id: id, name: name.copy(), cwd: cwd, refused: dir == FUZZ_REFUSED, runs: run_selected, pin: pin.copy(), pinned: pinned, checked: checked})
    }
}

// The `exact-stdout` pairs of a FUZZ_RUNS directory's FUZZ_MANIFEST
// (`source<TAB>output<TAB>relation<TAB>exception` rows): source -> output.
fuzz_pins: fn(directory: String) -> [String: String] {
    pins := [String: String]{}
    text: files.read(files.join(directory, FUZZ_MANIFEST)) ?? return pins
    loop line in text.split("\n") {
        if line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() >= 3 && fields[2] == "exact-stdout" -> pins[fields[0].copy()] = fields[1].copy() // copy: the map outlives the manifest text
    }
    pins
}

// How many fuzz checks or runs go at once: the packages suite's sizing, with
// a FUZZ_MEMORY claim each.
fuzz_jobs: fn(count: Int) -> Int {
    requested: Int.parse(sys.get("JET_TEST_SUITE_MEMORY") ?? "") ?? 0
    kit_claim_jobs(kit_execute_budget(requested, kit_exec_available_memory()), FUZZ_MEMORY, sys.cpu_count(), PACKAGE_JOBS, PACKAGE_JOBS_MAX, count)
}

// A child jet on one fuzz program `cwd` holds, bounded by FUZZ_TIMEOUT_MS.
fuzz_command: fn(setup: SuiteSetup, cwd: String, args: [String]) -> ProcessSpec {
    jet_command(setup, setup.jet, args).cwd(cwd).env("NO_COLOR", "1").timeout(time.duration_ms(FUZZ_TIMEOUT_MS))
}

// Why a jet failed whatever its row expects: a signal, the time limit, or an
// internal compiler error; "" when none of them.
fuzz_crash: fn(receipt: ProcessReceipt, verb: String) -> String {
    if receipt.signal != None -> return "`{verb}` died by a signal"
    if receipt.timed_out -> return "`{verb}` ran past {FUZZ_TIMEOUT_MS} ms"
    if receipt.code == FUZZ_INTERNAL_EXIT -> return "`{verb}` exited {FUZZ_INTERNAL_EXIT}, an internal compiler error: {failure_line(receipt.errors)}"
    ""
}

// Why a program's check row fails; "" when the verdict is its directory's.
fuzz_check_failure: fn(program: FuzzProgram, receipt: ProcessReceipt) -> String {
    crash: fuzz_crash(receipt, "jet check")
    if crash != "" -> return crash
    if program.refused {
        if receipt.success -> return "`jet check` accepted it; it was written to be refused with {fuzz_named_code(program.name)}"
        return ""
    }
    if receipt.success -> return ""
    reports: fuzz_reports(receipt.output)
    "`jet check` exited {receipt.code}: {if reports.len() == 0 -> failure_line(receipt.errors) else -> reports.join("; ")}"
}

// The code a FUZZ_REFUSED file's name gives: `<name>.<code>.jet`.
fuzz_named_code: fn(name: String) -> String {
    stem: name.removesuffix(".jet")
    at: stem.rfind(".")
    if at <= 0 -> return "no named code"
    stem.slice(at + 1, stem.len()).copy() // copy: the code outlives the stem it is cut from
}

// Why one run row fails; "" when it passes. The first level's run exits 0
// and prints its pinned output; a later level's ends as the first one did.
fuzz_run_failure: fn(program: FuzzProgram, first: FuzzOutcome, this: FuzzOutcome, is_first: Bool) -> String {
    if this.failure != "" -> return this.failure
    if is_first {
        if this.code != 0 -> return "`jet run` exited {this.code}: {this.errors}"
        // copy: Dyn.Text owns its text
        if program.pin != "" && this.output != program.pinned -> return "stdout differs from `{program.pin}`: got {json.dumps(Dyn.Text(this.output.copy())) ?? ""}"
        return ""
    }
    if first.failure != "" -> return "the {CORE_LEVELS[0]} run failed, so this one has nothing to agree with: {first.failure}"
    if this.code != first.code -> return "`jet run` exited {this.code}, but {first.code} at {CORE_LEVELS[0]}: {this.errors}"
    // copy: Dyn.Text owns its text
    if this.output != first.output -> return "stdout differs from the {CORE_LEVELS[0]} run: got {json.dumps(Dyn.Text(this.output.copy())) ?? ""}, {CORE_LEVELS[0]} printed {json.dumps(Dyn.Text(first.output.copy())) ?? ""}"
    ""
}

// The error reports of a `jet check --json` answer, each `<code>: <what>`.
fuzz_reports: fn(output: String) -> [String] {
    tree: json.parse(output) ?? return [String]{}
    reports := [String]{}
    if json_field(tree, "reports") == .Array(items) {
        loop item in items {
            if json_field(item, "severity") != (Dyn.Text("error")) -> next
            if json_field(item, "code") == .Text(code) {
                if json_field(item, "what") == .Text(what) -> reports.push("{code}: {what}") else -> reports.push("{code}:")
            }
        }
    }
    reports
}

// ---------------------------------------------------------------------------
// selfhost: the jet under test builds the compiler (s2), s2 builds it again
// (s3), and s2 and s3 are the same bytes: the fixed point. Each stage gets
// the runtime pack of the jet under test, so the two builds differ only in
// the compiler that made them.
selfhost_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    _held: build_lock(setup) ?? {
        rows.fail("s2 builds", err.message)
        return
    }
    stages: files.join(setup.checkout, SELFHOST_STAGES)
    if files.exists(stages) {
        files.remove_all(stages) ?? {
            rows.fail("s2 builds", "couldn't clear `{stages}`: {err}")
            return
        }
    }
    pack: files.join(files.dirname(setup.jet), "jet-runtime")
    s2: compiler_stage(rows, setup, setup.jet, "s2", files.join(stages, "s2"), pack) ?? return
    rows.pass("s2 builds")
    s3: compiler_stage(rows, setup, s2, "s3", files.join(stages, "s3"), pack) ?? return
    rows.pass("s3 builds")
    if {
        same_build(s2, s3) -> rows.pass("fixed point")
        else -> rows.fail("fixed point", "s2 and s3 differ: s2 {digest(s2)}, s3 {digest(s3)}")
    }
}

// The BUILD_LOCK, waited for.
build_lock: fn(setup: SuiteSetup) -> FileLock Err! {
    path: files.join(setup.checkout, BUILD_LOCK)
    files.create_dir_all(files.dirname(path)) ?? return Err("couldn't create `{files.dirname(path)}`: {err}")
    lock: files.lock(path) ?? return Err("couldn't lock `{path}`: {err}")
    Ok(lock)
}

// `builder` builds Compiler cold under its own identity, and the `jet` (and
// `jet.o`) it built move to `directory`, beside the runtime `pack`. The new
// jet's path, or a failing `<stage> builds` row.
compiler_stage: fn(rows: TestRows, setup: SuiteSetup, builder: String, stage: String, directory: String, pack: String) -> String? {
    id: "{stage} builds"
    output: files.join(setup.checkout, BUILD_OUTPUT)
    receipt: compiler_build(setup, builder, output, None) ?? {
        rows.fail(id, err.message)
        return None
    }
    if !receipt.success {
        rows.fail(id, "`jet build Compiler` exited {receipt.code}: {failure_line(receipt.errors)}")
        return None
    }
    stage_move(output, directory, pack) ?? {
        rows.fail(id, err.message)
        return None
    }
    Val(files.join(directory, "jet"))
}

// One cold `jet build --profile ship Compiler` by `builder`, identified as the chain does
// (`name@version#<sha256 of the builder>`), with
// the trace written to `trace` when given.
compiler_build: fn(setup: SuiteSetup, builder: String, output: String, trace: String?) -> ProcessReceipt Err! {
    bytes: files.read_bytes(builder) ?? return Err("couldn't read `{builder}`: {err}")
    if files.exists(output) {
        files.remove_all(output) ?? return Err("couldn't clear `{output}`: {err}")
    }
    current: sys.stack_limit() ?? return Err("couldn't read the stack limit: {err}")
    sys.set_stack_limit(Val(BUILD_STACK), current.hard) ?? return Err("couldn't raise the stack limit: {err}")
    spec := jet_command(setup, builder, [String]{"build", "--profile", "ship", "Compiler"}).env("JET_COMPILER_IDENTITY", "{setup.version}#{crypto.sha256(bytes).hex()}")
    if trace == .Val(path) -> spec = spec.env("JET_TRACE_FILE", path)
    receipt: spec.run() ?? return Err("couldn't run `{builder} build --profile ship Compiler`: {err}")
    Ok(receipt)
}

// Moves the built `jet` and `jet.o` from `output` into `directory` and copies
// the runtime `pack` beside them. A copy, not a link: a build step that runs
// the stage's jet mounts its folder read-only in the sandbox, where a link
// to a pack outside that folder resolves to nothing.
stage_move: fn(output: String, directory: String, pack: String) Err! {
    files.create_dir_all(directory) ?? return Err("couldn't create `{directory}`: {err}")
    loop name in ([String]{"jet", "jet.o"}) {
        from: files.join(output, name)
        if name == "jet.o" && !files.is_file(from) -> next
        files.rename(from, files.join(directory, name)) ?? return Err("couldn't move `{from}`: {err}")
    }
    files.copy_dir(pack, files.join(directory, "jet-runtime")) ?? return Err("couldn't copy the runtime pack `{pack}`: {err}")
    files.remove_all(output) ?? return Err("couldn't clear `{output}`: {err}")
}

// Two stages built the same compiler: the same `jet`, and the same `jet.o`
// when they kept one.
same_build: fn(a: String, b: String) -> Bool {
    if digest(a) != digest(b) -> return false
    digest("{a}.o") == digest("{b}.o")
}

digest: fn(path: String) -> String {
    bytes: files.read_bytes(path) ?? return "absent"
    "{crypto.sha256(bytes)}"
}

// ---------------------------------------------------------------------------
// perf: a cold self-compile by the jet under test, traced, held to the
// PERF_COLUMN budget of Tools/perf/budget/check. One row per budget row
// (`phase <id> <phase>`) and per counter row (`unit <id> <counter>`).
perf_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    _held: build_lock(setup) ?? {
        rows.fail("self-compile", err.message)
        return
    }
    scratch: files.temp_dir("jet-perf") ?? {
        rows.fail("self-compile", "couldn't create a scratch directory: {err}")
        return
    }
    trace: files.join(scratch.path, "trace.jsonl")
    output: files.join(setup.checkout, BUILD_OUTPUT)
    receipt: compiler_build(setup, setup.jet, output, Val(trace)) ?? {
        rows.fail("self-compile", err.message)
        return
    }
    if !receipt.success {
        rows.fail("self-compile", "`jet build Compiler` exited {receipt.code}: {failure_line(receipt.errors)}")
        return
    }
    rows.pass("self-compile")
    checked: jet_command(setup, setup.jet, [String]{"run", "Tools/perf/budget/check/run.jet", "--", trace, "--column", PERF_COLUMN}).run() ?? {
        rows.fail("budget", "couldn't run Tools/perf/budget/check: {err}")
        return
    }
    table := ""
    count := 0
    loop line in checked.output.split("\n") {
        cells := [String]{}
        loop cell in line.split("  ") {
            if cell.trim() != "" -> cells.push(cell.trim())
        }
        if cells.len() < 3 -> next
        if cells[0] == "row" {
            table = if cells[1] == "phase" -> "phase" else -> "unit"
            next
        }
        status: cells[cells.len() - 1]
        id: "{table} {cells[0]} {cells[1]}"
        if {
            status == "ok" -> rows.pass(id)
            status == "OVER" -> rows.fail(id, "over the {PERF_COLUMN} budget: {cells.join(", ")}")
            status == "absent" -> rows.skip(id, "the trace has none of its spans")
            else -> next
        }
        count += 1
    }
    if count == 0 || (!checked.success && checked.code != 1) {
        rows.fail("budget", "Check.jet exited {checked.code}: {failure_line(checked.output)} {failure_line(checked.errors)}")
    }
}
