// The compiler workspace's code suites, run by the test
// profiles of package.jet: `jet test Compiler --profile packages`, `selfhost`
// or `perf`. Each runs in its own child, where JET names the jet under test,
// JET_COMPILER_IDENTITY its identity (that jet sets it when the caller didn't)
// and JET_TEST_SUITE_ROOT this package's directory; the checkout is its
// parent. A row is one check; the profile compares the rows with
// `.jet/test/<profile>/<suite>.rows`.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    sys: core.sys
}

// The packages a `packages` run tests at once.
PACKAGE_JOBS: 4

// The trees whose packages a `packages` run tests, from the checkout.
PACKAGE_TREES: [String]{"Compiler", "Jetpack"}

// The packages the compiler assembles from their sources instead of building
// them as packages, so they have no standalone `jet test`: the bootstrap chain
// links JetRuntime's sources.list into the native runtime library, and the
// `registries` profile runs its Test registries as assembled standalone files
// (Tools/agent/CompilerRegistries.jet). The compiler embeds Prelude's sources
// through the generated registry files; Prelude has no #Test. A `packages` run
// reports each as a skipped row.
ASSEMBLED_PACKAGES: [String]{"Compiler/JetRuntime", "Compiler/Prelude"}

// The tests.list sections whose areas have no package.jet: Store, Provider
// and Recipe (`Engine`, one dependency cycle), Services, Image and CLI. Their
// claims run as one unit Jetpack/Bootstrap/assemble.mjs assembles. JetOS is
// frozen and stays out.
JETPACK_ENGINE_SECTIONS: "Engine,Services,Image,CLI"

// Where the engine unit and the hosted engine are assembled, from the checkout.
JETPACK_ENGINE_SCRATCH: "Jetpack/Bootstrap/.jet/test"

// What the compiler's deepest recursion needs, as the bootstrap chain gives it.
BUILD_STACK: 1073741824

// Where `jet build Compiler` leaves the `jet` executable, from the checkout.
BUILD_OUTPUT: "Compiler/JetCli/.jet/build"

// Held for each suite's builds: selfhost and perf share BUILD_OUTPUT, and
// `full` runs them side by side.
BUILD_LOCK: "Compiler/JetCli/.jet/test-build.lock"

// Where selfhost keeps its s2 and s3 compilers, from the checkout: beside
// BUILD_OUTPUT on the same file system, so each built `jet` moves by rename.
SELFHOST_STAGES: "Compiler/JetCli/.jet/selfhost"

// The SPEED-500K milestone column the self-compile is held to.
PERF_COLUMN: "225K"

test: fn(t: Test) -> Int {
    t.suite("packages", package_suite_rows)
    t.suite("selfhost", selfhost_rows)
    t.suite("perf", perf_rows)
    t.run()
}

// The jet under test, the checkout, and the `name@version` its builds stamp
// on their identities (as the bootstrap chain does), or a failing `setup` row.
SuiteSetup: struct {
    jet: String
    checkout: String
    version: String
}

suite_setup: fn(rows: TestRows) -> SuiteSetup? {
    jet: sys.get("JET") ?? ""
    root: sys.get("JET_TEST_SUITE_ROOT") ?? ""
    if jet == "" || root == "" {
        rows.fail("setup", "JET or JET_TEST_SUITE_ROOT is unset: run the suite through `jet test Compiler --profile <profile>`")
        return None
    }
    identity: sys.get("JET_COMPILER_IDENTITY") ?? ""
    version: identity.split("#").to_list()[0].copy()
    if !version.contains("@") {
        rows.fail("setup", "JET_COMPILER_IDENTITY `{identity}` names no `name@version`: set the jet under test's identity")
        return None
    }
    absolute: files.absolute(root) ?? {
        rows.fail("setup", "couldn't resolve `{root}`: {err}")
        return None
    }
    Val(SuiteSetup{jet: jet, checkout: files.dirname(absolute), version: version})
}

// A child jet in the checkout, without the profile run's own settings, so a
// child `jet test` runs its own tests and writes its own evidence.
jet_command: fn(setup: SuiteSetup, jet: String, args: [String]) -> ProcessSpec {
    argv := [String]{jet}
    loop arg in args -> argv.push(arg.copy())
    spec := process.cmd(argv).cwd(setup.checkout).env("JET_TOOLCHAIN_ROOT", setup.checkout)
    names: sys.vars() ?? [String]{}
    loop name in names {
        if name.starts_with("JET_TEST_") || name.starts_with("JET_NATIVE_TEST_") || name.starts_with("JET_EVIDENCE_") {
            spec = spec.env_remove(name)
        }
    }
    spec
}

// A child's output reduced to a failing row's detail: its first `Error`
// line (a jet diagnostic's header), else its last non-blank line.
failure_line: fn(text: String) -> String {
    found := ""
    loop line in text.split("\n") {
        if line.starts_with("Error") -> return line.trim()
        if line.trim() != "" -> found = line.trim()
    }
    found
}

// ---------------------------------------------------------------------------
// packages: one row per #Test of every package under PACKAGE_TREES that the
// `tests` suite doesn't run, `<package>: <test>`, from `jet test <package>`.
// The `tests` suite runs the workspace members; this suite runs everything
// else: each member's `Tests` package, the tool packages beside the members,
// every Jetpack package, and the Jetpack engine areas that have no package
// (jetpack_engine_rows). A package whose tests didn't run (one that doesn't
// compile, say) is the failing row `<package>`. Fixture packages are test
// data, not packages under test; an ASSEMBLED_PACKAGES package is a skipped
// row. Claims that drive the jet CLI run the jet under test, named by JET_BIN.
package_suite_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    members: workspace_members(setup) ?? {
        rows.fail("Compiler", err.message)
        return
    }
    packages := [String]{}
    loop tree in PACKAGE_TREES {
        package_dirs(setup.checkout, tree, members, packages) ?? {
            rows.fail(tree, err.message)
            return
        }
    }
    packages.sort()
    loop package in ASSEMBLED_PACKAGES -> rows.skip(package, "assembled by the compiler from its sources, not built as a package")
    specs := [ProcessSpec]{}
    loop package in packages {
        specs.push(jet_command(setup, setup.jet, [String]{"test", package}).env("JET_BIN", setup.jet))
    }
    results: process.run_all(specs, PACKAGE_JOBS) ?? {
        rows.fail("packages", "couldn't start the package runs: {err}")
        return
    }
    loop (index, package) in packages {
        if results[index] == {
            .Ok(receipt) -> { package_rows(rows, package, receipt) }
            .Err(error) -> rows.fail(package, "couldn't run `jet test {package}`: {error}")
        }
    }
    jetpack_engine_rows(rows, setup)
}

// The Jetpack engine areas' claims, one row each, `Jetpack/<section>:
// <claim>`: assemble.mjs joins every implementation file and the claims of
// JETPACK_ENGINE_SECTIONS into one unit, and `jet test` runs it serially (the
// claims share process state). JET_BIN names the jet under test; process
// claims run the engine named by JETPACK_BIN, the caller's, else the hosted
// engine built here from this checkout. A unit that didn't run to its
// summary is the failing row `Jetpack engine`.
jetpack_engine_rows: fn(rows: TestRows, setup: SuiteSetup) {
    unit: "Jetpack engine"
    scratch: files.join(setup.checkout, JETPACK_ENGINE_SCRATCH)
    assembled: jetpack_assemble(setup, scratch, "aot") ?? {
        rows.fail(unit, err.message)
        return
    }
    claims: jetpack_claims(files.join(scratch, "aot/jetpack.map.json")) ?? {
        rows.fail(unit, err.message)
        return
    }
    engine := sys.get("JETPACK_BIN") ?? ""
    if engine == "" {
        engine = jetpack_hosted(setup, scratch) ?? {
            rows.fail(unit, err.message)
            return
        }
    }
    receipt: jet_command(setup, setup.jet, [String]{"test", "src/jetpack.jet", "--serial"}).cwd(files.join(assembled, "project")).env("JET_BIN", setup.jet).env("JETPACK_BIN", engine).run() ?? {
        rows.fail(unit, "couldn't run `jet test` on the engine unit: {err}")
        return
    }
    results := [String: String]{}
    summary := false
    loop line in receipt.output.split("\n") {
        if line.contains(" passed, ") && line.contains(" failed") -> summary = true
        at: line.rfind(": ")
        if at <= 0 -> next
        results[line.slice(0, at)] = line.slice(at + 2, line.len()).trim()
    }
    if !summary {
        detail: failure_line(receipt.errors)
        rows.fail(unit, "`jet test` of the engine unit exited {receipt.code}: {if detail == "" -> failure_line(receipt.output) else -> detail}")
        return
    }
    loop claim in claims {
        id: "Jetpack/{claim.section}: {claim.name}"
        verdict: results.get(claim.name) ?? ""
        if {
            verdict == "" -> rows.fail(id, "`jet test` reported no result for it")
            verdict == "pass" -> rows.pass(id)
            verdict.starts_with("skip") -> rows.skip(id, verdict)
            else -> rows.fail(id, verdict)
        }
    }
}

// One claim of the engine unit and its tests.list section.
JetpackClaim: struct {
    name: String
    section: String
}

// `node Jetpack/Bootstrap/assemble.mjs <mode>` into `scratch`, keeping only
// the JETPACK_ENGINE_SECTIONS claims: the mode's directory. The jet under test
// (JET_BIN) runs the assembler's Jet tool.
jetpack_assemble: fn(setup: SuiteSetup, scratch: String, mode: String) -> String Err! {
    script: files.join(setup.checkout, "Jetpack/Bootstrap/assemble.mjs")
    ran: process.cmd([String]{"node", script, mode}).cwd(setup.checkout).env("JET_BIN", setup.jet).env("JETPACK_BOOTSTRAP_SCRATCH", scratch).env("JETPACK_BOOTSTRAP_TEST_AREAS", JETPACK_ENGINE_SECTIONS).env_remove("JETPACK_BOOTSTRAP_SOURCE_ROOT").env_remove("JETPACK_BOOTSTRAP_AREAS").env_remove("JETPACK_BOOTSTRAP_OWN_AREA").run() ?? return Err("couldn't run `node {script} {mode}`: {err}")
    if !ran.success -> return Err("`assemble.mjs {mode}` exited {ran.code}: {failure_line(ran.errors)}")
    Ok(files.join(scratch, mode))
}

// The hosted engine, `jet build` of every implementation file and
// Jetpack/run.jet; jet's own build cache makes an unchanged rebuild cheap.
jetpack_hosted: fn(setup: SuiteSetup, scratch: String) -> String Err! {
    hosted: jetpack_assemble(setup, scratch, "hosted") ?? return Err(err.message)
    project: files.join(hosted, "project")
    built: jet_command(setup, setup.jet, [String]{"build", "src/jetpack.jet"}).cwd(project).run() ?? return Err("couldn't build the hosted engine: {err}")
    binary: files.join(project, ".jet/build/jetpack")
    if !built.success || !files.is_file(binary) {
        detail: failure_line(built.errors)
        return Err("the hosted engine didn't build (exit {built.code}): {if detail == "" -> failure_line(built.output) else -> detail}")
    }
    Ok(binary)
}

// The unit's claims in order with their sections, from its source map.
jetpack_claims: fn(path: String) -> [JetpackClaim] Err! {
    text: files.read(path) ?? return Err("couldn't read `{path}`: {err}")
    tree: json.parse(text) ?? return Err("`{path}` is not JSON: {err}")
    names: json_texts(json_field(tree, "tests"))
    sections: json_texts(json_field(tree, "test_areas"))
    if names.len() == 0 || names.len() != sections.len() -> return Err("`{path}` lists no claims with their sections")
    claims := [JetpackClaim]{}
    loop (index, name) in names -> claims.push(JetpackClaim{name: name.copy(), section: sections[index].copy()})
    Ok(claims)
}

json_field: fn(tree: Dyn, name: String) -> Dyn {
    if tree == .Object(entries) {
        loop entry in entries {
            if entry.key == name -> return entry.value.copy()
        }
    }
    Dyn.Null
}

json_texts: fn(value: Dyn) -> [String] {
    texts := [String]{}
    if value == .Array(items) {
        loop item in items {
            if item == .Text(text) -> texts.push(text.copy())
        }
    }
    texts
}

// The member directories of the Compiler workspace, `Compiler/<member>`, from
// the `members: [...]` list of its package.jet: the packages the `tests`
// suite runs.
workspace_members: fn(setup: SuiteSetup) -> [String] Err! {
    path: files.join(setup.checkout, "Compiler/package.jet")
    text: files.read(path) ?? return Err("couldn't read `{path}`: {err}")
    start: text.find("members: [")
    if start < 0 -> return Err("`{path}` has no `members: [` list")
    rest: text.slice(start, text.len())
    end: rest.find("]")
    if end < 0 -> return Err("`{path}` doesn't close its `members` list")
    members := [String]{}
    loop (index, part) in rest.slice(0, end).split("\"").to_list() {
        if index % 2 == 1 -> members.push("Compiler/{part}")
    }
    if members.len() == 0 -> return Err("`{path}` lists no members")
    Ok(members)
}

// Adds every package directory at or below `relative` (from `checkout`) to
// `found`, except the workspace root, the `members`, ASSEMBLED_PACKAGES,
// build output, hidden directories and fixtures.
package_dirs: fn(checkout: String, relative: String, members: [String], found: &[String]) Err! {
    directory: files.join(checkout, relative)
    if relative != "Compiler" && !members.contains(relative) && !ASSEMBLED_PACKAGES.contains(relative) && files.is_file(files.join(directory, "package.jet")) {
        found.push(relative.copy())
    }
    listed: files.list_dir(directory) ?? return Err("couldn't list `{relative}`: {err}")
    loop entry in listed {
        if !entry.is_dir || entry.name.starts_with(".") || entry.name.ends_with(".fixture") -> next
        if entry.name == "fixtures" || entry.name == "Fixtures" -> next
        package_dirs(checkout, "{relative}/{entry.name}", members, found) ?? return Err(err.message)
    }
}

// A package's rows from its `<test>: <verdict>` lines; a run that ended
// without a summary, or failed with no failing test, is the row `<package>`;
// a package with no #Test blocks is that row, skipped.
package_rows: fn(rows: TestRows, package: String, receipt: ProcessReceipt) {
    if receipt.errors.contains("[jet.NoTestsFound]") || receipt.output.contains("[jet.NoTestsFound]") {
        rows.skip(package, "no #Test blocks")
        return
    }
    summary := false
    failed := false
    loop line in receipt.output.split("\n") {
        if line.contains(" passed, ") && line.contains(" failed, ") -> summary = true
        at: line.rfind(": ")
        if at <= 0 -> next
        name: line.slice(0, at)
        verdict: line.slice(at + 2, line.len()).trim()
        id: "{package}: {name}"
        if {
            verdict == "pass" || verdict == "expected-fail" -> rows.pass(id)
            verdict.starts_with("skip") -> rows.skip(id, verdict)
            verdict.starts_with("FAIL") || verdict == "unexpected-pass" -> {
                rows.fail(id, verdict)
                failed = true
            }
            else -> {}
        }
    }
    if !summary || (!receipt.success && !failed) {
        detail: failure_line(receipt.errors)
        rows.fail(package, "`jet test {package}` exited {receipt.code}: {if detail == "" -> failure_line(receipt.output) else -> detail}")
    }
}

// ---------------------------------------------------------------------------
// selfhost: the jet under test builds the compiler (s2), s2 builds it again
// (s3), and s2 and s3 are the same bytes: the fixed point. Each stage gets
// the runtime pack of the jet under test, so the two builds differ only in
// the compiler that made them.
selfhost_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    _held: build_lock(setup) ?? {
        rows.fail("s2 builds", err.message)
        return
    }
    stages: files.join(setup.checkout, SELFHOST_STAGES)
    if files.exists(stages) {
        files.remove_all(stages) ?? {
            rows.fail("s2 builds", "couldn't clear `{stages}`: {err}")
            return
        }
    }
    pack: files.join(files.dirname(setup.jet), "jet-runtime")
    s2: compiler_stage(rows, setup, setup.jet, "s2", files.join(stages, "s2"), pack) ?? return
    rows.pass("s2 builds")
    s3: compiler_stage(rows, setup, s2, "s3", files.join(stages, "s3"), pack) ?? return
    rows.pass("s3 builds")
    if {
        same_build(s2, s3) -> rows.pass("fixed point")
        else -> rows.fail("fixed point", "s2 and s3 differ: s2 {digest(s2)}, s3 {digest(s3)}")
    }
}

// The BUILD_LOCK, waited for.
build_lock: fn(setup: SuiteSetup) -> FileLock Err! {
    path: files.join(setup.checkout, BUILD_LOCK)
    files.create_dir_all(files.dirname(path)) ?? return Err("couldn't create `{files.dirname(path)}`: {err}")
    lock: files.lock(path) ?? return Err("couldn't lock `{path}`: {err}")
    Ok(lock)
}

// `builder` builds Compiler cold under its own identity, and the `jet` (and
// `jet.o`) it built move to `directory`, beside the runtime `pack`. The new
// jet's path, or a failing `<stage> builds` row.
compiler_stage: fn(rows: TestRows, setup: SuiteSetup, builder: String, stage: String, directory: String, pack: String) -> String? {
    id: "{stage} builds"
    output: files.join(setup.checkout, BUILD_OUTPUT)
    receipt: compiler_build(setup, builder, output, None) ?? {
        rows.fail(id, err.message)
        return None
    }
    if !receipt.success {
        rows.fail(id, "`jet build Compiler` exited {receipt.code}: {failure_line(receipt.errors)}")
        return None
    }
    stage_move(output, directory, pack) ?? {
        rows.fail(id, err.message)
        return None
    }
    Val(files.join(directory, "jet"))
}

// One cold `jet build Compiler` by `builder`, identified as the chain does
// (`name@version#<sha256 of the builder>`), with
// the trace written to `trace` when given.
compiler_build: fn(setup: SuiteSetup, builder: String, output: String, trace: String?) -> ProcessReceipt Err! {
    bytes: files.read_bytes(builder) ?? return Err("couldn't read `{builder}`: {err}")
    if files.exists(output) {
        files.remove_all(output) ?? return Err("couldn't clear `{output}`: {err}")
    }
    current: sys.stack_limit() ?? return Err("couldn't read the stack limit: {err}")
    sys.set_stack_limit(Val(BUILD_STACK), current.hard) ?? return Err("couldn't raise the stack limit: {err}")
    spec := jet_command(setup, builder, [String]{"build", "Compiler"}).env("JET_COMPILER_IDENTITY", "{setup.version}#{crypto.sha256(bytes).hex()}")
    if trace == .Val(path) -> spec = spec.env("JET_TRACE_FILE", path)
    receipt: spec.run() ?? return Err("couldn't run `{builder} build Compiler`: {err}")
    Ok(receipt)
}

// Moves the built `jet` and `jet.o` from `output` into `directory` and links
// the runtime `pack` beside them.
stage_move: fn(output: String, directory: String, pack: String) Err! {
    files.create_dir_all(directory) ?? return Err("couldn't create `{directory}`: {err}")
    loop name in ([String]{"jet", "jet.o"}) {
        from: files.join(output, name)
        if name == "jet.o" && !files.is_file(from) -> next
        files.rename(from, files.join(directory, name)) ?? return Err("couldn't move `{from}`: {err}")
    }
    files.symlink(pack, files.join(directory, "jet-runtime")) ?? return Err("couldn't link the runtime pack `{pack}`: {err}")
    files.remove_all(output) ?? return Err("couldn't clear `{output}`: {err}")
}

// Two stages built the same compiler: the same `jet`, and the same `jet.o`
// when they kept one.
same_build: fn(a: String, b: String) -> Bool {
    if digest(a) != digest(b) -> return false
    digest("{a}.o") == digest("{b}.o")
}

digest: fn(path: String) -> String {
    bytes: files.read_bytes(path) ?? return "absent"
    "{crypto.sha256(bytes)}"
}

// ---------------------------------------------------------------------------
// perf: a cold self-compile by the jet under test, traced, held to the
// PERF_COLUMN budget of Tools/perf/budget/Check.jet. One row per budget row
// (`phase <id> <phase>`) and per counter row (`unit <id> <counter>`).
perf_rows: fn(rows: TestRows) {
    setup: suite_setup(rows) ?? return
    _held: build_lock(setup) ?? {
        rows.fail("self-compile", err.message)
        return
    }
    scratch: files.temp_dir("jet-perf") ?? {
        rows.fail("self-compile", "couldn't create a scratch directory: {err}")
        return
    }
    trace: files.join(scratch.path, "trace.jsonl")
    output: files.join(setup.checkout, BUILD_OUTPUT)
    receipt: compiler_build(setup, setup.jet, output, Val(trace)) ?? {
        rows.fail("self-compile", err.message)
        return
    }
    if !receipt.success {
        rows.fail("self-compile", "`jet build Compiler` exited {receipt.code}: {failure_line(receipt.errors)}")
        return
    }
    rows.pass("self-compile")
    checked: jet_command(setup, setup.jet, [String]{"run", "Tools/perf/budget/Check.jet", "--", trace, "--column", PERF_COLUMN}).run() ?? {
        rows.fail("budget", "couldn't run Tools/perf/budget/Check.jet: {err}")
        return
    }
    table := ""
    count := 0
    loop line in checked.output.split("\n") {
        cells := [String]{}
        loop cell in line.split("  ") {
            if cell.trim() != "" -> cells.push(cell.trim())
        }
        if cells.len() < 3 -> next
        if cells[0] == "row" {
            table = if cells[1] == "phase" -> "phase" else -> "unit"
            next
        }
        status: cells[cells.len() - 1]
        id: "{table} {cells[0]} {cells[1]}"
        if {
            status == "ok" -> rows.pass(id)
            status == "OVER" -> rows.fail(id, "over the {PERF_COLUMN} budget: {cells.join(", ")}")
            status == "absent" -> rows.skip(id, "the trace has none of its spans")
            else -> next
        }
        count += 1
    }
    if count == 0 || (!checked.success && checked.code != 1) {
        rows.fail("budget", "Check.jet exited {checked.code}: {failure_line(checked.output)} {failure_line(checked.errors)}")
    }
}
