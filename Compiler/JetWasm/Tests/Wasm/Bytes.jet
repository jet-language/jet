use jet_wasm.[TWO_63, WasmReader, wasm_put_fixed, wasm_put_signed, wasm_put_unsigned]

bytes_of: fn(values: [Int]) -> [U8] Never! {
    loop value in values -> U8{value}
}

// The failure message of reading one unsigned value of `bits` bits, or "" on success.
unsigned_failure: fn(values: [Int], bits: Int) -> String Never! {
    reader := WasmReader.new(^bytes_of(values))
    if &reader.unsigned(bits) == {
        .Ok(_) -> ""
        .Err(error) -> error.render()
    }
}

signed_failure: fn(values: [Int], bits: Int) -> String Never! {
    reader := WasmReader.new(^bytes_of(values))
    if &reader.signed(bits) == {
        .Ok(_) -> ""
        .Err(error) -> error.render()
    }
}

#Test("unsigned LEB128 reads the shortest and padded encodings and rejects overlong or oversized ones") {
    reader := WasmReader.new(^bytes_of([Int]{0xe5, 0x8e, 0x26, 0x80, 0x80, 0x80, 0x80, 0x00, 0xff, 0xff, 0xff, 0xff, 0x0f}))
    first: &reader.u32() ?? panic("624485")
    assert_eq(first, 624485)
    second: &reader.u32() ?? panic("padded zero")
    assert_eq(second, 0)
    third: &reader.u32() ?? panic("u32 max")
    assert_eq(third, 4294967295)
    assert(reader.done())
    assert_eq(unsigned_failure([Int]{0x80, 0x80, 0x80, 0x80, 0x80, 0x00}, 32), "integer representation too long (at byte 0)")
    assert_eq(unsigned_failure([Int]{0xff, 0xff, 0xff, 0xff, 0x1f}, 32), "integer too large (at byte 0)")
    assert_eq(unsigned_failure([Int]{0x80}, 32), "unexpected end of LEB128 integer (at byte 0)")
}

#Test("signed LEB128 sign-extends and range-checks against the declared width") {
    reader := WasmReader.new(^bytes_of([Int]{0x7f, 0xc0, 0xbb, 0x78, 0x80, 0x80, 0x80, 0x80, 0x78, 0xff, 0xff, 0xff, 0xff, 0x07}))
    expected: [Int]{-1, -123456, -2147483648, 2147483647}
    loop value in expected {
        got: &reader.signed(32) ?? panic("signed {value}")
        assert_eq(got, value)
    }
    assert_eq(signed_failure([Int]{0xff, 0xff, 0xff, 0xff, 0x0f}, 32), "integer too large (at byte 0)")
    wide := WasmReader.new(^bytes_of([Int]{0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7f}))
    minimum: &wide.signed(64) ?? panic("i64 min")
    assert_eq(minimum, 0 - TWO_63)
}

#Test("the writers round-trip through the reader") {
    out := [U8]{}
    samples: [Int]{0, 1, 63, 64, 127, 128, 624485, 4294967295}
    loop value in samples -> wasm_put_unsigned(&out, value)
    signed_samples: [Int]{0, -1, 63, -64, 64, -65, -123456, 0 - TWO_63, TWO_63 - 1}
    loop value in signed_samples -> wasm_put_signed(&out, value)
    wasm_put_fixed(&out, -1, 4)
    reader := WasmReader.new(^out)
    loop value in samples {
        got: &reader.unsigned(64) ?? panic("unsigned")
        assert_eq(got, value)
    }
    loop value in signed_samples {
        got: &reader.signed(64) ?? panic("signed")
        assert_eq(got, value)
    }
    word: &reader.fixed(4) ?? panic("fixed")
    assert_eq(word, 4294967295)
    assert(reader.done())
}

#Test("names are length-prefixed UTF-8 and malformed UTF-8 is rejected") {
    reader := WasmReader.new(^bytes_of([Int]{3, 0x6a, 0xc3, 0xa9, 2, 0xc3, 0x28}))
    name: &reader.name() ?? panic("name")
    assert_eq(name, "jé")
    message: if &reader.name() == {
        .Ok(_) -> ""
        .Err(error) -> error.render()
    }
    assert_eq(message, "malformed UTF-8 encoding (at byte 4)")
}
