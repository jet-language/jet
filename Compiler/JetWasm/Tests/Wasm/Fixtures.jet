use {
    files: core.files
    sys: core.sys
}

// A repository fixture, read through the toolchain root every test run sets.
fixture: fn(path: String) -[FS.Read, Env]> [U8] {
    root: sys.get("JET_TOOLCHAIN_ROOT") ?? panic("JET_TOOLCHAIN_ROOT is not set")
    files.read_bytes("{root}/{path}") ?? panic("fixture {path}: {err}")
}

mathkit: fn() -[FS.Read, Env]> [U8] {
    fixture("Examples/Modules/Packages/SandboxMathKit/mathkit.wasm")
}

extension: fn(name: String) -[FS.Read, Env]> [U8] {
    fixture("tests/fixtures/compiler_extension/{name}.wasm")
}
