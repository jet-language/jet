// The instruction table: every accepted instruction's text name, opcode,
// immediate shape, and for the instructions with a fixed operand signature,
// that signature. The decoder, the text reader and the validator all read
// this one table. A signature is "params:results" over the letters
// i (i32), l (i64), f (f32), d (f64); "" for instructions the validator types
// individually. `width` is a memory access's byte width (its natural alignment).

WASM_IMM_NONE :: 0
WASM_IMM_BLOCK :: 1
WASM_IMM_LABEL :: 2
WASM_IMM_BR_TABLE :: 3
WASM_IMM_FUNC :: 4
WASM_IMM_CALL_INDIRECT :: 5
WASM_IMM_LOCAL :: 6
WASM_IMM_GLOBAL :: 7
WASM_IMM_MEMARG :: 8
WASM_IMM_MEMORY :: 9
WASM_IMM_I32 :: 10
WASM_IMM_I64 :: 11
WASM_IMM_F32 :: 12
WASM_IMM_F64 :: 13
WASM_IMM_SELECT_T :: 14
WASM_IMM_REFTYPE :: 15
WASM_IMM_TABLE :: 16
WASM_IMM_TABLE_COPY :: 17
WASM_IMM_TABLE_INIT :: 18
WASM_IMM_ELEM :: 19
WASM_IMM_MEMORY_INIT :: 20
WASM_IMM_DATA :: 21
WASM_IMM_MEMORY_COPY :: 22

WASM_OP_UNREACHABLE :: 0x00
WASM_OP_NOP :: 0x01
WASM_OP_BLOCK :: 0x02
WASM_OP_LOOP :: 0x03
WASM_OP_IF :: 0x04
WASM_OP_ELSE :: 0x05
WASM_OP_END :: 0x0b
WASM_OP_BR :: 0x0c
WASM_OP_BR_IF :: 0x0d
WASM_OP_BR_TABLE :: 0x0e
WASM_OP_RETURN :: 0x0f
WASM_OP_CALL :: 0x10
WASM_OP_CALL_INDIRECT :: 0x11
WASM_OP_DROP :: 0x1a
WASM_OP_SELECT :: 0x1b
WASM_OP_SELECT_T :: 0x1c
WASM_OP_LOCAL_GET :: 0x20
WASM_OP_LOCAL_SET :: 0x21
WASM_OP_LOCAL_TEE :: 0x22
WASM_OP_GLOBAL_GET :: 0x23
WASM_OP_GLOBAL_SET :: 0x24
WASM_OP_TABLE_GET :: 0x25
WASM_OP_TABLE_SET :: 0x26
WASM_OP_MEMORY_SIZE :: 0x3f
WASM_OP_MEMORY_GROW :: 0x40
WASM_OP_I32_CONST :: 0x41
WASM_OP_I64_CONST :: 0x42
WASM_OP_F32_CONST :: 0x43
WASM_OP_F64_CONST :: 0x44
WASM_OP_REF_NULL :: 0xd0
WASM_OP_REF_IS_NULL :: 0xd1
WASM_OP_REF_FUNC :: 0xd2
WASM_OP_MEMORY_INIT :: 0xfc08
WASM_OP_DATA_DROP :: 0xfc09
WASM_OP_MEMORY_COPY :: 0xfc0a
WASM_OP_MEMORY_FILL :: 0xfc0b
WASM_OP_TABLE_INIT :: 0xfc0c
WASM_OP_ELEM_DROP :: 0xfc0d
WASM_OP_TABLE_COPY :: 0xfc0e
WASM_OP_TABLE_GROW :: 0xfc0f
WASM_OP_TABLE_SIZE :: 0xfc10
WASM_OP_TABLE_FILL :: 0xfc11

struct WasmOpInfo {
    name: String
    op: Int
    imm: Int
    sig: String
    width: Int
}

fn wasm_op(name: String, op: Int, imm: Int, sig: String) -> WasmOpInfo Never! {
    WasmOpInfo{name: name, op: op, imm: imm, sig: sig, width: 0}
}

fn wasm_mem_op(name: String, op: Int, sig: String, width: Int) -> WasmOpInfo Never! {
    WasmOpInfo{name: name, op: op, imm: WASM_IMM_MEMARG, sig: sig, width: width}
}

fn wasm_op_rows() -> [WasmOpInfo] Never! {
    [WasmOpInfo]{
        wasm_op("unreachable", 0x00, WASM_IMM_NONE, ""),
        wasm_op("nop", 0x01, WASM_IMM_NONE, ":"),
        wasm_op("block", 0x02, WASM_IMM_BLOCK, ""),
        wasm_op("loop", 0x03, WASM_IMM_BLOCK, ""),
