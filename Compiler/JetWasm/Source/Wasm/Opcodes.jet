// The instruction table indexed both ways: by opcode and by text name. The
// untyped `select` (0x1b) owns the name; the typed form is chosen by the text
// reader when a result type follows.
struct WasmOpTable {
    rows: [WasmOpInfo]
    by_op: [Int:Int]
    by_name: [String:Int]

    fn new() -> WasmOpTable Never! {
        rows :: wasm_op_rows()
        by_op := [Int:Int]{}
        by_name := [String:Int]{}
        loop index in 0..<rows.len() {
            row :: rows[index]
            by_op[row.op] = index
            if by_name.get(row.name) == None -> by_name[row.name] = index
        }
        WasmOpTable{rows: rows, by_op: by_op, by_name: by_name}
    }

    fn info(self, op: Int) -> WasmOpInfo? {
        index :: self.by_op.get(op) ?? return None
        Val(self.rows[index])
    }

    fn named(self, name: String) -> WasmOpInfo? {
        index :: self.by_name.get(name) ?? return None
        Val(self.rows[index])
    }
}

// A signature letter's value type.
fn wasm_sig_type(letter: Int) -> Int Never! {
    if letter == {
        0x69 -> WASM_I32
        0x6c -> WASM_I64
        0x66 -> WASM_F32
        else -> WASM_F64
    }
}

// The params (before ':') or results (after it) of a fixed signature.
fn wasm_sig_side(sig: String, results: Bool) -> [Int] Never! {
    out := [Int]{}
    after := false
    loop byte in sig.bytes() {
        code :: Int.from_u8(byte)
        if code == 0x3a {
            after = true
            next
        }
        if after == results -> &out.push(wasm_sig_type(code))
    }
    out
}
