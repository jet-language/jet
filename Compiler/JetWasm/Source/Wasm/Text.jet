// The text front end: a WebAssembly text (`.wat`) component or core module,
// encoded to the binary format so the binary decoder builds the same
// in-memory model from either form. The accepted subset is what the plugin
// worlds and the shipped fixtures use: core modules with folded and plain
// instructions, `$name` references, inline exports and imports, and
// components with core modules and instances, aliases, `canon lift`/`lower`,
// value and instance types, imports and exports. Anything else is a
// WasmError naming the construct, at its byte offset in the text.
use math: core.math

WAT_LIST: 0
WAT_ATOM: 1
WAT_STRING: 2

// The s-expression tree: node 0 is the synthetic root; children are linked
// first-child / next-sibling.
WatTree: struct {
    kinds: [Int]
    texts: [String]
    datas: [[U8]]
    ats: [Int]
    firsts: [Int]
    nexts: [Int]
    lasts: [Int]

    add: fn(&self, kind: Int, text: String, data: [U8], at: Int, parent: Int) -> Int Never! {
        id: self.kinds.len()
        self.kinds.push(kind)
        self.texts.push(text.copy())
        self.datas.push(data.copy())
        self.ats.push(at)
        self.firsts.push(-1)
        self.nexts.push(-1)
        self.lasts.push(-1)
        if parent >= 0 {
            last: self.lasts[parent]
            if last < 0 {
                self.firsts[parent] = id
            } else {
                self.nexts[last] = id
            }
            self.lasts[parent] = id
        }
        id
    }

    kids: fn(self, id: Int) -> [Int] Never! {
        out := [Int]{}
        k := self.firsts[id]
        loop k >= 0 {
            out.push(k)
            k = self.nexts[k]
        }
        out
    }

    is_list: fn(self, id: Int) -> Bool Never! {
        self.kinds[id] == WAT_LIST
    }

    is_atom: fn(self, id: Int) -> Bool Never! {
        self.kinds[id] == WAT_ATOM
    }

    atom: fn(self, id: Int) -> String Never! {
        if self.kinds[id] == WAT_ATOM -> self.texts[id].copy() else -> ""
    }

    // The keyword a list starts with, or "".
    head: fn(self, id: Int) -> String Never! {
        if self.kinds[id] != WAT_LIST -> return ""
        first: self.firsts[id]
        if first < 0 -> return ""
        self.atom(first)
    }

    is_id: fn(self, id: Int) -> Bool Never! {
        self.kinds[id] == WAT_ATOM && self.texts[id].starts_with("$")
    }

    // A `$name` or an unsigned index.
    is_ref: fn(self, id: Int) -> Bool Never! {
        if self.kinds[id] != WAT_ATOM -> return false
        if self.texts[id].starts_with("$") -> return true
        value: wat_int(self.texts[id]) ?? return false
        value >= 0 && !self.texts[id].starts_with("+") && !self.texts[id].starts_with("-")
    }

    fail: fn(self, id: Int, message: String) -> WasmError Never! {
        WasmError.new(message, self.ats[id])
    }

    string: fn(self, id: Int) -> String WasmError! {
        if self.kinds[id] != WAT_STRING -> return Err(self.fail(id, "expected a string"))
        String.from_bytes(self.datas[id]) ?? return Err(self.fail(id, "malformed UTF-8 encoding"))
    }
}

wat_is_space: fn(c: Int) -> Bool Never! {
    c == 0x20 || c == 0x09 || c == 0x0a || c == 0x0d
}

wat_is_delimiter: fn(c: Int) -> Bool Never! {
    wat_is_space(c) || c == 0x28 || c == 0x29 || c == 0x22 || c == 0x3b
}

wat_hex_digit: fn(c: Int) -> Int Never! {
    if c >= 0x30 && c <= 0x39 -> return c - 0x30
    if c >= 0x61 && c <= 0x66 -> return c - 0x61 + 10
    if c >= 0x41 && c <= 0x46 -> return c - 0x41 + 10
    return -1
}

// An integer literal: optional sign, decimal or `0x` hex, `_` separators.
wat_int: fn(text: String) -> Int? Never! {
    raw: text.bytes()
    k := 0
    negative := false
    if raw.len() > 0 && (Int{raw[0]} == 0x2d || Int{raw[0]} == 0x2b) {
        negative = Int{raw[0]} == 0x2d
        k = 1
    }
    base := 10
    if raw.len() >= k + 2 && (Int{raw[k]}) == 0x30 && (Int{raw[k + 1]}) == 0x78 {
        base = 16
        k += 2
    }
    value := 0
    digits := 0
    loop k < raw.len() {
        c: Int{raw[k]}
        k += 1
        if c == 0x5f -> next
        d: wat_hex_digit(c)
        if d < 0 || d >= base -> return None
        value = value * base + d
        digits += 1
    }
    if digits == 0 -> return None
    Val(if negative -> 0 - value else -> value)
}

// Lexes and parses `text` into a tree whose root (node 0) holds the top-level forms.
wat_parse: fn(text: String) -> WatTree WasmError! {
    src: text.bytes()
    tree := WatTree{kinds: [Int]{}, texts: [String]{}, datas: [[U8]]{}, ats: [Int]{}, firsts: [Int]{}, nexts: [Int]{}, lasts: [Int]{}}
    _: tree.add(WAT_LIST, "", [U8]{}, 0, -1)
    stack := [Int]{0}
    n: src.len()
    k := 0
    loop k < n {
        c: Int{src[k]}
        if wat_is_space(c) {
            k += 1
            next
        }
        if c == 0x3b && k + 1 < n && (Int{src[k + 1]}) == 0x3b {
            loop k < n && (Int{src[k]}) != 0x0a -> k += 1
            next
        }
        if c == 0x28 && k + 1 < n && (Int{src[k + 1]}) == 0x3b {
            start: k
            depth := 0
            loop k < n {
                if k + 1 < n && (Int{src[k]}) == 0x28 && (Int{src[k + 1]}) == 0x3b {
                    depth += 1
                    k += 2
                } else if k + 1 < n && (Int{src[k]}) == 0x3b && (Int{src[k + 1]}) == 0x29 {
                    depth -= 1
                    k += 2
                    if depth == 0 -> break
                } else {
                    k += 1
                }
            }
            if depth != 0 -> return Err(WasmError.new("unterminated block comment", start))
            next
        }
        parent: stack[stack.len() - 1]
        if c == 0x28 {
            id: tree.add(WAT_LIST, "", [U8]{}, k, parent)
            stack.push(id)
            k += 1
            next
        }
        if c == 0x29 {
            if stack.len() == 1 -> return Err(WasmError.new("unexpected `)`", k))
            _: stack.pop()
            k += 1
            next
        }
        if c == 0x22 {
            start: k
            k += 1
            data := [U8]{}
            closed := false
            loop k < n {
                b: Int{src[k]}
                if b == 0x22 {
                    closed = true
                    k += 1
                    break
                }
                if b == 0x0a -> return Err(WasmError.new("newline in string", k))
                if b != 0x5c {
                    data.push(src[k])
                    k += 1
                    next
                }
                if k + 1 >= n -> return Err(WasmError.new("unterminated string", start))
                e: Int{src[k + 1]}
                k += 2
                if e == 0x6e {
                    data.push(U8{0x0a})
                } else if e == 0x74 {
                    data.push(U8{0x09})
                } else if e == 0x72 {
                    data.push(U8{0x0d})
                } else if e == 0x22 || e == 0x27 || e == 0x5c {
                    data.push(U8{e})
                } else if e == 0x75 {
                    if k >= n || (Int{src[k]}) != 0x7b -> return Err(WasmError.new("malformed unicode escape", k))
                    k += 1
                    code := 0
                    loop k < n && (Int{src[k]}) != 0x7d {
                        d: wat_hex_digit(Int{src[k]})
                        if d < 0 -> return Err(WasmError.new("malformed unicode escape", k))
                        code = code * 16 + d
                        k += 1
                    }
                    k += 1
                    wat_put_utf8(data, code)
                } else {
                    high: wat_hex_digit(e)
                    low: if k < n -> wat_hex_digit(Int{src[k]}) else -> -1
                    if high < 0 || low < 0 -> return Err(WasmError.new("unknown string escape", k - 2))
                    data.push(U8{high * 16 + low})
                    k += 1
                }
            }
            if !closed -> return Err(WasmError.new("unterminated string", start))
            _: tree.add(WAT_STRING, "", data, start, parent)
            next
        }
        start: k
        loop k < n && !wat_is_delimiter(Int{src[k]}) -> k += 1
        if k == start -> return Err(WasmError.new("unexpected character", k))
        word: String.from_bytes(src[start..<k]) ?? return Err(WasmError.new("malformed UTF-8 encoding", start))
        _: tree.add(WAT_ATOM, word, [U8]{}, start, parent)
    }
    if stack.len() > 1 -> return Err(WasmError.new("unclosed `(`", tree.ats[stack[stack.len() - 1]]))
    Ok(tree)
}

wat_put_utf8: fn(out: &[U8], code: Int) Never! {
    if code < 0x80 {
        out.push(U8{code})
    } else if code < 0x800 {
        out.push(U8{0xc0 + (code >> 6)})
        out.push(U8{0x80 + code.bit_and(0x3f)})
    } else if code < 0x10000 {
        out.push(U8{0xe0 + (code >> 12)})
        out.push(U8{0x80 + (code >> 6).bit_and(0x3f)})
        out.push(U8{0x80 + code.bit_and(0x3f)})
    } else {
        out.push(U8{0xf0 + (code >> 18)})
        out.push(U8{0x80 + (code >> 12).bit_and(0x3f)})
        out.push(U8{0x80 + (code >> 6).bit_and(0x3f)})
        out.push(U8{0x80 + code.bit_and(0x3f)})
    }
}

wat_put_bytes: fn(out: &[U8], bytes: [U8]) Never! {
    loop b in bytes -> out.push(b)
}

wat_put_name: fn(out: &[U8], name: String) Never! {
    raw: name.bytes()
    wasm_put_unsigned(out, raw.len())
    wat_put_bytes(out, raw)
}

wat_put_section: fn(out: &[U8], id: Int, payload: [U8]) Never! {
    out.push(U8{id})
    wasm_put_unsigned(out, payload.len())
    wat_put_bytes(out, payload)
}

// A section holding a vector of `count` items whose encodings are `items`.
wat_put_vec_section: fn(out: &[U8], id: Int, count: Int, items: [U8]) Never! {
    payload := [U8]{}
    wasm_put_unsigned(payload, count)
    wat_put_bytes(payload, items)
    wat_put_section(out, id, payload)
}

// The binary encoding of a text component or core module.
wasm_text_to_binary: fn(text: String) -> [U8] WasmError! {
    tree: wat_parse(text)
    roots: tree.kids(0)
    if roots.len() != 1 || !tree.is_list(roots[0]) -> return Err(WasmError.new("expected one `(component ...)` or `(module ...)` form", 0))
    root: roots[0]
    head: tree.head(root)
    if head == "module" -> return wat_encode_module(tree, root, 1)
    if head != "component" -> return Err(tree.fail(root, "expected `(component ...)` or `(module ...)`, found `({head} ...)`"))
    wat_encode_component(tree, root)
}

// A text or binary artifact, decoded as a component.
wasm_load_component: fn(bytes: &&[U8]) -> WasmComponent WasmError! {
    if bytes.len() >= 4 && (Int{bytes[0]}) == 0 && (Int{bytes[1]}) == 0x61 -> return wasm_decode_component(bytes)
    text: String.from_bytes(bytes) ?? return wasm_decode_component(bytes)
    if !wat_looks_textual(text) -> return wasm_decode_component(bytes)
    binary := wasm_text_to_binary(text)
    wasm_decode_component(binary)
}

// Text starts (after blanks and comments) with `(`.
wat_looks_textual: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    k := 0
    loop k < raw.len() {
        c: Int{raw[k]}
        if wat_is_space(c) {
            k += 1
        } else if c == 0x3b && k + 1 < raw.len() && (Int{raw[k + 1]}) == 0x3b {
            loop k < raw.len() && (Int{raw[k]}) != 0x0a -> k += 1
        } else {
            return c == 0x28
        }
    }
    false
}

// ---------------------------------------------------------------------------
// Core modules.

WatSig: struct {
    type_index: Int
    params: [Int]
    names: [String]
    results: [Int]
    next: Int
}

WatModule: struct {
    tree: WatTree
    ops: WasmOpTable
    types: [WasmFuncType]
    counts: [String:Int]
    names: [String:Int]
    field_index: [Int:Int]
    func_types: [Int]
    func_nodes: [Int]
    imports: [U8]
    import_count: Int
    tables: [U8]
    table_count: Int
    memories: [U8]
    memory_count: Int
    globals: [U8]
    global_count: Int
    exports: [U8]
    export_count: Int
    start: Int
    elems: [U8]
    elem_count: Int
    datas: [U8]
    data_count: Int
    needs_datacount: Bool
    labels: [String]
    locals: [String:Int]

    fail: fn(self, id: Int, message: String) -> WasmError Never! {
        self.tree.fail(id, message)
    }

    define: fn(&self, space: String, name: String) -> Int Never! {
        index: self.counts.get(space) ?? 0
        self.counts[space] = index + 1
        if name != "" -> self.names["{space} {name}"] = index
        index
    }

    count: fn(self, space: String) -> Int Never! {
        self.counts.get(space) ?? 0
    }

    // A `$name` or numeric reference into `space`.
    index: fn(self, space: String, id: Int) -> Int WasmError! {
        if !self.tree.is_atom(id) -> return Err(self.fail(id, "expected a {space} reference"))
        text: self.tree.atom(id)
        if text.starts_with("$") {
            index: self.names.get("{space} {text}") ?? return Err(self.fail(id, "unknown {space} `{text}`"))
            return Ok(index)
        }
        value: wat_int(text) ?? return Err(self.fail(id, "expected a {space} reference, found `{text}`"))
        if value < 0 -> return Err(self.fail(id, "expected a {space} reference, found `{text}`"))
        Ok(value)
    }

    // The index of a function type, appending it when no equal type exists.
    type_of: fn(&self, params: [Int], results: [Int]) -> Int Never! {
        loop k in 0..<self.types.len() {
            if self.types[k].params == params && self.types[k].results == results -> return k
        }
        self.types.push(WasmFuncType{params: params, results: results})
        self.types.len() - 1
    }
}

wat_valtype: fn(tree: WatTree, id: Int) -> Int WasmError! {
    text: tree.atom(id)
    if text == {
        "i32" -> Ok(WASM_I32)
        "i64" -> Ok(WASM_I64)
        "f32" -> Ok(WASM_F32)
        "f64" -> Ok(WASM_F64)
        "funcref" -> Ok(WASM_FUNCREF)
        "externref" -> Ok(WASM_EXTERNREF)
        "v128" -> Err(tree.fail(id, "SIMD (v128) is not supported by the plugin engine"))
        else -> Err(tree.fail(id, "unknown value type `{text}`"))
    }
}

// A type use: `(type x)?` then `(param ...)*` and `(result ...)*` starting at `from`.
wat_signature: fn(m: &WatModule, items: [Int], from: Int) -> WatSig WasmError! {
    tree: m.tree
    sig := WatSig{type_index: -1, params: [Int]{}, names: [String]{}, results: [Int]{}, next: from}
    k := from
    if k < items.len() && tree.head(items[k]) == "type" {
        parts: tree.kids(items[k])
        if parts.len() != 2 -> return Err(tree.fail(items[k], "expected `(type <index>)`"))
        sig.type_index = m.index("type", parts[1])
        k += 1
    }
    loop k < items.len() && tree.head(items[k]) == "param" {
        parts: tree.kids(items[k])
        if parts.len() >= 2 && tree.is_id(parts[1]) {
            if parts.len() != 3 -> return Err(tree.fail(items[k], "a named parameter declares exactly one type"))
            sig.names.push(tree.atom(parts[1]))
            sig.params.push(wat_valtype(tree, parts[2]))
        } else {
            loop j in 1..<parts.len() {
                sig.names.push("")
                sig.params.push(wat_valtype(tree, parts[j]))
            }
        }
        k += 1
    }
    loop k < items.len() && tree.head(items[k]) == "result" {
        parts: tree.kids(items[k])
        loop j in 1..<parts.len() -> sig.results.push(wat_valtype(tree, parts[j]))
        k += 1
    }
    sig.next = k
    if sig.type_index >= 0 {
        if sig.type_index >= m.types.len() -> return Err(tree.fail(items[from], "unknown type {sig.type_index}"))
        declared: m.types[sig.type_index]
        if sig.params.len() == 0 && sig.results.len() == 0 {
            sig.params = declared.params
            sig.results = declared.results
            loop _ in declared.params -> sig.names.push("")
        } else if declared.params != sig.params || declared.results != sig.results {
            return Err(tree.fail(items[from], "inline function type does not match the referenced type"))
        }
    } else {
        sig.type_index = m.type_of(sig.params, sig.results)
    }
    Ok(sig)
}

wat_limits: fn(m: &WatModule, out: &[U8], items: [Int], from: Int) -> Int WasmError! {
    tree: m.tree
    k := from
    if k >= items.len() || !tree.is_atom(items[k]) -> return Err(tree.fail(items[from - 1], "expected limits"))
    min: wat_int(tree.atom(items[k])) ?? return Err(tree.fail(items[k], "expected a limit"))
    k += 1
    if k < items.len() && tree.is_atom(items[k]) && wat_int(tree.atom(items[k])) != None {
        max: wat_int(tree.atom(items[k])) ?? 0
        out.push(U8{1})
        wasm_put_unsigned(out, min)
        wasm_put_unsigned(out, max)
        return Ok(k + 1)
    }
    out.push(U8{0})
    wasm_put_unsigned(out, min)
    Ok(k)
}

wat_reftype_byte: fn(tree: WatTree, id: Int) -> Int WasmError! {
    text: tree.atom(id)
    if text == "funcref" || text == "func" -> return Ok(WASM_FUNCREF)
    if text == "externref" || text == "extern" -> return Ok(WASM_EXTERNREF)
    Err(tree.fail(id, "expected a reference type, found `{text}`"))
}

// Skips the `$id` and inline `(export ...)` forms of a field; returns the index after them.
wat_skip_name_and_exports: fn(tree: WatTree, items: [Int]) -> Int Never! {
    k := 1
    if k < items.len() && tree.is_id(items[k]) -> k += 1
    loop k < items.len() && tree.head(items[k]) == "export" -> k += 1
    k
}

wat_field_name: fn(tree: WatTree, items: [Int]) -> String Never! {
    if items.len() > 1 && tree.is_id(items[1]) -> return tree.atom(items[1])
    ""
}

// An inline `(import "m" "n")` after the name and exports, or None.
wat_inline_import: fn(tree: WatTree, items: [Int], k: Int) -> Int? Never! {
    if k < items.len() && tree.head(items[k]) == "import" -> return Val(items[k])
    None
}

wat_encode_module: fn(tree: WatTree, root: Int, first: Int) -> [U8] WasmError! {
    m := WatModule{
        tree: tree, ops: WasmOpTable.new(), types: [WasmFuncType]{}, counts: [String:Int]{}, names: [String:Int]{},
        field_index: [Int:Int]{}, func_types: [Int]{}, func_nodes: [Int]{}, imports: [U8]{}, import_count: 0, tables: [U8]{},
        table_count: 0, memories: [U8]{}, memory_count: 0, globals: [U8]{}, global_count: 0, exports: [U8]{}, export_count: 0,
        start: -1, elems: [U8]{}, elem_count: 0, datas: [U8]{}, data_count: 0, needs_datacount: false, labels: [String]{},
        locals: [String:Int]{},
    }
    all: tree.kids(root)
    fields := [Int]{}
    k := first
    if k < all.len() && tree.is_id(all[k]) -> k += 1
    loop k < all.len() {
        if !tree.is_list(all[k]) -> return Err(tree.fail(all[k], "expected a module field"))
        fields.push(all[k])
        k += 1
    }
    // Pass 1: explicit types, in order, before any implicit one.
    loop field in fields {
        if tree.head(field) != "type" -> next
        items: tree.kids(field)
        j := 1
        name := ""
        if j < items.len() && tree.is_id(items[j]) {
            name = tree.atom(items[j])
            j += 1
        }
        if j >= items.len() || tree.head(items[j]) != "func" -> return Err(tree.fail(field, "expected `(type (func ...))`"))
        sig: wat_func_type_body(m, items[j])
        index: m.define("type", name)
        m.types.push(sig)
        if index != m.types.len() - 1 -> return Err(tree.fail(field, "type index mismatch"))
    }
    // Pass 2: define every index space entry in field order.
    loop field in fields {
        head: tree.head(field)
        items: tree.kids(field)
        name: wat_field_name(tree, items)
        after: wat_skip_name_and_exports(tree, items)
        if head == "import" {
            if items.len() != 4 -> return Err(tree.fail(field, "expected `(import \"module\" \"name\" <desc>)`"))
            desc: items[3]
            kind: tree.head(desc)
            parts: tree.kids(desc)
            inner_name: wat_field_name(tree, parts)
            if kind == "func" {
                start: if parts.len() > 1 && tree.is_id(parts[1]) -> 2 else -> 1
                sig: wat_signature(m, parts, start)
                m.field_index[field] = m.define("func", inner_name)
                m.func_types.push(sig.type_index)
            } else if kind == "table" || kind == "memory" || kind == "global" {
                m.field_index[field] = m.define(kind, inner_name)
            } else {
                return Err(tree.fail(desc, "unknown import kind `{kind}`"))
            }
        } else if head == "func" {
            sig_start: if wat_inline_import(tree, items, after) != None -> after + 1 else -> after
            sig: wat_signature(m, items, sig_start)
            m.field_index[field] = m.define("func", name)
            m.func_types.push(sig.type_index)
            if wat_inline_import(tree, items, after) == None -> m.func_nodes.push(field)
        } else if head == "table" || head == "memory" || head == "global" || head == "elem" || head == "data" {
            m.field_index[field] = m.define(head, name)
        } else if head != "type" && head != "export" && head != "start" {
            return Err(tree.fail(field, "unsupported module field `{head}`"))
        }
    }
    // Pass 3: encode.
    defined_funcs := [U8]{}
    defined_count := 0
    loop field in fields {
        head: tree.head(field)
        items: tree.kids(field)
        after: wat_skip_name_and_exports(tree, items)
        if head == "import" {
            wat_encode_import(m, items)
        } else if head == "func" || head == "table" || head == "memory" || head == "global" {
            index: m.field_index.get(field) ?? 0
            loop j in 1..<after {
                if tree.head(items[j]) == "export" -> wat_inline_export(m, items[j], head, index)
            }
            if wat_inline_import(tree, items, after) == .Val(import_node) {
                wat_encode_inline_import(m, import_node, head, items, after + 1)
            } else if head == "func" {
                func_index: m.field_index.get(field) ?? 0
                wasm_put_unsigned(defined_funcs, m.func_types[func_index])
                defined_count += 1
            } else if head == "table" {
                table := [U8]{}
                wat_encode_table(m, table, items, after)
                wat_put_bytes(m.tables, table)
                m.table_count += 1
            } else if head == "memory" {
                memory := [U8]{}
                _: wat_limits(m, memory, items, after)
                wat_put_bytes(m.memories, memory)
                m.memory_count += 1
            } else {
                wat_encode_global(m, items, after)
                m.global_count += 1
            }
        } else if head == "export" {
            if items.len() != 3 || tree.kinds[items[1]] != WAT_STRING -> return Err(tree.fail(field, "expected `(export \"name\" (<kind> <index>))`"))
            kind: tree.head(items[2])
            parts: tree.kids(items[2])
            if parts.len() != 2 -> return Err(tree.fail(items[2], "expected `(<kind> <index>)`"))
            index: m.index(kind, parts[1])
            wat_inline_export(m, field, kind, index)
        } else if head == "start" {
            if items.len() != 2 -> return Err(tree.fail(field, "expected `(start <func>)`"))
            m.start = m.index("func", items[1])
        } else if head == "elem" {
            wat_encode_elem(m, items)
        } else if head == "data" {
            wat_encode_data(m, items)
        }
    }
    codes := [U8]{}
    loop node in m.func_nodes {
        body: wat_encode_body(m, node)
        wasm_put_unsigned(codes, body.len())
        wat_put_bytes(codes, body)
    }
    out := [U8]{0, 0x61, 0x73, 0x6d, 1, 0, 0, 0}
    if m.types.len() > 0 {
        items := [U8]{}
        loop ty in m.types {
            items.push(U8{0x60})
            wasm_put_unsigned(items, ty.params.len())
            loop p in ty.params -> items.push(U8{p})
            wasm_put_unsigned(items, ty.results.len())
            loop r in ty.results -> items.push(U8{r})
        }
        wat_put_vec_section(out, 1, m.types.len(), items)
    }
    if m.import_count > 0 -> wat_put_vec_section(out, 2, m.import_count, m.imports)
    if defined_count > 0 -> wat_put_vec_section(out, 3, defined_count, defined_funcs)
    if m.table_count > 0 -> wat_put_vec_section(out, 4, m.table_count, m.tables)
    if m.memory_count > 0 -> wat_put_vec_section(out, 5, m.memory_count, m.memories)
    if m.global_count > 0 -> wat_put_vec_section(out, 6, m.global_count, m.globals)
    if m.export_count > 0 -> wat_put_vec_section(out, 7, m.export_count, m.exports)
    if m.start >= 0 {
        payload := [U8]{}
        wasm_put_unsigned(payload, m.start)
        wat_put_section(out, 8, payload)
    }
    if m.elem_count > 0 -> wat_put_vec_section(out, 9, m.elem_count, m.elems)
    if m.needs_datacount {
        payload := [U8]{}
        wasm_put_unsigned(payload, m.data_count)
        wat_put_section(out, 12, payload)
    }
    if defined_count > 0 -> wat_put_vec_section(out, 10, defined_count, codes)
    if m.data_count > 0 -> wat_put_vec_section(out, 11, m.data_count, m.datas)
    Ok(out)
}

wat_func_type_body: fn(m: &WatModule, node: Int) -> WasmFuncType WasmError! {
    tree: m.tree
    items: tree.kids(node)
    params := [Int]{}
    results := [Int]{}
    loop k in 1..<items.len() {
        head: tree.head(items[k])
        parts: tree.kids(items[k])
        start: if parts.len() > 1 && tree.is_id(parts[1]) -> 2 else -> 1
        if head == "param" {
            loop j in start..<parts.len() -> params.push(wat_valtype(tree, parts[j]))
        } else if head == "result" {
            loop j in 1..<parts.len() -> results.push(wat_valtype(tree, parts[j]))
        } else {
            return Err(tree.fail(items[k], "expected `(param ...)` or `(result ...)`"))
        }
    }
    Ok(WasmFuncType{params: params, results: results})
}

wat_kind_byte: fn(kind: String) -> Int Never! {
    if kind == {
        "func" -> WASM_EXTERN_FUNC
        "table" -> WASM_EXTERN_TABLE
        "memory" -> WASM_EXTERN_MEMORY
        else -> WASM_EXTERN_GLOBAL
    }
}

wat_inline_export: fn(m: &WatModule, node: Int, kind: String, index: Int) WasmError! {
    parts: m.tree.kids(node)
    if parts.len() < 2 -> return Err(m.fail(node, "expected `(export \"name\")`"))
    name: m.tree.string(parts[1])
    wat_put_name(m.exports, name)
    m.exports.push(U8{wat_kind_byte(kind)})
    wasm_put_unsigned(m.exports, index)
    m.export_count += 1
}

wat_encode_import: fn(m: &WatModule, items: [Int]) WasmError! {
    tree: m.tree
    module_name: tree.string(items[1])
    name: tree.string(items[2])
    desc: items[3]
    parts: tree.kids(desc)
    start: if parts.len() > 1 && tree.is_id(parts[1]) -> 2 else -> 1
    wat_put_import_desc(m, module_name, name, tree.head(desc), parts, start)
}

wat_encode_inline_import: fn(m: &WatModule, node: Int, kind: String, items: [Int], from: Int) WasmError! {
    tree: m.tree
    parts: tree.kids(node)
    if parts.len() != 3 -> return Err(m.fail(node, "expected `(import \"module\" \"name\")`"))
    wat_put_import_desc(m, tree.string(parts[1]), tree.string(parts[2]), kind, items, from)
}

wat_put_import_desc: fn(m: &WatModule, module_name: String, name: String, kind: String, parts: [Int], start: Int) WasmError! {
    out := [U8]{}
    wat_put_name(out, module_name)
    wat_put_name(out, name)
    out.push(U8{wat_kind_byte(kind)})
    if kind == "func" {
        sig: wat_signature(m, parts, start)
        wasm_put_unsigned(out, sig.type_index)
    } else if kind == "table" {
        wat_encode_table(m, out, parts, start)
    } else if kind == "memory" {
        wat_limits(m, out, parts, start)
    } else {
        wat_global_type(m, out, parts[start])
    }
    wat_put_bytes(m.imports, out)
    m.import_count += 1
}

wat_encode_table: fn(m: &WatModule, out: &[U8], items: [Int], from: Int) WasmError! {
    limits := [U8]{}
    next: wat_limits(m, limits, items, from)
    if next >= items.len() -> return Err(m.fail(items[0], "expected a table element type"))
    out.push(U8{wat_reftype_byte(m.tree, items[next])})
    wat_put_bytes(out, limits)
}

wat_global_type: fn(m: &WatModule, out: &[U8], node: Int) WasmError! {
    tree: m.tree
    if tree.head(node) == "mut" {
        parts: tree.kids(node)
        if parts.len() != 2 -> return Err(m.fail(node, "expected `(mut <type>)`"))
        out.push(U8{wat_valtype(tree, parts[1])})
        out.push(U8{1})
    } else {
        out.push(U8{wat_valtype(tree, node)})
        out.push(U8{0})
    }
}

wat_encode_global: fn(m: &WatModule, items: [Int], from: Int) WasmError! {
    if from >= items.len() -> return Err(m.fail(items[0], "expected a global type"))
    global := [U8]{}
    wat_global_type(m, global, items[from])
    wat_put_bytes(m.globals, global)
    expr := [U8]{}
    wat_const_expr(m, expr, items, from + 1)
    wat_put_bytes(m.globals, expr)
}

// A constant expression from `items[from..]`, terminated with `end`.
wat_const_expr: fn(m: &WatModule, out: &[U8], items: [Int], from: Int) WasmError! {
    m.labels = [String]{}
    m.locals = [String:Int]{}
    wat_instructions(m, out, items, from)
    out.push(U8{0x0b})
}

wat_encode_elem: fn(m: &WatModule, items: [Int]) WasmError! {
    tree: m.tree
    k := 1
    if k < items.len() && tree.is_id(items[k]) -> k += 1
    out := [U8]{}
    if k < items.len() && tree.is_atom(items[k]) && tree.atom(items[k]) == "declare" {
        k += 1
        if k < items.len() && tree.atom(items[k]) == "func" -> k += 1
        out.push(U8{3})
        out.push(U8{0})
    } else if k < items.len() && tree.is_list(items[k]) {
        table := 0
        if tree.head(items[k]) == "table" {
            parts: tree.kids(items[k])
            table = m.index("table", parts[1])
            k += 1
        }
        offset := [U8]{}
        if tree.head(items[k]) == "offset" {
            wat_const_expr(m, offset, tree.kids(items[k]), 1)
        } else {
            wat_const_expr(m, offset, [Int]{items[k]}, 0)
        }
        k += 1
        if k < items.len() && tree.atom(items[k]) == "func" -> k += 1
        if table == 0 {
            out.push(U8{0})
            wat_put_bytes(out, offset)
        } else {
            out.push(U8{2})
            wasm_put_unsigned(out, table)
            wat_put_bytes(out, offset)
            out.push(U8{0})
        }
    } else {
        if k < items.len() && tree.atom(items[k]) == "func" -> k += 1
        out.push(U8{1})
        out.push(U8{0})
    }
    funcs := [U8]{}
    count := 0
    loop k < items.len() {
        wasm_put_unsigned(funcs, m.index("func", items[k]))
        count += 1
        k += 1
    }
    wasm_put_unsigned(out, count)
    wat_put_bytes(out, funcs)
    wat_put_bytes(m.elems, out)
    m.elem_count += 1
}

wat_encode_data: fn(m: &WatModule, items: [Int]) WasmError! {
    tree: m.tree
    k := 1
    if k < items.len() && tree.is_id(items[k]) -> k += 1
    out := [U8]{}
    if k < items.len() && tree.is_list(items[k]) {
        if tree.head(items[k]) == "memory" {
            parts: tree.kids(items[k])
            if m.index("memory", parts[1]) != 0 -> return Err(m.fail(items[k], "multiple memories are not supported by the plugin engine"))
            k += 1
        }
        out.push(U8{0})
        if tree.head(items[k]) == "offset" {
            wat_const_expr(m, out, tree.kids(items[k]), 1)
        } else {
            wat_const_expr(m, out, [Int]{items[k]}, 0)
        }
        k += 1
    } else {
        out.push(U8{1})
    }
    bytes := [U8]{}
    loop k < items.len() {
        if tree.kinds[items[k]] != WAT_STRING -> return Err(m.fail(items[k], "expected a data string"))
        wat_put_bytes(bytes, tree.datas[items[k]])
        k += 1
    }
    wasm_put_unsigned(out, bytes.len())
    wat_put_bytes(out, bytes)
    wat_put_bytes(m.datas, out)
    m.data_count += 1
}

// One function's code entry: local declarations, instructions and `end`.
wat_encode_body: fn(m: &WatModule, node: Int) -> [U8] WasmError! {
    tree: m.tree
    items: tree.kids(node)
    k := wat_skip_name_and_exports(tree, items)
    sig: wat_signature(m, items, k)
    k = sig.next
    m.labels = [String]{}
    m.locals = [String:Int]{}
    count := 0
    loop name in sig.names {
        if name != "" -> m.locals[name] = count
        count += 1
    }
    locals := [Int]{}
    loop k < items.len() && tree.head(items[k]) == "local" {
        parts: tree.kids(items[k])
        if parts.len() >= 2 && tree.is_id(parts[1]) {
            if parts.len() != 3 -> return Err(m.fail(items[k], "a named local declares exactly one type"))
            m.locals[tree.atom(parts[1])] = count
            locals.push(wat_valtype(tree, parts[2]))
            count += 1
        } else {
            loop j in 1..<parts.len() {
                locals.push(wat_valtype(tree, parts[j]))
                count += 1
            }
        }
        k += 1
    }
    out := [U8]{}
    groups := [U8]{}
    group_count := 0
    j := 0
    loop j < locals.len() {
        run := 1
        loop j + run < locals.len() && locals[j + run] == locals[j] -> run += 1
        wasm_put_unsigned(groups, run)
        groups.push(U8{locals[j]})
        group_count += 1
        j += run
    }
    wasm_put_unsigned(out, group_count)
    wat_put_bytes(out, groups)
    wat_instructions(m, out, items, k)
    out.push(U8{0x0b})
    Ok(out)
}

wat_instructions: fn(m: &WatModule, out: &[U8], items: [Int], from: Int) WasmError! {
    tree: m.tree
    k := from
    loop k < items.len() {
        node: items[k]
        k += 1
        if tree.is_list(node) {
            wat_folded(m, out, node)
        } else if tree.is_atom(node) {
            k = wat_plain(m, out, node, items, k)
        } else {
            return Err(m.fail(node, "expected an instruction, found a string"))
        }
    }
}

// The end of the block-type lists starting at `from`.
wat_block_type_end: fn(tree: WatTree, items: [Int], from: Int) -> Int Never! {
    k := from
    loop k < items.len() && (tree.head(items[k]) == "type" || tree.head(items[k]) == "param" || tree.head(items[k]) == "result") -> k += 1
    k
}

wat_block_type: fn(m: &WatModule, out: &[U8], items: [Int], from: Int, to: Int) WasmError! {
    if from == to {
        out.push(U8{0x40})
        return
    }
    window: items[from..<to]
    sig: wat_signature(m, window, 0)
    if sig.next != window.len() -> return Err(m.fail(items[from], "malformed block type"))
    if sig.params.len() == 0 && sig.results.len() == 1 && m.tree.head(items[from]) != "type" {
        out.push(U8{sig.results[0]})
        return
    }
    if sig.params.len() == 0 && sig.results.len() == 0 && m.tree.head(items[from]) != "type" {
        out.push(U8{0x40})
        return
    }
    wasm_put_signed(out, sig.type_index)
}

// A plain instruction named by `items[k - 1]`; returns the index after its immediates.
wat_plain: fn(m: &WatModule, out: &[U8], node: Int, items: [Int], k: Int) -> Int WasmError! {
    tree: m.tree
    name: tree.atom(node)
    if name == "block" || name == "loop" || name == "if" {
        j := k
        label := ""
        if j < items.len() && tree.is_id(items[j]) {
            label = tree.atom(items[j])
            j += 1
        }
        end: wat_block_type_end(tree, items, j)
        out.push(U8{if name == "block" -> 0x02 else if name == "loop" -> 0x03 else -> 0x04})
        wat_block_type(m, out, items, j, end)
        m.labels.push(label)
        return Ok(end)
    }
    if name == "else" || name == "end" {
        if name == "else" {
            out.push(U8{0x05})
        } else {
            out.push(U8{0x0b})
            if m.labels.len() == 0 -> return Err(m.fail(node, "`end` without an open block"))
            _: m.labels.pop()
        }
        if k < items.len() && tree.is_id(items[k]) -> return Ok(k + 1)
        return Ok(k)
    }
    wat_op(m, out, node, items, k)
}

// A folded instruction: operands first, then the operator.
wat_folded: fn(m: &WatModule, out: &[U8], node: Int) WasmError! {
    tree: m.tree
    items: tree.kids(node)
    if items.len() == 0 || !tree.is_atom(items[0]) -> return Err(m.fail(node, "expected a folded instruction"))
    name: tree.atom(items[0])
    if name == "block" || name == "loop" {
        k := 1
        label := ""
        if k < items.len() && tree.is_id(items[k]) {
            label = tree.atom(items[k])
            k += 1
        }
        end: wat_block_type_end(tree, items, k)
        out.push(U8{if name == "block" -> 0x02 else -> 0x03})
        wat_block_type(m, out, items, k, end)
        m.labels.push(label)
        wat_instructions(m, out, items, end)
        out.push(U8{0x0b})
        _: m.labels.pop()
        return
    }
    if name == "if" {
        k := 1
        label := ""
        if k < items.len() && tree.is_id(items[k]) {
            label = tree.atom(items[k])
            k += 1
        }
        end: wat_block_type_end(tree, items, k)
        j := end
        loop j < items.len() && tree.head(items[j]) != "then" {
            if !tree.is_list(items[j]) -> return Err(m.fail(items[j], "expected a folded condition"))
            wat_folded(m, out, items[j])
            j += 1
        }
        if j >= items.len() -> return Err(m.fail(node, "expected `(then ...)`"))
        out.push(U8{0x04})
        wat_block_type(m, out, items, k, end)
        m.labels.push(label)
        wat_instructions(m, out, tree.kids(items[j]), 1)
        j += 1
        if j < items.len() {
            if tree.head(items[j]) != "else" -> return Err(m.fail(items[j], "expected `(else ...)`"))
            out.push(U8{0x05})
            wat_instructions(m, out, tree.kids(items[j]), 1)
            j += 1
        }
        if j != items.len() -> return Err(m.fail(items[j], "unexpected form after `(else ...)`"))
        out.push(U8{0x0b})
        _: m.labels.pop()
        return
    }
    op := [U8]{}
    end: wat_op(m, op, items[0], items, 1)
    loop j in end..<items.len() {
        if !tree.is_list(items[j]) -> return Err(m.fail(items[j], "expected a folded operand"))
        wat_folded(m, out, items[j])
    }
    wat_put_bytes(out, op)
}

wat_label: fn(m: &WatModule, id: Int) -> Int WasmError! {
    tree: m.tree
    if tree.is_id(id) {
        name: tree.atom(id)
        k := m.labels.len()
        loop k > 0 {
            k -= 1
            if m.labels[k] == name -> return Ok(m.labels.len() - 1 - k)
        }
        return Err(m.fail(id, "unknown label `{name}`"))
    }
    value: wat_int(tree.atom(id)) ?? return Err(m.fail(id, "expected a label"))
    Ok(value)
}

wat_local: fn(m: &WatModule, id: Int) -> Int WasmError! {
    tree: m.tree
    text: tree.atom(id)
    if text.starts_with("$") {
        index: m.locals.get(text) ?? return Err(m.fail(id, "unknown local `{text}`"))
        return Ok(index)
    }
    value: wat_int(text) ?? return Err(m.fail(id, "expected a local"))
    Ok(value)
}

// An optional reference into `space` at `items[k]`; (index, next) packed as index * 2^20 + next is avoided:
// callers read `items[k]` themselves via wat_has_ref.
wat_has_ref: fn(tree: WatTree, items: [Int], k: Int) -> Bool Never! {
    k < items.len() && tree.is_ref(items[k])
}

wat_natural_align: fn(width: Int) -> Int Never! {
    if width == {
        1 -> 0
        2 -> 1
        4 -> 2
        else -> 3
    }
}

// The opcode and immediates of a non-structured instruction; returns the index after the immediates.
wat_op: fn(m: &WatModule, out: &[U8], node: Int, items: [Int], from: Int) -> Int WasmError! {
    tree: m.tree
    name: tree.atom(node)
    info: m.ops.named(name) ?? return Err(m.fail(node, "unknown instruction `{name}`"))
    k := from
    if name == "select" && k < items.len() && tree.head(items[k]) == "result" {
        types := [Int]{}
        loop k < items.len() && tree.head(items[k]) == "result" {
            parts: tree.kids(items[k])
            loop j in 1..<parts.len() -> types.push(wat_valtype(tree, parts[j]))
            k += 1
        }
        out.push(U8{0x1c})
        wasm_put_unsigned(out, types.len())
        loop ty in types -> out.push(U8{ty})
        return Ok(k)
    }
    op: info.op
    if op >= 0xfc00 {
        out.push(U8{0xfc})
        wasm_put_unsigned(out, op - 0xfc00)
    } else {
        out.push(U8{op})
    }
    imm: info.imm
    if imm == WASM_IMM_NONE {
        return Ok(k)
    }
    if imm == WASM_IMM_LABEL {
        if k >= items.len() -> return Err(m.fail(node, "`{name}` needs a label"))
        wasm_put_unsigned(out, wat_label(m, items[k]))
        return Ok(k + 1)
    }
    if imm == WASM_IMM_BR_TABLE {
        labels := [Int]{}
        loop wat_has_ref(tree, items, k) {
            labels.push(wat_label(m, items[k]))
            k += 1
        }
        if labels.len() == 0 -> return Err(m.fail(node, "`br_table` needs at least a default label"))
        wasm_put_unsigned(out, labels.len() - 1)
        loop j in 0..<labels.len() -> wasm_put_unsigned(out, labels[j])
        return Ok(k)
    }
    if imm == WASM_IMM_FUNC || imm == WASM_IMM_GLOBAL || imm == WASM_IMM_ELEM || imm == WASM_IMM_DATA {
        space: if imm == WASM_IMM_FUNC -> "func" else if imm == WASM_IMM_GLOBAL -> "global" else if imm == WASM_IMM_ELEM -> "elem" else -> "data"
        if imm == WASM_IMM_DATA -> m.needs_datacount = true
        if k >= items.len() -> return Err(m.fail(node, "`{name}` needs a {space} index"))
        wasm_put_unsigned(out, m.index(space, items[k]))
        return Ok(k + 1)
    }
    if imm == WASM_IMM_LOCAL {
        if k >= items.len() -> return Err(m.fail(node, "`{name}` needs a local"))
        wasm_put_unsigned(out, wat_local(m, items[k]))
        return Ok(k + 1)
    }
    if imm == WASM_IMM_CALL_INDIRECT {
        table := 0
        if wat_has_ref(tree, items, k) {
            table = m.index("table", items[k])
            k += 1
        }
        sig: wat_signature(m, items, k)
        wasm_put_unsigned(out, sig.type_index)
        wasm_put_unsigned(out, table)
        return Ok(sig.next)
    }
    if imm == WASM_IMM_MEMARG {
        align := wat_natural_align(info.width)
        offset := 0
        loop k < items.len() && tree.is_atom(items[k]) && (tree.atom(items[k]).starts_with("offset=") || tree.atom(items[k]).starts_with("align=")) {
            text: tree.atom(items[k])
            parts: loop part in text.split("=") -> part
            value: wat_int(parts[1]) ?? return Err(m.fail(items[k], "malformed `{text}`"))
            if parts[0] == "offset" {
                offset = value
            } else {
                exponent := 0
                loop exponent < 64 && (1 << exponent) < value -> exponent += 1
                if (1 << exponent) != value -> return Err(m.fail(items[k], "alignment must be a power of two"))
                align = exponent
            }
            k += 1
        }
        wasm_put_unsigned(out, align)
        wasm_put_unsigned(out, offset)
        return Ok(k)
    }
    if imm == WASM_IMM_MEMORY || imm == WASM_IMM_MEMORY_COPY {
        uses: if imm == WASM_IMM_MEMORY -> 1 else -> 2
        loop _ in 0..<uses {
            index := 0
            if wat_has_ref(tree, items, k) {
                index = m.index("memory", items[k])
                k += 1
            }
            wasm_put_unsigned(out, index)
        }
        return Ok(k)
    }
    if imm == WASM_IMM_MEMORY_INIT {
        m.needs_datacount = true
        refs := [Int]{}
        loop wat_has_ref(tree, items, k) {
            refs.push(items[k])
            k += 1
        }
        if refs.len() == 0 || refs.len() > 2 -> return Err(m.fail(node, "`memory.init` needs a data segment"))
        memory: if refs.len() == 2 -> m.index("memory", refs[0]) else -> 0
        wasm_put_unsigned(out, m.index("data", refs[refs.len() - 1]))
        wasm_put_unsigned(out, memory)
        return Ok(k)
    }
    if imm == WASM_IMM_TABLE {
        index := 0
        if wat_has_ref(tree, items, k) {
            index = m.index("table", items[k])
            k += 1
        }
        wasm_put_unsigned(out, index)
        return Ok(k)
    }
    if imm == WASM_IMM_TABLE_COPY {
        refs := [Int]{}
        loop wat_has_ref(tree, items, k) {
            refs.push(m.index("table", items[k]))
            k += 1
        }
        if refs.len() == 1 || refs.len() > 2 -> return Err(m.fail(node, "`table.copy` takes no tables or both"))
        wasm_put_unsigned(out, if refs.len() == 2 -> refs[0] else -> 0)
        wasm_put_unsigned(out, if refs.len() == 2 -> refs[1] else -> 0)
        return Ok(k)
    }
    if imm == WASM_IMM_TABLE_INIT {
        refs := [Int]{}
        loop wat_has_ref(tree, items, k) {
            refs.push(items[k])
            k += 1
        }
        if refs.len() == 0 || refs.len() > 2 -> return Err(m.fail(node, "`table.init` needs an element segment"))
        table: if refs.len() == 2 -> m.index("table", refs[0]) else -> 0
        wasm_put_unsigned(out, m.index("elem", refs[refs.len() - 1]))
        wasm_put_unsigned(out, table)
        return Ok(k)
    }
    if imm == WASM_IMM_REFTYPE {
        if k >= items.len() -> return Err(m.fail(node, "`ref.null` needs a reference type"))
        out.push(U8{wat_reftype_byte(tree, items[k])})
        return Ok(k + 1)
    }
    if k >= items.len() || !tree.is_atom(items[k]) -> return Err(m.fail(node, "`{name}` needs a constant"))
    text: tree.atom(items[k])
    if imm == WASM_IMM_I32 || imm == WASM_IMM_I64 {
        bits: if imm == WASM_IMM_I32 -> 32 else -> 64
        value: wat_int(text) ?? return Err(m.fail(items[k], "malformed integer constant `{text}`"))
        if value < 0 - (1 << (bits - 1)) || value >= (1 << bits) -> return Err(m.fail(items[k], "constant out of range"))
        wasm_put_signed(out, wasm_signed(wasm_unsigned(value, bits), bits))
        return Ok(k + 1)
    }
    if imm == WASM_IMM_F64 {
        value: Float.parse(text) ?? return Err(m.fail(items[k], "unsupported f64 constant `{text}`: the text front end reads decimal literals only"))
        wasm_put_fixed(out, math.to_bits(value), 8)
        return Ok(k + 1)
    }
    Err(m.fail(items[k], "f32 constants are not supported by the text front end"))
}

// ---------------------------------------------------------------------------
// Components.

// A component type index space: the component's own (hoisted definitions
// become type-section entries) or an instance type's (they become `type`
// declarations).
WatTypeSpace: struct {
    instance: Bool
    count: Int
    names: [String:Int]
    defs: [U8]
    pending: Int

    new: fn(instance: Bool) -> WatTypeSpace Never! {
        WatTypeSpace{instance: instance, count: 0, names: [String:Int]{}, defs: [U8]{}, pending: 0}
    }

    // Adds a type definition; returns its index.
    hoist: fn(&self, def: [U8], name: String) -> Int Never! {
        if self.instance -> self.defs.push(U8{0x01})
        wat_put_bytes(self.defs, def)
        self.pending += 1
        index: self.count
        self.count += 1
        if name != "" -> self.names[name] = index
        index
    }
}

WatComponent: struct {
    tree: WatTree
    out: [U8]
    counts: [String:Int]
    names: [String:Int]
    types: WatTypeSpace

    fail: fn(self, id: Int, message: String) -> WasmError Never! {
        self.tree.fail(id, message)
    }

    define: fn(&self, sort: String, name: String) -> Int Never! {
        index: self.counts.get(sort) ?? 0
        self.counts[sort] = index + 1
        if name != "" -> self.names["{sort} {name}"] = index
        index
    }

    index: fn(self, sort: String, id: Int) -> Int WasmError! {
        if !self.tree.is_atom(id) -> return Err(self.fail(id, "expected a {sort} reference"))
        text: self.tree.atom(id)
        if text.starts_with("$") {
            index: self.names.get("{sort} {text}") ?? return Err(self.fail(id, "unknown {sort} `{text}`"))
            return Ok(index)
        }
        value: wat_int(text) ?? return Err(self.fail(id, "expected a {sort} reference, found `{text}`"))
        Ok(value)
    }

    // Writes the hoisted component-level type definitions as one type section.
    flush_types: fn(&self) Never! {
        if self.types.pending == 0 -> return
        wat_put_vec_section(self.out, 7, self.types.pending, self.types.defs)
        self.types.defs = [U8]{}
        self.types.pending = 0
    }

    section: fn(&self, id: Int, item: [U8]) Never! {
        self.flush_types()
        wat_put_vec_section(self.out, id, 1, item)
    }
}

wat_type_ref: fn(tree: WatTree, space: &WatTypeSpace, id: Int) -> Int WasmError! {
    text: tree.atom(id)
    if text.starts_with("$") {
        index: space.names.get(text) ?? return Err(tree.fail(id, "unknown type `{text}`"))
        return Ok(index)
    }
    value: wat_int(text) ?? return Err(tree.fail(id, "expected a type reference, found `{text}`"))
    Ok(value)
}

wat_primitive: fn(text: String) -> Int Never! {
    if text == {
        "bool" -> 0x7f
        "s8" -> 0x7e
        "u8" -> 0x7d
        "s16" -> 0x7c
        "u16" -> 0x7b
        "s32" -> 0x7a
        "u32" -> 0x79
        "s64" -> 0x78
        "u64" -> 0x77
        "f32" | "float32" -> 0x76
        "f64" | "float64" -> 0x75
        "char" -> 0x74
        "string" -> 0x73
        else -> 0
    }
}

// A component value type: a primitive byte or a (possibly hoisted) type index.
wat_put_valtype: fn(tree: WatTree, space: &WatTypeSpace, out: &[U8], id: Int) WasmError! {
    if tree.is_atom(id) {
        prim: wat_primitive(tree.atom(id))
        if prim != 0 {
            out.push(U8{prim})
            return
        }
        wasm_put_signed(out, wat_type_ref(tree, space, id))
        return
    }
    def: wat_defvaltype(tree, space, id)
    wasm_put_signed(out, space.hoist(def, ""))
}

// An optional value type: the node `id`, or none when `id` is negative.
wat_put_optional_valtype: fn(tree: WatTree, space: &WatTypeSpace, out: &[U8], id: Int) WasmError! {
    if id < 0 {
        out.push(U8{0})
        return
    }
    out.push(U8{1})
    wat_put_valtype(tree, space, out, id)
}

wat_defvaltype: fn(tree: WatTree, space: &WatTypeSpace, id: Int) -> [U8] WasmError! {
    head: tree.head(id)
    items: tree.kids(id)
    out := [U8]{}
    if head == "list" || head == "option" {
        if items.len() != 2 -> return Err(tree.fail(id, "expected `({head} <type>)`"))
        out.push(U8{if head == "list" -> 0x70 else -> 0x6b})
        wat_put_valtype(tree, space, out, items[1])
    } else if head == "tuple" {
        out.push(U8{0x6f})
        wasm_put_unsigned(out, items.len() - 1)
        loop k in 1..<items.len() -> wat_put_valtype(tree, space, out, items[k])
    } else if head == "record" {
        out.push(U8{0x72})
        wasm_put_unsigned(out, items.len() - 1)
        loop k in 1..<items.len() {
            parts: tree.kids(items[k])
            if tree.head(items[k]) != "field" || parts.len() != 3 -> return Err(tree.fail(items[k], "expected `(field \"name\" <type>)`"))
            wat_put_name(out, tree.string(parts[1]))
            wat_put_valtype(tree, space, out, parts[2])
        }
    } else if head == "variant" {
        out.push(U8{0x71})
        wasm_put_unsigned(out, items.len() - 1)
        loop k in 1..<items.len() {
            parts: tree.kids(items[k])
            if tree.head(items[k]) != "case" || parts.len() < 2 || parts.len() > 3 -> return Err(tree.fail(items[k], "expected `(case \"name\" <type>?)`"))
            wat_put_name(out, tree.string(parts[1]))
            wat_put_optional_valtype(tree, space, out, if parts.len() == 3 -> parts[2] else -> -1)
            out.push(U8{0})
        }
    } else if head == "enum" || head == "flags" {
        out.push(U8{if head == "enum" -> 0x6d else -> 0x6e})
        wasm_put_unsigned(out, items.len() - 1)
        loop k in 1..<items.len() -> wat_put_name(out, tree.string(items[k]))
    } else if head == "result" {
        ok := -1
        err := -1
        loop k in 1..<items.len() {
            if tree.head(items[k]) == "error" {
                parts: tree.kids(items[k])
                if parts.len() != 2 -> return Err(tree.fail(items[k], "expected `(error <type>)`"))
                err = parts[1]
            } else {
                ok = items[k]
            }
        }
        out.push(U8{0x6a})
        wat_put_optional_valtype(tree, space, out, ok)
        wat_put_optional_valtype(tree, space, out, err)
    } else if head == "own" || head == "borrow" {
        if items.len() != 2 -> return Err(tree.fail(id, "expected `({head} <resource>)`"))
        out.push(U8{if head == "own" -> 0x69 else -> 0x68})
        wasm_put_unsigned(out, wat_type_ref(tree, space, items[1]))
    } else {
        return Err(tree.fail(id, "unsupported component type `({head} ...)`"))
    }
    Ok(out)
}

// A function type from `(param "name" <type>)*` and `(result <type>)?` at items[from..].
wat_functype: fn(tree: WatTree, space: &WatTypeSpace, items: [Int], from: Int) -> [U8] WasmError! {
    params := [U8]{}
    count := 0
    result := -1
    loop k in from..<items.len() {
        parts: tree.kids(items[k])
        head: tree.head(items[k])
        if head == "param" {
            if parts.len() != 3 -> return Err(tree.fail(items[k], "expected `(param \"name\" <type>)`"))
            wat_put_name(params, tree.string(parts[1]))
            wat_put_valtype(tree, space, params, parts[2])
            count += 1
        } else if head == "result" {
            if parts.len() != 2 -> return Err(tree.fail(items[k], "named or multiple function results are not supported"))
            result = parts[1]
        } else {
            return Err(tree.fail(items[k], "expected `(param ...)` or `(result ...)`"))
        }
    }
    out := [U8]{0x40}
    wasm_put_unsigned(out, count)
    wat_put_bytes(out, params)
    if result >= 0 {
        out.push(U8{0})
        wat_put_valtype(tree, space, out, result)
    } else {
        out.push(U8{1})
        out.push(U8{0})
    }
    Ok(out)
}

// An instance type's declarations, in their own type space.
wat_instancetype: fn(tree: WatTree, items: [Int], from: Int) -> [U8] WasmError! {
    inner := WatTypeSpace.new(true)
    loop k in from..<items.len() {
        head: tree.head(items[k])
        parts: tree.kids(items[k])
        if head == "export" {
            if parts.len() != 3 -> return Err(tree.fail(items[k], "expected `(export \"name\" <desc>)`"))
            desc: wat_externdesc(tree, inner, parts[2])
            wat_put_bytes(inner.defs, [U8]{0x04, 0x00})
            wat_put_name(inner.defs, tree.string(parts[1]))
            wat_put_bytes(inner.defs, desc)
            inner.pending += 1
        } else if head == "type" {
            j := 1
            name := ""
            if j < parts.len() && tree.is_id(parts[j]) {
                name = tree.atom(parts[j])
                j += 1
            }
            def: wat_deftype(tree, inner, parts[j])
            _: inner.hoist(def, name)
        } else {
            return Err(tree.fail(items[k], "unsupported instance type declaration `({head} ...)`"))
        }
    }
    out := [U8]{0x42}
    wasm_put_unsigned(out, inner.pending)
    wat_put_bytes(out, inner.defs)
    Ok(out)
}

wat_deftype: fn(tree: WatTree, space: &WatTypeSpace, id: Int) -> [U8] WasmError! {
    head: tree.head(id)
    items: tree.kids(id)
    if head == "func" -> return wat_functype(tree, space, items, 1)
    if head == "instance" -> return wat_instancetype(tree, items, 1)
    if head == "component" -> return Err(tree.fail(id, "component types are not supported by the text front end"))
    wat_defvaltype(tree, space, id)
}

// An extern description `(func $id? <typeuse>)` / `(instance $id? <typeuse or decls>)` / `(type $id? (sub resource))`.
wat_externdesc: fn(tree: WatTree, space: &WatTypeSpace, id: Int) -> [U8] WasmError! {
    head: tree.head(id)
    items: tree.kids(id)
    k := 1
    if k < items.len() && tree.is_id(items[k]) -> k += 1
    out := [U8]{}
    if head == "func" || head == "instance" {
        out.push(U8{if head == "func" -> 0x01 else -> 0x05})
        if k < items.len() && tree.head(items[k]) == "type" {
            parts: tree.kids(items[k])
            wasm_put_unsigned(out, wat_type_ref(tree, space, parts[1]))
        } else {
            def: if head == "func" -> wat_functype(tree, space, items, k) else -> wat_instancetype(tree, items, k)
            wasm_put_unsigned(out, space.hoist(def, ""))
        }
        return Ok(out)
    }
    if head == "type" {
        if k >= items.len() -> return Err(tree.fail(id, "expected a type bound"))
        bound: items[k]
        parts: tree.kids(bound)
        out.push(U8{0x03})
        if tree.head(bound) == "sub" && parts.len() == 2 && tree.atom(parts[1]) == "resource" {
            out.push(U8{0x01})
        } else if tree.head(bound) == "eq" && parts.len() == 2 {
            out.push(U8{0x00})
            wasm_put_unsigned(out, wat_type_ref(tree, space, parts[1]))
        } else {
            return Err(tree.fail(bound, "expected `(sub resource)` or `(eq <type>)`"))
        }
        return Ok(out)
    }
    Err(tree.fail(id, "unsupported extern kind `{head}`"))
}

wat_desc_sort: fn(head: String) -> String Never! {
    if head == "func" -> return "func"
    if head == "instance" -> return "instance"
    "type"
}

wat_core_sort_byte: fn(sort: String) -> Int Never! {
    if sort == {
        "func" -> 0x00
        "table" -> 0x01
        "memory" -> 0x02
        "global" -> 0x03
        "type" -> 0x10
        "module" -> 0x11
        else -> 0x12
    }
}

// An alias of core instance `instance`'s export `name` as a new `core <sort>`; returns its index.
wat_alias_core_export: fn(c: &WatComponent, sort: String, instance: Int, name: String, id: String) -> Int Never! {
    item := [U8]{0x00, U8{wat_core_sort_byte(sort)}, 0x01}
    wasm_put_unsigned(item, instance)
    wat_put_name(item, name)
    c.section(6, item)
    c.define("core {sort}", id)
}

// A core item reference: `(core? <sort> $x)` or the inline alias `(core? <sort> $instance "name")`.
wat_core_ref: fn(c: &WatComponent, sort: String, id: Int) -> Int WasmError! {
    tree: c.tree
    items: tree.kids(id)
    k := 1
    if tree.atom(items[0]) == "core" -> k = 2
    if k >= items.len() -> return Err(c.fail(id, "expected a core {sort} reference"))
    if k + 1 < items.len() && tree.kinds[items[k + 1]] == WAT_STRING {
        instance: c.index("core instance", items[k])
        return Ok(wat_alias_core_export(c, sort, instance, tree.string(items[k + 1]), ""))
    }
    c.index("core {sort}", items[k])
}

wat_canon_options: fn(c: &WatComponent, items: [Int], from: Int) -> [U8] WasmError! {
    tree: c.tree
    out := [U8]{}
    count := 0
    loop k in from..<items.len() {
        node: items[k]
        if tree.is_atom(node) {
            text: tree.atom(node)
            if text == "string-encoding=utf8" {
                out.push(U8{0x00})
            } else if text == "string-encoding=utf16" {
                out.push(U8{0x01})
            } else if text == "string-encoding=latin1+utf16" {
                out.push(U8{0x02})
            } else {
                return Err(c.fail(node, "unknown canonical option `{text}`"))
            }
            count += 1
            next
        }
        head: tree.head(node)
        parts: tree.kids(node)
        if head == "memory" {
            index: wat_core_ref(c, "memory", node)
            out.push(U8{0x03})
            wasm_put_unsigned(out, index)
        } else if head == "realloc" || head == "post-return" {
            if parts.len() != 2 -> return Err(c.fail(node, "expected `({head} <core func>)`"))
            index: if tree.is_list(parts[1]) -> wat_core_ref(c, "func", parts[1]) else -> c.index("core func", parts[1])
            out.push(U8{if head == "realloc" -> 0x04 else -> 0x05})
            wasm_put_unsigned(out, index)
        } else {
            return Err(c.fail(node, "unsupported canonical option `({head} ...)`"))
        }
        count += 1
    }
    result := [U8]{}
    wasm_put_unsigned(result, count)
    wat_put_bytes(result, out)
    Ok(result)
}

wat_encode_component: fn(tree: WatTree, root: Int) -> [U8] WasmError! {
    c := WatComponent{tree: tree, out: [U8]{0, 0x61, 0x73, 0x6d, 0x0d, 0, 0x01, 0}, counts: [String:Int]{}, names: [String:Int]{}, types: WatTypeSpace.new(false)}
    fields: tree.kids(root)
    k := 1
    if k < fields.len() && tree.is_id(fields[k]) -> k += 1
    loop k < fields.len() {
        wat_component_field(c, fields[k])
        k += 1
    }
    c.flush_types()
    Ok(c.out)
}

wat_component_field: fn(c: &WatComponent, field: Int) WasmError! {
    tree: c.tree
    if !tree.is_list(field) -> return Err(c.fail(field, "expected a component field"))
    items: tree.kids(field)
    head: tree.head(field)
    if head == "core" {
        if items.len() < 2 -> return Err(c.fail(field, "expected `(core <kind> ...)`"))
        kind: tree.atom(items[1])
        name: if items.len() > 2 && tree.is_id(items[2]) -> tree.atom(items[2]) else -> ""
        body: if name != "" -> 3 else -> 2
        if kind == "module" {
            bytes: wat_encode_module(tree, field, 2)
            c.flush_types()
            wat_put_section(c.out, 1, bytes)
            _: c.define("core module", name)
        } else if kind == "instance" {
            wat_core_instance(c, field, items, body, name)
        } else if kind == "func" {
            if body >= items.len() -> return Err(c.fail(field, "expected `(canon lower ...)` or `(alias ...)`"))
            form: items[body]
            parts: tree.kids(form)
            if tree.head(form) == "canon" && parts.len() >= 3 && tree.atom(parts[1]) == "lower" {
                func_parts: tree.kids(parts[2])
                if tree.head(parts[2]) != "func" || func_parts.len() != 2 -> return Err(c.fail(parts[2], "expected `(func <index>)`"))
                func: c.index("func", func_parts[1])
                options: wat_canon_options(c, parts, 3)
                item := [U8]{0x01, 0x00}
                wasm_put_unsigned(item, func)
                wat_put_bytes(item, options)
                c.section(8, item)
                _: c.define("core func", name)
            } else if tree.head(form) == "alias" && parts.len() == 4 && tree.atom(parts[1]) == "core" && tree.atom(parts[2]) == "export" {
                return Err(c.fail(form, "expected `(alias core export <instance> \"name\")`"))
            } else if tree.head(form) == "alias" && parts.len() == 5 && tree.atom(parts[1]) == "core" && tree.atom(parts[2]) == "export" {
                instance: c.index("core instance", parts[3])
                wat_alias_core_export(c, "func", instance, tree.string(parts[4]), name)
            } else {
                return Err(c.fail(form, "unsupported core func definition"))
            }
        } else {
            return Err(c.fail(field, "unsupported component field `(core {kind} ...)`"))
        }
        return
    }
    name: if items.len() > 1 && tree.is_id(items[1]) -> tree.atom(items[1]) else -> ""
    body: if name != "" -> 2 else -> 1
    if head == "type" {
        if body >= items.len() -> return Err(c.fail(field, "expected a type definition"))
        def: wat_deftype(tree, c.types, items[body])
        _: c.types.hoist(def, name)
        c.flush_types()
    } else if head == "import" {
        if items.len() != 3 -> return Err(c.fail(field, "expected `(import \"name\" <desc>)`"))
        desc_node: items[2]
        desc: wat_externdesc(tree, c.types, desc_node)
        item := [U8]{0x00}
        wat_put_name(item, tree.string(items[1]))
        wat_put_bytes(item, desc)
        c.section(10, item)
        desc_parts: tree.kids(desc_node)
        inner_name: if desc_parts.len() > 1 && tree.is_id(desc_parts[1]) -> tree.atom(desc_parts[1]) else -> ""
        sort: wat_desc_sort(tree.head(desc_node))
        if sort == "type" {
            index: c.types.count
            c.types.count += 1
            if inner_name != "" -> c.types.names[inner_name] = index
        } else {
            _: c.define(sort, inner_name)
        }
    } else if head == "func" {
        wat_component_func(c, field, items, body, name)
    } else if head == "alias" {
        if items.len() != 5 && items.len() != 6 -> return Err(c.fail(field, "expected `(alias [core] export <instance> \"name\" (<sort>))`"))
        if tree.atom(items[1]) == "core" {
            target: items[5]
            target_parts: tree.kids(target)
            if tree.atom(items[2]) != "export" || tree.head(target) != "core" || target_parts.len() < 2 -> return Err(c.fail(field, "expected `(alias core export <instance> \"name\" (core <sort> $id?))`"))
            sort: tree.atom(target_parts[1])
            id: if target_parts.len() > 2 -> tree.atom(target_parts[2]) else -> ""
            instance: c.index("core instance", items[3])
            wat_alias_core_export(c, sort, instance, tree.string(items[4]), id)
        } else {
            if tree.atom(items[1]) != "export" -> return Err(c.fail(field, "only `alias export` and `alias core export` are supported"))
            target: items[4]
            target_parts: tree.kids(target)
            sort: tree.head(target)
            sort_byte: if sort == "func" -> 0x01 else if sort == "instance" -> 0x05 else if sort == "type" -> 0x03 else -> -1
            if sort_byte < 0 -> return Err(c.fail(target, "unsupported alias sort `{sort}`"))
            instance: c.index("instance", items[2])
            item := [U8]{U8{sort_byte}, 0x00}
            wasm_put_unsigned(item, instance)
            wat_put_name(item, tree.string(items[3]))
            c.section(6, item)
            id: if target_parts.len() > 1 -> tree.atom(target_parts[1]) else -> ""
            if sort == "type" {
                index: c.types.count
                c.types.count += 1
                if id != "" -> c.types.names[id] = index
            } else {
                _: c.define(sort, id)
            }
        }
    } else if head == "export" {
        j := 1
        export_name := ""
        if j < items.len() && tree.is_id(items[j]) {
            export_name = tree.atom(items[j])
            j += 1
        }
        if j + 1 >= items.len() -> return Err(c.fail(field, "expected `(export \"name\" (<sort> <index>))`"))
        target: items[j + 1]
        parts: tree.kids(target)
        sort: tree.head(target)
        item := [U8]{0x00}
        wat_put_name(item, tree.string(items[j]))
        if sort == "core" {
            if parts.len() != 3 || tree.atom(parts[1]) != "module" -> return Err(c.fail(target, "only core modules export from the core sorts"))
            wat_put_bytes(item, [U8]{0x00, 0x11})
            wasm_put_unsigned(item, c.index("core module", parts[2]))
        } else {
            sort_byte: if sort == "func" -> 0x01 else if sort == "instance" -> 0x05 else if sort == "type" -> 0x03 else -> -1
            if sort_byte < 0 || parts.len() != 2 -> return Err(c.fail(target, "unsupported export `({sort} ...)`"))
            item.push(U8{sort_byte})
            index: if sort == "type" -> wat_type_ref(tree, c.types, parts[1]) else -> c.index(sort, parts[1])
            wasm_put_unsigned(item, index)
        }
        if j + 2 < items.len() {
            item.push(U8{0x01})
            wat_put_bytes(item, wat_externdesc(tree, c.types, items[j + 2]))
        } else {
            item.push(U8{0x00})
        }
        c.section(11, item)
        if sort == "type" {
            index: c.types.count
            c.types.count += 1
            if export_name != "" -> c.types.names[export_name] = index
        } else if sort == "core" {
            _: c.define("core module", export_name)
        } else {
            _: c.define(sort, export_name)
        }
    } else {
        return Err(c.fail(field, "unsupported component field `({head} ...)`"))
    }
}

wat_core_instance: fn(c: &WatComponent, field: Int, items: [Int], body: Int, name: String) WasmError! {
    tree: c.tree
    if body < items.len() && tree.head(items[body]) == "instantiate" {
        parts: tree.kids(items[body])
        if parts.len() < 2 -> return Err(c.fail(items[body], "expected `(instantiate <module> ...)`"))
        module_index: c.index("core module", parts[1])
        args := [U8]{}
        loop k in 2..<parts.len() {
            with: tree.kids(parts[k])
            if tree.head(parts[k]) != "with" || with.len() != 3 || tree.head(with[2]) != "instance" -> return Err(c.fail(parts[k], "expected `(with \"name\" (instance ...))`"))
            target: tree.kids(with[2])
            instance := 0
            if target.len() == 2 && tree.is_ref(target[1]) {
                instance = c.index("core instance", target[1])
            } else {
                instance = wat_core_instance_exports(c, target, 1, "")
            }
            wat_put_name(args, tree.string(with[1]))
            args.push(U8{0x12})
            wasm_put_unsigned(args, instance)
        }
        item := [U8]{0x00}
        wasm_put_unsigned(item, module_index)
        wasm_put_unsigned(item, parts.len() - 2)
        wat_put_bytes(item, args)
        c.section(2, item)
        _: c.define("core instance", name)
        return
    }
    wat_core_instance_exports(c, items, body, name)
}

// A core instance built from `(export "name" (<sort> <index>))` items; returns its index.
wat_core_instance_exports: fn(c: &WatComponent, items: [Int], from: Int, name: String) -> Int WasmError! {
    tree: c.tree
    exports := [U8]{}
    loop k in from..<items.len() {
        parts: tree.kids(items[k])
        if tree.head(items[k]) != "export" || parts.len() != 3 -> return Err(c.fail(items[k], "expected `(export \"name\" (<sort> <index>))`"))
        target: tree.kids(parts[2])
        sort: tree.head(parts[2])
        if target.len() != 2 -> return Err(c.fail(parts[2], "expected `({sort} <index>)`"))
        wat_put_name(exports, tree.string(parts[1]))
        exports.push(U8{wat_core_sort_byte(sort)})
        wasm_put_unsigned(exports, c.index("core {sort}", target[1]))
    }
    item := [U8]{0x01}
    wasm_put_unsigned(item, items.len() - from)
    wat_put_bytes(item, exports)
    c.section(2, item)
    Ok(c.define("core instance", name))
}

wat_component_func: fn(c: &WatComponent, field: Int, items: [Int], body: Int, name: String) WasmError! {
    tree: c.tree
    k := body
    // An alias form: (func $id (alias export $instance "name")).
    if k < items.len() && tree.head(items[k]) == "alias" {
        parts: tree.kids(items[k])
        if parts.len() != 4 || tree.atom(parts[1]) != "export" -> return Err(c.fail(items[k], "expected `(alias export <instance> \"name\")`"))
        item := [U8]{0x01, 0x00}
        wasm_put_unsigned(item, c.index("instance", parts[2]))
        wat_put_name(item, tree.string(parts[3]))
        c.section(6, item)
        _: c.define("func", name)
        return
    }
    type_index := -1
    if k < items.len() && tree.head(items[k]) == "type" {
        parts: tree.kids(items[k])
        type_index = wat_type_ref(tree, c.types, parts[1])
        k += 1
    }
    canon_at := k
    loop canon_at < items.len() && tree.head(items[canon_at]) != "canon" -> canon_at += 1
    if canon_at >= items.len() -> return Err(c.fail(field, "expected `(canon lift ...)`"))
    if type_index < 0 {
        def: wat_functype(tree, c.types, items[k..<canon_at], 0)
        type_index = c.types.hoist(def, "")
    } else if canon_at != k {
        return Err(c.fail(items[k], "a function names its type once"))
    }
    canon: tree.kids(items[canon_at])
    if canon.len() < 3 || tree.atom(canon[1]) != "lift" -> return Err(c.fail(items[canon_at], "expected `(canon lift (core func ...) <options>)`"))
    core_func: wat_core_ref(c, "func", canon[2])
    options: wat_canon_options(c, canon, 3)
    item := [U8]{0x00, 0x00}
    wasm_put_unsigned(item, core_func)
    wat_put_bytes(item, options)
    wasm_put_unsigned(item, type_index)
    c.section(8, item)
    _: c.define("func", name)
}
