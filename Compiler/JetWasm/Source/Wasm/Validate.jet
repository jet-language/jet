// The core module validator: the specification's validation algorithm for
// WebAssembly 2.0 (multi-value, sign extension, saturating truncation, bulk
// memory, reference types) with one memory. A module that validates has
// well-typed function bodies, in-range indexes and constant initialisers, so
// the translator may assume all of it. Errors carry the offending
// instruction's byte offset and the defined function's index.

WasmValidator: struct {
    wm: WasmModule
    ops: WasmOpTable
    // Module context: function types by function index, global types, the
    // declared function references, the table element types.
    func_types: [Int]
    globals: [WasmGlobalType]
    tables: [Int]
    refs: [Int:Bool]
    memories: Int
    // Function context.
    locals: [Int]
    results: [Int]
    vals: [Int]
    frame_ops: [Int]
    frame_params: [[Int]]
    frame_results: [[Int]]
    frame_heights: [Int]
    frame_unreachable: [Bool]
    at: Int
    function: Int

    fail: fn(self, message: String) -> WasmError Never! {
        WasmError.new("func {self.function}: {message}", self.at)
    }

    push: fn(&self, ty: Int) Never! {
        &self.vals.push(ty)
    }

    pop: fn(&self) -> Int WasmError! {
        top: self.frame_heights.len() - 1
        if self.vals.len() == self.frame_heights[top] {
            if self.frame_unreachable[top] -> return Ok(WASM_UNKNOWN)
            return Err(self.fail("type mismatch: expected a value but the stack is empty"))
        }
        top_value: &self.vals.pop() ?? WASM_UNKNOWN
        Ok(top_value)
    }

    pop_expect: fn(&self, expected: Int) -> Int WasmError! {
        actual: &self.pop()
        if actual != expected && actual != WASM_UNKNOWN && expected != WASM_UNKNOWN {
            return Err(self.fail("type mismatch: expected {wasm_type_name(expected)}, found {wasm_type_name(actual)}"))
        }
        Ok(if actual == WASM_UNKNOWN -> expected else -> actual)
    }

    pop_all: fn(&self, types: [Int]) WasmError! {
        k := types.len()
        loop k > 0 {
            k -= 1
            &self.pop_expect(types[k])
        }
    }

    push_all: fn(&self, types: [Int]) Never! {
        loop ty in types -> &self.vals.push(ty)
    }

    push_frame: fn(&self, op: Int, params: [Int], results: [Int]) Never! {
        &self.frame_ops.push(op)
        &self.frame_params.push(params)
        &self.frame_results.push(results)
        &self.frame_heights.push(self.vals.len())
        &self.frame_unreachable.push(false)
        &self.push_all(params)
    }

    // Pops the innermost frame after checking its results; returns its results.
    pop_frame: fn(&self) -> [Int] WasmError! {
        if self.frame_ops.len() == 0 -> return Err(self.fail("control frames underflow"))
        top: self.frame_ops.len() - 1
        results: self.frame_results[top]
        &self.pop_all(results)
        if self.vals.len() != self.frame_heights[top] -> return Err(self.fail("type mismatch: values remaining on stack at end of block"))
        _: &self.frame_ops.pop()
        _: &self.frame_params.pop()
        _: &self.frame_results.pop()
        _: &self.frame_heights.pop()
        _: &self.frame_unreachable.pop()
        Ok(results)
    }

    label_types: fn(self, depth: Int) -> [Int] WasmError! {
        if depth < 0 || depth >= self.frame_ops.len() -> return Err(self.fail("unknown label {depth}"))
        index: self.frame_ops.len() - 1 - depth
        if self.frame_ops[index] == WASM_OP_LOOP -> return Ok(self.frame_params[index])
        Ok(self.frame_results[index])
    }

    unreachable: fn(&self) Never! {
        top: self.frame_heights.len() - 1
        loop self.vals.len() > self.frame_heights[top] {
            _: &self.vals.pop()
        }
        self.frame_unreachable[top] = true
    }

    block_type: fn(self, block_type: Int) -> WasmFuncType WasmError! {
        sig: wasm_block_signature(self.wm, block_type) ?? return Err(self.fail("unknown type {block_type}"))
        Ok(sig)
    }

    func_type: fn(self, index: Int) -> WasmFuncType WasmError! {
        if index < 0 || index >= self.func_types.len() -> return Err(self.fail("unknown function {index}"))
        Ok(self.wm.types[self.func_types[index]])
    }

    table: fn(self, index: Int) -> Int WasmError! {
        if index < 0 || index >= self.tables.len() -> return Err(self.fail("unknown table {index}"))
        Ok(self.tables[index])
    }

    memory: fn(self) WasmError! {
        if self.memories == 0 -> return Err(self.fail("unknown memory 0"))
    }

    data: fn(self, index: Int) WasmError! {
        count: self.wm.data_count ?? 0
        if index < 0 || index >= count -> return Err(self.fail("unknown data segment {index}"))
    }

    elem: fn(self, index: Int) -> Int WasmError! {
        if index < 0 || index >= self.wm.elems.len() -> return Err(self.fail("unknown elem segment {index}"))
        Ok(self.wm.elems[index].elem_type)
    }
}

wasm_validate_module: fn(wm: WasmModule) WasmError! {
    v := WasmValidator{
        wm: wm, ops: WasmOpTable.new(), func_types: [Int]{}, globals: [WasmGlobalType]{}, tables: [Int]{}, refs: [Int:Bool]{},
        memories: 0, locals: [Int]{}, results: [Int]{}, vals: [Int]{}, frame_ops: [Int]{}, frame_params: [[Int]]{},
        frame_results: [[Int]]{}, frame_heights: [Int]{}, frame_unreachable: [Bool]{}, at: -1, function: -1,
    }
    wasm_validate_imports(&v)
    loop index in wm.funcs {
        if index >= wm.types.len() -> return Err(WasmError.new("unknown type {index}", -1))
        &v.func_types.push(index)
    }
    loop table in wm.tables {
        wasm_validate_limits(table.limits, TWO_32 - 1, "table")
        &v.tables.push(table.elem)
    }
    loop memory in wm.memories {
        wasm_validate_limits(memory, WASM_MAX_PAGES, "memory")
        v.memories += 1
    }
    if v.memories > 1 -> return Err(WasmError.new("multiple memories are not supported by the plugin engine", -1))
    // Function references the module declares outside function bodies.
    loop entry in wm.exports {
        if entry.kind == WASM_EXTERN_FUNC -> v.refs[entry.index] = true
    }
    loop segment in wm.elems {
        loop item in segment.items {
            if item >= 0 -> v.refs[item] = true
        }
    }
    loop global in wm.globals {
        if global.init.op == WASM_OP_REF_FUNC -> v.refs[global.init.value] = true
    }
    imported_globals: v.globals.len()
    loop global in wm.globals {
        wasm_validate_const(&v, global.init, global.ty.value, imported_globals)
        &v.globals.push(global.ty)
    }
    names := [String:Bool]{}
    loop entry in wm.exports {
        if names.get(entry.name) != None -> return Err(WasmError.new("duplicate export name `{entry.name}`", -1))
        names[entry.name] = true
        count: if entry.kind == WASM_EXTERN_FUNC -> v.func_types.len() else if entry.kind == WASM_EXTERN_TABLE -> v.tables.len() else if entry.kind == WASM_EXTERN_MEMORY -> v.memories else -> v.globals.len()
        if entry.index >= count -> return Err(WasmError.new("export `{entry.name}` names an unknown index {entry.index}", -1))
    }
    if wm.start == .Val(start) {
        ty: wasm_validate_function_type(v, start)
        if ty.params.len() != 0 || ty.results.len() != 0 -> return Err(WasmError.new("start function must have type [] -> []", -1))
    }
    loop segment in wm.elems {
        loop item in segment.items {
            if item >= v.func_types.len() -> return Err(WasmError.new("unknown function {item} in element segment", -1))
            if item < 0 && segment.elem_type != WASM_FUNCREF && segment.elem_type != WASM_EXTERNREF -> return Err(WasmError.new("type mismatch in element segment", -1))
        }
        if segment.items.len() > 0 && segment.elem_type == WASM_EXTERNREF {
            loop item in segment.items {
                if item >= 0 -> return Err(WasmError.new("type mismatch: ref.func in an externref element segment", -1))
            }
        }
        if segment.mode == WASM_SEGMENT_ACTIVE {
            if segment.table >= v.tables.len() -> return Err(WasmError.new("unknown table {segment.table}", -1))
            if v.tables[segment.table] != segment.elem_type -> return Err(WasmError.new("type mismatch: element segment does not match its table", -1))
            visible: v.globals.len()
            wasm_validate_const(&v, segment.offset, WASM_I32, visible)
        }
    }
    loop segment in wm.datas {
        if segment.mode == WASM_SEGMENT_ACTIVE {
            if segment.memory != 0 || v.memories == 0 -> return Err(WasmError.new("unknown memory {segment.memory}", -1))
            visible: v.globals.len()
            wasm_validate_const(&v, segment.offset, WASM_I32, visible)
        }
    }
    imported_funcs: wm.imported(WASM_EXTERN_FUNC)
    loop k in 0..<wm.codes.len() {
        v.function = imported_funcs + k
        wasm_validate_body(&v, wm.codes[k], wm.types[wm.funcs[k]])
    }
}

wasm_validate_function_type: fn(v: WasmValidator, index: Int) -> WasmFuncType WasmError! {
    if index < 0 || index >= v.func_types.len() -> return Err(WasmError.new("unknown function {index}", -1))
    Ok(v.wm.types[v.func_types[index]])
}

wasm_validate_limits: fn(limits: WasmLimits, ceiling: Int, what: String) WasmError! {
    if limits.min > ceiling -> return Err(WasmError.new("{what} size must be at most {ceiling}", -1))
    if limits.max == .Val(max) {
        if max > ceiling -> return Err(WasmError.new("{what} size must be at most {ceiling}", -1))
        if max < limits.min -> return Err(WasmError.new("size minimum must not be greater than maximum", -1))
    }
}

wasm_validate_imports: fn(v: &WasmValidator) WasmError! {
    loop entry in v.wm.imports {
        if entry.kind == WASM_EXTERN_FUNC {
            if entry.type_index >= v.wm.types.len() -> return Err(WasmError.new("unknown type {entry.type_index} for import `{entry.module_name}.{entry.name}`", -1))
            &v.func_types.push(entry.type_index)
        } else if entry.kind == WASM_EXTERN_TABLE {
            table: entry.table ?? return Err(WasmError.new("malformed table import", -1))
            wasm_validate_limits(table.limits, TWO_32 - 1, "table")
            &v.tables.push(table.elem)
        } else if entry.kind == WASM_EXTERN_MEMORY {
            memory: entry.memory ?? return Err(WasmError.new("malformed memory import", -1))
            wasm_validate_limits(memory, WASM_MAX_PAGES, "memory")
            v.memories += 1
        } else {
            global: entry.global ?? return Err(WasmError.new("malformed global import", -1))
            &v.globals.push(global)
        }
    }
}

// A constant initialiser of type `expected`; `global.get` may name only the
// first `visible` globals and only immutable ones.
wasm_validate_const: fn(v: &WasmValidator, expr: WasmConstExpr, expected: Int, visible: Int) WasmError! {
    op: expr.op
    ty := WASM_UNKNOWN
    if op == WASM_OP_I32_CONST {
        ty = WASM_I32
    } else if op == WASM_OP_I64_CONST {
        ty = WASM_I64
    } else if op == WASM_OP_F32_CONST {
        ty = WASM_F32
    } else if op == WASM_OP_F64_CONST {
        ty = WASM_F64
    } else if op == WASM_OP_REF_NULL {
        ty = expr.value
    } else if op == WASM_OP_REF_FUNC {
        if expr.value >= v.func_types.len() -> return Err(WasmError.new("unknown function {expr.value}", -1))
        ty = WASM_FUNCREF
    } else {
        if expr.value >= visible -> return Err(WasmError.new("unknown global {expr.value} in a constant expression", -1))
        global: v.globals[expr.value]
        if global.mutable -> return Err(WasmError.new("constant expression required: global {expr.value} is mutable", -1))
        ty = global.value
    }
    if ty != expected -> return Err(WasmError.new("type mismatch: constant expression has type {wasm_type_name(ty)}, expected {wasm_type_name(expected)}", -1))
}

wasm_validate_body: fn(v: &WasmValidator, code: WasmCode, ty: WasmFuncType) WasmError! {
    v.locals = ty.params.copy()
    loop local in code.locals -> &v.locals.push(local)
    v.results = ty.results
    v.vals = [Int]{}
    v.frame_ops = [Int]{}
    v.frame_params = [[Int]]{}
    v.frame_results = [[Int]]{}
    v.frame_heights = [Int]{}
    v.frame_unreachable = [Bool]{}
    v.at = code.start
    &v.push_frame(WASM_OP_BLOCK, [Int]{}, ty.results)
    loop k in 0..<code.op.len() {
        v.at = code.at[k]
        if v.frame_ops.len() == 0 -> return Err(v.fail("operators remaining after end of function"))
        wasm_validate_instruction(&v, code, k)
    }
    if v.frame_ops.len() != 0 -> return Err(v.fail("unexpected end of function body"))
}

wasm_validate_instruction: fn(v: &WasmValidator, code: WasmCode, k: Int) WasmError! {
    op: code.op[k]
    a: code.a[k]
    b: code.b[k]
    info: v.ops.info(op) ?? return Err(v.fail("illegal opcode"))
    if info.imm == WASM_IMM_MEMARG {
        v.memory()
        natural: wasm_log2(info.width)
        if a > natural -> return Err(v.fail("alignment must not be larger than natural"))
        if b >= TWO_32 -> return Err(v.fail("offset out of range"))
    }
    if info.sig != "" {
        if info.imm == WASM_IMM_MEMORY || op == WASM_OP_MEMORY_COPY -> v.memory()
        if op == WASM_OP_MEMORY_INIT {
            v.memory()
            v.data(a)
        }
        if op == WASM_OP_DATA_DROP -> v.data(a)
        if op == WASM_OP_TABLE_INIT {
            elem_type: v.elem(a)
            table_type: v.table(b)
            if elem_type != table_type -> return Err(v.fail("type mismatch: table.init element type differs from the table's"))
        }
        if op == WASM_OP_ELEM_DROP -> v.elem(a)
        if op == WASM_OP_TABLE_COPY {
            dst: v.table(a)
            src: v.table(b)
            if dst != src -> return Err(v.fail("type mismatch: table.copy between tables of different element types"))
        }
        if op == WASM_OP_TABLE_SIZE -> v.table(a)
        &v.pop_all(wasm_sig_side(info.sig, false))
        &v.push_all(wasm_sig_side(info.sig, true))
        return
    }
    if op == WASM_OP_UNREACHABLE {
        &v.unreachable()
    } else if op == WASM_OP_BLOCK || op == WASM_OP_LOOP || op == WASM_OP_IF {
        sig: v.block_type(a)
        if op == WASM_OP_IF -> &v.pop_expect(WASM_I32)
        &v.pop_all(sig.params)
        &v.push_frame(op, sig.params, sig.results)
    } else if op == WASM_OP_ELSE {
        top: v.frame_ops.len() - 1
        if v.frame_ops[top] != WASM_OP_IF -> return Err(v.fail("else without a matching if"))
        params: v.frame_params[top]
        results: &v.pop_frame()
        &v.push_frame(WASM_OP_ELSE, params, results)
    } else if op == WASM_OP_END {
        top: v.frame_ops.len() - 1
        kind: v.frame_ops[top]
        params: v.frame_params[top]
        results: &v.pop_frame()
        if kind == WASM_OP_IF && params != results -> return Err(v.fail("type mismatch: if without else must leave its parameters as its results"))
        &v.push_all(results)
    } else if op == WASM_OP_BR {
        types: v.label_types(a)
        &v.pop_all(types)
        &v.unreachable()
    } else if op == WASM_OP_BR_IF {
        &v.pop_expect(WASM_I32)
        types: v.label_types(a)
        &v.pop_all(types)
        &v.push_all(types)
    } else if op == WASM_OP_BR_TABLE {
        &v.pop_expect(WASM_I32)
        default_types: v.label_types(b)
        arity: default_types.len()
        loop depth in code.tables[a] {
            types: v.label_types(depth)
            if types.len() != arity -> return Err(v.fail("type mismatch: br_table targets have different arities"))
            // Check each target against the stack without consuming it.
            popped := [Int]{}
            j := types.len()
            loop j > 0 {
                j -= 1
                got: &v.pop_expect(types[j])
                &popped.push(got)
            }
            loop m in 0..<popped.len() -> &v.push(popped[popped.len() - 1 - m])
        }
        &v.pop_all(default_types)
        &v.unreachable()
    } else if op == WASM_OP_RETURN {
        results: v.results.copy()
        &v.pop_all(results)
        &v.unreachable()
    } else if op == WASM_OP_CALL {
        sig: v.func_type(a)
        &v.pop_all(sig.params)
        &v.push_all(sig.results)
    } else if op == WASM_OP_CALL_INDIRECT {
        table: v.table(b)
        if table != WASM_FUNCREF -> return Err(v.fail("type mismatch: call_indirect through a non-funcref table"))
        if a >= v.wm.types.len() -> return Err(v.fail("unknown type {a}"))
        sig: v.wm.types[a]
        &v.pop_expect(WASM_I32)
        &v.pop_all(sig.params)
        &v.push_all(sig.results)
    } else if op == WASM_OP_DROP {
        &v.pop()
    } else if op == WASM_OP_SELECT {
        &v.pop_expect(WASM_I32)
        first: &v.pop()
        second: &v.pop()
        if wasm_is_ref(first) || wasm_is_ref(second) -> return Err(v.fail("type mismatch: select without a type needs numeric operands"))
        if first != second && first != WASM_UNKNOWN && second != WASM_UNKNOWN -> return Err(v.fail("type mismatch: select operands differ"))
        &v.push(if first == WASM_UNKNOWN -> second else -> first)
    } else if op == WASM_OP_SELECT_T {
        &v.pop_expect(WASM_I32)
        &v.pop_expect(a)
        &v.pop_expect(a)
        &v.push(a)
    } else if op == WASM_OP_LOCAL_GET || op == WASM_OP_LOCAL_SET || op == WASM_OP_LOCAL_TEE {
        if a >= v.locals.len() -> return Err(v.fail("unknown local {a}"))
        ty: v.locals[a]
        if op == WASM_OP_LOCAL_GET {
            &v.push(ty)
        } else {
            &v.pop_expect(ty)
            if op == WASM_OP_LOCAL_TEE -> &v.push(ty)
        }
    } else if op == WASM_OP_GLOBAL_GET || op == WASM_OP_GLOBAL_SET {
        if a >= v.globals.len() -> return Err(v.fail("unknown global {a}"))
        global: v.globals[a]
        if op == WASM_OP_GLOBAL_GET {
            &v.push(global.value)
        } else {
            if !global.mutable -> return Err(v.fail("global {a} is immutable"))
            &v.pop_expect(global.value)
        }
    } else if op == WASM_OP_TABLE_GET {
        ty: v.table(a)
        &v.pop_expect(WASM_I32)
        &v.push(ty)
    } else if op == WASM_OP_TABLE_SET {
        ty: v.table(a)
        &v.pop_expect(ty)
        &v.pop_expect(WASM_I32)
    } else if op == WASM_OP_TABLE_GROW {
        ty: v.table(a)
        &v.pop_expect(WASM_I32)
        &v.pop_expect(ty)
        &v.push(WASM_I32)
    } else if op == WASM_OP_TABLE_FILL {
        ty: v.table(a)
        &v.pop_expect(WASM_I32)
        &v.pop_expect(ty)
        &v.pop_expect(WASM_I32)
    } else if op == WASM_OP_REF_NULL {
        &v.push(a)
    } else if op == WASM_OP_REF_IS_NULL {
        ty: &v.pop()
        if ty != WASM_UNKNOWN && !wasm_is_ref(ty) -> return Err(v.fail("type mismatch: ref.is_null needs a reference"))
        &v.push(WASM_I32)
    } else if op == WASM_OP_REF_FUNC {
        if a >= v.func_types.len() -> return Err(v.fail("unknown function {a}"))
        if v.refs.get(a) == None -> return Err(v.fail("undeclared function reference {a}"))
        &v.push(WASM_FUNCREF)
    } else {
        return Err(v.fail("illegal opcode 0x{wasm_hex(op)}"))
    }
}

wasm_log2: fn(width: Int) -> Int Never! {
    if width == {
        1 -> 0
        2 -> 1
        4 -> 2
        else -> 3
    }
}
