// The core WebAssembly module model the decoder and the text reader both
// produce and the validator and translator consume. Value types are their
// binary codes (WASM_I32 …); a function body is a flat instruction list held
// as parallel arrays, one entry per instruction, with the instruction's byte
// offset in the module for trap frames.

WASM_I32: 0x7f
WASM_I64: 0x7e
WASM_F32: 0x7d
WASM_F64: 0x7c
WASM_V128: 0x7b
WASM_FUNCREF: 0x70
WASM_EXTERNREF: 0x6f
// The validator's bottom type: an operand popped from an unreachable stack.
WASM_UNKNOWN: 0

// The empty block type, as its s33 encoding.
WASM_BLOCK_EMPTY: -64

WASM_EXTERN_FUNC: 0
WASM_EXTERN_TABLE: 1
WASM_EXTERN_MEMORY: 2
WASM_EXTERN_GLOBAL: 3

WASM_SEGMENT_ACTIVE: 0
WASM_SEGMENT_PASSIVE: 1
WASM_SEGMENT_DECLARATIVE: 2

// One page of linear memory, and the 32-bit memory's page ceiling.
WASM_PAGE: 65536
WASM_MAX_PAGES: 65536
// Implementation bounds the decoder enforces before allocating.
WASM_MAX_LOCALS: 50000
WASM_MAX_FUNCTIONS: 1000000
WASM_MAX_TABLE: 10000000

wasm_type_name: fn(code: Int) -> String Never! {
    if code == {
        0x7f -> "i32"
        0x7e -> "i64"
        0x7d -> "f32"
        0x7c -> "f64"
        0x7b -> "v128"
        0x70 -> "funcref"
        0x6f -> "externref"
        0 -> "unknown"
        else -> "type 0x{wasm_hex(code)}"
    }
}

wasm_is_number: fn(code: Int) -> Bool Never! {
    code == WASM_I32 || code == WASM_I64 || code == WASM_F32 || code == WASM_F64
}

wasm_is_ref: fn(code: Int) -> Bool Never! {
    code == WASM_FUNCREF || code == WASM_EXTERNREF
}

WasmFuncType: struct {
    params: [Int]
    results: [Int]

    render: fn(self) -> String Never! {
        params: (loop code in self.params -> wasm_type_name(code)).join(" ")
        results: (loop code in self.results -> wasm_type_name(code)).join(" ")
        "[{params}] -> [{results}]"
    }
}

WasmLimits: struct {
    min: Int
    max: Int?
}

WasmTableType: struct {
    elem: Int
    limits: WasmLimits
}

WasmGlobalType: struct {
    value: Int
    mutable: Bool
}

// A constant expression: one constant, `global.get`, `ref.null` or
// `ref.func`. `op` is its opcode; `value` the constant (float bit pattern),
// global or function index, or the null's reference type.
WasmConstExpr: struct {
    op: Int
    value: Int
}

WasmImport: struct {
    module_name: String
    name: String
    kind: Int
    // A function import's type index.
    type_index: Int
    table: WasmTableType?
    memory: WasmLimits?
    global: WasmGlobalType?
}

WasmGlobal: struct {
    ty: WasmGlobalType
    init: WasmConstExpr
}

WasmExport: struct {
    name: String
    kind: Int
    index: Int
}

// An element segment. `items` are function indexes; -1 is a null reference.
WasmElem: struct {
    mode: Int
    table: Int
    offset: WasmConstExpr
    elem_type: Int
    items: [Int]
}

WasmData: struct {
    mode: Int
    memory: Int
    offset: WasmConstExpr
    bytes: [U8]
}

// One function body. Instruction k is op[k] with immediates a[k], b[k]; at[k]
// is its byte offset in the module. Opcodes are the binary opcode, or
// 0xfc00 + n for the 0xfc-prefixed instructions. Immediates by instruction:
//   block/loop/if   a = block type (s33: WASM_BLOCK_EMPTY, a value type's
//                   negative s33 code, or a type index)
//   br/br_if        a = label depth
//   br_table        a = index into `tables`, b = default depth
//   call            a = function; call_indirect a = type, b = table
//   local.*/global.* a = index
//   loads/stores    a = alignment exponent, b = offset
//   *.const         a = value (i32/i64 signed, f32/f64 bit pattern)
//   select t        a = value type; ref.null a = reference type; ref.func a
//   table.get/set/grow/size/fill a = table; table.copy a = dst, b = src;
//   table.init a = element segment, b = table; elem.drop a = segment;
//   memory.init/data.drop a = data segment
WasmCode: struct {
    locals: [Int]
    op: [Int]
    a: [Int]
    b: [Int]
    at: [Int]
    tables: [[Int]]
    // The body's first byte (after the local declarations) and its end.
    start: Int
    end: Int
}

WasmModule: struct {
    types: [WasmFuncType]
    imports: [WasmImport]
    // The type index of each defined (non-imported) function.
    funcs: [Int]
    tables: [WasmTableType]
    memories: [WasmLimits]
    globals: [WasmGlobal]
    exports: [WasmExport]
    start: Int?
    elems: [WasmElem]
    datas: [WasmData]
    data_count: Int?
    codes: [WasmCode]
    // The name section's module name and function names ("" when absent).
    name: String
    function_names: [Int:String]

    empty: fn() -> WasmModule Never! {
        WasmModule{
            types: [WasmFuncType]{}, imports: [WasmImport]{}, funcs: [Int]{}, tables: [WasmTableType]{},
            memories: [WasmLimits]{}, globals: [WasmGlobal]{}, exports: [WasmExport]{}, start: None,
            elems: [WasmElem]{}, datas: [WasmData]{}, data_count: None, codes: [WasmCode]{},
            name: "", function_names: [Int:String]{},
        }
    }

    imported: fn(self, kind: Int) -> Int Never! {
        count := 0
        loop entry in self.imports {
            if entry.kind == kind -> count += 1
        }
        count
    }

    // The type index of function `index` in the function index space.
    function_type: fn(self, index: Int) -> Int? {
        seen := 0
        loop entry in self.imports {
            if entry.kind == WASM_EXTERN_FUNC {
                if seen == index -> return Val(entry.type_index)
                seen += 1
            }
        }
        defined: index - seen
        if defined < 0 || defined >= self.funcs.len() -> return None
        Val(self.funcs[defined])
    }

    function_count: fn(self) -> Int Never! {
        self.imported(WASM_EXTERN_FUNC) + self.funcs.len()
    }

    // The table type of `index` in the table index space.
    table_type: fn(self, index: Int) -> WasmTableType? {
        seen := 0
        loop entry in self.imports {
            if entry.kind == WASM_EXTERN_TABLE {
                if seen == index -> return entry.table
                seen += 1
            }
        }
        defined: index - seen
        if defined < 0 || defined >= self.tables.len() -> return None
        Val(self.tables[defined])
    }

    table_count: fn(self) -> Int Never! {
        self.imported(WASM_EXTERN_TABLE) + self.tables.len()
    }

    memory_count: fn(self) -> Int Never! {
        self.imported(WASM_EXTERN_MEMORY) + self.memories.len()
    }

    global_type: fn(self, index: Int) -> WasmGlobalType? {
        seen := 0
        loop entry in self.imports {
            if entry.kind == WASM_EXTERN_GLOBAL {
                if seen == index -> return entry.global
                seen += 1
            }
        }
        defined: index - seen
        if defined < 0 || defined >= self.globals.len() -> return None
        Val(self.globals[defined].ty)
    }

    global_count: fn(self) -> Int Never! {
        self.imported(WASM_EXTERN_GLOBAL) + self.globals.len()
    }

    export_named: fn(self, name: String) -> WasmExport? {
        loop entry in self.exports {
            if entry.name == name -> return Val(entry)
        }
        None
    }

    // The name a trap frame shows for function `index` ("" without a name section entry).
    function_name: fn(self, index: Int) -> String Never! {
        self.function_names.get(index) ?? ""
    }
}
