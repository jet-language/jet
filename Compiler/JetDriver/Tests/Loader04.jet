// Rust: crates/jet-driver/src/Loader.rs:5978
#Test("staged_frontend_is_bounded_and_deterministic") {
    first :: OSPath.from("/virtual/z.jet")
    second :: OSPath.from("/virtual/a.jet")
    overlays :: [(first, "fn z() -> Int { return 1 }\n"), (second, "fn a() -> Int { return 2 }\n")]
    prepared :: prepare_overlay_frontend(overlays)
    assert(frontend_worker_count(MAX_FRONTEND_WORKERS.saturating_mul(2)) <= MAX_FRONTEND_WORKERS,
        "frontend fan-out must stay bounded for a source batch larger than the cap")
    assert_eq(prepared.len(), overlays.len())
    assert(if prepared.get(normalize_path(first)).map(fn(entry) { entry.module }) == { Val(.Parsed(_, _)) -> true else -> false })
    assert(if prepared.get(normalize_path(second)).map(fn(entry) { entry.module }) == { Val(.Parsed(_, _)) -> true else -> false })
}
// Rust: crates/jet-driver/src/Loader.rs:6008
#Test("staged_frontend_production_path_preserves_success_and_failure") {
    dir :: tempdir("staged-frontend-production")
    entry :: dir.join("main.jet")
    dependency :: dir.join("dep.jet")
    entry_source :: "module dep\nfn run() -> Int { return dep.value() }\n"
    valid_dependency :: "pub fn value() -> Int { return 7 }\n"
    fs.write(entry, entry_source).unwrap()
    fs.write(dependency, valid_dependency).unwrap()
    overlays :: [(entry, entry_source), (dependency, valid_dependency)]
    (loaded, _, diagnostics) :: load_entry_with_overlays_and_dependencies_with_diagnostics(entry.to_str().unwrap(), overlays, true)
    assert(loaded.is_ok(), "valid staged batch failed: {diagnostics:?}")
    assert(diagnostics.is_empty(), "valid staged batch diagnosed: {diagnostics:?}")
    invalid_dependency :: "pub fn value() -> Int { return 7 }\n::\n"
    invalid_overlays :: [(entry, entry_source), (dependency, invalid_dependency)]
    (invalid_loaded, _, invalid_diagnostics) :: load_entry_with_overlays_and_dependencies_with_diagnostics(entry.to_str().unwrap(), invalid_overlays, true)
    assert(invalid_loaded.is_err(), "malformed staged batch unexpectedly loaded")
    assert(invalid_diagnostics.iter().any(fn(diagnostic) { diagnostic.diagnostic.code == "E0003" }),
        "malformed staged batch lost parser diagnostic: {invalid_diagnostics:?}")
    _ :: fs.remove_dir_all(dir)
}
