// Rust: crates/jet-driver/src/Loader.rs:5864
fn tempdir(tag: String) -> OSPath {
    base := env.temp_dir()
    loop {
        has_repository :: find_repository_root(base).is_some()
        has_workspace :: find_workspace_root_checked(base).map(fn(root) { root.is_some() }).unwrap_or(true)
        has_package :: find_package_root_checked(base).map(fn(root) { root.is_some() }).unwrap_or(true)
        if !has_repository && !has_workspace && !has_package -> break
        base = base.parent().expect("could not find an authority-free temp directory for loader tests").to_path_buf()
    }
    // GATE #4494: native clock and thread identity primitives.
    nanos :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()
    path :: base.join("loader-stale-manifest-{tag}-{nanos}-{thread.current().id():?}")
    fs.create_dir_all(path).unwrap()
    path
}

// Rust: crates/jet-driver/src/Loader.rs:5896
#Test("selected_project_root_prefers_repository_over_nested_package") {
    repository :: tempdir("selected-repository")
    source :: repository.join("packages/app/src")
    fs.create_dir_all(source).unwrap()
    fs.create_dir(repository.join(".git")).unwrap()
    fs.write(repository.join("packages/app").join(Syntax.PACKAGE_FILE), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    assert_eq(selected_project_root(source).unwrap(), fs.canonicalize(repository).unwrap())
    _ :: fs.remove_dir_all(repository)
}
// Rust: crates/jet-driver/src/Loader.rs:5915
#Test("selected_project_root_preserves_nested_workspace_precedence") {
    repository :: tempdir("selected-workspace")
    workspace :: repository.join("nested")
    source :: workspace.join("packages/app/src")
    fs.create_dir_all(source).unwrap()
    fs.create_dir(repository.join(".git")).unwrap()
    fs.write(repository.join(Syntax.PACKAGE_FILE), "name: \"repository\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(workspace.join("workspace.jet"), "module workspace { members: [\"./packages/app\"] }\n").unwrap()
    fs.write(workspace.join("packages/app").join(Syntax.PACKAGE_FILE), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    assert_eq(selected_project_root(source).unwrap(), fs.canonicalize(workspace).unwrap())
    _ :: fs.remove_dir_all(repository)
}
