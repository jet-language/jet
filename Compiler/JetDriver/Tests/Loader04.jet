// Rust: crates/jet-driver/src/Loader.rs:6157
#Test("explicit_shared_package_manifest_needs_reach_bundle_and_core_usage") {
    // GATE #4483 / #4494: cfg(unix) and native Unix permissions.
    if target.selected_family() == "unix" {
        dir :: tempdir("shared-package-authority")
        entry :: dir.join(Syntax.DEFAULT_ENTRY_FILE)
        source :: "use core.font as font\nfn run() {\n    face :: font.system(.Body)\n    _shaped :: font.shape(\"x\", face)\n}\n"
        manifest :: "name: \"fixture\"\nversion: \"0.1.0\"\nauthority: {\n    holds: { allow: [IO] },\n    needs: [UI.FontShaping]\n}\n"
        fs.write(dir.join(Syntax.PACKAGE_FILE), manifest).unwrap()
        fs.write(entry, source).unwrap()
        fs.set_permissions(dir, fs.Permissions.from_mode(0o777)).unwrap()
        expected_root :: fs.canonicalize(dir).unwrap()
        assert_eq(find_manifest_root_checked(dir).unwrap(), Val(expected_root))
        facts :: package_facts_for_entry(entry).unwrap().expect("explicit package manifest should load")
        assert_eq(facts.authority.needs, ["UI.FontShaping"])
        bundle := load_entry(entry.to_str().unwrap()).expect("bundle should load")
        bundle_facts :: package_facts_for_bundle(bundle).unwrap().expect("bundle package manifest should load")
        assert_eq(bundle_facts.authority.needs, ["UI.FontShaping"])
        assert_eq(bundle.package_guarantees.authority_needs, ["UI.FontShaping"])
        assert(bundle.package_guarantees.application_authority.granted_effects.contains("IO"), "authority.holds.allow must remain the execution grant")
        diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
        assert(!diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E2937" }), "declared UI.FontShaping must satisfy CoreUsage: {diagnostics:?}")
        fs.write(dir.join(Syntax.PACKAGE_FILE), "name: \"fixture\"\nversion: \"0.1.0\"\nauthority: {\n    holds: { allow: [IO] }\n}\n").unwrap()
        omitted_bundle := load_entry(entry.to_str().unwrap()).expect("bundle without needs should load")
        assert(omitted_bundle.package_guarantees.authority_needs.is_empty())
        omitted_diagnostics :: Sema.check_bundle(&omitted_bundle, Sema.CompileMode.Run)
        assert(omitted_diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E2937" }), "omitting UI.FontShaping must retain E2937: {omitted_diagnostics:?}")
        fs.set_permissions(dir, fs.Permissions.from_mode(0o700)).unwrap()
        _ :: fs.remove_dir_all(dir)
    }
}
// Rust: crates/jet-driver/src/Loader.rs:6234
#Test("file_import_rejects_physical_symlink_escape_as_e0603") {
    // GATE #4483 / #4494: cfg(unix), native symlink primitive.
    if target.selected_family() == "unix" {
        root :: tempdir("file-import-symlink")
        outside :: tempdir("file-import-symlink-outside")
        entry :: root.join("run.jet")
        fs.write(entry, "use \"./escape\" as escape\nfn run() {}\n").unwrap()
        fs.write(outside.join("secret.jet"), "pub fn fixture() {}\n").unwrap()
        fs.symlink(outside.join("secret.jet"), root.join("escape.jet")).unwrap()
        diagnostics :: load_entry(entry.to_str().unwrap()).unwrap_err()
        assert(diagnostics.iter().any(fn(diagnostic) {
            diagnostic.code == "E1334" && diagnostic.what.to_ascii_lowercase().contains("symlink") && diagnostic.what.contains("escape.jet")
        }), "{diagnostics:#?}")
    }
}
// Rust: crates/jet-driver/src/Loader.rs:6256
#Test("explicit_project_import_keeps_internal_module_available") {
    dir :: tempdir("internal-module")
    entry :: dir.join("main.jet")
    fs.write(entry, "use project._bench as bench\nfn run() { bench.fixture() }\n").unwrap()
    fs.write(dir.join("arbitrary.jet"), "module _bench { }\npub fn fixture() {}\n").unwrap()
    (diagnostics, maybe_bundle) :: Driver.check_file(entry.to_str().unwrap(), None, false)
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    bundle :: maybe_bundle.unwrap()
    assert(bundle.modules.iter().any(fn(module) { module.path == dir.join("arbitrary.jet") }))
}
// Rust: crates/jet-driver/src/Loader.rs:6280
#Test("explicit_project_import_propagates_invalid_target_diagnostics") {
    loop (tag, broken) in [("lex", "module _bench { }\n§\n"), ("parse", "module _bench { }\nfn broken(\n")] {
        dir :: tempdir("internal-module-{tag}")
        entry :: dir.join("main.jet")
        fs.write(entry, "use project._bench\nfn run() {}\n").unwrap()
        fs.write(dir.join("broken.jet"), broken).unwrap()
        diagnostics :: load_entry(entry.to_str().unwrap()).unwrap_err()
        assert(diagnostics.iter().any(fn(diagnostic) {
            diagnostic.code == "E0603" && diagnostic.what.contains("project module `project._bench`") &&
                diagnostic.what.contains("broken.jet") && diagnostic.span.is_some()
        }), "{diagnostics:#?}")
    }
}
// Rust: crates/jet-driver/src/Loader.rs:6304
#Test("unrelated_invalid_file_does_not_mask_missing_project_module") {
    dir :: tempdir("internal-module-unrelated-invalid")
    entry :: dir.join("main.jet")
    fs.write(entry, "use project._bench\nfn run() {}\n").unwrap()
    fs.write(dir.join("broken.jet"), "module _other { }\n§\n").unwrap()
    diagnostics :: load_entry(entry.to_str().unwrap()).unwrap_err()
    assert(diagnostics.iter().any(fn(diagnostic) {
        diagnostic.code == "E0603" && diagnostic.what == "Can't find a project module named `project._bench`"
    }), "{diagnostics:#?}")
}
// Rust: crates/jet-driver/src/Loader.rs:6321
#Test("explicit_project_import_rejects_duplicate_internal_declarations") {
    dir :: tempdir("internal-module-conflict")
    entry :: dir.join("main.jet")
    fs.write(entry, "use project._bench as bench\nfn run() {}\n").unwrap()
    fs.write(dir.join("a.jet"), "module _bench { }\n").unwrap()
    fs.write(dir.join("b.jet"), "module _bench { }\n").unwrap()
    diagnostics :: load_entry(entry.to_str().unwrap()).unwrap_err()
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0606" && diagnostic.span.is_some() }))
}
// Rust: crates/jet-driver/src/Loader.rs:6336
#Test("duplicate_internal_declarations_fail_without_an_explicit_import") {
    dir :: tempdir("internal-module-unimported-conflict")
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {}\n").unwrap()
    fs.write(dir.join(Syntax.PACKAGE_FILE), "name: \"fixture\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join("a.jet"), "module _bench { }\n").unwrap()
    fs.write(dir.join("b.jet"), "module _bench { }\n").unwrap()
    diagnostics :: load_entry(entry.to_str().unwrap()).unwrap_err()
    assert(diagnostics.iter().any(fn(diagnostic) {
        diagnostic.code == "E0606" && diagnostic.span.is_none() && diagnostic.fix.contains("a.jet, b.jet")
    }))
}
