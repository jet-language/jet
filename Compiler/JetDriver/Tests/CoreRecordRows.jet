// Assemble with the Compiler source unit. A Core record written from a real
// check (every Core body of the Prelude, as `jet self devtools core-record`
// checks it) decodes: each row reads back from its record tree (JetFoundation
// RecordTree.jet) and encodes to the tree it was read from, it holds every
// comptime value the check landed on a Core module, each Core module's
// Core usage as the check walked it and each Core module's taint crossings,
// and each symbol range reads back with the keys the check reserved.
use {
    jet_driver.[
        JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode, JetDriverCompileRequest, JetDriverCoreSource, jet_driver_core_record_body_key, jet_driver_core_record_module,
        jet_driver_core_record_module_first_body, jet_driver_core_record_open, jet_driver_core_record_round_trip, jet_driver_core_record_symbol_keys,
        jet_driver_core_record_crossings, jet_driver_core_record_symbol_rows, jet_driver_core_record_symbols, jet_driver_core_record_usage, jet_driver_core_record_values, jet_driver_core_record_write,
        jet_driver_has_errors, jet_driver_lowering_inputs,
    ]
    jet_cli.[jet_cli_driver_request]
    jet_foundation.[ModuleID, symbol_keys, symbol_keys_intern]
    jet_sema.[sema_registration_reserved_symbols]
}

core_record_rows_request: fn() -> JetDriverCompileRequest {
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/core-record-fixture",
            identity: "core-record-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/core-record-fixture/main.jet", relative_path: "main.jet", identity: "core-record-file", source: "run: fn() {{ print(\"record\") }}"}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "core-record-root",
        entry_path: "/core-record-fixture/main.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Check)
    request.every_core_body = true
    request
}

#Test("a Core record written from a real check reads every row back") {
    front := jet_driver_lowering_inputs(core_record_rows_request(), None)
    assert(front.compile.internal_problem == None)
    assert(!jet_driver_has_errors(front.compile.diagnostics))
    inputs := front.inputs.move() ?? panic("the check stopped before lowering")
    core_modules := [U32:Bool]{}
    recorded := [ModuleID]{}
    loop module_row in inputs.modules {
        if module_row.module_identity == inputs.entry_module_identity -> next
        core_modules[module_row.module_identity.id] = true
        recorded.push(module_row.module_identity)
    }
    reserved: sema_registration_reserved_symbols(inputs.symbols, recorded)
    landed := 0
    loop value in inputs.comptime_values {
        if core_modules.get(value.module_identity.id) != None -> landed += 1
    }
    assert(landed > 0)
    bytes: jet_driver_core_record_write(inputs, "fixture", "x86_64-unknown-linux-gnu") ?? panic("the record can't be written: {err}")
    counts: jet_driver_core_record_round_trip(bytes) ?? panic("the record doesn't read back: {err}")
    assert(counts.modules > 0)
    assert(counts.bodies > 0)
    assert_eq(counts.values, landed)
    assert_eq(counts.bytes, bytes.len())
    record: jet_driver_core_record_open(bytes) ?? panic("the record doesn't open: {err}")
    row: jet_driver_core_record_module(record, 0) ?? panic("the first module row doesn't decode: {err}")
    assert_eq(row.module_name, record.module_names[0])
    assert(row.module_identity == record.module_identities[0])
    held := 0
    loop index in 0..<record.module_names.len() {
        values: jet_driver_core_record_values(record, index) ?? panic("module {index}'s value rows don't decode: {err}")
        loop value in values -> assert(value.module_identity == record.module_identities[index])
        held += values.len()
    }
    assert_eq(held, landed)
    usage_at := [U32:Int]{}
    loop (index, usage) in inputs.core_usage -> usage_at[usage.module_identity.id] = index
    loop index in 0..<record.module_names.len() {
        usage: jet_driver_core_record_usage(record, index) ?? panic("module {index}'s usage row doesn't decode: {err}")
        at: usage_at.get(record.module_identities[index].id) ?? panic("module {index} has no Core usage in the check")
        assert_eq("{usage:Debug}", "{inputs.core_usage[at]:Debug}")
    }
    crossing_at := [U32:Int]{}
    loop (index, crossings) in inputs.core_crossings -> crossing_at[crossings.module_identity.id] = index
    crossed := 0
    loop index in 0..<record.module_names.len() {
        crossings: jet_driver_core_record_crossings(record, index) ?? panic("module {index}'s crossing row doesn't decode: {err}")
        at: crossing_at.get(record.module_identities[index].id) ?? panic("module {index} has no taint crossings in the check")
        assert_eq("{crossings:Debug}", "{inputs.core_crossings[at]:Debug}")
        assert(crossings.tags.contains("Secret"))
        crossed += crossings.rows.len()
    }
    // Some Core function branches on a parameter, so a fixed value passed
    // there has a path.
    assert(crossed > 0)
    symbols: jet_driver_core_record_symbols(record, recorded) ?? panic("the record's symbol keys don't read: {err}")
    assert_eq(symbols.len(), reserved.len())
    loop (index, keys) in reserved {
        assert_eq(symbols[index].base, keys.base)
        assert(symbols[index].keys.texts == keys.keys.texts)
    }
    // A compile that takes no module reads the serial ranges' keys alone.
    bare: jet_driver_core_record_symbols(record, [ModuleID]{}) ?? panic("the record's serial symbol keys don't read: {err}")
    loop (index, keys) in bare {
        assert_eq(keys.base, reserved[index].base)
        serial: Int{keys.module_identity.id} == 0
        if !serial -> assert_eq(keys.keys.texts.len(), 1)
    }
    first: jet_driver_core_record_body_key(record, 0) ?? panic("the first body key doesn't read: {err}")
    assert_eq(jet_driver_core_record_module_first_body(record, first.owner) ?? panic("no first body: {err}"), 0)
}

#Test("symbol keys read back from their parts") {
    keys := symbol_keys(100, 120)
    texts: [String]{
        "type:<corelib>/app::AppError",
        "impl:<corelib>/app:type:<corelib>/app::AppError:AppError::Equatable<AppError>",
        "function:<corelib>/app:impl:<corelib>/app:type:<corelib>/app::AppError:AppError::Equatable<AppError>:equal",
        "parameter:<corelib>/app:function:<corelib>/app:impl:<corelib>/app:type:<corelib>/app::AppError:AppError::Equatable<AppError>:equal:self",
        "function::Display:display",
        "trait:::Add",
        "module:<corelib>/text::",
    }
    loop text in texts -> _: symbol_keys_intern(keys, text)
    rows: jet_driver_core_record_symbol_rows(keys) ?? panic("the keys don't split: {err}")
    assert_eq(rows.owners, [String]{"Display"})
    assert_eq(rows.names[3], "self")
    read := symbol_keys(100, 120)
    count: jet_driver_core_record_symbol_keys(read, rows, 100) ?? panic("the keys don't read back: {err}")
    assert_eq(count, texts.len())
    assert(read.keys.texts == keys.keys.texts)
}
