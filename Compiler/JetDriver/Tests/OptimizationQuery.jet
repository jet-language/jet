// Assemble against production sources, replacing CLI Entry. No manufactured MIR.
fn optimization_query_require(ok: Bool, detail: String) Never! {
    if !ok -> panic("OptimizationQuery: {detail}")
}
fn optimization_query_request(triple: String) -> JetDriverCompileRequest {
    snapshot :: JetDriverAuthorizedSourceSnapshot{roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{canonical_path: "/optimization-query", identity: "optimization-root", allow_hardlinks: false, files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/optimization-query/run.jet", relative_path: "run.jet", identity: "optimization-source", source: "#Inline fn helper(value: Int) Int {{ value + 1 }}\nfn run() {{ answer :: helper(3); print(answer) }}"}}, foreign_cache_files: []}}, entry_root_identity: "optimization-root", entry_path: "/optimization-query/run.jet"}
    request := jet_cli_driver_request(snapshot, [], Val(1), JetDriverCompileMode.Doc)
    request.host_facts.target_triple = Val(triple)
    request.schema_snapshots = Val([String:SchemaSnapshot]{})
    request
}
fn run() {
    loop triple in ["x86_64-unknown-linux-gnu", "i686-unknown-linux-gnu"] {
        request := optimization_query_request(triple)
        request.profile = "selected-release"
        request.build_mode = MIRArtifactBuildMode.Release
        query :: jet_driver_optimization_query(^request)
        optimization_query_require(query.compile.complete && query.compile.internal_problem == None, "production check/lower/optimizer completes")
        optimization_query_require(query.compile.emitted_source == None && query.functions.len() > 0, "query never emits or executes")
        optimization_query_require(query.profile == "selected-release" && query.release_build && query.target_triple == triple, "selected profile/target provenance")
        layout :: query.target_layout ?? panic("OptimizationQuery: missing layout")
        optimization_query_require(layout.pointer_size == (if triple.starts_with("i686") -> 4 else -> 8), "selected target layout, not host width")
        ledger :: query.decisions ?? panic("OptimizationQuery: missing decision ledger")
        optimization_query_require(ledger.identity.profile == "selected-release" && ledger.identity.run == "not-observed", "no fabricated runtime observation")
        optimization_query_require(ledger.rows.len() > 0 && ledger.derivations.len() == ledger.rows.len(), "actual compiler decision producers")
        encoded :: mir_decision_ledger_json(ledger)
        decoded :: mir_decision_ledger_read(encoded) ?? panic("OptimizationQuery: canonical transport refused")
        optimization_query_require(mir_decision_ledger_json(decoded) == encoded, "same canonical transport for live/replay")
        forged :: encoded.replace("\"run\":\"not-observed\"", "\"run\":\"forged\"")
        optimization_query_require(mir_decision_ledger_read(forged) == .Err(_), "identity changes cannot reuse old derivation references")
        optimization_query_require(mir_decision_ledger_read("{encoded}\n") == .Err(_), "noncanonical bytes rejected")
        loop row in decoded.rows {
            optimization_query_require(row.identity == Val(decoded.identity) && row.derivation != None && row.evidence_method != None, "every row shares authenticated identity and derivation")
        }
    }
    broken := optimization_query_request("x86_64-unknown-linux-gnu")
    broken.authorized_sources.roots[0].files[0].source = "fn run() {{ missing_callable() }}"
    failed :: jet_driver_optimization_query(^broken)
    optimization_query_require(!failed.compile.complete && failed.decisions == None && failed.functions.len() == 0, "failed sema cannot publish plausible decisions")
}
