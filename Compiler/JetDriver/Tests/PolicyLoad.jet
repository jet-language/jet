// Assemble with Compiler/Bootstrap/sources.list, replacing the CLI entry.
// Exercise the real authorized loader; undefined calls deliberately prove that
// policy queries do not need semantic compilation of a program body.
fn policy_load_require(ok: Bool, detail: String) Never! {
    if !ok -> panic("PolicyLoad: {detail}")
}

fn policy_load_file(root: String, relative: String, source: String) -> JetDriverAuthorizedSourceFile Never! {
    JetDriverAuthorizedSourceFile{path: "{root}/{relative}", relative_path: relative, identity: "fixture:{root}/{relative}", source: source}
}

fn policy_load_request(roots: [JetDriverAuthorizedSourceRoot], entry_root: String, entry: String) -> JetDriverCompileRequest Never! {
    JetDriverCompileRequest{
        authorized_sources: JetDriverAuthorizedSourceSnapshot{roots: roots, entry_root_identity: entry_root, entry_path: entry},
        canonical_effect_source: "",
        core_sources: [JetDriverCoreSource]{},
        host_facts: JetDriverHostFacts{target_triple: None, active_os: None, compiler_identity: None},
        eval_config: jet_eval_default_config(),
        target: JetDriverCompileTarget.Native,
        record_store: None,
        trace_sink: None,
        mir_lint_every_pass: false,
        compiler_threads: compiler_threads_single(),
    }
}

fn policy_load_root(path: String, files: [JetDriverAuthorizedSourceFile]) -> JetDriverAuthorizedSourceRoot Never! {
    JetDriverAuthorizedSourceRoot{canonical_path: path, identity: path, allow_hardlinks: false, files: files, foreign_cache_files: [JetDriverAuthorizedSourceFile]{}}
}

fn policy_load_program(load: JetDriverLoadResult, path: String) -> Program Never! {
    loop module_row in load.modules {
        if load.source_units[module_row.source_unit_index].path == path -> return module_row.program
    }
    panic("PolicyLoad: missing module {path}")
}

fn policy_load_has_code(load: JetDriverLoadResult, code: String, what: String) -> Bool Never! {
    loop diagnostic in load.diagnostics {
        if diagnostic.code == code && diagnostic.what == what -> return true
    }
    false
}

fn run() Never! {
    build_scope := JetDriverBuildQueryScope{}
    policy_load_require(jet_driver_build_next_session_id(&build_scope) == Val(1) && jet_driver_build_next_session_id(&build_scope) == Val(2), "one command's package build invocations get distinct Source-owned identities")
    build_scope.next_session_id = 9223372036854775807
    policy_load_require(jet_driver_build_next_session_id(&build_scope) == None && build_scope.next_session_id == 9223372036854775807, "build authority identities never wrap or silently reuse an expired session")
    root :: "/policy-load"
    module_source :: "#Policy(copies: .Explicit)\nfn run() {{ #Policy(gc) {{ undefined_call() }} }}\n"
    package_source :: "name: \"policy_load\"\nversion: \"0.1.0\"\npolicy: {{ copies: .Explicit, gc: true, explicit_units: true, sentries: .On }}\n"
    request :: policy_load_request([policy_load_root(root, [
        policy_load_file(root, "package.jet", package_source),
        policy_load_file(root, "run.jet", module_source),
        policy_load_file(root, "sibling.jet", "#Policy(copies: .Explicit)\nfn helper() {{ unknown_sibling() }}\n"),
    ])], root, "{root}/run.jet")
    load :: jet_driver_load(request)
    policy_load_require(load.complete, "valid package/source chain loads without sema")
    policy_load_require(load.modules.len() == 2, "all package members load")
    program :: policy_load_program(load, "run.jet")
    policy_load_require(program.policy_declarations.len() == 6, "four package, module and block declarations")
    loop index in 0..<4 {
        declaration :: program.policy_declarations[index]
        policy_load_require(declaration.scope == PolicyScope.Package && declaration.source == "{root}/package.jet" && declaration.span == (Span{start: 0, end: 0}) && declaration.target == None, "canonical manifest provenance and zero span")
    }
    policy_load_require(program.policy_declarations[0].key == PolicyKey.Copies && program.policy_declarations[1].key == PolicyKey.ScopedGC && program.policy_declarations[2].key == PolicyKey.ExplicitUnits && program.policy_declarations[3].key == PolicyKey.Sentries, "package written order")
    module_policy :: program.policy_declarations[4]
    policy_load_require(module_policy.source == "run.jet" && module_policy.scope == PolicyScope.Module && module_policy.span == (Span{start: 0, end: 26}), "Rust module source/span")
    block_policy :: program.policy_declarations[5]
    policy_load_require(block_policy.source == "run.jet" && block_policy.scope == PolicyScope.Block && block_policy.target != None, "block source and target retained")
    resolved :: policy_resolve(PolicyKey.Copies, program.policy_declarations) ?? panic("PolicyLoad: copies resolution failed")
    copies :: resolved ?? panic("PolicyLoad: copies disappeared")
    policy_load_require(copies.provenance.len() == 2 && copies.value == PolicyValue.Explicit, "package/module effective provenance")
    sibling :: policy_load_program(load, "sibling.jet")
    policy_load_require(sibling.policy_declarations.len() == 5 && sibling.policy_declarations[4].source == "sibling.jet", "package chain is prepended independently to sibling")

    generated_request := request
    generated_request.generated_modules = [JetDriverGeneratedModule]{{package_identity: load.package_identity, name: "Generated", relative_path: "out.jet", source: "fn generated() {{ undefined_generated() }}\n"}}
    generated_load :: jet_driver_load(generated_request)
    policy_load_require(generated_load.complete && generated_load.modules.len() == 3, "selected generated package member loads without a disk file")
    virtual_path :: jet_driver_generated_module_path(load.package_identity, "out.jet")
    generated_program :: policy_load_program(generated_load, virtual_path)
    policy_load_require(generated_program.policy_declarations.len() == 4, "generated member retains the package policy chain")
    retained :: loop file in generated_load.source_files {
        if file.path == virtual_path -> break file.source == generated_request.generated_modules[0].source
    } ?? false
    policy_load_require(retained, "generated provenance retains exact immutable source bytes")
    inputs :: jet_driver_query_loaded_input_paths(generated_request)
    policy_load_require(inputs.complete && !inputs.paths.contains(virtual_path) && !inputs.comptime_input_coverage_complete, "virtual outputs do not pretend to be physical inputs or complete comptime read coverage")
    original_digest :: jet_driver_package_source_digest(load.packages[0], request, load.source_units) ?? panic("PolicyLoad: original source digest unavailable")
    generated_digest :: jet_driver_package_source_digest(generated_load.packages[0], generated_request, generated_load.source_units) ?? panic("PolicyLoad: generated source digest unavailable")
    policy_load_require(original_digest != generated_digest, "package source identity includes selected generated bytes")
    collision_request := generated_request
    collision_request.generated_modules[0].relative_path = "run.jet"
    collision_load :: jet_driver_load(collision_request)
    policy_load_require(!collision_load.complete && policy_load_has_code(collision_load, "E3502", "generated module `run.jet` aliases another source"), "generated outputs cannot replace an authorized disk source")

    // Loose imports retain nested display paths and never invent package rows.
    loose :: jet_driver_load(policy_load_request([policy_load_root(root, [
        policy_load_file(root, "run.jet", "use \"sub/helper\"\nfn run() {{ undefined_call() }}\n"),
        policy_load_file(root, "sub/helper.jet", "#Policy(copies: .Explicit)\nfn helper() {{ undefined_call() }}\n"),
    ])], root, "{root}/run.jet"))
    policy_load_require(loose.complete, "loose imported policy file loads")
    nested :: policy_load_program(loose, "sub/helper.jet")
    policy_load_require(nested.policy_declarations.len() == 1 && nested.policy_declarations[0].source == "sub/helper.jet", "nested display path, not parser placeholder or absolute path")

    inline_source :: "package {{ name: \"inline_policy\", version: \"0.1.0\", policy: {{ copies: .Explicit }} }}\n#Policy(copies: .Explicit)\nfn run() {{ undefined_call() }}\n"
    inline :: jet_driver_load(policy_load_request([policy_load_root(root, [policy_load_file(root, "script.jet", inline_source)])], root, "{root}/script.jet"))
    policy_load_require(inline.complete, "inline package uses same policy reader")
    inline_program :: policy_load_program(inline, "script.jet")
    policy_load_require(inline_program.policy_declarations.len() == 2 && inline_program.policy_declarations[0].source == "{root}/script.jet" && inline_program.policy_declarations[1].source == "script.jet", "inline physical carrier versus source display provenance")

    // Rust read_load carries the entry package's floor to dependency modules.
    dep_root :: "/policy-dependency"
    dependency :: jet_driver_load(policy_load_request([
        policy_load_root(root, [
            policy_load_file(root, "package.jet", "name: \"policy_load\"\nversion: \"0.1.0\"\ndeps: {{ dep: \"../policy-dependency\" }}\npolicy: {{ copies: .Explicit }}\n"),
            policy_load_file(root, "run.jet", "use dep\nfn run() {{ undefined_call() }}\n"),
        ]),
        policy_load_root(dep_root, [
            policy_load_file(dep_root, "package.jet", "name: \"dep\"\nversion: \"0.1.0\"\npolicy: {{ gc: true }}\n"),
            policy_load_file(dep_root, "lib.jet", "#Policy(copies: .Explicit)\nfn helper() {{ undefined_call() }}\n"),
        ]),
    ], root, "{root}/run.jet"))
    policy_load_require(dependency.complete, "dependency policy module loads")
    dep_program :: policy_load_program(dependency, "{dep_root}/lib.jet")
    policy_load_require(dep_program.policy_declarations.len() == 2 && dep_program.policy_declarations[0].key == PolicyKey.Copies && dep_program.policy_declarations[0].source == "{root}/package.jet" && dep_program.policy_declarations[1].source == "{dep_root}/lib.jet", "entry package floor and external absolute module display")

    // copy: the refusal variant edits its own request, and `request` is reused unchanged for the
    // malformed variant below.
    refusal_request := request.copy()
    refusal_request.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\nversion: \"0.1.0\"\npolicy: {{ sentries: .Off }}\n"
    refusal_request.authorized_sources.roots[0].files[1].source = "#Policy(sentries: .On)\nfn run() {{ undefined_call() }}\n"
    refusal_request.authorized_sources.roots[0].files[2].source = "fn helper() {{}}\n"
    refused :: jet_driver_load(refusal_request)
    policy_load_require(!refused.complete && policy_load_has_code(refused, "E0355", "Invalid effective `sentries` policy"), "module widening refuses before semantic checking")
    loop source in [
        "fn run() {{}}\n#Policy(sentries: .On) fn selected() {{ undefined_call() }}\n",
        "fn run() {{ #Policy(sentries: .On) {{ undefined_call() }} }}\n",
    ] {
        targeted := refusal_request
        targeted.authorized_sources.roots[0].files[1].source = source
        targeted_result :: jet_driver_load(targeted)
        policy_load_require(!targeted_result.complete && policy_load_has_code(targeted_result, "E0355", "Invalid effective `sentries` policy"), "function/block target chains include package floor")
    }

    malformed := request
    malformed.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\npolicy: {{ copies: false }}\n"
    policy_load_require(!jet_driver_load(malformed).complete, "canonical policy value refusal")
    malformed.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\npolicy: {{ copies: .Explicit }}\npolicy: {{ gc: true }}\n"
    policy_load_require(!jet_driver_load(malformed).complete, "duplicate policy block refusal")
    malformed.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\npolicy: {{ no_alloc: true }}\n"
    retired :: jet_driver_load(malformed)
    policy_load_require(!retired.complete && policy_load_has_code(retired, "E1206", "`package.jet` uses a retired memory floor"), "canonical retired floor diagnostic")
    malformed.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\npolicy: {{ trust: .Default }}\n"
    policy_load_require(!jet_driver_load(malformed).complete, "package-only surface still validates, never silently drops retired authority")
    malformed.authorized_sources.roots[0].files[0].source = "name: \"policy_load\"\npolicy: {{}}\n"
    policy_load_require(jet_driver_load(malformed).complete, "empty policy is not an implicit floor")
}
