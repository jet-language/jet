// The loader's syntactic Core demand: which spellings load core.encoding.
use {
    jet_driver.[JetDriverParseJob, jet_driver_has_errors, jet_driver_parse_one]
    jet_foundation.[compiler_threads_single]
}

fn jet_driver_test_codec_demand(source: String) -> Bool {
    parsed :: jet_driver_parse_one(JetDriverParseJob.Source{text: source}, compiler_threads_single())
    assert(!jet_driver_has_errors(parsed.parsed.diagnostics), "demand fixture parses")
    parsed.demand.codec_decode
}

#Test("a FieldError value or type alone does not load core.encoding; FieldError.under and decode<T> do") {
    plain :: "fn rejected(kind: String) -> Int [FieldError]! {{\n    Err([FieldError]{{FieldError{{path: \"\", reason: kind}}}})\n}}\n"
    assert(!jet_driver_test_codec_demand(plain), "a FieldError value is compiler-owned")
    framed :: "fn framed(inner: Int [FieldError]!) -> Int [FieldError]! {{\n    FieldError.under(\"port\", inner)\n}}\n"
    assert(jet_driver_test_codec_demand(framed), "FieldError.under lowers to the core.encoding helper")
    typed :: "fn typed(tree: Dyn) -> [Int] [FieldError]! {{\n    tree.decode<[Int]>()\n}}\n"
    assert(jet_driver_test_codec_demand(typed), "a generic decode lowers to the core.encoding helper")
}
