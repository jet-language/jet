    query_test_clean(&service.check_text_lsp(snapshot, main_path, source))
    changed := ~snapshot
    changed.request.authorized_sources.roots[0].files[1].source = "pub fn value() -> String { return \"changed\" }\n"
    assert(query_test_codes(&service.check_text_lsp(changed, main_path, source)).len() > 0)
    assert_eq(service.recompute_count(query_test_key(true)), 2)
}
#Test("repaired_import_invalidates_cached_load_failure") {
    source :: "module b\nfn run() { print(b.value() + 0) }\n"
    snapshot :: query_test_snapshot(source, [JetDriverAuthorizedSourceFile]{query_test_file("b.jet", "pub fn value() -> Int { return 1 }\n")})
    service := JetDriverCompilerQueries.new()
    main_path :: query_test_os_path.from_text("Main.jet", query_test_os_path.PathPlatform.Unix)
    query_test_clean(&service.check_text_lsp(snapshot, main_path, source))
    missing := ~snapshot
    _ := &missing.request.authorized_sources.roots[0].files.pop()
    missing.external_files = [JetDriverQueryExternalFile]{JetDriverQueryExternalFile{path: query_test_os_path.from_text("/query/b.jet", query_test_os_path.PathPlatform.Unix), state: JetDriverQueryFileState.Missing}, JetDriverQueryExternalFile{path: query_test_os_path.from_text("/query/b/module.jet", query_test_os_path.PathPlatform.Unix), state: JetDriverQueryFileState.Missing}}
    assert(query_test_codes(&service.check_text_lsp(missing, main_path, source)).contains("E0607"))
    repaired :: &service.check_text_lsp(snapshot, main_path, source)
    query_test_clean(repaired)
    query_test_parity(snapshot, source, repaired, true)
}
#Test("first_load_failure_tracks_import_for_repair") {
    source :: "module b\nfn run() { print(b.value() + 0) }\n"
    snapshot :: query_test_snapshot(source, [JetDriverAuthorizedSourceFile]{query_test_file("b.jet", "pub fn value() -> Int { return 1 }\n::\n")})
    service := JetDriverCompilerQueries.new()
    main_path :: query_test_os_path.from_text("Main.jet", query_test_os_path.PathPlatform.Unix)
