// Use-driven Core loading (CoreReach.jet): a Core module's private import
// loads only once reached code spells its alias as a path head; until then
// the import and every unreached declaration that spells its alias leave the
// module, so every tier sees the same closed program.
use {
    fs: core.files
    jet_driver.[
        JET_DRIVER_MEMBER_ROUTES,
        JET_DRIVER_ROUTED_MODULES,
        JET_DRIVER_SOURCE_ROUTES,
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileRequest,
        JetDriverCoreSource,
        JetDriverLoadResult,
        JetDriverLoadedModule,
        JetDriverParseJob,
        JetDriverScopedImport,
        jet_driver_blank_bytes,
        jet_driver_core_route,
        jet_driver_core_routes,
        jet_driver_core_text,
        jet_driver_has_errors,
        jet_driver_load,
        jet_driver_parse_one,
        jet_driver_reach,
        jet_driver_reach_admit,
        jet_driver_reach_defer,
        jet_driver_reach_drain,
        jet_driver_reach_global,
        jet_driver_reach_item_name,
        jet_driver_reach_parse_source,
        jet_driver_reach_strip,
        jet_driver_reach_wants,
        jet_driver_reach_word,
        jet_driver_scoped_imports,
    ]
    jet_cli.[jet_cli_driver_request]
    jet_foundation.[CORE_CALLS, CORE_SOURCE_OWNED_ROWS, Func, ModuleID, compiler_threads_single]
}

// A check request for the one user file `source`, with no Core sources yet.
reach_test_request: fn(source: String) -> JetDriverCompileRequest {
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{
            JetDriverAuthorizedSourceRoot{
                canonical_path: "/reach-fixture",
                identity: "reach-root",
                allow_hardlinks: false,
                files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/reach-fixture/main.jet", relative_path: "main.jet", identity: "reach-file", source: source}},
                foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
            },
        },
        entry_root_identity: "reach-root",
        entry_path: "/reach-fixture/main.jet",
    }
    jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Check)
}

// The load of `source` beside the Core module `core.devtools`, whose text is
// `owner`, and its cataloged part `__core_devtools_table`.
reach_test_load_owner: fn(source: String, owner: String) -> JetDriverLoadResult {
    request := reach_test_request(source)
    request.core_sources = [JetDriverCoreSource]{
        {module_name: "core.devtools", alias: "core_devtools", path: "Core/devtools-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text(owner)},
        {module_name: "__core_devtools_table", alias: "__core_devtools_table", path: "Core/devtools-reach-table.jet", owner: "core.devtools", owned_members: [String]{}, runtime: false, text: jet_driver_core_text("value: fn() -> Int Never! {{ 7 }}\n")},
    }
    jet_driver_load(request)
}

reach_test_load: fn(source: String) -> JetDriverLoadResult {
    // `lookup` is the only code that names the table part; a comment naming
    // it reaches nothing.
    owner: "use {{\n    table: __core_devtools_table\n}}\n\nplain: fn() -> Int Never! {{ 1 }}\n\n// lookup reads table.value\nlookup: fn() -> Int Never! {{ table.value() }}\n"
    load: reach_test_load_owner(source, owner)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics))
    load
}

reach_test_has_module: fn(load: JetDriverLoadResult, module_name: String) -> Bool Never! {
    loop module_row in load.modules {
        if module_row.module_name == module_name -> return true
    }
    false
}

reach_test_functions: fn(load: JetDriverLoadResult, module_name: String) -> [String] Never! {
    names := [String]{}
    loop module_row in load.modules {
        if module_row.module_name != module_name -> next
        loop item in module_row.program.items {
            if item == .Func(value) -> names.push(value.name)
        }
    }
    names
}

#Test("a Core part no reached code names is never loaded, and its only user leaves") {
    load: reach_test_load("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n")
    assert(reach_test_has_module(load, "core.devtools"))
    assert(!reach_test_has_module(load, "__core_devtools_table"))
    assert_eq(reach_test_functions(load, "core.devtools"), [String]{"plain"})
}

#Test("a Core part loads once reached code spells its alias, and an unreached function leaves its module") {
    load: reach_test_load("use tools: core.devtools\nrun: fn() {{ print(tools.lookup()) }}\n")
    assert(reach_test_has_module(load, "__core_devtools_table"))
    assert_eq(reach_test_functions(load, "core.devtools"), [String]{"lookup"})
    assert_eq(reach_test_functions(load, "__core_devtools_table"), [String]{"value"})
}

#Test("a string's text reaches nothing, and its interpolation reaches what it calls") {
    text: reach_test_load("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\nusage: fn() -> String {{ \"tools.lookup reads table.value\" }}\n")
    assert(!reach_test_has_module(text, "__core_devtools_table"))
    assert_eq(reach_test_functions(text, "core.devtools"), [String]{"plain"})
    interpolated: reach_test_load("use tools: core.devtools\nrun: fn() {{ print(\"value: {{tools.lookup()}}\") }}\n")
    assert(reach_test_has_module(interpolated, "__core_devtools_table"))
    assert_eq(reach_test_functions(interpolated, "core.devtools"), [String]{"lookup"})
}

#Test("a Core module's import of a part the catalog doesn't hold stops the load with E1001") {
    owner: "use {{\n    table: __core_devtools_table\n    probe: __core_devtools_probe\n}}\n\nplain: fn() -> Int Never! {{ 1 }}\n"
    load: reach_test_load_owner("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n", owner)
    assert(!load.complete)
    codes: loop diagnostic in load.diagnostics -> "{diagnostic.code}: {diagnostic.what}"
    assert_eq(codes, [String]{"E1001: There is no core module `__core_devtools_probe`"})
}

// The load of `source` beside `core.devtools`, which uses the runtime unit
// `core.devtools.runtime.kernel`; the kernel's `lookup` alone reads the
// runtime unit `core.devtools.runtime.table`.
reach_test_load_runtime: fn(source: String) -> JetDriverLoadResult {
    request := reach_test_request(source)
    owner: "use {{\n    kernel: core.devtools.runtime.kernel\n}}\n\nplain: fn() -> Int Never! {{ kernel.plain() }}\n\nlookup: fn() -> Int Never! {{ kernel.lookup() }}\n"
    kernel: "use {{\n    table: core.devtools.runtime.table\n}}\n\nplain: fn() -> Int Never! {{ 1 }}\n\nlookup: fn() -> Int Never! {{ table.value() }}\n"
    request.core_sources = [JetDriverCoreSource]{
        {module_name: "core.devtools", alias: "core_devtools", path: "Core/devtools-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text(owner)},
        {module_name: "core.devtools.runtime.kernel", alias: "__core_devtools_runtime_kernel", path: "Core/Devtools/Runtime/Kernel.jet", owner: "", owned_members: [String]{}, runtime: true, text: jet_driver_core_text(kernel)},
        {module_name: "core.devtools.runtime.table", alias: "__core_devtools_runtime_table", path: "Core/Devtools/Runtime/Table.jet", owner: "", owned_members: [String]{}, runtime: true, text: jet_driver_core_text("value: fn() -> Int Never! {{ 7 }}\n")},
    }
    load: jet_driver_load(request)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics))
    load
}

#Test("a runtime unit's functions and imports load by use like any Core module's") {
    plain: reach_test_load_runtime("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n")
    assert(!reach_test_has_module(plain, "core.devtools.runtime.table"))
    assert_eq(reach_test_functions(plain, "core.devtools.runtime.kernel"), [String]{"plain"})
    lookup: reach_test_load_runtime("use tools: core.devtools\nrun: fn() {{ print(tools.lookup()) }}\n")
    assert(reach_test_has_module(lookup, "core.devtools.runtime.table"))
    assert_eq(reach_test_functions(lookup, "core.devtools.runtime.kernel"), [String]{"lookup"})
}

reach_test_constants: fn(load: JetDriverLoadResult, module_name: String) -> [String] Never! {
    names := [String]{}
    loop module_row in load.modules {
        if module_row.module_name != module_name -> next
        loop item in module_row.program.items {
            if item == .Const(value) -> names.push(value.name)
        }
    }
    names
}

#Test("an unreached Core constant leaves its module with the declarations that name it") {
    owner: "plain: fn() -> Int Never! {{ 1 }}\n\nLIMIT: 3\n\nlimited: fn() -> Int Never! {{ LIMIT }}\n"
    plain: reach_test_load_owner("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n", owner)
    assert(plain.complete && !jet_driver_has_errors(plain.diagnostics))
    assert_eq(reach_test_constants(plain, "core.devtools"), [String]{})
    assert_eq(reach_test_functions(plain, "core.devtools"), [String]{"plain"})
    limited: reach_test_load_owner("use tools: core.devtools\nrun: fn() {{ print(tools.limited()) }}\n", owner)
    assert_eq(reach_test_constants(limited, "core.devtools"), [String]{"LIMIT"})
    assert_eq(reach_test_functions(limited, "core.devtools"), [String]{"limited"})
}

#Test("a Core constant read in another case stays, so its E1004 can suggest it") {
    owner: "plain: fn() -> Int Never! {{ 1 }}\n\nLIMIT: 3\n\nOTHER: 4\n"
    lower: reach_test_load_owner("use tools: core.devtools\nrun: fn() {{ print(tools.limit) }}\n", owner)
    assert_eq(reach_test_constants(lower, "core.devtools"), [String]{"LIMIT"})
    exact: reach_test_load_owner("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n", owner)
    assert_eq(reach_test_constants(exact, "core.devtools"), [String]{})
}

// The load of `source` beside `core.devtools`, whose `magnitude` alone calls
// `.abs` (a core.math receiver demand), and `core.math`.
reach_test_load_demand: fn(source: String) -> JetDriverLoadResult {
    request := reach_test_request(source)
    owner: "plain: fn() -> Int Never! {{ 1 }}\n\nmagnitude: fn(x: Int) -> Int Never! {{ x.abs() }}\n"
    request.core_sources = [JetDriverCoreSource]{
        {module_name: "core.devtools", alias: "core_devtools", path: "Core/devtools-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text(owner)},
        {module_name: "core.math", alias: "core_math", path: "Core/math-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text("two: fn() -> Int Never! {{ 2 }}\n")},
    }
    load: jet_driver_load(request)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics))
    load
}

#Test("a Core module's demand of another loads it only once reached code makes it, and its only maker leaves until then") {
    plain: reach_test_load_demand("use tools: core.devtools\nrun: fn() {{ print(tools.plain()) }}\n")
    assert(!reach_test_has_module(plain, "core.math"))
    assert_eq(reach_test_functions(plain, "core.devtools"), [String]{"plain"})
    magnitude: reach_test_load_demand("use tools: core.devtools\nrun: fn() {{ print(tools.magnitude(-3)) }}\n")
    assert(reach_test_has_module(magnitude, "core.math"))
    assert_eq(reach_test_functions(magnitude, "core.devtools"), [String]{"magnitude"})
}

// The load of `source` beside the one Core module `module_name`, whose text
// is `text` and whose cutover members are `owned`.
reach_test_load_module: fn(source: String, module_name: String, owned: [String], text: String) -> JetDriverLoadResult {
    request := reach_test_request(source)
    request.core_sources = [JetDriverCoreSource]{
        {module_name: module_name, alias: module_name.replace(".", "_"), path: "Core/reach-module.jet", owner: "", owned_members: owned, runtime: false, text: jet_driver_core_text(text)},
    }
    load: jet_driver_load(request)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics))
    load
}

#Test("a routed Core module's `__` helpers and F32 forms load by use, and its compiler routes always load") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\n__TABLE: 4\n\n__tabled: fn() -> Int Never! {{ __TABLE }}\n\n__WIDTH: 2.0\n\n__sin_f32: fn(x: Float) -> Float Never! {{ x * __WIDTH }}\n\n__RATIO: 3.0\n\nfabs: fn(x: Float) -> Float Never! {{ x * __RATIO }}\n"
    routed: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\n", "core.math", [String]{"__sin_f32", "fabs"}, text)
    assert_eq(reach_test_constants(routed, "core.math"), [String]{"__RATIO"})
    assert_eq(reach_test_functions(routed, "core.math"), [String]{"plain", "fabs"})
    // A call of `sin` (on an F32) runs its F32 form.
    narrow: reach_test_load_module("use m: core.math\nrun: fn(x: F32) {{ print(m.sin(x)) }}\n", "core.math", [String]{"__sin_f32", "fabs"}, text)
    assert_eq(reach_test_constants(narrow, "core.math"), [String]{"__WIDTH", "__RATIO"})
    assert_eq(reach_test_functions(narrow, "core.math"), [String]{"__sin_f32", "fabs"})
    // Any other module's `__` names stay routes as a group.
    grouped: reach_test_load_module("use m: core.devtools\nrun: fn() {{ print(m.plain()) }}\n", "core.devtools", [String]{}, text)
    assert_eq(reach_test_constants(grouped, "core.devtools"), [String]{"__TABLE", "__WIDTH", "__RATIO"})
}

// Each `.jet` file under `dir`, skipping test caches.
reach_test_sources: fn(dir: String, out: &[String]) {
    // copy: list_dir takes its path, and the panic text still names `dir`.
    entries: fs.list_dir(dir.copy()) ?? panic("cannot list {dir}: {err}")
    loop entry in entries {
        if entry.is_dir && entry.name == ".jet" -> next
        path: "{dir}/{entry.name}"
        if entry.is_dir -> reach_test_sources(path, out) else if entry.name.ends_with(".jet") {
            out.push(path)
        }
    }
}

// The text of the file at `path`.
reach_test_read: fn(path: String) -> String {
    // copy: read takes its path, and the panic text still names `path`.
    fs.read(path.copy()) ?? panic("cannot read {path}: {err}")
}

// A route the compiler spells as a `"__…"` literal right after a routed
// module's name (`sema_call_core_source("core.math", "__x", …)`,
// `module_name: "core.math", member: "__x"`) must be one of that module's
// routes, or its helper would leave the module unreached. A template
// (`"__{member}_f32"`) can't be read as a route, so a routed module's
// computed routes are spelled through functions jet_driver_core_route calls.
#Test("each `__` literal the compiler spells after a routed module's name is one of its routes") {
    files := [String]{}
    reach_test_sources("Compiler", files)
    failures := [String]{}
    checked := 0
    loop module_name in JET_DRIVER_ROUTED_MODULES {
        routes: jet_driver_core_routes(module_name)
        loop path in files {
            if !path.contains("/Source/") -> next
            text: reach_test_read(path)
            loop line in text.split("\n") {
                if !line.contains("\"{module_name}\"") -> next
                parts: line.split("\"").to_list()
                loop index in 1..<parts.len() {
                    if index % 2 == 0 || parts[index] != module_name || index + 2 >= parts.len() {
                        next
                    }
                    between: parts[index + 1].replace(" ", "")
                    if between != "," && between != ",name:" && between != ",member:" -> next
                    route: parts[index + 2]
                    if !route.starts_with("__") -> next
                    checked += 1
                    if !jet_driver_core_route(routes, route) -> failures.push("{path}: {route}")
                }
            }
        }
    }
    assert_eq(failures, [String]{})
    // The calls that route into core.math: the bit casts and the exact
    // types' crossing to Float. The Core call rows are computed from Core's
    // own declarations, so they spell no route here.
    assert(checked >= 4, "the scan found {checked} routes")
}

#Test("a unit's spellings come from its code tokens: a string spells only its interpolations, and comments spell nothing") {
    source: "plain: fn() -> Int Never! {{ other.value() }}\n\n// hidden\nLABEL: \"{{named}} quiet.text 9lives\"\n"
    parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: source, module_name: "core.devtools", owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
    words: parsed.words ?? panic("a Core unit has words")
    // One row per name that reaches a lazy declaration, then the rest, which
    // is empty. A constant is reached by its lowercase spelling too, and
    // that row holds the constant's own spellings.
    assert_eq(words.names, [String]{"plain", "LABEL", "label"})
    assert_eq(words.spells.len(), 4)
    assert_eq(words.spells[2], words.spells[1])
    assert_eq(words.spells[3].len(), 0)
    spelled := [String]{}
    loop row in 0..<2 {
        loop key in words.spells[row] -> spelled.push("{words.words[key >> 2]}/{key.bit_and(3)}")
    }
    assert_eq(spelled, [String]{"plain/0", "fn/0", "Int/0", "Never/0", "other/2", "value/1", "LABEL/0", "named/0"})
}

// The Core module `core.devtools`, whose `lookup` alone names its import,
// admitted to a reach alone with its import deferred; then reached code
// spells `reached`, the load follows the import if reached code wants it,
// and the reach strips the module.
reach_test_strip: fn(reached: String) -> JetDriverLoadedModule {
    owner: "use {{\n    table: __core_devtools_table\n}}\n\nplain: fn() -> Int Never! {{ 1 }}\n\nlookup: fn() -> Int Never! {{ table.value() }}\n"
    parsed := jet_driver_parse_one(JetDriverParseJob.Core{text: owner, module_name: "core.devtools", owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
    words := parsed.words.move() ?? panic("a Core unit has words")
    reach := jet_driver_reach(true)
    unit: jet_driver_reach_admit(reach, 0, "core.devtools", words.move(), parsed.parsed.program.imports, false)
    scoped := [JetDriverScopedImport]{}
    jet_driver_scoped_imports(parsed.parsed.program.imports, parsed.parsed.program.items, "", true, scoped)
    loop row in scoped -> jet_driver_reach_defer(reach, unit, row)
    word: jet_driver_reach_word(reach, reached)
    jet_driver_reach_global(reach, word)
    jet_driver_reach_drain(reach)
    assert_eq(jet_driver_reach_wants(reach, 0), reached == "lookup")
    // As the load does (Loader.jet): a wanted import's module loads, and
    // the import is followed.
    if jet_driver_reach_wants(reach, 0) -> reach.edges[0].followed = true
    modules := [JetDriverLoadedModule]{JetDriverLoadedModule{source_unit_index: 0, source_identity: "reach:core.devtools", package_identity: "core", module_identity: ModuleID{id: 0}, module_name: "core.devtools", program: parsed.parsed.program.move()}}
    jet_driver_reach_strip(reach, modules)
    modules.pop() ?? panic("the reach strips the one module")
}

#Test("a Core unit defers its import until reached code spells its alias") {
    // Unreached, `lookup` leaves with the import it names, and so does an
    // unreached `plain`.
    plain: reach_test_strip("plain")
    assert_eq(plain.program.imports.len(), 0)
    assert_eq(plain.program.items.len(), 1)
    looked: reach_test_strip("lookup")
    assert_eq(looked.program.imports.len(), 1)
    assert_eq(looked.program.items.len(), 1)
}

// `eprint` is a source route of core.term and `progress` one of its
// registry members: both stay, though the program never names them.
#Test("a Core module that isn't routed leaves each unreached function, but its `__` names and what the compiler calls by name stay") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\neprint: fn(label: String) -> Int Never! {{ label.len() }}\n\nprogress: fn(text: String) -> Int Never! {{ text.len() }}\n\n__click: fn() -> Int Never! {{ 2 }}\n\nunused: fn() -> Int Never! {{ 3 }}\n"
    load: reach_test_load_module("use t: core.term\nrun: fn() {{ print(t.plain()) }}\n", "core.term", [String]{"eprint", "progress"}, text)
    assert_eq(reach_test_functions(load, "core.term"), [String]{"plain", "eprint", "progress", "__click"})
}

#Test("a lazy routed Core unit parses only the declarations reached code names") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\n__TABLE: 4\n\nscaled: fn() -> Int Never! {{ __TABLE * 2 }}\n\nunused: fn() -> Int Never! {{ 9 }}\n"
    parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: "core.math", owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
    assert(!jet_driver_has_errors(parsed.parsed.diagnostics))
    words: parsed.words ?? panic("a Core unit has words")
    held := [String]{}
    loop declaration in words.held -> held.push(declaration.name)
    assert_eq(held, [String]{"plain", "__TABLE", "scaled", "unused"})
    // Each held declaration's place holds an empty stub until it is reached.
    loop item in parsed.parsed.program.items {
        if item == .Func(value) {
            assert(value.body.len() == 0 && value.return_type == None, "{value.name} is a stub")
        } else { panic("a held unit keeps only stubs here") }
    }
    load: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.scaled()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_functions(load, "core.math"), [String]{"scaled"})
    assert_eq(reach_test_constants(load, "core.math"), [String]{"__TABLE"})
    loop module_row in load.modules {
        if module_row.module_name != "core.math" -> next
        loop item in module_row.program.items {
            if item == .Func(value) {
                assert(value.body.len() == 1 && value.return_type != None, "{value.name} parsed whole")
            }
        }
    }
}

#Test("a plain `priv` function is held behind a stub as private as it, and parses whole once reached") {
    text: "plain: fn() -> Int Never! {{ helper() }}\n\npriv helper: fn() -> Int Never! {{ 1 }}\n\npriv unused: fn() -> Int Never! {{ 9 }}\n"
    parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: "core.math", owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
    assert(!jet_driver_has_errors(parsed.parsed.diagnostics))
    words: parsed.words ?? panic("a Core unit has words")
    held := [String]{}
    loop declaration in words.held -> held.push(declaration.name)
    assert_eq(held, [String]{"plain", "helper", "unused"})
    loop item in parsed.parsed.program.items {
        if item == .Func(value) {
            assert(value.is_pub == (value.name == "plain"), "{value.name}'s visibility")
        }
    }
    load: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_functions(load, "core.math"), [String]{"plain", "helper"})
    loop module_row in load.modules {
        if module_row.module_name != "core.math" -> next
        loop item in module_row.program.items {
            if item == .Func(value) && value.name == "helper" {
                assert(!value.is_pub && value.body.len() == 1, "helper parsed whole and private")
            }
        }
    }
}

reach_test_types: fn(load: JetDriverLoadResult, module_name: String) -> [String] Never! {
    names := [String]{}
    loop module_row in load.modules {
        if module_row.module_name != module_name -> next
        loop item in module_row.program.items {
            if item == .Struct(value) -> names.push(value.name)
            if item == .Enum(value) -> names.push(value.name)
        }
    }
    names
}

// The inherent methods of `type_name`, then each trait impl method as
// `Trait.method`.
reach_test_methods: fn(load: JetDriverLoadResult, module_name: String, type_name: String) -> [String] Never! {
    names := [String]{}
    loop module_row in load.modules {
        if module_row.module_name != module_name -> next
        loop item in module_row.program.items {
            if item == .Struct(value) && value.name == type_name {
                loop method in value.methods -> names.push(method.name)
                loop block in value.trait_impls {
                    loop method in block.methods -> names.push("{block.trait_name}.{method.name}")
                }
            }
        }
    }
    names
}

#Test("a routed module's types load by name, and each method once its type and its name are reached") {
    text: "Box: struct {{\n    width: Float\n\n    area: fn(self) -> Float Never! {{ self.width * self.width }}\n    spare: fn(self) -> Float Never! {{ self.width }}\n    __hidden: fn(self) -> Float Never! {{ 0.0 }}\n}}\n\nPad: struct {{\n    size: Float\n\n    area: fn(self) -> Float Never! {{ self.size }}\n}}\n\nmake: fn() -> Box Never! {{ Box{{width: 2.0}} }}\n"
    load: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make().area()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_types(load, "core.math"), [String]{"Box"})
    assert_eq(reach_test_methods(load, "core.math", "Box"), [String]{"area", "__hidden"})
    assert_eq(reach_test_functions(load, "core.math"), [String]{"make"})
    // A name reached before its type waits for it.
    named: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make()) }}\nlater: fn(pad: m.Pad) -> Float {{ pad.area() }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_types(named, "core.math"), [String]{"Box", "Pad"})
    assert_eq(reach_test_methods(named, "core.math", "Box"), [String]{"area", "__hidden"})
    assert_eq(reach_test_methods(named, "core.math", "Pad"), [String]{"area"})
}

#Test("a routed Core constant that only user comptime names still loads") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\nSCALE: 3.0\n\nOTHER: 4.0\n"
    load: reach_test_load_module("use m: core.math\nDOUBLE: #run {{ m.SCALE * 2.0 }}\nrun: fn() {{ print(DOUBLE) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_constants(load, "core.math"), [String]{"SCALE"})
    assert_eq(reach_test_functions(load, "core.math"), [String]{})
}

#Test("a routed type reached only through an alias keeps its trait impls, and a method only comptime calls still loads") {
    text: "Shape: trait {{\n    area: fn(self) -> Float Never!\n}}\n\nBox: struct {{\n    width: Float\n\n    spare: fn(self) -> Float Never! {{ self.width }}\n\n    impl Shape {{\n        area: fn(self) -> Float Never! {{ self.width * self.width }}\n    }}\n}}\n\nSquare: Box\n\nBoxes: [Box]\n\nmake: fn() -> Square Never! {{ Square{{width: 2.0}} }}\n"
    // `make` names only the bare-path alias `Square`; a trait call (`area`
    // through Shape) needs the impl, which stays with its type.
    aliased: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_types(aliased, "core.math"), [String]{"Box"})
    assert_eq(reach_test_constants(aliased, "core.math"), [String]{"Square"})
    assert_eq(reach_test_methods(aliased, "core.math", "Box"), [String]{"Shape.area"})
    // A type alias reaches its type the same way.
    listed: reach_test_load_module("use m: core.math\nkeep: fn(boxes: m.Boxes) -> Int {{ boxes.len() }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_types(listed, "core.math"), [String]{"Box"})
    assert_eq(reach_test_functions(listed, "core.math"), [String]{})
    // A method only user comptime calls loads with its type.
    timed: reach_test_load_module("use m: core.math\nWIDTH: #run m.make().spare()\nrun: fn() {{ print(WIDTH) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_methods(timed, "core.math", "Box"), [String]{"spare", "Shape.area"})
    assert_eq(reach_test_functions(timed, "core.math"), [String]{"make"})
}

// The load of `source` beside `core.math`, whose text is `math`, and
// `core.text`, whose text is `text`.
reach_test_load_pair: fn(source: String, math: String, text: String) -> JetDriverLoadResult {
    request := reach_test_request(source)
    request.core_sources = [JetDriverCoreSource]{
        {module_name: "core.math", alias: "core_math", path: "Core/math-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text(math)},
        {module_name: "core.text", alias: "core_text", path: "Core/text-reach.jet", owner: "", owned_members: [String]{}, runtime: false, text: jet_driver_core_text(text)},
    }
    load: jet_driver_load(request)
    assert(load.complete && !jet_driver_has_errors(load.diagnostics))
    load
}

#Test("a Core impl of another module's trait loads only once its type and its trait are both reached") {
    math: "use {{\n    shape: core.text\n}}\n\nBox: struct {{\n    width: Float\n\n    impl shape.Shape {{\n        area: fn(self) -> Float Never! {{ self.width * self.width }}\n    }}\n}}\n\nmake: fn() -> Box Never! {{ Box{{width: 2.0}} }}\n\nplain: fn() -> Int Never! {{ 1 }}\n"
    text: "Shape: trait {{\n    area: fn(self) -> Float Never!\n}}\n\nlabel: fn() -> Int Never! {{ 3 }}\n"
    // The type alone: the impl stays out, and so does the trait's module it
    // alone would import.
    typed: reach_test_load_pair("use m: core.math\nrun: fn() {{ print(m.make().width) }}\n", math, text)
    assert_eq(reach_test_types(typed, "core.math"), [String]{"Box"})
    assert_eq(reach_test_methods(typed, "core.math", "Box"), [String]{})
    assert(!reach_test_has_module(typed, "core.text"))
    // The type and the trait's module: the impl loads.
    both: reach_test_load_pair("use m: core.math\nuse t: core.text\nrun: fn() {{\n    print(m.make().width)\n    print(t.label())\n}}\n", math, text)
    assert(reach_test_has_module(both, "core.text"))
    assert_eq(reach_test_methods(both, "core.math", "Box"), [String]{"shape.Shape.area"})
    // The trait's module alone: the type, and its impl with it, stay out.
    traited: reach_test_load_pair("use m: core.math\nuse t: core.text\nrun: fn() {{\n    print(m.plain())\n    print(t.label())\n}}\n", math, text)
    assert_eq(reach_test_types(traited, "core.math"), [String]{})
    assert_eq(reach_test_functions(traited, "core.math"), [String]{"plain"})
}

#Test("a Core type's codec impl loads only once reached code names the codec trait or calls its verb") {
    text: "Box: struct {{\n    width: Float\n\n    impl Encode {{\n        encode: fn(self) -> Dyn {{ Dyn.Text(\"box\") }}\n    }}\n}}\n\nmake: fn() -> Box Never! {{ Box{{width: 2.0}} }}\n\nplain: fn() -> Int Never! {{ 1 }}\n"
    typed: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make().width) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_methods(typed, "core.math", "Box"), [String]{})
    called: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make().encode()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_methods(called, "core.math", "Box"), [String]{"Encode.encode"})
    named: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.make().width) }}\nwrap: fn(value: Encode) -> Encode {{ value }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_methods(named, "core.math", "Box"), [String]{"Encode.encode"})
    // The verb without the type reaches no impl.
    untyped: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\nwrap: fn(value: Encode) -> Dyn {{ value.encode() }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_types(untyped, "core.math"), [String]{})
}

#Test("a routed module's precise family loads with its type, and an imaginary literal reaches Complex") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\nFraction: struct {{\n    n: Int\n}}\n\n__fraction_add: fn(a: Fraction) -> Fraction Never! {{ a }}\n\nComplex: struct {{\n    re: Float\n}}\n\n__complex_add: fn(a: Complex) -> Complex Never! {{ a }}\n"
    // The two family members are core.math registry members this text owns.
    owned: [String]{"__fraction_add", "__complex_add"}
    plain: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\n", "core.math", owned, text)
    assert_eq(reach_test_types(plain, "core.math"), [String]{})
    assert_eq(reach_test_functions(plain, "core.math"), [String]{"plain"})
    // Any Fraction value runs the Fraction family.
    fraction: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\nkeep: fn(f: m.Fraction) -> m.Fraction {{ f }}\n", "core.math", owned, text)
    assert_eq(reach_test_types(fraction, "core.math"), [String]{"Fraction"})
    assert_eq(reach_test_functions(fraction, "core.math"), [String]{"plain", "__fraction_add"})
    // `4i` is a Complex, as Sema types it.
    imaginary: reach_test_load_module("use m: core.math\nrun: fn() {{ print(4i) }}\n", "core.math", owned, text)
    assert_eq(reach_test_types(imaginary, "core.math"), [String]{"Complex"})
    assert_eq(reach_test_functions(imaginary, "core.math"), [String]{"__complex_add"})
}

#Test("what a Core module's dropped tests spell reaches nothing") {
    text: "plain: fn() -> Int Never! {{ 1 }}\n\nsecret: fn() -> Int Never! {{ 2 }}\n\n#Test(\"secret is two\") {{\n    assert_eq(secret(), 2)\n}}\n"
    load: reach_test_load_module("use m: core.math\nrun: fn() {{ print(m.plain()) }}\n", "core.math", [String]{}, text)
    assert_eq(reach_test_functions(load, "core.math"), [String]{"plain"})
}

// Counts the methods of `methods` whose names the compiler spells as a
// literal, and adds to `missing` each one JET_DRIVER_MEMBER_ROUTES lacks.
reach_test_spelled_methods: fn(methods: [Func], literals: [String:Bool], found: &[String], missing: &[String]) Never! {
    loop method in methods {
        if method.name.starts_with("__") || literals.get(method.name) == None -> next
        if !found.contains(method.name) -> found.push(method.name)
        if !JET_DRIVER_MEMBER_ROUTES.contains(method.name) && !missing.contains(method.name) {
            missing.push(method.name)
        }
    }
}

// The compiler may look a method up by a name it spells as a literal (a
// handle route's `"cross"`), so a routed module's type keeps each such
// method; JET_DRIVER_MEMBER_ROUTES holds exactly those names.
#Test("each inherent method of a routed module's types that the compiler spells as a literal stays with its type") {
    files := [String]{}
    reach_test_sources("Compiler", files)
    literals := [String:Bool]{}
    loop path in files {
        if !path.contains("/Source/") -> next
        text: reach_test_read(path)
        loop line in text.split("\n") {
            parts: line.split("\"").to_list()
            loop index in 0..<parts.len() {
                if index % 2 == 1 -> literals[parts[index]] = true
            }
        }
    }
    found := [String]{}
    missing := [String]{}
    loop module_name in JET_DRIVER_ROUTED_MODULES {
        loop row in CORE_SOURCE_OWNED_ROWS {
            if row.module_name != module_name || row.owner != "" -> next
            text: reach_test_read(row.path)
            parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: module_name, owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
            loop item in parsed.parsed.program.items {
                if item == .Struct(value) {
                    reach_test_spelled_methods(value.methods, literals, found, missing)
                }
                if item == .Enum(value) {
                    reach_test_spelled_methods(value.methods, literals, found, missing)
                }
            }
        }
    }
    assert_eq(missing, [String]{})
    stale := [String]{}
    loop name in JET_DRIVER_MEMBER_ROUTES {
        if !found.contains(name) -> stale.push(name)
    }
    assert_eq(stale, [String]{})
}

// Each name the compiler spells as a string literal right after a Core
// module's name (`"core.compute", "matmul"`, `name: "…"`, `member: "…"`),
// as `module.name`.
reach_test_spelled_pairs: fn(files: [String]) -> [String] {
    pairs := [String]{}
    loop path in files {
        if !path.contains("/Source/") -> next
        text: reach_test_read(path)
        loop line in text.split("\n") {
            if !line.contains("\"core.") -> next
            parts: line.split("\"").to_list()
            loop index in 1..<parts.len() {
                if index % 2 == 0 || !parts[index].starts_with("core.") || index + 2 >= parts.len() {
                    next
                }
                between: parts[index + 1].replace(" ", "")
                if between != "," && between != ",name:" && between != ",member:" -> next
                pair: "{parts[index]}.{parts[index + 2]}"
                if !pairs.contains(pair) -> pairs.push(pair)
            }
        }
    }
    pairs
}

// Whether `name` is one of `module_name`'s registry members, which are
// routes of a module that isn't routed.
reach_test_registry_member: fn(module_name: String, name: String) -> Bool {
    loop row in CORE_CALLS {
        if row.module_name == module_name && row.member == name -> return true
    }
    false
}

// A Core module that isn't routed leaves each top-level function no reached
// code names, so one the compiler calls by a literal name must be a route:
// JET_DRIVER_SOURCE_ROUTES holds exactly those of the compiler's sources
// that aren't registry members.
#Test("each top-level Core function the compiler calls by a literal name right after its module's is a source route") {
    files := [String]{}
    reach_test_sources("Compiler", files)
    pairs: reach_test_spelled_pairs(files)
    found := [String]{}
    missing := [String]{}
    loop row in CORE_SOURCE_OWNED_ROWS {
        if JET_DRIVER_ROUTED_MODULES.contains(row.module_name) -> next
        prefix: "{row.module_name}."
        spelled := false
        loop pair in pairs -> spelled = spelled || pair.starts_with(prefix)
        if !spelled -> next
        text: reach_test_read(row.path)
        parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: row.module_name, owned_members: row.owned_members, runtime: row.runtime, tested: false}, compiler_threads_single())
        loop item in parsed.parsed.program.items {
            if item == .Func(value) {
                pair: "{prefix}{value.name}"
                if value.name.starts_with("__") || !pairs.contains(pair) || reach_test_registry_member(row.module_name, value.name) {
                    next
                }
                if JET_DRIVER_SOURCE_ROUTES.contains(pair) {
                    if !found.contains(pair) -> found.push(pair)
                } else if !missing.contains(pair) { missing.push(pair) }
            }
        }
    }
    assert_eq(missing, [String]{})
    stale := [String]{}
    loop route in JET_DRIVER_SOURCE_ROUTES {
        if !found.contains(route) -> stale.push(route)
    }
    assert_eq(stale, [String]{})
}

// A marker on a line of its own ends in `)`, so its line is a statement of
// its own; the declaration below it is not held, and keeps its marker.
#Test("a function marked on the line above it keeps its marker in a Core module that isn't routed") {
    text: "#Scrub(Secret)\nshape: fn(ctx: #Secret Int) -> Int Never! {{ ctx }}\n\n#Overflow(.Wrapping)\nwrapped: fn(x: Int) -> Int Never! {{ x * 2 }}\n\nplain: fn() -> Int Never! {{ 1 }}\n"
    parsed: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: "core.devtools", owned_members: [String]{}, runtime: false, tested: false}, compiler_threads_single())
    words: parsed.words ?? panic("a Core unit has words")
    held: loop declaration in words.held -> declaration.name
    assert_eq(held, [String]{"plain"})
    load: reach_test_load_module("use d: core.devtools\nrun: fn() {{ print(d.shape(1) + d.wrapped(2) + d.plain()) }}\n", "core.devtools", [String]{}, text)
    marked := [String]{}
    loop module_row in load.modules {
        if module_row.module_name != "core.devtools" -> next
        loop item in module_row.program.items {
            if item == .Func(value) -> marked.push("{value.name} {value.markers.len()}")
        }
    }
    assert_eq(marked, [String]{"shape 1", "wrapped 1", "plain 0"})
}

// A held declaration parses alone, every other byte of its unit blanked
// (jet_driver_reach_parse_held), so nothing outside its own tokens may
// decide its parse: it must parse as it does in its whole unit.
#Test("each held declaration of every built-in Core unit parses alone as it parses in its whole unit") {
    differ := [String]{}
    loop row in CORE_SOURCE_OWNED_ROWS {
        text: reach_test_read(row.path)
        lazy: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: row.module_name, owned_members: row.owned_members, runtime: row.runtime, tested: false}, compiler_threads_single())
        words: lazy.words ?? next
        if words.held.len() == 0 -> next
        whole: jet_driver_parse_one(JetDriverParseJob.Core{text: text, module_name: row.module_name, owned_members: row.owned_members, runtime: row.runtime, tested: true}, compiler_threads_single())
        parsed := [String:String]{}
        loop item in whole.parsed.program.items {
            name: jet_driver_reach_item_name(item)
            if parsed.get(name) == None -> parsed[name] = "{item:Debug}"
        }
        source := text.bytes()
        cursor := 0
        loop declaration in words.held {
            jet_driver_blank_bytes(source, cursor, declaration.span.start)
            cursor = declaration.span.end
        }
        jet_driver_blank_bytes(source, cursor, source.len())
        alone: jet_driver_reach_parse_source(source, None, compiler_threads_single()).parsed
        loop (index, item) in alone.program.items {
            name: if index < words.held.len() -> words.held[index].name else -> "?"
            if parsed.get(name) != Val("{item:Debug}") -> differ.push("{row.path}: {name}")
        }
        if alone.program.items.len() != words.held.len() {
            differ.push("{row.path}: {words.held.len()} held, {alone.program.items.len()} parsed")
        }
    }
    assert_eq(differ, [String]{})
}
