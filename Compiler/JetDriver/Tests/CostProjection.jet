// The typed cost projection (CostQueries.jet) over a checked program: the
// sites of the program's own functions with their loop depths, a generic
// function's once per specialization it is called at, the gap a reachable
// callee without a checked body leaves, a captured report's lines and L2510
// lints, the implicit copy a loop repeats, the String copy `lines()` makes,
// which is an L2510 lint but no L2511 hidden copy, the Int arithmetic a range
// loop's counter keeps on the packed rail, a view read in place as a
// receiver, a plain check's L2511 tidy errors, a map edit's L2511 only
// where its loop shares the map each turn, an Int's L2511 only where its
// loop grows it geometrically with no cap, and the stop polls a loop and a
// recursive call keep.
use {
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileRequest,
        JetDriverCoreSource,
        JetDriverHeldState,
        jet_driver_compile,
        jet_driver_cost_callees,
        jet_driver_cost_cover,
        jet_driver_cost_report,
    ]
    jet_cli.[jet_cli_driver_request]
    jet_foundation.[FnBody, TCostKind, decl_table_key]
}

// One function with an Int product, a generic one called at two types, and
// a caller with an accumulator inside a loop and a sum after it.
cost_projection_source: fn() -> String {
    [String]{
        "helper: fn(value: Int) -> Int {{ value * 2 }}",
        "pick: fn<T>(value: T) -> T {{ value }}",
        "measure: fn() -> Int {{",
        "    total := Int{{0}}",
        "    loop index in 0..<4 {{",
        "        total += helper(index)",
        "    }}",
        "    first: pick(1)",
        "    second: pick(true)",
        "    if second -> total + first else -> total",
        "}}",
        "",
    }.join("\n")
}

// The request of a `jet check` of `source`, the only file.
cost_projection_request: fn(source: String) -> JetDriverCompileRequest {
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{
            JetDriverAuthorizedSourceRoot{
                canonical_path: "/cost-fixture",
                identity: "cost-root",
                allow_hardlinks: false,
                files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/cost-fixture/main.jet", relative_path: "main.jet", identity: "cost-file", source: source}},
                foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
            },
        },
        entry_root_identity: "cost-root",
        entry_path: "/cost-fixture/main.jet",
    }
    jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Check)
}

// The held compile state of a `jet check` of `source`, the only file.
cost_projection_held: fn(source: String) -> JetDriverHeldState {
    request := cost_projection_request(source)
    request.hold_check_state = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    compiled.held.move() ?? panic("a held check keeps its compile state")
}

#Test("the cost projection reports the program's own sites, a generic function's per specialization") {
    held: cost_projection_held(cost_projection_source())
    callees: jet_driver_cost_callees(held.functions, held.modules, held.registration.decls, held.registration.symbols)
    cover: jet_driver_cost_cover(held.functions, callees)
    assert_eq(cover.gaps.len(), 0)
    covered: loop row in cover.covered -> row.name
    assert(covered.contains("helper") && covered.contains("measure"), "the non-generic functions are covered: {covered}")
    assert(covered.contains("pick__generic__Int") && covered.contains("pick__generic__Bool") && !covered.contains("pick"), "a generic function is covered per specialization: {covered}")
    report: jet_driver_cost_report(held.functions, cover.covered, callees)
    assert_eq(report.functions, covered)
    sites: loop site in report.sites -> "{site.function} {site.kind:Debug} {site.state:Debug} depth {site.loop_depth}"
    assert_eq(sites, [String]{"helper ExactIntSpill SemanticRemainder depth 0", "measure ExactIntSpill SemanticRemainder depth 0", "measure ExactIntSpill SemanticRemainder depth 1", "measure StopPoll SemanticRemainder depth 1"})
}

#Test("a reachable callee with no checked body is a projection gap at its call") {
    held: cost_projection_held(cost_projection_source())
    kept: held.functions.filter(fn(row: FnBody) { row.name != "helper" })
    cover: jet_driver_cost_cover(kept, jet_driver_cost_callees(kept, held.modules, held.registration.decls, held.registration.symbols))
    gaps: loop gap in cover.gaps -> "{kept[gap.caller].name} calls {decl_table_key(held.registration.decls, held.registration.symbols, gap.callee)}"
    assert_eq(gaps.len(), 1)
    assert(gaps[0].starts_with("measure calls ") && gaps[0].ends_with("helper"), "the gap names its caller and callee: {gaps}")
}

#Test("a captured cost report places its sites on their lines and lints the cost a loop repeats") {
    request := cost_projection_request(cost_projection_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    sites: loop site in report.sites -> "{site.function} {site.path}:{site.line} depth {site.loop_depth}"
    assert_eq(sites, [String]{"helper main.jet:1 depth 0", "measure main.jet:10 depth 0", "measure main.jet:6 depth 1", "measure main.jet:5 depth 1"})
    lints := [String]{}
    loop row in compiled.advice {
        if row.code == "L2510" -> lints.push(row.what)
    }
    assert_eq(lints, [String]{"An exact Int operation may spill to bigint inside a loop"})
}

// A loop that copies a list it reads again later: the binding takes a copy
// of `row` on every turn, since `row` is still used after it.
cost_projection_copy_source: fn() -> String {
    [String]{
        "hold: fn() -> Int {{",
        "    row: [Int]{{1, 2}}",
        "    count := Int{{0}}",
        "    loop index in 0..<3 {{",
        "        held := row",
        "        held.push(index)",
        "        count += held.len()",
        "    }}",
        "    count + row.len()",
        "}}",
        "",
    }.join("\n")
}

#Test("an implicit copy a loop repeats is a cost site and an L2510 lint") {
    request := cost_projection_request(cost_projection_copy_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    copies := [String]{}
    loop site in report.sites {
        if site.kind == .ImplicitCopy {
            copies.push("{site.function} {site.view} {site.state:Debug} {site.path}:{site.line} depth {site.loop_depth}")
        }
    }
    assert_eq(copies, [String]{"hold [Int] SemanticRemainder main.jet:5 depth 1"})
    lints := [String]{}
    loop row in compiled.advice {
        if row.code == "L2510" -> lints.push(row.what)
    }
    assert(lints.contains("Implicitly copying a `[Int]` inside a loop"), "the copy is linted: {lints}")
}

// Arithmetic on a range loop's counter, whose values the range bounds, and a
// counter no range bounds, which a loop raises until it breaks.
cost_projection_counter_source: fn() -> String {
    [String]{
        "spread: fn() -> Int {{",
        "    loop index in 0..<4 {{",
        "        print(index * 2 + 1)",
        "    }}",
        "    count := Int{{0}}",
        "    loop {{",
        "        count += 1",
        "        if count > 1000 -> break",
        "    }}",
        "    count",
        "}}",
        "",
    }.join("\n")
}

#Test("a range loop's counter stays on the packed Int rail; a counter no range bounds may spill") {
    request := cost_projection_request(cost_projection_counter_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    sites: loop site in report.sites -> "{site.kind:Debug} {site.state:Debug} {site.path}:{site.line} depth {site.loop_depth}"
    assert_eq(sites, [String]{"ExactIntSpill OptimizerRemoved main.jet:3 depth 1", "ExactIntSpill OptimizerRemoved main.jet:3 depth 1", "ExactIntSpill SemanticRemainder main.jet:7 depth 1", "StopPoll SemanticRemainder main.jet:2 depth 1", "StopPoll SemanticRemainder main.jet:6 depth 1"})
}

// A recursive function and a caller outside its cycle.
cost_projection_recursive_source: fn() -> String {
    [String]{
        "fib: fn(n: Int) -> Int {{",
        "    if n < 2 -> return n",
        "    fib(n - 1) + fib(n - 2)",
        "}}",
        "twice: fn(n: Int) -> Int {{ fib(n) * 2 }}",
        "",
    }.join("\n")
}

#Test("a stop poll is a cost site at each call on a cycle back to its caller, and none at a call outside it") {
    request := cost_projection_request(cost_projection_recursive_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    polls := [String]{}
    loop site in report.sites {
        if site.kind == TCostKind.StopPoll {
            polls.push("{site.function} {site.state:Debug} {site.path}:{site.line} depth {site.loop_depth}")
        }
    }
    assert_eq(polls, [String]{"fib SemanticRemainder main.jet:3 depth 0", "fib SemanticRemainder main.jet:3 depth 0"})
}

// The cost law's example: `log.lines()` copies each line of `log` out into an
// owned String on every turn.
cost_projection_lines_source: fn() -> String {
    [String]{
        "headers: fn(logs: [String]) -> [String] {{",
        "    out := [String]{{}}",
        "    loop log in logs {{",
        "        out.push(log.lines().first() ?? \"\")",
        "    }}",
        "    out",
        "}}",
        "",
    }.join("\n")
}

#Test("the String copy `lines()` makes each loop turn is a view materialization site and an L2510 lint") {
    request := cost_projection_request(cost_projection_lines_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    sites: loop site in report.sites -> "{site.kind:Debug} `{site.view}` {site.state:Debug} {site.path}:{site.line} depth {site.loop_depth}"
    assert_eq(sites, [String]{"OutcomeConstruction `` OptimizerRemoved main.jet:4 depth 1", "ViewMaterialization `String` SemanticRemainder main.jet:4 depth 1", "StopPoll `` SemanticRemainder main.jet:3 depth 1"})
    lints := [String]{}
    loop row in compiled.advice {
        if row.code == "L2510" -> lints.push(row.what)
    }
    assert_eq(lints, [String]{"This copy of `String` view into an owned slot inside a loop"})
}

// `lines()` in a loop as a loop source and under `filter`, `len` and `join`,
// beside an implicit String copy in a loop.
cost_projection_written_lines_source: fn() -> String {
    [String]{
        "Tag: struct {{ name: String, turn: Int }}",
        "widths: fn(logs: [String]) -> Int {{",
        "    total := 0",
        "    loop log in logs {{",
        "        loop line in log.lines() -> total += line.len()",
        "        total += log.lines().filter(fn(line) {{ line != \"\" }}).len()",
        "        total += log.lines().len()",
        "        total += log.lines().join(\" \").len()",
        "    }}",
        "    total",
        "}}",
        "tags: fn(turns: Int) -> [Tag] {{",
        "    label: \"turn\"",
        "    out := [Tag]{{}}",
        "    loop turn in 0..<turns {{",
        "        out.push(Tag{{name: label, turn: turn}})",
        "    }}",
        "    out",
        "}}",
        "",
    }.join("\n")
}

#Test("the copies a written `lines()` makes in a loop are view materialization sites and L2510 lints but no L2511, while an implicit String copy in a loop stays an L2511") {
    request := cost_projection_request(cost_projection_written_lines_source())
    request.capture_cost_report = true
    captured := jet_driver_compile(request)
    assert(captured.complete, "the fixture checks: {captured.diagnostics.map(fn(row) { row.what })}")
    report: captured.cost_report.move() ?? panic("a captured check keeps its cost report")
    copies := [String]{}
    loop site in report.sites {
        if site.kind == .ViewMaterialization || site.kind == .ImplicitCopy {
            copies.push("{site.kind:Debug} `{site.view}` {site.function} main.jet:{site.line} depth {site.loop_depth}")
        }
    }
    assert_eq(
        copies,
        [String]{
            "ViewMaterialization `String` widths main.jet:5 depth 2",
            "ViewMaterialization `String` widths main.jet:5 depth 2",
            "ViewMaterialization `String` widths main.jet:6 depth 1",
            "ViewMaterialization `String` widths main.jet:7 depth 1",
            "ViewMaterialization `String` widths main.jet:8 depth 1",
            "ImplicitCopy `String` tags main.jet:16 depth 1",
        },
    )
    lints := [String]{}
    loop row in captured.advice {
        if row.code == "L2510" && !row.what.starts_with("An exact Int") -> lints.push(row.what)
    }
    assert_eq(
        lints,
        [String]{
            "This copy of `String` view into an owned slot inside a loop",
            "This copy of `String` view into an owned slot inside a loop",
            "This copy of `String` view into an owned slot inside a loop",
            "This copy of `String` view into an owned slot inside a loop",
            "Implicitly copying a `String` inside a loop",
        },
    )
    compiled := jet_driver_compile(cost_projection_request(cost_projection_written_lines_source()))
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    tidy := [String]{}
    loop row in compiled.diagnostics {
        if row.code == "L2511" -> tidy.push("{row.what} | {row.fix}")
    }
    assert_eq(tidy, [String]{"Implicitly copying a `String` inside a loop | To keep the copy out of the loop, hand the value over with `.move()` at its last use, or make the copy explicit outside the loop."})
}

// A string view read only as the receiver of a scalar read: `trimmed.len()`
// reads the view in place, while pushing it stores it into an owned slot.
cost_projection_view_receiver_source: fn() -> String {
    [String]{
        "widths: fn(lines: [String]) -> [String] {{",
        "    out := [String]{{}}",
        "    loop line in lines {{",
        "        trimmed: line.trim()",
        "        if trimmed.len() > 0 && !trimmed.is_empty() -> out.push(trimmed)",
        "    }}",
        "    out",
        "}}",
        "",
    }.join("\n")
}

#Test("a view read as a scalar method's receiver is passed as the view; storing it copies") {
    request := cost_projection_request(cost_projection_view_receiver_source())
    request.capture_cost_report = true
    compiled := jet_driver_compile(request)
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    report: compiled.cost_report.move() ?? panic("a captured check keeps its cost report")
    copies := [String]{}
    loop site in report.sites {
        if site.kind == .ViewMaterialization || site.kind == .ImplicitCopy {
            copies.push("{site.kind:Debug} `{site.view}` {site.path}:{site.line} depth {site.loop_depth}")
        }
    }
    assert_eq(copies, [String]{"ViewMaterialization `String` main.jet:5 depth 1"})
}

// Hidden copies inside loops beside copies the source writes, copies that
// allocate nothing (a struct of Ints, a Shared handle) and one outside any
// loop: a plain check lists an L2511 tidy error for each hidden copy a loop
// repeats that allocates, and nothing for the rest.
cost_projection_hidden_copy_source: fn() -> String {
    [String]{
        "Tag: struct {{ name: String, turn: Int }}",
        "Extent: struct {{ start: Int, end: Int }}",
        "Box: struct {{ n: Int }}",
        "Holder: struct {{ cell: Shared<Box>?, extent: Extent }}",
        "keep: fn(lines: [String]) -> [String] {{",
        "    out := [String]{{}}",
        "    loop line in lines {{",
        "        trimmed: line.trim()",
        "        out.push(trimmed)",
        "        out.push(trimmed.copy())",
        "    }}",
        "    first: lines[0].trim()",
        "    out.push(first)",
        "    out",
        "}}",
        "tags: fn(turns: Int) -> [Tag] {{",
        "    label: \"turn\"",
        "    out := [Tag]{{}}",
        "    loop turn in 0..<turns {{",
        "        out.push(Tag{{name: label, turn: turn}})",
        "    }}",
        "    out",
        "}}",
        "written: fn(turns: Int) -> [Tag] {{",
        "    label: \"turn\"",
        "    out := [Tag]{{}}",
        "    loop turn in 0..<turns {{",
        "        out.push(Tag{{name: label.copy(), turn: turn}})",
        "    }}",
        "    out",
        "}}",
        "holders: fn(turns: Int) -> [Holder] {{",
        "    cell: Shared{{Box{{n: 1}}}}",
        "    extent: Extent{{start: 0, end: 1}}",
        "    out := [Holder]{{}}",
        "    loop turn in 0..<turns {{",
        "        held := extent",
        "        held.end = turn",
        "        out.push(Holder{{cell: Val(cell), extent: held}})",
        "    }}",
        "    out",
        "}}",
        "",
    }.join("\n")
}

#Test("a plain check lists an L2511 tidy error for each allocating hidden copy a loop repeats, and none for a written, bitwise or shared-handle copy or one outside a loop") {
    compiled := jet_driver_compile(cost_projection_request(cost_projection_hidden_copy_source()))
    assert(compiled.complete, "the fixture checks: {compiled.diagnostics.map(fn(row) { row.what })}")
    if compiled.cost_report == .Val(_) -> panic("a plain check keeps no cost report")
    tidy := [String]{}
    loop row in compiled.diagnostics {
        if row.code == "L2511" -> tidy.push("{row.what} | {row.fix}")
        assert(row.code != "L2510", "a plain check lists no L2510 lint: {row.what}")
    }
    assert_eq(
        tidy,
        [String]{
            "This copy of `String` view into an owned slot inside a loop | To keep the copy out of the loop, keep the value in its view form, or make the copy explicit outside the loop.",
            "Implicitly copying a `String` inside a loop | To keep the copy out of the loop, hand the value over with `.move()` at its last use, or make the copy explicit outside the loop.",
        },
    )
}

// Map edits inside loops: one whose loop snapshots the map each turn, so the
// edit clones it each turn, and three that clone at most once: a map the
// loop never shares, one shared only before the loop, and one beside a
// different map the loop shares.
cost_projection_map_edit_source: fn() -> String {
    [String]{
        "history: fn(keys: [String]) -> [[String:Int]] {{",
        "    counts := [String:Int]{{}}",
        "    out := [[String:Int]]{{}}",
        "    loop key in keys {{",
        "        out.push(counts.copy())",
        "        counts[key] = out.len()",
        "    }}",
        "    out",
        "}}",
        "tally: fn(keys: [String]) -> [String:Int] {{",
        "    counts := [String:Int]{{}}",
        "    loop key in keys {{",
        "        counts[key] = (counts.get(key) ?? 0) + 1",
        "    }}",
        "    counts",
        "}}",
        "after_snapshot: fn(keys: [String]) -> Int {{",
        "    counts := [String:Int]{{}}",
        "    before: counts.copy()",
        "    loop key in keys {{",
        "        counts[key] = 1",
        "    }}",
        "    before.len() + counts.len()",
        "}}",
        "mirrored: fn(keys: [String]) -> Int {{",
        "    seen := [String:Int]{{}}",
        "    frozen: [String:Int]{{\"x\": 1}}",
        "    out := [[String:Int]]{{}}",
        "    loop key in keys {{",
        "        out.push(frozen.copy())",
        "        seen[key] = out.len()",
        "    }}",
        "    out.len() + seen.len()",
        "}}",
        "",
    }.join("\n")
}

#Test("a map edit is an L2511 tidy error only where its loop shares the map each turn") {
    request := cost_projection_request(cost_projection_map_edit_source())
    request.capture_cost_report = true
    captured := jet_driver_compile(request)
    assert(captured.complete, "the fixture checks: {captured.diagnostics.map(fn(row) { row.what })}")
    report: captured.cost_report.move() ?? panic("a captured check keeps its cost report")
    edits := [String]{}
    loop site in report.sites {
        if site.kind == TCostKind.CollectionCopyOnWrite {
            edits.push("{site.function} main.jet:{site.line} shared {site.shared}")
        }
    }
    assert_eq(edits, [String]{"history main.jet:6 shared true", "tally main.jet:13 shared false", "after_snapshot main.jet:21 shared false", "mirrored main.jet:31 shared false"})
    compiled := jet_driver_compile(cost_projection_request(cost_projection_map_edit_source()))
    tidy := [String]{}
    loop row in compiled.diagnostics {
        if row.code == "L2511" -> tidy.push("{row.what} | {row.fix}")
    }
    assert_eq(tidy, [String]{"Editing a shared map backing store inside a loop | To keep the copy out of the loop, mutate an exclusive map place, or move the edit outside the loop."})
}

// Int updates inside loops: a sum of arbitrary list values, a doubling the
// loop caps by a parameter, a doubling it caps by a length, a left shift, a
// product written factor-first, a sign flip, a tripling it caps by a
// constant on one side of `&&`, a doubling it caps by its own double, each
// element of a list scaled once, one element scaled every turn, and a
// tripling of a local each turn binds afresh.
cost_projection_spill_source: fn() -> String {
    [String]{
        "weigh: fn(weights: [Int]) -> Int {{",
        "    total := 0",
        "    loop weight in weights {{",
        "        total += weight",
        "    }}",
        "    total",
        "}}",
        "grow: fn(limit: Int) -> Int {{",
        "    size := 1",
        "    loop size != limit {{",
        "        size *= 2",
        "    }}",
        "    size",
        "}}",
        "fit: fn(slots: Int) -> Int {{",
        "    cap := 1",
        "    loop cap - 1 < slots {{",
        "        cap *= 2",
        "    }}",
        "    cap",
        "}}",
        "bits: fn(rows: [String]) -> Int {{",
        "    mask := 1",
        "    loop _ in rows {{",
        "        mask <<= 1",
        "    }}",
        "    mask",
        "}}",
        "scale: fn(rows: [String]) -> Int {{",
        "    total := 1",
        "    loop _ in rows {{",
        "        total = 3 * total",
        "    }}",
        "    total",
        "}}",
        "flip: fn(rows: [String]) -> Int {{",
        "    sign := 1",
        "    loop _ in rows {{",
        "        sign *= -1",
        "    }}",
        "    sign",
        "}}",
        "bounded: fn() -> Int {{",
        "    size := 1",
        "    loop size > 0 && size < 4096 {{",
        "        size *= 3",
        "    }}",
        "    size",
        "}}",
        "octave: fn(micros: Int) -> Int {{",
        "    span := 1",
        "    loop span * 2 <= micros {{",
        "        span *= 2",
        "    }}",
        "    span",
        "}}",
        "each: fn(xs: &[Int], k: Int) {{",
        "    loop i in 0..<xs.len() {{",
        "        xs[i] = xs[i] * k",
        "    }}",
        "}}",
        "slot: fn(xs: &[Int], k: Int) {{",
        "    loop _ in 0..<xs.len() {{",
        "        xs[0] = xs[0] * k",
        "    }}",
        "}}",
        "fresh: fn(rows: [String]) -> Int {{",
        "    last := 0",
        "    loop row in rows {{",
        "        step := row.len()",
        "        step *= 3",
        "        last = step",
        "    }}",
        "    last",
        "}}",
        "",
    }.join("\n")
}

#Test("only an Int product or left shift a loop carries from turn to turn and grows with no cap in its condition is marked growing, and a plain check lists each as an L2511 tidy error") {
    request := cost_projection_request(cost_projection_spill_source())
    request.capture_cost_report = true
    captured := jet_driver_compile(request)
    assert(captured.complete, "the fixture checks: {captured.diagnostics.map(fn(row) { row.what })}")
    report: captured.cost_report.move() ?? panic("a captured check keeps its cost report")
    spills := [String]{}
    loop site in report.sites {
        if site.kind == TCostKind.ExactIntSpill && site.loop_depth > 0 {
            spills.push("{site.function} main.jet:{site.line} {site.state:Debug} grows {site.grows}")
        }
    }
    spills.sort()
    assert_eq(
        spills,
        [String]{
            "bits main.jet:25 SemanticRemainder grows true",
            "bounded main.jet:46 SemanticRemainder grows false",
            "each main.jet:59 SemanticRemainder grows false",
            "fit main.jet:17 SemanticRemainder grows false",
            "fit main.jet:18 SemanticRemainder grows false",
            "flip main.jet:39 OptimizerRemoved grows false",
            "flip main.jet:39 SemanticRemainder grows false",
            "fresh main.jet:71 SemanticRemainder grows false",
            "grow main.jet:11 SemanticRemainder grows true",
            "octave main.jet:52 SemanticRemainder grows false",
            "octave main.jet:53 SemanticRemainder grows false",
            "scale main.jet:32 SemanticRemainder grows true",
            "slot main.jet:64 SemanticRemainder grows true",
            "weigh main.jet:4 SemanticRemainder grows false",
        },
    )
    compiled := jet_driver_compile(cost_projection_request(cost_projection_spill_source()))
    tidy := [String]{}
    loop row in compiled.diagnostics {
        if row.code == "L2511" -> tidy.push("{row.what} | {row.fix}")
    }
    spill: "An exact Int operation may spill to bigint inside a loop | To keep the Int on the packed rail, give it a range type such as `Int(0..1000)` or a fixed width such as `I64`, or cap it in the loop's condition."
    assert_eq(tidy, [String]{spill, spill, spill, spill})
}
