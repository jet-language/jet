// Rust: crates/jet-driver/src/QueryService.rs:1278
#Test("retained_item_bytes_grow_with_retained_payloads") {
    service := CompilerQueries.new()
    one :: "fn alpha() -> Int { return 1 }\n"
    two :: "fn alpha() -> Int { return 1 }\nfn beta() -> Int { return \"a deliberately long wrong value\" }\n"
    _ :: service.check_text("memory.jet", one, true)
    before :: service.stats()
    _ :: service.check_text("memory.jet", two, true)
    after :: service.stats()
    assert_eq(after.live_items, 2)
    assert(after.live_item_bytes >= before.live_item_bytes + (two.len() - one.len()), "retained-byte total must cover the added key, function, and diagnostic payload")
}
// Rust: crates/jet-driver/src/QueryService.rs:1297
fn cone_source(functions: USize) -> String {
    // ONE-arrow ruling: migrate the old fixture's `() Int ->` to `() -> Int`.
    source := ""
    loop index in 0..<functions { source.push_str("fn _helper_{index}() -> Int \u{007b} return {index} \u{007d}\n") }
    source.push_str("fn target() -> Int { return 1 }\nfn run() { print(target()) }\n")
    ^source
}
// Rust: crates/jet-driver/src/QueryService.rs:1306
#Test("hostile_no_change_corpus_reuses_every_item") {
    source :: cone_source(256)
    service := CompilerQueries.new()
    (cold, cold_receipt) :: service.check_text_with_receipt("hostile-no-change.jet", &source, false)
    assert(cold.diagnostics.is_empty(), "{cold.diagnostics:Debug}")
    assert_eq(cold_receipt.program_items, 258)
    assert_eq(cold_receipt.item_recomputes, 258)
    (warm, warm_receipt) :: service.check_text_with_receipt("hostile-no-change.jet", &source, false)
    assert(warm.diagnostics.is_empty(), "{warm.diagnostics:Debug}")
    assert_eq(warm_receipt.edit_bytes, 0)
    assert_eq(warm_receipt.query_recomputes, 0)
    assert_eq(warm_receipt.item_recomputes, 0)
    assert_eq(warm_receipt.blast_radius(), 0)
    assert_eq(warm_receipt.program_items, cold_receipt.program_items)
    assert(service.stats().hits > 0, "the unchanged query must be a hit")
}
// Rust: crates/jet-driver/src/QueryService.rs:1328
fn nested_typecheck_source(depth: USize, leaf: String) -> String {
    expression := leaf
    loop _ in 0..<depth { expression = "id({expression})" }
    "fn id(value: Int) -> Int \u{007b} return value \u{007d}\nfn run() \u{007b}\n    print({expression})\n\u{007d}\n"
}
// Rust: crates/jet-driver/src/QueryService.rs:1339
#Test("hostile_typecheck_cliff_keeps_pinpoint_fresh_diagnostic") {
    before :: nested_typecheck_source(96, "1")
    after :: nested_typecheck_source(96, "\"bad\"")
    incremental := CompilerQueries.new()
    valid :: incremental.check_text("hostile-typecheck.jet", &before, false)
    assert(valid.diagnostics.is_empty(), "{valid.diagnostics:Debug}")
    changed :: incremental.check_text("hostile-typecheck.jet", &after, false)
    fresh :: CompilerQueries.new().check_text("hostile-typecheck.jet", &after, false)
    assert_eq(diagnostic_summary(&changed.diagnostics), diagnostic_summary(&fresh.diagnostics), "the hostile diagnostic must match a fresh batch check")
    diagnostic :: changed.diagnostics.iter().find(fn(d) -> d.code == "E0112").expect("the deep wrong-type call must retain E0112")
    span :: diagnostic.span.expect("the wrong argument needs a span")
    assert_eq(after[span.start..<span.end], "\"bad\"")
    assert(diagnostic.what.contains("Int"))
    assert(diagnostic.what.contains("String"))
    assert(!diagnostic.why.is_empty())
    assert(!diagnostic.fix.is_empty())
    assert(!diagnostic.what.to_ascii_lowercase().contains("guess"))
    assert(!diagnostic.what.to_ascii_lowercase().contains("reasonable time"))
}
// Rust: crates/jet-driver/src/QueryService.rs:1371
#Test("reverdict_receipt_reports_the_edited_function_and_is_canonical") {
    before :: cone_source(8)
    after :: before.replace("fn target() -> Int { return 1 }", "fn target() -> Int { return 2 }")
    service := CompilerQueries.new()
    (cold, _) :: service.check_text_with_receipt("cone.jet", &before, true)
    assert(cold.diagnostics.is_empty(), "{cold.diagnostics:Debug}")
    (checked, receipt) :: service.check_text_with_receipt("cone.jet", &after, true)
    assert(checked.diagnostics.is_empty(), "{checked.diagnostics:Debug}")
    assert_eq(receipt.program_items, 10)
    assert_eq(receipt.item_recomputes, 1)
    assert_eq(receipt.blast_radius(), 1)
    assert(receipt.reverified_items[0].contains("fn:target"))
    assert(receipt.callable_contracts.iter().any(fn(c) -> c.failure_source == "implicit default !Err"))
    assert_eq(receipt.edit_bytes, 2)
    json :: receipt.to_json()
    envelope :: if CanonicalJson.parse_canonical(json.as_bytes())! == { .Object(envelope) -> envelope else -> panic("re-verdict receipt envelope") }
    assert_eq(envelope["schema"], CanonicalJson.String("jet.reverdict-receipt"))
    assert(if envelope["receipt_id"] == { .String(_) -> true else -> false })
    content :: if envelope["content"] == { .Object(content) -> content else -> panic("re-verdict receipt content") }
    assert(if content["callable_contracts"] == { .Array(values) -> !values.is_empty() else -> false })
    dependency_scope :: if content["dependency_scope"] == { .Object(scope) -> scope else -> panic("re-verdict dependency scope") }
    assert_eq(dependency_scope["kind"], CanonicalJson.String("checked_semantic"))
    blast_radius :: if content["blast_radius"] == { .Object(radius) -> radius else -> panic("re-verdict blast radius") }
    assert_eq(blast_radius["count"], CanonicalJson.Integer("1"))
    assert_eq(content["claim"], CanonicalJson.String("D-DEVR-CONE1=A"))
}
// Rust: crates/jet-driver/src/QueryService.rs:1430
#Test("cone_benchmark_keeps_one_function_edit_flat_as_program_grows") {
    measurements := []
    loop functions in [USize]{16, 128} {
        before :: cone_source(functions)
        after :: before.replace("fn target() -> Int { return 1 }", "fn target() -> Int { return 2 }")
        service := CompilerQueries.new()
        (cold, _) :: service.check_text_with_receipt("cone-bench.jet", &before, true)
        assert(cold.diagnostics.is_empty(), "{cold.diagnostics:Debug}")
        (checked, receipt) :: service.check_text_with_receipt("cone-bench.jet", &after, true)
        assert(checked.diagnostics.is_empty(), "{checked.diagnostics:Debug}")
        measurements.push(receipt)
    }
    assert_eq(measurements.len(), 2, "cone benchmark measurements")
    small :: measurements[0]; large :: measurements[1]
    assert(large.program_items > small.program_items)
    assert_eq(small.item_recomputes, 1)
    assert_eq(large.item_recomputes, 1)
    assert_eq(small.blast_radius(), large.blast_radius())
    assert_eq(small.reverified_items, large.reverified_items)
}
