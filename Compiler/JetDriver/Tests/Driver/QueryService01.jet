// Rust: crates/jet-driver/src/QueryService.rs:1112
#Test("repaired_import_invalidates_cached_load_failure") {
    root :: env.temp_dir().join("jet-query-repair-{process.id()}")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root)!
    main :: root.join("main.jet"); dependency :: root.join("b.jet")
    source :: "module b\nfn run() { print(b.value() + 0) }\n"
    dependency_source :: "pub fn value() -> Int { return 1 }\n"
    fs.write(&dependency, dependency_source)!
    service := CompilerQueries.new()
    overlay_first :: service.check_text(main.to_string_lossy(), source, true)
    assert(overlay_first.diagnostics.is_empty(), "{overlay_first.diagnostics:Debug}")
    fs.write(&dependency, "pub fn value() -> Int { return 1 }\n::\n")!
    broken :: service.check_text(main.to_string_lossy(), source, true)
    assert(broken.diagnostics.iter().any(fn(d) -> d.code == "E0003"))
    recomputes :: service.recompute_count(&checked_key(main))
    broken_again :: service.check_text(main.to_string_lossy(), source, true)
    assert_eq(diagnostic_summary(&broken.diagnostics), diagnostic_summary(&broken_again.diagnostics))
    assert_eq(service.recompute_count(&checked_key(main)), recomputes)
    fs.write(&dependency, dependency_source)!
    repaired :: service.check_text(main.to_string_lossy(), source, true)
    fresh :: CompilerQueries.new().check_text(main.to_string_lossy(), source, true)
    assert_eq(diagnostic_summary(&repaired.diagnostics), diagnostic_summary(&fresh.diagnostics))
    assert(!repaired.diagnostics.iter().any(fn(d) -> d.code == "E0003"))
    assert(repaired.diagnostics.is_empty(), "{repaired.diagnostics:Debug}")
    _ :: fs.remove_dir_all(root)
}
