// Rust: crates/jet-driver/src/QueryService.rs:1062
#Test("unrelated_roots_remain_warm") {
    root :: env.temp_dir().join("jet-query-roots-{process.id()}")
    left :: root.join("left/main.jet"); right :: root.join("right/main.jet")
    fs.create_dir_all(left.parent().unwrap())!; fs.create_dir_all(right.parent().unwrap())!
    service := CompilerQueries.new()
    left_before :: "fn left() -> Int { return 1 }\n"
    left_after :: "fn left() -> Int { return 2 }\n"
    right_source :: "fn right() -> Int { return 3 }\n"
    _ :: service.check_text(left.to_string_lossy(), left_before, true)
    _ :: service.check_text(right.to_string_lossy(), right_source, true)
    _ :: service.check_text(left.to_string_lossy(), left_after, true)
    hits :: service.stats().hits
    _ :: service.check_text(right.to_string_lossy(), right_source, true)
    assert_eq(service.recompute_count(&checked_key(left)), 2)
    assert_eq(service.recompute_count(&checked_key(right)), 1)
    assert_eq(service.stats().hits, hits + 1, "right root must stay warm")
    _ :: fs.remove_dir_all(root)
}
