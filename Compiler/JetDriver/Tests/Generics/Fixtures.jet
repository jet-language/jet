// Examples/features/modules/generic_modules.jet: complete acceptance program.
GENMOD_COMPLETE_SOURCE :: `
module cache<K>(capacity: Int) {
    BASE :: prep { capacity }
    COMPUTED_SIZE :: prep { BASE + 1 }
    pub struct Entry {
        key: K
        limit: Int -> capacity
    }
    pub enum Slot {
        Empty
        Value(K)
    }
    pub fn entry(k: K) -> Entry { return Entry{key: k} }
    pub fn slot(k: K) -> Slot { Slot.Value(k) }
    pub fn key_of(k: K) -> String { return "key" }
    pub fn describe() -> String { "generic cache" }
    pub fn size() -> Int { COMPUTED_SIZE }
}
module forward_cache :: int_cache
module int_cache :: cache<Int>(32)
enum Mode {
    Fast
    Safe
}
module tier_zero(flag: Bool, count: Int, letter: Char, label: String, mode: Mode) {
    #Meta(category: "tier zero")
    pub fn show() {
        print(flag)
        print(count)
        print(letter)
        print(label)
        print(mode == Mode.Fast)
    }
}
module values :: tier_zero(true, 7, 'J', "jet", Mode.Fast)
trait Token {}
struct GoodToken {}
impl GoodToken.Token {}
module annotation_kinds<Item: Token>(count: Int) {
    pub fn count() -> Int { count }
}
module kinds :: annotation_kinds<GoodToken>(8)
module fixed_buffer<T>(capacity: Int) {
    pub struct Buffer { items: [T#capacity] }
    pub fn echo(values: [T#capacity]) -> [T#capacity] { return ~values }
}
module three_ints :: fixed_buffer<Int>(3)
module local_laws<T> {
    pub trait Reveal {
        type Output
        fn reveal(self) -> T
    }
    pub struct Wrapped { value: T }
    impl Wrapped.Reveal {
        type Output = T
        fn reveal(self) -> T { self.value }
    }
    pub enum SourceErr { Bad(T) }
    pub enum TargetErr { Wrapped(SourceErr) }
    impl SourceErr -> TargetErr { return TargetErr.Wrapped(self) }
}
module int_laws :: local_laws<Int>
fn run() {
    k :: int_cache.key_of(42)
    d :: int_cache.describe()
    n :: int_cache.size()
    e :: int_cache.entry(42)
    s :: int_cache.slot(7)
    print(k)
    print(d)
    print(n)
    print(e.key)
    print(e.limit)
    forwarded :: forward_cache.entry(9)
    print(forward_cache.size())
    print(forwarded.key)
    if s == {
        .Value(v) -> { print(v) }
        .Empty -> { print(0) }
    }
    values.show()
    print(kinds.count())
    input :: [Int#3]{1, 2, 3}
    fixed :: three_ints.echo(input)
    buffer :: three_ints.Buffer{items: fixed}
    print(buffer.items[2])
    wrapped :: int_laws.Wrapped{value: 91}
    print(wrapped.reveal())
}
`
