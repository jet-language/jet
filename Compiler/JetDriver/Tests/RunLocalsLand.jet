// Assemble with the Compiler source unit. An explicit `name: #run value`
// local in a function body lands in the body that holds it (JetSema
// Comptime/LocalSplice.jet), as a local value does: the compile checks the
// program once, with no full recheck after finalization, and under
// recheck_verify the landed result is the full recheck's.
use {
    run_locals_files: core.files
    run_locals_sys: core.sys
    run_locals_process: core.process
    jet_driver.[
        JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot, JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode, JetDriverCompileRequest, JetDriverCoreSource, jet_driver_has_errors,
        jet_driver_lowering_inputs,
    ]
    jet_cli.[jet_cli_driver_request, jet_cli_native_session_at]
    jet_foundation.[CompilerTraceSink]
    jet_sema.[SchemaSnapshot]
}

// A trace sink that appends each span's open and close, each counter and
// each progress report to `path`, one line each.
RunLocalsTrace: struct {
    path: String

    impl CompilerTraceSink {
        begin: fn(self, name: String, detail: String, index: Int, total: Int) Never! -[FS, Time]> {
            run_locals_files.append_all(self.path, "> {name} {detail} ({index}/{total})\n") ?? panic("cannot write the trace: {err}")
        }

        begin_item: fn(self, name: String, file: String, item: String) Never! -[FS, Time]> {
            run_locals_files.append_all(self.path, "> {name} {item} ({file})\n") ?? panic("cannot write the trace: {err}")
        }

        end: fn(self, name: String, items: Int) Never! -[FS, Time]> {
            run_locals_files.append_all(self.path, "< {name} items={items}\n") ?? panic("cannot write the trace: {err}")
        }

        progress: fn(self, name: String, done: Int, total: Int) Never! -[FS]> {
            line: if name.starts_with("counters.") -> "{name} = {done}\n" else -> "~ {name} {done}/{total}\n"
            run_locals_files.append_all(self.path, line) ?? panic("cannot write the trace: {err}")
        }

        functions: fn(self) -[]> Bool Never! {
            false
        }
    }
}

run_locals_sink: fn(trace: &&RunLocalsTrace) -> CompilerTraceSink Never! {
    trace.move()
}

// The compiler under test, never this test binary, owns the runtime pack
// the `#run` values run on (as InspectBuild.jet's planned `build: fn`).
run_locals_runtime_dir: fn() -> String {
    jet: run_locals_sys.get("JET") ?? (run_locals_process.which("jet") ?? panic("set JET to the compiler under test"))
    parts := jet.split("/").to_list()
    _ := parts.pop()
    "{parts.join("/")}/jet-runtime"
}

// The request that compiles the case's program, its trace going to `path`.
run_locals_request: fn(path: String) -> JetDriverCompileRequest {
    source: "fact: fn(n: Int) -> Int {{\n    if n <= 1 -> return 1\n    n * fact(n - 1)\n}}\n\nrepeat: fn(word: String, times: Int) -> String {{\n    out := \"\"\n    loop _ in 0..<times -> out = \"{{out}}{{word}}\"\n    out\n}}\n\nshout: fn(text: String) -> String {{\n    \"{{text}}!\"\n}}\n\nrun: fn() {{\n    big: #run fact(10)\n    word: #run repeat(\"ab\", 3)\n    print(\"{{big}} {{big + 1}} {{shout(word)}} {{shout(word)}}\")\n}}\n"
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/run-locals",
            identity: "run-locals-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/run-locals/main.jet", relative_path: "main.jet", identity: "run-locals-file", source: source}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "run-locals-root",
        entry_path: "/run-locals/main.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), JetDriverCompileMode.Program)
    request.schema_snapshots = Val([String:SchemaSnapshot]{})
    request.eval_config.native = Val(jet_cli_native_session_at(run_locals_runtime_dir()) ?? panic("the compiler under test has no runtime pack"))
    request.trace_sink = Val(run_locals_sink(RunLocalsTrace{path: path}))
    request
}

#Test("explicit_run_locals_land") {
    path: run_locals_files.join(run_locals_sys.temp_dir(), "jet-run-locals-land-{run_locals_process.current_pid()}.trace")
    loop verify in ([Bool]{false, true}) {
        run_locals_files.write(path, "") ?? panic("cannot start the trace: {err}")
        request := run_locals_request(path)
        request.recheck_verify = verify
        front: jet_driver_lowering_inputs(request, None)
        trace: run_locals_files.read(path) ?? panic("cannot read the trace: {err}")
        problems := [String]{}
        loop diagnostic in front.compile.diagnostics -> problems.push("{diagnostic.code} {diagnostic.what}")
        assert(front.compile.complete && front.compile.internal_problem == None && !jet_driver_has_errors(front.compile.diagnostics) && front.inputs != None, "recheck_verify {verify}: the program did not compile: {front.compile.internal_problem:Debug} {problems:Debug}")
        assert(trace.contains("counters.sema.local_values_spliced = "), "recheck_verify {verify}: `big` and `word` did not land in `run`:\n{trace}")
        assert(!trace.contains("counters.sema.local_values_refused"), "recheck_verify {verify}: a pass fell back to the full recheck:\n{trace}")
        assert(!trace.contains("> comptime.body.recheck"), "recheck_verify {verify}: the program was checked again after finalization:\n{trace}")
    }
    run_locals_files.remove(path) ?? panic("cannot remove the trace: {err}")
}
