// End-to-end checks for #7035 Wave 1B:
// - Checked `#Repeatable` (E0778) and `#Repeatable(key: ...)` stability (E0779)
// - Retried `#App.Job` unkeyed irreversible refusal (E0780) + `at_least_once: true` / `retries: 0` / keyed pass
// - Unified `EffectAccess` reader, library-effect access resolution, and reflection (`EffectInfo.access`, `EffectInfo.open_world`, `FunctionInfo.repeatable`)
use {
    test_files: core.files
    jet_cli.[
        jet_cli_compile_check,
        jet_cli_driver_request,
    ]
    jet_driver.[
        JetDriverAuthorizedSourceFile,
        JetDriverAuthorizedSourceRoot,
        JetDriverAuthorizedSourceSnapshot,
        JetDriverCompileMode,
        JetDriverCompileRequest,
        JetDriverCompileResult,
        JetDriverCoreSource,
        jet_driver_compile,
        jet_driver_core_text,
    ]
    jet_foundation.[
        BuildSettingOverride,
        Diagnostic,
        EffectAccess,
        TComptimeValue,
    ]
    jet_parser.[parse_source]
    jet_sema.[
        SemaLibraryEffectName,
        sema_comptime_reflection_effect_info,
        sema_comptime_reflection_func_repeatable,
        sema_effect_access,
        sema_effect_row_access,
    ]
}

effect_access_test_compile: fn(source: String, extra_core: [JetDriverCoreSource]{[JetDriverCoreSource]{}}) -> JetDriverCompileResult {
    snapshot: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{
            JetDriverAuthorizedSourceRoot{
                canonical_path: "/effect-access-fixture",
                identity: "effect-access-root",
                allow_hardlinks: false,
                files: [JetDriverAuthorizedSourceFile]{
                    JetDriverAuthorizedSourceFile{
                        path: "/effect-access-fixture/main.jet",
                        relative_path: "main.jet",
                        identity: "effect-access-file",
                        source: source,
                    },
                },
                foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
            },
        },
        entry_root_identity: "effect-access-root",
        entry_path: "/effect-access-fixture/main.jet",
    }
    request: jet_cli_driver_request(snapshot, extra_core, Val(1), JetDriverCompileMode.Check)
    jet_driver_compile(request)
}

effect_access_test_has_code: fn(diagnostics: [Diagnostic], code: String) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code == code -> return true
    }
    false
}

effect_access_test_error_codes: fn(diagnostics: [Diagnostic]) -> [String] Never! {
    ^codes: [String]{}
    loop diagnostic in diagnostics {
        if diagnostic.severity == 1 -> codes.push(diagnostic.code)
    }
    codes
}

#Test("effect_access_repeatable_refuses_non_repeatable_callee_and_accepts_leaves") {
    good: effect_access_test_compile(
        `read_only: fn() -[FS.Read]> Int Never! { 1 }

#Repeatable("same path overwrite is idempotent")
write_leaf: fn(path: String) -[FS.Write]> Int Never! { path.len() }

#Repeatable
sync_state: fn(path: String) -[FS.Read, FS.Write]> Int Never! {
    a: read_only()
    b: write_leaf(path)
    a + b
}

main: fn() -[FS.Read, FS.Write]> {
    _: sync_state("a.txt")
}
`,
    )
    assert_eq(effect_access_test_error_codes(good.diagnostics), [String]{})

    bad: effect_access_test_compile(
        `append_line: fn(path: String) -[FS.Write]> Int Never! { path.len() }

#Repeatable
bad_sync: fn(path: String) -[FS.Write]> Int Never! {
    append_line(path)
}

main: fn() -[FS.Write]> {
    _: bad_sync("a.txt")
}
`,
    )
    assert(effect_access_test_has_code(bad.diagnostics, "E0778"), "expected E0778 for #Repeatable calling non-repeatable append_line, got: {effect_access_test_error_codes(bad.diagnostics)}")
}

#Test("effect_access_repeatable_key_checks_stability_against_rand_and_time") {
    stable: effect_access_test_compile(
        `charge_card: fn(order_id: Int) -[Net]> Int Never! { order_id }

#Repeatable(key: "order:{order_id}")
charge_once: fn(order_id: Int) -[Net]> Int Never! {
    charge_card(order_id)
}

main: fn() -[Net]> {
    _: charge_once(42)
}
`,
    )
    assert_eq(effect_access_test_error_codes(stable.diagnostics), [String]{})

    bad_rand: effect_access_test_compile(
        `make_nonce: fn() -[Rand]> Int Never! { 7 }
charge_card: fn(order_id: Int) -[Net]> Int Never! { order_id }

#Repeatable(key: "order:{order_id}:{make_nonce()}")
charge_unstable_rand: fn(order_id: Int) -[Net]> Int Never! {
    charge_card(order_id)
}

main: fn() -[Net]> {
    _: charge_unstable_rand(42)
}
`,
    )
    assert(effect_access_test_has_code(bad_rand.diagnostics, "E0779"), "expected E0779 for #Repeatable(key:) reaching Rand, got: {effect_access_test_error_codes(bad_rand.diagnostics)}")

    bad_time: effect_access_test_compile(
        `stamp_now: fn() -[Time]> Int Never! { 9 }
charge_card: fn(order_id: Int) -[Net]> Int Never! { order_id }

#Repeatable(key: "order:{order_id}:{stamp_now()}")
charge_unstable_time: fn(order_id: Int) -[Net]> Int Never! {
    charge_card(order_id)
}

main: fn() -[Net]> {
    _: charge_unstable_time(42)
}
`,
    )
    assert(effect_access_test_has_code(bad_time.diagnostics, "E0779"), "expected E0779 for #Repeatable(key:) reaching Time, got: {effect_access_test_error_codes(bad_time.diagnostics)}")
}

effect_access_test_app_stub: fn() -> JetDriverCoreSource {
    JetDriverCoreSource{
        module_name: "app",
        alias: "app",
        path: "Core/app-stub.jet",
        owner: "",
        owned_members: [String]{},
        runtime: false,
        text: jet_driver_core_text(
            `Site: enum { Method }
Marker: trait { sites: [Site] }

Job: struct {
    retries: Int{5},
    at_least_once: Bool{false},
    impl Marker {
        sites: [.Method],
    }
}
`,
        ),
    }
}

#Test("effect_access_app_job_retry_refuses_unkeyed_irreversible_and_accepts_safe_forms") {
    bad_job: effect_access_test_compile(
        `use { app }

send_push: fn(id: Int) -[Net]> Int Never! { id }

Mailer: struct {
    #App.Job(retries: 3)
    notify: fn(self, id: Int) -[Net]> Int Never! {
        send_push(id)
    }
}

main: fn() -[Net]> {
    m: Mailer{}
    _: m.notify(1)
}
`,
        [JetDriverCoreSource]{effect_access_test_app_stub()},
    )
    assert(effect_access_test_has_code(bad_job.diagnostics, "E0780"), "expected E0780 for retried #App.Job reaching unkeyed irreversible Net, got: {effect_access_test_error_codes(bad_job.diagnostics)}")

    safe_jobs: effect_access_test_compile(
        `use { app }

send_push: fn(id: Int) -[Net]> Int Never! { id }

#Repeatable(key: "push:{id}")
send_push_once: fn(id: Int) -[Net]> Int Never! {
    send_push(id)
}

save_db: fn(id: Int) -[DB.Write]> Int Never! { id }

Mailer: struct {
    #App.Job(retries: 3, at_least_once: true)
    notify_at_least_once: fn(self, id: Int) -[Net]> Int Never! {
        send_push(id)
    }

    #App.Job(retries: 0)
    notify_no_retry: fn(self, id: Int) -[Net]> Int Never! {
        send_push(id)
    }

    #App.Job(retries: 3)
    notify_keyed: fn(self, id: Int) -[Net]> Int Never! {
        send_push_once(id)
    }

    #App.Job(retries: 3)
    save_only_reversible_db: fn(self, id: Int) -[DB.Write]> Int Never! {
        save_db(id)
    }
}

main: fn() -[Net, DB.Write]> {
    m: Mailer{}
    _: m.notify_at_least_once(1)
    _: m.notify_no_retry(2)
    _: m.notify_keyed(3)
    _: m.save_only_reversible_db(4)
}
`,
        [JetDriverCoreSource]{effect_access_test_app_stub()},
    )
    assert_eq(effect_access_test_error_codes(safe_jobs.diagnostics), [String]{})
}

#Test("effect_access_reader_and_reflection_project_access_open_world_and_repeatable") {
    library: [SemaLibraryEffectName]{
        SemaLibraryEffectName{written: "Journal.Append", kernel: [String]{"FS.Write"}, token: "pkg/Journal.Append", ancestors: [String]{}, access: EffectAccess.Adds},
    }
    assert_eq(sema_effect_access("FS.Read(\"data/\")", library), EffectAccess.Reads)
    assert_eq(sema_effect_access("pkg/Journal.Append", library), EffectAccess.Adds)
    assert_eq(sema_effect_row_access([String]{"FS.Read", "pkg/Journal.Append"}, library), EffectAccess.Adds)
    assert_eq(sema_effect_row_access([String]{"FS.Read", "Net"}, library), EffectAccess.Replaces)

    info: sema_comptime_reflection_effect_info(Val([String]{"FS.Read", "Net"}), None)
    ^saw_access: ""
    ^saw_open_world: false
    if info == .Struct(_, fields) {
        loop field in fields {
            if field.name == "access" {
                if field.value == .Enum(_, variant, _) -> saw_access = variant
            }
            if field.name == "open_world" {
                if field.value == .Bool(flag) -> saw_open_world = flag
            }
        }
    }
    assert_eq(saw_access, "Replaces")
    assert(saw_open_world, "Net must mark EffectInfo.open_world = true")

    parsed: parse_source(
        `read_fn: fn() -[FS.Read]> Int Never! { 1 }
write_fn: fn() -[FS.Write]> Int Never! { 1 }
#Repeatable("idempotent")
marked_fn: fn() -[FS.Write]> Int Never! { 1 }
`.bytes(),
    )
    assert_eq(parsed.diagnostics.len(), 0)
    parsed.program.items[0] == .Func(read_fn) ?? panic("expected read_fn")
    parsed.program.items[1] == .Func(write_fn) ?? panic("expected write_fn")
    parsed.program.items[2] == .Func(marked_fn) ?? panic("expected marked_fn")
    assert(sema_comptime_reflection_func_repeatable(read_fn, Val([String]{"FS.Read"})))
    assert(!sema_comptime_reflection_func_repeatable(write_fn, Val([String]{"FS.Write"})))
    assert(sema_comptime_reflection_func_repeatable(marked_fn, Val([String]{"FS.Write"})))
}

effect_access_check_real_file: fn(file: String) -> String {
    source: test_files.read(file) ?? panic("read {file}: {err}")
    out: jet_cli_compile_check(file, source, false, false, Val(1), false, false, false, [BuildSettingOverride]{}, "", false, None, false)
    out.stderr
}

effect_access_check_real_source: fn(source: String) -> String {
    dir: test_files.temp_dir("effect-access-real") ?? panic("temp_dir: {err}")
    file: "{dir.path}/main.jet"
    test_files.write(file, source) ?? panic("write: {err}")
    effect_access_check_real_file(file)
}

#Test("effect_access_get_route_enforces_handler_bound_and_refuses_mutations") {
    bad_mux_get: effect_access_check_real_source(
        `package: {
    name: "bad_mux_get"
    authority: { allow: [FS.Read, FS.Write, IO, Mem.Alloc, Net] }
}

use {
    files: core.files
    http_server: core.http.server
    web: core.web
}

run: fn() {
    mux: web.app()
    _: mux.get("/x", fn(_req: HTTPRequest) {
        files.remove("x") ?? ()
        Ok(http_server.response(200, "gone"))
    })
}
`,
    )
    assert(bad_mux_get.contains("Jet.GetRouteReachesMutation"), "expected E0781 on mux.get reaching FS.Write, got:\n{bad_mux_get}")

    bad_mux_get_bound: effect_access_check_real_source(
        `package: {
    name: "bad_mux_get_bound"
    authority: { allow: [FS.Read, Mem.Alloc, Net, Rand] }
}

use {
    http_server: core.http.server
    random: core.math.random
    web: core.web
}

run: fn() {
    mux: web.app()
    _: mux.get("/rand", fn(_req: HTTPRequest) {
        _: random.int(1, 10)
        Ok(http_server.response(200, "ok"))
    })
}
`,
    )
    assert(bad_mux_get_bound.contains("Jet.CallbackEffectBoundExceeded"), "expected E0747 on mux.get reaching Rand outside handler bound, got:\n{bad_mux_get_bound}")
    assert(!bad_mux_get_bound.contains("Jet.GetRouteReachesMutation"), "Rand is Reads and must not trigger E0781, got:\n{bad_mux_get_bound}")

    bad_custom_adds: effect_access_check_real_source(
        `package: {
    name: "bad_custom_adds"
    authority: { allow: [FS.Read, FS.Write, Mem.Alloc, Net] }
}

use {
    http_server: core.http.server
    web: core.web
}

#FX(FS.Write)
Journal: enum {
    Append,

    impl Effect {
        access: fn(self) -> EffectAccess { .Adds }
    }
}

append_entry: fn() -[Journal.Append]> Int Never! { 1 }

run: fn() {
    mux: web.app()
    _: mux.head("/journal", fn(_req: HTTPRequest) {
        _: append_entry()
        Ok(http_server.response(200, "ok"))
    })
}
`,
    )
    assert(bad_custom_adds.contains("Jet.GetRouteReachesMutation"), "expected E0781 on HEAD route reaching Adds effect, got:\n{bad_custom_adds}")

    bad_router_get: effect_access_check_real_source(
        `package: {
    name: "bad_router_get"
    authority: { allow: [FS.Read, FS.Write, Mem.Alloc, Net] }
}

use {
    files: core.files
    http: core.http
    http_server: core.http.server
}

run: fn() {
    router: http.router()
    router.get("/r", fn(_req: HTTPRequest) {
        _: files.read("a.txt") ?? ""
        Ok(http_server.response(200, "ok"))
    })
}
`,
    )
    assert(bad_router_get.contains("Jet.CallbackEffectBoundExceeded"), "expected E0747 on http.router().get reaching FS.Read outside -[Net]>, got:\n{bad_router_get}")
    assert(!bad_router_get.contains("Jet.GetRouteReachesMutation"), "FS.Read must not trigger E0781, got:\n{bad_router_get}")

    good_routes: effect_access_check_real_source(
        `package: {
    name: "good_routes"
    authority: { allow: [FS.Read, FS.Write, Mem.Alloc, Net] }
}

use {
    files: core.files
    http_server: core.http.server
    web: core.web
}

run: fn() {
    mux: web.app()
    _: mux.get("/file", fn(req: HTTPRequest) {
        Ok(http_server.static_file_range(req, "a.txt", "text/plain") ?? http_server.response(500, "err"))
    })
    _: mux.post("/delete", fn(_req: HTTPRequest) {
        files.remove("x") ?? ()
        Ok(http_server.response(200, "gone"))
    })
}
`,
    )
    assert(!good_routes.contains("Error:"), "expected good_routes to pass cleanly, got:\n{good_routes}")
}

#Test("effect_access_transact_refuses_irreversible_effects_and_accepts_reads") {
    bad_tx: effect_access_check_real_source(
        `use { files: core.files }

run: fn() {
    #Transact(tx) {
        files.write("x", "done") ?? ()
    }
}
`,
    )
    assert(bad_tx.contains("Jet.IrreversibleEffectInTransaction"), "expected E0746 on #Transact reaching FS.Write, got:\n{bad_tx}")

    good_tx: effect_access_check_real_source(
        `use { files: core.files }

run: fn() {
    #Transact(tx) {
        _: files.read("x")
    }
}
`,
    )
    assert(!good_tx.contains("Error:"), "expected good_tx to pass cleanly, got:\n{good_tx}")
}
