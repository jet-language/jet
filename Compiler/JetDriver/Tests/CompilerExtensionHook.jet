// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:533
// GATE #4494: native serialized process environment and real host fixture execution.
static ENV_LOCK: Mutex<Unit> = Mutex.new(())
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:534
fn env_lock() -> MutexGuard<Unit> Never! { ENV_LOCK.lock().unwrap_or_else(fn(poison) -> poison.into_inner()) }
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:537
static HOST_BUILD: Once = Once.new()
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:538
const SOURCE_X: String = "fn x() {}\n\nfn run() {\n    print(0)\n}\n\nfn dev() {\n    print(1)\n}\n"
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:540
const SOURCE_Y: String = "fn y() {}\n\nfn run() {\n    print(0)\n}\n\nfn dev() {\n    print(1)\n}\n"
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:543
fn fixture_wasm(name: String) -> OSPath Never! {
    ensure_jetpack_host_built()
    env.current_dir().expect("repository cwd").join(OSPath.from_text("crates/jet-pkg-model/fixtures/compiler_extension")).join(OSPath.from_text(name))
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:550
fn ensure_jetpack_host_built() -> Never! {
    HOST_BUILD.call_once(fn() -> Never! {
        // Build the Jet-authored sibling host rather than invoking Cargo/Rust.
        status :: Command.new("jet").args([String]{"build", "Jetpack/CLI"}).current_dir(env.current_dir().expect("repository cwd")).status().expect("start jetpack compiler-extension host build")
        assert(status.success(), "build jetpack compiler-extension host")
    })
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:562
#Test("missing_sibling_never_falls_back_to_path") {
    dir :: tempfile_dir()
    exe :: dir.join(OSPath.from_text("debug/deps/jet-driver-test"))
    suffix :: if core.sys.target.selected_os() == "windows" -> ".exe" else -> ""
    candidates :: compiler_extension_host_candidates(&exe)
    assert(candidates == [OSPath]{dir.join(OSPath.from_text("debug/deps/jetpack{suffix}")), dir.join(OSPath.from_text("debug/jetpack{suffix}"))})
    error :: compiler_extension_host_path_for(&exe).expect_err("missing sibling must fail")
    assert(error.message.contains("missing beside the Jet compiler"))
    fs.remove_dir_all(dir)!
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:582
#Test("oversized_ipc_request_is_rejected_before_spawn") {
    command :: Command.new("this-host-must-not-run")
    request :: [U8].filled(EXTENSION_MAX_SNAPSHOT_BYTES + 1, U8{0})
    error :: run_host_process(^command, ^request, 1, Duration.from_millis(10)).expect_err("oversized request must fail before spawn")
    assert(error.message.contains("snapshot exceeds IPC limit"))
    assert(!error.message.contains("couldn't start"))
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:597
#Test("oversized_ipc_response_is_rejected") {
    if core.sys.target.selected_family() == "unix" {
        command := Command.new("sh")
        command.args([String]{"-c", "head -c 300000 /dev/zero", "compiler-extension-host"})
        error :: run_host_process(^command, "snapshot".as_bytes().to_list(), 128, Duration.from_secs(1)).expect_err("oversized response must fail")
        assert(error.message == "compiler-extension host response exceeds IPC limit (128 bytes)")
    }
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:610
#Test("timeout_kills_and_reaps_host_process") {
    if core.sys.target.selected_family() == "unix" {
        dir :: tempfile_dir(); pid_file :: dir.join(OSPath.from_text("host.pid"))
        command := Command.new("sh")
        command.arg("-c").arg("printf '%s' \"$$\" > \"$1\"; exec sleep 60").arg("compiler-extension-host").arg(pid_file)
        error :: run_host_process(^command, "snapshot".as_bytes().to_list(), 128, Duration.from_millis(100)).expect_err("stuck host must time out")
        assert(error.message == "compiler-extension host timed out after 100ms")
        pid :: fs.read_to_string(pid_file).expect("host must record pid")
        trimmed := pid.trim() // #4303
        alive :: Command.new("kill").args([String]{"-0", trimmed.to_string()}).stdout(Stdio.null()).stderr(Stdio.null()).status().expect("probe host pid")
        assert(!alive.success(), "timed-out host pid {pid} must be reaped")
        fs.remove_dir_all(dir)!
    }
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:640
#Test("nonzero_host_stderr_is_sanitized_before_e1402") {
    if core.sys.target.selected_family() == "unix" {
        command := Command.new("sh")
        command.args([String]{"-c", "printf 'rustc error[E0123] leaked\\nsecond line\\n' >&2; exit 9", "compiler-extension-host"})
        error :: run_host_process(^command, "snapshot".as_bytes().to_list(), 128, Duration.from_secs(1)).expect_err("nonzero host must fail")
        assert(error.message.contains("rustc error[E0123]"))
        sanitized :: sanitize_host_message(error.message)
        assert(sanitized == "compiler-extension failed with an internal message")
        diagnostic :: host_failure(sanitized, None)
        assert(diagnostic.code == "E1402")
        assert(!pkg_extension_message_exposes_rustc(diagnostic.what))
    }
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:661
#Test("post_sema_custom_lint_from_driver_env") {
    guard :: env_lock(); dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, SOURCE_X)!
    wasm :: fixture_wasm("lint_no_x.wasm")
    env.set_var(EXTENSION_ENV_COMPILER_EXTENSION, wasm.to_text().expect("fixture path UTF8"))
    (diags, bundle, _) :: Driver.check_file_with_effect_facts(src_path.to_text().expect("source path UTF8"), None, false)
    env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    assert(bundle != None, "sema must succeed; diags={diags}")
    lint :: diags.iter().find(fn(d) -> d.code == "L1401") ?? panic("custom-lint finding must surface as L1401; diags={diags}")
    assert(lint.what.contains("no-x"), "got {lint.what}")
    assert(lint.what.contains("prefer y"), "got {lint.what}")
    assert(!pkg_extension_message_exposes_rustc(lint.what)); assert(!pkg_extension_message_exposes_rustc(lint.why))
}
