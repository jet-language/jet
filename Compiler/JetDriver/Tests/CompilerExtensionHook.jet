// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:878
#Test("check_and_run_mode_effect_fact_snapshots_byte_identical") {
    guard :: env_lock(); env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, SOURCE_X)!
    path :: src_path.to_text().expect("source path UTF8")
    bundle_check := Loader.load_entry_with_overlay(path, None, false).expect("load check")
    (diags_c, facts_c) :: check_bundle_with_effect_facts(&bundle_check, CompileMode.Check)
    assert(!diags_c.iter().any(fn(d) -> d.severity == Severity.Error), "Check sema must succeed; diags={diags_c}")
    enc_check :: snapshot_from_bundle(&bundle_check, Val(&facts_c)).expect("check snapshot").encode().expect("encode check")
    bundle_run := Loader.load_entry_with_overlay(path, None, false).expect("load run")
    (diags_r, facts_r) :: check_bundle_with_effect_facts(&bundle_run, CompileMode.Run)
    assert(!diags_r.iter().any(fn(d) -> d.severity == Severity.Error), "Run sema must succeed; diags={diags_r}")
    enc_run :: snapshot_from_bundle(&bundle_run, Val(&facts_r)).expect("run snapshot").encode().expect("encode run")
    assert(enc_check == enc_run, "Check vs Run typed snapshots must be byte-identical when both have effect facts")
    snap :: snapshot_from_bundle(&bundle_check, Val(&facts_c))!
    assert(snap.abilities.contains(ExtensionAbility.ReadEffects), "fact-bearing snapshots must advertise ReadEffects; caps={snap.abilities}")
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:934
#Test("check_and_build_surface_same_l1401") {
    guard :: env_lock(); dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, SOURCE_X)!
    path :: src_path.to_text().expect("source path UTF8"); wasm :: fixture_wasm("lint_no_x.wasm")
    env.set_var(EXTENSION_ENV_COMPILER_EXTENSION, wasm.to_text().expect("fixture path UTF8"))
    (check_diags, bundle, _) :: Driver.check_file_with_effect_facts(path, None, false)
    assert(bundle != None, "check sema must succeed; diags={check_diags}")
    check_lint :: check_diags.iter().find(fn(d) -> d.code == "L1401") ?? panic("check must surface L1401; diags={check_diags}")
    build_out :: Driver.compile_bundle_path_build(path, Driver.BuildRunOptions.default())
    env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    build_out :: build_out.unwrap_or_else(fn(errors) -> panic("build must succeed with lint-only guest; errs={errors}"))
    build_lint :: build_out.compile.lints.iter().find(fn(d) -> d.code == "L1401") ?? panic("build must surface L1401; lints={build_out.compile.lints}")
    assert(check_lint.what == build_lint.what); assert(check_lint.why == build_lint.why)
    assert(check_lint.what.contains("no-x")); assert(check_lint.what.contains("prefer y"))
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:983
#Test("aot_opts_full_and_dev_entry_swap_surface_same_l1401") {
    guard :: env_lock(); dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, SOURCE_X)!
    path :: src_path.to_text().expect("source path UTF8"); wasm :: fixture_wasm("lint_no_x.wasm")
    env.set_var(EXTENSION_ENV_COMPILER_EXTENSION, wasm.to_text().expect("fixture path UTF8"))
    aot :: Driver.compile_bundle_path_opts(path, CompileMode.Run, false, Policy.GateSet.default(), false, None).unwrap_or_else(fn(errors) -> panic("opts_full must succeed with lint guest; errs={errors}"))
    aot_lint :: aot.lints.iter().find(fn(d) -> d.code == "L1401") ?? panic("opts_full must surface L1401; lints={aot.lints}")
    dev :: Driver.compile_bundle_path_with_entry(path, "dev").unwrap_or_else(fn(errors) -> panic("entry-swap must succeed with lint guest; errs={errors}"))
    dev_lint :: dev.lints.iter().find(fn(d) -> d.code == "L1401") ?? panic("entry-swap must surface L1401; lints={dev.lints}")
    assert(aot_lint.what == dev_lint.what); assert(aot_lint.why == dev_lint.why)
    negative_path :: dir.join(OSPath.from_text("negative.jet"))
    fs.write(negative_path, SOURCE_Y)!
    negative :: negative_path.to_text().expect("source path UTF8")
    aot_negative :: Driver.compile_bundle_path_opts(negative, CompileMode.Run, false, Policy.GateSet.default(), false, None).expect("negative opts_full must succeed")
    dev_negative :: Driver.compile_bundle_path_with_entry(negative, "dev").expect("negative entry-swap must succeed")
    env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    assert(!aot_negative.lints.iter().any(fn(d) -> d.code == "L1401") && !dev_negative.lints.iter().any(fn(d) -> d.code == "L1401"), "AOT/dev must both omit no-x lint for non-x facts; aot={aot_negative.lints}, dev={dev_negative.lints}")
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:1044
fn tempfile_dir() -> OSPath Never! {
    nanos :: SystemTime.now().duration_since(UNIX_EPOCH).expect("host time after epoch").as_nanos()
    dir :: env.temp_dir().join(OSPath.from_text("jet-cex-hook-{std.process.id()}-{nanos}"))
    fs.create_dir_all(dir).expect("create fixture dir")
    dir
}
