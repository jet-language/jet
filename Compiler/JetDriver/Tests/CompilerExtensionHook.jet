}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:721
#Test("sema_error_never_executes_crash_guest") {
    guard :: env_lock(); dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, "fn run() {\n    print(missing)\n}\n")!
    wasm :: fixture_wasm("crash.wasm")
    env.set_var(EXTENSION_ENV_COMPILER_EXTENSION, wasm.to_text().expect("fixture path UTF8"))
    (diags, bundle, _) :: Driver.check_file_with_effect_facts(src_path.to_text().expect("source path UTF8"), None, false)
    env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    assert(bundle != None, "loader should return sema-invalid bundle")
    assert(diags.len() == 1, "only Jet sema failure should surface")
    assert(diags[0].code == "E0107", "got {diags}")
    assert(!diags.iter().any(fn(d) -> d.code == "E1402" || d.code == "L1401"), "guest must not execute after sema failure; diags={diags}")
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:741
#Test("snapshot_uses_solved_effects_not_invented_pure") {
    guard :: env_lock(); env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, "fn run() {\n    print(1)\n}\n")!
    (diags, bundle, facts) :: Driver.check_file_with_effect_facts(src_path.to_text().expect("source path UTF8"), None, false)
    assert(!diags.iter().any(fn(d) -> d.severity == Severity.Error), "sema must succeed; diags={diags}")
    bundle :: bundle.expect("bundle")
    snap :: snapshot_from_bundle(&bundle, Val(&facts)).expect("snapshot")
    assert(snap.abilities.contains(ExtensionAbility.ReadEffects), "facts present → advertise ReadEffects")
    run :: snap.symbols.iter().find(fn(s) -> s.name == "run").expect("run symbol")
    assert(!run.effects.iter().any(fn(e) -> e == "pure"), "must not invent effect name `pure`; got {run.effects}")
    assert(run.effects.iter().any(fn(e) -> e == "IO" || e == "Log"), "print must solve to a real effect; got {run.effects}")
    assert(snap.types.iter().any(fn(t) -> t.id == run.type_id && t.repr.starts_with("fn(")), "type_id must point at a real fn signature repr; types={snap.types}")
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:788
#Test("snapshot_without_effect_facts_omits_read_effects") {
    guard :: env_lock(); env.remove_var(EXTENSION_ENV_COMPILER_EXTENSION)
    dir :: tempfile_dir(); src_path :: dir.join(OSPath.from_text("main.jet"))
    fs.write(src_path, "fn run() {\n    print(1)\n}\n")!
    (diags, bundle, _) :: Driver.check_file_with_effect_facts(src_path.to_text().expect("source path UTF8"), None, false)
    assert(!diags.iter().any(fn(d) -> d.severity == Severity.Error), "sema must succeed; diags={diags}")
    bundle :: bundle.expect("bundle")
    snap :: snapshot_from_bundle(&bundle, None).expect("snapshot")
    assert(!snap.abilities.contains(ExtensionAbility.ReadEffects), "None facts must omit ReadEffects; caps={snap.abilities}")
    loop sym in snap.symbols {
        assert(sym.effects.is_empty(), "None facts → empty effects (no invented pure); {sym.name} got {sym.effects}")
        assert(!sym.effects.iter().any(fn(e) -> e == "pure"), "must not invent `pure`")
    }
}
