// Assemble with the Compiler source unit. Exercises the real authorized
// loader/checker/lowerer; no disk source mutation or synthesized `run`.
fn seams_require(ok: Bool, detail: String) Never! {
    if !ok -> panic("CLISeams: {detail}")
}
fn seams_request(source: String, mode: JetDriverCompileMode) -> JetDriverCompileRequest {
    snapshot :: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/seams-fixture",
            identity: "seams-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/seams-fixture/main.jet", relative_path: "main.jet", identity: "seams-file", source: source}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "seams-root",
        entry_path: "/seams-fixture/main.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), mode)
    request.schema_snapshots = Val([String:SchemaSnapshot]{})
    request
}
fn run() {
    // A valid parse with an intentionally undefined body succeeds in the
    // load-only query. A semantic check instead would report E0102.
    load_request :: seams_request("fn serve() { undefined_call() }", JetDriverCompileMode.Doc)
    loaded :: jet_driver_source_query(load_request)
    seams_require(loaded.complete && loaded.diagnostics.len() == 0 && loaded.modules.len() == 1, "load-only, not a disguised check")
    seams_require(loaded.modules[0].physical_path == "/seams-fixture/main.jet" && loaded.modules[0].source == "fn serve() { undefined_call() }", "exact authorized source provenance")
    malformed :: jet_driver_source_query(seams_request("fn serve( {", JetDriverCompileMode.Doc))
    seams_require(!malformed.complete && malformed.diagnostics.len() > 0, "loader failures preserved")
    // Named jobs remain callable under their declared name, even with a stock
    // run, and the same declared body is the MIR entry on every execution mode.
    loop mode in ([JetDriverCompileMode]{JetDriverCompileMode.Program, JetDriverCompileMode.Doc, JetDriverCompileMode.Eval, JetDriverCompileMode.Interpreter}) {
        request := seams_request("#Job fn serve() Int { 7 }\nfn caller() Int { serve() }\nfn run() Int { 9 }", mode)
        request.selected_entry = Val("serve")
        result := jet_driver_compile_mir(^request)
        seams_require(result.complete && result.internal_problem == None && !jet_driver_has_errors(result.diagnostics), "named job compile")
        entry :: result.entry_function ?? panic("selected entry missing")
        program := ^result.mir ?? panic("selected MIR missing")
        selected := false
        loop function in program.functions {
            if function.id == entry && function.name == "serve" -> selected = true
        }
        seams_require(selected, "entry is the declared function, not a run wrapper")
        job_retained := false
        loop job in program.jobs { if job.name == "serve" && job.function == entry -> job_retained = true }
        seams_require(job_retained, "canonical checked Job metadata binds selected entry")
        evaluated := jet_eval_function(^program, entry, [TComptimeValue]{}, jet_eval_default_config())
        value :: jet_eval_comptime_value(&evaluated, Span{start: 0, end: 0})
        seams_require(value == Val(TComptimeValue.Int{value: 7}), "selected declared body executes")
    }
    // A named generator does not need a synthetic or pre-existing run body.
    generate := seams_request("#Job fn generate_files() Int { 3 }", JetDriverCompileMode.Program)
    generate.selected_entry = Val("generate_files")
    generated :: jet_driver_compile_mir(^generate)
    seams_require(generated.complete && generated.entry_function != None && generated.internal_problem == None, "generate selects declared Job without fn run")
    // Eval's existing canonical purity pass must attribute a transitive effect
    // through checked TIR calls, including calls nested in a conditional.
    pure := seams_request("fn leaf() { print(\"effect\") }\nfn helper() { if true { leaf() } }\nfn evaluate() { helper() }\nfn run() { }", JetDriverCompileMode.Eval)
    pure.selected_entry = Val("evaluate")
    impure :: jet_driver_compile_mir(^pure)
    chain := false
    loop diagnostic in impure.diagnostics {
        if diagnostic.code == "E3401" {
            seams_require(diagnostic.call_chain == ([String]{"evaluate", "helper", "leaf", "print"}), "full checked transitive pure chain")
            chain = true
        }
    }
    seams_require(chain && !impure.complete, "eval pure root rejects effect")
    // Build's E0910 uses the populated semantic graph, not advisory status.
    schema := seams_request("#PublishedSchema struct Account { name: String; verified: Bool }\nfn run() { }", JetDriverCompileMode.Doc)
    baseline :: SchemaSnapshot{schema_version: U32{1}, type_name: "Account", published_version: "1.0.0", squashed_before: None, fields: [SnapshotField]{SnapshotField{name: "name", ty: "String"}}}
    schema.schema_snapshots = Val([String:SchemaSnapshot]{"Account": baseline})
    breaking :: jet_driver_compile_mir(^schema)
    schema_error := false
    loop diagnostic in breaking.diagnostics { if diagnostic.code == "E0910" -> schema_error = true }
    seams_require(schema_error && !breaking.complete && breaking.mir == None, "schema fails before codegen")
    parsed :: parse_source("#PublishedSchema struct Account { name: String; verified: Bool }".bytes())
    pending :: jet_driver_schema_pending_breaks([[Item]{parsed.program.items[0]}], [String:SchemaSnapshot]{"Account": baseline})
    seams_require(pending == ([String]{"Account"}), "status reuses advisory sema diff")
}
