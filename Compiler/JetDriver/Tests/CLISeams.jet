// Assemble with the Compiler source unit. Exercises the real authorized
// loader/checker/lowerer; no disk source mutation or synthesized `run`.
use jet_driver.[
    JET_DRIVER_CORE_SOURCE_ROOT, JetDriverAuthorizedSourceFile, JetDriverAuthorizedSourceRoot,
    JetDriverAuthorizedSourceSnapshot, JetDriverCompileMode, JetDriverCompileRequest,
    JetDriverCoreSource, JetDriverLoweringInputsResult, jet_driver_checked_projection,
    jet_driver_compile, jet_driver_has_errors, jet_driver_invocation_run, jet_driver_load, jet_driver_lowering_inputs,
    jet_driver_module_display, jet_driver_registration_module_inputs,
    jet_driver_schema_pending_breaks, jet_driver_source_query,
]
use jet_cli.[jet_cli_checked_semindex, jet_cli_driver_request]
use jet_sema.[SchemaSnapshot, SemaForeignProviderInput, SnapshotField]
use jet_foundation.[Diagnostic, Item, Span, TComptimeValue]
use jet_eval.[jet_eval_default_config]
use jet_parser.[parse_source]

fn seams_require(ok: Bool, detail: String) Never! {
    if !ok -> panic("CLISeams: {detail}")
}
fn seams_request(source: String, mode: JetDriverCompileMode) -> JetDriverCompileRequest {
    snapshot :: JetDriverAuthorizedSourceSnapshot{
        roots: [JetDriverAuthorizedSourceRoot]{JetDriverAuthorizedSourceRoot{
            canonical_path: "/seams-fixture",
            identity: "seams-root",
            allow_hardlinks: false,
            files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/seams-fixture/main.jet", relative_path: "main.jet", identity: "seams-file", source: source}},
            foreign_cache_files: [JetDriverAuthorizedSourceFile]{},
        }},
        entry_root_identity: "seams-root",
        entry_path: "/seams-fixture/main.jet",
    }
    request := jet_cli_driver_request(snapshot, [JetDriverCoreSource]{}, Val(1), mode)
    request.schema_snapshots = Val([String:SchemaSnapshot]{})
    request
}
fn seams_package_request(version: String?) -> JetDriverCompileRequest {
    request := seams_request("fn serve() {{ undefined_call() }}", JetDriverCompileMode.Doc)
    manifest := "name: \"seams_package\"\n"
    if version == .Val(value) -> manifest = "{manifest}version: \"{value}\"\n"
    &request.authorized_sources.roots[0].files.push(JetDriverAuthorizedSourceFile{path: "/seams-fixture/package.jet", relative_path: "package.jet", identity: "seams-manifest", source: manifest})
    request
}

// The name of the checked function the compile stopped before lowering names
// as its executable entry; None for a library or a compile that failed.
fn seams_entry_name(front: JetDriverLoweringInputsResult) -> String? Never! {
    if front.inputs == .Val(checked) {
        if checked.entry_key == .Val(key) {
            loop function in checked.functions {
                if function.key == key -> return Val(function.name.copy())
            }
        }
    }
    None
}

fn seams_registration_inputs(request: JetDriverCompileRequest, expected_source_rows: Int) {
    load :: jet_driver_load(request)
    seams_require(load.complete && !jet_driver_has_errors(load.diagnostics), "registration fixture uses the real completed loader")
    diagnostics := [Diagnostic]{}
    inputs :: jet_driver_registration_module_inputs(load.modules, load.source_units, load.source_files, [SemaForeignProviderInput]{}, &diagnostics) ?? panic("canonical registration inputs missing")
    seams_require(diagnostics.len() == 0 && inputs.len() == load.modules.len(), "one canonical registration input per loaded module")
    source_rows := 0
    loop position in 0..<inputs.len() {
        row :: inputs[position]
        module_row :: load.modules[position]
        seams_require(module_row.source_unit_index >= 0 && module_row.source_unit_index < load.source_units.len(), "ABI fallback still has a real catalog unit")
        unit :: load.source_units[module_row.source_unit_index]
        seams_require(row.package_identity == module_row.package_identity && row.module_identity == module_row.module_identity && row.module_name == module_row.module_name, "canonical module identities and registration order survive")
        seams_require(row.module_path == jet_driver_module_display(unit.relative_path) && row.source_file == unit.path && row.source_origin == unit.source_origin, "canonical source location and origin survive")
        seams_require(row.source_segments.len() == unit.source_segments.len(), "canonical source segment count survives")
        loop segment_index in 0..<row.source_segments.len() {
            actual :: row.source_segments[segment_index]
            expected :: unit.source_segments[segment_index]
            seams_require(actual.generated.start == expected.generated.start && actual.generated.end == expected.generated.end && actual.source_file == expected.source_file && actual.source_start == expected.source_start && actual.line_starts == expected.line_starts && actual.origin == expected.origin, "canonical source segments survive unchanged")
        }
        found_source := false
        loop file in load.source_files {
            if file.path == unit.path {
                seams_require(row.source == file.source, "real source bytes survive including empty Core and private files")
                found_source = true
            }
        }
        if found_source -> source_rows += 1
        else -> seams_require(row.source == "" && unit.root_index == -1 && unit.file_index == -1 && unit.root_identity == JET_DRIVER_CORE_SOURCE_ROOT, "only explicit metadata ABI fallback lacks a source-file row")
    }
    seams_require(source_rows == expected_source_rows, "source and metadata-only rows remain distinct")
}

fn seams_checked_projection() {
    source :: "fn serve() -> Int {{ 7 }}"
    retained :: jet_driver_checked_projection(seams_request(source, JetDriverCompileMode.Check))
    seams_require(retained.compile.complete && retained.compile.internal_problem == None, "retained Check stops after the actual completed front end")
    entry :: retained.entry_module ?? panic("checked canonical entry missing")
    seams_require(retained.source_modules.contains(entry) && retained.compile.doc_modules[entry].source == source && retained.compile.doc_modules[entry].physical_path == "/seams-fixture/main.jet", "canonical entry binds the owned immutable source")
    index :: jet_cli_checked_semindex(retained.compile)
    seams_require(index.definition_facts.len() > 0, "existing SemIndex consumes the same settled checked rows")
    loop module_row in retained.compile.doc_modules {
        seams_require(module_row.name_ledger != None && module_row.memory_facts != None && module_row.gate_ledger != None, "retained checked ledgers are not fabricated or discarded")
    }
    fallback_request :: seams_request("use core.devtools as tools\nfn serve() -> Int {{ 7 }}", JetDriverCompileMode.Check)
    seams_registration_inputs(fallback_request, 1)
    fallback :: jet_driver_checked_projection(fallback_request)
    seams_require(fallback.compile.complete && fallback.compile.doc_modules.len() == 2 && fallback.source_modules.len() == 1, "explicit ABI-only Core fallback stays checked but is not a Review source")
    real_request := seams_request("use core.devtools as tools\nfn serve() -> Int {{ 7 }}", JetDriverCompileMode.Check)
    real_request.core_sources = [JetDriverCoreSource]{
        {module_name: "core.devtools", alias: "core_devtools_fixture", path: "Core/devtools-fixture.jet", owner: "", owned_members: [String]{}, runtime: false, source: ""},
        {module_name: "core.devtools.fixture_private", alias: "core_devtools_fixture_private", path: "Core/devtools-fixture-private.jet", owner: "core.devtools", owned_members: [String]{}, runtime: false, source: ""},
    }
    seams_registration_inputs(real_request, 3)
    real :: jet_driver_checked_projection(real_request)
    seams_require(real.compile.complete && real.compile.doc_modules.len() == 3 && real.source_modules.len() == 3, "empty real Core source and its private source remain source owners")
    found_core := false
    found_private := false
    loop position in real.source_modules {
        module_row :: real.compile.doc_modules[position]
        if module_row.module_name == "core.devtools" {
            seams_require(module_row.source == "" && module_row.path == "Core/devtools-fixture.jet" && module_row.physical_path == "<corelib>/Core/devtools-fixture.jet" && module_row.alias == "core_devtools_fixture", "real Core path and alias come from its canonical source row")
            found_core = true
        }
        if module_row.module_name == "core.devtools.fixture_private" -> found_private = true
    }
    seams_require(found_core && found_private, "private and public Core source identities survive the bijection")
    empty :: jet_driver_checked_projection(seams_request("", JetDriverCompileMode.Check))
    seams_require(empty.compile.complete && empty.source_modules.len() == 1, "an empty authorized file is still a real source owner")
    failed :: jet_driver_checked_projection(seams_request("fn serve() {{ undefined_call() }}", JetDriverCompileMode.Check))
    seams_require(!failed.compile.complete && failed.source_modules.len() == 0 && failed.entry_module == None, "failed checking does not publish a complete projection")
    legacy :: jet_driver_compile(seams_request(source, JetDriverCompileMode.Doc))
    seams_require(legacy.complete && legacy.doc_modules.len() == 1, "legacy Doc keeps its existing user-only path")
}
#Test("cli_seams") {
    seams_checked_projection()
    // A valid parse with an intentionally undefined body succeeds in the
    // load-only query. A semantic check instead would report E0102.
    load_request :: seams_request("fn serve() {{ undefined_call() }}", JetDriverCompileMode.Doc)
    loaded :: jet_driver_source_query(load_request)
    seams_require(loaded.complete && loaded.diagnostics.len() == 0 && loaded.modules.len() == 1, "load-only, not a disguised check")
    seams_require(loaded.modules[0].physical_path == "/seams-fixture/main.jet" && loaded.modules[0].source == "fn serve() {{ undefined_call() }}", "exact authorized source provenance")
    seams_require(loaded.entry_package_version == None, "loose source has no declared package version")
    loop version in ([String?]{Val("2.3.4"), None, Val("")}) {
        package_loaded :: jet_driver_source_query(seams_package_request(version))
        seams_require(package_loaded.complete && package_loaded.entry_package_version == version, "exact declared version distinguishes omitted and empty")
    }
    inline_loaded :: jet_driver_source_query(seams_request("package {{ name: \"inline_seams\", version: \"4.5.6\" }}\nfn serve() {{ undefined_call() }}", JetDriverCompileMode.Doc))
    seams_require(inline_loaded.complete && inline_loaded.entry_package_version == (Val("4.5.6")), "inline Package version comes from the same loader")
    entry_version := seams_package_request(Val("7.8.9"))
    &entry_version.authorized_sources.roots.push(JetDriverAuthorizedSourceRoot{canonical_path: "/seams-other", identity: "seams-other-root", allow_hardlinks: false, files: [JetDriverAuthorizedSourceFile]{JetDriverAuthorizedSourceFile{path: "/seams-other/package.jet", relative_path: "package.jet", identity: "seams-other-manifest", source: "name: \"other\"\nversion: \"1.1.1\"\n"}}, foreign_cache_files: [JetDriverAuthorizedSourceFile]{}})
    selected_version :: jet_driver_source_query(entry_version)
    seams_require(selected_version.complete && selected_version.entry_package_version == (Val("7.8.9")), "version is selected by entry package identity, not root order")
    malformed :: jet_driver_source_query(seams_request("fn serve( {{", JetDriverCompileMode.Doc))
    seams_require(!malformed.complete && malformed.diagnostics.len() > 0, "loader failures preserved")
    // Named jobs remain callable under their declared name, even with a stock
    // run: the same declared body is the checked entry of every mode, and the
    // executing modes evaluate it.
    job_source :: "#Job fn serve() -> Int {{ 7 }}\nfn caller() -> Int {{ serve() }}\nfn run() -> Int {{ 9 }}"
    loop mode in ([JetDriverCompileMode]{JetDriverCompileMode.Program, JetDriverCompileMode.Doc}) {
        request := seams_request(job_source, mode)
        request.selected_entry = Val("serve")
        front :: jet_driver_lowering_inputs(^request, None)
        seams_require(front.compile.complete && front.compile.internal_problem == None && !jet_driver_has_errors(front.compile.diagnostics), "named job check")
        seams_require(seams_entry_name(front) == Val("serve"), "entry is the declared function, not a run wrapper")
    }
    loop mode in ([JetDriverCompileMode]{JetDriverCompileMode.Eval, JetDriverCompileMode.Interpreter}) {
        request := seams_request(job_source, mode)
        request.selected_entry = Val("serve")
        front := jet_driver_lowering_inputs(^request, None)
        seams_require(front.compile.complete && front.compile.internal_problem == None && !jet_driver_has_errors(front.compile.diagnostics), "named job compile")
        seams_require(seams_entry_name(front) == Val("serve"), "entry is the declared function, not a run wrapper")
        inputs := ^front.inputs ?? panic("selected checked inputs missing")
        run :: jet_driver_invocation_run(^inputs, [TComptimeValue]{}, jet_eval_default_config(), Span{start: 0, end: 0})
        evaluated :: run.result ?? panic(run.problem ?? "selected entry did not build")
        seams_require(evaluated.value == (Val(TComptimeValue.Int{value: 7})), "selected declared body executes")
    }
    // A named generator does not need a synthetic or pre-existing run body.
    generate := seams_request("#Job fn generate_files() -> Int {{ 3 }}", JetDriverCompileMode.Program)
    generate.selected_entry = Val("generate_files")
    generated :: jet_driver_lowering_inputs(^generate, None)
    seams_require(generated.compile.complete && generated.compile.internal_problem == None && seams_entry_name(generated) == Val("generate_files"), "generate selects declared Job without fn run")
    // Rust artifact_plan.rs `lower_entry`: with no selected Output and no
    // manifest entry, the executable entry is the entry module's `fn run`;
    // without one the package lowers as a library, with no entry.
    plain :: jet_driver_lowering_inputs(seams_request("fn helper() -> Int {{ 1 }}\nfn run() {{ print(helper()) }}", JetDriverCompileMode.Program), None)
    seams_require(plain.compile.complete && seams_entry_name(plain) == Val("run"), "no-output package selects its `fn run` as the executable entry")
    library :: jet_driver_lowering_inputs(seams_request("fn helper() -> Int {{ 1 }}", JetDriverCompileMode.Program), None)
    // Stays true unless the compile returns its checked inputs with no entry.
    library_entry := true
    if library.inputs == .Val(checked) -> library_entry = checked.entry_key != None
    seams_require(library.compile.complete && !library_entry, "no `fn run` and no outputs: library, no entry")
    // Eval's existing canonical purity pass must attribute a transitive effect
    // through checked TIR calls, including calls nested in a conditional.
    pure := seams_request("fn leaf() {{ print(\"effect\") }}\nfn helper() {{ if true {{ leaf() }} }}\nfn evaluate() {{ helper() }}\nfn run() {{ }}", JetDriverCompileMode.Eval)
    pure.selected_entry = Val("evaluate")
    impure :: jet_driver_compile(^pure)
    chain := false
    loop diagnostic in impure.diagnostics {
        if diagnostic.code == "E3401" {
            seams_require(diagnostic.call_chain == ([String]{"evaluate", "helper", "leaf", "print"}), "full checked transitive pure chain")
            chain = true
        }
    }
    seams_require(chain && !impure.complete, "eval pure root rejects effect")
    // Build's E0910 uses the populated semantic graph, not advisory status.
    schema := seams_request("#PublishedSchema struct Account {{\n    name: String\n    verified: Bool\n}}\nfn run() {{ }}", JetDriverCompileMode.Doc)
    baseline :: SchemaSnapshot{schema_version: U32{1}, type_name: "Account", published_version: "1.0.0", squashed_before: None, fields: [SnapshotField]{SnapshotField{name: "name", ty: "String"}}}
    schema.schema_snapshots = Val([String:SchemaSnapshot]{"Account": baseline})
    breaking :: jet_driver_compile(^schema)
    schema_error := false
    loop diagnostic in breaking.diagnostics { if diagnostic.code == "E0910" -> schema_error = true }
    seams_require(schema_error && !breaking.complete, "schema fails in the checker")
    schema_check := seams_request("#PublishedSchema struct Account {{\n    name: String\n    verified: Bool\n}}\nfn serve() {{ }}", JetDriverCompileMode.Check)
    schema_check.schema_snapshots = Val([String:SchemaSnapshot]{"Account": baseline})
    schema_retained :: jet_driver_checked_projection(schema_check)
    seams_require(!schema_retained.compile.complete && schema_retained.source_modules.len() == 0, "retained schema failure is still a checker failure")
    ingress :: schema_retained.schema_ingress ?? panic("supplied schema input was discarded")
    if ingress == {
        .Supplied(snapshots) -> seams_require(snapshots.get("Account") == Val((baseline)), "supplied schema map remains a distinct actual input")
        else -> panic("supplied schema map was confused with a disk cache read")
    }
    parsed :: parse_source("#PublishedSchema struct Account {{\n    name: String\n    verified: Bool\n}}".bytes())
    pending :: jet_driver_schema_pending_breaks([[Item]{parsed.program.items[0]}], [String:SchemaSnapshot]{"Account": baseline})
    seams_require(pending == ([String]{"Account"}), "status reuses advisory sema diff")
}
