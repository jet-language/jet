// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:28
const MAX_HOST_STDERR_BYTES: USize = 64 * 1024
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:38
pub fn post_sema_diagnostics(bundle: &ProgramBundle, effect_facts: SemIndexEffectFacts?, sema_diagnostics: &[Diagnostic]) -> [Diagnostic] Never! {
    if sema_diagnostics.iter().any(fn(diagnostic) -> diagnostic.severity == Severity.Error) -> return [Diagnostic]{}
    path :: env.var(EXTENSION_ENV_COMPILER_EXTENSION).ok() ?? return [Diagnostic]{}
    path := path.trim() // #4303
    if path.is_empty() -> return [Diagnostic]{}
    snapshot :: snapshot_from_bundle(bundle, effect_facts) catch error -> return [Diagnostic]{host_failure(error.message, None)}
    response :: analyze_via_jetpack(path.to_string(), &snapshot) catch error -> return [Diagnostic]{host_failure(sanitize_host_message(error.message), None)}
    findings_to_diagnostics(&snapshot, &response)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:75
fn analyze_via_jetpack(wasm_path: String, snapshot: &TypedSnapshot) -> AnalyzeResponse ExtensionProtocolError! {
    host :: compiler_extension_host_path()!
    command := Command.new(host)
    command.arg(EXTENSION_HOST_SUBCOMMAND).arg(wasm_path)
    analyze_via_host_command(^command, snapshot, Duration.from_millis(EXTENSION_HOST_PROCESS_TIMEOUT_MS))
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:89
fn analyze_via_host_command(command: Command, snapshot: &TypedSnapshot, timeout: Duration) -> AnalyzeResponse ExtensionProtocolError! {
    request :: snapshot.encode()!
    response :: run_host_process(^command, ^request, snapshot.limits.max_response_bytes, timeout)!
    AnalyzeResponse.decode_and_validate(snapshot, ^response)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:104
fn run_host_process(command: Command, request: [U8], max_response: USize, timeout: Duration) -> [U8] ExtensionProtocolError! {
    if request.len() > EXTENSION_MAX_SNAPSHOT_BYTES -> fail ExtensionProtocolError.new("compiler-extension snapshot exceeds IPC limit ({request.len()} > {EXTENSION_MAX_SNAPSHOT_BYTES})")
    // GATE #4494: native process, pipes, threads and cleanup, no Rust bridge.
    command := ^command
    child := command.stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn() catch error -> fail ExtensionProtocolError.new("couldn't start compiler-extension host: {error}")
    input := child.stdin.take() ?? fail ExtensionProtocolError.new("compiler-extension host stdin is unavailable")
    output :: child.stdout.take() ?? fail ExtensionProtocolError.new("compiler-extension host stdout is unavailable")
    errors :: child.stderr.take() ?? fail ExtensionProtocolError.new("compiler-extension host stderr is unavailable")
    writer :: thread.spawn(fn() -> IOError! {
        result :: input.write_all(&request)
        input.close()
        result!
    })
    stdout_reader :: thread.spawn(fn() -> ([U8], Bool) IOError! { read_bounded(^output, max_response) })
    stderr_reader :: thread.spawn(fn() -> ([U8], Bool) IOError! { read_bounded(^errors, MAX_HOST_STDERR_BYTES) })
    deadline :: Instant.now() + timeout
    status :: loop {
        waited :: child.try_wait() catch error -> {
            _ :: child.kill(); _ :: child.wait(); _ :: writer.join(); _ :: stdout_reader.join(); _ :: stderr_reader.join()
            fail ExtensionProtocolError.new("couldn't wait for compiler-extension host: {error}")
        }
        if waited == Val(status) -> break status
        if Instant.now() < deadline -> thread.sleep(Duration.from_millis(5)) else {
            _ :: child.kill(); _ :: child.wait(); _ :: writer.join(); _ :: stdout_reader.join(); _ :: stderr_reader.join()
            fail ExtensionProtocolError.new("compiler-extension host timed out after {timeout.as_millis()}ms")
        }
    }
    write_result :: writer.join() catch _ -> fail ExtensionProtocolError.new("compiler-extension host input thread panicked")
    stdout_result :: stdout_reader.join() catch _ -> fail ExtensionProtocolError.new("compiler-extension host output thread panicked")
    (stdout, stdout_overflow) :: stdout_result catch error -> fail ExtensionProtocolError.new("couldn't read compiler-extension host output: {error}")
    stderr_result :: stderr_reader.join() catch _ -> fail ExtensionProtocolError.new("compiler-extension host error thread panicked")
    (stderr, stderr_overflow) :: stderr_result catch error -> fail ExtensionProtocolError.new("couldn't read compiler-extension host error: {error}")
    if stdout_overflow -> fail ExtensionProtocolError.new("compiler-extension host response exceeds IPC limit ({max_response} bytes)")
    if stderr_overflow -> fail ExtensionProtocolError.new("compiler-extension host error exceeds IPC limit ({MAX_HOST_STDERR_BYTES} bytes)")
    if !status.success() {
        decoded :: String.from_utf8_lossy(&stderr)
        message := decoded.trim() // #4303
        fail ExtensionProtocolError.new(if message.is_empty() -> "compiler-extension host exited with {status}" else -> message.to_string())
    }
    write_result catch error -> fail ExtensionProtocolError.new("couldn't send snapshot to compiler-extension host: {error}")
    ^stdout
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:219
fn read_bounded<R: Read>(reader: R, limit: USize) -> ([U8], Bool) IOError! {
    bytes := [U8]{}
    reader.take(limit.saturating_add(1) as U64).read_to_end(&bytes)!
    overflow :: bytes.len() > limit
    if overflow -> bytes.truncate(limit)
    (^bytes, overflow)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:231
fn compiler_extension_host_path() -> OSPath ExtensionProtocolError! {
    exe :: env.current_exe() catch error -> fail ExtensionProtocolError.new("couldn't resolve compiler executable: {error}")
    compiler_extension_host_path_for(&exe)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:237
fn compiler_extension_host_path_for(exe: &OSPath) -> OSPath ExtensionProtocolError! {
    loop candidate in compiler_extension_host_candidates(exe) { if candidate.is_file() -> return ^candidate }
    fail ExtensionProtocolError.new("compiler-extension host `jetpack` is missing beside the Jet compiler")
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:248
fn compiler_extension_host_candidates(exe: &OSPath) -> [OSPath] Never! {
    dir :: exe.parent() ?? return [OSPath]{}
    // GATE #4483: selected target executable suffix, not host constants.
    suffix :: if core.sys.target.selected_os() == "windows" -> ".exe" else -> ""
    binary :: "{Syntax.JETPACK_BINARY_NAME}{suffix}"
    candidates := [OSPath]{dir.join(OSPath.from_text(binary))}
    if dir.file_name() == Val(OSPath.from_text("deps")) {
        if dir.parent() == Val(parent) -> candidates.push(parent.join(OSPath.from_text(binary)))
    }
    ^candidates
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:266
fn sanitize_host_message(message: String) -> String Never! {
    if pkg_extension_message_exposes_rustc(message) -> return "compiler-extension failed with an internal message"
    first :: message.lines().next() ?? message
    first := first.trim() // #4303
    trimmed :: first.split("error while executing at wasm backtrace").next() ?? first
    trimmed := trimmed.trim().trim_end_matches(':').trim() // #4303
    if trimmed.is_empty() -> "compiler-extension analyze trapped" else -> trimmed.to_string()
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:292
pub fn snapshot_from_bundle(bundle: &ProgramBundle, effect_facts: SemIndexEffectFacts?) -> TypedSnapshot ExtensionProtocolError! {
    module :: &bundle.modules[bundle.entry]
    file :: module.display.clone()
    abilities := ExtensionAbility.v1_defaults()
    if effect_facts == None -> abilities.retain(fn(cap) -> cap != ExtensionAbility.ReadEffects)
    types := interface_type_facts(&module.items)
    symbols := [SymbolFact]{}
    spans := [SpanFact]{}
    n := U32{0}
    loop item in module.items {
        func :: if item == { .Func(func) -> func else -> next }
        n += 1
        tid :: "t{n}"; sid :: "s{n}"; spid :: "sp{n}"
        types.push(TypeFact{id: tid.clone(), repr: fn_type_repr(func), shape: TypeFactShape.Opaque})
        effects := [String]{}
        if effect_facts == Val(facts) {
            if facts.solved.get("{module.alias}::{func.name}") == Val(set) {
                keys := set.to_list(); keys.sort(); effects = ^keys
            }
        }
        symbols.push(SymbolFact{id: sid, name: func.name.clone(), kind: "fn", type_id: tid, span_id: spid.clone(), effects: ^effects, provenance: "sema"})
        spans.push(SpanFact{id: spid, file: file.clone(), start: func.name_span.start as U32, end: func.name_span.end as U32})
    }
    if symbols.is_empty() {
        abilities.retain(fn(cap) -> cap != ExtensionAbility.ReadTypes && cap != ExtensionAbility.ReadSymbols && cap != ExtensionAbility.ReadEffects)
        types.clear()
        spans.push(SpanFact{id: "sp1", file: ^file, start: 0, end: 0})
    }
    TypedSnapshot.new(^abilities, ^types, ^symbols, ^spans)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:359
fn interface_type_facts(items: &[Item]) -> [TypeFact] Never! {
    collector := InterfaceTypeCollector.new(items)
    loop item in items {
        if item == .Func(func) { loop param in func.params -> _ :: collector.add_type(&param.ty); if func.return_type == Val(ret) -> _ :: collector.add_type(ret) }
    }
    keys := collector.facts.keys().to_list(); keys.sort()
    out := [TypeFact]{}; loop key in keys -> out.push(collector.facts.remove(key).expect("collected interface type"))
    ^out
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:375
struct InterfaceTypeCollector { structs: [String:&StructDef], facts: [String:TypeFact] }
impl InterfaceTypeCollector {
    // Rust: crates/jet-driver/src/CompilerExtensionHook.rs:381
    fn new(items: &[Item]) -> InterfaceTypeCollector Never! {
        structs := [String:&StructDef]{}
        loop item in items { if item == .Struct(def) -> structs[def.name] = &def }
        InterfaceTypeCollector{structs: ^structs, facts: [String:TypeFact]{}}
    }
    // Rust: crates/jet-driver/src/CompilerExtensionHook.rs:394
    fn add_type(self: &Self, ty: &Type) -> String Never! {
        id :: "it:{ty.name()}"
        if self.facts.contains_key(id) -> return id
        self.facts[id] = TypeFact{id: id.clone(), repr: ty.name(), shape: TypeFactShape.Opaque}
        shape :: if ty == {
            .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> TypeFactShape.Scalar
            .List(inner) -> TypeFactShape.List{element_type_id: self.add_type(inner)}
            .Option(inner) -> TypeFactShape.Option{inner_type_id: self.add_type(inner)}
            .Result(ok, err) -> TypeFactShape.Result{ok_type_id: self.add_type(ok), error_type_id: self.add_type(err)}
            .Named(name) -> {
                def := self.structs.get(name)
                if def == None { if name.rsplit_once('.') == Val((_, leaf)) -> def = self.structs.get(leaf) }
                if def == {
                    None -> TypeFactShape.Opaque
                    Val(def) -> {
                        if !is_codable(def) -> TypeFactShape.Opaque else {
                            fields := [TypeFieldFact]{}
                            loop field in def.fields -> fields.push(TypeFieldFact{name: field.name.clone(), type_id: self.add_type(&field.ty)})
                            TypeFactShape.CodableRecord{fields: ^fields}
                        }
                    }
                }
            }
            else -> TypeFactShape.Opaque
        }
        self.facts[id].shape = ^shape
        id
    }
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:465
fn is_codable(def: &StructDef) -> Bool Never! {
    encode := false; decode := false
    loop derive in def.derives {
        if derive.name == { Syntax.MARKER_CODABLE -> return true; Syntax.MARKER_ENCODE -> encode = true; Syntax.MARKER_DECODE -> decode = true; else -> {} }
    }
    encode && decode
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:480
fn fn_type_repr(func: &Func) -> String Never! {
    parts := [String]{}; loop p in func.params -> parts.push("{p.convention.sigil()}{p.name}: {p.ty.name()}")
    params :: parts.join(", ")
    if func.return_type == { Val(ret) -> "fn({params}) {ret.name()}" else -> "fn({params})" }
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:493
fn findings_to_diagnostics(snapshot: &TypedSnapshot, response: &AnalyzeResponse) -> [Diagnostic] Never! {
    out := [Diagnostic].with_capacity(response.findings.len())
    loop finding in response.findings -> out.push(finding_to_diagnostic(snapshot, finding))
    ^out
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:504
fn finding_to_diagnostic(snapshot: &TypedSnapshot, finding: &ExtensionFinding) -> Diagnostic Never! {
    span :: snapshot.spans.iter().find(fn(span) -> span.id == finding.span_id).map(fn(span) -> Span.new(span.start as USize, span.end as USize))
    Diagnostic.from_row("L1401", [(String, String)]{("rule", finding.rule), ("severity", finding.severity), ("message", finding.message)}, span)
}
// Rust: crates/jet-driver/src/CompilerExtensionHook.rs:523
fn host_failure(message: String, span: Span?) -> Diagnostic Never! { Diagnostic.from_row("E1402", [(String, String)]{("message", message)}, span) }
