// Post-sema compiler-extension hook: sibling process isolation, no compiler mutation.
use jet_foundation.[Diagnostic, Severity, Span, Func, Item, ProgramBundle, StructDef, Type]
use jet_foundation.Syntax
use jet_sema.[SemIndexEffectFacts]
use jet_pkg_model.CompilerExtension.[pkg_extension_message_exposes_rustc, ExtensionAbility, AnalyzeResponse, ExtensionFinding, ExtensionProtocolError, SpanFact, SymbolFact, TypeFact, TypeFactShape, TypeFieldFact, TypedSnapshot, EXTENSION_ENV_COMPILER_EXTENSION, EXTENSION_HOST_PROCESS_TIMEOUT_MS, EXTENSION_HOST_SUBCOMMAND, EXTENSION_MAX_SNAPSHOT_BYTES]
use core.files.runtime.kernel_path_components.[OSPath]
