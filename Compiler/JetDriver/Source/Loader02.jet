// Rust: crates/jet-driver/src/Loader.rs:2845
pub fn project_package_outputs(bundle: &ProgramBundle, declarations: &[(String, String, OutputKind, String)], defaults: &[(String, String)]) -> Unit {
    if declarations.is_empty() { return }
    span :: Span.new(0, 0)
    entry_idx :: bundle.entry
    existing_names :: bundle.modules[entry_idx].items.iter().filter_map(fn(item) { if item == { .Const(value) -> Some(value.name.clone()) _ -> None } }).collect[HashSet[String]]()
    for (address, output_name, kind, entry_name) in declarations {
        if !kind.is_runnable() || entry_name.trim().is_empty() || existing_names.contains(address) { continue }
        local_name_opt :: entry_name.rsplit('.').next().filter(fn(name) { !name.is_empty() })
        if local_name_opt.is_none() { continue }
        local_name := local_name_opt.unwrap() // #4303
        callable :: Expr.Ident(local_name.to_string(), span)
        label :: if output_name.is_empty() { address.clone() } else { output_name.clone() }
        value :: Expr.EnumLit{type_name: Syntax.TYPE_OUTPUT.to_string(), variant: kind.as_str().to_string(), variant_span: None, args: [EnumLitArg.Named{label: Syntax.OUTPUT_FIELD_NAME.to_string(), expr: Expr.Str([StrPart.Lit(label)], span)}, EnumLitArg.Named{label: Syntax.OUTPUT_FIELD_ENTRY.to_string(), expr: callable}], leading_dot: false, span: span}
        bundle.modules[entry_idx].items.push(Item.Const(ConstDef{span: span, name: address.clone(), name_span: span, value: value, is_pub: false, is_package_pub: false, meta: None, attrs: [], rust_kind: RustConstKind.Const, is_comptime: false, ct: None, ty: Some(Type.Named(Syntax.TYPE_OUTPUT.to_string())), is_persist: false, persist_span: None, mutable: false, resolved_output: None}))
    }
    if !defaults.is_empty() && !existing_names.contains(Syntax.OUTPUT_DEFAULTS) {
        fields :: defaults.iter().filter(fn((name, address)) { !name.trim().is_empty() && !address.trim().is_empty() }).map(fn((name, address)) { (name.clone(), span, Expr.Ident(address.clone(), span)) }).collect()
        value :: Expr.StructLit{type_name: "", type_args: [], import_ns: None, as_trait: None, fields: fields, inferred: true, span: span}
        bundle.modules[entry_idx].items.push(Item.Const(ConstDef{span: span, name: Syntax.OUTPUT_DEFAULTS.to_string(), name_span: span, value: value, is_pub: false, is_package_pub: false, meta: None, attrs: [], rust_kind: RustConstKind.Const, is_comptime: false, ct: None, ty: Some(Type.Named(Syntax.TYPE_OUTPUT_DEFAULTS.to_string())), is_persist: false, persist_span: None, mutable: false, resolved_output: None}))
    }
}

// Rust: crates/jet-driver/src/Loader.rs:2960
// Configured organization policy is an explicit input and never fails open.
pub fn load_organization_policy() -> [Policy.PolicyDeclaration] LoaderError! {
    configured_opt :: CheckReads.env_var(Syntax.ENV_ORG_UNSAFE_POLICY)
    if configured_opt.is_none() { return Ok([]) }
    path :: OSPath(configured_opt.unwrap())
    // GATE #4494: tracked native environment and filesystem reads.
    source :: CheckReads.read_to_string(path).map_err(fn(error) { LoaderError.at(path.display().to_string(), "", [Diagnostic.error("E3109", "cannot read the configured organization gate policy", "{Syntax.ENV_ORG_UNSAFE_POLICY} names `{path.display()}`, but it could not be read: {error}", "fix the policy path or remove the environment variable", None)]) })?
    declarations := Package.parse_policy_document(source).map_err(fn(error) { LoaderError.at(path.display().to_string(), source, [Diagnostic.error("E3109", "the configured organization gate policy is malformed", "`{path.display()}` must contain a manifest-shaped `policy: {{ unsafe: .Obligations, impure: .GateOnly, nondeterministic: .GateOnly }}` block: {error:?}", "fix the organization policy; configured policy never fails open", None)]) })?
    if declarations.is_empty() || declarations.iter().any(fn(declaration) { !declaration.key.is_audited_gate() }) { return Err(LoaderError.at(path.display().to_string(), source, [Diagnostic.error("E3109", "the organization gate policy has the wrong shape", "this admin input contains only the shared audited-gate fields", "use `policy: { unsafe: .Obligations, impure: .GateOnly, nondeterministic: .GateOnly }` (with any subset of those fields)", None)])) }
    for declaration in &declarations { declaration.scope = Policy.PolicyScope.Organization; declaration.source = path.display().to_string() }
    Ok(declarations)
}

// Rust: crates/jet-driver/src/Loader.rs:3030
pub fn manifest_path(root: &OSPath) -> OSPath? { manifest_path_checked(root).ok().flatten() }
// Rust: crates/jet-driver/src/Loader.rs:3036
// Canonical manifest only; no symlink traversal, no pkg.jet fallback.
pub fn manifest_path_checked(root: &OSPath) -> OSPath? Diagnostic! {
    resolver :: if AuthorityResolver.open(root) == { .Ok(resolver) -> resolver .Err(error) if error.is_missing() -> return Ok(None) .Err(error) -> return Err(error.diagnostic()) }
    if resolver.checked_manifest(OSPath(".")) == {
        .Ok(manifest) -> { resolver.revalidate_file(manifest.file).map_err(fn(error) { error.diagnostic() })?; Ok(Some(manifest.file.path)) }
        .Err(error) if error.is_missing() -> Ok(None)
        .Err(error) -> Err(error.diagnostic())
    }
}
// Rust: crates/jet-driver/src/Loader.rs:3054
// Nearest declaration-resolved workspace is the authority boundary.
pub fn find_manifest_root_checked(start: &OSPath) -> OSPath? Diagnostic! {
    dir := AuthorityResolver.authority_walk_root(start).map_err(fn(error) { error.diagnostic() })?
    loop {
        authority :: AuthorityResolver.open_for_authority_walk(dir).map_err(fn(error) { error.diagnostic() })?
        if authority == .Some(resolver) {
            if resolver.resolve_workspace_source() == {
                .Ok(.Some(_)) -> {
                    return if resolver.checked_manifest(OSPath(".")) == { .Ok(_) -> Ok(Some(dir.clone())) .Err(error) if error.is_missing() -> Ok(None) .Err(error) -> Err(error.diagnostic()) }
                }
                .Ok(.None) -> {}
                .Err(error) -> return Err(error.workspace_diagnostic())
            }
            if resolver.checked_manifest(OSPath(".")) == { .Ok(_) -> return Ok(Some(dir)) .Err(error) if error.is_missing() -> {} .Err(error) -> return Err(error.diagnostic()) }
        } else {
            // Explicit directory retains authority even when upward walk prunes it.
            resolver :: AuthorityResolver.open(dir).map_err(fn(error) { error.diagnostic() })?
            if resolver.checked_manifest(OSPath(".")) == {
                .Ok(_) -> {
                    return if resolver.resolve_workspace_source() == { .Ok(_) -> Ok(Some(dir)) .Err(error) -> Err(error.workspace_diagnostic()) }
                }
                .Err(error) if error.is_missing() -> {}
                .Err(error) -> return Err(error.diagnostic())
            }
        }
        parent :: AuthorityResolver.authority_walk_parent(dir)
        if parent.is_none() { return Ok(None) }
        dir = parent.unwrap()
    }
}
// Rust: crates/jet-driver/src/Loader.rs:3110
pub fn checked_inline_root_at_explicit_boundary(dir: &OSPath) -> (OSPath?, Bool) Diagnostic! {
    resolver :: AuthorityResolver.open(dir).map_err(fn(error) { error.diagnostic() })?
    has_manifest :: if resolver.checked_manifest(OSPath(".")) == { .Ok(_) -> true .Err(error) if error.is_missing() -> false .Err(error) -> return Err(error.diagnostic()) }
    has_inline :: checked_inline_package_entry(resolver)?.is_some()
    if has_manifest || has_inline { resolver.resolve_workspace_source().map_err(fn(error) { error.workspace_diagnostic() })? }
    Ok((if has_inline { Some(dir.to_path_buf()) } else { None }, has_manifest))
}
// Rust: crates/jet-driver/src/Loader.rs:3128
pub fn checked_inline_package_entry(resolver: &AuthorityResolver) -> CheckedFile? Diagnostic! {
    candidates :: [OSPath(Syntax.DEFAULT_ENTRY_FILE), OSPath("src").join(Syntax.DEFAULT_ENTRY_FILE)]
    for relative in candidates {
        file :: if resolver.checked_file(relative) == { .Ok(file) -> file .Err(error) if error.is_missing() -> continue .Err(error) -> return Err(error.diagnostic()) }
        source :: file.text().map_err(fn(error) { error.diagnostic() })?
        inline :: Package.extract_inline_package(source).map_err(fn(error) { error.diagnostic() })?
        resolver.revalidate_file(file).map_err(fn(error) { error.diagnostic() })?
        if inline.is_some() { return Ok(Some(file)) }
    }
    Ok(None)
}
// Rust: crates/jet-driver/src/Loader.rs:3157
pub fn find_inline_package_root_checked(start: &OSPath) -> OSPath? Diagnostic! {
    dir := AuthorityResolver.authority_walk_root(start).map_err(fn(error) { error.diagnostic() })?
    loop {
        authority :: AuthorityResolver.open_for_authority_walk(dir).map_err(fn(error) { error.diagnostic() })?
        if authority.is_none() {
            (inline_root, has_manifest) :: checked_inline_root_at_explicit_boundary(dir)?
            if inline_root == .Some(root) { return Ok(Some(root)) }
            if has_manifest { return Ok(None) }
            parent :: AuthorityResolver.authority_walk_parent(dir)
            if parent.is_none() { return Ok(None) }
            dir = parent.unwrap()
            continue
        }
        resolver :: authority.unwrap()
        workspace_boundary :: if resolver.resolve_workspace_source() == { .Ok(.Some(_)) -> true .Ok(.None) -> false .Err(error) -> return Err(error.workspace_diagnostic()) }
        has_manifest :: if resolver.checked_manifest(OSPath(".")) == { .Ok(_) -> true .Err(error) if error.is_missing() -> false .Err(error) -> return Err(error.diagnostic()) }
        if checked_inline_package_entry(resolver)?.is_some() { return Ok(Some(dir)) }
        if workspace_boundary || has_manifest { return Ok(None) }
        parent :: AuthorityResolver.authority_walk_parent(dir)
        if parent.is_none() { return Ok(None) }
        dir = parent.unwrap()
    }
}
// Rust: crates/jet-driver/src/Loader.rs:3205
pub fn selected_project_root(start: &OSPath) -> OSPath Diagnostic! {
    if find_workspace_root_checked(start)? == .Some(root) { return Ok(root) }
    if find_repository_root(start) == .Some(root) { return Ok(root) }
    if find_package_root_checked(start)? == .Some(root) { return Ok(root) }
