// Rust: crates/jet-driver/src/Loader.rs:1801
pub fn load_manifestless_context(entry_abs: &OSPath, entry_dir: &OSPath, inline_root: OSPath?, workspace_root: OSPath?, overlays: &[(OSPath, String)], organization_policy: &[Policy.PolicyDeclaration], sink: &((&[LoaderDiagnostic])?), inline_dep_lints: &[Diagnostic], layer_ceiling: &(Syntax.RuntimeLayer?), package_edition: &String) -> (OSPath, [String:DependencyDir], PkgResolution, [Policy.PolicyDeclaration], [String], PackageGuarantees, HashSet[String], [(String, String, OutputKind, String)], [(String, String)], jet_foundation.TargetMachine.AllocatorPolicy, [ImportBoundaryPolicy]) [Diagnostic]! {
    package_source_root := inline_root.clone().or(workspace_root.clone())
    project_root :: package_source_root.clone().unwrap_or_else(fn() { entry_dir.clone() })
    resolution := PkgResolution.default()
    entry_overlay :: overlays.iter().rev().find(fn((candidate, _)) { normalize_path(candidate) == entry_abs }).map(fn((_, text)) { text })
    entry_authority :: if entry_overlay.is_some() { None } else {
        Some(checked_source_file(entry_abs, entry_abs.display().to_string()).map_err(fn(error) { record_loader_error(&sink, error) })?)
    }
    raw :: entry_overlay.map(fn(text) { text.to_string() }).unwrap_or_else(fn() { entry_authority.map(fn((_, _, source)) { source.clone() }).expect("one source reader must provide the entry text") })
    package_source := raw.clone()
    package_origin := entry_abs.clone()
    inline_block := Package.extract_inline_package(raw).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(entry_abs.display().to_string(), raw, [error.diagnostic()])) })?
    if inline_block.is_some() && inline_root.is_none() { package_source_root = Some(entry_dir.clone()) }
    if inline_block.is_none() && inline_root == .Some(inline_root) {
        resolver :: AuthorityResolver.open(inline_root).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(inline_root.display().to_string(), "", [error.diagnostic()])) })?
        carrier_opt :: checked_inline_package_entry(resolver).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(inline_root.display().to_string(), "", [diagnostic])) })?
        carrier :: carrier_opt.ok_or_else(fn() { record_loader_error(&sink, LoaderError.at(inline_root.display().to_string(), "", [Diagnostic.error("E1362", "the inline Package entry disappeared", "the package source changed during entry resolution", "restore the inline Package declaration and retry", None)])) })?
        package_source = carrier.text().map_err(fn(error) { record_loader_error(&sink, LoaderError.at(carrier.path.display().to_string(), "", [error.diagnostic()])) })?
        package_origin = carrier.path.clone()
        inline_block = Package.extract_inline_package(package_source).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(package_origin.display().to_string(), package_source, [error.diagnostic()])) })?
    }
    package_policy := organization_policy.clone()
    package_lints_deny := [String].new()
    package_guarantees := PackageGuarantees.default()
    package_output_roots := HashSet[String].new()
    package_output_declarations := [(String, String, OutputKind, String)].new()
    package_defaults := [(String, String)].new()
    program_allocator := jet_foundation.TargetMachine.AllocatorPolicy.HostedDefault
    pkg_dep_dirs := [String:DependencyDir].new()
    boundary_policies := [ImportBoundaryPolicy].new()
    if inline_block == .Some(block) {
        source_root :: package_source_root.unwrap_or(entry_dir)
        origin :: package_origin.display().to_string()
        package_manifest := Package.PackageFacts.parse_uncomposed(block.body(package_source), origin).map_err(fn(error) {
            record_loader_error(&sink, LoaderError.at(origin, package_source, [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(), "fix the inline Package fields, then retry", Some(block.body_span))]))
        })?
        complete_inline_package_facts(&package_manifest, source_root).map_err(fn(error) {
            record_loader_error(&sink, LoaderError.at(origin, package_source, [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(), "fix the inline Package fields, then retry", Some(block.body_span))]))
        })?
        mf :: Package.to_manifest(package_manifest, block.body(package_source)).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(origin, package_source, [diagnostic])) })?
        layer_ceiling = mf.package.layer
        package_edition = Manifest.effective_edition(mf)
        Manifest.check_toolchain(mf, origin).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(origin, package_source, [diagnostic])) })?
        Manifest.check_edition_support(mf, origin).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(origin, package_source, [diagnostic])) })?
        verify_inline_manifest_lock(source_root, mf).map_err(fn(failure) { record_loader_error(&sink, LoaderError.at(failure.path.display().to_string(), failure.raw, [failure.diagnostic])) })?
        dry_resolve_path_deps(mf, source_root).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(origin, package_source, [diagnostic])) })?
        for pkg in package_manifest.packages {
            if Package.discover_module_in(source_root, pkg.name) == {
                .Ok(_) -> {}
                .Err(.NotFound(name)) -> return Err(record_loader_error(&sink, LoaderError.at(origin, package_source, [Manifest.e1212(entry_abs.display().to_string(), name)])))
                .Err(.Ambiguous(name, paths)) -> return Err(record_loader_error(&sink, LoaderError.at(origin, package_source, [Manifest.e1213(entry_abs.display().to_string(), name, paths)])))
            }
        }
        pkg_dep_dirs = collect_dep_dirs(mf, source_root).map_err(fn(diagnostics) { record_loader_error(&sink, LoaderError.at(origin, package_source, diagnostics)) })?
        resolution = collect_pkg_resolution(package_manifest).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(origin, package_source, [diagnostic])) })?
        package_guarantees = package_guarantees_for_manifest(package_manifest)
        for (address, output) in package_manifest.outputs {
            selected :: package_manifest.entry_path(source_root, output).ok().flatten()
            if selected.is_none() || selected.unwrap() != entry_abs || output.entry.is_none() { continue }
            entry :: output.entry.unwrap()
            kind :: if output.kind == { .Library -> OutputKind.Library .Executable -> OutputKind.Executable .Service -> OutputKind.Service .Check -> OutputKind.Check .Environment -> OutputKind.Environment .Image -> OutputKind.Image .Bundle -> OutputKind.Bundle .System -> OutputKind.System .Fleet -> OutputKind.Fleet }
            package_output_declarations.push((address.clone(), output.name.clone(), kind, entry.clone()))
        }
        package_defaults = package_manifest.defaults.iter().map(fn((name, address)) { (name.clone(), address.clone()) }).collect()
        for (_, _, _, entry) in package_output_declarations {
            if entry.split('.').next() == .Some(root) { if !root.is_empty() { _ :: package_output_roots.insert(root.to_string()) } }
        }
        package_lints_deny = package_manifest.policy.lints_deny.clone().unwrap_or_default()
        package_policy.extend(package_manifest.policy.declarations.clone())
        for declaration in &package_policy { if declaration.scope == Policy.PolicyScope.Package { declaration.source = origin.clone() } }
        boundary_policies.push(ImportBoundaryPolicy.from_manifest(mf, source_root))
        program_allocator = package_manifest.allocator.clone()
    } else {
        (toks, lex_diags) :: Lexer.lex(raw)
        if lex_diags.is_empty() {
            if Parser.parse_with_source(toks, raw) == .Ok(prog) {
                for dep in ScriptDeps.collect(prog) {
                    if !ScriptDeps.is_pinned(dep.selector) { inline_dep_lints.push(ScriptDeps.l0203_unpinned(dep)) }
                    if ScriptDeps.resolve(dep, entry_dir) == {
                        .Ok(resolved) -> {
                            authority :: AuthorityResolver.open(resolved.dir).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(entry_abs.display().to_string(), raw, [error.diagnostic()])) })?
                            root :: authority.root().to_path_buf()
                            resolution.realized_libs.entry(resolved.name.clone()).or_insert_with(fn() { root.clone() })
                            resolution.realized_authorities.entry(resolved.name.clone()).or_insert(authority)
                        }
                        .Err(reason) -> return Err([ScriptDeps.e1253(dep, reason)])
                    }
                }
            }
        }
    }
    if entry_authority == .Some((entry_resolver, entry_checked, _)) {
        entry_resolver.revalidate_file(entry_checked).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(entry_abs.display().to_string(), raw, [error.diagnostic()])) })?
    }
    (project_root, pkg_dep_dirs, resolution, package_policy, package_lints_deny, package_guarantees, package_output_roots, package_output_declarations, package_defaults, program_allocator, boundary_policies)
}

// Rust: crates/jet-driver/src/Loader.rs:2211
pub fn load_project_finish(entry_path: &String, entry_abs: &OSPath, project_root: OSPath, pkg_dep_dirs: [String:DependencyDir], pkg_resolution: PkgResolution, package_policy: [Policy.PolicyDeclaration], package_lints_deny: [String], package_guarantees: PackageGuarantees, package_output_roots: HashSet[String], package_output_declarations: [(String, String, OutputKind, String)], package_defaults: [(String, String)], program_allocator: jet_foundation.TargetMachine.AllocatorPolicy, boundary_policies: [ImportBoundaryPolicy], layer_ceiling: Syntax.RuntimeLayer?, package_edition: String, inline_dep_lints: [Diagnostic], overlays: &[(OSPath, String)], for_check: Bool, load_adjacent_unqualified: Bool, validates_project_parts: Bool, dependencies: &[OSPath], prepared_frontend: (&PreparedFrontend)?, sink: &((&[LoaderDiagnostic])?)) -> ProgramBundle [Diagnostic]! {
    modules := [LoadedModule].new()
    path_to_idx := [OSPath:USize].new()
    stack := [OSPath].new()
    parse_teaching := inline_dep_lints
    project_part_overlays :: overlays.iter().map(fn((path, source)) { (normalize_path(path), source.to_string()) }).collect()
    (project_parts, project_part_failures) :: ProjectParts.scan_with_diagnostics(project_root, project_part_overlays)
    if validates_project_parts {
        if project_part_failures.iter().find(fn(failure) { failure.authority }) == .Some(failure) {
            file :: authority_failure_file(project_root, failure)
            return Err(record_loader_error(&sink, LoaderError.at(file, "", [failure.problem.clone()])))
        }
    }
    entry_display :: relative_display(project_root, entry_abs)
    load_file(entry_abs, entry_display, project_root, pkg_dep_dirs, pkg_resolution, package_policy, package_lints_deny, &modules, &path_to_idx, &stack, overlays, for_check, &parse_teaching, project_parts, project_part_failures, dependencies, prepared_frontend).map_err(fn(error) { record_loader_error(&sink, error) })?
    // D-MOD-CYCLE1: a package loads its entire namespace, without member cycles.
    namespace_roots := [OSPath:OSPath?].new()
    expanded_roots := HashSet[OSPath].new()
    loop {
        pending := [OSPath].new()
        for module_idx in 0..modules.len() {
            module_path :: modules[module_idx].path.clone()
            root_opt :: namespace_root(module_path, &namespace_roots)
            if root_opt.is_none() { continue }
            root :: root_opt.unwrap()
            if !expanded_roots.insert(root.clone()) { continue }
            members :: package_member_files(root).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(root.display().to_string(), "", [diagnostic])) })?
            for member in members {
                // The root already authenticated this member; seed its folder.
                if member.parent() == .Some(folder) { namespace_roots[folder.to_path_buf()] = Some(root.clone()) }
                if !path_to_idx.contains_key(normalize_path(member)) { pending.push(member) }
            }
        }
        if pending.is_empty() { break }
        for member in pending {
            if path_to_idx.contains_key(normalize_path(member)) { continue }
            member_display :: relative_display(project_root, member)
            load_file(member, member_display, project_root, pkg_dep_dirs, pkg_resolution, package_policy, package_lints_deny, &modules, &path_to_idx, &stack, overlays, for_check, &parse_teaching, project_parts, project_part_failures, dependencies, prepared_frontend).map_err(fn(error) { record_loader_error(&sink, error) })?
        }
    }
    for module in modules {
        if module.path.starts_with(CORE_SOURCE_ROOT) || namespace_root(module.path, &namespace_roots).is_some() { continue }
        if shared_folder_below_package(module.path) == .Some((shared, root)) {
            diagnostic :: Diagnostic.error("E1334", "folder `{shared.display()}` is world-writable, so `{module.display}` is cut off from package `{root.display()}`", "package discovery never crosses a world-writable folder, because anyone could plant sources in it", "remove the write bit for others: `chmod o-w {shared.display()}`", None)
            return Err(record_loader_error(&sink, LoaderError.at(module.display, module.source, [diagnostic])))
        }
    }
    if validates_project_parts && !project_parts.conflicts.is_empty() { return Err(record_loader_error(&sink, project_parts_loader_error(project_root, project_parts.conflicts))) }
    if load_adjacent_unqualified {
        aliases := [(String, Span)].new()
        for import in modules[0].imports {
            if !(if import.kind == .Unqualified(_) { true } else { false }) { continue }
            is_foreign :: import.foreign_imports().map_err(fn(error) { [error.diagnostic()] })?
            if !is_foreign.is_empty() { continue }
            if import.walk_bindings().into_iter().next() == .Some(binding) {
                if jet_foundation.AST.core_list_prefix(binding.module_alias).is_some() { continue }
                aliases.push((binding.module_alias.to_string(), binding.module_alias_span))
            }
        }
        loaded_aliases := HashSet[String].new()
        for module in modules { _ :: loaded_aliases.insert(module.alias.clone()) }
        overlay_paths :: overlays.iter().map(fn((path, _)) { normalize_path(path) }).collect[HashSet[OSPath]]()
        for (alias, span) in aliases {
            if loaded_aliases.contains(alias) { continue }
            target :: entry_abs.parent().unwrap_or(OSPath(".")).join(alias).with_extension(Syntax.FILE_EXT)
            norm :: normalize_path(target)
            staged :: overlay_paths.contains(norm)
            authority_exists := false
            if !staged {
                parent :: target.parent().unwrap_or(OSPath("."))
                resolver :: AuthorityResolver.open(parent).map_err(fn(error) { [error.diagnostic()] })?
                name :: target.file_name().ok_or_else(fn() { [Diagnostic.error("E0603", "can't find the file `{target.display()}`", "an adjacent module must name one regular `.jet` file", "use a valid module name or add the adjacent source file", None)] })?
                if resolver.checked_file(OSPath(name)) == {
                    .Ok(file) -> { resolver.revalidate_file(file).map_err(fn(error) { [error.diagnostic()] })?; authority_exists = true }
                    .Err(error) if error.is_missing() -> {}
                    .Err(error) -> return Err([error.diagnostic()])
                }
            }
            if authority_exists || staged {
                display :: relative_display(project_root, target)
                load_file(target, display, project_root, pkg_dep_dirs, pkg_resolution, package_policy, package_lints_deny, &modules, &path_to_idx, &stack, overlays, for_check, &parse_teaching, project_parts, project_part_failures, dependencies, prepared_frontend).map_err(fn(error) { record_loader_error(&sink, error) })?
                for module in modules { _ :: loaded_aliases.insert(module.alias.clone()) }
                // Structural import context changes the tree, never user source.
                modules[0].imports.push(ImportDecl{kind: ImportKind.File(alias.clone(), span), alias: alias.clone(), alias_span: span, span: span, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: None})
