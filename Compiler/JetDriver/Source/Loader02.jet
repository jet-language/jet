}
// Rust: crates/jet-driver/src/Loader.rs:3220
// A real .git file (worktree) or directory is valid, never a symlink.
pub fn find_repository_root(start: &OSPath) -> OSPath? {
    initial :: AuthorityResolver.authority_walk_root(start).ok()
    if initial.is_none() { return None }
    dir := initial.unwrap()
    loop {
        // GATE #4494: native no-follow metadata.
        if fs.symlink_metadata(dir.join(".git")) == .Ok(metadata) { if !metadata.file_type().is_symlink() && (metadata.is_dir() || metadata.is_file()) { return Some(dir) } }
        parent :: AuthorityResolver.authority_walk_parent(dir)
        if parent.is_none() { return None }
        dir = parent.unwrap()
    }
}
