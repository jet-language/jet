        }
    }
    entry_idx :: path_to_idx.get(entry_abs).ok_or_else(fn() { [Diagnostic.error("E0603", "can't find the file `{entry_path}`", "the entry file must exist on disk", "check the spelling and path", None)] })?
    // Stable unique aliases, including already-suffixed names.
    seen_aliases := HashSet[String].new()
    next_suffix := [String:USize].new()
    for m in &modules {
        if !seen_aliases.insert(m.alias.clone()) {
            n := next_suffix.get(m.alias).copied().unwrap_or(2)
            while !seen_aliases.insert("{m.alias}_{n}") { n += 1 }
            next_suffix[m.alias.clone()] = n + 1
            m.alias = "{m.alias}_{n}"
        }
    }
    name_ledger := NameLedger.default()
    for (module_idx, module) in modules.iter().enumerate() { name_ledger.set_module(module_idx, module.alias.clone(), module.display.clone(), package_scope_for(module.path, project_root)) }
    boundary_hits := boundary_policies.iter().map(fn(policy) { [false; policy.deny.len()] }).collect[[[Bool]]]()
    for module_idx in 0..modules.len() {
        module_path :: modules[module_idx].path.clone()
        imports :: modules[module_idx].imports.clone()
        for imp in imports {
            if imp.kind == .Unqualified(_) { continue }
            if is_foreign_namespace_import(imp).map_err(fn(diagnostic) { [diagnostic] })? { continue }
            if core_module_path(imp).is_some() || jet_foundation.AST.target_profile_path(imp).is_some() { continue }
            if resolve_import(imp, module_path, project_root, pkg_dep_dirs, pkg_resolution, project_parts, project_part_failures) == .Ok(target_path) {
                norm :: normalize_path(target_path)
                if path_to_idx.get(norm) == .Some(target_idx) {
                    if import_boundary_violation(boundary_policies, modules[module_idx], modules[target_idx], imp.span) == .Some((policy_idx, rule_idx, diagnostic)) {
                        boundary_hits[policy_idx][rule_idx] = true
                        module :: modules[module_idx]
                        rule :: boundary_policies[policy_idx].deny[rule_idx]
                        rule_display :: "{rule.from} -> {rule.to}"
                        denied_fact :: import_edge_fact(boundary_policies, modules[module_idx], modules[target_idx], imp.span, "denied", "manifest boundary policy denied edge under {rule_display}", Some("manifest rule edit"))
                        return Err(record_loader_error(&sink, LoaderError.at(module.display, module.source, [diagnostic]).with_structure_fact(denied_fact)))
                    }
                    name_ledger.record_import_target(module_idx, imp.span, target_idx)
                    record_import_edge_fact(boundary_policies, modules[module_idx], modules[target_idx], imp.span, &name_ledger)
                }
            }
        }
    }
    bind_package_namespaces(&modules, entry_idx, &namespace_roots, &name_ledger).map_err(fn(error) { record_loader_error(&sink, error) })?
    for import in modules[entry_idx].imports {
