// Rust: crates/jet-driver/src/Loader.rs:3323
pub fn verify_locked_manifest(manifest: &Manifest.Manifest, package_root: &OSPath, project_root: &OSPath, lock: &Lock.LockFile, visited: &HashSet[OSPath], resolved_sources: &[String:String], enforce_path_boundary: Bool) -> Unit [Diagnostic]! {
    // Stable first matching lock row, indexed once for each source category.
    path_rows := [String:USize].new()
    git_rows := [String:USize].new()
    for (index, package) in lock.packages.iter().enumerate() {
        if package.source == { .Path(_) -> { path_rows.entry(package.name).or_insert(index) } .Git(_, _) -> { git_rows.entry(package.name).or_insert(index) } _ -> {} }
    }
    for (dep_name, spec) in manifest.dependencies {
        (source_root, expected_hash, recurse) :: if spec == {
            .Path(path) -> {
                declared_source :: resolve_locked_path_dependency(dep_name, path, package_root, enforce_path_boundary)?
                row :: path_rows.get(dep_name).ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the lock has no matching path source identity")] })?
                package :: lock.packages[row]
                locked_path :: if package.source == { .Path(path) -> path _ -> unreachable("path package predicate guarantees a path source") }
                if normalize_path(package_root.join(locked_path)) != declared_source { return Err([locked_dependency_diagnostic(dep_name, "the locked path source disagrees with the manifest")]) }
                record_locked_source_identity(resolved_sources, dep_name, "path:{declared_source.display()}")?
                expected_hash :: package.content_hash.ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the lock has no content hash for its path source")] })?
                source_root :: locked_store_source_path(dep_name, package).map_err(fn(diagnostic) { [diagnostic] })?
                (source_root, expected_hash.to_string(), true)
            }
            .Git(url, selector) -> {
                row :: git_rows.get(dep_name).ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the lock has no matching Git source identity")] })?
                package :: lock.packages[row]
                (locked_url, locked_selector) :: if package.source == { .Git(url, selector) -> (url, selector) _ -> unreachable("Git package predicate guarantees a Git source") }
                expected_selector :: Lock.git_selector_str(selector)
                revision :: package.locked.ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the lock has no pinned Git revision")] })?
                revision_matches :: if selector == { .Rev(expected_revision) -> revision.rev == expected_revision .Tag(_) | .Branch(_) -> !revision.rev.trim().is_empty() }
                if locked_url != url || locked_selector != expected_selector || !revision_matches { return Err([locked_dependency_diagnostic(dep_name, "the locked Git URL or revision disagrees with the manifest")]) }
                expected_hash :: package.content_hash.or_else(fn() { package.locked.map(fn(revision) { revision.tree_hash }) }).filter(fn(hash) { !hash.trim().is_empty() }).ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the lock has no content hash for its Git source")] })?
                record_locked_source_identity(resolved_sources, dep_name, "git:{url}\n{expected_selector}")?
                source_root :: locked_store_source_path(dep_name, package).map_err(fn(diagnostic) { [diagnostic] })?
                (source_root, expected_hash.to_string(), true)
            }
            .Registry(_) | .Foreign(_, _) -> continue
        }
        verify_locked_source_tree(dep_name, source_root, expected_hash)?
        if recurse && visited.insert(normalize_path(source_root)) {
            dependency_manifest :: load_locked_manifest_from_authority(dep_name, source_root)?
            verify_locked_manifest(dependency_manifest, source_root, project_root, lock, visited, resolved_sources, true)?
        }
    }
    Ok(())
}
// Rust: crates/jet-driver/src/Loader.rs:3465
pub fn load_locked_manifest_from_authority(dep_name: &String, source_root: &OSPath) -> Manifest.Manifest [Diagnostic]! {
    resolver :: if AuthorityResolver.open_store(source_root) == { .Ok(resolver) -> resolver .Err(error) if error.is_missing() -> return Err([locked_dependency_diagnostic(dep_name, "the locked source has no readable package source")]) .Err(error) -> return Err([error.diagnostic()]) }
    facts_opt :: package_facts_from_resolver(resolver)?
    facts :: facts_opt.ok_or_else(fn() { [locked_dependency_diagnostic(dep_name, "the locked source has no readable package source")] })?
    Package.to_manifest(facts, "").map_err(fn(diagnostic) { [diagnostic] })
}
// Rust: crates/jet-driver/src/Loader.rs:3489
pub fn resolve_locked_path_dependency(dep_name: &String, path: &String, package_root: &OSPath, enforce_boundary: Bool) -> OSPath [Diagnostic]! {
    source_root :: normalize_path(package_root.join(path))
    if !enforce_boundary { return Ok(source_root) }
    if OSPath(path).is_absolute() || !source_root.starts_with(package_root) { return Err([path_dependency_escape_diagnostic(dep_name, path, package_root)]) }
    parent :: fs.canonicalize(package_root).map_err(fn(error) { [locked_dependency_diagnostic(dep_name, "could not resolve the declaring package root: {error}")] })?
    if fs.canonicalize(source_root) == .Ok(resolved) { if !resolved.starts_with(parent) { return Err([path_dependency_escape_diagnostic(dep_name, path, package_root)]) } }
    Ok(source_root)
}
// Rust: crates/jet-driver/src/Loader.rs:3527
pub fn verify_locked_source_tree(dep_name: &String, source_root: &OSPath, expected_hash: &String) -> Unit [Diagnostic]! {
    metadata :: fs.symlink_metadata(source_root).map_err(fn(error) { [locked_dependency_diagnostic(dep_name, "the locked source is unavailable: {error}")] })?
    if metadata.file_type().is_symlink() || !metadata.is_dir() { return Err([locked_dependency_diagnostic(dep_name, "the locked source is not a real directory")]) }
    if expected_hash.trim().is_empty() { return Err([locked_dependency_diagnostic(dep_name, "the lock has no content hash for its source")]) }
    actual :: SHA256.try_tree_hash(source_root).map_err(fn(error) { [locked_dependency_diagnostic(dep_name, "the locked source could not be hashed: {error}")] })?
    if actual != expected_hash { return Err([locked_dependency_diagnostic(dep_name, "the source content hash does not match the lock (expected {expected_hash}, got {actual})")]) }
    Ok(())
}
// Rust: crates/jet-driver/src/Loader.rs:3565
pub fn locked_store_content_hash(package: &Lock.LockedPackage) -> String? {
    package.content_hash.filter(fn(hash) { !hash.trim().is_empty() }).or_else(fn() { package.locked.map(fn(revision) { revision.tree_hash }).filter(fn(hash) { !hash.trim().is_empty() }) })
}
