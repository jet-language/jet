    }
    // D-STRUCT-EDGE1: an unused deny rule is feedback, not failure.
    for (policy_idx, policy) in boundary_policies.iter().enumerate() {
        for (rule_idx, rule) in policy.deny.iter().enumerate() {
            if !boundary_hits[policy_idx][rule_idx] { rule_display :: "{rule.from} -> {rule.to}"; parse_teaching.push(Diagnostic.from_row("L0619", [("rule", rule_display)], None)) }
        }
    }
    dep_roots := pkg_dep_dirs.iter().map(fn((name, dependency)) { (name.clone(), dependency.source_root.clone()) }).collect[[String:OSPath]]()
    for (name, dir) in pkg_resolution.realized_libs { dep_roots.entry(name.clone()).or_insert_with(fn() { dir.clone() }) }
    build_facts :: BuildFactSnapshot.script(modules[entry_idx].path, Syntax.OSTarget.host(), "dev")
    bundle := ProgramBundle{entry: entry_idx, project_root: project_root, modules: modules, devtools_registry: DevtoolsRegistry.default(), parse_teaching: parse_teaching, used_core: HashSet[String].new(), ffi_callback_fns: HashSet[String].new(), cffi: CFFI.CFfi.default(), comptime_inputs: [], name_ledger: name_ledger, layer_ceiling: layer_ceiling, inferred_layer: Syntax.RuntimeLayer.Core, web_partitions: [:], web_partition_enforced: false, web_partition_report: None, dep_roots: dep_roots, package_guarantees: package_guarantees, program_allocator: program_allocator, active_os: Syntax.OSTarget.host(), build_facts: build_facts, edition: package_edition}
    // Bare URL names schedule its source-owned carrier without an explicit use.
    url_carrier :: Syntax.TypedHeadKind.URL.carrier_record_module()
    names_url_carrier :: bundle.modules.iter().any(fn(module) { source_names_identifier(module.source, "URL") })
    imported_core := HashSet[String].new()
    for module in bundle.modules { for import in module.imports { if core_source_import_module(import) == .Some(name) { _ :: imported_core.insert(name) } } }
    source_modules := core_source_modules().iter().copied().filter(fn(source_module) { (names_url_carrier && Some(source_module.module) == url_carrier) || imported_core.contains(source_module.module) }).collect()
    scheduled := source_modules.iter().map(fn(source_module) { source_module.module }).collect[HashSet[String]]()
    if scheduled.contains(CORE_TEXT_STRING_OWNER) {
        if core_private_source_part(CORE_TEXT_STRING_OWNER) == .Some(part) { if scheduled.insert(part.source.module) { source_modules.push(part.source) } }
    }
    core_index := 0
    module_aliases := bundle.modules.iter().map(fn(module) { module.alias.clone() }).collect[HashSet[String]]()
    while core_index < source_modules.len() {
        source_module :: source_modules[core_index]
        core_index += 1
        source :: core_source_text(source_module.module).unwrap_or_else(fn() { panic("Core source module `{source_module.module}` has no body text") }).to_string()
        display :: source_module.path.to_string()
        source_for_parse :: Package.mask_inline_package_source(source).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(display, source, [error.diagnostic()])) })?.0
        // Embedded vetted Core alone may use reserved __name namespace.
        (tokens, lex_diags) :: Lexer.lex_generated(source_for_parse)
        if !lex_diags.is_empty() { return Err(record_loader_error(&sink, LoaderError.at(display, source, lex_diags))) }
        (program, teaching) := Parser.parse_for_check_with_source(tokens, source_for_parse).map_err(fn(diags) { record_loader_error(&sink, LoaderError.at(display, source, diags)) })?
        for dependency in program.imports.iter().filter_map(core_source_import_module) {
            if core_source_module(dependency) == .Some(dep) { if scheduled.insert(dep.module) { source_modules.push(dep) } }
            if dependency == CORE_TEXT_STRING_OWNER { if core_private_source_part(CORE_TEXT_STRING_OWNER) == .Some(part) { if scheduled.insert(part.source.module) { source_modules.push(part.source) } } }
        }
        owned_members :: source_module.owned_members.iter().copied().collect[HashSet[String]]()
        program.items.retain(fn(item) { if item == .Func(function) { if function.is_pub { return owned_members.contains(function.name) } }; true })
        core_path :: "{CORE_SOURCE_ROOT}/{display}"
