// Rust: crates/jet-driver/src/Loader.rs:3253
// One namespace permits at most one top-level run; libraries have none.
pub fn package_run_member(root: &OSPath) -> OSPath? {
    resolver_opt :: AuthorityResolver.open(root).ok()
    if resolver_opt.is_none() { return None }
    files_opt :: resolver_opt.unwrap().discover_source_files().ok()
    if files_opt.is_none() { return None }
    files_opt.unwrap().into_iter().find(fn(file) {
        if file.relative.file_name().and_then(fn(name) { name.to_str() }) == Some(Syntax.PACKAGE_FILE) { return false }
        file.text().is_ok_and(fn(source) {
            (tokens, lex_diagnostics) :: Lexer.lex(source)
            lex_diagnostics.is_empty() && Parser.parse_with_source(tokens, source).is_ok_and(fn(program) { program.items.iter().any(fn(item) { if item == .Func(function) { function.name == "run" } else { false } }) })
        })
    }).map(fn(file) { file.path })
}
// Rust: crates/jet-driver/src/Loader.rs:3279
// Locked compilation never consumes mutable path/Git source projections.
pub fn verify_locked_dependency_sources(entry_path: &String) -> Unit [Diagnostic]! {
    entry :: OSPath(entry_path)
    entry_dir :: entry.parent().unwrap_or(OSPath("."))
    manifest_root :: find_manifest_root_checked(entry_dir).map_err(fn(d) { [d] })?
    package_root_opt :: manifest_root.clone().or_else(fn() { AuthorityResolver.authority_walk_root(entry_dir).ok() })
    if package_root_opt.is_none() { return Ok(()) }
    package_root :: package_root_opt.unwrap()
    facts_opt :: package_facts_for_entry(entry)?
    if facts_opt.is_none() { return Ok(()) }
    manifest :: Package.to_manifest(facts_opt.unwrap(), "").map_err(fn(diagnostic) { [diagnostic] })?
    if manifest.dependencies.is_empty() { return Ok(()) }
    lock_root :: find_workspace_root_checked(entry_dir).map_err(fn(d) { [d] })?.unwrap_or_else(fn() { package_root.clone() })
    lock_path :: lock_root.join(Syntax.UNIFIED_LOCK_FILE)
    lock :: Lock.load_strict_with_path(lock_root).map_err(fn(diagnostic) { [diagnostic] })?.ok_or_else(fn() { [Lock.e1202(lock_path.display().to_string())] })?
    Lock.verify_lock_matches_manifest(lock, manifest, lock_path.display().to_string()).map_err(fn(diagnostic) { [diagnostic] })?
    Lock.verify_all_manifest_deps_locked(manifest, lock).map_err(fn(error) { [error.diagnostic()] })?
    lock.validate_completeness().map_err(fn(error) { [error.diagnostic()] })?
