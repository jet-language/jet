}

// Rust: crates/jet-driver/src/Loader.rs:4847
fn resolve_code_module_file(name: &String, name_span: Span, importing: &OSPath, pkg_dep_dirs: &[String:DependencyDir], pkg_resolution: &PkgResolution, dependencies: &[OSPath]) -> OSPath Diagnostic! {
    dir :: importing.parent().unwrap_or(OSPath.new("."))
    direct :: normalize_path(&dir.join("{name}.{Syntax.FILE_EXT}"))
    module_jet :: normalize_path(&dir.join(name).join("module.{Syntax.FILE_EXT}"))
    for candidate in [&direct, &module_jet] { if !dependencies.contains(candidate) { dependencies.push(candidate.clone()) } }
    authority_opt :: dependency_authority_for_path(importing, pkg_dep_dirs, pkg_resolution)
    (resolver, relative_dir) :: if authority_opt.is_some() {
        authority :: authority_opt.unwrap()
        relative_dir :: dir.strip_prefix(authority.root()).map_err(fn(_) { AuthorityError.Escapes(dir.to_path_buf()).diagnostic() })?.to_path_buf()
        (authority.clone(), relative_dir)
    } else { (AuthorityResolver.open(dir).map_err(fn(error) { error.diagnostic() })?, OSPath.new()) }
    for relative in [relative_dir.join("{name}.{Syntax.FILE_EXT}"), relative_dir.join(name).join("module.{Syntax.FILE_EXT}")] {
        if resolver.checked_file(&relative) == { .Ok(file) -> { resolver.revalidate_file(&file).map_err(fn(error) { error.diagnostic() })?; return Ok(file.path) }; .Err(error) if error.is_missing() -> {}; .Err(error) -> return Err(error.diagnostic()) }
