// Rust: crates/jet-driver/src/Loader.rs:4906
pub fn resolve_import(imp: &ImportDecl, importing: &OSPath, project_root: &OSPath, pkg_dep_dirs: &[String:DependencyDir], pkg_resolution: &PkgResolution, project_parts: &ProjectPartsReport, project_part_failures: &[ProjectPartScanFailure]) -> OSPath Diagnostic! {
