    resolver.revalidate_file(&checked).map_err(fn(error) { Diagnostic.error("E0603", "can't find the file `{path_str}`", "a file import path must point at an existing `.jet` file next to this file's tree", "restore the checked file and fix the path in `{Syntax.KW_USE} \"{path_str}\"` ({error})", Some(span)) })?
