//RS /// A namespace diagnostic at a member file. The entry renders against its own
//RS /// source already; any other member carries its origin so the span renders
//RS /// against the file that declares it.
//RS fn member_error(
//RS     modules: &[LoadedModule],
//RS     module_idx: usize,
//RS     entry_idx: usize,
//RS     diagnostic: Diagnostic,
//RS ) -> LoaderError {
//RS     let module = &modules[module_idx];
//RS     let error = LoaderError::at(&module.display, &module.source, vec![diagnostic]);
//RS     if module_idx == entry_idx {
//RS         error
//RS     } else {
//RS         error.with_module_origin(&module.display, &module.path)
//RS     }
//RS }
//RS 
//RS /// D-MOD-CYCLE1=A: make every package one namespace. Each member file is
//RS /// recorded under its package root, a name declared in two member files is
//RS /// E0624, and each member receives compiler-owned bindings for its siblings'
//RS /// top-level names. Those bindings use the ordinary file-module and member
//RS /// import path, so sema, lowering, and every tier resolve a sibling name
//RS /// exactly like an imported one. They carry zero-width spans: they are not
//RS /// written source, so they never render, and liveness never reports them.
//RS fn bind_package_namespaces(
//RS     modules: &mut [LoadedModule],
