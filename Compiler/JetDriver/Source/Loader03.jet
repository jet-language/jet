// Rust: crates/jet-driver/src/Loader.rs:4829
fn policy_ladder_diagnostic(key: PolicyKey, error: PolicyError) -> Diagnostic {
    span :: if error == { .ProhibitedScope { span, .. } | .Widening { span, .. } -> span; .Conflict { second, .. } -> second }
