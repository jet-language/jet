fn member_error(modules: &[LoadedModule], module_idx: USize, entry_idx: USize, diagnostic: Diagnostic) -> LoaderError {
    module :: &modules[module_idx]
    error :: LoaderError.at(&module.display, &module.source, [diagnostic])
    if module_idx == entry_idx { error } else { error.with_module_origin(&module.display, &module.path) }
}

// Rust: crates/jet-driver/src/Loader.rs:5329
// One namespace per package. Compiler-owned sibling bindings use zero-width spans.
pub fn bind_package_namespaces(modules: &[LoadedModule], entry_idx: USize, namespace_roots: &[OSPath:OSPath?], name_ledger: &NameLedger) -> Unit LoaderError! {
    groups := [(OSPath, [USize])].new()
    group_positions := [OSPath:USize].new()
    for module_idx in 0..modules.len() {
        root_opt :: namespace_root(&modules[module_idx].path, namespace_roots)
        if root_opt.is_none() { continue }
        root :: root_opt.unwrap()
        if group_positions.get(&root) == {
            .Some(position) -> groups[position].1.push(module_idx)
            .None -> { _ :: group_positions.insert(root.clone(), groups.len()); groups.push((root, [module_idx])) }
        }
    }
    for (root, members) in &groups {
        root_key :: root.to_string_lossy().into_owned()
        for member in members { name_ledger.set_module_namespace(member, root_key.clone()) }
        facts :: package_facts_for_root(root).ok().flatten()
        named_entry_files :: facts.iter().flat_map(fn(facts) { facts.outputs.values() }).filter(fn(output) { output.kind == Package.PackageOutputKind.Executable }).filter_map(fn(output) { output.entry.as_deref()?.strip_suffix(".run").map(fn(entry) { entry.to_string() }) }).collect()
        names :: members.iter().map(fn(member) {
            path :: &modules[member].path
            named_entry :: named_entry_files.contains(&modules[member].alias)
            role_command :: path.file_name().and_then(fn(name) { name.to_str() }).filter(fn(name) { Syntax.COMMAND_ROLE_FILES.contains(name) }).filter(fn(_) { path.parent().is_some_and(fn(parent) { normalize_path(parent) == root }) }).and_then(fn(name) { name.strip_prefix('@')?.strip_suffix(".jet") })
            namespace_item_names(&modules[member].items).into_iter().filter(fn((name, _)) { !(named_entry && name == "run") && role_command != Some(name.as_str()) }).collect()
        }).collect()
        owners := [String:USize].new()
        for (position, member_names) in names.iter().enumerate() {
            for (name, span) in member_names {
                if owners.get(name) == {
                    .Some(first) if first != position -> {
                        package :: root.file_name().map(fn(name) { name.to_string_lossy().into_owned() }).unwrap_or_else(fn() { root_key.clone() })
                        other :: modules[members[first]].display.clone()
                        // Rust: crates/jet-driver/src/Loader.rs:5401
                        return Err(member_error(modules, members[position], entry_idx, Diagnostic.from_row("E0624", &[("name", name), ("package", &package), ("other", &other)], Some(span))))
                    }
                    .Some(_) -> {}
                    .None -> { _ :: owners.insert(name.clone(), position) }
                }
            }
        }
        declares_library :: facts.as_ref().is_some_and(fn(facts) { facts.outputs.values().any(fn(output) { output.kind == Package.PackageOutputKind.Library }) && !facts.outputs.values().any(fn(output) { output.kind == Package.PackageOutputKind.Executable }) })
        if declares_library {
            for (position, member_names) in names.iter().enumerate() {
                if member_names.iter().find(fn((name, _)) { name == "run" }) == { .Some((_, span)) -> return Err(member_error(modules, members[position], entry_idx, Diagnostic.from_row("E0625", &[], Some(span)))); .None -> {} }
            }
        }
        for member in members {
            taken := modules[member].imports.iter().filter(fn(import) { import.span.start == import.span.end }).map(fn(import) { import.span.start }).collect()
            _ :: taken.insert(0)
            next_span := 0
            fresh_span :: fn() { while taken.contains(&next_span) { next_span += 1 }; _ :: taken.insert(next_span); Span.new(next_span, next_span) }
            for (sibling_position, sibling) in members.iter().enumerate() {
                if sibling == member || names[sibling_position].is_empty() { continue }
                alias :: "__jet_pkg_{modules[sibling].alias}"
                file_span :: fresh_span()
                list_span :: fresh_span()
                bound :: names[sibling_position].iter().map(fn((name, _)) { (name.clone(), None) }).collect()
                count :: bound.len()
                sibling_display :: modules[sibling].display.clone()
                imports :: &modules[member].imports
                imports.push(ImportDecl { kind: .File(sibling_display, file_span), alias: alias.clone(), alias_span: file_span, span: file_span, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: None })
                imports.push(ImportDecl { kind: .Unqualified { module_alias: alias.clone(), module_alias_span: list_span, items: bound, items_span: list_span, span: list_span }, alias, alias_span: list_span, span: list_span, item_spans: [list_span; count], local_spans: [list_span; count], is_pub: false, is_package_pub: false, inline_version: None })
                name_ledger.record_import_target(member, file_span, sibling)
            }
        }
    }
    Ok(())
}
