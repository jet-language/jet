// Rust: crates/jet-driver/src/Loader.rs:5187
fn is_loose_file(importing: &OSPath) -> Bool {
    has_header :: CheckReads.read_to_string(importing).map(fn(source) { if Package.extract_inline_package(&source) == { .Ok(.None) -> false; _ -> true } }).unwrap_or(false)
    if has_header { return false }
    folder :: importing.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }).unwrap_or(OSPath.new("."))
    if find_manifest_root_checked(folder) == { .Ok(.None) -> true; _ -> false }
}

// Rust: crates/jet-driver/src/Loader.rs:5204
pub fn shared_folder_below_package(path: &OSPath) -> (OSPath, OSPath)? {
    // Rust cfg(unix) and cfg(not(unix)); dispatch on the selected target, never the host.
    if core.sys.target.selected_family() != "unix" { return None }
    shared := None
    for folder in path.ancestors().skip(1) {
        if folder.as_os_str().is_empty() { continue }
        if shared == {
            .Some(below) -> if folder.join(Syntax.PACKAGE_FILE).is_file() { return Some((below.to_path_buf(), folder.to_path_buf())) }
            .None -> {
                // GATE #4494: retained native permission mode accessor.
                if fs.symlink_metadata(folder).is_ok_and(fn(metadata) { metadata.permissions().mode() & 0o002 != 0 }) { shared = Some(folder) }
            }
        }
    }
    None
}

// Rust: crates/jet-driver/src/Loader.rs:5233
pub fn namespace_root(path: &OSPath, cache: &[OSPath:OSPath?]) -> OSPath? {
    if path.starts_with(CORE_SOURCE_ROOT) || !path.is_file() { return None }
    has_header :: CheckReads.read_to_string(path).map(fn(source) { if Package.extract_inline_package(&source) == { .Ok(.None) -> false; _ -> true } }).unwrap_or(false)
    if has_header { return None }
    folder :: path.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }).unwrap_or(OSPath.new("."))
    cache.entry(folder.to_path_buf()).or_insert_with(fn() { find_manifest_root_checked(folder).ok().flatten().map(fn(root) { normalize_path(&root) }) }).clone()
}

// Rust: crates/jet-driver/src/Loader.rs:5262
pub fn package_member_files(root: &OSPath) -> [OSPath] Diagnostic! {
    resolver :: AuthorityResolver.open(root).map_err(fn(error) { error.diagnostic() })?
    files :: resolver.discover_source_files().map_err(fn(error) { error.diagnostic() })?
    Ok(files.into_iter().filter(fn(file) { name :: file.relative.file_name().and_then(fn(name) { name.to_str() }); name != Some(Syntax.PACKAGE_FILE) && name != Some(Syntax.PAYLOAD_FILE) && name != Some(Syntax.WORKSPACE_FILE) }).map(fn(file) { normalize_path(&file.path) }).collect())
}

// Rust: crates/jet-driver/src/Loader.rs:5281
fn namespace_item_names(items: &[Item]) -> [(String, Span)] {
    names := [(String, Span)].new()
    for item in items {
        if item == {
            .Func(function) -> names.push((function.name.clone(), function.name_span))
            .Struct(definition) -> names.push((definition.name.clone(), definition.name_span))
            .Enum(definition) -> names.push((definition.name.clone(), definition.name_span))
            .Distinct(definition) -> names.push((definition.name.clone(), definition.name_span))
            .TypeAlias(definition) -> names.push((definition.name.clone(), definition.name_span))
            .Trait(definition) -> names.push((definition.name.clone(), definition.name_span))
            .Tag(definition) -> names.push((definition.name.clone(), definition.name_span))
            .Const(definition) -> names.push((definition.name.clone(), definition.name_span))
            .UnitFamily(family) -> for definition in family.distinct_defs() { names.push((definition.name.clone(), definition.name_span)) }
            .ProtocolDecl(protocol) -> names.push((protocol.name.clone(), protocol.name_span))
            _ -> {}
        }
    }
    names
}

