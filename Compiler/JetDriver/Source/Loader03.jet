// Rust: crates/jet-driver/src/Loader.rs:5104
fn resolve_file_import(importing: &OSPath, path_str: &String, project_root: &OSPath, pkg_dep_dirs: &[String:DependencyDir], pkg_resolution: &PkgResolution, span: Span) -> OSPath Diagnostic! {
