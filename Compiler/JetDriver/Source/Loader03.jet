// Rust: crates/jet-driver/src/Loader.rs:3578
// Complete the immutable store-path item split at the packet boundary.
pub fn locked_store_source_path(dep_name: &String, package: &Lock.LockedPackage) -> OSPath Diagnostic! {
    fingerprint :: package.fingerprint.strip_prefix("sha256-").unwrap_or(&package.fingerprint)
    if !safe_store_component(dep_name) || !safe_store_component(&package.version) || !safe_store_component(fingerprint) { return Err(locked_dependency_diagnostic(dep_name, "the lock has no safe immutable store fingerprint")) }
    env :: CheckReads.env_var
    root :: env("JET_PACKAGE_STORE_DIR").or_else(fn() { env("HOME").map(fn(home) { "{home}/.jet/store" }) }).or_else(fn() { env("USERPROFILE").map(fn(home) { "{home}/.jet/store" }) }).unwrap_or_else(fn() { ".jet/store" })
    Ok(OSPath.from(root).join("{dep_name}-{package.version}-{fingerprint}"))
}

// Rust: crates/jet-driver/src/Loader.rs:3606
pub fn safe_store_component(value: &String) -> Bool {
    normal :: if OSPath.new(value).components().next() == { .Some(.Normal(_)) -> true; _ -> false }
    !value.is_empty() && value != "." && value != ".." && !value.contains(['/', '\\', ':']) && !value.chars().any(fn(ch) { ch.is_control() }) && normal && OSPath.new(value).components().nth(1).is_none()
}

// Rust: crates/jet-driver/src/Loader.rs:3619
pub fn locked_dependency_diagnostic(dep_name: &String, detail: &String) -> Diagnostic {
    Diagnostic.error("E1204", "locked dependency `{dep_name}` failed source verification", detail.to_string(), "run `jet fetch` to recreate the lock from the verified dependency source", None)
}

// Rust: crates/jet-driver/src/Loader.rs:3629
pub fn record_locked_source_identity(resolved_sources: &[String:String], dep_name: &String, identity: String) -> Unit [Diagnostic]! {
    if resolved_sources.get(dep_name) == {
        .Some(previous) -> if previous != &identity { return Err([locked_dependency_diagnostic(dep_name, "the same dependency name resolves to multiple locked source identities")]) }
        .None -> { _ :: resolved_sources.insert(dep_name.to_string(), identity) }
    }
    Ok(())
}

// Rust: crates/jet-driver/src/Loader.rs:3647
pub fn path_dependency_escape_diagnostic(dep_name: &String, path: &String, package_root: &OSPath) -> Diagnostic {
    Diagnostic.error("E1206", "path dependency `{dep_name}` escapes its parent package", "the path `{path}` resolves outside the declaring package directory `{package_root.display()}`", "use a relative path below the declaring package directory", None)
}

// Rust: crates/jet-driver/src/Loader.rs:3664
// Canonical run.jet names the authority; retired main.jet never becomes fallback.
pub fn authority_name_for_entry(entry: &OSPath) -> String Diagnostic! {
    parent :: entry.parent().unwrap_or_else(fn() { OSPath.new(".") })
    resolver :: AuthorityResolver.open(parent).map_err(fn(error) { error.diagnostic() })?
    authority :: if resolver.checked_file(OSPath.new(Syntax.DEFAULT_ENTRY_FILE)) == {
        .Ok(run) -> { resolver.revalidate_file(&run).map_err(fn(error) { error.diagnostic() })?; run.path }
        .Err(error) if error.is_missing() -> entry.to_path_buf()
        .Err(error) -> return Err(error.diagnostic())
    }
    legacy_stem :: Syntax.LEGACY_ENTRY_FILE.strip_suffix(".jet").unwrap_or(Syntax.LEGACY_ENTRY_FILE)
    Ok(authority.file_stem().and_then(fn(name) { name.to_str() }).filter(fn(name) { !name.is_empty() && name != legacy_stem }).unwrap_or("app").to_string())
}

// Rust: crates/jet-driver/src/Loader.rs:3690
// Nearest workspace is an independent authority boundary, including malformed declarations.
pub fn find_workspace_root_with_error(start: &OSPath) -> OSPath? (OSPath, AuthorityError)! {
    dir := AuthorityResolver.authority_walk_root(start).map_err(fn(error) { (start.to_path_buf(), error) })?
    loop {
        resolver :: AuthorityResolver.open_for_authority_walk(&dir).map_err(fn(error) { (dir.clone(), error) })?
        if resolver == {
            .Some(resolver) -> if resolver.resolve_workspace_source() == {
                .Ok(.Some(_)) -> return Ok(Some(dir))
                .Ok(.None) -> {}
                .Err(error) -> return Err((dir.clone(), error))
            }
            .None -> {}
        }
        parent :: AuthorityResolver.authority_walk_parent(&dir)
        if parent.is_none() { return Ok(None) }
        dir = parent.unwrap()
    }
}

// Rust: crates/jet-driver/src/Loader.rs:3718
pub fn find_workspace_root_checked(start: &OSPath) -> OSPath? Diagnostic! { find_workspace_root_with_error(start).map_err(fn((_, error)) { error.workspace_diagnostic() }) }

// Rust: crates/jet-driver/src/Loader.rs:3723
// A real package or workspace stops stale-name discovery.
pub fn find_stale_manifest_name(start: &OSPath) -> (OSPath, String)? {
    dir := AuthorityResolver.authority_walk_root(start).ok()?
    loop {
        resolver_opt :: AuthorityResolver.open_for_authority_walk(&dir).ok()?
        if resolver_opt.is_none() { dir = AuthorityResolver.authority_walk_parent(&dir)?; continue }
        resolver :: resolver_opt.unwrap()
        if resolver.checked_manifest(OSPath.new(".")) == {
            .Ok(_) -> return None
            .Err(error) if error.is_missing() -> {}
            .Err(.RetiredManifest(_)) -> return Some((dir, Syntax.PAYLOAD_FILE))
            .Err(_) -> return None
        }
        for name in Syntax.STALE_MANIFEST_NAMES {
            if resolver.checked_file(OSPath.new(name)) == {
                .Ok(file) -> { resolver.revalidate_file(&file).ok()?; return Some((dir, name)) }
                .Err(error) if error.is_missing() -> {}
                .Err(_) -> return None
            }
        }
        if resolver.resolve_workspace_source() == { .Ok(.Some(_)) -> return None; .Ok(.None) -> {}; .Err(_) -> return None }
        dir = AuthorityResolver.authority_walk_parent(&dir)?
    }
}

// Rust: crates/jet-driver/src/Loader.rs:3768
pub fn stale_manifest_name_diagnostic(start: &OSPath) -> (OSPath, Diagnostic)? {
    (dir, stale) :: find_stale_manifest_name(start)?
    path :: dir.join(stale)
    Some((path.clone(), Diagnostic.error("E1226", "`{stale}` is not the package manifest name — Jet reads `{Syntax.PACKAGE_FILE}`", "the Package root filename is frozen to one spelling (D-ECO-FILEROOT1) so tooling, docs, and every worked example never have to guess which file to read", "rename `{path.display()}` to `{dir.join(Syntax.PACKAGE_FILE).display()}`", None)))
}

// Rust: crates/jet-driver/src/Loader.rs:3791
pub fn stale_manifest_name_message(start: &OSPath) -> String? { (_, diagnostic) :: stale_manifest_name_diagnostic(start)?; Some(diagnostic.render("", "")) }

// Rust: crates/jet-driver/src/Loader.rs:3800
// Dry resolution reads manifests only: no fetch/store/link side effects.
pub fn dry_resolve_path_deps(mf: &Manifest.Manifest, project_root: &OSPath) -> Unit Diagnostic! {
    seen := [String:(String, [String])].new()
    root_name :: mf.package.name.clone()
    canonical_root :: fs.canonicalize(project_root).ok()
    root_reach := RootPathReach { declared: [], sibling_dirs: [] }
    for spec in mf.dependencies.values() {
        if spec == {
            .Path { path } -> {
                if OSPath.new(path).is_absolute() { continue }
                resolved_opt :: fs.canonicalize(project_root.join(path)).ok()
                if resolved_opt.is_none() { continue }
                resolved :: resolved_opt.unwrap()
                outside_root :: canonical_root.as_ref().is_some_and(fn(root) { !resolved.starts_with(root) })
                if outside_root {
                    if resolved.parent() == { .Some(parent) -> root_reach.sibling_dirs.push(parent.to_path_buf()); .None -> {} }
                }
                root_reach.declared.push(resolved)
            }
            _ -> continue
        }
    }
    dry_resolve_recursive(mf, project_root, &[root_name], &seen, false, &root_reach)
}

// Rust: crates/jet-driver/src/Loader.rs:3839
struct RootPathReach { declared: [OSPath], sibling_dirs: [OSPath] }
extend RootPathReach {
    // Rust: crates/jet-driver/src/Loader.rs:3850
    fn contains(self: &RootPathReach, resolved: &OSPath) -> Bool { self.declared.iter().any(fn(declared) { declared == resolved }) || self.sibling_dirs.iter().any(fn(dir) { resolved.starts_with(dir) }) }
}

// Rust: crates/jet-driver/src/Loader.rs:3856
fn dry_resolve_recursive(mf: &Manifest.Manifest, pkg_dir: &OSPath, chain: &[String], seen: &[String:(String, [String])], enforce_path_boundary: Bool, root_reach: &RootPathReach) -> Unit Diagnostic! {
    for (dep_alias, spec) in &mf.dependencies {
        path_opt :: if spec == { .Path { path } -> Some(path); _ -> None }
        if path_opt.is_none() { continue }
        path :: path_opt.unwrap()
        dep_path :: normalize_path(&pkg_dir.join(path))
        declared_by_root :: !OSPath.new(path).is_absolute() && fs.canonicalize(&dep_path).is_ok_and(fn(resolved) { root_reach.contains(&resolved) })
        enforce_path_boundary :: enforce_path_boundary && !declared_by_root
        if enforce_path_boundary && (OSPath.new(path).is_absolute() || !dep_path.starts_with(pkg_dir)) { return Err(path_dependency_escape_diagnostic(dep_alias, path, pkg_dir)) }
        if enforce_path_boundary {
            parent :: fs.canonicalize(pkg_dir).map_err(fn(error) { locked_dependency_diagnostic(dep_alias, &"could not resolve the declaring package root: {error}") })?
            if fs.canonicalize(&dep_path) == { .Ok(resolved) -> if !resolved.starts_with(parent) { return Err(path_dependency_escape_diagnostic(dep_alias, path, pkg_dir)) }; .Err(_) -> {} }
        }
        dep_facts :: if package_facts_for_root(&dep_path) == {
            .Ok(.Some(facts)) -> facts
            .Ok(.None) -> continue
            .Err(diagnostics) -> {
                diagnostics := diagnostics
                return Err(diagnostics.pop().unwrap_or_else(fn() { Diagnostic.error("E1206", "package dependency `{dep_alias}` is invalid", "the dependency package facts could not be loaded", "restore the dependency package source and retry", None) }))
            }
        }
        dep_mf :: Package.to_manifest(&dep_facts, "")?
        dep_pkg_name :: dep_mf.package.name.clone()
        dep_version :: dep_mf.package.version.clone()
        child_chain := chain.to_vec()
        child_chain.push(dep_alias.clone())
        if seen.get(&dep_pkg_name).cloned() == {
            .Some((prev_ver, prev_chain)) -> if prev_ver != dep_version { return Err(Lock.e1201(&dep_pkg_name, &prev_ver, &prev_chain, &dep_version, &child_chain)) }
            .None -> {
                _ :: seen.insert(dep_pkg_name.clone(), (dep_version, child_chain.clone()))
                dry_resolve_recursive(&dep_mf, &dep_path, &child_chain, seen, true, root_reach)?
            }
        }
    }
    Ok(())
}

// Rust: crates/jet-driver/src/Loader.rs:3933
pub struct DependencyDir { pub manifest_root: OSPath, pub source_root: OSPath, pub authority: AuthorityResolver, pub boundary_policy: ImportBoundaryPolicy?, pub auto_derive_default: Bool?, pub direct: Bool, pub deps: Set[String] }

// Rust: crates/jet-driver/src/Loader.rs:3947
fn dependency_authority_for_path(path: &OSPath, dependencies: &[String:DependencyDir], pkg_resolution: &PkgResolution) -> AuthorityResolver? {
    dependencies.values().map(fn(dependency) { &dependency.authority }).chain(pkg_resolution.realized_authorities.values()).filter(fn(authority) { path.starts_with(authority.root()) }).max_by_key(fn(authority) { authority.root().components().count() })
}

// Rust: crates/jet-driver/src/Loader.rs:3960
fn dependency_visible_from(importing: &OSPath, name: &String, dependencies: &[String:DependencyDir]) -> Bool {
    owner :: dependencies.values().filter(fn(dependency) { importing.starts_with(&dependency.source_root) || importing.starts_with(&dependency.manifest_root) }).max_by_key(fn(dependency) { dependency.manifest_root.components().count() })
    if owner == { .Some(owner) -> owner.deps.contains(name) && dependencies.contains_key(name); .None -> dependencies.get(name).is_some_and(fn(dependency) { dependency.direct }) }
}

// Rust: crates/jet-driver/src/Loader.rs:3981
fn dependency_dir_from_resolver(resolver: AuthorityResolver) -> DependencyDir [Diagnostic]! {
    src_root :: if resolver.checked_manifest(OSPath.new(".")) == {
        .Ok(_) -> resolver.root().to_path_buf()
        .Err(error) if error.is_missing() -> {
            directory :: if resolver.checked_directory(OSPath.new(".jet")) == {
                .Ok(directory) -> directory
                .Err(error) if error.is_missing() -> { root :: resolver.root().to_path_buf(); return dependency_dir_with_source_root(resolver, root) }
                .Err(error) -> return Err([error.diagnostic()])
            }
            nested :: AuthorityResolver.from_checked_directory(&directory)
            if nested.checked_manifest(OSPath.new(".")) == { .Ok(_) -> directory.path; .Err(error) if error.is_missing() -> resolver.root().to_path_buf(); .Err(error) -> return Err([error.diagnostic()]) }
        }
        .Err(error) -> return Err([error.diagnostic()])
    }
    dependency_dir_with_source_root(resolver, src_root)
}

// Rust: crates/jet-driver/src/Loader.rs:4010
fn dependency_dir_with_source_root(resolver: AuthorityResolver, src_root: OSPath) -> DependencyDir [Diagnostic]! {
    authority :: if src_root == resolver.root() { resolver.clone() } else {
        relative :: src_root.strip_prefix(resolver.root()).map_err(fn(_) { [Diagnostic.error("E1334", "dependency source root is outside its checked package root", "`{src_root.display()}` is not below `{resolver.root().display()}`", "repair the dependency's package layout and retry", None)] })?
        directory :: resolver.checked_directory(relative).map_err(fn(error) { [error.diagnostic()] })?
        AuthorityResolver.from_checked_directory(&directory)
    }
    (boundary_policy, auto_derive_default, deps) :: dependency_manifest_policy(&authority, &src_root)?
    Ok(DependencyDir { manifest_root: resolver.root().to_path_buf(), source_root: src_root, authority, boundary_policy, auto_derive_default, direct: false, deps })
}

// Rust: crates/jet-driver/src/Loader.rs:4044
fn dependency_manifest_policy(resolver: &AuthorityResolver, source_root: &OSPath) -> (ImportBoundaryPolicy?, Bool?, Set[String]) [Diagnostic]! {
    facts_opt :: package_facts_from_resolver(resolver)?
    if facts_opt.is_none() { return Ok((None, None, [String].new().into_set())) }
    facts :: facts_opt.unwrap()
    manifest :: Package.to_manifest(&facts, "").map_err(fn(diagnostic) { [diagnostic] })?
    auto_derive_default :: !LintPolicy.is_denied(manifest.policy.lints_deny.as_deref().unwrap_or_default(), LintPolicy.auto_derive_lint().code)
    Ok((Some(ImportBoundaryPolicy.from_manifest(&manifest, source_root)), Some(auto_derive_default), manifest.dependencies.keys().cloned().collect()))
}

// Rust: crates/jet-driver/src/Loader.rs:4065
pub fn collect_dep_dirs(mf: &Manifest.Manifest, project_root: &OSPath) -> [String:DependencyDir] [Diagnostic]! {
    dirs := collect_declared_dep_dirs(mf, project_root)?
    for dependency in dirs.values_mut() { dependency.direct = true }
    pending := dirs.values().cloned().collect()
    expanded := [OSPath].new().into_set()
    while !pending.is_empty() {
        dependency :: pending.pop().unwrap()
        if dependency.deps.is_empty() || !expanded.insert(dependency.manifest_root.clone()) { continue }
        facts_opt :: package_facts_from_resolver(&dependency.authority)?
        if facts_opt.is_none() { continue }
        manifest :: Package.to_manifest(&facts_opt.unwrap(), "").map_err(fn(diagnostic) { [diagnostic] })?
        for (name, nested) in collect_declared_dep_dirs(&manifest, &dependency.manifest_root)? {
            if !dirs.contains_key(&name) { pending.push(nested.clone()); _ :: dirs.insert(name, nested) }
        }
    }
    Ok(dirs)
}

// Rust: crates/jet-driver/src/Loader.rs:4098
fn collect_declared_dep_dirs(mf: &Manifest.Manifest, project_root: &OSPath) -> [String:DependencyDir] [Diagnostic]! {
    dirs := [String:DependencyDir].new()
    lock :: Lock.load(project_root)
    for (dep_name, spec) in &mf.dependencies {
        if spec == {
            .Path { path } -> {
                abs :: normalize_path(&project_root.join(path))
                (source, store_authority, expected_hash) :: if lock.as_ref() == {
                    .Some(lock) -> if lock.packages.iter().find(fn(package) { package.name == dep_name && if package.source == { .Path(_) -> true; _ -> false } }) == {
                        .Some(package) -> (locked_store_source_path(dep_name, package).map_err(fn(diagnostic) { [diagnostic] })?, true, locked_store_content_hash(package).map(fn(hash) { hash.to_string() }))
                        .None -> (abs.clone(), false, None)
                    }
                    .None -> (abs, false, None)
                }
                if store_authority { verify_locked_source_tree(dep_name, &source, expected_hash.as_deref().unwrap_or(""))? }
                resolver_result :: if store_authority { AuthorityResolver.open_store(&source) } else { AuthorityResolver.open(&source) }
                resolver :: if resolver_result == { .Ok(resolver) -> resolver; .Err(error) if error.is_missing() -> continue; .Err(error) -> return Err([error.diagnostic()]) }
                _ :: dirs.insert(dep_name.clone(), dependency_dir_from_resolver(resolver)?)
            }
            .Git { .. } -> {
                (source, store_authority, expected_hash) :: if lock.as_ref() == {
                    .Some(lock) -> {
                        package :: lock.packages.iter().find(fn(package) { package.name == dep_name && if package.source == { .Git { .. } -> true; _ -> false } }).ok_or_else(fn() { Lock.e1202(&project_root.join(Syntax.UNIFIED_LOCK_FILE).display().to_string()) }).map_err(fn(diagnostic) { [diagnostic] })?
                        (locked_store_source_path(dep_name, package).map_err(fn(diagnostic) { [diagnostic] })?, true, locked_store_content_hash(package).map(fn(hash) { hash.to_string() }))
                    }
                    .None -> (project_root.join(".jet").join("build").join("deps").join(dep_name), false, None)
                }
                if store_authority { verify_locked_source_tree(dep_name, &source, expected_hash.as_deref().unwrap_or(""))? }
                resolver_result :: if store_authority { AuthorityResolver.open_store(&source) } else { AuthorityResolver.open(&source) }
                resolver :: if resolver_result == { .Err(error) if error.is_missing() -> continue; .Err(error) -> return Err([error.diagnostic()]); .Ok(resolver) -> resolver }
                _ :: dirs.insert(dep_name.clone(), dependency_dir_from_resolver(resolver)?)
            }
            // Registry sources require fetch; foreign bindings aren't Jet module roots.
            .Registry(_) | .Foreign { .. } -> {}
        }
    }
    Ok(dirs)
}

// Rust: crates/jet-driver/src/Loader.rs:4219
fn project_resolution(project_root: &OSPath) -> ([String:DependencyDir], PkgResolution) [Diagnostic]! {
    facts_opt :: package_facts_for_root(project_root)?
    if facts_opt.is_none() { return Ok(([String:DependencyDir].new(), PkgResolution.default())) }
    facts :: facts_opt.unwrap()
    manifest :: Package.to_manifest(&facts, "").map_err(fn(diagnostic) { [diagnostic] })?
    dep_dirs :: collect_dep_dirs(&manifest, project_root)?
    resolution :: collect_pkg_resolution(&facts).map_err(fn(diagnostic) { [diagnostic] })?
    Ok((dep_dirs, resolution))
}

// Rust: crates/jet-driver/src/Loader.rs:4238
fn project_resolution_for_bundle(bundle: &ProgramBundle) -> ([String:DependencyDir], PkgResolution) [Diagnostic]! {
    facts_opt :: package_facts_for_bundle(bundle)?
    if facts_opt.is_none() { return project_resolution(&bundle.project_root) }
    facts :: facts_opt.unwrap()
    manifest :: Package.to_manifest(&facts, "").map_err(fn(diagnostic) { [diagnostic] })?
    dep_dirs :: collect_dep_dirs(&manifest, &bundle.project_root)?
    resolution :: collect_pkg_resolution(&facts).map_err(fn(diagnostic) { [diagnostic] })?
    Ok((dep_dirs, resolution))
}

// Rust: crates/jet-driver/src/Loader.rs:4253
fn auto_derive_default_for_file(path: &OSPath, project_root: &OSPath, project_lints_deny: &[String], dependency_roots: &[String:DependencyDir]) -> Bool Diagnostic! {
    dependency :: dependency_roots.values().filter(fn(dependency) { path.starts_with(&dependency.source_root) }).max_by_key(fn(dependency) { dependency.source_root.components().count() })
    if dependency == {
        .Some(dependency) -> return dependency.auto_derive_default.ok_or_else(fn() { Diagnostic.error("E1334", "package manifest `{dependency.manifest_root.display()}` is missing", "a dependency source root must have one checked package manifest", "restore `package.jet` in the dependency root", None) })
        .None -> {}
    }
    if path.starts_with(project_root) { Ok(!LintPolicy.is_denied(project_lints_deny, LintPolicy.auto_derive_lint().code)) } else { Ok(true) }
}

// Rust: crates/jet-driver/src/Loader.rs:4287
fn apply_auto_derive_default(items: &[Item], default: Bool) -> {
    for item in items {
        if item == {
            .Struct(def) -> def.auto_derive_default = default
            .Enum(def) -> def.auto_derive_default = default
            .CodeModule(module) -> if module.body.as_mut() == { .Some(body) -> apply_auto_derive_default(body, default); .None -> {} }
            .GenericModule(module) -> apply_auto_derive_default(&module.body, default)
            _ -> {}
        }
    }
}

// Rust: crates/jet-driver/src/Loader.rs:4303
pub fn load_file(path: &OSPath, display: &String, project_root: &OSPath, pkg_dep_dirs: &[String:DependencyDir], pkg_resolution: &PkgResolution, package_policy: &[PolicyDeclaration], package_lints_deny: &[String], modules: &[LoadedModule], path_to_idx: &[OSPath:USize], stack: &[OSPath], overlays: &[(OSPath, String)], for_check: Bool, parse_teaching: &[Diagnostic], project_parts: &ProjectPartsReport, project_part_failures: &[ProjectPartScanFailure], dependencies: &[OSPath], prepared_frontend: PreparedFrontend?) -> Unit LoaderError! {
    is_entry :: path_to_idx.is_empty()
    load_file_located(path, display, project_root, pkg_dep_dirs, pkg_resolution, package_policy, package_lints_deny, modules, path_to_idx, stack, overlays, for_check, parse_teaching, project_parts, project_part_failures, dependencies, prepared_frontend).map_err(fn(error) { if is_entry { error } else { error.with_module_origin(display, path) } })
}

// Rust: crates/jet-driver/src/Loader.rs:4355
fn load_file_located(path: &OSPath, display: &String, project_root: &OSPath, pkg_dep_dirs: &[String:DependencyDir], pkg_resolution: &PkgResolution, package_policy: &[PolicyDeclaration], package_lints_deny: &[String], modules: &[LoadedModule], path_to_idx: &[OSPath:USize], stack: &[OSPath], overlays: &[(OSPath, String)], for_check: Bool, parse_teaching: &[Diagnostic], project_parts: &ProjectPartsReport, project_part_failures: &[ProjectPartScanFailure], dependencies: &[OSPath], prepared_frontend: PreparedFrontend?) -> Unit LoaderError! {
    prepared_frontend := prepared_frontend
    norm :: normalize_path(path)
    if !dependencies.contains(&norm) { dependencies.push(norm.clone()) }
    if stack.contains(&norm) {
        cycle :: stack.iter().chain(std.iter.once(&norm)).map(fn(p) { relative_display(project_root, p) }).collect()
        cycle_file :: stack.last().map(fn(path) { relative_display(project_root, path) }).unwrap_or_else(fn() { display.to_string() })
