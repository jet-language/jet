    for part in path_str.split('/') { if part.is_empty() || part == "." { continue }; resolved.push(part) }
    _ :: resolved.set_extension(Syntax.FILE_EXT)
    resolved :: normalize_path(&resolved)
    resolver :: if loose {
        folder :: resolved.parent().filter(fn(parent) { !parent.as_os_str().is_empty() }).unwrap_or(OSPath.new("."))
