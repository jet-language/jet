    } else {
        dependency_authority_for_path(importing, pkg_dep_dirs, pkg_resolution).cloned().map(fn(authority) { Ok(authority) }).unwrap_or_else(fn() { AuthorityResolver.open(project_root).map_err(fn(error) { error.diagnostic() }) })?
