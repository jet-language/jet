// Rust: crates/jet-store/src/lib.rs:1792
fn read_file(path: &OSPath) -> RawRead StoreError! {
    // GATE #4494: native metadata and retained file descriptors.
    metadata := fs.symlink_metadata(path) == {
        Ok(value) -> value
        Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound { return Ok(RawRead.Missing) }
            return Err(StoreError.Io(error))
        }
    }
    if metadata.file_type().is_symlink() || !metadata.is_file() {
        return Ok(RawRead.Corrupt("entry is not a regular file"))
    }
    file := File.open(path) == {
        Ok(value) -> value
        Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound { return Ok(RawRead.Corrupt("entry disappeared while opening")) }
            return Err(StoreError.Io(error))
        }
    }
    held := file.metadata()?
    if !same_file(&metadata, &held) { return Ok(RawRead.Corrupt("entry changed while opening")) }
    bytes := Array<U8>.with_capacity((held.len() as Int).min(64 * 1024))
    file.read_to_end(&bytes)?
    after := file.metadata()?
    path_after := fs.symlink_metadata(path)?
    if bytes.len() as U64 != held.len() || !same_file(&held, &after) || !same_file(&held, &path_after) {
        return Ok(RawRead.Corrupt("entry changed while reading"))
    }
    Ok(RawRead.Bytes(^bytes))
}

// Rust: crates/jet-store/src/lib.rs:1822
fn encode_action(action: ActionHandle, record: &[U8]) -> [U8] {
    digest := sha256(record)
    output := Array<U8>.with_capacity(ACTION_MAGIC.len() + 32 + 8 + 32 + record.len())
    output.extend_from_slice(ACTION_MAGIC)
    output.extend_from_slice(action.digest().as_bytes())
    output.extend_from_slice(&(record.len() as U64).to_le_bytes())
    output.extend_from_slice(&digest)
    output.extend_from_slice(record)
    output
}

// Rust: crates/jet-store/src/lib.rs:1833
fn decode_action(action: ActionHandle, bytes: &[U8]) -> [U8] Err! {
    header_len := ACTION_MAGIC.len() + 32 + 8 + 32
    if bytes.len() < header_len || !bytes.starts_with(ACTION_MAGIC) {
        return Err("action record has an unknown version or short header")
    }
    key_start := ACTION_MAGIC.len()
    key_end := key_start + 32
    if bytes[key_start..key_end] != action.digest().as_bytes() { return Err("action key does not match its path") }
    length_start := key_end
    length_end := length_start + 8
    length_bytes := bytes[length_start..length_end].try_into().map_err(fn(_) { "action length header is truncated" })?
    length := U64.from_le_bytes(length_bytes)
    digest_start := length_end
    digest_end := digest_start + 32
    payload := &bytes[digest_end..]
    if length != payload.len() as U64 { return Err("action record length does not match its payload") }
    if sha256(payload) != bytes[digest_start..digest_end] { return Err("action record payload digest mismatch") }
    Ok(payload.to_vec())
}

// Rust: crates/jet-store/src/lib.rs:1861
fn is_unsupported_store_version(bytes: &[U8]) -> Bool {
    versioned := bytes.strip_prefix("jet.store.v".as_bytes()) ?? return false
    (version, suffix) := versioned.split_first() ?? return false
    version.is_ascii_digit() && version != 49 && suffix.first() == Val(0)
}

// Rust: crates/jet-store/src/lib.rs:1871
fn action_for_key(key: &String) -> ActionHandle StoreError! { Ok(ActionHandle.new(Digest.from_hex(key)?)) }

// Rust: crates/jet-store/src/lib.rs:1875
fn encode_artifact(object: ObjectHandle, executable: Bool) -> [U8] {
    bytes := Array<U8>.with_capacity(ARTIFACT_MAGIC.len() + 32 + 8 + 1)
    bytes.extend_from_slice(ARTIFACT_MAGIC)
    bytes.extend_from_slice(object.digest().as_bytes())
    bytes.extend_from_slice(&object.length().to_le_bytes())
    bytes.push(if executable { 1 } else { 0 })
    bytes
}

// Rust: crates/jet-store/src/lib.rs:1884
fn decode_artifact(bytes: &[U8]) -> (ObjectHandle, Bool)? {
    expected := ARTIFACT_MAGIC.len() + 32 + 8 + 1
    if bytes.len() != expected || !bytes.starts_with(ARTIFACT_MAGIC) { return None }
    digest_start := ARTIFACT_MAGIC.len()
    digest_end := digest_start + 32
    length_end := digest_end + 8
    digest := bytes[digest_start..digest_end].try_into().ok() ?? return None
    length := U64.from_le_bytes(bytes[digest_end..length_end].try_into().ok() ?? return None)
    executable := bytes[length_end] == { 0 -> false; 1 -> true; _ -> { return None } }
    Val((ObjectHandle.new(Digest(digest), length), executable))
}

// Rust: crates/jet-store/src/lib.rs:1902
fn is_executable(metadata: &Metadata) -> Bool {
    // GATE #4494/#4500: target-native Unix permission mode.
    if selected_family() == "unix" { metadata.permissions().mode() & 0o111 != 0 } else { false }
}

// Rust: crates/jet-store/src/lib.rs:1915
fn parse_lease(_path: &OSPath, bytes: &[U8]) -> LeaseRecord? {
    text := String.from_utf8(bytes).ok() ?? return None
    lines := text.lines()
    header := (lines.next() ?? return None).split('|').collect()
    if header.len() != 4 || header[0] != STORE_VERSION || header[1] != "lease" { return None }
    pid := header[2].parse::<U32>().ok() ?? return None
    if header[3].is_empty() { return None }
    owner := ProcessIdentity.new(pid, header[3])
    targets: [EntryKey:Bool] = [:]
    for line in lines {
        fields := line.split('|').collect()
        if fields.len() != 2 { return None }
        key := parse_wire_key(fields[0], fields[1]) ?? return None
        targets.insert(key, true)
    }
    ordered := targets.keys().cloned().collect()
    ordered.sort()
    Val(LeaseRecord { owner: owner, targets: ordered })
}

// Rust: crates/jet-store/src/lib.rs:1942
fn parse_owner_line(bytes: &[U8]) -> ProcessIdentity? {
    text := String.from_utf8(bytes).ok() ?? return None
    trimmed := text.trim_end_matches('\n') // #4303
    fields := trimmed.split('|').collect()
    if fields.len() != 4 || fields[0] != STORE_VERSION || fields[1] != "lock" || fields[3].is_empty() { return None }
    Val(ProcessIdentity.new(fields[2].parse::<U32>().ok() ?? return None, fields[3]))
}

// Rust: crates/jet-store/src/lib.rs:1951
fn read_journal(path: &OSPath) -> JournalState StoreError! {
    // GATE #4494: native file read.
    bytes := fs.read(path) == {
        Ok(value) -> value
        Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound {
                state := JournalState.default(); state.valid = true
                return Ok(state)
            }
            return Err(StoreError.Io(error))
        }
    }
    state := JournalState.default()
    state.valid = true; state.bytes = bytes.len() as U64
    for line in bytes.split(fn(byte) { byte == 10 }) {
        if line.is_empty() { continue }
        parsed := parse_journal_line(line)
        if parsed.is_none() { state.valid = false; break }
        (operation, key, sequence) := parsed.unwrap()
        state.last_sequence = state.last_sequence.max(sequence)
        if operation == "remove" { _ :: state.entries.remove(&key) }
        else { state.entries.insert(key, JournalMeta { last_use: sequence }) }
    }
    Ok(state)
}

// Rust: crates/jet-store/src/lib.rs:1987
// One checksummed journal line; None for a torn, foreign, or corrupt line.
fn parse_journal_line(line: &[U8]) -> (String, EntryKey, U64)? {
    line := line.strip_suffix([13]).unwrap_or(line)
    text := String.from_utf8(line).ok() ?? return None
    fields := text.split('|').collect()
    if fields.len() != 7 || fields[0] != STORE_VERSION { return None }
    // Checksum covers everything before it, trailing separator included.
    prefix := &text[..text.len() - fields[6].len()]
    if sha256_hex(prefix.as_bytes()) != fields[6] { return None }
    _ :: fields[4].parse::<U64>().ok() ?? return None
    sequence := fields[5].parse::<U64>().ok() ?? return None
    key := parse_wire_key(fields[2], fields[3]) ?? return None
    if fields[1] == "put" || fields[1] == "touch" || fields[1] == "remove" { Val((fields[1].to_string(), key, sequence)) } else { None }
}

// Rust: crates/jet-store/src/lib.rs:2007
// A bounded final-line read keeps each journal append O(1).
const JOURNAL_TAIL_WINDOW: U64 = 64 * 1024

// Rust: crates/jet-store/src/lib.rs:2017
fn journal_tail_sequence(path: &OSPath) -> U64? StoreError! {
    // GATE #4494: retained file seek and bounded read.
    file := File.open(path) == {
        Ok(value) -> value
        Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound { return Ok(Val(0)) }
            return Err(StoreError.Io(error))
        }
    }
    length := file.metadata()?.len()
    if length == 0 { return Ok(Val(0)) }
    window := length.min(JOURNAL_TAIL_WINDOW)
    file.seek(io.SeekFrom.Start(length - window))?
    tail := Array<U8>.with_capacity(window as Int)
    file.take(window).read_to_end(&tail)?
    body := tail.strip_suffix([10]) ?? return Ok(None)
    start := body.iter().rposition(fn(byte) { byte == 10 }) == {
        Val(newline) -> newline + 1
        None -> { if window < length { return Ok(None) }; 0 }
    }
    Ok(parse_journal_line(&body[start..]).map(fn(entry) { entry.2 }))
}

// Rust: crates/jet-store/src/lib.rs:2042
fn parse_wire_key(kind: &String, value: &String) -> EntryKey? {
    kind == {
        "blob" -> Digest.from_hex(value).ok().map(fn(_) { EntryKey.Blob(value.to_string()) })
        "action" -> Digest.from_hex(value).ok().map(fn(_) { EntryKey.Action(value.to_string()) })
        "lto" -> {
            (namespace, digest) := value.split_once('~') ?? return None
            _ :: LtoNamespace.new(namespace).ok() ?? return None
            _ :: Digest.from_hex(digest).ok() ?? return None
            Val(EntryKey.Lto(namespace.to_string(), digest.to_string()))
        }
        _ -> None
    }
}

// Rust: crates/jet-store/src/lib.rs:2056
fn scan_flat_namespace(directory: &OSPath, kind: EntryKind, namespace: String?, output: &[StoredEntry]) -> Unit StoreError! {
    // GATE #4494: native directory entries and symlink metadata.
    for path in sorted_children(directory)? {
        metadata := fs.symlink_metadata(&path) == {
            Ok(value) -> value
            Err(error) -> { if error.kind() == io.ErrorKind.NotFound { continue }; return Err(StoreError.Io(error)) }
        }
        if metadata.file_type().is_symlink() || !metadata.is_file() { continue }
        name := path.file_name().and_then(fn(name) { name.to_str() }) ?? continue
        if Digest.from_hex(name).is_err() { continue }
        key := kind == {
            EntryKind.Blob -> EntryKey.Blob(name.to_string())
            EntryKind.Action -> EntryKey.Action(name.to_string())
            EntryKind.Lto -> EntryKey.Lto(namespace.clone().expect("LTO namespace"), name.to_string())
        }
        output.push(StoredEntry { key: key, path: path, size_bytes: metadata.len(), last_use: 0, pinned: false })
    }
    Ok(())
}

// Rust: crates/jet-store/src/lib.rs:2093
fn sorted_children(directory: &OSPath) -> [OSPath] StoreError! {
    paths: [OSPath] = []
    for entry in fs.read_dir(directory)? { paths.push(entry?.path()) }
    paths.sort_by(fn(left, right) { left.as_os_str().cmp(right.as_os_str()) })
    Ok(paths)
}

// Rust: crates/jet-store/src/lib.rs:2102
fn atomic_write(path: &OSPath, bytes: &[U8]) -> Unit StoreError! { replace_file(path, bytes, true) }
// Rust: crates/jet-store/src/lib.rs:2108
// Atomic replacement without disk syncs; a crash may lose the new file.
fn replace_unsynced(path: &OSPath, bytes: &[U8]) -> Unit StoreError! { replace_file(path, bytes, false) }

// Rust: crates/jet-store/src/lib.rs:2112
fn replace_file(path: &OSPath, bytes: &[U8], durable: Bool) -> Unit StoreError! {
    parent := path.parent().ok_or_else(fn() { StoreError.Config("store path has no parent: {path.display()}") })?
    ensure_dir(parent)?
    file_name := path.file_name().and_then(fn(name) { name.to_str() }).ok_or_else(fn() { StoreError.InvalidKey(path.display().to_string()) })?
    temporary := parent.join(".{file_name}.tmp-{id()}-{next_counter()}")
    // GATE #4494: exclusive creation, retained descriptor sync, native rename.
    result := (fn() -> Unit StoreError! {
        file := OpenOptions.new().write(true).create_new(true).open(&temporary)?
        file.write_all(bytes)?
        if durable { file.sync_all()? }
        drop(file)
        fs.rename(&temporary, path)?
        if durable { sync_dir(parent)? }
        Ok(())
    })()
    if result.is_err() { _ :: fs.remove_file(&temporary) }
    result
}

// Rust: crates/jet-store/src/lib.rs:2140
fn set_executable(path: &OSPath, executable: Bool) -> Unit StoreError! {
    // GATE #4494/#4500: selected-target native permissions.
    if selected_family() == "unix" {
        metadata := fs.metadata(path)?
        permissions := metadata.permissions()
        mode := permissions.mode()
        permissions.set_mode(if executable { mode | 0o111 } else { mode & !0o111 })
        fs.set_permissions(path, permissions)?
    }
    Ok(())
}

// Rust: crates/jet-store/src/lib.rs:2157
fn create_new_synced(path: &OSPath, bytes: &[U8]) -> Unit StoreError! {
    // GATE #4494: retained writable descriptor and durable sync.
    file := OpenOptions.new().write(true).create_new(true).open(path)?
    file.write_all(bytes)?; file.sync_all()?
    Ok(())
}

// Rust: crates/jet-store/src/lib.rs:2164
fn append_synced(path: &OSPath, bytes: &[U8]) -> Unit StoreError! {
    if fs.symlink_metadata(path) == Ok(metadata) {
        if metadata.file_type().is_symlink() || !metadata.is_file() {
            return Err(StoreError.Corrupt { path: path.to_path_buf(), reason: "journal is not a regular file" })
        }
    }
    file := OpenOptions.new().create(true).append(true).open(path)?
    file.write_all(bytes)?; file.sync_all()?
    sync_dir(path.parent().expect("journal path has parent"))?
    Ok(())
}

// Rust: crates/jet-store/src/lib.rs:2180
fn ensure_dir(path: &OSPath) -> Unit StoreError! {
    fs.symlink_metadata(path) == {
        Ok(metadata) -> {
            if metadata.file_type().is_symlink() { return Err(StoreError.Config("store directory is a symlink: {path.display()}")) }
            if metadata.is_dir() { return Ok(()) }
            Err(StoreError.Config("store path is not a directory: {path.display()}"))
        }
        Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound {
                fs.create_dir(path)?
                return sync_dir(path.parent().expect("created directory has parent"))
            }
            Err(StoreError.Io(error))
        }
    }
}

// Rust: crates/jet-store/src/lib.rs:2196
fn sync_dir(path: &OSPath) -> Unit StoreError! {
    // GATE #4494: real directory descriptor sync; preserve unsupported-platform arms.
    File.open(path).and_then(fn(file) { file.sync_all() }) == {
        Ok(_) -> Ok(())
        Err(error) -> {
            if error.kind() == io.ErrorKind.Unsupported || error.kind() == io.ErrorKind.InvalidInput { return Ok(()) }
            Err(StoreError.Io(error))
        }
    }
}

// Rust: crates/jet-store/src/lib.rs:2204
fn same_file(left: &Metadata, right: &Metadata) -> Bool {
    // GATE #4494/#4500: device/inode identity or native modified-time fallback.
    if selected_family() == "unix" {
        left.dev() == right.dev() && left.ino() == right.ino() && left.len() == right.len()
    } else { left.len() == right.len() && left.modified().ok() == right.modified().ok() }
}

// Rust: crates/jet-store/src/lib.rs:2216
fn validate_component(value: &String, label: &String) -> Unit StoreError! {
    if value.is_empty() || value == "." || value == ".." || value.len() > 128 {
        return Err(StoreError.InvalidKey("invalid {label} `{value}`"))
    }
    if !value.bytes().all(fn(byte) { byte.is_ascii_alphanumeric() || byte == 46 || byte == 95 || byte == 45 }) {
        return Err(StoreError.InvalidKey("invalid {label} `{value}`"))
    }
    Ok(())
}

// Rust: crates/jet-store/src/lib.rs:2229
fn parse_optional_size(name: &String) -> U64? StoreError! {
    env.var(name) == {
        Ok(value) -> parse_size(&value).map(fn(size) { Val(size) }).map_err(fn(error) {
            error == { StoreError.Config(message) -> StoreError.Config("{name}: {message}"); other -> other }
        })
        Err(env.VarError.NotPresent) -> Ok(None)
        Err(env.VarError.NotUnicode(_)) -> Err(StoreError.Config("{name} is not valid UTF-8"))
    }
}

// Rust: crates/jet-store/src/lib.rs:2241
pub fn parse_size(value: &String) -> U64 StoreError! {
    value := value.trim() // #4303
    if value.is_empty() { return Err(StoreError.Config("size cannot be empty")) }
    upper := value.to_ascii_uppercase()
    suffixes: [(String,U64)] = [
        ("TIB", 1024.pow(4)), ("TB", 1024.pow(4)), ("GIB", 1024.pow(3)), ("GB", 1024.pow(3)),
        ("MIB", 1024.pow(2)), ("MB", 1024.pow(2)), ("KIB", 1024), ("KB", 1024),
        ("T", 1024.pow(4)), ("G", 1024.pow(3)), ("M", 1024.pow(2)), ("K", 1024), ("B", 1)
    ]
    (number, multiplier) := suffixes.iter().find_map(fn(entry) {
        upper.strip_suffix(entry.0).map(fn(number) { (number, entry.1) })
    }).unwrap_or((upper.as_str(), 1))
    trimmed := number.trim() // #4303
    number := trimmed.parse::<U64>().map_err(fn(_) { StoreError.Config("invalid byte size `{value}`") })?
    number.checked_mul(multiplier).ok_or_else(fn() { StoreError.Config("byte size `{value}` is too large") })
}

// Rust: crates/jet-store/src/lib.rs:2275
fn default_store_root() -> OSPath StoreError! {
    home := env.var_os("HOME").or_else(fn() { env.var_os("USERPROFILE") })
        .ok_or_else(fn() { StoreError.Config("cannot determine home directory") })?
    Ok(OSPath.from(home).join(".cache").join("jet").join("store"))
}

// Rust: crates/jet-store/src/lib.rs:2282
fn hex_value(byte: U8) -> U8? {
    if byte >= 48 && byte <= 57 { return Val(byte - 48) }
    if byte >= 97 && byte <= 102 { return Val(byte - 97 + 10) }
    if byte >= 65 && byte <= 70 { return Val(byte - 65 + 10) }
    None
}
// Rust: crates/jet-store/src/lib.rs:2291
fn hex_digit(value: U8) -> Char {
    if value <= 9 { return (48 + value) as Char }
    if value <= 15 { return (97 + value - 10) as Char }
    panic("hex nibble is bounded")
}
// Rust: crates/jet-store/src/lib.rs:2299
fn next_counter() -> U64 {
    // GATE #4494: real process-static atomic fetch-add.
    FILE_COUNTER.fetch_add(1, Ordering.Relaxed)
}
// Rust: crates/jet-store/src/lib.rs:2306
const FALLBACK: OnceLock<String> = OnceLock.new() // GATE #4494: process-static once cell.
// Rust: crates/jet-store/src/lib.rs:2303
fn current_process_identity() -> ProcessIdentity {
    pid := id()
    start := process_start_token(pid).unwrap_or_else(fn() {
        FALLBACK.get_or_init(fn() {
            now := SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()
            "fallback-{pid}-{now}"
        }).clone()
    })
    ProcessIdentity.new(pid, start)
}
// Rust: crates/jet-store/src/lib.rs:2320
fn owner_liveness(owner: &ProcessIdentity) -> Bool? {
    current := current_process_identity()
    if owner.pid() == current.pid() { return Val(owner.start() == current.start()) }
    lookup_process_start(owner.pid()) == {
        IdentityLookup.Found(start) -> Val(start == owner.start())
        IdentityLookup.Missing -> Val(false)
        IdentityLookup.Unknown -> None
    }
}
// Rust: crates/jet-store/src/lib.rs:2332
enum IdentityLookup { Found(String), Missing, Unknown }
// Rust: crates/jet-store/src/lib.rs:2338
fn process_start_token(pid: U32) -> String? {
    lookup_process_start(pid) == { IdentityLookup.Found(start) -> Val(start); _ -> None }
}
// Rust: crates/jet-store/src/lib.rs:2345
fn lookup_process_start(pid: U32) -> IdentityLookup {
    // GATE #4494/#4500: selected target process identity via real /proc read.
    if selected_os() == "linux" {
        content := fs.read_to_string(OSPath.new("/proc/{pid}/stat")) == {
            Ok(value) -> value
            Err(error) -> {
                if error.kind() == io.ErrorKind.NotFound { return IdentityLookup.Missing }
                return IdentityLookup.Unknown
            }
        }
        close := content.rfind(") ") ?? return IdentityLookup.Unknown
        fields := content[close + 2..].split_whitespace().collect()
        start := fields.get(19) ?? return IdentityLookup.Unknown
        return IdentityLookup.Found(start.to_string())
    }
    IdentityLookup.Unknown
}
// Rust: crates/jet-store/src/lib.rs:2370
fn filesystem_stats(path: &OSPath) -> DiskStats? {
    // GATE #4494: real command execution and captured output, not simulated stats.
    output := Command.new("df").arg("-Pk").arg(path).env("LC_ALL", "C").output().ok() ?? return None
    if !output.status.success() { return None }
    output_text := String.from_utf8_lossy(&output.stdout)
    line := output_text.lines().filter(fn(line) { !line.trim().is_empty() }).last() ?? return None
    fields := line.split_whitespace().collect()
    if fields.len() < 5 { return None }
    total := (fields[1].parse::<U64>().ok() ?? return None).checked_mul(1024) ?? return None
    available := (fields[3].parse::<U64>().ok() ?? return None).checked_mul(1024) ?? return None
    Val(DiskStats { total_bytes: total, available_bytes: available })
}
