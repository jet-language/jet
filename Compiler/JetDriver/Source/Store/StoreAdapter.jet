    // Store.touch_after_read -> ArtifactStore.touch_after_read.
    // Rust: crates/jet-store/src/lib.rs:1433
    // Store.quarantine_locked -> ArtifactStore.quarantine_locked.
    // Rust: crates/jet-store/src/lib.rs:1459
    // Store.append_journal_locked -> ArtifactStore.append_journal_locked; delegate to the batch method at cutover.

    // Rust: crates/jet-store/src/lib.rs:1465
    fn append_journal_entries_locked(self, entries: [(String, ArtifactEntryKey, Int)]) -> ArtifactStoreError! {
        if entries.is_empty() -> return Ok(())
        journal_path :: files.join(self.root(), "journal")
        last_sequence :: if journal_tail_sequence(journal_path)? == {
            .Val(sequence) -> sequence
            .None -> {
                self.compact_journal_locked()?
                read_journal(journal_path)?.last_sequence
            }
        }
        lines := String.with_capacity(entries.len() * 192)
        loop (index, (operation, key, length)) in entries {
            sequence :: U64.from(last_sequence).saturating_add(U64.from(index + 1))
            prefix :: "jet.store.v1|{operation}|{key.kind_name()}|{key.wire_value()}|{length}|{sequence}|"
            &lines.push_str(prefix)
            &lines.push_str(sha256_hex(prefix.bytes()))
            &lines.push('\n')
        }
        store_artifact_append_synced(journal_path, lines.bytes())
    }

