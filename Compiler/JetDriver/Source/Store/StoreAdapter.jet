    // Rust: crates/jet-store/src/lib.rs:877
    pub fn get_action_untouched(self, action: ActionHandle) -> [U8]? ArtifactStoreError! {
        key :: ArtifactEntryKey.Action(action.key())
        path :: self.action_path(action)
        if store_artifact_read_file(path)? == {
            .Missing -> Ok(None)
            .Corrupt(reason) -> {
                self.quarantine_after_read(key, path, reason)
                Ok(None)
            }
            .Bytes(bytes) -> {
                if store_artifact_decode_action(action, bytes) == {
                    .Ok(record) -> Ok(Val(record))
                    .Err(error) -> {
                        if store_artifact_is_unsupported_version(bytes) -> return Ok(None)
                        self.quarantine_after_read(key, path, error.reason)
                        Ok(None)
                    }
                }
            }
        }
    }

    // Rust: crates/jet-store/src/lib.rs:899
    pub fn touch_actions(self, actions: [ActionHandle]) -> {
        if actions.is_empty() -> return
        lock :: self.acquire_lock() ?? return
        defer close(^lock)
        lines := [(String, ArtifactEntryKey, Int)]{}
        loop action in actions {
            metadata :: fs.metadata(self.action_path(action)) ?? next // GATE #4494 retained file metadata.
            &lines.push(("touch", ArtifactEntryKey.Action(action.key()), metadata.len()))
        }
        self.append_journal_entries_locked(lines).drop("a failed journal touch only costs eviction order")
    }

    // Rust: crates/jet-store/src/lib.rs:923
    pub fn publish_actions(self, records: [(ActionHandle, [U8])]) -> ArtifactStoreError! {
        self.publish_action_batch(records, true)
    }

    // Rust: crates/jet-store/src/lib.rs:932
    pub fn publish_cache_actions(self, records: [(ActionHandle, [U8])]) -> ArtifactStoreError! {
        self.publish_action_batch(records, false)
    }

    // Rust: crates/jet-store/src/lib.rs:936
    fn publish_action_batch(self, records: [(ActionHandle, [U8])], durable: Bool) -> ArtifactStoreError! {
        if records.is_empty() -> return Ok(())
        self.ensure_layout()?
        lock :: self.acquire_lock()?
        defer close(^lock)
        journal := [(String, ArtifactEntryKey, Int)]{}
        pending := [(String, ArtifactEntryKey, [U8])]{}
        loop (action, record) in records {
            path :: self.action_path(action)
            key :: ArtifactEntryKey.Action(action.key())
            if store_artifact_read_file(path)? == {
                .Missing -> {}
                .Corrupt(reason) -> self.quarantine_locked(key, path, reason)?
                .Bytes(existing) -> {
                    if store_artifact_decode_action(action, existing) == {
                        .Ok(value) -> {
                            if value == record -> &journal.push(("touch", key, existing.len()))
                            next
                        }
                        .Err(error) -> self.quarantine_locked(key, path, error.reason)?
                    }
                }
            }
            &pending.push((path, key, store_artifact_encode_action(action, record)))
        }
        if !pending.is_empty() {
            incoming := 0
            loop (_, _, encoded) in pending -> incoming += encoded.len()
            self.ensure_capacity_locked(incoming, pending[0].0)?
        }
        loop (path, key, encoded) in pending {
            if durable { store_artifact_atomic_write(path, encoded)? }
            else { replace_unsynced(path, encoded)? } // GATE #4494: real unsynced atomic replacement.
            &journal.push(("put", key, encoded.len()))
        }
        self.append_journal_entries_locked(journal)
    }

