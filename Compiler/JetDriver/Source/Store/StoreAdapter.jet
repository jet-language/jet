    pub fn last_build_record(self, workspace_root: OSPath, program: String) -> BuildRecord? ArtifactStoreError! {
        if project_state.last_run(workspace_root, program) == {
            .Val(key) -> self.build_record(key)
            .None -> Ok(None)
        }
    }
