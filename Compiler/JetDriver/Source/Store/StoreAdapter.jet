//RS                 },
//RS             }
//RS             pending.push((path, key, encode_action(*action, record)));
//RS         }
//RS         if let Some((path, ..)) = pending.first() {
//RS             let incoming = pending
//RS                 .iter()
//RS                 .map(|(_, _, encoded)| encoded.len() as u64)
//RS                 .sum::<u64>();
//RS             self.ensure_capacity_locked(incoming, path)?;
