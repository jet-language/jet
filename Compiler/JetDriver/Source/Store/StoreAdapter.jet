    // Rust: crates/jet-store/src/lib.rs:1126
    pub fn publish_bytes(self, key: String, bytes: [U8], executable: Bool) -> StoredArtifact ArtifactStoreError! {
        action :: store_artifact_action_for_key(key)?
        object :: ObjectHandle.from_bytes(bytes)
        path :: self.object_path(object)
        self.publish_data(ArtifactEntryKey.Blob(object.key()), path, bytes)?
        self.publish_action(action, store_artifact_encode_record(object, executable))?
        Ok(StoredArtifact{action, object, path, executable})
    }

