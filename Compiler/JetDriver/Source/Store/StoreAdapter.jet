//RS     /// Publish many action records under one lock, one capacity check and
//RS     /// one journal write. A key that already holds different bytes is left
//RS     /// as it is (the `Conflict` of `publish_action`); the others still land.
//RS     pub fn publish_actions(&self, records: &[(ActionHandle, Vec<u8>)]) -> Result<(), StoreError> {
//RS         self.publish_action_batch(records, true)
//RS     }
//RS 
//RS     /// `publish_actions` for records that only cache recomputable results,
//RS     /// such as compiled functions: each record is written without its own
//RS     /// disk syncs, which would dominate a batch of thousands of small
//RS     /// records. A read verifies every record against its digest, so a record
//RS     /// a crash lost or tore reads as missing and its result is recomputed.
//RS     pub fn publish_cache_actions(&self, records: &[(ActionHandle, Vec<u8>)]) -> Result<(), StoreError> {
//RS         self.publish_action_batch(records, false)
//RS     }
