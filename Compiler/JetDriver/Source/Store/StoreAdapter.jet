    pub fn publish_last_build_record(self, workspace_root: OSPath, key: String, record: BuildRecord) -> ObjectHandle ArtifactStoreError! {
        object :: self.publish_build_record(key, record)?
        project_state.write_last_run(workspace_root, record.program, key)?
        Ok(object)
    }

