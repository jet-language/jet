// Streaming Chrome trace events: one flushed event per line, no work when disabled.
use std.fs.File
use std.[env, process, thread, fs]
use std.sync.[Mutex, MutexGuard, OnceLock]
use std.sync.atomic.[AtomicU64, Ordering]
use std.thread_local.ThreadLocal
use std.time.[Duration, Instant, SystemTime, UNIX_EPOCH]
use core.path.OSPath
use jet_foundation.Trace.CompilerTraceSink

// Rust: crates/jet-driver/src/Trace.rs:30
pub const TRACE_FILE_ENV: String = "JET_TRACE_FILE"
// Rust: crates/jet-driver/src/Trace.rs:32
pub const TRACE_DETAIL_ENV: String = "JET_TRACE_DETAIL"
// Rust: crates/jet-driver/src/Trace.rs:36
const PROGRESS_INTERVAL: Duration = Duration.from_millis(200)
// Rust: crates/jet-driver/src/Trace.rs:38
// GATE #4494: synchronized process sink, relaxed unique thread ids and native TLS.
const SINK: OnceLock<TraceSink?> = OnceLock.new()
// Rust: crates/jet-driver/src/Trace.rs:39
const NEXT_THREAD: AtomicU64 = AtomicU64.new(1)
// Rust: crates/jet-driver/src/Trace.rs:41
const THREAD: ThreadLocal<U64> = ThreadLocal.new(fn() { NEXT_THREAD.fetch_add(1, Ordering.Relaxed) })

// Rust: crates/jet-driver/src/Trace.rs:46
pub fn sink() -> TraceSink? { SINK.get_or_init(TraceSink.from_env).as_ref() }
// Rust: crates/jet-driver/src/Trace.rs:51
pub fn span(kind: String) -> Span {
    active :: sink()
    if active == Val(value) { value.begin(kind, "", -1, -1) }
    Span { sink: active, kind: kind, items: -1 }
}
// Rust: crates/jet-driver/src/Trace.rs:61
pub struct Span { sink: TraceSink?, kind: String, items: I64 }
impl Span {
    // Rust: crates/jet-driver/src/Trace.rs:69
    pub fn items(self: &Self, items: USize) { self.items = I64.try_from(items).unwrap_or(I64.MAX) }
    // Rust: crates/jet-driver/src/Trace.rs:75
    fn drop(self: &Self) { if self.sink == Val(value) { value.end(self.kind, self.items) } }
}
// Rust: crates/jet-driver/src/Trace.rs:82
pub struct TraceSink { start: Instant, pid: U32, functions: Bool, state: Mutex<TraceState> }
// Rust: crates/jet-driver/src/Trace.rs:89
struct TraceState {
    // Failed writes disable tracing, never the compilation.
    file: File?, stacks: [U64:[OpenSpan]], progress_at: [String:Instant], line: String
}
// Rust: crates/jet-driver/src/Trace.rs:99
struct OpenSpan { kind: String, label: String }
impl TraceSink {
    // Rust: crates/jet-driver/src/Trace.rs:105
    fn from_env() -> Self? {
        path :: env.var_os(TRACE_FILE_ENV).filter(fn(path) { !path.is_empty() }) ?? return None
        functions :: env.var(TRACE_DETAIL_ENV).is_ok_and(fn(detail) { detail == "functions" })
        if Self.create(OSPath.new(path), functions) == {
            Ok(value) -> Val(value)
            Err(error) -> {
                eprintln("jet: {TRACE_FILE_ENV}: cannot write `{OSPath.new(path).display()}`: {error}")
                None
            }
        }
    }
    // Rust: crates/jet-driver/src/Trace.rs:121
    // GATE #4494: real file/time/process providers own these native operations.
    fn create(path: &OSPath, functions: Bool) -> Self std.io.Error! {
        file := File.create(path)!
        pid :: process.id()
        process_name :: env.current_exe().ok().and_then(fn(exe) { exe.file_name().map(fn(name) { name.to_string_lossy().into_owned() }) }).unwrap_or("jet")
        unix_ms :: SystemTime.now().duration_since(UNIX_EPOCH).map_or(0, fn(since) { since.as_millis() })
        header := String.from("[\n")
        header.push_str("{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":")
        header.push_str("{pid},\"tid\":0,\"args\":{{\"name\":")
        push_json_string(&header, process_name)
        header.push_str("}}}},\n{{\"name\":\"trace.start\",\"ph\":\"i\",\"s\":\"g\",\"ts\":0,\"pid\":{pid},\"tid\":0,\"args\":{{\"unix_ms\":{unix_ms},\"functions\":{functions}}}}},\n")
        file.write_all(header.as_bytes())!
        file.flush()!
        Self { start: Instant.now(), pid: pid, functions: functions,
            state: Mutex.new(TraceState { file: Val(^file), stacks: [:], progress_at: [:], line: String.new() }) }
    }
    // Rust: crates/jet-driver/src/Trace.rs:155
    pub fn functions(self: &Self) -> Bool { self.functions }
    // Rust: crates/jet-driver/src/Trace.rs:161
    pub fn begin(self: &Self, kind: String, detail: String, index: I64, total: I64) {
        ts :: self.micros()
        thread_id :: current_thread()
        guard := self.lock()
        state :: &guard
        if state.file.is_none() { return }
        label :: if detail.is_empty() { kind } else { detail }
        state.line.clear()
        if !state.stacks.contains_key(thread_id) { push_thread_name(&state.line, self.pid, thread_id) }
        push_event_head(&state.line, label, Val(kind), 'B', ts, self.pid, thread_id)
        if index >= 0 { state.line.push_str(",\"args\":{{\"index\":{index},\"total\":{total}}}") }
        state.line.push_str("},\n")
        state.stacks.entry(thread_id).or_default().push(OpenSpan { kind: kind, label: label })
        state.write_line()
    }
    // Rust: crates/jet-driver/src/Trace.rs:188
    pub fn end(self: &Self, kind: String, items: I64) {
        memory :: memory_kb()
        ts :: self.micros()
        thread_id :: current_thread()
        guard := self.lock()
        state :: &guard
        if state.file.is_none() { return }
        stack :: state.stacks.get_mut(thread_id) ?? return
        position :: stack.iter().rposition(fn(span) { span.kind == kind }) ?? return
        state.line.clear()
        while stack.len() > position + 1 {
            abandoned :: stack.pop().expect("open span above the closed one")
            push_event_head(&state.line, abandoned.label, Val(abandoned.kind), 'E', ts, self.pid, thread_id)
            state.line.push_str("},\n")
        }
        closed :: stack.pop().expect("closed span")
        push_event_head(&state.line, closed.label, Val(closed.kind), 'E', ts, self.pid, thread_id)
        state.line.push_str(",\"args\":{")
        separator := ""
        if items >= 0 { state.line.push_str("\"items\":{items}"); separator = "," }
        if memory == Val((rss, peak)) { state.line.push_str("{separator}\"rss_kb\":{rss},\"peak_rss_kb\":{peak}") }
        state.line.push_str("}},\n")
        if closed.label == closed.kind {
            if memory == Val((rss, peak)) {
                push_event_head(&state.line, "memory", None, 'C', ts, self.pid, thread_id)
                state.line.push_str(",\"args\":{{\"rss_mb\":{rss / 1024},\"peak_rss_mb\":{peak / 1024}}}}},\n")
            }
        }
        state.write_line()
    }
    // Rust: crates/jet-driver/src/Trace.rs:234
    pub fn progress(self: &Self, kind: String, done: I64, total: I64) {
        now :: Instant.now()
        thread_id :: current_thread()
        guard := self.lock()
        state :: &guard
        if state.file.is_none() { return }
        last_item :: total > 0 && done + 1 >= total
        if state.progress_at.get_mut(kind) == Val(previous) {
            if !last_item && now.duration_since(previous) < PROGRESS_INTERVAL { return }
            previous = now
        } else { state.progress_at.insert(kind, now) }
        ts :: U64.try_from(now.saturating_duration_since(self.start).as_micros()).unwrap_or(U64.MAX)
        state.line.clear()
        push_event_head(&state.line, kind, None, 'C', ts, self.pid, thread_id)
        state.line.push_str(",\"args\":{{\"done\":{done},\"total\":{total}}}}},\n")
        state.write_line()
    }
    // Rust: crates/jet-driver/src/Trace.rs:258
    fn micros(self: &Self) -> U64 { U64.try_from(self.start.elapsed().as_micros()).unwrap_or(U64.MAX) }
    // Rust: crates/jet-driver/src/Trace.rs:262
    fn lock(self: &Self) -> MutexGuard<TraceState> { self.state.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() }) }
}
impl TraceState {
    // Rust: crates/jet-driver/src/Trace.rs:269
    fn write_line(self: &Self) {
        file :: self.file.as_mut() ?? return
        if file.write_all(self.line.as_bytes()).and_then(fn() { file.flush() }) == Err(error) {
            eprintln("jet: {TRACE_FILE_ENV}: write failed, trace stopped: {error}")
            self.file = None
        }
    }
}
// Rust: crates/jet-driver/src/Trace.rs:278
fn current_thread() -> U64 { THREAD.with(fn(value) { value }) }
// Rust: crates/jet-driver/src/Trace.rs:282
fn push_thread_name(line: &String, pid: U32, thread_id: U64) {
    current :: thread.current()
    name :: current.name().map_or_else(fn() { "thread {thread_id}" }, fn(name) { name.to_string() })
    line.push_str("{{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":{pid},\"tid\":{thread_id},\"args\":{{\"name\":")
    push_json_string(line, name)
    line.push_str("}},\n")
}
// Rust: crates/jet-driver/src/Trace.rs:292
fn push_event_head(line: &String, name: String, kind: String?, phase: Char, ts: U64, pid: U32, thread_id: U64) {
    line.push_str("{\"name\":")
    push_json_string(line, name)
    if kind == Val(category) { line.push_str(",\"cat\":"); push_json_string(line, category) }
    line.push_str(",\"ph\":\"{phase}\",\"ts\":{ts},\"pid\":{pid},\"tid\":{thread_id}")
}
// Rust: crates/jet-driver/src/Trace.rs:302
fn push_json_string(line: &String, text: String) {
    line.push('"')
    for character in text.chars() {
        if character == {
            '"' -> line.push_str("\\\"")
            '\\' -> line.push_str("\\\\")
            '\n' -> line.push_str("\\n")
            '\r' -> line.push_str("\\r")
            '\t' -> line.push_str("\\t")
            control if (control as U32) < 0x20 -> line.push_str("\\u{control as U32:04x}")
            other -> line.push(other)
        }
    }
    line.push('"')
}
// Rust: crates/jet-driver/src/Trace.rs:322
fn memory_kb() -> (U64,U64)? {
    status :: fs.read_to_string(OSPath.new("/proc/self/status")).ok() ?? return None
    field :: fn(name: String) -> U64? {
        rest :: status.lines().find_map(fn(line) { line.strip_prefix(name) }) ?? return None
        trimmed := rest.trim() // #4303
        value :: trimmed.strip_suffix("kB") ?? return None
        number := value.trim() // #4303
        number.parse::<U64>().ok()
    }
    rss :: field("VmRSS:") ?? return None
    peak :: field("VmHWM:") ?? return None
    Val((rss, peak))
}
