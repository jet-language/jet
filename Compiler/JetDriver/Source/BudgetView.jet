// Read-only projections over the one canonical performance budget engine.
use jet_foundation.PerformanceBudget.[verify_budget_report, CanonicalJson]
use jet_foundation.Report.[StatusFields, StatusValue]
use std.fs

// Rust: crates/jet-driver/src/BudgetView.rs:13
#Derive(Clone, Debug, Eq)
pub struct BudgetFact {
    pub report_id: String
    pub evidence_id: String
    pub budget_id: String
    pub evidence: String
    pub outcome: String
    pub enforcement: String
    pub statistical: Bool
}
// Rust: crates/jet-driver/src/BudgetView.rs:24
#Derive(Clone, Debug, Default, Eq)
pub struct BudgetProjection { pub facts: [BudgetFact], pub rejected: [String] }
impl BudgetProjection {
    // Rust: crates/jet-driver/src/BudgetView.rs:33
    pub fn to_json(self: &Self) -> String {
        facts := self.facts.iter().map(fn(fact) {
            "{{\"budget_id\":{json(&fact.budget_id)},\"enforcement\":{json(&fact.enforcement)},\"evidence\":{json(&fact.evidence)},\"evidence_id\":{json(&fact.evidence_id)},\"outcome\":{json(&fact.outcome)},\"report_id\":{json(&fact.report_id)},\"statistical\":{fact.statistical}}}"
        }).collect().join(",")
        rejected := self.rejected.iter().map(fn(reason) { json(reason) }).collect().join(",")
        "{{\"mode\":\"read_only\",\"rejected\":[{rejected}],\"reports\":[{facts}]}}"
    }
    // Rust: crates/jet-driver/src/BudgetView.rs:49
    pub fn to_status_value(self: &Self) -> StatusValue {
        reports := StatusValue.array(self.facts.iter().map(fn(fact) {
            StatusValue.object(StatusFields.new().with("budget_id", fact.budget_id.as_str()).with("enforcement", fact.enforcement.as_str())
                .with("evidence", fact.evidence.as_str()).with("evidence_id", fact.evidence_id.as_str()).with("outcome", fact.outcome.as_str())
                .with("report_id", fact.report_id.as_str()).with("statistical", fact.statistical))
        }))
        StatusValue.object(StatusFields.new().with("mode", "read_only")
            .with("rejected", StatusValue.array(self.rejected.iter().map(fn(reason) { StatusValue.from(reason.as_str()) }))).with("reports", reports))
    }
    // Rust: crates/jet-driver/src/BudgetView.rs:74
    pub fn render_text(self: &Self) -> String {
        out := "Performance budgets (read-only)\n"
        if self.facts.is_empty() { out.push_str("  no compatible canonical report\n") }
        for fact in &self.facts {
            report_id := &fact.report_id[..12]; evidence_id := &fact.evidence_id[..12]
            out.push_str("  {fact.budget_id}  {fact.outcome} ({fact.evidence})  report {report_id}  evidence {evidence_id}\n")
        }
        for reason in &self.rejected { out.push_str("  rejected: {reason}\n") }
        out
    }
}
// Rust: crates/jet-driver/src/BudgetView.rs:98
pub fn read_compatible(root: &OSPath, sources: &[(String,String)]) -> BudgetProjection {
    dir := root.join(".jet/perf/reports")
    // GATE #4494: actual native directory listing, symlink metadata, and file reads.
    entries := fs.read_dir(&dir) == { Ok(entries) -> entries; Err(_) -> { return BudgetProjection.default() } }
    wanted: [String:String] = sources.iter().map(fn(entry) { (normalize(&entry.0), entry.1) }).collect()
    paths := entries.filter_map(fn(result) { result.ok() }).map(fn(entry) { entry.path() })
        .filter(fn(path) { path.extension().and_then(fn(ext) { ext.to_str() }) == Val("json") }).collect()
    paths.sort()
    by_budget: [String:BudgetFact] = [:]; rejected: [String] = []
    for path in paths {
        label := path.file_name().and_then(fn(name) { name.to_str() }).unwrap_or("report").to_string()
        metadata := fs.symlink_metadata(&path) == {
            Ok(metadata) -> metadata
            Err(error) -> { rejected.push("{label}: unreadable: {error}"); continue }
        }
        if metadata.file_type().is_symlink() || !metadata.is_file() { rejected.push("{label}: not a regular no-follow report"); continue }
        if metadata.len() > 16 * 1024 * 1024 { rejected.push("{label}: report exceeds 16 MiB projection limit"); continue }
        bytes := fs.read(&path) == { Ok(bytes) -> bytes; Err(error) -> { rejected.push("{label}: unreadable: {error}"); continue } }
        report := verify_budget_report(&bytes) == { Ok(report) -> report; Err(error) -> { rejected.push("{label}: {error}"); continue } }
        (report_id, evidence_id, members, measurements) := report_parts(&report) == {
            Ok(parts) -> parts
            Err(_) -> { rejected.push("{label}: report projection fields are invalid"); continue }
        }
        if members.is_empty() || !members.iter().all(fn(entry) { wanted.get(&normalize(&entry.0)).is_some_and(fn(wanted) { wanted == entry.1 }) }) { continue }
        for measurement in measurements {
            fact := measurement_fact(&report_id, &evidence_id, measurement) == {
                Ok(fact) -> fact
                Err(_) -> { rejected.push("{label}: measurement projection fields are invalid"); continue }
            }
            by_budget.insert(fact.budget_id.clone(), fact)
        }
    }
    keys := by_budget.keys().cloned().collect(); keys.sort()
    facts := keys.into_iter().map(fn(key) { by_budget.remove(&key).unwrap() }).collect()
    BudgetProjection { facts: facts, rejected: rejected }
}
// Rust: crates/jet-driver/src/BudgetView.rs:179
fn report_parts(value: &CanonicalJson) -> (String, String, [(String,String)], &[CanonicalJson]) Unit! {
    report := object(value)?; report_id := text(report.get("report_id"))?.to_string()
    content := object(report.get("content").ok_or(())?)?; evidence_id := text(content.get("evidence_id"))?.to_string()
    subject := object(content.get("subject").ok_or(())?)?
    members: [(String,String)] = []
    for value in array(subject.get("member_sources"))? {
        member := object(value)?
        members.push((text(member.get("path"))?.to_string(), text(member.get("sha256"))?.to_string()))
    }
    Ok((report_id, evidence_id, members, array(content.get("measurements"))?))
}
// Rust: crates/jet-driver/src/BudgetView.rs:205
fn measurement_fact(report_id: &String, evidence_id: &String, value: &CanonicalJson) -> BudgetFact Unit! {
    measurement := object(value)?; decision := object(measurement.get("decision").ok_or(())?)?; comparison := object(measurement.get("comparison").ok_or(())?)?
    Ok(BudgetFact { report_id: report_id.to_string(), evidence_id: evidence_id.to_string(), budget_id: text(measurement.get("budget_id"))?.to_string(),
        evidence: text(decision.get("evidence"))?.to_string(), outcome: text(decision.get("policy_outcome"))?.to_string(), enforcement: text(measurement.get("enforcement"))?.to_string(),
        statistical: text(comparison.get("kind"))? != "absolute" })
}
// Rust: crates/jet-driver/src/BudgetView.rs:224
fn object(value: &CanonicalJson) -> &[String:CanonicalJson] Unit! { value == { Object(value) -> Ok(value); _ -> Err(()) } }
// Rust: crates/jet-driver/src/BudgetView.rs:231
fn array(value: CanonicalJson?) -> &[CanonicalJson] Unit! { value == { Val(CanonicalJson.Array(value)) -> Ok(value); _ -> Err(()) } }
// Rust: crates/jet-driver/src/BudgetView.rs:238
fn text(value: CanonicalJson?) -> &String Unit! { value == { Val(CanonicalJson.String(value)) -> Ok(value); _ -> Err(()) } }
// Rust: crates/jet-driver/src/BudgetView.rs:245
fn normalize(path: &String) -> String { view := path.trim_start_matches("./") // #4303
    view.replace('\\', "/")
}
// Rust: crates/jet-driver/src/BudgetView.rs:248
fn json(value: &String) -> String {
    escaped := value.replace('\\', "\\\\").replace('"', "\\\"").replace('\n', "\\n").replace('\r', "\\r").replace('\t', "\\t")
    "\"{escaped}\""
}
