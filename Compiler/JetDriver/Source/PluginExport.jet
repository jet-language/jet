// Driver sandbox export validation and ApiFreeze version handshake.
use jet_foundation.[Diagnostic, AST, Sema]
use jet_foundation.AST.[Item, ProgramBundle]
use jet_sema.Sema.ApiFreeze
use jet_driver.Loader
use jet_pkg_model.Package

// Rust: crates/jet-driver/src/PluginExport.rs:26
pub fn resolve_export_name(bundle: &ProgramBundle) -> String {
    if Loader.package_facts_for_bundle(bundle) == Ok(Val(facts)) {
        for pkg in facts.packages {
            for target in pkg.targets {
                if target == .Plugin(export) { return export.unwrap_or_else(fn() { pkg.name }) }
            }
        }
        return facts.name
    }
    bundle.modules[bundle.entry].path.file_stem().and_then(fn(stem) { stem.to_str() }).unwrap_or("plugin").to_string()
}
// Rust: crates/jet-driver/src/PluginExport.rs:47
fn resolve_version(bundle: &ProgramBundle) -> String {
    Loader.package_facts_for_bundle(bundle).ok().flatten().and_then(fn(facts) { facts.version }).unwrap_or("0.0.0")
}
// Rust: crates/jet-driver/src/PluginExport.rs:57
fn e1260(detail: String) -> Diagnostic {
    Diagnostic.error("E1260", "a sandbox's exported function has an unsupported signature", detail,
        "every parameter and the return type must use one scalar type, or a recursively closed `#Codable` Component Model shape — narrow the signature, or drop `pub` if this function isn't meant to be called across the sandbox boundary", None)
}
// Rust: crates/jet-driver/src/PluginExport.rs:67
fn component_signature(bundle: &ProgramBundle, guest: &Sema.GuestFunction) -> Bool {
    guest.return_type.is_some_and(fn(ty) { Sema.sandbox_component_type(bundle, ty) }) &&
        guest.params.iter().all(fn(param) { Sema.sandbox_component_type(bundle, param.1) })
}
// Rust: crates/jet-driver/src/PluginExport.rs:81
pub fn validate_export_surface(bundle: &ProgramBundle) -> [Diagnostic] {
    diags := [Diagnostic]{}
    for item in bundle.modules[bundle.entry].items {
        if item == .Func(f) {
            if Sema.sandbox_export_signature(f) == Val(guest) {
                if guest.scalar.is_none() && !component_signature(bundle, guest) {
                    diags.push(e1260("`pub fn {f.name}` has neither one homogeneous scalar shape nor a recursively closed `#Codable` Component Model shape"))
                }
            }
        }
    }
    diags
}
// Rust: crates/jet-driver/src/PluginExport.rs:101
fn e1257(delta: String) -> Diagnostic {
    Diagnostic.error("E1257", "this sandbox's exported interface changed incompatibly",
        "a sandbox's frozen exported interface is the load-time contract (D-PLUGIN-VERSION1) — {delta}",
        "restore the removed/changed export, or accept this as an intentional breaking change (delete the stale snapshot under `.jet/cache/api/` to re-freeze)", None)
}
// Rust: crates/jet-driver/src/PluginExport.rs:116
fn snapshot_package_key(export_name: String) -> String { "plugin__{export_name}" }
// Rust: crates/jet-driver/src/PluginExport.rs:127
pub fn check_and_freeze_version(bundle: &ProgramBundle, export_name: String) -> Void [Diagnostic]! {
    package :: snapshot_package_key(export_name)
    version :: resolve_version(bundle)
    funcs := [ApiFreeze.FrozenFn]{}
    for item in bundle.modules[bundle.entry].items {
        if item == .Func(f) {
            if Sema.sandbox_export_signature(f) == Val(guest) {
                if guest.scalar.is_none() && !component_signature(bundle, guest) { continue }
                funcs.push(ApiFreeze.FrozenFn { name: f.name, signature: ApiFreeze.fn_signature(f) })
            }
        }
    }
    funcs.sort()
    current :: ApiFreeze.ApiSnapshot { api_version: ApiFreeze.API_SNAPSHOT_VERSION,
        package: package, published_version: version, funcs: ^funcs }
    if ApiFreeze.load_snapshot(bundle.project_root, package) == Val(prior) {
        deltas := [String]{}
        for old_fn in prior.funcs {
            if current.funcs.iter().find(fn(f) { f.name == old_fn.name }) == {
                None -> deltas.push("export `{old_fn.name}` was removed")
                Val(new_fn) -> {
                    if new_fn.signature != old_fn.signature {
                        deltas.push("export `{old_fn.name}` changed from `{old_fn.signature}` to `{new_fn.signature}`")
                    }
                }
            }
        }
        if !deltas.is_empty() -> fail deltas.iter().map(fn(delta) { e1257(delta) }).collect()
    }
    // Persistence failure is intentionally discarded by the original handshake.
    _ :: ApiFreeze.save_snapshot(bundle.project_root, current)
}
