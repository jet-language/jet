// Consumers import lower seams directly from their canonical owners; no root reexports.
use jet_codegen.[development_receipt, program_allocator, scheduler, Codegen, TargetMachine]
use jet_comptime.Comptime
use jet_sema.CoreSources
use jet_sema.Sema
use jet_foundation.[CanonicalAST, Collections, Diagnostics, Generics, Lexer, Parser, Syntax, Traits, AST, SHA256, CompilerStack]

// Rust: crates/jet-driver/src/lib.rs:15
pub fn boot_mir_eval() { Codegen.MIREval.install_mir_bridge() }

// Rust: crates/jet-driver/src/lib.rs:40
// GATE #4494: canonical compiler worker owns stack/thread/TLS/unwind primitives.
// Reentrant work reuses the active worker; hooks cross the thread boundary explicitly.
pub fn run_compiler_work<R: Send>(work: fn() -> R) -> R {
    if CompilerStack.on_compiler_worker() { return work() }
    (ambient_core_call, ambient_handle, ambient_extern_call) :: Comptime.ambient_hooks()
    terminator_driver :: Lexer.terminator_driver()
    CompilerStack.run_on_compiler_stack(fn() {
        boot_mir_eval()
        Lexer.with_terminator_driver(terminator_driver, fn() {
            Comptime.with_ambient(ambient_core_call, ambient_handle, ambient_extern_call, ^work)
        })
    })
}

