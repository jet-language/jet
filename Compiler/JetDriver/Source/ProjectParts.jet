// One parsed project-part index for explicit imports and tooling.
use jet_foundation.[Diagnostic, Span, Lexer, Parser, Syntax]
use jet_foundation.AST.[ImportKind, Item]
use jet_pkg_model.Authority.[AuthorityError, AuthorityResolver]
use jet_pkg_model.Package
use core.path.OSPath
use std.collections.BTreeSet

// Rust: crates/jet-driver/src/ProjectParts.rs:12
pub enum ProjectPartState { Automatic, Explicit, Skipped }
impl ProjectPartState {
    // Rust: crates/jet-driver/src/ProjectParts.rs:19
    pub fn name(self: Self) -> String {
        if self == { .Automatic -> "automatic" .Explicit -> "explicit" .Skipped -> "skipped" }
    }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:29
pub struct ProjectPart { pub name: String, pub path: OSPath, pub state: ProjectPartState }
impl ProjectPart {
    // Rust: crates/jet-driver/src/ProjectParts.rs:38
    pub fn canonical_name(self: &Self) -> String { "{Syntax.PROJECT_IMPORT_PREFIX}{self.name}" }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:44
pub struct ProjectPartConflict { pub name: String, pub paths: [OSPath] }
impl ProjectPartConflict {
    // Rust: crates/jet-driver/src/ProjectParts.rs:50
    pub fn canonical_name(self: &Self) -> String { "{Syntax.PROJECT_IMPORT_PREFIX}{self.name}" }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:56
pub struct ProjectPartScanFailure { pub path: OSPath, pub module_names: [String], pub problem: Diagnostic, pub authority: Bool }
impl ProjectPartScanFailure {
    // Rust: crates/jet-driver/src/ProjectParts.rs:64
    pub fn diagnostic(self: &Self, name: String, root: &OSPath, span: Span) -> Diagnostic {
        path :: self.path.strip_prefix(root).unwrap_or(self.path).to_string_lossy().replace('\\', "/")
        Diagnostic.error("E0603", "can't load project module `{Syntax.PROJECT_IMPORT_PREFIX}{name}` from `{path}`",
            "`{path}` has a source error: {self.problem.what}",
            "fix `{path}` first, then import `{Syntax.PROJECT_IMPORT_PREFIX}{name}` again", Val(span))
    }
}
impl ProjectPartConflict {
    // Rust: crates/jet-driver/src/ProjectParts.rs:90
    pub fn diagnostic(self: &Self, root: &OSPath, span: Span?) -> Diagnostic {
        paths :: self.paths.iter().map(fn(path) { path.strip_prefix(root).unwrap_or(path).to_string_lossy().replace('\\', "/") }).collect::<[String]>().join(", ")
        Diagnostic.error("E0606", "project module `{self.canonical_name()}` is declared more than once",
            "a project module name must resolve to one declaration", "keep one `module {self.name}` declaration; found {paths}", span)
    }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:116
pub struct ProjectPartsReport {
    pub parts: [ProjectPart] = [], pub conflicts: [ProjectPartConflict] = [], pub source_files: [OSPath] = []
}
impl ProjectPartsReport {
    // Rust: crates/jet-driver/src/ProjectParts.rs:126
    pub fn named(self: &Self, name: String) -> [&ProjectPart] {
        self.parts.iter().filter(fn(part) { part.name == name }).collect()
    }
    // Rust: crates/jet-driver/src/ProjectParts.rs:133
    pub fn should_index(self: &Self, path: &OSPath) -> Bool {
        matching :: self.parts.iter().filter(fn(part) { part.path == path }).collect::<[&ProjectPart]>()
        matching.is_empty() || matching.iter().any(fn(part) { part.state != .Skipped })
    }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:142
pub fn scan(root: &OSPath) -> ProjectPartsReport { scan_with_diagnostics(root, []).0 }
// Rust: crates/jet-driver/src/ProjectParts.rs:146
pub fn scan_with_overlays(root: &OSPath, overlays: &[(OSPath,String)]) -> ProjectPartsReport { scan_with_diagnostics(root, overlays).0 }
// Rust: crates/jet-driver/src/ProjectParts.rs:158
pub fn source_files(root: &OSPath) -> [OSPath] {
    resolver :: AuthorityResolver.open(root).ok() ?? return []
    files :: resolver.discover_source_files().ok() ?? return []
    nested :: files.iter().filter(fn(file) { file.relative.file_name().and_then(fn(name) { name.to_str() }) == Val(Syntax.PACKAGE_FILE) })
        .filter_map(fn(file) { file.relative.parent() }).filter(fn(parent) { !parent.as_os_str().is_empty() && parent != OSPath.new(".") })
        .map(fn(parent) { parent.to_path_buf() }).collect::<[OSPath]>()
    files.iter().filter(fn(file) {
        !is_manifest_file(file.relative) && !is_command_role_file(file.relative) &&
            !nested.iter().any(fn(package) { file.relative.starts_with(package) })
    }).map(fn(file) { file.path }).collect()
}
// Rust: crates/jet-driver/src/ProjectParts.rs:192
fn is_manifest_file(relative: &OSPath) -> Bool {
    relative.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) {
        name == Syntax.PACKAGE_FILE || name == Syntax.PAYLOAD_FILE
    })
}
// Rust: crates/jet-driver/src/ProjectParts.rs:201
fn is_command_role_file(relative: &OSPath) -> Bool {
    relative.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) { Syntax.COMMAND_ROLE_FILES.contains(name) })
}
// Rust: crates/jet-driver/src/ProjectParts.rs:208
// GATE #4494: discovery/text/revalidation use the canonical retained authority resolver.
pub fn scan_with_diagnostics(root: &OSPath, overlays: &[(OSPath,String)]) -> (ProjectPartsReport,[ProjectPartScanFailure]) {
    (resolver, checked_files, authority_failure) :: if AuthorityResolver.open(root) == {
        Ok(value) -> if value.discover_source_files() == {
            Ok(files) -> (Val(value), files, None)
            Err(error) -> (Val(value), [], Val((root.to_path_buf(), error)))
        }
        Err(error) if error.is_missing() -> (None, [], None)
        Err(error) -> (None, [], Val((root.to_path_buf(), error)))
    }
    files := checked_files.iter().filter(fn(file) { !is_manifest_file(file.relative) && !is_command_role_file(file.relative) })
        .map(fn(file) { file.path }).collect::<[OSPath]>()
    files.extend(overlays.iter().map(fn(overlay) { overlay.0 }).filter(fn(path) {
        path.starts_with(root) && path.extension().and_then(fn(ext) { ext.to_str() }) == Val(Syntax.FILE_EXT) &&
            !is_command_role_file(path.strip_prefix(root).unwrap_or(path))
    }))
    files.sort()
    files.dedup()
    explicit := BTreeSet<String>.new()
    declarations := [String:[(OSPath,Bool)]]{}
    sources := [OSPath]{}
    failures := [ProjectPartScanFailure]{}
    if authority_failure == Val((path, error)) {
        failures.push(authority_failure_for(path, error))
        return (ProjectPartsReport{}, ^failures)
    }
    for path in files {
        source :: if overlays.iter().rev().find(fn(overlay) { overlay.0 == path }) == {
            Val(overlay) -> overlay.1
            None -> {
                file :: checked_files.iter().find(fn(file) { file.path == path }) ?? continue
                if resolver == Val(value) {
                    if value.revalidate_file(file) == Err(error) {
                        failures.push(authority_failure_for(file.path, error))
                        return (ProjectPartsReport{}, ^failures)
                    }
                }
                if file.text() == {
                    Ok(text) -> text
                    Err(error) -> {
                        failures.push(ProjectPartScanFailure { path: path,
                            module_names: path.file_stem().and_then(fn(stem) { stem.to_str() }).map(fn(stem) { [stem.to_string()] }).unwrap_or([]),
                            problem: error.diagnostic(), authority: true })
                        return (ProjectPartsReport{}, ^failures)
                    }
                }
            }
        }
        source_for_parse :: if Package.mask_inline_package_source(source) == {
            Ok((masked, _)) -> masked
            Err(error) -> {
                failures.push(ProjectPartScanFailure { path: path, module_names: [], problem: error.diagnostic(), authority: false })
                continue
            }
        }
        (tokens, lex_diags) :: Lexer.lex(source_for_parse)
        if !lex_diags.is_empty() {
            failures.push(ProjectPartScanFailure { path: path, module_names: declared_module_names(tokens), problem: lex_diags[0], authority: false })
            continue
        }
        program :: if Parser.parse_with_source(tokens, source_for_parse) == {
            Ok(program) -> program
            Err(parse_diags) -> {
                failures.push(ProjectPartScanFailure { path: path, module_names: declared_module_names(tokens), problem: parse_diags[0], authority: false })
                continue
            }
        }
        sources.push(path)
        if checked_files.iter().find(fn(file) { file.path == path }) == Val(file) {
            if resolver == Val(value) {
                if value.revalidate_file(file) == Err(error) {
                    failures.push(authority_failure_for(file.path, error))
                    return (ProjectPartsReport{}, ^failures)
                }
            }
        }
        for import in program.imports {
            if import.kind == .Module(name, _) {
                if name.strip_prefix(Syntax.PROJECT_IMPORT_PREFIX) == Val(leaf) { explicit.insert(leaf.to_string()) }
            }
        }
        for item in program.items {
            (name, automatic) :: if item == {
                .Module(module) -> (module.name, module.is_auto_discovered())
                .CodeModule(module) -> (module.name, !module.name.starts_with(Syntax.MODULE_INTERNAL_PREFIX))
                else -> continue
            }
            declarations.entry(name).or_default().push((path, automatic))
        }
    }
    declared_paths :: declarations.values().flat_map(fn(parts) { parts.iter().map(fn(part) { part.0 }) }).collect::<BTreeSet<OSPath>>()
    report := ProjectPartsReport { source_files: sources.into_iter().filter(fn(path) { !declared_paths.contains(path) }).collect() }
    // Rust uses BTreeMap: sort keys once to retain deterministic name order.
    names := declarations.keys().collect::<[String]>()
    names.sort()
    for name in names {
        parts :: declarations.remove(name).unwrap()
        if parts.len() > 1 { report.conflicts.push(ProjectPartConflict { name: name, paths: parts.iter().map(fn(part) { part.0 }).collect() }) }
        for (path, automatic) in parts {
            state :: if automatic { ProjectPartState.Automatic } else if explicit.contains(name) { ProjectPartState.Explicit } else { ProjectPartState.Skipped }
            report.parts.push(ProjectPart { name: name, path: path, state: state })
        }
    }
    if resolver == Val(value) {
        if value.revalidate_root() == Err(error) {
            failures.push(authority_failure_for(root.to_path_buf(), error))
            return (ProjectPartsReport{}, ^failures)
        }
    }
    (^report, ^failures)
}
// Rust: crates/jet-driver/src/ProjectParts.rs:390
fn authority_failure_for(path: OSPath, error: AuthorityError) -> ProjectPartScanFailure {
    ProjectPartScanFailure { path: path, module_names: [], problem: error.diagnostic(), authority: true }
}
// Rust: crates/jet-driver/src/ProjectParts.rs:399
fn declared_module_names(tokens: &[Lexer.Token]) -> [String] {
    tokens.windows(2).filter_map(fn(pair) {
        if (pair[0].kind, pair[1].kind) == { (.KwModule, .Ident(name)) -> Val(name) else -> None }
    }).collect()
}
