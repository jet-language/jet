use jet_driver.Loader.*
use jet_driver.Loader03.*
use jet_foundation.[Diagnostic, Span, Syntax, ImportDecl]
use jet_pkg_model.AuthorityResolver
use jet_driver.ProjectParts.[ProjectPartsReport, ProjectPartScanFailure, scan_with_diagnostics]
use core.path.OSPath


// Rust: crates/jet-driver/src/Loader.rs:5507
fn resolve_module_import(name: String, importing: OSPath, project_root: OSPath,
    pkg_dep_dirs: [String:DependencyDir], pkg_resolution: PkgResolution, span: Span,
    project_parts: ProjectPartsReport, project_part_failures: [ProjectPartScanFailure]) -> OSPath Diagnostic! {
    if name.strip_prefix(Syntax.PROJECT_IMPORT_PREFIX) == Val(local_name) {
        matches :: project_parts.named(local_name)
        scan_failure :: project_part_failures.iter().find(fn(failure) { failure.module_names.iter().any(fn(name) { name == local_name }) })
        if matches.len() == 0 {
            if scan_failure == Val(failure) -> return Err(failure.diagnostic(local_name, project_root, span))
            return Err(Diagnostic.error("E0603", "can't find a project module named `{Syntax.PROJECT_IMPORT_PREFIX}{local_name}`",
                "project-local imports resolve declared module names, not filenames",
                "declare `module {local_name} {{ ... }}` under this project", Val(span)))
        }
        if matches.len() == 1 -> return Ok(normalize_path(matches[0].path))
        return Err(project_parts.conflicts.iter().find(fn(conflict) { conflict.name == local_name })
            .expect("duplicate project parts have a conflict record").diagnostic(project_root, Val(span)))
    }
    first_segment :: name.split('.').next().unwrap_or(name)
    if pkg_dep_dirs.get(first_segment).filter(fn(_) { dependency_visible_from(importing, first_segment, pkg_dep_dirs) }) == Val(dependency) {
        dep_matches :: find_module_files_with_authority(name, dependency.authority)?
        if !dep_matches.is_empty() -> return Ok(dep_matches[0])
        if name == first_segment {
            if dependency.authority.checked_file(OSPath.new(Syntax.DEFAULT_ENTRY_FILE)) == {
                Ok(run_jet) -> {
                    dependency.authority.revalidate_file(run_jet).map_err(fn(error) { error.diagnostic() })?
                    return Ok(run_jet.path)
                }
                Err(error) -> {
                    if !error.is_missing() -> return Err(error.diagnostic())
                    // D-MOD-CYCLE1=A: any package member represents its namespace.
                    if package_member_files(dependency.authority.root())?.iter().next() == Val(member) -> return Ok(member)
                }
            }
        }
    }
    // U17: realized libraries resolve through their held staged source tree.
    if !pkg_resolution.is_empty() {
        if pkg_resolution.realized_libs.contains_key(first_segment) {
            authority :: pkg_resolution.realized_authorities.get(first_segment).ok_or_else(fn() {
                Diagnostic.error("E1334", "realized library `{first_segment}` has no held source authority",
                    "a verified library must keep its checked source root while the loader consumes it",
                    "re-realize the library in the shared store and retry", Val(span))
            })?
            lib_matches :: find_module_files_with_authority(name, authority)?
            if !lib_matches.is_empty() -> return Ok(lib_matches[0])
        }
        if pkg_resolution.realized_exes.contains(first_segment) -> return Err(e0982_executable_use(first_segment, span))
        if pkg_resolution.declared_deps.contains(first_segment) && find_module_files(name, project_root)?.is_empty() && !pkg_dep_dirs.contains_key(first_segment) {
            return Err(e0983_unrealized_library(first_segment, span))
        }
    }
    matches :: find_module_files(name, project_root)?
    if matches.len() == 0 {
        return Err(Diagnostic.error("E0603", "can't find a module named `{name}`",
            "search from the project root for `{name}.{Syntax.FILE_EXT}`, or `{name}/{name}/{name}.{Syntax.FILE_EXT}` / `{Syntax.DEFAULT_ENTRY_FILE}`",
            "add `{name}.{Syntax.FILE_EXT}` under this project, or fix the `{Syntax.KW_USE}` name", Val(span)))
    }
    if matches.len() == 1 -> return Ok(matches[0])
    list :: matches.iter().map(fn(path) { relative_display(project_root, path) }).collect::<[String]>().join(", ")
    Err(Diagnostic.error("E0606", "the module name `{name}` matches more than one file",
        "module imports must name exactly one file under the project root",
        "pick one file and use a file import instead: {list}", Val(span)))
}

// Rust: crates/jet-driver/src/Loader.rs:5672
fn find_module_files(name: String, project_root: OSPath) -> [OSPath] Diagnostic! {
    resolver :: AuthorityResolver.open(project_root).map_err(fn(error) { error.diagnostic() })?
    find_module_files_with_authority(name, resolver)
}

// Rust: crates/jet-driver/src/Loader.rs:5677
fn find_module_files_with_authority(name: String, resolver: AuthorityResolver) -> [OSPath] Diagnostic! {
    files :: resolver.discover_source_files().map_err(fn(error) { error.diagnostic() })?
    direct_name :: "{name}.{Syntax.FILE_EXT}"
    found := [OSPath]()
    loop file in files {
        file_name :: file.relative.file_name().and_then(fn(name) { name.to_str() })
        if file_name == None -> continue
        if file_name.unwrap() == direct_name || (file_name.unwrap() == Syntax.DEFAULT_ENTRY_FILE &&
            file.relative.parent().and_then(fn(parent) { parent.file_name() }).and_then(fn(name) { name.to_str() }) == Val(name)) {
            found.push(file.path)
        }
    }
    found.sort()
    found.dedup()
    Ok(found)
}

// Rust: crates/jet-driver/src/Loader.rs:5713
// Generated module aliases replace non-identifier characters and prefix digits.
pub fn default_module_alias(path: OSPath) -> String {
    stem :: path.file_stem().and_then(fn(stem) { stem.to_str() }).unwrap_or("module")
    sanitize_alias(stem)
}

// Rust: crates/jet-driver/src/Loader.rs:5721
fn sanitize_alias(raw: String) -> String {
    out := String.with_capacity(raw.len())
    loop c in raw.chars() { out.push(if c.is_ascii_alphanumeric() || c == '_' -> c else -> '_') }
    if out.is_empty() { out.push_str("module") }
    if out.chars().next().is_some_and(fn(c) { c.is_ascii_digit() }) { out.insert(0, '_') }
    out
}

// Rust: crates/jet-driver/src/Loader.rs:5739
pub fn resolve_import_target(bundle: ProgramBundle, importing_idx: Int, imp: ImportDecl) -> Int [Diagnostic]! {
    if core_module_path(imp).is_some() {
        return Err([Diagnostic.error("E1001", "core modules do not resolve to files",
            "`core` is provided by the compiler in M10", "handle this import as a compiler-known module", Val(imp.span))])
    }
    importing :: bundle.modules[importing_idx]
    (pkg_dep_dirs, pkg_resolution) :: project_resolution_for_bundle(bundle)?
    (project_parts, project_part_failures) :: scan_with_diagnostics(bundle.project_root, [])
    if project_part_failures.iter().find(fn(failure) { failure.authority }) == Val(failure) -> return Err([failure.problem])
    target_path :: if resolve_import(imp, importing.path, bundle.project_root, pkg_dep_dirs, pkg_resolution, project_parts, project_part_failures) == {
        Ok(path) -> normalize_path(path)
        Err(diagnostic) -> return Err([diagnostic])
    }
    loop (i, module) in bundle.modules.iter().enumerate() {
        if normalize_path(module.path) == target_path -> return Ok(i)
    }
    Err([Diagnostic.error("E0603", "imported file isn't part of this program",
        "the loader should have pulled in every imported file already", "report this as a compiler bug", Val(imp.span))])
}

// Rust: crates/jet-driver/src/Loader.rs:5792
pub fn import_alias(imp: ImportDecl) -> String { imp.import_alias() }

// Rust: crates/jet-driver/src/Loader.rs:5798
fn e0982_executable_use(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0982", "`{name}` is an executable package, so it can't be used with `{Syntax.KW_USE}`",
        "an `executable` package installs a binary on your PATH — you run it, you don't import its code; only a `library` package is brought into code with `use` (U17)",
        "remove `{Syntax.KW_USE} {name};` and run the `{name}` binary instead, or change `{name}` to `library` in `{Syntax.PACKAGE_FILE}` if you meant to import its code", Val(span))
}

// Rust: crates/jet-driver/src/Loader.rs:5814
fn e0983_unrealized_library(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0983", "the library package `{name}` hasn't been built yet",
        "a `library` package must be realized — its source staged in the shared store (hangar) — before `use` can find it (U17)",
        "run `jetpack env --prep` to realize `{name}`, or rerun `jet run` without `--no-prepare`; then `{Syntax.KW_USE} {name};` will resolve it", Val(span))
}

// Rust: crates/jet-driver/src/Loader.rs:5828
fn e0602(span: Span) -> Diagnostic {
    Diagnostic.error("E0602", "this import path escapes the package",
        "inside a package, file imports stay in the package tree — `..` works only for loose files outside any package",
        "use a path without `..`, or move the file inside the package tree", Val(span))
}

// Rust: crates/jet-driver/src/Loader.rs:5839
pub fn relative_display(root: OSPath, path: OSPath) -> String { path.strip_prefix(root).unwrap_or(path).display().to_string() }

// Rust: crates/jet-driver/src/Loader.rs:5848
pub fn is_physically_within(root: OSPath, path: OSPath) -> Bool {
    held_root :: if AuthorityResolver.open(root) == { Ok(root) -> root else -> return false }
    held_path :: if AuthorityResolver.open(path) == { Ok(path) -> path else -> return false }
    held_path.root().starts_with(held_root.root())
}
