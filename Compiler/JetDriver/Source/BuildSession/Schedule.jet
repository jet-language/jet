// The generation schedule a build's declarations fix (spec "Programmable
// builds", generation rounds). Its producers are each module `build: fn`
// generated (`b.generate`, `meta.add`, `meta.rewrite_body`) and each step.
// What a producer promises are its outputs; what it waits on are its
// declared inputs (`.input`, `.reads`, `.file`) that another producer
// promises. A wait on Jet source (a `.jet` path) is a typed barrier: the
// consumer reads that source only once the build has checked it, so it runs
// a round later. A wait on any other file keeps the consumer in its
// producer's round. Every module `build: fn` generated is round 1, checked
// with the package's sources before any step runs; a step's round is the
// latest round of what it waits on, one later across a typed barrier, and 1
// when it waits on nothing. A step that waits on itself, alone or through
// other steps, has no round: E3511 when Jet source closes the cycle, else
// the E3502 step cycle. A build generates in at most
// BUILD_SESSION_GENERATION_ROUNDS rounds (the round limit),
// and a step past it is E3516. The schedule is computed from the
// declarations alone, so it does not depend on the order steps ran in, the
// cache or the thread count.

BUILD_SESSION_GENERATION_ROUNDS: 17

// One wait of a step: its declared input at index `input` of the step's
// inputs (build_session_schedule_input), the producer that promises it
// (`kind` "module" or "step", and `producer` as
// build_session_schedule_promises numbers it), and its barrier: "typed" for
// Jet source, read a round later, else "file".
BuildSessionScheduleWait: struct {
    input: Int,
    kind: String,
    producer: Int,
    barrier: String,
}

// One producer of the schedule: its kind ("module" or "step"), the producer
// as build_session_schedule_promises numbers it, whose name and outputs the
// session state holds (build_session_schedule_name and
// build_session_schedule_output), its round, the call that made it and its
// place (`made_by`, build_session_made_by and build_session_step_made_by),
// and what it waits on, in declaration order.
BuildSessionScheduleNode: struct {
    kind: String,
    producer: Int,
    round: Int,
    made_by: String,
    waits: [BuildSessionScheduleWait],
}

// The name of producer `producer` of `state`'s schedule.
build_session_schedule_name: fn(state: BuildSessionState, producer: Int) -> String Never! from state {
    if producer < 0 -> state.generated[-1 - producer].name else -> state.actions[producer].name
}

// How many outputs producer `producer` of `state`'s schedule promises: a
// module, its one path.
build_session_schedule_output_count: fn(state: BuildSessionState, producer: Int) -> Int Never! {
    if producer < 0 -> 1 else -> state.actions[producer].outputs.len()
}

// Output `index` of producer `producer` of `state`'s schedule.
build_session_schedule_output: fn(state: BuildSessionState, producer: Int, index: Int) -> String Never! from state {
    if producer < 0 -> state.generated[-1 - producer].path else -> state.actions[producer].outputs[index]
}

// The path wait `wait` of step `step` reads.
build_session_schedule_input: fn(state: BuildSessionState, step: Int, wait: BuildSessionScheduleWait) -> String Never! from state {
    state.actions[step].inputs[wait.input]
}

// The call that declared a step, as provenance names it: its `b.run` call
// (`b.action` declares one too) and its place.
build_session_step_made_by: fn(action: BuildSessionAction) -> String Never! {
    if action.site == "" -> return "`b.run(\"{action.name}\")`"
    "`b.run(\"{action.name}\")` at {action.site}"
}

// Who promises each path: a generated module `index` as `-1 - index`, a
// step by its action id.
build_session_schedule_promises: fn(state: BuildSessionState) -> [String:Int] Never! {
    promises := [String:Int]{}
    loop (index, generated) in state.generated -> promises[generated.path] = -1 - index
    loop (id, action) in state.actions {
        loop output in action.outputs -> promises[output] = id
    }
    promises
}

// Whether a wait on `path` is a typed barrier: Jet source, which its
// consumer reads only once it is checked.
build_session_schedule_typed: fn(path: String) -> Bool Never! { path.ends_with(".jet") }

// For each step, the steps whose outputs it reads, itself included.
build_session_schedule_edges: fn(state: BuildSessionState, promises: [String:Int]) -> [[Int]] Never! {
    edges := [[Int]]{}
    loop action in state.actions {
        row := [Int]{}
        loop path in action.inputs {
            producer: promises.get(path) ?? next
            if producer >= 0 -> build_session_append_int(row, producer)
        }
        row.sort()
        edges.push(row)
    }
    edges
}

// The round of the producer `producer` names (a module's is 1) as the
// consumer reading `path` from it reaches it.
build_session_schedule_reached: fn(rounds: [Int], producer: Int, path: String) -> Int Never! {
    made: if producer < 0 -> 1 else -> rounds[producer]
    if build_session_schedule_typed(path) -> made + 1 else -> made
}

// Each step's round, by action id. The step graph has no cycle.
build_session_schedule_rounds: fn(state: BuildSessionState, promises: [String:Int]) -> [Int] Never! {
    rounds := [Int]{}
    loop _ in state.actions -> rounds.push(1)
    changed := true
    loop changed {
        changed = false
        loop (id, action) in state.actions {
            round := 1
            loop path in action.inputs {
                producer: promises.get(path) ?? next
                reached: build_session_schedule_reached(rounds, producer, path)
                if reached > round -> round = reached
            }
            if round != rounds[id] {
                rounds[id] = round
                changed = true
            }
        }
    }
    rounds
}

build_session_schedule_step: fn(state: BuildSessionState, name: String) -> Int Never! {
    loop (id, action) in state.actions {
        if action.name == name -> return id
    }
    panic("a schedule cycle names a step of this build")
}

// Whether step `consumer` reads Jet source step `producer` makes.
build_session_schedule_typed_wait: fn(state: BuildSessionState, consumer: Int, producer: Int) -> Bool Never! {
    loop path in state.actions[consumer].inputs {
        if build_session_schedule_typed(path) && build_session_contains_string(state.actions[producer].outputs, path) {
            return true
        }
    }
    false
}

// The steps that carry step `id` to its round, earliest first, by action id:
// at each step, the first producer whose round reaches it.
build_session_schedule_chain: fn(state: BuildSessionState, promises: [String:Int], rounds: [Int], id: Int) -> [Int] Never! {
    chain := [Int]{id}
    current := id
    loop {
        found := -1
        loop path in state.actions[current].inputs {
            producer: promises.get(path) ?? next
            if producer < 0 || producer == current -> next
            if build_session_schedule_reached(rounds, producer, path) == rounds[current] {
                found = producer
                break
            }
        }
        if found < 0 -> break
        chain.push(found)
        current = found
    }
    chain.reverse()
    chain
}

// The names of `steps` (action ids, each at most once), in its order, taken
// from `names`, each step's name by action id.
build_session_schedule_named: fn(names: &&[String], steps: [Int]) -> [String] Never! {
    at := [Int]{}
    loop _ in names -> at.push(-1)
    loop (position, step) in steps -> at[step] = position
    slots := [String?]{}
    loop _ in steps -> slots.push(None)
    loop (id, name) in names.move() {
        if at[id] >= 0 -> slots[at[id]] = Val(name)
    }
    loop slot in slots.move() -> slot ?? panic("a schedule chain names each step once")
}

// The first schedule fact that refuses the plan: a step that waits on
// itself (reported at the `b.run` call of the step the cycle starts from),
// else the first step, in declaration order, past the round limit (at its
// own `b.run` call).
build_session_schedule_check: fn(state: BuildSessionState) -> BuildSessionDiagnostic? Never! {
    promises: build_session_schedule_promises(state)
    names: loop action in state.actions -> action.name
    if build_session_cycle(build_session_schedule_edges(state, promises), names) == .Val(nodes) {
        typed := false
        loop index in 0..<(nodes.len() - 1) {
            consumer: build_session_schedule_step(state, nodes[index])
            producer: build_session_schedule_step(state, nodes[index + 1])
            if build_session_schedule_typed_wait(state, consumer, producer) -> typed = true
        }
        error: if typed -> BuildSessionError.GenerationWaitCycle{nodes: nodes} else -> BuildSessionError.ActionDependencyCycle{nodes: nodes}
        diagnostic := build_session_error_diag(state, error)
        first: state.actions[build_session_schedule_step(state, nodes[0])]
        diagnostic.start = first.start
        diagnostic.end = first.end
        return Val(diagnostic)
    }
    rounds: build_session_schedule_rounds(state, promises)
    loop (id, action) in state.actions {
        if rounds[id] <= BUILD_SESSION_GENERATION_ROUNDS -> next
        chain: build_session_schedule_named(names.move(), build_session_schedule_chain(state, promises, rounds, id))
        diagnostic := build_session_error_diag(state, BuildSessionError.GenerationRoundLimit{step: action.name, round: rounds[id], chain: chain})
        diagnostic.start = action.start
        diagnostic.end = action.end
        return Val(diagnostic)
    }
    None
}

// The schedule of a checked plan's state: round by round, each round's
// modules, then its steps, each in name order.
build_session_schedule: fn(state: BuildSessionState) -> [BuildSessionScheduleNode] Never! {
    promises: build_session_schedule_promises(state)
    rounds: build_session_schedule_rounds(state, promises)
    nodes := [BuildSessionScheduleNode]{}
    loop (index, generated) in state.generated {
        nodes.push(BuildSessionScheduleNode{kind: "module", producer: -1 - index, round: 1, made_by: build_session_made_by(generated), waits: [BuildSessionScheduleWait]{}})
    }
    loop (id, action) in state.actions {
        waits := [BuildSessionScheduleWait]{}
        loop (input, path) in action.inputs {
            producer: promises.get(path) ?? next
            barrier: if build_session_schedule_typed(path) -> "typed" else -> "file"
            kind: if producer < 0 -> "module" else -> "step"
            waits.push(BuildSessionScheduleWait{input: input, kind: kind, producer: producer, barrier: barrier})
        }
        nodes.push(BuildSessionScheduleNode{kind: "step", producer: id, round: rounds[id], made_by: build_session_step_made_by(action), waits: waits.move()})
    }
    nodes.sort_by(fn(left: BuildSessionScheduleNode, right: BuildSessionScheduleNode) {
        if left.round != right.round -> return left.round <=> right.round
        if left.kind != right.kind -> return left.kind <=> right.kind
        build_session_schedule_name(state, left.producer) <=> build_session_schedule_name(state, right.producer)
    })
    nodes
}
