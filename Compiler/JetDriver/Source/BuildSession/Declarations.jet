use jet_foundation.[BuildSettingOverride]

// `b.run(name, tool, caps)`: a step that runs `tool`, a BuildFile. Its
// arguments come one call at a time (build_session_step_arg and the other
// step calls); a found program, as the tool or an argument, is looked up
// when the step runs, and a file another step makes or a host build of a
// target is declared as the step's input, so this step runs after its
// maker.
build_session_add_run: fn(state: &BuildSessionState, args: [BuildSessionValue], start: Int, end: Int) -> BuildSessionReply {
    if args.len() != 3 {
        return build_session_fail(state, "`b.run` takes a name, a tool and its effects")
    }
    name: build_session_text(args, 0) ?? return build_session_fail(state, "step name must be a string")
    tool: build_session_handle(state, args[1], "BuildFile") ?? return build_session_fail(state, "the step's tool does not belong to this build")
    caps: build_session_caps(build_session_strings(args, 2) ?? return build_session_fail(state, "a step's effects must be strings")) ?? return build_session_fail(state, "unknown build effect; use one of the ten declared effects")
    file: state.files[tool]
    if file.kind == "package" {
        return build_session_fail(state, "package `{file.path}` is a folder, not a tool; run a file in it: `b.dependency(\"{file.path}\").file(path)`")
    }
    if file.kind == "folder" {
        return build_session_fail(state, "folder `{file.path}` is not a tool; run a file in it, and pass the folder with `.file(dir)`")
    }
    probes := [Int]{}
    inputs := [String]{}
    if file.probe == .Val(probe) -> probes.push(probe)
    if file.kind == "output" || file.kind == "host" || file.kind == "image" || file.kind == "dependency" {
        inputs.push(file.path.copy())
    }
    action: BuildSessionAction{name: name, inputs: inputs, outputs: [String]{}, kept: [String]{}, folders: [Int]{}, programs: [BuildSessionProgram]{}, argv: [String]{file.path.copy()}, caps: caps, toolchain: 0, probes: probes, signing: None, tool: tool, start: start, end: end, site: build_session_site(state, start)}
    if action.name.trim() == "" -> return build_session_error_fail(state, .EmptyActionName)
    if state.actions.len() >= 100000 {
        return build_session_fail(state, "action graph exceeds 100000 actions")
    }
    loop old in state.actions {
        if old.name == action.name {
            return build_session_error_fail(state, BuildSessionError.DuplicateActionName{value: action.name})
        }
    }
    id: state.actions.len()
    state.actions.push(action)
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildStepHandle", session: state.id, id: id}}
}

// A step written as a value, core.build's `BuildAction` (args: its name, its
// command, the files it reads, the files it makes and its effects), made into
// the `b.run` step those spell: the command's program, found on the machine
// as a find_program probe of the same name finds it, run with the rest of the
// command as its arguments, `.reads` of each input and `.writes` of each
// output. A command that names its inputs and outputs passes their paths as
// plain arguments.
build_session_add_action: fn(state: &BuildSessionState, args: [BuildSessionValue], start: Int, end: Int) -> BuildSessionReply {
    if args.len() != 5 {
        return build_session_fail(state, "a `BuildAction` has a name, a command, inputs, outputs and effects")
    }
    name: build_session_text(args, 0) ?? return build_session_fail(state, "step name must be a string")
    run: build_session_strings(args, 1) ?? return build_session_fail(state, "a step's command must be a list of strings")
    inputs: build_session_strings(args, 2) ?? return build_session_fail(state, "a step's inputs must be a list of paths")
    outputs: build_session_strings(args, 3) ?? return build_session_fail(state, "a step's outputs must be a list of paths")
    if run.len() == 0 {
        return build_session_fail(state, "step `{name}` runs no command; name its program first in `run`")
    }
    probe: build_session_add_probe(state, [BuildSessionValue]{BuildSessionValue.Text{value: name}, BuildSessionValue.Text{value: "find_program"}, BuildSessionValue.Text{value: run[0]}}, true)
    found: if probe == .Value(value) -> build_session_found(state, BuildSessionCall{args: [BuildSessionValue]{value}}) else -> {
        return probe
    }
    step: if found == .Value(value) -> build_session_add_run(state, [BuildSessionValue]{BuildSessionValue.Text{value: name}, value, args[4]}, start, end) else -> {
        return found
    }
    handle: if step == .Value(value) -> value else -> {
        return step
    }
    loop arg in run.slice(1, run.len()) {
        reply: build_session_step_arg(state, BuildSessionCall{args: [BuildSessionValue]{handle.copy(), BuildSessionValue.Text{value: arg}}})
        if reply != .Value(value: .Unit) -> return reply
    }
    loop path in inputs {
        reply: build_session_step_reads(state, BuildSessionCall{args: [BuildSessionValue]{handle.copy(), BuildSessionValue.Text{value: path}}})
        if reply != .Value(value: .Unit) -> return reply
    }
    loop path in outputs {
        reply: build_session_step_writes(state, BuildSessionCall{args: [BuildSessionValue]{handle.copy(), BuildSessionValue.Text{value: path}}})
        if reply != .Value(value: .Unit) -> return reply
    }
    step
}

// `b.found(probe)`: the program a find_program probe finds, which a step runs
// as its tool or is passed with `.file`, or the folder a find_folder probe
// chooses, which a step reads whole at `.jet/found/<probe>`.
build_session_found: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    if call.args.len() != 1 -> return build_session_fail(state, "`b.found` takes one probe")
    probe: build_session_handle(state, call.args[0], "BuildProbe") ?? return build_session_fail(state, "the probe does not belong to this build")
    row: state.probes[probe]
    if row.kind == "find_folder" {
        if row.name.contains("/") || row.name == "." || row.name == ".." {
            return build_session_fail(state, "probe `{row.name}` names the folder a step reads at `{BUILD_SESSION_FOUND_DIR}/{row.name}`; name it without `/`")
        }
        return build_session_new_file(state, BuildSessionFile{kind: "folder", path: "{BUILD_SESSION_FOUND_DIR}/{row.name}", probe: Val(probe), action: None})
    }
    if row.kind != "find_program" {
        return build_session_fail(state, "`b.found` takes a find_program or find_folder probe, and `{row.name}` is a {row.kind} probe")
    }
    build_session_new_file(state, BuildSessionFile{kind: "found", path: row.value.copy(), probe: Val(probe), action: None})
}

// Where a step reads the folder a find_folder probe chose.
BUILD_SESSION_FOUND_DIR: ".jet/found"

// Where `b.host(target)` puts the target's host build, never installed.
BUILD_SESSION_HOST_DIR: ".jet/build/host"

// Where `b.image(target)` puts a copy of the target's image for steps.
BUILD_SESSION_IMAGE_DIR: ".jet/build/image"

// `b.host(target)`: the executable `target` built for the machine running
// the build, the tool a step runs on it.
build_session_host: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    if call.args.len() != 1 -> return build_session_fail(state, "`b.host` takes one target")
    build_session_target_built(state, call.args[0])
}

// `b.image(target)`: the same target built for the build's selected
// platform, the program a step packs or ships.
build_session_image: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    if call.args.len() != 1 -> return build_session_fail(state, "`b.image` takes one target")
    build_session_target_built(state, call.args[0], image: true)
}

// The host build (`image` false) or the image of the target handle `value`.
build_session_target_built: fn(state: &BuildSessionState, value: BuildSessionValue, image: Bool{false}) -> BuildSessionReply {
    call: if image -> "b.image" else -> "b.host"
    target: build_session_handle(state, value, "BuildTarget") ?? return build_session_fail(state, "the target does not belong to this build")
    row: state.targets[target]
    if build_session_executable_refusal(row, call) == .Val(refusal) -> return build_session_fail(state, refusal)
    kind: if image -> "image" else -> "host"
    folder: if image -> BUILD_SESSION_IMAGE_DIR else -> BUILD_SESSION_HOST_DIR
    build_session_new_file(state, BuildSessionFile{kind: kind, path: "{folder}/{row.name}", probe: None, action: None, target: Val(target)})
}

// Why `call` can't build `row`, if it can't: only an executable target with
// a source has a host build or an image.
build_session_executable_refusal: fn(row: BuildSessionTarget, call: String) -> String? Never! {
    if row.kind == "executable" && row.sources.len() > 0 -> return None
    Val("`{call}` builds an executable target from its source, and `{row.name}` is a {row.kind} target{if row.sources.len() == 0 -> " with no source" else -> ""}")
}

// `b.jet()`: the compiler running the build, as a tool.
build_session_jet: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    if call.args.len() != 0 -> return build_session_fail(state, "`b.jet` takes no arguments")
    build_session_new_file(state, BuildSessionFile{kind: "jet", path: "jet", probe: None, action: None})
}

// `b.jet_built_from(target)` (args: the target, then the source key of the
// toolchain tree that holds this build, which the host hashes): the
// compiler running the build when it was built from the sources that tree
// holds now, its runtime pack naming that source key, so it is the compiler
// `target` would build; else `b.host(target)`. A step it is passed to then
// doesn't wait for `target` to compile.
build_session_jet_built_from: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    if args.len() != 2 -> return build_session_fail(state, "`b.jet_built_from` takes one target")
    tree: build_session_text(args, 1) ?? return build_session_fail(state, "`b.jet_built_from` lost the source key of its toolchain tree")
    target: build_session_handle(state, args[0], "BuildTarget") ?? return build_session_fail(state, "the target does not belong to this build")
    if build_session_executable_refusal(state.targets[target], "b.jet_built_from") == .Val(refusal) -> return build_session_fail(state, refusal)
    if state.jet_source == "" || state.jet_source != tree -> return build_session_target_built(state, args[0])
    build_session_new_file(state, BuildSessionFile{kind: "jet", path: "jet", probe: None, action: None})
}

// `b.source_key()` (args: the key the host hashed): the source key of the
// toolchain tree that holds this build, the sha256 that names each file of
// its Compiler/, Core/ and Jetpack/ folders (JetCLI Request.jet
// jet_cli_source_key).
build_session_source_key: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    if args.len() != 1 -> return build_session_fail(state, "`b.source_key` takes no arguments")
    key: build_session_text(args, 0) ?? return build_session_fail(state, "`b.source_key` lost the source key of its toolchain tree")
    BuildSessionReply.Value{value: BuildSessionValue.Text{value: key}}
}

// Where a step finds the files of the packages package.jet lists, copied
// there before any step runs.
BUILD_SESSION_DEPS_DIR: ".jet/deps"

// `b.dependency(name)`: the folder of the package package.jet lists as
// `name`, whose files `.file(path)` and folders `.folder(path)` name; a step
// reads all of it with `.file(b.dependency(name))`.
build_session_dependency: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    if args.len() != 1 -> return build_session_fail(state, "`b.dependency` takes one package name")
    name: build_session_text(args, 0) ?? return build_session_fail(state, "a package name must be a string")
    if !state.dependencies.has_key(name) {
        names := state.dependencies.keys().to_list()
        names.sort()
        listed: if names.len() == 0 -> "package.jet lists none" else -> "package.jet lists {names.join(", ")}"
        return build_session_fail(state, "`b.dependency(\"{name}\")` names no package of this build's package.jet; {listed}")
    }
    build_session_new_file(state, BuildSessionFile{kind: "package", path: name, probe: None, action: None})
}

// `b.folder(path)`: the folder at `path` in this build's package, which a
// step reads whole with `.file(dir)`.
build_session_folder: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    if args.len() != 1 -> return build_session_fail(state, "`b.folder` takes one path")
    path: build_session_text(args, 0) ?? return build_session_fail(state, "`b.folder` takes a path")
    if build_session_folder_path_error(state, path) == .Val(failure) -> return failure
    build_session_new_file(state, BuildSessionFile{kind: "folder", path: path, probe: None, action: None})
}

// Why `path` can't name a folder, if it can't: it must stay inside its
// package, and be written plainly (`.` alone, else no empty or `.` parts),
// so one folder has one path.
build_session_folder_path_error: fn(state: &BuildSessionState, path: String) -> BuildSessionReply? {
    if build_session_path_error(path) == .Val(error) {
        return Val(build_session_error_fail(state, error))
    }
    if path == "." -> return None
    loop part in path.split("/") {
        if part == "" || part == "." {
            return Val(build_session_fail(state, "folder `{path}` must be written plainly, as `dir/sub`: no empty or `.` parts and no trailing `/`"))
        }
    }
    None
}

// `package.file(path)`: the file at `path` in a package's folder, which a
// step reads at `.jet/deps/<name>/<path>`.
build_session_file_file: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_package_entry(state, call.args)
}

// `package.folder(path)`: the folder at `path` in a package's folder, which
// a step reads whole at that path.
build_session_file_folder: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_package_entry(state, call.args, folder: true)
}

// The file (`folder` false) or folder at a path in the package folder
// `args[0]`.
build_session_package_entry: fn(state: &BuildSessionState, args: [BuildSessionValue], folder: Bool{false}) -> BuildSessionReply {
    call: if folder -> "folder" else -> "file"
    if args.len() != 2 -> return build_session_fail(state, "`{call}` takes a path")
    id: build_session_handle(state, args[0], "BuildFile") ?? return build_session_fail(state, "the file does not belong to this build")
    dep: state.files[id]
    if dep.kind != "package" {
        return build_session_fail(state, "`{dep.path}` is not a package folder; `.{call}(path)` names a {call} in `b.dependency(name)`")
    }
    path: build_session_text(args, 1) ?? return build_session_fail(state, "`{call}` takes a path")
    root: state.dependencies.get(dep.path) ?? return build_session_fail(state, "package `{dep.path}` lost its folder")
    if folder {
        if build_session_folder_path_error(state, path) == .Val(failure) -> return failure
        return build_session_new_file(state, build_session_dependency_folder(dep.path, root, path))
    }
    if build_session_path_error(path) == .Val(error) {
        return build_session_error_fail(state, error)
    }
    build_session_new_file(state, BuildSessionFile{kind: "dependency", path: "{BUILD_SESSION_DEPS_DIR}/{dep.path}/{path}", probe: None, action: None, from: Val("{root}/{path}")})
}

// The folder `path` (`.`: all of it) of the package `name` package.jet lists,
// at `root`: a step reads it at `.jet/deps/<name>/<path>`, bound from there.
build_session_dependency_folder: fn(name: String, root: String, path: String) -> BuildSessionFile Never! {
    if path == "." {
        return BuildSessionFile{kind: "folder", path: "{BUILD_SESSION_DEPS_DIR}/{name}", probe: None, action: None, from: Val(root.copy())}
    }
    BuildSessionFile{kind: "folder", path: "{BUILD_SESSION_DEPS_DIR}/{name}/{path}", probe: None, action: None, from: Val("{root}/{path}")}
}

build_session_new_file: fn(state: &BuildSessionState, file: BuildSessionFile) -> BuildSessionReply {
    id: state.files.len()
    state.files.push(file.copy())
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildFile", session: state.id, id: id}}
}

// `file.path()`: the package-relative path of a file a step makes or reads;
// a package's is the folder a step reads it at.
build_session_file_path: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    if args.len() != 1 -> return build_session_fail(state, "`path` takes no arguments")
    id: build_session_handle(state, args[0], "BuildFile") ?? return build_session_fail(state, "the file does not belong to this build")
    file: state.files[id]
    if file.kind == "found" {
        return build_session_fail(state, "found program `{file.path}` has no path until the build runs; pass it to a step, as its tool or with `.file(found)`")
    }
    if file.kind == "jet" {
        return build_session_fail(state, "`b.jet()` has no path until the build runs; pass it to a step, as its tool or with `.file(b.jet())`")
    }
    path: if file.kind == "package" -> "{BUILD_SESSION_DEPS_DIR}/{file.path}" else -> file.path.copy()
    BuildSessionReply.Value{value: BuildSessionValue.Text{value: path}}
}

// The calls on a `b.run` step (args: the step, then the call's values). A
// file call declares the file and appends its path, after its `flag:` text
// when one is given, to the tool's arguments; a folder (`b.folder(path)`, a
// package or a folder in one) the step reads whole; a found program the path
// its probe finds when the step runs. An output with `kept: true` stays in
// git: the build rewrites it and refuses a hand edit of it, so it can't be
// under `.jet/`, which is never committed.

// The step a step call is made on, its first argument; None when the call
// lost it or it is another build's (build_session_step_refused).
build_session_step_id: fn(state: BuildSessionState, args: [BuildSessionValue]) -> Int? {
    if args.len() == 0 -> return None
    build_session_handle(state, args[0], "BuildStepHandle")
}

build_session_step_refused: fn(state: BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() == 0 -> return build_session_fail(state, "step call lost its step")
    build_session_fail(state, "the step does not belong to this build")
}

// `.input(path, flag:)`: a file the step reads, also passed as an argument.
build_session_step_input: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_step_read(state, call.args, "input", passed: true)
}

// `.reads(path)`: a file the step reads.
build_session_step_reads: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_step_read(state, call.args, "reads")
}

// A file the step reads (`.{written}`), and its argument when `passed`.
build_session_step_read: fn(state: &BuildSessionState, args: [BuildSessionValue], written: String, passed: Bool{false}) -> BuildSessionReply {
    id: build_session_step_id(state, args) ?? return build_session_step_refused(state, args)
    step := state.actions[id]
    path: build_session_text(args, 1) ?? return build_session_fail(state, "`.{written}` takes a path")
    if build_session_path_error(path) == .Val(error) {
        return build_session_error_fail(state, error)
    }
    build_session_append_unique(step.inputs, path)
    if passed -> step.argv.push("{build_session_text(args, 2) ?? ""}{path}")
    state.actions[id] = step
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// `.output(path, flag:, kept:)`: a file the step makes, passed as an
// argument; its BuildFile.
build_session_step_output: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_step_write(state, call.args, "output", passed: true)
}

// `.writes(path, kept:)`: a file the step makes.
build_session_step_writes: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    build_session_step_write(state, call.args, "writes")
}

// A file the step makes (`.{written}`), and its argument and BuildFile when
// `passed`.
build_session_step_write: fn(state: &BuildSessionState, args: [BuildSessionValue], written: String, passed: Bool{false}) -> BuildSessionReply {
    id: build_session_step_id(state, args) ?? return build_session_step_refused(state, args)
    step := state.actions[id]
    path: build_session_text(args, 1) ?? return build_session_fail(state, "`.{written}` takes a path")
    if build_session_path_error(path) == .Val(error) {
        return build_session_error_fail(state, error)
    }
    kept: build_session_kept(args)
    if kept && (path == ".jet" || path.starts_with(".jet/")) {
        return build_session_fail(state, "step `{step.name}` keeps `{path}` in git, and nothing under `.jet/` is ever committed; keep a file outside `.jet/`, or drop `kept: true`")
    }
    if build_session_contains_string(step.outputs, path) {
        return build_session_error_fail(state, BuildSessionError.DuplicateActionOutput{action: step.name, output: path})
    }
    loop generated in state.generated {
        if generated.path == path {
            return build_session_error_fail(state, BuildSessionError.GeneratedModuleCycle{name: generated.name, path: path})
        }
    }
    step.outputs.push(path.copy())
    if kept -> step.kept.push(path.copy())
    if !passed {
        state.actions[id] = step
        return BuildSessionReply.Value{value: BuildSessionValue.Unit}
    }
    step.argv.push("{build_session_text(args, 2) ?? ""}{path}")
    state.actions[id] = step
    build_session_new_file(state, BuildSessionFile{kind: "output", path: path, probe: None, action: Val(id)})
}

// `.file(file, flag:)`: a file, folder or program the step is passed.
build_session_step_file: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    id: build_session_step_id(state, args) ?? return build_session_step_refused(state, args)
    step := state.actions[id]
    flag: build_session_text(args, 2) ?? ""
    unit: BuildSessionReply.Value{value: BuildSessionValue.Unit}
    file_id: build_session_handle(state, args[1], "BuildFile") ?? return build_session_fail(state, "the file does not belong to this build")
    file: state.files[file_id]
    if file.kind == "found" {
        // The argument is the program's path, set as the step starts.
        probe: file.probe ?? return build_session_fail(state, "found program `{file.path}` lost its probe")
        if !step.probes.contains(probe) -> step.probes.push(probe)
        step.programs.push(BuildSessionProgram{at: step.argv.len(), flag: flag.copy(), probe: probe})
        step.argv.push("{flag}{file.path}")
        state.actions[id] = step
        return unit
    }
    if file.kind == "jet" {
        // The argument is the path the compiler runs at in the step's
        // sandbox, its folder mounted read-only there.
        if step.toolchain != 0 {
            return build_session_fail(state, "step `{step.name}` is passed `b.jet()`, which runs on the toolchain it was built with")
        }
        step.argv.push("{flag}{file.path}")
        step.jets.push(BuildSessionJetArg{at: step.argv.len() - 1, flag: flag.move()})
        state.actions[id] = step
        return unit
    }
    if (file.action ?? -1) == id {
        return build_session_fail(state, "step `{step.name}` makes `{file.path}`, so it can't also read it")
    }
    if file.kind == "package" || file.kind == "folder" {
        folder_id := file_id
        if file.kind == "package" {
            root: state.dependencies.get(file.path) ?? return build_session_fail(state, "package `{file.path}` lost its folder")
            folder_id = state.files.len()
            state.files.push(build_session_dependency_folder(file.path, root, "."))
        }
        path: state.files[folder_id].path
        known: loop old in step.folders {
            if state.files[old].path == path {
                break true
            }
        } ?? false
        if !known -> step.folders.push(folder_id)
        // A found folder is the one its probe chooses as the step starts.
        if file.probe == .Val(probe) {
            if !step.probes.contains(probe) -> step.probes.push(probe)
        }
        step.argv.push("{flag}{path}")
        state.actions[id] = step
        return unit
    }
    build_session_append_unique(step.inputs, file.path)
    step.argv.push("{flag}{file.path}")
    state.actions[id] = step
    unit
}

// `.arg(text)`: one argument of the tool.
build_session_step_arg: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    id: build_session_step_id(state, call.args) ?? return build_session_step_refused(state, call.args)
    step := state.actions[id]
    text: build_session_text(call.args, 1) ?? return build_session_fail(state, "`.arg` takes text")
    if text.trim() == "" {
        return build_session_error_fail(state, BuildSessionError.EmptyActionArgv{value: step.name})
    }
    step.argv.push(text.copy())
    state.actions[id] = step
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// `.timeout(limit)`: the limit's nanoseconds (Duration.ns).
build_session_step_timeout: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    args: call.args
    id: build_session_step_id(state, args) ?? return build_session_step_refused(state, args)
    step := state.actions[id]
    ns: if args.len() > 1 && args[1] == .Int(value) -> value else -> return build_session_fail(state, "`.timeout` takes a Duration")
    if ns < 1_000_000 || ns % 1_000_000 != 0 {
        return build_session_fail(state, "step `{step.name}`'s time limit must be a positive Duration of whole milliseconds, 1ms or more")
    }
    step.timeout_ms = Val(ns /% 1_000_000)
    state.actions[id] = step
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// `.toolchain(t)`: the toolchain the step runs on.
build_session_step_toolchain: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    id: build_session_step_id(state, call.args) ?? return build_session_step_refused(state, call.args)
    step := state.actions[id]
    if state.files[step.tool].kind == "jet" || step.jets.len() > 0 {
        return build_session_fail(state, "step `{step.name}` runs or is passed `b.jet()`, which runs on the toolchain it was built with")
    }
    step.toolchain = build_session_handle(state, call.args[1], "BuildToolchain") ?? return build_session_fail(state, "the step's toolchain does not belong to this build")
    state.actions[id] = step
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// `.sign(identity)`: the identity that signs what the step makes.
build_session_step_sign: fn(state: &BuildSessionState, call: BuildSessionCall) -> BuildSessionReply Never! {
    id: build_session_step_id(state, call.args) ?? return build_session_step_refused(state, call.args)
    step := state.actions[id]
    step.signing = Val(build_session_handle(state, call.args[1], "BuildSigningIdentity") ?? return build_session_fail(state, "the step's signing identity does not belong to this build"))
    state.actions[id] = step
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// The `kept:` value of an output call: the Bool after its path and its
// optional `flag:` text; false when the call doesn't give one.
build_session_kept: fn(args: [BuildSessionValue]) -> Bool Never! {
    loop index in 2..<args.len() {
        if args[index] == .Bool(value) -> return value
    }
    false
}

// An output of `kind` (`b.{method}`): its name, sources and steps, then its
// dependencies, probes, toolchain and signing identity, each `()` when the
// call leaves it out, then one (key, value) pair per setting its
// `options: {settings: ...}` gives (sema_call_build_output), as the setting
// text the package's settings fold reads.
build_session_add_target: fn(state: &BuildSessionState, method: String, kind: String, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() < 3 || (args.len() > 7 && args.len() % 2 == 0) {
        return build_session_fail(state, "`b.{method}` accepts three through seven arguments, then a key and value per setting")
    }
    name: build_session_text(args, 0) ?? return build_session_fail(state, "target name must be a string")
    sources: build_session_strings(args, 1) ?? return build_session_fail(state, "target sources must be strings")
    actions: build_session_handles(state, args, 2, "BuildStepHandle") ?? return build_session_fail(state, "target actions do not belong to this build")
    deps := [Int]{}
    probes := [Int]{}
    toolchain := 0
    signing: if args.len() >= 7 && args[6] != .Unit -> Val(build_session_handle(state, args[6], "BuildSigningIdentity") ?? return build_session_fail(state, "target signing identity does not belong to this build")) else -> None
    if args.len() >= 4 {
        deps = build_session_handles(state, args, 3, "BuildTarget") ?? return build_session_fail(state, "target dependencies do not belong to this build")
    }
    if args.len() >= 5 {
        probes = build_session_handles(state, args, 4, "BuildProbe") ?? return build_session_fail(state, "target probes do not belong to this build")
    }
    if args.len() >= 6 && args[5] != .Unit {
        toolchain = build_session_handle(state, args[5], "BuildToolchain") ?? return build_session_fail(state, "target toolchain does not belong to this build")
    }
    settings := [BuildSettingOverride]{}
    loop at in 7..<args.len() {
        if (at - 7) % 2 == 1 -> next
        key: build_session_text(args, at) ?? return build_session_fail(state, "a setting of `b.{method}` must be named by text")
        value: build_session_setting_text(args[at + 1]) ?? return build_session_fail(state, "setting `{key}` of `b.{method}` must be a Bool, Int, Char, String or enum case")
        settings.push(BuildSettingOverride{name: key, value: value})
    }
    build_session_insert_target(state, BuildSessionTarget{name: name, kind: kind, sources: sources, inputs: [String]{}, outputs: [String]{}, actions: actions, deps: deps, probes: probes, toolchain: toolchain, signing: signing, metadata: [String:String]{}, plugin: None, start: state.start, end: state.end, settings: settings})
}

// A setting's value as the text the package's settings fold reads, as it
// reads a profile's (JetSema sema_fact_build_setting_literal): quoted text
// and characters with `\` escapes, a bare Bool or Int, and `.Case`.
build_session_setting_text: fn(value: BuildSessionValue) -> String? Never! {
    if value == {
        .Text(text) -> Val("\"{text.replace("\\", "\\\\").replace("\"", "\\\"")}\"")
        .Bool(flag) -> Val(if flag -> "true" else -> "false")
        .Int(number) -> Val("{number}")
        .Char(ch) -> Val(if ch == '\\' || ch == '\'' -> "'\\{ch}'" else -> "'{ch}'")
        .Enum(variant) -> Val(".{variant}")
        .Unit | .List(_) | .Handle(_, _, _) | .Span(_, _, _) -> None
    }
}

build_session_insert_target: fn(state: &BuildSessionState, target: BuildSessionTarget) -> BuildSessionReply {
    if target.name.trim() == "" -> return build_session_error_fail(state, .EmptyTargetName)
    loop old in state.targets {
        if old.name == target.name {
            return build_session_error_fail(state, BuildSessionError.DuplicateTargetName{value: target.name})
        }
    }
    loop path in target.sources {
        if build_session_path_error(path) == .Val(error) {
            return build_session_error_fail(state, error)
        }
    }
    loop path in target.inputs {
        if build_session_path_error(path) == .Val(error) {
            return build_session_error_fail(state, error)
        }
    }
    loop path in target.outputs {
        if build_session_path_error(path) == .Val(error) {
            return build_session_error_fail(state, error)
        }
    }
    loop action in target.actions {
        if action < 0 || action >= state.actions.len() {
            return build_session_error_fail(state, BuildSessionError.UnknownAction{id: action})
        }
    }
    loop dep in target.deps {
        if dep < 0 || dep >= state.targets.len() {
            return build_session_error_fail(state, BuildSessionError.UnknownTarget{id: dep})
        }
    }
    loop probe in target.probes {
        if probe < 0 || probe >= state.probes.len() {
            return build_session_error_fail(state, BuildSessionError.UnknownProbe{id: probe})
        }
    }
    if target.toolchain < 0 || target.toolchain >= state.toolchains.len() {
        return build_session_error_fail(state, BuildSessionError.UnknownToolchain{id: target.toolchain})
    }
    if target.signing != None {
        id: target.signing ?? -1
        if id < 0 || id >= state.signing.len() {
            return build_session_error_fail(state, BuildSessionError.UnknownSigningIdentity{id: id})
        }
    }
    id: state.targets.len()
    state.targets.push(target.copy())
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildTarget", session: state.id, id: id}}
}
