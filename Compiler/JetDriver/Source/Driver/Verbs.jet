// Compiler-facing `jet` verbs of the self-hosted driver. Each verb returns the
// exact bytes and exit status the Rust CLI produces for the same input
// (`report_problems_with_summary`, `emit_check_outcome`, `run_explain`), so
// both front doors print one meaning (I9). Writing the bytes and exiting stay
// with the host that owns the process.
use {
    jet_foundation.[
        Diagnostic,
        DiagnosticOrigin,
        SourceFile,
        Span,
        TextEdit,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        diagnostic_explanation,
        diagnostic_explanation_render,
        diagnostic_from_registry,
        diagnostic_render_all,
        diagnostic_without_fix,
        diagnostic_theme_dim,
        sha256_hex,
    ]
    jetpack_foundation.[EXIT_OK, EXIT_USAGE, EXIT_USER_ERROR]
}

JET_DRIVER_EXIT_OK: EXIT_OK
JET_DRIVER_EXIT_USER_ERROR: EXIT_USER_ERROR
JET_DRIVER_EXIT_USAGE: EXIT_USAGE

// A failed verb's typed reports, kept beside the text its stderr renders, so
// a `--json` run answers with them in the `jet.status/v1` envelope instead.
// `notice` is the stderr text that comes before them.
JetDriverFailure: struct {
    reports: [Diagnostic]
    notice: String
}

// `reused`: a build whose image was restored from the store instead of
// written again.
JetDriverVerbOutput: struct {
    stdout: String
    stderr: String
    exit_code: Int
    failure: JetDriverFailure?{None}
    reused: Bool{false}
}

// Accessibility lints that only `jet lint --a11y` shows.
jet_driver_is_a11y_lint: fn(code: String) -> Bool Never! {
    code == "E2930" || code == "E2931"
}

// The one dim teaching pointer after a rendered report.
jet_driver_explain_pointer_line: fn(code: String, color: Bool) -> String Never! {
    diagnostic_theme_dim(color, "run `jet explain {code}` to learn more")
}

// `jet explain <CODE>` for a registered diagnostic code: the essay on stdout,
// or E2104 on stderr when no such code exists. The other explain subjects
// (syntax tokens, build facts, policies, markers, and the `--web-graph` view)
// belong to the CLI (`jet_cli_explain`).
jet_driver_explain_code: fn(code: String?, color: Bool) -> JetDriverVerbOutput Never! {
    if code == .Val(query) {
        if diagnostic_explanation(query) == .Val(explanation) {
            return JetDriverVerbOutput{stdout: diagnostic_explanation_render(explanation, color), stderr: "", exit_code: JET_DRIVER_EXIT_OK}
        }
        report: diagnostic_from_registry(
            "E2104",
            None,
            "no diagnostic code `{query}` exists",
            "Jet needs valid command input before it can run this command",
            "run a command that reports an error to see its code, e.g. `jet check file.jet`",
        )
        return JetDriverVerbOutput{stdout: "", stderr: diagnostic_render_all("", "", [Diagnostic]{report}, color), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    JetDriverVerbOutput{
        stdout: "",
        stderr: "usage: jet explain <CODE|FACT> [file]\n       jet explain marker <file>:<line> <policy-key>\n       jet explain effects [<file>[:<line>]] [--caps] [--json]\n",
        exit_code: JET_DRIVER_EXIT_USAGE,
    }
}

jet_driver_shift_span: fn(span: Span, shift: Int) -> Span Never! {
    Span{start: span.start + shift, end: span.end + shift}
}

// `path` is the diagnostic's display path (`jet_driver_display_path`); a disk
// origin keeps its canonical path beside the display, as the Rust driver's
// origins do. A file of the entry root displays root-relative; a file of
// another root (a dependency package's error, reported inline before its
// E0626) keeps the entry-relative display path, so it names that package.
jet_driver_present_origin: fn(path: String, snapshot: JetDriverAuthorizedSourceSnapshot, generated: [SourceFile]) -> DiagnosticOrigin? Never! {
    loop file in generated {
        if file.path == path -> return Val(DiagnosticOrigin{display: path, path: path, source: file.source, revision: sha256_hex(file.source)})
    }
    physical: jet_driver_physical_path(jet_driver_entry_root_path(snapshot), path)
    loop root in snapshot.roots {
        entry: root.identity == snapshot.entry_root_identity
        loop file in root.files {
            if file.path == physical -> return Val(DiagnosticOrigin{display: if entry -> file.relative_path else -> path, path: physical, source: file.source, revision: sha256_hex(file.source)})
        }
        loop file in root.foreign_cache_files {
            if file.path == physical -> return Val(DiagnosticOrigin{display: file.relative_path, path: physical, source: file.source, revision: sha256_hex(file.source)})
        }
    }
    None
}

// One presented origin per display path for a whole result: every diagnostic
// of a file carries that file's exact bytes, so the file is hashed once, not
// once per diagnostic (the compiler unit is one 12.8 MB file with thousands of
// lints). The Rust driver shares one origin per module the same way.
jet_driver_present_origin_once: fn(path: String, snapshot: JetDriverAuthorizedSourceSnapshot, generated: [SourceFile], origins: &[String:DiagnosticOrigin]) -> DiagnosticOrigin? Never! {
    if origins.get(path) == .Val(origin) -> return Val(origin)
    origin: jet_driver_present_origin(path, snapshot, generated) ?? return None
    origins[path] = origin
    Val(origin)
}

// Project one checked diagnostic onto the file that owns it, the way the
// bootstrap host does: a named source path becomes the origin (root-relative
// display; a generated source shows its path), and the span, edits, and
// labels move from aggregate offsets to offsets in that file's exact bytes.
// An edit that names its own file keeps its span and takes that file's
// physical path; when one can't, the diagnostic keeps no fix.
jet_driver_present_diagnostic: fn(diagnostic: Diagnostic, snapshot: JetDriverAuthorizedSourceSnapshot, generated: [SourceFile], origins: &[String:DiagnosticOrigin]) -> Diagnostic Never! {
    // copy: `presented` is the shifted copy returned for display, while `diagnostic` stays the
    // caller's raw row (a read parameter). Its source_start/offset/span/edit are read below to
    // compute the shift.
    presented := diagnostic.copy()
    path: diagnostic.source_path ?? return jet_driver_present_unplaced(presented)
    if presented.origin == None {
        presented.origin = jet_driver_present_origin_once(path, snapshot, generated, origins)
        if presented.origin == None -> return jet_driver_present_unplaced(presented)
    }
    shift: (diagnostic.source_start ?? 0) - (diagnostic.source_offset ?? 0)
    if diagnostic.span == .Val(span) -> presented.span = Val(jet_driver_shift_span(span, shift))
    placed := true
    if diagnostic.edit == .Val(edit) {
        if jet_driver_present_edit(edit, shift, snapshot, generated, origins) == .Val(moved) {
            presented.edit = Val(moved)
        } else {
            placed = false
        }
    }
    loop index in 0..<diagnostic.fix_edits.len() {
        if jet_driver_present_edit(diagnostic.fix_edits[index], shift, snapshot, generated, origins) == .Val(moved) {
            presented.fix_edits[index] = moved
        } else {
            placed = false
        }
    }
    if !placed -> presented = diagnostic_without_fix(presented)
    loop index in 0..<presented.labels.len() {
        presented.labels[index].span = jet_driver_shift_span(presented.labels[index].span, shift)
    }
    // A cause the checker linked inside one checked body has no origin of
    // its own: it names a report of this same file, so it takes this
    // origin and shift, and the batch's clear counts can match it.
    loop index in 0..<presented.cause.len() {
        if presented.cause[index].origin != None -> next
        presented.cause[index].origin = presented.origin
        if presented.cause[index].span == .Val(cause_span) -> presented.cause[index].span = Val(jet_driver_shift_span(cause_span, shift))
    }
    presented.source_path = None
    presented.source_offset = None
    presented.source_start = None
    presented
}

// A diagnostic with no file of its own keeps no fix that names another one.
jet_driver_present_unplaced: fn(diagnostic: &&Diagnostic) -> Diagnostic Never! {
    named := diagnostic.fix_edits.len() > 0
    if diagnostic.edit == .Val(edit) && edit.path != None -> named = true
    if named -> return diagnostic_without_fix(diagnostic)
    diagnostic
}

// `edit` in its file: shifted by `shift` into the diagnostic's own file, or,
// when it names its file, unshifted with that file's physical path.
jet_driver_present_edit: fn(edit: TextEdit, shift: Int, snapshot: JetDriverAuthorizedSourceSnapshot, generated: [SourceFile], origins: &[String:DiagnosticOrigin]) -> TextEdit? Never! {
    named: edit.path ?? return Val(TextEdit{span: jet_driver_shift_span(edit.span, shift), new_text: edit.new_text})
    origin: jet_driver_present_origin_once(named, snapshot, generated, origins) ?? return None
    Val(TextEdit{span: edit.span, new_text: edit.new_text, path: Val(origin.path)})
}

jet_driver_present_diagnostics: fn(diagnostics: [Diagnostic], snapshot: JetDriverAuthorizedSourceSnapshot, generated: [SourceFile]) -> [Diagnostic] Never! {
    origins := [String:DiagnosticOrigin]{}
    presented: loop diagnostic in diagnostics -> jet_driver_present_diagnostic(diagnostic, snapshot, generated, origins)
    presented
}

// Rendered problems, a blank line, the summary verdict, and the pointer that
// names the first code.
jet_driver_problem_report: fn(file: String, source: String, diagnostics: [Diagnostic], summary: String, color: Bool) -> String Never! {
    if diagnostics.len() == 0 -> return ""
    rendered: diagnostic_render_all(file, source, diagnostics, color)
    pointer: jet_driver_explain_pointer_line(diagnostics[0].code, color)
    "{rendered}\n{summary}\n{pointer}\n"
}

jet_driver_plural: fn(count: Int) -> String Never! {
    if count == 1 -> "" else -> "s"
}

// Front-end problems ending in the "N problems found" count. `run`, `dev`,
// and `test` hide ordinary advisory lints unless `--verbose` asks
// pass `show_advisories` accordingly.
jet_driver_report_problems: fn(file: String, source: String, diagnostics: [Diagnostic], color: Bool, show_advisories: Bool) -> String Never! {
    shown := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if show_advisories || diagnostic.severity != DIAGNOSTIC_LINT -> shown.push(diagnostic.copy())
    }
    count: shown.len()
    jet_driver_problem_report(file, source, shown, "{count} problem{jet_driver_plural(count)} found", color)
}

// `jet check` human output for presented diagnostics: errors fail with the
// problem count; warnings alone end in one `ok:` verdict; a clean check says
// so unless `--quiet`. `file` is the entry as the user named it and `source`
// its bytes, used for any diagnostic that carries no origin of its own.
jet_driver_check_outcome: fn(file: String, source: String, diagnostics: [Diagnostic], color: Bool, quiet: Bool) -> JetDriverVerbOutput Never! {
    errors := [Diagnostic]{}
    lints := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if {
            diagnostic.severity == DIAGNOSTIC_ERROR -> errors.push(diagnostic.copy())
            jet_driver_is_a11y_lint(diagnostic.code) -> {}
            else -> lints.push(diagnostic.copy())
        }
    }
    if errors.len() > 0 {
        return JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, errors, color, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}
    }
    count: lints.len()
    stderr := ""
    if {
        count > 0 -> stderr = jet_driver_problem_report(file, source, lints, "ok: `{file}` has no errors ({count} warning{jet_driver_plural(count)})", color)
        quiet -> {}
        else -> stderr = "ok: `{file}` has no problems\n"
    }
    JetDriverVerbOutput{stdout: "", stderr: stderr, exit_code: JET_DRIVER_EXIT_OK}
}
