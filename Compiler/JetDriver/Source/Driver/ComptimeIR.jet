// Comptime evaluation on the IR machine: a flush's checked closure and the
// item functions of its evaluated entries are built as one slot IR program
// (jet_eval_ir_comptime_build), laid out by the run's staged declaration
// rows, and each entry runs its own item function on it
// (jet_eval_ir_comptime_run) over the runtime pack's IR.
use jet_foundation.[Span, TComptimeValue, TConstantDef, TImplDef, TStmt, TTypeDef, TVisibility]
use jet_sema.[SemaComptimeItemValue, SemaGraphModuleResult]
use jet_ir.[ir_comptime_item_function]
use jet_eval.[JetEvalConfig, JetEvalIRComptime, JetEvalIRResult, jet_eval_ir_comptime_build, jet_eval_ir_comptime_invoke]

// The type, impl and constant rows of every module of a run's graph
// (jet_driver_comptime_stage).
struct JetDriverComptimeRows {
    type_defs: [TTypeDef]
    impls: [TImplDef]
    constants: [TConstantDef]
}

fn jet_driver_comptime_rows_empty() -> JetDriverComptimeRows Never! {
    JetDriverComptimeRows{type_defs: [TTypeDef]{}, impls: [TImplDef]{}, constants: [TConstantDef]{}}
}

fn jet_driver_comptime_rows(modules: [SemaGraphModuleResult]) -> JetDriverComptimeRows Never! {
    rows := jet_driver_comptime_rows_empty()
    loop checked in modules {
        loop definition in checked.declarations.type_defs -> &rows.type_defs.push(definition.copy())
        loop definition in checked.declarations.impls -> &rows.impls.push(definition.copy())
        loop definition in checked.declarations.constants -> &rows.constants.push(definition.copy())
    }
    rows
}

// The IR of `batch`'s evaluated entries from `start` on: the batch's checked
// closure and each entry's item function, a zero-parameter function that
// returns the entry's expression. A batch that reaches no declaration
// (JetDriverComptimeBatch.bare) builds with none; any other lays values out
// by the run's staged rows, after a row for each value landed so far, which
// the builder takes over the staged row of the same key (it keeps a key's
// first row).
fn jet_driver_comptime_ir_build(batch: JetDriverComptimeBatch, start: Int, staging: JetDriverComptimeStaging, values: [SemaComptimeItemValue]) -> JetEvalIRComptime {
    // copy: the batch keeps its closure for a retry one entry at a time
    // (jet_driver_comptime_batch_single).
    functions := batch.functions.copy()
    keys := [String]{}
    loop index in start..<batch.entries.len() {
        entry :: batch.entries[index]
        if entry.plain != None -> next
        item := ir_comptime_item_function(entry.request, entry.request.module_identity)
        item.body = [TStmt]{TStmt.Return{value: Val(entry.request.expression.copy()), span: entry.request.span}}
        &keys.push(item.key.copy())
        &functions.push(^item)
    }
    if batch.bare -> return jet_eval_ir_comptime_build(^functions, keys, [TTypeDef]{}, [TImplDef]{}, [TConstantDef]{})
    constants := [TConstantDef]{}
    loop value in values {
        &constants.push(jet_driver_comptime_value_row(value, value.key))
        if value.destination_key != value.key -> &constants.push(jet_driver_comptime_value_row(value, value.destination_key))
    }
    // copy: the staged rows serve every later build of the run.
    loop definition in staging.rows.constants -> &constants.push(definition.copy())
    jet_eval_ir_comptime_build(^functions, keys, staging.rows.type_defs.copy(), staging.rows.impls.copy(), ^constants)
}

// The constant row of landed value `value` under `key`.
fn jet_driver_comptime_value_row(value: SemaComptimeItemValue, key: String) -> TConstantDef Never! {
    TConstantDef{module_identity: value.module_identity.copy(), key: key.copy(), name: key.copy(), span: Span{start: 0, end: 0}, visibility: TVisibility.Private, ty: value.ty.copy(), is_comptime: true, is_storage: false, value: value.value.copy()}
}

// A fn-build or fn-dev invocation's run (`result`): the checked entry
// function of `inputs`, built as slot IR with the declarations it lays
// values out by, run on its context `args`, the config carrying the
// invocation's build host. Without a result, `problem` says what kept the
// entry from running.
struct JetDriverInvocationRun {
    result: JetEvalIRResult?
    problem: String?
}

fn jet_driver_invocation_run(inputs: ^JetDriverLoweringInputs, args: [TComptimeValue], config: JetEvalConfig, span: Span) -> JetDriverInvocationRun {
    checked := ^inputs
    keys := [String]{}
    if checked.entry_key == .Val(key) -> &keys.push(key.copy())
    if keys.len() == 0 -> return JetDriverInvocationRun{result: None, problem: Val("the checked invocation lost its entry function")}
    declarations := jet_driver_checked_declarations(&checked)
    built := jet_eval_ir_comptime_build(^checked.functions, keys, ^declarations.type_defs, ^declarations.impls, ^declarations.constants)
    if built.build_failures.len() > 0 -> return JetDriverInvocationRun{result: None, problem: Val("the IR builder refused the invocation's code: {built.build_failures.join("; ")}")}
    if built.items[0] < 0 -> return JetDriverInvocationRun{result: None, problem: Val("the IR builder did not build the invocation's entry function")}
    JetDriverInvocationRun{result: Val(jet_eval_ir_comptime_invoke(&built, 0, args, config, span)), problem: None}
}
