// Native comptime: a flush's checked closure and the item functions of its
// evaluated entries are built as one slot IR program, bound to the run's
// declared program (jet_eval_ir_comptime_build_over: the staged declaration
// rows, declared once per run), compiled and loaded once into the session's
// comptime child (jet_eval_native_load), and each entry runs its own item
// function there (jet_eval_native_run).
use jet_foundation.[DeclTable, FnBody, Span, StmtKind, TComptimeValue, TConstantDef, TImplDef, TTargetApplicability, TTypeDef, TVisibility]
use jet_sema.[SemaComptimeItemRequest, SemaComptimeItemValue, SemaGraphModuleResult]
use jet_ir.[IRProgram, IR_STARTUP_FUNCTION_PREFIX, ir_comptime_item_function, ir_program_declared]
use jet_eval.[JetEvalConfig, JetEvalIRComptime, JetEvalIRResult, jet_eval_ir_comptime_build, jet_eval_ir_comptime_build_over, jet_eval_native_load, jet_eval_native_run]

// The declared IR program (ir_program_declared) over the type, impl and
// constant rows of every module of a run's graph (jet_driver_comptime_stage).
fn jet_driver_comptime_declared(modules: [SemaGraphModuleResult]) -> IRProgram Never! {
    type_defs := [TTypeDef]{}
    impls := [TImplDef]{}
    constants := [TConstantDef]{}
    loop checked in modules {
        loop definition in checked.declarations.type_defs -> &type_defs.push(definition.copy())
        loop definition in checked.declarations.impls -> &impls.push(definition.copy())
        loop definition in checked.declarations.constants -> &constants.push(definition.copy())
    }
    ir_program_declared(^type_defs, ^impls, ^constants, [FnBody]{})
}

// The IR of `batch`'s evaluated entries from `start` on: the batch's checked
// closure and each entry's item function, a zero-parameter function that
// returns the entry's expression, whose direct calls name `decls` rows. A
// batch that reaches no declaration (JetDriverComptimeBatch.bare) builds
// with none; any other builds over the run's declared program, whose
// constant rows the values landed since its last build take over first (a
// key's first landed value stands).
fn jet_driver_comptime_ir_build(batch: JetDriverComptimeBatch, start: Int, staging: &JetDriverComptimeStaging, values: [SemaComptimeItemValue], decls: DeclTable) -> JetEvalIRComptime {
    functions := batch.functions.copy()
    keys := [String]{}
    loop index in start..<batch.entries.len() {
        entry :: batch.entries[index]
        if entry.plain != None -> next
        item := ir_comptime_item_function(entry.request, entry.request.module_identity)
        // The request's expression carries its own function-local ids
        // (sema_publish_expression): the item's body returns it.
        item.tree = entry.request.expression.tree.copy()
        &item.tree.stmts.push(StmtKind.Return{value: Val(entry.request.expression.root), span: entry.request.span})
        item.body = [Int]{item.tree.stmts.len() - 1}
        &keys.push(item.key.copy())
        &functions.push(^item)
    }
    if batch.bare -> return jet_eval_ir_comptime_build(^functions, decls, keys, [TTypeDef]{}, [TImplDef]{}, [TConstantDef]{}, true)
    landed := [TConstantDef]{}
    loop index in staging.landed..<values.len() {
        value :: values[index]
        // A startup value has no build-time value; no evaluation reads it
        // (a reader of it is computed at startup too: jet_driver_comptime_demote).
        if value.startup -> next
        &landed.push(jet_driver_comptime_value_row(value, value.key))
        if value.destination_key != value.key -> &landed.push(jet_driver_comptime_value_row(value, value.destination_key))
    }
    staging.landed = values.len()
    jet_eval_ir_comptime_build_over(staging.program.copy(), ^functions, decls, keys, ^landed, &staging.taken)
}

// The constant row of landed value `value` under `key`.
fn jet_driver_comptime_value_row(value: SemaComptimeItemValue, key: String) -> TConstantDef Never! {
    TConstantDef{module_identity: value.module_identity.copy(), key: key.copy(), name: key.copy(), span: Span{start: 0, end: 0}, visibility: TVisibility.Private, ty: value.ty.copy(), is_comptime: true, is_storage: false, value: value.value.copy()}
}

// A fn-build or fn-dev invocation's run (`result`): the checked entry
// function of `inputs`, built as slot IR with the declarations it lays
// values out by, run on its context `args`, the config carrying the
// invocation's build host. Without a result, `problem` says what kept the
// entry from running.
struct JetDriverInvocationRun {
    result: JetEvalIRResult?
    problem: String?
}

fn jet_driver_invocation_run(inputs: ^JetDriverLoweringInputs, args: [TComptimeValue], config: JetEvalConfig, span: Span) -> JetDriverInvocationRun {
    checked := ^inputs
    keys := [String]{}
    if checked.entry_key == .Val(key) -> &keys.push(key.copy())
    if keys.len() == 0 -> return JetDriverInvocationRun{result: None, problem: Val("the checked invocation lost its entry function")}
    declarations := jet_driver_checked_declarations(&checked)
    built := jet_eval_ir_comptime_build(^checked.functions, checked.decls, keys, ^declarations.type_defs, ^declarations.impls, ^declarations.constants, false)
    if built.build_failures.len() > 0 -> return JetDriverInvocationRun{result: None, problem: Val("the IR builder refused the invocation's code: {built.build_failures.join("; ")}")}
    if built.items[0] < 0 -> return JetDriverInvocationRun{result: None, problem: Val("the IR builder did not build the invocation's entry function")}
    program := jet_eval_native_load(^built, config)
    JetDriverInvocationRun{result: Val(jet_eval_native_run(&program, 0, args, config, span)), problem: None}
}

// The startup function of a soft item computed at startup (`request` is its
// startup check, jet_driver_comptime_demote): a zero-parameter function of
// the item's module that returns the item's expression. The program runs it
// once, before `run` (ir_entry_function), and a read of the constant before
// that waits for it (ir_constant). Its effects are its call sites' rows and
// callees, so the application's required authority covers what startup
// reads (jet_driver_required_effects).
fn jet_driver_comptime_startup_function(request: SemaComptimeItemRequest) -> FnBody Never! {
    init := ir_comptime_item_function(request, request.module_identity)
    parts :: request.key.split(":").to_list()
    init.name = "{IR_STARTUP_FUNCTION_PREFIX}{if parts.len() > 0 -> parts[parts.len() - 1] else -> request.key}"
    init.key = "{request.module_identity}::__startup::{request.key}"
    init.target_applicability = TTargetApplicability{rust_aot: true, interpreter: true, web: true}
    init.tree = request.expression.tree.copy()
    &init.tree.stmts.push(StmtKind.Return{value: Val(request.expression.root), span: request.span})
    init.body = [Int]{init.tree.stmts.len() - 1}
    loop fact in request.call_facts {
        if fact.foreign_effect_root == .Val(root) -> jet_driver_comptime_add_name(&init.effects.direct, root)
        if fact.callee == .Val(callee) {
            jet_driver_comptime_add_name(&init.effects.call_edges, callee.key)
            next
        }
        if fact.facts.effect_bound == .Val(row) {
            loop entry in row {
                if !entry.name.starts_with("!") -> jet_driver_comptime_add_name(&init.effects.direct, entry.name)
            }
        }
    }
    init
}

fn jet_driver_comptime_add_name(names: &[String], name: String) Never! {
    loop previous in names {
        if previous == name -> return
    }
    &names.push(name)
}
