// Native physical roots are produced only by the admitted Core getter. Arena
// capabilities are assigned by the checked host transport, never by this code.
use jet_backend.[X64NativeAllocation, core_shared_runtime_call, core_shared_runtime_call_error, core_shared_runtime_allocate, x64_execution_free, x64_value_word]
use jet_eval.JetEvalHostTypeShape

enum JetDriverNativeSharedOwnedSlot {
    PassivePin(address: Int)
    Alias(storage: X64NativeAllocation)
    Guard(address: Int)
    Weak(address: Int)
    Condition(address: Int)
}
struct JetDriverNativeSharedRoot {
    codec: JetDriverNativePayloadCodec
    physical_identity: Int
    passive_pin: JetDriverNativeSharedOwnedSlot
}
struct JetDriverNativeSharedAlias {
    physical_identity: Int
    token: Int
    owned: JetDriverNativeSharedOwnedSlot
}
struct JetDriverNativeSharedIngress {
    root: JetDriverNativeSharedRoot?
    alias: JetDriverNativeSharedAlias?
    refusal_key: String
}

// The generated hook retains only the canonical parent and this plain owned
// slot. It never captures a codec, factory, evaluator, callback or projector.
fn jet_driver_native_shared_owned_release(host: JetDriverCoreSourceParentHost, owned: JetDriverNativeSharedOwnedSlot) -> String {
    if owned == {
        .PassivePin(address) -> core_shared_runtime_call(host.runtime, "jet_rt_shared_pin_drop", 1, address, 0, 0).refusal_key
        .Alias(storage) -> {
            released :: core_shared_runtime_call(host.runtime, "jet_rt_shared_alias_drop", 1, storage.pointer, 0, 0)
            if released.refusal_key != "" -> return released.refusal_key
            x64_execution_free(storage, storage.size, storage.align)
        }
        .Guard(address) -> core_shared_runtime_call(host.runtime, "jet_rt_shared_guard_drop", 1, address, 0, 0).refusal_key
        .Weak(address) -> core_shared_runtime_call(host.runtime, "jet_rt_native_shared_weak_drop", 1, address, 0, 0).refusal_key
        .Condition(address) -> core_shared_runtime_call(host.runtime, "jet_rt_native_condition_drop", 1, address, 0, 0).refusal_key
    }
}

fn jet_driver_native_shared_ingress_refused(key: String) -> JetDriverNativeSharedIngress Never! {
    JetDriverNativeSharedIngress{root: None, alias: None, refusal_key: key}
}

// Getter ownership, Source-carrier alias ownership, and passive pin ownership
// are distinct. Reserve both retained owners before releasing the getter's
// logical owner; a passive pin alone may never resurrect a retired payload.
fn jet_driver_native_shared_slot_ingress(host: &JetDriverCoreSourceParentHost, site_key: String, payload_shape: JetEvalHostTypeShape) -> JetDriverNativeSharedIngress {
    manifest :: jet_driver_core_source_payload_manifest(host) ?? return jet_driver_native_shared_ingress_refused("CoreSharedNotAdmitted")
    type_key := String?{None}
    loop site in manifest.sorted_sites {
        if site.canonical_site_key == site_key -> type_key = Val(site.payload_layout_key)
    }
    key :: type_key ?? return jet_driver_native_shared_ingress_refused("CoreSharedSiteMissing")
    codec :: jet_driver_native_payload_codec(host, manifest, payload_shape, key) ?? return jet_driver_native_shared_ingress_refused("CoreSharedPayloadShapeMismatch: {key}")
    // Check cleanup as well as acquisition before asking the real getter to
    // publish a value. Missing runtime admission cannot leak a getter owner.
    loop (symbol, arity) in ([String:Int]{"jet_rt_shared_owner_pin": 2, "jet_rt_shared_pin_drop": 1, "jet_rt_shared_owner_alias": 2, "jet_rt_shared_alias_token": 1, "jet_rt_shared_alias_drop": 1, "jet_rt_native_shared_drop": 1, "jet_rt_alloc": 2, "jet_rt_free": 3}) {
        error :: core_shared_runtime_call_error(host.runtime, symbol, arity)
        if error != "" -> return jet_driver_native_shared_ingress_refused(error)
    }
    getter :: jet_driver_core_source_parent_getter(&host, site_key)
    if getter.refusal_key != "" -> return jet_driver_native_shared_ingress_refused(getter.refusal_key)
    owner :: getter.shared
    pin_storage :: core_shared_runtime_allocate(host.runtime, 8, 8)
    if pin_storage.refusal_key != "" {
        _ := core_shared_runtime_call(host.runtime, "jet_rt_native_shared_drop", 1, owner, 0, 0)
        return jet_driver_native_shared_ingress_refused(pin_storage.refusal_key)
    }
    pinned :: core_shared_runtime_call(host.runtime, "jet_rt_shared_owner_pin", 2, owner, pin_storage.pointer, 0)
    if pinned.refusal_key != "" || pinned.word != 1 {
        _ := x64_execution_free(pin_storage, pin_storage.size, pin_storage.align)
        _ := core_shared_runtime_call(host.runtime, "jet_rt_native_shared_drop", 1, owner, 0, 0)
        return jet_driver_native_shared_ingress_refused(if pinned.refusal_key != "" -> pinned.refusal_key else -> "CoreSharedNativeOwnerRetired")
    }
    pin :: x64_value_word(pin_storage.pointer)
    _ := x64_execution_free(pin_storage, pin_storage.size, pin_storage.align)
    alias_storage :: core_shared_runtime_allocate(host.runtime, 8, 8)
    if alias_storage.refusal_key != "" {
        _ := core_shared_runtime_call(host.runtime, "jet_rt_shared_pin_drop", 1, pin, 0, 0)
        _ := core_shared_runtime_call(host.runtime, "jet_rt_native_shared_drop", 1, owner, 0, 0)
        return jet_driver_native_shared_ingress_refused(alias_storage.refusal_key)
    }
    reserved :: core_shared_runtime_call(host.runtime, "jet_rt_shared_owner_alias", 2, owner, alias_storage.pointer, 0)
    if reserved.refusal_key != "" || reserved.word != 1 {
        _ := x64_execution_free(alias_storage, alias_storage.size, alias_storage.align)
        _ := core_shared_runtime_call(host.runtime, "jet_rt_shared_pin_drop", 1, pin, 0, 0)
        _ := core_shared_runtime_call(host.runtime, "jet_rt_native_shared_drop", 1, owner, 0, 0)
        return jet_driver_native_shared_ingress_refused(if reserved.refusal_key != "" -> reserved.refusal_key else -> "CoreSharedNativeAliasUnavailable")
    }
    alias :: x64_value_word(alias_storage.pointer)
    token :: core_shared_runtime_call(host.runtime, "jet_rt_shared_alias_token", 1, alias, 0, 0)
    released :: core_shared_runtime_call(host.runtime, "jet_rt_native_shared_drop", 1, owner, 0, 0)
    if token.refusal_key != "" || token.word <= 0 || released.refusal_key != "" {
        _ := jet_driver_native_shared_owned_release(host, JetDriverNativeSharedOwnedSlot.Alias{storage: alias_storage})
        _ := jet_driver_native_shared_owned_release(host, JetDriverNativeSharedOwnedSlot.PassivePin{address: pin})
        return jet_driver_native_shared_ingress_refused(if token.refusal_key != "" -> token.refusal_key else if released.refusal_key != "" -> released.refusal_key else -> "CoreSharedNativeAliasTokenInvalid")
    }
    JetDriverNativeSharedIngress{
        root: Val(JetDriverNativeSharedRoot{codec: codec, physical_identity: owner, passive_pin: JetDriverNativeSharedOwnedSlot.PassivePin{address: pin}}),
        alias: Val(JetDriverNativeSharedAlias{physical_identity: owner, token: token.word, owned: JetDriverNativeSharedOwnedSlot.Alias{storage: alias_storage}}),
        refusal_key: "",
    }
}
