// Use-driven Core loading. A Core module's top-level functions and constants
// count as reached only when the program can name them: a reached declaration
// of the same module spells the name bare, any reached Core code spells it
// after a `.`, or any user source spells it at all. A Core module's private
// import (`collation_table :: __core_text_collation_table`) is followed only
// once reached code spells its alias as a path head (`collation_table.X`), so
// a program that never reaches collation or segmentation never reads, lexes
// or parses their tables. Every other declaration (types, impls, traits,
// marked or compiler-routed `__` functions, and the whole of a runtime unit
// or of a module the compiler demands) is reached with its module.
//
// Spellings are read from the source bytes outside comments, strings
// included, so reach is a superset of what the code names. When the load is
// done, the imports never followed leave their modules, and so does every
// unreached declaration that spells one of their
// aliases as a path head or spells a declaration that left; what stays names
// only what stays, so every tier checks the same closed program.
use {
    jet_foundation.[ImportDecl, Item, NameTable, Span, name_intern, name_intern_bytes, name_table]
    jet_lexer.[TOKEN_BLOCK_COMMENT, TOKEN_LINE_COMMENT, Token]
    jet_sema.[sema_source_word_byte]
}

// What one parsed unit's source spells (jet_driver_unit_words). `words`
// holds each distinct word once; `items` the program.items positions of the
// unit's lazy declarations (jet_driver_reach_lazy_span), in source order;
// `spells` one row per lazy declaration, then a last row for the rest of the
// source. A spelling is `word * 4 + kind`: bit 0 of the kind is set when a
// `.` comes right before the word, bit 1 when one comes right after it.
struct JetDriverUnitWords {
    words: [String]
    items: [Int]
    spells: [[Int]]
}

// The span of a top-level function or constant that a program may leave
// unreached: one with no marker, metadata or compiler role. A `__` name is a
// compiler route (`__unix_connect_entry`, `__measurement_sqrt`) and a
// private part's owned member is reached through its owner's name, so both
// are always reached.
fn jet_driver_reach_lazy_span(item: Item, part_members: [String]) -> Span? Never! {
    if item == {
        .Func(value) -> {
            if value.markers.len() > 0 || value.meta != None || value.external_type != None || value.head_pattern != None || value.is_job || value.every != None || value.kernel != None || value.web_marker != None || value.inline_foreign != None || value.compiler_generated -> return None
            if value.name.starts_with("__") || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        .Const(value) -> {
            if value.markers.len() > 0 || value.meta != None || value.is_persist || value.mutable || value.resolved_output != None -> return None
            if value.name.starts_with("__") || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        else -> None
    }
}

fn jet_driver_reach_item_name(item: Item) -> String Never! {
    if item == {
        .Func(value) -> value.name
        .Const(value) -> value.name
        else -> ""
    }
}

// The words of `source`, a parsed unit's bytes, outside its `comments`
// (jet_driver_comment_spans). With `lazy`, each lazy declaration of `items`
// gets its own row, in source order; a unit whose lazy spans overlap keeps
// every word in the rest row, so all of it is reached.
fn jet_driver_unit_words(source: [U8], comments: [Span], items: [Item], lazy: Bool, part_members: [String]) -> JetDriverUnitWords Never! {
    positions := [Int]{}
    spans := [Span]{}
    if lazy {
        loop (position, item) in items {
            span :: jet_driver_reach_lazy_span(item, part_members) ?? next
            // Insertion by start: program.items is nearly in source order.
            at := spans.len()
            &positions.push(position)
            &spans.push(span)
            loop at > 0 && spans[at - 1].start > span.start {
                spans[at] = spans[at - 1]
                positions[at] = positions[at - 1]
                at -= 1
            }
            spans[at] = span
            positions[at] = position
        }
        loop at in 1..<spans.len() {
            if spans[at].start < spans[at - 1].end {
                positions = [Int]{}
                spans = [Span]{}
                break
            }
        }
    }
    seen := [Int]{}
    rest_seen := [Int]{}
    spells := [[Int]]{}
    rest := [Int]{}
    scan := JetDriverWordScan{table: name_table(), comments: comments, comment: 0}
    cursor := 0
    loop (row, span) in spans {
        jet_driver_spell_words(source, cursor, span.start, &scan, &rest_seen, 1, &rest)
        words := [Int]{}
        jet_driver_spell_words(source, span.start, span.end, &scan, &seen, row + 1, &words)
        &spells.push(^words)
        cursor = span.end
    }
    jet_driver_spell_words(source, cursor, source.len(), &scan, &rest_seen, 1, &rest)
    &spells.push(^rest)
    JetDriverUnitWords{words: scan.table.texts, items: positions, spells: spells}
}

// The comment spans of a unit's tokens, in source order. Comments name no
// code, and a doc comment names its neighbours (`sort by collation_key`),
// so the word scan skips them.
fn jet_driver_comment_spans(tokens: [Token]) -> [Span] Never! {
    spans := [Span]{}
    loop token in tokens {
        if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT -> next
        if spans.len() > 0 && token.span.start < spans[spans.len() - 1].end -> next
        &spans.push(token.span)
    }
    spans
}

// One unit's word scan: the words met so far, and the unit's comments with
// the first one the scan has not passed.
struct JetDriverWordScan {
    table: NameTable
    comments: [Span]
    comment: Int
}

// Appends to `row` each spelling of `source[start..<end]` that `seen` has not
// stamped `stamp` yet: maximal runs of word bytes (sema_source_word_byte)
// that don't start with a digit, outside comments. Calls run in source order.
fn jet_driver_spell_words(source: [U8], start: Int, end: Int, scan: &JetDriverWordScan, seen: &[Int], stamp: Int, row: &[Int]) Never! {
    stop :: if end < source.len() -> end else -> source.len()
    cursor := if start > 0 -> start else -> 0
    loop cursor < stop {
        byte :: source[cursor]
        if !sema_source_word_byte(byte) {
            // Every comment starts with `/`.
            if byte == (U8{47}) {
                loop scan.comment < scan.comments.len() && scan.comments[scan.comment].end <= cursor -> scan.comment += 1
                if scan.comment < scan.comments.len() && scan.comments[scan.comment].start <= cursor {
                    cursor = scan.comments[scan.comment].end
                    next
                }
            }
            cursor += 1
            next
        }
        word_start :: cursor
        loop cursor < stop && sema_source_word_byte(source[cursor]) -> cursor += 1
        if byte >= (U8{48}) && byte <= (U8{57}) -> next
        kind := 0
        if word_start > 0 && source[word_start - 1] == (U8{46}) -> kind = 1
        if cursor < source.len() && source[cursor] == (U8{46}) -> kind += 2
        name :: name_intern_bytes(&scan.table, source, word_start, cursor)
        key :: Int.from_u32(name.id) * 4 + kind
        loop seen.len() <= key -> &seen.push(0)
        if seen[key] == stamp -> next
        seen[key] = stamp
        &row.push(key)
    }
}

// One lazy declaration of a reached module: its module (`unit`), position in
// that module's program.items, name, and spellings (as reach name ids).
struct JetDriverReachItem {
    unit: Int
    item: Int
    name: Int
    spells: [Int]
    live: Bool
}

// One loaded module whose source counts toward reach, at `loaded` in the
// load's modules. An `open` module (user and generated source, the runtime
// entry, a module the compiler demands) reaches every word it spells and
// every declaration it has. `local` holds the names its reached code spells
// bare, `heads` those it spells as a path head.
struct JetDriverReachUnit {
    loaded: Int
    module_name: String
    open: Bool
    local: [Bool]
    heads: [Bool]
}

// A private import a Core module defers until its alias is a reached head.
struct JetDriverReachEdge {
    unit: Int
    scoped: JetDriverScopedImport
    alias: Int
    followed: Bool
}

// The load's reach: one name table for every spelling, the names reached
// after a `.` (or anywhere in open source), and the lazy declarations by name.
struct JetDriverReach {
    enabled: Bool
    names: NameTable
    global: [Bool]
    units: [JetDriverReachUnit]
    items: [JetDriverReachItem]
    by_name: [[Int]]
    edges: [JetDriverReachEdge]
    open_names: [String]
    stack: [Int]
}

fn jet_driver_reach(enabled: Bool) -> JetDriverReach Never! {
    JetDriverReach{enabled: enabled, names: name_table(), global: [Bool]{}, units: [JetDriverReachUnit]{}, items: [JetDriverReachItem]{}, by_name: [[Int]]{}, edges: [JetDriverReachEdge]{}, open_names: [String]{}, stack: [Int]{}}
}

fn jet_driver_reach_has(flags: [Bool], id: Int) -> Bool Never! {
    id < flags.len() && flags[id]
}

// Whether a Core module defers `scoped`: a private, unscoped, aliased import
// of a Core module or a private part that the catalog holds, whose alias no
// member list of the module selects from.
fn jet_driver_reach_deferrable(scoped: JetDriverScopedImport, scoped_imports: [JetDriverScopedImport], core_sources: [JetDriverCoreSource]) -> Bool {
    if scoped.scope != "" || scoped.declaration.is_pub || scoped.declaration.is_package_pub || scoped.declaration.alias == "" -> return false
    if scoped.declaration.kind == .Module(name, _) {
        loop other in scoped_imports {
            if other.declaration.kind == .Unqualified(module_alias, _, _, _, _) && module_alias == scoped.declaration.alias -> return false
        }
        core_name :: jet_driver_core_import_module(scoped.declaration)
        loop row in core_sources {
            if core_name == .Val(module_name) {
                if row.owner == "" && row.module_name == module_name -> return true
            } else if row.owner != "" && row.alias == name {
                return true
            }
        }
    }
    false
}

// Adds the module at `loaded` with what its source spells and returns its
// unit. The names a member list selects are reached wherever it names them.
fn jet_driver_reach_admit(reach: &JetDriverReach, loaded: Int, module_name: String, words: JetDriverUnitWords, items: [Item], imports: [ImportDecl], open: Bool) -> Int {
    unit :: reach.units.len()
    &reach.units.push(JetDriverReachUnit{loaded: loaded, module_name: module_name, open: open || reach.open_names.contains(module_name), local: [Bool]{}, heads: [Bool]{}})
    ids := [Int]{}
    loop word in words.words -> &ids.push(Int.from_u32(name_intern(&reach.names, word).id))
    loop declaration in imports {
        if declaration.kind == .Unqualified(_, _, selected, _, _) {
            loop selected_item in selected {
                selected_name :: Int.from_u32(name_intern(&reach.names, selected_item.original).id)
                jet_driver_reach_global(&reach, selected_name)
            }
        }
    }
    loop (row, position) in words.items {
        name :: Int.from_u32(name_intern(&reach.names, jet_driver_reach_item_name(items[position])).id)
        spells := [Int]{}
        loop spell in words.spells[row] -> &spells.push(ids[spell >> 2] * 4 + spell.bit_and(3))
        index :: reach.items.len()
        &reach.items.push(JetDriverReachItem{unit: unit, item: position, name: name, spells: ^spells, live: false})
        loop reach.by_name.len() <= name -> &reach.by_name.push([Int]{})
        &reach.by_name[name].push(index)
        if reach.units[unit].open || jet_driver_reach_has(reach.global, name) -> &reach.stack.push(index)
    }
    if words.spells.len() > 0 {
        last :: words.spells.len() - 1
        loop spell in words.spells[last] -> jet_driver_reach_mark(&reach, unit, ids[spell >> 2] * 4 + spell.bit_and(3))
    }
    jet_driver_reach_drain(&reach)
    unit
}

// The compiler demands `module_name` (an interpolation selector's formatter,
// a checked `Regex{…}` literal's engine): all of it is reached, now and when
// it loads.
fn jet_driver_reach_open(reach: &JetDriverReach, module_name: String) {
    if !reach.enabled || reach.open_names.contains(module_name) -> return
    &reach.open_names.push(module_name)
    loop unit in 0..<reach.units.len() {
        if reach.units[unit].module_name != module_name || reach.units[unit].open -> next
        reach.units[unit].open = true
        loop index in 0..<reach.items.len() {
            if reach.items[index].unit == unit -> &reach.stack.push(index)
        }
    }
    jet_driver_reach_drain(&reach)
}

// Defers `scoped`, an import of the module at `unit`.
fn jet_driver_reach_defer(reach: &JetDriverReach, unit: Int, scoped: JetDriverScopedImport) {
    alias :: Int.from_u32(name_intern(&reach.names, scoped.declaration.alias).id)
    &reach.edges.push(JetDriverReachEdge{unit: unit, scoped: scoped, alias: alias, followed: false})
}

// Whether reached code of the deferring module now spells the edge's alias as
// a path head.
fn jet_driver_reach_wants(reach: JetDriverReach, edge: Int) -> Bool Never! {
    if reach.edges[edge].followed -> return false
    jet_driver_reach_has(reach.units[reach.edges[edge].unit].heads, reach.edges[edge].alias)
}

fn jet_driver_reach_mark(reach: &JetDriverReach, unit: Int, spell: Int) {
    id :: spell >> 2
    kind :: spell.bit_and(3)
    if reach.units[unit].open || kind.bit_and(1) == 1 {
        jet_driver_reach_global(&reach, id)
    } else {
        jet_driver_reach_local(&reach, unit, id)
    }
    if kind == 2 {
        loop reach.units[unit].heads.len() <= id -> &reach.units[unit].heads.push(false)
        reach.units[unit].heads[id] = true
    }
}

fn jet_driver_reach_global(reach: &JetDriverReach, id: Int) {
    loop reach.global.len() <= id -> &reach.global.push(false)
    if reach.global[id] -> return
    reach.global[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() -> &reach.stack.push(reach.by_name[id][at])
}

fn jet_driver_reach_local(reach: &JetDriverReach, unit: Int, id: Int) {
    loop reach.units[unit].local.len() <= id -> &reach.units[unit].local.push(false)
    if reach.units[unit].local[id] -> return
    reach.units[unit].local[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() {
        index :: reach.by_name[id][at]
        if reach.items[index].unit == unit -> &reach.stack.push(index)
    }
}

// Marks reached every declaration on the stack and what it spells.
fn jet_driver_reach_drain(reach: &JetDriverReach) {
    loop reach.stack.len() > 0 {
        index :: &reach.stack.pop() ?? break
        if reach.items[index].live -> next
        reach.items[index].live = true
        unit :: reach.items[index].unit
        loop at in 0..<reach.items[index].spells.len() -> jet_driver_reach_mark(&reach, unit, reach.items[index].spells[at])
    }
}

// The load is done: drop each never-followed import from its module, then
// every unreached declaration that spells its alias as a path head, or spells
// a dropped declaration (bare in the same module, after a `.` anywhere),
// until no remaining declaration names a dropped one.
fn jet_driver_reach_strip(reach: JetDriverReach, modules: &[JetDriverLoadedModule]) {
    dead := [[Bool]]{}
    dead_imports := [[Span]]{}
    loop _ in reach.units {
        &dead.push([Bool]{})
        &dead_imports.push([Span]{})
    }
    any := false
    loop edge in reach.edges {
        if edge.followed -> next
        any = true
        loop dead[edge.unit].len() <= edge.alias -> &dead[edge.unit].push(false)
        dead[edge.unit][edge.alias] = true
        &dead_imports[edge.unit].push(edge.scoped.declaration.span)
    }
    if !any -> return
    gone := [Bool]{}
    loop _ in reach.items -> &gone.push(false)
    global_gone := [Bool]{}
    local_gone := [[Bool]]{}
    loop _ in reach.units -> &local_gone.push([Bool]{})
    grew := true
    loop grew {
        grew = false
        loop index in 0..<reach.items.len() {
            if reach.items[index].live || gone[index] -> next
            unit :: reach.items[index].unit
            hit := false
            loop spell in reach.items[index].spells {
                id :: spell >> 2
                kind :: spell.bit_and(3)
                if kind == 2 && jet_driver_reach_has(dead[unit], id) -> hit = true
                if kind.bit_and(1) == 0 && jet_driver_reach_has(local_gone[unit], id) -> hit = true
                if kind.bit_and(1) == 1 && jet_driver_reach_has(global_gone, id) -> hit = true
                if hit -> break
            }
            if !hit -> next
            gone[index] = true
            grew = true
            name :: reach.items[index].name
            loop global_gone.len() <= name -> &global_gone.push(false)
            global_gone[name] = true
            loop local_gone[unit].len() <= name -> &local_gone[unit].push(false)
            local_gone[unit][name] = true
        }
    }
    drop := [[Bool]]{}
    loop _ in reach.units -> &drop.push([Bool]{})
    loop index in 0..<reach.items.len() {
        if !gone[index] -> next
        unit :: reach.items[index].unit
        loop drop[unit].len() <= reach.items[index].item -> &drop[unit].push(false)
        drop[unit][reach.items[index].item] = true
    }
    loop unit in 0..<reach.units.len() {
        loaded :: reach.units[unit].loaded
        if dead_imports[unit].len() > 0 {
            imports := [ImportDecl]{}
            loop declaration in modules[loaded].program.imports {
                if !dead_imports[unit].contains(declaration.span) -> &imports.push(declaration)
            }
            modules[loaded].program.imports = ^imports
        }
        if drop[unit].len() == 0 -> next
        items := [Item]{}
        loop position in 0..<modules[loaded].program.items.len() {
            if !jet_driver_reach_has(drop[unit], position) -> &items.push(modules[loaded].program.items[position])
        }
        modules[loaded].program.items = ^items
    }
}
