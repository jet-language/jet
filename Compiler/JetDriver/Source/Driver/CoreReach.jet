// Use-driven Core loading. A Core module's top-level functions and constants
// count as reached only when the program can name them: a reached declaration
// of the same module spells the name bare, any reached Core code spells it
// after a `.`, or any user source spells it at all. A Core module's private
// import (`collation_table: __core_text_collation_table`) is followed only
// once reached code spells its alias as a path head (`collation_table.X`), so
// a program that never reaches collation or segmentation never reads, lexes
// or parses their tables. Runtime units (`core.text.runtime.…`) follow the
// same rule, so a program that only measures UTF-8 never loads the case
// tables. Every other declaration (types, impls, traits, marked functions,
// the functions the compiler calls by a name no program spells, and the
// whole of a module the compiler demands) is reached with its module.
//
// Spellings are read from the unit's tokens outside comments, strings
// included, so reach is a superset of what the code names. When the load is
// done, the imports never followed and the unreached constants leave their
// modules, and so does every unreached declaration that spells one of those
// aliases as a path head or spells a declaration that left; what stays names
// only what stays, so every tier checks the same closed program, and
// comptime evaluates only constants the program can name.
use {
    jet_foundation.[BUILTIN_METHOD_ROWS, CORE_CALLS, CORE_SOURCE_OWNED_ROWS, ImportDecl, Item, NameTable, Span, core_call_source_member, name_intern, name_intern_bytes, name_table]
    jet_ir.[IR_CORE_INTRINSICS, ir_core_lowered_by_name]
    jet_lexer.[TOKEN_BLOCK_COMMENT, TOKEN_CHAR, TOKEN_FLOAT, TOKEN_INT, TOKEN_LINE_COMMENT, TOKEN_RAW_STRING, TOKEN_STRING, Token]
    jet_sema.[sema_call_core_f32_source, sema_source_word_byte]
}

// What one parsed unit's source spells (jet_driver_unit_words). `words`
// holds each distinct word once; `items` the program.items positions of the
// unit's lazy declarations (jet_driver_reach_lazy_span), in source order;
// `spells` one row per lazy declaration, then a last row for the rest of the
// source. A spelling is `word * 4 + kind`: bit 0 of the kind is set when a
// `.` comes right before the word, bit 1 when one comes right after it.
JetDriverUnitWords: struct {
    words: [String]
    items: [Int]
    spells: [[Int]]
}

// The span of a top-level function or constant that a program may leave
// unreached: one with no marker, metadata or compiler role. A compiler route
// (jet_driver_core_route) and a private part's owned member, reached through
// its owner's name, are always reached.
jet_driver_reach_lazy_span: fn(item: Item, part_members: [String], routes: JetDriverCoreRoutes) -> Span? Never! {
    if item == {
        .Func(value) -> {
            if value.markers.len() > 0 || value.meta != None || value.external_type != None || value.head_pattern != None || value.is_job || value.every != None || value.kernel != None || value.web_marker != None || value.inline_foreign != None || value.compiler_generated -> return None
            if jet_driver_core_route(routes, value.name) || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        .Const(value) -> {
            if value.markers.len() > 0 || value.meta != None || value.is_persist || value.mutable || value.resolved_output != None -> return None
            if jet_driver_core_route(routes, value.name) || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// The Core modules whose compiler routes are all rows or rules
// jet_driver_core_route reads from the compiler's route tables. Any other
// module's `__` names stay routes as a group (`__unix_connect_entry`,
// `__measurement_sqrt`). The CoreReach tests hold each `"__…"` literal the
// compiler spells right after one of these module names to a route.
JET_DRIVER_ROUTED_MODULES: [String]{"core.math"}

// What the compiler calls in one Core module without the program spelling it.
// For a routed module, `names` holds its CORE_CALLS `__` members and the
// source targets a row names in place of its member, its BUILTIN_METHOD_ROWS
// CoreSource helpers and its IR_CORE_INTRINSICS rows; jet_driver_core_route
// adds the functions lowering keeps by name and the F32-width sources. A
// row's own public member is called by its spelling.
JetDriverCoreRoutes: struct {
    module_name: String
    routed: Bool
    path: String
    names: [String:Bool]
}

jet_driver_core_routes: fn(module_name: String) -> JetDriverCoreRoutes Never! {
    routes := JetDriverCoreRoutes{module_name: module_name, routed: JET_DRIVER_ROUTED_MODULES.contains(module_name), path: "", names: [String:Bool]{}}
    if !routes.routed -> return routes
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> routes.path = row.path
    }
    loop row in CORE_CALLS {
        if row.module_name == module_name && row.member.starts_with("__") -> routes.names[row.member] = true
        target: core_call_source_member(row) ?? next
        parts := target.split(".").to_list()
        member: parts.pop() ?? next
        owner: if parts.len() > 0 -> parts.join(".") else -> row.module_name
        if owner == module_name && (member != row.member || owner != row.module_name) -> routes.names[member] = true
    }
    loop row in BUILTIN_METHOD_ROWS {
        if row.lowering == .CoreSource(owner, member) {
            if owner == module_name -> routes.names[member] = true
        }
    }
    loop row in IR_CORE_INTRINSICS {
        if row.module_name == module_name -> routes.names[row.name] = true
    }
    routes
}

// Whether the compiler calls `name` of the routes' module by a name no
// program need spell: in a routed module a route row, a function lowering
// keeps by name (ir_core_lowered_by_name: `x.abs()` on a Float runs `fabs`)
// or an F32-width source (sema_call_core_f32_source); in any other module
// every `__` name.
jet_driver_core_route: fn(routes: JetDriverCoreRoutes, name: String) -> Bool Never! {
    if !routes.routed -> return name.starts_with("__")
    if routes.names.get(name) != None || ir_core_lowered_by_name("<corelib>/{routes.module_name}", routes.path, name) -> return true
    if !name.starts_with("__") || !name.ends_with("_f32") -> return false
    sema_call_core_f32_source(routes.module_name, name.slice(2, name.len() - 4)) == Val((name))
}

jet_driver_reach_item_name: fn(item: Item) -> String Never! {
    if item == {
        .Func(value) -> value.name
        .Const(value) -> value.name
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

// The spellings of one lexed unit in source order (jet_driver_unit_spellings):
// `table` holds each distinct word once, and spelling `n` is `keys[n]`
// (`word * 4 + kind`, as in JetDriverUnitWords) at byte `starts[n]`.
JetDriverSpellings: struct {
    table: NameTable
    starts: [Int]
    keys: [Int]
}

// What `tokens`, the lex of `source`, spell outside comments. A token whose
// bytes are all word bytes (sema_source_word_byte: an identifier or a
// keyword) is one word, interned once per lexer name. A whole number spells
// nothing, and a punctuation token (at most three bytes, none a word byte)
// is skipped. Any other token's bytes (a string with its interpolations, a
// unit number) are read as maximal runs of word bytes, so strings spell what
// they hold. A word that starts with a digit spells nothing.
jet_driver_unit_spellings: fn(source: [U8], tokens: [Token]) -> JetDriverSpellings Never! {
    spellings := JetDriverSpellings{table: name_table(), starts: [Int]{}, keys: [Int]{}}
    // Per lexer name id, its word in `spellings.table`, or -1 before.
    local := [Int]{}
    loop token in tokens {
        kind: token.kind
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT || kind == TOKEN_INT || kind == TOKEN_FLOAT -> next
        start: token.span.start
        end: if token.span.end < source.len() -> token.span.end else -> source.len()
        if start >= end -> next
        first: source[start]
        if !sema_source_word_byte(first) {
            if kind == TOKEN_STRING || kind == TOKEN_RAW_STRING || kind == TOKEN_CHAR || end - start > 3 -> jet_driver_spell_span(source, start, end, spellings)
            next
        }
        text: Int.from_u32(token.text.id)
        whole := text > 0 && !(first >= (U8{48}) && first <= (U8{57}))
        cursor := start + 1
        loop whole && cursor < end {
            if !sema_source_word_byte(source[cursor]) -> whole = false
            cursor += 1
        }
        if !whole {
            jet_driver_spell_span(source, start, end, spellings)
            next
        }
        loop local.len() <= text -> local.push(-1)
        if local[text] < 0 -> local[text] = Int.from_u32(name_intern_bytes(spellings.table, source, start, end).id)
        jet_driver_spell_push(source, start, end, local[text], spellings)
    }
    spellings
}

// Each maximal run of word bytes in `source[start..<end]` that doesn't start
// with a digit.
jet_driver_spell_span: fn(source: [U8], start: Int, end: Int, spellings: &JetDriverSpellings) Never! {
    cursor := start
    loop cursor < end {
        if !sema_source_word_byte(source[cursor]) {
            cursor += 1
            next
        }
        word_start: cursor
        loop cursor < end && sema_source_word_byte(source[cursor]) -> cursor += 1
        if source[word_start] >= (U8{48}) && source[word_start] <= (U8{57}) -> next
        word: Int.from_u32(name_intern_bytes(spellings.table, source, word_start, cursor).id)
        jet_driver_spell_push(source, word_start, cursor, word, spellings)
    }
}

// Appends `word`, spelled at `source[start..<end]`, with its kind: bit 0 when
// a `.` comes right before it, bit 1 when one comes right after it.
jet_driver_spell_push: fn(source: [U8], start: Int, end: Int, word: Int, spellings: &JetDriverSpellings) Never! {
    kind := 0
    if start > 0 && source[start - 1] == (U8{46}) -> kind = 1
    if end < source.len() && source[end] == (U8{46}) -> kind += 2
    spellings.starts.push(start)
    spellings.keys.push(word * 4 + kind)
}

// A unit's `spellings` (jet_driver_unit_spellings) by declaration. With
// `lazy`, each lazy declaration of `items` gets its own row, in source order;
// a unit whose lazy spans overlap keeps every spelling in the rest row, so
// all of it is reached.
jet_driver_unit_words: fn(input: &&JetDriverSpellings, items: [Item], lazy: Bool, part_members: [String], routes: JetDriverCoreRoutes) -> JetDriverUnitWords Never! {
    spellings := input.move()
    positions := [Int]{}
    spans := [Span]{}
    if lazy {
        loop (position, item) in items {
            span: jet_driver_reach_lazy_span(item, part_members, routes) ?? next
            // Insertion by start: program.items is nearly in source order.
            at := spans.len()
            positions.push(position)
            spans.push(span.copy())
            loop at > 0 && spans[at - 1].start > span.start {
                spans[at] = spans[at - 1]
                positions[at] = positions[at - 1]
                at -= 1
            }
            spans[at] = span
            positions[at] = position
        }
        loop at in 1..<spans.len() {
            if spans[at].start < spans[at - 1].end {
                positions = [Int]{}
                spans = [Span]{}
                break
            }
        }
    }
    // A row's spelling is kept once: `seen` stamps a key with its lazy row
    // plus one (rows fill in source order), `rest_seen` marks it in the rest.
    seen := [Int]{}
    rest_seen := [Bool]{}
    spells := [[Int]]{}
    loop _ in spans -> spells.push([Int]{})
    rest := [Int]{}
    row := 0
    loop (index, start) in spellings.starts {
        loop row < spans.len() && spans[row].end <= start -> row += 1
        key: spellings.keys[index]
        if row < spans.len() && spans[row].start <= start {
            loop seen.len() <= key -> seen.push(0)
            if seen[key] == row + 1 -> next
            seen[key] = row + 1
            spells[row].push(key)
        } else {
            loop rest_seen.len() <= key -> rest_seen.push(false)
            if rest_seen[key] -> next
            rest_seen[key] = true
            rest.push(key)
        }
    }
    spells.push(rest)
    JetDriverUnitWords{words: spellings.table.texts.move(), items: positions, spells: spells}
}

// One lazy declaration of a reached module: its module (`unit`), position in
// that module's program.items, name, and spellings (as reach name ids).
JetDriverReachItem: struct {
    unit: Int
    item: Int
    name: Int
    spells: [Int]
    live: Bool
}

// One loaded module whose source counts toward reach, at `loaded` in the
// load's modules. An `open` module (user and generated source, the runtime
// entry, a module the compiler demands) reaches every word it spells and
// every declaration it has. `local` holds the names its reached code spells
// bare, `heads` those it spells as a path head.
JetDriverReachUnit: struct {
    loaded: Int
    module_name: String
    open: Bool
    local: [Bool]
    heads: [Bool]
}

// A private import a Core module defers until its alias is a reached head.
JetDriverReachEdge: struct {
    unit: Int
    scoped: JetDriverScopedImport
    alias: Int
    followed: Bool
}

// The load's reach: one name table for every spelling, the names reached
// after a `.` (or anywhere in open source), and the lazy declarations by name.
JetDriverReach: struct {
    enabled: Bool
    names: NameTable
    global: [Bool]
    units: [JetDriverReachUnit]
    items: [JetDriverReachItem]
    by_name: [[Int]]
    edges: [JetDriverReachEdge]
    open_names: [String]
    stack: [Int]
}

jet_driver_reach: fn(enabled: Bool) -> JetDriverReach Never! {
    JetDriverReach{enabled: enabled, names: name_table(), global: [Bool]{}, units: [JetDriverReachUnit]{}, items: [JetDriverReachItem]{}, by_name: [[Int]]{}, edges: [JetDriverReachEdge]{}, open_names: [String]{}, stack: [Int]{}}
}

jet_driver_reach_has: fn(flags: [Bool], id: Int) -> Bool Never! {
    id < flags.len() && flags[id]
}

// Whether a Core module defers `scoped`: a private, unscoped, aliased import
// of a Core module or a private part that the catalog holds, whose alias no
// member list of the module selects from.
jet_driver_reach_deferrable: fn(scoped: JetDriverScopedImport, scoped_imports: [JetDriverScopedImport], core_sources: [JetDriverCoreSource]) -> Bool {
    if scoped.scope != "" || scoped.declaration.is_pub || scoped.declaration.is_package_pub || scoped.declaration.alias == "" -> return false
    if scoped.declaration.kind == .Module(name, _) {
        loop other in scoped_imports {
            if other.declaration.kind == .Unqualified(module_alias, _, _, _, _) && module_alias == scoped.declaration.alias -> return false
        }
        core_name: jet_driver_core_import_module(scoped.declaration)
        loop row in core_sources {
            if core_name == .Val(module_name) {
                if row.owner == "" && row.module_name == module_name -> return true
            } else if row.owner != "" && row.alias == name {
                return true
            }
        }
    }
    false
}

// Adds the module at `loaded` with what its source spells and returns its
// unit. The names a member list selects are reached wherever it names them.
jet_driver_reach_admit: fn(reach: &JetDriverReach, loaded: Int, module_name: String, words: JetDriverUnitWords, items: [Item], imports: [ImportDecl], open: Bool) -> Int {
    unit: reach.units.len()
    reach.units.push(JetDriverReachUnit{loaded: loaded, module_name: module_name, open: open || reach.open_names.contains(module_name), local: [Bool]{}, heads: [Bool]{}})
    ids := [Int]{}
    loop word in words.words -> ids.push(Int.from_u32(name_intern(reach.names, word).id))
    loop declaration in imports {
        if declaration.kind == .Unqualified(_, _, selected, _, _) {
            loop selected_item in selected {
                selected_name: Int.from_u32(name_intern(reach.names, selected_item.original).id)
                jet_driver_reach_global(reach, selected_name)
            }
        }
    }
    loop (row, position) in words.items {
        name: Int.from_u32(name_intern(reach.names, jet_driver_reach_item_name(items[position])).id)
        spells := [Int]{}
        loop spell in words.spells[row] -> spells.push(ids[spell >> 2] * 4 + spell.bit_and(3))
        index: reach.items.len()
        reach.items.push(JetDriverReachItem{unit: unit, item: position, name: name, spells: spells.move(), live: false})
        loop reach.by_name.len() <= name -> reach.by_name.push([Int]{})
        reach.by_name[name].push(index)
        if items[position] == .Const(_) -> jet_driver_reach_case_alias(reach, name, index)
        if reach.units[unit].open || jet_driver_reach_has(reach.global, name) -> reach.stack.push(index)
    }
    if words.spells.len() > 0 {
        last: words.spells.len() - 1
        loop spell in words.spells[last] -> jet_driver_reach_mark(reach, unit, ids[spell >> 2] * 4 + spell.bit_and(3))
    }
    jet_driver_reach_drain(reach)
    unit
}

// A Core constant is also reached by its lowercase spelling: `math.pi` is
// E1004 with the suggestion `PI`, which sema reads from the module's
// constants (sema_expression_core_member_unknown), so the constant stays.
jet_driver_reach_case_alias: fn(reach: &JetDriverReach, name: Int, index: Int) {
    lower: reach.names.texts[name].lower()
    if lower == reach.names.texts[name] -> return
    alias: Int.from_u32(name_intern(reach.names, lower).id)
    loop reach.by_name.len() <= alias -> reach.by_name.push([Int]{})
    reach.by_name[alias].push(index)
    if jet_driver_reach_has(reach.global, alias) -> reach.stack.push(index)
}

// The compiler demands `module_name` (an interpolation selector's formatter,
// a checked `Regex{…}` literal's engine): all of it is reached, now and when
// it loads.
jet_driver_reach_open: fn(reach: &JetDriverReach, module_name: String) {
    if !reach.enabled || reach.open_names.contains(module_name) -> return
    reach.open_names.push(module_name.copy())
    loop unit in 0..<reach.units.len() {
        if reach.units[unit].module_name != module_name || reach.units[unit].open -> next
        reach.units[unit].open = true
        loop index in 0..<reach.items.len() {
            if reach.items[index].unit == unit -> reach.stack.push(index)
        }
    }
    jet_driver_reach_drain(reach)
}

// Defers `scoped`, an import of the module at `unit`.
jet_driver_reach_defer: fn(reach: &JetDriverReach, unit: Int, scoped: JetDriverScopedImport) {
    alias: Int.from_u32(name_intern(reach.names, scoped.declaration.alias).id)
    reach.edges.push(JetDriverReachEdge{unit: unit, scoped: scoped, alias: alias, followed: false})
}

// Whether reached code of the deferring module now spells the edge's alias as
// a path head.
jet_driver_reach_wants: fn(reach: JetDriverReach, edge: Int) -> Bool Never! {
    if reach.edges[edge].followed -> return false
    jet_driver_reach_has(reach.units[reach.edges[edge].unit].heads, reach.edges[edge].alias)
}

jet_driver_reach_mark: fn(reach: &JetDriverReach, unit: Int, spell: Int) {
    id: spell >> 2
    kind: spell.bit_and(3)
    if reach.units[unit].open || kind.bit_and(1) == 1 {
        jet_driver_reach_global(reach, id)
    } else {
        jet_driver_reach_local(reach, unit, id)
    }
    if kind == 2 {
        loop reach.units[unit].heads.len() <= id -> reach.units[unit].heads.push(false)
        reach.units[unit].heads[id] = true
    }
}

jet_driver_reach_global: fn(reach: &JetDriverReach, id: Int) {
    loop reach.global.len() <= id -> reach.global.push(false)
    if reach.global[id] -> return
    reach.global[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() -> reach.stack.push(reach.by_name[id][at])
}

jet_driver_reach_local: fn(reach: &JetDriverReach, unit: Int, id: Int) {
    loop reach.units[unit].local.len() <= id -> reach.units[unit].local.push(false)
    if reach.units[unit].local[id] -> return
    reach.units[unit].local[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() {
        index: reach.by_name[id][at]
        if reach.items[index].unit == unit -> reach.stack.push(index)
    }
}

// Marks reached every declaration on the stack and what it spells.
jet_driver_reach_drain: fn(reach: &JetDriverReach) {
    loop reach.stack.len() > 0 {
        index: reach.stack.pop() ?? break
        if reach.items[index].live -> next
        reach.items[index].live = true
        unit: reach.items[index].unit
        loop at in 0..<reach.items[index].spells.len() -> jet_driver_reach_mark(reach, unit, reach.items[index].spells[at])
    }
}

// The load is done: drop each never-followed import from its module and each
// unreached constant (so comptime evaluates only constants the program can
// name), then every unreached declaration that spells a dropped import's
// alias as a path head, or spells a dropped declaration (bare in the same
// module, after a `.` anywhere), until no remaining declaration names a
// dropped one.
jet_driver_reach_strip: fn(reach: JetDriverReach, modules: &[JetDriverLoadedModule]) {
    dead := [[Bool]]{}
    dead_imports := [[Span]]{}
    loop _ in reach.units {
        dead.push([Bool]{})
        dead_imports.push([Span]{})
    }
    any := false
    loop edge in reach.edges {
        if edge.followed -> next
        any = true
        loop dead[edge.unit].len() <= edge.alias -> dead[edge.unit].push(false)
        dead[edge.unit][edge.alias] = true
        dead_imports[edge.unit].push(edge.scoped.declaration.span)
    }
    gone := [Bool]{}
    loop _ in reach.items -> gone.push(false)
    global_gone := [Bool]{}
    local_gone := [[Bool]]{}
    loop _ in reach.units -> local_gone.push([Bool]{})
    loop index in 0..<reach.items.len() {
        if reach.items[index].live -> next
        unit: reach.items[index].unit
        if modules[reach.units[unit].loaded].program.items[reach.items[index].item] == .Const(_) {
            any = true
            jet_driver_reach_gone(reach, index, gone, global_gone, local_gone)
        }
    }
    if !any -> return
    grew := true
    loop grew {
        grew = false
        loop index in 0..<reach.items.len() {
            if reach.items[index].live || gone[index] -> next
            unit: reach.items[index].unit
            hit := false
            loop spell in reach.items[index].spells {
                id: spell >> 2
                kind: spell.bit_and(3)
                if kind == 2 && jet_driver_reach_has(dead[unit], id) -> hit = true
                if kind.bit_and(1) == 0 && jet_driver_reach_has(local_gone[unit], id) -> hit = true
                if kind.bit_and(1) == 1 && jet_driver_reach_has(global_gone, id) -> hit = true
                if hit -> break
            }
            if !hit -> next
            grew = true
            jet_driver_reach_gone(reach, index, gone, global_gone, local_gone)
        }
    }
    drop := [[Bool]]{}
    loop _ in reach.units -> drop.push([Bool]{})
    loop index in 0..<reach.items.len() {
        if !gone[index] -> next
        unit: reach.items[index].unit
        loop drop[unit].len() <= reach.items[index].item -> drop[unit].push(false)
        drop[unit][reach.items[index].item] = true
    }
    loop unit in 0..<reach.units.len() {
        loaded: reach.units[unit].loaded
        if dead_imports[unit].len() > 0 {
            imports := [ImportDecl]{}
            loop declaration in modules[loaded].program.imports {
                if !dead_imports[unit].contains(declaration.span) -> imports.push(declaration.copy())
            }
            modules[loaded].program.imports = imports.move()
        }
        if drop[unit].len() == 0 -> next
        items := [Item]{}
        loop position in 0..<modules[loaded].program.items.len() {
            if !jet_driver_reach_has(drop[unit], position) -> items.push(modules[loaded].program.items[position])
        }
        modules[loaded].program.items = items.move()
    }
}

// Marks reach item `index` dropped, and its name dropped in its module (bare
// spellings) and everywhere (spellings after a `.`).
jet_driver_reach_gone: fn(reach: JetDriverReach, index: Int, gone: &[Bool], global_gone: &[Bool], local_gone: &[[Bool]]) Never! {
    gone[index] = true
    unit: reach.items[index].unit
    name: reach.items[index].name
    loop global_gone.len() <= name -> global_gone.push(false)
    global_gone[name] = true
    loop local_gone[unit].len() <= name -> local_gone[unit].push(false)
    local_gone[unit][name] = true
}
