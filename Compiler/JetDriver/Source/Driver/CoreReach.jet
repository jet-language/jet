// Use-driven Core loading. A Core module's top-level functions and constants
// count as reached only when the program can name them: a reached declaration
// of the same module spells the name bare, any reached Core code spells it
// after a `.`, or any user source spells it at all. A Core module's private
// import (`collation_table: __core_text_collation_table`) is followed only
// once reached code spells its alias as a path head (`collation_table.X`), so
// a program that never reaches collation or segmentation never reads, lexes
// or parses their tables. Runtime units (`core.text.runtime.…`) follow the
// same rule, so a program that only measures UTF-8 never loads the case
// tables. In a routed module (JET_DRIVER_ROUTED_MODULES) types are reached by
// name too, and so is each inherent method once its type is; an F32-width
// source is reached by its member's name, and a precise family member by its
// type's name as well. Every other declaration (traits, marked functions, the
// functions the compiler calls by a name no program spells, and the whole of
// a module the compiler demands) is reached with its module. What a Core
// module's source demands of another (a `.abs` receiver of core.math, a
// `core.time.X` path of core.time) waits like a private import, until reached
// code of the module spells the word that made it.
//
// Spellings are read from the unit's code tokens, a string's interpolations
// included (its text is data), so reach is a superset of what the code
// names. When the load is done, the imports never followed, the unreached
// constants and every unreached declaration of a routed module leave their
// modules, and so does every unreached declaration that spells one of those
// aliases as a path head or spells a declaration that left; what stays names
// only what stays, so every tier checks the same closed program, and
// comptime evaluates only constants the program can name.
//
// A lazy Core unit parses only what the load may keep: the declarations the
// load drops when the program never reaches them (constants, and a routed
// module's functions) parse once the load is done, and only the reached ones
// (jet_driver_reach_hold), so load time and memory follow reach, not the
// size of the library.
use {
    jet_foundation.[BUILTIN_METHOD_ROWS, CORE_CALLS, CORE_SOURCE_OWNED_ROWS, DIAGNOSTIC_LINT, Diagnostic, Func, ImportDecl, Item, MARKER_HTML, MARKER_NO_PRELUDE, MARKER_POLICY, MARKER_TARGET, NameTable, Span, core_call_source_member, core_module_has_member, diagnostic_with_source_path, name_find, name_intern, name_intern_bytes, name_table, name_text]
    jet_ir.[IR_CORE_INTRINSICS, ir_core_lowered_by_name, ir_precise_source_family_owner]
    jet_lexer.[
        Lexed,
        STRING_PART_INTERPOLATION,
        TOKEN_BLOCK_COMMENT,
        TOKEN_CHAR,
        TOKEN_COLON,
        TOKEN_EOF,
        TOKEN_FENCE_CLOSE,
        TOKEN_FENCE_OPEN,
        TOKEN_FLOAT,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_FN,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LINE_COMMENT,
        TOKEN_LPAREN,
        TOKEN_MINUS,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SEMI,
        TOKEN_STRING,
        TOKEN_UNIT_NUMBER,
        Token,
        TokenTables,
        lex_generated_threads,
        token_synthetic,
    ]
    jet_parser.[parse_lexed_with_source_threads]
    jet_sema.[sema_call_core_f32_source, sema_source_word_byte]
}

// What one parsed unit's source spells (jet_driver_unit_words). `words`
// holds each distinct word once. Each lazy declaration (jet_driver_reach_rows)
// is one row: `items` holds its program.items position, `members` the name
// of the method it is (or "" for a whole item), `owners` the row of the type
// that owns the method (or -1), `names` the name that reaches it, and
// `cascades` whether that name is the one it declares, so that leaving takes
// the name with it. `spells` holds one row of spellings per lazy
// declaration, then a last row for the rest of the source. A spelling is
// `word * 4 + kind`: bit 0 of the kind is set when a `.` comes right before
// the word, bit 1 when one comes right after it. `routed` marks a routed
// module (JET_DRIVER_ROUTED_MODULES), and `held` lists the declarations the
// unit's parse held (jet_driver_reach_hold), by position.
JetDriverUnitWords: struct {
    words: [String]
    items: [Int]
    members: [String]
    owners: [Int]
    names: [String]
    cascades: [Bool]
    spells: [[Int]]
    routed: Bool
    held: [JetDriverReachDeclaration]
}

// A top-level function or constant of a lazy Core unit that reach names by
// name (jet_driver_reach_name_rows): its program.items `position`, its
// `name`, the byte where the name starts, its `span` (with the comments
// before it) and whether it is a `constant`.
JetDriverReachDeclaration: struct {
    position: Int
    name: String
    name_start: Int
    span: Span
    constant: Bool
}

// A lazy Core unit holds back the parse of each top-level declaration that
// the load drops while the program never reaches it: a constant, and in a
// routed module a function. jet_driver_reach_hold finds them in the unit's
// tokens and leaves the stub `name: fn() {}` in each one's place; the reach
// rows give the stub's position the declaration's name, span and
// spellings, so reach sees what the parsed declaration would show it. When
// the load is done, each held declaration reached code names (every one,
// without reach) parses and takes its stub's place
// (jet_driver_reach_parse_held), and the other stubs leave with their rows
// (jet_driver_reach_strip). A function the Core cutover drops leaves the
// tokens outright. A declaration is held only when its own tokens decide
// its parse: it carries no marker and no visibility word, a function no
// type parameters and no variant head and a `{ … }` body, and a constant a
// list, number, string, character or negated value (never a module
// instance's path); and a unit with a fence, an authored `;` or a file rule
// (`#NoPrelude`, `#HTML`, `#Target`, `#Policy`) holds nothing.

// What jet_driver_reach_hold left out of a unit's tokens: the held
// declarations (their positions still -1) and the spans of the dropped
// functions.
JetDriverReachHeld: struct {
    declarations: [JetDriverReachDeclaration]
    dropped: [Span]
}

jet_driver_reach_trivia: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

// The first token of a constant's value that names no module instance.
jet_driver_reach_constant_value: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LBRACKET || kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_STRING || kind == TOKEN_RAW_STRING || kind == TOKEN_CHAR || kind == TOKEN_MINUS
}

// Whether `name` starts with an uppercase letter.
jet_driver_reach_upper: fn(name: String) -> Bool Never! {
    bytes: name.bytes()
    bytes.len() > 0 && bytes[0] >= (U8{65}) && bytes[0] <= (U8{90})
}

// A Pascal-case name (`Point`, `T`): a type's, never a held constant's.
jet_driver_reach_pascal: fn(name: String) -> Bool Never! {
    if !jet_driver_reach_upper(name) -> return false
    bytes: name.bytes()
    if bytes.len() == 1 -> return true
    loop byte in bytes {
        if byte >= (U8{97}) && byte <= (U8{122}) -> return true
    }
    false
}

// Whether the token at `at`, right after a function's `(`, starts a
// variant head (`Circle(r: Float)`, `Empty()`), as the parser reads one.
jet_driver_reach_variant_head: fn(lexed: &Lexed, at: Int) -> Bool Never! {
    if at + 1 >= lexed.tokens.len() || lexed.tokens[at].kind != TOKEN_IDENT -> return false
    after: lexed.tokens[at + 1].kind
    after == TOKEN_LPAREN || (after == TOKEN_RPAREN && jet_driver_reach_upper(name_text(lexed.tables.names, lexed.tokens[at].decoded)))
}

// Holds the declarations of a lazy Core unit's `lexed` tokens (see above)
// and drops each function `cutover_module` hands to the compiler's route
// (a member of its export outside `owned_members`). `part_members` are a
// private part's owned members, which are always reached, and `routes` the
// unit's compiler routes.
jet_driver_reach_hold: fn(lexed: &Lexed, cutover_module: String, owned_members: [String], part_members: [String], routes: JetDriverCoreRoutes) -> JetDriverReachHeld Never! {
    held := JetDriverReachHeld{declarations: [JetDriverReachDeclaration]{}, dropped: [Span]{}}
    file_rules: [String]{MARKER_NO_PRELUDE, MARKER_HTML, MARKER_TARGET, MARKER_POLICY}
    loop rule in file_rules {
        if name_find(lexed.tables.names, rule) != None -> return held
    }
    // Each top-level statement's tokens: from the one after the terminator
    // before it through its own terminator.
    starts := [Int]{}
    ends := [Int]{}
    depth := 0
    start := 0
    loop index in 0..<lexed.tokens.len() {
        kind: lexed.tokens[index].kind
        if kind == TOKEN_FENCE_OPEN || kind == TOKEN_FENCE_CLOSE -> return held
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE -> depth -= 1
        if depth < 0 -> return held
        if kind == TOKEN_SEMI {
            if lexed.tokens[index].span.start < lexed.tokens[index].span.end -> return held
            if depth == 0 {
                starts.push(start)
                ends.push(index + 1)
                start = index + 1
            }
        }
        if kind == TOKEN_EOF {
            if index > start {
                starts.push(start)
                ends.push(index)
            }
            break
        }
    }
    if depth != 0 -> return held
    out := [Token]{}
    cursor := 0
    loop at in 0..<starts.len() {
        from: starts[at]
        to: ends[at]
        code := from
        loop code < to && jet_driver_reach_trivia(lexed.tokens[code].kind) -> code += 1
        if code + 3 >= to || lexed.tokens[code].kind != TOKEN_IDENT || lexed.tokens[code + 1].kind != TOKEN_COLON -> next
        last := to - 1
        loop last > code && (lexed.tokens[last].kind == TOKEN_SEMI || jet_driver_reach_trivia(lexed.tokens[last].kind)) -> last -= 1
        name: name_text(lexed.tables.names, lexed.tokens[code].decoded)
        value: lexed.tokens[code + 2].kind
        function: value == TOKEN_KW_FN && lexed.tokens[code + 3].kind == TOKEN_LPAREN && lexed.tokens[last].kind == TOKEN_RBRACE && !jet_driver_reach_variant_head(lexed, code + 4)
        constant: !function && jet_driver_reach_constant_value(value) && !jet_driver_reach_pascal(name)
        dropped: function && core_module_has_member(cutover_module, name) && !owned_members.contains(name)
        holds: if {
            dropped || part_members.contains(name) -> false
            function -> routes.routed && !(jet_driver_core_route(routes, name) && jet_driver_core_family_owner(routes, name) == None)
            constant -> !jet_driver_core_route(routes, name)
            else -> false
        }
        if !dropped && !holds -> next
        span: Span{start: lexed.tokens[from].span.start, end: lexed.tokens[last].span.end}
        loop index in cursor..<from -> out.push(lexed.tokens[index])
        cursor = to
        if dropped {
            held.dropped.push(span)
            next
        }
        colon: lexed.tokens[code + 1].span.end
        head: Span{start: colon, end: colon}
        out.push(lexed.tokens[code])
        out.push(lexed.tokens[code + 1])
        out.push(token_synthetic(TOKEN_KW_FN, head))
        out.push(token_synthetic(TOKEN_LPAREN, head))
        out.push(token_synthetic(TOKEN_RPAREN, head))
        out.push(token_synthetic(TOKEN_LBRACE, head))
        out.push(token_synthetic(TOKEN_RBRACE, Span{start: span.end, end: span.end}))
        loop index in (last + 1)..<to -> out.push(lexed.tokens[index])
        held.declarations.push(JetDriverReachDeclaration{position: -1, name: name, name_start: lexed.tokens[code].span.start, span: span, constant: constant})
    }
    if cursor == 0 -> return held
    loop index in cursor..<lexed.tokens.len() -> out.push(lexed.tokens[index])
    lexed.tokens = out.move()
    held
}

// A top-level function a program may leave unreached, or a method of a lazy
// type: no marker, metadata or compiler role.
jet_driver_reach_lazy_func: fn(value: Func) -> Bool Never! {
    value.markers.len() == 0 && value.meta == None && value.external_type == None && value.head_pattern == None && !value.is_job && value.every == None && value.kernel == None && value.web_marker == None && value.inline_foreign == None && !value.compiler_generated
}

// The span of a top-level function or constant that a program may leave
// unreached: one with no marker, metadata or compiler role. A compiler route
// (jet_driver_core_route) other than a precise family member
// (jet_driver_core_family_owner) and a private part's owned member, reached
// through its owner's name, are always reached.
jet_driver_reach_lazy_span: fn(item: Item, part_members: [String], routes: JetDriverCoreRoutes) -> Span? Never! {
    if item == {
        .Func(value) -> {
            if !jet_driver_reach_lazy_func(value) -> return None
            if (jet_driver_core_route(routes, value.name) && jet_driver_core_family_owner(routes, value.name) == None) || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        .Const(value) -> {
            if value.markers.len() > 0 || value.meta != None || value.is_persist || value.mutable || value.resolved_output != None -> return None
            if jet_driver_core_route(routes, value.name) || part_members.contains(value.name) -> return None
            Val(value.span)
        }
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// The methods a routed module's lazy type always keeps, beside its `__`
// methods (`__swizzle2`, which the compiler calls by a computed name): every
// inherent method name the compiler spells as a string literal, so a lookup
// by that name (`to_string` for an interpolation, a handle route's `cross`)
// finds it. The CoreReach tests hold each such name of a routed module's
// types to this list. Any other inherent method is reached by its name, and
// trait impl methods are reached with their type.
JET_DRIVER_MEMBER_ROUTES: [String]{
    "abs", "ceil", "cross", "denominator", "dot", "floor", "from_array", "inverse", "is_zero", "lane", "length",
    "matmul", "max", "min", "new", "normalize", "numerator", "point", "point_at_depth", "product", "ray",
    "reduce", "round", "splat", "sqrt", "sum", "then", "to_array", "to_float", "to_string", "transform", "transpose",
}

// The span of a type a routed module's program may leave
// unreached: a struct, enum, distinct type or alias with no marker, schema,
// layout, state or effect role. None for any other item.
jet_driver_reach_lazy_type: fn(item: Item) -> Span? Never! {
    if item == .Struct(value) {
        if value.type_markers.len() > 0 || value.serde_markers.len() > 0 || value.marker != None || value.effect_impl != None || value.cap != None || value.state != None || value.cli_bindings.len() > 0 || value.is_published_schema || value.layout != None || value.validate_span != None || value.compiler_builtin_error -> return None
        return Val(value.span)
    }
    if item == .Enum(value) {
        if value.type_markers.len() > 0 || value.serde_markers.len() > 0 || value.effect_impl != None || value.cap != None || value.groups.len() > 0 -> return None
        return Val(value.span)
    }
    if item == .Distinct(value) {
        if value.type_markers.len() > 0 -> return None
        return Val(value.span)
    }
    if item == .TypeAlias(value) -> return Val(value.span)
    None
}

// A unit's lazy declarations, one row each, in the shape of
// JetDriverUnitWords. In a routed module an F32-width source (`__sin_f32`)
// is reached by its member's name (`sin`), a precise family member
// (`__fraction_add`) by its type's name or its own (two rows with one span),
// a lazy type by its name, each of its inherent methods outside
// JET_DRIVER_MEMBER_ROUTES by its name once the type is, and a top-level
// `impl` for one of its lazy types (`impl Float.Mul(Vec2)`) with that type.
JetDriverReachRows: struct {
    items: [Int]
    members: [String]
    owners: [Int]
    names: [String]
    cascades: [Bool]
    spans: [Span]
}

jet_driver_reach_no_rows: fn() -> JetDriverReachRows Never! {
    JetDriverReachRows{items: [Int]{}, members: [String]{}, owners: [Int]{}, names: [String]{}, cascades: [Bool]{}, spans: [Span]{}}
}

// copy: the names and span stay in the unit's items, which the load keeps.
jet_driver_reach_row: fn(rows: &JetDriverReachRows, position: Int, member: String, owner: Int, name: String, cascade: Bool, span: Span) Never! {
    rows.items.push(position)
    rows.members.push(member.copy())
    rows.owners.push(owner)
    rows.names.push(name.copy())
    rows.cascades.push(cascade)
    rows.spans.push(span.copy())
}

jet_driver_reach_method_rows: fn(rows: &JetDriverReachRows, position: Int, owner: Int, methods: [Func]) Never! {
    loop method in methods {
        if !jet_driver_reach_lazy_func(method) || method.name.starts_with("__") || JET_DRIVER_MEMBER_ROUTES.contains(method.name) -> next
        jet_driver_reach_row(rows, position, method.name, owner, method.name, false, method.span)
    }
}

// A lazy type's row, reached by its name, and a row for each of its methods.
jet_driver_reach_type_rows: fn(rows: &JetDriverReachRows, types: &[String:Bool], position: Int, name: String, methods: [Func], span: Span) Never! {
    // copy: the name stays in the unit's items, which the load keeps.
    types[name.copy()] = true
    owner: rows.items.len()
    jet_driver_reach_row(rows, position, "", -1, name, true, span)
    jet_driver_reach_method_rows(rows, position, owner, methods)
}

// The rows of a top-level declaration reached by name: a precise family
// member is reached by its type's name and its own, an F32-width source by
// its member's, and any other declaration by its own name.
jet_driver_reach_name_rows: fn(rows: &JetDriverReachRows, declaration: JetDriverReachDeclaration, routes: JetDriverCoreRoutes) Never! {
    name: declaration.name
    position: declaration.position
    span: declaration.span
    if jet_driver_core_family_owner(routes, name) == .Val(owner) {
        jet_driver_reach_row(rows, position, "", -1, owner, false, span)
        jet_driver_reach_row(rows, position, "", -1, name, false, span)
    } else if jet_driver_core_f32_member(routes, name) == .Val(member) {
        jet_driver_reach_row(rows, position, "", -1, member, false, span)
    } else {
        jet_driver_reach_row(rows, position, "", -1, name, true, span)
        // A Core constant is also reached by its lowercase spelling:
        // `math.pi` is E1004 with the suggestion `PI`, which sema reads
        // from the module's constants (sema_expression_core_member_unknown).
        if declaration.constant && name.lower() != name -> jet_driver_reach_row(rows, position, "", -1, name.lower(), true, span)
    }
}

// The lazy declarations of `items`; a stub of a `held` declaration
// (jet_driver_reach_hold) gets the declaration's rows.
jet_driver_reach_rows: fn(items: [Item], held: [JetDriverReachDeclaration], part_members: [String], routes: JetDriverCoreRoutes) -> JetDriverReachRows Never! {
    rows := jet_driver_reach_no_rows()
    next_held := 0
    loop (position, item) in items {
        if next_held < held.len() && held[next_held].position == position {
            jet_driver_reach_name_rows(rows, held[next_held], routes)
            next_held += 1
            next
        }
        span: jet_driver_reach_lazy_span(item, part_members, routes) ?? next
        jet_driver_reach_name_rows(rows, JetDriverReachDeclaration{position: position, name: jet_driver_reach_item_name(item), name_start: span.start, span: span, constant: item == .Const(_)}, routes)
    }
    if !routes.routed -> return rows
    types := [String:Bool]{}
    loop (position, item) in items {
        span: jet_driver_reach_lazy_type(item) ?? next
        if item == {
            .Struct(value) -> jet_driver_reach_type_rows(rows, types, position, value.name, value.methods, span)
            .Enum(value) -> jet_driver_reach_type_rows(rows, types, position, value.name, value.methods, span)
            .Distinct(value) -> jet_driver_reach_type_rows(rows, types, position, value.name, [Func]{}, span)
            .TypeAlias(value) -> jet_driver_reach_type_rows(rows, types, position, value.name, [Func]{}, span)
            .Func(_) | .Const(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    loop (position, item) in items {
        if item == .Impl(value) {
            if value.markers.len() > 0 || value.is_generated_serde || value.os_target != None -> next
            if types.get(value.type_name) != None {
                jet_driver_reach_row(rows, position, "", -1, value.type_name, false, value.span)
            } else if value.operator_rhs == .Val(rhs) && rhs == .Named(rhs_name) && types.get(rhs_name) != None {
                jet_driver_reach_row(rows, position, "", -1, rhs_name, false, value.span)
            }
        }
    }
    rows
}

// The Core modules whose compiler routes are all rows or rules
// jet_driver_core_route reads from the compiler's route tables. Any other
// module's `__` names stay routes as a group (`__unix_connect_entry`,
// `__measurement_sqrt`). The CoreReach tests hold each `"__…"` literal the
// compiler spells right after one of these module names to a route.
JET_DRIVER_ROUTED_MODULES: [String]{"core.math"}

// What the compiler calls in one Core module without the program spelling it.
// For a routed module, `names` holds its CORE_CALLS `__` members and the
// source targets a row names in place of its member, its BUILTIN_METHOD_ROWS
// CoreSource helpers and its IR_CORE_INTRINSICS rows; jet_driver_core_route
// adds the functions lowering keeps by name. A row's own public member is
// called by its spelling, and so is its F32-width source
// (jet_driver_core_f32_member).
JetDriverCoreRoutes: struct {
    module_name: String
    routed: Bool
    path: String
    names: [String:Bool]
}

jet_driver_core_routes: fn(module_name: String) -> JetDriverCoreRoutes Never! {
    routes := JetDriverCoreRoutes{module_name: module_name, routed: JET_DRIVER_ROUTED_MODULES.contains(module_name), path: "", names: [String:Bool]{}}
    if !routes.routed -> return routes
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> routes.path = row.path
    }
    loop row in CORE_CALLS {
        if row.module_name == module_name && row.member.starts_with("__") -> routes.names[row.member] = true
        target: core_call_source_member(row) ?? next
        parts := target.split(".").to_list()
        member: parts.pop() ?? next
        owner: if parts.len() > 0 -> parts.join(".") else -> row.module_name
        if owner == module_name && (member != row.member || owner != row.module_name) -> routes.names[member] = true
    }
    loop row in BUILTIN_METHOD_ROWS {
        if row.lowering == .CoreSource(owner, member) {
            if owner == module_name -> routes.names[member] = true
        }
    }
    loop row in IR_CORE_INTRINSICS {
        if row.module_name == module_name -> routes.names[row.name] = true
    }
    routes
}

// Whether the compiler calls `name` of the routes' module by a name no
// program need spell: in a routed module a route row or a function lowering
// keeps by name (ir_core_lowered_by_name: `x.abs()` on a Float runs `fabs`);
// in any other module every `__` name.
jet_driver_core_route: fn(routes: JetDriverCoreRoutes, name: String) -> Bool Never! {
    if !routes.routed -> return name.starts_with("__")
    routes.names.get(name) != None || ir_core_lowered_by_name("<corelib>/{routes.module_name}", routes.path, name)
}

// The member whose F32-width source (sema_call_core_f32_source) `name` is in
// a routed module: `sin` for `__sin_f32`, which a call of `sin` on an F32
// runs.
jet_driver_core_f32_member: fn(routes: JetDriverCoreRoutes, name: String) -> String? Never! {
    if !routes.routed || !name.starts_with("__") || !name.ends_with("_f32") -> return None
    member: name.slice(2, name.len() - 4)
    if sema_call_core_f32_source(routes.module_name, member) != Val((name)) -> return None
    Val(member)
}

// The type whose precise family (ir_precise_source_family_owner) holds
// `name` in a routed module: `Fraction` for `__fraction_add`, which lowering
// runs for any Fraction value.
jet_driver_core_family_owner: fn(routes: JetDriverCoreRoutes, name: String) -> String? Never! {
    if !routes.routed -> return None
    ir_precise_source_family_owner(name)
}

jet_driver_reach_item_name: fn(item: Item) -> String Never! {
    if item == {
        .Func(value) -> value.name
        .Const(value) -> value.name
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

// The spellings of one lexed unit in source order (jet_driver_unit_spellings):
// `table` holds each distinct word once, and spelling `n` is `keys[n]`
// (`word * 4 + kind`, as in JetDriverUnitWords) at byte `starts[n]`.
JetDriverSpellings: struct {
    table: NameTable
    starts: [Int]
    keys: [Int]
}

// What `tokens`, the lex of `source` into `tables`, spell outside comments.
// A token whose bytes are all word bytes (sema_source_word_byte: an
// identifier or a keyword) is one word, interned once per lexer name. A whole
// number spells nothing, and a punctuation token (at most three bytes, none a
// word byte) is skipped. A string spells what its interpolations hold: its
// text, escapes and `\$` template payloads are data, not code. Any other
// token's bytes (a character, a unit number) are read as maximal runs of
// word bytes. A word that starts with a digit spells nothing.
jet_driver_unit_spellings: fn(source: [U8], tokens: [Token], tables: TokenTables) -> JetDriverSpellings Never! {
    spellings := JetDriverSpellings{table: name_table(), starts: [Int]{}, keys: [Int]{}}
    // Per lexer name id, its word in `spellings.table`, or -1 before.
    local := [Int]{}
    loop token in tokens {
        kind: token.kind
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT || kind == TOKEN_INT || kind == TOKEN_FLOAT -> next
        if (kind == TOKEN_STRING || kind == TOKEN_RAW_STRING) && token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION -> jet_driver_spell_span(source, part.span.start, if part.span.end < source.len() -> part.span.end else -> source.len(), spellings)
            }
            next
        }
        start: token.span.start
        end: if token.span.end < source.len() -> token.span.end else -> source.len()
        if start >= end -> next
        // An imaginary literal (`4i`, a number with the suffix `i`) is a
        // core.math Complex, as Sema types it, so it spells `Complex`.
        if kind == TOKEN_UNIT_NUMBER && end - start >= 2 && source[end - 1] == (U8{105}) && source[end - 2] >= (U8{48}) && source[end - 2] <= (U8{57}) {
            complex: Int.from_u32(name_intern(spellings.table, "Complex").id)
            jet_driver_spell_push(source, start, end, complex, spellings)
            next
        }
        first: source[start]
        if !sema_source_word_byte(first) {
            if kind == TOKEN_STRING || kind == TOKEN_RAW_STRING || kind == TOKEN_CHAR || end - start > 3 -> jet_driver_spell_span(source, start, end, spellings)
            next
        }
        text: Int.from_u32(token.text.id)
        whole := text > 0 && !(first >= (U8{48}) && first <= (U8{57}))
        cursor := start + 1
        loop whole && cursor < end {
            if !sema_source_word_byte(source[cursor]) -> whole = false
            cursor += 1
        }
        if !whole {
            jet_driver_spell_span(source, start, end, spellings)
            next
        }
        loop local.len() <= text -> local.push(-1)
        if local[text] < 0 -> local[text] = Int.from_u32(name_intern_bytes(spellings.table, source, start, end).id)
        jet_driver_spell_push(source, start, end, local[text], spellings)
    }
    spellings
}

// Each maximal run of word bytes in `source[start..<end]` that doesn't start
// with a digit.
jet_driver_spell_span: fn(source: [U8], start: Int, end: Int, spellings: &JetDriverSpellings) Never! {
    cursor := start
    loop cursor < end {
        if !sema_source_word_byte(source[cursor]) {
            cursor += 1
            next
        }
        word_start: cursor
        loop cursor < end && sema_source_word_byte(source[cursor]) -> cursor += 1
        if source[word_start] >= (U8{48}) && source[word_start] <= (U8{57}) -> next
        word: Int.from_u32(name_intern_bytes(spellings.table, source, word_start, cursor).id)
        jet_driver_spell_push(source, word_start, cursor, word, spellings)
    }
}

// Appends `word`, spelled at `source[start..<end]`, with its kind: bit 0 when
// a `.` comes right before it, bit 1 when one comes right after it.
jet_driver_spell_push: fn(source: [U8], start: Int, end: Int, word: Int, spellings: &JetDriverSpellings) Never! {
    kind := 0
    if start > 0 && source[start - 1] == (U8{46}) -> kind = 1
    if end < source.len() && source[end] == (U8{46}) -> kind += 2
    spellings.starts.push(start)
    spellings.keys.push(word * 4 + kind)
}

// The positions of `spans` by start, by insertion: spans come nearly in
// source order.
jet_driver_span_order: fn(spans: [Span]) -> [Int] Never! {
    order := [Int]{}
    loop at in 0..<spans.len() {
        slot := order.len()
        order.push(at)
        loop slot > 0 && spans[order[slot - 1]].start > spans[at].start {
            order[slot] = order[slot - 1]
            slot -= 1
        }
        order[slot] = at
    }
    order
}

// A unit's `spellings` (jet_driver_unit_spellings) by declaration. With
// `lazy`, each lazy declaration of `items` (jet_driver_reach_rows, the
// `held` ones included) gets its own row, and a spelling belongs to the
// innermost row around it, so a method's spellings are its own and not its
// type's. A unit whose lazy spans cross (neither nested nor apart) keeps
// every spelling in the rest row, so all of it is reached. A spelling inside
// one of the `quiet` spans (the unit's imports, and the declarations its
// program leaves out) counts for nothing.
jet_driver_unit_words: fn(input: &&JetDriverSpellings, items: [Item], held: [JetDriverReachDeclaration], quiet: [Span], lazy: Bool, part_members: [String], routes: JetDriverCoreRoutes) -> JetDriverUnitWords Never! {
    spellings := input.move()
    rows := if lazy -> jet_driver_reach_rows(items, held, part_members, routes) else -> jet_driver_reach_no_rows()
    order := jet_driver_span_order(rows.spans)
    hush: jet_driver_span_order(quiet)
    // `open[0..<depth]` holds the rows around the current byte, outermost
    // first.
    open := [Int]{}
    depth := 0
    crossed := false
    loop row in order {
        loop depth > 0 && rows.spans[open[depth - 1]].end <= rows.spans[row].start -> depth -= 1
        if depth > 0 && rows.spans[row].end > rows.spans[open[depth - 1]].end {
            crossed = true
            break
        }
        if depth < open.len() -> open[depth] = row else -> open.push(row)
        depth += 1
    }
    if crossed {
        rows = jet_driver_reach_no_rows()
        order = [Int]{}
    }
    // A row's spelling is kept once in a run of it: `seen` stamps a key with
    // its row plus one (a type's row resumes after each of its methods, so a
    // key may repeat there), `rest_seen` marks it in the rest.
    seen := [Int]{}
    rest_seen := [Bool]{}
    spells := [[Int]]{}
    loop _ in rows.spans -> spells.push([Int]{})
    rest := [Int]{}
    depth = 0
    next_row := 0
    next_quiet := 0
    loop (index, start) in spellings.starts {
        loop next_quiet < hush.len() && quiet[hush[next_quiet]].end <= start -> next_quiet += 1
        if next_quiet < hush.len() && quiet[hush[next_quiet]].start <= start -> next
        loop next_row < order.len() && rows.spans[order[next_row]].start <= start {
            row: order[next_row]
            loop depth > 0 && rows.spans[open[depth - 1]].end <= rows.spans[row].start -> depth -= 1
            if depth < open.len() -> open[depth] = row else -> open.push(row)
            depth += 1
            next_row += 1
        }
        loop depth > 0 && rows.spans[open[depth - 1]].end <= start -> depth -= 1
        key: spellings.keys[index]
        if depth > 0 {
            row: open[depth - 1]
            loop seen.len() <= key -> seen.push(0)
            if seen[key] == row + 1 -> next
            seen[key] = row + 1
            spells[row].push(key)
        } else {
            loop rest_seen.len() <= key -> rest_seen.push(false)
            if rest_seen[key] -> next
            rest_seen[key] = true
            rest.push(key)
        }
    }
    // The rows of one declaration (a precise family member's two names)
    // spell the same; its spellings went to its last row.
    loop row in 1..<rows.items.len() {
        // copy: each row's reach item holds its own spellings.
        if rows.items[row - 1] == rows.items[row] && rows.members[row - 1] == rows.members[row] -> spells[row - 1] = spells[row].copy()
    }
    spells.push(rest)
    JetDriverUnitWords{words: spellings.table.texts.move(), items: rows.items.move(), members: rows.members.move(), owners: rows.owners.move(), names: rows.names.move(), cascades: rows.cascades.move(), spells: spells, routed: routes.routed, held: held}
}

// One lazy declaration of a reached module: its module (`unit`), position in
// that module's program.items, the method it is (`member`, "" for a whole
// item), name, whether its name leaves with it (`cascade`), and spellings
// (as reach name ids). A method's `owner` is the reach item of its type (or
// -1): it is reached only once its type is, and `wanted` marks one whose
// name was reached first, which its type's `children` then reach. A `held`
// one is the stub of a declaration its unit's parse held
// (jet_driver_reach_hold).
JetDriverReachItem: struct {
    unit: Int
    item: Int
    member: String
    owner: Int
    children: [Int]
    wanted: Bool
    name: Int
    cascade: Bool
    spells: [Int]
    live: Bool
    held: Bool
}

// One loaded module whose source counts toward reach, at `loaded` in the
// load's modules. An `open` module (user and generated source, the runtime
// entry, a module the compiler demands) reaches every word it spells and
// every declaration it has. `local` holds the names its reached code spells
// bare, `dotted` those it spells after a `.`, `heads` those it spells as a
// path head. A `routed` module leaves every unreached lazy declaration.
JetDriverReachUnit: struct {
    loaded: Int
    module_name: String
    open: Bool
    routed: Bool
    local: [Bool]
    dotted: [Bool]
    heads: [Bool]
}

// A private import a Core module defers until its alias is a reached head.
JetDriverReachEdge: struct {
    unit: Int
    scoped: JetDriverScopedImport
    alias: Int
    followed: Bool
}

// What a Core module's source demands of another Core module
// (JetDriverCoreIdentifierDemand: a `.abs` receiver loads core.math, a
// `core.time.X` path core.time) waits, as a private import does, until
// reached code of the demanding module spells the `word` that made it,
// after a `.` when `dotted`. Then `module_name` loads, joining the load's
// bare modules when `bare` and reached whole when `open`.
JetDriverReachDemand: struct {
    unit: Int
    word: Int
    dotted: Bool
    module_name: String
    bare: Bool
    open: Bool
    followed: Bool
}

// The load's reach: one name table for every spelling, the names reached
// after a `.` (or anywhere in open source), the names any Core module that
// keeps its unreached code spells after a `.` (`members`, which reach a
// routed module's methods), and the lazy declarations by name.
JetDriverReach: struct {
    enabled: Bool
    names: NameTable
    global: [Bool]
    members: [Bool]
    units: [JetDriverReachUnit]
    items: [JetDriverReachItem]
    by_name: [[Int]]
    edges: [JetDriverReachEdge]
    demands: [JetDriverReachDemand]
    open_names: [String]
    stack: [Int]
}

jet_driver_reach: fn(enabled: Bool) -> JetDriverReach Never! {
    JetDriverReach{enabled: enabled, names: name_table(), global: [Bool]{}, members: [Bool]{}, units: [JetDriverReachUnit]{}, items: [JetDriverReachItem]{}, by_name: [[Int]]{}, edges: [JetDriverReachEdge]{}, demands: [JetDriverReachDemand]{}, open_names: [String]{}, stack: [Int]{}}
}

jet_driver_reach_has: fn(flags: [Bool], id: Int) -> Bool Never! {
    id < flags.len() && flags[id]
}

// Whether a Core module defers `scoped`: a private, unscoped, aliased import
// of a Core module or a private part that the catalog holds, whose alias no
// member list of the module selects from.
jet_driver_reach_deferrable: fn(scoped: JetDriverScopedImport, scoped_imports: [JetDriverScopedImport], core_sources: [JetDriverCoreSource]) -> Bool {
    if scoped.scope != "" || scoped.declaration.is_pub || scoped.declaration.is_package_pub || scoped.declaration.alias == "" -> return false
    if scoped.declaration.kind == .Module(name, _) {
        loop other in scoped_imports {
            if other.declaration.kind == .Unqualified(module_alias, _, _, _, _) && module_alias == scoped.declaration.alias -> return false
        }
        core_name: jet_driver_core_import_module(scoped.declaration)
        loop row in core_sources {
            if core_name == .Val(module_name) {
                if row.owner == "" && row.module_name == module_name -> return true
            } else if row.owner != "" && row.alias == name {
                return true
            }
        }
    }
    false
}

// Adds the module at `loaded` with what its source spells and returns its
// unit. The names a member list selects are reached wherever it names them.
// A Core module that keeps its unreached code may call a routed module's
// method from it, so each name it spells after a `.` reaches such methods.
jet_driver_reach_admit: fn(reach: &JetDriverReach, loaded: Int, module_name: String, words: JetDriverUnitWords, imports: [ImportDecl], open: Bool) -> Int {
    unit: reach.units.len()
    reach.units.push(JetDriverReachUnit{loaded: loaded, module_name: module_name, open: open || reach.open_names.contains(module_name), routed: words.routed, local: [Bool]{}, dotted: [Bool]{}, heads: [Bool]{}})
    ids := [Int]{}
    loop word in words.words -> ids.push(Int.from_u32(name_intern(reach.names, word).id))
    loop declaration in imports {
        if declaration.kind == .Unqualified(_, _, selected, _, _) {
            loop selected_item in selected {
                selected_name: Int.from_u32(name_intern(reach.names, selected_item.original).id)
                jet_driver_reach_global(reach, selected_name)
            }
        }
    }
    held := [Bool]{}
    loop declaration in words.held {
        loop held.len() <= declaration.position -> held.push(false)
        held[declaration.position] = true
    }
    base: reach.items.len()
    loop (row, position) in words.items {
        name: Int.from_u32(name_intern(reach.names, words.names[row]).id)
        spells := [Int]{}
        loop spell in words.spells[row] -> spells.push(ids[spell >> 2] * 4 + spell.bit_and(3))
        index: reach.items.len()
        owner: if words.owners[row] >= 0 -> base + words.owners[row] else -> -1
        // copy: the unit's words stay whole for its other rows.
        reach.items.push(JetDriverReachItem{unit: unit, item: position, member: words.members[row].copy(), owner: owner, children: [Int]{}, wanted: false, name: name, cascade: words.cascades[row], spells: spells.move(), live: false, held: jet_driver_reach_has(held, position)})
        if owner >= 0 -> reach.items[owner].children.push(index)
        loop reach.by_name.len() <= name -> reach.by_name.push([Int]{})
        reach.by_name[name].push(index)
        if reach.units[unit].open || jet_driver_reach_has(reach.global, name) || (owner >= 0 && jet_driver_reach_has(reach.members, name)) -> reach.stack.push(index)
    }
    if !words.routed && !reach.units[unit].open {
        loop row in words.spells {
            loop spell in row {
                if spell.bit_and(1) == 1 -> jet_driver_reach_member(reach, ids[spell >> 2])
            }
        }
    }
    if words.spells.len() > 0 {
        last: words.spells.len() - 1
        loop spell in words.spells[last] -> jet_driver_reach_mark(reach, unit, ids[spell >> 2] * 4 + spell.bit_and(3))
    }
    jet_driver_reach_drain(reach)
    unit
}

// Reaches each method named `id`.
jet_driver_reach_member: fn(reach: &JetDriverReach, id: Int) {
    loop reach.members.len() <= id -> reach.members.push(false)
    if reach.members[id] -> return
    reach.members[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() {
        index: reach.by_name[id][at]
        if reach.items[index].owner >= 0 -> reach.stack.push(index)
    }
}

// The compiler demands `module_name` (an interpolation selector's formatter,
// a checked `Regex{…}` literal's engine): all of it is reached, now and when
// it loads. A routed module's routes already hold what the compiler calls in
// it (a CoreSource method's helper), so it stays reached by use.
jet_driver_reach_open: fn(reach: &JetDriverReach, module_name: String) {
    if !reach.enabled || reach.open_names.contains(module_name) || JET_DRIVER_ROUTED_MODULES.contains(module_name) -> return
    reach.open_names.push(module_name.copy())
    loop unit in 0..<reach.units.len() {
        if reach.units[unit].module_name != module_name || reach.units[unit].open -> next
        reach.units[unit].open = true
        loop index in 0..<reach.items.len() {
            if reach.items[index].unit == unit -> reach.stack.push(index)
        }
    }
    jet_driver_reach_drain(reach)
}

// Defers `scoped`, an import of the module at `unit`.
jet_driver_reach_defer: fn(reach: &JetDriverReach, unit: Int, scoped: JetDriverScopedImport) {
    alias: Int.from_u32(name_intern(reach.names, scoped.declaration.alias).id)
    reach.edges.push(JetDriverReachEdge{unit: unit, scoped: scoped, alias: alias, followed: false})
}

// Whether reached code of the deferring module now spells the edge's alias as
// a path head.
jet_driver_reach_wants: fn(reach: JetDriverReach, edge: Int) -> Bool Never! {
    if reach.edges[edge].followed -> return false
    jet_driver_reach_has(reach.units[reach.edges[edge].unit].heads, reach.edges[edge].alias)
}

// Defers what the source of the Core module at `unit` demands
// (JetDriverReachDemand): each demand of `demand` that one word spells, and
// each qualified path `path_words[n]` names, whose module is
// `path_modules[n]`. An interpolation selector and a unit conversion load
// their module with the demanding one (Loader.jet).
jet_driver_reach_core_demands: fn(reach: &JetDriverReach, unit: Int, demand: JetDriverCoreIdentifierDemand, path_words: [String], path_modules: [String]) {
    if demand.math_receiver {
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "abs"), dotted: true, module_name: "core.math", bare: true, open: false, followed: false})
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "pow"), dotted: true, module_name: "core.math", bare: true, open: false, followed: false})
    }
    loop module_name in demand.source_modules {
        if module_name == "core.regex" -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "Regex"), dotted: false, module_name: module_name.copy(), bare: true, open: true, followed: false})
        if module_name == "core.time" -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "timeout"), dotted: true, module_name: module_name.copy(), bare: true, open: true, followed: false})
        loop row in BUILTIN_METHOD_ROWS {
            if row.lowering == .CoreSource(owner, _) {
                if owner == module_name -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, row.name), dotted: true, module_name: module_name.copy(), bare: true, open: true, followed: false})
            }
        }
    }
    if demand.test_suite {
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "suite"), dotted: true, module_name: "core.testing", bare: true, open: true, followed: false})
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "expect"), dotted: false, module_name: "core.testing", bare: true, open: true, followed: false})
    }
    if demand.stream_event_time -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "with_event_time"), dotted: true, module_name: "core.data", bare: true, open: true, followed: false})
    if demand.codec_decode {
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "decode"), dotted: true, module_name: "core.encoding", bare: false, open: true, followed: false})
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "under"), dotted: true, module_name: "core.encoding", bare: false, open: true, followed: false})
        reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "migration"), dotted: false, module_name: "core.encoding", bare: false, open: true, followed: false})
    }
    if demand.option_or_err -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, "or_err"), dotted: false, module_name: "core.prelude", bare: false, open: true, followed: false})
    loop at in 0..<path_words.len() -> reach.demands.push(JetDriverReachDemand{unit: unit, word: jet_driver_reach_word(reach, path_words[at]), dotted: true, module_name: path_modules[at].copy(), bare: false, open: false, followed: false})
}

// The id of `word` in the reach's name table.
jet_driver_reach_word: fn(reach: &JetDriverReach, word: String) -> Int {
    Int.from_u32(name_intern(reach.names, word).id)
}

// Whether reached code of the demanding module now spells the demand's word
// (all of an open module is reached).
jet_driver_reach_demand_wants: fn(reach: JetDriverReach, at: Int) -> Bool Never! {
    if reach.demands[at].followed -> return false
    unit: reach.demands[at].unit
    word: reach.demands[at].word
    reach.units[unit].open || jet_driver_reach_has(reach.units[unit].dotted, word) || (!reach.demands[at].dotted && jet_driver_reach_has(reach.units[unit].local, word))
}

// Marks followed demand `at` and every other demand of its module for the
// same module, which now loads.
jet_driver_reach_demand_follow: fn(reach: &JetDriverReach, at: Int) {
    loop other in 0..<reach.demands.len() {
        if reach.demands[other].unit == reach.demands[at].unit && reach.demands[other].module_name == reach.demands[at].module_name && reach.demands[other].open == reach.demands[at].open -> reach.demands[other].followed = true
    }
}

// How many of the load's lazy Core declarations are reached.
jet_driver_reach_items_reached: fn(reach: JetDriverReach) -> Int Never! {
    count := 0
    loop item in reach.items {
        if item.live -> count += 1
    }
    count
}

jet_driver_reach_mark: fn(reach: &JetDriverReach, unit: Int, spell: Int) {
    id: spell >> 2
    kind: spell.bit_and(3)
    if reach.units[unit].open || kind.bit_and(1) == 1 {
        jet_driver_reach_global(reach, id)
    } else {
        jet_driver_reach_local(reach, unit, id)
    }
    if kind.bit_and(1) == 1 {
        loop reach.units[unit].dotted.len() <= id -> reach.units[unit].dotted.push(false)
        reach.units[unit].dotted[id] = true
    }
    if kind == 2 {
        loop reach.units[unit].heads.len() <= id -> reach.units[unit].heads.push(false)
        reach.units[unit].heads[id] = true
    }
}

jet_driver_reach_global: fn(reach: &JetDriverReach, id: Int) {
    loop reach.global.len() <= id -> reach.global.push(false)
    if reach.global[id] -> return
    reach.global[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() -> reach.stack.push(reach.by_name[id][at])
}

jet_driver_reach_local: fn(reach: &JetDriverReach, unit: Int, id: Int) {
    loop reach.units[unit].local.len() <= id -> reach.units[unit].local.push(false)
    if reach.units[unit].local[id] -> return
    reach.units[unit].local[id] = true
    if id >= reach.by_name.len() -> return
    loop at in 0..<reach.by_name[id].len() {
        index: reach.by_name[id][at]
        if reach.items[index].unit == unit -> reach.stack.push(index)
    }
}

// Marks reached every declaration on the stack and what it spells. A method
// whose type is not reached waits for it.
jet_driver_reach_drain: fn(reach: &JetDriverReach) {
    loop reach.stack.len() > 0 {
        index: reach.stack.pop() ?? break
        if reach.items[index].live -> next
        owner: reach.items[index].owner
        if owner >= 0 && !reach.items[owner].live {
            reach.items[index].wanted = true
            next
        }
        reach.items[index].live = true
        unit: reach.items[index].unit
        loop at in 0..<reach.items[index].spells.len() -> jet_driver_reach_mark(reach, unit, reach.items[index].spells[at])
        loop at in 0..<reach.items[index].children.len() {
            child: reach.items[index].children[at]
            if reach.items[child].wanted -> reach.stack.push(child)
        }
    }
}

// A lazy Core module's held declarations (jet_driver_reach_hold), at
// `loaded` in the load's modules.
JetDriverReachHeldModule: struct {
    loaded: Int
    declarations: [JetDriverReachDeclaration]
}

// The load is done: each held declaration that reached code names (every
// one, without reach) parses from its module's source, with every other
// byte blanked so its spans stay the source's, and takes its stub's place;
// the parse's side tables join the module's. Returns how many parsed, or -1
// when a parse failed (its diagnostics are in `diagnostics`).
jet_driver_reach_parse_held: fn(request: JetDriverCompileRequest, reach: JetDriverReach, held: [JetDriverReachHeldModule], modules: &[JetDriverLoadedModule], source_units: [JetDriverSourceUnit], diagnostics: &[Diagnostic]) -> Int {
    // Per loaded module, the program.items positions of its reached rows.
    reached := [[Bool]]{}
    loop _ in modules -> reached.push([Bool]{})
    loop item in reach.items {
        if !item.live -> next
        loaded: reach.units[item.unit].loaded
        loop reached[loaded].len() <= item.item -> reached[loaded].push(false)
        reached[loaded][item.item] = true
    }
    count := 0
    failed := false
    loop row in held {
        unit: source_units[modules[row.loaded].source_unit_index]
        text: jet_driver_source_unit_text(request, unit) ?? next
        source := text.bytes()
        positions := [Int]{}
        cursor := 0
        loop declaration in row.declarations {
            if reach.enabled && !jet_driver_reach_has(reached[row.loaded], declaration.position) -> next
            jet_driver_blank_bytes(source, cursor, declaration.span.start)
            cursor = declaration.span.end
            positions.push(declaration.position)
        }
        if positions.len() == 0 -> next
        jet_driver_blank_bytes(source, cursor, source.len())
        lexed := lex_generated_threads(source, request.compiler_threads)
        parsed := parse_lexed_with_source_threads(lexed.lexed.move(), source, lexed.line_starts, lexed.runs, request.compiler_threads)
        loop diagnostic in parsed.diagnostics {
            if diagnostic.severity != DIAGNOSTIC_LINT -> diagnostics.push(diagnostic_with_source_path(diagnostic, unit.path, 0))
        }
        if jet_driver_has_errors(parsed.diagnostics) {
            failed = true
            next
        }
        if parsed.program.items.len() != positions.len() -> panic("the {positions.len()} held declarations of {unit.path} parsed as {parsed.program.items.len()} items")
        loop (at, item) in parsed.program.items -> modules[row.loaded].program.items[positions[at]] = item
        loop span in parsed.program.block_spans -> modules[row.loaded].program.block_spans.push(span)
        loop arm in parsed.program.else_arms -> modules[row.loaded].program.else_arms.push(arm)
        loop site in parsed.program.debug_sites -> modules[row.loaded].program.debug_sites.push(site)
        count += positions.len()
    }
    if failed -> return -1
    count
}

// The load is done: drop each never-followed import from its module, each
// unreached constant (so comptime evaluates only constants the program can
// name) and each unreached lazy declaration of a routed module, then every
// unreached declaration that spells a dropped import's alias as a path head,
// spells the word of a demand never followed (its module may not have
// loaded), or spells a dropped declaration (bare in the same module, after a
// `.` anywhere), until no remaining declaration names a dropped one. A
// dropped method leaves its type; its name stays, since other types may
// share it.
jet_driver_reach_strip: fn(reach: JetDriverReach, modules: &[JetDriverLoadedModule]) {
    dead := [[Bool]]{}
    dead_imports := [[Span]]{}
    // Per unit, the words of its demands never followed: after a `.`, and
    // anywhere.
    waiting_dotted := [[Bool]]{}
    waiting_spelled := [[Bool]]{}
    loop _ in reach.units {
        dead.push([Bool]{})
        dead_imports.push([Span]{})
        waiting_dotted.push([Bool]{})
        waiting_spelled.push([Bool]{})
    }
    any := false
    loop edge in reach.edges {
        if edge.followed -> next
        any = true
        loop dead[edge.unit].len() <= edge.alias -> dead[edge.unit].push(false)
        dead[edge.unit][edge.alias] = true
        dead_imports[edge.unit].push(edge.scoped.declaration.span)
    }
    loop demand in reach.demands {
        if demand.followed -> next
        any = true
        if demand.dotted {
            loop waiting_dotted[demand.unit].len() <= demand.word -> waiting_dotted[demand.unit].push(false)
            waiting_dotted[demand.unit][demand.word] = true
        }
        if !demand.dotted {
            loop waiting_spelled[demand.unit].len() <= demand.word -> waiting_spelled[demand.unit].push(false)
            waiting_spelled[demand.unit][demand.word] = true
        }
    }
    gone := [Bool]{}
    loop _ in reach.items -> gone.push(false)
    global_gone := [Bool]{}
    local_gone := [[Bool]]{}
    loop _ in reach.units -> local_gone.push([Bool]{})
    loop index in 0..<reach.items.len() {
        if reach.items[index].live -> next
        unit: reach.items[index].unit
        if reach.units[unit].routed || reach.items[index].held || modules[reach.units[unit].loaded].program.items[reach.items[index].item] == .Const(_) {
            any = true
            jet_driver_reach_gone(reach, index, gone, global_gone, local_gone)
        }
    }
    if !any -> return
    grew := true
    loop grew {
        grew = false
        loop index in 0..<reach.items.len() {
            if reach.items[index].live || gone[index] -> next
            unit: reach.items[index].unit
            hit := false
            loop spell in reach.items[index].spells {
                id: spell >> 2
                kind: spell.bit_and(3)
                if kind == 2 && jet_driver_reach_has(dead[unit], id) -> hit = true
                if kind.bit_and(1) == 0 && jet_driver_reach_has(local_gone[unit], id) -> hit = true
                if kind.bit_and(1) == 1 && (jet_driver_reach_has(global_gone, id) || jet_driver_reach_has(waiting_dotted[unit], id)) -> hit = true
                if jet_driver_reach_has(waiting_spelled[unit], id) -> hit = true
                if hit -> break
            }
            if !hit -> next
            grew = true
            jet_driver_reach_gone(reach, index, gone, global_gone, local_gone)
        }
    }
    // Per unit and program.items position: whether the item leaves, and the
    // names of the methods that leave it.
    drop := [[Bool]]{}
    cut := [[[String]]]{}
    loop _ in reach.units {
        drop.push([Bool]{})
        cut.push([[String]]{})
    }
    loop index in 0..<reach.items.len() {
        if !gone[index] -> next
        unit: reach.items[index].unit
        position: reach.items[index].item
        if reach.items[index].member == "" {
            loop drop[unit].len() <= position -> drop[unit].push(false)
            drop[unit][position] = true
        } else {
            loop cut[unit].len() <= position -> cut[unit].push([String]{})
            // copy: the reach keeps its items.
            cut[unit][position].push(reach.items[index].member.copy())
        }
    }
    // A declaration with a reached row stays (a precise family member that
    // reached code calls by name, its type unreached).
    loop item in reach.items {
        if item.live && item.member == "" && jet_driver_reach_has(drop[item.unit], item.item) -> drop[item.unit][item.item] = false
    }
    loop unit in 0..<reach.units.len() {
        loaded: reach.units[unit].loaded
        if dead_imports[unit].len() > 0 {
            imports := [ImportDecl]{}
            loop declaration in modules[loaded].program.imports {
                if !dead_imports[unit].contains(declaration.span) -> imports.push(declaration.copy())
            }
            modules[loaded].program.imports = imports.move()
        }
        if drop[unit].len() == 0 && cut[unit].len() == 0 -> next
        loop position in 0..<cut[unit].len() {
            if cut[unit][position].len() > 0 -> jet_driver_reach_cut(modules[loaded].program.items, position, cut[unit][position])
        }
        items := [Item]{}
        loop position in 0..<modules[loaded].program.items.len() {
            if !jet_driver_reach_has(drop[unit], position) -> items.push(modules[loaded].program.items[position])
        }
        modules[loaded].program.items = items.move()
    }
}

// Takes the methods named in `names` out of `items[position]`, a struct or
// enum.
jet_driver_reach_cut: fn(items: &[Item], position: Int, names: [String]) Never! {
    if items[position] == .Struct(value) {
        updated := value
        updated.methods = jet_driver_reach_kept_methods(value.methods, names)
        items[position] = Item.Struct{value: updated}
    } else if items[position] == .Enum(value) {
        updated := value
        updated.methods = jet_driver_reach_kept_methods(value.methods, names)
        items[position] = Item.Enum{value: updated}
    }
}

jet_driver_reach_kept_methods: fn(methods: [Func], names: [String]) -> [Func] Never! {
    kept := [Func]{}
    loop method in methods {
        // copy: the item keeps its methods until the cut item replaces it.
        if !names.contains(method.name) -> kept.push(method.copy())
    }
    kept
}

// Marks reach item `index` dropped, and if its name is the one it declares,
// that name dropped in its module (bare spellings) and everywhere
// (spellings after a `.`).
jet_driver_reach_gone: fn(reach: JetDriverReach, index: Int, gone: &[Bool], global_gone: &[Bool], local_gone: &[[Bool]]) Never! {
    gone[index] = true
    if !reach.items[index].cascade -> return
    unit: reach.items[index].unit
    name: reach.items[index].name
    loop global_gone.len() <= name -> global_gone.push(false)
    global_gone[name] = true
    loop local_gone[unit].len() <= name -> local_gone[unit].push(false)
    local_gone[unit][name] = true
}
