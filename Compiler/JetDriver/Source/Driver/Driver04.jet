// Rust: crates/jet-driver/src/Driver/mod.rs:6504
pub fn mir_artifact_build_mode_for(bundle: &AST.ProgramBundle, compile_mode: Sema.CompileMode, profile: &String) -> MirArtifactBuildMode {
    if (compile_mode, profile) == {
        (_, "fuzz") -> MirArtifactBuildMode.Fuzz
        (_, "coverage") -> MirArtifactBuildMode.Coverage
        (.Test | .TestOverride, _) -> MirArtifactBuildMode.Test
        (_, "release" | "hardened") -> MirArtifactBuildMode.Release
        (_, "dev" | "debug" | "ci" | "small" | "no-os" | "default" | "fast") -> MirArtifactBuildMode.Dev
        (_, "test") -> MirArtifactBuildMode.Test
        (_, name) -> if Loader.package_facts_for_bundle(bundle).ok().flatten().is_some_and(fn(facts) { facts.build_profiles.iter().any(fn(profile) { profile.name == name }) }) { MirArtifactBuildMode.Dev } else { panic("unsupported MIR artifact build profile `{name}`") }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6541
fn mir_artifact_request_for(bundle: &AST.ProgramBundle, target: MirArtifactTarget, kind: MirArtifactKind, compile_mode: Sema.CompileMode, profile: &String) -> MirArtifactRequest { MirArtifactRequest.new(target, kind, mir_artifact_build_mode_for(bundle, compile_mode, profile)) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6552
fn mir_artifact_request_for_build(bundle: &AST.ProgramBundle, compile_mode: Sema.CompileMode, profile: &String, web_target: Bool, plugin_target: Bool, library_target: Bool) -> MirArtifactRequest {
    if web_target && plugin_target { panic("MIR artifact request cannot select both Web and sandbox targets") }
    target :: if web_target { MirArtifactTarget.Web } else { MirArtifactTarget.RustAot }
    kind :: if web_target { MirArtifactKind.WebApplication } else if plugin_target { MirArtifactKind.SandboxPlugin } else if library_target { MirArtifactKind.NativeLibrary } else if compile_mode == .TestOverride { MirArtifactKind.TestOverride } else if profile == "fuzz" { MirArtifactKind.FuzzExecutable } else if compile_mode == .Test { MirArtifactKind.TestExecutable } else { MirArtifactKind.NativeExecutable }
    mir_artifact_request_for(bundle, target, kind, compile_mode, profile)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6591
fn lower_checked_mir_program_for(bundle: &AST.ProgramBundle, request: MirArtifactRequest) -> (MirProgram, MirArtifactId) { lower_checked_mir_program_for_with_debug(bundle, request, false) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6601
fn lower_checked_mir_program_for_with_debug(bundle: &AST.ProgramBundle, request: MirArtifactRequest, debug_linemap: Bool) -> (MirProgram, MirArtifactId) {
    lower_span := Trace.span("lower")
    (mir, artifact) :: TIR.lower_checked_mir_program_for_with_debug(bundle, request, debug_linemap).unwrap_or_else(fn(error) { panic("{error}") })
    mir.validate().unwrap_or_else(fn(error) { panic("canonical MIR validation failed: {error}") })
    lower_span.items(mir.functions.len()); (mir, artifact)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6623
fn mir_web_target(bundle: &AST.ProgramBundle, mir: &MirProgram, artifact: MirArtifactId, release_devtools_policy: &Package.ReleaseDevtoolsPolicy) -> MIRWeb.MirWebTarget {
    assets := MIRWeb.MirWebAssets.with_default_shell()
    assets.explicit_html_path = bundle.modules.get(bundle.entry).and_then(fn(module) { module.html_path.clone() })
    assets.source_names = bundle.modules.iter().map(fn(module) { module.display.clone() }).collect()
    assets.source_contents = bundle.modules.iter().map(fn(module) { module.source.clone() }).collect()
    MIRWeb.MirWebTarget{layout: if bundle.build_facts.target_triple.is_empty() { TargetLayout.host() } else { TargetLayout.from_build_facts(&bundle.build_facts) }, assets: assets, semantic_digest: mir_program_digest(mir), artifact: artifact, release_devtools_policy: release_devtools_policy.clone()}
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6657
fn emit_web_from_mir(bundle: &AST.ProgramBundle, mir: &MirProgram, artifact: MirArtifactId, release_devtools_policy: &Package.ReleaseDevtoolsPolicy) -> MIRWeb.WebArtifacts { MIRWeb.emit_web(mir, &mir_web_target(bundle, mir, artifact, release_devtools_policy)).unwrap_or_else(fn(error) { panic("MIR Web emission failed: {error}") }) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6670
fn apply_application_authority(bundle: &AST.ProgramBundle, invocation_authority: ApplicationAuthority?) -> Unit {
    invocation_authority :: if invocation_authority == { .Some(authority) -> authority .None -> return }
    authority := &bundle.package_guarantees.application_authority
    authority.granted_effects.extend(invocation_authority.granted_effects.iter().cloned()); authority.denied_effects.extend(invocation_authority.denied_effects.iter().cloned())
    if !authority.authority.is_empty() && !invocation_authority.authority.is_empty() { authority.authority.push_str(" + ") }
    authority.authority.push_str(&invocation_authority.authority)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6697
pub fn check_bundle_path_with_source_closure_for_artifact(file: &String, mode: Sema.CompileMode, profile: &String, source_closure: &[(OSPath, String)]) -> (AST.ProgramBundle, [Diagnostic], FFI.FfiLink?) [Diagnostic]! {
    run_compiler_work(fn() { check_bundle_for_artifact_on_compiler_stack(file, mode, false, Policy.GateSet.default(), false, false, None, None, profile, &[:], false, None, None, None, Some(source_closure)) })?
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6734
fn check_bundle_for_artifact_on_compiler_stack(file: &String, mode: Sema.CompileMode, no_os: Bool, gates: Policy.GateSet, web_target: Bool, library_target: Bool, cross_target: String?, explicit_output: String?, profile: &String, setting_overrides: &[String:String], locked: Bool, entry_fn: String?, overlay: (OSPath, String)?, target_dossier: TargetDossier?, source_closure: [(OSPath, String)]?) -> (AST.ProgramBundle, [Diagnostic], FFI.FfiLink?) [Diagnostic]! {
    if locked { Loader.verify_locked_dependency_sources(file)? }
    overlays := source_closure.unwrap_or(&[]).iter().map(fn((path, source)) { (path.as_path(), source.as_str()) }).collect()
    if overlay == Some((path, source)) { overlays.push((path, source)) }
    load_span := Trace.span("load")
    bundle := Loader.load_entry_with_overlays(file, &overlays, false)?
    load_span.items(bundle.modules.len()); drop(load_span)
    // GATE #4483: sema facts and MIR share one selected target dossier.
    set_bundle_target(&bundle, cross_target); seed_build_facts(&bundle, profile, locked, setting_overrides)?
    bundle.build_facts.artifact_build = explicit_output.is_some() || library_target
    has_target_dossier :: target_dossier.is_some()
    if target_dossier == Some(dossier) { bundle.build_facts.target_dossier = dossier }
    if entry_fn == Some(entry_fn) { swap_entry_point(&bundle, &entry_fn) }
    if web_target { bundle.web_partition_enforced = true }
    runnable_output :: if library_target { None } else { explicit_output }
    sema_span := Trace.span("sema.check")
    (diags, effect_facts) :: if runnable_output == Some(output) { Sema.check_bundle_for_output_opts_with_effect_facts(&bundle, mode, &output, no_os, gates) } else if no_os { Sema.check_bundle_no_os_with_effect_facts(&bundle, mode) } else if !gates.is_empty() { Sema.check_bundle_gates_with_effect_facts(&bundle, mode, gates) } else { Sema.check_bundle_with_effect_facts(&bundle, mode) }
    sema_span.items(bundle.modules.len()); drop(sema_span)
    if !has_target_dossier { refresh_target_dossier(&bundle, no_os, web_target) }
    diags := apply_package_effect_budget(&bundle, &effect_facts, diags)?
    if cross_target == Some(target) { diags.extend(Sema.check_target_surface(&bundle, &target)) }
    extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, Some(&effect_facts), &diags)
    parse_teaching :: mem.take(&bundle.parse_teaching)
    lints :: gate_diagnostics(&bundle, parse_teaching, diags, extension_diags)?
    ffi :: if cross_target == Some(target) { FFI.prepare_for_target(&bundle, &target)? } else if web_target { FFI.prepare_for_target(&bundle, &bundle.build_facts.target_triple)? } else { FFI.prepare(&bundle)? }
    (bundle, lints, ffi)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6834
fn compile_bundle_path_opts_on_compiler_stack_with_runtime(file: &String, mode: Sema.CompileMode, no_os: Bool, gates: Policy.GateSet, web_target: Bool, plugin_target: Bool, library_target: Bool, debug_linemap: Bool, cross_target: String?, explicit_output: String?, profile: &String, setting_overrides: &[String:String], locked: Bool, entry_fn: String?, overlay: (OSPath, String)?, target_dossier: TargetDossier?, source_closure: [(OSPath, String)]?, application_authority: ApplicationAuthority?) -> (CompileOutput, AST.ProgramBundle) [Diagnostic]! {
    (bundle, lints, ffi) := check_bundle_for_artifact_on_compiler_stack(file, mode, no_os, gates, web_target, library_target, cross_target, explicit_output, profile, setting_overrides, locked, entry_fn, overlay, target_dossier, source_closure)?
    plugin_name :: if plugin_target { Some(PluginExport.resolve_export_name(&bundle)) } else { None }
    library_config :: if library_target {
        if web_target || plugin_target { throw [Diagnostic.error("E1341", "a Library output cannot also select a backend target", "Library artifacts are native static/shared projections (D-LIB-EXPORT1=C), not web or sandbox guest outputs", "remove `--target=web`/`--target=sandbox` and select the Library output directly", None)] }
        Some(LibraryExport.resolve_config(&bundle, explicit_output)?)
    } else { None }
    apply_application_authority(&bundle, application_authority)
    request :: mir_artifact_request_for_build(&bundle, mode, profile, web_target, plugin_target, library_target)
    request :: if plugin_name == Some(name) { request.with_name(&name) } else if library_config.as_ref() == Some(config) { request.with_name(&config.name) } else { request }
    (mir, artifact) :: lower_checked_mir_program_for_with_debug(&bundle, request, debug_linemap)
    execution := MIRRust.MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi.as_ref(); execution.release_devtools_policy = release_devtools_policy_for_bundle(&bundle, profile)
    execution.emit_types = true; execution.emit_foreign = true; execution.emit_metadata = false; execution.emit_debug_linemap = debug_linemap; execution.emit_runtime = true
    web_release_devtools_policy :: execution.release_devtools_policy.clone()
    emit_span := Trace.span("emit")
    rust :: MIRRust.emit_mir_program(&mir, &MIRRust.MirRustConfig{target: TargetLayout.from_build_facts(&bundle.build_facts), target_kind: if web_target { MIRRust.MirRustTarget.WebWasm } else { MIRRust.MirRustTarget.Native }, root_prefix: "", execution: execution})
    emit_span.items(mir.functions.len()); drop(emit_span)
    web :: if web_target { Some(emit_web_from_mir(&bundle, &mir, artifact, &web_release_devtools_policy)) } else { None }
    plugin :: if plugin_target {
        surface_errors :: PluginExport.validate_export_surface(&bundle)
        if !surface_errors.is_empty() { throw surface_errors }
        export_name :: plugin_name.as_ref().expect("plugin artifact request has no selected export name")
        PluginExport.check_and_freeze_version(&bundle, export_name)?
        Some(emit_plugin(&mir, artifact, &rust))
    } else { None }
    if library_config.as_ref() == Some(config) {
        surface_errors :: LibraryExport.validate_export_surface(&bundle)
        if !surface_errors.is_empty() { throw surface_errors }
        LibraryExport.check_and_freeze_version(&bundle, &config.name)?
    }
    library :: library_config.as_ref().map(fn(config) { emit_library(&mir, artifact, &rust, &config.bindings) })
    comptime_inputs :: mem.take(&bundle.comptime_inputs)
    resolver :: if AuthorityResolver.open(&bundle.project_root) == { .Ok(resolver) -> Some(resolver) .Err(error) -> if error.is_missing() { None } else { throw [error.diagnostic()] } }
    if resolver == Some(resolver) {
        checked :: if resolver.checked_manifest(OSPath.new(".")) == { .Ok(checked) -> Some(checked) .Err(error) -> if error.is_missing() { None } else { throw [error.diagnostic()] } }
        if checked == Some(checked) {
            source :: checked.file.text().map_err(fn(error) { [error.diagnostic()] })?
            manifest :: Manifest.parse(&checked.file.path, &source).map_err(fn(diagnostic) { [diagnostic] })?
            resolver.revalidate_file(&checked.file).map_err(fn(error) { [error.diagnostic()] })?
            Lock.record_inferred_layer(&bundle.project_root, &manifest.package.name, bundle.inferred_layer)
        }
    }
    output :: CompileOutput{rust: rust, lints: lints, ffi: ffi, clinks: [], comptime_inputs: comptime_inputs, web: web, web_partition_report: bundle.web_partition_report.clone(), plugin: plugin, library: library, library_config: library_config, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling}
    (output, bundle)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:7025
#Derive(Clone, Copy, Debug, Default, Eq)
pub struct CompileSrcOptions { pub web_target: Bool = false }
// Rust: crates/jet-driver/src/Driver/mod.rs:7030
pub fn compile_src(src: &String, file: &String, mode: Sema.CompileMode) -> CompileOutput [Diagnostic]! { compile_src_with_options(src, file, mode, CompileSrcOptions.default())? }
// Rust: crates/jet-driver/src/Driver/mod.rs:7040
pub fn compile_generated_src(src: &String, file: &String, mode: Sema.CompileMode) -> CompileOutput [Diagnostic]! { compile_src_with_options_and_policy(src, file, mode, CompileSrcOptions.default(), true)? }
// Rust: crates/jet-driver/src/Driver/mod.rs:7048
pub fn compile_src_with_options(src: &String, file: &String, mode: Sema.CompileMode, options: CompileSrcOptions) -> CompileOutput [Diagnostic]! { compile_src_with_options_and_policy(src, file, mode, options, false)? }
// Rust: crates/jet-driver/src/Driver/mod.rs:7057
fn compile_src_with_options_and_policy(src: &String, file: &String, mode: Sema.CompileMode, options: CompileSrcOptions, generated: Bool) -> CompileOutput [Diagnostic]! { run_compiler_work(fn() { compile_src_on_compiler_stack(src, file, mode, options, generated) })? }
// Rust: crates/jet-driver/src/Driver/mod.rs:7067
// Complete the output record through Rust7213, so the next slice begins at check_file.
fn compile_src_on_compiler_stack(src: &String, file: &String, mode: Sema.CompileMode, options: CompileSrcOptions, generated: Bool) -> CompileOutput [Diagnostic]! {
    boot_mir_eval()
    source_for_parse :: if generated { src.to_string() } else { Package.mask_inline_package_source(src).map(fn((masked, _)) { masked }).map_err(fn(error) { [error.diagnostic()] })? }
    (toks, lex_diags) :: if generated { Lexer.lex_generated(&source_for_parse) } else { Lexer.lex(&source_for_parse) }
    if !lex_diags.is_empty() { throw lex_diags }
    prog := Parser.parse_with_source(&toks, &source_for_parse)?
    bundle := AST.ProgramBundle{
        entry: 0, project_root: OSPath.from("."),
        modules: [AST.LoadedModule{path: OSPath.from(file), display: file.to_string(), alias: Loader.default_module_alias(OSPath.new(file)), imports: mem.take(&prog.imports), items: mem.take(&prog.items), script_body: mem.take(&prog.script_body), block_spans: mem.take(&prog.block_spans), source: src.to_string(), web_target_ceiling: prog.web_target_ceiling, pub_file: prog.pub_file, no_prelude: prog.no_prelude, default_target: prog.default_target, html_path: prog.html_path.clone(), policy_declarations: prog.policy_declarations.clone(), user_policy_declarations: prog.user_policy_declarations.clone(), rule_facts: mem.take(&prog.rule_facts)}],
        devtools_registry: AST.DevtoolsRegistry.default(), parse_teaching: [], used_core: [].into_set(), ffi_callback_fns: [].into_set(), cffi: CFFI.CFfi.default(), comptime_inputs: [], name_ledger: AST.NameLedger.default(), layer_ceiling: None, inferred_layer: Syntax.RuntimeLayer.Core, web_partitions: [:], web_partition_enforced: options.web_target, web_partition_report: None, dep_roots: [:], package_guarantees: Default.default(), program_allocator: Default.default(), active_os: Syntax.OSTarget.host(), build_facts: BuildFactSnapshot.script(OSPath.new(file), Syntax.OSTarget.host(), "dev"), edition: Manifest.latest_edition().to_string()
    }
    Foreign.assemble_active_namespaces(&bundle)?
    bundle.cffi = CFFI.assemble(&bundle)?
    diags :: Sema.check_bundle(&bundle, mode)
    errors := [Diagnostic].new(); lints := [Diagnostic].new()
    for d in diags { if d.severity == { .Error -> errors.push(d) .Lint -> lints.push(d) } }
    if !errors.is_empty() { throw errors }
    refresh_target_dossier(&bundle, false, options.web_target)
    ffi :: if options.web_target { FFI.prepare_for_target(&bundle, &bundle.build_facts.target_triple)? } else { FFI.prepare(&bundle)? }
    request :: mir_artifact_request_for_build(&bundle, mode, "dev", options.web_target, false, false)
    (mir, artifact) :: lower_checked_mir_program_for(&bundle, request)
    execution := MIRRust.MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi.as_ref(); execution.emit_types = true; execution.emit_foreign = true; execution.emit_metadata = false; execution.emit_debug_linemap = false; execution.emit_runtime = true
    web_release_devtools_policy :: execution.release_devtools_policy.clone()
    rust :: MIRRust.emit_mir_program(&mir, &MIRRust.MirRustConfig{target: TargetLayout.host(), target_kind: if options.web_target { MIRRust.MirRustTarget.WebWasm } else { MIRRust.MirRustTarget.Native }, root_prefix: "", execution: execution})
    web :: if options.web_target { Some(emit_web_from_mir(&bundle, &mir, artifact, &web_release_devtools_policy)) } else { None }
    comptime_inputs :: mem.take(&bundle.comptime_inputs)
    CompileOutput{rust: rust, lints: lints, ffi: ffi, clinks: [], comptime_inputs: comptime_inputs, web: web, web_partition_report: bundle.web_partition_report.clone(), plugin: None, library: None, library_config: None, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling}
}
