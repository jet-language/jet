}
// Rust: crates/jet-driver/src/Driver/mod.rs:5823
fn duplicate_build_entries(bundle: &AST.ProgramBundle, indices: &[USize]) -> Diagnostic {
    module :: &bundle.modules[bundle.entry]
    first :: build_function_location(module, indices[0]); second :: build_function_location(module, indices[1])
    span :: if module.items.get(indices[1]) == { .Some(.Func(function)) -> Some(function.name_span) _ -> None }
    build_entry_conflict("the entry unit", &first, &second, span)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5834
fn build_source_location(path: &OSPath, source: &String) -> String { "{path.display()}:{source_line_at(source, source.find("fn build").unwrap_or(0))}" }
// Rust: crates/jet-driver/src/Driver/mod.rs:5839
fn source_line_at(source: &String, offset: USize) -> USize { source.as_bytes()[..offset.min(source.len())].iter().filter(fn(byte) { byte == b'\n' }).count() + 1 }
// Rust: crates/jet-driver/src/Driver/mod.rs:5847
fn build_entry_conflict(unit: &String, first_location: &String, second_location: &String, span: Span?) -> Diagnostic {
