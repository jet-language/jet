}
// Rust: crates/jet-driver/src/Driver/mod.rs:5865
fn materialize_and_check_generated(modules: &[&BuildGeneratedModule], root: &OSPath, existing_source_paths: &[OSPath], action_outputs: &[String], span: Span?, build_facts: &BuildFactSnapshot) -> [GeneratedSourceProvenance] [Diagnostic]! {
    modules := modules.to_vec()
    modules.sort_by(fn(left, right) { left.path.as_str().cmp(right.path.as_str()).then_with(fn() { left.name.cmp(&right.name) }) })
    lock :: Lock.load(root)
    existing_source_paths :: existing_source_paths.iter().map(fn(path) { normalize_project_path(root, path) }).collect()
    action_outputs :: action_outputs.iter().map(fn(path) { normalize_project_path(root, OSPath.new(path)) }).collect()
    // Preflight all owners before exposing any generated module to concurrent observers.
    planned_paths := [OSPath].new().into_set()
    for module in &modules {
        path :: normalize_project_path(root, OSPath.new(module.path.as_str()))
        if !planned_paths.insert(path.clone()) { throw [generated_cycle_diag(&module.name, module.path.as_str(), "two generated modules claim the same managed path", span)] }
        if action_outputs.iter().any(fn(output) { output == &path }) { throw [generated_cycle_diag(&module.name, module.path.as_str(), "a selected build action and a generated module both own this path", span)] }
        if has_symlinked_component(root, &path) { throw [generated_collision_diag(&module.name, module.path.as_str(), span)] }
        managed :: managed_generated_file(lock.as_ref(), root, &path, &module.source_digest)
        if existing_source_paths.iter().any(fn(source) { source == &path }) && !managed { throw [generated_collision_diag(&module.name, module.path.as_str(), span)] }
        // GATE #4494: non-following native filesystem metadata.
        if fs.symlink_metadata(&path) == .Ok(metadata) {
            if metadata.file_type().is_symlink() || (!metadata.is_file() && !managed) { throw [generated_collision_diag(&module.name, module.path.as_str(), span)] }
            if metadata.is_file() && !managed { throw [generated_collision_diag(&module.name, module.path.as_str(), span)] }
        }
    }
    path_indices :: modules.iter().enumerate().map(fn((index, module)) { (normalize_project_path(root, OSPath.new(module.path.as_str())), index) }).collect()
    dependencies :: modules.iter().map(fn(module) { generated_dependencies(module, &normalize_project_path(root, OSPath.new(module.path.as_str())), root, &path_indices) }).collect_result()?
    rounds :: generated_rounds(&dependencies, &modules, span)?
    provenance := [GeneratedSourceProvenance].new()
    for round in rounds {
        for index in round {
            module :: modules[index]
            path :: normalize_project_path(root, OSPath.new(module.path.as_str()))
            safe_atomic_write(&path, module.source.as_bytes()).map_err(fn(error) { [generated_io_diag(&module.name, &error)] })?
            generated_bundle := Loader.load_entry_with_overlay(path.to_str().unwrap_or(module.path.as_str()), Some((&path, &module.source)), false).map_err(fn(diags) {
                for diag in &diags { diag.what = "generated module `{module.name}`: {diag.what}" }
                diags
            })?
            generated_bundle.build_facts = build_facts.clone(); generated_bundle.active_os = build_facts.os
            generated_diags :: Sema.check_bundle(&generated_bundle, Sema.CompileMode.Check)
            diags := apply_package_lint_policy(&generated_bundle, generated_diags)?
            diags.retain(fn(diag) { diag.severity == Severity.Error })
            if !diags.is_empty() { for diag in &diags { diag.what = "generated module `{module.name}`: {diag.what}" }; throw diags }
            provenance.push(GeneratedSourceProvenance{name: module.name.clone(), path: path, digest: module.source_digest.clone(), source: module.source.clone()})
        }
    }
    provenance
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6012
fn generated_dependencies(module: &BuildGeneratedModule, path: &OSPath, root: &OSPath, paths: &[OSPath:USize]) -> [USize] [Diagnostic]! {
    (tokens, lex_diags) :: Lexer.lex(&module.source)
    if !lex_diags.is_empty() { throw annotate_generated_frontend_diags(&module.name, lex_diags) }
    program :: Parser.parse_with_source(&tokens, &module.source).map_err(fn(diags) { annotate_generated_frontend_diags(&module.name, diags) })?
    dependencies := [USize].new().into_set()
    for import in program.imports {
        import_path :: if import.kind == { .File(import_path, _) -> import_path _ -> continue }
        candidate :: if generated_import_path(path, root, &import_path) == { .Some(candidate) -> candidate .None -> continue }
        if paths.get(&candidate) == Some(index) { dependencies.insert(index) }
    }
    dependencies :: dependencies.into_iter().collect(); dependencies.sort(); dependencies
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6039
fn generated_import_path(path: &OSPath, root: &OSPath, import_path: &String) -> OSPath? {
    if import_path.trim().is_empty() || import_path.starts_with('/') { return None }
    candidate := path.parent()?.to_path_buf()
    for part in import_path.split('/') { if part.is_empty() || part == "." { continue }; if part == ".." { return None }; candidate.push(part) }
    candidate.set_extension(Syntax.FILE_EXT)
    Some(normalize_project_path(root, &candidate))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6061
fn annotate_generated_frontend_diags(name: &String, diagnostics: [Diagnostic]) -> [Diagnostic] {
    for diagnostic in &diagnostics { diagnostic.what = "generated module `{name}`: {diagnostic.what}" }
    diagnostics
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6075
fn generated_rounds(dependencies: &[[USize]], modules: &[&BuildGeneratedModule], span: Span?) -> [[USize]] [Diagnostic]! {
    dependents := [[USize].new(); modules.len()]
    remaining := dependencies.iter().map(fn(deps) { deps.len() }).collect()
    for (module, deps) in dependencies.iter().enumerate() { for dependency in deps { dependents[dependency].push(module) } }
    for dependents in &dependents { dependents.sort_unstable() }
    ready := [USize].new().into_set()
    for (index, count) in remaining.iter().enumerate() { if count == 0 { ready.insert(index) } }
    rounds := [[USize]].new(); emitted := 0
    while !ready.is_empty() {
        current :: ready.iter().copied().collect(); current.sort(); ready.clear()
        for module in &current {
            emitted += 1
            for dependent in &dependents[module] { remaining[dependent] -= 1; if remaining[dependent] == 0 { ready.insert(dependent) } }
        }
        rounds.push(current)
    }
    if emitted == modules.len() { return rounds }
    state := [0u8; modules.len()]; stack := [USize].new()
    cycle :: (0..modules.len()).find_map(fn(index) { generated_cycle_chain(index, dependencies, &state, &stack) }).unwrap_or_else(fn() { [0] })
    first :: cycle[0]
    chain :: cycle.iter().map(fn(index) { modules[index].name.as_str() }).collect().join(" -> ")
    throw [generated_cycle_diag(&modules[first].name, modules[first].path.as_str(), &"dependency chain `{chain}` is cyclic", span)]
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6136
fn generated_cycle_chain(index: USize, dependencies: &[[USize]], state: &[U8], stack: &[USize]) -> [USize]? {
    if state[index] == 1 { start :: stack.iter().position(fn(item) { item == index }).unwrap_or(0); cycle := stack[start..].to_vec(); cycle.push(index); return Some(cycle) }
    if state[index] == 2 { return None }
    state[index] = 1; stack.push(index)
    for dependency in &dependencies[index] { if generated_cycle_chain(dependency, dependencies, state, stack) == Some(cycle) { return Some(cycle) } }
    _ :: stack.pop(); state[index] = 2; None
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6163
fn normalize_project_path(root: &OSPath, path: &OSPath) -> OSPath {
    path :: if path.is_absolute() { path.to_path_buf() } else { root.join(path) }
    normalized := OSPath.new()
    for component in path.components() {
        if component == { .Prefix(prefix) -> normalized.push(prefix.as_os_str()) .RootDir -> normalized.push(MAIN_SEPARATOR.to_string()) .CurDir -> {} .ParentDir -> { _ :: normalized.pop() } .Normal(part) -> normalized.push(part) }
    }
    normalized
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6184
fn has_symlinked_component(root: &OSPath, path: &OSPath) -> Bool {
    relative :: if path.strip_prefix(root) == { .Ok(relative) -> relative .Err(_) -> return true }
    current := root.to_path_buf()
    for component in relative.components() {
        part :: if component == { .Normal(part) -> part _ -> return true }
        current.push(part)
        if fs.symlink_metadata(&current) == .Ok(metadata) { if metadata.file_type().is_symlink() { return true } }
    }
    false
}
// Rust: crates/jet-driver/src/Driver/mod.rs:6203
fn managed_generated_file(lock: Lock.LockFile?, root: &OSPath, path: &OSPath, digest: &ContentDigest) -> Bool {
    lock :: if lock == { .Some(lock) -> lock .None -> return false }
    relative :: if path.strip_prefix(root) == { .Ok(relative) -> relative .Err(_) -> return false }
    relative :: relative.to_string_lossy().replace('\\', "/")
    lock.comptime_inputs.iter().any(fn(input) { input.path == relative && input.hash == digest.as_str() })
}
