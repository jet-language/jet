fn generated_collision_diag(name: &String, path: &String, span: Span?) -> Diagnostic { Diagnostic.error("E3510", "`b.generate(\"{name}\")` would shadow the module at `{path}`", "generation is additive: what you wrote is always what compiles", "rename the generated module, or delete the hand-written one", span) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6235
fn generated_cycle_diag(name: &String, path: &String, reason: &String, span: Span?) -> Diagnostic { Diagnostic.error("E3511", "generation rounds form a cycle: `{name}` at `{path}`", "generated source must reach a bounded deterministic order, not loop until quiescent", "{reason}; break the dependency between these generators", span) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6251
fn generated_io_diag(name: &String, error: &io.Error) -> Diagnostic { Diagnostic.error("E3502", "generated module `{name}` could not be materialized", "generated source must be a real file before it re-enters the front end: {error}", "make sure `.jet/generated` is writable and the generated module name is unique", None) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6262
fn build_plan_diagnostic(error: &BuildError) -> Diagnostic { Diagnostic.error("E3502", "build plan is invalid: {error:?}", "all graph handles must belong to one selected root build and every action output must have one owner", "fix the named graph node and use `jet inspect explain-build` to inspect its inputs", None) }
// Rust: crates/jet-driver/src/Driver/mod.rs:6272
fn build_execution_diagnostic(error: BuildExecutionError) -> Diagnostic {
    if error == {
        .MissingGrant(action, capability) -> Diagnostic.error("E3504", "build action `{action}` asks for ungranted `{capability:?}` ability", "declaring an ability in `fn build` does not grant it; root policy must approve each ambient effect", "pass `--allow-{capability.flag()}` for this run, or grant it in package/workspace policy", None)
        .Reported(report) -> {
            diagnostic := Diagnostic.error("E3505", report.message.clone(), "the sandboxed command reported a structured failure; its typed identity and source data remain in the report", "fix the action command, declared inputs/outputs, toolchain, or probe, then rerun `jet build`", None)
            diagnostic.detail = Some(report.render_with_style(JetReportStyle.PLAIN)); diagnostic.structured = Some(StructuredDiagnostic.BuildError(report)); diagnostic
        }
        .ProbeFailed(probe, detail) -> Diagnostic.error("E3505", "build probe `{probe}` failed", detail, "fix the typed probe or select a toolchain that provides it", None)
        .SandboxUnavailable -> Diagnostic.error("E3505", "build sandbox is unavailable", "Jet refuses to run typed build actions without the required bubblewrap isolation", "install bubblewrap or run on a supported build worker; there is no ambient fallback", None)
        .IO(action, detail) -> Diagnostic.error("E3505", "build action `{action}` could not access a declared build path", detail, "fix the declared input/output path or make the project build directory writable", None)
        .InvalidGraph(error) -> build_plan_diagnostic(&error)
    }
}
