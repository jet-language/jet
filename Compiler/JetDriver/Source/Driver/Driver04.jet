//RS /// D-BUILDENTRY1 / D-CONF-ENTRY1: does this program select a `fn build`?
//RS /// Selection is exactly what `compile_bundle_path_build` stages — a `fn build`
//RS /// among the entry file's own declarations, or the one the package authority
//RS /// discovers for the whole package — so a command router asks here instead of
//RS /// re-deriving the answer from source text.
//RS ///
//RS /// A selected build entry contributes computed facts (D-CONF-SPLIT1), may
//RS /// generate modules, and records both in `.jet/lock`. A lane that cannot stage
//RS /// it must therefore hand the program to the build pipeline instead of folding
//RS /// `$build.*` from manifest declarations alone: otherwise one tier runs a
//RS /// program built from the declared default while another runs the contributed
//RS /// value, which is the tier split I9 forbids.
//RS ///
//RS /// Routing runs before any tier claims the program, so this answer costs one
//RS /// lex and parse of the entry source that the caller already holds, and it
//RS /// never walks the import closure. `project_root` is the package root when the
//RS /// entry belongs to a package and `None` for a manifest-less single file, which
//RS /// can only select its own `fn build`. A source the parser rejects is not a
//RS /// routing answer: the pipeline that runs next reports the parse error.
//RS pub fn selects_build_entry(source: &str, project_root: Option<&std::path::Path>) -> bool {
//RS     if source_has_build_entry(source) == Some(true) {
//RS         return true;
//RS     }
//RS     project_root.is_some_and(|root| matches!(package_build_entry_source(root), Ok(Some(_))))
//RS }
//RS 
//RS /// Parse one already loaded source to distinguish the programmable-build
//RS /// shape from an ordinary function that happens to be named `build`. `None`
//RS /// preserves routing to the build pipeline for parser diagnostics.
//RS fn source_has_build_entry(source: &str) -> Option<bool> {
//RS     let source = crate::Package::mask_inline_package_source(source).ok()?.0;
//RS     let (tokens, lex_diags) = crate::Lexer::lex(&source);
//RS     if !lex_diags.is_empty() {
//RS         return None;
//RS     }
//RS     let (program, _) = crate::Parser::parse_for_check_with_source(&tokens, &source).ok()?;
//RS     Some(program.items.iter().any(
//RS         |item| matches!(item, crate::AST::Item::Func(func) if crate::Sema::is_build_entry(func)),
//RS     ))
//RS }
//RS 
