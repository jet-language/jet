// Rust: crates/jet-driver/src/Driver/mod.rs:5416
fn package_build_entry_source(project_root: &OSPath) -> (OSPath, String)? [Diagnostic]! {
    resolver :: AuthorityResolver.open(project_root).map_err(fn(error) { [error.diagnostic()] })?
    package :: if Loader.package_facts_for_root(project_root)? == { .Some(package) -> package .None -> return None }
    entry :: package.resolve_build_entry_checked(&resolver).map_err(fn(error) { [build_entry_resolution_diagnostic(&error)] })?
    entry :: if entry == { .Some(entry) -> entry .None -> return None }
    raw_source :: entry.text().map_err(fn(error) { [error.diagnostic()] })?
    source :: if entry.path.file_name().and_then(fn(name) { name.to_str() }) == Some(Syntax.PACKAGE_FILE) { Package.build_entry_source(&raw_source).unwrap_or(raw_source) } else { raw_source }
    if source_has_build_entry(&source) == Some(false) { return None }
    resolver.revalidate_file(&entry).map_err(fn(error) { [error.diagnostic()] })?
    resolver.revalidate_root().map_err(fn(error) { [error.diagnostic()] })?
    Some((entry.path, source))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5451
fn build_entry_resolution_diagnostic(error: &String) -> Diagnostic {
    code :: if error.contains("two build entries for the package:") { "E3520" } else { "E1334" }
    (why, fix) :: if code == "E3520" { ("one package has exactly one build entry so policy and provenance have one auditable home", "keep one `fn build` and remove the other entry") } else { ("package entry discovery uses the checked package authority", "repair the package source and try the build again") }
    Diagnostic.error(code, error.to_string(), why.to_string(), fix.to_string(), None)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5496
// Route before tier selection using the same checked entry selection as build staging.
pub fn selects_build_entry(source: &String, project_root: OSPath?) -> Bool {
    if source_has_build_entry(source) == Some(true) { return true }
    project_root.is_some_and(fn(root) { if package_build_entry_source(&root) == { .Ok(.Some(_)) -> true _ -> false } })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5506
fn source_has_build_entry(source: &String) -> Bool? {
    source :: Package.mask_inline_package_source(source).ok()?.0
    (tokens, lex_diags) :: Lexer.lex(&source)
    if !lex_diags.is_empty() { return None }
    (program, _) :: Parser.parse_for_check_with_source(&tokens, &source).ok()?
    Some(program.items.iter().any(fn(item) { if item == { .Func(func) -> Sema.is_build_entry(func) _ -> false } }))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5523
fn load_build_entry_bundle(file: &String, overlay: (OSPath, String)?, direct_package_overlay: (OSPath, String)?, source_closure: &[(OSPath, String)]) -> AST.ProgramBundle [Diagnostic]! {
    overlays := source_closure.iter().map(fn((path, source)) { (path.as_path(), source.as_str()) }).collect()
    if overlay == Some(overlay) { overlays.push(overlay) } else if direct_package_overlay == Some((path, source)) { overlays.push((path.as_path(), source.as_str())) }
    Loader.load_entry_with_overlays(file, &overlays, false)?
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5541
fn package_manifest_build_overlay(file: &String) -> (OSPath, String)? [Diagnostic]! {
    path :: OSPath.new(file)
    if path.file_name().and_then(fn(name) { name.to_str() }) != Some(Syntax.PACKAGE_FILE) { return None }
    // GATE #4494: current directory and native authority paths.
    absolute :: if path.is_absolute() { path.to_path_buf() } else {
        env.current_dir().map(fn(directory) { directory.join(path) }).map_err(fn(error) { [Diagnostic.error("E1334", "package manifest path cannot be resolved", error.to_string(), "use an existing package.jet path", None)] })?
    }
    root :: absolute.parent().unwrap_or(OSPath.new("."))
    resolver :: AuthorityResolver.open(root).map_err(fn(error) { [error.diagnostic()] })?
    checked :: resolver.checked_manifest(OSPath.new(".")).map_err(fn(error) { [error.diagnostic()] })?
    if normalize_project_path(root, &absolute) != normalize_project_path(root, &checked.file.path) { throw [Diagnostic.error("E1334", "package manifest path changed during resolution", "the requested manifest path is not the checked package.jet object", "use the canonical package.jet path", None)] }
    source :: checked.file.text().map_err(fn(error) { [error.diagnostic()] })?
    resolver.revalidate_file(&checked.file).map_err(fn(error) { [error.diagnostic()] })?
    result :: Package.build_entry_source(&source).map(fn(source) { (checked.file.path.clone(), source) })
    resolver.revalidate_file(&checked.file).map_err(fn(error) { [error.diagnostic()] })?
    result
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5592
fn validate_build_authority(plan: &BuildPlan, declared: &Set[BuildCapability], has_impure_gate: Bool, options: &BuildRunOptions, dependency_name: String?, span: Span) -> Unit [Diagnostic]! {
    selected :: plan.selected_action_ids().map_err(fn(error) { [build_plan_diagnostic(&error)] })?
    required := plan.actions().iter().filter(fn(action) { selected.contains(&action.id) }).flat_map(fn(action) { action.caps.iter().copied() }).collect_set()
    if !plan.selected_probe_ids().map_err(fn(error) { [build_plan_diagnostic(&error)] })?.is_empty() { required.insert(BuildCapability.Exec) }
    effects :: required.into_iter().collect(); effects.sort()
    for effect in effects {
        if !declared.contains(&effect) { throw [Diagnostic.error("E3503", "this build uses `{effect.name()}` without declaring it on `fn build`", "the build signature is the static authority manifest audited before build code executes", "add `{effect.name()}` to the build function's `-[...]>` effect row", Some(span))] }
        if !has_impure_gate { throw [Diagnostic.error("E3502", "build authority `{effect.name()}` must be used inside `#Impure(\"reason\")`", "ambient build effects need an audited source gate as well as a policy grant", "wrap the action or probe declarations in `#Impure(\"why this build needs ambient authority\")`", Some(span))] }
        if !options.inspect_only && !effective_grants(options).contains(&effect) {
            if dependency_name == Some(dependency_name) { throw [Diagnostic.error("E3504", "dependency `{dependency_name}` build asks for `{effect.name()}` not granted by the root", "dependency build code never gets ambient authority unless the workspace names it", "grant `{effect.name()}` explicitly in workspace policy, or remove the dependency action", Some(span))] }
            throw [Diagnostic.error("E3503", "this build asks for `{effect.name()}`, which effective policy has not granted", "a source declaration and `#Impure` gate do not widen CLI, package, or workspace policy", "pass `--allow-{effect.flag()}` or grant it in package/workspace build policy", Some(span))]
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5665
fn validate_legacy_project_imports(plan: &BuildPlan, project_root: &OSPath, span: Span) -> Unit [Diagnostic]! {
    selected :: plan.selected_action_ids().map_err(fn(error) { [build_plan_diagnostic(&error)] })?
    for action in plan.actions().iter().filter(fn(action) { selected.contains(&action.id) }) {
        import_marker :: action.labels.get("legacy.import")
        project_file :: if action.labels.get("legacy.project-file") == {
            .Some(project_file) -> project_file
            .None -> {
                if import_marker.is_some() { throw [Diagnostic.error("E3502", "legacy project-file import is missing its canonical path", "a project-file import has one reserved marker and one canonical path", "pass the wrapper's canonical project file as the final import argument", Some(span))] }
                continue
            }
        }
        if import_marker.map(fn(text) { text.as_str() }) != Some("project-file") { throw [Diagnostic.error("E3502", "legacy project file `{project_file}` has no canonical import marker", "only the typed legacy project-file importer may attach this path to an action", "declare the project file through the legacy wrapper import", Some(span))] }
        kind :: action.legacy_wrapper.ok_or_else(fn() { [Diagnostic.error("E3502", "legacy import `{project_file}` is not attached to a legacy wrapper", "a project-file import must be owned by the typed legacy wrapper that reads it", "declare the project file through the legacy wrapper import", Some(span))] })?
        if project_file != kind.project_file() || BuildPath.new(project_file.clone()).is_err() || !action.inputs.iter().any(fn(input) { input.as_str() == project_file }) { throw [Diagnostic.error("E3502", "legacy import `{project_file}` is not the canonical project file for {kind.as_str()}", "an imported legacy project file must be canonical, relative, and part of the typed action identity", "use `{kind.project_file()}` through the legacy wrapper import", Some(span))] }
        if LegacyWrapperSpec.read_legacy_project_file(project_root, kind) == .Err(error) {
            (what, fix) :: if error == {
                .LegacyProjectFileMissing(_) -> ("legacy project file `{project_file}` is missing", "restore the declared project file or remove the import")
                .LegacyProjectFileInvalid(path) -> ("legacy project file `{path}` is not a bounded UTF-8 regular file", "declare a regular UTF-8 project file no larger than 1 MiB inside the project root")
                other -> ("legacy project file `{project_file}` could not be imported: {other:?}", "restore the declared project file or remove the import")
            }
            throw [Diagnostic.error("E3502", what, "legacy graph import rejects links and directories before a wrapper can run", fix, Some(span))]
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5761
fn effective_grants(options: &BuildRunOptions) -> Set[BuildCapability] { options.grants.clone() }
// Rust: crates/jet-driver/src/Driver/mod.rs:5767
pub fn program_semantic_facts(bundle: &AST.ProgramBundle, checked: &Sema.SemIndexEffectFacts) -> ProgramSemanticFacts {
    effects := [String:[String]].new(); arithmetic := [:]
    reaches_panic :: checked.reachability.nodes_with("panic", "panic")
    for (module_idx, module) in bundle.modules.iter().enumerate() {
        for item in &module.items {
            func :: if item == { .Func(func) -> func _ -> continue }
            qualified :: program_reflection_identity(&checked.name_ledger, module_idx, &module.alias, &func.name)
            values :: checked.solved.get(&qualified).map(fn(set) { set.iter().cloned().collect() }).unwrap_or_default()
            effects.insert(qualified.clone(), values)
            arithmetic.insert(qualified, AST.arithmetic_policy_facts(&func.body))
        }
    }
    ProgramSemanticFacts{effects: effects, arithmetic: arithmetic, reaches_panic: reaches_panic, fact_registry: checked.fact_registry.clone(), name_ledger: checked.name_ledger.clone()}
}
