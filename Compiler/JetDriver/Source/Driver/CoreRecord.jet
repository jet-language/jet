// The precompiled Core record, schema `jet.core/v15`: Core and the Prelude
// checked alone as one closed program (`jet self devtools core-record`), in
// the compiler's one record format (JetFoundation RecordCodec.jet). Each row
// element is a record tree row (JetFoundation RecordTree.jet) of a checked
// row's derived encoding, so the record holds what sema produced, field for
// field, with no codec written by hand. The trees of every row share one
// string, shape and node table (sections 12 to 14): a text, a key list or a
// subtree that recurs across rows (a declaration, a symbol, a type) is stored
// once and named by id. A reader opens the record once, reads the small
// header, module key and module table sections and decodes a row only when
// it is asked for one: a compile reads the body keys and symbol keys of the
// modules it takes alone.
//
// Sections, in id order:
//   1 header: one map (compiler identity, target, the digest of the Core and
//     Prelude sources, and the module, body, declaration and value counts)
//   2 module keys: one map per Core module (name, identity, and whether its
//     registration row's source is the Core source the jet embeds, which
//     the row then leaves out), sorted by name
//   3 module rows: the checked module row of each module key, its function
//     bodies and the facts each body recorded left out (they are section 5's)
//     and each export's declaration a header, as section 6 writes it
//   4 body keys: one map per checked Core function (module identity, key),
//     sorted by module identity, then key, so a module's keys are one run a
//     compile finds by binary search
//   5 body packets: the checked body of each body key with the facts its
//     check recorded, split off its module's row at write time
//     (JetSema CoreRecordBodies.jet), so a compile that takes a body takes
//     its facts with it; each stored packed (sema_core_body_packet_stored:
//     node ids as steps, spans from the body's start, no expression-type
//     ids, no table lookup columns, and no body key in its name references
//     and call facts), which a read undoes
//   6 registration rows: the finalized registration module of each module
//     key (declarations, symbols, impls, imports and exports, its source
//     tree with every edit applied), each export's declaration a header
//     with no callable body, and no source text when its module key says
//     the jet embeds it
//   7 declaration rows: the check's declaration table, one row per DeclID
//     in row order, so a body's DeclID names the row it was checked against
//   8 value rows: the comptime values of each module key (its constants,
//     field defaults, marker arguments, checked text and the local values of
//     its bodies), in the order the check landed them, so a compile that
//     takes the module evaluates none of them again
//   9 module table: the identity text of each ModuleID the rows name, in id
//     order from the first module (the check's own load interned them); a
//     compile that takes the record's rows interns it first
//     (jet_driver_core_record_intern_modules), so each row's ModuleIDs are
//     the compile's own
//  10 symbol ranges: one map per range of the check's symbol table a compile
//     that takes the record reserves (sema_registration_reserved_symbols:
//     each recorded module's and the serial ones with their keys, every
//     other module's bare): its ModuleID (0 for a serial range), base and
//     bound, in base order
//  11 symbol keys: the keys of each range of section 10, row 1 onward, then
//     in a module's range the key of each body the check generated there
//     with no symbol (a Prelude error conversion), so each SymbolID a row
//     names, and each body key, is the compile's id for the same key; one
//     tree row per range (JetDriverCoreRecordSymbolRows), each key as its
//     parts, an owner that is an earlier key of the range named by its row
//  12 tree strings, 13 tree shapes, 14 tree nodes: the tables the rows of
//     sections 3, 5 to 8, 11 and 15 to 18 name (RecordTree.jet)
//  15 usage rows: the Core usage of each module key (SemaCoreModuleUsageResult:
//     the Core names its bodies reach, the first span of each, its FFI
//     callback keys), as the check's walk of its bodies noted it, so a
//     compile that takes the module walks none of its bodies for it
//     (JetSema CheckProgram.jet sema_finalize_seeded_usage)
//  16 module reach: what each module key's source spells for use-driven
//     loading (JetDriverCoreModuleReach): the identifier demand its source
//     scan found (Loader.jet JetDriverCoreIdentifierDemand) and the words of
//     its declarations (CoreReach.jet jet_driver_reach_recorded_words), so a
//     compile that takes the module follows its imports and demands (a
//     `core.encoding.__dyn_kind` path, a `.decode<T>()` call) only once
//     reached code of it spells them, as a compile of its source does; a
//     Prelude module sema injects has an empty one
//  17 crossing rows: the taint crossings of each module key
//     (SemaCoreCrossingResult: for each parameter of each of its functions,
//     the path on which the body steers on a fixed value passed there, by
//     fixed tag), so a compile that takes the module walks none of its
//     bodies for a call that carries a fixed value into them (JetSema
//     Taint.jet sema_taint_seeded_crossing)
//  18 effect rows: the effect facts of each module key's bodies
//     (SemaCoreEffectResult: for each of its effect sources whose body has
//     any, its `#FX(…)` regions, loop spans, `assume_deterministic` spans
//     and pending kernel), so a compile that takes the module walks none of
//     its bodies for its effect sources (JetSema CheckProgram.jet
//     sema_comptime_effect_sources)
// A row names another module by its module key position (section 2), not by
// the check's graph index, and a body names declarations by section 7's
// rows; a graph that takes a row rebases its module indexes
// (CoreRecordRebase.jet), and sema rebases a taken body's DeclIDs (JetSema
// CoreRecordBodies.jet).
use {
    jet_foundation.[CompilerThreads, DeclRow, DeclTable, FnBody, ModuleID, ModuleTable, RecordField, RecordReader, RecordReaderResult, RecordSection, RecordTreeView, RecordValue, SymbolKeys, compiler_threads_admit, compiler_threads_failure_text, compiler_threads_heaviest_first, decl_table_add_row, decl_table_index, module_count, module_find, module_index, module_intern, module_table, module_text, record_element, record_encode, record_key_digest, record_open_schema, record_open_schema_trusted, record_section_elements, record_section_index, record_tree_add, record_tree_difference, record_tree_row, record_tree_tables, record_tree_view, record_tree_writer, record_value_as_bool, record_value_as_int, record_value_as_str, record_value_field, symbol_find, symbol_keys, symbol_keys_find, symbol_keys_intern]
    jet_sema.[JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaCoreCrossingResult, SemaCoreEffectResult, SemaCoreModuleUsageResult, SemaGraphModuleResult, SemaRegistrationExport, SemaRegistrationModule, sema_core_body_packet_stored, sema_core_body_packets, sema_core_record_field_errors, sema_incremental_optional_item_header, sema_registration_reserved_symbols]
}

JET_CORE_RECORD_SCHEMA: "jet.core/v15"
JET_CORE_RECORD_HEADER: 1
JET_CORE_RECORD_MODULE_KEYS: 2
JET_CORE_RECORD_MODULE_ROWS: 3
JET_CORE_RECORD_BODY_KEYS: 4
JET_CORE_RECORD_BODY_ROWS: 5
JET_CORE_RECORD_REGISTRATION_ROWS: 6
JET_CORE_RECORD_DECL_ROWS: 7
JET_CORE_RECORD_VALUE_ROWS: 8
JET_CORE_RECORD_MODULE_TABLE: 9
JET_CORE_RECORD_SYMBOL_RANGES: 10
JET_CORE_RECORD_SYMBOL_KEYS: 11
JET_CORE_RECORD_TREE_STRINGS: 12
JET_CORE_RECORD_TREE_SHAPES: 13
JET_CORE_RECORD_TREE_NODES: 14
JET_CORE_RECORD_USAGE_ROWS: 15
JET_CORE_RECORD_MODULE_REACH: 16
JET_CORE_RECORD_CROSSING_ROWS: 17
JET_CORE_RECORD_EFFECT_ROWS: 18

// An open record: its verified reader, where its tree tables lie, and its
// module keys, in element order, with each module key's position by ModuleID
// and the module table its rows' ModuleIDs index. Its body keys and symbol
// keys stay in the record until a compile asks for a module's
// (jet_driver_core_record_module_first_body, jet_driver_core_record_symbols).
JetDriverCoreRecord: struct {
    reader: RecordReader
    tree: RecordTreeView
    compiler: String
    target: String
    core_digest: String
    module_names: [String]
    module_identities: [ModuleID]
    // Whether each module's registration row left its source out, for the
    // loader to give it the embedded Core source back.
    module_embedded_sources: [Bool]
    module_rows: [U32:Int]
    module_table: ModuleTable
}

// A body key (section 4): its module's identity and its function key.
JetDriverCoreRecordBodyKey: struct {
    owner: String
    key: String
}

// What a round trip read back: each section's row count and the record's
// size, with each section's share of it.
JetDriverCoreRecordCounts: struct {
    modules: Int
    bodies: Int
    registrations: Int
    decls: Int
    values: Int
    bytes: Int
    sections: [JetDriverCoreRecordSectionSize]
}

// One section of a record: its id, its element count, the bytes its
// elements take together and the bytes of its largest element.
JetDriverCoreRecordSectionSize: struct {
    id: Int
    elements: Int
    bytes: Int
    largest: Int
}

// What one Core module's source spells for use-driven loading (section 16):
// its identifier demand (Loader.jet) and the words the record keeps for it
// (CoreReach.jet jet_driver_reach_recorded_words).
JetDriverCoreModuleReach: struct {
    demand: JetDriverCoreIdentifierDemand
    words: JetDriverUnitWords
}

// The reach of one loaded Core module, which the Core record's check keeps
// for section 16.
JetDriverCoreModuleReachRow: struct {
    module_identity: ModuleID
    reach: JetDriverCoreModuleReach
}

// The keys of one symbol range (section 11), in row order. A key is
// `kind:module:owner:name` (Types.jet symbol_key_text), and its owner is most
// often an earlier key of its own range (a parameter's function, a method's
// impl, an impl's type), so a key names that key's row instead of spelling
// it again; each text the parts hold is the tree string table's.
JetDriverCoreRecordSymbolRows: struct {
    // The distinct kind and module texts of the range's keys.
    kinds: [String]
    modules: [String]
    kind_bits: Int
    module_bits: Int
    // Each key's owner, module and kind, packed as
    // `owner << (module_bits + kind_bits) + module << kind_bits + kind`: its
    // owner is 0 for none, 1 for the next text of `owners`, and `r + 2` for
    // the key of row `r`, an earlier row.
    codes: [Int]
    owners: [String]
    names: [String]
}

// The bits an index below `count` takes.
jet_driver_core_record_bits: fn(count: Int) -> Int Never! {
    bits := 0
    loop count > 1 << bits -> bits += 1
    bits
}

// The position of `text` in `texts`, appended when it is new.
jet_driver_core_record_text_slot: fn(texts: &[String], text: String) -> Int Never! {
    loop (index, known) in texts {
        if known == text -> return index
    }
    texts.push(text.copy())
    texts.len() - 1
}

// The keys of `keys`, row 1 onward, as their parts. A key's owner is the
// longest earlier key of the range that, with a `:`, begins the text after
// its module; a key with none spells its owner, or has none.
jet_driver_core_record_symbol_rows: fn(keys: SymbolKeys) -> JetDriverCoreRecordSymbolRows Err! {
    rows := JetDriverCoreRecordSymbolRows{kinds: [String]{}, modules: [String]{}, kind_bits: 0, module_bits: 0, codes: [Int]{}, owners: [String]{}, names: [String]{}}
    kind_at := [Int]{}
    module_at := [Int]{}
    owner_at := [Int]{}
    loop row in 1..<keys.keys.texts.len() {
        text: keys.keys.texts[row]
        kind: text.split_once(":") ?? return Err("the symbol key `{text}` has no kind")
        place: kind.after.split_once(":") ?? return Err("the symbol key `{text}` has no module")
        rest: place.after
        kind_at.push(jet_driver_core_record_text_slot(rows.kinds, kind.before))
        module_at.push(jet_driver_core_record_text_slot(rows.modules, place.before))
        if rest.starts_with(":") {
            owner_at.push(0)
            rows.names.push(rest.slice(1, rest.len()))
            next
        }
        owner := -1
        name := ""
        prefix := ""
        remainder := rest
        loop {
            parts: remainder.split_once(":") ?? break
            prefix = if prefix == "" -> parts.before else -> "{prefix}:{parts.before}"
            remainder = parts.after
            found: symbol_keys_find(keys, prefix) ?? next
            at: Int{found.id} - keys.base
            if at >= 1 && at < row {
                owner = at - 1
                name = remainder
            }
        }
        if owner >= 0 {
            owner_at.push(owner + 2)
            rows.names.push(name)
            next
        }
        spelled: rest.split_once(":") ?? return Err("the symbol key `{text}` has no owner")
        owner_at.push(1)
        rows.owners.push(spelled.before)
        rows.names.push(spelled.after)
    }
    rows.kind_bits = jet_driver_core_record_bits(rows.kinds.len())
    rows.module_bits = jet_driver_core_record_bits(rows.modules.len())
    loop (row, owner) in owner_at -> rows.codes.push((owner << (rows.module_bits + rows.kind_bits)) + (module_at[row] << rows.kind_bits) + kind_at[row])
    Ok(rows)
}

// Interns the keys `rows` spells into `keys`, row 1 onward; `base` names the
// range in a problem.
jet_driver_core_record_symbol_keys: fn(keys: &SymbolKeys, rows: JetDriverCoreRecordSymbolRows, base: Int) -> Int Err! {
    if rows.codes.len() != rows.names.len() -> return Err("the Core record's symbol range at {base} has {rows.codes.len()} key codes but {rows.names.len()} names")
    if rows.codes.len() >= keys.bound -> return Err("the Core record's symbol range at {base} holds {rows.codes.len()} keys, past its bound {keys.bound}")
    kind_mask: (1 << rows.kind_bits) - 1
    module_mask: (1 << rows.module_bits) - 1
    owner_shift: rows.module_bits + rows.kind_bits
    spelled := 0
    loop (row, code) in rows.codes {
        kind: code.bit_and(kind_mask)
        place: (code >> rows.kind_bits).bit_and(module_mask)
        owner: code >> owner_shift
        if code < 0 || kind >= rows.kinds.len() || place >= rows.modules.len() || owner >= row + 2 || (owner == 1 && spelled >= rows.owners.len()) -> return Err("the Core record's symbol key {row} of the range at {base} has a code ({code}) its parts don't hold")
        owner_text := ""
        if {
            owner == 1 -> {
                owner_text = rows.owners[spelled]
                spelled += 1
            }
            owner >= 2 -> owner_text = keys.keys.texts[owner - 1]
            else -> {}
        }
        symbol: "{rows.kinds[kind]}:{rows.modules[place]}:{owner_text}:{rows.names[row]}"
        if (Int{symbol_keys_intern(keys, symbol).id}) != base + row + 1 -> return Err("the Core record's symbol range at {base} holds `{symbol}` twice")
    }
    if spelled != rows.owners.len() -> return Err("the Core record's symbol range at {base} spells {rows.owners.len()} owners but its keys name {spelled}")
    Ok(rows.codes.len())
}

// `exports` with each declaration as its header: callable bodies left out,
// as the incremental check's module headers have them (JetSema
// CheckProgram.jet sema_incremental_item_header).
jet_driver_core_record_export_headers: fn(exports: &[SemaRegistrationExport]) Never! {
    loop index in 0..<exports.len() {
        exports[index].declaration = sema_incremental_optional_item_header(exports[index].declaration)
    }
}

// The record of the closed Core program `inputs` (the Core check stopped
// before lowering, under `every_core_body`, so its registration modules are
// kept), for the compiler `compiler` and the target `target`. The check's own
// entry module (one import of each public Core module) is left out, but for
// its rows of the declaration table, which keeps its row order, and so is the
// canonical effect module (every compile registers and checks it afresh, so
// it has no checked row). Two writes of the same inputs give the same bytes.
jet_driver_core_record_write: fn(inputs: JetDriverLoweringInputs, compiler: String, target: String) -> [U8] Err! {
    entry_file := ""
    // Each Core module's row of `inputs.modules`, by name, then identity.
    module_order := [Int]{}
    checked := [U32:Bool]{}
    loop (index, module_row) in inputs.modules {
        if module_row.module_identity == inputs.entry_module_identity {
            entry_file = module_row.source_file.copy()
            next
        }
        if checked.get(module_row.module_identity.id) != None -> return Err("Core module `{module_row.module_name}` ({module_text(inputs.module_table, module_row.module_identity)}) is checked twice")
        checked[module_row.module_identity.id] = true
        module_order.push(index)
    }
    module_order.sort_by(fn(left: Int, right: Int) { (inputs.modules[left].module_name <=> inputs.modules[right].module_name).then(module_text(inputs.module_table, inputs.modules[left].module_identity) <=> module_text(inputs.module_table, inputs.modules[right].module_identity)) })
    // The check's graph names modules by its own module index; the record
    // names them by module key position, so each row's indexes are rebased
    // to it (CoreRecordRebase.jet) before it is encoded.
    record_at := [U32:Int]{}
    loop (position, index) in module_order -> record_at[inputs.modules[index].module_identity.id] = position
    registration_at := [U32:Int]{}
    graph_modules := [Int]{}
    unchecked := [String]{}
    loop (index, registration) in inputs.registration_modules {
        graph_modules.push(record_at.get(registration.module_identity.id) ?? -1)
        if registration.module_identity == inputs.entry_module_identity || registration.module_identity == inputs.canonical_effect_module_identity -> next
        if registration_at.get(registration.module_identity.id) != None -> return Err("Core module `{registration.module_name}` ({module_text(inputs.module_table, registration.module_identity)}) is registered twice")
        registration_at[registration.module_identity.id] = index
        if record_at.get(registration.module_identity.id) == None -> unchecked.push("`{registration.module_name}` ({module_text(inputs.module_table, registration.module_identity)})")
    }
    if unchecked.len() > 0 -> return Err("the Core check registered {registration_at.len()} modules but checked {module_order.len()}; registered, never checked: {unchecked.join(", ")}")
    if registration_at.len() != module_order.len() -> return Err("the Core check registered {registration_at.len()} modules but checked {module_order.len()}")
    // Each Core body's row of `inputs.functions`, by module identity, then
    // key. Its packet (the body and the facts its check recorded) is split
    // off its module's row (sema_core_body_packets) before the row is
    // encoded.
    body_order := [Int]{}
    loop (index, function) in inputs.functions {
        if function.module_identity != inputs.entry_module_identity -> body_order.push(index)
    }
    body_order.sort_by(fn(left: Int, right: Int) { (module_text(inputs.module_table, inputs.functions[left].module_identity) <=> module_text(inputs.module_table, inputs.functions[right].module_identity)).then(inputs.functions[left].key <=> inputs.functions[right].key) })
    // A body checked twice sorts beside itself.
    loop position in 1..<body_order.len() {
        earlier: body_order[position - 1]
        later: body_order[position]
        if inputs.functions[earlier].module_identity == inputs.functions[later].module_identity && inputs.functions[earlier].key == inputs.functions[later].key -> return Err("Core function `{inputs.functions[later].key}` of {module_text(inputs.module_table, inputs.functions[later].module_identity)} is checked twice")
    }
    module_bodies := [U32:[Int]]{}
    loop (position, index) in body_order {
        identity: inputs.functions[index].module_identity.id
        if module_bodies.get(identity) == None -> module_bodies[identity] = [Int]{}
        module_bodies[identity].push(position)
    }
    packets := [Int:SemaComptimeFunctionResult]{}
    // Every row's tree interns into one writer, so a subtree that recurs
    // across rows and sections is stored once.
    writer := record_tree_writer()
    module_keys := [RecordValue]{}
    module_rows := [[U8]]{}
    loop index in module_order {
        whole := inputs.modules[index].copy()
        positions: module_bodies.get(whole.module_identity.id) ?? [Int]{}
        bodies := [FnBody]{}
        loop position in positions -> bodies.push(inputs.functions[body_order[position]].copy())
        split := [SemaComptimeFunctionResult]{}
        row := sema_core_body_packets(whole, bodies, split)
        loop split.len() > 0 {
            packet := split.pop() ?? break
            packets[positions[split.len()]] = packet
        }
        _: jet_driver_core_record_rebase_imports(row.imports, graph_modules)
        // Its exports as its registration row writes them (below): no reader
        // of a checked row's exports takes a body from their declarations.
        jet_driver_core_record_export_headers(row.exports)
        module_rows.push(record_tree_add(writer, row.encode()))
    }
    // A registration row whose source text is the Core source it was checked
    // from (`inputs.sources`) is written without it: the jet that loads the
    // record embeds that source, and the loader gives the row its text back
    // (Loader.jet jet_driver_core_record_parsed_unit). The module key says so.
    registration_rows := [[U8]]{}
    loop module_row_index in module_order {
        identity: inputs.modules[module_row_index].module_identity
        index: registration_at.get(identity.id) ?? return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no registration module")
        registration := inputs.registration_modules[index].copy()
        _: jet_driver_core_record_rebase_registration(registration, graph_modules) ?? return Err(err)
        checked_from: inputs.sources.get(registration.source_file) ?? ""
        embedded: registration.source != "" && checked_from == registration.source
        if embedded -> registration.source = ""
        // An export's declaration is written as its header (callable bodies
        // left out, as the incremental check's module headers have them,
        // JetSema CheckProgram.jet sema_incremental_item_header): a check
        // reads another module's export for its header only, and a Core
        // body a compile takes is its checked packet (section 5).
        jet_driver_core_record_export_headers(registration.exports)
        module_keys.push(RecordValue.Map{fields: [RecordField]{
            RecordField{name: "embedded_source", value: RecordValue.Bool{value: embedded}},
            RecordField{name: "identity", value: RecordValue.Str{value: module_text(inputs.module_table, identity)}},
            RecordField{name: "name", value: RecordValue.Str{value: registration.module_name.copy()}},
        }})
        registration_rows.push(record_tree_add(writer, registration.encode()))
    }
    decl_rows := [[U8]]{}
    decl_keys: inputs.decls.rows.key
    decl_kinds: inputs.decls.rows.kind
    loop (index, key) in decl_keys {
        decl_rows.push(record_tree_add(writer, DeclRow{key: key.copy(), kind: decl_kinds[index]}.encode()))
    }
    // Each Core module's comptime values, in the order the check landed them.
    // The entry's, and the canonical effect module's (every compile registers
    // and evaluates it afresh), are not Core's.
    module_values := [U32:[SemaComptimeItemValue]]{}
    core_values := 0
    loop value in inputs.comptime_values {
        if record_at.get(value.module_identity.id) == None -> next
        if module_values.get(value.module_identity.id) == None -> module_values[value.module_identity.id] = [SemaComptimeItemValue]{}
        module_values[value.module_identity.id].push(value.copy())
        core_values += 1
    }
    value_rows := [[U8]]{}
    loop index in module_order {
        module_row: inputs.modules[index]
        values: module_values.get(module_row.module_identity.id) ?? [SemaComptimeItemValue]{}
        value_rows.push(record_tree_add(writer, values.encode()))
    }
    // Each Core module's Core usage, as the check's walk of its bodies noted
    // it (the entry's is not Core's).
    usage_at := [U32:Int]{}
    loop (index, usage) in inputs.core_usage -> usage_at[usage.module_identity.id] = index
    usage_rows := [[U8]]{}
    loop index in module_order {
        identity: inputs.modules[index].module_identity
        at: usage_at.get(identity.id) ?? return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no Core usage row")
        usage_rows.push(record_tree_add(writer, inputs.core_usage[at].encode()))
    }
    // Each Core module's reach, as its source scan and its lazy parse found
    // it. The Prelude modules sema injects (the original error module) are
    // no loader's unit and spell nothing to it: theirs is empty.
    reach_at := [U32:Int]{}
    loop (index, row) in inputs.core_reach {
        if reach_at.get(row.module_identity.id) != None -> return Err("Core module {module_text(inputs.module_table, row.module_identity)} has two reach rows")
        reach_at[row.module_identity.id] = index
    }
    reach_rows := [[U8]]{}
    loop index in module_order {
        identity: inputs.modules[index].module_identity
        if reach_at.get(identity.id) == .Val(at) {
            reach_rows.push(record_tree_add(writer, inputs.core_reach[at].reach.encode()))
            next
        }
        if inputs.modules[index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY -> return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no reach row")
        empty: JetDriverCoreModuleReach{demand: jet_driver_empty_core_identifier_demand(), words: jet_driver_unit_no_words()}
        reach_rows.push(record_tree_add(writer, empty.encode()))
    }
    // Each Core module's taint crossings, as walking its bodies gives them
    // to any program (the entry's are not Core's).
    crossing_at := [U32:Int]{}
    loop (index, crossings) in inputs.core_crossings -> crossing_at[crossings.module_identity.id] = index
    crossing_rows := [[U8]]{}
    loop index in module_order {
        identity: inputs.modules[index].module_identity
        at: crossing_at.get(identity.id) ?? return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no crossing row")
        crossing_rows.push(record_tree_add(writer, inputs.core_crossings[at].encode()))
    }
    // Each Core module's effect rows, as walking its bodies gives them.
    effect_at := [U32:Int]{}
    loop (index, effects) in inputs.core_effects -> effect_at[effects.module_identity.id] = index
    effect_rows := [[U8]]{}
    loop index in module_order {
        identity: inputs.modules[index].module_identity
        at: effect_at.get(identity.id) ?? return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no effect row")
        effect_rows.push(record_tree_add(writer, inputs.core_effects[at].encode()))
    }
    body_keys := [RecordValue]{}
    body_rows := [[U8]]{}
    loop (position, index) in body_order {
        held: packets.get(position) ?? return Err("Core function `{inputs.functions[index].key}` belongs to no recorded Core module")
        packet: sema_core_body_packet_stored(held.move()) ?? return Err(err)
        body_keys.push(RecordValue.Map{fields: [RecordField]{RecordField{name: "module", value: RecordValue.Str{value: module_text(inputs.module_table, packet.module_identity)}}, RecordField{name: "key", value: RecordValue.Str{value: packet.function_key.copy()}}}})
        body_rows.push(record_tree_add(writer, packet.encode()))
    }
    // Row 0 is the empty identity no module has; every table interns it.
    table_rows: loop row in 1..<module_count(inputs.module_table) -> RecordValue.Str{value: inputs.module_table.identities.texts[row].copy()}
    // The symbol ranges a compile that takes the record's modules reserves,
    // each with its keys (sections 10 and 11). A routine the check generated
    // into a Core module (a Prelude error conversion a `?` there demanded,
    // FailureLaw.jet sema_inject_prelude_error_conversions) has a body but no
    // registered symbol: its key joins its module's range, so a compile that
    // takes the module finds the body by it (CoreRecordRebase.jet
    // jet_driver_core_record_take).
    recorded: loop index in module_order -> inputs.modules[index].module_identity
    reserved := sema_registration_reserved_symbols(inputs.symbols, recorded)
    loop index in body_order {
        if symbol_find(inputs.symbols, inputs.functions[index].key) != None -> next
        at := -1
        loop (slot, range) in reserved {
            if range.module_identity == inputs.functions[index].module_identity -> at = slot
        }
        if at < 0 -> return Err("Core function `{inputs.functions[index].key}` has no symbol, and its module {module_text(inputs.module_table, inputs.functions[index].module_identity)} has no symbol range to hold one")
        if reserved[at].keys.texts.len() >= reserved[at].bound -> return Err("Core function `{inputs.functions[index].key}` has no symbol, and its module's symbol range at {reserved[at].base} is full ({reserved[at].bound} keys)")
        _ := symbol_keys_intern(reserved[at], inputs.functions[index].key)
    }
    symbol_ranges := [RecordValue]{}
    symbol_rows := [[U8]]{}
    loop range in reserved {
        symbol_ranges.push(RecordValue.Map{fields: [RecordField]{
            RecordField{name: "module", value: RecordValue.Int{value: Int{range.module_identity.id}}},
            RecordField{name: "base", value: RecordValue.Int{value: range.base}},
            RecordField{name: "bound", value: RecordValue.Int{value: range.bound}},
        }})
        rows: jet_driver_core_record_symbol_rows(range) ?? return Err(err)
        symbol_rows.push(record_tree_add(writer, rows.encode()))
    }
    decls: decl_rows.len()
    header: RecordValue.Map{fields: [RecordField]{
        RecordField{name: "compiler", value: RecordValue.Str{value: compiler}},
        RecordField{name: "target", value: RecordValue.Str{value: target}},
        RecordField{name: "core_digest", value: RecordValue.Str{value: jet_driver_core_record_digest(inputs, entry_file)}},
        RecordField{name: "modules", value: RecordValue.Int{value: module_order.len()}},
        RecordField{name: "bodies", value: RecordValue.Int{value: body_order.len()}},
        RecordField{name: "decls", value: RecordValue.Int{value: decls}},
        RecordField{name: "values", value: RecordValue.Int{value: core_values}},
    }}
    tables := record_tree_tables(writer.move(), [[[U8]]]{module_rows.move(), body_rows.move(), registration_rows.move(), decl_rows.move(), value_rows.move(), symbol_rows.move(), usage_rows.move(), reach_rows.move(), crossing_rows.move(), effect_rows.move()})
    if tables.problem == .Val(problem) -> return Err("the Core record's rows have no tree form: {problem}")
    // Taken back in the reverse of the order they went in.
    effect_elements: tables.rows.pop() ?? [RecordValue]{}
    crossing_elements: tables.rows.pop() ?? [RecordValue]{}
    reach_elements: tables.rows.pop() ?? [RecordValue]{}
    usage_elements: tables.rows.pop() ?? [RecordValue]{}
    symbol_elements: tables.rows.pop() ?? [RecordValue]{}
    value_elements: tables.rows.pop() ?? [RecordValue]{}
    decl_elements: tables.rows.pop() ?? [RecordValue]{}
    registration_elements: tables.rows.pop() ?? [RecordValue]{}
    body_elements: tables.rows.pop() ?? [RecordValue]{}
    module_elements: tables.rows.pop() ?? [RecordValue]{}
    sections: [RecordSection]{
        RecordSection{id: JET_CORE_RECORD_HEADER, elements: [RecordValue]{header}},
        RecordSection{id: JET_CORE_RECORD_MODULE_KEYS, elements: module_keys.move()},
        RecordSection{id: JET_CORE_RECORD_MODULE_ROWS, elements: module_elements.move()},
        RecordSection{id: JET_CORE_RECORD_BODY_KEYS, elements: body_keys.move()},
        RecordSection{id: JET_CORE_RECORD_BODY_ROWS, elements: body_elements.move()},
        RecordSection{id: JET_CORE_RECORD_REGISTRATION_ROWS, elements: registration_elements.move()},
        RecordSection{id: JET_CORE_RECORD_DECL_ROWS, elements: decl_elements.move()},
        RecordSection{id: JET_CORE_RECORD_VALUE_ROWS, elements: value_elements.move()},
        RecordSection{id: JET_CORE_RECORD_MODULE_TABLE, elements: table_rows},
        RecordSection{id: JET_CORE_RECORD_SYMBOL_RANGES, elements: symbol_ranges.move()},
        RecordSection{id: JET_CORE_RECORD_SYMBOL_KEYS, elements: symbol_elements.move()},
        RecordSection{id: JET_CORE_RECORD_TREE_STRINGS, elements: tables.strings.move()},
        RecordSection{id: JET_CORE_RECORD_TREE_SHAPES, elements: tables.shapes.move()},
        RecordSection{id: JET_CORE_RECORD_TREE_NODES, elements: tables.nodes.move()},
        RecordSection{id: JET_CORE_RECORD_USAGE_ROWS, elements: usage_elements.move()},
        RecordSection{id: JET_CORE_RECORD_MODULE_REACH, elements: reach_elements.move()},
        RecordSection{id: JET_CORE_RECORD_CROSSING_ROWS, elements: crossing_elements.move()},
        RecordSection{id: JET_CORE_RECORD_EFFECT_ROWS, elements: effect_elements.move()},
    }
    encoded: record_encode(JET_CORE_RECORD_SCHEMA, sections)
    bytes: encoded.bytes ?? return Err(encoded.problem ?? "the Core record has no byte form")
    Ok(bytes)
}

// One Core or Prelude source the record's digest reads.
JetDriverCoreRecordSource: struct {
    path: String
    text: String
}

// The digest of the Core and Prelude sources the record was checked from
// (`inputs.sources`): each source path and text, in path order, the check's
// entry file left out.
jet_driver_core_record_digest: fn(inputs: JetDriverLoweringInputs, entry_file: String) -> String Never! {
    files := [JetDriverCoreRecordSource]{}
    loop (path, text) in inputs.sources {
        if path != entry_file -> files.push(JetDriverCoreRecordSource{path: path.copy(), text: text.copy()})
    }
    // Popped from the back, so the last path sorts first.
    files.sort_by(fn(left: JetDriverCoreRecordSource, right: JetDriverCoreRecordSource) { right.path <=> left.path })
    fields := [String]{}
    loop files.len() > 0 {
        file := files.pop() ?? break
        fields.push(file.path.move())
        fields.push(file.text.move())
    }
    record_key_digest(fields)
}

// Opens a `jet.core/v15` record: the format and checksum are verified, the
// header, the module keys and the module table are read, and the tree tables
// placed. No other row is decoded.
jet_driver_core_record_open: fn(bytes: [U8]) -> JetDriverCoreRecord Err! {
    jet_driver_core_record_read(record_open_schema(bytes, JET_CORE_RECORD_SCHEMA))
}

// Opens the record part of the running jet as `jet_driver_core_record_open`
// does, but for its checksum: the part is one of the executable's bytes,
// which are the toolchain's identity, so a hash of every byte on each compile
// would prove nothing more and cost the compile its time.
jet_driver_core_record_open_embedded: fn(bytes: [U8]) -> JetDriverCoreRecord Err! {
    jet_driver_core_record_read(record_open_schema_trusted(bytes, JET_CORE_RECORD_SCHEMA))
}

// The header, module keys and module table of the opened record `opened`,
// and where its tree tables lie.
jet_driver_core_record_read: fn(opened: RecordReaderResult) -> JetDriverCoreRecord Err! {
    reader: opened.reader ?? return Err(opened.problem ?? "the Core record can't be opened")
    header: jet_driver_core_record_value(reader, JET_CORE_RECORD_HEADER, 0) ?? return Err(err)
    placed: record_tree_view(reader, JET_CORE_RECORD_TREE_STRINGS, JET_CORE_RECORD_TREE_SHAPES, JET_CORE_RECORD_TREE_NODES)
    tree: placed.view ?? return Err("the Core record's tree tables don't open: {placed.problem ?? ""}")
    record := JetDriverCoreRecord{
        reader: reader,
        tree: tree,
        compiler: jet_driver_core_record_text(header, "compiler") ?? return Err(err),
        target: jet_driver_core_record_text(header, "target") ?? return Err(err),
        core_digest: jet_driver_core_record_text(header, "core_digest") ?? return Err(err),
        module_names: [String]{},
        module_identities: [ModuleID]{},
        module_embedded_sources: [Bool]{},
        module_rows: [U32:Int]{},
        module_table: module_table(),
    }
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_TABLE) {
        value: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_MODULE_TABLE, index) ?? return Err(err)
        text: record_value_as_str(value)
        identity: text.value ?? return Err(text.problem ?? "the Core record's module table row {index} is not text")
        if module_index(module_intern(record.module_table, identity)) != index + 1 -> return Err("the Core record's module table names `{identity}` twice")
    }
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_KEYS) {
        key: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_MODULE_KEYS, index) ?? return Err(err)
        identity: jet_driver_core_record_module_id(record.module_table, key, "identity") ?? return Err(err)
        if record.module_rows.get(identity.id) != None -> return Err("the Core record keys module {module_text(record.module_table, identity)} twice")
        record.module_rows[identity.id] = index
        record.module_names.push(jet_driver_core_record_text(key, "name") ?? return Err(err))
        record.module_identities.push(identity)
        record.module_embedded_sources.push(jet_driver_core_record_bool(key, "embedded_source") ?? return Err(err))
    }
    bodies: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_KEYS)
    ranges: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_SYMBOL_RANGES)
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_SYMBOL_KEYS) != ranges -> return Err("the Core record has {ranges} symbol ranges but a different number of symbol key rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of module rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_REGISTRATION_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of registration rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_ROWS) != bodies -> return Err("the Core record has {bodies} body keys but a different number of body rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_VALUE_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of value rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_USAGE_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of usage rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_REACH) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of reach rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_CROSSING_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of crossing rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_EFFECT_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of effect rows")
    Ok(record)
}

// The record's body key `index` (section 4).
jet_driver_core_record_body_key: fn(record: JetDriverCoreRecord, index: Int) -> JetDriverCoreRecordBodyKey Err! {
    value: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_BODY_KEYS, index) ?? return Err(err)
    Ok(JetDriverCoreRecordBodyKey{owner: jet_driver_core_record_text(value, "module") ?? return Err(err), key: jet_driver_core_record_text(value, "key") ?? return Err(err)})
}

// The first body key of the module whose identity is `identity`, or the
// first after where its keys would be when it has none. Body keys sort by
// module identity, then key (jet_driver_core_record_write), so a module's
// keys are one run from here, and the search reads only the keys it
// compares.
jet_driver_core_record_module_first_body: fn(record: JetDriverCoreRecord, identity: String) -> Int Err! {
    low := 0
    high := jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_KEYS)
    loop low < high {
        middle: (low + high) >> 1
        probe: jet_driver_core_record_body_key(record, middle) ?? return Err(err)
        if (probe.owner <=> identity) == Ordering.Less {
            low = middle + 1
        } else {
            high = middle
        }
    }
    Ok(low)
}

// The symbol ranges a compile that takes the record's modules `taken`
// reserves (sections 10 and 11), as sema_registration_reserved_symbols gives
// them: each serial range (module 0) and each taken module's with its keys,
// every other module's bare. No key of a module the compile doesn't take is
// read.
jet_driver_core_record_symbols: fn(record: JetDriverCoreRecord, taken: [ModuleID]) -> [SymbolKeys] Err! {
    keyed := [U32:Bool]{}
    loop identity in taken -> keyed[identity.id] = true
    symbols := [SymbolKeys]{}
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_SYMBOL_RANGES) {
        range: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_SYMBOL_RANGES, index) ?? return Err(err)
        owner: jet_driver_core_record_int(range, "module") ?? return Err(err)
        base: jet_driver_core_record_int(range, "base") ?? return Err(err)
        bound: jet_driver_core_record_int(range, "bound") ?? return Err(err)
        keys := symbol_keys(base, bound)
        keys.module_identity = ModuleID{id: checked(U32{owner}) ?? return Err("the Core record's symbol range at {base} names no module id ({owner})")}
        if owner == 0 || keyed.get(keys.module_identity.id) != None {
            listed: jet_driver_core_record_tree(record, JET_CORE_RECORD_SYMBOL_KEYS, index) ?? return Err(err)
            rows: listed.decode<JetDriverCoreRecordSymbolRows>() ?? return Err("the Core record's symbol keys of the range at {base} don't decode: {sema_core_record_field_errors(err)}")
            _: jet_driver_core_record_symbol_keys(keys, rows, base) ?? return Err(err)
        }
        symbols.push(keys.move())
    }
    Ok(symbols)
}

// Interns the record's module table into a compile's empty `table`, in id
// order, so each ModuleID a taken row names is the compile's id for the same
// module identity.
jet_driver_core_record_intern_modules: fn(table: &ModuleTable, record: JetDriverCoreRecord) -> Int Err! {
    if module_count(table) != 1 -> return Err("the Core record's module table must be interned before the compile interns a module")
    loop row in 1..<module_count(record.module_table) {
        identity: record.module_table.identities.texts[row]
        if module_index(module_intern(table, identity)) != row -> return Err("the Core record's module table names `{identity}` twice")
    }
    Ok(module_count(table) - 1)
}

// The checked row of the record's module `index` (in module key order).
jet_driver_core_record_module: fn(record: JetDriverCoreRecord, index: Int) -> SemaGraphModuleResult Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_MODULE_ROWS, index) ?? return Err(err)
    row: tree.decode<SemaGraphModuleResult>() ?? return Err("Core module `{record.module_names[index]}` doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(row)
}

// The body packet of the record's function `index` (in body key order): the
// checked body with the facts its check recorded.
jet_driver_core_record_body: fn(record: JetDriverCoreRecord, index: Int) -> SemaComptimeFunctionResult Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_BODY_ROWS, index) ?? return Err(err)
    packet: tree.decode<SemaComptimeFunctionResult>() ?? return Err("Core body packet {index} doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(packet)
}

// The finalized registration module of the record's module `index` (in
// module key order).
jet_driver_core_record_registration: fn(record: JetDriverCoreRecord, index: Int) -> SemaRegistrationModule Err! {
    tree: jet_driver_core_record_registration_tree(record, index) ?? return Err(err)
    registration: jet_driver_core_record_registration_decode(tree, record.module_names[index]) ?? return Err(err)
    Ok(registration)
}

// The tree of the registration row of the record's module `index`, read by
// the parse job that decodes it (Loader.jet JetDriverParseJob.Record).
jet_driver_core_record_registration_tree: fn(record: JetDriverCoreRecord, index: Int) -> Dyn Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_REGISTRATION_ROWS, index) ?? return Err(err)
    Ok(tree)
}

// The bytes the registration row of the record's module `index` takes in
// the record (its stored subtrees left out): the weight of its parse job.
jet_driver_core_record_registration_size: fn(record: JetDriverCoreRecord, index: Int) -> Int Never! {
    section: record_section_index(record.reader, JET_CORE_RECORD_REGISTRATION_ROWS) ?? return 0
    first: record.reader.firsts[section]
    record.reader.bounds[first + index + 1] - record.reader.bounds[first + index]
}

// A registration row's tree decoded; `name` is its module's name.
jet_driver_core_record_registration_decode: fn(tree: Dyn, name: String) -> SemaRegistrationModule Err! {
    registration: tree.decode<SemaRegistrationModule>() ?? return Err("Core module `{name}` has a registration row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(registration)
}

// The record's declaration table, keyed: row `i` is the row the record's
// bodies name as DeclID `i`.
jet_driver_core_record_decls: fn(record: JetDriverCoreRecord) -> DeclTable Err! {
    table := DeclTable{}
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_DECL_ROWS) {
        row: jet_driver_core_record_decl(record, index) ?? return Err(err)
        _: decl_table_add_row(table, row.key, row.kind)
    }
    decl_table_index(table)
    Ok(table)
}

jet_driver_core_record_decl: fn(record: JetDriverCoreRecord, index: Int) -> DeclRow Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_DECL_ROWS, index) ?? return Err(err)
    row: tree.decode<DeclRow>() ?? return Err("the Core record's declaration row {index} doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(row)
}

// The comptime values of the record's module `index` (in module key order),
// in the order the Core check landed them.
jet_driver_core_record_values: fn(record: JetDriverCoreRecord, index: Int) -> [SemaComptimeItemValue] Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_VALUE_ROWS, index) ?? return Err(err)
    values: tree.decode<[SemaComptimeItemValue]>() ?? return Err("Core module `{record.module_names[index]}` has value rows that don't decode: {sema_core_record_field_errors(err)}")
    Ok(values)
}

// The Core usage of the record's module `index` (in module key order), as
// the Core check's walk of its bodies noted it.
jet_driver_core_record_usage: fn(record: JetDriverCoreRecord, index: Int) -> SemaCoreModuleUsageResult Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_USAGE_ROWS, index) ?? return Err(err)
    usage: tree.decode<SemaCoreModuleUsageResult>() ?? return Err("Core module `{record.module_names[index]}` has a usage row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(usage)
}

// The reach of the record's module `index` (in module key order): the
// identifier demand the Core check's scan of its source found and the words
// its lazy parse gave (jet_driver_reach_recorded_words).
jet_driver_core_record_reach: fn(record: JetDriverCoreRecord, index: Int) -> JetDriverCoreModuleReach Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_MODULE_REACH, index) ?? return Err(err)
    reach: tree.decode<JetDriverCoreModuleReach>() ?? return Err("Core module `{record.module_names[index]}` has a reach row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(reach)
}

// The taint crossings of the record's module `index` (in module key order),
// as walking its bodies gave them.
jet_driver_core_record_crossings: fn(record: JetDriverCoreRecord, index: Int) -> SemaCoreCrossingResult Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_CROSSING_ROWS, index) ?? return Err(err)
    crossings: tree.decode<SemaCoreCrossingResult>() ?? return Err("Core module `{record.module_names[index]}` has a crossing row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(crossings)
}

// The effect rows of the record's module `index` (in module key order), as
// walking its bodies gave them.
jet_driver_core_record_effects: fn(record: JetDriverCoreRecord, index: Int) -> SemaCoreEffectResult Err! {
    tree: jet_driver_core_record_tree(record, JET_CORE_RECORD_EFFECT_ROWS, index) ?? return Err(err)
    effects: tree.decode<SemaCoreEffectResult>() ?? return Err("Core module `{record.module_names[index]}` has an effect row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(effects)
}

// The least bytes of rows that pay for one more read-back thread: a small
// record (a test's) reads back on one.
JET_DRIVER_CORE_RECORD_TRIP_MIN_BYTES_PER_THREAD: 1048576

// Reads every row of `bytes` back and encodes it again: each must give the
// tree it was read from (record_tree_difference, which holds a float the
// same by its bits, so a NaN constant reads back as itself), and each key
// must name its own row. The keys are checked in order; the rows, each
// independent of the others, on up to `threads` compiler threads
// (jet_driver_core_record_trips), and the first problem in record order is
// the one reported, whichever thread found it.
jet_driver_core_record_round_trip: fn(bytes: [U8], threads: CompilerThreads) -> JetDriverCoreRecordCounts Err! {
    record := jet_driver_core_record_open(bytes) ?? return Err(err)
    // Each body key names a keyed module and sorts after the one before it,
    // so each module's keys are the run its first-body search finds.
    bodies: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_KEYS)
    firsts := [U32:Int]{}
    previous := JetDriverCoreRecordBodyKey{owner: "", key: ""}
    loop index in 0..<bodies {
        body_key := jet_driver_core_record_body_key(record, index) ?? return Err(err)
        owner: module_find(record.module_table, body_key.owner) ?? return Err("Core body key {index} names {body_key.owner}, which the record's module table doesn't hold")
        if record.module_rows.get(owner.id) == None -> return Err("Core function `{body_key.key}` belongs to {body_key.owner}, which the record doesn't key")
        if index > 0 && (previous.owner <=> body_key.owner).then(previous.key <=> body_key.key) != Ordering.Less -> return Err("Core body key {index} (`{body_key.key}` of {body_key.owner}) doesn't sort after the key before it")
        if firsts.get(owner.id) == None -> firsts[owner.id] = index
        previous = body_key.move()
    }
    loop identity in record.module_identities {
        text: module_text(record.module_table, identity)
        found: jet_driver_core_record_module_first_body(record, text) ?? return Err(err)
        if firsts.get(identity.id) == .Val(first) && first != found -> return Err("Core module {text}'s body keys start at {first}, but a search for them finds {found}")
    }
    decls: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_DECL_ROWS)
    table: jet_driver_core_record_decls(record) ?? return Err(err)
    if table.rows.len() != decls -> return Err("the Core record's declaration table keeps {table.rows.len()} of its {decls} rows")
    _: jet_driver_core_record_symbols(record, record.module_identities) ?? return Err(err)
    modules: record.module_names.len()
    sections: jet_driver_core_record_section_sizes(record.reader)
    values := 0
    loop trip in jet_driver_core_record_trips(record, threads) {
        if trip.problem == .Val(problem) -> return Err(problem)
        values += trip.values
    }
    Ok(JetDriverCoreRecordCounts{modules: modules, bodies: bodies, registrations: modules, decls: decls, values: values, bytes: bytes.len(), sections: sections})
}

// One row of a round trip (jet_driver_core_record_round_trip): row `index`
// of the tree row section `id`.
JetDriverCoreRecordTripJob: struct {
    id: Int
    index: Int
}

// What one row's round trip found: the problem, if any, and the comptime
// values the row holds when it is a value row.
JetDriverCoreRecordTrip: struct {
    problem: String?
    values: Int
}

// The round trip of every row of `record`'s tree row sections, in record
// order: on compiler threads, heaviest row first, when the rows' bytes
// admit more than one.
jet_driver_core_record_trips: fn(record: &&JetDriverCoreRecord, threads: CompilerThreads) -> [JetDriverCoreRecordTrip] {
    owned := record.move()
    jobs := [JetDriverCoreRecordTripJob]{}
    weights := [Int]{}
    work := 0
    ids: [Int]{JET_CORE_RECORD_MODULE_ROWS, JET_CORE_RECORD_BODY_ROWS, JET_CORE_RECORD_REGISTRATION_ROWS, JET_CORE_RECORD_DECL_ROWS, JET_CORE_RECORD_VALUE_ROWS, JET_CORE_RECORD_USAGE_ROWS, JET_CORE_RECORD_MODULE_REACH, JET_CORE_RECORD_CROSSING_ROWS, JET_CORE_RECORD_EFFECT_ROWS, JET_CORE_RECORD_SYMBOL_KEYS}
    loop id in ids {
        section: record_section_index(owned.reader, id) ?? next
        first: owned.reader.firsts[section]
        loop index in 0..<record_section_elements(owned.reader, section) {
            weight: owned.reader.bounds[first + index + 1] - owned.reader.bounds[first + index]
            jobs.push(JetDriverCoreRecordTripJob{id: id, index: index})
            weights.push(weight)
            work += weight
        }
    }
    trips := [JetDriverCoreRecordTrip]{}
    workers: compiler_threads_admit(threads, jobs.len(), work, JET_DRIVER_CORE_RECORD_TRIP_MIN_BYTES_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop job in jobs -> trips.push(jet_driver_core_record_trip(owned, job.id, job.index))
        return trips
    }
    loop _ in 0..<jobs.len() -> trips.push(JetDriverCoreRecordTrip{problem: None, values: 0})
    shared_state: Shared{JetDriverCoreRecordTripShared{records: [JetDriverCoreRecord]{}, jobs: jobs.move(), order: compiler_threads_heaviest_first(weights)}}
    jet_driver_core_record_trip_fill(shared_state, owned)
    queue: Shared{JetDriverCoreRecordTripQueue{next: 0}}
    jet_driver_core_record_trippers(shared_state, queue, 0, workers, trips)
    trips
}

// What every read-back thread reads (jet_driver_core_record_trips): the
// record (the one row of its list, moved in), the rows, and the rows in
// claim order.
JetDriverCoreRecordTripShared: struct {
    records: [JetDriverCoreRecord]
    jobs: [JetDriverCoreRecordTripJob]
    order: [Int]
}

// The next unclaimed row rank, taken with one atomic add under a read guard
// each thread holds for its run.
JetDriverCoreRecordTripQueue: struct {
    next: Atomic<Int>
}

// One row's round trip, read back by one thread.
JetDriverCoreRecordTripDone: struct {
    job: Int
    trip: JetDriverCoreRecordTrip
}

jet_driver_core_record_trip_fill: fn(shared_state: Shared<JetDriverCoreRecordTripShared>, record: &&JetDriverCoreRecord) {
    permit: shared_state.guard_edit()
    permit.value.records.push(record)
}

// Runs read-back threads `from..<workers`, one task each, and moves each
// row's round trip a thread returned into its slot of `trips`.
jet_driver_core_record_trippers: fn(shared_state: Shared<JetDriverCoreRecordTripShared>, queue: Shared<JetDriverCoreRecordTripQueue>, from: Int, workers: Int, trips: &[JetDriverCoreRecordTrip]) {
    if from >= workers {
        return
    }
    task.group jet_driver_core_record_trip_threads {
        head: task jet_driver_core_record_trip_claimed(shared_state, queue)
        jet_driver_core_record_trippers(shared_state, queue, from + 1, workers, trips)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            trips[done.job] = done.trip.move()
        }
    }
}

// One thread: the round trips of the rows it claims, in claim order.
jet_driver_core_record_trip_claimed: fn(shared_state: Shared<JetDriverCoreRecordTripShared>, queue: Shared<JetDriverCoreRecordTripQueue>) -> [JetDriverCoreRecordTripDone] {
    inputs: shared_state.guard_read()
    claimed := [JetDriverCoreRecordTripDone]{}
    ranks: queue.guard_read()
    loop {
        rank: jet_driver_core_record_trip_claim(ranks.value)
        if rank >= inputs.value.order.len() -> break
        job: inputs.value.order[rank]
        // Passed straight through: a local binding of a guarded row would copy it.
        trip := jet_driver_core_record_trip(inputs.value.records[0], inputs.value.jobs[job].id, inputs.value.jobs[job].index)
        claimed.push(JetDriverCoreRecordTripDone{job: job, trip: trip.move()})
    }
    claimed
}

jet_driver_core_record_trip_claim: fn(queue: JetDriverCoreRecordTripQueue) -> Int { queue.next.add(1) }

// The round trip of row `index` of `record`'s tree row section `id`.
jet_driver_core_record_trip: fn(record: JetDriverCoreRecord, id: Int, index: Int) -> JetDriverCoreRecordTrip {
    values: jet_driver_core_record_trip_row(record, id, index) ?? return JetDriverCoreRecordTrip{problem: Val("{err}"), values: 0}
    JetDriverCoreRecordTrip{problem: None, values: values}
}

// Row `index` of `record`'s tree row section `id` read back, checked
// against its key and encoded again; the comptime values it holds when it
// is a value row.
jet_driver_core_record_trip_row: fn(record: JetDriverCoreRecord, id: Int, index: Int) -> Int Err! {
    stored: jet_driver_core_record_tree(record, id, index) ?? return Err(err)
    if id == {
        JET_CORE_RECORD_MODULE_ROWS -> {
            row: jet_driver_core_record_module(record, index) ?? return Err(err)
            if row.module_name != record.module_names[index] || row.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its row is `{row.module_name}`")
            if record_tree_difference(row.encode(), stored) == .Val(difference) -> return Err("Core module `{row.module_name}` encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_BODY_ROWS -> {
            body_key: jet_driver_core_record_body_key(record, index) ?? return Err(err)
            owner: module_find(record.module_table, body_key.owner) ?? return Err("Core body key {index} names {body_key.owner}, which the record's module table doesn't hold")
            packet: jet_driver_core_record_body(record, index) ?? return Err(err)
            if packet.function_key != body_key.key || packet.module_identity != owner -> return Err("Core body key {index} names `{body_key.key}` but its packet is `{packet.function_key}`")
            if packet.function == None -> return Err("Core body packet `{packet.function_key}` holds no body")
            if record_tree_difference(packet.encode(), stored) == .Val(difference) -> return Err("Core function `{packet.function_key}` encodes to another tree after a read, at packet{difference}")
        }
        JET_CORE_RECORD_REGISTRATION_ROWS -> {
            registration: jet_driver_core_record_registration(record, index) ?? return Err(err)
            if registration.module_name != record.module_names[index] || registration.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its registration row is `{registration.module_name}`")
            if record_tree_difference(registration.encode(), stored) == .Val(difference) -> return Err("Core module `{registration.module_name}`'s registration row encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_DECL_ROWS -> {
            row: jet_driver_core_record_decl(record, index) ?? return Err(err)
            if record_tree_difference(row.encode(), stored) == .Val(difference) -> return Err("the declaration `{row.key}` encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_VALUE_ROWS -> {
            module_values: jet_driver_core_record_values(record, index) ?? return Err(err)
            loop value in module_values {
                if value.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its value rows hold `{value.key}` of {module_text(record.module_table, value.module_identity)}")
            }
            if record_tree_difference(module_values.encode(), stored) == .Val(difference) -> return Err("Core module `{record.module_names[index]}`'s value rows encode to another tree after a read, at rows{difference}")
            return Ok(module_values.len())
        }
        JET_CORE_RECORD_USAGE_ROWS -> {
            usage: jet_driver_core_record_usage(record, index) ?? return Err(err)
            if usage.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its usage row is {module_text(record.module_table, usage.module_identity)}'s")
            if record_tree_difference(usage.encode(), stored) == .Val(difference) -> return Err("Core module `{record.module_names[index]}`'s usage row encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_MODULE_REACH -> {
            reach: jet_driver_core_record_reach(record, index) ?? return Err(err)
            if record_tree_difference(reach.encode(), stored) == .Val(difference) -> return Err("Core module `{record.module_names[index]}`'s reach row encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_CROSSING_ROWS -> {
            crossings: jet_driver_core_record_crossings(record, index) ?? return Err(err)
            if crossings.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its crossing row is {module_text(record.module_table, crossings.module_identity)}'s")
            if record_tree_difference(crossings.encode(), stored) == .Val(difference) -> return Err("Core module `{record.module_names[index]}`'s crossing row encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_EFFECT_ROWS -> {
            effects: jet_driver_core_record_effects(record, index) ?? return Err(err)
            if effects.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its effect row is {module_text(record.module_table, effects.module_identity)}'s")
            if record_tree_difference(effects.encode(), stored) == .Val(difference) -> return Err("Core module `{record.module_names[index]}`'s effect row encodes to another tree after a read, at row{difference}")
        }
        JET_CORE_RECORD_SYMBOL_KEYS -> {
            rows: stored.decode<JetDriverCoreRecordSymbolRows>() ?? return Err("the Core record's symbol keys of range {index} don't decode: {sema_core_record_field_errors(err)}")
            if record_tree_difference(rows.encode(), stored) == .Val(difference) -> return Err("the Core record's symbol keys of range {index} encode to another tree after a read, at rows{difference}")
        }
        else -> return Err("the Core record has no tree row section {id}")
    }
    Ok(0)
}

// The sections of the record `bytes` this jet just wrote, read without its
// checksum or any row, so a writer reports its sizes before a read-back.
jet_driver_core_record_sizes: fn(bytes: [U8]) -> [JetDriverCoreRecordSectionSize] Err! {
    opened: record_open_schema_trusted(bytes, JET_CORE_RECORD_SCHEMA)
    reader: opened.reader ?? return Err(opened.problem ?? "the Core record can't be opened")
    Ok(jet_driver_core_record_section_sizes(reader))
}

// Each section of `reader`, in record order, with the bytes its elements
// take: element `i` of section `s` spans bounds[firsts[s] + i] up to the
// next bound.
jet_driver_core_record_section_sizes: fn(reader: RecordReader) -> [JetDriverCoreRecordSectionSize] Never! {
    sizes := [JetDriverCoreRecordSectionSize]{}
    loop (section, id) in reader.ids {
        first: reader.firsts[section]
        elements: record_section_elements(reader, section)
        largest := 0
        loop index in 0..<elements {
            size: reader.bounds[first + index + 1] - reader.bounds[first + index]
            if size > largest -> largest = size
        }
        sizes.push(JetDriverCoreRecordSectionSize{id: id, elements: elements, bytes: reader.bounds[first + elements] - reader.bounds[first], largest: largest})
    }
    sizes
}

jet_driver_core_record_count: fn(reader: RecordReader, id: Int) -> Int Never! {
    section: record_section_index(reader, id) ?? return 0
    record_section_elements(reader, section)
}

jet_driver_core_record_value: fn(reader: RecordReader, id: Int, index: Int) -> RecordValue Err! {
    read: record_element(reader, id, index)
    value: read.value ?? return Err(read.problem ?? "the Core record has no element {index} in section {id}")
    Ok(value)
}

// Row `index` of the record's tree row section `id`, as its tree.
jet_driver_core_record_tree: fn(record: JetDriverCoreRecord, id: Int, index: Int) -> Dyn Err! {
    read: record_tree_row(record.reader, record.tree, id, index)
    tree: read.value ?? return Err(read.problem ?? "the Core record has no row {index} in section {id}")
    Ok(tree)
}

jet_driver_core_record_text: fn(value: RecordValue, name: String) -> String Err! {
    field: record_value_field(value, name)
    found: field.value ?? return Err(field.problem ?? "the Core record has no `{name}`")
    text: record_value_as_str(found)
    Ok(text.value ?? return Err(text.problem ?? "the Core record's `{name}` is not text"))
}

jet_driver_core_record_int: fn(value: RecordValue, name: String) -> Int Err! {
    field: record_value_field(value, name)
    found: field.value ?? return Err(field.problem ?? "the Core record has no `{name}`")
    number: record_value_as_int(found)
    Ok(number.value ?? return Err(number.problem ?? "the Core record's `{name}` is not an integer"))
}

jet_driver_core_record_bool: fn(value: RecordValue, name: String) -> Bool Err! {
    field: record_value_field(value, name)
    found: field.value ?? return Err(field.problem ?? "the Core record has no `{name}`")
    flag: record_value_as_bool(found)
    Ok(flag.value ?? return Err(flag.problem ?? "the Core record's `{name}` is not a boolean"))
}

// The ModuleID of field `name` of `value`, an identity of the record's
// module `table`.
jet_driver_core_record_module_id: fn(table: ModuleTable, value: RecordValue, name: String) -> ModuleID Err! {
    identity: jet_driver_core_record_text(value, name) ?? return Err(err)
    Ok(module_find(table, identity) ?? return Err("the Core record's `{name}` names {identity}, which its module table doesn't hold"))
}
