// The precompiled Core record, schema `jet.core/v5`: Core and the Prelude
// checked alone as one closed program (`jet self devtools core-record`), in
// the compiler's one record format (JetFoundation RecordCodec.jet). Each row
// element is the canonical CBOR of a checked row's derived encoding, so the
// record holds what sema produced, field for field, with no codec written by
// hand. A reader opens the record once, reads the small key and module
// table sections and decodes a row only when it is asked for one.
//
// Sections, in id order:
//   1 header: one map (compiler identity, target, the digest of the Core and
//     Prelude sources, and the module, body, declaration and value counts)
//   2 module keys: one map per Core module (name, identity), sorted by name
//   3 module rows: the checked module row of each module key, its function
//     bodies and the facts each body recorded left out (they are section 5's)
//   4 body keys: one map per checked Core function (module identity, key),
//     sorted by module identity, then key
//   5 body packets: the checked body of each body key with the facts its
//     check recorded, split off its module's row at write time
//     (JetSema CoreRecordBodies.jet), so a compile that takes a body takes
//     its facts with it
//   6 registration rows: the finalized registration module of each module
//     key (declarations, symbols, impls, imports and exports, its source
//     tree with every edit applied)
//   7 declaration rows: the check's declaration table, one row per DeclID
//     in row order, so a body's DeclID names the row it was checked against
//   8 value rows: the comptime values of each module key (its constants,
//     field defaults, marker arguments, checked text and the local values of
//     its bodies), in the order the check landed them, so a compile that
//     takes the module evaluates none of them again
//   9 module table: the identity text of each ModuleID the rows name, in id
//     order from the first module (the check's own load interned them); a
//     compile that takes the record's rows interns it first
//     (jet_driver_core_record_intern_modules), so each row's ModuleIDs are
//     the compile's own
//  10 symbol ranges: one map per range of the check's symbol table a compile
//     that takes the record reserves (sema_registration_reserved_symbols:
//     each recorded module's and the serial ones with their keys, every
//     other module's bare): its ModuleID (0 for a serial range), base and
//     bound, in base order
//  11 symbol keys: the keys of each range of section 10, row 1 onward, so
//     each SymbolID a row names is the compile's id for the same key
// A row names another module by its module key position (section 2), not by
// the check's graph index, and a body names declarations by section 7's
// rows; a graph that takes a row rebases its module indexes
// (CoreRecordRebase.jet), and sema rebases a taken body's DeclIDs (JetSema
// CoreRecordBodies.jet). Every row decodes under sema's
// SEMA_CORE_RECORD_CBOR, the one set of limits a record row reads under.
use {
    core_record_cbor: core.encoding.cbor
    jet_foundation.[DeclRow, DeclTable, FnBody, ModuleID, ModuleTable, RecordField, RecordReader, RecordReaderResult, RecordSection, RecordValue, SymbolKeys, decl_table_add_row, decl_table_index, module_count, module_find, module_index, module_intern, module_table, module_text, record_element, record_encode, record_key_digest, record_open_schema, record_open_schema_trusted, record_section_elements, record_section_index, record_value_as_int, record_value_as_list, record_value_as_str, record_value_field, symbol_keys, symbol_keys_intern]
    jet_sema.[SEMA_CORE_RECORD_CBOR, SemaComptimeFunctionResult, SemaComptimeItemValue, SemaGraphModuleResult, SemaRegistrationModule, sema_core_body_packets, sema_core_record_field_errors, sema_registration_reserved_symbols]
}

JET_CORE_RECORD_SCHEMA: "jet.core/v5"
JET_CORE_RECORD_HEADER: 1
JET_CORE_RECORD_MODULE_KEYS: 2
JET_CORE_RECORD_MODULE_ROWS: 3
JET_CORE_RECORD_BODY_KEYS: 4
JET_CORE_RECORD_BODY_ROWS: 5
JET_CORE_RECORD_REGISTRATION_ROWS: 6
JET_CORE_RECORD_DECL_ROWS: 7
JET_CORE_RECORD_VALUE_ROWS: 8
JET_CORE_RECORD_MODULE_TABLE: 9
JET_CORE_RECORD_SYMBOL_RANGES: 10
JET_CORE_RECORD_SYMBOL_KEYS: 11

// An open record: its verified reader and the two key columns, in element
// order, with each module key's position by ModuleID, the module table its
// rows' ModuleIDs index and the symbol ranges a compile that takes its rows
// reserves.
JetDriverCoreRecord: struct {
    reader: RecordReader
    compiler: String
    target: String
    core_digest: String
    module_names: [String]
    module_identities: [ModuleID]
    module_rows: [U32:Int]
    body_modules: [ModuleID]
    body_keys: [String]
    module_table: ModuleTable
    symbols: [SymbolKeys]
}

// What a round trip read back: each section's row count and the record's
// size, with each section's share of it.
JetDriverCoreRecordCounts: struct {
    modules: Int
    bodies: Int
    registrations: Int
    decls: Int
    values: Int
    bytes: Int
    sections: [JetDriverCoreRecordSectionSize]
}

// One section of a record: its id, its element count, the bytes its
// elements take together and the bytes of its largest element.
JetDriverCoreRecordSectionSize: struct {
    id: Int
    elements: Int
    bytes: Int
    largest: Int
}

// The record of the closed Core program `inputs` (the Core check stopped
// before lowering, under `every_core_body`, so its registration modules are
// kept), for the compiler `compiler` and the target `target`. The check's own
// entry module (one import of each public Core module) is left out, but for
// its rows of the declaration table, which keeps its row order, and so is the
// canonical effect module (every compile registers and checks it afresh, so
// it has no checked row). Two writes of the same inputs give the same bytes.
jet_driver_core_record_write: fn(inputs: JetDriverLoweringInputs, compiler: String, target: String) -> [U8] Err! {
    entry_file := ""
    // Each Core module's row of `inputs.modules`, by name, then identity.
    module_order := [Int]{}
    checked := [U32:Bool]{}
    loop (index, module_row) in inputs.modules {
        if module_row.module_identity == inputs.entry_module_identity {
            entry_file = module_row.source_file.copy()
            next
        }
        if checked.get(module_row.module_identity.id) != None -> return Err("Core module `{module_row.module_name}` ({module_text(inputs.module_table, module_row.module_identity)}) is checked twice")
        checked[module_row.module_identity.id] = true
        module_order.push(index)
    }
    module_order.sort_by(fn(left: Int, right: Int) { (inputs.modules[left].module_name <=> inputs.modules[right].module_name).then(module_text(inputs.module_table, inputs.modules[left].module_identity) <=> module_text(inputs.module_table, inputs.modules[right].module_identity)) })
    // The check's graph names modules by its own module index; the record
    // names them by module key position, so each row's indexes are rebased
    // to it (CoreRecordRebase.jet) before it is encoded.
    record_at := [U32:Int]{}
    loop (position, index) in module_order -> record_at[inputs.modules[index].module_identity.id] = position
    registration_at := [U32:Int]{}
    graph_modules := [Int]{}
    unchecked := [String]{}
    loop (index, registration) in inputs.registration_modules {
        graph_modules.push(record_at.get(registration.module_identity.id) ?? -1)
        if registration.module_identity == inputs.entry_module_identity || registration.module_identity == inputs.canonical_effect_module_identity -> next
        if registration_at.get(registration.module_identity.id) != None -> return Err("Core module `{registration.module_name}` ({module_text(inputs.module_table, registration.module_identity)}) is registered twice")
        registration_at[registration.module_identity.id] = index
        if record_at.get(registration.module_identity.id) == None -> unchecked.push("`{registration.module_name}` ({module_text(inputs.module_table, registration.module_identity)})")
    }
    if unchecked.len() > 0 -> return Err("the Core check registered {registration_at.len()} modules but checked {module_order.len()}; registered, never checked: {unchecked.join(", ")}")
    if registration_at.len() != module_order.len() -> return Err("the Core check registered {registration_at.len()} modules but checked {module_order.len()}")
    // Each Core body's row of `inputs.functions`, by module identity, then
    // key. Its packet (the body and the facts its check recorded) is split
    // off its module's row (sema_core_body_packets) before the row is
    // encoded.
    body_order := [Int]{}
    loop (index, function) in inputs.functions {
        if function.module_identity != inputs.entry_module_identity -> body_order.push(index)
    }
    body_order.sort_by(fn(left: Int, right: Int) { (module_text(inputs.module_table, inputs.functions[left].module_identity) <=> module_text(inputs.module_table, inputs.functions[right].module_identity)).then(inputs.functions[left].key <=> inputs.functions[right].key) })
    // A body checked twice sorts beside itself.
    loop position in 1..<body_order.len() {
        earlier: body_order[position - 1]
        later: body_order[position]
        if inputs.functions[earlier].module_identity == inputs.functions[later].module_identity && inputs.functions[earlier].key == inputs.functions[later].key -> return Err("Core function `{inputs.functions[later].key}` of {module_text(inputs.module_table, inputs.functions[later].module_identity)} is checked twice")
    }
    module_bodies := [U32:[Int]]{}
    loop (position, index) in body_order {
        identity: inputs.functions[index].module_identity.id
        if module_bodies.get(identity) == None -> module_bodies[identity] = [Int]{}
        module_bodies[identity].push(position)
    }
    packets := [Int:SemaComptimeFunctionResult]{}
    module_keys := [RecordValue]{}
    module_rows := [RecordValue]{}
    loop index in module_order {
        whole := inputs.modules[index].copy()
        positions: module_bodies.get(whole.module_identity.id) ?? [Int]{}
        bodies := [FnBody]{}
        loop position in positions -> bodies.push(inputs.functions[body_order[position]].copy())
        split := [SemaComptimeFunctionResult]{}
        row := sema_core_body_packets(whole, bodies, split)
        loop split.len() > 0 {
            packet := split.pop() ?? break
            packets[positions[split.len()]] = packet
        }
        _: jet_driver_core_record_rebase_imports(row.imports, graph_modules)
        bytes: core_record_cbor.to_bytes_canonical(row) ?? return Err("Core module `{row.module_name}` has no record encoding: {err}")
        module_keys.push(RecordValue.Map{fields: [RecordField]{RecordField{name: "name", value: RecordValue.Str{value: row.module_name.copy()}}, RecordField{name: "identity", value: RecordValue.Str{value: module_text(inputs.module_table, row.module_identity)}}}})
        module_rows.push(RecordValue.Bytes{value: bytes})
    }
    registration_rows := [RecordValue]{}
    loop module_row_index in module_order {
        identity: inputs.modules[module_row_index].module_identity
        index: registration_at.get(identity.id) ?? return Err("Core module {module_text(inputs.module_table, identity)} is checked but has no registration module")
        registration := inputs.registration_modules[index].copy()
        _: jet_driver_core_record_rebase_registration(registration, graph_modules) ?? return Err(err)
        bytes: core_record_cbor.to_bytes_canonical(registration) ?? return Err("Core module `{registration.module_name}` has no registration record encoding: {err}")
        registration_rows.push(RecordValue.Bytes{value: bytes})
    }
    decl_rows := [RecordValue]{}
    decl_keys: inputs.decls.rows.key
    decl_kinds: inputs.decls.rows.kind
    loop (index, key) in decl_keys {
        bytes: core_record_cbor.to_bytes_canonical(DeclRow{key: key.copy(), kind: decl_kinds[index]}) ?? return Err("the declaration `{key}` has no record encoding: {err}")
        decl_rows.push(RecordValue.Bytes{value: bytes})
    }
    // Each Core module's comptime values, in the order the check landed them.
    // The entry's, and the canonical effect module's (every compile registers
    // and evaluates it afresh), are not Core's.
    module_values := [U32:[SemaComptimeItemValue]]{}
    core_values := 0
    loop value in inputs.comptime_values {
        if record_at.get(value.module_identity.id) == None -> next
        if module_values.get(value.module_identity.id) == None -> module_values[value.module_identity.id] = [SemaComptimeItemValue]{}
        module_values[value.module_identity.id].push(value.copy())
        core_values += 1
    }
    value_rows := [RecordValue]{}
    loop index in module_order {
        module_row: inputs.modules[index]
        values: module_values.get(module_row.module_identity.id) ?? [SemaComptimeItemValue]{}
        bytes: core_record_cbor.to_bytes_canonical(values) ?? return Err("Core module `{module_row.module_name}` has comptime values with no record encoding: {err}")
        value_rows.push(RecordValue.Bytes{value: bytes})
    }
    body_keys := [RecordValue]{}
    body_rows := [RecordValue]{}
    loop (position, index) in body_order {
        packet: packets.get(position) ?? return Err("Core function `{inputs.functions[index].key}` belongs to no recorded Core module")
        bytes: core_record_cbor.to_bytes_canonical(packet) ?? return Err("Core function `{packet.function_key}` has no record encoding: {err}")
        body_keys.push(RecordValue.Map{fields: [RecordField]{RecordField{name: "module", value: RecordValue.Str{value: module_text(inputs.module_table, packet.module_identity)}}, RecordField{name: "key", value: RecordValue.Str{value: packet.function_key.copy()}}}})
        body_rows.push(RecordValue.Bytes{value: bytes})
    }
    // Row 0 is the empty identity no module has; every table interns it.
    table_rows: loop row in 1..<module_count(inputs.module_table) -> RecordValue.Str{value: inputs.module_table.identities.texts[row].copy()}
    // The symbol ranges a compile that takes the record's modules reserves,
    // each with its keys (sections 10 and 11).
    recorded: loop index in module_order -> inputs.modules[index].module_identity
    symbol_ranges := [RecordValue]{}
    symbol_keys := [RecordValue]{}
    loop range in sema_registration_reserved_symbols(inputs.symbols, recorded) {
        symbol_ranges.push(RecordValue.Map{fields: [RecordField]{
            RecordField{name: "module", value: RecordValue.Int{value: Int{range.module_identity.id}}},
            RecordField{name: "base", value: RecordValue.Int{value: range.base}},
            RecordField{name: "bound", value: RecordValue.Int{value: range.bound}},
        }})
        keys: loop row in 1..<range.keys.texts.len() -> RecordValue.Str{value: range.keys.texts[row].copy()}
        symbol_keys.push(RecordValue.List{values: keys})
    }
    header: RecordValue.Map{fields: [RecordField]{
        RecordField{name: "compiler", value: RecordValue.Str{value: compiler}},
        RecordField{name: "target", value: RecordValue.Str{value: target}},
        RecordField{name: "core_digest", value: RecordValue.Str{value: jet_driver_core_record_digest(inputs, entry_file)}},
        RecordField{name: "modules", value: RecordValue.Int{value: module_order.len()}},
        RecordField{name: "bodies", value: RecordValue.Int{value: body_order.len()}},
        RecordField{name: "decls", value: RecordValue.Int{value: decl_rows.len()}},
        RecordField{name: "values", value: RecordValue.Int{value: core_values}},
    }}
    sections: [RecordSection]{
        RecordSection{id: JET_CORE_RECORD_HEADER, elements: [RecordValue]{header}},
        RecordSection{id: JET_CORE_RECORD_MODULE_KEYS, elements: module_keys.move()},
        RecordSection{id: JET_CORE_RECORD_MODULE_ROWS, elements: module_rows.move()},
        RecordSection{id: JET_CORE_RECORD_BODY_KEYS, elements: body_keys.move()},
        RecordSection{id: JET_CORE_RECORD_BODY_ROWS, elements: body_rows.move()},
        RecordSection{id: JET_CORE_RECORD_REGISTRATION_ROWS, elements: registration_rows.move()},
        RecordSection{id: JET_CORE_RECORD_DECL_ROWS, elements: decl_rows.move()},
        RecordSection{id: JET_CORE_RECORD_VALUE_ROWS, elements: value_rows.move()},
        RecordSection{id: JET_CORE_RECORD_MODULE_TABLE, elements: table_rows},
        RecordSection{id: JET_CORE_RECORD_SYMBOL_RANGES, elements: symbol_ranges.move()},
        RecordSection{id: JET_CORE_RECORD_SYMBOL_KEYS, elements: symbol_keys.move()},
    }
    encoded: record_encode(JET_CORE_RECORD_SCHEMA, sections)
    bytes: encoded.bytes ?? return Err(encoded.problem ?? "the Core record has no byte form")
    Ok(bytes)
}

// One Core or Prelude source the record's digest reads.
JetDriverCoreRecordSource: struct {
    path: String
    text: String
}

// The digest of the Core and Prelude sources the record was checked from
// (`inputs.sources`): each source path and text, in path order, the check's
// entry file left out.
jet_driver_core_record_digest: fn(inputs: JetDriverLoweringInputs, entry_file: String) -> String Never! {
    files := [JetDriverCoreRecordSource]{}
    loop (path, text) in inputs.sources {
        if path != entry_file -> files.push(JetDriverCoreRecordSource{path: path.copy(), text: text.copy()})
    }
    // Popped from the back, so the last path sorts first.
    files.sort_by(fn(left: JetDriverCoreRecordSource, right: JetDriverCoreRecordSource) { right.path <=> left.path })
    fields := [String]{}
    loop files.len() > 0 {
        file := files.pop() ?? break
        fields.push(file.path.move())
        fields.push(file.text.move())
    }
    record_key_digest(fields)
}

// Opens a `jet.core/v5` record: the format and checksum are verified, and
// the header, both key sections, the module table and the symbol ranges are
// read. No row is decoded.
jet_driver_core_record_open: fn(bytes: [U8]) -> JetDriverCoreRecord Err! {
    jet_driver_core_record_read(record_open_schema(bytes, JET_CORE_RECORD_SCHEMA))
}

// Opens the record part of the running jet as `jet_driver_core_record_open`
// does, but for its checksum: the part is one of the executable's bytes,
// which are the toolchain's identity, so a hash of every byte on each compile
// would prove nothing more and cost the compile its time.
jet_driver_core_record_open_embedded: fn(bytes: [U8]) -> JetDriverCoreRecord Err! {
    jet_driver_core_record_read(record_open_schema_trusted(bytes, JET_CORE_RECORD_SCHEMA))
}

// The header, key sections, module table and symbol ranges of the opened
// record `opened`.
jet_driver_core_record_read: fn(opened: RecordReaderResult) -> JetDriverCoreRecord Err! {
    reader: opened.reader ?? return Err(opened.problem ?? "the Core record can't be opened")
    header: jet_driver_core_record_value(reader, JET_CORE_RECORD_HEADER, 0) ?? return Err(err)
    record := JetDriverCoreRecord{
        reader: reader,
        compiler: jet_driver_core_record_text(header, "compiler") ?? return Err(err),
        target: jet_driver_core_record_text(header, "target") ?? return Err(err),
        core_digest: jet_driver_core_record_text(header, "core_digest") ?? return Err(err),
        module_names: [String]{},
        module_identities: [ModuleID]{},
        module_rows: [U32:Int]{},
        body_modules: [ModuleID]{},
        body_keys: [String]{},
        module_table: module_table(),
        symbols: [SymbolKeys]{},
    }
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_TABLE) {
        value: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_MODULE_TABLE, index) ?? return Err(err)
        text: record_value_as_str(value)
        identity: text.value ?? return Err(text.problem ?? "the Core record's module table row {index} is not text")
        if module_index(module_intern(record.module_table, identity)) != index + 1 -> return Err("the Core record's module table names `{identity}` twice")
    }
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_KEYS) {
        key: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_MODULE_KEYS, index) ?? return Err(err)
        identity: jet_driver_core_record_module_id(record.module_table, key, "identity") ?? return Err(err)
        if record.module_rows.get(identity.id) != None -> return Err("the Core record keys module {module_text(record.module_table, identity)} twice")
        record.module_rows[identity.id] = index
        record.module_names.push(jet_driver_core_record_text(key, "name") ?? return Err(err))
        record.module_identities.push(identity)
    }
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_KEYS) {
        key: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_BODY_KEYS, index) ?? return Err(err)
        record.body_modules.push(jet_driver_core_record_module_id(record.module_table, key, "module") ?? return Err(err))
        record.body_keys.push(jet_driver_core_record_text(key, "key") ?? return Err(err))
    }
    ranges: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_SYMBOL_RANGES)
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_SYMBOL_KEYS) != ranges -> return Err("the Core record has {ranges} symbol ranges but a different number of symbol key rows")
    loop index in 0..<ranges {
        range: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_SYMBOL_RANGES, index) ?? return Err(err)
        owner: jet_driver_core_record_int(range, "module") ?? return Err(err)
        base: jet_driver_core_record_int(range, "base") ?? return Err(err)
        bound: jet_driver_core_record_int(range, "bound") ?? return Err(err)
        keys := symbol_keys(base, bound)
        keys.module_identity = ModuleID{id: checked(U32{owner}) ?? return Err("the Core record's symbol range at {base} names no module id ({owner})")}
        listed: jet_driver_core_record_value(record.reader, JET_CORE_RECORD_SYMBOL_KEYS, index) ?? return Err(err)
        list: record_value_as_list(listed)
        texts: list.value ?? return Err(list.problem ?? "the Core record's symbol keys of the range at {base} are not a list")
        if texts.len() >= bound -> return Err("the Core record's symbol range at {base} holds {texts.len()} keys, past its bound {bound}")
        loop (row, value) in texts {
            text: record_value_as_str(value)
            symbol: text.value ?? return Err(text.problem ?? "the Core record's symbol key {row} of the range at {base} is not text")
            if (Int{symbol_keys_intern(keys, symbol).id}) != base + row + 1 -> return Err("the Core record's symbol range at {base} holds `{symbol}` twice")
        }
        record.symbols.push(keys)
    }
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_MODULE_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of module rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_REGISTRATION_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of registration rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_BODY_ROWS) != record.body_keys.len() -> return Err("the Core record has {record.body_keys.len()} body keys but a different number of body rows")
    if jet_driver_core_record_count(record.reader, JET_CORE_RECORD_VALUE_ROWS) != record.module_names.len() -> return Err("the Core record has {record.module_names.len()} module keys but a different number of value rows")
    Ok(record)
}

// Interns the record's module table into a compile's empty `table`, in id
// order, so each ModuleID a taken row names is the compile's id for the same
// module identity.
jet_driver_core_record_intern_modules: fn(table: &ModuleTable, record: JetDriverCoreRecord) -> Int Err! {
    if module_count(table) != 1 -> return Err("the Core record's module table must be interned before the compile interns a module")
    loop row in 1..<module_count(record.module_table) {
        identity: record.module_table.identities.texts[row]
        if module_index(module_intern(table, identity)) != row -> return Err("the Core record's module table names `{identity}` twice")
    }
    Ok(module_count(table) - 1)
}

// The checked row of the record's module `index` (in module key order).
jet_driver_core_record_module: fn(record: JetDriverCoreRecord, index: Int) -> SemaGraphModuleResult Err! {
    bytes: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_MODULE_ROWS, index) ?? return Err(err)
    row: core_record_cbor.decode<SemaGraphModuleResult>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("Core module `{record.module_names[index]}` doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(row)
}

// The body packet of the record's function `index` (in body key order): the
// checked body with the facts its check recorded.
jet_driver_core_record_body: fn(record: JetDriverCoreRecord, index: Int) -> SemaComptimeFunctionResult Err! {
    bytes: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_BODY_ROWS, index) ?? return Err(err)
    packet: core_record_cbor.decode<SemaComptimeFunctionResult>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("Core function `{record.body_keys[index]}` doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(packet)
}

// The finalized registration module of the record's module `index` (in
// module key order).
jet_driver_core_record_registration: fn(record: JetDriverCoreRecord, index: Int) -> SemaRegistrationModule Err! {
    bytes: jet_driver_core_record_registration_bytes(record, index) ?? return Err(err)
    registration: jet_driver_core_record_registration_decode(bytes, record.module_names[index]) ?? return Err(err)
    Ok(registration)
}

// The encoded registration row of the record's module `index`, read on the
// load thread so a parse thread decodes it without the record.
jet_driver_core_record_registration_bytes: fn(record: JetDriverCoreRecord, index: Int) -> [U8] Err! {
    bytes: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_REGISTRATION_ROWS, index) ?? return Err(err)
    Ok(bytes)
}

// A registration row's bytes decoded; `name` is its module's name.
jet_driver_core_record_registration_decode: fn(bytes: [U8], name: String) -> SemaRegistrationModule Err! {
    registration: core_record_cbor.decode<SemaRegistrationModule>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("Core module `{name}` has a registration row that doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(registration)
}

// The record's declaration table, keyed: row `i` is the row the record's
// bodies name as DeclID `i`.
jet_driver_core_record_decls: fn(record: JetDriverCoreRecord) -> DeclTable Err! {
    table := DeclTable{}
    loop index in 0..<jet_driver_core_record_count(record.reader, JET_CORE_RECORD_DECL_ROWS) {
        row: jet_driver_core_record_decl(record, index) ?? return Err(err)
        _: decl_table_add_row(table, row.key, row.kind)
    }
    decl_table_index(table)
    Ok(table)
}

jet_driver_core_record_decl: fn(record: JetDriverCoreRecord, index: Int) -> DeclRow Err! {
    bytes: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_DECL_ROWS, index) ?? return Err(err)
    row: core_record_cbor.decode<DeclRow>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("the Core record's declaration row {index} doesn't decode: {sema_core_record_field_errors(err)}")
    Ok(row)
}

// The comptime values of the record's module `index` (in module key order),
// in the order the Core check landed them.
jet_driver_core_record_values: fn(record: JetDriverCoreRecord, index: Int) -> [SemaComptimeItemValue] Err! {
    bytes: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_VALUE_ROWS, index) ?? return Err(err)
    values: core_record_cbor.decode<[SemaComptimeItemValue]>(bytes, SEMA_CORE_RECORD_CBOR) ?? return Err("Core module `{record.module_names[index]}` has value rows that don't decode: {sema_core_record_field_errors(err)}")
    Ok(values)
}

// Reads every row of `bytes` back and encodes it again: each must give the
// bytes it was read from, and each key must name its own row.
jet_driver_core_record_round_trip: fn(bytes: [U8]) -> JetDriverCoreRecordCounts Err! {
    record: jet_driver_core_record_open(bytes) ?? return Err(err)
    loop index in 0..<record.module_names.len() {
        row: jet_driver_core_record_module(record, index) ?? return Err(err)
        if row.module_name != record.module_names[index] || row.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its row is `{row.module_name}`")
        stored: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_MODULE_ROWS, index) ?? return Err(err)
        again: core_record_cbor.to_bytes_canonical(row) ?? return Err("Core module `{row.module_name}` doesn't encode again: {err}")
        if again != stored -> return Err("Core module `{row.module_name}` encodes to other bytes after a read")
    }
    loop index in 0..<record.body_keys.len() {
        packet: jet_driver_core_record_body(record, index) ?? return Err(err)
        if packet.function_key != record.body_keys[index] || packet.module_identity != record.body_modules[index] -> return Err("Core body key {index} names `{record.body_keys[index]}` but its packet is `{packet.function_key}`")
        if packet.function == None -> return Err("Core body packet `{packet.function_key}` holds no body")
        stored: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_BODY_ROWS, index) ?? return Err(err)
        again: core_record_cbor.to_bytes_canonical(packet) ?? return Err("Core function `{packet.function_key}` doesn't encode again: {err}")
        if again != stored -> return Err("Core function `{packet.function_key}` encodes to other bytes after a read")
    }
    loop index in 0..<record.module_names.len() {
        registration: jet_driver_core_record_registration(record, index) ?? return Err(err)
        if registration.module_name != record.module_names[index] || registration.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its registration row is `{registration.module_name}`")
        stored: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_REGISTRATION_ROWS, index) ?? return Err(err)
        again: core_record_cbor.to_bytes_canonical(registration) ?? return Err("Core module `{registration.module_name}`'s registration row doesn't encode again: {err}")
        if again != stored -> return Err("Core module `{registration.module_name}`'s registration row encodes to other bytes after a read")
    }
    decls: jet_driver_core_record_count(record.reader, JET_CORE_RECORD_DECL_ROWS)
    loop index in 0..<decls {
        row: jet_driver_core_record_decl(record, index) ?? return Err(err)
        stored: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_DECL_ROWS, index) ?? return Err(err)
        again: core_record_cbor.to_bytes_canonical(row) ?? return Err("the declaration `{row.key}` doesn't encode again: {err}")
        if again != stored -> return Err("the declaration `{row.key}` encodes to other bytes after a read")
    }
    table: jet_driver_core_record_decls(record) ?? return Err(err)
    if table.rows.len() != decls -> return Err("the Core record's declaration table keeps {table.rows.len()} of its {decls} rows")
    values := 0
    loop index in 0..<record.module_names.len() {
        module_values: jet_driver_core_record_values(record, index) ?? return Err(err)
        loop value in module_values {
            if value.module_identity != record.module_identities[index] -> return Err("Core module key {index} names `{record.module_names[index]}` but its value rows hold `{value.key}` of {module_text(record.module_table, value.module_identity)}")
        }
        values += module_values.len()
        stored: jet_driver_core_record_row(record.reader, JET_CORE_RECORD_VALUE_ROWS, index) ?? return Err(err)
        again: core_record_cbor.to_bytes_canonical(module_values) ?? return Err("Core module `{record.module_names[index]}`'s value rows don't encode again: {err}")
        if again != stored -> return Err("Core module `{record.module_names[index]}`'s value rows encode to other bytes after a read")
    }
    Ok(JetDriverCoreRecordCounts{modules: record.module_names.len(), bodies: record.body_keys.len(), registrations: record.module_names.len(), decls: decls, values: values, bytes: bytes.len(), sections: jet_driver_core_record_section_sizes(record.reader)})
}

// Each section of `reader`, in record order, with the bytes its elements
// take: element `i` of section `s` spans bounds[firsts[s] + i] up to the
// next bound.
jet_driver_core_record_section_sizes: fn(reader: RecordReader) -> [JetDriverCoreRecordSectionSize] Never! {
    sizes := [JetDriverCoreRecordSectionSize]{}
    loop (section, id) in reader.ids {
        first: reader.firsts[section]
        elements: record_section_elements(reader, section)
        largest := 0
        loop index in 0..<elements {
            size: reader.bounds[first + index + 1] - reader.bounds[first + index]
            if size > largest -> largest = size
        }
        sizes.push(JetDriverCoreRecordSectionSize{id: id, elements: elements, bytes: reader.bounds[first + elements] - reader.bounds[first], largest: largest})
    }
    sizes
}

jet_driver_core_record_count: fn(reader: RecordReader, id: Int) -> Int Never! {
    section: record_section_index(reader, id) ?? return 0
    record_section_elements(reader, section)
}

jet_driver_core_record_value: fn(reader: RecordReader, id: Int, index: Int) -> RecordValue Err! {
    read: record_element(reader, id, index)
    value: read.value ?? return Err(read.problem ?? "the Core record has no element {index} in section {id}")
    Ok(value)
}

jet_driver_core_record_row: fn(reader: RecordReader, id: Int, index: Int) -> [U8] Err! {
    value: jet_driver_core_record_value(reader, id, index) ?? return Err(err)
    if value == .Bytes(bytes) -> return Ok(bytes)
    Err("the Core record's element {index} of section {id} is not a row")
}

jet_driver_core_record_text: fn(value: RecordValue, name: String) -> String Err! {
    field: record_value_field(value, name)
    found: field.value ?? return Err(field.problem ?? "the Core record has no `{name}`")
    text: record_value_as_str(found)
    Ok(text.value ?? return Err(text.problem ?? "the Core record's `{name}` is not text"))
}

jet_driver_core_record_int: fn(value: RecordValue, name: String) -> Int Err! {
    field: record_value_field(value, name)
    found: field.value ?? return Err(field.problem ?? "the Core record has no `{name}`")
    number: record_value_as_int(found)
    Ok(number.value ?? return Err(number.problem ?? "the Core record's `{name}` is not an integer"))
}

// The ModuleID of field `name` of `value`, an identity of the record's
// module `table`.
jet_driver_core_record_module_id: fn(table: ModuleTable, value: RecordValue, name: String) -> ModuleID Err! {
    identity: jet_driver_core_record_text(value, name) ?? return Err(err)
    Ok(module_find(table, identity) ?? return Err("the Core record's `{name}` names {identity}, which its module table doesn't hold"))
}
