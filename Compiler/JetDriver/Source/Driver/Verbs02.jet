use jet_foundation.Diagnostics.Diagnostic
use crate.Lock.ComptimeInput
use crate.FFI.FfiLink
use crate.Codegen.[MIRWeb, PluginArtifacts, LibraryArtifacts]
use crate.LibraryExport.LibraryConfig
use crate.Syntax.RuntimeLayer

// Rust: crates/jet-driver/src/Compile.rs:8
// Successful compiler products and the checked metadata consumed by the build driver.
#Derive(Debug)
pub struct CompileOutput {
    pub rust: String
    pub lints: [Diagnostic]
    pub ffi: FfiLink?
    pub clinks: [String]
    // Relative path plus SHA256 of compile-time embed inputs, published to .jet/lock.
    pub comptime_inputs: [ComptimeInput]
    pub web: MIRWeb.WebArtifacts?
    pub web_partition_report: String?
    pub plugin: PluginArtifacts?
    pub library: LibraryArtifacts?
    pub library_config: LibraryConfig?
    pub inferred_layer: RuntimeLayer
    pub layer_ceiling: RuntimeLayer?
}
