// One writer chain per build fact. The settings fold (jet_driver_build_settings)
// reads the effective writer's text and lists every writer, and `jet explain
// <fact>` resolves and prints the whole chain through the one contribution
// law (pkg_fact_resolve).
use {
    jet_foundation.[COMPILER_BUILD_CPU_CACHE_LINE_GENERIC, Diagnostic, JET_BUILD_DEFAULT_PROFILE, Span]
    jet_pkg_model.[ContributionLayer, EffectiveFact, FactContribution, FactError, FactKey, FactValue, SourceScope, pkg_fact_resolve]
    jet_sema.[SemaBuildFacts, SemaBuildSetting, SemaSettingContribution]
}

// One writer of a declared setting: its contribution, the value's text as
// it was written, which sema reads (SemaBuildSetting.value), and where it is
// written: the file and span of its manifest entry. A writer the lock or the
// command line holds has no site: file "" and an empty span.
JetDriverSettingWriter: struct {
    contribution: FactContribution,
    text: String,
    file: String,
    span: Span,
}

// The writers of `setting`, which `package` declares, from least to most
// explicit layer: its default; for a dependency's setting, each other
// package's entry for that dependency (`DependencyEntry`), then the entry
// package's (`RootEntry`); the value the selected `build:` profile gives it;
// the values the entry package's `build: fn` contributed (the lock's
// environment-layer rows); and each `--set`. The entry package writes a
// dependency's setting by its qualified name (jet_driver_setting_name).
jet_driver_setting_writers: fn(load: JetDriverLoadResult, package: JetDriverPackageInfo, setting: JetDriverPackageSetting, request: JetDriverCompileRequest) -> [JetDriverSettingWriter] Never! {
    name: jet_driver_setting_name(load, package, setting)
    key: "Build.Settings.{name}"
    no_site: Span{start: 0, end: 0}
    writers := [JetDriverSettingWriter]{}
    writers.push(jet_driver_setting_writer(key, setting.ty, setting.default, ContributionLayer.Declaration, SourceScope.Package, "{jet_driver_writer_label(load, package)}:settings.{setting.name} (default)", None, package.manifest_path ?? "", setting.span))
    if package.identity != load.package_identity {
        jet_driver_entry_setting_writers(load, package, setting, key, ContributionLayer.DependencyEntry, writers)
        jet_driver_entry_setting_writers(load, package, setting, key, ContributionLayer.RootEntry, writers)
    }
    loop entry in load.packages {
        if entry.identity != load.package_identity -> next
        manifest: jet_driver_manifest_label(entry)
        loop given in entry.profile_settings {
            if given.profile != request.profile || given.name != name -> next
            writers.push(jet_driver_setting_writer(key, setting.ty, given.value, ContributionLayer.OptimizationBundle, SourceScope.Package, "{manifest}:build.{request.profile}.settings.{name}", None, entry.manifest_path ?? "", given.span))
        }
        loop contribution in request.build_contributions {
            if contribution.package != entry.name || contribution.key != key || contribution.layer != "environment" {
                next
            }
            text: jet_driver_locked_setting_text(contribution.value) ?? next
            reason: if contribution.reason == "" -> String?{None} else -> Val(contribution.reason)
            writers.push(jet_driver_setting_writer(key, setting.ty, text, ContributionLayer.Environment, jet_driver_source_scope(contribution.scope), contribution.source, reason, "", no_site))
        }
    }
    loop override in request.setting_overrides {
        if override.name != name -> next
        writers.push(jet_driver_setting_writer(key, setting.ty, override.value, ContributionLayer.CommandLine, SourceScope.Package, "command line:--set {override.name}={override.value}", None, "", no_site))
    }
    writers
}

// The `layer` writers of a dependency's `setting`: each `settings:` value
// that a loaded package's entry for `package` gives it. The entry package's
// entry is the `RootEntry` layer, and any other package's the
// `DependencyEntry` layer.
jet_driver_entry_setting_writers: fn(load: JetDriverLoadResult, package: JetDriverPackageInfo, setting: JetDriverPackageSetting, key: String, layer: ContributionLayer, writers: &[JetDriverSettingWriter]) {
    loop declarer in load.packages {
        declarer_layer: if declarer.identity == load.package_identity -> ContributionLayer.RootEntry else -> ContributionLayer.DependencyEntry
        if declarer_layer != layer -> next
        label: jet_driver_writer_label(load, declarer)
        loop dependency in declarer.dependencies {
            if dependency.target_root_index != package.root_index -> next
            loop given in dependency.settings {
                if given.name != setting.name -> next
                writers.push(jet_driver_setting_writer(key, setting.ty, given.value, layer, SourceScope.Package, "{label}:deps.{dependency.name}.settings.{given.name}", None, dependency.source_path, given.span))
            }
        }
    }
}

// A declared setting's name as the entry package writes it: its own
// settings bare (`loud`), and a dependency's qualified by that dependency's
// name (`tool.loud`), in a profile, `b.contribute` and `--set` alike.
jet_driver_setting_name: fn(load: JetDriverLoadResult, package: JetDriverPackageInfo, setting: JetDriverPackageSetting) -> String Never! {
    if package.identity == load.package_identity -> return setting.name.copy()
    "{package.name}.{setting.name}"
}

// The file a writer of `package` sits in, as its chain names it: the entry
// package's manifest label, and a dependency's manifest from the entry
// package's root (`../tool/package.jet`), so two packages' writers differ.
jet_driver_writer_label: fn(load: JetDriverLoadResult, package: JetDriverPackageInfo) -> String Never! {
    if package.identity == load.package_identity -> return jet_driver_manifest_label(package)
    path: package.manifest_path ?? return jet_driver_manifest_label(package)
    loop entry in load.packages {
        if entry.identity == load.package_identity {
            return jet_driver_display_path(entry.root_path, path)
        }
    }
    path.copy()
}

// Where the setting a written name (jet_driver_setting_name) means is
// declared: the package's index in the load and the setting's in its
// `settings:`.
JetDriverSettingTarget: struct {
    package: Int,
    setting: Int,
}

jet_driver_setting_target: fn(load: JetDriverLoadResult, name: String) -> JetDriverSettingTarget? Never! {
    loop (package_index, package) in load.packages {
        loop (setting_index, setting) in package.settings {
            if jet_driver_setting_name(load, package, setting) == name {
                return Val(JetDriverSettingTarget{package: package_index, setting: setting_index})
            }
        }
    }
    None
}

jet_driver_setting_writer: fn(key: String, ty: String, text: String, layer: ContributionLayer, scope: SourceScope, source: String, reason: String?, file: String, span: Span) -> JetDriverSettingWriter Never! {
    contribution := FactContribution.new(key, jet_driver_setting_fact_value(ty, text), scope, layer, source)
    contribution.reason = reason
    JetDriverSettingWriter{contribution: contribution, text: text, file: file, span: span}
}

// `setting` as the build reads it: the text of the writer the contribution
// law selects, its declared default, and every writer with its layer, the
// selected one marked. A chain the law refuses is reported before any compile
// reads it (jet_driver_setting_writer_diagnostics); its last writer stands
// in.
jet_driver_setting_effective: fn(setting: JetDriverPackageSetting, writers: [JetDriverSettingWriter]) -> SemaBuildSetting Never! {
    if writers.len() == 0 {
        return SemaBuildSetting{name: setting.name, ty: setting.ty, value: setting.default, default: setting.default, contributions: [SemaSettingContribution]{}}
    }
    contributions := [FactContribution]{}
    loop writer in writers -> contributions.push(writer.contribution)
    at := writers.len() - 1
    if pkg_fact_resolve(FactKey.new(writers[0].contribution.key), contributions) == .Ok(resolved) {
        if resolved == .Val(fact) {
            effective: fact.provenance[fact.effective]
            loop (index, writer) in writers {
                if writer.contribution.layer == effective.layer && writer.contribution.source == effective.source {
                    at = index
                    break
                }
            }
        }
    }
    rows := [SemaSettingContribution]{}
    loop (index, writer) in writers {
        rows.push(SemaSettingContribution{value: writer.text, file: writer.file, span: writer.span, kind: jet_driver_setting_contribution_kind(writer.contribution.layer), selected: index == at})
    }
    SemaBuildSetting{name: setting.name, ty: setting.ty, value: writers[at].text, default: setting.default, contributions: rows}
}

// The ContributionKind variant of a setting writer's layer
// (jet_driver_setting_writers): the declaration's default, the selected
// `build:` profile, the package's `build: fn`, or a `--set`. An entry's
// value counts as `Declaration`; reflection lists only the entry package's
// own settings, which no entry writes.
jet_driver_setting_contribution_kind: fn(layer: ContributionLayer) -> String Never! {
    if layer == .OptimizationBundle -> return "Profile"
    if layer == .Environment -> return "Build"
    if layer == .CommandLine -> return "CommandLine"
    "Declaration"
}

// A declared setting's text as the contribution law compares and prints it,
// read by its declared type as sema reads it. Text sema would refuse stays
// text; sema reports it where the setting is read.
jet_driver_setting_fact_value: fn(ty: String, text: String) -> FactValue Never! {
    raw: text.trim()
    declared: ty.trim()
    if declared == "Bool" {
        if raw == "true" -> return FactValue.Bool{value: true}
        if raw == "false" -> return FactValue.Bool{value: false}
        return FactValue.Text{value: raw}
    }
    if declared == "Int" {
        number: Int.parse(raw) ?? return FactValue.Text{value: raw}
        return FactValue.Int{value: number}
    }
    if declared == "String" -> return FactValue.Text{value: jet_driver_setting_unquoted(raw, "\"")}
    if declared == "Char" {
        body: jet_driver_setting_unquoted(raw, "'")
        chars := [Char]{}
        loop ch in body.chars() -> chars.push(ch)
        if chars.len() == 1 -> return FactValue.Char{value: chars[0]}
        return FactValue.Text{value: raw}
    }
    FactValue.Enum{variant: raw.removeprefix(".").trim()}
}

jet_driver_setting_unquoted: fn(raw: String, quote: String) -> String Never! {
    if raw.len() >= 2 && raw.starts_with(quote) && raw.ends_with(quote) {
        return raw.slice(1..<raw.len() - 1)
    }
    raw.copy()
}

// The lock's spelling of a writer's scope (SourceScope.name).
jet_driver_source_scope: fn(name: String) -> SourceScope Never! {
    if name == {
        "file" -> SourceScope.File
        "module" -> SourceScope.Module
        "function" -> SourceScope.Function
        "block" -> SourceScope.Block
        "item" -> SourceScope.Item
        else -> SourceScope.Package
    }
}

// The file a package's facts are written in: `package.jet`, or the carrier
// of an inline `package: { … }` block.
jet_driver_manifest_label: fn(package: JetDriverPackageInfo) -> String Never! {
    path: package.manifest_path ?? return "package.jet"
    if !package.inline_package -> return "package.jet"
    segments: path.split("/").to_list()
    segments[segments.len() - 1]
}

// The entry package of `load`, None for a manifest-less source.
jet_driver_entry_package: fn(load: JetDriverLoadResult) -> JetDriverPackageInfo? Never! {
    loop package in load.packages {
        if package.identity == load.package_identity -> return Val(package.copy())
    }
    None
}

// The refusals of the build's setting writers: a `--set` name, or a profile's
// dependency setting name (`tool.loud`), that no loaded package declares
// (E0302), and every chain the contribution law refuses (E3521), such as two
// `--set` or profile values for one setting, or two dependency entries that
// disagree with no more explicit writer. Every compile checks every chain,
// `--set` or not. Empty when every writer stands.
jet_driver_setting_writer_diagnostics: fn(load: JetDriverLoadResult, request: JetDriverCompileRequest) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop override in request.setting_overrides {
        if jet_driver_setting_target(load, override.name) != None -> next
        diagnostics.push(jet_driver_diagnostic_without_span("E0302", "`#build.settings.{override.name}` is undeclared", "`--set {override.name}={override.value}` gives it a value, but `package.jet` declares no such setting", "add `{override.name}: Type = default` to the `settings: {{ … }}` block in `package.jet`, or drop the `--set`"))
    }
    // The loader checks a profile's own setting names; a dependency's waits
    // for its package (jet_driver_check_profile_settings).
    loop root in load.packages {
        if root.identity != load.package_identity -> next
        loop given in root.profile_settings {
            if !given.name.contains(".") || jet_driver_setting_target(load, given.name) != None {
                next
            }
            diagnostics.push(jet_driver_diagnostic_without_span("E0302", "`#build.settings.{given.name}` is undeclared", "build profile `{given.profile}` gives it a value, but no dependency declares such a setting", "write a dependency's setting as `dependency.setting`, as its `settings: {{ … }}` block declares it"))
        }
    }
    loop package in load.packages {
        loop setting in package.settings {
            contributions := [FactContribution]{}
            loop writer in jet_driver_setting_writers(load, package, setting, request) {
                contributions.push(writer.contribution)
            }
            if pkg_fact_resolve(FactKey.new("Build.Settings.{jet_driver_setting_name(load, package, setting)}"), contributions) == .Err(error) {
                diagnostics.push(jet_driver_fact_error_diagnostic(error))
            }
        }
    }
    diagnostics
}

// `jet explain <fact>`: the resolved writer chain of one build fact, or the
// diagnostics that stopped it.
JetDriverBuildFactExplanation: struct {
    fact: EffectiveFact?,
    diagnostics: [Diagnostic],
}

// The writer chain of build fact `key` (`Build.Package.Name`,
// `Build.Settings.tls`, ...) for `request`: the same writers the compile's
// build snapshot folds (jet_driver_build_facts), resolved through the
// contribution law.
jet_driver_explain_build_fact: fn(request: JetDriverCompileRequest, key: String) -> JetDriverBuildFactExplanation {
    load := jet_driver_load_reach(request, false)
    if !load.complete || jet_driver_has_errors(load.diagnostics) {
        return JetDriverBuildFactExplanation{fact: None, diagnostics: load.diagnostics}
    }
    refusals: jet_driver_setting_writer_diagnostics(load, request)
    if refusals.len() > 0 -> return JetDriverBuildFactExplanation{fact: None, diagnostics: refusals}
    diagnostics := [Diagnostic]{}
    target: jet_driver_selected_target_machine(request, diagnostics) ?? return JetDriverBuildFactExplanation{fact: None, diagnostics: diagnostics}
    facts: jet_driver_build_facts(load, request, target)
    package: jet_driver_entry_package(load)
    contributions := [FactContribution]{}
    if key.starts_with("Build.Settings.") {
        name: key.removeprefix("Build.Settings.")
        if jet_driver_setting_target(load, name) == .Val(declared) {
            owner: load.packages[declared.package]
            loop writer in jet_driver_setting_writers(load, owner, owner.settings[declared.setting], request) {
                contributions.push(writer.contribution)
            }
        }
        if contributions.len() == 0 {
            undeclared: jet_driver_diagnostic_without_span("E0302", "`#build.settings.{name}` is undeclared", "a setting must be declared with a type and default in the package manifest before it can be read", "add `{name}: Type = default` to the package `settings: {{ … }}` block")
            return JetDriverBuildFactExplanation{fact: None, diagnostics: [Diagnostic]{undeclared}}
        }
    } else { contributions = jet_driver_fixed_fact_writers(key, facts, package, request) }
    if pkg_fact_resolve(FactKey.new(key), contributions) == {
        .Ok(resolved) -> return JetDriverBuildFactExplanation{fact: resolved, diagnostics: [Diagnostic]{}}
        .Err(error) -> return JetDriverBuildFactExplanation{fact: None, diagnostics: [Diagnostic]{jet_driver_fact_error_diagnostic(error)}}
    }
}

// The report of a build-fact chain the contribution law refuses. Build-fact
// writers sit in the manifest, the lock or on the command line, never at a
// span of the entry file, so the report carries no span; it names each
// writer by its source instead.
jet_driver_fact_error_diagnostic: fn(error: FactError) -> Diagnostic Never! {
    if error == .Conflict(key, layer, first, second) {
        return jet_driver_diagnostic_without_span("E3521", "fact `{key}` has conflicting values at the {layer.name()} layer", "`{first.source}` writes {first.value.display()}; `{second.source}` writes {second.value.display()}", "make same-layer writers agree, or move one value to a more explicit contribution layer")
    }
    jet_driver_diagnostic_without_span("E3521", "a build fact has no single effective writer", error.message(), "make the writers agree, or move one value to a more explicit contribution layer")
}

// The writers of a fixed build fact. The package names itself in its
// manifest; a manifest-less source takes its name from the entry file
// (`<source>`). A fact nobody writes takes the compiler's value
// (`<default>`); the target machine supplies the OS and cache line
// (`<target>`); the lock's `[build.stamp]` supplies the stamp; `--profile`
// is the command-line writer of the profile.
jet_driver_fixed_fact_writers: fn(key: String, facts: SemaBuildFacts, package: JetDriverPackageInfo?, request: JetDriverCompileRequest) -> [FactContribution] Never! {
    manifest: if package == .Val(found) && found.manifest_path != None -> Val(jet_driver_manifest_label(found)) else -> String?{None}
    declared_version: if package == .Val(found) -> found.version else -> String?{None}
    stamped: request.build_stamp != None
    if key == {
        "Build.Package.Name" -> {
            source: if manifest == .Val(label) -> "{label}:name" else -> "<source>"
            return [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: facts.package_name}, source)}
        }
        "Build.Package.Version" -> {
            source: if manifest == .Val(label) && declared_version != None -> "{label}:version" else -> "<default>"
            return [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: facts.package_version}, source)}
        }
        "Build.OS" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: facts.os}, "<target>")}
        "Build.Profile" -> {
            writers := [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: JET_BUILD_DEFAULT_PROFILE}, "<default>")}
            if facts.profile != JET_BUILD_DEFAULT_PROFILE {
                writers.push(FactContribution.new(key, FactValue.Text{value: facts.profile}, SourceScope.Package, ContributionLayer.CommandLine, "command line:--profile={facts.profile}"))
            }
            return writers
        }
        "Build.Stamp.Git" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.OptionalText{value: facts.stamp_git}, jet_driver_stamp_source(stamped, "git"))}
        "Build.Stamp.Dirty" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.Bool{value: facts.stamp_dirty}, jet_driver_stamp_source(stamped, "dirty"))}
        "Build.Stamp.Toolchain" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: facts.stamp_toolchain}, jet_driver_stamp_source(stamped, "toolchain"))}
        "Build.Stamp.At" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.Text{value: facts.stamp_at}, jet_driver_stamp_source(stamped, "at"))}
        "Build.Cpu.CacheLine" -> return [FactContribution]{jet_driver_fact_writer(key, FactValue.Int{value: COMPILER_BUILD_CPU_CACHE_LINE_GENERIC}, "<target>")}
        else -> return [FactContribution]{}
    }
}

// The lock's `[build.stamp]` field, or `<default>` when no lock stamp is read.
jet_driver_stamp_source: fn(stamped: Bool, field: String) -> String Never! {
    if stamped -> return ".jet/lock:build.stamp.{field}"
    "<default>"
}

jet_driver_fact_writer: fn(key: String, value: FactValue, source: String) -> FactContribution Never! {
    FactContribution.new(key, value, SourceScope.Package, ContributionLayer.Declaration, source)
}
