// Read-only compiler source queries use the authorized loader, not a semantic
// check. This is the CmdSchema/Source-query seam over the same compile request.
use jet_foundation.[Diagnostic, Program, NameLedger, MIRNameModule, MIRNameAlias, MIRNameVisibility, MIRStructureFact, MIRStructureFactKind, name_ledger_from_facts]
use jet_sema.[SemaSourceOrigin, SemaRegistrationImportEdge, sema_name_loaded_facts]

pub struct JetDriverSourceQueryModule {
    pub module_identity: String
    pub package_identity: String
    pub path: String
    pub physical_path: String
    pub source: String
    pub program: Program
}
pub struct JetDriverSourceQueryResult {
    pub modules: [JetDriverSourceQueryModule]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
    // None for a loose source or an omitted version; an explicitly empty
    // declared string remains Val(""). The CLI owns its display fallback.
    pub entry_package_version: String?{None}
    pub entry_module_index: Int{-1}
    pub names: NameLedger?{None}
}

pub fn jet_driver_source_query(request: JetDriverCompileRequest) -> JetDriverSourceQueryResult {
    jet_driver_source_query_loaded(jet_driver_load(request), request)
}

fn jet_driver_source_query_loaded(load: JetDriverLoadResult, request: JetDriverCompileRequest) -> JetDriverSourceQueryResult {
    entry_package_version := String?{None}
    loop package in load.packages {
        if package.identity == load.package_identity {
            entry_package_version = package.version
            break
        }
    }
    modules := [JetDriverSourceQueryModule]{}
    source_positions :: jet_driver_source_file_positions(load.source_files)
    loop loaded in load.modules {
        unit :: load.source_units[loaded.source_unit_index]
        physical := unit.path
        source := ""
        if unit.source_origin == SemaSourceOrigin.Snapshot && unit.root_index >= 0 && unit.file_index >= 0 {
            file :: request.authorized_sources.roots[unit.root_index].files[unit.file_index]
            physical = file.path
            source = file.source
        } else { source = jet_driver_source_text_at(load.source_files, source_positions, unit.path) }
        &modules.push(JetDriverSourceQueryModule{
            module_identity: loaded.module_identity,
            package_identity: loaded.package_identity,
            path: unit.path,
            physical_path: physical,
            source: source,
            program: loaded.program,
        })
    }
    entry_index := -1
    loop (index, module) in load.modules {
        if module.module_identity == load.entry_module_identity -> entry_index = index
    }
    JetDriverSourceQueryResult{modules: modules, diagnostics: load.diagnostics, complete: load.complete, entry_package_version: entry_package_version, entry_module_index: entry_index, names: load.names}
}

fn jet_driver_loaded_names(loaded: [JetDriverLoadedModule], units: [JetDriverSourceUnit], edges: [SemaRegistrationImportEdge]) -> NameLedger Never! {
    modules := [MIRNameModule]{}
    programs := [Program]{}
    positions := [String:Int]{}
    loop (index, module) in loaded {
        unit :: units[module.source_unit_index]
        positions[module.module_identity] = index
        &modules.push(MIRNameModule{alias: module.module_name, path: jet_driver_module_display(unit.relative_path), package: module.package_identity, namespace: if unit.in_namespace -> Val(module.package_identity) else -> None})
        &programs.push(module.program)
    }
    aliases := [MIRNameAlias]{}
    structure := [MIRStructureFact]{}
    loop edge in edges {
        source :: positions.get(edge.source_module_identity) ?? next
        target :: positions.get(edge.target_module_identity) ?? next
        declaration :: edge.declaration
        visibility :: if declaration.is_pub -> MIRNameVisibility.Public else -> if declaration.is_package_pub -> MIRNameVisibility.Package else -> MIRNameVisibility.Private
        &aliases.push(MIRNameAlias{module_index: source, name: declaration.alias, target: modules[target].alias, target_module: Val(target), span: declaration.alias_span, visibility: visibility})
        &structure.push(MIRStructureFact{kind: MIRStructureFactKind.ImportEdge, subject: "{modules[source].alias} -> {modules[target].alias}", source: units[loaded[source].source_unit_index].path, span: declaration.span, status: "resolved", detail: "resolved import edge", gate: None})
    }
    name_ledger_from_facts(sema_name_loaded_facts(modules, programs, aliases, structure))
}
