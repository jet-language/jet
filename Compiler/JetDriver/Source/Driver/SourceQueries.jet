// Read-only compiler source queries use the authorized loader, not a semantic
// check. This is the CmdSchema/Source-query seam over the same compile request.
use jet_foundation.[Diagnostic, Program]
use jet_sema.[SemaSourceOrigin]

pub struct JetDriverSourceQueryModule {
    pub module_identity: String
    pub package_identity: String
    pub path: String
    pub physical_path: String
    pub source: String
    pub program: Program
}
pub struct JetDriverSourceQueryResult {
    pub modules: [JetDriverSourceQueryModule]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
}

pub fn jet_driver_source_query(request: JetDriverCompileRequest) -> JetDriverSourceQueryResult {
    load :: jet_driver_load(request)
    modules := [JetDriverSourceQueryModule]{}
    source_positions :: jet_driver_source_file_positions(load.source_files)
    loop loaded in load.modules {
        unit :: load.source_units[loaded.source_unit_index]
        physical := unit.path
        source := ""
        if unit.source_origin == SemaSourceOrigin.Snapshot && unit.root_index >= 0 && unit.file_index >= 0 {
            file :: request.authorized_sources.roots[unit.root_index].files[unit.file_index]
            physical = file.path
            source = file.source
        } else { source = jet_driver_source_text_at(load.source_files, source_positions, unit.path) }
        &modules.push(JetDriverSourceQueryModule{
            module_identity: loaded.module_identity,
            package_identity: loaded.package_identity,
            path: unit.path,
            physical_path: physical,
            source: source,
            program: loaded.program,
        })
    }
    JetDriverSourceQueryResult{modules: modules, diagnostics: load.diagnostics, complete: load.complete}
}
