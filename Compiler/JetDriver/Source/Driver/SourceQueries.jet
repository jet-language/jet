// Read-only compiler source queries use the authorized loader, not a semantic
// check. This is the CmdSchema/Source-query seam over the same compile request.
use {
    jet_foundation.[Diagnostic, Item, Program, NameLedger, NameModule, NameAlias, NameVisibility, StructureFact, StructureFactKind, ast_program, compiler_transfer_rows, module_text, name_ledger_from_facts]
    jet_sema.[SemaSourceOrigin, SemaRegistrationImportEdge, sema_name_loaded_facts]
}

JetDriverSourceQueryModule: struct {
    module_identity: String
    package_identity: String
    path: String
    // The module's name in a type path (`web` in `web.BadPath`).
    module_name: String{""}
    physical_path: String
    source: String
    program: Program
}
JetDriverSourceQueryResult: struct {
    modules: [JetDriverSourceQueryModule]
    diagnostics: [Diagnostic]
    complete: Bool
    // None for a loose source or an omitted version; an explicitly empty
    // declared string remains Val(""). The CLI owns its display fallback.
    entry_package_version: String?{None}
    entry_module_index: Int{-1}
    names: NameLedger?{None}
    // The folder of each package the entry package's manifest lists, by
    // its name there.
    dependency_roots: [String: String]{[String: String]{}}
}

jet_driver_source_query: fn(request: JetDriverCompileRequest) -> JetDriverSourceQueryResult {
    jet_driver_source_query_loaded(jet_driver_load_with_names(request), request)
}

// A source query's load with its name ledger. Only the source queries read
// the ledger, so a compile's `jet_driver_load` leaves `names` None. The
// ledger names every declaration of each loaded Core module, reached or not.
jet_driver_load_with_names: fn(request: JetDriverCompileRequest) -> JetDriverLoadResult {
    load := jet_driver_load_reach(request, false)
    load.names = Val(jet_driver_loaded_names(load.modules, load.source_units, load.imports))
    load
}

jet_driver_source_query_loaded: fn(load: JetDriverLoadResult, request: JetDriverCompileRequest) -> JetDriverSourceQueryResult {
    entry_package_version := String?{None}
    dependency_roots := [String: String]{}
    loop package in load.packages {
        if package.identity == load.package_identity {
            entry_package_version = package.version
            loop dependency in package.dependencies {
                loop target in load.packages {
                    if target.root_index == dependency.target_root_index && target.identity != package.identity {
                        dependency_roots[dependency.name] = target.root_path.copy()
                        break
                    }
                }
            }
            break
        }
    }
    modules := [JetDriverSourceQueryModule]{}
    source_positions: jet_driver_source_file_positions(load.source_files)
    loop loaded in load.modules {
        unit: load.source_units[loaded.source_unit_index]
        physical := unit.path
        source := ""
        if unit.source_origin == SemaSourceOrigin.Snapshot && unit.root_index >= 0 && unit.file_index >= 0 {
            file: request.authorized_sources.roots[unit.root_index].files[unit.file_index]
            physical = file.path
            source = file.source
        } else { source = jet_driver_source_text_at(load.source_files, source_positions, unit.path) }
        modules.push(JetDriverSourceQueryModule{
            module_identity: module_text(load.module_table, loaded.module_identity),
            package_identity: loaded.package_identity,
            path: unit.path,
            module_name: unit.module_name,
            physical_path: physical,
            source: source,
            program: loaded.program,
        })
    }
    entry_index := -1
    loop (index, module_row) in load.modules {
        if module_row.module_identity == load.entry_module_identity -> entry_index = index
    }
    JetDriverSourceQueryResult{modules: modules, diagnostics: load.diagnostics, complete: load.complete, entry_package_version: entry_package_version, entry_module_index: entry_index, names: load.names, dependency_roots: dependency_roots}
}

// The name facts read each module's items once: the items move out of the
// loaded modules for the read and back after it (pushing each program into
// the list copied the whole parse tree).
jet_driver_loaded_names: fn(loaded: &[JetDriverLoadedModule], units: [JetDriverSourceUnit], edges: [SemaRegistrationImportEdge]) -> NameLedger Never! {
    modules := [NameModule]{}
    programs := [Program]{}
    positions := [U32:Int]{}
    loop index in 0..<loaded.len() {
        unit_index: loaded[index].source_unit_index
        positions[loaded[index].module_identity.id] = index
        namespace: if units[unit_index].in_namespace -> Val(loaded[index].package_identity) else -> None
        modules.push(NameModule{alias: loaded[index].module_name, path: jet_driver_module_display(units[unit_index].relative_path), package: loaded[index].package_identity, namespace: namespace})
        items := ast_program()
        compiler_transfer_rows<Item>(items.items, loaded[index].program.items)
        programs.push(items)
    }
    aliases := [NameAlias]{}
    structure := [StructureFact]{}
    loop edge in edges {
        source: positions.get(edge.source_module_identity.id) ?? next
        target: positions.get(edge.target_module_identity.id) ?? next
        declaration: edge.declaration
        visibility: if declaration.is_pub -> NameVisibility.Public else -> if declaration.is_package_pub -> NameVisibility.Package else -> NameVisibility.Private
        aliases.push(NameAlias{module_index: source, name: declaration.alias, target: modules[target].alias, target_module: Val(target), span: declaration.alias_span, visibility: visibility})
        structure.push(StructureFact{kind: StructureFactKind.ImportEdge, subject: "{modules[source].alias} -> {modules[target].alias}", source: units[loaded[source].source_unit_index].path, span: declaration.span, status: "resolved", detail: "resolved import edge", gate: None})
    }
    facts: sema_name_loaded_facts(modules, programs, aliases, structure)
    loop index in 0..<loaded.len() -> compiler_transfer_rows<Item>(loaded[index].program.items, programs[index].items)
    name_ledger_from_facts(facts)
}
