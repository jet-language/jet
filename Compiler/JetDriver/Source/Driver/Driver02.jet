fn compile_bundle_path_build_inner_with_source_closure(file: &String, options: BuildRunOptions, overlay: (&OSPath, &String)?, dependency_boundary: (&String)?, prepared: PreparedBuildFrontEnd?, without_codegen: Bool, project_check: Bool, source_closure: &[(OSPath, String)]) -> Result[BuildCompileOutput, [Diagnostic]] {
    jet_driver.run_compiler_work(fn() { compile_bundle_path_build_on_compiler_stack(file, ^options, overlay, dependency_boundary, ^prepared, without_codegen, project_check, source_closure) }).map(fn(output) {
