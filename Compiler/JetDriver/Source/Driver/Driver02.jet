//RS /// #2083: the exact inputs a prepared front end was produced under.
//RS ///
//RS /// A prepared front end may only be resumed by a compile that asks for the
//RS /// same program under the same facts. The compile compares this value against
//RS /// its own `BuildRunOptions` before resuming; a mismatch fails closed before
//RS /// another source snapshot can be loaded.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub struct FrontEndInputs {
//RS     pub file: String,
//RS     pub profile: String,
//RS     /// D-DBG1=A: `jet build` artifact fact (see `BuildRunOptions`).
//RS     pub artifact_build: bool,
//RS     pub setting_overrides: BTreeMap<String, String>,
//RS     pub locked: bool,
//RS     pub web_target: bool,
//RS     pub plugin_target: bool,
//RS     pub cross_target: Option<String>,
//RS     pub package_scope: bool,
//RS     pub build_override: bool,
//RS     pub entry_fn: Option<String>,
//RS }
//RS 
//RS impl FrontEndInputs {
//RS     /// The front-end inputs a `compile_bundle_path_build` call implies. This is
//RS     /// the one place the correspondence between build options and front-end
//RS     /// inputs is written down, so a caller that prepares a front end and the
//RS     /// compile that resumes it cannot describe two different programs.
//RS     pub fn for_build(file: &str, options: &BuildRunOptions) -> Self {
//RS         Self {
//RS             file: file.to_string(),
//RS             profile: options.profile.clone(),
//RS             artifact_build: options.artifact_build,
//RS             setting_overrides: options.setting_overrides.clone(),
//RS             locked: options.locked,
//RS             web_target: options.web_target,
//RS             plugin_target: options.plugin_target,
//RS             cross_target: options.cross_target.clone(),
//RS             package_scope: options.package_scope,
//RS             build_override: options.build_override,
//RS             entry_fn: options.entry_fn.clone(),
//RS         }
//RS     }
//RS }
//RS 
//RS /// #2083: one front end per build.
//RS ///
//RS /// The build pipeline's first stage — load the build-entry closure, seed the
//RS /// one build-fact snapshot, run sema, classify diagnostics — used to run twice
//RS /// per `jet build`: once inside the CLI's native content-cache key computation
//RS /// and once inside the compile, which threw the first result away. This value
//RS /// is that stage's complete result. The native cache key is computed from
//RS /// `runtime_program()`, and `compile_bundle_path_build_with_front_end` resumes
//RS /// the pipeline from here, so the key names the program that is actually
//RS /// emitted instead of a second, independently reloaded copy of it.
//RS ///
//RS pub struct PreparedBuildFrontEnd {
//RS     /// Semantic identity of a package-wide build entry that lives outside the runtime bundle.
//RS     package_build_fingerprint: Option<String>,
//RS     inputs: FrontEndInputs,
//RS     bundle: crate::AST::ProgramBundle,
//RS     effect_facts: crate::Sema::SemIndexEffectFacts,
//RS     program_value: Option<crate::Comptime::CtValue>,
//RS     lints: Vec<Diagnostic>,
//RS     build_index: Option<usize>,
//RS     build_span: Option<crate::Diagnostics::Span>,
//RS     compile_mode: crate::Sema::CompileMode,
//RS     active_os: crate::Syntax::OSTarget,
//RS     build_stamp: jet_foundation::Facts::BuildStamp,
//RS     runtime_bundle_for_package: Option<crate::AST::ProgramBundle>,
//RS     runtime_source_paths: Vec<std::path::PathBuf>,
//RS     source_closure: Vec<(std::path::PathBuf, String)>,
//RS }
//RS 
//RS impl PreparedBuildFrontEnd {
//RS     /// The checked bundle used to build the read-only comptime snapshot.
//RS     pub fn bundle(&self) -> &crate::AST::ProgramBundle {
//RS         &self.bundle
//RS     }
//RS 
//RS     /// Attach the snapshot built from the compiler-owned semantic index.
//RS     pub fn set_program_value(&mut self, value: crate::Comptime::CtValue) {
//RS         self.program_value = Some(value);
//RS     }
//RS 
//RS     /// Whether this front end selected a `fn build` entry, the only consumer
//RS     /// of the program snapshot `set_program_value` attaches.
//RS     pub fn selects_build_entry(&self) -> bool {
//RS         self.build_index.is_some()
//RS     }
//RS 
//RS     /// The checked runtime program, when this front end checked it directly.
//RS     ///
//RS     /// `None` when a package build entry in another file was selected: the
//RS     /// checked bundle then describes the *build* program, and the runtime
//RS     /// program is still unchecked. Keying a content cache on it would let two
//RS     /// different runtime programs share one cache entry, and rendering the
//RS     /// effect summary from it would describe the wrong program.
//RS     pub fn runtime_program(&self) -> Option<&crate::AST::ProgramBundle> {
//RS         self.runtime_bundle_for_package
//RS             .is_none()
//RS             .then_some(&self.bundle)
//RS     }
//RS 
//RS     /// The checked program a build will actually emit, when this one front end
//RS     /// already *is* that program.
//RS     ///
//RS     /// `None` when a `fn build` was selected: the plan may materialize
//RS     /// generated modules, and the emitted program is then the planned bundle
//RS     /// loaded after execution, not this one. Callers that must describe the
//RS     /// final program exactly — C link flags, the effect summary — use this
//RS     /// instead of `runtime_program`, which only has to name the same program
//RS     /// the content-cache key has always named.
//RS     pub fn emitted_program(&self) -> Option<&crate::AST::ProgramBundle> {
//RS         self.build_index
//RS             .is_none()
//RS             .then(|| self.runtime_program())
//RS             .flatten()
//RS     }
//RS 
//RS     /// The effect facts this front end solved. The build effect summary is a
//RS     /// projection of these, so a caller never needs a third front end for it.
//RS     pub fn effect_facts(&self) -> &crate::Sema::SemIndexEffectFacts {
//RS         &self.effect_facts
//RS     }
//RS     /// Immutable source texts for every module in the checked build closure.
//RS     pub fn source_closure(&self) -> &[(std::path::PathBuf, String)] {
//RS         &self.source_closure
//RS     }
//RS }
//RS 
//RS /// Run the build front end once, without compiling. The caller computes the
//RS /// native content-cache key from the result and hands it back to
//RS /// `compile_bundle_path_build_with_front_end`.
//RS pub fn prepare_build_front_end(
