        self.compiler_nodes = nodes
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2591
pub struct BuildFilesystemTransaction { files: [(OSPath, ([U8])?)], committed: Bool }
impl BuildFilesystemTransaction {
    // Rust: crates/jet-driver/src/Driver/mod.rs:2597
    fn new(paths: IntoIterator[OSPath]) -> Result[Self, io.Error] {
        seen := Set[OSPath].new()
        files := [(OSPath, ([U8])?)].new()
        for path in paths.into_iter().filter(fn(path) { seen.insert(path.clone()) }) {
            if path_has_symlinked_component(&path) { return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build transaction path `{path.display()}` contains a symlink")) }
            before :: fs.read(&path) == { .Ok(bytes) -> Some(bytes); .Err(error) if error.kind() == io.ErrorKind.NotFound -> None; .Err(error) -> return Err(error) }
            files.push((path, before))
        }
        Ok(Self { files, committed: false })
    }
    // Rust: crates/jet-driver/src/Driver/mod.rs:2622
    fn commit(self: &Self) -> { self.committed = true }
    // Rust: crates/jet-driver/src/Driver/mod.rs:2628
    #Drop
    fn drop(self: &Self) -> {
        if self.committed { return }
        for (path, before) in self.files.iter().rev() {
            before == {
                .Some(bytes) -> { _ :: safe_atomic_write(path, bytes) }
                .None -> { if !fs.symlink_metadata(path).is_ok_and(fn(metadata) { metadata.file_type().is_symlink() }) { _ :: fs.remove_file(path) } }
            }
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2649
pub fn path_has_symlinked_component(path: &OSPath) -> Bool {
    current := OSPath.new()
    for component in path.components() {
        component == {
            .Prefix(prefix) -> current.push(prefix.as_os_str())
            .RootDir -> current.push(std.path.MAIN_SEPARATOR.to_string())
            .CurDir -> {}
            .ParentDir -> return true
            .Normal(part) -> current.push(part)
        }
        if fs.symlink_metadata(&current).is_ok_and(fn(metadata) { metadata.file_type().is_symlink() }) { return true }
    }
    false
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2670
fn ensure_real_parent(path: &OSPath) -> Result[(), io.Error] {
    parent_opt :: path.parent()
    if parent_opt.is_none() { return Ok(()) }
    current := OSPath.new()
    for component in parent_opt.unwrap().components() {
        component == {
            .Prefix(prefix) -> current.push(prefix.as_os_str())
            .RootDir -> current.push(std.path.MAIN_SEPARATOR.to_string())
            .CurDir -> {}
            .ParentDir -> return Err(io.Error.new(io.ErrorKind.InvalidInput, "build path contains a parent component"))
            .Normal(part) -> current.push(part)
        }
        fs.symlink_metadata(&current) == {
            .Ok(metadata) if metadata.file_type().is_symlink() || !metadata.is_dir() -> return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build directory `{current.display()}` is not a real directory"))
            .Ok(_) -> {}
            .Err(error) if error.kind() == io.ErrorKind.NotFound -> { _ :: fs.create_dir(&current)? }
            .Err(error) -> return Err(error)
        }
    }
    Ok(())
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2710
pub fn safe_atomic_write(path: &OSPath, bytes: &[U8]) -> Result[(), io.Error] {
    if path_has_symlinked_component(path) { return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build path `{path.display()}` contains a symlink")) }
    _ :: ensure_real_parent(path)?
    if fs.symlink_metadata(path).is_ok_and(fn(metadata) { metadata.file_type().is_symlink() }) { return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build output `{path.display()}` is a symlink")) }
    parent :: path.parent().unwrap_or_else(fn() { OSPath.new(".") })
    for attempt in 0..100u32 {
        temporary :: parent.join(".jet-atomic-{process.id()}-{attempt}")
        file := fs.OpenOptions.new().create_new(true).write(true).open(&temporary) == {
            .Ok(file) -> file
            .Err(error) if error.kind() == io.ErrorKind.AlreadyExists -> continue
            .Err(error) -> return Err(error)
        }
        if file.write_all(bytes).and_then(fn(_) { file.sync_all() }) == .Err(error) { _ :: fs.remove_file(&temporary); return Err(error) }
        _ :: fs.rename(&temporary, path)?
        return Ok(())
    }
    Err(io.Error.new(io.ErrorKind.AlreadyExists, "could not allocate a unique build temporary file"))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2750
pub fn read_build_file(root: &OSPath, path: &OSPath) -> Result[[U8], io.Error] {
    if path.strip_prefix(root).is_err() || path_has_symlinked_component(path) || fs.symlink_metadata(path).is_ok_and(fn(metadata) { metadata.file_type().is_symlink() }) {
        return Err(io.Error.new(io.ErrorKind.PermissionDenied, "build file `{path.display()}` contains a symlink or is outside the project"))
    }
    fs.read(path)
}

