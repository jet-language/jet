// Rust: crates/jet-driver/src/Driver/mod.rs:1814
#Derive(Debug, Clone)
pub struct BuildRunOptions {
    grants: Set[BuildCapability]
    // Bridge policy is separate from explicit capability grants.
    policy: BuildPolicy
    execute: Bool
    gates: GateSet
    inspect_only: Bool
    emit_generated: Bool
    locked: Bool
    no_os: Bool
    web_target: Bool
    plugin_target: Bool
    cross_target: String?
    profile: String
    artifact_build: Bool
    application_authority: ApplicationAuthority?
    setting_overrides: [String:String]
    remote: RemoteBuildBinding?
    package_scope: Bool
    build_override: Bool
    entry_fn: String?
}
impl BuildRunOptions {
    // Rust: crates/jet-driver/src/Driver/mod.rs:1860
    fn default() -> Self {
        Self { grants: Set[BuildCapability].new(), policy: BuildPolicy.local_default(), execute: true,
            gates: GateSet.default(), inspect_only: false, emit_generated: false, locked: false,
            no_os: false, web_target: false, plugin_target: false, cross_target: None,
            profile: "dev", artifact_build: false, application_authority: None,
            setting_overrides: [String:String].new(), remote: None, package_scope: true,
            build_override: true, entry_fn: None }
    }
}

// Rust: crates/jet-driver/src/Driver/mod.rs:1889
// Seed one immutable provenance snapshot; locked builds never consult the wall clock.
pub fn seed_build_facts(bundle: &ProgramBundle, profile: &String, locked: Bool, setting_overrides: &[String:String]) -> Result[(), [Diagnostic]] {
    seed_build_facts_with_contributions(bundle, profile, locked, setting_overrides, &[])
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1901
pub fn seed_build_facts_with_contributions(bundle: &ProgramBundle, profile: &String, locked: Bool, setting_overrides: &[String:String], computed_contributions: &[FactContribution]) -> Result[(), [Diagnostic]] {
    stamp :: build_stamp_for_facts(&bundle.project_root, locked)?
    seed_build_facts_from_stamp(bundle, profile, setting_overrides, computed_contributions, &stamp)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1918
pub fn build_stamp_for_facts(project_root: &OSPath, locked: Bool) -> Result[BuildStamp, [Diagnostic]] {
    jet_driver.Lock.build_stamp(project_root, locked).map_err(fn(error) {
        [Diagnostic.error("E3512", "the build provenance stamp is unavailable", error, "run an unlocked build to create the lock stamp, then rerun with `--locked`", None)]
    })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1934
pub fn set_bundle_target(bundle: &ProgramBundle, cross_target: (&String)?) -> {
    bundle.build_facts.target_triple = cross_target.map(fn(value) { value.to_owned() }).unwrap_or_else(TargetLayout.host_triple)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1943
pub fn release_devtools_policy_for_bundle(bundle: &ProgramBundle, profile: &String) -> ReleaseDevtoolsPolicy {
    if profile != BUILD_PROFILE_RELEASE && profile != BUILD_PROFILE_HARDENED { return ReleaseDevtoolsPolicy.development() }
    inspect :: package_facts_for_bundle(bundle).ok().flatten().and_then(fn(facts) {
        facts.build_profiles.iter().find(fn(candidate) { candidate.name == profile }).map(fn(candidate) { candidate.inspect })
    }).unwrap_or(ReleaseInspect.Local)
    ReleaseDevtoolsPolicy.from_manifest_profile(inspect)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1967
pub fn seed_build_facts_from_stamp(bundle: &ProgramBundle, profile: &String, setting_overrides: &[String:String], computed_contributions: &[FactContribution], stamp: &BuildStamp) -> Result[(), [Diagnostic]] {
    bundle.package_guarantees.harden |= profile == BUILD_PROFILE_HARDENED
    target_triple :: if bundle.build_facts.target_triple.is_empty() { TargetLayout.host_triple() } else { bundle.build_facts.target_triple.clone() }
    manifest :: package_facts_for_bundle(bundle)?
    package_name :: manifest.as_ref().map(fn(facts) { facts.name.clone() }).filter(fn(name) { !name.is_empty() }).or_else(fn() {
        bundle.modules.get(bundle.entry).and_then(fn(module) { module.path.file_stem().and_then(fn(name) { name.to_str() }).filter(fn(name) { !name.is_empty() }).map(fn(name) { name.to_string() }) })
    }).unwrap_or_else(fn() { "script" })
    package_version :: manifest.as_ref().and_then(fn(facts) { facts.version.clone() }).unwrap_or_else(fn() { "0.0.0" })
    profile_source :: manifest.as_ref().map(fn(facts) { facts.origin.as_str() }).unwrap_or("<default>")
    profile_key :: FactKey.with_default_source("Build.Profile", FactValue.Text("dev"), profile_source)
    profile_contributions := [FactContribution].new()
    if profile != "dev" { profile_contributions.push(FactContribution.new("Build.Profile", FactValue.Text(profile.to_string()), SourceScope.Package, ContributionLayer.CommandLine, "command line")) }
    profile_fact :: resolve_build_fact(profile_key, profile_contributions)?
    resolved_profile :: profile_fact.value == { .Text(value) -> value.clone(); _ -> profile.to_string() }
    contributions := [String:EffectiveFact].from([(profile_fact.key.name.clone(), profile_fact)])
    package_source :: manifest.as_ref().map(fn(facts) { facts.origin.as_str() }).unwrap_or("<source>")
    fixed_facts :: [
        ("Build.Package.Name", FactValue.Text(package_name.clone()), package_source),
        ("Build.Package.Version", FactValue.Text(package_version.clone()), package_source),
        ("Build.OS", FactValue.Enum(bundle.active_os.name().to_string()), "<target>"),
        ("Build.Stamp.Git", FactValue.OptionalText(stamp.git.clone()), ".jet/lock"),
        ("Build.Stamp.Dirty", FactValue.Bool(stamp.dirty), ".jet/lock"),
        ("Build.Stamp.Toolchain", FactValue.Text(stamp.toolchain.clone()), ".jet/lock"),
        ("Build.Stamp.At", FactValue.Text(stamp.at.clone()), ".jet/lock")
    ]
    for (name, value, source) in fixed_facts {
        contribution :: FactContribution.new(name, value, SourceScope.Package, ContributionLayer.Declaration, source)
        fact :: resolve_build_fact(FactKey.new(name), [contribution])?
        contributions.insert(fact.key.name.clone(), fact)
    }
    enum_types :: fieldless_setting_enums(bundle)
    settings := [String:BuildSettingFact].new()
    setting_provenance := [String:[String]].new()
    if manifest.as_ref() == .Some(facts) {
        setting_contributions := [String:[FactContribution]].new()
        setting_defaults := [String:FactValue].new()
        keys :: facts.settings.keys().cloned().collect()
        keys.sort()
        for key in keys {
            declaration :: &facts.settings[&key]
            value :: parse_setting_value(&declaration.ty, &declaration.default, &enum_types).map_err(fn(detail) { [setting_value_diagnostic(&key, &declaration.ty, &declaration.default, detail)] })?
            setting_defaults.insert(key.clone(), policy_fact_value(&value))
            _ :: setting_contributions.entry(key.clone()).or_default()
        }
        // Validate inactive profiles too; package input cannot hide undeclared keys.
        for profile_def in &facts.build_profiles {
            keys :: profile_def.settings.keys().cloned().collect()
            keys.sort()
            for key in keys {
                raw :: &profile_def.settings[&key]
                declaration_opt :: facts.settings.get(&key)
                if declaration_opt.is_none() { return Err([undeclared_setting_diagnostic(&key, "the profile contribution names no declaration in `package.jet`", &facts.origin)]) }
                declaration :: declaration_opt.unwrap()
                _ :: parse_setting_value(&declaration.ty, raw, &enum_types).map_err(fn(detail) { [setting_value_diagnostic(&key, &declaration.ty, raw, detail)] })?
            }
        }
        if facts.build_profiles.iter().find(fn(candidate) { candidate.name == profile }) == .Some(profile_def) {
            keys :: profile_def.settings.keys().cloned().collect()
            keys.sort()
            for key in keys {
                raw :: &profile_def.settings[&key]
                declaration :: facts.settings.get(&key).expect("profile settings were validated before contribution")
                value :: parse_setting_value(&declaration.ty, raw, &enum_types).map_err(fn(detail) { [setting_value_diagnostic(&key, &declaration.ty, raw, detail)] })?
                setting_contributions.entry(key.clone()).or_default().push(FactContribution.new(build_setting_fact_key(&key), policy_fact_value(&value), SourceScope.Package, ContributionLayer.OptimizationBundle, "package.jet:build.{profile}.settings.{key}"))
            }
        }
        keys :: setting_overrides.keys().cloned().collect()
        keys.sort()
        for key in keys {
            raw :: &setting_overrides[&key]
            declaration_opt :: facts.settings.get(&key)
            if declaration_opt.is_none() { return Err([undeclared_setting_diagnostic(&key, "the CLI contribution names no declaration in `package.jet`", &facts.origin)]) }
            declaration :: declaration_opt.unwrap()
            value :: parse_setting_value(&declaration.ty, raw, &enum_types).map_err(fn(detail) { [setting_value_diagnostic(&key, &declaration.ty, raw, detail)] })?
            setting_contributions.entry(key.clone()).or_default().push(FactContribution.new(build_setting_fact_key(&key), policy_fact_value(&value), SourceScope.Package, ContributionLayer.CommandLine, "command line:--set {key}={raw}"))
        }
        for contribution in computed_contributions {
            key_opt :: contribution.key.strip_prefix("Build.Settings.")
            if key_opt.is_none() { return Err([undeclared_setting_diagnostic(&contribution.key, "`fn build` can contribute only to a declared setting", &facts.origin)]) }
            key :: key_opt.unwrap()
            if !facts.settings.contains_key(key) { return Err([undeclared_setting_diagnostic(key, "the `fn build` contribution names no declaration in `package.jet`", &facts.origin)]) }
            setting_contributions.entry(key.to_string()).or_default().push(contribution.clone())
        }
        keys :: setting_contributions.keys().cloned().collect()
        keys.sort()
        for key in keys {
            declarations :: setting_contributions.remove(&key).unwrap()
            default :: setting_defaults.remove(&key).expect("every declared setting has one default")
            fact_key :: FactKey.with_default_source(build_setting_fact_key(&key), default, "package.jet:settings.{key} (default)")
            fact :: resolve_build_fact(fact_key, declarations)?
            declaration :: facts.settings.get(&key).expect("setting contribution key was checked against the manifest")
            value :: setting_value_from_fact(&key, &declaration.ty, &fact.value, &enum_types)?
            setting_provenance.insert(key.clone(), fact.provenance.iter().map(setting_provenance_line).collect())
            settings.insert(key, BuildSettingFact { ty: declaration.ty.clone(), value })
            contributions.insert(fact.key.name.clone(), fact)
        }
    } else if !setting_overrides.is_empty() || !computed_contributions.is_empty() {
        declaration_site :: bundle.project_root.join(PACKAGE_FILE).display().to_string()
        keys :: setting_overrides.keys().cloned().collect()
        keys.sort()
        key :: keys.first().cloned().or_else(fn() {
            computed_contributions.first().map(fn(contribution) { contribution.key.strip_prefix("Build.Settings.").unwrap_or(&contribution.key).to_string() })
        }).unwrap_or_else(fn() { "<unknown>" })
        return Err([undeclared_setting_diagnostic(&key, "the package has no `settings:` declaration", &declaration_site)])
    }
    target_dossier :: bundle.build_facts.target_dossier.clone()
    artifact_build :: bundle.build_facts.artifact_build
    bundle.build_facts = BuildFactSnapshot { package_name, package_version, os: bundle.active_os,
        target_triple, profile: resolved_profile, artifact_build, stamp: stamp.clone(), contributions,
        settings, setting_provenance, target_dossier }
    Ok(())
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2259
fn build_setting_fact_key(key: &String) -> String { "Build.Settings.{key}" }
// Rust: crates/jet-driver/src/Driver/mod.rs:2263
fn policy_fact_value(value: &BuildFactValue) -> FactValue {
    value == {
        .Text(value) -> FactValue.Text(value.clone())
        .Bool(value) -> FactValue.Bool(value)
        .Int(value) -> FactValue.Int(value)
        .Char(value) -> FactValue.Char(value)
        .Enum { variant, .. } -> FactValue.Enum(variant.clone())
        .OptionalText(value) -> FactValue.OptionalText(value.clone())
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2288
fn setting_provenance_line(contribution: &FactContribution) -> String {
    reason :: contribution.reason.as_deref().map_or(String.new(), fn(reason) { " ({reason})" })
    "{contribution.source}{reason}"
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2296
fn setting_value_from_fact(key: &String, ty: &String, value: &FactValue, enum_types: &[String:Set[String]]) -> Result[BuildFactValue, [Diagnostic]] {
    raw :: value.display()
    type_name := ty.trim() // #4303
    (type_name, value) == {
        ("Bool", .Bool(value)) -> Ok(BuildFactValue.Bool(value))
        ("Int", .Int(value)) -> Ok(BuildFactValue.Int(value))
        ("Char", .Char(value)) -> Ok(BuildFactValue.Char(value))
        ("String", .Text(value)) -> Ok(BuildFactValue.Text(value.clone()))
        (type_name, .Enum(variant)) if valid_setting_type_name(type_name) && enum_types.get(type_name).is_some_and(fn(variants) { variants.contains(variant) }) -> Ok(BuildFactValue.Enum { type_name: type_name.to_string(), variant: variant.clone() })
        _ -> Err([setting_value_diagnostic(key, ty, &raw, "the computed value does not match the declared setting type")])
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2337
fn fact_contribution_diagnostic(error: FactError) -> Diagnostic {
    error.diagnostic() == { .Some(diagnostic) -> diagnostic; .None -> Diagnostic.error("E3521", "build fact contributions conflict", error.message(), "make same-layer writers agree, or move one value to a more explicit layer", None) }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2350
fn resolve_build_fact(key: FactKey, contributions: IntoIterator[FactContribution]) -> Result[EffectiveFact, [Diagnostic]] {
    resolve(key, contributions).map_err(fn(error) { [fact_contribution_diagnostic(error)] })?.ok_or_else(fn() {
        [Diagnostic.error("E3521", "build fact has no contribution", "the selected build fact must have at least one registered writer", "restore the declaration or choose a source with a complete build fact plane", None)]
    })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2368
fn undeclared_setting_diagnostic(key: &String, why: &String, declaration_site: &String) -> Diagnostic {
    Diagnostic.error("E0302", "`$build.settings.{key}` is undeclared", why.to_string(), "add `{key}: Type = default` to the `settings: {{ … }}` block in `{declaration_site}`", None)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2380
fn setting_value_diagnostic(key: &String, ty: &String, raw: &String, detail: String) -> Diagnostic {
    Diagnostic.error("E0302", "setting `{key}` cannot use `{raw}` as `{ty}`", detail, "use a `{ty}` value for the declared setting `{key}`", None)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2390
fn parse_setting_value(ty: &String, raw: &String, enum_types: &[String:Set[String]]) -> BuildFactValue Err! {
    raw := raw.trim() // #4303
    type_name := ty.trim() // #4303
    type_name == {
        "Bool" -> raw == { "true" -> BuildFactValue.Bool(true); "false" -> BuildFactValue.Bool(false); _ -> Err("Bool settings use `true` or `false`") }
        "Int" -> BuildFactValue.Int(raw.parse[I64]().map_err(fn(_) { "Int settings use a signed 64-bit whole number" })?)
        "Char" -> BuildFactValue.Char(parse_setting_char(raw)?)
        "String" -> BuildFactValue.Text(unquote_setting(raw))
        type_name -> {
            if !valid_setting_type_name(type_name) { return Err("settings use Bool, Int, Char, String, or a fieldless enum type") }
            variant := raw.strip_prefix('.').unwrap_or(raw).trim() // #4303
            if variant.is_empty() || !valid_setting_variant(variant) { return Err("fieldless enum settings use a named variant such as `.On`") }
            variants_opt :: enum_types.get(type_name)
            if variants_opt.is_none() { return Err("`{type_name}` is not a declared fieldless enum") }
            variants :: variants_opt.unwrap()
            if !variants.contains(variant) { return Err("`{type_name}` has no fieldless variant `{variant}`") }
            BuildFactValue.Enum { type_name: type_name.to_string(), variant: variant.to_string() }
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2436
fn fieldless_setting_enums(bundle: &ProgramBundle) -> [String:Set[String]] {
    out := [String:Set[String]].new()
    for module in &bundle.modules { collect_fieldless_setting_enums(&module.items, &out) }
    out
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2446
fn collect_fieldless_setting_enums(items: &[Item], out: &[String:Set[String]]) -> {
    for item in items {
        item == {
            .Enum(def) -> {
                variants :: def.variants.iter().filter_map(fn(variant) { if variant.payload == VariantPayload.Unit { Some(variant.name.clone()) } else { None } }).collect[Set[String]]()
                if variants.len() == def.variants.len() { out.insert(def.name.clone(), variants) }
            }
            .CodeModule(module) -> { if module.body == .Some(body) { collect_fieldless_setting_enums(body, out) } }
            .GenericModule(module) -> collect_fieldless_setting_enums(&module.body, out)
            _ -> {}
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2478
fn valid_setting_type_name(name: &String) -> Bool {
    chars := name.chars()
    chars.next().is_some_and(fn(first) { first.is_ascii_uppercase() }) && chars.all(fn(ch) { ch.is_ascii_alphanumeric() || ch == '_' })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2484
fn valid_setting_variant(name: &String) -> Bool {
    name.split('.').all(fn(segment) {
        chars := segment.chars()
        chars.next().is_some_and(fn(first) { first.is_ascii_uppercase() }) && chars.all(fn(ch) { ch.is_ascii_alphanumeric() || ch == '_' })
    })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2492
fn unquote_setting(raw: &String) -> String {
    raw := raw.trim() // #4303
    body :: raw.strip_prefix('"').and_then(fn(value) { value.strip_suffix('"') }).unwrap_or(raw)
    out := String.new()
    escaped := false
    for ch in body.chars() {
        if escaped { out.push(ch == { 'n' -> '\n'; 'r' -> '\r'; 't' -> '\t'; other -> other }); escaped = false }
        else if ch == '\\' { escaped = true }
        else { out.push(ch) }
    }
    if escaped { out.push('\\') }
    out
}
// Rust: crates/jet-driver/src/Driver/mod.rs:2521
fn parse_setting_char(raw: &String) -> Char Err! {
    body :: raw.strip_prefix('\'').and_then(fn(value) { value.strip_suffix('\'') }) == {
        .Some(body) -> body
        .None if raw.chars().count() == 1 -> return raw.chars().next().unwrap()
        .None -> return Err("Char settings use one quoted character")
    }
    value :: unquote_setting(body)
    chars := value.chars()
    ch :: chars.next()
    if ch.is_none() || chars.next().is_some() { return Err("Char settings need one character") }
    ch.unwrap()
}

