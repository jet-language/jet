// Rust: crates/jet-driver/src/Driver/mod.rs:3136
// One checked front end per build; cache keys describe the program actually emitted.
pub struct PreparedBuildFrontEnd {
    package_build_fingerprint: String?
    inputs: FrontEndInputs
    bundle: ProgramBundle
    effect_facts: SemIndexEffectFacts
    program_value: CtValue?
    lints: [Diagnostic]
    build_index: USize?
    build_span: Span?
    compile_mode: CompileMode
    active_os: OSTarget
    build_stamp: BuildStamp
    runtime_bundle_for_package: ProgramBundle?
    runtime_source_paths: [OSPath]
    source_closure: [(OSPath, String)]
}
impl PreparedBuildFrontEnd {
    // Rust: crates/jet-driver/src/Driver/mod.rs:3156
    fn bundle(self: &Self) -> &ProgramBundle { &self.bundle }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3161
    fn set_program_value(self: &Self, value: CtValue) -> { self.program_value = Some(value) }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3167
    fn selects_build_entry(self: &Self) -> Bool { self.build_index.is_some() }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3178
    fn runtime_program(self: &Self) -> (&ProgramBundle)? { if self.runtime_bundle_for_package.is_none() { Some(&self.bundle) } else { None } }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3193
    fn emitted_program(self: &Self) -> (&ProgramBundle)? { if self.build_index.is_none() { self.runtime_program() } else { None } }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3202
    fn effect_facts(self: &Self) -> &SemIndexEffectFacts { &self.effect_facts }
    // Rust: crates/jet-driver/src/Driver/mod.rs:3206
    fn source_closure(self: &Self) -> &[(OSPath, String)] { &self.source_closure }
}
