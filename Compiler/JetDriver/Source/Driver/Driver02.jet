// Rust: crates/jet-driver/src/Driver/mod.rs:3455
pub fn prepared_front_end_mismatch(file: &String) -> Diagnostic {
    Diagnostic.error("E2105", "prepared build front end does not match `{file}`", "resuming it could compile a source or build-input snapshot different from the requested build", "restart the build from the current source and build inputs", None)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:3466
fn compile_bundle_path_build_on_compiler_stack(file: &String, options: BuildRunOptions, overlay: (&OSPath, &String)?, dependency_boundary: (&String)?, prepared: PreparedBuildFrontEnd?, without_codegen: Bool, project_check: Bool, source_closure: &[(OSPath, String)]) -> Result[BuildCompileOutput, [Diagnostic]] {
    options := options
    if project_check { options.execute = false; options.inspect_only = true; options.emit_generated = false }
    if options.locked { _ :: verify_locked_dependency_sources(file)? }
    inputs :: FrontEndInputs.for_build(file, &options)
    prepared :: prepared == {
        .Some(prepared) if overlay.is_none() && prepared.inputs == inputs -> prepared
        .Some(_) -> return Err([prepared_front_end_mismatch(file)])
        .None -> prepare_build_front_end_on_compiler_stack(inputs, overlay, source_closure)?
    }
    compile_build_from_front_end(file, options, dependency_boundary, prepared, without_codegen, project_check)
}

// Rust: crates/jet-driver/src/Driver/mod.rs:3511
// Boundary-spanning stage-one prefix; Driver03 resumes with these exact locals.
pub fn prepare_build_front_end_on_compiler_stack(inputs: FrontEndInputs, overlay: (&OSPath, &String)?, source_closure: &[(OSPath, String)]) -> Result[PreparedBuildFrontEnd, [Diagnostic]] {
    file :: inputs.file.as_str()
    direct_package_overlay :: if overlay.is_none() { package_manifest_build_overlay(file)? } else { None }
    load_span := jet_driver.Trace.span("load")
    bundle := load_build_entry_bundle(file, overlay, direct_package_overlay.as_ref(), source_closure)?
    load_span.items(bundle.modules.len())
    drop(load_span)
    runtime_bundle_for_package := None
    package_build_fingerprint := None
    runtime_source_paths :: bundle.modules.iter().map(fn(module) { module.path.clone() }).collect[[OSPath]]()
    package_entry :: if inputs.build_override && inputs.package_scope { package_build_entry_source(&bundle.project_root)? } else { None }
    package_manifest_entry :: inputs.build_override && direct_package_overlay.is_some()
    has_package_entry :: package_entry.is_some() || package_manifest_entry
    active_os :: OSTarget.active(inputs.cross_target.as_deref())
    entry_path :: OSPath.new(file)
    entry_dir :: entry_path.parent().unwrap_or(OSPath.new("."))
    is_workspace_entry :: AuthorityResolver.open(entry_dir) == {
        .Ok(resolver) -> resolver.resolve_workspace_source() == {
            .Ok(.Some(source)) -> {
                entry_name :: entry_path.file_name().ok_or_else(fn() { [Diagnostic.error("E1334", "workspace entry cannot be resolved", "the workspace entry must name one regular file", "use an existing regular run.jet entry", None)] })?
                checked_entry :: resolver.checked_file(&OSPath.new(entry_name)).map_err(fn(error) { [error.diagnostic()] })?
                _ :: resolver.revalidate_file(&checked_entry).map_err(fn(error) { [error.diagnostic()] })?
                _ :: resolver.revalidate_source(&source).map_err(fn(error) { [error.diagnostic()] })?
                if source.checked.path != checked_entry.path { false }
                else if source.role != WorkspaceSourceRole.Index { return Err([Diagnostic.error("E1334", "workspace build entry is selected by an authority source", "workspace build execution requires the matching source to have the Index role; an authority source cannot select a workspace entry", "declare the workspace index in `workspace.jet`, or build the member entry directly", None)]) }
                else { true }
            }
            .Ok(.None) -> false
            .Err(error) -> return Err([error.workspace_diagnostic()])
        }
        .Err(error) if error.is_missing() -> false
        .Err(error) -> return Err([error.diagnostic()])
    }
    compile_mode :: if inputs.plugin_target || has_package_entry || is_workspace_entry { CompileMode.Check } else { CompileMode.Run }
    bundle.active_os = active_os
    set_bundle_target(&bundle, inputs.cross_target.as_deref())
    prepare_build_front_end_finish(inputs, bundle, package_entry, active_os, compile_mode, package_build_fingerprint, runtime_bundle_for_package, runtime_source_paths)
}
