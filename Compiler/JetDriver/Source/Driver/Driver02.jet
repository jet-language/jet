// Rust: crates/jet-driver/src/Driver/mod.rs:2863
pub fn build_plan_json(plan: &BuildPlan, execution: (&BuildExecutionReport)?) -> String {
    graph :: graph_for_build_query(plan, execution)
    targets :: graph.targets.iter().map(fn(target) {
        deps :: target.deps.iter().map(fn(id) { id.0.to_string() }).collect[[String]]().join(",")
        actions :: target.actions.iter().map(fn(id) { id.0.to_string() }).collect[[String]]().join(",")
        "{{\"id\":{target.id.0},\"name\":\"{graph_json_escape(&target.name)}\",\"kind\":\"{target.kind:?}\",\"deps\":[{deps}],\"actions\":[{actions}],\"files\":{graph_json_strings(&target.files)}}}"
    }).collect[[String]]().join(",")
    actions :: graph.actions.iter().map(fn(action) {
        real :: &plan.actions()[action.id.0]
        probes :: real.probes.iter().map(fn(probe) { plan.probes()[probe.id().0].name.clone() }).collect[[String]]()
        provenance :: plan.explain_action_named(&action.name).map(fn(fact) { fact.provenance }).unwrap_or_default()
        caps :: action.caps.iter().map(fn(cap) { cap.name().to_string() }).collect[[String]]()
        pools :: action.pools.iter().map(fn(pool) { pool.as_str().to_string() }).collect[[String]]()
        "{{\"id\":{action.id.0},\"name\":\"{graph_json_escape(&action.name)}\",\"inputs\":{graph_json_strings(&action.inputs)},\"outputs\":{graph_json_strings(&action.outputs)},\"caps\":{graph_json_strings(&caps)},\"pools\":{graph_json_strings(&pools)},\"toolchain\":\"{graph_json_escape(&plan.toolchains()[real.toolchain.id().0].name)}\",\"probes\":{graph_json_strings(&probes)},\"cache\":\"{real.cache:?}\",\"cache_status\":\"{graph_cache_status(action.cache_hit)}\",\"key\":\"{graph_json_escape(action.key.as_str())}\",\"compiler_owned\":{real.compiler_owned},\"provenance\":{graph_json_strings(&provenance)}}}"
    }).collect[[String]]().join(",")
    files :: graph.files.iter().map(graph_file_json).collect[[String]]().join(",")
    affected_files :: graph.affected_files().iter().map(graph_file_json).collect[[String]]().join(",")
    action_keys :: graph.action_keys().iter().map(fn(entry) { "{{\"action\":\"{graph_json_escape(&entry.action)}\",\"key\":\"{graph_json_escape(entry.key.as_str())}\"}}" }).collect[[String]]().join(",")
    cache_hits :: graph.cache_hits().iter().map(fn(action) { "{{\"action\":\"{graph_json_escape(&action.name)}\",\"key\":\"{graph_json_escape(action.key.as_str())}\"}}" }).collect[[String]]().join(",")
    default :: plan.default_target().map(fn(target) { target.id().0.to_string() }).unwrap_or_else(fn() { "null" })
    toolchains :: plan.toolchains().iter().map(fn(tool) { "{{\"name\":\"{graph_json_escape(&tool.name)}\",\"target\":\"{graph_json_escape(&tool.target_triple)}\"}}" }).collect[[String]]().join(",")
    probes :: plan.probes().iter().map(fn(probe) { "{{\"name\":\"{graph_json_escape(&probe.name)}\",\"kind\":\"{probe.kind:?}\",\"reproducibility\":\"{probe.reproducibility:?}\"}}" }).collect[[String]]().join(",")
    generated :: plan.generated_modules().iter().map(fn(module) { "{{\"name\":\"{graph_json_escape(&module.name)}\",\"path\":\"{graph_json_escape(module.path.as_str())}\",\"digest\":\"{graph_json_escape(module.source_digest.as_str())}\"}}" }).collect[[String]]().join(",")
    "{{\"schema_version\":1,\"default\":{default},\"targets\":[{targets}],\"actions\":[{actions}],\"action_keys\":[{action_keys}],\"cache_hits\":[{cache_hits}],\"files\":[{files}],\"affected_files\":[{affected_files}],\"toolchains\":[{toolchains}],\"probes\":[{probes}],\"generated\":[{generated}]}}"
}
// Rust: crates/jet-driver/src/Driver/mod.rs:3024
fn graph_cache_status(hit: Bool?) -> String { hit == { .Some(true) -> "hit"; .Some(false) -> "miss"; .None -> "unknown" } }
// Rust: crates/jet-driver/src/Driver/mod.rs:3032
pub fn graph_json_escape(value: &String) -> String {
    escaped := String.with_capacity(value.len())
    for character in value.chars() {
        character == {
            '\\' -> escaped.push_str("\\\\")
            '"' -> escaped.push_str("\\\"")
            '\n' -> escaped.push_str("\\n")
            '\r' -> escaped.push_str("\\r")
            '\t' -> escaped.push_str("\\t")
            character if character.is_control() -> escaped.push_str(&"\\u{character as U32:04x}")
            character -> escaped.push(character)
        }
    }
    escaped
}
// Rust: crates/jet-driver/src/Driver/mod.rs:3050
fn graph_json_strings(values: &[String]) -> String {
    items :: values.iter().map(fn(value) { "\"{graph_json_escape(value)}\"" }).collect[[String]]().join(",")
    "[{items}]"
}
// Rust: crates/jet-driver/src/Driver/mod.rs:3061
fn graph_file_json(file: &BuildGraphFile) -> String {
    owner :: file.owner.map(fn(id) { id.0.to_string() }).unwrap_or_else(fn() { "null" })
    consumers :: file.consumers.iter().map(fn(id) { id.0.to_string() }).collect[[String]]().join(",")
    targets :: file.targets.iter().map(fn(id) { id.0.to_string() }).collect[[String]]().join(",")
    "{{\"path\":\"{graph_json_escape(&file.path)}\",\"owner\":{owner},\"consumers\":[{consumers}],\"targets\":[{targets}]}}"
}

