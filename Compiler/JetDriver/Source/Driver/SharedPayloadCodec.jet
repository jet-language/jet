// Shared payload materialization is a move boundary, not a second value ABI.
// All physical facts come from the parent's admitted ordinary-layout inventory.
use core.math as shared_payload_math
use jet_backend.[CoreSharedManifest, CoreSharedNativeLayout, CoreSharedLayoutMember, CoreSharedLayoutVariant, CoreSharedParentCallableResult, X64NativeAllocation, core_shared_runtime_call, core_shared_runtime_allocate, x64_execution_free, x64_native_call, x64_native_slot_write, x64_value_word, x64_value_byte, x64_value_unsigned_bytes, lower_mono_fingerprint, lower_result_selector, lower_result_payload_offset]
use jet_eval.[JetEvalHostTypeShape, JetEvalHostTypeNode]
use jet_foundation.[MIRType, TComptimeValue, TComptimeKey, TComptimeKeyField, TComptimeMapEntry, TComptimeField, TComptimeEnumArg, TComptimeReport, Type, mir_big_integer_key_compare]

struct JetDriverNativePayloadCodec {
    host: JetDriverCoreSourceParentHost
    manifest: CoreSharedManifest
    shape: JetEvalHostTypeShape
    type_key: String
}
enum JetDriverNativePayloadOwner {
    Allocation(receipt: X64NativeAllocation)
    Value(slot: Int, drop_address: Int)
}
struct JetDriverNativePayloadStage {
    pointer: Int
    type_key: String
    initialized: Bool
    refusal_key: String
    owners: [JetDriverNativePayloadOwner]
}
struct JetDriverNativePayloadDecoded {
    value: TComptimeValue?
    refusal_key: String
}
// The factory obtains this manifest ONCE for its admitted attachment; each
// type-specific codec borrows that immutable receipt rather than fetching it.
fn jet_driver_native_payload_codec(host: JetDriverCoreSourceParentHost, manifest: CoreSharedManifest, shape: JetEvalHostTypeShape, type_key: String) -> JetDriverNativePayloadCodec? Never! {
    guard :: host.attachment.guard_read()
    attachment :: guard.value ?? return None
    if attachment.manifest_digest != manifest.digest -> return None
    if shape.root < 0 || shape.root >= shape.nodes.len() -> return None
    loop row in manifest.keyed_native_layout_inventory {
        if row.type_key == type_key -> return Val(JetDriverNativePayloadCodec{host: host, manifest: manifest, shape: shape, type_key: type_key})
    }
    None
}
fn jet_driver_payload_layout_in(layouts: [CoreSharedNativeLayout], key: String) -> CoreSharedNativeLayout? Never! {
    loop row in layouts { if row.type_key == key -> return Val(row) }
    None
}
fn jet_driver_payload_layout(codec: JetDriverNativePayloadCodec, key: String) -> CoreSharedNativeLayout? Never! {
    jet_driver_payload_layout_in(codec.manifest.keyed_native_layout_inventory, key)
}
fn jet_driver_payload_allocate(codec: JetDriverNativePayloadCodec, stage: &JetDriverNativePayloadStage, size: Int, align: Int) -> Int {
    receipt :: core_shared_runtime_allocate(codec.host.runtime, if size == 0 -> 1 else -> size, align)
    if receipt.refusal_key != "" {
        stage.refusal_key = receipt.refusal_key
        return 0
    }
    &stage.owners.push(JetDriverNativePayloadOwner.Allocation{receipt: receipt})
    receipt.pointer
}
// Entries are acquired in dependency order: reverse cleanup drops initialized
// child owners before the allocations containing their slots. Completing a
// parent moves those child owners into its one original typed drop action.
fn jet_driver_payload_complete(stage: &JetDriverNativePayloadStage, mark: Int, slot: Int, drop_address: Int) {
    loop stage.owners.len() > mark -> &stage.owners.pop().drop("child ownership moved into the completed native parent")
    if drop_address != 0 -> &stage.owners.push(JetDriverNativePayloadOwner.Value{slot: slot, drop_address: drop_address})
}
fn jet_driver_native_payload_release(stage: &JetDriverNativePayloadStage) -> String {
    error := ""
    loop stage.owners.len() > 0 {
        owner :: &stage.owners.pop() ?? panic("native ownership journal changed during release")
        if owner == {
            .Value(slot, drop_address) -> { _ := x64_native_call(drop_address, 1, slot, 0, 0) }
            .Allocation(receipt) -> {
                failure :: x64_execution_free(receipt, receipt.size, receipt.align)
                if failure != "" && error == "" -> error = failure
            }
        }
    }
    stage.pointer = 0
    stage.initialized = false
    error
}
fn jet_driver_payload_drop_address(codec: JetDriverNativePayloadCodec, row: CoreSharedNativeLayout) -> CoreSharedParentCallableResult Never! {
    if row.drop_identity == "" -> return CoreSharedParentCallableResult{address: 0, refusal_key: ""}
    jet_driver_core_source_payload_callable(codec.host, row.type_key, false)
}
fn jet_driver_payload_field(fields: [TComptimeField], name: String) -> TComptimeValue? Never! {
    selected := TComptimeValue?{None}
    loop field in fields {
        if field.name != name -> next
        if selected != None -> return None
        selected = Val(field.value)
    }
    selected
}
fn jet_driver_payload_shape_field(node: JetEvalHostTypeNode, name: String) -> Int? Never! {
    if node == {
        .Struct(_, _, _, fields) | .Tuple(fields) -> loop field in fields { if field.name == name -> return Val(field.node) }
        else -> {}
    }
    None
}
fn jet_driver_payload_key_value(key: TComptimeKey) -> TComptimeValue Never! {
    if key == {
        .Int(value) -> TComptimeValue.Int{value: value}
        .BigInt(decimal) -> TComptimeValue.BigInt{decimal: decimal}
        .String(value) -> TComptimeValue.String{value: value}
        .Bool(value) -> TComptimeValue.Bool{value: value}
        .Char(value) -> TComptimeValue.Char{value: value}
        .Tuple(fields) | .Struct(_, fields) -> {
            name :: if key == {.Struct(type_name, _) -> type_name else -> "Tuple"}
            values :: loop field in fields -> TComptimeField{name: field.name, value: jet_driver_payload_key_value(field.key)}
            TComptimeValue.Struct{type_name: name, fields: values}
        }
        .Enum(type_name, variant) -> TComptimeValue.Enum{type_name: type_name, variant: variant, args: [TComptimeEnumArg]{}}
    }
}
fn jet_driver_payload_variant_selector(row: CoreSharedNativeLayout, name: String) -> Int? Never! {
    loop variant in row.variants { if variant.name == name -> return Val(variant.selector) }
    None
}
fn jet_driver_payload_key_field(fields: [TComptimeKeyField], name: String) -> TComptimeKey? Never! {
    loop field in fields { if field.name == name -> return Val(field.key) }
    None
}
struct JetDriverNativePayloadKeyOrder {
    order: Int
    refusal_key: String
}
// Map keys use their checked physical ordering, including declaration-order
// enum discriminants and declaration-order struct fields, not display strings.
fn jet_driver_payload_key_order(layouts: [CoreSharedNativeLayout], key: String, left: TComptimeKey, right: TComptimeKey) -> JetDriverNativePayloadKeyOrder Never! {
    row :: jet_driver_payload_layout_in(layouts, key) ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadLayoutMissing: {key}"}
    if row.child_keys.len() == 1 && row.members.len() == 0 && row.variants.len() == 0 && row.representation != "Inline" -> return jet_driver_payload_key_order(layouts, row.child_keys[0], left, right)
    order := Int?{None}
    if left == {
        .Int(a) -> {
            if right == .Int(b) -> order = Val(if a < b -> -1 else if a > b -> 1 else -> 0)
            if right == .BigInt(b) -> order = Val(mir_big_integer_key_compare("{a}", b))
        }
        .BigInt(a) -> {
            if right == .BigInt(b) -> order = Val(mir_big_integer_key_compare(a, b))
            if right == .Int(b) -> order = Val(mir_big_integer_key_compare(a, "{b}"))
        }
        .String(a) -> if right == .String(b) -> order = Val(if a < b -> -1 else if a > b -> 1 else -> 0)
        .Char(a) -> if right == .Char(b) -> order = Val(if a < b -> -1 else if a > b -> 1 else -> 0)
        .Bool(a) -> if right == .Bool(b) -> order = Val(if a == b -> 0 else if a -> 1 else -> -1)
        .Enum(_, a) -> if right == .Enum(_, b) {
            first :: jet_driver_payload_variant_selector(row, a) ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            second :: jet_driver_payload_variant_selector(row, b) ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            order = Val(if first < second -> -1 else if first > second -> 1 else -> 0)
        }
        .Tuple(a) | .Struct(_, a) -> {
            second := [TComptimeKeyField]?{None}
            if right == {
                .Tuple(b) | .Struct(_, b) -> second = Val(b)
                else -> {}
            }
            fields :: second ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            if a.len() != row.members.len() || fields.len() != row.members.len() -> return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            loop member in row.members {
                first :: jet_driver_payload_key_field(a, member.name) ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
                other :: jet_driver_payload_key_field(fields, member.name) ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
                compared :: jet_driver_payload_key_order(layouts, member.type_key, first, other)
                if compared.refusal_key != "" || compared.order != 0 -> return compared
            }
            order = Val(0)
        }
    }
    value :: order ?? return JetDriverNativePayloadKeyOrder{order: 0, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
    JetDriverNativePayloadKeyOrder{order: value, refusal_key: ""}
}
// A fallible stable merge of indices keeps errors out of an infallible sort
// callback and never materializes TData or native allocations while ordering.
fn jet_driver_payload_order_keys(layouts: [CoreSharedNativeLayout], key: String, entries: [TComptimeMapEntry], ordered: &[Int]) -> String Never! {
    loop (index, entry) in entries {
        checked :: jet_driver_payload_key_order(layouts, key, entry.key, entry.key)
        if checked.refusal_key != "" -> return checked.refusal_key
        &ordered.push(index)
    }
    // copy: the bottom-up merge sort writes runs between `ordered` and a scratch buffer of the same
    // length. This copy is that second buffer, and `ordered` (the caller's list) keeps the result.
    scratch := ordered.copy()
    width := 1
    loop width < ordered.len() {
        start := 0
        loop start < ordered.len() {
            middle :: if start + width < ordered.len() -> start + width else -> ordered.len()
            end :: if middle + width < ordered.len() -> middle + width else -> ordered.len()
            left := start
            right := middle
            loop output in start..<end {
                take_left := right == end
                if left < middle && right < end {
                    compared :: jet_driver_payload_key_order(layouts, key, entries[ordered[left]].key, entries[ordered[right]].key)
                    if compared.refusal_key != "" -> return compared.refusal_key
                    take_left = compared.order <= 0
                }
                if take_left {
                    scratch[output] = ordered[left]
                    left += 1
                } else {
                    scratch[output] = ordered[right]
                    right += 1
                }
            }
            start = end
        }
        loop index in 0..<ordered.len() -> ordered[index] = scratch[index]
        width *= 2
    }
    ""
}
fn jet_driver_payload_text(codec: JetDriverNativePayloadCodec, text: String, symbol: String) -> Int? {
    bytes :: text.bytes()
    scratch :: core_shared_runtime_allocate(codec.host.runtime, bytes.len() + 8, 8)
    if scratch.refusal_key != "" -> return None
    loop (index, byte) in bytes {
        error :: x64_native_slot_write(scratch.pointer + index, 1, Int.from_u8(byte))
        if error != "" {
            _ := x64_execution_free(scratch, scratch.size, scratch.align)
            return None
        }
    }
    result :: core_shared_runtime_call(codec.host.runtime, symbol, 2, scratch.pointer, bytes.len(), 0)
    error :: x64_execution_free(scratch, scratch.size, scratch.align)
    if result.refusal_key != "" || error != "" -> return None
    Val(result.word)
}
// Inverse of DriverNativeComptime's exact IEEE32 widening. Reject values not
// already represented by the checked 32-bit carrier, rather than rounding.
fn jet_driver_payload_float32(bits: Int) -> Int? Never! {
    sign :: (bits >> 32).bit_and(2147483648)
    exponent :: (bits >> 52).bit_and(2047)
    fraction :: bits.bit_and(4503599627370495)
    result := sign
    if exponent == 2047 -> result = result.bit_or((255 << 23).bit_or((fraction >> 29)))
    else if exponent >= 897 && exponent <= 1150 -> result = result.bit_or(((exponent - 896) << 23).bit_or((fraction >> 29)))
    else if exponent >= 874 && exponent <= 896 -> result = result.bit_or((fraction.bit_or(4503599627370496)) >> (926 - exponent))
    else if exponent != 0 || fraction != 0 -> return None
    if jet_driver_native_float32_bits(result) != bits -> return None
    Val(result)
}
fn jet_driver_payload_scalar(codec: JetDriverNativePayloadCodec, row: CoreSharedNativeLayout, value: TComptimeValue, target: Int) -> String {
    kind :: row.kind.bit_and(4294967295)
    word := 0
    if kind == 11 {
        if value != .Unit -> return "CoreSharedPayloadValueMismatch: {row.type_key}"
        return ""
    }
    if kind == 1 {
        decimal := ""
        if value == {
            .Int(number) -> {
                if number >= -4611686018427387904 && number < 4611686018427387904 -> return x64_native_slot_write(target, row.payload_size, number)
                decimal = "{number}"
            }
            .BigInt(text) -> {
                _ := Int.parse(text) ?? return "CoreSharedPayloadIntegerInvalid: {row.type_key}"
                decimal = text
            }
            else -> return "CoreSharedPayloadValueMismatch: {row.type_key}"
        }
        word = jet_driver_payload_text(codec, decimal, "jet_rt_int_from_static") ?? return "CoreSharedPayloadConstructorMissing: jet_rt_int_from_static"
    } else if kind == 5 {
        if value == .String(text) -> word = jet_driver_payload_text(codec, text, "jet_rt_string_from_static") ?? return "CoreSharedPayloadConstructorMissing: jet_rt_string_from_static"
        else { return "CoreSharedPayloadValueMismatch: {row.type_key}" }
    } else if kind == 2 || kind == 3 {
        bits :: row.kind >> 32
        if bits < 1 || bits > 64 -> return "CoreSharedPayloadIntegerWidthInvalid: {row.type_key}"
        number :: if value == {
            .Int(integer) -> integer
            .BigInt(decimal) -> Int.parse(decimal) ?? return "CoreSharedPayloadIntegerInvalid: {row.type_key}"
            else -> { return "CoreSharedPayloadValueMismatch: {row.type_key}" }
        }
        limit :: 1 << bits
        if kind == 2 {
            if number < -(limit >> 1) || number >= (limit >> 1) -> return "CoreSharedPayloadIntegerRangeInvalid: {row.type_key}"
        } else if number < 0 || number >= limit -> return "CoreSharedPayloadIntegerRangeInvalid: {row.type_key}"
        word = if number < 0 -> number + limit else -> number
    } else if kind == 9 {
        if value == .Bool(flag) -> word = if flag -> 1 else -> 0
        else { return "CoreSharedPayloadValueMismatch: {row.type_key}" }
    } else if kind == 10 {
        if value == .Char(scalar) {
            if scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) -> return "CoreSharedPayloadCharInvalid: {row.type_key}"
            word = scalar
        } else { return "CoreSharedPayloadValueMismatch: {row.type_key}" }
    } else if row.representation == "FloatBits" || row.representation == "Float32Bits" {
        if value == .Float(number, bits) {
            expected :: if row.representation == "Float32Bits" -> 32 else -> 64
            if bits != expected -> return "CoreSharedPayloadFloatWidthMismatch: {row.type_key}"
            word = shared_payload_math.to_bits(number)
            if word < 0 -> word += 18446744073709551616
            if expected == 32 -> word = jet_driver_payload_float32(word) ?? return "CoreSharedPayloadFloatWidthMismatch: {row.type_key}"
        } else { return "CoreSharedPayloadValueMismatch: {row.type_key}" }
    } else { return "CoreSharedPayloadPhysicalBindingMissing: {row.type_key}" }
    x64_native_slot_write(target, row.payload_size, word)
}
fn jet_driver_payload_member(codec: JetDriverNativePayloadCodec, stage: &JetDriverNativePayloadStage, member: CoreSharedLayoutMember, node: Int, value: TComptimeValue, base: Int) -> String {
    address := base + member.offset
    if member.boxed {
        storage :: jet_driver_payload_layout(codec, member.storage_type_key) ?? return "CoreSharedPayloadLayoutMissing: {member.storage_type_key}"
        address = jet_driver_payload_allocate(codec, &stage, storage.box_size, 8)
        if address == 0 -> return stage.refusal_key
        error :: x64_native_slot_write(base + member.offset, 8, address)
        if error != "" -> return error
    }
    jet_driver_payload_encode_node(codec, &stage, member.type_key, node, value, address)
}
fn jet_driver_payload_encode_node(codec: JetDriverNativePayloadCodec, stage: &JetDriverNativePayloadStage, key: String, node_index: Int, value: TComptimeValue, target: Int) -> String {
    row :: jet_driver_payload_layout(codec, key) ?? return "CoreSharedPayloadLayoutMissing: {key}"
    if node_index < 0 || node_index >= codec.shape.nodes.len() -> return "CoreSharedPayloadShapeInvalid: {key}"
    drop_callable :: jet_driver_payload_drop_address(codec, row)
    if drop_callable.refusal_key != "" -> return drop_callable.refusal_key
    drop_address :: drop_callable.address
    mark :: stage.owners.len()
    node :: codec.shape.nodes[node_index]
    error := ""
    if node == {
        .Scalar(ty) -> {
            if lower_mono_fingerprint(ty) != key -> return "CoreSharedPayloadShapeMismatch: {key}"
            error = jet_driver_payload_scalar(codec, row, value, target)
        }
        .Option(inner) -> {
            if row.child_keys.len() != 1 || row.representation != "Boxed" -> return "CoreSharedPayloadShapeMismatch: {key}"
            if value == .Failed(report) {
                if report == {
                    .Clean(_) -> {}
                    else -> { return "CoreSharedPayloadValueMismatch: {key}" }
                }
                error = x64_native_slot_write(target, 8, 0)
            } else if value == .Present(child) {
                box :: jet_driver_payload_allocate(codec, &stage, row.box_size, 8)
                if box == 0 -> return stage.refusal_key
                error = jet_driver_payload_encode_node(codec, &stage, row.child_keys[0], inner, child, box)
                if error == "" -> error = x64_native_slot_write(target, 8, box)
            } else { return "CoreSharedPayloadValueMismatch: {key}" }
        }
        .Result(ok, failure) -> {
            if row.child_keys.len() != 2 || row.representation != "Boxed" -> return "CoreSharedPayloadShapeMismatch: {key}"
            selected := 0
            child := TComptimeValue.Unit
            if value == {
                .Present(inner) -> {
                    selected = 0
                    child = inner
                }
                .Failed(report) -> if report == .Told(inner) {
                    selected = 1
                    child = inner
                } else { return "CoreSharedPayloadValueMismatch: {key}" }
                else -> return "CoreSharedPayloadValueMismatch: {key}"
            }
            box :: jet_driver_payload_allocate(codec, &stage, row.box_size, 8)
            if box == 0 -> return stage.refusal_key
            error = x64_native_slot_write(box, 8, lower_result_selector(selected == 0))
            if error == "" -> error = jet_driver_payload_encode_node(codec, &stage, row.child_keys[selected], if selected == 0 -> ok else -> failure, child, box + lower_result_payload_offset())
            if error == "" -> error = x64_native_slot_write(target, 8, box)
        }
        .List(inner) -> {
            if row.child_keys.len() != 1 || row.representation != "Inline" -> return "CoreSharedPayloadShapeMismatch: {key}"
            if value == .List(children) {
                child_layout :: jet_driver_payload_layout(codec, row.child_keys[0]) ?? return "CoreSharedPayloadLayoutMissing: {row.child_keys[0]}"
                buffer := 0
                if children.len() > 0 {
                    buffer = jet_driver_payload_allocate(codec, &stage, children.len() * child_layout.stride, 8)
                    if buffer == 0 -> return stage.refusal_key
                    loop (index, child) in children {
                        error = jet_driver_payload_encode_node(codec, &stage, child_layout.type_key, inner, child, buffer + index * child_layout.stride)
                        if error != "" -> return error
                    }
                }
                error = x64_native_slot_write(target, 8, children.len())
                if error == "" -> error = x64_native_slot_write(target + 8, 8, children.len())
                if error == "" -> error = x64_native_slot_write(target + 16, 8, buffer)
            } else if value == .Bytes(bytes) {
                child_layout :: jet_driver_payload_layout(codec, row.child_keys[0]) ?? return "CoreSharedPayloadLayoutMissing: {row.child_keys[0]}"
                if child_layout.kind != ((3).bit_or((8 << 32))) || child_layout.payload_size != 1 -> return "CoreSharedPayloadValueMismatch: {key}"
                buffer := 0
                if bytes.len() > 0 {
                    buffer = jet_driver_payload_allocate(codec, &stage, bytes.len() * child_layout.stride, 8)
                    if buffer == 0 -> return stage.refusal_key
                    loop (index, byte) in bytes {
                        error = x64_native_slot_write(buffer + index * child_layout.stride, child_layout.payload_size, Int.from_u8(byte))
                        if error != "" -> return error
                    }
                }
                error = x64_native_slot_write(target, 8, bytes.len())
                if error == "" -> error = x64_native_slot_write(target + 8, 8, bytes.len())
                if error == "" -> error = x64_native_slot_write(target + 16, 8, buffer)
            } else { return "CoreSharedPayloadValueMismatch: {key}" }
        }
        .Map(key_node, value_node) -> {
            if row.child_keys.len() != 3 || row.members.len() != 2 || row.representation != "Inline" -> return "CoreSharedPayloadShapeMismatch: {key}"
            entry_layout :: jet_driver_payload_layout(codec, row.child_keys[2]) ?? return "CoreSharedPayloadLayoutMissing: {row.child_keys[2]}"
            if value == .Map(entries) {
                ordered := [Int]{}
                error = jet_driver_payload_order_keys(codec.manifest.keyed_native_layout_inventory, row.child_keys[0], entries, &ordered)
                if error != "" -> return error
                buffer := 0
                if ordered.len() > 0 {
                    buffer = jet_driver_payload_allocate(codec, &stage, ordered.len() * entry_layout.stride, 8)
                    if buffer == 0 -> return stage.refusal_key
                    loop (index, original) in ordered {
                        entry :: entries[original]
                        if index > 0 {
                            compared :: jet_driver_payload_key_order(codec.manifest.keyed_native_layout_inventory, row.child_keys[0], entries[ordered[index - 1]].key, entry.key)
                            if compared.refusal_key != "" -> return compared.refusal_key
                            if compared.order == 0 -> return "CoreSharedPayloadMapDuplicateKey: {key}"
                        }
                        base :: buffer + index * entry_layout.stride
                        error = jet_driver_payload_member(codec, &stage, row.members[0], key_node, jet_driver_payload_key_value(entry.key), base)
                        if error == "" -> error = jet_driver_payload_member(codec, &stage, row.members[1], value_node, entry.value, base)
                        if error != "" -> return error
                    }
                }
                error = x64_native_slot_write(target, 8, ordered.len())
                if error == "" -> error = x64_native_slot_write(target + 8, 8, ordered.len())
                if error == "" -> error = x64_native_slot_write(target + 16, 8, buffer)
            } else { return "CoreSharedPayloadValueMismatch: {key}" }
        }
        .Struct(_, _, _, fields) | .Tuple(fields) -> {
            expected :: if node == {.Struct(_, name, _, _) -> name else -> "Tuple"}
            if row.representation != "Inline" || row.members.len() != fields.len() -> return "CoreSharedPayloadShapeMismatch: {key}"
            if value == .Struct(name, values) {
                if name != expected || values.len() != fields.len() -> return "CoreSharedPayloadValueMismatch: {key}"
                loop member in row.members {
                    field_node :: jet_driver_payload_shape_field(node, member.name) ?? return "CoreSharedPayloadShapeMismatch: {key}"
                    child :: jet_driver_payload_field(values, member.name) ?? return "CoreSharedPayloadValueMismatch: {key}"
                    error = jet_driver_payload_member(codec, &stage, member, field_node, child, target)
                    if error != "" -> return error
                }
            } else { return "CoreSharedPayloadValueMismatch: {key}" }
        }
        .Enum(_, type_name, _, variants) -> {
            if value == .Enum(name, variant_name, values) {
                if name != type_name -> return "CoreSharedPayloadValueMismatch: {key}"
                found := false
                loop variant in row.variants {
                    if variant.name != variant_name -> next
                    found = true
                    if variant.members.len() != values.len() -> return "CoreSharedPayloadValueMismatch: {key}"
                    if row.representation == "Discriminant" {
                        if values.len() != 0 -> return "CoreSharedPayloadValueMismatch: {key}"
                        error = x64_native_slot_write(target, 8, variant.selector)
                    } else {
                        box :: jet_driver_payload_allocate(codec, &stage, variant.box_size, 8)
                        if box == 0 -> return stage.refusal_key
                        error = x64_native_slot_write(box, 8, variant.selector)
                        matched_shape := false
                        loop shape_variant in variants {
                            if shape_variant.name != variant.name -> next
                            if shape_variant.args.len() != values.len() -> return "CoreSharedPayloadShapeMismatch: {key}"
                            matched_shape = true
                            loop (index, member) in variant.members {
                                argument :: values[index]
                                expected_name :: if variant.named -> Val(member.name) else -> None
                                if argument.name != expected_name -> return "CoreSharedPayloadValueMismatch: {key}"
                                error = jet_driver_payload_member(codec, &stage, member, shape_variant.args[index].node, argument.value, box)
                                if error != "" -> return error
                            }
                        }
                        if !matched_shape -> return "CoreSharedPayloadShapeMismatch: {key}"
                        if error == "" -> error = x64_native_slot_write(target, 8, box)
                    }
                }
                if !found -> return "CoreSharedPayloadVariantMissing: {key}:{variant_name}"
            } else { return "CoreSharedPayloadValueMismatch: {key}" }
        }
        .Closure(_, function, _) -> return "CoreSharedCallbackConcreteProvenanceMismatch: {key}:{function.value}"
        .Handle(_, _) -> return "CoreSharedPayloadPhysicalBindingMissing: {key}"
    }
    if error != "" -> return error
    jet_driver_payload_complete(&stage, mark, target, drop_address)
    ""
}
fn jet_driver_native_payload_stage(codec: JetDriverNativePayloadCodec, value: TComptimeValue) -> JetDriverNativePayloadStage {
    stage := JetDriverNativePayloadStage{pointer: 0, type_key: codec.type_key, initialized: false, refusal_key: "", owners: [JetDriverNativePayloadOwner]{}}
    row :: jet_driver_payload_layout(codec, codec.type_key) ?? return JetDriverNativePayloadStage{pointer: 0, type_key: codec.type_key, initialized: false, refusal_key: "CoreSharedPayloadLayoutMissing: {codec.type_key}", owners: [JetDriverNativePayloadOwner]{}}
    stage.pointer = jet_driver_payload_allocate(codec, &stage, row.payload_size, row.align)
    if stage.pointer == 0 -> return stage
    pointer :: stage.pointer
    stage.refusal_key = jet_driver_payload_encode_node(codec, &stage, codec.type_key, codec.shape.root, value, pointer)
    if stage.refusal_key != "" {
        cleanup :: jet_driver_native_payload_release(&stage)
        if cleanup != "" -> stage.refusal_key = "{stage.refusal_key};{cleanup}"
    } else { stage.initialized = true }
    stage
}

fn jet_driver_payload_read_text(codec: JetDriverNativePayloadCodec, word: Int) -> String? {
    if word == 0 -> return None
    data :: core_shared_runtime_call(codec.host.runtime, "jet_rt_string_data", 1, word, 0, 0)
    length :: core_shared_runtime_call(codec.host.runtime, "jet_rt_string_byte_len", 1, word, 0, 0)
    if data.refusal_key != "" || length.refusal_key != "" || length.word < 0 -> return None
    bytes := [U8]{}
    loop index in 0..<length.word -> &bytes.push(U8{x64_value_byte(data.word + index)})
    decoded :: String.from_bytes(bytes) ?? return None
    Val(decoded)
}
fn jet_driver_payload_decode_scalar(codec: JetDriverNativePayloadCodec, row: CoreSharedNativeLayout, source: Int) -> TComptimeValue? {
    kind :: row.kind.bit_and(4294967295)
    if kind == 11 -> return Val(TComptimeValue.Unit)
    if kind == 1 {
        word :: x64_value_word(source)
        if word >= -4611686018427387904 && word < 4611686018427387904 -> return Val(TComptimeValue.Int{value: word})
        projection :: core_shared_runtime_call(codec.host.runtime, "jet_rt_int_to_string", 1, word, 0, 0)
        if projection.refusal_key != "" -> return None
        text :: jet_driver_payload_read_text(codec, projection.word)
        cleanup :: core_shared_runtime_call(codec.host.runtime, "jet_rt_string_drop", 1, projection.word, 0, 0)
        if cleanup.refusal_key != "" -> return None
        decimal :: text ?? return None
        number :: Int.parse(decimal) ?? return None
        return Val(TComptimeValue.Int{value: number})
    }
    if kind == 5 {
        text :: jet_driver_payload_read_text(codec, x64_value_word(source)) ?? return None
        return Val(TComptimeValue.String{value: text})
    }
    word := x64_value_unsigned_bytes(source, row.payload_size)
    if kind == 2 || kind == 3 {
        bits :: row.kind >> 32
        if bits < 1 || bits > 64 -> return None
        limit :: 1 << bits
        word = word.bit_and(limit - 1)
        if kind == 2 && word >= (limit >> 1) -> word -= limit
        return Val(TComptimeValue.Int{value: word})
    }
    if kind == 9 {
        if word != 0 && word != 1 -> return None
        return Val(TComptimeValue.Bool{value: word == 1})
    }
    if kind == 10 {
        if word > 1114111 || (word >= 55296 && word <= 57343) -> return None
        return Val(TComptimeValue.Char{value: word})
    }
    if row.representation == "FloatBits" || row.representation == "Float32Bits" {
        width :: if row.representation == "Float32Bits" -> 32 else -> 64
        if width == 32 -> word = jet_driver_native_float32_bits(word)
        if word >= 9223372036854775808 -> word -= 18446744073709551616
        return Val(TComptimeValue.Float{value: shared_payload_math.from_bits(word), bits: width})
    }
    None
}
fn jet_driver_payload_value_key(value: TComptimeValue) -> TComptimeKey? Never! {
    if value == {
        .Int(number) -> return Val(TComptimeKey.Int{value: number})
        .BigInt(decimal) -> {
            number :: Int.parse(decimal) ?? return None
            return Val(TComptimeKey.Int{value: number})
        }
        .String(text) -> return Val(TComptimeKey.String{value: text})
        .Bool(flag) -> return Val(TComptimeKey.Bool{value: flag})
        .Char(scalar) -> return Val(TComptimeKey.Char{value: scalar})
        .Unit -> return Val(TComptimeKey.Tuple{fields: [TComptimeKeyField]{}})
        .Struct(name, values) -> {
            fields := [TComptimeKeyField]{}
            loop field in values {
                key :: jet_driver_payload_value_key(field.value) ?? return None
                &fields.push(TComptimeKeyField{name: field.name, key: key})
            }
            if name == "Tuple" -> return Val(TComptimeKey.Tuple{fields: fields})
            return Val(TComptimeKey.Struct{type_name: name, fields: fields})
        }
        .Enum(name, variant, args) -> {
            if args.len() != 0 -> return None
            return Val(TComptimeKey.Enum{type_name: name, variant: variant})
        }
        else -> return None
    }
}
fn jet_driver_payload_decode_member(codec: JetDriverNativePayloadCodec, member: CoreSharedLayoutMember, node: Int, base: Int) -> JetDriverNativePayloadDecoded {
    address := base + member.offset
    if member.boxed {
        address = x64_value_word(address)
        if address <= 0 -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadBoxMissing: {member.type_key}"}
    }
    jet_driver_payload_decode_node(codec, member.type_key, node, address)
}
fn jet_driver_payload_decode_node(codec: JetDriverNativePayloadCodec, key: String, node_index: Int, source: Int) -> JetDriverNativePayloadDecoded {
    row :: jet_driver_payload_layout(codec, key) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadLayoutMissing: {key}"}
    if node_index < 0 || node_index >= codec.shape.nodes.len() -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeInvalid: {key}"}
    node :: codec.shape.nodes[node_index]
    if node == {
        .Scalar(ty) -> {
            if lower_mono_fingerprint(ty) != key -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            value :: jet_driver_payload_decode_scalar(codec, row, source) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadScalarProjectionInvalid: {key}"}
            return JetDriverNativePayloadDecoded{value: Val(value), refusal_key: ""}
        }
        .Option(inner) -> {
            if row.child_keys.len() != 1 || row.representation != "Boxed" -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            box :: x64_value_word(source)
            if box == 0 {
                child :: jet_driver_payload_layout(codec, row.child_keys[0]) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadLayoutMissing: {row.child_keys[0]}"}
                return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: child.display_name}}}), refusal_key: ""}
            }
            decoded :: jet_driver_payload_decode_node(codec, row.child_keys[0], inner, box)
            value :: decoded.value ?? return decoded
            return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.Present{value: value}), refusal_key: ""}
        }
        .Result(ok, failure) -> {
            if row.child_keys.len() != 2 || row.representation != "Boxed" -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            box :: x64_value_word(source)
            if box <= 0 -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadBoxMissing: {key}"}
            selector :: x64_value_word(box)
            if selector != lower_result_selector(false) && selector != lower_result_selector(true) -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadResultSelectorInvalid: {key}"}
            success :: selector == lower_result_selector(true)
            decoded :: jet_driver_payload_decode_node(codec, row.child_keys[if success -> 0 else -> 1], if success -> ok else -> failure, box + lower_result_payload_offset())
            value :: decoded.value ?? return decoded
            result :: if success -> TComptimeValue.Present{value: value} else -> TComptimeValue.Failed{report: TComptimeReport.Told{value: value}}
            return JetDriverNativePayloadDecoded{value: Val(result), refusal_key: ""}
        }
        .List(inner) -> {
            if row.child_keys.len() != 1 || row.representation != "Inline" -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            child :: jet_driver_payload_layout(codec, row.child_keys[0]) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadLayoutMissing: {row.child_keys[0]}"}
            length :: x64_value_word(source)
            capacity :: x64_value_word(source + 8)
            buffer :: x64_value_word(source + 16)
            if length < 0 || capacity < length || (length > 0 && buffer <= 0) -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadListHeaderInvalid: {key}"}
            values := [TComptimeValue]{}
            loop index in 0..<length {
                decoded :: jet_driver_payload_decode_node(codec, child.type_key, inner, buffer + index * child.stride)
                value :: decoded.value ?? return decoded
                &values.push(value)
            }
            return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.List{values: values}), refusal_key: ""}
        }
        .Map(key_node, value_node) -> {
            if row.child_keys.len() != 3 || row.members.len() != 2 || row.representation != "Inline" -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            entry :: jet_driver_payload_layout(codec, row.child_keys[2]) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadLayoutMissing: {row.child_keys[2]}"}
            length :: x64_value_word(source)
            capacity :: x64_value_word(source + 8)
            buffer :: x64_value_word(source + 16)
            if length < 0 || capacity < length || (length > 0 && buffer <= 0) -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadMapHeaderInvalid: {key}"}
            entries := [TComptimeMapEntry]{}
            loop index in 0..<length {
                base :: buffer + index * entry.stride
                first :: jet_driver_payload_decode_member(codec, row.members[0], key_node, base)
                first_value :: first.value ?? return first
                key_value :: jet_driver_payload_value_key(first_value) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadMapKeyProjectionInvalid: {key}"}
                second :: jet_driver_payload_decode_member(codec, row.members[1], value_node, base)
                second_value :: second.value ?? return second
                &entries.push(TComptimeMapEntry{key: key_value, value: second_value})
            }
            return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.Map{entries: entries}), refusal_key: ""}
        }
        .Struct(_, _, _, fields) | .Tuple(fields) -> {
            if row.representation != "Inline" || row.members.len() != fields.len() -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            name :: if node == {.Struct(_, type_name, _, _) -> type_name else -> "Tuple"}
            values := [TComptimeField]{}
            loop member in row.members {
                child_node :: jet_driver_payload_shape_field(node, member.name) ?? return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
                decoded :: jet_driver_payload_decode_member(codec, member, child_node, source)
                value :: decoded.value ?? return decoded
                &values.push(TComptimeField{name: member.name, value: value})
            }
            return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.Struct{type_name: name, fields: values}), refusal_key: ""}
        }
        .Enum(_, name, _, variants) -> {
            base := source
            if row.representation == "Boxed" -> base = x64_value_word(source)
            else if row.representation != "Discriminant" -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            if base <= 0 -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadBoxMissing: {key}"}
            selector :: x64_value_word(base)
            loop variant in row.variants {
                if variant.selector != selector -> next
                loop shape_variant in variants {
                    if shape_variant.name != variant.name -> next
                    if shape_variant.args.len() != variant.members.len() -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
                    values := [TComptimeEnumArg]{}
                    loop (index, member) in variant.members {
                        decoded :: jet_driver_payload_decode_member(codec, member, shape_variant.args[index].node, base)
                        value :: decoded.value ?? return decoded
                        &values.push(TComptimeEnumArg{name: if variant.named -> Val(member.name) else -> None, value: value})
                    }
                    return JetDriverNativePayloadDecoded{value: Val(TComptimeValue.Enum{type_name: name, variant: variant.name, args: values}), refusal_key: ""}
                }
                return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadShapeMismatch: {key}"}
            }
            return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadEnumSelectorInvalid: {key}"}
        }
        .Closure(_, function, _) -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedCallbackConcreteProvenanceMismatch: {key}:{function.value}"}
        .Handle(_, _) -> return JetDriverNativePayloadDecoded{value: None, refusal_key: "CoreSharedPayloadPhysicalBindingMissing: {key}"}
    }
}
fn jet_driver_native_payload_decode(codec: JetDriverNativePayloadCodec, source: Int) -> JetDriverNativePayloadDecoded {
    jet_driver_payload_decode_node(codec, codec.type_key, codec.shape.root, source)
}

fn jet_driver_payload_copy(source: Int, target: Int, size: Int) -> String {
    at := 0
    loop at < size {
        remaining :: size - at
        width :: if remaining >= 8 -> 8 else if remaining >= 4 -> 4 else if remaining >= 2 -> 2 else -> 1
        word :: if width == 8 -> x64_value_word(source + at) else -> x64_value_unsigned_bytes(source + at, width)
        error :: x64_native_slot_write(target + at, width, word)
        if error != "" -> return error
        at += width
    }
    ""
}
// The native consumer has moved the payload's initialized bytes. Drop only the
// temporary root allocation, never the owners now held by that native consumer.
fn jet_driver_native_payload_disown(stage: &JetDriverNativePayloadStage) -> String {
    if !stage.initialized -> return "CoreSharedPayloadStageNotInitialized: {stage.type_key}"
    if stage.owners.len() > 1 {
        owner :: &stage.owners.pop() ?? panic("initialized payload journal lost its root owner")
        if owner == {
            .Value(_, _) -> {}
            else -> panic("initialized payload journal is not collapsed")
        }
    }
    jet_driver_native_payload_release(&stage)
}
// Caller retains the original physical guard. Old typed ownership is moved to
// the returned journal and must be released only AFTER publish/release, because
// its drop glue can reenter this same Shared cell.
fn jet_driver_native_payload_swap(codec: JetDriverNativePayloadCodec, stage: &JetDriverNativePayloadStage, guard: Int) -> JetDriverNativePayloadStage {
    retired := JetDriverNativePayloadStage{pointer: 0, type_key: codec.type_key, initialized: false, refusal_key: "", owners: [JetDriverNativePayloadOwner]{}}
    if !stage.initialized || stage.type_key != codec.type_key {
        retired.refusal_key = "CoreSharedPayloadStageNotInitialized: {codec.type_key}"
        return retired
    }
    row :: jet_driver_payload_layout(codec, codec.type_key) ?? return JetDriverNativePayloadStage{pointer: 0, type_key: codec.type_key, initialized: false, refusal_key: "CoreSharedPayloadLayoutMissing: {codec.type_key}", owners: [JetDriverNativePayloadOwner]{}}
    drop :: jet_driver_payload_drop_address(codec, row)
    if drop.refusal_key != "" {
        retired.refusal_key = drop.refusal_key
        return retired
    }
    held :: core_shared_runtime_call(codec.host.runtime, "jet_rt_shared_guard_held", 1, guard, 0, 0)
    if held.refusal_key != "" || held.word != 1 {
        retired.refusal_key = if held.refusal_key != "" -> held.refusal_key else -> "CoreSharedPayloadPhysicalPermitNotHeld"
        return retired
    }
    root :: core_shared_runtime_call(codec.host.runtime, "jet_rt_shared_guard_root_ptr", 1, guard, 0, 0)
    if root.refusal_key != "" {
        retired.refusal_key = root.refusal_key
        return retired
    }
    retired.pointer = jet_driver_payload_allocate(codec, &retired, row.payload_size, row.align)
    if retired.pointer == 0 -> return retired
    retired.refusal_key = jet_driver_payload_copy(root.word, retired.pointer, row.payload_size)
    if retired.refusal_key != "" {
        _ := jet_driver_native_payload_release(&retired)
        return retired
    }
    dirty :: core_shared_runtime_call(codec.host.runtime, "jet_rt_shared_guard_mark_dirty", 1, guard, 0, 0)
    if dirty.refusal_key != "" {
        // The old bytes remain owned by the cell; the temporary copy is NOT a
        // clone and therefore must not run its typed drop on this refusal.
        retired.refusal_key = dirty.refusal_key
        _ := jet_driver_native_payload_release(&retired)
        return retired
    }
    retired.refusal_key = jet_driver_payload_copy(stage.pointer, root.word, row.payload_size)
    if retired.refusal_key != "" -> panic("checked canonical payload move failed: {retired.refusal_key}")
    if drop.address != 0 -> &retired.owners.push(JetDriverNativePayloadOwner.Value{slot: retired.pointer, drop_address: drop.address})
    retired.initialized = true
    cleanup :: jet_driver_native_payload_disown(&stage)
    if cleanup != "" -> retired.refusal_key = cleanup
    retired
}

#Test("native binary32 journal codec preserves exact widened IEEE words") {
    loop bits in ([Int]{0, 2147483648, 1, 8388607, 8388608, 1065353216, 2139095040, 4286578688, 2143289345}) {
        assert_eq(jet_driver_payload_float32(jet_driver_native_float32_bits(bits)), Val(bits))
    }
    assert_eq(jet_driver_payload_float32(4607182418800017409), None)
}
#Test("native payload field and key views preserve names and reject ambiguous fields") {
    value :: TComptimeValue.Int{value: 7}
    fields :: [TComptimeField]{TComptimeField{name: "item", value: value}, TComptimeField{name: "item", value: value}}
    assert_eq(jet_driver_payload_field(fields, "item"), None)
    assert_eq(jet_driver_payload_field(fields, "missing"), None)
    key :: TComptimeKey.Struct{type_name: "Key", fields: [TComptimeKeyField]{TComptimeKeyField{name: "item", key: TComptimeKey.Int{value: 7}}}}
    assert_eq(jet_driver_payload_value_key(jet_driver_payload_key_value(key)), Val(key))
}

#Test("Map ordering refuses missing child layouts and mismatched fields without panicking") {
    row := CoreSharedNativeLayout{type_key: "key", nominal_key: "", display_name: "Key", representation: "Inline", kind: 0, stride: 8, payload_size: 8, align: 8, box_size: 0, clone_identity: "", drop_identity: "", child_keys: [String]{}, members: [CoreSharedLayoutMember]{CoreSharedLayoutMember{name: "item", offset: 0, boxed: false, type_key: "missing", storage_type_key: "missing"}}, variants: [CoreSharedLayoutVariant]{}}
    good :: TComptimeKey.Struct{type_name: "Key", fields: [TComptimeKeyField]{TComptimeKeyField{name: "item", key: TComptimeKey.Int{value: 7}}}}
    bad :: TComptimeKey.Struct{type_name: "Key", fields: [TComptimeKeyField]{TComptimeKeyField{name: "wrong", key: TComptimeKey.Int{value: 7}}}}
    layouts :: [CoreSharedNativeLayout]{row}
    assert_eq(jet_driver_payload_key_order(layouts, "key", good, good).refusal_key, "CoreSharedPayloadLayoutMissing: missing")
    assert_eq(jet_driver_payload_key_order(layouts, "key", good, bad).refusal_key, "CoreSharedPayloadShapeMismatch: key")
    ordered := [Int]{}
    entries :: [TComptimeMapEntry]{TComptimeMapEntry{key: good, value: TComptimeValue.Unit}}
    assert_eq(jet_driver_payload_order_keys(layouts, "key", entries, &ordered), "CoreSharedPayloadLayoutMissing: missing")
    row.members = [CoreSharedLayoutMember]{}
    row.representation = "Word"
    row.kind = 12
    enum_key :: TComptimeKey.Enum{type_name: "Key", variant: "missing"}
    assert_eq(jet_driver_payload_key_order([CoreSharedNativeLayout]{row}, "key", enum_key, enum_key).refusal_key, "CoreSharedPayloadShapeMismatch: key")
}

#Test("Map fallible index merge is stable across partial runs and mixed key shapes refuse") {
    row :: CoreSharedNativeLayout{type_key: "integer", nominal_key: "", display_name: "Int", representation: "TaggedInteger", kind: 1, stride: 8, payload_size: 8, align: 8, box_size: 0, clone_identity: "", drop_identity: "", child_keys: [String]{}, members: [CoreSharedLayoutMember]{}, variants: [CoreSharedLayoutVariant]{}}
    entries := [TComptimeMapEntry]{}
    loop value in ([Int]{3, 1, 2, 1, 4}) -> &entries.push(TComptimeMapEntry{key: TComptimeKey.Int{value: value}, value: TComptimeValue.Unit})
    ordered := [Int]{}
    assert_eq(jet_driver_payload_order_keys([CoreSharedNativeLayout]{row}, "integer", entries, &ordered), "")
    assert_eq(ordered, [Int]{1, 3, 2, 0, 4})
    mismatch :: jet_driver_payload_key_order([CoreSharedNativeLayout]{row}, "integer", TComptimeKey.Int{value: 1}, TComptimeKey.Bool{value: true})
    assert_eq(mismatch.refusal_key, "CoreSharedPayloadShapeMismatch: integer")
}
