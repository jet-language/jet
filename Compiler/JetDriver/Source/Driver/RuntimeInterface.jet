// The jet.runtime interface (#6615): the runtime's public functions as Jet
// declarations. The runtime declares each one as a runtime binding, an
// `#Import(c)` member of an inline module of Compiler/JetRuntime/Source that
// names one of its own exports (Guest.jet sema_guest_runtime_binding). The
// runtime pack build reads them from the checked runtime and renders
// RuntimeInterface.jet (jet_driver_runtime_interface_file), which
// Toolchain/RuntimePack.jet compares with the copy in the tree. jet embeds that
// copy (RUNTIME_INTERFACE_ROWS) and loads each module as `jet.runtime.<m>`:
// its members are the same `#Import(c)` declarations, checked against their
// Jet signature and effect row only, whose calls cross the runtime's route
// carriers (BuildRoutes.jet ir_route_of_signature). The runtime export stays
// the one body of each.
use {
    jet_sema.[sema_inline_member_module, sema_inline_member_source_name]
    jet_foundation.[AccessConvention, Diagnostic, Func, RUNTIME_INTERFACE_ROWS, RuntimeInterfaceRow, Span, Type, type_marked_name, type_name]
}

JET_DRIVER_RUNTIME_INTERFACE_ROOT: "jet.runtime"

// The repository path of the generated interface, which the runtime pack
// build checks and jet embeds.
JET_DRIVER_RUNTIME_INTERFACE_PATH: "Compiler/JetFoundation/Source/Registry/RuntimeInterface.jet"

// Whether `module_name` names a module of the jet.runtime interface.
jet_driver_runtime_interface_module: fn(module_name: String) -> Bool Never! {
    module_name.starts_with("{JET_DRIVER_RUNTIME_INTERFACE_ROOT}.")
}

// E1001 for a `jet.runtime.<m>` path that names no interface module.
jet_driver_unknown_runtime_interface_module: fn(module_name: String, span: Span) -> Diagnostic Never! {
    names := [String]{}
    loop row in RUNTIME_INTERFACE_ROWS {
        if !names.contains(row.module_name) -> names.push(row.module_name.copy())
    }
    jet_driver_diagnostic("E1001", span, "there is no runtime module `{module_name}`", "`jet.runtime` holds only the modules of the runtime's public interface", "use one of: {names.join(", ")}")
}

// The interface row of the runtime binding `declaration`, whose runtime export
// is `symbol`: a lifted inline-module member (`time.sleep_ns` binding
// `jet_std_time_sleep_duration_ns`). None for a top-level declaration.
// `declaration` is "" when the Jet signature uses a form the interface
// doesn't render (type parameters, or a parameter convention, default, or
// variadic); the runtime pack build refuses that row.
jet_driver_runtime_interface_row: fn(declaration: Func, symbol: String) -> RuntimeInterfaceRow? Never! {
    module_path: sema_inline_member_module(declaration.name)
    if module_path == "" -> return None
    member: sema_inline_member_source_name(declaration.name)
    Val(RuntimeInterfaceRow{module_name: "{JET_DRIVER_RUNTIME_INTERFACE_ROOT}.{module_path}", member: member.copy(), declaration: jet_driver_runtime_interface_declaration(declaration, member), symbol: symbol})
}

// The member's Jet declaration, as the runtime declares it: its parameters,
// effect row and result. A member without a row is pure, and a unit-fallible
// one without a row writes its `E!` with no arrow.
jet_driver_runtime_interface_declaration: fn(declaration: Func, member: String) -> String Never! {
    if declaration.type_params.len() > 0 -> return ""
    params := [String]{}
    loop param in declaration.params {
        if param.convention != AccessConvention.Read || param.default != None || param.variadic -> return ""
        params.push("{param.name}: {type_name(param.ty)}")
    }
    result: if declaration.return_type == .Val(ty) -> jet_driver_runtime_interface_result(ty) else -> ""
    if declaration.declared_effects == .Val(entries) {
        names: loop entry in entries -> entry.name
        row: "{member}: fn({params.join(", ")}) -[{names.join(", ")}]>"
        return if result == "" -> row else -> "{row} {result}"
    }
    if result == "" -> return "{member}: fn({params.join(", ")})"
    if declaration.return_type == .Val(.Result(ok, _)) && ok == (Type.Named{name: "Unit"}) -> return "{member}: fn({params.join(", ")}) {result}"
    "{member}: fn({params.join(", ")}) -> {result}"
}

// A written result as its declaration spells it. A fallible one keeps its
// error even when that is the default `Err`, which type_name leaves implicit:
// a binding's `T Err!` fails, while its plain `T` never does.
jet_driver_runtime_interface_result: fn(ty: Type) -> String Never! {
    if ty == .Result(ok, err) {
        if ok == (Type.Named{name: "Unit"}) -> return "{type_marked_name(err)}!"
        return "{type_marked_name(ok)} {type_marked_name(err)}!"
    }
    type_name(ty)
}

// A Jet string literal of `value`.
jet_driver_runtime_interface_literal: fn(value: String) -> String Never! {
    escaped := value.replace("\\", "\\\\")
    escaped = escaped.replace("\"", "\\\"")
    escaped = escaped.replace("{{", "{{{{")
    escaped = escaped.replace("}}", "}}}}")
    "\"{escaped}\""
}

// RuntimeInterface.jet for `rows`, the runtime's interface rows in
// declaration order: the file the runtime pack build writes beside the
// runtime object and checks against the tree.
jet_driver_runtime_interface_file: fn(rows: [RuntimeInterfaceRow]) -> String Never! {
    lines := [String]{
        "// Sources: the runtime bindings of the inline modules of Compiler/JetRuntime/Source",
        "// This file is generated by the runtime pack build (Compiler/Toolchain/RuntimePack.jet); do not edit.",
        "// One member of the jet.runtime interface (#6615): `declaration` is its Jet",
        "// signature and effect row, `symbol` the runtime export it binds.",
        "RuntimeInterfaceRow: struct {{",
        "    module_name: String",
        "    member: String",
        "    declaration: String",
        "    symbol: String",
        "}}",
        "",
        "RUNTIME_INTERFACE_ROWS: comptime {{ [RuntimeInterfaceRow]{{",
    }
    loop row in rows {
        module_name: jet_driver_runtime_interface_literal(row.module_name)
        member: jet_driver_runtime_interface_literal(row.member)
        declaration: jet_driver_runtime_interface_literal(row.declaration)
        symbol: jet_driver_runtime_interface_literal(row.symbol)
        lines.push("    RuntimeInterfaceRow{{module_name: {module_name}, member: {member}, declaration: {declaration}, symbol: {symbol}}},")
    }
    lines.push("}} }}")
    lines.push("")
    lines.join("\n")
}

// The source of the interface module `module_name` from the embedded rows:
// one `#Import(c)` declaration per member, in row order. None when no row
// names it.
jet_driver_runtime_interface_source: fn(module_name: String) -> String? Never! {
    lines := [String]{"// `{module_name}`: generated from {JET_DRIVER_RUNTIME_INTERFACE_PATH}."}
    loop row in RUNTIME_INTERFACE_ROWS {
        if row.module_name == module_name -> lines.push("#Import(c) {row.declaration} = \"{row.symbol}\"")
    }
    if lines.len() == 1 -> return None
    lines.push("")
    Val(lines.join("\n"))
}

// The embedded interface modules as Core source rows, which the loader
// schedules when a program names `jet.runtime.<m>` (jet_driver_core_unit).
// Every member is an owned member: no Core call row names it, so each call
// binds to its `#Import(c)` declaration.
jet_driver_runtime_interface_sources: fn() -> [JetDriverCoreSource] Never! {
    names := [String]{}
    loop row in RUNTIME_INTERFACE_ROWS {
        if !names.contains(row.module_name) -> names.push(row.module_name.copy())
    }
    sources := [JetDriverCoreSource]{}
    loop module_name in names {
        text: jet_driver_runtime_interface_source(module_name) ?? next
        members := [String]{}
        loop row in RUNTIME_INTERFACE_ROWS {
            if row.module_name == module_name -> members.push(row.member.copy())
        }
        sources.push(JetDriverCoreSource{module_name: module_name, alias: "__{module_name.replace(".", "_")}", path: "{module_name.replace(".", "/")}.jet", owner: "", owned_members: members, runtime: false, text: jet_driver_core_text(text)})
    }
    sources
}
