// Canonical checked-plan representation shared by CLI and other consumers.
// No cache observation or action execution is invented by these projections.
use {
    jet_foundation.[foundation_json_quote]
    core.build.[BuildGraph, BuildGraphAction, BuildGraphFile]
    jet_build_session.[
        BuildSessionAction, BuildSessionPlan, BuildSessionState, build_key_debug_text,
        build_key_target_kind, build_session_project,
    ]
}

JetDriverBuildExplanation: struct { label: String provenance: [String] }
jet_driver_build_strings: fn(values: [String]) -> String Never! {
    rows: loop value in values -> foundation_json_quote(value)
    "[{rows.join(",")}]"
}
jet_driver_build_ints: fn(values: [Int]) -> String Never! {
    rows: loop value in values -> "{value}"
    "[{rows.join(",")}]"
}
jet_driver_build_id: fn(value: Int?) -> String Never! {
    if value == .Val(id) -> { "{id}" } else -> { "null" }
}
jet_driver_build_debug_ids: fn(values: [Int], kind: String) -> String Never! {
    rows: loop value in values -> "{kind}({value})"
    "[{rows.join(", ")}]"
}
jet_driver_build_file_json: fn(file: BuildGraphFile) -> String Never! {
    "{{\"path\":{foundation_json_quote(file.path)},\"owner\":{jet_driver_build_id(file.owner)},\"consumers\":{jet_driver_build_ints(file.consumers)},\"targets\":{jet_driver_build_ints(file.targets)}}}"
}
// Every step is cached, so its provenance says so in the executor's words.
jet_driver_build_action_provenance: fn(action: BuildSessionAction) -> [String] Never! {
    [String]{"argv={action.argv.join(" ")}", "inputs={action.inputs.len()}", "outputs={action.outputs.len()}", "cache=Cached"}
}
jet_driver_build_explanation: fn(plan: BuildSessionPlan, subject: String) -> JetDriverBuildExplanation Never! {
    permit: plan.storage.guard_read()
    loop target in permit.value.targets {
        // copy: `subject` is the caller's query argument (a read parameter), and the explanation
        // owns its label.
        if target.name == subject -> return {label: subject.copy(), provenance: [String]{"kind={build_key_target_kind(target.kind)}", "sources={target.sources.len()}", "deps={target.deps.len()}", "actions={target.actions.len()}"}}
    }
    loop action in permit.value.actions {
        // copy: `subject` is the caller's query argument (a read parameter), and the explanation
        // owns its label.
        if action.name == subject -> return {label: subject.copy(), provenance: jet_driver_build_action_provenance(action)}
    }
    graph: build_session_project(permit.value)
    owner := "None"
    consumers := "[]"
    targets := "[]"
    loop file in graph.files {
        if file.path != subject -> next
        if file.owner == .Val(id) -> owner = "Some(ActionId({id}))"
        consumers = jet_driver_build_debug_ids(file.consumers, "ActionId")
        targets = jet_driver_build_debug_ids(file.targets, "TargetId")
        break
    }
    facts := [String]{"owner={owner}", "consumers={consumers}", "targets={targets}"}
    loop generated_row in permit.value.generated {
        if generated_row.path == subject {
            facts.push("generated={generated_row.name}")
            facts.push("digest={generated_row.source_digest}")
            break
        }
    }
    // copy: `subject` is the caller's query argument (a read parameter), and the explanation owns
    // its label.
    {label: subject.copy(), provenance: facts.move()}
}
jet_driver_build_plan_json: fn(plan: BuildSessionPlan) -> String Never! {
    permit: plan.storage.guard_read()
    graph: build_session_project(permit.value)
    targets := [String]{}
    loop target in graph.targets {
        targets.push("{{\"id\":{target.id},\"name\":{foundation_json_quote(target.name)},\"kind\":{foundation_json_quote(target.kind)},\"deps\":{jet_driver_build_ints(target.deps)},\"actions\":{jet_driver_build_ints(target.actions)},\"files\":{jet_driver_build_strings(target.files)}}}")
    }
    actions := [String]{}
    loop action in graph.actions {
        real: permit.value.actions[action.id]
        probe_rows: loop probe in real.probes -> foundation_json_quote(permit.value.probes[probe].name)
        hit: if action.cache_hit == .Val(value) -> { if value -> { "hit" } else -> { "miss" } } else -> { "unknown" }
        provenance: jet_driver_build_action_provenance(real)
        actions.push("{{\"id\":{action.id},\"name\":{foundation_json_quote(action.name)},\"inputs\":{jet_driver_build_strings(action.inputs)},\"outputs\":{jet_driver_build_strings(action.outputs)},\"caps\":{jet_driver_build_strings(action.caps)},\"pools\":{jet_driver_build_strings(action.pools)},\"toolchain\":{foundation_json_quote(permit.value.toolchains[real.toolchain].name)},\"probes\":[{probe_rows.join(",")}],\"cache\":\"Cached\",\"cache_status\":{foundation_json_quote(hit)},\"key\":{foundation_json_quote(action.key)},\"compiler_owned\":{action.compiler_owned},\"provenance\":{jet_driver_build_strings(provenance)}}}")
    }
    keys: loop key in graph.action_keys -> "{{\"action\":{foundation_json_quote(key.action)},\"key\":{foundation_json_quote(key.key)}}}"
    hits: loop action in graph.cache_hits -> "{{\"action\":{foundation_json_quote(action.name)},\"key\":{foundation_json_quote(action.key)}}}"
    files: loop file in graph.files -> jet_driver_build_file_json(file)
    tools: loop tool in permit.value.toolchains -> "{{\"name\":{foundation_json_quote(tool.name)},\"target\":{foundation_json_quote(tool.target_triple)}}}"
    probes := [String]{}
    loop probe in permit.value.probes {
        kind: if probe.kind == {
            "find_program" -> { "FindProgram {{ program: {build_key_debug_text(probe.value)} }}" }
            "pkg_config" -> { "PkgConfig {{ package: {build_key_debug_text(probe.value)}, min_version: None }}" }
            "header" -> { "HeaderCheck {{ header: {build_key_debug_text(probe.value)} }}" }
            "compile_check" -> { "CompileCheck {{ name: {build_key_debug_text(probe.value)}, includes: [], code: {build_key_debug_text(probe.code)} }}" }
            else -> { panic("invalid checked probe kind") }
        }
        reproducibility: if probe.reproducibility == "ambient" -> { "Ambient" } else -> { "Reproducible" }
        probes.push("{{\"name\":{foundation_json_quote(probe.name)},\"kind\":{foundation_json_quote(kind)},\"reproducibility\":{foundation_json_quote(reproducibility)}}}")
    }
    generated: loop generated_row in permit.value.generated -> "{{\"name\":{foundation_json_quote(generated_row.name)},\"path\":{foundation_json_quote(generated_row.path)},\"digest\":{foundation_json_quote(generated_row.source_digest)}}}"
    default: if plan.default >= 0 -> { "{plan.default}" } else -> { "null" }
    // Rust BuildGraph.affected_files() is the static file universe here,
    // not receipt_diff's rebuild-impact closure. Reuse the canonical rows.
    "{{\"schema_version\":1,\"default\":{default},\"targets\":[{targets.join(",")}],\"actions\":[{actions.join(",")}],\"action_keys\":[{keys.join(",")}],\"cache_hits\":[{hits.join(",")}],\"files\":[{files.join(",")}],\"affected_files\":[{files.join(",")}],\"toolchains\":[{tools.join(",")}],\"probes\":[{probes.join(",")}],\"generated\":[{generated.join(",")}]}}"
}

// The core.build values `jet build` records, as JSON objects whose fields
// are the values' own, in declaration order: `.jet/build/receipt.json` (the
// BuildGraph it built) and `.jet/build/times.json` (its BuildTimes).
jet_driver_build_graph_json: fn(graph: BuildGraph) -> String Never! {
    targets: loop target in graph.targets -> "{{\"id\":{target.id},\"name\":{foundation_json_quote(target.name)},\"kind\":{foundation_json_quote(target.kind)},\"deps\":{jet_driver_build_ints(target.deps)},\"actions\":{jet_driver_build_ints(target.actions)},\"files\":{jet_driver_build_strings(target.files)},\"plugin\":{jet_driver_build_id(target.plugin)}}}"
    actions: loop action in graph.actions -> jet_driver_build_action_json(action)
    keys: loop key in graph.action_keys -> "{{\"action\":{foundation_json_quote(key.action)},\"key\":{foundation_json_quote(key.key)}}}"
    hits: loop action in graph.cache_hits -> jet_driver_build_action_json(action)
    files: loop file in graph.files -> jet_driver_build_file_json(file)
    affected: loop file in graph.affected_files -> jet_driver_build_file_json(file)
    nodes := [String]{}
    loop node in graph.nodes {
        digests: loop digest in node.input_digests -> "{{\"name\":{foundation_json_quote(digest.name)},\"digest\":{foundation_json_quote(digest.digest)}}}"
        nodes.push("{{\"kind\":{foundation_json_quote(node.kind)},\"key\":{foundation_json_quote(node.key)},\"subject\":{foundation_json_quote(node.subject)},\"inputs\":{jet_driver_build_strings(node.inputs)},\"input_digests\":[{digests.join(",")}]}}")
    }
    "{{\"targets\":[{targets.join(",")}],\"actions\":[{actions.join(",")}],\"action_keys\":[{keys.join(",")}],\"cache_hits\":[{hits.join(",")}],\"files\":[{files.join(",")}],\"affected_files\":[{affected.join(",")}],\"nodes\":[{nodes.join(",")}]}}\n"
}
jet_driver_build_action_json: fn(action: BuildGraphAction) -> String Never! {
    hit: if action.cache_hit == .Val(value) -> "{value}" else -> "null"
    "{{\"id\":{action.id},\"name\":{foundation_json_quote(action.name)},\"kind\":{foundation_json_quote(action.kind)},\"inputs\":{jet_driver_build_strings(action.inputs)},\"outputs\":{jet_driver_build_strings(action.outputs)},\"target\":{jet_driver_build_id(action.target)},\"caps\":{jet_driver_build_strings(action.caps)},\"pools\":{jet_driver_build_strings(action.pools)},\"plugin\":{jet_driver_build_id(action.plugin)},\"compiler_owned\":{action.compiler_owned},\"key\":{foundation_json_quote(action.key)},\"cache_hit\":{hit}}}"
}

// One core.build BuildTime row as the compiler writes it. The compiler is
// built by a seed whose core.build may predate BuildTime, so it writes the
// row's fields from this mirror.
JetDriverBuildTime: struct {
    name: String
    kind: String
    wall_ms: Int
    reused: Bool
}
jet_driver_build_times_json: fn(rows: [JetDriverBuildTime]) -> String Never! {
    written: loop row in rows -> "{{\"name\":{foundation_json_quote(row.name)},\"kind\":{foundation_json_quote(row.kind)},\"wall_ms\":{row.wall_ms},\"reused\":{row.reused}}}"
    "{{\"rows\":[{written.join(",")}]}}\n"
}
