// Source-coupled C/C++ foreign assembly.  The host supplies authorized cache,
// metadata, and provenance bytes; this stage never opens a path or calls the
// native assembler.  It parses the exact Jet cache and source overlays, merges
// one surface per actual declared library, and publishes canonical bundle facts.
use core.files.runtime.kernel_path_components as compiler_driver_os_path
use jet_foundation.[
    AccessConvention,
    AppliedRuleApplication,
    CModule,
    CFfi,
    CImportLink,
    CLib,
    COverlayOverride,
    FfiCloseAdapter,
    FfiLinkClosure,
    CModuleKind,
    Diagnostic,
    ExternFn,
    ForeignLanguage,
    FfiBoundaryFacts,
    FencedStatement,
    Func,
    ImportDecl,
    ImportKind,
    Item,
    MIRSourceFile,
    NamedSpan,
    PolicyDeclaration,
    Program,
    Span,
    Stmt,
    TextEdit,
    Type,
    UserPolicyDecl,
    diagnostic_with_source_path,
    diagnostic_with_source_mapping,
    mir_source_file_id,
    mir_sha256_hex_bytes,
    pkg_binder_descriptor,
    pkg_ffi_close_source_name,
    pkg_ffi_thread_safety_name,
]
use jet_lexer.[
    Token,
    lex_generated,
]
use jet_parser.[
    parse_lexed,
]
use jet_sema.[
    SemaForeignBoundaryInput,
    SemaForeignBoundaryObligationInput,
    SemaForeignCloseAdapterInput,
    SemaForeignHandleInput,
    SemaForeignImportBinding,
    SemaForeignOverlayOverrideInput,
    SemaForeignProviderInput,
    SemaRegistrationImportEdge,
    SemaSourceOrigin,
    SemaSourceSegment,
]

use jet_pkg_model.[CBindingMetadata, ForeignBoundaryContract, ForeignBoundaryIdentity, pkg_bridge_foreign_host_target, pkg_bridge_read_boundary_provenance_text, pkg_cffi_generated_boundary_cache, pkg_cffi_read_boundary_facts_checked, pkg_cffi_read_binding_metadata_text, pkg_cffi_check_cache_descriptor, pkg_cffi_e3204, pkg_cffi_e3205, pkg_cffi_e3207, pkg_cffi_e3208]
struct JetDriverForeignRequest {
    library: String
    language: String
    root_index: Int
    module_index: Int
    scope: String
    source_path: String
    declaration: ImportDecl
    alias: String
    alias_span: Span
    binding_span: Span
    form: String
}

struct JetDriverForeignFile {
    path: String
    native_path: compiler_driver_os_path.OSPath
    source: String
}

struct JetDriverForeignSurface {
    library: String
    language: String
    module_library: String
    generated_language: String?
    root_index: Int
    cache: JetDriverForeignFile?
    metadata: JetDriverForeignFile?
    provenance: JetDriverForeignFile?
    cache_program: Program?
    cache_span: Span
    overlay_functions: [ExternFn]
    overlay_function_paths: [String]
    overlay_function_native_paths: [compiler_driver_os_path.OSPath?]
    overlay_module_spans: [Span]
    overlay_span: Span
    overlay_path: String
    overlay_native_path: compiler_driver_os_path.OSPath?
    parsed_metadata: JetDriverForeignMetadata?
    parsed_provenance: FfiBoundaryFacts?
    valid: Bool
}

struct JetDriverForeignMetadata {
    library: String
    canonical: CBindingMetadata
    handles: [SemaForeignHandleInput]
    direct_links: [String]
    transitive_links: [String]
}

struct JetDriverForeignCanonicalAssembly {
    overlay_functions: [ExternFn]
    adapter_functions: [Func]
    source_segments: [SemaSourceSegment]
    generated_source_files: [MIRSourceFile]
}

struct JetDriverForeignArtifactIndex {
    // #4499: canonical native-path keys, never a lossy String-key substitute.
    digests: [compiler_driver_os_path.OSPath:String]
}

fn jet_driver_foreign_span_zero() -> Span Never! {
    Span{start: 0, end: 0}
}

fn jet_driver_foreign_path(path: String) -> String Never! {
    path.replace("\\", "/")
}

fn jet_driver_foreign_cache_relative(language: String, library: String) -> String Never! {
    ".jet/bindings/{language}/{library}.jet"
}

fn jet_driver_foreign_sidecar_relative(language: String, library: String, extension: String) -> String Never! {
    ".jet/bindings/{language}/{library}.{extension}"
}

fn jet_driver_foreign_valid_library(library: String) -> Bool Never! {
    carriage_return :: String.from_bytes([U8]{13}) ?? ""
    library.len() > 0 && library != "." && library != ".." && !library.contains("/") && !library.contains("\\") && !library.contains("\n") && !library.contains(carriage_return)
}

fn jet_driver_foreign_library_from_c_path(path: String) -> String? {
    if !path.starts_with("c.") -> return None
    remainder := path.slice(2, path.len()) // #4303
    parts :: remainder.split(".").to_list()
    if parts.len() == 0 -> return None
    first :: parts[0]
    if !jet_driver_foreign_valid_library(first) -> return None
    Val(first)
}

fn jet_driver_foreign_library_from_cpp_path(path: String) -> String? {
    if !path.starts_with("cpp.") -> return None
    remainder := path.slice(4, path.len()) // #4303
    parts :: remainder.split(".").to_list()
    if parts.len() == 0 -> return None
    first :: parts[0]
    if !jet_driver_foreign_valid_library(first) -> return None
    Val(first)
}

fn jet_driver_foreign_library_from_header(path: String) -> String? {
    normalized :: jet_driver_foreign_path(path)
    if !normalized.ends_with(".h") -> return None
    parts :: normalized.split("/").to_list()
    file :: parts[parts.len() - 1]
    suffix :: ".h"
    library := file.slice(0, file.len() - suffix.len()) // #4303
    if !jet_driver_foreign_valid_library(library) -> return None
    Val(library)
}

fn jet_driver_foreign_library_from_cpp_header(path: String) -> String? {
    normalized :: jet_driver_foreign_path(path)
    if !normalized.ends_with(".hpp") && !normalized.ends_with(".hxx") -> return None
    parts :: normalized.split("/").to_list()
    file :: parts[parts.len() - 1]
    suffix :: if file.ends_with(".hpp") -> ".hpp" else -> ".hxx"
    library := file.slice(0, file.len() - suffix.len()) // #4303
    if !jet_driver_foreign_valid_library(library) -> return None
    Val(library)
}

fn jet_driver_foreign_import_library(declaration: ImportDecl) -> (library: String?, form: String) Never! {
    if declaration.kind == {
        .Module(name, _) -> (library: jet_driver_foreign_library_from_c_path(name), form: "module")
        .File(path, _) -> (library: jet_driver_foreign_library_from_header(path), form: "header")
        .Unqualified(module_alias, _, items, _, _) -> {
            direct := jet_driver_foreign_library_from_c_path(module_alias)
            if {
                direct != None -> (library: direct, form: "module")
                module_alias == "c" && items.len() > 0 -> (library: jet_driver_foreign_library_from_c_path("c.{items[0].original}"), form: "module")
                else -> (library: None, form: "module")
            }
        }
    }
}

fn jet_driver_foreign_import_libraries(declaration: ImportDecl) -> (libraries: [String], form: String) Never! {
    imported :: jet_driver_foreign_import_library(declaration)
    libraries := [String]{}
    if declaration.kind == .Unqualified(module_alias, _, items, _, _) {
        if module_alias == "c" {
            loop item in items {
                library :: jet_driver_foreign_library_from_c_path("c.{item.original}") ?? next
                &libraries.push(library)
            }
            return (libraries: libraries, form: "module")
        }
    }
    if imported.library == .Val(library) -> &libraries.push(library)
    (libraries: libraries, form: imported.form)
}

fn jet_driver_foreign_import_header(declaration: ImportDecl) -> String Never! {
    if declaration.kind == {
        .File(path, _) -> path
        else -> ""
    }
}


fn jet_driver_foreign_artifact_library(path: String) -> String Never! {
    normalized :: jet_driver_foreign_path(path)
    parts :: normalized.split("/").to_list()
    file :: parts[parts.len() - 1]
    suffix :: if {
        file.ends_with(".metadata") -> ".metadata"
        file.ends_with(".provenance") -> ".provenance"
        file.ends_with(".jet") -> ".jet"
        else -> ""
    }
    if suffix != "" -> return file.slice(0, file.len() - suffix.len())
    if file.starts_with("foreign:") {
        foreign_parts :: file.split(".").to_list()
        if foreign_parts.len() > 1 -> return foreign_parts[foreign_parts.len() - 1]
    }
    ""
}

fn jet_driver_foreign_diagnostic_offset(diagnostic: Diagnostic) -> Int Never! {
    span :: diagnostic.span ?? return 0
    span.start
}

fn jet_driver_foreign_surface_key(root_index: Int, language: String, library: String) -> String Never! {
    "{root_index}:{language}:{library}"
}

fn jet_driver_foreign_add_request(requests: &[JetDriverForeignRequest], language: String, library: String, root_index: Int, module_index: Int, scope: String, source_path: String, declaration: ImportDecl, alias: String, alias_span: Span, binding_span: Span, form: String, diagnostics: &[Diagnostic]) {
    loop existing in requests {
        if existing.module_index == module_index && existing.scope == scope && existing.language == language && existing.library == library && existing.form != "item" && form != "item" && existing.form != form {
            existing_header :: jet_driver_foreign_import_header(existing.declaration)
            header :: if existing_header == "" -> jet_driver_foreign_import_header(declaration) else -> existing_header
            diagnostic :: pkg_cffi_e3204(library, header, declaration.span)
            &diagnostics.push(diagnostic_with_source_path(^diagnostic, source_path, declaration.span.start))
            return
        }
    }
    loop index in 0..<requests.len() {
        request := requests[index]
        if request.module_index == module_index && request.scope == scope && request.language == language && request.library == library && request.alias == alias && request.declaration.span.start == declaration.span.start && request.declaration.span.end == declaration.span.end {
            if {
                request.form == "item" && form != "item" -> {
                    request.form = form
                    request.declaration = declaration
                    request.source_path = source_path
                    request.alias_span = alias_span
                    request.binding_span = binding_span
                    requests[index] = request
                }
                request.form != form && request.form != "item" && form != "item" -> {
                    request_header :: jet_driver_foreign_import_header(request.declaration)
                    header :: if request_header == "" -> jet_driver_foreign_import_header(declaration) else -> request_header
                    diagnostic :: pkg_cffi_e3204(library, header, declaration.span)
                    &diagnostics.push(diagnostic_with_source_path(^diagnostic, source_path, declaration.span.start))
                }
                else -> {}
            }
            return
        }
    }
    &requests.push(JetDriverForeignRequest{library: library, language: language, root_index: root_index, module_index: module_index, scope: scope, source_path: source_path, declaration: declaration, alias: alias, alias_span: alias_span, binding_span: binding_span, form: form})
}

fn jet_driver_foreign_collect_imports(imports: [ImportDecl], root_index: Int, module_index: Int, scope: String, source_path: String, requests: &[JetDriverForeignRequest], diagnostics: &[Diagnostic]) {
    loop declaration in imports {
        handled_members := false
        has_request := false
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if module_alias == "c" || module_alias == "cpp" {
                    handled_members = true
                    language :: if module_alias == "c" -> "c" else -> "cpp"
                    loop (item_index, item) in items {
                        maybe_library :: if language == "c" -> jet_driver_foreign_library_from_c_path("{module_alias}.{item.original}") else -> jet_driver_foreign_library_from_cpp_path("{module_alias}.{item.original}")
                        library :: maybe_library ?? next
                        alias :: item.alias ?? item.original
                        alias_span := declaration.span
                        binding_span :: if item_index < declaration.item_spans.len() -> declaration.item_spans[item_index] else -> declaration.span
                        if {
                            item.alias != None -> {
                                if item_index < declaration.local_spans.len() -> alias_span = declaration.local_spans[item_index]
                            }
                            item_index < declaration.item_spans.len() -> alias_span = declaration.item_spans[item_index]
                            else -> {}
                        }
                        jet_driver_foreign_add_request(&requests, language, library, root_index, module_index, scope, source_path, declaration, alias, alias_span, binding_span, "module", &diagnostics)
                        has_request = true
                    }
                }
            }
            else -> {}
        }
        if !handled_members {
            imported :: jet_driver_foreign_import_libraries(declaration)
            language := "c"
            maybe_library := String?{None}
            if declaration.kind == {
                .Module(name, _) -> {
                    if name.starts_with("cpp.") {
                        language = "cpp"
                        maybe_library = jet_driver_foreign_library_from_cpp_path(name)
                    }
                }
                .File(path, _) -> {
                    if path.ends_with(".hpp") || path.ends_with(".hxx") {
                        language = "cpp"
                        maybe_library = jet_driver_foreign_library_from_cpp_header(path)
                    }
                }
                else -> {}
            }
            if maybe_library == {
                .Val(library) -> {
                    jet_driver_foreign_add_request(&requests, language, library, root_index, module_index, scope, source_path, declaration, declaration.alias, declaration.alias_span, declaration.span, "module", &diagnostics)
                    has_request = true
                }
                else -> {
                    loop library in imported.libraries {
                        jet_driver_foreign_add_request(&requests, "c", library, root_index, module_index, scope, source_path, declaration, declaration.alias, declaration.alias_span, declaration.span, imported.form, &diagnostics)
                        has_request = true
                    }
                }
            }
        }
        if !has_request {
            foreign_form := if declaration.kind == {
                .Module(name, _) -> name == "c" || name.starts_with("c.") || name == "cpp" || name.starts_with("cpp.")
                .File(path, _) -> path.ends_with(".h") || path.ends_with(".hpp") || path.ends_with(".hxx")
                .Unqualified(module_alias, _, _, _, _) -> module_alias == "c" || module_alias == "cpp"
            }
            if foreign_form {
                diagnostic :: jet_driver_diagnostic("E3208", declaration.span, "a foreign import has an invalid library identity", "foreign cache and header paths must identify one native library without an empty or malformed name", "use `c.<library>`, `cpp.<library>`, or a header whose basename names the library")
                &diagnostics.push(diagnostic_with_source_path(^diagnostic, source_path, declaration.span.start))
            }
        }
    }
}

fn jet_driver_foreign_collect_items(items: [Item], root_index: Int, module_index: Int, scope: String, source_path: String, native_path: compiler_driver_os_path.OSPath?, cache_language: String?, requests: &[JetDriverForeignRequest], overlays: &[JetDriverForeignSurface], overlay_index: &[String:Int], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == {
            .CModule(c_module) -> {
                if scope != "" -> next
                if !jet_driver_foreign_valid_library(c_module.lib) {
                    diagnostic :: jet_driver_diagnostic("E3208", c_module.path_span, "a C module has an invalid library identity", "foreign cache and overlay paths must identify one native library without path traversal", "use `c.<library>` with one safe library name")
                    &diagnostics.push(diagnostic_with_source_path(^diagnostic, source_path, c_module.path_span.start))
                    next
                }
                if c_module.kind == CModuleKind.Bindgen && cache_language == None {
                    diagnostic :: pkg_cffi_e3207(c_module.lib, c_module.path_span)
                    &diagnostics.push(diagnostic_with_source_path(^diagnostic, source_path, c_module.path_span.start))
                    next
                }
                key :: jet_driver_foreign_surface_key(root_index, "c", c_module.lib)
                surface_index := overlay_index.get(key) ?? -1
                if surface_index < 0 {
                    &overlays.push(JetDriverForeignSurface{library: c_module.lib, language: "c", module_library: c_module.lib, generated_language: None, root_index: root_index, cache: None, metadata: None, provenance: None, cache_program: None, cache_span: c_module.path_span, overlay_functions: [ExternFn]{}, overlay_function_paths: [String]{}, overlay_function_native_paths: [compiler_driver_os_path.OSPath?]{}, overlay_module_spans: [Span]{}, overlay_span: c_module.path_span, overlay_path: source_path, overlay_native_path: native_path, parsed_metadata: None, parsed_provenance: None, valid: true})
                    surface_index = overlays.len() - 1
                    overlay_index[key] = surface_index
                }
                if cache_language == .Val(language) {
                    if overlays[surface_index].generated_language == .Val(existing) && existing != language {
                        jet_driver_foreign_cache_error(source_path, "one C library was loaded from multiple generated foreign families", &diagnostics)
                        next
                    }
                    overlays[surface_index].generated_language = Val(language)
                }
                loop original in c_module.functions {
                    function := original
                    if c_module.kind == CModuleKind.Bindgen -> function.generated = true
                    &overlays[surface_index].overlay_functions.push(function)
                    &overlays[surface_index].overlay_function_paths.push(source_path)
                    &overlays[surface_index].overlay_function_native_paths.push(native_path)
                    &overlays[surface_index].overlay_module_spans.push(c_module.span)
                }
                overlays[surface_index].overlay_span = c_module.path_span
                if overlays[surface_index].overlay_path == "" -> overlays[surface_index].overlay_path = source_path
                if cache_language != None -> next
                declaration :: ImportDecl{kind: ImportKind.Module{name: "c.{c_module.lib}", span: c_module.path_span}, alias: c_module.lib, alias_span: c_module.path_span, span: c_module.span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
                jet_driver_foreign_add_request(&requests, "c", c_module.lib, root_index, module_index, scope, source_path, declaration, c_module.lib, c_module.path_span, c_module.path_span, "item", &diagnostics)
            }
            .CodeModule(definition) -> {
                nested_scope :: definition.name
                jet_driver_foreign_collect_imports(definition.imports, root_index, module_index, nested_scope, source_path, &requests, &diagnostics)
                body :: definition.body ?? [Item]{}
                jet_driver_foreign_collect_items(body, root_index, module_index, nested_scope, source_path, native_path, cache_language, &requests, &overlays, &overlay_index, &diagnostics)
            }
            .GenericModule(definition) -> {
                nested_scope :: definition.name
                jet_driver_foreign_collect_imports(definition.imports, root_index, module_index, nested_scope, source_path, &requests, &diagnostics)
                jet_driver_foreign_collect_items(definition.body, root_index, module_index, nested_scope, source_path, native_path, cache_language, &requests, &overlays, &overlay_index, &diagnostics)
            }
            else -> {}
        }
    }
}

fn jet_driver_foreign_collect_requests(load: &JetDriverLoadResult, first_module: Int, cache_languages: [compiler_driver_os_path.OSPath:String], requests: &[JetDriverForeignRequest], overlays: &[JetDriverForeignSurface], overlay_index: &[String:Int], diagnostics: &[Diagnostic]) {
    loop module_index in first_module..<load.modules.len() {
        loaded_module :: load.modules[module_index]
        if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() -> next
        unit :: load.source_units[loaded_module.source_unit_index]
        root_index :: unit.root_index
        scope :: ""
        program :: jet_driver_module_program(load, loaded_module)
        jet_driver_foreign_collect_imports(program.imports, root_index, module_index, scope, unit.path, &requests, &diagnostics)
        cache_language :: if unit.physical_path == .Val(path) -> cache_languages.get(path) else -> None
        jet_driver_foreign_collect_items(program.items, root_index, module_index, scope, unit.path, unit.physical_path, cache_language, &requests, &overlays, &overlay_index, &diagnostics)
    }
}

fn jet_driver_foreign_find_file(files: [JetDriverAuthorizedSourceFile], relative_path: String) -> JetDriverAuthorizedSourceFile? {
    loop file in files {
        if compiler_driver_os_path.equals(file.relative_path, compiler_driver_os_path.from_text(relative_path, file.relative_path.platform)) -> return Val(file)
    }
    None
}

// Cache display labels are derived output; native originals remain attached.
fn jet_driver_foreign_find_cache(snapshot: JetDriverAuthorizedSourceView, root_index: Int, language: String, library: String) -> (cache: JetDriverForeignFile?, metadata: JetDriverForeignFile?, provenance: JetDriverForeignFile?) Never! {
    if root_index < 0 || root_index >= snapshot.roots.len() -> return (cache: None, metadata: None, provenance: None)
    root :: snapshot.roots[root_index]
    entry_root :: jet_driver_source_view_entry_root_path(snapshot)
    cache_files :: root.foreign_cache_files
    cache :: jet_driver_foreign_display_file(entry_root, jet_driver_foreign_find_file(cache_files, jet_driver_foreign_cache_relative(language, library)))
    metadata :: jet_driver_foreign_display_file(entry_root, jet_driver_foreign_find_file(cache_files, jet_driver_foreign_sidecar_relative(language, library, "metadata")))
    provenance :: jet_driver_foreign_display_file(entry_root, jet_driver_foreign_find_file(cache_files, jet_driver_foreign_sidecar_relative(language, library, "provenance")))
    (cache: cache, metadata: metadata, provenance: provenance)
}

fn jet_driver_foreign_display_file(entry_root: compiler_driver_os_path.OSPath, file: JetDriverAuthorizedSourceFile?) -> JetDriverForeignFile? Never! {
    found :: file ?? return None
    path :: jet_driver_display_path(entry_root, found.path)
    Val(JetDriverForeignFile{path: path, native_path: found.path, source: found.source})
}

fn jet_driver_foreign_cache_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic :: pkg_cffi_e3208(path, jet_driver_foreign_artifact_library(path), reason)
    &diagnostics.push(diagnostic_with_source_path(^diagnostic, path, 0))
}

fn jet_driver_foreign_surface(snapshot: JetDriverAuthorizedSourceView, artifacts: JetDriverForeignArtifactIndex, request: JetDriverForeignRequest, diagnostics: &[Diagnostic]) -> JetDriverForeignSurface {
    found :: jet_driver_foreign_find_cache(snapshot, request.root_index, request.language, request.library)
    cache_program := Program?{None}
    cache_span := jet_driver_foreign_span_zero()
    module_library := request.library
    valid := true
    metadata_file := JetDriverForeignFile?{None}
    provenance_file := JetDriverForeignFile?{None}
    if found.cache == .Val(cache) {
        cache_program = jet_driver_foreign_parse_cache(cache, request.library, &diagnostics)
        metadata_file = found.metadata
        provenance_file = found.provenance
        if cache_program == {
            .Val(program) -> {
                located :: jet_driver_foreign_find_generated_module(program, request.language, request.library)
                // load_cache_source accepts a cache without any CModule.
                // assemble_loaded then emits the original empty surface row.
                cache_span = located.span
                if located.module_library != "" -> module_library = located.module_library
            }
            else -> valid = false
        }
    }
    parsed_metadata := JetDriverForeignMetadata?{None}
    if metadata_file == .Val(metadata) && request.language == "c" {
        parsed_metadata = jet_driver_foreign_parse_metadata(metadata, request.library, &diagnostics)
        if parsed_metadata == None -> valid = false
    }
    overlay_functions := [ExternFn]{ }
    overlay_function_paths := [String]{}
    overlay_function_native_paths := [compiler_driver_os_path.OSPath?]{}
    overlay_span := jet_driver_foreign_span_zero()
    overlay_path := ""
    overlay_native_path := compiler_driver_os_path.OSPath?{None}
    overlay_module_spans := [Span]{}
    JetDriverForeignSurface{library: request.library, language: request.language, module_library: module_library, generated_language: None, root_index: request.root_index, cache: found.cache, metadata: metadata_file, provenance: provenance_file, cache_program: cache_program, cache_span: cache_span, overlay_functions: overlay_functions, overlay_function_paths: overlay_function_paths, overlay_function_native_paths: overlay_function_native_paths, overlay_module_spans: overlay_module_spans, overlay_span: overlay_span, overlay_path: overlay_path, overlay_native_path: overlay_native_path, parsed_metadata: parsed_metadata, parsed_provenance: None, valid: valid}
}

// CFFI1422-1550 groups real top-level declarations, in first-seen module order.
// Requested cache identity is not the declared library or its provenance key.
fn jet_driver_foreign_declared_surface(snapshot: JetDriverAuthorizedSourceView, artifacts: JetDriverForeignArtifactIndex, declaration: JetDriverForeignSurface, metadata: JetDriverForeignMetadata?, diagnostics: &[Diagnostic]) -> JetDriverForeignSurface {
    surface := declaration
    surface.parsed_metadata = metadata
    surface.language = surface.generated_language ?? "c"
    language :: ForeignLanguage.from_root(surface.language) ?? panic("the captured C/C++ family is registered")
    identity :: pkg_cffi_generated_boundary_cache("", language, surface.module_library) ?? {
        jet_driver_foreign_cache_error("c.{surface.module_library}", err.message, &diagnostics)
        return surface
    }
    surface.library = identity.lib
    found :: jet_driver_foreign_find_cache(snapshot, surface.root_index, surface.language, surface.library)
    surface.cache = found.cache
    surface.metadata = found.metadata
    surface.provenance = found.provenance
    if found.provenance == .Val(provenance) {
        surface.parsed_provenance = jet_driver_foreign_parse_provenance(artifacts, provenance, surface.language, surface.library, surface.module_library, &diagnostics)
    } else if surface.generated_language != None && surface.language != "c" {
        path :: ".jet/bindings/{surface.language}/{surface.library}.provenance"
        jet_driver_foreign_cache_error(path, "generated foreign binding has no canonical boundary provenance", &diagnostics)
    } else if pkg_binder_descriptor(ForeignLanguage.C) == .Val(descriptor) {
        unknown :: ForeignBoundaryIdentity.new("not-recorded", "none", "not-recorded", "not-recorded", "not-recorded", pkg_bridge_foreign_host_target())
        surface.parsed_provenance = Val(ForeignBoundaryContract.new(descriptor, surface.module_library, unknown).carrier_facts())
    }
    surface
}


fn jet_driver_foreign_metadata_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic :: pkg_cffi_e3208(path, jet_driver_foreign_artifact_library(path), reason)
    &diagnostics.push(diagnostic_with_source_path(^diagnostic, path, 0))
}

fn jet_driver_foreign_parse_metadata(file: JetDriverForeignFile, library: String, diagnostics: &[Diagnostic]) -> JetDriverForeignMetadata? {
    metadata :: pkg_cffi_read_binding_metadata_text(file.path, file.source, library) ?? {
        jet_driver_foreign_metadata_error(file.path, err.message, &diagnostics)
        return None
    }
    Val(jet_driver_foreign_metadata(metadata, library))
}
fn jet_driver_foreign_metadata(metadata: CBindingMetadata, library: String) -> JetDriverForeignMetadata Never! {
    handles := [SemaForeignHandleInput]{}
    loop fact in metadata.handle_facts {
        &handles.push(SemaForeignHandleInput{library: fact.lib, typedef_name: fact.typedef_name, jet_name: fact.jet_name, close: fact.close, close_function_key: None, close_source: pkg_ffi_close_source_name(fact.close_source), thread_safety: pkg_ffi_thread_safety_name(fact.thread_safety)})
    }
    JetDriverForeignMetadata{library: library, canonical: metadata, handles: handles, direct_links: metadata.link_closure.direct, transitive_links: metadata.link_closure.transitive}
}


fn jet_driver_foreign_unique_strings(values: [String]) -> [String] Never! {
    result := [String]{}
    seen := [String:Bool]{}
    loop value in values {
        if seen.get(value) != None -> next
        seen[value] = true
        &result.push(value)
    }
    result.sort()
    result
}

fn jet_driver_foreign_provenance_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic :: pkg_cffi_e3208(path, jet_driver_foreign_artifact_library(path), reason)
    &diagnostics.push(diagnostic_with_source_path(^diagnostic, path, 0))
}


fn jet_driver_foreign_artifact_index(snapshot: JetDriverAuthorizedSourceView) -> JetDriverForeignArtifactIndex Never! {
    digests := [compiler_driver_os_path.OSPath:String]{}
    loop root in snapshot.roots {
        loop file in root.files {
            bytes :: file.bytes ?? next
            digests[file.path] = mir_sha256_hex_bytes(bytes)
        }
        loop file in root.foreign_cache_files {
            bytes :: file.bytes ?? next
            digests[file.path] = mir_sha256_hex_bytes(bytes)
        }
    }
    JetDriverForeignArtifactIndex{digests: digests}
}


fn jet_driver_foreign_parse_provenance(artifacts: JetDriverForeignArtifactIndex, file: JetDriverForeignFile, language: String, library: String, loaded_lib: String, diagnostics: &[Diagnostic]) -> FfiBoundaryFacts? {
    decoded :: pkg_bridge_read_boundary_provenance_text(file.path, file.source) ?? {
        jet_driver_foreign_provenance_error(file.path, err, &diagnostics)
        return None
    }
    language_kind :: ForeignLanguage.from_root(language) ?? {
        jet_driver_foreign_provenance_error(file.path, "unknown foreign boundary language `{language}`", &diagnostics)
        return None
    }
    facts :: pkg_cffi_read_boundary_facts_checked(file.native_path, decoded, artifacts.digests, [compiler_driver_os_path.OSPath:String]{}, language_kind, library, loaded_lib) ?? {
        jet_driver_foreign_provenance_error(file.path, "foreign boundary provenance is invalid: {err}", &diagnostics)
        return None
    }
    Val(facts)
}

fn jet_driver_foreign_boundary(value: FfiBoundaryFacts) -> SemaForeignBoundaryInput Never! {
    obligations := [SemaForeignBoundaryObligationInput]{}
    loop obligation in value.obligations {
        &obligations.push(SemaForeignBoundaryObligationInput{name: obligation.name, basis: obligation.basis.as_str(), checker: obligation.checker, assumptions: obligation.assumptions, coverage_digest: obligation.coverage_digest})
    }
    SemaForeignBoundaryInput{schema: value.schema, digest: value.digest, language: value.language, library: value.library, effect_root: value.effect_root, effects: value.effects, source_authority: value.source_authority, artifact_coverage_digest: value.artifact_coverage_digest, loaded_artifact: value.loaded_artifact, transitive_dependencies: value.transitive_dependencies, reachable_callbacks: value.reachable_callbacks, compiler_flags: value.compiler_flags, target: value.target, generator: value.generator, obligations: obligations}
}

fn jet_driver_foreign_same_abi(left: NamedSpan?, right: NamedSpan?) -> Bool Never! {
    left_value :: left ?? return right == None
    right_value :: right ?? return false
    left_value.name == right_value.name
}

fn jet_driver_foreign_same_signature(left: ExternFn, right: ExternFn) -> Bool Never! {
    if !jet_driver_foreign_same_abi(left.abi, right.abi) || left.return_type != right.return_type || left.params.len() != right.params.len() -> return false
    loop index in 0..<left.params.len() {
        if left.params[index].convention != right.params[index].convention || left.params[index].ty != right.params[index].ty || left.params[index].variadic != right.params[index].variadic -> return false
    }
    true
}

fn jet_driver_foreign_parse_cache(file: JetDriverForeignFile, library: String, diagnostics: &[Diagnostic]) -> Program? {
    if pkg_cffi_check_cache_descriptor(file.source, file.path, library) == .Val(diagnostic) {
        &diagnostics.push(diagnostic_with_source_path(^diagnostic, file.path, 0))
        return None
    }
    lexed :: lex_generated(file.source.bytes())
    loop diagnostic in lexed.diagnostics -> &diagnostics.push(diagnostic_with_source_path(~diagnostic, file.path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    parsed :: parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> &diagnostics.push(diagnostic_with_source_path(~diagnostic, file.path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    Val(parsed.program)
}

fn jet_driver_foreign_find_generated_module(program: Program, language: String, library: String) -> (functions: [ExternFn], span: Span, module_library: String) Never! {
    functions := [ExternFn]{}
    span := jet_driver_foreign_span_zero()
    module_library := ""
    loop item in program.items {
        if item == {
            .CModule(value) -> {
                if {
                    language == "c" -> {
                        if value.kind != CModuleKind.Bindgen || value.lib != library -> next
                    }
                    else -> {
                        if value.kind != CModuleKind.Extern -> next
                    }
                }
                module_library = value.lib
                span = value.path_span
                loop function in value.functions -> &functions.push(function)
            }
            else -> {}
        }
    }
    (functions: functions, span: span, module_library: module_library)
}

fn jet_driver_foreign_make_adapter_function(handle: String, raw_function: String, origin_path: String, diagnostics: &[Diagnostic]) -> Func? {
    adapter_name :: "__jet_ffi_close_{handle}"
    source :: "fn {adapter_name}(handle: ^{handle}) {{\n    {raw_function}(^handle)\n}}\n"
    lexed :: lex_generated(source.bytes())
    loop diagnostic in lexed.diagnostics -> &diagnostics.push(diagnostic_with_source_path(~diagnostic, origin_path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    parsed :: parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> &diagnostics.push(diagnostic_with_source_path(~diagnostic, origin_path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    loop item in parsed.program.items {
        if item == {
            .Func(function) -> {
                adapter := function
                adapter.is_pub = false
                adapter.is_unsafe = true
                adapter.unsafe_reason = Val("compiler-generated foreign close adapter")
                adapter.unsafe_span = Val(jet_driver_foreign_span_zero())
                adapter.compiler_generated = true
                return Val(adapter)
            }
            else -> {}
        }
    }
    None
}

fn jet_driver_foreign_prepare_functions(functions: [ExternFn], handles: [SemaForeignHandleInput], surface: JetDriverForeignSurface, diagnostics: &[Diagnostic]) -> (functions: [ExternFn], adapters: [SemaForeignCloseAdapterInput], adapter_functions: [Func]) Never! {
    prepared := functions
    adapters := [SemaForeignCloseAdapterInput]{}
    adapter_functions := [Func]{}
    raw_functions := [String:Int]{}
    constructors := [String:[Int]]{}
    loop (index, function) in prepared {
        if function.return_type != None && function.params.len() == 1 && function.params[0].convention == AccessConvention.Move {
            if function.params[0].ty == .Named(handle) {
                raw_functions["{handle.len()}:{handle}:{function.name}"] = index
            }
        }
        if function.close == .Val(close) && function.return_type == .Val(Type.Named(handle)) {
            key :: "{handle.len()}:{handle}:{close.name}"
            members := constructors.get(key) ?? [Int]{}
            &members.push(index)
            constructors[key] = members
        }
    }
    generated := [String:Bool]{}
    loop handle in handles {
        if handle.library != surface.module_library || handle.close == "" -> next
        key :: "{handle.jet_name.len()}:{handle.jet_name}:{handle.close}"
        members :: constructors.get(key) ?? next
        if raw_functions.get(key) == None -> next
        adapter_name :: "__jet_ffi_close_{handle.jet_name}"
        if generated.get(adapter_name) != None -> next
        adapter_path :: jet_driver_foreign_adapter_path(surface, adapters.len())
        adapter :: jet_driver_foreign_make_adapter_function(handle.jet_name, handle.close, adapter_path, &diagnostics) ?? next
        // Main-approved CFFI1620 latent-defect correction: one adapter identity
        // per handle, every matching constructor points to the same definition.
        loop index in members {
            constructor := prepared[index]
            original :: constructor.close ?? next
            constructor.close = Val(NamedSpan{name: adapter_name, span: original.span})
            prepared[index] = constructor
        }
        generated[adapter_name] = true
        &adapters.push(SemaForeignCloseAdapterInput{library: handle.library, handle_type: handle.jet_name, raw_function: handle.close, adapter_function: adapter_name})
        &adapter_functions.push(adapter)
    }
    (functions: prepared, adapters: adapters, adapter_functions: adapter_functions)
}


fn jet_driver_foreign_import_edge_declaration(request: JetDriverForeignRequest) -> ImportDecl Never! {
    request.declaration
}

fn jet_driver_foreign_add_import_edge(load: &JetDriverLoadResult, request: JetDriverForeignRequest, target: JetDriverModuleFacts) Never! {
    declaration :: jet_driver_foreign_import_edge_declaration(request)
    scope := String?{None}
    if request.scope != "" -> scope = Val(request.scope)
    binding_value :: SemaForeignImportBinding{scope: scope, alias: request.alias}
    binding :: Val(binding_value)
    loop edge in load.imports {
        same_binding :: if edge.foreign_binding == {
            .Val(existing) -> existing.scope == binding_value.scope && existing.alias == binding_value.alias
            else -> false
        }
        if edge.source_module_identity == load.modules[request.module_index].module_identity && edge.target_module_identity == target.module_identity && edge.declaration.span.start == declaration.span.start && edge.declaration.span.end == declaration.span.end && same_binding -> return
    }
    &load.imports.push(SemaRegistrationImportEdge{source_module_identity: load.modules[request.module_index].module_identity, target_module_identity: target.module_identity, target_package_identity: target.package_identity, foreign_binding: binding, declaration: declaration})
}

fn jet_driver_foreign_empty_program() -> Program Never! {
    Program{imports: [ImportDecl]{}, items: [Item]{}, script_body: [Stmt]{}, block_spans: [Span]{}, fenced_statements: [FencedStatement]{}, web_target_ceiling: None, pub_file: false, no_prelude: false, default_target: None, html_path: None, policy_declarations: [PolicyDeclaration]{}, user_policy_declarations: [UserPolicyDecl]{}, applied_rules: [AppliedRuleApplication]{}, rule_facts: [AppliedRuleApplication]{}}
}


fn jet_driver_foreign_generated_path(surface: JetDriverForeignSurface) -> String Never! {
    if surface.cache == {
        .Val(cache) -> cache.path
        else -> "foreign:{surface.language}.{surface.library}"
    }
}

fn jet_driver_foreign_generated_source(surface: JetDriverForeignSurface) -> String Never! {
    if surface.cache == {
        .Val(cache) -> cache.source
        else -> ""
    }
}

fn jet_driver_foreign_aggregate_path(surface: JetDriverForeignSurface) -> String Never! {
    "foreign:{surface.language}.{surface.library}#root{surface.root_index}#aggregate"
}

fn jet_driver_foreign_adapter_path(surface: JetDriverForeignSurface, index: Int) -> String Never! {
    "foreign:{surface.language}.{surface.library}#root{surface.root_index}#close{index}"
}

fn jet_driver_foreign_adapter_source(adapter: SemaForeignCloseAdapterInput) -> String Never! {
    "fn __jet_ffi_close_{adapter.handle_type}(handle: ^{adapter.handle_type}) {{\n    {adapter.raw_function}(^handle)\n}}\n"
}


fn jet_driver_foreign_fragment_line_starts(source: String) -> [Int] Never! {
    bytes :: source.bytes()
    starts := [Int]{0}
    loop (index, byte) in bytes { if byte == U8{10} -> &starts.push(index + 1) }
    starts
}

fn jet_driver_foreign_collect_canonical_overlay_items(items: [Item], overlay_bases: [Int], overlay_ends: [Int], library: String, functions: &[ExternFn]) Never! {
    loop item in items {
        if item == {
            .CModule(value) -> {
                if value.lib != library -> next
                loop range_index in 0..<overlay_bases.len() {
                    if value.path_span.start >= overlay_bases[range_index] && value.path_span.start < overlay_ends[range_index] {
                        loop function in value.functions -> &functions.push(function)
                        break
                    }
                }
            }
            .CodeModule(definition) -> {
                body :: definition.body ?? [Item]{}
                jet_driver_foreign_collect_canonical_overlay_items(body, overlay_bases, overlay_ends, library, &functions)
            }
            .GenericModule(definition) -> jet_driver_foreign_collect_canonical_overlay_items(definition.body, overlay_bases, overlay_ends, library, &functions)
            else -> {}
        }
    }
}

fn jet_driver_foreign_shift_diagnostic(diagnostic: Diagnostic, offset: Int) -> Diagnostic Never! {
    shifted := diagnostic
    shifted.span = if shifted.span == {
        .Val(span) -> Val(Span{start: span.start + offset, end: span.end + offset})
        .None -> None
    }
    shifted.edit = if shifted.edit == {
        .Val(edit) -> Val(TextEdit{span: Span{start: edit.span.start + offset, end: edit.span.end + offset}, new_text: edit.new_text})
        .None -> None
    }
    shifted
}

fn jet_driver_foreign_shift_token(token: &Token, offset: Int) Never! {
    token.span = Span{start: token.span.start + offset, end: token.span.end + offset}
    loop part_index in 0..<token.payload.string_parts.len() {
        part := token.payload.string_parts[part_index]
        part.span = Span{start: part.span.start + offset, end: part.span.end + offset}
        loop nested_index in 0..<part.tokens.len() -> jet_driver_foreign_shift_token(&part.tokens[nested_index], offset)
        token.payload.string_parts[part_index] = part
    }
}

fn jet_driver_foreign_parse_shifted(path: String, source: String, offset: Int, source_start: Int, diagnostics: &[Diagnostic]) -> Program? {
    lexed := lex_generated(source.bytes())
    loop diagnostic in lexed.diagnostics {
        shifted :: jet_driver_foreign_shift_diagnostic(diagnostic, offset)
        &diagnostics.push(diagnostic_with_source_mapping(^shifted, path, offset, source_start))
    }
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    loop token_index in 0..<lexed.tokens.len() -> jet_driver_foreign_shift_token(&lexed.tokens[token_index], offset)
    parsed :: parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> &diagnostics.push(diagnostic_with_source_mapping(~diagnostic, path, offset, source_start))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    Val(parsed.program)
}

fn jet_driver_foreign_canonical_assembly(load: JetDriverLoadResult, surface: JetDriverForeignSurface, cache_path: String, cache_source: String, adapters: [SemaForeignCloseAdapterInput], overlay_bytes: &[compiler_driver_os_path.OSPath:[U8]], diagnostics: &[Diagnostic]) -> JetDriverForeignCanonicalAssembly? {
    // One byte buffer, once per actual declaration fragment: no repeated
    // append-copy of the growing source and no per-library whole-file parse.
    canonical := cache_source.bytes()
    source_segments := [SemaSourceSegment]{}
    if canonical.len() > 0 {
        cache_native :: (surface.cache ?? return None).native_path
        &source_segments.push(SemaSourceSegment{generated: Span{start: 0, end: canonical.len()}, source_file: cache_path, physical_path: Val(cache_native), source_start: 0, origin: SemaSourceOrigin.Snapshot, line_starts: jet_driver_foreign_fragment_line_starts(cache_source)})
    }
    canonical_overlays := [ExternFn]{}
    seen := [compiler_driver_os_path.OSPath:[String:Bool]]{}
    loop overlay_index in 0..<surface.overlay_functions.len() {
        path :: surface.overlay_function_paths[overlay_index]
        native_path :: surface.overlay_function_native_paths[overlay_index] ?? {
            jet_driver_foreign_cache_error(path, "an overlay declaration has no retained native source path", &diagnostics)
            return None
        }
        if surface.cache == .Val(cache) && compiler_driver_os_path.equals(cache.native_path, native_path) {
            // Already parsed in its retained cache coordinate space.
            &canonical_overlays.push(surface.overlay_functions[overlay_index])
            next
        }
        extent :: surface.overlay_module_spans[overlay_index]
        fragment_key :: "{extent.start}:{extent.end}"
        spans := seen.get(native_path) ?? [String:Bool]{}
        if spans.get(fragment_key) != None -> next
        spans[fragment_key] = true
        seen[native_path] = spans
        source_index :: load.source_file_index.get(native_path) ?? {
            jet_driver_foreign_cache_error(path, "an overlay source is absent from the loaded authorized source files", &diagnostics)
            return None
        }
        if overlay_bytes.get(native_path) == None -> overlay_bytes[native_path] = load.source_files[source_index].source.bytes()
        source_bytes :: overlay_bytes.get(native_path) ?? return None
        if extent.start < 0 || extent.end < extent.start || extent.end > source_bytes.len() {
            jet_driver_foreign_cache_error(path, "an overlay declaration is outside its authorized source bytes", &diagnostics)
            return None
        }
        fragment := String.from_bytes(source_bytes[extent.start..<extent.end]) ?? return None
        if canonical.len() > 0 && canonical[canonical.len() - 1] != U8{10} -> &canonical.push(U8{10})
        base :: canonical.len()
        loop byte in fragment.bytes() -> &canonical.push(byte)
        end :: canonical.len()
        parsed :: jet_driver_foreign_parse_shifted(path, fragment, base, extent.start, &diagnostics) ?? return None
        jet_driver_foreign_collect_canonical_overlay_items(parsed.items, [Int]{base}, [Int]{end}, surface.module_library, &canonical_overlays)
        &source_segments.push(SemaSourceSegment{generated: Span{start: base, end: end}, source_file: path, physical_path: Val(native_path), source_start: extent.start, origin: SemaSourceOrigin.Snapshot, line_starts: jet_driver_foreign_fragment_line_starts(fragment)})
    }
    canonical_adapters := [Func]{}
    generated_source_files := [MIRSourceFile]{}
    loop (index, adapter) in adapters {
        path :: jet_driver_foreign_adapter_path(surface, index)
        source :: jet_driver_foreign_adapter_source(adapter)
        if canonical.len() > 0 && canonical[canonical.len() - 1] != U8{10} -> &canonical.push(U8{10})
        base :: canonical.len()
        loop byte in source.bytes() -> &canonical.push(byte)
        parsed :: jet_driver_foreign_parse_shifted(path, source, base, 0, &diagnostics) ?? return None
        loop item in parsed.items {
            if item == .Func(function) -> &canonical_adapters.push(function)
        }
        &source_segments.push(SemaSourceSegment{generated: Span{start: base, end: canonical.len()}, source_file: path, physical_path: None, source_start: 0, origin: SemaSourceOrigin.CompilerGenerated, line_starts: jet_driver_foreign_fragment_line_starts(source)})
        &generated_source_files.push(MIRSourceFile{id: mir_source_file_id(path), path: path, source: source})
    }
    if canonical_overlays.len() != surface.overlay_functions.len() || canonical_adapters.len() != adapters.len() {
        jet_driver_foreign_cache_error(cache_path, "the canonical foreign aggregate did not retain every overlay and close adapter declaration", &diagnostics)
        return None
    }
    path :: jet_driver_foreign_aggregate_path(surface)
    source :: String.from_bytes(canonical) ?? return None
    &generated_source_files.push(MIRSourceFile{id: mir_source_file_id(path), path: path, source: source})
    Val(JetDriverForeignCanonicalAssembly{overlay_functions: canonical_overlays, adapter_functions: canonical_adapters, source_segments: source_segments, generated_source_files: generated_source_files})
}

// CFFI.rs:3297-3350 load_cache_source: retain the parsed generated cache as
// an ordinary physical LoadedModule before the merge drains its CModule.
fn jet_driver_foreign_retain_cache(snapshot: JetDriverAuthorizedSourceView, load: &JetDriverLoadResult, surface: JetDriverForeignSurface, package: String) -> Int? {
    cache :: surface.cache ?? return None
    program :: surface.cache_program ?? return None
    root :: snapshot.roots[surface.root_index]
    cache_index :: loop (index, file) in root.foreign_cache_files {
        if compiler_driver_os_path.equals(file.path, cache.native_path) -> break index
    } ?? return None
    file :: root.foreign_cache_files[cache_index]
    unit_index :: load.source_units.len()
    &load.source_units.push(JetDriverSourceUnit{
        root_index: surface.root_index, file_index: -1, foreign_cache_index: Val(cache_index),
        root_identity: root.identity, package_identity: package,
        module_name: "__c_cache_{surface.library}", alias: "__c_cache_{surface.library}",
        bundle_module: true, path: cache.path, physical_path: Val(cache.native_path),
        relative_path: compiler_driver_os_path.display(file.relative_path), relative_os_path: Val(file.relative_path),
        source_segments: jet_driver_source_segments(cache.path, cache.native_path, cache.source),
        source_origin: SemaSourceOrigin.Snapshot, provenance_source_file: None,
    })
    index :: load.modules.len()
    permit := load.bundle.guard_edit()
    row :: jet_driver_append_loaded_module(&permit.value, load.source_units[unit_index], unit_index, cache.source, ^program)
    &load.modules.push(row)
    Val(index)
}

fn jet_driver_foreign_rewrite_module(load: &JetDriverLoadResult, surface: JetDriverForeignSurface, package: String, root_identity: String, merged_functions: [ExternFn], adapters: [SemaForeignCloseAdapterInput], adapter_functions: [Func], overlay_bytes: &[compiler_driver_os_path.OSPath:[U8]], diagnostics: &[Diagnostic]) -> JetDriverModuleFacts? {
    cache_path :: jet_driver_foreign_generated_path(surface)
    cache_source :: jet_driver_foreign_generated_source(surface)
    aggregate_path :: jet_driver_foreign_aggregate_path(surface)
    canonical :: jet_driver_foreign_canonical_assembly(load, surface, cache_path, cache_source, adapters, &overlay_bytes, &diagnostics) ?? return None
    overlay_index := [String:Int]{}
    loop (index, function) in canonical.overlay_functions -> overlay_index[function.name] = index
    adapter_index := [String:Int]{}
    loop (index, function) in adapter_functions -> adapter_index[function.name] = index
    rewritten_functions := [ExternFn]{}
    loop original in merged_functions {
        function := original
        if overlay_index.get(function.name) == .Val(index) {
            canonical_function := canonical.overlay_functions[index]
            canonical_function.generated = function.generated
            canonical_function.effect_root = function.effect_root
            canonical_function.callback_transport = function.callback_transport
            canonical_function.callback_plan_digest = function.callback_plan_digest
            canonical_function.callback_identity = function.callback_identity
            canonical_function.rust_path = function.rust_path
            if function.close == .Val(close) -> canonical_function.close = Val(NamedSpan{name: close.name, span: canonical_function.name_span})
            if function.undo == .Val(undo) -> canonical_function.undo = Val(NamedSpan{name: undo.name, span: canonical_function.name_span})
            function = canonical_function
        }
        &rewritten_functions.push(function)
    }
    rewritten_adapters := [Func]{}
    loop canonical_adapter in canonical.adapter_functions {
        function := canonical_adapter
        if adapter_index.get(function.name) == .Val(index) {
                existing :: adapter_functions[index]
                function.is_unsafe = existing.is_unsafe
                function.unsafe_reason = existing.unsafe_reason
                function.unsafe_span = Val(function.span)
                function.compiler_generated = existing.compiler_generated
        }
        &rewritten_adapters.push(function)
    }
    synthetic_path :: "<c.{surface.module_library}>"
    // CFFI.rs:1630-1656: the merged CModule is first, followed by actual close
    // adapters. Parsed cache declarations remain in their own loaded module.
    span :: jet_driver_foreign_span_zero()
    synthetic_items := [Item]{Item.CModule{value: CModule{kind: CModuleKind.Extern, lib: surface.module_library, path_span: span, functions: rewritten_functions, span: span}}}
    loop adapter in rewritten_adapters -> &synthetic_items.push(Item.Func{value: adapter})
    rewritten := jet_driver_foreign_empty_program()
    rewritten.items = synthetic_items
    source_unit_index :: load.source_units.len()
    loop generated_file in canonical.generated_source_files -> jet_driver_add_source_file(&load.generated_source_files, generated_file, &diagnostics)
    // CFFI.rs:1639/1697 original path/display/source are independent of the
    // compiler's private span-coordinate assembly retained for diagnostics.
    jet_driver_add_source_file(&load.generated_source_files, MIRSourceFile{id: mir_source_file_id(synthetic_path), path: synthetic_path, source: ""}, &diagnostics)
    &load.source_units.push(JetDriverSourceUnit{root_index: surface.root_index, file_index: -1, foreign_cache_index: None, root_identity: root_identity, package_identity: package, module_name: "__c_{surface.module_library}", alias: "__c_{surface.module_library}", bundle_module: true, path: synthetic_path, physical_path: None, relative_path: "c.{surface.module_library}", relative_os_path: None, source_segments: canonical.source_segments, source_origin: SemaSourceOrigin.CompilerGenerated, provenance_source_file: Val(aggregate_path)})
    permit := load.bundle.guard_edit()
    synthetic :: jet_driver_append_loaded_module(&permit.value, load.source_units[source_unit_index], source_unit_index, "", ^rewritten)
    &load.modules.push(synthetic)
    Val(synthetic)
}

fn jet_driver_foreign_remove_overlay_items(load: &JetDriverLoadResult) Never! {
    permit := load.bundle.guard_edit()
    loop row in load.modules {
        unit :: load.source_units[row.source_unit_index]
        if unit.provenance_source_file != None -> next
        index :: row.bundle_index ?? next
        items := [Item]{}
        loop item in permit.value.modules[index].items {
            if item == { .CModule(_) -> {} else -> &items.push(item) }
        }
        permit.value.modules[index].items = items
    }
}

pub fn jet_driver_assemble_foreign_providers(request: JetDriverCompileRequest, load: &JetDriverLoadResult) -> [SemaForeignProviderInput] {
    view :: jet_driver_authorized_source_view(request.authorized_sources, None)
    jet_driver_assemble_foreign_providers_from_source_view(request, view, &load, [compiler_driver_os_path.OSPath:String]{})
}
fn jet_driver_assemble_foreign_providers_from_source_view(request: JetDriverCompileRequest, snapshot: JetDriverAuthorizedSourceView, load: &JetDriverLoadResult, source_overlays: [compiler_driver_os_path.OSPath:String]) -> [SemaForeignProviderInput] {
    diagnostics := [Diagnostic]{ }
    artifacts :: jet_driver_foreign_artifact_index(snapshot)
    requests := [JetDriverForeignRequest]{ }
    overlays := [JetDriverForeignSurface]{ }
    overlay_index := [String:Int]{}
    surfaces := [JetDriverForeignSurface]{}
    surface_index := [String:Int]{}
    cache_languages := [compiler_driver_os_path.OSPath:String]{}
    metadata_parts := [Int:[CBindingMetadata]]{}
    request_groups := [String:String]{}
    collected_modules := 0
    request_cursor := 0
    retained_load := jet_driver_retained_cache_load_state(snapshot, load, &diagnostics)
    root_packages := [Int:String]{}
    loop package in load.packages -> root_packages[package.root_index] = package.identity
    // Only newly appended modules and requests enter each batch. Cycles stop
    // at the surface index; physical caches are parsed and retained once.
    loop {
        jet_driver_foreign_collect_requests(&load, collected_modules, cache_languages, &requests, &overlays, &overlay_index, &diagnostics)
        collected_modules = load.modules.len()
        retained_modules := [Int:Int]{}
        loop request_cursor < requests.len() {
            foreign_request :: requests[request_cursor]
            request_cursor += 1
            key :: jet_driver_foreign_surface_key(foreign_request.root_index, foreign_request.language, foreign_request.library)
            if surface_index.get(key) != None -> next
            surface := jet_driver_foreign_surface(snapshot, artifacts, foreign_request, &diagnostics)
            surface_index[key] = surfaces.len()
            request_groups[key] = jet_driver_foreign_surface_key(surface.root_index, "c", surface.module_library)
            if surface.parsed_metadata == .Val(metadata) {
                parts := metadata_parts.get(surface.root_index) ?? [CBindingMetadata]{}
                &parts.push(metadata.canonical)
                metadata_parts[surface.root_index] = parts
            }
            package :: root_packages.get(surface.root_index) ?? load.package_identity
            if jet_driver_foreign_retain_cache(snapshot, &load, surface, package) == .Val(index) {
                retained_modules[load.modules[index].source_unit_index] = index
                if surface.cache == .Val(cache) -> cache_languages[cache.native_path] = surface.language
            }
            // The actual bundle now owns this AST; do not keep a second
            // cache Program in the producer's request bookkeeping.
            surface.cache_program = None
            &surfaces.push(surface)
        }
        if retained_modules.len() == 0 -> break
        jet_driver_load_retained_cache_imports(request, snapshot, source_overlays, &load, &retained_load, retained_modules, &diagnostics)
    }
    captured :: jet_driver_collect_source_files(snapshot, load.source_units, load.modules, load.generated_source_files, source_overlays)
    load.source_files = captured.files
    load.source_file_index = captured.index
    load.generated_source_file_index = captured.generated_index
    load.physical_source_paths = captured.physical_paths
    loop diagnostic in captured.diagnostics -> &diagnostics.push(diagnostic)
    // Initial metadata/authored-bindgen refusals precede any synthetic merge.
    // Physical caches and their complete parsed fields remain real modules.
    if jet_driver_has_errors(diagnostics) {
        jet_driver_foreign_remove_overlay_items(&load)
        loop diagnostic in diagnostics -> &load.diagnostics.push(diagnostic)
        load.complete = false
        if load.failed_stage == None -> load.failed_stage = Val(JetDriverStage.Load)
        return []
    }
    root_metadata := [Int:JetDriverForeignMetadata]{}
    all_metadata := [CBindingMetadata]{}
    loop (root, parts) in metadata_parts {
        canonical :: CBindingMetadata.merge_all(parts)
        &all_metadata.push(canonical)
        root_metadata[root] = jet_driver_foreign_metadata(canonical, "")
    }
    declared_surfaces := [JetDriverForeignSurface]{}
    // `overlays` is the indexed first-seen order of ALL actual CModules:
    // bindgen, generated-file Extern (including CPP), and authored Extern.
    loop declaration in overlays {
        &declared_surfaces.push(jet_driver_foreign_declared_surface(snapshot, artifacts, declaration, root_metadata.get(declaration.root_index), &diagnostics))
    }
    loop requested in surfaces {
        key :: jet_driver_foreign_surface_key(requested.root_index, "c", requested.module_library)
        if overlay_index.get(key) != None -> next
        empty := requested
        empty.parsed_metadata = root_metadata.get(empty.root_index)
        overlay_index[key] = declared_surfaces.len()
        &declared_surfaces.push(empty)
    }
    canonical_metadata :: CBindingMetadata.merge_all(all_metadata)
    cffi := CFfi.empty()
    cffi.handle_facts = canonical_metadata.handle_facts
    cffi.link_closure = canonical_metadata.link_closure
    providers := [SemaForeignProviderInput]{ }
    overlay_bytes := [compiler_driver_os_path.OSPath:[U8]]{}
    synthetic_index := [String:Int]{}
    loop surface in declared_surfaces {
        if !surface.valid -> next
        handles := [SemaForeignHandleInput]{ }
        direct_links := [String]{surface.module_library}
        transitive_links := [String]{ }
        if surface.parsed_metadata == .Val(metadata) {
            handles = metadata.handles
            direct_links = metadata.direct_links
            transitive_links = metadata.transitive_links
            &direct_links.push(surface.module_library)
        }
        direct_links = jet_driver_foreign_unique_strings(direct_links)
        transitive_links = jet_driver_foreign_unique_strings(transitive_links)
        // CFFI.rs:1562-1598: indexed last-bindgen-wins / overlay replacement.
        merged := [ExternFn]{}
        function_index := [String:Int]{}
        generated_symbols := [String:String]{}
        loop function in surface.overlay_functions {
            if !function.generated -> next
            generated_symbols[function.name] = function.rust_path
            if function_index.get(function.name) == {
                .Val(index) -> merged[index] = function
                .None -> {
                    function_index[function.name] = merged.len()
                    &merged.push(function)
                }
            }
        }
        overrides := [SemaForeignOverlayOverrideInput]{}
        loop overlay_index in 0..<surface.overlay_functions.len() {
            function :: surface.overlay_functions[overlay_index]
            if function.generated -> next
            overlay_path :: if overlay_index < surface.overlay_function_paths.len() -> surface.overlay_function_paths[overlay_index] else -> surface.overlay_path
            if function_index.get(function.name) == {
                .Val(index) -> {
                    if !jet_driver_foreign_same_signature(merged[index], function) {
                        diagnostic :: pkg_cffi_e3205(surface.library, function.name, function.name_span)
                        &diagnostics.push(diagnostic_with_source_path(^diagnostic, overlay_path, function.name_span.start))
                        next
                    }
                    if generated_symbols.get(function.name) == .Val(symbol) {
                        &overrides.push(SemaForeignOverlayOverrideInput{generated_symbol: symbol, overlay_symbol: function.rust_path})
                    }
                    effect_root :: merged[index].effect_root
                    merged[index] = function
                    merged[index].effect_root = effect_root
                }
                .None -> {
                    function_index[function.name] = merged.len()
                    &merged.push(function)
                }
            }
        }
        prepared :: jet_driver_foreign_prepare_functions(merged, handles, surface, &diagnostics)
        merged = prepared.functions
        boundary := SemaForeignBoundaryInput?{None}
        if surface.parsed_provenance == .Val(provenance) -> boundary = Val(jet_driver_foreign_boundary(provenance))
        if boundary == .Val(boundary_value) {
            loop index in 0..<merged.len() {
                merged[index].effect_root = Val(boundary_value.effect_root)
            }
        }
        source_span :: if surface.overlay_span.start != 0 || surface.overlay_span.end != 0 -> surface.overlay_span else -> surface.cache_span
        package :: root_packages.get(surface.root_index) ?? load.package_identity
        root_identity :: snapshot.roots[surface.root_index].identity
        rewritten :: jet_driver_foreign_rewrite_module(&load, surface, package, root_identity, merged, prepared.adapters, prepared.adapter_functions, &overlay_bytes, &diagnostics)
        rewritten_module :: rewritten ?? next
        synthetic_index[jet_driver_foreign_surface_key(surface.root_index, "c", surface.module_library)] = load.modules.len() - 1
        actual_index :: rewritten_module.bundle_index ?? panic("a real synthetic module must have an AST index")
        &cffi.libs.push(CLib{lib: surface.module_library, module_idx: actual_index})
        if surface.parsed_provenance == .Val(facts) -> &cffi.boundaries.push(facts)
        loop override in overrides -> &cffi.overlay_overrides.push(COverlayOverride{lib: surface.module_library, generated_symbol: override.generated_symbol, overlay_symbol: override.overlay_symbol})
        loop adapter in prepared.adapters -> &cffi.close_adapters.push(FfiCloseAdapter{lib: adapter.library, handle_type: adapter.handle_type, raw_function: adapter.raw_function, adapter_function: adapter.adapter_function})
        loop library in direct_links -> &cffi.link_closure.direct.push(library)
        loop library in transitive_links -> &cffi.link_closure.transitive.push(library)
        &providers.push(SemaForeignProviderInput{language: surface.language, module_identity: rewritten_module.module_identity, library: surface.library, module_library: surface.module_library, source_span: source_span, handles: handles, close_adapters: prepared.adapters, overrides: overrides, boundary: boundary, direct_links: direct_links, transitive_links: transitive_links})
    }
    loop request in requests {
        if request.form == "item" -> next
        request_key :: jet_driver_foreign_surface_key(request.root_index, request.language, request.library)
        key :: request_groups.get(request_key) ?? next
        if synthetic_index.get(key) == .Val(target_index) {
            target := load.modules[target_index]
            jet_driver_foreign_add_import_edge(&load, request, target)
            source_index :: load.modules[request.module_index].bundle_index ?? next
            target_index :: target.bundle_index ?? next
            scope :: if request.scope == "" -> None else -> Val(request.scope)
            &cffi.import_links.push(CImportLink{importing_idx: source_index, scope: scope, alias: request.alias, target_idx: target_index})
        }
    }
    jet_driver_foreign_remove_overlay_items(&load)
    provenance :: jet_driver_collect_source_files(snapshot, load.source_units, load.modules, load.generated_source_files, source_overlays)
    load.source_files = provenance.files
    load.source_file_index = provenance.index
    load.generated_source_file_index = provenance.generated_index
    load.physical_source_paths = provenance.physical_paths
    loop diagnostic in provenance.diagnostics -> &diagnostics.push(diagnostic)
    loop diagnostic in diagnostics -> &load.diagnostics.push(diagnostic)
    if {
        !provenance.complete || jet_driver_has_errors(load.diagnostics) -> {
            load.complete = false
            if load.failed_stage == None -> load.failed_stage = Val(JetDriverStage.Load)
        }
        else -> {
            cffi.link_closure = FfiLinkClosure.new(^cffi.link_closure.direct, ^cffi.link_closure.transitive)
            permit := load.bundle.guard_edit()
            permit.value.cffi = ^cffi
            load.complete = true
            load.failed_stage = None
        }
    }
    providers
}
