// Source-coupled C/C++ foreign assembly.  The host supplies authorized cache,
// metadata, and provenance bytes; this stage never opens a path or calls the
// native assembler.  It parses the exact Jet cache and source overlays, merges
// one surface per requested language/library, and publishes provider facts.

struct JetDriverForeignRequest {
    library: String
    language: String
    root_index: Int
    module_index: Int
    scope: String
    source_path: String
    declaration: ImportDecl
    alias: String
    alias_span: Span
    binding_span: Span
    form: String
}

struct JetDriverForeignSurface {
    library: String
    language: String
    module_library: String
    root_index: Int
    cache: ?JetDriverAuthorizedSourceFile
    metadata: ?JetDriverAuthorizedSourceFile
    provenance: ?JetDriverAuthorizedSourceFile
    cache_program: ?Program
    cache_span: Span
    overlay_functions: [ExternFn]
    overlay_function_paths: [String]
    overlay_span: Span
    overlay_path: String
    parsed_metadata: ?JetDriverForeignMetadata
    parsed_provenance: ?JetDriverForeignProvenance
    valid: Bool
}

struct JetDriverForeignMetadata {
    library: String
    handles: [SemaForeignHandleInput]
    direct_links: [String]
    transitive_links: [String]
}
struct JetDriverForeignCanonicalAssembly {
    source: String
    overlay_functions: [ExternFn]
    adapter_functions: [Func]
    source_segments: [SemaSourceSegment]
    generated_source_files: [MirSourceFile]
}


struct JetDriverForeignProvenance {
    schema: String
    boundary_schema: String
    descriptor: String
    boundary_digest: String
    direct_links: [String]
    language: String
    library: String
    effect_root: String
    effects: String
    source_authority: String
    artifact_coverage_digest: String
    loaded_artifact: String
    transitive_dependencies: ?[String]
    reachable_callbacks: ?[String]
    compiler_flags: ?[String]
    target: String
    generator: String
    obligations: [SemaForeignBoundaryObligationInput]
}

fn jet_driver_foreign_span_zero() -> Span {
    Span{start: 0, end: 0}
}

fn jet_driver_foreign_path(path: String) -> String {
    path.replace("\\", "/")
}

fn jet_driver_foreign_cache_relative(language: String, library: String) -> String {
    ".jet/bindings/{language}/{library}.jet"
}

fn jet_driver_foreign_sidecar_relative(language: String, library: String, extension: String) -> String {
    ".jet/bindings/{language}/{library}.{extension}"
}

fn jet_driver_foreign_valid_library(library: String) -> Bool {
    library.len() > 0 && library != "." && library != ".." && !library.contains("/") && !library.contains("\\") && !library.contains("\n") && !library.contains("\r")
}

fn jet_driver_foreign_library_from_c_path(path: String) -> ?String {
    if !path.starts_with("c.") -> return None
    remainder := path.slice(2, path.len())
    parts := remainder.split(".")
    if parts.len() == 0 -> return None
    first := parts[0]
    if !jet_driver_foreign_valid_library(first) -> return None
    Val(first)
}

fn jet_driver_foreign_library_from_cpp_path(path: String) -> ?String {
    if !path.starts_with("cpp.") -> return None
    remainder := path.slice(4, path.len())
    parts := remainder.split(".")
    if parts.len() == 0 -> return None
    first := parts[0]
    if !jet_driver_foreign_valid_library(first) -> return None
    Val(first)
}

fn jet_driver_foreign_library_from_header(path: String) -> ?String {
    normalized := jet_driver_foreign_path(path)
    if !normalized.ends_with(".h") -> return None
    parts := normalized.split("/")
    file := parts[parts.len() - 1]
    suffix := ".h"
    library := file.slice(0, file.len() - suffix.len())
    if !jet_driver_foreign_valid_library(library) -> return None
    Val(library)
}

fn jet_driver_foreign_library_from_cpp_header(path: String) -> ?String {
    normalized := jet_driver_foreign_path(path)
    if !normalized.ends_with(".hpp") && !normalized.ends_with(".hxx") -> return None
    parts := normalized.split("/")
    file := parts[parts.len() - 1]
    suffix := if file.ends_with(".hpp") -> ".hpp" else -> ".hxx"
    library := file.slice(0, file.len() - suffix.len())
    if !jet_driver_foreign_valid_library(library) -> return None
    Val(library)
}

fn jet_driver_foreign_import_library(declaration: ImportDecl) -> (library: ?String, form: String) {
    if declaration.kind == {
        .Module(name, _) -> return (library: jet_driver_foreign_library_from_c_path(name), form: "module")
        .File(path, _) -> return (library: jet_driver_foreign_library_from_header(path), form: "header")
        .Unqualified(module_alias, _, items, _, _) -> {
            direct := jet_driver_foreign_library_from_c_path(module_alias)
            if direct != None -> return (library: direct, form: "module")
            if module_alias == "c" && items.len() > 0 {
                first := items[0].original
                return (library: jet_driver_foreign_library_from_c_path("c.{first}"), form: "module")
            }
            return (library: None, form: "module")
        }
    }
}

fn jet_driver_foreign_import_libraries(declaration: ImportDecl) -> (libraries: [String], form: String) {
    imported := jet_driver_foreign_import_library(declaration)
    libraries := [String]{}
    if declaration.kind == {
        .Unqualified(module_alias, _, items, _, _) -> {
            if module_alias == "c" {
                loop item in items {
                    library :: jet_driver_foreign_library_from_c_path("c.{item.original}") ?? next
                    libraries.push(library)
                }
                return (libraries: libraries, form: "module")
            }
        }
        else -> {}
    }
    if imported.library != None {
        library :: imported.library ?? return (libraries: libraries, form: imported.form)
        libraries.push(library)
    }
}

fn jet_driver_foreign_import_header(declaration: ImportDecl) -> String {
    if declaration.kind == {
        .File(path, _) -> return path
        else -> {}
    }
    ""
}

fn jet_driver_foreign_import_conflict_diagnostic(library: String, header: String, span: Span) -> Diagnostic {
    jet_driver_diagnostic("E3204", span, "two different `use` forms refer to the same C library `{library}`", "Jet allows one bring-in per C lib per file — either `use \"{header}\" as alias`, `use c.{library} as alias`, or `use c.[{library} as alias]`, not both", "remove one line; keep the form that matches your workflow")
}

fn jet_driver_foreign_binding_diagnostic(path: String, library: String, reason: String) -> Diagnostic {
    jet_driver_diagnostic("E3208", jet_driver_foreign_span_zero(), "Could not generate bindings from `{path}`.", reason, "Fix the header path, install dev headers, run `jet inspect bind` manually for details, or hand-write `#Import module c.{library}`.")
}
fn jet_driver_foreign_artifact_library(path: String) -> String {
    normalized := jet_driver_foreign_path(path)
    parts := normalized.split("/")
    file := parts[parts.len() - 1]
    suffix := ""
    if file.ends_with(".metadata") -> suffix = ".metadata"
    if file.ends_with(".provenance") -> suffix = ".provenance"
    if file.ends_with(".jet") -> suffix = ".jet"
    if suffix != "" -> return file.slice(0, file.len() - suffix.len())
    if file.starts_with("foreign:") {
        foreign_parts := file.split(".")
        if foreign_parts.len() > 1 -> return foreign_parts[foreign_parts.len() - 1]
    }
    ""
}
fn jet_driver_foreign_diagnostic_offset(diagnostic: Diagnostic) -> Int {
    if diagnostic.span == None -> return 0
    span :: diagnostic.span ?? return 0
    span.start
}

fn jet_driver_foreign_add_request(requests: &[JetDriverForeignRequest], language: String, library: String, root_index: Int, module_index: Int, scope: String, source_path: String, declaration: ImportDecl, alias: String, alias_span: Span, binding_span: Span, form: String, diagnostics: &[Diagnostic]) {
    conflict_index := 0
    loop conflict_index < requests.len() {
        existing := requests[conflict_index]
        if existing.module_index == module_index && existing.scope == scope && existing.language == language && existing.library == library && existing.form != "item" && form != "item" && existing.form != form {
            header := jet_driver_foreign_import_header(existing.declaration)
            if header == "" -> header = jet_driver_foreign_import_header(declaration)
            diagnostic := jet_driver_foreign_import_conflict_diagnostic(library, header, declaration.span)
            diagnostics.push(diagnostic_with_source_path(diagnostic, source_path, declaration.span.start))
            return
        }
        conflict_index += 1
    }
    index := 0
    loop index < requests.len() {
        request := requests[index]
        if request.module_index == module_index && request.scope == scope && request.language == language && request.library == library && request.alias == alias && request.declaration.span.start == declaration.span.start && request.declaration.span.end == declaration.span.end {
            if request.form == "item" && form != "item" {
                request.form = form
                request.declaration = declaration
                request.source_path = source_path
                request.alias_span = alias_span
                request.binding_span = binding_span
                requests[index] = request
            } else if request.form != form && request.form != "item" && form != "item" {
                header := jet_driver_foreign_import_header(request.declaration)
                if header == "" -> header = jet_driver_foreign_import_header(declaration)
                diagnostic := jet_driver_foreign_import_conflict_diagnostic(library, header, declaration.span)
                diagnostics.push(diagnostic_with_source_path(diagnostic, source_path, declaration.span.start))
            }
            return
        }
        index += 1
    }
    requests.push(JetDriverForeignRequest{library: library, language: language, root_index: root_index, module_index: module_index, scope: scope, source_path: source_path, declaration: declaration, alias: alias, alias_span: alias_span, binding_span: binding_span, form: form})
}

fn jet_driver_foreign_collect_imports(imports: [ImportDecl], root_index: Int, module_index: Int, scope: String, source_path: String, requests: &[JetDriverForeignRequest], diagnostics: &[Diagnostic]) {
    loop declaration in imports {
        handled_members := false
        has_request := false
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if module_alias == "c" || module_alias == "cpp" {
                    handled_members = true
                    language := if module_alias == "c" -> "c" else -> "cpp"
                    item_index := 0
                    loop item_index < items.len() {
                        item := items[item_index]
                        maybe_library := if language == "c" -> jet_driver_foreign_library_from_c_path("{module_alias}.{item.original}") else -> jet_driver_foreign_library_from_cpp_path("{module_alias}.{item.original}")
                        if maybe_library == None {
                            item_index += 1
                            next
                        }
                        library :: maybe_library ?? ""
                        alias := item.original
                        alias_span := declaration.span
                        binding_span := declaration.span
                        if item_index < declaration.item_spans.len() -> binding_span = declaration.item_spans[item_index]
                        if item.alias != None {
                            alias :: item.alias ?? item.original
                            if item_index < declaration.local_spans.len() -> alias_span = declaration.local_spans[item_index]
                        } else if item_index < declaration.item_spans.len() {
                            alias_span = declaration.item_spans[item_index]
                        }
                        jet_driver_foreign_add_request(&requests, language, library, root_index, module_index, scope, source_path, declaration, alias, alias_span, binding_span, "module", &diagnostics)
                        has_request = true
                        item_index += 1
                    }
                }
            }
            else -> {}
        }
        if !handled_members {
            imported := jet_driver_foreign_import_libraries(declaration)
            language := "c"
            maybe_library := None
            if declaration.kind == {
                .Module(name, _) -> {
                    if name.starts_with("cpp.") {
                        language = "cpp"
                        maybe_library = jet_driver_foreign_library_from_cpp_path(name)
                    }
                }
                .File(path, _) -> {
                    if path.ends_with(".hpp") || path.ends_with(".hxx") {
                        language = "cpp"
                        maybe_library = jet_driver_foreign_library_from_cpp_header(path)
                    }
                }
                else -> {}
            }
            if maybe_library != None {
                library :: maybe_library ?? ""
                jet_driver_foreign_add_request(&requests, language, library, root_index, module_index, scope, source_path, declaration, declaration.alias, declaration.alias_span, declaration.span, "module", &diagnostics)
                has_request = true
            } else {
                loop library in imported.libraries {
                    jet_driver_foreign_add_request(&requests, "c", library, root_index, module_index, scope, source_path, declaration, declaration.alias, declaration.alias_span, declaration.span, imported.form, &diagnostics)
                    has_request = true
                }
            }
        }
        if !has_request {
            foreign_form := declaration.kind == {
                .Module(name, _) -> name == "c" || name.starts_with("c.") || name == "cpp" || name.starts_with("cpp.")
                .File(path, _) -> path.ends_with(".h") || path.ends_with(".hpp") || path.ends_with(".hxx")
                .Unqualified(module_alias, _, _, _, _) -> module_alias == "c" || module_alias == "cpp"
            }
            if foreign_form {
                diagnostic := jet_driver_diagnostic("E3208", declaration.span, "a foreign import has an invalid library identity", "foreign cache and header paths must identify one native library without an empty or malformed name", "use `c.<library>`, `cpp.<library>`, or a header whose basename names the library")
                diagnostics.push(diagnostic_with_source_path(diagnostic, source_path, declaration.span.start))
            }
        }
    }
}
fn jet_driver_foreign_collect_items(items: [Item], root_index: Int, module_index: Int, scope: String, source_path: String, requests: &[JetDriverForeignRequest], overlays: &[JetDriverForeignSurface], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == {
            .CModule(c_module) -> {
                if !jet_driver_foreign_valid_library(c_module.lib) {
                    diagnostic := jet_driver_diagnostic("E3208", c_module.path_span, "a C module has an invalid library identity", "foreign cache and overlay paths must identify one native library without path traversal", "use `c.<library>` with one safe library name")
                    diagnostics.push(diagnostic_with_source_path(diagnostic, source_path, c_module.path_span.start))
                    next
                }
                if c_module.kind == CModuleKind.Bindgen {
                    diagnostic := jet_driver_diagnostic("E3207", c_module.path_span, "`#Bindgen` is only allowed in generated cache files", "`.jet/bindings/c/{c_module.lib}.jet` is written by `jet inspect bind`; hand-written sources use `#Import module`", "edit your overlay file with `#Import module`, or regenerate the cache with `jet inspect bind`")
                    diagnostics.push(diagnostic_with_source_path(diagnostic, source_path, c_module.path_span.start))
                    next
                }
                surface_index := -1
                loop index in 0..<overlays.len() {
                    if overlays[index].language == "c" && overlays[index].library == c_module.lib && overlays[index].root_index == root_index {
                        surface_index = index
                        break
                    }
                }
                if surface_index < 0 {
                    overlays.push(JetDriverForeignSurface{library: c_module.lib, language: "c", module_library: c_module.lib, root_index: root_index, cache: None, metadata: None, provenance: None, cache_program: None, cache_span: c_module.path_span, overlay_functions: [ExternFn]{}, overlay_function_paths: [String]{}, overlay_span: c_module.path_span, overlay_path: source_path, parsed_metadata: None, parsed_provenance: None, valid: true})
                    surface_index = overlays.len() - 1
                }
                loop function in c_module.functions {
                    overlays[surface_index].overlay_functions.push(function)
                    overlays[surface_index].overlay_function_paths.push(source_path)
                }
                overlays[surface_index].overlay_span = c_module.path_span
                if overlays[surface_index].overlay_path == "" -> overlays[surface_index].overlay_path = source_path
                declaration := ImportDecl{kind: ImportKind.Module(name: "c.{c_module.lib}", span: c_module.path_span), alias: c_module.lib, alias_span: c_module.path_span, span: c_module.span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
                jet_driver_foreign_add_request(&requests, "c", c_module.lib, root_index, module_index, scope, source_path, declaration, c_module.lib, c_module.path_span, c_module.path_span, "item", &diagnostics)
            }
            .CodeModule(definition) -> {
                nested_scope := definition.name
                jet_driver_foreign_collect_imports(definition.imports, root_index, module_index, nested_scope, source_path, &requests, &diagnostics)
                body :: definition.body ?? [Item]{}
                jet_driver_foreign_collect_items(body, root_index, module_index, nested_scope, source_path, &requests, &overlays, &diagnostics)
            }
            .GenericModule(definition) -> {
                nested_scope := definition.name
                jet_driver_foreign_collect_imports(definition.imports, root_index, module_index, nested_scope, source_path, &requests, &diagnostics)
                jet_driver_foreign_collect_items(definition.body, root_index, module_index, nested_scope, source_path, &requests, &overlays, &diagnostics)
            }
            else -> {}
        }
    }
}

fn jet_driver_foreign_collect_requests(load: &JetDriverLoadResult, requests: &[JetDriverForeignRequest], overlays: &[JetDriverForeignSurface], diagnostics: &[Diagnostic]) {
    module_index := 0
    loop module_index < load.modules.len() {
        module := load.modules[module_index]
        if module.source_unit_index < 0 || module.source_unit_index >= load.source_units.len() {
            module_index += 1
            next
        }
        unit := load.source_units[module.source_unit_index]
        root_index := unit.root_index
        scope := ""
        jet_driver_foreign_collect_imports(module.program.imports, root_index, module_index, scope, unit.path, &requests, &diagnostics)
        jet_driver_foreign_collect_items(module.program.items, root_index, module_index, scope, unit.path, &requests, &overlays, &diagnostics)
        module_index += 1
    }
}

fn jet_driver_foreign_find_file(files: [JetDriverAuthorizedSourceFile], relative_path: String) -> ?JetDriverAuthorizedSourceFile {
    loop file in files {
        if jet_driver_foreign_path(file.relative_path) == relative_path -> return Val(file)
    }
    None
}

fn jet_driver_foreign_find_cache(snapshot: JetDriverAuthorizedSourceSnapshot, root_index: Int, language: String, library: String) -> (cache: ?JetDriverAuthorizedSourceFile, metadata: ?JetDriverAuthorizedSourceFile, provenance: ?JetDriverAuthorizedSourceFile) {
    if root_index < 0 || root_index >= snapshot.roots.len() -> return (cache: None, metadata: None, provenance: None)
    root := snapshot.roots[root_index]
    cache_files := root.foreign_cache_files
    cache := jet_driver_foreign_find_file(cache_files, jet_driver_foreign_cache_relative(language, library))
    metadata := jet_driver_foreign_find_file(cache_files, jet_driver_foreign_sidecar_relative(language, library, "metadata"))
    provenance := jet_driver_foreign_find_file(cache_files, jet_driver_foreign_sidecar_relative(language, library, "provenance"))
    (cache: cache, metadata: metadata, provenance: provenance)
}

fn jet_driver_foreign_cache_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic := jet_driver_foreign_binding_diagnostic(path, jet_driver_foreign_artifact_library(path), reason)
    diagnostics.push(diagnostic_with_source_path(diagnostic, path, 0))
}

fn jet_driver_foreign_surface(snapshot: JetDriverAuthorizedSourceSnapshot, request: JetDriverForeignRequest, overlays: [JetDriverForeignSurface], diagnostics: &[Diagnostic]) -> JetDriverForeignSurface {
    found := jet_driver_foreign_find_cache(snapshot, request.root_index, request.language, request.library)
    cache_program := None
    cache_span := jet_driver_foreign_span_zero()
    module_library := request.library
    valid := true
    metadata_file := None
    provenance_file := None
    if found.cache != None {
        cache :: found.cache ?? return JetDriverForeignSurface{library: request.library, language: request.language, module_library: request.library, root_index: request.root_index, cache: None, metadata: None, provenance: None, cache_program: None, cache_span: jet_driver_foreign_span_zero(), overlay_functions: [ExternFn]{}, overlay_function_paths: [String]{}, overlay_span: jet_driver_foreign_span_zero(), overlay_path: "", parsed_metadata: None, parsed_provenance: None, valid: false}
        cache_program = jet_driver_foreign_parse_cache(cache, &diagnostics)
        metadata_file = found.metadata
        provenance_file = found.provenance
        if cache_program == None {
            valid = false
        } else {
            located := jet_driver_foreign_find_generated_module(cache_program ?? jet_driver_foreign_empty_program(), request.language, request.library)
            if located.span.start == 0 && located.span.end == 0 {
                reason := if request.language == "c" -> "does not contain the approved `#Bindgen` C module" else -> "does not contain the generated C++ projection module"
                jet_driver_foreign_cache_error(cache.path, reason, &diagnostics)
                valid = false
            } else {
                cache_span = located.span
                module_library = located.module_library
            }
        }
    }
    parsed_metadata := None
    if metadata_file != None && request.language == "c" {
        metadata :: metadata_file ?? return JetDriverForeignSurface{library: request.library, language: request.language, module_library: module_library, root_index: request.root_index, cache: found.cache, metadata: found.metadata, provenance: found.provenance, cache_program: cache_program, cache_span: cache_span, overlay_functions: [ExternFn]{}, overlay_function_paths: [String]{}, overlay_span: jet_driver_foreign_span_zero(), overlay_path: "", parsed_metadata: None, parsed_provenance: None, valid: false}
        parsed_metadata = jet_driver_foreign_parse_metadata(metadata, request.library, &diagnostics)
        if parsed_metadata == None -> valid = false
    }
    parsed_provenance := None
    if provenance_file != None {
        provenance :: provenance_file ?? return JetDriverForeignSurface{library: request.library, language: request.language, module_library: module_library, root_index: request.root_index, cache: found.cache, metadata: found.metadata, provenance: found.provenance, cache_program: cache_program, cache_span: cache_span, overlay_functions: [ExternFn]{}, overlay_function_paths: [String]{}, overlay_span: jet_driver_foreign_span_zero(), overlay_path: "", parsed_metadata: parsed_metadata, parsed_provenance: None, valid: false}
        parsed_provenance = jet_driver_foreign_parse_provenance(provenance, request.library, &diagnostics)
        if parsed_provenance == None -> valid = false
    }
    overlay_functions := [ExternFn]{ }
    overlay_function_paths := [String]{}
    overlay_span := jet_driver_foreign_span_zero()
    overlay_path := ""
    loop overlay in overlays {
        if overlay.language == request.language && overlay.library == request.library && overlay.root_index == request.root_index {
            overlay_functions = overlay.overlay_functions
            overlay_function_paths = overlay.overlay_function_paths
            overlay_span = overlay.overlay_span
            overlay_path = overlay.overlay_path
            break
        }
    }
    JetDriverForeignSurface{library: request.library, language: request.language, module_library: module_library, root_index: request.root_index, cache: found.cache, metadata: metadata_file, provenance: provenance_file, cache_program: cache_program, cache_span: cache_span, overlay_functions: overlay_functions, overlay_function_paths: overlay_function_paths, overlay_span: overlay_span, overlay_path: overlay_path, parsed_metadata: parsed_metadata, parsed_provenance: parsed_provenance, valid: valid}
}

fn jet_driver_foreign_hex_digit(value: Int) -> Int {
    if value >= 48 && value <= 57 -> return value - 48
    if value >= 65 && value <= 70 -> return value - 55
    if value >= 97 && value <= 102 -> return value - 87
    -1
}

fn jet_driver_foreign_unescape(value: String) -> ?String {
    bytes := value.bytes()
    output := [U8]{ }
    index := 0
    loop index < bytes.len() {
        if bytes[index] != U8{37} {
            output.push(bytes[index])
            index += 1
            next
        }
        if index + 2 >= bytes.len() -> return None
        high := jet_driver_foreign_hex_digit(Int.from_u8(bytes[index + 1]))
        low := jet_driver_foreign_hex_digit(Int.from_u8(bytes[index + 2]))
        if high < 0 || low < 0 -> return None
        output.push(U8{high * 16 + low})
        index += 3
    }
    String.from_bytes(output)
}

fn jet_driver_foreign_line_parts(line: String) -> (name: String, value: String, valid: Bool) {
    bytes := line.bytes()
    index := 0
    loop index < bytes.len() {
        if bytes[index] == U8{61} {
            name := String.from_bytes(bytes[0..<index]) ?? ""
            value := String.from_bytes(bytes[index + 1..<bytes.len()]) ?? ""
            return (name: name, value: value, valid: name.len() > 0 && value.len() > 0)
        }
        index += 1
    }
    (name: "", value: "", valid: false)
}

fn jet_driver_foreign_metadata_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic := jet_driver_foreign_binding_diagnostic(path, jet_driver_foreign_artifact_library(path), reason)
    diagnostics.push(diagnostic_with_source_path(diagnostic, path, 0))
}

fn jet_driver_foreign_parse_metadata(file: JetDriverAuthorizedSourceFile, library: String, diagnostics: &[Diagnostic]) -> ?JetDriverForeignMetadata {
    schema := ""
    metadata_library := ""
    direct := [String]{ }
    transitive := [String]{ }
    handles := [SemaForeignHandleInput]{ }
    valid := true
    loop line in file.source.split("\n") {
        if line == "" -> next
        parts := jet_driver_foreign_line_parts(line)
        if !parts.valid {
            jet_driver_foreign_metadata_error(file.path, "contains a malformed key/value row", &diagnostics)
            valid = false
            next
        }
        name := parts.name
        value := parts.value
        if name == "schema" {
            if schema != "" {
                jet_driver_foreign_metadata_error(file.path, "repeats its schema row", &diagnostics)
                valid = false
            } else {
                schema = value
            }
        } else if name == "library" {
            if metadata_library != "" {
                jet_driver_foreign_metadata_error(file.path, "repeats its library row", &diagnostics)
                valid = false
            } else {
                decoded := jet_driver_foreign_unescape(value)
                if decoded == None {
                    jet_driver_foreign_metadata_error(file.path, "contains an invalid percent escape", &diagnostics)
                    valid = false
                } else {
                    metadata_library = decoded ?? ""
                }
            }
        } else if name == "closure.direct" {
            decoded := jet_driver_foreign_unescape(value)
            if decoded == None {
                jet_driver_foreign_metadata_error(file.path, "contains an invalid percent escape", &diagnostics)
                valid = false
                next
            }
            direct.push(decoded ?? "")
        } else if name == "closure.transitive" {
            decoded := jet_driver_foreign_unescape(value)
            if decoded == None {
                jet_driver_foreign_metadata_error(file.path, "contains an invalid percent escape", &diagnostics)
                valid = false
                next
            }
            transitive.push(decoded ?? "")
        } else if name == "handle" {
            fields := value.split("|")
            if fields.len() != 6 {
                jet_driver_foreign_metadata_error(file.path, "contains a handle row with the wrong field count", &diagnostics)
                valid = false
                next
            }
            lib :: jet_driver_foreign_unescape(fields[0]) ?? ""
            typedef_name :: jet_driver_foreign_unescape(fields[1]) ?? ""
            jet_name :: jet_driver_foreign_unescape(fields[2]) ?? ""
            close :: jet_driver_foreign_unescape(fields[3]) ?? ""
            close_source := fields[4]
            thread_safety := fields[5]
            if lib == "" || typedef_name == "" || jet_name == "" || close == "" || (close_source != "conventional" && close_source != "overlay") || (thread_safety != "unspecified" && thread_safety != "safe" && thread_safety != "unsafe") {
                jet_driver_foreign_metadata_error(file.path, "contains an incomplete handle row", &diagnostics)
                valid = false
                next
            }
            duplicate := false
            loop existing in handles {
                if existing.library == lib && existing.typedef_name == typedef_name && existing.jet_name == jet_name && existing.close == close && existing.close_source == close_source && existing.thread_safety == thread_safety {
                    duplicate = true
                    break
                }
            }
            if !duplicate {
                handles.push(SemaForeignHandleInput{library: lib, typedef_name: typedef_name, jet_name: jet_name, close: close, close_function_key: None, close_source: close_source, thread_safety: thread_safety})
            }
        } else {
            jet_driver_foreign_metadata_error(file.path, "contains an unknown metadata field", &diagnostics)
            valid = false
        }
    }
    if schema != "jet-c-binding-metadata-v1" {
        jet_driver_foreign_metadata_error(file.path, "does not carry schema `jet-c-binding-metadata-v1`", &diagnostics)
        valid = false
    }
    if metadata_library != library {
        jet_driver_foreign_metadata_error(file.path, "names a library different from its cache", &diagnostics)
        valid = false
    }
    if direct.len() == 0 -> direct.push(library)
    if !valid -> return None
    JetDriverForeignMetadata{library: library, handles: handles, direct_links: direct, transitive_links: transitive}
}

fn jet_driver_foreign_parse_optional_list(value: String) -> ?[String] {
    if value == "unknown" -> return None
    if value == "none" -> return Val([String]{})
    values := [String]{ }
    loop item in value.split("|") {
        if item != "" -> values.push(item)
    }
    Val(values)
}

fn jet_driver_foreign_unique_strings(values: [String]) -> [String] {
    result := [String]{ }
    loop value in values {
        present := false
        loop existing in result {
            if existing == value -> present = true
        }
        if !present -> result.push(value)
    }
    result
}

fn jet_driver_foreign_provenance_error(path: String, reason: String, diagnostics: &[Diagnostic]) {
    diagnostic := jet_driver_foreign_binding_diagnostic(path, jet_driver_foreign_artifact_library(path), reason)
    diagnostics.push(diagnostic_with_source_path(diagnostic, path, 0))
}

fn jet_driver_foreign_parse_provenance(file: JetDriverAuthorizedSourceFile, library: String, diagnostics: &[Diagnostic]) -> ?JetDriverForeignProvenance {
    schema := ""
    boundary_schema := ""
    descriptor := ""
    boundary_digest := ""
    language := ""
    boundary_library := ""
    effect_root := ""
    effects := ""
    source_authority := ""
    artifact_coverage_digest := ""
    direct_links := [String]{library}
    loaded_artifact := ""
    transitive_dependencies := None
    reachable_callbacks := None
    compiler_flags := None
    target := ""
    generator := ""
    obligations := [SemaForeignBoundaryObligationInput]{ }
    valid := true
    loop line in file.source.split("\n") {
        if line == "" -> next
        parts := jet_driver_foreign_line_parts(line)
        if !parts.valid {
            jet_driver_foreign_provenance_error(file.path, "contains a malformed key/value row", &diagnostics)
            valid = false
            next
        }
        if name == "schema" -> schema = value
        else if name == "language" && language == "" -> language = value
        else if name == "library" -> direct_links.push(value)
        else if name == "linked-library" -> direct_links.push(value)
        else if name == "boundary-schema" -> boundary_schema = value
        else if name == "boundary-descriptor" -> descriptor = value
        else if name == "boundary-digest" -> boundary_digest = value
        else if name == "boundary-language" -> language = value
        else if name == "boundary-library" -> boundary_library = value
        else if name == "boundary-effect-root" -> effect_root = value
        else if name == "boundary-effects" -> effects = value
        else if name == "boundary-source-authority" -> source_authority = value
        else if name == "boundary-artifact-coverage" -> artifact_coverage_digest = value
        else if name == "boundary-loaded-artifact" -> loaded_artifact = value
        else if name == "boundary-transitive-dependencies" -> transitive_dependencies = jet_driver_foreign_parse_optional_list(value)
        else if name == "boundary-reachable-callbacks" -> reachable_callbacks = jet_driver_foreign_parse_optional_list(value)
        else if name == "boundary-compiler-flags" -> compiler_flags = jet_driver_foreign_parse_optional_list(value)
        else if name == "boundary-coverage-target" -> target = value
        else if name == "boundary-coverage-generator" -> generator = value
        else if name == "boundary-obligation" {
            fields := value.split("\t")
            if fields.len() != 5 {
                jet_driver_foreign_provenance_error(file.path, "contains a boundary obligation with the wrong field count", &diagnostics)
                valid = false
                next
            }
            assumptions := [String]{ }
            loop assumption in fields[4].split("|") {
                if assumption != "" -> assumptions.push(assumption)
            }
            obligations.push(SemaForeignBoundaryObligationInput{name: fields[0], basis: fields[1], checker: fields[2], assumptions: assumptions, coverage_digest: fields[3]})
        }
    }
    if schema != "jet-ffi-provenance-v1" || (language != "c" && language != "cpp") || descriptor == "" || boundary_schema != "jet-ffi-boundary-v1" || boundary_digest == "" || language == "" || boundary_library != library || effect_root == "" || effects == "" || source_authority == "" || artifact_coverage_digest == "" || loaded_artifact == "" || target == "" || generator == "" {
        jet_driver_foreign_provenance_error(file.path, "omits one or more canonical boundary fields", &diagnostics)
        valid = false
    }
    if !valid -> return None
    JetDriverForeignProvenance{schema: schema, boundary_schema: boundary_schema, descriptor: descriptor, boundary_digest: boundary_digest, direct_links: jet_driver_foreign_unique_strings(direct_links), language: language, library: boundary_library, effect_root: effect_root, effects: effects, source_authority: source_authority, artifact_coverage_digest: artifact_coverage_digest, loaded_artifact: loaded_artifact, transitive_dependencies: transitive_dependencies, reachable_callbacks: reachable_callbacks, compiler_flags: compiler_flags, target: target, generator: generator, obligations: obligations}
}

fn jet_driver_foreign_boundary(value: JetDriverForeignProvenance) -> SemaForeignBoundaryInput {
    SemaForeignBoundaryInput{schema: value.boundary_schema, digest: value.boundary_digest, language: value.language, library: value.library, effect_root: value.effect_root, effects: value.effects, source_authority: value.source_authority, artifact_coverage_digest: value.artifact_coverage_digest, loaded_artifact: value.loaded_artifact, transitive_dependencies: value.transitive_dependencies, reachable_callbacks: value.reachable_callbacks, compiler_flags: value.compiler_flags, target: value.target, generator: value.generator, obligations: value.obligations}
}

fn jet_driver_foreign_same_abi(left: ?NamedSpan, right: ?NamedSpan) -> Bool {
    if left == None -> return right == None
    if right == None -> return false
    left_value :: left ?? NamedSpan{name: "", span: Span{start: 0, end: 0}}
    right_value :: right ?? NamedSpan{name: "", span: Span{start: 0, end: 0}}
    left_value.name == right_value.name
}

fn jet_driver_foreign_same_signature(left: ExternFn, right: ExternFn) -> Bool {
    if !jet_driver_foreign_same_abi(left.abi, right.abi) || left.return_type != right.return_type || left.params.len() != right.params.len() -> return false
    index := 0
    loop index < left.params.len() {
        if left.params[index].convention != right.params[index].convention || left.params[index].ty != right.params[index].ty || left.params[index].variadic != right.params[index].variadic -> return false
        index += 1
    }
    true
}

fn jet_driver_foreign_parse_cache(file: JetDriverAuthorizedSourceFile, diagnostics: &[Diagnostic]) -> ?Program {
    lexed := lex_generated(file.source.bytes())
    loop diagnostic in lexed.diagnostics -> diagnostics.push(diagnostic_with_source_path(diagnostic, file.path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    parsed := parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> diagnostics.push(diagnostic_with_source_path(diagnostic, file.path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    Val(parsed.program)
}


fn jet_driver_foreign_find_generated_module(program: Program, language: String, library: String) -> (functions: [ExternFn], span: Span, module_library: String) {
    functions := [ExternFn]{}
    span := jet_driver_foreign_span_zero()
    module_library := ""
    loop item in program.items {
        if item == {
            .CModule(value) -> {
                if language == "c" {
                    if value.kind != CModuleKind.Bindgen || value.lib != library -> next
                } else {
                    if value.kind != CModuleKind.Extern -> next
                }
                module_library = value.lib
                span = value.path_span
                loop function in value.functions -> functions.push(function)
                break
            }
            else -> {}
        }
    }
    (functions: functions, span: span, module_library: module_library)
}

fn jet_driver_foreign_make_adapter_function(handle: String, raw_function: String, origin_path: String, diagnostics: &[Diagnostic]) -> ?Func {
    adapter_name := "__jet_ffi_close_{handle}"
    source := "fn {adapter_name}(handle: ^{handle}) {{\n    {raw_function}(^handle)\n}}\n"
    lexed := lex_generated(source.bytes())
    loop diagnostic in lexed.diagnostics -> diagnostics.push(diagnostic_with_source_path(diagnostic, origin_path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    parsed := parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> diagnostics.push(diagnostic_with_source_path(diagnostic, origin_path, jet_driver_foreign_diagnostic_offset(diagnostic)))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    loop item in parsed.program.items {
        if item == {
            .Func(function) -> {
                function.is_pub = false
                function.is_unsafe = true
                function.unsafe_reason = Val("compiler-generated foreign close adapter")
                function.unsafe_span = Val(jet_driver_foreign_span_zero())
                function.compiler_generated = true
                return Val(function)
            }
            else -> {}
        }
    }
}

fn jet_driver_foreign_prepare_functions(functions: [ExternFn], handles: [SemaForeignHandleInput], surface: JetDriverForeignSurface, diagnostics: &[Diagnostic]) -> (functions: [ExternFn], adapters: [SemaForeignCloseAdapterInput], adapter_functions: [Func]) {
    prepared := functions
    adapters := [SemaForeignCloseAdapterInput]{ }
    adapter_functions := [Func]{ }
    loop handle in handles {
        if handle.close == "" -> next
        constructor_index := -1
        raw_index := -1
        index := 0
        loop index < prepared.len() {
            function := prepared[index]
            if function.name == handle.close && function.return_type != None && function.params.len() == 1 && !function.params[0].variadic && function.params[0].convention == AccessConvention.Move && function.params[0].ty == Type.Named(handle.jet_name) {
                raw_index = index
            }
            if function.close != None && function.return_type == Val(Type.Named(handle.jet_name)) {
                close :: function.close ?? NamedSpan{name: "", span: function.name_span}
                if close.name == handle.close -> constructor_index = index
            }
            index += 1
        }
        if constructor_index < 0 || raw_index < 0 -> next
        adapter_name := "__jet_ffi_close_{handle.jet_name}"
        adapter_path := jet_driver_foreign_adapter_path(surface, adapters.len())
        adapter := jet_driver_foreign_make_adapter_function(handle.jet_name, handle.close, adapter_path, &diagnostics)
        if adapter != None {
            constructor := prepared[constructor_index]
            constructor.close = Val(NamedSpan{name: adapter_name, span: constructor.name_span})
            prepared[constructor_index] = constructor
            adapters.push(SemaForeignCloseAdapterInput{library: handle.library, handle_type: handle.jet_name, raw_function: handle.close, adapter_function: adapter_name})
            adapter_functions.push(adapter ?? next)
        }
    }
    (functions: prepared, adapters: adapters, adapter_functions: adapter_functions)
}



fn jet_driver_foreign_package_for_root(load: JetDriverLoadResult, root_index: Int) -> String {
    loop unit in load.source_units {
        if unit.root_index == root_index -> return unit.package_identity
    }
    load.package_identity
}


fn jet_driver_foreign_find_synthetic_module(load: JetDriverLoadResult, module_library: String, root_index: Int) -> ?Int {
    index := 0
    loop index < load.modules.len() {
        module := load.modules[index]
        if module.module_name == "__c_{module_library}" && module.source_unit_index >= 0 && module.source_unit_index < load.source_units.len() && load.source_units[module.source_unit_index].root_index == root_index -> return Val(index)
        index += 1
    }
    None
}

fn jet_driver_foreign_import_edge_declaration(request: JetDriverForeignRequest) -> ImportDecl {
    request.declaration
}

fn jet_driver_foreign_add_import_edge(load: &JetDriverLoadResult, request: JetDriverForeignRequest, target: JetDriverLoadedModule) {
    declaration := jet_driver_foreign_import_edge_declaration(request)
    scope := None
    if request.scope != "" -> scope = Val(request.scope)
    binding_value := SemaForeignImportBinding{scope: scope, alias: request.alias}
    binding := Val(binding_value)
    loop edge in load.imports {
        same_binding := false
        if edge.foreign_binding != None {
            existing :: edge.foreign_binding ?? SemaForeignImportBinding{scope: None, alias: ""}
            if existing.scope == binding_value.scope && existing.alias == binding_value.alias -> same_binding = true
        }
        if edge.source_module_identity == load.modules[request.module_index].module_identity && edge.target_module_identity == target.module_identity && edge.declaration.span.start == declaration.span.start && edge.declaration.span.end == declaration.span.end && same_binding -> return
    }
    load.imports.push(SemaRegistrationImportEdge{source_module_identity: load.modules[request.module_index].module_identity, target_module_identity: target.module_identity, target_package_identity: target.package_identity, foreign_binding: binding, declaration: declaration})
}

fn jet_driver_foreign_empty_program() -> Program {
    Program{imports: [ImportDecl]{}, items: [Item]{}, script_body: [Stmt]{}, block_spans: [Span]{}, fenced_statements: [FencedStatement]{}, web_target_ceiling: None, pub_file: false, no_prelude: false, default_target: None, html_path: None, policy_declarations: [PolicyDeclaration]{}, user_policy_declarations: [UserPolicyDecl]{}, applied_rules: [AppliedRuleApplication]{}, rule_facts: [AppliedRuleApplication]{}}
}

fn jet_driver_foreign_root_identity(load: JetDriverLoadResult, root_index: Int) -> String {
    loop unit in load.source_units {
        if unit.root_index == root_index -> return unit.root_identity
    }
    ""
}

fn jet_driver_foreign_generated_path(surface: JetDriverForeignSurface) -> String {
    if surface.cache != None {
        cache :: surface.cache ?? return "foreign:{surface.language}.{surface.library}"
        return cache.path
    }
    "foreign:{surface.language}.{surface.library}"
}

fn jet_driver_foreign_generated_source(surface: JetDriverForeignSurface) -> String {
    if surface.cache != None {
        cache :: surface.cache ?? return ""
        return cache.source
    }
    ""
}
fn jet_driver_foreign_aggregate_path(surface: JetDriverForeignSurface) -> String {
    "foreign:{surface.language}.{surface.library}#root{surface.root_index}#aggregate"
}

fn jet_driver_foreign_adapter_path(surface: JetDriverForeignSurface, index: Int) -> String {
    "foreign:{surface.language}.{surface.library}#root{surface.root_index}#close{index}"
}



fn jet_driver_foreign_adapter_source(adapter: SemaForeignCloseAdapterInput) -> String {
    "fn __jet_ffi_close_{adapter.handle_type}(handle: ^{adapter.handle_type}) {{\n    {adapter.raw_function}(^handle)\n}}\n"
}

fn jet_driver_foreign_source_for_path(load: JetDriverLoadResult, path: String) -> String {
    loop file in load.source_files {
        if file.path == path -> return file.source
    }
    ""
}

fn jet_driver_foreign_fragment_line_starts(source: String) -> [Int] {
    segments := jet_driver_source_segments("", source)
    if segments.len() > 0 -> return segments[0].line_starts
    [Int]{0}
}

fn jet_driver_foreign_collect_canonical_overlay_items(items: [Item], overlay_bases: [Int], overlay_ends: [Int], library: String, functions: &[ExternFn]) {
    loop item in items {
        if item == {
            .CModule(value) -> {
                if value.kind != CModuleKind.Extern || value.lib != library -> next
                range_index := 0
                loop range_index < overlay_bases.len() {
                    if value.path_span.start >= overlay_bases[range_index] && value.path_span.start < overlay_ends[range_index] {
                        loop function in value.functions -> functions.push(function)
                        break
                    }
                    range_index += 1
                }
            }
            .CodeModule(definition) -> {
                body :: definition.body ?? [Item]{}
                jet_driver_foreign_collect_canonical_overlay_items(body, overlay_bases, overlay_ends, library, &functions)
            }
            .GenericModule(definition) -> jet_driver_foreign_collect_canonical_overlay_items(definition.body, overlay_bases, overlay_ends, library, &functions)
            else -> {}
        }
    }
}

fn jet_driver_foreign_shift_diagnostic(diagnostic: Diagnostic, offset: Int) -> Diagnostic {
    shifted := diagnostic
    shifted.span = if shifted.span == {
        .Val(span) -> Val(Span{start: span.start + offset, end: span.end + offset})
        .None -> None
    }
    shifted.edit = if shifted.edit == {
        .Val(edit) -> {
            edit.span = Span{start: edit.span.start + offset, end: edit.span.end + offset}
            Val(edit)
        }
        .None -> None
    }
    shifted
}

fn jet_driver_foreign_shift_token(token: &Token, offset: Int) {
    token.span = Span{start: token.span.start + offset, end: token.span.end + offset}
    part_index := 0
    loop part_index < token.payload.string_parts.len() {
        part := token.payload.string_parts[part_index]
        part.span = Span{start: part.span.start + offset, end: part.span.end + offset}
        nested_index := 0
        loop nested_index < part.tokens.len() {
            jet_driver_foreign_shift_token(&part.tokens[nested_index], offset)
            nested_index += 1
        }
        token.payload.string_parts[part_index] = part
        part_index += 1
    }
}

fn jet_driver_foreign_parse_shifted(path: String, source: String, offset: Int, diagnostics: &[Diagnostic]) -> ?Program {
    lexed := lex_generated(source.bytes())
    loop diagnostic in lexed.diagnostics {
        shifted := jet_driver_foreign_shift_diagnostic(diagnostic, offset)
        diagnostics.push(diagnostic_with_source_path(shifted, path, offset))
    }
    if jet_driver_has_errors(lexed.diagnostics) -> return None
    token_index := 0
    loop token_index < lexed.tokens.len() {
        jet_driver_foreign_shift_token(&lexed.tokens[token_index], offset)
        token_index += 1
    }
    parsed := parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics -> diagnostics.push(diagnostic_with_source_path(diagnostic, path, offset))
    if jet_driver_has_errors(parsed.diagnostics) -> return None
    Val(parsed.program)
}

fn jet_driver_foreign_canonical_assembly(load: JetDriverLoadResult, surface: JetDriverForeignSurface, cache_path: String, cache_source: String, adapters: [SemaForeignCloseAdapterInput], diagnostics: &[Diagnostic]) -> ?JetDriverForeignCanonicalAssembly {
    canonical := cache_source
    if canonical.len() > 0 && !canonical.ends_with("\n") -> canonical = "{canonical}\n"
    overlay_paths := [String]{}
    overlay_index := 0
    loop overlay_index < surface.overlay_functions.len() {
        path := surface.overlay_path
        if overlay_index < surface.overlay_function_paths.len() && surface.overlay_function_paths[overlay_index] != "" -> path = surface.overlay_function_paths[overlay_index]
        if path == "" {
            jet_driver_foreign_cache_error(cache_path, "an overlay declaration has no authorized source path", &diagnostics)
            return None
        }
        present := false
        loop existing in overlay_paths {
            if existing == path -> present = true
        }
        if !present -> overlay_paths.push(path)
        overlay_index += 1
    }
    overlay_bases := [Int]{}
    overlay_ends := [Int]{}
    overlay_sources := [String]{}
    overlay_index = 0
    loop overlay_index < overlay_paths.len() {
        path := overlay_paths[overlay_index]
        source := jet_driver_foreign_source_for_path(load, path)
        if source == "" {
            diagnostic := jet_driver_foreign_binding_diagnostic(path, surface.library, "an overlay source is absent from the loaded authorized source files")
            diagnostics.push(diagnostic_with_source_path(diagnostic, path, 0))
            return None
        }
        if canonical.len() > 0 && !canonical.ends_with("\n") -> canonical = "{canonical}\n"
        base := canonical.len()
        canonical = "{canonical}{source}"
        overlay_bases.push(base)
        overlay_ends.push(base + source.len())
        overlay_sources.push(source)
        overlay_index += 1
    }
    if canonical.len() > 0 && !canonical.ends_with("\n") -> canonical = "{canonical}\n"
    adapter_bases := [Int]{}
    adapter_sources := [String]{}
    loop adapter in adapters {
        if canonical.len() > 0 && !canonical.ends_with("\n") -> canonical = "{canonical}\n"
        base := canonical.len()
        source := jet_driver_foreign_adapter_source(adapter)
        canonical = "{canonical}{source}"
        adapter_bases.push(base)
        adapter_sources.push(source)
    }
    canonical_overlays := [ExternFn]{}
    overlay_index = 0
    loop overlay_index < overlay_paths.len() {
        parsed_overlay := jet_driver_foreign_parse_shifted(overlay_paths[overlay_index], overlay_sources[overlay_index], overlay_bases[overlay_index], &diagnostics) ?? return None
        jet_driver_foreign_collect_canonical_overlay_items(parsed_overlay.items, overlay_bases, overlay_ends, surface.library, &canonical_overlays)
        overlay_index += 1
    }
    canonical_adapters := [Func]{}
    adapter_index := 0
    loop adapter_index < adapters.len() {
        adapter_path := jet_driver_foreign_adapter_path(surface, adapter_index)
        parsed_adapter := jet_driver_foreign_parse_shifted(adapter_path, adapter_sources[adapter_index], adapter_bases[adapter_index], &diagnostics) ?? return None
        loop item in parsed_adapter.items {
            if item == {
                .Func(value) -> canonical_adapters.push(value)
                else -> {}
            }
        }
        adapter_index += 1
    }
    if canonical_overlays.len() != surface.overlay_functions.len() || canonical_adapters.len() != adapters.len() {
        jet_driver_foreign_cache_error(cache_path, "the canonical foreign aggregate did not retain every overlay and close adapter declaration", &diagnostics)
        return None
    }
    source_segments := [SemaSourceSegment]{}
    if cache_source.len() > 0 {
        cache_segments := jet_driver_source_segments(cache_path, cache_source)
        if cache_segments.len() > 0 {
            source_segments.push(SemaSourceSegment{generated: Span{start: 0, end: cache_source.len()}, source_file: cache_path, source_start: 0, origin: SemaSourceOrigin.Snapshot, line_starts: cache_segments[0].line_starts})
        }
    }
    overlay_index = 0
    loop overlay_index < overlay_paths.len() {
        source_segments.push(SemaSourceSegment{generated: Span{start: overlay_bases[overlay_index], end: overlay_ends[overlay_index]}, source_file: overlay_paths[overlay_index], source_start: 0, origin: SemaSourceOrigin.Snapshot, line_starts: jet_driver_foreign_fragment_line_starts(overlay_sources[overlay_index])})
        overlay_index += 1
    }
    adapter_index := 0
    loop adapter_index < adapter_sources.len() {
        adapter_path := jet_driver_foreign_adapter_path(surface, adapter_index)
        source_segments.push(SemaSourceSegment{generated: Span{start: adapter_bases[adapter_index], end: adapter_bases[adapter_index] + adapter_sources[adapter_index].len()}, source_file: adapter_path, source_start: 0, origin: SemaSourceOrigin.CompilerGenerated, line_starts: jet_driver_foreign_fragment_line_starts(adapter_sources[adapter_index])})
        adapter_index += 1
    }
    aggregate_path := jet_driver_foreign_aggregate_path(surface)
    generated_source_files := [MirSourceFile]{
        MirSourceFile{id: mir_source_file_id(aggregate_path), path: aggregate_path, source: canonical},
    }
    adapter_index = 0
    loop adapter_index < adapter_sources.len() {
        adapter_path := jet_driver_foreign_adapter_path(surface, adapter_index)
        generated_source_files.push(MirSourceFile{id: mir_source_file_id(adapter_path), path: adapter_path, source: adapter_sources[adapter_index]})
        adapter_index += 1
    }
    Val(JetDriverForeignCanonicalAssembly{source: canonical, overlay_functions: canonical_overlays, adapter_functions: canonical_adapters, source_segments: source_segments, generated_source_files: generated_source_files})
}
fn jet_driver_foreign_rewrite_module(load: &JetDriverLoadResult, surface: JetDriverForeignSurface, merged_functions: [ExternFn], adapters: [SemaForeignCloseAdapterInput], adapter_functions: [Func], diagnostics: &[Diagnostic]) -> ?JetDriverLoadedModule {
    program := surface.cache_program ?? jet_driver_foreign_empty_program()
    cache_path := jet_driver_foreign_generated_path(surface)
    cache_source := jet_driver_foreign_generated_source(surface)
    aggregate_path := jet_driver_foreign_aggregate_path(surface)
    canonical :: jet_driver_foreign_canonical_assembly(load, surface, cache_path, cache_source, adapters, &diagnostics) ?? return None
    rewritten_functions := [ExternFn]{}
    loop original in merged_functions {
        function := original
        if !function.generated {
            loop overlay in canonical.overlay_functions {
                if overlay.name == function.name {
                    canonical_function := overlay
                    canonical_function.generated = function.generated
                    canonical_function.effect_root = function.effect_root
                    canonical_function.callback_transport = function.callback_transport
                    canonical_function.callback_plan_digest = function.callback_plan_digest
                    canonical_function.callback_identity = function.callback_identity
                    canonical_function.rust_path = function.rust_path
                    if function.close != None {
                        close :: function.close ?? NamedSpan{name: "", span: canonical_function.name_span}
                        canonical_function.close = Val(NamedSpan{name: close.name, span: canonical_function.name_span})
                    }
                    if function.undo != None {
                        undo :: function.undo ?? NamedSpan{name: "", span: canonical_function.name_span}
                        canonical_function.undo = Val(NamedSpan{name: undo.name, span: canonical_function.name_span})
                    }
                    function = canonical_function
                    break
                }
            }
        }
        rewritten_functions.push(function)
    }
    rewritten_adapters := [Func]{}
    adapter_index := 0
    loop adapter_index < canonical.adapter_functions.len() {
        function := canonical.adapter_functions[adapter_index]
        existing_index := 0
        loop existing_index < adapter_functions.len() {
            if adapter_functions[existing_index].name == function.name {
                existing := adapter_functions[existing_index]
                function.is_unsafe = existing.is_unsafe
                function.unsafe_reason = existing.unsafe_reason
                function.unsafe_span = Val(function.span)
                function.compiler_generated = existing.compiler_generated
                break
            }
            existing_index += 1
        }
        rewritten_adapters.push(function)
        adapter_index += 1
    }
    package := jet_driver_foreign_package_for_root(load, surface.root_index)
    module_identity := jet_driver_module_identity(package, aggregate_path)
    source_identity := jet_driver_source_identity(package, aggregate_path)
    synthetic_items := [Item]{}
    loop item in program.items {
        if item == { .CModule(_) -> next else -> synthetic_items.push(item) }
    }
    loop adapter in rewritten_adapters -> synthetic_items.push(Item.Func(value: adapter))
    span := surface.cache_span
    if span.start == 0 && span.end == 0 -> span = surface.overlay_span
    synthetic_items.push(Item.CModule(value: CModule{kind: CModuleKind.Extern, lib: surface.module_library, path_span: span, functions: rewritten_functions, span: span}))
    rewritten := Program{imports: program.imports, items: synthetic_items, script_body: program.script_body, block_spans: program.block_spans, fenced_statements: program.fenced_statements, web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file, no_prelude: program.no_prelude, default_target: program.default_target, html_path: program.html_path, policy_declarations: program.policy_declarations, user_policy_declarations: program.user_policy_declarations, applied_rules: program.applied_rules, rule_facts: program.rule_facts}
    source_unit_index := load.source_units.len()
    root_identity := jet_driver_foreign_root_identity(load, surface.root_index)
    loop generated_file in canonical.generated_source_files -> jet_driver_add_source_file(&load.generated_source_files, generated_file, &diagnostics)
    load.source_units.push(JetDriverSourceUnit{root_index: surface.root_index, file_index: -1, root_identity: root_identity, package_identity: package, module_name: "__c_{surface.module_library}", path: aggregate_path, relative_path: aggregate_path, source_segments: canonical.source_segments, source_origin: SemaSourceOrigin.CompilerGenerated})
    synthetic := JetDriverLoadedModule{source_unit_index: source_unit_index, source_identity: source_identity, package_identity: package, module_identity: module_identity, module_name: "__c_{surface.module_library}", program: rewritten}
    load.modules.push(synthetic)
    Val(synthetic)
}

fn jet_driver_foreign_remove_overlay_items(load: &JetDriverLoadResult) {
    index := 0
    loop index < load.modules.len() {
        module := load.modules[index]
        if module.module_name.starts_with("__c_") {
            index += 1
            next
        }
        items := [Item]{ }
        loop item in module.program.items {
            if item == { .CModule(_) -> {} else -> items.push(item) }
        }
        module.program.items = items
        load.modules[index] = module
        index += 1
    }
}

pub fn jet_driver_assemble_foreign_providers(snapshot: JetDriverAuthorizedSourceSnapshot, load: &JetDriverLoadResult) -> [SemaForeignProviderInput] {
    diagnostics := [Diagnostic]{ }
    requests := [JetDriverForeignRequest]{ }
    overlays := [JetDriverForeignSurface]{ }
    jet_driver_foreign_collect_requests(&load, &requests, &overlays, &diagnostics)
    surfaces := [JetDriverForeignSurface]{ }
    loop request in requests {
        found := false
        loop surface in surfaces {
            if surface.language == request.language && surface.library == request.library && surface.root_index == request.root_index {
                found = true
                break
            }
        }
        if !found -> surfaces.push(jet_driver_foreign_surface(snapshot, request, overlays, &diagnostics))
    }
    providers := [SemaForeignProviderInput]{ }
    surface_index := 0
    loop surface_index < surfaces.len() {
        surface := surfaces[surface_index]
        surface_index += 1
        if !surface.valid -> next
        handles := [SemaForeignHandleInput]{ }
        direct_links := [String]{surface.library}
        transitive_links := [String]{ }
        if surface.parsed_metadata != None {
            metadata :: surface.parsed_metadata ?? next
            handles = metadata.handles
            direct_links = metadata.direct_links
            transitive_links = metadata.transitive_links
            direct_present := false
            loop library in direct_links {
                if library == surface.library -> direct_present = true
            }
            if !direct_present -> direct_links.push(surface.library)
        }
        if surface.parsed_provenance != None {
            provenance :: surface.parsed_provenance ?? next
            direct_links = provenance.direct_links
            if provenance.transitive_dependencies != None {
                transitive :: provenance.transitive_dependencies ?? [String]{}
                transitive_links = transitive
            }
        }
        if surface.language == "cpp" -> direct_links.push(surface.module_library)
        direct_links = jet_driver_foreign_unique_strings(direct_links)
        transitive_links = jet_driver_foreign_unique_strings(transitive_links)
        generated_functions := [ExternFn]{ }
        if surface.cache_program != None {
            located := jet_driver_foreign_find_generated_module(surface.cache_program ?? jet_driver_foreign_empty_program(), surface.language, surface.library)
            generated_functions = located.functions
            loop index in 0..<generated_functions.len() {
                function := generated_functions[index]
                function.generated = true
                generated_functions[index] = function
            }
        }
        merged := [ExternFn]{ }
        loop function in generated_functions -> merged.push(function)
        overlay_index := 0
        loop overlay_index < surface.overlay_functions.len() {
            function := surface.overlay_functions[overlay_index]
            overlay_path := surface.overlay_path
            if overlay_index < surface.overlay_function_paths.len() -> overlay_path = surface.overlay_function_paths[overlay_index]
            replaced := false
            index := 0
            loop index < merged.len() {
                if merged[index].name == function.name {
                    replaced = true
                    if !jet_driver_foreign_same_signature(merged[index], function) {
                        diagnostic := jet_driver_diagnostic("E3205", function.name_span, "overlay `{function.name}` disagrees with the generated binding", "user `#Import module c.{surface.library}` may override bindgen symbols, but the signature must stay compatible when replacing", "match the generated signature, or rename your overlay function")
                        if overlay_path != "" {
                            diagnostics.push(diagnostic_with_source_path(diagnostic, overlay_path, function.name_span.start))
                        } else {
                            diagnostics.push(diagnostic)
                        }
                    } else {
                        effect_root := merged[index].effect_root
                        merged[index] = function
                        if effect_root != None -> merged[index].effect_root = effect_root
                    }
                    break
                }
                index += 1
            }
            if !replaced -> merged.push(function)
            overlay_index += 1
        }
        prepared := jet_driver_foreign_prepare_functions(merged, handles, surface, &diagnostics)
        merged = prepared.functions
        boundary := None
        if surface.parsed_provenance != None -> boundary = Val(jet_driver_foreign_boundary(surface.parsed_provenance ?? next))
        if boundary != None {
            boundary_value :: boundary ?? next
            loop index in 0..<merged.len() {
                merged[index].effect_root = Val(boundary_value.effect_root)
            }
        }
        source_span := surface.cache_span
        if surface.overlay_span.start != 0 || surface.overlay_span.end != 0 -> source_span = surface.overlay_span
        rewritten := jet_driver_foreign_rewrite_module(&load, surface, merged, prepared.adapters, prepared.adapter_functions, &diagnostics)
        module :: rewritten ?? next
        providers.push(SemaForeignProviderInput{language: surface.language, module_identity: module.module_identity, library: surface.library, module_library: surface.module_library, source_span: source_span, handles: handles, close_adapters: prepared.adapters, boundary: boundary, direct_links: direct_links, transitive_links: transitive_links})
    }
    loop request in requests {
        if request.form == "item" -> next
        module_library := request.library
        loop surface in surfaces {
            if surface.language == request.language && surface.library == request.library && surface.root_index == request.root_index {
                module_library = surface.module_library
                break
            }
        }
        target_index := jet_driver_foreign_find_synthetic_module(&load, module_library, request.root_index)
        if target_index != None {
            target := load.modules[target_index ?? 0]
            jet_driver_foreign_add_import_edge(&load, request, target)
        }
    }
    jet_driver_foreign_remove_overlay_items(&load)
    provenance := jet_driver_collect_source_files(snapshot, load.source_units, load.modules, load.generated_source_files)
    load.source_files = provenance.files
    loop diagnostic in provenance.diagnostics -> diagnostics.push(diagnostic)
    loop diagnostic in diagnostics -> load.diagnostics.push(diagnostic)
    if !provenance.complete || jet_driver_has_errors(load.diagnostics) {
        load.complete = false
        if load.failed_stage == None -> load.failed_stage = Val(JetDriverStage.Load)
    } else {
        load.complete = true
        load.failed_stage = None
    }
    providers
}
