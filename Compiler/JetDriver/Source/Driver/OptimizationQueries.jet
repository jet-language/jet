// Selected source/profile/target projections over the production MIR producer.
// Live snapshots and replay receipts carry mir_decision_ledger_json and consume
// mir_decision_ledger_read; neither transport re-derives a decision from text.
use jet_foundation.[CanonicalPassRecord, MIRFunctionID, MIRSourceFileID, MIRLoopFact, MIRVectorFact, MIRAccelerationFact, MIRArtifactBuildMode, MIRDecisionRow, JetTargetLayout, jet_target_layout_from_machine]
use jet_optimizer.[MIRDecisionLedger, mir_decision_ledger]
use jet_foundation.[CanonicalPassOptions, CanonicalPassBoundaryGap, canonical_pass_boundary_gaps]

struct JetDriverAccelerationFunction {
    function: MIRFunctionID
    key: String
    name: String
    source_file: MIRSourceFileID
    source_path: String
    loops: [MIRLoopFact]
    vectors: [MIRVectorFact]
    accelerations: [MIRAccelerationFact]
}
struct JetDriverOptimizationQueryResult {
    compile: JetDriverCompileResult
    profile: String
    release_build: Bool
    target_triple: String
    target_layout: JetTargetLayout?
    functions: [JetDriverAccelerationFunction]
    decisions: MIRDecisionLedger?
    canonical_routes: [CanonicalPassRecord]
    canonical_route_gaps: [CanonicalPassBoundaryGap]
}
fn jet_driver_optimization_query(request: ^JetDriverCompileRequest) -> JetDriverOptimizationQueryResult {
    profile := request.profile
    release_build :: request.build_mode == MIRArtifactBuildMode.Release
    route_gaps := canonical_pass_boundary_gaps(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    selected := ^request
    selected.mode = JetDriverCompileMode.Doc
    compile :: jet_driver_compile_mir(^selected)
    canonical_routes := compile.canonical_routes
    target_triple := ""
    target_layout := JetTargetLayout?{None}
    functions := [JetDriverAccelerationFunction]{}
    decisions := MIRDecisionLedger?{None}
    if compile.complete && compile.internal_problem == None {
        program :: compile.mir ?? panic("completed optimization query lost its MIR")
        if program.facts.target_dossier.machine == .Val(machine) {
            target_triple = machine.triple
            target_layout = Val(jet_target_layout_from_machine(machine))
        }
        sources := [U64:String]{}
        loop file in program.source_files -> sources[file.id.value] = file.path
        ordered := program.functions.map(function -> function.id)
        keys := [U64:String]{}
        positions := [U64:Int]{}
        loop (index, function) in program.functions {
            keys[function.id.value] = function.key
            positions[function.id.value] = index
        }
        &ordered.sort_by((a, b) -> (keys[a.value] <=> keys[b.value]).then(a.value <=> b.value))
        loop identity in ordered {
            function :: program.functions[positions[identity.value]]
            &functions.push(JetDriverAccelerationFunction{function: function.id, key: function.key, name: function.name, source_file: function.source_file, source_path: sources.get(function.source_file.value) ?? "", loops: function.optimization.loop_facts, vectors: function.optimization.vector_facts, accelerations: function.optimization.acceleration_facts})
        }
        additional := [MIRDecisionRow]{}
        loop diagnostic in compile.diagnostics { if diagnostic.decision_row == .Val(row) -> &additional.push(row) }
        decisions = Val(mir_decision_ledger(program, compile.runtime_artifact, profile, "not-observed", additional))
    }
    JetDriverOptimizationQueryResult{compile: ^compile, profile: profile, release_build: release_build, target_triple: target_triple, target_layout: target_layout, functions: functions, decisions: decisions, canonical_routes: canonical_routes, canonical_route_gaps: route_gaps}
}
