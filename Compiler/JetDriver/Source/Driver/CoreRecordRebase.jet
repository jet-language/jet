// Rebasing the module indexes of the precompiled Core record's rows
// (CoreRecord.jet) into the graph that seeds them. A registration or module
// row names other modules by module index, which in the record is a module
// key's position (section 2). A graph that takes a record module gives it a
// graph module index, and the rebase maps one to the other. A taken body's
// DeclIDs, the rows of the record's declaration table (section 7), are
// sema's to rebase as it takes the body (JetSema CoreRecordBodies.jet
// sema_core_body_rebase_tree).
//
// The record writer runs the same module map the other way: the Core check's
// graph indexes become module key positions before a row is encoded.
use {
    jet_foundation.[Item, compiler_transfer_rows]
    jet_sema.[SemaRegistrationImport, SemaRegistrationModule]
}

// Module index `index` under the map `modules`. A row that names a module
// the map leaves out (-1) or doesn't hold can't be rebased.
jet_driver_core_record_rebase_module: fn(modules: [Int], index: Int) -> Int Err! {
    if index < 0 || index >= modules.len() -> return Err("a Core row names module {index}, but the record has {modules.len()} modules")
    mapped: modules[index]
    if mapped < 0 -> return Err("a Core row names module {index}, which this graph hasn't taken")
    Ok(mapped)
}

// Rebases the module indexes of `imports` under `modules`. A binding's
// target may be a module the map leaves out: it reads as not loaded (None),
// as registration leaves a namespace binding to a module it didn't load.
// Returns how many indexes it rebased.
jet_driver_core_record_rebase_imports: fn(imports: &[SemaRegistrationImport], modules: [Int]) -> Int Never! {
    rebased := 0
    loop import_index in 0..<imports.len() {
        loop binding_index in 0..<imports[import_index].bindings.len() {
            target: imports[import_index].bindings[binding_index].target_module_index ?? next
            mapped: if target >= 0 && target < modules.len() && modules[target] >= 0 -> Val(modules[target]) else -> None
            imports[import_index].bindings[binding_index].target_module_index = mapped
            rebased += 1
        }
    }
    rebased
}

// Rebases the module indexes of the registration module `module_row` under
// `modules`: its import bindings' targets and its namespace bindings. A
// namespace binding names a sibling declaration, so its module must be
// taken. Returns how many indexes it rebased.
jet_driver_core_record_rebase_registration: fn(module_row: &SemaRegistrationModule, modules: [Int]) -> Int Err! {
    rebased := jet_driver_core_record_rebase_imports(module_row.imports, modules)
    loop index in 0..<module_row.namespace_bindings.len() {
        owner: module_row.namespace_bindings[index].module_index
        mapped: jet_driver_core_record_rebase_module(modules, owner) ?? return Err("Core module `{module_row.module_name}`: {err}")
        module_row.namespace_bindings[index].module_index = mapped
        rebased += 1
    }
    Ok(rebased)
}

// The graph's seeds: the finalized row of each loaded module the Core record
// holds, in load order, rebased to the graph. Seeds take the graph's first
// indexes (sema_registration_prepare_graph), so record module `k` (of the
// record's `record_modules`) maps to its seed's position. Each row takes its
// loaded tree back, moved when the compile releases the loaded programs and
// copied when a later stage reads them again.
jet_driver_core_record_seeds: fn(modules: &[JetDriverLoadedModule], record_modules: Int, release_programs: Bool) -> [SemaRegistrationModule] Err! {
    graph_modules := [Int]{}
    loop _ in 0..<record_modules -> graph_modules.push(-1)
    seeds := [SemaRegistrationModule]{}
    loop index in 0..<modules.len() {
        position: modules[index].core_record_index
        if position < 0 -> next
        if position >= graph_modules.len() || graph_modules[position] >= 0 -> return Err("Core module `{modules[index].module_name}` loads record module {position}, which the record doesn't hold once")
        graph_modules[position] = seeds.len()
        seed := modules[index].core_registration.pop() ?? return Err("Core module `{modules[index].module_name}` loaded no registration row")
        if seed.module_identity != modules[index].module_identity -> return Err("Core module `{modules[index].module_name}` ({modules[index].module_identity}) loaded the registration row of {seed.module_identity}")
        if release_programs {
            // The items, the bulk of the tree, move; the rest is small.
            items := [Item]{}
            compiler_transfer_rows<Item>(items, modules[index].program.items)
            program := modules[index].program
            compiler_transfer_rows<Item>(program.items, items)
            seed.program = program.move()
        } else {
            seed.program = modules[index].program.copy()
        }
        seeds.push(seed.move())
    }
    loop index in 0..<seeds.len() {
        _: jet_driver_core_record_rebase_registration(seeds[index], graph_modules) ?? return Err(err)
    }
    Ok(seeds)
}
