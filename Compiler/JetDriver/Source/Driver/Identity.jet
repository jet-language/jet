pub struct JetDriverAuthorizedSourceFile {
    pub path: compiler_driver_os_path.OsPath
    pub relative_path: compiler_driver_os_path.OsPath
    pub identity: String
    pub source: String
    // Authority.rs:CheckedFile.bytes, retained from the checked descriptor.
    // Binary archive/runtime/worker inputs never pass through text decoding.
    pub bytes: [U8]?{None}
}

pub struct JetDriverAuthorizedSourceRoot {
    pub canonical_path: compiler_driver_os_path.OsPath
    pub identity: String
    pub allow_hardlinks: Bool
    pub files: [JetDriverAuthorizedSourceFile]
    pub foreign_cache_files: [JetDriverAuthorizedSourceFile]
}

pub struct JetDriverAuthorizedSourceSnapshot {
    pub roots: [JetDriverAuthorizedSourceRoot]
    pub entry_root_identity: String
    pub entry_path: compiler_driver_os_path.OsPath
}
// A query borrows the host-authorized roots and owns only its selected entry
// metadata. Overlay text travels beside this view, never inside a cloned request.
struct JetDriverAuthorizedSourceView {
    roots: View<JetDriverAuthorizedSourceRoot>
    entry_root_identity: String
    entry_path: compiler_driver_os_path.OsPath
}
fn jet_driver_authorized_source_view(snapshot: JetDriverAuthorizedSourceSnapshot, entry: compiler_driver_os_path.OsPath?) -> JetDriverAuthorizedSourceView Never! {
    selected_root := ~snapshot.entry_root_identity
    selected_path := ~snapshot.entry_path
    if entry == .Val(path) {
        // An unauthorized selection must fail validation, not check the old entry.
        selected_path = ~path
        loop root in snapshot.roots {
            loop file in root.files {
                if compiler_driver_os_path.equals(file.path, path) {
                    selected_root = ~root.identity
                    selected_path = ~file.path
                }
            }
        }
    }
    JetDriverAuthorizedSourceView{roots: snapshot.roots[0..<snapshot.roots.len()], entry_root_identity: selected_root, entry_path: selected_path}
}
fn jet_driver_source_view_entry_root_path(snapshot: JetDriverAuthorizedSourceView) -> compiler_driver_os_path.OsPath Never! {
    loop root in snapshot.roots {
        if root.identity == snapshot.entry_root_identity -> return root.canonical_path
    }
    compiler_driver_os_path.OsPath{encoded: [U8]{}, platform: snapshot.entry_path.platform}
}
// Empty-separator `after` is a full-buffer read window, not an owned text copy.
// #4303 remains the genuine borrowed-text/String read-call ABI gate.
fn jet_driver_source_view_text(file: JetDriverAuthorizedSourceFile, overlays: [compiler_driver_os_path.OsPath:String]) -> View<str> from file | overlays {
    if overlays.get(file.path) == .Val(text) {
        source :: text.after("")
        return source
    }
    source :: file.source.after("")
    return source
}

pub struct JetDriverHostFacts {
    pub target_triple: String?
    pub active_os: String?
    pub compiler_identity: String?
    // Original Loader defaults use the actual HOST, independent of --target.
    pub loader_host_os: MIROSTarget?
    pub loader_host_triple: String?
    // Rust build_stamp_for_facts: native authority captures/replays the lock
    // stamp before pure Driver resolution; absence is an internal input failure.
    pub build_stamp: BuildStamp?{None}
    // Exact Facts::TargetDossier selected/captured by native authority. None is
    // a missing producer, distinct from a dossier whose machine field is None.
    pub target_dossier: MIRTargetDossier?{None}
    pub organization_policy: JetDriverOrganizationPolicySource{JetDriverOrganizationPolicySource.Absent}
}

// Rust Loader::load_organization_policy raw authority result. `Absent` means
// no configured policy, never an unreadable/missing configured input.
pub enum JetDriverOrganizationPolicySource {
    Absent
    Loaded(file: JetDriverAuthorizedSourceFile)
    Unreadable(path: String, detail: String)
    MissingProvider(path: String)
}

pub enum JetDriverCompileTarget {
    Native
    Web(
        assets: JetWebAssets,
        release_devtools_policy: JetReleaseDevtoolsPolicy,
        profile: MIRArtifactBuildMode,
    )
}

// One Core library source module the host embeds, mirroring a Rust
// `CoreModuleExports::CORE_SOURCE_MODULES` row or a compiler-private part from
// `CoreSourceParts` (both generated from Prelude/Core.jet). `path` is the
// repository path (`Core/perf/perf.jet`); `owner` names the public module that
// schedules a private part and is "" for a public row; `owned_members` lists
// the public functions that have crossed the Core cutover.
pub struct JetDriverCoreSource {
    pub module_name: String
    pub alias: String
    pub path: String
    pub owner: String
    pub owned_members: [String]
    pub source: String
}

// Convert Foundation's canonical payload to the existing native request ABI.
// No host reads, empty rows or second metadata/source table.
pub fn jet_driver_embedded_core_sources(core: FoundationEmbeddedCore) -> [JetDriverCoreSource] Never! {
    sources := [JetDriverCoreSource]{}
    loop row in core.public_sources() {
        &sources.push(JetDriverCoreSource{module_name: ^row.module_name, alias: ^row.alias, path: ^row.path, owner: ^row.owner, owned_members: ^row.owned_members, source: ^row.source})
    }
    loop row in core.private_sources() {
        &sources.push(JetDriverCoreSource{module_name: ^row.module_name, alias: ^row.alias, path: ^row.path, owner: ^row.owner, owned_members: ^row.owned_members, source: ^row.source})
    }
    sources
}

// Command intent is independent of the entry's membership in a package.
pub enum JetDriverCheckScope { Project ExplicitFile }

pub struct JetDriverCompileRequest {
    pub authorized_sources: JetDriverAuthorizedSourceSnapshot
    pub canonical_effect_source: String
    pub core_sources: [JetDriverCoreSource]
    pub host_facts: JetDriverHostFacts
    pub eval_config: JetEvalConfig
    pub target: JetDriverCompileTarget
    pub check_scope: JetDriverCheckScope{JetDriverCheckScope.ExplicitFile}
    pub profile: String{"dev"}
    pub artifact_build: Bool{false}
    pub selected_output: String?{None}
    pub entry_function: String?{None}
    pub run_mode: Bool{false}
    pub semantic_index_requested: Bool{false}
    pub setting_overrides: [String:String]{[String:String]{}}
    // Rust seed_build_facts_with_contributions: compiled BuildPlan provider
    // publishes real typed writers here; no evaluator-global setting lookup.
    pub computed_setting_contributions: [FactContribution]{[FactContribution]{}}
    pub gates: GateSet{GateSet{bits: 0}}
    pub record_store: JetDriverRecordStore?
    // The host's streaming trace (`JET_TRACE_FILE`); `None` traces nothing.
    pub trace_sink: CompilerTraceSink?
    // Full verification: the optimizer re-verifies legality and runs MIR
    // Lint on the lowered program and the result of every pass, not only
    // legality on entry and Lint on the final program. Tests and `--verify`
    // turn it on; ordinary compiles leave it off.
    pub mir_lint_every_pass: Bool
}

// The compiler's record store, reached only through the host, which owns
// where records live. `schema` names the record kind (`jet.pkg-check/v1`,
// `jet.iface/v1`, ...). Action kinds are addressed by a computed key; blob
// kinds by the lowercase hex SHA-256 of their bytes. The host verifies the
// bytes and schema on both calls; a missing or unreadable record is `None`.
// `stamp` reports a file's (size, mtime, ctime, inode) stamp so an unchanged
// file can skip rehashing; a stamp never decides freshness.
pub trait JetDriverRecordStore {
    fn record(self, schema: String, key: String) -> [U8]?
    fn put_record(self, schema: String, key: String, bytes: [U8]) -> Bool
    fn stamp(self, path: String) -> String?
}

struct JetDriverSourceUnit {
    root_index: Int
    file_index: Int
    // Physical generated caches belong to the same checked root, not files[].
    foreign_cache_index: Int?{None}
    root_identity: String
    package_identity: String
    module_name: String
    // Original loaded namespace spelling, distinct from semantic Core name.
    alias: String
    // Rust bundle membership is decided at the actual loader constructor.
    bundle_module: Bool
    path: String
    physical_path: compiler_driver_os_path.OsPath?
    relative_path: String
    // Original native relative path, absent for generated/Core units.
    relative_os_path: compiler_driver_os_path.OsPath?
    source_segments: [SemaSourceSegment]
    source_origin: SemaSourceOrigin
    // Synthetic foreign declarations have empty LoadedModule source, while
    // their checked spans refer to a separately retained generated assembly.
    provenance_source_file: String?{None}
}

struct JetDriverPackageDependency {
    name: String
    source: String
    source_path: String
    span: Span?
    target_root_index: Int
}

struct JetDriverPackageEntry {
    module_alias: String?
    function_name: String
    source_path: String
    span: Span?
}

struct JetDriverPackageInfo {
    root_index: Int
    root_path: compiler_driver_os_path.OsPath
    identity: String
    name: String
    version: String
    edition: String
    runtime_ceiling: MIRRuntimeLayer?
    allocator_policy: MIRAllocatorPolicy
    authority_allow: [String]?
    authority_deny: [String]?
    authority_needs: [String]
    entry: JetDriverPackageEntry?
    manifest_path: String?
    dependencies: [JetDriverPackageDependency]
    // D-MOD-CYCLE1=A: the kinds the manifest's `outputs:` declare. A package
    // that declares a Library and no Executable has no `fn run` (E0625).
    outputs: JetDriverPackageOutputs
    // The sole PackageModel parser publishes the manifest's declarations.
    manifest_facts: PackageFacts?{None}
}

struct JetDriverPackageOutputs {
    library: Bool
    executable: Bool
    // Owner ruling B: each Executable `entry: stem.run` names a member file
    // whose `run` stays its own, so it never joins the package namespace.
    entry_modules: [String]
}

struct JetDriverSourceIndex {
    by_module_name: [String:Int]
    ambiguous_module_names: [String:Bool]
    by_path: [compiler_driver_os_path.OSPath:Int]
    generated_paths: [String:Int]
}

struct JetDriverSourceIndexResult {
    index: JetDriverSourceIndex
    diagnostics: [Diagnostic]
    complete: Bool
}

struct JetDriverSourceFileCollection {
    files: [MIRSourceFile]
    index: [compiler_driver_os_path.OsPath:Int]
    generated_index: [String:Int]
    physical_paths: [compiler_driver_os_path.OsPath]
    diagnostics: [Diagnostic]
    complete: Bool
}

struct JetDriverSourceCatalogResult {
    packages: [JetDriverPackageInfo]
    source_units: [JetDriverSourceUnit]
    entry_package_identity: String
    diagnostics: [Diagnostic]
    complete: Bool
}

pub enum JetDriverStage { Collect Parse Load Check Comptime Lower Assemble Pass Emit }

// Driver-only identity/provenance. No AST or second loaded-program owner.
pub struct JetDriverModuleFacts {
    pub source_unit_index: Int
    pub source_identity: String
    pub package_identity: String
    pub module_identity: String
    pub module_name: String
    pub bundle_index: Int?
    parse_metadata: JetDriverParseMetadata
}

struct JetDriverCompileTrace {
    stdout: [String]
    stderr: [String]
    soft_stop: Bool
    exit_code: Int?
}

pub struct JetDriverLoadResult {
    pub bundle: Shared<ProgramBundle>
    // Actual selected authority root; bundle.project_root uses the same path.
    pub project_root: compiler_driver_os_path.OSPath
    pub package_identity: String
    packages: [JetDriverPackageInfo]
    source_units: [JetDriverSourceUnit]
    pub entry_source_identity: String
    pub entry_module_identity: String
    pub modules: [JetDriverModuleFacts]
    imports: [SemaRegistrationImportEdge]
    package_namespaces: [String:compiler_driver_os_path.OSPath]{[String:compiler_driver_os_path.OSPath]{}}
    pub source_files: [MIRSourceFile]
    pub source_file_index: [compiler_driver_os_path.OSPath:Int]{[compiler_driver_os_path.OSPath:Int]{}}
    pub generated_source_file_index: [String:Int]{[String:Int]{}}
    pub physical_source_paths: [compiler_driver_os_path.OSPath]{[compiler_driver_os_path.OSPath]{}}
    pub generated_source_files: [MIRSourceFile]
    pub diagnostics: [Diagnostic]
    organization_policy: [PolicyDeclaration]?{None}
