struct JetDriverAuthorizedSourceFile {
    path: String
    relative_path: String
    identity: String
    source: String
}

struct JetDriverAuthorizedSourceRoot {
    canonical_path: String
    identity: String
    allow_hardlinks: Bool
    files: [JetDriverAuthorizedSourceFile]
    foreign_cache_files: [JetDriverAuthorizedSourceFile]
    directories: [AppAuthorizedDirectory]{[AppAuthorizedDirectory]{}}
}

// An offline script admission binds an import to an already opened root.
// The selector and full tree hash remain distinct from package manifests.
struct JetDriverScriptDependency {
    name: String
    selector: String
    resolved_version: String
    content_hash: String
    root_identity: String
    span: Span
}

struct JetDriverAuthorizedSourceSnapshot {
    roots: [JetDriverAuthorizedSourceRoot]
    entry_root_identity: String
    entry_path: String
    script_dependencies: [JetDriverScriptDependency]{[JetDriverScriptDependency]{}}
}

struct JetDriverHostFacts {
    target_triple: String?
    active_os: String?
    compiler_identity: String?
}

enum JetDriverCompileTarget {
    Native
    Web(
    assets: JetWebAssets,
    release_devtools_policy: JetReleaseDevtoolsPolicy,
    profile: MIRArtifactBuildMode,
    )
    // `--target=sandbox` the entry module's `pub fn` rows
    // become a WASM Component guest. `export_name` is the manifest `export:`
    // name (the package name when absent); `frozen_interfaces` are the texts
    // of the `.jet/cache/api/plugin__*.api` snapshots the host read (the
    // compile diffs against the one whose `package` is `plugin__<name>`, since
    // only the compile resolves the name); the guest embeds `timezone_data`
    // because a sandbox has no host filesystem.
    Sandbox(
    export_name: String?,
    frozen_interfaces: [String],
    timezone_data: [JetWebTimezoneAsset],
    )
}

// Rust `CompileMode`: `Program` compiles a package for check, build, or run
// (its artifact starts at the package entry); `Test` compiles the `jet test`
// harness: named `#Test` bodies are checked and lowered, E0601 reports a file
// with none, and the artifact is a TestExecutable whose harness runs them.
// `Doc` compiles as `Program` does and also keeps each user module's checked
// declarations (`JetDriverDocModule`) for `jet doc`.
// `Comptime` checks the program and runs its build-time values through the
// canonical comptime stage (checked, lowered to MIR, evaluated by JetEval),
// then stops: nothing is lowered or emitted for run time. Config surfaces
// (Jetpack EnvModel) evaluate their typed values this way.
// `Eval` and `Interpreter` produce the same checked MIR for canonical JetEval,
// without AOT emission. Eval checks the selected root's transitive pure row;
// Interpreter leaves effects to its runtime authorizer (REPL turns).
enum JetDriverCompileMode {
    Program
    Test
    Doc
    Comptime
    Eval
    Interpreter
    Repl
}

// One user module of the checked bundle as `jet doc` and the semantic index
// read it (Rust `ProgramModule`: `alias`, `source`, the post-sema
// `items`, and `block_spans`, so derived impls and inferred failure contracts
// are the ones the checker settled). `path` is the module's display path:
// relative to the entry root when beneath it, which is the stable path
// `jet doc` prints; `physical_path` is the snapshot file's canonical path,
// which machine reports name. `module_name`, `functions`, `name_references`,
// and `call_facts` are the module's checked rows (Rust `SemIndexEffectFacts`
// summaries and the name ledger's references).
struct JetDriverDocModule {
    path: String
    physical_path: String
    alias: String
    source: String
    items: [Item]
    block_spans: [Span]{[Span]{}}
    imports: [ImportDecl]{[ImportDecl]{}}
    module_name: String{""}
    functions: [TFunc]{[TFunc]{}}
    name_references: [SemaNameReferenceFact]{[SemaNameReferenceFact]{}}
    call_facts: [SemaCallSiteFact]{[SemaCallSiteFact]{}}
    // Shared once per checked bundle; module positions retain Sema's ordering.
    name_ledger: Shared<NameLedger>?{None}
    gate_ledger: Shared<GateLedger>?{None}
    memory_facts: Shared<SemaCheckedMemoryFacts>?{None}
    module_identity: String{""}
    target_triple: String{""}
    target_layout: JetTargetLayout?{None}
    layout_facts: [SemaLayoutProjectionRow]{[SemaLayoutProjectionRow]{}}
    name_module_index: Int{-1}
}

// One Core library source module the host embeds (a CORE_SOURCE_OWNED_ROWS
// row): a public `source_module` of Prelude/Core.jet, a compiler-private
// part of Prelude/CoreSourceParts.tsv, or a private runtime unit. `path` is the repository path;
// `owner` schedules private parts, and `owned_members` selects the public
// functions that crossed the Core cutover. Runtime units retain every function
// and may import other runtime units; only an exact runtime entry keeps tests.
struct JetDriverCoreSource {
    module_name: String
    alias: String
    path: String
    owner: String
    owned_members: [String]
    runtime: Bool
    source: String
}

// Selected build output is compiler-produced source, never a fabricated
// authorized disk file. The loader keeps its exact bytes and virtual origin.
struct JetDriverGeneratedModule {
    package_identity: String
    name: String
    relative_path: String
    source: String
}

struct JetDriverCompileRequest {
    authorized_sources: JetDriverAuthorizedSourceSnapshot
    canonical_effect_source: String
    core_sources: [JetDriverCoreSource]
    host_facts: JetDriverHostFacts
    eval_config: JetEvalConfig
    target: JetDriverCompileTarget
    record_store: JetDriverRecordStore?
    // Captured snapshots override the canonical project schema cache; absence
    // reads that cache once through the same ordinary populated checker.
    schema_snapshots: [String:SchemaSnapshot]?{None}
    // The host's streaming trace (`JET_TRACE_FILE`); `None` traces nothing.
    trace_sink: CompilerTraceSink?
    // Full verification: the optimizer re-verifies legality and runs MIR
    // Lint on the lowered program and the result of every pass, not only
    // legality on entry and Lint on the final program. Tests and `--verify`
    // turn it on; ordinary compiles leave it off.
    mir_lint_every_pass: Bool
    // The compiler threads this compile may use (`--threads N`;
    // automatic, memory-aware admission without it). Every thread count gives
    // the same diagnostics and output bytes.
    compiler_threads: CompilerThreads
    mode: JetDriverCompileMode{JetDriverCompileMode.Program}
    // Selection is separate from compilation/lowering mode: checking validates
    // all links/defaults; running selects one address; testing selects Checks.
    output_intent: SemaOutputIntent{SemaOutputIntent.Check}
    output_address: String?{None}
    gate_set: GateSet{GateSet{}}
    gate_policies: [JetDriverGatePolicy]{[JetDriverGatePolicy]{}}
    // External lock/trust/forced-build writers use the canonical gate row.
    external_gate_entries: [GateEntry]{[GateEntry]{}}
    // Explicit callable shared by named jobs, generation and evaluation.
    selected_entry: String?{None}
    profile: String{"dev"}
    build_mode: MIRArtifactBuildMode{MIRArtifactBuildMode.Dev}
    adapter_mode: String{""}
    adapter_operation_ids: [String]{[String]{}}
    capture_build_program: Bool{false}
    capture_build_nodes: Bool{false}
    build_output_names: [String]{[String]{}}
    capture_cost_report: Bool{false}
    generated_modules: [JetDriverGeneratedModule]{[JetDriverGeneratedModule]{}}
    // Raw transports remain distinct from ordinary comptime IO.
    build_inputs: JetDriverSharedBuildInputs?{None}
    build_http_inputs: JetDriverSharedBuildHTTPInputs?{None}
    // When set, every Tier-1 comptime input this compile reads (path and
    // SHA-256), in read order, for the comptime input lock.
    comptime_input_log: Shared<JetDriverComptimeInputLog>?{None}
    execution_host: JetDriverExecutionHost?{None}
    // Unified host/stop contract (#4720): the comptime lowering session
    // produces MIR stop points (Poll/Stopped and the budget can-stop rows)
    // only for a native execution host. Compile-time code runs in the
    // in-process evaluator until native in-memory O0 lands, and the evaluator
    // refuses stop points, so every compile leaves it off.
    comptime_stop_points: Bool{false}
    // Ordinary native Program/Test/Doc artifacts use returning-stop MIR.
    // This is independent of the comptime stop points above; evaluator, Rust
    // emission and library assembly leave it disabled.
    native_stop_points: Bool{false}
}

struct JetDriverGatePolicy {
    package_identity: String
    declarations: [PolicyDeclaration]{[PolicyDeclaration]{}}
    unsafe_paths: [String]?{None}
    expert: Bool?{None}
}

// The compiler's record store, reached only through the host, which owns
// where records live. `schema` names the record kind (`jet.pkg-check/v1`,
// `jet.iface/v1`, ...). Action kinds are addressed by a computed key; blob
// kinds by the lowercase hex SHA-256 of their bytes. The host verifies the
// bytes and schema on both calls; a missing or unreadable record is `None`.
// `stamp` reports a file's (size, mtime, ctime, inode) stamp so an unchanged
// file can skip rehashing; a stamp never decides freshness. The host reads and
// writes the store's files, so each call declares that row (an undeclared
// dynamic dispatch is the maximal row).
trait JetDriverRecordStore {
    fn record(self, schema: String, key: String) -[FS]> [U8]?
    fn put_record(self, schema: String, key: String, bytes: [U8]) -[FS]> Bool
    fn stamp(self, path: String) -[FS]> String?
}

// One compiler-process-owned native child, shared by comptime and REPL.
// The CLI owns lifetime, sandbox and artifact admission; the compiler sends
// only a checked selected callable. This is not a user plugin API.
// Bounds describe the host's raw C/Asm child transport and serialization,
// not the selected program's ambient authority (checked before admission).
trait JetDriverExecutionHost {
    fn execute(self, request: X64ExecutionRequest) -[Exec, IO, FFI.C, FFI.Asm, Time.Wait]> X64ExecutionResponse
    fn session_resource(self) -[]> X64ExecutionHost Never!
    fn register_closure_sources(self, snapshot: String, sources: [JetCodegenClosureSource]) Never! -[Time.Wait]>
    fn closure_source(self, snapshot: String, function: MIRFunctionID) -[Time.Wait]> JetCodegenClosureSource? Never!
}

// The raw build-input transport a host supplies for checked `fn build` input
// services (`b.find`, `b.embed`, and `b.fetch` of a `file://` URL). It
// answers raw filesystem facts only: where an absolute path resolves, one
// directory's entries described without following links, and a bounded read
// that refuses a final link. Path law, glob matching, pin checks, decoding
// and every diagnostic stay in the build adapter; an error is the host's
// own text for the failed operation.
#Error
struct JetDriverBuildInputError {
    message: String
}

trait JetDriverBuildInputs {
    fn resolve(self, path: String) -[FS.Read]> JetDriverBuildPath JetDriverBuildInputError!
    fn entries(self, directory: String) -[FS.Read]> [JetDriverBuildEntry] JetDriverBuildInputError!
    fn read(self, path: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError!
    // Open each component relative to one retained root with nofollow; read
    // the same opened regular file, bounded before and during the read.
    fn read_rooted(self, root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError!
}

// A single raw HTTP GET. No redirects, status interpretation, digest checks
// or decoding occur here; Jet owns those rules. Timeout and body bound are
// supplied by the checked-build consumer, not chosen by a provider.
#Error
struct JetDriverBuildHTTPError {
    message: String
}

trait JetDriverBuildHTTPInputs {
    fn resolve(self, host: String, port: Int) -[Net, Time.Wait]> [[U8]] JetDriverBuildHTTPError!
    fn get(self, url: String, addresses: [[U8]], port: Int, timeout_ms: Int, limit: Int) -[Net, Time.Wait]> JetDriverBuildHTTPResponse JetDriverBuildHTTPError!
}

// The invocation owns each raw transport once. Adapter clones share that
// same authority cell; they never duplicate or mint a raw host trait value.
struct JetDriverBuildInputsStorage { transport: JetDriverBuildInputs }
struct JetDriverSharedBuildInputs {
    storage: Shared<JetDriverBuildInputsStorage>
    fn resolve(self, path: String) -[FS.Read]> JetDriverBuildPath JetDriverBuildInputError! {
        permit :: self.storage.guard_read()
        permit.value.transport.resolve(path)
    }
    fn entries(self, directory: String) -[FS.Read]> [JetDriverBuildEntry] JetDriverBuildInputError! {
        permit :: self.storage.guard_read()
        permit.value.transport.entries(directory)
    }
    fn read(self, path: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
        permit :: self.storage.guard_read()
        permit.value.transport.read(path, limit)
    }
    fn read_rooted(self, root: String, relative: String, limit: Int) -[FS.Read]> [U8] JetDriverBuildInputError! {
        permit :: self.storage.guard_read()
        permit.value.transport.read_rooted(root, relative, limit)
    }
}
fn jet_driver_shared_build_inputs(transport: ^JetDriverBuildInputs) -> JetDriverSharedBuildInputs Never! {
    JetDriverSharedBuildInputs{storage: shared JetDriverBuildInputsStorage{transport: ^transport}}
}
struct JetDriverBuildHTTPInputsStorage { transport: JetDriverBuildHTTPInputs }
struct JetDriverSharedBuildHTTPInputs {
    storage: Shared<JetDriverBuildHTTPInputsStorage>
    fn resolve(self, host: String, port: Int) -[Net, Time.Wait]> [[U8]] JetDriverBuildHTTPError! {
        permit :: self.storage.guard_read()
        permit.value.transport.resolve(host, port)
    }
    fn get(self, url: String, addresses: [[U8]], port: Int, timeout_ms: Int, limit: Int) -[Net, Time.Wait]> JetDriverBuildHTTPResponse JetDriverBuildHTTPError! {
        permit :: self.storage.guard_read()
        permit.value.transport.get(url, addresses, port, timeout_ms, limit)
    }
}
fn jet_driver_shared_build_http_inputs(transport: ^JetDriverBuildHTTPInputs) -> JetDriverSharedBuildHTTPInputs Never! {
    JetDriverSharedBuildHTTPInputs{storage: shared JetDriverBuildHTTPInputsStorage{transport: ^transport}}
}
struct JetDriverBuildHTTPResponse {
    status: Int
    headers: [[U8]]
    body: [U8]
}

// Where an absolute path resolves with every link followed (`exists` false
// when it names nothing), and what it is there.
struct JetDriverBuildPath {
    exists: Bool
    path: String
    file: Bool
    links: Int
}

// One directory entry, described without following a link.
struct JetDriverBuildEntry {
    name: String
    directory: Bool
    file: Bool
}

struct JetDriverSourceUnit {
    root_index: Int
    file_index: Int
    root_identity: String
    package_identity: String
    module_name: String
    path: String
    relative_path: String
    source_segments: [SemaSourceSegment]
    source_origin: SemaSourceOrigin
    // A file of a `package.jet` package shares its package's
    // namespace. Loose files, one-file (inline Package) packages, embedded
    // Core sources, and synthetic modules have none.
    in_namespace: Bool
}

struct JetDriverPackageDependency {
    name: String
    source: String
    source_path: String
    span: Span?
    target_root_index: Int
    script_version: String?{None}
}

struct JetDriverPackageEntry {
    module_alias: String?
    function_name: String
    source_path: String
    span: Span?
}

struct JetDriverPackageInfo {
    root_index: Int
    root_path: String
    identity: String
    name: String
    version: String?
    edition: String
    runtime_ceiling: MIRRuntimeLayer?
    allocator_policy: MIRAllocatorPolicy
    authority_allow: [String]?
    authority_deny: [String]?
    authority_needs: [String]
    entry: JetDriverPackageEntry?
    manifest_path: String?
    // The canonical Package policy reader's declarations; their source is the
    // physical manifest/carrier path, not the module's display path.
    policy_declarations: [PolicyDeclaration]{[PolicyDeclaration]{}}
    policy_unsafe_paths: [String]?{None}
    policy_expert: Bool?{None}
    // The Package comes from a leading inline `package { … }` block (its
    // carrier file is `manifest_path`), not from `package.jet`.
    inline_package: Bool
    // Manifest inputs compose package facts, never ordinary source bindings.
    configs: [String]
    dependencies: [JetDriverPackageDependency]
    // The kinds the manifest's `outputs:` declare. A package
    // that declares a Library and no Executable has no `fn run` (E0625).
    outputs: JetDriverPackageOutputs
}

struct JetDriverPackageOutputs {
    library: Bool
    executable: Bool
    // Owner ruling B: each Executable `entry: stem.run` names a member file
    // whose `run` stays its own, so it never joins the package namespace.
    entry_modules: [String]
}

struct JetDriverSourceIndex {
    by_identity: [String:Int]
    by_module_name: [String:Int]
    ambiguous_module_names: [String:Bool]
    by_path: [String:Int]
}

struct JetDriverSourceIndexResult {
    index: JetDriverSourceIndex
    diagnostics: [Diagnostic]
    complete: Bool
}

struct JetDriverSourceFileCollection {
    files: [MIRSourceFile]
    diagnostics: [Diagnostic]
    complete: Bool
}

struct JetDriverSourceCatalogResult {
    packages: [JetDriverPackageInfo]
    source_units: [JetDriverSourceUnit]
    entry_package_identity: String
    diagnostics: [Diagnostic]
    complete: Bool
}

enum JetDriverStage {
    Collect
    Parse
    Load
    Check
    Comptime
    Lower
    Assemble
    Pass
    Emit
}

struct JetDriverLoadedModule {
    source_unit_index: Int
    source_identity: String
    package_identity: String
    module_identity: String
    module_name: String
    program: Program
    // (jet_driver_bind_package_namespaces): the package
    // namespace of a member file ("" outside one), the names it contributes
    // in declaration order, and the names of other members its source can
    // reach (jet_driver_namespace_reach).
    namespace: String{""}
    namespace_names: [String]{[String]{}}
    namespace_refs: [String]{[String]{}}
}

struct JetDriverCompileTrace {
    stdout: [String]
    stderr: [String]
    soft_stop: Bool
    exit_code: Int?
}

enum JetDriverLoadMode {
    Program
    CoreLibrary
}

struct JetDriverLoadResult {
    package_identity: String
    packages: [JetDriverPackageInfo]
    source_units: [JetDriverSourceUnit]
    entry_source_identity: String
    entry_module_identity: String
    modules: [JetDriverLoadedModule]
    imports: [SemaRegistrationImportEdge]
    source_files: [MIRSourceFile]
    generated_source_files: [MIRSourceFile]
    diagnostics: [Diagnostic]
    failed_stage: JetDriverStage?
    complete: Bool
    mode: JetDriverLoadMode{JetDriverLoadMode.Program}
    // Canonical parser/load facts, available without checking callable bodies.
    names: NameLedger?{None}
    // `JetDriverCompileMode.Doc`: the checked user modules, in load order.
    doc_modules: [JetDriverDocModule]{[JetDriverDocModule]{}}
    build_program: TComptimeValue?{None}
    build_nodes: [BuildGraphNode]?{None}
}

// The entry package's written authority policy, for the host's application
// authority check (Source/CmdCompile.rs `resolve_application_authority`).
// `manifest_path` is None for a file with no `package.jet`; `allow`/`deny`
// are None when the manifest writes no `authority.holds` row.
struct JetDriverAuthorityPolicy {
    manifest_path: String?
    allow: [String]?
    deny: [String]?
}

struct JetDriverCompileResult {
    diagnostics: [Diagnostic]
    generated_source_files: [MIRSourceFile]
    package_identity: String
    entry_module_identity: String
    entry_function: MIRFunctionID?
    runtime_artifact: MIRArtifactID?
    web_artifact: MIRArtifactID?
    web_artifacts: JetWebArtifacts?
    mir: MIRProgram?
    emitted_source: String?
    emit_manifest: JetRustEmitManifest?
    comptime_stdout: String
    comptime_stderr: String
    soft_stop: Bool
    exit_code: Int?
    failed_stage: JetDriverStage?
    complete: Bool
    internal_problem: String?
    // JET_KEEP_GOING (jet_driver_compile_keep_going): every failure the
    // compile recorded, one TSV row each: phase, item, code, message, span.
    keep_going_rows: [String]{[String]{}}
    authority_policy: JetDriverAuthorityPolicy?{None}
    // `JetDriverCompileMode.Doc`: the checked user modules, in load order.
    doc_modules: [JetDriverDocModule]{[JetDriverDocModule]{}}
    // `JetDriverCompileMode.Doc` that fails after registration: the structure
    // facts the registration graph already proved (Sema
    // `sema_name_structure_facts`), so `jet inspect structure` prints them
    // ahead of the failure diagnostics. A complete Doc compile carries the
    // same rows in its modules' NameLedger instead; other modes leave this empty.
    structure_facts: [MIRStructureFact]{[MIRStructureFact]{}}
    // `JetDriverCompileMode.Comptime`: every build-time value the comptime
    // stage produced, constants included. Empty in the other modes.
    comptime_values: [SemaComptimeItemValue]{[SemaComptimeItemValue]{}}
    // A Repl compile retains its checked scope and canonical MIR machine.
    repl_session: ReplSession?{None}
    // A complete `Sandbox` compile: the guest artifacts plus the interface
    // snapshot the host stores as the new frozen baseline.
    sandbox: JetDriverSandboxOutput?{None}
    canonical_routes: [CanonicalPassRecord]{[CanonicalPassRecord]{}}
    build_program: TComptimeValue?{None}
    build_nodes: [BuildGraphNode]?{None}
    cost_report: TCostReport?{None}
    cost_gaps: [String]{[String]{}}
    // Checked signature facts retain helper identity order. Realization for
    // check/run/build is a CLI host action, never a compiler process probe.
    rust_foreign: JetDriverRustForeignFacts{jet_driver_rust_foreign_empty()}
    // The request's trace sink, handed back by the host's compile
    // (JetCli Request.jet `jet_cli_compile_for_target`) so the host's own
    // phases after it (the native backend route) trace through the same sink.
    trace_sink: CompilerTraceSink?{None}
    // The request's compiler threads, handed back by the host's compile
    // (JetCli Request.jet `jet_cli_compile_for_target`) so the native backend
    // route after it compiles on the same threads.
    compiler_threads: CompilerThreads{compiler_threads_single()}
}

struct JetDriverSandboxOutput {
    artifacts: JetPluginArtifacts
    // `plugin__<export name>`: the `.jet/cache/api/<package>.api` file stem.
    snapshot_package: String
    snapshot_text: String
}

// The compiler-internal all-phases diagnostic mode (`JET_KEEP_GOING=1`, read
// by the bootstrap entry). Its output is never shipped: a failed item is
// recorded and replaced by a typed trap so every later phase still runs.
struct JetDriverKeepGoing {
    // Traps an earlier run asked for after it crashed inside one function,
    // `<phase>:<name>@<position>`: `lower` positions index the lowering
    // list, `emit` positions the optimized program's functions (the
    // `index` of the trace's `lower.function`/`emit.function` spans).
    skip: [String]
}

fn jet_driver_source_identity(package_identity: String, path: String) -> String Never! {
    "source:{package_identity.len()}:{package_identity}:{path}"
}

fn jet_driver_module_identity(package_identity: String, path: String) -> String Never! {
    "module:{package_identity.len()}:{package_identity}:{path}"
}

fn jet_driver_source_segments(path: String, source: String) -> [SemaSourceSegment] Never! {
    bytes :: source.bytes()
    line_starts := [Int]{0}
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
    }
    [SemaSourceSegment{generated: Span{start: 0, end: bytes.len()}, source_file: path, source_start: 0, line_starts: line_starts, origin: SemaSourceOrigin.Snapshot}]
}

// The path a checked source carries through the compile: its source and
// module identity, MIR source file, panic locations, and diagnostic keys. A
// file beneath the entry root is named relative to that root, and a file
// outside it (a path dependency beside the entry package) relative to the
// root through `..` segments, so compiler output never depends on where the
// project is checked out. A relative path is returned unchanged.
fn jet_driver_display_path(entry_root: String, path: String) -> String Never! {
    // copy: the display path is a new owned String. With no entry root it equals `path`, a read
    // parameter that the caller keeps (a source-file row), so the result needs its own text.
    if entry_root.len() == 0 -> return path.copy()
    if path == entry_root -> return ""
    prefix :: if entry_root.ends_with("/") -> entry_root else -> "{entry_root}/"
    if path.starts_with(prefix) -> return path.slice(prefix.len(), path.len())
    // copy: a path the entry root cannot name relatively stays as the caller's text.
    if !path.starts_with("/") || !entry_root.starts_with("/") -> return path.copy()
    root_parts :: jet_driver_path_segments(entry_root)
    path_parts :: jet_driver_path_segments(path)
    common := 0
    loop common < root_parts.len() && common < path_parts.len() && root_parts[common] == path_parts[common] -> common += 1
    parts := [String]{}
    loop _ in common..<root_parts.len() -> &parts.push("..")
    loop index in common..<path_parts.len() -> &parts.push(path_parts[index])
    parts.join("/")
}

// The non-empty `/`-separated segments of a path.
fn jet_driver_path_segments(path: String) -> [String] Never! {
    segments := [String]{}
    loop segment in path.split("/").to_list() {
        if segment.len() > 0 -> &segments.push(segment)
    }
    segments
}

// The canonical path a display path names (the inverse of
// `jet_driver_display_path`); authority checks compare physical paths.
fn jet_driver_physical_path(entry_root: String, display: String) -> String Never! {
    // copy: the physical path is a new owned String. For an absolute display it equals `display`, a
    // read parameter that the caller keeps, so the result needs its own text.
    if entry_root.len() == 0 || display.starts_with("/") -> return display.copy()
    // copy: the physical path is a new owned String. For an empty display it equals `entry_root`, a
    // read parameter that the caller keeps, so the result needs its own text.
    if display.len() == 0 -> return entry_root.copy()
    if !display.starts_with("../") -> return if entry_root.ends_with("/") -> "{entry_root}{display}" else -> "{entry_root}/{display}"
    parts := jet_driver_path_segments(entry_root)
    loop segment in jet_driver_path_segments(display) {
        if segment != ".." {
            &parts.push(segment)
        } else if parts.len() > 0 {
            _ := &parts.pop()
        }
    }
    joined :: parts.join("/")
    "/{joined}"
}

// The canonical path of the snapshot's entry root, or "" when it names none.
fn jet_driver_entry_root_path(snapshot: JetDriverAuthorizedSourceSnapshot) -> String Never! {
    loop root in snapshot.roots {
        if root.identity == snapshot.entry_root_identity -> return root.canonical_path
    }
    ""
}

fn jet_driver_diagnostic(code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic_from_registry(code, Val(span), what, why, fix)
}

fn jet_driver_diagnostic_without_span(code: String, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic_from_registry(code, None, what, why, fix)
}

// A diagnostic worded entirely by its registry row (Rust
// `Diagnostic::from_row` with no holes).
fn jet_driver_row_diagnostic(code: String, span: Span?) -> Diagnostic {
    row :: diagnostic_registry_row(code) ?? panic("diagnostic `{code}` has no generated Source registry row")
    diagnostic_from_registry(code, span, row.what, row.why, row.fix)
}

fn jet_driver_diagnostic_with_optional_span(code: String, span: Span?, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic_from_registry(code, span, what, why, fix)
}

fn jet_driver_diagnostic_at_source(code: String, span: Span?, source_path: String, aggregate_source_offset: Int, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic :: diagnostic_from_registry(code, span, what, why, fix)
    diagnostic_with_source_path(^diagnostic, source_path, aggregate_source_offset)
}

fn jet_driver_lint_diagnostic_at_source(code: String, span: Span?, source_path: String, aggregate_source_offset: Int, what: String, why: String, fix: String) -> Diagnostic {
    diagnostic :: diagnostic_from_registry(code, span, what, why, fix)
    diagnostic_with_source_path(^diagnostic, source_path, aggregate_source_offset)
}

fn jet_driver_module_index_key(package_identity: String, module_name: String) -> String Never! {
    "{package_identity.len()}:{package_identity}:{module_name}"
}

fn jet_driver_build_source_index(source_units: [JetDriverSourceUnit]) -> JetDriverSourceIndexResult {
    by_identity := [String:Int]{}
    by_module_name := [String:Int]{}
    ambiguous_module_names := [String:Bool]{}
    by_path := [String:Int]{}
    diagnostics := [Diagnostic]{}
    loop (index, unit) in source_units {
        identity :: jet_driver_source_identity(unit.package_identity, unit.path)
        module_key :: jet_driver_module_index_key(unit.package_identity, unit.module_name)
        valid := true
        if unit.package_identity.len() == 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source unit has no package identity", "module identities must be scoped to the package selected by the loader", "resolve the package identity from its authorized manifest"))
            valid = false
        }
        if unit.module_name.len() == 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source unit has no module identity", "every loaded source belongs to one named module", "derive a module name from the checked source path"))
            valid = false
        }
        if unit.path.len() == 0 || unit.relative_path.len() == 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source unit has no canonical path", "source identity and diagnostics require a stable path inside one authority root", "supply the canonical path and root-relative path selected by the native authority adapter"))
            valid = false
        }
        if by_identity.get(identity) != None {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0105", "the source unit identity is duplicated", "one package path identifies exactly one source unit", "remove the duplicate source unit"))
            valid = false
        }
        if by_path.get(unit.path) != None {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0105", "the canonical source path is duplicated", "one path identifies exactly one checked source record", "keep only one source record for this canonical path"))
            valid = false
        }
        if valid {
            _ := &by_identity.add(identity, index)
            _ := &by_path.add(unit.path, index)
            if {
                by_module_name.get(module_key) != None -> {
                    _ := &ambiguous_module_names.add(module_key, true)
                }
                else -> _ := &by_module_name.add(module_key, index)
            }
        }
    }
    complete :: diagnostics.len() == 0
    JetDriverSourceIndexResult{
        index: JetDriverSourceIndex{
            by_identity: by_identity,
            by_module_name: by_module_name,
            ambiguous_module_names: ambiguous_module_names,
            by_path: by_path,
        },
        diagnostics: diagnostics,
        complete: complete,
    }
}

// The Receipt closure for one driver request. The host
// store keys a recorded outcome (typed diagnostics, artifact digest) by this
// digest. It frames the verb, the host's compiler identity and target, every
// option that changes what the verb checks, and each authorized source's
// root identity, root-relative path, and SHA-256 of its exact bytes. Equal
// digests mean the recorded diagnostics are this request's diagnostics.
struct JetDriverReceipt {
    closure: String
    diagnostics: [Diagnostic]
}

fn jet_driver_receipt_field(label: String, value: String) -> String Never! {
    "{label.len()}:{label}{value.len()}:{value}"
}

fn jet_driver_receipt_closure(verb: String, request: JetDriverCompileRequest, options: [String]) -> String Never! {
    compiler :: request.host_facts.compiler_identity ?? ""
    target :: request.host_facts.target_triple ?? ""
    closure := jet_driver_receipt_field("schema", "jet.receipt-closure/v1")
    verb_field :: jet_driver_receipt_field("verb", verb)
    compiler_field :: jet_driver_receipt_field("compiler", compiler)
    target_field :: jet_driver_receipt_field("target", target)
    entry_field :: jet_driver_receipt_field("entry", request.authorized_sources.entry_path)
    closure = "{closure}{verb_field}{compiler_field}{target_field}{entry_field}"
    loop option in options {
        option_field :: jet_driver_receipt_field("option", option)
        closure = "{closure}{option_field}"
    }
    loop root in request.authorized_sources.roots {
        root_field :: jet_driver_receipt_field("root", root.identity)
        closure = "{closure}{root_field}"
        loop file in root.files {
            path_field :: jet_driver_receipt_field("module", file.relative_path)
            digest_field :: jet_driver_receipt_field("sha256", mir_sha256_hex(file.source))
            closure = "{closure}{path_field}{digest_field}"
        }
    }
    loop dependency in request.authorized_sources.script_dependencies {
        closure = "{closure}{jet_driver_script_dependency_identity(dependency)}"
    }
    mir_sha256_hex(closure)
}

// A recorded Receipt answers the request only when its closure is the
// request's closure; anything else checks fresh.
fn jet_driver_receipt_answers(receipt: JetDriverReceipt, verb: String, request: JetDriverCompileRequest, options: [String]) -> Bool Never! {
    receipt.closure == jet_driver_receipt_closure(verb, request, options)
}

fn jet_driver_script_dependency_identity(dependency: JetDriverScriptDependency) -> String Never! {
    "{jet_driver_receipt_field("inline_name", dependency.name)}{jet_driver_receipt_field("inline_selector", dependency.selector)}{jet_driver_receipt_field("inline_version", dependency.resolved_version)}{jet_driver_receipt_field("inline_hash", dependency.content_hash)}"
}

// #2517 package keys for the self-hosted driver, framed by
// `package_key_*` in JetFoundation.
// The facts self-hosted sema reads from the request for one package: the
// active OS, the target triple, the package edition, and whether the build
// targets the web. The build clock and root policy never enter.
fn jet_driver_package_target_facts(request: JetDriverCompileRequest, package: JetDriverPackageInfo) -> [PackageKeyTargetFact] Never! {
    web :: if request.target == {
        .Web(_, _, _) -> "true"
        .Native | .Sandbox(_, _, _) -> "false"
    }
    facts := [PackageKeyTargetFact]{
        {name: "active_os", value: request.host_facts.active_os ?? ""},
        {name: "edition", value: package.edition},
        {name: "target_triple", value: request.host_facts.target_triple ?? ""},
        {name: "web", value: web},
    }
    loop dependency in request.authorized_sources.script_dependencies {
        root :: request.authorized_sources.roots[package.root_index]
        if root.identity == request.authorized_sources.entry_root_identity || root.identity == dependency.root_identity {
            &facts.push(PackageKeyTargetFact{name: "inline:{dependency.name}", value: jet_driver_script_dependency_identity(dependency)})
        }
    }
    facts
}

// The package.jet source of a package that has a manifest.
fn jet_driver_package_manifest_source(package: JetDriverPackageInfo, snapshot: JetDriverAuthorizedSourceSnapshot) -> String? Never! {
    if package.manifest_path == .None -> return None
    loop file in snapshot.roots[package.root_index].files {
        if file.relative_path == "package.jet" -> return Val(file.source)
    }
    None
}

// The package's exact loaded source bytes, including selected generated
// modules, and its authorized package.jet manifest.
fn jet_driver_package_source_digest(package: JetDriverPackageInfo, request: JetDriverCompileRequest, source_units: [JetDriverSourceUnit]) -> String? Never! {
    files := [PackageKeySourceFile]{}
    loop unit in source_units {
        if unit.package_identity != package.identity -> next
        source :: jet_driver_source_unit_text(request, unit) ?? return None
        &files.push(PackageKeySourceFile{relative_path: unit.relative_path, source: source})
    }
    Val(package_key_source_digest(files, jet_driver_package_manifest_source(package, request.authorized_sources)))
}

// The package check key: `None` when the host names no compiler identity or
// a direct dependency has no interface digest yet (it must be checked
// first). `interface_digests` maps package identity to interface digest.
fn jet_driver_package_check_key(package: JetDriverPackageInfo, packages: [JetDriverPackageInfo], interface_digests: [String:String], request: JetDriverCompileRequest, source_units: [JetDriverSourceUnit]) -> String? Never! {
    compiler :: request.host_facts.compiler_identity ?? return None
    dependencies := [PackageKeyDependency]{}
    loop dependency in package.dependencies {
        loop candidate in packages {
            if candidate.root_index != dependency.target_root_index -> next
            digest :: interface_digests.get(candidate.identity) ?? return None
            &dependencies.push(PackageKeyDependency{identity: candidate.identity, interface_digest: digest})
        }
    }
    target :: package_key_target_facts_digest(jet_driver_package_target_facts(request, package))
    source :: jet_driver_package_source_digest(package, request, source_units) ?? return None
    Val(package_key_check_key(compiler, target, package.identity, source, dependencies))
}

// Read one record through the host store. A missing store, a missing record,
// or bytes that do not open under `schema` are all a miss.
fn jet_driver_load_record(request: JetDriverCompileRequest, schema: String, key: String) -> Record? Never! {
    if request.record_store == .Val(store) {
        bytes :: store.record(schema, key) ?? return None
        record :: record_decode(bytes).record ?? return None
        if record.schema != schema -> return None
        return Val(record)
    }
    None
}

// Encode and publish one record. Action kinds use `key`; blob kinds pass
// `None` and are addressed by their content. Returns the key published
// under, or `None` when there is no store or the record cannot be encoded
// or written.
fn jet_driver_publish_record(request: JetDriverCompileRequest, schema: String, key: String?, sections: [RecordSection]) -> String? Never! {
    if request.record_store == .Val(store) {
        encoded :: record_encode(schema, sections)
        bytes :: encoded.bytes ?? return None
        view :: bytes[0..<bytes.len()]
        address :: key ?? record_blob_key(view)
        if !store.put_record(schema, address, bytes) -> return None
        return Val(address)
    }
    None
}
