// The driver retains one shared GateLedger for all checked documentation rows.
// The host supplies owning package policies and external lock/trust/build facts;
// no CLI reader re-scans source text to discover an unsafe operation.
use {
    jet_foundation.[GateLedger, Diagnostic, Item, Program, ast_program, compiler_transfer_rows, diagnostic_with_source_path, gate_ledger_sort]
    jet_sema.[SemaGateModule, SemaGraphResult, SemaRegistrationGraph, SemaSourceOrigin, sema_gate_ledger_collect, sema_gate_checked_text_names, sema_gate_policy_diagnostics, sema_gate_source_policy_diagnostics, sema_unsafe_inspect]
}

jet_driver_doc_gate_projection: fn(docs: &[JetDriverDocModule], graph: SemaGraphResult, registration: SemaRegistrationGraph, request: JetDriverCompileRequest, packages: [JetDriverPackageInfo]) Never! {
    modules := [SemaGateModule]{}
    loop doc in docs {
        index: doc.name_module_index
        if index < 0 || index >= graph.programs.len() || index >= registration.modules.len() -> next
        owner: registration.modules[index].package_identity
        row := SemaGateModule{source: doc.path, program: graph.programs[index]}
        loop package in packages {
            if package.identity == owner {
                row.policy_path = Val(jet_driver_display_path(package.root_path, doc.physical_path))
                break
            }
        }
        loop policy in request.gate_policies {
            if policy.package_identity != owner -> next
            row.declarations = policy.declarations
            row.unsafe_paths = policy.unsafe_paths
            row.expert = policy.expert
            break
        }
        modules.push(row)
    }
    // Checked name facts are the compiler's sole structure-fact owner.
    if docs.len() == 0 {
        return
    }
    storage: docs[0].name_ledger ?? panic("checked documentation row lost its NameLedger")
    permit: storage.guard_read()
    ledger: shared sema_gate_ledger_collect(modules, permit.value, request.gate_set, request.external_gate_entries, sema_gate_checked_text_names(graph.programs))
    loop index in 0..<docs.len() -> docs[index].gate_ledger = Val(ledger)
}

JetDriverGateQueryResult: struct {
    source: JetDriverSourceQueryResult
    ledger: GateLedger
    diagnostics: [Diagnostic]
    complete: Bool
}

// Inspect uses exactly the authorized source-query loader. No registration,
// body checking, comptime execution, IR lowering, or emission happens here.
jet_driver_gate_query: fn(request: JetDriverCompileRequest) -> JetDriverGateQueryResult {
    load: jet_driver_load_with_names(request)
    source: jet_driver_source_query_loaded(load, request)
    if !source.complete -> return JetDriverGateQueryResult{source: source, ledger: GateLedger{}, diagnostics: source.diagnostics, complete: false}
    modules := [SemaGateModule]{}
    programs := [Program]{}
    loop module_row in source.modules {
        row := SemaGateModule{source: module_row.path, program: module_row.program}
        jet_driver_gate_module_policy(row, request, load.packages, module_row.package_identity, module_row.physical_path)
        modules.push(row)
        programs.push(module_row.program)
    }
    names: source.names ?? panic("completed load lost its canonical name facts")
    ledger := sema_gate_ledger_collect(modules, names, request.gate_set, request.external_gate_entries, sema_gate_checked_text_names(programs))
    loop diagnostic in sema_gate_policy_diagnostics(ledger, modules, source.entry_module_index) -> ledger.diagnostic_rows.push(diagnostic)
    diagnostics := source.diagnostics
    loop entry in ledger.diagnostic_rows {
        path := entry.source
        loop module_row in source.modules {
            if module_row.path == entry.source {
                path = module_row.physical_path
                break
            }
        }
        diagnostics.push(diagnostic_with_source_path(entry.diagnostic, path, 0))
    }
    gate_ledger_sort(ledger)
    JetDriverGateQueryResult{source: source, ledger: ledger, diagnostics: diagnostics, complete: !jet_driver_has_errors(diagnostics)}
}

// A module gate row's package display path and `policy.unsafe` /
// `policy.expert` surface, then any host-supplied gate policy for the package.
jet_driver_gate_module_policy: fn(row: &SemaGateModule, request: JetDriverCompileRequest, packages: [JetDriverPackageInfo], package_identity: String, physical_path: String) Never! {
    loop package in packages {
        if package.identity != package_identity -> next
        row.policy_path = Val(jet_driver_display_path(package.root_path, physical_path))
        row.unsafe_paths = package.policy_unsafe_paths
        row.expert = package.policy_expert
        break
    }
    loop policy in request.gate_policies {
        if policy.package_identity != package_identity -> next
        row.declarations = policy.declarations
        row.unsafe_paths = policy.unsafe_paths
        row.expert = policy.expert
        break
    }
}

// Every check runs the unsafe obligation pass, the
// package `policy.unsafe` / `policy.expert` surface and the owning policies'
// refusal of the other written gates over the loaded programs before
// registration. Compiler-owned Core sources carry no package policy and
// are not inspected. A row is keyed by the file's physical path, which its
// refusals name as the gate's site; each diagnostic is reported against the
// unit's own path. Each program's items move into its row for the read and
// back after it.
jet_driver_unsafe_check: fn(request: JetDriverCompileRequest, load: &JetDriverLoadResult) Never! {
    modules := [SemaGateModule]{}
    owners := [Int]{}
    unit_paths := [String:String]{}
    loop index in 0..<load.modules.len() {
        unit_index: load.modules[index].source_unit_index
        if jet_driver_unit_is_core(load.source_units[unit_index]) -> next
        source: load.source_units[unit_index].path
        physical := source
        root_index: load.source_units[unit_index].root_index
        file_index: load.source_units[unit_index].file_index
        if load.source_units[unit_index].source_origin == SemaSourceOrigin.Snapshot && root_index >= 0 && file_index >= 0 {
            physical = request.authorized_sources.roots[root_index].files[file_index].path
        }
        unit_paths[physical] = source
        program := ast_program()
        compiler_transfer_rows<Item>(program.items, load.modules[index].program.items)
        program.policy_declarations = load.modules[index].program.policy_declarations.copy()
        program.rule_facts = load.modules[index].program.rule_facts.copy()
        program.no_prelude = load.modules[index].program.no_prelude
        row := SemaGateModule{source: physical, program: program.move()}
        jet_driver_gate_module_policy(row, request, load.packages, load.modules[index].package_identity, physical)
        modules.push(row)
        owners.push(index)
    }
    if modules.len() == 0 -> return
    inspection: sema_unsafe_inspect(modules, request.gate_set)
    refusals: sema_gate_source_policy_diagnostics(modules)
    loop position in 0..<owners.len() -> compiler_transfer_rows<Item>(load.modules[owners[position]].program.items, modules[position].program.items)
    loop entry in inspection.diagnostics -> load.diagnostics.push(diagnostic_with_source_path(entry.diagnostic, unit_paths.get(entry.source) ?? entry.source, 0))
    loop entry in refusals -> load.diagnostics.push(diagnostic_with_source_path(entry.diagnostic, unit_paths.get(entry.source) ?? entry.source, 0))
}
