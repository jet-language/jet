// The driver retains one shared GateLedger for all checked documentation rows.
// The host supplies owning package policies and external lock/trust/build facts;
// no CLI reader re-scans source text to discover an unsafe operation.
use jet_foundation.[GateLedger, Diagnostic, Program, diagnostic_with_source_path, gate_ledger_sort]
use jet_sema.[SemaGateModule, SemaGraphResult, SemaRegistrationGraph, sema_gate_ledger_collect, sema_gate_checked_text_names, sema_gate_policy_diagnostics]

fn jet_driver_doc_gate_projection(docs: &[JetDriverDocModule], graph: SemaGraphResult, registration: SemaRegistrationGraph, request: JetDriverCompileRequest, packages: [JetDriverPackageInfo]) Never! {
    modules := [SemaGateModule]{}
    loop doc in docs {
        index :: doc.name_module_index
        if index < 0 || index >= graph.programs.len() || index >= registration.modules.len() -> next
        owner :: registration.modules[index].package_identity
        row := SemaGateModule{source: doc.path, program: graph.programs[index]}
        loop package in packages {
            if package.identity == owner {
                row.policy_path = Val(jet_driver_display_path(package.root_path, doc.physical_path))
                break
            }
        }
        loop policy in request.gate_policies {
            if policy.package_identity != owner -> next
            row.declarations = policy.declarations
            row.unsafe_paths = policy.unsafe_paths
            row.expert = policy.expert
            break
        }
        &modules.push(row)
    }
    // Checked name facts are the compiler's sole structure-fact owner.
    if docs.len() == 0 {
        return
    }
    storage :: docs[0].name_ledger ?? panic("checked documentation row lost its NameLedger")
    permit :: storage.guard_read()
    ledger :: shared sema_gate_ledger_collect(modules, permit.value, request.gate_set, request.external_gate_entries, sema_gate_checked_text_names(graph.programs))
    loop index in 0..<docs.len() -> docs[index].gate_ledger = Val(ledger)
}

struct JetDriverGateQueryResult {
    source: JetDriverSourceQueryResult
    ledger: GateLedger
    diagnostics: [Diagnostic]
    complete: Bool
}

// Inspect uses exactly the authorized source-query loader. No registration,
// body checking, comptime execution, IR lowering, or emission happens here.
fn jet_driver_gate_query(request: JetDriverCompileRequest) -> JetDriverGateQueryResult {
    load :: jet_driver_load_with_names(request)
    source :: jet_driver_source_query_loaded(load, request)
    if !source.complete -> return JetDriverGateQueryResult{source: source, ledger: GateLedger{}, diagnostics: source.diagnostics, complete: false}
    modules := [SemaGateModule]{}
    programs := [Program]{}
    loop module_row in source.modules {
        row := SemaGateModule{source: module_row.path, program: module_row.program}
        loop package in load.packages {
            if package.identity != module_row.package_identity -> next
            row.policy_path = Val(jet_driver_display_path(package.root_path, module_row.physical_path))
            row.unsafe_paths = package.policy_unsafe_paths
            row.expert = package.policy_expert
            break
        }
        loop policy in request.gate_policies {
            if policy.package_identity != module_row.package_identity -> next
            row.declarations = policy.declarations
            row.unsafe_paths = policy.unsafe_paths
            row.expert = policy.expert
            break
        }
        &modules.push(row)
        &programs.push(module_row.program)
    }
    names :: source.names ?? panic("completed load lost its canonical name facts")
    ledger := sema_gate_ledger_collect(modules, names, request.gate_set, request.external_gate_entries, sema_gate_checked_text_names(programs))
    loop diagnostic in sema_gate_policy_diagnostics(ledger, modules, source.entry_module_index) -> &ledger.diagnostic_rows.push(diagnostic)
    diagnostics := source.diagnostics
    loop entry in ledger.diagnostic_rows {
        path := entry.source
        loop module_row in source.modules {
            if module_row.path == entry.source {
                path = module_row.physical_path
                break
            }
        }
        &diagnostics.push(diagnostic_with_source_path(entry.diagnostic, path, 0))
    }
    gate_ledger_sort(&ledger)
    JetDriverGateQueryResult{source: source, ledger: ledger, diagnostics: diagnostics, complete: !jet_driver_has_errors(diagnostics)}
}
