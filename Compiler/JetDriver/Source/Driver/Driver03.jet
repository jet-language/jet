}

// Rust: crates/jet-driver/src/Driver/mod.rs:4646
// Emit the native AOT artifact from an already checked runtime bundle.
pub fn emit_native_rust_for_checked_bundle(bundle: &AST.ProgramBundle, profile: &String, ffi: FFI.FfiLink?) -> String {
    request :: mir_artifact_request_for_build(bundle, Sema.CompileMode.Run, profile, false, false, false)
    (mir, artifact) :: lower_checked_mir_program_for(bundle, request)
    execution := MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi
    execution.release_devtools_policy = release_devtools_policy_for_bundle(bundle, profile)
    execution.emit_types = true
    execution.emit_foreign = true
    execution.emit_metadata = false
    execution.emit_debug_linemap = false
    execution.emit_runtime = true
    emit_mir_program(&mir, &MirRustConfig { target: TargetLayout.from_build_facts(&bundle.build_facts), target_kind: MirRustTarget.Native, root_prefix: "", execution: execution })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:4679
fn bundle_source_closure(bundle: &AST.ProgramBundle) -> [(OSPath, String)] {
    closure := bundle.modules.iter().map(fn(module) { (module.path.clone(), module.source.clone()) }).collect()
    closure.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    closure.dedup_by(fn(left, right) { left.0 == right.0 })
    closure
}
// Rust: crates/jet-driver/src/Driver/mod.rs:4694
pub fn compiler_nodes_for_bundle(bundle: &AST.ProgramBundle, plan: BuildPlan?) -> [BuildPlanNode] { compiler_nodes_for_bundle_with_outputs(bundle, plan, &[]) }
// Rust: crates/jet-driver/src/Driver/mod.rs:4704
// Sort before key construction so source trees receive root-independent node keys.
pub fn compiler_nodes_for_bundle_with_outputs(bundle: &AST.ProgramBundle, plan: BuildPlan?, output_names: &[String]) -> [BuildPlanNode] {
    modules := bundle.modules.iter().map(fn(module) {
        normalized :: normalize_project_path(&bundle.project_root, &module.path)
        subject :: normalized.strip_prefix(&bundle.project_root).unwrap_or(&normalized).display().to_string().replace('\\', "/")
        (subject, &module.source)
    }).collect()
    modules.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    outputs := Set[String].new()
    outputs.extend(output_names.iter().cloned())
    if outputs.is_empty() && plan.is_some() {
        plan :: plan.unwrap()
        selected :: plan.default_target().map(fn(target) { target.id() })
        for target in plan.targets().iter().filter(fn(target) { selected.is_none_or(fn(selected) { target.id == selected }) }) { outputs.extend(target.outputs.iter().map(fn(output) { output.as_str().to_string() })) }
    }
    if outputs.is_empty() {
        fallback :: bundle.modules.get(bundle.entry).and_then(fn(module) { module.path.file_stem() }).and_then(fn(stem) { stem.to_str() }).filter(fn(stem) { !stem.is_empty() }).unwrap_or("program")
        _ :: outputs.insert(fallback.to_string())
    }
    checks :: modules.iter().map(fn((subject, source)) {
        digest :: ContentDigest.from_bytes(source.as_bytes()).as_str().to_string()
        BuildPlanNode.new(BuildNodeKind.Check, subject.clone(), [(subject.clone(), digest)])
    }).collect[[BuildPlanNode]]()
    nodes := checks.clone()
    sorted_outputs := outputs.into_iter().collect[[String]]()
    sorted_outputs.sort()
    for output in sorted_outputs {
        inputs :: checks.iter().map(fn(check) { ("check:{check.subject}", check.key.clone()) }).collect()
        compile :: BuildPlanNode.new(BuildNodeKind.Compile, output.clone(), inputs)
        link :: BuildPlanNode.new(BuildNodeKind.Link, output.clone(), [("compile:{output}", compile.key.clone())])
        nodes.push(compile)
        nodes.push(link)
    }
    nodes.sort_by(fn(left, right) { left.kind.cmp(&right.kind).then_with(fn() { left.subject.cmp(&right.subject) }).then_with(fn() { left.key.cmp(&right.key) }) })
    nodes
}
// Rust: crates/jet-driver/src/Driver/mod.rs:4795
fn generated_source_for_path(path: &OSPath, project_root: &OSPath, generated_sources: &[&BuildGeneratedModule]) -> String? {
    normalized :: normalize_project_path(project_root, path)
    generated_sources.iter().find(fn(module) { normalize_project_path(project_root, OSPath.new(module.path.as_str())) == normalized }).map(fn(module) { &module.source })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:4810
fn load_planned_source(build_file: &String, path: &OSPath, project_root: &OSPath, generated: &[GeneratedSourceProvenance], generated_sources: &[&BuildGeneratedModule], source_closure: &[(OSPath, String)]) -> AST.ProgramBundle [Diagnostic]! {
    overlays := source_closure.iter().map(fn((path, source)) { (path, source) }).collect()
    source :: generated.iter().find(fn(item) { normalize_project_path(project_root, &item.path) == normalize_project_path(project_root, path) }).map(fn(item) { &item.source }).or_else(fn() { generated_source_for_path(path, project_root, generated_sources) })
    if source.is_some() { overlays.push((path, source.unwrap())) }
    Loader.load_entry_with_overlays(path.to_str().unwrap_or(build_file), &overlays, false)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:4835
fn load_planned_runtime_bundle(build_file: &String, plan: &BuildPlan, generated: &[GeneratedSourceProvenance], generated_sources: &[&BuildGeneratedModule], project_root: &OSPath, source_closure: &[(OSPath, String)], fallback_bundle: fn() -> AST.ProgramBundle [Diagnostic]!) -> AST.ProgramBundle [Diagnostic]! {
    sources :: plan.selected_sources().map_err(fn(error) { [build_plan_diagnostic(&error)] })?
    resolve :: fn(path: &String) { path :: OSPath.new(path); if path.is_absolute() { path.to_path_buf() } else { project_root.join(path) } }
    // Fallback is lazy and fresh: final $build reads must remain foldable.
    (entry_index, bundle) := if sources.is_empty() { (0, fallback_bundle()?) } else {
        first :: load_planned_source(build_file, &resolve(sources[0].as_str()), project_root, generated, generated_sources, source_closure)?
        has_run :: fn(bundle: &AST.ProgramBundle) { bundle.modules.get(bundle.entry).is_some_and(fn(module) { module.items.iter().any(fn(item) { item == { .Func(function) -> function.name == "run", _ -> false } }) }) }
        if has_run(&first) { (0, first) } else {
            selected := (0, first)
            for (index, entry_source) in sources.iter().enumerate().skip(1) {
                candidate :: load_planned_source(build_file, &resolve(entry_source.as_str()), project_root, generated, generated_sources, source_closure)?
                if has_run(&candidate) { selected = (index, candidate); break }
            }
            selected
        }
    }
    additions := sources.iter().enumerate().filter(fn((index, _)) { index != entry_index }).map(fn((_, path)) { ("selected source", resolve(path.as_str())) }).chain(generated.iter().map(fn(item) { (&item.name, item.path.clone()) })).collect()
    additions.sort_by(fn(a, b) { a.1.cmp(&b.1) })
    additions.dedup_by(fn(a, b) { a.1 == b.1 })
    selected_paths :: additions.iter().map(fn((_, path)) { normalize_project_path(project_root, path) }).collect[Set[OSPath]]()
    already_loaded :: bundle.modules.iter().map(fn(module) { normalize_project_path(project_root, &module.path) }).collect[Set[OSPath]]()
    loaded_by_path := [OSPath:AST.Module].new()
    for (generator, path) in additions {
        loaded :: load_planned_source(build_file, &path, project_root, generated, generated_sources, source_closure).map_err(fn(diagnostics) {
            diagnostics := diagnostics
            for diagnostic in &diagnostics { diagnostic.what = "generated by `{generator}`: {diagnostic.what}" }
            diagnostics
        })?
        for module in loaded.modules { key :: normalize_project_path(project_root, &module.path); loaded_by_path.entry(key).or_insert(module) }
    }
    // Preserve selected-root import aliases as inline modules before promotion.
    inline_imports := [String:([AST.Item], AST.WebTarget?)].new()
    loaded_keys := loaded_by_path.keys().cloned().collect[[OSPath]]()
    loaded_keys.sort()
    for key in loaded_keys {
        module :: loaded_by_path[&key]
        for import in module.imports {
            import_path_opt :: import.kind == { .File(import_path, _) -> Some(import_path), _ -> None }
            if import_path_opt.is_none() { continue }
            target_path := module.path.parent().unwrap_or_else(fn() { OSPath.new(".") }).to_path_buf()
            for part in import_path_opt.unwrap().split('/') { if !part.is_empty() && part != "." { target_path.push(part) } }
            target_path.set_extension(Syntax.FILE_EXT)
            target_path :: normalize_project_path(project_root, &target_path)
            target :: loaded_by_path.get(&target_path)
            if target.is_none() { continue }
            alias :: import.import_alias()
            inline_imports.entry(alias).or_insert_with(fn() { (target.unwrap().items.clone(), target.unwrap().web_target_ceiling) })
        }
    }
    sorted_selected := selected_paths.iter().cloned().collect[[OSPath]]()
    sorted_selected.sort()
    for path in sorted_selected {
        if already_loaded.contains(&path) { continue }
        module :: loaded_by_path.remove(&path)
        if module.is_some() { bundle.modules[bundle.entry].items.extend(module.unwrap().items) }
    }
    inline_aliases :: inline_imports.keys().cloned().collect[Set[String]]()
    sorted_aliases := inline_imports.keys().cloned().collect[[String]]()
    sorted_aliases.sort()
    for alias in sorted_aliases {
        (items, web_target) :: inline_imports.remove(&alias).unwrap()
        bundle.modules[bundle.entry].items.push(AST.Item.CodeModule(AST.CodeModule { name: alias, name_span: Span.new(0, 0), is_pub: false, is_package_pub: false, body: Some(items), imports: [], web_target: web_target, instance_identity: None, span: Span.new(0, 0) }))
    }
    remaining_keys := loaded_by_path.keys().cloned().collect[[OSPath]]()
    remaining_keys.sort()
    for path in remaining_keys {
        module :: loaded_by_path.remove(&path).unwrap()
        if already_loaded.contains(&path) || selected_paths.contains(&path) || inline_aliases.contains(&module.alias) { continue }
        alias :: module.alias.clone()
        bundle.modules[bundle.entry].items.push(AST.Item.CodeModule(AST.CodeModule { name: alias, name_span: Span.new(0, 0), is_pub: false, is_package_pub: false, body: Some(module.items), imports: module.imports, web_target: module.web_target_ceiling, instance_identity: None, span: Span.new(0, 0) }))
    }
    Ok(bundle)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5047
fn check_action_generated_sources(plan: &BuildPlan, root: &OSPath, existing_source_paths: &[OSPath], span: Span?, build_facts: &BuildFactSnapshot) -> [GeneratedSourceProvenance] [Diagnostic]! {
    registered :: plan.generated_modules().iter().map(fn(module) { module.path.as_str() }).collect[Set[String]]()
    out := [GeneratedSourceProvenance].new()
    selected :: plan.selected_action_ids().map_err(fn(error) { [build_plan_diagnostic(&error)] })?
    for action in plan.actions().iter().filter(fn(action) { selected.contains(&action.id) }) {
        for output in action.outputs {
            if !output.as_str().ends_with(".jet") || registered.contains(output.as_str()) { continue }
            path :: normalize_project_path(root, OSPath.new(output.as_str()))
            if has_symlinked_component(root, &path) || fs.symlink_metadata(&path).is_ok_and(fn(metadata) { metadata.file_type().is_symlink() }) { return Err([generated_collision_diag(&action.name, output.as_str(), span)]) }
            source_path :: existing_source_paths.iter().map(fn(source) { normalize_project_path(root, source) }).any(fn(source) { source == path })
            if source_path { return Err([generated_collision_diag(&action.name, output.as_str(), span)]) }
            source :: String.from_utf8(read_build_file(root, &path).map_err(fn(error) { [generated_io_diag(&action.name, &error)] })?).map_err(fn(error) { [generated_io_diag(&action.name, &io.Error.new(io.ErrorKind.InvalidData, error))] })?
            generated_bundle := Loader.load_entry_with_overlay(path.to_str().unwrap_or(output.as_str()), Some((&path, &source)), false).map_err(fn(diags) {
                diags := diags
                for diag in &diags { diag.what = "generated action `{action.name}`: {diag.what}" }
                diags
            })?
            generated_bundle.build_facts = build_facts.clone()
            generated_bundle.active_os = build_facts.os
            generated_diags :: Sema.check_bundle(&generated_bundle, Sema.CompileMode.Check)
            diags := apply_package_lint_policy(&generated_bundle, generated_diags)?
            diags.retain(fn(diag) { diag.severity == Severity.Error })
            if !diags.is_empty() { for diag in &diags { diag.what = "generated action `{action.name}`: {diag.what}" }; return Err(diags) }
            out.push(GeneratedSourceProvenance { name: action.name.clone(), path: path, digest: ContentDigest.from_bytes(source.as_bytes()), source: source })
        }
    }
    Ok(out)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5138
fn validate_selected_action_outputs(plan: &BuildPlan, selected_actions: &Set[ActionId], generated: &[&BuildGeneratedModule], root: &OSPath, existing_source_paths: &[OSPath], span: Span?) -> Unit [Diagnostic]! {
    source_paths :: existing_source_paths.iter().map(fn(source) { normalize_project_path(root, source) }).collect[Set[OSPath]]()
    for action in plan.actions().iter().filter(fn(action) { selected_actions.contains(&action.id) }) {
        for output in action.outputs {
            path :: normalize_project_path(root, OSPath.new(output.as_str()))
            if has_symlinked_component(root, &path) { return Err([Diagnostic.error("E3505", "build action `{action.name}` cannot write output `{output.as_str()}` through a symlink", "sandboxed build outputs must stay inside the project and must not follow symlinks", "remove the symlink or choose a real output directory inside the project", None)]) }
            if source_paths.contains(&path) { return Err([generated_collision_diag(&action.name, output.as_str(), span)]) }
            if generated.iter().any(fn(module) { normalize_project_path(root, OSPath.new(module.path.as_str())) == path }) { return Err([generated_cycle_diag(&action.name, output.as_str(), "a selected build action and a generated module both own this path", span)]) }
        }
    }
    Ok(())
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5197
// Same sema predicate selects, rejects and strips BuildContext/BuildPlan entries.
fn valid_build_signature(func: &AST.Func) -> Bool { Sema.build_entry_signature_is_valid(func) }
// Rust: crates/jet-driver/src/Driver/mod.rs:5201
fn contains_impure_gate(stmts: &[AST.Stmt]) -> Bool {
    stmts.iter().any(fn(stmt) {
        stmt == {
            .Impure(..) -> true
            .While(body: body, ..), .For(body: body, ..), .Loop(body: body, ..), .Reactive(body: body, ..), .Shield(body: body, ..), .Switched(body: body, ..), .Region(body: body, ..), .Policy(body: body, ..), .TaskGroup(body: body, ..), .Layout(body: body, ..), .AuthorityScope(body: body, ..), .ComptimeBlock(body: body, ..), .Live(body: body, ..), .Transact(body: body, ..), .Unsafe(body: body, ..), .ScopeMember(body: body, ..) -> contains_impure_gate(body)
            .Switch(arms: arms, else_body: else_body, ..), .ComptimeSwitch(arms: arms, else_body: else_body, ..) -> arms.iter().any(fn(arm) { contains_impure_gate(&arm.body) }) || else_body.is_some_and(contains_impure_gate)
            .CountedLoop(step: step, body: body, ..) -> step.is_some_and(fn(step) { contains_impure_gate(&[step]) }) || contains_impure_gate(body)
            .ComptimeIf(then_body: then_body, else_body: else_body, ..) -> contains_impure_gate(then_body) || else_body.is_some_and(contains_impure_gate)
            .ContextBlock(body: body, ..), .AssumeDet(body: body, ..) -> contains_impure_gate(body)
            _ -> false
        }
    })
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5252
// Nearest dependency root owns each module; root package remains last.
fn compiler_package_specs(bundle: &AST.ProgramBundle, root_name: &String, package_build_fingerprint: String?) -> [CompilerPackageSpec] {
    root :: normalize_project_path(&bundle.project_root, &bundle.project_root)
    roots := [(root_name.to_string(), root.clone())]
    dependency_roots := bundle.dep_roots.iter().map(fn((name, path)) { (name.clone(), normalize_project_path(&bundle.project_root, path)) }).collect()
    dependency_roots.sort_by(fn(left, right) { left.1.cmp(&right.1).then_with(fn() { left.0.cmp(&right.0) }) })
    known_roots := Set[OSPath].new()
    _ :: known_roots.insert(root.clone())
    for (name, path) in dependency_roots { if known_roots.insert(path.clone()) { roots.push((name, path)) } }
    roots.sort_by(fn(left, right) { left.1.cmp(&right.1).then_with(fn() { left.0.cmp(&right.0) }) })
    root_index :: roots.iter().position(fn((_, path)) { path == root })
    if root_index.is_some() { root_entry :: roots.remove(root_index.unwrap()); roots.push(root_entry) }
    module_packages :: bundle.modules.iter().map(fn(module) {
        path :: normalize_project_path(&bundle.project_root, &module.path)
        roots.iter().filter(fn((_, package_root)) { path.strip_prefix(package_root).is_ok() }).max_by_key(fn((_, package_root)) { package_root.components().count() }).map(fn((name, _)) { name.clone() })
    }).collect[[String?]]()
    source_parts := [String:[(String, [U8])]].new()
    package_roots :: roots.iter().map(fn((name, path)) { (name.clone(), path) }).collect[[String:&OSPath]]()
    for (index, module) in bundle.modules.iter().enumerate() {
        if module_packages[index].is_none() { continue }
        package_name :: module_packages[index].as_ref().unwrap()
        normalized_path :: normalize_project_path(&bundle.project_root, &module.path)
        package_root :: package_roots.get(package_name)
        relative :: package_root.and_then(fn(path) { normalized_path.strip_prefix(path).ok() }).unwrap_or(&normalized_path).display().to_string()
        source_parts.entry(package_name.clone()).or_default().push((relative, CanonicalAST.canonical_module_bytes(module)))
    }
    dependencies := roots.iter().map(fn((name, _)) { (name.clone(), Set[String].new()) }).collect[[String:Set[String]]]()
    for (module_index, module) in bundle.modules.iter().enumerate() {
        if module_packages[module_index].is_none() { continue }
        owner :: module_packages[module_index].as_ref().unwrap()
        for import in module.imports {
            target_index :: bundle.name_ledger.import_target(module_index, import.span)
            if target_index.is_none() { continue }
            target :: module_packages.get(target_index.unwrap()).and_then(fn(target) { target.as_ref() })
            if target.is_none() { continue }
            target :: target.unwrap()
            if target != owner { _ :: dependencies.entry(owner.clone()).or_default().insert(target.clone()) }
        }
    }
    roots.into_iter().map(fn((name, _)) {
        bytes := "jet.package-source.v2".as_bytes().to_vec()
        bytes.extend_from_slice(TEXT_NUL.as_bytes())
        parts := source_parts.remove(&name).unwrap_or_default()
        parts.sort_by(fn(left, right) { left.0.cmp(&right.0) })
        if parts.is_empty() { bytes.extend_from_slice(name.as_bytes()) } else {
            for (path, semantic) in parts {
                bytes.extend_from_slice(&U64.from(path.len()).to_be_bytes())
                bytes.extend_from_slice(path.as_bytes())
                bytes.extend_from_slice(&U64.from(semantic.len()).to_be_bytes())
                bytes.extend_from_slice(&semantic)
            }
        }
        if name == root_name && package_build_fingerprint.is_some() {
            fingerprint :: package_build_fingerprint.unwrap()
            bytes.extend_from_slice("build-entry".as_bytes())
            bytes.extend_from_slice(TEXT_NUL.as_bytes())
            bytes.extend_from_slice(&U64.from(fingerprint.len()).to_be_bytes())
            bytes.extend_from_slice(fingerprint.as_bytes())
        }
        package_dependencies := dependencies.remove(&name).unwrap_or_default().into_iter().collect[[String]]()
        package_dependencies.sort()
        CompilerPackageSpec.new(name, ContentDigest.from_bytes(&bytes), package_dependencies)
    }).collect()
}
// Rust: crates/jet-driver/src/Driver/mod.rs:5377
fn build_package_name(file: &String) -> String [Diagnostic]! {
    entry :: OSPath.new(file)
    absolute :: if entry.is_absolute() { entry.to_path_buf() } else { env.current_dir().map(fn(directory) { directory.join(entry) }).unwrap_or_else(fn(_) { entry.to_path_buf() }) }
    parent :: absolute.parent().unwrap_or(OSPath.new("."))
    workspace_root :: Loader.find_workspace_root_checked(parent).map_err(fn(diagnostic) { [diagnostic] })?
    package_root :: Loader.find_package_root_checked(parent).map_err(fn(diagnostic) { [diagnostic] })?.filter(fn(root) { workspace_root.as_ref().is_none_or(fn(workspace) { Loader.is_physically_within(workspace, root) }) })
    if package_root.is_some() {
        package :: Loader.package_facts_for_root(package_root.unwrap())?
        if package.is_some() && !package.unwrap().name.is_empty() { return Ok(package.unwrap().name) }
    }
    if workspace_root.is_some() { return Loader.authority_name_for_entry(&absolute).map_err(fn(diagnostic) { [diagnostic] }) }
    Ok(absolute.file_stem().and_then(fn(name) { name.to_str() }).filter(fn(name) { !name.is_empty() }).unwrap_or("app").to_string())
}
