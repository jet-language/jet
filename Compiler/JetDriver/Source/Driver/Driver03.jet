//RS /// D-BUILDENTRY1: `E3501`'s contract, held in one place. Entry identity (the
//RS /// `build` name plus its `BuildContext` parameter) and the typed
//RS /// `BuildPlan` result facts are graded by the same sema predicates that
//RS /// `Sema::strip_build_only_entries` uses to keep the entry out of runtime
//RS /// codegen, so selection, rejection, and removal cannot drift apart (I8).
//RS fn valid_build_signature(func: &crate::AST::Func) -> bool {
//RS     crate::Sema::build_entry_signature_is_valid(func)
//RS }
