use core.collections.Set
// GATE #4494: native filesystem transactions, retained build-file reads and foreign links.
// GATE #4483: cross-target selection uses the checked BuildFacts TargetLayout dossier.
// GATE #4499: OSPath/tuple key equality and canonical sorted digest framing.

// Rust: crates/jet-driver/src/Driver/mod.rs:3601
// The head captures the loader bundle and target once; only the stamp lock probes.
fn prepare_build_front_end_finish(inputs: FrontEndInputs, bundle: AST.ProgramBundle, package_entry: (OSPath, String)?, active_os: Syntax.OSTarget, compile_mode: Sema.CompileMode, package_build_fingerprint: String?, runtime_bundle_for_package: AST.ProgramBundle?, runtime_source_paths: [OSPath]) -> PreparedBuildFrontEnd [Diagnostic]! {
    bundle := bundle
    package_build_fingerprint := package_build_fingerprint
    runtime_bundle_for_package := runtime_bundle_for_package
    build_stamp :: build_stamp_for_facts(&bundle.project_root, inputs.locked)?
    seed_build_facts_from_stamp(&bundle, &inputs.profile, &inputs.setting_overrides, &[], &build_stamp)?
    bundle.build_facts.artifact_build = inputs.artifact_build
    bundle.web_partition_enforced = inputs.web_target
    local_build_indices :: if inputs.build_override {
        bundle.modules[bundle.entry].items.iter().enumerate().filter_map(fn((index, item)) { item == { .Func(func) -> if Sema.is_build_entry(func) { Some(index) } else { None }, _ -> None } }).collect[[USize]]()
    } else { [] }
    if local_build_indices.len() > 1 { return Err([duplicate_build_entries(&bundle, &local_build_indices)]) }
    entry_module_path :: bundle.modules[bundle.entry].path.clone()
    if package_entry.is_some() {
        (package_path, package_source) :: package_entry.unwrap()
        if !local_build_indices.is_empty() && normalize_project_path(&bundle.project_root, package_path) != normalize_project_path(&bundle.project_root, &entry_module_path) {
            source_span :: local_build_indices.first().and_then(fn(index) { bundle.modules[bundle.entry].items[index] == { .Func(func) -> Some(func.name_span), _ -> None } })
            local_location :: local_build_indices.first().map(fn(index) { build_function_location(&bundle.modules[bundle.entry], index) }).unwrap_or_else(fn() { entry_module_path.display().to_string() })
            package_location :: build_source_location(package_path, package_source)
            return Err([build_entry_conflict("the package", &local_location, &package_location, source_span)])
        }
    }
    if package_entry.is_some() {
        (package_path, package_source) :: package_entry.unwrap()
        if normalize_project_path(&bundle.project_root, &package_path) != normalize_project_path(&bundle.project_root, &entry_module_path) {
            source_closure := bundle_source_closure(&bundle)
            source_closure.push((package_path.clone(), package_source.clone()))
            source_closure.sort_by(fn(left, right) { left.0.cmp(&right.0) })
            source_closure.dedup_by(fn(left, right) { left.0 == right.0 })
            overlays :: source_closure.iter().map(fn((path, source)) { (path, source) }).collect()
            runtime_bundle_for_package = Some(bundle)
            package_path_string :: package_path.to_string_lossy().into_owned()
            bundle = Loader.load_entry_with_overlays(&package_path_string, &overlays, false)?
            package_build_fingerprint = Some(jet_foundation.SHA256.sha256_hex(&CanonicalAST.canonical_bytes(&bundle)))
            bundle.active_os = active_os
            set_bundle_target(&bundle, inputs.cross_target.as_deref())
            seed_build_facts_from_stamp(&bundle, &inputs.profile, &inputs.setting_overrides, &[], &build_stamp)?
            bundle.build_facts.artifact_build = inputs.artifact_build
            bundle.web_partition_enforced = inputs.web_target
        }
    }
    local_build_indices :: if inputs.build_override {
        bundle.modules[bundle.entry].items.iter().enumerate().filter_map(fn((index, item)) { item == { .Func(func) -> if Sema.is_build_entry(func) { Some(index) } else { None }, _ -> None } }).collect[[USize]]()
    } else { [] }
    if local_build_indices.len() > 1 { return Err([duplicate_build_entries(&bundle, &local_build_indices)]) }
    build_index :: local_build_indices.into_iter().next()
    build_span :: build_index.and_then(fn(index) { bundle.modules[bundle.entry].items[index] == { .Func(build) -> Some(build.span), _ -> None } })
    if build_index.is_some() {
        build :: bundle.modules[bundle.entry].items[build_index.unwrap()] == { .Func(build) -> build, _ -> panic("unreachable") }
        if !valid_build_signature(build) { return Err([bad_build_signature(build.name_span)]) }
    }
    if build_index.is_none() && inputs.entry_fn.is_some() { swap_entry_point(&bundle, inputs.entry_fn.unwrap()) }
    // Build code is host code; target restrictions apply to its selected runtime.
    sema_span := Trace.span("sema.check")
    (diags, effect_facts) :: if build_index.is_some() { Sema.check_bundle_with_effect_facts_for_build(&bundle, compile_mode) } else { Sema.check_bundle_with_effect_facts(&bundle, compile_mode) }
    sema_span.items(bundle.modules.len())
    drop(sema_span)
    diags :: apply_package_effect_budget(&bundle, &effect_facts, diags)?
    extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, Some(&effect_facts), &diags)
    parse_teaching :: bundle.parse_teaching.take()
    lints :: classify_diagnostics(&bundle, parse_teaching.into_iter().chain(diags).chain(extension_diags).collect(), build_span.is_some())?
    source_closure := bundle_source_closure(&bundle)
    if runtime_bundle_for_package.is_some() { source_closure.extend(bundle_source_closure(runtime_bundle_for_package.unwrap())) }
    source_closure.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    source_closure.dedup_by(fn(left, right) { left.0 == right.0 })
    Ok(PreparedBuildFrontEnd { inputs: inputs, bundle: bundle, effect_facts: effect_facts, program_value: None, lints: lints, build_index: build_index, build_span: build_span, compile_mode: compile_mode, active_os: active_os, build_stamp: build_stamp, package_build_fingerprint: package_build_fingerprint, runtime_bundle_for_package: runtime_bundle_for_package, runtime_source_paths: runtime_source_paths, source_closure: source_closure })
}

// Rust: crates/jet-driver/src/Driver/mod.rs:3775
// Stage two resumes the checked front end: evaluate plan, recheck runtime, emit.
fn compile_build_from_front_end(file: &String, options: BuildRunOptions, dependency_boundary: String?, prepared: PreparedBuildFrontEnd, without_codegen: Bool, project_check: Bool) -> BuildCompileOutput [Diagnostic]! {
    bundle := prepared.bundle
    effect_facts :: prepared.effect_facts
    program_value :: prepared.program_value
    lints := prepared.lints
    build_index :: prepared.build_index
    build_span :: prepared.build_span
    compile_mode :: prepared.compile_mode
    active_os :: prepared.active_os
    build_stamp :: prepared.build_stamp
    package_build_fingerprint :: prepared.package_build_fingerprint
    runtime_bundle_for_package := prepared.runtime_bundle_for_package
    runtime_source_paths :: prepared.runtime_source_paths
    source_closure :: prepared.source_closure
    refresh_target_dossier(&bundle, options.no_os, options.web_target)
    lock_was_present :: bundle.project_root.join(Syntax.UNIFIED_LOCK_FILE).exists()
    front_end_completion :: FrontEndCompletion.all_complete()
    build_run := None as BuildRun?
    locked_provenance := [AST.ComptimeInput].new()
    filesystem_transaction := None as BuildFilesystemTransaction?
    if build_index.is_some() {
        build :: bundle.modules[bundle.entry].items[build_index.unwrap()] == { .Func(func) -> func, _ -> panic("unreachable") }
        declared_build_effects :: build.declared_effects.iter().flatten().filter_map(fn((name, _)) { BuildCapability.parse(name) }).collect[Set[BuildCapability]]()
        has_impure_gate :: contains_impure_gate(&build.body)
        build_name_span :: build.name_span
        funcs := [String:&AST.Func].new()
        error_conversions :: bundle.modules.iter().flat_map(fn(module) { module.items.iter() }).filter_map(fn(item) { item == { .ErrorConv(conversion) -> Some(conversion.clone()), _ -> None } }).collect()
        methods := [(String, String):&AST.Func].new()
        structs := [String:&AST.StructDef].new()
        enums := [String:&AST.EnumDef].new()
        migrations := [String:[&AST.MigrationDecl]].new()
        computed_fields := [(String, String):&AST.Expr].new()
        distinct_ranges := [String:(I64, I64)?].new()
        distinct_bases := [String:AST.Type].new()
        function_name_counts := [String:USize].new()
        type_name_counts := [String:USize].new()
        const_name_counts := [String:USize].new()
        for module in bundle.modules {
            for item in module.items {
                item == {
                    .Func(func) -> { function_name_counts.entry(func.name.clone()).or_default() += 1 }
                    .Struct(def) -> { type_name_counts.entry(def.name.clone()).or_default() += 1 }
                    .Enum(def) -> { type_name_counts.entry(def.name.clone()).or_default() += 1 }
                    .Const(def) -> { if def.is_comptime && def.ct.is_some() { const_name_counts.entry(def.name.clone()).or_default() += 1 } }
                    _ -> {}
                }
            }
        }
        // Computed getters consume sema-rewritten source, with qualified and unique short keys.
        for module in bundle.modules {
            for item in module.items {
                item == {
                    .Struct(def) -> {
                        owner :: "{module.alias}::{def.name}"
                        for field in def.fields {
                            if field.computed.is_some() {
                                expression :: field.computed.unwrap()
                                computed_fields.insert((owner.clone(), field.name.clone()), expression)
                                if type_name_counts.get(&def.name) == Some(&1) { computed_fields.insert((def.name.clone(), field.name.clone()), expression) }
                            }
                        }
                    }
                    _ -> {}
                }
            }
        }
        for module in bundle.modules {
            for item in module.items {
                item == {
                    .Func(func) -> {
                        funcs.insert("{module.alias}::{func.name}", func)
                        if function_name_counts.get(&func.name) == Some(&1) { funcs.insert(func.name.clone(), func) }
                    }
                    .Struct(def) -> {
                        owner :: "{module.alias}::{def.name}"
                        structs.insert(owner.clone(), def)
                        if type_name_counts.get(&def.name) == Some(&1) { structs.insert(def.name.clone(), def) }
                        for method in def.methods { methods.insert((owner.clone(), method.name.clone()), method); if type_name_counts.get(&def.name) == Some(&1) { methods.insert((def.name.clone(), method.name.clone()), method) } }
                    }
                    .Enum(def) -> {
                        owner :: "{module.alias}::{def.name}"
                        enums.insert(owner.clone(), def)
                        if type_name_counts.get(&def.name) == Some(&1) { enums.insert(def.name.clone(), def) }
                        for method in def.methods { methods.insert((owner.clone(), method.name.clone()), method); if type_name_counts.get(&def.name) == Some(&1) { methods.insert((def.name.clone(), method.name.clone()), method) } }
                    }
                    .Impl(imp) -> {
                        owner :: "{module.alias}::{imp.type_name}"
                        for method in imp.methods { methods.insert((owner.clone(), method.name.clone()), method); if type_name_counts.get(&imp.type_name) == Some(&1) { methods.insert((imp.type_name.clone(), method.name.clone()), method) } }
                    }
                    .Migration(m) -> migrations.entry(m.type_name.clone()).or_default().push(m)
                    .Distinct(def) -> { distinct_ranges.insert(def.name.clone(), def.range.map(fn((lo, hi, _)) { (lo, hi) })); distinct_bases.insert(def.name.clone(), def.base.clone()) }
                    .UnitFamily(family) -> {
                        for def in family.distinct_defs() { distinct_ranges.insert(def.name.clone(), def.range.map(fn((lo, hi, _)) { (lo, hi) })); distinct_bases.insert(def.name, def.base) }
                    }
                    _ -> {}
                }
            }
        }
        // Immutable comptime constants are real inputs to the same pure interpreter.
        globals := [String:Comptime.CtValue].new()
        for module in bundle.modules {
            for item in module.items {
                item == {
                    .Const(def) -> {
                        if !def.is_comptime || def.ct.is_none() { continue }
                        value :: def.ct.unwrap()
                        globals.insert("{module.alias}::{def.name}", value.clone())
                        if const_name_counts.get(&def.name) == Some(&1) { globals.insert(def.name.clone(), value.clone()) }
                    }
                    _ -> {}
                }
            }
        }
        core_imports :: core_aliases(&bundle.modules[bundle.entry])
        info :: Comptime.ProgramInfo { globals: globals, methods: methods, structs: structs, enums: enums, computed_fields: computed_fields, distinct_ranges: distinct_ranges, distinct_bases: distinct_bases, core_imports: core_imports, build_facts: bundle.build_facts.clone(), migrations: migrations }
        program_value :: program_value.unwrap_or_else(fn() { semantic_facts :: program_semantic_facts(&bundle, &effect_facts); Comptime.build_program_info(&bundle, &semantic_facts) })
        base_dir :: &bundle.project_root
        package :: if bundle.build_facts.package_name.is_empty() { build_package_name(file)? } else { bundle.build_facts.package_name.clone() }
        evaluated := with_packaged_plugin_runner(BuildPluginHook.run_packaged_build_plugin, fn() {
            Comptime.run_build_entry_with_policy(build, &funcs, &error_conversions, base_dir, &info, program_value, &package, options.gates, options.policy.clone())
        }).map_err(fn(diag) { [diag] })?
        if !evaluated.diagnostics.is_empty() { return Err(evaluated.diagnostics) }
        // Computed writers finalize through the canonical fact pipeline before actions.
        seed_build_facts_from_stamp(&bundle, &options.profile, &options.setting_overrides, evaluated.plan.fact_contributions(), &build_stamp)?
        bundle.build_facts.artifact_build = options.artifact_build
        dependency_name :: dependency_boundary.map(build_package_name).transpose()?
        validate_build_authority(&evaluated.plan, &declared_build_effects, has_impure_gate, &options, dependency_name, build_name_span)?
        validate_legacy_project_imports(&evaluated.plan, &bundle.project_root, build_name_span)?
        package_spec_bundle :: runtime_bundle_for_package.as_ref().unwrap_or(&bundle)
        package_specs :: if package_spec_bundle.dep_roots.is_empty() { [] } else { compiler_package_specs(package_spec_bundle, &package, package_build_fingerprint.as_deref()) }
        compiler_identity :: compiler_action_identity(&bundle.build_facts)
        compiler_target :: bundle.build_facts.target_triple.clone()
        compiler_profile :: options.profile.clone()
        if !package_specs.is_empty() && !evaluated.plan.targets().is_empty() {
            evaluated.plan.add_compiler_package_actions(&package_specs, compiler_identity, &compiler_target, &compiler_profile).map_err(fn(error) { [build_plan_diagnostic(&error)] })?
        }
        compiler_artifacts :: package_specs.iter().map(fn(spec) { (spec.name.clone(), spec.clone()) }).collect[[String:CompilerPackageSpec]]()
        compiler_runner :: fn(action: &BuildAction, snapshots: &[ActionInputSnapshot]) -> [[U8]] Err! {
            package_name :: action.labels.get("compiler.package").ok_or_else(fn() { "compiler action has no package identity" })?
            spec :: compiler_artifacts.get(package_name).ok_or_else(fn() { "compiler package `{package_name}` was not prepared" })?
            artifact := "jet.sealed-package.v1\npackage={package_name}\nsource={spec.source_digest.as_str()}\ncompiler={action.labels.get("compiler.identity").map(fn(s) { s.as_str() }).unwrap_or_default()}\ntarget={action.labels.get("compiler.target").map(fn(s) { s.as_str() }).unwrap_or_default()}\nprofile={action.labels.get("compiler.profile").map(fn(s) { s.as_str() }).unwrap_or_default()}\n"
            for snapshot in snapshots { artifact.push_str("dependency="); artifact.push_str(snapshot.path.as_str()); artifact.push('='); artifact.push_str(snapshot.digest.as_str()); artifact.push('\n') }
            Ok([artifact.into_bytes()])
        }
        selected_actions :: evaluated.plan.selected_action_ids().map_err(fn(error) { [build_plan_diagnostic(&error)] })?
        selected_generated :: if options.emit_generated { evaluated.plan.generated_modules().iter().collect() } else { evaluated.plan.selected_generated_modules().map_err(fn(error) { [build_plan_diagnostic(&error)] })? }
        existing_source_paths := runtime_source_paths.clone()
        existing_source_paths.extend(bundle.modules.iter().map(fn(module) { module.path.clone() }))
        selected_action_outputs :: evaluated.plan.actions().iter().filter(fn(action) { selected_actions.contains(&action.id) }).flat_map(fn(action) { action.outputs.iter().map(fn(output) { output.as_str().to_string() }) }).collect[[String]]()
        validate_selected_action_outputs(&evaluated.plan, &selected_actions, &selected_generated, &bundle.project_root, &existing_source_paths, build_span)?
        transaction_paths := selected_generated.iter().map(fn(module) { bundle.project_root.join(module.path.as_str()) }).chain(evaluated.plan.actions().iter().filter(fn(action) { selected_actions.contains(&action.id) }).flat_map(fn(action) { action.outputs.iter().map(fn(output) { bundle.project_root.join(output.as_str()) }) })).collect[[OSPath]]()
        transaction_paths.push(bundle.project_root.join(".jet/lock"))
        if !project_check { filesystem_transaction = Some(BuildFilesystemTransaction.new(transaction_paths).map_err(fn(error) { [generated_io_diag("build filesystem transaction", &error)] })?) }
        if options.locked {
            Lock.verify_locked_build_contributions(&bundle.project_root, &bundle.build_facts.package_name, evaluated.plan.fact_contributions()).map_err(fn(diagnostic) { [diagnostic] })?
            planned_generated :: selected_generated.iter().map(fn(module) { AST.ComptimeInput { path: module.path.as_str().to_string(), hash: module.source_digest.as_str().to_string() } }).collect()
            Lock.verify_locked_generated_inputs(&bundle.project_root, &planned_generated).map_err(fn(diagnostic) { [diagnostic] })?
        }
        generated := if options.execute { materialize_and_check_generated(&selected_generated, &bundle.project_root, &existing_source_paths, &selected_action_outputs, build_span, &bundle.build_facts)? } else {
            selected_generated.iter().map(fn(module) { GeneratedSourceProvenance { name: module.name.clone(), path: bundle.project_root.join(module.path.as_str()), digest: module.source_digest.clone(), source: module.source.clone() } }).collect()
        }
        executed :: if options.execute {
            execution_grants :: effective_grants(&options)
            artifact_store :: BuildArtifactStoreHandle.open().map_err(fn(detail) { [Diagnostic.error("E3505", "build artifact store is unavailable", detail, "Jet needs a writable artifact store before it can execute build actions", None)] })?
            execute_build_plan_with_front_end_and_remote_and_compiler(&evaluated.plan, &bundle.project_root, &artifact_store, &execution_grants, front_end_completion, options.remote.as_ref(), Some(&compiler_runner)).map_err(fn(error) { [build_execution_diagnostic(error)] })?
        } else { BuildExecutionResult { report: evaluated.plan.execution_report(&[]).map_err(fn(error) { [build_plan_diagnostic(&error)] })?, probes: [] } }
        install_build_execution_receipt(&evaluated.plan, &executed.report)
        if options.locked { Loader.verify_locked_dependency_sources(file)? }
        if options.execute || project_check { generated.extend(check_action_generated_sources(&evaluated.plan, &bundle.project_root, &existing_source_paths, build_span, &bundle.build_facts)?) }
        if options.execute {
            locked_provenance = generated.iter().map(fn(item) { AST.ComptimeInput { path: item.path.strip_prefix(&bundle.project_root).unwrap_or(&item.path).display().to_string(), hash: item.digest.as_str().to_string() } }).collect()
            locked_provenance.extend(evaluated.comptime_inputs.iter().cloned())
            for action in evaluated.plan.actions().iter().filter(fn(action) { selected_actions.contains(&action.id) && !action.is_compiler_owned() }) {
                for input in action.inputs {
                    path :: normalize_project_path(&bundle.project_root, OSPath.new(input.as_str()))
                    bytes :: read_build_file(&bundle.project_root, &path).map_err(fn(error) { [generated_io_diag(&action.name, &error)] })?
                    locked_provenance.push(AST.ComptimeInput { path: input.as_str().to_string(), hash: ContentDigest.from_bytes(&bytes).as_str().to_string() })
                }
                for output in action.outputs {
                    path :: normalize_project_path(&bundle.project_root, OSPath.new(output.as_str()))
                    bytes :: read_build_file(&bundle.project_root, &path).map_err(fn(error) { [generated_io_diag(&action.name, &error)] })?
                    locked_provenance.push(AST.ComptimeInput { path: output.as_str().to_string(), hash: ContentDigest.from_bytes(&bytes).as_str().to_string() })
                }
            }
            locked_provenance.sort_by(fn(a, b) { a.path.cmp(&b.path).then_with(fn() { a.hash.cmp(&b.hash) }) })
            locked_provenance.dedup_by(fn(a, b) { a.path == b.path && a.hash == b.hash })
            // Publication waits for the fresh runtime's complete sema check.
        }
        planned_bundle := if options.execute || project_check {
            project_root :: bundle.project_root.clone()
            stashed_runtime_bundle :: runtime_bundle_for_package.take()
            source_closure :: source_closure.clone()
            load_planned_runtime_bundle(file, &evaluated.plan, &generated, &selected_generated, &project_root, &source_closure, fn() {
                if stashed_runtime_bundle.is_some() { Ok(stashed_runtime_bundle.unwrap()) } else {
                    // Folded pre-build AST cannot answer the final snapshot; reparse overlays.
                    overlays :: source_closure.iter().map(fn((path, source)) { (path, source) }).collect()
                    Loader.load_entry_with_overlays(file, &overlays, false)
                }
            })?
        } else { bundle }
        planned_bundle.comptime_inputs.extend(evaluated.comptime_inputs)
        build_run = Some(BuildRun { plan: evaluated.plan, execution: executed.report, probes: executed.probes, generated: generated })
        bundle = planned_bundle
        bundle.active_os = active_os
        set_bundle_target(&bundle, options.cross_target.as_deref())
        selected_build :: build_run.as_ref().expect("selected build entry produces a build run")
        seed_build_facts_from_stamp(&bundle, &options.profile, &options.setting_overrides, selected_build.plan.fact_contributions(), &build_stamp)?
        bundle.build_facts.artifact_build = options.artifact_build
        bundle.web_partition_enforced = options.web_target
        if options.entry_fn.is_some() { swap_entry_point(&bundle, options.entry_fn.unwrap()) }
    }
    // Build entries are inert after planning and must not leak into runtime emission.
    apply_application_authority(&bundle, options.application_authority.as_ref())
    Sema.strip_build_only_entries(&bundle)
    runtime_effect_facts := if !project_check && build_run.is_none() { Some(effect_facts) } else { None }
    if project_check || (build_run.is_some() && options.execute) {
        sema_span := Trace.span("sema.check")
        (planned_diags, planned_facts) :: if options.no_os {
            (diags, facts) :: Sema.check_bundle_no_os_with_effect_facts(&bundle, compile_mode); (diags, Some(facts))
        } else if !options.gates.is_empty() {
            (diags, facts) :: Sema.check_bundle_gates_with_effect_facts(&bundle, compile_mode, options.gates); (diags, Some(facts))
        } else { (diags, facts) :: Sema.check_bundle_with_effect_facts(&bundle, compile_mode); (diags, Some(facts)) }
        sema_span.items(bundle.modules.len())
        drop(sema_span)
        planned_diags :: if planned_facts.is_some() { apply_package_effect_budget(&bundle, planned_facts.as_ref().unwrap(), planned_diags)? } else { planned_diags }
        extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, planned_facts.as_ref(), &planned_diags)
        parse_teaching :: bundle.parse_teaching.take()
        planned_lints :: classify_diagnostics(&bundle, parse_teaching.into_iter().chain(planned_diags).chain(extension_diags).collect(), false)?
        lints.extend(planned_lints)
        runtime_effect_facts = planned_facts
    }
    refresh_target_dossier(&bundle, options.no_os, options.web_target)
    if options.cross_target.is_some() { target_diags :: Sema.check_target_surface(&bundle, options.cross_target.unwrap()); lints.extend(classify_diagnostics(&bundle, target_diags, false)?) }
    if options.execute && build_run.is_some() {
