    }
    plugin_name :: if options.plugin_target { Some(PluginExport.resolve_export_name(&bundle)) } else { None }
    request :: mir_artifact_request_for_build(&bundle, compile_mode, &options.profile, options.web_target, options.plugin_target, false)
    request :: if plugin_name.is_some() { request.with_name(plugin_name.unwrap()) } else { request }
    (mir, artifact) :: lower_checked_mir_program_for(&bundle, request)
    execution := MirRustExecutionConfig.for_artifact(artifact)
