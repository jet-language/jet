        Lock.record_generated_inputs_with_lock_state(&bundle.project_root, &locked_provenance, options.locked, &build_stamp, lock_was_present).map_err(fn(diagnostic) { [diagnostic] })?
        Lock.record_build_contributions(&bundle.project_root, &bundle.build_facts.package_name, selected_build.plan.fact_contributions(), options.locked, &bundle.build_facts.stamp).map_err(fn(diagnostic) { [diagnostic] })?
    }
    if project_check {
        build_facts :: bundle.build_facts.clone()
        compile :: CompileOutput { rust: "", lints: lints, ffi: None, clinks: [], comptime_inputs: bundle.comptime_inputs.take(), web: None, plugin: None, web_partition_report: None, library: None, library_config: None, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling }
        return Ok(BuildCompileOutput { compile: compile, build: build_run, compiler_nodes: [], runtime: Some(bundle), build_facts: build_facts, runtime_effect_facts: runtime_effect_facts })
    }
    // Static graph queries need only the plan; no generated runtime exists yet.
    if !options.execute {
        if filesystem_transaction.is_some() { filesystem_transaction.as_mut().unwrap().commit() }
        return Ok(BuildCompileOutput { compile: CompileOutput { rust: "", lints: lints, ffi: None, clinks: [], comptime_inputs: bundle.comptime_inputs.take(), web: None, web_partition_report: None, plugin: None, library: None, library_config: None, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling }, build: build_run, compiler_nodes: [], runtime: None, build_facts: bundle.build_facts.clone(), runtime_effect_facts: None })
    }
    ffi :: if options.cross_target.is_some() { FFI.prepare_for_target(&bundle, options.cross_target.unwrap()) } else { FFI.prepare(&bundle) }?
    without_codegen :: without_codegen && build_run.is_none() && ffi.is_none() && bundle.cffi.libs.is_empty() && !options.web_target && !options.plugin_target && options.cross_target.is_none()
    if without_codegen {
        build_facts :: bundle.build_facts.clone()
        compile :: CompileOutput { rust: "", lints: lints, ffi: ffi, clinks: [], comptime_inputs: bundle.comptime_inputs.take(), web: None, web_partition_report: None, plugin: None, library: None, library_config: None, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling }
        if filesystem_transaction.is_some() { filesystem_transaction.as_mut().unwrap().commit() }
