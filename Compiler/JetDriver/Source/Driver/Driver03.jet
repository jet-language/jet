    execution.release_devtools_policy = release_devtools_policy_for_bundle(&bundle, &options.profile)
    execution.emit_types = true
    execution.emit_foreign = true
    execution.emit_metadata = false
    execution.emit_debug_linemap = false
    execution.emit_runtime = true
    web_release_devtools_policy :: execution.release_devtools_policy.clone()
    emit_span := Trace.span("emit")
    rust :: emit_mir_program(&mir, &MirRustConfig { target: TargetLayout.from_build_facts(&bundle.build_facts), target_kind: if options.web_target { MirRustTarget.WebWasm } else { MirRustTarget.Native }, root_prefix: "", execution: execution })
    emit_span.items(mir.functions.len())
