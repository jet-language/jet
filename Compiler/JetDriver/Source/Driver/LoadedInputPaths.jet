// The loader's actual physical input projection, not an authorization inventory.
// WatchGraph adds asset/runtime-input walks and retained comptime reads separately.
use jet_foundation.[Diagnostic]
use jet_sema.[SemaSourceOrigin]

struct JetDriverLoadedInputPaths {
    paths: [String]
    diagnostics: [Diagnostic]
    complete: Bool
    // A loader-only query has not executed comptime and cannot certify its reads.
    comptime_input_paths: [String]
    comptime_input_coverage_complete: Bool
}

fn jet_driver_query_loaded_input_paths(request: JetDriverCompileRequest) -> JetDriverLoadedInputPaths {
    loaded := jet_driver_load(request)
    paths := [String]{}
    seen := [String:Bool]{}
    // Source catalog parses these exact manifests, including failed loads.
    loop package in loaded.packages {
        if package.manifest_path == .Val(path) && seen.get(path) == None {
            seen[path] = true
            &paths.push(path)
        }
    }
    loop module_row in loaded.modules {
        index :: module_row.source_unit_index
        if index < 0 || index >= loaded.source_units.len() -> next
        if jet_driver_unit_is_core(loaded.source_units[index]) || loaded.source_units[index].source_origin == SemaSourceOrigin.CompilerGenerated -> next
        if seen.get(loaded.source_units[index].path) == None {
            seen[loaded.source_units[index].path] = true
            &paths.push(loaded.source_units[index].path)
        }
    }
    &paths.sort()
    JetDriverLoadedInputPaths{paths: ^paths, diagnostics: ^loaded.diagnostics, complete: loaded.complete, comptime_input_paths: [String]{}, comptime_input_coverage_complete: false}
}
