// Rust: crates/jet-driver/src/Foreign.rs:82
pub fn binding_cache_dir(project_root: &OSPath, language: ForeignLanguage) -> OSPath {
    project_root.join(Syntax.SOURCE_ROOT_DIR).join(language.bindings_subdir())
}
// Rust: crates/jet-driver/src/Foreign.rs:88
pub fn binding_cache_file(project_root: &OSPath, language: ForeignLanguage, lib: String) -> OSPath {
    extension :: binder_for(language).map(fn(descriptor) { descriptor.cache_extension }).unwrap_or(Syntax.FILE_EXT)
    binding_cache_dir(project_root, language).join("{lib}.{extension}")
}
// Rust: crates/jet-driver/src/Foreign.rs:95
pub fn type_stub_file(project_root: &OSPath, language: ForeignLanguage, lib: String) -> OSPath? {
    descriptor :: binder_for(language) ?? return None
    if descriptor.type_stub_file == {
        .None -> None
        .Suffix(extension) -> Val(binding_cache_dir(project_root, language).join("{lib}.{extension}"))
        .StemSuffix(suffix) -> Val(binding_cache_dir(project_root, language).join("{lib}{suffix}"))
    }
}
// Rust: crates/jet-driver/src/Foreign.rs:112
pub fn provenance_file(project_root: &OSPath, language: ForeignLanguage, lib: String) -> OSPath {
    binding_cache_dir(project_root, language).join("{lib}.provenance")
}
// Rust: crates/jet-driver/src/Foreign.rs:116
pub fn host_for(language: ForeignLanguage, target: ForeignTarget) -> ForeignHost {
    if language == {
        .C -> .DirectCAbi
        .Cpp -> .ClangCppShim
        .Rust -> .LegacyRustExtern
        .Py -> .SupervisedPythonSidecar
        .JS -> if target == { .Native -> .NativeJsWasmComponent; .Web -> .BrowserJsEngine }
        .Swift -> .SwiftCAbiBridge
        .Go -> .GoCArchive
        .Java -> .EmbeddedJvm
        .DotNet -> .EmbeddedDotNet
        .Tcl -> .EmbeddedTcl
        .Lua -> .EmbeddedLua
        .Fortran -> .FortranIsoCBinding
        .Cobol -> .GnuCobolCAbi
        .Ada -> .AdaGnatCAbi
        .Pascal -> .FreePascalCdecl
        .Dart -> .DartHostFfi
        .PowerShell -> .SupervisedPowerShell
        .Perl -> .SupervisedPerl
        .Ruby -> .SupervisedRuby
        .Php -> .SupervisedPhpPool
        .R -> .SupervisedR
        .Octave -> .SupervisedOctave
        .Com -> .WindowsComAutomation
    }
}
// Rust: crates/jet-driver/src/Foreign.rs:147
pub fn route_plan(project_root: &OSPath, namespace: ForeignNamespace, target: ForeignTarget) -> ForeignRoutePlan? {
    descriptor :: (binder_for(namespace.language) ?? return None).clone()
    host :: host_for(namespace.language, target)
    boundary :: ForeignBoundaryContract.new(descriptor, namespace.lib.clone(), ForeignBoundaryIdentity.new(
        "route:{namespace.language.root()}:{namespace.lib}", "none", descriptor.stamp(),
        "host:{host.debug()}", "toolchain:{host.debug()}", foreign_host_target()))
    Val(ForeignRoutePlan{host: host, binding_cache: binding_cache_file(project_root, namespace.language, namespace.lib), type_stub: type_stub_file(project_root, namespace.language, namespace.lib), provenance: provenance_file(project_root, namespace.language, namespace.lib), descriptor: descriptor, namespace: namespace, abi_contract: descriptor.contract, boundary: boundary})
}
// Rust: crates/jet-driver/src/Foreign.rs:181
pub fn capability_report(language: ForeignLanguage) -> ForeignAbiContract? { binder_for(language).map(fn(descriptor) { descriptor.contract }) }
// Rust: crates/jet-driver/src/Foreign.rs:188
pub fn capability_report_text() -> String {
    output := String.Builder.new()
    &output.push_str("foreign capabilities\nschema=jet-ffi-capability-report-v1\nlanguage status runtime stub contract effect provider capabilities\n")
    loop descriptor in FOREIGN_BINDERS {
        report :: descriptor.capability_report()
        capabilities :: report.capabilities.iter().map(fn(capability) { capability.debug() }).collect<[String]>().join(",")
        &output.push_str("{report.language.root()} {report.status.debug()} {descriptor.runtime.debug()} {descriptor.stub_kind.debug()} {contract_name(report.contract)} {report.effect_root} {report.provider.debug()} {capabilities}\n")
    }
    output.finish()
}
// Rust: crates/jet-driver/src/Foreign.rs:218
pub fn capability_report_json() -> String {
    rows :: FOREIGN_BINDERS.iter().map(fn(descriptor) {
        report :: descriptor.capability_report()
        capabilities :: report.capabilities.iter().map(fn(capability) { json_quote(capability.debug()) }).collect<[String]>().join(",")
        "{\"language\":{json_quote(report.language.root())},\"status\":{json_quote(report.status.debug())},\"runtime\":{json_quote(descriptor.runtime.debug())},\"stub\":{json_quote(descriptor.stub_kind.debug())},\"contract\":{json_quote(contract_name(report.contract))},\"effect\":{json_quote(report.effect_root)},\"provider\":{json_quote(report.provider.debug())},\"capabilities\":[{capabilities}]}"
    }).collect<[String]>().join(",")
    payload :: "{\"languages\":[{rows}]}"
    ffi :: StatusValue.parse(payload).expect("foreign capability payload must be valid JSON")
    StatusEnvelope.new("inspect.ffi", true).with_field("ffi", ffi).json()
}
// Rust: crates/jet-driver/src/Foreign.rs:250
fn contract_name(contract: ForeignAbiContract) -> String {
    if contract == ForeignAbiContract.C -> "C"
    else if contract == ForeignAbiContract.CXX -> "CXX"
    else if contract == ForeignAbiContract.NATIVE -> "NATIVE"
    else -> "MESSAGE"
}
// Rust: crates/jet-driver/src/Foreign.rs:262
fn json_quote(value: String) -> String {
    output := String.Builder.new()
    &output.push('"')
    loop character in value.chars() {
        if character == {
            '\\' -> &output.push_str("\\\\")
            '"' -> &output.push_str("\\\"")
            '\n' -> &output.push_str("\\n")
            '\r' -> &output.push_str("\\r")
            '\t' -> &output.push_str("\\t")
            character -> &output.push(character)
        }
    }
    &output.push('"')
    output.finish()
}
// Rust: crates/jet-driver/src/Foreign.rs:278
pub fn is_active_namespace_import(imp: &ImportDecl) -> Bool ForeignImportError! {
    imp.foreign_imports().map(fn(imports) {
        imports.into_iter().any(fn(pair) { binder_for(pair.0.language).map(fn(binder) { binder.surface == BinderSurface.Namespace && binder.status == BinderStatus.Active }).unwrap_or(false) })
    })?
}
// Rust: crates/jet-driver/src/Foreign.rs:301
#Derive(Debug, Clone)
pub struct ForeignDiagnostic {
    pub file: String
    pub source: String
    pub diagnostic: Diagnostic
}
// Rust: crates/jet-driver/src/Foreign.rs:307
pub fn assemble_active_namespaces(bundle: &ProgramBundle) -> Unit [Diagnostic]! {
    assemble_active_namespaces_with_provenance(&bundle).map_err(fn(diagnostics) { diagnostics.into_iter().map(fn(entry) { entry.diagnostic }).collect() })?
}
// Rust: crates/jet-driver/src/Foreign.rs:316
pub fn assemble_active_namespaces_with_provenance(bundle: &ProgramBundle) -> Unit [ForeignDiagnostic]! {
    // GATE #4499: tuple-key equality/hash; one materialized surface per language/library.
    surfaces := [(ForeignLanguage, String):USize]{}
    user_module_count :: bundle.modules.len()
    loop idx in 0..<user_module_count {
        imports :: all_imports(bundle.modules[idx]).iter().map(fn(import) { import.clone() }).collect<[ImportDecl]>()
        loop imp in imports {
            foreign :: if imp.foreign_imports() == {
                Ok(foreign) -> foreign
                Err(error) -> return Err([ForeignDiagnostic{file: bundle.modules[idx].display.clone(), source: bundle.modules[idx].source.clone(), diagnostic: error.diagnostic()}])
            }
            loop (ns, _) in foreign {
                if ns.language == ForeignLanguage.C -> continue
                descriptor :: binder_for(ns.language) ?? continue
                if descriptor.surface != BinderSurface.Namespace || descriptor.status != BinderStatus.Active -> continue
                // GATE #4483: selected target facts, never compiler host cfg.
                if ns.language == ForeignLanguage.Com && selected_os() != "windows" -> return Err([ForeignDiagnostic{
                    file: bundle.modules[idx].display.clone(), source: bundle.modules[idx].source.clone(),
                    diagnostic: Diagnostic.error("E3260", "`com.*` needs a Windows host", "COM automation depends on Windows apartments, the registry, and IDispatch", "build and run this module on a Windows host; use a non-COM boundary for other targets", Val(imp.span))
                }])
                key :: (ns.language, ns.lib.clone())
                target_idx :: if surfaces.get(key) == {
                    .Val(target_idx) -> target_idx
                    .None -> {
                        target_idx :: if materialize_namespace(&bundle, ns.language, ns.lib) == {
                            Ok(target_idx) -> target_idx
                            Err(diagnostics) -> {
                                path :: binding_cache_file(bundle.project_root, ns.language, ns.lib)
                                // GATE #4494: native filesystem read; original failure context uses empty source.
                                source :: fs.read_to_string(path).unwrap_or_default()
                                return Err(diagnostics.into_iter().map(fn(diagnostic) { ForeignDiagnostic{file: path.display().to_string(), source: source.clone(), diagnostic: diagnostic} }).collect())
                            }
                        }
                        surfaces[key] = target_idx
                        target_idx
                    }
                }
                &bundle.name_ledger.record_import_target(idx, imp.span, target_idx)
            }
        }
    }
}
// Rust: crates/jet-driver/src/Foreign.rs:395
fn materialize_namespace(bundle: &ProgramBundle, language: ForeignLanguage, lib: String) -> USize [Diagnostic]! {
    cache_path :: binding_cache_file(bundle.project_root, language, lib)
    alias :: synthetic_alias(language, lib)
    descriptor :: binder_for(language) ?? return Err([Diagnostic.error("E3208", "no foreign binder descriptor is registered for `{language.root()}`", "generated foreign stubs require a registered typed ABI descriptor", "register the language binder before importing its namespace", None)])
    module_idx :: bundle.modules.len()
    // GATE #4494: lossless native OSPath metadata and text reads.
    if cache_path.is_file() {
        source :: fs.read_to_string(cache_path).unwrap_or_default()
        if !source.is_empty() {
            if (language == ForeignLanguage.Cobol || language == ForeignLanguage.Com) && descriptor_stamp(source).is_none() -> return Err([Diagnostic.error("E3208", "generated `{language.root()}` binding has no ABI descriptor", "the generated stub must record the checked {language.root()} ABI contract", "regenerate the binding with `jet inspect bind {language.root()}`", None)])
            if descriptor_stamp(source) == .Val(actual) {
                if actual != descriptor.stamp() -> return Err([Diagnostic.error("E3208", "generated `{language.root()}` binding has a stale descriptor", "the generated stub and binder must use the same foreign ABI descriptor", "regenerate the binding with `jet inspect bind`", None)])
            }
            (tokens, lex_diags) :: lex_generated(source)
            if !lex_diags.is_empty() -> return Err(lex_diags)
            program := parse_with_source(tokens, source)?
            if language == ForeignLanguage.Cpp -> mark_cpp_callback_abi(&program.items)
            &bundle.modules.push(LoadedModule{path: cache_path, display: "{language.root()}.{lib}", source: source, alias: alias,
                imports: ^program.imports, items: ^program.items, script_body: ^program.script_body, block_spans: ^program.block_spans,
                web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file, no_prelude: program.no_prelude,
                default_target: program.default_target, html_path: program.html_path.clone(), policy_declarations: program.policy_declarations.clone(),
                user_policy_declarations: program.user_policy_declarations.clone(), rule_facts: ^program.rule_facts})
            return module_idx
        }
    }
    return Err([Diagnostic.error("E3208", "foreign binding cache for `{language.root()}.{lib}` is missing or empty", "an active foreign namespace needs a generated typed binding before use", "run the language binder or realize the foreign package before importing it", None)])
}
// Rust: crates/jet-driver/src/Foreign.rs:500
fn mark_cpp_callback_abi(items: &[Item]) {
    loop item in &items {
        if item != .Func(function) -> continue
        loop param in &function.params {
            if param.ty == .Fn(_, _, _, _, _, _) -> param.ty = Type.Tagged{marker: TagMarker.Internal(InternalTag.CppCallbackAbi), inner: param.ty.clone()}
        }
    }
}
// Rust: crates/jet-driver/src/Foreign.rs:516
fn synthetic_alias(language: ForeignLanguage, lib: String) -> String { "__{language.root()}_{lib}" }
// Rust: crates/jet-driver/src/Foreign.rs:520
fn descriptor_stamp(source: String) -> String? {
    source.lines().find_map(fn(line) { line.strip_prefix("// jet-ffi-descriptor=").map(fn(stamp) { stamp.to_string() }) })
}
