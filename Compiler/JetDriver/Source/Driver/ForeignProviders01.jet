// Rust: crates/jet-driver/src/Foreign.rs:25
fn all_imports(module: &LoadedModule) -> [&ImportDecl] {
    // GATE #4499: canonical Span equality/hash; preserve walk order and first occurrence.
    seen := Set<Span>{}
    imports := [&ImportDecl]{}
    loop (_, import) in walk_imports(module) {
        if &seen.insert(import.span) -> &imports.push(import)
    }
    imports
}
