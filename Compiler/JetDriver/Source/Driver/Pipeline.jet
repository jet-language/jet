fn jet_driver_has_source_file_id(files: [MIRSourceFile], identity: MIRSourceFileID) -> Bool Never! {
    loop file in files {
        if file.id.value == identity.value -> return true
    }
    false
}
fn jet_driver_source_location_for_load_module(load: JetDriverLoadResult, module_identity: String, site: Span) -> SemaSourceLocation? {
    selected_index := Int?{None}
    index := 0
    loop index < load.modules.len() {
        if load.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index :: selected_index ?? return None
    loaded_module :: load.modules[module_index]
    if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() -> return None
    sema_source_location_at(load.source_units[loaded_module.source_unit_index].source_segments, site)
}

fn jet_driver_source_location_for_registration_module(graph: SemaRegistrationGraph, module_identity: String, site: Span) -> SemaSourceLocation? {
    selected_index := Int?{None}
    index := 0
    loop index < graph.modules.len() {
        if graph.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index :: selected_index ?? return None
    sema_source_location_at(graph.modules[module_index].source_segments, site)
}

fn jet_driver_diagnostic_with_location(code: String, span: Span, location: SemaSourceLocation?, what: String, why: String, fix: String) -> Diagnostic {
    exact_location :: location ?? return jet_driver_diagnostic(code, span, what, why, fix)
    diagnostic := jet_driver_diagnostic(code, span, what, why, fix)
    diagnostic_with_source_mapping(^diagnostic, exact_location.source_path, exact_location.aggregate_start, exact_location.source_start)
}

fn jet_driver_diagnostic_at_registration_site(graph: SemaRegistrationGraph, module_identity: String, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    location := jet_driver_source_location_for_registration_module(graph, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}

fn jet_driver_diagnostic_at_loaded_site(load: JetDriverLoadResult, module_identity: String, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    location := jet_driver_source_location_for_load_module(load, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}
fn jet_driver_diagnostic_at_optional_loaded_site(load: JetDriverLoadResult, module_identity: String?, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    exact_module_identity :: module_identity ?? return jet_driver_diagnostic(code, span, what, why, fix)
    jet_driver_diagnostic_at_loaded_site(load, exact_module_identity, code, span, what, why, fix)
}

fn jet_driver_diagnostic_with_optional_location(code: String, span: Span?, location: SemaSourceLocation?, what: String, why: String, fix: String) -> Diagnostic {
    if span != None {
        site :: span
        return jet_driver_diagnostic_with_location(code, site, location, what, why, fix)
    }
    jet_driver_diagnostic_with_optional_span(code, span, what, why, fix)
}

// One checked function's owning module: what an optimizer error needs to
// locate its function after the optimizer has consumed the program.
struct JetDriverMIRFunctionOwner {
    function: MIRFunctionID
    module_id: MIRModuleID
}

fn jet_driver_mir_function_owners(program: MIRProgram) -> [JetDriverMIRFunctionOwner] {
    owners := [JetDriverMIRFunctionOwner]{}
    loop function in program.functions -> &owners.push(JetDriverMIRFunctionOwner{function: function.id, module_id: function.module_id})
    owners
}

fn jet_driver_source_location_for_mir_function(load: JetDriverLoadResult, owners: [JetDriverMIRFunctionOwner], identity: MIRFunctionID, site: Span) -> SemaSourceLocation? {
    selected_owner := JetDriverMIRFunctionOwner?{None}
    loop owner in owners {
        if owner.function.value == identity.value {
            if selected_owner != None -> return None
            selected_owner = Val(owner)
        }
    }
    function_owner :: selected_owner ?? return None
    selected_module_identity := String?{None}
    loop loaded_module in load.modules {
        if mir_module_id(loaded_module.module_identity).value == function_owner.module_id.value {
            if selected_module_identity != None -> return None
            selected_module_identity = Val(loaded_module.module_identity)
        }
    }
    module_identity :: selected_module_identity ?? return None
    jet_driver_source_location_for_load_module(load, module_identity, site)
}
fn jet_driver_attach_registration_source_location(diagnostic: Diagnostic, graph: SemaRegistrationGraph, module_identity: String) -> Diagnostic Never! {
    if diagnostic.source_path != None || diagnostic.span == None -> return ~diagnostic
    span :: diagnostic.span ?? return diagnostic
    location :: jet_driver_source_location_for_registration_module(graph, module_identity, span) ?? return diagnostic
    diagnostic_with_source_mapping(^diagnostic, location.source_path, location.aggregate_start, location.source_start)
}
fn jet_driver_module_display(relative_path: String) -> String Never! {
    parts := relative_path.split("/").to_list()
    file_name :: &parts.pop() ?? "module.jet"
    name_parts := file_name.split(".").to_list()
    if name_parts.len() > 1 -> _ := &name_parts.pop()
    file_base := name_parts.join(".")
    if file_base.len() == 0 -> file_base = "module"
    &parts.push(file_base)
    parts.join("/")
}


struct JetDriverMIRItemOrderRow {
    position: Int
    item: MIRItemRef
}

// Rows are appended in category order and stably sorted by source position
// once per module, rather than insertion-sorted per declaration.
fn jet_driver_add_mir_item_order(rows: &[JetDriverMIRItemOrderRow], position: Int, item: MIRItemRef) Never! {
    &rows.push(JetDriverMIRItemOrderRow{position: position, item: item})
}

fn jet_driver_find_lowered_function_id(functions: [MIRFunction], key: String) -> MIRFunctionID? {
    found := MIRFunctionID?{None}
    loop function in functions {
        if function.key == key {
            if found != None -> return None
            found = Val(function.id)
        }
    }
    found
}
fn jet_driver_find_lowered_type_id(types: [MIRTypeDef], key: String) -> MIRTypeID? {
    found := MIRTypeID?{None}
    loop definition in types {
        if definition.key == key {
            if found != None -> return None
            found = Val(definition.id)
        }
    }
    found
}

fn jet_driver_find_lowered_trait_id(traits: [MIRTraitDef], key: String) -> MIRTraitID? {
    found := MIRTraitID?{None}
    loop definition in traits {
        if definition.key == key {
            if found != None -> return None
            found = Val(definition.id)
        }
    }
    found
}

fn jet_driver_find_lowered_impl_id(impls: [MIRImplDef], key: String) -> MIRImplID? {
    found := MIRImplID?{None}
    loop definition in impls {
        if definition.key == key {
            if found != None -> return None
            found = Val(definition.id)
        }
    }
    found
}

fn jet_driver_find_lowered_constant_id(constants: [MIRConstantDef], key: String) -> MIRConstantID? {
    found := MIRConstantID?{None}
    loop definition in constants {
        if definition.key == key {
            if found != None -> return None
            found = Val(definition.id)
        }
    }
    found
}
fn jet_driver_has_mir_function_id(functions: [MIRFunction], identity: MIRFunctionID) -> Bool Never! {
    loop function in functions {
        if function.id.value == identity.value -> return true
    }
    false
}
fn jet_driver_mir_function_index_for_id(functions: [MIRFunction], identity: MIRFunctionID) -> Int? {
    selected := Int?{None}
    index := 0
    loop function in functions {
        if function.id.value == identity.value {
            if selected != None -> return None
            selected = Val(index)
        }
        index += 1
    }
    selected
}

// Function ID -> its row, or -1 when the ID repeats (as
// jet_driver_mir_function_index_for_id, for many lookups in one pass).
fn jet_driver_mir_function_rows(functions: [MIRFunction]) -> [U64:Int] Never! {
    rows := [U64:Int]{}
    loop (index, function) in functions {
        if rows.get(function.id.value) == None {
            &rows.add(function.id.value, index).drop("checked absent above")
        } else {
            &rows.add(function.id.value, -1).drop("a repeated identity has no single row")
        }
    }
    rows
}

fn jet_driver_loaded_module_index_for_mir_module(load: JetDriverLoadResult, identity: MIRModuleID) -> Int? {
    selected := Int?{None}
    index := 0
    loop index < load.modules.len() {
        if mir_module_id(load.modules[index].module_identity).value == identity.value {
            if selected != None -> return None
            selected = Val(index)
        }
        index += 1
    }
    selected
}

fn jet_driver_source_file_for_loaded_module(load: JetDriverLoadResult, module_index: Int) -> MIRSourceFileID? {
    if module_index < 0 || module_index >= load.modules.len() -> return None
    source_unit_index := load.modules[module_index].source_unit_index
    if source_unit_index < 0 || source_unit_index >= load.source_units.len() -> return None
    source_file := mir_source_file_id(load.source_units[source_unit_index].path)
    if !jet_driver_has_source_file_id(load.source_files, source_file) -> return None
    Val(source_file)
}

fn jet_driver_diagnostic_at_loaded_module_index(
    load: JetDriverLoadResult,
    module_index: Int?,
    code: String,
    span: Span,
    what: String,
    why: String,
    fix: String,
) -> Diagnostic {
    index :: module_index ?? return jet_driver_diagnostic(code, span, what, why, fix)
    jet_driver_diagnostic_at_loaded_site(load, load.modules[index].module_identity, code, span, what, why, fix)
}

fn jet_driver_mir_span_equal(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}
fn jet_driver_mir_access_matches_foreign_convention(access: MIRAccess, convention: AccessConvention) -> Bool Never! {
    if convention == AccessConvention.Read -> return access == MIRAccess.Read
    if convention == AccessConvention.Write -> return access == MIRAccess.Write
    access == MIRAccess.Move
}
fn jet_driver_mir_foreign_matches_checked(foreign: MIRForeign, checked: SemaCheckedForeignFunction) -> Bool Never! {
    if foreign.key != checked.key ||
       foreign.module_name != checked.module_name ||
       foreign.name != checked.name ||
       foreign.span.start != checked.span.start ||
       foreign.span.end != checked.span.end ||
       foreign.symbol != checked.symbol ||
       foreign.path != checked.path ||
       foreign.raw_scalar_abi != checked.raw_scalar_abi ||
       foreign.bridge_eligible != checked.bridge_eligible ||
       foreign.params.len() != checked.params.len() -> return false
    index := 0
    loop index < foreign.params.len() {
        mir_param := foreign.params[index]
        checked_param := checked.params[index]
        if mir_param.index != checked_param.index ||
           mir_param.name != checked_param.name ||
           mir_param.span.start != checked_param.span.start ||
           mir_param.span.end != checked_param.span.end ||
           !jet_driver_mir_access_matches_foreign_convention(mir_param.access, checked_param.convention) ||
           mir_param.public_label != checked_param.public_label ||
           mir_param.variadic != checked_param.variadic ||
           mir_param.default_present != checked_param.default_present -> return false
        index += 1
    }
    true
}

fn jet_driver_mir_type_equal(left: MIRType, right: MIRType) -> Bool Never! {
    left.identity == right.identity &&
    mir_type_same_checked_type(left, right) &&
    left.layout.abi == right.layout.abi &&
    left.layout.size == right.layout.size &&
    left.layout.align == right.layout.align
}

fn jet_driver_mir_ownership_equal(left: MIROwnership, right: MIROwnership) -> Bool Never! {
    left.mode == right.mode &&
    left.drop == right.drop &&
    left.moved == right.moved &&
    left.last_use == right.last_use &&
    left.gc_root == right.gc_root
}

fn jet_driver_mir_callback_param_equal(left: MIRParam, right: MIRParam) -> Bool Never! {
    left.index == right.index &&
    left.name == right.name &&
    jet_driver_mir_span_equal(left.span, right.span) &&
    jet_driver_mir_type_equal(left.ty, right.ty) &&
    left.access == right.access &&
    jet_driver_mir_ownership_equal(left.ownership, right.ownership) &&
    left.public_label == right.public_label &&
    left.variadic == right.variadic &&
    left.default_present == right.default_present
}

fn jet_driver_mir_callback_rows_equal(left: MIRCallbackAdapter, right: MIRCallbackAdapter) -> Bool Never! {
    if left.id.value != right.id.value ||
       left.symbol != right.symbol ||
       left.function.value != right.function.value ||
       left.abi != right.abi ||
       left.managed != right.managed ||
       left.plan_digest != right.plan_digest ||
       left.callback_identity != right.callback_identity ||
       left.params.len() != right.params.len() -> return false
    if {
        left.return_type == None -> {
            if right.return_type != None -> return false
        }
        else -> {
            if right.return_type == None -> return false
            left_type :: left.return_type ?? return false
            right_type :: right.return_type ?? return false
            if !jet_driver_mir_type_equal(left_type, right_type) -> return false
        }
    }
    index := 0
    loop index < left.params.len() {
        if !jet_driver_mir_callback_param_equal(left.params[index], right.params[index]) -> return false
        index += 1
    }
    true
}

fn jet_driver_mir_field_rows_equal(left: MIRFieldRow, right: MIRFieldRow) -> Bool Never! {
    if left.id.value != right.id.value ||
       left.owner.value != right.owner.value ||
       left.field.id.value != right.field.id.value ||
       left.field.name != right.field.name ||
       left.field.shape_names.text != right.field.shape_names.text ||
       left.field.shape_names.json != right.field.shape_names.json ||
       left.field.shape_names.cbor != right.field.shape_names.cbor ||
       left.field.shape_names.csv != right.field.shape_names.csv ||
       left.field.shape_names.toml != right.field.shape_names.toml ||
       left.field.shape_names.yaml != right.field.shape_names.yaml ||
       left.field.shape_names.xml != right.field.shape_names.xml ||
       left.field.shape_names.args != right.field.shape_names.args ||
       left.field.shape_names.env != right.field.shape_names.env ||
       left.field.shape_names.db != right.field.shape_names.db ||
       left.field.shape_names.layout != right.field.shape_names.layout ||
       left.field.skip != right.field.skip ||
       !jet_driver_mir_type_equal(left.field.ty, right.field.ty) ||
       !jet_driver_mir_span_equal(left.field.span, right.field.span) ||
       left.field.public != right.field.public ||
       left.field.package_public != right.field.package_public ||
       left.field.computed != right.field.computed ||
       left.field.has_default != right.field.has_default ||
       left.field.redact != right.field.redact -> return false
    true
}

fn jet_driver_mir_callback_diagnostic(
    load: JetDriverLoadResult,
    functions: [MIRFunction],
    callback: MIRCallbackAdapter,
    what: String,
    why: String,
    fix: String,
) -> Diagnostic {
    function_index :: jet_driver_mir_function_index_for_id(functions, callback.function) ?? {
        return jet_driver_diagnostic_without_span("E0003", what, why, fix)
    }
    module_index := jet_driver_loaded_module_index_for_mir_module(load, functions[function_index].module_id)
    jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", functions[function_index].span, what, why, fix)
}

fn jet_driver_merge_mir_callbacks(
    load: JetDriverLoadResult,
    functions: [MIRFunction],
    callbacks: [MIRCallbackAdapter],
    diagnostics: &[Diagnostic],
) -> [MIRCallbackAdapter]? {
    // Per-id occurrence counts of the lowered functions and the merged row
    // per callback id, built once instead of rescanning per callback.
    function_counts := [String:Int]{}
    loop index in 0..<functions.len() {
        function_key :: "{functions[index].id.value}"
        function_counts[function_key] = (function_counts.get(function_key) ?? 0) + 1
    }
    merged := [MIRCallbackAdapter]{}
    merged_index := [String:Int]{}
    loop callback in callbacks {
        if callback.id.value == 0 {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "Codegen produced a callback adapter with a zero stable identity", "every callback adapter ID names one checked closure ABI row", "preserve the canonical callback ID through Codegen"))
            return None
        }
        if (function_counts.get("{callback.function.value}") ?? 0) != 1 {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "a callback adapter targets no unique lowered MIR function", "callback adapter targets resolve to the exact nested or top-level closure function", "retain the callback target function in the lowered MIR function set"))
            return None
        }
        callback_key :: "{callback.id.value}"
        existing_index :: merged_index.get(callback_key) ?? {
            merged_index[callback_key] = merged.len()
            &merged.push(callback)
            next
        }
        if !jet_driver_mir_callback_rows_equal(merged[existing_index], callback) {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "two callback adapters with one stable ID have conflicting checked rows", "callback IDs resolve to one exact symbol, function, ordered signature, ABI, and managed identity", "preserve identical callback adapter facts for each use"))
            return None
        }
    }
    Val(merged)
}

fn jet_driver_mir_field_conflict_diagnostic(
    load: JetDriverLoadResult,
    function: MIRFunction,
) -> Diagnostic {
    module_index := jet_driver_loaded_module_index_for_mir_module(load, function.module_id)
    jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "comptime lowering produced conflicting MIR field rows with one stable ID", "field identities preserve one exact owner and declaration payload across nested functions", "retain the canonical field metadata through comptime lowering")
}

fn jet_driver_merge_comptime_function(
    lowered: &JetCodegenFunctions,
    item: JetCodegenLoweredFunction,
    load: JetDriverLoadResult,
    diagnostics: &[Diagnostic],
) -> Bool {
    loop field in item.fields {
        loop existing in lowered.fields {
            if existing.id.value == field.id.value && !jet_driver_mir_field_rows_equal(existing, field) {
                &diagnostics.push(jet_driver_mir_field_conflict_diagnostic(load, item.function))
                return false
            }
        }
    }
    &lowered.functions.push(item.function)
    loop function in item.nested_functions -> &lowered.nested_functions.push(function)
    loop callback in item.callbacks -> &lowered.callbacks.push(callback)
    loop field in item.fields {
        found := false
        loop existing in lowered.fields {
            if existing.id.value == field.id.value -> found = true
        }
        if !found -> &lowered.fields.push(field)
    }
    loop call in item.core_calls {
        found := false
        loop existing in lowered.core_calls {
            if existing.id.value == call.id.value -> found = true
        }
        if !found -> &lowered.core_calls.push(call)
    }
    loop call in item.prelude_calls {
        found := false
        loop existing in lowered.prelude_calls {
            if existing.id.value == call.id.value -> found = true
        }
        if !found -> &lowered.prelude_calls.push(call)
    }
    loop usage in item.used_core {
        found := false
        loop existing in lowered.used_core {
            if existing == usage -> found = true
        }
        if !found -> &lowered.used_core.push(usage)
    }
    true
}
fn jet_driver_validate_lowered_function_owner(
    load: JetDriverLoadResult,
    function: MIRFunction,
    diagnostics: &[Diagnostic],
) {
    module_index := jet_driver_loaded_module_index_for_mir_module(load, function.module_id)
    if {
        module_index == None -> {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function has no exact loaded-module owner", "lowered MIR functions retain the exact module identity of their loaded source owner", "retain the loaded module identity through nested lambda lowering"))
        }
        else -> {
            module_index_value :: module_index ?? return
            expected_source_file := jet_driver_source_file_for_loaded_module(load, module_index_value)
            if {
                expected_source_file == None -> {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function owner has no exact authorized source-file record", "module ownership resolves through one loaded source unit and immutable source-file identity", "preserve the exact loaded module source identity through Codegen"))
                }
                else -> {
                    source_file :: expected_source_file ?? return
                    if function.source_file.value != source_file.value {
                        &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function points at a different module's source file", "MIR function provenance matches the exact source file of its checked module owner", "preserve the owning module source-file ID through Codegen"))
                    }
                }
            }
        }
    }
    if function.id.value == 0 {
        &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "MIR lowering produced a function with a zero stable identity", "MIR function IDs are stable identities derived from checked function facts", "report the invalid Codegen function identity"))
    }
}


fn jet_driver_mir_import_id(import: SemaRegistrationImport) -> MIRImportID Never! {
    source := import.source_module_identity
    target := import.target_module_identity
    identity := "{source.len()}:{source}:{import.declaration.span.start}:{import.declaration.span.end}:{target.len()}:{target}"
    MIRImportID{value: stable_id("mir-import", identity)}
}

fn jet_driver_mir_visibility(visibility: Int) -> MIRVisibility Never! {
    if visibility >= 2 -> return MIRVisibility.Public
    if visibility >= 1 -> return MIRVisibility.Package
    MIRVisibility.Private
}

// Rust `artifact_plan.rs` `core_import_module_path`: a Core `.[…]` list
// (`use core.mem`, `use core.encoding.[json]`) names Core namespaces, which
// have no checked source-module row, so the edge stays a path import instead
// of a member list. Mixed targets keep the written prefix.
fn jet_driver_core_import_module_path(module_alias: String, members: [ImportedItem]) -> String? Never! {
    if module_alias != "core" && !module_alias.starts_with("core.") -> return None
    target := String?{None}
    loop member in members {
        module_path :: jet_driver_core_list_module(module_alias, member.original) ?? return None
        if target == .Val(existing) {
            if existing != module_path -> return Val(~module_alias)
        }
        target = Val(module_path)
    }
    Val(target ?? ~module_alias)
}

// The Core module one list member selects (Rust `core_list_path`): the member
// itself when it names a Core module, otherwise the longest known Core module
// prefix that leaves a non-empty item path.
fn jet_driver_core_list_module(prefix: String, member: String) -> String? Never! {
    full :: "{prefix}.{member}"
    if core_module_export(full) != None -> return Val(full)
    parts :: full.split(".").to_list()
    split := parts.len() - 1
    loop split >= 1 {
        module_parts := [String]{}
        loop index in 0..<split -> &module_parts.push(parts[index])
        item_parts := [String]{}
        loop index in split..<parts.len() -> &item_parts.push(parts[index])
        module_path :: module_parts.join(".")
        if core_module_export(module_path) != None && item_parts.join(".") != "" -> return Val(module_path)
        split -= 1
    }
    None
}

// The member rows of one checked unqualified import, each naming its
// canonical lowered MIR declaration.
fn jet_driver_mir_import_items(
    load: JetDriverLoadResult,
    import: SemaRegistrationImport,
    lowered: JetCodegenFunctions,
    diagnostics: &[Diagnostic],
) -> [MIRImportItem]? {
    items := [MIRImportItem]{}
    loop binding in import.bindings {
        item := MIRItemRef?{None}
        if binding.symbol.kind == {
            SymbolKind.Function -> {
                function_id := jet_driver_find_lowered_function_id(lowered.functions, binding.symbol.id.key)
                if function_id == None {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported function has no matching lowered MIR function", "import bindings preserve canonical target symbol identities", "retain the exact checked function key through code generation"))
                    return None
                }
                function_value :: function_id ?? return None
                item = Val(MIRItemRef.Function{id: function_value})
            }
            SymbolKind.Type -> {
                type_id := jet_driver_find_lowered_type_id(lowered.types, binding.symbol.id.key)
                if type_id == None {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported type has no matching lowered MIR type", "type import bindings preserve canonical target symbol identities", "retain the exact checked type key through code generation"))
                    return None
                }
                type_value :: type_id ?? return None
                item = Val(MIRItemRef.Type{id: type_value})
            }
            SymbolKind.Trait -> {
                trait_id := jet_driver_find_lowered_trait_id(lowered.traits, binding.symbol.id.key)
                if trait_id == None {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported trait has no matching lowered MIR trait", "trait import bindings preserve canonical target symbol identities", "retain the exact checked trait key through code generation"))
                    return None
                }
                trait_value :: trait_id ?? return None
                item = Val(MIRItemRef.Trait{id: trait_value})
            }
            SymbolKind.Constant -> {
                constant_id := jet_driver_find_lowered_constant_id(lowered.constants, binding.symbol.id.key)
                if constant_id == None {
                    comptime_only := false
                    if binding.declaration == {
                        Val(declaration) -> {
                            if declaration == {
                                .Const(definition) -> comptime_only = definition.is_comptime
                                else -> {}
                            }
                        }
                        else -> {}
                    }
                    if comptime_only -> next
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported runtime constant has no matching lowered MIR constant", "runtime import bindings preserve canonical target constant identities", "retain the lowered constant row or erase only a checked compile-time-only import"))
                    return None
                }
                constant_value :: constant_id ?? return None
                item = Val(MIRItemRef.Constant{id: constant_value})
            }
            else -> {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "the checked import refers to an item kind that MIR lowering does not support", "the backend-neutral import graph lowers canonical type, trait, function, and constant identities", "add a canonical MIR item reference before lowering this import kind"))
                return None
            }
        }
        resolved_item :: item ?? {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "a checked import binding has no MIR item identity", "every retained import binding names one canonical lowered MIR declaration", "retain the exact lowered item identity"))
            return None
        }
        &items.push(MIRImportItem{
            original: binding.original,
            local: binding.local,
            item: resolved_item,
        })
    }
    items
}

fn jet_driver_mir_import(
    load: JetDriverLoadResult,
    import: SemaRegistrationImport,
    lowered: JetCodegenFunctions,
    diagnostics: &[Diagnostic],
) -> MIRImport? {
    kind := MIRImportKind?{None}
    if import.declaration.kind == {
        .File(path, _) -> kind = Val(MIRImportKind.File{path: path})
        .Module(name, _) -> kind = Val(MIRImportKind.Module{path: name})
        .Unqualified(module_alias, _, members, _, _) -> {
            core_path :: jet_driver_core_import_module_path(module_alias, members)
            if core_path == .Val(path) -> kind = Val(MIRImportKind.Module{path: path})
            if core_path == None {
                items :: jet_driver_mir_import_items(load, import, lowered, &diagnostics) ?? return None
                kind = Val(MIRImportKind.Unqualified{module_id: mir_module_id(import.target_module_identity), items: items})
            }
        }
    }
    resolved_kind :: kind ?? return None
    version := String?{None}
    if import.declaration.inline_version != None {
        inline_version :: import.declaration.inline_version ?? return None
        version = Val(inline_version.text)
    }
    return Val(MIRImport{
        id: jet_driver_mir_import_id(import),
        module_id: mir_module_id(import.source_module_identity),
        visibility: jet_driver_mir_visibility(import.visibility),
        alias: import.declaration.alias,
        kind: resolved_kind,
        span: import.declaration.span,
        version: version,
    })
}

fn jet_driver_find_graph_import(imports: [SemaRegistrationImport], source_identity: String, span: Span) -> SemaRegistrationImport? {
    found := SemaRegistrationImport?{None}
    loop import in imports {
        if import.source_module_identity == source_identity && import.declaration.span.start == span.start && import.declaration.span.end == span.end {
            if found != None -> return None
            found = Val(import)
        }
    }
    found
}
// D-MOD-CYCLE1=A: a dependency package is checked as its own package, so an
// importer never repeats its reports. A dependency with errors still fails
// the importer, once per dependency package (E0626), naming the check that
// owns those errors.
fn jet_driver_summarize_dependency_reports(load: JetDriverLoadResult, diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    entry_root := ""
    loop package in load.packages {
        if package.identity == load.package_identity -> entry_root = package.root_path
    }
    kept := [Diagnostic]{}
    failing := [Bool]{}
    loop package in load.packages -> &failing.push(false)
    loop diagnostic in diagnostics {
        // Diagnostics name a source by its display path; package roots are canonical.
        source_path :: diagnostic.source_path ?? ""
        path :: if source_path.len() == 0 -> "" else -> jet_driver_physical_path(entry_root, source_path)
        owner := -1
        owner_length := -1
        loop (index, package) in load.packages {
            if path.len() == 0 || package.root_path.len() <= owner_length || !jet_driver_path_within(path, package.root_path) -> next
            owner = index
            owner_length = package.root_path.len()
        }
        if owner < 0 || load.packages[owner].identity == load.package_identity || load.packages[owner].identity.starts_with("source-root:") {
            &kept.push(diagnostic)
            next
        }
        if diagnostic.severity == DIAGNOSTIC_ERROR -> failing[owner] = true
    }
    loop index in 0..<load.packages.len() {
        if !failing[index] -> next
        package :: load.packages[index]
        root :: jet_driver_display_path(entry_root, package.root_path)
        &kept.push(jet_driver_diagnostic_without_span("E0626", "Dependency package `{package.name}` has errors", "a dependency package is checked as its own package, so its errors are reported by its own check and never repeated by the packages that import it", "run `jet check {root}` and fix the errors there"))
    }
    kept
}

fn jet_driver_compile_result(
    load: JetDriverLoadResult,
    diagnostics: [Diagnostic],
    entry_function: MIRFunctionID?,
    mir: ^MIRProgram?,
    emitted_source: String?,
    emit_manifest: JetRustEmitManifest?,
    failed_stage: JetDriverStage?,
    complete: Bool,
    trace: JetDriverCompileTrace,
) -> JetDriverCompileResult Never! {
    JetDriverCompileResult{
        diagnostics: jet_driver_summarize_dependency_reports(load, diagnostics),
        generated_source_files: load.generated_source_files,
        package_identity: load.package_identity,
        entry_module_identity: load.entry_module_identity,
        entry_function: entry_function,
        runtime_artifact: None,
        web_artifact: None,
        web_artifacts: None,
        mir: ^mir,
        emitted_source: emitted_source,
        emit_manifest: emit_manifest,
        comptime_stdout: trace.stdout.join(""),
        comptime_stderr: trace.stderr.join(""),
        soft_stop: trace.soft_stop,
        exit_code: trace.exit_code,
        failed_stage: failed_stage,
        complete: complete,
        internal_problem: None,
    }
}

fn jet_driver_entry_selection(load: JetDriverLoadResult) -> JetDriverPackageEntry? {
    loop package in load.packages {
        if package.identity == load.package_identity -> return package.entry
    }
    None
}

fn jet_driver_resolve_entry_function(
    load: JetDriverLoadResult,
    semantic_graph: SemaGraphResult,
    functions: [MIRFunction],
    diagnostics: &[Diagnostic],
) -> MIRFunctionID? {
    entry :: jet_driver_entry_selection(load) ?? return None
    target_module_identity := load.entry_module_identity
    if entry.module_alias != None {
        alias :: entry.module_alias ?? return None
        target := String?{None}
        loop import in load.imports {
            if import.source_module_identity != load.entry_module_identity || import.declaration.alias != alias || !jet_driver_import_is_module_edge(import.declaration.kind) -> next
            if target != None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0105", import.declaration.span, "the package entry module alias resolves more than once", "an explicit `entry: module_alias.function` binds through one loaded module edge", "retain exactly one import for the entry module alias"))
                return None
            }
            target = Val(import.target_module_identity)
        }
        if target == None {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry module alias is not imported by the selected source module", "qualified entry bindings resolve through one exact File or Module import alias", "import the entry module under the manifest's explicit alias"))
            return None
        }
        target_module_identity = target ?? return None
    }
    module_found := false
    function_key := symbol_id(SymbolKind.Function, target_module_identity, "", entry.function_name).key
    loop semantic_module in semantic_graph.modules {
        if semantic_module.module_identity != target_module_identity -> next
        module_found = true
        loop function in semantic_module.functions {
            if function.key != function_key -> next
            function_id := jet_driver_find_lowered_function_id(functions, function.key)
            if function_id == None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, semantic_module.module_identity, "E0003", function.source_span, "the declared package entry has no unique MIR function identity", "the private entry binding is resolved from its exact registered function symbol", "retain the canonical function key through MIR lowering"))
                return None
            }
            return function_id
        }
    }
    if {
        !module_found -> {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry target module is not present in semantic results", "entry identity is fixed by the native-authorized module graph and explicit package binding", "retain the resolved entry target module in the checked graph"))
        }
        else -> {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package manifest entry function is not declared in the resolved entry module", "entry resolution uses the explicit `outputs.*.entry` function binding", "declare the selected function in the entry module referenced by the manifest"))
        }
    }
    None
}
fn jet_driver_empty_compile_trace() -> JetDriverCompileTrace Never! {
    JetDriverCompileTrace{stdout: [String]{}, stderr: [String]{}, soft_stop: false, exit_code: None}
}

fn jet_driver_record_eval_result(trace: &JetDriverCompileTrace, result: JetEvalResult) Never! {
    if result.stdout.len() > 0 -> &trace.stdout.push(result.stdout)
    if result.stderr.len() > 0 -> &trace.stderr.push(result.stderr)
    if result.exit_code != None -> trace.exit_code = result.exit_code
    if result.soft_stop -> trace.soft_stop = true
}

fn jet_driver_inferred_layer_debug(layer: MIRRuntimeLayer) -> String Never! {
    if layer == {
        .Core -> "Core"
        .Alloc -> "Alloc"
        .Std -> "Std"
    }
}

fn jet_driver_package_allocator_debug(policy: MIRAllocatorPolicy) -> String? {
    if policy == {
        .HostedDefault -> return Val("HostedDefault")
        .Counting(cap) -> {
            if cap == None -> return Val("Counting {{ cap: None }}")
            size :: cap
            return Val("Counting {{ cap: Some(ByteSize {{ bytes: {size.bytes} }}) }}")
        }
        else -> None
    }
}

fn jet_driver_host_os_key(value: String) -> String Never! {
    if value == "windows" || value == "Windows" || value == "OS.Windows" -> return "windows"
    if value == "macos" || value == "MacOS" || value == "OS.MacOS" -> return "macos"
    if value == "linux" || value == "Linux" || value == "OS.Linux" -> return "linux"
    ""
}

// D-CONF-READ1=A: the build snapshot sema folds `$package.*` and `$build.*`
// from (Rust `seed_build_facts_from_stamp`). A manifest package names itself;
// the manifest-less rung uses the entry file stem and version `0.0.0`. The
// toolchain stamp is the compiler's own package version.
fn jet_driver_build_facts(load: JetDriverLoadResult, request: JetDriverCompileRequest, target_machine: MIRTargetMachine) -> SemaBuildFacts Never! {
    package_name := ""
    package_version := ""
    loop package in load.packages {
        if package.identity == load.package_identity {
            package_name = package.name
            package_version = package.version
        }
    }
    if package_name.len() == 0 {
        segments :: request.authorized_sources.entry_path.split("/").to_list()
        file :: segments[segments.len() - 1]
        package_name = if file.ends_with(".jet") -> file.slice(0, file.len() - 4) else -> file
    }
    if package_name.len() == 0 -> package_name = "script"
    if package_version.len() == 0 -> package_version = "0.0.0"
    host_os := ""
    if request.host_facts.active_os == .Val(raw_os) -> host_os = jet_driver_host_os_key(raw_os)
    toolchain := ""
    if request.host_facts.compiler_identity == .Val(identity) -> toolchain = jet_target_package_version_from_compiler_identity(identity) ?? ""
    SemaBuildFacts{
        package_name: package_name,
        package_version: package_version,
        os: jet_target_active_os_name(target_machine.triple, host_os),
        profile: "dev",
        stamp_git: None,
        stamp_dirty: false,
        stamp_toolchain: toolchain,
        stamp_at: "",
    }
}

fn jet_driver_selected_target_machine(
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> MIRTargetMachine? {
    target_triple :: request.host_facts.target_triple ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its target triple", "target layout and machine identity use only the raw target identity authorized by Host", "supply the compiler target triple through HostFacts"))
        return None
    }
    if target_triple.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an empty target triple", "target layout and machine identity require the exact selected triple", "supply the compiler target triple through HostFacts"))
        return None
    }
    compiler_identity :: request.host_facts.compiler_identity ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its compiler identity", "target layout provenance is bound to the exact compiler identity", "supply compiler identity through HostFacts"))
        return None
    }
    compiler_version :: jet_target_package_version_from_compiler_identity(compiler_identity) ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native compiler identity has no parseable exact package version", "target layout facts are versioned by the compiler identity, not the selected program package", "supply a canonical `name@version#build-id` compiler identity"))
        return None
    }
    web_target := if request.target == {
        .Native -> false
        .Web(_, _, _) -> true
    }
    if web_target && request.eval_config.runtime_execution {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the Web compile target cannot request the Cranelift runtime tier", "Web publication uses the checked Web artifact plan and AOT Wasm emitter", "select Native runtime execution or Web AOT publication explicitly"))
        return None
    }
    Val(jet_target_machine_for_facts(false, web_target, target_triple, compiler_version))
}

fn jet_driver_package_facts(
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    target_machine: MIRTargetMachine,
    used_core: [String],
    inferred_layer: MIRRuntimeLayer,
    hardware_use: MIRTargetHardwareUse,
    diagnostics: &[Diagnostic],
) -> MIRPackageFacts? {
    package := JetDriverPackageInfo?{None}
    loop candidate in load.packages {
        if candidate.identity == load.package_identity {
            if package != None {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package identity resolves to more than one authorized root", "package facts have exactly one manifest and source root", "retain one canonical package identity in the authorized graph"))
                return None
            }
            package = Val(candidate)
        }
    }
    if package == None {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package identity has no authorized root facts", "MIR package facts are derived only from the selected authorized source root", "preserve the selected package root through loading"))
        return None
    }
    selected :: package ?? return None
    if selected.root_index < 0 || selected.root_index >= request.authorized_sources.roots.len() {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package root index is outside the authorized snapshot", "package provenance remains inside the native-authorized root table", "retain the exact authorized root index selected by package loading"))
        return None
    }
    target_triple :: request.host_facts.target_triple ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its target triple", "target facts may use only the raw target identity authorized by Host", "supply the compiler target triple through HostFacts"))
        return None
    }
    if target_triple.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an empty target triple", "target layout and machine identity require the exact selected triple", "supply the compiler target triple through HostFacts"))
        return None
    }
    compiler_identity :: request.host_facts.compiler_identity ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its compiler identity", "target layout provenance is bound to the exact compiler identity", "supply compiler identity through HostFacts"))
        return None
    }
    compiler_version := jet_target_package_version_from_compiler_identity(compiler_identity)
    if compiler_version == None {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native compiler identity has no parseable exact package version", "target layout facts are versioned by the compiler identity, not the selected program package", "supply a canonical `name@version#build-id` compiler identity"))
        return None
    }
    web_target := if request.target == {
        .Native -> false
        .Web(_, _, _) -> true
    }
    host_os := ""
    triple_has_os := target_triple.contains("windows") || target_triple.contains("apple") || target_triple.contains("darwin") || target_triple.contains("linux")
    if web_target || !triple_has_os {
        raw_host_os :: request.host_facts.active_os ?? {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted active OS provenance required by the selected target", "the Web target has no OS component and an unrecognized native triple requires an explicit host OS", "supply active OS through HostFacts"))
            return None
        }
        host_os = jet_driver_host_os_key(raw_host_os)
        if host_os.len() == 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an unsupported active OS fact", "active OS facts use the closed Linux, MacOS, or Windows vocabulary", "supply the canonical active OS through HostFacts"))
            return None
        }
    }
    if !web_target && target_machine.triple != target_triple {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected target machine no longer matches HostFacts", "Sema, machine policy, and package layout facts share the exact selected triple", "reuse the target machine selected before registration"))
        return None
    }
    active_os := jet_target_active_os_name(target_machine.triple, host_os)
    artifact_target := MIRArtifactTarget.RustAOT
    artifact_tier := "aot"
    if {
        web_target -> {
            artifact_target = MIRArtifactTarget.Web
            artifact_tier = "web"
        }
        request.eval_config.runtime_execution -> {
            artifact_target = MIRArtifactTarget.Cranelift
            artifact_tier = "cranelift"
        }
    }
    dossier := jet_target_dossier_for_usage(target_machine, used_core, artifact_tier, compiler_identity, "none")
    allocator :: jet_driver_package_allocator_debug(selected.allocator_policy) ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package allocator has no canonical private-Driver representation", "MIR package facts preserve the parsed program allocator without guessing provider identities", "select a supported hosted allocator policy"))
        return None
    }
    package_version := selected.version
    if package_version.len() == 0 -> package_version = "0.0.0"
    root := request.authorized_sources.roots[selected.root_index]
    uses_arrow := false
    loop usage in used_core {
        if usage == "core.data.arrow" || usage.starts_with("core.data.arrow.") -> uses_arrow = true
    }
    // The project root is relative to the entry root (`jet_driver_display_path`),
    // so the emitted program never records where the project was checked out.
    Val(MIRPackageFacts{
        project_root: jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), root.canonical_path),
        edition: selected.edition,
        runtime_parts: jet_ring_runtime_parts_for_used_core(used_core),
        uses_arrow: uses_arrow,
        active_os: active_os,
        inferred_layer: jet_driver_inferred_layer_debug(inferred_layer),
        allocator: allocator,
        package_version: package_version,
        artifact_target: Val(artifact_target),
        target_dossier: dossier,
        web_app: None,
        authority_needs: selected.authority_needs,
        hardware_use: hardware_use,
        hardware_profile: None,
        hardware_profile_id: "",
        hardware_capabilities: [String]{},
        hardware_setups: [MIRHardwareSetup]{},
    })
}

// Run-wide lookups every function closure of one comptime run shares, built
// once instead of rescanning the graph or the checked functions per lookup.
struct JetDriverComptimeRunIndex {
    // Function key -> the module that registers it; `ambiguous_owners` holds
    // the keys registered more than once, which have no unique owner.
    owners: [String:String]
    ambiguous_owners: [String:Bool]
    // `module\nkey` -> the first row of that function in the run's checked
    // functions.
    checked_rows: [String:Int]
}

fn jet_driver_comptime_run_index(graph: SemaRegistrationGraph, checked_functions: [SemaComptimeFunctionResult]) -> JetDriverComptimeRunIndex Never! {
    index := JetDriverComptimeRunIndex{owners: [String:String]{}, ambiguous_owners: [String:Bool]{}, checked_rows: [String:Int]{}}
    loop semantic_module in graph.modules {
        loop function in semantic_module.functions -> jet_driver_comptime_owner_add(&index, function.symbol.id.key, semantic_module.module_identity)
        loop nominal in semantic_module.nominals {
            loop function in nominal.methods -> jet_driver_comptime_owner_add(&index, function.symbol.id.key, semantic_module.module_identity)
        }
        loop implementation in semantic_module.impls {
            loop function in implementation.methods -> jet_driver_comptime_owner_add(&index, function.symbol.id.key, semantic_module.module_identity)
        }
    }
    loop (row, checked) in checked_functions {
        key :: "{checked.module_identity}\n{checked.function_key}"
        if index.checked_rows.get(key) == None -> index.checked_rows[key] = row
    }
    index
}

fn jet_driver_comptime_owner_add(index: &JetDriverComptimeRunIndex, function_key: String, module_identity: String) Never! {
    if index.owners.get(function_key) != None {
        index.ambiguous_owners[function_key] = true
        return
    }
    index.owners[function_key] = module_identity
}

// The one module that registers `function_key`, or None when no module or
// more than one does.
fn jet_driver_comptime_function_owner(index: JetDriverComptimeRunIndex, function_key: String) -> String? {
    if index.ambiguous_owners.get(function_key) != None -> return None
    index.owners.get(function_key)
}

struct JetDriverComptimeFunctionRef {
    module_identity: String
    function_key: String
}

struct JetDriverComptimeFunctionClosure {
    functions: [TFunc]
    waiting_dependencies: [String]
    complete: Bool
    // Each incomplete reachable function's recorded causes, keyed by function.
    incomplete_reasons: [String]{[String]{}}
}

struct JetDriverComptimeWaitRow {
    key: String
    name: String
    module_identity: String
    span: Span
    dependencies: [String]
}

fn jet_driver_comptime_function_ref_add(refs: &[JetDriverComptimeFunctionRef], queued: &[String:Bool], module_identity: String, function_key: String) Never! {
    key :: "{module_identity}\n{function_key}"
    if queued.get(key) != None -> return
    queued[key] = true
    &refs.push(JetDriverComptimeFunctionRef{module_identity: module_identity, function_key: function_key})
}

fn jet_driver_comptime_wait_add(dependencies: &[String], key: String) Never! {
    loop previous in dependencies {
        if previous == key -> return
    }
    &dependencies.push(key)
}

// `environment` is the run's sema_comptime_environment and `available` its
// constant keys: every function check re-targets the environment instead of
// copying the graph per function. A function the run already checked
// completely is reused from `checked_functions`.
fn jet_driver_comptime_function_closure(
    graph: SemaRegistrationGraph,
    environment: &SemaScopeEnvironment,
    available: SemaComptimeAvailableConstants,
    index: &JetDriverComptimeRunIndex,
    memory_plan: SemaFunctionMemoryPlan,
    values: [SemaComptimeItemValue],
    checked_functions: &[SemaComptimeFunctionResult],
    request: SemaComptimeItemRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeFunctionClosure {
    // Each function enters the queue once, so the queue is also the set of
    // functions processed.
    queue := [JetDriverComptimeFunctionRef]{}
    queued := [String:Bool]{}
    loop call in request.calls -> jet_driver_comptime_function_ref_add(&queue, &queued, call.module_identity, call.callee_key)
    loop function_key in request.reachable_function_keys {
        module_identity := jet_driver_comptime_function_owner(index, function_key)
        if module_identity == None {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
            return JetDriverComptimeFunctionClosure{functions: [TFunc]{}, waiting_dependencies: [String]{}, complete: false}
        }
        owner_identity :: module_identity ?? return JetDriverComptimeFunctionClosure{functions: [TFunc]{}, waiting_dependencies: [String]{}, complete: false}
        jet_driver_comptime_function_ref_add(&queue, &queued, owner_identity, function_key)
    }
    functions := [TFunc]{}
    waiting := [String]{}
    complete := true
    incomplete_reasons := [String]{}
    cursor := 0
    loop cursor < queue.len() {
        current := queue[cursor]
        cursor += 1
        checked_key :: "{current.module_identity}\n{current.function_key}"
        reused_row := -1
        if index.checked_rows.get(checked_key) == .Val(row) {
            if checked_functions[row].complete -> reused_row = row
        }
        checked := if reused_row >= 0 -> checked_functions[reused_row] else -> sema_check_comptime_function(graph, &environment, available, memory_plan, values, current.module_identity, current.function_key)
        loop dependency in checked.waiting_dependencies -> jet_driver_comptime_wait_add(&waiting, dependency)
        if {
            !checked.complete || jet_driver_has_errors(checked.diagnostics) -> {
                loop diagnostic in checked.diagnostics -> &diagnostics.push(diagnostic)
                if checked.incomplete_reasons.len() == 0 && checked.waiting_dependencies.len() == 0 && !jet_driver_has_errors(checked.diagnostics) -> &incomplete_reasons.push("{current.function_key}: incomplete (no recorded cause)")
                loop reason in checked.incomplete_reasons -> &incomplete_reasons.push("{current.function_key}: {reason}")
                complete = false
            }
            else -> {
                function :: checked.function ?? {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a complete comptime function result has no TIR body", "the interpreter fragment is lowered only from a complete typed function", "return the checked TFunc from the canonical on-demand Sema result"))
                    complete = false
                    next
                }
                &functions.push(function)
                if index.checked_rows.get(checked_key) == None {
                    index.checked_rows[checked_key] = checked_functions.len()
                    &checked_functions.push(checked)
                }
            }
        }
        loop call in checked.calls -> jet_driver_comptime_function_ref_add(&queue, &queued, call.module_identity, call.callee_key)
        loop function_key in checked.reachable_function_keys {
            module_identity := jet_driver_comptime_function_owner(index, function_key)
            if {
                module_identity == None -> {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a nested comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
                    complete = false
                }
                else -> {
                    owner_identity :: module_identity ?? return JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: false, incomplete_reasons: incomplete_reasons}
                    jet_driver_comptime_function_ref_add(&queue, &queued, owner_identity, function_key)
                }
            }
        }
    }
    JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: complete, incomplete_reasons: incomplete_reasons}
}

// The Codegen session of the current staged module set; each item moves it out
// to lower its closure and moves it back.
struct JetDriverComptimeCodegen {
    session: JetCodegenComptimeSession?
}

fn jet_driver_comptime_wait_row_find(rows: [JetDriverComptimeWaitRow], key: String) -> JetDriverComptimeWaitRow? {
    loop row in rows {
        if row.key == key -> return Val(row)
    }
    None
}

fn jet_driver_comptime_wait_cycle_from(key: String, rows: [JetDriverComptimeWaitRow], path: &[String], finished: &[String]) -> Bool Never! {
    loop previous in path {
        if previous == key -> return true
    }
    loop previous in finished {
        if previous == key -> return false
    }
    &path.push(key)
    row := jet_driver_comptime_wait_row_find(rows, key)
    if row != None {
        wait_row :: row ?? return false
        loop dependency in wait_row.dependencies {
            if jet_driver_comptime_wait_row_find(rows, dependency) != None && jet_driver_comptime_wait_cycle_from(dependency, rows, &path, &finished) -> return true
        }
    }
    _ := &path.pop()
    &finished.push(key)
    false
}

fn jet_driver_comptime_dependency_cycle(rows: [JetDriverComptimeWaitRow]) -> JetDriverComptimeWaitRow? {
    path := [String]{}
    finished := [String]{}
    loop row in rows {
        if jet_driver_comptime_wait_cycle_from(row.key, rows, &path, &finished) -> return Val(row)
    }
    None
}

fn jet_driver_comptime_eval_config(
    original: JetEvalConfig,
    values: [SemaComptimeItemValue],
    graph: SemaRegistrationGraph,
    module_identity: String,
    span: Span,
    diagnostics: &[Diagnostic],
) -> JetEvalConfig? {
    host_adapter := if original.host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    config := JetEvalConfig{
        fuel: original.fuel,
        max_call_depth: original.max_call_depth,
        max_collection_len: original.max_collection_len,
        globals: original.globals,
        runtime_execution: false,
        host_adapter: host_adapter,
        output_context: original.output_context,
        host_hooks: original.host_hooks,
    }
    loop value in values {
        if value.kind != SemaComptimeItemKind.Constant -> next
        if config.globals.get(value.key) != None {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, module_identity, "E0003", span, "a checked comptime constant collides with an existing interpreter global", "source constants and Host-provided evaluator globals have distinct canonical keys", "retain the source constant key and do not overwrite a Host evaluator global"))
            return None
        }
        _ := &config.globals.add(value.key, value.value)
    }
    Val(config)
}

// Moves every function of `from` onto the end of `to` in order, leaving
// `from` empty. Each pop moves one function, so the list is never resident
// twice.
fn jet_driver_move_mir_functions(to: &[MIRFunction], from: &[MIRFunction]) Never! {
    reversed := [MIRFunction]{}
    loop from.len() > 0 {
        function := &from.pop() ?? { break }
        &reversed.push(^function)
    }
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        &to.push(^function)
    }
}

// Moves the rows of `functions` flagged in `mask` onto `kept` and the others
// onto `rest`, both in order, leaving `functions` empty. Each pop moves one
// row, so no row is ever copied.
fn jet_driver_partition_checked_functions(functions: &[TFunc], mask: [Bool], kept: &[TFunc], rest: &[TFunc]) Never! {
    reversed := [TFunc]{}
    loop functions.len() > 0 {
        function := &functions.pop() ?? { break }
        &reversed.push(^function)
    }
    position := 0
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        if mask[position] {
            &kept.push(^function)
        } else {
            &rest.push(^function)
        }
        position += 1
    }
}

// Moves the rows split by jet_driver_partition_checked_functions back into
// their graph modules in their original order: module `index` takes the next
// `counts[index]` rows. `kept` and `rest` are left empty.
fn jet_driver_restore_checked_functions(graph: &SemaGraphResult, counts: [Int], mask: [Bool], kept: &[TFunc], rest: &[TFunc]) Never! {
    kept_reversed := [TFunc]{}
    loop kept.len() > 0 {
        function := &kept.pop() ?? { break }
        &kept_reversed.push(^function)
    }
    rest_reversed := [TFunc]{}
    loop rest.len() > 0 {
        function := &rest.pop() ?? { break }
        &rest_reversed.push(^function)
    }
    position := 0
    loop module_index in 0..<counts.len() {
        loop _ in 0..<counts[module_index] {
            if mask[position] {
                function := &kept_reversed.pop() ?? { break }
                &graph.modules[module_index].functions.push(^function)
            } else {
                function := &rest_reversed.pop() ?? { break }
                &graph.modules[module_index].functions.push(^function)
            }
            position += 1
        }
    }
}


fn jet_driver_assemble_mir(
    load: JetDriverLoadResult,
    semantic_modules: [SemaGraphModuleResult],
    semantic_imports: [SemaRegistrationImport],
    names: MIRNameFacts,
    lowered_rows: ^JetCodegenFunctions,
    foreign_artifacts: JetCodegenForeignArtifacts,
    facts: MIRPackageFacts,
    include_imports: Bool,
    // JET_KEEP_GOING: earlier stages' reports and duplicate lowered
    // identities do not stop assembly (they are recorded already).
    keep_going: Bool,
    diagnostics: &[Diagnostic],
) -> MIRProgram? {
    // A changeable owner: its function lists are moved out below.
    lowered := ^lowered_rows
    if semantic_modules.len() != load.modules.len() -> return None
    expected_foreign_count := 0
    loop semantic_module in semantic_modules {
        expected_foreign_count += semantic_module.foreign_functions.len()
    }
    if foreign_artifacts.foreign.len() != expected_foreign_count {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering did not return every checked foreign declaration", "the foreign table is the complete normalized Sema ABI set, never an empty placeholder or AST re-inference", "preserve every checked foreign row through Codegen"))
        return None
    }
    foreign_index := 0
    loop foreign in foreign_artifacts.foreign {
        earlier_foreign := 0
        loop earlier_foreign < foreign_index {
            previous := foreign_artifacts.foreign[earlier_foreign]
            if previous.id.value == foreign.id.value || previous.key == foreign.key {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering produced duplicate canonical foreign identities", "each checked foreign key and MirForeignId resolves to exactly one row", "preserve stable foreign identities from normalized Sema facts"))
                return None
            }
            earlier_foreign += 1
        }
        owner_module_index :: jet_driver_loaded_module_index_for_mir_module(load, foreign.module_id) ?? {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a lowered foreign row has no exact loaded-module owner", "MirForeign.module_id derives from the checked source module identity", "retain the normalized foreign row's module identity through Codegen"))
            return None
        }
        expected := SemaCheckedForeignFunction?{None}
        loop semantic_module in semantic_modules {
            if mir_module_id(semantic_module.module_identity).value != foreign.module_id.value -> next
            loop checked_foreign in semantic_module.foreign_functions {
                if checked_foreign.key != foreign.key -> next
                if expected != None {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a checked foreign key resolves to more than one normalized Sema row", "canonical foreign ABI identities are unique within the checked module graph", "report the duplicate normalized foreign key"))
                    return None
                }
                expected = Val(checked_foreign)
            }
        }
        checked :: expected ?? {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a lowered foreign row has no matching normalized checked Sema owner", "Codegen consumes only SemaCheckedForeignFunction facts from the same module identity", "preserve the checked foreign key, module, and ABI provenance"))
            return None
        }
        if !jet_driver_mir_foreign_matches_checked(foreign, checked) {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a lowered foreign row disagrees with its normalized checked Sema facts", "MIR preserves the canonical module, symbol, source site, parameter order, access, and native path", "lower the checked foreign row without reconstructing or changing its ABI"))
            return None
        }
        foreign_index += 1
    }
    imports := [MIRImport]{}
    if include_imports {
        loop import in semantic_imports {
            lowered_import :: jet_driver_mir_import(load, import, lowered, &diagnostics) ?? return None
            import_id := lowered_import.id
            loop previous in imports {
                if previous.id.value == import_id.value {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0003", import.declaration.span, "two semantic imports have the same stable MIR identity", "MIR import IDs are stable functions of source module, declaration span, and target identity", "report the duplicate resolved import edge"))
                    return None
                }
            }
            &imports.push(lowered_import)
        }
    }
    type_instances := jet_codegen_collect_type_instances(lowered.types, lowered.functions, lowered.nested_functions, foreign_artifacts.foreign, lowered.traits, lowered.impls, lowered.constants)
    // Ownership of every lowered function moves into the program: a field
    // move (`^lowered.functions`) would copy the whole list while `lowered`
    // still held it.
    all_functions := [MIRFunction]{}
    jet_driver_move_mir_functions(&all_functions, &lowered.functions)
    jet_driver_move_mir_functions(&all_functions, &lowered.nested_functions)
    // Next-equal chains preserve the old pairwise diagnostic order without
    // visiting unrelated functions. Duplicate-heavy input costs only its output.
    id_heads := [U64:Int]{}
    key_heads := [String:Int]{}
    next_id := (loop _ in all_functions -> -1)
    next_key := (loop _ in all_functions -> -1)
    index := all_functions.len() - 1
    loop index >= 0 {
        function :: all_functions[index]
        next_id[index] = id_heads.get(function.id.value) ?? -1
        next_key[index] = key_heads.get(function.key) ?? -1
        id_heads[function.id.value] = index
        key_heads[function.key] = index
        index -= 1
    }
    function_index := 0
    loop function_index < all_functions.len() {
        function := all_functions[function_index]
        jet_driver_validate_lowered_function_owner(load, function, &diagnostics)
        owner_module_index := jet_driver_loaded_module_index_for_mir_module(load, function.module_id)
        id_later := next_id[function_index]
        key_later := next_key[function_index]
        loop id_later >= 0 || key_later >= 0 {
            later :: if id_later < 0 -> key_later else -> if key_later < 0 || id_later < key_later -> id_later else -> key_later
            if id_later == later {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", function.span, "MIR lowering produced duplicate function IDs", "every MIR function ID resolves to exactly one checked function", "report the duplicate Codegen function identity"))
                id_later = next_id[id_later]
            }
            if key_later == later {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", function.span, "MIR lowering produced duplicate function keys", "every checked function key resolves to one MIR function", "report the duplicate Codegen function key"))
                key_later = next_key[key_later]
            }
        }
        function_index += 1
    }
    if jet_driver_has_errors(diagnostics) && !keep_going -> return None
    callbacks :: jet_driver_merge_mir_callbacks(load, all_functions, lowered.callbacks, &diagnostics) ?? return None

    modules := [MIRModule]{}
    assigned_functions := 0
    assigned_foreigns := 0
    assigned_types := 0
    assigned_traits := 0
    assigned_impls := 0
    assigned_constants := 0
    loop loaded_module in load.modules {
        if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() -> return None
        unit := load.source_units[loaded_module.source_unit_index]
        module_id := mir_module_id(loaded_module.module_identity)
        module_source_file := mir_source_file_id(unit.path)
        if !jet_driver_has_source_file_id(load.source_files, module_source_file) -> return None
        module_import_ids := [MIRImportID]{}
        children := [MIRModuleID]{}
        ordered_items := [JetDriverMIRItemOrderRow]{}
        if include_imports {
            loop import in semantic_imports {
                if import.source_module_identity != loaded_module.module_identity -> next
                import_id := jet_driver_mir_import_id(import)
                &module_import_ids.push(import_id)
                jet_driver_add_mir_item_order(&ordered_items, import.declaration.span.start, MIRItemRef.Import{id: import_id})
                loop edge in load.imports {
                    if edge.source_module_identity == loaded_module.module_identity && edge.declaration.span.start == import.declaration.span.start && edge.declaration.span.end == import.declaration.span.end && jet_driver_import_is_module_edge(edge.declaration.kind) && edge.target_package_identity == loaded_module.package_identity && !jet_driver_is_namespace_binding(edge.declaration) {
                        child_id := mir_module_id(edge.target_module_identity)
                        found_child := false
                        loop child in children {
                            if child.value == child_id.value -> found_child = true
                        }
                        if !found_child -> &children.push(child_id)
                    }
                }
            }
        }
        loop function in all_functions {
            if function.module_id.value != module_id.value -> next
            if !jet_driver_has_source_file_id(load.source_files, function.source_file) -> return None
            jet_driver_add_mir_item_order(&ordered_items, function.span.start, MIRItemRef.Function{id: function.id})
            assigned_functions += 1
        }
        loop foreign in foreign_artifacts.foreign {
            if foreign.module_id.value != module_id.value -> next
            jet_driver_add_mir_item_order(&ordered_items, foreign.span.start, MIRItemRef.Foreign{id: foreign.id})
            assigned_foreigns += 1
        }
        loop definition in lowered.types {
            if definition.module_id.value != module_id.value -> next
            jet_driver_add_mir_item_order(&ordered_items, definition.span.start, MIRItemRef.Type{id: definition.id})
            assigned_types += 1
        }
        loop definition in lowered.traits {
            if definition.module_id.value != module_id.value -> next
            jet_driver_add_mir_item_order(&ordered_items, definition.span.start, MIRItemRef.Trait{id: definition.id})
            assigned_traits += 1
        }
        loop definition in lowered.impls {
            if definition.module_id.value != module_id.value -> next
            jet_driver_add_mir_item_order(&ordered_items, definition.span.start, MIRItemRef.Impl{id: definition.id})
            assigned_impls += 1
        }
        loop definition in lowered.constants {
            if definition.module_id.value != module_id.value -> next
            jet_driver_add_mir_item_order(&ordered_items, definition.span.start, MIRItemRef.Constant{id: definition.id})
            assigned_constants += 1
        }
        positions := [U64]{}
        loop row in ordered_items -> &positions.push(U64.from_int(row.position) ?? U64{0})
        item_order := [MIRItemRef]{}
        loop row_index in jet_codegen_sorted_order(positions, [String]{}) -> &item_order.push(ordered_items[row_index].item)
        &modules.push(MIRModule{
            id: module_id,
            key: loaded_module.module_identity,
            name: loaded_module.module_name,
            path: unit.path,
            source_file: module_source_file,
            imports: module_import_ids,
            children: children,
            item_order: item_order,
        })
    }
    if assigned_functions != all_functions.len() || assigned_foreigns != foreign_artifacts.foreign.len() || assigned_types != lowered.types.len() || assigned_traits != lowered.traits.len() || assigned_impls != lowered.impls.len() || assigned_constants != lowered.constants.len() -> return None
    Val(MIRProgram{
        schema_version: MIR_SCHEMA_VERSION,
        package_identity: load.package_identity,
        facts: facts,
        names: names,
        modules: modules,
        imports: imports,
        types: lowered.types,
        traits: lowered.traits,
        core_owners: lowered.core_owners,
        impls: lowered.impls,
        constants: lowered.constants,
        fields: lowered.fields,
        source_files: load.source_files,
        functions: all_functions,
        jobs: [MIRJob]{},
        tests: [MIRTestCase]{},
        harnesses: [MIRHarnessPlan]{},
        artifacts: [MIRArtifactPlan]{},
        cffi: MIRCffiFacts{
            import_links: [MIRCImportLink]{},
            libs: [MIRCLib]{},
            overlay_overrides: [MIRCOverlayOverride]{},
            boundaries: [MIRFFIBoundaryFacts]{},
            direct_links: [String]{},
            transitive_links: [String]{},
            close_adapters: [MIRCloseAdapter]{},
        },
        foreign: foreign_artifacts.foreign,
        links: foreign_artifacts.links,
        callbacks: callbacks,
        handles: foreign_artifacts.handles,
        core_calls: lowered.core_calls,
        prelude_calls: lowered.prelude_calls,
        // Rust mir.rs `lower_program`: every canonical type the lowered rows
        // name, so legality, emission and evaluation see one instance table.
        type_instances: type_instances,
        codec_migrations: [String:MIRSchemaMigrationPlan]{},
        unreachable: [MIRUnreachable]{},
    })
}


struct JetDriverComptimeRunResult {
    values: [SemaComptimeItemValue]
    functions: [SemaComptimeFunctionResult]
    trace: JetDriverCompileTrace
    complete: Bool
    soft_stop: Bool
    internal_problem: String?
}

fn jet_driver_comptime_run_result(
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
) -> JetDriverComptimeRunResult Never! {
    JetDriverComptimeRunResult{values: values, functions: functions, trace: trace, complete: complete, soft_stop: soft_stop, internal_problem: None}
}
// `known` holds the `module\nkey` of every source already pending or staged.
fn jet_driver_comptime_checked_text_source_add(sources: &[SemaComptimeItemSource], known: &[String:Bool], evaluation: SemaCheckedTextEvaluation) Never! {
    source := sema_comptime_checked_text_source(evaluation)
    key :: "{source.module_identity}\n{source.key}"
    if known.get(key) != None -> return
    known[key] = true
    &sources.push(source)
}

// Each function joins the first module with its identity, in place: the
// module is found through one identity map instead of copying every module
// passed while searching, and edited without copying it out and back. An
// incomplete result fails the merge before any module changes.
fn jet_driver_merge_checked_text_functions(graph: &SemaGraphResult, registration: SemaRegistrationGraph, functions: [SemaComptimeFunctionResult]) -> Bool Never! {
    module_rows := [String:Int]{}
    loop (index, graph_module) in graph.modules {
        if module_rows.get(graph_module.module_identity) == None -> module_rows[graph_module.module_identity] = index
    }
    loop checked in functions {
        function :: checked.function ?? return false
        module_index :: module_rows.get(checked.module_identity) ?? return false
        duplicate := false
        loop existing_index in 0..<graph.modules[module_index].functions.len() {
            existing :: graph.modules[module_index].functions[existing_index]
            if existing.key == function.key -> duplicate = true
        }
        if duplicate -> next
        if !checked.complete -> return false
        if !sema_comptime_append_checked_function_to_module(checked, &graph.modules[module_index]) -> return false
        loop fact in checked.call_facts -> &graph.call_facts.push(fact)
        loop request in checked.calls -> &graph.comptime_requests.push(request)
    }
    graph.names = sema_name_build_facts(registration, graph.modules)
    true
}

fn jet_driver_run_comptime(
    graph: SemaRegistrationGraph,
    sources: [SemaComptimeItemSource],
    names: MIRNameFacts,
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeRunResult {
    values := ~initial_values
    // The memory plan reads only function declarations, which staged values
    // never change, so every on-demand function check shares this one.
    memory_plan :: sema_function_memory_plan_from_graph(graph)
    checked_functions := ~initial_functions
    trace := jet_driver_empty_compile_trace()
    pending := sources
    // The `module\nkey` of every source pending or staged in this run.
    known_sources := [String:Bool]{}
    loop source in sources -> known_sources["{source.module_identity}\n{source.key}"] = true
    // One environment owns the graph carrying the staged values for every
    // item and function check; the values that landed since the last item
    // are applied to that graph in place rather than rebuilding it per item,
    // and counted into the run's available constant keys.
    environment := sema_comptime_environment(graph, values)
    available := sema_comptime_available_constants(graph, values)
    resolved_count := values.len()
    run_index := jet_driver_comptime_run_index(graph, checked_functions)
    // Checked functions whose checked-text calls were already queued; the
    // run's checked functions only grow, so each is scanned once.
    scanned_functions := 0
    // Declaration checks of every module under the staged values. An item
    // that names no staged constant and calls no function cannot observe a
    // value's type, so it reuses the last checks; any other item rechecks
    // when a value landed since them.
    staged_runtime_modules := [SemaGraphModuleResult]{}
    // The lowering session of the current staged set: Codegen owns the staged
    // modules (moved in, never copied per item) and their indexes.
    codegen := JetDriverComptimeCodegen{session: None}
    // Foreign rows read only the staged runtime modules and the run's artifact
    // target, so they are lowered once per staged set.
    staged_foreign := JetCodegenForeignArtifacts?{None}
    staged_count := -1
    loop pending.len() > 0 {
        next_pending := [SemaComptimeItemSource]{}
        wait_rows := [JetDriverComptimeWaitRow]{}
        made_progress := false
        loop source in pending {
            if values.len() > resolved_count {
                landed := [SemaComptimeItemValue]{}
                loop value_index in resolved_count..<values.len() -> &landed.push(values[value_index])
                staged_graph := ^environment.registration_graph
                environment.registration_graph = None
                resolved_graph := ^staged_graph ?? {
                    result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    result.internal_problem = Val("the staged comptime environment lost its registration graph")
                    return result
                }
                sema_comptime_graph_apply_values(&resolved_graph, landed)
                environment.registration_graph = Val(^resolved_graph)
                sema_comptime_available_constants_add(&available, values)
                resolved_count = values.len()
            }
            checked_item := sema_check_comptime_item(&environment, available, source, values)
            item_diagnostic_start := diagnostics.len()
            // A comptime item's checker reports against its own module's
            // source, so each carries that module's location.
            loop diagnostic in checked_item.diagnostics -> &diagnostics.push(jet_driver_attach_registration_source_location(diagnostic, graph, source.module_identity))
            // JET_KEEP_GOING: an item whose own check reported an error is
            // dropped (its value never lands) and the run goes on.
            if graph.keep_going {
                if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
            } else if jet_driver_has_errors(diagnostics) {
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            if checked_item.waiting_dependencies.len() > 0 {
                &wait_rows.push(JetDriverComptimeWaitRow{
                    key: source.key,
                    name: source.name,
                    module_identity: source.module_identity,
                    span: source.span,
                    dependencies: checked_item.waiting_dependencies,
                })
                &next_pending.push(source)
                next
            }
            if !checked_item.complete && graph.keep_going {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` did not check to a complete typed value", "JET_KEEP_GOING drops the item and runs the rest", "see the item's other reports"))
                next
            }
            if !checked_item.complete {
                result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                if !jet_driver_has_errors(diagnostics) {
                    result.internal_problem = Val("comptime item checking did not return a complete typed value or dependency wait set")
                }
                return result
            }
            comptime_request :: checked_item.request ?? {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "a complete comptime item check returned no typed evaluation request", "each staged value is evaluated only from its complete checked TIR expression", "retain the canonical Sema comptime request"))
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            if source.kind == SemaComptimeItemKind.Constant && comptime_request.calls.len() == 0 {
                if jet_driver_comptime_plain_literal(comptime_request.expression) == .Val(plain) {
                    &values.push(SemaComptimeItemValue{
                        module_identity: source.module_identity,
                        key: source.key,
                        destination_key: source.destination_key,
                        kind: source.kind,
                        value: plain,
                        ty: comptime_request.expression.ty,
                    })
                    made_progress = true
                    next
                }
            }
            closure := jet_driver_comptime_function_closure(graph, &environment, available, &run_index, memory_plan, values, &checked_functions, comptime_request, &diagnostics)
            if graph.keep_going {
                if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
            } else if jet_driver_has_errors(diagnostics) {
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            if !closure.complete && closure.waiting_dependencies.len() == 0 && graph.keep_going {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` has an incomplete function closure: {closure.incomplete_reasons.join("; ")}", "JET_KEEP_GOING drops the item and runs the rest", "see the closure's other reports"))
                next
            }
            if !closure.complete && closure.waiting_dependencies.len() == 0 {
                result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                if !jet_driver_has_errors(diagnostics) {
                    problem := "comptime function checking did not return a complete body or dependency wait set"
                    loop reason in closure.incomplete_reasons -> problem = "{problem}\n  {reason}"
                    result.internal_problem = Val(problem)
                }
                return result
            }
            if closure.waiting_dependencies.len() > 0 {
                dependencies := [String]{}
                loop dependency in checked_item.waiting_dependencies -> jet_driver_comptime_wait_add(&dependencies, dependency)
                loop dependency in closure.waiting_dependencies -> jet_driver_comptime_wait_add(&dependencies, dependency)
                &wait_rows.push(JetDriverComptimeWaitRow{
                    key: source.key,
                    name: source.name,
                    module_identity: source.module_identity,
                    span: source.span,
                    dependencies: dependencies,
                })
                &next_pending.push(source)
                next
            }
            loop call in comptime_request.calls {
                if call.checked_text == .Val(evaluation) -> jet_driver_comptime_checked_text_source_add(&next_pending, &known_sources, evaluation)
            }
            loop function_index in scanned_functions..<checked_functions.len() {
                loop call in checked_functions[function_index].calls {
                    if call.checked_text == .Val(evaluation) -> jet_driver_comptime_checked_text_source_add(&next_pending, &known_sources, evaluation)
                }
            }
            scanned_functions = checked_functions.len()
            if staged_count < 0 || (values.len() != staged_count && (comptime_request.dependencies.len() > 0 || closure.functions.len() > 0)) {
                // The environment's graph already carries every value so far:
                // values land only after this item's checks. It is moved out
                // for the declaration checks and back, never copied.
                registered := ^environment.registration_graph
                environment.registration_graph = None
                staged_graph := ^registered ?? {
                    result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    result.internal_problem = Val("the staged comptime environment lost its registration graph")
                    return result
                }
                staged_modules := sema_comptime_modules_with_values(staged_graph, values)
                environment.registration_graph = Val(^staged_graph)
                if staged_modules.len() != graph.modules.len() {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "the staged comptime declaration graph lost a registered module", "temporary interpreter MIR retains every module identity from the registered graph", "preserve the complete resolved module set while applying staged values"))
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                staged_runtime_modules = [SemaGraphModuleResult]{}
                loop runtime_module in staged_modules {
                    if runtime_module.module_identity != graph.canonical_effect_module_identity -> &staged_runtime_modules.push(runtime_module)
                }
                codegen.session = Val(jet_codegen_comptime_session(^staged_modules, load.source_files))
                staged_foreign = None
                staged_count = values.len()
            }
            taken_session := ^codegen.session
            codegen.session = None
            session := ^taken_session ?? {
                result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                result.internal_problem = Val("the staged comptime lowering session was lost")
                return result
            }
            lowering := lower_comptime_closure(&session, comptime_request, closure.functions)
            codegen.session = Val(^session)
            lowered := ^lowering.functions
            if lowered.functions.len() != closure.functions.len() {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "temporary code generation did not return every checked comptime function", "the evaluator receives the complete checked TIR function closure", "retain every checked function through Codegen"))
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            lowered_item := ^lowering.item
            eval_function_id := lowered_item.function.id
            if !jet_driver_merge_comptime_function(&lowered, lowered_item, load, &diagnostics) -> return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            temporary_hardware_use := sema_hardware_use_snapshot(comptime_request.hardware_use)
            closure_keys := [String:Bool]{}
            loop selected_function in closure.functions -> closure_keys[selected_function.key] = true
            loop function in checked_functions {
                if closure_keys.get(function.function_key) != None -> sema_hardware_use_merge(&temporary_hardware_use, sema_hardware_use_snapshot(function.hardware_use))
            }
            temporary_facts :: jet_driver_package_facts(
                load,
                request,
                graph.target_machine,
                lowered.used_core,
                jet_ring_prelude_closure_layer(lowered.used_core),
                temporary_hardware_use,
                &diagnostics,
            ) ?? return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            if staged_foreign == None -> staged_foreign = Val(lower_foreign_artifacts(staged_runtime_modules, temporary_facts))
            foreign_artifacts :: staged_foreign ?? lower_foreign_artifacts(staged_runtime_modules, temporary_facts)
            temporary_program := jet_driver_assemble_mir(
                load,
                staged_runtime_modules,
                [SemaRegistrationImport]{},
                names,
                ^lowered,
                foreign_artifacts,
                temporary_facts,
                false,
                false,
                &diagnostics,
            )
            if temporary_program == None {
                if !jet_driver_has_errors(diagnostics) {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "the checked comptime function closure cannot be represented by MIR", "temporary MIR includes only checked functions and canonical declaration facts", "preserve canonical identities through the interpreter MIR fragment"))
                }
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            temporary_program_value :: temporary_program ?? return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            eval_config :: jet_driver_comptime_eval_config(request.eval_config, values, graph, comptime_request.module_identity, comptime_request.span, &diagnostics) ?? return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            eval_result := jet_eval_function(^temporary_program_value, eval_function_id, [TComptimeValue]{}, ^eval_config)
            // Classify the evaluator's final, retired result: retirement still
            // records cleanup failures, internal problems and output.
            evaluated := TComptimeValue?{None}
            if eval_result.error == None && eval_result.internal_problem == None && eval_result.complete && !eval_result.soft_stop {
                evaluated = jet_eval_comptime_value(&eval_result, comptime_request.span)
            }
            jet_eval_retire_result(&eval_result, comptime_request.span)
            jet_driver_record_eval_result(&trace, eval_result)
            if eval_result.error != None || eval_result.internal_problem != None {
                if eval_result.error == .Val(eval_error) {
                    &diagnostics.push(jet_driver_attach_registration_source_location(eval_error.diagnostic, graph, comptime_request.module_identity))
                }
                if graph.keep_going {
                    if eval_result.internal_problem == .Val(problem) -> &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "keep-going: the comptime interpreter failed internally: {problem.message}", "JET_KEEP_GOING drops the item and runs the rest", "fix the interpreter defect"))
                    next
                }
                // An interpreter internal problem is a compiler defect with
                // its own exact message; it leaves as the run's internal problem.
                failed := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                if eval_result.internal_problem == .Val(problem) -> failed.internal_problem = Val("the comptime interpreter failed internally: {problem.message}")
                return failed
            }
            if eval_result.soft_stop -> return jet_driver_comptime_run_result(values, checked_functions, trace, false, true)
            if !eval_result.complete {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "the comptime interpreter returned neither a value nor an explicit control result", "only complete values and canonical soft-stop control may leave evaluation", "return the evaluator's exact error or completed result"))
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            value :: evaluated ?? {
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "a complete comptime evaluation returned no value", "a staged value is recorded only after successful evaluation", "preserve the completed interpreter value"))
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            if source.kind == SemaComptimeItemKind.CheckedText {
                if value == .Failed(_) {
                    evaluation :: source.checked_text ?? {
                        &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "a checked-text validation item lost its exact method request", "CheckedText literals evaluate their registered pure checker on the fully encoded body", "preserve the checked-text request through staged evaluation"))
                        return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    }
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E2712", evaluation.span, "this checked text type rejected its body", "the type's pure `CheckedText.check` method must accept the complete literal body", "fix the body so it satisfies the type's declared text grammar"))
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                made_progress = true
                next
            }
            &values.push(SemaComptimeItemValue{
                module_identity: source.module_identity,
                key: source.key,
                destination_key: source.destination_key,
                kind: source.kind,
                value: value,
                ty: comptime_request.expression.ty,
            })
            made_progress = true
        }
        if next_pending.len() > 0 && !made_progress {
            cycle := jet_driver_comptime_dependency_cycle(wait_rows)
            if {
                cycle != None -> {
                    cycle_row :: cycle ?? return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    cycle_diagnostic := sema_comptime_dependency_cycle_diagnostic(cycle_row.name, cycle_row.span)
                    &diagnostics.push(jet_driver_attach_registration_source_location(cycle_diagnostic, graph, cycle_row.module_identity))
                }
                wait_rows.len() > 0 -> {
                    stalled := wait_rows[0]
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, stalled.module_identity, "E0003", stalled.span, "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
                else -> {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
            }
            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
        }
        pending = next_pending
    }
    jet_driver_comptime_run_result(values, checked_functions, trace, true, false)
}

// Rust `plain_literal_value` (Registration/Items.rs): a constant whose checked
// initializer is a plain literal (an unsuffixed Int in the evaluator's Int
// range, optionally negated, a Bool, a Char, or a string without
// interpolation) is its own value. Evaluating it lowered, assembled and ran a
// MIR fragment holding every module's declarations once per constant, which
// made staging quadratic in program size (#3661).
fn jet_driver_comptime_plain_literal(expression: TExpr) -> TComptimeValue? Never! {
    if expression.kind == {
        .IntLit(value, width) -> {
            if width == None && expression.ty == Type.Int && jet_driver_comptime_small_int(value) -> return Val(TComptimeValue.Int{value: value})
        }
        .Unary(op, operand) -> {
            if op == TUnaryOp.Neg && expression.ty == Type.Int && operand.kind == .IntLit(value, width) {
                if width == None && jet_driver_comptime_small_int(0 - value) -> return Val(TComptimeValue.Int{value: 0 - value})
            }
        }
        .BoolLit(value) -> return Val(TComptimeValue.Bool{value: value})
        .CharLit(value) -> return Val(TComptimeValue.Char{value: value})
        .StrLit(parts) -> {
            if expression.ty != Type.String -> return None
            if parts.len() == 0 -> return Val(TComptimeValue.String{value: ""})
            if parts.len() == 1 && parts[0] == .Literal(text) -> return Val(TComptimeValue.String{value: text})
        }
        else -> {}
    }
    None
}

fn jet_driver_comptime_small_int(value: Int) -> Bool Never! {
    value >= -9223372036854775807 - 1 && value <= 9223372036854775807
}

fn jet_driver_foreign_provider_owners_valid(
    modules: [JetDriverLoadedModule],
    providers: [SemaForeignProviderInput],
    diagnostics: &[Diagnostic],
) -> Bool {
    valid := true
    provider_index := 0
    loop provider_index < providers.len() {
        provider := providers[provider_index]
        module_matches := 0
        loop candidate_module in modules {
            if candidate_module.module_identity == provider.module_identity -> module_matches += 1
        }
        duplicate_identity := false
        prior_index := 0
        loop prior_index < provider_index {
            if providers[prior_index].module_identity == provider.module_identity {
                duplicate_identity = true
                break
            }
            prior_index += 1
        }
        if module_matches != 1 || duplicate_identity {
            &diagnostics.push(jet_driver_diagnostic_without_span(
                "E0003",
                "a foreign provider does not resolve to one exact loaded module identity",
                "provider handles are registered only on the synthetic module selected by their exact module_identity",
                "retain one provider row for the exact loaded synthetic module identity",
            ))
            valid = false
        }
        provider_index += 1
    }
    valid
}

fn jet_driver_registration_foreign_handle_facts(
    module_identity: String,
    providers: [SemaForeignProviderInput],
    diagnostics: &[Diagnostic],
) -> [SemaRegistrationForeignHandleFacts]? {
    selected_index := Int?{None}
    index := 0
    loop index < providers.len() {
        if providers[index].module_identity == module_identity {
            if selected_index != None {
                &diagnostics.push(jet_driver_diagnostic_without_span(
                    "E0003",
                    "more than one foreign provider has the exact module identity selected for registration",
                    "opaque handle facts belong to one exact synthetic provider module",
                    "retain one provider input for the loaded module identity",
                ))
                return None
            }
            selected_index = Val(index)
        }
        index += 1
    }
    provider_index :: selected_index ?? return Val([SemaRegistrationForeignHandleFacts]{})
    provider := providers[provider_index]
    facts := [SemaRegistrationForeignHandleFacts]{}
    loop handle in provider.handles {
        &facts.push(SemaRegistrationForeignHandleFacts{
            library: handle.library,
            typedef_name: handle.typedef_name,
            jet_name: handle.jet_name,
            ownership: "Owned",
            close: handle.close,
            close_source: handle.close_source,
            thread_safety: handle.thread_safety,
            send: handle.thread_safety == "safe",
            sync: handle.thread_safety == "safe",
            close_function_key: handle.close_function_key,
            source_span: provider.source_span,
        })
    }
    Val(facts)
}
fn jet_driver_canonical_effect_segments(path: String, source: String) -> [SemaSourceSegment] Never! {
    bytes := source.bytes()
    line_starts := [Int]{0}
    index := 0
    loop index < bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
        index += 1
    }
    [SemaSourceSegment{
        generated: Span{start: 0, end: bytes.len()},
        source_file: path,
        source_start: 0,
        line_starts: line_starts,
        origin: SemaSourceOrigin.CompilerGenerated,
    }]
}

fn jet_driver_canonical_effect_module(source: String) -> SemaRegistrationModuleInput? {
    if source.len() == 0 -> return None
    parsed := parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> return None
    declaration_count := 0
    unexpected_item := false
    loop item in parsed.program.items {
        if item == {
            .EffectDecl(_) -> declaration_count += 1
            else -> unexpected_item = true
        }
    }
    if unexpected_item || declaration_count == 0 -> return None
    source_file := "jet:canonical-prelude/Prelude/Effects.jet"
    package_identity := JET_CANONICAL_EFFECT_PACKAGE_IDENTITY
    module_path := JET_CANONICAL_EFFECT_MODULE_PATH
    module_identity := jet_driver_module_identity(package_identity, module_path)
    Val(SemaRegistrationModuleInput{
        package_identity: package_identity,
        module_identity: module_identity,
        module_name: "Effects",
        module_path: module_path,
        source_file: source_file,
        source_segments: jet_driver_canonical_effect_segments(source_file, source),
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: ^parsed.program,
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
    })
}

fn jet_driver_compile_internal_result(load: JetDriverLoadResult, trace: JetDriverCompileTrace, message: String) -> JetDriverCompileResult Never! {
    result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    result.internal_problem = Val(message)
    result
}

// An incomplete-graph internal problem that names every incomplete module and
// each recorded cause, so a stop with no diagnostic still says what stopped it.
fn jet_driver_incomplete_graph_problem(summary: String, modules: [SemaGraphModuleResult]) -> String Never! {
    problem := summary
    loop graph_module in modules {
        if graph_module.complete -> next
        if graph_module.incomplete_reasons.len() == 0 {
            problem = "{problem}\n  {graph_module.module_identity}: incomplete (no recorded cause)"
            next
        }
        loop reason in graph_module.incomplete_reasons -> problem = "{problem}\n  {graph_module.module_identity}: {reason}"
    }
    problem
}

// The result for a compile whose own failure escaped every stage: no stage
// produced a load or partial product, so only the internal problem is kept.
pub fn jet_driver_compile_escaped_failure(message: String) -> JetDriverCompileResult Never! {
    JetDriverCompileResult{
        diagnostics: [Diagnostic]{},
        generated_source_files: [MIRSourceFile]{},
        package_identity: "",
        entry_module_identity: "",
        entry_function: None,
        runtime_artifact: None,
        web_artifact: None,
        web_artifacts: None,
        mir: None,
        emitted_source: None,
        emit_manifest: None,
        comptime_stdout: "",
        comptime_stderr: "",
        soft_stop: false,
        exit_code: None,
        failed_stage: None,
        complete: false,
        internal_problem: Val(message),
    }
}
fn jet_driver_artifact_plan(
    program: MIRProgram,
    entry_function: MIRFunctionID?,
    facts: MIRPackageFacts,
    target_machine: MIRTargetMachine,
    web_profile: MIRArtifactBuildMode?,
) -> MIRArtifactPlan? {
    artifact_target :: facts.artifact_target ?? return None
    artifact_target_name := ""
    artifact_kind := MIRArtifactKind.NativeExecutable
    artifact_mode := MIRArtifactBuildMode.Dev
    is_web := false
    if artifact_target == {
        .RustAOT -> artifact_target_name = "RustAot"
        .Cranelift -> artifact_target_name = "Cranelift"
        .Web -> {
            artifact_target_name = "Web"
            artifact_kind = MIRArtifactKind.WebApplication
            is_web = true
            artifact_mode = web_profile ?? return None
        }
        else -> return None
    }
    module_ids := [MIRModuleID]{}
    loop program_module in program.modules -> &module_ids.push(program_module.id)
    link_ids := [MIRLinkUnitID]{}
    loop link in program.links -> &link_ids.push(link.id)
    job_ids := [MIRJobID]{}
    loop job in program.jobs -> &job_ids.push(job.id)
    entry := MIREntrySpec?{None}
    if {
        entry_function != None -> {
            function_id :: entry_function
            initialize_environment := if is_web -> true else -> (artifact_target == MIRArtifactTarget.RustAOT || artifact_target == MIRArtifactTarget.Cranelift) && !target_machine.no_os
            initialize_gc := is_web
            entry_kind := if is_web -> MIREntryKind.App else -> MIREntryKind.Command
            entry = Val(MIREntrySpec{
                kind: entry_kind,
                function: Val(function_id),
                cli: jet_driver_entry_record_cli(program, function_id),
                output: MIREntryOutput.ReturnValue,
                initialize_environment: initialize_environment,
                initialize_gc: initialize_gc,
                serves_until_stopped: false,
                package_version: facts.package_version,
            })
        }
        is_web -> return None
        // D4: a package with no entry (a `.Library` output) lowers as a
        // library artifact, never as an executable without an entry.
        else -> artifact_kind = MIRArtifactKind.NativeLibrary
    }
    artifact_key := "{program.package_identity}::artifact::{artifact_target_name}"
    Val(MIRArtifactPlan{
        id: MIRArtifactID{value: stable_id("mir-artifact", artifact_key)},
        kind: artifact_kind,
        name: program.package_identity,
        target: artifact_target,
        mode: artifact_mode,
        modules: module_ids,
        links: link_ids,
        jobs: job_ids,
        runtime_parts: facts.runtime_parts,
        exports: [MIRExport]{},
        provider_identity: facts.target_dossier.provider_identity,
        closure_identity: facts.target_dossier.closure_identity,
        artifact_identity: "{facts.target_dossier.compiler_identity}:{facts.target_dossier.environment_identity}:{target_machine.triple}",
        entry: entry,
        harness: None,
    })
}

// A `#CLI` record entry (`fn run(args: Args)`) decodes the record's checked CLI
// schema, the same rows MIR lowering attaches to the record's type definition.
fn jet_driver_entry_record_cli(program: MIRProgram, function_id: MIRFunctionID) -> MIRCLIEntry? {
    loop function in program.functions {
        if function.id != function_id || function.params.len() != 1 -> next
        identity :: function.params[0].ty.identity ?? return None
        loop definition in program.types {
            if definition.id == identity -> return definition.cli
        }
    }
    None
}

fn jet_driver_runtime_artifact_id(program: MIRProgram) -> MIRArtifactID? {
    selected := MIRArtifactID?{None}
    loop artifact in program.artifacts {
        if artifact.target != MIRArtifactTarget.Cranelift || artifact.entry == None -> next
        if selected != None -> return None
        selected = Val(artifact.id)
    }
    selected
}

// The Core source modules whose top-level bodies are lowered only when
// reached (Rust `core_source_module_indices`). Compiler-private parts and
// host-only Core modules are not listed, so their bodies stay rooted; so is
// a Core module with foreign rows, whose close and undo adapters Codegen
// resolves by key.
fn jet_driver_prunable_core_modules(load: JetDriverLoadResult, core_sources: [JetDriverCoreSource], modules: [SemaGraphModuleResult]) -> [String] Never! {
    identities := [String]{}
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 || semantic_module.foreign_providers.len() > 0 -> next
        loop module_row in load.modules {
            if module_row.module_identity != semantic_module.module_identity -> next
            unit :: load.source_units[module_row.source_unit_index]
            if jet_driver_unit_is_core(unit) && unit.file_index >= 0 && unit.file_index < core_sources.len() && core_sources[unit.file_index].owner == "" -> &identities.push(semantic_module.module_identity)
        }
    }
    identities
}

// ---- JET_KEEP_GOING: the compiler-internal all-phases diagnostic mode ----
// Every failed unit is recorded and replaced by a typed trap so every later
// phase still runs: sema keeps a failed function as a trap of its declared
// signature (SemaRegistrationGraph.keep_going), comptime drops a failed item,
// the optimizer traps every function the failing legality or lint check
// rejects and runs again, and the emitter keeps every failure and finishes
// the text. Each failure is one TSV row (phase, item, code, message, span),
// returned in keep_going_rows and streamed through the trace sink at every
// phase boundary (jet_driver_keep_going_flush), so a later crash keeps it. The
// output is never shipped: the result keeps every error report, so its
// receipt never passes.
struct JetDriverKeepGoingLog {
    enabled: Bool
    skip: [String]
    rows: [String]
    // Row bodies (all but the phase) already recorded, so a failure seen by
    // two phases is one row.
    seen: [String:Bool]
    // Reports before this index of the stage diagnostics are recorded.
    diagnostic_mark: Int
    // Rows before this index are written to the trace sink.
    streamed: Int
}

// Optimizer reruns after trapping failed functions, per compile.
JET_DRIVER_KEEP_GOING_OPTIMIZER_RETRIES :: 64

fn jet_driver_keep_going_log(options: JetDriverKeepGoing?) -> JetDriverKeepGoingLog Never! {
    log := JetDriverKeepGoingLog{enabled: false, skip: [String]{}, rows: [String]{}, seen: [String:Bool]{}, diagnostic_mark: 0, streamed: 0}
    if options == .Val(value) {
        log.enabled = true
        log.skip = value.skip
    }
    log
}

fn jet_driver_keep_going_field(text: String) -> String {
    text.replace("\t", " ").replace("\n", " | ").replace(String.from_bytes([U8]{U8{13}}) ?? "", "")
}

fn jet_driver_keep_going_row(kg: &JetDriverKeepGoingLog, phase: String, item: String, code: String, message: String, span: String) {
    if !kg.enabled -> return
    body :: "{jet_driver_keep_going_field(item)}\t{jet_driver_keep_going_field(code)}\t{jet_driver_keep_going_field(message)}\t{jet_driver_keep_going_field(span)}"
    if kg.seen.get(body) != None -> return
    kg.seen[body] = true
    &kg.rows.push("{phase}\t{body}")
}

// Writes the rows recorded since the last flush to the trace sink.
fn jet_driver_keep_going_flush(kg: &JetDriverKeepGoingLog, trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        loop index in kg.streamed..<kg.rows.len() {
            sink.begin("keepgoing", kg.rows[index], index, -1)
            sink.end("keepgoing", 1)
        }
    }
    kg.streamed = kg.rows.len()
}

fn jet_driver_has_errors_since(diagnostics: [Diagnostic], start: Int) -> Bool Never! {
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR -> return true
    }
    false
}

// The error reports added to the stage diagnostics since the last call.
fn jet_driver_keep_going_diagnostics(kg: &JetDriverKeepGoingLog, phase: String, diagnostics: [Diagnostic]) {
    start := kg.diagnostic_mark
    if start > diagnostics.len() -> start = 0
    loop index in start..<diagnostics.len() {
        diagnostic :: diagnostics[index]
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        message := diagnostic.what
        if diagnostic.detail == .Val(detail) -> message = "{message}: {detail}"
        path :: diagnostic.source_path ?? "-"
        site := path
        if diagnostic.span == .Val(span) -> site = "{path}:{span.start}..{span.end}"
        jet_driver_keep_going_row(&kg, phase, path, diagnostic.code, message, site)
    }
    kg.diagnostic_mark = diagnostics.len()
}

// Why each incomplete module is incomplete (each failed function's label and
// cause), one row per recorded reason.
fn jet_driver_keep_going_incomplete_modules(kg: &JetDriverKeepGoingLog, phase: String, modules: [SemaGraphModuleResult]) {
    loop graph_module in modules {
        if graph_module.complete -> next
        if graph_module.incomplete_reasons.len() == 0 {
            jet_driver_keep_going_row(&kg, phase, graph_module.module_path, "INCOMPLETE", "incomplete (no recorded cause)", "-")
            next
        }
        loop reason in graph_module.incomplete_reasons -> jet_driver_keep_going_row(&kg, phase, graph_module.module_path, "INCOMPLETE", reason, "-")
    }
}

fn jet_driver_keep_going_skip_set(skip: [String]) -> [String:Bool] Never! {
    set := [String:Bool]{}
    loop entry in skip -> set[entry] = true
    set
}

// A checked function whose body is one unreachable stop: its signature,
// owner and identity are unchanged, so every caller still lowers.
fn jet_driver_keep_going_tir_trap(function: TFunc, reason: String) -> TFunc Never! {
    trapped := function
    stop :: TExpr{ty: Type.Named{name: "Never"}, kind: TExprKind.Never{reason: reason}, span: function.source_span, integer_bounds: None, cost: None}
    trapped.body = [TStmt]{TStmt.ExprStmt{value: stop, span: function.source_span}}
    trapped
}

// A MIR function whose body is one unreachable block, keeping its signature
// and identity: no instruction, value, place, local, scope or drop remains
// for legality, lint or emission to reject.
fn jet_driver_keep_going_mir_trap(function: MIRFunction, reason: String) -> MIRFunction Never! {
    trapped := function
    trapped.blocks = [MIRBasicBlock]{MIRBasicBlock{id: function.entry, span: function.span, instructions: [MIRInstruction]{}, terminator: MIRTerminator.Unreachable{reason: reason}}}
    trapped.locals = [MIRLocal]{}
    trapped.values = [MIRValueFact]{}
    trapped.places = [MIRPlace]{}
    trapped.scopes = [MIRScope]{}
    trapped.drops = [MIRDropAction]{}
    trapped.optimization = mir_empty_optimization_facts()
    trapped
}

fn jet_driver_keep_going_mir_site(program: MIRProgram, function: MIRFunction, span: Span) -> String Never! {
    path := "-"
    loop file in program.source_files {
        if file.id.value == function.source_file.value {
            path = file.path
            break
        }
    }
    "{path}:{span.start}..{span.end}"
}

// `lower:<name>@<position>` skip entries: the function at that position of
// the lowering list lowers as a trap.
fn jet_driver_keep_going_trap_lowering(kg: &JetDriverKeepGoingLog, functions: &[TFunc]) {
    skip :: jet_driver_keep_going_skip_set(kg.skip)
    loop position in 0..<functions.len() {
        if skip.get("lower:{functions[position].name}@{position}") == None -> next
        function :: ~functions[position]
        jet_driver_keep_going_row(&kg, "lower", "{function.name} [{function.key}]", "TRAPPED", "lowered as a trap: an earlier keep-going run crashed lowering it", "{function.source_file}:{function.source_span.start}..{function.source_span.end}")
        functions[position] = jet_driver_keep_going_tir_trap(function, "keep-going trap: lowering this function crashed an earlier run")
    }
}

// `emit:<name>@<position>` skip entries: the function at that position of
// the optimized program is emitted as a trap.
fn jet_driver_keep_going_trap_emission(kg: &JetDriverKeepGoingLog, program: &MIRProgram) {
    skip :: jet_driver_keep_going_skip_set(kg.skip)
    loop position in 0..<program.functions.len() {
        if skip.get("emit:{program.functions[position].name}@{position}") == None -> next
        function :: ~program.functions[position]
        jet_driver_keep_going_row(&kg, "emit", "{function.name} [{function.key}]", "TRAPPED", "emitted as a trap: an earlier keep-going run crashed emitting it", jet_driver_keep_going_mir_site(program, function, function.span))
        program.functions[position] = jet_driver_keep_going_mir_trap(function, "keep-going trap: emitting this function crashed an earlier run")
    }
}

// Each optimizer failure is a row. The failing check then names every other
// function it rejects in the program as it stands; all of them become traps
// together and the optimizer runs again on the program, so reruns grow with
// the failing checks rather than with the failing functions.
fn jet_driver_keep_going_optimize(kg: &JetDriverKeepGoingLog, program: &MIRProgram, first: ^MIROptimizationResult, full_verification: Bool) -> MIROptimizationResult {
    optimization := ^first
    attempts := 0
    traps := 0
    loop attempts < JET_DRIVER_KEEP_GOING_OPTIMIZER_RETRIES {
        optimizer_error :: optimization.error ?? { break }
        failures :: mir_optimizer_function_failures(program, optimizer_error)
        rows :: jet_driver_mir_function_rows(program.functions)
        trapped := 0
        loop failure in failures {
            phase :: if failure.kind == .Lint -> "mir-lint" else -> "optimize"
            position := -1
            if failure.function == .Val(function_id) -> position = rows.get(function_id.value) ?? -1
            item := "-"
            site := "{failure.span.start}..{failure.span.end}"
            if position >= 0 {
                item = "{program.functions[position].name} [{program.functions[position].key}]"
                site = jet_driver_keep_going_mir_site(program, program.functions[position], failure.span)
            }
            jet_driver_keep_going_row(&kg, phase, item, "E0003", failure.message, site)
            if position < 0 -> next
            program.functions[position] = jet_driver_keep_going_mir_trap(program.functions[position], "keep-going trap: the MIR {phase} check failed")
            trapped += 1
        }
        if trapped == 0 -> break
        traps += trapped
        attempts += 1
        optimization = optimize_mir_program(&program, full_verification)
    }
    if optimization.error != None -> jet_driver_keep_going_row(&kg, "optimize", "-", "STOPPED", "the optimizer still fails after {traps} keep-going traps in {attempts} reruns; emission runs on the program as the optimizer left it", "-")
    optimization
}

// Every emitter failure is a row naming the function being printed.
fn jet_driver_keep_going_emit(kg: &JetDriverKeepGoingLog, program: &MIRProgram, trace_sink: CompilerTraceSink?) -> JetRustEmitResult {
    kept := jet_rust_emit_program_keep_going(program, jet_driver_native_emit_config(), trace_sink)
    loop kept_failure in kept.failures {
        failure :: kept_failure.failure
        item := "-"
        site := "-"
        if failure.span == .Val(span) -> site = "{span.start}..{span.end}"
        if kept_failure.function == .Val(function_id) {
            if jet_driver_mir_function_index_for_id(program.functions, function_id) == .Val(index) {
                item = "{program.functions[index].name} [{program.functions[index].key}]"
                if failure.span == .Val(span) -> site = jet_driver_keep_going_mir_site(program, program.functions[index], span)
            }
        }
        jet_driver_keep_going_row(&kg, "emit", item, failure.code, "{failure.message}: {failure.detail}", site)
    }
    kept.result
}

// The native AOT emission of the selected program.
fn jet_driver_native_emit_config() -> JetRustEmitConfig Never! {
    JetRustEmitConfig{
        target: "rust_aot",
        root_prefix: "",
        emit_types: true,
        emit_foreign: true,
        emit_metadata: true,
        // The native build profile is `dev` (jet_driver_build_facts), whose
        // development devtools policy keeps the local rail on.
        local_rail: true,
        web_bucket: None,
    }
}

pub fn jet_driver_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult {
    kg := jet_driver_keep_going_log(None)
    jet_driver_compile_stages(^request, &kg)
}

// JET_KEEP_GOING (the bootstrap entry reads it): every phase runs past the
// failures before it; each failure is a row of the result's keep_going_rows.
// The result keeps every error report, so a compile with any row never
// passes; a crash later in the run still leaves the rows already streamed to
// the trace sink.
pub fn jet_driver_compile_keep_going(request: ^JetDriverCompileRequest, options: JetDriverKeepGoing) -> JetDriverCompileResult {
    kg := jet_driver_keep_going_log(Val(options))
    result := jet_driver_compile_stages(^request, &kg)
    if result.internal_problem == .Val(problem) -> jet_driver_keep_going_row(&kg, "internal", "-", "ICE", problem, "-")
    // Reports of a stage that returned early; recorded rows are not repeated.
    kg.diagnostic_mark = 0
    jet_driver_keep_going_diagnostics(&kg, "final", result.diagnostics)
    result.keep_going_rows = kg.rows
    result
}

fn jet_driver_compile_stages(request: ^JetDriverCompileRequest, kg: &JetDriverKeepGoingLog) -> JetDriverCompileResult {
    trace := jet_driver_empty_compile_trace()
    // Phase spans for the host trace (JET_TRACE_FILE). A phase an early
    // return abandons is closed by the next enclosing end the host records.
    if request.trace_sink == .Val(sink) -> sink.begin("load", "", -1, -1)
    load := jet_driver_load(request)
    if request.trace_sink == .Val(sink) -> sink.end("load", load.modules.len())
    if !load.complete {
        failure :: load.failed_stage ?? JetDriverStage.Load
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(failure), false, trace)
    }
    canonical_effect_module_option := jet_driver_canonical_effect_module(request.canonical_effect_source)
    if canonical_effect_module_option == None {
        return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is invalid")
    }
    canonical_effect_module := canonical_effect_module_option ?? return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is unavailable")
    loop unit in load.source_units {
        if jet_driver_module_identity(unit.package_identity, unit.relative_path) == canonical_effect_module.module_identity {
            return jet_driver_compile_internal_result(load, trace, "an authorized source unit collides with the pinned compiler-owned Prelude effect identity")
        }
        if unit.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "an authorized source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    loop generated in load.generated_source_files {
        if generated.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "a loaded generated source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    &load.generated_source_files.push(MIRSourceFile{id: mir_source_file_id(canonical_effect_module.source_file), path: canonical_effect_module.source_file, source: request.canonical_effect_source})
    foreign_provider_inputs := jet_driver_assemble_foreign_providers(request.authorized_sources, &load)
    if !load.complete || jet_driver_has_errors(load.diagnostics) {
        failure :: load.failed_stage ?? JetDriverStage.Load
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(failure), false, trace)
    }
    if !jet_driver_foreign_provider_owners_valid(load.modules, foreign_provider_inputs, &load.diagnostics) {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Load), false, trace)
    }

    target_machine_option := jet_driver_selected_target_machine(request, &load.diagnostics)
    if target_machine_option == None {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    }
    target_machine :: target_machine_option ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)

    registration_inputs := [SemaRegistrationModuleInput]{}
    loop loaded_index in 0..<load.modules.len() {
        loaded_module :: load.modules[loaded_index]
        if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module has no exact source-unit owner", "semantic registration preserves the loader's canonical source-unit identity", "retain the catalog source-unit index returned by JetDriver"))
            return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Load), false, trace)
        }
        unit := load.source_units[loaded_module.source_unit_index]
        registration_foreign_handles_option := jet_driver_registration_foreign_handle_facts(loaded_module.module_identity, foreign_provider_inputs, &load.diagnostics)
        if registration_foreign_handles_option == None {
            return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Load), false, trace)
        }
        registration_foreign_handles :: registration_foreign_handles_option ?? [SemaRegistrationForeignHandleFacts]{}
        &registration_inputs.push(SemaRegistrationModuleInput{
            package_identity: loaded_module.package_identity,
            module_identity: loaded_module.module_identity,
            module_name: loaded_module.module_name,
            module_path: jet_driver_module_display(unit.relative_path),
            source_file: unit.path,
            source_segments: unit.source_segments,
            source_origin: unit.source_origin,
            program: loaded_module.program,
            foreign_handles: registration_foreign_handles,
        })
    }
    canonical_effect_module_identity := canonical_effect_module.module_identity
    &registration_inputs.push(^canonical_effect_module)
    registration_module_count := registration_inputs.len()
    package_policies := [SemaRegistrationPackagePolicy]{}
    loop package in load.packages {
        &package_policies.push(SemaRegistrationPackagePolicy{
            package_identity: package.identity,
            authority_allow: package.authority_allow,
            authority_deny: package.authority_deny,
            authority_needs: package.authority_needs,
            runtime_ceiling: package.runtime_ceiling,
            edition: package.edition,
        })
    }
    if request.trace_sink == .Val(sink) -> sink.begin("register", "", -1, -1)
    registration_graph := sema_registration_prepare_graph(
        registration_inputs,
        load.imports,
        load.package_identity,
        load.entry_module_identity,
        canonical_effect_module_identity,
        foreign_provider_inputs,
        target_machine,
        jet_driver_build_facts(load, request, target_machine),
        request.eval_config.host_hooks,
    )
    if request.trace_sink == .Val(sink) -> sink.end("register", registration_graph.modules.len())
    if kg.enabled -> registration_graph.keep_going = true
    if registration_graph.internal_problem != None {
        loop diagnostic in registration_graph.diagnostics -> &load.diagnostics.push(diagnostic)
        return jet_driver_compile_internal_result(
            load,
            trace,
            registration_graph.internal_problem ?? "canonical effect fact registration failed",
        )
    }
    if request.trace_sink == .Val(sink) -> sink.begin("sema.check", "", -1, -1)
    comptime_stage := sema_collect_comptime_declarations(registration_graph, package_policies, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("sema.check", comptime_stage.modules.len())
    if kg.enabled {
        loop diagnostic in comptime_stage.diagnostics -> &load.diagnostics.push(diagnostic)
        jet_driver_keep_going_diagnostics(&kg, "sema.check", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(&kg, "sema.check", comptime_stage.modules)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if (!kg.enabled && (!comptime_stage.complete || jet_driver_has_errors(comptime_stage.diagnostics))) || comptime_stage.modules.len() != registration_module_count {
        if !kg.enabled {
            loop diagnostic in comptime_stage.diagnostics -> &load.diagnostics.push(diagnostic)
        }
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val(jet_driver_incomplete_graph_problem("semantic declaration checking did not return a complete resolved package graph ({comptime_stage.modules.len()} of {registration_module_count} modules checked)", comptime_stage.modules))
        }
        return result
    }

    // The stage callees read `load` while they append diagnostics, so the
    // diagnostics list travels beside it and is put back after each stage.
    stage_diagnostics := load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime", "", -1, -1)
    comptime_run := jet_driver_run_comptime(
        registration_graph,
        comptime_stage.sources,
        comptime_stage.names,
        [SemaComptimeItemValue]{},
        [SemaComptimeFunctionResult]{},
        load,
        request,
        &stage_diagnostics,
    )
    if request.trace_sink == .Val(sink) -> sink.end("comptime", comptime_run.values.len())
    load.diagnostics = stage_diagnostics
    trace = comptime_run.trace
    if comptime_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime", load.diagnostics)
        if !comptime_run.complete -> jet_driver_keep_going_row(&kg, "comptime", "-", "INCOMPLETE", comptime_run.internal_problem ?? "comptime execution did not complete; the staged values so far are kept", "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !comptime_run.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Comptime), false, trace)
        if {
            comptime_run.internal_problem != None -> {
                result.internal_problem = comptime_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val("comptime execution did not complete with a value, control result, or user diagnostic")
            }
        }
        return result
    }
    if request.trace_sink == .Val(sink) -> sink.begin("sema.finalize", "", -1, -1)
    checked_graph := sema_finalize_registration_graph(registration_graph, comptime_stage, comptime_run.values, comptime_run.functions, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("sema.finalize", checked_graph.modules.len())
    if checked_graph.modules.len() != registration_module_count {
        loop diagnostic in checked_graph.diagnostics -> &load.diagnostics.push(diagnostic)
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val("semantic finalization did not return every registered module")
        }
        return result
    }
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.bodies", "", -1, -1)
    body_run := jet_driver_orchestrate_comptime_bodies(
        registration_graph,
        comptime_stage,
        ^checked_graph,
        comptime_run.values,
        comptime_run.functions,
        trace,
        load,
        request,
        &stage_diagnostics,
    )
    if request.trace_sink == .Val(sink) -> sink.end("comptime.bodies", body_run.values.len())
    load.diagnostics = stage_diagnostics
    trace = body_run.trace
    if body_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime.bodies", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(&kg, "comptime.bodies", body_run.graph.modules)
        if body_run.internal_problem == .Val(problem) -> jet_driver_keep_going_row(&kg, "comptime.bodies", "-", "INCOMPLETE", problem, "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !body_run.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if {
            body_run.internal_problem != None -> {
                result.internal_problem = body_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val(jet_driver_incomplete_graph_problem("semantic body rechecking did not return a complete resolved package graph", body_run.graph.modules))
            }
        }
        return result
    }
    checked_graph = ^body_run.graph
    comptime_values := body_run.values
    comptime_functions := body_run.functions

    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.validate", "", -1, -1)
    validation := jet_driver_validate_checked_text(
        registration_graph,
        comptime_stage,
        ^checked_graph,
        comptime_values,
        comptime_functions,
        trace,
        load,
        request,
        &stage_diagnostics,
    )
    if request.trace_sink == .Val(sink) -> sink.end("comptime.validate", validation.values.len())
    load.diagnostics = stage_diagnostics
    trace = validation.trace
    if validation.soft_stop -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime.validate", load.diagnostics)
        if !validation.complete -> jet_driver_keep_going_row(&kg, "comptime.validate", "-", "INCOMPLETE", validation.internal_problem ?? "checked text evaluation did not complete", "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !validation.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Comptime), false, trace)
        result.internal_problem = validation.internal_problem
        if result.internal_problem == None && !jet_driver_has_errors(load.diagnostics) -> result.internal_problem = Val("checked text evaluation did not return a complete validation or diagnostic")
        return result
    }
    checked_graph = ^validation.graph
    comptime_values = validation.values
    comptime_functions = validation.functions
    resolved_registration := sema_comptime_graph_with_values(registration_graph, comptime_values)
    if !jet_driver_merge_checked_text_functions(&checked_graph, resolved_registration, comptime_functions) {
        if !kg.enabled -> return jet_driver_compile_internal_result(load, trace, "staged method closure lost its checked function or registered owner")
        jet_driver_keep_going_row(&kg, "comptime.validate", "-", "ICE", "staged method closure lost its checked function or registered owner", "-")
    }

    // Every checked function moves out of its graph module into one list, so
    // the checked TIR is resident once from here on: the rows return to their
    // modules after lowering for the entry and foreign lookups
    // (jet_driver_restore_checked_functions) and are released after those.
    checked_functions := [TFunc]{}
    // Per row of `checked_functions`: false for a repeated key that
    // JET_KEEP_GOING leaves unlowered.
    lowering_candidates := [Bool]{}
    // Per graph module, how many rows of `checked_functions` it owns.
    module_function_counts := [Int]{}
    function_owners := [String:String]{}
    registered_function_keys := [String:[String:Bool]]{}
    loop source_module in registration_graph.modules {
        keys := registered_function_keys.get(source_module.module_identity) ?? [String:Bool]{}
        loop function in source_module.functions -> keys[function.symbol.id.key] = true
        loop nominal in source_module.nominals {
            loop function in nominal.methods -> keys[function.symbol.id.key] = true
        }
        loop implementation in source_module.impls {
            loop function in implementation.methods -> keys[function.symbol.id.key] = true
        }
        registered_function_keys[source_module.module_identity] = keys
    }
    failed_stage := JetDriverStage?{None}
    runtime_semantic_modules := [SemaGraphModuleResult]{}
    loop graph_module_index in 0..<checked_graph.modules.len() {
        module_functions := [TFunc]{}
        jet_codegen_move_function_rows(&module_functions, &checked_graph.modules[graph_module_index].functions)
        // The module carries no functions now, so the runtime copy below
        // holds only its declarations.
        graph_module :: checked_graph.modules[graph_module_index]
        registered_keys := registered_function_keys.get(graph_module.module_identity) ?? [String:Bool]{}
        // D-FAIL-CONV2=A: the Prelude conversions sema injected after the
        // module's bodies are the module's own items (Rust pushes them into
        // `module.items`) though registration never saw them.
        loop key in graph_module.injected_function_keys -> registered_keys[key] = true
        if graph_module.module_identity != canonical_effect_module_identity {
            &runtime_semantic_modules.push(graph_module)
            module_matches := 0
            loop loaded_module in load.modules {
                if loaded_module.module_identity == graph_module.module_identity -> module_matches += 1
            }
            if module_matches != 1 {
                &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a semantic module does not map to exactly one loaded source identity", "source, package, and module identities remain attached across graph registration", "retain the loader's exact module identity in each semantic result"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
            }
        }
        loop function_index in 0..<module_functions.len() {
            function :: module_functions[function_index]
            if function.module_identity != graph_module.module_identity || registered_keys.get(function.key) == None {
                &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", function.source_span, "a checked function lost its canonical module or symbol identity", "cross-module call resolution and MIR IDs use exact declaration identities", "preserve module_identity and the original function SymbolId through Sema"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
            }
            if {
                function_owners.get(function.key) != None -> {
                    &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", function.source_span, "two checked functions share one canonical symbol key", "every lowered function identity names exactly one declaration in the package graph", "report the duplicate Sema function key"))
                    failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
                    // JET_KEEP_GOING: the first function of a key lowers.
                    if kg.enabled {
                        &lowering_candidates.push(false)
                        next
                    }
                }
                else -> {
                    _ := &function_owners.add(function.key, graph_module.module_identity)
                }
            }
            &lowering_candidates.push(true)
        }
        &module_function_counts.push(module_functions.len())
        jet_codegen_move_function_rows(&checked_functions, &module_functions)
    }
    if jet_driver_has_errors(load.diagnostics) -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
    if failed_stage != None && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, failed_stage, false, trace)

    // #3980: lower only the Core source bodies the program reaches (Rust
    // TIR `should_lower_imported_core_body`).
    if request.trace_sink == .Val(sink) -> sink.begin("lower", "", -1, -1)
    lowering_rows := jet_codegen_reachable_core_rows(checked_functions, ^lowering_candidates, jet_driver_prunable_core_modules(load, request.core_sources, runtime_semantic_modules))
    sema_functions := [TFunc]{}
    unlowered_functions := [TFunc]{}
    jet_driver_partition_checked_functions(&checked_functions, lowering_rows, &sema_functions, &unlowered_functions)
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "sema", load.diagnostics)
        if kg.skip.len() > 0 -> jet_driver_keep_going_trap_lowering(&kg, &sema_functions)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }

    lowered := lower_functions(&sema_functions, &runtime_semantic_modules, load.source_files, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("lower", lowered.functions.len())
    if lowered.functions.len() != sema_functions.len() {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering did not return every checked function", "a successful lowering preserves the complete checked function set", "report this incomplete codegen result as a compiler defect"))
        if !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)
    }
    jet_driver_restore_checked_functions(&checked_graph, module_function_counts, lowering_rows, &sema_functions, &unlowered_functions)
    function_index := 0
    loop function_index < lowered.functions.len() {
        function :: lowered.functions[function_index]
        owner_identity := function_owners.get(function.key)
        if {
            owner_identity == None -> {
                &load.diagnostics.push(jet_driver_diagnostic_at_optional_loaded_site(load, owner_identity, "E0003", function.span, "a lowered function has no exact checked-module owner", "MirFunction.key preserves its unique checked TFunc.key", "retain the canonical TFunc.key through Codegen"))
            }
            else -> {
                owner_module_identity :: owner_identity ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)
                if function.module_id.value != mir_module_id(owner_module_identity).value {
                    &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, owner_module_identity, "E0003", function.span, "Codegen assigned a function to a display-name module identity", "MIR module IDs derive from checked module_identity, never language module_name", "lower MirFunction.module_id from TFunc.module_identity"))
                }
            }
        }
        function_index += 1
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "lower", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)

    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    entry_function := jet_driver_resolve_entry_function(load, checked_graph, lowered.functions, &stage_diagnostics)
    load.diagnostics = stage_diagnostics
    web_target := if request.target == {
        .Web(_, _, _) -> true
        .Native -> false
    }
    if entry_function == None && web_target {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the Web compile target requires an explicit package entry function", "WebApplication publication invokes exactly the manifest-selected checked entry", "declare an `outputs.web.entry` function in the selected package"))
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    }
    if kg.enabled -> jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
    if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    package_facts_option := jet_driver_package_facts(
        load,
        request,
        target_machine,
        checked_graph.core_usage.used_core,
        checked_graph.core_usage.inferred_layer,
        checked_graph.hardware_use,
        &stage_diagnostics,
    )
    load.diagnostics = stage_diagnostics
    package_facts :: package_facts_option ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    foreign_artifacts := lower_foreign_artifacts(checked_graph.modules, package_facts)
    // The checked TIR functions are as large as the MIR lowered from them;
    // release them before MIR assembly and optimization.
    loop module_index in 0..<checked_graph.modules.len() -> checked_graph.modules[module_index].functions = [TFunc]{}
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("assemble", "", -1, -1)
    program := jet_driver_assemble_mir(
        load,
        runtime_semantic_modules,
        checked_graph.imports,
        checked_graph.names,
        ^lowered,
        foreign_artifacts,
        package_facts,
        true,
        kg.enabled,
        &stage_diagnostics,
    )
    load.diagnostics = stage_diagnostics
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if program == None {
        if !jet_driver_has_errors(load.diagnostics) {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the resolved semantic graph cannot be represented by the current MIR item schema", "assembly preserves exact module, import, declaration, function, and source identities; unsupported item kinds fail closed", "add canonical MIR rows for the checked item kind before treating the package graph as complete"))
        }
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    }
    program_value := program ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    web_profile := if request.target == {
        .Native -> None
        .Web(_, _, profile) -> Val(profile)
    }
    artifact_plan_option := jet_driver_artifact_plan(program_value, entry_function, package_facts, target_machine, web_profile)
    if artifact_plan_option == None {
        return jet_driver_compile_internal_result(load, trace, "the compiler could not construct an exact MIR artifact plan for the selected execution target")
    }
    artifact_plan :: artifact_plan_option ?? return jet_driver_compile_internal_result(load, trace, "the compiler artifact plan is unavailable")
    program_value.artifacts = [MIRArtifactPlan]{artifact_plan}
    // Compile time is explicit in the checker, so ordinary immutable bindings
    // over pure work are folded here, once, for every execution tier.
    program_value = jet_driver_fold_pure_calls(^program_value)
    if request.trace_sink == .Val(sink) -> sink.end("assemble", program_value.functions.len())

    // The optimizer rewrites the program in place (no second copy of the
    // largest compile-time structure); an optimizer error is located through
    // the function owners kept here. MIR Lint checks the optimized program on
    // every compile and every pass when the request asks for full verification.
    function_owners_for_errors := jet_driver_mir_function_owners(program_value)
    if request.trace_sink == .Val(sink) -> sink.begin("optimize", "", -1, -1)
    optimization := optimize_mir_program(&program_value, request.mir_lint_every_pass)
    if kg.enabled {
        optimization = jet_driver_keep_going_optimize(&kg, &program_value, ^optimization, request.mir_lint_every_pass)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if request.trace_sink == .Val(sink) -> sink.end("optimize", function_owners_for_errors.len())
    if optimization.error != None && kg.enabled -> optimization.error = None
    if optimization.error == {
        Val(optimizer_error) -> {
            if optimizer_error.kind == .Lint -> return jet_driver_compile_internal_result(load, trace, optimizer_error.message)
            pass_location := SemaSourceLocation?{None}
            if optimizer_error.function == {
                Val(function_identity) -> pass_location = jet_driver_source_location_for_mir_function(load, function_owners_for_errors, function_identity, optimizer_error.span)
                None -> {}
            }
            &load.diagnostics.push(jet_driver_diagnostic_with_location("E0003", optimizer_error.span, pass_location, "the checked MIR optimizer failed", optimizer_error.message, "do not emit a package graph rejected by MIR legality validation"))
        }
        None -> {}
    }
    if !optimization.complete || optimization.report.completed.len() != optimization.report.production_order.len() {
        if kg.enabled {
            jet_driver_keep_going_row(&kg, "optimize", "-", "INCOMPLETE", "the MIR optimizer did not complete every production pass; emission runs on the program as the optimizer left it", "-")
        } else {
            if !jet_driver_has_errors(load.diagnostics) {
                &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the canonical MIR optimizer is incomplete", "Rust emission requires every declared ordered production optimizer stage to complete", "complete the canonical MIR optimization result before requesting an AOT artifact"))
            }
            return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        }
    }
    optimized_program := ^program_value
    if entry_function != None {
        entry_id :: entry_function ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        if !jet_driver_has_mir_function_id(optimized_program.functions, entry_id) {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the MIR optimizer result lost the explicit package entry function", "the typed entry binding must survive every optimizer stage unchanged", "preserve the selected MirFunctionId through optimization"))
            if !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        }
    }
    if web_target {
        web_config_option := if request.target == {
            .Native -> None
            .Web(assets, release_policy, _) -> Val(JetWebEmitConfig{
                artifact: artifact_plan.id,
                layout: jet_target_layout_from_machine(target_machine),
                assets: assets,
                semantic_digest: mir_program_digest(optimized_program),
                root_prefix: "",
                release_devtools_policy: release_policy,
            })
        }
        web_config :: web_config_option ?? return jet_driver_compile_internal_result(load, trace, "the selected Web artifact has no source Web emitter configuration")
        if jet_web_emit(optimized_program, web_config) == {
            .Complete(artifacts) -> {
                result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, None, true, trace)
                result.web_artifact = Val(artifact_plan.id)
                result.web_artifacts = Val(artifacts)
                return result
            }
            .Incomplete(failure) -> {
                user_target_error := if failure.kind == {
                    .InvalidAssets -> true
                    .InvalidLayout -> true
                    else -> false
                }
                if user_target_error {
                    &load.diagnostics.push(jet_driver_diagnostic_with_optional_location(
                        failure.code,
                        failure.span,
                        None,
                        failure.message,
                        failure.detail,
                        "resolve the selected Web asset or layout error before publication",
                    ))
                    return jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, Val(JetDriverStage.Emit), false, trace)
                }
                result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, Val(JetDriverStage.Emit), false, trace)
                result.internal_problem = Val("Web emission failed internally: {failure.message}: {failure.detail}")
                return result
            }
        }
    }
    if request.eval_config.runtime_execution {
        runtime_artifact := jet_driver_runtime_artifact_id(optimized_program)
        result := jet_driver_compile_result(
            load,
            load.diagnostics,
            entry_function,
            Val(^optimized_program),
            None,
            None,
            None,
            true,
            trace,
        )
        result.runtime_artifact = runtime_artifact
        if entry_function != None && result.runtime_artifact == None {
            return jet_driver_compile_internal_result(load, trace, "the checked Cranelift MIR artifact has no unique runtime entry identity")
        }
        return result
    }

    if request.trace_sink == .Val(sink) -> sink.begin("emit", "", -1, -1)
    if kg.enabled && kg.skip.len() > 0 {
        jet_driver_keep_going_trap_emission(&kg, &optimized_program)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    emitted := if kg.enabled -> jet_driver_keep_going_emit(&kg, &optimized_program, request.trace_sink) else -> jet_rust_emit_program(optimized_program, jet_driver_native_emit_config(), request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("emit", optimized_program.functions.len())
    emitted_source := String?{None}
    emit_manifest := JetRustEmitManifest?{None}
    emission_complete := false
    if emitted == {
        .Complete(source, manifest) -> {
            if {
                manifest.schema_version != MIR_SCHEMA_VERSION || manifest.target != "rust_aot" || manifest.package_identity != load.package_identity || manifest.function_count != optimized_program.functions.len() || manifest.type_count != optimized_program.types.len() || manifest.foreign_count != optimized_program.foreign.len() -> {
                    &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "Rust emission returned a manifest inconsistent with the checked MIR artifact", "emitter output identity and row counts are bound to the optimized program", "preserve the manifest facts produced by the canonical Rust emitter"))
                }
                else -> {
                    emitted_source = Val(source)
                    emit_manifest = Val(manifest)
                    emission_complete = true
                }
            }
        }
        .Incomplete(failure) -> {
            &load.diagnostics.push(jet_driver_diagnostic_with_optional_location(failure.code, failure.span, None, failure.message, failure.detail, "resolve the emitter's typed failure before returning a native AOT artifact"))
        }
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "emit", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !emission_complete -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Emit), false, trace)
    jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), emitted_source, emit_manifest, None, true, trace)
}
