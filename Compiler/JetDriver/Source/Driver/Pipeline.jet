jet_driver_source_location_for_load_module: fn(load: JetDriverLoadResult, module_identity: ModuleID, site: Span) -> SemaSourceLocation? {
    ^selected_index: Int?{None}
    ^index: 0
    loop index < load.modules.len() {
        if load.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index: selected_index ?? return None
    loaded_module: load.modules[module_index]
    if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() {
        return None
    }
    sema_source_location_at(load.source_units[loaded_module.source_unit_index].source_segments, site)
}

jet_driver_source_location_for_registration_module: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, site: Span) -> SemaSourceLocation? {
    ^selected_index: Int?{None}
    ^index: 0
    loop index < graph.modules.len() {
        if graph.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index: selected_index ?? return None
    sema_source_location_at(graph.modules[module_index].source_segments, site)
}

jet_driver_diagnostic_with_location: fn(code: String, span: Span, location: SemaSourceLocation?, what: String, why: String, fix: String) -> Diagnostic {
    exact_location: location ?? return jet_driver_diagnostic(code, span, what, why, fix)
    ^diagnostic: jet_driver_diagnostic(code, span, what, why, fix)
    diagnostic_with_source_mapping(diagnostic, exact_location.source_path, exact_location.aggregate_start, exact_location.source_start)
}

jet_driver_diagnostic_at_registration_site: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    ^location: jet_driver_source_location_for_registration_module(graph, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}

// The registration-site diagnostic on the graph `program` owns (a comptime
// run's tables).
jet_driver_diagnostic_at_program_site: fn(program: SemaProgramTables, module_identity: ModuleID, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    jet_driver_diagnostic_at_registration_site(program.registration_graph, module_identity, code, span, what, why, fix)
}

jet_driver_diagnostic_at_loaded_site: fn(load: JetDriverLoadResult, module_identity: ModuleID, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    ^location: jet_driver_source_location_for_load_module(load, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}

jet_driver_attach_registration_source_location: fn(diagnostic: Diagnostic, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Diagnostic Never! {
    // copy: the attached diagnostic is a new owned row. If it already has a location it equals
    // `diagnostic`, which the caller keeps in its list (a read parameter).
    if diagnostic.source_path != None || diagnostic.span == None -> return diagnostic.copy()
    span: diagnostic.span ?? return diagnostic
    location: jet_driver_source_location_for_registration_module(graph, module_identity, span) ?? return diagnostic
    // copy: `diagnostic` is a read parameter; the source-mapped result owns its own value.
    diagnostic_with_source_mapping(diagnostic.copy(), location.source_path, location.aggregate_start, location.source_start)
}

// jet_driver_attach_registration_source_location on the graph `program` owns
// (a comptime run's tables).
jet_driver_attach_program_source_location: fn(diagnostic: Diagnostic, program: SemaProgramTables, module_identity: ModuleID) -> Diagnostic Never! {
    jet_driver_attach_registration_source_location(diagnostic, program.registration_graph, module_identity)
}

jet_driver_module_display: fn(relative_path: String) -> String Never! {
    ^parts: relative_path.split("/").to_list()
    file_name: parts.pop() ?? "module.jet"
    ^name_parts: file_name.split(".").to_list()
    if name_parts.len() > 1 -> ^_: name_parts.pop()
    ^file_base: name_parts.join(".")
    if file_base.len() == 0 -> file_base = "module"
    parts.push(file_base)
    parts.join("/")
}

// A dependency package is checked as its own package. A dependency with
// errors fails the importer once per dependency package: its own errors are
// reported inline, followed by one E0626 naming the package and the check
// that owns it. A dependency's warnings stay with its own check. A lint the
// entry package's `policy.lints.deny` names fails the build as E1293.
jet_driver_summarize_dependency_reports: fn(load: JetDriverLoadResult, diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    ^entry_root: ""
    ^entry_deny: [String]{}
    loop package in load.packages {
        if package.identity == load.package_identity {
            entry_root = package.root_path
            entry_deny = package.policy_lints_deny
        }
    }
    ^kept: [Diagnostic]{}
    ^held: [Diagnostic]{}
    ^held_owners: [Int]{}
    ^failing: [Bool]{}
    loop _ in load.packages -> failing.push(false)
    loop diagnostic in diagnostics {
        // Diagnostics name a source by its display path; package roots are canonical.
        source_path: diagnostic.source_path ?? ""
        path: if source_path.len() == 0 -> "" else -> jet_driver_physical_path(entry_root, source_path)
        ^owner: -1
        ^owner_length: -1
        loop (index, package) in load.packages {
            if path.len() == 0 || package.root_path.len() <= owner_length || !jet_driver_path_within(path, package.root_path) {
                next
            }
            owner = index
            owner_length = package.root_path.len()
        }
        if owner < 0 || load.packages[owner].identity == load.package_identity || load.packages[owner].identity.starts_with("source-root:") {
            if diagnostic.severity == DIAGNOSTIC_LINT && pkg_lint_policy_is_denied(entry_deny, diagnostic.code) {
                kept.push(pkg_lint_e1293(diagnostic))
            } else { kept.push(diagnostic.copy()) }
            next
        }
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        failing[owner] = true
        held.push(diagnostic.copy())
        held_owners.push(owner)
    }
    loop index in 0..<load.packages.len() {
        if !failing[index] -> next
        loop (position, diagnostic) in held {
            if held_owners[position] == index -> kept.push(diagnostic)
        }
        package: load.packages[index]
        root: jet_driver_display_path(entry_root, package.root_path)
        kept.push(jet_driver_diagnostic_without_span("E0626", "Dependency package `{package.name}` has errors", "a dependency package is checked as its own package; its errors, shown above, fail every package that imports it", "fix the errors shown above; `jet check {root}` checks that package on its own"))
    }
    kept
}

jet_driver_compile_result: fn(
    load: JetDriverLoadResult,
    diagnostics: [Diagnostic],
    failed_stage: JetDriverStage?,
    complete: Bool,
    trace: JetDriverCompileTrace,
) -> JetDriverCompileResult Never! {
    // Advice leaves the diagnostic stream for `jet lint <file>`; a lint the
    // entry package denies is an E1293 error by now and stays.
    summarized: jet_driver_summarize_dependency_reports(load, diagnostics)
    ^shown: [Diagnostic]{}
    ^advice: [Diagnostic]{}
    loop diagnostic in summarized.move() {
        if diagnostic_is_report(diagnostic) {
            advice.push(diagnostic)
            next
        }
        shown.push(diagnostic)
    }
    JetDriverCompileResult{
        diagnostics: shown,
        advice: advice,
        generated_source_files: load.generated_source_files,
        package_identity: load.package_identity,
        entry_module_identity: module_text(load.module_table, load.entry_module_identity),
        comptime_stdout: trace.stdout.join(""),
        comptime_stderr: trace.stderr.join(""),
        comptime_debug_trace: trace.debug_trace.join(""),
        soft_stop: trace.soft_stop,
        exit_code: trace.exit_code,
        failed_stage: failed_stage,
        complete: complete,
        internal_problem: load.internal_problem,
        authority_policy: jet_driver_authority_policy(load),
        doc_modules: load.doc_modules,
        doc_interner: load.doc_interner,
        build_program: load.build_program,
        build_types: load.build_types,
        build_nodes: if complete -> load.build_nodes else -> None,
        run_member_paths: load.run_member_paths,
        typed_goals: load.typed_goals,
        allocator: jet_driver_entry_allocator(load),
        log_filter: jet_driver_entry_log(load),
        harden: jet_driver_entry_harden(load),
        events: trace.events,
    }
}

// Whether a checked body holds a `#Todo` goal (FnBody.typed_goals).
jet_driver_has_typed_goals: fn(modules: [SemaGraphModuleResult]) -> Bool Never! {
    loop graph_module in modules {
        loop function in graph_module.functions {
            if function.typed_goals.len() > 0 -> return true
        }
    }
    false
}

// E0744: a WebAssembly target leaves the machine instructions to the engine
// that compiles the module, and no engine states that its code takes the same
// time for every value, so the start-up refusal a `policy.harden` entry makes
// on an unconfirmed host (JetIR Build.jet ir_timing_admitted) is known when
// such a program is built for it.
jet_driver_timing_target_refusal: fn(load: JetDriverLoadResult, modules: [SemaGraphModuleResult], machine: TargetMachine) -> Diagnostic? Never! {
    if !machine.triple.starts_with("wasm") || !jet_driver_entry_harden(load) -> return None
    ^fixed: false
    loop graph_module in modules {
        if body_fixed_timing(graph_module.functions) {
            fixed = true
            break
        }
    }
    if !fixed -> return None
    target: if machine.name == "wasm.browser" -> "web" else -> machine.triple
    Val(jet_driver_diagnostic_without_span("E0744", "This package sets `policy.harden`, and its `timing: .Fixed` values would run on `{target}`, where no host is confirmed to run them in fixed time.", "WebAssembly leaves the machine instructions to the engine that compiles the module, and no engine states that its code takes the same time for every value; a hardened package refuses to start on an unconfirmed host, and on this target that is known when it is built.", "Build for a native target, where the program checks its host when it starts, or remove `harden: true` from the package's `policy:`."))
}

// Ordinary Doc preserves its user-only projection. The explicit retained
// Check projection also retains Core/generated/ABI rows from this same graph;
// its separate source index list identifies the actual Review source owners.
jet_driver_doc_modules: fn(request: JetDriverCompileRequest, load: JetDriverLoadResult, graph: SemaGraphResult, registration: SemaRegistrationGraph, values: [SemaComptimeItemValue], effect_identity: ModuleID, checked_projection: Bool, capture: ^JetDriverCheckedProjectionCapture) -> [JetDriverDocModule] Never! {
    ^modules: [JetDriverDocModule]{}
    // copy: the shared name ledger owns its facts for the doc pass, and `graph` is the caller's
    // checked graph (a read parameter), which keeps its names for emission.
    ^names: name_ledger_from_facts(graph.names.copy())
    // copy: the run's symbol table, which names the ids every doc module's
    // facts carry (a call fact's callee, a body's constant).
    names.symbols = registration.symbols.copy()
    ledger: Shared{names.move()}
    memory: Shared{SemaCheckedMemoryFacts{declarations: graph.memory_declarations, projections: graph.memory_projections}}
    layout_engine: sema_comptime_reflection_layout_engine(registration)
    target_layout: jet_target_layout_from_machine(registration.target_machine)
    // Module slots: the loaded unit of each registered module id, -1 for none.
    ^loaded_units: (loop _ in 0..<module_count(registration.module_table) -> -1)
    ^seen: (loop _ in 0..<module_count(registration.module_table) -> false)
    if checked_projection {
        if graph.programs.len() != graph.modules.len() -> return [JetDriverDocModule]{}
        loop loaded in load.modules {
            slot: module_index(loaded.module_identity)
            if slot >= loaded_units.len() || loaded_units[slot] != -1 {
                return [JetDriverDocModule]{}
            }
            loaded_units[slot] = loaded.source_unit_index
        }
    }
    loop (index, graph_module) in graph.modules {
        if graph_module.module_identity == effect_identity || index >= graph.programs.len() -> next
        unit_index: if checked_projection -> loaded_units[module_index(graph_module.module_identity)] else -> (loop loaded in load.modules {
            if loaded.module_identity == graph_module.module_identity {
                break loaded.source_unit_index
            }
        } ?? -1)
        if unit_index < 0 || unit_index >= load.source_units.len() {
            if checked_projection -> return [JetDriverDocModule]{}
            next
        }
        unit: load.source_units[unit_index]
        registered_index: if checked_projection -> sema_registration_module_index(registration, graph_module.module_identity) ?? -1 else -> index
        if registered_index < 0 || registered_index >= registration.modules.len() {
            return [JetDriverDocModule]{}
        }
        registered: registration.modules[registered_index]
        ^path: unit.path
        ^physical_path: unit.path
        ^source: if checked_projection -> registered.source else -> ""
        ^alias: if unit.package_identity == load.package_identity -> "" else -> unit.module_name
        ^source_owner: true
        if checked_projection {
            // A Core unit carries the loader's Core identity (its path or its
            // source owner key); every other unit is keyed by its relative path.
            unit_identity: if jet_driver_unit_is_core(unit) -> jet_driver_unit_module_identity(unit) else -> jet_driver_module_identity(unit.package_identity, unit.relative_path)
            if seen[module_index(graph_module.module_identity)] || registered.module_identity != graph_module.module_identity || unit_identity != module_text(registration.module_table, graph_module.module_identity) || registered.package_identity != unit.package_identity || graph_module.package_identity != unit.package_identity || registered.source_file != unit.path || graph_module.source_file != unit.path || registered.source_origin != unit.source_origin {
                return [JetDriverDocModule]{}
            }
            seen[module_index(graph_module.module_identity)] = true
            if jet_driver_unit_is_core(unit) {
                if unit.root_index != -1 || unit.root_identity != JET_DRIVER_CORE_SOURCE_ROOT || unit.package_identity != unit.path || unit.path != "{JET_DRIVER_CORE_SOURCE_ROOT}/{unit.relative_path}" || unit.source_origin != SemaSourceOrigin.CompilerGenerated {
                    return [JetDriverDocModule]{}
                }
                if unit.file_index >= 0 {
                    if unit.file_index >= request.core_sources.len() {
                        return [JetDriverDocModule]{}
                    }
                    row: request.core_sources[unit.file_index]
                    row_text: row.try_source() ?? return [JetDriverDocModule]{}
                    if row.module_name != unit.module_name || row.path != unit.relative_path || row_text != source {
                        return [JetDriverDocModule]{}
                    }
                    path = row.path
                    alias = row.alias
                } else {
                    // Loader's explicit ABI-only fallback, not an empty real
                    // Core source. Keep its checked row internally, but it is
                    // not a loaded source in Review's input digest.
                    if unit.file_index != -1 || unit.relative_path != "{unit.module_name}.jet" || source != "" || core_module_export(unit.module_name) == None {
                        return [JetDriverDocModule]{}
                    }
                    loop row in request.core_sources {
                        if row.owner == "" && row.module_name == unit.module_name {
                            return [JetDriverDocModule]{}
                        }
                    }
                    source_owner = false
                }
            } else if jet_driver_unit_is_compiler_prelude(unit) {
                // A retained compiler-owned Prelude module (the original
                // errors, the contract rules): checked with the graph, not a
                // Review source owner.
                source_owner = false
            } else {
                if unit.root_index < 0 || unit.root_index >= request.authorized_sources.roots.len() {
                    return [JetDriverDocModule]{}
                }
                root: request.authorized_sources.roots[unit.root_index]
                if root.identity != unit.root_identity -> return [JetDriverDocModule]{}
                if unit.source_origin == SemaSourceOrigin.Snapshot {
                    if unit.file_index < 0 || unit.file_index >= root.files.len() {
                        return [JetDriverDocModule]{}
                    }
                    file: root.files[unit.file_index]
                    if jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), file.path) != unit.path {
                        return [JetDriverDocModule]{}
                    }
                    // A file with a function a `meta.rewrite_body` module
                    // replaces was checked with that function withdrawn.
                    if jet_driver_file_has_replaced(request, file.path) {
                        if jet_driver_withdraw_replaced(request, file.path, file.source) != source {
                            return [JetDriverDocModule]{}
                        }
                    } else {
                        if file.source != source -> return [JetDriverDocModule]{}
                    }
                    physical_path = file.path
                } else {
                    if unit.file_index != -1 || unit.source_origin != SemaSourceOrigin.CompilerGenerated {
                        return [JetDriverDocModule]{}
                    }
                }
            }
            if source_owner -> capture.source_modules.push(modules.len())
            if graph_module.module_identity == load.entry_module_identity {
                if !source_owner || capture.entry_module != None -> return [JetDriverDocModule]{}
                capture.entry_module = Val(modules.len())
            }
        } else {
            if unit.root_index < 0 || unit.root_index >= request.authorized_sources.roots.len() {
                next
            }
            root: request.authorized_sources.roots[unit.root_index]
            if unit.file_index < 0 && unit.source_origin == SemaSourceOrigin.CompilerGenerated && request.doc_generated_modules {
                // A module `build: fn` generated sits where its path names
                // under its package root.
                generated: (loop (row_index, row) in request.generated_modules {
                    if row.package_identity == unit.package_identity && row.relative_path == unit.relative_path {
                        break row_index
                    }
                } ?? -1)
                if generated < 0 -> next
                physical_path = jet_driver_physical_path(root.canonical_path, unit.relative_path)
                source = request.generated_modules[generated].source
            } else {
                if unit.file_index < 0 || unit.source_origin != SemaSourceOrigin.Snapshot || unit.file_index >= root.files.len() {
                    next
                }
                physical_path = root.files[unit.file_index].path
                source = root.files[unit.file_index].source
            }
        }
        modules.push(
            JetDriverDocModule{
                path: path,
                physical_path: physical_path,
                alias: alias,
                source: source,
                items: sema_checked_shape_defaults(graph.programs[index], registered, registration.symbols, values).items,
                block_spans: graph.programs[index].block_spans,
                imports: graph.programs[index].imports,
                tables: graph.programs[index].tables,
                module_name: graph_module.module_name,
                functions: graph_module.functions,
                name_references: graph_module.name_references,
                call_facts: graph_module.call_facts,
                name_ledger: Val(ledger),
                name_module_index: index,
                memory_facts: Val(memory),
                module_identity: module_text(registration.module_table, graph_module.module_identity),
                module_id: graph_module.module_identity,
                target_triple: registration.target_machine.triple,
                target_layout: Val(target_layout.copy()),
                layout_facts: sema_checked_layout_projections(registration, registered_index, graph.programs[index].items, layout_engine, module_text(registration.module_table, graph_module.module_identity)),
                app_route_roots: graph.programs[index].app_route_roots,
                file_cap: graph.programs[index].file_cap,
                reexports: sema_public_api_reexports(registration, graph, registered_index),
                alias_shown: sema_type_alias_shown_params(registration, registered_index, graph.programs[index].items),
            },
        )
    }
    if checked_projection && (seen.len() != loaded_units.len() || capture.entry_module == None) {
        return [JetDriverDocModule]{}
    }
    modules
}

jet_driver_authority_policy: fn(load: JetDriverLoadResult) -> JetDriverAuthorityPolicy? {
    loop package in load.packages {
        if package.identity == load.package_identity {
            // Expert entries hold expert effects only; a row of nothing else
            // sets no run ceiling (authority_expert_only).
            return Val(JetDriverAuthorityPolicy{manifest_path: package.manifest_path, inline_package: package.inline_package, allow: if authority_expert_only(package.authority_allow ?? [String]{}) -> None else -> package.authority_allow, deny: package.authority_deny, subject: package.name, read_scope: package.authority_read_scope, needs: package.authority_needs})
        }
    }
    None
}

jet_driver_entry_selection: fn(load: JetDriverLoadResult) -> JetDriverPackageEntry? {
    loop package in load.packages {
        if package.identity == load.package_identity -> return package.entry
    }
    None
}

// jet_driver_resolve_entry_function, then jet_driver_default_run_entry, over
// the checked functions the slot IR builder reads (`functions`, before any
// lowering): the key of the selected Source Output's function, else of the
// manifest `entry:` binding, else of the entry module's `run: fn` when it
// takes no parameter or one `#CLI` record. None when the program has no
// executable entry (a diagnostic says why when a binding fails).
jet_driver_resolve_entry_key: fn(load: JetDriverLoadResult, table: ModuleTable, semantic_graph: SemaGraphResult, functions: [FnBody], modules: [SemaGraphModuleResult], diagnostics: ^[Diagnostic]) -> String? {
    // One or two keys are read: each is counted over the rows, never a
    // whole-program count map (a Map filled in row order costs O(N^2) moves).
    loop source_module in semantic_graph.modules {
        loop constant in source_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind == OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= semantic_graph.modules.len() {
                    diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, source_module.module_identity, "E0003", output.reference, "the selected Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    return None
                }
                owner_identity: semantic_graph.modules[output.module_id].module_identity
                function_key: symbol_key_text(SymbolKind.Function, module_text(table, owner_identity), "", output.semantic_name)
                if jet_driver_function_key_count(functions, function_key) != 1 {
                    diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, owner_identity, "E0003", output.definition, "the selected Output entry has no unique checked function identity", "Output entry identity is retained from its registered callable", "retain the canonical function key through checking"))
                    return None
                }
                // An entry with its typed CLI parameter starts at the
                // generated wrapper of its Output (Registration/CliEntry.jet).
                if output.params.len() == 1 {
                    wrapper_key: symbol_key_text(SymbolKind.Function, module_text(table, source_module.module_identity), "", sema_cli_entry_output_wrapper(output.address))
                    if jet_driver_function_key_count(functions, wrapper_key) == 1 {
                        return Val(wrapper_key)
                    }
                }
                return Val(function_key)
            }
        }
    }
    entry: jet_driver_entry_selection(load) ?? return jet_driver_default_run_key(load, functions)
    ^target_module_identity: load.entry_module_identity
    if entry.module_alias != None {
        alias: entry.module_alias ?? return None
        ^target: ModuleID?{None}
        loop import in load.imports {
            if import.source_module_identity != load.entry_module_identity || import.declaration.alias != alias || !jet_driver_import_is_module_edge(import.declaration.kind) {
                next
            }
            if target != None {
                diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0105", import.declaration.span, "the package entry module alias resolves more than once", "an explicit `entry: module_alias.function` binds through one loaded module edge", "retain exactly one import for the entry module alias"))
                return None
            }
            target = Val(import.target_module_identity)
        }
        if target == None {
            // `entry: file.function` names the entry package's member file
            // whose stem is `file`, the file the CLI selected as the entry.
            // No such file, or more than one, leaves the output without a
            // unique source entry.
            ^entry_package: ""
            loop module_row in load.modules {
                if module_row.module_identity == load.entry_module_identity {
                    entry_package = module_row.package_identity
                }
            }
            ^members: 0
            loop module_row in load.modules {
                if module_row.package_identity != entry_package || module_row.module_name != alias || module_row.source_unit_index < 0 || !load.source_units[module_row.source_unit_index].in_namespace {
                    next
                }
                members += 1
                target = Val(module_row.module_identity)
            }
            if members != 1 {
                stems: if members == 0 -> "no member file has" else -> "{members} member files have"
                diagnostics.push(jet_driver_diagnostic_at_source("E2105", entry.span, entry.source_path, 0, "the package output entry `{alias}.{entry.function_name}` has no unique source entry: {stems} the stem `{alias}`, and no import of the entry module uses that alias", "an explicit `entry: file.function` binds the one member file whose stem is `file`, or one exact File or Module import alias", "keep exactly one member file named `{alias}.jet`, or import the entry module under that alias"))
                return None
            }
        }
        target_module_identity = target ?? return None
    }
    ^module_found: false
    loop semantic_module in semantic_graph.modules {
        if semantic_module.module_identity == target_module_identity -> module_found = true
    }
    if !module_found {
        diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry target module is not present in semantic results", "entry identity is fixed by the native-authorized module graph and explicit package binding", "retain the resolved entry target module in the checked graph"))
        return None
    }
    function_key: symbol_key_text(SymbolKind.Function, module_text(table, target_module_identity), "", entry.function_name)
    count: jet_driver_function_key_count(functions, function_key)
    if count == 1 -> return Val(function_key)
    if count > 1 {
        diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the declared package entry has no unique checked function identity", "the private entry binding is resolved from its exact registered function symbol", "retain the canonical function key through checking"))
    } else {
        diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package manifest entry function is not declared in the resolved entry module", "entry resolution uses the explicit `outputs.*.entry` function binding", "declare the selected function in the entry module referenced by the manifest"))
    }
    None
}

// How many checked functions carry `key`.
jet_driver_function_key_count: fn(functions: [FnBody], key: String) -> Int Never! {
    ^count: 0
    loop function in functions {
        if function.key == key -> count += 1
    }
    count
}

// jet_driver_default_run_entry over the checked functions: the entry
// module's `run: fn`, when it takes no parameter, else the generated
// `__jet_cli_run` of a typed `run: fn(args: T)`.
jet_driver_default_run_key: fn(load: JetDriverLoadResult, functions: [FnBody]) -> String? Never! {
    // A `meta.rewrite_body` module that replaced the entry file's `run`
    // holds it (jet_driver_entry_run_module).
    key: symbol_key_text(SymbolKind.Function, module_text(load.module_table, load.entry_run_module ?? load.entry_module_identity), "", "run")
    typed_key: symbol_key_text(SymbolKind.Function, module_text(load.module_table, load.entry_module_identity), "", "__jet_cli_run")
    ^typed: false
    loop function in functions {
        if function.key == typed_key && function.params.len() == 0 -> typed = true
    }
    loop function in functions {
        if function.key != key -> next
        if function.params.len() == 0 -> return Val(key)
        if function.params.len() == 1 && typed -> return Val(typed_key)
        return None
    }
    None
}

jet_driver_empty_compile_trace: fn() -> JetDriverCompileTrace Never! {
    JetDriverCompileTrace{stdout: [String]{}, stderr: [String]{}, soft_stop: false, exit_code: None}
}

jet_driver_record_eval_result: fn(trace: ^JetDriverCompileTrace, result: JetEvalIRResult) Never! {
    if result.stdout.len() > 0 -> trace.stdout.push(result.stdout)
    if result.stderr.len() > 0 -> trace.stderr.push(result.stderr)
    if result.debug_trace.len() > 0 -> trace.debug_trace.push(result.debug_trace)
    if result.exit_code != None -> trace.exit_code = result.exit_code
}

jet_driver_host_os_key: fn(value: String) -> String Never! {
    if target_os_parse(value) == .Val(os) -> return target_os_key(os)
    ""
}

// The value a `#build.host.*` read folds to: the running machine's OS as
// `#build.target.os` spells one (`Linux`), or its architecture (`x86_64`);
// "" when the host names neither.
jet_driver_host_fact_value: fn(request: JetDriverCompileRequest, path: String) -> String Never! {
    if path == "#build.host.arch" -> return request.host_facts.host_arch ?? ""
    if path != "#build.host.os" -> return ""
    raw_os: request.host_facts.active_os ?? return ""
    if target_os_parse(raw_os) == .Val(running) -> target_os_name(running) else -> ""
}

// The build snapshot sema folds `#package.*` and `build.*` from. A manifest
// package names itself; the manifest-less rung uses the entry file stem and
// version `0.0.0`. The stamp is the lock's `[build.stamp]` the host read
// (request.build_stamp); without one it is no git revision, clean, the
// compiler's own package version and no time. A compile never captures a fresh
// stamp from git and the clock: only lock writers do. Each loaded dependency's
// settings are its own, each folded over its own writer chain
// (jet_driver_setting_writers).
jet_driver_build_facts: fn(load: JetDriverLoadResult, request: JetDriverCompileRequest, target_machine: TargetMachine) -> SemaBuildFacts Never! {
    ^package_name: ""
    ^package_version: ""
    ^settings: [SemaBuildSetting]{}
    ^package_settings: [SemaPackageSettings]{}
    ^package_markers: [Marker]{}
    ^package_manifest: ""
    ^purposes: [String]{}
    loop package in load.packages {
        if package.identity != load.package_identity {
            package_settings.push(SemaPackageSettings{package_identity: package.identity, settings: jet_driver_build_settings(load, package, request)})
            next
        }
        package_name = package.name
        package_version = package.version ?? ""
        settings = jet_driver_build_settings(load, package, request)
        package_markers = package.markers
        package_manifest = package.manifest_path ?? ""
        purposes = package.purposes
    }
    package_name = jet_driver_package_name(package_name, request.authorized_sources.entry_path)
    if package_version.len() == 0 -> package_version = "0.0.0"
    ^host_os: ""
    if request.host_facts.active_os == .Val(raw_os) -> host_os = jet_driver_host_os_key(raw_os)
    ^toolchain: ""
    if request.host_facts.compiler_identity == .Val(identity) {
        toolchain = jet_target_package_version_from_compiler_identity(identity) ?? ""
    }
    ^stamp_git: String?{None}
    ^stamp_dirty: false
    ^stamp_at: ""
    if request.build_stamp == .Val(stamp) {
        stamp_git = stamp.git
        stamp_dirty = stamp.dirty
        toolchain = stamp.toolchain
        stamp_at = stamp.at
    }
    SemaBuildFacts{
        package_name: package_name,
        package_version: package_version,
        os: if target_os_parse(request.build_os) == .Val(selected) -> target_os_name(selected) else -> jet_target_active_os_name(target_machine, host_os),
        profile: request.profile,
        stamp_git: stamp_git,
        stamp_dirty: stamp_dirty,
        stamp_toolchain: toolchain,
        stamp_at: stamp_at,
        host_os: jet_driver_host_fact_value(request, "#build.host.os"),
        host_arch: jet_driver_host_fact_value(request, "#build.host.arch"),
        artifact_build: request.artifact_build,
        settings: settings.move(),
        package_settings: package_settings.move(),
        compiler_identity: request.host_facts.compiler_identity ?? "",
        package_markers: package_markers.move(),
        package_manifest: package_manifest,
        purposes: purposes.move(),
    }
}

// The entry package's name: the manifest's `declared` name, else the entry
// file's stem, else `script`.
jet_driver_package_name: fn(declared: String, entry_path: String) -> String Never! {
    ^name: declared
    if name.len() == 0 {
        segments: entry_path.split("/").to_list()
        file: segments[segments.len() - 1]
        name = if file.ends_with(".jet") -> file.slice(0, file.len() - 4) else -> file
    }
    if name.len() == 0 -> name = "script"
    name
}

// Each setting `package` declares, at the effective writer of its chain
// (jet_driver_setting_writers): its default, then, for a dependency, the
// entries that set it, then the value the selected `build:` profile gives
// it, then the value the entry package's `build: fn` contributed, as the
// lock records it (the function's environment layer is above the profile's
// optimization-bundle layer), then a `--set` value.
jet_driver_build_settings: fn(load: JetDriverLoadResult, package: JetDriverPackageInfo, request: JetDriverCompileRequest) -> [SemaBuildSetting] Never! {
    ^settings: [SemaBuildSetting]{}
    loop setting in package.settings {
        writers: jet_driver_setting_writers(load, package, setting, request)
        settings.push(jet_driver_setting_effective(setting, writers))
    }
    settings
}

// The manifest spelling of a locked contribution value, which the lock keeps
// in its writer's Debug spelling (FactValue.debug_text): `Int(4)` is `4`,
// `Bool(true)` `true`, `Char('c')` `'c'`, `Text("a")` `"a"` and
// `Enum("Fast")` `Fast`. Any other value is no setting value (None).
jet_driver_locked_setting_text: fn(value: String) -> String? Never! {
    open: value.find("(")
    if open < 0 || !value.ends_with(")") -> return None
    bytes: value.bytes()
    kind: String.from_bytes_lossy(bytes[0..<open])
    body: String.from_bytes_lossy(bytes[open + 1..<bytes.len() - 1])
    if kind == {
        "Bool" | "Int" | "Char" | "Text" -> Val(body)
        "Enum" -> {
            if body.count_bytes() < 2 || !body.starts_with("\"") || !body.ends_with("\"") {
                return None
            }
            Val(String.from_bytes_lossy(body.bytes()[1..<body.count_bytes() - 1]))
        }
        else -> None
    }
}

// Target machine names and their lookup by name; restored45acf6f8f.
JET_DRIVER_TARGET_MACHINE_NAMES: [String]{
    "board.sensor_v1",
    "board.virt_aarch64",
    "wasm.browser",
    "wasm.wasi",
    "wasm.no-os",
    "hosted",
}

jet_driver_target_machine_by_name: fn(name: String, package_version: String) -> TargetMachine? Never! {
    if name == {
        "board.sensor_v1" | "firmware" | "sensor" -> Val(jet_target_machine_board_sensor_v1(package_version))
        "board.virt_aarch64" | "virt" -> Val(jet_target_machine_board_virt_aarch64(package_version))
        "wasm.browser" -> Val(jet_target_machine_wasm_browser(package_version))
        "wasm.wasi" | "wasm32-wasip2" -> Val(jet_target_machine_wasm_wasi(package_version))
        "wasm.no-os" -> Val(jet_target_machine_wasm_no_os(package_version))
        "hosted" -> Val(jet_target_machine_hosted("x86_64-unknown-linux-gnu", package_version))
        else -> None
    }
}

jet_driver_selected_target_machine: fn(
    request: JetDriverCompileRequest,
    diagnostics: ^[Diagnostic],
) -> TargetMachine? {
    target_triple: request.host_facts.target_triple ?? {
        diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its target triple", "target layout and machine identity use only the raw target identity authorized by Host", "supply the compiler target triple through HostFacts"))
        return None
    }
    if target_triple.len() == 0 {
        diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an empty target triple", "target layout and machine identity require the exact selected triple", "supply the compiler target triple through HostFacts"))
        return None
    }
    compiler_identity: request.host_facts.compiler_identity ?? {
        diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its compiler identity", "target layout provenance is bound to the exact compiler identity", "supply compiler identity through HostFacts"))
        return None
    }
    compiler_version: jet_target_package_version_from_compiler_identity(compiler_identity) ?? {
        diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native compiler identity has no parseable exact package version", "target layout facts are versioned by the compiler identity, not the selected program package", "supply a canonical `name@version#build-id` compiler identity"))
        return None
    }
    // A named machine (`--target=board.sensor_v1`) is the machine the
    // program is checked for; the front door passes only declared names.
    if request.target_machine != "" {
        named: jet_driver_target_machine_by_name(request.target_machine, compiler_version)
        if named == None {
            diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the compile request names the undeclared target machine `{request.target_machine}`", "a request selects a machine only by a declared name", "use one of {JET_DRIVER_TARGET_MACHINE_NAMES.join(", ")}"))
        }
        return named
    }
    // A build for an OS no host triple names (`os: web`) targets that OS's
    // machine, so its artifact is checked against that machine's row.
    if target_os_parse(request.build_os) == {
        .Val(.Web) -> return Val(jet_target_machine_wasm_browser(compiler_version))
        .Val(.Wasm) -> return Val(jet_target_machine_wasm_wasi(compiler_version))
        .Val(_) | .None -> {}
    }
    Val(jet_target_machine_for_facts(false, false, target_triple, compiler_version))
}

// Run-wide lookups every function closure of one comptime run shares, built
// once instead of rescanning the graph or the checked functions per lookup.
// The owner maps scan every function of the graph, so they are built at the
// first owner lookup (`owners_built`), not for a run whose items reach no
// function by key.
JetDriverComptimeRunIndex: struct {
    // Function key -> the module that registers it: at the key's id in
    // `owner_keys`, `owners` holds the module's id, or -1 for a key
    // registered by more than one module, which has no unique owner.
    owner_keys: NameTable{name_column_table()},
    owners: [Int]{name_column()},
    owners_built: Bool,
    // Each function any closure or prefetch of the run named, by its node
    // id: its pair of `node_keys` (its module and key), and `nodes`,
    // `checked_at`, `waiting_at` and the `prefetched` rows hold one row per
    // node id.
    node_keys: SemaComptimeKeySet{SemaComptimeKeySet{}},
    nodes: [JetDriverComptimeClosureNode]{[JetDriverComptimeClosureNode]{}},
    // The first row of each node's function in the run's checked
    // functions, or -1.
    checked_at: [Int]{[Int]{}},
    // The row in `waiting_functions` of each node's function's last check,
    // which waits on constants with no value yet, or -1. Until one of those
    // waits has a value, checking the function again gives the same result
    // (every other constant it reads already has its value), so each
    // closure that reaches it reuses that check instead of making its own.
    waiting_at: [Int]{[Int]{}},
    waiting_functions: [SemaComptimeFunctionResult],
    // Checked function row -> what a closure reads of that row besides the
    // result itself (JetDriverComptimeClosureRow), so each later closure
    // that reuses the row skips its body walks.
    closure_rows: [Int:JetDriverComptimeClosureRow]{[Int:JetDriverComptimeClosureRow]{}},
    // Per node, the check jet_driver_comptime_prefetch made of its function
    // ahead of the pass (its one row, or none), which the first closure that
    // would check it takes instead (jet_driver_comptime_prefetched), and,
    // when `prefetched_has_refs`, the body refs the closure row it keeps
    // would compute (JetDriverComptimeClosureRow). A check that splices
    // local values keeps the run's value count when it was made in
    // `prefetched_marks` (-1: none). Rows by node, not maps: a closure takes
    // each check out in place, where a map's removal shifts every later
    // entry.
    prefetched: [[SemaComptimeFunctionResult]]{[[SemaComptimeFunctionResult]]{}},
    prefetched_refs: [[JetDriverComptimeFunctionRef]]{[[JetDriverComptimeFunctionRef]]{}},
    prefetched_has_refs: [Bool]{[Bool]{}},
    prefetched_marks: [Int]{[Int]{}},
    // The functions the pass's prefetch walk checked whose checks waited on
    // constants with no value, row by row with those waits: the walk drops
    // such a check and does not follow it (jet_driver_comptime_prefetch_keep).
    waited_jobs: [SemaComptimeFunctionJob]{[SemaComptimeFunctionJob]{}},
    waited_on: [[String]]{[[String]]{}},
    // What the run's body walks have read of each nominal type's render
    // methods (jet_driver_comptime_owner_refs).
    render: SemaComptimeRenderMemo{SemaComptimeRenderMemo{}},
    // The `#run` sites the current pass has yet to land (its items and the
    // batch it took over, jet_driver_comptime_pass_sites), other than local
    // values: each site's key, under the source offset its span starts at.
    // A function check that captured one ran before its value landed
    // (jet_driver_comptime_site_waits).
    pass_sites: [Int:[String]]{[Int:[String]]{}},
    // The functions each landed constant's value names
    // (TComptimeValue.Function, `f: double` in a folded record), which a
    // closure whose bodies read the constant queues as it queues a function
    // value a body names (jet_driver_comptime_named_refs).
    value_functions: IRReachHeld{IRReachHeld{}},
}

// A function whose visit is the same in every later closure of the run,
// `settled` at the first closure that visits it so: a checked row `row`
// (complete or obligation-pending, reused or the one this visit's fresh check
// adds, which every later visit reuses) with a body and no waits whose
// reachable keys each have one owner, or a foreign function (`foreign`, its
// check, which reads only the graph). A later visit adds no report and
// changes no run state, and it queues `successors` (nodes, in the order the
// visit queues them) every time, so a closure whose functions are all
// settled walks the nodes alone (jet_driver_comptime_settled_closure) and
// gives what the full walk gives.
// A forgotten row unsettles its node. `obligations`: the function adds
// failure obligations to its closure's (sema_comptime_failure_closure_add).
// The impurities are the row's closure row's (JetDriverComptimeClosureRow)
// once a closure asked.
JetDriverComptimeClosureNode: struct {
    settled: Bool{false},
    row: Int{-1},
    foreign: SemaComptimeFunctionResult?{None},
    successors: [Int]{[Int]{}},
    obligations: Bool{false},
    module_known: Bool{false},
    module_impurity: String?{None},
    local_known: Bool{false},
    local_impurity: String?{None},
}

// What a closure reads of one checked function row besides its result, the
// same for every closure of the run, since the graph and the row never
// change: `refs`, the functions its body reaches with no call fact
// (jet_driver_comptime_body_refs), in the order the closure queues them,
// and, once a module value's or a local value's closure asked, why the row
// keeps that value from being computed while building
// (jet_driver_comptime_row_impurity).
JetDriverComptimeClosureRow: struct {
    refs: [JetDriverComptimeFunctionRef],
    module_known: Bool{false},
    module_impurity: String?{None},
    local_known: Bool{false},
    local_impurity: String?{None},
}

jet_driver_comptime_run_index: fn(checked_functions: [SemaComptimeFunctionResult], values: [SemaComptimeItemValue]) -> JetDriverComptimeRunIndex Never! {
    ^index: JetDriverComptimeRunIndex{owners_built: false, waiting_functions: [SemaComptimeFunctionResult]{}}
    loop (row, checked) in checked_functions {
        node: jet_driver_comptime_node_id(index, checked.module_identity, checked.function_key)
        if index.checked_at[node] < 0 -> index.checked_at[node] = row
    }
    loop value in values {
        jet_driver_comptime_value_functions_note(index.value_functions, value.key, value.value)
    }
    index
}

// Records the functions landed value `value` of constant `key` names into
// `held` (ir_reach_held_add).
jet_driver_comptime_value_functions_note: fn(held: ^IRReachHeld, key: String, value: TComptimeValue) Never! {
    ^functions: name_table_sized(4)
    jet_driver_comptime_value_functions(value, functions)
    ir_reach_held_add(held, key, functions)
}

// The functions each landed constant's value names: a kept body that reads
// the constant reaches them (ir_reachable_core_rows).
jet_driver_value_function_keys: fn(values: [SemaComptimeItemValue]) -> IRReachHeld Never! {
    ^held: IRReachHeld{}
    loop value in values { jet_driver_comptime_value_functions_note(held, value.key, value.value) }
    held
}

// Interns each function `value` names into `held`. The items of a list and
// the values of a map share one type, so one scalar among them makes them
// all scalars, which name no function.
jet_driver_comptime_value_functions: fn(value: TComptimeValue, held: ^NameTable) Never! {
    if value == {
        .Function(key) -> { ^_: name_intern(held, key) }
        .List(items) -> {
            if items.len() > 0 && jet_driver_comptime_value_scalar(items[0]) {
                return
            }
            loop item in items { jet_driver_comptime_value_functions(item, held) }
        }
        .Map(entries) -> {
            if entries.len() > 0 && jet_driver_comptime_value_scalar(entries[0].value) {
                return
            }
            loop entry in entries { jet_driver_comptime_value_functions(entry.value, held) }
        }
        .Struct(_, fields) -> {
            loop field in fields { jet_driver_comptime_value_functions(field.value, held) }
        }
        .Enum(_, _, args) -> {
            loop argument in args { jet_driver_comptime_value_functions(argument.value, held) }
        }
        .Present(inner) -> { jet_driver_comptime_value_functions(inner, held) }
        .Failed(report) -> {
            if report == .Told(inner) -> jet_driver_comptime_value_functions(inner, held)
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Unit -> {}
    }
}

jet_driver_comptime_value_scalar: fn(value: TComptimeValue) -> Bool Never! {
    if value == {
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Unit -> true
        .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Function(_) -> false
    }
}

// The owner maps of `graph`, which never changes during a run, filled in
// registration order (module, then its free functions, nominal methods and
// impl methods): a key's first registration owns it and a later one from
// another module marks it ambiguous. One module lists an impl method both on
// its nominal and on its impl block, which is the same owner. The key column
// is hashed, so a key inserted in any order is a constant-time append.
jet_driver_comptime_owners_build: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex) Never! {
    index.owners_built = true
    loop source_module in graph.modules {
        loop function in source_module.functions {
            jet_driver_comptime_owner_add(index, source_module.module_identity, symbol_table_key(graph.symbols, function.symbol.id))
        }
        loop nominal in source_module.nominals {
            loop function in nominal.methods {
                jet_driver_comptime_owner_add(index, source_module.module_identity, symbol_table_key(graph.symbols, function.symbol.id))
            }
        }
        loop implementation in source_module.impls {
            loop function in implementation.methods {
                jet_driver_comptime_owner_add(index, source_module.module_identity, symbol_table_key(graph.symbols, function.symbol.id))
            }
        }
    }
}

// Records that `module_identity` registers `key` (jet_driver_comptime_owners_build).
jet_driver_comptime_owner_add: fn(index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, key: String) Never! {
    id: Int{module_identity.id}
    if name_column_value(index.owner_keys, index.owners, key) == .Val(owner) {
        if owner >= 0 && owner != id -> name_column_set(index.owner_keys, index.owners, key, -1)
        return
    }
    name_column_set(index.owner_keys, index.owners, key, id)
}

// The one module that registers `function_key`, or None when no module or
// more than one does (the owner column is built: jet_driver_comptime_owners_build).
jet_driver_comptime_function_owner: fn(index: JetDriverComptimeRunIndex, function_key: String) -> ModuleID? {
    owner: name_column_get(index.owner_keys, index.owners, function_key) ?? return None
    Val(ModuleID{id: U32{owner}})
}

JetDriverComptimeFunctionRef: struct {
    module_identity: ModuleID,
    function_key: String,
}

JetDriverComptimeFunctionClosure: struct {
    functions: [FnBody],
    // A closure walked over settled nodes (jet_driver_comptime_settled_closure)
    // names its bodies by their rows of the run's checked functions instead,
    // in closure order; a batch takes them as `functions`
    // (jet_driver_comptime_closure_bodies).
    rows: [Int]{[Int]{}},
    waiting_dependencies: [String],
    complete: Bool,
    // Each incomplete reachable function's recorded causes (its function key).
    incomplete: [SemaTotalityRow]{[SemaTotalityRow]{}},
    // Why the reachable functions keep the evaluation from running while
    // building: an impure call site (sema_comptime_call_facts_impurity) or a
    // body that can't be baked in (sema_comptime_body_unfoldable), or None.
    impurity: String?{None},
    // The foreign functions the closure reaches, which no check reads as Jet
    // (SemaComptimeFunctionResult.foreign): a call of one stops the run.
    foreign: [SemaCheckedForeignFunction]{[SemaCheckedForeignFunction]{}},
    // A function check of the closure captured a `#run` site the pass has
    // yet to land, and the closure waits on it
    // (jet_driver_comptime_site_waits).
    site_waits: Bool{false},
}

JetDriverComptimeWaitRow: struct {
    key: String,
    name: String,
    module_identity: ModuleID,
    span: Span,
    dependencies: [String],
}

// Queues function `function_key` of `module_identity` once, its node in
// `nodes` beside it in `refs`; the result is its node.
jet_driver_comptime_function_ref_add: fn(index: ^JetDriverComptimeRunIndex, refs: ^[JetDriverComptimeFunctionRef], nodes: ^[Int], queued: ^[Int:Bool], module_identity: ModuleID, function_key: String) -> Int Never! {
    node: jet_driver_comptime_node_id(index, module_identity, function_key)
    if queued.get(node) != None -> return node
    queued[node] = true
    refs.push(JetDriverComptimeFunctionRef{module_identity: module_identity, function_key: function_key})
    nodes.push(node)
    node
}

jet_driver_comptime_wait_add: fn(dependencies: ^[String], key: String) Never! {
    loop previous in dependencies {
        if previous == key {
            return
        }
    }
    dependencies.push(key.copy())
}

// A compile-time body's callees Sema records no call fact for are checked and
// lowered with the item, together with their own callees: the function keys
// its tree names (ir_named_function_keys, which takes in each precise
// operation Sema bound to its core.math function) and the Core functions
// filling the jet_builtins roles its lowering runs (ir_core_role_names).
jet_driver_comptime_named_refs: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, tree: BodyTree, roots: [Int], body: [Int], refs: ^[JetDriverComptimeFunctionRef]) Never! {
    // Function values the body stores or reads out of a constant, Core
    // source functions Sema rewrote a Core call to, and the error
    // conversions its `?` calls are lowered with it, like its callees.
    named: ir_named_function_keys(tree, roots, body, graph.decls, graph.symbols)
    if named.len() > 0 {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
        loop key in named {
            if jet_driver_comptime_function_owner(index, key) == .Val(owner) {
                refs.push(JetDriverComptimeFunctionRef{module_identity: owner, function_key: key})
            }
        }
    }
    if index.value_functions.starts.len() > 0 {
        loop node in tree.nodes {
            if node.kind == .ConstRef(symbol) {
                constant: ir_reach_held_row(index.value_functions, symbol_key(graph.symbols, tree.symbols, symbol))
                if constant < 0 -> next
                if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
                loop position in index.value_functions.starts[constant]..<index.value_functions.ends[constant] {
                    key: index.value_functions.functions[position]
                    if jet_driver_comptime_function_owner(index, key) == .Val(owner) {
                        refs.push(JetDriverComptimeFunctionRef{module_identity: owner, function_key: key})
                    }
                }
            }
        }
    }
    roles: ir_core_role_names(graph.interner, tree, roots, body)
    if roles.len() == 0 {
        return
    }
    if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
    loop filler in sema_core_role_functions(graph, roles) {
        key: symbol_key_text(SymbolKind.Function, module_text(graph.module_table, filler.module_identity), "", filler.name)
        if jet_driver_comptime_function_owner(index, key) == .Val(owner) {
            refs.push(JetDriverComptimeFunctionRef{module_identity: owner, function_key: key})
        }
    }
}

// What each codec target in `tree` calls with no call fact
// (ir_comptime_codec_targets): every Encode or Decode implementation, as the
// target encodes or decodes, that it reaches by owner type, named from
// `module_identity` (sema_comptime_codec_methods), and the Core decode
// helpers a container target is decoded through, the functions that fill
// their jet_builtins roles (ir_codec_decode_roles), queued like the other
// role fillers.
jet_driver_comptime_codec_refs: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, tree: BodyTree, roots: [Int], body: [Int], refs: ^[JetDriverComptimeFunctionRef]) {
    targets: ir_comptime_codec_targets(graph.interner, tree, roots, body)
    if targets.len() == 0 {
        return
    }
    loop target in targets {
        loop method in sema_comptime_codec_methods(graph, target.ty, module_identity, target.encode, target.decode) {
            refs.push(JetDriverComptimeFunctionRef{module_identity: method.module_identity, function_key: method.key})
        }
    }
    if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
    loop filler in sema_core_role_functions(graph, ir_codec_decode_roles()) {
        key: symbol_key_text(SymbolKind.Function, module_text(graph.module_table, filler.module_identity), "", filler.name)
        if jet_driver_comptime_function_owner(index, key) == .Val(owner) {
            refs.push(JetDriverComptimeFunctionRef{module_identity: owner, function_key: key})
        }
    }
}

// The methods lowering calls by owner type for the types the expressions in
// `tree` have, as `roots` and `body` reach them, named from
// `module_identity`; Sema records no call fact for them, so the closure
// queues them like callees and reads their call sites. A Close type's
// `close` (sema_comptime_close_methods) runs for a `close(value)`, a deferred
// close or the drop that ends the value's scope: a close that reaches the
// outside world keeps the value from being computed while building, where its
// effect would be lost. A Display type's `display` and a Printable type's
// `show` (sema_comptime_render_methods), its own or a nested value's, make
// its text in an interpolation or a `print`, so a value computed while
// building renders as it does at run time; a KeyBy type's `key` and a
// written Comparable's `compare` order its Map keys and Set members, so a
// Map built while building keeps the order it has at run time.
jet_driver_comptime_owner_refs: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, tree: BodyTree, roots: [Int], body: [Int], refs: ^[JetDriverComptimeFunctionRef]) Never! {
    ^rendered: [Int:Bool]{}
    loop type_id in ir_comptime_expression_types(tree, roots, body) {
        ty: type_syntax(graph.interner, type_id)
        loop method in sema_comptime_close_methods(graph, ty, module_identity) {
            refs.push(JetDriverComptimeFunctionRef{module_identity: method.module_identity, function_key: method.key})
        }
        loop method in sema_comptime_render_methods(graph, index.render, ty, module_identity, rendered) {
            refs.push(JetDriverComptimeFunctionRef{module_identity: method.module_identity, function_key: method.key})
        }
    }
}

// The functions that `roots` and `body` of `tree` (named from
// `module_identity`) reach with no call fact: the named functions and role
// fillers, codec methods, owner-type methods and bounded trait methods
// lowering calls, in that order, each possibly more than once. The closure
// queues each the first time.
jet_driver_comptime_body_refs: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, tree: BodyTree, roots: [Int], body: [Int]) -> [JetDriverComptimeFunctionRef] {
    ^refs: [JetDriverComptimeFunctionRef]{}
    jet_driver_comptime_named_refs(graph, index, tree, roots, body, refs)
    jet_driver_comptime_codec_refs(graph, index, module_identity, tree, roots, body, refs)
    jet_driver_comptime_owner_refs(graph, index, module_identity, tree, roots, body, refs)
    loop method in sema_comptime_bound_methods(graph, tree, module_identity) {
        refs.push(JetDriverComptimeFunctionRef{module_identity: method.module_identity, function_key: method.key})
    }
    refs
}

// Why checked function `checked` (its body `function`) keeps a module value,
// or with `local_value` a local value, from being computed while building:
// an impure call site, a runtime intrinsic or a body that can't be baked in.
jet_driver_comptime_row_impurity: fn(graph: SemaRegistrationGraph, checked: SemaComptimeFunctionResult, function: FnBody, local_value: Bool) -> String? {
    if sema_comptime_call_facts_impurity(graph, checked.call_facts, local_value) == .Val(reason) {
        return Val(reason)
    }
    // #6777: a runtime intrinsic's checked body is a stand-in (the library
    // build lowers each call as its own operation), so a value computed from
    // it is not the one the program sees: `key: rt_static_text("…")` folded
    // to the stand-in's 0.
    if ir_runtime_intrinsic(function.name) {
        return Val("it calls `{function.name}`, a runtime intrinsic the build lowers as its own operation")
    }
    sema_comptime_body_unfoldable(graph, function, local_value)
}

// The closure row of checked function `checked` (its body `function`), with
// its impurity for a module value (`local_value`: a local value) when the
// closure `asks`, which it does until a row is impure. Row `row` of the
// run's checked functions keeps it for the closures after this one; a row
// of -1 is one the run does not keep.
jet_driver_comptime_closure_row: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, row: Int, checked: SemaComptimeFunctionResult, function: FnBody, asks: Bool, local_value: Bool) -> JetDriverComptimeClosureRow {
    ^found: index.closure_rows.get(row)
    ^changed: found == None
    ^cached: if found == .Val(kept) -> kept else -> JetDriverComptimeClosureRow{refs: jet_driver_comptime_function_refs(graph, index, checked.module_identity, function)}
    if asks && local_value && !cached.local_known {
        cached.local_impurity = jet_driver_comptime_row_impurity(graph, checked, function, true)
        cached.local_known = true
        changed = true
    }
    if asks && !local_value && !cached.module_known {
        cached.module_impurity = jet_driver_comptime_row_impurity(graph, checked, function, false)
        cached.module_known = true
        changed = true
    }
    if changed && row >= 0 -> index.closure_rows[row] = cached.copy()
    cached
}

// The functions checked function `function`'s body and parameter defaults
// reach with no call fact (jet_driver_comptime_body_refs).
jet_driver_comptime_function_refs: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, function: FnBody) -> [JetDriverComptimeFunctionRef] {
    ^defaults: [Int]{}
    loop parameter in function.params {
        if parameter.default == Val(value) -> defaults.push(value)
    }
    jet_driver_comptime_body_refs(graph, index, module_identity, function.tree, defaults, function.body)
}

// The node (JetDriverComptimeClosureNode) of function `function_key` of
// `module_identity`, added unsettled, unchecked and not waiting the first
// time the run names it.
jet_driver_comptime_node_id: fn(index: ^JetDriverComptimeRunIndex, module_identity: ModuleID, function_key: String) -> Int Never! {
    id: sema_comptime_key_set_index(index.node_keys, module_identity, function_key)
    if id < index.nodes.len() -> return id
    index.nodes.push(JetDriverComptimeClosureNode{})
    index.checked_at.push(-1)
    index.waiting_at.push(-1)
    index.prefetched.push([SemaComptimeFunctionResult]{})
    index.prefetched_refs.push([JetDriverComptimeFunctionRef]{})
    index.prefetched_has_refs.push(false)
    index.prefetched_marks.push(-1)
    id
}

// The closure of the functions in `roots` (the item's queue, in order, as
// nodes) when every function it reaches is settled: the nodes walked in the
// order the full walk visits them, which is the order their successors queue
// them, so it gives the same rows, foreign functions, first impurity and
// failure settle. None at the first function that is not settled; the full
// walk (jet_driver_comptime_function_closure) runs then. `impurity`,
// `module_value` and `local_value` are the full walk's.
jet_driver_comptime_settled_closure: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, checked_functions: [SemaComptimeFunctionResult], roots: [Int], module_value: Bool, local_value: Bool, impurity: String?, diagnostics: ^[Diagnostic]) -> JetDriverComptimeFunctionClosure? {
    ^order: [Int]{}
    ^queued: [Int:Bool]{}
    loop root in roots {
        if queued.get(root) != None -> next
        queued[root] = true
        order.push(root)
    }
    ^found: impurity
    ^impure_node: -1
    ^obligations: false
    ^cursor: 0
    loop cursor < order.len() {
        id: order[cursor]
        cursor += 1
        if !index.nodes[id].settled -> return None
        if index.nodes[id].obligations -> obligations = true
        if module_value && found == None && impure_node < 0 && index.nodes[id].row >= 0 {
            if jet_driver_comptime_node_impure(graph, index, checked_functions, id, local_value) {
                impure_node = id
            }
        }
        loop successor in index.nodes[id].successors {
            if queued.get(successor) != None -> next
            queued[successor] = true
            order.push(successor)
        }
    }
    if found == None && impure_node >= 0 {
        found = (if local_value -> index.nodes[impure_node].local_impurity else -> index.nodes[impure_node].module_impurity).copy()
    }
    ^rows: [Int]{}
    ^foreign: [SemaCheckedForeignFunction]{}
    // The failure closure is built only when a function adds obligations:
    // with none, its settle discharges everything.
    ^failure_closure: SemaComptimeFailureClosure{}
    loop id in order {
        row: index.nodes[id].row
        if row >= 0 {
            rows.push(row)
            if obligations {
                sema_comptime_failure_closure_add(graph, failure_closure, checked_functions[row])
            }
            next
        }
        result: index.nodes[id].foreign ?? next
        if result.foreign == .Val(foreign_row) -> foreign.push(foreign_row.copy())
        if obligations -> sema_comptime_failure_closure_add(graph, failure_closure, result)
    }
    complete: !obligations || sema_comptime_failure_closure_settle(graph, failure_closure, diagnostics)
    Val(JetDriverComptimeFunctionClosure{functions: [FnBody]{}, rows: rows, waiting_dependencies: [String]{}, complete: complete, impurity: found, foreign: foreign})
}

// Whether settled node `id` is impure for a module value (`local_value`: a
// local value), caching its row's closure impurity on the node by move once
// asked.
jet_driver_comptime_node_impure: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, checked_functions: [SemaComptimeFunctionResult], id: Int, local_value: Bool) -> Bool {
    if local_value && index.nodes[id].local_known -> return index.nodes[id].local_impurity != None
    if !local_value && index.nodes[id].module_known {
        return index.nodes[id].module_impurity != None
    }
    row: index.nodes[id].row
    function: checked_functions[row].function ?? return false
    closure_row: jet_driver_comptime_closure_row(graph, index, row, checked_functions[row], function, true, local_value)
    if local_value {
        index.nodes[id].local_known = true
        index.nodes[id].local_impurity = closure_row.local_impurity
        return index.nodes[id].local_impurity != None
    }
    index.nodes[id].module_known = true
    index.nodes[id].module_impurity = closure_row.module_impurity
    index.nodes[id].module_impurity != None
}

// `environment` is the run's sema_comptime_environment, `program` its tables
// (sema_comptime_program) and `available` its constant keys: every function
// check re-targets the environment instead of copying the graph per function.
// A function the run already checked completely is reused from
// `checked_functions`, and one whose last check waits on constants that still
// have no value from `index` (JetDriverComptimeRunIndex.waiting_at). The
// queue is walked breadth first, and each level's functions are checked
// ahead on the compiler threads when they admit more than one
// (jet_driver_comptime_closure_prefetch).
// Function sources and module rows are read from `program`'s graph, whose
// staged values never change them. `memory_plan`
// holds the run's memory plan once a function is checked (zero or one row):
// it reads only function declarations, which staged values never change, so
// every on-demand function check of the run shares the one built at the first.
// `program` is read-only here, so its graph is borrowed in place: a writable
// `^program` turned the graph binding below into a whole-graph copy per call.
jet_driver_comptime_merge_item_delta: fn(program: ^SemaProgramTables, checked: ^SemaComptimeItemCheck) Never! {
    if checked.type_delta.len() == 0 {
        return
    }
    graph: program.registration_graph.in_place()
    ^delta: checked.type_delta.pop() ?? return
    remap: interner_merge_delta(graph.interner, delta)
    if checked.request.in_place() == .Val(req) -> sema_remap_comptime_item_request(req, remap)
}

jet_driver_comptime_merge_fn_delta: fn(program: ^SemaProgramTables, checked: ^SemaComptimeFunctionResult) Never! {
    if checked.type_delta.len() == 0 {
        return
    }
    graph: program.registration_graph.in_place()
    ^delta: checked.type_delta.pop() ?? return
    remap: interner_merge_delta(graph.interner, delta)
    if checked.function.in_place() == .Val(func) -> body_tree_remap_types(func.tree, remap)
    loop idx in 0..<checked.conversions.len() {
        body_tree_remap_types(checked.conversions[idx].tree, remap)
    }
    sema_remap_comptime_requests_from(checked.calls, 0, remap)
}

jet_driver_comptime_check_fn_with_program: fn(
    environment: ^SemaScopeEnvironment,
    program: SemaProgramTables,
    comptime_scopes: ^SemaComptimeScopes,
    available: SemaComptimeAvailableConstants,
    memory_plan: SemaFunctionMemoryPlan,
    values: [SemaComptimeItemValue],
    module_identity: ModuleID,
    function_key: String,
) -> SemaComptimeFunctionResult {
    graph: program.registration_graph
    sema_check_comptime_function(graph, environment, program, comptime_scopes, available, memory_plan, values, module_identity, function_key)
}

jet_driver_comptime_memory_plan_ensure: fn(program: SemaProgramTables, threads: CompilerThreads, memory_plan: ^[SemaFunctionMemoryPlan]) Never! {
    if memory_plan.len() == 0 {
        graph: program.registration_graph
        memory_plan.push(sema_function_memory_plan_from_graph(graph, threads))
    }
}

jet_driver_comptime_closure_seed: fn(
    program: SemaProgramTables,
    index: ^JetDriverComptimeRunIndex,
    checked_functions: [SemaComptimeFunctionResult],
    request: SemaComptimeItemRequest,
    module_value: Bool,
    local_value: Bool,
    queue: ^[JetDriverComptimeFunctionRef],
    queue_nodes: ^[Int],
    queued: ^[Int:Bool],
    diagnostics: ^[Diagnostic],
) -> {ok: Bool, impurity: String?, settled: JetDriverComptimeFunctionClosure?} {
    graph: program.registration_graph
    loop call in request.calls {
        ^_: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, call.module_identity, call.callee_key)
    }
    loop function_key in request.reachable_function_keys {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
        ^module_identity: jet_driver_comptime_function_owner(index, function_key)
        if module_identity == None {
            diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
            return {ok: false, impurity: None, settled: Val(JetDriverComptimeFunctionClosure{functions: [FnBody]{}, waiting_dependencies: [String]{}, complete: false})}
        }
        owner_identity: module_identity ?? return {ok: false, impurity: None, settled: Val(JetDriverComptimeFunctionClosure{functions: [FnBody]{}, waiting_dependencies: [String]{}, complete: false})}
        ^_: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, owner_identity, function_key)
    }
    loop found in jet_driver_comptime_body_refs(graph, index, request.module_identity, request.expression.tree, [Int]{request.expression.root}, [Int]{}) {
        ^_: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, found.module_identity, found.function_key)
    }
    ^impurity: if local_value && sema_comptime_tree_reads_phase(request.expression.tree) -> Val("it reads `#phase`, the phase of the copy that runs it") else if module_value && sema_comptime_tree_reads_context(request.expression.tree) -> Val("it reads `context`, the task context of the code that runs it") else -> String?{None}
    if local_value && impurity == None {
        if sema_comptime_tree_module_state(graph, request.expression.tree) == .Val(state) {
            impurity = Val("it reads module state `{state}`, which the running program can change")
        }
    }
    if jet_driver_comptime_settled_closure(graph, index, checked_functions, queue_nodes, module_value, local_value, impurity, diagnostics) == .Val(settled) {
        return {ok: true, impurity: impurity, settled: Val(settled)}
    }
    {ok: true, impurity: impurity, settled: None}
}

jet_driver_comptime_function_closure: fn(
    environment: ^SemaScopeEnvironment,
    program: ^SemaProgramTables,
    comptime_scopes: ^SemaComptimeScopes,
    available: SemaComptimeAvailableConstants,
    index: ^JetDriverComptimeRunIndex,
    memory_plan: ^[SemaFunctionMemoryPlan],
    values: [SemaComptimeItemValue],
    checked_functions: ^[SemaComptimeFunctionResult],
    request: SemaComptimeItemRequest,
    // A module value's closure also records why it is impure, if it is: an
    // impure call, a runtime intrinsic (ir_runtime_intrinsic), or a body that
    // takes a raw address or makes a pointer (sema_comptime_body_unfoldable).
    module_value: Bool,
    // A local value's closure also refuses `#Unsafe` code: it falls back to
    // run time quietly, where a refused module value fails the build.
    local_value: Bool,
    diagnostics: ^[Diagnostic],
    // Each breadth-first level of the queue is checked ahead on these
    // (jet_driver_comptime_closure_prefetch).
    threads: CompilerThreads,
) -> JetDriverComptimeFunctionClosure {
    // Each function enters the queue once, so the queue is also the set of
    // functions processed; `queue_nodes` holds their nodes beside them.
    ^queue: [JetDriverComptimeFunctionRef]{}
    ^queue_nodes: [Int]{}
    ^queued: [Int:Bool]{}
    ^seeded: jet_driver_comptime_closure_seed(program, index, checked_functions, request, module_value, local_value, queue, queue_nodes, queued, diagnostics)
    if seeded.settled == .Val(settled) -> return settled
    if !seeded.ok {
        return JetDriverComptimeFunctionClosure{functions: [FnBody]{}, waiting_dependencies: [String]{}, complete: false, incomplete: [SemaTotalityRow]{SemaTotalityRow{owner: environment.module_name.copy(), function: "-", reason: "the staged comptime environment lost its registration graph"}}}
    }
    ^functions: [FnBody]{}
    ^foreign: [SemaCheckedForeignFunction]{}
    ^waiting: [String]{}
    ^site_waits: false
    ^complete: true
    ^incomplete: [SemaTotalityRow]{}
    ^impurity: seeded.impurity
    // #3708: obligations against unannotated callees settle over the closure.
    ^failure_closure: SemaComptimeFailureClosure{}
    ^cursor: 0
    // The queue's end when the current level began: the functions queued
    // since are the next level.
    ^level_end: 0
    loop cursor < queue.len() {
        if cursor == level_end {
            level_end = queue.len()
            jet_driver_comptime_closure_prefetch(environment, program, available, index, memory_plan, values, comptime_scopes.host_hooks, queue, queue_nodes, cursor, level_end, threads)
        }
        ^current: queue[cursor]
        // The visit settles the function's node when it is the same in
        // every closure (JetDriverComptimeClosureNode).
        node: queue_nodes[cursor]
        cursor += 1
        // A settled foreign function's check reads only the graph: its
        // result stands for a fresh one (an asm body's check reads its
        // module's text), ahead of any older waiting row.
        settled_foreign: index.nodes[node].settled && index.nodes[node].foreign != None
        ^successors: [Int]{}
        obligation_mark: failure_closure.obligations.len()
        ^reused_row: -1
        checked_row: index.checked_at[node]
        if !settled_foreign && checked_row >= 0 {
            if checked_functions[checked_row].complete || checked_functions[checked_row].obligations_pending {
                reused_row = checked_row
            }
        }
        ^waiting_row: -1
        waited_row: index.waiting_at[node]
        if !settled_foreign && reused_row < 0 && waited_row >= 0 {
            if !jet_driver_comptime_any_available(available, index.waiting_functions[waited_row].waiting_dependencies) {
                waiting_row = waited_row
            }
        }
        fresh: !settled_foreign && reused_row < 0 && waiting_row < 0
        if fresh && memory_plan.len() == 0 {
            jet_driver_comptime_memory_plan_ensure(program, threads, memory_plan)
        }
        ^checked: if {
            // Unreachable stop: `settled_foreign` holds only when this node's
            // `foreign` is not None.
            settled_foreign -> index.nodes[node].foreign ?? panic("a settled foreign closure node lost its check")
            reused_row >= 0 -> checked_functions[reused_row]
            waiting_row >= 0 -> index.waiting_functions[waiting_row]
            else -> jet_driver_comptime_prefetched(index, node, program, values) ?? jet_driver_comptime_check_fn_with_program(environment, program, comptime_scopes, available, memory_plan[0], values, current.module_identity, current.function_key)
        }
        if fresh -> jet_driver_comptime_merge_fn_delta(program, checked)
        graph: program.registration_graph.in_place()
        if fresh && checked.waiting_dependencies.len() > 0 {
            if waited_row >= 0 -> index.waiting_functions[waited_row] = checked.copy() else {
                index.waiting_at[node] = index.waiting_functions.len()
                index.waiting_functions.push(checked.copy())
            }
        }
        if checked.foreign == .Val(row) {
            foreign.push(row.copy())
            // An `#Import(c)`'s failure row (sema_check_comptime_function):
            // its callers' obligations against it settle over the closure.
            sema_comptime_failure_closure_add(graph, failure_closure, checked)
            if checked.waiting_dependencies.len() == 0 && !index.nodes[node].settled {
                index.nodes[node] = JetDriverComptimeClosureNode{settled: true, foreign: Val(checked.move()), obligations: failure_closure.obligations.len() > obligation_mark}
            }
            next
        }
        // A fresh check that captured a `#run` site the pass has yet to land
        // ran before that site's value did, so its body holds no binding for
        // the site's local: the closure waits on the site, and this check is
        // neither kept nor settled, so the function is checked again once
        // the site has landed. The closure's other checks are kept for that
        // next check of the item.
        unlanded: fresh && jet_driver_comptime_site_waits(index, checked, request.key, waiting)
        if unlanded -> site_waits = true
        // A fresh check of a function with no row yet adds its row below,
        // which every later visit reuses.
        ^settles: (reused_row >= 0 || (fresh && index.checked_at[node] < 0)) && checked.waiting_dependencies.len() == 0 && !index.nodes[node].settled && !unlanded
        // A new result is stored once its calls are queued, so it moves in.
        ^store: false
        loop dependency in checked.waiting_dependencies {
            jet_driver_comptime_wait_add(waiting, dependency)
        }
        if {
            !checked.obligations_pending && (!checked.complete || jet_driver_has_errors(checked.diagnostics)) -> {
                if module_value && impurity == None {
                    impurity = sema_comptime_call_facts_impurity(graph, checked.call_facts, local_value)
                }
                // A module value keeps these reports when they refuse it, so
                // each names the file of the function it is in.
                loop diagnostic in checked.diagnostics {
                    diagnostics.push(jet_driver_attach_registration_source_location(diagnostic, graph, current.module_identity))
                }
                if checked.incomplete_reasons.len() == 0 && checked.waiting_dependencies.len() == 0 && !jet_driver_has_errors(checked.diagnostics) {
                    incomplete.push(SemaTotalityRow{owner: module_text(graph.module_table, current.module_identity), function: current.function_key.copy(), reason: "incomplete with no recorded cause"})
                }
                loop reason in checked.incomplete_reasons {
                    incomplete.push(SemaTotalityRow{owner: module_text(graph.module_table, current.module_identity), function: current.function_key.copy(), reason: reason})
                }
                complete = false
                settles = false
            }
            else -> {
                function: checked.function ?? {
                    if module_value && impurity == None {
                        impurity = sema_comptime_call_facts_impurity(graph, checked.call_facts, local_value)
                    }
                    diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a complete comptime function result has no published body", "a comptime function is lowered only from a complete typed function", "publish the checked body from the canonical on-demand Sema result"))
                    complete = false
                    next
                }
                // A reused row's body walks ran at the first closure that
                // read it (JetDriverComptimeClosureRow); a new row is kept
                // at the position it is pushed to below.
                ^kept_row: if reused_row >= 0 -> reused_row else if index.checked_at[node] < 0 && !unlanded -> checked_functions.len() else -> -1
                if kept_row >= 0 && index.closure_rows.get(kept_row) == None {
                    if index.prefetched_has_refs[node] {
                        index.prefetched_has_refs[node] = false
                        index.closure_rows[kept_row] = JetDriverComptimeClosureRow{refs: compiler_take_rows<JetDriverComptimeFunctionRef>(index.prefetched_refs[node])}
                    }
                }
                closure_row: jet_driver_comptime_closure_row(graph, index, kept_row, checked, function, module_value && impurity == None, local_value)
                if module_value && impurity == None {
                    impurity = if local_value -> closure_row.local_impurity else -> closure_row.module_impurity
                }
                loop found in closure_row.refs {
                    successor: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, found.module_identity, found.function_key)
                    if settles -> successors.push(successor)
                }
                functions.push(function)
                functions.extend(checked.conversions)
                sema_comptime_failure_closure_add(graph, failure_closure, checked)
                if index.checked_at[node] < 0 && !unlanded -> store = true
            }
        }
        loop call in checked.calls {
            successor: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, call.module_identity, call.callee_key)
            if settles -> successors.push(successor)
        }
        loop function_key in checked.reachable_function_keys {
            if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
            ^module_identity: jet_driver_comptime_function_owner(index, function_key)
            if {
                module_identity == None -> {
                    diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a nested comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
                    complete = false
                    settles = false
                }
                else -> {
                    owner_identity: module_identity ?? return JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: false, incomplete: incomplete}
                    successor: jet_driver_comptime_function_ref_add(index, queue, queue_nodes, queued, owner_identity, function_key)
                    if settles -> successors.push(successor)
                }
            }
        }
        if store {
            index.checked_at[node] = checked_functions.len()
            checked_functions.push(checked.move())
        }
        if settles {
            index.nodes[node] = JetDriverComptimeClosureNode{settled: true, row: index.checked_at[node], successors: successors, obligations: failure_closure.obligations.len() > obligation_mark}
        }
    }
    // A waiting closure is checked again once its dependencies land; its rows
    // are not all checked yet, so its obligations settle then.
    if waiting.len() == 0 {
        graph: program.registration_graph.in_place()
        if !sema_comptime_failure_closure_settle(graph, failure_closure, diagnostics) {
            complete = false
        }
    }
    JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: complete, incomplete: incomplete, impurity: impurity, foreign: foreign, site_waits: site_waits}
}

// The check jet_driver_comptime_prefetch made of node `node`'s function
// ahead of the pass, taken by the first closure that would check it, with
// the demand the check captured recorded into the run's graph where the
// closure's own check would have recorded it (sema_comptime_replay_demand).
// A check that splices local values is dropped when one of them landed in
// `values` since it was made: the closure checks the function again.
jet_driver_comptime_prefetched: fn(index: ^JetDriverComptimeRunIndex, node: Int, program: SemaProgramTables, values: [SemaComptimeItemValue]) -> SemaComptimeFunctionResult? {
    checked: index.prefetched[node].pop() ?? return None
    mark: index.prefetched_marks[node]
    index.prefetched_marks[node] = -1
    if mark >= 0 {
        loop at in mark..<values.len() {
            loop source in checked.comptime_body_sources {
                if values[at].module_identity == source.module_identity && values[at].key == source.key {
                    return None
                }
            }
        }
    }
    sema_comptime_replay_demand(checked, program)
    Val(checked)
}

// The pass's on-demand function checks, made ahead of its closures on the
// compiler threads as one walk (SemaComptimeWalk) and kept in
// `index.prefetched` for the first closure that would check each
// (jet_driver_comptime_prefetched). The functions are the ones the pass's
// prechecked items reach, queued as their closures queue them: an item's
// calls, reachable keys and body refs, then each kept check's, queued as
// soon as a thread made the check. A function the run already checked,
// holds a waiting check of, or settled is not checked here: the closure
// takes those rows as they are. A check that waits on a constant is dropped
// and not followed; the closure checks it at its turn. One compiler thread
// makes no checks here (jet_driver_comptime_prefetches). `host_hooks` are
// the run's (SemaComptimeScopes.host_hooks): the walk leaves out the
// functions whose checks load from the Core library's check
// (sema_comptime_walk_open). The result is the number of checks kept.
jet_driver_comptime_prefetch: fn(environments: [SemaScopeEnvironment], programs: ^[SemaProgramTables], available: SemaComptimeAvailableConstants, index: ^JetDriverComptimeRunIndex, memory_plan: ^[SemaFunctionMemoryPlan], values: [SemaComptimeItemValue], prechecks: [SemaComptimeItemCheck?], host_hooks: SemaHostHookAccess?, threads: CompilerThreads) -> Int {
    jet_driver_comptime_prefetch_clear(index)
    if !jet_driver_comptime_prefetches(threads) -> return 0
    // A waiting check one of whose waits has landed is made again, as the
    // closure that reaches it would make it (jet_driver_comptime_function_closure),
    // so the walk makes it and follows it.
    loop node in 0..<index.nodes.len() {
        row: index.waiting_at[node]
        if row >= 0 && jet_driver_comptime_any_available(available, index.waiting_functions[row].waiting_dependencies) {
            index.waiting_at[node] = -1
        }
    }
    ^seen: [Int:Bool]{}
    seeds: jet_driver_comptime_prefetch_seeds(programs[0], index, prechecks, seen)
    if seeds.len() == 0 -> return 0
    workers: sema_comptime_walk_admit(threads, programs[0], seeds, grows: true)
    if workers <= 1 -> return 0
    jet_driver_comptime_memory_plan(programs[0], threads, memory_plan)
    ^walk: sema_comptime_walk_open(environments[0], programs[0], available, values, memory_plan[0], host_hooks, workers)
    ^kept: 0
    task.group jet_driver_comptime_prefetch_threads {
        walkers: task sema_comptime_walk_run(walk)
        jet_driver_comptime_walk(environments[0], programs[0], sema_comptime_available_version(available), index, values.len(), walk, seeds, seen, kept, follows: true)
        ^_: compiler_threads_joined(walkers)
    }
    kept
}

// Drops the checks and refs an earlier prefetch of the run kept that no
// closure took, and the functions it left waiting.
jet_driver_comptime_prefetch_clear: fn(index: ^JetDriverComptimeRunIndex) Never! {
    loop node in 0..<index.nodes.len() {
        if index.prefetched[node].len() > 0 {
            index.prefetched[node] = [SemaComptimeFunctionResult]{}
        }
        if index.prefetched_has_refs[node] {
            index.prefetched_refs[node] = [JetDriverComptimeFunctionRef]{}
            index.prefetched_has_refs[node] = false
        }
        index.prefetched_marks[node] = -1
    }
    index.waited_jobs = [SemaComptimeFunctionJob]{}
    index.waited_on = [[String]]{}
}

// Whether `threads` admit the comptime prefetches, so a pass's items are
// prechecked to seed them (sema_comptime_precheck_items).
jet_driver_comptime_prefetches: fn(threads: CompilerThreads) -> Bool {
    compiler_threads_admit(threads, 2, 2, 1, 0, 0) > 1
}

// The run's function memory plan, made once for the run, its walk on as many
// threads as `threads` admits.
jet_driver_comptime_memory_plan: fn(program: SemaProgramTables, threads: CompilerThreads, memory_plan: ^[SemaFunctionMemoryPlan]) {
    if memory_plan.len() == 0 {
        memory_plan.push(sema_function_memory_plan_from_graph(program.registration_graph, threads))
    }
}

// Queues `jobs` on walk `walk` and keeps each check as soon as a thread
// makes it (jet_driver_comptime_prefetch_keep), made while `values` held
// `mark` values; when the walk `follows` its checks, it queues the functions
// each kept check reaches too, and keeps the functions whose checks waited
// (JetDriverComptimeRunIndex.waited_jobs). Closes the walk once every queued
// job is checked.
jet_driver_comptime_walk: fn(environment: SemaScopeEnvironment, program: ^SemaProgramTables, version: Int, index: ^JetDriverComptimeRunIndex, mark: Int, walk: ^SemaComptimeWalk, jobs: [SemaComptimeFunctionJob], seen: ^[Int:Bool], kept: ^Int, follows: Bool) {
    sema_comptime_walk_push(walk, environment, program, version, jobs)
    loop {
        ^done: sema_comptime_walk_take(walk)
        if done.len() == 0 -> break
        reached: jet_driver_comptime_prefetch_keep(program, index, done, mark, seen, kept)
        if follows {
            sema_comptime_walk_push(walk, environment, program, version, reached)
            jet_driver_comptime_prefetch_waited(index, done)
        }
    }
    sema_comptime_walk_close(walk)
}

// Keeps the functions of `done`, which it empties, whose checks waited on a
// constant with no value, with those waits, in the order the walk made them.
jet_driver_comptime_prefetch_waited: fn(index: ^JetDriverComptimeRunIndex, done: ^[SemaComptimeWalkDone]) Never! {
    done.reverse()
    loop {
        row: done.pop() ?? break
        if row.check.waiting_dependencies.len() > 0 {
            index.waited_jobs.push(row.job.move())
            index.waited_on.push(row.check.waiting_dependencies.move())
        }
    }
}

// Whether a function check the pass's prefetch dropped waits on an item
// `batch` holds.
jet_driver_comptime_prefetch_awaits: fn(index: JetDriverComptimeRunIndex, batch: JetDriverComptimeBatch) -> Bool Never! {
    loop waits in index.waited_on {
        if jet_driver_comptime_batch_holds(batch, waits) -> return true
    }
    false
}

// Once a batch the pass took over landed ahead of the pass's items, makes
// again on the compiler threads, following them as the pass's prefetch
// does, the checks that prefetch dropped for waiting on a constant that has
// a value now, and keeps them for the closures
// (jet_driver_comptime_prefetched), `host_hooks` as the pass's prefetch
// takes them. The result is the number of checks kept.
jet_driver_comptime_prefetch_landed: fn(environments: [SemaScopeEnvironment], programs: ^[SemaProgramTables], available: SemaComptimeAvailableConstants, index: ^JetDriverComptimeRunIndex, memory_plan: ^[SemaFunctionMemoryPlan], values: [SemaComptimeItemValue], host_hooks: SemaHostHookAccess?, threads: CompilerThreads) -> Int {
    waited_jobs: compiler_take_rows<SemaComptimeFunctionJob>(index.waited_jobs)
    waited_on: compiler_take_rows<[String]>(index.waited_on)
    ^seen: [Int:Bool]{}
    ^jobs: [SemaComptimeFunctionJob]{}
    loop (at, job) in waited_jobs {
        if jet_driver_comptime_any_available(available, waited_on[at]) {
            jet_driver_comptime_prefetch_add(index, seen, jobs, job.module_identity, job.function_key)
        }
    }
    if jobs.len() == 0 -> return 0
    workers: sema_comptime_walk_admit(threads, programs[0], jobs, grows: true)
    if workers <= 1 -> return 0
    jet_driver_comptime_memory_plan(programs[0], threads, memory_plan)
    ^walk: sema_comptime_walk_open(environments[0], programs[0], available, values, memory_plan[0], host_hooks, workers)
    ^kept: 0
    task.group jet_driver_comptime_prefetch_landed_threads {
        walkers: task sema_comptime_walk_run(walk)
        jet_driver_comptime_walk(environments[0], programs[0], sema_comptime_available_version(available), index, values.len(), walk, jobs, seen, kept, follows: true)
        ^_: compiler_threads_joined(walkers)
    }
    kept
}

// The checks of one breadth-first level of a closure's queue
// (`queue[start..<end]`, its nodes `queue_nodes[start..<end]`,
// jet_driver_comptime_function_closure), made on the compiler threads as a
// walk that follows nothing, just before the closure checks them one at a
// time, and kept in `index.prefetched` as a pass's are
// (jet_driver_comptime_prefetch). A pass's prefetch starts from its items'
// prechecks and does not follow a check that waits on a constant, so a
// closure may still reach levels of functions nobody checked ahead; they
// are checked here. The level's functions the run already checked, holds a
// waiting or prefetched check of, or settled are not checked again, and a
// level that admits one thread is left to the closure. The next level the
// kept checks reach is not checked: the closure queues it as its next level.
// `host_hooks` as the pass's prefetch takes them
// (jet_driver_comptime_prefetch).
jet_driver_comptime_closure_prefetch: fn(environment: SemaScopeEnvironment, program: ^SemaProgramTables, available: SemaComptimeAvailableConstants, index: ^JetDriverComptimeRunIndex, memory_plan: ^[SemaFunctionMemoryPlan], values: [SemaComptimeItemValue], host_hooks: SemaHostHookAccess?, queue: [JetDriverComptimeFunctionRef], queue_nodes: [Int], start: Int, end: Int, threads: CompilerThreads) {
    if end - start < 2 || !jet_driver_comptime_prefetches(threads) {
        return
    }
    ^seen: [Int:Bool]{}
    ^jobs: [SemaComptimeFunctionJob]{}
    loop at in start..<end {
        jet_driver_comptime_prefetch_node(index, seen, jobs, queue_nodes[at], queue[at].module_identity, queue[at].function_key)
    }
    if jobs.len() < 2 {
        return
    }
    workers: sema_comptime_walk_admit(threads, program, jobs, grows: false)
    if workers <= 1 {
        return
    }
    jet_driver_comptime_memory_plan(program, threads, memory_plan)
    ^walk: sema_comptime_walk_open(environment, program, available, values, memory_plan[0], host_hooks, workers)
    ^kept: 0
    task.group jet_driver_comptime_closure_prefetch_threads {
        walkers: task sema_comptime_walk_run(walk)
        jet_driver_comptime_walk(environment, program, sema_comptime_available_version(available), index, values.len(), walk, jobs, seen, kept, follows: false)
        ^_: compiler_threads_joined(walkers)
    }
}

// The functions the complete prechecks of the pass's items reach first, as
// each item's closure queues them (jet_driver_comptime_function_closure).
// An item its precheck folded lands that fold at its turn and has no
// closure, so it seeds nothing: most of a pass's items are folded tables.
jet_driver_comptime_prefetch_seeds: fn(program: SemaProgramTables, index: ^JetDriverComptimeRunIndex, prechecks: [SemaComptimeItemCheck?], seen: ^[Int:Bool]) -> [SemaComptimeFunctionJob] {
    ^jobs: [SemaComptimeFunctionJob]{}
    graph: program.registration_graph
    loop at in 0..<prechecks.len() {
        if prechecks[at] == .Val(check) {
            if !check.complete || check.waiting_dependencies.len() > 0 || check.folded != None {
                next
            }
            if check.request == .Val(request) {
                loop call in request.calls {
                    jet_driver_comptime_prefetch_add(index, seen, jobs, call.module_identity, call.callee_key)
                }
                jet_driver_comptime_prefetch_keys(graph, index, seen, jobs, request.reachable_function_keys)
                loop found in jet_driver_comptime_body_refs(graph, index, request.module_identity, request.expression.tree, [Int]{request.expression.root}, [Int]{}) {
                    jet_driver_comptime_prefetch_add(index, seen, jobs, found.module_identity, found.function_key)
                }
            }
        }
    }
    jobs
}

// Keeps each check the walk's threads made (`done`) that waits on no
// constant, with its body refs when a closure reads them (the closure's
// complete arm), counting it in `kept`. A check that splices local values
// keeps `mark`, the run's value count when it was made, so the closure that
// takes it can tell whether one of them landed since
// (jet_driver_comptime_prefetched). The result is the functions the kept
// checks reach.
jet_driver_comptime_prefetch_keep: fn(program: ^SemaProgramTables, index: ^JetDriverComptimeRunIndex, done: ^[SemaComptimeWalkDone], mark: Int, seen: ^[Int:Bool], kept: ^Int) -> [SemaComptimeFunctionJob] {
    loop pos in 0..<done.len() { jet_driver_comptime_merge_fn_delta(program, done[pos].check) }
    jet_driver_comptime_prefetch_keep_in(program, index, done, mark, seen, kept)
}

jet_driver_comptime_prefetch_keep_in: fn(program: SemaProgramTables, index: ^JetDriverComptimeRunIndex, done: [SemaComptimeWalkDone], mark: Int, seen: ^[Int:Bool], kept: ^Int) -> [SemaComptimeFunctionJob] {
    ^next_jobs: [SemaComptimeFunctionJob]{}
    graph: program.registration_graph
    ^eligible: [Int]{}
    loop (pos, row) in done {
        check: row.check
        if check.waiting_dependencies.len() > 0 -> next
        if check.foreign == None && (check.obligations_pending || (check.complete && !jet_driver_has_errors(check.diagnostics))) && check.function != None {
            eligible.push(pos)
        }
    }
    ^parallel_refs: [[JetDriverComptimeFunctionRef]]{}
    if eligible.len() >= 4 {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
        snapshot: JetDriverComptimeRunIndex{
            owner_keys: index.owner_keys,
            owners: index.owners,
            owners_built: true,
            waiting_functions: [SemaComptimeFunctionResult]{},
            render: index.render,
            value_functions: index.value_functions,
        }
        ways: if eligible.len() >= 32 -> 8 else if eligible.len() >= 12 -> 4 else -> 2
        parallel_refs = jet_driver_comptime_prefetch_refs_parallel(graph, snapshot, done, eligible, ways)
    }
    ^el_cursor: 0
    loop (pos, row) in done {
        check: row.check
        if check.waiting_dependencies.len() > 0 -> next
        node: jet_driver_comptime_node_id(index, row.job.module_identity, row.job.function_key)
        if check.foreign == None && (check.obligations_pending || (check.complete && !jet_driver_has_errors(check.diagnostics))) {
            if check.function == .Val(function) {
                refs: if parallel_refs.len() > 0 -> {
                    found_refs: parallel_refs[el_cursor]
                    el_cursor += 1
                    found_refs
                } else -> jet_driver_comptime_function_refs(graph, index, check.module_identity, function)
                loop found in refs {
                    jet_driver_comptime_prefetch_add(index, seen, next_jobs, found.module_identity, found.function_key)
                }
                index.prefetched_refs[node] = refs
                index.prefetched_has_refs[node] = true
            }
        }
        loop call in check.calls {
            jet_driver_comptime_prefetch_add(index, seen, next_jobs, call.module_identity, call.callee_key)
        }
        jet_driver_comptime_prefetch_keys(graph, index, seen, next_jobs, check.reachable_function_keys)
        if check.comptime_body_sources.len() > 0 -> index.prefetched_marks[node] = mark
        index.prefetched[node] = [SemaComptimeFunctionResult]{check}
        kept += 1
    }
    next_jobs
}

jet_driver_comptime_prefetch_refs_parallel: fn(graph: SemaRegistrationGraph, snapshot: JetDriverComptimeRunIndex, done: [SemaComptimeWalkDone], eligible: [Int], ways: Int) -> [[JetDriverComptimeFunctionRef]] {
    count: eligible.len()
    share: (count + ways - 1) /% ways
    ^ranges: [Int]{0}
    ^at: share
    loop at < count {
        ranges.push(at)
        at += share
    }
    ranges.push(count)
    parts: jet_driver_comptime_prefetch_refs_ranges(graph, snapshot, done, eligible, ranges, 0)
    ^out: [[JetDriverComptimeFunctionRef]]{}
    out.try_reserve(count) ?? ()
    loop part in parts {
        loop refs in part -> out.push(refs)
    }
    out
}

jet_driver_comptime_prefetch_refs_ranges: fn(graph: SemaRegistrationGraph, snapshot: JetDriverComptimeRunIndex, done: [SemaComptimeWalkDone], eligible: [Int], ranges: [Int], at: Int) -> [[[JetDriverComptimeFunctionRef]]] {
    last: ranges.len() - 2
    if at > last -> return [[[JetDriverComptimeFunctionRef]]]{}
    if at == last {
        return [[[JetDriverComptimeFunctionRef]]]{jet_driver_comptime_prefetch_refs_chunk(graph, snapshot, done, eligible, ranges[at], ranges[at + 1])}
    }
    ^out: [[[JetDriverComptimeFunctionRef]]]{}
    task.group jet_driver_comptime_prefetch_refs_group {
        head: task jet_driver_comptime_prefetch_refs_chunk(graph, snapshot, done, eligible, ranges[at], ranges[at + 1])
        rest: jet_driver_comptime_prefetch_refs_ranges(graph, snapshot, done, eligible, ranges, at + 1)
        out.push(compiler_threads_joined(head))
        loop part in rest -> out.push(part)
    }
    out
}

jet_driver_comptime_prefetch_refs_chunk: fn(graph: SemaRegistrationGraph, snapshot: JetDriverComptimeRunIndex, done: [SemaComptimeWalkDone], eligible: [Int], start: Int, end: Int) -> [[JetDriverComptimeFunctionRef]] {
    ^local: snapshot
    ^out: [[JetDriverComptimeFunctionRef]]{}
    out.try_reserve(end - start) ?? ()
    loop k in start..<end {
        check: done[eligible[k]].check
        if check.function == .Val(function) {
            out.push(jet_driver_comptime_function_refs(graph, local, check.module_identity, function))
        } else { out.push([JetDriverComptimeFunctionRef]{}) }
    }
    out
}

// Queues each of `keys` with its one owner, as a closure does; a key with no
// unique owner is the closure's to report.
jet_driver_comptime_prefetch_keys: fn(graph: SemaRegistrationGraph, index: ^JetDriverComptimeRunIndex, seen: ^[Int:Bool], jobs: ^[SemaComptimeFunctionJob], keys: [String]) {
    loop function_key in keys {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, index)
        owner: jet_driver_comptime_function_owner(index, function_key) ?? next
        jet_driver_comptime_prefetch_add(index, seen, jobs, owner, function_key)
    }
}

// Queues function `function_key` of `module_identity` once, unless the run
// already checked it, holds a waiting or prefetched check of it or settled it.
jet_driver_comptime_prefetch_add: fn(index: ^JetDriverComptimeRunIndex, seen: ^[Int:Bool], jobs: ^[SemaComptimeFunctionJob], module_identity: ModuleID, function_key: String) {
    node: jet_driver_comptime_node_id(index, module_identity, function_key)
    jet_driver_comptime_prefetch_node(index, seen, jobs, node, module_identity, function_key)
}

// Queues the function of node `node` (`function_key` of `module_identity`)
// as jet_driver_comptime_prefetch_add does.
jet_driver_comptime_prefetch_node: fn(index: JetDriverComptimeRunIndex, seen: ^[Int:Bool], jobs: ^[SemaComptimeFunctionJob], node: Int, module_identity: ModuleID, function_key: String) {
    if seen.get(node) != None {
        return
    }
    seen[node] = true
    if index.checked_at[node] >= 0 || index.waiting_at[node] >= 0 || index.prefetched[node].len() > 0 || index.nodes[node].settled {
        return
    }
    jobs.push(SemaComptimeFunctionJob{module_identity: module_identity, function_key: function_key})
}

// The run's comptime staging: `program` holds (its one row, once `staged`:
// jet_driver_comptime_stage) the declared IR program every evaluation that
// reaches a declaration builds over and lays values out by, `landed`
// counting the values whose constant rows it took over and `taken` their
// keys, at each key's id in `taken_keys` (jet_driver_comptime_ir_build);
// `declared` the declaration pass's
// modules (moved in, or empty), handed back at the run's end; `sites` the
// value sites of the program's graph, through which landings apply.
JetDriverComptimeStaging: struct {
    staged: Bool,
    program: Shared<[IRProgram]>,
    landed: Int,
    taken_keys: NameTable{name_column_table()},
    taken: [Int]{name_column()},
    declared: [SemaGraphModuleResult],
    sites: SemaComptimeValueSites,
    module_count: Int{0},
    type_count: Int{0},
    impl_count: Int{0},
}

// A comptime item that checked completely and waits for its value: it
// evaluates `request`, whose checked function closure is `function_rows`
// (in closure order) of its batch's functions.
JetDriverComptimeEntry: struct {
    source: SemaComptimeItemSource,
    request: SemaComptimeItemRequest,
    function_rows: [Int],
    // Whether the build computes its constant for the entries after it,
    // which read it by calling its item function (TConstantDef.item_function):
    // its type landed as it joined (jet_driver_comptime_type_land).
    computed: Bool{false},
}

// Checked items evaluated together on one IR build, in order.
JetDriverComptimeBatch: struct {
    entries: [JetDriverComptimeEntry],
    // The union of the entries' checked closures, each function once, in
    // the order the entries first name them; each function's row is its
    // pair of `function_keys` (its module and key).
    functions: [FnBody],
    function_keys: SemaComptimeKeySet{SemaComptimeKeySet{}},
    // The source key of every entry: an item check that waits on one of
    // them reads a value the batch still holds back. `key_computed` holds 1
    // at a computed entry's id in `keys` (JetDriverComptimeEntry.computed),
    // which a later entry may read, and 0 at any other entry's.
    keys: NameTable{name_column_table()},
    key_computed: [Int]{name_column()},
    // Whether no evaluated entry reaches a declaration or has a closure
    // (jet_driver_comptime_entry_bare), so the batch builds with no
    // declaration rows.
    bare: Bool,
    // The union of the entries' reached foreign functions, each once
    // (JetDriverComptimeFunctionClosure.foreign).
    foreign: [SemaCheckedForeignFunction]{[SemaCheckedForeignFunction]{}},
}

// What evaluating a batch did to the run.
JetDriverComptimeFlush: struct {
    // The run's result when an entry ended the run.
    stop: JetDriverComptimeRunResult?,
    // Whether a value landed or a checked-text item passed.
    progressed: Bool,
    // Module values whose evaluation could not complete (the IR builder
    // refused their code, evaluation trapped, failed or ran out of budget),
    // each refused (jet_driver_module_value_refused), reporting nothing here.
    refused: [JetDriverModuleValueRefusal]{[JetDriverModuleValueRefusal]{}},
    // Whether a checked-text item's check refused its literal, reporting
    // here: the run goes on and fails at its end.
    rejected: Bool{false},
}

// Work counters of one comptime run (#4601 scaling gate), written to the
// trace once when the run ends: item checks (rechecks included), IR
// programs built, item functions evaluated, and functions built into those
// programs (closure functions plus item functions).
JetDriverComptimeCounters: struct {
    items_checked: Int,
    programs_built: Int,
    item_functions_evaluated: Int,
    functions_built: Int,
}

jet_driver_comptime_wait_row_find: fn(rows: [JetDriverComptimeWaitRow], key: String) -> JetDriverComptimeWaitRow? {
    loop row in rows {
        if row.key == key -> return Val(row)
    }
    None
}

jet_driver_comptime_wait_cycle_from: fn(key: String, rows: [JetDriverComptimeWaitRow], path: ^[String], finished: ^[String]) -> Bool Never! {
    loop previous in path {
        if previous == key -> return true
    }
    loop previous in finished {
        if previous == key -> return false
    }
    path.push(key.copy())
    ^row: jet_driver_comptime_wait_row_find(rows, key)
    if row != None {
        wait_row: row ?? return false
        loop dependency in wait_row.dependencies {
            if jet_driver_comptime_wait_row_find(rows, dependency) != None && jet_driver_comptime_wait_cycle_from(dependency, rows, path, finished) {
                return true
            }
        }
    }
    // The key pushed above leaves the path for the finished list: each nested
    // call that returns false pops its own key, so this call's key is on top.
    if path.pop() == .Val(done) -> finished.push(done)
    false
}

// The first circle among `rows`' dependencies, as its rows in order from the
// one it closes on, or empty when no row waits on itself.
jet_driver_comptime_dependency_cycle: fn(rows: [JetDriverComptimeWaitRow]) -> [JetDriverComptimeWaitRow] Never! {
    ^path: [String]{}
    ^finished: [String]{}
    ^circle: [JetDriverComptimeWaitRow]{}
    loop row in rows {
        if !jet_driver_comptime_wait_cycle_from(row.key, rows, path, finished) -> next
        // The search stops at the path's last row, on its first dependency
        // already on the path: the row the circle closes on.
        last: jet_driver_comptime_wait_row_find(rows, path[path.len() - 1]) ?? return circle
        ^closing: path.len() - 1
        loop dependency in last.dependencies {
            ^index: 0
            loop index < path.len() && path[index] != dependency -> index += 1
            if index < path.len() {
                closing = index
                break
            }
        }
        loop index in closing..<path.len() {
            member: jet_driver_comptime_wait_row_find(rows, path[index]) ?? return circle
            circle.push(member)
        }
        return circle
    }
    circle
}

// The run's evaluator configuration for one evaluation. An IR evaluation
// reads constants from the build's constant rows, never from globals.
// `compiler` answers its `core.compiler` queries.
jet_driver_comptime_eval_config: fn(original: JetEvalConfig, inputs: ^^JetEvalComptimeInputAdapter?, compiler: JetEvalCompilerQueryHost?) -> JetEvalConfig {
    build_host_adapter: if original.build_host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    JetEvalConfig{
        fuel: original.fuel,
        max_call_depth: original.max_call_depth,
        max_collection_len: original.max_collection_len,
        runtime_execution: false,
        build_host_adapter: build_host_adapter,
        comptime_input_adapter: inputs.move(),
        compiler_query_host: if compiler == .Val(host) -> Val(host.clone_compiler_host()) else -> None,
        host_hooks: original.host_hooks,
        native: original.native,
    }
}

// `driver.prelower.*` and `driver.preassemble.*`: each serial step between
// comptime.validate, lower and assemble is its own span.
jet_driver_trace_step_begin: fn(trace_sink: CompilerTraceSink?, name: String) {
    if trace_sink == .Val(sink) -> sink.begin(name, "", -1, -1)
}

jet_driver_trace_step_end: fn(trace_sink: CompilerTraceSink?, name: String, items: Int) {
    if trace_sink == .Val(sink) -> sink.end(name, items)
}

// Moves the rows of `functions` flagged in `mask` onto `kept` and the others
// onto `rest`, both in order, leaving `functions` empty. Each pop moves one
// row, so no row is ever copied.
jet_driver_partition_checked_functions: fn(functions: ^[FnBody], mask: [Bool], kept: ^[FnBody], rest: ^[FnBody]) Never! {
    ^reversed: [FnBody]{}
    loop functions.len() > 0 {
        ^function: functions.pop() ?? {
            break
        }
        reversed.push(function)
    }
    ^position: 0
    loop reversed.len() > 0 {
        ^function: reversed.pop() ?? {
            break
        }
        if mask[position] -> kept.push(function) else -> rest.push(function)
        position += 1
    }
}

// `graph` is the run environment's graph with every value of `values`
// applied (equal to sema_comptime_graph_with_values of the registration graph
// and `values`), handed on when the run completed so finalization reuses it
// instead of copying the registration graph again; None on every other exit,
// where `partial_graph` holds the run's graph with the values applied so far.
// `trail` records every edit the run made to the graph it was given
// (sema_graph_trail_undo gives that graph back).
// `declared` is the declaration pass's modules the run was given, handed back
// on every exit unchanged (finalization reads their type definitions).
// `graph_facts` holds the run's boxed edges and copy facts on every exit, the
// ones it was given (jet_driver_run_comptime) or computed, so a caller that
// lent them gets them back; a result no run has filled yet holds none.
JetDriverComptimeRunResult: struct {
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
    internal_problem: String?,
    graph: SemaRegistrationGraph?,
    partial_graph: SemaRegistrationGraph?,
    // Set by a run that completed: its owner hands the tables' graph on as
    // `graph` (jet_driver_run_comptime); otherwise as `partial_graph`.
    graph_finished: Bool,
    trail: SemaGraphTrail,
    declared: [SemaGraphModuleResult],
    graph_facts: SemaComptimeGraphFacts,
    carried_staging: [JetDriverComptimeStaging]{[JetDriverComptimeStaging]{}},
}

jet_driver_comptime_run_result: fn(
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
) -> JetDriverComptimeRunResult Never! {
    JetDriverComptimeRunResult{values: values, functions: functions, trace: trace, complete: complete, soft_stop: soft_stop, internal_problem: None, graph: None, partial_graph: None, graph_finished: false, trail: sema_graph_trail_init(), declared: [SemaGraphModuleResult]{}, graph_facts: SemaComptimeGraphFacts{boxed_edges: [U32:[String]]{}, copy_facts: sema_copy_facts_table_empty()}}
}

// The check sema_comptime_precheck_items made of an item ahead of its pass,
// while `typed_from` constants had their types ahead of their values, if it
// is the check the run would make now: none of its dependencies has a value
// in `available`, which counts every value landed so far (a check reads only
// the constants it references, and each referenced constant without a value
// then is a dependency, so one with a value now landed since), and no
// dependency's type has landed since, which leaves it one the batch computes
// (jet_driver_comptime_type_land). Taken once: the caller moves its precheck
// in and leaves it None, so a retried item checks again.
jet_driver_comptime_prechecked: fn(precheck: ^^SemaComptimeItemCheck?, available: SemaComptimeAvailableConstants, batch: JetDriverComptimeBatch, typed_from: Int) -> SemaComptimeItemCheck? {
    ^check: precheck.move() ?? return None
    if jet_driver_comptime_any_available(available, check.dependencies) -> return None
    if available.typed > typed_from {
        loop dependency in check.dependencies {
            if jet_driver_comptime_batch_computed(batch, dependency) -> return None
        }
    }
    Val(check.move())
}

// Applies the values that landed from position `from` on to the run's
// program graph in place, through the graph's value sites `sites`
// (sema_comptime_value_sites), recording each typed row on `trail`, and
// counts them as available. Its trace span is `comptime.apply`.
jet_driver_comptime_apply_landed: fn(environment: ^SemaScopeEnvironment, program: ^SemaProgramTables, available: ^SemaComptimeAvailableConstants, sites: SemaComptimeValueSites, values: [SemaComptimeItemValue], from: Int, trail: ^SemaGraphTrail, trace_sink: CompilerTraceSink?) {
    jet_driver_trace_step_begin(trace_sink, "comptime.apply")
    ^landed: [SemaComptimeItemValue]{}
    ^body_values_changed: false
    loop value_index in from..<values.len() {
        // Graph projection consumes only Constants. Do not duplicate body
        // payloads into a temporary list that it immediately discards.
        if values[value_index].kind == SemaComptimeItemKind.Constant {
            landed.push(values[value_index])
        }
        if values[value_index].kind == SemaComptimeItemKind.BodyExpression {
            body_values_changed = true
        }
    }
    sema_comptime_graph_apply_sites(program.registration_graph, sites, landed, trail)
    sema_comptime_available_constants_add(available, values)
    sema_comptime_environment_publish_body_values(environment, values, from, body_values_changed)
    jet_driver_trace_step_end(trace_sink, "comptime.apply", values.len() - from)
}

// Whether checked item `source` joining a batch is computed there for the
// entries after it (JetDriverComptimeEntry.computed): a constant, not a
// module value, local value or checked text, whose evaluation lands its
// value or reports and ends the run.
jet_driver_comptime_computes: fn(source: SemaComptimeItemSource) -> Bool Never! {
    source.kind == SemaComptimeItemKind.Constant && !source.module_value && !source.local_value && source.checked_text == None
}

// Lands the type of constant `source` (its checked `expression`'s) on the
// run's program graph ahead of its value, as it joins a batch that computes
// it: an item checked after it then types its reads of the constant and,
// waiting only on such constants, joins the same batch
// (jet_driver_comptime_computed_waits), so a dependency chain builds one
// program, not one per level.
jet_driver_comptime_type_land: fn(program: ^SemaProgramTables, available: ^SemaComptimeAvailableConstants, sites: SemaComptimeValueSites, source: SemaComptimeItemSource, expression: BodyExpr, trail: ^SemaGraphTrail) {
    typed: [SemaComptimeItemValue]{jet_driver_comptime_item_value(program.registration_graph.interner, source, TComptimeValue.Unit, expression)}
    sema_comptime_graph_apply_sites(program.registration_graph, sites, typed, trail)
    available.typed += 1
}

// Whether item check `checked` waits only on constants `batch` computes
// (jet_driver_comptime_type_land) and is otherwise complete: its request
// reads them by calling their item functions in the batch's program
// (TConstantDef.item_function), so it joins the batch instead of waiting
// for them to land.
jet_driver_comptime_computed_waits: fn(batch: JetDriverComptimeBatch, checked: SemaComptimeItemCheck) -> Bool Never! {
    if checked.waiting_dependencies.len() == 0 || checked.request == None || !checked.complete || jet_driver_has_errors(checked.diagnostics) {
        return false
    }
    jet_driver_comptime_batch_computes(batch, checked.waiting_dependencies)
}

// The waits of each pending item whose last check, with its closure,
// reported nothing: until one of those keys has a value, checking it again
// gives the same waits (it names no other unvalued constant), so the run
// reuses them instead of checking it once per pass; a dependency chain
// declared in reverse order would otherwise check every waiting item on
// every pass.
JetDriverComptimeSettledWaits: struct {
    items: SemaComptimeKeySet{SemaComptimeKeySet{}},
    // Each item's waits at its pair of `items`; None once they no longer
    // stand.
    waits: [[String]?]{[[String]?]{}},
}

jet_driver_comptime_settled_put: fn(settled: ^JetDriverComptimeSettledWaits, module_identity: ModuleID, key: String, waits: ^^[String]) Never! {
    pair: sema_comptime_key_set_index(settled.items, module_identity, key)
    if pair == settled.waits.len() {
        settled.waits.push(Val(waits.move()))
        return
    }
    settled.waits[pair] = Val(waits.move())
}

jet_driver_comptime_settled_drop: fn(settled: ^JetDriverComptimeSettledWaits, module_identity: ModuleID, key: String) Never! {
    pair: sema_comptime_key_set_pair(settled.items, module_identity, key) ?? return
    settled.waits[pair] = None
}

// Whether `batch` computes the constant `key` (JetDriverComptimeEntry.computed).
jet_driver_comptime_batch_computed: fn(batch: JetDriverComptimeBatch, key: String) -> Bool Never! {
    (name_column_get(batch.keys, batch.key_computed, key) ?? 0) == 1
}

// Whether `batch` computes every constant of `keys`
// (JetDriverComptimeEntry.computed).
jet_driver_comptime_batch_computes: fn(batch: JetDriverComptimeBatch, keys: [String]) -> Bool Never! {
    loop key in keys {
        if !jet_driver_comptime_batch_computed(batch, key) -> return false
    }
    keys.len() > 0
}

// The value sites of the run's program graph, read in place. The run's
// tables own their graph from the start of the run.
jet_driver_comptime_program_sites: fn(program: SemaProgramTables) -> SemaComptimeValueSites {
    sema_comptime_value_sites(program.registration_graph)
}

// The run's available constant keys (sema_comptime_available_constants),
// read from the run's program graph: they come from the constants' AST
// values, which staged values never change, and from `values`.
jet_driver_comptime_program_available: fn(program: SemaProgramTables, values: [SemaComptimeItemValue]) -> SemaComptimeAvailableConstants {
    sema_comptime_available_constants(program.registration_graph, values)
}

// The landed value of item `source`, whose checked expression is
// `expression`; a module `Shared{X}` holder's `value` is its folded payload.
jet_driver_comptime_item_value: fn(interner: Interner, source: SemaComptimeItemSource, value: TComptimeValue, expression: BodyExpr) -> SemaComptimeItemValue Never! {
    SemaComptimeItemValue{
        module_identity: source.module_identity,
        key: source.key,
        destination_key: source.destination_key,
        kind: source.kind,
        value: value,
        ty: body_type(interner, expression.tree, expression.root),
        shared_holder: source.module_value && sema_comptime_shared_payload(expression.tree, expression.root) != None,
        place: source.place,
    }
}

// The interner of the tables' graph (sema_comptime_fold_in).
jet_driver_comptime_item_value_in: fn(program: SemaProgramTables, source: SemaComptimeItemSource, value: TComptimeValue, expression: BodyExpr) -> SemaComptimeItemValue Never! {
    graph: program.registration_graph
    jet_driver_comptime_item_value(graph.interner, source, value, expression)
}

jet_driver_comptime_expr_type_in: fn(program: SemaProgramTables, expression: BodyExpr) -> Type Never! {
    graph: program.registration_graph
    body_type(graph.interner, expression.tree, expression.root)
}

// A module-level `NAME: expr` or `^name: expr` (not `#Persist`) whose value
// is not literal data is a module value. It is computed while building, and
// nothing computes it later: no code runs before `run`, and a mutable
// global's storage starts from it. Effects never run while building: an
// item whose own or closure call sites are impure
// (sema_comptime_call_facts_impurity), or whose closure takes a raw address
// or makes a pointer (sema_comptime_body_unfoldable), is refused untried. So
// is one whose check fails under compile-time execution, whose code the IR
// builder refuses, or whose evaluation traps, fails or spends its budget
// (jet_driver_module_value_refused).

// A module value refused while building, and why.
JetDriverModuleValueRefusal: struct {
    source: SemaComptimeItemSource,
    reason: String,
}

// Why the call sites `call_facts` keep an evaluation from running while
// building, read from the run's graph in place; None when they keep it pure.
// A local value also refuses the calls the runtime answers.
jet_driver_comptime_impurity: fn(program: SemaProgramTables, call_facts: [SemaCallSiteFact], local_value: Bool) -> String? Never! {
    sema_comptime_call_facts_impurity(program.registration_graph, call_facts, local_value)
}

// Why module value or local value item check `checked` can't be computed
// while building, or None when its evaluation may be tried: its compile-time
// check failed or did not complete, or it calls anything impure.
jet_driver_module_value_check_refusal: fn(program: SemaProgramTables, checked: SemaComptimeItemCheck, local_value: Bool) -> String? Never! {
    if jet_driver_first_error_since(checked.diagnostics, 0) == .Val(what) {
        return Val("its compile-time check fails ({what})")
    }
    request: checked.request ?? return Val("its compile-time check did not complete")
    if !checked.complete -> return Val("its compile-time check did not complete")
    jet_driver_comptime_impurity(program, request.call_facts, local_value)
}

// Whether item check `checked` passed whole: complete, with its typed
// request and no error.
jet_driver_comptime_checked_whole: fn(checked: SemaComptimeItemCheck) -> Bool Never! {
    checked.complete && checked.request != None && jet_driver_first_error_since(checked.diagnostics, 0) == None
}

// The `what` of the first error of `diagnostics` from position `start` on.
jet_driver_first_error_since: fn(diagnostics: [Diagnostic], start: Int) -> String? Never! {
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR {
            return Val(diagnostics[index].what.copy())
        }
    }
    None
}

// Why a module value's evaluation `result`, which trapped, failed or ran out
// of budget, gave no value.
jet_driver_module_value_eval_reason: fn(result: JetEvalIRResult) -> String {
    if result.error == .Val(error) -> return "computing it stops ({error.diagnostic.what})"
    if result.value == .Val(value) {
        if value == .Failed(report) && report == .Told(error) && error == .String(text) {
            return "computing it returns an error ({text})"
        }
    }
    "computing it returns an error"
}

// Lands local value `source` (SemaComptimeItemSource.local_value) as run-time
// code for `reason`: its owner body keeps the initializer and reports nothing.
jet_driver_comptime_local_value_runs: fn(values: ^[SemaComptimeItemValue], source: SemaComptimeItemSource, reason: String) Never! {
    values.push(
        SemaComptimeItemValue{
            module_identity: source.module_identity,
            key: source.key,
            destination_key: source.destination_key,
            kind: source.kind,
            value: sema_comptime_local_value_failure(reason),
            ty: source.expected_type ?? Type.Named{name: "Unit"},
            place: source.place,
        },
    )
}

// Why local value evaluation `result` leaves it to run time, or None when it
// produced a value: it printed, ended the program, stopped, ran out of
// steps, failed, or could not run.
jet_driver_comptime_local_value_eval_reason: fn(result: JetEvalIRResult) -> String? {
    if result.stdout.len() > 0 || result.stderr.len() > 0 || result.debug_trace.len() > 0 {
        return Val("it prints text")
    }
    if result.exit_code != None -> return Val("it ends the program")
    if result.internal_problem == .Val(problem) {
        return Val("the compile-time evaluator can't run it ({problem.message})")
    }
    if result.error != None -> return Val(jet_driver_module_value_eval_reason(result))
    value: result.value ?? return Val("computing it gives no value")
    if value == .Failed(_) -> return Val(jet_driver_module_value_eval_reason(result))
    if !result.complete -> return Val("computing it gives no value")
    None
}

// Refuses module value `source` for `reason` (E0643). It is checked again as
// ordinary code, outside compile-time execution: that check's errors are the
// item's real ones and stand in place of E0643, reported once (the
// compile-time attempt's were withdrawn); its warnings only when the
// compile-time attempt's were not `reported` already. Nothing lands, so what
// reads the value waits for good and the run fails at its end.
jet_driver_module_value_refused: fn(
    environment: ^SemaScopeEnvironment,
    program: SemaProgramTables,
    comptime_scopes: ^SemaComptimeScopes,
    available: SemaComptimeAvailableConstants,
    source: SemaComptimeItemSource,
    reported: Bool,
    reason: String,
    diagnostics: ^[Diagnostic],
) {
    ^runtime: source.copy()
    runtime.module_value = false
    runtime.runtime_check = true
    ^checked: sema_check_comptime_item(environment, program, comptime_scopes, available, runtime)
    loop diagnostic in checked.diagnostics {
        if reported && diagnostic.severity != DIAGNOSTIC_ERROR -> next
        diagnostics.push(jet_driver_attach_program_source_location(diagnostic, program, source.module_identity))
    }
    if jet_driver_has_errors(checked.diagnostics) {
        return
    }
    diagnostics.push(jet_driver_diagnostic_at_program_site(program, source.module_identity, "E0643", source.span, "`{source.name}` can't be computed while building: {reason}", "a module-level `name: value` is computed while building and stored in the program, the same value on every tier; no code runs before `run: fn`, so a value that stops, reaches the outside world, or can't run while building is a build error", "compute it in `run` and pass it on; or make it a function, marked `#Memo` when it is pure so the first result is kept; or, for outside data, read a pinned build input such as `#run {{ embed_file(\"config.txt\") }}`"))
}

// Refuses each of `refusals` (jet_driver_module_value_refused), whose
// compile-time checks were reported; false when there were none.
jet_driver_module_values_refused: fn(
    environment: ^SemaScopeEnvironment,
    program: SemaProgramTables,
    comptime_scopes: ^SemaComptimeScopes,
    available: SemaComptimeAvailableConstants,
    refusals: [JetDriverModuleValueRefusal],
    diagnostics: ^[Diagnostic],
) -> Bool {
    loop refusal in refusals {
        jet_driver_module_value_refused(environment, program, comptime_scopes, available, refusal.source, true, refusal.reason, diagnostics)
    }
    refusals.len() > 0
}

// Whether an item's check or closure, which ran while a batch held its
// values back, settled: it reported no error (`failed`) and it completed or
// waits on values (`waiting`), so it does not stop. A settled one named no
// batch constant, and then the batch landing first changes nothing, or it
// waits on that constant's key (a constant without a value is a dependency,
// sema_comptime_dependencies_from_references) and is checked again once the
// value lands. Its warnings (a multiline HTML text's, say) are reported
// ahead of the batch's own reports. An unsettled one stops or reports
// errors, which the run does only after the batch's values and reports. A
// local value's check and closure always settle: whatever they report is
// withdrawn, and one that fails or does not complete stays run-time code,
// which no other item reads.
jet_driver_comptime_settled: fn(local_value: Bool, failed: Bool, complete: Bool, waiting: [String]) -> Bool Never! {
    local_value || (!failed && (complete || waiting.len() > 0))
}

// Indexes the `#run` sites the pass starting now has yet to land
// (JetDriverComptimeRunIndex.pass_sites): its items' and those of the batch
// it takes over from the last pass, local values aside. A function check
// that ran before a local value landed keeps the local's initializer as
// run-time code, which the landing replaces (Comptime/LocalSplice.jet), so
// its body stands. One that ran before any other site landed holds no
// binding for the site's local (sema_stmt_check_prepared_binding), and the
// finalization would take that body as the function's
// (sema_comptime_find_checked_function).
jet_driver_comptime_pass_sites: fn(index: ^JetDriverComptimeRunIndex, pending: [SemaComptimeItemSource], batch: JetDriverComptimeBatch) Never! {
    index.pass_sites = [Int:[String]]{}
    loop source in pending -> jet_driver_comptime_pass_site_add(index, source)
    loop entry in batch.entries -> jet_driver_comptime_pass_site_add(index, entry.source)
}

jet_driver_comptime_pass_site_add: fn(index: ^JetDriverComptimeRunIndex, source: SemaComptimeItemSource) Never! {
    if source.kind != SemaComptimeItemKind.BodyExpression || source.local_value {
        return
    }
    ^keys: index.pass_sites.remove(source.span.start) ?? [String]{}
    jet_driver_comptime_wait_add(keys, source.key)
    index.pass_sites[source.span.start] = keys
}

// Adds to `waiting` the key of each site of the pass
// (JetDriverComptimeRunIndex.pass_sites) other than item `own` that the
// function check `checked` captured with no value
// (SemaComptimeFunctionResult.comptime_body_sources); true when it added
// one. Each captured site is one lookup, by the offset its span starts at.
jet_driver_comptime_site_waits: fn(index: JetDriverComptimeRunIndex, checked: SemaComptimeFunctionResult, own: String, waiting: ^[String]) -> Bool Never! {
    ^found: false
    loop captured in checked.comptime_body_sources {
        if captured.local_value || captured.key == own -> next
        keys: index.pass_sites.get(captured.span.start) ?? next
        loop key in keys {
            if key == captured.key {
                jet_driver_comptime_wait_add(waiting, key)
                found = true
            }
        }
    }
    found
}

// Whether a function check recorded since row `mark` of `checked_functions`
// captured a body site other than a local value with no value: an explicit
// `name: #run value` local or a `#run` expression
// (SemaComptimeFunctionResult.comptime_body_sources).
jet_driver_comptime_holds_run_site: fn(checked_functions: [SemaComptimeFunctionResult], mark: Int) -> Bool Never! {
    loop at in mark..<checked_functions.len() {
        loop captured in checked_functions[at].comptime_body_sources {
            if !captured.local_value -> return true
        }
    }
    false
}

// Moves the values computed ahead (SemaComptimeItemSource.ahead) out of
// `pending` when it holds any other item, keeping the order of each, and
// returns them for the next pass. So they are checked in a pass with no
// other item pending, after the module values they may read have landed
// (the last module batch waits into their pass, and lands ahead of them
// when one of their checks waits on it): their closures' function checks
// then wait on nothing, and the pass's prefetch makes them all on the
// compiler threads. Checked in an earlier pass, a closure that waits on a
// module value is checked again the next pass, one function at a time on
// the lead thread.
jet_driver_comptime_hold_ahead: fn(pending: ^[SemaComptimeItemSource]) -> [SemaComptimeItemSource] Never! {
    ^held: [SemaComptimeItemSource]{}
    if jet_driver_comptime_all_ahead(pending) -> return held
    ^kept: [SemaComptimeItemSource]{}
    pending.reverse()
    loop {
        source: pending.pop() ?? break
        if source.ahead -> held.push(source) else -> kept.push(source)
    }
    pending = kept
    held
}

// Whether every item of `pending` is a value computed ahead.
jet_driver_comptime_all_ahead: fn(pending: [SemaComptimeItemSource]) -> Bool Never! {
    loop source in pending {
        if !source.ahead -> return false
    }
    true
}

// Whether `batch` holds one of the items `keys`.
jet_driver_comptime_batch_holds: fn(batch: JetDriverComptimeBatch, keys: [String]) -> Bool Never! {
    loop key in keys {
        if name_column_get(batch.keys, batch.key_computed, key) != None -> return true
    }
    false
}

// Whether an item of `wait_rows` waits on an item `batch` holds.
jet_driver_comptime_batch_awaited: fn(batch: JetDriverComptimeBatch, wait_rows: [JetDriverComptimeWaitRow]) -> Bool Never! {
    loop row in wait_rows {
        if jet_driver_comptime_batch_holds(batch, row.dependencies) -> return true
    }
    false
}

// Whether one of `keys` has a value now.
jet_driver_comptime_any_available: fn(available: SemaComptimeAvailableConstants, keys: [String]) -> Bool Never! {
    loop key in keys {
        if name_find(available.keys, key) != None -> return true
    }
    false
}

// Whether a checked item whose check and closure settled
// (jet_driver_comptime_settled) and wait on nothing may wait in the batch,
// to be evaluated together with it: a constant, not checked text, whose key a
// later check names in its waits when it reads it; a field default whose
// struct doesn't bake it, whose value no check of the run reads (it lands
// only on the field's shape, sema_checked_shape_defaults) and whose failure
// lands nothing and reports nothing; or a body site, not checked text: a
// local value, an explicit `name: #run value` local or a `#run` expression
// in a body. No other item of the run reads a body site (code that reads a
// `#run` local waits until that local has landed, so it is staged only in
// a later pass, sema_comptime_reads_pending_local; a closure that checks
// the owner body of a site other than a local value waits for that site,
// jet_driver_comptime_site_waits), and the flush keeps each
// entry's own outcome: a local value's value or run-time reason, any other
// site's value or its own report, with the entries after a reported failure
// left unevaluated as one item at a time leaves them. A batch that doesn't
// build is evaluated one entry at a time. Any other item is evaluated at its
// turn, alone: a module value's refusal reports, in the order the run
// reaches it.
jet_driver_comptime_batchable: fn(source: SemaComptimeItemSource) -> Bool Never! {
    if source.kind == SemaComptimeItemKind.FieldDefault -> return !source.baked_default
    if source.kind == SemaComptimeItemKind.BodyExpression -> return source.checked_text == None
    source.kind == SemaComptimeItemKind.Constant && source.checked_text == None
}

jet_driver_comptime_batch_new: fn() -> JetDriverComptimeBatch Never! {
    JetDriverComptimeBatch{entries: [JetDriverComptimeEntry]{}, functions: [FnBody]{}, bare: true}
}

// Appends an item to `batch`, moving the functions of its checked closure
// that the batch does not hold yet out of `functions` (left empty), and
// adding the foreign functions it reaches that the batch does not hold yet.
// `computed`: the build computes the item's constant for the entries after
// it (JetDriverComptimeEntry.computed).
jet_driver_comptime_batch_add: fn(batch: ^JetDriverComptimeBatch, source: SemaComptimeItemSource, request: SemaComptimeItemRequest, functions: ^[FnBody], foreign: ^^[SemaCheckedForeignFunction], computed: Bool) Never! {
    loop row in foreign.move() {
        held: loop previous in batch.foreign {
            if previous.symbol_id == row.symbol_id {
                break true
            }
        } ?? false
        if !held -> batch.foreign.push(row)
    }
    ^reversed: [FnBody]{}
    loop functions.len() > 0 {
        ^function: functions.pop() ?? {
            break
        }
        reversed.push(function)
    }
    ^function_rows: [Int]{}
    loop reversed.len() > 0 {
        ^function: reversed.pop() ?? {
            break
        }
        row: sema_comptime_key_set_index(batch.function_keys, function.module_identity, function.key)
        if row == batch.functions.len() -> batch.functions.push(function)
        function_rows.push(row)
    }
    if !jet_driver_comptime_entry_bare(request, function_rows) -> batch.bare = false
    name_column_set(batch.keys, batch.key_computed, source.key, if computed -> 1 else -> 0)
    batch.entries.push(JetDriverComptimeEntry{source: source, request: request, function_rows: function_rows, computed: computed})
}

// The batch holding only entry `index` of `batch`, with that entry's own
// closure (copied out of the batch's functions).
jet_driver_comptime_batch_single: fn(batch: JetDriverComptimeBatch, index: Int) -> JetDriverComptimeBatch Never! {
    ^single: jet_driver_comptime_batch_new()
    entry: batch.entries[index]
    ^rows: [Int]{}
    loop at in entry.function_rows {
        row: sema_comptime_key_set_index(single.function_keys, batch.functions[at].module_identity, batch.functions[at].key)
        if row == single.functions.len() -> single.functions.push(batch.functions[at])
        rows.push(row)
    }
    if !jet_driver_comptime_entry_bare(entry.request, rows) -> single.bare = false
    single.foreign = batch.foreign.copy()
    name_column_set(single.keys, single.key_computed, entry.source.key, 1)
    ^copied: entry.copy()
    copied.function_rows = rows
    single.entries.push(copied)
    single
}

// Forgets the function checks recorded since `mark`: they ran while a batch
// held values back, and the run checks them again after the batch lands, so
// checked functions keep the order the run gives one item at a time.
jet_driver_comptime_forget_functions: fn(checked_functions: ^[SemaComptimeFunctionResult], index: ^JetDriverComptimeRunIndex, mark: Int) Never! {
    loop checked_functions.len() > mark {
        ^_: checked_functions.pop()
        ^_: index.closure_rows.remove(checked_functions.len())
    }
    loop at in 0..<index.nodes.len() {
        if index.checked_at[at] >= mark -> index.checked_at[at] = -1
        if index.nodes[at].row >= mark -> index.nodes[at] = JetDriverComptimeClosureNode{}
    }
}

// Stages the declared IR program comptime builds over and lays values out
// by, at the run's first flush of a batch that reaches a declaration
// (jet_driver_comptime_staged_flush): over the type, impl and constant rows
// of every module, from the declaration pass's modules when they are the
// graph's whole module set (`staging.declared`, read in place), else from
// every module checked under the values so far, on up to `threads` compiler
// threads. A value that lands later changes only its own constant's row,
// which each build takes over (jet_driver_comptime_ir_build), so one staging
// serves the run.
// `programs` is the run's one-row program tables slot, which the declaration
// checks move into their threads' shared state and back
// (sema_comptime_modules_with_values).
jet_driver_comptime_stage: fn(
    programs: ^[SemaProgramTables],
    values: [SemaComptimeItemValue],
    staging: ^JetDriverComptimeStaging,
    threads: CompilerThreads,
) {
    if staging.staged {
        return
    }
    module_count: programs[0].registration_graph.modules.len()
    if staging.declared.len() > 0 && staging.declared.len() == module_count {
        ^types: 0
        ^impls: 0
        loop checked in staging.declared {
            types += checked.declarations.type_defs.len()
            impls += checked.declarations.impls.len()
        }
        ^declared: jet_driver_comptime_declared(staging.declared)
        staging.program = Shared{[IRProgram]{declared.move()}}
        staging.module_count = module_count
        staging.type_count = types
        staging.impl_count = impls
        staging.staged = true
        return
    }
    modules: sema_comptime_modules_with_values(programs, values, threads)
    ^types: 0
    ^impls: 0
    loop checked in modules {
        types += checked.declarations.type_defs.len()
        impls += checked.declarations.impls.len()
    }
    ^declared: jet_driver_comptime_declared(modules)
    staging.program = Shared{[IRProgram]{declared.move()}}
    staging.module_count = modules.len()
    staging.type_count = types
    staging.impl_count = impls
    staging.staged = true
}

// Moves every module of `from` onto the end of `to`, in order (popped, so no
// module is copied).
jet_driver_comptime_take_modules: fn(to: ^[SemaGraphModuleResult], from: ^[SemaGraphModuleResult]) Never! {
    ^reversed: [SemaGraphModuleResult]{}
    loop from.len() > 0 {
        ^row: from.pop() ?? {
            break
        }
        reversed.push(row)
    }
    loop reversed.len() > 0 {
        ^row: reversed.pop() ?? {
            break
        }
        to.push(row)
    }
}

// Stages the run's declared program (jet_driver_comptime_stage) for a batch
// that reaches a declaration, then flushes the batch
// (jet_driver_comptime_flush) over the program tables of the run's one-row
// slot `programs`. Staging once, at the first such batch, serves every
// entry: an entry's check and closure name only constants that landed
// before the batch (naming a batch constant makes a check wait on it), and
// rows of constants an item does not name never change its value.
jet_driver_comptime_staged_flush: fn(
    request: JetDriverCompileRequest,
    batch: JetDriverComptimeBatch,
    values: ^[SemaComptimeItemValue],
    checked_functions: [SemaComptimeFunctionResult],
    trace: ^JetDriverCompileTrace,
    programs: ^[SemaProgramTables],
    staging: ^JetDriverComptimeStaging,
    counters: ^JetDriverComptimeCounters,
    diagnostics: ^[Diagnostic],
) -> JetDriverComptimeFlush {
    if batch.entries.len() > 0 && !batch.bare {
        if request.trace_sink == .Val(sink) {
            sink.begin_item("comptime.stage", batch.entries[0].source.source_file, batch.entries[0].source.name)
        }
        jet_driver_comptime_stage(programs, values, staging, request.compiler_threads)
        if request.trace_sink == .Val(sink) -> sink.end("comptime.stage", 1)
    }
    jet_driver_comptime_flush(request, batch, values, checked_functions, trace, programs[0], staging, counters, diagnostics)
}

// Evaluates the entries of `batch` in order, exactly as the run would one
// item at a time: the entries are built into one IR program
// (jet_driver_comptime_ir_build), on which each runs its own item function.
// A batch holds several entries only when each passed
// jet_driver_comptime_batchable; when their IR does not build, each entry is
// built and evaluated on its own, so a build failure is reported against its
// own item. A batch that reaches a declaration builds over the run's staged
// declared program (jet_driver_comptime_staged_flush). The registration rows
// a flush reads (module rows, identities) are
// read from `program`'s graph, whose staged values never change them.
// `program` is read-only, so that graph is borrowed in place, never copied
// per flush.
jet_driver_comptime_flush: fn(
    request: JetDriverCompileRequest,
    batch: JetDriverComptimeBatch,
    values: ^[SemaComptimeItemValue],
    checked_functions: [SemaComptimeFunctionResult],
    trace: ^JetDriverCompileTrace,
    program: SemaProgramTables,
    staging: ^JetDriverComptimeStaging,
    counters: ^JetDriverComptimeCounters,
    diagnostics: ^[Diagnostic],
) -> JetDriverComptimeFlush {
    graph: program.registration_graph
    ^flushed: JetDriverComptimeFlush{stop: None, progressed: false}
    if batch.entries.len() == 0 -> return flushed
    if request.trace_sink == .Val(sink) {
        sink.begin_item("comptime.build", batch.entries[0].source.source_file, jet_driver_comptime_batch_names(batch))
    }
    ^built: jet_driver_comptime_ir_build(batch, staging, values, graph.decls, graph.symbols, graph.interner, graph.module_table, request.compiler_threads)
    if request.trace_sink == .Val(sink) {
        sink.end("comptime.build", batch.functions.len() + built.items.len())
    }
    counters.programs_built += 1
    counters.functions_built += batch.functions.len() + built.items.len()
    if built.build_failures.len() > 0 {
        if batch.entries.len() > 1 {
            loop index in 0..<batch.entries.len() {
                ^single: jet_driver_comptime_flush(request, jet_driver_comptime_batch_single(batch, index), values, checked_functions, trace, program, staging, counters, diagnostics)
                if single.progressed -> flushed.progressed = true
                loop refusal in single.refused -> flushed.refused.push(refusal)
                if single.rejected -> flushed.rejected = true
                if single.stop == .Val(stopped) {
                    flushed.stop = Val(stopped)
                    return flushed
                }
            }
            return flushed
        }
        item_name: batch.entries[0].source.name
        // A local value the IR builder refuses stays run-time code.
        if batch.entries[0].source.local_value {
            jet_driver_comptime_local_value_runs(values, batch.entries[0].source, "the compile-time evaluator can't run its code ({built.build_failures[0]})")
            flushed.progressed = true
            return flushed
        }
        // A module value the IR builder refuses can't be computed while
        // building.
        if batch.entries[0].source.module_value {
            flushed.refused.push(JetDriverModuleValueRefusal{source: batch.entries[0].source, reason: "the compile-time evaluator can't run its code ({built.build_failures[0]})"})
            return flushed
        }
        // AGENTS.md I2: checked code the IR builder refuses is a compiler
        // fault, one ICE row per refused function of the item's closure.
        ^census: [JetDriverIceRow]{}
        loop line in built.build_failures {
            at: line.find("]: ")
            if at < 0 {
                jet_driver_ice_record(census, item_name, "comptime.build", "unlowered", line)
                next
            }
            // `find` counts bytes, so the name and reason are cut from the bytes.
            bytes: line.bytes()
            jet_driver_ice_record(census, foundation_byte_text(bytes, 0, at + 1), "comptime.build", "unlowered", foundation_byte_text(bytes, at + 3, bytes.len()))
        }
        ^stopped: jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
        stopped.internal_problem = Val("the comptime evaluator can't build `{item_name}`: {jet_driver_ice_text(census)}")
        flushed.stop = Val(stopped.move())
        return flushed
    }
    if request.trace_sink == .Val(sink) {
        sink.begin_item("comptime.load", batch.entries[0].source.source_file, jet_driver_comptime_batch_names(batch))
    }
    ^native: jet_eval_native_load(built, jet_driver_comptime_eval_config(request.eval_config, None, None), threads: request.compiler_threads)
    compiler_queries: jet_driver_comptime_compiler_for(request)
    if request.trace_sink == .Val(sink) -> sink.end("comptime.load", 1)
    loop item in 0..<batch.entries.len() {
        entry: batch.entries[item]
        counters.item_functions_evaluated += 1
        source: entry.source
        comptime_request: entry.request
        if request.trace_sink == .Val(sink) {
            sink.begin_item("comptime.eval", source.source_file, source.name)
        }
        ^item_config: jet_driver_comptime_eval_config(request.eval_config, jet_driver_comptime_inputs_for(request, source.source_file), Val(compiler_queries))
        item_config.impure = source.impure
        item_config.host_held = jet_driver_comptime_host_module(graph, source.module_identity)
        if source.step_limit == .Val(steps) -> item_config.fuel = steps
        item_config.effect_call = comptime_request.effect_call
        eval_result: jet_eval_native_run(native, item, [TComptimeValue]{}, item_config, comptime_request.span)
        if request.trace_sink == .Val(sink) -> sink.end("comptime.eval", 1)
        // A signal from outside jet that ended the child stops the build
        // whatever the item is: the code never finished, so no fold below may
        // turn the item into run-time code, a refused value or a dropped one.
        if eval_result.error == .Val(eval_error) && eval_error.diagnostic.outside_signal != None {
            diagnostics.push(jet_driver_attach_registration_source_location(eval_error.diagnostic, graph, comptime_request.module_identity))
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        // A local value whose evaluation prints, ends the program, stops or
        // fails stays run-time code: its output never joins the build's.
        if source.local_value {
            if jet_driver_comptime_local_value_eval_reason(eval_result) == .Val(reason) {
                jet_driver_comptime_local_value_runs(values, source, reason)
                flushed.progressed = true
                next
            }
        }
        jet_driver_record_eval_result(trace, eval_result)
        if source.kind == SemaComptimeItemKind.FieldDefault && eval_result.error != None && eval_result.internal_problem == None {
            // Only a struct that bakes its defaults needs the value (E2414).
            if source.baked_default {
                ^name_parts: source.name.split(".").to_list()
                field_name: name_parts.pop() ?? source.name
                diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E2414", source.span, "`{field_name}`'s `{{…}}` default must be a compile-time constant", "a decode default is baked into the program, so its value has to be known at compile time; this expression can only be computed at runtime", "use a literal or a `#run`-evaluable expression — e.g. `port: Int{{8080}}` or `ports: [Int]{{[80, 443]}}`"))
            }
            next
        }
        // A module value whose evaluation traps, fails or runs out of budget
        // can't be computed while building, and nothing computes it later:
        // it is refused (jet_driver_module_value_refused).
        failed_value: if eval_result.value == .Val(evaluated_value) -> evaluated_value == .Failed(_) else -> false
        if source.module_value && eval_result.internal_problem == None && (eval_result.error != None || failed_value) {
            flushed.refused.push(JetDriverModuleValueRefusal{source: source.copy(), reason: jet_driver_module_value_eval_reason(eval_result)})
            next
        }
        if eval_result.error != None || eval_result.internal_problem != None {
            if eval_result.error == .Val(eval_error) {
                diagnostics.push(jet_driver_attach_registration_source_location(eval_error.diagnostic, graph, comptime_request.module_identity))
            }
            if graph.keep_going {
                if eval_result.internal_problem == .Val(problem) {
                    diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "keep-going: the native comptime run failed internally: {problem.message}", "JET_KEEP_GOING drops the item and runs the rest", "fix the comptime run defect"))
                }
                next
            }
            // A comptime run's internal problem is a compiler defect with its
            // own exact message; it leaves as the run's internal problem.
            ^failed: jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            if eval_result.internal_problem == .Val(problem) {
                failed.internal_problem = Val("the native comptime run failed internally: {problem.message}")
            }
            flushed.stop = Val(failed)
            return flushed
        }
        if !eval_result.complete {
            diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "the native comptime run returned neither a value nor an explicit control result", "only complete values and canonical soft-stop control may leave evaluation", "return the evaluator's exact error or completed result"))
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        value: eval_result.value ?? {
            diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "a complete comptime evaluation returned no value", "a staged value is recorded only after successful evaluation", "preserve the completed comptime value"))
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        if source.kind == SemaComptimeItemKind.CheckedText {
            if value == .Failed(report) {
                evaluation: source.checked_text ?? {
                    diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "a checked-text validation item lost its exact method request", "CheckedText literals evaluate their registered pure checker on the fully encoded body", "preserve the checked-text request through staged evaluation"))
                    flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
                    return flushed
                }
                diagnostics.extend(loop diagnostic in sema_checked_text_reports(graph, source.module_identity, evaluation.ty, evaluation.source_expression, report, evaluation.span, evaluation.code, evaluation.what, evaluation.fix) -> jet_driver_attach_registration_source_location(diagnostic, graph, source.module_identity))
                // The run goes on, so every refused literal reports; it
                // fails at its end (refused_any).
                flushed.rejected = true
                next
            }
            flushed.progressed = true
            next
        }
        if jet_driver_comptime_discriminant_range(program, source, value) == .Val(refusal) {
            diagnostics.push(refusal)
            if graph.keep_going -> next
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        values.push(jet_driver_comptime_item_value(graph.interner, source, value, comptime_request.expression))
        flushed.progressed = true
    }
    flushed
}

// An enum case number is a signed 64-bit word of its type's layout, so an
// exact Int computed past that range (a BigInt) is E0035 at the number.
jet_driver_comptime_discriminant_range: fn(program: SemaProgramTables, source: SemaComptimeItemSource, value: TComptimeValue) -> Diagnostic? {
    if source.kind != SemaComptimeItemKind.TypeLevel -> return None
    if value == .BigInt(_) {
        return Val(jet_driver_diagnostic_at_program_site(program, source.module_identity, "E0035", source.span, "an enum discriminant is outside the signed integer range", "the enum number is stored as a signed 64-bit integer in the type layout", "use a number from -9223372036854775808 to 9223372036854775807"))
    }
    None
}

// The names of `batch`'s entries, the label of its build's trace span
// (Tools/Perf/ComptimeItems.mjs splits it).
jet_driver_comptime_batch_names: fn(batch: JetDriverComptimeBatch) -> String Never! {
    ^names: [String]{}
    loop entry in batch.entries -> names.push(entry.source.name)
    names.join(", ")
}

// `known` holds the module and key of every source already pending or staged.
jet_driver_comptime_checked_text_source_add: fn(sources: ^[SemaComptimeItemSource], known: ^SemaComptimeKeySet, evaluation: SemaCheckedTextEvaluation) -> Bool Never! {
    ^source: sema_comptime_checked_text_source(evaluation)
    if !sema_comptime_key_set_add(known, source.module_identity, source.key) -> return false
    sources.push(source)
    true
}

// Each function joins the first module with its identity, in place: the
// module is found through one identity map instead of copying every module
// passed while searching, and edited without copying it out and back. An
// incomplete result fails the merge before any module changes, and the
// failure names the staged function and why it could not join. A staged
// Core function whose only errors are failure obligations joins: the body
// pass that settles a staged function's obligations never checks a Core
// body a program reads from the Core image, and the Core library's own
// check, whose solve saw every Core body, already discharged them. The
// caller builds the bundle's name facts afterwards (jet_driver_merged_names).
jet_driver_merge_checked_text_functions: fn(graph: ^SemaGraphResult, table: ModuleTable, functions: [SemaComptimeFunctionResult]) -> String? Never! {
    // Module slots: the first checked row of each module id, -1 for none.
    ^module_rows: (loop _ in 0..<module_count(table) -> -1)
    loop (index, graph_module) in graph.modules {
        slot: module_index(graph_module.module_identity)
        if module_rows[slot] == -1 -> module_rows[slot] = index
    }
    // The key of every function a row holds, under the row's module, read
    // once per row the first time a staged function names it: a staged
    // function its module already holds (checked by the body pass, or
    // staged before it) is skipped.
    ^held: SemaComptimeKeySet{}
    ^keyed: (loop _ in 0..<graph.modules.len() -> false)
    loop checked in functions {
        function: checked.function ?? return Val("staged function `{checked.function_key}` of `{module_text(table, checked.module_identity)}` has no checked body")
        row: module_rows[module_index(checked.module_identity)]
        if row < 0 {
            return Val("staged function `{function.key}` names module `{module_text(table, checked.module_identity)}`, which the checked graph does not hold")
        }
        if !keyed[row] {
            loop existing in graph.modules[row].functions {
                ^_: sema_comptime_key_set_add(held, checked.module_identity, existing.key)
            }
            keyed[row] = true
        }
        if sema_comptime_key_set_has(held, checked.module_identity, function.key) -> next
        if !checked.complete && !(checked.obligations_pending && module_is_core(checked.module_identity)) {
            ^reasons: ""
            loop reason in checked.incomplete_reasons {
                reasons = if reasons == "" -> ": {reason}" else -> "{reasons}; {reason}"
            }
            loop diagnostic in checked.diagnostics {
                reasons = if reasons == "" -> ": {diagnostic.what}" else -> "{reasons}; {diagnostic.what}"
            }
            return Val("staged function `{function.key}` did not finish checking{reasons}")
        }
        if !sema_comptime_append_checked_function_to_module(checked, graph.modules[row]) {
            return Val("staged function `{function.key}` could not join module `{module_text(table, checked.module_identity)}`")
        }
        ^_: sema_comptime_key_set_add(held, checked.module_identity, function.key)
        loop fact in checked.call_facts -> graph.call_facts.push(fact.copy())
        loop request in checked.calls -> graph.comptime_requests.push(request.copy())
    }
    None
}

// The bundle's name facts built over the graph's checked modules on the
// compiler threads (jet_driver_merge_checked_text_functions); the
// registration graph moves in and is returned.
jet_driver_merged_names: fn(graph: ^SemaGraphResult, registration: ^^SemaRegistrationGraph, threads: CompilerThreads) -> SemaRegistrationGraph {
    ^names: sema_name_facts_empty()
    ^returned: sema_name_build_facts_threads(registration, graph.modules, graph.names.structure_facts, threads, names)
    graph.names = names.move()
    returned
}

// Puts the comptime items of Core and of the compiler's canonical Prelude
// ahead of the program's, each group in its own order (the sort is
// stable). The program reads Core's constants and Core never reads the
// program's, so a program item's closure finds the Core constants it
// reaches already landed: otherwise every function of the closure that
// reads one (as the Regex functions read Regex's) waits, and the closure is
// checked again next pass.
jet_driver_comptime_core_first: fn(sources: ^[SemaComptimeItemSource]) {
    prelude: "{JET_CANONICAL_EFFECT_PACKAGE_IDENTITY}/"
    sources.sort_by(fn(left: SemaComptimeItemSource, right: SemaComptimeItemSource) { jet_driver_comptime_item_rank(left, prelude) <=> jet_driver_comptime_item_rank(right, prelude) })
}

// 0 for an item of Core or the canonical Prelude (whose files start with
// `prelude`), 1 for one of the program.
jet_driver_comptime_item_rank: fn(source: SemaComptimeItemSource, prelude: String) -> Int Never! {
    if module_is_core(source.module_identity) || source.source_file.starts_with(prelude) -> 0 else -> 1
}

// `staged` is the graph the run's program tables own (moved in, never
// copied): the declaration pass's graph (SemaComptimeDeclarationStage.graph)
// or the caller's own copy. Every edit the run makes to it is recorded on the
// result's `trail`, and the graph comes back on every exit (`graph` or
// `partial_graph`). The run's staging holds `declared` (read in place), and
// the run hands it back in the result on every exit.
jet_driver_run_comptime: fn(
    staged: ^^SemaRegistrationGraph,
    // The declaration pass's modules of `staged` (jet_driver_comptime_stage), or empty.
    declared: ^^[SemaGraphModuleResult],
    // The boxed edges and copy facts of `staged` with `initial_values`
    // applied, or None: the declaration pass's
    // (SemaComptimeDeclarationStage.graph_facts), with no values, or a
    // finalization's carried ones, whose graph already holds every value.
    graph_facts: ^^SemaComptimeGraphFacts?,
    sources: [SemaComptimeItemSource],
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    request: JetDriverCompileRequest,
    diagnostics: ^[Diagnostic],
    // The run's function memory plan, zero or one row: a caller holding the
    // plan of `staged`'s functions lends it here, and an empty slot gets the
    // one the run builds (jet_driver_comptime_run).
    memory_plan: ^[SemaFunctionMemoryPlan],
) -> JetDriverComptimeRunResult {
    ^carried: [JetDriverComptimeStaging]{}
    jet_driver_run_comptime_carried(staged, declared, graph_facts, sources, initial_values, initial_functions, request, diagnostics, memory_plan, carried)
}

jet_driver_run_comptime_carried: fn(
    staged: ^^SemaRegistrationGraph,
    declared: ^^[SemaGraphModuleResult],
    graph_facts: ^^SemaComptimeGraphFacts?,
    sources: [SemaComptimeItemSource],
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    request: JetDriverCompileRequest,
    diagnostics: ^[Diagnostic],
    memory_plan: ^[SemaFunctionMemoryPlan],
    carried_staging: ^[JetDriverComptimeStaging],
) -> JetDriverComptimeRunResult {
    ^counters: JetDriverComptimeCounters{items_checked: 0, programs_built: 0, item_functions_evaluated: 0, functions_built: 0}
    // Read before the tables take `staged`.
    ^keep_going: staged.keep_going
    // One program-tables value owns the graph carrying the staged values for
    // every item and function check, beside one environment they re-target;
    // the values that landed since the last item are applied to that graph in
    // place rather than rebuilding it per item, and counted into the run's
    // available constant keys.
    ^trail: sema_graph_trail_init()
    ^program: sema_comptime_environment_tables(staged, initial_values, graph_facts)
    environment: sema_comptime_environment(program, initial_values, request.trace_sink)
    // The run sets `sites` once it has items to check.
    ^staging: carried_staging.pop() ?? JetDriverComptimeStaging{staged: false, program: Shared{[IRProgram]{}}, landed: 0, declared: [SemaGraphModuleResult]{}, sites: sema_comptime_value_sites_empty()}
    staging.declared = declared.move()
    staging.sites = sema_comptime_value_sites_empty()
    // Each in a one-row slot: a pass's prechecks move them into the threads'
    // shared state and back (moving a borrowed value out would copy the
    // whole graph once per pass).
    ^programs: [SemaProgramTables]{}
    programs.push(program)
    ^environments: [SemaScopeEnvironment]{}
    environments.push(environment)
    ^result: jet_driver_comptime_run(programs, environments, trail, keep_going, sources, initial_values, initial_functions, request, staging, counters, diagnostics, memory_plan)
    result.declared = staging.declared.move()
    staging.declared = [SemaGraphModuleResult]{}
    if result.complete && !result.soft_stop && staging.staged {
        result.carried_staging.push(staging.move())
    }
    if request.trace_sink == .Val(sink) {
        sink.progress("counters.comptime.items_checked", counters.items_checked, -1)
        sink.progress("counters.comptime.programs_built", counters.programs_built, -1)
        sink.progress("counters.comptime.item_functions_evaluated", counters.item_functions_evaluated, -1)
        sink.progress("counters.comptime.functions_built", counters.functions_built, -1)
    }
    // The completed run hands the graph on as `graph`; any other exit hands
    // it back here.
    run_program: compiler_threads_taken(programs)
    if result.graph_finished -> result.graph = Val(run_program.registration_graph.move()) else {
        result.partial_graph = Val(run_program.registration_graph.move())
    }
    result.graph_facts = SemaComptimeGraphFacts{boxed_edges: run_program.boxed_edges.move(), copy_facts: run_program.copy_facts.move()}
    result.trail = trail.move()
    result
}

// Hands the declaration pass's modules back from a run to its stage, whose
// finalization reads their type definitions (sema_finalize_registration_graph).
jet_driver_comptime_return_declared: fn(stage: ^SemaComptimeDeclarationStage, run: ^JetDriverComptimeRunResult) Never! {
    stage.modules = [SemaGraphModuleResult]{}
    jet_driver_comptime_take_modules(stage.modules, run.declared)
}

// `programs` holds the program tables that own the run's graph and
// `environments` the environment they re-target, each the one row of its
// slot, so a pass's prechecks move them into the threads' shared state and
// back (sema_comptime_precheck_items) instead of copying them out of a
// borrow; `trail` records the graph's edits; `keep_going` was read from the
// graph before the tables took it (jet_driver_run_comptime).
jet_driver_comptime_run: fn(
    programs: ^[SemaProgramTables],
    environments: ^[SemaScopeEnvironment],
    trail: ^SemaGraphTrail,
    keep_going: Bool,
    sources: [SemaComptimeItemSource],
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    request: JetDriverCompileRequest,
    staging: ^JetDriverComptimeStaging,
    counters: ^JetDriverComptimeCounters,
    diagnostics: ^[Diagnostic],
    // The memory plan reads only function declarations, which staged values
    // never change, so every on-demand function check shares one (zero or
    // one row): the caller's, or else built by the main thread while a
    // precheck's threads check, or at the run's first function check
    // (jet_driver_comptime_function_closure).
    memory_plan: ^[SemaFunctionMemoryPlan],
) -> JetDriverComptimeRunResult {
    // copy: this run grows its own value list. initial_values is jet_driver_run_comptime's read
    // parameter, which also seeds the comptime environment and stays with the caller.
    ^values: initial_values.copy()
    // copy: this run grows its own checked-function list. initial_functions is
    // jet_driver_run_comptime's read parameter, which stays with the caller.
    ^checked_functions: initial_functions.copy()
    ^trace: jet_driver_empty_compile_trace()
    ^pending: sources
    // The module and key of every source pending or staged in this run.
    ^known_sources: SemaComptimeKeySet{}
    ^accepted_checked_text: SemaComptimeKeySet{}
    ^rejected_checked_text: SemaComptimeKeySet{}
    loop source in sources {
        ^_: sema_comptime_key_set_add(known_sources, source.module_identity, source.key)
    }
    // The module scope every item and function check of the run checks in.
    ^comptime_scopes: sema_comptime_scopes_init(sema_host_hook_access(request.eval_config.host_hooks))
    ^resolved_count: values.len()
    // Constants' AST values, which staged values never change, read in place.
    ^available: jet_driver_comptime_program_available(programs[0], values)
    ^run_index: jet_driver_comptime_run_index(checked_functions, values)
    // A refused module value (jet_driver_module_value_refused) or checked
    // text literal (JetDriverComptimeFlush.rejected) does not stop the run:
    // the other items still check, so every refusal and real error is
    // reported once, and the run fails at its end. `stop_mark` is where
    // the reports after the last refusal start; before one, the run's own
    // reports start where the list stood on entry.
    ^refused_any: false
    ^stop_mark: diagnostics.len()
    // Sema totality (AGENTS.md I2): an item or closure check that stopped
    // with neither a value, a wait set nor a report is one ICE row each; the
    // run goes on, so every such check reports, and stops with them all once
    // nothing more lands (what waits on such an item waits for good).
    ^totality: [JetDriverIceRow]{}
    // Checked functions whose checked-text calls were already queued; the
    // run's checked functions only grow, so each is scanned once.
    ^scanned_functions: 0
    // The declaration rows evaluations lay values out by are staged once, at
    // the first evaluated item that reaches a declaration: a value that
    // lands later changes only its own constant's row, which each build puts
    // first (jet_driver_comptime_stage).
    staging.sites = jet_driver_comptime_program_sites(programs[0])
    // Items whose check and closure settled (jet_driver_comptime_settled)
    // with no waits are checked and, when jet_driver_comptime_batchable
    // admits them, wait in `batch` to be evaluated together on one IR
    // build. A constant's type lands as it joins (jet_driver_comptime_type_land)
    // and the build computes it for the entries after it, so a check that
    // waits only on such constants joins the same batch
    // (jet_driver_comptime_computed_waits). One that waits on any other batch
    // key waits like any item that names an unvalued constant: the pass's
    // last flush lands the batch, and the next pass checks it again. A batch
    // that no waiting item names, in a pass that landed other values, is not
    // flushed at the pass's end: it waits into the next pass
    // (jet_driver_comptime_batch_awaited). So one IR build and one load serve
    // every item of a dependency chain of constants, and the levels a fold
    // unblocks, not one stretch of the declaration order.
    // An item whose check is unsettled lands the batch first and is checked
    // again; one whose closure is unsettled withdraws the closure's reports
    // and function checks, lands the batch and starts over (`retry`). Either
    // way it sees exactly the values it would see one item at a time, and a
    // flush leaves the batch empty, so an item starts over at most once. Any
    // other item flushes the batch before it is evaluated alone. A literal
    // (sema_comptime_fold) or a literal input lands at its turn even with a
    // batch waiting: it reads no batch value, and a later item that names it
    // then reads it landed instead of flushing the batch early. A closure
    // that checked the owner body of a `#run` site the pass has yet to land
    // (in the batch or later in the pass) waits on that site, keeping its
    // other function checks (jet_driver_comptime_site_waits).
    ^batch: jet_driver_comptime_batch_new()
    ^settled_waits: JetDriverComptimeSettledWaits{}
    loop pending.len() > 0 {
        ^next_pending: [SemaComptimeItemSource]{}
        ^wait_rows: [JetDriverComptimeWaitRow]{}
        ^made_progress: false
        // Values computed ahead wait for a pass with no other item pending
        // (jet_driver_comptime_hold_ahead).
        held: jet_driver_comptime_hold_ahead(pending)
        // The values that landed last pass join the graph before the pass
        // (each item's turn applies them first anyway), so the pass's item
        // checks can be made ahead of it on the compiler threads; an item
        // takes its check at its turn when no value it depends on has landed
        // since (jet_driver_comptime_prechecked). Whenever the threads admit
        // the prefetch, the checks are made even for a pass too small to
        // admit threads of its own, since the prefetch walks from them.
        if values.len() > resolved_count {
            jet_driver_comptime_apply_landed(environments[0], programs[0], available, staging.sites, values, resolved_count, trail, request.trace_sink)
            resolved_count = values.len()
        }
        jet_driver_comptime_pass_sites(run_index, pending, batch)
        jet_driver_trace_step_begin(request.trace_sink, "comptime.precheck")
        ^prechecks: sema_comptime_precheck_items(environments, programs, available, pending, request.compiler_threads, jet_driver_comptime_prefetches(request.compiler_threads), memory_plan)
        loop idx in 0..<prechecks.len() {
            if prechecks[idx].in_place() == .Val(check) {
                jet_driver_comptime_merge_item_delta(programs[0], check)
            }
        }
        jet_driver_trace_step_end(request.trace_sink, "comptime.precheck", pending.len())
        jet_driver_trace_step_begin(request.trace_sink, "comptime.prefetch")
        prefetched: jet_driver_comptime_prefetch(environments, programs, available, run_index, memory_plan, values, prechecks, comptime_scopes.host_hooks, request.compiler_threads)
        jet_driver_trace_step_end(request.trace_sink, "comptime.prefetch", prefetched)
        // A batch carried into a pass of values computed ahead (held below)
        // lands ahead of them when a check the prefetch dropped waits on it:
        // their closures then find those checks made on the compiler
        // threads, not waiting, as in the pass after a landing. Those values
        // report nothing, so the batch's reports keep their place.
        if batch.entries.len() > 0 && jet_driver_comptime_all_ahead(pending) && jet_driver_comptime_prefetch_awaits(run_index, batch) {
            flushed: jet_driver_comptime_staged_flush(request, batch, values, checked_functions, trace, programs, staging, counters, diagnostics)
            batch = jet_driver_comptime_batch_new()
            if flushed.progressed -> made_progress = true
            if flushed.stop == .Val(stopped) {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return stopped
            }
            if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                refused_any = true
                stop_mark = diagnostics.len()
            }
            if values.len() > resolved_count {
                jet_driver_comptime_apply_landed(environments[0], programs[0], available, staging.sites, values, resolved_count, trail, request.trace_sink)
                resolved_count = values.len()
            }
            jet_driver_comptime_pass_sites(run_index, pending, batch)
            jet_driver_trace_step_begin(request.trace_sink, "comptime.prefetch")
            landed_prefetched: jet_driver_comptime_prefetch_landed(environments, programs, available, run_index, memory_plan, values, comptime_scopes.host_hooks, request.compiler_threads)
            jet_driver_trace_step_end(request.trace_sink, "comptime.prefetch", landed_prefetched)
        }
        prechecks.reverse()
        prechecked_typed: available.typed
        loop source in pending {
            ^precheck: prechecks.pop() ?? SemaComptimeItemCheck?{None}
            ^retry: true
            loop retry {
                retry = false
                if values.len() > resolved_count {
                    jet_driver_comptime_apply_landed(environments[0], programs[0], available, staging.sites, values, resolved_count, trail, request.trace_sink)
                    resolved_count = values.len()
                }
                // Its waits stand until one of them lands, unless the batch
                // computes them all, which it may read in the batch's program.
                settled_pair: sema_comptime_key_set_pair(settled_waits.items, source.module_identity, source.key) ?? -1
                if settled_pair >= 0 && settled_waits.waits[settled_pair] == .Val(previous_waits) {
                    if !jet_driver_comptime_any_available(available, previous_waits) && !jet_driver_comptime_batch_computes(batch, previous_waits) {
                        wait_rows.push(
                            JetDriverComptimeWaitRow{
                                key: source.key,
                                name: source.name,
                                module_identity: source.module_identity,
                                span: source.span,
                                dependencies: previous_waits,
                            },
                        )
                        next_pending.push(source.copy())
                        next
                    }
                }
                if request.trace_sink == .Val(sink) {
                    sink.begin_item("comptime.check", source.source_file, source.name)
                }
                ^checked_item: jet_driver_comptime_prechecked(precheck, available, batch, prechecked_typed) ?? sema_check_comptime_item(environments[0], programs[0], comptime_scopes, available, source)
                jet_driver_comptime_merge_item_delta(programs[0], checked_item)
                jet_driver_trace_step_end(request.trace_sink, "comptime.check", 1)
                precheck = None
                counters.items_checked += 1
                // A check that waits only on constants the batch computes
                // reads them in the batch's program, and goes on as one that
                // waits on nothing.
                if jet_driver_comptime_computed_waits(batch, checked_item) {
                    checked_item.waiting_dependencies = [String]{}
                }
                // A settled check that waits on a batch key waits below.
                if batch.entries.len() > 0 && !jet_driver_comptime_settled(source.local_value, jet_driver_has_errors(checked_item.diagnostics), checked_item.complete, checked_item.waiting_dependencies) {
                    ^flushed: jet_driver_comptime_staged_flush(request, batch, values, checked_functions, trace, programs, staging, counters, diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                    if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                        refused_any = true
                        stop_mark = diagnostics.len()
                    }
                    if values.len() > resolved_count {
                        jet_driver_comptime_apply_landed(environments[0], programs[0], available, staging.sites, values, resolved_count, trail, request.trace_sink)
                        resolved_count = values.len()
                        if request.trace_sink == .Val(sink) {
                            sink.begin_item("comptime.check", source.source_file, source.name)
                        }
                        checked_item = sema_check_comptime_item(environments[0], programs[0], comptime_scopes, available, source)
                        jet_driver_comptime_merge_item_delta(programs[0], checked_item)
                        jet_driver_trace_step_end(request.trace_sink, "comptime.check", 1)
                        counters.items_checked += 1
                    }
                }
                ^item_diagnostic_start: diagnostics.len()
                // A module value's compile-time reports are withdrawn: when
                // its compile-time check fails it is refused, after its check
                // as ordinary code reports its real errors
                // (jet_driver_module_value_refused). A local value's are
                // withdrawn too: its owner body's check reports for it.
                if !source.module_value && !source.local_value {
                    // A comptime item's checker reports against its own module's
                    // source, so each carries that module's location.
                    loop diagnostic in checked_item.diagnostics {
                        attached: jet_driver_attach_program_source_location(diagnostic, programs[0], source.module_identity)
                        if !sema_core_lint_dropped(attached, own_check: programs[0].core_own_check) {
                            diagnostics.push(attached)
                        }
                    }
                    // JET_KEEP_GOING: an item whose own check reported an error is
                    // dropped (its value never lands) and the run goes on.
                    if keep_going {
                        if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
                    } else if jet_driver_has_errors_since(diagnostics, stop_mark) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    }
                }
                if checked_item.waiting_dependencies.len() > 0 {
                    if checked_item.diagnostics.len() == 0 {
                        jet_driver_comptime_settled_put(settled_waits, source.module_identity, source.key, checked_item.waiting_dependencies)
                    } else {
                        jet_driver_comptime_settled_drop(settled_waits, source.module_identity, source.key)
                    }
                    wait_rows.push(
                        JetDriverComptimeWaitRow{
                            key: source.key,
                            name: source.name,
                            module_identity: source.module_identity,
                            span: source.span,
                            dependencies: checked_item.waiting_dependencies,
                        },
                    )
                    next_pending.push(source.copy())
                    next
                }
                if source.module_value {
                    // A module value whose compile-time check fails, or that
                    // calls anything impure, is refused untried.
                    if jet_driver_module_value_check_refusal(programs[0], checked_item, false) == .Val(reason) {
                        jet_driver_module_value_refused(environments[0], programs[0], comptime_scopes, available, source, false, reason, diagnostics)
                        refused_any = true
                        stop_mark = diagnostics.len()
                        next
                    }
                    // Its compile-time check passed: its warnings are its own.
                    loop diagnostic in checked_item.diagnostics {
                        diagnostics.push(jet_driver_attach_program_source_location(diagnostic, programs[0], source.module_identity))
                    }
                }
                // A local value whose compile-time check fails, or that calls
                // anything impure, stays run-time code untried. One computed
                // ahead keeps only an impurity: a check that fails ahead
                // leaves no value, and its site is computed when it lands.
                if source.local_value {
                    if jet_driver_module_value_check_refusal(programs[0], checked_item, true) == .Val(reason) {
                        if !source.ahead || jet_driver_comptime_checked_whole(checked_item) {
                            jet_driver_comptime_local_value_runs(values, source, reason)
                        }
                        made_progress = true
                        next
                    }
                }
                if !checked_item.complete && keep_going {
                    diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` did not check to a complete typed value", "JET_KEEP_GOING drops the item and runs the rest", "see the item's other reports"))
                    next
                }
                if !checked_item.complete {
                    if jet_driver_has_errors_since(diagnostics, stop_mark) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    }
                    jet_driver_ice_record(totality, "comptime item `{source.name}` in {sema_check_registered_module_text(programs[0], source.module_identity)}", "sema.comptime", "totality", "its check returned no complete typed value, dependency wait set or diagnostic")
                    next
                }
                // A precheck thread folded this same request with no landed
                // values; that value stands (sema_comptime_fold).
                ^folded: checked_item.folded.move()
                checked_item.folded = None
                comptime_request: checked_item.request ?? {
                    diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "a complete comptime item check returned no typed evaluation request", "each staged value is evaluated only from its complete checked expression", "retain the canonical Sema comptime request"))
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                // A value computed ahead that no build could keep has no site.
                if source.ahead && sema_comptime_local_value_unstorable(jet_driver_comptime_expr_type_in(programs[0], comptime_request.expression)) {
                    made_progress = true
                    next
                }
                // A comptime input with a literal path that is the item's whole
                // value (`TEXT: #run embed_file("x")`) is read here, with no
                // evaluation; a computed path is evaluated.
                if jet_driver_comptime_literal_input(comptime_request.expression) == .Val(literal_input) {
                    if jet_driver_comptime_read_input(request, source.source_file, literal_input) == {
                        .Ok(value) -> {
                            values.push(jet_driver_comptime_item_value_in(programs[0], source, value, comptime_request.expression))
                            made_progress = true
                            next
                        }
                        .Err(error) -> {
                            diagnostics.push(jet_driver_attach_program_source_location(error.diagnostic, programs[0], source.module_identity))
                            if keep_going -> next
                            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                        }
                    }
                }
                // A declared point (`clicked: event.point<Int>()`) lands its
                // construction option, a hook point's fallback or a decision
                // point's policy, folded as literal data, or Unit for an
                // event point: the program makes the point's carrier on its
                // first read, once per process, and every read shares it.
                if folded == None && source.module_value && sema_comptime_module_point(programs[0], comptime_request.expression.tree, comptime_request.expression.root) == .Val(point) {
                    ^landed: TComptimeValue?{Val(TComptimeValue.Unit)}
                    if point.option == .Val(option) {
                        landed = sema_comptime_fold_in(programs[0], comptime_request.expression.tree, option, values)
                    }
                    if landed == .Val(value) {
                        values.push(jet_driver_comptime_item_value_in(programs[0], source, value, comptime_request.expression))
                        made_progress = true
                        next
                    }
                    jet_driver_module_value_refused(environments[0], programs[0], comptime_scopes, available, source, true, "a point's fallback or policy is literal data, and its value is not literal data", diagnostics)
                    refused_any = true
                    stop_mark = diagnostics.len()
                    next
                }
                // A binding of a point's shape whose value is not a point is
                // a constant, so ALL_CAPS (sema_casing_point_shaped).
                if source.point_name == .Val(name_span) {
                    ^casing: [Diagnostic]{}
                    sema_casing_screaming(source.name, name_span, "constant", casing)
                    loop diagnostic in casing {
                        diagnostics.push(jet_driver_attach_program_source_location(diagnostic, programs[0], source.module_identity))
                    }
                }
                // A module `Shared{X}` holder lands the payload the build
                // folds; the program allocates its cell on the first read. A
                // payload that is not literal data is refused.
                if folded == None && source.module_value && sema_comptime_shared_payload(comptime_request.expression.tree, comptime_request.expression.root) == .Val(payload) {
                    folded = sema_comptime_fold_in(programs[0], comptime_request.expression.tree, payload, values)
                    if folded == None {
                        jet_driver_module_value_refused(environments[0], programs[0], comptime_scopes, available, source, true, "a module `Shared` cell starts from literal data, and its value is not literal data", diagnostics)
                        refused_any = true
                        stop_mark = diagnostics.len()
                        next
                    }
                }
                if source.kind != SemaComptimeItemKind.CheckedText && (comptime_request.calls.len() == 0 || folded != None) {
                    if folded == None {
                        folded = sema_comptime_fold_in(programs[0], comptime_request.expression.tree, comptime_request.expression.root, values)
                    }
                    if folded == .Val(plain) {
                        if jet_driver_comptime_discriminant_range(programs[0], source, plain) == .Val(refusal) {
                            diagnostics.push(refusal)
                            if keep_going -> next
                            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                        }
                        jet_driver_comptime_value_functions_note(run_index.value_functions, source.key, plain)
                        values.push(jet_driver_comptime_item_value_in(programs[0], source, plain, comptime_request.expression))
                        made_progress = true
                        next
                    }
                }
                ^checked_mark: checked_functions.len()
                closure_diagnostic_start: diagnostics.len()
                if request.trace_sink == .Val(sink) {
                    sink.begin_item("comptime.closure", source.source_file, source.name)
                }
                ^closure: jet_driver_comptime_function_closure(environments[0], programs[0], comptime_scopes, available, run_index, memory_plan, values, checked_functions, comptime_request, source.module_value || source.local_value, source.local_value, diagnostics, request.compiler_threads)
                jet_driver_trace_step_end(request.trace_sink, "comptime.closure", closure.functions.len() + closure.rows.len())
                // A value computed ahead whose closure checked a function
                // holding a `#run` site of a body is not computed ahead: no
                // pass of this run lands that site, so the check holds no
                // binding for its local, and the body pass would take that
                // check as the function's body. The closure's checks are
                // forgotten, and the site is computed when its body lands,
                // where its closure waits for the `#run` site
                // (jet_driver_comptime_site_waits).
                if source.ahead && jet_driver_comptime_holds_run_site(checked_functions, checked_mark) {
                    loop diagnostics.len() > closure_diagnostic_start -> ^_: diagnostics.pop()
                    jet_driver_comptime_forget_functions(checked_functions, run_index, checked_mark)
                    made_progress = true
                    next
                }
                // A closure that waits on a site of the pass withdraws its
                // reports: the item is checked again once the site has
                // landed, and reports then.
                if closure.site_waits {
                    loop diagnostics.len() > closure_diagnostic_start -> ^_: diagnostics.pop()
                }
                // A settled closure that waits on a batch key waits below.
                if batch.entries.len() > 0 && !jet_driver_comptime_settled(source.local_value, jet_driver_has_errors_since(diagnostics, item_diagnostic_start), closure.complete, closure.waiting_dependencies) {
                    loop diagnostics.len() > item_diagnostic_start -> ^_: diagnostics.pop()
                    jet_driver_comptime_forget_functions(checked_functions, run_index, checked_mark)
                    ^flushed: jet_driver_comptime_staged_flush(request, batch, values, checked_functions, trace, programs, staging, counters, diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                    if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                        refused_any = true
                        stop_mark = diagnostics.len()
                    }
                    retry = true
                    next
                }
                // A local value's closure reports are withdrawn: the bodies'
                // own checks report. A failed or impure closure leaves it
                // run-time code untried.
                if source.local_value {
                    closure_failed: jet_driver_has_errors_since(diagnostics, closure_diagnostic_start) || (!closure.complete && closure.waiting_dependencies.len() == 0)
                    failure: jet_driver_first_error_since(diagnostics, closure_diagnostic_start) ?? "a function it calls does not check completely"
                    loop diagnostics.len() > closure_diagnostic_start -> ^_: diagnostics.pop()
                    if closure.waiting_dependencies.len() == 0 && (closure_failed || closure.impurity != None) {
                        if !source.ahead || closure.impurity != None {
                            jet_driver_comptime_local_value_runs(values, source, closure.impurity ?? "a function it calls fails its compile-time check ({failure})")
                        }
                        made_progress = true
                        next
                    }
                }
                if source.module_value {
                    closure_errors: jet_driver_has_errors_since(diagnostics, closure_diagnostic_start)
                    // A finished closure whose functions fail their own
                    // checks keeps those reports: they are the item's real
                    // errors, and it is refused with nothing more.
                    if closure_errors && closure.impurity == None && closure.waiting_dependencies.len() == 0 {
                        refused_any = true
                        stop_mark = diagnostics.len()
                        next
                    }
                    closure_failed: closure_errors || (!closure.complete && closure.waiting_dependencies.len() == 0)
                    // Any other closure's reports are withdrawn: an impure
                    // or incomplete closure refuses the item, and a waiting
                    // one reports again at its next check.
                    if closure_failed || closure.waiting_dependencies.len() > 0 {
                        loop diagnostics.len() > closure_diagnostic_start -> ^_: diagnostics.pop()
                    }
                    if closure.waiting_dependencies.len() == 0 && (closure_failed || closure.impurity != None) {
                        reason: closure.impurity ?? "a function it calls does not check completely"
                        jet_driver_module_value_refused(environments[0], programs[0], comptime_scopes, available, source, true, reason, diagnostics)
                        refused_any = true
                        stop_mark = diagnostics.len()
                        next
                    }
                }
                if keep_going {
                    if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
                } else if jet_driver_has_errors_since(diagnostics, stop_mark) {
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                if !closure.complete && closure.waiting_dependencies.len() == 0 && keep_going {
                    reasons: loop row in closure.incomplete -> "{jet_driver_totality_function(row)}: {row.reason}"
                    diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` has an incomplete function closure: {reasons.join("; ")}", "JET_KEEP_GOING drops the item and runs the rest", "see the closure's other reports"))
                    next
                }
                if !closure.complete && closure.waiting_dependencies.len() == 0 {
                    if closure.incomplete.len() == 0 {
                        jet_driver_ice_record(totality, "comptime item `{source.name}` in {sema_check_registered_module_text(programs[0], source.module_identity)}", "sema.comptime", "totality", "its function closure is incomplete with no recorded cause")
                    }
                    loop row in closure.incomplete {
                        jet_driver_ice_record(totality, jet_driver_totality_function(row), "sema.comptime", "totality", "{row.reason} (reached by comptime item `{source.name}`)")
                    }
                    next
                }
                if closure.waiting_dependencies.len() > 0 {
                    ^dependencies: [String]{}
                    loop dependency in checked_item.waiting_dependencies {
                        jet_driver_comptime_wait_add(dependencies, dependency)
                    }
                    loop dependency in closure.waiting_dependencies {
                        jet_driver_comptime_wait_add(dependencies, dependency)
                    }
                    // A wait on a body site is checked again next pass: a
                    // site's value never joins the available constants.
                    if checked_item.diagnostics.len() == 0 && diagnostics.len() == item_diagnostic_start && !closure.site_waits {
                        jet_driver_comptime_settled_put(settled_waits, source.module_identity, source.key, dependencies.copy())
                    } else {
                        jet_driver_comptime_settled_drop(settled_waits, source.module_identity, source.key)
                    }
                    wait_rows.push(
                        JetDriverComptimeWaitRow{
                            key: source.key,
                            name: source.name,
                            module_identity: source.module_identity,
                            span: source.span,
                            dependencies: dependencies,
                        },
                    )
                    next_pending.push(source.copy())
                    next
                }
                ^waiting_checked_text: false
                ^rejected_checked_text_call: false
                loop call in comptime_request.calls {
                    if call.checked_text == .Val(evaluation) {
                        checked_source: sema_comptime_checked_text_source(evaluation)
                        if sema_comptime_key_set_has(rejected_checked_text, checked_source.module_identity, checked_source.key) {
                            rejected_checked_text_call = true
                        } else if !sema_comptime_key_set_has(accepted_checked_text, checked_source.module_identity, checked_source.key) {
                            if jet_driver_comptime_checked_text_source_add(next_pending, known_sources, evaluation) {
                                made_progress = true
                            }
                            waiting_checked_text = true
                        }
                    }
                }
                if rejected_checked_text_call -> next
                if waiting_checked_text && source.kind != SemaComptimeItemKind.CheckedText {
                    next_pending.push(source.copy())
                    next
                }
                loop function_index in scanned_functions..<checked_functions.len() {
                    loop call in checked_functions[function_index].calls {
                        if call.checked_text == .Val(evaluation) {
                            if jet_driver_comptime_checked_text_source_add(next_pending, known_sources, evaluation) {
                                made_progress = true
                            }
                        }
                    }
                    // The local values the closure's function checks staged
                    // are computed ahead in this run, so the landing of
                    // their bodies builds no program for them. A site added
                    // is progress: the batch waits into the next pass, which
                    // adds the site to it.
                    loop site in checked_functions[function_index].comptime_body_sources {
                        if !site.local_value || site.local_binding -> next
                        ahead: sema_comptime_local_value_ahead_site(site)
                        if !sema_comptime_key_set_add(known_sources, ahead.module_identity, ahead.key) {
                            next
                        }
                        next_pending.push(ahead)
                        made_progress = true
                    }
                }
                scanned_functions = checked_functions.len()
                // A settled closure names its bodies by checked row.
                loop row in closure.rows {
                    if checked_functions[row].function == .Val(function) {
                        closure.functions.push(function.copy())
                    }
                    closure.functions.extend(checked_functions[row].conversions)
                }
                if jet_driver_comptime_batchable(source) {
                    computed: jet_driver_comptime_computes(source)
                    if computed {
                        jet_driver_comptime_type_land(programs[0], available, staging.sites, source, comptime_request.expression, trail)
                    }
                    jet_driver_comptime_batch_add(batch, source, comptime_request, closure.functions, closure.foreign.move(), computed)
                    next
                }
                if batch.entries.len() > 0 {
                    ^flushed: jet_driver_comptime_staged_flush(request, batch, values, checked_functions, trace, programs, staging, counters, diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                    if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                        refused_any = true
                        stop_mark = diagnostics.len()
                    }
                }
                ^alone: jet_driver_comptime_batch_new()
                jet_driver_comptime_batch_add(alone, source, comptime_request, closure.functions, closure.foreign.move(), false)
                ^flushed: jet_driver_comptime_staged_flush(request, alone, values, checked_functions, trace, programs, staging, counters, diagnostics)
                if flushed.progressed -> made_progress = true
                if flushed.stop == .Val(stopped) {
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return stopped
                }
                if source.kind == SemaComptimeItemKind.CheckedText {
                    if flushed.rejected {
                        ^_: sema_comptime_key_set_add(rejected_checked_text, source.module_identity, source.key)
                    } else if flushed.progressed {
                        ^_: sema_comptime_key_set_add(accepted_checked_text, source.module_identity, source.key)
                    }
                }
                if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                    refused_any = true
                    stop_mark = diagnostics.len()
                }
            }
        }
        // A batch that no waiting item names waits into the next pass when
        // this pass landed other values: the items that waited on those are
        // evaluated in the same program as the batch, so a run whose items
        // wait on folded constants builds one program, not one per pass. It
        // waits too into the pass of the values computed ahead, when nothing
        // else is left: they join it unless they wait on it.
        carried: next_pending.len() == 0 && held.len() > 0
        if batch.entries.len() > 0 && !carried && (!made_progress || next_pending.len() == 0 || jet_driver_comptime_batch_awaited(batch, wait_rows)) {
            ^flushed: jet_driver_comptime_staged_flush(request, batch, values, checked_functions, trace, programs, staging, counters, diagnostics)
            batch = jet_driver_comptime_batch_new()
            if flushed.progressed -> made_progress = true
            if flushed.stop == .Val(stopped) {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return stopped
            }
            if jet_driver_module_values_refused(environments[0], programs[0], comptime_scopes, available, flushed.refused, diagnostics) || flushed.rejected {
                refused_any = true
                stop_mark = diagnostics.len()
            }
        }
        // A local value still waiting once nothing else lands waits for
        // good: it stays run-time code, and the rest go on. The local values
        // leave the pending list in place, from the back.
        if next_pending.len() > 0 && !made_progress {
            loop waiting in next_pending {
                if waiting.local_value {
                    if !waiting.ahead {
                        jet_driver_comptime_local_value_runs(values, waiting, "it waits on a value compiling never computes")
                    }
                    made_progress = true
                }
            }
            ^pending_index: next_pending.len()
            loop pending_index > 0 {
                pending_index -= 1
                if next_pending[pending_index].local_value {
                    ^_: next_pending.remove(pending_index, .Slot)
                }
            }
        }
        if next_pending.len() > 0 && !made_progress {
            // What waits on a refused module value waits for good; the
            // refusal's reports are the run's.
            if totality.len() > 0 {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return jet_driver_comptime_totality_stop(values, checked_functions, trace, totality)
            }
            if refused_any {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            }
            ^cycle: jet_driver_comptime_dependency_cycle(wait_rows)
            if {
                cycle.len() > 0 -> {
                    ^chain: [String]{}
                    loop member in cycle -> chain.push(member.name.copy())
                    chain.push(cycle[0].name.copy())
                    ^cycle_diagnostic: sema_comptime_dependency_cycle_diagnostic(chain, cycle[0].span)
                    diagnostics.push(jet_driver_attach_program_source_location(cycle_diagnostic, programs[0], cycle[0].module_identity))
                }
                wait_rows.len() > 0 -> {
                    ^stalled: wait_rows[0]
                    diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], stalled.module_identity, "E0003", stalled.span, "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
                else -> {
                    diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
            }
            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
        }
        next_pending.extend(held)
        pending = next_pending
    }
    // Values that landed in the last pass join the program's graph, which
    // its owning run hands back with the result.
    if values.len() > resolved_count {
        jet_driver_comptime_apply_landed(environments[0], programs[0], available, staging.sites, values, resolved_count, trail, request.trace_sink)
    }
    if totality.len() > 0 {
        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
        return jet_driver_comptime_totality_stop(values, checked_functions, trace, totality)
    }
    if refused_any && !keep_going {
        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
        return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
    }
    ^finished: jet_driver_comptime_run_result(values, checked_functions, trace, true, false)
    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
    finished.graph_finished = true
    finished
}

// G (closure-scoped staging): what a checked comptime item's checked body reaches
// beyond itself. `functions` are the keys of the functions it calls;
// `everything` is set once it names any other declaration (a constant, a
// nominal type, a trait, a field owner, a foreign row, ...) or holds a form
// this walk does not follow, so an unknown form never counts as reaching
// nothing. The forms followed read no module declaration while they build:
// primitive types, literals, plain local reads, unary and binary operations,
// comparison chains without hooks, Display interpolation, inline blocks and
// plain lets. So an item that reaches nothing builds with no declaration
// rows exactly as with the staged rows of every module.
JetDriverComptimeReach: struct {
    everything: Bool,
    functions: [String],
}

jet_driver_comptime_reach_type: fn(reach: ^JetDriverComptimeReach, ty: Type) Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) -> {}
        .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            reach.everything = true
        }
    }
}

jet_driver_comptime_reach_local: fn(reach: ^JetDriverComptimeReach, local: TLocal) Never! {
    if local.deref || local.address_lifetime != None || local.persist_key != None || local.string_bytes_source != None || local.uninit_scalar || local.uninit_fixed {
        reach.everything = true
    }
}

jet_driver_comptime_reach_expr: fn(reach: ^JetDriverComptimeReach, tree: BodyTree, expression: Int) Never! {
    if reach.everything {
        return
    }
    tid: body_type_id(tree, expression)
    if tid.id < TYPE_ID_INT.id || tid.id == TYPE_ID_UNIT.id || tid.id == TYPE_ID_NEVER.id || tid.id > TYPE_ID_U64.id {
        reach.everything = true
    }
    if body_node(tree, expression).kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) -> {}
        .StrLit(parts) -> {
            loop part in parts {
                if part == {
                    .Interpolation(value, debug) -> {
                        if debug -> reach.everything = true
                        jet_driver_comptime_reach_expr(reach, tree, value)
                    }
                    .Literal(_) -> {}
                }
            }
        }
        .Local(local) -> { jet_driver_comptime_reach_local(reach, local) }
        .Unary(_, operand) -> { jet_driver_comptime_reach_expr(reach, tree, operand) }
        .Binary(_, _, _, lhs, rhs) -> {
            jet_driver_comptime_reach_expr(reach, tree, lhs)
            jet_driver_comptime_reach_expr(reach, tree, rhs)
        }
        .CompareChain(operands, _, hooks) -> {
            loop hook in hooks {
                if hook -> reach.everything = true
            }
            loop operand in operands -> jet_driver_comptime_reach_expr(reach, tree, operand)
        }
        .InlineBlock(body) -> {
            loop statement in body -> jet_driver_comptime_reach_stmt(reach, tree, statement)
        }
        .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {
            reach.everything = true
        }
    }
}

jet_driver_comptime_reach_stmt: fn(reach: ^JetDriverComptimeReach, tree: BodyTree, statement: Int) Never! {
    if reach.everything {
        return
    }
    if tree.stmts[statement] == {
        .Let(local, let_ty, init, gc_promotion, gc_transferred, _) -> {
            if let_ty == {
                .Inferred -> {}
                .StrView | .Annotated(_, _) -> reach.everything = true
            }
            if gc_promotion != None || gc_transferred -> reach.everything = true
            jet_driver_comptime_reach_local(reach, local)
            jet_driver_comptime_reach_expr(reach, tree, init)
        }
        .ExprStmt(value, _) -> jet_driver_comptime_reach_expr(reach, tree, value)
        .Contract(_) | .ContractScope(_, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {
            reach.everything = true
        }
    }
}

// G: whether an evaluated entry may build with no declaration rows: it names
// no staged constant, its checked closure is empty and its checked body (and expected
// type) reaches nothing.
jet_driver_comptime_entry_bare: fn(request: SemaComptimeItemRequest, function_rows: [Int]) -> Bool Never! {
    if request.dependencies.len() > 0 || function_rows.len() > 0 -> return false
    ^reach: JetDriverComptimeReach{everything: false, functions: [String]{}}
    if request.expected_type == .Val(expected) -> jet_driver_comptime_reach_type(reach, expected)
    jet_driver_comptime_reach_expr(reach, request.expression.tree, request.expression.root)
    !reach.everything && reach.functions.len() == 0
}

jet_driver_foreign_provider_owners_valid: fn(
    modules: [JetDriverLoadedModule],
    providers: [SemaForeignProviderInput],
    diagnostics: ^[Diagnostic],
) -> Bool {
    ^valid: true
    ^provider_index: 0
    loop provider_index < providers.len() {
        ^provider: providers[provider_index]
        ^module_matches: 0
        loop candidate_module in modules {
            if candidate_module.module_identity == provider.module_identity -> module_matches += 1
        }
        ^duplicate_identity: false
        ^prior_index: 0
        loop prior_index < provider_index {
            if providers[prior_index].module_identity == provider.module_identity {
                duplicate_identity = true
                break
            }
            prior_index += 1
        }
        if module_matches != 1 || duplicate_identity {
            diagnostics.push(
                jet_driver_diagnostic_without_span(
                    "E0003",
                    "a foreign provider does not resolve to one exact loaded module identity",
                    "provider handles are registered only on the synthetic module selected by their exact module_identity",
                    "retain one provider row for the exact loaded synthetic module identity",
                ),
            )
            valid = false
        }
        provider_index += 1
    }
    valid
}

jet_driver_registration_foreign_handle_facts: fn(
    module_identity: ModuleID,
    providers: [SemaForeignProviderInput],
    diagnostics: ^[Diagnostic],
) -> [SemaRegistrationForeignHandleFacts]? {
    ^selected_index: Int?{None}
    ^index: 0
    loop index < providers.len() {
        if providers[index].module_identity == module_identity {
            if selected_index != None {
                diagnostics.push(
                    jet_driver_diagnostic_without_span(
                        "E0003",
                        "more than one foreign provider has the exact module identity selected for registration",
                        "opaque handle facts belong to one exact synthetic provider module",
                        "retain one provider input for the loaded module identity",
                    ),
                )
                return None
            }
            selected_index = Val(index)
        }
        index += 1
    }
    provider_index: selected_index ?? return Val([SemaRegistrationForeignHandleFacts]{})
    ^provider: providers[provider_index]
    ^facts: [SemaRegistrationForeignHandleFacts]{}
    loop handle in provider.handles {
        facts.push(
            SemaRegistrationForeignHandleFacts{
                library: handle.library,
                typedef_name: handle.typedef_name,
                jet_name: handle.jet_name,
                ownership: "Owned",
                close: handle.close,
                close_source: handle.close_source,
                thread_safety: handle.thread_safety,
                send: handle.thread_safety == "safe",
                sync: handle.thread_safety == "safe",
                close_function_key: handle.close_function_key,
                source_span: provider.source_span,
            },
        )
    }
    Val(facts)
}

// The canonical effect module holds only the effect names its types declare
// (their `.EffectDecl` companions), made while the compiler builds
// (EffectModuleSource), so a compile parses none of its text: registration
// sees the vocabulary, and no Prelude effect type enters a program's scope as
// a type. No declarations is no module.
jet_driver_canonical_effect_module: fn(effects: EffectModuleSource, table: ^ModuleTable) -> SemaRegistrationModuleInput? {
    if effects.decls.len() == 0 -> return None
    ^program: ast_program()
    loop declaration in effects.decls -> program.items.push(Item.EffectDecl{value: declaration})
    ^source_file: "jet:canonical-prelude/Prelude/Effects.jet"
    ^package_identity: JET_CANONICAL_EFFECT_PACKAGE_IDENTITY
    ^module_path: JET_CANONICAL_EFFECT_MODULE_PATH
    ^module_identity: jet_driver_module_identity(package_identity, module_path)
    Val(SemaRegistrationModuleInput{
        package_identity: package_identity,
        module_identity: module_intern(table, module_identity),
        module_name: "Effects",
        core_source_alias: "",
        module_path: module_path,
        source_file: source_file,
        source_segments: [
            SemaSourceSegment{
                generated: Span{start: 0, end: effects.source.count_bytes()},
                source_file: source_file,
                source_start: 0,
                line_starts: effects.line_starts,
                origin: SemaSourceOrigin.CompilerGenerated,
            },
        ],
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: program.move(),
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
    })
}

// The original Prelude error declarations join the load as one
// compiler-generated source module (source unit, source file, loaded row),
// so registration, checking, assembly, and every loaded-identity check
// see one module set. Like Core, foreign aggregate, and canonical effect
// sources, its bytes also ride the generated sidecar, so a diagnostic sited in
// it projects through the host codec. The contract rule module
// (Prelude/Rules.jet) joins the same way, and only a load whose programs
// declare a `#run { … }` contract clause, the one thing its rules hear, pays
// for registering and checking it.
jet_driver_retain_prelude_modules: fn(load: ^JetDriverLoadResult) -> Bool {
    ^errors: sema_registration_original_error_module(load.module_table)
    if !jet_driver_retain_prelude_module(load, errors) -> return false
    if !jet_driver_items_declare_run_contract_in(load.modules) -> return true
    ^rules: sema_registration_rule_module(load.module_table)
    jet_driver_retain_prelude_module(load, rules)
}

// One compiler-owned Prelude module joins the load. A loaded source holding
// its path, alias, or identity is refused.
jet_driver_retain_prelude_module: fn(load: ^JetDriverLoadResult, original: ^^SemaRegistrationModuleInput) -> Bool {
    module_identity: jet_driver_module_identity(original.package_identity, original.module_path)
    ^collides: false
    loop unit in load.source_units {
        if unit.path == original.source_file || unit.module_name == original.module_name || jet_driver_module_identity(unit.package_identity, unit.relative_path) == module_identity {
            collides = true
        }
    }
    loop generated in load.generated_source_files {
        if generated.path == original.source_file -> collides = true
    }
    if collides {
        load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "an existing source collides with the original Prelude identity", "default-error declarations retain their original compiler-private source owner", "retain the canonical Prelude source and its parsed declaration provenance"))
        return false
    }
    file_diagnostics: load.diagnostics.len()
    file: SourceFile{id: source_file_id(original.source_file), path: original.source_file, source: original.source}
    jet_driver_add_source_file(load.source_files, file, load.diagnostics)
    jet_driver_add_source_file(load.generated_source_files, file, load.diagnostics)
    if load.diagnostics.len() != file_diagnostics -> return false
    source_unit_index: load.source_units.len()
    load.source_units.push(JetDriverSourceUnit{root_index: -1, file_index: -1, root_identity: original.package_identity, package_identity: original.package_identity, module_name: original.module_name, path: original.source_file, relative_path: original.module_path, source_segments: original.source_segments, source_origin: original.source_origin, in_namespace: false})
    load.modules.push(JetDriverLoadedModule{source_unit_index: source_unit_index, source_identity: jet_driver_source_identity(original.package_identity, original.source_file), package_identity: original.package_identity, module_identity: module_intern(load.module_table, module_identity), module_name: original.module_name, program: original.program.move()})
    true
}

// Whether a loaded program declares a `#Pre` or `#Post` clause written
// `#run { … }`: on a function, or on a method of a type, an impl, or a
// trait implementation, at any module depth.
jet_driver_items_declare_run_contract_in: fn(modules: [JetDriverLoadedModule]) -> Bool Never! {
    loop loaded in modules {
        if jet_driver_items_declare_run_contract(loaded.program.items) -> return true
    }
    false
}

jet_driver_items_declare_run_contract: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == .Func(value) && jet_driver_function_declares_run_contract(value) -> return true
        if item == .Struct(value) && (jet_driver_functions_declare_run_contract(value.methods) || jet_driver_impls_declare_run_contract(value.trait_impls)) {
            return true
        }
        if item == .Enum(value) && (jet_driver_functions_declare_run_contract(value.methods) || jet_driver_impls_declare_run_contract(value.trait_impls)) {
            return true
        }
        if item == .Impl(value) && jet_driver_functions_declare_run_contract(value.methods) {
            return true
        }
        if item == .GenericModule(value) && jet_driver_items_declare_run_contract(value.body) {
            return true
        }
        if item == .CodeModule(value) && value.body == .Val(body) && jet_driver_items_declare_run_contract(body) {
            return true
        }
    }
    false
}

jet_driver_impls_declare_run_contract: fn(blocks: [TraitImplBlock]) -> Bool Never! {
    loop block in blocks {
        if jet_driver_functions_declare_run_contract(block.methods) -> return true
    }
    false
}

jet_driver_functions_declare_run_contract: fn(functions: [Func]) -> Bool Never! {
    loop function in functions {
        if jet_driver_function_declares_run_contract(function) -> return true
    }
    false
}

jet_driver_function_declares_run_contract: fn(function: Func) -> Bool Never! {
    loop clause in function.pre {
        if clause.required -> return true
    }
    loop clause in function.post {
        if clause.required -> return true
    }
    false
}

// A retained compiler-owned Prelude unit (the original errors, the contract
// rules): compiler-generated, outside every authorized root, and not a
// Review source owner.
jet_driver_unit_is_compiler_prelude: fn(unit: JetDriverSourceUnit) -> Bool Never! {
    unit.root_index == -1 && unit.file_index == -1 && (unit.path == SEMA_PRELUDE_ERROR_SOURCE_PATH || unit.path == SEMA_PRELUDE_RULE_SOURCE_PATH) && unit.package_identity == JET_CANONICAL_EFFECT_PACKAGE_IDENTITY && unit.source_origin == SemaSourceOrigin.CompilerGenerated
}

jet_driver_compile_internal_result: fn(load: JetDriverLoadResult, trace: JetDriverCompileTrace, message: String) -> JetDriverCompileResult Never! {
    ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
    result.internal_problem = Val(message)
    result
}

// Doc failures retain the checked ledger when it exists; early registration
// failures retain only the import edges already proved.
jet_driver_doc_failure: fn(result: ^^JetDriverCompileResult, mode: JetDriverCompileMode, checked_facts: [StructureFact]?) -> JetDriverCompileResult Never! {
    ^failed: result.move()
    if mode == JetDriverCompileMode.Doc {
        failed.structure_facts = checked_facts ?? [StructureFact]{}
    }
    failed
}

// The import-edge structure facts of whichever stage currently holds the
// registration graph (it moves through the passes); only `jet doc` reads
// them, so every other mode skips the walk.
jet_driver_doc_graph_facts: fn(mode: JetDriverCompileMode, graph: SemaRegistrationGraph?) -> [StructureFact]? Never! {
    if mode != JetDriverCompileMode.Doc -> return None
    value: graph ?? return None
    Val(sema_name_structure_facts(value))
}

// The stop of a comptime run whose checks broke sema totality: every row in
// one ICE report (jet_driver_comptime_run's `totality`).
jet_driver_comptime_totality_stop: fn(values: [SemaComptimeItemValue], functions: [SemaComptimeFunctionResult], trace: JetDriverCompileTrace, totality: [JetDriverIceRow]) -> JetDriverComptimeRunResult Never! {
    ^result: jet_driver_comptime_run_result(values, functions, trace, false, false)
    result.internal_problem = Val("comptime checking left functions incomplete without a diagnostic: {jet_driver_ice_text(totality)}")
    result
}

// The result for a compile whose own failure escaped every stage: no stage
// produced a load or partial product, so only the internal problem is kept.
jet_driver_compile_escaped_failure: fn(message: String) -> JetDriverCompileResult Never! {
    JetDriverCompileResult{
        diagnostics: [Diagnostic]{},
        generated_source_files: [SourceFile]{},
        package_identity: "",
        entry_module_identity: "",
        comptime_stdout: "",
        comptime_stderr: "",
        soft_stop: false,
        exit_code: None,
        failed_stage: None,
        complete: false,
        internal_problem: Val(message),
    }
}

// The Test boundary admits either a named test block or an authenticated
// selected Check Output.
jet_driver_runnable_test_count: fn(graph: SemaRegistrationGraph) -> Int Never! {
    ^count: 0
    loop module_index in 0..<graph.modules.len() {
        source_module: graph.modules[module_index]
        loop item in source_module.program.items {
            if item == .Test(test) {
                if test.name != None -> count += 1
            }
            if source_module.module_identity == graph.entry_module_identity && item == .Const(constant) {
                if constant.resolved_output == .Val(output) {
                    if output.selected && output.kind == OutputKind.Check -> count += 1
                }
            }
        }
    }
    count
}

// Checked named tests and selected Check Outputs share the canonical Test
// harness, in declaration order. Coverage remains a separate request route.
// The modules whose tests a test run collects: the entry, plus every member file of the
// entry's package namespace (a package's tests are all of its #Tests), or, for
// a `jet test` of a Core source, the Core unit at the row path `core_tests`.
jet_driver_test_modules: fn(load: JetDriverLoadResult, core_tests: String) -> [U32:Bool] Never! {
    ^members: [U32:Bool]{}
    members[load.entry_module_identity.id] = true
    if core_tests != "" {
        loop loaded in load.modules {
            unit: load.source_units[loaded.source_unit_index]
            if jet_driver_unit_is_core(unit) && unit.relative_path == core_tests {
                members[loaded.module_identity.id] = true
            }
        }
        return members
    }
    ^entry_index: -1
    loop (idx, loaded) in load.modules {
        if loaded.module_identity == load.entry_module_identity -> entry_index = idx
    }
    if entry_index < 0 || load.modules[entry_index].namespace.len() == 0 -> return members
    loop loaded in load.modules {
        if loaded.namespace == load.modules[entry_index].namespace && loaded.package_identity == load.modules[entry_index].package_identity {
            members[loaded.module_identity.id] = true
        }
    }
    members
}

// What a compile's `--deep-checks` request keeps: the keys of the checked
// functions whose `#On(.Deep)` bodies it emits (IRChecks.deep), and an E2120
// or E2121 for each scope that keeps none.
JetDriverDeepChecks: struct {
    selected: [String],
    diagnostics: [Diagnostic],
}

// `--deep-checks` (JetDriverCompileRequest.deep_checks) over the checked
// functions. A function holds a deep check when a statement of its body tree,
// its lambdas' included, is an `#On(.Deep)` body. A bare flag keeps every
// holder; a scope keeps each holder whose path it selects
// (deep_checks_selects): outside Core, its declared package name, then its
// file module, inline module, owner type and name, joined by `.`
// (`tree.balance.Tree.fix`). The package name and its file and inline modules
// name the program's modules, over which a scope splits at its longest module
// prefix. A function outside a named package has no path, so only a bare
// flag keeps its deep checks. A scope that keeps no holder is reported
// (deep_checks_unselected).
jet_driver_deep_checks: fn(load: JetDriverLoadResult, functions: [FnBody], request: DeepChecks) -> JetDriverDeepChecks Never! {
    ^found: JetDriverDeepChecks{selected: [String]{}, diagnostics: [Diagnostic]{}}
    if deep_checks_off(request) -> return found
    // Each package's row of `load.packages` at its identity's id.
    ^package_keys: name_column_table(load.packages.len())
    ^package_rows: name_column()
    loop (row, package) in load.packages {
        name_column_set(package_keys, package_rows, package.identity, row)
    }
    ^modules: [U32:Int]{}
    ^names: [NameModule]{}
    loop (index, loaded) in load.modules {
        if !jet_driver_unit_is_core(load.source_units[loaded.source_unit_index]) {
            modules[loaded.module_identity.id] = index
            package: if name_column_get(package_keys, package_rows, loaded.package_identity) == .Val(row) -> load.packages[row].name else -> ""
            if package != "" {
                alias: if loaded.declared_module == "" -> package else -> "{package}.{loaded.declared_module}"
                jet_driver_deep_check_module(names, alias, loaded.package_identity)
            }
        }
    }
    ^paths: [String]{}
    ^holders: [String]{}
    loop function in functions {
        ^held: false
        loop statement in function.tree.stmts {
            if statement == .DeepCheck(_, _) -> held = true
        }
        if held && request.all -> found.selected.push(function.key.copy())  // copy: the selection outlives the checked rows.
        if function.synthetic -> next
        at: modules.get(function.module_identity.id) ?? next
        loaded: load.modules[at]
        package: if name_column_get(package_keys, package_rows, loaded.package_identity) == .Val(row) -> load.packages[row].name else -> ""
        if package == "" -> next
        // The key names the function's module, its owner (a method's owner
        // by the owner's own key) and its name (symbol_key_parts).
        identity: module_text(load.module_table, function.module_identity)
        parts: symbol_key_parts(function.key, fn(text: String) { text == identity }) ?? next
        if parts.kind != "function" -> next
        name: parts.name
        owner: parts.owner_name
        lifted: if owner == "" -> name else -> owner
        home: if loaded.declared_module == "" -> package else -> "{package}.{loaded.declared_module}"
        inline: sema_inline_member_module(lifted)
        if inline != "" {
            jet_driver_deep_check_module(names, "{home}.{inline}", loaded.package_identity)
        }
        ^words: [String]{if inline == "" -> home else -> "{home}.{inline}"}
        if owner != "" -> words.push(sema_inline_member_source_name(owner))
        words.push(if owner == "" -> sema_inline_member_source_name(name) else -> name)
        path: words.join(".")
        if held {
            if !request.all {
                ^kept: false
                loop scope in request.scopes {
                    if deep_checks_selects(scope, path) -> kept = true
                }
                if kept -> found.selected.push(function.key.copy())  // copy: the selection outlives the checked rows.
            }
            holders.push(path.copy())  // copy: the path is also a declaration row.
        }
        paths.push(path)
    }
    loop row in deep_checks_unselected(request, names, paths, holders) {
        found.diagnostics.push(deep_checks_unselected_report(row, names, load.package_identity, holders))
    }
    found
}

// Names the module `alias` of the package `identity` for the deep-check scope
// split, once: the root files of a package share its name.
jet_driver_deep_check_module: fn(names: ^[NameModule], alias: String, identity: String) -[]> Never! {
    loop row in names {
        if row.alias == alias && row.package == identity {
            return
        }
    }
    names.push(NameModule{alias: alias, path: alias, package: identity})
}

// The native Test harness plan over the checked functions `functions`: the
// named tests of `test_modules` whose bodies checked, and their selected Check
// Outputs, in declaration order. A Check Output whose callable did not check
// is an E0003.
jet_driver_test_plan: fn(test_modules: [U32:Bool], graph: SemaGraphResult, table: ModuleTable, functions: [FnBody], tests: ^[TTestFact], output_checks: ^[TOutputCheckFact], diagnostics: ^[Diagnostic]) Never! {
    ^checked_keys: name_column_table(functions.len())
    ^checked: name_column()
    loop (index, function) in functions {
        name_column_set(checked_keys, checked, function.key, index)
    }
    loop module_index in 0..<graph.modules.len() {
        graph_module: graph.modules[module_index]
        if test_modules.get(graph_module.module_identity.id) == None -> next
        loop fact in graph_module.tests {
            if name_column_get(checked_keys, checked, fact.function.key) != None {
                tests.push(fact.copy())
            }
        }
        loop constant in graph_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind != OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= graph.modules.len() {
                    diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    next
                }
                owner: graph.modules[output.module_id]
                function_key: symbol_key_text(SymbolKind.Function, module_text(table, owner.module_identity), "", output.semantic_name)
                row: name_column_get(checked_keys, checked, function_key) ?? {
                    diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output entry has no unique checked function identity", "Check Outputs invoke their registered checked callable", "retain the canonical function key through checking"))
                    next
                }
                function: functions[row]
                output_checks.push(
                    TOutputCheckFact{
                        key: "{module_text(table, graph_module.module_identity)}.output-check.{output.output_name}@{output.definition.start}..{output.definition.end}",
                        // copy: the fact owns its name and function ref; `output`
                        // and `function` are views of rows the compile keeps.
                        name: output.output_name.copy(),
                        function: TFunctionRef{key: function.key.copy(), module_identity: function.module_identity, name: function.name.copy(), span: function.source_span, visibility: function.visibility},
                    },
                )
            }
        }
    }
}

// One `#Export(c)` function of the entry module (`exported`), its symbol key
// and name; or one runtime binding of a runtime inline module
// (Guest.jet sema_guest_runtime_binding), which exports nothing and carries
// its jet.runtime interface row (jet_driver_runtime_interface_row).
JetDriverCExportRow: struct {
    key: String,
    name: String,
    exported: Bool,
    runtime_interface: RuntimeInterfaceRow?,
}

// The entry module's `#Export(c)` functions and runtime bindings in
// declaration order, read from the registration graph before IR lowering so
// the graph need not stay alive through lowering and assembly
// (jet_driver_c_exports).
jet_driver_c_export_rows: fn(graph: SemaRegistrationGraph, entry_module_identity: ModuleID) -> [JetDriverCExportRow] Never! {
    ^rows: [JetDriverCExportRow]{}
    loop registration_module in graph.modules {
        if registration_module.module_identity != entry_module_identity -> next
        loop row in registration_module.functions {
            ^exported: false
            loop marker in row.declaration.markers {
                if sema_marker_is_guest_export(marker) -> exported = true
            }
            if exported {
                rows.push(JetDriverCExportRow{key: symbol_table_key(graph.symbols, row.symbol.id), name: row.declaration.name, exported: true, runtime_interface: None})
            } else if sema_guest_runtime_binding(registration_module.package_identity, row.declaration) {
                symbol: parser_guest_import_symbol(row.declaration) ?? next
                rows.push(JetDriverCExportRow{key: symbol_table_key(graph.symbols, row.symbol.id), name: row.declaration.name, exported: false, runtime_interface: jet_driver_runtime_interface_row(row.declaration, symbol)})
            }
        }
    }
    rows
}

// One `#Job` function of the entry module: its symbol key,
// its name (the program word that selects it), whether it is `#Job(.Ship)`,
// the only scope a release binary exposes, and whether argv can select it:
// `.Internal` jobs never reach argv, and typed job arguments
// are not built, so a job with parameters is not selectable either.
JetDriverJobRow: struct {
    key: String,
    name: String,
    shipped: Bool,
    selectable: Bool,
}

// The entry module's jobs in declaration order, read from the registration
// graph as jet_driver_c_export_rows reads its exports: the list a run's
// unknown-job report (E1294) names and a release build's stripped-job line
// counts.
jet_driver_job_rows: fn(graph: SemaRegistrationGraph, entry_module_identity: ModuleID) -> [JetDriverJobRow] Never! {
    ^rows: [JetDriverJobRow]{}
    loop registration_module in graph.modules {
        if registration_module.module_identity != entry_module_identity -> next
        loop row in registration_module.functions {
            // An inline module's job (a generated `__jet_` path name) is not the entry's (JobRegistry.from_items).
            if !row.declaration.is_job || row.declaration.name.starts_with("__jet_") -> next
            metadata: row.declaration.job_metadata ?? ast_job_metadata()
            selectable: metadata.scope != .Internal && row.declaration.params.len() == 0
            rows.push(JetDriverJobRow{key: symbol_table_key(graph.symbols, row.symbol.id), name: row.declaration.name, shipped: metadata.scope == .Ship, selectable: selectable})
        }
    }
    rows
}

// The one native spelling of an exported C symbol.
jet_driver_c_symbol: fn(name: String) -> String Never! {
    ^bytes: [U8]{}
    loop byte in name.bytes() {
        alphanumeric: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        bytes.push(if alphanumeric || byte == 95 -> byte else -> 95)
    }
    if bytes.len() == 0 || (bytes[0] >= 48 && bytes[0] <= 57) -> bytes.insert(0, 95)
    String.from_bytes(bytes) ?? "_"
}

// The Core source modules whose top-level bodies are lowered only when reached.
// Compiler-private parts (`Core/Text/String.jet`) are listed too: a receiver
// function there is kept only when a kept body's checked `ModuleCall` names it,
// never the whole part. Host-only Core modules are not listed, so their bodies
// stay rooted; so is a Core module with foreign rows, whose close and undo
// adapters Codegen resolves by key.
jet_driver_prunable_core_modules: fn(load: JetDriverLoadResult, core_sources: [JetDriverCoreSource], modules: [SemaGraphModuleResult]) -> [ModuleID] Never! {
    ^identities: [ModuleID]{}
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 || semantic_module.foreign_providers.len() > 0 {
            next
        }
        loop module_row in load.modules {
            if module_row.module_identity != semantic_module.module_identity -> next
            unit: load.source_units[module_row.source_unit_index]
            if jet_driver_unit_is_core(unit) && unit.file_index >= 0 && unit.file_index < core_sources.len() {
                identities.push(semantic_module.module_identity)
            }
        }
    }
    identities
}

// The modules of the packages the entry package depends on: their top-level
// bodies are lowered only when reached, as Core's are. Only a package that
// is not the entry's is listed; a source root's loose files belong to the
// entry. A module with foreign rows stays rooted, as in Core.
jet_driver_prunable_dependency_modules: fn(load: JetDriverLoadResult, modules: [SemaGraphModuleResult]) -> [ModuleID] Never! {
    ^dependencies: name_table_sized(2)
    loop package in load.packages {
        if package.identity != load.package_identity && !package.identity.starts_with("source-root:") {
            ^_: name_intern(dependencies, package.identity)
        }
    }
    ^identities: [ModuleID]{}
    if name_count(dependencies) <= 1 -> return identities
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 || semantic_module.foreign_providers.len() > 0 {
            next
        }
        loop module_row in load.modules {
            if module_row.module_identity != semantic_module.module_identity -> next
            if name_find(dependencies, module_row.package_identity) != None {
                identities.push(semantic_module.module_identity)
            }
        }
    }
    identities
}

// Whether `identity` is the module of the loaded source whose display path
// (jet_driver_display_path, as JetDriverSourceUnit.path holds it) is `path`.
jet_driver_source_module: fn(load: JetDriverLoadResult, identity: ModuleID, path: String) -> Bool Never! {
    loop module_row in load.modules {
        if module_row.module_identity != identity || module_row.source_unit_index < 0 -> next
        if load.source_units[module_row.source_unit_index].path == path -> return true
    }
    false
}

// The entry package's own modules (a source root's loose files among them),
// whose top-level bodies `dead_code: remove` lowers only when the entry's
// roots (jet_driver_entry_root_keys) reach them, as a dependency's are. Core
// source is listed apart (jet_driver_prunable_core_modules); a module with
// foreign rows stays rooted, as in Core.
jet_driver_prunable_entry_modules: fn(load: JetDriverLoadResult, modules: [SemaGraphModuleResult]) -> [ModuleID] Never! {
    ^identities: [ModuleID]{}
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 || semantic_module.foreign_providers.len() > 0 {
            next
        }
        loop module_row in load.modules {
            if module_row.module_identity != semantic_module.module_identity -> next
            if module_row.source_unit_index >= 0 && jet_driver_unit_is_core(load.source_units[module_row.source_unit_index]) {
                next
            }
            if module_row.package_identity == load.package_identity || module_row.package_identity.starts_with("source-root:") {
                identities.push(semantic_module.module_identity)
            }
        }
    }
    identities
}

// The functions of `modules` (jet_driver_prunable_entry_modules) that
// `dead_code: remove` lowers with no call reaching them: the entry
// `entry_key` and the functions entry resolution names beside it (the entry
// module's `run`, which a typed CLI's generated `__jet_cli_run` may never
// call, and each selected Output's function, whose generated wrapper may be
// the entry; jet_driver_resolve_entry_key); every function the compiler
// generated or injected (a `__jet_` name, as the typed CLI's run and parse,
// and the Prelude error conversions a `?` calls) or that is a `#Job`
// (ir_entry_function selects one by the program's first word), scheduled by
// `#Every`, in a web partition or under any other marker (an `#Export(c)`
// function among them), since a host, a scheduler or a generated table runs
// it by name; and every function a foreign call or C handle names as its
// callback, `#Close` or `undo` inverse. A callback Jet code passes is reached
// through the function value its taker names.
jet_driver_entry_root_keys: fn(graph: SemaRegistrationGraph, modules: [ModuleID], semantic_graph: SemaGraphResult, entry_module_identity: ModuleID, entry_key: String?) -> NameTable Never! {
    ^listed: [U32:Bool]{}
    loop identity in modules -> listed[identity.id] = true
    ^roots: name_table_sized(64)
    if entry_key == .Val(key) -> ^_: name_intern(roots, key)
    ^_: name_intern(roots, symbol_key_text(SymbolKind.Function, module_text(graph.module_table, entry_module_identity), "", "run"))
    loop registration_module in graph.modules {
        if !listed.has_key(registration_module.module_identity.id) -> next
        loop row in registration_module.functions {
            declaration: row.declaration
            if declaration.compiler_generated || declaration.name.starts_with("__jet_") || declaration.is_job || declaration.every != None || declaration.web_marker != None || declaration.markers.len() > 0 {
                ^_: name_intern(roots, symbol_table_key(graph.symbols, row.symbol.id))
            }
        }
    }
    loop semantic_module in semantic_graph.modules {
        loop constant in semantic_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind == OutputKind.Check || output.module_id < 0 || output.module_id >= semantic_graph.modules.len() {
                    next
                }
                ^_: name_intern(roots, symbol_key_text(SymbolKind.Function, module_text(graph.module_table, semantic_graph.modules[output.module_id].module_identity), "", output.semantic_name))
            }
        }
        if listed.has_key(semantic_module.module_identity.id) {
            loop key in semantic_module.injected_function_keys -> ^_: name_intern(roots, key)
        }
        loop foreign in semantic_module.foreign_functions {
            if foreign.callback_key == .Val(key) -> ^_: name_intern(roots, key)
            if foreign.close_function_key == .Val(key) -> ^_: name_intern(roots, key)
            if foreign.undo_function_key == .Val(key) -> ^_: name_intern(roots, key)
        }
        loop provider in semantic_module.foreign_providers {
            loop handle in provider.handles {
                if handle.close_function_key == .Val(key) -> ^_: name_intern(roots, key)
                if handle.undo_function_key == .Val(key) -> ^_: name_intern(roots, key)
            }
        }
    }
    roots
}

// The Core functions and methods a compile that lowers checks up front under
// Core demand (SemaRegistrationGraph.core_lowering_roots), by key: the
// top-level functions lowering finds by the jet_builtins role they fill
// (sema_core_role), every top-level function of a Core module with foreign
// rows, which jet_driver_prunable_core_modules leaves rooted, or of the Core
// unit under test (`tested`, jet_driver_test_modules: a `jet test` of a Core
// source, and a debugger's evaluation in a Core frame, whose expression is
// a function appended to that unit that no body calls), which lowering roots
// whole, the methods lowering selects by owner type
// (ir_core_method_lowered_by_owner) and the sibling reads it selects by the
// target of the TypedDecodeRead read (ir_core_decoding_read).
jet_driver_core_lowering_roots: fn(graph: SemaRegistrationGraph, tested: [U32:Bool]) -> NameTable Never! {
    ^roots: name_table_sized(256)
    loop module_row in graph.modules {
        identity: module_row.module_identity
        if !module_is_core(identity) -> next
        identity_text: module_text(graph.module_table, identity)
        ^rooted: module_row.foreign_functions.len() > 0 || tested.get(identity.id) != None
        loop provider in graph.foreign_providers {
            if provider.module_identity == identity -> rooted = true
        }
        loop item in module_row.program.items {
            if item == .Func(func) {
                if rooted || sema_core_role(func.markers, graph, identity) != "" {
                    ^_: name_intern(roots, symbol_key_text(SymbolKind.Function, identity_text, "", func.name))
                }
            }
        }
        loop nominal in module_row.nominals {
            ^fills_read: false
            loop method in nominal.methods {
                if sema_core_role(method.declaration.markers, graph, identity) == CORE_ROLE_TYPED_DECODE_READ {
                    fills_read = true
                }
            }
            loop method in nominal.methods {
                if ir_core_method_lowered_by_owner(method.declaration.name) || ir_core_decoding_read(fills_read, method.declaration.name) {
                    ^_: name_intern(roots, symbol_table_key(graph.symbols, method.symbol.id))
                }
            }
        }
        loop implementation in module_row.impls {
            loop method in implementation.methods {
                if ir_core_method_lowered_by_owner(method.declaration.name) {
                    ^_: name_intern(roots, symbol_table_key(graph.symbols, method.symbol.id))
                }
            }
        }
    }
    roots
}

// ---- JET_KEEP_GOING: the compiler-internal all-phases diagnostic mode ----
// Every failed unit is recorded and replaced by a typed trap so every later
// phase still runs: sema keeps a failed function as a trap of its declared
// signature (SemaRegistrationGraph.keep_going), comptime drops a failed item,
// the optimizer traps every function the failing legality or lint check
// rejects and runs again, and the emitter keeps every failure and finishes
// the text. Each failure is one TSV row (phase, item, code, message, span),
// returned in keep_going_rows and streamed through the trace sink at every
// phase boundary (jet_driver_keep_going_flush), so a later crash keeps it. The
// output is never shipped: the result keeps every error report, so its
// receipt never passes.
JetDriverKeepGoingLog: struct {
    enabled: Bool,
    skip: [String],
    rows: [String],
    // Row bodies (all but the phase) already recorded, so a failure seen by
    // two phases is one row.
    seen: NameTable{name_table_sized(2)},
    // No index mark: each call reads the whole stage list and `seen` keeps
    // one row per report, so a stage that rebuilds or replaces its list
    // still has every error recorded (#5662).
    // Rows before this index are written to the trace sink.
    streamed: Int,
}

jet_driver_keep_going_log: fn(options: JetDriverKeepGoing?) -> JetDriverKeepGoingLog Never! {
    ^log: JetDriverKeepGoingLog{enabled: false, skip: [String]{}, rows: [String]{}, streamed: 0}
    if options == .Val(value) {
        log.enabled = true
        log.skip = value.skip
    }
    log
}

jet_driver_keep_going_field: fn(text: String) -> String {
    text.replace("\t", " ").replace("\n", " | ").replace("\r", "")
}

jet_driver_keep_going_row: fn(kg: ^JetDriverKeepGoingLog, phase: String, item: String, code: String, message: String, span: String) {
    if !kg.enabled {
        return
    }
    body: "{jet_driver_keep_going_field(item)}\t{jet_driver_keep_going_field(code)}\t{jet_driver_keep_going_field(message)}\t{jet_driver_keep_going_field(span)}"
    if name_find(kg.seen, body) != None {
        return
    }
    ^_: name_intern(kg.seen, body)
    kg.rows.push("{phase}\t{body}")
}

// #4319: the registration graph's lookups during `phase` (`counts` less
// `since`) as counter events `counters.<phase>.<counter>`. The host writes
// each to the trace and, with JET_PHASE_COUNTERS set, as a
// `JET_PHASE_COUNTERS` line for Tools/Perf/scaling. The graph counts only
// while a trace is open.
jet_driver_trace_lookup_counters: fn(trace_sink: CompilerTraceSink?, phase: String, counts: SemaLookupCounts, since: SemaLookupCounts) {
    if trace_sink == .Val(sink) {
        sink.progress("counters.{phase}.module_lookups", counts.module_lookups - since.module_lookups, -1)
        sink.progress("counters.{phase}.name_lookups", counts.name_lookups - since.name_lookups, -1)
        sink.progress("counters.{phase}.scope_lookups", counts.scope_lookups - since.scope_lookups, -1)
        sink.progress("counters.{phase}.scope_compares", counts.scope_compares - since.scope_compares, -1)
    }
}

// The comptime stage graph's lookup counts, read through a read parameter so
// the pattern binding borrows the graph (binding it from the owned stage
// would copy every module's AST natively).
jet_driver_stage_lookup_counts: fn(graph: SemaRegistrationGraph?, fallback: SemaLookupCounts) -> SemaLookupCounts {
    if graph == .Val(stage_graph) -> return sema_registration_lookup_counts(stage_graph)
    SemaLookupCounts{module_lookups: fallback.module_lookups, name_lookups: fallback.name_lookups, scope_lookups: fallback.scope_lookups, scope_compares: fallback.scope_compares}
}

// Writes the rows recorded since the last flush to the trace sink.
jet_driver_keep_going_flush: fn(kg: ^JetDriverKeepGoingLog, trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        loop index in kg.streamed..<kg.rows.len() {
            sink.begin("keepgoing", kg.rows[index], index, -1)
            sink.end("keepgoing", 1)
        }
    }
    kg.streamed = kg.rows.len()
}

jet_driver_has_errors_since: fn(diagnostics: [Diagnostic], start: Int) -> Bool Never! {
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR -> return true
    }
    false
}

// The error reports of the stage diagnostics not yet recorded.
jet_driver_keep_going_diagnostics: fn(kg: ^JetDriverKeepGoingLog, phase: String, diagnostics: [Diagnostic]) {
    if !kg.enabled {
        return
    }
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        ^message: diagnostic.what
        if diagnostic.detail == .Val(detail) -> message = "{message}: {detail}"
        path: diagnostic.source_path ?? "-"
        if diagnostic.span == .Val(span) {
            jet_driver_keep_going_row(kg, phase, path, diagnostic.code, message, "{path}:{span.start}..{span.end}")
        } else { jet_driver_keep_going_row(kg, phase, path, diagnostic.code, message, path) }
    }
}

// Why each incomplete module is incomplete (each failed function's label and
// cause), one row per recorded reason.
jet_driver_keep_going_incomplete_modules: fn(kg: ^JetDriverKeepGoingLog, phase: String, modules: [SemaGraphModuleResult]) {
    loop graph_module in modules {
        if graph_module.complete -> next
        if graph_module.incomplete_reasons.len() == 0 {
            jet_driver_keep_going_row(kg, phase, graph_module.module_path, "INCOMPLETE", "incomplete (no recorded cause)", "-")
            next
        }
        loop reason in graph_module.incomplete_reasons {
            jet_driver_keep_going_row(kg, phase, graph_module.module_path, "INCOMPLETE", reason, "-")
        }
    }
}

// The `lower:<name>@<position>` skip entries, each read once into a
// (position, name) pair: the position above the name's spelling id in
// `names`, the way jet_driver_keep_going_trap_lowering probes them.
JetDriverKeepGoingTraps: struct {
    names: NameTable,
    slots: [Int:Bool],
}

jet_driver_keep_going_traps: fn(skip: [String]) -> JetDriverKeepGoingTraps Never! {
    ^traps: JetDriverKeepGoingTraps{names: name_column_table(skip.len()), slots: [Int:Bool]{}}
    loop entry in skip {
        if !entry.starts_with("lower:") -> next
        // `rfind` counts bytes, so the name and position are cut from the bytes.
        at: entry.rfind("@")
        if at <= 6 -> next
        bytes: entry.bytes()
        digits: foundation_byte_text(bytes, at + 1, bytes.len())
        position: Int.parse(digits) ?? next
        if "{position}" != digits -> next
        name: name_intern(traps.names, foundation_byte_text(bytes, 6, at))
        traps.slots[(position << 32) | name_index(name)] = true
    }
    traps
}

// A checked function whose body is one unreachable stop: its signature,
// owner and identity are unchanged, so every caller still lowers.
jet_driver_keep_going_trap_body: fn(function: FnBody, reason: String) -> FnBody Never! {
    ^trapped: function
    // The stop takes an id below every node of the tree, so the rows stay
    // sorted by id with it first; the parameter defaults keep their nodes.
    ^stop_id: TEXPR_FIRST_LOCAL_ID
    if trapped.tree.nodes.len() > 0 && trapped.tree.nodes[0].id <= stop_id {
        stop_id = trapped.tree.nodes[0].id - 1
    }
    ^nodes: [BodyNode]{BodyNode{id: stop_id, kind: NodeKind.Never{reason: reason, line: 0}, span: function.source_span}}
    loop node in trapped.tree.nodes -> nodes.push(node)
    ^types: [TExprType]{TExprType{id: stop_id, ty: TYPE_ID_NEVER}}
    loop row in trapped.tree.expr_types -> types.push(row)
    trapped.tree.nodes = nodes.move()
    trapped.tree.expr_types = types.move()
    trapped.tree.stmts.push(StmtKind.ExprStmt{value: stop_id, span: function.source_span})
    trapped.body = [Int]{trapped.tree.stmts.len() - 1}
    trapped
}

// `lower:<name>@<position>` skip entries: the function at that position of
// the lowering list lowers as a trap.
jet_driver_keep_going_trap_lowering: fn(kg: ^JetDriverKeepGoingLog, functions: ^[FnBody]) {
    traps: jet_driver_keep_going_traps(kg.skip)
    loop position in 0..<functions.len() {
        name: name_find(traps.names, functions[position].name) ?? next
        if traps.slots.get((position << 32) | name_index(name)) == None -> next
        // The report and the trap read the row in place; the slot is written
        // only after the trap row is built, when no view of it is live.
        trap: jet_driver_keep_going_trap_body_row(kg, functions[position], "lowered as a trap: an earlier keep-going run crashed lowering it", "keep-going trap: lowering this function crashed an earlier run")
        functions[position] = trap
    }
}

// Records the census row for a function that lowers as a trap and builds the
// trap. The caller writes the trap into the slot after this returns, when no
// view of the row is live.
jet_driver_keep_going_trap_body_row: fn(kg: ^JetDriverKeepGoingLog, function: FnBody, reason: String, trap_text: String) -> FnBody {
    jet_driver_keep_going_row(kg, "lower", "{function.name} [{function.key}]", "TRAPPED", reason, "{function.source_file}:{function.source_span.start}..{function.source_span.end}")
    jet_driver_keep_going_trap_body(function, trap_text)
}

// Codegen lowers a checked direct call to its callee's checked function or
// to a checked foreign row (`jet_codegen_find_function_row`,
// `jet_codegen_find_checked_foreign_row`); a callee with neither stops it.
// Under JET_KEEP_GOING a function whose check failed and whose own trap did
// not check either (sema_keep_going_push_stub) is such a callee: each of its
// callers lowers as a trap instead, and each is a census row.
jet_driver_keep_going_trap_unresolved_calls: fn(kg: ^JetDriverKeepGoingLog, functions: ^[FnBody], modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable) {
    // Whether each declaration (by DeclID row) has a checked function or
    // foreign row.
    ^targets: (loop _ in 0..<decls.rows.len() -> false)
    loop function in functions {
        if decl_table_find(decls, symbols, function.key) == .Val(id) {
            targets[id.row.index()] = true
        }
    }
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if decl_table_find(decls, symbols, row.key) == .Val(id) {
                targets[id.row.index()] = true
            }
            if decl_table_find_symbol(decls, row.symbol_id) == .Val(id) {
                targets[id.row.index()] = true
            }
        }
    }
    loop position in 0..<functions.len() {
        missing_id: jet_driver_unresolved_direct_call(functions[position], targets) ?? next
        missing: decl_table_key(decls, symbols, missing_id)
        trap: jet_driver_keep_going_trap_body_row(kg, functions[position], "lowered as a trap: it calls `{missing}`, which has no checked function or foreign row", "keep-going trap: this function calls `{missing}`, which did not check")
        functions[position] = trap
    }
}

// The first direct-call callee in `function` (its parameter defaults, then
// its body, each expression before the ones below it) that `targets` does
// not mark.
jet_driver_unresolved_direct_call: fn(function: FnBody, targets: [Bool]) -> DeclID? Never! {
    ^missing: DeclID?{None}
    loop parameter in function.params {
        if parameter.default == Val(value) {
            jet_driver_unresolved_call_in(function.tree, value, targets, missing)
        }
    }
    loop statement in function.body {
        if missing != None -> break
        jet_driver_unresolved_call_statement(function.tree, statement, targets, missing)
    }
    missing
}

// One statement's subtrees. Its own function so the visitor closure lends the
// `missing` write parameter: the stage-0 Rust tier then lends `targets` to the
// closure instead of copying it per statement.
jet_driver_unresolved_call_statement: fn(tree: BodyTree, statement: Int, targets: [Bool], missing: ^DeclID?) Never! {
    body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { jet_driver_unresolved_call_in(tree, child, targets, missing) })
}

// Records in `missing` (once) the first direct-call callee in `expression` or
// below it that `targets` does not mark, read in place.
jet_driver_unresolved_call_in: fn(tree: BodyTree, expression: Int, targets: [Bool], missing: ^DeclID?) Never! {
    if missing != None {
        return
    }
    node: body_node(tree, expression)
    if node.kind == .Call(callee, _, _) {
        if !targets[callee.row.index()] {
            missing = Val(callee)
            return
        }
    }
    body_each_expr_child(tree, node, fn(child: Int) { jet_driver_unresolved_call_in(tree, child, targets, missing) })
}

// A constant's row carries its value, and IR reads a constant through its
// row (ir_constant). Under JET_KEEP_GOING a compile-time value whose
// evaluation failed (a check, a refusal, or its step limit) never lands, so
// its constant has no row: each function that reads it lowers as a trap
// instead, and each is a census row.
jet_driver_keep_going_trap_unvalued_constants: fn(kg: ^JetDriverKeepGoingLog, functions: ^[FnBody], modules: [SemaGraphModuleResult], symbols: SymbolTable) {
    // The keys a constant read resolves by: each constant row's key and
    // symbol key, and each lowered function's key (a function read as a
    // value).
    ^known: name_table_sized(256)
    loop semantic_module in modules {
        loop row in semantic_module.declarations.constants {
            ^_: name_intern(known, row.key)
            if row.symbol_key != "" -> ^_: name_intern(known, row.symbol_key)
        }
    }
    loop function in functions -> ^_: name_intern(known, function.key)
    loop position in 0..<functions.len() {
        missing: jet_driver_unvalued_constant(functions[position], known, symbols) ?? next
        trap: jet_driver_keep_going_trap_body_row(kg, functions[position], "lowered as a trap: it reads `{missing}`, which has no value", "keep-going trap: this function reads `{missing}`, which has no value")
        functions[position] = trap
    }
}

// The key of the first constant `function` reads (its parameter defaults,
// then its body, each expression before the ones below it) that `known` does
// not hold.
jet_driver_unvalued_constant: fn(function: FnBody, known: NameTable, symbols: SymbolTable) -> String? Never! {
    ^missing: String?{None}
    loop parameter in function.params {
        if parameter.default == Val(value) {
            jet_driver_unvalued_constant_in(function.tree, value, known, symbols, missing)
        }
    }
    loop statement in function.body {
        if missing != None -> break
        jet_driver_unvalued_constant_statement(function.tree, statement, known, symbols, missing)
    }
    missing
}

// One statement's subtrees, in its own function for the reason
// jet_driver_unresolved_call_statement gives.
jet_driver_unvalued_constant_statement: fn(tree: BodyTree, statement: Int, known: NameTable, symbols: SymbolTable, missing: ^String?) Never! {
    body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { jet_driver_unvalued_constant_in(tree, child, known, symbols, missing) })
}

// Records in `missing` (once) the key of the first constant read in
// `expression` or below it that `known` does not hold, read in place.
jet_driver_unvalued_constant_in: fn(tree: BodyTree, expression: Int, known: NameTable, symbols: SymbolTable, missing: ^String?) Never! {
    if missing != None {
        return
    }
    node: body_node(tree, expression)
    if node.kind == .ConstRef(symbol) {
        key: if symbol_is_local(symbol) -> symbol_local_keys_text(tree.symbols, symbol) else -> symbol_table_key(symbols, symbol)
        if name_find(known, key) == None {
            missing = Val(key)
            return
        }
    }
    body_each_expr_child(tree, node, fn(child: Int) { jet_driver_unvalued_constant_in(tree, child, known, symbols, missing) })
}

// This retained input is not a RootMemo cache-eligibility proof. All checked
// rows remain in compile.doc_modules; source_modules selects real loaded
// sources and excludes only Loader's explicit ABI-only Core fallback.
JetDriverCheckedProjectionResult: struct {
    compile: JetDriverCompileResult,
    source_modules: [Int],
    entry_module: Int?,
    schema_ingress: JetDriverSchemaIngress?,
    // The entry module's jobs (jet_driver_job_rows): the list a run's
    // unknown-job report (E1294) names.
    job_rows: [JetDriverJobRow]{[JetDriverJobRow]{}},
    // `jet budget`'s checked budget specs (sema_budget_located_specs_graph),
    // in declaration order, each with its source location, and the
    // CompilerFacts its specs measure.
    budget_specs: [JetDriverBudgetSpec]{[JetDriverBudgetSpec]{}},
    budget_facts: JetDriverBudgetFacts{jet_driver_budget_facts_empty()},
}

// One checked budget spec and where it is written: the source file its span
// starts in, and the 1-based line and column there.
JetDriverBudgetSpec: struct {
    spec: BudgetSpec,
    source_path: String,
    line: Int,
    column: Int,
}

// The exact checked front-end facts `jet budget`'s CompilerFacts provider
// measures.
JetDriverBudgetFacts: struct {
    public_api_items: Int,
    dependency_count: Int,
    effect_count: Int,
}

jet_driver_budget_facts_empty: fn() -> JetDriverBudgetFacts Never! {
    JetDriverBudgetFacts{public_api_items: 0, dependency_count: 0, effect_count: 0}
}

// A compile's state once its result is built, which nothing reads again.
// Dropping it as jet_driver_compile_loaded_stages returned walked every row
// of the graphs on one thread: about 3.3 s of the last 3.7 s of the
// self-check (`jet check Compiler/JetCLI`, gate-p45 perf), and the 0.7 s
// `driver.release` span of a hardening build. Under `hold_check_state`
// (JetCLI Host.jet jet_cli_compile_check with `finish`) the check's result
// holds it (JetDriverCompileResult.held) and the host ends the process
// with it still held, so it is never dropped; under `release_state_aside`
// a build, or a check stopped before lowering, drops it on a detached task
// (jet_driver_release_aside).
JetDriverHeldState: struct {
    load: JetDriverLoadResult,
    registration: SemaRegistrationGraph,
    checked: SemaGraphResult,
    functions: [FnBody],
    modules: [SemaGraphModuleResult],
    values: [SemaComptimeItemValue],
    stage: SemaComptimeDeclarationStage,
    run: JetDriverComptimeRunResult,
    trail: SemaGraphTrail,
    // The canonical effect module (JetDriverLoweringInputs), which `modules`
    // leaves out.
    canonical_effect_module_identity: ModuleID,
}

JetDriverCheckedProjectionCapture: struct {
    source_modules: [Int]{[Int]{}},
    entry_module: Int?{None},
    schema_ingress: JetDriverSchemaIngress?{None},
    job_rows: [JetDriverJobRow]{[JetDriverJobRow]{}},
    // `jet_driver_budget_projection`: collect the graph's budget specs.
    budget: Bool{false},
    budget_specs: [JetDriverBudgetSpec]{[JetDriverBudgetSpec]{}},
    budget_facts: JetDriverBudgetFacts{jet_driver_budget_facts_empty()},
    // `jet_driver_lowering_inputs`: stop right before IR lowering and keep its inputs.
    stop_before_lowering: Bool{false},
    lowering_inputs: JetDriverLoweringInputs?{None},
}

// What the slot IR builder reads: the checked functions, after Core pruning
// and keep-going traps; the declaration table their direct calls name; the
// checked modules (declarations, names) beside
// them; the checked source files' text by path (the first file of a path);
// the entry module; the key of the executable entry
// (jet_driver_resolve_entry_key), None for a program without one; the entry
// module's `#Export(c)` rows (jet_driver_c_export_rows), the exports of a
// library, and its jobs (jet_driver_job_rows). A Test
// compile has no entry: it carries the tests and Check
// Outputs its harness runs (jet_driver_test_plan) instead.
JetDriverLoweringInputs: struct {
    functions: [FnBody],
    modules: [SemaGraphModuleResult],
    // The run's declaration table: every direct call's callee is a row.
    decls: DeclTable,
    // The run's symbol table: every SymbolID the functions' bodies name.
    symbols: SymbolTable,
    // The run's unified type and name interner.
    interner: Interner,
    // The checked source files' text (ir_source_texts).
    sources: IRSourceTexts,
    entry_module_identity: ModuleID,
    // The canonical effect module every compile registers and checks afresh
    // (jet_driver_canonical_effect_module): `modules` leaves it out.
    canonical_effect_module_identity: ModuleID,
    // The load's module identities: every ModuleID the rows name.
    module_table: ModuleTable,
    entry_key: String?,
    tests: [TTestFact]{[TTestFact]{}},
    output_checks: [TOutputCheckFact]{[TOutputCheckFact]{}},
    c_exports: [JetDriverCExportRow]{[JetDriverCExportRow]{}},
    // The entry module's jobs (jet_driver_job_rows).
    jobs: [JetDriverJobRow]{[JetDriverJobRow]{}},
    // The checked functions whose `#On(.Deep)` bodies the build emits, by
    // key (jet_driver_deep_checks).
    deep_checks: [String]{[String]{}},
    // The Core library's check (JetDriverCompileRequest.core_seal): the
    // lines of the Core seal (JetSema CoreSeal.jet sema_core_seal_lines).
    core_seal: [String]{[String]{}},
    // The Core library's check: the Core function checks as captured, which
    // the Core library writes as the bodies file (JetSema CoreBodies.jet).
    core_bodies: SemaCoreCaptures{SemaCoreCaptures{bodies: [SemaCoreBody]{}, context: ""}},
    // The program's constant row of each instance of a read each instance
    // answers (JetSema SemaGraphResult.type_reflections).
    type_reflections: [TConstantDef]{[TConstantDef]{}},
}

JetDriverLoweringInputsResult: struct {
    compile: JetDriverCompileResult,
    inputs: JetDriverLoweringInputs?,
}

// The native executable route's front: the ordinary checked compile of
// `request`, stopped right before lowering, with the lowering inputs (None
// when the compile stopped earlier; its result carries the diagnostics).
// `keep_going` (JET_KEEP_GOING) collects every failure of every stage as
// jet_driver_compile_keep_going does, one row each in the result's
// keep_going_rows.
jet_driver_lowering_inputs: fn(request: JetDriverCompileRequest, keep_going: JetDriverKeepGoing?) -> JetDriverLoweringInputsResult {
    ^none: [JetDriverPreloaded]{}
    jet_driver_lowering_inputs_with(request, none, keep_going)
}

jet_driver_lowering_inputs_owned: fn(owned_request: ^^JetDriverCompileRequest, keep_going: JetDriverKeepGoing?) -> JetDriverLoweringInputsResult {
    ^request: owned_request.move()
    ^preloaded: compiler_take_rows<JetDriverPreloaded>(request.preloaded)
    jet_driver_lowering_inputs_with(request, preloaded, keep_going)
}

jet_driver_lowering_inputs_with: fn(request: JetDriverCompileRequest, preloaded: ^[JetDriverPreloaded], keep_going: JetDriverKeepGoing?) -> JetDriverLoweringInputsResult {
    collecting: keep_going != None
    ^kg: jet_driver_keep_going_log(keep_going)
    ^capture: JetDriverCheckedProjectionCapture{stop_before_lowering: true}
    ^compile: jet_driver_compile_stages(request, preloaded, kg, false, capture)
    if collecting {
        jet_driver_trace_keep_going_begin(request.trace_sink)
        if compile.internal_problem == .Val(problem) {
            jet_driver_keep_going_row(kg, "internal", "-", "ICE", problem, "-")
        }
        jet_driver_keep_going_diagnostics(kg, "final", compile.diagnostics)
        compile.keep_going_rows = kg.rows
        jet_driver_trace_keep_going_end(request.trace_sink, compile.keep_going_rows.len())
    }
    JetDriverLoweringInputsResult{compile: compile.move(), inputs: capture.lowering_inputs.move()}
}

// jet_driver_lowering_inputs of `request` with entry file `entry_path`,
// selected function `selected_entry` and `mode`, the build ProgramInfo
// captured when `capture_build_program` and the bundle's build nodes when
// `capture_build_nodes`, failures kept going past as `keep_going` asks; the
// request is restored after.
jet_driver_lowering_inputs_selection: fn(request: ^JetDriverCompileRequest, mode: JetDriverCompileMode, entry_path: ^^String?, selected_entry: ^^String?, capture_build_program: Bool, capture_build_nodes: Bool, keep_going: JetDriverKeepGoing?) -> JetDriverLoweringInputsResult {
    ^saved: JetDriverCompileSelectionRestore{mode: request.mode, capture_build_program: request.capture_build_program, capture_build_nodes: request.capture_build_nodes, entry_path: None, selected_entry: None, restore_selected_entry: false}
    if entry_path.move() == .Val(path) {
        // copy: `saved` keeps the request's original entry path to restore it; the field is
        // overwritten right after (no exchange on a field of a `^` parameter).
        saved.entry_path = Val(request.authorized_sources.entry_path.copy())
        request.authorized_sources.entry_path = path.move()
    }
    if selected_entry.move() == .Val(name) {
        // copy: as the entry path above.
        saved.selected_entry = request.selected_entry.copy()
        saved.restore_selected_entry = true
        request.selected_entry = Val(name.move())
    }
    request.mode = mode
    request.capture_build_program = capture_build_program
    request.capture_build_nodes = capture_build_nodes
    ^result: jet_driver_lowering_inputs(request, keep_going)
    jet_driver_compile_selection_restore(request, saved)
    result
}

// The checked modules' declarations the IR builder reads, in module order,
// moved out of `checked`.
JetDriverCheckedDeclarations: struct {
    type_defs: [TTypeDef],
    impls: [TImplDef],
    constants: [TConstantDef],
    foreign: [SemaCheckedForeignFunction],
}

jet_driver_checked_declarations: fn(checked: ^JetDriverLoweringInputs) -> JetDriverCheckedDeclarations Never! {
    ^type_defs: [TTypeDef]{}
    ^impls: [TImplDef]{}
    ^constants: [TConstantDef]{}
    ^foreign: [SemaCheckedForeignFunction]{}
    loop index in 0..<checked.modules.len() {
        compiler_transfer_rows<TTypeDef>(type_defs, checked.modules[index].declarations.type_defs)
        compiler_transfer_rows<TImplDef>(impls, checked.modules[index].declarations.impls)
        compiler_transfer_rows<TConstantDef>(constants, checked.modules[index].declarations.constants)
        compiler_transfer_rows<SemaCheckedForeignFunction>(foreign, checked.modules[index].foreign_functions)
    }
    compiler_transfer_rows<TConstantDef>(constants, checked.type_reflections)
    JetDriverCheckedDeclarations{type_defs: type_defs.move(), impls: impls.move(), constants: constants.move(), foreign: foreign.move()}
}

// One source-unit classifier for ordinary compilation and retained services.
// ABI-only Core rows still have a catalog unit; their absent source-file bytes
// remain empty. Real Core and private source units keep their actual bytes.
// `release_programs`: each parsed program moves into its input and the loaded
// module keeps an empty one (an ordinary compile reads programs only through
// the registration graph from here on); otherwise the input is a copy.
// `packages` give each module's Module record its package.
jet_driver_registration_module_inputs: fn(
    modules: ^[JetDriverLoadedModule],
    source_units: [JetDriverSourceUnit],
    source_files: [SourceFile],
    packages: [JetDriverPackageInfo],
    providers: [SemaForeignProviderInput],
    diagnostics: ^[Diagnostic],
    core_sources: [JetDriverCoreSource],
    release_programs: Bool,
) -> [SemaRegistrationModuleInput]? {
    ^inputs: [SemaRegistrationModuleInput]{}
    source_positions: jet_driver_source_file_positions(source_files)
    loop loaded_index in 0..<modules.len() {
        // Fields are read through the index: a local binding of the loaded
        // module would copy its whole parsed program.
        unit_index: modules[loaded_index].source_unit_index
        if unit_index < 0 || unit_index >= source_units.len() {
            diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module has no exact source-unit owner", "semantic registration preserves the loader's canonical source-unit identity", "retain the catalog source-unit index returned by JetDriver"))
            return None
        }
        ^unit: source_units[unit_index]
        core_source_alias: jet_driver_core_source_alias(unit, modules[loaded_index], core_sources)
        handles: jet_driver_registration_foreign_handle_facts(modules[loaded_index].module_identity, providers, diagnostics) ?? return None
        // The items, the bulk of a parsed program, move out first so the copy
        // of the rest is small; they then move into the input.
        ^items: [Item]{}
        if release_programs {
            compiler_transfer_rows<Item>(items, modules[loaded_index].program.items)
        }
        ^program: modules[loaded_index].program
        if release_programs -> compiler_transfer_rows<Item>(program.items, items)
        inputs.push(
            SemaRegistrationModuleInput{
                package_identity: modules[loaded_index].package_identity,
                module_identity: modules[loaded_index].module_identity,
                module_name: modules[loaded_index].module_name,
                core_source_alias: core_source_alias,
                module_path: jet_driver_module_display(unit.relative_path),
                declared_module: modules[loaded_index].declared_module,
                source_file: unit.path,
                source_segments: unit.source_segments,
                source_origin: unit.source_origin,
                program: program.move(),
                foreign_handles: handles,
                namespace: modules[loaded_index].namespace,
                namespace_names: modules[loaded_index].namespace_names,
                namespace_private: modules[loaded_index].namespace_private,
                namespace_refs: modules[loaded_index].namespace_refs,
                source: jet_driver_source_text_at(source_files, source_positions, unit.path),
                units_mentions: modules[loaded_index].units_mentions,
                meta: jet_driver_module_meta_source(unit, packages),
            },
        )
    }
    Val(inputs)
}

// A module's file from its package root, its package's manifest facts, which
// its Module record names, and whether `policy.memory` names the file as one
// of the package's kernel files.
jet_driver_module_meta_source: fn(unit: JetDriverSourceUnit, packages: [JetDriverPackageInfo]) -> SemaModuleMetaSource Never! {
    ^meta: SemaModuleMetaSource{file: unit.relative_path.copy()}
    loop package in packages {
        if package.root_index != unit.root_index -> next
        meta.package = SemaModulePackage{name: package.name.copy(), version: package.version ?? "0.0.0", edition: if package.edition == "" -> None else -> Val(package.edition.copy()), log: if package.log_filter == "" -> None else -> Val(package.log_filter.copy())}
        if package.policy_memory_kernel == .Val(kernel) {
            meta.memory_kernel = sema_unsafe_path_within(meta.file, kernel)
        }
        break
    }
    meta
}

// Compiler-internal finalizer over the original completed check. Service
// callers retain these typed inputs before publishing opaque compiler values;
// this path never loads, finalizes, or checks a source for a second time.
jet_driver_project_completed_check: fn(
    request: JetDriverCompileRequest,
    load: ^^JetDriverLoadResult,
    registration: ^^SemaRegistrationGraph,
    graph: SemaGraphResult,
    values: [SemaComptimeItemValue],
    effect_identity: ModuleID,
    schema_ingress: JetDriverSchemaIngress,
    trace: JetDriverCompileTrace,
) -> JetDriverCheckedProjectionResult {
    ^owned_load: load.move()
    ^resolved_registration: registration.move()
    ^capture: JetDriverCheckedProjectionCapture{schema_ingress: Val(schema_ingress)}
    ^compile: if request.mode != JetDriverCompileMode.Program -> {
        jet_driver_compile_internal_result(owned_load, trace, "the retained checked projection requires Program mode")
    } else if !graph.complete || jet_driver_has_errors(owned_load.diagnostics) -> {
        jet_driver_compile_result(owned_load, owned_load.diagnostics, Val(JetDriverStage.Check), false, trace)
    } else -> {
        owned_load.doc_modules = jet_driver_doc_modules(request, owned_load, graph, resolved_registration, values, effect_identity, true, capture)
        if owned_load.doc_modules.len() != owned_load.modules.len() || capture.entry_module == None -> {
            jet_driver_compile_internal_result(owned_load, trace, "the retained checked projection lost its loaded-module ownership bijection or canonical entry")
        } else -> {
            jet_driver_doc_gate_projection(owned_load.doc_modules, graph, resolved_registration, request, owned_load.packages)
            owned_load.doc_interner = Val(resolved_registration.interner.move())
            jet_driver_compile_result(owned_load, owned_load.diagnostics, None, true, trace)
        }
    }
    if !compile.complete {
        capture.source_modules = [Int]{}
        capture.entry_module = None
    }
    JetDriverCheckedProjectionResult{compile: compile.move(), source_modules: capture.source_modules, entry_module: capture.entry_module, schema_ingress: capture.schema_ingress}
}

jet_driver_checked_projection: fn(owned_request: ^^JetDriverCompileRequest) -> JetDriverCheckedProjectionResult {
    ^request: owned_request.move()
    ^preloaded: compiler_take_rows<JetDriverPreloaded>(request.preloaded)
    ^capture: JetDriverCheckedProjectionCapture{}
    ^kg: jet_driver_keep_going_log(None)
    ^compile: jet_driver_compile_stages(request, preloaded, kg, true, capture)
    if !compile.complete {
        capture.source_modules = [Int]{}
        capture.entry_module = None
        capture.job_rows = [JetDriverJobRow]{}
    }
    JetDriverCheckedProjectionResult{compile: compile.move(), source_modules: capture.source_modules, entry_module: capture.entry_module, schema_ingress: capture.schema_ingress, job_rows: capture.job_rows}
}

// `jet budget`'s preflight: the `Check` compile of `request` and, when it
// completes, its checked budget specs. Invalid specs are the compile's
// diagnostics, as a check reports them.
jet_driver_budget_projection: fn(owned_request: ^^JetDriverCompileRequest) -> JetDriverCheckedProjectionResult {
    ^request: owned_request.move()
    ^preloaded: compiler_take_rows<JetDriverPreloaded>(request.preloaded)
    ^capture: JetDriverCheckedProjectionCapture{budget: true}
    ^kg: jet_driver_keep_going_log(None)
    ^compile: jet_driver_compile_stages(request, preloaded, kg, false, capture)
    if !compile.complete -> capture.budget_specs = [JetDriverBudgetSpec]{}
    JetDriverCheckedProjectionResult{compile: compile.move(), source_modules: [Int]{}, entry_module: None, schema_ingress: None, budget_specs: capture.budget_specs, budget_facts: capture.budget_facts}
}

jet_driver_compile: fn(owned_request: ^^JetDriverCompileRequest) -> JetDriverCompileResult {
    ^request: owned_request.move()
    ^preloaded: compiler_take_rows<JetDriverPreloaded>(request.preloaded)
    ^kg: jet_driver_keep_going_log(None)
    ^capture: JetDriverCheckedProjectionCapture{}
    jet_driver_compile_stages(request, preloaded, kg, false, capture)
}

// One ordinary compile, borrowed by staged build queries. The owned command
// entry above still retires its invocation request on completion.
jet_driver_compile_borrowed: fn(request: JetDriverCompileRequest) -> JetDriverCompileResult {
    ^preloaded: [JetDriverPreloaded]{}
    ^kg: jet_driver_keep_going_log(None)
    ^capture: JetDriverCheckedProjectionCapture{}
    ^result: jet_driver_compile_stages(request, preloaded, kg, false, capture)
    result
}

// The probes of the debugger's question `ask` (JetDriverEvalAsk) for the
// registration graph: its text parsed at the stop, in the generated
// coordinates of the module whose source segment holds the asked file's
// byte. None with no question, when no module's source is the asked file,
// or when the text doesn't parse (the debugger reads it first, so it
// reports why).
jet_driver_eval_probes: fn(ask: JetDriverEvalAsk?, inputs: [SemaRegistrationModuleInput]) -> SemaEvalProbes? {
    asked: ask ?? return None
    loop input in inputs {
        at: jet_driver_eval_segment_offset(input.source_segments, asked.path, asked.offset) ?? next
        parsed: sema_eval_probe_parse(asked.text, at)
        expression: parsed.expression ?? return None
        return Val(sema_eval_probes([SemaEvalProbe]{SemaEvalProbe{module_identity: input.module_identity, offset: at, expressions: [Expr]{expression}}}))
    }
    None
}

// The generated offset of byte `offset` of the source file `path` in the
// module whose source segments are `segments`; None when no segment holds
// it.
jet_driver_eval_segment_offset: fn(segments: [SemaSourceSegment], path: String, offset: Int) -> Int? Never! {
    loop segment in segments {
        if !jet_driver_eval_path_matches(segment.source_file, path) || offset < segment.source_start {
            next
        }
        at: segment.generated.start + offset - segment.source_start
        if at < segment.generated.end -> return Val(at)
    }
    None
}

// Whether the source path `source` and the line table's `asked` name one
// file: the same path, or one is the other's trailing components, either
// without its leading `./` and `../` components (a module's source is
// relative to the entry's root, so a path dependency's lies under `../`,
// while the debugger asks by the stop's absolute path).
jet_driver_eval_path_matches: fn(source: String, asked: String) -> Bool Never! {
    plain_source: jet_driver_eval_path_plain(source)
    plain_asked: jet_driver_eval_path_plain(asked)
    plain_source == plain_asked || plain_source.ends_with("/{plain_asked}") || plain_asked.ends_with("/{plain_source}")
}

// `path` without its leading `./` and `../` components.
jet_driver_eval_path_plain: fn(path: String) -> String Never! {
    ^at: 0
    loop {
        rest: path.slice(at..<path.len())
        if {
            rest.starts_with("./") -> at += 2
            rest.starts_with("../") -> at += 3
            else -> break
        }
    }
    path.slice(at..<path.len())
}

#Test("a path dependency's module source beside the entry's root is the asked absolute source") {
    assert(jet_driver_eval_path_matches("../lib/lib.jet", "/work/pkgs/lib/lib.jet"))
    assert(jet_driver_eval_path_matches("Source/Main.jet", "/work/app/Source/Main.jet"))
    assert(jet_driver_eval_path_matches("./prog.jet", "prog.jet"))
    assert(!jet_driver_eval_path_matches("../lib/lib.jet", "/work/pkgs/mylib/lib.jet"))
}

JetDriverCompileSelectionRestore: struct {
    mode: JetDriverCompileMode,
    capture_build_program: Bool,
    capture_build_nodes: Bool,
    entry_path: String?,
    selected_entry: String?,
    restore_selected_entry: Bool,
}

jet_driver_compile_selection_restore: fn(request: ^JetDriverCompileRequest, saved: ^^JetDriverCompileSelectionRestore) Never! {
    request.mode = saved.mode
    request.capture_build_program = saved.capture_build_program
    request.capture_build_nodes = saved.capture_build_nodes
    if saved.entry_path.move() == .Val(path) -> request.authorized_sources.entry_path = path.move()
    if saved.restore_selected_entry -> request.selected_entry = saved.selected_entry.move()
}

jet_driver_compile_selection: fn(request: ^JetDriverCompileRequest, mode: JetDriverCompileMode, entry_path: ^^String?, selected_entry: ^^String?, capture_build_program: Bool, capture_build_nodes: Bool) -> JetDriverCompileResult {
    ^saved: JetDriverCompileSelectionRestore{mode: request.mode, capture_build_program: request.capture_build_program, capture_build_nodes: request.capture_build_nodes, entry_path: None, selected_entry: None, restore_selected_entry: false}
    if entry_path.move() == .Val(path) {
        // copy: `saved` keeps the request's original entry path so it can restore it, and the
        // request's own field is overwritten with `path` right after. Jet has no exchange on a
        // field of a write-borrowed (`^`) parameter.
        saved.entry_path = Val(request.authorized_sources.entry_path.copy())
        request.authorized_sources.entry_path = path.move()
    }
    if selected_entry.move() == .Val(name) {
        // copy: `saved` keeps the request's original selected entry so it can restore it, and the
        // request's own field is overwritten right after. Jet has no exchange on a field of a
        // write-borrowed (`^`) parameter.
        saved.selected_entry = request.selected_entry.copy()
        saved.restore_selected_entry = true
        request.selected_entry = Val(name.move())
    }
    request.mode = mode
    request.capture_build_program = capture_build_program
    request.capture_build_nodes = capture_build_nodes
    ^result: jet_driver_compile_borrowed(request) ?? {
        jet_driver_compile_selection_restore(request, saved)
        return Err(err)
    }
    jet_driver_compile_selection_restore(request, saved)
    result
}

// JET_KEEP_GOING (the CLI reads it): every phase runs past the failures
// before it; each failure is a row of the result's keep_going_rows.
// The result keeps every error report, so a compile with any row never
// passes; a crash later in the run still leaves the rows already streamed to
// the trace sink.
jet_driver_compile_keep_going: fn(owned_request: ^^JetDriverCompileRequest, options: JetDriverKeepGoing) -> JetDriverCompileResult {
    ^request: owned_request.move()
    ^preloaded: compiler_take_rows<JetDriverPreloaded>(request.preloaded)
    ^kg: jet_driver_keep_going_log(Val(options))
    ^capture: JetDriverCheckedProjectionCapture{}
    ^result: jet_driver_compile_stages(request, preloaded, kg, false, capture)
    jet_driver_trace_keep_going_begin(request.trace_sink)
    if result.internal_problem == .Val(problem) {
        jet_driver_keep_going_row(kg, "internal", "-", "ICE", problem, "-")
    }
    // Reports of a stage that returned early; recorded rows are not repeated.
    jet_driver_keep_going_diagnostics(kg, "final", result.diagnostics)
    result.keep_going_rows = kg.rows
    jet_driver_trace_keep_going_end(request.trace_sink, result.keep_going_rows.len())
    result
}

jet_driver_compile_stages: fn(request: JetDriverCompileRequest, preloaded: ^[JetDriverPreloaded], kg: ^JetDriverKeepGoingLog, checked_projection: Bool, capture: ^JetDriverCheckedProjectionCapture) -> JetDriverCompileResult {
    // Phase spans for the host trace (JET_TRACE_FILE). A phase an early
    // return abandons is closed by the next enclosing end the host records.
    // JET_KEEP_GOING and `jet check Core` load every declaration of each
    // loaded Core module, so they check the Core bodies no program calls too;
    // so does a `jet test` of a Core source, so its unit loads with its owner.
    use_driven: !kg.enabled && !request.every_core_body && request.core_tests == ""
    ^load: jet_driver_preloaded_take(preloaded, use_driven) ?? {
        if request.trace_sink == .Val(sink) -> sink.begin("load", "", -1, -1)
        fresh: jet_driver_load_reach(request, use_driven)
        if request.trace_sink == .Val(sink) -> sink.end("load", fresh.modules.len())
        fresh
    }
    // Under `jet check Core`, each Core name of a higher layer's module
    // (E1012). The name still binds, so it reports without stopping the
    // compile, and the check also reports every Core body's errors.
    ^layer_diagnostics: [Diagnostic]{}
    jet_driver_check_core_layers(request, load.source_units, layer_diagnostics)
    // Registration makes a grammar's items from its plan, so the plan of
    // every grammar a module binding declares is computed first, by one
    // compile of those bindings alone, or read from the Core library's
    // record for a Core module (jet_driver_grammar_plans), and each
    // registration of the program (a root `#loop`'s first pass too) takes
    // its module's plans.
    grammar_plans: jet_driver_grammar_plans(request, load)
    // A root `#loop` over a module value computed while building (`#loop
    // row in ROWS` over `ROWS: #run rows()`) waits on that value. A first
    // pass registers the program without such loops and computes the
    // values; the compile proper, from a fresh load, expands the loops over
    // them (JetSema UserTemplates.jet). The first pass's reports and output
    // are dropped: the second computes every value again and reports the
    // program's own, with E0956 for a loop whose value the first could not
    // compute.
    ^loop_values: jet_driver_root_loop_waits(load)
    if loop_values.len() > 0 {
        ^probe_log: jet_driver_keep_going_log(None)
        ^probe_capture: JetDriverCheckedProjectionCapture{}
        probe: jet_driver_compile_loaded_stages(request, probe_log, load, checked_projection, probe_capture, loop_values.move(), grammar_plans.copy(), JetDriverStagesPass.LoopProbe)
        if request.trace_sink == .Val(sink) -> sink.begin("load", "", -1, -1)
        load = jet_driver_load_reach(request, !kg.enabled && !request.every_core_body && request.core_tests == "")
        if request.trace_sink == .Val(sink) -> sink.end("load", load.modules.len())
        // A first pass that stopped before computing the values hands back
        // none: every loop's value is then missing.
        loop_values = probe.root_loop_values.move() ?? jet_driver_root_loop_waits(load)
    }
    ^events: if request.compiler_events -> jet_driver_load_events(load) else -> [CompilerEventRecord]{}
    ^result: jet_driver_compile_loaded_stages(request, kg, load, checked_projection, capture, loop_values, grammar_plans.move(), JetDriverStagesPass.Compile)
    if request.compiler_events {
        finished: jet_driver_finished_event(result)
        loop event in result.events.move() -> events.push(event)
        events.push(finished)
        result.events = events.move()
    }
    loop diagnostic in layer_diagnostics -> result.diagnostics.push(diagnostic)
    // The compile is over: no comptime child may outlive it (Native.jet).
    if request.eval_config.native == .Val(session) -> jet_eval_native_session_close(session)
    jet_driver_trace_released(request.trace_sink)
    result
}

// The module values the root `#loop` declarations of `load` wait on
// (JetSema UserTemplates.jet sema_derive_template_loop_waits), none computed
// yet.
jet_driver_root_loop_waits: fn(load: JetDriverLoadResult) -> [SemaRootLoopValue] {
    ^waits: [SemaRootLoopValue]{}
    loop index in 0..<load.modules.len() {
        names: sema_derive_template_loop_waits(load.modules[index].program.items)
        loop name in names {
            waits.push(SemaRootLoopValue{module_identity: module_text(load.module_table, load.modules[index].module_identity), name: name, value: None})
        }
    }
    waits
}

// The plans of the grammars `load`'s modules declare
// (sema_grammar_declaring_binding), by module and binding; None for a plan
// the batch could not compute. A Core module's plans come from the record
// the Core library's check made of them when the compile is bound to the
// Core built into jet (jet_driver_grammar_recorded). One compile of the
// loaded Core modules and of each declaring module cut down to its declaring
// bindings (jet_driver_grammar_load) evaluates every other declaring literal
// at once, before the program registers; the Core modules whose grammars it
// takes from the record register them from their plans. Its reports are
// dropped: the compile proper checks each literal again and reports its
// faults.
jet_driver_grammar_plans: fn(request: JetDriverCompileRequest, load: JetDriverLoadResult) -> [SemaRootLoopValue] {
    ^waits: jet_driver_grammar_waits(load)
    if waits.len() == 0 || !load.complete || jet_driver_has_errors(load.diagnostics) -> return waits
    if !request.core_seal -> jet_driver_grammar_recorded(request, load, waits)
    ^known: [SemaRootLoopValue]{}
    ^pending: [SemaRootLoopValue]{}
    loop wait in waits.move() {
        if wait.value == None -> pending.push(wait) else -> known.push(wait)
    }
    if pending.len() == 0 -> return known
    if request.trace_sink == .Val(sink) -> sink.begin("grammar", "", -1, -1)
    batch_load: jet_driver_grammar_load(load, pending)
    ^batch_log: jet_driver_keep_going_log(None)
    ^batch_capture: JetDriverCheckedProjectionCapture{}
    // copy: a batch that stops hands back no values, so the result keeps the
    // waits and the known plans the batch's registration takes
    batch: jet_driver_compile_loaded_stages(request, batch_log, batch_load, false, batch_capture, pending.copy(), known.copy(), JetDriverStagesPass.GrammarBatch)
    // A batch that stopped before computing the values hands back none.
    ^raw_plans: batch.root_loop_values.move() ?? pending.move()
    ^plans: [SemaRootLoopValue]{}
    ^landed: 0
    loop entry in raw_plans.move() {
        ^plan: entry
        plan.value = jet_driver_grammar_plan_of(plan.value.move())
        if plan.value != None {
            landed += 1
            if request.trace_sink == .Val(sink) {
                sink.begin("grammar.plan", plan.name, -1, -1)
                sink.end("grammar.plan", 1)
            }
        }
        plans.push(plan)
    }
    if request.trace_sink == .Val(sink) -> sink.end("grammar", landed)
    loop plan in known.move() -> plans.push(plan)
    plans
}

// The grammar-declaring bindings of `load`'s modules, none computed yet.
jet_driver_grammar_waits: fn(load: JetDriverLoadResult) -> [SemaRootLoopValue] {
    ^waits: [SemaRootLoopValue]{}
    loop loaded in load.modules {
        loop item in loaded.program.items {
            if item == .Const(definition) && sema_grammar_declaring_binding(loaded.program.imports, definition) {
                waits.push(SemaRootLoopValue{module_identity: module_text(load.module_table, loaded.module_identity), name: definition.name.copy(), value: None})
            }
        }
    }
    waits
}

// Fills into `waits` the plans of the Core modules' grammars from the record
// the Core library's check made of them, in the bodies file the host lends
// a compile bound to the Core built into jet (JetSema CoreBodies.jet
// sema_core_grammar_plans), each module's as one `grammar.record` span. A
// Core module with no record keeps its waits, which the batch computes.
jet_driver_grammar_recorded: fn(request: JetDriverCompileRequest, load: JetDriverLoadResult, waits: ^[SemaRootLoopValue]) {
    hooks: sema_host_hook_access(request.eval_config.host_hooks)
    loop loaded in load.modules {
        if !module_is_core(loaded.module_identity) -> next
        identity: module_text(load.module_table, loaded.module_identity)
        if !jet_driver_grammar_declares(waits, identity) -> next
        ^plans: sema_core_grammar_plans(hooks, load.module_table, loaded.module_identity) ?? next
        if request.trace_sink == .Val(sink) -> sink.begin("grammar.record", identity, -1, -1)
        ^filled: 0
        loop plan in plans.move() {
            loop index in 0..<waits.len() {
                if waits[index].module_identity == identity && waits[index].name == plan.name {
                    waits[index].value = Val(plan.value.move())
                    filled += 1
                    break
                }
            }
        }
        if request.trace_sink == .Val(sink) -> sink.end("grammar.record", filled)
    }
}

// Whether `waits` holds a binding of the module `identity`.
jet_driver_grammar_declares: fn(waits: [SemaRootLoopValue], identity: String) -> Bool Never! {
    loop wait in waits {
        if wait.module_identity == identity -> return true
    }
    false
}

// `load` cut down to the grammar batch's compile: each loaded Core module
// whole, and each module declaring one of `waits` (the entry too, empty
// when it declares none, so the compile has its entry) holding only those
// bindings and the `use` rows that bind their heads, with the import edges
// of those rows. A Core module that imports a cut one, directly or through
// others, is left out: it names the types the cut module's grammars make,
// which the batch doesn't make. So a Core module that declares a grammar
// must not be imported, directly or through others, by the Prelude or
// `core.grammar`, which the batch needs.
jet_driver_grammar_load: fn(load: JetDriverLoadResult, waits: [SemaRootLoopValue]) -> JetDriverLoadResult {
    ^modules: [JetDriverLoadedModule]{}
    ^kept: [U32:Bool]{}
    ^kept_rows: [U32:[Span]]{}
    cut: jet_driver_grammar_cut_core(load, waits)
    loop loaded in load.modules {
        identity: module_text(load.module_table, loaded.module_identity)
        if module_is_core(loaded.module_identity) && !jet_driver_grammar_declares(waits, identity) {
            if cut.get(loaded.module_identity.id) ?? false -> next
            modules.push(loaded.copy())
            kept[loaded.module_identity.id] = true
            next
        }
        ^items: [Item]{}
        ^heads: [String]{}
        loop item in loaded.program.items {
            if item == .Const(definition) && jet_driver_grammar_waited(waits, identity, definition.name) {
                heads.push(sema_grammar_written_head(definition.value) ?? "")
                items.push(item.copy())
            }
        }
        if items.len() == 0 && loaded.module_identity != load.entry_module_identity -> next
        ^rows: [ImportDecl]{}
        ^spans: [Span]{}
        loop row in loaded.program.imports {
            if row.comptime_span != None -> next
            binds: loop head in heads {
                if sema_grammar_head_target(row, head) != None {
                    break true
                }
            } ?? false
            if binds {
                spans.push(row.span)
                rows.push(row.copy())
            }
        }
        tables: if items.len() == 0 -> ASTTables{} else -> loaded.program.tables.copy()
        program: Program{
            imports: rows.move(),
            items: items.move(),
            script_body: [Stmt]{},
            block_spans: [Span]{},
            fenced_statements: [FencedStatement]{},
            web_target_ceiling: None,
            no_prelude: loaded.program.no_prelude,
            default_target: None,
            html_path: None,
            policy_declarations: [PolicyDeclaration]{},
            user_policy_declarations: [UserPolicyDecl]{},
            applied_rules: [AppliedRuleApplication]{},
            rule_facts: [AppliedRuleApplication]{},
            tables: tables,
        }
        kept[loaded.module_identity.id] = true
        kept_rows[loaded.module_identity.id] = spans.move()
        modules.push(JetDriverLoadedModule{source_unit_index: loaded.source_unit_index, source_identity: loaded.source_identity.copy(), package_identity: loaded.package_identity.copy(), module_identity: loaded.module_identity, module_name: loaded.module_name.copy(), program: program, declared_module: loaded.declared_module.copy()})
    }
    ^imports: [SemaRegistrationImportEdge]{}
    loop edge in load.imports {
        if !(kept.get(edge.target_module_identity.id) ?? false) || !(kept.get(edge.source_module_identity.id) ?? false) {
            next
        }
        // A module kept whole keeps every edge.
        spans: kept_rows.get(edge.source_module_identity.id) ?? {
            imports.push(edge.copy())
            next
        }
        if spans.contains(edge.declaration.span) -> imports.push(edge.copy())
    }
    JetDriverLoadResult{
        package_identity: load.package_identity.copy(),
        packages: load.packages.copy(),
        source_units: load.source_units.copy(),
        entry_source_identity: load.entry_source_identity.copy(),
        entry_module_identity: load.entry_module_identity,
        module_table: load.module_table.copy(),
        modules: modules.move(),
        imports: imports.move(),
        source_files: load.source_files.copy(),
        generated_source_files: load.generated_source_files.copy(),
        diagnostics: [Diagnostic]{},
        failed_stage: None,
        complete: true,
        names: load.names.copy(),
        spells_program: load.spells_program,
        typed_goals: load.typed_goals,
    }
}

// The Core modules the grammar batch leaves out (jet_driver_grammar_load),
// by module id: those that import a Core module declaring one of `waits`,
// directly or through others.
jet_driver_grammar_cut_core: fn(load: JetDriverLoadResult, waits: [SemaRootLoopValue]) -> [U32:Bool] {
    ^declaring: [U32:Bool]{}
    ^cut: [U32:Bool]{}
    ^any: false
    loop loaded in load.modules {
        if module_is_core(loaded.module_identity) && jet_driver_grammar_declares(waits, module_text(load.module_table, loaded.module_identity)) {
            declaring[loaded.module_identity.id] = true
            any = true
        }
    }
    ^grew: any
    loop grew {
        grew = false
        loop edge in load.imports {
            source: edge.source_module_identity.id
            if !module_is_core(edge.source_module_identity) || (cut.get(source) ?? false) || (declaring.get(source) ?? false) {
                next
            }
            target: edge.target_module_identity.id
            if (declaring.get(target) ?? false) || (cut.get(target) ?? false) {
                cut[source] = true
                grew = true
            }
        }
    }
    cut
}

// Whether `waits` holds the binding `name` of the module `identity`.
jet_driver_grammar_waited: fn(waits: [SemaRootLoopValue], identity: String, name: String) -> Bool Never! {
    loop wait in waits {
        if wait.module_identity == identity && wait.name == name -> return true
    }
    false
}

// The plan of a computed `core.grammar.Grammar` value: its `plan` field.
jet_driver_grammar_plan_of: fn(value: ^^CtValue?) -> CtValue? Never! {
    if value == .Val(grammar) && grammar == .Struct(_, fields) {
        ^remaining: fields
        loop remaining.len() > 0 {
            field: remaining.pop() ?? break
            if field.name == "plan" -> return Val(field.value)
        }
    }
    None
}

// The function keys each registration module declares: `modules` binds a
// module id to its row of `keys`, a name table of those keys, only looked
// up.
JetDriverRegisteredKeys: struct {
    modules: [U32:Int],
    keys: [NameTable],
}

// The function keys each registration module declares, by module identity.
jet_driver_registered_function_keys: fn(graph: SemaRegistrationGraph) -> JetDriverRegisteredKeys Never! {
    ^registered: JetDriverRegisteredKeys{modules: [U32:Int]{}, keys: [NameTable]{}}
    loop source_module in graph.modules {
        at: jet_driver_registered_module(registered, source_module.module_identity)
        loop function in source_module.functions {
            _: name_intern(registered.keys[at], symbol_table_key(graph.symbols, function.symbol.id))
        }
        loop nominal in source_module.nominals {
            loop function in nominal.methods {
                _: name_intern(registered.keys[at], symbol_table_key(graph.symbols, function.symbol.id))
            }
        }
        loop implementation in source_module.impls {
            loop function in implementation.methods {
                _: name_intern(registered.keys[at], symbol_table_key(graph.symbols, function.symbol.id))
            }
        }
    }
    registered
}

// The row of `module_identity`'s key set, added empty when it has none.
jet_driver_registered_module: fn(registered: ^JetDriverRegisteredKeys, module_identity: ModuleID) -> Int Never! {
    if registered.modules.get(module_identity.id) == .Val(at) -> return at
    at: registered.keys.len()
    registered.modules[module_identity.id] = at
    registered.keys.push(name_table_sized(64))
    at
}

// Per checked row (graph module order, then function order): an earlier row
// has the same key. Function keys are never empty, so the table's id 0 (the
// empty spelling) never matches one.
jet_driver_checked_repeated_rows: fn(modules: [SemaGraphModuleResult]) -> [Bool] Never! {
    ^seen: name_table()
    ^repeated: [Bool]{}
    loop graph_module in modules {
        loop function in graph_module.functions {
            before: name_count(seen)
            _: name_intern(seen, function.key)
            repeated.push(name_count(seen) == before)
        }
    }
    repeated
}

// How many loaded modules carry each module id.
jet_driver_loaded_identity_counts: fn(modules: [JetDriverLoadedModule]) -> [U32:Int] Never! {
    ^counts: [U32:Int]{}
    loop loaded_module in modules {
        counts[loaded_module.module_identity.id] = (counts.get(loaded_module.module_identity.id) ?? 0) + 1
    }
    counts
}

// Each loaded package's authority, runtime ceiling and edition. The
// organization's denial rides on the root package's row, the row whose
// modules a package denial binds.
jet_driver_registration_package_policies: fn(request: JetDriverCompileRequest, load: JetDriverLoadResult) -> [SemaRegistrationPackagePolicy] {
    ^package_policies: [SemaRegistrationPackagePolicy]{}
    loop package in load.packages {
        root: package.identity == load.package_identity
        package_policies.push(
            SemaRegistrationPackagePolicy{
                package_identity: package.identity,
                authority_allow: package.authority_allow,
                authority_deny: package.authority_deny,
                authority_needs: package.authority_needs,
                runtime_ceiling: package.runtime_ceiling,
                edition: package.edition,
                organization_deny: if root -> request.organization_deny.copy() else -> [String]{},
                organization_source: if root -> request.organization_source.copy() else -> "",
            },
        )
    }
    jet_driver_expert_policies(package_policies, load)
    package_policies
}

// The expert effects each package of `load` names, written onto its row of
// `policies` (one row per loaded package, in load order). The main package
// holds the expert entries of its own `allow` row; a dependency holds only
// those the main package's `authority.grants` line lends it, by the name a
// manifest writes it under, never by its own `allow` row. The denials that
// bind them are the rows' own (sema_effects_check_modules).
jet_driver_expert_policies: fn(policies: ^[SemaRegistrationPackagePolicy], load: JetDriverLoadResult) Never! {
    root_index: jet_driver_entry_package_index(load) ?? return
    root: load.packages[root_index]
    ^names: JetDriverDependencyNames{}
    dependency_count: jet_driver_dependency_roots(load, names)
    loop (index, package) in load.packages {
        if index >= policies.len() -> break
        if index == root_index {
            policies[index].expert_held = root.authority_allow ?? [String]{}
            next
        }
        if dependency_count == 0 -> next
        name: jet_driver_dependency_name(names, package.identity) ?? next
        loop grant in root.authority_grants {
            if grant.package == name -> policies[index].expert_held = grant.rights
        }
        policies[index].grant_name = name.move()
    }
}

// The expert effect that lets compile-time code reach the host: the file
// calls of an `#Impure` block a `#run` value makes.
JET_DRIVER_META_HOST: "Meta.Host"

// The packages of `policies` whose compile-time code may reach the host;
// `main` is the main package's identity. A package may when its expert
// entries (jet_driver_expert_policies) hold `Meta.Host` and no `deny` row
// that binds it covers it: its own, the main package's or the
// organization's. Deny wins.
jet_driver_comptime_host_packages: fn(policies: [SemaRegistrationPackagePolicy], main: String) -> [String] Never! {
    ^out: [String]{}
    loop root in policies {
        if root.package_identity != main -> next
        if authority_covers_any(root.authority_deny ?? [String]{}, JET_DRIVER_META_HOST) || authority_covers_any(root.organization_deny, JET_DRIVER_META_HOST) {
            return out
        }
        loop policy in policies {
            denied: authority_covers_any(policy.authority_deny ?? [String]{}, JET_DRIVER_META_HOST)
            if authority_expert_answer(policy.expert_held, denied, JET_DRIVER_META_HOST) == AuthorityVerdict.Allowed {
                out.push(policy.package_identity)
            }
        }
    }
    out
}

// Whether the compile-time code of the module `module_identity` of `graph`
// may reach the host: its package is one of the graph's
// comptime_host_packages.
jet_driver_comptime_host_module: fn(graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool Never! {
    index: sema_registration_module_index(graph, module_identity) ?? return false
    graph.comptime_host_packages.contains(graph.modules[index].package_identity)
}

// One finalization of the comptime run's `graph`: the bodies, the local
// values landed before the whole-program half (jet_driver_land_local_values),
// the Core demand rounds with the landings between them, and the
// whole-program half. The landings append to `values`, `functions` and
// `trace`; every graph edit is recorded on `trail`.
jet_driver_finalize_program: fn(
    graph: ^^SemaRegistrationGraph,
    trail: ^SemaGraphTrail,
    stage: SemaComptimeDeclarationStage,
    values: ^[SemaComptimeItemValue],
    functions: ^[SemaComptimeFunctionResult],
    trace: ^JetDriverCompileTrace,
    request: JetDriverCompileRequest,
    carried_staging: ^[JetDriverComptimeStaging],
) -> SemaFinalized {
    ^bodies: sema_finalize_bodies_empty()
    body_graph: sema_finalize_bodies(graph, trail, stage, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies)
    ^landing: JetDriverLanding{stopped: false, staging: compiler_take_rows<JetDriverComptimeStaging>(carried_staging)}
    early_graph: jet_driver_land_local_values(body_graph, bodies, SemaLocalSpliceInto.Undemanded, stage, values, functions, trace, request, landing)
    ^demand_graph: sema_finalize_demand(early_graph, trail, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies)
    loop {
        held_functions: functions.len()
        demand_graph = jet_driver_land_local_values(demand_graph, bodies, SemaLocalSpliceInto.Unstamped, stage, values, functions, trace, request, landing)
        demand_graph = sema_finalize_demand(demand_graph, trail, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies)
        if functions.len() == held_functions -> break
    }
    landing.staging = [JetDriverComptimeStaging]{}
    // A traced run whose Core is the built-in one counts how its Core
    // demand's checks split over the Core facts' sealed and excluded keys
    // (sema_core_bound_counters).
    if request.core_bound_keys.len() > 0 || request.core_excluded_keys.len() > 0 {
        sema_core_bound_counters(demand_graph, bodies.modules, functions, request.core_bound_keys, request.core_excluded_keys, request.core_excluded_reasons, request.trace_sink)
    }
    sema_finalize_program(demand_graph, trail, stage, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies)
}

// Which pass of a compile jet_driver_compile_loaded_stages runs. The two
// first passes stop once the module values their waits name are computed,
// handing them back in `root_loop_values`, and their reports are dropped.
JetDriverStagesPass: enum {
    // The compile proper.
    Compile,
    // The first pass of a program whose root `#loop` waits on a module
    // value (jet_driver_compile_stages).
    LoopProbe,
    // The grammar batch (jet_driver_grammar_plans): it checks its cut-down
    // modules only, whatever the request builds, runs or asks.
    GrammarBatch,
}

// The checked front-end stages every compile runs. `owned_loop_values` are
// the module values root `#loop` declarations wait on
// (jet_driver_compile_stages): on a first pass (`pass`) the loops are left
// out and the compile stops once the values are computed, handing them back
// in `root_loop_values`; on the compile proper the loops expand over them.
// `owned_grammar_plans` are the plans of the grammars the modules declare
// (jet_driver_grammar_plans), which registration makes the grammars' items
// from.
jet_driver_compile_loaded_stages: fn(request: JetDriverCompileRequest, kg: ^JetDriverKeepGoingLog, owned_load: ^^JetDriverLoadResult, checked_projection: Bool, capture: ^JetDriverCheckedProjectionCapture, owned_loop_values: ^^[SemaRootLoopValue], owned_grammar_plans: ^^[SemaRootLoopValue], pass: JetDriverStagesPass) -> JetDriverCompileResult {
    loop_probe: pass != JetDriverStagesPass.Compile
    grammar_batch: pass == JetDriverStagesPass.GrammarBatch
    ^load: owned_load.move()
    ^loop_values: owned_loop_values.move()
    grammar_plans: owned_grammar_plans.move()
    ^trace: jet_driver_empty_compile_trace()
    if !load.complete {
        failure: load.failed_stage ?? JetDriverStage.Load
        // A load a package boundary stopped still names the edges its policy
        // decided, for `jet inspect structure`.
        return jet_driver_doc_failure(jet_driver_compile_result(load, load.diagnostics, Val(failure), false, trace), request.mode, Val(load.boundary_facts))
    }
    if checked_projection && request.mode != JetDriverCompileMode.Program {
        return jet_driver_compile_internal_result(load, trace, "the retained checked projection requires Program mode")
    }
    ^canonical_effect_module_option: jet_driver_canonical_effect_module(request.canonical_effects, load.module_table)
    if canonical_effect_module_option == None {
        return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is invalid")
    }
    ^canonical_effect_module: canonical_effect_module_option ?? return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is unavailable")
    canonical_text: module_text(load.module_table, canonical_effect_module.module_identity)
    loop unit in load.source_units {
        if jet_driver_module_identity(unit.package_identity, unit.relative_path) == canonical_text {
            return jet_driver_compile_internal_result(load, trace, "an authorized source unit collides with the pinned compiler-owned Prelude effect identity")
        }
        if unit.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "an authorized source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    loop generated in load.generated_source_files {
        if generated.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "a loaded generated source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    load.generated_source_files.push(SourceFile{id: source_file_id(canonical_effect_module.source_file), path: canonical_effect_module.source_file, source: request.canonical_effects.source})
    // Under `jet debug --build` the compile-time code this compile builds
    // reads its statements' lines from these sources (BuildDebug.jet).
    build_debug_keep_sources(load.source_files)
    ^foreign_provider_inputs: jet_driver_assemble_foreign_providers(request.authorized_sources, load)
    if !load.complete || jet_driver_has_errors(load.diagnostics) {
        failure: load.failed_stage ?? JetDriverStage.Load
        return jet_driver_compile_result(load, load.diagnostics, Val(failure), false, trace)
    }
    if !jet_driver_foreign_provider_owners_valid(load.modules, foreign_provider_inputs, load.diagnostics) {
        return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Load), false, trace)
    }
    if !jet_driver_retain_prelude_modules(load) {
        return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
    }
    jet_driver_unsafe_check(request, load)
    // Every `--set` writer names a declared setting, and every setting's
    // writers agree where the contribution law needs them to
    // (BuildFactChain.jet).
    setting_refusals: jet_driver_setting_writer_diagnostics(load, request)
    if setting_refusals.len() > 0 {
        loop diagnostic in setting_refusals -> load.diagnostics.push(diagnostic)
        return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Load), false, trace)
    }

    ^target_machine_option: jet_driver_selected_target_machine(request, load.diagnostics)
    if target_machine_option == None {
        return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
    }
    target_machine: target_machine_option ?? return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
    // A script's functions take the script variables they name as extra
    // parameters before anything registers them.
    jet_driver_script_helpers(request, load, foreign_provider_inputs, target_machine)

    // Doc and the retained checked projection read the loaded programs again;
    // every other compile hands them to registration.
    release_programs: !(checked_projection || request.mode == JetDriverCompileMode.Doc)
    ^registration_inputs: jet_driver_registration_module_inputs(load.modules, load.source_units, load.source_files, load.packages, foreign_provider_inputs, load.diagnostics, request.core_sources, release_programs) ?? return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Load), false, trace)
    // A compile that reaches Core on demand (jet_driver_load_reach's
    // `use_driven`) leaves Core's casing to the Core library's check.
    if !kg.enabled && !request.every_core_body && request.core_tests == "" {
        loop index in 0..<registration_inputs.len() {
            if module_is_core(registration_inputs[index].module_identity) {
                registration_inputs[index].check_casing = false
            }
        }
    }
    // A root `#loop` that waits on a module value: the first pass leaves it
    // out and keeps the waits, whose values it fills in once computed
    // (registration takes the loaded programs, so the waits can't be read
    // from them again); the second hands each computed value to its module.
    ^probe_waits: [SemaRootLoopValue]{}
    if loop_probe {
        probe_waits = loop_values.move()
        loop_values = [SemaRootLoopValue]{}
        loop index in 0..<registration_inputs.len() {
            registration_inputs[index].loop_values_pending = true
        }
    }
    loop wait in loop_values.move() {
        value: wait.value ?? next
        loop index in 0..<registration_inputs.len() {
            if module_text(load.module_table, registration_inputs[index].module_identity) == wait.module_identity {
                registration_inputs[index].loop_values.push(NamedCtValue{name: wait.name, value: value})
                break
            }
        }
    }
    // Each computed plan goes to the registration of its module.
    loop plan in grammar_plans.move() {
        value: plan.value ?? next
        loop index in 0..<registration_inputs.len() {
            if module_text(load.module_table, registration_inputs[index].module_identity) == plan.module_identity {
                registration_inputs[index].grammar_plans.push(NamedCtValue{name: plan.name, value: value})
                break
            }
        }
    }
    // The graph counts its lookups only while a trace is open.
    ^counting: false
    if request.trace_sink == .Val(sink) {
        sink.begin("register", "", -1, -1)
        counting = true
    }
    ^canonical_effect_module_identity: canonical_effect_module.module_identity
    registration_inputs.push(canonical_effect_module)
    ^registration_module_count: registration_inputs.len()
    package_policies: jet_driver_registration_package_policies(request, load)
    plugin_facts: jet_driver_plugin_facts(request, registration_inputs, load.package_identity)
    ^eval_probes: SemaEvalProbes?{None}
    if !grammar_batch -> eval_probes = jet_driver_eval_probes(request.eval_ask, registration_inputs)
    ^registration_graph: sema_registration_prepare_graph(
        registration_inputs,
        load.imports,
        load.package_identity,
        load.entry_module_identity,
        canonical_effect_module_identity,
        load.module_table.copy(),
        foreign_provider_inputs,
        target_machine,
        jet_driver_build_facts(load, request, target_machine),
        counting,
        request.compiler_threads,
        // The Core library's check records each Core module's derive
        // expansion in its bodies file; a compile its host lends that
        // file to takes the records in place of expanding.
        derive_hooks: if request.core_seal -> None else -> sema_host_hook_access(request.eval_config.host_hooks),
        capture_derives: request.core_seal && !grammar_batch,
        core_marker_laws: request.every_core_body && !grammar_batch,
    )
    if eval_probes != None -> registration_graph.eval_probes = eval_probes
    registration_graph.entry_run_module = load.entry_run_module
    compiler_transfer_rows<StructureFact>(registration_graph.boundary_facts, load.boundary_facts)
    output_intent: if {
        grammar_batch -> SemaOutputIntent.Check
        request.mode == JetDriverCompileMode.Test -> SemaOutputIntent.Test
        else -> request.output_intent
    }
    output_address: if grammar_batch -> None else -> request.output_address.copy()
    output_diagnostics: sema_output_resolve(registration_graph, output_intent, output_address, jet_driver_entry_selection(load) != None)
    loop diagnostic in output_diagnostics -> registration_graph.diagnostics.push(diagnostic)
    if jet_driver_has_errors(output_diagnostics) -> registration_graph.complete = false
    // The legacy `run: fn` contract fails the check without stopping it.
    loop diagnostic in sema_output_legacy_run_contract(registration_graph, output_intent) {
        load.diagnostics.push(diagnostic)
    }
    // Each jet_builtins role is filled once, and every role is filled when
    // all of Core is loaded (`jet check Core`, the Core library's check).
    // A grammar batch cuts out Core modules that declare or import grammars,
    // so full-Core role completeness runs only on the main compile.
    role_problems_from: registration_graph.diagnostics.len()
    role_fill: sema_core_roles_check(registration_graph)
    if request.every_core_body && !grammar_batch {
        sema_core_roles_check_filled(registration_graph, role_fill)
    }
    if registration_graph.diagnostics.len() > role_problems_from {
        registration_graph.complete = false
    }
    if request.trace_sink == .Val(sink) -> sink.end("register", registration_graph.modules.len())
    register_lookups: sema_registration_lookup_counts(registration_graph)
    jet_driver_trace_lookup_counters(request.trace_sink, "register", register_lookups, SemaLookupCounts{module_lookups: 0, name_lookups: 0, scope_lookups: 0, scope_compares: 0})
    if kg.enabled -> registration_graph.keep_going = true
    // Under `jet test` each law of a trait a type of the package implements
    // is a test of that type (TraitLaws.jet).
    if request.mode == JetDriverCompileMode.Test && !grammar_batch {
        registration_graph.test_mode = true
        sema_trait_laws_add(registration_graph)
    }
    registration_graph.plugin_facts = plugin_facts
    registration_graph.comptime_host_packages = jet_driver_comptime_host_packages(package_policies, load.package_identity)
    if request.mode == JetDriverCompileMode.Check && !grammar_batch {
        registration_graph.check_tests = true
    }
    if request.mode == JetDriverCompileMode.Program && !grammar_batch {
        registration_graph.check_root_tests = true
    }
    if checked_projection || request.mode == JetDriverCompileMode.Doc {
        registration_graph.retain_programs = true
    }
    if request.doc_core_on_demand -> registration_graph.retained_core_demand = true
    if (kg.enabled || request.every_core_body) && !grammar_batch {
        registration_graph.every_core_body = true
    }
    if request.core_entry && request.every_core_body && !request.core_seal && !grammar_batch {
        registration_graph.core_own_check = true
    }
    if request.core_seal && !grammar_batch -> registration_graph.core_seal = true
    // A compile that lowers, a Check compile and a `doc_core_on_demand` Doc
    // compile check Core bodies on demand (CoreDemand.jet); JET_KEEP_GOING
    // and `jet check Core` check every body.
    lowers: request.mode == JetDriverCompileMode.Program || request.mode == JetDriverCompileMode.Test || request.mode == JetDriverCompileMode.Eval || request.mode == JetDriverCompileMode.RootRun
    if lowers && !kg.enabled {
        tested: if request.core_tests != "" -> jet_driver_test_modules(load, request.core_tests) else -> [U32:Bool]{}
        registration_graph.core_lowering_roots = Val(jet_driver_core_lowering_roots(registration_graph, tested))
    }
    if registration_graph.internal_problem != None {
        loop diagnostic in registration_graph.diagnostics -> load.diagnostics.push(diagnostic)
        return jet_driver_compile_internal_result(
            load,
            trace,
            registration_graph.internal_problem ?? "canonical effect fact registration failed",
        )
    }
    // An owned trait's defaults that did not parse are jet's own defect: no
    // impl gained them, and no check reports them missing. One census row
    // each, and without `--keep-going` the compile ends here as an internal
    // compiler error.
    unread_defaults: sema_trait_defaults_unread(registration_graph)
    if unread_defaults.len() > 0 {
        ^census: [JetDriverIceRow]{}
        loop line in unread_defaults {
            jet_driver_ice_record(census, "-", "sema.trait-defaults", "parse", line)
        }
        if !kg.enabled {
            return jet_driver_compile_internal_result(load, trace, "this jet's owned-trait defaults do not parse: {jet_driver_ice_text(census)}")
        }
        loop row in census {
            jet_driver_keep_going_row(kg, row.pass, row.function, "ICE", "{row.rule}: {row.message}", "-")
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    // A registration error can leave a name unregistered, so it stops the
    // check here, as does a module the declaration pass left incomplete. A
    // casing error resolves no name differently and never stops it
    // (sema_registration_blocking_error). Any other declaration error goes on
    // with the stage's diagnostics, and the bodies are checked too
    // (sema_check_registration_module_start).
    registration_errors: sema_registration_blocking_error(registration_graph.diagnostics)
    // Under JET_KEEP_GOING the check goes on past such an error; every module
    // row without one keeps its registered facts known
    // (sema_registration_settle_modules).
    if kg.enabled -> sema_registration_settle_modules(registration_graph)
    core_own_check: registration_graph.core_own_check
    if request.trace_sink == .Val(sink) -> sink.begin("sema.check", "", -1, -1)
    ^comptime_stage: sema_collect_comptime_declarations(registration_graph, package_policies, request.compiler_threads, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("sema.check", comptime_stage.modules.len())
    // Every copy of a graph shares one counter set (SemaLookupCounters).
    ^check_lookups: register_lookups
    check_lookups = jet_driver_stage_lookup_counts(comptime_stage.graph, check_lookups)
    jet_driver_trace_lookup_counters(request.trace_sink, "sema.check", check_lookups, register_lookups)
    if kg.enabled {
        // Finalization drops Core's lints (sema_finalize_graph); the stage's own
        // reports land here before it, so they are dropped here too.
        loop diagnostic in comptime_stage.diagnostics {
            if !sema_core_lint_dropped(diagnostic, own_check: core_own_check) {
                load.diagnostics.push(diagnostic)
            }
        }
        jet_driver_keep_going_diagnostics(kg, "sema.check", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(kg, "sema.check", comptime_stage.modules)
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    if (!kg.enabled && (!comptime_stage.complete || registration_errors)) || comptime_stage.modules.len() != registration_module_count {
        if !kg.enabled {
            loop diagnostic in comptime_stage.diagnostics -> load.diagnostics.push(diagnostic)
        }
        ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val(jet_driver_totality_problem("semantic declaration checking did not return a complete resolved package graph ({comptime_stage.modules.len()} of {registration_module_count} modules checked)", "sema.check", comptime_stage.modules, load.module_table))
        }
        return jet_driver_doc_failure(result, request.mode, jet_driver_doc_graph_facts(request.mode, comptime_stage.graph))
    }

    // The stage callees read `load` while they append diagnostics, so the
    // diagnostics list travels beside it and is put back after each stage.
    ^stage_diagnostics: load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime", "", -1, -1)
    // The declaration pass's graph becomes the run's environment graph,
    // and its modules move into the run, which hands them back.
    ^staged_graph: comptime_stage.graph.move()
    comptime_stage.graph = None
    ^run_staged: staged_graph.move() ?? return jet_driver_compile_internal_result(load, trace, "the declaration pass lost its registration graph")
    ^declared_modules: comptime_stage.modules.move()
    comptime_stage.modules = [SemaGraphModuleResult]{}
    ^declared_facts: comptime_stage.graph_facts.move()
    comptime_stage.graph_facts = None
    ^memory_plan: [SemaFunctionMemoryPlan]{}
    jet_driver_comptime_core_first(comptime_stage.sources)
    ^comptime_run: jet_driver_run_comptime(
        run_staged,
        declared_modules,
        declared_facts,
        comptime_stage.sources,
        [SemaComptimeItemValue]{},
        [SemaComptimeFunctionResult]{},
        request,
        stage_diagnostics,
        memory_plan,
    )
    jet_driver_comptime_return_declared(comptime_stage, comptime_run)
    if request.trace_sink == .Val(sink) -> sink.end("comptime", comptime_run.values.len())
    ^comptime_lookups: jet_driver_stage_lookup_counts(comptime_run.partial_graph, check_lookups)
    comptime_lookups = jet_driver_stage_lookup_counts(comptime_run.graph, comptime_lookups)
    jet_driver_trace_lookup_counters(request.trace_sink, "comptime", comptime_lookups, check_lookups)
    load.diagnostics = stage_diagnostics
    trace = comptime_run.trace
    // The first pass of a program whose root `#loop` waits on a module value
    // ends here, handing back the values it computed (jet_driver_compile_stages).
    if loop_probe {
        sema_derive_template_loop_landed(probe_waits, load.module_table, comptime_stage.sources, comptime_run.values)
        ^probed: jet_driver_compile_result(load, load.diagnostics, None, false, trace)
        probed.root_loop_values = Val(probe_waits.move())
        return probed
    }
    // The stage's reports reach the result through finalization; a run that
    // stops first carries them itself, so a declaration's error is never lost.
    if !kg.enabled && (comptime_run.soft_stop || !comptime_run.complete) {
        jet_driver_comptime_diagnostics_add(load.diagnostics, comptime_stage.diagnostics)
    }
    if comptime_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(kg, "comptime", load.diagnostics)
        if !comptime_run.complete {
            jet_driver_keep_going_row(kg, "comptime", "-", "INCOMPLETE", comptime_run.internal_problem ?? "comptime execution did not complete; the staged values so far are kept", "-")
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    if !comptime_run.complete && !kg.enabled {
        ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Comptime), false, trace)
        if {
            comptime_run.internal_problem != None -> {
                result.internal_problem = comptime_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val("comptime execution did not complete with a value, control result, or user diagnostic")
            }
        }
        ^stage_facts: jet_driver_doc_graph_facts(request.mode, comptime_run.graph)
        if stage_facts == None {
            stage_facts = jet_driver_doc_graph_facts(request.mode, comptime_run.partial_graph)
        }
        return jet_driver_doc_failure(result, request.mode, stage_facts)
    }
    if request.trace_sink == .Val(sink) -> sink.begin("sema.finalize", "", -1, -1)
    // A completed run's graph already carries its values: finalization takes
    // it in place. After any other exit (JET_KEEP_GOING) the run's edits are
    // undone and every value applied again, which is
    // sema_comptime_graph_with_values of the registration graph.
    ^trail: comptime_run.trail.move()
    comptime_run.trail = sema_graph_trail_init()
    ^run_graph: comptime_run.graph.move()
    comptime_run.graph = None
    if run_graph == None {
        ^partial_graph: comptime_run.partial_graph.move()
        comptime_run.partial_graph = None
        ^restored: partial_graph.move() ?? return jet_driver_compile_internal_result(load, trace, "the staged comptime environment lost its registration graph")
        sema_graph_trail_undo(restored, trail)
        sema_comptime_graph_apply_values(restored, comptime_run.values, trail)
        run_graph = Val(restored.move())
    }
    ^finalize_graph: run_graph.move() ?? return jet_driver_compile_internal_result(load, trace, "the staged comptime environment lost its registration graph")
    // The name facts are built once, over the modules the checked-text merge
    // below completes; finalization leaves them out. The body comptime passes
    // of local values land in its modules before its whole-program half
    // (jet_driver_land_local_values), so that half runs once: the user
    // bodies' sites before its Core demand, which then reads them as the full
    // recheck's does, and the sites of the Core bodies each round of that
    // demand checks before the next round, which demands what the landed
    // closures name, as the full recheck's same round does
    // (sema_core_demand_waves). JET_RECHECK_VERIFY finalizes the landed
    // values again, from the codec and derive demand this finalization
    // starts from.
    ^verify_start: SemaLocalSpliceDemand?{None}
    if request.recheck_verify {
        verify_start = Val(sema_local_splice_demand_snapshot(finalize_graph))
    }
    // A `jet run` program that may bind to the built-in Core image, whose
    // host hooks hold the image's Core seal (SemaRegistrationHostHooks
    // .core_seal), checks the Core functions its demand reaches as stand-ins
    // of the seal's rows (JetSema CoreSeal.jet), read once the demand first
    // names a deferred Core body (JetSema CoreDemand.jet
    // sema_core_stand_in_bind). When the finalization reports why a stand-in
    // will not do (SemaGraphResult.core_stand_in_rerun), its edits, its
    // demand, the values it landed and the trace they printed go back to
    // where it started, and it runs again over the Core bodies themselves.
    finalize_graph.core_seal_pending = sema_core_seal_offered(sema_host_hook_access(request.eval_config.host_hooks))
    ^rerun_start: SemaLocalSpliceDemand?{None}
    if finalize_graph.core_seal_pending {
        rerun_start = Val(sema_local_splice_demand_snapshot(finalize_graph))
    }
    finalize_mark: trail.entries.len()
    staged_values: comptime_run.values.len()
    staged_functions: comptime_run.functions.len()
    printed_stdout: trace.stdout.len()
    printed_stderr: trace.stderr.len()
    printed_debug_trace: trace.debug_trace.len()
    printed_soft_stop: trace.soft_stop
    printed_exit_code: trace.exit_code
    ^finalized: jet_driver_finalize_program(finalize_graph, trail, comptime_stage, comptime_run.values, comptime_run.functions, trace, request, comptime_run.carried_staging)
    if finalized.result.core_stand_in_rerun != "" {
        ^rerun_graph: finalized.graph.move()
        start: rerun_start.move() ?? return jet_driver_compile_internal_result(load, trace, "the Core stand-in finalization lost the demand it started from")
        sema_graph_trail_undo_to(rerun_graph, trail, finalize_mark)
        ^_: sema_local_splice_demand_swap(rerun_graph, start)
        rerun_graph.core_seal_pending = false
        rerun_graph.core_stand_ins = None
        loop comptime_run.values.len() > staged_values -> ^_: comptime_run.values.pop()
        loop comptime_run.functions.len() > staged_functions -> ^_: comptime_run.functions.pop()
        loop trace.stdout.len() > printed_stdout -> ^_: trace.stdout.pop()
        loop trace.stderr.len() > printed_stderr -> ^_: trace.stderr.pop()
        loop trace.debug_trace.len() > printed_debug_trace -> ^_: trace.debug_trace.pop()
        trace.soft_stop = printed_soft_stop
        trace.exit_code = printed_exit_code
        ^rerun_staging: [JetDriverComptimeStaging]{}
        finalized = jet_driver_finalize_program(rerun_graph, trail, comptime_stage, comptime_run.values, comptime_run.functions, trace, request, rerun_staging)
    }
    ^checked_graph: finalized.result.move()
    if request.trace_sink == .Val(sink) -> sink.end("sema.finalize", checked_graph.modules.len())
    if checked_graph.modules.len() != registration_module_count {
        loop diagnostic in checked_graph.diagnostics -> load.diagnostics.push(diagnostic)
        ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val("semantic finalization did not return every registered module")
        }
        return jet_driver_doc_failure(result, request.mode, jet_driver_doc_graph_facts(request.mode, Val(finalized.graph.move())))
    }
    // Finalization returns the same graph; undo the staged edits before
    // subsequent passes read the registration facts.
    registration_graph = finalized.graph.move()
    sema_graph_trail_undo(registration_graph, trail)
    // The lookup counters were last read for `comptime`; the undo restored
    // the counting flag, and every later pass (the pre-lowering threads)
    // would serialize on the shared counters' permit.
    registration_graph.counting = false
    registration_graph.core_seal_pending = false
    // The Core seal whose stand-ins the finalization checked (None when it
    // ran over the Core bodies themselves): JET_RECHECK_VERIFY's
    // finalization stands in the same Core functions.
    ^stand_ins: registration_graph.core_stand_ins.move()
    registration_graph.core_stand_ins = None
    if request.recheck_verify && comptime_run.values.len() > staged_values {
        ^start: verify_start.move() ?? return jet_driver_compile_internal_result(load, trace, "JET_RECHECK_VERIFY lost the demand the finalization started from")
        ^verify_problem: String?{None}
        registration_graph = jet_driver_verify_landed_values(registration_graph, comptime_stage, checked_graph, comptime_run.values, comptime_run.functions, start, stand_ins, request, verify_problem)
        if verify_problem == .Val(problem) {
            return jet_driver_compile_internal_result(load, trace, problem)
        }
    }
    schema_check: jet_driver_check_schema_migrations(request, registration_graph, checked_graph, checked_projection)
    registration_graph = schema_check.registration.move()
    capture.schema_ingress = schema_check.ingress
    loop diagnostic in schema_check.diagnostics -> load.diagnostics.push(diagnostic)
    // A comptime evaluation reads the name facts: they are built for it first.
    if jet_driver_comptime_reads_names(checked_graph, comptime_run.values) {
        registration_graph = jet_driver_merged_names(checked_graph, registration_graph, request.compiler_threads)
    }
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.bodies", "", -1, -1)
    ^body_run: jet_driver_orchestrate_comptime_bodies(
        registration_graph,
        comptime_stage,
        checked_graph,
        comptime_run.values.move(),
        comptime_run.functions.move(),
        trace,
        load,
        request,
        stage_diagnostics,
    )
    // The body recheck moved the run's values, closures and trace in and
    // returns them as its own.
    trace = body_run.trace.move()
    if request.trace_sink == .Val(sink) -> sink.end("comptime.bodies", body_run.values.len())
    load.diagnostics = stage_diagnostics
    comptime_run.values = [SemaComptimeItemValue]{}
    comptime_run.functions = [SemaComptimeFunctionResult]{}
    ^returned_registration: body_run.registration.move()
    body_run.registration = None
    registration_graph = returned_registration.move() ?? return jet_driver_compile_internal_result(load, trace, "comptime body rechecking lost the registration graph")
    if body_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(kg, "comptime.bodies", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(kg, "comptime.bodies", body_run.graph.modules)
        if body_run.internal_problem == .Val(problem) {
            jet_driver_keep_going_row(kg, "comptime.bodies", "-", "INCOMPLETE", problem, "-")
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    if !body_run.complete && !kg.enabled {
        ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
        if {
            body_run.internal_problem != None -> {
                result.internal_problem = body_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val(jet_driver_totality_problem("semantic body rechecking did not return a complete resolved package graph", "sema.body", body_run.graph.modules, load.module_table))
            }
        }
        return jet_driver_doc_failure(result, request.mode, Val(body_run.graph.names.structure_facts))
    }
    checked_graph = body_run.graph.move()
    ^comptime_values: body_run.values.move()
    body_run.values = [SemaComptimeItemValue]{}
    ^comptime_functions: body_run.functions.move()
    body_run.functions = [SemaComptimeFunctionResult]{}

    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.validate", "", -1, -1)
    ^validation: jet_driver_validate_checked_text(
        registration_graph,
        comptime_stage,
        checked_graph,
        comptime_values,
        comptime_functions,
        trace,
        load,
        request,
        stage_diagnostics,
    )
    if request.trace_sink == .Val(sink) -> sink.end("comptime.validate", validation.values.len())
    load.diagnostics = stage_diagnostics
    ^validated_registration: validation.registration.move()
    validation.registration = None
    registration_graph = validated_registration.move() ?? return jet_driver_compile_internal_result(load, trace, "checked text validation lost the registration graph")
    trace = validation.trace
    if validation.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(kg, "comptime.validate", load.diagnostics)
        // The final checked graph: a trap installed by validation's own
        // recheck is a row too (#5662); reasons already recorded stay one row.
        jet_driver_keep_going_incomplete_modules(kg, "comptime.validate", validation.graph.modules)
        if !validation.complete {
            jet_driver_keep_going_row(kg, "comptime.validate", "-", "INCOMPLETE", validation.internal_problem ?? "checked text evaluation did not complete", "-")
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    if !validation.complete && !kg.enabled {
        ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Comptime), false, trace)
        result.internal_problem = validation.internal_problem
        if result.internal_problem == None && !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val("checked text evaluation did not return a complete validation or diagnostic")
        }
        return jet_driver_doc_failure(result, request.mode, Val(validation.graph.names.structure_facts))
    }
    checked_graph = validation.graph.move()
    comptime_values = validation.values.move()
    validation.values = [SemaComptimeItemValue]{}
    comptime_functions = validation.functions.move()
    validation.functions = [SemaComptimeFunctionResult]{}
    // A Core library record this compile did not read was checked or
    // expanded from its text instead, with the result the record holds, and
    // is still jet's own defect: one census row each, and without
    // `--keep-going` the compile ends as an internal compiler error once
    // checking is done.
    unread_records: sema_core_bodies_unread(registration_graph, sema_host_hook_access(request.eval_config.host_hooks))
    if unread_records.len() > 0 {
        ^census: [JetDriverIceRow]{}
        loop line in unread_records {
            jet_driver_ice_record(census, "-", "sema.core-bodies", "record", line)
        }
        if !kg.enabled {
            return jet_driver_compile_internal_result(load, trace, "this jet's Core bodies part does not read whole: {jet_driver_ice_text(census)}")
        }
        loop row in census {
            jet_driver_keep_going_row(kg, row.pass, row.function, "ICE", "{row.rule}: {row.message}", "-")
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    if request.compiler_events {
        loop event in jet_driver_checked_events(checked_graph, registration_graph.symbols) {
            trace.events.push(event)
        }
    }
    if request.capture_build_nodes && checked_graph.complete && !jet_driver_has_errors(load.diagnostics) {
        jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.build_nodes")
        load.build_nodes = jet_driver_build_compiler_nodes(request, load, checked_graph, canonical_effect_module_identity)
        jet_driver_trace_step_end(request.trace_sink, "driver.prelower.build_nodes", -1)
        if load.build_nodes == None {
            return jet_driver_compile_internal_result(load, trace, "the final checked build bundle lost its exact source bytes or node identity")
        }
    }
    // A Comptime compile ends with its evaluated build-time values; nothing
    // is lowered or emitted for run time.
    if request.mode == JetDriverCompileMode.Comptime {
        ^failed: JetDriverStage?{None}
        if jet_driver_has_errors(load.diagnostics) -> failed = Val(JetDriverStage.Check)
        ^result: jet_driver_compile_result(load, load.diagnostics, failed, failed == None, trace)
        result.comptime_values = comptime_values
        return result
    }
    // The merge reads unchanged registration name facts. The bundle's names
    // are built from the merged modules only for the steps below that read
    // them (the checked projection, `jet doc`'s pages and ledger, the build
    // program's reflection); a run, build or test lowers without them, and
    // so does the runtime-library seam (`jet doc` stopped before lowering:
    // Request.jet jet_cli_runtime_library), which packages the lowering
    // inputs and builds no pages. Declaration
    // consumers below apply values only when they need the resolved graph.
    // The build program's reflection is snapshotted only when a source
    // outside Core spells `program` or `compiler`, the only names its
    // readers can use, or when the compile's caller reads it itself.
    reflect_program: request.capture_build_program && (load.spells_program || request.read_build_program)
    doc_pages: request.mode == JetDriverCompileMode.Doc && !capture.stop_before_lowering
    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.merge")
    merged: jet_driver_merge_checked_text_functions(checked_graph, registration_graph.module_table, comptime_functions)
    if checked_projection || doc_pages || reflect_program {
        registration_graph = jet_driver_merged_names(checked_graph, registration_graph, request.compiler_threads)
    }
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.merge", comptime_functions.len())
    if merged == .Val(problem) {
        if !kg.enabled -> return jet_driver_compile_internal_result(load, trace, problem)
        jet_driver_keep_going_row(kg, "comptime.validate", "-", "ICE", problem, "-")
    }
    // The merge was the staged closures' last reader.
    comptime_functions = [SemaComptimeFunctionResult]{}
    // A check whose bodies hold `#Todo` goals says so, so `jet check` can print
    // each goal card from a Doc projection.
    if request.mode == JetDriverCompileMode.Check {
        load.typed_goals = jet_driver_has_typed_goals(checked_graph.modules)
    }
    if jet_driver_timing_target_refusal(load, checked_graph.modules, registration_graph.target_machine) == .Val(refusal) {
        load.diagnostics.push(refusal)
    }
    if checked_projection {
        capture.job_rows = jet_driver_job_rows(registration_graph, load.entry_module_identity)
        ^resolved_registration: sema_comptime_graph_with_values(registration_graph, comptime_values)
        schema_ingress: capture.schema_ingress ?? return jet_driver_compile_internal_result(load, trace, "the retained checked projection lost its actual schema input")
        ^retained: jet_driver_project_completed_check(request, load, resolved_registration, checked_graph, comptime_values, canonical_effect_module_identity, schema_ingress, trace)
        capture.source_modules = retained.source_modules.move()
        capture.entry_module = retained.entry_module
        capture.schema_ingress = retained.schema_ingress.move()
        return retained.compile.move()
    }
    if request.mode == JetDriverCompileMode.Doc {
        ^resolved_registration: sema_comptime_graph_with_values(registration_graph, comptime_values)
        if doc_pages {
            load.doc_modules = jet_driver_doc_modules(request, load, checked_graph, resolved_registration, comptime_values, canonical_effect_module_identity, false, capture)
            if request.capture_gate_ledger {
                jet_driver_doc_gate_projection(load.doc_modules, checked_graph, resolved_registration, request, load.packages)
            }
        }
        registration_graph = resolved_registration.move()
    }
    // No source outside Core names the view, so no body can read it: the
    // Build context carries an empty one and nothing is snapshotted.
    if request.capture_build_program && !reflect_program {
        load.build_program = Val(jet_eval_compiler_services_program_unread())
    }
    if reflect_program {
        jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.build_program")
        ^resolved_registration: sema_comptime_graph_with_values(registration_graph, comptime_values)
        ^module_sources: [SemaCompilerModuleSource]{}
        source_positions: jet_driver_source_file_positions(load.source_files)
        loop source_module in load.modules {
            unit: load.source_units[source_module.source_unit_index]
            module_sources.push(SemaCompilerModuleSource{module_identity: source_module.module_identity, source: jet_driver_source_text_at(load.source_files, source_positions, unit.path)})
        }
        module_sources.push(SemaCompilerModuleSource{module_identity: canonical_effect_module_identity, source: request.canonical_effects.source})
        // Under keep-going each failed function checked as a trap of its
        // declared signature, so the program's declarations are whole: the
        // staging build of a program that uses what `build: fn` generates
        // (jet_driver_query_build_plan) reads them before generation.
        graph_complete: checked_graph.complete
        if kg.enabled -> checked_graph.complete = true
        ^stages: jet_driver_stages(load, checked_graph, resolved_registration.symbols)
        info: jet_eval_compiler_services_program_info(resolved_registration, checked_graph, jet_driver_source_text_at(load.source_files, source_positions, request.authorized_sources.entry_path), module_sources, checked_complete: graph_complete, stages: stages.move())
        checked_graph.complete = graph_complete
        registration_graph = resolved_registration.move()
        jet_driver_trace_step_end(request.trace_sink, "driver.prelower.build_program", module_sources.len())
        // A program whose own errors left its graphs incomplete (a derive
        // refused while registering, say) has no whole view to reflect: those
        // errors are the answer. A view missing anything else is a compiler
        // defect.
        if info == {
            .Ready(value, types) -> {
                load.build_program = Val(value)
                load.build_types = Val(types)
            }
            .Missing(fact) -> {
                if (!registration_graph.complete || !graph_complete) && jet_driver_has_errors(load.diagnostics) {
                    return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
                }
                return jet_driver_compile_internal_result(load, trace, "the checked build program reflection snapshot is incomplete: {fact}")
            }
        }
    }
    if request.mode == JetDriverCompileMode.Eval {
        selected_name: request.selected_entry ?? "run"
        key: symbol_key_text(SymbolKind.Function, module_text(load.module_table, load.entry_module_identity), "", selected_name)
        loop diagnostic in check_pure_program_root(key, checked_graph.modules, registration_graph.decls, registration_graph.symbols) {
            load.diagnostics.push(diagnostic)
        }
    }

    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.owners")
    // Every checked function moves out of its graph module into one list, so
    // the checked bodies are resident once from here on: the rows return to their
    // modules after lowering for the entry and foreign lookups
    // (jet_driver_restore_checked_functions) and are released after those.
    ^checked_functions: [FnBody]{}
    // Per row of `checked_functions`: false for a repeated key that
    // JET_KEEP_GOING leaves unlowered.
    ^lowering_candidates: [Bool]{}
    ^repeated_rows: [Bool]{}
    ^registered_function_keys: if compiler_threads_admit(request.compiler_threads, checked_graph.modules.len(), checked_graph.modules.len(), 32, 0, 0) > 1 -> {
        ^out: [JetDriverRegisteredKeys]{}
        task.group driver_prelower_owners_index {
            reg_task: task jet_driver_registered_function_keys(registration_graph)
            repeated_rows = jet_driver_checked_repeated_rows(checked_graph.modules)
            out.push(compiler_threads_joined(reg_task))
        }
        compiler_threads_taken(out)
    } else -> {
        repeated_rows = jet_driver_checked_repeated_rows(checked_graph.modules)
        jet_driver_registered_function_keys(registration_graph)
    }
    ^loaded_identity_counts: jet_driver_loaded_identity_counts(load.modules)
    ^checked_row: 0
    ^failed_stage: JetDriverStage?{None}
    ^runtime_semantic_modules: [SemaGraphModuleResult]{}
    // Nothing past sema reads the modules' call, name and copy facts: they
    // move out before the runtime copies below and, when the build releases
    // its state aside, drop off this thread (jet_driver_release_facts_aside)
    // while lowering and the IR build go on.
    ^aside_functions: 0
    if request.release_state_aside {
        loop graph_module in checked_graph.modules {
            aside_functions += graph_module.functions.len()
        }
    }
    released_facts: sema_graph_modules_take_checked_facts(checked_graph.modules)
    jet_driver_release_facts_aside(aside_functions, released_facts)
    ^bad_owners: if compiler_threads_admit(request.compiler_threads, checked_graph.modules.len(), checked_graph.modules.len(), 32, 0, 0) > 1 -> jet_driver_verify_owners_parallel(checked_graph.modules, registered_function_keys, request.compiler_threads) else -> jet_driver_verify_owners_chunk(checked_graph.modules, registered_function_keys, 0, checked_graph.modules.len())
    ^bad_cursor: 0
    ^total_checked: repeated_rows.len()
    checked_functions.try_reserve(total_checked) ?? ()
    lowering_candidates.try_reserve(total_checked) ?? ()
    loop graph_module_index in 0..<checked_graph.modules.len() {
        ^module_functions: [FnBody]{}
        compiler_transfer_rows<FnBody>(module_functions, checked_graph.modules[graph_module_index].functions)
        // The module carries no functions now, nor the facts only sema reads,
        // so the runtime copy below holds only its declarations and foreign
        // rows.
        graph_module: checked_graph.modules[graph_module_index]
        if graph_module.module_identity != canonical_effect_module_identity {
            runtime_semantic_modules.push(graph_module.copy())
            module_matches: loaded_identity_counts.get(graph_module.module_identity.id) ?? 0
            if module_matches != 1 {
                load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a semantic module does not map to exactly one loaded source identity", "source, package, and module identities remain attached across graph registration", "retain the loader's exact module identity in each semantic result"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
            }
        }
        loop function_index in 0..<module_functions.len() {
            if bad_cursor < bad_owners.len() && bad_owners[bad_cursor].module_index == graph_module_index && bad_owners[bad_cursor].function_index == function_index {
                load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", module_functions[function_index].source_span, "a checked function lost its canonical module or symbol identity", "cross-module call resolution and IR IDs use exact declaration identities", "preserve module_identity and the original function SymbolId through Sema"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
                bad_cursor += 1
            }
            repeated: repeated_rows[checked_row]
            checked_row += 1
            if repeated {
                load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", module_functions[function_index].source_span, "two checked functions share one canonical symbol key", "every lowered function identity names exactly one declaration in the package graph", "report the duplicate Sema function key"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
                // JET_KEEP_GOING: the first function of a key lowers.
                if kg.enabled {
                    lowering_candidates.push(false)
                    next
                }
            }
            lowering_candidates.push(true)
        }
        compiler_transfer_rows<FnBody>(checked_functions, module_functions)
    }
    // Every checked function has its owner now.
    registered_function_keys = JetDriverRegisteredKeys{modules: [U32:Int]{}, keys: [NameTable]{}}
    loaded_identity_counts = [U32:Int]{}
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.owners", checked_row)
    // E0601 only when neither named tests nor selected Check Outputs exist,
    // and the compile doesn't make tests optional.
    if request.mode == JetDriverCompileMode.Test && !request.tests_optional && jet_driver_runnable_test_count(registration_graph) == 0 {
        load.diagnostics.push(jet_driver_diagnostic_without_span("E0601", "no `#Test` blocks found to run", "add at least one top-level block: #Test(\"describes what this checks\") {{ ... }}", "use `assert` and `assert_eq` inside the block to check results"))
    }
    ^deep_kept: jet_driver_deep_checks(load, checked_functions, request.deep_checks)
    loop diagnostic in deep_kept.diagnostics.move() -> load.diagnostics.push(diagnostic)
    if jet_driver_has_errors(load.diagnostics) {
        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
    }
    if failed_stage != None && !kg.enabled {
        return jet_driver_doc_failure(jet_driver_compile_result(load, load.diagnostics, failed_stage, false, trace), request.mode, Val(checked_graph.names.structure_facts))
    }
    // A check and a program compile list the tidy errors the driver finds
    // over the checked functions: `jet check` and `jet build` fail on them,
    // and `jet run` and `jet dev` never stop for one. These are the L0305
    // functions whose every path calls them again (Recursion.jet), the L0306
    // Float bindings seeded with infinity that only ever take Int values
    // (FloatSeed.jet), the L0308 SELECTs run once per row of a loop over
    // database rows (SQLRowLoop.jet)
    // and, unless a check keeps its cost report and lists its L2510 lints
    // instead (below), the L2511 hidden copies and uncapped Int growth a loop
    // repeats (CostQueries.jet). One inside a site `#Allow` for it is the
    // author's recorded decision, as for sema's lints (LintAllowances.jet).
    if request.mode == JetDriverCompileMode.Check || request.mode == JetDriverCompileMode.Program {
        jet_driver_run_tidy_lints(load, checked_functions, registration_graph, !request.capture_cost_report, request.compiler_threads, request.trace_sink)
    }
    // `jet check` stops before lowering: no C export rows, no Core
    // reachability pruning. The entry resolves over every checked function
    // (pruning only drops unreached Core bodies, never a user entry), and the
    // foreign facts check realizes come from the same graphs.
    if request.mode == JetDriverCompileMode.Check {
        // JET_KEEP_GOING has no lowering to keep going into here.
        if failed_stage != None {
            return jet_driver_compile_result(load, load.diagnostics, failed_stage, false, trace)
        }
        jet_driver_trace_step_begin(request.trace_sink, "driver.check.entry")
        ^entry_diagnostics: load.diagnostics
        load.diagnostics = [Diagnostic]{}
        ^check_entry: jet_driver_resolve_entry_key(load, registration_graph.module_table, checked_graph, checked_functions, runtime_semantic_modules, entry_diagnostics)
        load.diagnostics = entry_diagnostics
        jet_driver_trace_step_end(request.trace_sink, "driver.check.entry", -1)
        if jet_driver_has_errors(load.diagnostics) {
            return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Assemble), false, trace)
        }
        if check_entry == .Val(budget_entry) && jet_driver_effect_budget_root(load) != None {
            rows: jet_driver_package_effect_rows(load, checked_functions, budget_entry, jet_driver_effect_budget_name_spans(load, registration_graph), jet_driver_package_effect_roots(load, registration_graph), request.compiler_threads)
            if rows == .Val(found) {
                ^budget: jet_driver_effect_budget_diagnostics(load, found)
                if jet_driver_has_errors(budget) {
                    return jet_driver_effect_budget_failure(load, budget.move(), trace)
                }
            }
        }
        if capture.budget {
            if sema_budget_located_specs_graph(registration_graph) == {
                .Ok(located) -> {
                    capture.budget_specs = loop row in located -> jet_driver_budget_spec(row.spec, registration_graph.modules[row.module_index].source_file, registration_graph.modules[row.module_index].source_segments, load.source_files)
                }
                .Err(error) -> {
                    loop diagnostic in error.diagnostics.move() -> load.diagnostics.push(diagnostic)
                    return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
                }
            }
            capture.budget_facts = jet_driver_budget_facts(load, registration_graph, checked_functions)
        }
        // A check that keeps its typed cost report (`explain --cost`, `lint
        // --cost`) first proves the projection complete: a checked body that
        // reaches a callee with neither a checked body nor a foreign row is
        // refused. The report's sites are placed on their lines and its
        // L2510 lints join the check's diagnostics.
        ^cost_report: TCostReport?{None}
        if request.capture_cost_report {
            jet_driver_trace_step_begin(request.trace_sink, "driver.check.cost")
            cost_callees: jet_driver_cost_callees(checked_functions, runtime_semantic_modules, registration_graph.decls, registration_graph.symbols)
            cost_cover: jet_driver_cost_cover(checked_functions, cost_callees)
            loop gap in cost_cover.gaps {
                load.diagnostics.push(jet_driver_cost_gap_diagnostic(load, checked_functions[gap.caller], decl_table_key(registration_graph.decls, registration_graph.symbols, gap.callee), gap.span))
            }
            if cost_cover.gaps.len() > 0 {
                jet_driver_trace_step_end(request.trace_sink, "driver.check.cost", cost_cover.covered.len())
                return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Check), false, trace)
            }
            ^report: jet_driver_cost_report(checked_functions, cost_cover.covered, cost_callees, registration_graph.interner)
            jet_driver_cost_place(load, report)
            loop lint in jet_driver_cost_lints(load, report) -> load.diagnostics.push(lint)
            cost_report = Val(report.move())
            jet_driver_trace_step_end(request.trace_sink, "driver.check.cost", cost_cover.covered.len())
        }
        jet_driver_trace_step_begin(request.trace_sink, "driver.check.facts")
        ^result: jet_driver_compile_result(load, load.diagnostics, None, true, trace)
        result.eval_answers = compiler_take_rows<SemaEvalProbeAnswer>(checked_graph.eval_answers)
        result.cost_report = cost_report.move()
        result.rust_foreign = if jet_driver_rust_foreign_present(registration_graph) -> jet_driver_rust_foreign_facts(registration_graph) else -> jet_driver_rust_foreign_empty()
        result.foreign_link = jet_driver_foreign_link_facts(runtime_semantic_modules, load.source_files)
        jet_driver_trace_step_end(request.trace_sink, "driver.check.facts", -1)
        if request.hold_check_state && !capture.stop_before_lowering {
            result.held = Val(JetDriverHeldState{
                load: load.move(),
                registration: registration_graph.move(),
                checked: checked_graph.move(),
                functions: checked_functions.move(),
                modules: runtime_semantic_modules.move(),
                values: comptime_values.move(),
                stage: comptime_stage.move(),
                run: comptime_run.move(),
                trail: trail.move(),
                canonical_effect_module_identity: canonical_effect_module_identity,
            })
            return result
        }
        // `jet prove --lens solver` and the Core library's check (JetCLI
        // CoreLibrary.jet) read every checked function, unpruned, with the
        // declaration table their direct calls name. Under
        // `release_state_aside` the rest of the compile state drops on a
        // detached task while the host builds IR, as a build's does.
        if capture.stop_before_lowering {
            jet_driver_trace_step_begin(request.trace_sink, "driver.check.capture")
            ^sources: ir_source_texts(load.source_files)
            ^decls: registration_graph.decls.move()
            registration_graph.decls = DeclTable{}
            ^symbols: registration_graph.symbols.move()
            registration_graph.symbols = SymbolTable{ranges: [SymbolKeys]{}}
            ^interner: registration_graph.interner.move()
            registration_graph.interner = interner_empty()
            capture.lowering_inputs = Val(JetDriverLoweringInputs{functions: checked_functions.move(), modules: runtime_semantic_modules.move(), decls: decls.move(), symbols: symbols.move(), interner: interner.move(), sources: sources.move(), entry_module_identity: load.entry_module_identity, canonical_effect_module_identity: canonical_effect_module_identity, module_table: load.module_table.copy(), entry_key: check_entry.move(), core_seal: checked_graph.core_seal.move(), core_bodies: checked_graph.core_bodies.move(), type_reflections: compiler_take_rows<TConstantDef>(checked_graph.type_reflections)})
            jet_driver_trace_step_end(request.trace_sink, "driver.check.capture", -1)
            if request.release_state_aside {
                // The lowering inputs took the Core seal and captures.
                checked_graph.core_seal = [String]{}
                checked_graph.core_bodies = SemaCoreCaptures{bodies: [SemaCoreBody]{}, context: ""}
                jet_driver_release_aside(
                    checked_row,
                    JetDriverHeldState{
                        load: load.move(),
                        registration: registration_graph.move(),
                        checked: checked_graph.move(),
                        // The lowering inputs took the checked functions and modules.
                        functions: [FnBody]{},
                        modules: [SemaGraphModuleResult]{},
                        values: comptime_values.move(),
                        stage: comptime_stage.move(),
                        run: comptime_run.move(),
                        trail: trail.move(),
                        canonical_effect_module_identity: canonical_effect_module_identity,
                    },
                )
            }
        } else if request.release_state_aside {
            jet_driver_release_aside(
                checked_row,
                JetDriverHeldState{
                    load: load.move(),
                    registration: registration_graph.move(),
                    checked: checked_graph.move(),
                    functions: checked_functions.move(),
                    modules: runtime_semantic_modules.move(),
                    values: comptime_values.move(),
                    stage: comptime_stage.move(),
                    run: comptime_run.move(),
                    trail: trail.move(),
                    canonical_effect_module_identity: canonical_effect_module_identity,
                },
            )
        }
        return result
    }

    // From here on the registration graph is read only for the entry
    // module's C export rows, the entry package's lowering roots and the
    // Rust foreign facts; its declaration
    // table moves on with the checked functions, whose direct calls name it.
    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.registration")
    ^c_export_rows: jet_driver_c_export_rows(registration_graph, load.entry_module_identity)
    ^job_rows: jet_driver_job_rows(registration_graph, load.entry_module_identity)
    command_record: sema_cli_command_record(registration_graph)
    budget_spans: jet_driver_effect_budget_name_spans(load, registration_graph)
    budget_roots: jet_driver_package_effect_roots(load, registration_graph)
    // A user module only compile-time code uses is left out like an
    // unreached Core module, and a dependency package's top-level bodies are
    // lowered only when reached, as Core's are; under `dead_code: remove` on
    // the executable route the entry package's are too, from its roots
    // (jet_driver_entry_root_keys: the entry resolves here over every checked
    // function, its diagnostics left to the resolution after lowering). A Test
    // compile keeps every module's bodies, and the Core unit a `jet test` of a
    // Core source runs is rooted whole, as an entry is, so its #Test bodies
    // lower; so is the source a debugger's evaluation appends its expression
    // to (JetDriverCompileRequest.rooted_source).
    ^prunable_modules: jet_driver_prunable_core_modules(load, request.core_sources, runtime_semantic_modules)
    ^entry_roots: name_table_sized(2)
    if request.mode != JetDriverCompileMode.Test {
        loop identity in registration_graph.comptime_only_modules -> prunable_modules.push(identity)
        loop identity in jet_driver_prunable_dependency_modules(load, runtime_semantic_modules) {
            prunable_modules.push(identity)
        }
    }
    if request.mode == JetDriverCompileMode.Program && request.lower_reached_only {
        entry_modules: jet_driver_prunable_entry_modules(load, runtime_semantic_modules)
        ^unreported: [Diagnostic]{}
        entry_roots = jet_driver_entry_root_keys(registration_graph, entry_modules, checked_graph, load.entry_module_identity, jet_driver_resolve_entry_key(load, registration_graph.module_table, checked_graph, checked_functions, runtime_semantic_modules, unreported))
        loop identity in entry_modules -> prunable_modules.push(identity)
    }
    if request.core_tests != "" {
        tested: jet_driver_test_modules(load, request.core_tests)
        ^kept: [ModuleID]{}
        loop identity in prunable_modules {
            if tested.get(identity.id) == None -> kept.push(identity)
        }
        prunable_modules = kept
    }
    if request.rooted_source != "" {
        rooted: jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), request.rooted_source)
        ^kept: [ModuleID]{}
        loop identity in prunable_modules {
            if !jet_driver_source_module(load, identity, rooted) -> kept.push(identity)
        }
        prunable_modules = kept
    }
    ^decls: registration_graph.decls.move()
    registration_graph.decls = DeclTable{}
    // The symbol table moves on with the declarations, in a one-row list
    // core reachability lends its threads: the Rust foreign facts below read
    // only the modules' foreign rows.
    ^symbol_rows: [SymbolTable]{registration_graph.symbols.move()}
    registration_graph.symbols = SymbolTable{ranges: [SymbolKeys]{}}
    ^interner_rows: [Interner]{registration_graph.interner.move()}
    registration_graph.interner = interner_empty()
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.registration", c_export_rows.len())

    // #3980: lower only the Core source bodies the program reaches.
    if request.trace_sink == .Val(sink) -> sink.begin("lower", "", -1, -1)
    ^lowering_rows: ir_reachable_core_rows(checked_functions, decls, symbol_rows, interner_rows, lowering_candidates, prunable_modules, entry_roots, jet_driver_value_function_keys(comptime_values), request.compiler_threads, request.trace_sink)
    // Unreachable: both lists hold one row here, and ir_reachable_core_rows
    // either returns before it takes them or transfers them back.
    ^symbols: symbol_rows.pop() ?? panic("the run's symbol table left core reachability")
    ^interner: interner_rows.pop() ?? panic("the run's interner left core reachability")
    ^sema_functions: [FnBody]{}
    ^unlowered_functions: [FnBody]{}
    jet_driver_partition_checked_functions(checked_functions, lowering_rows, sema_functions, unlowered_functions)
    if kg.enabled {
        jet_driver_keep_going_diagnostics(kg, "sema", load.diagnostics)
        if kg.skip.len() > 0 -> jet_driver_keep_going_trap_lowering(kg, sema_functions)
        // Only a failed check can leave a callee without a checked function,
        // and only a failed evaluation a constant without a value.
        if kg.rows.len() > 0 {
            jet_driver_keep_going_trap_unresolved_calls(kg, sema_functions, runtime_semantic_modules, decls, symbols)
            jet_driver_keep_going_trap_unvalued_constants(kg, sema_functions, runtime_semantic_modules, symbols)
        }
        jet_driver_keep_going_flush(kg, request.trace_sink)
    }
    // The native executable route reads the checked functions; its entry
    // resolves over them. A Test compile has no entry: its harness plan reads
    // the same checked functions.
    if request.trace_sink == .Val(sink) -> sink.end("lower", sema_functions.len())
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.entry")
    ^entry_diagnostics: load.diagnostics
    load.diagnostics = [Diagnostic]{}
    ^entry_key: String?{None}
    ^tests: [TTestFact]{}
    ^output_checks: [TOutputCheckFact]{}
    if request.mode == JetDriverCompileMode.Test {
        jet_driver_test_plan(jet_driver_test_modules(load, request.core_tests), checked_graph, registration_graph.module_table, sema_functions, tests, output_checks, entry_diagnostics)
    } else if request.mode == JetDriverCompileMode.Eval || request.mode == JetDriverCompileMode.RootRun {
        // An evaluation runs the entry module's selected function, never
        // the package's executable entry.
        selected_name: request.selected_entry ?? "run"
        key: symbol_key_text(SymbolKind.Function, module_text(registration_graph.module_table, load.entry_module_identity), "", selected_name)
        ^found: false
        loop function in sema_functions {
            if function.key == key -> found = true
        }
        if found -> entry_key = Val(key) else {
            entry_diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the evaluation entry `{selected_name}` has no checked function", "evaluation executes the selected checked function", "declare the selected entry in the evaluation module"))
        }
    } else {
        entry_key = jet_driver_resolve_entry_key(load, registration_graph.module_table, checked_graph, sema_functions, runtime_semantic_modules, entry_diagnostics)
    }
    load.diagnostics = entry_diagnostics
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.entry", -1)
    // The effect budget, the foreign link facts, the captured lowering
    // inputs and the compile result, up to jet_driver_trace_result_built;
    // each is a step span inside `driver.result`.
    if request.trace_sink == .Val(sink) -> sink.begin("driver.result", "", -1, -1)
    if kg.enabled -> jet_driver_keep_going_diagnostics(kg, "assemble", load.diagnostics)
    if jet_driver_has_errors(load.diagnostics) && !kg.enabled {
        return jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Assemble), false, trace)
    }
    // A test run or an evaluation runs no package entry, so only a build or
    // a run spends the package effect budget, and only their rows are the
    // ones the project lock records (JetDriverCompileResult.package_effects).
    run_budget: request.mode != JetDriverCompileMode.Test && request.mode != JetDriverCompileMode.Eval && entry_key != None
    ^package_effects: [PackageEffects]{}
    ^budget_rows: JetDriverPackageEffectRows?{None}
    ^entry_effects: [String]{}
    ^foreign_link: jet_driver_foreign_link_empty()
    ^rust_foreign: jet_driver_rust_foreign_empty()
    if compiler_threads_admit(request.compiler_threads, sema_functions.len(), sema_functions.len(), 256, 0, 0) > 1 {
        if run_budget -> jet_driver_trace_step_begin(request.trace_sink, "driver.result.budget")
        task.group driver_result_parallel {
            t_req: task {
                if entry_key == .Val(key) -> jet_driver_required_effects(sema_functions, key) else -> [String]{}
            }
            t_foreign: task jet_driver_foreign_link_facts(runtime_semantic_modules, load.source_files)
            t_rust: task {
                if jet_driver_rust_foreign_present(registration_graph) -> jet_driver_rust_foreign_facts(registration_graph) else -> jet_driver_rust_foreign_empty()
            }
            if run_budget {
                if entry_key == .Val(budget_entry) {
                    budget_rows = jet_driver_package_effect_rows(load, sema_functions, budget_entry, budget_spans, budget_roots, request.compiler_threads)
                }
            }
            entry_effects = compiler_threads_joined(t_req)
            foreign_link = compiler_threads_joined(t_foreign)
            rust_foreign = compiler_threads_joined(t_rust)
        }
        if run_budget {
            if budget_rows.move() == .Val(found) {
                ^budget: jet_driver_effect_budget_diagnostics(load, found)
                if kg.enabled -> jet_driver_keep_going_diagnostics(kg, "assemble", budget)
                if jet_driver_has_errors(budget) && !kg.enabled {
                    jet_driver_trace_step_end(request.trace_sink, "driver.result.budget", -1)
                    return jet_driver_effect_budget_failure(load, budget.move(), trace)
                }
                package_effects = found.entries
            }
            jet_driver_trace_step_end(request.trace_sink, "driver.result.budget", package_effects.len())
        }
    } else {
        if run_budget {
            if entry_key == .Val(budget_entry) {
                jet_driver_trace_step_begin(request.trace_sink, "driver.result.budget")
                rows: jet_driver_package_effect_rows(load, sema_functions, budget_entry, budget_spans, budget_roots, request.compiler_threads)
                if rows == .Val(found) {
                    ^budget: jet_driver_effect_budget_diagnostics(load, found)
                    if kg.enabled -> jet_driver_keep_going_diagnostics(kg, "assemble", budget)
                    if jet_driver_has_errors(budget) && !kg.enabled {
                        jet_driver_trace_step_end(request.trace_sink, "driver.result.budget", -1)
                        return jet_driver_effect_budget_failure(load, budget.move(), trace)
                    }
                    package_effects = found.entries
                }
                jet_driver_trace_step_end(request.trace_sink, "driver.result.budget", package_effects.len())
            }
        }
        jet_driver_trace_step_begin(request.trace_sink, "driver.result.required")
        if entry_key == .Val(key) {
            entry_effects = jet_driver_required_effects(sema_functions, key)
        }
        jet_driver_trace_step_end(request.trace_sink, "driver.result.required", entry_effects.len())
        jet_driver_trace_step_begin(request.trace_sink, "driver.result.foreign")
        foreign_link = jet_driver_foreign_link_facts(runtime_semantic_modules, load.source_files)
        jet_driver_trace_step_end(request.trace_sink, "driver.result.foreign", -1)
        rust_foreign = if jet_driver_rust_foreign_present(registration_graph) -> jet_driver_rust_foreign_facts(registration_graph) else -> jet_driver_rust_foreign_empty()
    }
    // A doc compile's checked bodies (doc_modules) name TypeIDs of this interner.
    ^doc_interner: Interner?{None}
    if capture.stop_before_lowering {
        jet_driver_trace_step_begin(request.trace_sink, "driver.result.capture")
        ^sources: ir_source_texts(load.source_files)
        capture.lowering_inputs = Val(JetDriverLoweringInputs{functions: sema_functions.move(), modules: runtime_semantic_modules.move(), decls: decls.move(), symbols: symbols.move(), interner: interner.move(), sources: sources.move(), entry_module_identity: load.entry_module_identity, canonical_effect_module_identity: canonical_effect_module_identity, module_table: load.module_table.copy(), entry_key: entry_key, tests: tests.move(), output_checks: output_checks.move(), c_exports: c_export_rows.move(), jobs: job_rows.move(), deep_checks: deep_kept.selected.move(), type_reflections: compiler_take_rows<TConstantDef>(checked_graph.type_reflections)})
        jet_driver_trace_step_end(request.trace_sink, "driver.result.capture", -1)
    } else if request.mode == JetDriverCompileMode.Doc { doc_interner = Val(interner.move()) }
    jet_driver_trace_step_begin(request.trace_sink, "driver.result.compile")
    ^result: jet_driver_compile_result(load, load.diagnostics, None, true, trace)
    result.entry_effects = entry_effects.move()
    result.package_effects = package_effects.move()
    result.rust_foreign = rust_foreign.move()
    result.foreign_link = foreign_link
    result.command_record = command_record
    result.eval_answers = compiler_take_rows<SemaEvalProbeAnswer>(checked_graph.eval_answers)
    result.doc_interner = doc_interner.move()
    jet_driver_trace_step_end(request.trace_sink, "driver.result.compile", -1)
    jet_driver_trace_result_built(request.trace_sink, result.diagnostics.len())
    if request.release_state_aside {
        jet_driver_release_aside(
            lowering_rows.len(),
            JetDriverHeldState{
                load: load.move(),
                registration: registration_graph.move(),
                checked: checked_graph.move(),
                functions: unlowered_functions.move(),
                // The lowering inputs took the checked modules.
                modules: [SemaGraphModuleResult]{},
                values: comptime_values.move(),
                stage: comptime_stage.move(),
                run: comptime_run.move(),
                trail: trail.move(),
                canonical_effect_module_identity: canonical_effect_module_identity,
            },
        )
    }
    result
}

// The fewest checked functions whose compile state drops on a task of its
// own (jet_driver_release_aside). Measured: a process's first task spawn and
// join costs 0.2-0.6 ms, the thread start included, while compile state
// drops in about 15 us per function (the runtime unit's `driver.release`:
// 127 ms over 8278 functions), so a smaller state drops sooner on the
// compile's thread, and a small program starts no thread for it.
JET_DRIVER_RELEASE_ASIDE_MIN_FUNCTIONS: 16

JetDriverHeldRest: struct {
    functions: [FnBody],
    modules: [SemaGraphModuleResult],
    values: [SemaComptimeItemValue],
    stage: SemaComptimeDeclarationStage,
    run: JetDriverComptimeRunResult,
    trail: SemaGraphTrail,
}

// Drops `state` on a detached task, so the host's IR build runs while the
// graphs drop instead of after (JetDriverCompileRequest.release_state_aside).
// The task owns the state alone; a process that exits first hands its pages
// back to the kernel. The state of a compile that checked fewer than
// JET_DRIVER_RELEASE_ASIDE_MIN_FUNCTIONS functions (`checked`) drops here.
jet_driver_release_aside: fn(checked: Int, state: ^^JetDriverHeldState) {
    ^held: state.move()
    if checked < JET_DRIVER_RELEASE_ASIDE_MIN_FUNCTIONS {
        return
    }
    ^dropped_load: held.load.move()
    ^dropped_reg: held.registration.move()
    ^dropped_checked: held.checked.move()
    ^dropped_rest: JetDriverHeldRest{
        functions: held.functions.move(),
        modules: held.modules.move(),
        values: held.values.move(),
        stage: held.stage.move(),
        run: held.run.move(),
        trail: held.trail.move(),
    }
    t1: task ^^dropped_reg { dropped_reg.modules.len() }
    t2: task ^^dropped_load { dropped_load.modules.len() }
    t3: task ^^dropped_checked { dropped_checked.modules.len() }
    t4: task ^^dropped_rest { dropped_rest.functions.len() }
    t1.detach()
    t2.detach()
    t3.detach()
    t4.detach()
}

// A program's held check (JetDriverCompileRequest.hold_check_state), which
// the debugger checks an expression's function against in place of a
// compile of the program with the function appended
// (jet_driver_held_eval_check): a probe (JetSema ScriptHelpers.jet
// sema_script_probe_over) over the held registration and the checked
// modules' types, the solved effect rows of the checked functions by key
// (`rows`), and each checked module by its source file, the display path
// the compile gives it (jet_driver_display_path), which a check enters
// (`modules`, the module id at the file's id in `module_files`;
// jet_driver_held_eval_module). The registration's symbol table and the
// checked types are not the probe's own: the program's lowering holds them
// (JetDriverHeldOpened) and lends them to each check.
JetDriverHeldEval: struct {
    probe: SemaScriptProbe,
    rows: SemaEvalHeldRows,
    module_files: NameTable{name_column_table()},
    modules: [Int]{name_column()},
    // The program's memory plan, whose rewrite of a function is the body a
    // check of it reads (jet_driver_held_eval_answer).
    plan: SemaFunctionMemoryPlan,
}

// A held program opened for the debugger (jet_driver_held_eval_open): its
// probe, and what its lowering takes. `inputs` holds the checked functions,
// with the solved effect rows the effect verdict reads, the checked modules,
// the sources and the registration's symbol table; its declaration table is
// empty, as the probe's registration keeps it, and `types` holds the checked
// types, which the probe transferred out of the modules. No Core seal, entry
// or jobs: an evaluation builds none.
JetDriverHeldOpened: struct {
    eval: JetDriverHeldEval,
    inputs: JetDriverLoweringInputs,
    types: [TTypeDef],
}

// The held program `held` opened, its probe at the entry module, its memory
// plan computed on `threads`. None when the registration has no entry
// module.
jet_driver_held_eval_open: fn(held: ^^JetDriverHeldState, threads: CompilerThreads) -> JetDriverHeldOpened? {
    ^taken: held.move()
    ^module_files: name_column_table(taken.modules.len())
    ^modules: name_column()
    loop checked in taken.modules {
        name_column_set(module_files, modules, "{checked.source_file}", Int{checked.module_identity.id})
    }
    ^probe: sema_script_probe_over(taken.registration, taken.modules, taken.load.entry_module_identity) ?? return None
    plan: sema_function_memory_plan_from_graph(probe.program.registration_graph, threads)
    ^symbols: probe.program.registration_graph.symbols.move()
    probe.program.registration_graph.symbols = SymbolTable{ranges: [SymbolKeys]{}}
    ^interner: probe.program.registration_graph.interner.move()
    probe.program.registration_graph.interner = interner_empty()
    ^types: probe.program.checked_types.move()
    probe.program.checked_types = [TTypeDef]{}
    ^sources: ir_source_texts(taken.load.source_files)
    rows: sema_eval_held_rows(taken.functions)
    ^inputs: JetDriverLoweringInputs{functions: taken.functions.move(), modules: taken.modules.move(), decls: DeclTable{}, symbols: symbols.move(), interner: interner.move(), sources: sources.move(), entry_module_identity: taken.load.entry_module_identity, canonical_effect_module_identity: taken.canonical_effect_module_identity, module_table: taken.load.module_table.move(), entry_key: None}
    Val(JetDriverHeldOpened{eval: JetDriverHeldEval{probe: probe.move(), rows: rows.move(), module_files: module_files.move(), modules: modules.move(), plan: plan.move()}, inputs: inputs.move(), types: types.move()})
}

// The checked module whose source file is `path` (JetDriverHeldEval.modules).
jet_driver_held_eval_module: fn(held: JetDriverHeldEval, path: String) -> ModuleID? Never! {
    id: name_column_get(held.module_files, held.modules, path) ?? return None
    Val(ModuleID{id: U32{id}})
}

// The function in the source `text`, the debugger's expression function
// (JetCLI DebugCompile.jet), checked by `held`'s probe
// (sema_script_probe_check_func) in the module whose source file is `path`
// (JetDriverHeldEval.modules), which the probe enters
// (sema_script_probe_enter), with the program's symbol table `symbols` and
// checked types `types` lent to it for the check (JetDriverHeldOpened);
// they come back in the answer, with whatever the check added to them. The
// effect verdict judges the checked function against the solved rows of the
// program's checked `functions` (sema_eval_held_effect_refusals). A refusal
// is a report, and the check is then not complete. Spans count from 0 in
// `text`. A text that doesn't parse as a single function returns the
// parse's reports and no body; a `path` no checked module has returns no
// reports and no body.
jet_driver_held_eval_check: fn(held: ^JetDriverHeldEval, path: String, functions: [FnBody], symbols: ^^SymbolTable, interner: ^^Interner, types: ^^[TTypeDef], text: String) -> JetDriverHeldChecked {
    ^parsed: parse_source(text.bytes())
    if jet_driver_has_errors(parsed.diagnostics) || parsed.program.items.len() != 1 {
        return JetDriverHeldChecked{checked: SemaScriptProbeChecked{function: None, diagnostics: parsed.diagnostics.move(), complete: false}, symbols: symbols.move(), interner: interner.move(), types: types.move()}
    }
    if parsed.program.items[0] == .Func(func) {
        candidate: sema_failure_inference_candidate(func)
        ^going: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), symbols.move(), interner.move(), types.move())
        held.probe.program.registration_graph = going.graph.move()
        held.probe.program.checked_types = going.types.move()
        // The module scope reads the symbol table, so the probe enters the
        // module while the table is lent.
        ^checked: SemaScriptProbeChecked{function: None, diagnostics: [Diagnostic]{}, complete: false}
        if jet_driver_held_eval_module(held, path) == .Val(module_identity) {
            if sema_script_probe_enter(held.probe, module_identity) {
                checked = sema_script_probe_check_func(held.probe, func)
            }
        }
        ^back: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), going.symbols.move(), going.interner.move(), held.probe.program.checked_types.move())
        held.probe.program.registration_graph = back.graph.move()
        held.probe.program.checked_types = [TTypeDef]{}
        if checked.complete {
            held_function: checked.function.move()
            checked.function = None
            if held_function.move() == .Val(settled) {
                ^function: settled
                by_key: held.rows
                sema_eval_held_failure_settle(function, candidate, checked.failure.move(), functions, by_key)
                checked.failure = None
                loop refusal in sema_eval_held_effect_refusals(function, functions, by_key, function.source_span) {
                    checked.diagnostics.push(refusal)
                    checked.complete = false
                }
                checked.function = Val(function.move())
            }
        }
        return JetDriverHeldChecked{checked: checked.move(), symbols: back.symbols.move(), interner: back.interner.move(), types: back.types.move()}
    }
    JetDriverHeldChecked{checked: SemaScriptProbeChecked{function: None, diagnostics: parsed.diagnostics.move(), complete: false}, symbols: symbols.move(), interner: interner.move(), types: types.move()}
}

// A held check's answer (jet_driver_held_eval_check), and the symbol table
// and checked types lent to it.
JetDriverHeldChecked: struct {
    checked: SemaScriptProbeChecked,
    symbols: SymbolTable,
    interner: Interner,
    types: [TTypeDef],
}

// The answer (SemaEvalProbeAnswer) for the debugger's expression `text` at
// byte `offset` of the source file `path`, where a frame stopped, from
// `held`'s probe (sema_script_probe_answer): the function of the module
// whose source file is `path` (JetDriverHeldEval.modules) that holds the
// stop, checked again with the expression asked there. So the answer reads
// the stop's locals, their types and what the frame moved as a compile of
// the program with the question does (jet_driver_eval_probes), and only
// that function is checked. The program's symbol table `symbols` and
// checked types `types` are lent as jet_driver_held_eval_check lends them.
// None when no checked module has `path`, the text doesn't parse there, or
// no function there answers.
jet_driver_held_eval_answer: fn(held: ^JetDriverHeldEval, path: String, offset: Int, text: String, symbols: ^^SymbolTable, interner: ^^Interner, types: ^^[TTypeDef]) -> JetDriverHeldAnswer {
    going: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), symbols.move(), interner.move(), types.move())
    held.probe.program.registration_graph = going.graph.move()
    held.probe.program.checked_types = going.types.move()
    ^answer: SemaEvalProbeAnswer?{None}
    if jet_driver_held_eval_module(held, path) == .Val(module_identity) {
        if sema_script_probe_enter(held.probe, module_identity) {
            answer = jet_driver_held_eval_answer_in(held, path, offset, text)
        }
    }
    back: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), going.symbols.move(), going.interner.move(), held.probe.program.checked_types.move())
    held.probe.program.registration_graph = back.graph.move()
    held.probe.program.checked_types = [TTypeDef]{}
    JetDriverHeldAnswer{answer: answer.move(), symbols: back.symbols.move(), interner: back.interner.move(), types: back.types.move()}
}

jet_driver_held_eval_answer_in: fn(held: ^JetDriverHeldEval, path: String, offset: Int, text: String) -> SemaEvalProbeAnswer? {
    stop: jet_driver_eval_segment_offset(held.probe.program.registration_graph.modules[held.probe.module_index].source_segments, path, offset) ?? return None
    parsed: sema_eval_probe_parse(text, stop)
    expression: parsed.expression.move() ?? return None
    sema_script_probe_answer(held.probe, held.plan, stop, expression)
}

// A held answer (jet_driver_held_eval_answer), and the symbol table and
// checked types lent to it.
JetDriverHeldAnswer: struct {
    answer: SemaEvalProbeAnswer?,
    symbols: SymbolTable,
    interner: Interner,
    types: [TTypeDef],
}

// A function of the program's source `text` that `held`'s registration
// lacks (JetCLI DebugCompile.jet appends those a held check of the
// program's cut left out and an expression calls), appended by `held`'s
// probe (sema_script_probe_append) to the module whose source file is
// `path`, with the program's symbol table `symbols` and checked types
// `types` lent as jet_driver_held_eval_check lends them, and judged against
// the program's checked `functions` at the rows of JetDriverHeldEval.rows.
// Spans count from 0 in `text`. None, with the registration as it was,
// when the text is not one function, no checked module has `path`, or the
// probe doesn't keep it.
jet_driver_held_eval_append: fn(held: ^JetDriverHeldEval, path: String, functions: [FnBody], symbols: ^^SymbolTable, interner: ^^Interner, types: ^^[TTypeDef], text: String) -> JetDriverHeldAppended {
    ^parsed: parse_source(text.bytes())
    if jet_driver_has_errors(parsed.diagnostics) || parsed.program.items.len() != 1 {
        return JetDriverHeldAppended{appended: None, symbols: symbols.move(), interner: interner.move(), types: types.move()}
    }
    ^item: parsed.program.items.pop() ?? return JetDriverHeldAppended{appended: None, symbols: symbols.move(), interner: interner.move(), types: types.move()}
    ^going: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), symbols.move(), interner.move(), types.move())
    held.probe.program.registration_graph = going.graph.move()
    held.probe.program.checked_types = going.types.move()
    // The module scope reads the symbol table, so the probe enters the
    // module while the table is lent.
    ^appended: SemaScriptProbeAppended?{None}
    if jet_driver_held_eval_module(held, path) == .Val(module_identity) {
        if sema_script_probe_enter(held.probe, module_identity) {
            appended = sema_script_probe_append(held.probe, item.move(), functions, held.rows)
        }
    }
    ^back: jet_driver_held_eval_lend(held.probe.program.registration_graph.move(), going.symbols.move(), going.interner.move(), held.probe.program.checked_types.move())
    held.probe.program.registration_graph = back.graph.move()
    held.probe.program.checked_types = [TTypeDef]{}
    JetDriverHeldAppended{appended: appended.move(), symbols: back.symbols.move(), interner: back.interner.move(), types: back.types.move()}
}

// A held append's function (jet_driver_held_eval_append), and the symbol
// table and checked types lent to it.
JetDriverHeldAppended: struct {
    appended: SemaScriptProbeAppended?,
    symbols: SymbolTable,
    interner: Interner,
    types: [TTypeDef],
}

// The registration `graph` with `symbols` as its symbol table, the table it
// held, and `types`, handed through: each check lends the program's symbol
// table and checked types to the probe and takes them back
// (jet_driver_held_eval_check).
JetDriverHeldLend: struct {
    graph: SemaRegistrationGraph,
    symbols: SymbolTable,
    interner: Interner,
    types: [TTypeDef],
}

jet_driver_held_eval_lend: fn(graph: ^^SemaRegistrationGraph, symbols: ^^SymbolTable, interner: ^^Interner, types: ^^[TTypeDef]) -> JetDriverHeldLend {
    ^lent: graph.move()
    ^previous: lent.symbols.move()
    lent.symbols = symbols.move()
    ^previous_interner: lent.interner.move()
    lent.interner = interner.move()
    JetDriverHeldLend{graph: lent.move(), symbols: previous.move(), interner: previous_interner.move(), types: types.move()}
}

// Drops `facts` on a detached task, as jet_driver_release_aside drops a
// compile's state, so lowering runs while they drop instead of after. Facts
// drop here when fewer than JET_DRIVER_RELEASE_ASIDE_MIN_FUNCTIONS checked
// functions (`checked`: 0 when the build holds its state) produced them.
jet_driver_release_facts_aside: fn(checked: Int, facts: ^^[SemaCheckedFacts]) {
    held: facts.move()
    if checked < JET_DRIVER_RELEASE_ASIDE_MIN_FUNCTIONS {
        return
    }
    released: task ^^held { held.len() }
    released.detach()
}

// The effects the application requires: the direct effects of every function
// the entry `entry_key` reaches along checked call edges and value edges (a
// function taken as a value, an implementation a trait-value call may run), so
// a function that runs only through a value still lists its effects. The
// maximal row an open-world call seeds into `solved` is a ceiling fact (E0743),
// not an effect the program performs; a written C call with no declared root
// lists `FFI.C` as a direct effect. The generated typed-CLI entry
// `__jet_cli_run` and the parser it calls, `__jet_cli_parse` of its module
// (`__jet_cli_parse_<binding>` for `__jet_cli_run_<binding>`; JetSema
// Registration/CliEntry.jet), read argv and its env fallbacks, print help and
// exit on a refusal through Core; that parse is the toolchain's, so only the
// user functions they dispatch to contribute required effects. The platform
// contract's env reads (jet_driver_toolchain_env_read) are the toolchain's too.
jet_driver_required_effects: fn(functions: [FnBody], entry_key: String) -> [String] Never! {
    // Each key's first row: a hashed map, only looked up.
    by_key: ir_first_function_rows(functions)
    ^pending: [Int]{}
    if ir_function_rows_get(by_key, entry_key) == .Val(entry) -> pending.push(entry)
    ^seen: (loop _ in functions -> false)
    ^parser: -1
    ^required: [String]{}
    loop pending.len() > 0 {
        index: pending.pop() ?? break
        if seen[index] -> next
        seen[index] = true
        cli: index == parser || (functions[index].name.starts_with("__jet_cli_run") && functions[index].key == entry_key)
        if !cli {
            loop effect_name in functions[index].effects.direct -> required.push(effect_name.copy())
        }
        loop edge in functions[index].effects.call_edges {
            callee: ir_function_rows_get(by_key, edge) ?? next
            if jet_driver_toolchain_env_read(functions[callee]) -> next
            if cli && functions[callee].module_name.starts_with("core.") -> next
            if cli && index != parser && functions[callee].module_identity == functions[index].module_identity && functions[callee].name == functions[index].name.replace("__jet_cli_run", "__jet_cli_parse") {
                parser = callee
            }
            pending.push(callee)
        }
        loop edge in functions[index].effects.value_edges {
            callee: ir_function_rows_get(by_key, edge) ?? next
            if jet_driver_toolchain_env_read(functions[callee]) -> next
            if cli && functions[callee].module_name.starts_with("core.") -> next
            if cli && index != parser && functions[callee].module_identity == functions[index].module_identity && functions[callee].name == functions[index].name.replace("__jet_cli_run", "__jet_cli_parse") {
                parser = callee
            }
            pending.push(callee)
        }
    }
    required
}

// Whether `function` is one of the env reads of the platform contract:
// `serve` reads JET_APP_PORT, which `jet run`, `jet dev` and the platform set
// to choose the port, JET_DEV, which `jet dev` sets, and the OpenTelemetry
// SDK's OTEL_* variables, which the platform sets to name the collector its
// served app traces to (the core.web functions that fill the AppPortEnv,
// AppDevEnv and AppTraceEnv roles). The toolchain owns those variables, as it
// owns the typed CLI's parse, so no such read charges the package Env; a
// program's own env read still does.
jet_driver_toolchain_env_read: fn(function: FnBody) -> Bool {
    function.role == "AppPortEnv" || function.role == "AppDevEnv" || function.role == "AppTraceEnv"
}

// The root package's row, the building package's own.
jet_driver_entry_package_index: fn(load: JetDriverLoadResult) -> Int? Never! {
    loop (index, package) in load.packages {
        if package.identity == load.package_identity -> return Val(index)
    }
    None
}

// The root package's row when its `authority` writes an `allow` or `deny`
// row, the opt-in of the package effect budget.
jet_driver_effect_budget_root: fn(load: JetDriverLoadResult) -> Int? Never! {
    index: jet_driver_entry_package_index(load) ?? return None
    package: load.packages[index]
    if (package.authority_allow == None || authority_expert_only(package.authority_allow ?? [String]{})) && package.authority_deny == None {
        return None
    }
    Val(index)
}

// Into `names`, each dependency's source root by its name and its name by its
// package identity; the count of the dependencies. The entry package is no
// dependency of itself.
jet_driver_dependency_roots: fn(load: JetDriverLoadResult, names: ^JetDriverDependencyNames) -> Int Never! {
    loop package in load.packages {
        loop dependency in package.dependencies {
            if name_find(names.roots, dependency.name) != None -> next
            loop target in load.packages {
                if target.root_index != dependency.target_root_index || target.identity == load.package_identity {
                    next
                }
                if name_index(name_intern(names.roots, dependency.name)) == names.root_paths.len() {
                    names.root_paths.push(target.root_path)
                }
                known: name_count(names.identities)
                if name_index(name_intern(names.identities, target.identity)) == known {
                    names.by_identity.push(name_intern(names.names, dependency.name))
                }
                break
            }
        }
    }
    name_count(names.roots) - 1
}

// Each dependency's name (jet_driver_dependency_roots): a table of the
// dependencies' package identities, and by each one's id there the id of
// its name in a table of the names; and a table of the dependencies' names,
// by each one's id there its source root.
JetDriverDependencyNames: struct {
    identities: NameTable{name_table_sized(2)},
    names: NameTable{name_table_sized(2)},
    by_identity: [Name]{[Name]{name_empty()}},
    roots: NameTable{name_table_sized(2)},
    root_paths: [String]{[String]{""}},
}

// The name of the dependency whose package identity is `identity`, if the
// build has one.
jet_driver_dependency_name: fn(names: JetDriverDependencyNames, identity: String) -> String? Never! {
    id: name_find(names.identities, identity) ?? return None
    row: name_index(id)
    if row == 0 -> return None
    Val(name_text(names.names, names.by_identity[row]))
}

// A budget spec located in the module that owns it: its span's source file
// (the module's own file when no segment holds the span) and the line and
// column of the span's start there.
jet_driver_budget_spec: fn(spec: BudgetSpec, module_file: String, segments: [SemaSourceSegment], files: [SourceFile]) -> JetDriverBudgetSpec {
    ^path: module_file.copy()
    ^offset: spec.span.start
    if sema_source_location_at(segments, spec.span) == .Val(location) {
        path = location.source_path
        offset = spec.span.start - location.aggregate_start + location.source_start
    }
    ^line: 1
    ^column: 1
    loop file in files {
        if file.path != path -> next
        line = diagnostic_line_at(file.source, offset)
        column = diagnostic_column_at(file.source, offset)
        break
    }
    JetDriverBudgetSpec{spec: spec, source_path: path, line: line, column: column}
}

// The CompilerFacts of a checked graph, over its non-Core modules: the public
// functions, types, traits and code modules they declare, the build's
// dependency roots, and the distinct effects the checker solved for their
// functions.
jet_driver_budget_facts: fn(load: JetDriverLoadResult, graph: SemaRegistrationGraph, functions: [FnBody]) -> JetDriverBudgetFacts {
    ^users: [U32:Bool]{}
    ^public_items: 0
    loop owner in graph.modules {
        if module_is_core(owner.module_identity) -> next
        users[owner.module_identity.id] = true
        loop item in owner.program.items {
            exported: if item == {
                .Func(value) -> value.is_pub
                .Struct(value) -> value.is_pub
                .Enum(value) -> value.is_pub
                .Trait(value) -> value.is_pub
                .CodeModule(value) -> value.is_pub
                .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
            }
            if exported -> public_items += 1
        }
    }
    ^names: JetDriverDependencyNames{}
    dependency_count: jet_driver_dependency_roots(load, names)
    ^solved: name_table_sized(8)
    loop body in functions {
        if !users.has_key(body.module_identity.id) -> next
        loop name in body.effects.solved -> ^_: name_intern(solved, name)
    }
    JetDriverBudgetFacts{public_api_items: public_items, dependency_count: dependency_count, effect_count: name_count(solved) - 1}
}

// The name span of each function and method a build's packages register, at
// its function key's id in `keys`.
JetDriverBudgetNameSpans: struct {
    keys: NameTable{name_table_sized(2)},
    spans: [Span?]{[Span?]{None}},
}

jet_driver_budget_name_span_put: fn(table: ^JetDriverBudgetNameSpans, key: String, span: Span) Never! {
    id: name_index(name_intern(table.keys, key))
    if id == table.spans.len() -> table.spans.push(Val(span)) else -> table.spans[id] = Val(span)
}

jet_driver_budget_name_span_of: fn(table: JetDriverBudgetNameSpans, key: String) -> Span? Never! {
    id: name_find(table.keys, key) ?? return None
    table.spans[name_index(id)]
}

// The name span of each function and method the build's packages register,
// by function key; empty when no budget is written.
jet_driver_effect_budget_name_spans: fn(load: JetDriverLoadResult, graph: SemaRegistrationGraph) -> JetDriverBudgetNameSpans Never! {
    ^spans: JetDriverBudgetNameSpans{}
    if jet_driver_effect_budget_root(load) == None -> return spans
    loop registered in graph.modules {
        ^built: false
        loop package in load.packages {
            if package.identity == registered.package_identity -> built = true
        }
        if !built -> next
        loop function in registered.functions {
            jet_driver_budget_name_span_put(spans, symbol_table_key(graph.symbols, function.symbol.id), function.symbol.span)
        }
        loop nominal in registered.nominals {
            loop method in nominal.methods {
                jet_driver_budget_name_span_put(spans, symbol_table_key(graph.symbols, method.symbol.id), method.symbol.span)
            }
        }
    }
    spans
}

// The package effect roots each function's own row names, by function key,
// each spelled as a manifest names it: `{dependency}.{Effect}`. A package
// effect root is an effect a dependency declares that is a kind of no
// Prelude effect, and a kind of it names it too. No Prelude root covers it,
// so the root package's `authority` rows govern it by that name, as they do
// a Prelude root (jet_driver_effect_budget_diagnostics). A kind of a Prelude
// effect stays governed through that effect, and the root package's own
// effects are its own. Empty when the build has no dependency.
jet_driver_package_effect_roots: fn(load: JetDriverLoadResult, graph: SemaRegistrationGraph) -> JetDriverPackageEffectRoots Never! {
    ^roots: JetDriverPackageEffectRoots{}
    ^names: JetDriverDependencyNames{}
    if jet_driver_dependency_roots(load, names) == 0 -> return roots
    // The effects the build's packages declare, each parent resolved.
    ^built: (loop _ in graph.modules -> false)
    ^effects: [SemaLibraryEffect]{}
    loop (module_index, registered) in graph.modules {
        if module_is_core(registered.module_identity) -> next
        loop package in load.packages {
            if package.identity == registered.package_identity -> built[module_index] = true
        }
        if built[module_index] {
            sema_library_effect_collect(effects, registered.package_identity, module_index, registered.program.items)
        }
    }
    if effects.len() == 0 -> return roots
    ^states: (loop _ in effects -> 0)
    loop index in 0..<effects.len() -> sema_library_effect_resolve(effects, graph, states, index)
    loop (module_index, registered) in graph.modules {
        if !built[module_index] -> next
        view: sema_library_effect_view(effects, registered)
        if view.len() == 0 -> next
        loop function in registered.functions {
            jet_driver_package_effect_root_row(roots, view, names, load.package_identity, symbol_table_key(graph.symbols, function.symbol.id), function.declaration.declared_effects)
        }
        loop nominal in registered.nominals {
            loop method in nominal.methods {
                jet_driver_package_effect_root_row(roots, view, names, load.package_identity, symbol_table_key(graph.symbols, method.symbol.id), method.declaration.declared_effects)
            }
        }
    }
    roots
}

// The package effect roots the effect row `row` names (`view` holds the
// effect names its module may write), under the function key `key` of
// `roots`. A dependency is named by `names`, by its package identity.
jet_driver_package_effect_root_row: fn(roots: ^JetDriverPackageEffectRoots, view: [SemaLibraryEffectName], names: JetDriverDependencyNames, root_identity: String, key: String, row: [EffectRowEntry]?) Never! {
    entries: row ?? return
    ^found: [String]{}
    loop entry in entries {
        if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
        named: sema_library_effect_find(view, entry.name) ?? next
        // A kind's ancestors end at its root: a package effect's token, or
        // the Prelude effect it is a kind of.
        last: named.ancestors.len() - 1
        spelled: if {
            last < 0 -> jet_driver_package_effect_spelling(named.token, names, root_identity)
            named.ancestors[last].contains("/") -> jet_driver_package_effect_spelling(named.ancestors[last], names, root_identity)
            else -> None
        }
        effect_name: spelled ?? next
        if !found.contains(effect_name) -> found.push(effect_name)
    }
    if found.len() == 0 {
        return
    }
    at: name_index(name_intern(roots.keys, key))
    if at == roots.roots.len() -> roots.roots.push(found) else -> roots.roots[at] = found
}

// The package effect roots of each function whose row names one
// (jet_driver_package_effect_roots): a table of the functions' keys, and
// by each key's id its roots.
JetDriverPackageEffectRoots: struct {
    keys: NameTable{name_table_sized(2)},
    roots: [[String]]{[[String]]{[String]{}}},
}

// The package effect roots `roots` holds for the function of key `key`.
jet_driver_package_effect_roots_of: fn(roots: JetDriverPackageEffectRoots, key: String) -> [String] Never! {
    id: name_find(roots.keys, key) ?? return [String]{}
    roots.roots[name_index(id)]
}

// How the root package's manifest names the package effect whose token is
// `token` (`{package identity}/{Effect}`, then any case or value):
// `{dependency}.{Effect}`; None for the root package's own effect or one no
// dependency name reaches.
jet_driver_package_effect_spelling: fn(token: String, names: JetDriverDependencyNames, root_identity: String) -> String? Never! {
    split: effect_value_base(token).cut_last("/") ?? return None
    if split.before == root_identity -> return None
    dependency: jet_driver_dependency_name(names, split.before) ?? return None
    effect_name: split.after.split(".").to_list()[0]
    Val("{dependency}.{effect_name}")
}

// Each package's inferred effect row for one entry's build
// (pkg_compute_package_effects; `root` names the building package), with the
// program view a budget diagnostic is located through
// (jet_driver_effect_budget_located). The package effect budget
// (jet_driver_effect_budget_diagnostics) holds the rows to the root's
// `authority`, and the project lock records each dependency's row (Jetpack
// pkg_lock_record_effect_rows).
JetDriverPackageEffectRows: struct {
    program: EffectBudgetProgram,
    module_identities: [ModuleID],
    entries: [PackageEffects],
}

// The package effect rows of the build of `entry_key`, when the build writes
// a budget or has a dependency; None when neither, or when the entry is no
// function of a package source.
// The checked functions feed the one Jetpack attribution
// (pkg_compute_package_effects) through its EffectBudgetProgram view.
//
// A function's row is what its own package's code reaches: its direct
// effects, a stop, and the effects of the same-package and Core functions it
// calls. A call into a dependency leaves that dependency's effects with the
// dependency, so a grant to it is not undone at its caller, and a row names
// the package whose code reaches the effect. As for the application's
// required effects (jet_driver_required_effects), an open-world call's
// maximal row is a ceiling fact, not a reached effect.
JetDriverBudgetEdgeChunk: struct {
    callees: [[Int]],
    extra: [[Int]],
}

jet_driver_budget_edge_chunk: fn(callees: ^^[[Int]], extra: ^^[[Int]]) -> JetDriverBudgetEdgeChunk Never! {
    JetDriverBudgetEdgeChunk{callees: callees.move(), extra: extra.move()}
}

jet_driver_package_effect_rows: fn(load: JetDriverLoadResult, functions: [FnBody], entry_key: String, name_spans: JetDriverBudgetNameSpans, package_roots: JetDriverPackageEffectRoots, threads: CompilerThreads) -> JetDriverPackageEffectRows? {
    root: load.packages[jet_driver_entry_package_index(load) ?? return None]
    // Each dependency's name, by its source root and by its package identity.
    ^dep_names: JetDriverDependencyNames{}
    dependency_count: jet_driver_dependency_roots(load, dep_names)
    if dependency_count == 0 && jet_driver_effect_budget_root(load) == None -> return None
    ^by_key: IRFunctionRows{keys: name_column_table(), rows: name_column()}
    // The budget package reads each dependency's source root by its name.
    ^dep_roots: [String:String]{}
    loop id in 1..<name_count(dep_names.roots) {
        dep_roots[name_text(dep_names.roots, Name{id: U32{id}})] = dep_names.root_paths[id]
    }
    ^program: EffectBudgetProgram{entry: -1, modules: [EffectBudgetModule]{}, dep_roots: dep_roots.move(), selected_output: None}
    ^module_identities: [ModuleID]{}
    ^module_rows: [U32:Int]{}
    ^aliases: name_table_sized(2)
    ^owners: [String]{}
    ^rows: [Int]{}
    rows.try_reserve(functions.len()) ?? ()
    task.group jet_driver_budget_prep {
        t_keys: task ir_first_function_rows(functions)
        loop loaded in load.modules {
            if loaded.source_unit_index < 0 || loaded.source_unit_index >= load.source_units.len() || module_rows.has_key(loaded.module_identity.id) {
                next
            }
            unit: load.source_units[loaded.source_unit_index]
            if unit.root_index < 0 || unit.path.starts_with("<build-generated>/") -> next
            // A site reads `module.function`; a module name another module
            // already shows keeps its full identity.
            ^segments: loaded.module_name.split(".").to_list()
            ^alias: segments.pop() ?? ""
            if alias.len() == 0 || name_find(aliases, alias) != None {
                alias = module_text(load.module_table, loaded.module_identity)
            }
            ^_: name_intern(aliases, alias)
            module_rows[loaded.module_identity.id] = program.modules.len()
            module_identities.push(loaded.module_identity)
            program.modules.push(EffectBudgetModule{path: jet_driver_physical_path(root.root_path, unit.path), alias: alias, function_keys: [String]{}, function_spans: [String:Span]{}, imports: [EffectBudgetImport]{}, has_build_entry: false})
        }
        owners = pkg_effect_module_owners(program)
        loop function in functions -> rows.push(module_rows.get(function.module_identity.id) ?? -1)
        by_key = compiler_threads_joined(t_keys)
    }
    entry_row: ir_function_rows_get(by_key, entry_key) ?? return None
    if rows[entry_row] < 0 -> return None
    // The functions the entry reaches along call and value edges, in
    // discovery order.
    fn_count: functions.len()
    ^reached: (loop _ in functions -> false)
    ^order: [Int]{}
    // The rows each reached function's edges resolve to, and indices of any
    // unresolved edges (such as EFFECT_PANIC_EDGE) for functions with a row
    // (non-negative into call_edges, negative -(i + 1) into value_edges).
    ^callees: [[Int]]{}
    ^extra_edges: [[Int]]{}
    if threads.cap != Val(1) && fn_count >= 1024 {
        b1: fn_count /% 6
        b2: (fn_count * 2) /% 6
        b3: (fn_count * 3) /% 6
        b4: (fn_count * 4) /% 6
        b5: (fn_count * 5) /% 6
        ^chunks: [JetDriverBudgetEdgeChunk]{}
        task.group jet_driver_budget_edges {
            t0: task {
                ^cs: [[Int]]{}
                ^es: [[Int]]{}
                cs.try_reserve(b1) ?? ()
                es.try_reserve(b1) ?? ()
                loop idx in 0..<b1 {
                    ^c: [Int]{}
                    ^e: [Int]{}
                    has_row: rows[idx] >= 0
                    loop (edge_idx, edge) in functions[idx].effects.call_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(edge_idx) }
                    }
                    loop (edge_idx, edge) in functions[idx].effects.value_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(-(edge_idx + 1)) }
                    }
                    cs.push(c.move())
                    es.push(e.move())
                }
                jet_driver_budget_edge_chunk(cs.move(), es.move())
            }
            t1: task {
                ^cs: [[Int]]{}
                ^es: [[Int]]{}
                cs.try_reserve(b2 - b1) ?? ()
                es.try_reserve(b2 - b1) ?? ()
                loop idx in b1..<b2 {
                    ^c: [Int]{}
                    ^e: [Int]{}
                    has_row: rows[idx] >= 0
                    loop (edge_idx, edge) in functions[idx].effects.call_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(edge_idx) }
                    }
                    loop (edge_idx, edge) in functions[idx].effects.value_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(-(edge_idx + 1)) }
                    }
                    cs.push(c.move())
                    es.push(e.move())
                }
                jet_driver_budget_edge_chunk(cs.move(), es.move())
            }
            t2: task {
                ^cs: [[Int]]{}
                ^es: [[Int]]{}
                cs.try_reserve(b3 - b2) ?? ()
                es.try_reserve(b3 - b2) ?? ()
                loop idx in b2..<b3 {
                    ^c: [Int]{}
                    ^e: [Int]{}
                    has_row: rows[idx] >= 0
                    loop (edge_idx, edge) in functions[idx].effects.call_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(edge_idx) }
                    }
                    loop (edge_idx, edge) in functions[idx].effects.value_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(-(edge_idx + 1)) }
                    }
                    cs.push(c.move())
                    es.push(e.move())
                }
                jet_driver_budget_edge_chunk(cs.move(), es.move())
            }
            t3: task {
                ^cs: [[Int]]{}
                ^es: [[Int]]{}
                cs.try_reserve(b4 - b3) ?? ()
                es.try_reserve(b4 - b3) ?? ()
                loop idx in b3..<b4 {
                    ^c: [Int]{}
                    ^e: [Int]{}
                    has_row: rows[idx] >= 0
                    loop (edge_idx, edge) in functions[idx].effects.call_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(edge_idx) }
                    }
                    loop (edge_idx, edge) in functions[idx].effects.value_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(-(edge_idx + 1)) }
                    }
                    cs.push(c.move())
                    es.push(e.move())
                }
                jet_driver_budget_edge_chunk(cs.move(), es.move())
            }
            t4: task {
                ^cs: [[Int]]{}
                ^es: [[Int]]{}
                cs.try_reserve(b5 - b4) ?? ()
                es.try_reserve(b5 - b4) ?? ()
                loop idx in b4..<b5 {
                    ^c: [Int]{}
                    ^e: [Int]{}
                    has_row: rows[idx] >= 0
                    loop (edge_idx, edge) in functions[idx].effects.call_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(edge_idx) }
                    }
                    loop (edge_idx, edge) in functions[idx].effects.value_edges {
                        if ir_function_rows_get(by_key, edge) == .Val(callee) {
                            if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                        } else if has_row { e.push(-(edge_idx + 1)) }
                    }
                    cs.push(c.move())
                    es.push(e.move())
                }
                jet_driver_budget_edge_chunk(cs.move(), es.move())
            }
            ^cs5: [[Int]]{}
            ^es5: [[Int]]{}
            cs5.try_reserve(fn_count - b5) ?? ()
            es5.try_reserve(fn_count - b5) ?? ()
            loop idx in b5..<fn_count {
                ^c: [Int]{}
                ^e: [Int]{}
                has_row: rows[idx] >= 0
                loop (edge_idx, edge) in functions[idx].effects.call_edges {
                    if ir_function_rows_get(by_key, edge) == .Val(callee) {
                        if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                    } else if has_row { e.push(edge_idx) }
                }
                loop (edge_idx, edge) in functions[idx].effects.value_edges {
                    if ir_function_rows_get(by_key, edge) == .Val(callee) {
                        if !jet_driver_toolchain_env_read(functions[callee]) -> c.push(callee)
                    } else if has_row { e.push(-(edge_idx + 1)) }
                }
                cs5.push(c.move())
                es5.push(e.move())
            }
            chunks.push(compiler_threads_joined(t0))
            chunks.push(compiler_threads_joined(t1))
            chunks.push(compiler_threads_joined(t2))
            chunks.push(compiler_threads_joined(t3))
            chunks.push(compiler_threads_joined(t4))
            chunks.push(jet_driver_budget_edge_chunk(cs5.move(), es5.move()))
        }
        callees.try_reserve(fn_count) ?? ()
        extra_edges.try_reserve(fn_count) ?? ()
        loop chunk in chunks.move() {
            callees.extend(chunk.callees.move())
            extra_edges.extend(chunk.extra.move())
        }
        ^pending: [Int]{entry_row}
        loop pending.len() > 0 {
            index: pending.pop() ?? break
            if reached[index] -> next
            reached[index] = true
            order.push(index)
            loop callee in callees[index] -> pending.push(callee)
        }
    } else {
        callees = (loop _ in functions -> [Int]{})
        extra_edges = (loop _ in functions -> [Int]{})
        ^pending: [Int]{entry_row}
        loop pending.len() > 0 {
            index: pending.pop() ?? break
            if reached[index] -> next
            reached[index] = true
            order.push(index)
            has_row: rows[index] >= 0
            loop (edge_idx, edge) in functions[index].effects.call_edges {
                if ir_function_rows_get(by_key, edge) == .Val(callee) {
                    if jet_driver_toolchain_env_read(functions[callee]) -> next
                    callees[index].push(callee)
                    pending.push(callee)
                } else if has_row { extra_edges[index].push(edge_idx) }
            }
            loop (edge_idx, edge) in functions[index].effects.value_edges {
                if ir_function_rows_get(by_key, edge) == .Val(callee) {
                    if jet_driver_toolchain_env_read(functions[callee]) -> next
                    callees[index].push(callee)
                    pending.push(callee)
                } else if has_row { extra_edges[index].push(-(edge_idx + 1)) }
            }
        }
    }
    // The generated typed-CLI entry `__jet_cli_run…` and the parser it calls
    // read argv, print help and exit through Core as the toolchain's parse
    // (jet_driver_required_effects): those Core calls are not the package's
    // own code, so only the user functions they dispatch to are charged.
    ^cli: (loop _ in functions -> false)
    ^has_cli: false
    if functions[entry_row].name.starts_with("__jet_cli_run") {
        has_cli = true
        cli[entry_row] = true
        parse_name: functions[entry_row].name.replace("__jet_cli_run", "__jet_cli_parse")
        loop (index, function) in functions {
            if function.module_identity == functions[entry_row].module_identity && function.name == parse_name {
                cli[index] = true
            }
        }
    }
    // Each reached function's own-package effects, to a fixpoint over the
    // same-package and Core call and value edges. Intern the small set of
    // distinct effect names into bit positions and propagate in reverse
    // discovery order (callees before callers) with a single bitwise OR per
    // edge; fall back to list propagation only if >62 distinct names appear.
    ^effect_table: name_table_sized(64)
    ^local_bits: (loop _ in functions -> 0)
    ^overflow: false
    ^local: [[String]]{}
    loop index in order {
        if cli[index] -> next
        loop effect_name in functions[index].effects.direct {
            id: name_intern(effect_table, effect_name)
            bit: Int{id.id} - 1
            if bit < 62 -> local_bits[index] = local_bits[index] | (1 << bit) else {
                if !overflow {
                    overflow = true
                    local = (loop _ in functions -> [String]{})
                }
                text: name_text(effect_table, id)
                if !local[index].contains(text) -> local[index].push(text)
            }
        }
        // A package effect root a function's row names (no Prelude root
        // covers it, so `direct` doesn't show it).
        own_roots: jet_driver_package_effect_roots_of(package_roots, functions[index].key)
        loop effect_name in own_roots {
            id: name_intern(effect_table, effect_name)
            bit: Int{id.id} - 1
            if bit < 62 -> local_bits[index] = local_bits[index] | (1 << bit) else {
                if !overflow {
                    overflow = true
                    local = (loop _ in functions -> [String]{})
                }
                text: name_text(effect_table, id)
                if !local[index].contains(text) -> local[index].push(text)
            }
        }
        if functions[index].effects.call_edges.contains(EFFECT_PANIC_EDGE) {
            id: name_intern(effect_table, AUTHORITY_PANIC_ROOT)
            bit: Int{id.id} - 1
            if bit < 62 -> local_bits[index] = local_bits[index] | (1 << bit) else {
                if !overflow {
                    overflow = true
                    local = (loop _ in functions -> [String]{})
                }
                if !local[index].contains(AUTHORITY_PANIC_ROOT) {
                    local[index].push(AUTHORITY_PANIC_ROOT)
                }
            }
        }
    }
    effect_total: name_count(effect_table) - 1
    bit_count: if effect_total > 62 -> 62 else -> effect_total
    ^is_core: if has_cli -> (loop f in functions -> f.module_name.starts_with("core.")) else -> [Bool]{}
    if !overflow {
        ^changed: true
        loop changed {
            changed = false
            ^at: order.len() - 1
            loop at >= 0 {
                index: order[at]
                at -= 1
                owner: if rows[index] < 0 -> "" else -> owners[rows[index]]
                ^before: local_bits[index]
                ^bits: before
                is_cli: has_cli && cli[index]
                loop callee in callees[index] {
                    if rows[callee] >= 0 && owners[rows[callee]] != owner -> next
                    if is_cli && is_core[callee] -> next
                    bits = bits | local_bits[callee]
                }
                if bits != before {
                    local_bits[index] = bits
                    changed = true
                }
            }
        }
    } else {
        loop index in order {
            ^bits: local_bits[index]
            if bits == 0 -> next
            loop k in 0..<bit_count {
                if (bits & (1 << k)) != 0 {
                    text: name_text(effect_table, Name{id: U32{k + 1}})
                    if !local[index].contains(text) -> local[index].push(text)
                }
            }
        }
        ^changed: true
        loop changed {
            changed = false
            ^at: order.len() - 1
            loop at >= 0 {
                index: order[at]
                at -= 1
                owner: if rows[index] < 0 -> "" else -> owners[rows[index]]
                loop callee in callees[index] {
                    if rows[callee] >= 0 && owners[rows[callee]] != owner -> next
                    if has_cli && cli[index] && is_core[callee] -> next
                    reached_effects: local[callee].copy()
                    loop effect_name in reached_effects {
                        if local[index].contains(effect_name) -> next
                        local[index].push(effect_name)
                        changed = true
                    }
                }
            }
        }
    }
    // The enforcer's keys: `module.function`, a method `module.Type.name`.
    // Only entry-reachable functions participate in pkg_compute_package_effects;
    // keep function_keys in function index order so witness order is unchanged,
    // and insert into the sorted String maps in ascending key order (O(1) append
    // instead of O(N^2) shifts across tens of thousands of keys).
    ^sites: (loop _ in functions -> "")
    ^effect_keys: (loop _ in functions -> "")
    ^sited: [Int]{}
    sited.try_reserve(order.len()) ?? ()
    loop (index, function) in functions {
        if !reached[index] -> next
        row: rows[index]
        if row < 0 -> next
        ^effect_key: sema_effect_chain_name(function)
        sites[index] = "{program.modules[row].alias}.{effect_key}"
        effect_keys[index] = effect_key
        program.modules[row].function_keys.push(effect_key.move())
        sited.push(index)
    }
    site_keys: sites
    sited.sort_by(fn(left: Int, right: Int) { (site_keys[left] <=> site_keys[right]).then(left <=> right) })
    ^summaries: [String:PackageEffectSummary]{}
    ^solved: [String:[String]]{}
    if threads.cap != Val(1) && sited.len() >= 1024 && !overflow {
        task.group driver_budget_maps {
            t_summaries: task {
                ^out_s: summaries.move()
                loop index in sited {
                    function: functions[index]
                    ^kept_edges: [String]{}
                    loop callee in callees[index] {
                        if site_keys[callee] != "" -> kept_edges.push(site_keys[callee].copy())
                    }
                    loop edge_idx in extra_edges[index] {
                        text: if edge_idx >= 0 -> function.effects.call_edges[edge_idx] else -> function.effects.value_edges[-(edge_idx + 1)]
                        kept_edges.push(text.copy())
                    }
                    out_s[site_keys[index]] = PackageEffectSummary{direct: function.effects.direct.copy(), edges: kept_edges.move(), maximal: false}
                }
                out_s.move()
            }
            t_solved: task {
                ^out_v: solved.move()
                loop index in sited {
                    ^effects: [String]{}
                    bits: local_bits[index]
                    if bits != 0 {
                        loop k in 0..<bit_count {
                            if (bits & (1 << k)) != 0 {
                                effects.push(name_text(effect_table, Name{id: U32{k + 1}}))
                            }
                        }
                    }
                    out_v[site_keys[index]] = effects.move()
                }
                out_v.move()
            }
            loop index in sited {
                function: functions[index]
                row: rows[index]
                program.modules[row].function_spans[effect_keys[index]] = jet_driver_budget_name_span_of(name_spans, function.key) ?? function.source_span
            }
            summaries = compiler_threads_joined(t_summaries)
            solved = compiler_threads_joined(t_solved)
        }
    } else {
        loop index in sited {
            function: functions[index]
            row: rows[index]
            // A witness is the function's name; a function registration does not
            // name (a lambda, a generated body) is its declaration.
            program.modules[row].function_spans[effect_keys[index]] = jet_driver_budget_name_span_of(name_spans, function.key) ?? function.source_span
            // A same-package edge names its callee's site, and one to a callee
            // with no site leaves, built from the already-resolved BFS edges.
            ^kept_edges: [String]{}
            loop callee in callees[index] {
                if site_keys[callee] != "" -> kept_edges.push("{site_keys[callee]}")
            }
            loop edge_idx in extra_edges[index] {
                text: if edge_idx >= 0 -> function.effects.call_edges[edge_idx] else -> function.effects.value_edges[-(edge_idx + 1)]
                kept_edges.push("{text}")
            }
            ^direct_rows: loop eff in function.effects.direct -> "{eff}"
            summaries[site_keys[index]] = PackageEffectSummary{direct: direct_rows.move(), edges: kept_edges.move(), maximal: false}
            if !overflow {
                ^effects: [String]{}
                bits: local_bits[index]
                if bits != 0 {
                    loop k in 0..<bit_count {
                        if (bits & (1 << k)) != 0 {
                            effects.push(name_text(effect_table, Name{id: U32{k + 1}}))
                        }
                    }
                }
                solved[site_keys[index]] = effects.move()
            } else { solved[site_keys[index]] = compiler_take_rows<String>(local[index]) }
        }
    }
    entry_module: module_rows.get(load.entry_module_identity.id) ?? rows[entry_row]
    program.entry = entry_module
    loop edge in load.imports {
        if edge.source_module_identity != load.entry_module_identity -> next
        name: jet_driver_dependency_name(dep_names, edge.target_package_identity) ?? next
        span: if edge.declaration.kind == {
            .Module(_, module_span) -> module_span
            .Unqualified(_, alias_span, _, _, _) -> alias_span
            .File(_, file_span) -> file_span
        }
        program.modules[entry_module].imports.push(EffectBudgetImport{name: name.move(), span: span})
    }
    program.selected_output = Val(EffectBudgetOutput{module_index: rows[entry_row], semantic_name: sema_effect_chain_name(functions[entry_row])})
    entries: pkg_compute_package_effects(program, solved, summaries)
    Val(JetDriverPackageEffectRows{program: program.move(), module_identities: module_identities.move(), entries: entries})
}

// The package effect budget (syntax-decisions.md:3362-3366): an `authority`
// `allow` or `deny` row holds every package of the build, and
// `authority.grants` widens it for one named dependency. A dependency whose
// row (`rows`, jet_driver_package_effect_rows) reaches an effect outside the
// budget is E1220. The root package's written `allow` row is a ceiling over
// its own code: reaching an effect outside it is E0749 at check time, so a
// run never names an effect the row leaves out (spec.md "Application
// authority"). A `deny` over the root's own code is sema's E0749, checked at
// every function of the package. The written `allow` row adds to the
// beginner floor every program holds (spec.md:1764-1769). A row's `FS.Read("<path>")` grant
// holds `FS.Read` itself, as `jet run --allow='FS.Read("<path>")'` does: the
// run's reads are confined to its paths (jet-cli Authority.jet
// jet_cli_merged_read_scope). No budget, no diagnostic.
jet_driver_effect_budget_diagnostics: fn(load: JetDriverLoadResult, rows: JetDriverPackageEffectRows) -> [Diagnostic] {
    root: load.packages[jet_driver_effect_budget_root(load) ?? return [Diagnostic]{}]
    ^manifest: PackageFacts.default()
    manifest.effects_enabled = true
    ceiling: if authority_expert_only(root.authority_allow ?? [String]{}) -> None else -> root.authority_allow
    if ceiling == .Val(allow) {
        ^row: [String]{}
        loop name in AUTHORITY_AMBIENT_BASIC_EFFECTS -> row.push(name)
        loop name in allow -> row.push(name.copy())
        if effect_scope_read_paths(allow).len() > 0 -> row.push("FS.Read")
        manifest.authority.allow = Val(row.move())
    }
    manifest.authority.deny = root.authority_deny
    manifest.authority.grants = root.authority_grants
    ^enforced: pkg_effect_enforce(rows.entries, manifest)
    out: loop diagnostic in enforced.move() -> jet_driver_effect_budget_located(load, rows.program, rows.module_identities, diagnostic.move())
    out
}

// A failed budget's result. An E1220 at a dependency's function is the root's
// budget refusing that dependency, not an error of the dependency's own
// check, so it joins the diagnostics after the dependency summary; the
// root's own E0749 follows the same path.
jet_driver_effect_budget_failure: fn(load: JetDriverLoadResult, budget: ^^[Diagnostic], trace: JetDriverCompileTrace) -> JetDriverCompileResult Never! {
    ^result: jet_driver_compile_result(load, load.diagnostics, Val(JetDriverStage.Assemble), false, trace)
    result.diagnostics.extend(budget.move())
    result
}

// A budget diagnostic (E1220, E0749) at its source: a witness names its
// module's path, a dependency boundary sits in the entry module.
jet_driver_effect_budget_located: fn(load: JetDriverLoadResult, program: EffectBudgetProgram, module_identities: [ModuleID], diagnostic: ^^Diagnostic) -> Diagnostic Never! {
    span: diagnostic.span ?? return diagnostic
    ^identity: load.entry_module_identity
    if diagnostic.source_path == .Val(path) {
        identity = module_none()
        loop (index, loaded) in program.modules {
            if loaded.path == path -> identity = module_identities[index]
        }
    }
    location: jet_driver_source_location_for_load_module(load, identity, span) ?? return diagnostic
    diagnostic_with_source_mapping(diagnostic, location.source_path, location.aggregate_start, location.source_start)
}

// Ends `driver.result` (items: the result's diagnostics, which the host
// presents next) and opens `driver.release`: the compile's remaining locals
// (graphs, load, checked rows) drop as jet_driver_compile_loaded_stages
// returns, and its caller closes the span (jet_driver_trace_released).
jet_driver_trace_result_built: fn(trace_sink: CompilerTraceSink?, diagnostics: Int) {
    if trace_sink == .Val(sink) {
        sink.end("driver.result", diagnostics)
        sink.begin("driver.release", "", -1, -1)
    }
}

// Closes `driver.release` after jet_driver_compile_loaded_stages returns, and
// a `driver.result` an early return after it opened left open.
jet_driver_trace_released: fn(trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        sink.end("driver.release", -1)
        sink.end("driver.result", -1)
    }
}

// `keepgoing.final` (jet_driver_compile_keep_going's rows past the stages)
// opens and closes through these parameters, not a match on the request
// inline: that request is an owned (`^^`) parameter, a local to the Rust
// tier (stage 0), which reads a pattern payload of a local's field by copy
// (in place only under a parameter), and a trace sink, a
// trait object, has no copy (E0599).
jet_driver_trace_keep_going_begin: fn(trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) -> sink.begin("keepgoing.final", "", -1, -1)
}

jet_driver_trace_keep_going_end: fn(trace_sink: CompilerTraceSink?, rows: Int) {
    if trace_sink == .Val(sink) -> sink.end("keepgoing.final", rows)
}

jet_driver_core_source_alias: fn(unit: JetDriverSourceUnit, loaded_module: JetDriverLoadedModule, core_sources: [JetDriverCoreSource]) -> String Never! {
    if !jet_driver_unit_is_core(unit) || unit.file_index < 0 || unit.file_index >= core_sources.len() {
        return ""
    }
    owner: core_sources[unit.file_index]
    if owner.path != unit.relative_path || owner.module_name != loaded_module.module_name {
        return ""
    }
    owner.alias
}

// Per-chunk output of Pass A (decl-row lookup, L2511 cost sites, L0306 float
// seed hits, L0308 SQL row-loop hits).
JetDriverTidyPartA: struct {
    body_rows: [Int],
    body_positions: [Int],
    cost_sites: [TCostSite],
    float_hits: [JetDriverFloatSeedHit],
    sql_hits: [JetDriverSQLRowHit],
}

jet_driver_tidy_pass_a_range: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, interner: Interner, start: Int, end: Int, collect_cost: Bool) -> JetDriverTidyPartA Never! {
    ^body_rows: [Int]{}
    ^body_positions: [Int]{}
    ^cost_sites: [TCostSite]{}
    ^float_hits: [JetDriverFloatSeedHit]{}
    ^sql_hits: [JetDriverSQLRowHit]{}
    loop pos in start..<end {
        function: functions[pos]
        if decl_table_find(decls, symbols, function.key) == .Val(id) {
            body_rows.push(id.row.index())
            body_positions.push(pos)
        }
        if collect_cost -> jet_driver_cost_tidy_function_sites(function, interner, cost_sites)
        jet_driver_float_seed_function_hits(pos, function, symbols, float_hits)
        jet_driver_sql_row_loop_function_hits(pos, function, symbols, interner, sql_hits)
    }
    JetDriverTidyPartA{body_rows: body_rows, body_positions: body_positions, cost_sites: cost_sites, float_hits: float_hits, sql_hits: sql_hits}
}

jet_driver_tidy_pass_a_threads: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, interner: Interner, starts: [Int], ends: [Int], at: Int, collect_cost: Bool) -> [JetDriverTidyPartA] {
    if at >= starts.len() -> return [JetDriverTidyPartA]{}
    if at + 1 == starts.len() {
        return [JetDriverTidyPartA]{jet_driver_tidy_pass_a_range(functions, decls, symbols, interner, starts[at], ends[at], collect_cost)}
    }
    ^out: [JetDriverTidyPartA]{}
    task.group driver_tidy_a {
        head: task jet_driver_tidy_pass_a_range(functions, decls, symbols, interner, starts[at], ends[at], collect_cost)
        ^rest: jet_driver_tidy_pass_a_threads(functions, decls, symbols, interner, starts, ends, at + 1, collect_cost)
        out.push(compiler_threads_joined(head))
        compiler_transfer_rows<JetDriverTidyPartA>(out, rest)
    }
    out
}

jet_driver_tidy_pass_b_threads: fn(functions: [FnBody], bodies: [Int?], decls: DeclTable, starts: [Int], ends: [Int], at: Int) -> [[[Int]]] {
    if at >= starts.len() -> return [[[Int]]]{}
    if at + 1 == starts.len() {
        return [[[Int]]]{jet_driver_recursion_calls_range(functions, bodies, decls, starts[at], ends[at])}
    }
    ^out: [[[Int]]]{}
    task.group driver_tidy_b {
        head: task jet_driver_recursion_calls_range(functions, bodies, decls, starts[at], ends[at])
        ^rest: jet_driver_tidy_pass_b_threads(functions, bodies, decls, starts, ends, at + 1)
        out.push(compiler_threads_joined(head))
        compiler_transfer_rows<[[Int]]>(out, rest)
    }
    out
}

// Runs the four post-check tidy lint passes (L2511, L0305, L0306, L0308) in
// parallel across `threads`, and filters `#Allow` only across modules that
// produced a lint.
jet_driver_run_tidy_lints: fn(load: ^JetDriverLoadResult, checked_functions: [FnBody], registration_graph: SemaRegistrationGraph, collect_cost: Bool, threads: CompilerThreads, trace_sink: CompilerTraceSink?) {
    jet_driver_trace_step_begin(trace_sink, "driver.tidy")
    count: checked_functions.len()
    workers: compiler_threads_admit(threads, count, count, 256, 0, 0)
    decls_count: registration_graph.decls.rows.len()
    ^cost_sites: [TCostSite]{}
    ^float_hits: [JetDriverFloatSeedHit]{}
    ^sql_hits: [JetDriverSQLRowHit]{}
    ^bodies: [Int?]{}
    loop _ in 0..<decls_count -> bodies.push(None)
    ^calls: [[Int]]{}
    if workers <= 1 {
        loop pos in 0..<count {
            function: checked_functions[pos]
            if decl_table_find(registration_graph.decls, registration_graph.symbols, function.key) == .Val(id) {
                bodies[id.row.index()] = Val(pos)
            }
            if collect_cost {
                jet_driver_cost_tidy_function_sites(function, registration_graph.interner, cost_sites)
            }
            jet_driver_float_seed_function_hits(pos, function, registration_graph.symbols, float_hits)
            jet_driver_sql_row_loop_function_hits(pos, function, registration_graph.symbols, registration_graph.interner, sql_hits)
        }
        calls = jet_driver_recursion_calls_range(checked_functions, bodies, registration_graph.decls, 0, count)
    } else {
        ^starts: [Int]{}
        ^ends: [Int]{}
        loop w in 0..<workers {
            s: (w * count) /% workers
            e: ((w + 1) * count) /% workers
            if s < e {
                starts.push(s)
                ends.push(e)
            }
        }
        ^parts_a: jet_driver_tidy_pass_a_threads(checked_functions, registration_graph.decls, registration_graph.symbols, registration_graph.interner, starts, ends, 0, collect_cost)
        loop part in parts_a.move() {
            loop i in 0..<part.body_rows.len() {
                bodies[part.body_rows[i]] = Val(part.body_positions[i])
            }
            ^part_cost: part.cost_sites.move()
            compiler_transfer_rows<TCostSite>(cost_sites, part_cost)
            ^part_float: part.float_hits.move()
            compiler_transfer_rows<JetDriverFloatSeedHit>(float_hits, part_float)
            ^part_sql: part.sql_hits.move()
            compiler_transfer_rows<JetDriverSQLRowHit>(sql_hits, part_sql)
        }
        ^parts_b: jet_driver_tidy_pass_b_threads(checked_functions, bodies, registration_graph.decls, starts, ends, 0)
        loop part_calls in parts_b.move() {
            ^moved_part: part_calls.move()
            compiler_transfer_rows<[Int]>(calls, moved_part)
        }
    }
    ^tidy: if collect_cost -> jet_driver_cost_sites_to_lints(load, cost_sites) else -> [Diagnostic]{}
    loop lint in jet_driver_recursion_lints_from_calls(load, checked_functions, bodies, registration_graph.decls, calls, threads) {
        tidy.push(lint)
    }
    loop lint in jet_driver_float_seed_hits_to_lints(load, checked_functions, float_hits) {
        tidy.push(lint)
    }
    loop lint in jet_driver_sql_row_loop_hits_to_lints(load, checked_functions, sql_hits) {
        tidy.push(lint)
    }
    ^allowances: [SemaLintAllowance]{}
    if tidy.len() > 0 {
        ^wanted: name_table_sized(16)
        loop lint in tidy {
            if lint.source_path == .Val(path) -> ^_: name_intern(wanted, path)
        }
        loop module_index in 0..<registration_graph.modules.len() {
            ^matched: name_find(wanted, registration_graph.modules[module_index].source_file) != None
            if !matched {
                loop segment in registration_graph.modules[module_index].source_segments {
                    if name_find(wanted, segment.source_file) != None {
                        matched = true
                        break
                    }
                }
            }
            if matched {
                sema_lint_allowances(registration_graph.modules[module_index].program, registration_graph.modules[module_index].source_segments, allowances)
            }
        }
    }
    loop lint in tidy.move() {
        if !sema_lint_allowed(lint, allowances) -> load.diagnostics.push(lint)
    }
    jet_driver_trace_step_end(trace_sink, "driver.tidy", count)
}

JetDriverBadOwner: struct {
    module_index: Int,
    function_index: Int,
}

jet_driver_verify_owners_parallel: fn(modules: [SemaGraphModuleResult], registered_function_keys: JetDriverRegisteredKeys, threads: CompilerThreads) -> [JetDriverBadOwner] Never! {
    count: modules.len()
    ^weights: [Int]{}
    weights.try_reserve(count) ?? ()
    ^total: 0
    loop m in modules {
        w: 1 + m.functions.len()
        weights.push(w)
        total += w
    }
    admitted: compiler_threads_admit(threads, count, total, 512, 0, 0)
    workers: if admitted > 8 -> 8 else -> admitted
    if workers <= 1 {
        return jet_driver_verify_owners_chunk(modules, registered_function_keys, 0, count)
    }
    target: (total + workers - 1) /% workers
    ^bounds: [Int]{0}
    ^acc: 0
    loop idx in 0..<count {
        acc += weights[idx]
        if acc >= target && bounds.len() < workers && idx + 1 < count {
            bounds.push(idx + 1)
            acc = 0
        }
    }
    bounds.push(count)
    parts: jet_driver_verify_owners_ranges(modules, registered_function_keys, bounds, 0)
    ^out: [JetDriverBadOwner]{}
    loop part in parts {
        loop hit in part -> out.push(hit)
    }
    out
}

jet_driver_verify_owners_ranges: fn(modules: [SemaGraphModuleResult], registered_function_keys: JetDriverRegisteredKeys, bounds: [Int], at: Int) -> [[JetDriverBadOwner]] Never! {
    last: bounds.len() - 2
    if at > last -> return [[JetDriverBadOwner]]{}
    if at == last {
        return [[JetDriverBadOwner]]{jet_driver_verify_owners_chunk(modules, registered_function_keys, bounds[at], bounds[at + 1])}
    }
    ^out: [[JetDriverBadOwner]]{}
    task.group jet_driver_verify_owners_group {
        head: task jet_driver_verify_owners_chunk(modules, registered_function_keys, bounds[at], bounds[at + 1])
        rest: jet_driver_verify_owners_ranges(modules, registered_function_keys, bounds, at + 1)
        out.push(compiler_threads_joined(head))
        loop part in rest -> out.push(part)
    }
    out
}

jet_driver_verify_owners_chunk: fn(modules: [SemaGraphModuleResult], registered_function_keys: JetDriverRegisteredKeys, start: Int, end: Int) -> [JetDriverBadOwner] Never! {
    ^bad: [JetDriverBadOwner]{}
    loop graph_module_index in start..<end {
        graph_module: modules[graph_module_index]
        module_keys: registered_function_keys.modules.get(graph_module.module_identity.id) ?? -1
        loop function_index in 0..<graph_module.functions.len() {
            function: graph_module.functions[function_index]
            registered: (module_keys >= 0 && function.key != "" && name_find(registered_function_keys.keys[module_keys], function.key) != None) || graph_module.injected_function_keys.contains(function.key)
            if function.module_identity != graph_module.module_identity || !registered {
                bad.push(JetDriverBadOwner{module_index: graph_module_index, function_index: function_index})
            }
        }
    }
    bad
}
