fn jet_driver_source_location_for_load_module(load: JetDriverLoadResult, module_identity: String, site: Span) -> SemaSourceLocation? {
    selected_index := Int?{None}
    index := 0
    loop index < load.modules.len() {
        if load.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index :: selected_index ?? return None
    loaded_module :: load.modules[module_index]
    if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() -> return None
    sema_source_location_at(load.source_units[loaded_module.source_unit_index].source_segments, site)
}

fn jet_driver_source_location_for_registration_module(graph: SemaRegistrationGraph, module_identity: String, site: Span) -> SemaSourceLocation? {
    selected_index := Int?{None}
    index := 0
    loop index < graph.modules.len() {
        if graph.modules[index].module_identity == module_identity {
            if selected_index != None -> return None
            selected_index = Val(index)
        }
        index += 1
    }
    module_index :: selected_index ?? return None
    sema_source_location_at(graph.modules[module_index].source_segments, site)
}

fn jet_driver_diagnostic_with_location(code: String, span: Span, location: SemaSourceLocation?, what: String, why: String, fix: String) -> Diagnostic {
    exact_location :: location ?? return jet_driver_diagnostic(code, span, what, why, fix)
    diagnostic := jet_driver_diagnostic(code, span, what, why, fix)
    diagnostic_with_source_mapping(^diagnostic, exact_location.source_path, exact_location.aggregate_start, exact_location.source_start)
}

fn jet_driver_diagnostic_at_registration_site(graph: SemaRegistrationGraph, module_identity: String, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    location := jet_driver_source_location_for_registration_module(graph, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}

// The registration-site diagnostic on the graph `program` owns (a comptime
// run's tables).
fn jet_driver_diagnostic_at_program_site(program: SemaProgramTables, module_identity: String, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    graph_option :: program.registration_graph
    graph :: graph_option ?? return jet_driver_diagnostic_with_location(code, span, None, what, why, fix)
    jet_driver_diagnostic_at_registration_site(graph, module_identity, code, span, what, why, fix)
}

fn jet_driver_diagnostic_at_loaded_site(load: JetDriverLoadResult, module_identity: String, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    location := jet_driver_source_location_for_load_module(load, module_identity, span)
    jet_driver_diagnostic_with_location(code, span, location, what, why, fix)
}
fn jet_driver_diagnostic_at_optional_loaded_site(load: JetDriverLoadResult, module_identity: String?, code: String, span: Span, what: String, why: String, fix: String) -> Diagnostic {
    exact_module_identity :: module_identity ?? return jet_driver_diagnostic(code, span, what, why, fix)
    jet_driver_diagnostic_at_loaded_site(load, exact_module_identity, code, span, what, why, fix)
}

fn jet_driver_diagnostic_with_optional_location(code: String, span: Span?, location: SemaSourceLocation?, what: String, why: String, fix: String) -> Diagnostic {
    if span != None {
        site :: span
        return jet_driver_diagnostic_with_location(code, site, location, what, why, fix)
    }
    jet_driver_diagnostic_with_optional_span(code, span, what, why, fix)
}

// One checked function's owning module: what an optimizer error needs to
// locate its function after the optimizer has consumed the program.
struct JetDriverMIRFunctionOwner {
    function: MIRFunctionID
    module_id: MIRModuleID
}

fn jet_driver_mir_function_owners(program: MIRProgram) -> [JetDriverMIRFunctionOwner] {
    owners := [JetDriverMIRFunctionOwner]{}
    loop function in program.functions -> &owners.push(JetDriverMIRFunctionOwner{function: function.id, module_id: function.module_id})
    owners
}

fn jet_driver_source_location_for_mir_function(load: JetDriverLoadResult, owners: [JetDriverMIRFunctionOwner], identity: MIRFunctionID, site: Span) -> SemaSourceLocation? {
    selected_owner := JetDriverMIRFunctionOwner?{None}
    loop owner in owners {
        if owner.function.value == identity.value {
            if selected_owner != None -> return None
            selected_owner = Val(owner)
        }
    }
    function_owner :: selected_owner ?? return None
    selected_module_identity := String?{None}
    loop loaded_module in load.modules {
        if mir_module_id(loaded_module.module_identity).value == function_owner.module_id.value {
            if selected_module_identity != None -> return None
            selected_module_identity = Val(loaded_module.module_identity)
        }
    }
    module_identity :: selected_module_identity ?? return None
    jet_driver_source_location_for_load_module(load, module_identity, site)
}
fn jet_driver_attach_registration_source_location(diagnostic: Diagnostic, graph: SemaRegistrationGraph, module_identity: String) -> Diagnostic Never! {
    // copy: the attached diagnostic is a new owned row. If it already has a location it equals
    // `diagnostic`, which the caller keeps in its list (a read parameter).
    if diagnostic.source_path != None || diagnostic.span == None -> return diagnostic.copy()
    span :: diagnostic.span ?? return diagnostic
    location :: jet_driver_source_location_for_registration_module(graph, module_identity, span) ?? return diagnostic
    // copy: `diagnostic` is a read parameter; the source-mapped result owns its own value.
    diagnostic_with_source_mapping(diagnostic.copy(), location.source_path, location.aggregate_start, location.source_start)
}
// jet_driver_attach_registration_source_location on the graph `program` owns
// (a comptime run's tables).
fn jet_driver_attach_program_source_location(diagnostic: Diagnostic, program: SemaProgramTables, module_identity: String) -> Diagnostic Never! {
    graph_option :: program.registration_graph
    // copy: the attached diagnostic is a new owned row. Without a registration graph it equals
    // `diagnostic`, which the caller keeps in its list (a read parameter).
    graph :: graph_option ?? return diagnostic.copy()
    jet_driver_attach_registration_source_location(diagnostic, graph, module_identity)
}
fn jet_driver_module_display(relative_path: String) -> String Never! {
    parts := relative_path.split("/").to_list()
    file_name :: &parts.pop() ?? "module.jet"
    name_parts := file_name.split(".").to_list()
    if name_parts.len() > 1 -> _ := &name_parts.pop()
    file_base := name_parts.join(".")
    if file_base.len() == 0 -> file_base = "module"
    &parts.push(file_base)
    parts.join("/")
}

struct JetDriverMIRItemOrderRow {
    position: Int
    item: MIRItemRef
}

// Rows are appended in category order and stably sorted by source position
// once per module, rather than insertion-sorted per declaration.
fn jet_driver_add_mir_item_order(rows: &[JetDriverMIRItemOrderRow], position: Int, item: MIRItemRef) Never! {
    &rows.push(JetDriverMIRItemOrderRow{position: position, item: item})
}

fn jet_driver_find_lowered_function_id(functions: [MIRFunction], key: String) -> MIRFunctionID? {
    found := MIRFunctionID?{None}
    loop function in functions {
        if function.key == key {
            if found != None -> return None
            found = Val(function.id)
        }
    }
    found
}
fn jet_driver_has_mir_function_id(functions: [MIRFunction], identity: MIRFunctionID) -> Bool Never! {
    loop function in functions {
        if function.id.value == identity.value -> return true
    }
    false
}
fn jet_driver_mir_function_index_for_id(functions: [MIRFunction], identity: MIRFunctionID) -> Int? {
    selected := Int?{None}
    index := 0
    loop function in functions {
        if function.id.value == identity.value {
            if selected != None -> return None
            selected = Val(index)
        }
        index += 1
    }
    selected
}

// Function ID -> its row, or -1 when the ID repeats (as
// jet_driver_mir_function_index_for_id, for many lookups in one pass).
fn jet_driver_mir_function_rows(functions: [MIRFunction]) -> [U64:Int] Never! {
    rows := [U64:Int]{}
    loop (index, function) in functions {
        if rows.get(function.id.value) == None {
            &rows.add(function.id.value, index).drop("checked absent above")
        } else {
            &rows.add(function.id.value, -1).drop("a repeated identity has no single row")
        }
    }
    rows
}

fn jet_driver_loaded_module_index_for_mir_module(load: JetDriverLoadResult, identity: MIRModuleID) -> Int? {
    selected := Int?{None}
    index := 0
    loop index < load.modules.len() {
        if mir_module_id(load.modules[index].module_identity).value == identity.value {
            if selected != None -> return None
            selected = Val(index)
        }
        index += 1
    }
    selected
}

// The loaded-module lookups of one MIR assembly, built once instead of
// rescanning (and rehashing) every loaded module and source file per row:
// the loaded module of each MIR module ID (-1 when several loaded modules
// share it, as jet_driver_loaded_module_index_for_mir_module), the authorized
// source file of each loaded module (None without an exact record), and the
// authorized source-file IDs.
struct JetDriverAssemblyIndex {
    module_rows: [U64:Int]
    module_source_files: [MIRSourceFileID?]
    source_files: [U64:Bool]
}

fn jet_driver_assembly_index(load: JetDriverLoadResult) -> JetDriverAssemblyIndex Never! {
    index := JetDriverAssemblyIndex{module_rows: [U64:Int]{}, module_source_files: [MIRSourceFileID?]{}, source_files: [U64:Bool]{}}
    loop file in load.source_files -> index.source_files[file.id.value] = true
    loop (row, loaded_module) in load.modules {
        module_value :: mir_module_id(loaded_module.module_identity).value
        if index.module_rows.get(module_value) == None {
            index.module_rows[module_value] = row
        } else {
            index.module_rows[module_value] = -1
        }
        source_file := MIRSourceFileID?{None}
        unit_index :: loaded_module.source_unit_index
        if unit_index >= 0 && unit_index < load.source_units.len() {
            unit_file :: mir_source_file_id(load.source_units[unit_index].path)
            if index.source_files.get(unit_file.value) != None -> source_file = Val(unit_file)
        }
        &index.module_source_files.push(source_file)
    }
    index
}

fn jet_driver_assembly_module_index(index: JetDriverAssemblyIndex, identity: MIRModuleID) -> Int? Never! {
    row :: index.module_rows.get(identity.value) ?? return None
    if row < 0 -> return None
    Val(row)
}

// Rows grouped by a U64 key without copying a per-key list on each append:
// `heads` maps a key to its first row and `next` links each row to the next
// row with the same key (-1 after the last), in row order.
struct JetDriverRowChains {
    heads: [U64:Int]
    tails: [U64:Int]
    next: [Int]
}

fn jet_driver_row_chains_new() -> JetDriverRowChains Never! {
    JetDriverRowChains{heads: [U64:Int]{}, tails: [U64:Int]{}, next: [Int]{}}
}

// Appends the next row (row number = rows added so far) under `key`.
fn jet_driver_row_chains_add(chains: &JetDriverRowChains, key: U64) Never! {
    row :: chains.next.len()
    &chains.next.push(-1)
    if chains.tails.get(key) == .Val(tail) {
        chains.next[tail] = row
    } else {
        chains.heads[key] = row
    }
    chains.tails[key] = row
}

// Lowered declaration -> its row, or -1 when it repeats (the unique-match
// rule of jet_driver_find_lowered_function_id), for the import bindings of
// one assembly. Functions are found by their symbol key; types, traits and
// constants by `module id\nname` (jet_driver_lowered_member_key), because
// their row keys are not symbol keys (types and constants are keyed
// `module::name`, traits by name, compiler-owned enums by name), so a symbol
// key never found an imported type, trait or runtime constant.
struct JetDriverLoweredKeyRows {
    functions: [String:Int]
    types: [String:Int]
    traits: [String:Int]
    constants: [String:Int]
}

fn jet_driver_key_row_add(rows: &[String:Int], key: String, row: Int) Never! {
    if rows.get(key) == None {
        rows[key] = row
    } else {
        rows[key] = -1
    }
}

fn jet_driver_lowered_key_rows(lowered: JetCodegenFunctions) -> JetDriverLoweredKeyRows Never! {
    rows := JetDriverLoweredKeyRows{functions: [String:Int]{}, types: [String:Int]{}, traits: [String:Int]{}, constants: [String:Int]{}}
    loop (row, function) in lowered.functions {
        jet_driver_key_row_add(&rows.functions, function.key, row)
    }
    loop (row, definition) in lowered.types {
        jet_driver_key_row_add(&rows.types, jet_driver_lowered_member_key(definition.module_id, definition.name), row)
    }
    loop (row, definition) in lowered.traits {
        jet_driver_key_row_add(&rows.traits, jet_driver_lowered_member_key(definition.module_id, definition.name), row)
    }
    loop (row, definition) in lowered.constants {
        jet_driver_key_row_add(&rows.constants, jet_driver_lowered_member_key(definition.module_id, definition.name), row)
    }
    rows
}

fn jet_driver_lowered_member_key(module_id: MIRModuleID, name: String) -> String Never! {
    "{module_id.value}\n{name}"
}

// The lowered-row key of an imported nominal or constant: its declaring
// module and declared name. The binding's `symbol.name` is the local spelling
// (`use m.[Record as Row]` binds `Row`), so the declared name is read from the
// unchanged symbol identity `symbol_id(kind, module, "", name)` instead.
fn jet_driver_import_member_key(binding: SemaRegistrationImportBinding) -> String? Never! {
    prefix :: symbol_id(binding.symbol.kind, binding.symbol.module_name, "", "").key
    key :: binding.symbol.id.key
    if !key.starts_with(prefix) -> return None
    bytes :: key.bytes()
    name :: String.from_bytes(bytes[prefix.bytes().len()..<bytes.len()]) ?? return None
    Val(jet_driver_lowered_member_key(mir_module_id(binding.target_module_identity), name))
}

fn jet_driver_diagnostic_at_loaded_module_index(
    load: JetDriverLoadResult,
    module_index: Int?,
    code: String,
    span: Span,
    what: String,
    why: String,
    fix: String,
) -> Diagnostic {
    index :: module_index ?? return jet_driver_diagnostic(code, span, what, why, fix)
    jet_driver_diagnostic_at_loaded_site(load, load.modules[index].module_identity, code, span, what, why, fix)
}

fn jet_driver_mir_span_equal(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}
fn jet_driver_mir_access_matches_foreign_convention(access: MIRAccess, convention: AccessConvention) -> Bool Never! {
    if convention == AccessConvention.Read -> return access == MIRAccess.Read
    if convention == AccessConvention.Write -> return access == MIRAccess.Write
    access == MIRAccess.Move
}
fn jet_driver_mir_foreign_matches_checked(foreign: MIRForeign, checked: SemaCheckedForeignFunction) -> Bool Never! {
    if foreign.key != checked.key ||
       foreign.module_name != checked.module_name ||
       foreign.name != checked.name ||
       foreign.span.start != checked.span.start ||
       foreign.span.end != checked.span.end ||
       foreign.symbol != checked.symbol ||
       foreign.path != checked.path ||
       foreign.raw_scalar_abi != checked.raw_scalar_abi ||
       foreign.bridge_eligible != checked.bridge_eligible ||
       foreign.params.len() != checked.params.len() -> return false
    index := 0
    loop index < foreign.params.len() {
        mir_param := foreign.params[index]
        checked_param := checked.params[index]
        if mir_param.index != checked_param.index ||
           mir_param.name != checked_param.name ||
           mir_param.span.start != checked_param.span.start ||
           mir_param.span.end != checked_param.span.end ||
           !jet_driver_mir_access_matches_foreign_convention(mir_param.access, checked_param.convention) ||
           mir_param.public_label != checked_param.public_label ||
           mir_param.variadic != checked_param.variadic ||
           mir_param.default_present != checked_param.default_present -> return false
        index += 1
    }
    true
}

fn jet_driver_mir_type_equal(left: MIRType, right: MIRType) -> Bool Never! {
    left.identity == right.identity &&
    mir_type_same_checked_type(left, right) &&
    left.layout.abi == right.layout.abi &&
    left.layout.size == right.layout.size &&
    left.layout.align == right.layout.align
}

fn jet_driver_mir_ownership_equal(left: MIROwnership, right: MIROwnership) -> Bool Never! {
    left.mode == right.mode &&
    left.drop == right.drop &&
    left.moved == right.moved &&
    left.last_use == right.last_use &&
    left.gc_root == right.gc_root
}

fn jet_driver_mir_callback_param_equal(left: MIRParam, right: MIRParam) -> Bool Never! {
    left.index == right.index &&
    left.name == right.name &&
    jet_driver_mir_span_equal(left.span, right.span) &&
    jet_driver_mir_type_equal(left.ty, right.ty) &&
    left.access == right.access &&
    jet_driver_mir_ownership_equal(left.ownership, right.ownership) &&
    left.public_label == right.public_label &&
    left.variadic == right.variadic &&
    left.default_present == right.default_present
}

fn jet_driver_mir_callback_rows_equal(left: MIRCallbackAdapter, right: MIRCallbackAdapter) -> Bool Never! {
    if left.id.value != right.id.value ||
       left.symbol != right.symbol ||
       left.function.value != right.function.value ||
       left.abi != right.abi ||
       left.managed != right.managed ||
       left.plan_digest != right.plan_digest ||
       left.callback_identity != right.callback_identity ||
       left.params.len() != right.params.len() -> return false
    if {
        left.return_type == None -> {
            if right.return_type != None -> return false
        }
        else -> {
            if right.return_type == None -> return false
            left_type :: left.return_type ?? return false
            right_type :: right.return_type ?? return false
            if !jet_driver_mir_type_equal(left_type, right_type) -> return false
        }
    }
    index := 0
    loop index < left.params.len() {
        if !jet_driver_mir_callback_param_equal(left.params[index], right.params[index]) -> return false
        index += 1
    }
    true
}

fn jet_driver_mir_field_rows_equal(left: MIRFieldRow, right: MIRFieldRow) -> Bool Never! {
    if left.id.value != right.id.value ||
       left.owner.value != right.owner.value ||
       left.field.id.value != right.field.id.value ||
       left.field.name != right.field.name ||
       left.field.shape_names.text != right.field.shape_names.text ||
       left.field.shape_names.json != right.field.shape_names.json ||
       left.field.shape_names.cbor != right.field.shape_names.cbor ||
       left.field.shape_names.csv != right.field.shape_names.csv ||
       left.field.shape_names.toml != right.field.shape_names.toml ||
       left.field.shape_names.yaml != right.field.shape_names.yaml ||
       left.field.shape_names.xml != right.field.shape_names.xml ||
       left.field.shape_names.args != right.field.shape_names.args ||
       left.field.shape_names.env != right.field.shape_names.env ||
       left.field.shape_names.db != right.field.shape_names.db ||
       left.field.shape_names.layout != right.field.shape_names.layout ||
       left.field.skip != right.field.skip ||
       !jet_driver_mir_type_equal(left.field.ty, right.field.ty) ||
       !jet_driver_mir_span_equal(left.field.span, right.field.span) ||
       left.field.public != right.field.public ||
       left.field.package_public != right.field.package_public ||
       left.field.computed != right.field.computed ||
       left.field.has_default != right.field.has_default ||
       left.field.redact != right.field.redact -> return false
    true
}

fn jet_driver_mir_callback_diagnostic(
    load: JetDriverLoadResult,
    functions: [MIRFunction],
    callback: MIRCallbackAdapter,
    what: String,
    why: String,
    fix: String,
) -> Diagnostic {
    function_index :: jet_driver_mir_function_index_for_id(functions, callback.function) ?? {
        return jet_driver_diagnostic_without_span("E0003", what, why, fix)
    }
    module_index := jet_driver_loaded_module_index_for_mir_module(load, functions[function_index].module_id)
    jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", functions[function_index].span, what, why, fix)
}

fn jet_driver_merge_mir_callbacks(
    load: JetDriverLoadResult,
    functions: [MIRFunction],
    callbacks: [MIRCallbackAdapter],
    diagnostics: &[Diagnostic],
) -> [MIRCallbackAdapter]? {
    // Per-id occurrence counts of the lowered functions and the merged row
    // per callback id, built once instead of rescanning per callback.
    function_counts := [String:Int]{}
    loop index in 0..<functions.len() {
        function_key :: "{functions[index].id.value}"
        function_counts[function_key] = (function_counts.get(function_key) ?? 0) + 1
    }
    merged := [MIRCallbackAdapter]{}
    merged_index := [String:Int]{}
    loop callback in callbacks {
        if callback.id.value == 0 {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "Codegen produced a callback adapter with a zero stable identity", "every callback adapter ID names one checked closure ABI row", "preserve the canonical callback ID through Codegen"))
            return None
        }
        if (function_counts.get("{callback.function.value}") ?? 0) != 1 {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "a callback adapter targets no unique lowered MIR function", "callback adapter targets resolve to the exact nested or top-level closure function", "retain the callback target function in the lowered MIR function set"))
            return None
        }
        callback_key :: "{callback.id.value}"
        existing_index :: merged_index.get(callback_key) ?? {
            merged_index[callback_key] = merged.len()
            &merged.push(callback)
            next
        }
        if !jet_driver_mir_callback_rows_equal(merged[existing_index], callback) {
            &diagnostics.push(jet_driver_mir_callback_diagnostic(load, functions, callback, "two callback adapters with one stable ID have conflicting checked rows", "callback IDs resolve to one exact symbol, function, ordered signature, ABI, and managed identity", "preserve identical callback adapter facts for each use"))
            return None
        }
    }
    Val(merged)
}

fn jet_driver_mir_field_conflict_diagnostic(
    load: JetDriverLoadResult,
    function: MIRFunction,
) -> Diagnostic {
    module_index := jet_driver_loaded_module_index_for_mir_module(load, function.module_id)
    jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "comptime lowering produced conflicting MIR field rows with one stable ID", "field identities preserve one exact owner and declaration payload across nested functions", "retain the canonical field metadata through comptime lowering")
}

// Merges the lowered item functions `items`, in order, into the closure's
// program rows `lowered`: each item's function, nested functions and
// callbacks, and those of its field, Core call, Prelude call and Core module
// rows the program does not have yet. An item field row whose ID a row merged
// before the item has with different contents is a conflict, reported against
// the item's function. Row identities are looked up in sets built once, so
// merging a batch costs its rows, not items × rows.
fn jet_driver_merge_comptime_functions(
    lowered: &JetCodegenFunctions,
    items: [JetCodegenLoweredFunction],
    load: JetDriverLoadResult,
    diagnostics: &[Diagnostic],
) -> Bool {
    field_rows := [U64:[Int]]{}
    loop position in 0..<lowered.fields.len() {
        rows := field_rows.get(lowered.fields[position].id.value) ?? [Int]{}
        &rows.push(position)
        field_rows[lowered.fields[position].id.value] = rows
    }
    core_calls := [U64:Bool]{}
    loop call in lowered.core_calls -> core_calls[call.id.value] = true
    prelude_calls := [U64:Bool]{}
    loop call in lowered.prelude_calls -> prelude_calls[call.id.value] = true
    used_core := [String:Bool]{}
    loop usage in lowered.used_core -> used_core[usage] = true
    loop item in items {
        loop field in item.fields {
            rows :: field_rows.get(field.id.value) ?? next
            loop row in rows {
                if !jet_driver_mir_field_rows_equal(lowered.fields[row], field) {
                    &diagnostics.push(jet_driver_mir_field_conflict_diagnostic(load, item.function))
                    return false
                }
            }
        }
        &lowered.functions.push(item.function)
        loop function in item.nested_functions -> &lowered.nested_functions.push(function)
        loop callback in item.callbacks -> &lowered.callbacks.push(callback)
        loop source in item.closure_sources -> &lowered.closure_sources.push(source)
        loop field in item.fields {
            if field_rows.get(field.id.value) != None -> next
            field_rows[field.id.value] = [Int]{lowered.fields.len()}
            &lowered.fields.push(field)
        }
        loop call in item.core_calls {
            if core_calls.get(call.id.value) != None -> next
            core_calls[call.id.value] = true
            &lowered.core_calls.push(call)
        }
        loop call in item.prelude_calls {
            if prelude_calls.get(call.id.value) != None -> next
            prelude_calls[call.id.value] = true
            &lowered.prelude_calls.push(call)
        }
        loop usage in item.used_core {
            if used_core.get(usage) != None -> next
            used_core[usage] = true
            &lowered.used_core.push(usage)
        }
    }
    true
}
fn jet_driver_validate_lowered_function_owner(
    load: JetDriverLoadResult,
    assembly: JetDriverAssemblyIndex,
    function: MIRFunction,
    diagnostics: &[Diagnostic],
) {
    module_index := jet_driver_assembly_module_index(assembly, function.module_id)
    if {
        module_index == None -> {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function has no exact loaded-module owner", "lowered MIR functions retain the exact module identity of their loaded source owner", "retain the loaded module identity through nested lambda lowering"))
        }
        else -> {
            module_index_value :: module_index ?? return
            expected_source_file := assembly.module_source_files[module_index_value]
            if {
                expected_source_file == None -> {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function owner has no exact authorized source-file record", "module ownership resolves through one loaded source unit and immutable source-file identity", "preserve the exact loaded module source identity through Codegen"))
                }
                else -> {
                    source_file :: expected_source_file ?? return
                    if function.source_file.value != source_file.value {
                        &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "a lowered function points at a different module's source file", "MIR function provenance matches the exact source file of its checked module owner", "preserve the owning module source-file ID through Codegen"))
                    }
                }
            }
        }
    }
    if function.id.value == 0 {
        &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, module_index, "E0003", function.span, "MIR lowering produced a function with a zero stable identity", "MIR function IDs are stable identities derived from checked function facts", "report the invalid Codegen function identity"))
    }
}

fn jet_driver_mir_import_id(import: SemaRegistrationImport) -> MIRImportID Never! {
    source := import.source_module_identity
    target := import.target_module_identity
    identity := "{source.len()}:{source}:{import.declaration.span.start}:{import.declaration.span.end}:{target.len()}:{target}"
    MIRImportID{value: stable_id("mir-import", identity)}
}

fn jet_driver_mir_visibility(visibility: Int) -> MIRVisibility Never! {
    if visibility >= 2 -> return MIRVisibility.Public
    if visibility >= 1 -> return MIRVisibility.Package
    MIRVisibility.Private
}

// Rust `artifact_plan.rs` `core_import_module_path`: a Core `.[…]` list
// (`use core.mem`, `use core.encoding.[json]`) names Core namespaces, which
// have no checked source-module row, so the edge stays a path import instead
// of a member list. Mixed targets keep the written prefix.
fn jet_driver_core_import_module_path(module_alias: String, members: [ImportedItem]) -> String? Never! {
    if module_alias != "core" && !module_alias.starts_with("core.") -> return None
    target := String?{None}
    loop member in members {
        module_path :: jet_driver_core_list_module(module_alias, member.original) ?? return None
        if target == .Val(existing) {
            // copy: the module path is a new owned String. With mixed targets it is `module_alias`,
            // the caller's written import alias (a read parameter), which the import keeps.
            if existing != module_path -> return Val(module_alias.copy())
        }
        target = Val(module_path)
    }
    // copy: the module path is a new owned String. With no members it is `module_alias`, the
    // caller's written import alias (a read parameter), which the import keeps.
    Val(target ?? module_alias.copy())
}

// The Core module one list member selects (Rust `core_list_path`): the member
// itself when it names a Core module, otherwise the longest known Core module
// prefix that leaves a non-empty item path.
fn jet_driver_core_list_module(prefix: String, member: String) -> String? Never! {
    full :: "{prefix}.{member}"
    if core_module_export(full) != None -> return Val(full)
    parts :: full.split(".").to_list()
    split := parts.len() - 1
    loop split >= 1 {
        module_parts := [String]{}
        loop index in 0..<split -> &module_parts.push(parts[index])
        item_parts := [String]{}
        loop index in split..<parts.len() -> &item_parts.push(parts[index])
        module_path :: module_parts.join(".")
        if core_module_export(module_path) != None && item_parts.join(".") != "" -> return Val(module_path)
        split -= 1
    }
    None
}

// The member rows of one checked unqualified import, each naming its
// canonical lowered MIR declaration (found through `key_rows`).
fn jet_driver_mir_import_items(
    load: JetDriverLoadResult,
    import: SemaRegistrationImport,
    lowered: JetCodegenFunctions,
    key_rows: JetDriverLoweredKeyRows,
    diagnostics: &[Diagnostic],
) -> [MIRImportItem]? {
    items := [MIRImportItem]{}
    loop binding in import.bindings {
        item := MIRItemRef?{None}
        if binding.symbol.kind == {
            SymbolKind.Function -> {
                function_row :: key_rows.functions.get(binding.symbol.id.key) ?? -1
                if function_row < 0 {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported function has no matching lowered MIR function", "import bindings preserve canonical target symbol identities", "retain the exact checked function key through code generation"))
                    return None
                }
                item = Val(MIRItemRef.Function{id: lowered.functions[function_row].id})
            }
            SymbolKind.Type -> {
                type_row :: key_rows.types.get(jet_driver_import_member_key(binding) ?? "") ?? -1
                if type_row < 0 {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported type has no matching lowered MIR type", "type import bindings preserve canonical target symbol identities", "retain the exact checked type key through code generation"))
                    return None
                }
                item = Val(MIRItemRef.Type{id: lowered.types[type_row].id})
            }
            SymbolKind.Trait -> {
                trait_row :: key_rows.traits.get(jet_driver_import_member_key(binding) ?? "") ?? -1
                if trait_row < 0 {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported trait has no matching lowered MIR trait", "trait import bindings preserve canonical target symbol identities", "retain the exact checked trait key through code generation"))
                    return None
                }
                item = Val(MIRItemRef.Trait{id: lowered.traits[trait_row].id})
            }
            SymbolKind.Constant -> {
                // A compile-time-only constant has no runtime use to import.
                comptime_only := false
                if binding.declaration == {
                    Val(declaration) -> {
                        if declaration == {
                            .Const(definition) -> comptime_only = definition.is_comptime
                            else -> {}
                        }
                    }
                    else -> {}
                }
                if comptime_only -> next
                constant_row :: key_rows.constants.get(jet_driver_import_member_key(binding) ?? "") ?? -1
                if constant_row < 0 {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "an imported runtime constant has no matching lowered MIR constant", "runtime import bindings preserve canonical target constant identities", "retain the lowered constant row or erase only a checked compile-time-only import"))
                    return None
                }
                item = Val(MIRItemRef.Constant{id: lowered.constants[constant_row].id})
            }
            else -> {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "the checked import refers to an item kind that MIR lowering does not support", "the backend-neutral import graph lowers canonical type, trait, function, and constant identities", "add a canonical MIR item reference before lowering this import kind"))
                return None
            }
        }
        resolved_item :: item ?? {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, binding.target_module_identity, "E0003", binding.symbol.span, "a checked import binding has no MIR item identity", "every retained import binding names one canonical lowered MIR declaration", "retain the exact lowered item identity"))
            return None
        }
        &items.push(MIRImportItem{
            original: binding.original,
            local: binding.local,
            item: resolved_item,
        })
    }
    items
}

fn jet_driver_mir_import(
    load: JetDriverLoadResult,
    import: SemaRegistrationImport,
    lowered: JetCodegenFunctions,
    key_rows: JetDriverLoweredKeyRows,
    diagnostics: &[Diagnostic],
) -> MIRImport? {
    kind := MIRImportKind?{None}
    if import.declaration.kind == {
        .File(path, _) -> kind = Val(MIRImportKind.File{path: path})
        .Module(name, _) -> kind = Val(MIRImportKind.Module{path: name})
        .Unqualified(module_alias, _, members, _, _) -> {
            core_path :: jet_driver_core_import_module_path(module_alias, members)
            if core_path == .Val(path) -> kind = Val(MIRImportKind.Module{path: path})
            if core_path == None {
                items :: jet_driver_mir_import_items(load, import, lowered, key_rows, &diagnostics) ?? return None
                kind = Val(MIRImportKind.Unqualified{module_id: mir_module_id(import.target_module_identity), items: items})
            }
        }
    }
    resolved_kind :: kind ?? return None
    version := String?{None}
    if import.declaration.inline_version != None {
        inline_version :: import.declaration.inline_version ?? return None
        version = Val(inline_version.text)
    }
    return Val(MIRImport{
        id: jet_driver_mir_import_id(import),
        module_id: mir_module_id(import.source_module_identity),
        visibility: jet_driver_mir_visibility(import.visibility),
        alias: import.declaration.alias,
        kind: resolved_kind,
        span: import.declaration.span,
        version: version,
    })
}

fn jet_driver_find_graph_import(imports: [SemaRegistrationImport], source_identity: String, span: Span) -> SemaRegistrationImport? {
    found := SemaRegistrationImport?{None}
    loop import in imports {
        if import.source_module_identity == source_identity && import.declaration.span.start == span.start && import.declaration.span.end == span.end {
            if found != None -> return None
            found = Val(import)
        }
    }
    found
}
// A dependency package is checked as its own package, so an
// importer never repeats its reports. A dependency with errors still fails
// the importer, once per dependency package (E0626), naming the check that
// owns those errors.
fn jet_driver_summarize_dependency_reports(load: JetDriverLoadResult, diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    entry_root := ""
    loop package in load.packages {
        if package.identity == load.package_identity -> entry_root = package.root_path
    }
    kept := [Diagnostic]{}
    failing := [Bool]{}
    loop package in load.packages -> &failing.push(false)
    loop diagnostic in diagnostics {
        // Diagnostics name a source by its display path; package roots are canonical.
        source_path :: diagnostic.source_path ?? ""
        path :: if source_path.len() == 0 -> "" else -> jet_driver_physical_path(entry_root, source_path)
        owner := -1
        owner_length := -1
        loop (index, package) in load.packages {
            if path.len() == 0 || package.root_path.len() <= owner_length || !jet_driver_path_within(path, package.root_path) -> next
            owner = index
            owner_length = package.root_path.len()
        }
        if owner < 0 || load.packages[owner].identity == load.package_identity || load.packages[owner].identity.starts_with("source-root:") {
            &kept.push(diagnostic)
            next
        }
        if diagnostic.severity == DIAGNOSTIC_ERROR -> failing[owner] = true
    }
    loop index in 0..<load.packages.len() {
        if !failing[index] -> next
        package :: load.packages[index]
        root :: jet_driver_display_path(entry_root, package.root_path)
        &kept.push(jet_driver_diagnostic_without_span("E0626", "Dependency package `{package.name}` has errors", "a dependency package is checked as its own package, so its errors are reported by its own check and never repeated by the packages that import it", "run `jet check {root}` and fix the errors there"))
    }
    kept
}

fn jet_driver_compile_result(
    load: JetDriverLoadResult,
    diagnostics: [Diagnostic],
    entry_function: MIRFunctionID?,
    mir: ^MIRProgram?,
    emitted_source: String?,
    emit_manifest: JetRustEmitManifest?,
    failed_stage: JetDriverStage?,
    complete: Bool,
    trace: JetDriverCompileTrace,
) -> JetDriverCompileResult Never! {
    JetDriverCompileResult{
        diagnostics: jet_driver_summarize_dependency_reports(load, diagnostics),
        generated_source_files: load.generated_source_files,
        package_identity: load.package_identity,
        entry_module_identity: load.entry_module_identity,
        entry_function: entry_function,
        runtime_artifact: None,
        web_artifact: None,
        web_artifacts: None,
        mir: ^mir,
        emitted_source: emitted_source,
        emit_manifest: emit_manifest,
        comptime_stdout: trace.stdout.join(""),
        comptime_stderr: trace.stderr.join(""),
        soft_stop: trace.soft_stop,
        exit_code: trace.exit_code,
        failed_stage: failed_stage,
        complete: complete,
        internal_problem: None,
        authority_policy: jet_driver_authority_policy(load),
        doc_modules: load.doc_modules,
        build_program: load.build_program,
        build_nodes: if complete -> load.build_nodes else -> None,
    }
}

// Ordinary Doc preserves its user-only projection. The explicit retained
// Check projection also retains Core/generated/ABI rows from this same graph;
// its separate source index list identifies the actual Review source owners.
fn jet_driver_doc_modules(request: JetDriverCompileRequest, load: JetDriverLoadResult, graph: SemaGraphResult, registration: SemaRegistrationGraph, values: [SemaComptimeItemValue], effect_identity: String, checked_projection: Bool, capture: &JetDriverCheckedProjectionCapture) -> [JetDriverDocModule] Never! {
    modules := [JetDriverDocModule]{}
    // copy: the shared name ledger owns its facts for the doc pass, and `graph` is the caller's
    // checked graph (a read parameter), which keeps its names for emission.
    ledger :: shared name_ledger_from_facts(graph.names.copy())
    memory :: shared SemaCheckedMemoryFacts{declarations: graph.memory_declarations, projections: graph.memory_projections}
    layout_engine :: sema_comptime_reflection_layout_engine(registration)
    target_layout :: jet_target_layout_from_machine(registration.target_machine)
    loaded_units := [String:Int]{}
    seen := [String:Bool]{}
    if checked_projection {
        if graph.programs.len() != graph.modules.len() -> return [JetDriverDocModule]{}
        loop loaded in load.modules {
            if loaded_units.get(loaded.module_identity) != None -> return [JetDriverDocModule]{}
            loaded_units[loaded.module_identity] = loaded.source_unit_index
        }
    }
    loop (index, graph_module) in graph.modules {
        if graph_module.module_identity == effect_identity || index >= graph.programs.len() -> next
        unit_index :: if checked_projection -> loaded_units.get(graph_module.module_identity) ?? -1 else -> (loop loaded in load.modules {
            if loaded.module_identity == graph_module.module_identity -> break loaded.source_unit_index
        } ?? -1)
        if unit_index < 0 || unit_index >= load.source_units.len() {
            if checked_projection -> return [JetDriverDocModule]{}
            next
        }
        unit :: load.source_units[unit_index]
        registered_index :: if checked_projection -> registration.module_rows.get(graph_module.module_identity) ?? -1 else -> index
        if registered_index < 0 || registered_index >= registration.modules.len() -> return [JetDriverDocModule]{}
        registered :: registration.modules[registered_index]
        path := unit.path
        physical_path := unit.path
        source := if checked_projection -> registered.source else -> ""
        alias := if unit.package_identity == load.package_identity -> "" else -> unit.module_name
        source_owner := true
        if checked_projection {
            if seen.get(graph_module.module_identity) != None || registered.module_identity != graph_module.module_identity || jet_driver_module_identity(unit.package_identity, unit.relative_path) != graph_module.module_identity || registered.package_identity != unit.package_identity || graph_module.package_identity != unit.package_identity || registered.source_file != unit.path || graph_module.source_file != unit.path || registered.source_origin != unit.source_origin -> return [JetDriverDocModule]{}
            seen[graph_module.module_identity] = true
            if jet_driver_unit_is_core(unit) {
                if unit.root_index != -1 || unit.root_identity != JET_DRIVER_CORE_SOURCE_ROOT || unit.package_identity != unit.path || unit.path != "{JET_DRIVER_CORE_SOURCE_ROOT}/{unit.relative_path}" || unit.source_origin != SemaSourceOrigin.CompilerGenerated -> return [JetDriverDocModule]{}
                if unit.file_index >= 0 {
                    if unit.file_index >= request.core_sources.len() -> return [JetDriverDocModule]{}
                    row :: request.core_sources[unit.file_index]
                    if row.module_name != unit.module_name || row.path != unit.relative_path || row.source != source -> return [JetDriverDocModule]{}
                    path = row.path
                    alias = row.alias
                } else {
                    // Loader's explicit ABI-only fallback, not an empty real
                    // Core source. Keep its checked row internally, but it is
                    // not a Rust-loaded source in Review's input digest.
                    if unit.file_index != -1 || unit.relative_path != "{unit.module_name}.jet" || source != "" || core_module_export(unit.module_name) == None -> return [JetDriverDocModule]{}
                    loop row in request.core_sources {
                        if row.owner == "" && row.module_name == unit.module_name -> return [JetDriverDocModule]{}
                    }
                    source_owner = false
                }
            } else if jet_driver_unit_is_error_prelude(unit) {
                // The retained original Prelude error module: checked with the
                // graph, not a Review source owner.
                source_owner = false
            } else {
                if unit.root_index < 0 || unit.root_index >= request.authorized_sources.roots.len() -> return [JetDriverDocModule]{}
                root :: request.authorized_sources.roots[unit.root_index]
                if root.identity != unit.root_identity -> return [JetDriverDocModule]{}
                if unit.source_origin == SemaSourceOrigin.Snapshot {
                    if unit.file_index < 0 || unit.file_index >= root.files.len() -> return [JetDriverDocModule]{}
                    file :: root.files[unit.file_index]
                    if jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), file.path) != unit.path || file.source != source -> return [JetDriverDocModule]{}
                    physical_path = file.path
                } else {
                    if unit.file_index != -1 || unit.source_origin != SemaSourceOrigin.CompilerGenerated -> return [JetDriverDocModule]{}
                }
            }
            if source_owner -> &capture.source_modules.push(modules.len())
            if graph_module.module_identity == load.entry_module_identity {
                if !source_owner || capture.entry_module != None -> return [JetDriverDocModule]{}
                capture.entry_module = Val(modules.len())
            }
        } else {
            if unit.root_index < 0 || unit.file_index < 0 || unit.source_origin != SemaSourceOrigin.Snapshot || unit.root_index >= request.authorized_sources.roots.len() -> next
            source_files :: request.authorized_sources.roots[unit.root_index].files
            if unit.file_index >= source_files.len() -> next
            physical_path = source_files[unit.file_index].path
            source = source_files[unit.file_index].source
        }
        &modules.push(JetDriverDocModule{
            path: path,
            physical_path: physical_path,
            alias: alias,
            source: source,
            items: sema_checked_shape_defaults(graph.programs[index], registered, values).items,
            block_spans: graph.programs[index].block_spans,
            imports: graph.programs[index].imports,
            module_name: graph_module.module_name,
            functions: graph_module.functions,
            name_references: graph_module.name_references,
            call_facts: graph_module.call_facts,
            name_ledger: Val(ledger),
            name_module_index: index,
            memory_facts: Val(memory),
            module_identity: graph_module.module_identity,
            target_triple: registration.target_machine.triple,
            target_layout: Val(target_layout),
            layout_facts: sema_checked_layout_projections(graph.programs[index].items, layout_engine, graph_module.module_identity),
        })
    }
    if checked_projection && (seen.len() != loaded_units.len() || capture.entry_module == None) -> return [JetDriverDocModule]{}
    modules
}

fn jet_driver_authority_policy(load: JetDriverLoadResult) -> JetDriverAuthorityPolicy? {
    loop package in load.packages {
        if package.identity == load.package_identity -> return Val(JetDriverAuthorityPolicy{manifest_path: package.manifest_path, inline_package: package.inline_package, allow: package.authority_allow, deny: package.authority_deny})
    }
    None
}

fn jet_driver_entry_selection(load: JetDriverLoadResult) -> JetDriverPackageEntry? {
    loop package in load.packages {
        if package.identity == load.package_identity -> return package.entry
    }
    None
}

fn jet_driver_resolve_entry_function(
    load: JetDriverLoadResult,
    semantic_graph: SemaGraphResult,
    functions: [MIRFunction],
    diagnostics: &[Diagnostic],
) -> MIRFunctionID? {
    // Authenticated Source Output selection precedes the existing manifest
    // entry projection. Its module cursor names the same checked graph, not a
    // display path or a second name resolution.
    loop source_module in semantic_graph.modules {
        loop constant in source_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind == OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= semantic_graph.modules.len() {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, source_module.module_identity, "E0003", output.reference, "the selected Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    return None
                }
                owner_identity :: semantic_graph.modules[output.module_id].module_identity
                function_key :: symbol_id(SymbolKind.Function, owner_identity, "", output.semantic_name).key
                function_id :: jet_driver_find_lowered_function_id(functions, function_key)
                if function_id == .None {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, owner_identity, "E0003", output.definition, "the selected Output entry has no unique MIR function identity", "Output entry identity is retained from its registered callable", "retain the canonical function key through MIR lowering"))
                }
                return function_id
            }
        }
    }
    entry :: jet_driver_entry_selection(load) ?? return None
    target_module_identity := load.entry_module_identity
    if entry.module_alias != None {
        alias :: entry.module_alias ?? return None
        target := String?{None}
        loop import in load.imports {
            if import.source_module_identity != load.entry_module_identity || import.declaration.alias != alias || !jet_driver_import_is_module_edge(import.declaration.kind) -> next
            if target != None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0105", import.declaration.span, "the package entry module alias resolves more than once", "an explicit `entry: module_alias.function` binds through one loaded module edge", "retain exactly one import for the entry module alias"))
                return None
            }
            target = Val(import.target_module_identity)
        }
        if target == None {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry module alias is not imported by the selected source module", "qualified entry bindings resolve through one exact File or Module import alias", "import the entry module under the manifest's explicit alias"))
            return None
        }
        target_module_identity = target ?? return None
    }
    module_found := false
    function_key := symbol_id(SymbolKind.Function, target_module_identity, "", entry.function_name).key
    loop semantic_module in semantic_graph.modules {
        if semantic_module.module_identity != target_module_identity -> next
        module_found = true
        loop function in semantic_module.functions {
            if function.key != function_key -> next
            function_id := jet_driver_find_lowered_function_id(functions, function.key)
            if function_id == None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, semantic_module.module_identity, "E0003", function.source_span, "the declared package entry has no unique MIR function identity", "the private entry binding is resolved from its exact registered function symbol", "retain the canonical function key through MIR lowering"))
                return None
            }
            return function_id
        }
    }
    if {
        !module_found -> {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry target module is not present in semantic results", "entry identity is fixed by the native-authorized module graph and explicit package binding", "retain the resolved entry target module in the checked graph"))
        }
        else -> {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package manifest entry function is not declared in the resolved entry module", "entry resolution uses the explicit `outputs.*.entry` function binding", "declare the selected function in the entry module referenced by the manifest"))
        }
    }
    None
}

// Rust `artifact_plan.rs` `lower_entry`: with no selected Output (and, in
// Jet, no manifest `entry:` binding), the executable entry is the entry
// module's `fn run`, when it takes no parameter or one typed CLI record
// (`function.params.is_empty() || cli.is_some()`). Otherwise there is no
// entry and the package lowers as a library.
fn jet_driver_default_run_entry(load: JetDriverLoadResult, semantic_graph: SemaGraphResult, program: MIRProgram) -> MIRFunctionID? {
    loop source_module in semantic_graph.modules {
        loop constant in source_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if output.selected -> return None
            }
        }
    }
    if jet_driver_entry_selection(load) != None -> return None
    key :: symbol_id(SymbolKind.Function, load.entry_module_identity, "", "run").key
    function_id :: jet_driver_find_lowered_function_id(program.functions, key) ?? return None
    loop function in program.functions {
        if function.id != function_id -> next
        if function.params.len() == 0 || jet_driver_entry_record_cli(program, function_id) != None -> return Val(function_id)
        return None
    }
    None
}

// jet_driver_resolve_entry_function, then jet_driver_default_run_entry, over
// the checked functions the slot IR builder reads (`functions`, before any
// lowering): the key of the selected Source Output's function, else of the
// manifest `entry:` binding, else of the entry module's `fn run` when it
// takes no parameter or one `#CLI` record. None when the program has no
// executable entry (a diagnostic says why when a binding fails).
fn jet_driver_resolve_entry_key(load: JetDriverLoadResult, semantic_graph: SemaGraphResult, functions: [TFunc], modules: [SemaGraphModuleResult], diagnostics: &[Diagnostic]) -> String? {
    counts := [String:Int]{}
    loop function in functions -> counts[function.key] = (counts.get(function.key) ?? 0) + 1
    loop source_module in semantic_graph.modules {
        loop constant in source_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind == OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= semantic_graph.modules.len() {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, source_module.module_identity, "E0003", output.reference, "the selected Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    return None
                }
                owner_identity :: semantic_graph.modules[output.module_id].module_identity
                function_key :: symbol_id(SymbolKind.Function, owner_identity, "", output.semantic_name).key
                if (counts.get(function_key) ?? 0) != 1 {
                    &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, owner_identity, "E0003", output.definition, "the selected Output entry has no unique checked function identity", "Output entry identity is retained from its registered callable", "retain the canonical function key through checking"))
                    return None
                }
                return Val(function_key)
            }
        }
    }
    entry :: jet_driver_entry_selection(load) ?? return jet_driver_default_run_key(load, functions)
    target_module_identity := load.entry_module_identity
    if entry.module_alias != None {
        alias :: entry.module_alias ?? return None
        target := String?{None}
        loop import in load.imports {
            if import.source_module_identity != load.entry_module_identity || import.declaration.alias != alias || !jet_driver_import_is_module_edge(import.declaration.kind) -> next
            if target != None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0105", import.declaration.span, "the package entry module alias resolves more than once", "an explicit `entry: module_alias.function` binds through one loaded module edge", "retain exactly one import for the entry module alias"))
                return None
            }
            target = Val(import.target_module_identity)
        }
        if target == None {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry module alias is not imported by the selected source module", "qualified entry bindings resolve through one exact File or Module import alias", "import the entry module under the manifest's explicit alias"))
            return None
        }
        target_module_identity = target ?? return None
    }
    module_found := false
    loop semantic_module in semantic_graph.modules {
        if semantic_module.module_identity == target_module_identity -> module_found = true
    }
    if !module_found {
        &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package entry target module is not present in semantic results", "entry identity is fixed by the native-authorized module graph and explicit package binding", "retain the resolved entry target module in the checked graph"))
        return None
    }
    function_key :: symbol_id(SymbolKind.Function, target_module_identity, "", entry.function_name).key
    if counts.get(function_key) == {
        .Val(count) -> {
            if count == 1 -> return Val(function_key)
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the declared package entry has no unique checked function identity", "the private entry binding is resolved from its exact registered function symbol", "retain the canonical function key through checking"))
        }
        .None -> {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", entry.span, entry.source_path, 0, "the package manifest entry function is not declared in the resolved entry module", "entry resolution uses the explicit `outputs.*.entry` function binding", "declare the selected function in the entry module referenced by the manifest"))
        }
    }
    None
}

// jet_driver_default_run_entry over the checked functions: the entry
// module's `fn run`, when it takes no parameter.
fn jet_driver_default_run_key(load: JetDriverLoadResult, functions: [TFunc]) -> String? Never! {
    key :: symbol_id(SymbolKind.Function, load.entry_module_identity, "", "run").key
    loop function in functions {
        if function.key != key -> next
        if function.params.len() == 0 -> return Val(key)
        return None
    }
    None
}
fn jet_driver_empty_compile_trace() -> JetDriverCompileTrace Never! {
    JetDriverCompileTrace{stdout: [String]{}, stderr: [String]{}, soft_stop: false, exit_code: None}
}

fn jet_driver_record_eval_result(trace: &JetDriverCompileTrace, result: JetEvalResult) Never! {
    if result.stdout.len() > 0 -> &trace.stdout.push(result.stdout)
    if result.stderr.len() > 0 -> &trace.stderr.push(result.stderr)
    if result.exit_code != None -> trace.exit_code = result.exit_code
    if result.soft_stop -> trace.soft_stop = true
}

fn jet_driver_inferred_layer_debug(layer: MIRRuntimeLayer) -> String Never! {
    if layer == {
        .Core -> "Core"
        .Alloc -> "Alloc"
        .Std -> "Std"
    }
}

fn jet_driver_package_allocator_debug(policy: MIRAllocatorPolicy) -> String? {
    if policy == {
        .HostedDefault -> return Val("HostedDefault")
        .Counting(cap) -> {
            if cap == None -> return Val("Counting {{ cap: None }}")
            size :: cap
            return Val("Counting {{ cap: Some(ByteSize {{ bytes: {size.bytes} }}) }}")
        }
        else -> None
    }
}

fn jet_driver_host_os_key(value: String) -> String Never! {
    if value == "windows" || value == "Windows" || value == "OS.Windows" -> return "windows"
    if value == "macos" || value == "MacOS" || value == "OS.MacOS" -> return "macos"
    if value == "linux" || value == "Linux" || value == "OS.Linux" -> return "linux"
    ""
}

// The build snapshot sema folds `$package.*` and `$build.*`
// from (Rust `seed_build_facts_from_stamp`). A manifest package names itself;
// the manifest-less rung uses the entry file stem and version `0.0.0`. The
// toolchain stamp is the compiler's own package version.
fn jet_driver_build_facts(load: JetDriverLoadResult, request: JetDriverCompileRequest, target_machine: MIRTargetMachine) -> SemaBuildFacts Never! {
    package_name := ""
    package_version := ""
    loop package in load.packages {
        if package.identity == load.package_identity {
            package_name = package.name
            package_version = package.version ?? ""
        }
    }
    if package_name.len() == 0 {
        segments :: request.authorized_sources.entry_path.split("/").to_list()
        file :: segments[segments.len() - 1]
        package_name = if file.ends_with(".jet") -> file.slice(0, file.len() - 4) else -> file
    }
    if package_name.len() == 0 -> package_name = "script"
    if package_version.len() == 0 -> package_version = "0.0.0"
    host_os := ""
    if request.host_facts.active_os == .Val(raw_os) -> host_os = jet_driver_host_os_key(raw_os)
    toolchain := ""
    if request.host_facts.compiler_identity == .Val(identity) -> toolchain = jet_target_package_version_from_compiler_identity(identity) ?? ""
    SemaBuildFacts{
        package_name: package_name,
        package_version: package_version,
        os: jet_target_active_os_name(target_machine.triple, host_os),
        profile: request.profile,
        stamp_git: None,
        stamp_dirty: false,
        stamp_toolchain: toolchain,
        stamp_at: "",
    }
}

// Rust TARGET_MACHINE_NAMES and target_machine_by_name; restored45acf6f8f.
JET_DRIVER_TARGET_MACHINE_NAMES :: [String]{
    "board.sensor_v1", "board.virt_aarch64", "wasm.browser", "wasm.wasi", "wasm.no-os", "hosted",
}
fn jet_driver_target_machine_by_name(name: String, package_version: String) -> MIRTargetMachine? Never! {
    if name == {
        "board.sensor_v1" | "firmware" | "sensor" -> Val(jet_target_machine_board_sensor_v1(package_version))
        "board.virt_aarch64" | "virt" -> Val(jet_target_machine_board_virt_aarch64(package_version))
        "wasm.browser" -> Val(jet_target_machine_wasm_browser(package_version))
        "wasm.wasi" -> Val(jet_target_machine_wasm_wasi(package_version))
        "wasm.no-os" -> Val(jet_target_machine_wasm_no_os(package_version))
        "hosted" -> Val(jet_target_machine_hosted("x86_64-unknown-linux-gnu", package_version))
        else -> None
    }
}

fn jet_driver_selected_target_machine(
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> MIRTargetMachine? {
    target_triple :: request.host_facts.target_triple ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its target triple", "target layout and machine identity use only the raw target identity authorized by Host", "supply the compiler target triple through HostFacts"))
        return None
    }
    if target_triple.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an empty target triple", "target layout and machine identity require the exact selected triple", "supply the compiler target triple through HostFacts"))
        return None
    }
    compiler_identity :: request.host_facts.compiler_identity ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its compiler identity", "target layout provenance is bound to the exact compiler identity", "supply compiler identity through HostFacts"))
        return None
    }
    compiler_version :: jet_target_package_version_from_compiler_identity(compiler_identity) ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native compiler identity has no parseable exact package version", "target layout facts are versioned by the compiler identity, not the selected program package", "supply a canonical `name@version#build-id` compiler identity"))
        return None
    }
    web_target := if request.target == {
        .Native | .Sandbox(_, _, _) -> false
        .Web(_, _, _) -> true
    }
    if web_target && request.eval_config.runtime_execution {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the Web compile target cannot request runtime execution", "Web publication uses the checked Web artifact plan and AOT Wasm emitter", "select Native runtime execution or Web AOT publication explicitly"))
        return None
    }
    Val(jet_target_machine_for_facts(false, web_target, target_triple, compiler_version))
}

fn jet_driver_package_facts(
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    target_machine: MIRTargetMachine,
    used_core: [String],
    inferred_layer: MIRRuntimeLayer,
    hardware_use: MIRTargetHardwareUse,
    diagnostics: &[Diagnostic],
) -> MIRPackageFacts? {
    package := JetDriverPackageInfo?{None}
    loop candidate in load.packages {
        if candidate.identity == load.package_identity {
            if package != None {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package identity resolves to more than one authorized root", "package facts have exactly one manifest and source root", "retain one canonical package identity in the authorized graph"))
                return None
            }
            package = Val(candidate)
        }
    }
    if package == None {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package identity has no authorized root facts", "MIR package facts are derived only from the selected authorized source root", "preserve the selected package root through loading"))
        return None
    }
    selected :: package ?? return None
    core_library :: load.mode == JetDriverLoadMode.CoreLibrary
    if !core_library && (selected.root_index < 0 || selected.root_index >= request.authorized_sources.roots.len()) {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package root index is outside the authorized snapshot", "package provenance remains inside the native-authorized root table", "retain the exact authorized root index selected by package loading"))
        return None
    }
    target_triple :: request.host_facts.target_triple ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its target triple", "target facts may use only the raw target identity authorized by Host", "supply the compiler target triple through HostFacts"))
        return None
    }
    if target_triple.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an empty target triple", "target layout and machine identity require the exact selected triple", "supply the compiler target triple through HostFacts"))
        return None
    }
    compiler_identity :: request.host_facts.compiler_identity ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted its compiler identity", "target layout provenance is bound to the exact compiler identity", "supply compiler identity through HostFacts"))
        return None
    }
    compiler_version := jet_target_package_version_from_compiler_identity(compiler_identity)
    if compiler_version == None {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native compiler identity has no parseable exact package version", "target layout facts are versioned by the compiler identity, not the selected program package", "supply a canonical `name@version#build-id` compiler identity"))
        return None
    }
    web_target := if request.target == {
        .Native | .Sandbox(_, _, _) -> false
        .Web(_, _, _) -> true
    }
    host_os := ""
    triple_has_os := target_triple.contains("windows") || target_triple.contains("apple") || target_triple.contains("darwin") || target_triple.contains("linux")
    if web_target || !triple_has_os {
        raw_host_os :: request.host_facts.active_os ?? {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host omitted active OS provenance required by the selected target", "the Web target has no OS component and an unrecognized native triple requires an explicit host OS", "supply active OS through HostFacts"))
            return None
        }
        host_os = jet_driver_host_os_key(raw_host_os)
        if host_os.len() == 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native host supplied an unsupported active OS fact", "active OS facts use the closed Linux, MacOS, or Windows vocabulary", "supply the canonical active OS through HostFacts"))
            return None
        }
    }
    if !web_target && target_machine.triple != target_triple {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected target machine no longer matches HostFacts", "Sema, machine policy, and package layout facts share the exact selected triple", "reuse the target machine selected before registration"))
        return None
    }
    active_os := jet_target_active_os_name(target_machine.triple, host_os)
    artifact_target := MIRArtifactTarget.RustAOT
    artifact_tier := "aot"
    if {
        web_target -> {
            artifact_target = MIRArtifactTarget.Web
            artifact_tier = "web"
        }
        request.mode == JetDriverCompileMode.Eval || request.mode == JetDriverCompileMode.Interpreter || request.mode == JetDriverCompileMode.Repl -> {
            artifact_target = MIRArtifactTarget.Interpreter
            artifact_tier = "interpreter"
        }
        request.eval_config.runtime_execution -> {
            artifact_target = MIRArtifactTarget.Interpreter
            artifact_tier = "interpreter"
        }
    }
    dossier := jet_target_dossier_for_usage(target_machine, used_core, artifact_tier, compiler_identity, "none")
    allocator :: jet_driver_package_allocator_debug(selected.allocator_policy) ?? {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected package allocator has no canonical private-Driver representation", "MIR package facts preserve the parsed program allocator without guessing provider identities", "select a supported hosted allocator policy"))
        return None
    }
    package_version := selected.version ?? ""
    if package_version.len() == 0 -> package_version = "0.0.0"
    project_root := JET_DRIVER_CORE_SOURCE_ROOT
    if !core_library {
        root :: request.authorized_sources.roots[selected.root_index]
        project_root = jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), root.canonical_path)
    }
    uses_arrow := false
    loop usage in used_core {
        if usage == "core.data.arrow" || usage.starts_with("core.data.arrow.") -> uses_arrow = true
    }
    // The project root is relative to the entry root (`jet_driver_display_path`),
    // so the emitted program never records where the project was checked out.
    Val(MIRPackageFacts{
        project_root: project_root,
        edition: selected.edition,
        runtime_parts: jet_ring_runtime_parts_for_used_core(used_core),
        uses_arrow: uses_arrow,
        active_os: active_os,
        inferred_layer: jet_driver_inferred_layer_debug(inferred_layer),
        allocator: allocator,
        program_allocator: selected.allocator_policy,
        package_version: package_version,
        artifact_target: Val(artifact_target),
        target_dossier: dossier,
        web_app: None,
        authority_needs: selected.authority_needs,
        hardware_use: hardware_use,
        hardware_profile: None,
        hardware_profile_id: "",
        hardware_capabilities: [String]{},
        hardware_setups: [MIRHardwareSetup]{},
    })
}

// Run-wide lookups every function closure of one comptime run shares, built
// once instead of rescanning the graph or the checked functions per lookup.
// The owner maps scan every function of the graph, so they are built at the
// first owner lookup (`owners_built`), not for a run whose items reach no
// function by key.
struct JetDriverComptimeRunIndex {
    // Function key -> the module that registers it; `ambiguous_owners` holds
    // the keys registered more than once, which have no unique owner.
    owners: [String:String]
    ambiguous_owners: [String:Bool]
    owners_built: Bool
    // `module\nkey` -> the first row of that function in the run's checked
    // functions.
    checked_rows: [String:Int]
}

fn jet_driver_comptime_run_index(checked_functions: [SemaComptimeFunctionResult]) -> JetDriverComptimeRunIndex Never! {
    index := JetDriverComptimeRunIndex{owners: [String:String]{}, ambiguous_owners: [String:Bool]{}, owners_built: false, checked_rows: [String:Int]{}}
    // Sorted once, so every insert appends (JetDriverModuleKeyRow).
    rows := [JetDriverCheckedKeyRow]{}
    loop (row, checked) in checked_functions -> &rows.push(JetDriverCheckedKeyRow{key: "{checked.module_identity}\n{checked.function_key}", row: row})
    &rows.sort_by((left: JetDriverCheckedKeyRow, right: JetDriverCheckedKeyRow) -> (left.key <=> right.key).then(left.row <=> right.row))
    loop at in 0..<rows.len() {
        if at == 0 || rows[at - 1].key != rows[at].key -> index.checked_rows[rows[at].key] = rows[at].row
    }
    index
}

// The owner maps of `graph`, which never changes during a run, filled in
// ascending key order (JetDriverModuleKeyRow); a key's first registration
// owns it and every later one marks it ambiguous.
fn jet_driver_comptime_owners_build(graph: SemaRegistrationGraph, index: &JetDriverComptimeRunIndex) Never! {
    index.owners_built = true
    rows := jet_driver_registration_function_rows(graph)
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: JetDriverModuleKeyRow, right: JetDriverModuleKeyRow) -> (left.key <=> right.key).then(left.row <=> right.row))
    loop at in 0..<rows.len() {
        if at > 0 && rows[at - 1].key == rows[at].key {
            index.ambiguous_owners[rows[at].key] = true
        } else {
            index.owners[rows[at].key] = rows[at].module_identity
        }
    }
}

// The one module that registers `function_key`, or None when no module or
// more than one does (the owner maps are built: jet_driver_comptime_owners_build).
fn jet_driver_comptime_function_owner(index: JetDriverComptimeRunIndex, function_key: String) -> String? {
    if index.ambiguous_owners.get(function_key) != None -> return None
    index.owners.get(function_key)
}

struct JetDriverComptimeFunctionRef {
    module_identity: String
    function_key: String
}

struct JetDriverComptimeFunctionClosure {
    functions: [TFunc]
    waiting_dependencies: [String]
    complete: Bool
    // Each incomplete reachable function's recorded causes, keyed by function.
    incomplete_reasons: [String]{[String]{}}
}

struct JetDriverComptimeWaitRow {
    key: String
    name: String
    module_identity: String
    span: Span
    dependencies: [String]
}

fn jet_driver_comptime_function_ref_add(refs: &[JetDriverComptimeFunctionRef], queued: &[String:Bool], module_identity: String, function_key: String) Never! {
    key :: "{module_identity}\n{function_key}"
    if queued.get(key) != None -> return
    queued[key] = true
    &refs.push(JetDriverComptimeFunctionRef{module_identity: module_identity, function_key: function_key})
}

fn jet_driver_comptime_wait_add(dependencies: &[String], key: String) Never! {
    loop previous in dependencies {
        if previous == key -> return
    }
    &dependencies.push(key)
}

// Codegen lowers a precise operation to its `Core/Math/Math.jet` helper by
// name (`jet_codegen_lower_precise_builtin`), and Sema records no call fact
// for it, so the closure queues each helper `roots` and `body` lower to (as
// Rust `is_core_precise_source_target` roots it): it is checked and lowered
// with the item, together with its own callees.
fn jet_driver_comptime_precise_refs(graph: SemaRegistrationGraph, index: &JetDriverComptimeRunIndex, roots: [TExpr], body: [TStmt], queue: &[JetDriverComptimeFunctionRef], queued: &[String:Bool]) Never! {
    // Function values the body stores are lowered with it, like its callees.
    values :: jet_codegen_function_value_keys(roots, body)
    if values.len() > 0 {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, &index)
        loop key in values {
            if jet_driver_comptime_function_owner(index, key) == .Val(owner) -> jet_driver_comptime_function_ref_add(&queue, &queued, owner, key)
        }
    }
    names :: jet_codegen_precise_helper_names(roots, body)
    if names.len() == 0 -> return
    if !index.owners_built -> jet_driver_comptime_owners_build(graph, &index)
    loop module_row in graph.modules {
        if module_row.module_name != "core.math" -> next
        loop name in names {
            key :: symbol_id(SymbolKind.Function, module_row.module_identity, "", name).key
            if jet_driver_comptime_function_owner(index, key) == .Val(owner) -> jet_driver_comptime_function_ref_add(&queue, &queued, owner, key)
        }
    }
}

// `environment` is the run's sema_comptime_environment, `program` its tables
// (sema_comptime_program) and `available` its constant keys: every function
// check re-targets the environment instead of copying the graph per function.
// A function the run already checked completely is reused from
// `checked_functions`. Function sources and module rows are read from
// `program`'s graph, whose staged values never change them. `memory_plan`
// holds the run's memory plan once a function is checked (zero or one row):
// it reads only function declarations, which staged values never change, so
// every on-demand function check of the run shares the one built at the first.
// `program` is read-only here, so its graph is borrowed in place: a writable
// `&program` turned the graph binding below into a whole-graph copy per call.
fn jet_driver_comptime_function_closure(
    environment: &SemaScopeEnvironment, program: SemaProgramTables,
    probe: &SemaScopeProbe,
    available: SemaComptimeAvailableConstants,
    index: &JetDriverComptimeRunIndex,
    memory_plan: &[SemaFunctionMemoryPlan],
    values: [SemaComptimeItemValue],
    checked_functions: &[SemaComptimeFunctionResult],
    request: SemaComptimeItemRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeFunctionClosure {
    graph_option :: program.registration_graph
    graph :: graph_option ?? return JetDriverComptimeFunctionClosure{functions: [TFunc]{}, waiting_dependencies: [String]{}, complete: false, incomplete_reasons: [String]{"the staged comptime environment lost its registration graph"}}
    // Each function enters the queue once, so the queue is also the set of
    // functions processed.
    queue := [JetDriverComptimeFunctionRef]{}
    queued := [String:Bool]{}
    loop call in request.calls -> jet_driver_comptime_function_ref_add(&queue, &queued, call.module_identity, call.callee_key)
    loop function_key in request.reachable_function_keys {
        if !index.owners_built -> jet_driver_comptime_owners_build(graph, &index)
        module_identity := jet_driver_comptime_function_owner(index, function_key)
        if module_identity == None {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
            return JetDriverComptimeFunctionClosure{functions: [TFunc]{}, waiting_dependencies: [String]{}, complete: false}
        }
        owner_identity :: module_identity ?? return JetDriverComptimeFunctionClosure{functions: [TFunc]{}, waiting_dependencies: [String]{}, complete: false}
        jet_driver_comptime_function_ref_add(&queue, &queued, owner_identity, function_key)
    }
    jet_driver_comptime_precise_refs(graph, &index, [TExpr]{request.expression}, [TStmt]{}, &queue, &queued)
    functions := [TFunc]{}
    waiting := [String]{}
    complete := true
    incomplete_reasons := [String]{}
    cursor := 0
    loop cursor < queue.len() {
        current := queue[cursor]
        cursor += 1
        checked_key :: "{current.module_identity}\n{current.function_key}"
        reused_row := -1
        if index.checked_rows.get(checked_key) == .Val(row) {
            if checked_functions[row].complete -> reused_row = row
        }
        if reused_row < 0 && memory_plan.len() == 0 -> &memory_plan.push(sema_function_memory_plan_from_graph(graph))
        checked := if reused_row >= 0 -> checked_functions[reused_row] else -> sema_check_comptime_function(graph, &environment, program, &probe, available, memory_plan[0], values, current.module_identity, current.function_key)
        loop dependency in checked.waiting_dependencies -> jet_driver_comptime_wait_add(&waiting, dependency)
        if {
            !checked.complete || jet_driver_has_errors(checked.diagnostics) -> {
                loop diagnostic in checked.diagnostics -> &diagnostics.push(diagnostic)
                if checked.incomplete_reasons.len() == 0 && checked.waiting_dependencies.len() == 0 && !jet_driver_has_errors(checked.diagnostics) -> &incomplete_reasons.push("{current.function_key}: incomplete (no recorded cause)")
                loop reason in checked.incomplete_reasons -> &incomplete_reasons.push("{current.function_key}: {reason}")
                complete = false
            }
            else -> {
                function :: checked.function ?? {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a complete comptime function result has no TIR body", "the interpreter fragment is lowered only from a complete typed function", "return the checked TFunc from the canonical on-demand Sema result"))
                    complete = false
                    next
                }
                defaults := [TExpr]{}
                loop parameter in function.params {
                    if parameter.default == Val(value) -> &defaults.push(value)
                }
                jet_driver_comptime_precise_refs(graph, &index, defaults, function.body, &queue, &queued)
                &functions.push(function)
                if index.checked_rows.get(checked_key) == None {
                    index.checked_rows[checked_key] = checked_functions.len()
                    &checked_functions.push(checked)
                }
            }
        }
        loop call in checked.calls -> jet_driver_comptime_function_ref_add(&queue, &queued, call.module_identity, call.callee_key)
        loop function_key in checked.reachable_function_keys {
            if !index.owners_built -> jet_driver_comptime_owners_build(graph, &index)
            module_identity := jet_driver_comptime_function_owner(index, function_key)
            if {
                module_identity == None -> {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, request.module_identity, "E0003", request.span, "a nested comptime-reachable function has no unique registered module owner", "on-demand Sema function checks use the exact canonical module and symbol key", "retain the registered owner identity for every reachable function"))
                    complete = false
                }
                else -> {
                    owner_identity :: module_identity ?? return JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: false, incomplete_reasons: incomplete_reasons}
                    jet_driver_comptime_function_ref_add(&queue, &queued, owner_identity, function_key)
                }
            }
        }
    }
    JetDriverComptimeFunctionClosure{functions: functions, waiting_dependencies: waiting, complete: complete, incomplete_reasons: incomplete_reasons}
}

// The lowering state a comptime run stages its items against: the Codegen
// session of the staged module set (moved out to lower a program and moved
// back), the staged runtime modules, their foreign rows (lowered once: they
// read only those modules and the run's artifact target), and how many values
// the session's constant rows cover (-1 before the first evaluated item).
// `live` holds the run's growing program (zero or one row: a slot, so a flush
// can move it out and back); `growth_constants` the constant rows the session
// gained since that program was built; `restore` whether the session's
// closure is another program's since then (jet_codegen_comptime_session_restore
// sets it back before the live program grows). `global_keys` holds the key of
// every interpreter global the run's evaluations see (the Host's and those of
// the first `global_count` values), so each landed value is checked against
// them once (jet_driver_comptime_globals_check), not once per evaluation.
// `sites` are the value sites of the program's graph, through which landings
// apply; the run's available constants authenticate each staged row frontier.
// G (closure-scoped staging): `bare` is set while `session` is the bare
// session (jet_driver_comptime_stage_bare), which serves batches that reach
// no declaration until the first batch that does; `bare_ok` whether the run
// may stage bare at all (the declaration pass's modules are at hand and
// carry no foreign rows, so a bare program lacks only rows its items never
// read).
// `declared` holds the declaration pass's modules (moved in, or empty) until
// the first full staging moves them into the session (`declared_staged`);
// the run hands them back at its end (jet_driver_comptime_take_declared).
struct JetDriverComptimeStaging {
    session: JetCodegenComptimeSession?
    runtime_modules: [SemaGraphModuleResult]
    foreign: JetCodegenForeignArtifacts?
    count: Int
    live: [JetDriverComptimeLive]
    growth_constants: [MIRConstantDef]
    restore: Bool
    global_keys: [String:Bool]
    global_count: Int
    sites: SemaComptimeValueSites
    bare: Bool
    bare_ok: Bool
    declared: [SemaGraphModuleResult]
    declared_staged: Bool
}

// A2c, one growing comptime program per run. A shareable flush (each of its
// evaluated entries passed jet_driver_comptime_shareable: a batch of
// constants, or one item of any kind evaluated alone) evaluates on the
// run's live program when the closure functions that program lacks are free
// functions that no declared row names: they and the flush's item functions
// join it (jet_driver_comptime_grow), at the cost of their own rows. A
// shareable flush that cannot grow it builds one program for the union of
// the live closure and its own, which becomes the live program. Each value is
// still the one its batch's own program gives, by A2's argument for one batch
// carried across the run: function IDs are stable per function, the
// evaluator runs only the item's function and what it calls, and every row it
// reads is the row the batch's own program would have. A flush grows only
// while the run has reported no error: assembling a program of its own then
// fails (jet_driver_assemble_mir stops on any error so far), which ends the
// run, and so does the growth's fallback. `session` holds the
// retired evaluator session over the program (empty while a flush evaluates
// on it: a slot, so a growth can move it out of the borrowed record), and
// `globals_count` the run values its globals already hold; the sets hold the
// program's row identities so a growth is checked without walking the
// program.
struct JetDriverComptimeLive {
    session: [JetEvalRuntimeSession]
    globals_count: Int
    // The program's closure, in lowering order, and its `module\nkey`s.
    functions: [TFunc]
    function_keys: [String:Bool]
    // MIR function ids and keys (top-level and nested functions).
    function_ids: [U64:Bool]
    mir_keys: [String:Bool]
    callbacks: [MIRCallbackAdapter]
    callback_rows: [U64:Int]
    fields: [MIRFieldRow]
    field_rows: [U64:Int]
    // Core call id -> key.
    core_calls: [U64:String]
    prelude_calls: [U64:Bool]
    instances: [U64:Bool]
    types: [U64:Bool]
    traits: [U64:Bool]
    assembly: JetDriverAssemblyIndex
}

// A comptime item that checked completely and waits for its value: a plain
// literal carries it (`plain`); any other item evaluates `request`, whose
// checked function closure is `function_keys` (`module\nkey`, in closure
// order) of its batch's functions.
struct JetDriverComptimeEntry {
    source: SemaComptimeItemSource
    request: SemaComptimeItemRequest
    function_keys: [String]
    plain: TComptimeValue?
}

// Checked items evaluated together on one temporary program, in order.
struct JetDriverComptimeBatch {
    entries: [JetDriverComptimeEntry]
    // The union of the entries' checked closures, each function once, in
    // the order the entries first name them; `function_rows` maps each
    // function's `module\nkey` to its position.
    functions: [TFunc]
    function_rows: [String:Int]
    // The source key of every entry: an item check that waits on one of
    // them reads a value the batch still holds back.
    keys: [String:Bool]
    // Whether an evaluated entry names a staged constant or calls a function,
    // so the program needs the rows of the values that landed since staging.
    needs_rows: Bool
    // Whether every evaluated entry passed jet_driver_comptime_shareable, so
    // the batch may evaluate on, and become, the run's live program.
    shareable: Bool
    // G: whether no evaluated entry reaches a declaration or has a closure
    // (jet_driver_comptime_entry_bare), so the batch may lower on the bare
    // session.
    bare: Bool
}

// What evaluating a batch did to the run.
struct JetDriverComptimeFlush {
    // The run's result when an entry ended the run.
    stop: JetDriverComptimeRunResult?
    // Whether a value landed or a checked-text item passed.
    progressed: Bool
}

// Work counters of one comptime run (#4601 scaling gate), written to the
// trace once when the run ends: item checks (rechecks included), temporary
// programs lowered, flushes that grew the live program instead, item
// functions evaluated, and functions lowered into temporary programs
// (closure functions plus item functions).
struct JetDriverComptimeCounters {
    items_checked: Int
    programs_built: Int
    programs_grown: Int
    item_functions_evaluated: Int
    rows_lowered: Int
    // G: item functions evaluated on a bare program.
    items_bare: Int
    // Tracing only (`track_keys`): JetDriverComptimeRunResult.lowered_keys.
    track_keys: Bool
    lowered_keys: [String:Bool]
}

// The program a flush evaluates on: held until the first evaluation moves it
// into an evaluator session, which every later evaluation reuses.
// `globals_count` is the number of run values whose constants the session's
// globals already hold.
struct JetDriverComptimeMachine {
    program: MIRProgram?
    session: JetEvalRuntimeSession?
    globals_count: Int
}

fn jet_driver_comptime_wait_row_find(rows: [JetDriverComptimeWaitRow], key: String) -> JetDriverComptimeWaitRow? {
    loop row in rows {
        if row.key == key -> return Val(row)
    }
    None
}

fn jet_driver_comptime_wait_cycle_from(key: String, rows: [JetDriverComptimeWaitRow], path: &[String], finished: &[String]) -> Bool Never! {
    loop previous in path {
        if previous == key -> return true
    }
    loop previous in finished {
        if previous == key -> return false
    }
    &path.push(key)
    row := jet_driver_comptime_wait_row_find(rows, key)
    if row != None {
        wait_row :: row ?? return false
        loop dependency in wait_row.dependencies {
            if jet_driver_comptime_wait_row_find(rows, dependency) != None && jet_driver_comptime_wait_cycle_from(dependency, rows, &path, &finished) -> return true
        }
    }
    _ := &path.pop()
    &finished.push(key)
    false
}

fn jet_driver_comptime_dependency_cycle(rows: [JetDriverComptimeWaitRow]) -> JetDriverComptimeWaitRow? {
    path := [String]{}
    finished := [String]{}
    loop row in rows {
        if jet_driver_comptime_wait_cycle_from(row.key, rows, &path, &finished) -> return Val(row)
    }
    None
}

// The run's interpreter configuration for one evaluation, with `globals`.
fn jet_driver_comptime_eval_config(original: JetEvalConfig, globals: ^[String:TComptimeValue], inputs: JetEvalComptimeInputAdapter?) -> JetEvalConfig {
    host_adapter := if original.host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    build_host_adapter :: if original.build_host_adapter == {
        None -> None
        Val(adapter) -> Val(adapter.clone_adapter())
    }
    JetEvalConfig{
        fuel: original.fuel,
        max_call_depth: original.max_call_depth,
        max_collection_len: original.max_collection_len,
        globals: ^globals,
        runtime_execution: false,
        host_adapter: host_adapter,
        build_host_adapter: build_host_adapter,
        comptime_input_adapter: inputs,
        output_context: original.output_context,
        host_hooks: original.host_hooks,
    }
}

// Every evaluation's globals are the Host's plus every constant value so
// far, and no constant key may meet an existing global. The values that
// landed since the last check are checked against the keys seen (values
// only grow, and a collision ends the run), so each value is checked once:
// the first evaluation after a colliding value reports it, as checking
// every value per evaluation would.
fn jet_driver_comptime_globals_check(
    staging: &JetDriverComptimeStaging,
    values: [SemaComptimeItemValue],
    graph: SemaRegistrationGraph,
    module_identity: String,
    span: Span,
    diagnostics: &[Diagnostic],
) -> Bool {
    loop index in staging.global_count..<values.len() {
        if values[index].kind != SemaComptimeItemKind.Constant -> next
        if staging.global_keys.get(values[index].key) != None {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, module_identity, "E0003", span, "a checked comptime constant collides with an existing interpreter global", "source constants and Host-provided evaluator globals have distinct canonical keys", "retain the source constant key and do not overwrite a Host evaluator global"))
            return false
        }
        staging.global_keys[values[index].key] = true
    }
    staging.global_count = values.len()
    true
}

// The globals of the constant values from `from` on, onto `globals`.
fn jet_driver_comptime_globals_add(globals: &[String:TComptimeValue], values: [SemaComptimeItemValue], from: Int) Never! {
    loop index in from..<values.len() {
        if values[index].kind == SemaComptimeItemKind.Constant -> globals[values[index].key] = values[index].value
    }
}

// Rows the compile has finished reading. Dropping a row writes nothing any
// later step reads, so they drop on one more compiler thread while MIR
// lowering (jet_driver_lower_releasing) or assembly
// (jet_driver_assemble_releasing) runs, instead of on the serial path
// between the phases; the outputs and diagnostics are the same with any
// thread count.
struct JetDriverReleased {
    stages: [SemaComptimeDeclarationStage]
    closures: [[SemaComptimeFunctionResult]]
    values: [[SemaComptimeItemValue]]
    registrations: [SemaRegistrationGraph]
    checking: [SemaGraphCheckingFacts]
    functions: [TFunc]
}

fn jet_driver_released_empty() -> JetDriverReleased Never! {
    JetDriverReleased{stages: [SemaComptimeDeclarationStage]{}, closures: [[SemaComptimeFunctionResult]]{}, values: [[SemaComptimeItemValue]]{}, registrations: [SemaRegistrationGraph]{}, checking: [SemaGraphCheckingFacts]{}, functions: [TFunc]{}}
}

// The released rows while the release thread drops them: moved in as the
// one row of `released` and dropped there, never copied.
struct JetDriverReleaseSlot {
    released: [JetDriverReleased]
}

// One task (or, on one thread, the caller): drops the slot's rows where it
// runs and returns how many it dropped.
fn jet_driver_release_rows(slot: Shared<JetDriverReleaseSlot>) -> Int {
    permit :: slot.guard_edit()
    dropped := 0
    // Each popped row drops at the end of its turn, on this thread.
    loop permit.value.released.len() > 0 {
        rows :: &permit.value.released.pop() ?? break
        dropped += rows.stages.len() + rows.closures.len() + rows.values.len() + rows.registrations.len() + rows.checking.len() + rows.functions.len()
    }
    dropped
}

// Whether the release runs beside its phase: only when the threads admit
// two, so `--threads 1` drops the rows first, on the calling thread.
fn jet_driver_release_beside(threads: CompilerThreads) -> Bool Never! {
    compiler_threads_admit(threads, 2, 2, 1, 0, 0) > 1
}

// lower_functions with `released` dropped beside it (jet_driver_release_rows).
// Lowering reads none of the released rows, so it lowers the same functions
// either way.
fn jet_driver_lower_releasing(released: ^JetDriverReleased, functions: &[TFunc], modules: &[SemaGraphModuleResult], source_files: [MIRSourceFile], threads: CompilerThreads, trace_sink: CompilerTraceSink?, native_stop_points: Bool, edition: String, keep_going: Bool) -> JetCodegenFunctions {
    slot :: shared JetDriverReleaseSlot{released: [JetDriverReleased]{^released}}
    if !jet_driver_release_beside(threads) {
        _ :: jet_driver_release_rows(slot)
        return lower_functions(&functions, &modules, source_files, threads, trace_sink, native_stop_points, edition, keep_going)
    }
    lowered := [JetCodegenFunctions]{}
    task.group lower_release {
        dropping :: task jet_driver_release_rows(slot)
        &lowered.push(lower_functions(&functions, &modules, source_files, threads, trace_sink, native_stop_points, edition, keep_going))
        _ :: dropping.join() ?? panic(compiler_threads_failure_text(err))
    }
    &lowered.pop() ?? panic("MIR lowering returned nothing beside the release thread")
}

// jet_driver_assemble_mir with `released` dropped beside it
// (jet_driver_release_rows). Assembly reads none of the released rows, so
// it assembles the same program either way.
fn jet_driver_assemble_releasing(
    released: ^JetDriverReleased,
    threads: CompilerThreads,
    load: JetDriverLoadResult,
    semantic_modules: [SemaGraphModuleResult],
    semantic_imports: [SemaRegistrationImport],
    names: MIRNameFacts,
    lowered_rows: ^JetCodegenFunctions,
    foreign_artifacts: JetCodegenForeignArtifacts,
    facts: MIRPackageFacts,
    include_imports: Bool,
    keep_going: Bool,
    diagnostics: &[Diagnostic],
) -> MIRProgram? {
    slot :: shared JetDriverReleaseSlot{released: [JetDriverReleased]{^released}}
    if !jet_driver_release_beside(threads) {
        _ :: jet_driver_release_rows(slot)
        return jet_driver_assemble_mir(load, semantic_modules, semantic_imports, names, ^lowered_rows, foreign_artifacts, facts, include_imports, keep_going, &diagnostics)
    }
    programs := [MIRProgram?]{}
    task.group assemble_release {
        dropping :: task jet_driver_release_rows(slot)
        &programs.push(jet_driver_assemble_mir(load, semantic_modules, semantic_imports, names, ^lowered_rows, foreign_artifacts, facts, include_imports, keep_going, &diagnostics))
        _ :: dropping.join() ?? panic(compiler_threads_failure_text(err))
    }
    &programs.pop() ?? panic("MIR assembly returned nothing beside the release thread")
}

// `driver.prelower.*` and `driver.preassemble.*`: each serial step between
// comptime.validate, lower and assemble is its own span.
fn jet_driver_trace_step_begin(trace_sink: CompilerTraceSink?, name: String) {
    if trace_sink == .Val(sink) -> sink.begin(name, "", -1, -1)
}

fn jet_driver_trace_step_end(trace_sink: CompilerTraceSink?, name: String, items: Int) {
    if trace_sink == .Val(sink) -> sink.end(name, items)
}

// Moves the rows of `functions` flagged in `mask` onto `kept` and the others
// onto `rest`, both in order, leaving `functions` empty. Each pop moves one
// row, so no row is ever copied.
fn jet_driver_partition_checked_functions(functions: &[TFunc], mask: [Bool], kept: &[TFunc], rest: &[TFunc]) Never! {
    reversed := [TFunc]{}
    loop functions.len() > 0 {
        function := &functions.pop() ?? { break }
        &reversed.push(^function)
    }
    position := 0
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        if mask[position] {
            &kept.push(^function)
        } else {
            &rest.push(^function)
        }
        position += 1
    }
}

// Moves the rows split by jet_driver_partition_checked_functions back into
// their graph modules in their original order: module `index` takes the next
// `counts[index]` rows. `kept` and `rest` are left empty.
fn jet_driver_restore_checked_functions(graph: &SemaGraphResult, counts: [Int], mask: [Bool], kept: &[TFunc], rest: &[TFunc]) Never! {
    kept_reversed := [TFunc]{}
    loop kept.len() > 0 {
        function := &kept.pop() ?? { break }
        &kept_reversed.push(^function)
    }
    rest_reversed := [TFunc]{}
    loop rest.len() > 0 {
        function := &rest.pop() ?? { break }
        &rest_reversed.push(^function)
    }
    position := 0
    loop module_index in 0..<counts.len() {
        loop _ in 0..<counts[module_index] {
            if mask[position] {
                function := &kept_reversed.pop() ?? { break }
                &graph.modules[module_index].functions.push(^function)
            } else {
                function := &rest_reversed.pop() ?? { break }
                &graph.modules[module_index].functions.push(^function)
            }
            position += 1
        }
    }
}

// Moves every function of `from` onto the end of `to` in order, leaving
// `from` empty. Each pop moves one function, so the list is never resident
// twice.
fn jet_driver_move_mir_functions(to: &[MIRFunction], from: &[MIRFunction]) Never! {
    reversed := [MIRFunction]{}
    loop from.len() > 0 {
        function := &from.pop() ?? { break }
        &reversed.push(^function)
    }
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        &to.push(^function)
    }
}

fn jet_driver_assemble_mir(
    load: JetDriverLoadResult,
    semantic_modules: [SemaGraphModuleResult],
    semantic_imports: [SemaRegistrationImport],
    names: MIRNameFacts,
    lowered_rows: ^JetCodegenFunctions,
    foreign_artifacts: JetCodegenForeignArtifacts,
    facts: MIRPackageFacts,
    include_imports: Bool,
    // JET_KEEP_GOING: earlier stages' reports and duplicate lowered
    // identities do not stop assembly (they are recorded already).
    keep_going: Bool,
    diagnostics: &[Diagnostic],
) -> MIRProgram? {
    // A changeable owner: its function lists are moved out below.
    lowered := ^lowered_rows
    if semantic_modules.len() != load.modules.len() -> return None
    assembly := jet_driver_assembly_index(load)
    expected_foreign_count := 0
    loop semantic_module in semantic_modules {
        expected_foreign_count += semantic_module.foreign_functions.len()
    }
    if foreign_artifacts.foreign.len() != expected_foreign_count {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering did not return every checked foreign declaration", "the foreign table is the complete normalized Sema ABI set, never an empty placeholder or AST re-inference", "preserve every checked foreign row through Codegen"))
        return None
    }
    // Earlier foreign identities, and each checked foreign row by
    // `module id\nkey` (the Sema module and row, or -1 when the key repeats
    // in that module), so each lowered row is validated without rescanning.
    foreign_ids := [U64:Bool]{}
    foreign_keys := [String:Bool]{}
    checked_foreign_modules := [String:Int]{}
    checked_foreign_rows := [String:Int]{}
    loop (semantic_index, semantic_module) in semantic_modules {
        module_value :: mir_module_id(semantic_module.module_identity).value
        loop (row, checked_foreign) in semantic_module.foreign_functions {
            checked_key :: "{module_value}\n{checked_foreign.key}"
            if checked_foreign_modules.get(checked_key) == None {
                checked_foreign_modules[checked_key] = semantic_index
                checked_foreign_rows[checked_key] = row
            } else {
                checked_foreign_modules[checked_key] = -1
            }
        }
    }
    loop foreign in foreign_artifacts.foreign {
        if foreign_ids.get(foreign.id.value) != None || foreign_keys.get(foreign.key) != None {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering produced duplicate canonical foreign identities", "each checked foreign key and MirForeignId resolves to exactly one row", "preserve stable foreign identities from normalized Sema facts"))
            return None
        }
        foreign_ids[foreign.id.value] = true
        foreign_keys[foreign.key] = true
        owner_module_index :: jet_driver_assembly_module_index(assembly, foreign.module_id) ?? {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a lowered foreign row has no exact loaded-module owner", "MirForeign.module_id derives from the checked source module identity", "retain the normalized foreign row's module identity through Codegen"))
            return None
        }
        checked_key :: "{foreign.module_id.value}\n{foreign.key}"
        semantic_index :: checked_foreign_modules.get(checked_key) ?? {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a lowered foreign row has no matching normalized checked Sema owner", "Codegen consumes only SemaCheckedForeignFunction facts from the same module identity", "preserve the checked foreign key, module, and ABI provenance"))
            return None
        }
        if semantic_index < 0 {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a checked foreign key resolves to more than one normalized Sema row", "canonical foreign ABI identities are unique within the checked module graph", "report the duplicate normalized foreign key"))
            return None
        }
        checked_row :: checked_foreign_rows.get(checked_key) ?? return None
        if !jet_driver_mir_foreign_matches_checked(foreign, semantic_modules[semantic_index].foreign_functions[checked_row]) {
            &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", foreign.span, "a lowered foreign row disagrees with its normalized checked Sema facts", "MIR preserves the canonical module, symbol, source site, parameter order, access, and native path", "lower the checked foreign row without reconstructing or changing its ABI"))
            return None
        }
    }
    imports := [MIRImport]{}
    if include_imports {
        key_rows := jet_driver_lowered_key_rows(lowered)
        import_ids := [U64:Bool]{}
        loop import in semantic_imports {
            lowered_import :: jet_driver_mir_import(load, import, lowered, key_rows, &diagnostics) ?? return None
            if import_ids.get(lowered_import.id.value) != None {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, import.source_module_identity, "E0003", import.declaration.span, "two semantic imports have the same stable MIR identity", "MIR import IDs are stable functions of source module, declaration span, and target identity", "report the duplicate resolved import edge"))
                return None
            }
            import_ids[lowered_import.id.value] = true
            &imports.push(lowered_import)
        }
    }
    type_instances := jet_codegen_collect_type_instances(lowered.types, lowered.functions, lowered.nested_functions, foreign_artifacts.foreign, lowered.traits, lowered.impls, lowered.constants)
    // Ownership of every lowered function moves into the program: a field
    // move (`^lowered.functions`) would copy the whole list while `lowered`
    // still held it.
    all_functions := [MIRFunction]{}
    compiler_transfer_rows<MIRFunction>(&all_functions, &lowered.functions)
    compiler_transfer_rows<MIRFunction>(&all_functions, &lowered.nested_functions)
    // Rust `function_foreign_provenance`: each checked `#FFI(asm)` row's
    // body-less leaf joins the functions, keyed like its foreign row.
    loop leaf in foreign_artifacts.functions -> &all_functions.push(leaf)
    // Next-equal chains preserve the old pairwise diagnostic order without
    // visiting unrelated functions. Duplicate-heavy input costs only its output.
    id_heads := [U64:Int]{}
    key_heads := [String:Int]{}
    next_id := (loop _ in all_functions -> -1)
    next_key := (loop _ in all_functions -> -1)
    index := all_functions.len() - 1
    loop index >= 0 {
        next_id[index] = id_heads.get(all_functions[index].id.value) ?? -1
        next_key[index] = key_heads.get(all_functions[index].key) ?? -1
        id_heads[all_functions[index].id.value] = index
        key_heads[all_functions[index].key] = index
        index -= 1
    }
    function_index := 0
    loop function_index < all_functions.len() {
        jet_driver_validate_lowered_function_owner(load, assembly, all_functions[function_index], &diagnostics)
        owner_module_index := jet_driver_assembly_module_index(assembly, all_functions[function_index].module_id)
        span :: all_functions[function_index].span
        id_later := next_id[function_index]
        key_later := next_key[function_index]
        loop id_later >= 0 || key_later >= 0 {
            later :: if id_later < 0 -> key_later else -> if key_later < 0 || id_later < key_later -> id_later else -> key_later
            if id_later == later {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", span, "MIR lowering produced duplicate function IDs", "every MIR function ID resolves to exactly one checked function", "report the duplicate Codegen function identity"))
                id_later = next_id[id_later]
            }
            if key_later == later {
                &diagnostics.push(jet_driver_diagnostic_at_loaded_module_index(load, owner_module_index, "E0003", span, "MIR lowering produced duplicate function keys", "every checked function key resolves to one MIR function", "report the duplicate Codegen function key"))
                key_later = next_key[key_later]
            }
        }
        function_index += 1
    }
    if jet_driver_has_errors(diagnostics) && !keep_going -> return None
    callbacks :: jet_driver_merge_mir_callbacks(load, all_functions, lowered.callbacks, &diagnostics) ?? return None

    modules := [MIRModule]{}
    assigned_functions := 0
    assigned_foreigns := 0
    assigned_types := 0
    assigned_traits := 0
    assigned_impls := 0
    assigned_constants := 0
    // Each kind of row chained by module ID (and imports and load edges by
    // source module), in row order, so a module visits only its own rows.
    function_chains := jet_driver_row_chains_new()
    loop function in all_functions -> jet_driver_row_chains_add(&function_chains, function.module_id.value)
    foreign_chains := jet_driver_row_chains_new()
    loop foreign in foreign_artifacts.foreign -> jet_driver_row_chains_add(&foreign_chains, foreign.module_id.value)
    type_chains := jet_driver_row_chains_new()
    loop definition in lowered.types -> jet_driver_row_chains_add(&type_chains, definition.module_id.value)
    trait_chains := jet_driver_row_chains_new()
    loop definition in lowered.traits -> jet_driver_row_chains_add(&trait_chains, definition.module_id.value)
    impl_chains := jet_driver_row_chains_new()
    loop definition in lowered.impls -> jet_driver_row_chains_add(&impl_chains, definition.module_id.value)
    constant_chains := jet_driver_row_chains_new()
    loop definition in lowered.constants -> jet_driver_row_chains_add(&constant_chains, definition.module_id.value)
    import_chains := jet_driver_row_chains_new()
    edge_chains := jet_driver_row_chains_new()
    if include_imports {
        loop import in semantic_imports -> jet_driver_row_chains_add(&import_chains, mir_module_id(import.source_module_identity).value)
        loop edge in load.imports -> jet_driver_row_chains_add(&edge_chains, mir_module_id(edge.source_module_identity).value)
    }
    loop loaded_module in load.modules {
        if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= load.source_units.len() -> return None
        unit := load.source_units[loaded_module.source_unit_index]
        module_id := mir_module_id(loaded_module.module_identity)
        module_source_file := mir_source_file_id(unit.path)
        if assembly.source_files.get(module_source_file.value) == None -> return None
        module_import_ids := [MIRImportID]{}
        children := [MIRModuleID]{}
        child_ids := [U64:Bool]{}
        ordered_items := [JetDriverMIRItemOrderRow]{}
        if include_imports {
            import_row := import_chains.heads.get(module_id.value) ?? -1
            loop import_row >= 0 {
                import :: semantic_imports[import_row]
                import_row = import_chains.next[import_row]
                if import.source_module_identity != loaded_module.module_identity -> next
                import_id := jet_driver_mir_import_id(import)
                &module_import_ids.push(import_id)
                jet_driver_add_mir_item_order(&ordered_items, import.declaration.span.start, MIRItemRef.Import{id: import_id})
                edge_row := edge_chains.heads.get(module_id.value) ?? -1
                loop edge_row >= 0 {
                    edge :: load.imports[edge_row]
                    edge_row = edge_chains.next[edge_row]
                    if edge.source_module_identity == loaded_module.module_identity && edge.declaration.span.start == import.declaration.span.start && edge.declaration.span.end == import.declaration.span.end && jet_driver_import_is_module_edge(edge.declaration.kind) && edge.target_package_identity == loaded_module.package_identity {
                        child_id := mir_module_id(edge.target_module_identity)
                        if child_ids.get(child_id.value) == None {
                            child_ids[child_id.value] = true
                            &children.push(child_id)
                        }
                    }
                }
            }
        }
        row := function_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            if assembly.source_files.get(all_functions[row].source_file.value) == None -> return None
            jet_driver_add_mir_item_order(&ordered_items, all_functions[row].span.start, MIRItemRef.Function{id: all_functions[row].id})
            assigned_functions += 1
            row = function_chains.next[row]
        }
        row = foreign_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            jet_driver_add_mir_item_order(&ordered_items, foreign_artifacts.foreign[row].span.start, MIRItemRef.Foreign{id: foreign_artifacts.foreign[row].id})
            assigned_foreigns += 1
            row = foreign_chains.next[row]
        }
        row = type_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            jet_driver_add_mir_item_order(&ordered_items, lowered.types[row].span.start, MIRItemRef.Type{id: lowered.types[row].id})
            assigned_types += 1
            row = type_chains.next[row]
        }
        row = trait_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            jet_driver_add_mir_item_order(&ordered_items, lowered.traits[row].span.start, MIRItemRef.Trait{id: lowered.traits[row].id})
            assigned_traits += 1
            row = trait_chains.next[row]
        }
        row = impl_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            jet_driver_add_mir_item_order(&ordered_items, lowered.impls[row].span.start, MIRItemRef.Impl{id: lowered.impls[row].id})
            assigned_impls += 1
            row = impl_chains.next[row]
        }
        row = constant_chains.heads.get(module_id.value) ?? -1
        loop row >= 0 {
            jet_driver_add_mir_item_order(&ordered_items, lowered.constants[row].span.start, MIRItemRef.Constant{id: lowered.constants[row].id})
            assigned_constants += 1
            row = constant_chains.next[row]
        }
        positions := [U64]{}
        loop item_row in ordered_items -> &positions.push(U64.from_int(item_row.position) ?? U64{0})
        item_order := [MIRItemRef]{}
        loop row_index in jet_codegen_sorted_order(positions, [String]{}) -> &item_order.push(ordered_items[row_index].item)
        &modules.push(MIRModule{
            id: module_id,
            key: loaded_module.module_identity,
            name: loaded_module.module_name,
            path: unit.path,
            source_file: module_source_file,
            imports: module_import_ids,
            children: children,
            item_order: item_order,
        })
    }
    if assigned_functions != all_functions.len() || assigned_foreigns != foreign_artifacts.foreign.len() || assigned_types != lowered.types.len() || assigned_traits != lowered.traits.len() || assigned_impls != lowered.impls.len() || assigned_constants != lowered.constants.len() -> return None
    // Every lowered row list moves into the program, as the functions did
    // above: a field read in the literal below would copy each list while
    // `lowered` still held it until assembly returned.
    program_types := [MIRTypeDef]{}
    compiler_transfer_rows<MIRTypeDef>(&program_types, &lowered.types)
    program_traits := [MIRTraitDef]{}
    compiler_transfer_rows<MIRTraitDef>(&program_traits, &lowered.traits)
    program_impls := [MIRImplDef]{}
    compiler_transfer_rows<MIRImplDef>(&program_impls, &lowered.impls)
    program_constants := [MIRConstantDef]{}
    compiler_transfer_rows<MIRConstantDef>(&program_constants, &lowered.constants)
    program_fields := [MIRFieldRow]{}
    compiler_transfer_rows<MIRFieldRow>(&program_fields, &lowered.fields)
    program_core_calls := [MIRCoreCall]{}
    compiler_transfer_rows<MIRCoreCall>(&program_core_calls, &lowered.core_calls)
    program_prelude_calls := [MIRPreludeCall]{}
    compiler_transfer_rows<MIRPreludeCall>(&program_prelude_calls, &lowered.prelude_calls)
    Val(MIRProgram{
        native_pack: false,
        schema_version: MIR_SCHEMA_VERSION,
        package_identity: load.package_identity,
        facts: facts,
        names: names,
        modules: modules,
        imports: imports,
        types: program_types,
        traits: program_traits,
        core_owners: lowered.core_owners,
        impls: program_impls,
        constants: program_constants,
        fields: program_fields,
        source_files: load.source_files,
        functions: all_functions,
        jobs: [MIRJob]{},
        tests: [MIRTestCase]{},
        harnesses: [MIRHarnessPlan]{},
        artifacts: [MIRArtifactPlan]{},
        cffi: jet_codegen_lower_cffi_facts(semantic_modules, load.imports),
        foreign: foreign_artifacts.foreign,
        links: foreign_artifacts.links,
        callbacks: callbacks,
        handles: foreign_artifacts.handles,
        core_calls: program_core_calls,
        prelude_calls: program_prelude_calls,
        // Rust mir.rs `lower_program`: every canonical type the lowered rows
        // name, so legality, emission and evaluation see one instance table.
        type_instances: type_instances,
        codec_migrations: [String:MIRSchemaMigrationPlan]{},
        unreachable: [MIRUnreachable]{},
    })
}

// `graph` is the run environment's graph with every value of `values`
// applied (equal to sema_comptime_graph_with_values of the registration graph
// and `values`), handed on when the run completed so finalization reuses it
// instead of copying the registration graph again; None on every other exit,
// where `partial_graph` holds the run's graph with the values applied so far.
// `trail` records every edit the run made to the graph it was given
// (sema_graph_trail_undo gives that graph back).
// `declared` is the declaration pass's modules the run was given, handed back
// on every exit with their type definitions unchanged (finalization reads
// them); a staged session only joined constant rows to them.
struct JetDriverComptimeRunResult {
    values: [SemaComptimeItemValue]
    functions: [SemaComptimeFunctionResult]
    trace: JetDriverCompileTrace
    complete: Bool
    soft_stop: Bool
    internal_problem: String?
    graph: SemaRegistrationGraph?
    partial_graph: SemaRegistrationGraph?
    // Set by a run that completed: its owner hands the tables' graph on as
    // `graph` (jet_driver_run_comptime); otherwise as `partial_graph`.
    graph_finished: Bool
    trail: SemaGraphTrail
    declared: [SemaGraphModuleResult]
    // Traced runs only: the `module_identity\nkey` of every checked function
    // a temporary program lowered, which the `lower` phase compares with the
    // functions it lowers again (D12, `counters.lower.comptime_overlap_functions`).
    lowered_keys: [String:Bool]{[String:Bool]{}}
}

fn jet_driver_comptime_run_result(
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
) -> JetDriverComptimeRunResult Never! {
    JetDriverComptimeRunResult{values: values, functions: functions, trace: trace, complete: complete, soft_stop: soft_stop, internal_problem: None, graph: None, partial_graph: None, graph_finished: false, trail: sema_graph_trail_init(), declared: [SemaGraphModuleResult]{}}
}

fn jet_driver_comptime_lost_graph(values: [SemaComptimeItemValue], functions: [SemaComptimeFunctionResult], trace: JetDriverCompileTrace) -> JetDriverComptimeRunResult Never! {
    result := jet_driver_comptime_run_result(values, functions, trace, false, false)
    result.internal_problem = Val("the staged comptime environment lost its registration graph")
    result
}

fn jet_driver_comptime_lost_session(values: [SemaComptimeItemValue], functions: [SemaComptimeFunctionResult], trace: JetDriverCompileTrace) -> JetDriverComptimeRunResult Never! {
    result := jet_driver_comptime_run_result(values, functions, trace, false, false)
    result.internal_problem = Val("the staged comptime lowering session was lost")
    result
}

// The check sema_comptime_precheck_items made of an item ahead of its pass,
// while `values` held `from` values, if it is the check the run would make
// now: no value has landed since whose key is one of its dependencies (a
// check reads only the constants it references, and each referenced constant
// without a value then is a dependency). Taken once: the caller moves its
// precheck in and leaves it None, so a retried item checks again.
fn jet_driver_comptime_prechecked(precheck: ^SemaComptimeItemCheck?, values: [SemaComptimeItemValue], from: Int) -> SemaComptimeItemCheck? {
    check := ^precheck ?? return None
    loop index in from..<values.len() {
        loop dependency in check.dependencies {
            if values[index].key == dependency -> return None
        }
    }
    Val(^check)
}

// Applies the values that landed from position `from` on to the run's
// program graph in place, through the graph's value sites `sites`
// (sema_comptime_value_sites), recording each typed row on `trail`, and
// counts them as available. False when the tables lost their graph.
fn jet_driver_comptime_apply_landed(environment: &SemaScopeEnvironment, program: &SemaProgramTables, available: &SemaComptimeAvailableConstants, sites: SemaComptimeValueSites, values: [SemaComptimeItemValue], from: Int, trail: &SemaGraphTrail) -> Bool {
    landed := [SemaComptimeItemValue]{}
    body_values_changed := false
    loop value_index in from..<values.len() {
        // Graph projection consumes only Constants. Do not duplicate body
        // payloads into a temporary list that it immediately discards.
        if values[value_index].kind == SemaComptimeItemKind.Constant -> &landed.push(values[value_index])
        if values[value_index].kind == SemaComptimeItemKind.BodyExpression -> body_values_changed = true
    }
    if &program.registration_graph == {
        None -> return false
        .Val(resolved_graph) -> sema_comptime_graph_apply_sites(&resolved_graph, sites, landed, &trail)
    }
    sema_comptime_available_constants_add(&available, values)
    sema_comptime_environment_publish_body_values(&environment, values, from, body_values_changed)
    true
}

// The value sites of the run's program graph, read in place. The run's
// tables own their graph from the start of the run.
fn jet_driver_comptime_program_sites(program: SemaProgramTables) -> SemaComptimeValueSites {
    graph_option :: program.registration_graph
    resolved_graph :: graph_option ?? panic("the staged comptime environment lost its registration graph")
    sema_comptime_value_sites(resolved_graph)
}

// The run's available constant keys (sema_comptime_available_constants),
// read from the run's program graph: they come from the constants' AST
// values, which staged values never change, and from `values`.
fn jet_driver_comptime_program_available(program: SemaProgramTables, values: [SemaComptimeItemValue]) -> SemaComptimeAvailableConstants {
    graph_option :: program.registration_graph
    resolved_graph :: graph_option ?? panic("the staged comptime environment lost its registration graph")
    sema_comptime_available_constants(resolved_graph, values)
}

fn jet_driver_comptime_item_value(source: SemaComptimeItemSource, value: TComptimeValue, ty: Type) -> SemaComptimeItemValue Never! {
    SemaComptimeItemValue{
        module_identity: source.module_identity,
        key: source.key,
        destination_key: source.destination_key,
        kind: source.kind,
        value: value,
        ty: ty,
    }
}

// Whether a check that ran while `keys` (a batch's source keys) were still
// held back may differ from the check the run makes one item at a time,
// after the batch's values landed: it waits on a batch key, or it is
// `unsettled` (it reported anything or did not complete; such an item stops
// or reports, which the run does only after the batch's values and reports).
// A check that reported nothing, completed and waits on no batch key named
// no batch constant (naming one makes the check wait on its key: a constant
// without a value is a dependency, sema_comptime_dependencies_from_references),
// so landing the batch first changes neither its result nor its waits.
fn jet_driver_comptime_reads_batch(keys: [String:Bool], waiting: [String], unsettled: Bool) -> Bool Never! {
    if unsettled -> return true
    loop key in waiting {
        if keys.get(key) != None -> return true
    }
    false
}

// Whether one of `keys` has a value now.
fn jet_driver_comptime_any_available(available: SemaComptimeAvailableConstants, keys: [String]) -> Bool Never! {
    loop key in keys {
        if available.keys.get(key) != None -> return true
    }
    false
}

fn jet_driver_comptime_hardware_empty(hardware: MIRTargetHardwareUse) -> Bool Never! {
    hardware.register_accesses.len() == 0 && hardware.interrupt_handlers.len() == 0 && hardware.dma_operations.len() == 0 && hardware.unresolved_references.len() == 0
}

// Whether a checked item may be evaluated on a program shared with other
// items (a batch's program, or the run's live program, A2c): its item and
// checked closure use no hardware, so the program's package facts are each
// item's own. Its value is then the value its own program gives: function
// IDs are stable per function (jet_codegen_function_id), the evaluator runs
// only the item's function and what it calls, and the staging at the
// flush's first evaluated item already holds every constant row the item
// reads. Package facts other than hardware use differ only in Core usage
// rows (runtime parts, layer, dossier), which the evaluator never reads (it
// reads only `facts.edition`), and computing them reports nothing that
// depends on the program (jet_driver_package_facts).
fn jet_driver_comptime_shareable(request: SemaComptimeItemRequest, functions: [TFunc], checked_functions: [SemaComptimeFunctionResult], index: JetDriverComptimeRunIndex) -> Bool Never! {
    if !jet_driver_comptime_hardware_empty(request.hardware_use) -> return false
    loop function in functions {
        row :: index.checked_rows.get("{function.module_identity}\n{function.key}") ?? return false
        if !jet_driver_comptime_hardware_empty(checked_functions[row].hardware_use) -> return false
    }
    true
}

// Whether a shareable item (jet_driver_comptime_shareable) whose check and
// closure read nothing its batch holds back (jet_driver_comptime_reads_batch)
// may wait in the batch, to be evaluated together with it: a constant, not
// checked text, whose key a later check names in its waits when it reads it.
// Any other shareable item is evaluated at its turn, alone, on the run's live
// program (A2c).
fn jet_driver_comptime_batchable(source: SemaComptimeItemSource) -> Bool Never! {
    source.kind == SemaComptimeItemKind.Constant && source.checked_text == None
}

fn jet_driver_comptime_batch_new() -> JetDriverComptimeBatch Never! {
    JetDriverComptimeBatch{entries: [JetDriverComptimeEntry]{}, functions: [TFunc]{}, function_rows: [String:Int]{}, keys: [String:Bool]{}, needs_rows: false, shareable: true, bare: true}
}

// Appends an item to `batch`, moving the functions of its checked closure
// that the batch does not hold yet out of `functions` (left empty).
fn jet_driver_comptime_batch_add(batch: &JetDriverComptimeBatch, source: SemaComptimeItemSource, request: SemaComptimeItemRequest, functions: &[TFunc], plain: TComptimeValue?) Never! {
    reversed := [TFunc]{}
    loop functions.len() > 0 {
        function := &functions.pop() ?? { break }
        &reversed.push(^function)
    }
    function_keys := [String]{}
    loop reversed.len() > 0 {
        function := &reversed.pop() ?? { break }
        key :: "{function.module_identity}\n{function.key}"
        &function_keys.push(key)
        if batch.function_rows.get(key) != None -> next
        batch.function_rows[key] = batch.functions.len()
        &batch.functions.push(^function)
    }
    if plain == None && (request.dependencies.len() > 0 || function_keys.len() > 0) -> batch.needs_rows = true
    if plain == None && !jet_driver_comptime_entry_bare(request, function_keys) -> batch.bare = false
    batch.keys[source.key] = true
    &batch.entries.push(JetDriverComptimeEntry{source: source, request: request, function_keys: function_keys, plain: plain})
}

// The batch holding only entry `index` of `batch`, with that entry's own
// closure (copied out of the batch's functions).
fn jet_driver_comptime_batch_single(batch: JetDriverComptimeBatch, index: Int) -> JetDriverComptimeBatch Never! {
    single := jet_driver_comptime_batch_new()
    single.shareable = batch.shareable
    entry :: batch.entries[index]
    loop key in entry.function_keys {
        row :: batch.function_rows.get(key) ?? next
        single.function_rows[key] = single.functions.len()
        &single.functions.push(batch.functions[row])
    }
    if entry.plain == None && (entry.request.dependencies.len() > 0 || entry.function_keys.len() > 0) -> single.needs_rows = true
    if entry.plain == None && !jet_driver_comptime_entry_bare(entry.request, entry.function_keys) -> single.bare = false
    single.keys[entry.source.key] = true
    &single.entries.push(entry)
    single
}

// Forgets the function checks recorded since `mark`: they ran while a batch
// held values back, and the run checks them again after the batch lands, so
// checked functions keep the order the run gives one item at a time.
fn jet_driver_comptime_forget_functions(checked_functions: &[SemaComptimeFunctionResult], index: &JetDriverComptimeRunIndex, mark: Int) Never! {
    loop checked_functions.len() > mark {
        removed := &checked_functions.pop() ?? { break }
        _ := &index.checked_rows.remove("{removed.module_identity}\n{removed.function_key}")
    }
}

fn jet_driver_resolved_package_edition(load: JetDriverLoadResult) -> String Never! {
    loop package in load.packages {
        if package.identity == load.package_identity -> return package.edition
    }
    panic("selected package identity has no resolved edition")
}

// Stages the run's lowering session for a flush whose first evaluated item
// is `head`: the first evaluated item of the run builds it from the staged
// modules; a later flush that `needs_rows` (an item names a staged constant
// or calls a function) first takes the rows of the values that landed since,
// which the live program gains when it next grows (`growth_constants`).
// The run's program graph already carries every value so far (values land
// only after an item's checks) and is read in place, never copied. None, or
// the run's result when staging failed.
// `staging.declared` is the declaration pass's check of every module of
// `graph` (SemaComptimeDeclarationStage.modules, no values), or empty. A staged value
// changes only its own constant's row among the module declarations
// (sema_comptime_staged_constant_rows), so the staged modules are those
// modules with the rows of every value so far joined in place, exactly as
// later landings join theirs (jet_codegen_comptime_session_add_constants),
// instead of a second check of every module under the values. The first
// staging moves them into the session rather than copying them (the run
// hands them back from the session at its end).
fn jet_driver_comptime_stage(
    graph: SemaRegistrationGraph,
    load: JetDriverLoadResult,
    head: SemaComptimeItemRequest,
    needs_rows: Bool,
    stop_points: Bool,
    values: [SemaComptimeItemValue],
    checked_functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    program: SemaProgramTables,
    available: &SemaComptimeAvailableConstants,
    staging: &JetDriverComptimeStaging,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeRunResult? {
    staged_count :: staging.count
    landed_since_staging := values.len() != staged_count && needs_rows
    if staged_count >= 0 && !landed_since_staging -> return None
    sema_comptime_available_constants_add(&available, values)
    if staged_count < 0 {
        staged_modules := [SemaGraphModuleResult]{}
        reused := staging.declared.len() > 0 && staging.declared.len() == graph.modules.len()
        seed_rows := [TConstantDef]{}
        if program.registration_graph == {
            None -> return Val(jet_driver_comptime_lost_graph(values, checked_functions, trace))
            .Val(staged_graph) -> {
                if reused {
                    jet_driver_comptime_take_modules(&staged_modules, &staging.declared)
                    staging.declared_staged = true
                    seed_rows = sema_comptime_staged_constant_rows(staged_graph, values, 0, available)
                }
            }
        }
        if !reused -> staged_modules = sema_comptime_modules_with_values(program, values)
        if staged_modules.len() != graph.modules.len() {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, head.module_identity, "E0003", head.span, "the staged comptime declaration graph lost a registered module", "temporary interpreter MIR retains every module identity from the registered graph", "preserve the complete resolved module set while applying staged values"))
            return Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
        }
        // Assembly reads only the runtime modules' count and foreign rows,
        // and foreign lowering reads nothing else when no module has foreign
        // rows (jet_driver_comptime_bare_ok), so the bare modules stand in for
        // a copy of every staged module then.
        if staging.bare_ok {
            loop index in 0..<graph.modules.len() {
                if graph.modules[index].module_identity != graph.canonical_effect_module_identity -> &staging.runtime_modules.push(sema_comptime_bare_module(graph.modules[index]))
            }
        } else {
            loop runtime_module in staged_modules {
                if runtime_module.module_identity != graph.canonical_effect_module_identity -> &staging.runtime_modules.push(runtime_module)
            }
        }
        session := jet_codegen_comptime_session(^staged_modules, load.source_files, stop_points, jet_driver_resolved_package_edition(load))
        if reused -> _ := jet_codegen_comptime_session_add_constants(&session, seed_rows)
        staging.session = Val(^session)
    } else {
        added := [MIRConstantDef]{}
        if program.registration_graph == {
            None -> return Val(jet_driver_comptime_lost_graph(values, checked_functions, trace))
            .Val(staged_graph) -> {
                rows := sema_comptime_staged_constant_rows(staged_graph, values, staged_count, available)
                if &staging.session == {
                    None -> return Val(jet_driver_comptime_lost_session(values, checked_functions, trace))
                    .Val(staged_session) -> added = jet_codegen_comptime_session_add_constants(&staged_session, rows)
                }
            }
        }
        jet_driver_comptime_take_constants(&staging.growth_constants, &added)
    }
    staging.count = values.len()
    None
}

// Moves every row of `from` onto the end of `to`, in order.
fn jet_driver_comptime_take_constants(to: &[MIRConstantDef], from: &[MIRConstantDef]) Never! {
    reversed := [MIRConstantDef]{}
    loop from.len() > 0 {
        row := &from.pop() ?? { break }
        &reversed.push(^row)
    }
    loop reversed.len() > 0 {
        row := &reversed.pop() ?? { break }
        &to.push(^row)
    }
}

// Moves every module of `from` onto the end of `to`, in order (popped, so no
// module is copied).
fn jet_driver_comptime_take_modules(to: &[SemaGraphModuleResult], from: &[SemaGraphModuleResult]) Never! {
    reversed := [SemaGraphModuleResult]{}
    loop from.len() > 0 {
        row := &from.pop() ?? { break }
        &reversed.push(^row)
    }
    loop reversed.len() > 0 {
        row := &reversed.pop() ?? { break }
        &to.push(^row)
    }
}

// The temporary lowering of `closure` and of `batch`'s evaluated entries from
// `start` on, on the staged session in place: the closure
// (lower_comptime_closure), then the item function of each evaluated entry,
// in order, onto `items`. None when the run has no staged session.
fn jet_driver_comptime_lower(staging: &JetDriverComptimeStaging, closure: [TFunc], batch: JetDriverComptimeBatch, start: Int, items: &[JetCodegenLoweredFunction]) -> JetCodegenFunctions? {
    lowered := JetCodegenFunctions?{None}
    if &staging.session == {
        None -> {}
        .Val(session) -> {
            lowered = Val(lower_comptime_closure(&session, closure))
            loop index in start..<batch.entries.len() {
                if batch.entries[index].plain == None -> &items.push(lower_comptime_item(&session, batch.entries[index].request))
            }
        }
    }
    lowered
}

// The closure of a program for `batch` that becomes the live program: the
// closure of `live` (if any), then each function of `batch` it lacks, in
// batch order.
fn jet_driver_comptime_union_closure(live: [JetDriverComptimeLive], batch: JetDriverComptimeBatch) -> [TFunc] Never! {
    closure := [TFunc]{}
    keys := [String:Bool]{}
    loop current in live {
        loop function in current.functions {
            keys["{function.module_identity}\n{function.key}"] = true
            &closure.push(function)
        }
    }
    loop function in batch.functions {
        if keys.get("{function.module_identity}\n{function.key}") != None -> next
        &closure.push(function)
    }
    closure
}

// Lowers `closure` (the batch's union closure, or that and the live
// program's closure) and the evaluated entries of `batch` from `start` on as
// one temporary program on the staged session: the closure, then each
// entry's item function, whose IDs go to `item_ids` in entry order,
// assembled with the package facts of the first evaluated entry's hardware
// use and the closure's (a batch of several items, and a live program, uses
// no hardware: jet_driver_comptime_shareable). The session's closure is this
// program's from now on (`staging.restore`, cleared when it becomes live).
// None once the program cannot be built, after reporting why.
fn jet_driver_comptime_program(
    graph: SemaRegistrationGraph,
    names: MIRNameFacts,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    closure: [TFunc],
    batch: JetDriverComptimeBatch,
    start: Int,
    checked_functions: [SemaComptimeFunctionResult],
    staging: &JetDriverComptimeStaging,
    counters: &JetDriverComptimeCounters,
    item_ids: &[MIRFunctionID],
    diagnostics: &[Diagnostic],
) -> MIRProgram? {
    head :: batch.entries[start].request
    items := [JetCodegenLoweredFunction]{}
    staging.restore = true
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.lower", "program", -1, -1)
    staged_lowering := jet_driver_comptime_lower(&staging, closure, batch, start, &items)
    if request.trace_sink == .Val(sink) -> sink.end("comptime.lower", closure.len() + items.len())
    lowered := ^staged_lowering ?? return None
    counters.programs_built += 1
    counters.rows_lowered += closure.len() + items.len()
    if counters.track_keys {
        loop function in closure -> counters.lowered_keys["{function.module_identity}\n{function.key}"] = true
    }
    if lowered.functions.len() != closure.len() {
        &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, head.module_identity, "E0003", head.span, "temporary code generation did not return every checked comptime function", "the evaluator receives the complete checked TIR function closure", "retain every checked function through Codegen"))
        return None
    }
    loop item in items -> &item_ids.push(item.function.id)
    if !jet_driver_merge_comptime_functions(&lowered, items, load, &diagnostics) -> return None
    temporary_hardware_use := sema_hardware_use_snapshot(head.hardware_use)
    closure_keys := [String:Bool]{}
    loop selected_function in closure -> closure_keys[selected_function.key] = true
    loop function in checked_functions {
        if closure_keys.get(function.function_key) != None -> sema_hardware_use_merge(&temporary_hardware_use, sema_hardware_use_snapshot(function.hardware_use))
    }
    temporary_facts :: jet_driver_package_facts(
        load,
        request,
        graph.target_machine,
        lowered.used_core,
        jet_ring_prelude_closure_layer(lowered.used_core),
        temporary_hardware_use,
        &diagnostics,
    ) ?? return None
    if staging.foreign == None -> staging.foreign = Val(lower_foreign_artifacts(staging.runtime_modules, temporary_facts))
    foreign_artifacts :: staging.foreign ?? lower_foreign_artifacts(staging.runtime_modules, temporary_facts)
    temporary_program := jet_driver_assemble_mir(
        load,
        staging.runtime_modules,
        [SemaRegistrationImport]{},
        names,
        ^lowered,
        foreign_artifacts,
        temporary_facts,
        false,
        false,
        &diagnostics,
    )
    if temporary_program == None {
        if !jet_driver_has_errors(diagnostics) {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, head.module_identity, "E0003", head.span, "the checked comptime function closure cannot be represented by MIR", "temporary MIR includes only checked functions and canonical declaration facts", "preserve canonical identities through the interpreter MIR fragment"))
        }
        return None
    }
    temporary_program
}

// The live program record of `program`, built for the batch closure
// `closure` (moved in): its closure keys and row identities.
fn jet_driver_comptime_live(load: JetDriverLoadResult, program: MIRProgram, closure: ^[TFunc]) -> JetDriverComptimeLive Never! {
    functions := ^closure
    function_keys := [String:Bool]{}
    loop function in functions -> function_keys["{function.module_identity}\n{function.key}"] = true
    function_ids := [U64:Bool]{}
    mir_keys := [String:Bool]{}
    loop function in program.functions {
        function_ids[function.id.value] = true
        mir_keys[function.key] = true
    }
    callbacks := [MIRCallbackAdapter]{}
    callback_rows := [U64:Int]{}
    loop callback in program.callbacks {
        if callback_rows.get(callback.id.value) != None -> next
        callback_rows[callback.id.value] = callbacks.len()
        &callbacks.push(callback)
    }
    fields := [MIRFieldRow]{}
    field_rows := [U64:Int]{}
    loop field in program.fields {
        if field_rows.get(field.id.value) != None -> next
        field_rows[field.id.value] = fields.len()
        &fields.push(field)
    }
    core_calls := [U64:String]{}
    loop call in program.core_calls -> core_calls[call.id.value] = call.key
    prelude_calls := [U64:Bool]{}
    loop call in program.prelude_calls -> prelude_calls[call.id.value] = true
    instances := [U64:Bool]{}
    loop instance in program.type_instances {
        identity :: instance.identity ?? next
        instances[identity.value] = true
    }
    types := [U64:Bool]{}
    loop definition in program.types -> types[definition.id.value] = true
    traits := [U64:Bool]{}
    loop definition in program.traits -> traits[definition.id.value] = true
    JetDriverComptimeLive{
        session: [JetEvalRuntimeSession]{},
        globals_count: 0,
        functions: ^functions,
        function_keys: ^function_keys,
        function_ids: ^function_ids,
        mir_keys: ^mir_keys,
        callbacks: ^callbacks,
        callback_rows: ^callback_rows,
        fields: ^fields,
        field_rows: ^field_rows,
        core_calls: ^core_calls,
        prelude_calls: ^prelude_calls,
        instances: ^instances,
        types: ^types,
        traits: ^traits,
        assembly: jet_driver_assembly_index(load),
    }
}

// Whether the new MIR functions `functions` fit the live program as rows of
// its own (jet_driver_assemble_mir's checks, against its row sets): top-level
// form, a nonzero id and a key that neither it nor an earlier new function
// has, the owner and source file of a loaded module, and generic bounds on
// traits it has (it synthesizes none for them). Adds each id and key to
// `ids` and `keys`.
fn jet_driver_comptime_growth_functions_fit(live: JetDriverComptimeLive, functions: [MIRFunction], ids: &[U64:Bool], keys: &[String:Bool]) -> Bool Never! {
    loop function in functions {
        top_level := if function.form == {
            .TopLevel -> true
            else -> false
        }
        if !top_level || function.id.value == 0 -> return false
        if live.function_ids.get(function.id.value) != None || ids.get(function.id.value) != None -> return false
        if live.mir_keys.get(function.key) != None || keys.get(function.key) != None -> return false
        owner :: jet_driver_assembly_module_index(live.assembly, function.module_id) ?? return false
        expected :: live.assembly.module_source_files[owner] ?? return false
        if function.source_file.value != expected.value || live.assembly.source_files.get(function.source_file.value) == None -> return false
        loop parameter in function.generic_params {
            loop bound in parameter.bounds {
                if live.traits.get(bound.id.value) == None -> return false
            }
        }
        ids[function.id.value] = true
        keys[function.key] = true
    }
    true
}

// A2c: grows the live program by the evaluated entries of `batch` from
// `start` on, when they fit it: the closure functions it lacks are free
// functions no declared row names (lower_comptime_growth), and the new rows
// fit it as they are (jet_driver_comptime_growth_functions_fit; callback and
// field rows equal to its own where ids meet; Core call keys equal where ids
// meet; synthetic unions it has). The rows then join the session's program
// (jet_eval_session_grow) together with the constant rows staged since it
// was built, the item function ids go to `item_ids` in entry order, the
// session moves into `machines`, and `live` records the new rows. False
// otherwise, with `live` and its session unchanged; the staged session's
// closure may then hold the new functions (`staging.restore`).
fn jet_driver_comptime_grow(
    batch: JetDriverComptimeBatch,
    start: Int,
    staging: &JetDriverComptimeStaging,
    counters: &JetDriverComptimeCounters,
    live: &JetDriverComptimeLive,
    item_ids: &[MIRFunctionID],
    machines: &[JetDriverComptimeMachine],
    trace_sink: CompilerTraceSink?,
) -> Bool {
    if live.session.len() == 0 -> return false
    new_functions := [TFunc]{}
    loop function in batch.functions {
        if live.function_keys.get("{function.module_identity}\n{function.key}") == None -> &new_functions.push(function)
    }
    requests := [SemaComptimeItemRequest]{}
    loop index in start..<batch.entries.len() {
        if batch.entries[index].plain == None -> &requests.push(batch.entries[index].request)
    }
    restore := staging.restore
    lowered := JetCodegenFunctions?{None}
    if &staging.session == {
        None -> return false
        .Val(session) -> {
            if restore -> jet_codegen_comptime_session_restore(&session, live.functions)
            if trace_sink == .Val(sink) -> sink.begin("comptime.lower", "grow", -1, -1)
            lowered = lower_comptime_growth(&session, new_functions, requests, staging.growth_constants)
            if trace_sink == .Val(sink) -> sink.end("comptime.lower", new_functions.len() + requests.len())
        }
    }
    staging.restore = false
    grown := ^lowered ?? return false
    staging.restore = true
    counters.rows_lowered += new_functions.len() + requests.len()
    if counters.track_keys {
        loop function in new_functions -> counters.lowered_keys["{function.module_identity}\n{function.key}"] = true
    }
    // A growth that brings global `shared` constant sites (closure rows the
    // own/union build merges, Codegen Functions.jet) does not fit the live
    // program: fall back to the union/own build, as a non-fitting growth does.
    if grown.constants.len() > 0 -> return false
    ids := [U64:Bool]{}
    keys := [String:Bool]{}
    if !jet_driver_comptime_growth_functions_fit(live, grown.functions, &ids, &keys) -> return false
    if !jet_driver_comptime_growth_functions_fit(live, grown.nested_functions, &ids, &keys) -> return false
    loop definition in grown.types {
        if live.types.get(definition.id.value) == None -> return false
    }
    callbacks := [MIRCallbackAdapter]{}
    callback_rows := [U64:Int]{}
    loop callback in grown.callbacks {
        if callback.id.value == 0 -> return false
        if live.function_ids.get(callback.function.value) == None && ids.get(callback.function.value) == None -> return false
        if live.callback_rows.get(callback.id.value) == .Val(row) {
            if !jet_driver_mir_callback_rows_equal(live.callbacks[row], callback) -> return false
            next
        }
        if callback_rows.get(callback.id.value) == .Val(row) {
            if !jet_driver_mir_callback_rows_equal(callbacks[row], callback) -> return false
            next
        }
        callback_rows[callback.id.value] = callbacks.len()
        &callbacks.push(callback)
    }
    fields := [MIRFieldRow]{}
    field_rows := [U64:Int]{}
    loop field in grown.fields {
        if live.field_rows.get(field.id.value) == .Val(row) {
            if !jet_driver_mir_field_rows_equal(live.fields[row], field) -> return false
            next
        }
        if field_rows.get(field.id.value) == .Val(row) {
            if !jet_driver_mir_field_rows_equal(fields[row], field) -> return false
            next
        }
        field_rows[field.id.value] = fields.len()
        &fields.push(field)
    }
    core_calls := [MIRCoreCall]{}
    loop call in grown.core_calls {
        if live.core_calls.get(call.id.value) == .Val(key) {
            if key != call.key -> return false
            next
        }
        &core_calls.push(call)
    }
    prelude_calls := [MIRPreludeCall]{}
    loop call in grown.prelude_calls {
        if live.prelude_calls.get(call.id.value) != None -> next
        &prelude_calls.push(call)
    }
    instances := [MIRType]{}
    // Bound first: the stage-zero parser reads a typed list literal in a loop
    // header as the loop body.
    collected := jet_codegen_collect_type_instances([MIRTypeDef]{}, grown.functions, grown.nested_functions, [MIRForeign]{}, [MIRTraitDef]{}, [MIRImplDef]{}, staging.growth_constants)
    loop instance in collected {
        identity :: instance.identity ?? next
        if live.instances.get(identity.value) != None -> next
        &instances.push(instance)
    }
    // The growth fits: record it, then move the rows into the session.
    item_start :: grown.functions.len() - requests.len()
    loop index in item_start..<grown.functions.len() -> &item_ids.push(grown.functions[index].id)
    loop (id, _) in ids -> live.function_ids[id] = true
    loop (key, _) in keys -> live.mir_keys[key] = true
    loop callback in callbacks {
        live.callback_rows[callback.id.value] = live.callbacks.len()
        &live.callbacks.push(callback)
    }
    loop field in fields {
        live.field_rows[field.id.value] = live.fields.len()
        &live.fields.push(field)
    }
    loop call in core_calls -> live.core_calls[call.id.value] = call.key
    loop call in prelude_calls -> live.prelude_calls[call.id.value] = true
    loop instance in instances {
        identity :: instance.identity ?? next
        live.instances[identity.value] = true
    }
    loop function in new_functions -> live.function_keys["{function.module_identity}\n{function.key}"] = true
    compiler_transfer_rows<TFunc>(&live.functions, &new_functions)
    rows := [MIRFunction]{}
    compiler_transfer_rows<MIRFunction>(&rows, &grown.functions)
    compiler_transfer_rows<MIRFunction>(&rows, &grown.nested_functions)
    constants := [MIRConstantDef]{}
    jet_driver_comptime_take_constants(&constants, &staging.growth_constants)
    growth := JetEvalProgramGrowth{functions: ^rows, callbacks: ^callbacks, fields: ^fields, constants: ^constants, core_calls: ^core_calls, prelude_calls: ^prelude_calls, type_instances: ^instances}
    session := &live.session.pop() ?? return false
    jet_eval_session_grow(&session, ^growth)
    &machines.push(JetDriverComptimeMachine{program: None, session: Val(^session), globals_count: live.globals_count})
    counters.programs_grown += 1
    staging.restore = false
    true
}

// Evaluates `function_id` on a flush's program in the in-process evaluator,
// which serves compile-time code (AGENTS.md I9) until native
// in-memory O0 lands. The first evaluation moves the program into a new
// evaluator machine, whose globals are the Host's (`original`) and every
// constant of `values`; each later one reuses the machine the previous result
// left (jet_eval_session_function), which starts over exactly as a new
// machine over the same program would, gaining the globals of the values that
// landed since. Every field is moved out and reset (`^x.f` then
// `x.f = None`); a field moved out without the reset is copied.
fn jet_driver_comptime_machine_eval(owned: ^JetDriverComptimeMachine, function_id: MIRFunctionID, original: JetEvalConfig, values: [SemaComptimeItemValue], inputs: JetEvalComptimeInputAdapter?) -> JetEvalResult {
    machine := ^owned
    taken_session := ^machine.session
    machine.session = None
    reused := ^taken_session ?? {
        taken_program := ^machine.program
        machine.program = None
        program := ^taken_program ?? panic("a comptime flush lost its temporary program")
        globals := original.globals.copy()
        jet_driver_comptime_globals_add(&globals, values, 0)
        return jet_eval_function(^program, function_id, [TComptimeValue]{}, jet_driver_comptime_eval_config(original, ^globals, inputs))
    }
    added := [String:TComptimeValue]{}
    jet_driver_comptime_globals_add(&added, values, machine.globals_count)
    jet_eval_session_function(^reused, function_id, [TComptimeValue]{}, jet_driver_comptime_eval_config(original, [String:TComptimeValue]{}, inputs), added)
}

// Lands or evaluates the entries of `batch` in order, exactly as the run
// would one item at a time: plain literals land their values; the evaluated
// entries share one program and one evaluator machine. A batch holds several
// evaluated entries only when each passed jet_driver_comptime_batchable; a
// shareable batch (jet_driver_comptime_shareable, alone or several) grows
// the run's live program when it can (A2c), else
// builds the union of the live closure and its own. If no shared program can
// be built, its reports are withdrawn and each entry is evaluated on its own
// program. The registration rows a flush reads (module rows, identities,
// source segments, the target machine) are read from `program`'s graph,
// whose staged values never change them. `program` is read-only, so that
// graph is borrowed in place, never copied per flush.
fn jet_driver_comptime_flush(
    names: MIRNameFacts,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    batch: JetDriverComptimeBatch,
    values: &[SemaComptimeItemValue],
    checked_functions: [SemaComptimeFunctionResult],
    trace: &JetDriverCompileTrace,
    program: SemaProgramTables,
    available: &SemaComptimeAvailableConstants,
    staging: &JetDriverComptimeStaging,
    counters: &JetDriverComptimeCounters,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeFlush {
    graph_option :: program.registration_graph
    graph :: graph_option ?? return JetDriverComptimeFlush{stop: Val(jet_driver_comptime_lost_graph(values, checked_functions, trace)), progressed: false}
    flushed := JetDriverComptimeFlush{stop: None, progressed: false}
    start := 0
    loop start < batch.entries.len() {
        plain :: batch.entries[start].plain ?? { break }
        &values.push(jet_driver_comptime_item_value(batch.entries[start].source, plain, batch.entries[start].request.expression.ty))
        flushed.progressed = true
        start += 1
    }
    if start == batch.entries.len() -> return flushed
    evaluated := 0
    loop index in start..<batch.entries.len() {
        if batch.entries[index].plain == None -> evaluated += 1
    }
    // Staging once, at the first evaluated entry, serves every entry: an
    // entry's check and closure name only constants that landed before the
    // batch (naming a batch constant makes a check wait on it), and rows of
    // constants an item does not name never change its value.
    if batch.bare && staging.bare_ok && (staging.session == None || staging.bare) {
        if staging.session == None -> jet_driver_comptime_stage_bare(graph, load, request.comptime_stop_points, &staging)
    } else {
        if staging.bare -> jet_driver_comptime_unstage_bare(&staging)
        staged :: jet_driver_comptime_stage(graph, load, batch.entries[start].request, batch.needs_rows, request.comptime_stop_points, values, checked_functions, trace, program, &available, &staging, &diagnostics)
        if staged == .Val(stopped) {
            flushed.stop = Val(stopped)
            return flushed
        }
    }
    if staging.session == None {
        flushed.stop = Val(jet_driver_comptime_lost_session(values, checked_functions, trace))
        return flushed
    }
    item_functions := [MIRFunctionID]{}
    // One slot holds the machine between entries: a loop-carried local may
    // not be moved inside the loop, so each entry pops it and pushes back the
    // machine its result leaves.
    machines := [JetDriverComptimeMachine]{}
    // A2c: a shareable batch takes the run's live program out of its slot
    // and grows it when it can; otherwise it builds one program for the live
    // closure and its own, which becomes the live program. It never grows
    // once the run has reported an error, as no program of its own could be
    // assembled then (jet_driver_assemble_mir). The record goes
    // back into the slot when the flush ends; a flush that stops the run, or
    // whose programs could not be built, drops it.
    live := [JetDriverComptimeLive]{}
    if batch.shareable {
        loop staging.live.len() > 0 {
            row := &staging.live.pop() ?? { break }
            &live.push(^row)
        }
        if live.len() > 0 && !jet_driver_has_errors(diagnostics) {
            _ := jet_driver_comptime_grow(batch, start, &staging, &counters, &live[0], &item_functions, &machines, request.trace_sink)
        }
    }
    if machines.len() == 0 {
        mark := diagnostics.len()
        built := MIRProgram?{None}
        closure := [TFunc]{}
        if live.len() > 0 {
            closure = jet_driver_comptime_union_closure(live, batch)
            built = jet_driver_comptime_program(graph, names, load, request, closure, batch, start, checked_functions, &staging, &counters, &item_functions, &diagnostics)
            if built == None {
                // The union does not build: withdraw its reports and build
                // the batch's own program, as one batch at a time would.
                loop diagnostics.len() > mark {
                    _ := &diagnostics.pop()
                }
                loop item_functions.len() > 0 {
                    _ := &item_functions.pop()
                }
                live = [JetDriverComptimeLive]{}
            }
        }
        if live.len() == 0 {
            built = jet_driver_comptime_program(graph, names, load, request, batch.functions, batch, start, checked_functions, &staging, &counters, &item_functions, &diagnostics)
            if batch.shareable -> closure = batch.functions
        }
        if built == None && evaluated > 1 {
            loop diagnostics.len() > mark {
                _ := &diagnostics.pop()
            }
            loop index in start..<batch.entries.len() {
                single := jet_driver_comptime_flush(names, load, request, jet_driver_comptime_batch_single(batch, index), &values, checked_functions, &trace, program, &available, &staging, &counters, &diagnostics)
                if single.progressed -> flushed.progressed = true
                if single.stop == .Val(stopped) {
                    flushed.stop = Val(stopped)
                    return flushed
                }
            }
            return flushed
        }
        if built == None {
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        if batch.shareable {
            live = [JetDriverComptimeLive]{}
            if built == .Val(built_program) -> &live.push(jet_driver_comptime_live(load, built_program, ^closure))
            staging.growth_constants = [MIRConstantDef]{}
            staging.restore = false
        }
        &machines.push(JetDriverComptimeMachine{program: ^built, session: None, globals_count: 0})
    }
    evaluated_index := 0
    loop index in start..<batch.entries.len() {
        entry :: batch.entries[index]
        if entry.plain == .Val(plain) {
            &values.push(jet_driver_comptime_item_value(entry.source, plain, entry.request.expression.ty))
            flushed.progressed = true
            next
        }
        function_id :: item_functions[evaluated_index]
        evaluated_index += 1
        counters.item_functions_evaluated += 1
        if staging.bare -> counters.items_bare += 1
        source :: entry.source
        comptime_request :: entry.request
        if !jet_driver_comptime_globals_check(&staging, values, graph, comptime_request.module_identity, comptime_request.span, &diagnostics) {
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        machine := &machines.pop() ?? panic("a comptime flush lost its evaluator machine")
        eval_result := jet_driver_comptime_machine_eval(^machine, function_id, request.eval_config, values, jet_driver_comptime_inputs_for(request, source.source_file))
        // Classify the evaluator's final, retired result: retirement still
        // records cleanup failures, internal problems and output.
        evaluated_value := TComptimeValue?{None}
        if eval_result.error == None && eval_result.internal_problem == None && eval_result.complete && !eval_result.soft_stop {
            evaluated_value = jet_eval_comptime_value(&eval_result, comptime_request.span)
        }
        if request.eval_config.ir_differential {
            // The staged session holds the declared modules (the runtime
            // modules are identity-only when the batch stages bare).
            if &staging.session == {
                None -> {}
                .Val(session) -> jet_driver_comptime_ir_differential(session.program.modules, batch.functions, comptime_request, values, request.eval_config, evaluated_value, eval_result.error, eval_result.internal_problem, request.trace_sink)
            }
        }
        // The retired session keeps the program for the next entry.
        _ := jet_eval_retire_in_place(&eval_result, comptime_request.span)
        &machines.push(JetDriverComptimeMachine{program: None, session: ^eval_result.session, globals_count: values.len()})
        eval_result.session = None
        jet_driver_record_eval_result(&trace, eval_result)
        if source.kind == SemaComptimeItemKind.FieldDefault && eval_result.error != None && eval_result.internal_problem == None {
            // Rust CheckerMarkers an unevaluable field default lands
            // no value and construction lowers its expression; only a struct
            // that bakes its defaults needs the value (E2414).
            if source.baked_default {
                name_parts := source.name.split(".").to_list()
                field_name :: &name_parts.pop() ?? source.name
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E2414", source.span, "`{field_name}`'s `{{…}}` default must be a compile-time constant", "a decode default is baked into the program, so its value has to be known at compile time; this expression can only be computed at runtime", "use a literal or a `comptime`-evaluable expression — e.g. `port: Int{{8080}}` or `ports: [Int]{{[80, 443]}}`"))
            }
            next
        }
        if eval_result.error != None || eval_result.internal_problem != None {
            if eval_result.error == .Val(eval_error) {
                &diagnostics.push(jet_driver_attach_registration_source_location(eval_error.diagnostic, graph, comptime_request.module_identity))
            }
            if graph.keep_going {
                if eval_result.internal_problem == .Val(problem) -> &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "keep-going: the comptime interpreter failed internally: {problem.message}", "JET_KEEP_GOING drops the item and runs the rest", "fix the interpreter defect"))
                next
            }
            // An interpreter internal problem is a compiler defect with its
            // own exact message; it leaves as the run's internal problem.
            failed := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
            if eval_result.internal_problem == .Val(problem) -> failed.internal_problem = Val("the comptime interpreter failed internally: {problem.message}")
            flushed.stop = Val(failed)
            return flushed
        }
        if eval_result.soft_stop {
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, true))
            return flushed
        }
        if !eval_result.complete {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "the comptime interpreter returned neither a value nor an explicit control result", "only complete values and canonical soft-stop control may leave evaluation", "return the evaluator's exact error or completed result"))
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        value :: evaluated_value ?? {
            &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, comptime_request.module_identity, "E0003", comptime_request.span, "a complete comptime evaluation returned no value", "a staged value is recorded only after successful evaluation", "preserve the completed interpreter value"))
            flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
            return flushed
        }
        if source.kind == SemaComptimeItemKind.CheckedText {
            if value == .Failed(_) {
                evaluation :: source.checked_text ?? {
                    &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E0003", source.span, "a checked-text validation item lost its exact method request", "CheckedText literals evaluate their registered pure checker on the fully encoded body", "preserve the checked-text request through staged evaluation"))
                    flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
                    return flushed
                }
                &diagnostics.push(jet_driver_diagnostic_at_registration_site(graph, source.module_identity, "E2712", evaluation.span, "this checked text type rejected its body", "the type's pure `CheckedText.check` method must accept the complete literal body", "fix the body so it satisfies the type's declared text grammar"))
                flushed.stop = Val(jet_driver_comptime_run_result(values, checked_functions, trace, false, false))
                return flushed
            }
            flushed.progressed = true
            next
        }
        &values.push(jet_driver_comptime_item_value(source, value, comptime_request.expression.ty))
        flushed.progressed = true
    }
    // The live program's session goes back into its record, and the record
    // into the run's slot.
    if live.len() == 0 -> return flushed
    machine := &machines.pop() ?? return flushed
    taken := ^machine.session
    machine.session = None
    session := ^taken ?? return flushed
    &live[0].session.push(^session)
    live[0].globals_count = machine.globals_count
    record := &live.pop() ?? return flushed
    &staging.live.push(^record)
    flushed
}
// `known` holds the `module\nkey` of every source already pending or staged.
fn jet_driver_comptime_checked_text_source_add(sources: &[SemaComptimeItemSource], known: &[String:Bool], evaluation: SemaCheckedTextEvaluation) Never! {
    source := sema_comptime_checked_text_source(evaluation)
    key :: "{source.module_identity}\n{source.key}"
    if known.get(key) != None -> return
    known[key] = true
    &sources.push(source)
}

// Each function joins the first module with its identity, in place: the
// module is found through one identity map instead of copying every module
// passed while searching, and edited without copying it out and back. An
// incomplete result fails the merge before any module changes. The caller
// rebuilds the bundle's name facts afterwards.
fn jet_driver_merge_checked_text_functions(graph: &SemaGraphResult, functions: [SemaComptimeFunctionResult]) -> Bool Never! {
    module_rows := [String:Int]{}
    loop (index, graph_module) in graph.modules {
        if module_rows.get(graph_module.module_identity) == None -> module_rows[graph_module.module_identity] = index
    }
    loop checked in functions {
        function :: checked.function ?? return false
        module_index :: module_rows.get(checked.module_identity) ?? return false
        duplicate := false
        loop existing_index in 0..<graph.modules[module_index].functions.len() {
            existing :: graph.modules[module_index].functions[existing_index]
            if existing.key == function.key -> duplicate = true
        }
        if duplicate -> next
        if !checked.complete -> return false
        if !sema_comptime_append_checked_function_to_module(checked, &graph.modules[module_index]) -> return false
        loop fact in checked.call_facts -> &graph.call_facts.push(fact)
        loop request in checked.calls -> &graph.comptime_requests.push(request)
    }
    true
}

// The bundle's name facts rebuilt over the merged modules on the compiler
// threads (jet_driver_merge_checked_text_functions); the registration graph
// moves in and is returned.
fn jet_driver_merged_names(graph: &SemaGraphResult, registration: ^SemaRegistrationGraph, threads: CompilerThreads) -> SemaRegistrationGraph {
    names := sema_name_facts_empty()
    returned := sema_name_build_facts_threads(^registration, &graph.modules, graph.names.structure_facts, threads, &names)
    graph.names = ^names
    returned
}

// `staged` is the graph the run's program tables own (moved in, never
// copied): the declaration pass's graph (SemaComptimeDeclarationStage.graph)
// or the caller's own copy. Every edit the run makes to it is recorded on the
// result's `trail`, and the graph comes back on every exit (`graph` or
// `partial_graph`). The run owns the staging (its session holds `declared`
// once staged), so it hands `declared` back in the result on every exit
// (jet_driver_comptime_take_declared).
fn jet_driver_run_comptime(
    staged: ^SemaRegistrationGraph,
    // The declaration pass's modules of `staged` (jet_driver_comptime_stage), or empty.
    declared: ^[SemaGraphModuleResult],
    sources: [SemaComptimeItemSource],
    names: MIRNameFacts,
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeRunResult {
    track_keys := false
    if request.trace_sink == .Val(_) -> track_keys = true
    counters := JetDriverComptimeCounters{items_checked: 0, programs_built: 0, programs_grown: 0, item_functions_evaluated: 0, rows_lowered: 0, items_bare: 0, track_keys: track_keys, lowered_keys: [String:Bool]{}}
    // Read before the tables take `staged`: staged values only type waiting
    // constants, so the module rows, foreign rows and the keep-going mode
    // read the same with or without them.
    bare_ok :: jet_driver_comptime_bare_ok(staged, declared)
    keep_going := staged.keep_going
    // One program-tables value owns the graph carrying the staged values for
    // every item and function check, beside one environment they re-target;
    // the values that landed since the last item are applied to that graph in
    // place rather than rebuilding it per item, and counted into the run's
    // available constant keys.
    trail := sema_graph_trail_init()
    environment := sema_comptime_environment(^staged, initial_values, request.trace_sink)
    // Retained initialization builds the indexes once. Transfer those owned
    // rows into the program carrier used beside the retargeted environment.
    program := SemaProgramTables{
        registration_graph: ^environment.registration_graph,
        checked_types: ^environment.checked_types,
        checked_type_rows: ^environment.checked_type_rows,
        checked_type_name_slots: ^environment.checked_type_name_slots,
        checked_type_name_rows: ^environment.checked_type_name_rows,
        boxed_edges: ^environment.boxed_edges,
        copy_facts: ^environment.copy_facts,
    }
    // The program now owns these tables. Restore the environment's ordinary
    // empty table fields before retargeting its still-owned module metadata.
    environment.registration_graph = None
    environment.checked_types = [TTypeDef]{}
    environment.checked_type_rows = [String:Int]{}
    environment.checked_type_name_slots = [String:Int]{}
    environment.checked_type_name_rows = [[Int]]{}
    environment.boxed_edges = [String:[String]]{}
    environment.copy_facts = sema_copy_facts_table_empty()
    // The run sets `sites` once it has items to check.
    staging := JetDriverComptimeStaging{session: None, runtime_modules: [SemaGraphModuleResult]{}, foreign: None, count: -1, live: [JetDriverComptimeLive]{}, growth_constants: [MIRConstantDef]{}, restore: false, global_keys: [String:Bool]{}, global_count: 0, sites: sema_comptime_value_sites_empty(), bare: false, bare_ok: bare_ok, declared: ^declared, declared_staged: false}
    // Each in a one-row slot: a pass's prechecks move them into the threads'
    // shared state and back (moving a borrowed value out would copy the
    // whole graph once per pass).
    programs := [SemaProgramTables]{}
    &programs.push(^program)
    environments := [SemaScopeEnvironment]{}
    &environments.push(^environment)
    result := jet_driver_comptime_run(&programs, &environments, &trail, keep_going, sources, names, initial_values, initial_functions, load, request, &staging, &counters, &diagnostics)
    result.declared = jet_driver_comptime_take_declared(^staging)
    if request.trace_sink == .Val(sink) {
        sink.progress("counters.comptime.items_checked", counters.items_checked, -1)
        sink.progress("counters.comptime.programs_built", counters.programs_built, -1)
        sink.progress("counters.comptime.programs_grown", counters.programs_grown, -1)
        sink.progress("counters.comptime.item_functions_evaluated", counters.item_functions_evaluated, -1)
        sink.progress("counters.comptime.rows_lowered", counters.rows_lowered, -1)
        sink.progress("counters.comptime.items_bare", counters.items_bare, -1)
        sink.progress("counters.comptime.functions_lowered", counters.lowered_keys.len(), -1)
    }
    result.lowered_keys = ^counters.lowered_keys
    // The completed run hands the graph on as `graph`; any other exit hands
    // it back here.
    run_program := &programs.pop() ?? panic("a comptime run lost its program tables slot")
    if result.graph_finished {
        result.graph = ^run_program.registration_graph
    } else {
        result.partial_graph = ^run_program.registration_graph
    }
    run_program.registration_graph = None
    result.trail = ^trail
    result
}

// The declaration pass's modules a run was given, out of its staging: out of
// the staged session once the first full staging moved them in (the session
// only joined constant rows to them, jet_codegen_comptime_session_add_constants),
// else as they were moved in.
fn jet_driver_comptime_take_declared(staging: ^JetDriverComptimeStaging) -> [SemaGraphModuleResult] {
    if !staging.declared_staged -> return ^staging.declared
    taken := ^staging.session
    session := ^taken ?? panic("a comptime run lost the staged session that holds the declared modules")
    jet_codegen_comptime_session_modules(^session)
}

// Hands the declaration pass's modules back from a run to its stage, whose
// finalization reads their type definitions (sema_finalize_registration_graph).
fn jet_driver_comptime_return_declared(stage: &SemaComptimeDeclarationStage, run: &JetDriverComptimeRunResult) Never! {
    stage.modules = [SemaGraphModuleResult]{}
    jet_driver_comptime_take_modules(&stage.modules, &run.declared)
}

// `programs` holds the program tables that own the run's graph and
// `environments` the environment they re-target, each the one row of its
// slot, so a pass's prechecks move them into the threads' shared state and
// back (sema_comptime_precheck_items) instead of copying them out of a
// borrow; `trail` records the graph's edits; `keep_going` was read from the
// graph before the tables took it (jet_driver_run_comptime).
fn jet_driver_comptime_run(
    programs: &[SemaProgramTables],
    environments: &[SemaScopeEnvironment],
    trail: &SemaGraphTrail,
    keep_going: Bool,
    sources: [SemaComptimeItemSource],
    names: MIRNameFacts,
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    staging: &JetDriverComptimeStaging,
    counters: &JetDriverComptimeCounters,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeRunResult {
    // copy: this run grows its own value list. initial_values is jet_driver_run_comptime's read
    // parameter, which also seeds the comptime environment and stays with the caller.
    values := initial_values.copy()
    // The memory plan reads only function declarations, which staged values
    // never change, so every on-demand function check shares one, built at
    // the run's first function check (jet_driver_comptime_function_closure).
    memory_plan := [SemaFunctionMemoryPlan]{}
    // copy: this run grows its own checked-function list. initial_functions is
    // jet_driver_run_comptime's read parameter, which stays with the caller.
    checked_functions := initial_functions.copy()
    trace := jet_driver_empty_compile_trace()
    pending := sources
    // The `module\nkey` of every source pending or staged in this run.
    known_sources := [String:Bool]{}
    loop source in sources -> known_sources["{source.module_identity}\n{source.key}"] = true
    // The module scope every item and function check of the run checks in.
    probe := sema_comptime_probe_init(sema_host_hook_access(request.eval_config.host_hooks))
    resolved_count := values.len()
    // Constants' AST values, which staged values never change, read in place.
    available := jet_driver_comptime_program_available(programs[0], values)
    run_index := jet_driver_comptime_run_index(checked_functions)
    // Checked functions whose checked-text calls were already queued; the
    // run's checked functions only grow, so each is scanned once.
    scanned_functions := 0
    // Declaration checks of every module under the staged values, run once:
    // a value that lands later changes only its own constant's row
    // (sema_comptime_staged_constant_rows), which joins the lowering session
    // in place. An item that names no staged constant and calls no function
    // cannot observe a value, so it lowers against the last staged rows; any
    // other item first takes the rows of the values that landed since them
    // (jet_driver_comptime_stage). Codegen owns the staged modules (moved in,
    // never copied per item) and their indexes.
    staging.sites = jet_driver_comptime_program_sites(programs[0])
    loop (key, _) in request.eval_config.globals -> staging.global_keys[key] = true
    // Items whose check and closure read nothing a batch holds back
    // (jet_driver_comptime_reads_batch) are checked and, when
    // jet_driver_comptime_batchable admits them, wait in `batch` to be
    // evaluated together on one temporary program. An item whose check reads
    // the batch lands it first and is checked again; one whose closure reads
    // it withdraws the closure's reports and function checks, lands the batch
    // and starts over (`retry`). Either way every check sees exactly the
    // values it would see one item at a time, and a flush leaves the batch
    // empty, so an item starts over at most once. Any other item flushes the
    // batch before it is evaluated alone; a shareable one
    // (jet_driver_comptime_shareable) on the run's live program (A2c).
    batch := jet_driver_comptime_batch_new()
    // The waits of each pending item (`module\nkey`) whose last check, with
    // its closure, reported nothing: until one of those keys has a value or
    // joins the batch, checking it again gives the same waits (it names no
    // other unvalued constant), so the run reuses them instead of checking it
    // once per pass; a dependency chain declared in reverse order would
    // otherwise check every waiting item on every pass.
    settled_waits := [String:[String]]{}
    loop pending.len() > 0 {
        next_pending := [SemaComptimeItemSource]{}
        wait_rows := [JetDriverComptimeWaitRow]{}
        made_progress := false
        // The values that landed last pass join the graph before the pass
        // (each item's turn applies them first anyway), so the pass's item
        // checks can be made ahead of it on the compiler threads; an item
        // takes its check at its turn when no value it depends on has landed
        // since (jet_driver_comptime_prechecked).
        if values.len() > resolved_count {
            if !jet_driver_comptime_apply_landed(&environments[0], &programs[0], &available, staging.sites, values, resolved_count, &trail) {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return jet_driver_comptime_lost_graph(values, checked_functions, trace)
            }
            resolved_count = values.len()
        }
        prechecks := sema_comptime_precheck_items(&environments, &programs, available, pending, request.compiler_threads)
        &prechecks.reverse()
        prechecked_values :: values.len()
        loop source in pending {
            precheck := &prechecks.pop() ?? SemaComptimeItemCheck?{None}
            retry := true
            loop retry {
                retry = false
                if values.len() > resolved_count {
                    if !jet_driver_comptime_apply_landed(&environments[0], &programs[0], &available, staging.sites, values, resolved_count, &trail) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return jet_driver_comptime_lost_graph(values, checked_functions, trace)
                    }
                    resolved_count = values.len()
                }
                source_key :: "{source.module_identity}\n{source.key}"
                if settled_waits.get(source_key) == .Val(previous_waits) {
                    if !jet_driver_comptime_any_available(available, previous_waits) && !jet_driver_comptime_reads_batch(batch.keys, previous_waits, false) {
                        &wait_rows.push(JetDriverComptimeWaitRow{
                            key: source.key,
                            name: source.name,
                            module_identity: source.module_identity,
                            span: source.span,
                            dependencies: previous_waits,
                        })
                        &next_pending.push(source)
                        next
                    }
                }
                checked_item := jet_driver_comptime_prechecked(^precheck, values, prechecked_values) ?? sema_check_comptime_item(&environments[0], &programs[0], &probe, available, source)
                precheck = None
                counters.items_checked += 1
                if batch.entries.len() > 0 && jet_driver_comptime_reads_batch(batch.keys, checked_item.waiting_dependencies, checked_item.diagnostics.len() > 0 || !checked_item.complete) {
                    flushed := jet_driver_comptime_flush(names, load, request, batch, &values, checked_functions, &trace, programs[0], &available, &staging, &counters, &diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                    if values.len() > resolved_count {
                        if !jet_driver_comptime_apply_landed(&environments[0], &programs[0], &available, staging.sites, values, resolved_count, &trail) {
                            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                            return jet_driver_comptime_lost_graph(values, checked_functions, trace)
                        }
                        resolved_count = values.len()
                        checked_item = sema_check_comptime_item(&environments[0], &programs[0], &probe, available, source)
                        counters.items_checked += 1
                    }
                }
                item_diagnostic_start := diagnostics.len()
                // A comptime item's checker reports against its own module's
                // source, so each carries that module's location.
                loop diagnostic in checked_item.diagnostics -> &diagnostics.push(jet_driver_attach_program_source_location(diagnostic, programs[0], source.module_identity))
                // JET_KEEP_GOING: an item whose own check reported an error is
                // dropped (its value never lands) and the run goes on.
                if keep_going {
                    if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
                } else if jet_driver_has_errors(diagnostics) {
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                if checked_item.waiting_dependencies.len() > 0 {
                    if checked_item.diagnostics.len() == 0 {
                        settled_waits[source_key] = checked_item.waiting_dependencies
                    } else {
                        _ := &settled_waits.remove(source_key)
                    }
                    &wait_rows.push(JetDriverComptimeWaitRow{
                        key: source.key,
                        name: source.name,
                        module_identity: source.module_identity,
                        span: source.span,
                        dependencies: checked_item.waiting_dependencies,
                    })
                    &next_pending.push(source)
                    next
                }
                if !checked_item.complete && keep_going {
                    &diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` did not check to a complete typed value", "JET_KEEP_GOING drops the item and runs the rest", "see the item's other reports"))
                    next
                }
                if !checked_item.complete {
                    result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    if !jet_driver_has_errors(diagnostics) {
                        result.internal_problem = Val("comptime item checking did not return a complete typed value or dependency wait set")
                    }
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return result
                }
                comptime_request :: checked_item.request ?? {
                    &diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "a complete comptime item check returned no typed evaluation request", "each staged value is evaluated only from its complete checked TIR expression", "retain the canonical Sema comptime request"))
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                // A comptime input that is the item's whole value (`TEXT :: prep {
                // embed_file("x") }`) is read here, as Rust's
                // `try_eval_build_time_io` did, with no evaluation.
                if jet_driver_comptime_input_expression(comptime_request.expression) {
                    if jet_driver_comptime_read_input(request, source.source_file, comptime_request.expression) == {
                        .Ok(value) -> {
                            if batch.entries.len() > 0 {
                                no_functions := [TFunc]{}
                                jet_driver_comptime_batch_add(&batch, source, comptime_request, &no_functions, Val(value))
                                next
                            }
                            &values.push(jet_driver_comptime_item_value(source, value, comptime_request.expression.ty))
                            made_progress = true
                            next
                        }
                        .Err(error) -> {
                            &diagnostics.push(jet_driver_attach_program_source_location(error.diagnostic, programs[0], source.module_identity))
                            if keep_going -> next
                            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                        }
                    }
                }
                if source.kind != SemaComptimeItemKind.CheckedText && comptime_request.calls.len() == 0 {
                    if jet_driver_comptime_fold(comptime_request.expression, values) == .Val(plain) {
                        // Behind a batch, the literal's value lands in its turn.
                        if batch.entries.len() > 0 {
                            no_functions := [TFunc]{}
                            jet_driver_comptime_batch_add(&batch, source, comptime_request, &no_functions, Val(plain))
                            next
                        }
                        &values.push(jet_driver_comptime_item_value(source, plain, comptime_request.expression.ty))
                        made_progress = true
                        next
                    }
                }
                checked_mark := checked_functions.len()
                closure := jet_driver_comptime_function_closure(&environments[0], programs[0], &probe, available, &run_index, &memory_plan, values, &checked_functions, comptime_request, &diagnostics)
                if batch.entries.len() > 0 && jet_driver_comptime_reads_batch(batch.keys, closure.waiting_dependencies, diagnostics.len() > item_diagnostic_start || !closure.complete) {
                    loop diagnostics.len() > item_diagnostic_start {
                        _ := &diagnostics.pop()
                    }
                    jet_driver_comptime_forget_functions(&checked_functions, &run_index, checked_mark)
                    flushed := jet_driver_comptime_flush(names, load, request, batch, &values, checked_functions, &trace, programs[0], &available, &staging, &counters, &diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                    retry = true
                    next
                }
                if keep_going {
                    if jet_driver_has_errors_since(diagnostics, item_diagnostic_start) -> next
                } else if jet_driver_has_errors(diagnostics) {
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                }
                if !closure.complete && closure.waiting_dependencies.len() == 0 && keep_going {
                    &diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], source.module_identity, "E0003", source.span, "keep-going: comptime item `{source.name}` has an incomplete function closure: {closure.incomplete_reasons.join("; ")}", "JET_KEEP_GOING drops the item and runs the rest", "see the closure's other reports"))
                    next
                }
                if !closure.complete && closure.waiting_dependencies.len() == 0 {
                    result := jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    if !jet_driver_has_errors(diagnostics) {
                        problem := "comptime function checking did not return a complete body or dependency wait set"
                        loop reason in closure.incomplete_reasons -> problem = "{problem}\n  {reason}"
                        result.internal_problem = Val(problem)
                    }
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return result
                }
                if closure.waiting_dependencies.len() > 0 {
                    dependencies := [String]{}
                    loop dependency in checked_item.waiting_dependencies -> jet_driver_comptime_wait_add(&dependencies, dependency)
                    loop dependency in closure.waiting_dependencies -> jet_driver_comptime_wait_add(&dependencies, dependency)
                    if checked_item.diagnostics.len() == 0 && diagnostics.len() == item_diagnostic_start {
                        settled_waits[source_key] = dependencies
                    } else {
                        _ := &settled_waits.remove(source_key)
                    }
                    &wait_rows.push(JetDriverComptimeWaitRow{
                        key: source.key,
                        name: source.name,
                        module_identity: source.module_identity,
                        span: source.span,
                        dependencies: dependencies,
                    })
                    &next_pending.push(source)
                    next
                }
                loop call in comptime_request.calls {
                    if call.checked_text == .Val(evaluation) -> jet_driver_comptime_checked_text_source_add(&next_pending, &known_sources, evaluation)
                }
                loop function_index in scanned_functions..<checked_functions.len() {
                    loop call in checked_functions[function_index].calls {
                        if call.checked_text == .Val(evaluation) -> jet_driver_comptime_checked_text_source_add(&next_pending, &known_sources, evaluation)
                    }
                }
                scanned_functions = checked_functions.len()
                shareable :: jet_driver_comptime_shareable(comptime_request, closure.functions, checked_functions, run_index)
                if shareable && jet_driver_comptime_batchable(source) {
                    jet_driver_comptime_batch_add(&batch, source, comptime_request, &closure.functions, None)
                    next
                }
                if batch.entries.len() > 0 {
                    flushed := jet_driver_comptime_flush(names, load, request, batch, &values, checked_functions, &trace, programs[0], &available, &staging, &counters, &diagnostics)
                    batch = jet_driver_comptime_batch_new()
                    if flushed.progressed -> made_progress = true
                    if flushed.stop == .Val(stopped) {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return stopped
                    }
                }
                alone := jet_driver_comptime_batch_new()
                alone.shareable = shareable
                jet_driver_comptime_batch_add(&alone, source, comptime_request, &closure.functions, None)
                flushed := jet_driver_comptime_flush(names, load, request, alone, &values, checked_functions, &trace, programs[0], &available, &staging, &counters, &diagnostics)
                if flushed.progressed -> made_progress = true
                if flushed.stop == .Val(stopped) {
                    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                    return stopped
                }
            }
        }
        if batch.entries.len() > 0 {
            flushed := jet_driver_comptime_flush(names, load, request, batch, &values, checked_functions, &trace, programs[0], &available, &staging, &counters, &diagnostics)
            batch = jet_driver_comptime_batch_new()
            if flushed.progressed -> made_progress = true
            if flushed.stop == .Val(stopped) {
                sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                return stopped
            }
        }
        if next_pending.len() > 0 && !made_progress {
            cycle := jet_driver_comptime_dependency_cycle(wait_rows)
            if {
                cycle != None -> {
                    cycle_row :: cycle ?? {
                        sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
                        return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
                    }
                    cycle_diagnostic := sema_comptime_dependency_cycle_diagnostic(cycle_row.name, cycle_row.span)
                    &diagnostics.push(jet_driver_attach_program_source_location(cycle_diagnostic, programs[0], cycle_row.module_identity))
                }
                wait_rows.len() > 0 -> {
                    stalled := wait_rows[0]
                    &diagnostics.push(jet_driver_diagnostic_at_program_site(programs[0], stalled.module_identity, "E0003", stalled.span, "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
                else -> {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the staged comptime dependency graph is stalled without a proven cycle", "only an actual cycle among unresolved canonical dependencies is reported as a cycle", "preserve the dependency owner or complete the missing staged value"))
                }
            }
            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
            return jet_driver_comptime_run_result(values, checked_functions, trace, false, false)
        }
        pending = next_pending
    }
    // Values that landed in the last pass join the program's graph, which
    // its owning run hands back with the result.
    if values.len() > resolved_count {
        if !jet_driver_comptime_apply_landed(&environments[0], &programs[0], &available, staging.sites, values, resolved_count, &trail) {
            sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
            return jet_driver_comptime_lost_graph(values, checked_functions, trace)
        }
    }
    finished := jet_driver_comptime_run_result(values, checked_functions, trace, true, false)
    sema_comptime_body_work_flush(environments[0].comptime_body_publication, request.trace_sink, "sema.comptime")
    finished.graph_finished = true
    finished
}

// G (closure-scoped staging): what a checked comptime item's TIR reaches
// beyond itself. `functions` are the keys of the functions it calls;
// `everything` is set once it names any other declaration (a constant, a
// nominal type, a trait, a field owner, a foreign row, ...) or holds a form
// this walk does not follow, so an unknown form never counts as reaching
// nothing. The forms followed read no module declaration while they lower:
// primitive types lower without module lookups (jet_codegen_qualify_type,
// jet_codegen_type_instance_id), and literals, plain local reads, unary and
// binary operations (prelude or primitive dispatch; the fact-enum fold reads
// modules only for constant and enum operands), comparison chains without
// hooks, Display interpolation, inline blocks and plain lets lower without
// one. So an item that reaches nothing lowers on the bare session exactly as
// on the staged session of every module.
struct JetDriverComptimeReach {
    everything: Bool
    functions: [String]
}

fn jet_driver_comptime_reach_type(reach: &JetDriverComptimeReach, ty: Type) Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) -> {}
        else -> reach.everything = true
    }
}

fn jet_driver_comptime_reach_local(reach: &JetDriverComptimeReach, local: TLocal) Never! {
    if local.deref || local.address_lifetime != None || local.persist_key != None || local.string_bytes_source != None || local.uninit_scalar || local.uninit_fixed -> reach.everything = true
}

fn jet_driver_comptime_reach_expr(reach: &JetDriverComptimeReach, expression: TExpr) Never! {
    if reach.everything -> return
    jet_driver_comptime_reach_type(&reach, expression.ty)
    if expression.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) -> {}
        .StrLit(parts) -> {
            loop part in parts {
                if part == {
                    .Interpolation(value, format) -> {
                        if format == {
                            .Display -> {}
                            else -> reach.everything = true
                        }
                        jet_driver_comptime_reach_expr(&reach, value)
                    }
                    else -> {}
                }
            }
        }
        .Local(local) -> jet_driver_comptime_reach_local(&reach, local)
        .Unary(_, operand) -> jet_driver_comptime_reach_expr(&reach, operand)
        .Binary(_, _, _, lhs, rhs) -> {
            jet_driver_comptime_reach_expr(&reach, lhs)
            jet_driver_comptime_reach_expr(&reach, rhs)
        }
        .CompareChain(operands, _, hooks) -> {
            loop hook in hooks {
                if hook -> reach.everything = true
            }
            loop operand in operands -> jet_driver_comptime_reach_expr(&reach, operand)
        }
        .InlineBlock(body) -> {
            loop statement in body -> jet_driver_comptime_reach_stmt(&reach, statement)
        }
        else -> reach.everything = true
    }
}

fn jet_driver_comptime_reach_stmt(reach: &JetDriverComptimeReach, statement: TStmt) Never! {
    if reach.everything -> return
    if statement == {
        .Let(local, let_ty, init, gc_promotion, gc_transferred, _) -> {
            if let_ty == {
                .Inferred -> {}
                else -> reach.everything = true
            }
            if gc_promotion != None || gc_transferred -> reach.everything = true
            jet_driver_comptime_reach_local(&reach, local)
            jet_driver_comptime_reach_expr(&reach, init)
        }
        .ExprStmt(value, _) -> jet_driver_comptime_reach_expr(&reach, value)
        else -> reach.everything = true
    }
}

// G: whether an evaluated entry may lower on the bare session: it names no
// staged constant, its checked closure is empty and its TIR (and expected
// type) reaches nothing.
fn jet_driver_comptime_entry_bare(request: SemaComptimeItemRequest, function_keys: [String]) -> Bool Never! {
    if request.dependencies.len() > 0 || function_keys.len() > 0 -> return false
    reach := JetDriverComptimeReach{everything: false, functions: [String]{}}
    if request.expected_type == .Val(expected) -> jet_driver_comptime_reach_type(&reach, expected)
    jet_driver_comptime_reach_expr(&reach, request.expression)
    !reach.everything && reach.functions.len() == 0
}

// G: whether a run may stage bare: the declaration pass's modules of every
// registered module are at hand and none carries foreign rows (a bare program
// has none, and its assembly reads only the module count and foreign rows).
fn jet_driver_comptime_bare_ok(graph: SemaRegistrationGraph, declared: [SemaGraphModuleResult]) -> Bool Never! {
    if declared.len() == 0 || declared.len() != graph.modules.len() -> return false
    loop index in 0..<declared.len() {
        if declared[index].foreign_functions.len() > 0 || declared[index].foreign_providers.len() > 0 -> return false
    }
    true
}

// G: stages the bare session, over the bare module of every registered module
// (sema_comptime_bare_module), and its runtime modules (every bare module but
// the canonical effect module, as staged runtime modules are): lowering a
// batch that reaches nothing reads no declaration, so its program carries
// only its item functions, never a row of every module.
fn jet_driver_comptime_stage_bare(graph: SemaRegistrationGraph, load: JetDriverLoadResult, stop_points: Bool, staging: &JetDriverComptimeStaging) Never! {
    modules := [SemaGraphModuleResult]{}
    loop index in 0..<graph.modules.len() {
        bare := sema_comptime_bare_module(graph.modules[index])
        if bare.module_identity != graph.canonical_effect_module_identity -> &staging.runtime_modules.push(bare)
        &modules.push(^bare)
    }
    staging.session = Val(jet_codegen_comptime_session(^modules, load.source_files, stop_points, jet_driver_resolved_package_edition(load)))
    staging.bare = true
}

// G: drops the bare session, its runtime modules and foreign rows, and the
// live program built on it, so the next staging builds the staged session of
// every module as the run's first (jet_driver_comptime_stage). A later batch
// builds its own program: by A2c's argument its values are those the bare
// live program would give.
fn jet_driver_comptime_unstage_bare(staging: &JetDriverComptimeStaging) Never! {
    staging.session = None
    staging.runtime_modules = [SemaGraphModuleResult]{}
    staging.foreign = None
    staging.live = [JetDriverComptimeLive]{}
    staging.growth_constants = [MIRConstantDef]{}
    staging.restore = false
    staging.bare = false
}

// Rust `plain_literal_value` (Registration/Items.rs) lands a constant whose
// checked initializer is a plain literal as its own value, unevaluated
// (#3661: evaluating one lowered, assembled and ran a MIR fragment holding
// every module's declarations). Rust evaluates every other initializer with
// its interpreter; Jet's comptime is native only, and a host with no
// execution child (the bootstrap factory, the native CLI) evaluates nothing.
// So every value that is literal data folds here: Int, sized-integer
// (`I64{208}`, `U8{7}`), Float, Bool, Char and string literals, their
// negation, the checked Int-to-fixed conversion of a literal, lists, struct
// literals (sema has already filled each omitted field's default), enum
// constructors with positional or named payloads, `Val(x)` and `None`,
// constants that already landed, and integer, Float and Bool arithmetic and
// comparison over them. Rust's MIREval reads the same checked facts: a
// `T.$layout` read is the LayoutInfo sema computed for the selected target
// (a CtLit) and `.size` its field; `x ?? panic(..)` on a present value is
// that value; a value `if`/else-if chain takes the arm its folded condition
// selects; shifts stay within the checked width. Aggregates take the shape
// the native value boundary lands (`jet_driver_native_value`): the declared
// type name, field and named payload labels. A value outside its checked
// type, a selected arm that stops (`panic`), a division or power, a call,
// and any other shape is not folded: it is evaluated, and the evaluator
// reports it.
fn jet_driver_comptime_fold(expression: TExpr, values: [SemaComptimeItemValue]) -> TComptimeValue? Never! {
    if expression.kind == {
        .IntLit(value, _) -> return jet_driver_comptime_fold_int(value, expression.ty)
        .FloatLit(value) -> {
            if expression.ty == Type.Float -> return Val(TComptimeValue.Float{value: value, bits: 64})
        }
        .BoolLit(value) -> return Val(TComptimeValue.Bool{value: value})
        .CharLit(value) -> return Val(TComptimeValue.Char{value: value})
        .StrLit(parts) -> {
            if expression.ty != Type.String -> return None
            if parts.len() == 0 -> return Val(TComptimeValue.String{value: ""})
            if parts.len() == 1 {
                if parts[0] == .Literal(text) -> return Val(TComptimeValue.String{value: text})
            }
        }
        // A checked literal that already carries its value (an
        // integer outside the i64 range is a BigInt constant; a `$` fact read
        // is its reflection record).
        .CtLit(value) -> {
            if jet_driver_comptime_data(value) -> return Val(value)
        }
        .Field(receiver, field) -> {
            folded :: jet_driver_comptime_fold(receiver, values) ?? return None
            if folded == .Struct(_, fields) {
                loop member in fields {
                    if member.name == field.name -> return Val(member.value)
                }
            }
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            if then_body.len() != 0 || else_body.len() != 0 -> return None
            selected :: jet_driver_comptime_fold_condition(cond, values) ?? return None
            return jet_driver_comptime_fold(if selected -> then_value else -> else_value, values)
        }
        .ConstRef(symbol) -> return jet_driver_comptime_landed(values, symbol.key)
        // Copying a constant's value is that value.
        .Clone(value, _) | .ExplicitCopy(value) -> return jet_driver_comptime_fold(value, values)
        .StructLit(fields) -> {
            type_name :: jet_driver_comptime_type_name(expression.ty) ?? return None
            folded := [TComptimeField]{}
            loop field in fields -> &folded.push(TComptimeField{name: field.field.name, value: jet_driver_comptime_fold(field.value, values) ?? return None})
            return Val(TComptimeValue.Struct{type_name: type_name, fields: folded})
        }
        .EnumCtor(_, variant, payload) -> {
            type_name :: jet_driver_comptime_type_name(expression.ty) ?? return None
            parts :: variant.key.split(":").to_list()
            return jet_driver_comptime_fold_enum(type_name, parts[parts.len() - 1], payload, values)
        }
        .EnumLit(enum_type, variant, payload) -> return jet_driver_comptime_fold_enum(jet_driver_comptime_leaf_name(enum_type), variant, payload, values)
        .Present(value) -> {
            if expression.ty == .Option(_) -> return Val(TComptimeValue.Present{value: jet_driver_comptime_fold(value, values) ?? return None})
        }
        .Absent -> {
            // copy: `inner` is a payload of read parameter `expression`, which keeps the original; field `ty` of the new TComptimeReport.Clean owns this one
            if expression.ty == .Option(inner) -> return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: inner.copy()}})
        }
        // `x ?? fallback`: a present value is itself, an absent one takes a
        // folded value fallback. `String.from_bytes([U8]{…})` is the
        // generators' spelling of a string holding a control character (no
        // escape spells NUL): present when the folded bytes are UTF-8.
        .OrFallback(value, fallback, _) -> {
            subject :: jet_driver_comptime_fold(value, values) ?? jet_driver_comptime_fold_from_bytes(value, values) ?? return None
            if subject == .Present(inner) -> return Val(inner)
            if subject == .Failed(_) {
                if fallback == .Value(otherwise) -> return jet_driver_comptime_fold(otherwise, values)
            }
        }
        .Unary(op, operand) -> {
            folded :: jet_driver_comptime_fold(operand, values) ?? return None
            if op == TUnaryOp.Neg {
                if folded == .Int(number) -> return jet_driver_comptime_fold_int(0 - number, expression.ty)
                // `-170141…728` checks as the negation of a BigInt literal.
                if folded == .BigInt(decimal) -> return jet_driver_comptime_fold_int(0 - (Int.parse(decimal) ?? return None), expression.ty)
                if folded == .Float(number, bits) {
                    if bits == 64 && expression.ty == Type.Float -> return Val(TComptimeValue.Float{value: number * -1.0, bits: 64})
                }
            }
            if op == TUnaryOp.Not && expression.ty == Type.Bool {
                if folded == .Bool(flag) -> return Val(TComptimeValue.Bool{value: !flag})
            }
        }
        // `I64{n}` checked without its head: the checked Int-to-fixed
        // conversion of a literal, which traps exactly when n is outside.
        .NumericMethod(receiver, operation) -> {
            if operation == .CheckedIntToFixed(_, _) {
                folded :: jet_driver_comptime_fold(receiver, values) ?? return None
                if folded == .Int(number) -> return jet_driver_comptime_fold_int(number, expression.ty)
                if folded == .BigInt(decimal) -> return jet_driver_comptime_fold_int(Int.parse(decimal) ?? return None, expression.ty)
            }
        }
        .Binary(op, _, _, lhs, rhs) -> {
            left :: jet_driver_comptime_fold(lhs, values) ?? return None
            right :: jet_driver_comptime_fold(rhs, values) ?? return None
            return jet_driver_comptime_fold_binary(op, expression.ty, left, right)
        }
        .List(elements, coercion) -> {
            if coercion == None -> return jet_driver_comptime_fold_list(elements, values)
        }
        .ListLit(elements) -> return jet_driver_comptime_fold_list(elements, values)
        // An unsuffixed decimal literal checks as `Decimal.from_str("…")`
        // (sema_expr_decimal_literal); its value is the Core Decimal record.
        .PreciseBuiltin(type_name, function, args) -> {
            if type_name == "Decimal" && function == "from_str" && args.len() == 1 {
                folded :: jet_driver_comptime_fold(args[0], values) ?? return None
                if folded == .String(text) -> return jet_driver_comptime_decimal(text)
            }
        }
        else -> {}
    }
    None
}

// Core math.jet `__decimal_from_str` over a literal spelling: the record
// {negative, magnitude, scale} it returns (magnitude unnormalized), or None
// when it would stop on the text or the exponent is out of reach.
fn jet_driver_comptime_decimal(text: String) -> TComptimeValue? Never! {
    bytes :: text.trim().bytes()
    if bytes.len() == 0 -> return None
    index := 0
    negative := false
    if Int.from_u8(bytes[0]) == 45 || Int.from_u8(bytes[0]) == 43 {
        negative = Int.from_u8(bytes[0]) == 45
        index = 1
    }
    magnitude := 0
    digits := 0
    fractional := 0
    point := false
    loop index < bytes.len() && Int.from_u8(bytes[index]) != 101 && Int.from_u8(bytes[index]) != 69 {
        code :: Int.from_u8(bytes[index])
        if code == 46 {
            if point -> return None
            point = true
        } else {
            if code < 48 || code > 57 -> return None
            digits += 1
            if digits > 4000 -> return None
            magnitude = magnitude * 10 + code - 48
            if point -> fractional += 1
        }
        index += 1
    }
    if digits == 0 -> return None
    exponent := 0
    if index < bytes.len() {
        index += 1
        exponent_negative := false
        if index < bytes.len() && (Int.from_u8(bytes[index]) == 45 || Int.from_u8(bytes[index]) == 43) {
            exponent_negative = Int.from_u8(bytes[index]) == 45
            index += 1
        }
        start :: index
        loop index < bytes.len() {
            code :: Int.from_u8(bytes[index])
            if code < 48 || code > 57 -> return None
            exponent = exponent * 10 + code - 48
            if exponent > 4000 -> return None
            index += 1
        }
        if index == start -> return None
        if exponent_negative -> exponent = 0 - exponent
    }
    places := fractional - exponent
    loop places < 0 {
        magnitude = magnitude * 10
        places += 1
    }
    magnitude_value :: if jet_driver_comptime_small_int(magnitude) -> TComptimeValue.Int{value: magnitude} else -> TComptimeValue.BigInt{decimal: "{magnitude}"}
    Val(TComptimeValue.Struct{type_name: "Decimal", fields: [TComptimeField]{
        TComptimeField{name: "negative", value: TComptimeValue.Bool{value: negative && magnitude != 0}},
        TComptimeField{name: "magnitude", value: magnitude_value},
        TComptimeField{name: "scale", value: TComptimeValue.Int{value: places}},
    }})
}

// A landed value is data: no closure anywhere in it.
fn jet_driver_comptime_data(value: TComptimeValue) -> Bool Never! {
    if value == {
        .Closure(_) -> return false
        .List(items) -> loop item in items {
            if !jet_driver_comptime_data(item) -> return false
        }
        .Map(entries) -> loop entry in entries {
            if !jet_driver_comptime_data(entry.value) -> return false
        }
        .Struct(_, fields) -> loop field in fields {
            if !jet_driver_comptime_data(field.value) -> return false
        }
        .Enum(_, _, args) -> loop argument in args {
            if !jet_driver_comptime_data(argument.value) -> return false
        }
        .Present(inner) -> return jet_driver_comptime_data(inner)
        .Failed(report) -> {
            if report == .Told(inner) -> return jet_driver_comptime_data(inner)
        }
        else -> {}
    }
    true
}

// A value `if` condition: a folded Bool, or both halves of `&&`-joined ones.
fn jet_driver_comptime_fold_condition(cond: TIfCond, values: [SemaComptimeItemValue]) -> Bool? Never! {
    if cond == {
        .Plain(value) -> {
            folded :: jet_driver_comptime_fold(value, values) ?? return None
            if folded == .Bool(flag) -> return Val(flag)
            None
        }
        .And(left, right) -> {
            if !(jet_driver_comptime_fold_condition(left, values) ?? return None) -> return Val(false)
            jet_driver_comptime_fold_condition(right, values)
        }
        else -> None
    }
}

// `String.from_bytes(<folded [U8]>)` as its Result: the decoded text, or a
// clean failure when the bytes are not UTF-8.
fn jet_driver_comptime_fold_from_bytes(value: TExpr, values: [SemaComptimeItemValue]) -> TComptimeValue? Never! {
    if value.kind == .BuiltinMethod(receiver, operation, args) {
        if operation != TBuiltinOp.StringFromBytes || args.len() != 0 -> return None
        folded :: jet_driver_comptime_fold(receiver, values) ?? return None
        bytes := [U8]{}
        if folded == {
            // A checked `[U8]{"…"}` byte value folds to its bytes.
            // copy: `values_bytes` is a payload of `folded`, which keeps the original
            .Bytes(values_bytes) -> bytes = values_bytes.copy()
            .List(items) -> loop item in items {
                if item == .Int(number) -> &bytes.push(U8.from_int(number) ?? return None)
                else -> return None
            }
            else -> return None
        }
        decoded :: String.from_bytes(bytes) ?? return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "UTF8Error"}}})
        return Val(TComptimeValue.Present{value: TComptimeValue.String{value: decoded}})
    }
    None
}

fn jet_driver_comptime_fold_list(elements: [TExpr], values: [SemaComptimeItemValue]) -> TComptimeValue? Never! {
    folded := [TComptimeValue]{}
    loop element in elements -> &folded.push(jet_driver_comptime_fold(element, values) ?? return None)
    Val(TComptimeValue.List{values: folded})
}

fn jet_driver_comptime_fold_enum(type_name: String, variant: String, payload: TEnumPayload, values: [SemaComptimeItemValue]) -> TComptimeValue? Never! {
    args := [TComptimeEnumArg]{}
    if payload == {
        .Unit -> {}
        .Positional(positional) -> loop argument in positional -> &args.push(TComptimeEnumArg{name: None, value: jet_driver_comptime_fold(argument.value, values) ?? return None})
        .Named(named) -> loop argument in named -> &args.push(TComptimeEnumArg{name: Val(argument.name), value: jet_driver_comptime_fold(argument.value.value, values) ?? return None})
    }
    Val(TComptimeValue.Enum{type_name: type_name, variant: variant, args: args})
}

// The declared (leaf) name of a nominal checked type, the name a landed
// aggregate carries and constant lowering resolves against its type.
fn jet_driver_comptime_type_name(ty: Type) -> String? Never! {
    if ty == {
        .Named(name) -> Val(jet_driver_comptime_leaf_name(name))
        .Apply(name, _) -> Val(jet_driver_comptime_leaf_name(name))
        else -> None
    }
}

fn jet_driver_comptime_leaf_name(name: String) -> String Never! {
    parts :: name.split("::").to_list()
    parts[parts.len() - 1]
}

// The value of a constant that already landed in this run.
fn jet_driver_comptime_landed(values: [SemaComptimeItemValue], key: String) -> TComptimeValue? Never! {
    loop value in values {
        if value.kind == SemaComptimeItemKind.Constant && value.key == key -> return Val(value.value)
    }
    None
}

// An integer value of checked type `ty`: any exact Int, or a fixed width of
// at most 64 bits only when it lies in that type's range.
fn jet_driver_comptime_fold_int(value: Int, ty: Type) -> TComptimeValue? Never! {
    if ty == Type.Int {
        // An exact Int outside the i64 range is a BigInt value.
        if !jet_driver_comptime_small_int(value) -> return Val(TComptimeValue.BigInt{decimal: "{value}"})
        return Val(TComptimeValue.Int{value: value})
    }
    if ty == .IntN(signed, bits) {
        if bits < 8 || bits > 64 -> return None
        low := 0
        high := 18446744073709551615
        if bits < 64 {
            high = (1 << bits) - 1
            if signed {
                low = 0 - (1 << (bits - 1))
                high = (1 << (bits - 1)) - 1
            }
        } else if signed {
            low = -9223372036854775807 - 1
            high = 9223372036854775807
        }
        if value < low || value > high -> return None
        return Val(TComptimeValue.Int{value: value})
    }
    None
}

fn jet_driver_comptime_fold_binary(op: TBinaryOp, ty: Type, left: TComptimeValue, right: TComptimeValue) -> TComptimeValue? Never! {
    if left == .Int(a) {
        if right == .Int(b) {
            if ty == Type.Bool {
                if op == {
                    .Eq -> return Val(TComptimeValue.Bool{value: a == b})
                    .Ne -> return Val(TComptimeValue.Bool{value: a != b})
                    .Lt -> return Val(TComptimeValue.Bool{value: a < b})
                    .Gt -> return Val(TComptimeValue.Bool{value: a > b})
                    .Le -> return Val(TComptimeValue.Bool{value: a <= b})
                    .Ge -> return Val(TComptimeValue.Bool{value: a >= b})
                    else -> return None
                }
            }
            if op == {
                .Add -> return jet_driver_comptime_fold_int(a + b, ty)
                .Sub -> return jet_driver_comptime_fold_int(a - b, ty)
                .Mul -> return jet_driver_comptime_fold_int(a * b, ty)
                .BitAnd -> return jet_driver_comptime_fold_int(a.bit_and(b), ty)
                .BitOr -> return jet_driver_comptime_fold_int(a.bit_or(b), ty)
                .BitXor -> return jet_driver_comptime_fold_int(a.bit_xor(b), ty)
                // A non-negative value shifted by less than its width; the
                // result must still fit the checked type.
                .Shl -> {
                    if a < 0 || b < 0 || b > 63 -> return None
                    return jet_driver_comptime_fold_int(a * (1 << b), ty)
                }
                .Shr -> {
                    if a < 0 || b < 0 || b > 63 -> return None
                    return jet_driver_comptime_fold_int(a /% (1 << b), ty)
                }
                else -> return None
            }
        }
        return None
    }
    if left == .Float(a, left_bits) {
        if right == .Float(b, right_bits) {
            if left_bits != 64 || right_bits != 64 -> return None
            if ty == Type.Bool {
                if op == {
                    .Eq -> return Val(TComptimeValue.Bool{value: a == b})
                    .Ne -> return Val(TComptimeValue.Bool{value: a != b})
                    .Lt -> return Val(TComptimeValue.Bool{value: a < b})
                    .Gt -> return Val(TComptimeValue.Bool{value: a > b})
                    .Le -> return Val(TComptimeValue.Bool{value: a <= b})
                    .Ge -> return Val(TComptimeValue.Bool{value: a >= b})
                    else -> return None
                }
            }
            if ty != Type.Float -> return None
            if op == {
                .Add -> return Val(TComptimeValue.Float{value: a + b, bits: 64})
                .Sub -> return Val(TComptimeValue.Float{value: a - b, bits: 64})
                .Mul -> return Val(TComptimeValue.Float{value: a * b, bits: 64})
                else -> return None
            }
        }
        return None
    }
    if left == .Bool(a) {
        if right == .Bool(b) {
            if ty != Type.Bool -> return None
            if op == {
                .And -> return Val(TComptimeValue.Bool{value: a && b})
                .Or -> return Val(TComptimeValue.Bool{value: a || b})
                .Eq -> return Val(TComptimeValue.Bool{value: a == b})
                .Ne -> return Val(TComptimeValue.Bool{value: a != b})
                else -> return None
            }
        }
    }
    None
}

fn jet_driver_comptime_small_int(value: Int) -> Bool Never! {
    value >= -9223372036854775807 - 1 && value <= 9223372036854775807
}

fn jet_driver_foreign_provider_owners_valid(
    modules: [JetDriverLoadedModule],
    providers: [SemaForeignProviderInput],
    diagnostics: &[Diagnostic],
) -> Bool {
    valid := true
    provider_index := 0
    loop provider_index < providers.len() {
        provider := providers[provider_index]
        module_matches := 0
        loop candidate_module in modules {
            if candidate_module.module_identity == provider.module_identity -> module_matches += 1
        }
        duplicate_identity := false
        prior_index := 0
        loop prior_index < provider_index {
            if providers[prior_index].module_identity == provider.module_identity {
                duplicate_identity = true
                break
            }
            prior_index += 1
        }
        if module_matches != 1 || duplicate_identity {
            &diagnostics.push(jet_driver_diagnostic_without_span(
                "E0003",
                "a foreign provider does not resolve to one exact loaded module identity",
                "provider handles are registered only on the synthetic module selected by their exact module_identity",
                "retain one provider row for the exact loaded synthetic module identity",
            ))
            valid = false
        }
        provider_index += 1
    }
    valid
}

fn jet_driver_registration_foreign_handle_facts(
    module_identity: String,
    providers: [SemaForeignProviderInput],
    diagnostics: &[Diagnostic],
) -> [SemaRegistrationForeignHandleFacts]? {
    selected_index := Int?{None}
    index := 0
    loop index < providers.len() {
        if providers[index].module_identity == module_identity {
            if selected_index != None {
                &diagnostics.push(jet_driver_diagnostic_without_span(
                    "E0003",
                    "more than one foreign provider has the exact module identity selected for registration",
                    "opaque handle facts belong to one exact synthetic provider module",
                    "retain one provider input for the loaded module identity",
                ))
                return None
            }
            selected_index = Val(index)
        }
        index += 1
    }
    provider_index :: selected_index ?? return Val([SemaRegistrationForeignHandleFacts]{})
    provider := providers[provider_index]
    facts := [SemaRegistrationForeignHandleFacts]{}
    loop handle in provider.handles {
        &facts.push(SemaRegistrationForeignHandleFacts{
            library: handle.library,
            typedef_name: handle.typedef_name,
            jet_name: handle.jet_name,
            ownership: "Owned",
            close: handle.close,
            close_source: handle.close_source,
            thread_safety: handle.thread_safety,
            send: handle.thread_safety == "safe",
            sync: handle.thread_safety == "safe",
            close_function_key: handle.close_function_key,
            source_span: provider.source_span,
        })
    }
    Val(facts)
}
fn jet_driver_canonical_effect_segments(path: String, source: String) -> [SemaSourceSegment] Never! {
    bytes := source.bytes()
    line_starts := [Int]{0}
    index := 0
    loop index < bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
        index += 1
    }
    [SemaSourceSegment{
        generated: Span{start: 0, end: bytes.len()},
        source_file: path,
        source_start: 0,
        line_starts: line_starts,
        origin: SemaSourceOrigin.CompilerGenerated,
    }]
}

fn jet_driver_canonical_effect_module(source: String) -> SemaRegistrationModuleInput? {
    if source.len() == 0 -> return None
    parsed := parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> return None
    declaration_count := 0
    unexpected_item := false
    loop item in parsed.program.items {
        if item == {
            .EffectDecl(_) -> declaration_count += 1
            else -> unexpected_item = true
        }
    }
    if unexpected_item || declaration_count == 0 -> return None
    source_file := "jet:canonical-prelude/Prelude/Effects.jet"
    package_identity := JET_CANONICAL_EFFECT_PACKAGE_IDENTITY
    module_path := JET_CANONICAL_EFFECT_MODULE_PATH
    module_identity := jet_driver_module_identity(package_identity, module_path)
    Val(SemaRegistrationModuleInput{
        package_identity: package_identity,
        module_identity: module_identity,
        module_name: "Effects",
        core_source_alias: "",
        module_path: module_path,
        source_file: source_file,
        source_segments: jet_driver_canonical_effect_segments(source_file, source),
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: ^parsed.program,
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
    })
}

// Rust CheckInner `retain_error_prelude_module`: the original Prelude error
// declarations join the load as one compiler-generated source module (source
// unit, source file, loaded row), as Rust pushes its LoadedModule into the
// bundle, so registration, checking, assembly, and every loaded-identity check
// see one module set. Like Core, foreign aggregate, and canonical effect
// sources, its bytes also ride the generated sidecar, so a diagnostic sited in
// it projects through the host codec. A loaded source holding its path, alias,
// or identity is refused.
fn jet_driver_retain_error_prelude_module(load: &JetDriverLoadResult) -> Bool {
    original := sema_registration_original_error_module(&load.diagnostics) ?? return false
    module_identity :: jet_driver_module_identity(original.package_identity, original.module_path)
    collides := false
    loop unit in load.source_units {
        if unit.path == original.source_file || unit.module_name == original.module_name || jet_driver_module_identity(unit.package_identity, unit.relative_path) == module_identity -> collides = true
    }
    loop generated in load.generated_source_files {
        if generated.path == original.source_file -> collides = true
    }
    if collides {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "an existing source collides with the original Prelude identity", "default-error declarations retain their original compiler-private source owner", "retain the canonical Prelude source and its parsed declaration provenance"))
        return false
    }
    file_diagnostics :: load.diagnostics.len()
    file :: MIRSourceFile{id: mir_source_file_id(original.source_file), path: original.source_file, source: original.source}
    jet_driver_add_source_file(&load.source_files, file, &load.diagnostics)
    jet_driver_add_source_file(&load.generated_source_files, file, &load.diagnostics)
    if load.diagnostics.len() != file_diagnostics -> return false
    source_unit_index :: load.source_units.len()
    &load.source_units.push(JetDriverSourceUnit{root_index: -1, file_index: -1, root_identity: original.package_identity, package_identity: original.package_identity, module_name: original.module_name, path: original.source_file, relative_path: original.module_path, source_segments: original.source_segments, source_origin: original.source_origin, in_namespace: false})
    &load.modules.push(JetDriverLoadedModule{source_unit_index: source_unit_index, source_identity: jet_driver_source_identity(original.package_identity, original.source_file), package_identity: original.package_identity, module_identity: module_identity, module_name: original.module_name, program: ^original.program})
    true
}

// The retained original Prelude error unit: compiler-generated, outside every
// authorized root, and not a Review source owner.
fn jet_driver_unit_is_error_prelude(unit: JetDriverSourceUnit) -> Bool Never! {
    unit.root_index == -1 && unit.file_index == -1 && unit.path == SEMA_PRELUDE_ERROR_SOURCE_PATH && unit.package_identity == JET_CANONICAL_EFFECT_PACKAGE_IDENTITY && unit.source_origin == SemaSourceOrigin.CompilerGenerated
}

fn jet_driver_compile_internal_result(load: JetDriverLoadResult, trace: JetDriverCompileTrace, message: String) -> JetDriverCompileResult Never! {
    result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    result.internal_problem = Val(message)
    result
}

// Doc failures retain the checked ledger when it exists; early registration
// failures retain only the import edges already proved.
fn jet_driver_doc_failure(result: ^JetDriverCompileResult, mode: JetDriverCompileMode, checked_facts: [MIRStructureFact]?) -> JetDriverCompileResult Never! {
    failed := ^result
    if mode == JetDriverCompileMode.Doc -> failed.structure_facts = checked_facts ?? [MIRStructureFact]{}
    failed
}

// The import-edge structure facts of whichever stage currently holds the
// registration graph (it moves through the passes); only `jet doc` reads
// them, so every other mode skips the walk.
fn jet_driver_doc_graph_facts(mode: JetDriverCompileMode, graph: SemaRegistrationGraph?) -> [MIRStructureFact]? Never! {
    if mode != JetDriverCompileMode.Doc -> return None
    value :: graph ?? return None
    Val(sema_name_structure_facts(value))
}

// An incomplete-graph internal problem that names every incomplete module and
// each recorded cause, so a stop with no diagnostic still says what stopped it.
fn jet_driver_incomplete_graph_problem(summary: String, modules: [SemaGraphModuleResult]) -> String Never! {
    problem := summary
    loop graph_module in modules {
        if graph_module.complete -> next
        if graph_module.incomplete_reasons.len() == 0 {
            problem = "{problem}\n  {graph_module.module_identity}: incomplete (no recorded cause)"
            next
        }
        loop reason in graph_module.incomplete_reasons -> problem = "{problem}\n  {graph_module.module_identity}: {reason}"
    }
    problem
}

// The result for a compile whose own failure escaped every stage: no stage
// produced a load or partial product, so only the internal problem is kept.
fn jet_driver_compile_escaped_failure(message: String) -> JetDriverCompileResult Never! {
    JetDriverCompileResult{
        diagnostics: [Diagnostic]{},
        generated_source_files: [MIRSourceFile]{},
        package_identity: "",
        entry_module_identity: "",
        entry_function: None,
        runtime_artifact: None,
        web_artifact: None,
        web_artifacts: None,
        mir: None,
        emitted_source: None,
        emit_manifest: None,
        comptime_stdout: "",
        comptime_stderr: "",
        soft_stop: false,
        exit_code: None,
        failed_stage: None,
        complete: false,
        internal_problem: Val(message),
    }
}
// Rust Completion's Test boundary admits either a named test block or an
// authenticated selected Check Output.
fn jet_driver_runnable_test_count(graph: SemaRegistrationGraph) -> Int Never! {
    count := 0
    loop module_index in 0..<graph.modules.len() {
        source_module :: graph.modules[module_index]
        loop item in source_module.program.items {
            if item == .Test(test) {
                if test.name != None -> count += 1
            }
            if source_module.module_identity == graph.entry_module_identity && item == .Const(constant) {
                if constant.resolved_output == .Val(output) {
                    if output.selected && output.kind == OutputKind.Check -> count += 1
                }
            }
        }
    }
    count
}

// Checked named tests and selected Check Outputs share the canonical Test
// harness, in declaration order. Coverage remains a separate request route.
// The modules whose tests a test run collects: the entry, plus every member file of the
// entry's package namespace (a package's tests are all of its #Tests).
fn jet_driver_test_modules(load: JetDriverLoadResult) -> [String:Bool] Never! {
    members := [String:Bool]{}
    members[load.entry_module_identity] = true
    namespace := ""
    package := ""
    loop loaded in load.modules {
        if loaded.module_identity == load.entry_module_identity {
            namespace = loaded.namespace.copy()
            package = loaded.package_identity.copy()
        }
    }
    if namespace.len() == 0 -> return members
    loop loaded in load.modules {
        if loaded.namespace == namespace && loaded.package_identity == package -> members[loaded.module_identity] = true
    }
    members
}

fn jet_driver_test_artifacts(package_identity: String, test_modules: [String:Bool], graph: &SemaGraphResult, functions: &[MIRFunction], diagnostics: &[Diagnostic]) -> JetCodegenJobTestArtifacts Never! {
    tests := [TTestFact]{}
    keys := [String]{}
    wanted := [String:Bool]{}
    output_checks := [TOutputCheckFact]{}
    loop module_index in 0..<graph.modules.len() {
        graph_module :: graph.modules[module_index]
        if test_modules.get(graph_module.module_identity) == None -> next
        loop fact in graph_module.tests {
            &tests.push(fact)
            &keys.push(fact.key)
            wanted[fact.key] = true
        }
        loop constant in graph_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind != OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= graph.modules.len() {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    next
                }
                owner :: graph.modules[output.module_id]
                function_key :: symbol_id(SymbolKind.Function, owner.module_identity, "", output.semantic_name).key
                reference := TFunctionRef?{None}
                loop function in owner.functions {
                    if function.key == function_key {
                        // copy: the output-check fact owns its function ref, and the function row
                        // stays in the checked graph (`graph` is borrowed), which emission reads
                        // next.
                        reference = Val(TFunctionRef{key: function.key.copy(), module_identity: function.module_identity.copy(), name: function.name.copy(), span: function.source_span, visibility: function.visibility})
                        break
                    }
                }
                if reference == .None || jet_driver_find_lowered_function_id(functions, function_key) == .None {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output entry has no unique checked MIR function identity", "Check Outputs invoke their registered checked callable", "retain the canonical function key through checking and MIR lowering"))
                    next
                }
                function_ref :: ^reference ?? next
                &output_checks.push(TOutputCheckFact{
                    key: "{graph_module.module_identity}::output-check::{output.output_name}@{output.definition.start}..{output.definition.end}",
                    // copy: the output-check fact owns its name, while `output` is a payload view
                    // of the constant's resolved output in the checked graph, which keeps it.
                    name: output.output_name.copy(),
                    function: ^function_ref,
                })
                wanted[function_key] = true
            }
        }
    }
    test_functions := [TFunc]{}
    loop module_index in 0..<graph.modules.len() {
        graph_module :: graph.modules[module_index]
        loop function in graph_module.functions {
            if wanted.get(function.key) != None -> &test_functions.push(function)
        }
    }
    checked := [MIRFunction]{}
    loop function in functions {
        if wanted.get(function.key) != None -> &checked.push(function)
    }
    harness :: THarnessPlanFact{
        key: "{package_identity}::harness::Test",
        kind: THarnessKind.Test,
        tests: keys,
        output_checks: ^output_checks,
        selected_test: None,
        coverage_points: [TCoveragePointFact]{},
        command_override: false,
    }
    jet_codegen_lower_job_test_artifacts([TJobFact]{}, tests, [THarnessPlanFact]{harness}, test_functions, checked)
}

// The native Test harness plan over the checked functions `functions`: the
// named tests of `test_modules` whose bodies checked, and their selected Check
// Outputs, in declaration order (the same rows jet_driver_test_artifacts
// reads). A Check Output whose callable did not check is an E0003.
fn jet_driver_test_plan(test_modules: [String:Bool], graph: SemaGraphResult, functions: [TFunc], tests: &[TTestFact], output_checks: &[TOutputCheckFact], diagnostics: &[Diagnostic]) Never! {
    checked := [String:Int]{}
    loop (index, function) in functions -> checked[function.key] = index
    loop module_index in 0..<graph.modules.len() {
        graph_module :: graph.modules[module_index]
        if test_modules.get(graph_module.module_identity) == None -> next
        loop fact in graph_module.tests {
            if checked.get(fact.function.key) != None -> &tests.push(fact)
        }
        loop constant in graph_module.constants {
            if constant.declaration.resolved_output == .Val(output) {
                if !output.selected || output.kind != OutputKind.Check -> next
                if output.module_id < 0 || output.module_id >= graph.modules.len() {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output has no exact checked-module owner", "Output registration retains its authenticated module cursor", "retain the original Output module identity through checking"))
                    next
                }
                owner :: graph.modules[output.module_id]
                function_key :: symbol_id(SymbolKind.Function, owner.module_identity, "", output.semantic_name).key
                row :: checked.get(function_key) ?? {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the selected Check Output entry has no unique checked function identity", "Check Outputs invoke their registered checked callable", "retain the canonical function key through checking"))
                    next
                }
                function :: functions[row]
                &output_checks.push(TOutputCheckFact{
                    key: "{graph_module.module_identity}::output-check::{output.output_name}@{output.definition.start}..{output.definition.end}",
                    // copy: the fact owns its name and function ref; `output`
                    // and `function` are views of rows the compile keeps.
                    name: output.output_name.copy(),
                    function: TFunctionRef{key: function.key.copy(), module_identity: function.module_identity.copy(), name: function.name.copy(), span: function.source_span, visibility: function.visibility},
                })
            }
        }
    }
}

// One `#Export(c)` function of the entry module: its symbol key and name.
struct JetDriverCExportRow {
    key: String
    name: String
}

// The entry module's `#Export(c)` functions in declaration order, read from
// the registration graph before MIR lowering so the graph need not stay
// alive through lowering and assembly (jet_driver_c_exports).
fn jet_driver_c_export_rows(graph: SemaRegistrationGraph, entry_module_identity: String) -> [JetDriverCExportRow] Never! {
    rows := [JetDriverCExportRow]{}
    loop registration_module in graph.modules {
        if registration_module.module_identity != entry_module_identity -> next
        loop row in registration_module.functions {
            exported := false
            loop marker in row.declaration.markers {
                if sema_marker_is_guest_export(marker) -> exported = true
            }
            if exported -> &rows.push(JetDriverCExportRow{key: row.symbol.id.key, name: row.declaration.name})
        }
    }
    rows
}

// U3: the entry module's `#Export(c)` functions in
// declaration order (jet_driver_c_export_rows), each a checked MIR function
// under the C export law (Rust `artifact_plan::lower_exports` over
// `Sema::guest_export_surface`).
fn jet_driver_c_exports(rows: [JetDriverCExportRow], functions: [MIRFunction]) -> [MIRExport] Never! {
    exports := [MIRExport]{}
    loop row in rows {
        loop function in functions {
            if function.key != row.key -> next
            if mir_c_export_signature(function) -> &exports.push(MIRExport{symbol: jet_driver_c_symbol(row.name), function: function.id, abi: .C})
            break
        }
    }
    exports
}

// The Rust foreign facts of the registration graph a compile kept past MIR
// lowering; a compile that released it had no `extern rust` function, whose
// facts are empty (jet_driver_rust_foreign_present).
fn jet_driver_late_rust_foreign_facts(graph: SemaRegistrationGraph?) -> JetDriverRustForeignFacts Never! {
    if graph == .Val(registration) -> return jet_driver_rust_foreign_facts(registration)
    jet_driver_rust_foreign_empty()
}

// The Sandbox export surface over the registration graph a Sandbox compile
// keeps past MIR lowering (read through a parameter, so the binding borrows).
fn jet_driver_late_sandbox_exports(graph: SemaRegistrationGraph?, program: MIRProgram, codable_keys: [String], diagnostics: &[Diagnostic]) -> [MIRExport] {
    registration :: graph ?? panic("a Sandbox compile released its registration graph before its export surface")
    jet_driver_sandbox_exports(registration, program, codable_keys, &diagnostics)
}

fn jet_driver_late_sandbox_snapshot(graph: SemaRegistrationGraph?, export_name: String, symbols: [String]) -> SemaPluginFrozenSnapshotInput {
    registration :: graph ?? panic("a Sandbox compile released its registration graph before its interface snapshot")
    sema_sandbox_interface_snapshot(registration, export_name, symbols)
}

// The record types the Component boundary may carry: checked declarations
// that derive both Encode and Decode (`#Codable` derives both).
fn jet_driver_codable_keys(checked: SemaGraphResult) -> [String] Never! {
    keys := [String]{}
    loop module_row in checked.modules {
        loop definition in module_row.declarations.type_defs {
            codable := false
            encode := false
            decode := false
            loop name in definition.derives {
                if name == "Codable" -> codable = true
                if name == "Encode" -> encode = true
                if name == "Decode" -> decode = true
            }
            if codable || (encode && decode) -> &keys.push(definition.key)
        }
    }
    keys
}

// A sandbox exports every public top-level function of
// its entry module, each a checked MIR function under the Component export
// law (Rust `artifact_plan::lower_exports` over `Sema::sandbox_export_surface`
// plus `PluginExport::validate_export_surface`). A function outside the law
// is E1260, never a silent skip.
fn jet_driver_sandbox_exports(graph: SemaRegistrationGraph, program: MIRProgram, codable_keys: [String], diagnostics: &[Diagnostic]) -> [MIRExport] Never! {
    exports := [MIRExport]{}
    loop declaration in sema_sandbox_export_functions(graph) {
        key :: symbol_id(SymbolKind.Function, graph.entry_module_identity, "", declaration.name).key
        exported := false
        loop function in program.functions {
            if function.key != key -> next
            if mir_component_export_signature(program.types, codable_keys, function) != None {
                &exports.push(MIRExport{symbol: declaration.name, function: function.id, abi: .C})
                exported = true
            }
            break
        }
        if !exported -> &diagnostics.push(sema_export_unsupported_diagnostic(SemaExportBoundary.Sandbox, declaration.name, declaration.span))
    }
    exports
}

// The sandbox export name without a manifest `export:` override: the
// selected package's name, else the entry file's stem.
fn jet_driver_sandbox_default_export_name(load: JetDriverLoadResult, request: JetDriverCompileRequest) -> String Never! {
    loop package in load.packages {
        if package.identity == load.package_identity && package.name != "" -> return package.name
    }
    segments :: request.authorized_sources.entry_path.split("/").to_list()
    file :: segments[segments.len() - 1]
    stem :: file.split(".").to_list()[0]
    if stem == "" -> "plugin" else -> stem
}

// The one native spelling of an exported C symbol (Rust
// `Sema::Guest::guest_export_native_symbol`).
fn jet_driver_c_symbol(name: String) -> String Never! {
    bytes := [U8]{}
    loop byte in name.bytes() {
        alphanumeric :: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        &bytes.push(if alphanumeric || byte == 95 -> byte else -> 95)
    }
    if bytes.len() == 0 || (bytes[0] >= 48 && bytes[0] <= 57) -> &bytes.insert(0, 95)
    String.from_bytes(bytes) ?? "_"
}

fn jet_driver_artifact_plan(
    program: MIRProgram,
    entry_function: MIRFunctionID?,
    // The Test harness of a `jet test` compile (Rust TestExecutable request):
    // the artifact runs it from the harness-owned `main`, with no entry.
    test_harness: MIRHarnessID?,
    // The checked `#Export(c)` rows; only a NativeLibrary artifact carries them.
    c_exports: [MIRExport],
    // A `Sandbox` compile's checked Component export rows: the artifact is
    // then a SandboxPlugin that carries exactly them and has no entry.
    sandbox_exports: [MIRExport]?,
    facts: MIRPackageFacts,
    target_machine: MIRTargetMachine,
    web_profile: MIRArtifactBuildMode?,
    // The request's profile mode (Rust Driver `mir_artifact_build_mode_for`):
    // a `release` profile selects Release for every non-Web artifact.
    build_mode: MIRArtifactBuildMode,
) -> MIRArtifactPlan? {
    artifact_target :: facts.artifact_target ?? return None
    artifact_target_name := ""
    artifact_kind := MIRArtifactKind.NativeExecutable
    artifact_mode := web_profile ?? build_mode
    is_web := false
    if artifact_target == {
        .RustAOT -> artifact_target_name = "RustAot"
        .Interpreter -> artifact_target_name = "Interpreter"
        .Web -> {
            artifact_target_name = "Web"
            artifact_kind = MIRArtifactKind.WebApplication
            is_web = true
            artifact_mode = web_profile ?? return None
        }
        else -> return None
    }
    module_ids := [MIRModuleID]{}
    loop program_module in program.modules -> &module_ids.push(program_module.id)
    link_ids := [MIRLinkUnitID]{}
    loop link in program.links -> &link_ids.push(link.id)
    job_ids := [MIRJobID]{}
    loop job in program.jobs -> &job_ids.push(job.id)
    entry := MIREntrySpec?{None}
    if {
        sandbox_exports != None -> {
            if is_web -> return None
            artifact_kind = MIRArtifactKind.SandboxPlugin
        }
        entry_function != None -> {
            function_id :: entry_function
            initialize_environment := if is_web -> true else -> artifact_target == MIRArtifactTarget.RustAOT && !target_machine.no_os
            initialize_gc := is_web
            entry_kind := if is_web -> MIREntryKind.App else -> MIREntryKind.Command
            entry = Val(MIREntrySpec{
                kind: entry_kind,
                function: Val(function_id),
                cli: jet_driver_entry_record_cli(program, function_id),
                output: MIREntryOutput.ReturnValue,
                initialize_environment: initialize_environment,
                initialize_gc: initialize_gc,
                serves_until_stopped: false,
                package_version: facts.package_version,
            })
        }
        test_harness != None -> {
            if is_web -> return None
            artifact_kind = MIRArtifactKind.TestExecutable
            artifact_mode = MIRArtifactBuildMode.Test
        }
        is_web -> return None
        // D4: a package with no entry (a `.Library` output) lowers as a
        // library artifact, never as an executable without an entry.
        else -> artifact_kind = MIRArtifactKind.NativeLibrary
    }
    artifact_key := "{program.package_identity}::artifact::{artifact_target_name}"
    Val(MIRArtifactPlan{
        id: MIRArtifactID{value: stable_id("mir-artifact", artifact_key)},
        kind: artifact_kind,
        name: program.package_identity,
        target: artifact_target,
        mode: artifact_mode,
        modules: module_ids,
        links: link_ids,
        jobs: job_ids,
        runtime_parts: facts.runtime_parts,
        exports: if artifact_kind == {
            .NativeLibrary -> c_exports
            .SandboxPlugin -> sandbox_exports ?? [MIRExport]{}
            else -> [MIRExport]{}
        },
        provider_identity: facts.target_dossier.provider_identity,
        closure_identity: facts.target_dossier.closure_identity,
        artifact_identity: "{facts.target_dossier.compiler_identity}:{facts.target_dossier.environment_identity}:{target_machine.triple}",
        entry: entry,
        harness: test_harness,
    })
}

// A `#CLI` record entry (`fn run(args: Args)`) decodes the record's checked CLI
// schema, the same rows MIR lowering attaches to the record's type definition.
fn jet_driver_entry_record_cli(program: MIRProgram, function_id: MIRFunctionID) -> MIRCLIEntry? {
    loop function in program.functions {
        if function.id != function_id || function.params.len() != 1 -> next
        identity :: function.params[0].ty.identity ?? return None
        loop definition in program.types {
            if definition.id == identity -> return definition.cli
        }
    }
    None
}

fn jet_driver_runtime_artifact_id(program: MIRProgram) -> MIRArtifactID? {
    selected := MIRArtifactID?{None}
    loop artifact in program.artifacts {
        if artifact.target != MIRArtifactTarget.Interpreter || artifact.entry == None -> next
        if selected != None -> return None
        selected = Val(artifact.id)
    }
    selected
}

// The Core source modules whose top-level bodies are lowered only when
// reached (Rust `core_source_module_indices`). Compiler-private parts
// (`Core/Text/String.jet`) are listed too: a receiver function there is kept
// only when a kept body's checked `ModuleCall` names it (Rust
// `called_private_part_methods`), never the whole part. Host-only Core
// modules are not listed, so their bodies stay rooted; so is a Core module
// with foreign rows, whose close and undo adapters Codegen resolves by key.
fn jet_driver_prunable_core_modules(load: JetDriverLoadResult, core_sources: [JetDriverCoreSource], modules: [SemaGraphModuleResult]) -> [String] Never! {
    identities := [String]{}
    // Every installed Core body is a library root; no user reachability subset.
    if load.mode == JetDriverLoadMode.CoreLibrary -> return identities
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 || semantic_module.foreign_providers.len() > 0 -> next
        loop module_row in load.modules {
            if module_row.module_identity != semantic_module.module_identity -> next
            unit :: load.source_units[module_row.source_unit_index]
            if jet_driver_unit_is_core(unit) && unit.file_index >= 0 && unit.file_index < core_sources.len() -> &identities.push(semantic_module.module_identity)
        }
    }
    identities
}

// ---- JET_KEEP_GOING: the compiler-internal all-phases diagnostic mode ----
// Every failed unit is recorded and replaced by a typed trap so every later
// phase still runs: sema keeps a failed function as a trap of its declared
// signature (SemaRegistrationGraph.keep_going), comptime drops a failed item,
// the optimizer traps every function the failing legality or lint check
// rejects and runs again, and the emitter keeps every failure and finishes
// the text. Each failure is one TSV row (phase, item, code, message, span),
// returned in keep_going_rows and streamed through the trace sink at every
// phase boundary (jet_driver_keep_going_flush), so a later crash keeps it. The
// output is never shipped: the result keeps every error report, so its
// receipt never passes.
struct JetDriverKeepGoingLog {
    enabled: Bool
    skip: [String]
    rows: [String]
    // Row bodies (all but the phase) already recorded, so a failure seen by
    // two phases is one row.
    seen: [String:Bool]
    // Reports before this index of the stage diagnostics are recorded.
    diagnostic_mark: Int
    // Rows before this index are written to the trace sink.
    streamed: Int
}

// Optimizer reruns after trapping failed functions, per compile.
JET_DRIVER_KEEP_GOING_OPTIMIZER_RETRIES :: 64

fn jet_driver_keep_going_log(options: JetDriverKeepGoing?) -> JetDriverKeepGoingLog Never! {
    log := JetDriverKeepGoingLog{enabled: false, skip: [String]{}, rows: [String]{}, seen: [String:Bool]{}, diagnostic_mark: 0, streamed: 0}
    if options == .Val(value) {
        log.enabled = true
        log.skip = value.skip
    }
    log
}

fn jet_driver_keep_going_field(text: String) -> String {
    text.replace("\t", " ").replace("\n", " | ").replace(String.from_bytes([U8]{U8{13}}) ?? "", "")
}

fn jet_driver_keep_going_row(kg: &JetDriverKeepGoingLog, phase: String, item: String, code: String, message: String, span: String) {
    if !kg.enabled -> return
    body :: "{jet_driver_keep_going_field(item)}\t{jet_driver_keep_going_field(code)}\t{jet_driver_keep_going_field(message)}\t{jet_driver_keep_going_field(span)}"
    if kg.seen.get(body) != None -> return
    kg.seen[body] = true
    &kg.rows.push("{phase}\t{body}")
}

// #4319: the registration graph's lookups during `phase` (`counts` less
// `since`) as counter events `counters.<phase>.<counter>`. The host writes
// each to the trace and, with JET_PHASE_COUNTERS set, as a
// `JET_PHASE_COUNTERS` line for Tools/perf/scaling. The graph counts only
// while a trace is open.
fn jet_driver_trace_lookup_counters(trace_sink: CompilerTraceSink?, phase: String, counts: SemaLookupCounters, since: SemaLookupCounters) {
    if trace_sink == .Val(sink) {
        sink.progress("counters.{phase}.module_lookups", counts.module_lookups - since.module_lookups, -1)
        sink.progress("counters.{phase}.name_lookups", counts.name_lookups - since.name_lookups, -1)
    }
}

// SPEED-500K work counters of the MIR phases, written after the phase's span
// closes so the counting is not charged to it.
// `counters.<phase>.mir_insts`: the instructions and terminators of `functions`.
fn jet_driver_trace_mir_insts(trace_sink: CompilerTraceSink?, phase: String, functions: [MIRFunction]) {
    if trace_sink == .Val(sink) -> sink.progress("counters.{phase}.mir_insts", jet_driver_mir_instruction_count(functions), -1)
}

fn jet_driver_mir_instruction_count(functions: [MIRFunction]) -> Int Never! {
    count := 0
    loop function in functions {
        loop block in function.blocks -> count += block.instructions.len() + 1
    }
    count
}

// `lower`'s counters: the functions it lowered (and the nested ones lowering
// made), their MIR instructions, and how many of the checked functions a
// comptime program had already lowered (D12; `comptime_keys` is
// JetDriverComptimeRunResult.lowered_keys).
fn jet_driver_trace_lower_counters(trace_sink: CompilerTraceSink?, checked: [TFunc], functions: [MIRFunction], nested: [MIRFunction], comptime_keys: [String:Bool]) {
    if trace_sink == .Val(sink) {
        overlap := 0
        loop function in checked {
            if comptime_keys.get("{function.module_identity}\n{function.key}") != None -> overlap += 1
        }
        sink.progress("counters.lower.functions", functions.len() + nested.len(), -1)
        sink.progress("counters.lower.mir_insts", jet_driver_mir_instruction_count(functions) + jet_driver_mir_instruction_count(nested), -1)
        sink.progress("counters.lower.comptime_overlap_functions", overlap, -1)
    }
}

// The comptime stage graph's lookup counts, read through a read parameter so
// the pattern binding borrows the graph (binding it from the owned stage
// would copy every module's AST natively).
fn jet_driver_stage_lookup_counts(graph: SemaRegistrationGraph?, fallback: SemaLookupCounters) -> SemaLookupCounters {
    if graph == .Val(stage_graph) -> return sema_registration_lookup_counts(stage_graph)
    // copy: the counters are returned by value. `fallback` is a field of the caller's stage (a read
    // parameter) and stays there; the type holds only Int fields.
    fallback.copy()
}

// Writes the rows recorded since the last flush to the trace sink.
fn jet_driver_keep_going_flush(kg: &JetDriverKeepGoingLog, trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        loop index in kg.streamed..<kg.rows.len() {
            sink.begin("keepgoing", kg.rows[index], index, -1)
            sink.end("keepgoing", 1)
        }
    }
    kg.streamed = kg.rows.len()
}

fn jet_driver_has_errors_since(diagnostics: [Diagnostic], start: Int) -> Bool Never! {
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity == DIAGNOSTIC_ERROR -> return true
    }
    false
}

// The error reports added to the stage diagnostics since the last call.
fn jet_driver_keep_going_diagnostics(kg: &JetDriverKeepGoingLog, phase: String, diagnostics: [Diagnostic]) {
    start := kg.diagnostic_mark
    if start > diagnostics.len() -> start = 0
    loop index in start..<diagnostics.len() {
        diagnostic :: diagnostics[index]
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        message := diagnostic.what
        if diagnostic.detail == .Val(detail) -> message = "{message}: {detail}"
        path :: diagnostic.source_path ?? "-"
        site := path
        if diagnostic.span == .Val(span) -> site = "{path}:{span.start}..{span.end}"
        jet_driver_keep_going_row(&kg, phase, path, diagnostic.code, message, site)
    }
    kg.diagnostic_mark = diagnostics.len()
}

// Why each incomplete module is incomplete (each failed function's label and
// cause), one row per recorded reason.
fn jet_driver_keep_going_incomplete_modules(kg: &JetDriverKeepGoingLog, phase: String, modules: [SemaGraphModuleResult]) {
    loop graph_module in modules {
        if graph_module.complete -> next
        if graph_module.incomplete_reasons.len() == 0 {
            jet_driver_keep_going_row(&kg, phase, graph_module.module_path, "INCOMPLETE", "incomplete (no recorded cause)", "-")
            next
        }
        loop reason in graph_module.incomplete_reasons -> jet_driver_keep_going_row(&kg, phase, graph_module.module_path, "INCOMPLETE", reason, "-")
    }
}

fn jet_driver_keep_going_skip_set(skip: [String]) -> [String:Bool] Never! {
    set := [String:Bool]{}
    loop entry in skip -> set[entry] = true
    set
}

// A checked function whose body is one unreachable stop: its signature,
// owner and identity are unchanged, so every caller still lowers.
fn jet_driver_keep_going_tir_trap(function: TFunc, reason: String) -> TFunc Never! {
    trapped := function
    stop :: TExpr{ty: Type.Named{name: "Never"}, kind: TExprKind.Never{reason: reason}, span: function.source_span}
    trapped.body = [TStmt]{TStmt.ExprStmt{value: stop, span: function.source_span}}
    trapped
}

// A MIR function whose body is one unreachable block, keeping its signature
// and identity: no instruction, value, place, local, scope or drop remains
// for legality, lint or emission to reject.
fn jet_driver_keep_going_mir_trap(function: MIRFunction, reason: String) -> MIRFunction Never! {
    trapped := function
    trapped.blocks = [MIRBasicBlock]{MIRBasicBlock{id: function.entry, span: function.span, instructions: [MIRInstruction]{}, terminator: MIRTerminator.Unreachable{reason: reason}}}
    trapped.locals = [MIRLocal]{}
    trapped.values = [MIRValueFact]{}
    trapped.places = [MIRPlace]{}
    trapped.scopes = [MIRScope]{}
    trapped.drops = [MIRDropAction]{}
    trapped.optimization = mir_empty_optimization_facts()
    trapped
}

fn jet_driver_keep_going_mir_site(program: MIRProgram, function: MIRFunction, span: Span) -> String Never! {
    path := "-"
    loop file in program.source_files {
        if file.id.value == function.source_file.value {
            path = file.path
            break
        }
    }
    "{path}:{span.start}..{span.end}"
}

// `lower:<name>@<position>` skip entries: the function at that position of
// the lowering list lowers as a trap.
fn jet_driver_keep_going_trap_lowering(kg: &JetDriverKeepGoingLog, functions: &[TFunc]) {
    skip :: jet_driver_keep_going_skip_set(kg.skip)
    loop position in 0..<functions.len() {
        if skip.get("lower:{functions[position].name}@{position}") == None -> next
        // The report and the trap read the row in place; the slot is written
        // only after the trap row is built, when no view of it is live.
        trap :: jet_driver_keep_going_tir_trap_row(&kg, functions[position], "lowered as a trap: an earlier keep-going run crashed lowering it", "keep-going trap: lowering this function crashed an earlier run")
        functions[position] = trap
    }
}

// Records the census row for a function that lowers as a trap and builds the
// trap. The caller writes the trap into the slot after this returns, when no
// view of the row is live.
fn jet_driver_keep_going_tir_trap_row(kg: &JetDriverKeepGoingLog, function: TFunc, reason: String, trap_text: String) -> TFunc {
    jet_driver_keep_going_row(&kg, "lower", "{function.name} [{function.key}]", "TRAPPED", reason, "{function.source_file}:{function.source_span.start}..{function.source_span.end}")
    jet_driver_keep_going_tir_trap(function, trap_text)
}

// Codegen lowers a checked direct call to its callee's checked function or
// to a checked foreign row (`jet_codegen_find_function_row`,
// `jet_codegen_find_checked_foreign_row`); a callee with neither stops it.
// Under JET_KEEP_GOING a function whose check failed and whose own trap did
// not check either (sema_keep_going_push_stub) is such a callee: each of its
// callers lowers as a trap instead, and each is a census row.
fn jet_driver_keep_going_trap_unresolved_calls(kg: &JetDriverKeepGoingLog, functions: &[TFunc], modules: [SemaGraphModuleResult]) {
    targets := [String:Bool]{}
    loop function in functions -> targets[function.key] = true
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            targets[row.key] = true
            targets[row.symbol_id.key] = true
        }
    }
    loop position in 0..<functions.len() {
        missing :: jet_driver_unresolved_direct_call(functions[position], targets) ?? next
        trap :: jet_driver_keep_going_tir_trap_row(&kg, functions[position], "lowered as a trap: it calls `{missing}`, which has no checked function or foreign row", "keep-going trap: this function calls `{missing}`, which did not check")
        functions[position] = trap
    }
}

// The first direct-call callee key in `function` (its parameter defaults,
// then its body, each expression before the ones below it) that `targets`
// does not hold.
fn jet_driver_unresolved_direct_call(function: TFunc, targets: [String:Bool]) -> String? Never! {
    missing := String?{None}
    loop parameter in function.params {
        if parameter.default == Val(value) -> jet_driver_unresolved_call_in(value, targets, &missing)
    }
    loop statement in function.body {
        if missing != None -> break
        jet_driver_unresolved_call_statement(statement, targets, &missing)
    }
    missing
}

// One statement's subtrees. Its own function so the visitor closure lends the
// `missing` write parameter: the stage-0 Rust tier then lends `targets` to the
// closure instead of copying it per statement.
fn jet_driver_unresolved_call_statement(statement: TStmt, targets: [String:Bool], missing: &String?) Never! {
    tir_each_stmt_child(statement, (child: TExpr) -> jet_driver_unresolved_call_in(child, targets, &missing))
}

// Records in `missing` (once) the first direct-call callee key in
// `expression` or below it that `targets` does not hold, read in place.
fn jet_driver_unresolved_call_in(expression: TExpr, targets: [String:Bool], missing: &String?) Never! {
    if missing != None -> return
    if expression.kind == .Call(callee, _, _) {
        if targets.get(callee.key) == None {
            missing = Val(callee.key)
            return
        }
    }
    tir_each_expr_child(expression, (child: TExpr) -> jet_driver_unresolved_call_in(child, targets, &missing))
}

// `emit:<name>@<position>` skip entries: the function at that position of
// the optimized program is emitted as a trap.
fn jet_driver_keep_going_trap_emission(kg: &JetDriverKeepGoingLog, program: &MIRProgram) {
    skip :: jet_driver_keep_going_skip_set(kg.skip)
    loop position in 0..<program.functions.len() {
        if skip.get("emit:{program.functions[position].name}@{position}") == None -> next
        trap :: jet_driver_keep_going_mir_trap_row(&kg, program, position)
        program.functions[position] = trap
    }
}

// The emission counterpart of jet_driver_keep_going_tir_trap_row.
fn jet_driver_keep_going_mir_trap_row(kg: &JetDriverKeepGoingLog, program: MIRProgram, position: Int) -> MIRFunction {
    function :: program.functions[position]
    jet_driver_keep_going_row(&kg, "emit", "{function.name} [{function.key}]", "TRAPPED", "emitted as a trap: an earlier keep-going run crashed emitting it", jet_driver_keep_going_mir_site(program, function, function.span))
    jet_driver_keep_going_mir_trap(function, "keep-going trap: emitting this function crashed an earlier run")
}

// Each optimizer failure is a row. The failing check then names every other
// function it rejects in the program as it stands; all of them become traps
// together and the optimizer runs again on the program, so reruns grow with
// the failing checks rather than with the failing functions.
fn jet_driver_keep_going_optimize(kg: &JetDriverKeepGoingLog, program: &MIRProgram, first: ^MIROptimizationResult, full_verification: Bool, threads: CompilerThreads, journal: &CanonicalPassJournal, trace_sink: CompilerTraceSink?) -> MIROptimizationResult {
    optimization := ^first
    attempts := 0
    traps := 0
    loop attempts < JET_DRIVER_KEEP_GOING_OPTIMIZER_RETRIES {
        optimizer_error :: optimization.error ?? { break }
        failures :: mir_optimizer_function_failures(program, optimizer_error)
        rows :: jet_driver_mir_function_rows(program.functions)
        trapped := 0
        loop failure in failures {
            phase :: if failure.kind == .Lint -> "mir-lint" else -> "optimize"
            position := -1
            if failure.function == .Val(function_id) -> position = rows.get(function_id.value) ?? -1
            item := "-"
            site := "{failure.span.start}..{failure.span.end}"
            if position >= 0 {
                item = "{program.functions[position].name} [{program.functions[position].key}]"
                site = jet_driver_keep_going_mir_site(program, program.functions[position], failure.span)
            }
            jet_driver_keep_going_row(&kg, phase, item, "E0003", failure.message, site)
            if position < 0 -> next
            program.functions[position] = jet_driver_keep_going_mir_trap(program.functions[position], "keep-going trap: the MIR {phase} check failed")
            trapped += 1
        }
        if trapped == 0 -> break
        traps += trapped
        attempts += 1
        optimization = optimize_mir_program(&program, full_verification, threads, &journal, trace_sink)
    }
    if optimization.error != None -> jet_driver_keep_going_row(&kg, "optimize", "-", "STOPPED", "the optimizer still fails after {traps} keep-going traps in {attempts} reruns; emission runs on the program as the optimizer left it", "-")
    optimization
}

// Every emitter failure is a row naming the function being printed.
fn jet_driver_keep_going_emit(kg: &JetDriverKeepGoingLog, program: &MIRProgram, trace_sink: CompilerTraceSink?, threads: CompilerThreads) -> JetRustEmitResult {
    kept := jet_rust_emit_program_keep_going(program, jet_driver_native_emit_config(threads, MIRArtifactBuildMode.Dev), trace_sink)
    loop kept_failure in kept.failures {
        item := "-"
        site := "-"
        if kept_failure.failure.span == .Val(span) -> site = "{span.start}..{span.end}"
        if kept_failure.function == .Val(function_id) {
            if jet_driver_mir_function_index_for_id(program.functions, function_id) == .Val(index) {
                item = "{program.functions[index].name} [{program.functions[index].key}]"
                if kept_failure.failure.span == .Val(span) -> site = jet_driver_keep_going_mir_site(program, program.functions[index], span)
            }
        }
        jet_driver_keep_going_row(&kg, "emit", item, kept_failure.failure.code, "{kept_failure.failure.message}: {kept_failure.failure.detail}", site)
    }
    kept.result
}

// The native AOT emission of the selected program on the compiler's threads.
fn jet_driver_native_emit_config(threads: CompilerThreads, mode: MIRArtifactBuildMode) -> JetRustEmitConfig Never! {
    JetRustEmitConfig{
        target: "rust_aot",
        root_prefix: "",
        emit_types: true,
        emit_foreign: true,
        emit_metadata: true,
        local_rail: mode != MIRArtifactBuildMode.Release,
        web_bucket: None,
        threads: threads,
    }
}

// This retained input is not a RootMemo cache-eligibility proof. All checked
// rows remain in compile.doc_modules; source_modules selects real loaded
// sources and excludes only Loader's explicit ABI-only Core fallback.
struct JetDriverCheckedProjectionResult {
    compile: JetDriverCompileResult
    source_modules: [Int]
    entry_module: Int?
    schema_ingress: JetDriverSchemaIngress?
}
struct JetDriverCheckedProjectionCapture {
    source_modules: [Int]{[Int]{}}
    entry_module: Int?{None}
    schema_ingress: JetDriverSchemaIngress?{None}
    // `jet_driver_lowering_inputs`: stop right before MIR lowering and keep its inputs.
    stop_before_lowering: Bool{false}
    lowering_inputs: JetDriverLoweringInputs?{None}
}

// What the slot IR builder reads, where MIR lowering would start (Pipeline
// `jet_driver_lower_releasing`): the checked functions, after Core pruning
// and keep-going traps; the checked modules (declarations, names) beside
// them; the checked source files' text by path (the first file of a path);
// the entry module; the key of the executable entry
// (jet_driver_resolve_entry_key), None for a program without one; the entry
// module's `#Export(c)` rows (jet_driver_c_export_rows), the exports of a
// library. A Test compile has no entry: it carries the tests and Check
// Outputs its harness runs (jet_driver_test_plan) instead.
struct JetDriverLoweringInputs {
    functions: [TFunc]
    modules: [SemaGraphModuleResult]
    sources: [String:String]
    entry_module_identity: String
    entry_key: String?
    tests: [TTestFact]{[TTestFact]{}}
    output_checks: [TOutputCheckFact]{[TOutputCheckFact]{}}
    c_exports: [JetDriverCExportRow]{[JetDriverCExportRow]{}}
}

struct JetDriverLoweringInputsResult {
    compile: JetDriverCompileResult
    inputs: JetDriverLoweringInputs?
}

// The native executable route's front: the ordinary checked compile of
// `request`, stopped right before lowering, with the lowering inputs (None
// when the compile stopped earlier; its result carries the diagnostics).
// `keep_going` (JET_KEEP_GOING) collects every failure of every stage as
// jet_driver_compile_keep_going does, one row each in the result's
// keep_going_rows.
fn jet_driver_lowering_inputs(request: ^JetDriverCompileRequest, keep_going: JetDriverKeepGoing?) -> JetDriverLoweringInputsResult {
    collecting :: keep_going != None
    kg := jet_driver_keep_going_log(keep_going)
    capture := JetDriverCheckedProjectionCapture{stop_before_lowering: true}
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    compile := jet_driver_compile_stages(request, &kg, false, false, &capture, &journal)
    compile.canonical_routes = canonical_pass_take(&journal)
    if collecting {
        jet_driver_trace_keep_going_begin(request.trace_sink)
        if compile.internal_problem == .Val(problem) -> jet_driver_keep_going_row(&kg, "internal", "-", "ICE", problem, "-")
        // Reports of a stage that returned early; recorded rows are not repeated.
        kg.diagnostic_mark = 0
        jet_driver_keep_going_diagnostics(&kg, "final", compile.diagnostics)
        compile.keep_going_rows = kg.rows
        jet_driver_trace_keep_going_end(request.trace_sink, compile.keep_going_rows.len())
    }
    JetDriverLoweringInputsResult{compile: ^compile, inputs: ^capture.lowering_inputs}
}

// One source-unit classifier for ordinary compilation and retained services.
// ABI-only Core rows still have a catalog unit; their absent source-file bytes
// remain empty. Real Core and private source units keep their actual bytes.
// `release_programs`: each parsed program moves into its input and the loaded
// module keeps an empty one (an ordinary compile reads programs only through
// the registration graph from here on); otherwise the input is a copy.
fn jet_driver_registration_module_inputs(
    modules: &[JetDriverLoadedModule],
    source_units: [JetDriverSourceUnit],
    source_files: [MIRSourceFile],
    providers: [SemaForeignProviderInput],
    diagnostics: &[Diagnostic],
    core_sources: [JetDriverCoreSource],
    release_programs: Bool,
) -> [SemaRegistrationModuleInput]? {
    inputs := [SemaRegistrationModuleInput]{}
    source_positions :: jet_driver_source_file_positions(source_files)
    loop loaded_index in 0..<modules.len() {
        // Fields are read through the index: a local binding of the loaded
        // module would copy its whole parsed program.
        unit_index :: modules[loaded_index].source_unit_index
        if unit_index < 0 || unit_index >= source_units.len() {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module has no exact source-unit owner", "semantic registration preserves the loader's canonical source-unit identity", "retain the catalog source-unit index returned by JetDriver"))
            return None
        }
        unit := source_units[unit_index]
        core_source_alias :: jet_driver_core_source_alias(unit, modules[loaded_index], core_sources)
        handles :: jet_driver_registration_foreign_handle_facts(modules[loaded_index].module_identity, providers, &diagnostics) ?? return None
        // The items, the bulk of a parsed program, move out first so the copy
        // of the rest is small; they then move into the input.
        items := [Item]{}
        if release_programs -> compiler_transfer_rows<Item>(&items, &modules[loaded_index].program.items)
        program := modules[loaded_index].program
        if release_programs -> compiler_transfer_rows<Item>(&program.items, &items)
        &inputs.push(SemaRegistrationModuleInput{
            package_identity: modules[loaded_index].package_identity,
            module_identity: modules[loaded_index].module_identity,
            module_name: modules[loaded_index].module_name,
            core_source_alias: core_source_alias,
            module_path: jet_driver_module_display(unit.relative_path),
            source_file: unit.path,
            source_segments: unit.source_segments,
            source_origin: unit.source_origin,
            program: ^program,
            foreign_handles: handles,
            namespace: modules[loaded_index].namespace,
            namespace_names: modules[loaded_index].namespace_names,
            namespace_refs: modules[loaded_index].namespace_refs,
            source: jet_driver_source_text_at(source_files, source_positions, unit.path),
        })
    }
    Val(inputs)
}

// Compiler-internal finalizer over the original completed check. Service
// callers retain these typed inputs before publishing opaque compiler values;
// this path never loads, finalizes, or checks a source for a second time.
fn jet_driver_project_completed_check(
    request: JetDriverCompileRequest,
    load: ^JetDriverLoadResult,
    registration: ^SemaRegistrationGraph,
    graph: SemaGraphResult,
    values: [SemaComptimeItemValue],
    effect_identity: String,
    schema_ingress: JetDriverSchemaIngress,
    trace: JetDriverCompileTrace,
) -> JetDriverCheckedProjectionResult {
    owned_load := ^load
    resolved_registration := ^registration
    capture := JetDriverCheckedProjectionCapture{schema_ingress: Val(schema_ingress)}
    compile := if request.mode != JetDriverCompileMode.Program -> {
        jet_driver_compile_internal_result(owned_load, trace, "the retained checked projection requires Program mode")
    } else if !graph.complete || jet_driver_has_errors(owned_load.diagnostics) -> {
        jet_driver_compile_result(owned_load, owned_load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    } else -> {
        owned_load.doc_modules = jet_driver_doc_modules(request, owned_load, graph, resolved_registration, values, effect_identity, true, &capture)
        if owned_load.doc_modules.len() != owned_load.modules.len() || capture.entry_module == None -> {
            jet_driver_compile_internal_result(owned_load, trace, "the retained checked projection lost its loaded-module ownership bijection or canonical entry")
        } else -> {
            jet_driver_doc_gate_projection(&owned_load.doc_modules, graph, resolved_registration, request, owned_load.packages)
            jet_driver_compile_result(owned_load, owned_load.diagnostics, None, None, None, None, None, true, trace)
        }
    }
    if !compile.complete {
        capture.source_modules = [Int]{}
        capture.entry_module = None
    }
    JetDriverCheckedProjectionResult{compile: ^compile, source_modules: capture.source_modules, entry_module: capture.entry_module, schema_ingress: capture.schema_ingress}
}

fn jet_driver_checked_projection(request: ^JetDriverCompileRequest) -> JetDriverCheckedProjectionResult {
    capture := JetDriverCheckedProjectionCapture{}
    kg := jet_driver_keep_going_log(None)
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    compile := jet_driver_compile_stages(request, &kg, false, true, &capture, &journal)
    compile.canonical_routes = canonical_pass_take(&journal)
    if !compile.complete {
        capture.source_modules = [Int]{}
        capture.entry_module = None
    }
    JetDriverCheckedProjectionResult{compile: ^compile, source_modules: capture.source_modules, entry_module: capture.entry_module, schema_ingress: capture.schema_ingress}
}

fn jet_driver_compile(request: ^JetDriverCompileRequest) -> JetDriverCompileResult {
    kg := jet_driver_keep_going_log(None)
    capture := JetDriverCheckedProjectionCapture{}
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    result := jet_driver_compile_stages(request, &kg, true, false, &capture, &journal)
    result.canonical_routes = canonical_pass_take(&journal)
    result
}

// Native code generation consumes checked MIR directly. Emitting Rust is not
// a prerequisite for this feed; the checked front-end/optimizer stages and
// their diagnostics are identical to the ordinary compile path.
fn jet_driver_compile_mir(request: ^JetDriverCompileRequest) -> JetDriverCompileResult {
    jet_driver_compile_mir_borrowed(request)
}

// One ordinary MIR pipeline, borrowed by staged build queries. The owned
// command entry above still retires its invocation request on completion.
fn jet_driver_compile_mir_borrowed(request: JetDriverCompileRequest) -> JetDriverCompileResult {
    kg := jet_driver_keep_going_log(None)
    capture := JetDriverCheckedProjectionCapture{}
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    result := jet_driver_compile_stages(request, &kg, false, false, &capture, &journal)
    result.canonical_routes = canonical_pass_take(&journal)
    result
}

struct JetDriverCompileSelectionRestore {
    mode: JetDriverCompileMode
    capture_build_program: Bool
    capture_build_nodes: Bool
    entry_path: String?
    selected_entry: String?
    restore_selected_entry: Bool
}
fn jet_driver_compile_selection_restore(request: &JetDriverCompileRequest, saved: ^JetDriverCompileSelectionRestore) Never! {
    request.mode = saved.mode
    request.capture_build_program = saved.capture_build_program
    request.capture_build_nodes = saved.capture_build_nodes
    if ^saved.entry_path == .Val(path) -> request.authorized_sources.entry_path = ^path
    if saved.restore_selected_entry -> request.selected_entry = ^saved.selected_entry
}
fn jet_driver_compile_mir_selection(request: &JetDriverCompileRequest, mode: JetDriverCompileMode, entry_path: ^String?, selected_entry: ^String?, capture_build_program: Bool, capture_build_nodes: Bool) -> JetDriverCompileResult {
    saved := JetDriverCompileSelectionRestore{mode: request.mode, capture_build_program: request.capture_build_program, capture_build_nodes: request.capture_build_nodes, entry_path: None, selected_entry: None, restore_selected_entry: false}
    if ^entry_path == .Val(path) {
        // copy: `saved` keeps the request's original entry path so it can restore it, and the
        // request's own field is overwritten with `path` right after. Jet has no exchange on a
        // field of a write-borrowed (`&`) parameter.
        saved.entry_path = Val(request.authorized_sources.entry_path.copy())
        request.authorized_sources.entry_path = ^path
    }
    if ^selected_entry == .Val(name) {
        // copy: `saved` keeps the request's original selected entry so it can restore it, and the
        // request's own field is overwritten right after. Jet has no exchange on a field of a
        // write-borrowed (`&`) parameter.
        saved.selected_entry = request.selected_entry.copy()
        saved.restore_selected_entry = true
        request.selected_entry = Val(^name)
    }
    request.mode = mode
    request.capture_build_program = capture_build_program
    request.capture_build_nodes = capture_build_nodes
    result := jet_driver_compile_mir_borrowed(request) ?? {
        jet_driver_compile_selection_restore(&request, ^saved)
        return Err(err)
    }
    jet_driver_compile_selection_restore(&request, ^saved)
    result
}

// Produce the complete installed Core library through the same checked
// registration/comptime/TIR/MIR pipeline. The caller's user source snapshot is
// not loaded; the graph anchor is a real catalog module, never a synthetic run.
fn jet_driver_compile_core_library_mir(owned_request: ^JetDriverCompileRequest) -> JetDriverCompileResult {
    request := ^owned_request
    request.mode = JetDriverCompileMode.Program
    request.target = JetDriverCompileTarget.Native
    request.selected_entry = None
    request.eval_config.runtime_execution = false
    kg := jet_driver_keep_going_log(None)
    capture := JetDriverCheckedProjectionCapture{}
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    if request.trace_sink == .Val(sink) -> sink.begin("load", "", -1, -1)
    load := jet_driver_load_core_library(request)
    if request.trace_sink == .Val(sink) -> sink.end("load", load.modules.len())
    result := jet_driver_compile_loaded_stages(request, &kg, false, ^load, false, &capture, &journal)
    jet_driver_trace_released(request.trace_sink)
    result.canonical_routes = canonical_pass_take(&journal)
    result
}

// JET_KEEP_GOING (the bootstrap entry reads it): every phase runs past the
// failures before it; each failure is a row of the result's keep_going_rows.
// The result keeps every error report, so a compile with any row never
// passes; a crash later in the run still leaves the rows already streamed to
// the trace sink.
// Emission is the caller's existing backend choice, not a keep-going side effect.
fn jet_driver_compile_keep_going(request: ^JetDriverCompileRequest, options: JetDriverKeepGoing, emit_rust: Bool) -> JetDriverCompileResult {
    kg := jet_driver_keep_going_log(Val(options))
    capture := JetDriverCheckedProjectionCapture{}
    journal := canonical_pass_journal(CanonicalPassOptions{adapter_mode: request.adapter_mode, operation_ids: request.adapter_operation_ids})
    result := jet_driver_compile_stages(request, &kg, emit_rust, false, &capture, &journal)
    jet_driver_trace_keep_going_begin(request.trace_sink)
    result.canonical_routes = canonical_pass_take(&journal)
    if result.internal_problem == .Val(problem) -> jet_driver_keep_going_row(&kg, "internal", "-", "ICE", problem, "-")
    // Reports of a stage that returned early; recorded rows are not repeated.
    kg.diagnostic_mark = 0
    jet_driver_keep_going_diagnostics(&kg, "final", result.diagnostics)
    result.keep_going_rows = kg.rows
    jet_driver_trace_keep_going_end(request.trace_sink, result.keep_going_rows.len())
    result
}

fn jet_driver_compile_stages(request: JetDriverCompileRequest, kg: &JetDriverKeepGoingLog, emit_rust: Bool, checked_projection: Bool, capture: &JetDriverCheckedProjectionCapture, journal: &CanonicalPassJournal) -> JetDriverCompileResult {
    // Phase spans for the host trace (JET_TRACE_FILE). A phase an early
    // return abandons is closed by the next enclosing end the host records.
    if request.trace_sink == .Val(sink) -> sink.begin("load", "", -1, -1)
    load := jet_driver_load(request)
    if request.trace_sink == .Val(sink) -> sink.end("load", load.modules.len())
    result := jet_driver_compile_loaded_stages(request, &kg, emit_rust, ^load, checked_projection, &capture, &journal)
    jet_driver_trace_released(request.trace_sink)
    result
}

// A Map is a sorted entry list (Lower/Maps.jet): inserting a key below the
// largest one shifts every later entry, so a whole-program map filled in
// source order costs O(N^2) moves. The whole-program function maps (the
// comptime owner index, the checked-function pass's registered keys and
// owners) are filled from rows sorted once (a merge sort), so each insert
// appends.
struct JetDriverModuleKeyRow {
    module_identity: String
    key: String
    // The row's position in registration order (module, then free
    // functions, nominal methods, impl methods).
    row: Int
}

// One keyed row of a sequence; `row` is its position there, so a sort by
// (key, row) keeps each key's rows in sequence order.
struct JetDriverCheckedKeyRow {
    key: String
    row: Int
}

struct JetDriverCheckedFunctionOwners {
    // Each checked function key's first graph module identity.
    owners: [String:String]
    // Per checked row: an earlier row has the same key.
    repeated: [Bool]
}

// Every function key a registration module declares (free functions, nominal
// and impl methods), in registration order.
fn jet_driver_registration_function_rows(graph: SemaRegistrationGraph) -> [JetDriverModuleKeyRow] Never! {
    rows := [JetDriverModuleKeyRow]{}
    loop source_module in graph.modules {
        loop function in source_module.functions -> jet_driver_push_module_key(&rows, source_module.module_identity, function.symbol.id.key)
        loop nominal in source_module.nominals {
            loop function in nominal.methods -> jet_driver_push_module_key(&rows, source_module.module_identity, function.symbol.id.key)
        }
        loop implementation in source_module.impls {
            loop function in implementation.methods -> jet_driver_push_module_key(&rows, source_module.module_identity, function.symbol.id.key)
        }
    }
    rows
}

fn jet_driver_push_module_key(rows: &[JetDriverModuleKeyRow], module_identity: String, key: String) Never! {
    row :: rows.len()
    // copy: the rows are sorted on their own; the graph keeps its declarations.
    &rows.push(JetDriverModuleKeyRow{module_identity: module_identity.copy(), key: key.copy(), row: row})
}

// The function keys each registration module declares, by module identity.
fn jet_driver_registered_function_keys(graph: SemaRegistrationGraph) -> [String:[String:Bool]] Never! {
    rows := jet_driver_registration_function_rows(graph)
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: JetDriverModuleKeyRow, right: JetDriverModuleKeyRow) -> (left.module_identity <=> right.module_identity).then(left.key <=> right.key))
    registered := [String:[String:Bool]]{}
    keys := [String:Bool]{}
    loop index in 0..<rows.len() {
        keys[rows[index].key] = true
        if index + 1 == rows.len() || rows[index + 1].module_identity != rows[index].module_identity {
            registered[rows[index].module_identity] = ^keys
            keys = [String:Bool]{}
        }
    }
    registered
}

// The owner of every checked function key, and which checked rows repeat a
// key an earlier row (in graph module order, then function order) owns.
fn jet_driver_checked_function_owners(modules: [SemaGraphModuleResult]) -> JetDriverCheckedFunctionOwners Never! {
    rows := [JetDriverCheckedKeyRow]{}
    // Per checked row, its graph module.
    row_modules := [Int]{}
    loop module_index in 0..<modules.len() {
        loop function in modules[module_index].functions {
            &rows.push(JetDriverCheckedKeyRow{key: function.key, row: row_modules.len()})
            &row_modules.push(module_index)
        }
    }
    &rows.sort_by((left: JetDriverCheckedKeyRow, right: JetDriverCheckedKeyRow) -> (left.key <=> right.key).then(left.row <=> right.row))
    owners := [String:String]{}
    repeated := (loop _ in rows -> false)
    loop index in 0..<rows.len() {
        if index > 0 && rows[index - 1].key == rows[index].key {
            repeated[rows[index].row] = true
        } else {
            owners[rows[index].key] = modules[row_modules[rows[index].row]].module_identity
        }
    }
    JetDriverCheckedFunctionOwners{owners: ^owners, repeated: ^repeated}
}

// How many loaded modules carry each module identity.
fn jet_driver_loaded_identity_counts(modules: [JetDriverLoadedModule]) -> [String:Int] Never! {
    identities := (loop loaded_module in modules -> loaded_module.module_identity)
    &identities.sort_by((left: String, right: String) -> left <=> right)
    counts := [String:Int]{}
    start := 0
    loop index in 0..<identities.len() {
        if index + 1 == identities.len() || identities[index + 1] != identities[index] {
            counts[identities[index]] = index + 1 - start
            start = index + 1
        }
    }
    counts
}

// Loading is shared by executable requests and compiler-owned library graphs;
// both consume the identical checked front-end, TIR and MIR stages below.
fn jet_driver_compile_loaded_stages(request: JetDriverCompileRequest, kg: &JetDriverKeepGoingLog, emit_rust: Bool, owned_load: ^JetDriverLoadResult, checked_projection: Bool, capture: &JetDriverCheckedProjectionCapture, journal: &CanonicalPassJournal) -> JetDriverCompileResult {
    load := ^owned_load
    trace := jet_driver_empty_compile_trace()
    if !load.complete {
        failure :: load.failed_stage ?? JetDriverStage.Load
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(failure), false, trace)
    }
    if checked_projection && request.mode != JetDriverCompileMode.Program -> return jet_driver_compile_internal_result(load, trace, "the retained checked projection requires Program mode")
    canonical_effect_module_option := jet_driver_canonical_effect_module(request.canonical_effect_source)
    if canonical_effect_module_option == None {
        return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is invalid")
    }
    canonical_effect_module := canonical_effect_module_option ?? return jet_driver_compile_internal_result(load, trace, "the embedded compiler-owned Prelude effect source is unavailable")
    loop unit in load.source_units {
        if jet_driver_module_identity(unit.package_identity, unit.relative_path) == canonical_effect_module.module_identity {
            return jet_driver_compile_internal_result(load, trace, "an authorized source unit collides with the pinned compiler-owned Prelude effect identity")
        }
        if unit.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "an authorized source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    loop generated in load.generated_source_files {
        if generated.path == canonical_effect_module.source_file {
            return jet_driver_compile_internal_result(load, trace, "a loaded generated source path collides with the pinned compiler-owned Prelude effect source")
        }
    }
    &load.generated_source_files.push(MIRSourceFile{id: mir_source_file_id(canonical_effect_module.source_file), path: canonical_effect_module.source_file, source: request.canonical_effect_source})
    foreign_provider_inputs := jet_driver_assemble_foreign_providers(request.authorized_sources, &load)
    if !load.complete || jet_driver_has_errors(load.diagnostics) {
        failure :: load.failed_stage ?? JetDriverStage.Load
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(failure), false, trace)
    }
    if !jet_driver_foreign_provider_owners_valid(load.modules, foreign_provider_inputs, &load.diagnostics) {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Load), false, trace)
    }
    if !jet_driver_retain_error_prelude_module(&load) {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    }

    target_machine_option := jet_driver_selected_target_machine(request, &load.diagnostics)
    if target_machine_option == None {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
    }
    target_machine :: target_machine_option ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)

    // Doc, REPL and the retained checked projection read the loaded programs
    // again; every other compile hands them to registration.
    release_programs :: !(checked_projection || request.mode == JetDriverCompileMode.Doc || request.mode == JetDriverCompileMode.Repl)
    registration_inputs := jet_driver_registration_module_inputs(&load.modules, load.source_units, load.source_files, foreign_provider_inputs, &load.diagnostics, request.core_sources, release_programs) ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Load), false, trace)
    canonical_effect_module_identity := canonical_effect_module.module_identity
    &registration_inputs.push(^canonical_effect_module)
    registration_module_count := registration_inputs.len()
    package_policies := [SemaRegistrationPackagePolicy]{}
    loop package in load.packages {
        &package_policies.push(SemaRegistrationPackagePolicy{
            package_identity: package.identity,
            authority_allow: package.authority_allow,
            authority_deny: package.authority_deny,
            authority_needs: package.authority_needs,
            runtime_ceiling: package.runtime_ceiling,
            edition: package.edition,
        })
    }
    // #4319: the graph counts its lookups only while a trace is open.
    counting := false
    if request.trace_sink == .Val(sink) {
        sink.begin("register", "", -1, -1)
        counting = true
    }
    registration_graph := sema_registration_prepare_graph(
        ^registration_inputs,
        load.imports,
        load.package_identity,
        load.entry_module_identity,
        canonical_effect_module_identity,
        foreign_provider_inputs,
        target_machine,
        jet_driver_build_facts(load, request, target_machine),
        counting,
        request.compiler_threads,
    )
    output_intent :: if request.mode == JetDriverCompileMode.Test -> SemaOutputIntent.Test else -> request.output_intent
    output_diagnostics :: sema_output_resolve(&registration_graph, output_intent, request.output_address)
    loop diagnostic in output_diagnostics -> &registration_graph.diagnostics.push(diagnostic)
    if jet_driver_has_errors(output_diagnostics) -> registration_graph.complete = false
    if request.trace_sink == .Val(sink) -> sink.end("register", registration_graph.modules.len())
    register_lookups :: sema_registration_lookup_counts(registration_graph)
    jet_driver_trace_lookup_counters(request.trace_sink, "register", register_lookups, SemaLookupCounters{module_lookups: 0, name_lookups: 0})
    if kg.enabled -> registration_graph.keep_going = true
    if request.mode == JetDriverCompileMode.Test -> registration_graph.test_mode = true
    if checked_projection || request.mode == JetDriverCompileMode.Doc || request.mode == JetDriverCompileMode.Repl -> registration_graph.retain_programs = true
    if registration_graph.internal_problem != None {
        loop diagnostic in registration_graph.diagnostics -> &load.diagnostics.push(diagnostic)
        return jet_driver_compile_internal_result(
            load,
            trace,
            registration_graph.internal_problem ?? "canonical effect fact registration failed",
        )
    }
    if request.trace_sink == .Val(sink) -> sink.begin("sema.check", "", -1, -1)
    comptime_stage := sema_collect_comptime_declarations(^registration_graph, package_policies, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("sema.check", comptime_stage.modules.len())
    // Every copy of a graph shares one counter set (SemaLookupCounters).
    check_lookups := register_lookups
    check_lookups = jet_driver_stage_lookup_counts(comptime_stage.graph, check_lookups)
    jet_driver_trace_lookup_counters(request.trace_sink, "sema.check", check_lookups, register_lookups)
    if kg.enabled {
        loop diagnostic in comptime_stage.diagnostics -> &load.diagnostics.push(diagnostic)
        jet_driver_keep_going_diagnostics(&kg, "sema.check", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(&kg, "sema.check", comptime_stage.modules)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if (!kg.enabled && (!comptime_stage.complete || jet_driver_has_errors(comptime_stage.diagnostics))) || comptime_stage.modules.len() != registration_module_count {
        if !kg.enabled {
            loop diagnostic in comptime_stage.diagnostics -> &load.diagnostics.push(diagnostic)
        }
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val(jet_driver_incomplete_graph_problem("semantic declaration checking did not return a complete resolved package graph ({comptime_stage.modules.len()} of {registration_module_count} modules checked)", comptime_stage.modules))
        }
        return jet_driver_doc_failure(^result, request.mode, jet_driver_doc_graph_facts(request.mode, comptime_stage.graph))
    }

    // The stage callees read `load` while they append diagnostics, so the
    // diagnostics list travels beside it and is put back after each stage.
    stage_diagnostics := load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime", "", -1, -1)
    // The declaration pass's graph becomes the run's environment graph,
    // and its modules move into the run, which hands them back.
    staged_graph := ^comptime_stage.graph
    comptime_stage.graph = None
    run_staged := ^staged_graph ?? return jet_driver_compile_internal_result(load, trace, "the declaration pass lost its registration graph")
    declared_modules := ^comptime_stage.modules
    comptime_stage.modules = [SemaGraphModuleResult]{}
    comptime_run := jet_driver_run_comptime(
        ^run_staged,
        ^declared_modules,
        comptime_stage.sources,
        comptime_stage.names,
        [SemaComptimeItemValue]{},
        [SemaComptimeFunctionResult]{},
        load,
        request,
        &stage_diagnostics,
    )
    jet_driver_comptime_return_declared(&comptime_stage, &comptime_run)
    if request.trace_sink == .Val(sink) -> sink.end("comptime", comptime_run.values.len())
    load.diagnostics = stage_diagnostics
    trace = comptime_run.trace
    if comptime_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime", load.diagnostics)
        if !comptime_run.complete -> jet_driver_keep_going_row(&kg, "comptime", "-", "INCOMPLETE", comptime_run.internal_problem ?? "comptime execution did not complete; the staged values so far are kept", "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !comptime_run.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Comptime), false, trace)
        if {
            comptime_run.internal_problem != None -> {
                result.internal_problem = comptime_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val("comptime execution did not complete with a value, control result, or user diagnostic")
            }
        }
        stage_facts := jet_driver_doc_graph_facts(request.mode, comptime_run.graph)
        if stage_facts == None -> stage_facts = jet_driver_doc_graph_facts(request.mode, comptime_run.partial_graph)
        return jet_driver_doc_failure(^result, request.mode, stage_facts)
    }
    if request.trace_sink == .Val(sink) -> sink.begin("sema.finalize", "", -1, -1)
    // A completed run's graph already carries its values: finalization takes
    // it in place. After any other exit (JET_KEEP_GOING) the run's edits are
    // undone and every value applied again, which is
    // sema_comptime_graph_with_values of the registration graph.
    trail := ^comptime_run.trail
    comptime_run.trail = sema_graph_trail_init()
    run_graph := ^comptime_run.graph
    comptime_run.graph = None
    if run_graph == None {
        partial_graph := ^comptime_run.partial_graph
        comptime_run.partial_graph = None
        restored := ^partial_graph ?? return jet_driver_compile_internal_result(load, trace, "the staged comptime environment lost its registration graph")
        sema_graph_trail_undo(&restored, &trail)
        sema_comptime_graph_apply_values(&restored, comptime_run.values, &trail)
        run_graph = Val(^restored)
    }
    finalize_graph := ^run_graph ?? return jet_driver_compile_internal_result(load, trace, "the staged comptime environment lost its registration graph")
    checked_graph := sema_finalize_graph(^finalize_graph, &trail, comptime_stage, comptime_run.values, comptime_run.functions, request.eval_config.host_hooks, request.compiler_threads, None, request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("sema.finalize", checked_graph.modules.len())
    if checked_graph.modules.len() != registration_module_count {
        loop diagnostic in checked_graph.diagnostics -> &load.diagnostics.push(diagnostic)
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if !jet_driver_has_errors(load.diagnostics) {
            result.internal_problem = Val("semantic finalization did not return every registered module")
        }
        return jet_driver_doc_failure(^result, request.mode, jet_driver_doc_graph_facts(request.mode, checked_graph.registration_graph))
    }
    // Finalization returns the same graph; undo the staged edits before
    // subsequent passes read the registration facts.
    finalized_graph := ^checked_graph.registration_graph
    checked_graph.registration_graph = None
    registration_graph = ^finalized_graph ?? return jet_driver_compile_internal_result(load, trace, "semantic finalization lost the registration graph")
    sema_graph_trail_undo(&registration_graph, &trail)
    schema_check := jet_driver_check_schema_migrations(request, ^registration_graph, checked_graph, checked_projection)
    registration_graph = ^schema_check.registration
    capture.schema_ingress = schema_check.ingress
    loop diagnostic in schema_check.diagnostics -> &load.diagnostics.push(diagnostic)
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.bodies", "", -1, -1)
    body_run := jet_driver_orchestrate_comptime_bodies(
        ^registration_graph,
        comptime_stage,
        ^checked_graph,
        ^comptime_run.values,
        ^comptime_run.functions,
        ^trace,
        load,
        request,
        &stage_diagnostics,
    )
    // The body recheck moved the run's values, closures and trace in and
    // returns them as its own.
    trace = ^body_run.trace
    if request.trace_sink == .Val(sink) -> sink.end("comptime.bodies", body_run.values.len())
    load.diagnostics = stage_diagnostics
    comptime_run.values = [SemaComptimeItemValue]{}
    comptime_run.functions = [SemaComptimeFunctionResult]{}
    returned_registration := ^body_run.registration
    body_run.registration = None
    registration_graph = ^returned_registration ?? return jet_driver_compile_internal_result(load, trace, "comptime body rechecking lost the registration graph")
    if body_run.soft_stop {
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime.bodies", load.diagnostics)
        jet_driver_keep_going_incomplete_modules(&kg, "comptime.bodies", body_run.graph.modules)
        if body_run.internal_problem == .Val(problem) -> jet_driver_keep_going_row(&kg, "comptime.bodies", "-", "INCOMPLETE", problem, "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !body_run.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Check), false, trace)
        if {
            body_run.internal_problem != None -> {
                result.internal_problem = body_run.internal_problem
            }
            !jet_driver_has_errors(load.diagnostics) -> {
                result.internal_problem = Val(jet_driver_incomplete_graph_problem("semantic body rechecking did not return a complete resolved package graph", body_run.graph.modules))
            }
        }
        return jet_driver_doc_failure(^result, request.mode, Val(body_run.graph.names.structure_facts))
    }
    checked_graph = ^body_run.graph
    comptime_values := ^body_run.values
    body_run.values = [SemaComptimeItemValue]{}
    comptime_functions := ^body_run.functions
    body_run.functions = [SemaComptimeFunctionResult]{}

    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("comptime.validate", "", -1, -1)
    validation := jet_driver_validate_checked_text(
        ^registration_graph,
        comptime_stage,
        ^checked_graph,
        comptime_values,
        comptime_functions,
        trace,
        load,
        request,
        &stage_diagnostics,
    )
    if request.trace_sink == .Val(sink) -> sink.end("comptime.validate", validation.values.len())
    load.diagnostics = stage_diagnostics
    // Finalization, the body recheck and checked-text validation were the
    // declaration pass's last readers: it drops beside lowering
    // (jet_driver_lower_releasing), off the serial path.
    prelower_released := jet_driver_released_empty()
    &prelower_released.stages.push(^comptime_stage)
    validated_registration := ^validation.registration
    validation.registration = None
    registration_graph = ^validated_registration ?? return jet_driver_compile_internal_result(load, trace, "checked text validation lost the registration graph")
    trace = validation.trace
    if validation.soft_stop -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, false, trace)
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "comptime.validate", load.diagnostics)
        if !validation.complete -> jet_driver_keep_going_row(&kg, "comptime.validate", "-", "INCOMPLETE", validation.internal_problem ?? "checked text evaluation did not complete", "-")
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !validation.complete && !kg.enabled {
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Comptime), false, trace)
        result.internal_problem = validation.internal_problem
        if result.internal_problem == None && !jet_driver_has_errors(load.diagnostics) -> result.internal_problem = Val("checked text evaluation did not return a complete validation or diagnostic")
        return jet_driver_doc_failure(^result, request.mode, Val(validation.graph.names.structure_facts))
    }
    checked_graph = ^validation.graph
    comptime_values = ^validation.values
    validation.values = [SemaComptimeItemValue]{}
    comptime_functions = ^validation.functions
    validation.functions = [SemaComptimeFunctionResult]{}
    if request.capture_build_nodes && checked_graph.complete && !jet_driver_has_errors(load.diagnostics) {
        jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.build_nodes")
        load.build_nodes = jet_driver_build_compiler_nodes(request, load, checked_graph, canonical_effect_module_identity)
        jet_driver_trace_step_end(request.trace_sink, "driver.prelower.build_nodes", -1)
        if load.build_nodes == None -> return jet_driver_compile_internal_result(load, trace, "the final checked build bundle lost its exact source bytes or node identity")
    }
    // A Comptime compile ends with its evaluated build-time values; nothing
    // is lowered or emitted for run time.
    if request.mode == JetDriverCompileMode.Comptime {
        failed := JetDriverStage?{None}
        if jet_driver_has_errors(load.diagnostics) -> failed = Val(JetDriverStage.Check)
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, failed, failed == None, trace)
        result.comptime_values = comptime_values
        return result
    }
    // The merge reads unchanged registration name facts. Declaration consumers
    // below apply values only when they need the resolved graph.
    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.merge")
    merged :: jet_driver_merge_checked_text_functions(&checked_graph, comptime_functions)
    if merged -> registration_graph = jet_driver_merged_names(&checked_graph, ^registration_graph, request.compiler_threads)
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.merge", comptime_functions.len())
    if !merged {
        if !kg.enabled -> return jet_driver_compile_internal_result(load, trace, "staged method closure lost its checked function or registered owner")
        jet_driver_keep_going_row(&kg, "comptime.validate", "-", "ICE", "staged method closure lost its checked function or registered owner", "-")
    }
    // The merge was the staged closures' last reader.
    &prelower_released.closures.push(^comptime_functions)
    comptime_functions = [SemaComptimeFunctionResult]{}
    if checked_projection {
        resolved_registration := sema_comptime_graph_with_values(^registration_graph, comptime_values)
        schema_ingress :: capture.schema_ingress ?? return jet_driver_compile_internal_result(load, trace, "the retained checked projection lost its actual schema input")
        retained := jet_driver_project_completed_check(request, ^load, ^resolved_registration, checked_graph, comptime_values, canonical_effect_module_identity, schema_ingress, trace)
        capture.source_modules = ^retained.source_modules
        capture.entry_module = retained.entry_module
        capture.schema_ingress = ^retained.schema_ingress
        return ^retained.compile
    }
    if request.mode == JetDriverCompileMode.Doc {
        resolved_registration := sema_comptime_graph_with_values(^registration_graph, comptime_values)
        load.doc_modules = jet_driver_doc_modules(request, load, checked_graph, resolved_registration, comptime_values, canonical_effect_module_identity, false, &capture)
        jet_driver_doc_gate_projection(&load.doc_modules, checked_graph, resolved_registration, request, load.packages)
        registration_graph = ^resolved_registration
    }
    if request.capture_build_program {
        jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.build_program")
        resolved_registration := sema_comptime_graph_with_values(^registration_graph, comptime_values)
        module_sources := [SemaCompilerModuleSource]{}
        source_positions :: jet_driver_source_file_positions(load.source_files)
        loop source_module in load.modules {
            unit :: load.source_units[source_module.source_unit_index]
            &module_sources.push(SemaCompilerModuleSource{module_identity: source_module.module_identity, source: jet_driver_source_text_at(load.source_files, source_positions, unit.path)})
        }
        &module_sources.push(SemaCompilerModuleSource{module_identity: canonical_effect_module_identity, source: request.canonical_effect_source})
        load.build_program = jet_eval_compiler_services_program_info(resolved_registration, checked_graph, jet_driver_source_text_at(load.source_files, source_positions, request.authorized_sources.entry_path), module_sources)
        registration_graph = ^resolved_registration
        jet_driver_trace_step_end(request.trace_sink, "driver.prelower.build_program", module_sources.len())
        if load.build_program == None -> return jet_driver_compile_internal_result(load, trace, "the checked build program reflection snapshot is incomplete")
    }
    // Only a REPL session reads the build-time values past this point.
    if request.mode != JetDriverCompileMode.Repl {
        &prelower_released.values.push(^comptime_values)
        comptime_values = [SemaComptimeItemValue]{}
    }
    if request.mode == JetDriverCompileMode.Eval {
        selected_name :: request.selected_entry ?? "run"
        key :: symbol_id(SymbolKind.Function, load.entry_module_identity, "", selected_name).key
        loop diagnostic in check_pure_program_root(key, checked_graph.modules) -> &load.diagnostics.push(diagnostic)
    }

    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.owners")
    // Every checked function moves out of its graph module into one list, so
    // the checked TIR is resident once from here on: the rows return to their
    // modules after lowering for the entry and foreign lookups
    // (jet_driver_restore_checked_functions) and are released after those.
    checked_functions := [TFunc]{}
    // Per row of `checked_functions`: false for a repeated key that
    // JET_KEEP_GOING leaves unlowered.
    lowering_candidates := [Bool]{}
    // Per graph module, how many rows of `checked_functions` it owns.
    module_function_counts := [Int]{}
    // Built from sorted rows (jet_driver_registered_function_keys,
    // jet_driver_checked_function_owners): never a source-order map build.
    registered_function_keys := jet_driver_registered_function_keys(registration_graph)
    checked_owners := jet_driver_checked_function_owners(checked_graph.modules)
    function_owners := ^checked_owners.owners
    repeated_rows :: ^checked_owners.repeated
    loaded_identity_counts := jet_driver_loaded_identity_counts(load.modules)
    checked_row := 0
    failed_stage := JetDriverStage?{None}
    runtime_semantic_modules := [SemaGraphModuleResult]{}
    loop graph_module_index in 0..<checked_graph.modules.len() {
        module_functions := [TFunc]{}
        compiler_transfer_rows<TFunc>(&module_functions, &checked_graph.modules[graph_module_index].functions)
        // The module carries no functions now, so the runtime copy below
        // holds only its declarations.
        graph_module :: checked_graph.modules[graph_module_index]
        module_registered :: registered_function_keys.has_key(graph_module.module_identity)
        if graph_module.module_identity != canonical_effect_module_identity {
            &runtime_semantic_modules.push(graph_module)
            module_matches :: loaded_identity_counts.get(graph_module.module_identity) ?? 0
            if module_matches != 1 {
                &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a semantic module does not map to exactly one loaded source identity", "source, package, and module identities remain attached across graph registration", "retain the loader's exact module identity in each semantic result"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
            }
        }
        loop function_index in 0..<module_functions.len() {
            function :: module_functions[function_index]
            // The Prelude conversions sema injected after the
            // module's bodies are the module's own items (Rust pushes them into
            // `module.items`) though registration never saw them.
            registered :: (module_registered && registered_function_keys[graph_module.module_identity].has_key(function.key)) || graph_module.injected_function_keys.contains(function.key)
            if function.module_identity != graph_module.module_identity || !registered {
                &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", function.source_span, "a checked function lost its canonical module or symbol identity", "cross-module call resolution and MIR IDs use exact declaration identities", "preserve module_identity and the original function SymbolId through Sema"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
            }
            repeated :: repeated_rows[checked_row]
            checked_row += 1
            if repeated {
                &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, graph_module.module_identity, "E0003", function.source_span, "two checked functions share one canonical symbol key", "every lowered function identity names exactly one declaration in the package graph", "report the duplicate Sema function key"))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
                // JET_KEEP_GOING: the first function of a key lowers.
                if kg.enabled {
                    &lowering_candidates.push(false)
                    next
                }
            }
            &lowering_candidates.push(true)
        }
        &module_function_counts.push(module_functions.len())
        compiler_transfer_rows<TFunc>(&checked_functions, &module_functions)
    }
    // Every checked function has its owner now.
    registered_function_keys = [String:[String:Bool]]{}
    loaded_identity_counts = [String:Int]{}
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.owners", checked_row)
    // E0601 only when neither named tests nor selected Check Outputs exist.
    if request.mode == JetDriverCompileMode.Test && jet_driver_runnable_test_count(registration_graph) == 0 {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0601", "no `#Test` blocks found to run", "add at least one top-level block: #Test(\"describes what this checks\") {{ ... }}", "use `assert` and `assert_eq` inside the block to check results"))
    }
    if jet_driver_has_errors(load.diagnostics) -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Check)
    if failed_stage != None && !kg.enabled -> return jet_driver_doc_failure(jet_driver_compile_result(load, load.diagnostics, None, None, None, None, failed_stage, false, trace), request.mode, Val(checked_graph.names.structure_facts))

    // From here on the registration graph is read only for the entry
    // module's C export rows, the Rust foreign facts, a Sandbox export
    // surface and a REPL session. Read the export rows now and keep the graph
    // only for a route that reads it later, so MIR lowering, assembly, the
    // optimizer and the native backend never hold every registered module;
    // otherwise it drops beside lowering (jet_driver_lower_releasing).
    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.registration")
    c_export_rows :: jet_driver_c_export_rows(registration_graph, load.entry_module_identity)
    sandbox_target := if request.target == {
        .Sandbox(_, _, _) -> true
        else -> false
    }
    keep_registration :: sandbox_target || request.mode == JetDriverCompileMode.Repl || jet_driver_rust_foreign_present(registration_graph)
    late_registration := SemaRegistrationGraph?{None}
    if keep_registration {
        late_registration = Val(^registration_graph)
    } else {
        &prelower_released.registrations.push(^registration_graph)
    }
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.registration", c_export_rows.len())
    // Lowering and assembly read only the checked modules, imports and names;
    // the checking facts drop beside lowering too.
    jet_driver_trace_step_begin(request.trace_sink, "driver.prelower.release")
    &prelower_released.checking.push(sema_graph_result_take_checking_facts(&checked_graph))
    jet_driver_trace_step_end(request.trace_sink, "driver.prelower.release", prelower_released.checking.len())

    // #3980: lower only the Core source bodies the program reaches (Rust
    // TIR `should_lower_imported_core_body`).
    if request.trace_sink == .Val(sink) -> sink.begin("lower", "", -1, -1)
    lowering_rows := jet_codegen_reachable_core_rows(&checked_functions, ^lowering_candidates, jet_driver_prunable_core_modules(load, request.core_sources, runtime_semantic_modules), request.compiler_threads)
    sema_functions := [TFunc]{}
    unlowered_functions := [TFunc]{}
    jet_driver_partition_checked_functions(&checked_functions, lowering_rows, &sema_functions, &unlowered_functions)
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "sema", load.diagnostics)
        if kg.skip.len() > 0 -> jet_driver_keep_going_trap_lowering(&kg, &sema_functions)
        // Only a failed check can leave a callee without a checked function.
        if kg.rows.len() > 0 -> jet_driver_keep_going_trap_unresolved_calls(&kg, &sema_functions, runtime_semantic_modules)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    // The native executable route reads what lowering would read and lowers
    // nothing; its entry resolves over the checked functions. A Test compile
    // has no entry: its harness plan reads the same checked functions.
    if capture.stop_before_lowering {
        if request.trace_sink == .Val(sink) -> sink.end("lower", sema_functions.len())
        jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.entry")
        entry_diagnostics := load.diagnostics
        load.diagnostics = [Diagnostic]{}
        entry_key := String?{None}
        tests := [TTestFact]{}
        output_checks := [TOutputCheckFact]{}
        if request.mode == JetDriverCompileMode.Test {
            jet_driver_test_plan(jet_driver_test_modules(load), checked_graph, sema_functions, &tests, &output_checks, &entry_diagnostics)
        } else {
            entry_key = jet_driver_resolve_entry_key(load, checked_graph, sema_functions, runtime_semantic_modules, &entry_diagnostics)
        }
        load.diagnostics = entry_diagnostics
        jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.entry", -1)
        if kg.enabled -> jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
        if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
        foreign_link :: jet_driver_foreign_link_facts(runtime_semantic_modules, load.source_files)
        sources := [String:String]{}
        loop file in load.source_files {
            if sources.get(file.path) == None -> sources[file.path] = file.source
        }
        capture.lowering_inputs = Val(JetDriverLoweringInputs{functions: ^sema_functions, modules: ^runtime_semantic_modules, sources: ^sources, entry_module_identity: load.entry_module_identity, entry_key: entry_key, tests: ^tests, output_checks: ^output_checks, c_exports: c_export_rows.copy()})
        result := jet_driver_compile_result(load, load.diagnostics, None, None, None, None, None, true, trace)
        result.rust_foreign = jet_driver_late_rust_foreign_facts(late_registration)
        result.foreign_link = foreign_link
        return result
    }

    lowered := jet_driver_lower_releasing(^prelower_released, &sema_functions, &runtime_semantic_modules, load.source_files, request.compiler_threads, request.trace_sink, request.native_stop_points, jet_driver_resolved_package_edition(load), kg.enabled)
    if request.trace_sink == .Val(sink) -> sink.end("lower", lowered.functions.len())
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.counters")
    jet_driver_trace_lower_counters(request.trace_sink, sema_functions, lowered.functions, lowered.nested_functions, comptime_run.lowered_keys)
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.counters", sema_functions.len())
    // JET_KEEP_GOING: each function whose lowering stopped lowered as a trap.
    loop failure in lowered.lowering_failures -> jet_driver_keep_going_row(&kg, "lower", "{failure.name} [{failure.key}]", "TRAPPED", "lowered as a trap: lowering it stopped: {failure.message}", "{failure.source_file}:{failure.span.start}..{failure.span.end}")
    if lowered.functions.len() != sema_functions.len() {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "MIR lowering did not return every checked function", "a successful lowering preserves the complete checked function set", "report this incomplete codegen result as a compiler defect"))
        if !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)
    }
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.restore")
    jet_driver_restore_checked_functions(&checked_graph, module_function_counts, lowering_rows, &sema_functions, &unlowered_functions)
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.restore", lowering_rows.len())
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.owners")
    function_index := 0
    loop function_index < lowered.functions.len() {
        function :: lowered.functions[function_index]
        owner_identity := function_owners.get(function.key)
        if {
            owner_identity == None -> {
                &load.diagnostics.push(jet_driver_diagnostic_at_optional_loaded_site(load, owner_identity, "E0003", function.span, "a lowered function has no exact checked-module owner", "MirFunction.key preserves its unique checked TFunc.key", "retain the canonical TFunc.key through Codegen"))
            }
            else -> {
                owner_module_identity :: owner_identity ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)
                if function.module_id.value != mir_module_id(owner_module_identity).value {
                    &load.diagnostics.push(jet_driver_diagnostic_at_loaded_site(load, owner_module_identity, "E0003", function.span, "Codegen assigned a function to a display-name module identity", "MIR module IDs derive from checked module_identity, never language module_name", "lower MirFunction.module_id from TFunc.module_identity"))
                }
            }
        }
        function_index += 1
    }
    // The owner check above was the owner map's last reader.
    function_owners = [String:String]{}
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.owners", lowered.functions.len())
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "lower", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Lower), false, trace)

    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.entry")
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    // Rust `lower_tir_artifact_facts_for_request`: a TestExecutable has no
    // entry; its harness owns `main`.
    entry_function := MIRFunctionID?{None}
    if {
        request.mode == JetDriverCompileMode.Eval || request.mode == JetDriverCompileMode.Interpreter || request.mode == JetDriverCompileMode.Repl -> {
            selected_name :: request.selected_entry ?? "run"
            key :: symbol_id(SymbolKind.Function, load.entry_module_identity, "", selected_name).key
            entry_function = jet_driver_find_lowered_function_id(lowered.functions, key)
            if entry_function == .None {
                &stage_diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the evaluation entry `{selected_name}` has no checked MIR function", "evaluation executes the selected checked function through canonical JetEval", "declare the selected entry in the evaluation module"))
            }
        }
        request.mode != JetDriverCompileMode.Test -> entry_function = jet_driver_resolve_entry_function(load, checked_graph, lowered.functions, &stage_diagnostics)
    }
    load.diagnostics = stage_diagnostics
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.entry", -1)
    web_target := if request.target == {
        .Web(_, _, _) -> true
        .Native | .Sandbox(_, _, _) -> false
    }
    if entry_function == None && web_target {
        &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the Web compile target requires an explicit package entry function", "WebApplication publication invokes exactly the manifest-selected checked entry", "declare an `outputs.web.entry` function in the selected package"))
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    }
    if kg.enabled -> jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
    if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.facts")
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    package_facts_option := jet_driver_package_facts(
        load,
        request,
        target_machine,
        checked_graph.core_usage.used_core,
        checked_graph.core_usage.inferred_layer,
        checked_graph.hardware_use,
        &stage_diagnostics,
    )
    load.diagnostics = stage_diagnostics
    package_facts :: package_facts_option ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    foreign_artifacts := lower_foreign_artifacts(checked_graph.modules, package_facts)
    foreign_link :: jet_driver_foreign_link_facts(checked_graph.modules, load.source_files)
    // Test mode (Rust artifact_plan.rs `lower_test`/`lower_harness`, mir.rs
    // `lower_artifact_rows`): the checked tests' facts and their one Test
    // harness, lowered while the tests' checked TIR rows are still resident.
    test_artifacts := JetCodegenJobTestArtifacts?{None}
    if request.mode == JetDriverCompileMode.Test -> test_artifacts = Val(jet_driver_test_artifacts(load.package_identity, jet_driver_test_modules(load), &checked_graph, &lowered.functions, &load.diagnostics))
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.facts", -1)
    // The checked TIR functions are as large as the MIR lowered from them;
    // they leave the graph before MIR assembly and optimization and drop
    // beside assembly (jet_driver_assemble_releasing).
    jet_driver_trace_step_begin(request.trace_sink, "driver.preassemble.release")
    preassemble_released := jet_driver_released_empty()
    if request.mode != JetDriverCompileMode.Repl {
        loop module_index in 0..<checked_graph.modules.len() {
            compiler_transfer_rows<TFunc>(&preassemble_released.functions, &checked_graph.modules[module_index].functions)
            checked_graph.modules[module_index].functions = [TFunc]{}
        }
    }
    jet_driver_trace_step_end(request.trace_sink, "driver.preassemble.release", preassemble_released.functions.len())
    stage_diagnostics = load.diagnostics
    load.diagnostics = [Diagnostic]{}
    if request.trace_sink == .Val(sink) -> sink.begin("assemble", "", -1, -1)
    program := jet_driver_assemble_releasing(
        ^preassemble_released,
        request.compiler_threads,
        load,
        runtime_semantic_modules,
        checked_graph.imports,
        checked_graph.names,
        ^lowered,
        foreign_artifacts,
        package_facts,
        true,
        kg.enabled,
        &stage_diagnostics,
    )
    load.diagnostics = stage_diagnostics
    // Lowering and assembly were the runtime module rows' last readers.
    runtime_semantic_modules = [SemaGraphModuleResult]{}
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if program == None {
        if !jet_driver_has_errors(load.diagnostics) {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the resolved semantic graph cannot be represented by the current MIR item schema", "assembly preserves exact module, import, declaration, function, and source identities; unsupported item kinds fail closed", "add canonical MIR rows for the checked item kind before treating the package graph as complete"))
        }
        return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    }
    // Assembly hands off an owned optional program. Consume the whole local
    // before projecting its payload, so the large MIR is not copied while
    // an otherwise-unused Option still owns and drops the original.
    program_value := ^program ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    web_profile := if request.target == {
        .Native | .Sandbox(_, _, _) -> None
        .Web(_, _, profile) -> Val(profile)
    }
    test_harness := MIRHarnessID?{None}
    if test_artifacts == .Val(artifacts) {
        program_value.tests = artifacts.tests
        program_value.harnesses = artifacts.harnesses
        if artifacts.harnesses.len() > 0 -> test_harness = Val(artifacts.harnesses[0].id)
        if test_harness == None -> return jet_driver_compile_internal_result(load, trace, "the checked tests lowered to no MIR test harness")
    }
    c_exports :: jet_driver_c_exports(c_export_rows, program_value.functions)
    // A sandbox's export surface is
    // checked (E1260) and diffed against its frozen interface (E1257) before
    // anything is optimized or emitted.
    codable_keys :: jet_driver_codable_keys(checked_graph)
    sandbox_exports := [MIRExport]?{None}
    sandbox_snapshot := SemaPluginFrozenSnapshotInput?{None}
    if request.target == .Sandbox(requested_export, frozen_interfaces, _) {
        exports :: jet_driver_late_sandbox_exports(late_registration, program_value, codable_keys, &load.diagnostics)
        sandbox_exports = Val(exports)
        export_name :: requested_export ?? jet_driver_sandbox_default_export_name(load, request)
        current :: jet_driver_late_sandbox_snapshot(late_registration, export_name, (loop export in exports -> export.symbol))
        prior := SemaPluginFrozenSnapshotInput?{None}
        loop text in frozen_interfaces {
            parsed :: sema_sandbox_parse_snapshot(text) ?? next
            if parsed.package == current.package -> prior = Val(parsed)
        }
        loop diagnostic in sema_sandbox_freeze_diagnostics(current, prior) -> &load.diagnostics.push(diagnostic)
        sandbox_snapshot = Val(current)
        if kg.enabled -> jet_driver_keep_going_diagnostics(&kg, "assemble", load.diagnostics)
        if jet_driver_has_errors(load.diagnostics) && !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Assemble), false, trace)
    }
    if entry_function == None && sandbox_exports == None && test_harness == None && request.mode != JetDriverCompileMode.Test && request.mode != JetDriverCompileMode.Eval && request.mode != JetDriverCompileMode.Interpreter && request.mode != JetDriverCompileMode.Repl {
        entry_function = jet_driver_default_run_entry(load, checked_graph, program_value)
    }
    artifact_plan_option := jet_driver_artifact_plan(program_value, entry_function, test_harness, c_exports, sandbox_exports, package_facts, target_machine, web_profile, request.build_mode)
    if artifact_plan_option == None {
        return jet_driver_compile_internal_result(load, trace, "the compiler could not construct an exact MIR artifact plan for the selected execution target")
    }
    artifact_plan :: artifact_plan_option ?? return jet_driver_compile_internal_result(load, trace, "the compiler artifact plan is unavailable")
    program_value.artifacts = [MIRArtifactPlan]{artifact_plan}
    if request.mode == JetDriverCompileMode.Repl {
        if failed_stage != None || jet_driver_has_errors(load.diagnostics) -> return jet_driver_compile_result(load, load.diagnostics, entry_function, None, None, None, failed_stage, false, trace)
        selected_name :: request.selected_entry ?? "run"
        owner :: symbol_id(SymbolKind.Function, load.entry_module_identity, "", selected_name)
        root := TFunc?{None}
        loop module_row in checked_graph.modules {
            loop function in module_row.functions { if function.key == owner.key -> root = Val(function) }
        }
        checked_root :: root ?? return jet_driver_compile_internal_result(load, trace, "REPL selected root lost its checked TFunc")
        repl_registration := ^late_registration ?? return jet_driver_compile_internal_result(load, trace, "REPL selected root lost its registration graph")
        resolved_registration := sema_comptime_graph_with_values(^repl_registration, comptime_values)
        source :: sema_registration_callable_declaration(resolved_registration, owner) ?? return jet_driver_compile_internal_result(load, trace, "REPL selected root lost its registered declaration")
        session :: repl_session_new(^resolved_registration, ^checked_graph.modules, source, checked_root, ^program_value, jet_eval_runtime_config(request.eval_config)) ?? {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "REPL session initialization refused the checked root", err.message, "select an empty zero-parameter REPL root"))
            return jet_driver_compile_result(load, load.diagnostics, entry_function, None, None, None, Val(JetDriverStage.Check), false, trace)
        }
        result := jet_driver_compile_result(load, load.diagnostics, entry_function, None, None, None, None, true, trace)
        result.repl_session = Val(session)
        return result
    }
    // Assembly, the export surfaces, the entry fallback and the artifact plan
    // were the checked graph's last readers; the optimizer and the backend
    // read only the MIR program.
    sema_graph_result_release_rows(&checked_graph)
    // Compile time is explicit in the checker, so ordinary immutable bindings
    // over pure work are folded here, once, for every execution tier.
    program_value = jet_driver_fold_pure_calls(^program_value, request.compiler_threads)
    if request.trace_sink == .Val(sink) -> sink.end("assemble", program_value.functions.len())
    jet_driver_trace_mir_insts(request.trace_sink, "assemble", program_value.functions)

    // The optimizer rewrites the program in place (no second copy of the
    // largest compile-time structure); an optimizer error is located through
    // the function owners kept here. MIR Lint checks the optimized program on
    // every compile and every pass when the request asks for full verification.
    function_owners_for_errors := jet_driver_mir_function_owners(program_value)
    if request.trace_sink == .Val(sink) -> sink.begin("optimize", "", -1, -1)
    optimization := optimize_mir_program(&program_value, request.mir_lint_every_pass, request.compiler_threads, &journal, request.trace_sink)
    if kg.enabled {
        optimization = jet_driver_keep_going_optimize(&kg, &program_value, ^optimization, request.mir_lint_every_pass, request.compiler_threads, &journal, request.trace_sink)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if request.trace_sink == .Val(sink) -> sink.end("optimize", function_owners_for_errors.len())
    jet_driver_trace_mir_insts(request.trace_sink, "optimize", program_value.functions)
    if request.trace_sink == .Val(sink) {
        // The optimizer's checks, the late Rust foreign facts, any emission
        // and the compile result, up to jet_driver_trace_result_built.
        sink.begin("driver.result", "", -1, -1)
    }
    if optimization.error != None && kg.enabled -> optimization.error = None
    if optimization.error == {
        Val(optimizer_error) -> {
            if optimizer_error.kind == .Lint -> return jet_driver_compile_internal_result(load, trace, optimizer_error.message)
            pass_location := SemaSourceLocation?{None}
            if optimizer_error.function == {
                Val(function_identity) -> pass_location = jet_driver_source_location_for_mir_function(load, function_owners_for_errors, function_identity, optimizer_error.span)
                None -> {}
            }
            &load.diagnostics.push(jet_driver_diagnostic_with_location("E0003", optimizer_error.span, pass_location, "the checked MIR optimizer failed", optimizer_error.message, "do not emit a package graph rejected by MIR legality validation"))
        }
        None -> {}
    }
    if !optimization.complete || optimization.report.completed.len() != optimization.report.production_order.len() {
        if kg.enabled {
            jet_driver_keep_going_row(&kg, "optimize", "-", "INCOMPLETE", "the MIR optimizer did not complete every production pass; emission runs on the program as the optimizer left it", "-")
        } else {
            if !jet_driver_has_errors(load.diagnostics) {
                &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the canonical MIR optimizer is incomplete", "Rust emission requires every declared ordered production optimizer stage to complete", "complete the canonical MIR optimization result before requesting an AOT artifact"))
            }
            return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        }
    }
    optimized_program := ^program_value
    if entry_function != None {
        entry_id :: entry_function ?? return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        if !jet_driver_has_mir_function_id(optimized_program.functions, entry_id) {
            &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the MIR optimizer result lost the explicit package entry function", "the typed entry binding must survive every optimizer stage unchanged", "preserve the selected MirFunctionId through optimization"))
            if !kg.enabled -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Pass), false, trace)
        }
    }
    if request.mode == JetDriverCompileMode.Eval || request.mode == JetDriverCompileMode.Interpreter {
        return jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, failed_stage, failed_stage == .None && !jet_driver_has_errors(load.diagnostics), trace)
    }
    if web_target {
        // A MIR digest consumer (D5): traced as `mir.digest` like the optimizer's.
        if request.trace_sink == .Val(sink) -> sink.begin("mir.digest", "web.semantic", -1, -1)
        semantic_digest :: mir_program_digest(optimized_program)
        if request.trace_sink == .Val(sink) -> sink.end("mir.digest", optimized_program.functions.len())
        web_config_option := if request.target == {
            .Native | .Sandbox(_, _, _) -> None
            .Web(assets, release_policy, _) -> Val(JetWebEmitConfig{
                artifact: artifact_plan.id,
                layout: jet_target_layout_from_machine(target_machine),
                assets: assets,
                semantic_digest: semantic_digest,
                root_prefix: "",
                release_devtools_policy: release_policy,
            })
        }
        web_config :: web_config_option ?? return jet_driver_compile_internal_result(load, trace, "the selected Web artifact has no source Web emitter configuration")
        if jet_web_emit(optimized_program, web_config) == {
            .Complete(artifacts) -> {
                result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, None, true, trace)
                result.web_artifact = Val(artifact_plan.id)
                result.web_artifacts = Val(artifacts)
                return result
            }
            .Incomplete(failure) -> {
                user_target_error := if failure.kind == {
                    .InvalidAssets -> true
                    .InvalidLayout -> true
                    else -> false
                }
                if user_target_error {
                    &load.diagnostics.push(jet_driver_diagnostic_with_optional_location(
                        failure.code,
                        failure.span,
                        None,
                        failure.message,
                        failure.detail,
                        "resolve the selected Web asset or layout error before publication",
                    ))
                    return jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, Val(JetDriverStage.Emit), false, trace)
                }
                result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, Val(JetDriverStage.Emit), false, trace)
                result.internal_problem = Val("Web emission failed internally: {failure.message}: {failure.detail}")
                return result
            }
        }
    }
    if request.eval_config.runtime_execution {
        runtime_artifact := jet_driver_runtime_artifact_id(optimized_program)
        result := jet_driver_compile_result(
            load,
            load.diagnostics,
            entry_function,
            Val(^optimized_program),
            None,
            None,
            None,
            true,
            trace,
        )
        result.runtime_artifact = runtime_artifact
        if entry_function != None && result.runtime_artifact == None {
            return jet_driver_compile_internal_result(load, trace, "the checked runtime MIR artifact has no unique entry identity")
        }
        return result
    }

    rust_foreign :: jet_driver_late_rust_foreign_facts(late_registration)
    if !emit_rust {
        result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), None, None, None, true, trace)
        result.rust_foreign = rust_foreign
        result.foreign_link = foreign_link
        jet_driver_trace_result_built(request.trace_sink, result.diagnostics.len())
        return result
    }

    if request.trace_sink == .Val(sink) -> sink.begin("emit", "", -1, -1)
    if kg.enabled && kg.skip.len() > 0 {
        jet_driver_keep_going_trap_emission(&kg, &optimized_program)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    emitter_before := CanonicalPassSnapshot?{None}
    if canonical_pass_requested(journal, "mir.rust-emitter") -> emitter_before = Val(canonical_pass_mir_snapshot(optimized_program))
    emitted := if kg.enabled -> jet_driver_keep_going_emit(&kg, &optimized_program, request.trace_sink, request.compiler_threads) else -> jet_rust_emit_program(optimized_program, jet_driver_native_emit_config(request.compiler_threads, request.build_mode), request.trace_sink)
    if request.trace_sink == .Val(sink) -> sink.end("emit", optimized_program.functions.len())
    emitted_source := String?{None}
    emit_manifest := JetRustEmitManifest?{None}
    emission_complete := false
    if emitted == {
        .Complete(source, manifest) -> {
            if emitter_before == .Val(input) {
                output := canonical_pass_debug_snapshot("mir", "mir.rust-emitter", "{source}")
                output.identity = "{{\"representation\":\"mir\",\"artifact_id\":{foundation_json_quote("{artifact_plan.id.value}")},\"target\":{foundation_json_quote(target_machine.triple)}}}"
                canonical_pass_record(&journal, "lowering", "mir.rust-emitter", "crates/jet-codegen/src/Codegen/MIRRust.rs", input, output, "checked")
            }
            if {
                manifest.schema_version != MIR_SCHEMA_VERSION || manifest.target != "rust_aot" || manifest.package_identity != load.package_identity || manifest.function_count != optimized_program.functions.len() || manifest.type_count != optimized_program.types.len() || manifest.foreign_count != optimized_program.foreign.len() -> {
                    &load.diagnostics.push(jet_driver_diagnostic_without_span("E0003", "Rust emission returned a manifest inconsistent with the checked MIR artifact", "emitter output identity and row counts are bound to the optimized program", "preserve the manifest facts produced by the canonical Rust emitter"))
                }
                else -> {
                    emitted_source = Val(source)
                    emit_manifest = Val(manifest)
                    emission_complete = true
                }
            }
        }
        .Incomplete(failure) -> {
            &load.diagnostics.push(jet_driver_diagnostic_with_optional_location(failure.code, failure.span, None, failure.message, failure.detail, "resolve the emitter's typed failure before returning a native AOT artifact"))
        }
    }
    if kg.enabled {
        jet_driver_keep_going_diagnostics(&kg, "emit", load.diagnostics)
        jet_driver_keep_going_flush(&kg, request.trace_sink)
    }
    if !emission_complete -> return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Emit), false, trace)
    if sandbox_target {
        snapshot :: sandbox_snapshot ?? return jet_driver_compile_internal_result(load, trace, "the sandbox compile lost its checked interface snapshot")
        whole_program :: emitted_source ?? return jet_driver_compile_internal_result(load, trace, "the sandbox compile lost its emitted guest source")
        timezone_data :: if request.target == {
            .Sandbox(_, _, zones) -> zones
            else -> [JetWebTimezoneAsset]{}
        }
        if jet_rust_emit_plugin(optimized_program, jet_driver_native_emit_config(request.compiler_threads, request.build_mode), artifact_plan.id, codable_keys, whole_program, timezone_data) == {
            .Complete(artifacts) -> {
                result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), emitted_source, emit_manifest, None, true, trace)
                result.sandbox = Val(JetDriverSandboxOutput{artifacts: artifacts, snapshot_package: snapshot.package, snapshot_text: sema_sandbox_snapshot_text(snapshot, package_facts.package_version)})
                return result
            }
            .Incomplete(failure) -> {
                &load.diagnostics.push(jet_driver_diagnostic_with_optional_location(failure.code, failure.span, None, failure.message, failure.detail, "resolve the plugin emitter's typed failure before returning a sandbox guest"))
                return jet_driver_compile_result(load, load.diagnostics, None, None, None, None, Val(JetDriverStage.Emit), false, trace)
            }
        }
    }
    result := jet_driver_compile_result(load, load.diagnostics, entry_function, Val(^optimized_program), emitted_source, emit_manifest, None, true, trace)
    result.rust_foreign = rust_foreign
    result.foreign_link = foreign_link
    jet_driver_trace_result_built(request.trace_sink, result.diagnostics.len())
    result
}

// Ends `driver.result` (items: the result's diagnostics, which the host
// presents next) and opens `driver.release`: the compile's remaining locals
// (graphs, load, checked rows) drop as jet_driver_compile_loaded_stages
// returns, and its caller closes the span (jet_driver_trace_released).
fn jet_driver_trace_result_built(trace_sink: CompilerTraceSink?, diagnostics: Int) {
    if trace_sink == .Val(sink) {
        sink.end("driver.result", diagnostics)
        sink.begin("driver.release", "", -1, -1)
    }
}

// Closes `driver.release` after jet_driver_compile_loaded_stages returns, and
// a `driver.result` a route after the optimizer returned from early.
fn jet_driver_trace_released(trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) {
        sink.end("driver.release", -1)
        sink.end("driver.result", -1)
    }
}

// `keepgoing.final` (jet_driver_compile_keep_going's rows past the stages)
// opens and closes through these parameters, not a match on the request
// inline: that request is an owned (`^`) parameter, a local to the Rust
// tier (stage 0), which reads a pattern payload of a local's field by copy
// (in place only under a parameter), and a trace sink, a
// trait object, has no copy (E0599).
fn jet_driver_trace_keep_going_begin(trace_sink: CompilerTraceSink?) {
    if trace_sink == .Val(sink) -> sink.begin("keepgoing.final", "", -1, -1)
}

fn jet_driver_trace_keep_going_end(trace_sink: CompilerTraceSink?, rows: Int) {
    if trace_sink == .Val(sink) -> sink.end("keepgoing.final", rows)
}

fn jet_driver_core_source_alias(unit: JetDriverSourceUnit, loaded_module: JetDriverLoadedModule, core_sources: [JetDriverCoreSource]) -> String Never! {
    if !jet_driver_unit_is_core(unit) || unit.file_index < 0 || unit.file_index >= core_sources.len() -> return ""
    owner :: core_sources[unit.file_index]
    if owner.path != unit.relative_path || owner.module_name != loaded_module.module_name -> return ""
    owner.alias
}
