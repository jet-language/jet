// Read-only fn-build staging: ordinary Driver checking and comptime execution,
// followed by Core's checked finish. No action or generated-file write occurs.
use {
    jet_foundation.[Diagnostic, EffectRowEntry, Item, PolicyKey, Span, TComptimeValue, Type, policy_gate_allows, sha256_hex]
    jet_eval.[jet_eval_build_context_value, jet_eval_build_session_input, jet_eval_build_session_diagnostic, jet_eval_runtime_config]
    jet_eval.[jet_eval_build_failed_diagnostic]
    core.build.[BuildGraph, BuildGraphNode, BuildGraphInputDigest]
    jet_sema.[SemaGraphResult, SemaSourceOrigin]
    jet_build_session.[
        BuildSessionGeneratedModule, BuildSessionPlan, BuildSessionPolicy, build_plan_graph,
        build_plan_selected_generated, build_session_abort, build_session_append_unique,
        build_session_compiler_node, build_session_finish, build_session_new, build_session_set_args,
    ]
}

// Rust Driver::compiler_nodes_for_bundle_with_outputs. These are static
// identities, not BuildNodeRecords: no duration or why-ran observation exists
// until an actual build action runs. Core owns the sole hash byte recipe.
fn jet_driver_build_compiler_nodes(request: JetDriverCompileRequest, load: JetDriverLoadResult, checked: SemaGraphResult, effect_identity: String) -> [BuildGraphNode]? Never! {
    if !checked.complete -> return None
    root :: jet_driver_entry_root_path(request.authorized_sources)
    if root == "" -> return None
    checks := [BuildGraphNode]{}
    loop checked_module in checked.modules {
        if checked_module.module_identity == effect_identity -> next
        unit_index :: loop loaded in load.modules {
            if loaded.module_identity == checked_module.module_identity -> break loaded.source_unit_index
        } ?? -1
        if unit_index < 0 || unit_index >= load.source_units.len() -> return None
        unit :: load.source_units[unit_index]
        if jet_driver_unit_is_core(unit) -> next
        subject := ""
        digest := ""
        if unit.source_origin == SemaSourceOrigin.Snapshot {
            digest = sha256_hex(jet_driver_source_unit_text(request, unit) ?? return None)
            if unit.root_index < 0 || unit.root_index >= request.authorized_sources.roots.len() -> return None
            source_files :: request.authorized_sources.roots[unit.root_index].files
            if unit.file_index < 0 || unit.file_index >= source_files.len() -> return None
            subject = jet_driver_display_path(root, source_files[unit.file_index].path).replace("\\", "/")
        } else {
            // Only exact declared build outputs belong to the user's bundle.
            // Foreign adapter/Core/effect synthetic text is not a source node.
            generated_index :: loop index in 0..<request.generated_modules.len() {
                row :: request.generated_modules[index]
                if row.package_identity == unit.package_identity && row.relative_path == unit.relative_path && jet_driver_generated_module_path(row.package_identity, row.relative_path) == unit.path -> break index
            } ?? -1
            if generated_index < 0 -> next
            generated :: request.generated_modules[generated_index]
            digest = sha256_hex(generated.source)
            owner :: loop package in load.packages {
                if package.identity == generated.package_identity -> break package.root_index
            } ?? return None
            if owner < 0 || owner >= request.authorized_sources.roots.len() -> return None
            subject = jet_driver_display_path(root, jet_driver_physical_path(request.authorized_sources.roots[owner].canonical_path, generated.relative_path)).replace("\\", "/")
        }
        // copy: build_session_compiler_node stores `subject` as the node's subject, and the node's
        // input digest needs its own copy of the same text for `name`. Both live in one node.
        &checks.push(build_session_compiler_node("check", subject, [BuildGraphInputDigest]{{name: subject.copy(), digest: digest}}))
    }
    &checks.sort_by((left: BuildGraphNode, right: BuildGraphNode) -> (left.subject <=> right.subject).then(left.key <=> right.key))
    outputs := [String]{}
    loop name in request.build_output_names -> build_session_append_unique(&outputs, name)
    if outputs.len() == 0 {
        parts :: request.authorized_sources.entry_path.split("/").to_list()
        file :: parts[parts.len() - 1]
        components := file.split(".").to_list()
        // copy: `file` is an element of `parts`, which can't be moved out (E0225). `output` is
        // reassigned and pushed into `outputs`, while `components` still views `file`.
        output := file.copy()
        if components.len() > 1 && !(components.len() == 2 && components[0] == "") {
            _ := &components.pop()
            output = components.join(".")
        }
        &outputs.push(if output == "" -> { "program" } else -> { ^output })
    }
    &outputs.sort()
    // copy: `checks` keeps every check node (it is the returned graph), so each compile node's
    // input digest needs its own key text.
    inputs :: loop node in checks -> BuildGraphInputDigest{name: "check:{node.subject}", digest: node.key.copy()}
    compiles := [BuildGraphNode]{}
    links := [BuildGraphNode]{}
    loop output in outputs {
        compiled :: build_session_compiler_node("compile", output, inputs)
        // copy: `compiled` keeps its key when it moves into `compiles`, and the link node's input
        // digest needs its own copy of the same key.
        linked :: build_session_compiler_node("link", output, [BuildGraphInputDigest]{{name: "compile:{output}", digest: compiled.key.copy()}})
        &compiles.push(^compiled)
        &links.push(^linked)
    }
    // Rust's enum order is Check, Compile, Link (not string key order).
    loop node in compiles -> &checks.push(node)
    loop node in links -> &checks.push(node)
    Val(^checks)
}

fn jet_driver_build_selected_output_names(plan: BuildSessionPlan) -> [String] Never! {
    permit :: plan.storage.guard_read()
    outputs := [String]{}
    loop (index, target) in permit.value.targets {
        if plan.default >= 0 && index != plan.default -> next
        loop output in target.outputs -> build_session_append_unique(&outputs, output)
    }
    &outputs.sort()
    outputs
}

fn jet_driver_build_install_nodes(plan: BuildSessionPlan, nodes: ^[BuildGraphNode]) Never! {
    permit := plan.storage.guard_edit()
    permit.value.nodes = ^nodes
}

// This is the selected source declaration, not inferred/transitive effects
// or a host's grant. An omitted/open/broader row cannot silently enable HTTP.
fn jet_driver_build_declared_network(declared: [EffectRowEntry]?) -> Bool Never! {
    effects :: declared ?? return false
    net := false
    wait := false
    loop effect_row in effects {
        if effect_row.name == "Net" -> net = true
        if effect_row.name == "Time.Wait" -> wait = true
    }
    net && wait
}

// One command owns this scope across all of its package queries. IDs are
// invocation-local authority, not cache keys or a process-global counter.
struct JetDriverBuildQueryScope {
    next_session_id: Int{1}
    policy: BuildSessionPolicy{BuildSessionPolicy{legacy_denied: None, plugins_denied: None, plugin_grants: [String:[String]]{}}}
}
fn jet_driver_build_next_session_id(scope: &JetDriverBuildQueryScope) -> Int? Never! {
    id :: scope.next_session_id
    if id <= 0 || id == 9223372036854775807 -> return None
    scope.next_session_id += 1
    Val(id)
}

struct JetDriverBuildQueryResult {
    plan: BuildSessionPlan?
    graph: BuildGraph?
    generated: [JetDriverGeneratedModule]
    diagnostics: [Diagnostic]
    complete: Bool
    internal_problem: String?
    nodes: [BuildGraphNode]{[BuildGraphNode]{}}
    // The entry package's authority, the policy its build actions run under.
    authority_policy: JetDriverAuthorityPolicy?{None}
}
struct JetDriverBuildQueryResponse {
    request: JetDriverCompileRequest
    query: JetDriverBuildQueryResult
}
fn jet_driver_build_query_empty(request: ^JetDriverCompileRequest, diagnostics: ^[Diagnostic], complete: Bool, problem: ^String?) -> JetDriverBuildQueryResponse Never! {
    {request: ^request, query: JetDriverBuildQueryResult{plan: None, graph: None, generated: [], diagnostics: ^diagnostics, complete: complete, internal_problem: ^problem}}
}
// A build that failed: its own reports `ran` after the compile's `errors`,
// or the staged reports alone when the staging check failed (`staged`).
fn jet_driver_build_query_failed(request: ^JetDriverCompileRequest, errors: ^[Diagnostic], ran: ^[Diagnostic], staged: Bool) -> JetDriverBuildQueryResponse Never! {
    reports := ^errors
    if !staged {
        loop error in ^ran -> &reports.push(error)
    }
    jet_driver_build_query_empty(^request, ^reports, false, None)
}
fn jet_driver_query_build_plan(owned_request: ^JetDriverCompileRequest, scope: &JetDriverBuildQueryScope) -> JetDriverBuildQueryResponse {
    request := ^owned_request
    sources :: jet_driver_source_query(request)
    if !sources.complete -> return jet_driver_build_query_empty(^request, ^sources.diagnostics, false, None)
    if sources.entry_module_index < 0 || sources.entry_module_index >= sources.modules.len() -> return jet_driver_build_query_empty(^request, ^sources.diagnostics, false, Val("loaded build query has no exact entry module"))
    package :: sources.modules[sources.entry_module_index].package_identity
    selected := String?{None}
    selected_site := ""
    network_declared := false
    span := Span{start: 0, end: 0}
    loop loaded_module in sources.modules {
        if loaded_module.package_identity != package -> next
        loop item in loaded_module.program.items {
            if item == .Func(function) && jet_driver_item_is_build_entry(item) {
                site :: jet_driver_build_entry_site(loaded_module.path, loaded_module.source, function.span.start)
                if selected != None {
                    errors := ^sources.diagnostics
                    &errors.push(jet_driver_diagnostic_at_source("E3520", Val(function.name_span), loaded_module.path, 0, "Two build entries for one package: {selected_site} and {site}.", "One package has one build authority, so policy and provenance have one auditable home.", "Keep one `fn build` and remove every other entry."))
                    return jet_driver_build_query_empty(^request, ^errors, false, None)
                }
                // copy: `sources` keeps its module rows: on a duplicate build entry it returns
                // `sources.diagnostics`. The selected path moves into
                // jet_driver_compile_selection, which takes ownership of the entry path.
                selected = Val(loaded_module.physical_path.copy())
                selected_site = site
                span = function.span
                network_declared = jet_driver_build_declared_network(function.declared_effects)
            }
        }
    }
    path :: selected ?? {
        // No build entry still has an ordinary checked source projection.
        // Loader-only success must not hide type errors in the package.
        checked :: jet_driver_compile_selection(&request, JetDriverCompileMode.Doc, None, None, false, true)
        complete :: checked.complete && checked.internal_problem == None && !jet_driver_has_errors(checked.diagnostics)
        result := jet_driver_build_query_empty(^request, ^checked.diagnostics, complete, ^checked.internal_problem)
        if complete {
            result.query.nodes = ^checked.build_nodes ?? {
                result.query.complete = false
                result.query.internal_problem = Val("completed build query lost its compiler node identities")
                return result
            }
        }
        return result
    }
    // Input services resolve paths against the build file's own directory.
    base_dir :: jet_driver_parent_path(path)
    // Handwritten code may use what `fn build` generates: build entries and
    // generated modules share one checked expansion pass. A staging check
    // that fails still evaluates `fn build`, with each failed function
    // lowered as a typed trap (JetDriverKeepGoing); its reports (`staged`)
    // stand only when the build itself fails, and the final checked compile
    // with the generated modules reports what generation left unresolved.
    selection := jet_driver_lowering_inputs_selection(&request, JetDriverCompileMode.RootRun, Val(path.copy()), Val("build"), true, None)
    errors := [Diagnostic]{}
    staged_failed :: selection.compile.internal_problem == None && jet_driver_has_errors(selection.compile.diagnostics)
    if staged_failed {
        errors = ^selection.compile.diagnostics
        selection = jet_driver_lowering_inputs_selection(&request, JetDriverCompileMode.RootRun, Val(path.copy()), Val("build"), true, Val(JetDriverKeepGoing{skip: [String]{}}))
    }
    compiled := ^selection.compile
    if staged_failed {
        // The trapped compile's reports restate the staged ones.
        if compiled.internal_problem != None || compiled.build_program == None || selection.inputs == None -> return jet_driver_build_query_empty(^request, ^errors, false, None)
    } else {
        if !compiled.complete || compiled.internal_problem != None -> return jet_driver_build_query_empty(^request, ^compiled.diagnostics, false, ^compiled.internal_problem)
        errors = ^compiled.diagnostics
    }
    program :: ^compiled.build_program ?? return jet_driver_build_query_empty(^request, ^errors, false, Val("checked build invocation lost its ProgramInfo"))
    inputs :: ^selection.inputs ?? return jet_driver_build_query_empty(^request, ^errors, false, Val("checked build invocation lost its checked functions"))
    session_id :: jet_driver_build_next_session_id(&scope) ?? return jet_driver_build_query_empty(^request, ^errors, false, Val("build invocation identity space exhausted"))
    session := build_session_new(session_id, jet_driver_build_session_package(package, path), request.host_facts.compiler_identity ?? "", scope.policy)
    build_session_set_args(&session, request.build_args)
    config := jet_eval_runtime_config(request.eval_config)
    // A refused effect inside `#Impure` is reported for this gate (E3411).
    config.impure_gate = policy_gate_allows(request.gate_set, PolicyKey.Impure)
    // copy: the evaluator's build adapter gets a session and the request's input handles of its
    // own. This query keeps `session` to abort or finish it, and `request` is returned in every
    // response.
    config.build_host_adapter = Val(JetDriverBuildAdapter{session: session.copy(), inputs: request.build_inputs.copy(), http_inputs: request.build_http_inputs.copy(), network_declared: network_declared, base_dir: base_dir})
    config.compiler_query_host = Val(jet_driver_comptime_compiler_for(request))
    run := jet_driver_invocation_run(^inputs, [TComptimeValue]{jet_eval_build_context_value(session_id, program)}, config, span)
    // The build's own reports; after a failed staging check the staged
    // reports stand alone when the build fails (a trap it reached restates
    // them) and give way to the final checked compile when it runs.
    ran := [Diagnostic]{}
    evaluated :: ^run.result ?? {
        build_session_abort(&session)
        if staged_failed -> return jet_driver_build_query_empty(^request, ^errors, false, None)
        return jet_driver_build_query_empty(^request, ^errors, false, ^run.problem)
    }
    // copy: `ran` owns the reported diagnostic, while `evaluated` keeps its error for the
    // internal_problem/complete checks below. `error` is a payload view, which cannot be moved.
    if evaluated.error == .Val(error) -> &ran.push(error.diagnostic.copy())
    returned :: evaluated.value
    if evaluated.internal_problem != None || !evaluated.complete || returned == None {
        build_session_abort(&session)
        if staged_failed -> return jet_driver_build_query_empty(^request, ^errors, false, None)
        // copy: the query result owns the problem text, but `internal` is a payload view of
        // `evaluated.internal_problem`, and Jet has no consuming match to move it out.
        problem :: if evaluated.internal_problem == .Val(internal) -> { Val(internal.message.copy()) } else -> { None }
        loop error in ran -> &errors.push(error)
        return jet_driver_build_query_empty(^request, ^errors, false, ^problem)
    }
    if returned == .Val(data) && jet_eval_build_failed_diagnostic(data, span) == .Val(diagnostic) {
        build_session_abort(&session)
        &ran.push(diagnostic)
        return jet_driver_build_query_failed(^request, ^errors, ^ran, staged_failed)
    }
    value :: jet_eval_build_session_input(returned ?? panic("checked return lost its data")) ?? {
        build_session_abort(&session)
        &ran.push(jet_driver_diagnostic_without_span("E3502", "`fn build` returns nothing", "a build is the graph its Build context describes", "remove the returned value; configure `b` instead"))
        return jet_driver_build_query_failed(^request, ^errors, ^ran, staged_failed)
    }
    finished :: build_session_finish(&session, value)
    loop error in finished.diagnostics -> &ran.push(jet_eval_build_session_diagnostic(error))
    plan :: ^finished.plan ?? return jet_driver_build_query_failed(^request, ^errors, ^ran, staged_failed)
    if jet_driver_has_errors(ran) -> return jet_driver_build_query_failed(^request, ^errors, ^ran, staged_failed)
    // The build ran: the final checked compile below replaces the staged reports.
    if staged_failed -> errors = [Diagnostic]{}
    loop error in ran -> &errors.push(error)
    // The selected generated modules, owned by the build's package: the
    // final checked bundle below and every target compile of the plan
    // (the response's `generated`) load them beside the package's sources.
    // copy: each row's texts are views of the plan, which stays whole.
    generated :: loop generated_row in build_plan_selected_generated(plan) -> JetDriverGeneratedModule{package_identity: package.copy(), name: generated_row.name.copy(), relative_path: generated_row.path.copy(), source: generated_row.source.copy()}
    // The final ordinary checked bundle, not the staging build callable,
    // owns all source/generated identities, even when no output was generated.
    original_generated_count :: request.generated_modules.len()
    selected_outputs :: request.build_output_names.len() == 0
    if selected_outputs -> request.build_output_names = jet_driver_build_selected_output_names(plan)
    // copy: the request gets temporary generated-module rows for the checked recompile, popped
    // right after; `generated` stays whole for the response.
    loop generated_row in generated -> &request.generated_modules.push(generated_row.copy())
    checked :: jet_driver_compile_selection(&request, JetDriverCompileMode.Doc, None, None, false, true)
    loop request.generated_modules.len() > original_generated_count -> _ :: &request.generated_modules.pop()
    if selected_outputs -> request.build_output_names = [String]{}
    loop error in checked.diagnostics -> &errors.push(error)
    if !checked.complete || checked.internal_problem != None || jet_driver_has_errors(errors) -> return jet_driver_build_query_empty(^request, ^errors, false, ^checked.internal_problem)
    // The nodes move out of the checked result: a `::` read of the field would copy them at `^nodes`.
    nodes :: ^checked.build_nodes ?? return jet_driver_build_query_empty(^request, ^errors, false, Val("completed build query lost its compiler node identities"))
    // copy: the plan installs its own node list, and `nodes` moves into the response's `nodes`
    // below. These are two independent owners of the same node identities.
    jet_driver_build_install_nodes(plan, nodes.copy())
    graph :: build_plan_graph(plan)
    return JetDriverBuildQueryResponse{request: ^request, query: JetDriverBuildQueryResult{plan: Val(^plan), graph: Val(graph), generated: ^generated, nodes: ^nodes, diagnostics: ^errors, complete: true, internal_problem: None, authority_policy: ^compiled.authority_policy}}
}
// The package a build session spells its `.jet/generated/<package>/` and
// contribution sources with: a manifest package's identity, or, for a build
// file outside any manifest (a source-root package), the file's stem.
fn jet_driver_build_session_package(package: String, entry_path: String) -> String Never! {
    if !package.starts_with("source-root:") -> return package.copy()
    parts := entry_path.split("/").to_list()
    file_name :: &parts.pop() ?? entry_path
    file_name.removesuffix(".jet")
}
// Whether the entry package declares a `fn build`, the build entry
// jet_driver_query_build_plan evaluates, read from the loaded sources alone.
// False when the sources don't load: the compile reports why.
fn jet_driver_entry_package_has_build(request: JetDriverCompileRequest) -> Bool {
    load :: jet_driver_load(request)
    if !load.complete -> return false
    package := String?{None}
    loop loaded_module in load.modules {
        if loaded_module.module_identity == load.entry_module_identity -> package = Val(loaded_module.package_identity.copy())
    }
    entry_package :: package ?? return false
    loop loaded_module in load.modules {
        if loaded_module.package_identity != entry_package -> next
        loop item in loaded_module.program.items {
            if jet_driver_item_is_build_entry(item) -> return true
        }
    }
    false
}
// Whether `item` is the build entry `fn build(b: Build)`; any other `fn build`
// is ordinary code.
fn jet_driver_item_is_build_entry(item: Item) -> Bool Never! {
    if item == .Func(function) && function.name == "build" && function.params.len() == 1 && function.params[0].ty == (Type.Named{name: "Build"}) -> return true
    false
}
// `path:line` of the byte offset `at` in `source`.
fn jet_driver_build_entry_site(path: String, source: String, at: Int) -> String Never! {
    line := 1
    loop (index, byte) in source.bytes() {
        if index >= at -> break
        if byte == 10 -> line += 1
    }
    "`{path}:{line}`"
}
fn jet_driver_query_build_nodes(request: ^JetDriverCompileRequest, scope: &JetDriverBuildQueryScope) -> JetDriverBuildQueryResponse {
    // Nodes are the checked graph's exact compiler facts, never a projection
    // reconstructed from emitted source, action names or a receipt.
    jet_driver_query_build_plan(^request, &scope)
}
