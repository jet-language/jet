// Typed values a native execution host returns, decoded into compile-time
// values. Compile-time code itself runs in the in-process evaluator
// (Pipeline jet_driver_comptime_machine_eval) until native in-memory O0 lands.
use core.math as native_comptime_math
use jet_backend.[X64NativeValue]
use jet_foundation.[MIRFunctionID, TComptimeValue, TComptimeKey, TComptimeKeyField, TComptimeMapEntry, TComptimeField, TComptimeEnumArg, TComptimeReport, TComptimeClosure, Type]

fn jet_driver_native_value_key(value: TComptimeValue) -> TComptimeKey? Never! {
    if value == {
        .Int(number) -> return Val(TComptimeKey.Int{value: number})
        .String(text) -> return Val(TComptimeKey.String{value: text})
        .Bool(flag) -> return Val(TComptimeKey.Bool{value: flag})
        .Char(code) -> return Val(TComptimeKey.Char{value: code})
        .Struct(name, fields) -> {
            keys := [TComptimeKeyField]{}
            loop field in fields {
                key :: jet_driver_native_value_key(field.value) ?? return None
                &keys.push(TComptimeKeyField{name: field.name, key: key})
            }
            if name == "Tuple" -> return Val(TComptimeKey.Tuple{fields: keys})
            return Val(TComptimeKey.Struct{type_name: name, fields: keys})
        }
        .Enum(name, variant, args) -> {
            if args.len() == 0 -> return Val(TComptimeKey.Enum{type_name: name, variant: variant})
        }
        else -> {}
    }
    None
}

// Widen the checked IEEE32 carrier without a decimal round trip. Subnormal
// normalization preserves the exact value; infinities and NaN payloads retain
// their sign and fraction bits in the wider carrier.
fn jet_driver_native_float32_bits(bits: Int) -> Int Never! {
    sign :: (bits.bit_and(2147483648)) << 32
    exponent := (bits >> 23).bit_and(255)
    fraction := bits.bit_and(8388607)
    if exponent == 255 -> return sign.bit_or((2047 << 52)).bit_or((fraction << 29))
    if exponent == 0 {
        if fraction == 0 -> return sign
        exponent = 897
        loop fraction < 8388608 {
            fraction <<= 1
            exponent -= 1
        }
        fraction = fraction.bit_and(8388607)
    } else { exponent += 896 }
    sign.bit_or((exponent << 52)).bit_or((fraction << 29))
}

// Decode each counted native node once. Closure identity resolves against the
// producing snapshot, never the newest program with the same numeric MIR ID.
fn jet_driver_native_value(value: X64NativeValue, host: JetDriverExecutionHost) -> TComptimeValue? {
    kind :: value.kind
    if kind == "Unit" && value.children.len() == 0 -> return Val(TComptimeValue.Unit)
    if kind == "String" -> return Val(TComptimeValue.String{value: value.text})
    if kind == "Int" || kind == "Integer" {
        if kind == "Integer" && value.attributes.len() != 1 -> return None
        text :: if kind == "Int" -> value.text else -> value.attributes[0]
        number :: Int.parse(text) ?? return None
        return Val(TComptimeValue.Int{value: number})
    }
    if kind == "Bool" && value.attributes.len() == 1 && (value.attributes[0] == "0" || value.attributes[0] == "1") -> return Val(TComptimeValue.Bool{value: value.attributes[0] == "1"})
    if kind == "Char" && value.attributes.len() == 1 -> return Val(TComptimeValue.Char{value: Int.parse(value.attributes[0]) ?? return None})
    if kind == "Float" && value.attributes.len() == 2 {
        width :: Int.parse(value.attributes[0]) ?? return None
        bits := Int.parse(value.attributes[1]) ?? return None
        if width != 32 && width != 64 -> return None
        if width == 32 {
            if bits < 0 || bits > 4294967295 -> return None
            bits = jet_driver_native_float32_bits(bits)
        } else if bits < 0 || bits > 18446744073709551615 -> return None
        if bits >= 9223372036854775808 -> bits -= 18446744073709551616
        return Val(TComptimeValue.Float{value: native_comptime_math.from_bits(bits), bits: width})
    }
    if kind == "Absent" && value.attributes.len() == 1 -> return Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: value.attributes[0]}}})
    if kind == "Present" || kind == "Result" {
        if value.children.len() != 1 -> return None
        inner :: jet_driver_native_value(value.children[0], host) ?? return None
        if kind == "Present" || (value.attributes.len() == 1 && value.attributes[0] == "1") -> return Val(TComptimeValue.Present{value: inner})
        if value.attributes.len() != 1 || value.attributes[0] != "0" -> return None
        return Val(TComptimeValue.Failed{report: TComptimeReport.Told{value: inner}})
    }
    if kind == "List" {
        children := [TComptimeValue]{}
        loop child in value.children -> &children.push(jet_driver_native_value(child, host) ?? return None)
        return Val(TComptimeValue.List{values: children})
    }
    if kind == "Map" {
        if value.children.len() % 2 != 0 -> return None
        entries := [TComptimeMapEntry]{}
        loop index in 0..<(value.children.len() /% 2) {
            key_value :: jet_driver_native_value(value.children[2 * index], host) ?? return None
            key :: jet_driver_native_value_key(key_value) ?? return None
            child :: jet_driver_native_value(value.children[2 * index + 1], host) ?? return None
            &entries.push(TComptimeMapEntry{key: key, value: child})
        }
        return Val(TComptimeValue.Map{entries: entries})
    }
    if kind == "Struct" {
        if value.attributes.len() != value.children.len() + 1 -> return None
        fields := [TComptimeField]{}
        loop (index, child) in value.children -> &fields.push(TComptimeField{name: value.attributes[index + 1], value: jet_driver_native_value(child, host) ?? return None})
        return Val(TComptimeValue.Struct{type_name: value.attributes[0], fields: fields})
    }
    if kind == "Enum" {
        if value.attributes.len() != value.children.len() + 3 -> return None
        args := [TComptimeEnumArg]{}
        loop (index, child) in value.children {
            name :: if value.attributes[2] == "named" -> Val(value.attributes[index + 3]) else -> None
            &args.push(TComptimeEnumArg{name: name, value: jet_driver_native_value(child, host) ?? return None})
        }
        return Val(TComptimeValue.Enum{type_name: value.attributes[0], variant: value.attributes[1], args: args})
    }
    if kind == "Closure" {
        if value.attributes.len() != value.children.len() + 2 -> return None
        identity :: Int.parse(value.attributes[1]) ?? return None
        if identity < 0 || identity > 18446744073709551615 -> return None
        function :: MIRFunctionID{value: U64{identity}}
        source :: host.closure_source(value.attributes[0], function) ?? return None
        if source.lambda.captures.len() != value.children.len() -> return None
        captures := [TComptimeValue]{}
        loop (index, capture) in source.lambda.captures {
            if capture.source != value.attributes[index + 2] -> return None
            &captures.push(jet_driver_native_value(value.children[index], host) ?? return None)
        }
        return Val(TComptimeValue.Closure{value: TComptimeClosure{function: function, captures: captures}})
    }
    None
}
