// Invocation-owned adapter for checked fn-build calls. Unrelated Core and
// native operations keep their original adapter and ownership receipts.
use jet_foundation.[MIRCallFallibility, MIRForeign, MIRHandleID, MIRPreludeCall, MIRScopeKind, MIRSelectKind, MIRTaskGroupKind, Span, TComptimeField, TComptimeReport, TComptimeValue]
use jet_eval.[JetEvalMachine, JetEvalHostAdapter, JetEvalHostArgument, JetEvalHostCallTarget, JetEvalHostStaticOperand, JetEvalHostTypeShape, JetEvalHostResult, JetEvalHostOutcome, JetEvalHostValue, JetEvalErrorKind, JetEvalHostFixedBackingStorage, JetEvalHostFixedBackingOperation, JetEvalHostFixedBackingAccessResult, JetEvalNativeCallBinding, JetEvalSharedPhysicalOp, JetEvalRuntimeValue, jet_eval_build_context_host_id, jet_eval_build_session_host_input, jet_eval_build_session_output, jet_eval_build_session_diagnostic, jet_eval_build_graph_value]

use core.crypto as build_input_crypto
use jet_eval.jet_eval_build_failed_value

struct JetDriverBuildAdapter {
    session: BuildSession
    parent: JetEvalHostAdapter
    // The host's raw build-input transport and the build file's canonical
    // directory, which `b.find`, `b.embed` and `b.fetch` paths are relative to.
    inputs: JetDriverBuildInputs?
    base_dir: String
}

fn jet_driver_build_host_result(outcome: JetEvalHostOutcome) -> JetEvalHostResult Never! {
    {transfers: [], callback_transfers: [], fixed_backing_transfers: [], writebacks: [], outcome: outcome}
}
fn jet_driver_build_host_failure(session: BuildSession, span: Span, message: String) -> JetEvalHostResult Never! {
    permit :: session.storage.guard_read()
    error := build_session_diag(permit.value, message)
    error.start = span.start
    error.end = span.end
    jet_driver_build_host_result(.Failure(JetEvalErrorKind.Source, jet_eval_build_session_diagnostic(error)))
}
fn jet_driver_build_context_owned(session: BuildSession, owner: Int) -> Bool Never! {
    permit :: session.storage.guard_read()
    permit.value.id == owner && permit.value.active
}
fn jet_driver_build_impure(machine: JetEvalMachine) -> Bool Never! {
    loop frame in machine.frames {
        loop function in machine.program.functions {
            if function.id.value != frame.function.value -> next
            loop active in frame.scopes {
                loop scope in function.scopes { if scope.id.value == active.value && scope.kind == MIRScopeKind.Impure -> return true }
            }
        }
    }
    false
}
fn jet_driver_build_host_call(session: &BuildSession, inputs: JetDriverBuildInputs?, base_dir: String, machine: &JetEvalMachine, target: JetEvalHostCallTarget, args: [JetEvalHostArgument], span: Span) -[FS.Read]> JetEvalHostResult? {
    if target == .Prelude(row) {
        if row.module_name != "core.host" -> return None
        if row.member == "BuildPlan.graph" {
            if args.len() != 1 -> return Val(jet_driver_build_host_failure(session, span, "graph requires one checked BuildPlan"))
            returned :: jet_eval_build_session_host_input(args[0].host) ?? return Val(jet_driver_build_host_failure(session, span, "graph requires one checked BuildPlan"))
            projected :: build_session_graph(session, returned)
            if projected.diagnostic == .Val(error) -> return Val(jet_driver_build_host_result(.Failure(JetEvalErrorKind.Source, jet_eval_build_session_diagnostic(error))))
            graph :: projected.graph ?? return Val(jet_driver_build_host_failure(session, span, "checked graph projection did not return a graph"))
            return Val(jet_driver_build_host_result(.Value(JetEvalHostValue.Data{value: jet_eval_build_graph_value(graph)})))
        }
        if !row.member.starts_with("BuildContext.") -> return None
        if args.len() == 0 -> return Val(jet_driver_build_host_failure(session, span, "build method lost its context"))
        owner :: jet_eval_build_context_host_id(args[0].host) ?? return Val(jet_driver_build_host_failure(session, span, "build method requires its checked context"))
        if !jet_driver_build_context_owned(session, owner) -> return Val(jet_driver_build_host_failure(session, span, "build context expired"))
        method :: row.member.slice(13, row.member.len())
        values := [BuildSessionValue]{}
        generated := String?{None}
        loop index in 1..<args.len() {
            value :: jet_eval_build_session_host_input(args[index].host) ?? return Val(jet_driver_build_host_failure(session, span, "build method received a non-data argument"))
            if method == "generate" && index == 2 {
                if value == .Text(source) -> generated = Val(source)
                else -> return Val(jet_driver_build_host_failure(session, span, "generated items lost their checked source"))
            } else -> &values.push(value)
        }
        reply := build_session_call(&session, method, values, generated, jet_driver_build_impure(machine), span.start, span.end)
        if reply == .HostRequest(service, request_args) -> reply = jet_driver_build_input_reply(inputs, base_dir, service, request_args, span)
        if reply == {
            .Value(value) -> {
                data := jet_eval_build_session_output(value)
                if row.fallibility != MIRCallFallibility.Infallible -> data = TComptimeValue.Present{value: data}
                return Val(jet_driver_build_host_result(.Value(JetEvalHostValue.Data{value: data})))
            }
            .Failure(error) -> {
                if row.fallibility != MIRCallFallibility.Infallible && jet_eval_build_failed_value(error) == .Val(value) {
                    return Val(jet_driver_build_host_result(.Value(JetEvalHostValue.Data{value: value})))
                }
                return Val(jet_driver_build_host_result(.Failure(JetEvalErrorKind.Source, jet_eval_build_session_diagnostic(error))))
            }
            .HostRequest(method, _) -> return Val(jet_driver_build_host_failure(session, span, "build input service `{method}` is unavailable"))
        }
    }
    None
}

impl JetDriverBuildAdapter.JetEvalHostAdapter {
    fn new_session(self) -[]> JetEvalHostAdapter { JetDriverBuildAdapter{session: self.session, parent: self.parent.new_session(), inputs: self.inputs, base_dir: self.base_dir} }
    fn clone_adapter(self) -[]> JetEvalHostAdapter { JetDriverBuildAdapter{session: self.session, parent: self.parent.clone_adapter(), inputs: self.inputs, base_dir: self.base_dir} }
    fn poll_callbacks(self, machine: &JetEvalMachine) -[FS.Read]> Bool { self.parent.poll_callbacks(&machine) }
    fn drain_callbacks(self, machine: &JetEvalMachine) -[FS.Read]> Bool { self.parent.drain_callbacks(&machine) }
    fn host_call(self, machine: &JetEvalMachine, target: JetEvalHostCallTarget, static_operand: JetEvalHostStaticOperand?, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, arg_shapes: [JetEvalHostTypeShape], span: Span) -[FS.Read]> JetEvalHostResult? {
        session := self.session
        if jet_driver_build_host_call(&session, self.inputs, self.base_dir, &machine, target, args, span) == .Val(result) -> return Val(result)
        self.parent.host_call(&machine, target, static_operand, ^args, result_shape, arg_shapes, span)
    }
    fn foreign_call(self, machine: &JetEvalMachine, row: MIRForeign, args: ^[JetEvalHostArgument], span: Span) -[FS.Read]> JetEvalHostResult? { self.parent.foreign_call(&machine, row, ^args, span) }
    fn handle_call(self, machine: &JetEvalMachine, operation: String, handle: MIRHandleID, raw: Int, span: Span) -[FS.Read]> JetEvalHostResult? { self.parent.handle_call(&machine, operation, handle, raw, span) }
    fn fixed_backing_release(self, machine: &JetEvalMachine, handle: MIRHandleID, raw: Int, lease: Int?, span: Span) -[]> JetEvalHostResult? { self.parent.fixed_backing_release(&machine, handle, raw, lease, span) }
    fn fixed_backing_access(self, machine: &JetEvalMachine, root: JetEvalHostFixedBackingStorage, operation: JetEvalHostFixedBackingOperation, span: Span) -[]> JetEvalHostFixedBackingAccessResult? { self.parent.fixed_backing_access(&machine, root, operation, span) }
    fn physical_binding(self) -[]> JetEvalHostValue { self.parent.physical_binding() }
    fn native_call(self, machine: &JetEvalMachine, binding: JetEvalNativeCallBinding, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -[FS.Read]> JetEvalHostResult? { self.parent.native_call(&machine, binding, ^args, result_shape, span) }
    fn channel_select(self, machine: &JetEvalMachine, row: MIRPreludeCall, kind: MIRSelectKind, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -[]> JetEvalHostResult? { self.parent.channel_select(&machine, row, kind, ^args, result_shape, span) }
    fn task_group(self, machine: &JetEvalMachine, row: MIRPreludeCall, kind: MIRTaskGroupKind, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -[]> JetEvalHostResult? { self.parent.task_group(&machine, row, kind, ^args, result_shape, span) }
    fn shared_call(self, machine: &JetEvalMachine, operation: JetEvalSharedPhysicalOp, row: MIRPreludeCall, map_row: MIRPreludeCall?, shared: JetEvalRuntimeValue, guard: JetEvalRuntimeValue?, condition: JetEvalRuntimeValue?, args: ^[JetEvalHostArgument], result_shape: JetEvalHostTypeShape?, span: Span) -[]> JetEvalHostResult? { self.parent.shared_call(&machine, operation, row, map_row, shared, guard, condition, ^args, result_shape, span) }
}

// D-CTIO1 bounds shared with the Rust reference: one tree file (SHA256.rs
// `MAX_TREE_FILE_BYTES`) and one fetched resource (jet-net `MAX_FETCH_BYTES`).
JET_DRIVER_BUILD_MAX_FILE_BYTES :: 536870912
JET_DRIVER_BUILD_MAX_FETCH_BYTES :: 67108864
// std::io::ErrorKind::NotFound as the reference's error text spells it.
JET_DRIVER_BUILD_NOT_FOUND :: "No such file or directory (os error 2)"

fn jet_driver_build_input_fail(code: String, what: String, why: String, fix: String, span: Span) -> BuildSessionReply Never! {
    .Failure(BuildSessionDiagnostic{code: code, what: what, why: why, fix: fix, start: span.start, end: span.end})
}

fn jet_driver_build_input_text(args: [BuildSessionValue], index: Int) -> String? Never! {
    if index < args.len() && args[index] == .Text(value) -> return Val(value)
    None
}

// The input services `build_session_call` hands back to its host
// (runtime_bridge.rs `eval_program_build_input_method`), answered over the
// host's raw transport. A host without one, and the plugin and legacy
// importer services, keep the request: the caller refuses it.
fn jet_driver_build_input_reply(inputs: JetDriverBuildInputs?, base_dir: String, method: String, args: [BuildSessionValue], span: Span) -[FS.Read]> BuildSessionReply {
    host :: inputs ?? return .HostRequest(method, args)
    if method == {
        "find" -> return jet_driver_build_find(host, base_dir, args, span)
        "embed" -> return jet_driver_build_embed(host, base_dir, args, span)
        "fetch" -> return jet_driver_build_fetch(host, base_dir, args, span)
        else -> {}
    }
    .HostRequest(method, args)
}

// dispatch.rs `split_rel`: the non-empty, non-`.` components.
fn jet_driver_build_split_rel(path: String) -> [String] Never! {
    parts := [String]{}
    loop part in path.split("/") {
        if part != "" && part != "." -> &parts.push(part)
    }
    parts
}

fn jet_driver_build_join(directory: String, name: String) -> String Never! {
    if directory == "" -> return name
    if directory.ends_with("/") -> return "{directory}{name}"
    "{directory}/{name}"
}

// Path::starts_with over components: `path` is `root` or lies beneath it.
fn jet_driver_build_within(path: String, root: String) -> Bool Never! {
    if path == root || root == "/" -> return path.starts_with("/")
    path.starts_with("{root}/")
}

// dispatch.rs `checked_embed_path`: `relative` under `root`, every link
// followed, still inside the real root. `None` when it names nothing.
fn jet_driver_build_checked_path(host: JetDriverBuildInputs, root: String, relative: String) -[FS.Read]> JetDriverBuildPath? String! {
    real_root :: host.resolve(root) ?? return Err(err)
    if !real_root.exists -> return Err(JET_DRIVER_BUILD_NOT_FOUND)
    real :: host.resolve(jet_driver_build_join(real_root.path, relative)) ?? return Err(err)
    if !real.exists -> return Ok(None)
    if !jet_driver_build_within(real.path, real_root.path) -> return Err("embedded path escapes the real source root")
    Ok(Val(real))
}

// dispatch.rs `segment_match_chars` over one pattern segment's characters
// from `pi` and one name's characters from `ti`.
fn jet_driver_build_segment_match(pattern: [String], pi: Int, text: [String], ti: Int) -> Bool Never! {
    if pi >= pattern.len() -> return ti >= text.len()
    head :: pattern[pi]
    if head == "*" -> return jet_driver_build_segment_match(pattern, pi + 1, text, ti) || (ti < text.len() && jet_driver_build_segment_match(pattern, pi, text, ti + 1))
    if head == "?" -> return ti < text.len() && jet_driver_build_segment_match(pattern, pi + 1, text, ti + 1)
    if head == "{{" || head == "[" {
        close :: if head == "{{" -> "}}" else -> "]"
        end := -1
        loop index in pi + 1..<pattern.len() {
            if pattern[index] == close {
                end = index
                break
            }
        }
        if end < 0 -> return ti < text.len() && text[ti] == head && jet_driver_build_segment_match(pattern, pi + 1, text, ti + 1)
        if head == "[" -> return ti < text.len() && jet_driver_build_class(pattern, pi + 1, end, text[ti]) && jet_driver_build_segment_match(pattern, end + 1, text, ti + 1)
        alternative := [String]{}
        loop index in pi + 1..<end + 1 {
            if index < end && pattern[index] != "," {
                &alternative.push(pattern[index])
                next
            }
            candidate := alternative
            loop rest in end + 1..<pattern.len() -> &candidate.push(pattern[rest])
            if jet_driver_build_segment_match(candidate, 0, text, ti) -> return true
            alternative = [String]{}
        }
        return false
    }
    ti < text.len() && text[ti] == head && jet_driver_build_segment_match(pattern, pi + 1, text, ti + 1)
}

// dispatch.rs `class_matches`: `[a-z]` ranges and single members.
fn jet_driver_build_class(pattern: [String], start: Int, end: Int, needle: String) -> Bool Never! {
    index := start
    matched := false
    loop index < end {
        if index + 2 < end && pattern[index + 1] == "-" {
            if pattern[index] <= needle && needle <= pattern[index + 2] -> matched = true
            index += 3
        } else {
            if pattern[index] == needle -> matched = true
            index += 1
        }
    }
    matched
}

fn jet_driver_build_characters(text: String) -> [String] Never! {
    out := [String]{}
    loop character in text.chars() -> &out.push("{character}")
    out
}

// dispatch.rs `glob_segments_match`: `**` spans any number of components.
fn jet_driver_build_glob_match(pattern: [String], pi: Int, path: [String], qi: Int) -> Bool Never! {
    if pi >= pattern.len() -> return qi >= path.len()
    if pattern[pi] == "**" -> return jet_driver_build_glob_match(pattern, pi + 1, path, qi) || (qi < path.len() && jet_driver_build_glob_match(pattern, pi, path, qi + 1))
    qi < path.len() && jet_driver_build_segment_match(jet_driver_build_characters(pattern[pi]), 0, jet_driver_build_characters(path[qi]), 0) && jet_driver_build_glob_match(pattern, pi + 1, path, qi + 1)
}

// dispatch.rs `walk_find`: entries in name order, never through a link.
fn jet_driver_build_walk(host: JetDriverBuildInputs, directory: String, logical: String, pattern: [String], depth: Int, max_depth: Int, out: &[String]) -[FS.Read]> String? {
    entries := host.entries(directory) ?? return Val(err)
    &entries.sort_by((left: JetDriverBuildEntry, right: JetDriverBuildEntry) -> left.name <=> right.name)
    loop entry in entries {
        path :: jet_driver_build_join(logical, entry.name)
        if entry.directory {
            if depth + 1 < max_depth {
                if jet_driver_build_walk(host, jet_driver_build_join(directory, entry.name), path, pattern, depth + 1, max_depth, &out) == .Val(problem) -> return Val(problem)
            }
            next
        }
        if entry.file && jet_driver_build_glob_match(pattern, 0, jet_driver_build_split_rel(path), 0) -> &out.push(path)
    }
    None
}

// dispatch.rs `check_literal_embed_path` for `b.find` (E0957).
fn jet_driver_build_find_path_problem(glob: String, span: Span) -> BuildSessionReply? Never! {
    if glob.starts_with("/") -> return Val(jet_driver_build_input_fail("E0957", "`find` glob must be relative", "an absolute glob reaches outside the project", "use a glob relative to this file's own directory", span))
    loop part in glob.split("/") {
        if part == ".." -> return Val(jet_driver_build_input_fail("E0957", "`find` glob escapes the project with `..`", "`..` could read files outside your project; comptime inputs must stay inside it", "drop the `..` and use a glob under this file's directory", span))
    }
    None
}

// runtime_bridge.rs `b.find` -> dispatch.rs `eval_locked_find`/`find_glob`:
// the sorted relative files the glob matches below the build file's
// directory, each one readable within the tree-file bound.
fn jet_driver_build_find(host: JetDriverBuildInputs, base_dir: String, args: [BuildSessionValue], span: Span) -[FS.Read]> BuildSessionReply {
    if args.len() != 1 -> return jet_driver_build_input_fail("E3502", "build plan is invalid: `b.find` requires exactly one glob", "`fn build` must return one deterministic typed graph whose handles all belong to that build", "fix the named target/action/toolchain/probe and run `jet inspect explain-build` to inspect the graph", span)
    raw :: jet_driver_build_input_text(args, 0) ?? return jet_driver_build_input_fail("E0957", "`find` glob must be a string literal", "a computed glob can't be audited at build time, so the compiler can't tell which file it reads", "pass the glob inline, e.g. `find(\"content/**/*.jet\")`", span)
    glob :: raw.replace("\\", "/")
    if jet_driver_build_find_path_problem(glob, span) == .Val(problem) -> return problem
    walk_what :: "`find` can't walk `{raw}`"
    walk_fix :: "check that every directory matched by the glob can be read"
    segments :: jet_driver_build_split_rel(glob)
    // dispatch.rs `static_glob_prefix`: the leading components with no glob.
    prefix := [String]{}
    loop segment in segments {
        if segment == "**" || segment.contains("*") || segment.contains("?") || segment.contains("{") || segment.contains("[") -> break
        &prefix.push(segment)
    }
    recursive :: segments.contains("**")
    base_root :: jet_driver_build_checked_path(host, base_dir, ".") ?? return jet_driver_build_input_fail("E0955", walk_what, err, walk_fix, span)
    root_dir :: base_root ?? return jet_driver_build_input_fail("E0955", walk_what, JET_DRIVER_BUILD_NOT_FOUND, walk_fix, span)
    logical :: prefix.join("/")
    root := root_dir
    if prefix.len() > 0 {
        found :: jet_driver_build_checked_path(host, root_dir.path, logical) ?? return jet_driver_build_input_fail("E0955", walk_what, err, walk_fix, span)
        root = found ?? return .Value(.List([BuildSessionValue]{}))
    }
    matches := [String]{}
    if root.file {
        if jet_driver_build_glob_match(segments, 0, jet_driver_build_split_rel(logical), 0) -> &matches.push(logical)
    } else {
        max_depth :: if recursive -> 9223372036854775807 else -> segments.len()
        if jet_driver_build_walk(host, root.path, logical, segments, prefix.len(), max_depth, &matches) == .Val(problem) -> return jet_driver_build_input_fail("E0955", walk_what, problem, walk_fix, span)
    }
    &matches.sort()
    values := [BuildSessionValue]{}
    loop relative in matches {
        _ := host.read_rooted(base_dir, relative, JET_DRIVER_BUILD_MAX_FILE_BYTES) ?? return jet_driver_build_input_fail("E0955", "`find` can't open `{relative}`", "{err} (matched while expanding `{raw}`)", "check the path — it is relative to the file's own directory", span)
        &values.push(.Text(relative))
    }
    .Value(.List(values))
}

// runtime_bridge.rs `b.embed` -> dispatch.rs `eval_build_embed`: one locked
// relative UTF-8 file below the build file's directory.
fn jet_driver_build_embed(host: JetDriverBuildInputs, base_dir: String, args: [BuildSessionValue], span: Span) -[FS.Read]> BuildSessionReply {
    relative :: jet_driver_build_input_text(args, 0) ?? return jet_driver_build_input_fail("E0956", "``b.embed` requires a path string` isn't supported by the current evaluator yet", "The canonical TIR evaluator doesn't cover this construct yet", "Report this unsupported construct as a compiler bug", span)
    escapes := args.len() != 1 || relative.starts_with("/")
    loop part in relative.split("/") {
        if part == ".." -> escapes = true
    }
    if escapes -> return jet_driver_build_input_fail("E0957", "`b.embed` path `{relative}` escapes the build root", "locked build inputs must stay beneath the selected source directory", "use a relative path returned by `b.find`, without `..`", span)
    bytes :: host.read_rooted(base_dir, relative, JET_DRIVER_BUILD_MAX_FILE_BYTES) ?? return jet_driver_build_input_fail("E0955", "`b.embed` cannot open `{relative}`", err, "check the locked relative path", span)
    text :: String.from_bytes(bytes) ?? return jet_driver_build_input_fail("E0955", "`b.embed` cannot decode `{relative}` as text", "the embedded file is not valid UTF-8", "embed a UTF-8 text file", span)
    .Value(.Text(text))
}

// jet-net `FetchError::IO`/`Scheme` as eval_net_fetch reports it (E3414).
fn jet_driver_build_fetch_error(url: String, detail: String, span: Span) -> BuildSessionReply Never! {
    jet_driver_build_input_fail("E3414", "fetch failed: {detail}", "could not retrieve `{url}`", "check the URL is reachable and the network is available; use `file://` for a local path inside the compile-time source directory", span)
}

// runtime_bridge.rs `b.fetch` -> dispatch.rs `eval_net_fetch` over jet-net
// `fetch_in_root`: a sha256-pinned UTF-8 resource. A `file://` URL reads a
// regular, unshared file inside the build file's directory; this host
// transport performs no network fetch, so an `http(s)://` URL is refused.
fn jet_driver_build_fetch(host: JetDriverBuildInputs, base_dir: String, args: [BuildSessionValue], span: Span) -[FS.Read]> BuildSessionReply {
    url :: jet_driver_build_input_text(args, 0) ?? return jet_driver_build_input_fail("E3414", "fetch: first argument must be a string URL", "`core.net.fetch` expects a string URL as its first argument", "pass a string literal: `net.fetch('https://example.com/data.txt', sha256: '…')`", span)
    expected :: jet_driver_build_input_text(args, 1) ?? return jet_driver_build_input_fail("E3414", "fetch: `sha256:` argument missing or not a string", "`core.net.fetch` requires a `sha256:` labelled argument for content verification", "add `sha256: '<64-hex-chars>'` as the second argument", span)
    if url.starts_with("http://") || url.starts_with("https://") -> return .HostRequest("fetch", args)
    if !url.starts_with("file://") {
        scheme :: url.split("://").to_list()[0]
        return jet_driver_build_fetch_error(url, "unsupported URL scheme `{scheme}`; expected `file://`, `http://`, or `https://`", span)
    }
    raw :: url.slice(7..<url.len())
    path := raw
    if raw != "/dev/null" {
        root :: host.resolve(base_dir) ?? return jet_driver_build_fetch_error(url, err, span)
        if !root.exists -> return jet_driver_build_fetch_error(url, JET_DRIVER_BUILD_NOT_FOUND, span)
        if root.file || root.path != base_dir -> return jet_driver_build_fetch_error(url, "compile-time source directory must be a real directory", span)
        requested :: if raw.starts_with("/") -> raw else -> jet_driver_build_join(root.path, raw)
        target :: host.resolve(requested) ?? return jet_driver_build_fetch_error(url, err, span)
        if !target.exists -> return jet_driver_build_fetch_error(url, JET_DRIVER_BUILD_NOT_FOUND, span)
        if !jet_driver_build_within(target.path, root.path) -> return jet_driver_build_fetch_error(url, "file URL resolves outside the compile-time source directory", span)
        if !target.file || target.links != 1 -> return jet_driver_build_fetch_error(url, "file URL must name a regular, unshared file", span)
        path = target.path
    }
    bytes :: host.read(path, JET_DRIVER_BUILD_MAX_FETCH_BYTES) ?? return jet_driver_build_fetch_error(url, err, span)
    actual :: build_input_crypto.sha256(bytes).hex()
    if actual != expected -> return jet_driver_build_input_fail("E3413", "fetch: sha256 mismatch for `{url}`", "expected `{expected}` but content hashes to `{actual}`", "update the `sha256:` pin to match the content, or verify the URL is correct", span)
    text :: String.from_bytes(bytes) ?? return jet_driver_build_input_fail("E3414", "fetch: content at `{url}` is not valid UTF-8", "the downloaded bytes could not be decoded as UTF-8 text", "binary content is not supported by comptime fetch; use `embed_bytes` for binary data", span)
    .Value(.Text(text))
}
