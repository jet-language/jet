// Tier-1 comptime inputs (`embed_file`, `embed_bytes`, `find`): the driver's
// answer to the evaluator's comptime input route. Sema has already checked a
// literal path (relative, no `..`); a path or glob the comptime code computed
// meets the same law here (sema_comptime_input_value_problem) before any read.
// Reads go through the host's raw build-input transport, rooted at the
// directory of the file doing the embedding, with the same no-follow read,
// tree-file bound and glob walk as `b.embed` / `b.find` (`eval_build_time_io`,
// one implementation of the path law). Each file read is recorded with its
// SHA-256 for the comptime input lock, and each `find` with the SHA-256 of
// its sorted membership, so that a file added to or removed from a glob, an
// empty one too, invalidates what the compile made of it. A `toolchain:` input
// is rooted at the toolchain tree the compile takes Core from instead, and only
// the toolchain's own packages may read it (jet_driver_comptime_toolchain_input).
// A Core file's inputs are files beside it in the toolchain's Core tree, read by
// the host's Core reader (JetDriverCoreComptimeInputs).
use {
    jet_foundation.[
        Diagnostic,
        BodyExpr,
        body_node,
        Span,
        TComptimeValue,
        diagnostic_from_registry,
        JET_COMPTIME_TOOLCHAIN_PREFIX,
    ]
    jet_eval.[JetEvalComptimeInputAdapter, JetEvalComptimeInputError]
    jet_build_session.[BuildSessionReply, BuildSessionValue]
    jet_sema.[sema_comptime_input_named, sema_comptime_input_value_problem]
    comptime_inputs_crypto: core.crypto
}

// One locked comptime input: its name (`toolchain:` kept), relative to the
// embedding file's directory, and `file`, that directory joined with it. A
// file read has the SHA-256 of its bytes and no `glob`; a `find` has its
// `glob` (relative to the directory it walks) and the SHA-256 of its sorted
// membership (jet_driver_comptime_glob_digest).
JetDriverComptimeInputRecord: struct {
    path: String
    file: String
    sha256: String
    glob: String{""}
}

JetDriverComptimeInputLog: struct {
    records: [JetDriverComptimeInputRecord]
}

JetDriverComptimeInputs: struct {
    inputs: JetDriverSharedBuildInputs
    base_dir: String
    log: Shared<JetDriverComptimeInputLog>?
    // The physical path of the file doing the embedding, and the toolchain
    // tree its `toolchain:` inputs read (None: the compile has none).
    file: String
    toolchain: Shared<JetDriverToolchainTree>?

    impl JetEvalComptimeInputAdapter {
        clone_input_adapter: fn(self) -[]> JetEvalComptimeInputAdapter {
            // copy: the evaluator forks the adapter for each machine; the forks share the input
            // transport, the one input log and the one toolchain tree.
            JetDriverComptimeInputs{inputs: self.inputs.copy(), base_dir: self.base_dir.copy(), log: self.log.copy(), file: self.file.copy(), toolchain: self.toolchain.copy()}
        }
        comptime_input: fn(self, builtin: String, path: String, span: Span) -[FS.Read]> TComptimeValue JetEvalComptimeInputError! {
            named: sema_comptime_input_named(path)
            if sema_comptime_input_value_problem(builtin, named, span) == .Val(problem) -> return Err(JetEvalComptimeInputError{diagnostic: problem})
            if named.starts_with(JET_COMPTIME_TOOLCHAIN_PREFIX) -> return jet_driver_comptime_toolchain_input(self, builtin, named.removeprefix(JET_COMPTIME_TOOLCHAIN_PREFIX), span)
            if builtin == "find" -> return jet_driver_comptime_find(self, self.base_dir, named, "", span)
            bytes: self.inputs.read_rooted(self.base_dir, named, JET_DRIVER_BUILD_MAX_FILE_BYTES) ?? return Err(jet_driver_comptime_input_fail("`{builtin}` can't open `{named}`", "{err.message} (looked next to the file doing the embedding)", "check the path — it is relative to the file's own directory", span))
            jet_driver_comptime_input_record(self.log, self.base_dir, "", named, bytes)
            jet_driver_comptime_input_value(builtin, named, bytes, span)
        }
    }
}

// A Core file's comptime inputs: files in its own directory of the
// toolchain's Core tree, read by the reader that reads the file's text
// (`text`, the Core row's shared cell). Core is part of the compiler, so the
// program's comptime input lock doesn't record these reads.
JetDriverCoreComptimeInputs: struct {
    text: Shared<JetDriverCoreText>
    base_dir: String

    impl JetEvalComptimeInputAdapter {
        clone_input_adapter: fn(self) -[]> JetEvalComptimeInputAdapter {
            // copy: the forks share the Core row's text cell and so its reader.
            JetDriverCoreComptimeInputs{text: self.text.copy(), base_dir: self.base_dir.copy()}
        }
        comptime_input: fn(self, builtin: String, path: String, span: Span) -[FS.Read]> TComptimeValue JetEvalComptimeInputError! {
            named: sema_comptime_input_named(path)
            if sema_comptime_input_value_problem(builtin, named, span) == .Val(problem) -> return Err(JetEvalComptimeInputError{diagnostic: problem})
            if named.starts_with(JET_COMPTIME_TOOLCHAIN_PREFIX) -> return Err(jet_driver_comptime_toolchain_fail("`{builtin}` can't read `{named}` from Core", "a Core file is part of the toolchain tree and embeds its assets beside it", "name the asset beside the Core file, `{builtin}(\"{named.removeprefix(JET_COMPTIME_TOOLCHAIN_PREFIX)}\")`", span))
            if builtin == "find" -> return Err(jet_driver_comptime_input_fail("`find` can't walk `{named}` in Core", "a Core file embeds each of its assets by name", "name each asset with `embed_bytes(\"path\")`", span))
            permit: self.text.guard_read()
            reader: permit.value.reader ?? return Err(JetEvalComptimeInputError{diagnostic: diagnostic_from_registry("E0003", Val(span), "a Core comptime input lost its reader", "the driver reads a Core file's inputs with the reader of its row", "report this compiler bug")})
            bytes: reader.read_bytes("{self.base_dir}/{named}") ?? return Err(jet_driver_comptime_input_fail("`{builtin}` can't open `{named}`", "{err.message} (looked next to the file doing the embedding)", "check the path — it is relative to the file's own directory", span))
            jet_driver_comptime_input_value(builtin, named, bytes, span)
        }
    }
}

jet_driver_comptime_input_fail: fn(what: String, why: String, fix: String, span: Span) -> JetEvalComptimeInputError Never! {
    JetEvalComptimeInputError{diagnostic: diagnostic_from_registry("E0955", Val(span), what, why, fix)}
}

// One read's record: its name (`prefix`, `toolchain:` for a toolchain read,
// then `path`), the file beneath `base_dir` and its SHA-256.
jet_driver_comptime_input_record: fn(recorder: Shared<JetDriverComptimeInputLog>?, base_dir: String, prefix: String, path: String, bytes: [U8]) Never! {
    log: recorder ?? return
    file: if base_dir == "" -> path.copy() else -> "{base_dir}/{path}"
    permit: log.guard_edit()
    permit.value.records.push(JetDriverComptimeInputRecord{path: "{prefix}{path}", file: file, sha256: comptime_inputs_crypto.sha256(bytes).hex()})
}

// Whether `bytes` are still the bytes the compile read for `record`, a file
// read: a rebuild's test of a comptime input it watches (JetCli `jet dev`).
jet_driver_comptime_input_unchanged: fn(record: JetDriverComptimeInputRecord, bytes: [U8]) -> Bool Never! {
    comptime_inputs_crypto.sha256(bytes).hex() == record.sha256
}

// The SHA-256 of a `find`'s membership: its sorted relative matches, one per
// line. An empty match has the digest of no bytes.
jet_driver_comptime_members_digest: fn(members: [String]) -> String Never! {
    comptime_inputs_crypto.sha256(members.join("\n").bytes()).hex()
}

// The membership digest `glob` has beneath `base_dir` now, by the walk `find`
// uses; None when the walk fails.
jet_driver_comptime_glob_digest: fn(inputs: JetDriverSharedBuildInputs, base_dir: String, glob: String) -[FS.Read]> String? {
    reply: jet_driver_build_find(inputs, base_dir, [BuildSessionValue]{BuildSessionValue.Text{value: glob}}, Span{start: 0, end: 0})
    members: jet_driver_comptime_find_members(reply) ?? return None
    Val(jet_driver_comptime_members_digest(members))
}

// The membership digest the `find` `record` names has now: the record's
// `sha256` while the glob matches the files it matched. A rebuild's test and
// stamp of a glob it watches (JetCli `jet dev`).
jet_driver_comptime_glob_membership: fn(inputs: JetDriverSharedBuildInputs, record: JetDriverComptimeInputRecord) -[FS.Read]> String? {
    jet_driver_comptime_glob_digest(inputs, record.file.removesuffix("/{record.glob}"), record.glob)
}

jet_driver_comptime_toolchain_fail: fn(what: String, why: String, fix: String, span: Span) -> JetEvalComptimeInputError Never! {
    JetEvalComptimeInputError{diagnostic: diagnostic_from_registry("E0945", Val(span), what, why, fix)}
}

// A `toolchain:` input (`relative` after the prefix): read beneath the
// toolchain tree's root with the same no-follow read and glob walk as an
// input beside the file, and recorded under its `toolchain:` name. There is
// no built-in copy to fall back to: a compile without a toolchain tree, and a
// file outside the toolchain's own packages (JetDriverToolchainTree), refuse
// with E0945.
jet_driver_comptime_toolchain_input: fn(adapter: JetDriverComptimeInputs, builtin: String, relative: String, span: Span) -[FS.Read]> TComptimeValue JetEvalComptimeInputError! {
    named: "{JET_COMPTIME_TOOLCHAIN_PREFIX}{relative}"
    tree: adapter.toolchain ?? return Err(jet_driver_comptime_toolchain_fail("`{builtin}` can't read `{named}`: this compile has no toolchain tree", "jet compiles against its built-in Core here, and a `toolchain:` input reads only the tree Core comes from; there is no built-in copy of it", "set `JET_TOOLCHAIN_ROOT` to the Jet toolchain source tree, the directory that holds `Core/`", span))
    root: jet_driver_toolchain_admits(tree, adapter.file) ?? return Err(jet_driver_comptime_toolchain_fail("`{builtin}` reads `{named}` outside the toolchain's packages", "this file is in no package of the toolchain tree; only the compiler workspace's members and the packages they depend on inside that tree read it", "name the file beside this one, `{builtin}(\"{relative}\")`, and keep it in this package", span))
    if builtin == "find" -> return jet_driver_comptime_find(adapter, root, relative, JET_COMPTIME_TOOLCHAIN_PREFIX, span)
    bytes: adapter.inputs.read_rooted(root, relative, JET_DRIVER_BUILD_MAX_FILE_BYTES) ?? return Err(jet_driver_comptime_input_fail("`{builtin}` can't open `{named}`", "{err.message} (looked in the toolchain tree `{root}`)", "check the path — it is relative to the toolchain tree", span))
    jet_driver_comptime_input_record(adapter.log, root, JET_COMPTIME_TOOLCHAIN_PREFIX, relative, bytes)
    jet_driver_comptime_input_value(builtin, named, bytes, span)
}

// The tree's root when `file` (a physical path) is in one of the toolchain's
// own packages (its nearest package directory is one of them), naming them on
// first use; else None.
jet_driver_toolchain_admits: fn(tree: Shared<JetDriverToolchainTree>, file: String) -[FS.Read]> String? {
    permit: tree.guard_edit()
    root: permit.value.root.copy()
    if !file.starts_with("{root}/") -> return None
    package: permit.value.reader.package_of(root, file) ?? return None
    if permit.value.packages == None -> permit.value.packages = Val(permit.value.reader.packages(root))
    if permit.value.packages == .Val(packages) {
        if packages.contains(package) -> return Val(root)
    }
    None
}

// The value `builtin` makes of an input's bytes: the bytes for `embed_bytes`,
// their UTF-8 text for `embed_file`.
jet_driver_comptime_input_value: fn(builtin: String, path: String, bytes: [U8], span: Span) -> TComptimeValue JetEvalComptimeInputError! {
    if builtin == "embed_bytes" {
        return Ok(TComptimeValue.Bytes{value: bytes})
    }
    text: String.from_bytes(bytes) ?? return Err(jet_driver_comptime_input_fail("`{builtin}` can't read `{path}` as text", "the file isn't valid UTF-8; `{builtin}` returns a String", "embed it with `embed_bytes(\"path\")` instead — it returns raw `[U8]`", span))
    Ok(TComptimeValue.String{value: text})
}

// The matches of a `b.find` walk's reply; None for a failure.
jet_driver_comptime_find_members: fn(reply: BuildSessionReply) -> [String]? Never! {
    found := [String]{}
    if reply == {
        .Value(value) -> {
            if value == .List(values) {
                loop item in values {
                    if item == .Text(relative) -> found.push(relative.copy())
                }
            }
        }
        .Failure(_) | .HostRequest(_, _) -> return None
    }
    Val(found)
}

// `eval_locked_find`: the sorted files beneath `base_dir` the glob matches,
// relative to it, each read (and recorded under `prefix`) within the
// tree-file bound, and the glob recorded with its membership.
jet_driver_comptime_find: fn(adapter: JetDriverComptimeInputs, base_dir: String, glob: String, prefix: String, span: Span) -[FS.Read]> TComptimeValue JetEvalComptimeInputError! {
    reply: jet_driver_build_find(adapter.inputs, base_dir, [BuildSessionValue]{BuildSessionValue.Text{value: glob}}, span)
    if reply == {
        .Failure(error) -> return Err(JetEvalComptimeInputError{diagnostic: diagnostic_from_registry(error.code, Val(span), error.what, error.why, error.fix)})
        .HostRequest(_, _) -> return Err(jet_driver_comptime_input_fail("`find` can't walk `{prefix}{glob}`", "the comptime input host is unavailable", "build the program with `jet build` or `jet run`", span))
        .Value(_) -> {}
    }
    found: jet_driver_comptime_find_members(reply) ?? [String]{}
    strings := [TComptimeValue]{}
    loop relative in found {
        bytes: adapter.inputs.read_rooted(base_dir, relative, JET_DRIVER_BUILD_MAX_FILE_BYTES) ?? return Err(jet_driver_comptime_input_fail("`find` can't open `{prefix}{relative}`", "{err.message} (matched while expanding `{prefix}{glob}`)", "check the glob — it is relative to the directory it walks", span))
        jet_driver_comptime_input_record(adapter.log, base_dir, prefix, relative, bytes)
        strings.push(TComptimeValue.String{value: relative.copy()})
    }
    if adapter.log == .Val(log) {
        permit: log.guard_edit()
        permit.value.records.push(JetDriverComptimeInputRecord{path: "{prefix}{glob}", file: "{base_dir}/{glob}", sha256: jet_driver_comptime_members_digest(found), glob: glob.copy()})
    }
    Ok(TComptimeValue.List{values: strings})
}

// The comptime input host for an item in `source_file` (its display path).
// A program file's is rooted at that file's physical directory, over the
// request's build-input transport; a request without one (a host that reads
// no files) has no comptime input host. A Core file's is its own directory in
// the toolchain's Core tree (jet_driver_core_comptime_inputs).
jet_driver_comptime_inputs_for: fn(request: JetDriverCompileRequest, source_file: String) -> JetEvalComptimeInputAdapter? {
    if source_file.starts_with("{JET_DRIVER_CORE_SOURCE_ROOT}/") -> return jet_driver_core_comptime_inputs(request.core_sources, source_file)
    inputs: request.build_inputs ?? return None
    physical: jet_driver_physical_path(jet_driver_entry_root_path(request.authorized_sources), source_file)
    // copy: the adapter shares the request's transport handle; the request keeps its own.
    Val(JetDriverComptimeInputs{inputs: inputs.copy(), base_dir: jet_driver_parent_path(physical), log: request.comptime_input_log.copy(), file: physical, toolchain: request.toolchain_tree.copy()})
}

// The comptime input host of the Core file `source_file` names: the directory
// of its row's file, read by its row's reader. A host that embeds a Core row's
// text has no file to read beside it, so that row has no comptime input host.
jet_driver_core_comptime_inputs: fn(core_sources: [JetDriverCoreSource], source_file: String) -> JetEvalComptimeInputAdapter? {
    relative: source_file.removeprefix("{JET_DRIVER_CORE_SOURCE_ROOT}/")
    loop row in core_sources {
        if row.path != relative -> next
        permit: row.text.guard_read()
        if permit.value.reader == None -> return None
        // copy: the adapter shares the row's text cell; the row keeps its own handle.
        return Val(JetDriverCoreComptimeInputs{text: row.text.copy(), base_dir: jet_driver_parent_path(permit.value.file)})
    }
    None
}

// Whether a checked comptime value is exactly one comptime input.
jet_driver_comptime_input_expression: fn(expression: BodyExpr) -> Bool Never! {
    if body_node(expression.tree, expression.root).kind == .HostCall(call) {
        if call == .ComptimeInput(_, _) -> return true
    }
    false
}

// The builtin and literal path of a checked comptime value that is exactly
// one comptime input with a literal path, which the driver reads with no
// evaluation; None for any other value, a computed path among them.
jet_driver_comptime_literal_input: fn(expression: BodyExpr) -> JetDriverComptimeLiteralInput? Never! {
    node: body_node(expression.tree, expression.root)
    if node.kind == .HostCall(call) {
        if call == .ComptimeInput(builtin, path) {
            if body_node(expression.tree, path).kind == .StrLit(parts) {
                if parts.len() == 1 && parts[0] == .Literal(text) -> return Val(JetDriverComptimeLiteralInput{builtin: builtin, path: text, span: node.span})
            }
        }
    }
    None
}

JetDriverComptimeLiteralInput: struct {
    builtin: String
    path: String
    span: Span
}

// Reads the literal comptime input `input` names for an item in `source_file`.
jet_driver_comptime_read_input: fn(request: JetDriverCompileRequest, source_file: String, input: JetDriverComptimeLiteralInput) -[FS.Read]> TComptimeValue JetEvalComptimeInputError! {
    adapter: jet_driver_comptime_inputs_for(request, source_file) ?? return Err(JetEvalComptimeInputError{diagnostic: diagnostic_from_registry("E0956", Val(input.span), "`{input.builtin}` can't read files here", "this compile has no comptime input host, so it can't read `{input.path}`", "build the program with `jet build` or `jet run`, which read comptime inputs")})
    adapter.comptime_input(input.builtin, input.path, input.span)
}
