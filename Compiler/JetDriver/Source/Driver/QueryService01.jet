// Rust: crates/jet-driver/src/QueryService.rs:516
// Preparation input: overlays win; only .jet external sources join the sorted worklist.
// Native reads happen when sealing snapshot authority, not by bypassing it in the resident service.
pub fn jet_driver_query_frontend_sources(snapshot: JetDriverQuerySnapshot, overlays: [compiler_driver_os_path.OsPath:String], files: [compiler_driver_os_path.OsPath]) -> [(compiler_driver_os_path.OsPath, String)] {
    sources := ~overlays
    // GATE #4499: exact native OsPath map keys, never lossy display keys.
    authorized := [compiler_driver_os_path.OsPath:String]{}
    loop root in snapshot.request.authorized_sources.roots {
        loop file in root.files { authorized[file.path] = file.source }
    }
    loop path in files {
        if sources.has_key(path) || compiler_driver_os_path.extension(path) != Val("jet") -> next
        if authorized.get(path) == .Val(source) -> sources[path] = source
    }
    paths := sources.keys().to_list()
    &paths.sort()
    loop path in paths -> (path, sources[path])
}

