// `core.compiler.manifest/package/lock/profiles` in compile-time code
// (D-PACKAGE-MODEL1=A, `read_manifest`/`read_package`/`read_lock`/
// `read_profiles`): read-only package-model views of the compile's pinned
// package root. Every file is read through the package model's no-follow
// authority resolver below that root; the views are the package model's own
// public projections (PackageViews.jet). A failure is a `CompilerPackageError`
// {code, message, file, cause}, never a diagnostic: the caller decides.
use {
    jet_foundation.[Diagnostic, TComptimeField, TComptimeReport, TComptimeValue, diagnostic_from_registry]
    jet_eval.[
        jet_eval_compiler_services_int,
        jet_eval_compiler_services_option_string,
        jet_eval_compiler_services_string,
        jet_eval_compiler_services_string_values,
    ]
    jet_pkg_model.[
        AuthorityError,
        AuthorityResolver,
        BuildProfileView,
        CheckedFile,
        DependencyView,
        InlinePackageBlock,
        LockedPackageView,
        ManifestView,
        OutputView,
        PackageFacts,
        PackageParseError,
        PackageTargetView,
        PackageView,
        ProfileSetView,
        ProfileView,
        TargetProfileView,
        WorkspaceDeclarationCache,
        pkg_extract_inline_package,
        pkg_load_compose_and_validate,
        pkg_lock_parse,
        pkg_lock_view_from_lock,
        pkg_manifest_parse_diagnostic,
        pkg_manifest_view_from_facts,
        pkg_package_facts_for_root,
        pkg_package_view_from_facts,
    ]
    jet_env_model.[EnvModelEvalError, PackageProfileSpec, SourceLoader, envmodel_evaluate_env_with_source_loader]
    jetpack_foundation.[DEFAULT_ENTRY_FILE, ENV_FILE, FILE_EXT, PACKAGE_FILE, UNIFIED_LOCK_FILE]
}

#Error
struct JetDriverPackageReadError {
    code: String
    file: String
    message: String
    cause: String
}

fn jet_driver_package_read_error(file: String, message: String, cause: String) -> JetDriverPackageReadError Never! {
    JetDriverPackageReadError{code: "E0956", file: file, message: message, cause: cause}
}

// `authority_reason`: the cause text of an authority failure.
fn jet_driver_package_authority_reason(cause: AuthorityError) -> String Never! {
    if cause == {
        .Missing(_, why) -> "authority input is missing ({why}); restore the required metadata and try again"
        .ManifestParse(_, _) -> "package metadata is malformed; fix the metadata and try again"
        .IO(_, operation, _) -> "couldn't {operation} authority metadata; restore access and try again"
        .Symlink(_) -> "authority input is a symlink; replace it with the expected file or directory"
        .WrongKind(_, expected, actual) -> "authority input is a {actual}, but the operation requires a {expected}"
        .Escapes(_) -> "authority path escapes its root; use a relative path below the authority root"
        .WorkspaceAmbiguous(_) -> "workspace authority is declared in multiple files; keep one authority source"
        .WorkspaceNoModule -> "the authority source has no workspace module; declare the workspace module"
        .NestedMembers(_, _) -> "a member Package cannot declare another members list; keep membership at one level"
        .Invalid(_, _) -> "authority metadata is invalid; fix the metadata fields and try again"
        .NotText(_, detail) -> "authority metadata is not UTF-8 text ({detail}); save it as UTF-8 and try again"
        .Changed(_) -> "authority input changed during resolution; restore it and retry"
        .Unsupported(_) -> "authority resolution is unavailable on this platform"
    }
}

fn jet_driver_package_authority_error(file: String, message: String, cause: AuthorityError) -> JetDriverPackageReadError Never! {
    jet_driver_package_read_error(file, message, "{cause.diagnostic().code}: {jet_driver_package_authority_reason(cause)}")
}

// `authority_diagnostic`: an authority failure as the profile evaluator's
// error.
fn jet_driver_package_authority_diagnostic(cause: AuthorityError) -> EnvModelEvalError Never! {
    EnvModelEvalError{diagnostic: diagnostic_from_registry(cause.diagnostic().code, None, "authority input is unavailable", jet_driver_package_authority_reason(cause), "restore the authority input and retry the operation")}
}

fn jet_driver_package_diagnostic_cause(diagnostic: Diagnostic) -> String Never! {
    if diagnostic.detail == .Val(detail) -> return "{diagnostic.code}: {diagnostic.what}; {detail}"
    "{diagnostic.code}: {diagnostic.what}"
}

fn jet_driver_package_inline_parse_error(error: PackageParseError) -> JetDriverPackageReadError Never! {
    jet_driver_package_read_error(PACKAGE_FILE, "could not read the inline package", jet_driver_package_diagnostic_cause(pkg_manifest_parse_diagnostic(PACKAGE_FILE, error)))
}

// A leading inline `package { … }` carrier, its block, and its source.
struct JetDriverInlinePackageCarrier {
    file: CheckedFile
    block: InlinePackageBlock
    source: String
}

// `checked_inline_package`: the first entry candidate that carries an inline
// Package.
fn jet_driver_package_inline_carrier(resolver: AuthorityResolver) -[FS, Env]> JetDriverInlinePackageCarrier? JetDriverPackageReadError! {
    candidates :: [String]{DEFAULT_ENTRY_FILE, "src/{DEFAULT_ENTRY_FILE}"}
    loop relative in candidates {
        file := CheckedFile?{None}
        if resolver.checked_file(relative) == {
            .Ok(found) -> file = Val(found)
            .Err(error) -> {
                if error.is_missing() -> next
                return Err(jet_driver_package_authority_error(PACKAGE_FILE, "could not read the inline package carrier", error))
            }
        }
        checked :: file ?? next
        source :: checked.text() ?? return Err(jet_driver_package_authority_error(PACKAGE_FILE, "could not decode the inline package carrier", err))
        block := InlinePackageBlock?{None}
        if pkg_extract_inline_package(source) == {
            .Ok(found) -> block = found
            .Err(error) -> return Err(jet_driver_package_read_error(PACKAGE_FILE, "could not read the inline package", "{error.diagnostic().code}: inline Package carrier is malformed; fix the leading package block and try again"))
        }
        resolver.revalidate_file(checked) ?? return Err(jet_driver_package_authority_error(PACKAGE_FILE, "the inline package carrier changed while it was being read", err))
        if block == .Val(inline) -> return Ok(Val(JetDriverInlinePackageCarrier{file: checked, block: inline, source: source}))
    }
    Ok(None)
}

fn jet_driver_package_open(file: String, root: String) -[FS, Env]> AuthorityResolver JetDriverPackageReadError! {
    resolver :: AuthorityResolver.open(root) ?? return Err(jet_driver_package_authority_error(file, "could not open the pinned package root", err))
    Ok(resolver)
}

// `read_manifest`: the uncomposed declaration.
fn jet_driver_package_read_manifest(root: String) -[FS, Env]> TComptimeValue JetDriverPackageReadError! {
    resolver :: jet_driver_package_open(PACKAGE_FILE, root)
    if resolver.checked_manifest(".") == {
        .Ok(manifest) -> Ok(jet_driver_package_manifest_value(pkg_manifest_view_from_facts(manifest.facts)))
        .Err(cause) -> {
            if !cause.is_missing() -> return Err(jet_driver_package_authority_error(PACKAGE_FILE, "could not read the package manifest", cause))
            carrier :: jet_driver_package_inline_carrier(resolver) ?? return Err(jet_driver_package_read_error(PACKAGE_FILE, "could not read the package manifest", "no package manifest or inline Package carrier was found"))
            facts :: PackageFacts.parse_uncomposed(carrier.block.body(carrier.source), carrier.file.path) ?? return Err(jet_driver_package_inline_parse_error(err))
            Ok(jet_driver_package_manifest_value(pkg_manifest_view_from_facts(facts)))
        }
    }
}

// `read_package`: the composed package facts.
fn jet_driver_package_read_package(root: String) -[FS, Env]> TComptimeValue JetDriverPackageReadError! {
    resolver :: jet_driver_package_open(PACKAGE_FILE, root)
    if resolver.checked_root_package() == {
        .Ok(package) -> Ok(jet_driver_package_package_value(pkg_package_view_from_facts(package.facts)))
        .Err(cause) -> {
            if !cause.is_missing() -> return Err(jet_driver_package_authority_error(PACKAGE_FILE, "could not compose the package facts", cause))
            carrier :: jet_driver_package_inline_carrier(resolver) ?? return Err(jet_driver_package_read_error(PACKAGE_FILE, "could not compose the package facts", "no package manifest or inline Package carrier was found"))
            facts := PackageFacts.parse_uncomposed(carrier.block.body(carrier.source), carrier.file.path) ?? return Err(jet_driver_package_inline_parse_error(err))
            // Configs, guarantees, defaults and members, as the loader composes them.
            if pkg_load_compose_and_validate(&facts, resolver) == .Err(error) {
                return Err(jet_driver_package_authority_error(PACKAGE_FILE, "could not compose the inline package facts", AuthorityError.Invalid{path: carrier.file.path, detail: error.message()}))
            }
            Ok(jet_driver_package_package_value(pkg_package_view_from_facts(facts)))
        }
    }
}

// `read_lock`: the parsed `.jet/lock`.
fn jet_driver_package_read_lock(root: String) -[FS, Env]> TComptimeValue JetDriverPackageReadError! {
    resolver :: jet_driver_package_open(UNIFIED_LOCK_FILE, root)
    file :: resolver.checked_file(UNIFIED_LOCK_FILE) ?? return Err(jet_driver_package_authority_error(UNIFIED_LOCK_FILE, "could not read the package lock", err))
    text :: file.text() ?? return Err(jet_driver_package_authority_error(UNIFIED_LOCK_FILE, "could not decode the package lock", err))
    lock :: pkg_lock_parse(text) ?? return Err(jet_driver_package_read_error(UNIFIED_LOCK_FILE, "could not parse the package lock", err.message()))
    resolver.revalidate_file(file) ?? return Err(jet_driver_package_authority_error(UNIFIED_LOCK_FILE, "the package lock changed while it was being read", err))
    view :: pkg_lock_view_from_lock(lock)
    packages := [TComptimeValue]{}
    loop package in view.packages -> &packages.push(jet_driver_package_locked_value(package))
    Ok(TComptimeValue.Struct{type_name: "CompilerLock", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(view.schema_version)},
        TComptimeField{name: "file", value: jet_eval_compiler_services_string(view.file)},
        TComptimeField{name: "version", value: jet_eval_compiler_services_int(view.version)},
        TComptimeField{name: "root_dependencies", value: jet_eval_compiler_services_string_values(view.root_dependencies)},
        TComptimeField{name: "packages", value: TComptimeValue.List{values: packages}},
    }})
}

// `PackageSourceLoader`: the profile evaluator's files, each read through the
// pinned root's authority and revalidated after evaluation.
struct JetDriverPackageSourceLoader {
    resolver: AuthorityResolver
    checked_inputs: [CheckedFile]
    last_file: String
}

impl JetDriverPackageSourceLoader.SourceLoader {
    fn read_file(&self, relative: String) -[FS, Env]> String EnvModelEvalError! {
        self.last_file = relative
        file :: self.resolver.checked_file(relative) ?? return Err(jet_driver_package_authority_diagnostic(err))
        text :: file.text() ?? return Err(jet_driver_package_authority_diagnostic(err))
        &self.checked_inputs.push(file)
        Ok(text)
    }

    fn list_jet_files(&self, relative: String) -[FS, Env]> [String] EnvModelEvalError! {
        self.last_file = relative
        files :: self.resolver.discover_files(relative, Val(FILE_EXT)) ?? return Err(jet_driver_package_authority_diagnostic(err))
        found := [String]{}
        loop file in ^files {
            &found.push(file.relative)
            &self.checked_inputs.push(file)
        }
        Ok(found)
    }

    fn package_facts(&self) -[FS, Env]> PackageFacts? EnvModelEvalError! {
        self.last_file = PACKAGE_FILE
        if self.resolver.checked_root_package() == {
            .Ok(package) -> Ok(Val(package.facts))
            .Err(error) -> {
                if !error.is_missing() -> return Err(EnvModelEvalError{diagnostic: error.diagnostic()})
                cache := WorkspaceDeclarationCache.new()
                if pkg_package_facts_for_root(&cache, self.resolver.root) == {
                    .Ok(facts) -> Ok(facts)
                    .Err(failure) -> Err(EnvModelEvalError{diagnostic: failure.diagnostic})
                }
            }
        }
    }
}

// `read_profiles`: the package profiles `env.jet` declares.
fn jet_driver_package_read_profiles(root: String) -[FS, Env, Exec, Time.Wait]> TComptimeValue JetDriverPackageReadError! {
    resolver :: jet_driver_package_open(ENV_FILE, root)
    env_file :: resolver.checked_file(ENV_FILE) ?? return Err(jet_driver_package_authority_error(ENV_FILE, "could not read the profile source", err))
    source :: env_file.text() ?? return Err(jet_driver_package_authority_error(ENV_FILE, "could not decode the profile source", err))
    base_dir :: resolver.root
    loader := JetDriverPackageSourceLoader{resolver: resolver, checked_inputs: [CheckedFile]{env_file}, last_file: ENV_FILE}
    plan :: envmodel_evaluate_env_with_source_loader(source, base_dir, &loader, None, None) ?? return Err(jet_driver_package_read_error(loader.last_file, "could not evaluate the profile source", jet_driver_package_diagnostic_cause(err.diagnostic)))
    loop file in loader.checked_inputs {
        loader.resolver.revalidate_file(file) ?? return Err(jet_driver_package_authority_error(file.relative, "a profile input changed while it was being read", err))
    }
    // The plan's profiles are already composed (PackageProfileSet.insert_checked)
    // and in name order, re-composed BTreeMap yields them.
    profiles := [ProfileView]{}
    loop profile in plan.package_profiles -> &profiles.push(jet_driver_package_profile_view(profile))
    view :: ProfileSetView.from_profiles(profiles)
    values := [TComptimeValue]{}
    loop profile in view.profiles -> &values.push(jet_driver_package_profile_value(profile))
    Ok(TComptimeValue.Struct{type_name: "CompilerProfileSet", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(view.schema_version)},
        TComptimeField{name: "file", value: jet_eval_compiler_services_string(view.file)},
        TComptimeField{name: "profiles", value: TComptimeValue.List{values: values}},
    }})
}

// `profile_view`: collisions in key order (the Rust BTreeMap order).
fn jet_driver_package_profile_view(profile: PackageProfileSpec) -> ProfileView Never! {
    keys := profile.collisions.keys().to_list()
    &keys.sort()
    collisions := [(key: String, value: String)]{}
    loop key in keys -> &collisions.push((key: key, value: profile.collisions[key]))
    ProfileView.from_parts(profile.name, profile.extends, profile.packages, collisions, profile.sources)
}

// `query`'s view of the package rooted at `root` (`eval_core_call_with_type`'s
// package-view arm).
fn jet_driver_compiler_package_view(query: String, args: [TComptimeValue], root: String) -[FS, Env, Exec, Time.Wait]> TComptimeValue Never! {
    if args.len() != 0 -> return jet_driver_package_failed(jet_driver_package_read_error("", "`core.compiler.{query}` takes no arguments", "call the package view from `fn build` or a comptime binding without a path argument"))
    if root == "" -> return jet_driver_package_failed(jet_driver_package_read_error("", "`core.compiler.{query}` is available only during package-aware compile-time evaluation", "call the package view from `fn build` or a comptime binding; the compiler pins the package root for you"))
    if jet_driver_package_read(query, root) == {
        .Ok(value) -> TComptimeValue.Present{value: value}
        .Err(error) -> jet_driver_package_failed(error)
    }
}

fn jet_driver_package_read(query: String, root: String) -[FS, Env, Exec, Time.Wait]> TComptimeValue JetDriverPackageReadError! {
    if query == "manifest" -> return jet_driver_package_read_manifest(root)
    if query == "package" -> return jet_driver_package_read_package(root)
    if query == "lock" -> return jet_driver_package_read_lock(root)
    jet_driver_package_read_profiles(root)
}

fn jet_driver_package_failed(error: JetDriverPackageReadError) -> TComptimeValue Never! {
    TComptimeValue.Failed{report: TComptimeReport.Told{value: TComptimeValue.Struct{type_name: "CompilerPackageError", fields: [TComptimeField]{
        TComptimeField{name: "code", value: jet_eval_compiler_services_string(error.code)},
        TComptimeField{name: "message", value: jet_eval_compiler_services_string(error.message)},
        TComptimeField{name: "file", value: jet_eval_compiler_services_string(error.file)},
        TComptimeField{name: "cause", value: jet_eval_compiler_services_string(error.cause)},
    }}}}
}

// `target_value`: the one exact target name, else absent.
fn jet_driver_package_target_value(targets: [TargetProfileView]) -> TComptimeValue Never! {
    if targets.len() == 1 -> return jet_eval_compiler_services_option_string(Val(targets[0].name))
    jet_eval_compiler_services_option_string(None)
}

fn jet_driver_package_dependency_value(dependency: DependencyView) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerDependency", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(dependency.name)},
        TComptimeField{name: "source", value: jet_eval_compiler_services_string(dependency.source)},
    }}
}

fn jet_driver_package_target_entry_value(package: PackageTargetView) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerPackageTarget", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(package.name)},
        TComptimeField{name: "targets", value: jet_eval_compiler_services_string_values(package.targets)},
    }}
}

fn jet_driver_package_output_value(output: OutputView) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerPackageOutput", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(output.name)},
        TComptimeField{name: "kind", value: jet_eval_compiler_services_string(output.kind)},
        TComptimeField{name: "entry", value: jet_eval_compiler_services_option_string(output.entry)},
    }}
}

fn jet_driver_package_build_profile_value(profile: BuildProfileView) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerBuildProfile", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(profile.name)},
        TComptimeField{name: "optimize", value: jet_eval_compiler_services_string(profile.optimize)},
        TComptimeField{name: "debug_info", value: TComptimeValue.Bool{value: profile.debug_info}},
        TComptimeField{name: "small", value: TComptimeValue.Bool{value: profile.small}},
        TComptimeField{name: "panic", value: jet_eval_compiler_services_option_string(profile.panic)},
    }}
}

fn jet_driver_package_manifest_value(view: ManifestView) -> TComptimeValue Never! {
    jet_driver_package_declaration_value("CompilerManifest", view)
}

// `package_value`: the same fields as the manifest view, over the composed
// facts.
fn jet_driver_package_package_value(view: PackageView) -> TComptimeValue Never! {
    jet_driver_package_declaration_value("CompilerPackage", ManifestView{
        schema_version: view.schema_version, file: view.file, jet: view.jet, edition: view.edition,
        description: view.description, license: view.license, repository: view.repository, layer: view.layer,
        targets: view.targets, dependencies: view.dependencies, packages: view.packages, outputs: view.outputs,
        build_profiles: view.build_profiles,
    })
}

fn jet_driver_package_declaration_value(type_name: String, view: ManifestView) -> TComptimeValue Never! {
    dependencies := [TComptimeValue]{}
    loop dependency in view.dependencies -> &dependencies.push(jet_driver_package_dependency_value(dependency))
    packages := [TComptimeValue]{}
    loop package in view.packages -> &packages.push(jet_driver_package_target_entry_value(package))
    outputs := [TComptimeValue]{}
    loop output in view.outputs -> &outputs.push(jet_driver_package_output_value(output))
    profiles := [TComptimeValue]{}
    loop profile in view.build_profiles -> &profiles.push(jet_driver_package_build_profile_value(profile))
    TComptimeValue.Struct{type_name: type_name, fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: jet_eval_compiler_services_int(view.schema_version)},
        TComptimeField{name: "file", value: jet_eval_compiler_services_string(view.file)},
        TComptimeField{name: "jet", value: jet_eval_compiler_services_option_string(view.jet)},
        TComptimeField{name: "edition", value: jet_eval_compiler_services_option_string(view.edition)},
        TComptimeField{name: "description", value: jet_eval_compiler_services_option_string(view.description)},
        TComptimeField{name: "license", value: jet_eval_compiler_services_option_string(view.license)},
        TComptimeField{name: "repository", value: jet_eval_compiler_services_option_string(view.repository)},
        TComptimeField{name: "layer", value: jet_eval_compiler_services_option_string(view.layer)},
        TComptimeField{name: "target", value: jet_driver_package_target_value(view.targets)},
        TComptimeField{name: "dependencies", value: TComptimeValue.List{values: dependencies}},
        TComptimeField{name: "packages", value: TComptimeValue.List{values: packages}},
        TComptimeField{name: "outputs", value: TComptimeValue.List{values: outputs}},
        TComptimeField{name: "build_profiles", value: TComptimeValue.List{values: profiles}},
    }}
}

fn jet_driver_package_locked_value(package: LockedPackageView) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerLockedPackage", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(package.name)},
        TComptimeField{name: "version", value: jet_eval_compiler_services_string(package.version)},
        TComptimeField{name: "source_kind", value: jet_eval_compiler_services_string(package.source_kind)},
        TComptimeField{name: "source", value: jet_eval_compiler_services_option_string(package.source)},
        TComptimeField{name: "revision", value: jet_eval_compiler_services_option_string(package.revision)},
        TComptimeField{name: "fingerprint", value: jet_eval_compiler_services_string(package.fingerprint)},
        TComptimeField{name: "content_hash", value: jet_eval_compiler_services_option_string(package.content_hash)},
        TComptimeField{name: "dependencies", value: jet_eval_compiler_services_string_values(package.dependencies)},
        TComptimeField{name: "layer", value: jet_eval_compiler_services_option_string(package.layer)},
        TComptimeField{name: "inferred_layer", value: jet_eval_compiler_services_option_string(package.inferred_layer)},
    }}
}

fn jet_driver_package_profile_value(profile: ProfileView) -> TComptimeValue Never! {
    collisions := [TComptimeValue]{}
    loop collision in profile.collisions {
        &collisions.push(TComptimeValue.Struct{type_name: "CompilerKeyValue", fields: [TComptimeField]{
            TComptimeField{name: "key", value: jet_eval_compiler_services_string(collision.key)},
            TComptimeField{name: "value", value: jet_eval_compiler_services_string(collision.value)},
        }})
    }
    TComptimeValue.Struct{type_name: "CompilerProfile", fields: [TComptimeField]{
        TComptimeField{name: "name", value: jet_eval_compiler_services_string(profile.name)},
        TComptimeField{name: "extends", value: jet_eval_compiler_services_string_values(profile.extends)},
        TComptimeField{name: "packages", value: jet_eval_compiler_services_string_values(profile.packages)},
        TComptimeField{name: "collisions", value: TComptimeValue.List{values: collisions}},
        TComptimeField{name: "sources", value: jet_eval_compiler_services_string_values(profile.sources)},
    }}
}
