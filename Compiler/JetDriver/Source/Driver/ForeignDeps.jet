// Host foreign-library declarations use the same inline/package parser as
// source loading. C dependencies are not Jet source roots.
use {
    jet_lexer.[lex_config, token_decoded, TOKEN_STRING, TOKEN_RAW_STRING]
    jet_foundation.[AccessConvention, Diagnostic, SourceFile, Type, stable_id]
    jet_sema.[SemaGraphModuleResult]
}

JetDriverCDependency: struct {
    library: String
    root: String
    target: String
}

jet_driver_c_dependencies: fn(snapshot: JetDriverAuthorizedSourceSnapshot) -> [JetDriverCDependency] {
    declarations := [JetDriverCDependency]{}
    diagnostics := [Diagnostic]{}
    loop index in 0..<snapshot.roots.len() {
        package: jet_driver_parse_package_root(snapshot, index, diagnostics)
        loop dependency in package.dependencies {
            if !dependency.source.starts_with("c@") -> next
            target := dependency.source.removeprefix("c@").trim()
            lexed: lex_config(target.bytes())
            tokens: lexed.tokens
            if tokens.len() > 0 && (tokens[0].kind == TOKEN_STRING || tokens[0].kind == TOKEN_RAW_STRING) -> target = token_decoded(lexed.tables, tokens[0])
            declarations.push(JetDriverCDependency{library: dependency.name, root: snapshot.roots[index].canonical_path, target: target})
        }
    }
    declarations
}

// One parameter of an inline C body's C ABI: its checked type, by pointer
// when the declaration writes it.
JetDriverInlineCParam: struct { ty: Type, write: Bool }

// One `#FFI(c)` (or `#FFI(cpp)`) inline body of the checked foreign rows:
// its checked C ABI, the triple-quoted body within its declaration span
// (None when the span holds none) and its position among the program's
// foreign rows in foreign identity order, which names its translation unit.
JetDriverInlineC: struct {
    index: Int
    name: String
    symbol: String
    params: [JetDriverInlineCParam]
    return_type: Type?
    body: String?
    cpp: Bool
}

// One checked foreign declaration (`#Import(<lang>)` or `#FFI(<lang>)`): its
// name, its language head (jet_driver_foreign_language_head), its linked
// symbol, its source site, a file path and 1-based line, and the identity of
// the module declaring it, whose C providers link it.
JetDriverForeignDeclaration: struct {
    name: String
    language: String
    symbol: String
    path: String
    line: Int
    module_identity: String{""}
}

// One C provider of a checked module (`#Import c.<lib>`): the module's
// identity, the provider library and its direct and transitive links.
JetDriverForeignProvider: struct {
    module_identity: String
    library: String
    direct_links: [String]
    transitive_links: [String]
}

// What the native link closure reads of the checked foreign declarations:
// the C provider libraries (sorted, unique), their direct and transitive
// links (sorted; transitive without the direct ones), whether a C or Rust
// foreign row needs the program's C platform, and the inline C bodies. The
// declarations, in foreign identity order, are every checked foreign row;
// the providers, in module order, every C provider.
JetDriverForeignLinkFacts: struct {
    libraries: [String]
    direct_links: [String]
    transitive_links: [String]
    c_or_rust_rows: Bool
    inline_c: [JetDriverInlineC]
    declarations: [JetDriverForeignDeclaration]
    providers: [JetDriverForeignProvider]{[JetDriverForeignProvider]{}}
}

jet_driver_foreign_link_empty: fn() -> JetDriverForeignLinkFacts Never! {
    JetDriverForeignLinkFacts{libraries: [String]{}, direct_links: [String]{}, transitive_links: [String]{}, c_or_rust_rows: false, inline_c: [JetDriverInlineC]{}, declarations: [JetDriverForeignDeclaration]{}, providers: [JetDriverForeignProvider]{}}
}

// The facts of what live code reaches, of `facts`: the declarations whose
// symbol is in `live` (the link's live undefined symbols,
// x64_link_live_undefined), the C providers of their modules with those
// providers' links, and the inline C bodies called. Only a live C or Rust
// row needs the program's C platform. No live declaration leaves no closure.
jet_driver_foreign_link_live: fn(facts: JetDriverForeignLinkFacts, live: [String:Bool]) -> JetDriverForeignLinkFacts Never! {
    kept := jet_driver_foreign_link_empty()
    modules := [String]{}
    loop declaration in facts.declarations {
        if live.get(declaration.symbol) == None -> next
        if declaration.language == "c" || declaration.language == "rust" -> kept.c_or_rust_rows = true
        jet_driver_foreign_push_unique(modules, declaration.module_identity)
        kept.declarations.push(declaration.copy())
    }
    direct := [String]{}
    transitive := [String]{}
    loop provider in facts.providers {
        if !modules.contains(provider.module_identity) -> next
        jet_driver_foreign_push_unique(kept.libraries, provider.library)
        loop library in provider.direct_links -> jet_driver_foreign_push_unique(direct, library)
        loop library in provider.transitive_links -> jet_driver_foreign_push_unique(transitive, library)
        kept.providers.push(provider.copy())
    }
    kept.libraries.sort()
    direct.sort()
    transitive.sort()
    loop library in transitive {
        if !direct.contains(library) -> kept.transitive_links.push(library)
    }
    kept.direct_links = direct
    loop body in facts.inline_c {
        if live.get(body.symbol) != None -> kept.inline_c.push(body.copy())
    }
    kept
}

// The cache identity every C provider link unit carries.
jet_driver_foreign_link_cache_identity: fn(facts: JetDriverForeignLinkFacts) -> String Never! {
    "direct={facts.direct_links.join(",")};transitive={facts.transitive_links.join(",")}"
}

jet_driver_foreign_push_unique: fn(rows: &[String], value: String) Never! {
    if !rows.contains(value) -> rows.push(value.copy())
}

// The language head before any `:`; every head other than C, C++ and
// assembly (an inline body's `rust`, `zig`, ...) is Rust.
jet_driver_foreign_language_head: fn(language: String) -> String Never! {
    head: language.split(":").to_list()[0].lower()
    if head == "c" -> return "c"
    if head == "cpp" || head == "c++" -> return "cpp"
    if head == "asm" || head == "assembly" -> return "asm"
    "rust"
}

// The triple-quoted body within `span` of the source file `path`.
jet_driver_inline_c_body: fn(source_files: [SourceFile], path: String, start: Int, end: Int) -> String? Never! {
    loop source_file in source_files {
        if source_file.path != path -> next
        bytes: source_file.source.bytes()
        if start < 0 || end < start || end > bytes.len() -> return None
        open := -1
        at := start
        loop at + 2 < end {
            if bytes[at] == (U8{34}) && bytes[at + 1] == (U8{34}) && bytes[at + 2] == (U8{34}) {
                if open < 0 {
                    open = at + 3
                    at += 3
                    next
                }
                return Val(String.from_bytes(bytes.slice(open, at)) ?? return None)
            }
            at += 1
        }
        return None
    }
    None
}

// The 1-based line of byte `offset` in the source file `path`; 0 when the
// file is not among `source_files`.
jet_driver_foreign_line: fn(source_files: [SourceFile], path: String, offset: Int) -> Int Never! {
    loop source_file in source_files {
        if source_file.path != path -> next
        bytes: source_file.source.bytes()
        end: if offset < bytes.len() -> offset else -> bytes.len()
        line := 1
        loop at in 0..<end {
            if bytes[at] == (U8{10}) -> line += 1
        }
        return line
    }
    0
}

// The foreign link facts of the checked modules `modules`; inline bodies
// read their declaration span in `source_files`.
jet_driver_foreign_link_facts: fn(modules: [SemaGraphModuleResult], source_files: [SourceFile]) -> JetDriverForeignLinkFacts Never! {
    facts := jet_driver_foreign_link_empty()
    direct := [String]{}
    transitive := [String]{}
    // Foreign identity order: (identity, key) of every checked foreign row.
    ids := [U64]{}
    keys := [String]{}
    rows := [Int]{}
    modules_of := [Int]{}
    loop (module_index, semantic_module) in modules {
        loop provider in semantic_module.foreign_providers {
            jet_driver_foreign_push_unique(facts.libraries, provider.library)
            loop library in provider.direct_links -> jet_driver_foreign_push_unique(direct, library)
            loop library in provider.transitive_links -> jet_driver_foreign_push_unique(transitive, library)
            facts.providers.push(JetDriverForeignProvider{module_identity: provider.module_identity, library: provider.library, direct_links: provider.direct_links, transitive_links: provider.transitive_links})
        }
        loop (row_index, row) in semantic_module.foreign_functions {
            head: jet_driver_foreign_language_head(row.language)
            if head == "c" || head == "rust" -> facts.c_or_rust_rows = true
            ids.push(stable_id("foreign", row.key))
            keys.push(row.key)
            rows.push(row_index)
            modules_of.push(module_index)
        }
    }
    facts.libraries.sort()
    direct.sort()
    transitive.sort()
    loop library in transitive {
        if !direct.contains(library) -> facts.transitive_links.push(library)
    }
    facts.direct_links = direct
    order := [Int]{}
    loop position in 0..<ids.len() -> order.push(position)
    order.sort_by((left: Int, right: Int) -> if ids[left] != ids[right] -> ids[left] <=> ids[right] else -> keys[left] <=> keys[right])
    loop (index, position) in order {
        row: modules[modules_of[position]].foreign_functions[rows[position]]
        facts.declarations.push(JetDriverForeignDeclaration{
            name: row.name,
            language: jet_driver_foreign_language_head(row.language),
            symbol: row.symbol,
            path: row.source_file,
            line: jet_driver_foreign_line(source_files, row.source_file, row.span.start),
            module_identity: row.module_identity,
        })
        if !row.path.starts_with("jet_ffi_") || row.symbol != "jet_inline_{row.path}" -> next
        head: jet_driver_foreign_language_head(row.language)
        if head != "c" && head != "cpp" -> next
        params: loop param in row.params -> JetDriverInlineCParam{ty: param.ty, write: param.convention == AccessConvention.Write}
        facts.inline_c.push(JetDriverInlineC{
            index: index,
            name: row.name,
            symbol: row.symbol,
            params: params,
            return_type: row.return_type,
            body: jet_driver_inline_c_body(source_files, row.source_file, row.span.start, row.span.end),
            cpp: head == "cpp",
        })
    }
    facts
}
