// Body expressions enter the ordinary comptime source/value graph. The
// canonical driver evaluator remains the sole execution path; this file owns
// body-site discovery, staging, and the value-fed function recheck boundary.
use {
    jet_foundation.[
        CompilerTraceSink,
        Diagnostic,
        FnBody,
        ModuleTable,
        module_text,
    ]
    jet_sema.[
        SemaComptimeBodySource,
        SemaComptimeDeclarationStage,
        SemaComptimeFunctionResult,
        SemaComptimeItemKind,
        SemaComptimeItemSource,
        SemaComptimeItemValue,
        SemaFinalizeBodies,
        SemaGraphModuleResult,
        SemaGraphResult,
        SemaLocalSpliceDemand,
        SemaRegistrationGraph,
        sema_comptime_body_item_source,
        sema_comptime_function_diagnostics,
        sema_comptime_graph_apply_values,
        SemaGraphTrail,
        sema_graph_trail_init,
        sema_graph_trail_undo,
        sema_finalize_graph,
        sema_finalize_seeded_taken,
        sema_local_splice_demand_swap,
        sema_local_value_land,
        sema_local_value_splice,
        sema_local_values_blocked,
        sema_name_facts_empty,
        sema_stage_declaration_modules,
    ]
}

JetDriverComptimeBodyResult: struct {
    graph: SemaGraphResult
    values: [SemaComptimeItemValue]
    functions: [SemaComptimeFunctionResult]
    trace: JetDriverCompileTrace
    complete: Bool
    soft_stop: Bool
    internal_problem: String?
    // The registration graph the caller moved in, handed back on every exit
    // (a borrowed graph moved into a comptime run was copied whole).
    registration: SemaRegistrationGraph?{None}
}

// `result` with the registration graph moved back into it.
jet_driver_comptime_body_returning: fn(result: &&JetDriverComptimeBodyResult, registration: &&SemaRegistrationGraph) -> JetDriverComptimeBodyResult Never! {
    owned := result.move()
    owned.registration = Val(registration.move())
    owned
}

jet_driver_comptime_body_result: fn(
    graph: &&SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
) -> JetDriverComptimeBodyResult Never! {
    JetDriverComptimeBodyResult{
        graph: graph.move(),
        values: values,
        functions: functions,
        trace: trace,
        complete: complete,
        soft_stop: soft_stop,
        internal_problem: None,
    }
}

jet_driver_comptime_body_failure: fn(
    graph: &&SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    problem: String?,
) -> JetDriverComptimeBodyResult Never! {
    result := jet_driver_comptime_body_result(graph, values, functions, trace, false, false)
    result.internal_problem = problem
    result
}

jet_driver_comptime_trace_append: fn(target: &JetDriverCompileTrace, addition: JetDriverCompileTrace) Never! {
    loop text in addition.stdout -> target.stdout.push(text.copy())
    loop text in addition.stderr -> target.stderr.push(text.copy())
    if addition.exit_code != None -> target.exit_code = addition.exit_code
    target.soft_stop = target.soft_stop || addition.soft_stop
}

jet_driver_comptime_diagnostic_key: fn(diagnostic: Diagnostic) -> String Never! {
    span_start := -1
    span_end := -1
    if diagnostic.span == .Val(span) {
        span_start = span.start
        span_end = span.end
    }
    source_path := ""
    if diagnostic.source_path == .Val(path) -> source_path = path
    source_offset := -1
    if diagnostic.source_offset == .Val(offset) -> source_offset = offset
    source_start := -1
    if diagnostic.source_start == .Val(start) -> source_start = start
    detail := ""
    if diagnostic.detail == .Val(value) -> detail = value
    "{diagnostic.severity}:{diagnostic.code.len()}:{diagnostic.code}:{span_start}:{span_end}:{source_path.len()}:{source_path}:{source_offset}:{source_start}:{diagnostic.what.len()}:{diagnostic.what}:{diagnostic.why.len()}:{diagnostic.why}:{diagnostic.fix.len()}:{diagnostic.fix}:{detail.len()}:{detail}"
}

// Adds each of `incoming` that matches no diagnostic already in `diagnostics`
// (or added before it). The keys of the existing diagnostics are taken once
// per call instead of recomputing every existing key for each addition.
jet_driver_comptime_diagnostics_add: fn(diagnostics: &[Diagnostic], incoming: [Diagnostic]) Never! {
    if incoming.len() == 0 -> return
    seen := [String:Bool]{}
    loop existing in diagnostics -> seen[jet_driver_comptime_diagnostic_key(existing)] = true
    loop diagnostic in incoming {
        key: jet_driver_comptime_diagnostic_key(diagnostic)
        if seen.get(key) != None -> next
        seen[key] = true
        diagnostics.push(diagnostic.copy())
    }
}
// A run returns its one graph on every exit, with later edits in its trail.
jet_driver_comptime_take_registration: fn(finished: &&SemaRegistrationGraph?, partial: &&SemaRegistrationGraph?) -> SemaRegistrationGraph Never! {
    if finished == .Val(graph) -> return graph.move()
    partial.move() ?? panic("a comptime run lost its registration graph")
}

// `known` holds the `module\nkey` of every source already added.
jet_driver_comptime_body_source_add: fn(
    sources: &[SemaComptimeItemSource],
    known: &[String:Bool],
    source: SemaComptimeBodySource,
) Never! {
    item := sema_comptime_body_item_source(source)
    key: "{item.module_identity.id}\n{item.key}"
    if known.get(key) != None -> return
    known[key] = true
    sources.push(item)
}

jet_driver_comptime_body_sources: fn(modules: [SemaGraphModuleResult]) -> [SemaComptimeBodySource] Never! {
    sources := [SemaComptimeBodySource]{}
    seen := [String:Bool]{}
    loop graph_module in modules {
        loop source in graph_module.comptime_body_sources {
            key: "{source.module_identity.id}\n{source.key}"
            if seen.get(key) != None -> next
            seen[key] = true
            sources.push(source.copy())
        }
    }
    sources
}

jet_driver_pending_comptime_body_sources: fn(
    modules: [SemaGraphModuleResult],
    values: [SemaComptimeItemValue],
) -> [SemaComptimeBodySource] Never! {
    // The `module\nkey` of every staged body value, collected once rather
    // than rescanning every value per source.
    present := [String:Bool]{}
    loop value in values {
        if value.kind == SemaComptimeItemKind.BodyExpression -> present["{value.module_identity.id}\n{value.key}"] = true
    }
    pending := [SemaComptimeBodySource]{}
    loop source in jet_driver_comptime_body_sources(modules) {
        if present.get("{source.module_identity.id}\n{source.key}") == None -> pending.push(source)
    }
    pending
}

// Whether the body recheck or the checked-text validation evaluates over
// `graph` and so reads its name facts (jet_driver_comptime_body_pass,
// jet_driver_validate_checked_text).
jet_driver_comptime_reads_names: fn(graph: SemaGraphResult, values: [SemaComptimeItemValue]) -> Bool Never! {
    if jet_driver_pending_comptime_body_sources(graph.modules, values).len() > 0 -> return true
    loop graph_module in graph.modules {
        loop call in graph_module.comptime_requests {
            if call.checked_text != None -> return true
        }
    }
    false
}

jet_driver_comptime_body_stage: fn(
    stage: SemaComptimeDeclarationStage,
    graph: &&SemaGraphResult,
    sources: &&[SemaComptimeItemSource],
) -> SemaComptimeDeclarationStage Never! {
    // The successful evaluation retired the old graph; its resolved modules
    // now belong to the recheck stage, never to a second copied graph. The
    // recheck reads only their declarations, so their checked bodies, the
    // graph's merged rows and its name facts are freed here, before it checks
    // every body again.
    retired := graph.move()
    SemaComptimeDeclarationStage{
        modules: sema_stage_declaration_modules(retired.modules),
        imports: stage.imports,
        package_policies: stage.package_policies,
        names: sema_name_facts_empty(),
        sources: sources.move(),
        diagnostics: stage.diagnostics,
        complete: stage.complete,
    }
}

// The caller moves its registration graph in and takes it back from
// `registration` of the result (every exit returns it). The run's values,
// closures and trace move in too; the result hands them back. `refused` is
// the pass the first finalization ran and did not land
// (jet_driver_land_local_values), or None; the first pass takes it.
jet_driver_orchestrate_comptime_bodies: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: &&[SemaComptimeItemValue],
    initial_functions: &&[SemaComptimeFunctionResult],
    initial_trace: &&JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
    refused: &&JetDriverRefusedPass?,
) -> JetDriverComptimeBodyResult {
    jet_driver_comptime_body_pass(
        graph, stage, initial_graph, initial_values, initial_functions,
        initial_trace, load, request, diagnostics, 0, refused,
    )
}

// Each bounded pass owns its graphs until evaluation succeeds, then moves
// them into rechecking. Like pure folding, passes thread ownership through
// calls instead of copying a graph across a loop backedge. A pass takes the
// run of `refused` when it fits (jet_driver_comptime_body_run).
jet_driver_comptime_body_pass: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: &&[SemaComptimeItemValue],
    initial_functions: &&[SemaComptimeFunctionResult],
    initial_trace: &&JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
    completed_passes: Int,
    refused: &&JetDriverRefusedPass?,
) -> JetDriverComptimeBodyResult {
    registration := graph.move()
    current_graph := initial_graph.move()
    values := initial_values.move()
    functions := initial_functions.move()
    trace := initial_trace.move()
    if current_graph.modules.len() != registration.modules.len() {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(
            current_graph, values, functions, trace,
            Val("semantic body rechecking did not return every registered module"),
        ), registration)
    }
    jet_driver_comptime_diagnostics_add(diagnostics, current_graph.diagnostics)
    jet_driver_trace_step_begin(request.trace_sink, "comptime.body.pending")
    pending := jet_driver_pending_comptime_body_sources(current_graph.modules, values)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.pending", pending.len())
    if request.trace_sink == .Val(sink) -> sink.progress("counters.comptime.bodies_pending", pending.len(), -1)
    if current_graph.complete && pending.len() == 0 && !jet_driver_has_errors(current_graph.diagnostics) {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, true, false), registration)
    }
    if pending.len() == 0 {
        if !jet_driver_has_errors(current_graph.diagnostics) && !jet_driver_has_errors(diagnostics) {
            problem := jet_driver_totality_problem("semantic body rechecking did not return a complete resolved package graph", "sema.body", current_graph.modules, registration.module_table)
            return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(current_graph, values, functions, trace, Val(problem)), registration)
        }
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, false, false), registration)
    }
    // JET_KEEP_GOING: pending bodies still run past reported errors, so the
    // functions whose bodies need their values still lower.
    if jet_driver_has_errors(current_graph.diagnostics) && !registration.keep_going {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, false, false), registration)
    }
    pass: completed_passes + 1
    if pass > 256 {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(
            current_graph, values, functions, trace,
            Val("body comptime rechecking exceeded its bounded progress limit"),
        ), registration)
    }
    body_sources := [SemaComptimeItemSource]{}
    known := [String:Bool]{}
    loop source in pending -> jet_driver_comptime_body_source_add(body_sources, known, source)
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.run", body_sources, pass)
    run := jet_driver_comptime_body_run(registration, body_sources, values, functions, refused, request, diagnostics)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.run", body_sources.len())
    finished_registration := run.graph.move()
    run.graph = None
    partial_registration := run.partial_graph.move()
    run.partial_graph = None
    registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
    jet_driver_comptime_trace_append(trace, run.trace)
    if run.soft_stop {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, run.values, run.functions, trace, false, true), registration)
    }
    if !run.complete {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(current_graph, run.values, run.functions, trace, run.internal_problem), registration)
    }
    if run.values.len() <= values.len() {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(
            current_graph, values, functions, trace,
            Val("body comptime rechecking made no staged-value progress"),
        ), registration)
    }
    earlier_values := values.move()
    earlier_functions := functions.move()
    values = run.values.move()
    functions = run.functions.move()
    // A pass that landed only local values lands them in the bodies that
    // hold them (JetSema Comptime/LocalSplice.jet); under `recheck_verify`
    // the full recheck runs too, and the two results must agree.
    full_input := SemaGraphResult?{None}
    if request.recheck_verify -> full_input = Val(current_graph.copy())
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.splice", body_sources, pass)
    splice := sema_local_value_splice(registration, run.trail, current_graph, body_sources, earlier_values, earlier_functions, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.splice", body_sources.len())
    registration = splice.graph.move()
    if splice.spliced {
        if full_input.move() == .Val(unspliced) {
            full := jet_driver_recheck_comptime_bodies(registration, run.trail, stage, unspliced, body_sources, values, functions, request, pass)
            verified := full.registration_graph.move()
            full.registration_graph = None
            registration = verified.move() ?? panic("body finalization lost its registration graph")
            differences: jet_driver_recheck_differences(current_graph, full, registration.module_table)
            if differences.len() > 0 {
                lines: differences.join("\n")
                sema_graph_trail_undo(registration, run.trail)
                return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(
                    current_graph, values, functions, trace,
                    Val("JET_RECHECK_VERIFY: the spliced local values differ from the full recheck:\n{lines}"),
                ), registration)
            }
        }
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_pass(
            registration, stage, current_graph, values, functions, trace,
            load, request, diagnostics, pass, None,
        )
    }
    // The refused splice was the last reader of the values and closures the
    // finalization was checked against.
    earlier_values = [SemaComptimeItemValue]{}
    earlier_functions = [SemaComptimeFunctionResult]{}
    // The run's graph already carries every value: the recheck finalizes it
    // in place instead of copying the registration graph.
    rechecked := jet_driver_recheck_comptime_bodies(
        registration, run.trail, stage, current_graph, body_sources,
        values, functions, request, pass,
    )
    restored := rechecked.registration_graph.move()
    rechecked.registration_graph = None
    registration = restored.move() ?? panic("body finalization lost its registration graph")
    sema_graph_trail_undo(registration, run.trail)
    jet_driver_comptime_body_pass(
        registration, stage, rechecked, values, functions, trace,
        load, request, diagnostics, pass, None,
    )
}

// A body comptime pass the first finalization ran and did not land
// (jet_driver_land_local_values): its sites by `module\nkey`, how many
// values and closures it started from, and the run's results. The first
// body pass after finalization starts from the same values and closures and
// takes the same sites, so it takes these results instead of building and
// evaluating the same comptime program again.
JetDriverRefusedPass: struct {
    sites: [String:Bool]
    base_values: Int
    base_functions: Int
    values: [SemaComptimeItemValue]
    functions: [SemaComptimeFunctionResult]
    trace: JetDriverCompileTrace
}

// `refused`, moved out, when its pass is the one a body pass over `sources`
// runs from `values` and `functions`: the same sites, from the same values
// and closures. Otherwise None, and `refused` is dropped.
jet_driver_take_refused_pass: fn(refused: &&JetDriverRefusedPass?, sources: [SemaComptimeItemSource], values: [SemaComptimeItemValue], functions: [SemaComptimeFunctionResult]) -> JetDriverRefusedPass? Never! {
    pass := refused.move() ?? return None
    if pass.base_values != values.len() || pass.base_functions != functions.len() || pass.sites.len() != sources.len() -> return None
    loop source in sources {
        if pass.sites.get("{source.module_identity.id}\n{source.key}") == None -> return None
    }
    Val(pass.move())
}

// The comptime run of a body pass over `sources` from `values` and
// `functions` (jet_driver_run_comptime). When `refused` fits
// (jet_driver_take_refused_pass), its results stand for the run: the graph
// takes `values` as a run's environment does and the pass's values on the
// result's trail, as the run applies them. Under `recheck_verify` the pass
// runs again instead, and a run that differs from the refused one fails.
// The graph moves in and comes back in the result.
jet_driver_comptime_body_run: fn(
    graph: &&SemaRegistrationGraph,
    sources: [SemaComptimeItemSource],
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    refused: &&JetDriverRefusedPass?,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeRunResult {
    registration := graph.move()
    kept := jet_driver_take_refused_pass(refused, sources, values, functions)
    pass := kept.move() ?? return jet_driver_run_comptime(registration, [SemaGraphModuleResult]{}, None, sources, values, functions, request, diagnostics)
    if request.recheck_verify {
        fresh := jet_driver_run_comptime(registration, [SemaGraphModuleResult]{}, None, sources, values, functions, request, diagnostics)
        if fresh.complete && ("{fresh.values:Debug}" != "{pass.values:Debug}" || "{fresh.functions:Debug}" != "{pass.functions:Debug}") {
            fresh.complete = false
            fresh.internal_problem = Val("JET_RECHECK_VERIFY: the body pass the first finalization did not land differs from the same pass run again")
        }
        return fresh
    }
    if request.trace_sink == .Val(sink) -> sink.progress("counters.comptime.refused_pass_taken", sources.len(), -1)
    environment_trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(registration, values, environment_trail)
    trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(registration, pass.values, trail)
    JetDriverComptimeRunResult{
        values: pass.values.move(),
        functions: pass.functions.move(),
        trace: pass.trace.move(),
        complete: true,
        soft_stop: false,
        internal_problem: None,
        graph: Val(registration.move()),
        partial_graph: None,
        graph_finished: true,
        trail: trail.move(),
        declared: [SemaGraphModuleResult]{},
    }
}

// JET_RECHECK_VERIFY (JetDriverCompileRequest.recheck_verify): the first
// rows, at most 20, in which the result of a pass that spliced its local
// values (`spliced`) differs from the full recheck of that pass (`full`),
// one line each. A body only one of them checked is listed by its key.
jet_driver_recheck_differences: fn(spliced: SemaGraphResult, full: SemaGraphResult, table: ModuleTable) -> [String] Never! {
    differences := [String]{}
    if spliced.modules.len() != full.modules.len() {
        differences.push("modules: {spliced.modules.len()} spliced, {full.modules.len()} rechecked")
        return differences
    }
    loop module_index in 0..<spliced.modules.len() {
        ours: spliced.modules[module_index]
        theirs: full.modules[module_index]
        name: module_text(table, ours.module_identity)
        jet_driver_recheck_body_differences(name, ours.functions, theirs.functions, differences)
        if "{ours.call_facts:Debug}" != "{theirs.call_facts:Debug}" -> differences.push("{name}: call facts differ")
        if "{ours.name_references:Debug}" != "{theirs.name_references:Debug}" -> differences.push("{name}: name references differ")
        if "{ours.comptime_body_sources:Debug}" != "{theirs.comptime_body_sources:Debug}" -> differences.push("{name}: body comptime sites differ")
        if "{ours.diagnostics:Debug}" != "{theirs.diagnostics:Debug}" -> differences.push("{name}: diagnostics differ: {jet_driver_recheck_diagnostic_difference(ours.diagnostics, theirs.diagnostics)}")
        if "{ours.failure_facts:Debug}" != "{theirs.failure_facts:Debug}" -> differences.push("{name}: failure facts differ")
        our_rows := ours.copy()
        our_rows.functions = [FnBody]{}
        their_rows := theirs.copy()
        their_rows.functions = [FnBody]{}
        if "{our_rows:Debug}" != "{their_rows:Debug}" -> differences.push("{name}: module rows differ")
        if differences.len() >= 20 -> return differences
    }
    if jet_driver_recheck_graph_rows(spliced) != jet_driver_recheck_graph_rows(full) {
        detail: if "{spliced.diagnostics:Debug}" != "{full.diagnostics:Debug}" -> ": diagnostics: {jet_driver_recheck_diagnostic_difference(spliced.diagnostics, full.diagnostics)}" else -> ""
        differences.push("graph rows differ{detail}")
    }
    differences
}

// How the diagnostics of the splice (`ours`) and of the recheck (`theirs`)
// differ: their counts and the first one each holds that the other lacks.
jet_driver_recheck_diagnostic_difference: fn(ours: [Diagnostic], theirs: [Diagnostic]) -> String Never! {
    "{ours.len()} spliced, {theirs.len()} rechecked; first only spliced: {jet_driver_recheck_first_missing(ours, theirs)}; first only rechecked: {jet_driver_recheck_first_missing(theirs, ours)}"
}

// The first diagnostic of `diagnostics` that `others` lacks, by code, span
// and text; "none" when there is none.
jet_driver_recheck_first_missing: fn(diagnostics: [Diagnostic], others: [Diagnostic]) -> String Never! {
    present := [String:Bool]{}
    loop diagnostic in others -> present["{diagnostic:Debug}"] = true
    loop diagnostic in diagnostics {
        if present.get("{diagnostic:Debug}") == None -> return "{diagnostic.code} at {diagnostic.span:Debug}: {diagnostic.what}"
    }
    "none"
}

// The graph rows of `graph` outside its modules, as one display. The
// registration graph stays out: it holds the shared lookup counters
// (`Shared<SemaLookupCounters>`), which have no display.
jet_driver_recheck_graph_rows: fn(graph: SemaGraphResult) -> String Never! {
    "{graph.package_identity:Debug} {graph.entry_module_identity:Debug} {graph.imports:Debug} {graph.package_policies:Debug} {graph.core_usage:Debug} {graph.call_facts:Debug} {graph.hardware_use:Debug} {graph.comptime_requests:Debug} {graph.comptime_body_sources:Debug} {graph.compute_facts:Debug} {graph.names:Debug} {graph.diagnostics:Debug} {graph.complete} {graph.inferred_infallible:Debug} {graph.programs:Debug} {graph.outputs:Debug} {graph.memory_declarations:Debug} {graph.memory_projections:Debug}"
}

// The bodies of module `name` that differ between the splice (`ours`) and
// the recheck (`theirs`), into `differences`: each body by its key, or, when
// the two checked different bodies, each body only one of them checked.
jet_driver_recheck_body_differences: fn(name: String, ours: [FnBody], theirs: [FnBody], differences: &[String]) Never! {
    if ours.len() == theirs.len() {
        loop index in 0..<ours.len() {
            if "{ours[index]:Debug}" != "{theirs[index]:Debug}" -> differences.push("{name}: body {ours[index].key} differs")
        }
        return
    }
    rechecked := [String:Bool]{}
    loop function in theirs -> rechecked[function.key] = true
    kept := [String:Bool]{}
    loop function in ours {
        kept[function.key] = true
        if rechecked.get(function.key) == None -> differences.push("{name}: body {function.key} checked only in the splice")
    }
    loop function in theirs {
        if kept.get(function.key) == None -> differences.push("{name}: body {function.key} checked only in the recheck")
    }
}

// As jet_driver_orchestrate_comptime_bodies: the registration graph moves in
// and comes back in `registration` of the result.
jet_driver_validate_checked_text: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    initial_trace: JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeBodyResult {
    registration := graph.move()
    sources := [SemaComptimeItemSource]{}
    known := [String:Bool]{}
    loop module_index in 0..<initial_graph.modules.len() {
        loop call in initial_graph.modules[module_index].comptime_requests {
            if call.checked_text == .Val(evaluation) -> jet_driver_comptime_checked_text_source_add(sources, known, evaluation)
        }
    }
    if sources.len() == 0 {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(initial_graph, initial_values, initial_functions, initial_trace, true, false), registration)
    }
    run := jet_driver_run_comptime(
        registration,
        [SemaGraphModuleResult]{},
        None,
        sources,
        initial_values,
        initial_functions,
        request,
        diagnostics,
    )
    finished_registration := run.graph.move()
    run.graph = None
    partial_registration := run.partial_graph.move()
    run.partial_graph = None
    registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
    sema_graph_trail_undo(registration, run.trail)
    trace := initial_trace
    jet_driver_comptime_trace_append(trace, run.trace)
    if run.soft_stop {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(initial_graph, run.values, run.functions, trace, false, true), registration)
    }
    if !run.complete {
        result := jet_driver_comptime_body_result(initial_graph, run.values, run.functions, trace, false, false)
        result.internal_problem = run.internal_problem
        if result.internal_problem == None && !jet_driver_has_errors(diagnostics) {
            result.internal_problem = Val("checked text evaluation did not return a complete validation or diagnostic")
        }
        return jet_driver_comptime_body_returning(result, registration)
    }
    merged_graph := initial_graph.move()
    if jet_driver_merge_checked_text_functions(merged_graph, registration.module_table, run.functions) == .Val(problem) {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(
            merged_graph,
            run.values,
            run.functions,
            trace,
            Val(problem),
        ), registration)
    }
    registration = jet_driver_merged_names(merged_graph, registration, request.compiler_threads)
    jet_driver_comptime_body_returning(jet_driver_comptime_body_result(merged_graph, run.values, run.functions, trace, true, false), registration)
}

// Finalizes the rechecked bodies against the moved-in registration graph,
// recording its edits on `trail`; the graph comes back in the result's
// `registration_graph` with the edits still applied (the caller undoes them).
jet_driver_recheck_comptime_bodies: fn(
    graph: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    stage: SemaComptimeDeclarationStage,
    semantic_graph: &&SemaGraphResult,
    body_sources: &&[SemaComptimeItemSource],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    request: JetDriverCompileRequest,
    pass: Int,
) -> SemaGraphResult {
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.recheck", body_sources, pass)
    body_stage := jet_driver_comptime_body_stage(stage, semantic_graph, body_sources)
    rechecked := sema_finalize_graph(graph, trail, body_stage, values, comptime_functions, request.eval_config.host_hooks, request.compiler_threads, None, true, request.trace_sink)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.recheck", rechecked.modules.len())
    rechecked
}

// Opens a span of body pass `pass` whose detail names the bodies it
// evaluates, so a trace attributes each pass's run, splice and recheck.
jet_driver_trace_body_begin: fn(trace_sink: CompilerTraceSink?, name: String, body_sources: [SemaComptimeItemSource], pass: Int) {
    if trace_sink == .Val(sink) {
        names := [String]{}
        loop source in body_sources -> names.push(source.name)
        sink.begin(name, names.join(", "), pass, -1)
    }
}

// Lands each body comptime pass whose pending sites are all local values in
// the modules of the first finalization (`bodies`) after its body half and
// Core demand (sema_finalize_bodies, sema_finalize_demand) and before its
// whole-program half (sema_finalize_program), so that half runs once, over
// every value, instead of once before the pass and again after it
// (sema_local_value_land). The sites of user and Core bodies land in one
// pass, and only a pass whose values change no Core demand. A pass that cannot
// land cleanly (an error other than a failure obligation or an incomplete
// check so far, a site that is not a local value or that an earlier pass
// already took, a run that reports anything, stops, does not complete or
// adds no value, or a splice that does not hold) is dropped, and the body
// passes after finalization (jet_driver_orchestrate_comptime_bodies) take
// its sites as before. A clean run whose splice does not hold goes to
// `refused`, so the first of those passes takes its results instead of
// running it again. A taken seeded module's sites
// (sema_finalize_seeded_taken) are the Core record's, final as taken: none
// lands again. The registration graph moves in and comes back with no edit;
// `values`, `functions` and `trace` take what the landed passes add.
jet_driver_land_local_values: fn(
    graph: &&SemaRegistrationGraph,
    bodies: &SemaFinalizeBodies,
    stage: SemaComptimeDeclarationStage,
    values: &[SemaComptimeItemValue],
    functions: &[SemaComptimeFunctionResult],
    trace: &JetDriverCompileTrace,
    request: JetDriverCompileRequest,
    refused: &JetDriverRefusedPass?,
) -> SemaRegistrationGraph {
    registration := graph.move()
    // The `module\nkey` of every site a pass took: a site pending again
    // ends the landing, so it ends.
    tried := [String:Bool]{}
    taken := [U32:Bool]{}
    loop index in 0..<sema_finalize_seeded_taken(registration) -> taken[bodies.modules[index].module_identity.id] = true
    loop {
        if !jet_driver_local_values_open(bodies, stage, functions) -> break
        pending := [SemaComptimeBodySource]{}
        loop source in jet_driver_pending_comptime_body_sources(bodies.modules, values) {
            if taken.get(source.module_identity.id) == None -> pending.push(source.copy())
        }
        if pending.len() == 0 -> break
        again := false
        loop source in pending {
            site: "{source.module_identity.id}\n{source.key}"
            if tried.get(site) != None -> again = true
            tried[site] = true
        }
        if again -> break
        body_sources := [SemaComptimeItemSource]{}
        known := [String:Bool]{}
        loop source in pending -> jet_driver_comptime_body_source_add(body_sources, known, source)
        if !jet_driver_local_sources_only(body_sources) -> break
        run_diagnostics := [Diagnostic]{}
        run := jet_driver_run_comptime(
            registration, [SemaGraphModuleResult]{}, None, body_sources, values, functions,
            request, run_diagnostics,
        )
        finished_registration := run.graph.move()
        run.graph = None
        partial_registration := run.partial_graph.move()
        run.partial_graph = None
        registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
        if run.soft_stop || !run.complete || run.values.len() <= values.len() || run_diagnostics.len() > 0 {
            sema_graph_trail_undo(registration, run.trail)
            break
        }
        splice := sema_local_value_land(registration, run.trail, bodies.modules, body_sources, values, functions, run.values, run.functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink)
        registration = splice.graph.move()
        sema_graph_trail_undo(registration, run.trail)
        if !splice.spliced {
            sites := [String:Bool]{}
            loop source in body_sources -> sites["{source.module_identity.id}\n{source.key}"] = true
            refused = Val(JetDriverRefusedPass{sites: sites, base_values: values.len(), base_functions: functions.len(), values: run.values.move(), functions: run.functions.move(), trace: run.trace.move()})
            break
        }
        values = run.values.move()
        functions = run.functions.move()
        jet_driver_comptime_trace_append(trace, run.trace)
    }
    registration
}

// Whether the body half of a finalization (`bodies`) over the declaration
// `stage` and the comptime `functions` is complete and reports no error so
// far but the failure obligations its whole-program half settles
// (sema_local_values_blocked), which a body comptime pass needs to land
// before that half (jet_driver_land_local_values).
jet_driver_local_values_open: fn(bodies: SemaFinalizeBodies, stage: SemaComptimeDeclarationStage, functions: [SemaComptimeFunctionResult]) -> Bool Never! {
    if !bodies.complete || sema_local_values_blocked(stage.diagnostics) -> return false
    loop graph_module in bodies.modules {
        if !graph_module.complete || sema_local_values_blocked(graph_module.diagnostics) -> return false
    }
    function_diagnostics := [Diagnostic]{}
    sema_comptime_function_diagnostics(functions, function_diagnostics) && !sema_local_values_blocked(function_diagnostics)
}

// Whether every source of `sources` is a local value.
jet_driver_local_sources_only: fn(sources: [SemaComptimeItemSource]) -> Bool Never! {
    loop source in sources {
        if !source.local_value -> return false
    }
    true
}

// JET_RECHECK_VERIFY (JetDriverCompileRequest.recheck_verify) for the values
// landed before the whole-program half of the first finalization
// (jet_driver_land_local_values): finalizes the program again with every
// value applied, as a body pass's full recheck does, and puts the first rows
// in which `landed`, that finalization's result, differs from it
// (jet_driver_recheck_differences) in `problem`. The finalization starts
// from `start`, the codec and derive demand the first one started from (the
// item runs leave theirs pending, and the undo of the first one's generated
// bodies takes it off the graph). The registration graph moves in without
// staged edits and comes back the same.
jet_driver_verify_landed_values: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    landed: SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    start: &&SemaLocalSpliceDemand,
    request: JetDriverCompileRequest,
    problem: &String?,
) -> SemaRegistrationGraph {
    registration := graph.move()
    held := sema_local_splice_demand_swap(registration, start)
    trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(registration, values, trail)
    full := sema_finalize_graph(registration, trail, stage, values, functions, request.eval_config.host_hooks, request.compiler_threads, None, false, None)
    restored := full.registration_graph.move()
    full.registration_graph = None
    registration = restored.move() ?? panic("the verifying finalization lost its registration graph")
    sema_graph_trail_undo(registration, trail)
    _ := sema_local_splice_demand_swap(registration, held)
    differences: jet_driver_recheck_differences(landed, full, registration.module_table)
    if differences.len() > 0 -> problem = Val("JET_RECHECK_VERIFY: the local values landed before the whole-program passes differ from the full recheck:\n{differences.join("\n")}")
    registration
}
