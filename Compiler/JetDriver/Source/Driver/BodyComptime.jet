// Body expressions enter the ordinary comptime source/value graph. The
// canonical driver evaluator remains the sole execution path; this file owns
// body-site discovery, staging, and the value-fed function recheck boundary.
use {
    jet_foundation.[
        CompilerTraceSink,
        Diagnostic,
        FnBody,
        ModuleTable,
        NameTable,
        compiler_take_rows,
        module_text,
        name_column_table,
        name_find,
        name_index,
        name_intern,
        name_table_sized,
    ]
    jet_sema.[
        SemaComptimeBodySource,
        SemaComptimeDeclarationStage,
        SemaComptimeFunctionResult,
        SemaComptimeGraphFacts,
        SemaComptimeItemKind,
        SemaComptimeItemSource,
        SemaComptimeItemValue,
        SemaCoreSeal,
        SemaFinalizeBodies,
        SemaFunctionMemoryPlan,
        SemaGraphModuleResult,
        SemaGraphResult,
        SemaLocalSpliceDemand,
        SemaLocalSpliceInto,
        SemaPassFacts,
        SemaRegistrationGraph,
        sema_call_rule_batches,
        sema_call_rule_batches_land,
        sema_call_rules_held,
        sema_comptime_body_item_source,
        sema_comptime_function_diagnostics,
        sema_comptime_local_values_ahead,
        sema_comptime_graph_apply_values,
        SemaGraphTrail,
        sema_graph_trail_init,
        sema_graph_trail_undo,
        sema_finalize_graph,
        sema_local_splice_demand_snapshot,
        sema_local_splice_demand_swap,
        sema_local_value_land,
        sema_local_value_splice,
        sema_local_values_blocked,
        sema_name_facts_empty,
        sema_stage_declaration_modules,
    ]
}

JetDriverComptimeBodyResult: struct {
    graph: SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
    internal_problem: String?,
    // The registration graph the caller moved in, handed back on every exit
    // (a borrowed graph moved into a comptime run was copied whole).
    registration: SemaRegistrationGraph?{None},
}

// `result` with the registration graph moved back into it.
jet_driver_comptime_body_returning: fn(result: &&JetDriverComptimeBodyResult, registration: &&SemaRegistrationGraph) -> JetDriverComptimeBodyResult Never! {
    owned := result.move()
    owned.registration = Val(registration.move())
    owned
}

jet_driver_comptime_body_result: fn(
    graph: &&SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    complete: Bool,
    soft_stop: Bool,
) -> JetDriverComptimeBodyResult Never! {
    JetDriverComptimeBodyResult{
        graph: graph.move(),
        values: values,
        functions: functions,
        trace: trace,
        complete: complete,
        soft_stop: soft_stop,
        internal_problem: None,
    }
}

jet_driver_comptime_body_failure: fn(
    graph: &&SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    trace: JetDriverCompileTrace,
    problem: String?,
) -> JetDriverComptimeBodyResult Never! {
    result := jet_driver_comptime_body_result(graph, values, functions, trace, false, false)
    result.internal_problem = problem
    result
}

// Moves the text of `addition` onto `target`.
jet_driver_comptime_trace_append: fn(target: &JetDriverCompileTrace, addition: &JetDriverCompileTrace) Never! {
    target.stdout.extend(addition.stdout.move())
    target.stderr.extend(addition.stderr.move())
    if addition.exit_code != None -> target.exit_code = addition.exit_code
    target.soft_stop = target.soft_stop || addition.soft_stop
}

jet_driver_comptime_diagnostic_key: fn(diagnostic: Diagnostic) -> String Never! {
    span_start := -1
    span_end := -1
    if diagnostic.span == .Val(span) {
        span_start = span.start
        span_end = span.end
    }
    source_path := ""
    if diagnostic.source_path == .Val(path) -> source_path = path
    source_offset := -1
    if diagnostic.source_offset == .Val(offset) -> source_offset = offset
    source_start := -1
    if diagnostic.source_start == .Val(start) -> source_start = start
    detail := ""
    if diagnostic.detail == .Val(value) -> detail = value
    "{diagnostic.severity}:{diagnostic.code.len()}:{diagnostic.code}:{span_start}:{span_end}:{source_path.len()}:{source_path}:{source_offset}:{source_start}:{diagnostic.what.len()}:{diagnostic.what}:{diagnostic.why.len()}:{diagnostic.why}:{diagnostic.fix.len()}:{diagnostic.fix}:{detail.len()}:{detail}"
}

// Adds each of `incoming` that matches no diagnostic already in `diagnostics`
// (or added before it). A later pass reports the diagnostics of an earlier
// one again, in its own order, so an added one takes its place among them:
// just before the existing diagnostic the next repeated one matches, and
// last when no repeated one follows it. A call whose errors waited on its
// rules' answers is reported in its place in the source, not after the
// rest. The keys of the existing diagnostics are taken once per call
// instead of recomputing every existing key for each addition.
jet_driver_comptime_diagnostics_add: fn(diagnostics: &[Diagnostic], incoming: [Diagnostic]) Never! {
    if incoming.len() == 0 {
        return
    }
    seen := name_column_table(diagnostics.len() + incoming.len())
    // The row of the first existing diagnostic of each key id; id 0 is the
    // empty spelling, which no key is.
    rows := [Int]{-1}
    loop row in 0..<diagnostics.len() {
        if name_index(name_intern(seen, jet_driver_comptime_diagnostic_key(diagnostics[row]))) == rows.len() {
            rows.push(row)
        }
    }
    existing: rows.len()
    // Each incoming diagnostic's existing row; -1 when it is added, -2 when
    // it repeats one added or matched before it. Only the first repeat of an
    // existing diagnostic marks its place.
    places := [Int]{}
    fresh := existing
    loop diagnostic in incoming {
        id: name_index(name_intern(seen, jet_driver_comptime_diagnostic_key(diagnostic)))
        if {
            id < existing -> {
                places.push(rows[id])
                rows[id] = -2
            }
            id == fresh -> {
                fresh += 1
                places.push(-1)
            }
            else -> places.push(-2)
        }
    }
    if fresh == existing {
        return
    }
    // The row each added diagnostic goes before (the length for last).
    before := loop _ in incoming -> diagnostics.len()
    following := diagnostics.len()
    walk := incoming.len()
    loop walk > 0 {
        walk -= 1
        if {
            places[walk] >= 0 -> following = places[walk]
            places[walk] == -1 -> before[walk] = following
        }
    }
    // Each row's added diagnostics, chained through `link` last first, so
    // the list built back to front and then reversed has a row's added
    // diagnostics before it in their incoming order.
    head := loop _ in 0..<diagnostics.len() + 1 -> -1
    link := loop _ in incoming -> -1
    loop index in 0..<incoming.len() {
        if places[index] == -1 {
            link[index] = head[before[index]]
            head[before[index]] = index
        }
    }
    earlier := compiler_take_rows<Diagnostic>(diagnostics)
    merged := [Diagnostic]{}
    row := earlier.len()
    loop {
        at := head[row]
        loop at >= 0 {
            merged.push(incoming[at].copy())
            at = link[at]
        }
        if row == 0 -> break
        row -= 1
        merged.push(earlier.pop() ?? panic("a diagnostic row failed to pop"))
    }
    merged.reverse()
    diagnostics = merged.move()
}

// A run returns its one graph on every exit, with later edits in its trail.
jet_driver_comptime_take_registration: fn(finished: &&SemaRegistrationGraph?, partial: &&SemaRegistrationGraph?) -> SemaRegistrationGraph Never! {
    if finished == .Val(graph) -> return graph.move()
    partial.move() ?? panic("a comptime run lost its registration graph")
}

// `known` holds the `module\nkey` of every source already added.
jet_driver_comptime_body_source_add: fn(
    sources: &[SemaComptimeItemSource],
    known: &NameTable,
    source: SemaComptimeBodySource,
) Never! {
    item := sema_comptime_body_item_source(source)
    key: "{item.module_identity.id}\n{item.key}"
    if name_find(known, key) != None {
        return
    }
    _ := name_intern(known, key)
    sources.push(item)
}

// A body source's place in a graph: `owner`, the row of the module it sits
// in, and `row`, its row among that module's sources
// (SemaGraphModuleResult.comptime_body_sources).
JetDriverBodySourceRow: struct {
    owner: Int,
    row: Int,
}

// The body sources of `modules` that `values` holds no staged value for,
// the first of each `module\nkey`, by place: a caller copies only the
// sources it goes on to take.
jet_driver_pending_comptime_body_rows: fn(
    modules: [SemaGraphModuleResult],
    values: [SemaComptimeItemValue],
) -> [JetDriverBodySourceRow] Never! {
    // The `module\nkey` of every staged body value, collected once rather
    // than rescanning every value per source.
    present := name_column_table(values.len())
    loop value in values {
        if value.kind == SemaComptimeItemKind.BodyExpression {
            _ := name_intern(present, "{value.module_identity.id}\n{value.key}")
        }
    }
    rows := [JetDriverBodySourceRow]{}
    seen := name_table_sized(2)
    loop (owner, graph_module) in modules {
        loop (row, source) in graph_module.comptime_body_sources {
            key: "{source.module_identity.id}\n{source.key}"
            if name_find(seen, key) != None -> next
            _ := name_intern(seen, key)
            if name_find(present, key) == None -> rows.push(JetDriverBodySourceRow{owner: owner, row: row})
        }
    }
    rows
}

// The body sources at `rows` of `modules` (jet_driver_pending_comptime_body_rows).
jet_driver_comptime_body_sources_at: fn(modules: [SemaGraphModuleResult], rows: [JetDriverBodySourceRow]) -> [SemaComptimeBodySource] Never! {
    sources := [SemaComptimeBodySource]{}
    loop at in rows {
        sources.push(modules[at.owner].comptime_body_sources[at.row].copy())
    }
    sources
}

jet_driver_pending_comptime_body_sources: fn(
    modules: [SemaGraphModuleResult],
    values: [SemaComptimeItemValue],
) -> [SemaComptimeBodySource] Never! {
    jet_driver_comptime_body_sources_at(modules, jet_driver_pending_comptime_body_rows(modules, values))
}

// Whether a pending source is a call a check rule hears.
jet_driver_comptime_rules_pending: fn(pending: [SemaComptimeBodySource]) -> Bool Never! {
    loop source in pending {
        if source.rule != None -> return true
    }
    false
}

// Whether the body recheck or the checked-text validation evaluates over
// `graph` and so reads its name facts (jet_driver_comptime_body_pass,
// jet_driver_validate_checked_text).
jet_driver_comptime_reads_names: fn(graph: SemaGraphResult, values: [SemaComptimeItemValue]) -> Bool Never! {
    if jet_driver_pending_comptime_body_rows(graph.modules, values).len() > 0 -> return true
    loop graph_module in graph.modules {
        loop call in graph_module.comptime_requests {
            if call.checked_text != None -> return true
        }
    }
    false
}

jet_driver_comptime_body_stage: fn(
    stage: SemaComptimeDeclarationStage,
    graph: &&SemaGraphResult,
    sources: &&[SemaComptimeItemSource],
) -> SemaComptimeDeclarationStage Never! {
    // The successful evaluation retired the old graph; its resolved modules
    // now belong to the recheck stage, never to a second copied graph. The
    // recheck reads only their declarations, so their checked bodies, the
    // graph's merged rows and its name facts are freed here, before it checks
    // every body again.
    retired := graph.move()
    SemaComptimeDeclarationStage{
        modules: sema_stage_declaration_modules(retired.modules),
        imports: stage.imports,
        package_policies: stage.package_policies,
        names: sema_name_facts_empty(),
        sources: sources.move(),
        diagnostics: stage.diagnostics,
        complete: stage.complete,
    }
}

// The caller moves its registration graph in and takes it back from
// `registration` of the result (every exit returns it). The run's values,
// closures and trace move in too; the result hands them back.
jet_driver_orchestrate_comptime_bodies: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: &&[SemaComptimeItemValue],
    initial_functions: &&[SemaComptimeFunctionResult],
    initial_trace: &&JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeBodyResult {
    jet_driver_comptime_body_pass(
        graph,
        stage,
        initial_graph,
        initial_values,
        initial_functions,
        initial_trace,
        load,
        request,
        diagnostics,
        0,
    )
}

// Each bounded pass owns its graphs until evaluation succeeds, then moves
// them into rechecking. Like pure folding, passes thread ownership through
// calls instead of copying a graph across a loop backedge.
jet_driver_comptime_body_pass: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: &&[SemaComptimeItemValue],
    initial_functions: &&[SemaComptimeFunctionResult],
    initial_trace: &&JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
    completed_passes: Int,
) -> JetDriverComptimeBodyResult {
    registration := graph.move()
    current_graph := initial_graph.move()
    values := initial_values.move()
    functions := initial_functions.move()
    trace := initial_trace.move()
    if current_graph.modules.len() != registration.modules.len() {
        return jet_driver_comptime_body_returning(
            jet_driver_comptime_body_failure(
                current_graph,
                values,
                functions,
                trace,
                Val("semantic body rechecking did not return every registered module"),
            ),
            registration,
        )
    }
    jet_driver_comptime_diagnostics_add(diagnostics, current_graph.diagnostics)
    jet_driver_trace_step_begin(request.trace_sink, "comptime.body.pending")
    pending := jet_driver_pending_comptime_body_sources(current_graph.modules, values)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.pending", pending.len())
    if request.trace_sink == .Val(sink) {
        sink.progress("counters.comptime.bodies_pending", pending.len(), -1)
    }
    if current_graph.complete && pending.len() == 0 && !jet_driver_has_errors(current_graph.diagnostics) {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, true, false), registration)
    }
    if pending.len() == 0 {
        if !jet_driver_has_errors(current_graph.diagnostics) && !jet_driver_has_errors(diagnostics) {
            problem := jet_driver_totality_problem("semantic body rechecking did not return a complete resolved package graph", "sema.body", current_graph.modules, registration.module_table)
            return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(current_graph, values, functions, trace, Val(problem)), registration)
        }
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, false, false), registration)
    }
    // JET_KEEP_GOING: pending bodies still run past reported errors, so the
    // functions whose bodies need their values still lower. The calls the
    // check rules hear still run those rules, and only those, so a module
    // with other errors still reports each rule's rejection; a rejection
    // replaces the call's held errors.
    rules_only := false
    if jet_driver_has_errors(current_graph.diagnostics) && !registration.keep_going {
        if !jet_driver_comptime_rules_pending(pending) {
            return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, values, functions, trace, false, false), registration)
        }
        rules_only = true
    }
    pass: completed_passes + 1
    if pass > 256 {
        return jet_driver_comptime_body_returning(
            jet_driver_comptime_body_failure(
                current_graph,
                values,
                functions,
                trace,
                Val("body comptime rechecking exceeded its bounded progress limit"),
            ),
            registration,
        )
    }
    // The calls each rule hears run as one batch item, after the other
    // sources (sema_call_rule_batches).
    held: sema_call_rules_held(pending)
    body_sources := [SemaComptimeItemSource]{}
    known := name_column_table(pending.len())
    loop source in pending {
        if source.rule != None || rules_only -> next
        jet_driver_comptime_body_source_add(body_sources, known, source)
    }
    batches := sema_call_rule_batches(registration, pending, pass, body_sources)
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.run", body_sources, pass)
    memory_plan := [SemaFunctionMemoryPlan]{}
    run := jet_driver_run_comptime(registration, [SemaGraphModuleResult]{}, None, body_sources, values, functions, request, diagnostics, memory_plan)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.run", body_sources.len())
    finished_registration := run.graph.move()
    run.graph = None
    partial_registration := run.partial_graph.move()
    run.partial_graph = None
    registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
    jet_driver_comptime_trace_append(trace, run.trace)
    if run.soft_stop {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(current_graph, run.values, run.functions, trace, false, true), registration)
    }
    if !run.complete {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_failure(current_graph, run.values, run.functions, trace, run.internal_problem), registration)
    }
    if run.values.len() <= values.len() {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_returning(
            jet_driver_comptime_body_failure(
                current_graph,
                values,
                functions,
                trace,
                Val("body comptime rechecking made no staged-value progress"),
            ),
            registration,
        )
    }
    earlier_values := values.move()
    earlier_functions := functions.move()
    values = run.values.move()
    functions = run.functions.move()
    rejected: sema_call_rule_batches_land(batches, values)
    // A pass that ran only rules, none of which rejected a call or kept a
    // call's errors waiting, changes no checked body: the graph stands.
    if batches.len() > 0 && body_sources.len() == batches.len() && !held && !rejected && current_graph.complete {
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_pass(registration, stage, current_graph, values, functions, trace, load, request, diagnostics, pass)
    }
    // A pass that landed only local values lands them in the bodies that
    // hold them (JetSema Comptime/LocalSplice.jet); under `recheck_verify`
    // the full recheck runs too, and the two results must agree.
    full_input := SemaGraphResult?{None}
    if request.recheck_verify -> full_input = Val(current_graph.copy())
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.splice", body_sources, pass)
    splice := sema_local_value_splice(registration, run.trail, current_graph, body_sources, earlier_values, earlier_functions, values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.splice", body_sources.len())
    registration = splice.graph.move()
    if splice.spliced {
        if full_input.move() == .Val(unspliced) {
            full := jet_driver_recheck_comptime_bodies(registration, run.trail, stage, unspliced, body_sources, values, functions, request, pass)
            verified := full.registration_graph.move()
            full.registration_graph = None
            registration = verified.move() ?? panic("body finalization lost its registration graph")
            differences: jet_driver_recheck_differences(current_graph, full, registration.module_table)
            if differences.len() > 0 {
                lines: differences.join("\n")
                sema_graph_trail_undo(registration, run.trail)
                return jet_driver_comptime_body_returning(
                    jet_driver_comptime_body_failure(
                        current_graph,
                        values,
                        functions,
                        trace,
                        Val("JET_RECHECK_VERIFY: the spliced local values differ from the full recheck:\n{lines}"),
                    ),
                    registration,
                )
            }
        }
        sema_graph_trail_undo(registration, run.trail)
        return jet_driver_comptime_body_pass(
            registration,
            stage,
            current_graph,
            values,
            functions,
            trace,
            load,
            request,
            diagnostics,
            pass,
        )
    }
    // The refused splice was the last reader of the values and closures the
    // finalization was checked against.
    earlier_values = [SemaComptimeItemValue]{}
    earlier_functions = [SemaComptimeFunctionResult]{}
    // The run's graph already carries every value: the recheck finalizes it
    // in place instead of copying the registration graph.
    rechecked := jet_driver_recheck_comptime_bodies(
        registration,
        run.trail,
        stage,
        current_graph,
        body_sources,
        values,
        functions,
        request,
        pass,
    )
    restored := rechecked.registration_graph.move()
    rechecked.registration_graph = None
    registration = restored.move() ?? panic("body finalization lost its registration graph")
    sema_graph_trail_undo(registration, run.trail)
    jet_driver_comptime_body_pass(
        registration,
        stage,
        rechecked,
        values,
        functions,
        trace,
        load,
        request,
        diagnostics,
        pass,
    )
}

// JET_RECHECK_VERIFY (JetDriverCompileRequest.recheck_verify): the first
// rows, at most 20, in which the result of a pass that spliced its local
// values (`spliced`) differs from the full recheck of that pass (`full`),
// one line each. A body only one of them checked is listed by its key.
jet_driver_recheck_differences: fn(spliced: SemaGraphResult, full: SemaGraphResult, table: ModuleTable) -> [String] Never! {
    differences := [String]{}
    if spliced.modules.len() != full.modules.len() {
        differences.push("modules: {spliced.modules.len()} spliced, {full.modules.len()} rechecked")
        return differences
    }
    loop module_index in 0..<spliced.modules.len() {
        ours: spliced.modules[module_index]
        theirs: full.modules[module_index]
        name: module_text(table, ours.module_identity)
        jet_driver_recheck_body_differences(name, ours.functions, theirs.functions, differences)
        if "{ours.call_facts:Debug}" != "{theirs.call_facts:Debug}" {
            differences.push("{name}: call facts differ")
        }
        if "{ours.name_references:Debug}" != "{theirs.name_references:Debug}" {
            differences.push("{name}: name references differ")
        }
        if "{ours.comptime_body_sources:Debug}" != "{theirs.comptime_body_sources:Debug}" {
            differences.push("{name}: body comptime sites differ")
        }
        if "{ours.diagnostics:Debug}" != "{theirs.diagnostics:Debug}" {
            differences.push("{name}: diagnostics differ: {jet_driver_recheck_diagnostic_difference(ours.diagnostics, theirs.diagnostics)}")
        }
        if "{ours.failure_facts:Debug}" != "{theirs.failure_facts:Debug}" {
            differences.push("{name}: failure facts differ")
        }
        our_rows := ours.copy()
        our_rows.functions = [FnBody]{}
        their_rows := theirs.copy()
        their_rows.functions = [FnBody]{}
        if "{our_rows:Debug}" != "{their_rows:Debug}" {
            differences.push("{name}: module rows differ")
        }
        if differences.len() >= 20 -> return differences
    }
    if jet_driver_recheck_graph_rows(spliced) != jet_driver_recheck_graph_rows(full) {
        detail: if "{spliced.diagnostics:Debug}" != "{full.diagnostics:Debug}" -> ": diagnostics: {jet_driver_recheck_diagnostic_difference(spliced.diagnostics, full.diagnostics)}" else -> ""
        differences.push("graph rows differ{detail}")
    }
    differences
}

// How the diagnostics of the splice (`ours`) and of the recheck (`theirs`)
// differ: their counts and the first one each holds that the other lacks.
jet_driver_recheck_diagnostic_difference: fn(ours: [Diagnostic], theirs: [Diagnostic]) -> String Never! {
    "{ours.len()} spliced, {theirs.len()} rechecked; first only spliced: {jet_driver_recheck_first_missing(ours, theirs)}; first only rechecked: {jet_driver_recheck_first_missing(theirs, ours)}"
}

// The first diagnostic of `diagnostics` that `others` lacks, by code, span
// and text; "none" when there is none.
jet_driver_recheck_first_missing: fn(diagnostics: [Diagnostic], others: [Diagnostic]) -> String Never! {
    present := name_column_table(others.len())
    loop diagnostic in others -> _ := name_intern(present, "{diagnostic:Debug}")
    loop diagnostic in diagnostics {
        if name_find(present, "{diagnostic:Debug}") == None {
            return "{diagnostic.code} at {diagnostic.span:Debug}: {diagnostic.what}"
        }
    }
    "none"
}

// The graph rows of `graph` outside its modules, as one display. The
// registration graph stays out: it holds the shared lookup counters
// (`Shared<SemaLookupCounters>`), which have no display.
jet_driver_recheck_graph_rows: fn(graph: SemaGraphResult) -> String Never! {
    "{graph.package_identity:Debug} {graph.entry_module_identity:Debug} {graph.imports:Debug} {graph.package_policies:Debug} {graph.core_usage:Debug} {graph.call_facts:Debug} {graph.hardware_use:Debug} {graph.comptime_requests:Debug} {graph.comptime_body_sources:Debug} {graph.compute_facts:Debug} {graph.names:Debug} {graph.diagnostics:Debug} {graph.complete} {graph.inferred_infallible:Debug} {graph.programs:Debug} {graph.outputs:Debug} {graph.memory_declarations:Debug} {graph.memory_projections:Debug}"
}

// The bodies of module `name` that differ between the splice (`ours`) and
// the recheck (`theirs`), into `differences`: each body by its key, or, when
// the two checked different bodies, each body only one of them checked.
jet_driver_recheck_body_differences: fn(name: String, ours: [FnBody], theirs: [FnBody], differences: &[String]) Never! {
    if ours.len() == theirs.len() {
        loop index in 0..<ours.len() {
            if "{ours[index]:Debug}" != "{theirs[index]:Debug}" {
                differences.push("{name}: body {ours[index].key} differs")
            }
        }
        return
    }
    rechecked := name_column_table(theirs.len())
    loop function in theirs -> _ := name_intern(rechecked, function.key)
    kept := name_column_table(ours.len())
    loop function in ours {
        _ := name_intern(kept, function.key)
        if name_find(rechecked, function.key) == None {
            differences.push("{name}: body {function.key} checked only in the splice")
        }
    }
    loop function in theirs {
        if name_find(kept, function.key) == None {
            differences.push("{name}: body {function.key} checked only in the recheck")
        }
    }
}

// As jet_driver_orchestrate_comptime_bodies: the registration graph moves in
// and comes back in `registration` of the result.
jet_driver_validate_checked_text: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    initial_graph: &&SemaGraphResult,
    initial_values: [SemaComptimeItemValue],
    initial_functions: [SemaComptimeFunctionResult],
    initial_trace: JetDriverCompileTrace,
    load: JetDriverLoadResult,
    request: JetDriverCompileRequest,
    diagnostics: &[Diagnostic],
) -> JetDriverComptimeBodyResult {
    registration := graph.move()
    sources := [SemaComptimeItemSource]{}
    known := name_table_sized(2)
    loop module_index in 0..<initial_graph.modules.len() {
        loop call in initial_graph.modules[module_index].comptime_requests {
            if call.checked_text == .Val(evaluation) {
                jet_driver_comptime_checked_text_source_add(sources, known, evaluation)
            }
        }
    }
    if sources.len() == 0 {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(initial_graph, initial_values, initial_functions, initial_trace, true, false), registration)
    }
    memory_plan := [SemaFunctionMemoryPlan]{}
    run := jet_driver_run_comptime(
        registration,
        [SemaGraphModuleResult]{},
        None,
        sources,
        initial_values,
        initial_functions,
        request,
        diagnostics,
        memory_plan,
    )
    finished_registration := run.graph.move()
    run.graph = None
    partial_registration := run.partial_graph.move()
    run.partial_graph = None
    registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
    sema_graph_trail_undo(registration, run.trail)
    trace := initial_trace
    jet_driver_comptime_trace_append(trace, run.trace)
    if run.soft_stop {
        return jet_driver_comptime_body_returning(jet_driver_comptime_body_result(initial_graph, run.values, run.functions, trace, false, true), registration)
    }
    if !run.complete {
        result := jet_driver_comptime_body_result(initial_graph, run.values, run.functions, trace, false, false)
        result.internal_problem = run.internal_problem
        if result.internal_problem == None && !jet_driver_has_errors(diagnostics) {
            result.internal_problem = Val("checked text evaluation did not return a complete validation or diagnostic")
        }
        return jet_driver_comptime_body_returning(result, registration)
    }
    merged_graph := initial_graph.move()
    if jet_driver_merge_checked_text_functions(merged_graph, registration.module_table, run.functions) == .Val(problem) {
        return jet_driver_comptime_body_returning(
            jet_driver_comptime_body_failure(
                merged_graph,
                run.values,
                run.functions,
                trace,
                Val(problem),
            ),
            registration,
        )
    }
    registration = jet_driver_merged_names(merged_graph, registration, request.compiler_threads)
    jet_driver_comptime_body_returning(jet_driver_comptime_body_result(merged_graph, run.values, run.functions, trace, true, false), registration)
}

// Finalizes the rechecked bodies against the moved-in registration graph,
// recording its edits on `trail`; the graph comes back in the result's
// `registration_graph` with the edits still applied (the caller undoes them).
jet_driver_recheck_comptime_bodies: fn(
    graph: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    stage: SemaComptimeDeclarationStage,
    semantic_graph: &&SemaGraphResult,
    body_sources: &&[SemaComptimeItemSource],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    request: JetDriverCompileRequest,
    pass: Int,
) -> SemaGraphResult {
    jet_driver_trace_body_begin(request.trace_sink, "comptime.body.recheck", body_sources, pass)
    body_stage := jet_driver_comptime_body_stage(stage, semantic_graph, body_sources)
    rechecked := sema_finalize_graph(graph, trail, body_stage, values, comptime_functions, request.eval_config.host_hooks, request.compiler_threads, true, request.trace_sink)
    jet_driver_trace_step_end(request.trace_sink, "comptime.body.recheck", rechecked.modules.len())
    rechecked
}

// Opens a span of body pass `pass` whose detail names the bodies it
// evaluates, so a trace attributes each pass's run, splice and recheck.
jet_driver_trace_body_begin: fn(trace_sink: CompilerTraceSink?, name: String, body_sources: [SemaComptimeItemSource], pass: Int) {
    if trace_sink == .Val(sink) {
        names := [String]{}
        loop source in body_sources -> names.push(source.name)
        sink.begin(name, names.join(", "), pass, -1)
    }
}

// What the first finalization's landings (jet_driver_land_local_values) hand
// on: whether a landing ended with a site pending, after which no later
// landing runs.
JetDriverLanding: struct {
    stopped: Bool,
    staging: [JetDriverComptimeStaging]{[JetDriverComptimeStaging]{}},
}

// Lands each body comptime pass whose pending sites are all local values in
// the modules of the first finalization (`bodies`) before its whole-program
// half (sema_finalize_program), so that half runs once, over every value,
// instead of once before the pass and again after it
// (sema_local_value_land). The driver lands before the Core demand and after
// each of its rounds (`into`): first after the body half
// (sema_finalize_bodies, `Undemanded`), where the demand's first round
// (sema_finalize_demand) reads the landed bodies and demands what every
// comptime function names, as the full recheck's does, so a pass may name
// any Core body; then after each round (`Unstamped`), for the sites of the
// Core bodies it checked. The comptime functions such a landing adds get
// the next round (`demand_round`), which the full recheck gives them too, so
// they may name any Core body as well. A pass that cannot land cleanly (an
// error other than a failure obligation or an incomplete check so far, a
// site that is neither a local value nor an explicit `name: #run value`
// local (jet_driver_local_sources_only) or that an earlier pass already took, a run
// that reports anything, stops, does not complete or adds no value, or a
// splice that does not hold) is dropped, and the body passes after
// finalization (jet_driver_orchestrate_comptime_bodies) take its sites as
// before. A landing that ends with a site pending stops `landing`, and a
// stopped landing runs no pass: the later landing's pass would hold the
// earlier's sites again. The registration graph moves in and comes back with
// no edit; `values`, `functions` and `trace` take what the landed passes add.
jet_driver_land_local_values: fn(
    graph: &&SemaRegistrationGraph,
    bodies: &SemaFinalizeBodies,
    into: SemaLocalSpliceInto,
    stage: SemaComptimeDeclarationStage,
    values: &[SemaComptimeItemValue],
    functions: &[SemaComptimeFunctionResult],
    trace: &JetDriverCompileTrace,
    request: JetDriverCompileRequest,
    landing: &JetDriverLanding,
) -> SemaRegistrationGraph {
    registration := graph.move()
    if landing.stopped -> return registration
    tried := name_table_sized(2)
    loop {
        // Every exit but the one with no site pending stops the landing.
        // The trace times the landing's steps on this thread
        // (`comptime.land.*`) around the run's and the splice's own spans.
        landing.stopped = true
        jet_driver_trace_step_begin(request.trace_sink, "comptime.land.open")
        open: jet_driver_local_values_open(bodies, stage, functions)
        rows: if open -> jet_driver_pending_comptime_body_rows(bodies.modules, values) else -> [JetDriverBodySourceRow]{}
        jet_driver_trace_step_end(request.trace_sink, "comptime.land.open", rows.len())
        if !open -> break
        if rows.len() == 0 {
            landing.stopped = false
            break
        }
        // A site pending again ends the landing, so it ends.
        again := false
        loop at in rows {
            site: "{bodies.modules[at.owner].comptime_body_sources[at.row].module_identity.id}\n{bodies.modules[at.owner].comptime_body_sources[at.row].key}"
            if name_find(tried, site) != None -> again = true
            _ := name_intern(tried, site)
        }
        if again -> break
        // A site that is neither a local value nor a `name: #run value`
        // local ends the landing before any source is copied.
        if !jet_driver_local_sources_only(bodies.modules, rows) -> break
        pending: jet_driver_comptime_body_sources_at(bodies.modules, rows)
        // The sites whose values the comptime phase computed ahead land
        // those (sema_comptime_local_values_ahead); a run computes the rest,
        // and none runs when no site is left.
        ahead := sema_comptime_local_values_ahead(values, pending)
        body_sources := [SemaComptimeItemSource]{}
        run_sources := [SemaComptimeItemSource]{}
        known := name_column_table(pending.len())
        loop index in 0..<pending.len() {
            added: body_sources.len()
            jet_driver_comptime_body_source_add(body_sources, known, pending[index])
            if body_sources.len() > added && !ahead.covered[index] {
                run_sources.push(sema_comptime_body_item_source(pending[index]))
            }
        }
        if run_sources.len() == 0 {
            jet_driver_trace_step_begin(request.trace_sink, "comptime.land.splice")
            // copy: the splice checks the owners with the values before the
            // pass and with these.
            landed_values := values.copy()
            landed_values.extend(ahead.values.move())
            trail := sema_graph_trail_init()
            splice := sema_local_value_land(registration, trail, bodies.modules, into, body_sources, values, functions, landed_values, functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies.carried)
            registration = splice.graph.move()
            jet_driver_trace_step_end(request.trace_sink, "comptime.land.splice", body_sources.len())
            sema_graph_trail_undo(registration, trail)
            if !splice.spliced -> break
            values = landed_values.move()
            next
        }
        run_diagnostics := [Diagnostic]{}
        // The run's checks record the codecs and derived methods they reach
        // into the graph's demand, which the Core demand after an
        // `Undemanded` landing would generate. The pass's owner checks
        // demand what its comptime results captured (SemaDemandCapture), as
        // the full recheck's do, so the graph's demand goes back to what it
        // held before the run.
        held_demand := sema_local_splice_demand_snapshot(registration)
        // The finalization's memory plan, boxed edges and copy facts serve
        // the run: they read only the nominal and function declarations, and
        // the run's graph edits change only constant types.
        lent := jet_driver_carried_lend(bodies.carried)
        graph_facts: lent.graph_facts.move()
        lent.graph_facts = None
        body_types := 0
        body_impls := 0
        loop checked in bodies.modules {
            body_types += checked.declarations.type_defs.len()
            body_impls += checked.declarations.impls.len()
        }
        reuse_staging: landing.staging.len() > 0 && landing.staging[0].staged && landing.staging[0].module_count == bodies.modules.len() && landing.staging[0].type_count == body_types && landing.staging[0].impl_count == body_impls && values.len() >= landing.staging[0].landed
        lent_declared := if reuse_staging -> [SemaGraphModuleResult]{} else -> compiler_take_rows<SemaGraphModuleResult>(bodies.modules)
        if !reuse_staging -> landing.staging = [JetDriverComptimeStaging]{}
        run := jet_driver_run_comptime_carried(
            registration,
            lent_declared,
            graph_facts,
            run_sources,
            values,
            functions,
            request,
            run_diagnostics,
            lent.memory_plan,
            landing.staging,
        )
        if !reuse_staging -> bodies.modules = run.declared.move()
        returned: run.graph_facts.move()
        run.graph_facts = None
        jet_driver_carried_return(bodies.carried, lent, returned)
        finished_registration := run.graph.move()
        run.graph = None
        partial_registration := run.partial_graph.move()
        run.partial_graph = None
        registration = jet_driver_comptime_take_registration(finished_registration, partial_registration)
        _ := sema_local_splice_demand_swap(registration, held_demand)
        if run.soft_stop || !run.complete || run.values.len() <= values.len() || run_diagnostics.len() > 0 {
            sema_graph_trail_undo(registration, run.trail)
            break
        }
        landing.staging = run.carried_staging.move()
        run.values.extend(ahead.values.move())
        jet_driver_trace_step_begin(request.trace_sink, "comptime.land.splice")
        splice := sema_local_value_land(registration, run.trail, bodies.modules, into, body_sources, values, functions, run.values, run.functions, request.eval_config.host_hooks, request.compiler_threads, request.trace_sink, bodies.carried)
        registration = splice.graph.move()
        jet_driver_trace_step_end(request.trace_sink, "comptime.land.splice", body_sources.len())
        jet_driver_trace_step_begin(request.trace_sink, "comptime.land.undo")
        sema_graph_trail_undo(registration, run.trail)
        jet_driver_trace_step_end(request.trace_sink, "comptime.land.undo", 1)
        if !splice.spliced -> break
        // The closures the pass adds are demanded in the next round of the
        // Core demand, after the bodies whose sites they serve.
        jet_driver_trace_step_begin(request.trace_sink, "comptime.land.carry")
        loop index in functions.len()..<run.functions.len() {
            run.functions[index].demand_round = bodies.core_tally.rounds
        }
        values = run.values.move()
        functions = run.functions.move()
        jet_driver_comptime_trace_append(trace, run.trace)
        jet_driver_trace_step_end(request.trace_sink, "comptime.land.carry", values.len())
    }
    registration
}

// A finalization's pass facts (its one carried row) lent to a comptime run
// (jet_driver_run_comptime): the memory plan in the run's one-row slot, the
// boxed edges and copy facts as its graph facts, and the fixed-length write
// parameters, which the run does not read, held until they go back.
JetDriverLentFacts: struct {
    memory_plan: [SemaFunctionMemoryPlan],
    graph_facts: SemaComptimeGraphFacts?,
    fixed_length_write_params: [String],
}

// Moves the facts out of `carried` (sema_finalize_pass_close) for a
// comptime run. An empty `carried` lends nothing: an empty slot and None.
jet_driver_carried_lend: fn(carried: &[SemaPassFacts]) -> JetDriverLentFacts Never! {
    lent := JetDriverLentFacts{memory_plan: [SemaFunctionMemoryPlan]{}, graph_facts: None, fixed_length_write_params: [String]{}}
    facts: carried.pop() ?? return lent
    lent.memory_plan.push(facts.memory_plan.move())
    lent.graph_facts = Val(SemaComptimeGraphFacts{boxed_edges: facts.boxed_edges.move(), copy_facts: facts.copy_facts.move()})
    lent.fixed_length_write_params = facts.fixed_length_write_params.move()
    lent
}

// Moves the facts jet_driver_carried_lend lent to a comptime run back into
// `carried`, with the graph facts the run handed back (`returned`), which a
// run hands back on every exit.
jet_driver_carried_return: fn(carried: &[SemaPassFacts], lent: &&JetDriverLentFacts, returned: &&SemaComptimeGraphFacts?) Never! {
    owned := lent.move()
    plan: owned.memory_plan.pop() ?? return
    graph_facts: returned.move() ?? panic("a comptime run lost the finalization's boxed edges and copy facts")
    carried.push(SemaPassFacts{memory_plan: plan.move(), fixed_length_write_params: owned.fixed_length_write_params.move(), boxed_edges: graph_facts.boxed_edges.move(), copy_facts: graph_facts.copy_facts.move()})
}

// Whether the body half of a finalization (`bodies`) over the declaration
// `stage` and the comptime `functions` is complete and reports no error so
// far but the failure obligations its whole-program half settles
// (sema_local_values_blocked), which a body comptime pass needs to land
// before that half (jet_driver_land_local_values).
jet_driver_local_values_open: fn(bodies: SemaFinalizeBodies, stage: SemaComptimeDeclarationStage, functions: [SemaComptimeFunctionResult]) -> Bool Never! {
    if !bodies.complete || sema_local_values_blocked(stage.diagnostics) -> return false
    loop graph_module in bodies.modules {
        if !graph_module.complete || sema_local_values_blocked(graph_module.diagnostics) {
            return false
        }
    }
    function_diagnostics := [Diagnostic]{}
    sema_comptime_function_diagnostics(functions, function_diagnostics) && !sema_local_values_blocked(function_diagnostics)
}

// Whether every body source at `rows` of `modules` is a local value or an
// explicit `name: #run value` local (SemaComptimeBodySource.local_binding).
jet_driver_local_sources_only: fn(modules: [SemaGraphModuleResult], rows: [JetDriverBodySourceRow]) -> Bool Never! {
    loop at in rows {
        if !modules[at.owner].comptime_body_sources[at.row].local_value && !modules[at.owner].comptime_body_sources[at.row].local_binding {
            return false
        }
    }
    true
}

// JET_RECHECK_VERIFY (JetDriverCompileRequest.recheck_verify) for the values
// landed before the whole-program half of the first finalization
// (jet_driver_land_local_values): finalizes the program again with every
// value applied, as a body pass's full recheck does, and puts the first rows
// in which `landed`, that finalization's result, differs from it
// (jet_driver_recheck_differences) in `problem`. The finalization starts
// from `start`, the codec and derive demand the first one started from (the
// item runs leave theirs pending, and the undo of the first one's generated
// bodies takes it off the graph), and stands in the Core functions of
// `stand_ins`, the seal the first one's stand-ins were read from (None: it
// checked the Core bodies themselves), as the first one did. The
// registration graph moves in without staged edits and comes back the same.
jet_driver_verify_landed_values: fn(
    graph: &&SemaRegistrationGraph,
    stage: SemaComptimeDeclarationStage,
    landed: SemaGraphResult,
    values: [SemaComptimeItemValue],
    functions: [SemaComptimeFunctionResult],
    start: &&SemaLocalSpliceDemand,
    stand_ins: &&SemaCoreSeal?,
    request: JetDriverCompileRequest,
    problem: &String?,
) -> SemaRegistrationGraph {
    registration := graph.move()
    held := sema_local_splice_demand_swap(registration, start)
    registration.core_stand_ins = stand_ins.move()
    trail := sema_graph_trail_init()
    sema_comptime_graph_apply_values(registration, values, trail)
    full := sema_finalize_graph(registration, trail, stage, values, functions, request.eval_config.host_hooks, request.compiler_threads, false, None)
    restored := full.registration_graph.move()
    full.registration_graph = None
    registration = restored.move() ?? panic("the verifying finalization lost its registration graph")
    sema_graph_trail_undo(registration, trail)
    registration.core_stand_ins = None
    _ := sema_local_splice_demand_swap(registration, held)
    differences := jet_driver_recheck_differences(landed, full, registration.module_table)
    if full.core_stand_in_rerun != "" {
        differences.push("the full recheck's Core stand-ins would not do ({full.core_stand_in_rerun}) where the landed finalization's did")
    }
    if differences.len() > 0 {
        problem = Val("JET_RECHECK_VERIFY: the local values landed before the whole-program passes differ from the full recheck:\n{differences.join("\n")}")
    }
    registration
}
