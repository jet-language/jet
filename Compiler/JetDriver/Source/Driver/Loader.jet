// In-memory source closure loader. Filesystem authority and provider access stay
// with their adapters; this stage only resolves the checked source collection.
use jet_foundation.[
    CORE_CALLS,
    CORE_MODULE_EXPORTS,
    CORE_BARE_SOURCE_MODULES,
    DIAGNOSTIC_ERROR,
    DIAGNOSTIC_LINT,
    DeriveBodyItem,
    Diagnostic,
    Func,
    ImportDecl,
    ImportKind,
    InlineVersion,
    Item,
    MIRAllocatorPolicy,
    MIRByteSize,
    MIRRuntimeLayer,
    MIRSourceFile,
    NamedSpan,
    Param,
    ParseResult,
    PolicyDeclaration,
    Program,
    Span,
    ast_program,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_part_of,
    compiler_threads_partition,
    core_bare_source_module,
    core_module_export,
    core_module_has_member,
    core_module_retirement,
    diagnostic_with_source_path,
    jet_ring_parse_manifest_layer,
    mir_boundary_head_carrier_module,
    mir_source_file_id,
]
use jet_lexer.[
    STRING_PART_INTERPOLATION,
    TOKEN_BLOCK_COMMENT,
    TOKEN_COLON,
    TOKEN_COMMA,
    TOKEN_DOT,
    TOKEN_EOF,
    TOKEN_IDENT,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LINE_COMMENT,
    TOKEN_LPAREN,
    TOKEN_RAW_STRING,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_QUESTION_DOT,
    TOKEN_SEMI,
    TOKEN_STRING,
    Token,
    TokenTables,
    lex,
    lex_config,
    lex_generated,
    token_decoded,
    token_string_parts,
]
use jet_parser.[
    parse_lexed_owned_with_source,
    parser_line_starts,
]
use jet_sema.[
    SemaRegistrationImportEdge,
    SemaSourceOrigin,
    SemaSourceSegment,
    sema_effect_parse_name,
    sema_effect_root,
    sema_registration_unit_family_type_names,
    sema_source_words,
]

JET_DRIVER_LATEST_EDITION :: prep { "2028" }

// S51 (Rust `Syntax::FIRST_PARTY_RESERVED`): first-party short names reserved
// before packages land. A local module may not take one as its alias or root.
JET_DRIVER_FIRST_PARTY_RESERVED :: prep { [String]{
    "core", "jet", "c", "rust", "py", "js", "swift", "go", "java", "cs", "tcl", "lua", "fortran",
    "cobol", "ada", "pascal", "dart", "pwsh", "perl", "r", "octave", "com", "http", "regex", "csv",
    "toml", "crypto", "archive",
} }

struct JetDriverFilePath {
    path: String
    valid: Bool
}

fn jet_driver_set_failed_stage(current: JetDriverStage?, next: JetDriverStage) -> JetDriverStage? {
    if current == None -> return Val(next)
    current
}

fn jet_driver_has_errors(diagnostics: [Diagnostic]) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return true
    }
    false
}

fn jet_driver_find_alias(aliases: [String:Int], name: String) -> Int? {
    aliases.get(name)
}

// An inline module, or a generic-module alias that semantic preparation
// expands into one.
fn jet_driver_program_has_inline_module(program: Program, name: String) -> Bool Never! {
    loop item in program.items {
        if item == {
            .CodeModule(definition) -> {
                if definition.name == name && definition.body != None -> return true
            }
            .ModuleAlias(alias) -> {
                if alias.name == name -> return true
            }
            else -> {}
        }
    }
    false
}

fn jet_driver_file_import_path(importing_relative_path: String, import_path: String) -> JetDriverFilePath Never! {
    if import_path.len() == 0 || import_path.starts_with("/") || import_path.contains("\\") -> return JetDriverFilePath{path: "", valid: false}
    importing_parts :: importing_relative_path.split("/").to_list()
    target_parts := [String]{}
    loop index in 0..<importing_parts.len() - 1 {
        if importing_parts[index].len() > 0 -> &target_parts.push(importing_parts[index])
    }
    imported_parts :: import_path.split("/").to_list()
    imported_count := 0
    loop part in imported_parts {
        if part == "" || part == "." -> next
        if part == ".." {
            if target_parts.len() == 0 -> return JetDriverFilePath{path: "", valid: false}
            _ := &target_parts.pop()
            imported_count += 1
            next
        }
        &target_parts.push(part)
        imported_count += 1
    }
    if imported_count == 0 || target_parts.len() == 0 -> return JetDriverFilePath{path: "", valid: false}
    file_name :: &target_parts.pop() ?? return JetDriverFilePath{path: "", valid: false}
    name_parts := file_name.split(".").to_list()
    if name_parts.len() > 1 {
        _ := &name_parts.pop()
    }
    &target_parts.push("{name_parts.join(".")}.jet")
    JetDriverFilePath{path: target_parts.join("/"), valid: true}
}

fn jet_driver_is_manifest_string(kind: Int) -> Bool Never! {
    kind == TOKEN_STRING || kind == TOKEN_RAW_STRING
}

fn jet_driver_manifest_matching_brace(tokens: [Token], start: Int) -> Int? {
    if start < 0 || start >= tokens.len() || tokens[start].kind != TOKEN_LBRACE -> return None
    depth := 1
    index := start + 1
    loop index < tokens.len() {
        if tokens[index].kind == TOKEN_LBRACE -> depth += 1
        if tokens[index].kind == TOKEN_RBRACE -> depth -= 1
        if depth == 0 -> return Val(index)
        index += 1
    }
    None
}

fn jet_driver_manifest_matching_bracket(tokens: [Token], start: Int, limit: Int) -> Int? {
    if start < 0 || start >= limit || tokens[start].kind != TOKEN_LBRACKET -> return None
    depth := 1
    index := start + 1
    loop index < limit {
        if tokens[index].kind == TOKEN_LBRACKET -> depth += 1
        if tokens[index].kind == TOKEN_RBRACKET -> depth -= 1
        if depth == 0 -> return Val(index)
        index += 1
    }
    None
}

fn jet_driver_authority_diagnostic(span: Span, detail: String) -> Diagnostic {
    jet_driver_diagnostic("E1221", span, "`package.jet` has a malformed `authority:` block", detail, "`authority:` declares package holds, needs, grants, trust, and providers using canonical rights")
}

fn jet_driver_is_ui_capability(name: String) -> Bool Never! {
    loop call in CORE_CALLS {
        loop capability in call.ui_capabilities {
            if capability == name -> return true
        }
    }
    false
}

fn jet_driver_parse_authority_needs(source: String, tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int, span: Span, diagnostics: &[Diagnostic]) -> [String] {
    needs := [String]{}
    needs_seen := false
    index := open_index + 1
    loop index < close_index {
        if tokens[index].kind == TOKEN_IDENT && token_decoded(tables, tokens[index]) == "needs" && index + 1 < close_index && tokens[index + 1].kind == TOKEN_COLON {
            if needs_seen -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.needs` is declared more than once"))
            needs_seen = true
            list_open_index := index + 2
            if list_open_index < close_index && tokens[list_open_index].kind == TOKEN_DOT -> list_open_index += 1
            list_close :: jet_driver_manifest_matching_bracket(tokens, list_open_index, close_index) ?? {
                &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.needs:` must be a list like `[DB, Net, UI.Clipboard]`"))
                index += 1
                next
            }
            item_index := list_open_index + 1
            loop item_index < list_close {
                if tokens[item_index].kind == TOKEN_COMMA || tokens[item_index].kind == TOKEN_SEMI || tokens[item_index].kind == TOKEN_LINE_COMMENT || tokens[item_index].kind == TOKEN_BLOCK_COMMENT {
                    item_index += 1
                    next
                }
                item :: jet_driver_manifest_field_value(source, tokens, item_index)
                name := item.text.trim().replace(" ", "").replace("\t", "").replace(String.from_bytes([U8]{U8{13}}) ?? "", "").replace("\n", "")
                if item.next_index == item_index + 1 && jet_driver_is_manifest_string(tokens[item_index].kind) {
                    name = token_decoded(tables, tokens[item_index])
                }
                if name.starts_with(".") -> name = name.slice(1, name.len())
                if {
                    name.len() == 0 -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.needs:` must be a list like `[DB, Net, UI.Clipboard]`"))
                    else -> {
                        root :: sema_effect_root(name)
                        if {
                            !jet_driver_is_ui_capability(name) && sema_effect_parse_name(root) == None -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` isn't a known effect or UI capability"))
                            name.contains("(") -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` is a parameterized memory denial and cannot be declared in `authority.needs`"))
                            root == "Panic" || root == "Mem" -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` is deny-only and cannot be declared in `authority.needs`"))
                            else -> &needs.push(name)
                        }
                    }
                }
                item_index = item.next_index
                if item_index < list_close && (tokens[item_index].kind == TOKEN_COMMA || tokens[item_index].kind == TOKEN_SEMI) -> item_index += 1
            }
            index = list_close
        }
        index += 1
    }
    needs
}

struct JetDriverAuthorityHolds {
    allow: [String]?
    deny: [String]?
}

struct JetDriverParsedAuthorityList {
    values: [String]?
    next_index: Int
}

fn jet_driver_parse_authority_effect_list(source: String, tokens: [Token], tables: TokenTables, start_index: Int, close_index: Int, span: Span, field: String, diagnostics: &[Diagnostic]) -> JetDriverParsedAuthorityList {
    list_open_index := start_index
    if list_open_index < close_index && tokens[list_open_index].kind == TOKEN_DOT -> list_open_index += 1
    list_close :: jet_driver_manifest_matching_bracket(tokens, list_open_index, close_index) ?? {
        &diagnostics.push(jet_driver_authority_diagnostic(span, "`{field}:` must be a list like `[DB, Net]`"))
        return JetDriverParsedAuthorityList{values: None, next_index: list_open_index + 1}
    }
    names := [String]{}
    item_index := list_open_index + 1
    loop item_index < list_close {
        if tokens[item_index].kind == TOKEN_COMMA || tokens[item_index].kind == TOKEN_SEMI || tokens[item_index].kind == TOKEN_LINE_COMMENT || tokens[item_index].kind == TOKEN_BLOCK_COMMENT {
            item_index += 1
            next
        }
        item :: jet_driver_manifest_field_value(source, tokens, item_index)
        name := item.text.trim().replace(" ", "").replace("\t", "").replace(String.from_bytes([U8]{U8{13}}) ?? "", "").replace("\n", "")
        if item.next_index == item_index + 1 && jet_driver_is_manifest_string(tokens[item_index].kind) -> name = token_decoded(tables, tokens[item_index])
        if {
            name.len() == 0 -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{field}:` must be a list like `[DB, Net]`"))
            sema_effect_parse_name(sema_effect_root(name)) == None -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` isn't a known effect (see the closed vocabulary in Prelude/Effects.jet)"))
            name.contains("(") && !field.ends_with("deny") -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` is a parameterized memory denial and belongs only in an `authority.holds.deny` list - use `Mem.Alloc(above: 65536)` there"))
            name.contains("(") && sema_effect_parse_name(name) == None -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`{name}` has an invalid parameterized rights entry - use `Mem.Alloc(above: 65536)`"))
            else -> &names.push(name)
        }
        item_index = item.next_index
        if {
            item_index < list_close && (tokens[item_index].kind == TOKEN_COMMA || tokens[item_index].kind == TOKEN_SEMI) -> item_index += 1
            item_index < list_close -> {
                &diagnostics.push(jet_driver_authority_diagnostic(span, "`{field}:` must be a comma-separated effect list"))
                item_index += 1
            }
            else -> {}
        }
    }
    JetDriverParsedAuthorityList{values: Val(names), next_index: list_close + 1}
}

fn jet_driver_parse_authority_holds(source: String, tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int, span: Span, diagnostics: &[Diagnostic]) -> JetDriverAuthorityHolds {
    result := JetDriverAuthorityHolds{allow: None, deny: None}
    holds_seen := false
    index := open_index + 1
    loop index < close_index {
        if tokens[index].kind == TOKEN_IDENT && token_decoded(tables, tokens[index]) == "holds" && index + 1 < close_index && tokens[index + 1].kind == TOKEN_COLON {
            if holds_seen -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.holds` is declared more than once"))
            holds_seen = true
            holds_open_index := index + 2
            if holds_open_index < close_index && tokens[holds_open_index].kind == TOKEN_DOT -> holds_open_index += 1
            holds_close :: jet_driver_manifest_matching_brace(tokens, holds_open_index) ?? {
                &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.holds` must be a closed record"))
                index += 1
                next
            }
            allow_seen := false
            deny_seen := false
            hold_index := holds_open_index + 1
            loop hold_index < holds_close {
                if {
                    hold_index + 1 < holds_close && tokens[hold_index].kind == TOKEN_IDENT && tokens[hold_index + 1].kind == TOKEN_COLON -> {
                        hold_name :: token_decoded(tables, tokens[hold_index])
                        list_start :: hold_index + 2
                        if hold_name == {
                            "allow" -> {
                                if allow_seen -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.holds.allow` is declared more than once"))
                                allow_seen = true
                                parsed :: jet_driver_parse_authority_effect_list(source, tokens, tables, list_start, holds_close, span, "authority.holds.allow", &diagnostics)
                                result.allow = parsed.values
                                hold_index = parsed.next_index
                            }
                            "deny" -> {
                                if deny_seen -> &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.holds.deny` is declared more than once"))
                                deny_seen = true
                                parsed :: jet_driver_parse_authority_effect_list(source, tokens, tables, list_start, holds_close, span, "authority.holds.deny", &diagnostics)
                                result.deny = parsed.values
                                hold_index = parsed.next_index
                            }
                            else -> {
                                &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.holds` only accepts `allow:` and `deny:`"))
                                hold_index += 1
                            }
                        }
                    }
                    else -> hold_index += 1
                }
            }
            index = holds_close
        }
        index += 1
    }
    result
}

fn jet_driver_validate_authority_fields(tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int, span: Span, diagnostics: &[Diagnostic]) {
    nesting := 0
    loop index in open_index + 1..<close_index {
        token :: tokens[index]
        if nesting == 0 && token.kind == TOKEN_IDENT && index + 1 < close_index && tokens[index + 1].kind == TOKEN_COLON {
            field :: token_decoded(tables, token)
            if field != "needs" && field != "holds" {
                &diagnostics.push(jet_driver_authority_diagnostic(span, "`authority.{field}` is not supported by the current compiler package-policy boundary"))
            }
        }
        if token.kind == TOKEN_LBRACE || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LPAREN -> nesting += 1
        if token.kind == TOKEN_RBRACE || token.kind == TOKEN_RBRACKET || token.kind == TOKEN_RPAREN {
            if nesting > 0 -> nesting -= 1
        }
    }
}

fn jet_driver_valid_dependency_name(name: String) -> Bool Never! {
    name.len() > 0 && name != "." && name != ".." && !name.contains("/") && !name.contains("\\") && !name.contains(":")
}

fn jet_driver_parse_dependency_entries(source: String, source_path: String, tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int, diagnostics: &[Diagnostic]) -> [JetDriverPackageDependency] {
    dependencies := [JetDriverPackageDependency]{}
    source_bytes :: source.bytes()
    index := open_index + 1
    loop index < close_index {
        token :: tokens[index]
        if token.kind == TOKEN_COMMA || token.kind == TOKEN_SEMI || token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT {
            index += 1
            next
        }
        if token.kind != TOKEN_IDENT && !jet_driver_is_manifest_string(token.kind) {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package dependency entry has no name", "deps: entries are named path or package references", "write `dependency: source` inside `deps`"))
            index += 1
            next
        }
        name :: token_decoded(tables, token)
        if !jet_driver_valid_dependency_name(name) {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package dependency name is not a safe path component", "dependency names select one package root", "use a dependency name without path separators or `.`/`..`"))
        }
        if index + 1 >= close_index || tokens[index + 1].kind != TOKEN_COLON {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package dependency entry has no source value", "each deps: entry binds one name to one source reference", "add `: source` after the dependency name"))
            index += 1
            next
        }
        value_index :: index + 2
        cursor := value_index
        nesting := 0
        value_end := 0
        has_value := false
        loop cursor < close_index {
            kind :: tokens[cursor].kind
            if kind == TOKEN_COMMA || kind == TOKEN_SEMI {
                if nesting == 0 -> break
            }
            if kind == TOKEN_LBRACE || kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN -> nesting += 1
            if kind == TOKEN_RBRACE || kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN {
                if nesting == 0 -> break
                nesting -= 1
            }
            if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT {
                value_end = tokens[cursor].span.end
                has_value = true
            }
            cursor += 1
        }
        if {
            !has_value -> &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package dependency source is empty", "every declared dependency needs one source reference", "provide a path or package version reference"))
            else -> {
                value :: if {
                    cursor == value_index + 1 && jet_driver_is_manifest_string(tokens[value_index].kind) -> token_decoded(tables, tokens[value_index])
                    else -> {
                        value_start :: tokens[value_index].span.start
                        if value_start >= 0 && value_end >= value_start && value_end <= source_bytes.len() -> (String.from_bytes(source_bytes[value_start..<value_end]) ?? "").trim() else -> ""
                    }
                }
                duplicate :: loop existing in dependencies {
                    if existing.name == name {
                        break true
                    }
                } ?? false
                if {
                    duplicate -> &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package dependency is declared more than once", "each package dependency name selects exactly one source", "keep one declaration for this dependency"))
                    else -> &dependencies.push(JetDriverPackageDependency{name: name, source: value, source_path: source_path, span: Val(token.span), target_root_index: -1})
                }
            }
        }
        index = cursor
        if index < close_index && (tokens[index].kind == TOKEN_COMMA || tokens[index].kind == TOKEN_SEMI) -> index += 1
    }
    dependencies
}

fn jet_driver_package_identity(name: String, version: String) -> String Never! {
    "package:{name.len()}:{name}:{version}"
}

struct JetDriverManifestFieldValue {
    text: String
    next_index: Int
}

fn jet_driver_manifest_field_value(source: String, tokens: [Token], start_index: Int) -> JetDriverManifestFieldValue Never! {
    if start_index < 0 || start_index >= tokens.len() -> return JetDriverManifestFieldValue{text: "", next_index: tokens.len()}
    source_bytes :: source.bytes()
    cursor := start_index
    nesting := 0
    loop cursor < tokens.len() {
        token :: tokens[cursor]
        kind :: token.kind
        if nesting == 0 {
            if kind == TOKEN_COMMA || kind == TOKEN_SEMI || kind == TOKEN_RBRACE || kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN || kind == TOKEN_EOF -> break
            if cursor > start_index && kind == TOKEN_IDENT && cursor + 1 < tokens.len() && tokens[cursor + 1].kind == TOKEN_COLON -> break
        }
        if kind == TOKEN_LBRACE || kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN -> nesting += 1
        if kind == TOKEN_RBRACE || kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN {
            if nesting > 0 -> nesting -= 1
        }
        cursor += 1
    }
    text := ""
    loop token_index in start_index..<cursor {
        token :: tokens[token_index]
        if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT {
            start :: token.span.start
            end :: token.span.end
            if start >= 0 && end >= start && end <= source_bytes.len() {
                text = "{text}{String.from_bytes(source_bytes[start..<end]) ?? ""}"
            }
        }
    }
    JetDriverManifestFieldValue{text: text.trim(), next_index: cursor}
}

// Rust `Blocks.rs` `parse_allocator_bytes`: the unit suffix follows the last
// `.` (`rsplit_once`), and the count is a `u64` spelling (one optional `+`).
fn jet_driver_parse_allocator_bytes(value: String, span: Span, diagnostics: &[Diagnostic]) -> Int? {
    value_bytes :: value.bytes()
    dot := -1
    loop (index, byte) in value_bytes {
        if Int.from_u8(byte) == 46 -> dot = index
    }
    // copy: `digits_text` is trimmed in place to its digits, while `value` is the caller's manifest
    // field (a read parameter) and stays intact.
    digits_text := value.copy()
    multiplier := 1
    if dot >= 0 {
        digits_text = String.from_bytes(value_bytes[0..<dot]) ?? ""
        suffix :: String.from_bytes(value_bytes[dot + 1..<value_bytes.len()]) ?? ""
        if suffix == {
            "kb" | "kib" -> multiplier = 1024
            "mb" | "mib" -> multiplier = 1048576
            "gb" | "gib" -> multiplier = 1073741824
            "bytes" -> {}
            else -> {
                &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`cap:` uses exact bytes or a `.kb`, `.mb`, or `.gb` byte quantity", "use a positive whole-byte quantity such as `2.gb`"))
                return None
            }
        }
    }
    digits := digits_text.replace("_", "")
    if digits.starts_with("+") -> digits = digits.slice(1, digits.len())
    if digits.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`cap:` must be a positive whole-byte quantity such as `2.gb`", "use a positive whole-byte quantity that fits in 64 bits"))
        return None
    }
    count := 0
    loop byte in digits.bytes() {
        digit := Int.from_u8(byte)
        if digit < 48 || digit > 57 {
            &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`cap:` must be a positive whole-byte quantity such as `2.gb`", "use a positive whole-byte quantity that fits in 64 bits"))
            return None
        }
        digit -= 48
        if count > 922337203685477580 || (count == 922337203685477580 && digit > 7) {
            &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`cap:` must be a positive byte quantity that fits in 64 bits", "use a positive whole-byte quantity that fits in 64 bits"))
            return None
        }
        count = count * 10 + digit
    }
    max_int :: 922337203685477580 * 10 + 7
    if count == 0 || count > max_int /% multiplier {
        &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`cap:` must be a positive byte quantity that fits in 64 bits", "use a positive whole-byte quantity that fits in 64 bits"))
        return None
    }
    Val(count * multiplier)
}

// Rust `Blocks.rs` `top_level_commas`: split on commas outside `()`/`[]`/`{}`
// and string literals; a final blank component is dropped.
fn jet_driver_top_level_commas(body: String) -> [String] Never! {
    parts := [String]{}
    current := [U8]{}
    depth := 0
    quoted := false
    escaped := false
    loop byte in body.bytes() {
        code :: Int.from_u8(byte)
        if quoted {
            &current.push(byte)
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            next
        }
        if {
            code == 34 -> {
                quoted = true
                &current.push(byte)
            }
            code == 40 || code == 91 || code == 123 -> {
                depth += 1
                &current.push(byte)
            }
            code == 41 || code == 93 || code == 125 -> {
                depth -= 1
                &current.push(byte)
            }
            code == 44 && depth == 0 -> {
                &parts.push(String.from_bytes(current) ?? "")
                current = [U8]{}
            }
            else -> &current.push(byte)
        }
    }
    last :: String.from_bytes(current) ?? ""
    if last.trim() != "" -> &parts.push(last)
    parts
}

fn jet_driver_parse_program_allocator(value: String, span: Span, diagnostics: &[Diagnostic]) -> MIRAllocatorPolicy? {
    compact :: value.trim().replace(" ", "").replace("\t", "").replace(String.from_bytes([U8]{U8{13}}) ?? "", "").replace("\n", "")
    if compact == "mem.Heap" -> return Val(MIRAllocatorPolicy.HostedDefault)
    prefix :: "mem.Counting.over("
    if compact.starts_with(prefix) && compact.ends_with(")") {
        bytes :: compact.bytes()
        prefix_len :: prefix.bytes().len()
        inner :: String.from_bytes(bytes[prefix_len..<bytes.len() - 1]) ?? ""
        args :: jet_driver_top_level_commas(inner)
        if args.len() == 0 || args[0] != "mem.Heap" || args.len() > 2 {
            &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`mem.Counting.over` wraps `mem.Heap` and accepts only the optional `cap:` argument", "use `allocator: mem.Heap` or `mem.Counting.over(mem.Heap, cap: 2.gb)`"))
            return None
        }
        cap := MIRByteSize?{None}
        if args.len() == 2 {
            if !args[1].starts_with("cap:") {
                &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "the counting allocator's optional argument is spelled `cap:`", "use `cap:` for the counting allocator's optional limit"))
                return None
            }
            bytes_value :: jet_driver_parse_allocator_bytes(args[1].slice(4, args[1].len()), span, &diagnostics) ?? return None
            cap = Val(MIRByteSize{bytes: bytes_value})
        }
        return Val(MIRAllocatorPolicy.Counting{cap: cap})
    }
    &diagnostics.push(jet_driver_diagnostic("E1206", span, "invalid hosted program allocator", "`allocator:` must be `mem.Heap` or `mem.Counting.over(mem.Heap, cap: <bytes>)`", "use `allocator: mem.Heap` or `mem.Counting.over(mem.Heap, cap: 2.gb)`"))
    None
}

struct JetDriverVersion {
    major: Int
    minor: Int
    patch: Int
    valid: Bool
}

fn jet_driver_parse_decimal(value: String) -> Int? {
    if value.len() == 0 -> return None
    result := 0
    loop byte in value.bytes() {
        digit := Int.from_u8(byte)
        if digit < 48 || digit > 57 -> return None
        digit -= 48
        if result > 214748364 -> return None
        result = result * 10 + digit
    }
    Val(result)
}

fn jet_driver_parse_version(value: String) -> JetDriverVersion {
    core :: value.split("-").to_list()[0].split("+").to_list()[0]
    parts :: core.split(".").to_list()
    if parts.len() < 1 || parts.len() > 3 -> return JetDriverVersion{major: 0, minor: 0, patch: 0, valid: false}
    major :: jet_driver_parse_decimal(parts[0]) ?? return JetDriverVersion{major: 0, minor: 0, patch: 0, valid: false}
    minor := 0
    patch := 0
    if parts.len() > 1 {
        minor = jet_driver_parse_decimal(parts[1]) ?? return JetDriverVersion{major: 0, minor: 0, patch: 0, valid: false}
    }
    if parts.len() > 2 {
        patch = jet_driver_parse_decimal(parts[2]) ?? return JetDriverVersion{major: 0, minor: 0, patch: 0, valid: false}
    }
    JetDriverVersion{major: major, minor: minor, patch: patch, valid: true}
}

fn jet_driver_version_at_least(candidate: JetDriverVersion, minimum: JetDriverVersion) -> Bool Never! {
    if {
        candidate.major != minimum.major -> candidate.major > minimum.major
        candidate.minor != minimum.minor -> candidate.minor > minimum.minor
        else -> candidate.patch >= minimum.patch
    }
}

fn jet_driver_version_selector_matches(selector: String, version: String) -> Bool {
    if selector == "*" -> return true
    if selector == version -> return true
    if selector.contains("-") || version.contains("-") -> return false
    mode := ""
    core := selector
    bytes :: selector.bytes()
    if bytes.len() > 0 {
        first :: Int.from_u8(bytes[0])
        if first == 94 || first == 126 || first == 61 {
            mode = String.from_bytes([bytes[0]]) ?? ""
            core = String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
        }
    }
    if mode == "" -> return false
    required :: jet_driver_parse_version(core)
    candidate :: jet_driver_parse_version(version)
    if !required.valid || !candidate.valid || !jet_driver_version_at_least(candidate, required) -> return false
    if {
        mode == "=" -> candidate.major == required.major && candidate.minor == required.minor && candidate.patch == required.patch
        mode == "~" -> candidate.major == required.major && candidate.minor == required.minor
        required.major > 0 -> candidate.major == required.major
        required.minor > 0 -> candidate.major == 0 && candidate.minor == required.minor
        else -> candidate.major == 0 && candidate.minor == 0 && candidate.patch == required.patch
    }
}

fn jet_driver_dependency_selector(source: String, dependency_name: String) -> String? {
    source_bytes :: source.bytes()
    starts_record :: source_bytes.len() > 0 && source_bytes[0] == (U8{123})
    if starts_record || source.starts_with("lib:") -> return None
    target :: source.split("@").to_list()[0]
    if target.starts_with("./") || target.starts_with("../") || target.starts_with("/") -> return None
    parts :: target.split("#").to_list()
    if parts.len() == 2 {
        if parts[0] != dependency_name || parts[1].len() == 0 -> return None
        return Val(parts[1])
    }
    if parts.len() != 1 || target.len() == 0 -> return None
    Val(target)
}

fn jet_driver_dependency_path(root: String, source: String) -> JetDriverFilePath Never! {
    if source.starts_with("/") || source.contains("\\") -> return JetDriverFilePath{path: "", valid: false}
    parts := [String]{}
    absolute :: root.starts_with("/")
    loop part in root.split("/") {
        if part.len() > 0 -> &parts.push(part)
    }
    loop part in source.split("/") {
        if part.len() == 0 || part == "." -> next
        if {
            part == ".." -> {
                if parts.len() == 0 -> return JetDriverFilePath{path: "", valid: false}
                _ := &parts.pop()
            }
            else -> &parts.push(part)
        }
    }
    if parts.len() == 0 && !absolute -> return JetDriverFilePath{path: "", valid: false}
    joined :: parts.join("/")
    path :: if absolute -> "/{joined}" else -> joined
    JetDriverFilePath{path: path, valid: true}
}

// D-MOD-CYCLE1=A: whether the root package reaches `path`: it declares that
// directory, or the directory lies beside one it declares outside its tree.
fn jet_driver_root_reaches(declared: [String], sibling_dirs: [String], path: String) -> Bool Never! {
    loop candidate in declared {
        if candidate == path -> return true
    }
    loop directory in sibling_dirs {
        if jet_driver_path_within(path, directory) -> return true
    }
    false
}

// Whether `path` is `directory` or lies beneath it.
fn jet_driver_path_within(path: String, directory: String) -> Bool Never! {
    prefix :: if directory.ends_with("/") -> directory else -> "{directory}/"
    path == directory || path.starts_with(prefix)
}

fn jet_driver_parent_path(path: String) -> String Never! {
    parts := path.split("/").to_list()
    _ := &parts.pop()
    parent :: parts.join("/")
    if parent.len() == 0 -> "/" else -> parent
}

fn jet_driver_resolve_package_dependencies(packages: &[JetDriverPackageInfo], snapshot: JetDriverAuthorizedSourceSnapshot, diagnostics: &[Diagnostic]) {
    // D-MOD-CYCLE1=A: a path dependency that a dependency declares stays below
    // that dependency's directory (E1206) unless the root package reaches it:
    // the root declares that directory itself, or the directory lies beside
    // one the root declares outside its own tree (`Compiler/JetSema ->
    // ../JetParser -> ../JetLexer`). The root already opened that sibling
    // directory, so nothing beyond the root's own declarations is reached.
    entry_root_index := -1
    loop root_index in 0..<snapshot.roots.len() {
        if snapshot.roots[root_index].identity == snapshot.entry_root_identity -> entry_root_index = root_index
    }
    reach_declared := [String]{}
    reach_sibling_dirs := [String]{}
    if entry_root_index >= 0 {
        entry_root :: snapshot.roots[entry_root_index].canonical_path
        loop package in packages {
            if package.root_index != entry_root_index -> next
            loop dependency in package.dependencies {
                if !dependency.source.starts_with("./") && !dependency.source.starts_with("../") -> next
                resolved :: jet_driver_dependency_path(entry_root, dependency.source)
                if !resolved.valid -> next
                &reach_declared.push(resolved.path)
                if !jet_driver_path_within(resolved.path, entry_root) -> &reach_sibling_dirs.push(jet_driver_parent_path(resolved.path))
            }
        }
    }
    loop package_index in 0..<packages.len() {
        package := packages[package_index]
        loop dependency_index in 0..<package.dependencies.len() {
            dependency := package.dependencies[dependency_index]
            if {
                dependency.source.starts_with("./") || dependency.source.starts_with("../") -> {
                    root :: snapshot.roots[package.root_index]
                    resolved :: jet_driver_dependency_path(root.canonical_path, dependency.source)
                    if resolved.valid && entry_root_index >= 0 && package.root_index != entry_root_index && !jet_driver_path_within(resolved.path, root.canonical_path) && !jet_driver_root_reaches(reach_declared, reach_sibling_dirs, resolved.path) {
                        &diagnostics.push(jet_driver_diagnostic_at_source("E1206", dependency.span, dependency.source_path, 0, "path dependency `{dependency.name}` escapes its parent package", "the path `{dependency.source}` resolves outside the declaring package directory `{root.canonical_path}`", "use a relative path below the declaring package directory"))
                        next
                    }
                    target_root := Int?{None}
                    if resolved.valid {
                        loop root_index in 0..<snapshot.roots.len() {
                            if snapshot.roots[root_index].canonical_path == resolved.path -> target_root = Val(root_index)
                        }
                    }
                    if target_root == {
                        .Val(target_root_index) -> dependency.target_root_index = target_root_index
                        else -> &diagnostics.push(jet_driver_diagnostic_at_source("E0603", dependency.span, dependency.source_path, 0, "a path dependency has no matching authorized package root", "dependency paths are interpreted by Jet and may resolve only to a native-authorized root snapshot", "include the checked dependency root at its manifest-selected path"))
                    }
                }
                else -> {
                    if jet_driver_dependency_selector(dependency.source, dependency.name) == .Val(selector) {
                        candidate_root := Int?{None}
                        ambiguous := false
                        loop candidate in packages {
                            matches_name :: candidate.name == dependency.name && jet_driver_version_selector_matches(selector, candidate.version ?? "")
                            if matches_name {
                                if {
                                    candidate_root == None -> candidate_root = Val(candidate.root_index)
                                    else -> ambiguous = true
                                }
                            }
                        }
                        if {
                            ambiguous -> &diagnostics.push(jet_driver_diagnostic_at_source("E0105", dependency.span, dependency.source_path, 0, "a package dependency matches more than one authorized package root", "dependency identity and version selection must resolve to one checked root", "provide one matching package root or a more specific version selector"))
                            candidate_root != None -> dependency.target_root_index = candidate_root ?? -1
                            else -> {}
                        }
                    }
                }
            }
            package.dependencies[dependency_index] = dependency
        }
        packages[package_index] = package
    }
}

fn jet_driver_manifest_entry_function(source_path: String, tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int, diagnostics: &[Diagnostic]) -> JetDriverPackageEntry? {
    entry := JetDriverPackageEntry?{None}
    index := open_index + 1
    loop index < close_index {
        token :: tokens[index]
        if token.kind == TOKEN_IDENT && token_decoded(tables, token) == "entry" && index + 1 < close_index && tokens[index + 1].kind == TOKEN_COLON {
            value_index :: index + 2
            if value_index >= close_index || (tokens[value_index].kind != TOKEN_IDENT && !jet_driver_is_manifest_string(tokens[value_index].kind)) {
                &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(token.span), source_path, 0, "a package output entry must name a function", "the private driver binds the selected package entry to one typed MIR function identity", "write `entry: function_name` or `entry: module_alias.function_name`"))
                index += 1
                next
            }
            module_alias := String?{None}
            function_index := value_index
            if tokens[value_index].kind == TOKEN_IDENT && value_index + 2 < close_index && tokens[value_index + 1].kind == TOKEN_DOT && tokens[value_index + 2].kind == TOKEN_IDENT {
                module_alias = Val(token_decoded(tables, tokens[value_index]))
                function_index = value_index + 2
            }
            name :: token_decoded(tables, tokens[function_index])
            if !jet_driver_valid_dependency_name(name) {
                &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(tokens[function_index].span), source_path, 0, "a package output entry is not a safe function name", "entry binding resolves within the selected package graph", "use one function name without path separators"))
            }
            if module_alias == .Val(alias) {
                if !jet_driver_valid_dependency_name(alias) {
                    &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(tokens[value_index].span), source_path, 0, "a package output entry has an unsafe module alias", "qualified entry bindings resolve through one checked import alias", "use one module alias without path separators"))
                }
            }
            selected :: JetDriverPackageEntry{module_alias: module_alias, function_name: name, source_path: source_path, span: Val(tokens[function_index].span)}
            conflict :: if entry == {
                .Val(previous) -> previous.module_alias != selected.module_alias || previous.function_name != selected.function_name
                else -> false
            }
            if {
                conflict -> &diagnostics.push(jet_driver_diagnostic_at_source("E0105", Val(tokens[function_index].span), source_path, 0, "package outputs select different entry functions", "the private compile request does not contain an output selector", "select one output or declare one shared entry binding"))
                else -> entry = Val(selected)
            }
            index = function_index
        }
        index += 1
    }
    entry
}

fn jet_driver_no_package_outputs() -> JetDriverPackageOutputs Never! {
    JetDriverPackageOutputs{library: false, executable: false, entry_modules: [String]{}}
}

// D-MOD-CYCLE1=A: the output kinds an `outputs:` block declares and, by owner
// ruling B, the member file each Executable `entry: stem.run` names.
fn jet_driver_manifest_outputs(tokens: [Token], tables: TokenTables, open_index: Int, close_index: Int) -> JetDriverPackageOutputs Never! {
    outputs := jet_driver_no_package_outputs()
    index := open_index + 1
    loop index < close_index {
        token :: tokens[index]
        kind_name :: if token.kind == TOKEN_IDENT -> token_decoded(tables, token) else -> ""
        if kind_name != "Library" && kind_name != "Executable" {
            index += 1
            next
        }
        if kind_name == "Library" -> outputs.library = true else -> outputs.executable = true
        if index + 1 >= close_index || tokens[index + 1].kind != TOKEN_LBRACE {
            index += 1
            next
        }
        body_close :: jet_driver_manifest_matching_brace(tokens, index + 1) ?? close_index
        if kind_name == "Executable" {
            loop field_index in index + 2..<body_close {
                if tokens[field_index].kind != TOKEN_IDENT || token_decoded(tables, tokens[field_index]) != "entry" || field_index + 2 >= body_close || tokens[field_index + 1].kind != TOKEN_COLON -> next
                value :: tokens[field_index + 2]
                if value.kind == TOKEN_IDENT && field_index + 4 < body_close && tokens[field_index + 3].kind == TOKEN_DOT && tokens[field_index + 4].kind == TOKEN_IDENT && token_decoded(tables, tokens[field_index + 4]) == "run" {
                    &outputs.entry_modules.push(token_decoded(tables, value))
                }
                text :: token_decoded(tables, value)
                if jet_driver_is_manifest_string(value.kind) && text.ends_with(".run") -> &outputs.entry_modules.push(text.slice(0, text.len() - 4))
            }
        }
        index = body_close + 1
    }
    outputs
}

// The file of the entry root whose leading `package { … }` block is the
// root's Package (D-ECO-INLINEPACKAGE1).
struct JetDriverInlineCarrier {
    file_index: Int
    block: JetDriverInlinePackage
}

// The entry root's inline Package carrier (Rust Loader `load_file`): the
// entry's own block, else the stock entry `main.jet` / `src/main.jet` that
// carries one (`find_inline_package_root_checked`). A structure failure
// (E1360/E1361/E1362) or a carrier beside `package.jet` (E1363) is reported
// at the carrier's path and selects no carrier.
fn jet_driver_root_inline_carrier(snapshot: JetDriverAuthorizedSourceSnapshot, root_index: Int, has_manifest: Bool, diagnostics: &[Diagnostic]) -> JetDriverInlineCarrier? {
    root :: snapshot.roots[root_index]
    if root.identity != snapshot.entry_root_identity -> return None
    entry_root :: jet_driver_entry_root_path(snapshot)
    entry_display :: jet_driver_display_path(entry_root, snapshot.entry_path)
    entry_index := -1
    loop (file_index, file) in root.files {
        if jet_driver_display_path(entry_root, file.path) == entry_display -> entry_index = file_index
    }
    candidates := [Int]{}
    if entry_index >= 0 -> &candidates.push(entry_index)
    stock_entries :: [String]{"main.jet", "src/main.jet"}
    loop stock in stock_entries {
        loop (file_index, file) in root.files {
            if file.relative_path == stock && file_index != entry_index -> &candidates.push(file_index)
        }
    }
    loop file_index in candidates {
        file :: root.files[file_index]
        block :: jet_driver_inline_package(file.source)
        carrier_path :: jet_driver_display_path(entry_root, file.path)
        if block.error == .Val(failure) {
            // copy: the caller's diagnostics list owns the re-pathed failure. `failure` is a
            // payload view inside `block.error`, and Jet has no consuming match to move it out.
            &diagnostics.push(diagnostic_with_source_path(failure.copy(), carrier_path, 0))
            return None
        }
        if !block.found -> next
        if has_manifest {
            // The entry's own block is worded by the entry-facts check, a
            // stock carrier by its registry row (Rust `package_facts_for_entry`).
            span :: Span{start: block.start, end: block.end}
            conflict :: if file_index == entry_index -> jet_driver_diagnostic("E1363", span, "an inline Package conflicts with package.jet", "one project cannot carry both an inline Package block and a package.jet manifest", "remove package.jet or remove the inline Package block") else -> jet_driver_row_diagnostic("E1363", Val(span))
            &diagnostics.push(diagnostic_with_source_path(^conflict, carrier_path, 0))
            return None
        }
        return Val(JetDriverInlineCarrier{file_index: file_index, block: block})
    }
    None
}

fn jet_driver_parse_package_root(snapshot: JetDriverAuthorizedSourceSnapshot, root_index: Int, diagnostics: &[Diagnostic]) -> JetDriverPackageInfo {
    root := snapshot.roots[root_index]
    entry_root :: jet_driver_entry_root_path(snapshot)
    manifest_file_index := Int?{None}
    retired_manifest := false
    retired_manifest_path := ""
    loop file_index in 0..<root.files.len() {
        relative := root.files[file_index].relative_path
        if relative == "package.jet" -> manifest_file_index = Val(file_index)
        if relative == "jet.toml" {
            retired_manifest = true
            retired_manifest_path = jet_driver_display_path(entry_root, root.files[file_index].path)
        }
    }
    inline_carrier :: jet_driver_root_inline_carrier(snapshot, root_index, manifest_file_index != None, &diagnostics)
    if manifest_file_index == None && retired_manifest {
        &diagnostics.push(jet_driver_diagnostic_at_source("E0003", None, retired_manifest_path, 0, "the authority root contains a retired package manifest", "package identity is read only from the canonical package.jet manifest", "replace the retired manifest with package.jet"))
    }
    if manifest_file_index == None && inline_carrier == None {
        root_display :: jet_driver_display_path(entry_root, root.canonical_path)
        identity :: "source-root:{root_display.len()}:{root_display}"
        return JetDriverPackageInfo{root_index: root_index, root_path: root.canonical_path, identity: identity, name: "", version: None, edition: JET_DRIVER_LATEST_EDITION, runtime_ceiling: None, allocator_policy: MIRAllocatorPolicy.HostedDefault, authority_allow: None, authority_deny: None, authority_needs: [String]{}, entry: None, manifest_path: None, inline_package: false, configs: [String]{}, dependencies: [JetDriverPackageDependency]{}, outputs: jet_driver_no_package_outputs()}
    }
    if manifest_file_index != None && retired_manifest {
        &diagnostics.push(jet_driver_diagnostic_at_source("E0003", None, retired_manifest_path, 0, "the authority root contains both canonical and retired package manifests", "choosing either file would make package identity ambiguous", "remove jet.toml and keep package.jet"))
    }
    // An inline Package feeds its body, at its original offsets, to the same
    // field parser as `package.jet`; its carrier file is the manifest path.
    manifest := manifest_file_index ?? 0
    source := root.files[manifest].source
    if inline_carrier == .Val(carrier) {
        manifest = carrier.file_index
        source = jet_driver_inline_package_body(root.files[manifest].source, carrier.block)
    }
    manifest_path := jet_driver_display_path(entry_root, root.files[manifest].path)
    manifest_diagnostic_start :: diagnostics.len()
    lexed :: lex_config(source.bytes())
    loop diagnostic in lexed.diagnostics -> &diagnostics.push(diagnostic)
    tokens :: lexed.tokens
    name := ""
    version := String?{None}
    edition := JET_DRIVER_LATEST_EDITION
    runtime_ceiling := MIRRuntimeLayer?{None}
    allocator_policy := MIRAllocatorPolicy.HostedDefault
    authority_allow := [String]?{None}
    authority_deny := [String]?{None}
    authority_needs := [String]{}
    policy_declarations := [PolicyDeclaration]{}
    entry := JetDriverPackageEntry?{None}
    dependencies := [JetDriverPackageDependency]{}
    configs := [String]{}
    outputs := jet_driver_no_package_outputs()
    policy_unsafe_paths := [String]?{None}
    policy_expert := Bool?{None}
    name_seen := false
    version_seen := false
    edition_seen := false
    runtime_seen := false
    allocator_seen := false
    authority_seen := false
    deps_seen := false
    configs_seen := false
    outputs_seen := false
    policy_seen := false
    brace_depth := 0
    index := 0
    loop index < tokens.len() {
        token := tokens[index]
        if token.kind == TOKEN_EOF -> break
        if brace_depth == 0 && token.kind == TOKEN_IDENT && index + 1 < tokens.len() && tokens[index + 1].kind == TOKEN_COLON {
            field :: token_decoded(lexed.tables, token)
            value_index :: index + 2
            if field == {
                "name" | "version" | "edition" -> {
                    valid_string :: value_index < tokens.len() && jet_driver_is_manifest_string(tokens[value_index].kind)
                    if field == {
                        "name" -> {
                            if name_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package name is declared more than once", "one manifest root has one package identity", "keep one `name:` field"))
                            name_seen = true
                            if valid_string -> name = token_decoded(lexed.tables, tokens[value_index]) else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package name must be a string", "package identity uses the manifest's declared name", "write `name: \"package_name\"`"))
                        }
                        "version" -> {
                            if version_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package version is declared more than once", "dependency selection uses one declared package version", "keep one `version:` field"))
                            version_seen = true
                            if valid_string -> version = Val(token_decoded(lexed.tables, tokens[value_index])) else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package version must be a string", "dependency selection uses the manifest's declared version", "write `version: \"0.1.0\"`"))
                        }
                        else -> {
                            if edition_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package edition is declared more than once", "one manifest root selects one language edition", "keep one `edition:` field"))
                            edition_seen = true
                            if {
                                valid_string -> edition = token_decoded(lexed.tables, tokens[value_index])
                                else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package edition must be a string", "language edition selection comes from the canonical package manifest", "write `edition: \"2028\"`"))
                            }
                        }
                    }
                }
                "runtime" -> {
                    if runtime_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package runtime ceiling is declared more than once", "one package selects one maximum runtime layer", "keep one `runtime:` field"))
                    runtime_seen = true
                    runtime_value_index := value_index
                    if runtime_value_index < tokens.len() && tokens[runtime_value_index].kind == TOKEN_DOT -> runtime_value_index += 1
                    runtime_value := ""
                    if {
                        runtime_value_index < tokens.len() && (jet_driver_is_manifest_string(tokens[runtime_value_index].kind) || tokens[runtime_value_index].kind == TOKEN_IDENT) -> {
                            runtime_value = token_decoded(lexed.tables, tokens[runtime_value_index])
                            runtime_layer := jet_ring_parse_manifest_layer(runtime_value)
                            if {
                                runtime_layer == None -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package runtime ceiling is unsupported", "runtime ceilings are the canonical core, alloc, or hosted layers", "select `runtime: core`, `runtime: alloc`, or `runtime: hosted`"))
                                else -> runtime_ceiling = runtime_layer
                            }
                        }
                        else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package runtime ceiling must name one runtime layer", "runtime ceilings are the canonical core, alloc, or hosted layers", "select `runtime: core`, `runtime: alloc`, or `runtime: hosted`"))
                    }
                }
                "authority" -> {
                    if authority_seen -> &diagnostics.push(jet_driver_authority_diagnostic(token.span, "`authority:` is declared more than once"))
                    authority_seen = true
                    authority_open_index := value_index
                    if authority_open_index < tokens.len() && tokens[authority_open_index].kind == TOKEN_DOT -> authority_open_index += 1
                    if {
                        authority_open_index >= tokens.len() || tokens[authority_open_index].kind != TOKEN_LBRACE -> &diagnostics.push(jet_driver_authority_diagnostic(token.span, "`authority:` must be a record value"))
                        else -> {
                            authority_close_index := jet_driver_manifest_matching_brace(tokens, authority_open_index)
                            if {
                                authority_close_index == None -> &diagnostics.push(jet_driver_authority_diagnostic(token.span, "`authority:` must be a closed record value"))
                                else -> {
                                    authority_close :: authority_close_index ?? authority_open_index
                                    jet_driver_validate_authority_fields(tokens, lexed.tables, authority_open_index, authority_close, token.span, &diagnostics)
                                    authority_needs = jet_driver_parse_authority_needs(source, tokens, lexed.tables, authority_open_index, authority_close, token.span, &diagnostics)
                                    authority_holds :: jet_driver_parse_authority_holds(source, tokens, lexed.tables, authority_open_index, authority_close, token.span, &diagnostics)
                                    authority_allow = authority_holds.allow
                                    authority_deny = authority_holds.deny
                                    index = authority_close
                                }
                            }
                        }
                    }
                }
                "policy" -> {
                    if policy_seen -> &diagnostics.push(pkg_manifest_parse_diagnostic(manifest_path, PackageParseError.Composition("`policy` is declared more than once")))
                    policy_seen = true
                    policy_value :: jet_driver_manifest_field_value(source, tokens, value_index)
                    if jet_driver_read_package_policy(policy_value.text) == {
                        .Ok(policy) -> {
                            policy_declarations = ^policy.declarations
                            policy_unsafe_paths = ^policy.unsafe_paths
                            policy_expert = policy.expert
                            loop declaration_index in 0..<policy_declarations.len() {
                                policy_declarations[declaration_index].source = root.files[manifest].path
                            }
                        }
                        .Err(error) -> &diagnostics.push(pkg_manifest_parse_diagnostic(manifest_path, error))
                    }
                    index = policy_value.next_index - 1
                }
                "allocator" -> {
                    if allocator_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package allocator is declared more than once", "one package selects exactly one program allocator policy", "keep one `allocator:` field"))
                    allocator_seen = true
                    allocator_value :: jet_driver_manifest_field_value(source, tokens, value_index)
                    parsed_allocator := jet_driver_parse_program_allocator(allocator_value.text, token.span, &diagnostics)
                    if parsed_allocator != None -> allocator_policy = parsed_allocator ?? MIRAllocatorPolicy.HostedDefault
                    index = allocator_value.next_index - 1
                }
                "deps" -> {
                    if deps_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package dependencies are declared more than once", "one `deps:` block defines the package's direct dependency bindings", "keep one `deps:` block"))
                    deps_seen = true
                    block_open_index := value_index
                    if block_open_index < tokens.len() && tokens[block_open_index].kind == TOKEN_DOT -> block_open_index += 1
                    if {
                        block_open_index < tokens.len() && tokens[block_open_index].kind == TOKEN_LBRACE -> {
                            close_index :: jet_driver_manifest_matching_brace(tokens, block_open_index)
                            if {
                                close_index == None -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "the package dependency block is not closed", "dependency names and values are delimited by one balanced block", "close the `deps: .{{ ... }}` block"))
                                else -> {
                                    dependencies = jet_driver_parse_dependency_entries(source, manifest_path, tokens, lexed.tables, block_open_index, close_index, &diagnostics)
                                    index = close_index
                                }
                            }
                        }
                        else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package dependencies must be a block", "direct package dependencies use the typed `deps: .{{ ... }}` shape", "write `deps: .{{ name: source }}`"))
                    }
                }
                "configs" -> {
                    if configs_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package configurations are declared more than once", "one list selects the package fact contributors", "keep one `configs:` list"))
                    configs_seen = true
                    list_open := value_index
                    if list_open < tokens.len() && tokens[list_open].kind == TOKEN_DOT -> list_open += 1
                    list_close :: jet_driver_manifest_matching_bracket(tokens, list_open, tokens.len()) ?? {
                        &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package configurations must be a closed list", "configuration declarations select manifest inputs rather than source modules", "write `configs: [\"config/build.jet\"]`"))
                        index = list_open
                        next
                    }
                    loop config_index in (list_open + 1)..<list_close {
                        config_token :: tokens[config_index]
                        if jet_driver_is_manifest_string(config_token.kind) {
                            path :: jet_driver_file_import_path("package.jet", token_decoded(lexed.tables, config_token))
                            if path.valid -> &configs.push(path.path)
                        }
                    }
                    index = list_close
                }
                "outputs" -> {
                    if outputs_seen -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package outputs are declared more than once", "the private compile request carries no output selector", "keep one `outputs:` block"))
                    outputs_seen = true
                    block_open_index := value_index
                    if block_open_index < tokens.len() && tokens[block_open_index].kind == TOKEN_DOT -> block_open_index += 1
                    if {
                        block_open_index < tokens.len() && tokens[block_open_index].kind == TOKEN_LBRACE -> {
                            close_index :: jet_driver_manifest_matching_brace(tokens, block_open_index)
                            if {
                                close_index == None -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "the package outputs block is not closed", "output entry bindings are delimited by one balanced block", "close the `outputs: .{{ ... }}` block"))
                                else -> {
                                    entry = jet_driver_manifest_entry_function(manifest_path, tokens, lexed.tables, block_open_index, close_index, &diagnostics)
                                    outputs = jet_driver_manifest_outputs(tokens, lexed.tables, block_open_index, close_index)
                                    index = close_index
                                }
                            }
                        }
                        else -> &diagnostics.push(jet_driver_diagnostic("E0003", token.span, "package outputs must be a block", "package entry resolution requires an explicit output entry", "write `outputs: .{{ app: Executable{{entry: function}} }}`"))
                    }
                }
                else -> {}
            }
        }
        if token.kind == TOKEN_LBRACE -> brace_depth += 1
        if token.kind == TOKEN_RBRACE && brace_depth > 0 -> brace_depth -= 1
        index += 1
    }
    if edition != "2026" && edition != "2027" && edition != "2028" {
        &diagnostics.push(jet_driver_diagnostic_without_span("E2001", "package manifest requests an unsupported language edition", "this compiler supports editions 2026, 2027, and 2028", "select one of the editions supported by this toolchain"))
    }
    if name.len() == 0 {
        // An inline body words it as the canonical Package field parser does.
        missing_name :: if inline_carrier != None -> "Package needs a `name` field" else -> "package manifest has no name"
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", missing_name, "a package dependency identity requires a declared name", "add `name: \"package_name\"` to package.jet"))
    }
    // A malformed inline body is one E1362 at the body (Rust Loader: the field
    // failure becomes the diagnostic's why).
    if inline_carrier == .Val(carrier) {
        if jet_driver_has_errors_since(diagnostics, manifest_diagnostic_start) {
            field_failure := ""
            kept := [Diagnostic]{}
            loop diagnostic_index in manifest_diagnostic_start..<diagnostics.len() {
                if {
                    diagnostics[diagnostic_index].severity != DIAGNOSTIC_ERROR -> &kept.push(diagnostics[diagnostic_index])
                    field_failure.len() == 0 -> field_failure = diagnostics[diagnostic_index].what
                    else -> {}
                }
            }
            loop diagnostics.len() > manifest_diagnostic_start -> _ := &diagnostics.pop()
            loop diagnostic in kept -> &diagnostics.push(diagnostic)
            &diagnostics.push(jet_driver_diagnostic("E1362", Span{start: carrier.block.body_start, end: carrier.block.body_end}, "the inline Package body is malformed", field_failure, "fix the inline Package fields, then retry"))
        }
    }
    diagnostic_index := manifest_diagnostic_start
    loop diagnostic_index < diagnostics.len() {
        diagnostics[diagnostic_index] = diagnostic_with_source_path(diagnostics[diagnostic_index], manifest_path, 0)
        diagnostic_index += 1
    }
    identity :: jet_driver_package_identity(name, version ?? "")
    JetDriverPackageInfo{root_index: root_index, root_path: root.canonical_path, identity: identity, name: name, version: version, edition: edition, runtime_ceiling: runtime_ceiling, allocator_policy: allocator_policy, authority_allow: authority_allow, authority_deny: authority_deny, authority_needs: authority_needs, entry: entry, manifest_path: Val(manifest_path), policy_declarations: ^policy_declarations, policy_unsafe_paths: ^policy_unsafe_paths, policy_expert: policy_expert, inline_package: inline_carrier != None, configs: ^configs, dependencies: dependencies, outputs: outputs}
}

fn jet_driver_default_module_alias(relative_path: String) -> String Never! {
    parts := relative_path.split("/").to_list()
    file_name :: &parts.pop() ?? "module.jet"
    name_parts := file_name.split(".").to_list()
    if name_parts.len() > 1 -> _ := &name_parts.pop()
    raw := name_parts.join(".")
    if raw.len() == 0 -> raw = "module"
    raw_bytes :: raw.bytes()
    alias := ""
    index := 0
    loop index < raw_bytes.len() {
        byte :: Int.from_u8(raw_bytes[index])
        if {
            (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95 -> {
                alias = "{alias}{String.from_bytes([raw_bytes[index]]) ?? "_"}"
                index += 1
            }
            byte >= 128 -> {
                alias = "{alias}_"
                width :: if {
                    byte >= 240 -> 4
                    byte >= 224 -> 3
                    byte >= 192 -> 2
                    else -> 1
                }
                index += width
            }
            else -> {
                alias = "{alias}_"
                index += 1
            }
        }
    }
    if alias.len() == 0 -> alias = "module"
    first :: Int.from_u8(alias.bytes()[0])
    if first >= 48 && first <= 57 -> alias = "_{alias}"
    alias
}

// Script admissions are host-opened roots, not invented package manifests.
// Only the manifestless entry's top-level refs may introduce these bindings.
fn jet_driver_bind_script_dependencies(packages: &[JetDriverPackageInfo], snapshot: JetDriverAuthorizedSourceSnapshot, diagnostics: &[Diagnostic]) {
    if snapshot.script_dependencies.len() == 0 -> return
    entry_index := -1
    loop (entry_root_index, entry_root) in snapshot.roots {
        if entry_root.identity == snapshot.entry_root_identity {
            entry_index = entry_root_index
            break
        }
    }
    if entry_index < 0 -> return
    package := packages[entry_index]
    if package.manifest_path != None {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "script dependencies were supplied for a package entry", "inline dependency admission applies only to manifestless scripts", "use the package's declared dependency graph"))
        return
    }
    entry_file_index := -1
    loop (file_index, file) in snapshot.roots[entry_index].files {
        if file.path == snapshot.entry_path {
            entry_file_index = file_index
            break
        }
    }
    if entry_file_index < 0 -> return
    entry :: snapshot.roots[entry_index].files[entry_file_index]
    parsed :: jet_driver_parse_user_source(entry.source)
    if jet_driver_has_errors(parsed.diagnostics) -> return
    refs :: pkg_inline_deps_collect(parsed.program)
    source_path :: jet_driver_display_path(jet_driver_entry_root_path(snapshot), entry.path)
    loop admitted in snapshot.script_dependencies {
        reference_index := -1
        loop (ref_index, dependency_ref) in refs {
            if dependency_ref.name == admitted.name && dependency_ref.selector == admitted.selector && dependency_ref.span == admitted.span {
                reference_index = ref_index
                break
            }
        }
        if reference_index < 0 {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a script dependency has no matching top-level import", "admission must preserve the exact entry import and selector span", "supply only dependencies collected from the entry script"))
            next
        }
        reference :: refs[reference_index]
        target :: loop (index, root) in snapshot.roots {
            if root.identity == admitted.root_identity -> break index
        } ?? -1
        selected :: pkg_inline_deps_version_matches(admitted.selector, admitted.resolved_version)
        hash_bytes :: admitted.content_hash.bytes()
        valid_hash := admitted.content_hash.starts_with("sha256-") && hash_bytes.len() == 71
        if hash_bytes.len() >= 7 {
            loop byte in hash_bytes[7..<hash_bytes.len()] {
                if !(byte >= (U8{48}) && byte <= (U8{57})) && !(byte >= (U8{97}) && byte <= (U8{102})) -> valid_hash = false
            }
        }
        if target < 0 || target == entry_index || !pkg_inline_deps_valid_package_name(admitted.name) || !selected || !valid_hash {
            &diagnostics.push(jet_driver_diagnostic_at_source("E0003", Val(admitted.span), source_path, 0, "a script dependency admission is not bound to a checked root and content identity", "offline admission retains a supported selector, selected version, tree hash, and distinct root identity", "provide the resolver's exact admitted dependency and authorized source root"))
            next
        }
        if !pkg_inline_deps_is_pinned(reference.selector) {
            &diagnostics.push(diagnostic_with_source_path(pkg_inline_deps_l0203_unpinned(reference), source_path, 0))
        }
        if jet_driver_find_dependency(package, admitted.name) != None -> next
        &package.dependencies.push(JetDriverPackageDependency{name: admitted.name, source: "inline:{admitted.name}#{admitted.selector}", source_path: source_path, span: Val(admitted.span), target_root_index: target, script_version: Val(admitted.resolved_version)})
    }
    packages[entry_index] = package
}

fn jet_driver_build_source_catalog(request: JetDriverCompileRequest) -> JetDriverSourceCatalogResult {
    snapshot :: request.authorized_sources
    diagnostics := [Diagnostic]{}
    jet_driver_validate_authorized_snapshot(snapshot, &diagnostics)
    packages := [JetDriverPackageInfo]{}
    loop root_index in 0..<snapshot.roots.len() {
        package :: jet_driver_parse_package_root(snapshot, root_index, &diagnostics)
        loop existing in packages {
            if existing.identity == package.identity {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0105", "two authority roots have the same package identity", "one package identity resolves to one checked source root", "remove the duplicate package root or give the package a distinct name and version"))
            }
        }
        &packages.push(package)
    }
    jet_driver_resolve_package_dependencies(&packages, snapshot, &diagnostics)
    jet_driver_bind_script_dependencies(&packages, snapshot, &diagnostics)

    entry_root :: jet_driver_entry_root_path(snapshot)
    source_units := [JetDriverSourceUnit]{}
    loop root_index in 0..<snapshot.roots.len() {
        root :: snapshot.roots[root_index]
        package :: packages[root_index]
        loop (file_index, file) in root.files {
            // The explicitly selected entry is a source whatever its suffix
            // (the CLI authorizes it by name); every other file must be `.jet`.
            selected_entry :: root.identity == snapshot.entry_root_identity && file.path == snapshot.entry_path
            if file.relative_path == "package.jet" || file.relative_path == "jet.toml" || (!file.relative_path.ends_with(".jet") && !selected_entry) -> next
            unit_path :: jet_driver_display_path(entry_root, file.path)
            &source_units.push(JetDriverSourceUnit{
                root_index: root_index,
                file_index: file_index,
                root_identity: root.identity,
                package_identity: package.identity,
                module_name: jet_driver_default_module_alias(file.relative_path),
                path: unit_path,
                relative_path: file.relative_path,
                source_segments: jet_driver_source_segments(unit_path, file.source),
                source_origin: SemaSourceOrigin.Snapshot,
                in_namespace: package.manifest_path != None && !package.inline_package,
            })
        }
    }
    loop generated in request.generated_modules {
        root_index := Int?{None}
        loop (index, package) in packages {
            if package.identity == generated.package_identity {
                root_index = Val(index)
                break
            }
        }
        if root_index == None || generated.name == "" || !jet_driver_valid_authority_relative_path(generated.relative_path) || !generated.relative_path.ends_with(".jet") {
            &diagnostics.push(jet_driver_diagnostic_without_span("E3502", "a generated module has no exact package, name or relative Jet path", "generated source belongs to one checked package and stays beneath its source root", "declare a named module with a package-relative .jet path"))
            next
        }
        owner :: root_index ?? 0
        collision :: loop unit in source_units {
            if unit.package_identity == generated.package_identity && unit.relative_path == generated.relative_path -> break true
        } ?? false
        if collision {
            &diagnostics.push(jet_driver_diagnostic_without_span("E3502", "generated module `{generated.relative_path}` aliases another source", "one source path names one immutable byte sequence", "choose a distinct generated module path"))
            next
        }
        path :: jet_driver_generated_module_path(generated.package_identity, generated.relative_path)
        &source_units.push(JetDriverSourceUnit{
            root_index: owner,
            file_index: -1,
            root_identity: snapshot.roots[owner].identity,
            package_identity: generated.package_identity,
            module_name: generated.name,
            path: path,
            relative_path: generated.relative_path,
            source_segments: jet_driver_core_source_segments(path, generated.source),
            source_origin: SemaSourceOrigin.CompilerGenerated,
            in_namespace: packages[owner].manifest_path != None && !packages[owner].inline_package,
        })
    }

    entry_package_identity := ""
    entry_root_index := Int?{None}
    loop root_index in 0..<snapshot.roots.len() {
        if snapshot.roots[root_index].identity == snapshot.entry_root_identity -> entry_root_index = Val(root_index)
    }
    if {
        entry_root_index == None -> &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the entry authority root has no parsed package identity", "the compilation package comes from the selected root manifest", "select the entry package root from the authorized source snapshot"))
        else -> entry_package_identity = packages[entry_root_index ?? 0].identity
    }
    entry_display :: jet_driver_display_path(entry_root, snapshot.entry_path)
    entry_unit_found :: loop unit in source_units {
        if unit.path == entry_display && unit.root_identity == snapshot.entry_root_identity {
            break true
        }
    } ?? false
    if !entry_unit_found {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0603", "the entry file is not a Jet source in the selected package root", "compilation begins from one checked `.jet` file", "select a source file from the authorized package root"))
    }
    JetDriverSourceCatalogResult{
        packages: packages,
        source_units: source_units,
        entry_package_identity: entry_package_identity,
        diagnostics: diagnostics,
        complete: !jet_driver_has_errors(diagnostics),
    }
}

fn jet_driver_source_file_index(files: [MIRSourceFile], path: String) -> Int? {
    loop index in 0..<files.len() {
        if files[index].path == path -> return Val(index)
    }
    None
}

fn jet_driver_add_source_file(files: &[MIRSourceFile], file: MIRSourceFile, diagnostics: &[Diagnostic]) {
    if file.id.value != mir_source_file_id(file.path).value {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source-file identity does not match its canonical path", "MIR source identities are stable functions of the path", "rebuild the source-file identity with mir_source_file_id(path)"))
        return
    }
    loop existing in files {
        if existing.path == file.path {
            if existing.id.value != file.id.value || existing.source != file.source {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "one canonical source path has conflicting source records", "a source-file identity must name one immutable byte sequence", "provide one source record for this canonical path"))
            }
            return
        }
        if existing.id.value == file.id.value {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "two source paths have the same MIR source-file identity", "source-file IDs must resolve to exactly one canonical path", "use distinct canonical source paths"))
            return
        }
    }
    &files.push(file)
}

fn jet_driver_valid_authority_relative_path(path: String) -> Bool Never! {
    if path.len() == 0 || path.starts_with("/") || path.contains("\\") -> return false
    loop part in path.split("/") {
        if part.len() == 0 || part == "." || part == ".." -> return false
    }
    true
}

fn jet_driver_authority_path(root: String, relative: String) -> String Never! {
    if root == "/" -> return "/{relative}"
    if root.ends_with("/") -> return "{root}{relative}"
    "{root}/{relative}"
}

fn jet_driver_validate_authorized_snapshot(snapshot: JetDriverAuthorizedSourceSnapshot, diagnostics: &[Diagnostic]) -> Bool {
    before :: diagnostics.len()
    if snapshot.roots.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native source snapshot has no authority roots", "every compiler source must come from a pinned native authority root", "supply the checked source roots selected for this compilation"))
    }
    if snapshot.entry_root_identity.len() == 0 || snapshot.entry_path.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native source snapshot has no entry identity", "compilation begins at one checked file beneath one pinned root", "select the entry path and root identity from AuthorityResolver"))
    }
    entry_root_count := 0
    entry_found := false
    loop (root_index, root) in snapshot.roots {
        if root.identity.len() == 0 || root.canonical_path.len() == 0 || root.canonical_path.contains("\\") {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a native source root has no canonical path or pinned identity", "source authority is bound to one opened root object", "provide the root identity and canonical path from AuthorityResolver"))
        }
        if root.identity == snapshot.entry_root_identity -> entry_root_count += 1
        loop previous_root_index in 0..<root_index {
            previous :: snapshot.roots[previous_root_index]
            if previous.identity == root.identity || previous.canonical_path == root.canonical_path {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native source snapshot repeats an authority root", "one checked root object has one identity and one canonical path", "provide each authority root once"))
            }
        }
        loop (file_index, file) in root.files {
            if file.identity.len() == 0 || !jet_driver_valid_authority_relative_path(file.relative_path) || file.path != jet_driver_authority_path(root.canonical_path, file.relative_path) {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a native source file is not bound to its canonical authority root", "file bytes and object identity must come from one checked relative open beneath the pinned root", "provide the canonical path, relative path, and file identity from the same checked handle"))
            }
            if file.path == snapshot.entry_path && root.identity == snapshot.entry_root_identity -> entry_found = true
            loop previous_file_index in 0..<file_index {
                if root.files[previous_file_index].path == file.path {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native source root repeats a canonical file path", "one canonical source path names one immutable byte sequence", "provide the checked file once"))
                }
            }
            loop previous_root in 0..<root_index {
                loop previous_file in snapshot.roots[previous_root].files {
                    if previous_file.path == file.path {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "two native roots claim the same canonical source path", "one path must have one authority owner", "remove the duplicate path from the source snapshot"))
                    }
                }
                loop previous_cache in snapshot.roots[previous_root].foreign_cache_files {
                    if previous_cache.path == file.path {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source file and foreign cache claim the same canonical path", "one path must have one authority owner and one immutable source record", "remove the duplicate path from the source snapshot"))
                    }
                }
            }
        }
        loop (cache_index, cache_file) in root.foreign_cache_files {
            if cache_file.identity.len() == 0 || !jet_driver_valid_authority_relative_path(cache_file.relative_path) || cache_file.path != jet_driver_authority_path(root.canonical_path, cache_file.relative_path) {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a foreign cache source is not bound to its canonical authority root", "cache bytes and object identity must come from one checked relative open beneath the pinned root", "provide the canonical path, relative path, and cache identity from the same checked handle"))
            }
            loop source_file in root.files {
                if source_file.path == cache_file.path {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a foreign cache source collides with an authorized source path", "physical source and provider cache records have distinct immutable identities", "use one canonical source record for this path"))
                }
            }
            loop previous_cache_index in 0..<cache_index {
                if root.foreign_cache_files[previous_cache_index].path == cache_file.path {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the native source root repeats a foreign cache path", "one canonical cache path names one immutable byte sequence", "provide the checked cache file once"))
                }
            }
            loop previous_root in 0..<root_index {
                previous :: snapshot.roots[previous_root]
                loop previous_file in previous.files {
                    if previous_file.path == cache_file.path -> &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "two native records claim the same canonical cache path", "one path must have one authority owner and one immutable source record", "remove the duplicate cache path"))
                }
                loop previous_file in previous.foreign_cache_files {
                    if previous_file.path == cache_file.path -> &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "two native roots claim the same canonical cache path", "one path must have one authority owner and one immutable source record", "remove the duplicate cache path"))
                }
            }
        }
    }
    if entry_root_count != 1 || !entry_found {
        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the entry source is not present beneath exactly one selected authority root", "the entry path and root identity must come from the native source authority", "select the checked entry file from its pinned root"))
    }
    diagnostics.len() == before
}

// `path` is a source's display path (`jet_driver_display_path`); the lookup
// compares the canonical path it names.
fn jet_driver_find_snapshot_source_file(snapshot: JetDriverAuthorizedSourceSnapshot, root_index: Int, path: String, diagnostics: &[Diagnostic]) -> JetDriverAuthorizedSourceFile? {
    if root_index < 0 || root_index >= snapshot.roots.len() -> return None
    root :: snapshot.roots[root_index]
    physical :: jet_driver_physical_path(jet_driver_entry_root_path(snapshot), path)
    found := JetDriverAuthorizedSourceFile?{None}
    loop file in root.files {
        if file.path == physical {
            if found != None {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source provenance path resolves to multiple authorized records", "one source path must name one immutable physical file", "remove the duplicate authorized source record"))
                return None
            }
            found = Val(file)
        }
    }
    loop file in root.foreign_cache_files {
        if file.path == physical {
            if found != None {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source provenance path resolves to both source and cache records", "one source path must name one immutable physical file", "use distinct canonical paths for source and cache records"))
                return None
            }
            found = Val(file)
        }
    }
    found
}

// Whether a display path names an authorized disk source, so that no
// compiler-generated identity can alias one.
fn jet_driver_source_path_is_authorized(snapshot: JetDriverAuthorizedSourceSnapshot, path: String) -> Bool Never! {
    physical :: jet_driver_physical_path(jet_driver_entry_root_path(snapshot), path)
    loop root in snapshot.roots {
        loop file in root.files {
            if file.path == physical -> return true
        }
        loop file in root.foreign_cache_files {
            if file.path == physical -> return true
        }
    }
    false
}

fn jet_driver_find_generated_source_file(generated_sources: [MIRSourceFile], path: String, diagnostics: &[Diagnostic]) -> MIRSourceFile? {
    found := MIRSourceFile?{None}
    loop file in generated_sources {
        if file.path == path {
            if found != None {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source path has multiple exact text records", "generated source identities are unique and retain one immutable byte sequence", "give each generated source a unique identity"))
                return None
            }
            found = Val(file)
        }
    }
    found
}

fn jet_driver_source_segment_bytes_match(aggregate_bytes: [U8], segment: SemaSourceSegment, source_bytes: [U8]) -> Bool Never! {
    if segment.generated.start < 0 || segment.generated.end < segment.generated.start || segment.generated.end > aggregate_bytes.len() || segment.source_start < 0 -> return false
    length :: segment.generated.end - segment.generated.start
    if segment.source_start > source_bytes.len() || length > source_bytes.len() - segment.source_start -> return false
    index := 0
    loop index < length {
        if aggregate_bytes[segment.generated.start + index] != source_bytes[segment.source_start + index] -> return false
        index += 1
    }
    true
}

fn jet_driver_collect_source_files(snapshot: JetDriverAuthorizedSourceSnapshot, source_units: [JetDriverSourceUnit], modules: [JetDriverLoadedModule], generated_sources: [MIRSourceFile]) -> JetDriverSourceFileCollection {
    entry_root :: jet_driver_entry_root_path(snapshot)
    files := [MIRSourceFile]{}
    diagnostics := [Diagnostic]{}
    loop loaded_module in modules {
        if loaded_module.source_unit_index < 0 || loaded_module.source_unit_index >= source_units.len() {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module names no cataloged source unit", "module source bytes must be read from the exact authorized source snapshot or its explicit generated origin", "retain the catalog source-unit index returned by JetDriver"))
            next
        }
        unit := source_units[loaded_module.source_unit_index]
        // Embedded Core modules have no authority root: their exact text is
        // the compiler-generated record the loader retained for them.
        if jet_driver_unit_is_core(unit) {
            if jet_driver_source_path_is_authorized(snapshot, unit.path) {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "an embedded Core module aliases an authorized physical source", "Core library identities are distinct from immutable disk snapshots", "keep the `<corelib>/` origin for embedded Core sources"))
                next
            }
            core_file :: jet_driver_find_generated_source_file(generated_sources, unit.path, &diagnostics) ?? {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "an embedded Core module has no exact source text record", "Core source bytes are retained beside the loaded module", "retain the loader's Core source record"))
                next
            }
            jet_driver_add_source_file(&files, core_file, &diagnostics)
            next
        }
        if unit.root_index < 0 || unit.root_index >= snapshot.roots.len() {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module names no authorized source root", "module provenance remains attached to one pinned source root", "retain the catalog authority-root index"))
            next
        }
        root := snapshot.roots[unit.root_index]
        if root.identity != unit.root_identity || loaded_module.package_identity != unit.package_identity {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a loaded module's provenance does not match its pinned source root and package", "source-unit identity, package identity, and bytes stay attached to one root", "rebuild the loaded module from its catalog source unit"))
            next
        }
        aggregate_file := MIRSourceFile?{None}
        if unit.source_origin == {
            .Snapshot -> {
                if unit.file_index < 0 || unit.file_index >= root.files.len() {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a snapshot source unit names no authorized source file", "physical source bytes must come from the exact checked file record", "retain the catalog file index"))
                    next
                }
                file := root.files[unit.file_index]
                if jet_driver_display_path(entry_root, file.path) != unit.path {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a snapshot source unit's path differs from its authorized file", "physical bytes and source identity remain attached to one checked file", "rebuild the source unit from its exact authorized file"))
                    next
                }
                aggregate_file = Val(MIRSourceFile{id: mir_source_file_id(unit.path), path: unit.path, source: file.source})
            }
            else -> {
                if unit.file_index != -1 || jet_driver_source_path_is_authorized(snapshot, unit.path) {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source unit aliases an authorized physical source", "generated source identities are distinct from immutable disk snapshots", "use a unique compiler-generated origin path"))
                    next
                }
                aggregate_file = jet_driver_find_generated_source_file(generated_sources, unit.path, &diagnostics)
                if aggregate_file == None {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source unit has no exact generated text record", "generated source bytes must be preserved separately from authorized disk files", "retain the unique generated source record"))
                    next
                }
            }
        }
        aggregate :: aggregate_file ?? next
        jet_driver_add_source_file(&files, aggregate, &diagnostics)
        aggregate_bytes :: aggregate.source.bytes()
        previous_generated_end := -1
        loop segment in unit.source_segments {
            segment_length :: segment.generated.end - segment.generated.start
            if segment.generated.start < 0 || segment.generated.end < segment.generated.start || segment.generated.end > aggregate_bytes.len() || segment.source_start < 0 || segment.source_file == "" {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "source provenance is outside its aggregate source span or has no source origin", "generated spans and raw byte anchors are checked independently", "regenerate the source segment from its exact aggregate and origin bytes"))
                next
            }
            if segment.generated.start < previous_generated_end {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "source provenance spans overlap or are out of order", "each generated byte maps to at most one source segment", "sort the source segments and remove overlapping ranges"))
            }
            if segment.generated.end >= previous_generated_end -> previous_generated_end = segment.generated.end
            if segment.line_starts.len() == 0 || segment.line_starts[0] != 0 {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "source provenance has no line-zero byte offset", "line starts are fragment-local UTF-8 byte offsets", "provide line_starts beginning with zero"))
            }
            // One pass over the starts (indexing `segment.line_starts[i]` copied
            // the whole list per index in emitted code: quadratic per segment).
            // Every start after the first is checked against its predecessor,
            // whatever the first value is.
            previous_line_start := 0
            first_line_start := true
            loop line_start in segment.line_starts {
                if !first_line_start && (line_start <= previous_line_start || line_start > segment_length) {
                    &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "source provenance line starts are outside the exact generated fragment", "line starts are increasing fragment-local UTF-8 byte offsets", "regenerate line_starts from the exact source fragment"))
                    break
                }
                first_line_start = false
                previous_line_start = line_start
            }
            if segment.origin == {
                .Snapshot -> {
                    raw :: jet_driver_find_snapshot_source_file(snapshot, unit.root_index, segment.source_file, &diagnostics) ?? {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a snapshot source segment is absent from the authorized root or foreign cache snapshot", "physical source lookup uses only exact checked source records", "provide the matching immutable source or cache file"))
                        next
                    }
                    if raw.identity.len() == 0 || !jet_driver_valid_authority_relative_path(raw.relative_path) || raw.path != jet_driver_authority_path(root.canonical_path, raw.relative_path) {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a source segment's physical origin is not bound to its canonical root", "source bytes and path identity come from the same checked open", "provide the exact authorized source record"))
                        next
                    }
                    raw_bytes :: raw.source.bytes()
                    if segment.source_start > raw_bytes.len() || segment_length > raw_bytes.len() - segment.source_start || !jet_driver_source_segment_bytes_match(aggregate_bytes, segment, raw_bytes) {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a snapshot source segment does not match its exact raw source bytes", "provenance maps aggregate bytes to an in-bounds immutable physical source slice", "regenerate the aggregate from the authorized source fragment"))
                        next
                    }
                    raw_path :: jet_driver_display_path(entry_root, raw.path)
                    jet_driver_add_source_file(&files, MIRSourceFile{id: mir_source_file_id(raw_path), path: raw_path, source: raw.source}, &diagnostics)
                }
                else -> {
                    if jet_driver_source_path_is_authorized(snapshot, segment.source_file) {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated segment claims an authorized disk path", "compiler-produced text has a distinct non-disk identity", "give the generated segment a unique virtual origin"))
                        next
                    }
                    raw :: jet_driver_find_generated_source_file(generated_sources, segment.source_file, &diagnostics) ?? {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source segment has no exact generated text record", "generated source text and identity are retained explicitly", "retain the unique generated source record"))
                        next
                    }
                    raw_bytes :: raw.source.bytes()
                    if segment.source_start > raw_bytes.len() || segment_length > raw_bytes.len() - segment.source_start || !jet_driver_source_segment_bytes_match(aggregate_bytes, segment, raw_bytes) {
                        &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source segment does not match its exact generated bytes", "generated provenance remains bounded by its retained compiler output", "regenerate the segment from its exact compiler-generated source"))
                        next
                    }
                    jet_driver_add_source_file(&files, raw, &diagnostics)
                }
            }
        }
    }
    loop (generated_index, generated) in generated_sources {
        loop previous_generated_index in 0..<generated_index {
            if generated_sources[previous_generated_index].path == generated.path {
                &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "two compiler-generated source records share one virtual identity", "generated source identity maps to one exact text payload", "give each generated source a unique identity"))
            }
        }
        if jet_driver_source_path_is_authorized(snapshot, generated.path) {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "a compiler-generated source record aliases an authorized disk path", "compiler output is never substituted for an authorized source record", "use a distinct generated-source identity"))
        }
        jet_driver_add_source_file(&files, generated, &diagnostics)
    }
    JetDriverSourceFileCollection{files: files, diagnostics: diagnostics, complete: !jet_driver_has_errors(diagnostics)}
}

fn jet_driver_find_module_target(index: JetDriverSourceIndex, source_units: [JetDriverSourceUnit], package_identity: String, module_name: String, span: Span, diagnostics: &[Diagnostic]) -> Int? {
    key :: jet_driver_module_index_key(package_identity, module_name)
    if index.ambiguous_module_names.get(key) != None {
        matches := [String]{}
        loop unit in source_units {
            if unit.package_identity == package_identity && unit.module_name == module_name -> &matches.push(unit.relative_path)
        }
        &diagnostics.push(jet_driver_diagnostic("E0606", span, "the module name `{module_name}` matches more than one file", "module imports must name exactly one file under the project root", "pick one file and use a file import instead: {matches.join(", ")}"))
        return None
    }
    index.by_module_name.get(key)
}

fn jet_driver_find_package_by_root(packages: [JetDriverPackageInfo], root_index: Int) -> Int? {
    loop index in 0..<packages.len() {
        if packages[index].root_index == root_index -> return Val(index)
    }
    None
}

fn jet_driver_find_dependency(package: JetDriverPackageInfo, dependency_name: String) -> JetDriverPackageDependency? {
    loop dependency in package.dependencies {
        if dependency.name == dependency_name -> return Val(dependency)
    }
    None
}

fn jet_driver_find_source_path(source_units: [JetDriverSourceUnit], root_index: Int, relative_paths: [String], diagnostics: &[Diagnostic], span: Span) -> Int? {
    target := Int?{None}
    loop relative_path in relative_paths {
        loop (index, unit) in source_units {
            if unit.root_index == root_index && unit.relative_path == relative_path {
                if target != None {
                    &diagnostics.push(jet_driver_diagnostic("E0105", span, "a module path selects more than one checked source unit", "module resolution must bind one package-relative source path", "remove the duplicate module source or select one module path"))
                    return None
                }
                target = Val(index)
            }
        }
    }
    target
}

fn jet_driver_find_module_import_target(
    source_unit: JetDriverSourceUnit,
    module_name: String,
    inline_version: InlineVersion?,
    packages: [JetDriverPackageInfo],
    source_units: [JetDriverSourceUnit],
    index: JetDriverSourceIndex,
    span: Span,
    diagnostics: &[Diagnostic],
) -> Int? {
    source_package_index :: jet_driver_find_package_by_root(packages, source_unit.root_index) ?? return None
    source_package := packages[source_package_index]
    path_parts :: module_name.split("::").to_list()
    if path_parts.len() == 0 || path_parts[0].len() == 0 {
        &diagnostics.push(jet_driver_diagnostic("E0603", span, "the module import has no package or module name", "module references resolve through one direct package binding or local module", "name a local module or a declared direct dependency"))
        return None
    }
    dependency :: jet_driver_find_dependency(source_package, path_parts[0])
    if dependency == .Val(selected_dependency) {
        if selected_dependency.target_root_index < 0 {
            &diagnostics.push(jet_driver_diagnostic("E0603", span, "the declared package dependency has no matching authorized root", "dependency roots are selected only from the native source snapshot", "include exactly one matching package root in the authorized source request"))
            return None
        }
        target_package_index :: jet_driver_find_package_by_root(packages, selected_dependency.target_root_index) ?? return None
        target_package := packages[target_package_index]
        if inline_version == .Val(selected_version) {
            matches_version :: if selected_dependency.script_version == .Val(version) -> pkg_inline_deps_version_matches(selected_version.text, version) else -> jet_driver_version_selector_matches(selected_version.text, target_package.version ?? "")
            if !matches_version {
                &diagnostics.push(jet_driver_diagnostic("E0603", selected_version.span, "the imported package version does not match its declared package root", "inline import versions must agree with the checked direct dependency version", "select a source root with the requested package version"))
                return None
            }
        }
        module_path := ""
        loop path_index in 1..<path_parts.len() {
            part :: path_parts[path_index]
            if part.len() == 0 || part == "." || part == ".." || part.contains("/") || part.contains("\\") {
                &diagnostics.push(jet_driver_diagnostic("E0602", span, "the module import contains an unsafe package-relative component", "module resolution cannot traverse outside a declared dependency root", "use non-empty module names without `.` or `..` components"))
                return None
            }
            if module_path.len() > 0 -> module_path = "{module_path}/{part}" else -> module_path = part
        }
        candidate_paths :: if module_path.len() > 0 -> [String]{"{module_path}.jet", "{module_path}/run.jet"} else -> [String]{"{selected_dependency.name}.jet", "{selected_dependency.name}/run.jet"}
        target := jet_driver_find_source_path(source_units, selected_dependency.target_root_index, candidate_paths, &diagnostics, span)
        if target != None -> return target
        if module_path.len() == 0 && !jet_driver_has_errors(diagnostics) {
            root_entry := jet_driver_find_source_path(source_units, selected_dependency.target_root_index, [String]{"run.jet"}, &diagnostics, span)
            if root_entry != None -> return root_entry
            // D-MOD-CYCLE1=A: a dependency package is one namespace; any member
            // file stands for it, and loading that member loads the whole package.
            loop (member_index, member) in source_units {
                if member.root_index == selected_dependency.target_root_index && jet_driver_unit_is_namespace_member(member) -> return Val(member_index)
            }
        }
        &diagnostics.push(jet_driver_diagnostic("E0603", span, "the imported dependency module is not present in its authorized package root", "package modules resolve to checked `{{name}}.jet` or `{{name}}/run.jet` files, with `run.jet` as the root-module fallback", "provide the requested source module beneath the selected dependency root"))
        return None
    }
    if inline_version == .Val(selected_version) {
        &diagnostics.push(jet_driver_diagnostic("E0603", selected_version.span, "a local module import cannot select a package version", "inline versions bind only direct package dependencies", "remove the version selector or import a declared package dependency"))
        return None
    }
    module_path := ""
    loop path_index in 0..<path_parts.len() {
        part :: path_parts[path_index]
        if part.len() == 0 || part == "." || part == ".." || part.contains("/") || part.contains("\\") {
            &diagnostics.push(jet_driver_diagnostic("E0602", span, "the local module path contains an unsafe component", "module resolution stays within the current package root", "use module names without `.` or `..` path components"))
            return None
        }
        if module_path.len() > 0 -> module_path = "{module_path}/{part}" else -> module_path = part
    }
    candidate_paths :: [String]{"{module_path}.jet", "{module_path}/run.jet"}
    diagnostics_before :: diagnostics.len()
    target := jet_driver_find_source_path(source_units, source_unit.root_index, candidate_paths, &diagnostics, span)
    if target != None -> return target
    if diagnostics.len() != diagnostics_before -> return None
    if path_parts.len() == 1 {
        target = jet_driver_find_module_target(index, source_units, source_unit.package_identity, module_name, span, &diagnostics)
        if target != None -> return target
    }
    &diagnostics.push(jet_driver_diagnostic("E0603", span, "the imported module is not present in the package source snapshot", "module lookup stays within the selected package or one explicit direct dependency", "provide the module in the current package or declare its dependency"))
    None
}

fn jet_driver_import_is_module_edge(kind: ImportKind) -> Bool Never! {
    if kind == {
        .File(_, _) | .Module(_, _) -> true
        else -> false
    }
}

fn jet_driver_is_foreign_provider_import(declaration: ImportDecl) -> Bool Never! {
    if declaration.kind == {
        .File(path, _) -> return path.ends_with(".h") || path.ends_with(".hpp") || path.ends_with(".hxx")
        .Module(name, _) -> return name.starts_with("c.") || name.starts_with("cpp.")
        .Unqualified(module_alias, _, _, _, _) -> return module_alias == "c" || module_alias == "cpp"
    }
}

// The loader's module edges (file and module imports) by source identity,
// kept beside its resolved edge list as edges land. The cycle check walks
// only the reachable part of the graph through them; a scan of every edge per
// visited module, deduplicated through a list, made loading quadratic or
// worse in the number of imports.
struct JetDriverModuleEdges {
    slots: [String:Int]
    targets: [[String]]
}

fn jet_driver_module_edges() -> JetDriverModuleEdges Never! {
    JetDriverModuleEdges{slots: [String:Int]{}, targets: [[String]]{}}
}

fn jet_driver_module_edges_add(edges: &JetDriverModuleEdges, edge: SemaRegistrationImportEdge) Never! {
    if !jet_driver_import_is_module_edge(edge.declaration.kind) -> return
    slot := edges.slots.get(edge.source_module_identity) ?? -1
    if slot < 0 {
        slot = edges.targets.len()
        edges.slots[edge.source_module_identity] = slot
        &edges.targets.push([String]{})
    }
    &edges.targets[slot].push(edge.target_module_identity)
}

fn jet_driver_module_reaches(edges: JetDriverModuleEdges, start: String, target: String) -> Bool Never! {
    pending := [String]{start}
    visited := [String:Bool]{}
    cursor := 0
    loop cursor < pending.len() {
        current := pending[cursor]
        cursor += 1
        if current == target -> return true
        if visited.get(current) != None -> next
        visited[current] = true
        slot :: edges.slots.get(current) ?? next
        loop reached in edges.targets[slot] {
            if visited.get(reached) == None -> &pending.push(reached)
        }
    }
    false
}

// The module edge chain from `start` to `target` (both included), if one
// exists: the circle an import that closes a cycle completes.
fn jet_driver_module_path(imports: [SemaRegistrationImportEdge], start: String, target: String) -> [String]? {
    pending := [String]{start}
    parents := [String:String]{}
    cursor := 0
    loop cursor < pending.len() {
        current := pending[cursor]
        cursor += 1
        if current == target {
            reversed := [String]{current}
            loop reversed[reversed.len() - 1] != start {
                &reversed.push(parents.get(reversed[reversed.len() - 1]) ?? return None)
            }
            path :: loop index in 0..<reversed.len() -> reversed[reversed.len() - 1 - index]
            return Val(path)
        }
        loop edge in imports {
            if edge.source_module_identity != current || !jet_driver_import_is_module_edge(edge.declaration.kind) -> next
            if edge.target_module_identity == start || parents.get(edge.target_module_identity) != None -> next
            parents[edge.target_module_identity] = current
            &pending.push(edge.target_module_identity)
        }
    }
    None
}

fn jet_driver_cycle_member(source_units: [JetDriverSourceUnit], module_identity: String) -> String {
    loop unit in source_units {
        if jet_driver_unit_module_identity(unit) == module_identity -> return unit.relative_path
    }
    // copy: the member path is a new owned String. Without a matching unit it is `module_identity`,
    // a read parameter that the caller keeps in its cycle report.
    module_identity.copy()
}

// A loose source root has no package manifest (`jet_driver_parse_package_root`
// gives it a `source-root:` identity). Only loose files may import by a path
// that walks up with `..`; inside a package, file imports stay in its tree.
fn jet_driver_unit_is_loose(unit: JetDriverSourceUnit) -> Bool Never! {
    unit.package_identity.starts_with("source-root:")
}

// D-MOD-CYCLE1=A: a package is one namespace. Every `.jet` source of a
// manifest package belongs to it except the package's payload and workspace
// modules; loose files and embedded Core modules have no namespace.
fn jet_driver_unit_is_namespace_member(unit: JetDriverSourceUnit) -> Bool Never! {
    if !unit.in_namespace -> return false
    parts := unit.relative_path.split("/").to_list()
    file_name :: &parts.pop() ?? ""
    file_name != "pkg.jet" && file_name != "workspace.jet"
}

fn jet_driver_lookup_file_target(source_units: [JetDriverSourceUnit], importing_unit: JetDriverSourceUnit, import_path: String, span: Span, diagnostics: &[Diagnostic]) -> Int? {
    walks_up :: loop part in import_path.split("/") {
        if part == ".." {
            break true
        }
    } ?? false
    if walks_up && !jet_driver_unit_is_loose(importing_unit) {
        &diagnostics.push(jet_driver_diagnostic("E0602", span, "this import path escapes the package", "inside a package, file imports stay in the package tree — `..` works only for loose files outside any package", "use a path without `..`, or move the file inside the package tree"))
        return None
    }
    resolved :: jet_driver_file_import_path(importing_unit.relative_path, import_path)
    if !resolved.valid {
        &diagnostics.push(jet_driver_diagnostic("E0602", span, "this file import path escapes or is not relative to its authorized source root", "file imports may traverse parent directories only while remaining beneath the same pinned root", "use a relative file path contained by the source root"))
        return None
    }
    jet_driver_find_source_path(source_units, importing_unit.root_index, [String]{resolved.path}, &diagnostics, span)
}

// D-MOD1 (Rust `resolve_code_module_file`): the source unit a body-less
// `module name` declares, `name.jet` beside the declaring file, else
// `name/module.jet`; E0607 when neither is in the source snapshot.
fn jet_driver_code_module_file(source_units: [JetDriverSourceUnit], unit: JetDriverSourceUnit, name: String, name_span: Span, diagnostics: &[Diagnostic]) -> Int? {
    candidates :: [String]{name, "{name}/module"}
    loop candidate in candidates {
        resolved :: jet_driver_file_import_path(unit.relative_path, candidate)
        if !resolved.valid -> next
        loop (index, source_unit) in source_units {
            if source_unit.root_index == unit.root_index && source_unit.relative_path == resolved.path -> return Val(index)
        }
    }
    &diagnostics.push(jet_driver_diagnostic("E0607", name_span, "module `{name}` not found", "looked for `{name}.jet` and `{name}/module.jet` next to this file", "create `{name}.jet` next to this file"))
    None
}

// E0604 for an import that closes a cycle. Rust lists the load stack: the
// entry's import chain down to the file that is imported again, then the
// circle itself.
fn jet_driver_import_cycle(resolved_imports: [SemaRegistrationImportEdge], source_units: [JetDriverSourceUnit], entry_identity: String, target_identity: String, module_identity: String) -> Diagnostic {
    lead :: jet_driver_module_path(resolved_imports, entry_identity, target_identity) ?? [String]{target_identity}
    chain :: jet_driver_module_path(resolved_imports, target_identity, module_identity) ?? [String]{module_identity}
    circle := [String]{}
    loop index in 0..<lead.len() - 1 -> &circle.push(jet_driver_cycle_member(source_units, lead[index]))
    loop identity in chain -> &circle.push(jet_driver_cycle_member(source_units, identity))
    &circle.push(jet_driver_cycle_member(source_units, target_identity))
    jet_driver_diagnostic_without_span("E0604", "these files import each other in a circle", "Jet loads every imported file before compiling, so imports can't loop", "break the cycle: {circle.join(" → ")}")
}

fn jet_driver_validate_alias(alias: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if alias.len() == 0 {
        &diagnostics.push(jet_driver_diagnostic("E0003", span, "an import has no module alias", "module references resolve through the alias introduced by a module or file import", "give this import a module alias"))
        return false
    }
    true
}

// Whether a module or file import of `imports` binds `alias`.
fn jet_driver_imports_bind_alias(imports: [ImportDecl], alias: String) -> Bool Never! {
    loop declaration in imports {
        if jet_driver_import_is_module_edge(declaration.kind) && declaration.alias == alias -> return true
    }
    false
}

// D-MOD-CYCLE1=A: `use dep.[names]` names members of a dependency package
// directly; it binds the package itself, as `use dep` would. The binding is a
// compiler-owned module import with a zero-width span at the package name.
fn jet_driver_bind_dependency_imports(program: &Program, unit: JetDriverSourceUnit, packages: [JetDriverPackageInfo]) {
    package_index :: jet_driver_find_package_by_root(packages, unit.root_index) ?? return
    bindings := [ImportDecl]{}
    loop declaration in program.imports {
        if declaration.kind == {
            .Unqualified(module_alias, module_alias_span, _, _, _) -> {
                if jet_driver_imports_bind_alias(program.imports, module_alias) || jet_driver_imports_bind_alias(bindings, module_alias) -> next
                if jet_driver_find_dependency(packages[package_index], module_alias) == None -> next
                span :: Span{start: module_alias_span.start, end: module_alias_span.start}
                &bindings.push(ImportDecl{kind: ImportKind.Module{name: module_alias, span: span}, alias: module_alias, alias_span: span, span: span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None})
            }
            else -> {}
        }
    }
    if bindings.len() == 0 -> return
    loop declaration in program.imports -> &bindings.push(declaration)
    program.imports = bindings
}

// D-MOD-CYCLE1=A: the top-level names one package file contributes to its
// package namespace, with their declaring spans.
fn jet_driver_namespace_item_names(items: [Item]) -> [NamedSpan] Never! {
    names := [NamedSpan]{}
    loop item in items {
        if item == {
            .Func(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .Struct(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .Enum(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .Distinct(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .TypeAlias(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .UnitFamily(value) -> {
                loop member in sema_registration_unit_family_type_names(value) -> &names.push(member)
            }
            .Trait(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .Tag(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .Const(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            .ProtocolDecl(value) -> &names.push(NamedSpan{name: value.name, span: value.name_span})
            else -> {}
        }
    }
    names
}

// The source bytes a module was parsed from; none for a host-implemented
// Core module.
fn jet_driver_module_source_bytes(unit: JetDriverSourceUnit, roots: [JetDriverAuthorizedSourceRoot], core_sources: [JetDriverCoreSource]) -> [U8] Never! {
    if jet_driver_unit_is_core(unit) {
        if unit.file_index < 0 || unit.file_index >= core_sources.len() -> return [U8]{}
        return core_sources[unit.file_index].source.bytes()
    }
    if unit.root_index < 0 || unit.root_index >= roots.len() || unit.file_index < 0 || unit.file_index >= roots[unit.root_index].files.len() -> return [U8]{}
    roots[unit.root_index].files[unit.file_index].source.bytes()
}

// D-MOD-CYCLE1=A: the source bytes of one default (a parameter default or
// precondition, or a field default or computed value) that a call or struct
// literal splices into the calling module's body, where its names resolve.
// `key` is the name the caller spells (function or method); "" marks a
// default reached from every module: a field default (a literal or derived
// `Default` may not spell its struct), a trait method's (dispatch may be
// implicit), or one inside a template body (its generated owner may carry a
// name no source spells). A default's range runs from the declared type to
// the next declaration, so it covers the whole default expression.
struct JetDriverDefaultRegion {
    key: String
    module_index: Int
    start: Int
    end: Int
}

fn jet_driver_param_default_regions(key: String, params: [Param], last_end: Int, module_index: Int, regions: &[JetDriverDefaultRegion]) Never! {
    loop index in 0..<params.len() {
        if params[index].default == None -> next
        end :: if index + 1 < params.len() -> params[index + 1].name_span.start else -> last_end
        &regions.push(JetDriverDefaultRegion{key: key, module_index: module_index, start: params[index].ty_span.end, end: end})
    }
}

fn jet_driver_default_key(template: Bool, name: String) -> String Never! {
    if template -> return ""
    // copy: the default key is a new owned String equal to `name`, the caller's declared name (a
    // read parameter), which the caller keeps.
    name.copy()
}

fn jet_driver_func_default_regions(function: Func, template: Bool, module_index: Int, regions: &[JetDriverDefaultRegion]) Never! {
    key :: jet_driver_default_key(template, function.name)
    last_end := function.span.end
    if function.return_type_span == .Val(span) -> last_end = span.start
    jet_driver_param_default_regions(key, function.params, last_end, module_index, &regions)
    // A precondition is checked at each call site, in the caller's scope.
    loop clause in function.pre {
        end :: if clause.message_span.end > clause.span.end -> clause.message_span.end else -> clause.span.end
        &regions.push(JetDriverDefaultRegion{key: key, module_index: module_index, start: clause.span.start, end: end})
    }
}

fn jet_driver_default_regions(items: [Item], template: Bool, module_index: Int, regions: &[JetDriverDefaultRegion]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> jet_driver_func_default_regions(function, template, module_index, &regions)
            .Struct(definition) -> {
                loop index in 0..<definition.fields.len() {
                    field :: definition.fields[index]
                    if field.default == None && field.computed == None -> next
                    end := definition.span.end
                    if index + 1 < definition.fields.len() -> end = definition.fields[index + 1].name_span.start
                    loop method in definition.methods {
                        if method.span.start > field.ty_span.end && method.span.start < end -> end = method.span.start
                    }
                    &regions.push(JetDriverDefaultRegion{key: "", module_index: module_index, start: field.ty_span.end, end: end})
                }
                loop method in definition.methods -> jet_driver_func_default_regions(method, template, module_index, &regions)
            }
            .Enum(definition) -> loop method in definition.methods -> jet_driver_func_default_regions(method, template, module_index, &regions)
            .Impl(definition) -> loop method in definition.methods -> jet_driver_func_default_regions(method, template || definition.trait_name != None, module_index, &regions)
            .Trait(definition) -> loop method in definition.methods -> jet_driver_param_default_regions("", method.params, method.span.end, module_index, &regions)
            .ExternRust(block) -> loop function in block.functions -> jet_driver_param_default_regions(jet_driver_default_key(template, function.name), function.params, function.span.end, module_index, &regions)
            .CModule(block) -> loop function in block.functions -> jet_driver_param_default_regions(jet_driver_default_key(template, function.name), function.params, function.span.end, module_index, &regions)
            .CodeModule(definition) -> jet_driver_default_regions(definition.body ?? [Item]{}, template, module_index, &regions)
            .GenericModule(definition) -> jet_driver_default_regions(definition.body, template, module_index, &regions)
            .TemplateLoop(definition) -> jet_driver_template_default_regions(definition.body, module_index, &regions)
            .UserDerive(definition) -> jet_driver_template_default_regions(definition.body, module_index, &regions)
            else -> {}
        }
    }
}

fn jet_driver_template_default_regions(body: [DeriveBodyItem], module_index: Int, regions: &[JetDriverDefaultRegion]) Never! {
    loop entry in body {
        if entry == {
            .Item(item) -> jet_driver_default_regions([Item]{item}, true, module_index, &regions)
            .Loop(_, _, _, nested, _) -> jet_driver_template_default_regions(nested, module_index, &regions)
            .Stmt(_) -> {}
        }
    }
}

// D-MOD-CYCLE1=A: the names of other members each package member can reach,
// stored as its `namespace_refs`. Semantic registration binds only these in
// the member's module scope, so a module scope holds the names its body can
// spell rather than every name of the package (M files x N names). A member
// reaches a sibling name its source spells, or one spelled by a default that
// a call or literal in it can splice in (closed over defaults of defaults);
// registration adds the Prelude derive vocabulary and falls back to the whole
// namespace for a module whose items come from a template elsewhere.
// `members` and `owners` hold each package of two or more members: its
// module positions and its name -> member position table.
fn jet_driver_namespace_reach(modules: &[JetDriverLoadedModule], source_units: [JetDriverSourceUnit], roots: [JetDriverAuthorizedSourceRoot], core_sources: [JetDriverCoreSource], members: [[Int]], owners: [[String:Int]]) {
    regions := [JetDriverDefaultRegion]{}
    loop module_index in 0..<modules.len() -> jet_driver_default_regions(modules[module_index].program.items, false, module_index, &regions)
    // Default key -> slot of its words; each default keeps the words that
    // name a namespace member or another default.
    default_slots := [String:Int]{}
    default_words := [[String]]{}
    default_seen := [[String:Bool]]{}
    loop region in regions {
        if default_slots.get(region.key) != None -> next
        default_slots[region.key] = default_words.len()
        &default_words.push([String]{})
        &default_seen.push([String:Bool]{})
    }
    namespace_names := [String:Bool]{}
    loop table_index in 0..<members.len() {
        loop module_index in members[table_index] {
            loop name in modules[module_index].namespace_names -> namespace_names[name] = true
        }
    }
    bytes := [U8]{}
    bytes_module := -1
    loop region in regions {
        if region.module_index != bytes_module {
            bytes = jet_driver_module_source_bytes(source_units[modules[region.module_index].source_unit_index], roots, core_sources)
            bytes_module = region.module_index
        }
        slot :: default_slots.get(region.key) ?? next
        words := [String]{}
        sema_source_words(bytes, region.start, region.end, &default_seen[slot], &words)
        loop word in words {
            if namespace_names.get(word) != None || default_slots.get(word) != None -> &default_words[slot].push(word)
        }
    }
    always := [String]{}
    if default_slots.get("") == .Val(slot) -> always = default_words[slot]
    loop table_index in 0..<members.len() {
        loop (position, module_index) in members[table_index] {
            source :: jet_driver_module_source_bytes(source_units[modules[module_index].source_unit_index], roots, core_sources)
            seen := [String:Bool]{}
            words := [String]{}
            sema_source_words(source, 0, source.len(), &seen, &words)
            loop word in always {
                if seen.get(word) != None -> next
                seen[word] = true
                &words.push(word)
            }
            refs := [String]{}
            cursor := 0
            loop cursor < words.len() {
                word :: words[cursor]
                cursor += 1
                if owners[table_index].get(word) == .Val(owner) {
                    if owner != position -> &refs.push(word)
                }
                slot :: default_slots.get(word) ?? next
                loop extra in default_words[slot] {
                    if seen.get(extra) != None -> next
                    seen[extra] = true
                    &words.push(extra)
                }
            }
            modules[module_index].namespace_refs = refs
        }
    }
}

fn jet_driver_path_leaf(path: String) -> String Never! {
    parts := path.split("/").to_list()
    &parts.pop() ?? path
}

// D-MOD-CYCLE1=A: make every package one namespace. A name declared in two
// member files is E0624 and a library package declaring `fn run` is E0625.
// Each member records its package (`namespace`) and the names it contributes
// (`namespace_names`); semantic registration keeps ONE name -> declaring
// member table per package and consults it after a module's own
// declarations and imports (Rust `NameLedger::namespace_owner`). No member
// receives import rows or edges for its siblings.
fn jet_driver_bind_package_namespaces(
    modules: &[JetDriverLoadedModule],
    source_units: [JetDriverSourceUnit],
    packages: [JetDriverPackageInfo],
    roots: [JetDriverAuthorizedSourceRoot],
    core_sources: [JetDriverCoreSource],
    diagnostics: &[Diagnostic],
) -> Bool {
    // Packages of two or more members, for jet_driver_namespace_reach.
    shared_members := [[Int]]{}
    shared_owners := [[String:Int]]{}
    loop package in packages {
        members := [Int]{}
        loop module_index in 0..<modules.len() {
            unit :: source_units[modules[module_index].source_unit_index]
            if unit.root_index == package.root_index && jet_driver_unit_is_namespace_member(unit) -> &members.push(module_index)
        }
        if members.len() == 0 -> next
        // One `fn run` per package, unless the manifest names each entry
        // (owner ruling B, like Cargo `[[bin]]`): `.Executable{ entry:
        // tool.run }` keeps `tool.jet`'s `run` its own. A package-root command
        // home (`@run.jet`, D-ROLEFILE1) keeps its command function too.
        names := [[NamedSpan]]{}
        loop module_index in members {
            unit :: source_units[modules[module_index].source_unit_index]
            named_entry :: loop entry_module in package.outputs.entry_modules {
                if entry_module == unit.module_name {
                    break true
                }
            } ?? false
            role_command :: if unit.relative_path == {
                "@run.jet" -> "run"
                "@build.jet" -> "build"
                "@dev.jet" -> "dev"
                "@test.jet" -> "test"
                else -> ""
            }
            member_names := [NamedSpan]{}
            loop declared in jet_driver_namespace_item_names(modules[module_index].program.items) {
                if (named_entry && declared.name == "run") || declared.name == role_command -> next
                &member_names.push(declared)
            }
            &names.push(member_names)
        }
        owners := [String:Int]{}
        loop position in 0..<names.len() {
            loop declared in names[position] {
                if owners.get(declared.name) == {
                    .Val(first) -> {
                        if first == position -> next
                        unit :: source_units[modules[members[position]].source_unit_index]
                        other :: source_units[modules[members[first]].source_unit_index]
                        package_name :: jet_driver_path_leaf(roots[package.root_index].canonical_path)
                        &diagnostics.push(jet_driver_diagnostic_at_source("E0624", Val(declared.span), unit.path, 0, "`{declared.name}` is declared in two files of package `{package_name}`", "the files of one package share one namespace, so each top-level name belongs to exactly one file; the other declaration is in `{other.relative_path}`", "rename one of the declarations, or keep only one of them"))
                        return false
                    }
                    .None -> _ := &owners.add(declared.name, position)
                }
            }
        }
        // A library package has no `fn run`.
        if package.outputs.library && !package.outputs.executable {
            loop position in 0..<names.len() {
                loop declared in names[position] {
                    if declared.name != "run" -> next
                    unit :: source_units[modules[members[position]].source_unit_index]
                    &diagnostics.push(jet_driver_diagnostic_at_source("E0625", Val(declared.span), unit.path, 0, "a library package can't declare `fn run`", "a package is one namespace: an executable package has one `fn run`, or one in each entry file its `outputs` name, and a library package, which other code imports, has none", "move the program into its own package or a loose file that uses this library, or make this package an executable"))
                    return false
                }
            }
        }
        namespace :: source_units[modules[members[0]].source_unit_index].package_identity
        loop position in 0..<members.len() {
            modules[members[position]].namespace = namespace
            modules[members[position]].namespace_names = loop declared in names[position] -> declared.name
        }
        if members.len() > 1 {
            &shared_members.push(members)
            &shared_owners.push(owners)
        }
    }
    if shared_members.len() > 0 -> jet_driver_namespace_reach(&modules, source_units, roots, core_sources, shared_members, shared_owners)
    true
}

// Root component of every embedded Core module path (`<corelib>/Core/perf/perf.jet`),
// the Rust `Diagnostics::CORE_SOURCE_ROOT`. Core is library source, not the
// user's program; no authorized disk file ever carries this prefix.
JET_DRIVER_CORE_SOURCE_ROOT :: prep { "<corelib>" }

// A Core library module the loader placed in the graph (Rust Loader.rs
// 2531-2683). It has no authority root. `file_index` selects its row in
// `request.core_sources`, or is -1 for a Core module the host implements
// entirely, whose empty module keeps every member a host row.
fn jet_driver_unit_is_core(unit: JetDriverSourceUnit) -> Bool Never! {
    unit.root_index < 0 && unit.source_origin == SemaSourceOrigin.CompilerGenerated && unit.path.starts_with("{JET_DRIVER_CORE_SOURCE_ROOT}/")
}

// A Core source module's identity is its canonical owner prefix
// (`<corelib>/Core/perf::Core/perf/perf.jet`), so its nominals are keyed
// `<corelib>/Core/perf::Core/perf/perf.jet::PerfError` exactly as in Rust.
fn jet_driver_unit_module_identity(unit: JetDriverSourceUnit) -> String Never! {
    if !jet_driver_unit_is_core(unit) -> return jet_driver_module_identity(unit.package_identity, unit.path)
    if unit.file_index < 0 -> return unit.path
    jet_driver_core_source_owner_key(unit.relative_path)
}

fn jet_driver_core_source_owner_key(relative_path: String) -> String Never! {
    parts := relative_path.split("/").to_list()
    _ := &parts.pop()
    "{JET_DRIVER_CORE_SOURCE_ROOT}/{parts.join("/")}::{relative_path}"
}

// Rust `core_source_import_module`: the Core module an import names, including
// a selective `use core.x.[T]` import.
fn jet_driver_core_import_module(declaration: ImportDecl) -> String? {
    name := ""
    if declaration.kind == {
        .Module(module_name, _) -> name = module_name
        .Unqualified(module_alias, _, _, _, _) -> name = module_alias
        .File(_, _) -> return None
    }
    if name == "core" || name == "app" || name.starts_with("core.") -> return Val(name)
    None
}

// Rust `check_reserved_import`: a file or local module import may not bind a
// first-party or foreign root (E1002). Selective imports load nothing, Core
// paths are resolved by the Core unit lookup (E1001), and target profiles are
// compiler-owned namespaces.
fn jet_driver_check_reserved_import(declaration: ImportDecl, diagnostics: &[Diagnostic]) -> Bool {
    if declaration.kind == .Unqualified(_, _, _, _, _) -> return true
    if jet_driver_core_import_module(declaration) != None -> return true
    if declaration.kind == .Module(profile, _) {
        if profile == "board.sensor_v1" || profile == "board.virt_aarch64" -> return true
    }
    alias :: declaration.alias
    if JET_DRIVER_FIRST_PARTY_RESERVED.contains(alias) {
        &diagnostics.push(jet_driver_diagnostic("E1002", declaration.alias_span, "`{alias}` is reserved for first-party or foreign packages", "`core`, `jet`, first-party ring names, and foreign-language roots can't be used for local modules", "rename the module or use it with `as other_name`"))
        return false
    }
    if declaration.kind == .Module(name, span) {
        // D-CORENS1 / E0341: the old `jet.<ring>` spelling teaches `core.<ring>`.
        if name.starts_with("jet.") {
            ring :: name.slice(4, name.len())
            if jet_driver_is_ring_module(ring) {
                &diagnostics.push(jet_driver_diagnostic("E0341", span, "`use jet.{ring}` is the old first-party library spelling", "first-party libraries moved to the `core.*` namespace (D-CORENS1)", "write `use {jet_driver_canonical_ring_module(ring)}` instead"))
                return false
            }
        }
        root :: name.split(".").to_list()[0]
        if JET_DRIVER_FIRST_PARTY_RESERVED.contains(root) {
            &diagnostics.push(jet_driver_diagnostic("E1002", span, "`{root}` is reserved for first-party or foreign packages", "`core`, `jet`, first-party ring names, and foreign-language roots can't be used for local modules", "choose a different module name"))
            return false
        }
    }
    true
}

// Rust Syntax `is_ring_module`: ring module names that resolve as
// compiler-known modules.
fn jet_driver_is_ring_module(name: String) -> Bool Never! {
    name == "log" || name == "crypto" || name == "http" || name == "regex" || name == "reactive" || name == "archive" || name == "raylib" || name == "db" || name == "time" || name == "plugin"
}

// Rust Syntax `canonical_ring_module`: the Core home of an old ring spelling.
fn jet_driver_canonical_ring_module(name: String) -> String Never! {
    if name == "raylib" -> return "core.game.raylib"
    "core.{name}"
}

// D-ECO-INLINEPACKAGE1: the one leading `package { … }` carrier of a source
// (Rust `Package::extract_inline_package`). Offsets index the original text;
// `error` is the E1360/E1361/E1362 structure failure.
struct JetDriverInlinePackage {
    found: Bool
    start: Int
    end: Int
    body_start: Int
    body_end: Int
    error: Diagnostic?
}

fn jet_driver_inline_byte(bytes: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= bytes.len() -> return -1
    Int.from_u8(bytes[at])
}

fn jet_driver_inline_space(byte: Int) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 12 || byte == 13
}

fn jet_driver_inline_ident_byte(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// The end of the `//` comment (or byte-zero launch header) at `at`.
fn jet_driver_inline_line_end(bytes: [U8], at: Int) -> Int Never! {
    cursor := at + 2
    loop cursor < bytes.len() && jet_driver_inline_byte(bytes, cursor) != 10 -> cursor += 1
    if cursor > bytes.len() -> return bytes.len()
    cursor
}

fn jet_driver_inline_block_comment_end(bytes: [U8], start: Int) -> Int Never! {
    depth := 1
    cursor := start + 2
    loop cursor < bytes.len() {
        byte :: jet_driver_inline_byte(bytes, cursor)
        following :: jet_driver_inline_byte(bytes, cursor + 1)
        if byte == 47 && following == 42 {
            depth += 1
            cursor += 2
            next
        }
        if byte == 42 && following == 47 {
            if depth > 0 -> depth -= 1
            cursor += 2
            if depth == 0 -> return cursor
            next
        }
        cursor += 1
    }
    bytes.len()
}

// The end of the quoted (or `"""` triple-quoted) string at `start`.
fn jet_driver_inline_string_end(bytes: [U8], start: Int) -> Int Never! {
    quote :: jet_driver_inline_byte(bytes, start)
    triple :: quote == 34 && jet_driver_inline_byte(bytes, start + 1) == 34 && jet_driver_inline_byte(bytes, start + 2) == 34
    cursor := if triple -> start + 3 else -> start + 1
    escaped := false
    loop cursor < bytes.len() {
        byte :: jet_driver_inline_byte(bytes, cursor)
        if escaped {
            escaped = false
            cursor += 1
            next
        }
        if byte == 92 {
            escaped = true
            cursor += 1
            next
        }
        if triple && byte == 34 && jet_driver_inline_byte(bytes, cursor + 1) == 34 && jet_driver_inline_byte(bytes, cursor + 2) == 34 -> return cursor + 3
        if !triple && byte == quote -> return cursor + 1
        cursor += 1
    }
    bytes.len()
}

// Skip whitespace, comments, and the byte-zero `#!/` launch header.
fn jet_driver_inline_trivia_end(bytes: [U8], from: Int) -> Int Never! {
    at := from
    loop {
        if at == 0 && jet_driver_inline_byte(bytes, 0) == 35 && jet_driver_inline_byte(bytes, 1) == 33 && jet_driver_inline_byte(bytes, 2) == 47 {
            at = jet_driver_inline_line_end(bytes, 0)
            next
        }
        loop jet_driver_inline_space(jet_driver_inline_byte(bytes, at)) -> at += 1
        if jet_driver_inline_byte(bytes, at) == 47 && jet_driver_inline_byte(bytes, at + 1) == 47 {
            at = jet_driver_inline_line_end(bytes, at)
            next
        }
        if jet_driver_inline_byte(bytes, at) == 47 && jet_driver_inline_byte(bytes, at + 1) == 42 {
            following :: jet_driver_inline_block_comment_end(bytes, at)
            if following == at -> return at
            at = following
            next
        }
        return at
    }
}

// The opening brace of a `package {` carrier starting at `at`, or -1.
fn jet_driver_inline_package_open(bytes: [U8], at: Int) -> Int Never! {
    keyword :: "package".bytes()
    if at < 0 || at + keyword.len() > bytes.len() -> return -1
    loop (offset, expected) in keyword {
        if bytes[at + offset] != expected -> return -1
    }
    if jet_driver_inline_ident_byte(jet_driver_inline_byte(bytes, at - 1)) || jet_driver_inline_ident_byte(jet_driver_inline_byte(bytes, at + keyword.len())) -> return -1
    open :: jet_driver_inline_trivia_end(bytes, at + keyword.len())
    if jet_driver_inline_byte(bytes, open) == 123 -> open else -> -1
}

// One past the brace that closes the block opened at `open`, or -1.
fn jet_driver_inline_block_end(bytes: [U8], open: Int) -> Int Never! {
    if open < 0 -> return -1
    depth := 0
    cursor := open
    loop cursor < bytes.len() {
        byte :: jet_driver_inline_byte(bytes, cursor)
        following :: jet_driver_inline_byte(bytes, cursor + 1)
        if byte == 34 || byte == 39 {
            cursor = jet_driver_inline_string_end(bytes, cursor)
            next
        }
        if byte == 47 && following == 47 {
            cursor = jet_driver_inline_line_end(bytes, cursor)
            next
        }
        if byte == 47 && following == 42 {
            cursor = jet_driver_inline_block_comment_end(bytes, cursor)
            next
        }
        if byte == 123 -> depth += 1
        if byte == 125 {
            if depth == 0 -> return -1
            depth -= 1
            if depth == 0 -> return cursor + 1
        }
        cursor += 1
    }
    -1
}

// The start of a `package {` carrier in top-level item position at or after
// `from`, or -1 (Rust `find_top_level_inline_package`).
fn jet_driver_inline_top_level_package(bytes: [U8], from: Int) -> Int Never! {
    cursor := from
    braces := 0
    brackets := 0
    parens := 0
    item_position := true
    loop cursor < bytes.len() {
        byte :: jet_driver_inline_byte(bytes, cursor)
        following :: jet_driver_inline_byte(bytes, cursor + 1)
        if byte == 34 || byte == 39 {
            cursor = jet_driver_inline_string_end(bytes, cursor)
            next
        }
        if byte == 47 && following == 47 {
            cursor = jet_driver_inline_line_end(bytes, cursor)
            next
        }
        if byte == 47 && following == 42 {
            cursor = jet_driver_inline_block_comment_end(bytes, cursor)
            next
        }
        top :: braces == 0 && brackets == 0 && parens == 0
        if top && item_position && jet_driver_inline_package_open(bytes, cursor) >= 0 -> return cursor
        if {
            byte == 123 -> {
                braces += 1
                item_position = false
            }
            byte == 125 -> {
                if braces > 0 -> braces -= 1
                if braces == 0 && brackets == 0 && parens == 0 -> item_position = true
            }
            byte == 91 -> {
                brackets += 1
                item_position = false
            }
            byte == 93 -> {
                if brackets > 0 -> brackets -= 1
            }
            byte == 40 -> {
                parens += 1
                item_position = false
            }
            byte == 41 -> {
                if parens > 0 -> parens -= 1
            }
            byte == 59 && top -> item_position = true
            top && !jet_driver_inline_space(byte) -> item_position = false
            else -> {}
        }
        cursor += 1
    }
    -1
}

fn jet_driver_inline_package_failure(code: String, start: Int, end: Int) -> JetDriverInlinePackage {
    JetDriverInlinePackage{found: false, start: start, end: end, body_start: start, body_end: start, error: Val(jet_driver_row_diagnostic(code, Val(Span{start: start, end: end})))}
}

fn jet_driver_inline_package(source: String) -> JetDriverInlinePackage {
    none :: JetDriverInlinePackage{found: false, start: 0, end: 0, body_start: 0, body_end: 0, error: None}
    if !source.contains("package") -> return none
    bytes :: source.bytes()
    first :: jet_driver_inline_trivia_end(bytes, 0)
    open :: jet_driver_inline_package_open(bytes, first)
    if open >= 0 {
        end :: jet_driver_inline_block_end(bytes, open)
        if end < 0 -> return jet_driver_inline_package_failure("E1362", first, bytes.len())
        duplicate :: jet_driver_inline_top_level_package(bytes, end)
        if duplicate >= 0 {
            duplicate_end :: jet_driver_inline_block_end(bytes, jet_driver_inline_package_open(bytes, duplicate))
            return jet_driver_inline_package_failure("E1361", duplicate, if duplicate_end < 0 -> bytes.len() else -> duplicate_end)
        }
        return JetDriverInlinePackage{found: true, start: first, end: end, body_start: open + 1, body_end: end - 1, error: None}
    }
    stray :: jet_driver_inline_top_level_package(bytes, first)
    if stray < 0 -> return none
    stray_end :: jet_driver_inline_block_end(bytes, jet_driver_inline_package_open(bytes, stray))
    jet_driver_inline_package_failure("E1360", stray, if stray_end < 0 -> bytes.len() else -> stray_end)
}

// Blank `start..<end` with spaces, keeping line endings, so every span stays
// an offset into the original text (Rust `InlinePackageBlock::mask_source`).
fn jet_driver_blank_source_range(source: String, start: Int, end: Int) -> String {
    bytes := source.bytes()
    loop offset in start..<end {
        if bytes[offset] != (U8{10}) && bytes[offset] != (U8{13}) -> bytes[offset] = U8{32}
    }
    // copy: the blanked source is a new owned String. On a UTF-8 failure it falls back to `source`,
    // the caller's file text (a read parameter), which stays with the caller.
    String.from_bytes(bytes) ?? source.copy()
}

// The source an ordinary parse reads: the inline carrier masked away (Rust
// `Package::mask_inline_package_source`).
fn jet_driver_mask_inline_package(source: String, carrier: JetDriverInlinePackage) -> String {
    // copy: the masked source is a new owned String. Without an inline carrier it equals `source`,
    // the caller's file text (a read parameter), which stays with the caller.
    if !carrier.found -> return source.copy()
    jet_driver_blank_source_range(source, carrier.start, carrier.end)
}

// Only the carrier's body, at its original offsets, for the manifest field
// parser (Rust `InlinePackageBlock::body`).
fn jet_driver_inline_package_body(source: String, carrier: JetDriverInlinePackage) -> String {
    head :: jet_driver_blank_source_range(source, 0, carrier.body_start)
    jet_driver_blank_source_range(head, carrier.body_end, head.len())
}

// Small parse-owned facts; neither the public AST nor image schema retains tokens.
struct JetDriverCoreIdentifierDemand {
    bare_names: [String]
    option_or_err: Bool
    math_abs_receiver: Bool
}

struct JetDriverParsedUnit {
    parsed: ParseResult
    demand: JetDriverCoreIdentifierDemand
}

fn jet_driver_empty_core_identifier_demand() -> JetDriverCoreIdentifierDemand Never! {
    JetDriverCoreIdentifierDemand{bare_names: [String]{}, option_or_err: false, math_abs_receiver: false}
}

// Interpolation tokens share the enclosing lexed source's spelling/literal table.
fn jet_driver_collect_core_identifier_demand(tokens: [Token], tables: TokenTables, demand: &JetDriverCoreIdentifierDemand, collect_bare: Bool) Never! {
    loop index in 0..<tokens.len() {
        if tokens[index].kind == TOKEN_IDENT {
            name :: token_decoded(tables, tokens[index])
            if name == "or_err" -> demand.option_or_err = true
            // Loading a potential source owner is syntactic; Sema alone
            // decides whether this receiver is the canonical primitive Int.
            if name == "abs" {
                previous := index - 1
                loop previous >= 0 && (tokens[previous].kind == TOKEN_LINE_COMMENT || tokens[previous].kind == TOKEN_BLOCK_COMMENT) -> previous -= 1
                if previous >= 0 && (tokens[previous].kind == TOKEN_DOT || tokens[previous].kind == TOKEN_QUESTION_DOT) -> demand.math_abs_receiver = true
            }
            if collect_bare {
                loop bare in CORE_BARE_SOURCE_MODULES {
                    if name == bare.name || (bare.name == "URL" && name == "url") {
                        if !demand.bare_names.contains(bare.name) -> &demand.bare_names.push(bare.name)
                    }
                }
            }
        }
        loop part in token_string_parts(tables, tokens[index]) {
            if part.kind == STRING_PART_INTERPOLATION -> jet_driver_collect_core_identifier_demand(part.tokens, tables, &demand, collect_bare)
        }
    }
}

fn jet_driver_parse_user_unit(text: String, retain_demand: Bool) -> JetDriverParsedUnit {
    carrier :: jet_driver_inline_package(text)
    if carrier.error == .Val(diagnostic) {
        return JetDriverParsedUnit{parsed: ParseResult{program: ast_program(), diagnostics: [Diagnostic]{diagnostic}}, demand: jet_driver_empty_core_identifier_demand()}
    }
    source :: if carrier.found -> jet_driver_mask_inline_package(text, carrier).bytes() else -> text.bytes()
    lexed :: lex(source)
    demand := jet_driver_empty_core_identifier_demand()
    if retain_demand -> jet_driver_collect_core_identifier_demand(lexed.tokens, lexed.tables, &demand, true)
    parsed :: parse_lexed_owned_with_source(^lexed, source, parser_line_starts(source))
    JetDriverParsedUnit{parsed: ^parsed, demand: ^demand}
}

// A user source parse: the inline carrier is masked; a structure failure
// replaces the parse (Rust Loader `prepare_frontend_module`).
fn jet_driver_parse_user_source(text: String) -> ParseResult {
    unit := jet_driver_parse_user_unit(text, false)
    ^unit.parsed
}

// One unit's parse input, resolved before any parse runs so a parse thread
// reads only its own source text, never the request.
enum JetDriverParseJob {
    // A user source file.
    Source(text: String)
    // A byte-identical installed runtime entry; keeps its own test controls.
    RuntimeEntry(text: String)
    // An embedded Core module; runtime units retain every function.
    Core(text: String, module_name: String, owned_members: [String], runtime: Bool)
    // A Core unit whose row is out of range: an empty program.
    Missing
}

fn jet_driver_generated_module_path(package_identity: String, relative_path: String) -> String Never! {
    "<build-generated>/{package_identity}/{relative_path}"
}
fn jet_driver_source_unit_text(request: JetDriverCompileRequest, unit: JetDriverSourceUnit) -> String? Never! {
    if jet_driver_unit_is_core(unit) {
        if unit.file_index < 0 || unit.file_index >= request.core_sources.len() -> return None
        return Val(request.core_sources[unit.file_index].source)
    }
    if unit.source_origin == SemaSourceOrigin.CompilerGenerated {
        loop generated in request.generated_modules {
            if generated.package_identity == unit.package_identity && generated.relative_path == unit.relative_path && jet_driver_generated_module_path(generated.package_identity, generated.relative_path) == unit.path -> return Val(generated.source)
        }
        return None
    }
    if unit.root_index < 0 || unit.root_index >= request.authorized_sources.roots.len() -> return None
    files :: request.authorized_sources.roots[unit.root_index].files
    if unit.file_index < 0 || unit.file_index >= files.len() -> return None
    Val(files[unit.file_index].source)
}
fn jet_driver_parse_job(request: JetDriverCompileRequest, unit: JetDriverSourceUnit, runtime_entry: Bool) -> JetDriverParseJob {
    if !jet_driver_unit_is_core(unit) {
        text :: jet_driver_source_unit_text(request, unit) ?? return JetDriverParseJob.Missing
        if runtime_entry -> return JetDriverParseJob.RuntimeEntry{text: text}
        return JetDriverParseJob.Source{text: text}
    }
    if unit.file_index < 0 || unit.file_index >= request.core_sources.len() -> return JetDriverParseJob.Missing
    row :: request.core_sources[unit.file_index]
    JetDriverParseJob.Core{text: row.source, module_name: row.module_name, owned_members: row.owned_members, runtime: row.runtime}
}

fn jet_driver_parse_job_bytes(job: JetDriverParseJob) -> Int Never! {
    if job == {
        .Source(text) -> text.len()
        .RuntimeEntry(text) -> text.len()
        .Core(text, _, _, _) -> text.len()
        .Missing -> 0
    }
}

fn jet_driver_parse_one(job: JetDriverParseJob) -> JetDriverParsedUnit {
    if job == {
        .Source(text) -> jet_driver_parse_user_unit(text, true)
        .RuntimeEntry(text) -> jet_driver_parse_core_source(text, "", [String]{}, true, true)
        .Core(text, module_name, owned_members, runtime) -> jet_driver_parse_core_source(text, module_name, owned_members, runtime, false)
        .Missing -> JetDriverParsedUnit{parsed: ParseResult{program: ast_program(), diagnostics: [Diagnostic]{}}, demand: jet_driver_empty_core_identifier_demand()}
    }
}

// Parse one embedded Core module. Source metadata selects the public members
// that have crossed the Core cutover: private helpers and declarations stay,
// but a public function outside `owned_members` is dropped so its calls keep
// the compiler-owned route. Parser lints never reach user output.
fn jet_driver_parse_core_source(text: String, module_name: String, owned_members: [String], runtime: Bool, runtime_entry: Bool) -> JetDriverParsedUnit {
    source :: jet_driver_mask_inline_package(text, jet_driver_inline_package(text)).bytes()
    lexed :: lex_generated(source)
    demand := jet_driver_empty_core_identifier_demand()
    jet_driver_collect_core_identifier_demand(lexed.tokens, lexed.tables, &demand, runtime_entry)
    parsed := parse_lexed_owned_with_source(^lexed, source, parser_line_starts(source))
    kept := [Item]{}
    loop item in parsed.program.items {
        if item == {
            // A runtime unit keeps every item; its `#Test` controls run only
            // when the unit itself is the entry (`jet_driver_runtime_entry_row`).
            .Func(value) -> {
                if !runtime && core_module_has_member(module_name, value.name) && !owned_members.contains(value.name) -> next
            }
            .Test(_) -> {
                if !runtime_entry -> next
            }
            else -> {}
        }
        &kept.push(item)
    }
    parsed.program.items = kept
    diagnostics := [Diagnostic]{}
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity != DIAGNOSTIC_LINT -> &diagnostics.push(diagnostic)
    }
    JetDriverParsedUnit{parsed: ParseResult{program: ^parsed.program, diagnostics: ^diagnostics}, demand: ^demand}
}

// The runtime unit row (`core.<area>.runtime.<unit>`) a Core import path
// names, itself or one member of it (`core.a.runtime.u.f`). The longest unit
// wins, so nested `core.text.runtime.assets.x` is never member `x` of a
// sibling unit `core.text.runtime.assets` (Rust `core_runtime_import`).
fn jet_driver_core_runtime_row(core_sources: [JetDriverCoreSource], path: String) -> Int? {
    best := Int?{None}
    best_len := 0
    loop (row_index, row) in core_sources {
        if !row.runtime || !(path == row.module_name || path.starts_with("{row.module_name}.")) -> next
        length :: row.module_name.count_bytes()
        if length > best_len {
            best = Val(row_index)
            best_len = length
        }
    }
    best
}

// Rust `bind_core_runtime_imports`: in a Core source, `use core.a.runtime.u.f
// [as g]` is the one-member list `use core.a.runtime.u.[f as g]`, so the unit
// resolves through the selective-import path like any member list.
fn jet_driver_core_runtime_member_imports(program: &Program, core_sources: [JetDriverCoreSource]) Never! {
    rewritten := [ImportDecl]{}
    loop declaration in program.imports {
        if declaration.kind == .Module(name, span) {
            if jet_driver_core_runtime_row(core_sources, name) == .Val(row_index) {
                unit :: core_sources[row_index].module_name
                unit_parts :: unit.split(".").to_list()
                name_parts :: name.split(".").to_list()
                if name_parts.len() == unit_parts.len() + 1 {
                    item :: name_parts[name_parts.len() - 1]
                    unit_span :: Span{start: span.start, end: span.start + unit.count_bytes()}
                    member_span :: Span{start: unit_span.end + 1, end: span.end}
                    local_span :: if declaration.alias_span.start == declaration.span.start -> member_span else -> declaration.alias_span
                    local :: if declaration.alias != item -> String?{Val(declaration.alias)} else -> String?{None}
                    &rewritten.push(ImportDecl{kind: ImportKind.Unqualified{module_alias: unit, module_alias_span: unit_span, items: [ImportedItem]{ImportedItem{original: item, alias: local}}, items_span: member_span, span: declaration.span}, alias: declaration.alias, alias_span: declaration.alias_span, span: declaration.span, item_spans: [Span]{member_span}, local_spans: [Span]{local_span}, is_pub: declaration.is_pub, is_package_pub: declaration.is_package_pub, inline_version: None})
                    next
                }
            }
        }
        &rewritten.push(declaration)
    }
    program.imports = rewritten
}

// The runtime unit row a source file is when it sits at that unit's
// `Core/<area>/runtime/<unit>.jet` path and is byte-identical to the embedded
// unit (Rust `core_runtime_entry`). Only that exact text earns Core-source
// privileges, so `jet test` over a unit runs its controls through the real
// loader path and grants nothing Core does not already run.
fn jet_driver_runtime_entry_row(core_sources: [JetDriverCoreSource], unit: JetDriverSourceUnit, source: String) -> Int? {
    loop (row_index, row) in core_sources {
        if !row.runtime -> next
        if (unit.relative_path == row.path || unit.path.ends_with("/{row.path}")) && row.source == source -> return Val(row_index)
    }
    None
}

// E1001 for a program outside Core that names the Core-private
// `core.<area>.runtime` namespace (Rust `core_private_unit_diagnostic`).
fn jet_driver_core_private_unit(module_name: String, span: Span) -> Diagnostic? {
    parts :: module_name.split(".").to_list()
    if parts.len() < 3 || parts[0] != "core" || parts[2] != "runtime" -> return None
    public :: "core.{parts[1]}"
    names :: loop row in CORE_MODULE_EXPORTS -> row.module_name
    fix :: if core_module_export(public) != None -> "use the public module `{public}` instead" else -> "use one of: {names.join(", ")}"
    Val(jet_driver_diagnostic("E1001", span, "`{module_name}` is private to Core", "`core.<area>.runtime` units implement the Core library; only Core sources import them", fix))
}

// One parse thread's jobs, held last-first; parsed and returned first-first.
fn jet_driver_parse_part(jobs: [JetDriverParseJob]) -> [JetDriverParsedUnit] {
    results := [JetDriverParsedUnit]{}
    index := jobs.len()
    loop index > 0 {
        index -= 1
        &results.push(jet_driver_parse_one(jobs[index]))
    }
    results
}

// Parses the parts popped from `parts` (first part on top), one task per
// part and the last part on this thread. Returns each part's results, last
// part first, so popping yields them in part order.
fn jet_driver_parse_parts(parts: ^[[JetDriverParseJob]]) -> [[JetDriverParsedUnit]] {
    remaining := ^parts
    jobs :: &remaining.pop() ?? return [[JetDriverParsedUnit]]{}
    if remaining.len() == 0 -> return [[JetDriverParsedUnit]]{jet_driver_parse_part(jobs)}
    parsed := [[JetDriverParsedUnit]]{}
    task.group parse_threads {
        first :: task jet_driver_parse_part(jobs)
        parsed = jet_driver_parse_parts(^remaining)
        &parsed.push(^^first.join() ?? panic(compiler_threads_failure_text(err)))
    }
    parsed
}

// A parse thread is admitted for at least this much source, so a small
// program parses on the calling thread.
JET_DRIVER_PARSE_MIN_BYTES_PER_THREAD :: 262144
// Transient parser memory per source byte of the largest file a thread may
// parse (tokens, line starts, and parser state beside the retained program).
JET_DRIVER_PARSE_SCRATCH_PER_BYTE :: 64

// Parses `pending[first..]`, the units queued since the last wave, on the
// admitted threads; the results come back in `pending` order, last-first, so
// the load loop pops them in queue order. Parsing reads nothing but each
// unit's own text, so the waves give the same programs and diagnostics as
// parsing each unit when the loop reaches it.
// `runtime_entry` is the source-unit index of an exact runtime entry, or -1.
fn jet_driver_parse_wave(request: JetDriverCompileRequest, source_units: [JetDriverSourceUnit], pending: [Int], first: Int, runtime_entry: Int) -> [JetDriverParsedUnit] {
    jobs := [JetDriverParseJob]{}
    weights := [Int]{}
    total := 0
    largest := 0
    user_input_bytes := 0
    core_input_bytes := 0
    user_source_units := 0
    core_source_units := 0
    loop position in first..<pending.len() {
        job :: jet_driver_parse_job(request, source_units[pending[position]], pending[position] == runtime_entry)
        bytes :: jet_driver_parse_job_bytes(job)
        &weights.push(bytes)
        total += bytes
        if bytes > largest -> largest = bytes
        // Loaded payloads selected for this wave, not lexer-consumed bytes:
        // inline-package errors can reject before lexing, and Core filtering
        // happens after parsing. Missing has no input; unqueued units are absent.
        // String.len scheduling weights count scalars; count_bytes is the
        // existing borrowed O(1) UTF-8 byte query, reached only while tracing.
        if request.trace_sink == .Val(_) {
            if job == {
                .Source(text) -> {
                    user_input_bytes += text.count_bytes()
                    user_source_units += 1
                }
                .RuntimeEntry(text) -> {
                    core_input_bytes += text.count_bytes()
                    core_source_units += 1
                }
                .Core(text, _, _, _) -> {
                    core_input_bytes += text.count_bytes()
                    core_source_units += 1
                }
                .Missing -> {}
            }
        }
        &jobs.push(job)
    }
    workers :: compiler_threads_admit(request.compiler_threads, jobs.len(), total, JET_DRIVER_PARSE_MIN_BYTES_PER_THREAD, largest * JET_DRIVER_PARSE_SCRATCH_PER_BYTE, 0)
    parts := [[JetDriverParseJob]]{}
    if workers <= 1 {
        &jobs.reverse()
        &parts.push(^jobs)
    } else {
        bounds :: compiler_threads_partition(weights, workers)
        loop _ in 0..<workers -> &parts.push([JetDriverParseJob]{})
        part := workers - 1
        loop {
            job :: &jobs.pop() ?? break
            part = compiler_threads_part_of(bounds, part, jobs.len())
            &parts[part].push(job)
        }
        &parts.reverse()
    }
    parsed := jet_driver_parse_parts(^parts)
    results := [JetDriverParsedUnit]{}
    loop {
        done :: &parsed.pop() ?? break
        &results.extend(done)
    }
    &results.reverse()
    // One input-volume delta per completed wave, summed by the trace reader;
    // these are not token, AST, cache-hit, or physical parse-work counts.
    if request.trace_sink == .Val(sink) {
        sink.progress("counters.parse.user_input_bytes", user_input_bytes, 0)
        sink.progress("counters.parse.core_input_bytes", core_input_bytes, 0)
        sink.progress("counters.parse.total_input_bytes", user_input_bytes + core_input_bytes, 0)
        sink.progress("counters.parse.user_source_units", user_source_units, 0)
        sink.progress("counters.parse.core_source_units", core_source_units, 0)
        sink.progress("counters.parse.source_units", user_source_units + core_source_units, 0)
    }
    results
}
fn jet_driver_core_source_segments(path: String, source: String) -> [SemaSourceSegment] Never! {
    segments := jet_driver_source_segments(path, source)
    segments[0].origin = SemaSourceOrigin.CompilerGenerated
    segments
}

fn jet_driver_add_core_unit(source_units: &[JetDriverSourceUnit], queued: &[Bool], generated: &[MIRSourceFile], module_name: String, relative_path: String, file_index: Int, source: String) -> Int {
    path :: "{JET_DRIVER_CORE_SOURCE_ROOT}/{relative_path}"
    &generated.push(MIRSourceFile{id: mir_source_file_id(path), path: path, source: source})
    &source_units.push(jet_driver_core_source_unit(module_name, relative_path, file_index, source))
    &queued.push(false)
    source_units.len() - 1
}

fn jet_driver_core_source_unit(module_name: String, relative_path: String, file_index: Int, source: String) -> JetDriverSourceUnit {
    path :: "{JET_DRIVER_CORE_SOURCE_ROOT}/{relative_path}"
    JetDriverSourceUnit{
        root_index: -1,
        file_index: file_index,
        root_identity: JET_DRIVER_CORE_SOURCE_ROOT,
        package_identity: path,
        module_name: module_name,
        path: path,
        relative_path: relative_path,
        source_segments: jet_driver_core_source_segments(path, source),
        source_origin: SemaSourceOrigin.CompilerGenerated,
        in_namespace: false,
    }
}


// The source unit of the Core module `module_name`, cataloged once. A public
// source row also schedules the compiler-private parts it owns (`core.text`
// owns `Core/text/string.jet`), which no import names. A runtime unit row
// answers only a Core importer (`importer_core`): a Core source or the runtime
// unit entry, which stands for its own unit (`entry_module`/`entry_index`).
// A Core module with no source row becomes an empty module; any other
// `core.*` name is E1001.
fn jet_driver_core_unit(
    source_units: &[JetDriverSourceUnit],
    queued: &[Bool],
    pending: &[Int],
    generated: &[MIRSourceFile],
    core_sources: [JetDriverCoreSource],
    module_name: String,
    importer_core: Bool,
    entry_module: String,
    entry_index: Int,
    span: Span,
    diagnostics: &[Diagnostic],
) -> Int? {
    if importer_core && entry_module != "" && module_name == entry_module -> return Val(entry_index)
    if !importer_core {
        if jet_driver_core_private_unit(module_name, span) == .Val(private) {
            &diagnostics.push(private)
            return None
        }
    }
    loop (index, unit) in source_units {
        if jet_driver_unit_is_core(unit) && unit.module_name == module_name -> return Val(index)
    }
    loop (row_index, row) in core_sources {
        if row.owner != "" || row.module_name != module_name || (row.runtime && !importer_core) -> next
        target :: jet_driver_add_core_unit(&source_units, &queued, &generated, row.module_name, row.path, row_index, row.source)
        loop (part_index, part) in core_sources {
            if part.owner != module_name -> next
            // Rust Loader schedules each part module once (`scheduled.insert`):
            // an alias import may already have cataloged this part.
            scheduled := false
            loop unit in source_units {
                if jet_driver_unit_is_core(unit) && unit.module_name == part.module_name -> scheduled = true
            }
            if scheduled -> next
            part_unit :: jet_driver_add_core_unit(&source_units, &queued, &generated, part.module_name, part.path, part_index, part.source)
            queued[part_unit] = true
            &pending.push(part_unit)
        }
        return Val(target)
    }
    if core_module_export(module_name) == None {
        &diagnostics.push(jet_driver_unknown_core_module(module_name, span, "use"))
        return None
    }
    Val(jet_driver_add_core_unit(&source_units, &queued, &generated, module_name, "{module_name}.jet", -1, ""))
}

// E1001 for a `core.*` path that names no Core module. Rust
// `retired_core_module_diagnostic`: a removed namespace names its canonical
// home instead of the module list, and the Core-private `core.<area>.runtime`
// namespace names its public module. A selective `use core.x.[..]` is checked
// by Rust's checker, whose fix reads "import one of" (`fix_verb`).
fn jet_driver_unknown_core_module(module_name: String, span: Span, fix_verb: String) -> Diagnostic {
    if core_module_retirement(module_name) == .Val(retired) {
        return jet_driver_diagnostic("E1001", span, "core module `{module_name}` was retired", "{retired.decision} removed this free namespace; the canonical home is {retired.canonical}", "use one of: {retired.canonical}")
    }
    if jet_driver_core_private_unit(module_name, span) == .Val(private) -> return private
    names :: loop row in CORE_MODULE_EXPORTS -> row.module_name
    jet_driver_diagnostic("E1001", span, "there is no core module `{module_name}`", "`core` is compiler-known in M10, and only the frozen core modules exist", "{fix_verb} one of: {names.join(", ")}")
}

// The loaded module position of the Core module `module_name`, if any.
fn jet_driver_core_module_position(modules: [JetDriverLoadedModule], source_units: [JetDriverSourceUnit], module_name: String) -> Int? {
    loop (position, module_row) in modules {
        unit :: source_units[module_row.source_unit_index]
        if jet_driver_unit_is_core(unit) && unit.module_name == module_name -> return Val(position)
    }
    None
}

// Place the Core module at `position`, then the compiler-private parts its
// source row owns (`core.text` owns `Core/text/string.jet`).
fn jet_driver_place_core_module(modules: [JetDriverLoadedModule], source_units: [JetDriverSourceUnit], core_sources: [JetDriverCoreSource], position: Int, placed: &[Bool], order: &[Int]) Never! {
    if placed[position] -> return
    placed[position] = true
    &order.push(position)
    owner :: source_units[modules[position].source_unit_index].module_name
    loop (part_position, module_row) in modules {
        unit :: source_units[module_row.source_unit_index]
        if placed[part_position] || !jet_driver_unit_is_core(unit) || unit.file_index < 0 || unit.file_index >= core_sources.len() -> next
        if core_sources[unit.file_index].owner == owner {
            placed[part_position] = true
            &order.push(part_position)
        }
    }
}

// Rust Loader.rs 2633-2785 appends the Core source modules after every user
// module: first the Core modules user code imports (or reaches by naming a
// bare `URL`), in Core table order, each followed by the private parts it
// owns; then, breadth first, the Core modules those import, in import order.
// Host-only Core modules, which Rust never loads, come last in load order.
fn jet_driver_order_core_modules(modules: ^[JetDriverLoadedModule], source_units: [JetDriverSourceUnit], core_sources: [JetDriverCoreSource], bare_modules: [String]) -> [JetDriverLoadedModule] Never! {
    // Discover the complete index order before taking any module. Pop and
    // keyed removal transfer ownership without shifting a vector per module.
    final_order :: jet_driver_core_module_order(modules, source_units, core_sources, bare_modules)
    slots := [Int:JetDriverLoadedModule]{}
    remaining := ^modules
    loop remaining.len() > 0 {
        position :: remaining.len() - 1
        loaded := &remaining.pop() ?? { break }
        slots[position] = ^loaded
    }
    ordered := [JetDriverLoadedModule]{}
    loop position in final_order {
        loaded := &slots.remove(position) ?? next
        &ordered.push(^loaded)
    }
    ordered
}

// The load order of `modules` as positions. `modules` is a read parameter, so
// planning reads every module row through a borrow instead of copying the
// consumed list (or a module) per Core source row.
fn jet_driver_core_module_order(modules: [JetDriverLoadedModule], source_units: [JetDriverSourceUnit], core_sources: [JetDriverCoreSource], bare_modules: [String]) -> [Int] Never! {
    placed := [Bool]{}
    direct := [Bool]{}
    loop position in 0..<modules.len() {
        &placed.push(false)
        &direct.push(false)
    }
    loop module_row in modules {
        if jet_driver_unit_is_core(source_units[module_row.source_unit_index]) -> next
        loop declaration in module_row.program.imports {
            core_name :: jet_driver_core_import_module(declaration) ?? next
            position :: jet_driver_core_module_position(modules, source_units, core_name) ?? next
            direct[position] = true
        }
    }
    loop module_name in bare_modules {
        if jet_driver_core_module_position(modules, source_units, module_name) == .Val(position) -> direct[position] = true
    }
    order := [Int]{}
    loop row_index in 0..<core_sources.len() {
        loop (position, module_row) in modules {
            if direct[position] && source_units[module_row.source_unit_index].file_index == row_index -> jet_driver_place_core_module(modules, source_units, core_sources, position, &placed, &order)
        }
    }
    cursor := 0
    loop cursor < order.len() {
        loop declaration in modules[order[cursor]].program.imports {
            core_name :: jet_driver_core_import_module(declaration) ?? next
            position :: jet_driver_core_module_position(modules, source_units, core_name) ?? next
            if source_units[modules[position].source_unit_index].file_index >= 0 -> jet_driver_place_core_module(modules, source_units, core_sources, position, &placed, &order)
        }
        cursor += 1
    }
    final_order := [Int]{}
    loop position in 0..<modules.len() {
        if !jet_driver_unit_is_core(source_units[modules[position].source_unit_index]) -> &final_order.push(position)
    }
    loop position in order -> &final_order.push(position)
    loop position in 0..<modules.len() {
        if jet_driver_unit_is_core(source_units[modules[position].source_unit_index]) && !placed[position] -> &final_order.push(position)
    }
    final_order
}

// One loaded module row; the program moves in.
fn jet_driver_loaded_module(source_unit_index: Int, unit: JetDriverSourceUnit, module_identity: String, program: ^Program) -> JetDriverLoadedModule {
    JetDriverLoadedModule{
        source_unit_index: source_unit_index,
        source_identity: jet_driver_source_identity(unit.package_identity, unit.path),
        package_identity: unit.package_identity,
        module_identity: module_identity,
        module_name: unit.module_name,
        program: ^program,
    }
}

fn jet_driver_load(request: JetDriverCompileRequest) -> JetDriverLoadResult {
    jet_driver_load_graph(request, JetDriverLoadMode.Program)
}

// Unlike a program's lazy Core import closure, this graph roots every row of
// the installed catalog, including private parts, under the compiler-owned
// library identity. It never borrows a user's authority root or invents run.
fn jet_driver_load_core_library(request: JetDriverCompileRequest) -> JetDriverLoadResult {
    jet_driver_load_graph(request, JetDriverLoadMode.CoreLibrary)
}

fn jet_driver_core_library_catalog(core_sources: [JetDriverCoreSource]) -> JetDriverSourceCatalogResult {
    units := [JetDriverSourceUnit]{}
    keys := [String:String]{}
    loop (index, row) in core_sources {
        unit :: jet_driver_core_source_unit(row.module_name, row.path, index, row.source)
        keys[unit.path] = jet_driver_unit_module_identity(unit)
        &units.push(unit)
    }
    // Same canonical module-owner/path ordering as core_shared_source_seal.
    // file_index still points at the unmodified installed source recipe.
    &units.sort_by((a: JetDriverSourceUnit, b: JetDriverSourceUnit) -> ((keys.get(a.path) ?? "") <=> (keys.get(b.path) ?? "")).then(a.relative_path <=> b.relative_path))
    package :: JetDriverPackageInfo{
        root_index: -1, root_path: JET_DRIVER_CORE_SOURCE_ROOT,
        identity: JET_DRIVER_CORE_SOURCE_ROOT, name: "core", version: "",
        edition: JET_DRIVER_LATEST_EDITION, runtime_ceiling: None,
        allocator_policy: MIRAllocatorPolicy.HostedDefault,
        authority_allow: None, authority_deny: None, authority_needs: [String]{},
        entry: None, manifest_path: None, inline_package: false,
        configs: [String]{},
        dependencies: [JetDriverPackageDependency]{},
        outputs: JetDriverPackageOutputs{library: true, executable: false, entry_modules: [String]{}},
    }
    JetDriverSourceCatalogResult{
        packages: [JetDriverPackageInfo]{package}, source_units: ^units,
        entry_package_identity: JET_DRIVER_CORE_SOURCE_ROOT,
        diagnostics: [Diagnostic]{}, complete: true,
    }
}

fn jet_driver_load_graph(request: JetDriverCompileRequest, mode: JetDriverLoadMode) -> JetDriverLoadResult {
    core_library :: mode == JetDriverLoadMode.CoreLibrary
    diagnostics := [Diagnostic]{}
    failed_stage := JetDriverStage?{None}
    catalog := if core_library -> jet_driver_core_library_catalog(request.core_sources) else -> jet_driver_build_source_catalog(request)
    loop diagnostic in catalog.diagnostics -> &diagnostics.push(diagnostic)
    if !catalog.complete -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Collect)
    // Fix the selected callable before module loading, semantic registration,
    // Job metadata and authority checking; never rename or synthesize `run`.
    if request.selected_entry == .Val(name) {
        loop package_index in 0..<catalog.packages.len() {
            if catalog.packages[package_index].identity == catalog.entry_package_identity {
                catalog.packages[package_index].entry = Val(JetDriverPackageEntry{module_alias: None, function_name: name, source_path: request.authorized_sources.entry_path, span: None})
            }
        }
    }
    source_index_result :: jet_driver_build_source_index(catalog.source_units)
    loop diagnostic in source_index_result.diagnostics -> &diagnostics.push(diagnostic)
    if !source_index_result.complete -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Collect)
    entry_index := Int?{None}
    if core_library {
        // Registration needs one real module anchor, not an executable entry.
        if catalog.source_units.len() > 0 -> entry_index = Val(0)
        else {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0003", "the installed Core source catalog is empty", "the canonical Core library graph must contain its installed source recipe", "supply the complete installed Core source catalog"))
            failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Collect)
        }
    } else {
        entry_index = source_index_result.index.by_path.get(jet_driver_display_path(jet_driver_entry_root_path(request.authorized_sources), request.authorized_sources.entry_path))
        if entry_index == None {
            &diagnostics.push(jet_driver_diagnostic_without_span("E0603", "the entry source unit is not in the selected package source snapshot", "compilation begins from one exact source file beneath the selected authority root", "select the entry source from the authorized package snapshot"))
            failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Collect)
        }
    }
    if jet_driver_has_errors(diagnostics) {
        return JetDriverLoadResult{
            package_identity: catalog.entry_package_identity,
            packages: catalog.packages,
            source_units: catalog.source_units,
            entry_source_identity: "",
            entry_module_identity: "",
            modules: [JetDriverLoadedModule]{},
            imports: [SemaRegistrationImportEdge]{},
            source_files: [MIRSourceFile]{},
            generated_source_files: [MIRSourceFile]{},
            diagnostics: diagnostics,
            failed_stage: failed_stage,
            complete: false,
            mode: mode,
        }
    }

    source_units := catalog.source_units
    selected_entry :: source_units[entry_index ?? 0]
    // Rust read_load threads the entry package's policy through the entire
    // user-source closure, including imports, not each dependency's own floor.
    package_policy := [PolicyDeclaration]{}
    loop package in catalog.packages {
        if package.identity == catalog.entry_package_identity {
            // copy: `catalog` keeps its package rows for the rest of the load (catalog.source_units
            // and the package walk read them below), while the entry policy is threaded separately
            // through every loaded unit.
            package_policy = package.policy_declarations.copy()
            break
        }
    }
    entry_source_identity :: jet_driver_source_identity(selected_entry.package_identity, selected_entry.path)
    entry_module_identity :: if core_library -> jet_driver_unit_module_identity(selected_entry) else -> jet_driver_module_identity(selected_entry.package_identity, selected_entry.path)
    // Only the installed runtime unit's exact source/path earns Core privileges.
    entry_module := ""
    if !core_library {
        if jet_driver_source_unit_text(request, selected_entry) == .Val(entry_text) {
            if jet_driver_runtime_entry_row(request.core_sources, selected_entry, entry_text) == .Val(entry_row) {
                entry_module = request.core_sources[entry_row].module_name
            }
        }
    }
    pending := [Int]{entry_index ?? 0}
    queued := [Bool]{}
    loop unit_index in 0..<source_units.len() -> &queued.push(false)
    queued[entry_index ?? 0] = true
    // The build plan selected these exact modules. Check every selected output,
    // including loose-file outputs not named by an import.
    loop (unit_index, unit) in source_units {
        if (core_library || unit.source_origin == SemaSourceOrigin.CompilerGenerated) && !queued[unit_index] {
            queued[unit_index] = true
            &pending.push(unit_index)
        }
    }
    modules := [JetDriverLoadedModule]{}
    namespace_expanded := [Bool]{}
    loop root_index in 0..<request.authorized_sources.roots.len() -> &namespace_expanded.push(false)
    resolved_imports := [SemaRegistrationImportEdge]{}
    module_edges := jet_driver_module_edges()
    // Exact virtual text records; these are never added to disk authorities.
    core_generated := [MIRSourceFile]{}
    bare_modules := [String]{}
    pending_index := 0
    // The current parse wave's results, last-first: every unit queued when
    // the wave starts is parsed at once, on the admitted compiler threads.
    parsed := [JetDriverParsedUnit]{}
    loop pending_index < pending.len() {
        if parsed.len() == 0 {
            wave_size :: pending.len() - pending_index
            if request.trace_sink == .Val(sink) -> sink.begin("parse", if wave_size == 1 -> source_units[pending[pending_index]].relative_path else -> "{wave_size} files", pending_index, pending.len())
            parsed = jet_driver_parse_wave(request, source_units, pending, pending_index, if entry_module != "" -> entry_index ?? 0 else -> -1)
            if request.trace_sink == .Val(sink) {
                items := 0
                loop wave_result in parsed -> items += wave_result.parsed.program.items.len()
                sink.end("parse", items)
            }
        }
        source_unit_index := pending[pending_index]
        pending_index += 1
        // copy: `unit` must stay readable while loading a Core import appends to `source_units`. A
        // view into the list would dangle when the list grows, so the unit row and this snapshot
        // are independent.
        unit :: source_units[source_unit_index].copy()
        is_core :: jet_driver_unit_is_core(unit)
        is_runtime_entry :: entry_module != "" && source_unit_index == (entry_index ?? 0)
        importer_core :: is_core || is_runtime_entry
        // D-MOD-CYCLE1=A: a package is one namespace. Loading any file of a
        // package loads every other file of it (and, through their imports,
        // the packages they use), so each member sees the whole namespace.
        if jet_driver_unit_is_namespace_member(unit) && !namespace_expanded[unit.root_index] {
            namespace_expanded[unit.root_index] = true
            loop (member_index, member) in source_units {
                if member.root_index == unit.root_index && !queued[member_index] && jet_driver_unit_is_namespace_member(member) {
                    queued[member_index] = true
                    &pending.push(member_index)
                }
            }
        }
        parsed_unit := &parsed.pop() ?? JetDriverParsedUnit{parsed: ParseResult{program: ast_program(), diagnostics: [Diagnostic]{}}, demand: jet_driver_empty_core_identifier_demand()}
        demand :: ^parsed_unit.demand
        parse_result := ^parsed_unit.parsed
        // Runtime member imports consult shared rows only on the load thread.
        if importer_core -> jet_driver_core_runtime_member_imports(&parse_result.program, request.core_sources)
        parse_diagnostic_start :: diagnostics.len()
        loop diagnostic in parse_result.diagnostics -> &diagnostics.push(diagnostic)
        loop parse_diagnostic_index in parse_diagnostic_start..<diagnostics.len() {
            diagnostics[parse_diagnostic_index] = diagnostic_with_source_path(diagnostics[parse_diagnostic_index], unit.path, 0)
        }
        if jet_driver_has_errors(parse_result.diagnostics) -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Parse)
        // Moved out, then the field reset: a plain `^` move out of the field
        // would copy the whole program.
        program := ^parse_result.program
        policy_ok :: if importer_core || jet_driver_has_errors(parse_result.diagnostics) -> true else -> jet_driver_load_policy(&program, package_policy, unit.path, &diagnostics)
        if !policy_ok -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Parse)
        jet_driver_bind_dependency_imports(&program, unit, catalog.packages)
        module_identity :: jet_driver_unit_module_identity(unit)
        if jet_driver_has_errors(parse_result.diagnostics) {
            &modules.push(jet_driver_loaded_module(source_unit_index, unit, module_identity, ^program))
            next
        }
        // Established bare names use the same declaring-owner table as Rust.
        // The lowercase URL typed head remains supported without adding a
        // lowercase nominal alias.
        if !is_core {
            loop bare in CORE_BARE_SOURCE_MODULES {
                if !demand.bare_names.contains(bare.name) -> next
                module_name :: core_bare_source_module(bare.name) ?? next
                if !bare_modules.contains(module_name) -> &bare_modules.push(module_name)
                owner_index :: jet_driver_core_unit(&source_units, &queued, &pending, &core_generated, request.core_sources, module_name, false, entry_module, entry_index ?? 0, Span{start: 0, end: 0}, &diagnostics)
                if owner_index == .Val(index) {
                    if !queued[index] {
                        queued[index] = true
                        &pending.push(index)
                    }
                }
            }
        }
        if demand.math_abs_receiver {
            if !bare_modules.contains("core.math") -> &bare_modules.push("core.math")
            owner_index :: jet_driver_core_unit(&source_units, &queued, &pending, &core_generated, request.core_sources, "core.math", importer_core, entry_module, entry_index ?? 0, Span{start: 0, end: 0}, &diagnostics)
            if owner_index == .Val(index) {
                if !queued[index] {
                    queued[index] = true
                    &pending.push(index)
                }
            }
        }
        // The optional-to-failure view calls the ordinary Core source body,
        // even when the caller has no explicit core.prelude import.
        if demand.option_or_err {
            prelude_index :: jet_driver_core_unit(&source_units, &queued, &pending, &core_generated, request.core_sources, "core.prelude", importer_core, entry_module, entry_index ?? 0, Span{start: 0, end: 0}, &diagnostics)
            if prelude_index == .Val(index) {
                if !queued[index] {
                    queued[index] = true
                    &pending.push(index)
                }
            }
        }
        import_diagnostic_start :: diagnostics.len()

        scoped_imports := [JetDriverScopedImport]{}
        jet_driver_scoped_imports(program.imports, program.items, "", true, &scoped_imports)
        aliases := [String:Int]{}
        loop scoped in scoped_imports {
            if jet_driver_is_foreign_provider_import(scoped.declaration) -> next
            if !jet_driver_check_reserved_import(scoped.declaration, &diagnostics) {
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                next
            }
            target_index := Int?{None}
            if scoped.declaration.kind == {
                .File(path, span) -> {
                    // D-MOD-CYCLE1=A: the files of one package share one
                    // namespace; only loose files import files by path. A
                    // `..` path keeps its more specific E0602.
                    if !path.contains("..") && !jet_driver_unit_is_loose(unit) {
                        &diagnostics.push(jet_driver_diagnostic("E0623", span, "`use \"{path}\"` imports a file, but this file belongs to a package", "the files of one package share one namespace, so they reach each other's names without imports; only loose files import files by path", "remove the import and use the names directly, or import another package with `use <package>.[names]`"))
                        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                        next
                    }
                    diagnostics_before :: diagnostics.len()
                    target_index = jet_driver_lookup_file_target(source_units, unit, path, span, &diagnostics)
                    if target_index == None && diagnostics.len() == diagnostics_before {
                        &diagnostics.push(jet_driver_diagnostic("E0603", span, "the imported file is not in the authorized package source snapshot", "file imports resolve only against exact checked files beneath the same source root", "include the imported source file in the authorized source snapshot"))
                    }
                }
                .Module(name, span) -> {
                    core_module :: jet_driver_core_import_module(scoped.declaration)
                    if core_module == .Val(core_name) {
                        target_index = jet_driver_core_unit(&source_units, &queued, &pending, &core_generated, request.core_sources, core_name, importer_core, entry_module, entry_index ?? 0, span, &diagnostics)
                    } else if is_core {
                        // Reserved parts have exact catalog identities, not a
                        // public Core path or a package dependency name.
                        loop (row_index, row) in request.core_sources {
                            if row.owner == "" || row.alias != name -> next
                            loop (index, candidate) in source_units {
                                if jet_driver_unit_is_core(candidate) && candidate.module_name == row.module_name {
                                    target_index = Val(index)
                                    break
                                }
                            }
                            if target_index == None -> target_index = Val(jet_driver_add_core_unit(&source_units, &queued, &core_generated, row.module_name, row.path, row_index, row.source))
                            break
                        }
                        if target_index == None {
                            target_index = jet_driver_find_module_import_target(unit, name, scoped.declaration.inline_version, catalog.packages, source_units, source_index_result.index, span, &diagnostics)
                        }
                    } else {
                        target_index = jet_driver_find_module_import_target(
                            unit,
                            name,
                            scoped.declaration.inline_version,
                            catalog.packages,
                            source_units,
                            source_index_result.index,
                            span,
                            &diagnostics,
                        )
                    }
                }
                .Unqualified(_, _, _, _, _) -> next
            }
            if target_index == None {
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                next
            }
            if !jet_driver_validate_alias(scoped.declaration.alias, scoped.declaration.alias_span, &diagnostics) {
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                next
            }
            target_unit_index :: target_index ?? 0
            alias_key :: if scoped.scope == "" -> scoped.declaration.alias else -> "{scoped.scope}.{scoped.declaration.alias}"
            _ := &aliases.add(alias_key, target_unit_index)
            target_unit :: source_units[target_unit_index]
            target_identity :: jet_driver_unit_module_identity(target_unit)
            // Core library modules import one another like the Rust loader's
            // transitive Core closure; only user module edges must be acyclic.
            if !jet_driver_unit_is_core(target_unit) && jet_driver_module_reaches(module_edges, target_identity, module_identity) {
                &diagnostics.push(jet_driver_import_cycle(resolved_imports, source_units, jet_driver_unit_module_identity(source_units[entry_index ?? 0]), target_identity, module_identity))
                failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
            }
            edge :: SemaRegistrationImportEdge{
                source_module_identity: module_identity,
                source_scope: scoped.scope,
                source_scope_exported: scoped.exported,
                target_module_identity: target_identity,
                target_package_identity: target_unit.package_identity,
                declaration: scoped.declaration,
                foreign_binding: None,
            }
            jet_driver_module_edges_add(&module_edges, edge)
            &resolved_imports.push(edge)
            if !queued[target_unit_index] {
                queued[target_unit_index] = true
                &pending.push(target_unit_index)
            }
        }
        // D-MOD1 (Rust `load_file`): a body-less `module name` loads the file
        // it declares and binds it as a synthetic file import aliased `name`,
        // after the file's own imports. Body-less modules of Core sources
        // name sibling Core files the catalog already holds as modules.
        // Keep synthetic imports beside the program until every lookup on its
        // own items and imports has finished, then append them to it.
        synthetic_imports := [ImportDecl]{}
        if !is_core {
            loop item in program.items {
                if item == .CodeModule(definition) {
                    if definition.body != None -> next
                    target_unit_index :: jet_driver_code_module_file(source_units, unit, definition.name, definition.name_span, &diagnostics) ?? {
                        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                        next
                    }
                    target_unit :: source_units[target_unit_index]
                    target_identity :: jet_driver_unit_module_identity(target_unit)
                    if jet_driver_module_reaches(module_edges, target_identity, module_identity) {
                        &diagnostics.push(jet_driver_import_cycle(resolved_imports, source_units, jet_driver_unit_module_identity(source_units[entry_index ?? 0]), target_identity, module_identity))
                        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                    }
                    // Rust names the file relative to the declaring file,
                    // without its extension: `name` or `name/module`.
                    direct :: jet_driver_file_import_path(unit.relative_path, definition.name)
                    import_path :: if direct.valid && direct.path == target_unit.relative_path -> definition.name else -> "{definition.name}/module"
                    synthetic :: ImportDecl{kind: ImportKind.File{path: import_path, span: definition.name_span}, alias: definition.name, alias_span: definition.name_span, span: definition.span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, inline_version: None}
                    &synthetic_imports.push(synthetic)
                    if aliases.get(definition.name) == None -> _ := &aliases.add(definition.name, target_unit_index)
                    edge :: SemaRegistrationImportEdge{
                        source_module_identity: module_identity,
                        target_module_identity: target_identity,
                        target_package_identity: target_unit.package_identity,
                        declaration: synthetic,
                        foreign_binding: None,
                    }
                    jet_driver_module_edges_add(&module_edges, edge)
                    &resolved_imports.push(edge)
                    if !queued[target_unit_index] {
                        queued[target_unit_index] = true
                        &pending.push(target_unit_index)
                    }
                }
            }
        }
        loop scoped in scoped_imports {
            if jet_driver_is_foreign_provider_import(scoped.declaration) -> next
            if scoped.declaration.kind == {
                .File(_, _) | .Module(_, _) -> next
                .Unqualified(module_alias, module_alias_span, selected_items, _, _) -> {
                    // An inline `module x { ... }` of this file binds its own
                    // members; semantic preparation resolves `use x.[f]`.
                    if jet_driver_program_has_inline_module(program, module_alias) -> next
                    target_index := jet_driver_scoped_alias(aliases, module_alias, scoped.scope)
                    if target_index == None && is_core {
                        loop (row_index, row) in request.core_sources {
                            if row.owner == "" || row.alias != module_alias -> next
                            loop (index, candidate) in source_units {
                                if jet_driver_unit_is_core(candidate) && candidate.module_name == row.module_name {
                                    target_index = Val(index)
                                    break
                                }
                            }
                            if target_index == None -> target_index = Val(jet_driver_add_core_unit(&source_units, &queued, &core_generated, row.module_name, row.path, row_index, row.source))
                            if target_index == .Val(core_index) && !queued[core_index] {
                                queued[core_index] = true
                                &pending.push(core_index)
                            }
                            break
                        }
                    }
                    // `use core.perf.[PerfError]` selects from the Core module itself.
                    core_module :: jet_driver_core_import_module(scoped.declaration)
                    if target_index == None {
                        if core_module == .Val(core_name) {
                            // Rust reports an unknown selective Core path per
                            // member, naming `core.x.member`, at the module path.
                            unknown := [Diagnostic]{}
                            target_index = jet_driver_core_unit(&source_units, &queued, &pending, &core_generated, request.core_sources, core_name, importer_core, entry_module, entry_index ?? 0, module_alias_span, &unknown)
                            if unknown.len() > 0 {
                                loop selected in selected_items -> &diagnostics.push(jet_driver_unknown_core_module("{core_name}.{selected.original}", module_alias_span, "import"))
                            }
                            if target_index == .Val(core_index) {
                                if !queued[core_index] {
                                    queued[core_index] = true
                                    &pending.push(core_index)
                                }
                            }
                        }
                    }
                    selected_index :: target_index ?? {
                        if core_module == None -> &diagnostics.push(jet_driver_diagnostic("E0610", module_alias_span, "no module named `{module_alias}` in scope", "the alias must refer to a module imported earlier in this file", "add `import … as {module_alias}`  before this `use`"))
                        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
                        next
                    }
                    target_unit :: source_units[selected_index]
                    &resolved_imports.push(SemaRegistrationImportEdge{
                        source_module_identity: module_identity,
                        source_scope: scoped.scope,
                        source_scope_exported: scoped.exported,
                        target_module_identity: jet_driver_unit_module_identity(target_unit),
                        target_package_identity: target_unit.package_identity,
                        declaration: scoped.declaration,
                        foreign_binding: None,
                    })
                }
            }
        }
        loop synthetic in synthetic_imports -> &program.imports.push(synthetic)
        // Pushed last, so the loop reads its own program instead of a copy of
        // the module row's.
        &modules.push(jet_driver_loaded_module(source_unit_index, unit, module_identity, ^program))
        loop import_diagnostic_index in import_diagnostic_start..<diagnostics.len() {
            diagnostics[import_diagnostic_index] = diagnostic_with_source_path(diagnostics[import_diagnostic_index], unit.path, 0)
        }
    }
    if !jet_driver_has_errors(diagnostics) && !jet_driver_bind_package_namespaces(&modules, source_units, catalog.packages, request.authorized_sources.roots, request.core_sources, &diagnostics) {
        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Load)
    }
    modules = jet_driver_order_core_modules(^modules, source_units, request.core_sources, bare_modules)
    provenance :: jet_driver_collect_source_files(request.authorized_sources, source_units, modules, core_generated)
    loop diagnostic in provenance.diagnostics -> &diagnostics.push(diagnostic)
    if !provenance.complete -> failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Collect)
    if failed_stage == None && !jet_driver_expand_imported_marker_groups(&modules, &resolved_imports, source_units, provenance.files, &diagnostics) {
        failed_stage = jet_driver_set_failed_stage(failed_stage, JetDriverStage.Parse)
    }
    complete :: failed_stage == None && !jet_driver_has_errors(diagnostics)
    names :: jet_driver_loaded_names(&modules, source_units, resolved_imports)
    JetDriverLoadResult{
        package_identity: catalog.entry_package_identity,
        packages: catalog.packages,
        source_units: source_units,
        entry_source_identity: entry_source_identity,
        entry_module_identity: entry_module_identity,
        modules: modules,
        imports: resolved_imports,
        source_files: provenance.files,
        generated_source_files: core_generated,
        diagnostics: diagnostics,
        failed_stage: failed_stage,
        complete: complete,
        names: Val(names),
    }
}
