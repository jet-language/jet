    pub unsafe_paths: [String]?
    pub expert: Bool?
    pub deps: [String]?
    pub lints_deny: [String]?
}
// Rust: crates/jet-driver/src/Driver/mod.rs:118
pub struct GuaranteeReport {
    pub profile: String
    pub package: Bool
    pub no_os: Bool
    pub policy: GuaranteePolicyReport
    pub components: [GuaranteeComponent]
    pub notes: [String]
}
// Rust: crates/jet-driver/src/Driver/mod.rs:130
pub fn guarantee_report(package: PackageFacts?, loaded_dependencies: [String], unsafe_gates: USize, profile: String, no_os: Bool) -> GuaranteeReport {
    dependencies := [String: Bool]{}
    if package := package { for dependency in package.deps.keys() { dependencies[dependency] = true } }
    for dependency in loaded_dependencies { dependencies[dependency] = true }
    package_guarantees :: package.map(Loader.package_guarantees_for_manifest)
    profile_hardened :: profile == Syntax.BUILD_PROFILE_HARDENED
    manifest_hardened :: package_guarantees.is_some_and((facts) -> facts.harden)
    harden :: profile_hardened || manifest_hardened
    contained := [String: Bool]{}
    if harden { contained = dependencies }
    else if facts := package_guarantees {
        for dependency in dependencies.keys() { if facts.contain.contains(dependency) { contained[dependency] = true } }
    }
    sentries_active :: !no_os && (profile != "release" || harden)
    components := [GuaranteeComponent{name: "your code", status: .Proven, evidence: "compile-time prover"}]
    gate_status :: if unsafe_gates == 0 { GuaranteeStatus.Proven } else if sentries_active { GuaranteeStatus.Watched } else { GuaranteeStatus.Trusted }
    gate_evidence :: if unsafe_gates == 0 { "no audited gates" } else if sentries_active { "runtime sentries active" }
        else if no_os { "runtime sentries unavailable" } else { "release sentries disabled" }
    components.push(GuaranteeComponent{name: "#Unsafe gates ({unsafe_gates})", status: gate_status, evidence: gate_evidence})
    if dependencies.is_empty() {
        components.push(GuaranteeComponent{
            name: "externs", status: if package != None { .Proven } else { .Trusted },
            evidence: if package != None { "no foreign dependencies declared" } else { "outside package guarantee" },
        })
    } else {
        names := dependencies.keys().collect()
        names.sort()
        for dependency in names {
            fenced :: !no_os && contained.contains_key(dependency)
            components.push(GuaranteeComponent{name: dependency,
                status: if fenced { .Fenced } else { .Trusted },
                evidence: if fenced { "tracked handles inside dependency fence" } else { "outside package guarantee" }})
        }
    }
    if package := package { append_authority_grants(&components, package) }
    notes := [String][]
    if package == None {
        notes.push(if profile_hardened {
            "single-file: hardened watches #Unsafe gates; no foreign dependencies are declared"
        } else { "single-file: no package.jet; contain/harden unavailable; externs remain TRUSTED" })
    } else if harden && no_os {
        notes.push(if profile_hardened { "hardened profile requested, but no-OS targets have no runtime fence" }
            else { "harden: true requested, but no-OS targets have no runtime fence" })
    } else if profile_hardened { notes.push("hardened profile; every foreign dependency is fenced") }
    else if harden { notes.push("harden: true; every foreign dependency is fenced") }
    else if package_guarantees.is_some_and((facts) -> !facts.contain.is_empty()) {
        notes.push("uncontained dependencies remain TRUSTED; add them to contain or set harden: true")
    }
    if profile == "release" && unsafe_gates > 0 && !harden { notes.push("release sentries: off; set harden: true to watch every #Unsafe gate") }
    if no_os { notes.push("no-OS: prover + audit only") }
    policy :: package_guarantees.map((facts) -> GuaranteePolicyReport{
        effects: facts.effects, unsafe_paths: facts.unsafe_paths, expert: facts.expert,
        deps: facts.deps, lints_deny: facts.lints_deny,
    }).unwrap_or_else(() -> GuaranteePolicyReport{effects: [String: [String: Bool]]{}, unsafe_paths: None, expert: None, deps: None, lints_deny: None})
    GuaranteeReport{profile: profile, package: package != None, no_os: no_os, policy: policy, components: components, notes: notes}
}
// Rust: crates/jet-driver/src/Driver/mod.rs:292
fn append_authority_grants(components: &[GuaranteeComponent], package: PackageFacts) -> {
    // Rust: crates/jet-driver/src/Driver/mod.rs:296
    fn effect_names(effects: [String]) -> String {
        names := [String: Bool]{}
        for effect in effects { names[effect] = true }
        ordered := names.keys().collect()
        ordered.sort()
        if ordered.is_empty() { "none" } else { ordered.join(",") }
    }
    if effects := package.authority.holds.allow {
        components.push(GuaranteeComponent{name: "authority.holds.allow", status: .Proven, evidence: "granted effects: {effect_names(effects)}"})
    }
    if effects := package.authority.holds.deny {
        components.push(GuaranteeComponent{name: "authority.holds.deny", status: .Fenced, evidence: "denied effects: {effect_names(effects)}"})
    }
    dependencies := package.authority.grants.keys().collect()
    dependencies.sort()
    for dependency in dependencies {
        components.push(GuaranteeComponent{name: "authority.grants.{dependency}", status: .Proven,
            evidence: "granted effects: {effect_names(package.authority.grants[dependency])}"})
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:331
fn apply_package_lint_policy(bundle: ProgramBundle, diagnostics: [Diagnostic]) -> [Diagnostic] [Diagnostic]! {
    deny :: bundle.package_guarantees.lints_deny.unwrap_or([])
    jet_foundation.LintPolicy.apply(deny, diagnostics)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:346
fn package_team_policy_diagnostics(bundle: ProgramBundle, manifest: PackageFacts, facts: Sema.SemIndexEffectFacts) -> [Diagnostic] {
    diagnostics := Sema.package_effect_policy_diagnostics(bundle, facts.solved, manifest.policy.effects)
    if allowed := manifest.policy.deps {
        dependencies := [String: Bool]{}
        for dependency in bundle.package_guarantees.dependency_names { dependencies[dependency] = true }
        for dependency in manifest.deps.keys() { dependencies[dependency] = true }
        for dependency in bundle.dep_roots.keys() { dependencies[dependency] = true }
        ordered := dependencies.keys().collect()
        ordered.sort()
        for dependency in ordered {
            if allowed.contains(dependency) { continue }
            diagnostics.push(Diagnostic.from_row("E2960", [("rule", "policy.deps"), ("subject", dependency), ("path", "package.jet")], None))
        }
    }
    diagnostics
}
// Rust: crates/jet-driver/src/Driver/mod.rs:384
fn apply_package_effect_budget(bundle: ProgramBundle, facts: Sema.SemIndexEffectFacts, diagnostics: [Diagnostic]) -> [Diagnostic] [Diagnostic]! {
    manifest :: Loader.package_facts_for_bundle(bundle)? ?? return diagnostics
    entries :: EffectBudget.compute_package_effects(bundle, facts.solved, facts.summaries)
    result := diagnostics
    result.extend(package_team_policy_diagnostics(bundle, manifest, facts))
    result.extend(EffectBudget.enforce(entries, manifest))
    result
}
// Rust: crates/jet-driver/src/Driver/mod.rs:401
fn classify_diagnostics(bundle: ProgramBundle, diagnostics: [Diagnostic], suppress_build_e0102: Bool) -> [Diagnostic] [Diagnostic]! {
    errors := [Diagnostic][]
    lints := [Diagnostic][]
    for diagnostic in apply_package_lint_policy(bundle, diagnostics)? {
        if diagnostic.severity == {
            Severity.Error -> { if !(suppress_build_e0102 && diagnostic.code == "E0102") { errors.push(diagnostic) } }
            Severity.Lint -> { lints.push(diagnostic) }
        }
    }
    if errors.is_empty() { lints } else { Err(errors) }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:430
pub fn gate_diagnostics(bundle: ProgramBundle, parse_teaching: [Diagnostic], sema: [Diagnostic], extension: [Diagnostic]) -> [Diagnostic] [Diagnostic]! {
    diagnostics := parse_teaching
    diagnostics.extend(sema)
    diagnostics.extend(extension)
    classify_diagnostics(bundle, diagnostics, false)?
}
