fn target_machine_for_facts(no_os: Bool, web_target: Bool, target_triple: String) -> TargetMachine {
    if web_target { TargetMachine.wasm_browser() }
    else if target_triple == Syntax.BUILD_TARGET_WASI_SERVER { TargetMachine.wasm_wasi() }
    else if no_os { TargetMachine.bare_metal("no-os", target_triple) }
    else { TargetMachine.hosted(target_triple) }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1413
fn refresh_target_dossier(bundle: &ProgramBundle, no_os: Bool, web_target: Bool) -> {
    target_triple :: bundle.build_facts.target_triple
    machine :: bundle.build_facts.target_dossier.machine.unwrap_or_else(() -> target_machine_for_facts(no_os, web_target, target_triple))
    if web_target { bundle.build_facts.target_triple = machine.triple }
    usage :: TargetMachineUse.from_core_apis(bundle.used_core)
    dossier := target_dossier_for_usage(machine, usage, "none")
    dossier.layer = bundle.inferred_layer
    bundle.build_facts.target_dossier = dossier
}
