impl BuildArtifactStore for BuildArtifactStoreHandle {
    // Rust: crates/jet-driver/src/Driver/mod.rs:34
    fn put_blob(self, bytes: [U8]) -> ContentDigest IOError! {
        object :: self.store.publish_blob(bytes).map_err(store_io_error)?
        ContentDigest.parse("sha256:{object.digest().to_hex()}").map_err((error) -> IOError.new(ErrorKind.InvalidData, error.to_string()))?
    }
    // Rust: crates/jet-driver/src/Driver/mod.rs:43
    fn get_blob(self, digest: ContentDigest) -> [U8]? IOError! {
        hex :: digest.as_str().strip_prefix("sha256:").ok_or_else(() -> IOError.new(ErrorKind.InvalidInput, "artifact digest has no sha256 prefix"))?
        digest :: Digest.from_hex(hex).map_err(store_io_error)?
        self.store.blob_by_digest(digest).map_err(store_io_error)?
    }
    // Rust: crates/jet-driver/src/Driver/mod.rs:57
    fn put_record(self, key: String, bytes: [U8]) -> Unit IOError! {
        action :: self.store.action(key)
        self.store.publish_action(action, bytes).map_err(store_io_error)?
    }
    // Rust: crates/jet-driver/src/Driver/mod.rs:64
    fn get_record(self, key: String) -> [U8]? IOError! {
        action :: self.store.action(key)
        self.store.get_action(action).map_err(store_io_error)?
    }
}
