// Rust: crates/jet-driver/src/Driver/mod.rs:1034
fn resolve_target_clang() -> OSPath [TargetMachineError]! {
    if path := env.var("JET_TARGET_CLANG").ok() {
        p :: OSPath.from(path)
        if p.is_file() { return p }
    }
    if out := Command.new("clang").arg("-print-prog-name=clang").output().ok() {
        if out.status.success() {
            path := String.from_utf8_lossy(out.stdout).trim() // #4303
            p :: OSPath.from(path.to_string())
            if p.is_file() { return p }
        }
    }
    resolve_tool("clang")?
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1058
fn resolve_tool(name: String) -> OSPath [TargetMachineError]! {
    if path := which_tool(name).ok() { return path }
    Err([TargetMachineError.FirmwareToolchainMissing{tool: name}])
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1071
fn which_tool(name: String) -> OSPath Unit! {
    output :: Command.new("sh").arg("-c").arg("command -v {name}").output().map_err((_) -> Unit{})?
    if !output.status.success() { return Err(Unit{}) }
    path := String.from_utf8_lossy(output.stdout).trim() // #4303
    if path.is_empty() { return Err(Unit{}) }
    OSPath.from(path.to_string())
}
