// Rust: crates/jet-driver/src/Driver/mod.rs:1442
fn target_machine_usage_for_file(file: String, mode: Sema.CompileMode, machine: TargetMachine, profile: String, locked: Bool,
    setting_overrides: [String: String], source_closure: [(OSPath, String)]) -> TargetMachineUse [Diagnostic]! {
    overlays :: source_closure.map((row) -> (row.0, row.1))
    bundle := Loader.load_entry_with_overlays(file, overlays, false)?
    seed_build_facts(&bundle, profile, locked, setting_overrides)?
    (diags, effect_facts) :: Sema.check_bundle_with_effect_facts(&bundle, mode)
    parse_teaching :: ^bundle.parse_teaching
    bundle.parse_teaching = []
    _ :: gate_diagnostics(bundle, parse_teaching, diags, [])?
    usage := Sema.target_machine_use(bundle)
    usage.mmio = collect_mmio_usage(bundle)
    hardware :: Sema.target_hardware_use_with_effect_facts(bundle, effect_facts)
    target_diags := Sema.check_target_machine(machine, usage)
    target_diags.extend(Sema.validate_target_hardware(machine, hardware))
    if target_diags.is_empty() { usage } else { Err(target_diags) }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1473
struct PtrFact { address: U64; size: ByteSize }
// Rust: crates/jet-driver/src/Driver/mod.rs:1478
fn collect_mmio_usage(bundle: ProgramBundle) -> [MmioAccess] {
    out := [MmioAccess][]
    for module in bundle.modules {
        aliases :: core_aliases(module)
        for item in module.items {
            if item == {
                Item.Func(f) -> collect_mmio_func(f, aliases, &out)
                Item.Struct(s) -> { for method in s.methods { collect_mmio_func(method, aliases, &out) } }
                Item.Enum(e) -> { for method in e.methods { collect_mmio_func(method, aliases, &out) } }
                Item.Impl(i) -> { for method in i.methods { collect_mmio_func(method, aliases, &out) } }
                else -> {}
            }
        }
    }
    out
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1507
fn core_aliases(module: LoadedModule) -> [String: String] {
    aliases := [String: String]{}
    for import in module.imports {
        if import.kind == {
            ImportKind.Module(name, _) -> {
                if Syntax.is_known_core_module(name) {
                    alias :: if import.alias.is_empty() { name.rsplit('.').next().unwrap_or(name) } else { import.alias }
                    aliases[alias] = name
                }
            }
            ImportKind.Unqualified(module_alias: module_alias) -> {
                if prefix := core_list_prefix(module_alias) {
                    for binding in import.walk_bindings() {
                        original :: binding.original ?? continue
                        full :: "{prefix}.{original}"
                        if Syntax.is_known_core_module(full) { aliases[binding.local] = full }
                    }
                }
            }
            else -> {}
        }
    }
    aliases
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1539
fn collect_mmio_func(f: Func, core_aliases: [String: String], out: &[MmioAccess]) -> {
    ptrs := [String: PtrFact]{}
    reason :: if f.is_unsafe { f.unsafe_reason } else { None }
    collect_mmio_stmts(f.body, core_aliases, &ptrs, reason, &out)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1553
fn collect_mmio_stmts(stmts: [Stmt], core_aliases: [String: String], ptrs: &[String: PtrFact], unsafe_reason: String?, out: &[MmioAccess]) -> {
    for stmt in stmts {
        if stmt == {
            Stmt.Val(b) -> {
                collect_mmio_expr(b.init, core_aliases, ptrs, unsafe_reason, &out)
                if fact := ptr_fact_from_expr(b.init) { ptrs[b.name] = fact }
            }
            Stmt.Expr(e) | Stmt.DeferClose(close: e) | Stmt.Return(Some(e), _) -> collect_mmio_expr(e, core_aliases, ptrs, unsafe_reason, &out)
            Stmt.Assign(value: value) -> collect_mmio_expr(value, core_aliases, ptrs, unsafe_reason, &out)
            Stmt.While(cond: cond, body: body) -> {
                collect_mmio_expr(cond, core_aliases, ptrs, unsafe_reason, &out)
                collect_mmio_stmts(body, core_aliases, &ptrs, unsafe_reason, &out)
            }
            Stmt.For(kind: kind, body: body) -> {
                collect_mmio_for_kind(kind, core_aliases, &ptrs, unsafe_reason, &out)
                collect_mmio_stmts(body, core_aliases, &ptrs, unsafe_reason, &out)
            }
            Stmt.Switch(subject: subject, arms: arms, else_body: else_body) -> {
                collect_mmio_expr(subject, core_aliases, ptrs, unsafe_reason, &out)
                for arm in arms { collect_mmio_stmts(arm.body, core_aliases, &ptrs, unsafe_reason, &out) }
                if body := else_body { collect_mmio_stmts(body, core_aliases, &ptrs, unsafe_reason, &out) }
            }
            Stmt.Loop(body: body) | Stmt.Impure(body: body) | Stmt.Reactive(body: body) | Stmt.Region(body: body) |
            Stmt.Policy(body: body) | Stmt.TaskGroup(body: body) -> collect_mmio_stmts(body, core_aliases, &ptrs, unsafe_reason, &out)
            Stmt.Unsafe(audit: audit, body: body) -> collect_mmio_stmts(body, core_aliases, &ptrs, audit, &out)
            Stmt.CountedLoop(init: init, cond: cond, step: step, body: body) -> {
                collect_mmio_expr(init.init, core_aliases, ptrs, unsafe_reason, &out)
                if fact := ptr_fact_from_expr(init.init) { ptrs[init.name] = fact }
                collect_mmio_expr(cond, core_aliases, ptrs, unsafe_reason, &out)
                if step := step { collect_mmio_stmts([step], core_aliases, &ptrs, unsafe_reason, &out) }
                collect_mmio_stmts(body, core_aliases, &ptrs, unsafe_reason, &out)
            }
            Stmt.Return(None, _) | Stmt.Break(_) | Stmt.Continue(_) | Stmt.BreakLabel(_, _) | Stmt.ContinueLabel(_, _) -> {}
            else -> {}
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1642
fn collect_mmio_for_kind(kind: ForKind, core_aliases: [String: String], ptrs: &[String: PtrFact], unsafe_reason: String?, out: &[MmioAccess]) -> {
    if kind == {
        ForKind.Range(start: start, end: end, step: step) -> {
            collect_mmio_expr(start, core_aliases, ptrs, unsafe_reason, &out)
            collect_mmio_expr(end, core_aliases, ptrs, unsafe_reason, &out)
            if step := step { collect_mmio_expr(step, core_aliases, ptrs, unsafe_reason, &out) }
        }
        ForKind.In(collection: collection, step: step) -> {
            collect_mmio_expr(collection, core_aliases, ptrs, unsafe_reason, &out)
            if step := step { collect_mmio_expr(step, core_aliases, ptrs, unsafe_reason, &out) }
        }
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1671
fn collect_mmio_expr(expr: Expr, core_aliases: [String: String], ptrs: [String: PtrFact], unsafe_reason: String?, out: &[MmioAccess]) -> {
    if expr == {
        Expr.PtrFromAddr(addr: addr) -> collect_mmio_expr(addr, core_aliases, ptrs, unsafe_reason, &out)
        Expr.MethodCall(receiver: receiver, method: method, args: args) -> {
            if is_core_mem_receiver(receiver, core_aliases) && (method == "volatile_read" || method == "volatile_write") {
                if first := args.first() {
                    if first.expr == {
                        Expr.Ident(name, _) -> {
                            if fact := ptrs.get(name) {
                                out.push(MmioAccess{address: fact.address, size: fact.size,
                                    unsafe_gate: unsafe_reason.map((reason) -> UnsafeGate{reason: reason})})
                            }
                        }
                        else -> {}
                    }
                }
            }
            collect_mmio_expr(receiver, core_aliases, ptrs, unsafe_reason, &out)
            for arg in args { collect_mmio_expr(arg.expr, core_aliases, ptrs, unsafe_reason, &out) }
        }
        Expr.Call(c) -> { for arg in c.args { collect_mmio_expr(arg.expr, core_aliases, ptrs, unsafe_reason, &out) } }
        Expr.Binary(_, a, b, _) -> {
            collect_mmio_expr(a, core_aliases, ptrs, unsafe_reason, &out)
            collect_mmio_expr(b, core_aliases, ptrs, unsafe_reason, &out)
        }
        Expr.Index(base: base, index: index) -> {
            collect_mmio_expr(base, core_aliases, ptrs, unsafe_reason, &out)
            collect_mmio_expr(index, core_aliases, ptrs, unsafe_reason, &out)
        }
        Expr.OrFallback(value: value, fallback: fallback) -> {
            collect_mmio_expr(value, core_aliases, ptrs, unsafe_reason, &out)
            if fallback == { OrFallback.Value(v) -> collect_mmio_expr(v, core_aliases, ptrs, unsafe_reason, &out); else -> {} }
        }
        Expr.Unary(_, e, _) | Expr.Copy(e, _) | Expr.Place(e, _, _) | Expr.Deref(e, _) | Expr.RawOf(e, _) |
        Expr.Field(e, _, _) | Expr.OptField(base: e) -> collect_mmio_expr(e, core_aliases, ptrs, unsafe_reason, &out)
        Expr.StructLit(fields: fields) -> { for (_, _, value) in fields { collect_mmio_expr(value, core_aliases, ptrs, unsafe_reason, &out) } }
        Expr.ListLit(elems, _) -> { for elem in elems { collect_mmio_expr(elem, core_aliases, ptrs, unsafe_reason, &out) } }
        Expr.MapLit(entries, _) -> {
            for (k, v) in entries {
                collect_mmio_expr(k, core_aliases, ptrs, unsafe_reason, &out)
                collect_mmio_expr(v, core_aliases, ptrs, unsafe_reason, &out)
            }
        }
        Expr.TupleLit(fields, _, _) -> { for (_, value) in fields { collect_mmio_expr(value, core_aliases, ptrs, unsafe_reason, &out) } }
        Expr.CallValue(callee: callee, args: args) -> {
            collect_mmio_expr(callee, core_aliases, ptrs, unsafe_reason, &out)
            for arg in args { collect_mmio_expr(arg.expr, core_aliases, ptrs, unsafe_reason, &out) }
        }
        else -> {}
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1773
fn is_core_mem_receiver(receiver: Expr, core_aliases: [String: String]) -> Bool {
    if receiver == { Expr.Ident(alias, _) -> core_aliases.get(alias).is_some_and((m) -> m == "core.mem"); else -> false }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1780
fn ptr_fact_from_expr(expr: Expr) -> PtrFact? {
    if expr == {
        Expr.PtrFromAddr(elem: elem, addr: addr) -> {
            if addr == {
                Expr.Int(address, _, _, _) -> {
                    if address < 0 { return None }
                    size :: byte_size_for_type(elem) ?? return None
                    PtrFact{address: address as U64, size: size}
                }
                else -> None
            }
        }
        else -> None
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:1796
// Complete this boundary-spanning item; Driver02 omits its leading continuation.
fn byte_size_for_type(ty: Type) -> ByteSize? {
    if ty == {
        Type.Bool -> ByteSize.bytes(1)
        Type.Char | Type.Float32 -> ByteSize.bytes(4)
        Type.Int | Type.Float | Type.String -> ByteSize.bytes(8)
        Type.IntN(bits: bits) -> ByteSize.bytes((bits as U64) / 8)
        Type.InlineRange(base: base) -> byte_size_for_type(base)
        Type.Tagged(inner: inner) -> byte_size_for_type(inner)
        else -> None
    }
}
