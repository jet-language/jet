// Rust: crates/jet-driver/src/Driver/mod.rs:654
fn compile_bundle_path_with_target_machine_on_compiler_stack_with_runtime(file: String, mode: Sema.CompileMode,
    machine: TargetMachine, gates: GateSet, profile: String, locked: Bool, setting_overrides: [String: String],
    source_closure: [(OSPath, String)], application_authority: ApplicationAuthority?) -> (CompileOutput, ProgramBundle) TargetMachineCompileError! {
    usage :: target_machine_usage_for_file(file, mode, machine, profile, locked, setting_overrides, source_closure).map_err(TargetMachineCompileError.Diagnostics)?
    dossier :: target_dossier_for_usage(machine, usage, "none")
    compile_bundle_path_opts_on_compiler_stack_with_runtime(file, mode, machine.no_os, gates, machine.is_web_target(),
        false, false, false, Some(machine.triple), None, profile, setting_overrides, locked, None, None, Some(dossier),
        Some(source_closure), application_authority).map_err(TargetMachineCompileError.Diagnostics)?
}
// Rust: crates/jet-driver/src/Driver/mod.rs:701
pub struct TargetFirmwareArtifacts {
    pub out_dir: OSPath
    pub linker_script: OSPath
    pub startup: OSPath
    pub startup_object: OSPath
    pub provider: OSPath
    pub provider_object: OSPath
    pub program_object: OSPath
    pub map: OSPath
    pub elf: OSPath
    pub audit_json: OSPath
    pub size_budget: SizeBudgetReport
    pub audit: String
}
// Rust: crates/jet-driver/src/Driver/mod.rs:715
pub fn build_target_machine_firmware(machine: TargetMachine, usage: TargetMachineUse,
    program_object: OSPath, out_dir: OSPath) -> TargetFirmwareArtifacts TargetMachineCompileError! {
    program_bytes :: fs.read(program_object).map_err((error) -> .Machine([TargetMachineError.FirmwareBuildFailed{
        detail: "read checked program object `{program_object.display()}`: {error}"}]))?
    if program_bytes.is_empty() {
        return Err(.Machine([TargetMachineError.FirmwareBuildFailed{detail: "checked program object `{program_object.display()}` is empty"}]))
    }
    machine.supports_execution_tier(ExecutionTier.Aot).map_err((err) -> .Machine([err]))?
    // Expected rejection for no-OS; the audit carries its execution field.
    _ :: machine.supports_execution_tier(ExecutionTier.Dev)
    errors := machine.validate(usage)
    if !machine.no_os { errors.push(TargetMachineError.HostedHasNoLinkerScript) }
    if !errors.is_empty() { return Err(.Machine(errors)) }
    linker :: machine.generate_linker_script().map_err((e) -> .Machine([e]))?
    startup :: machine.generate_startup_source().map_err((e) -> .Machine([e]))?
    provider :: machine.generate_provider_source().map_err((e) -> .Machine([e]))?
    fs.create_dir_all(out_dir).map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "create out dir: {e}"}]))?
    linker_path :: out_dir.join("memory.ld")
    startup_path :: out_dir.join(startup.filename)
    startup_obj_path :: out_dir.join("startup.o")
    provider_path :: out_dir.join(provider.filename)
    provider_obj_path :: out_dir.join("target_providers.o")
    map_path :: out_dir.join("firmware.map")
    elf_path :: out_dir.join("firmware.elf")
    audit_path :: out_dir.join("{sanitize_name(machine.name)}.target.json")
    fs.write(linker_path, linker).map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "write linker: {e}"}]))?
    fs.write(startup_path, startup.contents).map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "write startup: {e}"}]))?
    fs.write(provider_path, provider.contents).map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "write target providers: {e}"}]))?
    clang :: resolve_target_clang().map_err(TargetMachineCompileError.Machine)?
    lld :: resolve_tool("ld.lld").map_err(TargetMachineCompileError.Machine)?
    compile_source :: (source: OSPath, object: OSPath) -> Unit TargetMachineCompileError! {
        output :: Command.new(clang).arg("--target={machine.triple}").arg("-nostdlib").arg("-ffreestanding")
            .arg("-fno-builtin").arg("-c").arg(source).arg("-o").arg(object).output()
            .map_err((error) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "spawn clang for `{source.display()}`: {error}"}]))?
        if !output.status.success() {
            stderr := String.from_utf8_lossy(output.stderr).trim() // #4303
            return Err(.Machine([TargetMachineError.FirmwareBuildFailed{detail: "clang failed for `{source.display()}`: {stderr}"}]))
        }
    }
    compile_source(startup_path, startup_obj_path)?
    compile_source(provider_path, provider_obj_path)?
    link_cmd := Command.new(lld)
    link_cmd.arg("-T{linker_path.display()}").arg("-Map={map_path.display()}").arg("--gc-sections").arg("-o").arg(elf_path)
        .arg(program_object).arg(startup_obj_path).arg(provider_obj_path)
    if machine.triple.contains("aarch64") { link_cmd.arg("-m").arg("aarch64elf") }
    else if machine.triple.contains("thumb") || machine.triple.starts_with("arm") { link_cmd.arg("-m").arg("armelf") }
    link_out :: link_cmd.output().map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "spawn ld.lld: {e}"}]))?
    if !link_out.status.success() {
        stderr := String.from_utf8_lossy(link_out.stderr).trim() // #4303
        return Err(.Machine([TargetMachineError.FirmwareBuildFailed{detail: "ld.lld failed: {stderr}"}]))
    }
    artifact_bytes :: fs.metadata(elf_path).map((m) -> m.len()).unwrap_or(0)
    size_budget :: machine.size_budget(usage, artifact_bytes)
    if !size_budget.ok() { return Err(.Machine([TargetMachineError.SizeBudgetExceeded{report: size_budget}])) }
    machine_audit :: machine.audit_json_with_budget(usage, Some(size_budget))
    digest :: (path: OSPath) -> fs.read(path).map((bytes) -> "sha256:{sha256_hex(bytes)}").unwrap_or_else((_) -> "unreadable")
    program_path :: graph_json_escape(program_object.display().to_string())
    startup_source_path :: graph_json_escape(startup_path.display().to_string())
    provider_source_path :: graph_json_escape(provider_path.display().to_string())
    linker_script_path :: graph_json_escape(linker_path.display().to_string())
    startup_object_path :: graph_json_escape(startup_obj_path.display().to_string())
    provider_object_path :: graph_json_escape(provider_obj_path.display().to_string())
    elf_display_path :: graph_json_escape(elf_path.display().to_string())
    audit :: "{{\"machine\":{machine_audit},\"firmware\":{{\"program_object\":{{\"path\":\"{program_path}\",\"sha256\":\"{digest(program_object)}\"}},\"startup_source\":{{\"path\":\"{startup_source_path}\",\"sha256\":\"{digest(startup_path)}\"}},\"provider_source\":{{\"path\":\"{provider_source_path}\",\"sha256\":\"{digest(provider_path)}\"}},\"linker_script\":{{\"path\":\"{linker_script_path}\",\"sha256\":\"{digest(linker_path)}\"}},\"startup_object\":\"{startup_object_path}\",\"provider_object\":\"{provider_object_path}\",\"elf\":{{\"path\":\"{elf_display_path}\",\"sha256\":\"{digest(elf_path)}\"}}}}}}"
    fs.write(audit_path, audit).map_err((e) -> .Machine([TargetMachineError.FirmwareBuildFailed{detail: "write audit: {e}"}]))?
    TargetFirmwareArtifacts{out_dir: out_dir, linker_script: linker_path, startup: startup_path, startup_object: startup_obj_path,
        provider: provider_path, provider_object: provider_obj_path, program_object: program_object, map: map_path,
        elf: elf_path, audit_json: audit_path, size_budget: size_budget, audit: audit}
}
// Rust: crates/jet-driver/src/Driver/mod.rs:925
pub fn qemu_target_machine_smoke(machine: TargetMachine, elf: OSPath) -> String [TargetMachineError]! {
    (tool, model, cpu) :: if machine.name == {
        "board.sensor_v1" -> ("qemu-system-arm", "mps2-an386", "cortex-m4")
        "board.virt_aarch64" -> ("qemu-system-aarch64", "virt", "cortex-a57")
        else -> { return Err([TargetMachineError.FirmwareBuildFailed{detail: "no QEMU model declared for `{machine.name}`"}]) }
    }
    qemu :: resolve_tool(tool)?
    output :: Command.new("timeout").arg("3").arg(qemu).arg("-machine").arg(model).arg("-cpu").arg(cpu)
        .arg("-nographic").arg("-kernel").arg(elf).output().map_err((e) -> [TargetMachineError.FirmwareBuildFailed{detail: "spawn qemu: {e}"}])?
    serial :: "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}"
    if output.status.code() == {
        Some(0) | Some(124) -> serial
        status -> Err([TargetMachineError.FirmwareBuildFailed{detail: "qemu smoke failed (status={status:?}); serial={serial:?}"}])
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:976
pub fn target_machine_by_name(name: String) -> TargetMachine? {
    if name == {
        "board.sensor_v1" | "firmware" | "sensor" -> TargetMachine.board_sensor_v1()
        "board.virt_aarch64" | "virt" -> TargetMachine.board_virt_aarch64()
        "wasm.browser" -> TargetMachine.wasm_browser()
        "wasm.wasi" -> TargetMachine.wasm_wasi()
        "wasm.no-os" -> TargetMachine.wasm_no_os()
        "hosted" -> TargetMachine.hosted("x86_64-unknown-linux-gnu")
        else -> None
    }
}
