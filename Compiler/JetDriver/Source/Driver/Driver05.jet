// Rust: crates/jet-driver/src/Driver/mod.rs:8323
pub fn compile_bundle_path_with_entry_and_settings(file: String, entry_fn: String, profile: String, setting_overrides: [String: String]) -> CompileOutput [Diagnostic]! {
