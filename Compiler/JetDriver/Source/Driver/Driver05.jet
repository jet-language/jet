// Rust: crates/jet-driver/src/Driver/mod.rs:8004
fn check_eval_on_compiler_stack(src: String, file: String) -> ([Diagnostic], ProgramBundle?, SemIndexEffectFacts) {
    source_for_parse :: if Package.mask_inline_package_source(src) == { Ok((masked, _)) -> masked; Err(error) -> return ([error.diagnostic()], nil, SemIndexEffectFacts.default()) }
    (toks, lex_diags) :: Lexer.lex(&source_for_parse)
    if !lex_diags.is_empty() { return (lex_diags, nil, SemIndexEffectFacts.default()) }
    prog := if Parser.parse_with_source(&toks, &source_for_parse) == { Ok(p) -> p; Err(ds) -> return (ds, nil, SemIndexEffectFacts.default()) }
    bundle := ProgramBundle(
        entry: 0,
        project_root: OSPath(file).parent().unwrap_or(OSPath(".")).to_path_buf(),
        modules: [LoadedModule(
            path: OSPath(file), display: file.to_string(), alias: "main",
            imports: std.mem.take(&prog.imports), items: std.mem.take(&prog.items),
            script_body: std.mem.take(&prog.script_body), block_spans: std.mem.take(&prog.block_spans),
            source: src.to_string(), web_target_ceiling: prog.web_target_ceiling,
            pub_file: prog.pub_file, no_prelude: prog.no_prelude, default_target: prog.default_target,
            html_path: prog.html_path.clone(), policy_declarations: prog.policy_declarations.clone(),
            user_policy_declarations: prog.user_policy_declarations.clone(), rule_facts: std.mem.take(&prog.rule_facts)
        )],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [],
        used_core: HashSet.new(), ffi_callback_fns: HashSet.new(), cffi: CFFI.CFfi.default(),
        comptime_inputs: [], name_ledger: NameLedger.default(), layer_ceiling: nil,
        inferred_layer: RuntimeLayer.Core, web_partitions: [:], web_partition_enforced: false,
        web_partition_report: nil, dep_roots: [:], package_guarantees: Default.default(),
        program_allocator: Default.default(), active_os: OSTarget.host(), build_facts: Default.default(),
        edition: Manifest.latest_edition().to_string()
    )
    if Foreign.assemble_active_namespaces(&bundle) == Err(diags) { return (diags, nil, SemIndexEffectFacts.default()) }
    bundle.cffi = if CFFI.assemble(&bundle) == { Ok(c) -> c; Err(diags) -> return (diags, nil, SemIndexEffectFacts.default()) }
    (diags, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Eval)
    (diags, Val(^bundle), facts)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8087
pub fn check_eval(src: String, file: String) -> [Diagnostic] {
    (diags, _, _) :: check_eval_with_effect_facts(src, file)
    diags.into_iter().filter((d) -> d.severity == Severity.Error).collect()
}
