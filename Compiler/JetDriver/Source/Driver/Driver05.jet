// Rust: crates/jet-driver/src/Driver/mod.rs:7953
fn check_file_with_import_root_on_compiler_stack(file: String, overlays: [(OSPath, String)]) -> ([Diagnostic], ProgramBundle?, SemIndexEffectFacts) {
    if Loader.load_entry_with_overlays_and_import_root(file, overlays, false) == {
        Ok(loaded_bundle) -> {
            bundle := ^loaded_bundle
            diags := std.mem.take(&bundle.parse_teaching)
            if seed_build_facts(&bundle, "dev", false, [String: String]{}) == Err(fact_diags) {
                diags.extend(fact_diags)
                return (diags, nil, SemIndexEffectFacts.default())
            }
            (check_diags, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check)
            diags.extend(check_diags)
            extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, Val(&facts), &diags)
            diags.extend(extension_diags)
            budgeted :: if apply_package_effect_budget(&bundle, &facts, ^diags) == { Ok(value) -> value; Err(errors) -> return (errors, nil, facts) }
            if apply_package_lint_policy(&bundle, budgeted) == { Ok(value) -> (value, Val(^bundle), facts); Err(errors) -> (errors, nil, facts) }
        }
        Err(diags) -> (diags, nil, SemIndexEffectFacts.default())
    }
}
