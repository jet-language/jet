// Rust: crates/jet-driver/src/Driver/mod.rs:7617
// Consume sema's measured recheck cone and canonical changed-function decision.
pub fn check_file_with_hot_swap_incremental(old: ProgramBundle, file: String, overlay: (OSPath, String)?, is_lsp: Bool, module_name: String, cache: &IncrementalSemaCache) -> ([Diagnostic], ProgramBundle?, SemIndexEffectFacts, HotSwapDecision?) {
    overlays :: overlay.into_iter().collect::<[(OSPath, String)]>()
    (diagnostics, bundle, facts, decision, _) :: check_file_with_hot_swap_incremental_overlays(old, file, overlays, is_lsp, module_name, cache)
    (diagnostics, bundle, facts, decision)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:7643
pub fn check_file_with_hot_swap_incremental_overlays(old: ProgramBundle, file: String, overlays: [(OSPath, String)], is_lsp: Bool, module_name: String, cache: &IncrementalSemaCache) -> ([Diagnostic], ProgramBundle?, SemIndexEffectFacts, HotSwapDecision?, [OSPath]) {
    cache.clear_measurement()
    (diagnostics_initial, bundle, facts, source_closure) :: check_file_with_effect_facts_incremental_overlays(file, overlays, is_lsp, cache)
    diagnostics := ^diagnostics_initial
    rechecked_items :: cache.stats().recomputed_items
    decision :: bundle.as_ref().and_then((new) -> {
        if Sema.HotSwap.type_stable_decision(old, new, module_name) == {
            Ok(decision) -> Val(decision.with_rechecked_items(rechecked_items))
            Err(errors) -> { diagnostics.extend(errors); nil }
        }
    })
    (diagnostics, bundle, facts, decision, source_closure)
}
