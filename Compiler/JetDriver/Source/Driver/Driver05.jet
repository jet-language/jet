// Rust: crates/jet-driver/src/Driver/mod.rs:7806
fn check_file_on_compiler_stack_with_entry(file: String, overlays: [(OSPath, String)], is_lsp: Bool, incremental: (&IncrementalSemaCache)?, prepared_frontend: (&Loader.PreparedFrontend)?, profile: String, setting_overrides: [String: String], explicit_output: String?, run_mode: Bool, entry_fn: String?) -> ([Diagnostic], ProgramBundle?, SemIndexEffectFacts, [OSPath]) {
    (loaded, dependencies, loader_diagnostics) :: if prepared_frontend == {
        Val(frontend) -> Loader.load_entry_with_overlays_and_prepared_frontend_with_diagnostics(file, overlays, is_lsp, frontend)
        nil -> Loader.load_entry_with_overlays_and_dependencies_with_diagnostics(file, overlays, is_lsp)
    }
    if loaded == {
        Ok(loaded_bundle) -> {
            bundle := ^loaded_bundle
            diags := std.mem.take(&bundle.parse_teaching)
            if seed_build_facts(&bundle, profile, false, setting_overrides) == Err(fact_diags) {
                diags.extend(fact_diags)
                return (diags, nil, SemIndexEffectFacts.default(), dependencies)
            }
            if entry_fn == Val(entry) { swap_entry_point(&bundle, entry) }
            (check_diags, facts) :: if explicit_output == Val(output) -> Sema.check_bundle_for_output_opts_with_effect_facts(&bundle, Sema.CompileMode.Run, output, false, Policy.GateSet.default())
                else if run_mode -> Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Run)
                else -> if incremental == { Val(cache) -> Sema.check_bundle_with_effect_facts_incremental(&bundle, Sema.CompileMode.Check, cache); nil -> Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check) }
            diags.extend(check_diags)
            if bundle.modules[bundle.entry].items.iter().find((item) -> if item == .Func(func) -> Sema.is_build_entry(func) else -> false) == Val(.Func(build)) {
                if !valid_build_signature(build) { diags.push(bad_build_signature(build.name_span)) }
            }
            extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, Val(&facts), &diags)
            diags.extend(extension_diags)
            budgeted :: if apply_package_effect_budget(&bundle, &facts, ^diags) == { Ok(value) -> value; Err(errors) -> return (errors, nil, facts, dependencies) }
            if apply_package_lint_policy(&bundle, budgeted) == { Ok(value) -> (value, Val(^bundle), facts, dependencies); Err(errors) -> (errors, nil, facts, dependencies) }
        }
        Err(diags) -> {
            facts := SemIndexEffectFacts.default()
            loop entry in loader_diagnostics {
                if entry.structure_fact == Val(fact) { facts.name_ledger.record_structure_fact(fact) }
            }
            (diags, nil, facts, dependencies)
        }
    }
}
