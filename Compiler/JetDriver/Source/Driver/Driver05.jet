// Rust: crates/jet-driver/src/Driver/mod.rs:8339
fn compile_bundle_path_with_entry_on_compiler_stack(file: String, entry_fn: String, profile: String, setting_overrides: [String: String]) -> CompileOutput [Diagnostic]! {
    bundle := Loader.load_entry_with_overlay(file, nil, false)?
    seed_build_facts(&bundle, profile, false, setting_overrides)?
    swap_entry_point(&bundle, entry_fn)
    mode :: Sema.CompileMode.Run
    (diags, effect_facts) :: Sema.check_bundle_with_effect_facts(&bundle, mode)
    extension_diags :: CompilerExtensionHook.post_sema_diagnostics(&bundle, Val(&effect_facts), &diags)
    parse_teaching :: std.mem.take(&bundle.parse_teaching)
    lints :: gate_diagnostics(&bundle, parse_teaching, diags, extension_diags)?
    ffi :: FFI.prepare(&bundle)?
    // D-OSTARGET1=A: dev's entry-swap path is native host, never a cross compile.
    request :: mir_artifact_request_for_build(&bundle, mode, profile, false, false, false)
    (mir, artifact) :: lower_checked_mir_program_for(&bundle, request)
    execution := MIRRust.MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi.as_ref()
    execution.release_devtools_policy = release_devtools_policy_for_bundle(&bundle, profile)
    execution.emit_types = true
    execution.emit_foreign = true
    execution.emit_metadata = false
    execution.emit_debug_linemap = false
    execution.emit_runtime = true
    rust :: MIRRust.emit_mir_program(&mir, &MIRRust.MirRustConfig(target: TargetLayout.host(), target_kind: MIRRust.MirRustTarget.Native, root_prefix: "", execution: ^execution))
    comptime_inputs :: std.mem.take(&bundle.comptime_inputs)
    Ok(CompileOutput(rust: ^rust, lints: ^lints, ffi: ^ffi, clinks: [], comptime_inputs: ^comptime_inputs, web: nil, web_partition_report: bundle.web_partition_report.clone(), plugin: nil, library: nil, library_config: nil, inferred_layer: bundle.inferred_layer, layer_ceiling: bundle.layer_ceiling))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8395
fn qualified_entry_call_name(bundle: ProgramBundle, target_module: USize, entry_fn: String) -> String? {
    if target_module == bundle.entry { return Val(entry_fn.to_string()) }
    pending := VecDeque.from([(bundle.entry, [String]())])
    visited := HashSet.new()
    loop {
        (module, path) :: pending.pop_front() ?? break
        if !visited.insert(module) { next }
        loop import in &bundle.modules[module].imports {
            target :: bundle.name_ledger.import_target(module, import.span) ?? next
            next_path := path.clone()
            next_path.push(import.import_alias())
            if target == target_module { next_path.push(entry_fn.to_string()); return Val(next_path.join(".")) }
            pending.push_back((target, next_path))
        }
    }
    nil
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8434
// Compiler-owned CLI/Decode record mirrors the checked job argument schema.
fn job_argument_record(bundle: ProgramBundle, target: Func) -> StructDef? {
    if !target.is_job || target.params.is_empty() { return nil }
    if target.params.iter().any((param) -> param.variadic) { return nil }
    if target.params.len() == 1 {
        if target.params[0].ty == .Named(name) {
            leaf :: name.rsplit(['.', ':']).next().unwrap_or(name)
            is_cli_record :: bundle.modules.iter().flat_map((module) -> module.items.iter()).any((item) -> if item == .Struct(structure) -> structure.name == leaf && structure.derives.iter().any((pair) -> pair.0 == MARKER_CLI) else -> false)
            if is_cli_record { return nil }
        }
    }
    zero :: Span.new(0, 0)
    fields :: target.params.iter().map((param) -> Field(
        is_pub: false, is_package_pub: false, name: param.name.clone(), name_span: param.name_span,
        ty: param.ty.clone(), ty_span: param.ty_span, serde_markers: [], redact: false,
        computed: nil, default: param.default.clone(), default_ct: nil
    )).collect::<[Field]>()
    Val(StructDef(
        span: zero, is_pub: false, is_package_pub: false,
        name: mangle_generated(&"job_args_{target.name}"), name_span: zero,
        type_params: [], fields: ^fields, state: nil, methods: [], cli_bindings: [], trait_impls: [],
        derives: [(MARKER_CLI.to_string(), zero), (MARKER_DECODE.to_string(), zero)],
        auto_derive_default: false, is_published_schema: false, published_schema_span: nil,
        is_single_use: false, single_use_span: nil, is_must_use: false, must_use_span: nil,
        layout: nil, layout_span: nil, serde_markers: [], type_markers: [], validate_block: [], validate_span: nil
    ))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8529
// Park run and inject a forwarding entry, leaving the selected job plainly callable.
pub fn swap_entry_point(bundle: &ProgramBundle, entry_fn: String) -> {
    if entry_fn == "run" { return }
    entry_module :: &bundle.modules[bundle.entry]
    if !entry_module.script_body.is_empty() && entry_module.items.iter().any((item) -> if item == .Func(func) -> func.name == "run" else -> false) { return }
    (target_module, target) :: bundle.modules.iter().enumerate().find_map((pair) -> pair.1.items.iter().find_map((item) -> if item == .Func(f) && f.name == entry_fn -> Val((pair.0, f.clone())) else -> nil)) ?? return
    call_name :: qualified_entry_call_name(bundle, target_module, entry_fn) ?? return
    job_record :: job_argument_record(bundle, &target)
    items :: &bundle.modules[bundle.entry].items
    loop item in items.iter_mut() {
        if item == .Func(f) {
            if f.name == "run" {
                f.name = mangle_generated("unused_run")
                // Synthetic fallible script entry must not leave E0114 on parked run.
                if f.span == f.name_span { f.return_type = nil; f.return_type_span = nil }
            }
        }
    }
    zero :: Span.new(0, 0)
    record_param :: job_record.as_ref().map((record) -> {
        param := target.params[0].clone()
        param.convention = AccessConvention.Read
        param.root = false
        param.name = mangle_generated("job_args")
        param.name_span = zero
        param.public_label = nil
        param.zone = ParamZone.Either
        param.ty = Type.Named(record.name.clone())
        param.ty_span = zero
        param.default = nil
        param.variadic = false
        param.variadic_bound_list = nil
        param.declared_view_from_names = nil
        param
    })
    args :: target.params.iter().map((p) -> CallArg(
        convention: p.convention,
        expr: if record_param == { Val(record) -> Expr.Field(Expr.Ident(record.name.clone(), zero), p.name.clone(), p.name_span); nil -> Expr.Ident(p.name.clone(), p.name_span) },
        span: p.name_span, flags: CallArgFlags.default(),
        label: if record_param.is_some() && p.zone == ParamZone.LabelOnly -> Val((p.call_label().to_string(), zero)) else -> nil,
        spread: p.variadic
    )).collect::<[CallArg]>()
    call :: Expr.Call(Call(name: call_name, name_span: zero, type_args: [], args: ^args, resolved_ret: nil, range_checked: false, widen_approx: false))
    body :: [Stmt.Return(Val(call), zero)]
    items.push(Item.Func(Func(
        span: zero, is_pub: false, is_comptime: false, is_package_pub: false, external_type: nil,
        name: "run", name_span: zero, meta: nil, type_params: target.type_params.clone(), head_pattern: nil,
        params: if record_param == { Val(param) -> [param.clone()]; nil -> target.params.clone() },
        return_type: target.return_type.clone(), return_type_span: target.return_type_span,
        return_view_provenance: nil, declared_return_view_provenance: nil,
        gc_return: false, diverges: false, gc_scope: false, is_unsafe: false,
        unsafe_reason: nil, unsafe_span: nil, is_pure: false, is_sanitizer: false, scrub_tag: nil,
        declared_effects: nil, effect_via: nil, state_requires: nil, state_transition: nil,
        is_reactive: false, reactive_upgrades: [], is_replayable: false, replayable_span: nil,
        is_job: false, job_span: nil, every: nil, job_metadata: nil,
        is_must_use: false, must_use_span: nil, maturity: nil, maturity_span: nil, kernel: nil,
        is_inline: false, is_inline_always: false, inline_span: nil, web_marker: nil,
        pre: [], post: [], inline_foreign: nil, undo: nil, markers: [], compiler_generated: true, body: ^body
    )))
    if job_record == Val(record) { items.push(Item.Struct(record)) }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8695
fn compile_test_override_on_compiler_stack(file: String, coverage: Bool, profile: String, setting_overrides: [String: String]) -> (String, FFI.FfiLink?, [Diagnostic]) [Diagnostic]! {
    bundle := Loader.load_entry_with_overlay(file, nil, false)?
    seed_build_facts(&bundle, profile, false, setting_overrides)?
    mode :: Sema.CompileMode.TestOverride
    diags :: Sema.check_bundle(&bundle, mode)
    parse_teaching :: std.mem.take(&bundle.parse_teaching)
    lints :: classify_diagnostics(&bundle, parse_teaching.into_iter().chain(diags).collect(), false)?
    ffi :: FFI.prepare(&bundle)?
    build_mode :: if coverage -> MirArtifactBuildMode.Coverage else -> MirArtifactBuildMode.Test
    request :: MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.TestOverride, build_mode)
    (mir, artifact) :: lower_checked_mir_program_for(&bundle, request)
    execution := MIRRust.MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi.as_ref()
    execution.release_devtools_policy = release_devtools_policy_for_bundle(&bundle, profile)
    execution.emit_types = true
    execution.emit_foreign = true
    execution.emit_metadata = false
    execution.emit_debug_linemap = false
    execution.emit_runtime = true
    rust :: MIRRust.emit_mir_program(&mir, &MIRRust.MirRustConfig(target: TargetLayout.host(), target_kind: MIRRust.MirRustTarget.Native, root_prefix: "", execution: ^execution))
    Ok((rust, ffi, lints))
}
