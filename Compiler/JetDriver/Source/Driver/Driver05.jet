// Rust: crates/jet-driver/src/Driver/mod.rs:7429
pub struct CheckedSourceBundle {
    pub bundle: ProgramBundle
    pub effect_facts: SemIndexEffectFacts
    pub project_root: OSPath
    pub source_closure: [(OSPath, String)]
}
impl CheckedSourceBundle {
    // Rust: crates/jet-driver/src/Driver/mod.rs:7437
    pub fn new(bundle: ProgramBundle, effect_facts: SemIndexEffectFacts) -> Self {
        project_root :: bundle.project_root.clone()
        source_closure := bundle.modules.iter().map((module) -> (module.path.clone(), module.source.clone())).collect::<[(OSPath, String)]>()
        source_closure.sort_by((left, right) -> left.0.cmp(&right.0))
        source_closure.dedup_by((left, right) -> left.0 == right.0)
        Self(bundle: ^bundle, effect_facts: ^effect_facts, project_root: ^project_root, source_closure: ^source_closure)
    }
    // Rust: crates/jet-driver/src/Driver/mod.rs:7457
    pub fn overlays(self) -> [(OSPath, String)] {
        self.source_closure.iter().map((pair) -> (pair.0.as_path(), pair.1.as_str())).collect()
    }
}
// Rust: crates/jet-driver/src/Driver/mod.rs:7467
pub fn check_file_with_checked_source_bundle_for_run_and_entry(file: String, overlays: [(OSPath, String)], profile: String, setting_overrides: [String: String], entry_fn: String?) -> ([Diagnostic], CheckedSourceBundle?) {
    (diagnostics, bundle, facts, _) :: check_file_with_effect_facts_impl_for_run_with_overlays(file, overlays, profile, setting_overrides, entry_fn)
    checked :: bundle.map((bundle) -> CheckedSourceBundle.new(^bundle, ^facts))
    (diagnostics, checked)
}
