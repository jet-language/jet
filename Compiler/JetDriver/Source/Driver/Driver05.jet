#Error
pub enum FuzzCompileError {
    Diagnostics([Diagnostic])
    Target(String)
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8202
fn select_fuzz_test_name(bundle: ProgramBundle, wanted: String?) -> String Err! {
    all_tests := [(String, Bool)]()
    properties := [String]()
    loop module in &bundle.modules {
        loop item in &module.items {
            test :: if item == .Test(test) -> test else -> next
            name :: test.name.clone().unwrap_or_else(() -> "anonymous")
            is_property :: !test.params.is_empty()
            all_tests.push((name.clone(), is_property))
            if is_property { properties.push(name) }
        }
    }
    if wanted == Val(wanted_name) {
        if all_tests.iter().find((pair) -> pair.0 == wanted_name) == Val((name, true)) { return Ok(name.clone()) }
        if all_tests.iter().any((pair) -> pair.0 == wanted_name && !pair.1) { return Err("`{wanted_name}` is not a property test") }
        return Err("can't find property test `{wanted_name}`")
    }
    if properties.len() == 0 -> Err("no property `#Test fn` found in the target")
    else if properties.len() == 1 -> Ok(properties[0].clone())
    else -> Err("multiple property tests found: {properties.join(", ")}; fix: `jet test --grade=generated <file> <name>`")
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8252
pub fn compile_fuzz(file: String, test_name: String?) -> (String, FFI.FfiLink?) FuzzCompileError! {
    run_compiler_work(() -> compile_fuzz_on_compiler_stack(file, test_name))
}
// Rust: crates/jet-driver/src/Driver/mod.rs:8259
fn compile_fuzz_on_compiler_stack(file: String, test_name: String?) -> (String, FFI.FfiLink?) FuzzCompileError! {
    bundle := Loader.load_entry_with_overlay(file, nil, false).map_err(FuzzCompileError.Diagnostics)?
    diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Test)
    parse_teaching :: std.mem.take(&bundle.parse_teaching)
    _lints :: classify_diagnostics(&bundle, parse_teaching.into_iter().chain(diags).collect(), false).map_err(FuzzCompileError.Diagnostics)?
    selected_name :: select_fuzz_test_name(&bundle, test_name).map_err(FuzzCompileError.Target)?
    ffi :: FFI.prepare(&bundle).map_err(FuzzCompileError.Diagnostics)?
    request :: MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.FuzzExecutable, MirArtifactBuildMode.Fuzz).with_name(selected_name)
    (mir, artifact) :: TIR.lower_checked_mir_program_for(&bundle, request).unwrap_or_else((error) -> jet_foundation.ice(Val(error.span), "{error}"))
    _ :: mir.validate().unwrap_or_else((error) -> jet_foundation.ice(nil, "canonical MIR validation failed: {error}"))
    execution := MIRRust.MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi.as_ref()
    rust :: MIRRust.emit_mir_program(&mir, &MIRRust.MirRustConfig(target: TargetLayout.host(), target_kind: MIRRust.MirRustTarget.Native, root_prefix: "", execution: ^execution))
    Ok((rust, ffi))
}
