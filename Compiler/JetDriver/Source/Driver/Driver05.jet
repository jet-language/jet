// Rust: crates/jet-driver/src/Driver/mod.rs:8107
pub fn compile_tests_with_profile(file: String, coverage: Bool, profile: String, setting_overrides: [String: String]) -> (String, FFI.FfiLink?, [Diagnostic]) [Diagnostic]! {
    run_compiler_work(() -> compile_tests_on_compiler_stack(file, coverage, profile, setting_overrides))
