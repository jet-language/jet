// Pure-call folding over canonical MIR.
//
// Compile time is explicit in the checker (`prep`), so an ordinary immutable
// binding such as `limit :: square(12)` reaches MIR as a runtime call. This
// pass recovers that optimization after checking: when an immutable local is
// initialized from effect-free work over constants, the work runs once in the
// MIR evaluator and the result becomes a MIR constant. Every execution tier
// consumes the folded program. It mirrors the Rust bootstrap's
// crates/jet-codegen/src/Codegen/MIREval/PureFold.rs and runs on freshly
// assembled MIR, before the canonical optimizer.
//
// Folding is optional: a callee with effects, a failure carrier, memoization,
// captures or a generator is left alone, as is any evaluation that fails,
// prints, exhausts its fuel or yields a value too large to inline.
use jet_foundation.[
    CompilerThreads,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_partition,
    compiler_transfer_rows,
    MIRBasicBlock,
    MIRBlockID,
    MIRCallArg,
    MIRCallFallibility,
    MIRCaptureParam,
    MIRConstant,
    MIRCopyFact,
    MIRDropAction,
    MIREffectFacts,
    MIRFailureCarrier,
    MIRFunction,
    MIRFunctionForm,
    MIRFunctionID,
    MIRFunctionKind,
    MIRGenericParam,
    MIRInstruction,
    MIRIntegerWidth,
    MIRLocal,
    MIRNamedSpan,
    MIROpID,
    MIROperation,
    MIRParam,
    MIRPhiIncoming,
    MIRPlace,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRProgram,
    MIRScope,
    MIRSemanticOp,
    MIRTerminator,
    MIRType,
    MIRValueFact,
    MIRValueID,
    MIRWebParamReconstruction,
    TComptimeValue,
    mir_empty_optimization_facts,
    mir_operation_value_uses,
    mir_semantic_op_prelude_calls,
]
use jet_eval.[
    jet_eval_default_config,
    jet_eval_pure_functions,
]

JET_DRIVER_PURE_FOLD_ROUNDS :: 8
JET_DRIVER_PURE_FOLD_OUTPUT_BUDGET :: 262144
// Most instructions one fold may re-run to rebuild its inputs.
JET_DRIVER_PURE_FOLD_MAX_SLICE :: 256

struct JetDriverPureFoldSite {
    function: Int
    block: Int
    instruction: Int
    synthetic: MIRFunctionID
    ty: MIRType
}

struct JetDriverPureFoldCandidates {
    sites: [JetDriverPureFoldSite]
    functions: [MIRFunction]
}

// Fold effect-free work that initializes immutable locals from constants.
// Each round appends its synthetic functions to the program, moves the
// program through one machine that evaluates every candidate (never a copy
// per evaluation), drops the synthetics again, and only then writes the
// folded constants, so every evaluation of a round sees the same program.
fn jet_driver_fold_pure_calls(program: ^MIRProgram, threads: CompilerThreads) -> MIRProgram {
    declined := [String:Bool]{}
    folded := jet_driver_pure_fold_rounds(^program, &declined, 0, threads)
    jet_driver_pure_fold_resolve_joins(^folded, threads)
}

fn jet_driver_pure_fold_rounds(program: ^MIRProgram, declined: &[String:Bool], round: Int, threads: CompilerThreads) -> MIRProgram {
    taken := program
    if round >= JET_DRIVER_PURE_FOLD_ROUNDS -> return taken
    // The scan moves the program through the threads' shared inputs and
    // hands it back unchanged.
    scan := jet_driver_pure_fold_candidates(^taken, declined, threads)
    candidates := ^scan.candidates
    folding := ^scan.program
    if candidates.sites.len() == 0 -> return folding
    base_len :: folding.functions.len()
    loop synthetic in candidates.functions -> &folding.functions.push(synthetic)
    synthetic_ids := (loop site in candidates.sites -> site.synthetic)
    (result, values) := jet_eval_pure_functions(^folding, synthetic_ids)
    loop result.functions.len() > base_len -> _ := &result.functions.pop()
    changed := false
    loop (index, site) in candidates.sites {
        if jet_driver_pure_fold_folded(values[index], site.ty) == {
            .Val(constant) -> {
                result.functions[site.function].blocks[site.block].instructions[site.instruction].operation = MIROperation.Constant{value: constant}
                changed = true
            }
            .None -> {
                _ := &declined.add(jet_driver_pure_fold_site_key(site.function, site.block, site.instruction), true)
            }
        }
    }
    if !changed -> return result
    jet_driver_pure_fold_rounds(^result, &declined, round + 1, threads)
}

// Replace a scalar join whose live edges all carry one constant with that
// constant. Folding decided the branch (`m :: if a > b -> a else -> b`, or
// the test behind `xs.min_by(f) ?? -1`), so every tier reads a literal.
// The joins are found on the threads, each reading its consecutive function
// range of the program in place (the same partition as the candidate scan),
// and rewritten after every read returned, in function order; a function's
// joins depend on that function alone, so the rewrites are those the
// one-thread read-then-write loop made.
fn jet_driver_pure_fold_resolve_joins(program: ^MIRProgram, threads: CompilerThreads) -> MIRProgram {
    scanned := program
    weights := [Int]{}
    total := 0
    loop function in scanned.functions {
        count := 0
        loop block in function.blocks -> count += block.instructions.len()
        &weights.push(count)
        total += count
    }
    workers :: compiler_threads_admit(threads, weights.len(), total, JET_DRIVER_PURE_FOLD_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    bounds :: compiler_threads_partition(weights, workers)
    inputs :: shared JetDriverPureFoldShared{programs: [MIRProgram]{^scanned}, declined: [String:Bool]{}, callees: [U64:Bool]{}, preludes: [U64:Bool]{}}
    parts := [Shared<JetDriverPureFoldJoinPart>]{}
    loop part in 0..<(bounds.len() - 1) -> &parts.push(shared JetDriverPureFoldJoinPart{start: bounds[part], end: bounds[part + 1], outputs: [[JetDriverPureFoldJoin]]{}})
    _ := jet_driver_pure_fold_join_parts(inputs, parts, 0)
    folded := jet_driver_pure_fold_shared_take(inputs)
    loop part in parts {
        rewrites := jet_driver_pure_fold_join_part_take(part)
        loop rewrite in rewrites {
            folded.functions[rewrite.function].blocks[rewrite.block].instructions[rewrite.instruction].operation = MIROperation.Constant{value: rewrite.constant}
        }
    }
    folded
}

// One join resolve_joins rewrites to its constant.
struct JetDriverPureFoldJoin {
    function: Int
    block: Int
    instruction: Int
    constant: MIRConstant
}

// One thread's consecutive function range and the joins it found, in
// function and instruction order (`outputs` holds one row once the thread
// finished).
struct JetDriverPureFoldJoinPart {
    start: Int
    end: Int
    outputs: [[JetDriverPureFoldJoin]]
}

// A part's joins, after its thread joined.
fn jet_driver_pure_fold_join_part_take(part: Shared<JetDriverPureFoldJoinPart>) -> [JetDriverPureFoldJoin] {
    permit :: part.guard_edit()
    &permit.value.outputs.pop() ?? panic("a pure-fold join thread left no rewrites")
}

// Reads `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts read.
fn jet_driver_pure_fold_join_parts(inputs: Shared<JetDriverPureFoldShared>, parts: [Shared<JetDriverPureFoldJoinPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return jet_driver_pure_fold_join_part(inputs, parts[from])
    read := 0
    task.group pure_fold_join_threads {
        head :: task jet_driver_pure_fold_join_part(inputs, parts[from])
        read = jet_driver_pure_fold_join_parts(inputs, parts, from + 1)
        read += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    read
}

// One thread: the constant joins of its function range.
fn jet_driver_pure_fold_join_part(inputs: Shared<JetDriverPureFoldShared>, part: Shared<JetDriverPureFoldJoinPart>) -> Int {
    permit := part.guard_edit()
    reads :: inputs.guard_read()
    rewrites := [JetDriverPureFoldJoin]{}
    loop function_index in permit.value.start..<permit.value.end {
        function :: reads.value.programs[0].functions[function_index]
        initializers :: jet_driver_pure_fold_initializers(function)
        if initializers.len() == 0 -> next
        constants :: jet_driver_pure_fold_constants(function, initializers, jet_driver_pure_fold_root_locals(function))
        loop (block_index, block) in function.blocks {
            loop (instruction_index, instruction) in block.instructions {
                result :: instruction.result ?? next
                ty :: instruction.ty ?? next
                if !jet_driver_pure_fold_scalar(ty) -> next
                if instruction.operation == {
                    .Phi(_) -> {
                        constant :: constants.get(result.value) ?? next
                        &rewrites.push(JetDriverPureFoldJoin{function: function_index, block: block_index, instruction: instruction_index, constant: constant})
                    }
                    else -> {}
                }
            }
        }
    }
    &permit.value.outputs.push(^rewrites)
    1
}

fn jet_driver_pure_fold_scalar(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .Char -> true
        else -> false
    }
}

fn jet_driver_pure_fold_site_key(function: Int, block: Int, instruction: Int) -> String Never! {
    "{function}:{block}:{instruction}"
}

// One scan's result: the program back from the threads and its candidates.
struct JetDriverPureFoldScan {
    program: MIRProgram
    candidates: JetDriverPureFoldCandidates
}

// The threads' inputs for one candidate scan: the program (moved in, moved
// back after the join), the declined sites and the program-wide callee and
// Prelude sets.
struct JetDriverPureFoldShared {
    programs: [MIRProgram]
    declined: [String:Bool]
    callees: [U64:Bool]
    preludes: [U64:Bool]
}

// One thread's consecutive function range and its candidates, in function
// order, with synthetic ids still unassigned (`outputs` holds one row once
// the thread finished).
struct JetDriverPureFoldPart {
    start: Int
    end: Int
    outputs: [JetDriverPureFoldCandidates]
}

// Fewest MIR instructions one scan thread is admitted for.
JET_DRIVER_PURE_FOLD_MIN_INSTRUCTIONS_PER_THREAD :: 50000

// Every function's candidate sites and synthetic functions. The functions
// are scanned in consecutive parts on the threads (each function's
// candidates depend on that function and the program-wide callee and
// Prelude sets only) and the parts are joined in function order, where the
// synthetic ids are assigned in site order from the highest function id, so
// the sites, their synthetics and the ids are those of a one-thread scan.
// The program moves through the shared inputs and comes back unchanged.
fn jet_driver_pure_fold_candidates(program: ^MIRProgram, declined: [String:Bool], threads: CompilerThreads) -> JetDriverPureFoldScan {
    scanned := program
    next_id := U64{0}
    callees := [U64:Bool]{}
    weights := [Int]{}
    total := 0
    loop function in scanned.functions {
        if function.id.value > next_id -> next_id = function.id.value
        if jet_driver_pure_fold_callee(function) {
            _ := &callees.add(function.id.value, true)
        }
        count := 0
        loop block in function.blocks -> count += block.instructions.len()
        &weights.push(count)
        total += count
    }
    preludes := [U64:Bool]{}
    loop record in scanned.prelude_calls {
        if jet_driver_pure_fold_prelude(record) {
            _ := &preludes.add(record.id.value, true)
        }
    }
    workers :: compiler_threads_admit(threads, weights.len(), total, JET_DRIVER_PURE_FOLD_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    bounds :: compiler_threads_partition(weights, workers)
    inputs :: shared JetDriverPureFoldShared{programs: [MIRProgram]{^scanned}, declined: declined, callees: ^callees, preludes: ^preludes}
    parts := [Shared<JetDriverPureFoldPart>]{}
    loop part in 0..<(bounds.len() - 1) -> &parts.push(shared JetDriverPureFoldPart{start: bounds[part], end: bounds[part + 1], outputs: [JetDriverPureFoldCandidates]{}})
    _ := jet_driver_pure_fold_scan_parts(inputs, parts, 0)
    returned := jet_driver_pure_fold_shared_take(inputs)
    sites := [JetDriverPureFoldSite]{}
    synthetics := [MIRFunction]{}
    loop part in parts {
        output := jet_driver_pure_fold_part_take(part)
        compiler_transfer_rows<JetDriverPureFoldSite>(&sites, &output.sites)
        compiler_transfer_rows<MIRFunction>(&synthetics, &output.functions)
    }
    loop index in 0..<sites.len() {
        next_id += 1
        identity :: MIRFunctionID{value: next_id}
        sites[index].synthetic = identity
        synthetics[index].id = identity
        synthetics[index].key = jet_driver_pure_fold_synthetic_key(returned.functions[sites[index].function].key, identity)
    }
    JetDriverPureFoldScan{program: ^returned, candidates: JetDriverPureFoldCandidates{sites: ^sites, functions: ^synthetics}}
}

// The program, back from the shared inputs after the join.
fn jet_driver_pure_fold_shared_take(inputs: Shared<JetDriverPureFoldShared>) -> MIRProgram {
    permit :: inputs.guard_edit()
    &permit.value.programs.pop() ?? panic("the pure-fold scan left the program in its shared inputs")
}

// A part's candidates, after its thread joined.
fn jet_driver_pure_fold_part_take(part: Shared<JetDriverPureFoldPart>) -> JetDriverPureFoldCandidates {
    permit :: part.guard_edit()
    &permit.value.outputs.pop() ?? panic("a pure-fold scan thread left no candidates")
}

// Scans `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts scanned.
fn jet_driver_pure_fold_scan_parts(inputs: Shared<JetDriverPureFoldShared>, parts: [Shared<JetDriverPureFoldPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return jet_driver_pure_fold_scan_part(inputs, parts[from])
    scanned := 0
    task.group pure_fold_scan_threads {
        head :: task jet_driver_pure_fold_scan_part(inputs, parts[from])
        scanned = jet_driver_pure_fold_scan_parts(inputs, parts, from + 1)
        scanned += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    scanned
}

// One thread: the candidates of its function range, in function order. The
// synthetic ids are placeholders until the join assigns them.
fn jet_driver_pure_fold_scan_part(inputs: Shared<JetDriverPureFoldShared>, part: Shared<JetDriverPureFoldPart>) -> Int {
    permit := part.guard_edit()
    reads :: inputs.guard_read()
    sites := [JetDriverPureFoldSite]{}
    synthetics := [MIRFunction]{}
    // The program-wide callee and Prelude sets are copied once per thread;
    // each function replaces only its own rows, so the sets are never
    // copied per function.
    scan := JetDriverPureFoldInputs{
        constants: [U64:MIRConstant]{},
        types: [U64:MIRType]{},
        definitions: [U64:MIROperation]{},
        initializers: [U64:U64]{},
        roots: [U64:U64]{},
        callees: reads.value.callees,
        preludes: reads.value.preludes,
    }
    placeholder :: MIRFunctionID{value: U64{0}}
    loop function_index in permit.value.start..<permit.value.end {
        function :: reads.value.programs[0].functions[function_index]
        initializers :: jet_driver_pure_fold_initializers(function)
        if initializers.len() == 0 -> next
        definitions := [U64:MIROperation]{}
        loop block in function.blocks {
            loop instruction in block.instructions {
                defined :: instruction.result ?? next
                _ := &definitions.add(defined.value, instruction.operation)
            }
        }
        types := [U64:MIRType]{}
        loop fact in function.values {
            _ := &types.add(fact.id.value, fact.ty)
        }
        feeding :: jet_driver_pure_fold_feeding(function, initializers, definitions)
        roots :: jet_driver_pure_fold_root_locals(function)
        scan.constants = jet_driver_pure_fold_constants(function, initializers, roots)
        scan.types = types
        scan.definitions = definitions
        scan.initializers = initializers
        scan.roots = roots
        loop (block_index, block) in function.blocks {
            loop (instruction_index, instruction) in block.instructions {
                result :: instruction.result ?? next
                ty :: instruction.ty ?? next
                if feeding.get(result.value) == None -> next
                if scan.constants.get(result.value) != None -> next
                if !jet_driver_pure_fold_result_type(ty) -> next
                if !jet_driver_pure_fold_operation(instruction.operation, scan.callees, scan.preludes) -> next
                // Only a site that is otherwise a candidate builds its key.
                if reads.value.declined.len() > 0 && reads.value.declined.get(jet_driver_pure_fold_site_key(function_index, block_index, instruction_index)) != None -> next
                slice := JetDriverPureFoldSlice{instructions: [MIRInstruction]{}, defined: [U64:Bool]{}, visiting: [U64:Bool]{}}
                complete := true
                loop value in mir_operation_value_uses(instruction.operation) {
                    if !jet_driver_pure_fold_reproduce(scan, value, instruction, &slice) {
                        complete = false
                        break
                    }
                }
                if !complete -> next
                &slice.instructions.push(instruction)
                &synthetics.push(jet_driver_pure_fold_synthetic(function, placeholder, slice.instructions, result, ty))
                &sites.push(JetDriverPureFoldSite{function: function_index, block: block_index, instruction: instruction_index, synthetic: placeholder, ty: ty})
            }
        }
    }
    &permit.value.outputs.push(JetDriverPureFoldCandidates{sites: ^sites, functions: ^synthetics})
    1
}

// What one function offers a fold: known constants, value types, the
// operation that defines each value, and the one initializer of each
// immutable local.
struct JetDriverPureFoldInputs {
    constants: [U64:MIRConstant]
    types: [U64:MIRType]
    definitions: [U64:MIROperation]
    initializers: [U64:U64]
    roots: [U64:U64]
    callees: [U64:Bool]
    preludes: [U64:Bool]
}

// The instructions a synthetic function runs before the folded one.
struct JetDriverPureFoldSlice {
    instructions: [MIRInstruction]
    defined: [U64:Bool]
    visiting: [U64:Bool]
}

// Append instructions that rebuild `value` without run-time input: a known
// constant, a read of an immutable local rebuilt from its one initializer,
// or effect-free work over values that are themselves rebuilt.
// `Path("/tmp/a").to_string()` and `xs.reduce((a, b) -> a + b)` fold this
// way even though the path and the closure are no literals. Any failure
// abandons the whole candidate, so a value still being visited is a cycle.
fn jet_driver_pure_fold_reproduce(inputs: JetDriverPureFoldInputs, value: MIRValueID, site: MIRInstruction, slice: &JetDriverPureFoldSlice) -> Bool Never! {
    if slice.defined.get(value.value) != None -> return true
    if slice.instructions.len() >= JET_DRIVER_PURE_FOLD_MAX_SLICE -> return false
    if slice.visiting.get(value.value) != None -> return false
    _ := &slice.visiting.add(value.value, true)
    rebuilt := MIROperation?{None}
    if inputs.constants.get(value.value) == .Val(constant) {
        rebuilt = Val(MIROperation.Constant{value: constant})
    } else {
        definition :: inputs.definitions.get(value.value) ?? return false
        rebuilt = jet_driver_pure_fold_rebuild(inputs, definition, site, &slice)
    }
    operation :: rebuilt ?? return false
    _ := &slice.defined.add(value.value, true)
    &slice.instructions.push(MIRInstruction{id: MIROpID{value: U64.MAX - (U64.from_int(slice.instructions.len()) ?? U64{0})}, span: site.span, source_line: site.source_line, result: Val(value), ty: inputs.types.get(value.value), operation: operation})
    true
}

fn jet_driver_pure_fold_rebuild(inputs: JetDriverPureFoldInputs, operation: MIROperation, site: MIRInstruction, slice: &JetDriverPureFoldSlice) -> MIROperation? Never! {
    if operation == {
        .ReadPlace(place) -> return jet_driver_pure_fold_rebuild_read(inputs, place, site, &slice)
        .MovePlace(place) -> return jet_driver_pure_fold_rebuild_read(inputs, place, site, &slice)
        .Closure(function, captures, _) -> {
            if captures.len() != 0 || inputs.callees.get(function.value) == None -> return None
            return Val(operation)
        }
        .Copy(_, _) | .Move(_) | .BuildList(_, _) | .BuildMap(_) | .Tuple(_, _) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Absent | .Field(_, _) | .Range(_, _, _) -> {}
        else -> {
            if !jet_driver_pure_fold_operation(operation, inputs.callees, inputs.preludes) -> return None
        }
    }
    loop used in mir_operation_value_uses(operation) {
        if !jet_driver_pure_fold_reproduce(inputs, used, site, &slice) -> return None
    }
    Val(operation)
}

fn jet_driver_pure_fold_rebuild_read(inputs: JetDriverPureFoldInputs, place: MIRPlaceID, site: MIRInstruction, slice: &JetDriverPureFoldSlice) -> MIROperation? Never! {
    local :: inputs.roots.get(place.value) ?? return None
    initial :: inputs.initializers.get(local) ?? return None
    initial_value :: MIRValueID{value: initial}
    if !jet_driver_pure_fold_reproduce(inputs, initial_value, site, &slice) -> return None
    Val(MIROperation.Copy{value: initial_value, fact: MIRCopyFact.Materialize})
}

// Root places of locals, by place id.
fn jet_driver_pure_fold_root_locals(function: MIRFunction) -> [U64:U64] Never! {
    roots := [U64:U64]{}
    loop place in function.places {
        if place.projections.len() != 0 -> next
        if place.base == {
            .Local(local) -> {
                _ := &roots.add(place.id.value, local.value)
            }
            else -> {}
        }
    }
    roots
}

// Immutable locals written exactly once, at their root, mapped to the value
// that initializes them.
fn jet_driver_pure_fold_initializers(function: MIRFunction) -> [U64:U64] Never! {
    immutable := [U64:Bool]{}
    loop local in function.locals {
        if !local.mutable && !local.uninit {
            _ := &immutable.add(local.id.value, true)
        }
    }
    // place id -> local id, and whether the place is the local's root.
    place_locals := [U64:U64]{}
    root_places := [U64:Bool]{}
    loop place in function.places {
        if place.base == {
            .Local(local) -> {
                if immutable.get(local.value) != None {
                    _ := &place_locals.add(place.id.value, local.value)
                    if place.projections.len() == 0 {
                        _ := &root_places.add(place.id.value, true)
                    }
                }
            }
            else -> {}
        }
    }
    writes := [U64:U64]{}
    write_counts := [U64:Int]{}
    disqualified := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .WritePlace(place, value) -> {
                    local :: place_locals.get(place.value) ?? next
                    if root_places.get(place.value) == None {
                        _ := &disqualified.add(local, true)
                        next
                    }
                    count :: write_counts.get(local) ?? 0
                    if count == 0 {
                        _ := &writes.add(local, value.value)
                        _ := &write_counts.add(local, 1)
                    } else {
                        _ := &disqualified.add(local, true)
                    }
                }
                .ReadPlace(_) -> {}
                .MovePlace(_) -> {}
                else -> {
                    loop place in jet_driver_pure_fold_operation_places(instruction.operation) {
                        local :: place_locals.get(place.value) ?? next
                        _ := &disqualified.add(local, true)
                    }
                }
            }
        }
    }
    initializers := [U64:U64]{}
    loop local in function.locals {
        value :: writes.get(local.id.value) ?? next
        if disqualified.get(local.id.value) != None -> next
        _ := &initializers.add(local.id.value, value)
    }
    initializers
}

// Every place an operation other than a plain read or root write touches.
fn jet_driver_pure_fold_operation_places(operation: MIROperation) -> [MIRPlaceID] Never! {
    if operation == {
        .ReadPlace(place) -> [MIRPlaceID]{place}
        .MovePlace(place) -> [MIRPlaceID]{place}
        .WritePlace(place, _) -> [MIRPlaceID]{place}
        .ReplacePlace(place, _) -> [MIRPlaceID]{place}
        .InitializeUninit(place) -> [MIRPlaceID]{place}
        .RawAddressOf(place) -> [MIRPlaceID]{place}
        .AddressOf(place, _) -> [MIRPlaceID]{place}
        .Closure(_, captures, _) -> {
            places := [MIRPlaceID]{}
            loop capture in captures {
                if capture == .Place(place) -> &places.push(place)
            }
            places
        }
        .Call(_, args, _) -> jet_driver_pure_fold_arg_places(args)
        .CoreCall(_, _, args, _, _, _) -> jet_driver_pure_fold_arg_places(args)
        .IndirectCall(_, args, _) -> jet_driver_pure_fold_arg_places(args)
        .Semantic(semantic) -> jet_driver_pure_fold_semantic_places(semantic)
        else -> [MIRPlaceID]{}
    }
}

fn jet_driver_pure_fold_arg_places(args: [MIRCallArg]) -> [MIRPlaceID] Never! {
    places := [MIRPlaceID]{}
    loop arg in args {
        place :: arg.place ?? next
        &places.push(place)
    }
    places
}

fn jet_driver_pure_fold_semantic_places(operation: MIRSemanticOp) -> [MIRPlaceID] Never! {
    if operation == {
        .BuiltinMethod(_, _, receiver_place, _, _) -> {
            place :: receiver_place ?? return [MIRPlaceID]{}
            [MIRPlaceID]{place}
        }
        .StaticPreludeCall(_, args, _, _) -> jet_driver_pure_fold_arg_places(args)
        .ClosureMethod(_, args, _) -> jet_driver_pure_fold_arg_places(args)
        .HostCall(_, args) -> jet_driver_pure_fold_arg_places(args)
        else -> [MIRPlaceID]{}
    }
}

// Values whose constant is known: literal constants, copies and moves of
// them, lists built from them, reads of an immutable local whose one
// initialization stores a known constant, and joins whose live edges all
// carry one constant.
fn jet_driver_pure_fold_constants(function: MIRFunction, initializers: [U64:U64], roots: [U64:U64]) -> [U64:MIRConstant] Never! {
    constants := [U64:MIRConstant]{}
    local_values := [U64:MIRConstant]{}
    loop {
        before :: constants.len() + local_values.len()
        loop local in function.locals {
            if local_values.get(local.id.value) != None -> next
            value :: initializers.get(local.id.value) ?? next
            constant :: constants.get(value) ?? next
            _ := &local_values.add(local.id.value, constant)
        }
        // A branch on a known condition takes one edge; the other is dead.
        taken := [U64:U64]{}
        loop block in function.blocks {
            if block.terminator == .Branch(condition, then_target, else_target) {
                if constants.get(condition.value) == {
                    .Val(decided) -> {
                        if decided == (MIRConstant.Bool{value: true}) -> _ := &taken.add(block.id.value, then_target.value)
                        if decided == (MIRConstant.Bool{value: false}) -> _ := &taken.add(block.id.value, else_target.value)
                    }
                    .None -> {}
                }
            }
        }
        loop block in function.blocks {
            loop instruction in block.instructions {
                result :: instruction.result ?? next
                if constants.get(result.value) != None -> next
                known := MIRConstant?{None}
                if instruction.operation == {
                    .Constant(constant) -> known = Val(constant)
                    .Copy(value, _) -> known = constants.get(value.value)
                    .Move(value) -> known = constants.get(value.value)
                    .ReadPlace(place) -> {
                        local :: roots.get(place.value) ?? next
                        known = local_values.get(local)
                    }
                    .MovePlace(place) -> {
                        local :: roots.get(place.value) ?? next
                        known = local_values.get(local)
                    }
                    // `[1, 2, 3].len()` folds like the checker's old fold did.
                    .BuildList(values, trait_coercion) -> {
                        if trait_coercion == None -> known = jet_driver_pure_fold_list_constant(values, constants)
                    }
                    .Phi(incoming) -> known = jet_driver_pure_fold_join_constant(block.id, incoming, taken, constants)
                    else -> {}
                }
                constant :: known ?? next
                _ := &constants.add(result.value, constant)
            }
        }
        if constants.len() + local_values.len() == before -> return constants
    }
    constants
}

// The one constant every live edge into a join carries. An edge from a
// branch that provably goes elsewhere is dead.
fn jet_driver_pure_fold_join_constant(join: MIRBlockID, incoming: [MIRPhiIncoming], taken: [U64:U64], constants: [U64:MIRConstant]) -> MIRConstant? Never! {
    joined := MIRConstant?{None}
    loop edge in incoming {
        target :: taken.get(edge.block.value) ?? join.value
        if target != join.value -> next
        constant :: constants.get(edge.value.value) ?? return None
        if joined == {
            .Val(previous) -> if previous != constant -> return None
            .None -> {}
        }
        joined = Val(constant)
    }
    joined
}

fn jet_driver_pure_fold_list_constant(values: [MIRValueID], constants: [U64:MIRConstant]) -> MIRConstant? Never! {
    elements := [MIRConstant]{}
    loop value in values {
        element :: constants.get(value.value) ?? return None
        &elements.push(element)
    }
    Val(MIRConstant.List{values: elements})
}

// Values that flow into the initializer of an immutable local, directly or
// as an operand of other work that does, plus branch conditions, which
// decide the joins such initializers read. Only these are folded: the pass
// replaces the old checker fold of immutable bindings, not every call.
fn jet_driver_pure_fold_feeding(function: MIRFunction, initializers: [U64:U64], definitions: [U64:MIROperation]) -> [U64:Bool] Never! {
    pending := [U64]{}
    loop local in function.locals {
        value :: initializers.get(local.id.value) ?? next
        &pending.push(value)
    }
    loop block in function.blocks {
        if block.terminator == .Branch(condition, _, _) -> &pending.push(condition.value)
    }
    feeding := [U64:Bool]{}
    loop pending.len() > 0 {
        value :: &pending.pop() ?? break
        if feeding.get(value) != None -> next
        _ := &feeding.add(value, true)
        operation :: definitions.get(value) ?? next
        loop used in mir_operation_value_uses(operation) -> &pending.push(used.value)
    }
    feeding
}

fn jet_driver_pure_fold_operation(operation: MIROperation, callees: [U64:Bool], preludes: [U64:Bool]) -> Bool Never! {
    if operation == {
        .Call(callee, args, type_args) -> {
            if type_args.len() != 0 || !jet_driver_pure_fold_value_args(args) -> return false
            if callee == {
                .User(function) -> callees.get(function.value) != None
                .Associated(function, _) -> callees.get(function.value) != None
                .Method(function, _) -> callees.get(function.value) != None
                .Prelude(call) -> preludes.get(call.value) != None
                else -> false
            }
        }
        .CoreCall(_, route, args, _, _, _) -> jet_driver_pure_fold_value_args(args) && preludes.get(route.value) != None
        .Binary(_, dispatch, _, _, _) -> {
            if dispatch == {
                .Primitive -> true
                .Prelude(call, _) -> preludes.get(call.value) != None
            }
        }
        .Unary(_, _) -> true
        .BuildString(_) -> true
        .Semantic(semantic) -> jet_driver_pure_fold_semantic(semantic, preludes)
        // Structural reads of a rebuilt value: the test and payload behind
        // `opt ?? fallback`, `result.ok`, a field or an enum case.
        .OptionIsSome(_) | .OptionValue(_) | .ResultIsOk(_) | .ResultValue(_, _) -> true
        .EnumIs(_, _, _) | .EnumPayload(_, _, _, _) | .Field(_, _) -> true
        else -> false
    }
}

// A semantic operation folds when it touches no place and every Prelude
// route it names is pure. Its closure operands must be reproducible, which
// the candidate's operand check decides.
fn jet_driver_pure_fold_semantic(semantic: MIRSemanticOp, preludes: [U64:Bool]) -> Bool Never! {
    if semantic == {
        .HandleMethod(_, _, _, _, _) -> return false
        else -> {}
    }
    if jet_driver_pure_fold_semantic_places(semantic).len() != 0 -> return false
    calls :: mir_semantic_op_prelude_calls(semantic)
    if calls.len() == 0 -> return false
    loop call in calls {
        if preludes.get(call.value) == None -> return false
    }
    true
}

// An argument passed by value. The folded instruction is copied whole, so
// its representation adaptations run in the synthetic call too; only a
// write place would reach outside it.
fn jet_driver_pure_fold_value_args(args: [MIRCallArg]) -> Bool Never! {
    loop arg in args {
        if arg.place != None -> return false
    }
    true
}

fn jet_driver_pure_fold_callee(function: MIRFunction) -> Bool Never! {
    function.kind == MIRFunctionKind.Jet
        && function.effects.direct.len() == 0
        && function.effects.solved.len() == 0
        && !function.effects.maximal
        && function.failure == MIRFailureCarrier.Infallible
        && function.memo_bound == None
        && !function.memo_unbounded
        && function.generator == None
        && function.capture_params.len() == 0
        && function.generic_params.len() == 0
        && !function.is_reactive
        && function.foreign_language == None
        && function.target_applicability.interpreter
}

// The same purity rule the optimizer's dead-value pass applies to a Prelude
// route: no effect row, no authority, not an Effect-ABI row, and infallible.
fn jet_driver_pure_fold_prelude(record: MIRPreludeCall) -> Bool Never! {
    record.effect_kind == None
        && record.authority == None
        && record.abi != MIRPreludeABI.Effect
        && record.fallibility == MIRCallFallibility.Infallible
}

// Only values every tier already writes as a literal become constants.
fn jet_driver_pure_fold_result_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        .String -> true
        .List(inner) -> jet_driver_pure_fold_result_type(inner)
        else -> false
    }
}

// The key of the synthetic function `identity` folding a site of the host
// with key `host_key`.
fn jet_driver_pure_fold_synthetic_key(host_key: String, identity: MIRFunctionID) -> String Never! {
    "{host_key}::__jet_pure_fold_{identity.value}"
}

// A function that runs `instructions` (the rebuilt inputs, operands first,
// then the folded instruction) and returns `result`.
fn jet_driver_pure_fold_synthetic(host: MIRFunction, identity: MIRFunctionID, instructions: [MIRInstruction], result: MIRValueID, ty: MIRType) -> MIRFunction Never! {
    span := host.span
    defined := [U64:Bool]{}
    loop instruction in instructions {
        span = instruction.span
        value :: instruction.result ?? next
        _ := &defined.add(value.value, true)
    }
    values := [MIRValueFact]{}
    loop fact in host.values {
        if defined.get(fact.id.value) != None -> &values.push(fact)
    }
    MIRFunction{
        id: identity,
        module_id: host.module_id,
        source_file: host.source_file,
        key: jet_driver_pure_fold_synthetic_key(host.key, identity),
        module_name: host.module_name,
        name: host.name,
        span: span,
        kind: MIRFunctionKind.Jet,
        form: MIRFunctionForm.TopLevel,
        visibility: host.visibility,
        target_applicability: host.target_applicability,
        web_bucket: None,
        web_marker: None,
        generic_params: [MIRGenericParam]{},
        capture_params: [MIRCaptureParam]{},
        params: [MIRParam]{},
        declared_return: Val(ty),
        return_type: ty,
        failure: MIRFailureCarrier.Infallible,
        effects: MIREffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [MIRNamedSpan]{}},
        captures: None,
        generator: None,
        optimization: mir_empty_optimization_facts(),
        is_unsafe: host.is_unsafe,
        unsafe_gate: host.unsafe_gate,
        is_pure: true,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        gc_return: false,
        return_view_provenance: None,
        web_param_reconstructions: [MIRWebParamReconstruction]{},
        blocks: [MIRBasicBlock]{MIRBasicBlock{id: host.entry, span: span, instructions: instructions, terminator: MIRTerminator.Return{value: Val(result)}}},
        entry: host.entry,
        locals: [MIRLocal]{},
        values: values,
        places: [MIRPlace]{},
        scopes: [MIRScope]{},
        drops: [MIRDropAction]{},
        foreign_language: None,
    }
}

// The constant one evaluation folds to: its data value lowered to the
// site's literal type, within the output budget.
fn jet_driver_pure_fold_folded(value: TComptimeValue?, ty: MIRType) -> MIRConstant? {
    data :: value ?? return None
    constant :: jet_driver_pure_fold_constant(data, ty) ?? return None
    if jet_driver_pure_fold_cost(constant) > JET_DRIVER_PURE_FOLD_OUTPUT_BUDGET -> return None
    Val(constant)
}

// Rust `folded_constant`: only a `CtValue::Int` (an i64) folds; an exact Int
// outside i64 is the reference's `CtValue::BigInt` and stays a call.
fn jet_driver_pure_fold_constant(value: TComptimeValue, ty: MIRType) -> MIRConstant? {
    if value == .Int(number) {
        if number < -9223372036854775807 - 1 || number > 9223372036854775807 -> return None
    }
    if ty.kind == {
        .Int -> if value == .Int(number) -> return Val(MIRConstant.Int{value: number, width: None, spelling: None})
        .IntN(signed, bits) -> if value == .Int(number) -> return Val(MIRConstant.Int{value: number, width: Val(MIRIntegerWidth{signed: signed, bits: bits}), spelling: None})
        .Float -> if value == .Float(number, _) -> return Val(MIRConstant.Float{value: number, f32: false, spelling: None})
        .Float32 -> if value == .Float(number, _) -> return Val(MIRConstant.Float{value: number, f32: true, spelling: None})
        .Bool -> if value == .Bool(flag) -> return Val(MIRConstant.Bool{value: flag})
        .Char -> if value == .Char(character) -> return Val(MIRConstant.Char{value: character})
        .String -> if value == .String(text) -> return Val(MIRConstant.String{value: text})
        .List(inner) -> {
            if value == .List(items) {
                lowered := [MIRConstant]{}
                loop item in items {
                    element :: jet_driver_pure_fold_constant(item, inner) ?? return None
                    &lowered.push(element)
                }
                return Val(MIRConstant.List{values: lowered})
            }
        }
        else -> {}
    }
    None
}

fn jet_driver_pure_fold_cost(constant: MIRConstant) -> Int Never! {
    if constant == {
        .String(text) -> 16 + text.len()
        .List(values) -> {
            cost := 16 + 8 * values.len()
            loop value in values {
                cost += jet_driver_pure_fold_cost(value)
                if cost > JET_DRIVER_PURE_FOLD_OUTPUT_BUDGET -> return cost
            }
            cost
        }
        else -> 16
    }
}
