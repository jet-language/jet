// One invocation-scoped checked-TIR cost producer for every consumer.
use jet_codegen.[TCostReport, jet_codegen_cost_report]
use jet_sema.[SemaGraphResult]

pub struct JetDriverCostQueryResult {
    pub compile: JetDriverCompileResult
    pub report: TCostReport?
    pub gaps: [String]
}
pub fn jet_driver_cost_query(request: JetDriverCompileRequest) -> JetDriverCostQueryResult {
    selected := request
    selected.mode = JetDriverCompileMode.Doc
    selected.capture_cost_report = true
    compile :: jet_driver_compile_mir(^selected)
    JetDriverCostQueryResult{compile: compile, report: compile.cost_report, gaps: compile.cost_gaps}
}
fn jet_driver_checked_cost_report(checked: SemaGraphResult) -> TCostReport {
    report := TCostReport{}
    loop module in checked.modules {
        // Only canonical user source modules contribute warning sites. Core
        // bodies still participate in sema's callable coverage proof.
        if module.module_identity.starts_with("<corelib>/") -> next
        collected :: jet_codegen_cost_report(module.functions)
        loop site in collected.sites -> &report.sites.push(site)
    }
    report
}
