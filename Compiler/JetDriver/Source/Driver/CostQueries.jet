// One invocation-scoped checked-TIR cost producer for every consumer.
use jet_foundation.[Span, TCostKind, TCostState]

struct TCostSite {
    function: String
    span: Span
    loop_depth: Int
    kind: TCostKind
    state: TCostState
}
struct TCostReport { sites: [TCostSite]{[TCostSite]{}} }

struct JetDriverCostQueryResult {
    compile: JetDriverCompileResult
    report: TCostReport?
    gaps: [String]
}
fn jet_driver_cost_query(request: ^JetDriverCompileRequest) -> JetDriverCostQueryResult {
    selected := ^request
    selected.mode = JetDriverCompileMode.Doc
    selected.capture_cost_report = true
    compile := jet_driver_compile(^selected)
    // Move the report rows out and reset the fields with whole assignments,
    // so `compile` is whole again when it moves below.
    report := ^compile.cost_report
    compile.cost_report = None
    gaps := ^compile.cost_gaps
    compile.cost_gaps = [String]{}
    JetDriverCostQueryResult{compile: ^compile, report: ^report, gaps: ^gaps}
}
