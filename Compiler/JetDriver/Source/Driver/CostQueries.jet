// One invocation-scoped checked cost producer for every consumer: the typed
// cost sites of the program's own functions, read off their checked bodies.
use {
    unicode: core.text
    jet_sema.[SemaGraphModuleResult]
    jet_foundation.[
        BodyPlace,
        BodyTree,
        CopyFact,
        DeclID,
        DeclTable,
        Diagnostic,
        FnBody,
        ModuleID,
        Span,
        StmtKind,
        SymbolID,
        SymbolTable,
        TBinaryOp,
        TCostFact,
        TCostKind,
        TCostState,
        TIndexKind,
        TIntegerBounds,
        Type,
        body_cost_fact,
        body_cost_int_policy_operator,
        body_cost_integer_bounds,
        body_cost_type,
        body_each_expr_child,
        body_each_stmt_child,
        body_node,
        body_stmt,
        body_type,
        checked_builtin_mutates_receiver,
        checked_cost_combine_bounds,
        checked_cost_int_fact,
        decl_table_find,
        decl_table_find_symbol,
        module_is_core,
        sema_casing_is_alphanumeric,
        type_name,
    ]
}

TCostSite: struct {
    function: String,
    module_identity: ModuleID,
    span: Span,
    loop_depth: Int,
    kind: TCostKind,
    state: TCostState,
    // The type a ViewMaterialization or an ImplicitCopy copies; empty for
    // every other kind.
    view: String,
    // Whether a loop that repeats this CollectionCopyOnWrite edit also shares
    // the edited map each turn (jet_driver_cost_shared_edits); false for
    // every other kind.
    shared: Bool{false},
    // Whether the cost is the own work of a call the source writes
    // (TCostFact.written); such a site is no hidden copy.
    written: Bool{false},
    // Whether this ExactIntSpill site is an Int product or left shift a loop
    // grows geometrically, with no cap in its condition
    // (jet_driver_cost_growth); false for every other kind.
    grows: Bool{false},
    // The source file the site is in and the 1-based line it starts on
    // (jet_driver_cost_place); empty and 0 until the site is placed.
    path: String{""},
    line: Int{0},
}

// The functions a projection covered (each generic one by the
// specialization's name, JetDriverCostCovered), in cover order, and their
// sites.
TCostReport: struct {
    functions: [String]{[String]{}},
    sites: [TCostSite]{[TCostSite]{}},
}

// What a cost projection knows of each declaration, by DeclID row: the
// position of its checked body among the projected functions, and whether it
// is foreign (its body lives outside Jet).
JetDriverCostCallees: struct {
    bodies: [Int?],
    foreign: [Bool],
}

// The functions a cost projection covers, and the declarations it reaches
// but cannot see into: a direct call to a declaration with neither a checked
// body nor a foreign row.
JetDriverCostCover: struct {
    covered: [JetDriverCostCovered],
    gaps: [JetDriverCostGap],
}

// A declaration the projection reaches but cannot see into, at the first
// call that reaches it: the calling function's position and the call's span.
JetDriverCostGap: struct {
    callee: DeclID,
    caller: Int,
    span: Span,
}

// A function the projection covers: its position among the projected
// functions and the name its sites carry, a generic function's being that
// of the specialization reached.
JetDriverCostCovered: struct {
    position: Int,
    name: String,
}

// The callee facts of `functions` (each body by its key) and of the foreign
// rows of `modules`, over the rows of `decls`.
jet_driver_cost_callees: fn(functions: [FnBody], modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable) -> JetDriverCostCallees Never! {
    callees := JetDriverCostCallees{bodies: [Int?]{}, foreign: [Bool]{}}
    loop _ in 0..<decls.rows.len() {
        callees.bodies.push(None)
        callees.foreign.push(false)
    }
    loop position in 0..<functions.len() {
        if decl_table_find(decls, symbols, functions[position].key) == .Val(id) {
            callees.bodies[id.row.index()] = Val(position)
        }
    }
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if decl_table_find(decls, symbols, row.key) == .Val(id) {
                callees.foreign[id.row.index()] = true
            }
            if decl_table_find_symbol(decls, row.symbol_id) == .Val(id) {
                callees.foreign[id.row.index()] = true
            }
        }
    }
    callees
}

// Whether the projection reports `function`'s sites: a function the program
// wrote, not Core's, a compiler-made one or a stand-in.
jet_driver_cost_reports: fn(function: FnBody) -> Bool Never! {
    !function.synthetic && !function.stand_in && !module_is_core(function.module_identity)
}

// What a projection of `functions` covers. It covers each non-generic
// function the program wrote, then, transitively, each specialization of a
// generic function of the program that a covered body calls, named
// `name__generic__<type arguments>`. A direct call from a covered body to a
// declaration with no checked body that is not foreign is a gap.
jet_driver_cost_cover: fn(functions: [FnBody], callees: JetDriverCostCallees) -> JetDriverCostCover Never! {
    cover := JetDriverCostCover{covered: [JetDriverCostCovered]{}, gaps: [JetDriverCostGap]{}}
    loop position in 0..<functions.len() {
        if jet_driver_cost_reports(functions[position]) && functions[position].generic_params.len() == 0 {
            cover.covered.push(JetDriverCostCovered{position: position, name: functions[position].name})
        }
    }
    specializations := [String:Bool]{}
    gap_rows := [Int:Bool]{}
    cursor := 0
    loop cursor < cover.covered.len() {
        position: cover.covered[cursor].position
        cursor += 1
        tree: functions[position].tree
        loop id in jet_driver_cost_nodes(functions[position]) {
            node: body_node(tree, id)
            if node.kind == .Call(callee, type_args, _) {
                row: callee.row.index()
                if callees.bodies[row] == .Val(target) {
                    if jet_driver_cost_reports(functions[target]) && functions[target].generic_params.len() > 0 {
                        specialization: "{functions[target].name}__generic__{jet_driver_cost_type_suffix(type_args)}"
                        if specializations.get("{target}/{specialization}") == None {
                            specializations["{target}/{specialization}"] = true
                            cover.covered.push(JetDriverCostCovered{position: target, name: specialization})
                        }
                    }
                } else if !callees.foreign[row] && gap_rows.get(row) == None {
                    gap_rows[row] = true
                    cover.gaps.push(JetDriverCostGap{callee: callee, caller: position, span: node.span})
                }
            }
        }
    }
    cover
}

// The E2104 refusal of a projection gap: `caller` calls `callee`, whose body
// the typed cost projection can't read, at `span`.
jet_driver_cost_gap_diagnostic: fn(load: JetDriverLoadResult, caller: FnBody, callee: String, span: Span) -> Diagnostic {
    jet_driver_diagnostic_at_loaded_site(load, caller.module_identity, "E2104", span, "`{caller.name}` calls `{callee}`, which has no checked body, so the typed cost projection is incomplete", "every function a checked body reaches has a checked body or a foreign row, and the typed cost report reads them", "report this as a compiler defect: checking lost the body of `{callee}`")
}

// The cost report of the `covered` functions of `functions`: each one's name
// and sites, in cover order, its stop polls (jet_driver_cost_stop_polls)
// after its other sites. `callees` are the callee facts the cover read.
jet_driver_cost_report: fn(functions: [FnBody], covered: [JetDriverCostCovered], callees: JetDriverCostCallees) -> TCostReport Never! {
    report := TCostReport{}
    nodes: loop row in covered -> jet_driver_cost_nodes(functions[row.position])
    // Each function's direct callers among the covered, by position.
    callers := [Int:[Int]]{}
    loop (at, row) in covered {
        loop id in nodes[at] {
            node: body_node(functions[row.position].tree, id)
            if node.kind == .Call(callee, _, _) {
                if callees.bodies[callee.row.index()] == .Val(target) {
                    if callers.get(target) == None -> callers[target] = [Int]{}
                    callers[target].push(row.position)
                }
            }
        }
    }
    loop (at, row) in covered {
        depths: jet_driver_cost_loop_depths(functions[row.position].tree)
        report.functions.push(row.name)
        jet_driver_cost_function_sites(functions[row.position], row.name, nodes[at], depths, report.sites)
        jet_driver_cost_stop_polls(functions[row.position], row.position, row.name, nodes[at], depths, callees, callers, report.sites)
    }
    report
}

// Pushes onto `sites` the stop polls the compiler emits into `function`
// (JetIR Build.jet), at `position` among the projected functions and
// reported as `name`, each a semantic remainder: the turn poll each
// iteration of a loop starts with (ir_loop_check), at the loop, at the depth
// of its body; and, at each direct call of a function on a cycle of calls
// back to this one, itself included, the turn poll that callee's entry
// keeps (ir_entry_check, ir_recursion_checks), at the call's depth.
// `callers` holds each covered function's direct callers, by position.
jet_driver_cost_stop_polls: fn(function: FnBody, position: Int, name: String, nodes: [Int], depths: [Int:Int], callees: JetDriverCostCallees, callers: [Int:[Int]], sites: &[TCostSite]) Never! {
    tree: function.tree
    loop statement in tree.stmts {
        span: jet_driver_cost_loop_span(statement) ?? next
        iterated := [Int]{}
        jet_driver_cost_iterated(tree, statement, iterated)
        // The loop's body is at the least depth of what it runs.
        depth := 0
        loop id in iterated {
            at: depths.get(id) ?? 1
            if depth == 0 || at < depth -> depth = at
        }
        if depth == 0 -> depth = 1
        sites.push(TCostSite{function: name, module_identity: function.module_identity, span: span, loop_depth: depth, kind: TCostKind.StopPoll, state: TCostState.SemanticRemainder, view: ""})
    }
    // The functions that reach this one through direct calls.
    reaching := [Int:Bool]{}
    pending := [Int]{position}
    loop pending.len() > 0 {
        at: pending.pop() ?? break
        if callers.get(at) == .Val(direct) {
            loop caller in direct {
                if reaching.get(caller) != None -> next
                reaching[caller] = true
                pending.push(caller)
            }
        }
    }
    if reaching.len() == 0 {
        return
    }
    loop id in nodes {
        node: body_node(tree, id)
        if node.kind == .Call(callee, _, _) {
            if callees.bodies[callee.row.index()] == .Val(target) {
                if reaching.get(target) != None {
                    sites.push(TCostSite{function: name, module_identity: function.module_identity, span: node.span, loop_depth: depths.get(id) ?? 0, kind: TCostKind.StopPoll, state: TCostState.SemanticRemainder, view: ""})
                }
            }
        }
    }
}

// The span of a loop statement, None for any other.
jet_driver_cost_loop_span: fn(statement: StmtKind) -> Span? Never! {
    if statement == .Loop(_, _, span) -> return Val(span)
    if statement == .While(_, _, _, span) -> return Val(span)
    if statement == .CountedLoop(_, _, _, _, _, _, span) -> return Val(span)
    if statement == .ForRange(_, _, _, _, _, _, _, _, span) -> return Val(span)
    if statement == .Range(_, _, _, _, _, _, _, _, _, span) -> return Val(span)
    if statement == .ForIn(_, _, _, _, _, _, _, _, _, _, _, span) -> return Val(span)
    None
}

// Each site of `report` placed in its source file: the file's path and the
// line its span starts on.
jet_driver_cost_place: fn(load: JetDriverLoadResult, report: &TCostReport) {
    lines := JetDriverForeignLines{}
    loop index in 0..<report.sites.len() {
        location: jet_driver_source_location_for_load_module(load, report.sites[index].module_identity, report.sites[index].span) ?? next
        offset: report.sites[index].span.start - location.aggregate_start + location.source_start
        report.sites[index].line = jet_driver_foreign_line(lines, load.source_files, location.source_path, offset)
        report.sites[index].path = location.source_path
    }
}

// The L2510 lints of `report`: one per distinct site a loop repeats whose
// cost remains in the emitted code, but a stop poll, which a loop keeps so a
// stop can reach it.
jet_driver_cost_lints: fn(load: JetDriverLoadResult, report: TCostReport) -> [Diagnostic] {
    lints := [Diagnostic]{}
    seen := [String:Bool]{}
    loop site in report.sites {
        if site.loop_depth == 0 || site.state != TCostState.SemanticRemainder || site.kind == TCostKind.StopPoll {
            next
        }
        operation: jet_driver_cost_operation(site)
        key: "{site.module_identity:Debug} {site.span.start} {site.span.end} {operation}"
        if seen.get(key) != None -> next
        seen[key] = true
        lints.push(jet_driver_diagnostic_at_loaded_site(load, site.module_identity, "L2510", site.span, "{operation} inside a loop", "A repeated copy or representation fallback can make a growing value's cost super-linear.", "To keep the loop's cost linear, {jet_driver_cost_fix(site.kind)}."))
    }
    lints
}

// The L2511 tidy errors of `functions`: one per distinct site
// (jet_driver_cost_tidy) that a loop of a function the program wrote
// repeats. A plain check and a program compile (`jet build`) list them
// without keeping a cost report, and a function without a loop is not walked.
jet_driver_cost_copy_lints: fn(load: JetDriverLoadResult, functions: [FnBody]) -> [Diagnostic] {
    sites := [TCostSite]{}
    loop function in functions {
        if !jet_driver_cost_reports(function) -> next
        depths: jet_driver_cost_loop_depths(function.tree)
        if depths.len() == 0 -> next
        jet_driver_cost_function_sites(function, function.name, jet_driver_cost_nodes(function), depths, sites)
    }
    lints := [Diagnostic]{}
    seen := [String:Bool]{}
    loop site in sites {
        if site.loop_depth == 0 || site.state != TCostState.SemanticRemainder || !jet_driver_cost_tidy(site) {
            next
        }
        operation: jet_driver_cost_operation(site)
        key: "{site.module_identity:Debug} {site.span.start} {site.span.end} {operation}"
        if seen.get(key) != None -> next
        seen[key] = true
        lints.push(jet_driver_diagnostic_at_loaded_site(load, site.module_identity, "L2511", site.span, "{operation} inside a loop", jet_driver_cost_tidy_why(site.kind), jet_driver_cost_tidy_fix(site.kind)))
    }
    lints
}

// The cost sites L2511 lists: a copy sema made that the source doesn't
// write (a view made owned or an implicit copy); a map edit whose loop
// shares the map each turn, so the edit clones it each turn (an edit of a
// map the loop doesn't share clones it at most once); and an Int product or
// left shift a loop grows geometrically with no cap, which leaves the packed
// Int rail within a few dozen turns. A sum never counts: it reaches the
// rail's end only after about 2^63 / step turns. A copy that is the own work
// of a call the source writes (`text.lines()`) is shown, so it is no hidden
// copy; L2510 still lists it.
jet_driver_cost_tidy: fn(site: TCostSite) -> Bool Never! {
    if site.kind == TCostKind.ExactIntSpill -> return site.grows
    !site.written && (site.kind == TCostKind.ViewMaterialization || site.kind == TCostKind.ImplicitCopy || (site.kind == TCostKind.CollectionCopyOnWrite && site.shared))
}

// Why an L2511 site of `kind` costs the loop.
jet_driver_cost_tidy_why: fn(kind: TCostKind) -> String Never! {
    if kind == TCostKind.ExactIntSpill {
        return "The loop multiplies or shifts this Int on every turn and nothing caps it, so it outgrows the packed Int rail and goes on as a bigint."
    }
    "The loop pays for this copy on every turn and the source doesn't show it, so the loop's cost grows with the copied value's size."
}

// How to take an L2511 site of `kind` out of the loop.
jet_driver_cost_tidy_fix: fn(kind: TCostKind) -> String Never! {
    if kind == TCostKind.ExactIntSpill {
        return "To keep the Int on the packed rail, give it a range type such as `Int(0..1000)` or a fixed width such as `I64`, or cap it in the loop's condition."
    }
    "To keep the copy out of the loop, {jet_driver_cost_fix(kind)}."
}

// What a cost kind is, as `explain --cost` names it.
jet_driver_cost_kind_label: fn(kind: TCostKind) -> String Never! {
    if kind == {
        .ViewMaterialization -> "view materialization"
        .ImplicitCopy -> "implicit copy"
        .CollectionCopyOnWrite -> "map copy-on-write"
        .ExactIntSpill -> "exact Int spill"
        .OutcomeConstruction -> "outcome construction"
        .RepresentationFallback -> "generic representation fallback"
        .StopPoll -> "stop poll"
    }
}

// Whether a site's cost remains, as `explain --cost` names it.
jet_driver_cost_state_label: fn(state: TCostState) -> String Never! {
    if state == {
        .SemanticRemainder -> "semantic remainder"
        .OptimizerRemoved -> "optimizer-proven removed"
    }
}

// The operation a site repeats, as the L2510 lint names it.
jet_driver_cost_operation: fn(site: TCostSite) -> String Never! {
    if site.kind == {
        .ViewMaterialization -> "This copy of `{site.view}` view into an owned slot"
        .ImplicitCopy -> "Implicitly copying a `{site.view}`"
        .CollectionCopyOnWrite -> "Editing a shared map backing store"
        .ExactIntSpill -> "An exact Int operation may spill to bigint"
        .OutcomeConstruction -> "Constructing an Outcome carrier"
        .RepresentationFallback -> "Using a generic collection representation"
        .StopPoll -> "A stop poll"
    }
}

// How to take a cost kind's work out of a loop, the L2510 lint's fix.
jet_driver_cost_fix: fn(kind: TCostKind) -> String Never! {
    if kind == {
        .ViewMaterialization -> "keep the value in its view form, or make the copy explicit outside the loop"
        .ImplicitCopy -> "hand the value over with `.move()` at its last use, or make the copy explicit outside the loop"
        .CollectionCopyOnWrite -> "mutate an exclusive map place, or move the edit outside the loop"
        .ExactIntSpill -> "bound the operands so the result stays on the packed Int rail, or accept the exact bigint cost"
        .OutcomeConstruction -> "consume the outcome through an immediate fast path when one exists"
        .RepresentationFallback -> "provide the collection shape proof that selects the direct representation"
        .StopPoll -> "keep it: the poll is where a cancel, a passed deadline or a pause reaches the loop"
    }
}

// Every expression of `function`'s body, statement blocks entered, in
// pre-order.
jet_driver_cost_nodes: fn(function: FnBody) -> [Int] Never! {
    nodes := [Int]{}
    loop statement in function.body {
        jet_driver_cost_reach_statement(function.tree, statement, nodes)
    }
    nodes
}

// The suffix a specialization at `type_args` carries: each type's name with
// every character but letters and digits spelled `_`, joined by `__`.
jet_driver_cost_type_suffix: fn(type_args: [Type]) -> String Never! {
    parts := [String]{}
    loop argument in type_args {
        part := ""
        loop scalar in unicode.scalars(type_name(argument)) {
            part = if sema_casing_is_alphanumeric(scalar) -> "{part}{scalar}" else -> "{part}_"
        }
        parts.push(part)
    }
    parts.join("__")
}

// Pushes `expression` and every expression below it, statement blocks
// entered, in pre-order onto `found`.
jet_driver_cost_reach: fn(tree: BodyTree, expression: Int, found: &[Int]) Never! {
    found.push(expression)
    body_each_expr_child(tree, body_node(tree, expression), fn(child: Int) { jet_driver_cost_reach(tree, child, found) })
}

// Pushes every expression of statement `statement` of `tree` in pre-order
// onto `found`.
jet_driver_cost_reach_statement: fn(tree: BodyTree, statement: Int, found: &[Int]) Never! {
    body_each_stmt_child(tree, body_stmt(tree, statement), fn(child: Int) { jet_driver_cost_reach(tree, child, found) })
}

// Pushes onto `found` every expression a loop statement runs once per
// iteration: its body, a `while`'s condition, a counted loop's condition and
// step. A statement that is no loop pushes none.
jet_driver_cost_iterated: fn(tree: BodyTree, statement: StmtKind, found: &[Int]) Never! {
    if statement == .Loop(_, body, _) {
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    } else if statement == .While(_, condition, body, _) {
        jet_driver_cost_reach(tree, condition, found)
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    } else if statement == .CountedLoop(_, _, condition, step, _, body, _) {
        jet_driver_cost_reach(tree, condition, found)
        if step == .Val(row) -> jet_driver_cost_reach_statement(tree, row, found)
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    } else if statement == .ForRange(_, _, _, _, _, _, body, _, _) {
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    } else if statement == .Range(_, _, _, _, _, _, _, _, body, _) {
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    } else if statement == .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) {
        loop row in body -> jet_driver_cost_reach_statement(tree, row, found)
    }
}

// The loop depth of each expression of `tree`, by node id: how many loops
// run it once per iteration. An expression no loop repeats is absent.
jet_driver_cost_loop_depths: fn(tree: BodyTree) -> [Int:Int] Never! {
    depths := [Int:Int]{}
    loop statement in tree.stmts {
        iterated := [Int]{}
        jet_driver_cost_iterated(tree, statement, iterated)
        loop id in iterated -> depths[id] = (depths.get(id) ?? 0) + 1
    }
    depths
}

// Marks in `consumed` the expressions of `tree` whose Option or Result the
// enclosing code takes apart on the spot (a discarded value, a binding or
// match subject, an `if let` subject, the operand of `?`, `?.`, `is`, a
// lifted call or a drop), so no carrier outlives the expression; and in
// `removed` each `??` operand, whose carrier the fallback's fast path
// removes.
jet_driver_cost_consumed: fn(tree: BodyTree, consumed: &[Int:Bool], removed: &[Int:Bool]) Never! {
    loop statement in tree.stmts {
        if statement == .ExprStmt(value, _) -> consumed[value] = true else if statement == .RefutableBind(_, init, _, _) {
            consumed[init] = true
        } else if statement == .Match(subject, _, _, _) { consumed[subject] = true } else if statement == .EnumMatch(scrutinee, _, _, _, _) {
            consumed[scrutinee] = true
        } else if statement == .If(condition, _, _, _, _) {
            if condition == .IfLet(_, subject) -> consumed[subject] = true
        }
    }
    loop node in tree.nodes {
        if node.kind == .Try(value, _, _) -> consumed[value] = true else if node.kind == .TryWithContext(inner, _, _, _, _, _) {
            consumed[inner] = true
        } else if node.kind == .OrFallback(value, _, _) { removed[value] = true } else if node.kind == .OptField(base, _, _) {
            consumed[base] = true
        } else if node.kind == .OptMethodCall(base, _, _, _) { consumed[base] = true } else if node.kind == .PatternMatches(subject, _) {
            consumed[subject] = true
        } else if node.kind == .DecodeUnder(_, inner) { consumed[inner] = true } else if node.kind == .OptionLift2(_, left, right) {
            consumed[left] = true
            consumed[right] = true
        } else if node.kind == .Drop(value) { consumed[value] = true } else if node.kind == .IfExpr(condition, _, _, _, _) {
            if condition == .IfLet(_, subject) -> consumed[subject] = true
        }
    }
}

// Pushes onto `sites` the cost sites of `function`, reported as `name`:
// those of its expressions `nodes`, in order, then those of its assignments,
// each at its loop depth in `depths` (jet_driver_cost_loop_depths).
// An Outcome a `??` takes apart is optimizer-removed; one the enclosing code
// consumes otherwise is no site.
jet_driver_cost_function_sites: fn(function: FnBody, name: String, nodes: [Int], depths: [Int:Int], sites: &[TCostSite]) Never! {
    tree: function.tree
    consumed := [Int:Bool]{}
    removed := [Int:Bool]{}
    jet_driver_cost_consumed(tree, consumed, removed)
    shared: jet_driver_cost_shared_edits(tree)
    grown_nodes := [Int:Bool]{}
    grown_updates := [Int:Bool]{}
    jet_driver_cost_growth(tree, grown_nodes, grown_updates)
    loop id in nodes {
        node: body_node(tree, id)
        fact: body_cost_fact(tree, node) ?? jet_driver_cost_grown_shift(grown_nodes, id) ?? next
        state := fact.state
        if fact.kind == TCostKind.OutcomeConstruction {
            if removed.get(id) != None -> state = TCostState.OptimizerRemoved else if consumed.get(id) != None {
                next
            }
        }
        span := node.span
        if node.kind == .CoreCall(_, _, source_span, _, _, _) -> span = source_span
        view := ""
        if node.kind == .MaterializeView(value) -> view = type_name(body_type(tree, value)) else if node.kind == .Clone(value, _) {
            view = type_name(body_type(tree, value))
        } else if node.kind == .BuiltinMethod(receiver, _, _) && fact.kind == TCostKind.ViewMaterialization {
            view = type_name(body_type(tree, receiver))
        }
        sites.push(TCostSite{function: name, module_identity: function.module_identity, span: span, loop_depth: depths.get(id) ?? 0, kind: fact.kind, state: state, view: view, shared: shared.get(id) != None, written: fact.written, grows: fact.kind == TCostKind.ExactIntSpill && grown_nodes.get(id) != None})
    }
    loop statement in tree.stmts {
        if statement == .Assign(place, op, value, _, span) {
            fact: jet_driver_cost_assign_fact(tree, place, op, value) ?? jet_driver_cost_grown_shift(grown_updates, value) ?? next
            edited := false
            if place == .Expr(expression) -> edited = shared.get(expression) != None
            sites.push(TCostSite{function: name, module_identity: function.module_identity, span: span, loop_depth: depths.get(value) ?? 0, kind: fact.kind, state: fact.state, view: "", shared: edited, grows: fact.kind == TCostKind.ExactIntSpill && grown_updates.get(value) != None})
        }
    }
}

// The spill site of a left shift a loop grows (jet_driver_cost_growth),
// which body_cost_fact files none for; None for any node it doesn't mark.
jet_driver_cost_grown_shift: fn(grown: [Int:Bool], id: Int) -> TCostFact? Never! {
    if grown.get(id) == None -> return None
    Val(TCostFact{kind: TCostKind.ExactIntSpill, state: TCostState.SemanticRemainder})
}

// Marks the Int updates of `tree` a loop repeats and grows geometrically:
// in `nodes` by its operation's node id, a `target = target op step` (or
// `step * target`, a product's target maybe mixed first as in `(target ~
// byte) * step`), the operation written or under `wrapping` or
// `saturating`, which on an Int is the operation itself; in `updates` by
// its value's node id, a `target op= step`. A product grows unless its
// factor stays within -1..1, and a left shift unless it shifts by nothing.
// A sum or difference never counts: reaching the rail's end by a step
// takes about 2^63 / step turns.
// Only a target that carries its value from one turn into the next grows:
// a local the loop doesn't bind afresh each turn, or a place reached the
// same way on every turn (jet_driver_cost_turn_path), so `xs[i] *= k` under
// `loop i in …` scales each element once. An update whose innermost loop's
// condition compares the target against any Int (jet_driver_cost_caps)
// stops below twice that Int, so it spills only if that Int already sits
// near the rail's end.
jet_driver_cost_growth: fn(tree: BodyTree, nodes: &[Int:Bool], updates: &[Int:Bool]) Never! {
    sizes := [Int:Int]{}
    conditions := [Int:Int]{}
    owners := [Int:Int]{}
    turns := [[Int:Bool]]{}
    binds := JetDriverCostBinds{lets: [String:Int]{}, assigned: [String:[Int]]{}}
    loop statement in tree.stmts {
        if statement == .Let(local, _, init, _, _, _) && local.symbol_id == .Val(symbol) {
            binds.lets["{symbol:Debug}"] = init
        }
        if statement == .Assign(place, _, value, _, _) && place == .Local(local) && local.symbol_id == .Val(symbol) {
            key: "{symbol:Debug}"
            values := binds.assigned.remove(key) ?? [Int]{}
            values.push(value)
            binds.assigned[key] = values
        }
        iterated := [Int]{}
        jet_driver_cost_iterated(tree, statement, iterated)
        if iterated.len() == 0 -> next
        condition := Int?{None}
        if statement == .While(_, held, _, _) -> condition = Val(held)
        if statement == .CountedLoop(_, _, counted, _, _, _, _) -> condition = Val(counted)
        turn := [Int:Bool]{}
        loop id in iterated -> turn[id] = true
        loop id in iterated {
            if sizes.get(id) == .Val(size) && size <= iterated.len() -> next
            sizes[id] = iterated.len()
            owners[id] = turns.len()
            _ := conditions.remove(id)
            if condition == .Val(found) -> conditions[id] = found
        }
        turns.push(turn)
    }
    loop statement in tree.stmts {
        if statement == .Assign(place, op, value, _, _) {
            owner: owners.get(value) ?? next
            if !jet_driver_cost_int_place(tree, place) -> next
            turn: turns[owner]
            if !jet_driver_cost_carried(tree, place, turn, binds) -> next
            if conditions.get(value) == .Val(capped) && jet_driver_cost_caps(tree, capped, place, turn, binds) {
                next
            }
            if op == .Val(operator) {
                if jet_driver_cost_step_grows(tree, operator, value) -> updates[value] = true
                next
            }
            operation: body_node(tree, value).kind
            if operation == .Binary(operator, _, _, left, right) {
                if jet_driver_cost_operation_grows(tree, place, operator, left, right, turn, binds) {
                    nodes[value] = true
                }
            } else if operation == .OverflowOpt(prefix, name, _, left, right) && body_cost_int_policy_operator(prefix, name) == .Val(operator) {
                if jet_driver_cost_operation_grows(tree, place, operator, left, right, turn, binds) {
                    nodes[value] = true
                }
            }
        }
    }
}

// Whether the Int update `place = left operator right` of `tree` grows
// geometrically (jet_driver_cost_growth): one operand carries the place,
// the left one or either of a product, and the other is a step that grows
// it. A product's operand may carry it mixed first
// (jet_driver_cost_carries_place); a shift's must read it as it is, so a
// canonical Huffman code's `code = (code + count) << 1`, which its bit-length
// loop bounds, is no spill site.
jet_driver_cost_operation_grows: fn(tree: BodyTree, place: BodyPlace, operator: TBinaryOp, left: Int, right: Int, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    product: operator == TBinaryOp.Mul
    step := Int?{None}
    if jet_driver_cost_carries_place(tree, place, left, product, turn, binds) -> step = Val(right)
    if step == None && product && jet_driver_cost_carries_place(tree, place, right, true, turn, binds) {
        step = Val(left)
    }
    if step == .Val(by) -> return jet_driver_cost_step_grows(tree, operator, by)
    false
}

// Whether operand `id` of a growing update of `tree` carries the place
// `place` at its size: a read of the place, or with `mixed` one mixed by
// `+`, `-`, `~` or `|` with anything, as FNV's `(h ~ byte) * PRIME` mixes a
// byte in before the product.
jet_driver_cost_carries_place: fn(tree: BodyTree, place: BodyPlace, id: Int, mixed: Bool, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    if jet_driver_cost_updates_place(tree, place, id, turn, binds) -> return true
    if mixed && body_node(tree, id).kind == .Binary(op, _, _, left, right) && (op == TBinaryOp.Add || op == TBinaryOp.Sub || op == TBinaryOp.BitXor || op == TBinaryOp.BitOr) {
        return jet_driver_cost_carries_place(tree, place, left, true, turn, binds) || jet_driver_cost_carries_place(tree, place, right, true, turn, binds)
    }
    false
}

// The locals of a body the growth rule asks about (jet_driver_cost_growth),
// by their symbol's spelling: the initializer node of the `let` that binds
// each, and the value node of each assignment that stores it.
JetDriverCostBinds: struct {
    lets: [String:Int],
    assigned: [String:[Int]],
}

// Whether assignment place `place` of `tree` carries its value from one
// turn of the loop whose expressions are `turn` into the next: a local no
// `let` inside the loop binds, or a place jet_driver_cost_turn_path names.
jet_driver_cost_carried: fn(tree: BodyTree, place: BodyPlace, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    if place == .Local(local) -> return jet_driver_cost_outlives_turn(local.symbol_id, turn, binds)
    if place == .Expr(expression) {
        return jet_driver_cost_turn_path(tree, expression, turn, binds) != None
    }
    false
}

// Whether the local with symbol `symbol` outlives each turn of the loop
// whose expressions are `turn`: no `let` inside the loop binds it.
jet_driver_cost_outlives_turn: fn(symbol: SymbolID?, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    known: symbol ?? return false
    if binds.lets.get("{known:Debug}") == .Val(init) -> return turn.get(init) == None
    true
}

// The place node `id` of `tree` names when it is the same place on every
// turn of the loop whose expressions are `turn`, spelled as
// jet_driver_cost_place_path spells it with each index's value: its local
// outlives the turn, and each index is an Int literal, a constant, or a
// local a `let` before the loop binds and the loop never assigns. None for
// any other node, and for a place whose index changes with the turn
// (`xs[i]` under `loop i in …`).
jet_driver_cost_turn_path: fn(tree: BodyTree, id: Int, turn: [Int:Bool], binds: JetDriverCostBinds) -> String? Never! {
    node: body_node(tree, id)
    if node.kind == .Local(local) {
        if !jet_driver_cost_outlives_turn(local.symbol_id, turn, binds) -> return None
        return jet_driver_cost_place_path(tree, id)
    }
    if node.kind == .Field(receiver, field) {
        base: jet_driver_cost_turn_path(tree, receiver, turn, binds) ?? return None
        return Val("{base}.{field.name}")
    }
    if node.kind == .Index(base, index, _, _, _, _) {
        root: jet_driver_cost_turn_path(tree, base, turn, binds) ?? return None
        key: jet_driver_cost_turn_key(tree, index, turn, binds) ?? return None
        return Val("{root}[{key}]")
    }
    None
}

// The spelling of index node `id` of `tree` when it holds one value on
// every turn of the loop whose expressions are `turn`
// (jet_driver_cost_turn_path); None for any other index.
jet_driver_cost_turn_key: fn(tree: BodyTree, id: Int, turn: [Int:Bool], binds: JetDriverCostBinds) -> String? Never! {
    node: body_node(tree, id)
    if node.kind == .IntLit(value, _) -> return Val("{value}")
    if node.kind == .ConstRef(symbol) -> return Val("{symbol:Debug}")
    if node.kind == .Local(local) && local.symbol_id == .Val(symbol) {
        key: "{symbol:Debug}"
        init: binds.lets.get(key) ?? return None
        if turn.get(init) != None -> return None
        stores: binds.assigned.get(key) ?? [Int]{}
        loop value in stores {
            if turn.get(value) != None -> return None
        }
        return Val(key)
    }
    None
}

// Whether assignment place `place` of `tree` stores an exact Int.
jet_driver_cost_int_place: fn(tree: BodyTree, place: BodyPlace) -> Bool Never! {
    if place == .Local(local) -> return local.ty == Type.Int
    if place == .Expr(expression) && body_cost_type(tree, expression) == .Val(stored) {
        return stored == Type.Int
    }
    false
}

// Whether loop condition `condition` of `tree` caps the place `place` by
// comparing it, or it plus, less, times or shifted by some Int, against any
// Int: `place < cap`, `place * 2 <= cap`, `cap > place` or `cap >= place`,
// alone or as one side of `&&`.
jet_driver_cost_caps: fn(tree: BodyTree, condition: Int, place: BodyPlace, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    if body_node(tree, condition).kind == .Binary(op, _, _, left, right) {
        if op == TBinaryOp.And {
            return jet_driver_cost_caps(tree, left, place, turn, binds) || jet_driver_cost_caps(tree, right, place, turn, binds)
        }
        if op == TBinaryOp.Lt || op == TBinaryOp.Le {
            return jet_driver_cost_capped(tree, place, left, turn, binds)
        }
        if op == TBinaryOp.Gt || op == TBinaryOp.Ge {
            return jet_driver_cost_capped(tree, place, right, turn, binds)
        }
    }
    false
}

// Whether the capped side `id` of a loop condition of `tree` is the place
// `place`, or it plus, less, times or shifted by some Int
// (jet_driver_cost_caps).
jet_driver_cost_capped: fn(tree: BodyTree, place: BodyPlace, id: Int, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    if body_node(tree, id).kind == .Binary(op, _, _, left, right) && (op == TBinaryOp.Add || op == TBinaryOp.Sub || op == TBinaryOp.Mul || op == TBinaryOp.Shl) {
        if op == TBinaryOp.Mul && jet_driver_cost_updates_place(tree, place, right, turn, binds) {
            return true
        }
        return jet_driver_cost_updates_place(tree, place, left, turn, binds)
    }
    jet_driver_cost_updates_place(tree, place, id, turn, binds)
}

// Whether node `id` of `tree` reads the place `place` an assignment stores,
// the same one on every turn of the loop whose expressions are `turn`.
jet_driver_cost_updates_place: fn(tree: BodyTree, place: BodyPlace, id: Int, turn: [Int:Bool], binds: JetDriverCostBinds) -> Bool Never! {
    read: body_node(tree, id)
    if place == .Local(local) {
        if read.kind == .Local(other) {
            return local.symbol_id != None && other.symbol_id == local.symbol_id
        }
        return false
    }
    if place == .Expr(expression) {
        stored: jet_driver_cost_turn_path(tree, expression, turn, binds) ?? return false
        read_path: jet_driver_cost_turn_path(tree, id, turn, binds) ?? return false
        return read_path == stored
    }
    false
}

// Whether an Int update by `operator` with step node `step` of `tree` grows
// geometrically (jet_driver_cost_growth).
jet_driver_cost_step_grows: fn(tree: BodyTree, operator: TBinaryOp, step: Int) -> Bool Never! {
    bounds: body_cost_integer_bounds(tree, step)
    if operator == TBinaryOp.Mul {
        if bounds == .Val(factor) -> return factor.lo < -1 || factor.hi > 1
        return true
    }
    if operator == TBinaryOp.Shl {
        if bounds == .Val(shift) -> return shift.hi > 0
        return true
    }
    false
}

// The map edits of `tree` that a loop repeats while the same loop's body
// shares the edited map, by the edit's node id (a map entry store's index or
// a mutating builtin call). A share made each turn, before the edit or after
// it for the next turn, leaves the map's backing store shared when the edit
// runs, so the edit clones the whole map each turn. A share made before the
// loop is cloned away by the first edit, at most once.
jet_driver_cost_shared_edits: fn(tree: BodyTree) -> [Int:Bool] Never! {
    edits := [Int:Bool]{}
    loop statement in tree.stmts {
        iterated := [Int]{}
        jet_driver_cost_iterated(tree, statement, iterated)
        shares := [String]{}
        inside := [Int:Bool]{}
        loop id in iterated {
            inside[id] = true
            copied: jet_driver_cost_shared_value(tree, id) ?? next
            if jet_driver_cost_place_path(tree, copied) == .Val(path) -> shares.push(path)
        }
        if shares.len() == 0 -> next
        loop id in iterated {
            if body_node(tree, id).kind == .BuiltinMethod(receiver, operation, _) && checked_builtin_mutates_receiver(operation) && body_cost_type(tree, receiver) == .Val(receiver_type) {
                if receiver_type == .Map(_, _, _) && jet_driver_cost_shares_place(tree, receiver, shares) {
                    edits[id] = true
                }
            }
        }
        loop row in tree.stmts {
            if row == .Assign(place, _, value, _, _) && inside.get(value) != None {
                if place == .Expr(expression) && body_node(tree, expression).kind == .Index(base, _, kind, _, _, _) {
                    if (kind == TIndexKind.Map || kind == TIndexKind.MapOr) && jet_driver_cost_shares_place(tree, base, shares) {
                        edits[expression] = true
                    }
                }
            }
        }
    }
    edits
}

// The value node `id` of `tree` shares: the operand of a written `copy`
// or of a copy sema made, either of which shares a collection's backing
// store; None for any other node, and for a bitwise or Shared handle copy.
jet_driver_cost_shared_value: fn(tree: BodyTree, id: Int) -> Int? Never! {
    node: body_node(tree, id)
    if node.kind == .ExplicitCopy(value) -> return Val(value)
    if node.kind == .Clone(value, fact) && fact != CopyFact.Scalar -> return Val(value)
    None
}

// Whether the place node `id` of `tree` names overlaps one of `shares`
// (jet_driver_cost_place_path): the same place, a part of a shared place, or
// a place holding a shared part.
jet_driver_cost_shares_place: fn(tree: BodyTree, id: Int, shares: [String]) -> Bool Never! {
    path: jet_driver_cost_place_path(tree, id) ?? return false
    loop share in shares {
        if path == share || path.starts_with("{share}.") || path.starts_with("{share}[") || share.starts_with("{path}.") || share.starts_with("{path}[") {
            return true
        }
    }
    false
}

// The place node `id` of `tree` names, spelled from its local's symbol
// through `.field` for each field and `[]` for each index; None for a node
// that names no place, or a local with no symbol.
jet_driver_cost_place_path: fn(tree: BodyTree, id: Int) -> String? Never! {
    node: body_node(tree, id)
    if node.kind == .Local(local) && local.symbol_id == .Val(symbol) -> return Val("{symbol:Debug}")
    if node.kind == .Field(receiver, field) {
        base: jet_driver_cost_place_path(tree, receiver) ?? return None
        return Val("{base}.{field.name}")
    }
    if node.kind == .Index(base, _, _, _, _, _) {
        root: jet_driver_cost_place_path(tree, base) ?? return None
        return Val("{root}[]")
    }
    None
}

// The cost of assigning `value` to `place` with compound operator `op`: a
// store into a map entry edits the map's possibly shared backing store, and
// an Int `+=`, `-=` or `*=` is an exact Int operation.
jet_driver_cost_assign_fact: fn(tree: BodyTree, place: BodyPlace, op: TBinaryOp?, value: Int) -> TCostFact? Never! {
    target := TIntegerBounds?{None}
    if place == .Expr(expression) {
        if body_node(tree, expression).kind == .Index(_, _, kind, _, _, _) {
            if kind == TIndexKind.Map || kind == TIndexKind.MapOr {
                return Val(TCostFact{kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder})
            }
        }
        if body_cost_type(tree, expression) != .Val(Type.Int) -> return None
        target = body_cost_integer_bounds(tree, expression)
    } else if place == .Local(local) {
        if local.ty != Type.Int -> return None
        target = local.integer_bounds
    }
    operator: op ?? return None
    if operator != TBinaryOp.Add && operator != TBinaryOp.Sub && operator != TBinaryOp.Mul {
        return None
    }
    operand: body_cost_integer_bounds(tree, value)
    result := TIntegerBounds?{None}
    if target == .Val(first) && operand == .Val(second) {
        result = checked_cost_combine_bounds(operator, first, second)
    }
    Val(checked_cost_int_fact([TIntegerBounds?]{target, operand}, result))
}
