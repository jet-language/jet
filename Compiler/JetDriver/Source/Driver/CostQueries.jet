// One invocation-scoped checked cost producer for every consumer.
use jet_foundation.[Span, TCostKind, TCostState]

TCostSite: struct {
    function: String
    span: Span
    loop_depth: Int
    kind: TCostKind
    state: TCostState
}
TCostReport: struct { sites: [TCostSite]{[TCostSite]{}} }

JetDriverCostQueryResult: struct {
    compile: JetDriverCompileResult
    report: TCostReport?
    gaps: [String]
}
jet_driver_cost_query: fn(request: &&JetDriverCompileRequest) -> JetDriverCostQueryResult {
    selected := request.move()
    selected.mode = JetDriverCompileMode.Doc
    selected.capture_cost_report = true
    compile := jet_driver_compile(selected)
    // Move the report rows out and reset the fields with whole assignments,
    // so `compile` is whole again when it moves below.
    report := compile.cost_report.move()
    compile.cost_report = None
    gaps := compile.cost_gaps.move()
    compile.cost_gaps = [String]{}
    JetDriverCostQueryResult{compile: compile.move(), report: report.move(), gaps: gaps.move()}
}
