// One invocation-scoped checked-TIR cost producer for every consumer.
use jet_codegen.[TCostReport, jet_codegen_cost_report]
use jet_sema.[SemaGraphResult]

struct JetDriverCostQueryResult {
    compile: JetDriverCompileResult
    report: TCostReport?
    gaps: [String]
}
fn jet_driver_cost_query(request: ^JetDriverCompileRequest) -> JetDriverCostQueryResult {
    selected := ^request
    selected.mode = JetDriverCompileMode.Doc
    selected.capture_cost_report = true
    compile := jet_driver_compile_mir(^selected)
    // The report rows are plain data: copy them out and clear the fields with
    // whole assignments, so `compile` stays one owner that moves once below.
    report := compile.cost_report.copy()
    compile.cost_report = None
    gaps := compile.cost_gaps.copy()
    compile.cost_gaps = [String]{}
    JetDriverCostQueryResult{compile: ^compile, report: ^report, gaps: ^gaps}
}
fn jet_driver_checked_cost_report(checked: SemaGraphResult) -> TCostReport {
    report := TCostReport{}
    loop module_row in checked.modules {
        // Only canonical user source modules contribute warning sites. Core
        // bodies still participate in sema's callable coverage proof.
        if module_row.module_identity.starts_with("<corelib>/") -> next
        collected :: jet_codegen_cost_report(module_row.functions)
        loop site in collected.sites -> &report.sites.push(site)
    }
    report
}
