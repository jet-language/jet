// D-STRUCT-EDGE1=A (Docs/spec/syntax-decisions.md): a package's
// `boundaries: { deny: [{ from: "app.ui", to: "app.db" }] }` governs its own
// modules' import edges. Import resolution reports each denied edge (E0619) at
// its `use`, and each rule that matches no loaded edge warns (L0619) without
// blocking the build. The policy has no runtime representation.
use {
    jet_foundation.[Diagnostic, diagnostic_with_source_path]
    jet_pkg_model.[ImportBoundary, ManifestEntry, PackageParseError, pkg_manifest_diagnostic_from_row, pkg_parse_boundaries, pkg_record_body, pkg_retired_record_head_spans]
    jet_sema.[SemaRegistrationImportEdge]
}

// The `boundaries:` field's value, read by the canonical Package reader.
fn jet_driver_read_package_boundaries(value: String) -> [ImportBoundary] PackageParseError! {
    if pkg_retired_record_head_spans(value).len() > 0 -> return Err(PackageParseError.RetiredRecordHead)
    boundaries :: pkg_parse_boundaries(pkg_record_body(value, "boundaries"))
    Ok(boundaries)
}

fn jet_driver_check_import_boundaries(packages: [JetDriverPackageInfo], source_units: [JetDriverSourceUnit], modules: [JetDriverLoadedModule], imports: [SemaRegistrationImportEdge], diagnostics: &[Diagnostic]) {
    hits := [[Bool]]{}
    any_rule := false
    loop package in packages {
        row := [Bool]{}
        loop _ in package.boundaries -> &row.push(false)
        if package.boundaries.len() > 0 -> any_rule = true
        &hits.push(^row)
    }
    if !any_rule -> return
    unit_of_module := [String:Int]{}
    loop loaded in modules -> unit_of_module[loaded.module_identity] = loaded.source_unit_index
    loop edge in imports {
        if !jet_driver_import_is_module_edge(edge.declaration.kind) -> next
        from_index :: unit_of_module.get(edge.source_module_identity) ?? next
        to_index :: unit_of_module.get(edge.target_module_identity) ?? next
        from_unit :: source_units[from_index]
        to_unit :: source_units[to_index]
        if from_unit.root_index < 0 || from_unit.root_index >= packages.len() || to_unit.root_index < 0 || to_unit.root_index >= packages.len() -> next
        from_package :: packages[from_unit.root_index]
        if from_package.boundaries.len() == 0 -> next
        to_package :: packages[to_unit.root_index]
        if to_package.name == "" -> next
        from_name :: jet_driver_boundary_module_name(from_package.name, from_unit.relative_path)
        to_name :: jet_driver_boundary_module_name(to_package.name, to_unit.relative_path)
        loop (rule_index, rule) in from_package.boundaries {
            if !rule.matches(from_name, to_name) -> next
            hits[from_unit.root_index][rule_index] = true
            denied :: pkg_manifest_diagnostic_from_row("E0619", [ManifestEntry]{
                ManifestEntry{key: "from", value: from_name},
                ManifestEntry{key: "to", value: to_name},
                ManifestEntry{key: "rule", value: "{rule.from} -> {rule.to}"},
            }, Val(edge.declaration.span))
            &diagnostics.push(diagnostic_with_source_path(^denied, from_unit.path, 0))
            break
        }
    }
    loop (package_index, package) in packages {
        loop (rule_index, rule) in package.boundaries {
            if hits[package_index][rule_index] -> next
            unused :: pkg_manifest_diagnostic_from_row("L0619", [ManifestEntry]{ManifestEntry{key: "rule", value: "{rule.from} -> {rule.to}"}}, None)
            &diagnostics.push(diagnostic_with_source_path(^unused, package.manifest_path ?? "package.jet", 0))
        }
    }
}

// A module's boundary name: its package name, then its path under the package
// root without the `.jet` suffix (`app` + `ui/forms.jet` is `app.ui.forms`).
// A nested `main.jet` or `module.jet` names its directory.
fn jet_driver_boundary_module_name(package: String, relative_path: String) -> String Never! {
    parts := [String]{}
    loop part in relative_path.split("/") {
        if part == "" || part == "." -> next
        if part.ends_with(".jet") -> &parts.push(part.removesuffix(".jet")) else -> &parts.push(part)
    }
    if parts.len() > 1 && (parts[parts.len() - 1] == "main" || parts[parts.len() - 1] == "module") -> _ := &parts.pop()
    name := package
    loop part in parts -> name = "{name}.{part}"
    name
}
