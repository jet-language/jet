// The public moments a compile reaches (JetFoundation Registry/CompilerEvents.jet),
// recorded when the request asks for them (JetDriverCompileRequest
// .compiler_events) and handed back in the compile result's `events`, and
// listed for a build's `meta.stages()` (jet_driver_stages). The driver names
// a moment only through the registry's rows and fills its payload through
// the payload row's fields, so `stages()`, `jet build --json` and the
// session wire read one list.
//
// The order is fixed, whatever the thread count: the load's moments by file
// path (each file parsed, then each module other than the entry imported),
// then each checked declaration by module path and declaration order, the
// checked program, the round that settled it, and the compile's outcome
// last. A compile settles in one round, whose new items are all of its
// declarations. The moments cover only what the program wrote: no module
// the compiler supplies (Core, the Prelude) and no function sema injects.
use {
    jet_foundation.[
        COMPILER_EVENT_CHECKED,
        COMPILER_EVENT_DECLARED,
        COMPILER_EVENT_FINISHED,
        COMPILER_EVENT_IMPORTED,
        COMPILER_EVENT_PARSED,
        COMPILER_EVENT_SETTLED,
        CompilerEventRecord,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        ModuleID,
        SymbolTable,
        TComptimeValue,
        compiler_event_payload,
        compiler_event_payload_name,
        compiler_event_record,
        compiler_event_stage,
        module_is_core,
        name_find,
        name_index,
        name_intern,
        name_table,
        symbol_is_local,
        symbol_is_none,
        symbol_key_leaf,
        symbol_table_key,
    ]
    jet_sema.[JET_CANONICAL_EFFECT_PACKAGE_IDENTITY, SemaGraphResult]
}

// One row to order by: its path and its position in the list it indexes.
JetDriverEventOrder: struct {
    path: String,
    index: Int,
}

jet_driver_event_order: fn(rows: ^[JetDriverEventOrder]) Never! {
    rows.sort_by(fn(left: JetDriverEventOrder, right: JetDriverEventOrder) { (left.path <=> right.path).then(left.index <=> right.index) })
}

// A module the compiler supplies, which no moment names: a Core module or
// one of the canonical Prelude's error and effect declarations.
jet_driver_event_module_is_supplied: fn(module_identity: ModuleID, package_identity: String) -> Bool Never! {
    module_is_core(module_identity) || package_identity == JET_CANONICAL_EFFECT_PACKAGE_IDENTITY
}

// One checked declaration a `compiler.declared` moment names: its name, its
// module, the names of the declarations it calls in first-call order, and
// whether its module checked whole.
JetDriverDeclared: struct {
    name: String,
    module: String,
    calls: [String],
    complete: Bool,
}

// The `Declaration` payload of `row`.
jet_driver_declaration_value: fn(row: JetDriverDeclared) -> TComptimeValue Never! {
    ^calls: [TComptimeValue]{}
    loop call in row.calls -> calls.push(TComptimeValue.String{value: call})
    values: [TComptimeValue]{
        TComptimeValue.String{value: row.name},
        TComptimeValue.String{value: row.module},
        TComptimeValue.List{values: calls},
        TComptimeValue.Bool{value: row.complete},
    }
    compiler_event_payload(compiler_event_payload_name(COMPILER_EVENT_DECLARED), values.move())
}

// The `Declaration` payloads of `rows`, in order.
jet_driver_declaration_list: fn(rows: [JetDriverDeclared]) -> TComptimeValue Never! {
    ^values: [TComptimeValue]{}
    loop row in rows -> values.push(jet_driver_declaration_value(row))
    TComptimeValue.List{values: values}
}

// The parsed and imported moments of a load: each loaded module the
// compiler does not supply, by its file's path and under its source name;
// the entry module is parsed, not imported.
jet_driver_load_events: fn(load: JetDriverLoadResult) -> [CompilerEventRecord] Never! {
    ^order: [JetDriverEventOrder]{}
    loop (index, loaded) in load.modules {
        if jet_driver_event_module_is_supplied(loaded.module_identity, loaded.package_identity) {
            next
        }
        order.push(JetDriverEventOrder{path: load.source_units[loaded.source_unit_index].relative_path, index: index})
    }
    jet_driver_event_order(order)
    ^events: [CompilerEventRecord]{}
    loop row in order {
        events.push(compiler_event_record(COMPILER_EVENT_PARSED, [TComptimeValue]{TComptimeValue.String{value: row.path}, TComptimeValue.String{value: load.modules[row.index].module_name}}))
    }
    loop row in order {
        loaded: load.modules[row.index]
        if loaded.module_identity == load.entry_module_identity -> next
        files: TComptimeValue.List{values: [TComptimeValue]{TComptimeValue.String{value: row.path}}}
        events.push(compiler_event_record(COMPILER_EVENT_IMPORTED, [TComptimeValue]{TComptimeValue.String{value: loaded.module_name}, files}))
    }
    events
}

// The declared, checked and settled moments of a checked program: each
// function written in a module the compiler does not supply (not one sema
// injected), by module path and declaration order, with the names of the
// declarations it calls in first-call order.
jet_driver_checked_events: fn(graph: SemaGraphResult, symbols: SymbolTable) -> [CompilerEventRecord] Never! {
    ^order: [JetDriverEventOrder]{}
    loop (index, graph_module) in graph.modules {
        if jet_driver_event_module_is_supplied(graph_module.module_identity, graph_module.package_identity) {
            next
        }
        order.push(JetDriverEventOrder{path: graph_module.module_path, index: index})
    }
    ^declared: [JetDriverDeclared]{}
    ^events: [CompilerEventRecord]{}
    loop row in order {
        graph_module: graph.modules[row.index]
        // Each function's row of `declared`, by its key's id in `keys`; -1
        // at id 0, the empty key, which no function has.
        first: declared.len()
        ^keys: name_table()
        ^places: [Int]{-1}
        loop function in graph_module.functions {
            if graph_module.injected_function_keys.contains(function.key) -> next
            id: name_index(name_intern(keys, function.key))
            if id == places.len() -> places.push(declared.len()) else -> places[id] = declared.len()
            declared.push(JetDriverDeclared{name: function.name, module: graph_module.module_name, calls: [String]{}, complete: graph_module.complete})
        }
        loop fact in graph_module.call_facts {
            callee: fact.callee ?? next
            if symbol_is_none(callee) || symbol_is_local(callee) -> next
            called: symbol_key_leaf(symbol_table_key(symbols, callee))
            caller: name_find(keys, fact.caller_key) ?? next
            at: places[name_index(caller)]
            if at < 0 -> next
            if !declared[at].calls.contains(called) -> declared[at].calls.push(called)
        }
        loop at in first..<declared.len() {
            events.push(CompilerEventRecord{name: COMPILER_EVENT_DECLARED, data: jet_driver_declaration_value(declared[at])})
        }
    }
    program: compiler_event_payload(compiler_event_payload_name(COMPILER_EVENT_CHECKED), [TComptimeValue]{jet_driver_declaration_list(declared)})
    events.push(compiler_event_record(COMPILER_EVENT_CHECKED, [TComptimeValue]{jet_driver_declaration_list(declared)}))
    events.push(compiler_event_record(COMPILER_EVENT_SETTLED, [TComptimeValue]{TComptimeValue.Int{value: 1}, program.move(), jet_driver_declaration_list(declared)}))
    events
}

// The finished moment of the compile that ended in `result`.
jet_driver_finished_event: fn(result: JetDriverCompileResult) -> CompilerEventRecord Never! {
    ^errors: 0
    ^warnings: 0
    loop diagnostic in result.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> errors += 1
        if diagnostic.severity == DIAGNOSTIC_LINT -> warnings += 1
    }
    ok: result.complete && errors == 0
    compiler_event_record(COMPILER_EVENT_FINISHED, [TComptimeValue]{TComptimeValue.Bool{value: ok}, TComptimeValue.Int{value: errors}, TComptimeValue.Int{value: warnings}})
}

// What `meta.stages()` lists for the build of a checked program: its load's
// moments, then its checked declarations', each as its
// `core.compiler.Event`, in the fixed order above. The build runs before the
// program is emitted, so the list ends at the settled round.
jet_driver_stages: fn(load: JetDriverLoadResult, graph: SemaGraphResult, symbols: SymbolTable) -> [TComptimeValue] Never! {
    ^stages: [TComptimeValue]{}
    loaded: jet_driver_load_events(load)
    loop record in loaded.move() {
        stages.push(compiler_event_stage(record.name, record.data.move()))
    }
    checked: jet_driver_checked_events(graph, symbols)
    loop record in checked.move() {
        stages.push(compiler_event_stage(record.name, record.data.move()))
    }
    stages
}
