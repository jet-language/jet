// The public moments a compile reaches (JetFoundation Registry/CompilerEvents.jet),
// recorded when the request asks for them (JetDriverCompileRequest
// .compiler_events) and handed back in the compile result's `events`. The
// driver names a moment only through the registry's rows and fills its
// payload through the payload row's fields, so `stages()`, `jet build
// --json` and the session wire read one list.
//
// The order is fixed, whatever the thread count: the load's moments by file
// path (each file parsed, then each module other than the entry imported),
// then each checked declaration by module path and declaration order, the
// checked program, the round that settled it, and the compile's outcome
// last. A compile settles in one round, whose new items are all of its
// declarations.
use {
    jet_foundation.[
        COMPILER_EVENT_CHECKED,
        COMPILER_EVENT_DECLARED,
        COMPILER_EVENT_FINISHED,
        COMPILER_EVENT_IMPORTED,
        COMPILER_EVENT_PARSED,
        COMPILER_EVENT_SETTLED,
        CompilerEventRecord,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        ModuleID,
        SymbolTable,
        compiler_event_object,
        compiler_event_payload_name,
        compiler_event_record,
        foundation_json_quote,
        module_is_core,
        module_text,
        symbol_is_local,
        symbol_is_none,
        symbol_table_key,
    ]
    jet_sema.[SemaGraphResult]
}

// One row to order by: its path, already a JSON string, and its position in
// the list it indexes.
JetDriverEventOrder: struct {
    path: String,
    index: Int,
}

jet_driver_event_order: fn(rows: &[JetDriverEventOrder]) Never! {
    rows.sort_by(fn(left: JetDriverEventOrder, right: JetDriverEventOrder) { (left.path <=> right.path).then(left.index <=> right.index) })
}

// The parsed and imported moments of a load: each loaded module outside
// Core by its file's path; the entry module is parsed, not imported.
jet_driver_load_events: fn(load: JetDriverLoadResult) -> [CompilerEventRecord] Never! {
    order := [JetDriverEventOrder]{}
    loop (index, loaded) in load.modules {
        if module_is_core(loaded.module_identity) -> next
        order.push(JetDriverEventOrder{path: foundation_json_quote(load.source_units[loaded.source_unit_index].relative_path), index: index})
    }
    jet_driver_event_order(order)
    events := [CompilerEventRecord]{}
    loop row in order {
        name: foundation_json_quote(module_text(load.module_table, load.modules[row.index].module_identity))
        events.push(compiler_event_record(COMPILER_EVENT_PARSED, [String]{row.path, name}))
    }
    loop row in order {
        loaded: load.modules[row.index]
        if loaded.module_identity == load.entry_module_identity -> next
        name: foundation_json_quote(module_text(load.module_table, loaded.module_identity))
        events.push(compiler_event_record(COMPILER_EVENT_IMPORTED, [String]{name, "[{row.path}]"}))
    }
    events
}

// The declared, checked and settled moments of a checked program: each
// function of a module outside Core (and other than the compiler-owned
// effect module `effects`), by module path and declaration order, with the
// names of the declarations it calls in first-call order.
jet_driver_checked_events: fn(graph: SemaGraphResult, symbols: SymbolTable, effects: ModuleID) -> [CompilerEventRecord] Never! {
    order := [JetDriverEventOrder]{}
    loop (index, graph_module) in graph.modules {
        if module_is_core(graph_module.module_identity) || graph_module.module_identity == effects {
            next
        }
        order.push(JetDriverEventOrder{path: foundation_json_quote(graph_module.module_path), index: index})
    }
    jet_driver_event_order(order)
    declaration_payload: compiler_event_payload_name(COMPILER_EVENT_DECLARED)
    declarations := [String]{}
    events := [CompilerEventRecord]{}
    loop row in order {
        graph_module: graph.modules[row.index]
        // Each caller's callees, as JSON strings: `callers` places a caller
        // key's row of `called`.
        callers := [String:Int]{}
        called := [[String]]{}
        loop fact in graph_module.call_facts {
            callee: fact.callee ?? next
            if symbol_is_none(callee) || symbol_is_local(callee) -> next
            parts: symbol_table_key(symbols, callee).rpartition(":")
            if parts.sep == "" -> next
            name: foundation_json_quote(parts.tail)
            caller: foundation_json_quote(fact.caller_key)
            at := callers.get(caller) ?? -1
            if at < 0 {
                at = called.len()
                callers[caller] = at
                called.push([String]{})
            }
            if !called[at].contains(name) -> called[at].push(name)
        }
        loop function in graph_module.functions {
            at: callers.get(foundation_json_quote(function.key)) ?? -1
            calls: if at < 0 -> "[]" else -> "[{called[at].join(",")}]"
            values: [String]{
                foundation_json_quote(function.name),
                foundation_json_quote(graph_module.module_name),
                calls,
                if graph_module.complete -> "true" else -> "false",
            }
            declarations.push(compiler_event_object(declaration_payload, values))
            events.push(compiler_event_record(COMPILER_EVENT_DECLARED, values))
        }
    }
    listed: "[{declarations.join(",")}]"
    program: compiler_event_object(compiler_event_payload_name(COMPILER_EVENT_CHECKED), [String]{listed})
    events.push(compiler_event_record(COMPILER_EVENT_CHECKED, [String]{listed}))
    events.push(compiler_event_record(COMPILER_EVENT_SETTLED, [String]{"1", program, listed}))
    events
}

// The finished moment of the compile that ended in `result`.
jet_driver_finished_event: fn(result: JetDriverCompileResult) -> CompilerEventRecord Never! {
    errors := 0
    warnings := 0
    loop diagnostic in result.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> errors += 1
        if diagnostic.severity == DIAGNOSTIC_LINT -> warnings += 1
    }
    ok: result.complete && errors == 0
    compiler_event_record(COMPILER_EVENT_FINISHED, [String]{if ok -> "true" else -> "false", "{errors}", "{warnings}"})
}
