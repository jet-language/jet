// The tool stages (JetFoundation ToolStages.jet) as a tool runs them: the
// hooks a checked document's imports declare with `#On(stage, Marker)`, one
// call per hook and block of its marker in the document, the compile-time
// program that makes those calls, and the answers read back from its values.
// A hook runs only for a document that imports its package, and a qualified
// block (`#Tools.Query { … }`) only reaches the package its qualifier names.
// The host compiles the program beside the document (JetCLI ToolStages.jet),
// so the hooks run as every compile-time value does. `jet build`'s link step
// calls its `build.link` hook the same way (JetCLI LinkStep.jet).
use {
    jet_foundation.[
        COMPILER_EVENT_BUILD_LINK,
        ImportDecl,
        Span,
        TComptimeField,
        TComptimeValue,
        TOOL_STAGE_FMT_BLOCK,
        TOOL_STAGE_LSP_COMPLETION,
        TOOL_STAGE_LSP_INLAY_HINTS,
        TOOL_STAGE_LSP_SEMANTIC_TOKENS,
        foundation_byte_text,
        jet_config_string_escape,
        sema_casing_marker_qualifier,
        stage_hook,
    ]
    jet_lexer.[TOKEN_DOT, TOKEN_EOF, TOKEN_HASH, TOKEN_IDENT, TOKEN_LBRACE, TOKEN_LPAREN, TOKEN_RBRACE, TOKEN_RPAREN, lex, token_text]
    jet_parser.[parse_source]
    jet_sema.[SemaComptimeItemKind, SemaComptimeItemValue]
}

// The name each call's value has in the program, numbered by call.
JET_DRIVER_TOOL_STAGE_VALUE: "TOOL_STAGE_CALL"

// A marked block of a document: the marker as written and the bytes between
// its braces.
JetDriverToolStageBlock: struct {
    marker: String,
    body: Span,
}

// The calls a tool stage makes on one document: each call's block body, as
// document byte offsets, and the compile-time program whose value
// `{JET_DRIVER_TOOL_STAGE_VALUE}_{n}` is call `n`'s answer.
JetDriverToolStagePlan: struct {
    bodies: [Span],
    program: String,
}

// One row of a call's answer, at document byte offsets: a completion
// (`label`, `detail`), a token (`at`, `length`, `kind`), a hint (`at`,
// `label`), or a block's formatted text (`label`, over the whole body).
JetDriverToolStageItem: struct {
    at: Int,
    length: Int,
    label: String,
    detail: String{""},
    kind: String{""},
}

// Each `#Marker(…) { … }` block of `source` a hook may read, outermost
// first: a capitalized marker path (so not `#run { … }`), a package's or the
// prelude's (`#SQL(User) { … }`), directly followed by its arguments, if any,
// and `{`.
jet_driver_tool_stage_blocks: fn(source: String) -> [JetDriverToolStageBlock] Never! {
    lexed: lex(source.bytes())
    tokens: lexed.tokens
    blocks := [JetDriverToolStageBlock]{}
    loop index in 0..<tokens.len() {
        if tokens[index].kind != TOKEN_HASH || index + 1 >= tokens.len() || tokens[index + 1].kind != TOKEN_IDENT {
            next
        }
        path := token_text(lexed.tables, tokens[index + 1])
        cursor := index + 2
        loop cursor + 1 < tokens.len() && tokens[cursor].kind == TOKEN_DOT && tokens[cursor + 1].kind == TOKEN_IDENT {
            path = "{path}.{token_text(lexed.tables, tokens[cursor + 1])}"
            cursor += 2
        }
        if cursor < tokens.len() && tokens[cursor].kind == TOKEN_LPAREN {
            depth := 0
            loop cursor < tokens.len() {
                if tokens[cursor].kind == TOKEN_LPAREN -> depth += 1
                if tokens[cursor].kind == TOKEN_RPAREN -> depth -= 1
                cursor += 1
                if depth == 0 -> break
            }
        }
        if cursor >= tokens.len() || tokens[cursor].kind != TOKEN_LBRACE -> next
        open: tokens[cursor].span.end
        depth := 0
        close := -1
        loop cursor < tokens.len() && tokens[cursor].kind != TOKEN_EOF {
            if tokens[cursor].kind == TOKEN_LBRACE -> depth += 1
            if tokens[cursor].kind == TOKEN_RBRACE {
                depth -= 1
                if depth == 0 {
                    close = tokens[cursor].span.start
                    break
                }
            }
            cursor += 1
        }
        if close < open -> next
        segments: path.split(".").to_list()
        last: segments[segments.len() - 1].bytes()
        if last[0] < (U8{65}) || last[0] > (U8{90}) -> next
        blocks.push(JetDriverToolStageBlock{marker: path, body: Span{start: open, end: close}})
    }
    blocks
}

// The markers of the `stage` hooks that the `.jet` sources of `snapshot`
// declare on their functions (`#On(fmt.block, Query)` gives `Query`), read
// from a parse of each source that spells `#On`, with no check. The plan
// calls only those hooks, so a document whose blocks reach none of these
// markers (jet_driver_tool_stage_hooked) needs no compile for the stage.
jet_driver_tool_stage_snapshot_markers: fn(snapshot: JetDriverAuthorizedSourceSnapshot, stage: String) -> [String] Never! {
    markers := [String]{}
    loop root in snapshot.roots {
        loop file in root.files {
            if !file.relative_path.ends_with(".jet") || !jet_driver_tool_stage_spells_on(file.source) {
                next
            }
            parsed: parse_source(file.source.bytes())
            loop item in parsed.program.items {
                if item == .Func(func) {
                    loop marker in func.markers {
                        hook: stage_hook(marker) ?? next
                        if hook.stage == stage && !markers.contains(hook.marker) {
                            markers.push(hook.marker)
                        }
                    }
                }
            }
        }
    }
    markers
}

// Whether `source` may hold an `#On` marker: a `#`, any blank, then the word
// `On`. Text that only mentions one (a comment, a string) passes too, and
// its parse finds no hook.
jet_driver_tool_stage_spells_on: fn(source: String) -> Bool Never! {
    bytes: source.bytes()
    loop at in 0..<bytes.len() {
        if bytes[at] != (U8{35}) -> next
        cursor := at + 1
        loop cursor < bytes.len() && (bytes[cursor] == (U8{32}) || bytes[cursor] == (U8{9}) || bytes[cursor] == (U8{10}) || bytes[cursor] == (U8{13})) {
            cursor += 1
        }
        if cursor + 1 >= bytes.len() || bytes[cursor] != (U8{79}) || bytes[cursor + 1] != (U8{110}) {
            next
        }
        if cursor + 2 == bytes.len() -> return true
        after: bytes[cursor + 2]
        word: (after >= (U8{48}) && after <= (U8{57})) || (after >= (U8{65}) && after <= (U8{90})) || (after >= (U8{97}) && after <= (U8{122})) || after == (U8{95})
        if !word -> return true
    }
    false
}

// Whether one of `blocks` may reach a hook of one of `markers`: the last
// segments of their markers agree, as jet_driver_tool_stage_reaches needs
// before it asks about the import.
jet_driver_tool_stage_hooked: fn(blocks: [JetDriverToolStageBlock], markers: [String]) -> Bool Never! {
    loop block in blocks {
        loop marker in markers {
            if jet_driver_tool_stage_leaf(block.marker) == jet_driver_tool_stage_leaf(marker) {
                return true
            }
        }
    }
    false
}

// The last segment of a marker path (`Query` of `Tools.Query`).
jet_driver_tool_stage_leaf: fn(path: String) -> String Never! { path.rpartition(".").tail }

// The calls `stage` makes on the document `modules[document]`: each hook of
// the stage that a module the document imports declares, on each block of
// its marker, in hook then block order; only on the block holding byte `at`
// when one is given. The program imports each hook module once.
jet_driver_tool_stage_plan: fn(modules: [JetDriverDocModule], document: Int, stage: String, at: Int{-1}) -> JetDriverToolStagePlan Never! {
    bodies := [Span]{}
    if document < 0 || document >= modules.len() {
        return JetDriverToolStagePlan{bodies: bodies, program: ""}
    }
    source: modules[document].source
    imports: modules[document].imports
    blocks: jet_driver_tool_stage_blocks(source)
    bytes: source.bytes()
    uses := [String]{"jet_tool_stage_compiler: core.compiler"}
    values := [String]{}
    loop (index, module_ref) in modules {
        if index == document || blocks.len() == 0 -> next
        imported: jet_driver_tool_stage_import(imports, module_ref.module_name) ?? next
        slot := -1
        loop item in module_ref.items {
            if item == .Func(func) {
                loop marker in func.markers {
                    hook: stage_hook(marker) ?? next
                    if hook.stage != stage -> next
                    loop block in blocks {
                        if at >= 0 && (at < block.body.start || at > block.body.end) -> next
                        if !jet_driver_tool_stage_reaches(block.marker, hook.marker, imports[imported].alias) {
                            next
                        }
                        if slot < 0 {
                            slot = uses.len() - 1
                            uses.push("jet_tool_stage_{slot}: {module_ref.module_name}")
                        }
                        start: jet_driver_tool_stage_position(bytes, block.body.start)
                        text: jet_config_string_escape(foundation_byte_text(bytes, block.body.start, block.body.end))
                        argument: "jet_tool_stage_compiler.MarkerBlock{{marker: \"{jet_config_string_escape(block.marker)}\", text: \"{text}\", line: {start.line}, column: {start.column}}}"
                        values.push("\n{JET_DRIVER_TOOL_STAGE_VALUE}_{bodies.len()}: #run {{ jet_tool_stage_{slot}.{func.name}({argument}) }}\n")
                        bodies.push(block.body)
                    }
                }
            }
        }
    }
    if bodies.len() == 0 -> return JetDriverToolStagePlan{bodies: bodies, program: ""}
    JetDriverToolStagePlan{bodies: bodies, program: "{jet_driver_tool_stage_uses(uses)}{values.join("")}"}
}

// A stage program's `use` block, one import per row (`alias: module`).
jet_driver_tool_stage_uses: fn(rows: [String]) -> String Never! {
    lines: loop row in rows -> "    {row}\n"
    "use {{\n{lines.join("")}}}\n"
}

// A 1-based line and byte column.
JetDriverToolStagePosition: struct {
    line: Int,
    column: Int,
}

jet_driver_tool_stage_position: fn(bytes: [U8], offset: Int) -> JetDriverToolStagePosition Never! {
    line := 1
    column := 1
    loop at in 0..<offset {
        if {
            bytes[at] == (U8{10}) -> {
                line += 1
                column = 1
            }
            else -> column += 1
        }
    }
    JetDriverToolStagePosition{line: line, column: column}
}

// The document's import that reaches the package of the module
// `module_name`, by its index in `imports`.
jet_driver_tool_stage_import: fn(imports: [ImportDecl], module_name: String) -> Int? Never! {
    package: module_name.partition(".").head
    loop (index, declaration) in imports {
        imported: if declaration.kind == {
            .Module(name, _) -> name
            .Unqualified(module_alias, _, _, _, _) -> module_alias
            .File(_, _) -> ""
        }
        if imported != "" && imported.partition(".").head == package -> return Val(index)
    }
    None
}

// Whether a block written `#written` is a block of the hook's `marker` from the
// package the document imports as `alias`: the last segments agree, and a
// qualified block names that import.
jet_driver_tool_stage_reaches: fn(written: String, marker: String, alias: String) -> Bool Never! {
    if jet_driver_tool_stage_leaf(written) != jet_driver_tool_stage_leaf(marker) -> return false
    segments: written.split(".").to_list()
    segments.len() == 1 || (segments.len() == 2 && segments[0] == sema_casing_marker_qualifier(alias))
}

// Each call's answer rows, read from the values of the program's compile, in
// call order; a call with no readable value answers nothing.
jet_driver_tool_stage_answers: fn(stage: String, bodies: [Span], values: &&[SemaComptimeItemValue]) -> [[JetDriverToolStageItem]] Never! {
    answers := [[JetDriverToolStageItem]]{}
    loop _ in bodies -> answers.push([JetDriverToolStageItem]{})
    loop value in values.move() {
        if value.kind != SemaComptimeItemKind.Constant -> next
        loop (index, body) in bodies {
            if !value.key.ends_with(":{JET_DRIVER_TOOL_STAGE_VALUE}_{index}") -> next
            answers[index] = jet_driver_tool_stage_rows(stage, body, value.value.move())
            break
        }
    }
    answers
}

jet_driver_tool_stage_rows: fn(stage: String, body: Span, value: &&TComptimeValue) -> [JetDriverToolStageItem] Never! {
    rows := [JetDriverToolStageItem]{}
    if stage == TOOL_STAGE_FMT_BLOCK {
        if jet_driver_tool_stage_text(value.move()) == .Val(text) {
            rows.push(JetDriverToolStageItem{at: body.start, length: body.end - body.start, label: text})
        }
        return rows
    }
    if value.move() == .List(elements) {
        loop element in elements.move() {
            if element.move() == .Struct(_, fields) {
                if jet_driver_tool_stage_row(stage, body, fields.move()) == .Val(row) {
                    rows.push(row)
                }
            }
        }
    }
    rows
}

// One element of a list answer as a row, None when it is malformed or out of
// its block.
jet_driver_tool_stage_row: fn(stage: String, body: Span, fields: &&[TComptimeField]) -> JetDriverToolStageItem? Never! {
    row := JetDriverToolStageItem{at: 0, length: 0, label: ""}
    labeled := false
    kinded := false
    loop field in fields.move() {
        if field.name == "at" || field.name == "length" {
            if field.value == .Int(number) {
                if field.name == "at" -> row.at = number else -> row.length = number
            }
            next
        }
        if field.name == "label" {
            row.label = jet_driver_tool_stage_text(field.value.move()) ?? next
            labeled = true
        } else if field.name == "detail" {
            row.detail = jet_driver_tool_stage_text(field.value.move()) ?? next
        } else if field.name == "kind" {
            row.kind = jet_driver_tool_stage_text(field.value.move()) ?? next
            kinded = true
        }
    }
    if row.at < 0 || row.length < 0 || row.at + row.length > body.end - body.start -> return None
    if stage == TOOL_STAGE_LSP_COMPLETION && labeled {
        row.at = body.start
        row.length = 0
        return Val(row)
    }
    if stage == TOOL_STAGE_LSP_SEMANTIC_TOKENS && kinded && row.length > 0 {
        row.at += body.start
        return Val(row)
    }
    if stage == TOOL_STAGE_LSP_INLAY_HINTS && labeled {
        row.at += body.start
        row.length = 0
        return Val(row)
    }
    None
}

// A String value, or the String an optional holds.
jet_driver_tool_stage_text: fn(value: &&TComptimeValue) -> String? Never! {
    if value == .Present(_) {
        if value.move() == .Present(inner) -> return jet_driver_tool_stage_text(inner.move())
        return None
    }
    if value.move() == .String(text) -> return Val(text)
    None
}

// The name of the value a link stage's program gives its hook's answer.
JET_DRIVER_LINK_STAGE_VALUE: "LINK_STAGE_CALL"

// One output's link as a `build.link` hook gets it (core.compiler
// `LinkInputs`), each path relative to the package root: the object files
// and libraries, the `link_args` option, and the output's name and path.
// Its `default` is Jet's own link: a `BuildAction` with no command, reading
// the objects and libraries and making the output.
JetDriverLinkInputs: struct {
    objects: [String],
    libraries: [String],
    args: [String],
    output_name: String,
    output: String,
}

// A `BuildAction` a link hook returned (core.build): its name, its command,
// the files it reads and makes, and the names of the effects it may use.
// No command is Jet's own link over `inputs`.
JetDriverLinkAction: struct {
    name: String,
    run: [String],
    inputs: [String],
    outputs: [String],
    allow: [String],
}

// Whether `snapshot` declares the link hook `hook` (`tools.relink`): its
// module's file (`tools.jet`; `lib/tools.jet` for `lib.tools`) marks the
// function `#On(build.link)`. Read from a parse, with no check; the program
// that calls the hook checks it.
jet_driver_link_stage_declared: fn(snapshot: JetDriverAuthorizedSourceSnapshot, hook: String) -> Bool Never! {
    path: hook.rpartition(".")
    file_path: "{path.head.replace(".", "/")}.jet"
    loop root in snapshot.roots {
        loop file in root.files {
            if file.relative_path != file_path && !file.relative_path.ends_with("/{file_path}") {
                next
            }
            parsed: parse_source(file.source.bytes())
            loop item in parsed.program.items {
                if item == .Func(func) && func.name == path.tail {
                    loop marker in func.markers {
                        moment: stage_hook(marker) ?? next
                        if moment.stage == COMPILER_EVENT_BUILD_LINK -> return true
                    }
                }
            }
        }
    }
    false
}

// The program that calls the link hook `hook` (a module path and a function
// name joined by `.`, `tools.relink`) on `inputs`, as a tool stage's program
// calls its hooks: its `{JET_DRIVER_LINK_STAGE_VALUE}` is the hook's answer.
jet_driver_link_stage_program: fn(hook: String, inputs: JetDriverLinkInputs) -> String Never! {
    path: hook.rpartition(".")
    // Jet's own link reads the objects, then the libraries.
    linked := jet_driver_link_stage_quoted(inputs.objects)
    loop library in jet_driver_link_stage_quoted(inputs.libraries) -> linked.push(library)
    output: "\"{jet_config_string_escape(inputs.output)}\""
    default: "jet_link_build.BuildAction{{name: \"link\", run: [String]{{}}, inputs: [String]{{{linked.join(", ")}}}, outputs: [String]{{{output}}}, allow: [jet_link_lang.Effect]{{}}}}"
    given: "jet_link_compiler.LinkInputs{{objects: {jet_driver_link_stage_strings(inputs.objects)}, libraries: {jet_driver_link_stage_strings(inputs.libraries)}, args: {jet_driver_link_stage_strings(inputs.args)}, output_name: \"{jet_config_string_escape(inputs.output_name)}\", output: {output}, default: {default}}}"
    uses: jet_driver_tool_stage_uses([String]{"jet_link_build: core.build", "jet_link_compiler: core.compiler", "jet_link_lang: core.compiler.lang", "jet_link_hook: {path.head}"})
    "{uses}\n{JET_DRIVER_LINK_STAGE_VALUE}: #run {{ jet_link_hook.{path.tail}({given}) }}\n"
}

// Each of `values` as a string literal.
jet_driver_link_stage_quoted: fn(values: [String]) -> [String] Never! {
    loop value in values -> "\"{jet_config_string_escape(value)}\""
}

// `values` as a `[String]` literal.
jet_driver_link_stage_strings: fn(values: [String]) -> String Never! {
    "[String]{{{jet_driver_link_stage_quoted(values).join(", ")}}}"
}

// The `BuildAction` a link stage's program answered, read from the values of
// its compile; None when it has none or it is malformed.
jet_driver_link_stage_action: fn(values: &&[SemaComptimeItemValue]) -> JetDriverLinkAction? Never! {
    loop value in values.move() {
        if value.kind != SemaComptimeItemKind.Constant || !value.key.ends_with(":{JET_DRIVER_LINK_STAGE_VALUE}") {
            next
        }
        fields: if value.value.move() == .Struct(_, fields) -> fields else -> {
            return None
        }
        action := JetDriverLinkAction{name: "", run: [String]{}, inputs: [String]{}, outputs: [String]{}, allow: [String]{}}
        loop field in fields.move() {
            if field.name == "name" {
                action.name = jet_driver_tool_stage_text(field.value.move()) ?? return None
                next
            }
            items: if field.value.move() == .List(items) -> items else -> {
                return None
            }
            words := [String]{}
            loop item in items.move() {
                words.push(jet_driver_link_stage_word(item.move()) ?? return None)
            }
            if field.name == {
                "run" -> action.run = words.move()
                "inputs" -> action.inputs = words.move()
                "outputs" -> action.outputs = words.move()
                "allow" -> action.allow = words.move()
                else -> return None
            }
        }
        return Val(action)
    }
    None
}

// A String value, or the name of an `Effect` value.
jet_driver_link_stage_word: fn(value: &&TComptimeValue) -> String? Never! {
    if value == .Enum(_, _, _) {
        if value.move() == .Enum(_, variant, _) -> return Val(variant)
        return None
    }
    jet_driver_tool_stage_text(value.move())
}
