// Rust: crates/jet-foundation/src/Facts.rs:8
// Shape's canonical types stay in JetFoundation Shape; there is no second shape table.
// Rust: crates/jet-foundation/src/Facts.rs:17
pub struct ShapeFactRegistry {
    // GATE #4499: exact composite ShapeIdentity equality/hash/order.
    facts: [ShapeIdentity:ShapeFact]
    // Rust: crates/jet-foundation/src/Facts.rs:23
    pub fn insert(&self, fact: ShapeFact) -> ShapeFact? ShapeError! {
        fact.validate()
        previous :: self.facts.get(fact.identity)
        &self.facts.set(fact.identity, fact)
        Ok(previous)
    }
    // Rust: crates/jet-foundation/src/Facts.rs:28
    pub fn get(self, identity: ShapeIdentity) -> ShapeFact? Never! { self.facts.get(identity) }
    // Rust: crates/jet-foundation/src/Facts.rs:32
    pub fn project(self, identity: ShapeIdentity, kind: ShapeProjectionKind) -> ShapeProjection? ShapeError! {
        fact :: self.get(identity) ?? return Ok(None)
        Ok(Val(fact.project(kind)))
    }
    // Rust: crates/jet-foundation/src/Facts.rs:42
    pub fn iter(self) -> [ShapeFact] Never! {
        keys := self.facts.keys().to_list()
        &keys.sort()
        keys.map(identity -> self.facts.get(identity) ?? panic("shape fact disappeared"))
    }
    // Rust: crates/jet-foundation/src/Facts.rs:46
    pub fn len(self) -> Int Never! { self.facts.len() }
    // Rust: crates/jet-foundation/src/Facts.rs:50
    pub fn is_empty(self) -> Bool Never! { self.facts.is_empty() }
    pub fn default() -> ShapeFactRegistry Never! { ShapeFactRegistry{facts: [:]} }
}

// Rust: crates/jet-foundation/src/Facts.rs:55
// EFFECT_ROOTS/EFFECT_SOURCE remain at canonical Foundation Authority owner.
// Rust: crates/jet-foundation/src/Facts.rs:62
// BuildStamp and default (70) remain Foundation Facts/BuildStamp.jet.
// Rust: crates/jet-foundation/src/Facts.rs:85
// TargetDossier is the canonical MIRTargetDossier; default (111) is already in
// Foundation Facts/BuildSnapshot.jet.
impl MIRTargetDossier {
    // Rust: crates/jet-foundation/src/Facts.rs:127
    pub fn new(layer: MIRRuntimeLayer, provider_identity: String, closure_identity: String) -> MIRTargetDossier Never! {
        dossier := MIRTargetDossier.default()
        dossier.layer = layer
        dossier.provider_identity = provider_identity
        dossier.closure_identity = closure_identity
        dossier
    }
    // Rust: crates/jet-foundation/src/Facts.rs:145
    pub fn append_cache_bytes(self, target_triple: String, bytes: &[U8]) Never! {
        mir_digest_append_target_dossier_bytes(self, target_triple, &bytes)
    }
    // Rust: crates/jet-foundation/src/Facts.rs:177
    pub fn cache_bytes(self, target_triple: String) -> [U8] Never! {
        mir_digest_target_dossier_bytes(self, target_triple)
    }
}
// Rust: crates/jet-foundation/src/Facts.rs:185
// append_cache_frame is canonical mir_digest_bytes in MIR/Digest/Digest.jet:
// little-endian u64 byte length followed by the original bytes.
// Rust: crates/jet-foundation/src/Facts.rs:193
// BuildFactSnapshot/BuildSettingFact/BuildFactValue remain Foundation
// Facts/BuildSnapshot.jet; reuse their typed setting and dossier carriers.
impl BuildFactSnapshot {
    // Rust: crates/jet-foundation/src/Facts.rs:230
    pub fn default() -> BuildFactSnapshot Never! {
        // GATE #4494/#4483: native host capture; no hard-coded OS or triple.
        BuildFactSnapshot.for_host(MIROSTarget.host(), jet_target_layout_host_triple())
    }
    // Rust: crates/jet-foundation/src/Facts.rs:250
    pub fn script(file: OSPath, os: MIROSTarget, profile: String) -> BuildFactSnapshot Never! {
        // GATE #4494: native file_stem and lossless UTF-8 conversion.
        stem :: file.file_stem().and_then(name -> name.to_str())
        package_name :: if stem == { .Val(name) -> if name.is_empty() -> "script" else -> name else -> "script" }
        snapshot := BuildFactSnapshot.for_host(os, jet_target_layout_host_triple())
        snapshot.package_name = package_name
        snapshot.profile = profile
        snapshot
    }
    // Rust: crates/jet-foundation/src/Facts.rs:273
    pub fn with_target_dossier(self, target_dossier: MIRTargetDossier) -> BuildFactSnapshot Never! {
        snapshot := self
        snapshot.target_dossier = target_dossier
        snapshot
    }
    // Rust: crates/jet-foundation/src/Facts.rs:278
    pub fn append_artifact_identity_bytes(self, bytes: &[U8]) BuildFactSnapshotIdentityError! {
        build_snapshot_append_artifact_identity_bytes(self, &bytes)
    }
    // Rust: crates/jet-foundation/src/Facts.rs:289
    pub fn rejects_debug_traces(self) -> Bool Never! {
        self.artifact_build || self.profile == BUILD_PROFILE_RELEASE || self.profile == BUILD_PROFILE_HARDENED
    }
    // Rust: crates/jet-foundation/src/Facts.rs:296
    pub fn artifact_identity_bytes(self) -> [U8] BuildFactSnapshotIdentityError! {
        build_snapshot_artifact_identity_bytes(self)
    }
    // Rust: crates/jet-foundation/src/Facts.rs:302
    pub fn contribution(self, name: String) -> EffectiveFact? Never! { self.contributions.get(name) }
    // Rust: crates/jet-foundation/src/Facts.rs:307
    pub fn setting_value(self, name: String) -> BuildFactValue? Never! { self.settings.get(name).map(setting -> setting.value) }
    // Rust: crates/jet-foundation/src/Facts.rs:311
    pub fn setting(self, key: String) -> BuildSettingFact? Never! { self.settings.get(key) }
    // Rust: crates/jet-foundation/src/Facts.rs:316
    pub fn value(self, read: FactRead) -> BuildFactValue? Never! {
        if read == {
            .BuildPackageName -> Val(BuildFactValue.Text(self.package_name))
            .BuildPackageVersion -> Val(BuildFactValue.Text(self.package_version))
            .BuildOS -> Val(BuildFactValue.Text(self.os.name()))
            .BuildProfile -> Val(BuildFactValue.Text(self.profile))
            .BuildStampGit -> Val(BuildFactValue.OptionalText(self.stamp.git))
            .BuildStampDirty -> Val(BuildFactValue.Bool(self.stamp.dirty))
            .BuildStampToolchain -> Val(BuildFactValue.Text(self.stamp.toolchain))
            .BuildStampAt -> Val(BuildFactValue.Text(self.stamp.at))
            else -> None
        }
    }
}

