pub fn checked_source_file(path: &OSPath, display: String) -> Result<(AuthorityResolver, CheckedFile, String), LoaderError> {
    parent :: path.parent().unwrap_or(OSPath.new("."))
    resolver :: AuthorityResolver.open(parent).map_err(fn(error) { LoaderError.at(display, "", [error.diagnostic()]) })?
