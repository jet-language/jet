                            Ok(raw) -> raw
                            Err(error) -> { return Err(record_loader_error(&sink, LoaderError.at(lock_path.display().to_string(), "", [error.diagnostic()]))) }
                        }
                        resolver.revalidate_file(&lock_file).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(lock_path.display().to_string(), &lock_raw, [error.diagnostic()])) })?
                        if Lock.parse_with_path(&lock_raw, &lock_path) == {
                            Ok(lock) -> {
                                if Lock.verify_lock_matches_manifest(&lock, &mf, lock_path.display().to_string()) is Err(d) {
                                    return Err(record_loader_error(&sink, LoaderError.at(lock_path.display().to_string(), &lock_raw, [d])))
                                }
                            }
                            Err(diagnostic) -> { return Err(record_loader_error(&sink, LoaderError.at(lock_path.display().to_string(), &lock_raw, [diagnostic]))) }
                        }
                        resolver.revalidate_file(&lock_file).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(lock_path.display().to_string(), &lock_raw, [error.diagnostic()])) })?
                    }
                    if dry_resolve_path_deps(&mf, &manifest_dir) is Err(d) {
                        return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [d])))
                    }
                }
                for pkg in &package_manifest.packages {
                    if Package.discover_module_in(&manifest_dir, &pkg.name) == {
                        Ok(_) -> {}
                        Err(Package.DiscoveryError.NotFound { name }) -> {
                            return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [Manifest.e1212(pack_path.display().to_string(), &name)])))
                        }
                        Err(Package.DiscoveryError.Ambiguous { name, paths }) -> {
                            return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [Manifest.e1213(pack_path.display().to_string(), &name, &paths)])))
                        }
                    }
                }
                dep_dirs :: if collect_dep_dirs(&mf, &manifest_dir) == {
                    Ok(dep_dirs) -> dep_dirs
                    Err(diagnostics) -> { return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, diagnostics))) }
                }
                resolution :: collect_pkg_resolution(&package_manifest).map_err(fn(diagnostic) { record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [diagnostic])) })?
                mut policy := organization_policy.clone()
                package_guarantees :: package_guarantees_for_manifest(&package_manifest)
                // Rust uses ordered output/default maps: preserve their key order.
                output_addresses :: package_manifest.outputs.keys().cloned().collect::<[String]>().sorted()
                package_output_declarations :: output_addresses.iter().filter_map(fn(address) {
                    output :: &package_manifest.outputs[address]
                    selected :: package_manifest.entry_path(&manifest_dir, output).ok().flatten()?
                    if selected != entry_abs { return Nil }
                    entry :: output.entry.clone()?
                    kind :: if &output.kind == {
                        .Library -> OutputKind.Library .Executable -> OutputKind.Executable .Service -> OutputKind.Service
                        .Check -> OutputKind.Check .Environment -> OutputKind.Environment .Image -> OutputKind.Image
                        .Bundle -> OutputKind.Bundle .System -> OutputKind.System .Fleet -> OutputKind.Fleet
                    }
                    Val((address.clone(), output.name.clone(), kind, entry))
                }).collect::<[(String, String, OutputKind, String)]>()
                default_names :: package_manifest.defaults.keys().cloned().collect::<[String]>().sorted()
                package_defaults :: default_names.iter().map(fn(name) { (name.clone(), package_manifest.defaults[name].clone()) }).collect::<[(String, String)]>()
                package_output_roots :: package_output_declarations.iter().filter_map(fn((_, _, _, entry)) { entry.split('.').next() })
                    .filter(fn(root) { !root.is_empty() }).map(fn(root) { root.to_owned() }).collect::<HashSet<String>>()
                package_lints_deny :: package_manifest.policy.lints_deny.unwrap_or_default()
                policy.extend(package_manifest.policy.declarations)
                source :: pack_path.display().to_string()
                for declaration in policy.iter_mut().filter(fn(declaration) { declaration.scope == Policy.PolicyScope.Package }) { declaration.source = source.clone() }
                resolver.revalidate_file(&checked.file).map_err(fn(error) { record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [error.diagnostic()])) })?
                mut dependency_boundary_policies := dep_dirs.values().filter_map(fn(dependency) { dependency.boundary_policy.clone() }).collect::<[ImportBoundaryPolicy]>()
                dependency_boundary_policies.sort_by(fn(left, right) { left.package.cmp(&right.package).then_with(fn() { left.source_root.cmp(&right.source_root) }) })
                mut boundary_policies := [ImportBoundaryPolicy.from_manifest(&mf, &manifest_dir)]
                boundary_policies.extend(dependency_boundary_policies)
                (manifest_dir, dep_dirs, resolution, policy, package_lints_deny, package_guarantees, package_output_roots,
                    package_output_declarations, package_defaults, package_manifest.allocator.clone(), boundary_policies)
            }
        }
    } else {
        // Rust: crates/jet-driver/src/Loader.rs:1792
        load_manifestless_context(&entry_abs, &entry_dir, inline_root, workspace_root, overlays,
            &organization_policy, &sink, &inline_dep_lints, &layer_ceiling, &package_edition)?
    }
    load_project_finish(entry_path, &entry_abs, project_root, pkg_dep_dirs, pkg_resolution, package_policy,
        package_lints_deny, package_guarantees, package_output_roots, package_output_declarations,
        package_defaults, program_allocator, boundary_policies, layer_ceiling, package_edition,
        inline_dep_lints, overlays, for_check, load_adjacent_unqualified, validates_project_parts,
        dependencies, prepared_frontend, &sink)
}
