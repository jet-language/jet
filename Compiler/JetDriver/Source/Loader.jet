//RS /// What the project's manifest + the shared hangar tell the module resolver
//RS /// about consuming packages with `use <pkg>` (U17).
//RS ///
//RS /// One import concept (S16) covers files, modules, and `library` packages: once
//RS /// a `library` is realized (its source staged in the hangar), `use <pkg>`
//RS /// resolves to that staged tree — it is just an extra module search root. An
//RS /// `executable` named in `use` is a teaching error (executables go on PATH,
//RS /// E0982); a declared-but-unrealized `library` dependency points the user at
//RS /// `jetpack env --prep` (E0983).
//RS #[derive(Default)]
//RS pub struct PkgResolution {
//RS     /// Realized `library` packages → their staged source dir in the hangar
//RS     /// (an extra module search root). The hangar is authoritative for the
//RS     /// realized kind: an empty-`bin` entry is a library (U10).
//RS     realized_libs: HashMap<String, PathBuf>,
//RS     /// The held authority for each realized library root. Module discovery
//RS     /// and subsequent file loads must use this handle, not reopen `out`.
//RS     realized_authorities: HashMap<String, AuthorityResolver>,
//RS     /// Realized `executable` packages (non-empty `bin`) by name — naming one in
//RS     /// `use` is E0982.
//RS     realized_exes: HashSet<String>,
//RS     /// Names this project declares as dependencies (`deps:`). A declared dep
//RS     /// that isn't realized yet is E0983 rather than an unknown-module error.
//RS     declared_deps: HashSet<String>,
//RS }
//RS 
//RS impl PkgResolution {
//RS     fn is_empty(&self) -> bool {
//RS         self.realized_libs.is_empty()
//RS             && self.realized_exes.is_empty()
//RS             && self.declared_deps.is_empty()
//RS     }
//RS }
