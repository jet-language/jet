// Rust: crates/jet-driver/src/Loader.rs:1231
fn load_entry_with_overlays_mode_on_stack(entry_path: String, overlays: &[(OSPath, String)], for_check: Bool, load_adjacent_unqualified: Bool, dependencies: &[OSPath], mut prepared_frontend: (&PreparedFrontend)?, mut sink: (&[LoaderDiagnostic])?) -> Result<ProgramBundle, [Diagnostic]> {
    boot_mir_eval()
    entry :: OSPath.from(entry_path)
    cwd :: env.current_dir().unwrap_or_else(fn(_) { OSPath.from(".") })
    entry_abs :: normalize_path(&(if entry.is_absolute() -> entry else -> cwd.join(&entry)))
    entry_dir :: entry_abs.parent().map(normalize_path).unwrap_or_else(fn() { cwd.clone() })
    workspace_root :: if find_workspace_root_with_error(&entry_dir) == {
        Ok(root) -> root
        Err((_failure_root, error)) -> {
            diagnostic :: error.workspace_diagnostic()
            file :: if diagnostic.code == "E1334" -> if &error == {
                .Symlink(path) -> path.display().to_string()
                _ -> entry_abs.display().to_string()
