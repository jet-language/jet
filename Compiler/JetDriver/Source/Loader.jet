pub struct LoaderDiagnostic { pub file: String, pub source: String, pub diagnostic: Diagnostic, pub structure_fact: StructureFact? }
// Rust: crates/jet-driver/src/Loader.rs:504
#Error
pub struct LoaderError { pub diagnostics: [LoaderDiagnostic] }
impl LoaderError {
    // Rust: crates/jet-driver/src/Loader.rs:509
    pub fn at(file: String, source: String, diagnostics: [Diagnostic]) -> Self {
        Self { diagnostics: diagnostics.into_iter().map(fn(diagnostic) {
            LoaderDiagnostic { file: file.to_string(), source: source.to_string(), diagnostic, structure_fact: Nil }
        }).collect() }
    }
    // Rust: crates/jet-driver/src/Loader.rs:523
    pub fn with_structure_fact(mut self: Self, fact: StructureFact?) -> Self {
        if fact is Val(fact) {
            if self.diagnostics.first_mut() is Val(diagnostic) { diagnostic.structure_fact = Val(fact) }
        }
        self
    }
    // Rust: crates/jet-driver/src/Loader.rs:535
    pub fn with_module_origin(mut self: Self, display: String, path: &OSPath) -> Self {
        // GATE #4494: the shared diagnostic origin uses the canonical Arc carrier.
        mut origin: Arc<DiagnosticOrigin>? := Nil
        for entry in &self.diagnostics {
            if entry.file != display || entry.source.is_empty() || entry.diagnostic.origin().is_some() { continue }
            shared :: origin.get_or_insert_with(fn() { Arc.new(DiagnosticOrigin.new(display, path.to_string_lossy().into_owned(), entry.source.clone())) }).clone()
            entry.diagnostic.set_origin(shared)
        }
        self
    }
    // Rust: crates/jet-driver/src/Loader.rs:558
    pub fn into_plain(self: Self) -> [Diagnostic] { self.diagnostics.into_iter().map(fn(entry) { entry.diagnostic }).collect() }
}
