// Rust: crates/jet-driver/src/Loader.rs:845
pub fn import_edge_fact(policies: &[ImportBoundaryPolicy], from_module: &LoadedModule, to_module: &LoadedModule, span: Span, status: String, detail: String, gate: String?) -> StructureFact? {
    from_index :: boundary_policy_index(policies, &from_module.path)?
    to_index :: boundary_policy_index(policies, &to_module.path)?
    from_policy :: &policies[from_index]
    from_name :: from_policy.module_name(&from_module.path, &from_module.items)
    to_name :: policies[to_index].module_name(&to_module.path, &to_module.items)
    Val(StructureFact.new(StructureFactKind.ImportEdge, "{from_name} -> {to_name}", from_module.display.clone(), span, status, detail, gate))
}
// Rust: crates/jet-driver/src/Loader.rs:874
pub fn record_import_edge_fact(policies: &[ImportBoundaryPolicy], from_module: &LoadedModule, to_module: &LoadedModule, span: Span, ledger: &NameLedger) -> Unit {
    from_index :: boundary_policy_index(policies, &from_module.path) ?? return
    _to_index :: boundary_policy_index(policies, &to_module.path) ?? return
    from_policy :: &policies[from_index]
    policy_checked :: !from_policy.deny.is_empty()
    fact :: import_edge_fact(policies, from_module, to_module, span,
        if policy_checked -> "allowed" else -> "resolved",
        if policy_checked -> "manifest boundary policy checked" else -> "resolved import edge",
        if policy_checked -> Val("manifest rule edit") else -> Nil).expect("boundary policy indexes were checked above")
    ledger.record_structure_fact(fact)
}
// Rust: crates/jet-driver/src/Loader.rs:921
fn verify_realized_store_entry(roots: &Store.Roots, entry: &Store.StoreEntry) -> Result<Unit, Diagnostic> {
    expected := entry.envelope.output_hash.trim() // #4303
    if expected.is_empty() {
        return Err(Diagnostic.error("E1206", "realized package `{entry.name}` has no output hash",
            "the immutable Hangar object cannot be admitted without its recorded content identity",
            "repair the shared package store before loading the project", Nil))
    }
    actual :: Envelope.try_output_hash_of_in_hangar(&entry.out, &roots.hangar_dir(), false).map_err(fn(error) {
        Diagnostic.error("E1206", "realized package `{entry.name}` failed integrity verification", error,
            "repair the shared package store before loading the project", Nil)
    })?
    if actual != expected {
        return Err(Diagnostic.error("E1206", "realized package `{entry.name}` failed integrity verification",
            "the immutable Hangar object hash does not match its record (expected {expected}, got {actual})",
            "repair the shared package store before loading the project", Nil))
    }
    Ok(())
}
// Rust: crates/jet-driver/src/Loader.rs:964
pub fn collect_pkg_resolution(facts: &Package.PackageFacts) -> Result<PkgResolution, Diagnostic> {
    mut declared_deps := HashSet.new()
    mut hangar_deps := HashSet.new()
    for (name, source) in &facts.deps {
        if source == { .CLib { .. } | .Foreign { .. } -> true _ -> false } { continue }
        declared_deps.insert(name.clone())
        if !(source == { .Provider { provider: RefSpec.Source.Path, .. } -> true _ -> false }) { hangar_deps.insert(name.clone()) }
    }
    // Packages without Hangar dependencies must not read the machine-wide store.
    if hangar_deps.is_empty() { return Ok(PkgResolution { declared_deps }) }
    mut realized_libs := [:]
    mut realized_authorities := [:]
    mut realized_exes := HashSet.new()
    roots :: Store.resolve()
    entries :: Store.list_checked(&roots).map_err(fn(error) {
        Diagnostic.error("E1206", "could not read the verified package store", error.to_string(),
            "repair the shared package store metadata before loading the project", Nil)
    })?
    for entry in entries {
        if !hangar_deps.contains(&entry.name) { continue }
        if entry.bin.is_empty() {
            out :: OSPath.from(&entry.out)
            if !realized_libs.contains_key(&entry.name) {
                verify_realized_store_entry(&roots, &entry)?
                authority :: if AuthorityResolver.open_store(&out) == {
                    Ok(authority) -> authority
                    Err(error) -> { if error.is_missing() { continue }; return Err(error.diagnostic()) }
                }
                root :: authority.root().to_path_buf()
                realized_libs.insert(entry.name.clone(), root)
                realized_authorities.insert(entry.name.clone(), authority)
            }
        } else { realized_exes.insert(entry.name.clone()) }
    }
    Ok(PkgResolution { realized_libs, realized_authorities, realized_exes, declared_deps })
}
