// Rust: crates/jet-driver/src/Loader.rs:43
// Root facts alone enter the shared guarantee carrier; dependencies do not inherit policy.
pub fn package_guarantees_for_manifest(package_manifest: &Package.PackageFacts) -> PackageGuarantees {
    memory_denials :: package_manifest.authority.holds.deny.clone().unwrap_or_default().into_iter()
        .filter(fn(name) { name == "Mem.Rc" || Sema.memory_allocation_bound(name).is_some() }).collect()
    PackageGuarantees {
        contain: package_manifest.policy.contain.clone(), harden: package_manifest.policy.harden,
        dependency_names: package_manifest.deps.keys().cloned().collect(), effects: package_manifest.policy.effects.clone(),
        unsafe_paths: package_manifest.policy.unsafe_paths.clone(), expert: package_manifest.policy.expert,
        deps: package_manifest.policy.deps.clone(), lints_deny: package_manifest.policy.lints_deny.clone(),
        memory_denials, authority_needs: package_manifest.authority.needs.clone(),
        application_authority: ApplicationAuthority.from_policy(package_manifest.authority.holds.allow.as_deref(),
            package_manifest.authority.holds.deny.as_deref(), "{package_manifest.origin} authority.holds")
    }
}
// Rust: crates/jet-driver/src/Loader.rs:81
pub fn complete_inline_package_facts(facts: &Package.PackageFacts, source_root: &OSPath) -> Result<Unit, Package.PackageParseError> {
    facts.compose_configs(source_root)?
    facts.validate_guarantees()?
    facts.validate_defaults().map_err(fn(error) { Package.PackageParseError.Composition(error.to_string()) })?
    facts.validate_members_in(source_root)
}
// Rust: crates/jet-driver/src/Loader.rs:92
#Error
pub struct InlineLockFailure { pub path: OSPath, pub raw: String, pub diagnostic: Diagnostic }
// Rust: crates/jet-driver/src/Loader.rs:101
pub fn verify_inline_manifest_lock(package_root: &OSPath, manifest: &Manifest.Manifest) -> Result<Unit, InlineLockFailure> {
    if manifest.dependencies.is_empty() { return Ok(()) }
    resolver :: AuthorityResolver.open(package_root).map_err(fn(error) {
        InlineLockFailure { path: package_root.clone(), raw: "", diagnostic: error.diagnostic() }
    })?
    lock_file :: if resolver.checked_file(OSPath.new(Syntax.UNIFIED_LOCK_FILE)) == {
        Ok(file) -> file
        Err(error) -> {
            if error.is_missing() { return Ok(()) }
            return Err(InlineLockFailure { path: package_root.clone(), raw: "", diagnostic: error.diagnostic() })
        }
    }
    path :: lock_file.path.clone()
    raw :: lock_file.text().map_err(fn(error) { InlineLockFailure { path: path.clone(), raw: "", diagnostic: error.diagnostic() } })?
    resolver.revalidate_file(&lock_file).map_err(fn(error) {
        InlineLockFailure { path: path.clone(), raw: raw.clone(), diagnostic: error.diagnostic() }
    })?
    lock :: Lock.parse_with_path(&raw, &path).map_err(fn(diagnostic) {
        InlineLockFailure { path: path.clone(), raw: raw.clone(), diagnostic }
    })?
    Lock.verify_lock_matches_manifest(&lock, manifest, path.display().to_string()).map_err(fn(diagnostic) {
        InlineLockFailure { path: path.clone(), raw: raw.clone(), diagnostic }
    })?
    resolver.revalidate_file(&lock_file).map_err(fn(error) {
        InlineLockFailure { path, raw, diagnostic: error.diagnostic() }
    })?
    Ok(())
}

// Rust: crates/jet-driver/src/Loader.rs:169
pub fn package_facts_for_bundle(bundle: &ProgramBundle) -> Result<Package.PackageFacts?, [Diagnostic]> {
    manifest_root :: find_manifest_root_checked(&bundle.project_root).map_err(fn(diagnostic) { [diagnostic] })?
    entry :: bundle.modules.get(bundle.entry)
    inline :: if entry == {
        Val(module) -> Package.extract_inline_package(&module.source).map_err(fn(error) { [error.diagnostic()] })?
        Nil -> Nil
    }
    if inline is Val(block) {
        if manifest_root.is_some() {
            return Err([Diagnostic.error("E1363", "an inline Package conflicts with package.jet",
                "one project cannot carry both an inline Package block and a package.jet manifest",
                "remove package.jet or remove the inline Package block", Val(block.span))])
        }
        module :: entry.expect("inline package block has an entry module")
        mut facts := Package.PackageFacts.parse_uncomposed(block.body(&module.source), module.display.clone()).map_err(fn(error) {
            [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(),
                "fix the inline Package fields, then retry", Val(block.body_span))]
        })?
        source_root :: module.path.parent().unwrap_or(OSPath.new("."))
        complete_inline_package_facts(&facts, source_root).map_err(fn(error) {
            [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(),
                "fix the inline Package fields, then retry", Val(block.body_span))]
        })?
        return Ok(Val(facts))
    }
    if find_inline_package_root_checked(&bundle.project_root).map_err(fn(diagnostic) { [diagnostic] })? is Val(inline_root) {
        if manifest_root.is_some() { return Err(inline_manifest_conflict_loader_error(&inline_root).into_plain()) }
        return package_facts_for_root(&inline_root)
    }
    root :: manifest_root ?? return Ok(Nil)
    Package.PackageFacts.load_checked(&root).map_err(fn(error) { [error.diagnostic()] })
}
// Rust: crates/jet-driver/src/Loader.rs:242
pub fn package_facts_for_entry(entry: &OSPath) -> Result<Package.PackageFacts?, [Diagnostic]> {
    source :: fs.read_to_string(entry).map_err(fn(error) {
        [Diagnostic.error("E1331", "entry `{entry.display()}` cannot be read", error.to_string(), "restore the entry source, then retry", Nil)]
    })?
    entry_root :: entry.parent().unwrap_or(OSPath.new("."))
    manifest_root :: find_manifest_root_checked(entry_root).map_err(fn(diagnostic) { [diagnostic] })?
    inline_root :: find_inline_package_root_checked(entry_root).map_err(fn(diagnostic) { [diagnostic] })?
    facts :: package_facts_from_entry_source(entry, &source, manifest_root.clone())?
    if manifest_root.is_some() && inline_root.is_some() {
        return Err(inline_manifest_conflict_loader_error(inline_root.as_ref().expect("inline root")).into_plain())
    }
    if facts.is_some() || inline_root.is_none() { return Ok(facts) }
    package_facts_for_root(&inline_root.expect("inline root checked above"))
}
// Rust: crates/jet-driver/src/Loader.rs:272
fn package_facts_from_entry_source(entry: &OSPath, source: String, manifest_root: OSPath?) -> Result<Package.PackageFacts?, [Diagnostic]> {
    inline :: Package.extract_inline_package(source).map_err(fn(error) { [error.diagnostic()] })?
    if inline is Val(block) {
        if manifest_root.is_some() {
            return Err([Diagnostic.error("E1363", "an inline Package conflicts with package.jet",
                "one project cannot carry both an inline Package block and a package.jet manifest",
                "remove package.jet or remove the inline Package block", Val(block.span))])
        }
        mut facts := Package.PackageFacts.parse_uncomposed(block.body(source), entry.display().to_string()).map_err(fn(error) {
            [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(), "fix the inline Package fields, then retry", Val(block.body_span))]
        })?
        source_root :: entry.parent().unwrap_or(OSPath.new("."))
        complete_inline_package_facts(&facts, source_root).map_err(fn(error) {
            [Diagnostic.error("E1362", "the inline Package body is malformed", error.to_string(), "fix the inline Package fields, then retry", Val(block.body_span))]
        })?
        return Ok(Val(facts))
    }
    root :: manifest_root ?? return Ok(Nil)
    Package.PackageFacts.load_checked(&root).map_err(fn(error) { [error.diagnostic()] })
}
// Rust: crates/jet-driver/src/Loader.rs:323
fn inline_manifest_conflict_loader_error(root: &OSPath) -> LoaderError {
    result :: (fn() -> Result<LoaderError, Diagnostic> {
        resolver :: AuthorityResolver.open(root).map_err(fn(error) { error.diagnostic() })?
        carrier :: checked_inline_package_entry(&resolver)?.ok_or_else(fn() {
            Diagnostic.error("E1363", "an inline Package conflicts with package.jet",
                "one project cannot carry both an inline Package block and a package.jet manifest",
                "remove package.jet or remove the inline Package block", Nil)
        })?
        source :: carrier.text().map_err(fn(error) { error.diagnostic() })?
        block :: Package.extract_inline_package(&source).map_err(fn(error) { error.diagnostic() })?.ok_or_else(fn() {
            Diagnostic.error("E1363", "an inline Package conflicts with package.jet",
                "one project cannot carry both an inline Package block and a package.jet manifest",
                "remove package.jet or remove the inline Package block", Nil)
        })?
        Ok(LoaderError.at(carrier.path.display().to_string(), &source, [Diagnostic.from_row("E1363", [], Val(block.span))]))
    })()
    if result == {
        Ok(error) -> error
        Err(diagnostic) -> LoaderError.at(root.display().to_string(), "", [diagnostic])
    }
}
// Rust: crates/jet-driver/src/Loader.rs:365
pub fn package_facts_for_root(root: &OSPath) -> Result<Package.PackageFacts?, [Diagnostic]> {
    resolver :: AuthorityResolver.open(root).map_err(fn(error) { [error.diagnostic()] })?
    manifest_root :: find_manifest_root_checked(resolver.root()).map_err(fn(diagnostic) { [diagnostic] })?
    entry :: checked_inline_package_entry(&resolver).map_err(fn(diagnostic) { [diagnostic] })?
    if entry.is_none() {
        manifest :: manifest_root ?? return Ok(Nil)
        return Package.PackageFacts.load_checked(&manifest).map_err(fn(error) { [error.diagnostic()] })
    }
    entry :: entry.unwrap()
    source :: entry.text().map_err(fn(error) { [error.diagnostic()] })?
    facts :: package_facts_from_entry_source(&entry.path, &source, manifest_root)?
    resolver.revalidate_file(&entry).map_err(fn(error) { [error.diagnostic()] })?
    Ok(facts)
}
// Rust: crates/jet-driver/src/Loader.rs:389
pub fn package_facts_from_resolver(resolver: &AuthorityResolver) -> Result<Package.PackageFacts?, [Diagnostic]> {
    if resolver.checked_root_package() == {
        Ok(package) -> Ok(Val(package.facts))
        Err(error) -> if error.is_missing() -> Ok(Nil) else -> Err([error.diagnostic()])
    }
}
// Rust: crates/jet-driver/src/Loader.rs:399
pub fn prepare_frontend_module(source: String) -> PreparedFrontendModule {
    source_for_parse :: if Package.mask_inline_package_source(source) == {
        Ok((masked, _)) -> masked
        Err(error) -> { return .LexFailed([error.diagnostic()]) }
    }
    (tokens, lex_diags) :: Lexer.lex(&source_for_parse)
    if !lex_diags.is_empty() { return .LexFailed(lex_diags) }
    if Parser.parse_for_check_with_source(&tokens, &source_for_parse) == {
        Ok((program, teaching)) -> .Parsed(program, teaching)
        Err(diagnostics) -> .ParseFailed(diagnostics)
    }
}
// Rust: crates/jet-driver/src/Loader.rs:414
fn frontend_worker_count(job_count: USize) -> USize {
    // GATE #4494: native thread parallelism.
    available :: thread.available_parallelism().map(fn(value) { value.get() }).unwrap_or(1)
    job_count.min(available).min(MAX_FRONTEND_WORKERS).max(1)
}
// Rust: crates/jet-driver/src/Loader.rs:424
fn prepare_overlay_frontend(overlays: &[(OSPath, String)]) -> PreparedFrontend {
    sources :: overlays.iter().map(fn((path, source)) { (normalize_path(path), source.to_string()) }).collect::<[(OSPath, String)]>()
    prepare_frontend_sources(sources)
}
// Rust: crates/jet-driver/src/Loader.rs:435
pub fn prepare_frontend_sources(sources: [(OSPath, String)]) -> PreparedFrontend {
    mut sources := sources.into_iter().map(fn((path, source)) { (normalize_path(&path), source) }).collect::<[OSPath: String]>()
    mut jobs := sources.drain().collect::<[(OSPath, String)]>()
    jobs.sort_by(fn(left, right) { left.0.cmp(&right.0) })
    if jobs.is_empty() { return [:] }
    workers :: frontend_worker_count(jobs.len())
    // GATE #4494: scoped workers, atomic work index and mpsc result publication.
    next :: atomic.AtomicUsize.new(0)
    (sender, receiver) :: mpsc.channel()
    results :: thread.scope(fn(scope) {
        jobs_ref :: &jobs
        next_ref :: &next
        for _ in 0..workers {
            sender :: sender.clone()
            terminator_driver :: Lexer.terminator_driver()
            _worker :: thread.Builder.new().name("jet-frontend").stack_size(COMPILER_STACK_SIZE)
                .spawn_scoped(scope, fn() {
                    Lexer.with_terminator_driver(terminator_driver, fn() {
                        run_compiler_work(fn() {
                            loop {
                                index :: next_ref.fetch_add(1, atomic.Ordering.Relaxed)
                                (_, source) :: jobs_ref.get(index) ?? break
                                prepared :: prepare_frontend_module(source)
                                sender.send((index, prepared)).expect("frontend result receiver remains in scope")
                            }
                        })
                    })
                }).unwrap_or_else(fn(error) {
                    jet_foundation.ice(Nil, "could not start frontend worker: {error}")
                })
        }
        drop(sender)
        mut results: [PreparedFrontendModule?] := (0..jobs.len()).map(fn(_) { Nil }).collect()
        for (index, prepared) in receiver { results[index] = Val(prepared) }
        results
    })
    jobs.into_iter().zip(results).filter_map(fn(((path, source), prepared)) {
        prepared.map(fn(module) { (path, PreparedFrontendEntry { source, module }) })
    }).collect()
}
