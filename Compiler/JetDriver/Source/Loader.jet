//RS     dependencies: &mut Vec<PathBuf>,
//RS     prepared_frontend: Option<&mut PreparedFrontend>,
//RS     sink: Option<&mut Vec<LoaderDiagnostic>>,
//RS ) -> Result<ProgramBundle, Vec<Diagnostic>> {
