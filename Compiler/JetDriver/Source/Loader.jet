// Rust: crates/jet-driver/src/Loader.rs:1052
pub fn load_entry_with_diagnostics(entry_path: String) -> Result<ProgramBundle, [LoaderDiagnostic]> {
    boot_mir_eval()
    (result, _, mut diagnostics) :: load_entry_with_overlays_and_dependencies_with_diagnostics(entry_path, [], false)
    if result == {
        Ok(bundle) -> Ok(bundle)
        Err(fallback) -> {
            if diagnostics.is_empty() {
                source :: checked_source_file(OSPath.new(entry_path), entry_path).ok().map(fn((_, _, source)) { source }).unwrap_or_default()
                diagnostics.extend(fallback.into_iter().map(fn(diagnostic) { LoaderDiagnostic { file: entry_path.to_string(), source: source.clone(), diagnostic, structure_fact: Nil } }))
            }
            Err(diagnostics)
        }
    }
}
