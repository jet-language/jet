            }
            Err(error) -> { return Err(record_loader_error(&sink, LoaderError.at(entry_abs.display().to_string(), &entry_source, [error.diagnostic()]))) }
        }
        package_manifest :: if Package.PackageFacts.parse_uncomposed(&raw, pack_path.display().to_string()) == {
