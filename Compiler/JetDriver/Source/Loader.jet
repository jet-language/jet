// Rust: crates/jet-driver/src/Loader.rs:606
// GATE #4494: checked source reads and revalidation use retained descriptor authority.
pub fn checked_source_file_with_resolver(path: &OSPath, display: String, resolver: &AuthorityResolver) -> Result<(AuthorityResolver, CheckedFile, String), LoaderError> {
    relative :: path.strip_prefix(resolver.root()).map_err(fn(_) {
        LoaderError.at(display, "", [AuthorityError.Escapes(path.clone()).diagnostic()])
    })?
    _name :: path.file_name().ok_or_else(fn() { LoaderError.at(display, "", [missing_source_diagnostic(display)]) })?
    checked :: resolver.checked_file(relative).map_err(fn(error) {
        diagnostic :: if error.is_missing() -> missing_source_diagnostic(display) else -> error.diagnostic()
        LoaderError.at(display, "", [diagnostic])
    })?
    source :: checked.text().map_err(fn(error) { LoaderError.at(display, "", [error.diagnostic()]) })?
    resolver.revalidate_file(&checked).map_err(fn(error) { LoaderError.at(display, &source, [error.diagnostic()]) })?
    Ok((resolver.clone(), checked, source))
}
// Rust: crates/jet-driver/src/Loader.rs:644
pub fn project_parts_loader_error(project_root: &OSPath, conflicts: &[ProjectParts.ProjectPartConflict]) -> LoaderError {
    diagnostics :: conflicts.iter().map(fn(conflict) {
        path :: conflict.paths.first().cloned()
        (file, source) :: path.as_ref().and_then(fn(path) {
            checked_source_file(path, relative_display(project_root, path)).ok().map(fn((_, _, source)) { (path, source) })
        }).map(fn((path, source)) { (relative_display(project_root, path), source) })
            .unwrap_or_else(fn() { (project_root.display().to_string(), "") })
        LoaderDiagnostic { file, source, diagnostic: conflict.diagnostic(project_root, Nil), structure_fact: Nil }
    }).collect()
    LoaderError { diagnostics }
}
// Rust: crates/jet-driver/src/Loader.rs:675
pub fn authority_failure_file(project_root: &OSPath, failure: &ProjectParts.ProjectPartScanFailure) -> String {
    fallback :: relative_display(project_root, &failure.path)
    if failure.problem.code != "E1334" { return fallback }
    resolver :: AuthorityResolver.open(&failure.path).ok() ?? return fallback
    error :: if resolver.discover_source_files() == {
        Ok(_) -> { return fallback }
        Err(error) -> error
    }
    diagnostic :: error.diagnostic()
    if diagnostic.code != failure.problem.code || diagnostic.what != failure.problem.what { return fallback }
    path :: if &error == {
        .Missing(path) | .Symlink(path) | .AmbiguousManifest(path) | .RetiredManifest(path) | .Escapes(path) | .Changed(path) -> Val(path)
        .ManifestParse { path, .. } | .Io { path, .. } | .WrongKind { path, .. } | .Invalid { path, .. } -> Val(path)
        .NestedMembers { member, .. } -> Val(member)
        .WorkspaceAmbiguous(paths) -> paths.first()
        .WorkspaceNoModule | .Unsupported(_) -> Nil
    }
    path.map(fn(path) { relative_display(project_root, path) }).unwrap_or(fallback)
}
