    }
    validates_project_parts :: manifest_root.is_some() || inline_root.is_some() || workspace_root.is_some() ||
        entry_abs.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) { name == Syntax.DEFAULT_ENTRY_FILE })
    mut layer_ceiling := Nil
    mut package_edition := Manifest.latest_edition().to_string()
    mut inline_dep_lints: [Diagnostic] := []
    organization_policy :: if load_organization_policy() == {
        Ok(policy) -> policy
        Err(error) -> { return Err(record_loader_error(&sink, error)) }
    }
    (project_root, pkg_dep_dirs, pkg_resolution, package_policy, package_lints_deny, package_guarantees,
        package_output_roots, package_output_declarations, package_defaults, program_allocator, boundary_policies) :: if manifest_root is Val(manifest_dir) {
        resolver :: if AuthorityResolver.open(&manifest_dir) == {
            Ok(resolver) -> resolver
            Err(error) -> { return Err(record_loader_error(&sink, LoaderError.at(manifest_dir.display().to_string(), "", [error.diagnostic()]))) }
        }
        checked :: if resolver.checked_manifest(OSPath.new(".")) == {
            Ok(checked) -> checked
            Err(error) -> { return Err(record_loader_error(&sink, LoaderError.at(manifest_dir.display().to_string(), "", [error.diagnostic()]))) }
        }
        pack_path :: checked.file.path.clone()
        raw :: if checked.file.text() == {
            Ok(raw) -> raw
            Err(error) -> { return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), "", [error.diagnostic()]))) }
        }
        entry_source :: if overlays.iter().rev().find(fn((path, _)) { normalize_path(path) == entry_abs }) is Val((_, text)) {
            text.to_string()
        } else {
            if checked_source_file_with_resolver(&entry_abs, entry_abs.display().to_string(), &resolver) == {
                Ok((_, _, source)) -> source
                Err(error) -> { return Err(record_loader_error(&sink, error)) }
            }
        }
        if Package.extract_inline_package(&entry_source) == {
            Ok(Val(block)) -> {
                return Err(record_loader_error(&sink, LoaderError.at(entry_abs.display().to_string(), &entry_source, [Diagnostic.from_row("E1363", [], Val(block.span))])))
            }
            Ok(Nil) -> {
