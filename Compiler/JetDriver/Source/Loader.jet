pub struct ImportBoundaryPolicy { pub package: String, pub source_root: OSPath, pub deny: [Package.ImportBoundary] }
impl ImportBoundaryPolicy {
    // Rust: crates/jet-driver/src/Loader.rs:757
    pub fn from_manifest(manifest: &Manifest.Manifest, source_root: &OSPath) -> Self {
        Self { package: manifest.package.name.clone(), source_root: normalize_path(source_root), deny: manifest.boundaries.clone() }
    }
    // Rust: crates/jet-driver/src/Loader.rs:765
    pub fn module_name(self: &Self, path: &OSPath, items: &[Item]) -> String {
        name :: items.iter().find_map(fn(item) { if item == { .Module(module) -> Val(module.name.as_str()) _ -> Nil } })
        if name is Val(name) {
            package_prefix :: "{self.package}."
            return if name == self.package || name.starts_with(&package_prefix) -> name.to_string() else -> "{self.package}.{name}"
        }
        path :: normalize_path(path)
        root :: normalize_path(&self.source_root)
        relative :: path.strip_prefix(&root).unwrap_or(path.as_path())
        mut parts := relative.components().filter_map(fn(component) { component.as_os_str().to_str() }).map(fn(text) { text.to_owned() }).collect::<[String]>()
        if parts.last_mut() is Val(last) {
            stem :: OSPath.new(last).file_stem().and_then(fn(stem) { stem.to_str() }).map(fn(text) { text.to_owned() })
            if stem is Val(stem) { last = stem }
        }
        if parts.len() > 1 && (parts.last() == Val("main") || parts.last() == Val("module")) { _ :: parts.pop() }
        [self.package.as_str()].into_iter().chain(parts.iter().map(fn(text) { text.as_str() })).collect::<[String]>().join(".")
    }
}
// Rust: crates/jet-driver/src/Loader.rs:804
fn boundary_policy_index(policies: &[ImportBoundaryPolicy], path: &OSPath) -> USize? {
    path :: normalize_path(path)
    policies.iter().enumerate().filter(fn((_, policy)) { path == policy.source_root || path.strip_prefix(&policy.source_root).is_ok() })
        .max_by_key(fn((_, policy)) { policy.source_root.components().count() }).map(fn((index, _)) { index })
}
// Rust: crates/jet-driver/src/Loader.rs:816
pub fn import_boundary_violation(policies: &[ImportBoundaryPolicy], from_module: &LoadedModule, to_module: &LoadedModule, span: Span) -> (USize, USize, Diagnostic)? {
    from_index :: boundary_policy_index(policies, &from_module.path)?
    to_index :: boundary_policy_index(policies, &to_module.path)?
    from_policy :: &policies[from_index]
    from_name :: from_policy.module_name(&from_module.path, &from_module.items)
    to_name :: policies[to_index].module_name(&to_module.path, &to_module.items)
    (rule_index, rule) :: from_policy.deny.iter().enumerate().find(fn((_, rule)) { rule.matches(&from_name, &to_name) })?
    rule_display :: "{rule.from} -> {rule.to}"
    diagnostic :: Diagnostic.from_row("E0619", [("from", &from_name), ("to", &to_name), ("rule", &rule_display)], Val(span))
