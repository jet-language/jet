                        "write memory floors as `authority: { holds: { deny: [Mem.Alloc, Mem.Rc, Mem.Alloc(above: 65536)] } }` in `package.jet`; keep `policy:` for non-memory settings", Nil)])))
            }
            Err(error @ Package.PackageParseError.RetiredPolicyField { .. }) -> {
                return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [Manifest.manifest_parse_diagnostic(&pack_path, &error)])))
            }
            Err(Package.PackageParseError.BadGuaranteePolicy { detail }) -> {
                return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw,
                    [Diagnostic.error("E1206", "invalid package guarantee policy", detail,
                        "use `policy: { contain: [\"dependency\"], harden: true }` in `package.jet`; these keys are package-only and tighten-only", Nil)])))
            }
            Err(Package.PackageParseError.BadAllocatorPolicy { detail }) -> {
                return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw,
                    [Diagnostic.error("E1206", "invalid hosted program allocator", detail,
                        "use `allocator: mem.Heap` or `allocator: mem.Counting.over(mem.Heap, cap: 2.gb)` in `package.jet`", Nil)])))
            }
            Err(error) -> {
                diagnostic :: if &error == {
                    Package.PackageParseError.Composition(detail) -> if detail.contains("is a diagnostic code") -> Manifest.manifest_parse_diagnostic(&pack_path, &error)
                        else -> Diagnostic.error("E1206", "invalid package manifest", error.to_string(), "fix the fields in package.jet before loading the project", Nil)
                    _ -> Diagnostic.error("E1206", "invalid package manifest", error.to_string(), "fix the fields in package.jet before loading the project", Nil)
                }
                return Err(record_loader_error(&sink, LoaderError.at(pack_path.display().to_string(), &raw, [diagnostic])))
