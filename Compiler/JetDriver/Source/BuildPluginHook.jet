// Driver-side packaged build-plugin bridge: sibling jetpack owns component hosting.
use jet_comptime.Comptime.Build.[decode_build_plugin_response, encode_build_plugin_request, PackagedPluginContribution, WasmComponentPluginSpec, BUILD_PLUGIN_HOST_SUBCOMMAND, BUILD_PLUGIN_MAX_REQUEST_BYTES, BUILD_PLUGIN_MAX_RESPONSE_BYTES]
use jet_foundation.Syntax
use std.io.[Read, Write, Error]
use std.process.[Command, Stdio]
use std.[thread, env]
use std.time.[Duration, Instant]

// Rust: crates/jet-driver/src/BuildPluginHook.rs:18
const MAX_HOST_STDERR_BYTES: USize = 64 * 1024
// Rust: crates/jet-driver/src/BuildPluginHook.rs:19
const HOST_TIMEOUT: Duration = Duration.from_secs(2)
// Rust: crates/jet-driver/src/BuildPluginHook.rs:21
pub fn run_packaged_build_plugin(manifest_path: &OSPath, component_path: &OSPath, spec: &WasmComponentPluginSpec, manifest_digest: &String) -> PackagedPluginContribution Err! {
    host := host_path()?
    command := Command.new(host)
    command.arg(BUILD_PLUGIN_HOST_SUBCOMMAND).arg(manifest_path).arg(component_path)
    command.arg(manifest_digest).arg(&spec.component_digest)
    request := encode_build_plugin_request(spec)
    response := run_host_process(command, request)?
    decode_build_plugin_response(&response)
}
// Rust: crates/jet-driver/src/BuildPluginHook.rs:39
fn host_path() -> OSPath Err! {
    // GATE #4494: actual current executable path; #4483 selected executable suffix.
    executable := env.current_exe().map_err(fn(error) { "couldn't resolve compiler executable: {error}" })?
    directory := executable.parent().ok_or_else(fn() { "compiler executable has no parent directory" })?
    suffix := if core.sys.target.selected_os() == "windows" { ".exe" } else { "" }
    binary := "{Syntax.JETPACK_BINARY_NAME}{suffix}"
    candidates := [directory.join(&binary)]
    if directory.file_name().is_some_and(fn(name) { name == "deps" }) { if directory.parent() == Val(parent) { candidates.push(parent.join(binary)) } }
    candidates.into_iter().find(fn(candidate) { candidate.is_file() }).ok_or_else(fn() { "packaged build-plugin host jetpack is missing beside Jet" })
}
// Rust: crates/jet-driver/src/BuildPluginHook.rs:62
fn run_host_process(command: Command, request: [U8]) -> [U8] Err! {
    if request.len() > BUILD_PLUGIN_MAX_REQUEST_BYTES { return Err("build-plugin request exceeds {BUILD_PLUGIN_MAX_REQUEST_BYTES} bytes") }
    // GATE #4494: native process pipes, real worker threads, waits, kills, monotonic clock.
    child := command.stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().map_err(fn(error) { "couldn't start build-plugin host: {error}" })?
    stdin := child.stdin.take().ok_or_else(fn() { "build-plugin host stdin is unavailable" })?
    stdout := child.stdout.take().ok_or_else(fn() { "build-plugin host stdout is unavailable" })?
    stderr := child.stderr.take().ok_or_else(fn() { "build-plugin host stderr is unavailable" })?
    writer := thread.spawn(fn() {
        result := stdin.write_all(&request)
        drop(^stdin)
        result
    })
    stdout_reader := thread.spawn(fn() { read_bounded(stdout, BUILD_PLUGIN_MAX_RESPONSE_BYTES) })
    stderr_reader := thread.spawn(fn() { read_bounded(stderr, MAX_HOST_STDERR_BYTES) })
    deadline := Instant.now() + HOST_TIMEOUT
    status := loop {
        child.try_wait() == {
            Ok(Val(status)) -> { break status }
            Ok(None) -> {
                if Instant.now() < deadline { thread.sleep(Duration.from_millis(5)) }
                else {
                    _ :: child.kill(); _ :: child.wait()
                    _ :: writer.join(); _ :: stdout_reader.join(); _ :: stderr_reader.join()
                    return Err("build-plugin host timed out after {HOST_TIMEOUT.as_millis()}ms")
                }
            }
            Err(error) -> {
                _ :: child.kill(); _ :: child.wait()
                _ :: writer.join(); _ :: stdout_reader.join(); _ :: stderr_reader.join()
                return Err("couldn't wait for build-plugin host: {error}")
            }
        }
    }
    write_result := writer.join().map_err(fn(_) { "build-plugin host input thread panicked" })?
    (stdout, stdout_overflow) := stdout_reader.join().map_err(fn(_) { "build-plugin host output thread panicked" })?.map_err(fn(error) { "couldn't read build-plugin host output: {error}" })?
    (stderr, stderr_overflow) := stderr_reader.join().map_err(fn(_) { "build-plugin host error thread panicked" })?.map_err(fn(error) { "couldn't read build-plugin host error: {error}" })?
    if stdout_overflow { return Err("build-plugin host response exceeds {BUILD_PLUGIN_MAX_RESPONSE_BYTES} bytes") }
    if stderr_overflow { return Err("build-plugin host error exceeds {MAX_HOST_STDERR_BYTES} bytes") }
    if !status.success() {
        message := String.from_utf8_lossy(&stderr)
        message := message.trim() // #4303
        return Err(if message.is_empty() { "build-plugin host exited with {status}" } else { message.to_string() })
    }
    write_result.map_err(fn(error) { "couldn't send request to build-plugin host: {error}" })?
    Ok(stdout)
}
// Rust: crates/jet-driver/src/BuildPluginHook.rs:154
fn read_bounded<R: Read>(reader: R, limit: USize) -> ([U8], Bool) Error! {
    bytes: [U8] = []
    reader.take(limit.saturating_add(1) as U64).read_to_end(&bytes)?
    overflow := bytes.len() > limit
    if overflow { bytes.truncate(limit) }
    Ok((bytes, overflow))
}
