// Completion from the checked symbols: after `receiver.` the receiver's
// members (or a module's declarations), elsewhere the names in scope at the
// cursor, the language's types and keywords included, the binding snippets
// at a statement's start, and the declarations of the workspace's saved
// files the document does not import yet, each with the `use` line it needs.
// After a value, a word another language spells for one of its methods
// completes to the Jet method. In a marked block the `lsp.completion` hooks
// of its marker's package come first.
use {
    core.encoding.[Dyn]
    jet_foundation.[Binding, Expr, Func, Item, Span, Stmt, TOOL_STAGE_LSP_COMPLETION, Type, foundation_byte_text, foundation_json_quote, jet_error_json_encode_value, type_name]
    jet_lexer.[Lexed, Token, TOKEN_DOT, TOKEN_IDENT, TOKEN_LBRACE, TOKEN_RBRACE, token_text]
    jet_semindex.[SemDef, SemKind, SemSymbol, SemSymbolKind, semindex_symbol_imported_module]
    jet_sema.[SEMA_METHOD_IDIOMS, SemaMethodIdiom]
}

// The most items one answer carries; a longer list is marked incomplete so
// the editor asks again as the prefix grows.
LSP_COMPLETION_LIMIT: 200

lsp_completion_item_kind: fn(kind: SemSymbolKind) -> Int Never! {
    if kind == {
        .Module -> 9
        .Function -> 3
        .Type -> 7
        .Member -> 2
        .Constant -> 21
        .Local | .Parameter -> 6
        .Keyword -> 14
    }
}

// Documentation markdown for a semantic symbol. Builtin symbols include their
// shared semantic summary, owning Core module, and example when present; source
// declarations carry their doc comment summary.
lsp_completion_symbol_doc: fn(symbol: SemSymbol) -> String Never! {
    if symbol.summary == "" -> return ""
    if symbol.provenance == .Builtin(module_name) {
        ^parts: [String]{symbol.summary}
        if module_name != "" -> parts.push("Module: `{module_name}`")
        if symbol.examples.len() > 0 && symbol.examples[0] != "" {
            parts.push("```jet\n{symbol.examples[0]}\n```")
        }
        return parts.join("\n\n")
    }
    symbol.summary
}

// A declaration's item names it in `data` when it has documentation, which
// `completionItem/resolve` adds once the editor shows the item. Builtin symbols
// also carry their shared semantic docs directly in the completion list.
lsp_completion_item_json: fn(symbol: SemSymbol, uri: String) -> String Never! {
    data: if symbol.summary == "" -> "" else -> ",\"data\":{{\"uri\":{foundation_json_quote(uri)},\"identity\":{foundation_json_quote(symbol.identity)}}}"
    doc: if symbol.provenance == .Builtin(_) && symbol.summary != "" -> ",\"documentation\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(lsp_completion_symbol_doc(symbol))}}}" else -> ""
    "{{\"label\":{foundation_json_quote(symbol.name)},\"kind\":{lsp_completion_item_kind(symbol.kind)},\"detail\":{foundation_json_quote(symbol.signature)}{doc}{data}}}"
}

// `completionItem/resolve`: the item as sent, with the doc comment summary of
// the declaration its `data` names as its documentation. An item that names
// none, or a declaration the document's check no longer holds, comes back
// as it is.
lsp_completion_resolve_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    item: params ?? return lsp_error_response(id, -32602, "completionItem/resolve needs a completion item")
    entries: if item == {
        .Object(fields) -> fields
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> {
            return lsp_error_response(id, -32602, "a completion item is an object")
        }
    }
    summary: lsp_completion_summary_json(server, lsp_member(item, "data") ?? Dyn.Null) ?? return lsp_response(id, jet_error_json_encode_value(item))
    ^rows: [String]{}
    loop entry in entries {
        if entry.key == "documentation" -> next
        rows.push("{foundation_json_quote(entry.key)}:{jet_error_json_encode_value(entry.value)}")
    }
    rows.push("\"documentation\":{{\"kind\":\"markdown\",\"value\":{summary}}}")
    lsp_response(id, "{{{rows.join(",")}}}")
}

// The summary of the declaration `data` names in its document's check, as a
// JSON string; None when it has none.
lsp_completion_summary_json: fn(server: LSPServer, data: Dyn) -> String? {
    uri: lsp_text_member(data, "uri") ?? return None
    identity: lsp_text_member(data, "identity") ?? return None
    view: lsp_view_of(server, uri) ?? return None
    loop symbol in view.checked.symbols {
        if symbol.identity == identity {
            doc: lsp_completion_symbol_doc(symbol)
            if doc == "" -> return None
            return Val(foundation_json_quote(doc))
        }
    }
    None
}

// The binding snippets, as `label`, `detail` and snippet text.
LSP_COMPLETION_BIND_SNIPPETS: [[String]]{
    [String]{"bind immut (inferred)", "name: value", "${{1:name}}: ${{2:value}}"},
    [String]{"bind mut", "^name: value", "^${{1:name}}: ${{2:value}}"},
}

// Whether a word at `start` begins a statement: only blanks precede it on its
// line, and it is inside a block.
lsp_completion_statement_start: fn(lexed: Lexed, bytes: [U8], start: Int) -> Bool Never! {
    ^at: start
    loop at > 0 && bytes[at - 1] != (U8{10}) {
        if bytes[at - 1] != (U8{32}) && bytes[at - 1] != (U8{9}) -> return false
        at -= 1
    }
    ^depth: 0
    loop token in lexed.tokens {
        if token.span.start >= start -> break
        if token.kind == TOKEN_LBRACE -> depth += 1
        if token.kind == TOKEN_RBRACE -> depth -= 1
    }
    depth > 0
}

// The completion kind of a top-level declaration, None for other kinds.
lsp_completion_def_kind: fn(kind: SemKind) -> Int? Never! {
    if kind == {
        .Function(_) -> Val(3)
        .Struct(_, _) -> Val(22)
        .Enum(_, _) -> Val(13)
        .Trait -> Val(8)
        .Type(_) | .Tag -> Val(7)
        .Const -> Val(21)
        .Module | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> None
    }
}

// The module a saved file below `root` is imported as: `/w/app/store.jet`
// below `/w` is `app.store`. "" for a file `root` does not hold.
lsp_completion_module_name: fn(root: String, path: String) -> String Never! {
    if !lsp_path_below(path, root) || !path.ends_with(".jet") -> return ""
    bytes: path.bytes()
    from: if root.ends_with("/") -> root.count_bytes() else -> root.count_bytes() + 1
    if from >= bytes.len() - 4 -> return ""
    foundation_byte_text(bytes, from, bytes.len() - 4).split("/").to_list().join(".")
}

// Adds the top-level declarations matching `prefix` of the saved files below
// the first workspace folder holding the document, skipping the files its
// check already reads: each inserts `module.Name` and adds the file's `use`
// line at the document's start. True once the answer is full.
lsp_completion_auto_imports: fn(server: LSPServer, view: LSPView, prefix: String, seen: ^[String:Bool], items: ^[String]) -> Bool {
    ^root: String?{None}
    loop folder in server.workspace_roots {
        if lsp_path_below(view.doc.path, folder) {
            root = Val(folder)
            break
        }
    }
    folder: root ?? return false
    saved: server.checker.sources(folder)
    loop source in saved.move() {
        if source.path == view.doc.path || lsp_checked_module_at(view.checked, source.path) != None {
            next
        }
        if source.path.ends_with("/package.jet") || source.path.ends_with("/env.jet") -> next
        module_name: lsp_completion_module_name(folder, source.path)
        if module_name == "" -> next
        segments: module_name.split(".").to_list()
        alias: segments[segments.len() - 1]
        outline: lsp_saved_outline(source)
        index: outline.index ?? next
        ^methods: [String:Bool]{}
        loop member in index.members -> methods[member.identity] = true
        loop definition in index.definitions {
            def: definition.def
            if !def.name.starts_with(prefix) || methods.has_key(def.identity) -> next
            kind: lsp_completion_def_kind(def.kind) ?? next
            if !lsp_source_spells(outline.modules[0].source, def.def_span, def.name) -> next
            key: "{def.name}:{kind}:{module_name}"
            if seen.has_key(key) -> next
            seen[key] = true
            if items.len() >= LSP_COMPLETION_LIMIT -> return true
            edit: "{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":0}}}},\"newText\":{foundation_json_quote("use {module_name}\n")}}}"
            items.push("{{\"label\":{foundation_json_quote(def.name)},\"kind\":{kind},\"detail\":{foundation_json_quote("use {module_name}")},\"insertText\":{foundation_json_quote("{alias}.{def.name}")},\"additionalTextEdits\":[{edit}]}}")
        }
    }
    false
}

// A word the lexer reads: an identifier or a keyword.
lsp_word_token: fn(token: Token) -> Bool Never! {
    token.kind == TOKEN_IDENT || lsp_keyword_token_kind(token.kind)
}

// Where completion's prefix starts: at the word token the cursor is inside
// or just past, else at the cursor.
lsp_completion_prefix_start: fn(lexed: Lexed, offset: Int) -> Int Never! {
    loop token in lexed.tokens {
        if token.span.start >= offset -> break
        if token.span.end >= offset && lsp_word_token(token) -> return token.span.start
    }
    offset
}

// What a completion at `start` follows: no `.` ending there, or a `.`
// written right after a receiver word, or a `.` after anything else.
LSPCompletionAfter: enum {
    Plain,
    Receiver(token: Token),
    Stray,
}

lsp_completion_after: fn(lexed: Lexed, start: Int) -> LSPCompletionAfter Never! {
    ^dot: -1
    loop index in 0..<lexed.tokens.len() {
        token: lexed.tokens[index]
        if token.span.end > start -> break
        if token.span.end == start && token.kind == TOKEN_DOT -> dot = index
    }
    if dot < 0 -> return LSPCompletionAfter.Plain
    if dot == 0 -> return LSPCompletionAfter.Stray
    receiver: lexed.tokens[dot - 1]
    if receiver.span.end != lexed.tokens[dot].span.start || !lsp_word_token(receiver) {
        return LSPCompletionAfter.Stray
    }
    LSPCompletionAfter.Receiver{token: receiver}
}

// The owner name a value of the type named `name` (type_name) has members
// under: a list is `List`, a map `Map`, else the type's last path segment
// without arguments.
lsp_type_owner: fn(name: String) -> String Never! {
    if name.starts_with("[") -> return if name.contains(":") -> "Map" else -> "List"
    // `find` counts bytes, so the head is cut from the bytes.
    ^cut: name.count_bytes()
    angle: name.find("<")
    if angle >= 0 -> cut = angle
    question: name.find("?")
    if question >= 0 && question < cut -> cut = question
    parts: foundation_byte_text(name.bytes(), 0, cut).split(".").to_list()
    parts[parts.len() - 1]
}

// What `receiver.` completes against.
LSPMemberScope: enum {
    Owner(name: String),
    Module(path: String),
}

// The members of values or of a type named this.
// The declarations of the checked module at this path.

// Infers the member owner of an initializer expression when keep-going trapped
// the enclosing function before recording local types (e.g. `items: [1, 2, 3]`
// followed by an incomplete `items.f`).
lsp_expr_owner: fn(expr: Expr) -> String? Never! {
    if expr == {
        .ListLit(_, _, _) -> Val("List")
        .MapLit(_, _, _) -> Val("Map")
        .Str(_, _, _) -> Val("String")
        .Int(_, _, _, _, _) -> Val("Int")
        .Float(_, _, _, _, _) -> Val("Float")
        .Bool(_, _, _) -> Val("Bool")
        .Char(_, _, _) -> Val("Char")
        .StructLit(name, _, _, _, _, _, _, _) -> Val(lsp_type_owner(name))
        .TypedLit(head, body, _, _) -> {
            if head == .Val(ty) -> return Val(lsp_type_owner(type_name(ty)))
            if body == {
                .Elements(_) -> Val("List")
                .Entries(_) -> Val("Map")
                .Fields(_) | .Value(_) | .ByteText(_) | .Empty -> None
            }
        }
        .EnumLit(name, _, _, _, _, _, _) -> if name != "" -> Val(lsp_type_owner(name)) else -> None
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> None
    }
}

lsp_binding_owner: fn(binding: Binding) -> String? Never! {
    if binding.ty == .Val(written) -> return Val(lsp_type_owner(type_name(written)))
    lsp_expr_owner(binding.init)
}

lsp_stmt_find_local_owner: fn(stmts: [Stmt], span: Span) -> String? Never! {
    loop stmt in stmts {
        found: if stmt == {
            .Val(binding) -> if binding.name_span.start == span.start && binding.name_span.end == span.end -> lsp_binding_owner(binding) else -> None
            .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .Defer(body, _) -> lsp_stmt_find_local_owner(body, span)
            .CountedLoop(init, _, _, body, _, _, _) -> if init.name_span.start == span.start && init.name_span.end == span.end -> lsp_binding_owner(init) else -> lsp_stmt_find_local_owner(body, span)
            .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
                ^arm_owner: String?{None}
                loop arm in arms {
                    if lsp_stmt_find_local_owner(arm.body, span) == .Val(owner) {
                        arm_owner = Val(owner)
                        break
                    }
                }
                if {
                    arm_owner != None -> arm_owner
                    else_body == .Val(body) -> lsp_stmt_find_local_owner(body, span)
                    else -> None
                }
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> if {
                lsp_stmt_find_local_owner(then_body, span) == .Val(owner) -> Val(owner)
                else_body == .Val(body) -> lsp_stmt_find_local_owner(body, span)
                else -> None
            }
            .Expr(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) | .DeferClose(_, _) -> None
        }
        if found != None -> return found
    }
    None
}

lsp_funcs_find_local_owner: fn(funcs: [Func], span: Span) -> String? Never! {
    loop func in funcs {
        if lsp_stmt_find_local_owner(func.body, span) == .Val(owner) -> return Val(owner)
    }
    None
}

lsp_items_find_local_owner: fn(items: [Item], span: Span) -> String? Never! {
    loop item in items {
        found: if item == {
            .Func(func) -> lsp_stmt_find_local_owner(func.body, span)
            .Test(test_def) -> lsp_stmt_find_local_owner(test_def.body, span)
            .Struct(struct_def) -> lsp_funcs_find_local_owner(struct_def.methods, span)
            .Enum(enum_def) -> lsp_funcs_find_local_owner(enum_def.methods, span)
            .Impl(impl_def) -> lsp_funcs_find_local_owner(impl_def.methods, span)
            .CodeModule(code_mod) -> if code_mod.body == .Val(nested) -> lsp_items_find_local_owner(nested, span) else -> None
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
        }
        if found != None -> return found
    }
    None
}

lsp_local_ast_owner: fn(view: LSPView, def: SemDef) -> String? Never! {
    module_index: lsp_module_index(view.checked, def.module_path) ?? return None
    lsp_items_find_local_owner(view.checked.modules[module_index].items, def.def_span)
}

lsp_member_scope: fn(view: LSPView, receiver_end: Int) -> LSPMemberScope? Never! {
    index: view.checked.index ?? return None
    target: lsp_target_at(view, receiver_end) ?? return None
    def: lsp_definition_at(index, target) ?? return None
    if def.kind == {
        .Local(_, ty) -> {
            owner: if ty == .Val(known) -> lsp_type_owner(type_name(known)) else -> (lsp_local_ast_owner(view, def) ?? return None)
            Val(LSPMemberScope.Owner{name: owner})
        }
        .Param(ty) -> Val(LSPMemberScope.Owner{name: lsp_type_owner(type_name(ty))})
        .Field(ty, _) -> Val(LSPMemberScope.Owner{name: lsp_type_owner(type_name(ty))})
        .Struct(_, _) | .Enum(_, _) | .Trait | .Type(_) -> Val(LSPMemberScope.Owner{name: def.name})
        .Module -> {
            module_path: view.module_path ?? return None
            doc_module: view.checked.modules[lsp_module_index(view.checked, module_path) ?? return None]
            imported: semindex_symbol_imported_module(view.checked.modules, doc_module, doc_module.imports, def.name) ?? return None
            Val(LSPMemberScope.Module{path: imported})
        }
        .Function(_) | .Tag | .Const | .EnumVariant(_) -> None
    }
}

lsp_member_candidate: fn(symbol: SemSymbol, scope: LSPMemberScope) -> Bool Never! {
    if scope == {
        .Owner(name) -> (symbol.owner ?? "") == name
        .Module(path) -> symbol.module_path == path && symbol.owner == None && symbol.lexical_scope == None && symbol.kind != SemSymbolKind.Local
    }
}

// A name is in scope in the document's module: its top-level declarations
// and imports, the language's names, and each binding or parameter whose
// scope holds the cursor after its declaration.
lsp_scope_candidate: fn(symbol: SemSymbol, module_path: String?, offset: Int) -> Bool Never! {
    if symbol.owner != None || symbol.kind == SemSymbolKind.Member -> return false
    if symbol.provenance == {
        .Builtin(_) -> return true
        .Source(_) -> {}
    }
    if (module_path ?? return false) != symbol.module_path -> return false
    if symbol.lexical_scope == .Val(scope) {
        return lsp_span_holds(scope.span, offset) && scope.declaration_offset <= offset
    }
    true
}

// The item `idiom`'s foreign word completes to after a value of `owner`: the
// Jet method the row renames the word to, found by the foreign word, whose
// edit writes the Jet name over `range`, the word written so far. The rows
// are the ones E0311's Fix names for the same receiver, so the editor and the
// checker map a foreign word to one name. None when the row is for another
// receiver, renames nothing, or names a method `owner` lacks.
lsp_completion_foreign_item: fn(view: LSPView, owner: String, idiom: SemaMethodIdiom, range: String) -> String? Never! {
    if idiom.receiver != owner || idiom.rename == "" -> return None
    loop symbol in view.checked.symbols {
        if symbol.name != idiom.rename || (symbol.owner ?? "") != owner -> next
        name: foundation_json_quote(symbol.name)
        note: foundation_json_quote("`{idiom.foreign}` is `{idiom.rename}` in Jet: {idiom.note}.")
        return Val("{{\"label\":{name},\"kind\":{lsp_completion_item_kind(symbol.kind)},\"detail\":{foundation_json_quote(symbol.signature)},\"filterText\":{foundation_json_quote(idiom.foreign)},\"textEdit\":{{\"range\":{range},\"newText\":{name}}},\"documentation\":{{\"kind\":\"markdown\",\"value\":{note}}}}}")
    }
    None
}

lsp_completion_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    position: lsp_params_position(params) ?? return lsp_response(id, "null")
    bytes: view.doc.text.bytes()
    offset: lsp_checked_offset_bytes(lsp_line_table_bytes(bytes), bytes, position) ?? return lsp_error_response(id, -32602, "position is outside the document")
    start: lsp_completion_prefix_start(view.lexed, offset)
    prefix: foundation_byte_text(bytes, start, offset)
    ^member: LSPMemberScope?{None}
    after: lsp_completion_after(view.lexed, start)
    if after == {
        .Plain -> {}
        .Receiver(token) -> {
            if lsp_member_scope(view, token.span.end - 1) == {
                .Val(scope) -> member = Val(scope)
                .None -> {
                    packages: lsp_discovery_package_items(server, view, token_text(view.lexed.tables, token), prefix)
                    return lsp_response(id, "{{\"isIncomplete\":false,\"items\":[{packages.join(",")}]}}")
                }
            }
        }
        .Stray -> return lsp_response(id, "{{\"isIncomplete\":false,\"items\":[]}}")
    }
    ^seen: [String:Bool]{}
    ^items: [String]{}
    ^incomplete: false
    // Inside a marked block, the `lsp.completion` hooks of its marker's
    // package answer first.
    loop row in server.stage_items(view, TOOL_STAGE_LSP_COMPLETION, at: offset) {
        if !row.label.starts_with(prefix) || seen.has_key("{row.label}:1") -> next
        seen["{row.label}:1"] = true
        items.push("{{\"label\":{foundation_json_quote(row.label)},\"kind\":1,\"detail\":{foundation_json_quote(row.detail)}}}")
    }
    if member == None {
        lsp_discovery_option_completions(server, view, start, prefix, seen, items)
    }
    if member == None && lsp_completion_statement_start(view.lexed, bytes, start) {
        loop snippet in LSP_COMPLETION_BIND_SNIPPETS {
            if !snippet[0].starts_with(prefix) -> next
            items.push("{{\"label\":{foundation_json_quote(snippet[0])},\"kind\":15,\"detail\":{foundation_json_quote(snippet[1])},\"insertText\":{foundation_json_quote(snippet[2])},\"insertTextFormat\":2}}")
        }
    }
    loop symbol in view.checked.symbols {
        if !symbol.name.starts_with(prefix) -> next
        candidate: if member == .Val(scope) -> lsp_member_candidate(symbol, scope) else -> lsp_scope_candidate(symbol, view.module_path, offset)
        if !candidate -> next
        key: "{symbol.name}:{lsp_completion_item_kind(symbol.kind)}"
        if seen.has_key(key) -> next
        seen[key] = true
        if items.len() >= LSP_COMPLETION_LIMIT {
            incomplete = true
            break
        }
        items.push(lsp_completion_item_json(symbol, view.uri))
    }
    // A foreign word completes only once a word is written, and only to a
    // method no item already offers.
    if member == .Val(scope) && scope == .Owner(owner) && prefix != "" && !incomplete {
        range: lsp_range_json(lsp_byte_span_to_range(view.doc.text, Span{start: start, end: offset}))
        loop idiom in SEMA_METHOD_IDIOMS {
            if !idiom.foreign.starts_with(prefix) || seen.has_key("{idiom.rename}:2") -> next
            item: lsp_completion_foreign_item(view, owner, idiom, range) ?? next
            seen["{idiom.rename}:2"] = true
            items.push(item)
        }
    }
    if member == None && !incomplete {
        incomplete = lsp_completion_auto_imports(server, view, prefix, seen, items)
    }
    lsp_response(id, "{{\"isIncomplete\":{incomplete},\"items\":[{items.join(",")}]}}")
}
