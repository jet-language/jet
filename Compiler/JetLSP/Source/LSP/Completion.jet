// Completion from the checked symbols: after `receiver.` the receiver's
// members (or a module's declarations), elsewhere the names in scope at the
// cursor, the language's types and keywords included.
use {
    core.encoding.[Dyn]
    jet_foundation.[Type, foundation_json_quote, type_name]
    jet_semindex.[SemSymbol, SemSymbolKind, semindex_symbol_imported_module]
}

// The most items one answer carries; a longer list is marked incomplete so
// the editor asks again as the prefix grows.
LSP_COMPLETION_LIMIT: 200

lsp_completion_item_kind: fn(kind: SemSymbolKind) -> Int Never! {
    if kind == {
        .Module -> 9
        .Function -> 3
        .Type -> 7
        .Member -> 2
        .Constant -> 21
        .Local | .Parameter -> 6
        .Keyword -> 14
    }
}

lsp_completion_item_json: fn(symbol: SemSymbol) -> String Never! {
    documentation: if symbol.summary == "" -> "" else -> ",\"documentation\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(symbol.summary)}}}"
    "{{\"label\":{foundation_json_quote(symbol.name)},\"kind\":{lsp_completion_item_kind(symbol.kind)},\"detail\":{foundation_json_quote(symbol.signature)}{documentation}}}"
}

// The identifier text before `offset`: ASCII letters, digits, `_`, and any
// non-ASCII byte.
lsp_completion_prefix_start: fn(bytes: [U8], offset: Int) -> Int Never! {
    start := offset
    loop start > 0 {
        code: Int{bytes[start - 1]}
        if !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95 || code >= 128) -> break
        start -= 1
    }
    start
}

// The owner name a value of `ty` has members under: a list is `List`, a map
// `Map`, else the type's last path segment without arguments.
lsp_type_owner: fn(ty: Type) -> String Never! {
    name: type_name(ty)
    if name.starts_with("[") -> return if name.contains(":") -> "Map" else -> "List"
    head := name
    angle: head.find("<")
    if angle >= 0 -> head = head.slice(0, angle)
    question: head.find("?")
    if question >= 0 -> head = head.slice(0, question)
    parts: head.split(".").to_list()
    parts[parts.len() - 1]
}

// What `receiver.` completes against.
LSPMemberScope: enum {
    // The members of values or of a type named this.
    Owner(name: String)
    // The declarations of the checked module at this path.
    Module(path: String)
}

lsp_member_scope: fn(view: LSPView, receiver_end: Int) -> LSPMemberScope? Never! {
    index: view.checked.index ?? return None
    target: lsp_target_at(view, receiver_end) ?? return None
    def: lsp_definition_at(index, target) ?? return None
    if def.kind == {
        .Local(_, ty) -> Val(LSPMemberScope.Owner{name: lsp_type_owner(ty ?? return None)})
        .Param(ty) -> Val(LSPMemberScope.Owner{name: lsp_type_owner(ty)})
        .Field(ty, _) -> Val(LSPMemberScope.Owner{name: lsp_type_owner(ty)})
        .Struct(_, _) | .Enum(_, _) | .Trait | .Type(_) -> Val(LSPMemberScope.Owner{name: def.name.copy()})
        .Module -> {
            module_path: view.module_path ?? return None
            doc_module: view.checked.modules[lsp_module_index(view.checked, module_path) ?? return None]
            imported: semindex_symbol_imported_module(view.checked.modules, doc_module, doc_module.imports, def.name) ?? return None
            Val(LSPMemberScope.Module{path: imported})
        }
        .Function(_) | .Tag | .Const | .EnumVariant(_) -> None
    }
}

lsp_member_candidate: fn(symbol: SemSymbol, scope: LSPMemberScope) -> Bool Never! {
    if scope == {
        .Owner(name) -> (symbol.owner ?? "") == name
        .Module(path) -> symbol.module_path == path && symbol.owner == None && symbol.lexical_scope == None && symbol.kind != SemSymbolKind.Local
    }
}

// A name is in scope in the document's module: its top-level declarations
// and imports, the language's names, and each binding or parameter whose
// scope holds the cursor after its declaration.
lsp_scope_candidate: fn(symbol: SemSymbol, module_path: String?, offset: Int) -> Bool Never! {
    if symbol.owner != None || symbol.kind == SemSymbolKind.Member -> return false
    if symbol.provenance == {
        .Builtin(_) -> return true
        .Source(_) -> {}
    }
    if (module_path ?? return false) != symbol.module_path -> return false
    if symbol.lexical_scope == .Val(scope) -> return lsp_span_holds(scope.span, offset) && scope.declaration_offset <= offset
    true
}

lsp_completion_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    position: lsp_params_position(params) ?? return lsp_response(id, "null")
    bytes: view.doc.text.bytes()
    offset: lsp_checked_offset_bytes(lsp_line_table_bytes(bytes), bytes, position) ?? return lsp_error_response(id, -32602, "position is outside the document")
    start: lsp_completion_prefix_start(bytes, offset)
    prefix: view.doc.text.slice(start, offset)
    member := LSPMemberScope?{None}
    if start > 0 && bytes[start - 1] == (U8{46}) {
        receiver_end: start - 1
        empty: lsp_response(id, "{{\"isIncomplete\":false,\"items\":[]}}")
        if receiver_end == 0 || lsp_completion_prefix_start(bytes, receiver_end) == receiver_end -> return empty
        member = Val(lsp_member_scope(view, receiver_end - 1) ?? return empty)
    }
    seen := [String:Bool]{}
    items := [String]{}
    incomplete := false
    loop symbol in view.checked.symbols {
        if !symbol.name.starts_with(prefix) -> next
        candidate: if member == .Val(scope) -> lsp_member_candidate(symbol, scope) else -> lsp_scope_candidate(symbol, view.module_path, offset)
        if !candidate -> next
        key: "{symbol.name}:{lsp_completion_item_kind(symbol.kind)}"
        if seen.has_key(key) -> next
        seen[key] = true
        if items.len() >= LSP_COMPLETION_LIMIT {
            incomplete = true
            break
        }
        items.push(lsp_completion_item_json(symbol))
    }
    lsp_response(id, "{{\"isIncomplete\":{incomplete},\"items\":[{items.join(",")}]}}")
}
