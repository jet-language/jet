// Document and workspace symbols, folding, selection ranges and import links.
use {
    core.encoding.[Dyn]
    jet_foundation.[Diagnostic, ImportDecl, Span, foundation_byte_text, foundation_json_quote]
    jet_parser.[parse_source]
    jet_driver.[JetDriverDocModule, JetDriverSourceDocument]
    jet_semindex.[SemDef, SemSymbol, semindex_build_outline, semindex_symbol_imported_module]
}

lsp_symbol_information_json: fn(def: SemDef, location: LSPLocation, kind: Int) -> String Never! {
    container: if lsp_definition_parent(def.kind) == .Val(parent) -> ",\"containerName\":{foundation_json_quote(parent)}" else -> ""
    "{{\"name\":{foundation_json_quote(def.name)},\"kind\":{kind},\"location\":{lsp_location_json(location)}{container}}}"
}

// Whether `span` of `source` spells `name`: a declaration the source writes.
// One a derive or marker generated (a derived `encode` names its type's span)
// has no written name there.
lsp_source_spells: fn(source: String, span: Span, name: String) -> Bool Never! {
    bytes: source.bytes()
    span.start >= 0 && span.end <= bytes.len() && foundation_byte_text(bytes, span.start, span.end) == name
}

// The document's written declarations in source order; bindings and
// parameters are not symbols of the document.
lsp_document_symbol_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    index: view.checked.index ?? return lsp_response(id, "[]")
    module_path: view.module_path ?? return lsp_response(id, "[]")
    defs := [SemDef]{}
    loop definition in index.definitions {
        if definition.def.module_path != module_path || lsp_symbol_kind(definition.def.kind) == None -> next
        if lsp_source_spells(view.doc.text, definition.def.def_span, definition.def.name) -> defs.push(definition.def)
    }
    defs.sort_by(fn(left: SemDef, right: SemDef) { left.def_span.start <=> right.def_span.start })
    rows := [String]{}
    loop def in defs {
        kind: lsp_symbol_kind(def.kind) ?? next
        rows.push(lsp_symbol_information_json(def, LSPLocation{uri: view.uri, source: view.doc.text, span: def.def_span}, kind))
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// The most workspace symbols one answer carries.
LSP_WORKSPACE_SYMBOL_LIMIT: 500

// A query matches a name holding its characters in order, ignoring ASCII case.
lsp_fuzzy_match: fn(query: String, name: String) -> Bool Never! {
    wanted: query.to_lower().bytes()
    have: name.to_lower().bytes()
    at := 0
    loop byte in have {
        if at < wanted.len() && byte == wanted[at] -> at += 1
    }
    at == wanted.len()
}

// Declarations matching the query. With workspace folders: those of the files
// below each folder, an open document's from the check of its open text and a
// closed file's from its saved text. Without: those across every check the
// open documents' publications read.
lsp_workspace_symbol_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    query: lsp_text_member(params ?? Dyn.Null, "query") ?? ""
    seen := [String:Bool]{}
    rows := [String]{}
    if server.workspace_named {
        loop root in server.workspace_roots {
            if !lsp_root_symbol_rows(server, root, query, seen, rows) -> break
        }
        return lsp_response(id, "[{rows.join(",")}]")
    }
    uris := [String]{}
    loop (uri, _) in server.published -> uris.push(uri.copy())
    uris.sort()
    loop uri in uris {
        if !lsp_symbol_rows(server.published[uri], -1, query, seen, rows) -> break
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// The rows of one folder: each open document below it, then each saved file
// below it that is not open. False once the answer is full.
lsp_root_symbol_rows: fn(server: LSPServer, root: String, query: String, seen: &[String:Bool], rows: &[String]) -> Bool {
    loop (uri, doc) in server.diagnostic_state.docs {
        if !lsp_path_below(doc.path, root) -> next
        checked: server.published.get(uri) ?? server.check(doc)
        slot: lsp_checked_module_at(checked, doc.path) ?? next
        if !lsp_symbol_rows(checked, slot, query, seen, rows) -> return false
    }
    saved: server.checker.sources(root)
    loop source in saved.move() {
        if lsp_path_open(server, source.path) -> next
        if !lsp_symbol_rows(lsp_saved_outline(source), -1, query, seen, rows) -> return false
    }
    true
}

lsp_path_open: fn(server: LSPServer, path: String) -> Bool Never! {
    loop (_, doc) in server.diagnostic_state.docs {
        if doc.path == path -> return true
    }
    false
}

// The folders `initialize` names: its `workspaceFolders`, else its
// `rootUri`. A client that names neither leaves workspace symbols on the
// open documents' checks.
lsp_initial_workspace_folders: fn(server: &LSPServer, params: Dyn?) Never! {
    if lsp_param(params, "workspaceFolders") == .Val(folders) {
        if folders == .Array(rows) {
            server.workspace_named = true
            server.workspace_roots = lsp_folder_paths(rows)
            return
        }
    }
    if lsp_param(params, "rootUri") == .Val(root) {
        if root == .Text(uri) {
            server.workspace_named = true
            server.workspace_roots = [String]{lsp_folder_path(uri)}
        }
    }
}

// `workspace/didChangeWorkspaceFolders`: the removed folders leave, then the
// added ones join.
lsp_change_workspace_folders: fn(server: &LSPServer, params: Dyn?) Never! {
    event: lsp_param(params, "event") ?? return
    removed: lsp_folder_paths(lsp_member_rows(event, "removed"))
    // Popping the folders reverses them; popping again restores the order.
    reversed := [String]{}
    loop server.workspace_roots.len() > 0 {
        root: server.workspace_roots.pop() ?? break
        if !removed.contains(root) -> reversed.push(root)
    }
    loop reversed.len() > 0 -> server.workspace_roots.push(reversed.pop() ?? break)
    loop root in lsp_folder_paths(lsp_member_rows(event, "added")) {
        if !server.workspace_roots.contains(root) -> server.workspace_roots.push(root)
    }
    server.workspace_named = true
}

lsp_member_rows: fn(value: Dyn, key: String) -> [Dyn] Never! {
    if (lsp_member(value, key) ?? return [Dyn]{}) == .Array(rows) -> return rows
    [Dyn]{}
}

// Each folder's path once.
lsp_folder_paths: fn(rows: [Dyn]) -> [String] Never! {
    paths := [String]{}
    loop row in rows {
        path: lsp_folder_path(lsp_text_member(row, "uri") ?? next)
        if !paths.contains(path) -> paths.push(path)
    }
    paths
}

// A folder URI's path, without a trailing separator.
lsp_folder_path: fn(uri: String) -> String Never! {
    path: lsp_uri_to_path(uri)
    bytes: path.bytes()
    if bytes.len() > 1 && path.ends_with("/") -> return foundation_byte_text(bytes, 0, bytes.len() - 1)
    path
}

// Whether `path` is `root` or below it.
lsp_path_below: fn(path: String, root: String) -> Bool Never! {
    if !path.starts_with(root) -> return false
    if path.count_bytes() == root.count_bytes() || root.ends_with("/") -> return true
    path.bytes()[root.count_bytes()] == (U8{47})
}

// A saved file's declarations, from its text parsed and outlined alone
// (semindex_build_outline): the module is named by the file's stem.
lsp_saved_outline: fn(source: &&JetDriverSourceDocument) -> LSPChecked Never! {
    parsed: parse_source(source.source.bytes())
    physical: source.path.move()
    stem: lsp_file_stem(physical)
    alias: lsp_file_stem(physical)
    modules: [JetDriverDocModule]{
        JetDriverDocModule{
            path: stem,
            physical_path: physical,
            alias: alias,
            source: source.source.move(),
            items: parsed.program.items.move(),
            block_spans: parsed.program.block_spans.move(),
            imports: parsed.program.imports.move(),
            tables: parsed.program.tables.move(),
        },
    }
    index: semindex_build_outline(modules)
    LSPChecked{diagnostics: [Diagnostic]{}, modules: modules, index: Val(index), symbols: [SemSymbol]{}}
}

// `/w/app/store.jet` is `store`.
lsp_file_stem: fn(path: String) -> String Never! {
    bytes: path.bytes()
    start := bytes.len()
    loop start > 0 && bytes[start - 1] != (U8{47}) -> start -= 1
    end: if path.ends_with(".jet") && bytes.len() - 4 >= start -> bytes.len() - 4 else -> bytes.len()
    foundation_byte_text(bytes, start, end)
}

// Adds the rows of `checked`'s declarations that match `query`, only those of
// the module at `slot` when it is not -1. Each declaration is one row. False
// once the answer is full.
lsp_symbol_rows: fn(checked: LSPChecked, slot: Int, query: String, seen: &[String:Bool], rows: &[String]) -> Bool Never! {
    index: checked.index ?? return true
    loop definition in index.definitions {
        def: definition.def
        kind: lsp_symbol_kind(def.kind) ?? next
        if !lsp_fuzzy_match(query, def.name) -> next
        if slot >= 0 && checked.modules[slot].path != def.module_path -> next
        location: lsp_location(checked, def.module_path, def.def_span) ?? next
        key: "{location.uri}:{def.def_span.start}"
        if seen.has_key(key) -> next
        if !lsp_source_spells(location.source, def.def_span, def.name) -> next
        seen[key] = true
        rows.push(lsp_symbol_information_json(def, location, kind))
        if rows.len() >= LSP_WORKSPACE_SYMBOL_LIMIT -> return false
    }
    true
}

lsp_folding_range_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String Never! {
    doc: lsp_open_document(server, params) ?? return lsp_response(id, "null")
    rows := [String]{}
    loop fold in lsp_compute_folding_ranges(doc.text, server.lex(doc)) {
        rows.push(lsp_folding_range_json(fold))
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// The spans enclosing `offset`, narrowest first, each once: the identifier
// under the cursor, then each syntax node that holds it, then the document.
lsp_selection_spans: fn(view: LSPView, offset: Int) -> [Span] Never! {
    spans := [Span]{}
    if lsp_ident_token_at(view.lexed, offset) == .Val(token) -> spans.push(token.span)
    if view.checked.index == .Val(index) {
        if view.module_path == .Val(module_path) {
            loop node in index.nodes {
                if node.module_path == module_path && lsp_span_holds(node.span, offset) {
                    spans.push(node.span)
                }
            }
        }
    }
    spans.push(Span{start: 0, end: view.doc.text.count_bytes()})
    spans.sort_by(fn(left: Span, right: Span) { (left.end - left.start <=> right.end - right.start).then(right.start <=> left.start) })
    unique := [Span]{}
    loop span in spans {
        if unique.len() > 0 {
            last: unique[unique.len() - 1]
            if last.start == span.start && last.end == span.end -> next
            // A parent must hold its child.
            if span.start > last.start || span.end < last.end -> next
        }
        unique.push(span)
    }
    unique
}

lsp_selection_range_json: fn(src: String, spans: [Span]) -> String Never! {
    json := ""
    index := spans.len()
    loop index > 0 {
        index -= 1
        parent: if json == "" -> "" else -> ",\"parent\":{json}"
        json = "{{\"range\":{lsp_range_json(lsp_byte_span_to_range(src, spans[index]))}{parent}}}"
    }
    json
}

lsp_selection_range_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    positions: if (lsp_param(params, "positions") ?? return lsp_response(id, "null")) == {
        .Array(rows) -> rows
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> {
            return lsp_error_response(id, -32602, "positions is not an array")
        }
    }
    bytes: view.doc.text.bytes()
    table: lsp_line_table_bytes(bytes)
    rows := [String]{}
    loop value in positions {
        position: lsp_pos_from_json(value) ?? return lsp_error_response(id, -32602, "a position is malformed")
        offset: lsp_checked_offset_bytes(table, bytes, position) ?? return lsp_error_response(id, -32602, "a position is outside the document")
        rows.push(lsp_selection_range_json(view.doc.text, lsp_selection_spans(view, offset)))
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// Each file or module import links to the checked module it names.
lsp_document_link_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    module_path: view.module_path ?? return lsp_response(id, "[]")
    doc_module: view.checked.modules[lsp_module_index(view.checked, module_path) ?? return lsp_response(id, "[]")]
    rows := [String]{}
    loop import in doc_module.imports {
        span: if import.kind == {
            .File(_, path_span) -> path_span
            .Module(_, name_span) -> name_span
            .Unqualified(_, _, _, _, _) -> {
                next
            }
        }
        imported: semindex_symbol_imported_module(view.checked.modules, doc_module, [ImportDecl]{}, import.alias) ?? next
        location: lsp_location(view.checked, imported, Span{start: 0, end: 0}) ?? next
        rows.push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(view.doc.text, span))},\"target\":{foundation_json_quote(location.uri)}}}")
    }
    lsp_response(id, "[{rows.join(",")}]")
}
