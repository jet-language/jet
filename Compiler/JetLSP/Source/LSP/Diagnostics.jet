// Publishing diagnostics. A check of one open document reports diagnostics in
// every file it read; each lands on that file's URI, and a later publication
// clears the URIs the previous one wrote that no longer have any.
use {
    lsp_diag_term: core.term
    jet_foundation.[Diagnostic, Span, DIAGNOSTIC_LINT, diagnostic_cause_matches, foundation_json_quote]
}

// One framed JSON-RPC message: its header counts bytes, not characters.
lsp_write_message: fn(stdout: &lsp_diag_term.Stdout, json: String) IOError! -[IO]> {
    stdout.write("Content-Length: {json.count_bytes()}\r\n\r\n{json}") ?? return Err(err)
    stdout.flush() ?? return Err(err)
}

// Two spellings of one file: equal, or equal once leading `./` are dropped.
lsp_source_paths_equal: fn(left: String, right: String) -> Bool Never! {
    if left == right -> return true
    lsp_strip_dot_slash(left) == lsp_strip_dot_slash(right)
}

lsp_strip_dot_slash: fn(path: String) -> String Never! {
    out := path
    loop out.starts_with("./") -> out = out.slice(2, out.count_bytes())
    out
}

// The dirty documents, sorted, then each open document whose last check read
// one of them. Draining clears the dirty set.
lsp_dirty_documents: fn(state: &LSPDiagnosticState) -> [String] Never! {
    dirty := [String]{}
    dirty_set := [String:Bool]{}
    changed := [String]{}
    loop (uri, _) in state.dirty {
        dirty.push(uri.copy())
        dirty_set[uri] = true
        if state.docs.get(uri) == .Val(doc) -> changed.push(doc.path.copy())
    }
    state.dirty = [String:Bool]{}
    dirty.sort()
    dependents := [String]{}
    loop (root, modules) in state.checked_modules {
        if dirty_set.has_key(root) || !state.docs.has_key(root) -> next
        if lsp_reads_any(modules, changed) -> dependents.push(root.copy())
    }
    dependents.sort()
    loop root in dependents -> dirty.push(root)
    dirty
}

lsp_reads_any: fn(modules: [String], paths: [String]) -> Bool Never! {
    loop module_path in modules {
        loop path in paths {
            if lsp_source_paths_equal(module_path, path) -> return true
        }
    }
    false
}

lsp_target_retained_elsewhere: fn(state: LSPDiagnosticState, root: String, target: String) -> Bool Never! {
    loop (other, targets) in state.diagnostic_targets {
        if other != root && targets.has_key(target) -> return true
    }
    false
}

lsp_checked_module_paths: fn(checked: LSPChecked) -> [String] Never! {
    paths := [String]{}
    loop module_ref in checked.modules -> paths.push(if module_ref.physical_path != "" -> module_ref.physical_path else -> module_ref.path)
    paths
}

// The diagnostic indices for each target URI, in diagnostic order. The root
// always has a group, even an empty one. A target the previous publication
// wrote gets an empty group (a clear) unless another root still holds it and
// this check no longer read it.
lsp_diagnostic_groups: fn(state: LSPDiagnosticState, uri: String, checked: LSPChecked, targets: &[String:Bool]) -> [String:[Int]] Never! {
    groups := [String:[Int]]{}
    groups[uri] = [Int]{}
    loop (index, diagnostic) in checked.diagnostics {
        target := uri
        if diagnostic.origin == .Val(origin) {
            target = lsp_path_to_uri(origin.path)
            loop (open_uri, open) in state.docs {
                if lsp_source_paths_equal(open.path, origin.path) {
                    target = open_uri
                    break
                }
            }
        }
        if !groups.has_key(target) -> groups[target] = [Int]{}
        groups[target].push(index)
    }
    loop (target, _) in groups -> targets[target] = true
    if state.diagnostic_targets.get(uri) == .Val(previous) {
        read: lsp_checked_module_paths(checked)
        loop (target, _) in previous {
            if groups.has_key(target) -> next
            still_checked: lsp_reads_any(read, [String]{lsp_uri_to_path(target)})
            if still_checked || !lsp_target_retained_elsewhere(state, uri, target) -> groups[target] = [Int]{}
        }
    }
    groups
}

lsp_publish_diagnostics: fn(uri: String, src: String, version: Int?, diagnostics: [Diagnostic], indices: [Int]) -> String Never! {
    items := [String]{}
    loop index in indices -> items.push(lsp_diagnostic_json(diagnostics[index], src, uri, diagnostics))
    version_json: if version == .Val(value) -> ",\"version\":{value}" else -> ""
    "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{{\"uri\":{foundation_json_quote(uri)}{version_json},\"diagnostics\":[{items.join(",")}]}}}}"
}

lsp_diagnostic_json: fn(diagnostic: Diagnostic, src: String, uri: String, diagnostics: [Diagnostic]) -> String Never! {
    severity: if diagnostic.severity == DIAGNOSTIC_LINT -> 2 else -> 1
    range: if diagnostic.span == {
        .Val(span) -> lsp_byte_span_to_range(src, lsp_clamped_span(src, span))
        .None -> lsp_full_document_range(src)
    }
    related: lsp_related_information_json(diagnostic, uri, src, diagnostics)
    "{{\"range\":{lsp_range_json(range)},\"severity\":{severity},\"code\":{foundation_json_quote(diagnostic.code)},\"source\":\"jet\",\"message\":{foundation_json_quote(diagnostic.what)},\"codeDescription\":{{\"href\":{foundation_json_quote(lsp_diagnostic_explanation_uri(diagnostic.code))}}}{related}}}"
}

// A report's span bounded to its source, on character boundaries.
lsp_clamped_span: fn(src: String, span: Span) -> Span Never! {
    bytes: src.bytes()
    start := if {
        span.start < 0 -> 0
        span.start > bytes.len() -> bytes.len()
        else -> span.start
    }
    end := if {
        span.end < start -> start
        span.end > bytes.len() -> bytes.len()
        else -> span.end
    }
    loop start > 0 && start < bytes.len() && (Int.from_u8(bytes[start]).bit_and(192)) == 128 -> start -= 1
    loop end < bytes.len() && (Int.from_u8(bytes[end]).bit_and(192)) == 128 -> end += 1
    Span{start: start, end: end}
}

lsp_diagnostic_explanation_uri: fn(code: String) -> String Never! { "jet://explain/{code}" }

// Each cause names an earlier report by code, span and source; the first
// report it matches with a span becomes a related location.
lsp_related_information_json: fn(diagnostic: Diagnostic, uri: String, src: String, diagnostics: [Diagnostic]) -> String Never! {
    related := [String]{}
    loop identity in diagnostic.cause {
        loop cause in diagnostics {
            if !diagnostic_cause_matches(identity, cause) -> next
            span: cause.span ?? next
            if cause.origin == {
                .Val(origin) -> related.push(lsp_related_location_json(lsp_path_to_uri(origin.path), origin.source, span, cause.what))
                .None -> related.push(lsp_related_location_json(uri, src, span, cause.what))
            }
            break
        }
    }
    if related.len() == 0 -> return ""
    ",\"relatedInformation\":[{related.join(",")}]"
}

lsp_related_location_json: fn(uri: String, src: String, span: Span, what: String) -> String Never! {
    "{{\"location\":{{\"uri\":{foundation_json_quote(uri)},\"range\":{lsp_range_json(lsp_byte_span_to_range(src, lsp_clamped_span(src, span)))}}},\"message\":{foundation_json_quote(what)}}}"
}

// The diagnostics reported in the document itself: those with no origin, and
// those whose origin is this path with the document's current text.
lsp_retain_document_diagnostics: fn(diagnostics: [Diagnostic], path: String, text: String) -> [Diagnostic] Never! {
    retained := [Diagnostic]{}
    loop diagnostic in diagnostics {
        keep := true
        if diagnostic.origin == .Val(origin) -> keep = lsp_source_paths_equal(origin.path, path) && origin.source == text
        if keep -> retained.push(diagnostic.copy())
    }
    retained
}

// Republish every dirty document and the open documents that read one. The
// loop runs this before each request, so a request sees current diagnostics.
lsp_flush_dirty: fn(server: &LSPServer, stdout: &lsp_diag_term.Stdout) IOError! {
    pending: lsp_dirty_documents(server.diagnostic_state)
    loop uri in pending -> lsp_publish_document_diagnostics(server, uri, stdout) ?? return Err(err)
}

// The publication is recorded only after every write and flush succeeded, so
// a failed write leaves the previous publication's facts in place.
lsp_publish_document_diagnostics: fn(server: &LSPServer, uri: String, stdout: &lsp_diag_term.Stdout) IOError! {
    doc: server.diagnostic_state.docs.get(uri) ?? return
    checked: server.check(doc)
    targets := [String:Bool]{}
    groups: lsp_diagnostic_groups(server.diagnostic_state, uri, checked, targets)
    ordered := [String]{}
    loop (target, _) in groups -> ordered.push(target)
    ordered.sort()
    loop target in ordered {
        lsp_write_message(stdout, lsp_document_group_json(server.diagnostic_state, target, checked.diagnostics, groups[target])) ?? return Err(err)
    }
    server.diagnostic_state.diagnostic_targets[uri] = targets
    server.diagnostic_state.checked_modules[uri] = lsp_checked_module_paths(checked)
    server.published[uri] = checked
}

lsp_document_group_json: fn(state: LSPDiagnosticState, target: String, diagnostics: [Diagnostic], indices: [Int]) -> String Never! {
    loop index in indices {
        if diagnostics[index].origin == .Val(origin) {
            version := Int?{None}
            if state.docs.get(target) == .Val(open) {
                if open.text == origin.source -> version = Val(open.version)
            }
            return lsp_publish_diagnostics(target, origin.source, version, diagnostics, indices)
        }
    }
    if state.docs.get(target) == .Val(open) -> return lsp_publish_diagnostics(target, open.text, Val(open.version), diagnostics, indices)
    lsp_publish_diagnostics(target, "", None, diagnostics, indices)
}

// didClose drops the document and marks the open documents that read it
// dirty, then clears each URI only this root's publication held. The state
// changes even when a clear's write fails.
lsp_close_document: fn(server: &LSPServer, uri: String, stdout: &lsp_diag_term.Stdout) IOError! -[IO]> {
    _ := server.published.remove(uri)
    lsp_close_document_state(server.diagnostic_state, uri, stdout) ?? return Err(err)
}

lsp_close_document_state: fn(state: &LSPDiagnosticState, uri: String, stdout: &lsp_diag_term.Stdout) IOError! -[IO]> {
    if state.docs.remove(uri) == .Val(doc) {
        readers := [String]{}
        loop (root, modules) in state.checked_modules {
            if root == uri || !state.docs.has_key(root) -> next
            if lsp_reads_any(modules, [String]{doc.path.copy()}) -> readers.push(root.copy())
        }
        loop root in readers -> state.dirty[root] = true
    }
    _ := state.checked_modules.remove(uri)
    _ := state.dirty.remove(uri)
    targets: state.diagnostic_targets.remove(uri) ?? return
    loop (target, _) in targets {
        if lsp_target_retained_elsewhere(state, uri, target) -> next
        lsp_write_message(stdout, lsp_publish_diagnostics(target, "", None, [Diagnostic]{}, [Int]{})) ?? return Err(err)
    }
}
