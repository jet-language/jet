// Publishing diagnostics. A check of one open document reports diagnostics in
// every file it read; each lands on that file's URI, and a later publication
// clears the URIs the previous one wrote that no longer have any.
use {
    lsp_diag_term: core.term
    jet_foundation.[Diagnostic, DiagnosticRecord, DiagnosticRecordOrigin, Span, diagnostic_cause_matches, diagnostic_record, diagnostic_tier_word, foundation_json_quote, sha256_hex]
}

// One framed JSON-RPC message: its header counts bytes, not characters.
lsp_write_message: fn(stdout: ^lsp_diag_term.Stdout, json: String) -[IO]> IOError! {
    stdout.write("Content-Length: {json.count_bytes()}\r\n\r\n{json}") ?? return Err(err)
    stdout.flush() ?? return Err(err)
}

// Two spellings of one file: equal, or equal once leading `./` are dropped.
lsp_source_paths_equal: fn(left: String, right: String) -> Bool Never! {
    if left == right -> return true
    lsp_strip_dot_slash(left) == lsp_strip_dot_slash(right)
}

lsp_strip_dot_slash: fn(path: String) -> String Never! {
    ^out: path
    loop out.starts_with("./") -> out = out.slice(2, out.len())
    out
}

// The dirty documents, sorted, then each open document whose last check read
// one of them. Draining clears the dirty set.
lsp_dirty_documents: fn(state: ^LSPDiagnosticState) -> [String] Never! {
    ^dirty: [String]{}
    ^dirty_set: [String:Bool]{}
    ^changed: [String]{}
    loop (uri, _) in state.dirty {
        dirty.push(uri.copy())
        dirty_set[uri] = true
        if state.docs.get(uri) == .Val(doc) -> changed.push(doc.path.copy())
    }
    state.dirty = [String:Bool]{}
    dirty.sort()
    ^dependents: [String]{}
    loop (root, modules) in state.checked_modules {
        if dirty_set.has_key(root) || !state.docs.has_key(root) -> next
        if lsp_reads_any(modules, changed) -> dependents.push(root.copy())
    }
    dependents.sort()
    loop root in dependents -> dirty.push(root)
    dirty
}

lsp_reads_any: fn(modules: [String], paths: [String]) -> Bool Never! {
    loop module_path in modules {
        loop path in paths {
            if lsp_source_paths_equal(module_path, path) -> return true
        }
    }
    false
}

lsp_target_retained_elsewhere: fn(state: LSPDiagnosticState, root: String, target: String) -> Bool Never! {
    loop (other, targets) in state.diagnostic_targets {
        if other != root && targets.has_key(target) -> return true
    }
    false
}

lsp_checked_module_paths: fn(checked: LSPChecked) -> [String] Never! {
    paths: loop module_ref in checked.modules -> if module_ref.physical_path != "" -> module_ref.physical_path else -> module_ref.path
    paths
}

// The diagnostic indices for each target URI, in diagnostic order. The root
// always has a group, even an empty one. A target the previous publication
// wrote gets an empty group (a clear) unless another root still holds it and
// this check no longer read it.
lsp_diagnostic_groups: fn(state: LSPDiagnosticState, uri: String, checked: LSPChecked, targets: ^[String:Bool]) -> [String:[Int]] Never! {
    ^groups: [String:[Int]]{}
    groups[uri] = [Int]{}
    loop (index, diagnostic) in checked.diagnostics {
        lsp_diagnostic_group_add(groups, state, uri, diagnostic, index)
    }
    loop (target, _) in groups -> targets[target] = true
    if state.diagnostic_targets.get(uri) == .Val(previous) {
        read: lsp_checked_module_paths(checked)
        loop (target, _) in previous {
            if groups.has_key(target) -> next
            still_checked: lsp_reads_any(read, [String]{lsp_uri_to_path(target)})
            if still_checked || !lsp_target_retained_elsewhere(state, uri, target) {
                groups[target] = [Int]{}
            }
        }
    }
    groups
}

// Adds the diagnostic at `index` of `uri`'s check to the group of the URI it
// lands on: the open document holding the file the driver placed it in, else
// that file, else `uri` itself.
lsp_diagnostic_group_add: fn(groups: ^[String:[Int]], state: LSPDiagnosticState, uri: String, diagnostic: Diagnostic, index: Int) Never! {
    if diagnostic.origin == .Val(origin) {
        loop (open_uri, open) in state.docs {
            if lsp_source_paths_equal(open.path, origin.path) || lsp_source_paths_equal(lsp_doc_check_path(open), origin.path) {
                lsp_group_add(groups, open_uri, index)
                return
            }
        }
        // Compiler-embedded virtual sources (`<corelib>/...`, `<prelude>`) are
        // not workspace files and must never be published as bogus `file://` URIs.
        if origin.path.starts_with("<") -> return
        lsp_group_add(groups, lsp_path_to_uri(origin.path), index)
        return
    }
    lsp_group_add(groups, uri, index)
}

lsp_group_add: fn(groups: ^[String:[Int]], target: String, index: Int) Never! {
    if !groups.has_key(target) -> groups[target] = [Int]{}
    groups[target].push(index)
}

// Whether a diagnostic of `uri`'s check lands on `uri` itself, as
// lsp_diagnostic_group_add places it.
lsp_diagnostic_lands_on_root: fn(state: LSPDiagnosticState, uri: String, diagnostic: Diagnostic) -> Bool Never! {
    origin: diagnostic.origin ?? return true
    loop (open_uri, open) in state.docs {
        if lsp_source_paths_equal(open.path, origin.path) || lsp_source_paths_equal(lsp_doc_check_path(open), origin.path) {
            return open_uri == uri
        }
    }
    lsp_path_to_uri(origin.path) == uri
}

lsp_publish_diagnostics: fn(uri: String, version: Int?, items: String) -> String Never! {
    version_json: if version == .Val(value) -> ",\"version\":{value}" else -> ""
    "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{{\"uri\":{foundation_json_quote(uri)}{version_json},\"diagnostics\":{items}}}}}"
}

lsp_diagnostic_items_json: fn(uri: String, src: String, diagnostics: [Diagnostic], reports: [String], indices: [Int]) -> String Never! {
    ^items: [String]{}
    loop index in indices {
        report: if index < reports.len() -> reports[index] else -> ""
        items.push(lsp_diagnostic_json(diagnostics[index], src, uri, diagnostics, report))
    }
    "[{items.join(",")}]"
}

// The protocol diagnostic converts the one record (DiagnosticRecord) at the
// edge: severity from its severity and tier, the range from its span over
// `src`, the text whose SHA-256 its origin holds, and its code and message.
// The host's whole report, when it rendered one, is its `data`.
lsp_diagnostic_json: fn(diagnostic: Diagnostic, src: String, uri: String, diagnostics: [Diagnostic], report: String) -> String Never! {
    record: lsp_diagnostic_record(diagnostic)
    severity: if lsp_record_is_warning(record, diagnostic) -> 2 else -> 1
    range: if record.span == {
        .Val(span) -> lsp_byte_span_to_range(src, lsp_clamped_span(src, Span{start: span.start, end: span.end}))
        .None -> lsp_full_document_range(src)
    }
    related: lsp_related_information_json(diagnostic, uri, src, diagnostics)
    data: if report.len() > 0 -> ",\"data\":{report}" else -> ""
    "{{\"range\":{lsp_range_json(range)},\"severity\":{severity},\"code\":{foundation_json_quote(record.code)},\"source\":\"jet\",\"message\":{foundation_json_quote(record.message)},\"codeDescription\":{{\"href\":{foundation_json_quote(lsp_diagnostic_explanation_uri(record.code))}}}{related}{data}}}"
}

// A warning-tier lint; every other diagnostic is an error.
lsp_record_is_warning: fn(record: DiagnosticRecord, diagnostic: Diagnostic) -> Bool Never! {
    record.severity == "lint" && (diagnostic_tier_word(diagnostic) ?? "") == "warning"
}

// The record of a checked diagnostic, named by the physical path of the file
// the driver placed it in (its origin); an unplaced one names the document.
lsp_diagnostic_record: fn(diagnostic: Diagnostic) -> DiagnosticRecord Never! {
    if diagnostic.origin == .Val(placed) {
        return diagnostic_record(diagnostic, placed.path, Val(DiagnosticRecordOrigin{path: Val("{placed.path}"), source_digest: "{placed.revision}"}), [String]{}, [String]{})
    }
    diagnostic_record(diagnostic, "", None, [String]{}, [String]{})
}

// A report's span bounded to its source, on character boundaries.
lsp_clamped_span: fn(src: String, span: Span) -> Span Never! {
    bytes: src.bytes()
    ^start: if {
        span.start < 0 -> 0
        span.start > bytes.len() -> bytes.len()
        else -> span.start
    }
    ^end: if {
        span.end < start -> start
        span.end > bytes.len() -> bytes.len()
        else -> span.end
    }
    loop start > 0 && start < bytes.len() && (Int{bytes[start]} & 192) == 128 -> start -= 1
    loop end < bytes.len() && (Int{bytes[end]} & 192) == 128 -> end += 1
    Span{start: start, end: end}
}

lsp_diagnostic_explanation_uri: fn(code: String) -> String Never! { "jet://explain/{code}" }

// Each cause names an earlier report by code, span and source; the first
// report it matches with a span becomes a related location.
lsp_related_information_json: fn(diagnostic: Diagnostic, uri: String, src: String, diagnostics: [Diagnostic]) -> String Never! {
    ^related: [String]{}
    loop identity in diagnostic.cause {
        loop cause in diagnostics {
            if !diagnostic_cause_matches(identity, cause) -> next
            span: cause.span ?? next
            if cause.origin == {
                .Val(origin) -> {
                    related.push(lsp_related_location_json(lsp_path_to_uri(origin.path), origin.source, span, cause.what))
                }
                .None -> related.push(lsp_related_location_json(uri, src, span, cause.what))
            }
            break
        }
    }
    if related.len() == 0 -> return ""
    ",\"relatedInformation\":[{related.join(",")}]"
}

lsp_related_location_json: fn(uri: String, src: String, span: Span, what: String) -> String Never! {
    "{{\"location\":{{\"uri\":{foundation_json_quote(uri)},\"range\":{lsp_range_json(lsp_byte_span_to_range(src, lsp_clamped_span(src, span)))}}},\"message\":{foundation_json_quote(what)}}}"
}

// The diagnostics reported in the document itself: those with no origin, and
// those whose origin is this path with the digest of the document's current
// text.
lsp_retain_document_diagnostics: fn(diagnostics: [Diagnostic], path: String, text: String) -> [Diagnostic] Never! {
    ^retained: [Diagnostic]{}
    ^digest: ""
    loop diagnostic in diagnostics {
        ^keep: true
        if diagnostic.origin == .Val(origin) {
            if digest == "" -> digest = sha256_hex(text)
            keep = lsp_source_paths_equal(origin.path, path) && origin.revision == digest
        }
        if keep -> retained.push(diagnostic.copy())
    }
    retained
}

// Republish every dirty document and the open documents that read one. The
// loop runs this before each request, so a request sees current diagnostics.
// A document whose newer edit is already queued stays dirty, unpublished,
// until that edit is applied.
lsp_flush_dirty: fn(server: ^LSPServer, input: LSPInput, stdout: ^lsp_diag_term.Stdout) IOError! {
    ^pending: lsp_dirty_documents(server.diagnostic_state)
    pending.reverse()
    loop !pending.is_empty() {
        uri: pending.pop() ?? return
        if {
            lsp_edit_queued(input, uri) -> server.diagnostic_state.dirty[uri] = true
            else -> lsp_publish_document_diagnostics(server, uri, stdout) ?? return Err(err)
        }
    }
}

// The publication is recorded only after every write and flush succeeded, so
// a failed write leaves the previous publication's facts in place.
lsp_publish_document_diagnostics: fn(server: ^LSPServer, uri: String, stdout: ^lsp_diag_term.Stdout) IOError! {
    doc: server.diagnostic_state.docs.get(uri) ?? return
    checked: server.check(doc)
    ^targets: [String:Bool]{}
    groups: lsp_diagnostic_groups(server.diagnostic_state, uri, checked, targets)
    ^ordered: [String]{}
    loop (target, _) in groups -> ordered.push(target)
    ordered.sort()
    // A client that pulls diagnostics asks for them; the publication is
    // still recorded, as the dirty documents and the clears read it.
    if !server.pull_diagnostics {
        loop target in ordered {
            lsp_write_message(stdout, lsp_document_group_json(server.diagnostic_state, target, checked, groups[target])) ?? return Err(err)
        }
    }
    server.diagnostic_state.diagnostic_targets[uri] = targets
    server.diagnostic_state.checked_modules[uri] = lsp_checked_module_paths(checked)
    server.published[uri] = checked
}

// A group's items and the document version they are bound to. Their ranges
// are measured in the text the group's diagnostics' origin read, bound to
// the open document only when the open text's digest is that origin's; else
// in the open document's text; else in none.
LSPGroupItems: struct {
    items: String,
    version: Int?,
}

lsp_group_items: fn(state: LSPDiagnosticState, target: String, checked: LSPChecked, indices: [Int]) -> LSPGroupItems Never! {
    loop index in indices {
        if checked.diagnostics[index].origin == .Val(origin) {
            ^version: Int?{None}
            if state.docs.get(target) == .Val(open) {
                if sha256_hex(open.text) == origin.revision -> version = Val(open.version)
            }
            return LSPGroupItems{items: lsp_diagnostic_items_json(target, origin.source, checked.diagnostics, checked.reports, indices), version: version}
        }
    }
    if state.docs.get(target) == .Val(open) {
        return LSPGroupItems{items: lsp_diagnostic_items_json(target, open.text, checked.diagnostics, checked.reports, indices), version: Val(open.version)}
    }
    LSPGroupItems{items: lsp_diagnostic_items_json(target, "", checked.diagnostics, checked.reports, indices), version: None}
}

lsp_document_group_json: fn(state: LSPDiagnosticState, target: String, checked: LSPChecked, indices: [Int]) -> String Never! {
    group: lsp_group_items(state, target, checked, indices)
    lsp_publish_diagnostics(target, group.version, group.items)
}

// A pulled report of the open document `uri`, from its own check: the
// diagnostics that land on it. Its result id is the digest of its items, so
// a client naming that id as its previous one is told it is unchanged, and
// no earlier answer needs keeping. The report's members, without braces.
lsp_pull_report: fn(server: LSPServer, uri: String, previous: String?) -> String {
    view: lsp_view_of(server, uri) ?? return "\"kind\":\"full\",\"resultId\":\"{sha256_hex("[]")}\",\"items\":[]"
    ^indices: [Int]{}
    loop (index, diagnostic) in view.checked.diagnostics {
        if lsp_diagnostic_lands_on_root(server.diagnostic_state, uri, diagnostic) {
            indices.push(index)
        }
    }
    items: lsp_group_items(server.diagnostic_state, uri, view.checked, indices).items
    result_id: sha256_hex(items)
    if previous == .Val(seen) && seen == result_id {
        return "\"kind\":\"unchanged\",\"resultId\":\"{result_id}\""
    }
    "\"kind\":\"full\",\"resultId\":\"{result_id}\",\"items\":{items}"
}

// `textDocument/diagnostic`: the document's pulled report.
lsp_document_diagnostic_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    uri: lsp_params_uri(params) ?? return lsp_error_response(id, -32602, "textDocument/diagnostic needs a textDocument")
    lsp_response(id, "{{{lsp_pull_report(server, uri, lsp_text_member(params ?? Dyn.Null, "previousResultId"))}}}")
}

// `workspace/diagnostic`: the pulled report of every open document, each
// with its URI and version, in URI order. A file no editor holds is not
// checked by the server, so it has no report.
lsp_workspace_diagnostic_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    ^previous: [String:String]{}
    loop row in lsp_member_rows(params ?? Dyn.Null, "previousResultIds") {
        uri: lsp_text_member(row, "uri") ?? next
        previous[uri] = lsp_text_member(row, "value") ?? next
    }
    ^uris: [String]{}
    loop (uri, _) in server.diagnostic_state.docs -> uris.push(uri.copy())
    uris.sort()
    ^reports: [String]{}
    loop uri in uris {
        doc: server.diagnostic_state.docs.get(uri) ?? next
        reports.push("{{\"uri\":{foundation_json_quote(uri)},\"version\":{doc.version},{lsp_pull_report(server, uri, previous.get(uri))}}}")
    }
    lsp_response(id, "{{\"items\":[{reports.join(",")}]}}")
}

// didClose drops the document and its kept semantic tokens and marks the
// open documents that read it dirty, then clears each URI only this root's
// publication held. The state changes even when a clear's write fails.
lsp_close_document: fn(server: ^LSPServer, uri: String, stdout: ^lsp_diag_term.Stdout) -[IO]> IOError! {
    ^_: server.published.remove(uri)
    ^_: server.semantic_results.remove(uri)
    lsp_close_document_state(server.diagnostic_state, uri, stdout) ?? return Err(err)
}

lsp_close_document_state: fn(state: ^LSPDiagnosticState, uri: String, stdout: ^lsp_diag_term.Stdout) -[IO]> IOError! {
    if state.docs.remove(uri) == .Val(doc) {
        closed: [String]{doc.path}
        ^readers: [String]{}
        loop (root, modules) in state.checked_modules {
            if root == uri || !state.docs.has_key(root) -> next
            if lsp_reads_any(modules, closed) -> readers.push(root.copy())
        }
        loop root in readers -> state.dirty[root] = true
    }
    ^_: state.checked_modules.remove(uri)
    ^_: state.dirty.remove(uri)
    targets: state.diagnostic_targets.remove(uri) ?? return
    loop (target, _) in targets {
        if lsp_target_retained_elsewhere(state, uri, target) -> next
        lsp_write_message(stdout, lsp_publish_diagnostics(target, None, "[]")) ?? return Err(err)
    }
}
