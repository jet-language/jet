// Folding ranges: brace blocks and block comments from the document's tokens,
// so a brace inside a string or comment never folds, and runs of line
// comments and `use` lines.
use {
    jet_foundation.[COMMENT_PREFIX, Span, foundation_json_quote]
    jet_lexer.[Lexed, TOKEN_BLOCK_COMMENT, TOKEN_LBRACE, TOKEN_RBRACE]
}

LSPFoldingRange: struct {
    start_line: Int
    start_character: Int
    end_line: Int
    end_character: Int
    kind: String
}

lsp_folding_range_json: fn(fold: LSPFoldingRange) -> String Never! {
    "{{\"startLine\":{fold.start_line},\"startCharacter\":{fold.start_character},\"endLine\":{fold.end_line},\"endCharacter\":{fold.end_character},\"kind\":{foundation_json_quote(fold.kind)}}}"
}

lsp_compute_folding_ranges: fn(src: String, lexed: Lexed) -> [LSPFoldingRange] Never! {
    bytes: src.bytes()
    table: lsp_line_table_bytes(bytes)
    folds := [LSPFoldingRange]{}
    open := [Int]{}
    loop token in lexed.tokens {
        if token.kind == TOKEN_LBRACE -> open.push(token.span.start)
        if token.kind == TOKEN_RBRACE {
            if open.pop() == .Val(start) -> lsp_push_fold(bytes, table, start, token.span.start, "region", folds)
        }
        if token.kind == TOKEN_BLOCK_COMMENT -> lsp_push_fold(bytes, table, token.span.start, token.span.end, "comment", folds)
    }
    lsp_line_group_folds(src, table.lines, COMMENT_PREFIX, "comment", folds)
    lsp_line_group_folds(src, table.lines, "use ", "imports", folds)
    folds.sort_by(fn(left: LSPFoldingRange, right: LSPFoldingRange) { (left.start_line <=> right.start_line).then(left.start_character <=> right.start_character).then(left.end_line <=> right.end_line) })
    folds
}

lsp_push_fold: fn(bytes: [U8], table: LineTable, start: Int, end: Int, kind: String, folds: &[LSPFoldingRange]) Never! {
    first: lsp_byte_offset_in_table(bytes, table, start)
    last: lsp_byte_offset_in_table(bytes, table, end)
    if last.line > first.line -> folds.push(LSPFoldingRange{start_line: first.line, start_character: first.character, end_line: last.line, end_character: last.character, kind: kind})
}

// The byte offset of a line's first character that is not a space or tab.
lsp_indent_end: fn(bytes: [U8], line: Span) -> Int Never! {
    at := line.start
    loop at < line.end && (bytes[at] == (U8{32}) || bytes[at] == (U8{9})) -> at += 1
    at
}

lsp_line_starts_with: fn(src: String, line: Span, prefix: String) -> Bool Never! {
    start: lsp_indent_end(src.bytes(), line)
    start + prefix.count_bytes() <= line.end && src.slice(start, start + prefix.count_bytes()) == prefix
}

// A run of two or more lines starting with `prefix` folds from the first
// line's text to the end of the last.
lsp_line_group_folds: fn(src: String, lines: [Span], prefix: String, kind: String, folds: &[LSPFoldingRange]) Never! {
    bytes: src.bytes()
    run_start := -1
    loop index in 0..<(lines.len() + 1) {
        matched: index < lines.len() && lsp_line_starts_with(src, lines[index], prefix)
        if matched {
            if run_start < 0 -> run_start = index
            next
        }
        if run_start >= 0 && index - 1 > run_start {
            first: lines[run_start]
            last: lines[index - 1]
            folds.push(LSPFoldingRange{
                start_line: run_start,
                start_character: lsp_utf16_length(bytes, first.start, lsp_indent_end(bytes, first)),
                end_line: index - 1,
                end_character: lsp_utf16_length(bytes, last.start, last.end),
                kind: kind,
            })
        }
        run_start = -1
    }
}
