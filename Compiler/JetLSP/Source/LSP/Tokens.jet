// Semantic tokens: the lexer classifies keywords, literals and comments; the
// checked index classifies each name by what it names, each name a written
// type holds as a type, marks the declarations and marks a name a call
// writes through as a modification; a marked block's `lsp.semantic_tokens`
// hooks classify its body. A retired word no grammar rule accepts is no
// keyword. A `#` form is one token over its `#` and word: a marker is a
// decorator, and a compiler word, fact root or `#{…}` paste is a keyword
// marked macro. Types and modifiers index `LSP_SEMANTIC_TOKEN_TYPES` and
// `LSP_SEMANTIC_TOKEN_MODIFIERS`. A full answer is kept per document so a
// delta request answers only the change.
use {
    core.encoding.[Dyn]
    jet_driver.[JetDriverToolStageItem]
    jet_foundation.[AccessConvention, CORE_DECLARATIONS_SYNTAX_FILES, CoreDeclarationFile, Span, TOOL_STAGE_LSP_SEMANTIC_TOKENS, core_decl_syntax_constants, foundation_byte_text, foundation_json_quote, marker_registered]
    jet_lexer.[Token, TOKEN_IDENT, TOKEN_SELF, TOKEN_RAW_STRING, TOKEN_STRING, TOKEN_INT, TOKEN_FLOAT, TOKEN_UNIT_NUMBER, TOKEN_CHAR, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT, TOKEN_TRUE, TOKEN_RETURN, TOKEN_KW_FN, TOKEN_KW_MODULE, TOKEN_KW_MUTATE, TOKEN_KW_MOVE, TOKEN_KW_COPY, TOKEN_KW_CONST, TOKEN_DOT, TOKEN_COLON, TOKEN_HASH, TOKEN_PREP, token_text]
    jet_semindex.[SemKind]
}

LSP_TOKEN_KEYWORD: 0

LSP_TOKEN_TYPE: 1

LSP_TOKEN_FUNCTION: 2

LSP_TOKEN_VARIABLE: 3

LSP_TOKEN_PARAMETER: 4

LSP_TOKEN_PROPERTY: 5

LSP_TOKEN_ENUM_MEMBER: 6

LSP_TOKEN_STRING: 7

LSP_TOKEN_NUMBER: 8

LSP_TOKEN_COMMENT: 9

LSP_TOKEN_NAMESPACE: 11

LSP_TOKEN_DECORATOR: 12

LSP_MODIFIER_DECLARATION: 1

LSP_MODIFIER_READONLY: 2

LSP_MODIFIER_MODIFICATION: 4

// A word the compiler acts on while building, not a name of the program.
LSP_MODIFIER_MACRO: 8

// A name's class: its semantic token type and modifier bits.
LSPNameClass: struct {
    kind: Int,
    modifiers: Int,
}

// A reference anchor's kind, as the index spells it.
lsp_anchor_class: fn(kind: String) -> LSPNameClass? Never! {
    if kind == {
        "module" -> Val(LSPNameClass{kind: LSP_TOKEN_NAMESPACE, modifiers: 0})
        "function" -> Val(LSPNameClass{kind: LSP_TOKEN_FUNCTION, modifiers: 0})
        "struct" | "enum" | "trait" | "tag" | "type" -> Val(LSPNameClass{kind: LSP_TOKEN_TYPE, modifiers: 0})
        "const" -> Val(LSPNameClass{kind: LSP_TOKEN_VARIABLE, modifiers: LSP_MODIFIER_READONLY})
        "variant" -> Val(LSPNameClass{kind: LSP_TOKEN_ENUM_MEMBER, modifiers: 0})
        "field" -> Val(LSPNameClass{kind: LSP_TOKEN_PROPERTY, modifiers: 0})
        "local" -> Val(LSPNameClass{kind: LSP_TOKEN_VARIABLE, modifiers: 0})
        "param" -> Val(LSPNameClass{kind: LSP_TOKEN_PARAMETER, modifiers: 0})
        else -> None
    }
}

lsp_definition_class: fn(kind: SemKind) -> LSPNameClass Never! {
    if kind == {
        .Module -> LSPNameClass{kind: LSP_TOKEN_NAMESPACE, modifiers: LSP_MODIFIER_DECLARATION}
        .Function(_) -> LSPNameClass{kind: LSP_TOKEN_FUNCTION, modifiers: LSP_MODIFIER_DECLARATION}
        .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) -> LSPNameClass{kind: LSP_TOKEN_TYPE, modifiers: LSP_MODIFIER_DECLARATION}
        .Const -> LSPNameClass{kind: LSP_TOKEN_VARIABLE, modifiers: LSP_MODIFIER_DECLARATION | LSP_MODIFIER_READONLY}
        .EnumVariant(_) -> LSPNameClass{kind: LSP_TOKEN_ENUM_MEMBER, modifiers: LSP_MODIFIER_DECLARATION}
        .Field(_, _) -> LSPNameClass{kind: LSP_TOKEN_PROPERTY, modifiers: LSP_MODIFIER_DECLARATION}
        .Local(mutable, _) -> LSPNameClass{kind: LSP_TOKEN_VARIABLE, modifiers: if mutable -> LSP_MODIFIER_DECLARATION else -> LSP_MODIFIER_DECLARATION | LSP_MODIFIER_READONLY}
        .Param(_) -> LSPNameClass{kind: LSP_TOKEN_PARAMETER, modifiers: LSP_MODIFIER_DECLARATION}
    }
}

// Each checked name in the document, keyed by the byte offset its name ends
// at: a reference's span can cover a qualified path whose last segment is the
// name token.
lsp_name_classes: fn(view: LSPView) -> [Int:LSPNameClass] Never! {
    classes := [Int:LSPNameClass]{}
    index: view.checked.index ?? return classes
    module_path: view.module_path ?? return classes
    loop reference in index.references {
        if reference.module_path != module_path -> next
        anchor: reference.target ?? next
        if lsp_anchor_class(anchor.kind) == .Val(class) -> classes[reference.span.end] = class
    }
    loop definition in index.definitions {
        if definition.def.module_path == module_path {
            classes[definition.def.def_span.end] = lsp_definition_class(definition.def.kind)
        }
    }
    // A name a written type holds is a type, or the module that qualifies
    // one (`geo.Point`); a name before `:` there labels a function type's
    // parameter.
    tokens: view.lexed.tokens
    loop node in index.nodes {
        if node.class != "type" || node.module_path != module_path -> next
        at := lsp_first_token_from(tokens, node.span.start)
        loop at < tokens.len() && tokens[at].span.start < node.span.end {
            token: tokens[at]
            following: if at + 1 < tokens.len() -> tokens[at + 1].kind else -> -1
            if token.kind == TOKEN_IDENT && following != TOKEN_COLON && !classes.has_key(token.span.end) {
                kind: if following == TOKEN_DOT -> LSP_TOKEN_NAMESPACE else -> LSP_TOKEN_TYPE
                classes[token.span.end] = LSPNameClass{kind: kind, modifiers: 0}
            }
            at += 1
        }
    }
    // An argument or receiver a call writes, so an editor can underline it. A
    // written name is a place, so one the index left unresolved is a variable.
    loop mark in lsp_call_marks(view, index) {
        if mark.access != AccessConvention.Write -> next
        place: mark.place ?? next
        class: classes.get(place.end) ?? LSPNameClass{kind: LSP_TOKEN_VARIABLE, modifiers: 0}
        classes[place.end] = LSPNameClass{kind: class.kind, modifiers: class.modifiers | LSP_MODIFIER_MODIFICATION}
    }
    classes
}

// The index of the first of `tokens` that starts at or after `offset`.
lsp_first_token_from: fn(tokens: [Token], offset: Int) -> Int Never! {
    low := 0
    high := tokens.len()
    loop low < high {
        middle: (low + high) /% 2
        if tokens[middle].span.start < offset -> low = middle + 1 else -> high = middle
    }
    low
}

lsp_token_class: fn(token: Token, classes: [Int:LSPNameClass]) -> LSPNameClass? Never! {
    kind: token.kind
    if kind == TOKEN_IDENT -> return classes.get(token.span.end)
    // `self` a call writes through is classed as that write.
    if kind == TOKEN_SELF && classes.has_key(token.span.end) -> return classes.get(token.span.end)
    if lsp_retired_word_kind(kind) -> return None
    if lsp_keyword_token_kind(kind) {
        return Val(LSPNameClass{kind: LSP_TOKEN_KEYWORD, modifiers: 0})
    }
    if kind == TOKEN_STRING || kind == TOKEN_RAW_STRING || kind == TOKEN_CHAR {
        return Val(LSPNameClass{kind: LSP_TOKEN_STRING, modifiers: 0})
    }
    if kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER {
        return Val(LSPNameClass{kind: LSP_TOKEN_NUMBER, modifiers: 0})
    }
    if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT {
        return Val(LSPNameClass{kind: LSP_TOKEN_COMMENT, modifiers: 0})
    }
    None
}

// The lexer kinds of the language's keywords, `true` through `return` and
// `fn` through `module`.
lsp_keyword_token_kind: fn(kind: Int) -> Bool Never! {
    (kind >= TOKEN_TRUE && kind <= TOKEN_RETURN) || (kind >= TOKEN_KW_FN && kind <= TOKEN_KW_MODULE)
}

// The retired words the lexer keeps reserved though no grammar rule accepts
// them (`mut`, `take`, `copy`, `const`); after a dot such a word names a
// method.
lsp_retired_word_kind: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_MUTATE || kind == TOKEN_KW_MOVE || kind == TOKEN_KW_COPY || kind == TOKEN_KW_CONST
}

// A classified stretch of the document.
LSPClassedSpan: struct {
    span: Span,
    class: LSPNameClass,
}

// The words a `#` makes a compiler word or fact root, read from the Syntax
// registry's rows: its `PREP_` requests (`#run`, `#if`, `#loop`),
// `CODE_VALUE` (`#code`) and each `FACT_ROOT_` root, each without its `#`.
LSP_COMPILER_WORDS: #run lsp_compiler_words(CORE_DECLARATIONS_SYNTAX_FILES)

lsp_compiler_words: fn(syntax: [CoreDeclarationFile]) -> [String] Never! {
    constants: core_decl_syntax_constants(syntax) ?? panic("the Syntax registry does not read: {err.message}")
    words := [String]{}
    loop (row, text) in constants.values {
        name: constants.names.texts[row]
        compiler: name.starts_with("PREP_") || name.starts_with("FACT_ROOT_") || name == "CODE_VALUE"
        if compiler && text.starts_with("#") {
            words.push(foundation_byte_text(text.bytes(), 1, text.count_bytes()))
        }
    }
    words
}

// The `#` forms of a document as whole spans, and which of its tokens they
// cover.
LSPHashForms: struct {
    spans: [LSPClassedSpan],
    covered: [Bool],
}

// Each `#` form, classed from its `#` through its word: a compiler word or
// fact root and a `#{…}` paste are keywords marked macro. A bare marker is a
// decorator when the registry holds it or the index resolves it to a declared
// marker type; a marker written through its package (`#tools.Query`) is one
// decorator over the whole dotted name, since only a fact root, which is
// classed first, may also stand before a `.`. A `#` before any other word
// stays unclassed.
lsp_hash_forms: fn(view: LSPView, classes: [Int:LSPNameClass]) -> LSPHashForms Never! {
    tokens: view.lexed.tokens
    bytes: view.doc.text.bytes()
    compiler: LSPNameClass{kind: LSP_TOKEN_KEYWORD, modifiers: LSP_MODIFIER_MACRO}
    forms := LSPHashForms{spans: [LSPClassedSpan]{}, covered: [Bool]{}}
    loop _ in tokens -> forms.covered.push(false)
    loop (at, token) in tokens {
        // A paste is one identifier token that starts at its `#`; `#run` is
        // one request token.
        paste: token.kind == TOKEN_IDENT && token.span.start < bytes.len() && (Int{bytes[token.span.start]}) == 35
        if paste || (token.kind == TOKEN_PREP && token.span.end - token.span.start > 1) {
            forms.spans.push(LSPClassedSpan{span: token.span, class: compiler})
            forms.covered[at] = true
            next
        }
        if (token.kind != TOKEN_HASH && token.kind != TOKEN_PREP) || at + 1 >= tokens.len() -> next
        word: tokens[at + 1]
        if word.span.start != token.span.end -> next
        // `#if` and `#loop` are a request `#` and its keyword; a fact root
        // ends at its word, so `.target.os` after `#build` stays fields.
        compiled: token.kind == TOKEN_PREP || (word.kind == TOKEN_IDENT && LSP_COMPILER_WORDS.contains(token_text(view.lexed.tables, word)))
        last := at + 1
        if !compiled {
            if word.kind != TOKEN_IDENT -> next
            loop last + 2 < tokens.len() && tokens[last + 1].kind == TOKEN_DOT && tokens[last + 2].kind == TOKEN_IDENT && tokens[last + 1].span.start == tokens[last].span.end && tokens[last + 2].span.start == tokens[last + 1].span.end {
                last += 2
            }
            // Past the fact roots, a dotted `#` name is a package's marker.
            if last == at + 1 && !lsp_hash_marker(view, classes, word) -> next
        }
        class: if compiled -> compiler else -> LSPNameClass{kind: LSP_TOKEN_DECORATOR, modifiers: 0}
        forms.spans.push(LSPClassedSpan{span: Span{start: token.span.start, end: tokens[last].span.end}, class: class})
        loop covered in at..<(last + 1) -> forms.covered[covered] = true
    }
    forms
}

// Whether a bare `#` name is a marker: one the registry holds, or one the
// index resolves to a declared marker type.
lsp_hash_marker: fn(view: LSPView, classes: [Int:LSPNameClass], name: Token) -> Bool Never! {
    named: classes.get(name.span.end) ?? LSPNameClass{kind: -1, modifiers: 0}
    named.kind == LSP_TOKEN_TYPE || marker_registered(token_text(view.lexed.tables, name))
}

// Whether a hook's token overlaps `span`.
lsp_span_given: fn(given: [LSPClassedSpan], span: Span) -> Bool Never! {
    loop other in given {
        if other.span.start < span.end && span.start < other.span.end -> return true
    }
    false
}

// The protocol's relative encoding of the classified tokens that overlap
// `range`. A token spanning lines is one entry per line, as the protocol
// forbids an entry that crosses a line. A token a marked block's
// `lsp.semantic_tokens` hook gives (`hooked`) takes the place of the lexer
// tokens and `#` forms it overlaps; one of a kind outside
// `LSP_SEMANTIC_TOKEN_TYPES` is left out.
lsp_semantic_token_data: fn(view: LSPView, range: Span, hooked: [JetDriverToolStageItem]) -> [Int] Never! {
    bytes: view.doc.text.bytes()
    table: lsp_line_table_bytes(bytes)
    classes: lsp_name_classes(view)
    given := [LSPClassedSpan]{}
    loop row in hooked {
        loop (kind, name) in LSP_SEMANTIC_TOKEN_TYPES {
            if name == row.kind {
                given.push(LSPClassedSpan{span: Span{start: row.at, end: row.at + row.length}, class: LSPNameClass{kind: kind, modifiers: 0}})
            }
        }
    }
    forms: lsp_hash_forms(view, classes)
    spans := [LSPClassedSpan]{}
    loop (at, token) in view.lexed.tokens {
        if forms.covered[at] -> next
        class: lsp_token_class(token, classes) ?? next
        if !lsp_span_given(given, token.span) {
            spans.push(LSPClassedSpan{span: token.span, class: class})
        }
    }
    loop form in forms.spans {
        if !lsp_span_given(given, form.span) -> spans.push(form)
    }
    loop other in given -> spans.push(other)
    spans.sort_by(fn(left: LSPClassedSpan, right: LSPClassedSpan) { left.span.start <=> right.span.start })
    data := [Int]{}
    previous_line := 0
    previous_start := 0
    loop entry in spans {
        if entry.span.end <= range.start -> next
        if entry.span.start >= range.end -> break
        class: entry.class
        first: lsp_byte_offset_in_table(bytes, table, entry.span.start)
        last: lsp_byte_offset_in_table(bytes, table, entry.span.end)
        line := first.line
        loop line <= last.line {
            content: table.lines[line]
            start: if line == first.line -> entry.span.start else -> content.start
            end: if line == last.line -> entry.span.end else -> content.end
            if end > start {
                character: if line == first.line -> first.character else -> 0
                length: lsp_utf16_length(bytes, start, end)
                delta_start: if line == previous_line -> character - previous_start else -> character
                data.push(line - previous_line)
                data.push(delta_start)
                data.push(length)
                data.push(class.kind)
                data.push(class.modifiers)
                previous_line = line
                previous_start = character
            }
            line += 1
        }
    }
    data
}

// The tokens last answered in full for one document, named by `id`.
LSPSemanticResult: struct {
    id: String,
    data: [Int],
}

lsp_semantic_ints: fn(data: [Int]) -> String Never! {
    rows := [String]{}
    loop value in data -> rows.push("{value}")
    "[{rows.join(",")}]"
}

lsp_semantic_tokens_json: fn(data: [Int]) -> String Never! {
    "{{\"data\":{lsp_semantic_ints(data)}}}"
}

lsp_semantic_full_data: fn(server: LSPServer, view: LSPView) -> [Int] {
    hooked: server.stage_items(view, TOOL_STAGE_LSP_SEMANTIC_TOKENS)
    lsp_semantic_token_data(view, Span{start: 0, end: view.doc.text.count_bytes()}, hooked)
}

// Keeps `data` as the document's last full answer under a new result id.
lsp_semantic_keep: fn(server: ^LSPServer, uri: String, data: ^^[Int]) -> String Never! {
    server.semantic_serial += 1
    server.semantic_results[uri] = LSPSemanticResult{id: "{server.semantic_serial}", data: data.move()}
    "{server.semantic_serial}"
}

// The one edit from `before` to `after`: the integers between their common
// head and common tail; no edit when they are equal.
lsp_semantic_tokens_edits: fn(before: [Int], after: [Int]) -> String Never! {
    head := 0
    loop head < before.len() && head < after.len() && before[head] == after[head] {
        head += 1
    }
    if head == before.len() && head == after.len() -> return "[]"
    tail := 0
    loop tail < before.len() - head && tail < after.len() - head && before[before.len() - 1 - tail] == after[after.len() - 1 - tail] {
        tail += 1
    }
    inserted := [Int]{}
    loop index in head..<after.len() - tail -> inserted.push(after[index])
    "[{{\"start\":{head},\"deleteCount\":{before.len() - head - tail},\"data\":{lsp_semantic_ints(inserted)}}}]"
}

// A full answer carries a result id and is kept, so a later `full/delta`
// naming that id gets only the edit to the current tokens.
lsp_semantic_tokens_response: fn(server: ^LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    data: lsp_semantic_full_data(server, view)
    tokens: lsp_semantic_ints(data)
    result_id: lsp_semantic_keep(server, view.uri, data.move())
    lsp_response(id, "{{\"resultId\":{foundation_json_quote(result_id)},\"data\":{tokens}}}")
}

// A delta naming the document's kept result answers the edit from it; one
// naming any other id, as after a restart, answers the full tokens. Either
// way the current tokens are kept under a new id.
lsp_semantic_tokens_delta_response: fn(server: ^LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    previous_id: lsp_text_member(params ?? return lsp_response(id, "null"), "previousResultId") ?? ""
    data: lsp_semantic_full_data(server, view)
    body := String?{None}
    if server.semantic_results.get(view.uri) == .Val(previous) {
        if previous.id == previous_id -> body = Val("\"edits\":{lsp_semantic_tokens_edits(previous.data, data)}")
    }
    answer: body ?? "\"data\":{lsp_semantic_ints(data)}"
    result_id: lsp_semantic_keep(server, view.uri, data.move())
    lsp_response(id, "{{\"resultId\":{foundation_json_quote(result_id)},{answer}}}")
}

lsp_semantic_tokens_range_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    requested: lsp_range_from_json(lsp_param(params, "range") ?? return lsp_response(id, "null")) ?? return lsp_error_response(id, -32602, "range is malformed")
    bytes: view.doc.text.bytes()
    table: lsp_line_table_bytes(bytes)
    start: lsp_checked_offset_bytes(table, bytes, requested.start) ?? return lsp_error_response(id, -32602, "range is outside the document")
    end: lsp_checked_offset_bytes(table, bytes, requested.end) ?? return lsp_error_response(id, -32602, "range is outside the document")
    hooked: server.stage_items(view, TOOL_STAGE_LSP_SEMANTIC_TOKENS)
    lsp_response(id, lsp_semantic_tokens_json(lsp_semantic_token_data(view, Span{start: start, end: end}, hooked)))
}
