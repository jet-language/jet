// Inlay hints: from the checked index, the type of each local, the parameter
// each positional argument binds, the `&` or `&&` of each argument or
// receiver a call writes or takes, and on a type each method an impl declares
// outside its body; the `?` after each call that passes a failure up by
// itself; then the `lsp.inlay_hints` hooks of a marked block's package label
// places in its body. A request's range keeps the hints inside it, and a
// range past the end of the document stops at its end.
use {
    core.encoding.[Dyn]
    jet_foundation.[AccessConvention, ParamZone, Span, TOOL_STAGE_LSP_INLAY_HINTS, Type, access_sigil, failure_contract_signature_return, foundation_json_quote, type_name]
    jet_lexer.[Lexed, Token, TOKEN_IDENT, TOKEN_SELF, TOKEN_DOT, TOKEN_LPAREN, TOKEN_RPAREN, TOKEN_LBRACKET, TOKEN_RBRACKET, TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_COMMA, TOKEN_COLON, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT, token_text]
    jet_semindex.[SemCallable, SemDef, SemIndex]
}

// InlayHintKind numbers of the protocol.
LSP_INLAY_HINT_TYPE: 1
LSP_INLAY_HINT_PARAMETER: 2

LSPInlayHint: struct {
    at: Int,
    label: String,
    kind: Int?,
}

lsp_inlay_hint_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    bytes: view.doc.text.bytes()
    table: lsp_line_table_bytes(bytes)
    start := 0
    end := bytes.len()
    if lsp_param(params, "range") == .Val(range) {
        requested: lsp_range_from_json(range) ?? return lsp_error_response(id, -32602, "range is malformed")
        start = lsp_checked_offset_bytes(table, bytes, requested.start) ?? return lsp_response(id, "[]")
        end = lsp_checked_offset_bytes(table, bytes, requested.end) ?? bytes.len()
    }
    hints := lsp_checked_inlay_hints(view)
    staged: server.stage_items(view, TOOL_STAGE_LSP_INLAY_HINTS)
    loop row in staged.move() {
        hints.push(LSPInlayHint{at: row.at, label: row.label, kind: None})
    }
    // A call whose failure passes up by itself shows the `?` the explicit
    // failures policy would have written after it.
    loop site in server.failure_marks(view) {
        hints.push(LSPInlayHint{at: site, label: "?", kind: None})
    }
    hints.sort_by(fn(left: LSPInlayHint, right: LSPInlayHint) { left.at <=> right.at })
    rows := [String]{}
    loop hint in hints {
        if hint.at < start || hint.at > end -> next
        at: lsp_byte_offset_in_table(bytes, table, hint.at)
        kind: if hint.kind == .Val(value) -> ",\"kind\":{value}" else -> ""
        rows.push("{{\"position\":{{\"line\":{at.line},\"character\":{at.character}}},\"label\":{foundation_json_quote(hint.label)}{kind},\"paddingLeft\":false,\"paddingRight\":false}}")
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// The hints the check of the document's current text supports.
lsp_checked_inlay_hints: fn(view: LSPView) -> [LSPInlayHint] Never! {
    hints := [LSPInlayHint]{}
    index: view.checked.index ?? return hints
    module_path: view.module_path ?? return hints
    loop definition in index.definitions {
        def: definition.def
        if def.module_path != module_path -> next
        if !lsp_source_spells(view.doc.text, def.def_span, def.name) -> next
        if def.kind == {
            .Local(_, ty) -> {
                if ty == .Val(shown) -> hints.push(LSPInlayHint{at: def.def_span.end, label: ": {type_name(shown)}", kind: Val(LSP_INLAY_HINT_TYPE)})
            }
            .Struct(_, _) | .Enum(_, _) -> lsp_breadcrumb_hints(view.checked, index, def, hints)
            .Module | .Function(_) | .Trait | .Tag | .Type(_) | .Const | .EnumVariant(_) | .Field(_, _) | .Param(_) -> {}
        }
    }
    lsp_parameter_hints(view, index, hints)
    hints
}

// On a type's name, each method an impl written outside the type's
// declaration adds, with its checked signature, so a reader of the type sees
// what was scattered. Methods a derive generated have no written name.
lsp_breadcrumb_hints: fn(checked: LSPChecked, index: SemIndex, def: SemDef, hints: &[LSPInlayHint]) Never! {
    declaration := Span?{None}
    loop node in index.nodes {
        if node.class != "item" || node.module_path != def.module_path -> next
        if node.span.start > def.def_span.start || def.def_span.end > node.span.end -> next
        if declaration == .Val(found) {
            if node.span.end - node.span.start >= found.end - found.start -> next
        }
        declaration = Val(node.span)
    }
    loop member in index.members {
        if member.owner != def.name || member.kind != "method" -> next
        if member.origin != "inherent_impl" && member.origin != "trait_impl" -> next
        if member.module_path == def.module_path && declaration == .Val(span) {
            if span.start <= member.span.start && member.span.end <= span.end -> next
        }
        module_ref: checked.modules[lsp_module_index(checked, member.module_path) ?? next]
        if !lsp_source_spells(module_ref.source, member.span, member.name) -> next
        loop definition in index.definitions {
            if definition.def.identity != member.identity -> next
            if definition.def.kind == .Function(callable) {
                hints.push(LSPInlayHint{at: def.def_span.end, label: "+ {lsp_method_breadcrumb(member.name, callable)}", kind: None})
            }
            break
        }
    }
}

// `name: fn(params) -[effects]> Result`: the checked effect row is shown
// whole, so a method that performs none reads `-[]>`.
lsp_method_breadcrumb: fn(name: String, callable: SemCallable) -> String Never! {
    params := [String]{}
    loop param in callable.params -> params.push("{param.name}: {type_name(param.ty)}")
    arrow := " ->"
    if callable.effects == .Val(rows) {
        arrow = " -["
        separator := ""
        loop row in rows {
            root: row.name.split(".").to_list()[0]
            if root == "Panic" || root == "Mem" -> next
            arrow = "{arrow}{separator}{row.name}"
            separator = ", "
        }
        arrow = "{arrow}]>"
    }
    shown_return: if callable.failure_contract == .Val(contract) -> failure_contract_signature_return(contract) else -> callable.return_type
    result: if shown_return == .Val(ty) -> " {type_name(ty)}" else -> " Unit"
    "{name}: fn({params.join(", ")}){arrow}{result}"
}

// What a call shows at one argument or receiver, since calls carry no marks:
// the parameter a positional argument binds (`name`, "" for none) and the
// access the callee's signature takes it with. `at` is where its text starts;
// `place` is its span when it is one name.
LSPCallMark: struct {
    at: Int,
    name: String,
    access: AccessConvention,
    place: Span?,
}

// Each call's positional arguments named by the parameter they bind, and
// marked `&` or `&&` when the callee writes or takes them, as is a method's
// receiver. A labeled argument, a rest argument, and an argument that
// already spells its parameter's name get no name.
lsp_parameter_hints: fn(view: LSPView, index: SemIndex, hints: &[LSPInlayHint]) Never! {
    loop mark in lsp_call_marks(view, index) {
        name: if mark.name == "" -> "" else -> "{mark.name}: "
        hints.push(LSPInlayHint{at: mark.at, label: "{name}{access_sigil(mark.access)}", kind: Val(LSP_INLAY_HINT_PARAMETER)})
    }
}

lsp_call_marks: fn(view: LSPView, index: SemIndex) -> [LSPCallMark] Never! {
    marks := [LSPCallMark]{}
    tokens: view.lexed.tokens
    loop (position, token) in tokens {
        if token.kind != TOKEN_IDENT || position + 1 >= tokens.len() || tokens[position + 1].kind != TOKEN_LPAREN -> next
        callable: lsp_call_callable(view, index, position) ?? next
        if callable.receiver == .Val(access) {
            if lsp_receiver_start(view, index, position) == .Val(start) {
                place: if start == position - 2 -> Span?{Val(tokens[start].span)} else -> Span?{None}
                if access != AccessConvention.Read -> marks.push(LSPCallMark{at: tokens[start].span.start, name: "", access: access, place: place})
            }
        }
        lsp_argument_marks(view.lexed, callable, position + 2, marks)
    }
    marks
}

// The callable the call named at `position` runs: the function its name
// resolves to, else the method of the type its one-name receiver was checked
// to have, as the index resolves no method name.
lsp_call_callable: fn(view: LSPView, index: SemIndex, position: Int) -> SemCallable? Never! {
    tokens: view.lexed.tokens
    if lsp_target_at(view, tokens[position].span.start) == .Val(target) {
        def: lsp_definition_at(index, target) ?? return None
        if def.kind == .Function(callable) -> return Val(callable)
        return None
    }
    if position < 2 || tokens[position - 1].kind != TOKEN_DOT -> return None
    receiver: lsp_target_at(view, tokens[position - 2].span.start) ?? return None
    owner: lsp_type_owner(type_name(lsp_checked_type(lsp_definition_at(index, receiver) ?? return None) ?? return None))
    method: token_text(view.lexed.tables, tokens[position])
    loop member in index.members {
        if member.owner != owner || member.name != method || member.kind != "method" -> next
        loop definition in index.definitions {
            if definition.def.identity != member.identity -> next
            if definition.def.kind == .Function(callable) -> return Val(callable)
        }
    }
    None
}

// The type a local, parameter or field was checked to have.
lsp_checked_type: fn(def: SemDef) -> Type? Never! {
    if def.kind == {
        .Local(_, ty) -> ty
        .Param(ty) | .Field(ty, _) -> Val(ty)
        .Module | .Function(_) | .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) | .Const | .EnumVariant(_) -> None
    }
}

lsp_argument_marks: fn(lexed: Lexed, callable: SemCallable, first_token: Int, marks: &[LSPCallMark]) Never! {
    tokens: lexed.tokens
    params: callable.params
    loop (argument, first) in lsp_call_arguments(lexed, first_token) {
        if first + 1 < tokens.len() && tokens[first].kind == TOKEN_IDENT && tokens[first + 1].kind == TOKEN_COLON {
            // A labeled argument binds the parameter its label names.
            if first + 2 >= tokens.len() -> next
            label: token_text(lexed.tables, tokens[first])
            loop param in params {
                if param.label == label {
                    lsp_push_call_mark(marks, tokens, first + 2, "", param.access)
                    break
                }
            }
            next
        }
        bound := argument
        if bound >= params.len() {
            // Each argument past the last parameter is its rest parameter's.
            if params.len() == 0 || !params[params.len() - 1].variadic -> break
            bound = params.len() - 1
        }
        param: params[bound]
        if param.zone == ParamZone.LabelOnly -> break
        spelled: tokens[first].kind == TOKEN_IDENT && lsp_lone_token(tokens, first) && token_text(lexed.tables, tokens[first]) == param.name
        name: if param.variadic || spelled -> "" else -> param.name
        lsp_push_call_mark(marks, tokens, first, name, param.access)
    }
}

lsp_push_call_mark: fn(marks: &[LSPCallMark], tokens: [Token], first: Int, name: String, access: AccessConvention) Never! {
    if name == "" && access == AccessConvention.Read -> return
    place: if tokens[first].kind == TOKEN_IDENT && lsp_lone_token(tokens, first) -> Span?{Val(tokens[first].span)} else -> Span?{None}
    marks.push(LSPCallMark{at: tokens[first].span.start, name: name, access: access, place: place})
}

// Whether the argument starting at `first` is that one token.
lsp_lone_token: fn(tokens: [Token], first: Int) -> Bool Never! {
    first + 1 < tokens.len() && (tokens[first + 1].kind == TOKEN_COMMA || tokens[first + 1].kind == TOKEN_RPAREN)
}

// The first token of the receiver of the method call named at `position`
// (`buf.seal()`, `self.cart.seal()`). A receiver that is no dotted name has
// none, nor has a module's function or a type's associated function.
lsp_receiver_start: fn(view: LSPView, index: SemIndex, position: Int) -> Int? Never! {
    tokens: view.lexed.tokens
    if position < 2 || tokens[position - 1].kind != TOKEN_DOT || !lsp_name_kind(tokens[position - 2].kind) -> return None
    start := position - 2
    loop start >= 2 && tokens[start - 1].kind == TOKEN_DOT && lsp_name_kind(tokens[start - 2].kind) {
        start -= 2
    }
    if start > 0 && tokens[start - 1].kind == TOKEN_DOT -> return None
    if lsp_target_at(view, tokens[start].span.start) == .Val(target) {
        if lsp_definition_at(index, target) == .Val(def) {
            if def.kind == {
                .Module | .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) -> return None
                .Function(_) | .Const | .EnumVariant(_) | .Field(_, _) | .Param(_) | .Local(_, _) -> {}
            }
        }
    }
    Val(start)
}

// Whether a token of `kind` is a name a receiver path is made of.
lsp_name_kind: fn(kind: Int) -> Bool Never! { kind == TOKEN_IDENT || kind == TOKEN_SELF }

// The first token of each argument of the call whose `(` precedes `first`;
// an unclosed call has none.
lsp_call_arguments: fn(lexed: Lexed, first: Int) -> [Int] Never! {
    tokens: lexed.tokens
    starts := [Int]{}
    depth := 0
    expecting := true
    cursor := first
    loop cursor < tokens.len() {
        kind: tokens[cursor].kind
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT {
            cursor += 1
            next
        }
        if depth == 0 && kind == TOKEN_RPAREN -> return starts
        if depth == 0 && expecting {
            starts.push(cursor)
            expecting = false
        }
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            if depth == 0 -> return [Int]{}
            depth -= 1
        }
        if kind == TOKEN_COMMA && depth == 0 -> expecting = true
        cursor += 1
    }
    [Int]{}
}
