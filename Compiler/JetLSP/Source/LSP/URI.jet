// `file://` URIs and the paths they name. Core owns percent encoding.
use lsp_url: core.net.url

// A `file://` URI's path, percent-decoded; any other text is returned as is.
// A drive-letter path (`file:///C:/work`) drops the slash before the drive.
lsp_uri_to_path: fn(uri: String) -> String Never! {
    if !uri.starts_with("file://") -> return uri.copy()
    rest: uri.slice(7, uri.count_bytes())
    decoded: lsp_url.percent_decode(rest) ?? return ""
    bytes: decoded.bytes()
    if bytes.len() >= 3 && bytes[0] == (U8{47}) && bytes[2] == (U8{58}) && lsp_is_ascii_letter(bytes[1]) -> return decoded.slice(1, decoded.count_bytes())
    decoded
}

lsp_is_ascii_letter: fn(byte: U8) -> Bool Never! {
    code: Int.from_u8(byte)
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

// Every byte outside the unreserved set and `/` is percent-encoded, except
// the `:` a drive letter or a scheme-like segment keeps.
lsp_path_to_uri: fn(path: String) -> String Never! {
    encoded: lsp_url.quote(path).replace("%3A", ":")
    if path.starts_with("/") -> return "file://{encoded}"
    "file:///{encoded}"
}
