// Formatting: the whole document or its requested lines through the one Jet
// formatter, and the indentation an editor asks for as `\n` or `}` is typed.
// A document with an inline package block is not formatted here: `jet fmt`
// formats its manifest and code apart.
use {
    core.encoding.[Dyn]
    jet_foundation.[Span, TextEdit, boundary_head_owner_module, foundation_json_quote]
    jet_parser.[jet_format_source]
    jet_lexer.[Lexed, Token, TOKEN_STRING, TOKEN_RAW_STRING, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT, TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_IDENT, TOKEN_DOT, TOKEN_HASH, token_text]
    jet_pkg_model.[pkg_mask_inline_package_source]
}

lsp_text_edits_json: fn(src: String, edits: [TextEdit]) -> String Never! {
    rows := [String]{}
    loop edit in edits -> rows.push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(src, edit.span))},\"newText\":{foundation_json_quote(edit.new_text)}}}")
    "[{rows.join(",")}]"
}

lsp_formattable: fn(text: String) -> Bool Never! {
    if pkg_mask_inline_package_source(text) == {
        .Ok(masked) -> masked.block == None
        .Err(_) -> false
    }
}

lsp_format_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String Never! {
    doc: lsp_open_document(server, params) ?? return lsp_response(id, "null")
    if !lsp_formattable(doc.text) -> return lsp_response(id, "[]")
    formatted: jet_format_source(doc.text, false)
    if !formatted.ok || formatted.text == doc.text -> return lsp_response(id, "[]")
    lsp_response(id, lsp_text_edits_json(doc.text, [TextEdit]{TextEdit{span: Span{start: 0, end: doc.text.count_bytes()}, new_text: formatted.text}}))
}

lsp_range_format_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String Never! {
    doc: lsp_open_document(server, params) ?? return lsp_response(id, "null")
    requested: lsp_range_from_json(lsp_param(params, "range") ?? return lsp_response(id, "null")) ?? return lsp_response(id, "null")
    if !lsp_formattable(doc.text) -> return lsp_response(id, "[]")
    edit: lsp_format_requested_lines(doc.text, requested) ?? return lsp_response(id, "[]")
    lsp_response(id, lsp_text_edits_json(doc.text, [TextEdit]{edit}))
}

lsp_on_type_format_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String Never! {
    doc: lsp_open_document(server, params) ?? return lsp_response(id, "null")
    position: lsp_params_position(params) ?? return lsp_response(id, "null")
    trigger: lsp_text_member(params ?? return lsp_response(id, "null"), "ch") ?? return lsp_response(id, "null")
    lexed: server.lex(doc)
    lsp_response(id, lsp_text_edits_json(doc.text, lsp_on_type_format_edits(doc.text, lexed, position, trigger)))
}

LSPTokenBracePair: struct {
    open: Span
    close: Span
    opaque: Bool
}

LSPOpenBrace: struct {
    span: Span
    opaque: Bool
}

lsp_on_type_format_edits: fn(src: String, lexed: Lexed, position: LSPPos, trigger: String) -> [TextEdit] Never! {
    tokens: lexed.tokens
    offset: lsp_pos_to_offset(src, position)
    if offset == 0 -> return [TextEdit]{}
    trigger_start: offset - 1
    bytes: src.bytes()
    // A trigger inside a character's bytes is no trigger.
    if !lsp_format_char_boundary(bytes, trigger_start) || !lsp_format_char_boundary(bytes, offset) -> return [TextEdit]{}
    if src.slice(trigger_start, offset) != trigger || lsp_opaque_trigger(tokens, trigger_start, offset) -> return [TextEdit]{}
    pairs: lsp_token_brace_pairs(lexed)
    loop pair in pairs {
        if pair.opaque && pair.open.end <= offset && offset <= pair.close.start -> return [TextEdit]{}
    }
    if trigger == "\n" {
        active := LSPTokenBracePair?{None}
        loop pair in pairs {
            if pair.opaque || pair.open.end > offset || offset > pair.close.start -> next
            if active == {
                .None -> active = Val(pair)
                .Val(previous) -> {
                    if pair.close.end - pair.open.start < previous.close.end - previous.open.start -> active = Val(pair)
                }
            }
        }
        return lsp_newline_format_edits(src, active ?? return [TextEdit]{}, position, pairs)
    }
    if trigger != "}}" -> return [TextEdit]{}
    loop pair in pairs {
        if !pair.opaque && pair.close.start == trigger_start -> return lsp_closing_brace_format_edits(src, pair)
    }
    [TextEdit]{}
}

lsp_opaque_trigger: fn(tokens: [Token], start: Int, end: Int) -> Bool Never! {
    loop token in tokens {
        if token.span.start <= start && end <= token.span.end && (token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING || token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT) -> return true
    }
    false
}

lsp_token_brace_pairs: fn(lexed: Lexed) -> [LSPTokenBracePair] Never! {
    opens := [LSPOpenBrace]{}
    pairs := [LSPTokenBracePair]{}
    loop (index, token) in lexed.tokens {
        if token.kind == TOKEN_LBRACE -> opens.push(LSPOpenBrace{span: token.span, opaque: lsp_typed_body_open(lexed, index)})
        if token.kind == TOKEN_RBRACE {
            if opens.pop() == .Val(open) -> pairs.push(LSPTokenBracePair{open: open.span, close: token.span, opaque: open.opaque})
        }
    }
    pairs
}

// Whether the brace at `index` opens a body of foreign text: a typed head's
// (`SQL { … }`) or a regex's (`Regex.{ … }`). The editor's indentation must
// not touch it.
lsp_typed_body_open: fn(lexed: Lexed, index: Int) -> Bool Never! {
    tokens: lexed.tokens
    cursor := index
    previous := -1
    before := -1
    loop cursor > 0 {
        cursor -= 1
        if tokens[cursor].kind == TOKEN_LINE_COMMENT || tokens[cursor].kind == TOKEN_BLOCK_COMMENT -> next
        if previous >= 0 {
            before = cursor
            break
        }
        previous = cursor
    }
    if previous < 0 -> return false
    token: tokens[previous]
    if token.kind == TOKEN_IDENT && boundary_head_owner_module(token_text(lexed.tables, token)) != None {
        if before >= 0 -> return tokens[before].kind != TOKEN_HASH
        return true
    }
    token.kind == TOKEN_DOT && before >= 0 && tokens[before].kind == TOKEN_IDENT && token_text(lexed.tables, tokens[before]) == "Regex"
}

lsp_newline_format_edits: fn(src: String, pair: LSPTokenBracePair, position: LSPPos, pairs: [LSPTokenBracePair]) -> [TextEdit] Never! {
    line_start: lsp_line_boundary(src, position.line) ?? return [TextEdit]{}
    line_end: lsp_line_content_end(src, line_start)
    indent_end: lsp_leading_indent_end(src, line_start, line_end)
    base_indent: lsp_block_indent(src, pair.open.start)
    close_on_line := LSPTokenBracePair?{None}
    loop candidate in pairs {
        if candidate.open.start == pair.open.start && candidate.close.start >= line_start && candidate.close.start < line_end {
            close_on_line = Val(candidate)
            break
        }
    }
    first: indent_end
    bytes: src.bytes()
    expected := "{base_indent}    "
    if first < line_end && bytes[first] == (U8{125}) {
        if pair.close.start != first -> return [TextEdit]{}
        // Typed inside an empty block: the new line opens the block's body and
        // the brace moves to a line of its own below it.
        if lsp_blank_bytes(bytes, pair.open.end, line_start) {
            opened := [TextEdit]{}
            if src.slice(line_start, indent_end) != expected -> opened.push(TextEdit{span: Span{start: line_start, end: indent_end}, new_text: expected})
            opened.push(TextEdit{span: Span{start: indent_end, end: indent_end}, new_text: "{lsp_line_ending_before(src, line_start)}{base_indent}"})
            return opened
        }
        expected = base_indent.copy()
    }
    edits := [TextEdit]{}
    if src.slice(line_start, indent_end) != expected -> edits.push(TextEdit{span: Span{start: line_start, end: indent_end}, new_text: expected})
    if close_on_line == .Val(close) {
        if close.close.start > indent_end {
            gap_start := close.close.start
            loop gap_start > line_start && (bytes[gap_start - 1] == (U8{32}) || bytes[gap_start - 1] == (U8{9})) -> gap_start -= 1
            edits.push(TextEdit{span: Span{start: gap_start, end: close.close.start}, new_text: "{lsp_line_ending_before(src, line_start)}{base_indent}"})
        }
    }
    edits
}

// Whether `bytes[start..<end]` holds only spaces, tabs and line breaks.
lsp_blank_bytes: fn(bytes: [U8], start: Int, end: Int) -> Bool Never! {
    loop index in start..<end {
        byte: bytes[index]
        if byte != (U8{32}) && byte != (U8{9}) && byte != (U8{13}) && byte != (U8{10}) -> return false
    }
    true
}

lsp_closing_brace_format_edits: fn(src: String, pair: LSPTokenBracePair) -> [TextEdit] Never! {
    line: lsp_byte_offset_to_lsp(src, pair.close.start).line
    start: lsp_line_boundary(src, line) ?? return [TextEdit]{}
    end: lsp_line_content_end(src, start)
    indent_end: lsp_leading_indent_end(src, start, end)
    if indent_end != pair.close.start -> return [TextEdit]{}
    expected: lsp_block_indent(src, pair.open.start)
    if src.slice(start, indent_end) == expected -> return [TextEdit]{}
    [TextEdit]{TextEdit{span: Span{start: start, end: indent_end}, new_text: expected}}
}

lsp_block_indent: fn(src: String, offset: Int) -> String Never! {
    start: lsp_line_boundary(src, lsp_byte_offset_to_lsp(src, offset).line) ?? return ""
    end: lsp_leading_indent_end(src, start, lsp_line_content_end(src, start))
    src.slice(start, end)
}

lsp_line_content_end: fn(src: String, line_start: Int) -> Int Never! {
    bytes: src.bytes()
    index := line_start
    loop index < bytes.len() && bytes[index] != (U8{13}) && bytes[index] != (U8{10}) -> index += 1
    index
}

lsp_leading_indent_end: fn(src: String, line_start: Int, line_end: Int) -> Int Never! {
    bytes: src.bytes()
    index := line_start
    loop index < line_end && (bytes[index] == (U8{32}) || bytes[index] == (U8{9})) -> index += 1
    index
}

lsp_line_ending_before: fn(src: String, line_start: Int) -> String Never! {
    bytes: src.bytes()
    if line_start >= 2 && bytes[line_start - 2] == (U8{13}) && bytes[line_start - 1] == (U8{10}) -> "\r\n" else -> "\n"
}

// The requested lines, formatted and indented as the first of them was. The
// lines must parse on their own: a range inside a body formats nothing.
lsp_format_requested_lines: fn(src: String, requested: LSPRange) -> TextEdit? Never! {
    _: lsp_apply_edit(src, requested, None, "") ?? return None
    start_line: requested.start.line
    end_line: requested.end.line + if requested.end.character > 0 -> 1 else -> 0
    if end_line < start_line -> return None
    start: lsp_line_boundary(src, start_line) ?? return None
    end: lsp_line_boundary(src, end_line) ?? src.count_bytes()
    selected: src.slice(start, end)
    formatted: jet_format_source(selected, false)
    if !formatted.ok -> return None
    first_line := start
    loop first_line < end {
        line_end: lsp_line_content_end(src, first_line)
        if lsp_leading_indent_end(src, first_line, line_end) < line_end -> break
        first_line = line_end
        loop first_line < end && (src.bytes()[first_line] == (U8{13}) || src.bytes()[first_line] == (U8{10})) -> first_line += 1
    }
    indent: src.slice(first_line, lsp_leading_indent_end(src, first_line, lsp_line_content_end(src, first_line)))
    replacement: lsp_indent_formatted_fragment(formatted.text, indent)
    if selected == replacement -> return None
    Val(TextEdit{span: Span{start: start, end: end}, new_text: replacement})
}

// Each nonblank line of the formatted fragment gets the fragment's indent.
lsp_indent_formatted_fragment: fn(formatted: String, indent: String) -> String Never! {
    if indent.is_empty() -> return formatted.copy()
    out := [String]{}
    loop line in formatted.split("\n") {
        if line.trim().is_empty() -> out.push(line) else -> out.push("{indent}{line}")
    }
    out.join("\n")
}

lsp_line_boundary: fn(src: String, line: Int) -> Int? Never! {
    if line == 0 -> return Val(0)
    current := 0
    bytes: src.bytes()
    index := 0
    loop index < bytes.len() {
        if bytes[index] == (U8{13}) || bytes[index] == (U8{10}) {
            if bytes[index] == (U8{13}) && index + 1 < bytes.len() && bytes[index + 1] == (U8{10}) -> index += 1
            current += 1
            if current == line -> return Val(index + 1)
        }
        index += 1
    }
    None
}

lsp_format_char_boundary: fn(bytes: [U8], index: Int) -> Bool Never! {
    index >= 0 && index <= bytes.len() && (index == bytes.len() || (Int{bytes[index]}.bit_and(192)) != 128)
}
