// Request and notification dispatch, and the advertised capabilities: every
// capability `initialize` advertises has its provider here.
use {
    core.encoding.[Dyn]
    lsp_request_term: core.term
    jet_foundation.[foundation_json_quote]
}

// Each known method reaches its one feature provider; an unknown method
// answers MethodNotFound.
lsp_handle_request: fn(server: &LSPServer, method: String, params: Dyn?, id: Dyn) -> String {
    if method == {
        "initialize" -> lsp_initialize_response(id)
        "shutdown" -> {
            server.shutdown = true
            lsp_response(id, "null")
        }
        "textDocument/codeAction" -> lsp_code_action_response(server, params, id)
        "textDocument/formatting" -> lsp_format_response(server, params, id)
        "textDocument/rangeFormatting" -> lsp_range_format_response(server, params, id)
        "textDocument/onTypeFormatting" -> lsp_on_type_format_response(server, params, id)
        "textDocument/completion" -> lsp_completion_response(server, params, id)
        "textDocument/signatureHelp" -> lsp_signature_help_response(server, params, id)
        "textDocument/hover" -> lsp_hover_response(server, params, id)
        "textDocument/definition" -> lsp_definition_response(server, params, id)
        "textDocument/references" -> lsp_references_response(server, params, id)
        "textDocument/documentHighlight" -> lsp_document_highlight_response(server, params, id)
        "textDocument/prepareRename" -> lsp_prepare_rename_response(server, params, id)
        "textDocument/rename" -> lsp_rename_response(server, params, id)
        "textDocument/documentSymbol" -> lsp_document_symbol_response(server, params, id)
        "workspace/symbol" -> lsp_workspace_symbol_response(server, params, id)
        "textDocument/foldingRange" -> lsp_folding_range_response(server, params, id)
        "textDocument/selectionRange" -> lsp_selection_range_response(server, params, id)
        "textDocument/documentLink" -> lsp_document_link_response(server, params, id)
        "textDocument/semanticTokens/full" -> lsp_semantic_tokens_response(server, params, id)
        "textDocument/semanticTokens/range" -> lsp_semantic_tokens_range_response(server, params, id)
        else -> lsp_error_response(id, -32601, "method not found: {method}")
    }
}

// Cancellation and tracing need no answer: the loop answers each request in
// turn, so none is still running when its cancellation arrives.
lsp_handle_notification: fn(server: &LSPServer, method: String, params: Dyn?, stdout: &lsp_request_term.Stdout) IOError! {
    if method == {
        "exit" -> server.exited = true
        "textDocument/didOpen" -> {
            uri: lsp_update_document(server.diagnostic_state, params, is_open: true) ?? return
            lsp_publish_document_diagnostics(server, uri, stdout) ?? return Err(err)
            _ := server.diagnostic_state.dirty.remove(uri)
        }
        "textDocument/didChange" -> { _ := lsp_update_document(server.diagnostic_state, params, is_open: false) }
        "textDocument/didClose" -> {
            uri: lsp_params_uri(params) ?? return
            lsp_close_document(server, uri, stdout) ?? return Err(err)
        }
        else -> {}
    }
}

LSP_SEMANTIC_TOKEN_TYPES: [String]{"keyword", "type", "function", "variable", "parameter", "property", "enumMember", "string", "number", "comment", "operator", "namespace", "decorator"}
LSP_SEMANTIC_TOKEN_MODIFIERS: [String]{"declaration", "readonly"}

lsp_json_strings: fn(values: [String]) -> String Never! {
    rows := [String]{}
    loop value in values -> rows.push(foundation_json_quote(value))
    "[{rows.join(",")}]"
}

lsp_initialize_response: fn(id: Dyn) -> String Never! {
    capabilities := [String]{
        // TextDocumentSyncKind.Incremental; the number form implies open and close.
        "\"textDocumentSync\":2",
        "\"documentFormattingProvider\":true",
        "\"documentRangeFormattingProvider\":true",
        "\"documentOnTypeFormattingProvider\":{{\"firstTriggerCharacter\":\"\\n\",\"moreTriggerCharacter\":[\"}}\"]}}",
        "\"codeActionProvider\":{{\"codeActionKinds\":[\"quickfix\",\"refactor.rewrite\"]}}",
        "\"completionProvider\":{{\"triggerCharacters\":[\".\"],\"resolveProvider\":false}}",
        "\"signatureHelpProvider\":{{\"triggerCharacters\":[\"(\",\",\"]}}",
        "\"hoverProvider\":true",
        "\"definitionProvider\":true",
        "\"referencesProvider\":true",
        "\"documentHighlightProvider\":true",
        "\"renameProvider\":{{\"prepareProvider\":true}}",
        "\"documentSymbolProvider\":true",
        "\"workspaceSymbolProvider\":true",
        "\"foldingRangeProvider\":true",
        "\"selectionRangeProvider\":true",
        "\"documentLinkProvider\":{{\"resolveProvider\":false}}",
        "\"semanticTokensProvider\":{{\"legend\":{{\"tokenTypes\":{lsp_json_strings(LSP_SEMANTIC_TOKEN_TYPES)},\"tokenModifiers\":{lsp_json_strings(LSP_SEMANTIC_TOKEN_MODIFIERS)}}},\"full\":true,\"range\":true}}",
    }
    lsp_response(id, "{{\"capabilities\":{{{capabilities.join(",")}}},\"serverInfo\":{{\"name\":\"jet\"}}}}")
}
