// Request and notification dispatch, and the advertised capabilities: every
// capability `initialize` advertises has its provider here.
use {
    core.encoding.[Dyn]
    lsp_request_term: core.term
    jet_foundation.[foundation_json_quote]
}

// Each known method reaches its one feature provider; an unknown method
// answers MethodNotFound.
lsp_handle_request: fn(server: ^LSPServer, method: String, params: Dyn?, id: Dyn) -> String {
    if method == {
        "initialize" -> {
            capabilities: lsp_param(params, "capabilities") ?? Dyn.Null
            workspace: lsp_member(capabilities, "workspace") ?? Dyn.Null
            server.document_changes = lsp_bool_member(lsp_member(workspace, "workspaceEdit") ?? Dyn.Null, "documentChanges")
            text_document: lsp_member(capabilities, "textDocument") ?? Dyn.Null
            resolve_support: lsp_member(lsp_member(text_document, "codeAction") ?? Dyn.Null, "resolveSupport") ?? Dyn.Null
            server.code_action_resolve = loop property in lsp_member_rows(resolve_support, "properties") {
                if property == .Text(name) && name == "edit" {
                    break true
                }
            } ?? false
            server.pull_diagnostics = lsp_member(text_document, "diagnostic") != None
            lsp_initial_workspace_folders(server, params)
            lsp_initialize_response(id)
        }
        "shutdown" -> {
            server.shutdown = true
            lsp_response(id, "null")
        }
        "textDocument/codeAction" -> lsp_code_action_response(server, params, id)
        "codeAction/resolve" -> lsp_code_action_resolve_response(server, params, id)
        "textDocument/formatting" -> lsp_format_response(server, params, id)
        "textDocument/rangeFormatting" -> lsp_range_format_response(server, params, id)
        "textDocument/onTypeFormatting" -> lsp_on_type_format_response(server, params, id)
        "textDocument/completion" -> lsp_completion_response(server, params, id)
        "completionItem/resolve" -> lsp_completion_resolve_response(server, params, id)
        "textDocument/signatureHelp" -> lsp_signature_help_response(server, params, id)
        "textDocument/hover" -> lsp_hover_response(server, params, id)
        "textDocument/definition" -> lsp_definition_response(server, params, id)
        "textDocument/declaration" -> lsp_definition_response(server, params, id)
        "textDocument/typeDefinition" -> lsp_type_definition_response(server, params, id)
        "textDocument/implementation" -> lsp_implementation_response(server, params, id)
        "textDocument/references" -> lsp_references_response(server, params, id)
        "textDocument/documentHighlight" -> lsp_document_highlight_response(server, params, id)
        "textDocument/linkedEditingRange" -> lsp_linked_editing_range_response(server, params, id)
        "textDocument/prepareRename" -> lsp_prepare_rename_response(server, params, id)
        "textDocument/rename" -> lsp_rename_response(server, params, id)
        "textDocument/documentSymbol" -> lsp_document_symbol_response(server, params, id)
        "workspace/symbol" -> lsp_workspace_symbol_response(server, params, id)
        "textDocument/foldingRange" -> lsp_folding_range_response(server, params, id)
        "textDocument/selectionRange" -> lsp_selection_range_response(server, params, id)
        "textDocument/documentLink" -> lsp_document_link_response(server, params, id)
        "textDocument/codeLens" -> lsp_code_lens_response(server, params, id)
        "workspace/executeCommand" -> lsp_execute_command_response(server, params, id)
        "textDocument/semanticTokens/full" -> lsp_semantic_tokens_response(server, params, id)
        "textDocument/semanticTokens/full/delta" -> lsp_semantic_tokens_delta_response(server, params, id)
        "textDocument/semanticTokens/range" -> lsp_semantic_tokens_range_response(server, params, id)
        "textDocument/diagnostic" -> lsp_document_diagnostic_response(server, params, id)
        "workspace/diagnostic" -> lsp_workspace_diagnostic_response(server, params, id)
        "textDocument/inlayHint" -> lsp_inlay_hint_response(server, params, id)
        "textDocument/prepareTypeHierarchy" -> lsp_prepare_hierarchy_response(server, params, id, calls: false)
        "typeHierarchy/supertypes" -> lsp_type_supertypes_response(server, params, id)
        "typeHierarchy/subtypes" -> lsp_type_subtypes_response(server, params, id)
        "textDocument/prepareCallHierarchy" -> lsp_prepare_hierarchy_response(server, params, id, calls: true)
        "callHierarchy/incomingCalls" -> lsp_incoming_calls_response(server, params, id)
        "callHierarchy/outgoingCalls" -> lsp_outgoing_calls_response(server, params, id)
        "workspace/willRenameFiles" -> lsp_will_rename_files_response(server, params, id)
        "resources/list" -> lsp_resources_list_response(server, id)
        "resources/read" -> lsp_resources_read_response(server, params, id)
        else -> lsp_error_response(id, -32601, "method not found: {method}")
    }
}

// Cancellation needs nothing here: the loop answers a request whose cancel is
// already queued with RequestCancelled before running it, and a request that
// has started runs to its end. Tracing needs no answer. An opened document
// whose newer edit is already queued is marked dirty instead of published,
// so the first request after that edit publishes it.
lsp_handle_notification: fn(server: ^LSPServer, method: String, params: Dyn?, input: ^LSPInput, stdout: ^lsp_request_term.Stdout) IOError! {
    if method == {
        "exit" -> server.exited = true
        "textDocument/didOpen" -> {
            uri: lsp_update_document(server.diagnostic_state, params, is_open: true) ?? return
            lsp_read_more(input)
            if lsp_edit_queued(input, uri) {
                server.diagnostic_state.dirty[uri] = true
                return
            }
            lsp_publish_document_diagnostics(server, uri, stdout) ?? return Err(err)
            ^_: server.diagnostic_state.dirty.remove(uri)
        }
        "textDocument/didChange" -> {
            ^_: lsp_update_document(server.diagnostic_state, params, is_open: false)
        }
        "textDocument/didClose" -> {
            uri: lsp_params_uri(params) ?? return
            lsp_close_document(server, uri, stdout) ?? return Err(err)
        }
        "workspace/didChangeWorkspaceFolders" -> lsp_change_workspace_folders(server, params)
        else -> {}
    }
}

LSP_SEMANTIC_TOKEN_TYPES: [String]{"keyword", "type", "function", "variable", "parameter", "property", "enumMember", "string", "number", "comment", "operator", "namespace", "decorator"}

LSP_SEMANTIC_TOKEN_MODIFIERS: [String]{"declaration", "readonly", "modification", "macro"}

lsp_json_strings: fn(values: [String]) -> String Never! {
    ^rows: [String]{}
    loop value in values -> rows.push(foundation_json_quote(value))
    "[{rows.join(",")}]"
}

lsp_initialize_response: fn(id: Dyn) -> String Never! {
    ^capabilities: [String]{
        // TextDocumentSyncKind.Incremental; the number form implies open and close.
        "\"textDocumentSync\":2",
        "\"documentFormattingProvider\":true",
        "\"documentRangeFormattingProvider\":true",
        "\"documentOnTypeFormattingProvider\":{{\"firstTriggerCharacter\":\"\\n\",\"moreTriggerCharacter\":[\"}}\"]}}",
        "\"codeActionProvider\":{{\"codeActionKinds\":[\"quickfix\",\"refactor.rewrite\",\"source.organizeImports\"],\"resolveProvider\":true}}",
        "\"completionProvider\":{{\"triggerCharacters\":[\".\"],\"resolveProvider\":true}}",
        "\"signatureHelpProvider\":{{\"triggerCharacters\":[\"(\",\",\"]}}",
        "\"hoverProvider\":true",
        "\"definitionProvider\":true",
        // A Jet name is declared where it is defined.
        "\"declarationProvider\":true",
        "\"typeDefinitionProvider\":true",
        "\"implementationProvider\":true",
        "\"referencesProvider\":true",
        "\"documentHighlightProvider\":true",
        "\"linkedEditingRangeProvider\":true",
        "\"renameProvider\":{{\"prepareProvider\":true}}",
        "\"documentSymbolProvider\":true",
        "\"workspaceSymbolProvider\":true",
        "\"foldingRangeProvider\":true",
        "\"selectionRangeProvider\":true",
        "\"documentLinkProvider\":{{\"resolveProvider\":false}}",
        "\"codeLensProvider\":{{\"resolveProvider\":false}}",
        "\"executeCommandProvider\":{{\"commands\":[\"jet.impact\",\"jet.reasoning\"]}}",
        "\"semanticTokensProvider\":{{\"legend\":{{\"tokenTypes\":{lsp_json_strings(LSP_SEMANTIC_TOKEN_TYPES)},\"tokenModifiers\":{lsp_json_strings(LSP_SEMANTIC_TOKEN_MODIFIERS)}}},\"full\":{{\"delta\":true}},\"range\":true}}",
        "\"inlayHintProvider\":true",
        "\"typeHierarchyProvider\":true",
        "\"callHierarchyProvider\":true",
        // A document's diagnostics can come from the files it imports, so
        // an edit to one open document asks for the others' again.
        "\"diagnosticProvider\":{{\"identifier\":\"jet\",\"interFileDependencies\":true,\"workspaceDiagnostics\":true}}",
        // A `.jet` file or a folder about to be renamed or moved: the file
        // imports naming what moves follow it.
        "\"workspace\":{{\"workspaceFolders\":{{\"supported\":true,\"changeNotifications\":true}},\"fileOperations\":{{\"willRename\":{{\"filters\":[{{\"pattern\":{{\"glob\":\"**/*.jet\",\"matches\":\"file\"}}}},{{\"pattern\":{{\"glob\":\"**\",\"matches\":\"folder\"}}}}]}}}}}}",
    }
    lsp_response(id, "{{\"capabilities\":{{{capabilities.join(",")}}},\"serverInfo\":{{\"name\":\"jet\"}}}}")
}
