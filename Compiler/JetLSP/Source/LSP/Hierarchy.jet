// Type hierarchy: a type's supertypes are the traits it implements and a
// trait's subtypes are the types that implement it, as the checked index's
// trait contracts record them. A contract names its trait as written; that is
// the trait of that name in the implementing type's module, else the only
// trait of that name in the index, else no trait the hierarchy can show.
use {
    core.encoding.[Dyn]
    jet_foundation.[foundation_json_quote]
    jet_semindex.[SemDef, SemIndex, SemKind]
}

// The type a hierarchy item names, by its slot in the index of the view that
// checked it.
LSPHierarchyItem: struct {
    view: LSPView,
    slot: Int,
}

lsp_hierarchy_type_kind: fn(kind: SemKind) -> Bool Never! {
    if kind == {
        .Struct(_, _) | .Enum(_, _) | .Trait | .Type(_) -> true
        .Module | .Function(_) | .Tag | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> false
    }
}

lsp_hierarchy_trait_kind: fn(kind: SemKind) -> Bool Never! {
    if kind == {
        .Trait -> true
        .Struct(_, _) | .Enum(_, _) | .Type(_) | .Module | .Function(_) | .Tag | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> false
    }
}

// The slot in the index's definitions of the trait a contract of a type in
// `module_path` names.
lsp_contract_trait: fn(index: SemIndex, module_path: String, trait_name: String) -> Int? Never! {
    parts: trait_name.split(".").to_list()
    leaf: parts[parts.len() - 1]
    found := Int?{None}
    count := 0
    loop slot in 0..<index.definitions.len() {
        def: index.definitions[slot].def
        if !lsp_hierarchy_trait_kind(def.kind) || def.name != leaf -> next
        if def.module_path == module_path -> return Val(slot)
        count += 1
        found = Val(slot)
    }
    if count == 1 -> found else -> None
}

// A TypeHierarchyItem; its `data` carries the definition's identity, which
// the supertypes and subtypes requests read back.
lsp_type_hierarchy_item_json: fn(checked: LSPChecked, def: SemDef) -> String? Never! {
    kind: lsp_symbol_kind(def.kind) ?? return None
    location: lsp_location(checked, def.module_path, def.def_span) ?? return None
    range: lsp_range_json(lsp_byte_span_to_range(location.source, lsp_clamped_span(location.source, location.span)))
    Val("{{\"name\":{foundation_json_quote(def.name)},\"kind\":{kind},\"detail\":{foundation_json_quote(def.module_path)},\"uri\":{foundation_json_quote(location.uri)},\"range\":{range},\"selectionRange\":{range},\"data\":{{\"identity\":{foundation_json_quote(def.identity)}}}}}")
}

// The type a supertypes or subtypes request's `item` names: by the identity
// its `data` carries, else by its name in the open document its `uri` names.
lsp_hierarchy_item: fn(server: LSPServer, params: Dyn?) -> LSPHierarchyItem? {
    item: lsp_param(params, "item") ?? return None
    view: lsp_view_of(server, lsp_text_member(item, "uri") ?? return None) ?? return None
    index: view.checked.index ?? return None
    identity: lsp_text_member(lsp_member(item, "data") ?? Dyn.Null, "identity") ?? ""
    name: lsp_text_member(item, "name") ?? ""
    loop slot in 0..<index.definitions.len() {
        def: index.definitions[slot].def
        if !lsp_hierarchy_type_kind(def.kind) -> next
        named: if identity != "" -> def.identity == identity else -> def.name == name && (view.module_path ?? "") == def.module_path
        if named -> return Val(LSPHierarchyItem{view: view, slot: slot})
    }
    None
}

lsp_prepare_type_hierarchy_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "null")
    def: lsp_definition_at(index, target) ?? return lsp_response(id, "null")
    if !lsp_hierarchy_type_kind(def.kind) -> return lsp_response(id, "null")
    item: lsp_type_hierarchy_item_json(at.view.checked, def) ?? return lsp_response(id, "null")
    lsp_response(id, "[{item}]")
}

lsp_type_supertypes_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params) ?? return lsp_response(id, "null")
    index: found.view.checked.index ?? return lsp_response(id, "null")
    definition: index.definitions[found.slot]
    own: definition.def
    rows := [String]{}
    seen := [Int]{}
    loop contract in definition.trait_contracts {
        slot: lsp_contract_trait(index, own.module_path, contract.trait_name) ?? next
        if slot == found.slot || seen.contains(slot) -> next
        seen.push(slot)
        rows.push(lsp_type_hierarchy_item_json(found.view.checked, index.definitions[slot].def) ?? next)
    }
    lsp_response(id, "[{rows.join(",")}]")
}

lsp_type_subtypes_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params) ?? return lsp_response(id, "null")
    index: found.view.checked.index ?? return lsp_response(id, "null")
    rows := [String]{}
    if !lsp_hierarchy_trait_kind(index.definitions[found.slot].def.kind) -> return lsp_response(id, "[]")
    loop slot in 0..<index.definitions.len() {
        definition: index.definitions[slot]
        if slot == found.slot || !lsp_hierarchy_type_kind(definition.def.kind) -> next
        loop contract in definition.trait_contracts {
            named: lsp_contract_trait(index, definition.def.module_path, contract.trait_name) ?? next
            if named != found.slot -> next
            rows.push(lsp_type_hierarchy_item_json(found.view.checked, definition.def) ?? break)
            break
        }
    }
    lsp_response(id, "[{rows.join(",")}]")
}
