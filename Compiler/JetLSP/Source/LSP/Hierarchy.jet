// Type and call hierarchies from the checked index.
//
// A type's supertypes are the traits it implements and a trait's subtypes are
// the types that implement it, as the index's trait contracts record them. A
// contract names its trait as written; that is the trait of that name in the
// implementing type's module, else the only trait of that name in the index,
// else no trait the hierarchy can show.
//
// A function's incoming calls are the index's calls whose callee resolves to
// it, grouped by the function making them; its outgoing calls are the calls
// it makes whose callee resolves to a declaration, grouped by callee. A
// call's callee is the resolved reference at the call's name, and its caller
// the function of the recorded name in the call's module.
use {
    core.encoding.[Dyn]
    jet_foundation.[TYPE_NAMES, foundation_json_quote]
    jet_lexer.[token_text]
    jet_semindex.[SemCall, SemDef, SemIndex, SemKind]
}

// The definition a hierarchy item names, by its slot in the index of the
// view that checked it.
LSPHierarchyItem: struct {
    view: LSPView,
    slot: Int,
}

lsp_hierarchy_type_kind: fn(kind: SemKind) -> Bool Never! {
    if kind == {
        .Struct(_, _) | .Enum(_, _) | .Trait | .Type(_) -> true
        .Module | .Function(_) | .Tag | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> false
    }
}

lsp_hierarchy_trait_kind: fn(kind: SemKind) -> Bool Never! {
    if kind == {
        .Trait -> true
        .Struct(_, _) | .Enum(_, _) | .Type(_) | .Module | .Function(_) | .Tag | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> false
    }
}

lsp_hierarchy_function_kind: fn(kind: SemKind) -> Bool Never! {
    if kind == {
        .Function(_) -> true
        .Struct(_, _) | .Enum(_, _) | .Trait | .Type(_) | .Module | .Tag | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> false
    }
}

// The kinds a call hierarchy (`calls`) or a type hierarchy shows.
lsp_hierarchy_kind: fn(kind: SemKind, calls: Bool{false}) -> Bool Never! {
    if calls -> lsp_hierarchy_function_kind(kind) else -> lsp_hierarchy_type_kind(kind)
}

// The slot in the index's definitions of the type, or with `traits` the
// trait, a name written in `module_path` names: the one of that name in the
// module, else the only one of that name in the index.
lsp_named_type_slot: fn(index: SemIndex, module_path: String, written: String, traits: Bool{false}) -> Int? Never! {
    parts: written.split(".").to_list()
    leaf: parts[parts.len() - 1]
    ^found: Int?{None}
    ^count: 0
    loop slot in 0..<index.definitions.len() {
        def: index.definitions[slot].def
        fits: if traits -> lsp_hierarchy_trait_kind(def.kind) else -> lsp_hierarchy_type_kind(def.kind)
        if !fits || def.name != leaf -> next
        if def.module_path == module_path -> return Val(slot)
        count += 1
        found = Val(slot)
    }
    if count == 1 -> found else -> None
}

// A TypeHierarchyItem or CallHierarchyItem; its `data` carries the
// definition's identity, which the follow-up requests read back.
lsp_hierarchy_item_json: fn(checked: LSPChecked, def: SemDef) -> String? Never! {
    kind: lsp_symbol_kind(def.kind) ?? return None
    location: lsp_location(checked, def.module_path, def.def_span) ?? return None
    range: lsp_range_json(lsp_byte_span_to_range(location.source, lsp_clamped_span(location.source, location.span)))
    Val("{{\"name\":{foundation_json_quote(def.name)},\"kind\":{kind},\"detail\":{foundation_json_quote(def.module_path)},\"uri\":{foundation_json_quote(location.uri)},\"range\":{range},\"selectionRange\":{range},\"data\":{{\"identity\":{foundation_json_quote(def.identity)}}}}}")
}

// The declaration a follow-up request's `item` names: by the identity its
// `data` carries, else by its name in the open document its `uri` names.
lsp_hierarchy_item: fn(server: LSPServer, params: Dyn?, calls: Bool{false}) -> LSPHierarchyItem? {
    item: lsp_param(params, "item") ?? return None
    view: lsp_view_of(server, lsp_text_member(item, "uri") ?? return None) ?? return None
    index: view.checked.index ?? return None
    identity: lsp_text_member(lsp_member(item, "data") ?? Dyn.Null, "identity") ?? ""
    name: lsp_text_member(item, "name") ?? ""
    loop slot in 0..<index.definitions.len() {
        def: index.definitions[slot].def
        if !lsp_hierarchy_kind(def.kind, calls: calls) -> next
        named: if identity != "" -> def.identity == identity else -> def.name == name && (view.module_path ?? "") == def.module_path
        if named -> return Val(LSPHierarchyItem{view: view, slot: slot})
    }
    None
}

// A built-in type named at `offset`, as `String` in `code: String`. It has
// no declaration, so its item stands at the name, as a Class, with its
// symbol's identity; the index records no trait it implements and no type
// implementing it.
lsp_builtin_type_item_json: fn(view: LSPView, offset: Int) -> String? Never! {
    token: lsp_ident_token_at(view.lexed, offset) ?? return None
    name: token_text(view.lexed.tables, token)
    if !TYPE_NAMES.contains(name) -> return None
    range: lsp_range_json(lsp_byte_span_to_range(view.doc.text, token.span))
    Val("{{\"name\":{foundation_json_quote(name)},\"kind\":5,\"detail\":\"built in\",\"uri\":{foundation_json_quote(view.uri)},\"range\":{range},\"selectionRange\":{range},\"data\":{{\"identity\":{foundation_json_quote("{LSP_BUILTIN_TYPE_IDENTITY}{name}")}}}}}")
}

// The identity prefix of a built-in type's symbol.
LSP_BUILTIN_TYPE_IDENTITY: "builtin:type:"

// Whether a follow-up request's `item` is a built-in type's.
lsp_builtin_type_item: fn(params: Dyn?) -> Bool Never! {
    item: lsp_param(params, "item") ?? return false
    identity: lsp_text_member(lsp_member(item, "data") ?? Dyn.Null, "identity") ?? return false
    identity.starts_with(LSP_BUILTIN_TYPE_IDENTITY)
}

// The answer to a follow-up request naming no declaration: a built-in type
// has no supertypes or subtypes, and any other item none the index holds.
lsp_hierarchy_unknown: fn(params: Dyn?) -> String Never! {
    if lsp_builtin_type_item(params) -> "[]" else -> "null"
}

// The item for the declaration at the cursor, or for the one a reference
// there resolves to; in a type hierarchy, else for a built-in type named
// there.
lsp_prepare_hierarchy_response: fn(server: LSPServer, params: Dyn?, id: Dyn, calls: Bool{false}) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    if lsp_target_at(at.view, at.offset) == .Val(target) {
        def: lsp_definition_at(index, target) ?? return lsp_response(id, "null")
        if !lsp_hierarchy_kind(def.kind, calls: calls) -> return lsp_response(id, "null")
        item: lsp_hierarchy_item_json(at.view.checked, def) ?? return lsp_response(id, "null")
        return lsp_response(id, "[{item}]")
    }
    if calls -> return lsp_response(id, "null")
    item: lsp_builtin_type_item_json(at.view, at.offset) ?? return lsp_response(id, "null")
    lsp_response(id, "[{item}]")
}

lsp_type_supertypes_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params, calls: false) ?? return lsp_response(id, lsp_hierarchy_unknown(params))
    index: found.view.checked.index ?? return lsp_response(id, "null")
    definition: index.definitions[found.slot]
    own: definition.def
    ^rows: [String]{}
    ^seen: [Int]{}
    loop contract in definition.trait_contracts {
        slot: lsp_named_type_slot(index, own.module_path, contract.trait_name, traits: true) ?? next
        if slot == found.slot || seen.contains(slot) -> next
        seen.push(slot)
        rows.push(lsp_hierarchy_item_json(found.view.checked, index.definitions[slot].def) ?? next)
    }
    lsp_response(id, "[{rows.join(",")}]")
}

lsp_type_subtypes_collect: fn(checked: LSPChecked, index: SemIndex, trait_slot: Int, seen: ^[String:Bool], rows: ^[String]) Never! {
    loop slot in 0..<index.definitions.len() {
        definition: index.definitions[slot]
        if slot == trait_slot || !lsp_hierarchy_type_kind(definition.def.kind) -> next
        loop contract in definition.trait_contracts {
            named: lsp_named_type_slot(index, definition.def.module_path, contract.trait_name, traits: true) ?? next
            if named != trait_slot -> next
            location: lsp_location(checked, definition.def.module_path, definition.def.def_span) ?? break
            key: "{location.uri}:{location.span.start}"
            if seen.has_key(key) -> break
            seen[key] = true
            rows.push(lsp_hierarchy_item_json(checked, definition.def) ?? break)
            break
        }
    }
}

lsp_type_subtypes_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params, calls: false) ?? return lsp_response(id, lsp_hierarchy_unknown(params))
    index: found.view.checked.index ?? return lsp_response(id, "null")
    ^rows: [String]{}
    target_def: index.definitions[found.slot].def
    if !lsp_hierarchy_trait_kind(target_def.kind) {
        return lsp_response(id, "[]")
    }
    ^seen: [String:Bool]{}
    lsp_type_subtypes_collect(found.view.checked, index, found.slot, seen, rows)
    if lsp_module_index(found.view.checked, target_def.module_path) == .Val(decl_index) {
        declaring: found.view.checked.modules[decl_index]
        if declaring.physical_path != "" {
            ^uris: server.published.keys().to_list()
            uris.sort()
            loop uri in uris {
                if uri == found.view.uri -> next
                other_checked: server.published[uri]
                other_index: other_checked.index ?? next
                loop module_ref in other_checked.modules {
                    if !lsp_source_paths_equal(module_ref.physical_path, declaring.physical_path) || module_ref.source != declaring.source {
                        next
                    }
                    other_target: LSPTarget{module_path: module_ref.path, span: target_def.def_span}
                    loop slot in 0..<other_index.definitions.len() {
                        if lsp_same_target(other_target, other_index.definitions[slot].def.module_path, other_index.definitions[slot].def.def_span) {
                            lsp_type_subtypes_collect(other_checked, other_index, slot, seen, rows)
                            break
                        }
                    }
                    break
                }
            }
        }
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// The slot of the declaration a call's callee resolves to: a resolved
// reference ending at the call's name, whether `call.span` or `reference.span`
// includes a module qualifier (`module.name`).
lsp_call_callee: fn(index: SemIndex, call: SemCall) -> Int? Never! {
    loop reference in index.references {
        if reference.module_path != call.module_path || reference.span.end != call.span.end {
            next
        }
        anchor: reference.target ?? next
        target: LSPTarget{module_path: anchor.module_path, span: anchor.def_span}
        loop slot in 0..<index.definitions.len() {
            def: index.definitions[slot].def
            if lsp_same_target(target, def.module_path, def.def_span) -> return Val(slot)
        }
    }
    None
}

// The slot of the function making a call.
lsp_call_caller: fn(index: SemIndex, call: SemCall) -> Int? Never! {
    loop slot in 0..<index.definitions.len() {
        def: index.definitions[slot].def
        if lsp_hierarchy_function_kind(def.kind) && def.module_path == call.module_path && def.name == call.caller {
            return Val(slot)
        }
    }
    None
}

// The calls between one function and the other, grouped by declaration key.
LSPCallGroup: struct {
    key: String,
    item: String,
    ranges: [String],
}

lsp_call_group_add: fn(groups: ^[LSPCallGroup], seen_calls: ^[String:Bool], checked: LSPChecked, index: SemIndex, slot: Int, call: SemCall) Never! {
    location: lsp_location(checked, call.module_path, call.span) ?? return
    call_key: "{location.uri}:{call.span.start}:{call.span.end}"
    if seen_calls.has_key(call_key) -> return
    seen_calls[call_key] = true
    range: lsp_range_json(lsp_byte_span_to_range(location.source, lsp_clamped_span(location.source, location.span)))
    def: index.definitions[slot].def
    def_loc: lsp_location(checked, def.module_path, def.def_span) ?? return
    key: "{def_loc.uri}:{def.def_span.start}"
    loop group in 0..<groups.len() {
        if groups[group].key == key {
            groups[group].ranges.push(range)
            return
        }
    }
    item: lsp_hierarchy_item_json(checked, def) ?? return
    groups.push(LSPCallGroup{key: key, item: item, ranges: [String]{range}})
}

// Each group as `{"<side>": item, "fromRanges": [...]}`.
lsp_call_groups_json: fn(groups: [LSPCallGroup], side: String) -> String Never! {
    ^rows: [String]{}
    loop group in groups {
        rows.push("{{\"{side}\":{group.item},\"fromRanges\":[{group.ranges.join(",")}]}}")
    }
    "[{rows.join(",")}]"
}

lsp_incoming_calls_collect: fn(checked: LSPChecked, index: SemIndex, target_slot: Int, seen_calls: ^[String:Bool], groups: ^[LSPCallGroup]) Never! {
    loop call in index.calls {
        if lsp_call_callee(index, call) != Val(target_slot) -> next
        caller: lsp_call_caller(index, call) ?? next
        lsp_call_group_add(groups, seen_calls, checked, index, caller, call)
    }
}

lsp_incoming_calls_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params, calls: true) ?? return lsp_response(id, "null")
    index: found.view.checked.index ?? return lsp_response(id, "null")
    ^groups: [LSPCallGroup]{}
    ^seen_calls: [String:Bool]{}
    lsp_incoming_calls_collect(found.view.checked, index, found.slot, seen_calls, groups)
    target_def: index.definitions[found.slot].def
    if lsp_module_index(found.view.checked, target_def.module_path) == .Val(decl_index) {
        declaring: found.view.checked.modules[decl_index]
        if declaring.physical_path != "" {
            ^uris: server.published.keys().to_list()
            uris.sort()
            loop uri in uris {
                if uri == found.view.uri -> next
                other_checked: server.published[uri]
                other_index: other_checked.index ?? next
                loop module_ref in other_checked.modules {
                    if !lsp_source_paths_equal(module_ref.physical_path, declaring.physical_path) || module_ref.source != declaring.source {
                        next
                    }
                    other_target: LSPTarget{module_path: module_ref.path, span: target_def.def_span}
                    loop slot in 0..<other_index.definitions.len() {
                        if lsp_same_target(other_target, other_index.definitions[slot].def.module_path, other_index.definitions[slot].def.def_span) {
                            lsp_incoming_calls_collect(other_checked, other_index, slot, seen_calls, groups)
                            break
                        }
                    }
                    break
                }
            }
        }
    }
    lsp_response(id, lsp_call_groups_json(groups, "from"))
}

lsp_outgoing_calls_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    found: lsp_hierarchy_item(server, params, calls: true) ?? return lsp_response(id, "null")
    index: found.view.checked.index ?? return lsp_response(id, "null")
    caller: index.definitions[found.slot].def
    ^groups: [LSPCallGroup]{}
    ^seen_calls: [String:Bool]{}
    loop call in index.calls {
        if call.module_path != caller.module_path || call.caller != caller.name -> next
        callee: lsp_call_callee(index, call) ?? next
        lsp_call_group_add(groups, seen_calls, found.view.checked, index, callee, call)
    }
    lsp_response(id, lsp_call_groups_json(groups, "to"))
}
