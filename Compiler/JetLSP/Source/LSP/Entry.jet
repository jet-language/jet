// LSP v2: completion, hover, definitions, references, rename, semantic tokens,
// inlay hints, quick fixes and formatting. JSON-RPC uses the canonical stdio
// transport; handler failures are caught and every read observes the overlay.
// Check, Position, Bench, Doctor and Protocol own the entry points directly; no
// parent-module re-export compatibility layer survives the Jet cutover.
// Test-only imports and all original tests live in Tests/LSP/Entry.jet.

// Canonical server state, protocol and request dispatch remain at their owners.
use {
    jet_devserver.EditorHost.[EDITOR_COMMAND_METHOD, EDITOR_NAVIGATE_METHOD, EDITOR_RECONNECT_METHOD, EDITOR_SELECT_METHOD, EDITOR_WORKBENCH_METHOD]
    jet_foundation.Dyn.[Dyn]
    jet_foundation.Hex.[nibble]
    jet_foundation.JSON.[foundation_json_escape, json_get, json_str, json_u32, parse_json, read_protocol_content_length, MAX_PROTOCOL_MESSAGE_BYTES]
}
// Document state is owned by DiagnosticFacts/Server, not duplicated here.
