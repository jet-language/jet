// Code actions: each fix a diagnostic in the requested range offers, then the
// marker-placement rewrites of the declaration under the cursor.
use {
    core.encoding.[Dyn]
    jet_foundation.[Diagnostic, TextEdit, DiagnosticFixApplicability, foundation_json_quote]
    jet_parser.[parser_marker_placement_edit_at]
}

lsp_code_action_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    view: lsp_view(server, params) ?? return lsp_response(id, "null")
    range: lsp_range_from_json(lsp_param(params, "range") ?? return lsp_response(id, "null")) ?? return lsp_error_response(id, -32602, "range is malformed")
    bytes: view.doc.text.bytes()
    table: lsp_line_table_bytes(bytes)
    start: lsp_checked_offset_bytes(table, bytes, range.start) ?? return lsp_error_response(id, -32602, "range is outside the document")
    end: lsp_checked_offset_bytes(table, bytes, range.end) ?? return lsp_error_response(id, -32602, "range is outside the document")
    diagnostics := [Diagnostic]{}
    loop diagnostic in lsp_retain_document_diagnostics(view.checked.diagnostics, view.doc.path, view.doc.text) {
        span: diagnostic.span ?? next
        if span.start <= end && start <= span.end -> diagnostics.push(diagnostic)
    }
    actions := [String]{}
    fixes := lsp_fixes_from_diagnostics(diagnostics.move())
    loop fix in fixes.move() {
        preferred: fix.applicability == DiagnosticFixApplicability.Safe
        whole := [TextEdit]{fix.edit.move()}
        whole.extend(fix.edits.move())
        actions.push(lsp_action_json(view, fix.title, "quickfix", whole, preferred: preferred))
    }
    if parser_marker_placement_edit_at(bytes, start, false) == .Val(edit) -> actions.push(lsp_action_json(view, "Write the markers above the declaration", "refactor.rewrite", [TextEdit]{edit}, preferred: false))
    if parser_marker_placement_edit_at(bytes, start, true) == .Val(edit) -> actions.push(lsp_action_json(view, "Write the markers inside the declaration's body", "refactor.rewrite", [TextEdit]{edit}, preferred: false))
    lsp_response(id, "[{actions.join(",")}]")
}

// The edit names the document version it was computed for, so an editor
// drops it once the text has moved on.
lsp_action_json: fn(view: LSPView, title: String, kind: String, edits: [TextEdit], preferred: Bool{false}) -> String Never! {
    preference: if preferred -> ",\"isPreferred\":true" else -> ""
    "{{\"title\":{foundation_json_quote(title)},\"kind\":{foundation_json_quote(kind)}{preference},\"edit\":{{\"documentChanges\":[{{\"textDocument\":{{\"uri\":{foundation_json_quote(view.uri)},\"version\":{view.doc.version}}},\"edits\":{lsp_text_edits_json(view.doc.text, edits)}}}]}}}}"
}
