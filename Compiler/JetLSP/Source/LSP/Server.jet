// The server's resident state: the host's checker, the open documents, what
// each publication covered, and the check each publication read.
use {
    core.encoding.[Dyn]
    jet_lexer.[Lexed, lex]
    jet_foundation.[foundation_json_integer]
    jet_pkg_model.[pkg_mask_inline_package_source]
}

LSPServer: struct {
    diagnostic_state: LSPDiagnosticState
    checker: LSPChecker
    // The check each open document's last publication read; workspace
    // symbols search these.
    published: [String:LSPChecked]
    initialized: Bool
    shutdown: Bool
    exited: Bool

    // Every open document is overlaid, so a check sees unsaved imports too.
    check: fn(self, doc: LSPDocument) -> LSPChecked {
        overlays := [LSPOverlay]{}
        loop (_, open) in self.diagnostic_state.docs -> overlays.push(LSPOverlay{path: open.path.copy(), source: open.text.copy()})
        self.checker.check(doc.path, overlays)
    }

    lex: fn(self, doc: LSPDocument) -> Lexed Never! { lsp_lex_source(doc.text) }
}

lsp_server: fn(checker: &&LSPChecker) -> LSPServer Never! {
    LSPServer{diagnostic_state: lsp_diagnostic_state(), checker: checker, published: [String:LSPChecked]{}, initialized: false, shutdown: false, exited: false}
}

// An inline package block is masked first, as the loader does, so its manifest
// text never lexes as code. Masking keeps every byte offset.
lsp_lex_source: fn(text: String) -> Lexed Never! {
    if pkg_mask_inline_package_source(text) == .Ok(masked) {
        if masked.block != None -> return lex(masked.source.bytes())
    }
    lex(text.bytes())
}

lsp_apply_content_change: fn(doc: &LSPDocument, change: Dyn) -> Bool Never! {
    replacement: lsp_text_member(change, "text") ?? return false
    length := Int?{None}
    if lsp_member(change, "rangeLength") == .Val(value) {
        length = Val(lsp_uinteger(value) ?? return false)
    }
    if lsp_member(change, "range") == .Val(value) {
        range: lsp_range_from_json(value) ?? return false
        return doc.apply_range_edit(range, length, replacement)
    }
    if length != None -> return false
    doc.replace_text(replacement)
    true
}

// didOpen stores the document; didChange applies its edits in order to a copy,
// so a rejected edit leaves the resident document and version intact. An
// accepted change list, even an empty one, advances the version and marks the
// document dirty. Returns the document's URI.
lsp_update_document: fn(state: &LSPDiagnosticState, params: Dyn?, is_open: Bool) -> String? Never! {
    document: lsp_param(params, "textDocument") ?? return None
    uri: lsp_text_member(document, "uri") ?? return None
    version: foundation_json_integer(lsp_member(document, "version") ?? return None) ?? return None
    if version < -2147483648 || version > 2147483647 -> return None
    if is_open {
        text: lsp_text_member(document, "text") ?? return None
        state.docs[uri] = LSPDocument{path: lsp_uri_to_path(uri), text: text, version: version}
        return Val(uri)
    }
    rows: if (lsp_param(params, "contentChanges") ?? return None) == {
        .Array(rows) -> rows
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> { return None }
    }
    current: state.docs.get(uri) ?? return None
    if version <= current.version -> return None
    updated := LSPDocument{path: current.path.copy(), text: current.text.copy(), version: version}
    loop change in rows {
        if !lsp_apply_content_change(updated, change) -> return None
    }
    state.docs[uri] = updated
    state.dirty[uri] = true
    Val(uri)
}
