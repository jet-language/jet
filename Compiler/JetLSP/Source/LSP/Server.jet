// The server's resident state: the host's checker, the open documents, what
// each publication covered, and the check each publication read.
use {
    core.encoding.[Dyn]
    jet_driver.[JetDriverSourceDocument, JetDriverToolStageItem, jet_driver_tool_stage_plan]
    jet_lexer.[Lexed, lex]
    jet_foundation.[foundation_json_integer, path_case_diagnostic, path_case_disk_findings]
    jet_pkg_model.[pkg_mask_inline_package_source]
}

LSPServer: struct {
    diagnostic_state: LSPDiagnosticState,
    checker: LSPChecker,
    // The check each open document's last publication read; without
    // workspace folders, workspace symbols search these.
    published: [String:LSPChecked],
    initialized: Bool,
    shutdown: Bool,
    exited: Bool,
    // The client applies versioned `documentChanges` edits
    // (`workspace.workspaceEdit.documentChanges` in `initialize`).
    document_changes: Bool,
    // The semantic tokens last answered in full for each open document, which
    // a `full/delta` request names by result id, and the last id given.
    semantic_results: [String:LSPSemanticResult],
    semantic_serial: Int,
    // The workspace folders' paths, once the client names any (its
    // `workspaceFolders` or `rootUri` in `initialize`, then each
    // `workspace/didChangeWorkspaceFolders`); workspace symbols search the
    // files below them.
    workspace_named: Bool{false},
    workspace_roots: [String]{[String]{}},
    // The client resolves a code action's edit
    // (`textDocument.codeAction.resolveSupport` lists `edit`), so the action
    // list leaves the edits out.
    code_action_resolve: Bool{false},
    // The client pulls diagnostics (`textDocument.diagnostic`), so none is
    // pushed: each document's are answered when the client asks.
    pull_diagnostics: Bool{false},

    // Every open document is overlaid, so a check sees unsaved imports too.
    // In the Jet repository the document's own path is held to the path case
    // rule (jet_foundation's PathCase.jet), as `jet check` holds it.
    check: fn(self, doc: LSPDocument) -> LSPChecked {
        check_path: lsp_doc_check_path(doc)
        ^checked: self.checker.check(check_path, self.overlays())
        if doc.host_doc == .Val(host_doc) {
            checked.diagnostics = lsp_doc_map_diagnostics(host_doc, checked.diagnostics.move())
            checked.reports = [String]{}
            return checked
        }
        loop placed in path_case_disk_findings([String]{doc.path}) {
            checked.diagnostics.push(path_case_diagnostic(placed.finding))
        }
        checked
    }

    // The answer rows of `stage`'s hooks on the document `view` reads: the
    // calls the `#On(stage, Marker)` hooks of the packages it imports make
    // on its marked blocks (JetDriver ToolStages.jet), only on the block
    // holding byte `at` when one is given. None until the check read the
    // document's current text, whose offsets the rows name.
    stage_items: fn(self, view: LSPView, stage: String, at: Int{-1}) -> [JetDriverToolStageItem] {
        ^items: [JetDriverToolStageItem]{}
        module_path: view.module_path ?? return items
        index: lsp_module_index(view.checked, module_path) ?? return items
        ^plan: jet_driver_tool_stage_plan(view.checked.modules, index, stage, at: at)
        if plan.bodies.len() == 0 -> return items
        loop rows in self.checker.stage(lsp_doc_check_path(view.doc), self.overlays(), stage, plan.bodies, plan.program.move()) {
            loop row in rows -> items.push(row)
        }
        items
    }

    overlays: fn(self) -> [JetDriverSourceDocument] Never! {
        overlays: loop (_, open) in self.diagnostic_state.docs -> if open.host_doc == {
            .Val(host_doc) -> JetDriverSourceDocument{path: "{host_doc.path}", source: "{host_doc.source}", host: host_doc.host}
            .None -> JetDriverSourceDocument{path: open.path.copy(), source: open.text.copy()}
        }
        overlays
    }

    lex: fn(self, doc: LSPDocument) -> Lexed Never! { lsp_lex_source(lsp_doc_jet_text(doc)) }
}

lsp_server: fn(checker: ^^LSPChecker) -> LSPServer Never! {
    LSPServer{diagnostic_state: lsp_diagnostic_state(), checker: checker, published: [String:LSPChecked]{}, initialized: false, shutdown: false, exited: false, document_changes: false, semantic_results: [String:LSPSemanticResult]{}, semantic_serial: 0}
}

// An inline package block is masked first, as the loader does, so its manifest
// text never lexes as code. Masking keeps every byte offset.
lsp_lex_source: fn(text: String) -> Lexed Never! {
    if pkg_mask_inline_package_source(text) == .Ok(masked) {
        if masked.block != None -> return lex(masked.source.bytes())
    }
    lex(text.bytes())
}

lsp_apply_content_change: fn(doc: ^LSPDocument, change: Dyn) -> Bool Never! {
    replacement: lsp_text_member(change, "text") ?? return false
    ^length: Int?{None}
    if lsp_member(change, "rangeLength") == .Val(value) {
        length = Val(lsp_uinteger(value) ?? return false)
    }
    if lsp_member(change, "range") == .Val(value) {
        range: lsp_range_from_json(value) ?? return false
        return doc.apply_range_edit(range, length, replacement)
    }
    if length != None -> return false
    doc.replace_text(replacement)
    true
}

// didOpen stores the document; didChange applies its edits in order to a copy,
// so a rejected edit leaves the resident document and version intact. An
// accepted change list, even an empty one, advances the version and marks the
// document dirty. A document opened in another language without embedded Jet
// regions is not kept, so it is never checked. Returns the document's URI.
lsp_update_document: fn(state: ^LSPDiagnosticState, params: Dyn?, is_open: Bool{false}) -> String? Never! {
    document: lsp_param(params, "textDocument") ?? return None
    uri: lsp_text_member(document, "uri") ?? return None
    version: foundation_json_integer(lsp_member(document, "version") ?? return None) ?? return None
    if version < -2147483648 || version > 2147483647 -> return None
    if is_open {
        text: lsp_text_member(document, "text") ?? return None
        path: lsp_uri_to_path(uri)
        ^host_doc: JetDriverSourceDocument?{None}
        if lsp_text_member(document, "languageId") == .Val(language) {
            if language != "jet" {
                host_doc = lsp_extract_host_document(path, version, text, language)
                if host_doc == None -> return None
            }
        }
        state.docs[uri] = LSPDocument{path: path, text: text, version: version, host_doc: host_doc}
        return Val(uri)
    }
    rows: if (lsp_param(params, "contentChanges") ?? return None) == {
        .Array(rows) -> rows
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> {
            return None
        }
    }
    current: state.docs.get(uri) ?? return None
    if version <= current.version -> return None
    is_host: current.host_doc != None
    ^updated: LSPDocument{path: current.path, text: current.text, version: version}
    loop change in rows {
        if !lsp_apply_content_change(updated, change) -> return None
    }
    if is_host {
        updated.host_doc = Val(lsp_extract_host_document("{updated.path}", version, "{updated.text}", "html") ?? lsp_empty_host_document("{updated.path}", version, "{updated.text}"))
    }
    state.docs[uri] = updated
    state.dirty[uri] = true
    Val(uri)
}
