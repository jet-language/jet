// The open documents and what each publication covered. The request loop owns
// the checker and the transport; this holds no checked result.

// An open editor document: its file path, unsaved text and editor version.
LSPDocument: struct {
    path: String
    text: String
    version: Int

    replace_text: fn(&self, text: String) Never! { self.text = text }

    apply_range_edit: fn(&self, range: LSPRange, range_length: Int?, text: String) -> Bool Never! {
        replacement: lsp_apply_edit(self.text, range, range_length, text) ?? return false
        self.text = replacement
        true
    }
}

LSPDiagnosticState: struct {
    docs: [String:LSPDocument]
    // Documents edited since their diagnostics were last published.
    dirty: [String:Bool]
    // The URIs each root's last publication wrote diagnostics for.
    diagnostic_targets: [String:[String:Bool]]
    // The file paths each root's last check read.
    checked_modules: [String:[String]]
}

lsp_diagnostic_state: fn() -> LSPDiagnosticState Never! {
    LSPDiagnosticState{docs: [String:LSPDocument]{}, dirty: [String:Bool]{}, diagnostic_targets: [String:[String:Bool]]{}, checked_modules: [String:[String]]{}}
}
