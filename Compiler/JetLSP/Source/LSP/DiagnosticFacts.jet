// The sole document and publication facts. The request loop owns
// queries/transport; this is not another Server, checked bundle, semantic
// index, or private compiler-query cache.
use lsp_diag_path: core.files.runtime.kernel_path_components

LSPDocument: struct {
    path: lsp_diag_path.OsPath
    text: String
    version: Int

    new: fn(path: ^lsp_diag_path.OsPath, text: ^String, version: Int) -> LSPDocument Never! {
        LSPDocument{path: path, text: text, version: version}
    }

    replace_text: fn(&self, text: ^String) Never! { self.text = text }

    apply_range_edit: fn(&self, range: LSPRange, range_length: Int?, text: String) -> Bool Never! {
        replacement: lsp_apply_edit(self.text, range, range_length, text) ?? return false
        self.text = replacement
        true
    }
}

LSPDiagnosticState: struct {
    docs: [String:LSPDocument]
    dirty: [String:Bool]
    diagnostic_targets: [String:[String:Bool]]
    // Only the small paths read by each successful publication are retained.
    // Native identity comes from Driver's original loaded-module rows, not
    // registration order, serialized compiler-service values or source text.
    checked_modules: [String:[lsp_diag_path.OsPath]]

    new: fn() -> LSPDiagnosticState Never! {
        LSPDiagnosticState{docs: [String:LSPDocument]{}, dirty: [String:Bool]{}, diagnostic_targets: [String:[String:Bool]]{}, checked_modules: [String:[lsp_diag_path.OsPath]]{}}
    }
}
