fn fresh_name(db: SymbolDB, base: String) -> String {
    if !db.defs.iter().any(fn(definition) { definition.name == base }) -> return base
    suffix := 2
    loop {
        candidate :: "${base}_${suffix}"
        if !db.defs.iter().any(fn(definition) { definition.name == candidate }) -> return candidate
        suffix += 1
    }
}
