fn marker_modifier(tokens: [Token], idx: USize) -> U32? {
    tok :: tokens[idx]
    if tok.kind == .Hash -> return marker_kind_after(tokens, idx).map(fn(kind) { kind.modifier() })
    prev :: previous_significant(tokens, idx) ?? return None
    if tokens[prev].kind == .Hash && marker_name(tokens, idx).is_some() {
        marker_kind_for(tokens[prev], tokens, idx).map(fn(kind) { kind.modifier() })
    } else { None }
}
