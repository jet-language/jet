fn is_contextual_next(tokens: [Token], idx: USize) -> Bool {
    previous :: previous_significant(tokens, idx).map(fn(idx) { tokens[idx].kind })
    next :: next_significant(tokens, idx).map(fn(idx) { tokens[idx].kind })
    if previous == Val(.QuestionQuestion) -> return true
    if previous != Val(.LBrace) && previous != Val(.Semi) -> return false
    next == Val(.Semi) || next == Val(.RBrace)
}
