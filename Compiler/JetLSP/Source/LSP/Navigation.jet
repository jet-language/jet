// Hover, definition, references, highlights, rename and signature help: each
// answers from the checked index of the document's current text.
use {
    core.encoding.[Dyn]
    jet_foundation.[Span, foundation_json_quote, type_name]
    jet_lexer.[Lexed, Token, TOKEN_IDENT, TOKEN_LPAREN, TOKEN_RPAREN, TOKEN_LBRACKET, TOKEN_RBRACKET, TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_COMMA, TOKEN_COLON, lex, token_text]
    jet_semindex.[SemDef, SemSymbolKind]
}

// The view and the byte offset a positional request names.
LSPAt: struct {
    view: LSPView
    offset: Int
}

lsp_at: fn(server: LSPServer, params: Dyn?) -> LSPAt? {
    position: lsp_params_position(params) ?? return None
    view: lsp_view(server, params) ?? return None
    bytes: view.doc.text.bytes()
    offset: lsp_checked_offset_bytes(lsp_line_table_bytes(bytes), bytes, position) ?? return None
    Val(LSPAt{view: view, offset: offset})
}

lsp_hover_markdown: fn(signature: String, summary: String) -> String Never! {
    if summary == "" -> return "```jet\n{signature}\n```"
    "```jet\n{signature}\n```\n\n{summary}"
}

lsp_hover_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    markdown := String?{None}
    if at.view.checked.index == .Val(index) {
        if lsp_target_at(at.view, at.offset) == .Val(target) {
            if lsp_definition_at(index, target) == .Val(def) {
                markdown = Val(lsp_hover_markdown(def.qualified_name, ""))
                if lsp_symbol_for(at.view.checked.symbols, def) == .Val(symbol) -> markdown = Val(lsp_hover_markdown(symbol.signature, symbol.summary))
            }
        }
    }
    if markdown == None -> markdown = lsp_keyword_hover(at.view, at.offset)
    text: markdown ?? return lsp_response(id, "null")
    range := ""
    if lsp_ident_token_at(at.view.lexed, at.offset) == .Val(name) -> range = ",\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, name.span))}"
    lsp_response(id, "{{\"contents\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(text)}}}{range}}}")
}

// A keyword under the cursor hovers with the language's own description.
lsp_keyword_hover: fn(view: LSPView, offset: Int) -> String? Never! {
    loop token in view.lexed.tokens {
        if token.span.start > offset -> break
        if !lsp_span_holds(token.span, offset) || token.kind == TOKEN_IDENT -> next
        text: token_text(view.lexed.tables, token)
        loop symbol in view.checked.symbols {
            if symbol.kind == SemSymbolKind.Keyword && symbol.name == text -> return Val(lsp_hover_markdown(symbol.signature, symbol.summary))
        }
    }
    None
}

lsp_definition_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "null")
    location: lsp_location(at.view.checked, target.module_path, target.span) ?? return lsp_response(id, "null")
    lsp_response(id, lsp_location_json(location))
}

lsp_references_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "[]")
    declaration: lsp_bool_member(lsp_param(params, "context") ?? Dyn.Null, "includeDeclaration")
    rows := [String]{}
    loop occurrence in lsp_occurrences(index, target, declaration: declaration) {
        if lsp_location(at.view.checked, occurrence.module_path, occurrence.span) == .Val(location) -> rows.push(lsp_location_json(location))
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// Highlights in this document: the declaration writes, each reference reads.
lsp_document_highlight_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    module_path: at.view.module_path ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "[]")
    rows := [String]{}
    loop occurrence in lsp_occurrences(index, target, declaration: true) {
        if occurrence.module_path != module_path -> next
        kind: if occurrence.target == None -> 3 else -> 2
        rows.push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, occurrence.span))},\"kind\":{kind}}}")
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// What a rename may change: a declaration in an open document, so every file
// the rename edits is one the editor holds.
LSPRenameTarget: struct {
    def: SemDef
    // The name's span under the cursor.
    span: Span
}

lsp_rename_target: fn(server: LSPServer, at: LSPAt) -> LSPRenameTarget LSPRPCError! {
    index: at.view.checked.index ?? return Err(LSPRPCError{code: -32803, message: "the document has not been checked"})
    target: lsp_target_at(at.view, at.offset) ?? return Err(LSPRPCError{code: -32803, message: "no declaration is under the cursor"})
    def: lsp_definition_at(index, target) ?? return Err(LSPRPCError{code: -32803, message: "only a declaration in Jet source can be renamed"})
    module_index: lsp_module_index(at.view.checked, def.module_path) ?? return Err(LSPRPCError{code: -32803, message: "`{def.name}` is declared outside the checked modules"})
    if !lsp_path_is_open(server, at.view.checked.modules[module_index].physical_path) -> return Err(LSPRPCError{code: -32803, message: "open the file that declares `{def.name}` to rename it"})
    token: lsp_ident_token_at(at.view.lexed, at.offset) ?? return Err(LSPRPCError{code: -32803, message: "no name is under the cursor"})
    if token_text(at.view.lexed.tables, token) != def.name -> return Err(LSPRPCError{code: -32803, message: "no name is under the cursor"})
    Ok(LSPRenameTarget{def: def, span: token.span})
}

lsp_path_is_open: fn(server: LSPServer, path: String) -> Bool Never! {
    if path == "" -> return false
    loop (_, doc) in server.diagnostic_state.docs {
        if lsp_source_paths_equal(doc.path, path) -> return true
    }
    false
}

lsp_prepare_rename_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    if lsp_rename_target(server, at) == {
        .Ok(target) -> lsp_response(id, "{{\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, target.span))},\"placeholder\":{foundation_json_quote(target.def.name)}}}")
        .Err(problem) -> lsp_error_response(id, problem.code, problem.message)
    }
}

// A new name must lex as exactly one identifier, so no keyword passes.
lsp_valid_identifier: fn(name: String) -> Bool Never! {
    lexed: lex(name.bytes())
    if lexed.diagnostics.len() != 0 || lexed.tokens.len() == 0 -> return false
    first: lexed.tokens[0]
    if first.kind != TOKEN_IDENT || first.span.start != 0 || first.span.end != name.count_bytes() -> return false
    lexed.tokens.len() == 1 || lexed.tokens[1].span.start >= name.count_bytes()
}

lsp_rename_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    new_name: lsp_text_member(params ?? return lsp_response(id, "null"), "newName") ?? return lsp_error_response(id, -32602, "rename needs a string newName")
    if !lsp_valid_identifier(new_name) -> return lsp_error_response(id, -32602, "`{new_name}` is not an identifier")
    target: if lsp_rename_target(server, at) == {
        .Ok(found) -> found
        .Err(problem) -> { return lsp_error_response(id, problem.code, problem.message) }
    }
    index: at.view.checked.index ?? return lsp_response(id, "null")
    by_uri := [String:[String]]{}
    order := [String]{}
    loop occurrence in lsp_occurrences(index, LSPTarget{module_path: target.def.module_path, span: target.def.def_span}, declaration: true) {
        location: lsp_location(at.view.checked, occurrence.module_path, occurrence.span) ?? next
        span: lsp_name_span(location.source, occurrence.span, target.def.name)
        if span.end > location.source.count_bytes() || location.source.slice(span.start, span.end) != target.def.name -> next
        if !by_uri.has_key(location.uri) {
            by_uri[location.uri] = [String]{}
            order.push(location.uri)
        }
        by_uri[location.uri].push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(location.source, span))},\"newText\":{foundation_json_quote(new_name)}}}")
    }
    order.sort()
    files := [String]{}
    loop uri in order -> files.push("{foundation_json_quote(uri)}:[{by_uri[uri].join(",")}]")
    lsp_response(id, "{{\"changes\":{{{files.join(",")}}}}}")
}

// The call whose argument list holds the cursor: the callee's name token and
// which argument the cursor is in. Brackets nest; strings and comments are
// single tokens, so their commas never count.
LSPActiveCall: struct {
    callee: Token
    argument: Int
    // The label the active argument spells (`name: value`), if any.
    label: String?
}

lsp_active_call: fn(lexed: Lexed, offset: Int) -> LSPActiveCall? Never! {
    tokens: lexed.tokens
    end := 0
    loop end < tokens.len() && tokens[end].span.end <= offset -> end += 1
    depth := 0
    argument := 0
    argument_start := end
    cursor := end
    loop cursor > 0 {
        cursor -= 1
        kind: tokens[cursor].kind
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            depth += 1
            next
        }
        if kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_LPAREN {
            if depth > 0 {
                depth -= 1
                next
            }
            if kind != TOKEN_LPAREN || cursor == 0 || tokens[cursor - 1].kind != TOKEN_IDENT -> return None
            if argument == 0 -> argument_start = cursor + 1
            label := String?{None}
            if argument_start + 1 < end && tokens[argument_start].kind == TOKEN_IDENT && tokens[argument_start + 1].kind == TOKEN_COLON {
                label = Val(token_text(lexed.tables, tokens[argument_start]))
            }
            return Val(LSPActiveCall{callee: tokens[cursor - 1], argument: argument, label: label})
        }
        if kind == TOKEN_COMMA && depth == 0 {
            if argument == 0 -> argument_start = cursor + 1
            argument += 1
        }
    }
    None
}

lsp_signature_help_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    call: lsp_active_call(at.view.lexed, at.offset) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, call.callee.span.start) ?? return lsp_response(id, "null")
    def: lsp_definition_at(index, target) ?? return lsp_response(id, "null")
    callable: if def.kind == {
        .Function(callable) -> callable
        else -> { return lsp_response(id, "null") }
    }
    label := def.qualified_name
    documentation := ""
    if lsp_symbol_for(at.view.checked.symbols, def) == .Val(symbol) {
        label = symbol.signature
        documentation = symbol.summary
    }
    rows := [String]{}
    active := call.argument
    loop (position, param) in callable.params {
        param_label: "{param.name}: {type_name(param.ty)}"
        rows.push("{{\"label\":{foundation_json_quote(param_label)}}}")
        if call.label == .Val(name) {
            if param.label == name || param.name == name -> active = position
        }
    }
    docs: if documentation == "" -> "" else -> ",\"documentation\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(documentation)}}}"
    lsp_response(id, "{{\"signatures\":[{{\"label\":{foundation_json_quote(label)}{docs},\"parameters\":[{rows.join(",")}]}}],\"activeSignature\":0,\"activeParameter\":{active}}}")
}
