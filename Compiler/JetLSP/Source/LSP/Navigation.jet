fn semantic_token_type_for(tokens: [Token], idx: USize, src: String) -> (U32, U32)? {
    tok :: tokens[idx]
    if marker_modifier(tokens, idx) == .Val(marker_mod) -> return Val((st.DECORATOR, marker_mod))
    if tok.kind == {
        .KwFn | .KwPub | .KwIf | .KwElse | .KwBreak | .KwReturn | .KwStruct | .KwEnum |
        .KwImpl | .KwTrait | .KwTag | .KwDerive | .KwConst | .KwComptime | .KwUse |
        .KwExtern | .KwLoop | .KwSelf | .KwNull | .KwIt | .KwModule -> Val((st.KEYWORD, 0)),
        .KwTrue | .KwFalse -> Val((st.KEYWORD, sm.READONLY)),
        .KwCopy -> Val((st.OWNERSHIP, sm.COPY)),
        .KwMutate | .KwMove -> None,
        .Ident(name) -> {
            if name == Syntax.KW_NEXT && is_contextual_next(tokens, idx) -> return Val((st.KEYWORD, 0))
            if is_live_teaching_semantic_word(name) -> return None
            if name.chars().next().is_some_and(fn(c) { c.is_uppercase() }) { Val((st.TYPE, 0)) } else { Val((st.VARIABLE, 0)) }
        }
        .Str(_) -> Val((st.STRING, 0)),
        .Int(_, _) | .Float(_) | .Char(_) -> Val((st.NUMBER, 0)),
        .LineComment(_) | .BlockComment(_) -> Val((st.COMMENT, 0)),
        .Plus | .Minus | .Star | .Slash | .Percent | .Pipe | .Shl | .Shr | .AndAnd | .OrOr |
        .Bang | .EqEq | .NotEq | .Lt | .Gt | .Le | .Ge | .Compare | .UnifiedArrow |
        .LambdaArrow | .Question | .DotDot | .DotDotLt -> Val((st.OPERATOR, 0)),
        .Amp -> { if token_text(src, tok) == Syntax.SIGIL_WRITE { Val((st.OWNERSHIP, sm.WRITE_BORROW)) } else { None } },
        .Caret -> { if token_text(src, tok) == Syntax.SIGIL_MOVE { Val((st.OWNERSHIP, sm.MOVE)) } else { None } },
        else -> None
    }
}
