fn binding_for_initializer(db: SymbolDB, src: String, path: String, initializer: jet_semindex.StructuralNode) -> SymDef? {
    start :: line_start(src, initializer.span.start)
    db.defs.iter().filter(fn(definition) {
        definition.module_path == path && definition.kind.is_local() && start <= definition.def_span.start && definition.def_span.end <= initializer.span.start
    }).max_by_key(fn(definition) { definition.def_span.start })
