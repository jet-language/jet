// Rust: Source/LSP/Features.rs:3310
fn initializer_for_binding(db: SymbolDB, src: String, path: String, binding: SymDef) -> jet_semindex.StructuralNode? {
    end :: src[binding.def_span.start..].find(['\r', '\n']).map_or(src.len(), fn(offset) { binding.def_span.start + offset })
    db.nodes.iter().filter(fn(node) {
        node.module_path == path && node.class == "expr" && node.slot == "initializer" && binding.def_span.end <= node.span.start && node.span.end <= end
    }).min_by_key(fn(node) { node.span.start })
}
