fn is_scalar_type(ty: jet_foundation.AST.Type) -> Bool { is_scalar_name(ty.name()) }
// Rust: Source/LSP/Features.rs:3364
fn is_scalar_name(name: String) -> Bool { name == "Bool" || name == "Char" || name == "Int" || name == "Float" }
