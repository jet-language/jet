fn trim_span(src: String, span: Span) -> Span? {
    text :: src.get(span.start..<span.end) ?? return None
    start :: text.len() - text.trim_start().len()
    end :: text.trim_end().len()
    if start < end { Val(Span.new(span.start + start, span.start + end)) } else { None }
}
// Rust: Source/LSP/Features.rs:3748
fn spans_touch(left: Span, right: Span) -> Bool { left.start <= right.end && right.start <= left.end }
// Rust: Source/LSP/Features.rs:3752
fn line_start(src: String, offset: USize) -> USize {
    src[..offset.min(src.len())].rfind('\n').map_or(0, fn(index) { index + 1 })
}
// Rust: Source/LSP/Features.rs:3758
fn line_end_including_newline(src: String, offset: USize) -> USize {
    src[offset.min(src.len())..].find('\n').map_or(src.len(), fn(index) { offset.min(src.len()) + index + 1 })
}
