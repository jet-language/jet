// Hover, definition, references, highlights, rename and signature help: each
// answers from the checked index of the document's current text.
use {
    core.encoding.[Dyn]
    jet_driver.[jet_driver_layout_line, jet_driver_layout_summary]
    jet_foundation.[Span, Type, derivation_record_line, derivation_record_notable, derivation_store_subject, foundation_byte_text, foundation_json_quote, type_identity_unqualified_nominals, type_name]
    jet_lexer.[Lexed, Token, TOKEN_DOT, TOKEN_IDENT, TOKEN_LPAREN, TOKEN_RPAREN, TOKEN_LBRACKET, TOKEN_RBRACKET, TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_COMMA, TOKEN_COLON, lex, token_text]
    jet_semindex.[SemDeclared, SemDef, SemIndex, SemSymbolKind, semindex_ambient_print, semindex_import_binding, semindex_renamed_identity]
}

// The view, the byte offset a positional request names, and its 0-based line.
LSPAt: struct {
    view: LSPView,
    offset: Int,
    line: Int,
}

lsp_at: fn(server: LSPServer, params: Dyn?) -> LSPAt? {
    position: lsp_params_position(params) ?? return None
    view: lsp_view(server, params) ?? return None
    bytes: view.doc.text.bytes()
    offset: lsp_checked_offset_bytes(lsp_line_table_bytes(bytes), bytes, position) ?? return None
    Val(LSPAt{view: view, offset: offset, line: position.line})
}

lsp_hover_markdown: fn(signature: String, summary: String) -> String Never! {
    if summary == "" -> return "```jet\n{signature}\n```"
    "```jet\n{signature}\n```\n\n{summary}"
}

// The declaration a call's name at `offset` reaches that the checked index
// holds no definition for. A Core function the document imports, through
// its module (`term.print` under `use core.term`) or by name (`print` under
// `use core.term.[print]`), is the Core module's own declaration. A free
// `print` call the source resolves to nothing else is the ambient print.
lsp_declared_at: fn(view: LSPView, offset: Int) -> SemDeclared? Never! {
    tokens: view.lexed.tokens
    at: lsp_ident_position(tokens, offset)
    if at < 0 -> return None
    name: token_text(view.lexed.tables, tokens[at])
    dotted: at >= 1 && tokens[at - 1].kind == TOKEN_DOT
    ^qualified: String?{None}
    if dotted && at >= 2 && tokens[at - 2].kind == TOKEN_IDENT {
        if lsp_import_binding(view, token_text(view.lexed.tables, tokens[at - 2])) == .Val(module_name) {
            qualified = Val("{module_name}.{name}")
        }
    }
    if !dotted -> qualified = lsp_import_binding(view, name)
    if qualified == .Val(wanted) {
        loop declared in view.checked.declared {
            if declared.def.qualified_name == wanted -> return Val(declared)
        }
        return None
    }
    if dotted || at + 1 >= tokens.len() || tokens[at + 1].kind != TOKEN_LPAREN -> return None
    // A `print` the source declares is that declaration.
    if lsp_target_at(view, offset) != None -> return None
    ambient: semindex_ambient_print()
    if name != ambient.def.name -> return None
    Val(ambient)
}

// The position in `tokens` of the identifier at `offset`, or -1.
lsp_ident_position: fn(tokens: [Token], offset: Int) -> Int Never! {
    loop (position, token) in tokens {
        if token.span.start > offset -> return -1
        if token.kind == TOKEN_IDENT && lsp_span_holds(token.span, offset) -> return position
    }
    -1
}

// The Core name an import of the document binds to `local`
// (JetSemIndex semindex_import_binding).
lsp_import_binding: fn(view: LSPView, local: String) -> String? Never! {
    module_path: view.module_path ?? return None
    module_ref: view.checked.modules[lsp_module_index(view.checked, module_path) ?? return None]
    bound: semindex_import_binding(module_ref.imports, local) ?? return None
    if !bound.starts_with("core.") -> return None
    Val(bound)
}

// A declaration's hover: its signature and summary, then the module that
// declares it and the name it is declared as.
lsp_declared_markdown: fn(declared: SemDeclared) -> String Never! {
    "{lsp_hover_markdown(declared.symbol.signature, declared.symbol.summary)}\n\nDeclared in `{declared.def.module_path}` as `{declared.def.qualified_name}`."
}

// A method call's name at `offset`, which the index resolves to no
// definition, on a one-name receiver whose type the check knows
// (lsp_checked_type): the compiler-owned `copy` and `move` every value has,
// else the method that type's symbols hold, written in the source or built
// in (`text.trim()`). Its hover is its signature, the receiver's type
// spelled for `copy` and `move`.
lsp_method_markdown: fn(view: LSPView, offset: Int) -> String? Never! {
    tokens: view.lexed.tokens
    at: lsp_ident_position(tokens, offset)
    if at < 2 || tokens[at - 1].kind != TOKEN_DOT || at + 1 >= tokens.len() || tokens[at + 1].kind != TOKEN_LPAREN {
        return None
    }
    index: view.checked.index ?? return None
    receiver: lsp_target_at(view, tokens[at - 2].span.start) ?? return None
    shown: type_name(type_identity_unqualified_nominals(lsp_checked_type(lsp_definition_at(index, receiver) ?? return None) ?? return None))
    name: token_text(view.lexed.tables, tokens[at])
    if name == "copy" || name == "move" {
        summary: if name == "copy" -> "A new value equal to the receiver, which keeps its own." else -> "Takes the value out of the named place it is read from."
        return Val(lsp_hover_markdown("{shown}.{name}() -> {shown}", summary))
    }
    owner: lsp_type_owner(shown)
    loop symbol in view.checked.symbols {
        if symbol.name == name && (symbol.owner ?? "") == owner {
            return Val(lsp_hover_markdown(symbol.signature, symbol.summary))
        }
    }
    None
}

lsp_hover_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    ^markdown: String?{None}
    if at.view.checked.index == .Val(index) {
        ^hovered: SemDef?{None}
        if lsp_target_at(at.view, at.offset) == .Val(target) {
            if lsp_definition_at(index, target) == .Val(def) {
                markdown = Val(lsp_hover_markdown(def.qualified_name, ""))
                if lsp_symbol_for(at.view.checked.symbols, def) == .Val(symbol) {
                    markdown = Val(lsp_hover_markdown(symbol.signature, symbol.summary))
                }
                // A struct or enum also shows its layout on the checked target.
                if lsp_layout_markdown(at.view.checked, def) == .Val(layout) {
                    markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{layout}") else -> Val(layout)
                }
                // A foreign or generated declaration says where it comes from
                // and what the check can't know about it.
                if lsp_origin_markdown(at.view.checked, def) == .Val(origin) {
                    markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{origin}") else -> Val(origin)
                }
                hovered = Val(def)
            }
        }
        if markdown == None && lsp_declared_at(at.view, at.offset) == .Val(declared) {
            markdown = Val(lsp_declared_markdown(declared))
        }
        if markdown == None -> markdown = lsp_method_markdown(at.view, at.offset)
        if markdown == None -> markdown = lsp_keyword_hover(at.view, at.offset)
        // How the check knows what is hovered, when its derivation says more
        // than that the definition checked.
        if lsp_derivation_markdown(at, index, hovered) == .Val(known) {
            markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{known}") else -> Val(known)
        }
    }
    if markdown == None -> markdown = lsp_keyword_hover(at.view, at.offset)
    if markdown == None -> markdown = lsp_discovery_hover(server, at.view, at.offset)
    // Anywhere in a generated module, the hover names what made it.
    if at.view.checked.producer == .Val(producer) {
        note: lsp_producer_markdown(producer)
        markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{note}") else -> Val(note)
    }
    // On a `#Todo`, the hover lists the goal's ranked in-scope candidates.
    if lsp_goal_markdown(at) == .Val(goal) {
        markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{goal}") else -> Val(goal)
    }
    // On a line the compiler made automatic choices for, the hover lists
    // them with their reasons.
    if lsp_choices_markdown(at) == .Val(choices) {
        markdown = if markdown == .Val(shown) -> Val("{shown}\n\n{choices}") else -> Val(choices)
    }
    text: markdown ?? return lsp_response(id, "null")
    ^range: ""
    if lsp_ident_token_at(at.view.lexed, at.offset) == .Val(name) {
        range = ",\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, name.span))}"
    }
    lsp_response(id, "{{\"contents\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(text)}}}{range}}}")
}

// The derivation records that say more about the hovered place than that its
// definition checked (derivation_record_notable): the hovered definition's,
// and the frame schedule of each `on_frame` callback the hover sits in, as
// the relation holds them. One `Known by …` line each; None when none.
lsp_derivation_markdown: fn(at: LSPAt, index: SemIndex, hovered: SemDef?) -> String? Never! {
    ^lines: [String]{}
    if hovered == .Val(def) {
        loop fact in index.definition_facts {
            if fact.human_identity != def.identity || fact.module_path != def.module_path -> next
            loop record in derivation_store_subject(index.derivations, fact.stable_id) {
                if derivation_record_notable(record) {
                    lines.push("Known by {derivation_record_line(record)}: {record.claim}")
                }
            }
        }
    }
    if at.view.module_path == .Val(module_path) && lsp_module_index(at.view.checked, module_path) == .Val(module_index) {
        loop function in at.view.checked.modules[module_index].functions {
            loop node in function.tree.nodes {
                if node.kind == .Lambda(lambda) && lambda.frame_schedule_derivation == .Val(scheduled) && lsp_span_holds(lambda.source_span, at.offset) {
                    loop record in derivation_store_subject(index.derivations, scheduled.subject) {
                        lines.push("Known by {derivation_record_line(record)}: {record.claim}")
                    }
                }
            }
        }
    }
    if lines.len() == 0 -> return None
    Val(lines.join("\n\n"))
}

// The hovered type's layout as one line, read from the record the check made
// for it (JetDriver LayoutSummary.jet): no layout is computed here. None
// when the definition is no struct or enum, or a byte fact is unknown.
lsp_layout_markdown: fn(checked: LSPChecked, def: SemDef) -> String? Never! {
    module_ref: checked.modules[lsp_module_index(checked, def.module_path) ?? return None]
    loop row in module_ref.layout_facts {
        if row.name != def.name || !lsp_span_holds(def.def_span, row.span.start) -> next
        summary: jet_driver_layout_summary(row.value) ?? return None
        return Val("Layout on `{summary.target}`: {jet_driver_layout_line(summary)} (not promised)")
    }
    None
}

// Where a declaration comes from when it isn't handwritten Jet, and the facts
// the check can't know about it. A foreign function's body lies outside the
// check, which reads only its declaration; a declaration in a module under
// `.jet/generated/` was written by the package's build. Each fact the index
// marks unavailable is named with its reason. None for a handwritten
// declaration whose facts are all known.
lsp_origin_markdown: fn(checked: LSPChecked, def: SemDef) -> String? Never! {
    ^lines: [String]{}
    if def.kind == .Function(callable) {
        if callable.foreign_boundary {
            lines.push("Origin: foreign. The check reads this declaration, not the foreign body, so what the body does beyond its declared signature is an unknown analysis boundary.")
        }
        ^unknown: [String]{}
        if callable.failure_unavailable == .Val(missing) {
            unknown.push("failure contract ({missing.reason})")
        }
        if callable.generic_unavailable == .Val(missing) {
            unknown.push("generic parameters ({missing.reason})")
        }
        if unknown.len() > 0 -> lines.push("Unknown to the check: {unknown.join("; ")}.")
    }
    if lsp_module_index(checked, def.module_path) == .Val(module_index) {
        module_ref: checked.modules[module_index]
        if lsp_generated_module(module_ref.path) || lsp_generated_module(module_ref.physical_path) {
            lines.push("Origin: generated module `{module_ref.path}`, written by the package's build, not by hand.")
        }
    }
    if lines.len() == 0 -> return None
    Val(lines.join("\n\n"))
}

// Whether `path` names a module under a package's `.jet/generated/`.
lsp_generated_module: fn(path: String) -> Bool Never! {
    path.starts_with(".jet/generated/") || path.contains("/.jet/generated/")
}

// The `#Todo` goal under the cursor in the document's checked module: its
// expected type and the ranked in-scope names that fit it, read from the goal
// row the check made (TTypedGoal), the list `jet check` prints. The last row
// holding the cursor is the innermost goal.
lsp_goal_markdown: fn(at: LSPAt) -> String? Never! {
    module_path: at.view.module_path ?? return None
    module_index: lsp_module_index(at.view.checked, module_path) ?? return None
    ^found: String?{None}
    loop function in at.view.checked.modules[module_index].functions {
        loop goal in function.typed_goals {
            if !lsp_span_holds(goal.span, at.offset) -> next
            shown: if goal.candidates.len() == 0 -> "none in scope" else -> "`{goal.candidates.join("`, `")}`"
            found = Val("Goal: `{goal.expected}`\n\nCandidates: {shown}")
        }
    }
    found
}

// The automatic choices the check records on the hovered line of the
// document's checked module, one `- kind: choice` line each.
lsp_choices_markdown: fn(at: LSPAt) -> String? Never! {
    module_path: at.view.module_path ?? return None
    ^lines: [String]{}
    loop choice in at.view.checked.choices {
        if choice.module_path == module_path && choice.line == at.line + 1 {
            lines.push("- {choice.kind}: {choice.choice}")
        }
    }
    if lines.len() == 0 -> return None
    Val("Automatic choices:\n{lines.join("\n")}")
}

// What made a generated module, as its hover says it: the call and function
// that made it, each handoff of the `Compiler` value that led there (root
// first), the `Meta` effect it was made under, the dependency consent it
// used, and its stable identity.
lsp_producer_markdown: fn(producer: LSPProducer) -> String Never! {
    ^text: "Generated module `{producer.name}`, made by {producer.made_by}"
    if producer.handoffs.len() > 0 -> text = "{text}, after {producer.handoffs.join(", then ")}"
    text = "{text}."
    if producer.authority == .Val(authority) -> text = "{text} Made under `{authority}`."
    if producer.consent == .Val(consent) {
        text = "{text} Allowed by the root's consent for `{consent}`."
    }
    "{text}\n\nIdentity: `{producer.identity}`"
}

// A keyword under the cursor hovers with the language's own description.
lsp_keyword_hover: fn(view: LSPView, offset: Int) -> String? Never! {
    slot: lsp_keyword_symbol_at(view, offset) ?? return None
    symbol: view.checked.symbols[slot]
    Val(lsp_hover_markdown(symbol.signature, symbol.summary))
}

// The slot in the checked symbols of the language word under the cursor.
lsp_keyword_symbol_at: fn(view: LSPView, offset: Int) -> Int? Never! {
    loop token in view.lexed.tokens {
        if token.span.start > offset -> break
        if !lsp_span_holds(token.span, offset) || token.kind == TOKEN_IDENT -> next
        text: token_text(view.lexed.tables, token)
        loop slot in 0..<view.checked.symbols.len() {
            symbol: view.checked.symbols[slot]
            if symbol.kind == SemSymbolKind.Keyword && symbol.name == text -> return Val(slot)
        }
    }
    None
}

// The declaration under the cursor. A Core function the document calls has
// its declaration in the Core source file the check read; the Core built
// into jet and the ambient `print` have no file, so no location.
lsp_definition_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    if lsp_target_at(at.view, at.offset) == .Val(target) {
        if lsp_location(at.view.checked, target.module_path, target.span) == .Val(location) {
            return lsp_response(id, lsp_location_json(location))
        }
    }
    declared: lsp_declared_at(at.view, at.offset) ?? return lsp_response(id, "null")
    loop file in at.view.checked.declared_files {
        if file.module_name == declared.def.module_path {
            return lsp_response(id, lsp_source_location_json(lsp_path_to_uri(file.path), file.source, declared.def.def_span))
        }
    }
    lsp_response(id, "null")
}

// Every use of the declaration, in this document's check and in each other
// open document's check that read the declaring module's text.
lsp_references_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    if at.view.checked.index == None -> return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "[]")
    declaration: lsp_bool_member(lsp_param(params, "context") ?? Dyn.Null, "includeDeclaration")
    rows: loop placed in lsp_open_occurrences(server, at.view, target, declaration: declaration).placed -> lsp_location_json(LSPLocation{uri: lsp_path_to_uri(placed.path), source: placed.source, span: placed.span})
    lsp_response(id, "[{rows.join(",")}]")
}

// Highlights in this document: the declaration writes, each reference reads.
lsp_document_highlight_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    module_path: at.view.module_path ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "[]")
    ^rows: [String]{}
    loop occurrence in lsp_occurrences(index, target, declaration: true) {
        if occurrence.module_path != module_path -> next
        kind: if occurrence.target == None -> 3 else -> 2
        rows.push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, occurrence.span))},\"kind\":{kind}}}")
    }
    lsp_response(id, "[{rows.join(",")}]")
}

// Linked editing: a local binding's or a parameter's declaration and each use
// of it, all in this document, edited as one. Any other name may be used in
// files the editor's linked ranges cannot reach, so it answers null; rename
// covers it.
lsp_linked_editing_range_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    module_path: at.view.module_path ?? return lsp_response(id, "null")
    target: lsp_target_at(at.view, at.offset) ?? return lsp_response(id, "null")
    def: lsp_definition_at(index, target) ?? return lsp_response(id, "null")
    if def.kind == {
        .Local(_, _) | .Param(_) -> {}
        .Module | .Function(_) | .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) | .Const | .EnumVariant(_) | .Field(_, _) -> {
            return lsp_response(id, "null")
        }
    }
    if def.module_path != module_path -> return lsp_response(id, "null")
    text: at.view.doc.text
    ^rows: [String]{}
    loop occurrence in lsp_occurrences(index, target, declaration: true) {
        if occurrence.module_path != module_path -> return lsp_response(id, "null")
        span: lsp_name_span(text, occurrence.span, def.name)
        // A use not spelled as the name, such as one a template wrote, is
        // no range the editor can mirror.
        if span.end > text.count_bytes() || foundation_byte_text(text.bytes(), span.start, span.end) != def.name {
            return lsp_response(id, "null")
        }
        rows.push(lsp_range_json(lsp_byte_span_to_range(text, span)))
    }
    lsp_response(id, "{{\"ranges\":[{rows.join(",")}]}}")
}

// What a rename may change: a declaration in an open document, so every file
// the rename edits is one the editor holds.
LSPRenameTarget: struct {
    def: SemDef,
    // The name's span under the cursor.
    span: Span,
}

// No declaration is under the cursor; a language word there says so by name.
lsp_rename_nothing: fn(at: LSPAt) -> LSPRPCError Never! {
    if lsp_keyword_symbol_at(at.view, at.offset) == .Val(slot) {
        return LSPRPCError{code: -32803, message: "`{at.view.checked.symbols[slot].name}` is Jet syntax, not a name you can rename"}
    }
    LSPRPCError{code: -32803, message: "no declaration is under the cursor"}
}

lsp_rename_target: fn(server: LSPServer, at: LSPAt) -> LSPRenameTarget LSPRPCError! {
    index: at.view.checked.index ?? return Err(LSPRPCError{code: -32803, message: "the document has not been checked"})
    target: lsp_target_at(at.view, at.offset) ?? return Err(lsp_rename_nothing(at))
    def: lsp_definition_at(index, target) ?? return Err(LSPRPCError{code: -32803, message: "only a declaration in Jet source can be renamed"})
    module_index: lsp_module_index(at.view.checked, def.module_path) ?? return Err(LSPRPCError{code: -32803, message: "`{def.name}` is declared outside the checked modules"})
    if !lsp_path_is_open(server, at.view.checked.modules[module_index].physical_path) {
        return Err(LSPRPCError{code: -32803, message: "open the file that declares `{def.name}` to rename it"})
    }
    token: lsp_ident_token_at(at.view.lexed, at.offset) ?? return Err(LSPRPCError{code: -32803, message: "no name is under the cursor"})
    if token_text(at.view.lexed.tables, token) != def.name {
        return Err(LSPRPCError{code: -32803, message: "no name is under the cursor"})
    }
    Ok(LSPRenameTarget{def: def, span: token.span})
}

lsp_path_is_open: fn(server: LSPServer, path: String) -> Bool Never! {
    if path == "" -> return false
    loop (_, doc) in server.diagnostic_state.docs {
        if lsp_source_paths_equal(doc.path, path) -> return true
    }
    false
}

lsp_prepare_rename_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    if lsp_rename_target(server, at) == {
        .Ok(target) -> lsp_response(id, "{{\"range\":{lsp_range_json(lsp_byte_span_to_range(at.view.doc.text, target.span))},\"placeholder\":{foundation_json_quote(target.def.name)}}}")
        .Err(problem) -> lsp_error_response(id, problem.code, problem.message)
    }
}

// A new name must lex as exactly one identifier, so no keyword passes.
lsp_valid_identifier: fn(name: String) -> Bool Never! {
    lexed: lex(name.bytes())
    if lexed.diagnostics.len() != 0 || lexed.tokens.len() == 0 -> return false
    first: lexed.tokens[0]
    if first.kind != TOKEN_IDENT || first.span.start != 0 || first.span.end != name.count_bytes() {
        return false
    }
    lexed.tokens.len() == 1 || lexed.tokens[1].span.start >= name.count_bytes()
}

// The rename's edits, one file each, bound to the document versions the check
// read, and its semantic operation: the checked identity it renames.
lsp_rename_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    new_name: lsp_text_member(params ?? return lsp_response(id, "null"), "newName") ?? return lsp_error_response(id, -32602, "rename needs a string newName")
    if !lsp_valid_identifier(new_name) {
        return lsp_error_response(id, -32602, "`{new_name}` is not an identifier")
    }
    target: if lsp_rename_target(server, at) == {
        .Ok(found) -> found
        .Err(problem) -> {
            return lsp_error_response(id, problem.code, problem.message)
        }
    }
    index: at.view.checked.index ?? return lsp_response(id, "null")
    edit: if lsp_rename_edit(server, at.view, target.def, new_name) == {
        .Ok(members) -> members
        .Err(problem) -> {
            return lsp_error_response(id, problem.code, problem.message)
        }
    }
    lsp_response(id, "{{{edit},\"semantic_ops\":[{lsp_rename_semantic_op(index, target.def, new_name)}]}}")
}

// The members of the workspace edit that renames `def` to `new_name` at every
// occurrence the open documents' checks found, one file each, bound to the
// document versions the checks read. A program with errors may hold a use the
// check could not resolve, so the rename is refused rather than offered as
// complete; `tolerated` names a code whose errors resolve every name as
// written (a casing error never changes what a name means).
lsp_rename_edit: fn(server: LSPServer, view: LSPView, def: SemDef, new_name: String, tolerated: String{""}) -> String LSPRPCError! {
    occurrences: lsp_open_occurrences(server, view, LSPTarget{module_path: def.module_path, span: def.def_span}, declaration: true, tolerated: tolerated)
    ^errors: occurrences.errors
    loop diagnostic in view.checked.diagnostics {
        if diagnostic.code != tolerated && !lsp_record_is_warning(lsp_diagnostic_record(diagnostic), diagnostic) {
            errors += 1
        }
    }
    if errors > 0 {
        counted: if errors == 1 -> "1 error" else -> "{errors} errors"
        return Err(LSPRPCError{code: -32803, message: "the program has {counted}, so the check may have missed a use of `{def.name}`; fix them, then rename"})
    }
    ^by_uri: [String:[String]]{}
    ^versions: [String:String]{}
    ^order: [String]{}
    loop placed in occurrences.placed {
        source: placed.source
        span: lsp_name_span(source, placed.span, def.name)
        if span.end > source.count_bytes() || foundation_byte_text(source.bytes(), span.start, span.end) != def.name {
            next
        }
        uri: lsp_path_to_uri(placed.path)
        fresh: !by_uri.has_key(uri)
        if fresh {
            // An open document's edits apply only to the version the check
            // read; a file no editor holds is the one on disk.
            ^version: "null"
            loop (_, doc) in server.diagnostic_state.docs {
                if !lsp_source_paths_equal(doc.path, placed.path) -> next
                if doc.text != source {
                    return Err(LSPRPCError{code: -32801, message: "`{placed.path}` changed after the check; rename again"})
                }
                version = "{doc.version}"
            }
            by_uri[uri] = [String]{}
            versions[uri] = version
        }
        by_uri[uri].push("{{\"range\":{lsp_range_json(lsp_byte_span_to_range(source, span))},\"newText\":{foundation_json_quote(new_name)}}}")
        if fresh -> order.push(uri)
    }
    order.sort()
    ^files: [String]{}
    loop uri in order {
        edits: by_uri[uri].join(",")
        files.push(if server.document_changes -> "{{\"textDocument\":{{\"uri\":{foundation_json_quote(uri)},\"version\":{versions[uri]}}},\"edits\":[{edits}]}}" else -> "{foundation_json_quote(uri)}:[{edits}]")
    }
    Ok(if server.document_changes -> "\"documentChanges\":[{files.join(",")}]" else -> "\"changes\":{{{files.join(",")}}}")
}

// The rename as a semantic operation, the shape `jet codemod` receipts record:
// the checked definition it renames, before and after. A local has no
// definition fact, so its operation names no target.
lsp_rename_semantic_op: fn(index: SemIndex, def: SemDef, to: String) -> String Never! {
    ^targets: [String]{}
    loop fact in index.definition_facts {
        if fact.human_identity != def.identity -> next
        targets.push("{{\"stable_id\":{foundation_json_quote(fact.stable_id)},\"before\":{foundation_json_quote(fact.human_identity)},\"after\":{foundation_json_quote(semindex_renamed_identity(fact, to))},\"kind\":{foundation_json_quote(fact.kind)},\"module_path\":{foundation_json_quote(fact.module_path)}}}")
    }
    "{{\"kind\":\"rename\",\"rule_id\":\"lsp.rename\",\"from\":{foundation_json_quote(def.name)},\"to\":{foundation_json_quote(to)},\"targets\":[{targets.join(",")}],\"files\":[]}}"
}

// The call whose argument list holds the cursor: the callee's name token and
// which argument the cursor is in. Brackets nest; strings and comments are
// single tokens, so their commas never count.
LSPActiveCall: struct {
    callee: Token,
    argument: Int,
    // The label the active argument spells (`name: value`), if any.
    label: String?,
}

lsp_active_call: fn(lexed: Lexed, offset: Int) -> LSPActiveCall? Never! {
    tokens: lexed.tokens
    ^end: 0
    loop end < tokens.len() && tokens[end].span.end <= offset -> end += 1
    ^depth: 0
    ^argument: 0
    ^argument_start: end
    ^cursor: end
    loop cursor > 0 {
        cursor -= 1
        kind: tokens[cursor].kind
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            depth += 1
            next
        }
        if kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_LPAREN {
            if depth > 0 {
                depth -= 1
                next
            }
            if kind != TOKEN_LPAREN || cursor == 0 || tokens[cursor - 1].kind != TOKEN_IDENT {
                return None
            }
            if argument == 0 -> argument_start = cursor + 1
            ^label: String?{None}
            if argument_start + 1 < end && tokens[argument_start].kind == TOKEN_IDENT && tokens[argument_start + 1].kind == TOKEN_COLON {
                label = Val(token_text(lexed.tables, tokens[argument_start]))
            }
            return Val(LSPActiveCall{callee: tokens[cursor - 1], argument: argument, label: label})
        }
        if kind == TOKEN_COMMA && depth == 0 {
            if argument == 0 -> argument_start = cursor + 1
            argument += 1
        }
    }
    None
}

lsp_signature_help_response: fn(server: LSPServer, params: Dyn?, id: Dyn) -> String {
    at: lsp_at(server, params) ?? return lsp_response(id, "null")
    call: lsp_active_call(at.view.lexed, at.offset) ?? return lsp_response(id, "null")
    index: at.view.checked.index ?? return lsp_response(id, "null")
    ^def: SemDef?{None}
    ^label: ""
    ^documentation: ""
    if lsp_target_at(at.view, call.callee.span.start) == .Val(target) {
        found: lsp_definition_at(index, target) ?? return lsp_response(id, "null")
        label = found.qualified_name
        if lsp_symbol_for(at.view.checked.symbols, found) == .Val(symbol) {
            label = symbol.signature
            documentation = symbol.summary
        }
        def = Val(found)
    }
    // A call the index holds no definition for answers from its declaration.
    if def == None {
        declared: lsp_declared_at(at.view, call.callee.span.start) ?? return lsp_response(id, "null")
        label = declared.symbol.signature
        documentation = declared.symbol.summary
        def = Val(declared.def)
    }
    shown: def ?? return lsp_response(id, "null")
    callable: if shown.kind == {
        .Function(callable) -> callable
        .Module | .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) | .Const | .EnumVariant(_) | .Field(_, _) | .Local(_, _) | .Param(_) -> {
            return lsp_response(id, "null")
        }
    }
    ^rows: [String]{}
    ^active: call.argument
    loop (position, param) in callable.params {
        rest: if param.variadic -> "..." else -> ""
        param_label: "{param.name}: {rest}{type_name(param.ty)}"
        rows.push("{{\"label\":{foundation_json_quote(param_label)}}}")
        if call.label == .Val(name) {
            if param.label == name || param.name == name -> active = position
        }
        // Every argument from a variadic parameter on is that parameter's.
        if param.variadic && active > position -> active = position
    }
    docs: if documentation == "" -> "" else -> ",\"documentation\":{{\"kind\":\"markdown\",\"value\":{foundation_json_quote(documentation)}}}"
    lsp_response(id, "{{\"signatures\":[{{\"label\":{foundation_json_quote(label)}{docs},\"parameters\":[{rows.join(",")}]}}],\"activeSignature\":0,\"activeParameter\":{active}}}")
}
