fn extract_insert_point(db: SymbolDB, src: String, path: String, selected: Span) -> USize? {
    if db.nodes.iter().find(fn(node) { node.module_path == path && node.class == "expr" && node.slot == "initializer" && node.span.start == selected.start && node.span.end == selected.end }) == .Val(initializer) {
        if binding_for_initializer(db, src, path, initializer) == .Val(binding) -> return Val(line_start(src, binding.def_span.start))
