fn definition_for_anchor(db: SymbolDB, anchor: DefinitionAnchor) -> SymDef? {
    db.defs.iter().find(fn(definition) {
        anchor.semantic_identity.is_some_and(fn(identity) { identity == definition.identity }) ||
            (definition.module_path == anchor.module_path && definition.def_span.start == anchor.def_span.start && definition.def_span.end == anchor.def_span.end)
    })
}
// Rust: Source/LSP/Features.rs:3346
fn same_anchor(left: DefinitionAnchor, right: DefinitionAnchor) -> Bool {
    if (left.semantic_identity, right.semantic_identity) == {
        (.Val(left_id), .Val(right_id)) -> left_id == right_id,
        else -> left.module_path == right.module_path && left.def_span.start == right.def_span.start && left.def_span.end == right.def_span.end
    }
}
