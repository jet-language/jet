fn is_trivial_extract(tokens: [Token], span: Span) -> Bool {
    significant :: tokens.iter().filter(fn(token) {
        span.start <= token.span.start && token.span.end <= span.end && token.span.start < token.span.end &&
            !(if token.kind == { .Eof | .LParen | .RParen -> true, else -> false })
    }).collect()
    significant.len() == 1 && (if significant[0].kind == {
        .Ident(_) | .Int(_, _) | .Float(_) | .Char(_) | .KwTrue | .KwFalse | .Str(_) -> true,
        else -> false
    })
}
// Rust: Source/LSP/Features.rs:3394
fn is_total_pure_expr(db: SymbolDB, tokens: [Token], path: String, span: Span) -> Bool {
    enclosed :: tokens.iter().filter(fn(token) { span.start <= token.span.start && token.span.end <= span.end && token.span.start < token.span.end && token.kind != .Eof }).collect()
    if enclosed.is_empty() -> return false
    loop pair in enclosed.windows(2) {
        if pair[0].kind.is_ident() && pair[1].kind == .LParen -> return false
    }
    has_comparison := false
    loop token in enclosed {
        safe :: if token.kind == {
            .Ident(_) | .Int(_, _) | .Float(_) | .Char(_) | .KwTrue | .KwFalse | .AndAnd | .OrOr | .Bang | .LParen | .RParen -> true,
            .EqEq | .NotEq -> { has_comparison = true; true },
            .Str(parts) -> parts.iter().all(fn(part) { if part == { .Lit(_) -> true, else -> false } }),
            else -> false
        }
        if !safe -> return false
    }
    if has_comparison { expr_comparison_operands_are_scalar(db, tokens, path, span) } else { true }
}
// Rust: Source/LSP/Features.rs:3450
fn expr_comparison_operands_are_scalar(db: SymbolDB, tokens: [Token], path: String, span: Span) -> Bool {
    enclosed :: tokens.iter().filter(fn(token) { span.start <= token.span.start && token.span.end <= span.end && token.span.start < token.span.end }).collect()
    has_bool_op :: enclosed.iter().any(fn(token) { if token.kind == { .AndAnd | .OrOr | .Bang -> true, else -> false } })
    leaf := String?{None}
    loop token in enclosed {
        if token.kind == {
            .KwTrue | .KwFalse -> { if !agree_scalar_leaf(&leaf, "Bool") -> return false }
            .Int(_, _) -> { if has_bool_op || !agree_scalar_leaf(&leaf, "Int") -> return false }
            .Float(_) -> { if has_bool_op || !agree_scalar_leaf(&leaf, "Float") -> return false }
            .Char(_) -> { if has_bool_op || !agree_scalar_leaf(&leaf, "Char") -> return false }
            .Ident(_) -> {
                name :: resolved_type_name(db, path, token.span) ?? return false
                if !is_scalar_name(name) || (has_bool_op && name != "Bool") || !agree_scalar_leaf(&leaf, name) -> return false
            }
            .AndAnd | .OrOr | .Bang | .EqEq | .NotEq | .LParen | .RParen -> {}
            else -> return false
        }
    }
    leaf.is_some_and(is_scalar_name)
}
// Rust: Source/LSP/Features.rs:3517
fn agree_scalar_leaf(leaf: &String?, name: String) -> Bool {
    if leaf == {
        .Val(existing) -> existing == name,
        .None -> { leaf = Val(name); true }
    }
}
// Rust: Source/LSP/Features.rs:3527
fn resolved_type_name(db: SymbolDB, path: String, span: Span) -> String? {
    reference :: db.refs.iter().find(fn(reference) { reference.module_path == path && reference.span.start == span.start && reference.span.end == span.end }) ?? return None
    target :: reference.target ?? return None
    definition :: definition_for_anchor(db, target) ?? return None
    if definition.kind == { .Param(ty) -> Val(ty.name()), .Local(_, .Val(ty)) -> Val(ty.name()), else -> None }
}
// Rust: Source/LSP/Features.rs:3542
fn infer_total_pure_return_type(db: SymbolDB, tokens: [Token], path: String, span: Span) -> String? {
    saw_bool_op := false
    saw_comparison := false
    literal := String?{None}
    from_ident := String?{None}
    loop token in tokens.iter().filter(fn(token) { span.start <= token.span.start && token.span.end <= span.end && token.span.start < token.span.end && token.kind != .Eof }) {
        if token.kind == {
            .AndAnd | .OrOr | .Bang | .KwTrue | .KwFalse -> { saw_bool_op = true }
            .EqEq | .NotEq -> { saw_comparison = true }
            .Int(_, _) -> {
                if literal.is_some_and(fn(existing) { existing != "Int" }) -> return None
                literal = Val("Int")
            }
            .Float(_) -> {
                if literal.is_some_and(fn(existing) { existing != "Float" }) -> return None
                literal = Val("Float")
            }
            .Char(_) -> {
                if literal.is_some_and(fn(existing) { existing != "Char" }) -> return None
                literal = Val("Char")
            }
            .Ident(_) -> {
                name :: resolved_type_name(db, path, token.span) ?? return None
                if !is_scalar_name(name) -> return None
                if from_ident == {
                    .Val(existing) -> { if existing != name && !saw_bool_op && !saw_comparison -> return None }
                    .None -> { from_ident = Val(name) }
                }
            }
            .LParen | .RParen -> {}
            else -> return None
        }
    }
    if saw_bool_op || saw_comparison -> return Val("Bool")
    if literal == .Val(name) -> return Val(name)
    from_ident.filter(is_scalar_name)
}
