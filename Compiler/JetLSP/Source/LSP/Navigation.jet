fn source_symbol_is_exported(symbol: jet_semindex.SemanticSymbol, sources: [String: String]) -> Bool {
    span :: symbol.span ?? return false
    source :: sources.get(symbol.module_path) ?? return false
    start :: line_start(source, span.start)
