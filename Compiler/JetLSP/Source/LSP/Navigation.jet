pub fn is_live_teaching_semantic_word(name: String) -> Bool {
    [Syntax.METHOD_VIEW, Syntax.FOREIGN_PRIVATE, Syntax.FOREIGN_UNSAFE, Syntax.FOREIGN_NAMESPACE,
     Syntax.FOREIGN_OWNED, Syntax.FOREIGN_SANITIZER, Syntax.FOREIGN_VEC, Syntax.FOREIGN_DICT,
     Syntax.FOREIGN_EPRINTLN, Syntax.FOREIGN_OPEN, Syntax.FOREIGN_GETENV, Syntax.FOREIGN_OS,
     Syntax.FOREIGN_ASYNC, Syntax.FOREIGN_AWAIT, Syntax.FOREIGN_MUTEX, Syntax.FOREIGN_LOCK].contains(name)
}
// Rust: Source/LSP/Features.rs:4010
pub fn encode_semantic_tokens_with_arithmetic(tokens: [Token], src: String, arithmetic: [jet_semindex.ArithmeticOperationFact]) -> [U32] {
    encode_semantic_tokens_where(tokens, src, fn(tok) { true }, arithmetic)
}
// Rust: Source/LSP/Features.rs:4018
pub fn encode_semantic_tokens_in_span_with_arithmetic(tokens: [Token], src: String, span: Span, arithmetic: [jet_semindex.ArithmeticOperationFact]) -> [U32] {
    encode_semantic_tokens_where(tokens, src, fn(tok) { tok.span.start >= span.start && tok.span.start < span.end }, arithmetic)
}
// Rust: Source/LSP/Features.rs:4032
fn encode_semantic_tokens_where(tokens: [Token], src: String, include: fn(Token) -> Bool, arithmetic: [jet_semindex.ArithmeticOperationFact]) -> [U32] {
    data := [U32]{}
    prev_line := U32{0}
    prev_start := U32{0}
    loop (idx, tok) in tokens.iter().enumerate() {
        if tok.kind == .Eof -> break
        if !include(tok) -> continue
        (tok_type, base_mods) :: semantic_token_type_for(tokens, idx, src) ?? continue
        tok_mods :: base_mods | arithmetic_modifier(tok.span, arithmetic)
        lsp_start :: byte_offset_to_lsp(src, tok.span.start)
        line :: lsp_start.line
        start :: lsp_start.character
        text :: src.get(tok.span.start..<tok.span.end.min(src.len())) ?? ""
        first_line_text :: text.split('\n').next() ?? text
        length :: first_line_text.encode_utf16().count() as U32
        if length == 0 -> continue
        delta_line :: line - prev_line
        delta_start :: if delta_line == 0 { start - prev_start } else { start }
        &data.push(delta_line)
        &data.push(delta_start)
        &data.push(length)
        &data.push(tok_type)
        &data.push(tok_mods)
        prev_line = line
        prev_start = start
    }
    ^data
}
// Rust: Source/LSP/Features.rs:4088
fn arithmetic_modifier(token: Span, arithmetic: [jet_semindex.ArithmeticOperationFact]) -> U32 {
    arithmetic.iter().filter(fn(fact) { token.start < fact.operation_span.end && fact.operation_span.start < token.end }).min_by_key(fn(fact) {
        fact.operation_span.end.saturating_sub(fact.operation_span.start)
    }).map_or(0, fn(fact) {
        if fact.policy == { "Checked" -> sm.ARITHMETIC_CHECKED, "Wrapping" -> sm.ARITHMETIC_WRAPPING, "Saturating" -> sm.ARITHMETIC_SATURATING, else -> 0 }
    })
}
// Rust: Source/LSP/Features.rs:4109
pub fn format_inlay_hints(hints: [jet_semindex.InlayHint], src: String) -> String {
    items := ""
    loop (i, h) in hints.iter().enumerate() {
        if i > 0 -> &items.push(',')
        pos :: byte_offset_to_lsp(src, h.span.end)
        &items.push_str("{\"position\":{\"line\":${pos.line},\"character\":${pos.character}},\"label\":\"${json_escape(h.label)}\",\"kind\":1}")
    }
    "[${items}]"
}

