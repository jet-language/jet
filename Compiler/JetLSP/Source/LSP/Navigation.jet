}
// Rust: Source/LSP/Features.rs:3258
fn extractable_expr(db: SymbolDB, src: String, path: String, selected: Span) -> Span? {
    if exact_expr(db, path, selected).is_some() -> return Val(selected)
    text :: src.get(selected.start..<selected.end) ?? return None
    start_ws :: text.len() - text.trim_start().len()
    end_ws :: text.len() - text.trim_end().len()
    core := text.trim() // #4303
    if core.len() < 2 || !core.starts_with("(") || !core.ends_with(")") -> return None
    inner :: trim_span(src, Span.new(selected.start + start_ws + 1, selected.end - end_ws - 1)) ?? return None
    exact_expr(db, path, inner).map(fn(node) { selected })
