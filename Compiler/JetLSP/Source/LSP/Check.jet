// The check the server reads. Building a compile request takes the host's
// authorized source snapshot and Core sources, so the host supplies the
// checker (`jet self lsp` checks through the CLI's compile path) and the
// server reads only its result: diagnostics, the checked modules, and the
// semantic index over them.
use {
    jet_foundation.[Diagnostic, DiagnosticFixApplicability, DiagnosticFixSafety, TextEdit]
    jet_driver.[JetDriverDocModule]
    jet_semindex.[SemIndex, SemSymbol]
}

// An open document's unsaved text, checked in place of its file.
LSPOverlay: struct {
    path: String
    source: String
}

// One check of an entry with the open documents overlaid. `index` and
// `symbols` are present only when the check reached checked facts; `modules`
// are the checked user modules (path, source, items) in load order.
// `producer` is what made the entry, when it is a module the last `jet build`
// of its package generated. `choices` are the automatic choices the checked
// modules record, as `jet inspect choices` lists them.
LSPChecked: struct {
    diagnostics: [Diagnostic]
    modules: [JetDriverDocModule]
    index: SemIndex?
    symbols: [SemSymbol]
    producer: LSPProducer?{None}
    choices: [LSPChoice]{[LSPChoice]{}}
}

// What made a generated module, as the build that made it recorded it
// (`.jet/build/receipt.json`, the plan's `generated` rows): its name, its
// stable identity, the call and function that made it (`made_by`, None for a
// `b.generate` module), the handoffs of the `Compiler` value that led there,
// root first, the `Meta` effect it was made under and the dependency whose
// consent it used.
LSPProducer: struct {
    name: String
    identity: String
    made_by: String?
    handoffs: [String]
    authority: String?
    consent: String?
}

// An automatic choice the compiler made in the checked module at
// `module_path`, at its 1-based `line`: its kind and what was chosen with
// its reason.
LSPChoice: struct {
    module_path: String
    line: Int
    kind: String
    choice: String
}

// A compile reads sources and may run comptime code and build programs, and
// comptime code may reach the network and inline assembly.
LSPChecker: trait {
    check: fn(self, entry: String, overlays: [LSPOverlay]) -[FS, Env, Exec, IO, Time, Net, FFI.Asm]> LSPChecked
}

// A quick fix a diagnostic offers: its primary edit, then each alternative.
// `edits` are the primary fix's other edits, applied with it.
LSPFix: struct {
    title: String
    edit: TextEdit
    applicability: DiagnosticFixApplicability
    safety: DiagnosticFixSafety
    edits: [TextEdit]{[TextEdit]{}}
}

// A fix whose edits reach another file than the diagnostic's own, or that
// sema left pending, is no code action: an action edits the one document.
lsp_fixes_from_diagnostics: fn(diagnostics: &&[Diagnostic]) -> [LSPFix] Never! {
    fixes := [LSPFix]{}
    loop diagnostic in diagnostics.move() {
        applicability: diagnostic.applicability ?? next
        safety: diagnostic.safety ?? next
        if diagnostic.fix_calls == None && lsp_fix_in_document(diagnostic) {
            if diagnostic.edit.move() == .Val(edit) {
                own := [TextEdit]{}
                loop other in diagnostic.fix_edits.move() -> own.push(lsp_fix_unnamed(other.move()))
                fixes.push(LSPFix{title: diagnostic.fix, edit: lsp_fix_unnamed(edit.move()), applicability: applicability, safety: safety, edits: own.move()})
            }
        }
        if diagnostic.structured == .Val(structured) {
            if structured == .SuggestedEdits(alternatives) {
                loop edit in alternatives -> fixes.push(LSPFix{title: diagnostic.fix, edit: edit, applicability: applicability, safety: safety})
            }
        }
    }
    fixes
}

// Whether every edit of the diagnostic's fix is of its own file.
lsp_fix_in_document: fn(diagnostic: Diagnostic) -> Bool Never! {
    if diagnostic.edit == .Val(edit) {
        if !lsp_fix_names_origin(diagnostic, edit) -> return false
    }
    loop other in diagnostic.fix_edits {
        if !lsp_fix_names_origin(diagnostic, other) -> return false
    }
    true
}

lsp_fix_names_origin: fn(diagnostic: Diagnostic, edit: TextEdit) -> Bool Never! {
    named: edit.path ?? return true
    origin: diagnostic.origin ?? return false
    named == origin.path
}

// `edit` as an edit of the document, without the path it names.
lsp_fix_unnamed: fn(edit: &&TextEdit) -> TextEdit Never! {
    TextEdit{span: edit.span, new_text: edit.new_text.move()}
}

// The checked module at `path` (a file path), when exactly one matches.
lsp_checked_module_at: fn(checked: LSPChecked, path: String) -> Int? Never! {
    found := Int?{None}
    loop (index, module_ref) in checked.modules {
        if module_ref.physical_path != path && module_ref.path != path -> next
        if found != None -> return None
        found = Val(index)
    }
    found
}
