// Consumer-neutral symbol facts. Index, editor completion and REPL menus
// consume these same canonical records.
use jet_foundation.[Type]

SemanticSymbolKind: enum {
    Module
    Function
    Type
    Member
    Constant
    Local
    Parameter
    Keyword
    Command
}

SemanticProvenance: enum {
    Source(module_path: String)
    Builtin(module_name: String)
    CommandRegistry
    Session
}

SemanticLexicalScope: struct {
    identity: String
    structural_parent: Int
    structural_slot: String
    span: SourceSpan
    depth: Int
    declaration_offset: Int
}

SemanticVisibilityAnchor: struct {
    module_path: String
    offset: Int?
    session_top_level: Bool
}

SemanticSymbol: struct {
    identity: String
    name: String
    qualified_name: String
    owner: String?
    module_path: String
    kind: SemanticSymbolKind
    signature: String
    summary: String
    examples: [String]
    provenance: SemanticProvenance
    span: SourceSpan?
    lexical_scope: SemanticLexicalScope?
}
