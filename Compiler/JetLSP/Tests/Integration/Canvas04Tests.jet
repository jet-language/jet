// Rust: tests/canvas.rs:6586
#Test("canvas_event_dispatcher_edits_are_checked_and_stale_or_invalid_edits_keep_source") {
    path :: write_fixture("event_dispatcher_edits", CANVAS_EVENT_DISPATCHER_FIXTURE)
    before :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(before)
    invalid_source :: json_quote(before.replace("event.new<Int>()", "event.new<Int>(\"bad\")"))
    invalid :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":{json_quote(revision)},\"source\":{invalid_source}}}"
    invalid_out :: Canvas.apply_transaction_json(path, invalid).unwrap_err()
    assert(invalid_out.contains("\"ok\":false"), invalid_out)
    assert_eq(fs.read_to_string(path).unwrap(), before)
    stale_source :: json_quote(before.replace("event.new<Int>()", "event.new<String>()"))
    stale :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"sha256-stale\",\"source\":{stale_source}}}"
    stale_out :: Canvas.apply_transaction_json(path, stale).unwrap_err()
    assert(stale_out.contains("\"kind\":\"conflict\""), stale_out)
    assert_eq(fs.read_to_string(path).unwrap(), before)
    changed_source :: before.replace("event.new<Int>()", "event.new<String>()").replace("clicked.emit(1)", "clicked.emit(\"one\")")
    valid :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":{json_quote(revision)},\"source\":{json_quote(changed_source)}}}"
    valid_out :: Canvas.apply_transaction_json(path, valid).expect("checked event edit")
    assert(valid_out.contains("\"changed\":true"), valid_out)
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("event.new<String>()"), after)
    assert_eq(Formatter.format_source(after).unwrap(), after)
    graph :: Canvas.graph_json_for_file(path).expect("reprojected event graph")
    assert(graph.contains("\"receiver_type\":\"Event<String>\""), graph)
}

// Rust: tests/canvas.rs:6628
#Test("canvas_projects_trait_impl_authoring_and_writes_impl_stub") {
    path :: write_fixture("trait_interface", CANVAS_TRAIT_INTERFACE_FIXTURE)
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    assert(!graph.contains("\"kind\":\"trait_impl\",\"type\":\"Badge\",\"trait\":\"Equatable\""), "compiler-generated trait impls must stay out of Canvas authoring facts: {graph}")
    loop field in ["\"interfaces\"", "\"kind\":\"trait_interface\"", "\"trait\":\"Drawable\"", "\"scope\":\"\"", "\"associated_types\":[]", "\"signature\":\"fn render(self) -[IO]> String\"", "\"required\":true", "\"default\":false", "\"pure\":false", "\"effects\":[\"IO\"]", "\"required\":false", "\"default\":true", "\"create_trait_impl\""] -> assert(graph.contains(field), "trait graph missing {field}: {graph}")
    src :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(src)
    edit :: "{{\"schema_version\":1,\"op\":\"create_trait_impl\",\"revision\":\"{revision}\",\"type_name\":\"Badge\",\"trait_name\":\"Drawable\"}}"
    out :: Canvas.apply_transaction_json(path, edit).expect("create trait impl")
    assert(out.contains("\"changed\":true"), out)
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("impl Badge.Drawable"), after)
    assert(after.contains("fn render(self) -> String"), after)
    assert(after.contains("return \"canvas\""), after)
    assert_eq(after.matches("fn label(self) -> String").count(), 1, after)
    graph :: Canvas.graph_json_for_file(path).expect("trait impl graph")
    assert(graph.contains("\"kind\":\"trait_impl\""), graph)
    assert(graph.contains("\"diagnostic_affordance\":\"surface_missing_trait_members\""), graph)
    before_stale :: after.clone()
    stale :: "{{\"schema_version\":1,\"op\":\"create_trait_impl\",\"revision\":\"sha256-stale\",\"type_name\":\"Badge\",\"trait_name\":\"Drawable\"}}"
    err :: Canvas.apply_transaction_json(path, stale).unwrap_err()
    assert(err.contains("\"kind\":\"conflict\""), err)
    assert_eq(fs.read_to_string(path).unwrap(), before_stale)
}

