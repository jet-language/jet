#Test("canvas_unsupported_and_invalid_actions_return_canvas_errors_without_rustc") {
    path :: write_fixture("unsupported_diagnostics", CANVAS_FIXTURE)
    before :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(before)
    bad_schema :: "{{\"schema_version\":99,\"op\":\"noop\",\"revision\":\"{revision}\"}}"
    err :: Canvas.apply_transaction_json(path, bad_schema).unwrap_err()
    assert(err.contains("\"protocol\":\"jet.canvas.edit\""), err)
    assert(err.contains("\"kind\":\"schema\""), err)
    assert(!err.contains("rustc"), err)
    bad_query :: "{{\"schema_version\":1,\"op\":\"teleport_node\",\"revision\":\"{revision}\"}}"
    err :: Canvas.query_json_for_file(path, bad_query).unwrap_err()
    assert(err.contains("\"protocol\":\"jet.canvas.query\""), err)
    assert(err.contains("\"kind\":\"unsupported\""), err)
    assert(!err.contains("rustc"), err)
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    inline_id :: field_before(graph, "\"source\":\"total > 10\"", "inline_expr_id")
    invalid_expr :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{inline_id}\",\"new_expr\":\"missing_name\"}}"
    err :: Canvas.apply_transaction_json(path, invalid_expr).unwrap_err()
    assert(err.contains("\"protocol\":\"jet.canvas.edit\""), err)
    assert(err.contains("\"kind\":\"diagnostic\""), err)
    assert(err.contains("Error [E0107]"), err)
    assert(!err.contains("rustc"), err)
    assert_eq(fs.read_to_string(path).unwrap(), before)
}

// Rust: tests/canvas.rs:6918
#Test("canvas_reconstructs_checked_output_callable_from_semindex") {
    path :: write_fixture("output_callable", "APP :: Output.Executable{{ name: \"demo\", entry: launch }}\n\nfn launch() {{ print(\"ok\") }}\n")
    graph :: Canvas.graph_json_for_file(path).expect("Output Canvas graph")
    identity :: "\"identity\":\"{path.parent().unwrap().display()}::{path.display()}::launch\""
    loop field in ["\"outputs\":[{{", "\"binding\":\"app\"", "\"kind\":\"Executable\"", "\"fact_source\":\"semindex_resolved_output\"", "\"effects\":[\"IO\"]"] -> assert(graph.contains(field), "Canvas Output fact missing {field}: {graph}")
    assert(graph.contains(identity), "Canvas Output fact missing {identity}: {graph}")
}
