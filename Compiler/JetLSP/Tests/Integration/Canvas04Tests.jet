    graph :: Canvas.graph_json_for_file(path).expect("shield graph")
    loop field in ["\"kind\":\"shield\"", "\"title\":\"#Shield\"", "\"source_span\":{{\"start\":", "\"title\":\"print\"", "\"title\":\"\\\"before\\\"\""] -> assert(graph.contains(field), "shield graph missing {field}: {graph}")
