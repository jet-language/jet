#Test("canvas_debug_session_projects_runtime_overlay_to_source_spans") {
    path :: write_fixture("debug_overlay", CANVAS_DEBUG_FIXTURE)
    src :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(src)
    print_start :: src.find("print").expect("print call")
    req :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"commands\":[\"c\"],\"breakpoint_spans\":[\"{print_start}:{print_start + \"print\".len()}\"],\"watches\":[\"total\"]}}"
    debug_path :: path.clone()
    out :: thread.Builder.new().stack_size(2 * 1024 * 1024)
        .spawn(() -> Canvas.debug_session_json_for_file(debug_path, req))
        .expect("spawn 2 MiB Canvas debug embedder").join()
        .expect("Canvas debug embedder must not overflow").expect("debug session")
    loop field in ["\"protocol\":\"jet.canvas.debug\"", "\"ok\":true", "\"persistence\":\"local-source-span\"", "\"state\":\"finished\"", "\"debug_overlay\":\"finished\"", "\"runtime_state\":\"finished\"", "\"active_line\":null", "\"active_span\":{{\"start\":0,\"end\":0}}", "\"active_graph_id\":\"\"", "\"active_node_id\":\"\"", "\"active_wire_id\":\"\"", "\"breakpoints\"", "\"locals\"", "\"watches\"", "\"name\":\"total\"", "\"type\":\"Int\"", "\"value\":\"1\"", "\"call_stack\"", "\"trace\""] -> assert(out.contains(field), "debug overlay missing {field}: {out}")
    assert(out.matches("program finished").count() >= 2, "trace must retain program output and the debugger completion marker: {out}")
    assert_eq(fs.read_to_string(path).unwrap(), src)
}

