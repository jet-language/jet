// Rust: tests/canvas.rs:6760
#Test("canvas_hardening_projection_suite_covers_blueprint_backlog_constructs") {
    cases :: [
        ("control", CANVAS_COVERAGE_FIXTURE, ["\"kind\":\"loop\"", "\"kind\":\"branch\"", "\"kind\":\"function\"", "\"kind\":\"assign\"", "\"layout_hints\":{{\"algorithm\":\"source-order-v1\""]),
        ("data", CANVAS_DATA_FIXTURE, ["\"kind\":\"expr\"", "\"kind\":\"variant\"", "\"title\":\"construct\"", "\"type\":\"Int\"", "\"source_span\""]),
        ("rails", CANVAS_RAILS_FIXTURE, ["\"wire_kind\":\"fallible\"", "\"kind\":\"unsafe\"", "\"proof\"", "\"debug_overlay\":\"idle\"", "\"source\":\"front-end facts\""]),
        ("task", CANVAS_TASK_RAIL_FIXTURE, ["\"async\"", "\"kind\":\"structured_task_scope\"", "\"source\":\"task.group\"", "\"pins\"", "\"wires\""])
    ]
    loop (tag, src, required) in cases {
        path :: write_fixture("hardening_{tag}", src)
        first :: Canvas.graph_json_for_file(path).expect("first projection")
        second :: Canvas.graph_json_for_file(path).expect("second projection")
        assert_eq(first, second, "{tag} projection/layout drifted")
        assert(count_occurrences(first, "\"graph_id\":\"fn:") >= 1, "{tag} graph should expose at least one function graph: {first}")
        assert(count_occurrences(first, "\"node_id\":\"fn:") >= 2, "{tag} graph should expose multiple source-backed nodes: {first}")
        assert(count_occurrences(first, "\"source_span\":{{\"start\":") >= 2, "{tag} graph should expose source spans for nodes/pins/inline facts: {first}")
        assert(!first.contains("\"kind\":\"source\""), "{tag} supported Canvas construct fell back to opaque source node: {first}")
        loop field in required -> assert(first.contains(field), "{tag} missing {field}: {first}")
    }
}

// Rust: tests/canvas.rs:6836
#Test("canvas_source_span_mapping_survives_source_edits_without_drift") {
    path :: write_fixture("span_drift", CANVAS_FIXTURE)
    before :: fs.read_to_string(path).unwrap()
    old_total :: before.find("total := square").expect("old total span")
    old_revision :: Canvas.source_revision(before)
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    summarize_graph_id :: field_before(graph, "\"title\":\"summarize\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{old_revision}\",\"graph_id\":\"{summarize_graph_id}\",\"callee\":\"print\",\"args\":[\"\\\"shift\\\"\"]}}"
    Canvas.apply_transaction_json(path, insert).expect("insert before span drift check")
    after :: fs.read_to_string(path).unwrap()
    new_total :: after.find("total := square").expect("new total span")
    assert_ne(old_total, new_total, "insert should shift later source spans")
    new_revision :: Canvas.source_revision(after)
    query :: "{{\"schema_version\":1,\"op\":\"source_to_graph\",\"revision\":\"{new_revision}\",\"start\":{new_total},\"end\":{new_total + \"total\".len()}}}"
    mapped :: Canvas.query_json_for_file(path, query).expect("source-to-graph after edit")
    assert(mapped.contains("\"op\":\"source_to_graph\""), mapped)
    assert(mapped.contains("\"title\":\"total\""), mapped)
    assert(mapped.contains(":binding"), mapped)
    stale :: "{{\"schema_version\":1,\"op\":\"source_to_graph\",\"revision\":\"{old_revision}\",\"start\":{old_total},\"end\":{old_total + \"total\".len()}}}"
    err :: Canvas.query_json_for_file(path, stale).unwrap_err()
    assert(err.contains("\"kind\":\"conflict\""), err)
}

