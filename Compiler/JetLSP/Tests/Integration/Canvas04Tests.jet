    dir :: temp_dir("project_source_id_unprojected")
    fs.create_dir_all(dir.join("packages/app")).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: [\"./packages/app\"]\n}}\n").unwrap()
    fs.write(dir.join("packages/app/package.jet"), "name: \"app\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n").unwrap()
    entry :: dir.join("packages/app/main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    fs.write(dir.join("stray.jet"), "fn stray() -> Int {{\n    return 1\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    assert(!project.contains("\"path\":\"stray.jet\""), project)
    err :: Canvas.graph_json_for_entry_source(entry, "stray.jet").expect_err("existing but unprojected file should be rejected")
    assert(err.contains("\"kind\":\"not_found\""), err)
}

// Rust: tests/canvas.rs:5565
#Test("canvas_project_source_id_rejects_symlink_alias") {
    if core.sys.target.selected_family() == "unix" {
        dir :: temp_dir("project_source_id_symlink")
        fs.write(dir.join("package.jet"), "name: \"source_id_symlink\"\nversion: \"0.1.0\"\n").unwrap()
        entry :: dir.join("main.jet")
        fs.write(entry, "fn run() {{\n    print(\"entry\")\n}}\n").unwrap()
        real :: dir.join("real.jet")
        real_source :: "fn leaked() {{\n    print(\"must not be selected through a link\")\n}}\n"
        fs.write(real, real_source).unwrap()
        alias :: dir.join("alias.jet")
        std.os.unix.fs.symlink(real, alias).unwrap()
        assert(Canvas.project_path_for_source_id(entry, "alias.jet") == none, "Canvas source ids must not select symlink aliases")
        revision :: Canvas.source_revision(real_source)
        request :: "{{\"schema_version\":1,\"op\":\"noop\",\"source_id\":\"alias.jet\",\"revision\":\"{revision}\"}}"
        error :: Canvas.apply_transaction_json(entry, request).expect_err("Canvas must not read a symlink alias as source truth")
        assert(error.contains("\"kind\":\"not_found\""), error)
    }
}

// Rust: tests/canvas.rs:5598
#Test("canvas_project_source_id_rejects_hardlink_alias_without_reading") {
    if core.sys.target.selected_family() == "unix" {
        dir :: temp_dir("project_source_id_hardlink")
        outside :: dir.with_file_name("jet_canvas_project_source_id_hardlink_outside_{process.id()}")
        _ :: fs.remove_dir_all(outside)
        fs.create_dir_all(outside).unwrap()
        fs.write(dir.join("package.jet"), "name: \"source_id_hardlink\"\nversion: \"0.1.0\"\n").unwrap()
        entry :: dir.join("main.jet")
        fs.write(entry, "fn run() {{\n    print(\"entry\")\n}}\n").unwrap()
        helper :: dir.join("helper.jet")
        fs.write(helper, "fn helper() -> Int {{\n    return 7\n}}\n").unwrap()
        outside_source :: outside.join("outside.jet")
        outside_source_text :: "fn leaked() {{\n    print(\"hardlink source must not be returned\")\n}}\n"
        fs.write(outside_source, outside_source_text).unwrap()
        alias :: dir.join("leaked.jet")
        fs.hard_link(outside_source, alias).unwrap()
        project :: Canvas.project_json_for_entry(entry)
        assert(project.contains("\"path\":\"helper.jet\""), project)
        assert(!project.contains("\"path\":\"leaked.jet\""), project)
        graph_error :: Canvas.graph_json_for_entry_source(entry, "leaked.jet").expect_err("Canvas must reject a hardlink source before reading bytes")
        assert(!graph_error.contains("hardlink source must not be returned"), graph_error)
        revision :: Canvas.source_revision(outside_source_text)
        query :: "{{\"schema_version\":1,\"op\":\"find\",\"source_id\":\"leaked.jet\",\"revision\":\"{revision}\",\"query\":\"leaked\"}}"
        query_error :: Canvas.query_json_for_entry(entry, query).expect_err("Canvas queries must reject a hardlink source before reading bytes")
        assert(!query_error.contains("hardlink source must not be returned"), query_error)
        fs.remove_dir_all(dir).unwrap()
        fs.remove_dir_all(outside).unwrap()
    }
}

// Rust: tests/canvas.rs:5645
#Test("canvas_rename_receipt_rejects_symlinked_metadata_directory") {
    if core.sys.target.selected_family() == "unix" {
        dir :: temp_dir("rename_receipt_symlink")
        path :: dir.join("main.jet")
        fs.write(path, CANVAS_FIXTURE).unwrap()
        outside :: dir.join("outside")
        fs.create_dir_all(outside).unwrap()
        std.os.unix.fs.symlink(outside, dir.join(".jet")).unwrap()
        source :: fs.read_to_string(path).unwrap()
        revision :: Canvas.source_revision(source)
        request :: "{{\"schema_version\":1,\"op\":\"rename_binding\",\"revision\":\"{revision}\",\"from\":\"total\",\"to\":\"score\"}}"
        error :: Canvas.apply_transaction_json(path, request).expect_err("Canvas must not write rename receipts through a symlink")
        assert(error.contains("\"kind\":\"io\""), error)
        assert(!outside.join("codemods").exists())
    }
}

