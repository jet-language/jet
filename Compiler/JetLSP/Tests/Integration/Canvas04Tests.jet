// Rust: tests/canvas.rs:6291
#Test("canvas_projects_and_edits_every_unified_loop_clause") {
    path :: write_fixture("unified_loop_canvas", "fn run() {{\n    total := 0\n    loop item in [1, 2, 3], 2 {{\n        total += item\n    }}\n    loop i in 0..3, 2 {{\n        total += i\n    }}\n    counts := [String:Int]{{ \"one\": 1 }}\n    loop entry in counts {{\n        total += entry.value\n    }}\n    loop (key, value) in counts {{\n        total += value\n    }}\n    loop cursor := 0, cursor < 1 {{\n        total += cursor\n        cursor += 1\n    }}\n}}\n")
    graph :: Canvas.graph_json_for_file(path).expect("unified loop graph")
    loop field in ["\"role\":\"source\"", "\"role\":\"stride\"", "\"role\":\"range_start\"", "\"role\":\"range_end\"", "\"role\":\"initializer\"", "\"role\":\"condition\"", "\"name\":\"entry\"", "\"name\":\"key\"", "\"name\":\"value\""] -> assert(graph.contains(field), "unified loop graph missing {field}: {graph}")
    loop exact in ["\"role\":\"initializer\",\"source\":\"cursor := 0\"", "\"role\":\"condition\",\"source\":\"cursor < 1\""] -> assert(graph.contains(exact), "unified loop graph missing exact clause {exact}: {graph}")
    (list_start, list_end) :: source_span_near(graph, "\"title\":\"list\"")
    before :: fs.read_to_string(path).unwrap()
    append :: "{{\"schema_version\":1,\"op\":\"append_multi_input\",\"revision\":\"{Canvas.source_revision(before)}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element\":\"4\"}}"
    Canvas.apply_transaction_json(path, append).expect("edit list source nested in loop header")
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("loop item in [1, 2, 3, 4], 2"), after)
    graph :: Canvas.graph_json_for_file(path).expect("graph before header edits")
    initializer_id :: field_before(graph, "\"source\":\"cursor := 0\"", "inline_expr_id")
    edit_initializer :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{Canvas.source_revision(after)}\",\"inline_expr_id\":\"{initializer_id}\",\"new_expr\":\"cursor := 1\"}}"
    Canvas.apply_transaction_json(path, edit_initializer).expect("edit complete typed state initializer clause")
    after_initializer :: fs.read_to_string(path).unwrap()
    graph :: Canvas.graph_json_for_file(path).expect("graph before condition edit")
    condition_id :: field_before(graph, "\"source\":\"cursor < 1\"", "inline_expr_id")
    edit_condition :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{Canvas.source_revision(after_initializer)}\",\"inline_expr_id\":\"{condition_id}\",\"new_expr\":\"cursor < 2\"}}"
    Canvas.apply_transaction_json(path, edit_condition).expect("edit complete state condition clause")
    after_headers :: fs.read_to_string(path).unwrap()
    assert(after_headers.contains("loop cursor := 1, cursor < 2"), after_headers)
}

