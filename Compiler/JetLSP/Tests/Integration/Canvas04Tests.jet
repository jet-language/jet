// Private continuation of Canvas.jet; helpers and fixture constants remain there.
use jet.[Canvas, Formatter, format_source]
use jetpack.[WorkspaceFile]
use std.[fs, thread, process, env]
use std.process.[Command]
use std.path.[PathBuf]
// GATE #4494: native filesystem, links, threads and process execution.
// GATE #4483: Unix-only link assertions dispatch on selected target family.

// Rust: tests/canvas.rs:5332
#Test("canvas_project_transactions_add_workspace_member") {
    dir :: temp_dir("project_add_workspace_member")
    fs.create_dir_all(dir.join("packages/app")).unwrap()
    fs.create_dir_all(dir.join("packages/tools")).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: [\"./packages/app\"]\n}}\n").unwrap()
    fs.write(dir.join("packages/app/package.jet"), "name: \"app\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n").unwrap()
    fs.write(dir.join("packages/tools/package.jet"), "name: \"tools\"\nversion: \"0.1.0\"\npackages: {{ tools: library }}\n").unwrap()
    entry :: dir.join("packages/app/main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    workspace_revision :: Canvas.source_revision(fs.read_to_string(dir.join("workspace.jet")).unwrap())
    req :: "{{\"schema_version\":1,\"op\":\"add_workspace_member\",\"preview\":true,\"project_revision\":\"{project_revision}\",\"files\":[{{\"path\":\"workspace.jet\",\"revision\":\"{workspace_revision}\"}}],\"workspace\":\"workspace.jet\",\"member_path\":\"packages/tools\"}}"
    preview :: Canvas.apply_project_transaction_json(entry, req).expect("add workspace member preview")
    assert(preview.contains("\"op\":\"add_workspace_member\""), preview)
    assert(preview.contains("\"writes\":\"preview_only\""), preview)
    assert(preview.contains("+    members: [\\\"./packages/app\\\", \\\"./packages/tools\\\"]"), preview)
    assert(!fs.read_to_string(dir.join("workspace.jet")).unwrap().contains("tools"))
    apply :: req.replace("\"preview\":true", "\"preview\":false")
    applied :: Canvas.apply_project_transaction_json(entry, apply).expect("add workspace member apply")
    assert(applied.contains("\"writes\":\"source_transaction\""), applied)
    workspace :: fs.read_to_string(dir.join("workspace.jet")).unwrap()
    assert(workspace.contains("\"./packages/tools\""), workspace)
    assert(WorkspaceFile.evaluate(workspace, dir).is_ok(), workspace)
    after_project :: Canvas.project_json_for_entry(entry)
    assert(after_project.contains("\"name\":\"tools\""), after_project)
}

// Rust: tests/canvas.rs:5398
#Test("canvas_project_source_id_selects_file_graph_and_query") {
    dir :: temp_dir("project_source_id")
    fs.write(dir.join("package.jet"), "name: \"source_id\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"main\")\n}}\n").unwrap()
    helper :: dir.join("helper.jet")
    fs.write(helper, "fn helper() -> Int {{\n    return 7\n}}\n").unwrap()
    graph :: Canvas.graph_json_for_entry_source(entry, "helper.jet").expect("helper graph")
    assert(graph.contains("\"source_id\":\"helper.jet\""), graph)
    assert(graph.contains("helper.jet"), graph)
    assert(graph.contains("\"title\":\"helper\""), graph)
    assert(!graph.contains("\"title\":\"run\""), graph)
    helper_src :: fs.read_to_string(helper).unwrap()
    revision :: Canvas.source_revision(helper_src)
    query :: "{{\"schema_version\":1,\"op\":\"find\",\"source_id\":\"helper.jet\",\"revision\":\"{revision}\",\"query\":\"helper\"}}"
    result :: Canvas.query_json_for_entry(entry, query).expect("helper query")
    assert(result.contains("\"protocol\":\"jet.canvas.query\""), result)
    assert(result.contains("\"title\":\"helper\""), result)
    command :: "{{\"schema_version\":1,\"action_id\":\"canvas.command:check\",\"source_id\":\"helper.jet\",\"revision\":\"{revision}\"}}"
    receipt :: Canvas.command_receipt_json_for_entry(entry, command).expect("selected helper command receipt")
    assert(receipt.contains("\"source_id\":\"helper.jet\""), receipt)
    assert(receipt.contains("\"command\":[\"jet\",\"check\",\"helper.jet\"]"), receipt)
    assert(receipt.contains("\"revision\":\"{revision}\""), receipt)
    nested_dir :: dir.join("src")
    fs.create_dir_all(nested_dir).unwrap()
    nested :: nested_dir.join("nested.jet")
    fs.write(nested, "fn nested() -> Int {{\n    return 9\n}}\n").unwrap()
    nested_src :: fs.read_to_string(nested).unwrap()
    nested_revision :: Canvas.source_revision(nested_src)
    nested_command :: "{{\"schema_version\":1,\"action_id\":\"canvas.command:check\",\"source_id\":\"src/nested.jet\",\"revision\":\"{nested_revision}\"}}"
    nested_receipt :: Canvas.command_receipt_json_for_entry(entry, nested_command).expect("nested source command receipt")
    assert(nested_receipt.contains("\"command\":[\"jet\",\"check\",\"src/nested.jet\"]"), nested_receipt)
    edit :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"source_id\":\"helper.jet\",\"revision\":\"{revision}\",\"source\":\"fn helper() -> Int {{\\n    return 8\\n}}\\n\"}}"
    edited :: Canvas.apply_transaction_json(entry, edit).expect("selected helper source transaction")
    assert(edited.contains("\"protocol\":\"jet.canvas.edit\""), edited)
    assert(edited.contains("\"changed\":true"), edited)
    assert(fs.read_to_string(helper).unwrap().contains("return 8"))
    assert(fs.read_to_string(entry).unwrap().contains("print(\"main\")"))
    missing :: Canvas.graph_json_for_entry_source(entry, "missing.jet").expect_err("bad source_id should be rejected")
    assert(missing.contains("\"kind\":\"not_found\""), missing)
    missing_query :: "{{\"schema_version\":1,\"op\":\"find\",\"source_id\":\"missing.jet\",\"revision\":\"{revision}\",\"query\":\"helper\"}}"
    err :: Canvas.query_json_for_entry(entry, missing_query).expect_err("bad query source_id should be rejected")
    assert(err.contains("\"kind\":\"not_found\""), err)
}

// Rust: tests/canvas.rs:5495
#Test("canvas_project_source_id_selects_debug_session_and_revision") {
    dir :: temp_dir("project_source_id_debug")
    fs.write(dir.join("package.jet"), "name: \"source_id_debug\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"entry\")\n}}\n").unwrap()
    helper :: dir.join("helper.jet")
    fs.write(helper, CANVAS_DEBUG_FIXTURE).unwrap()
    src :: fs.read_to_string(helper).unwrap()
    revision :: Canvas.source_revision(src)
    req :: "{{\"schema_version\":1,\"source_id\":\"helper.jet\",\"revision\":\"{revision}\",\"commands\":[\"c\"],\"watches\":[\"total\"]}}"
    debug_path :: entry.clone()
    out :: thread.Builder.new().stack_size(2 * 1024 * 1024)
        .spawn(() -> Canvas.debug_session_json_for_entry(debug_path, req))
        .expect("spawn Canvas debug embedder").join()
        .expect("Canvas debug embedder must not overflow").expect("selected helper debug session")
    assert(out.contains("\"protocol\":\"jet.canvas.debug\""), out)
    assert(out.contains("\"revision\":\"{revision}\""), out)
    assert(out.contains("\"debug_overlay\":\"finished\""), out)
    assert(out.contains("program finished"), out)
    assert(!out.contains("entry"), "debug selected the entry source instead of helper: {out}")
    assert_eq(fs.read_to_string(helper).unwrap(), src)
}

