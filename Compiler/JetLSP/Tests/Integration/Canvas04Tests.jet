#Test("canvas_editor_shell_matches_round3_contract") {
    html :: Canvas.canvas_html()
    js :: Canvas.canvas_js()
    loop term in ["<h2>My Canvas</h2>", "id=\"variables-list\"", "id=\"status-summary\"", "class=\"toolbar-group\"", "class=\"icon-button\"", "id=\"toolbar-search\"", "<svg viewBox=\"0 0 24 24\"", "id=\"trust-summary\"", "id=\"trust-summary\" class=\"project-section dev-only", ".library-panel", ".library-entry"] -> assert(html.contains(term), html)
    loop term in ["source-truth", "Source truth", ">Trust<"] -> assert(!html.contains(term), html)
    loop term in [
        "function syncVariablesList", "function renderVariableDetails", "function functionEffectSuffix", "fnMeta && fnMeta.effect_via", "\" -[\" + fnMeta.effects.join(\", \") + \"]>\"", "data-project-file", "const sourceFiles = (project.files || []).filter", "Showing first ${{visibleResults.length}}", "const requestedSourceId = currentCanvasSourceId();", "Command result is stale; current source was kept", "Debug result is stale; current source was kept", "Debug session disconnected; source was kept", "function releaseDebugSession", ".filter((b) => b.revision === requestedRevision)", "Debug state was bounded; source was kept", "debugSessionId", "function actionInsertsNode", "function nodeDescriptorForAction", "function insertCalleeForAction", "insert_callee: action.insert_callee", "const candidates = actionEntries.filter", "descriptor.palette.insertable", "descriptor.palette.rank", "descriptor.presentation.hover", "nodeDescriptor(node).default_editor", "editablePinKind(graph, pin)", "nodeDescriptors: latestDoc.node_descriptors", "descriptorConsumption: graph.nodes.map", "toolbarSearch.addEventListener", "function syncTraitsPanel", "function syncEventsPanel", "data-canvas-events", "event_dispatchers", "function eventDispatcherActions", "Open event actions", "\"Events\"", "function syncLibraryPanel", "data-canvas-library", "data-library-search", "data-library-action", "function runLibraryAction", "transactionForPaletteInsert(item, null", "data-canvas-traits", "data-trait-create", "function traitMethodActions", "\"Interfaces\"", "create_trait_impl", "Add connected node", "Canvas actions", "function renderExecConvergencePreview", "source_edit: \"exec_convergence\"", "id=\"apply-exec-convergence\"", "data-exec-convergence-function", "strategy: \"extract\"", "const accepted = result && result.changed === true"
    ] -> assert(js.contains(term), js)
    assert(!js.contains("originalSignature.includes(\"=[\")"), "retired effect signature spelling leaked into Canvas: {js}")
    assert(!js.contains("\" =[\" + effects + \"]=>\""), "retired effect signature arrow leaked into Canvas: {js}")
    assert(!js.contains("fnMeta.pure ? \"#Pure \""), js)
    assert(!js.contains("window.prompt(\"Call function\""), "Canvas must not invent a callee for an incomplete action: {js}")
    assert(!js.contains("checkedFallbackCallee"), "Canvas must not turn a display title into an insertion callee: {js}")
    assert(!js.contains("const sourceCallee = descriptor.transaction"), "Canvas must not derive a callee from a node title: {js}")
    assert(js.contains("actionEntriesRevision !== latestDoc.revision") && js.contains("loadCanvasActions({{ skipRedraw: true }}).then"), "pin menus must wait for the checked descriptor catalog: {js}")
    assert(!js.contains("[\"insert_branch\", \"insert_switch\", \"insert_loop\", \"insert_fallible_rail\"]"), "parallel insertion-kind tables must not return: {js}")
    assert(!js.contains(".filter((descriptor) => descriptor.transaction === transaction)"), "browser must not infer action descriptors from transaction/purity: {js}")
    loop term in ["Graph actions", "Refused: E0204", "Source truth", "source-truth"] -> assert(!js.contains(term), js)
}

