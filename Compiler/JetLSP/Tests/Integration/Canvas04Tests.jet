    edit :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{revision}\",\"source\":\"fn run() {{\\n    #Shield {{\\n        print(\\\"after\\\")\\n    }}\\n}}\\n\",\"source_edit\":true}}"
