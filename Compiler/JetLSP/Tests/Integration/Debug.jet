// PORT-PENDING 1029 tests-debug: tests/debug.rs:1-1926
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-DBG1 / D-DBG3 — `jet debug` source-level step-debugger tests.
//RS //!
//RS //! Drives the debugger programmatically via `jet::Debug::run_session(file,
//RS //! inputs)`, which feeds a scripted sequence of `(jet)` commands and returns
//RS //! the full transcript (banners, `<- here` carets, `locals:` dumps, command
//RS //! echoes, program output, and the final marker). We assert on the exact
//RS //! protocol/output: that a breakpoint resolves to the right Jet line, that the
//RS //! stack frame and locals are in Jet terms (I2 — never generated Rust), and
//RS //! that step / next / continue / finish behave as ratified.
//RS //!
//RS //! The fixtures are tiny owned scratch projects so the test is hermetic. The debugger drives
//RS //! the same dev interpreter `jet dev`/`jet repl` use, so no rustc is needed.
//RS //!
//RS //! Also covers D-DBG3 step 2 (dap-debugger) — the native lldb-backed `jet
//RS //! debug` backend (see the section below): codegen-only line-marker checks
//RS //! (no rustc/lldb needed), a production DAP wire failure check, and a full
//RS //! native session. The live session gates only on `rustc`/`lldb` being absent;
//RS //! once both tools exist, a stop or cleanup failure is a test failure.
//RS 
//RS mod common;
//RS #[path = "tir_support/mod.rs"]
//RS mod tir_support;
//RS 
//RS use jet_foundation::DataTree::DataTree;
//RS use jet_foundation::JSON::{json_get, json_str, parse_json};
//RS use std::ffi::OsStr;
//RS use std::fmt;
//RS use std::io::{Read, Write};
//RS use std::ops::Deref;
//RS use std::path::{Path, PathBuf};
//RS use std::process::{Command, Stdio};
//RS use std::time::{Duration, Instant};
//RS 
