//RS /// A program using a feature the dev interpreter can't step (here `core.files`)
//RS /// declines at the debug boundary with E2203, pointing at the real build (I2 —
//RS /// the message names `jet debug`, never the generated Rust).
//RS #[test]
//RS fn unsupported_feature_stops_at_e2203_boundary() {
//RS     let file = fixture(
//RS         "boundary",
//RS         "use core.files as fs\nfn run() {\n    print(\"hi\")\n}\n",
//RS     );
//RS     let out = jet::Debug::run_session(&file, &["c"]);
//RS     assert!(
//RS         out.contains("E2203"),
//RS         "an unsteppable feature must stop at E2203; got:\n{out}"
//RS     );
//RS     assert!(
//RS         out.contains("jet debug") && (out.contains("jet run") || out.contains("jet build")),
//RS         "E2203 must name `jet debug` and point at the real build; got:\n{out}"
//RS     );
//RS }
