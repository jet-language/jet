//RS /// `next`/`n` steps over the loop body without descending statement-by-statement
//RS /// at a deeper position — the line advances within `main`, not into a callee.
//RS #[test]
//RS fn next_steps_over() {
//RS     let file = fixture("next", CALLS);
//RS     // main:6 (a:=5), then `next` over the `double(a)` call to main's next line.
//RS     let out = jet::Debug::run_session(&file, &["s", "n", "n"]);
//RS     // `next` from `b := double(a)` must NOT stop inside `double` — the callee's
//RS     // `y := x * 2` line should never appear as a stop before we reach main's print.
//RS     assert!(
//RS         out.contains("program finished"),
//RS         "should run to the end; got:\n{out}"
//RS     );
//RS }
