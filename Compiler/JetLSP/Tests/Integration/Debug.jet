// Rust: tests/debug.rs:68
// GATE #4494: Scratch owns package tree cleanup; actual file writes.
fn fixture(tag: String, src: String) -> Fixture {
    scratch :: Scratch.new("jet_debug_{tag}")
    dir :: scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    p :: dir.join("jet_debug_{tag}.jet")
    f := fs.File.create(p).unwrap()
    &f.write_all(src.bytes()).unwrap()
    Fixture{path: p.to_string_lossy().to_string(), scratch: ^scratch}
}

