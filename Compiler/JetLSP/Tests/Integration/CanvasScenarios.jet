// Rust: tests/canvas_scenarios.rs:1081
fn run_browser_scenario(name: &String, browser: &String, node: &OSPath, environment: &[(String, OSPath)]) -> {
    run_browser_scenario_with_server(name, browser, node, environment, false, none)
}
// Rust: tests/canvas_scenarios.rs:1085
fn run_browser_scenario_with_server(name: &String, browser: &String, node: &OSPath, environment: &[(String, OSPath)], target_independent: Bool, program_target: String?) -> {
    browser_count :: if name == SESSION_SURFACE_MATRIX_SCENARIO -> 2 else -> 1
    _browser_permits :: (0..browser_count).map(_ -> CanvasBrowserPermit.acquire()).collect()
    ensure_jet_built()
    repo :: OSPath.from(env.manifest_dir())
    case :: CanvasCase.new(repo, name)
    port :: free_port()
    server := DevServer.start(repo, case.dir, case.entry, port, target_independent, program_target)
    if case.big_fixture != none -> assert_big_fixture_preflight(repo, case, port)
    session :: CANVAS_SESSIONS.get_or_init(() -> Mutex.new([:])).lock().unwrap().get(port).cloned().expect("Canvas server session secret")
    command := Command.new(node)
    command.current_dir(repo).envs(environment.iter().copied()).env("TMPDIR", "/home/nate/.cache/jet-test-scratch")
        .env("JET_BIN", cargo_target_dir(repo).join("debug/jet")).env("JETPACK_BIN", cargo_target_dir(repo).join("debug/jetpack"))
        .arg("Tools/canvas-test/run.mjs").arg("--scenario").arg(name).arg("--browser").arg(browser).arg("--port").arg(port.to_string())
        .arg("--session").arg(session).arg("--out-dir").arg(case.screenshots).arg("--seed").arg("373")
    if program_target != none -> command.arg("--program-target").arg(program_target.unwrap())
    output :: command.output().expect("run Canvas scenario driver")
    server_exit :: server.child.try_wait().expect("poll Canvas devserver after browser load")
    server_log :: server.stop()
    if !output.status.success() -> panic("Canvas scenario `{name}` failed\n\n--- driver stdout ---\n{String.from_utf8_lossy(output.stdout)}\n--- driver stderr ---\n{String.from_utf8_lossy(output.stderr)}\n--- jet dev ---\n{server_log}")
    assert(server_exit == none, "Canvas devserver exited after the real browser loaded its projection: {server_exit:?}\n\n--- jet dev ---\n{server_log}")
    eprintln("{String.from_utf8_lossy(output.stdout)}")
}
// Rust: tests/canvas_scenarios.rs:1164
fn ensure_jet_built() -> {
    BUILD_JET.call_once(() -> {
        repo :: OSPath.from(env.manifest_dir())
        // The harness builds its external reference CLI in the checkout-local cache.
        target :: cargo_target_dir(repo)
        status :: Command.new("cargo").current_dir(repo).arg("build").status().expect("cargo build for Canvas scenarios")
        assert(status.success(), "cargo build failed before Canvas scenarios")
        assert(target.join("debug/jet").is_file(), "cargo build did not produce the Canvas scenario jet binary")
    })
}
// Rust: tests/canvas_scenarios.rs:1188
fn cargo_target_dir(repo: &OSPath) -> OSPath {
    dir :: env.var_os("CARGO_TARGET_DIR")
    if dir == none -> repo.join("target")
    else if OSPath.from(dir.unwrap()).is_absolute() -> OSPath.from(dir.unwrap())
    else -> repo.join(dir.unwrap())
}
// Rust: tests/canvas_scenarios.rs:1196
fn canvas_tools() -> &CanvasTools? {
    CANVAS_TOOLS.get_or_init(() -> {
        strict :: env.var_os("JET_CANVAS_PREREQUISITES").as_deref() == "strict"
        chromium :: resolve_canvas_tool("chromium", strict)?
        node :: resolve_canvas_tool("node", strict)?
        CanvasTools{chromium: ^chromium, node: ^node}
    }).as_ref()
}
// Rust: tests/canvas_scenarios.rs:1208
fn gecko_tools() -> &GeckoTools Err! {
    GECKO_TOOLS.get_or_init(() -> {
        strict :: env.var_os("JET_CANVAS_PREREQUISITES").as_deref() == "strict"
        firefox :: resolve_canvas_tool("firefox", strict).ok_or_else(() -> "Gecko smoke needs a valid Firefox executable")?
        geckodriver :: resolve_canvas_tool("geckodriver", strict).ok_or_else(() -> "Gecko smoke needs a valid geckodriver executable")?
        node :: resolve_canvas_tool("node", strict).ok_or_else(() -> "Gecko smoke needs a valid Node executable")?
        GeckoTools{firefox: ^firefox, geckodriver: ^geckodriver, node: ^node}
    }).as_ref().map_err(error -> error.as_str())
}
// Rust: tests/canvas_scenarios.rs:1229
fn resolve_canvas_tool(name: &String, strict: Bool) -> OSPath? {
    resolved_key :: "JET_CANVAS_{name.to_ascii_uppercase()}_RESOLVED"
    override_key :: "JET_CANVAS_{name.to_ascii_uppercase()}"
    candidate :: (if strict -> env.var_os(resolved_key) else -> env.var_os(override_key).or_else(() -> name.into()))?
    path :: resolve_executable(OSPath.from(candidate))?
    output :: Command.new(path).arg("--version").output().ok()?
    version :: "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}"
    valid :: match name {
        "chromium" -> version.contains("Chromium") || version.contains("Chrome")
        "firefox" -> version.contains("Firefox")
        "geckodriver" -> version.starts_with("geckodriver")
        "node" -> version.starts_with('v') && version.as_bytes().get(1).is_some_and(byte -> byte.is_ascii_digit())
        else -> false
    }
    if valid -> ^path else -> none
}
// Rust: tests/canvas_scenarios.rs:1256
fn resolve_executable(candidate: &OSPath) -> OSPath? {
    if candidate.components().count() > 1 {
        return if candidate.is_file() -> candidate.to_path_buf() else -> none
    }
    env.split_paths(env.var_os("PATH")?).map(dir -> dir.join(candidate)).find(path -> path.is_file())
}

