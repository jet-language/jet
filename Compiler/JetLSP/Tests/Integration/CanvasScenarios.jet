// Rust: tests/canvas_scenarios.rs:382
struct BigFixtureFacts { file_count: USize, function_count: USize, source_bytes: USize, source_sha256: String }
// Rust: tests/canvas_scenarios.rs:389
fn write_big_fixture(dir: &OSPath) -> BigFixtureFacts {
    main := String.new()
    loop module in 0..BIG_MODULE_COUNT -> main.push_str("use \"./part_{module:02}\" as p{module:02}\n")
    main.push('\n')
    main.push_str("fn run() {{\n")
    loop function in 0..BIG_FUNCTION_COUNT {
        module :: function / BIG_FUNCTIONS_PER_MODULE
        main.push_str("    value_{function:03} :: p{module:02}.function_{function:03}()\n")
    }
    main.push_str("    print(value_299)\n}}\n")
    canonical := String.new()
    fs.write(dir.join("main.jet"), main).expect("write generated Canvas entry source")
    canonical.push_str("main.jet\n")
    canonical.push_str(main)
    loop module in 0..BIG_MODULE_COUNT {
        first :: module * BIG_FUNCTIONS_PER_MODULE
        source := String.new()
        loop function in first..first + BIG_FUNCTIONS_PER_MODULE -> source.push_str("pub fn function_{function:03}() Int -[]> {{ return 1 }}\n\n")
        name :: "part_{module:02}.jet"
        fs.write(dir.join(name), source).expect("write generated Canvas module source")
        canonical.push_str(name)
        canonical.push('\n')
        canonical.push_str(source)
    }
    BigFixtureFacts{file_count: BIG_FILE_COUNT, function_count: BIG_FUNCTION_COUNT, source_bytes: canonical.len(), source_sha256: sha256_hex(canonical.as_bytes())}
}
// Rust: tests/canvas_scenarios.rs:435
fn read_big_fixture_facts(dir: &OSPath) -> BigFixtureFacts {
    canonical := String.new()
    loop name in std.iter.once("main.jet".to_string()).chain((0..BIG_MODULE_COUNT).map(module -> "part_{module:02}.jet")) {
        source :: fs.read_to_string(dir.join(name)).expect("read generated Canvas source")
        canonical.push_str(name)
        canonical.push('\n')
        canonical.push_str(source)
    }
    BigFixtureFacts{file_count: BIG_FILE_COUNT, function_count: BIG_FUNCTION_COUNT, source_bytes: canonical.len(), source_sha256: sha256_hex(canonical.as_bytes())}
}
// Rust: tests/canvas_scenarios.rs:453
fn assert_big_fixture_preflight(repo: &OSPath, case: &CanvasCase, port: U16) -> {
    expected :: case.big_fixture.as_ref().expect("big fixture facts for big-project-perf")
    actual :: read_big_fixture_facts(case.dir)
    assert_eq(actual.file_count, expected.file_count, "generated file count changed")
    assert_eq(actual.function_count, expected.function_count, "generated function count changed")
    assert_eq(actual.source_bytes, expected.source_bytes, "generated source bytes changed")
    assert_eq(actual.source_sha256, expected.source_sha256, "generated source changed")
    jet :: cargo_target_dir(repo).join("debug/jet")
    check :: Command.new(jet).current_dir(case.dir).args(["check", "main.jet", "--target=web"]).output().expect("check generated Canvas fixture with Jet")
    assert(check.status.success(), "generated Canvas fixture failed Jet check\n--- stdout ---\n{String.from_utf8_lossy(check.stdout)}\n--- stderr ---\n{String.from_utf8_lossy(check.stderr)}")
    graph :: http_body(port, "/canvas/graph")
    graph_count :: graph.matches("\"graph_id\":").count()
    assert_eq(graph_count, BIG_FUNCTION_COUNT + 1, "Jet served an unexpected generated graph count")
    assert(graph.contains("\"title\":\"run\""), "generated entry graph is missing")
    eprintln("BIG_PROJECT_PREFLIGHT files={actual.file_count} functions={actual.function_count} source_bytes={actual.source_bytes} source_sha256={actual.source_sha256} graphs={graph_count} jet_check=passed")
}

