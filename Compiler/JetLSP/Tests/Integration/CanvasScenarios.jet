// Rust: tests/canvas_scenarios.rs:1392
struct DevServer {
    child: Child
    // Rust: tests/canvas_scenarios.rs:1397
    fn start(repo: &OSPath, cwd: &OSPath, entry: &OSPath, port: U16, target_independent: Bool, program_target: String?) -> DevServer {
        jet :: cargo_target_dir(repo).join("debug/jet")
        command := if cwd.join("env.jet").is_file() {
            command := Command.new(cargo_target_dir(repo).join("debug/jetpack"))
            command.current_dir(cwd).env("JET_ROOT", cwd).args(["env", "-y", "--"]).arg(jet)
            ^command
        } else -> Command.new(jet)
        command.current_dir(cwd).arg("dev").arg(entry)
        if target_independent {
            command.arg("--canvas").arg("--canvas-port={port}")
            if program_target != none -> command.arg("--target={program_target.unwrap()}")
        } else {
            command.arg("--canvas").arg("--target=web").arg("--canvas-port={port}")
        }
        child := command.stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start jet dev Canvas server")
        stdout :: child.stdout.take()
        if stdout != none {
            thread.spawn(() -> {
                loop line in BufReader.new(^stdout.unwrap()).lines().map_while(result -> result.ok()) {
                    url :: line.split("Canvas: ").nth(1)
                    if url == none -> continue
                    port :: url.unwrap().split("http://127.0.0.1:").nth(1)
                        .or_else(() -> url.unwrap().split("http://localhost:").nth(1))
                        .and_then(rest -> rest.split(c -> !c.is_ascii_digit()).next())
                        .and_then(value -> value.parse<U16>().ok())
                    if port == none -> continue
                    token :: url.unwrap().split("session=").nth(1).map(value -> value.split(c -> !c.is_ascii_hexdigit()).next().unwrap_or_default().to_string())
                    if token == none -> continue
                    if token.unwrap().len() >= 32 -> CANVAS_SESSIONS.get_or_init(() -> Mutex.new([:])).lock().unwrap().insert(port.unwrap(), ^token.unwrap())
                }
            })
        }
        wait_for_server(&child, port)
        DevServer{child: ^child}
    }
    // Rust: tests/canvas_scenarios.rs:1473
    fn stop(&self) -> String {
        stop_process_tree(&self.child)
        out := String.new()
        stdout := self.child.stdout.take()
        if stdout != none -> _ :: stdout.unwrap().read_to_string(&out)
        stderr := self.child.stderr.take()
        if stderr != none {
            err := String.new()
            _ :: stderr.unwrap().read_to_string(&err)
            out.push_str(err)
        }
        ^out
    }
    // Rust: tests/canvas_scenarios.rs:1489
    fn drop(&self) -> { stop_process_tree(&self.child) }
}
// Rust: tests/canvas_scenarios.rs:1494
fn stop_process_tree(child: &Child) -> {
    if core.sys.target.selected_family() == "unix" -> stop_process_tree_unix(child.id())
    else -> _ :: child.kill()
    _ :: child.wait()
}
// Rust: tests/canvas_scenarios.rs:1505
fn stop_process_tree_unix(pid: U32) -> {
    children_path :: "/proc/{pid}/task/{pid}/children"
    match fs.read_to_string(children_path) {
        Ok(children) -> loop child in children.split_whitespace().filter_map(value -> value.parse<U32>().ok()) -> stop_process_tree_unix(child)
        Err(_) -> {}
    }
    _ :: Command.new("kill").args(["-KILL", pid.to_string()]).status()
}
// Rust: tests/canvas_scenarios.rs:1520
fn wait_for_server(child: &Child, port: U16) -> {
    start :: Instant.now()
    loop start.elapsed() < Duration.from_secs(30) {
        status :: child.try_wait().expect("poll jet dev")
        if status != none -> panic("jet dev exited before serving Canvas: {status.unwrap()}")
        if http_ok(port, "/__jet_dev_status") {
            if CANVAS_SESSIONS.get_or_init(() -> Mutex.new([:])).lock().unwrap().contains_key(port) -> return
        }
        thread.sleep(Duration.from_millis(80))
    }
    panic("timed out waiting for jet dev on port {port}")
}
// Rust: tests/canvas_scenarios.rs:1541
fn http_ok(port: U16, path: &String) -> Bool {
    stream := match TcpStream.connect(("127.0.0.1", port)) {
        Ok(stream) -> ^stream
        Err(_) -> return false
    }
    authorization :: CANVAS_SESSIONS.get_or_init(() -> Mutex.new([:])).lock().unwrap().get(port)
        .map(token -> "Authorization: Bearer {token}\r\n").unwrap_or_default()
    request :: "GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nOrigin: http://127.0.0.1:{port}\r\n{authorization}Connection: close\r\n\r\n"
    if stream.write_all(request.as_bytes()).is_err() -> return false
    response := String.new()
    if stream.read_to_string(&response).is_err() -> return false
    response.starts_with("HTTP/1.1 200")
}
// Rust: tests/canvas_scenarios.rs:1565
fn http_body(port: U16, path: &String) -> String {
    stream := TcpStream.connect(("127.0.0.1", port)).expect("connect to Jet Canvas server")
    authorization :: CANVAS_SESSIONS.get_or_init(() -> Mutex.new([:])).lock().unwrap().get(port)
        .map(token -> "Authorization: Bearer {token}\r\n").unwrap_or_default()
    request :: "GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nOrigin: http://127.0.0.1:{port}\r\n{authorization}Connection: close\r\n\r\n"
    stream.write_all(request.as_bytes()).expect("request Jet Canvas preflight body")
    response := String.new()
    stream.read_to_string(&response).expect("read Jet Canvas preflight body")
    assert(response.starts_with("HTTP/1.1 200"), "Jet Canvas preflight failed: {response}")
    response.split_once("\r\n\r\n").map((_, body) -> body.to_string()).expect("Jet Canvas response missing body separator")
}
// Rust: tests/canvas_scenarios.rs:1594
fn free_port() -> U16 {
    TcpListener.bind(("127.0.0.1", 0)).expect("bind free local port").local_addr().expect("local addr").port()
}
