// Stdlib-only browser scenarios for Canvas.
use {
    std.[fs, env, process, thread]
    std.net.[TcpListener, TcpStream]
    std.process.[Child, Command, Stdio]
    std.sync.[Condvar, Mutex, OnceLock]
    std.sync.atomic.[AtomicU64, Ordering]
    std.time.[Duration, Instant]
    std.io.[BufReader, ErrorKind]
    jet.SHA256.[sha256_hex]
}
// GATE #4494: actual native process/thread/synchronization/socket/filesystem providers.
// GATE #4483: selected-family dispatch for native process-tree cleanup.
// GATE #4409: artifact cleanup preserves NotFound error-kind distinction.

NEXT_CANVAS_CASE: AtomicU64.new(0)
MAX_CANVAS_BROWSERS: 4
BIG_PROJECT_SCENARIO: "big-project-perf"
DEVSERVER_REAL_CLIENT_SCENARIO: "devserver-real-client-survival"
SESSION_SURFACE_MATRIX_SCENARIO: "session-surface-matrix"
WORKBENCH_E2E_SCENARIO: "canvas-workbench-e2e"
EXPLICIT_WEB_TARGET: "web"
BIG_FUNCTION_COUNT: 300
BIG_MODULE_COUNT: 12
BIG_FUNCTIONS_PER_MODULE: BIG_FUNCTION_COUNT / BIG_MODULE_COUNT
BIG_FILE_COUNT: BIG_MODULE_COUNT + 1
CANVAS_BROWSER_POOL: OnceLock<(Mutex<USize>, Condvar)>.new()
CANVAS_SESSIONS: OnceLock<Mutex<[U16:String]>>.new()
CanvasTools: struct { chromium: OSPath }
GeckoTools: struct { firefox: OSPath, geckodriver: OSPath }
CANVAS_TOOLS: OnceLock<CanvasTools?>.new()
GECKO_TOOLS: OnceLock<GeckoTools Err!>.new()

CanvasBrowserPermit: struct {
    acquire: fn() -> CanvasBrowserPermit {
        (available, wake): CANVAS_BROWSER_POOL.get_or_init(() -> (_0: Mutex.new(MAX_CANVAS_BROWSERS), _1: Condvar.new()))
        available := available.lock().expect("Canvas browser permit lock poisoned")
        loop available.deref() == 0 {
            available = wake.wait(available).expect("Canvas browser permit lock poisoned")
        }
        available.deref_mut() -= 1
        CanvasBrowserPermit{}
    }
    drop: fn(&self) {
        (available, wake): CANVAS_BROWSER_POOL.get_or_init(() -> (_0: Mutex.new(MAX_CANVAS_BROWSERS), _1: Condvar.new()))
        available.lock().expect("Canvas browser permit lock poisoned").deref_mut() += 1
        wake.notify_one()
    }
}

DEMO: "helper: fn() -> Int {{\n    return 1\n}}\n\n/// Squares an integer input for this Canvas example.\nsquare: fn(n: Int) -> Int {{\n    return n * n\n}}\n\n/// Summarizes a checked value for Canvas hover guidance.\nsummarize: fn(limit: Int) -> Int {{\n    total := square(limit)\n    if total > 10 {{\n        return total\n    }} else {{\n        return total + 1\n    }}\n}}\n\nscratch: fn(limit: Int, text: String, flag: Bool, ratio: Float) {{\n    print(limit)\n}}\n\nrun: fn() {{\n    print(summarize(4))\n}}\n"
CALLBACK_DEMO: "on_start: fn() {{\n    print(\"start\")\n}}\n\nhelper: fn() -> Int {{\n    return 1\n}}\n\nrun: fn() {{\n    on_start()\n}}\n"
DEBUG_DEMO: "helper: fn() -> Int {{\n    return 1\n}}\n\nsquare: fn(n: Int) -> Int {{\n    return n * n\n}}\n\nsummarize: fn(limit: Int) -> Int {{\n    total := square(limit)\n    if total > 10 {{\n        return total\n    }} else {{\n        return total + 1\n    }}\n}}\n\nscratch: fn(limit: Int, text: String, flag: Bool, ratio: Float) {{\n    print(limit)\n}}\n\nrun: fn() {{\n    value := summarize(4)\n    print(value)\n    print(value)\n}}\n"
EVENTS_PANEL_SOURCE: "use event: core.event\n\ndev: fn() {{\n    scope: event.scope()\n    clicked: event.new<Int>()\n    clicked.on(scope, n -> print(\"clicked {{n}}\"))\n    clicked.once(scope, n -> print(\"once {{n}}\"))\n    print(clicked.emit(1).summary())\n    scope.cancel()\n}}\n\nrun: fn() {{\n    dev()\n}}\n"

BigFixtureFacts: struct { file_count: USize, function_count: USize, source_bytes: USize, source_sha256: String }
write_big_fixture: fn(dir: OSPath) -> BigFixtureFacts {
    main := String.new()
    loop module_ref in 0..BIG_MODULE_COUNT -> main.push_str("use p: \"./part_{module_ref:02}\"{module_ref:02}\n")
    main.push('\n')
    main.push_str("run: fn() {{\n")
    loop function in 0..BIG_FUNCTION_COUNT {
        module_ref: function / BIG_FUNCTIONS_PER_MODULE
        main.push_str("    value_{function:03}: p{module_ref:02}.function_{function:03}()\n")
    }
    main.push_str("    print(value_299)\n}}\n")
    canonical := String.new()
    fs.write(dir.join("main.jet"), main).expect("write generated Canvas entry source")
    canonical.push_str("main.jet\n")
    canonical.push_str(main)
    loop module_ref in 0..BIG_MODULE_COUNT {
        first: module_ref * BIG_FUNCTIONS_PER_MODULE
        source := String.new()
        loop function in first..first + BIG_FUNCTIONS_PER_MODULE -> source.push_str("function_{function:03}: fn() Int -[]> {{ return 1 }}\n\n")
        name: "part_{module_ref:02}.jet"
        fs.write(dir.join(name), source).expect("write generated Canvas module source")
        canonical.push_str(name)
        canonical.push('\n')
        canonical.push_str(source)
    }
    BigFixtureFacts{file_count: BIG_FILE_COUNT, function_count: BIG_FUNCTION_COUNT, source_bytes: canonical.len(), source_sha256: sha256_hex(canonical.as_bytes())}
}
read_big_fixture_facts: fn(dir: OSPath) -> BigFixtureFacts {
    canonical := String.new()
    loop name in std.iter.once("main.jet".to_string()).chain((0..BIG_MODULE_COUNT).map(module_ref -> "part_{module_ref:02}.jet")) {
        source: fs.read_to_string(dir.join(name)).expect("read generated Canvas source")
        canonical.push_str(name)
        canonical.push('\n')
        canonical.push_str(source)
    }
    BigFixtureFacts{file_count: BIG_FILE_COUNT, function_count: BIG_FUNCTION_COUNT, source_bytes: canonical.len(), source_sha256: sha256_hex(canonical.as_bytes())}
}
assert_big_fixture_preflight: fn(repo: &OSPath, case: &CanvasCase, port: U16) {
    expected: case.big_fixture.as_ref().expect("big fixture facts for big-project-perf")
    actual: read_big_fixture_facts(case.dir)
    assert_eq(actual.file_count, expected.file_count, "generated file count changed")
    assert_eq(actual.function_count, expected.function_count, "generated function count changed")
    assert_eq(actual.source_bytes, expected.source_bytes, "generated source bytes changed")
    assert_eq(actual.source_sha256, expected.source_sha256, "generated source changed")
    jet: admitted_tool("JET", "jet")
    check: Command.new(jet).current_dir(case.dir).args(["check", "main.jet", "--target=web"]).output().expect("check generated Canvas fixture with Jet")
    assert(check.status.success(), "generated Canvas fixture failed Jet check\n--- stdout ---\n{String.from_utf8_lossy(check.stdout)}\n--- stderr ---\n{String.from_utf8_lossy(check.stderr)}")
    graph: http_body(port, "/canvas/graph")
    graph_count: graph.matches("\"graph_id\":").count()
    assert_eq(graph_count, BIG_FUNCTION_COUNT + 1, "Jet served an unexpected generated graph count")
    assert(graph.contains("\"title\":\"run\""), "generated entry graph is missing")
    eprintln("BIG_PROJECT_PREFLIGHT files={actual.file_count} functions={actual.function_count} source_bytes={actual.source_bytes} source_sha256={actual.source_sha256} graphs={graph_count} jet_check=passed")
}

// `jet run Tools/canvas-test/Run.jet -- <mode> <args>` from the repository root.
canvas_harness: fn(repo: &OSPath, mode: &String) -> Command {
    command := Command.new(admitted_tool("JET", "jet"))
    command.current_dir(repo).args(["run", "--allow=Env,Exec,FS,IO,Net,Time", "Tools/canvas-test/Run.jet", "--", mode])
    command
}
run_gecko_cleanup_probe: fn(tools: &GeckoTools) {
    repo: OSPath.from(env.manifest_dir())
    output: canvas_harness(repo, "gecko-lifecycle").env("FIREFOX", tools.firefox).env("GECKODRIVER", tools.geckodriver)
        .output().expect("run Gecko cleanup lifecycle probe")
    assert(output.status.success(), "Gecko cleanup lifecycle probe failed\n--- stdout ---\n{String.from_utf8_lossy(output.stdout)}\n--- stderr ---\n{String.from_utf8_lossy(output.stderr)}")
    eprintln("{String.from_utf8_lossy(output.stdout)}")
}
run_canvas_scenario: fn(name: &String) {
    tools: canvas_tools()
    if tools == none {
        eprintln("ignored: Canvas scenario `{name}` needs dev-shell Chromium")
        return
    }
    run_browser_scenario(name, "chromium", [(_0: "CHROMIUM", _1: tools.unwrap().chromium)])
}
run_target_independent_scenario: fn(name: &String) {
    tools: canvas_tools().unwrap_or_else(() -> panic("Canvas scenario `{name}` needs dev-shell Chromium"))
    run_browser_scenario_with_server(name, "chromium", [(_0: "CHROMIUM", _1: tools.chromium)], true, none)
}
run_target_independent_scenario_for_target: fn(name: &String, target: &String) {
    tools: canvas_tools().unwrap_or_else(() -> panic("Canvas scenario `{name}` needs dev-shell Chromium"))
    run_browser_scenario_with_server(name, "chromium", [(_0: "CHROMIUM", _1: tools.chromium)], true, target)
}
run_browser_scenario: fn(name: &String, browser: &String, environment: &[(String, OSPath)]) {
    run_browser_scenario_with_server(name, browser, environment, false, none)
}
run_browser_scenario_with_server: fn(name: &String, browser: &String, environment: &[(String, OSPath)], target_independent: Bool, program_target: String?) {
    browser_count: if name == SESSION_SURFACE_MATRIX_SCENARIO -> 2 else -> 1
    _browser_permits: (0..browser_count).map(_ -> CanvasBrowserPermit.acquire()).collect()
    repo: OSPath.from(env.manifest_dir())
    case: CanvasCase.new(repo, name)
    port: free_port()
    server := DevServer.start(repo, case.dir, case.entry, port, target_independent, program_target)
    if case.big_fixture != none -> assert_big_fixture_preflight(repo, case, port)
    session: CANVAS_SESSIONS.get_or_init(() -> Mutex.new({})).lock().unwrap().get(port).cloned().expect("Canvas server session secret")
    home: env.var("HOME").unwrap()
    command := canvas_harness(repo, "scenario")
    command.envs(environment.iter().copied()).env("TMPDIR", "{home}/.cache/jet-test-scratch")
        .env("JET_BIN", admitted_tool("JET", "jet")).env("JETPACK_BIN", admitted_tool("JETPACK", "jetpack"))
        .arg("--scenario").arg(name).arg("--browser").arg(browser).arg("--port").arg(port.to_string())
        .arg("--session").arg(session).arg("--out-dir").arg(case.screenshots).arg("--seed").arg("373")
    if program_target != none -> command.arg("--program-target").arg(program_target.unwrap())
    output: command.output().expect("run Canvas scenario driver")
    server_exit: server.child.try_wait().expect("poll Canvas devserver after browser load")
    server_log: server.stop()
    if !output.status.success() -> panic("Canvas scenario `{name}` failed\n\n--- driver stdout ---\n{String.from_utf8_lossy(output.stdout)}\n--- driver stderr ---\n{String.from_utf8_lossy(output.stderr)}\n--- jet dev ---\n{server_log}")
    assert(server_exit == none, "Canvas devserver exited after the real browser loaded its projection: {server_exit}\n\n--- jet dev ---\n{server_log}")
    eprintln("{String.from_utf8_lossy(output.stdout)}")
}
// The admitted compiler or package manager: the binary named by `variable`
// ($JET / $JETPACK, as Tools/agent/JetEnv.jet sets them), else `command` on PATH.
admitted_tool: fn(variable: &String, command: &String) -> OSPath {
    bound: env.var_os(variable)
    if bound == none -> OSPath.from(command)
    else -> OSPath.from(bound.unwrap())
}
canvas_tools: fn() -> CanvasTools? {
    CANVAS_TOOLS.get_or_init(() -> {
        strict: env.var_os("JET_CANVAS_PREREQUISITES").as_deref() == "strict"
        chromium: resolve_canvas_tool("chromium", strict)
        CanvasTools{chromium: chromium.move()}
    }).as_ref()
}
gecko_tools: fn() -> GeckoTools Err! {
    GECKO_TOOLS.get_or_init(() -> {
        strict: env.var_os("JET_CANVAS_PREREQUISITES").as_deref() == "strict"
        firefox: resolve_canvas_tool("firefox", strict).ok_or_else(() -> "Gecko smoke needs a valid Firefox executable")
        geckodriver: resolve_canvas_tool("geckodriver", strict).ok_or_else(() -> "Gecko smoke needs a valid geckodriver executable")
        GeckoTools{firefox: firefox.move(), geckodriver: geckodriver}
    }).as_ref().map_err(error -> error.as_str())
}
resolve_canvas_tool: fn(name: String, strict: Bool) -> OSPath? {
    resolved_key: "JET_CANVAS_{name.to_ascii_uppercase()}_RESOLVED"
    override_key: "JET_CANVAS_{name.to_ascii_uppercase()}"
    candidate: (if strict -> env.var_os(resolved_key) else -> env.var_os(override_key).or_else(() -> name.into()))
    path: resolve_executable(OSPath.from(candidate))
    output: Command.new(path).arg("--version").output().ok()
    version: "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}"
    valid: if name == {
        "chromium" -> version.contains("Chromium") || version.contains("Chrome")
        "firefox" -> version.contains("Firefox")
        "geckodriver" -> version.starts_with("geckodriver")
        else -> false
    }
    if valid -> path.move() else -> none
}
resolve_executable: fn(candidate: OSPath) -> OSPath? {
    if candidate.components().count() > 1 {
        return if candidate.is_file() -> candidate.to_path_buf() else -> none
    }
    env.split_paths(env.var_os("PATH")?).map(dir -> dir.join(candidate)).find(path -> path.is_file())
}

CanvasCase: struct {
    dir: OSPath
    entry: OSPath
    screenshots: OSPath
    big_fixture: BigFixtureFacts?
    new: fn(repo: OSPath, name: String) -> CanvasCase {
        root: env.var("JET_VERIFY_TMPDIR").map(value -> OSPath.from(value)).unwrap_or_else(_ -> env.temp_dir().join("jet-test-tmp"))
        serial: NEXT_CANVAS_CASE.fetch_add(1, Ordering.Relaxed)
        normalized_name: name.replace('-', "_")
        dir: root.join("canvas_scenario_{normalized_name}_{process.id()}_{serial}")
        _: fs.remove_dir_all(dir)
        fs.create_dir_all(dir).expect("create Canvas scenario dir")
        matrix: name == SESSION_SURFACE_MATRIX_SCENARIO || name == WORKBENCH_E2E_SCENARIO
        entry: if matrix -> dir.join("run.jet") else -> dir.join("main.jet")
        big_fixture: if name == BIG_PROJECT_SCENARIO -> write_big_fixture(dir)
        else if name == "canvas-onboarding-tour" {
            fs.copy(repo.join("Examples/Tooling/CanvasBlueprintDemo.jet"), entry).expect("copy Canvas onboarding example source")
            none
        } else if name == DEVSERVER_REAL_CLIENT_SCENARIO {
            fs.copy(repo.join("Examples/Apps/Web/UIShowcase.jet"), entry).expect("copy Canvas devserver regression source")
            none
        } else if matrix {
            fs.write(dir.join("package.jet"), "name: \"canvas_session_matrix\"\nversion: \"0.1.0\"\noutputs: {{\n    cli: .Executable{{ name: \"cli\", entry: run }}\n    service: .Service{{ name: \"service\", entry: serve }}\n    web: .Executable{{ name: \"web\", entry: web }}\n    ui: .Executable{{ name: \"ui\", entry: ui }}\n    game: .Executable{{ name: \"game\", entry: game }}\n    library: .Library{{ name: \"library\", entry: run }}\n    build: .Check{{ name: \"build\", entry: build }}\n}}\ndefaults: {{ run: cli }}\n").expect("write Canvas session matrix package fixture")
            fs.write(dir.join("env.jet"), "env.dev: module {{\n    prompt: \"canvas-session-matrix\",\n    services: {{ custom_server: {{ enable: false, ports: [43817], run: [\"node\", \"custom-server.mjs\"], ready: \"custom-server-ready\" }}, canvas_service: {{ enable: true, run: [\"node\", \"--eval\", \"console.log('canvas-service-ready'); setInterval(() -> {{{{}}}}, 1000);\"] }} }},\n}}\n").expect("write Canvas session matrix environment fixture")
            fs.write(dir.join("custom-server.mjs"), "import http from \"node:http\";\nconst server = http.createServer((request, response) -> {{\n    response.setHeader(\"content-type\", \"text/plain\");\n    response.end(request.url === \"/health\" ? \"custom-server-ready\" : \"custom-server\");\n}});\nserver.listen(43817, \"127.0.0.1\", () => console.log(\"custom-server-ready\"));\nprocess.on(\"SIGTERM\", () => server.close(() => process.exit(0)));\n").expect("write Canvas custom server fixture")
            fs.write(entry, "use io: core.term\n\nrun: fn() {{ io.print(\"cli\") }}\nserve: fn() {{ io.print(\"service\") }}\nweb: fn() {{ io.print(\"web\") }}\nui: fn() {{ io.print(\"ui\") }}\ngame: fn() {{ io.print(\"game\") }}\n\nbuild: fn(b: Build) {{\n}}\n").expect("write Canvas session matrix source fixture")
            none
        } else {
            if name == "library-panel" || name == "library-panel-events" {
                fs.write(dir.join("package.jet"), "name: \"canvas_library\"\nversion: \"0.1.0\"\n").expect("write Canvas library package fixture")
            }
            if name == "library-panel-events" {
                fs.copy(repo.join("Examples/Apps/UI/Events.jet"), entry).expect("copy Canvas library events source")
            } else {
                source: if name == "debug-breakpoints-run-control-gestures" || name == "debug-runtime-values-staleness-liveness" -> DEBUG_DEMO
                    else if name.starts_with("canvas-rad-callback-") || name == "canvas-rad-handler-navigation" -> CALLBACK_DEMO
                    else -> DEMO
                fs.write(entry, source).expect("write Canvas scenario source")
                if name == "events-panel-authoring" -> fs.write(dir.join("events.jet"), EVENTS_PANEL_SOURCE).expect("write Canvas events source fixture")
            }
            none
        }
        screenshots: dir.join("screenshots")
        fs.create_dir_all(screenshots).expect("create Canvas screenshot dir")
        CanvasCase{dir: dir.move(), entry: entry, screenshots: screenshots, big_fixture: big_fixture.move()}
    }
    drop: fn(&self) {
        if fs.remove_dir_all(self.dir) == {
            .Err(err) -> if err.kind() != ErrorKind.NotFound -> eprintln("warning: could not remove Canvas scenario artifacts at {self.dir.display()}: {err}")
            .Ok(_) -> {}
        }
    }
}

DevServer: struct {
    child: Child
    start: fn(repo: OSPath, cwd: OSPath, entry: OSPath, port: U16, target_independent: Bool, program_target: String?) -> DevServer {
        jet: admitted_tool("JET", "jet")
        command := if cwd.join("env.jet").is_file() {
            command := Command.new(admitted_tool("JETPACK", "jetpack"))
            command.current_dir(cwd).env("JET_ROOT", cwd).args(["env", "-y", "--"]).arg(jet)
            command.move()
        } else -> Command.new(jet)
        command.current_dir(cwd).arg("dev").arg(entry)
        if target_independent {
            command.arg("--canvas").arg("--canvas-port={port}")
            if program_target != none -> command.arg("--target={program_target.unwrap()}")
        } else {
            command.arg("--canvas").arg("--target=web").arg("--canvas-port={port}")
        }
        child := command.stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start jet dev Canvas server")
        stdout: child.stdout.take()
        if stdout != none {
            thread.spawn(() -> {
                loop line in BufReader.new(stdout.unwrap()).lines().map_while(result -> result.ok()) {
                    url: line.split("Canvas: ").nth(1)
                    if url == none -> next
                    port: url.unwrap().split("http://127.0.0.1:").nth(1)
                        .or_else(() -> url.unwrap().split("http://localhost:").nth(1))
                        .and_then(rest -> rest.split(c -> !c.is_ascii_digit()).next())
                        .and_then(value -> value.parse<U16>().ok())
                    if port == none -> next
                    token: url.unwrap().split("session=").nth(1).map(value -> value.split(c -> !c.is_ascii_hexdigit()).next().unwrap_or_default().to_string())
                    if token == none -> next
                    if token.unwrap().len() >= 32 -> CANVAS_SESSIONS.get_or_init(() -> Mutex.new({})).lock().unwrap().insert(port.unwrap(), token.unwrap())
                }
            })
        }
        wait_for_server(child, port)
        DevServer{child: child.move()}
    }
    stop: fn(&self) -> String {
        stop_process_tree(self.child)
        out := String.new()
        stdout := self.child.stdout.take()
        if stdout != none -> _: stdout.unwrap().read_to_string(out)
        stderr := self.child.stderr.take()
        if stderr != none {
            err := String.new()
            _: stderr.unwrap().read_to_string(err)
            out.push_str(err)
        }
        out.move()
    }
    drop: fn(&self) { stop_process_tree(self.child) }
}
stop_process_tree: fn(child: &Child) {
    if core.sys.target.selected_family() == "unix" -> stop_process_tree_unix(child.id()) else -> _: child.kill()
    _: child.wait()
}
stop_process_tree_unix: fn(pid: U32) {
    children_path: "/proc/{pid}/task/{pid}/children"
    if fs.read_to_string(children_path) == {
        .Ok(children) -> loop child in children.split_whitespace().filter_map(value -> value.parse<U32>().ok()) -> stop_process_tree_unix(child)
        .Err(_) -> {}
    }
    _: Command.new("kill").args(["-KILL", pid.to_string()]).status()
}
wait_for_server: fn(child: &Child, port: U16) {
    start: Instant.now()
    loop start.elapsed() < Duration.from_secs(30) {
        status: child.try_wait().expect("poll jet dev")
        if status != none -> panic("jet dev exited before serving Canvas: {status.unwrap()}")
        if http_ok(port, "/__jet_dev_status") {
            if CANVAS_SESSIONS.get_or_init(() -> Mutex.new({})).lock().unwrap().contains_key(port) -> return
        }
        thread.sleep(Duration.from_millis(80))
    }
    panic("timed out waiting for jet dev on port {port}")
}
http_ok: fn(port: U16, path: &String) -> Bool {
    stream := if TcpStream.connect((_0: "127.0.0.1", _1: port)) == {
        .Ok(stream) -> stream.move()
        .Err(_) -> { return false }
    }
    authorization: CANVAS_SESSIONS.get_or_init(() -> Mutex.new({})).lock().unwrap().get(port)
        .map(token -> "Authorization: Bearer {token}{Char{13}}\n").unwrap_or_default()
    request: "GET {path} HTTP/1.1{Char{13}}\nHost: 127.0.0.1:{port}{Char{13}}\nOrigin: http://127.0.0.1:{port}{Char{13}}\n{authorization}Connection: close{Char{13}}\n{Char{13}}\n"
    if stream.write_all(request.as_bytes()).is_err() -> return false
    response := String.new()
    if stream.read_to_string(response).is_err() -> return false
    response.starts_with("HTTP/1.1 200")
}
http_body: fn(port: U16, path: &String) -> String {
    stream := TcpStream.connect((_0: "127.0.0.1", _1: port)).expect("connect to Jet Canvas server")
    authorization: CANVAS_SESSIONS.get_or_init(() -> Mutex.new({})).lock().unwrap().get(port)
        .map(token -> "Authorization: Bearer {token}{Char{13}}\n").unwrap_or_default()
    request: "GET {path} HTTP/1.1{Char{13}}\nHost: 127.0.0.1:{port}{Char{13}}\nOrigin: http://127.0.0.1:{port}{Char{13}}\n{authorization}Connection: close{Char{13}}\n{Char{13}}\n"
    stream.write_all(request.as_bytes()).expect("request Jet Canvas preflight body")
    response := String.new()
    stream.read_to_string(response).expect("read Jet Canvas preflight body")
    assert(response.starts_with("HTTP/1.1 200"), "Jet Canvas preflight failed: {response}")
    response.split_once("{Char{13}}\n{Char{13}}\n").map((_, body) -> body.to_string()).expect("Jet Canvas response missing body separator")
}
free_port: fn() -> U16 {
    TcpListener.bind((_0: "127.0.0.1", _1: 0)).expect("bind free local port").local_addr().expect("local addr").port()
}
