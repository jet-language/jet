// Rust: tests/canvas_scenarios.rs:267
struct CanvasBrowserPermit {
    // Rust: tests/canvas_scenarios.rs:270
    fn acquire() -> CanvasBrowserPermit {
        (available, wake) :: CANVAS_BROWSER_POOL.get_or_init(() -> (Mutex.new(MAX_CANVAS_BROWSERS), Condvar.new()))
        available := available.lock().expect("Canvas browser permit lock poisoned")
        loop available.deref() == 0 {
            available = wake.wait(^available).expect("Canvas browser permit lock poisoned")
        }
        available.deref_mut() -= 1
        CanvasBrowserPermit{}
    }
    // Rust: tests/canvas_scenarios.rs:287
    fn drop(&self) -> {
        (available, wake) :: CANVAS_BROWSER_POOL.get_or_init(() -> (Mutex.new(MAX_CANVAS_BROWSERS), Condvar.new()))
        available.lock().expect("Canvas browser permit lock poisoned").deref_mut() += 1
        wake.notify_one()
    }
}

