fn run_canvas_scenario(name: &String) -> {
    tools :: canvas_tools()
    if tools == none {
        eprintln("ignored: Canvas scenario `{name}` needs dev-shell Chromium and Node")
        return
    }
    run_browser_scenario(name, "chromium", tools.unwrap().node, [("CHROMIUM", tools.unwrap().chromium)])
}
