// Rust: tests/lsp.rs:2633
#Test("lsp_document_symbol_returns_symbols_for_imported_package_module") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    root :: Scratch.new("lsp-document-symbol-imported")
    fs.create_dir_all(root.join("app")).expect("create imported symbol module directory")
    fs.create_dir_all(root.join("src")).expect("create imported symbol root directory")
    fs.write(root.join("package.jet"), "name: \"lsp-symbols\"\nversion: \"0.1.0\"\n").expect("write imported symbol package manifest")
    main_path :: root.join("src/main.jet")
    imported_path :: root.join("app/plan.jet")
    main_source :: "use app.plan\nfn run() {{}}\n"
    imported_source :: "struct ImportedPlan {{ value: Int }}\nfn imported_helper(value: Int) -> Int {{\n    return value\n}}\n"
    fs.write(main_path, main_source).expect("write imported symbol root module")
    fs.write(imported_path, imported_source).expect("write imported symbol module")
    main_uri :: "file://{main_path.display()}"
    imported_uri :: "file://{imported_path.display()}"
    root_uri :: "file://{root.path.display()}"
    child := Command.new(jet).args(["self", "lsp"]).current_dir(root.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp for imported symbols")
    stdin := child.stdin.take().expect("imported symbols stdin")
    stdout := child.stdout.take().expect("imported symbols stdout")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"rootUri\":\"{root_uri}\",\"capabilities\":{{}}}}}}")
    initialize :: read_msg(&stdout)
    assert(initialize.contains("documentSymbolProvider"), "initialize must advertise document symbols: {initialize}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{main_uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(main_source)}}}}}}}")
    main_diagnostics :: read_msg(&stdout)
    assert(main_diagnostics.contains("publishDiagnostics"), "main module open must publish diagnostics: {main_diagnostics}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{imported_uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(imported_source)}}}}}}}")
    imported_diagnostics :: read_msg(&stdout)
    assert(imported_diagnostics.contains("publishDiagnostics"), "imported module open must publish diagnostics: {imported_diagnostics}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentSymbol\",\"params\":{{\"textDocument\":{{\"uri\":\"{imported_uri}\"}}}}}}")
    symbols :: read_msg(&stdout)
    assert(symbols.contains("\"result\":["), "documentSymbol must return an array: {symbols}")
    assert(symbols.contains("\"name\":\"ImportedPlan\""), "imported module symbols must include ImportedPlan: {symbols}")
    assert(symbols.contains("\"kind\":23"), "imported module symbols must classify structs: {symbols}")
    assert(symbols.contains("\"name\":\"imported_helper\""), "imported module symbols must include imported_helper: {symbols}")
    assert(symbols.contains("\"kind\":12"), "imported module symbols must classify functions: {symbols}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}")
    shutdown :: read_msg(&stdout)
    assert(shutdown.contains("\"result\""), "shutdown must return a result: {shutdown}")
    drop(^stdin)
    _ :: child.wait()
}

