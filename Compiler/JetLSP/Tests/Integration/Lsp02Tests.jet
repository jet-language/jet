// Rust: tests/lsp.rs:2302
#Test("lsp_completion_uses_local_discovery_index_for_packages_and_options") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    root :: env.temp_dir().join("lsp_discovery_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create discovery fixture dir")
    index := Discovery.Index.default()
    index.add_package(Discovery.PackageRecord {
        source: "default", name: "postgres_16", reference: "postgres_16@default", version: "16.4",
        platforms: ["linux"], docs: "Postgres fixture from local discovery index", provenance: "test",
        tier: "not-registry", gate_status: "not-applicable",
        options: [
            Discovery.OptionField { name: "ready", default: "process/port probe", docs: "Command polled until ready." },
            Discovery.OptionField { name: "data_dir", default: ".jet/services/db/data", docs: "Persisted state directory." }
        ]
    })
    Discovery.write(root, index).expect("write local discovery index")
    path :: root.join("main.jet")
    uri :: "file://{path.display()}"
    source :: "module env.dev {{\n    env.dev: Env{{\n        packages: [default.postgres_16]\n        services: {{ db: Service{{ re }}, configured: Service{{ ready: false }} }}\n    }}\n}}\n"
    fs.write(path, source).expect("write LSP source")
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}")
    init :: read_msg(&stdout)
    assert(init.contains("completionProvider"), "init: {init}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    open :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}"
    send_msg(&stdin, open)
    _ :: read_msg(&stdout)
    package_offset :: source.find("default.post").unwrap() + "default.post".len()
    package_pos :: LSP.byte_offset_to_lsp(source, package_offset)
    package_req :: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/completion\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{package_pos.line},\"character\":{package_pos.character}}}}}}}"
    send_msg(&stdin, package_req)
    package_resp :: read_msg(&stdout)
    assert(package_resp.contains("postgres_16") && package_resp.contains("package from default"), "package discovery completion missing: {package_resp}")
    option_offset :: source.find("Service{{ re").unwrap() + "Service{{ re".len()
    option_pos :: LSP.byte_offset_to_lsp(source, option_offset)
    option_req :: "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/completion\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{option_pos.line},\"character\":{option_pos.character}}}}}}}"
    send_msg(&stdin, option_req)
    option_resp :: read_msg(&stdout)
    assert(option_resp.contains("\"ready\"") && option_resp.contains("Command polled until ready."), "option discovery completion missing: {option_resp}")
    package_hover_offset :: source.find("default.postgres_16").unwrap() + "default.po".len()
    package_hover_pos :: LSP.byte_offset_to_lsp(source, package_hover_offset)
    package_hover_req :: "{{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{package_hover_pos.line},\"character\":{package_hover_pos.character}}}}}}}"
    send_msg(&stdin, package_hover_req)
    package_hover_resp :: read_msg(&stdout)
    assert(package_hover_resp.contains("postgres_16") && package_hover_resp.contains("16.4") && package_hover_resp.contains("maintainer liveness: not-applicable"), "package discovery hover missing: {package_hover_resp}")
    option_hover_offset :: source.find("ready: false").unwrap() + "rea".len()
    option_hover_pos :: LSP.byte_offset_to_lsp(source, option_hover_offset)
    option_hover_req :: "{{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{option_hover_pos.line},\"character\":{option_hover_pos.character}}}}}}}"
    send_msg(&stdin, option_hover_req)
    option_hover_resp :: read_msg(&stdout)
    assert(option_hover_resp.contains("Environment option `ready`") && option_hover_resp.contains("Command polled until ready."), "option discovery hover missing: {option_hover_resp}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}")
    _ :: read_msg(&stdout)
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":{{}}}}")
    drop(^stdin)
    _ :: child.wait()
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/lsp.rs:2444
#Test("lsp_document_links_and_code_lenses") {
    jet :: jet_bin()
    if !jet.exists() -> return
    root :: env.temp_dir().join("lsp_links_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root.join("app")).expect("create LSP link dirs")
    fs.create_dir_all(root.join("src")).expect("create LSP source dirs")
    fs.write(root.join("app/store.jet"), "fn run() {{}}\n").expect("write link target")
    path :: root.join("src/main.jet")
    uri :: "file://{path.display()}"
    root_uri :: "file://{root.display()}"
    target_uri :: "file://{root.join("app/store.jet").display()}"
    source :: "use app.store\n\nfn run() {{\n    print(1)\n}}\n\n#Test(\"smoke\") {{\n    expect(1 == 1)\n}}\n"
    fs.write(path, source).expect("write link source")
    run_transcript(source, [
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"rootUri\":\"{root_uri}\",\"capabilities\":{{}}}}}}", expect_contains: ["documentLinkProvider", "codeLensProvider"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
        TranscriptStep.Open { uri: uri, expect_notification: true },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentLink\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}", expect_contains: ["\"target\"", target_uri, "\"start\":{{\"line\":0,\"character\":4}}"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"workspace/symbol\",\"params\":{{\"query\":\"run\"}}}}", expect_contains: ["\"location\"", target_uri] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/codeLens\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}", expect_contains: ["\"title\":\"Run file\"", "\"command\":\"jet.runFile\"", "\"title\":\"Run test\"", "\"command\":\"jet.testFile\""] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
    ])
    _ :: fs.remove_dir_all(root)
}

