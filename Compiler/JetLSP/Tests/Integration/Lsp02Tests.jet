        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/signatureHelp\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{timeout_position.line},\"character\":{timeout_position.character}}}}}}}", expect_contains: ["\"activeParameter\":1", "timeout seconds: Int"] },
