// Rust: tests/lsp.rs:3230
#Test("lsp_overlapping_edits_latest_checked_revision_wins") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    COSTLY_CALLERS :: 256
    source_for :: (marker: &String) -> {
        source := "fn target(value: Int) -> Int {{ return value }}\nfn {marker}() -> Int {{ return target(1) }}\n"
        loop index in 0..COSTLY_CALLERS {
            source.push_str("fn caller_{index}() Int {{ return target({index}) }}\n")
        }
        ^source
    }
    source_v1 :: source_for("marker_one")
    uri :: "file:///tmp/lsp_overlapping_revision_test.jet"
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}")
    initialize :: read_msg(&stdout)
    assert(initialize.contains("documentSymbolProvider"), "document symbols are the costly existing request used by this fixture: {initialize}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":10,\"text\":{json_string(source_v1)}}}}}}}")
    opened :: read_msg(&stdout)
    assert(opened.contains("publishDiagnostics") && opened.contains("\"version\":10"), "open must publish the checked base revision: {opened}")
    // Queue the checked/indexed request before overlapping edits; no timing assumption.
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentSymbol\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}")
    edit :: (version: I32, marker: &String) -> {
        "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":{version}}},\"contentChanges\":[{{\"range\":{{\"start\":{{\"line\":1,\"character\":3}},\"end\":{{\"line\":1,\"character\":13}}}},\"rangeLength\":10,\"text\":\"{marker}\"}}]}}}}"
    }
    send_msg(&stdin, edit(11, "marker_two"))
    send_msg(&stdin, edit(12, "marker_new"))
    // Revision 11 must not roll back revision 12.
    send_msg(&stdin, edit(11, "marker_stale"))
    superseded :: read_msg(&stdout)
    assert(superseded.contains("\"id\":2") && superseded.contains("marker_one") && !superseded.contains("marker_new"), "the costly request must describe only its checked base revision: {superseded}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/documentSymbol\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}")
    latest_diagnostics :: read_msg(&stdout)
    assert(latest_diagnostics.contains("publishDiagnostics") && latest_diagnostics.contains("\"version\":12"), "latest diagnostics must identify the winning checked revision: {latest_diagnostics}")
    latest_symbols :: read_msg(&stdout)
    assert(latest_symbols.contains("\"id\":3") && latest_symbols.contains("marker_new") && !latest_symbols.contains("marker_two") && !latest_symbols.contains("marker_stale"), "stale work must be refused and the latest edit must win: {latest_symbols}")
    // Late cancellation releases the completed request before id reuse.
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{{\"id\":3}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/documentSymbol\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}")
    reused :: read_msg(&stdout)
    assert(reused.contains("\"id\":3") && reused.contains("marker_new") && !reused.contains("\"code\":-32800"), "late cancellation must be released before request-id reuse: {reused}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}")
    shutdown :: read_msg(&stdout)
    assert(shutdown.contains("\"id\":99") && shutdown.contains("result"))
    drop(^stdin)
    _ :: child.wait()
}

// Rust: tests/lsp.rs:3376
// #3196: an imported sibling edit re-checks the importer, not unrelated documents.
#Test("lsp_sibling_import_edit_never_publishes_stale_verdict") {
    _guard :: lock_lsp_process()
    root :: Scratch.new("lsp-sibling-import")
    fs.write(root.join("package.jet"), "name: \"sibling\"\nversion: \"0.1.0\"\n").unwrap()
    helper_int :: "pub fn value() -> Int {{ return 1 }}\n"
    helper_text :: "pub fn value() -> String {{ return \"one\" }}\n"
    main :: "use \"helper\"\nfn run() {{ print(helper.value() + 1) }}\n"
    other :: "fn run() {{ print(2) }}\n"
    fs.write(root.join("helper.jet"), helper_int).unwrap()
    fs.write(root.join("run.jet"), main).unwrap()
    fs.write(root.join("other.jet"), other).unwrap()
    file_uri :: (name: &String) -> "file://{root.join(name).display()}".replace('%', "%25").replace(' ', "%20")
    (helper_uri, main_uri, other_uri) :: (file_uri("helper.jet"), file_uri("run.jet"), file_uri("other.jet"))
    child := Command.new(jet_bin()).args(["self", "lsp"]).current_dir(root.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    _ :: request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")
    loop (uri, source) in [(helper_uri, helper_int), (main_uri, main), (other_uri, other)] {
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
    }
    symbols :: (uri: &String) -> "{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}"
    (_, opened) :: request_lsp_collect(&stdin, &stdout, 2, "textDocument/documentSymbol", symbols(other_uri))
    main_opened :: published_diagnostics_for(opened, main_uri)
    assert_eq(main_opened.len(), 1, "open publishes the importer once: {opened:?}")
    assert_eq(error_count(main_opened[0]), 0, "Int helper checks clean: {opened:?}")
    change :: (version: I32, text: &String) -> {
        "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{helper_uri}\",\"version\":{version}}},\"contentChanges\":[{{\"text\":{json_string(text)}}}]}}}}"
    }
    // Only the sibling changes; its importer must follow.
    send_msg(&stdin, change(2, helper_text))
    (_, broke) :: request_lsp_collect(&stdin, &stdout, 3, "textDocument/documentSymbol", symbols(helper_uri))
    main_broke :: published_diagnostics_for(broke, main_uri)
    assert_eq(main_broke.len(), 1, "a sibling edit re-checks its importer: {broke:?}")
    assert(error_count(main_broke[0]) > 0, "`String + 1` through the edited sibling is an error: {broke:?}")
    assert(published_diagnostics_for(broke, other_uri).is_empty(), "a document that reads nothing edited is not re-checked: {broke:?}")
    // Rapid revisions 3 and 4 flush exactly one importer verdict for the newest.
    send_msg(&stdin, change(3, helper_text))
    send_msg(&stdin, change(4, helper_int))
    (_, repaired) :: request_lsp_collect(&stdin, &stdout, 4, "textDocument/documentSymbol", symbols(helper_uri))
    main_repaired :: published_diagnostics_for(repaired, main_uri)
    assert_eq(main_repaired.len(), 1, "one importer verdict per flush: {repaired:?}")
    assert_eq(error_count(main_repaired[0]), 0, "the importer verdict reflects sibling revision 4: {repaired:?}")
    helper_published :: published_diagnostics_for(repaired, helper_uri)
    assert(helper_published.iter().all(params -> json_get(params, "version") == DataTree.Int(4)), "sibling reports carry only its newest revision: {repaired:?}")
    assert(published_diagnostics_for(repaired, other_uri).is_empty(), "{repaired:?}")
    _ :: request_lsp(&stdin, &stdout, 99, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}

// Rust: tests/lsp.rs:3483
// #3196: suppress the cancelled response without preempting computation.
#Test("lsp_cancelled_costly_request_returns_32800_and_never_publishes") {
    _guard :: lock_lsp_process()
    child := Command.new(jet_bin()).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    uri :: "file:///tmp/lsp_cancelled_costly_request.jet"
    _ :: request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(costly_source("marker_old", 1024))}}}}}}}")
    opened :: read_msg(&stdout)
    assert(opened.contains("publishDiagnostics") && opened.contains("\"version\":1"), "open publishes its base revision: {opened}")
    // Full-text edit queues a costly re-check before the request and cancellation.
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":2}},\"contentChanges\":[{{\"text\":{json_string(costly_source("marker_new", 1024))}}}]}}}}")
    symbols :: "{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}"
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":50,\"method\":\"textDocument/documentSymbol\",\"params\":{symbols}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{{\"id\":50}}}}")
    before := [DataTree]()
    cancelled :: loop {
        message :: parse_json(read_msg(&stdout)).expect("valid LSP message")
        if json_get(message, "id") == DataTree.Int(50) -> break ^message
        before.push(^message)
    }
    error :: json_object_field(cancelled, "error")
    assert_json_values_equal("cancel code", json_object_field(error, "code"), DataTree.Int(-32800))
    assert(json_get(cancelled, "result").is_none(), "{cancelled:?}")
    loop published in published_diagnostics_for(before, uri) {
        assert_json_values_equal("flushed revision", json_object_field(published, "version"), DataTree.Int(2))
    }
    (current, after) :: request_lsp_collect(&stdin, &stdout, 51, "textDocument/documentSymbol", symbols)
    assert(after.iter().all(message -> json_get(message, "id") != DataTree.Int(50)), "cancelled request 50 must never answer again: {after:?}")
    current_text :: "{current:?}"
    assert(current_text.contains("marker_new") && !current_text.contains("marker_old"), "the next request sees the newest revision: {current_text}")
    _ :: request_lsp(&stdin, &stdout, 99, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}
