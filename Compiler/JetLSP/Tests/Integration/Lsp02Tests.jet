// Rust: tests/lsp.rs:1783
#Test("lsp_on_type_formatting_returns_brace_edits") {
    jet :: jet_bin()
    if !jet.exists() -> return
    cases :: [
        ("fn run() {{\n statement }}\n", 1, 0, "\"\\n\"", ["\"newText\":\"    \"", "\"newText\":\"\\n\""]),
        ("fn run() {{\n}}\n", 1, 0, "\"\\n\"", ["\"newText\":\"    \""]),
        ("fn run() {{\n    if ok {{\n value }}\n}}\n", 2, 0, "\"\\n\"", ["\"newText\":\"        \"", "\"newText\":\"\\n    \""]),
        ("fn run() {{\n    value\n        }}\n", 2, 9, "\"}}\"", ["\"newText\":\"\""]),
        ("fn run() {{\n value\n", 1, 0, "\"\\n\"", ["\"result\":[]"]),
        ("fn run() {{\r\n café }}\r\n", 1, 0, "\"\\n\"", ["\"newText\":\"    \"", "\"newText\":\"\\r\\n\""]),
        ("fn run() {{ /* {{\nvalue }} */ }}\n", 1, 0, "\"\\n\"", ["\"result\":[]"]),
        ("fn run() {{ SQL{{\n\"value\"}} }}\n", 1, 0, "\"\\n\"", ["\"result\":[]"]),
        ("// }}\n", 0, 4, "\"}}\"", ["\"result\":[]"])
    ]
    loop (index, (source, line, character, trigger, expected)) in cases.into_iter().enumerate() {
        uri :: "file:///tmp/lsp_on_type_formatting_test_{index}.jet"
        run_transcript(source, [
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: if index == 0 -> ["documentOnTypeFormattingProvider", "moreTriggerCharacter"] else -> [] },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
            TranscriptStep.Open { uri: uri, expect_notification: true },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/onTypeFormatting\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{line},\"character\":{character}}},\"ch\":{trigger},\"options\":{{\"tabSize\":4,\"insertSpaces\":true}}}}}}", expect_contains: expected },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
        ])
    }
}

