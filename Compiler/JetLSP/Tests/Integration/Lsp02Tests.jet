        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: ["executeCommandProvider"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
        TranscriptStep.Open { uri: uri, expect_notification: true },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"workspace/executeCommand\",\"params\":{{\"command\":\"jet.impact\",\"arguments\":[\"{uri}\",\"add\",2]}}}}", expect_contains: ["\"symbol\":\"add\"", "\"found\":true", "\"upstream_callers\""] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
    ])
}

// Rust: tests/lsp.rs:1935
#Test("lsp_budget_reports_projects_canonical_report_without_measuring") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    root :: env.temp_dir().join("lsp_budget_projection_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root.join("src")).unwrap()
    fs.write(root.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    source :: "module perf.package {{\n    budgets: [Budget{{ name: \"api\", scope: .Package, metric: .PublicApiItems, comparison: .Absolute, limit: .AtMost(10) }}]\n}}\npub fn api() {{}}\nfn run() {{}}\n"
    // D-VERDICT-678-1: budget discovery uses canonical run.jet, never main.jet.
    path :: root.join("src/run.jet")
    fs.write(path, source).unwrap()
    measured :: Command.new(jet).args(["budget", "check", "--json"]).current_dir(root).output().unwrap()
    assert_eq(measured.status.code(), 0, "{String.from_utf8_lossy(measured.stderr)}")
    reports :: root.join(".jet/perf/reports")
    before :: fs.read_dir(reports).unwrap().map(entry -> {
        path :: entry.unwrap().path()
        (path, fs.metadata(path).unwrap().modified().unwrap())
    }).collect<[(OSPath, std.time.SystemTime)]>()
    uri :: "file://{path.display()}"
    child := Command.new(jet).args(["self", "lsp"]).current_dir(root).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().unwrap()
    stdin := child.stdin.take().unwrap()
    stdout := child.stdout.take().unwrap()
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}")
    assert(read_msg(&stdout).contains("jet.budgetReports"))
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
    assert(read_msg(&stdout).contains("publishDiagnostics"))
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"workspace/executeCommand\",\"params\":{{\"command\":\"jet.budgetReports\",\"arguments\":[\"{uri}\"]}}}}")
    response :: read_msg(&stdout)
    assert(response.contains("\"mode\":\"read_only\""), "{response}")
    assert(response.contains("\"budget_id\":\"package:api\""), "{response}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}")
    _ :: read_msg(&stdout)
    drop(^stdin)
    _ :: child.wait()
    after :: fs.read_dir(reports).unwrap().map(entry -> {
        path :: entry.unwrap().path()
        (path, fs.metadata(path).unwrap().modified().unwrap())
    }).collect<[(OSPath, std.time.SystemTime)]>()
    assert_eq(before, after, "LSP projection must not rewrite reports")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/lsp.rs:2046
#Test("lsp_c_style_snippet_autocorrects") {
    src :: "fn greet() {{\n    println(\"ok\");\n}}\n\nfn run() {{\n    count :: 1\n    println(\"hi\");\n}}\n"
    diags :: check_document("snippet.jet", src)
    assert(diags.iter().any(d -> d.code == "E0037"), "println -> print")
    assert(diags.iter().all(d -> d.code != "E0008"), "def/func teaching is paused under D-S14-PAUSE")
    edits := diags.iter().filter_map(d -> d.edit.clone()).collect()
    edits.sort_by_key(e -> std.cmp.Reverse(e.span.start))
    fixed := src
    loop edit in edits { fixed = LSP.apply_edit(fixed, edit) }
    assert(!fixed.contains("val count"))
    // E0037 is still a live single-token fix.
    assert(fixed.contains("print("))
    assert(!fixed.contains("println("))
    assert(fixed.contains("fn greet"))
}

