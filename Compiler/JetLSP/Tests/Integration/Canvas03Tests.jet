    fs.write(internal, "module _bench {{ }}\nfn hidden_probe() {{}}\n// changed while skipped\n").unwrap()
    changed :: Canvas.project_json_for_entry(entry)
    assert_ne(changed, skipped, "skipped sources must stay in the watch revision")
    fs.write(entry, "use project._bench\nfn run() {{}}\n").unwrap()
    explicit :: Canvas.project_json_for_entry(entry)
    assert(explicit.contains("\"state\":\"explicit\""), "{explicit}")
    assert_eq(Canvas.project_path_for_source_id(entry, "bench.jet"), Val(internal))
}

