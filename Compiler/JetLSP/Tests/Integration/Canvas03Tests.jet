// Rust: tests/canvas.rs:4896
#Test("canvas_project_transactions_preview_apply_and_conflict_on_touched_files") {
    dir :: temp_dir("project_txn")
    app :: dir.join("packages/app")
    logging :: dir.join("packages/logging")
    fs.create_dir_all(app).unwrap()
    fs.create_dir_all(logging).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: find(\"./packages\")\n}}\n").unwrap()
    fs.write(app.join("package.jet"), "name: \"app\",\nversion: \"0.1.0\"\npackages: {{\n    app: executable,\n}}\n").unwrap()
    fs.write(logging.join("package.jet"), "name: \"logging\"\nversion: \"0.1.0\"\npackages: {{ logging: library }}\n").unwrap()
    entry :: app.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"hi\")\n}}\n").unwrap()
    fs.write(app.join("helper.jet"), "fn helper() -> Int {{\n    return 1\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    manifest_revision :: Canvas.source_revision(fs.read_to_string(app.join("package.jet")).unwrap())
    req :: "{{\"schema_version\":1,\"op\":\"add_dependency\",\"preview\":true,\"project_revision\":\"{project_revision}\",\"files\":[{{\"path\":\"packages/app/package.jet\",\"revision\":\"{manifest_revision}\"}}],\"manifest\":\"packages/app/package.jet\",\"name\":\"logging\",\"spec\":\"../logging\"}}"
    preview :: Canvas.apply_project_transaction_json(entry, req).expect("project transaction preview")
    assert(preview.contains("\"protocol\":\"jet.canvas.project.edit\""), "{preview}")
    assert(preview.contains("\"preview\":true"), "{preview}")
    assert(preview.contains("\"writes\":\"preview_only\""), "{preview}")
    assert(preview.contains("+deps: {{"), "{preview}")
    assert(preview.contains("+    logging: ../logging,"), "{preview}")
    before_apply :: fs.read_to_string(app.join("package.jet")).unwrap()
    assert(!before_apply.contains("logging"), "{before_apply}")
    stale_revision_request :: req.replace(project_revision, "sha256-stale-project")
    stale_project_error :: Canvas.apply_project_transaction_json(entry, stale_revision_request).expect_err("stale project revision must conflict before any write")
    assert(stale_project_error.contains("\"kind\":\"conflict\""), "{stale_project_error}")
    assert_eq(fs.read_to_string(app.join("package.jet")).unwrap(), before_apply, "a stale project revision must not write the manifest")
    fs.write(app.join("helper.jet"), "fn helper() -> Int {{\n    return 2\n}}\n").unwrap()
    apply :: req.replace("\"preview\":true", "\"preview\":false")
    stale_project :: Canvas.apply_project_transaction_json(entry, apply).expect_err("any changed projected file should conflict before writing")
    assert(stale_project.contains("\"kind\":\"conflict\""), "{stale_project}")
    after_stale :: fs.read_to_string(app.join("package.jet")).unwrap()
    assert(!after_stale.contains("logging"), "{after_stale}")
    fresh_project :: Canvas.project_json_for_entry(entry)
    fresh_project_revision :: json_field(fresh_project, "project_revision")
    fresh_manifest :: fs.read_to_string(app.join("package.jet")).unwrap()
    fresh_manifest_revision :: Canvas.source_revision(fresh_manifest)
    fresh_apply :: "{{\"schema_version\":1,\"op\":\"add_dependency\",\"preview\":false,\"project_revision\":\"{fresh_project_revision}\",\"files\":[{{\"path\":\"packages/app/package.jet\",\"revision\":\"{fresh_manifest_revision}\"}}],\"manifest\":\"packages/app/package.jet\",\"name\":\"logging\",\"spec\":\"../logging\"}}"
    applied :: Canvas.apply_project_transaction_json(entry, fresh_apply).expect("fresh project revision should permit apply")
    assert(applied.contains("\"preview\":false"), "{applied}")
    assert(applied.contains("\"writes\":\"source_transaction\""), "{applied}")
    after_apply :: fs.read_to_string(app.join("package.jet")).unwrap()
    assert(after_apply.contains("logging: ../logging,"), "{after_apply}")
    assert(PackageFacts.parse(after_apply, "test").is_ok(), "{after_apply}")
    current_project :: Canvas.project_json_for_entry(entry)
    current_project_revision :: json_field(current_project, "project_revision")
    stale_touched :: "{{\"schema_version\":1,\"op\":\"add_dependency\",\"preview\":false,\"project_revision\":\"{current_project_revision}\",\"files\":[{{\"path\":\"packages/app/package.jet\",\"revision\":\"{manifest_revision}\"}}],\"manifest\":\"packages/app/package.jet\",\"name\":\"extra\",\"spec\":\"0.2.0\"}}"
    err :: Canvas.apply_project_transaction_json(entry, stale_touched).expect_err("stale touched file should conflict")
    assert(err.contains("\"kind\":\"conflict\""), "{err}")
    assert(!fs.read_to_string(app.join("package.jet")).unwrap().contains("extra"))
}

