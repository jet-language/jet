#Test("canvas_project_transactions_reject_reserved_create_package_path") {
    dir :: temp_dir("project_reserved_path")
    fs.create_dir_all(dir.join("packages/app")).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: [\"./packages/app\"]\n}}\n").unwrap()
    fs.write(dir.join("packages/app/package.jet"), "name: \"app\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n").unwrap()
    entry :: dir.join("packages/app/main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    req :: "{{\"schema_version\":1,\"op\":\"create_package\",\"preview\":false,\"project_revision\":\"{project_revision}\",\"package_path\":\".git/hooks\",\"files\":[{{\"path\":\".git/hooks/package.jet\",\"revision\":\"missing\"}},{{\"path\":\".git/hooks/main.jet\",\"revision\":\"missing\"}}],\"name\":\"hooks\",\"target\":\"executable\"}}"
    err :: Canvas.apply_project_transaction_json(entry, req).expect_err("reserved path should be rejected")
    assert(err.contains("\"kind\":\"bad_request\""), "{err}")
    assert(!dir.join(".git/hooks/package.jet").exists(), "reserved path write escaped source truth")
}

