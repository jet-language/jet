// Rust: tests/canvas.rs:3762
#Test("canvas_details_editor_facts_and_checked_value_edits") {
    path :: write_fixture("details_editor_facts", "enum Mode {{\n    Fast\n    Slow\n}}\n\nfn edit() {{\n    #Meta(category: \"Tuning\", tunable)\n    amount :: 3\n    other :: 9\n    mode :: Mode.Fast\n    alias :: amount\n    needs_int(amount)\n    print(alias)\n}}\n\nfn needs_int(value: Int) {{}}\n\nfn run() {{\n    edit()\n}}\n")
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    assert(graph.contains("\"enum_variants\":{{\"Mode\":[{{\"name\":\"Fast\",\"source\":\"Mode.Fast\"}},{{\"name\":\"Slow\",\"source\":\"Mode.Slow\"}}]}}"), "{graph}")
    assert(graph.contains("\"title\":\"amount\""), "{graph}")
    assert(graph.contains("\"meta\":{{\"category\":\"Tuning\",\"tunable\":true}}"), "{graph}")
    before :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(before)
    edit_graph :: graph_object_for_title(graph, "edit")
    amount_id :: field_before(edit_graph, "\"source\":\"3\"", "inline_expr_id")
    scalar :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{amount_id}\",\"new_expr\":\"7\"}}"
    Canvas.apply_transaction_json(path, scalar).expect("scalar Details edit")
    after_scalar :: fs.read_to_string(path).unwrap()
    assert(after_scalar.contains("amount :: 7"), "{after_scalar}")
    assert(after_scalar.contains("other :: 9"), "{after_scalar}")
    graph :: Canvas.graph_json_for_file(path).expect("reproject scalar edit")
    revision :: Canvas.source_revision(after_scalar)
    edit_graph :: graph_object_for_title(graph, "edit")
    mode_id :: field_before(edit_graph, "\"source\":\"Mode.Fast\"", "inline_expr_id")
    enum_edit :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{mode_id}\",\"new_expr\":\"Mode.Slow\"}}"
    Canvas.apply_transaction_json(path, enum_edit).expect("enum Details edit")
    after_enum :: fs.read_to_string(path).unwrap()
    assert(after_enum.contains("mode :: Mode.Slow"), "{after_enum}")
    graph :: Canvas.graph_json_for_file(path).expect("reproject enum edit")
    revision :: Canvas.source_revision(after_enum)
    alias_id :: field_before(graph_object_for_title(graph, "edit"), "\"source\":\"amount\"", "inline_expr_id")
    reference_edit :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{alias_id}\",\"new_expr\":\"other\"}}"
    Canvas.apply_transaction_json(path, reference_edit).expect("reference Details edit")
    after_reference :: fs.read_to_string(path).unwrap()
    assert(after_reference.contains("alias :: other"), "{after_reference}")
    graph :: Canvas.graph_json_for_file(path).expect("reproject reference edit")
    revision :: Canvas.source_revision(after_reference)
    amount_id :: field_before(graph_object_for_title(graph, "edit"), "\"source\":\"7\"", "inline_expr_id")
    invalid :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{amount_id}\",\"new_expr\":\"Mode.Slow\"}}"
    err :: Canvas.apply_transaction_json(path, invalid).unwrap_err()
    assert(err.contains("E"), "invalid Details edit lost diagnostic: {err}")
    assert_eq(fs.read_to_string(path).unwrap(), after_reference)
    stale :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{Canvas.source_revision(after_scalar)}\",\"inline_expr_id\":\"{amount_id}\",\"new_expr\":\"8\"}}"
    stale_err :: Canvas.apply_transaction_json(path, stale).unwrap_err()
    assert(stale_err.contains("conflict"), "stale Details edit lost conflict: {stale_err}")
    assert_eq(fs.read_to_string(path).unwrap(), after_reference)
    assert(after_reference.contains("fn edit()"), "scope/provenance lost: {after_reference}")
    assert(after_reference.contains("print(alias)"), "reference consumers lost: {after_reference}")
}

// Rust: tests/canvas.rs:3882
#Test("canvas_details_collection_values_keep_inline_provenance_and_refuse_bad_nested_source") {
    path :: write_fixture("details_collection_editor", "fn edit() {{\n    matrix :: [[1, 2], [3, 4]]\n    settings :: Point{{x: 4, y: [5, 6]}}\n    lookup :: [\"first\": 7, \"second\": 8]\n    print(matrix[0][0])\n}}\n\nstruct Point {{\n    x: Int\n    y: [Int]\n}}\n\nfn run() {{\n    edit()\n}}\n")
    graph :: Canvas.graph_json_for_file(path).expect("collection Details graph")
    edit_graph :: graph_object_for_title(graph, "edit")
    loop source in ["[[1, 2], [3, 4]]", "Point{{x: 4, y: [5, 6]}}", "[\"first\": 7, \"second\": 8]"] {
        encoded :: source.replace('\\', "\\\\").replace('"', "\\\"")
        assert(edit_graph.contains("\"source\":\"{encoded}\""), "collection value lacks one source-backed Details anchor: {source}\n{edit_graph}")
    }
    before :: fs.read_to_string(path).unwrap()
    matrix_id :: field_before(edit_graph, "\"source\":\"[[1, 2], [3, 4]]\"", "inline_expr_id")
    edit :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{Canvas.source_revision(before)}\",\"inline_expr_id\":\"{matrix_id}\",\"new_expr\":\"[[1, 2], [9, 4]]\"}}"
    Canvas.apply_transaction_json(path, edit).expect("nested collection edit")
    changed :: fs.read_to_string(path).unwrap()
    assert(changed.contains("matrix :: [[1, 2], [9, 4]]"), "{changed}")
    graph :: Canvas.graph_json_for_file(path).expect("reproject nested collection")
    matrix_id :: field_before(graph_object_for_title(graph, "edit"), "\"source\":\"[[1, 2], [9, 4]]\"", "inline_expr_id")
    before_invalid :: fs.read_to_string(path).unwrap()
    invalid :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{Canvas.source_revision(before_invalid)}\",\"inline_expr_id\":\"{matrix_id}\",\"new_expr\":\"[[1, 2], [true, 4]]\"}}"
    error :: Canvas.apply_transaction_json(path, invalid).expect_err("bad nested type")
    assert(error.contains("Error [") || error.contains("diagnostic"), "{error}")
    assert_eq(fs.read_to_string(path).unwrap(), before_invalid)
    stale :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"sha256-stale\",\"inline_expr_id\":\"{matrix_id}\",\"new_expr\":\"[[1, 2], [8, 4]]\"}}"
    stale_error :: Canvas.apply_transaction_json(path, stale).expect_err("stale nested edit")
    assert(stale_error.contains("conflict"), "{stale_error}")
    assert_eq(fs.read_to_string(path).unwrap(), before_invalid)
    assert_eq(Formatter.format_source(before_invalid).unwrap(), before_invalid, "nested collection edit must reload in canonical Jet spelling")
}

// Rust: tests/canvas.rs:3966
#Test("canvas_function_transactions_write_source_and_reproject_calls") {
    path :: write_fixture("function_transactions", CANVAS_FIXTURE)
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    square_graph_id :: field_before(graph, "\"title\":\"square\"", "graph_id")
    src :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(src)
    edit_signature :: "{{\"schema_version\":1,\"op\":\"edit_function_signature\",\"revision\":\"{revision}\",\"graph_id\":\"{square_graph_id}\",\"signature\":\"fn square(n: Int{{1}}) -> Int\"}}"
    Canvas.apply_transaction_json(path, edit_signature).expect("edit signature")
    after_signature :: fs.read_to_string(path).unwrap()
    assert(after_signature.contains("fn square(n: Int{{1}}) -> Int"), "{after_signature}")
    revision :: Canvas.source_revision(after_signature)
    rename :: "{{\"schema_version\":1,\"op\":\"rename_function\",\"revision\":\"{revision}\",\"from\":\"square\",\"to\":\"area\"}}"
    Canvas.apply_transaction_json(path, rename).expect("rename function")
    after_rename :: fs.read_to_string(path).unwrap()
    assert(after_rename.contains("fn area(n: Int{{1}}) -> Int"), "{after_rename}")
    assert(after_rename.contains("total := area(limit)"), "{after_rename}")
    graph :: Canvas.graph_json_for_file(path).expect("reproject graph")
    assert(graph.contains("\"title\":\"area\""), "{graph}")
    assert(graph.contains("\"kind\":\"function\",\"archetype\":\"function_pure\",\"title\":\"area\""), "{graph}")
    revision :: Canvas.source_revision(after_rename)
    create :: "{{\"schema_version\":1,\"op\":\"create_function\",\"revision\":\"{revision}\",\"name\":\"helper\",\"params\":\"value: Int\",\"ret_type\":\"Int\"}}"
    Canvas.apply_transaction_json(path, create).expect("create function")
    after_create :: fs.read_to_string(path).unwrap()
    assert(after_create.contains("fn helper(value: Int) -> Int"), "{after_create}")
    assert(after_create.contains("return 1"), "{after_create}")
    graph :: Canvas.graph_json_for_file(path).expect("created graph")
    assert(graph.contains("\"title\":\"helper\""), "{graph}")
}

// Rust: tests/canvas.rs:4023
#Test("canvas_source_control_reports_git_text_diff") {
    dir :: temp_dir("source_control")
    if Command.new("git").arg("--version").output().map((o) -> !o.status.success()).unwrap_or(true) {
        eprintln("note: skipping canvas_source_control_reports_git_text_diff (need git)")
        return
    }
    Command.new("git").args(["init"]).current_dir(dir).output().expect("git init")
    Command.new("git").args(["config", "user.email", "canvas@example.invalid"]).current_dir(dir).output().expect("git config email")
    Command.new("git").args(["config", "user.name", "Canvas Test"]).current_dir(dir).output().expect("git config name")
    path :: dir.join("main.jet")
    fs.write(path, "fn run() {{\n    print(\"old\")\n}}\n").unwrap()
    Command.new("git").args(["add", "main.jet"]).current_dir(dir).output().expect("git add")
    Command.new("git").args(["commit", "-m", "initial"]).current_dir(dir).output().expect("git commit")
    fs.write(path, "fn run() {{\n    print(\"changed\")\n}}\n").unwrap()
    scm :: Canvas.source_control_json_for_file(path)
    assert(scm.contains("\"protocol\":\"jet.canvas.source_control\""), "{scm}")
    assert(scm.contains("\"available\":true"), "{scm}")
    assert(scm.contains("\"dirty\":true"), "{scm}")
    assert(scm.contains("+    print(\\\"changed\\\")"), "{scm}")
    assert(scm.contains("initial"), "{scm}")
}

// Rust: tests/canvas.rs:4075
#Test("canvas_source_control_reports_project_file_set") {
    dir :: temp_dir("source_control_project")
    if Command.new("git").arg("--version").output().map((o) -> !o.status.success()).unwrap_or(true) {
        eprintln("note: skipping canvas_source_control_reports_project_file_set (need git)")
        return
    }
    Command.new("git").args(["init"]).current_dir(dir).output().expect("git init")
    Command.new("git").args(["config", "user.email", "canvas@example.invalid"]).current_dir(dir).output().expect("git config email")
    Command.new("git").args(["config", "user.name", "Canvas Test"]).current_dir(dir).output().expect("git config name")
    fs.write(dir.join("package.jet"), "name: \"canvas_scm\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"old\")\n}}\n").unwrap()
    Command.new("git").args(["add", "package.jet", "main.jet"]).current_dir(dir).output().expect("git add")
    Command.new("git").args(["commit", "-m", "initial"]).current_dir(dir).output().expect("git commit")
    fs.write(entry, "fn run() {{\n    print(\"changed\")\n}}\n").unwrap()
    fs.write(dir.join("helper.jet"), "fn helper() -> Int {{\n    return 7\n}}\n").unwrap()
    scm :: Canvas.source_control_json_for_entry(entry)
    assert(scm.contains("\"protocol\":\"jet.canvas.source_control\""), "{scm}")
    assert(scm.contains("\"project_revision\":\"sha256-"), "{scm}")
    assert(scm.contains("\"available\":true"), "{scm}")
    assert(scm.contains("\"dirty\":true"), "{scm}")
    assert(scm.contains("\"dirty_files\":2"), "{scm}")
    assert(scm.contains("\"files\":["), "{scm}")
    assert(scm.contains("\"path\":\"main.jet\""), "{scm}")
    assert(scm.contains("\"path\":\"helper.jet\""), "{scm}")
    assert(scm.contains("+    print(\\\"changed\\\")"), "{scm}")
    assert(scm.contains("?? helper.jet"), "{scm}")
    assert(scm.contains("+fn helper() -> Int"), "{scm}")
}

// Rust: tests/canvas.rs:4143
#Test("canvas_proof_lens_reports_revision_check_git_and_missing_receipts") {
    dir :: temp_dir("proof_lens")
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"proof\")\n}}\n").unwrap()
    proof :: Canvas.proof_json_for_entry(entry, None).expect("canvas proof")
    src :: fs.read_to_string(entry).unwrap()
    assert(proof.contains("\"protocol\":\"jet.canvas.proof\""), "{proof}")
    assert(proof.contains("\"schema_version\":1"), "{proof}")
    assert(proof.contains("\"revision\":\"{Canvas.source_revision(src)}\""))
    assert(proof.contains("\"check\":{{\"state\":\"ok\""), "{proof}")
    assert(proof.contains("\"source_control\":{{\"truth\":\"git-text\""), "{proof}")
    assert(proof.contains("\"command_receipts\":{{\"state\":\"missing\""), "{proof}")
    assert(proof.contains("no Canvas command authority receipt has run"), "{proof}")
    assert(proof.contains("\"proof\":{{\"state\":\"missing\",\"stale\":true"), "{proof}")
    if Command.new("git").arg("--version").output().map((o) -> !o.status.success()).unwrap_or(true) {
        eprintln("note: skipping canvas proof dirty-git assertion (need git)")
    } else {
        Command.new("git").args(["init"]).current_dir(dir).output().expect("git init")
        Command.new("git").args(["config", "user.email", "canvas@example.invalid"]).current_dir(dir).output().expect("git config email")
        Command.new("git").args(["config", "user.name", "Canvas Test"]).current_dir(dir).output().expect("git config name")
        Command.new("git").args(["add", "main.jet"]).current_dir(dir).output().expect("git add")
        Command.new("git").args(["commit", "-m", "initial"]).current_dir(dir).output().expect("git commit")
        fs.write(entry, "fn run() {{\n    print(\"proof dirty\")\n}}\n").unwrap()
        dirty :: Canvas.proof_json_for_entry(entry, None).expect("dirty proof")
        assert(dirty.contains("\"available\":true"), "{dirty}")
        assert(dirty.contains("\"dirty\":true"), "{dirty}")
    }
    broken :: dir.join("broken.jet")
    fs.write(broken, "fn run() {{\n    missing(\n}}\n").unwrap()
    diagnostic :: Canvas.proof_json_for_entry(broken, None).expect("diagnostic proof")
    assert(diagnostic.contains("\"check\":{{\"state\":\"diagnostic\""), "{diagnostic}")
    assert(diagnostic.contains("\"diagnostics_count\":"), "{diagnostic}")
}

// Rust: tests/canvas.rs:4230
#Test("canvas_proof_projects_canonical_budget_report_read_only") {
    dir :: temp_dir("proof_budget_projection")
    fs.create_dir_all(dir.join("src")).unwrap()
    fs.write(dir.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    // Bare jet budget check resolves canonical run.jet (D-VERDICT-678-1).
    entry :: dir.join("src/run.jet")
    fs.write(entry, "module perf.package {{\n    budgets: [Budget{{\n        name: \"public-api\",\n        scope: .Package,\n        metric: .PublicApiItems,\n        comparison: .Absolute,\n        limit: .AtMost(10),\n    }}],\n}}\npub fn api() {{}}\nfn run() {{}}\n").unwrap()
    out :: Command.new(OSPath(env.var("CARGO_BIN_EXE_jet").unwrap())).current_dir(dir).args(["budget", "check", "--json"]).output().unwrap()
    assert_eq(out.status.code(), Val(0), "{String.from_utf8_lossy(out.stderr)}")
    command :: String.from_utf8(out.stdout).unwrap()
    report_id := command.split("\"report_id\":\"").nth(1).unwrap().split('"').first().unwrap() // #4303
    before :: fs.read_dir(dir.join(".jet/perf/reports")).unwrap().count()
    proof :: Canvas.proof_json_for_entry(entry, None).expect("canvas proof")
    assert(proof.contains("\"budget_reports\":{{\"mode\":\"read_only\""), "{proof}")
    assert(proof.contains("\"budget_id\":\"package:public-api\""), "{proof}")
    assert(proof.contains("\"report_id\":\"{report_id}\""), "{proof}")
    assert_eq(fs.read_dir(dir.join(".jet/perf/reports")).unwrap().count(), before, "Canvas measured or wrote a report")
    fs.write(entry, "{fs.read_to_string(entry).unwrap()}\n// relevant source digest changed\n").unwrap()
    stale :: Canvas.proof_json_for_entry(entry, None).expect("stale canvas proof")
    assert(stale.contains("\"budget_reports\":{{\"mode\":\"read_only\",\"reports\":[]"), "{stale}")
    assert_eq(fs.read_dir(dir.join(".jet/perf/reports")).unwrap().count(), before, "stale Canvas projection refreshed measurement")
}

