// Rust: tests/canvas.rs:5216
#Test("canvas_project_transactions_add_env_service") {
    dir :: temp_dir("project_add_env_service")
    fs.write(dir.join("package.jet"), "name: \"svcapp\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"svc\")\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    req :: "{{\"schema_version\":1,\"op\":\"add_env_service\",\"preview\":true,\"project_revision\":\"{project_revision}\",\"files\":[{{\"path\":\"env.jet\",\"revision\":\"missing\"}}],\"env\":\"env.jet\",\"name\":\"redis\",\"port\":6380,\"run\":[\"redis-server\",\"--port\",\"6380\"],\"ready\":\"redis-cli -p 6380 ping\"}}"
    preview :: Canvas.apply_project_transaction_json(entry, req).expect("add env service preview")
    assert(preview.contains("\"op\":\"add_env_service\""), "{preview}")
    assert(preview.contains("\"writes\":\"preview_only\""), "{preview}")
    assert(preview.contains("run: [\\\"redis-server\\\", \\\"--port\\\", \\\"6380\\\"]"), "{preview}")
    assert(!dir.join("env.jet").exists())
    apply :: req.replace("\"preview\":true", "\"preview\":false")
    applied :: Canvas.apply_project_transaction_json(entry, apply).expect("add env service apply")
    assert(applied.contains("\"writes\":\"source_transaction\""), "{applied}")
    env :: fs.read_to_string(dir.join("env.jet")).unwrap()
    assert(env.contains("module env.dev"), "{env}")
    assert(env.contains("redis:"), "{env}")
    assert(env.contains("ports: [6380]"), "{env}")
    assert(env.contains("run: [\"redis-server\", \"--port\", \"6380\"]"), "{env}")
    project :: Canvas.project_json_for_entry(entry)
    assert(project.contains("\"services\":[{{\"name\":\"redis\""), "{project}")
    assert(project.contains("\"ports\":[6380]"), "{project}")
}

