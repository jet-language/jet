#Test("canvas_project_transactions_reject_symlink_package_path") {
    if selected_family() != "unix" -> return // GATE #4483: Rust #[cfg(unix)].
    dir :: temp_dir("project_symlink_path")
    fs.create_dir_all(dir.join("packages/app")).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: [\"./packages/app\"]\n}}\n").unwrap()
    fs.write(dir.join("packages/app/package.jet"), "name: \"app\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n").unwrap()
    entry :: dir.join("packages/app/main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    outside :: dir.join("outside")
    fs.create_dir_all(outside).unwrap()
    symlink(outside, dir.join("packages/escape")).unwrap() // GATE #4494.
    req :: "{{\"schema_version\":1,\"op\":\"create_package\",\"preview\":false,\"project_revision\":\"{project_revision}\",\"package_path\":\"packages/escape\",\"files\":[{{\"path\":\"packages/escape/package.jet\",\"revision\":\"missing\"}},{{\"path\":\"packages/escape/run.jet\",\"revision\":\"missing\"}}],\"name\":\"escape\",\"target\":\"executable\"}}"
    err :: Canvas.apply_project_transaction_json(entry, req).expect_err("Canvas must not create a package through a symlink")
    assert(err.contains("symlink"), "{err}")
    assert(!outside.join("package.jet").exists())
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/canvas.rs:5084
#Test("canvas_project_transactions_roll_back_when_later_write_fails") {
    dir :: temp_dir("project_rollback")
    fs.create_dir_all(dir.join("packages/app")).unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {{\n    members: [\"./packages/app\"]\n}}\n").unwrap()
    fs.write(dir.join("packages/app/package.jet"), "name: \"app\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n").unwrap()
    entry :: dir.join("packages/app/main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    fs.create_dir_all(dir.join("packages/tools")).unwrap()
    fs.write(dir.join("packages/tools/nested"), "not a directory").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    req :: "{{\"schema_version\":1,\"op\":\"create_package\",\"preview\":false,\"project_revision\":\"{project_revision}\",\"package_path\":\"packages/tools\",\"entry\":\"packages/tools/nested/main.jet\",\"files\":[{{\"path\":\"packages/tools/package.jet\",\"revision\":\"missing\"}},{{\"path\":\"packages/tools/nested/main.jet\",\"revision\":\"missing\"}}],\"name\":\"tools\",\"target\":\"executable\"}}"
    err :: Canvas.apply_project_transaction_json(entry, req).expect_err("second write should fail and rollback first write")
    assert(err.contains("\"kind\":\"io\""), "{err}")
    assert(!dir.join("packages/tools/package.jet").exists(), "first project write must be rolled back")
    assert_eq(fs.read_to_string(dir.join("packages/tools/nested")).unwrap(), "not a directory")
}

// Rust: tests/canvas.rs:5122
#Test("canvas_project_transactions_remove_dependency") {
    dir :: temp_dir("project_remove_dep")
    fs.write(dir.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: {{\n    logging: logging#0.1.0,\n    tools: ../tools,\n}}\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{\n    print(\"app\")\n}}\n").unwrap()
    project :: Canvas.project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    manifest_revision :: Canvas.source_revision(fs.read_to_string(dir.join("package.jet")).unwrap())
    req :: "{{\"schema_version\":1,\"op\":\"remove_dependency\",\"preview\":true,\"project_revision\":\"{project_revision}\",\"files\":[{{\"path\":\"package.jet\",\"revision\":\"{manifest_revision}\"}}],\"manifest\":\"package.jet\",\"name\":\"logging\"}}"
    preview :: Canvas.apply_project_transaction_json(entry, req).expect("remove dependency preview")
    assert(preview.contains("\"op\":\"remove_dependency\""), "{preview}")
    assert(preview.contains("-    logging: logging#0.1.0,"), "{preview}")
    assert(fs.read_to_string(dir.join("package.jet")).unwrap().contains("logging"))
    apply :: req.replace("\"preview\":true", "\"preview\":false")
    applied :: Canvas.apply_project_transaction_json(entry, apply).expect("remove dependency apply")
    assert(applied.contains("\"writes\":\"source_transaction\""), "{applied}")
    manifest :: fs.read_to_string(dir.join("package.jet")).unwrap()
    assert(!manifest.contains("logging"), "{manifest}")
    assert(manifest.contains("tools: ../tools"), "{manifest}")
    assert(PackageFacts.parse(manifest, "test").is_ok(), "{manifest}")
}

