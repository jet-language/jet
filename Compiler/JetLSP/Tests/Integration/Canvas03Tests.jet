// GATE #4494: real filesystem, symlink, process and git providers.
// GATE #4483: Unix-only symlink test dispatches on selected target family.
// Rust: tests/canvas.rs:3551
#Test("canvas_core_catalog_classifies_every_action_for_palette_placement") {
    path :: write_fixture("core_catalog_statuses", "fn run() {{\n    print(\"core\")\n}}\n")
    source :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(source)
    catalog_request :: "{{\"schema_version\":1,\"op\":\"core_catalog\",\"revision\":\"{revision}\",\"query\":\"\"}}"
    catalog :: Canvas.query_json_for_file(path, catalog_request).expect("core catalog")
    catalog_ids := [String:Bool]{}
    loop module in json_top_level_objects(json_array_field(catalog, "modules")) {
        path :: json_field(module, "path")
        loop member in json_top_level_objects(json_array_field(module, "members")) {
            &catalog_ids.insert("canvas.core_catalog:{path}:{json_field(member, "name")}", true)
        }
    }
    actions_request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{revision}\"}}"
    actions :: Canvas.query_json_for_file(path, actions_request).expect("core actions")
    core_actions :: json_top_level_objects(json_array_field(actions, "actions"))
        .filter((action) -> action.contains("\"kind\":\"canvas.core_catalog\"")).collect()
    action_ids := [String:Bool]{}
    loop action in core_actions -> &action_ids.insert(json_field(action, "action_id"), true)
    assert_eq(catalog_ids, action_ids, "catalog/action coverage drift")
    stageable_reasons :: ["needs_canvas_defaults", "method_only"]
    excluded_reasons :: ["needs_unsafe_region", "type_member", "type_only", "value_only", "needs_signature", "not_direct_call"]
    loop action in core_actions {
        available :: action.contains("\"available\":true")
        stageable :: action.contains("\"stageable\":true")
        stage_reason :: json_field(action, "stage_reason_code")
        if stageable {
            assert(!available, "stageable action is available: {action}")
            assert(stageable_reasons.contains(stage_reason), "unstable stage reason: {action}")
            assert_eq(json_field(action, "unavailable_reason_code"), stage_reason, "stage status drift: {action}")
            assert(!json_field(action, "denied_reason").is_empty(), "staged action lacks reason: {action}")
            assert_eq(json_field(action, "insert_op"), "insert_call", "staged action lacks insertion path: {action}")
            assert(!json_field(action, "insert_callee").is_empty(), "staged action lacks callee: {action}")
            inputs :: json_top_level_objects(json_array_field(action, "pins"))
                .filter((pin) -> pin.contains("\"direction\":\"input\"")).collect()
            assert(!inputs.is_empty(), "staged action lacks inputs: {action}")
            assert(inputs.all((pin) -> {
                ty :: json_field(pin, "type")
                !ty.is_empty() && (ty != "Value" || (stage_reason == "method_only" && pin.contains("\"name\":\"receiver\"")))
            }), "staged action has untyped input: {action}")
            if stage_reason == "method_only" {
                receiver_type :: json_field(action, "receiver_type")
                assert(inputs.any((pin) -> pin.contains("\"name\":\"receiver\"") && json_field(pin, "type") == receiver_type), "staged method lacks typed receiver: {action}")
            }
        } else if !available {
            reason :: json_field(action, "unavailable_reason_code")
            assert(excluded_reasons.contains(reason), "unstable exclusion: {action}")
            assert(!json_field(action, "denied_reason").is_empty(), "excluded action lacks reason: {action}")
            assert(stage_reason.is_empty(), "excluded action carries stage status: {action}")
        } else {
            assert(stage_reason.is_empty(), "available action carries stage status: {action}")
        }
    }
}

// Rust: tests/canvas.rs:3675
#Test("canvas_projects_function_metadata_and_callback_event_views") {
    path :: write_fixture("function_events", CANVAS_FUNCTION_EVENT_FIXTURE)
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    loop field in [
        "\"title\":\"on_start\"",
        "\"function\":{{\"name\":\"on_start\"",
        "\"signature\":\"pub fn on_start(limit: Int{{1}}) -> Int\"",
        "\"visibility\":\"public\"",
        "\"docs\":\"Starts the scene.\"",
        "\"returns\":\"Int\"",
        "\"params\":[{{\"name\":\"limit\",\"type\":\"Int\"",
        "\"default\":true",
        "\"default_source\":\"1\"",
        "\"edit_affordances\":[\"rename_function\",\"edit_function_signature\",\"create_function\",\"source_jump\"]",
        "\"event_views\":[{{\"event_id\":\"fn:main.jet::on_start",
        "\"kind\":\"callback_event\"",
        "\"semantics\":\"ordinary_jet_function\"",
        "\"pending_first_class_events\":\"#286\"",
    ] {
        assert(graph.contains(field), "graph missing {field}: {graph}")
    }
}

