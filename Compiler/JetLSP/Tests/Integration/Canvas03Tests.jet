// Rust: tests/canvas.rs:3713
#Test("canvas_preserves_pure_effect_row_for_signature_edits") {
    path :: write_fixture("function_pure_effect", "fn adjust(value: Int) -[]> Int {{ return value }}\nfn run() {{ print(adjust(1)) }}\n")
    graph :: Canvas.graph_json_for_file(path).expect("canvas graph")
    adjust :: graph_object_for_title(graph, "adjust")
    assert(adjust.contains("\"pure\":true"), "{adjust}")
    assert(adjust.contains("\"signature\":\"fn adjust(value: Int) -[]> Int\""), "{adjust}")
    before :: fs.read_to_string(path).unwrap()
    edit :: "{{\"schema_version\":1,\"op\":\"edit_function_signature\",\"revision\":\"{Canvas.source_revision(before)}\",\"graph_id\":\"{graph_id_for_title(graph, "adjust")}\",\"signature\":\"fn adjust(next: Int) -[]> Int\"}}"
    Canvas.apply_transaction_json(path, edit).expect("edit pure signature")
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("fn adjust(next: Int) -[]> Int"), "{after}")
    assert(!after.contains("fn adjust(next: Int) -> Int ->"), "{after}")
}

