// Rust: tests/lsp.rs:355
fn advertised_capabilities(init: &String) -> [String] {
    cap_start :: init.find("\"capabilities\"")
    if cap_start == none -> return []
    open_rel :: init[cap_start.unwrap()..].find('{')
    if open_rel == none -> return []
    out := [String]()
    depth := 0usize
    in_string := false
    escape := false
    string_start := 0usize
    last_string := none as String?
    bytes :: init.as_bytes()
    i := cap_start.unwrap() + open_rel.unwrap()
    loop i < bytes.len() {
        b :: bytes[i]
        if in_string {
            if escape -> escape = false
            else if b == b'\\' -> escape = true
            else if b == b'"' {
                last_string = init[string_start..i].to_string()
                in_string = false
            }
            i += 1
            continue
        }
        match b {
            b'"' -> { in_string = true; string_start = i + 1 }
            b'{' -> depth += 1
            b'}' -> { depth = depth.saturating_sub(1); if depth == 0 -> break }
            b':' -> if depth == 1 { key :: last_string.take(); if key != none -> out.push(^key.unwrap()) }
            else -> {}
        }
        i += 1
    }
    if init.contains("\"renameProvider\"") && init.contains("\"prepareProvider\": true") -> out.push("renameProvider.prepare")
    if init.contains("\"semanticTokensProvider\"") {
        if init.contains("\"full\"") -> out.push("semanticTokensProvider.full")
        if init.contains("\"range\": true") -> out.push("semanticTokensProvider.range")
        if init.contains("\"delta\": true") -> out.push("semanticTokensProvider.delta")
    }
    out.sort()
    out.dedup()
    ^out
}

// Rust: tests/lsp.rs:432
// Minimal transcript JSON extractor; all byte offsets and original malformed-input behavior retained.
module transcript_parser {
    // Rust: tests/lsp.rs:434
    pub struct Step { send_raw: String?, open_uri: String?, expect_contains: [String], expect_notification: Bool }
    // Rust: tests/lsp.rs:445
    pub struct Transcript { description: String, source: String, steps: [Step] }
    // Rust: tests/lsp.rs:453
    fn unescape(s: &String) -> String {
        out := String.with_capacity(s.len())
        chars := s.chars()
        loop {
            c :: chars.next()
            if c == none -> break
            if c.unwrap() != '\\' { out.push(c.unwrap()); continue }
            match chars.next() {
                some('"') -> out.push('"')
                some('\\') -> out.push('\\')
                some('/') -> out.push('/')
                some('n') -> out.push('\n')
                some('r') -> out.push('\r')
                some('t') -> out.push('\t')
                some('b') -> out.push('\x08')
                some('f') -> out.push('\x0c')
                some('u') -> {
                    hex :: chars.by_ref().take(4).collect<String>()
                    match U32.from_str_radix(hex, 16) {
                        Ok(n) -> { c :: Char.from_u32(n); if c != none -> out.push(c.unwrap()) }
                        Err(_) -> {}
                    }
                }
                some(other) -> { out.push('\\'); out.push(other) }
                none -> break
            }
        }
        ^out
    }
    // Rust: tests/lsp.rs:489
    fn extract_string_field(json: &String, key: &String) -> String? {
        needle :: "\"{key}\""
        pos :: json.find(needle)?
        after := json[pos + needle.len()..].trim_start() // #4303
        after := after.strip_prefix(':')?.trim_start() // #4303
        after := after.strip_prefix('"')? // #4303
        end := 0usize
        bytes :: after.as_bytes()
        loop {
            if end >= bytes.len() -> return none
            if bytes[end] == b'\\' { end += 2; continue }
            if bytes[end] == b'"' -> break
            end += 1
        }
        unescape(after[..end])
    }
    // Rust: tests/lsp.rs:515
    fn skip_ws(s: &String) -> &String { s.trim_start_matches(c -> c.is_ascii_whitespace()) }
    // Rust: tests/lsp.rs:520
    fn find_matching_close(s: &String, open: Char, close: Char) -> USize? {
        depth := 0usize
        in_str := false
        bytes :: s.as_bytes()
        i := 0usize
        loop i < bytes.len() {
            b :: bytes[i]
            if in_str {
                if b == b'\\' { i += 2; continue }
                if b == b'"' -> in_str = false
            } else {
                c :: s[i..].chars().next().unwrap()
                if c == '"' -> in_str = true
                else if c == open -> depth += 1
                else if c == close { depth -= 1; if depth == 0 -> return i }
            }
            i += c_len(bytes, i)
        }
        none
    }
    // Rust: tests/lsp.rs:553
    fn c_len(bytes: &[U8], i: USize) -> USize {
        b :: bytes[i]
        if b < 0x80 -> 1 else if b < 0xE0 -> 2 else if b < 0xF0 -> 3 else -> 4
    }
    // Rust: tests/lsp.rs:567
    fn extract_string_array(s: &String) -> [String] {
        s := skip_ws(s) // #4303
        if !s.starts_with('[') -> return []
        close :: find_matching_close(s, '[', ']')
        if close == none -> return []
        inner := s[1..close.unwrap()] // #4303
        result := [String]()
        remaining := skip_ws(inner) // #4303
        loop !remaining.is_empty() {
            remaining = skip_ws(remaining)
            if remaining.starts_with(']') || remaining.is_empty() -> break
            if remaining.starts_with('"') {
                rest := remaining[1..] // #4303
                end := 0usize
                bytes :: rest.as_bytes()
                loop {
                    if end >= bytes.len() -> break
                    if bytes[end] == b'\\' { end += 2; continue }
                    if bytes[end] == b'"' -> break
                    end += 1
                }
                result.push(unescape(rest[..end]))
                remaining = skip_ws(rest[end + 1..])
            } else -> break
            remaining = skip_ws(remaining.trim_start_matches(','))
        }
        ^result
    }
    // Rust: tests/lsp.rs:612
    fn extract_object(s: &String) -> (String, &String)? {
        s := skip_ws(s) // #4303
        if !s.starts_with('{') -> return none
        close :: find_matching_close(s, '{', '}')?
        (s[..close + 1].to_string(), s[close + 1..])
    }
    // Rust: tests/lsp.rs:621
    pub fn parse(content: &String) -> Transcript {
        description :: extract_string_field(content, "description").unwrap_or_default()
        source :: extract_string_field(content, "source").expect("transcript must have 'source'")
        steps_needle :: "\"steps\""
        steps_pos :: content.find(steps_needle).expect("transcript must have 'steps'")
        after_steps := content[steps_pos + steps_needle.len()..].trim_start() // #4303
        after_colon := after_steps.strip_prefix(':').unwrap().trim_start() // #4303
        close_bracket :: find_matching_close(after_colon, '[', ']').expect("steps array must close")
        steps_inner := after_colon[1..close_bracket] // #4303
        steps := [Step]()
        remaining := skip_ws(steps_inner) // #4303
        loop !remaining.is_empty() {
            remaining = skip_ws(remaining)
            if remaining.is_empty() -> break
            extracted :: extract_object(remaining)
            if extracted == none -> break
            (step_obj, rest) :: extracted.unwrap()
            remaining = skip_ws(rest.trim_start_matches(','))
            steps.push(parse_step(step_obj))
        }
        Transcript{description: ^description, source: ^source, steps: ^steps}
    }
    // Rust: tests/lsp.rs:664
    fn parse_step(obj: &String) -> Step {
        send_needle :: "\"send\""
        open_needle :: "\"open\""
        ec_needle :: "\"expect_contains\""
        en_needle :: "\"expect_notification\""
        send_pos :: obj.find(send_needle)
        send_raw :: if send_pos != none {
            after := skip_ws(obj[send_pos.unwrap() + send_needle.len()..]) // #4303
            after := after.strip_prefix(':').unwrap_or(after).trim_start() // #4303
            extract_object(after).map((o, _) -> ^o)
        } else -> none
        open_uri :: if send_raw == none {
            open_pos :: obj.find(open_needle)
            if open_pos != none {
                after := skip_ws(obj[open_pos.unwrap() + open_needle.len()..]) // #4303
                after := after.strip_prefix(':').unwrap_or(after).trim_start() // #4303
                extract_object(after).and_then((open_obj, _) -> extract_string_field(open_obj, "uri"))
            } else -> none
        } else -> none
        ec_pos :: obj.find(ec_needle)
        expect_contains :: if ec_pos != none {
            after := skip_ws(obj[ec_pos.unwrap() + ec_needle.len()..]) // #4303
            after := after.strip_prefix(':').unwrap_or(after).trim_start() // #4303
            extract_string_array(after)
        } else -> []
        en_pos :: obj.find(en_needle)
        expect_notification :: if en_pos != none {
            after := skip_ws(obj[en_pos.unwrap() + en_needle.len()..]) // #4303
            after := after.strip_prefix(':').unwrap_or(after).trim_start() // #4303
            !after.starts_with("null")
        } else -> false
        Step{send_raw: ^send_raw, open_uri: ^open_uri, expect_contains: ^expect_contains, expect_notification: expect_notification}
    }
}
// Rust: tests/lsp.rs:722
fn run_json_transcript_file(jet: &OSPath, path: &OSPath) -> {
    _guard :: lock_lsp_process()
    content :: fs.read_to_string(path).unwrap_or_else(e -> panic("read {path:?}: {e}"))
    transcript :: transcript_parser.parse(content)
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    loop step in transcript.steps {
        if step.open_uri != none {
            uri :: step.open_uri.unwrap()
            open :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(transcript.source)}}}}}}}"
            send_msg(&stdin, open)
            if step.expect_notification {
                notif :: read_msg(&stdout)
                assert(notif.contains("publishDiagnostics"), "[{path.display()}] open step: expected publishDiagnostics, got: {notif}")
                loop expect in step.expect_contains -> assert(notif.contains(expect.as_str()), "[{path.display()}] expected {expect:?} in notification, got:\n{notif}")
            }
        } else if step.send_raw != none {
            send_msg(&stdin, step.send_raw.unwrap())
            if !step.expect_contains.is_empty() {
                resp :: read_msg(&stdout)
                loop expect in step.expect_contains -> assert(resp.contains(expect.as_str()), "[{path.display()}] expected {expect:?} in response, got:\n{resp}")
            }
        }
    }
    drop(^stdin)
    _ :: child.wait()
}
