fn json_object_field(value: &DataTree, key: &String) -> &DataTree {
    json_get(value, key).unwrap_or_else(() -> panic("missing JSON field `{key}`"))
}
// Rust: tests/lsp.rs:161
fn json_array(value: &DataTree, context: &String) -> &[DataTree] {
    match value { DataTree.Array(values) -> values; else -> panic("{context} is not an array: {value:?}") }
}
// Rust: tests/lsp.rs:168
fn json_array_field(value: &DataTree, key: &String) -> &[DataTree] { json_array(json_object_field(value, key), "JSON field `{key}`") }
// Rust: tests/lsp.rs:175
fn json_values_equal(left: &DataTree, right: &DataTree) -> Bool {
    match (left, right) {
        (DataTree.Null, DataTree.Null) -> true
        (DataTree.Bool(left), DataTree.Bool(right)) -> left == right
        (DataTree.Int(left), DataTree.Int(right)) -> left == right
        (DataTree.Float(left), DataTree.Float(right)) -> left == right
        (DataTree.Number(left), DataTree.Number(right)) -> left == right
        (DataTree.Text(left) | DataTree.TypedText(left), DataTree.Text(right) | DataTree.TypedText(right)) -> left == right
        (DataTree.Bytes(left), DataTree.Bytes(right)) -> left == right
        (DataTree.Array(left), DataTree.Array(right)) -> left.len() == right.len() && left.iter().zip(right).all((left, right) -> json_values_equal(left, right))
        (DataTree.Object(left), DataTree.Object(right)) -> left.len() == right.len() && left.iter().all((key, left) -> right.iter().find_map((right_key, right) -> if right_key == key -> right else -> none).is_some_and(right -> json_values_equal(left, right)))
        else -> false
    }
}
// Rust: tests/lsp.rs:206
fn assert_json_values_equal(label: &String, actual: &DataTree, expected: &DataTree) -> {
    assert(json_values_equal(actual, expected), "{label}: actual={actual:?}, expected={expected:?}")
}
// Rust: tests/lsp.rs:214
struct DecodedSemanticToken { text: String, token_type: U32, modifiers: U32 }
// Rust: tests/lsp.rs:220
fn semantic_data_from_response(resp: &String) -> [U32] {
    data_key :: "\"data\""
    start :: resp.find(data_key).expect("semantic token data")
    after_key := resp[start + data_key.len()..] // #4303
    array_start :: after_key.find('[').expect("data array")
    after_array := after_key[array_start + 1..] // #4303
    array_end :: after_array.find(']').expect("data array end")
    after_array[..array_end].split(',').filter_map(n -> n.trim().parse<U32>().ok()).collect()
}
// Rust: tests/lsp.rs:233
fn decode_semantic_tokens(src: &String, resp: &String) -> [DecodedSemanticToken] {
    data :: semantic_data_from_response(resp)
    lines :: src.lines().collect()
    out := [DecodedSemanticToken]()
    line := 0u32
    start := 0u32
    loop chunk in data.chunks_exact(5) {
        line += chunk[0]
        start = if chunk[0] == 0 -> start + chunk[1] else -> chunk[1]
        len :: chunk[2]
        text :: lines.get(line as USize).and_then(line_text -> {
            s :: start as USize
            e :: s + len as USize
            line_text.get(s..e)
        }).unwrap_or("").to_string()
        out.push(DecodedSemanticToken{text: ^text, token_type: chunk[3], modifiers: chunk[4]})
    }
    ^out
}
// Rust: tests/lsp.rs:266
fn assert_semantic_token(tokens: &[DecodedSemanticToken], text: &String, token_type: U32, modifier: U32) -> {
    assert(tokens.iter().any(t -> t.text == text && t.token_type == token_type && (t.modifiers & modifier) != 0), "missing semantic token `{text}` type {token_type} modifier {modifier}; got {tokens:?}")
}
