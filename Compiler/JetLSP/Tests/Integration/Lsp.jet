// Rust: tests/lsp.rs:26
fn lsp_process_lock() -> &Mutex<()> {
    static LOCK :: OnceLock<Mutex<()>>.new()
    LOCK.get_or_init(() -> Mutex.new(()))
}
// Rust: tests/lsp.rs:31
fn lock_unpoisoned<T>(mutex: &Mutex<T>) -> MutexGuard<T> {
    mutex.lock().unwrap_or_else(poisoned -> poisoned.into_inner())
}
// Rust: tests/lsp.rs:37
fn lock_lsp_process() -> MutexGuard<()> { lock_unpoisoned(lsp_process_lock()) }
// Rust: tests/lsp.rs:53
fn send_msg(stdin: &Write, json: &String) -> {
    stdin.write_all("Content-Length: {json.len()}\r\n\r\n{json}".as_bytes()).unwrap()
    stdin.flush().unwrap()
}
// Rust: tests/lsp.rs:58
fn read_msg(stdout: &Read) -> String {
    header := String.new()
    buf := [0u8]
    loop {
        stdout.read_exact(&buf).unwrap()
        header.push(buf[0] as Char)
        if header.ends_with("\r\n\r\n") -> break
    }
    len :: header.lines().find_map(line -> line.strip_prefix("Content-Length:").map(n -> n.trim()))
        .expect("Content-Length").parse<USize>().unwrap()
    body := [U8].repeat(0, len)
    stdout.read_exact(&body).unwrap()
    String.from_utf8(^body).unwrap()
}
// Rust: tests/lsp.rs:79
fn request_lsp(stdin: &Write, stdout: &Read, id: I64, method: &String, params: &String) -> String {
    send_msg(stdin, "{{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"{method}\",\"params\":{params}}}")
    loop {
        body :: read_msg(stdout)
        parsed :: parse_json(body).expect("valid LSP response")
        if json_get(parsed, "id") == DataTree.Int(id) -> return ^body
    }
}
// Rust: tests/lsp.rs:101
// Keep every message preceding the matching response, preserving arrival order.
fn request_lsp_collect(stdin: &Write, stdout: &Read, id: I64, method: &String, params: &String) -> (DataTree, [DataTree]) {
    send_msg(stdin, "{{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"{method}\",\"params\":{params}}}")
    before := [DataTree]()
    loop {
        parsed :: parse_json(read_msg(stdout)).expect("valid LSP message")
        if json_get(parsed, "id") == DataTree.Int(id) -> return (^parsed, ^before)
        before.push(^parsed)
    }
}
// Rust: tests/lsp.rs:123
fn published_diagnostics_for(messages: &[DataTree], uri: &String) -> [&DataTree] {
    messages.iter().filter(message -> json_get(message, "method").and_then(json_str) == "textDocument/publishDiagnostics")
        .filter_map(message -> json_get(message, "params"))
        .filter(params -> json_get(params, "uri").and_then(json_str) == uri).collect()
}
// Rust: tests/lsp.rs:134
fn error_count(published: &DataTree) -> USize {
    json_array_field(published, "diagnostics").iter().filter(diagnostic -> json_get(diagnostic, "severity") == DataTree.Int(1)).count()
}
// Rust: tests/lsp.rs:141
fn json_string(s: &String) -> String {
    out := String.from("\"")
    loop c in s.chars() {
        match c {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            else -> out.push(c)
        }
    }
    out.push('"')
    ^out
}
