// Rust: tests/lsp.rs:4605
#Test("lsp_semantic_tokens_classify_ownership_markers_and_skip_retired_words") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    source :: "#Test(\"semantic\") {{\n}}\n#Unsafe(\"audit\") fn archive(name: ^String, slot: &Int) -> String {{\n    saved :: copy name\n    return saved\n}}\nfn clean(x: Int) -[]> Int {{ return x }}\nfn retain(window: View<Int>) -> View<Int> {{ return window }}\nfn run() {{\n    old :: 1\n    while :: 2\n    for :: 3\n    mut borrowed\n    take borrowed\n    view borrowed\n    borrowed.read()\n    text := \"view .view stays string content\"\n    // view and .view stay comment content\n    next()\n    cursor.next()\n    loop {{\n        value :: maybe() ?? next\n        nested :: (maybe() ?? next)\n        consume(maybe() ?? next, 1)\n        escaped :: maybe() ?? (next)\n        next\n    }}\n    outer :: loop {{ next(outer) }}\n}}\nfn next() -> Int {{ return 1 }}\n"
    uri :: "file:///tmp/lsp_semantic_highlight_stage4.jet"
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}")
    init :: read_msg(&stdout)
    loop expected in ["ownership", "decorator", "move", "writeBorrow", "copy"] {
        assert(init.contains(expected), "initialize response missing `{expected}`: {init}")
    }
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    open :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}"
    send_msg(&stdin, open)
    _ :: read_msg(&stdout)
    req :: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/semanticTokens/full\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}"
    send_msg(&stdin, req)
    response :: read_msg(&stdout)
    assert(response.contains("\"id\":2") && response.contains("\"data\""), "expected semantic token response, got: {response}")
    TOKEN_KEYWORD :: 0u32
    TOKEN_OWNERSHIP :: 12u32
    TOKEN_DECORATOR :: 13u32
    TOKEN_TYPE :: 1u32
    TOKEN_VARIABLE :: 3u32
    MOD_MOVE :: 1u32 << 2
    MOD_WRITE_BORROW :: 1u32 << 3
    MOD_COPY :: 1u32 << 4
    MOD_RULE :: 1u32 << 5
    tokens :: decode_semantic_tokens(source, response)
    assert_semantic_token(tokens, "copy", TOKEN_OWNERSHIP, MOD_COPY)
    assert_semantic_token(tokens, "^", TOKEN_OWNERSHIP, MOD_MOVE)
    assert_semantic_token(tokens, "&", TOKEN_OWNERSHIP, MOD_WRITE_BORROW)
    assert_semantic_token(tokens, "Test", TOKEN_DECORATOR, MOD_RULE)
    assert_semantic_token(tokens, "Unsafe", TOKEN_DECORATOR, MOD_RULE)
    assert_semantic_token(tokens, "#", TOKEN_DECORATOR, MOD_RULE)
    assert(tokens.iter().any(token -> token.text == "View" && token.token_type == TOKEN_TYPE), "public View<T> contracts should remain type tokens: {tokens:?}")
    loop ordinary in ["while", "for"] {
        assert(tokens.iter().any(t -> t.text == ordinary && t.token_type == TOKEN_VARIABLE), "paused retired spelling `{ordinary}` should emit an ordinary variable token: {tokens:?}")
    }
    assert(tokens.iter().filter(token -> token.text == "next" && token.token_type == TOKEN_KEYWORD).count() == 4, "standalone, nested, comma-delimited, and bare `?? next` should be contextual keyword tokens: {tokens:?}")
    assert(tokens.iter().filter(token -> token.text == "next" && token.token_type == TOKEN_VARIABLE).count() == 5, "`fn next`, `.next` (including named loop exits), statement-start `next()`, and `?? (next)` must remain variables: {tokens:?}")
    loop retired in ["val", "mut", "take", "view"] {
        assert(!tokens.iter().any(t -> t.text == retired), "reserved ownership spelling `{retired}` should not emit semantic token: {tokens:?}")
    }
    edited_source :: source.replacen("borrowed.read()", "borrowed.view()", 1)
    change :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":2}},\"contentChanges\":[{{\"range\":{{\"start\":{{\"line\":15,\"character\":13}},\"end\":{{\"line\":15,\"character\":17}}}},\"rangeLength\":4,\"text\":\"view\"}}]}}}}"
    send_msg(&stdin, change)
    edited_req :: "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/semanticTokens/full\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}}}"
    send_msg(&stdin, edited_req)
    edited_response :: loop {
        message :: read_msg(&stdout)
        if message.contains("\"id\":3") -> break ^message
    }
    edited_tokens :: decode_semantic_tokens(edited_source, edited_response)
    assert(!edited_tokens.iter().any(token -> token.text == "view"), "incrementally introduced `.view` should stay retired: {edited_tokens:?}")
    assert(edited_tokens.iter().any(token -> token.text == "View" && token.token_type == TOKEN_TYPE), "incremental classification should preserve public View<T>: {edited_tokens:?}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\",\"params\":{{}}}}")
    _ :: read_msg(&stdout)
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":{{}}}}")
    drop(^stdin)
    _ :: child.wait()
}

