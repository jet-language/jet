// Rust: tests/lsp.rs:5630
#Test("c40_keyword_like_identifier_usable_as_variable") {
    diags :: check_document("c40_kw_in_ident.jet", "fn run() {{\n    printer :: \"hp\"\n    in_count :: 3\n    sprint :: 9.8\n}}\n")
    loop d in diags {
        all_text :: "{d.what} {d.why} {d.fix}"
        loop name in ["printer", "in_count", "sprint"] {
            assert(!(all_text.contains(name) && all_text.to_lowercase().contains("keyword")), "identifier `{name}` containing keyword substring wrongly flagged as keyword: {d:?}")
        }
    }
}

