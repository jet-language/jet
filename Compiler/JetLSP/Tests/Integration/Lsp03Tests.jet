// Rust: tests/lsp.rs:3804
#Test("lsp_checked_identity_and_versioned_rename") {
    _guard :: lock_lsp_process()
    root :: Scratch.new("lsp-checked-rename")
    fs.write(root.join("package.jet"), "name: \"rename\"\nversion: \"0.1.0\"\n").unwrap()
    main :: "use scoring as grades\nuse \"util\"\nfn run() {{\n    print(grades.letter(91))\n    print(util.letter(91))\n}}\nfn shadow(letter: Int) {{ print(letter) }}\n"
    scoring :: "pub fn letter(score: Int) -> String -> \"A\"\n"
    util :: "pub fn letter(score: Int) -> String -> \"unrelated\"\n"
    sources :: [("run.jet", main), ("scoring.jet", scoring), ("util.jet", util)]
    loop (name, source) in sources -> fs.write(root.join(name), source).unwrap()
    file_uri :: (name: &String) -> "file://{root.join(name).display()}".replace('%', "%25").replace(' ', "%20").replace('(', "%28").replace(')', "%29")
    main_uri :: file_uri("run.jet")
    scoring_uri :: file_uri("scoring.jet")
    child := Command.new(jet_bin()).args(["self", "lsp"]).current_dir(root.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().unwrap()
    stdin := child.stdin.take().unwrap()
    stdout := child.stdout.take().unwrap()
    request :: (stdin: &ChildStdin, stdout: &ChildStdout, method: &String, params: String) -> parse_json(request_lsp(stdin, stdout, 7, method, params)).unwrap()
    _ :: request(&stdin, &stdout, "initialize", "{{\"capabilities\":{{\"workspace\":{{\"workspaceEdit\":{{\"documentChanges\":true}}}}}}}}")
    loop (name, source) in sources {
        uri :: file_uri(name)
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
    }
    overlay :: "// unsaved 🚀\n\n{scoring}"
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{scoring_uri}\",\"version\":2}},\"contentChanges\":[{{\"text\":{json_string(overlay)}}}]}}}}")
    params :: (extra: &String) -> "{{\"textDocument\":{{\"uri\":\"{main_uri}\"}},\"position\":{{\"line\":3,\"character\":19}}{extra}}}"
    definition :: request(&stdin, &stdout, "textDocument/definition", params(""))
    definition_result :: json_object_field(definition, "result")
    assert_eq(json_str(json_object_field(definition_result, "uri")), scoring_uri)
    expected_definition_range :: parse_json("{{\"start\":{{\"line\":2,\"character\":7}},\"end\":{{\"line\":2,\"character\":13}}}}").unwrap()
    assert_json_values_equal("definition", json_object_field(definition_result, "range"), expected_definition_range)
    references :: request(&stdin, &stdout, "textDocument/references", params(",\"context\":{{\"includeDeclaration\":true}}"))
    references_result :: json_array_field(references, "result")
    assert_eq(references_result.len(), 2, "{references_result:?}")
    expected_call_range :: parse_json("{{\"start\":{{\"line\":3,\"character\":17}},\"end\":{{\"line\":3,\"character\":23}}}}").unwrap()
    loop reference in references_result {
        uri :: json_str(json_object_field(reference, "uri")).unwrap()
        expected :: if uri == main_uri -> &expected_call_range else -> {
            assert_eq(uri, scoring_uri)
            &expected_definition_range
        }
        assert_json_values_equal("reference", json_object_field(reference, "range"), expected)
    }
    prepared :: request(&stdin, &stdout, "textDocument/prepareRename", params(""))
    assert_json_values_equal("prepare rename", json_object_field(json_object_field(prepared, "result"), "range"), expected_call_range)
    renamed :: request(&stdin, &stdout, "textDocument/rename", params(",\"newName\":\"grade\""))
    result :: json_object_field(renamed, "result")
    changes :: json_array_field(result, "documentChanges")
    assert_eq(changes.len(), 2, "{renamed:?}")
    loop change in changes {
        document :: json_object_field(change, "textDocument")
        uri :: json_str(json_object_field(document, "uri")).unwrap()
        (version, expected) :: if uri == main_uri -> (1, &expected_call_range) else -> {
            assert_eq(uri, scoring_uri)
            (2, &expected_definition_range)
        }
        assert_json_values_equal("checked document version", json_object_field(document, "version"), DataTree.Int(version))
        edits :: json_array_field(change, "edits")
        assert_eq(edits.len(), 1)
        assert_json_values_equal("rename range", json_object_field(edits[0], "range"), expected)
        assert_eq(json_str(json_object_field(edits[0], "newText")), "grade")
    }
    targets :: json_array_field(json_array_field(result, "semantic_ops")[0], "targets")
    assert_eq(targets.len(), 1, "{targets:?}")
    assert_eq(json_str(json_object_field(targets[0], "before")), "fn:module:scoring::letter")
    assert_eq(json_str(json_object_field(targets[0], "after")), "fn:module:scoring::grade")
    updated_main :: "// moved\n{main.replace("    print(grades", "    print(\"🚀\"); print(grades")}"
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{main_uri}\",\"version\":3}},\"contentChanges\":[{{\"text\":{json_string(updated_main)}}}]}}}}")
    moved :: request(&stdin, &stdout, "textDocument/rename", "{{\"textDocument\":{{\"uri\":\"{main_uri}\"}},\"position\":{{\"line\":4,\"character\":31}},\"newName\":\"grade\"}}")
    moved_changes :: json_array_field(json_object_field(moved, "result"), "documentChanges")
    assert_eq(moved_changes.len(), 2, "{moved:?}")
    moved_main :: moved_changes.iter().find(change -> json_str(json_object_field(json_object_field(change, "textDocument"), "uri")) == main_uri).unwrap()
    assert_json_values_equal("new snapshot version", json_object_field(json_object_field(moved_main, "textDocument"), "version"), DataTree.Int(3))
    moved_range :: parse_json("{{\"start\":{{\"line\":4,\"character\":30}},\"end\":{{\"line\":4,\"character\":36}}}}").unwrap()
    assert_json_values_equal("shifted UTF-16 occurrence", json_object_field(json_array_field(moved_main, "edits")[0], "range"), moved_range)
    _ :: request(&stdin, &stdout, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}

// Rust: tests/lsp.rs:3934
#Test("lsp_checked_imported_diagnostics_and_repairs") {
    _guard :: lock_lsp_process()
    root :: Scratch.new("lsp-imported-reports")
    fs.write(root.join("package.jet"), "name: \"reports\"\nversion: \"0.1.0\"\n").unwrap()
    main :: "use \"scoring\"\nfn run() {{ print(scoring.letter(91)) }}\n"
    scoring :: "pub fn letter(score: Int, offset: Int) -> String {{\n    adjusted = score + offset\n    return if {{\n        adjusted >= 90 -> \"A\"\n        adjusted >= 80 -> \"B\"\n        else -> \"C\"\n    }}\n}}\nfn repair_probe() {{\n    m :: [String:Int]{{}}\n    _ :: m.gett(\"a\")\n}}\n"
    file_uri :: (name: &String) -> "file://{root.join(name).display()}".replace('%', "%25").replace(' ', "%20").replace('(', "%28").replace(')', "%29")
    main_uri :: file_uri("run.jet")
    scoring_uri :: file_uri("scoring.jet")
    fs.write(root.join("run.jet"), main).unwrap()
    fs.write(root.join("scoring.jet"), scoring).unwrap()
    child := Command.new(jet_bin()).args(["self", "lsp"]).current_dir(root.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().unwrap()
    stdin := child.stdin.take().unwrap()
    stdout := child.stdout.take().unwrap()
    request :: (stdin: &ChildStdin, stdout: &ChildStdout, method: &String, params: String) -> request_lsp_collect(stdin, stdout, 7, method, params)
    _ :: request(&stdin, &stdout, "initialize", "{{\"capabilities\":{{}}}}")
    loop (uri, source) in [(main_uri, main), (scoring_uri, scoring)] {
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
    }
    overlay :: "// unsaved \u{1f680}\n\n{scoring}"
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{scoring_uri}\",\"version\":2}},\"contentChanges\":[{{\"text\":{json_string(overlay)}}}]}}}}")
    action_params :: (uri: &String) -> "{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":9,\"character\":0}}}},\"context\":{{\"diagnostics\":[]}}}}"
    (main_actions, notifications) :: request(&stdin, &stdout, "textDocument/codeAction", action_params(main_uri))
    reports :: (uri: &String) -> notifications.iter().rev().find_map(notification -> {
        params :: json_get(notification, "params")?
        if json_get(params, "uri").and_then(json_str) == uri -> params else -> none
    }).unwrap()
    imported :: reports(scoring_uri)
    assert_json_values_equal("imported checked version", json_object_field(imported, "version"), DataTree.Int(2))
    imported_errors :: json_array_field(imported, "diagnostics").iter().filter(diagnostic -> json_get(diagnostic, "code").and_then(json_str) == "E0107").collect()
    assert_eq(imported_errors.len(), 3, "{imported:?}")
    first :: json_object_field(json_object_field(imported_errors[0], "range"), "start")
    assert_json_values_equal("imported body line", json_object_field(first, "line"), DataTree.Int(3))
    caller :: reports(main_uri)
    caller_errors :: json_array_field(caller, "diagnostics")
    assert(caller_errors.iter().all(diagnostic -> json_get(diagnostic, "code").and_then(json_str) != "E0107"), "{caller:?}")
    missing_arg :: caller_errors.iter().find(diagnostic -> json_get(diagnostic, "code").and_then(json_str) == "E0104").expect("missing argument remains a caller diagnostic")
    caller_start :: json_object_field(json_object_field(missing_arg, "range"), "start")
    assert_json_values_equal("caller line", json_object_field(caller_start, "line"), DataTree.Int(1))
    assert(json_array(json_object_field(main_actions, "result"), "caller actions").iter()
        .flat_map(action -> json_array_field(json_object_field(action, "edit"), "documentChanges"))
        .flat_map(change -> json_array_field(change, "edits"))
        .all(edit -> {
            text :: json_get(edit, "newText").and_then(json_str)
            text != "get" && text != "_repair_probe"
        }), "imported method repair must not be offered against the caller: {main_actions:?}")
    (scoring_actions, _) :: request(&stdin, &stdout, "textDocument/codeAction", action_params(scoring_uri))
    actions :: json_array(json_object_field(scoring_actions, "result"), "imported actions")
    method_edit :: actions.iter().flat_map(action -> json_array_field(json_object_field(action, "edit"), "documentChanges"))
        .flat_map(change -> json_array_field(change, "edits"))
        .find(edit -> json_get(edit, "newText").and_then(json_str) == "get").expect("registered method repair")
    expected_range :: parse_json("{{\"start\":{{\"line\":12,\"character\":11}},\"end\":{{\"line\":12,\"character\":15}}}}").unwrap()
    assert_json_values_equal("repair selects imported gett", json_object_field(method_edit, "range"), expected_range)
    loop action in actions {
        loop change in json_array_field(json_object_field(action, "edit"), "documentChanges") {
            document :: json_object_field(change, "textDocument")
            assert_eq(json_get(document, "uri").and_then(json_str), scoring_uri)
            assert_json_values_equal("repair snapshot", json_object_field(document, "version"), DataTree.Int(2))
        }
    }
    _ :: request(&stdin, &stdout, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}

// Rust: tests/lsp.rs:4038
#Test("lsp_definition_returns_location") {
    jet :: jet_bin()
    if !jet.exists() -> return
    source :: "fn greet() {{}}\nfn run() {{\n    greet()\n}}\n"
    uri :: "file:///tmp/lsp_def_test.jet"
