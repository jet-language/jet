    uri :: "file://{env.temp_dir().join("lsp_checked_text_test.jet").display()}"
    run_transcript(source, [
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: ["hoverProvider", "completionProvider", "definitionProvider", "referencesProvider", "renameProvider"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
        TranscriptStep.Open { uri: uri, expect_notification: true },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":2,\"character\":1}}}}}}", expect_contains: ["type Pattern :: distinct String", "implements CheckedText", "type Error = PatternError", "encode_hole"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/completion\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":15,\"character\":4}}}}}}", expect_contains: ["Pattern", "implements CheckedText", "encode_hole"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/definition\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":12,\"character\":23}}}}}}", expect_contains: ["range", "nominal_base", "CheckedText", "encode_hole"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/references\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":2,\"character\":1}},\"context\":{{\"includeDeclaration\":true}}}}}}", expect_contains: ["nominal_base", "CheckedText", "Pattern"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/rename\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":2,\"character\":1}},\"newName\":\"Pattern2\"}}}}", expect_contains: ["documentChanges", "\"newText\":\"Pattern2\"", "nominal_base", "CheckedText"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
    ])
}

// Rust: tests/lsp.rs:4200
#Test("lsp_definition_foreign_declaration_uses_checked_jet_boundary") {
    jet :: jet_bin()
    if !jet.exists() -> return
    source :: "extern rust \"std\" {{\n    fn rust_max(a: Int, b: Int) -> Int = \"std::cmp::max\"\n}}\nfn run() {{\n    rust_max(1, 2)\n}}\n"
    uri :: "file:///tmp/lsp_foreign_definition_test.jet"
    _guard :: lock_lsp_process()
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp for foreign definition")
    stdin := child.stdin.take().expect("foreign definition stdin")
    stdout := child.stdout.take().expect("foreign definition stdout")
    initialize :: request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")
    assert(initialize.contains("definitionProvider"), "{initialize}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
    diagnostics :: read_msg(&stdout)
    assert(diagnostics.contains("publishDiagnostics"), "{diagnostics}")
    response :: request_lsp(&stdin, &stdout, 2, "textDocument/definition", "{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":4,\"character\":7}}}}")
    parsed :: parse_json(response).expect("foreign definition JSON")
    result :: json_object_field(parsed, "result")
    assert_eq(json_str(json_object_field(result, "uri")), uri)
    expected_range :: parse_json("{{\"start\":{{\"line\":1,\"character\":7}},\"end\":{{\"line\":1,\"character\":15}}}}").unwrap()
    assert_json_values_equal("foreign definition stays on Jet declaration", json_object_field(result, "range"), expected_range)
    assert(!response.contains("std::cmp::max"), "foreign definition must not claim a Rust body: {response}")
    _ :: request_lsp(&stdin, &stdout, 99, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}

// Rust: tests/lsp.rs:4286
#Test("lsp_definition_imported_identity_collisions_are_exact") {
    jet :: jet_bin()
    if !jet.exists() -> return
    root :: Scratch.new("lsp-definition-identity-collisions")
    fs.write(root.join("package.jet"), "name: \"definition-collisions\"\nversion: \"0.1.0\"\n").expect("write definition collision package manifest")
    main_source :: "use scoring as grades\nuse \"util\"\nfn run() {{\n    print(grades.letter(91))\n    print(util.letter(91))\n}}\nfn local(letter: Int) {{\n    print(letter)\n}}\n"
    scoring_source :: "pub fn letter(score: Int) -> String {{ \"A\" }}\n"
    util_source :: "pub fn letter(score: Int) -> String {{ \"unrelated\" }}\n"
    fs.write(root.join("run.jet"), main_source).expect("write definition collision root")
    fs.write(root.join("scoring.jet"), scoring_source).expect("write scoring module")
    fs.write(root.join("util.jet"), util_source).expect("write util module")
    uri :: (name: &String) -> "file://{root.join(name).display()}".replace('%', "%25").replace(' ', "%20").replace('(', "%28").replace(')', "%29")
    main_uri :: uri("run.jet")
    scoring_uri :: uri("scoring.jet")
    util_uri :: uri("util.jet")
    _guard :: lock_lsp_process()
    child := Command.new(jet).args(["self", "lsp"]).current_dir(root.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp for definition collisions")
    stdin := child.stdin.take().expect("definition collision stdin")
    stdout := child.stdout.take().expect("definition collision stdout")
    initialize :: request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")
    assert(initialize.contains("definitionProvider"), "{initialize}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    loop (document_uri, source) in [(main_uri, main_source), (scoring_uri, scoring_source), (util_uri, util_source)] {
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{document_uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}")
        diagnostics :: read_msg(&stdout)
        assert(diagnostics.contains("publishDiagnostics"), "{diagnostics}")
    }
    definition :: (id: I64, line: U32, character: U32) -> request_lsp(&stdin, &stdout, id, "textDocument/definition", "{{\"textDocument\":{{\"uri\":\"{main_uri}\"}},\"position\":{{\"line\":{line},\"character\":{character}}}}}")
    scoring :: parse_json(definition(2, 3, 19)).expect("scoring definition JSON")
    scoring_result :: json_object_field(scoring, "result")
    assert_eq(json_str(json_object_field(scoring_result, "uri")), scoring_uri)
    expected_scoring :: parse_json("{{\"start\":{{\"line\":0,\"character\":7}},\"end\":{{\"line\":0,\"character\":13}}}}").unwrap()
    assert_json_values_equal("qualified scoring definition", json_object_field(scoring_result, "range"), expected_scoring)
    util :: parse_json(definition(3, 4, 17)).expect("util definition JSON")
    util_result :: json_object_field(util, "result")
    assert_eq(json_str(json_object_field(util_result, "uri")), util_uri)
    expected_util :: parse_json("{{\"start\":{{\"line\":0,\"character\":7}},\"end\":{{\"line\":0,\"character\":13}}}}").unwrap()
    assert_json_values_equal("qualified util definition", json_object_field(util_result, "range"), expected_util)
    local :: parse_json(definition(4, 7, 12)).expect("local definition JSON")
    local_result :: json_object_field(local, "result")
    assert_eq(json_str(json_object_field(local_result, "uri")), main_uri)
    expected_local :: parse_json("{{\"start\":{{\"line\":6,\"character\":9}},\"end\":{{\"line\":6,\"character\":15}}}}").unwrap()
    assert_json_values_equal("local definition wins over imported leaves", json_object_field(local_result, "range"), expected_local)
    _ :: request_lsp(&stdin, &stdout, 99, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
}

