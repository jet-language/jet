// Rust: tests/lsp.rs:4962
#Test("lsp_enum_variant_navigation_completion_and_rename") {
    jet :: jet_bin()
    if !jet.exists() -> return
    _guard :: lock_lsp_process()
    source :: "enum Choice {{\n    #Rename(\"wire-ready\") Ready\n    Waiting\n}}\n\n\nfn dot_case(choice: Choice) {{\n    if choice == {{\n        .Ready -> {{\n            return\n        }}\n        .Waiting -> {{\n            return\n        }}\n        else -> {{\n            return\n        }}\n    }}\n}}\n\nfn bare_case(Ready) {{\n    return\n}}\n\n\nfn qualified_case() -> Choice {{\n    return Choice.Ready\n}}\n\n\nfn run() {{}}\n"
    uri :: "file:///tmp/lsp_enum_variant_protocol_test.jet"
    // The protocol boundary is one open document; sibling-module snapshots stay out.
    child := Command.new(jet).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    initialize :: parse_json(request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")).expect("valid initialize response")
    capabilities :: json_object_field(json_object_field(initialize, "result"), "capabilities")
    loop capability in ["completionProvider", "definitionProvider", "referencesProvider", "renameProvider"] {
        assert(json_get(capabilities, capability).is_some(), "initialize omitted {capability}: {initialize:?}")
    }
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}")
    open :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(source)}}}}}}}"
    send_msg(&stdin, open)
    open_diagnostics :: parse_json(read_msg(&stdout)).expect("valid didOpen notification")
    assert_eq(json_str(json_object_field(open_diagnostics, "method")), "textDocument/publishDiagnostics")
    diagnostic_params :: json_object_field(open_diagnostics, "params")
    assert_eq(json_str(json_object_field(diagnostic_params, "uri")), uri)
    _ :: json_array_field(diagnostic_params, "diagnostics")
    position :: (text: &String, offset: USize) -> {
        prefix := text[..offset] // #4303
        line :: prefix.bytes().filter(byte -> byte == b'\n').count()
        character :: prefix.rsplit_once('\n').map_or(prefix.len(), (_, line_text) -> line_text.len())
        (line, character)
    }
    range :: (text: &String, start: USize, end: USize) -> {
        (start_line, start_character) :: position(text, start)
        (end_line, end_character) :: position(text, end)
        parse_json("{{\"start\":{{\"line\":{start_line},\"character\":{start_character}}},\"end\":{{\"line\":{end_line},\"character\":{end_character}}}}}").expect("valid expected LSP range")
    }
    variant_offsets :: (text: &String, variant: &String) -> {
        declaration_marker :: "#Rename(\"wire-ready\") {variant}"
        declaration :: text.find(declaration_marker).expect("variant declaration") + "#Rename(\"wire-ready\") ".len()
        dot_marker :: "        .{variant} ->"
        dot :: text.find(dot_marker).expect("dot variant arm") + "        .".len()
        bare_marker :: "fn bare_case({variant})"
        bare :: text.find(bare_marker).expect("bare variant head") + "fn bare_case(".len()
        qualified_marker :: "Choice.{variant}"
        qualified :: text.find(qualified_marker).expect("qualified variant use") + "Choice.".len()
        [declaration, dot, bare, qualified]
    }
    next_id := 2i64
    request := (method: &String, params: String) -> {
        id :: next_id
        next_id += 1
        body :: request_lsp(&stdin, &stdout, id, method, params)
        parse_json(body).unwrap_or_else(error -> panic("invalid {method} response: {error:?}: {body}"))
    }
    params_at :: (text: &String, offset: USize) -> {
        (line, character) :: position(text, offset)
        "{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":{line},\"character\":{character}}}}}"
    }
    assert_completion :: (response: &DataTree, expected: &[String]) -> {
        assert(json_get(response, "error").is_none(), "completion error: {response:?}")
        result :: json_object_field(response, "result")
        assert_json_values_equal("completion isIncomplete", json_object_field(result, "isIncomplete"), DataTree.Bool(false))
        items :: json_array_field(result, "items")
        labels :: items.iter().map(item -> json_str(json_object_field(item, "label")).expect("completion label")).collect()
        assert_eq(labels.len(), expected.len(), "completion items: {items:?}")
        loop wanted in expected {
            assert_eq(labels.iter().filter(actual -> actual == wanted).count(), 1, "completion identity was duplicated or missing: {labels:?}")
        }
        assert(labels.iter().all(actual -> expected.iter().any(wanted -> wanted == actual)), "completion returned an unrelated enum arm: {labels:?}")
        assert(!labels.iter().any(actual -> actual == "wire-ready"), "completion exposed the string wire name: {labels:?}")
        loop wanted in expected {
            item :: items.iter().find(item -> json_str(json_object_field(item, "label")) == wanted).expect("expected enum completion item")
            assert_json_values_equal("enum completion kind", json_object_field(item, "kind"), DataTree.Int(20))
            assert_eq(json_str(json_object_field(item, "detail")), "variant of Choice")
            variant :: wanted.strip_prefix('.').expect("dot enum completion label")
            expected_insert :: "{variant} -> {{}}"
            assert_eq(json_str(json_object_field(item, "insertText")), expected_insert)
            assert_json_values_equal("enum completion insert format", json_object_field(item, "insertTextFormat"), DataTree.Int(2))
            assert(json_get(item, "additionalTextEdits").is_none(), "same-document enum completion unexpectedly imported a module: {item:?}")
        }
    }
    assert_definition :: (response: &DataTree, expected_range: &DataTree) -> {
        assert(json_get(response, "error").is_none(), "definition error: {response:?}")
        result :: json_object_field(response, "result")
        assert_eq(json_str(json_object_field(result, "uri")), uri)
        assert_json_values_equal("enum definition range", json_object_field(result, "range"), expected_range)
    }
    assert_references :: (response: &DataTree, text: &String, offsets: &[USize], variant: &String) -> {
        assert(json_get(response, "error").is_none(), "references error: {response:?}")
        references :: json_array(json_object_field(response, "result"), "enum references")
        expected_ranges :: offsets.iter().map(offset -> range(text, offset, offset + variant.len())).collect()
        assert_eq(references.len(), expected_ranges.len(), "references included an unrelated enum identity: {references:?}")
        loop reference in references {
            assert_eq(json_str(json_object_field(reference, "uri")), uri)
            actual_range :: json_object_field(reference, "range")
            assert_eq(expected_ranges.iter().filter(expected -> json_values_equal(actual_range, expected)).count(), 1, "reference was not one of this enum's source occurrences: {reference:?}")
        }
        loop expected in expected_ranges {
            assert_eq(references.iter().filter(reference -> json_values_equal(json_object_field(reference, "range"), expected)).count(), 1, "reference occurrence was duplicated or missing: {references:?}")
        }
    }
    assert_rename :: (response: &DataTree, text: &String, offsets: &[USize], old_name: &String, new_name: &String, version: I64) -> {
        assert(json_get(response, "error").is_none(), "rename error: {response:?}")
        result :: json_object_field(response, "result")
        changes :: json_array_field(result, "documentChanges")
        assert_eq(changes.len(), 1, "rename crossed a document boundary: {result:?}")
        change :: changes[0]
        document :: json_object_field(change, "textDocument")
        assert_eq(json_str(json_object_field(document, "uri")), uri)
        assert_json_values_equal("rename checked document version", json_object_field(document, "version"), DataTree.Int(version))
        edits :: json_array_field(change, "edits")
        expected_ranges :: offsets.iter().map(offset -> range(text, offset, offset + old_name.len())).collect()
        assert_eq(edits.len(), expected_ranges.len(), "rename lost or duplicated an enum occurrence: {edits:?}")
        loop edit in edits {
            assert_eq(json_str(json_object_field(edit, "newText")), new_name)
            actual_range :: json_object_field(edit, "range")
            assert_eq(expected_ranges.iter().filter(expected -> json_values_equal(actual_range, expected)).count(), 1, "rename edited an unrelated range: {edit:?}")
        }
        loop expected in expected_ranges {
            assert_eq(edits.iter().filter(edit -> json_values_equal(json_object_field(edit, "range"), expected)).count(), 1, "rename occurrence was duplicated or missing: {edits:?}")
        }
        operations :: json_array_field(result, "semantic_ops")
        assert_eq(operations.len(), 1)
        operation :: operations[0]
        assert_eq(json_str(json_object_field(operation, "kind")), "rename")
        assert_eq(json_str(json_object_field(operation, "from")), old_name)
        assert_eq(json_str(json_object_field(operation, "to")), new_name)
        _ :: json_array_field(operation, "targets")
    }
    initial_offsets :: variant_offsets(source, "Ready")
    initial_definition_range :: range(source, initial_offsets[0], initial_offsets[0] + "Ready".len())
    completion :: request("textDocument/completion", params_at(source, initial_offsets[1]))
    assert_completion(completion, [".Ready", ".Waiting"])
    loop offset in initial_offsets {
        definition :: request("textDocument/definition", params_at(source, offset))
        assert_definition(definition, initial_definition_range)
        params_prefix := params_at(source, offset).strip_suffix('}').expect("params object") // #4303
        references :: request("textDocument/references", "{params_prefix},\"context\":{{\"includeDeclaration\":true}}}}")
        assert_references(references, source, initial_offsets, "Ready")
        prepare :: request("textDocument/prepareRename", params_at(source, offset))
        assert(json_get(prepare, "error").is_none(), "prepare rename error: {prepare:?}")
        prepare_result :: json_object_field(prepare, "result")
        expected_prepare_range :: range(source, offset, offset + "Ready".len())
        assert_json_values_equal("prepare rename range", json_object_field(prepare_result, "range"), expected_prepare_range)
        assert_eq(json_str(json_object_field(prepare_result, "placeholder")), "Ready")
    }
    rename_prefix := params_at(source, initial_offsets[3]).strip_suffix('}').expect("params object") // #4303
    renamed :: request("textDocument/rename", "{rename_prefix},\"newName\":\"Renamed\"}}")
    assert_rename(renamed, source, initial_offsets, "Ready", "Renamed", 1)
    drop(^request)
    updated :: source.replacen("#Rename(\"wire-ready\") Ready", "#Rename(\"wire-ready\") Queued", 1)
        .replacen("    Waiting\n}}\n", "}}\n", 1)
        .replacen(".Ready ->", ".Queued ->", 1)
        .replacen("fn bare_case(Ready)", "fn bare_case(Queued)", 1)
        .replacen("Choice.Ready", "Choice.Queued", 1)
    assert(updated.contains("#Rename(\"wire-ready\") Queued"))
    initial_checked :: "{check_document("lsp_enum_variant_protocol_test.jet", source):?}"
    updated_checked :: "{check_document("lsp_enum_variant_protocol_test.jet", updated):?}"
    assert_ne(updated_checked, initial_checked, "changing the enum case set must refresh checked diagnostics")
    assert(updated_checked.contains("Waiting"), "removing Waiting must retain a diagnostic for the stale case")
    change :: "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":2}},\"contentChanges\":[{{\"text\":{json_string(updated)}}}]}}}}"
    send_msg(&stdin, change)
    request := (method: &String, params: String) -> {
        id :: next_id
        next_id += 1
        body :: request_lsp(&stdin, &stdout, id, method, params)
        parse_json(body).unwrap_or_else(error -> panic("invalid {method} response: {error:?}: {body}"))
    }
    updated_offsets :: variant_offsets(updated, "Queued")
    updated_definition_range :: range(updated, updated_offsets[0], updated_offsets[0] + "Queued".len())
    updated_completion :: request("textDocument/completion", params_at(updated, updated_offsets[1]))
    assert_completion(updated_completion, [".Queued"])
    loop offset in updated_offsets {
        definition :: request("textDocument/definition", params_at(updated, offset))
        assert_definition(definition, updated_definition_range)
        params_prefix := params_at(updated, offset).strip_suffix('}').expect("params object") // #4303
        references :: request("textDocument/references", "{params_prefix},\"context\":{{\"includeDeclaration\":true}}}}")
        assert_references(references, updated, updated_offsets, "Queued")
    }
    updated_prepare :: request("textDocument/prepareRename", params_at(updated, updated_offsets[2]))
    assert(json_get(updated_prepare, "error").is_none())
    updated_prepare_result :: json_object_field(updated_prepare, "result")
    updated_prepare_range :: range(updated, updated_offsets[2], updated_offsets[2] + "Queued".len())
    assert_json_values_equal("updated prepare rename range", json_object_field(updated_prepare_result, "range"), updated_prepare_range)
    assert_eq(json_str(json_object_field(updated_prepare_result, "placeholder")), "Queued")
    updated_rename_prefix := params_at(updated, updated_offsets[2]).strip_suffix('}').expect("params object") // #4303
    updated_rename :: request("textDocument/rename", "{updated_rename_prefix},\"newName\":\"Finished\"}}")
    assert_rename(updated_rename, updated, updated_offsets, "Queued", "Finished", 2)
    shutdown :: request("shutdown", "{{}}")
    assert_json_values_equal("shutdown result", json_object_field(shutdown, "result"), DataTree.Null)
    drop(^request)
    drop(^stdin)
    assert(child.wait().expect("wait for jet self lsp").success())
}

// Rust: tests/lsp.rs:5461
#Test("c40_is_keyword_retired_words_not_keywords") {
    diags :: check_document("c40_retired.jet", "fn run() {{\n    switch_count :: 0\n    import_count :: 1\n}}\n")
    assert(!diags.iter().any(d -> {
        t :: "{d.what} {d.why} {d.fix}"
        t.contains("switch_count") && t.contains("keyword")
    }), "switch_count should not be rejected as a keyword: {diags:?}")
}

// Rust: tests/lsp.rs:5482
#Test("c40_is_keyword_real_keywords_recognized") {
    jet :: jet_bin()
    if !jet.exists() -> return
    source :: "fn greet() {{}}\nfn run() {{\n    greet()\n}}\n"
    uri :: "file:///tmp/c40_rename_keyword.jet"
    run_transcript(source, [
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: ["renameProvider"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
        TranscriptStep.Open { uri: uri, expect_notification: true },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/rename\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":0,\"character\":3}},\"newName\":\"if\"}}}}", expect_contains: ["error"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
    ])
}

