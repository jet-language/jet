#Test("lsp_generated_definition_uses_selected_buildplan_identity") {
    jet :: jet_bin()
    if !jet.exists() -> return
    root :: Scratch.new("lsp-generated-definition-identity")
    fs.write(root.join("package.jet"), "name: \"main\"\nversion: \"0.1.0\"\n").expect("write generated identity package manifest")
    fs.write(root.join("workspace.jet"), "module workspace {{ members: [] }}\n").expect("write generated identity workspace authority")
    source_for :: (first: &String, second: &String, selected: &String) -> "fn build(b: BuildContext) -> BuildPlan {{\n    b.generate(\"{first}\") {{\n        fn generated_value() -> String {{ \"{first}\" }}\n    }}\n    b.generate(\"{second}\") {{\n        fn generated_value() -> String {{ \"{second}\" }}\n    }}\n    app :: b.add_executable(\"app\", [\"main.jet\", \".jet/generated/main/{selected}.jet\"], [])\n    return b.plan(app)\n}}\nfn run() {{\n    generated_value()\n}}\n"
    run_case :: (source: String, selected: &String) -> {
        fs.write(root.join("main.jet"), source).expect("write selected generated source")
        uri :: "file://{root.join("main.jet").display()}"
        run_transcript(source, [
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: ["definitionProvider"] },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
            TranscriptStep.Open { uri: uri, expect_notification: true },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":11,\"character\":10}}}}}}", expect_contains: [
                "\"identity\":\"fn:module:{selected}::generated_value\"", "\"generated\":true",
                "\"artifact\":\".jet/generated/main/{selected}.jet\"", "\"status\":\"available\"",
                "\"generator\":\"{selected}\"", "\"schema\":null", "\"source\":\".jet/generated/main/{selected}.jet\"",
                "\"plugin\":null", "\"range\":{{\"start\":{{\"line\":0,\"character\":3}},\"end\":{{\"line\":0,\"character\":18}}}}"
            ] },
            TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
        ])
    }
    run_case(source_for("right", "left", "left"), "left")
    run_case(source_for("left", "right", "right"), "right")
}

