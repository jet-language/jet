// Rust: tests/lsp.rs:3569
// Rust #[ignore]: measurement receipt; run explicitly with --ignored --nocapture.
#Test("lsp_repeated_edit_stream_latency") {
    EDITS :: 200i64
    CALLERS :: 256usize
    _guard :: lock_lsp_process()
    binary :: fs.read(jet_bin()).expect("read jet binary")
    child := Command.new(jet_bin()).args(["self", "lsp"]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("spawn jet self lsp")
    stdin := child.stdin.take().expect("stdin")
    stdout := child.stdout.take().expect("stdout")
    uri :: "file:///tmp/lsp_repeated_edit_stream.jet"
    base :: costly_source("marker_0", CALLERS)
    _ :: request_lsp(&stdin, &stdout, 1, "initialize", "{{\"capabilities\":{{}}}}")
    send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"languageId\":\"jet\",\"version\":1,\"text\":{json_string(base)}}}}}}}")
    symbols :: "{{\"textDocument\":{{\"uri\":\"{uri}\"}}}}"
    verdicts := [Duration]()
    releases := [Duration]()
    late_cancels := 0usize
    peak_waiting := 0usize
    loop edit in 1..=EDITS {
        version :: edit + 1
        marker :: "marker_{edit}"
        started :: Instant.now()
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":{version}}},\"contentChanges\":[{{\"text\":{json_string(costly_source(marker, CALLERS))}}}]}}}}")
        request_id :: 1000 + edit
        send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":{request_id},\"method\":\"textDocument/documentSymbol\",\"params\":{symbols}}}")
        waiting := 1usize
        cancel_id :: 5000 + edit
        cancel_sent := none as Instant?
        if edit % 10 == 0 {
            send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"id\":{cancel_id},\"method\":\"textDocument/documentSymbol\",\"params\":{symbols}}}")
            send_msg(&stdin, "{{\"jsonrpc\":\"2.0\",\"method\":\"$/cancelRequest\",\"params\":{{\"id\":{cancel_id}}}}}")
            cancel_sent = Instant.now()
            waiting += 1
        }
        peak_waiting = peak_waiting.max(waiting)
        verdict := none as Duration?
        loop waiting > 0 {
            message :: parse_json(read_msg(&stdout)).expect("valid LSP message")
            params :: json_get(message, "params")
            if verdict.is_none() && json_get(message, "method").and_then(json_str) == "textDocument/publishDiagnostics" && params.and_then(params -> json_get(params, "version")) == DataTree.Int(version) {
                verdict = started.elapsed()
            }
            match json_get(message, "id") {
                DataTree.Int(id) if id == request_id -> {
                    assert("{message:?}".contains(marker), "stale symbols: {message:?}")
                    waiting -= 1
                }
                DataTree.Int(id) if id == cancel_id -> {
                    releases.push(cancel_sent.expect("cancel was sent").elapsed())
                    if json_get(message, "error").is_none() -> late_cancels += 1
                    waiting -= 1
                }
                else -> {}
            }
        }
        verdicts.push(verdict.unwrap_or_else(() -> panic("no verdict published for revision {version}")))
    }
    _ :: request_lsp(&stdin, &stdout, 99, "shutdown", "{{}}")
    drop(^stdin)
    assert(child.wait().unwrap().success())
    print("binary: {jet_bin().display()} sha256={sha256_hex(binary)}")
    print("input: {EDITS} full-text edits of a {CALLERS}-caller document ({base.len()} bytes, sha256={sha256_hex(base.as_bytes())}), one documentSymbol per edit, a cancelled documentSymbol every 10th edit")
    print("edit-to-current-verdict: p50={percentile(&verdicts, 50):?} p95={percentile(&verdicts, 95):?}")
    print("cancel-to-release: p50={percentile(&releases, 50):?} p95={percentile(&releases, 95):?} ({releases.len()} cancels, {late_cancels} completed before the cancel was seen)")
    print("peak client requests awaiting an answer: {peak_waiting}; server loop checks one request at a time")
}

// Rust: tests/lsp.rs:3684
#Test("lsp_accepts_hidden_generic_constructor_arguments") {
    source :: "struct Box<T> {{\n    value: T\n}}\nimpl Box {{\n    fn new(value: ^T) -> Box<T> {{ return Box<T>{{ value: value }} }}\n}}\nfn run() {{\n    inferred :: Box.new(1)\n    explicit :: Box<Int>.new(2)\n}}\n"
    uri :: "file:///tmp/lsp_generic_constructor_infer.jet"
    run_transcript(source, [
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"capabilities\":{{}}}}}}", expect_contains: ["hoverProvider"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}", expect_contains: none },
        TranscriptStep.Open { uri: uri, expect_notification: true },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"{uri}\"}},\"position\":{{\"line\":4,\"character\":7}}}}}}", expect_contains: ["new", "Box<T>"] },
        TranscriptStep.Send { msg: "{{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\",\"params\":{{}}}}", expect_contains: ["result"] }
    ])
}

