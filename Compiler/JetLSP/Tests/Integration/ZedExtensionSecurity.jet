// Rust: tests/zed_extension_security.rs:1
// Structural security checks: Zed owns worktree trust and extension execution.
use std.[env]

// Rust: tests/zed_extension_security.rs:17
fn repo_root() -> OSPath { OSPath.from(env.manifest_dir()) }

// Rust: tests/zed_extension_security.rs:21
fn artifact_contains(artifact: &[U8], needle: &[U8]) -> Bool {
    artifact.windows(needle.len()).any(window -> window == needle)
}
