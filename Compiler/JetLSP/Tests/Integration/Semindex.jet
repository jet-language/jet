// This rule integration tests for the stable semantic-index API.
use {
    jet_semindex.[SemanticProvenance, SemanticSymbol, SemanticSymbolKind]
    std.[fs, env, process]
}
// GATE #4494: native filesystem and process identity.

fixture: fn(name: String) -> OSPath { OSPath.from(env.manifest_dir()).join("Examples/features").join(name) }

temp_fixture: fn(name: String, src: String) -> OSPath {
    dir: env.temp_dir().join("jet_semindex_{process.id()}")
    fs.create_dir_all(dir).expect("semindex temp dir")
    path: dir.join(name)
    fs.write(path, src).expect("write semindex fixture")
    path.move()
}

fact: fn(identity: String, name: String, qualified_name: String, kind: SemanticSymbolKind, provenance: SemanticProvenance) -> SemanticSymbol {
    SemanticSymbol {
        identity: identity.clone(), name: name.clone(), qualified_name: qualified_name.clone(),
        owner: qualified_name.split_once('.').map((owner, _) -> owner.to_string()),
        module_path: "test", kind: kind, signature: identity.clone(), summary: String.new(), examples: [],
        provenance: provenance.move(), span: none, lexical_scope: none
    }
}
