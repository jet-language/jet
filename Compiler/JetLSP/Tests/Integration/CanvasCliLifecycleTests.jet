// Rust: tests/dev_schedule_wave_a.rs:11
#Test("local_schedule_restart_does_not_replay_a_missed_window") {
    const DAY: U64 = 86400
    const THREE_AM: U64 = 3 * 3600
    schedule :: [("nightly", JetJobSchedule.WallClockTime{hour: 3, minute: 0})]
    missed :: DAY + THREE_AM + 61
    before_restart := JetJobClock.new()
    assert((&before_restart.due_at(schedule, missed)).is_empty(), "a missed local schedule window must not be replayed before restart")
    after_restart := JetJobClock.new()
    assert((&after_restart.due_at(schedule, missed)).is_empty(), "a fresh local clock must not replay an earlier missed occurrence")
    assert_eq(&after_restart.due_at(schedule, DAY * 2 + THREE_AM), ["nightly"])
}

// Rust: tests/dev_tier_parity.rs:10
#Test("target_selected_prelude_parity") {
    root :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap())
    hosted :: root.join("tests/target_witness/hosted_default.jet")
    assert_cranelift_three_way(hosted.to_string_lossy(), "target_selected_prelude_parity_hosted")
    no_os :: TargetMachine.wasm_no_os()
    assert(no_os.supports_execution_tier(ExecutionTier.Aot).is_ok())
    loop tier in [ExecutionTier.Dev, ExecutionTier.Jit] {
        assert(no_os.supports_execution_tier(tier) == { Err(TargetMachineError.ExecutionTierUnsupported{..}) -> true, else -> false })
    }
    source :: root.join("tests/target_witness/heap_free_core.jet").to_string_lossy().to_string()
    loop machine in [no_os, TargetMachine.wasm_wasi(), TargetMachine.wasm_browser()] {
        provider :: machine.provider_identity()
        layer :: machine.max_runtime_layer().as_str()
        environment :: machine.environment_identity()
        output :: compile_bundle_path_with_target_machine(source, CompileMode.Run, machine)
            .unwrap_or_else((error) -> panic("target-selected heap-free witness should compile for {machine.name}: {error:?}"))
        if machine.is_browser_target() {
            web :: output.web.expect("browser target must emit web artifacts")
            assert(web.manifest_json.contains("\"providerIdentity\": \"{provider}\""), "browser manifest lost provider identity: {web.manifest_json}")
            assert(web.manifest_json.contains("\"targetEnvironment\": \"{environment}\""), "browser manifest lost target environment: {web.manifest_json}")
            assert(web.manifest_json.contains("\"preludeClosureIdentity\": \"prelude-closure-v1:"), "browser manifest lost Prelude closure identity: {web.manifest_json}")
        } else {
            marker :: "// jet:target-dossier layer={layer} provider={provider}"
            assert(output.rust.contains(marker), "{machine.name} artifact lost target dossier marker {marker:?}")
            assert(output.rust.contains("closure=prelude-closure-v1:"), "{machine.name} artifact lost Prelude closure identity")
        }
    }
}

