// Rust: tests/dev_corpus_gate.rs:33
#Test("tower_datatree_policy_rejects_duplicate_generic_ladders") {
    policy :: CorpusPolicy.load().expect("corpus manifest")
    violations :: policy.evaluate_source(TOWER_DATATREE_POLICY_SITE, "\nfn duplicate_equal(left: DataTree, right: DataTree) -> Bool {{ return true }}\nfn arrays_semantically_equal(left: [DataTree], right: [DataTree]) -> Bool {{ return true }}\nfn truthy(value: DataTree) -> Bool {{ return true }}\nfn javascript_truthy_duplicate(value: DataTree) -> Bool {{ return true }}\n").expect("synthetic Tower source parses")
    assert_eq(violations.len(), 4, "all duplicate generic helpers must be rejected once: {violations:?}")
    assert(violations.all((violation) -> violation.rule == "datatree-domain-policy"), "one occurrence-scoped DataTree rule must own every rejection: {violations:?}")
}

