// Rust: tests/canvas.rs:11
// GATE #4494: filesystem/process primitives retain actual providers.
fn temp_dir(tag: String) -> OSPath {
    dir :: env.temp_dir().join("jet_canvas_{tag}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).expect("create canvas directory")
    dir
}
// Rust: tests/canvas.rs:18
fn write_fixture(tag: String, src: String) -> OSPath {
    path :: temp_dir(tag).join("main.jet")
    fs.write(path, src).expect("write canvas fixture")
    path
}
// Rust: tests/canvas.rs:25
fn ast_enum_variants(path: String, enum_name: String) -> [String] {
    src :: fs.read_to_string(OSPath(path)).expect("read {path}")
    marker :: "enum {enum_name}"
    variants := [String]{}
    in_enum := false
    depth := 0
    loop line in src.lines() {
        code := line.split("//")[0] // #4303
        if !in_enum {
            if code.find(marker) == .Val(pos) {
                in_enum = true
                loop ch in code.slice(pos, code.bytes().len()).chars() {
                    if ch == '{' -> depth += 1
                    else if ch == '}' -> depth -= 1
                }
            }
            next
        }
        if depth == 1 {
            if variant_name(code) == .Val(name) -> &variants.push(name)
        }
        loop ch in code.chars() {
            if ch == { '{' | '(' | '[' -> depth += 1, '}' | ')' | ']' -> depth -= 1, else -> {} }
        }
        if depth == 0 -> break
    }
    assert(!variants.is_empty(), "missing {marker} variants in {path}")
    variants
}
// Rust: tests/canvas.rs:66
fn variant_name(chunk: String) -> String? {
    loop raw in chunk.lines() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with("///") || line.starts_with("//") || line.starts_with("#[") -> next
        if !line.chars().first().is_some_and((ch) -> ch.is_uppercase()) -> next
        end :: line.find((ch) -> !(ch.is_ascii_alphanumeric() || ch == '_')) ?? line.bytes().len()
        return Val(line.slice(0, end))
    }
    None
}

