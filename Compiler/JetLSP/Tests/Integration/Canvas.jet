    loop (name, pattern) in [("arm1", "0"), ("arm2", "1")] {
        pin :: pins.find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {choose}")
        assert(pin.contains("\"pattern_source\":\"{pattern}\""), pin)
        offset :: source.find("{pattern} ->").expect("arm source span")
        assert(pin.contains("\"source_span\":{{\"start\":{offset},\"end\":"), "source span does not identify {pattern} arm: {pin}")
    }
}
// Rust: tests/canvas.rs:855
#Test("canvas_rejects_ambiguous_package_facts_before_projection") {
    dir :: temp_dir("graph_ambiguous_package")
    fs.write(dir.join("package.jet"), "name: \"canonical\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join(PAYLOAD_FILE), "name: \"legacy\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{}}\n").unwrap()
    diagnostics :: graph_json_for_file(entry).expect_err("Canvas must reject ambiguous package facts")
    assert(diagnostics.find((diagnostic) -> diagnostic.code == "E1206") != None, "{diagnostics}")
}
