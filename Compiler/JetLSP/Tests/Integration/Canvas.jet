// Rust: tests/canvas.rs:449
fn field_before(haystack: String, marker: String, field: String) -> String {
    end :: haystack.find(marker) ?? panic("marker in graph JSON: {marker}")
    prefix := haystack.slice(0, end) // #4303
    key :: "\"{field}\":\""
    start :: (prefix.rfind(key) ?? panic("field before marker")) + key.bytes().len()
    rest := prefix.slice(start, prefix.bytes().len()) // #4303
    rest.slice(0, rest.find('"') ?? panic("field terminator"))
}
// Rust: tests/canvas.rs:460
fn first_source_wire_id(graph: String) -> String {
    loop chunk in graph.split("\"wire_id\":\"").skip(1) {
        if chunk.contains("\"source_span\":{{\"") -> return chunk.slice(0, chunk.find('"') ?? panic("wire id terminator"))
    }
    panic("source-backed wire in graph JSON")
}
// Rust: tests/canvas.rs:469
fn first_node_id_containing(graph: String, needle: String) -> String {
    loop chunk in graph.split("\"node_id\":\"").skip(1) {
        id := chunk.slice(0, chunk.find('"') ?? panic("node id terminator")) // #4303
        if id.contains(needle) -> return id
    }
    panic("node id containing {needle}")
}
// Rust: tests/canvas.rs:479
fn count_occurrences(haystack: String, needle: String) -> Int { haystack.match_indices(needle).count() }
// Rust: tests/canvas.rs:483
fn json_quote(value: String) -> String {
    out := "\""
    loop ch in value.chars() {
        if ch == {
            '\\' -> out += "\\\\"
            '"' -> out += "\\\""
            '\n' -> out += "\\n"
            '\r' -> out += "\\r"
            '\t' -> out += "\\t"
            else -> {
                if ch.is_control() -> out += "\\u{ch.to_u32():04x}"
                else -> out.push(ch)
            }
        }
    }
    out += "\""
    out
}
// Rust: tests/canvas.rs:500
fn json_field(haystack: String, field: String) -> String {
    key :: "\"{field}\":\""
    start :: (haystack.find(key) ?? panic("json field")) + key.bytes().len()
    rest := haystack.slice(start, haystack.bytes().len()) // #4303
    rest.slice(0, rest.find('"') ?? panic("json field terminator"))
}
// Rust: tests/canvas.rs:507
fn json_array_field(haystack: String, field: String) -> String {
    marker :: "\"{field}\":["
    start :: (haystack.find(marker) ?? panic("missing JSON array `{field}`")) + marker.bytes().len()
    depth := 1
    in_string := false
    escaped := false
    bytes :: haystack.bytes()
    loop offset in start..<bytes.len() {
        byte :: bytes[offset]
        if in_string {
            if escaped -> escaped = false
            else if byte == 92 -> escaped = true
            else if byte == 34 -> in_string = false
            next
        }
        if byte == {
            34 -> in_string = true
            91 -> depth += 1
            93 -> { depth -= 1; if depth == 0 -> return haystack.slice(start, offset) }
            else -> {}
        }
    }
    panic("unterminated JSON array `{field}`")
}
// Rust: tests/canvas.rs:542
fn json_top_level_objects(array: String) -> [String] {
    objects := [String]{}
    start := Int?{None}
    depth := 0
    in_string := false
    escaped := false
    bytes :: array.bytes()
    loop offset in 0..<bytes.len() {
        byte :: bytes[offset]
        if in_string {
            if escaped -> escaped = false
            else if byte == 92 -> escaped = true
            else if byte == 34 -> in_string = false
            next
        }
        if byte == {
            34 -> in_string = true
            123 -> { if depth == 0 -> start = Val(offset); depth += 1 }
            125 -> {
                depth -= 1
                if depth == 0 {
                    object_start :: start ?? panic("top-level JSON object start")
                    start = None
                    &objects.push(array.slice(object_start, offset + 1))
                }
            }
            else -> {}
        }
    }
    assert_eq(depth, 0, "unterminated top-level JSON object: {array}")
    objects
}
// Rust: tests/canvas.rs:581
fn source_span_near(haystack: String, marker: String) -> (Int, Int) {
    pos :: haystack.find(marker) ?? panic("marker near source span")
    rest := haystack.slice(pos, haystack.bytes().len()) // #4303
    key :: "\"source_span\":{{\"start\":"
    start_pos :: (rest.find(key) ?? panic("source span after marker")) + key.bytes().len()
    rest = rest.slice(start_pos, rest.bytes().len())
    start :: rest.slice(0, rest.find(',') ?? panic("span comma")).parse<Int>().expect("span start")
    end_key :: "\"end\":"
    end_pos :: (rest.find(end_key) ?? panic("span end")) + end_key.bytes().len()
    rest = rest.slice(end_pos, rest.bytes().len())
    end_text :: rest.chars().take_while((ch) -> ch.is_ascii_digit()).collect<String>()
    (start, end_text.parse<Int>().expect("span end number"))
}
// Rust: tests/canvas.rs:601
fn source_span_at_or_after(haystack: String, marker: String, minimum_start: Int) -> (Int, Int) {
    search_from := 0
    loop {
        found :: haystack.slice(search_from, haystack.bytes().len()).find(marker) ?? break
        pos :: search_from + found
        (start, end) :: source_span_near(haystack.slice(pos, haystack.bytes().len()), marker)
        if start >= minimum_start -> return (start, end)
        search_from = pos + marker.bytes().len()
    }
    panic("marker has no source span at or after {minimum_start}: {marker}")
}
// Rust: tests/canvas.rs:614
fn graph_id_for_title(graph: String, title: String) -> String { field_before(graph, "\"title\":\"{title}\"", "graph_id") }
// Rust: tests/canvas.rs:618
fn graph_object_for_title(graph: String, title: String) -> String {
    loop candidate in json_top_level_objects(json_array_field(graph, "graphs")) {
        if candidate.contains("\"title\":\"{title}\"") -> return candidate
    }
    panic("graph object for {title}")
}
// Rust: tests/canvas.rs:625
fn name_span(src: String, name: String) -> (Int, Int) {
    start :: src.find("{name} ::") ?? panic("binding name span")
    (start, start + name.bytes().len())
}
// Rust: tests/canvas.rs:630
fn source_order(src: String, names: [String]) -> [Int] {
    out := [Int]{}
    loop name in names -> &out.push(src.find("{name} ::") ?? panic("source name"))
    out
}

// Rust: tests/canvas.rs:638
#Test("canvas_graph_json_is_stable_and_typed") {
    path :: write_fixture("graph", CANVAS_FIXTURE)
    json :: graph_json_for_file(path).expect("canvas graph")
    assert(json.starts_with("{{\"schema\":\"jet.status/v1\""), json)
    assert_eq(read_machine_line(json), Ok(MachineRecord.Status))
    loop field in ["\"protocol\":\"jet.canvas.graph\"", "\"schema_version\":1", "\"node_descriptors\":[", "\"node_descriptor_id\":\"branch\"", "\"source_id\"", "\"fmt_fingerprint\":\"sha256-", "\"graph_id\":\"fn:", "\"title\":\"summarize\"", "\"kind\":\"branch\"", "\"kind\":\"function\"", "\"archetype\":\"entry\"", "\"archetype\":\"control\"", "\"archetype\":\"function_exec\"", "\"archetype\":\"function_pure\"", "\"archetype\":\"value\"", "\"kind\":\"variable_get\"", "\"kind\":\"constant\"", "\"type\":\"Int\"", "\"wire_kind\":\"data\"", "\"wire_kind\":\"control\"", "\"from_source_span\":", "\"to_source_span\":", "\"type\":\"exec\"", "\"ability\":\"control\"", "\"inline_exprs\"", "total > 10"] -> assert(json.contains(field), json)
    square_call :: first_node_id_containing(json, ":call:square")
    binding :: first_node_id_containing(json, ":stmt:1:binding")
    assert(json.contains("\"from_pin\":\"{square_call}:output:result\",\"to_pin\":\"{binding}:input:value\",\"wire_kind\":\"data\""), "pure function calls should feed data pins: {json}")
    assert(!json.contains("\"pin_id\":\"{square_call}:input:exec\""), "pure expression call must not carry exec pin: {json}")
    again :: graph_json_for_file(path).expect("canvas graph again")
    assert_eq(json, again, "Canvas layout/projection must be deterministic")
}
// Rust: tests/canvas.rs:694
#Test("canvas_projects_labeled_execution_outputs_for_loops_and_early_returns") {
    path :: write_fixture("multi_exec_outputs", "fn paths(limit: Int) -> Int {{\n    loop i in 0..<limit {{\n        if i == 1 {{\n            return i\n        }} else {{\n            print(i)\n        }}\n    }}\n    return 0\n}}\n\nfn run() {{\n    print(paths(3))\n}}\n")
    graph :: graph_json_for_file(path).expect("multi-exec graph")
    paths :: graph_object_for_title(graph, "paths")
    loop (name, role) in [("body", "loop_body"), ("done", "loop_done"), ("return", "early_return")] {
        field :: "\"name\":\"{name}\",\"direction\":\"output\",\"type\":\"exec\",\"role\":\"{role}\""
        assert(paths.contains(field), "paths graph missing {field}: {paths}")
        pin :: json_top_level_objects(json_array_field(paths, "pins")).find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {paths}")
        assert(pin.contains("\"role\":\"{role}\""), "pin role drift: {pin}")
        assert(pin.contains("\"source_span\":{{\"start\":"), "pin provenance missing: {pin}")
    }
    assert(paths.contains("\"name\":\"then\""), "branch then output missing: {paths}")
    assert(paths.contains("\"name\":\"else\""), "branch else output missing: {paths}")
}
// Rust: tests/canvas.rs:755
#Test("canvas_projects_switch_arm_outputs_with_source_provenance") {
    path :: write_fixture("multi_exec_switch_outputs", "fn choose(value: Int) -> Int {{\n    if value == {{\n        0 -> {{ return 0 }}\n        1 -> {{ return 1 }}\n        else -> {{ return 2 }}\n    }}\n}}\n\nfn run() {{ print(choose(1)) }}\n")
    source :: fs.read_to_string(path).unwrap()
    assert_eq(format_source(source).unwrap(), source)
    graph :: graph_json_for_file(path).expect("switch multi-exec graph")
    choose :: graph_object_for_title(graph, "choose")
    pins :: json_top_level_objects(json_array_field(choose, "pins"))
    loop (name, pattern) in [("arm1", "0"), ("arm2", "1")] {
        pin :: pins.find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {choose}")
        loop field in ["\"direction\":\"output\"", "\"type\":\"exec\"", "\"role\":\"arm\""] -> assert(pin.contains(field), pin)
        assert(pin.contains("\"pattern_source\":\"{pattern}\""), "pattern provenance missing: {pin}")
        offset :: source.find("{pattern} ->").expect("arm source span")
        assert(pin.contains("\"source_span\":{{\"start\":{offset},\"end\":"), "source span does not identify {pattern} arm: {pin}")
    }
    else_pin :: pins.find((pin) -> pin.contains("\"name\":\"else\"")).expect("missing else pin")
    loop field in ["\"direction\":\"output\"", "\"type\":\"exec\"", "\"role\":\"else\"", "\"source_span\":{{\"start\":"] -> assert(else_pin.contains(field), else_pin)
    assert(!source.contains("=>"), "retired arrow spelling leaked: {source}")
}
