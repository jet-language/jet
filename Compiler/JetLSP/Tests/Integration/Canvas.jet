#Test("canvas_projects_pattern_arm_and_multi_input_pin_metadata") {
    path: write_fixture("pattern_multi", CANVAS_PATTERN_MULTI_FIXTURE)
    graph: graph_json_for_file(path).expect("canvas graph")
    loop field in ["\"role\":\"arm\"", "\"pattern_source\":\"== Val(n)\"", "\"pattern_source_span\":", "\"name\":\"arm1\"", "\"name\":\"else\"", "\"add_pattern_arm\"", "\"title\":\"list\"", "\"append_multi_input\"", "\"append_op\":\"remove_multi_input_element\"", "\"name\":\"item1\"", "\"name\":\"item2\"", "\"name\":\"item3\""] -> assert(graph.contains(field), "pattern/multi-input graph missing {field}: {graph}")
}
#Test("canvas_pattern_arm_and_multi_input_transactions_write_source") {
    path: write_fixture("pattern_arm_tx", "Choice: enum {{\n    A(Int)\n    B(Int)\n    C(Int)\n}}\n\nchoose: fn(x: Choice) -> Int {{\n    if x == {{\n        .A(n) -> {{ return n }}\n        else -> {{ return 0 }}\n    }}\n}}\n\nrun: fn() {{\n    print(choose(Choice.A(1)))\n}}\n")
    graph: graph_json_for_file(path).expect("canvas graph")
    graph_id: graph_id_for_title(graph, "choose")
    (node_start, node_end): source_span_near(graph, "\"title\":\"if ==\"")
    revision: source_revision(fs.read_to_string(path).unwrap())
    add: "{{\"schema_version\":1,\"op\":\"add_pattern_arm\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end},\"pattern\":\"== .B(n)\"}}"
    out: apply_transaction_json(path, add).expect("add arm")
    assert(out.contains("\"changed\":true"), out)
    added: fs.read_to_string(path).unwrap()
    assert(added.contains(".B(n) ->"), added)
    assert(added.contains("return 1"), "fresh arm uses sema-safe default return body: {added}")
    graph: graph_json_for_file(path).expect("graph after add")
    (pat_start, pat_end): source_span_near(graph, "\"pattern_source\":\"B(n)\"")
    revision: source_revision(added)
    edit: "{{\"schema_version\":1,\"op\":\"edit_pattern_arm\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\",\"pattern_start\":{pat_start},\"pattern_end\":{pat_end},\"pattern\":\"== .C(n)\"}}"
    apply_transaction_json(path, edit).expect("edit arm")
    edited: fs.read_to_string(path).unwrap()
    assert(edited.contains(".C(n) ->"), edited)
    assert(!edited.contains(".B(n) ->"), edited)
    graph: graph_json_for_file(path).expect("graph after edit")
    (pat_start, pat_end): source_span_near(graph, "\"pattern_source\":\"C(n)\"")
    revision: source_revision(edited)
    remove: "{{\"schema_version\":1,\"op\":\"remove_pattern_arm\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\",\"pattern_start\":{pat_start},\"pattern_end\":{pat_end}}}"
    apply_transaction_json(path, remove).expect("remove arm")
    removed: fs.read_to_string(path).unwrap()
    assert(!removed.contains(".C(n) ->"), removed)
    invalid_path: write_fixture("pattern_arm_invalid_tx", "Choice: enum {{\n    A(Int)\n}}\n\nchoose: fn(x: Choice) -> Int {{\n    if x == {{\n        .A(n) -> {{ return n }}\n    }}\n}}\n\nrun: fn() {{\n    print(choose(Choice.A(1)))\n}}\n")
    graph: graph_json_for_file(invalid_path).expect("invalid graph")
    graph_id: graph_id_for_title(graph, "choose")
    (pat_start, pat_end): source_span_near(graph, "\"pattern_source\":\"A(n)\"")
    before: fs.read_to_string(invalid_path).unwrap()
    revision: source_revision(before)
    remove_last: "{{\"schema_version\":1,\"op\":\"remove_pattern_arm\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\",\"pattern_start\":{pat_start},\"pattern_end\":{pat_end}}}"
    err: apply_transaction_json(invalid_path, remove_last).unwrap_err()
    assert(err.contains("can't remove the last pattern arm"), err)
    assert_eq(fs.read_to_string(invalid_path).unwrap(), before)
    multi_path: write_fixture("multi_input_tx", "to_int: fn(n: Int) -> Int {{\n    return n\n}}\n\ndemo: fn() -> Int {{\n    xs: [1, 2, 3,]\n    return xs[0] + to_int(1)\n}}\n\nrun: fn() {{\n    print(demo())\n}}\n")
    graph: graph_json_for_file(multi_path).expect("multi graph")
    (list_start, list_end): source_span_near(graph, "\"title\":\"list\"")
    revision: source_revision(fs.read_to_string(multi_path).unwrap())
    append: "{{\"schema_version\":1,\"op\":\"append_multi_input\",\"revision\":\"{revision}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element\":\"4\"}}"
    apply_transaction_json(multi_path, append).expect("append list")
    appended: fs.read_to_string(multi_path).unwrap()
    assert(appended.contains("[1, 2, 3, 4]"), appended)
    graph: graph_json_for_file(multi_path).expect("multi graph after append")
    (list_start, list_end): source_span_near(graph, "\"title\":\"list\"")
    (item_start, item_end): source_span_near(graph, "\"name\":\"item4\"")
    revision: source_revision(appended)
    remove: "{{\"schema_version\":1,\"op\":\"remove_multi_input_element\",\"revision\":\"{revision}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element_start\":{item_start},\"element_end\":{item_end}}}"
    apply_transaction_json(multi_path, remove).expect("remove list item")
    removed: fs.read_to_string(multi_path).unwrap()
    assert(removed.contains("[1, 2, 3]"), removed)
    assert(!removed.contains("[1, 2, 3, 4]"), removed)
}
