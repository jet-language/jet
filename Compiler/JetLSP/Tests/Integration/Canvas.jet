#Test("canvas_edit_transactions_write_source_and_reproject") {
    path :: write_fixture("edit", CANVAS_FIXTURE)
    revision :: source_revision(fs.read_to_string(path).unwrap())
    rename :: "{{\"schema_version\":1,\"op\":\"rename_binding\",\"revision\":\"{revision}\",\"from\":\"total\",\"to\":\"score\"}}"
    rename_out :: apply_transaction_json(path, rename).expect("rename transaction")
    assert(rename_out.contains("\"changed\":true"), rename_out)
    renamed :: fs.read_to_string(path).unwrap()
    assert(renamed.contains("score := square(limit)"))
    assert(renamed.contains("if score > 10"))
    assert(!renamed.contains("total"))
    receipts :: path.parent().unwrap().join(".jet/codemods")
    receipt_path :: fs.read_dir(receipts).unwrap().filter_map((entry) -> entry.ok()).map((entry) -> entry.path()).find((candidate) -> candidate.extension().and_then((value) -> value.to_str()) == Val("json")).expect("Canvas rename receipt")
    receipt :: fs.read_to_string(receipt_path).unwrap()
    loop field in ["\"kind\":\"rename\"", "\"from\":\"total\"", "\"to\":\"score\""] -> assert(receipt.contains(field), receipt)
    scm :: source_control_json_for_file(path)
    assert(scm.contains("\"semantic_ops\":[{{\"kind\":\"rename\""), scm)
    graph :: graph_json_for_file(path).expect("canvas graph after rename")
    assert(graph.contains("\"title\":\"score\""))
    revision :: source_revision(renamed)
    inline_id :: field_before(graph, "\"source\":\"score > 10\"", "inline_expr_id")
    edit_inline :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{revision}\",\"inline_expr_id\":\"{inline_id}\",\"new_expr\":\"score >= 16\"}}"
    inline_out :: apply_transaction_json(path, edit_inline).expect("inline transaction")
    assert(inline_out.contains("\"changed\":true"), inline_out)
    changed :: fs.read_to_string(path).unwrap()
    assert(changed.contains("if score >= 16"))
    revision :: source_revision(changed)
    graph :: graph_json_for_file(path).expect("canvas graph before insert")
    run_graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{revision}\",\"graph_id\":\"{run_graph_id}\",\"callee\":\"print\",\"args\":[\"\\\"canvas\\\"\"]}}"
    insert_out :: apply_transaction_json(path, insert).expect("insert transaction")
    assert(insert_out.contains("\"changed\":true"), insert_out)
    inserted :: fs.read_to_string(path).unwrap()
    assert(inserted.contains("print(\"canvas\")"))
    final_graph :: graph_json_for_file(path).expect("canvas graph final")
    assert(final_graph.contains("\"title\":\"print\""))
}
// Rust: tests/canvas.rs:1149
#Test("canvas_source_paste_is_renamed_checked_and_stale_atomic") {
    path :: write_fixture("paste_clone", CANVAS_FIXTURE)
    before :: fs.read_to_string(path).unwrap()
    stale_revision :: source_revision(before)
    clone :: before.replace("    total := square(limit)\n", "    total := square(limit)\n    total_copy := square(limit)\n")
    escaped_clone :: clone.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    paste :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{stale_revision}\",\"source_edit\":\"paste_clone\",\"source\":\"{escaped_clone}\"}}"
    paste_out :: apply_transaction_json(path, paste).expect("paste clone transaction")
    assert(paste_out.contains("\"changed\":true"), paste_out)
    pasted :: fs.read_to_string(path).unwrap()
    original_offset :: pasted.find("total := square(limit)").expect("original binding")
    clone_offset :: pasted.find("total_copy := square(limit)").expect("renamed clone")
    assert(clone_offset > original_offset, "paste must insert after the selected source line")
    assert(graph_json_for_file(path).expect("reproject pasted graph").contains("\"title\":\"total_copy\""))
    invalid_revision :: source_revision(pasted)
    invalid :: pasted.replace("total_copy := square(limit)", "total_copy := missing(limit)")
    escaped_invalid :: invalid.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    invalid_request :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{invalid_revision}\",\"source\":\"{escaped_invalid}\"}}"
    error :: apply_transaction_json(path, invalid_request).unwrap_err()
    assert(error.contains("Error [") || error.contains("diagnostic"), error)
    assert_eq(fs.read_to_string(path).unwrap(), pasted, "invalid paste must not write source")
    stale_request :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{stale_revision}\",\"source\":\"{escaped_clone}\"}}"
    stale_error :: apply_transaction_json(path, stale_request).unwrap_err()
    assert(stale_error.contains("source changed since this Canvas graph was drawn"), stale_error)
    assert_eq(fs.read_to_string(path).unwrap(), pasted, "stale paste must not write source")
}
