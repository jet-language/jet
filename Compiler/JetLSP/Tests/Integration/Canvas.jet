field_before: fn(haystack: String, marker: String, field: String) -> String {
    end: haystack.find(marker) ?? panic("marker in graph JSON: {marker}")
    prefix := haystack.slice(0, end) // #4303
    key: "\"{field}\":\""
    start: (prefix.rfind(key) ?? panic("field before marker")) + key.bytes().len()
    rest := prefix.slice(start, prefix.bytes().len()) // #4303
    rest.slice(0, rest.find('"') ?? panic("field terminator"))
}
first_source_wire_id: fn(graph: String) -> String {
    loop chunk in graph.split("\"wire_id\":\"").skip(1) {
        if chunk.contains("\"source_span\":{{\"") -> return chunk.slice(0, chunk.find('"') ?? panic("wire id terminator"))
    }
    panic("source-backed wire in graph JSON")
}
first_node_id_containing: fn(graph: String, needle: String) -> String {
    loop chunk in graph.split("\"node_id\":\"").skip(1) {
        id := chunk.slice(0, chunk.find('"') ?? panic("node id terminator")) // #4303
        if id.contains(needle) -> return id
    }
    panic("node id containing {needle}")
}
count_occurrences: fn(haystack: String, needle: String) -> Int { haystack.match_indices(needle).count() }
json_quote: fn(value: String) -> String {
    out := "\""
    loop ch in value.chars() {
        if ch == {
            '\\' -> out += "\\\\"
            '"' -> out += "\\\""
            '\n' -> out += "\\n"
            Char{13} -> out += "\\r"
            '\t' -> out += "\\t"
            else -> {
                if ch.is_control() -> out += "\\u{ch.to_u32():04x}" else -> out.push(ch)
            }
        }
    }
    out += "\""
    out
}
json_field: fn(haystack: String, field: String) -> String {
    key: "\"{field}\":\""
    start: (haystack.find(key) ?? panic("json field")) + key.bytes().len()
    rest := haystack.slice(start, haystack.bytes().len()) // #4303
    rest.slice(0, rest.find('"') ?? panic("json field terminator"))
}
json_array_field: fn(haystack: String, field: String) -> String {
    marker: "\"{field}\":["
    start: (haystack.find(marker) ?? panic("missing JSON array `{field}`")) + marker.bytes().len()
    depth := 1
    in_string := false
    escaped := false
    bytes: haystack.bytes()
    loop offset in start..<bytes.len() {
        byte: bytes[offset]
        if in_string {
            if escaped -> escaped = false
            else if byte == 92 -> escaped = true
            else if byte == 34 -> in_string = false
            next
        }
        if byte == {
            34 -> in_string = true
            91 -> depth += 1
            93 -> { depth -= 1; if depth == 0 -> return haystack.slice(start, offset) } else -> {}
        }
    }
    panic("unterminated JSON array `{field}`")
}
json_top_level_objects: fn(array: String) -> [String] {
    objects := [String]{}
    start := Int?{None}
    depth := 0
    in_string := false
    escaped := false
    bytes: array.bytes()
    loop offset in 0..<bytes.len() {
        byte: bytes[offset]
        if in_string {
            if escaped -> escaped = false
            else if byte == 92 -> escaped = true
            else if byte == 34 -> in_string = false
            next
        }
        if byte == {
            34 -> in_string = true
            123 -> { if depth == 0 -> start = Val(offset); depth += 1 }
            125 -> {
                depth -= 1
                if depth == 0 {
                    object_start: start ?? panic("top-level JSON object start")
                    start = None
                    &objects.push(array.slice(object_start, offset + 1))
                }
            }
            else -> {}
        }
    }
    assert_eq(depth, 0, "unterminated top-level JSON object: {array}")
    objects
}
source_span_near: fn(haystack: String, marker: String) -> (Int, Int) {
    pos: haystack.find(marker) ?? panic("marker near source span")
    rest := haystack.slice(pos, haystack.bytes().len()) // #4303
    key: "\"source_span\":{{\"start\":"
    start_pos: (rest.find(key) ?? panic("source span after marker")) + key.bytes().len()
    rest = rest.slice(start_pos, rest.bytes().len())
    start: rest.slice(0, rest.find(',') ?? panic("span comma")).parse<Int>().expect("span start")
    end_key: "\"end\":"
    end_pos: (rest.find(end_key) ?? panic("span end")) + end_key.bytes().len()
    rest = rest.slice(end_pos, rest.bytes().len())
    end_text: rest.chars().take_while((ch) -> ch.is_ascii_digit()).collect<String>()
    (_0: start, _1: end_text.parse<Int>().expect("span end number"))
}
source_span_at_or_after: fn(haystack: String, marker: String, minimum_start: Int) -> (Int, Int) {
    search_from := 0
    loop {
        found: haystack.slice(search_from, haystack.bytes().len()).find(marker) ?? break
        pos: search_from + found
        (start, end): source_span_near(haystack.slice(pos, haystack.bytes().len()), marker)
        if start >= minimum_start -> return (_0: start, _1: end)
        search_from = pos + marker.bytes().len()
    }
    panic("marker has no source span at or after {minimum_start}: {marker}")
}
graph_id_for_title: fn(graph: String, title: String) -> String { field_before(graph, "\"title\":\"{title}\"", "graph_id") }
graph_object_for_title: fn(graph: String, title: String) -> String {
    loop candidate in json_top_level_objects(json_array_field(graph, "graphs")) {
        if candidate.contains("\"title\":\"{title}\"") -> return candidate
    }
    panic("graph object for {title}")
}
name_span: fn(src: String, name: String) -> (Int, Int) {
    start: src.find("{name} ::") ?? panic("binding name span")
    (_0: start, _1: start + name.bytes().len())
}
source_order: fn(src: String, names: [String]) -> [Int] {
    out := [Int]{}
    loop name in names -> &out.push(src.find("{name} ::") ?? panic("source name"))
    out
}

#Test("canvas_graph_json_is_stable_and_typed") {
    path: write_fixture("graph", CANVAS_FIXTURE)
    json: graph_json_for_file(path).expect("canvas graph")
    assert(json.starts_with("{{\"schema\":\"jet.status/v1\""), json)
    assert_eq(read_machine_line(json), Ok(MachineRecord.Status))
    loop field in ["\"protocol\":\"jet.canvas.graph\"", "\"schema_version\":1", "\"node_descriptors\":[", "\"node_descriptor_id\":\"branch\"", "\"source_id\"", "\"fmt_fingerprint\":\"sha256-", "\"graph_id\":\"fn:", "\"title\":\"summarize\"", "\"kind\":\"branch\"", "\"kind\":\"function\"", "\"archetype\":\"entry\"", "\"archetype\":\"control\"", "\"archetype\":\"function_exec\"", "\"archetype\":\"function_pure\"", "\"archetype\":\"value\"", "\"kind\":\"variable_get\"", "\"kind\":\"constant\"", "\"type\":\"Int\"", "\"wire_kind\":\"data\"", "\"wire_kind\":\"control\"", "\"from_source_span\":", "\"to_source_span\":", "\"type\":\"exec\"", "\"ability\":\"control\"", "\"inline_exprs\"", "total > 10"] -> assert(json.contains(field), json)
    square_call: first_node_id_containing(json, ":call:square")
    binding: first_node_id_containing(json, ":stmt:1:binding")
    assert(json.contains("\"from_pin\":\"{square_call}:output:result\",\"to_pin\":\"{binding}:input:value\",\"wire_kind\":\"data\""), "pure function calls should feed data pins: {json}")
    assert(!json.contains("\"pin_id\":\"{square_call}:input:exec\""), "pure expression call must not carry exec pin: {json}")
    again: graph_json_for_file(path).expect("canvas graph again")
    assert_eq(json, again, "Canvas layout/projection must be deterministic")
}
#Test("canvas_projects_labeled_execution_outputs_for_loops_and_early_returns") {
    path: write_fixture("multi_exec_outputs", "paths: fn(limit: Int) -> Int {{\n    loop i in 0..<limit {{\n        if i == 1 {{\n            return i\n        }} else {{\n            print(i)\n        }}\n    }}\n    return 0\n}}\n\nrun: fn() {{\n    print(paths(3))\n}}\n")
    graph: graph_json_for_file(path).expect("multi-exec graph")
    paths: graph_object_for_title(graph, "paths")
    loop (name, role) in [(_0: "body", _1: "loop_body"), (_0: "done", _1: "loop_done"), (_0: "return", _1: "early_return")] {
        field: "\"name\":\"{name}\",\"direction\":\"output\",\"type\":\"exec\",\"role\":\"{role}\""
        assert(paths.contains(field), "paths graph missing {field}: {paths}")
        pin: json_top_level_objects(json_array_field(paths, "pins")).find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {paths}")
        assert(pin.contains("\"role\":\"{role}\""), "pin role drift: {pin}")
        assert(pin.contains("\"source_span\":{{\"start\":"), "pin provenance missing: {pin}")
    }
    assert(paths.contains("\"name\":\"then\""), "branch then output missing: {paths}")
    assert(paths.contains("\"name\":\"else\""), "branch else output missing: {paths}")
}
#Test("canvas_projects_switch_arm_outputs_with_source_provenance") {
    path: write_fixture("multi_exec_switch_outputs", "choose: fn(value: Int) -> Int {{\n    if value == {{\n        0 -> {{ return 0 }}\n        1 -> {{ return 1 }}\n        else -> {{ return 2 }}\n    }}\n}}\n\nrun: fn() {{ print(choose(1)) }}\n")
    source: fs.read_to_string(path).unwrap()
    assert_eq(format_source(source).unwrap(), source)
    graph: graph_json_for_file(path).expect("switch multi-exec graph")
    choose: graph_object_for_title(graph, "choose")
    pins: json_top_level_objects(json_array_field(choose, "pins"))
    loop (name, pattern) in [(_0: "arm1", _1: "0"), (_0: "arm2", _1: "1")] {
        pin: pins.find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {choose}")
        loop field in ["\"direction\":\"output\"", "\"type\":\"exec\"", "\"role\":\"arm\""] -> assert(pin.contains(field), pin)
        assert(pin.contains("\"pattern_source\":\"{pattern}\""), "pattern provenance missing: {pin}")
        offset: source.find("{pattern} ->").expect("arm source span")
        assert(pin.contains("\"source_span\":{{\"start\":{offset},\"end\":"), "source span does not identify {pattern} arm: {pin}")
    }
    else_pin: pins.find((pin) -> pin.contains("\"name\":\"else\"")).expect("missing else pin")
    loop field in ["\"direction\":\"output\"", "\"type\":\"exec\"", "\"role\":\"else\"", "\"source_span\":{{\"start\":"] -> assert(else_pin.contains(field), else_pin)
    assert(!source.contains("=>"), "retired arrow spelling leaked: {source}")
}
#Test("canvas_projects_switch_arm_labels_with_exact_source_spans") {
    path: write_fixture("multi_exec_switch_pin_provenance", "choose: fn(value: Int) -> Int {{\n    if value == {{\n        0 -> {{ return 0 }}\n        1 -> {{ return 1 }}\n        else -> {{ return 2 }}\n    }}\n}}\n\nrun: fn() {{\n    print(choose(1))\n}}\n")
    source: fs.read_to_string(path).unwrap()
    graph: graph_json_for_file(path).expect("switch multi-exec graph")
    choose: graph_object_for_title(graph, "choose")
    pins: json_top_level_objects(json_array_field(choose, "pins"))
    loop (name, pattern) in [(_0: "arm1", _1: "0"), (_0: "arm2", _1: "1")] {
        pin: pins.find((pin) -> pin.contains("\"name\":\"{name}\"")).expect("missing {name} pin: {choose}")
        assert(pin.contains("\"pattern_source\":\"{pattern}\""), pin)
        offset: source.find("{pattern} ->").expect("arm source span")
        assert(pin.contains("\"source_span\":{{\"start\":{offset},\"end\":"), "source span does not identify {pattern} arm: {pin}")
    }
}
#Test("canvas_rejects_ambiguous_package_facts_before_projection") {
    dir: temp_dir("graph_ambiguous_package")
    fs.write(dir.join("package.jet"), "name: \"canonical\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join(PAYLOAD_FILE), "name: \"legacy\"\nversion: \"0.1.0\"\n").unwrap()
    entry: dir.join("main.jet")
    fs.write(entry, "run: fn() {{}}\n").unwrap()
    diagnostics: graph_json_for_file(entry).expect_err("Canvas must reject ambiguous package facts")
    assert(diagnostics.find((diagnostic) -> diagnostic.code == "E1215") != None, "{diagnostics}")
}
#Test("canvas_project_uses_shared_package_diagnostic") {
    dir: temp_dir("project_ambiguous_package")
    fs.write(dir.join("package.jet"), "name: \"canonical\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join(PAYLOAD_FILE), "name: \"legacy\"\nversion: \"0.1.0\"\n").unwrap()
    entry: dir.join("main.jet")
    fs.write(entry, "run: fn() {{}}\n").unwrap()
    diagnostics: graph_json_for_file(entry).expect_err("Canvas must reject ambiguous package facts")
    diagnostic: diagnostics.find((diagnostic) -> diagnostic.code == "E1215").expect("ambiguous package facts must use the shared E1215 diagnostic")
    project: project_json_for_entry(entry)
    assert(project.contains("\"code\":\"E1215\""), project)
    assert(!project.contains("\"code\":\"package\""), project)
    assert(project.contains("one typed Package fact graph must own this projection"), project)
    loop field in [diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix] -> assert(project.contains(field), "project omitted diagnostic field: {field}\n{project}")
}
#Test("canvas_node_descriptor_catalog_is_complete_and_transaction_matched") {
    projection_fixtures: [(_0: "node_descriptor_coverage", _1: CANVAS_COVERAGE_FIXTURE), (_0: "node_descriptor_data", _1: CANVAS_DATA_FIXTURE), (_0: "node_descriptor_patterns", _1: CANVAS_PATTERN_MULTI_FIXTURE), (_0: "node_descriptor_fallible", _1: CANVAS_RAILS_FIXTURE), (_0: "node_descriptor_yield", _1: fs.read_to_string(OSPath("Examples/features/streams/generators.jet")).unwrap()), (_0: "node_descriptor_scope", _1: fs.read_to_string(OSPath("Examples/features/tooling/test_members.jet")).unwrap())]
    path: write_fixture(projection_fixtures[0]._0, projection_fixtures[0]._1)
    json: graph_json_for_file(path).expect("canvas graph")
    catalog: json_array_field(json, "node_descriptors")
    descriptors: json_top_level_objects(catalog)
    assert(!descriptors.is_empty(), "descriptor catalog is empty: {catalog}")
    catalog_ids := [String:Bool]{}
    catalog_projected_ids := [String:Bool]{}
    catalog_insertable_ids := [String:Bool]{}
    descriptors_by_id := [String:String]{}
    loop descriptor in descriptors {
        id: json_field(descriptor, "id")
        assert(catalog_ids.get(id) == None, "duplicate descriptor id `{id}`: {catalog}")
        catalog_ids[id] = true
        descriptors_by_id[id] = descriptor
        loop field in ["\"kind\":\"", "\"archetype\":\"", "\"presentation\":{{", "\"palette\":{{", "\"default_editor\":"] -> assert(descriptor.contains(field), "descriptor facts incomplete for {id}: {descriptor}")
        projected: descriptor.contains("\"projected\":true")
        insertable: descriptor.contains("\"insertable\":true")
        assert(projected || insertable, "orphaned descriptor `{id}`: {descriptor}")
        if projected -> catalog_projected_ids[id] = true
        if insertable -> catalog_insertable_ids[id] = true
        assert_eq(insertable, !descriptor.contains("\"transaction\":null"), "insertable/transaction mismatch for `{id}`: {descriptor}")
    }
    projected_ids := [String:Bool]{}
    loop (fixture_name, fixture_src) in projection_fixtures {
        fixture_path: write_fixture(fixture_name, fixture_src)
        projection: graph_json_for_file(fixture_path).expect("descriptor coverage graph")
        loop graph in json_top_level_objects(json_array_field(projection, "graphs")) {
            loop node in json_top_level_objects(json_array_field(graph, "nodes")) {
                assert_eq(count_occurrences(node, "\"node_descriptor_id\":"), 1, "projected node must carry exactly one descriptor id: {node}")
                id: json_field(node, "node_descriptor_id")
                assert(catalog_ids.get(id) != None, "projected node references missing descriptor `{id}`: {node}")
                projected_ids[id] = true
            }
        }
    }
    assert_eq(projected_ids, catalog_projected_ids, "catalog/projector coverage must be exactly bidirectional")
    src: fs.read_to_string(path).unwrap()
    actions_request: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{source_revision(src)}\"}}"
    actions: query_json_for_file(path, actions_request).expect("Canvas actions")
    action_objects := json_top_level_objects(json_array_field(actions, "project_functions"))
    loop action in json_top_level_objects(json_array_field(actions, "actions")) {
        if !action.contains("\"kind\":\"canvas.command\"") -> &action_objects.push(action)
    }
    assert(!action_objects.is_empty(), "insertable actions need descriptors: {actions}")
    exported_insertable_ids := [String:Bool]{}
    loop action in action_objects {
        assert_eq(count_occurrences(action, "\"node_descriptor_id\":"), 1, "served insertable action must carry exactly one descriptor id: {action}")
        id: json_field(action, "node_descriptor_id")
        descriptor: descriptors_by_id.get(id).expect("action references missing descriptor `{id}`: {action}")
        assert(descriptor.contains("\"insertable\":true"), "action exports non-insertable descriptor `{id}`: {action}")
        exported_insertable_ids[id] = true
        transaction: json_field(descriptor, "transaction")
        action_transaction: if action.contains("\"insert_op\":\"") -> json_field(action, "insert_op") else -> json_field(action, "op")
        assert_eq(action_transaction, transaction, "action/descriptor transaction mismatch for `{id}`: {action}")
    }
    assert_eq(exported_insertable_ids, catalog_insertable_ids, "catalog/action export coverage must be exactly bidirectional")
}
#Test("canvas_noop_round_trip_is_formatter_stable") {
