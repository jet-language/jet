// -* source-backed graph, formatter round-trip and write transactions.
use {
    jet.Canvas.[graph_json_for_file, project_json_for_entry, query_json_for_file, apply_transaction_json, source_revision, source_control_json_for_file]
    jet.[format_source]
    std.[fs, env, process]
}

// GATE #4494: filesystem/process primitives retain actual providers.
temp_dir: fn(tag_ref: String) -> OSPath {
    dir: env.temp_dir().join("jet_canvas_{tag_ref}_{process.id()}")
    _: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).expect("create canvas directory")
    dir
}
write_fixture: fn(tag_ref: String, src: String) -> OSPath {
    path: temp_dir(tag_ref).join("main.jet")
    fs.write(path, src).expect("write canvas fixture")
    path
}
ast_enum_variants: fn(path: String, enum_name: String) -> [String] {
    src: fs.read_to_string(OSPath(path)).expect("read {path}")
    marker: "{enum_name}: enum"
    variants := [String]{}
    in_enum := false
    depth := 0
    loop line in src.lines() {
        code := line.split("//")[0] // #4303
        if !in_enum {
            if code.find(marker) == .Val(pos) {
                in_enum = true
                loop ch in code.slice(pos, code.bytes().len()).chars() {
                    if ch == '{' -> depth += 1
                    else if ch == '}' -> depth -= 1
                }
            }
            next
        }
        if depth == 1 {
            if variant_name(code) == .Val(name) -> &variants.push(name)
        }
        loop ch in code.chars() {
            if ch == {
                '{' | '(' | '[' -> depth += 1
                '}' | ')' | ']' -> depth -= 1
                else -> {}
            }
        }
        if depth == 0 -> break
    }
    assert(!variants.is_empty(), "missing {marker} variants in {path}")
    variants
}
variant_name: fn(chunk: String) -> String? {
    loop raw in chunk.lines() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with("///") || line.starts_with("//") || line.starts_with("#[") -> next
        if !line.chars().first().is_some_and((ch) -> ch.is_uppercase()) -> next
        end: line.find((ch) -> !(ch.is_ascii_alphanumeric() || ch == '_')) ?? line.bytes().len()
        return Val(line.slice(0, end))
    }
    None
}

