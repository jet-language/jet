    src: fs.read_to_string(cross).unwrap()
    (moved_start, moved_end): name_span(src, "c")
    (anchor_start, anchor_end): name_span(src, "a")
    req: "{{\"schema_version\":1,\"op\":\"reorder_statements\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"moved_start\":{moved_start},\"moved_end\":{moved_end},\"anchor_start\":{anchor_start},\"anchor_end\":{anchor_end},\"position\":\"after\"}}"
    err: apply_transaction_json(cross, req).unwrap_err()
    assert(err.contains("can't move a step into a different branch yet"), err)
    assert_eq(fs.read_to_string(cross).unwrap(), src)
    binding: write_fixture("reorder_binding_order", CANVAS_REORDER_BINDING_FIXTURE)
    graph: graph_json_for_file(binding).expect("binding graph")
    graph_id: graph_id_for_title(graph, "order")
    src: fs.read_to_string(binding).unwrap()
    (moved_start, moved_end): name_span(src, "c")
    (anchor_start, anchor_end): name_span(src, "a")
    req: "{{\"schema_version\":1,\"op\":\"reorder_statements\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"moved_start\":{moved_start},\"moved_end\":{moved_end},\"anchor_start\":{anchor_start},\"anchor_end\":{anchor_end},\"position\":\"after\"}}"
    err: apply_transaction_json(binding, req).unwrap_err()
    assert(err.contains("\"kind\":\"diagnostic\""), err)
    assert(err.contains("E0107"), err)
    assert(err.contains("`b`"), err)
    assert_eq(fs.read_to_string(binding).unwrap(), src)
}
#Test("canvas_exec_convergence_is_checked_source_and_refuses_scope_drift") {
    path: write_fixture("convergence_checked", "converge: fn(flag: Bool) {{\n    value: 1\n    done: value\n    if flag {{\n        print(value)\n        finish(done)\n    }} else {{\n        print(value)\n    }}\n}}\n\nfinish: fn(value: Int) {{\n    print(value)\n}}\n\nrun: fn() {{\n    converge(true)\n}}\n")
    graph: graph_json_for_file(path).expect("convergence graph")
    graph_id: graph_id_for_title(graph, "converge")
    (from_start, from_end): source_span_near(graph, "\"title\":\"if\"")
    (target_start, target_end): source_span_near(graph, "\"title\":\"finish\"")
    source: fs.read_to_string(path).unwrap()
    request: "{{\"schema_version\":1,\"op\":\"replace_source\",\"source_edit\":\"exec_convergence\",\"revision\":\"{source_revision(source)}\",\"graph_id\":\"{graph_id}\",\"from_pin_name\":\"else\",\"from_start\":{from_start},\"from_end\":{from_end},\"target_start\":{target_start},\"target_end\":{target_end},\"strategy\":\"extract\",\"function\":\"shared_finish\"}}"
    result: apply_transaction_json(path, request).expect("checked convergence")
    assert(result.contains("\"changed\":true"), result)
    after: fs.read_to_string(path).unwrap()
    assert(after.contains("shared_finish: fn(done: Int)"), after)
    assert_eq(after.matches("shared_finish(done)").count(), 2, after)
    assert_eq(after, format_source(after).expect("formatted convergence"))
    refused: write_fixture("convergence_scope_refusal", "converge: fn(flag: Bool) {{\n    value: 1\n    if flag {{\n        branch_value: value\n        finish(branch_value)\n    }} else {{\n        print(value)\n    }}\n}}\n\nfinish: fn(value: Int) {{\n    print(value)\n}}\n\nrun: fn() {{\n    converge(true)\n}}\n")
    graph: graph_json_for_file(refused).expect("refusal graph")
    graph_id: graph_id_for_title(graph, "converge")
    (from_start, from_end): source_span_near(graph, "\"title\":\"if\"")
    (target_start, target_end): source_span_near(graph, "\"title\":\"finish\"")
    before: fs.read_to_string(refused).unwrap()
    request: "{{\"schema_version\":1,\"op\":\"replace_source\",\"source_edit\":\"exec_convergence\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"from_pin_name\":\"else\",\"from_start\":{from_start},\"from_end\":{from_end},\"target_start\":{target_start},\"target_end\":{target_end},\"strategy\":\"extract\",\"function\":\"shared_finish\"}}"
    error: apply_transaction_json(refused, request).unwrap_err()
    assert(error.contains("E0107") || error.contains("diagnostic"), error)
    assert_eq(fs.read_to_string(refused).unwrap(), before)
}
#Test("canvas_exec_convergence_preserves_selected_statement_span_and_helper_formatting") {
