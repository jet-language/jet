    entry :: dir.join("main.jet")
    fs.write(entry, "fn run() {{}}\n").unwrap()
    diagnostics :: graph_json_for_file(entry).expect_err("Canvas must reject ambiguous package facts")
    diagnostic :: diagnostics.find((diagnostic) -> diagnostic.code == "E1206").expect("ambiguous package facts must use the shared E1206 diagnostic")
    project :: project_json_for_entry(entry)
    assert(project.contains("\"code\":\"E1206\""), project)
    assert(!project.contains("\"code\":\"package\""), project)
    assert(project.contains("one typed Package fact graph must own this projection"), project)
    loop field in [diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix] -> assert(project.contains(field), "project omitted diagnostic field: {field}\n{project}")
}
// Rust: tests/canvas.rs:924
#Test("canvas_node_descriptor_catalog_is_complete_and_transaction_matched") {
    projection_fixtures :: [("node_descriptor_coverage", CANVAS_COVERAGE_FIXTURE), ("node_descriptor_data", CANVAS_DATA_FIXTURE), ("node_descriptor_patterns", CANVAS_PATTERN_MULTI_FIXTURE), ("node_descriptor_fallible", CANVAS_RAILS_FIXTURE), ("node_descriptor_yield", fs.read_to_string(OSPath("Examples/features/streams/generators.jet")).unwrap()), ("node_descriptor_scope", fs.read_to_string(OSPath("Examples/features/tooling/test_members.jet")).unwrap())]
    path :: write_fixture(projection_fixtures[0].0, projection_fixtures[0].1)
    json :: graph_json_for_file(path).expect("canvas graph")
    catalog :: json_array_field(json, "node_descriptors")
    descriptors :: json_top_level_objects(catalog)
    assert(!descriptors.is_empty(), "descriptor catalog is empty: {catalog}")
    catalog_ids := [String:Bool]{}
    catalog_projected_ids := [String:Bool]{}
    catalog_insertable_ids := [String:Bool]{}
    descriptors_by_id := [String:String]{}
    loop descriptor in descriptors {
        id :: json_field(descriptor, "id")
        assert(catalog_ids.get(id) == None, "duplicate descriptor id `{id}`: {catalog}")
        catalog_ids[id] = true
        descriptors_by_id[id] = descriptor
        loop field in ["\"kind\":\"", "\"archetype\":\"", "\"presentation\":{{", "\"palette\":{{", "\"default_editor\":"] -> assert(descriptor.contains(field), "descriptor facts incomplete for {id}: {descriptor}")
        projected :: descriptor.contains("\"projected\":true")
        insertable :: descriptor.contains("\"insertable\":true")
        assert(projected || insertable, "orphaned descriptor `{id}`: {descriptor}")
        if projected -> catalog_projected_ids[id] = true
        if insertable -> catalog_insertable_ids[id] = true
        assert_eq(insertable, !descriptor.contains("\"transaction\":null"), "insertable/transaction mismatch for `{id}`: {descriptor}")
    }
    projected_ids := [String:Bool]{}
    loop (fixture_name, fixture_src) in projection_fixtures {
        fixture_path :: write_fixture(fixture_name, fixture_src)
        projection :: graph_json_for_file(fixture_path).expect("descriptor coverage graph")
        loop graph in json_top_level_objects(json_array_field(projection, "graphs")) {
            loop node in json_top_level_objects(json_array_field(graph, "nodes")) {
                assert_eq(count_occurrences(node, "\"node_descriptor_id\":"), 1, "projected node must carry exactly one descriptor id: {node}")
                id :: json_field(node, "node_descriptor_id")
                assert(catalog_ids.get(id) != None, "projected node references missing descriptor `{id}`: {node}")
                projected_ids[id] = true
            }
        }
    }
    assert_eq(projected_ids, catalog_projected_ids, "catalog/projector coverage must be exactly bidirectional")
    src :: fs.read_to_string(path).unwrap()
    actions_request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{source_revision(src)}\"}}"
    actions :: query_json_for_file(path, actions_request).expect("Canvas actions")
    action_objects := json_top_level_objects(json_array_field(actions, "project_functions"))
    loop action in json_top_level_objects(json_array_field(actions, "actions")) {
        if !action.contains("\"kind\":\"canvas.command\"") -> &action_objects.push(action)
    }
    assert(!action_objects.is_empty(), "insertable actions need descriptors: {actions}")
    exported_insertable_ids := [String:Bool]{}
    loop action in action_objects {
        assert_eq(count_occurrences(action, "\"node_descriptor_id\":"), 1, "served insertable action must carry exactly one descriptor id: {action}")
        id :: json_field(action, "node_descriptor_id")
        descriptor :: descriptors_by_id.get(id).expect("action references missing descriptor `{id}`: {action}")
        assert(descriptor.contains("\"insertable\":true"), "action exports non-insertable descriptor `{id}`: {action}")
        exported_insertable_ids[id] = true
        transaction :: json_field(descriptor, "transaction")
        action_transaction :: if action.contains("\"insert_op\":\"") -> json_field(action, "insert_op") else -> json_field(action, "op")
        assert_eq(action_transaction, transaction, "action/descriptor transaction mismatch for `{id}`: {action}")
    }
    assert_eq(exported_insertable_ids, catalog_insertable_ids, "catalog/action export coverage must be exactly bidirectional")
}
