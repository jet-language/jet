#Test("canvas_parity_matrix_tracks_ast_language_forms") {
    matrix: fs.read_to_string(OSPath("Docs/spec/reference/canvas-parity.md")).expect("Canvas parity matrix must exist")
    loop (enum_name, path) in [(_0: "Item", _1: "Compiler/JetFoundation/Source/AST/Items.jet"), (_0: "Stmt", _1: "Compiler/JetFoundation/Source/AST/Statements.jet"), (_0: "Expr", _1: "Compiler/JetFoundation/Source/AST/Expressions.jet"), (_0: "Type", _1: "Compiler/JetFoundation/Source/Types/Types.jet"), (_0: "Pattern", _1: "Compiler/JetFoundation/Source/AST/Patterns.jet"), (_0: "BindPattern", _1: "Compiler/JetFoundation/Source/AST/Patterns.jet"), (_0: "LValue", _1: "Compiler/JetFoundation/Source/AST/Statements.jet")] {
        loop variant in ast_enum_variants(path, enum_name) {
            token: "[{enum_name}::{variant}]"
            assert(matrix.contains(token), "Canvas parity matrix missing {token} from {path}")
        }
    }
}
