#Test("canvas_exec_rewire_reorders_statements_and_guards_scope_and_dataflow") {
    path: write_fixture("reorder_exec", CANVAS_REORDER_FIXTURE)
    graph: graph_json_for_file(path).expect("canvas graph")
    graph_id: graph_id_for_title(graph, "order")
    assert(graph.contains("\"wire_kind\":\"control\"") && graph.contains("\"from_source_span\":{{\"start\":") && graph.contains("\"to_source_span\":{{\"start\":"), "control wires must carry endpoint statement spans: {graph}")
    src: fs.read_to_string(path).unwrap()
    (moved_start, moved_end): name_span(src, "c")
    (anchor_start, anchor_end): name_span(src, "a")
    req: "{{\"schema_version\":1,\"op\":\"reorder_statements\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"moved_start\":{moved_start},\"moved_end\":{moved_end},\"anchor_start\":{anchor_start},\"anchor_end\":{anchor_end},\"position\":\"after\"}}"
    apply_transaction_json(path, req).expect("reorder statements")
    after: fs.read_to_string(path).unwrap()
