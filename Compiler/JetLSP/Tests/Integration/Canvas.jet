    source: fs.read_to_string(path).unwrap()
    target_start: source.find("notify(value)").expect("selected span start")
    target_end: source.find("bump_metric()\n        print(value)").map((offset) -> offset + "bump_metric()".bytes().len()).expect("selected span end")
    request: "{{\"schema_version\":1,\"op\":\"replace_source\",\"source_edit\":\"exec_convergence\",\"revision\":\"{source_revision(source)}\",\"graph_id\":\"{graph_id}\",\"from_pin_name\":\"else\",\"from_start\":{from_start},\"from_end\":{from_end},\"target_start\":{target_start},\"target_end\":{target_end},\"strategy\":\"helper\",\"function\":\"shared_work\",\"helper_name\":\"shared_work\"}}"
    result: apply_transaction_json(path, request).expect("selected convergence helper")
    assert(result.contains("\"changed\":true"), result)
    after: fs.read_to_string(path).unwrap()
    assert_eq(after.matches("shared_work(value)").count(), 2, after)
