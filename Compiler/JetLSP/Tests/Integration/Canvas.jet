    assert(order[0] < order[1] && order[1] < order[2], after)
    formatted: format_source(after).expect("format reordered source")
    assert_eq(after, formatted, "reorder must be formatter-stable")
    cross: write_fixture("reorder_cross_block", CANVAS_REORDER_CROSS_BLOCK_FIXTURE)
    graph: graph_json_for_file(cross).expect("cross graph")
