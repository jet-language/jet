//RS         let started = std::time::Instant::now();
//RS         watch.mark_edit_started();
//RS         std::fs::write(&file, source).unwrap();
//RS         let receipt = watch.poll().expect("watch edit");
//RS         let elapsed = started.elapsed().as_millis();
//RS         let reported = receipt.edit_to_visible_ms.expect("watch timing");
//RS         best = best.min(elapsed.max(reported));
//RS         watch.acknowledge(&receipt).unwrap();
//RS     }
//RS 
//RS     let _ = std::fs::remove_dir_all(&dir);
//RS     best
//RS }
//RS 
//RS fn assert_watch_latency_contract() {
//RS     assert!(
//RS         jet_devserver::WATCH_COALESCE_MS < 5,
//RS         "watch coalescing must stay below 5ms, got {}ms",
//RS         jet_devserver::WATCH_COALESCE_MS
//RS     );
//RS     assert!(
//RS         jet_devserver::WATCH_POLL_INTERVAL_MS <= 10,
//RS         "idle watch polling must stay bounded, got {}ms",
//RS         jet_devserver::WATCH_POLL_INTERVAL_MS
//RS     );
//RS     let best = measure_watch_latency_ms();
//RS     let budget = jet_devserver::WATCH_COALESCE_MS as u128 + WATCH_LATENCY_MARGIN_MS;
//RS     assert!(
//RS         best <= budget,
//RS         "watch save observation {best}ms exceeds coalescing contract {budget}ms"
//RS     );
//RS }
//RS 
//RS 
//RS #[test]
//RS fn check_latency_under_budget_measured_alone() {
//RS     // A second test in this target would run beside the measurement and put
//RS     // #2005's load dependence straight back. Pinned rather than requested in a
//RS     // comment. The needle is assembled at run time so it cannot match itself.
//RS     let attribute = format!("{}{}", "#[", "test]");
