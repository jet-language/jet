//RS //! Card #3095 / Wave A: the process-local schedule restart boundary.
//RS //!
//RS //! This target deliberately exercises only the existing Prelude `JetJobClock`.
//RS //! A fresh clock stands in for a new process: a wall-clock occurrence missed
//RS //! before that process existed is not replayed, while the next day's matching
//RS //! minute remains eligible. The test does not claim App shutdown cancellation
//RS //! or full `jet dev`/generated-Core execution; those runtime boundaries still
//RS //! need a focused App-lifetime receipt.
//RS 
//RS #[test]
//RS fn local_schedule_restart_does_not_replay_a_missed_window() {
//RS     use jet_jit::Job::{JetJobClock, JetJobSchedule};
//RS 
//RS     const DAY: u64 = 86_400;
//RS     const THREE_AM: u64 = 3 * 3_600;
//RS     let schedule = [(
//RS         "nightly",
//RS         JetJobSchedule::WallClockTime {
//RS             hour: 3,
//RS             minute: 0,
//RS         },
//RS     )];
//RS 
//RS     // A process that wakes after the one-minute local window has no due work.
//RS     let missed = DAY + THREE_AM + 61;
//RS     let mut before_restart = JetJobClock::new();
//RS     assert!(
//RS         before_restart.due_at(&schedule, missed).is_empty(),
//RS         "a missed local schedule window must not be replayed before restart"
//RS     );
//RS 
//RS     // Restarting a process-local schedule does not recover an unpersisted tick.
//RS     let mut after_restart = JetJobClock::new();
//RS     assert!(
//RS         after_restart.due_at(&schedule, missed).is_empty(),
//RS         "a fresh local clock must not replay an earlier missed occurrence"
//RS     );
//RS 
//RS     // The next UTC day is a new occurrence, not a replay of the missed one.
//RS     assert_eq!(
//RS         after_restart.due_at(&schedule, DAY * 2 + THREE_AM),
//RS         vec!["nightly".to_string()]
//RS     );
//RS }
