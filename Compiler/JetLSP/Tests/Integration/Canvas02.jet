// Rust: tests/canvas.rs:1950
#Test("canvas_debug_only_execution_path_keeps_source_backed_incoming_wires") {
    path :: write_fixture("debug_only_execution_flow", "fn run() {{\n    print(\"before\")\n    #DebugOnly print(\"debug\")\n    print(\"after\")\n}}\n")
    source :: fs.read_to_string(path).unwrap()
    graph_json :: graph_json_for_file(path).expect("debug-only graph")
    graph :: graph_object_for_title(graph_json, "run")
    nodes :: json_top_level_objects(json_array_field(graph, "nodes"))
    node_for_call :: (call: String) -> {
        start :: source.find(call).expect("call source")
        nodes.find((node) -> node.contains("\"source_span\":{{\"start\":{start},")).map((node) -> json_field(node, "node_id")).expect("missing source-backed node for {call}")
    }
    before :: node_for_call("print(\"before\")")
    debug :: node_for_call("print(\"debug\")")
    after :: node_for_call("print(\"after\")")
    wires :: json_top_level_objects(json_array_field(graph, "wires"))
    control_wire :: (from: String, to: String) -> wires.find((wire) -> wire.contains("\"from_pin\":\"{from}:output:then\"") && wire.contains("\"to_pin\":\"{to}:input:exec\"") && wire.contains("\"wire_kind\":\"control\"") && wire.contains("\"from_source_span\":{{") && wire.contains("\"to_source_span\":{{"))
    assert(control_wire(before, debug) != None, "missing before -> debug wire: {graph}")
    assert(control_wire(debug, after) != None, "missing debug -> after wire: {graph}")
}
// Rust: tests/canvas.rs:1996
#Test("canvas_projects_and_edits_subjectless_guard_arms") {
    path :: write_fixture("subjectless_guards", "fn run() -> Int {{\n    ready :: true\n    if {{\n        ready -> {{ return 1 }}\n        else -> {{ return 0 }}\n    }}\n}}\n")
    graph :: graph_json_for_file(path).expect("canvas guard graph")
    assert(graph.contains("\"title\":\"if guards\""), graph)
    assert(graph.contains("\"pattern_source\":\"ready\""), graph)
    graph_id :: graph_id_for_title(graph, "run")
    (node_start, node_end) :: source_span_near(graph, "\"title\":\"if guards\"")
    source :: fs.read_to_string(path).unwrap()
    add :: "{{\"schema_version\":1,\"op\":\"add_pattern_arm\",\"revision\":\"{source_revision(source)}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end},\"pattern\":\"false\"}}"
    apply_transaction_json(path, add).expect("add guard arm")
    edited :: fs.read_to_string(path).unwrap()
    assert(edited.contains("false ->"), edited)
}
// Rust: tests/canvas.rs:2024
#Test("canvas_classic_pattern_branch_transactions_use_canonical_switch") {
    path :: write_fixture("classic_pattern_transactions", "fn choose(x: Int?) -> Int {{\n    if x == Val(_) {{ return 1 }} else {{ return 0 }}\n}}\n\nfn run() {{\n    print(choose(Val(1)))\n}}\n")
    graph :: graph_json_for_file(path).expect("classic pattern graph")
    assert(graph.contains("\"title\":\"if ==\""), graph)
    assert(!graph.contains("\"title\":\"if guards\""), graph)
    graph_id :: graph_id_for_title(graph, "choose")
    (pat_start, pat_end) :: source_span_near(graph, "\"pattern_source\":\"== Val(_)\"")
    before :: fs.read_to_string(path).unwrap()
    (node_start, node_end) :: source_span_near(graph, "\"title\":\"if ==\"")
    assert(before.slice(node_start, node_end).contains("else"))
    remove_last :: "{{\"schema_version\":1,\"op\":\"remove_pattern_arm\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"pattern_start\":{pat_start},\"pattern_end\":{pat_end}}}"
    err :: apply_transaction_json(path, remove_last).unwrap_err()
    assert(err.contains("can't remove the last pattern arm"), err)
    assert_eq(fs.read_to_string(path).unwrap(), before)
    edit :: "{{\"schema_version\":1,\"op\":\"edit_pattern_arm\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"pattern_start\":{pat_start},\"pattern_end\":{pat_end},\"pattern\":\"None\"}}"
    apply_transaction_json(path, edit).expect("edit classic pattern")
    edited :: fs.read_to_string(path).unwrap()
    assert(edited.contains("if x == .None"), edited)
    graph :: graph_json_for_file(path).expect("edited classic pattern graph")
    (node_start, node_end) :: source_span_near(graph, "\"title\":\"if ==\"")
    add :: "{{\"schema_version\":1,\"op\":\"add_pattern_arm\",\"revision\":\"{source_revision(edited)}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end},\"pattern\":\"Val(_)\"}}"
    apply_transaction_json(path, add).expect("add classic pattern arm")
    converted :: fs.read_to_string(path).unwrap()
    loop field in ["if x == {{", ".None ->", ".Val(_) ->", "else ->"] -> assert(converted.contains(field), converted)
}
