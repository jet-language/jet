// Private continuation of the Canvas integration suite; shared helpers/constants
// are the sole declarations in Canvas.jet. No duplicate test filesystem provider.
use jet.Canvas.[graph_json_for_file, project_json_for_entry, query_json_for_file, query_json_for_entry, apply_transaction_json, apply_project_transaction_json, source_revision]
use jet.[format_source]
use jet_foundation.[binder_descriptor, ForeignLanguage]
use std.[fs, sync, thread, env]
// GATE #4494: actual native filesystem, Barrier/Arc and thread providers.

// Rust: tests/canvas.rs:1776
#Test("canvas_multi_input_transactions_guard_nested_pattern_scope_and_stale_edits") {
    path :: write_fixture("nested_multi_input_tx", "fn choose(x: Int) -> Int {{\n    if x == {{\n        1 -> {{\n            values :: [1, 2]\n            return values[0]\n        }}\n        else -> {{ return 0 }}\n    }}\n}}\n\nfn run() {{ print(choose(1)) }}\n")
    graph_json :: graph_json_for_file(path).expect("nested multi-input graph")
    graph :: graph_object_for_title(graph_json, "choose")
    (list_start, list_end) :: source_span_near(graph, "\"title\":\"list\"")
    before :: fs.read_to_string(path).unwrap()
    append :: "{{\"schema_version\":1,\"op\":\"append_multi_input\",\"revision\":\"{source_revision(before)}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element\":\"3\"}}"
    apply_transaction_json(path, append).expect("append pattern-bound list element")
    appended :: fs.read_to_string(path).unwrap()
    assert(appended.contains("values :: [1, 2, 3]"), appended)
    assert_eq(appended, before.replacen("[1, 2]", "[1, 2, 3]", 1), "nested append must preserve canonical source spelling")
    graph_json :: graph_json_for_file(path).expect("graph after nested append")
    graph :: graph_object_for_title(graph_json, "choose")
    (list_start, list_end) :: source_span_near(graph, "\"title\":\"list\"")
    (item_start, item_end) :: source_span_near(graph, "\"name\":\"item3\"")
    remove :: "{{\"schema_version\":1,\"op\":\"remove_multi_input_element\",\"revision\":\"{source_revision(appended)}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element_start\":{item_start},\"element_end\":{item_end}}}"
    apply_transaction_json(path, remove).expect("remove nested list element after reprojection")
    restored :: fs.read_to_string(path).unwrap()
    assert_eq(restored, before, "nested append/remove must preserve source")
    graph_json :: graph_json_for_file(path).expect("graph before invalid append")
    graph :: graph_object_for_title(graph_json, "choose")
    (list_start, list_end) :: source_span_near(graph, "\"title\":\"list\"")
    invalid_before :: fs.read_to_string(path).unwrap()
    invalid :: "{{\"schema_version\":1,\"op\":\"append_multi_input\",\"revision\":\"{source_revision(invalid_before)}\",\"node_start\":{list_start},\"node_end\":{list_end},\"element\":\"true\"}}"
    err :: apply_transaction_json(path, invalid).unwrap_err()
    assert(err.contains("\"kind\":\"diagnostic\""), err)
    assert_eq(fs.read_to_string(path).unwrap(), invalid_before)
    stale :: "{{\"schema_version\":1,\"op\":\"append_multi_input\",\"revision\":\"sha256-stale\",\"node_start\":{list_start},\"node_end\":{list_end},\"element\":\"3\"}}"
    err :: apply_transaction_json(path, stale).unwrap_err()
    assert(err.contains("\"kind\":\"conflict\""), err)
    assert_eq(fs.read_to_string(path).unwrap(), invalid_before)
}
// Rust: tests/canvas.rs:1855
#Test("canvas_statement_state_nodes_and_toggle_transaction") {
    path :: write_fixture("statement_state", "fn run() {{\n    #Off print(\"off\")\n    #DebugOnly print(\"debug\")\n    print(\"on\")\n}}\n")
    graph :: graph_json_for_file(path).expect("state graph")
    loop field in ["\"node_descriptor_id\":\"switched\"", "\"title\":\"#Off\"", "\"badges\":[\"#Off\"]", "\"title\":\"#DebugOnly\"", "\"badges\":[\"#DebugOnly\"]", "toggle_switch_state"] -> assert(graph.contains(field), "statement-state graph missing {field}: {graph}")
    graph_id :: graph_id_for_title(graph, "run")
    (node_start, node_end) :: source_span_near(graph, "\"title\":\"#Off\"")
    before :: fs.read_to_string(path).unwrap()
    turn_on :: "{{\"schema_version\":1,\"op\":\"toggle_switch_state\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end}}}"
    apply_transaction_json(path, turn_on).expect("turn on state")
    on :: fs.read_to_string(path).unwrap()
    assert(!on.contains("#Off"), on)
    assert(on.contains("#DebugOnly print(\"debug\")"), on)
    graph :: graph_json_for_file(path).expect("graph after turn on")
    on_start :: on.find("print(\"on\")").expect("plain on call")
    (node_start, node_end) :: source_span_at_or_after(graph, "\"title\":\"print", on_start)
    turn_off :: "{{\"schema_version\":1,\"op\":\"toggle_switch_state\",\"revision\":\"{source_revision(on)}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end}}}"
    apply_transaction_json(path, turn_off).expect("turn off state")
    off :: fs.read_to_string(path).unwrap()
    assert(!off.contains("#Off print(\"off\")"), off)
    assert(off.contains("#Off print(\"on\")"), off)
    graph :: graph_json_for_file(path).expect("graph after turn off")
    off_on_start :: off.find("#Off print(\"on\")").expect("off plain on call")
    (node_start, node_end) :: source_span_at_or_after(graph, "\"title\":\"#Off\"", off_on_start)
    restore :: "{{\"schema_version\":1,\"op\":\"toggle_switch_state\",\"revision\":\"{source_revision(off)}\",\"graph_id\":\"{graph_id}\",\"node_start\":{node_start},\"node_end\":{node_end}}}"
    apply_transaction_json(path, restore).expect("restore state")
    assert_eq(fs.read_to_string(path).unwrap(), on)
}
