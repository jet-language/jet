    path :: write_fixture("core_catalog_default_alias", "fn run() {{\n    print(\"core\")\n}}\n")
    source :: fs.read_to_string(path).unwrap()
    request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{source_revision(source)}\"}}"
    actions :: query_json_for_file(path, request).expect("query core actions")
