// Rust: tests/canvas.rs:2530
#Test("canvas_concurrent_clients_get_one_winner_and_current_revision_conflict") {
    path :: write_fixture("concurrent_conflict", CANVAS_FIXTURE)
    before :: fs.read_to_string(path).unwrap()
    revision :: source_revision(before)
    first_request :: "{{\"schema_version\":1,\"op\":\"rename_binding\",\"revision\":\"{revision}\",\"from\":\"total\",\"to\":\"first\",\"client_id\":\"client-a\"}}"
    second_request :: "{{\"schema_version\":1,\"op\":\"rename_binding\",\"revision\":\"{revision}\",\"from\":\"total\",\"to\":\"second\",\"client_id\":\"client-b\"}}"
    barrier :: sync.Arc.new(sync.Barrier.new(2))
    first_path :: ~path
    first_barrier :: sync.Arc.clone(barrier)
    first :: thread.spawn(() -> { first_barrier.wait(); apply_transaction_json(first_path, first_request) })
    second_path :: ~path
    second_barrier :: sync.Arc.clone(barrier)
    second :: thread.spawn(() -> { second_barrier.wait(); apply_transaction_json(second_path, second_request) })
    first :: first.join().unwrap()
    second :: second.join().unwrap()
    assert(first.is_ok() != second.is_ok(), "exactly one client must win")
    loser :: first.err().or_else(() -> second.err()).expect("one conflict")
    current :: fs.read_to_string(path).unwrap()
    current_revision :: source_revision(current)
    assert(loser.contains("\"kind\":\"conflict\""), loser)
    assert(loser.contains("\"current_revision\":\"{current_revision}\""), loser)
}
