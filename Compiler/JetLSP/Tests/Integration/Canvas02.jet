// Rust: tests/canvas.rs:3456
#Test("canvas_core_insert_synthesizes_default_alias_import_without_import") {
    path :: write_fixture("core_insert_default_alias", "fn run() {{\n    print(1)\n}}\n")
    source :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("default alias graph")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(source)}\",\"graph_id\":\"{graph_id}\",\"callee\":\"math.abs\",\"args\":[\"1\"]}}"
    apply_transaction_json(path, insert).expect("default alias insert should synthesize Core import")
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("use core.math as math"), after)
    assert(after.contains("math.abs(1)"), after)
    assert_eq(format_source(after).unwrap(), after)
}
// Rust: tests/canvas.rs:3475
#Test("canvas_library_action_preserves_events_example_source_and_refuses_bad_edits") {
    repo :: OSPath(env.manifest_dir())
    example :: fs.read_to_string(repo.join("Examples/features/ui/events.jet")).expect("read events Canvas example")
    path :: write_fixture("library_events_example", example)
    graph :: graph_json_for_file(path).expect("project events example")
    source :: fs.read_to_string(path).unwrap()
    revision :: source_revision(source)
    actions_request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{revision}\"}}"
    actions :: query_json_for_file(path, actions_request).expect("query library actions for events example")
    loop field in ["\"action_id\":\"canvas.core_catalog:core.event:scope\"", "\"module_path\":\"core.event\"", "\"callee\":\"event.scope\"", "\"insert_op\":\"insert_call\"", "\"engine\":\"checked-tir+jit\"", "\"writes\":\"source_transaction_only\"", "\"source\":\"Docs/spec/reference/core-library.md\""] -> assert(actions.contains(field), "library action missing {field}: {actions}")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\",\"callee\":\"event.scope\",\"args\":[],\"bind\":\"scope_from_library\"}}"
    apply_transaction_json(path, insert).expect("insert library action")
    after :: fs.read_to_string(path).unwrap()
    assert(after.contains("scope_from_library :: event.scope()"), after)
    assert_eq(format_source(after).expect("format library edit"), after)
    projected :: graph_json_for_file(path).expect("reproject library edit")
    assert(projected.contains("scope_from_library"), projected)
    assert(projected.contains("\"source_span\""), "library node lost provenance: {projected}")
    bad_revision :: source_revision(after)
    bad :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{bad_revision}\",\"graph_id\":\"{graph_id}\",\"callee\":\"event.scope\",\"args\":[\"1\"],\"bind\":\"bad_scope\"}}"
    assert(apply_transaction_json(path, bad).is_err())
    assert_eq(fs.read_to_string(path).unwrap(), after, "ill-typed library edit wrote source")
    stale :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"sha256-stale\",\"graph_id\":\"{graph_id}\",\"callee\":\"event.scope\",\"args\":[],\"bind\":\"stale_scope\"}}"
    assert(apply_transaction_json(path, stale).is_err())
    assert_eq(fs.read_to_string(path).unwrap(), after, "stale library edit wrote source")
}
