    synth_out :: apply_transaction_json(synth_path, synth_insert).expect("core insert_call should synthesize import")
    assert(synth_out.contains("\"changed\":true"), synth_out)
    assert(synth_out.contains("use core.encoding.json as json"), "transaction result should include synthesized Core import: {synth_out}")
    synth_after :: fs.read_to_string(synth_path).unwrap()
    assert(synth_after.contains("use core.encoding.json as json"), synth_after)
    assert(synth_after.contains("json.decode(\"canvas\") ?? panic(\"canvas\")"), synth_after)
    synth_reproject :: graph_json_for_file(synth_path).expect("synth reproject")
    assert(synth_reproject.contains("\"title\":\".decode\""), "reproject should show inserted Core function node: {synth_reproject}")
}
// Rust: tests/canvas.rs:3096
#Test("canvas_actions_keep_entry_callees_and_exclude_foreign_binding_exports") {
    dir :: temp_dir("actions_exports")
    fs.create_dir_all(dir.join(".jet/bindings/js")).unwrap()
    descriptor :: binder_descriptor(ForeignLanguage.JS).expect("JavaScript binder descriptor").stamp()
    fs.write(dir.join(".jet/bindings/js/plotly.jet"), "// jet-ffi-descriptor={descriptor}\npub fn println() -> Int {{\n    return 1\n}}\n").unwrap()
    fs.write(dir.join("helper.jet"), "fn hidden(n: Int) -> Int {{\n    return n\n}}\n\npub fn square(n: Int) -> Int {{\n    return n * n\n}}\n\npub fn noisy(n: Int) -[IO]> Int {{\n    print(n)\n    return n\n}}\n").unwrap()
    path :: dir.join("main.jet")
    src :: "use \"./helper\" as h\nuse js.plotly as plot\n\nfn run() {{\n    print(plot.println())\n    print(h.square(2))\n}}\n"
    fs.write(path, src).unwrap()
    request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{source_revision(src)}\"}}"
    actions :: query_json_for_file(path, request).expect("actions query")
    assert(actions.contains("\"callee\":\"h.square\"") && actions.contains("\"insert_callee\":\"h.square\""), "imported action must use the entry-facing callee: {actions}")
    assert(actions.contains("\"rank\":74") && actions.contains("\"rank_terms\":[\"call\",\"pure\",\"function\"]"), "project action must carry descriptor-owned ranking facts: {actions}")
    noisy :: json_top_level_objects(json_array_field(actions, "actions")).find((action) -> action.contains("\"callee\":\"h.noisy\"")).expect("effectful imported action")
    assert(noisy.contains("\"node_descriptor_id\":\"function_exec\"") && noisy.contains("\"rank\":72") && noisy.contains("\"rank_terms\":[\"call\",\"function\"]"), "effectful imported action must keep its own descriptor ranking: {noisy}")
    assert(!actions.contains("\"module_path\":\"js.plotly\"") && !actions.contains("\"name\":\"println\"") && !actions.contains("\"name\":\"hidden\"") && !actions.contains("\"callee\":\"h.hidden\""), "foreign binding functions must not leak into the project palette: {actions}")
    graph :: graph_json_for_file(path).expect("actions graph")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"callee\":\"h.square\",\"args\":[\"1\"]}}"
    inserted :: apply_transaction_json(path, insert).expect("imported action insert")
    assert(inserted.contains("\"changed\":true"), inserted)
    changed :: fs.read_to_string(path).unwrap()
    assert(changed.contains("h.square(1)"), changed)
    assert_eq(format_source(changed).unwrap(), changed, "insert_call must preserve canonical formatting")
    graph :: graph_json_for_file(path).expect("graph after formatted insert")
    square_node :: json_top_level_objects(json_array_field(graph, "nodes")).find((node) -> node.contains(":method:square") && node.contains("\"node_descriptor_id\":\"function_exec\"")).expect("inserted imported call node")
    assert(square_node.contains("\"source_span\":{{\"start\":"), "inserted call must retain descriptor and source provenance: {square_node}")
    square_pin :: json_top_level_objects(json_array_field(graph, "pins")).find((pin) -> pin.contains(":method:square") && pin.contains("\"type\":\"Int\"")).expect("typed imported call pin")
    assert(square_pin.contains("\"node_id\":\""), square_pin)
    inline_id :: json_top_level_objects(json_array_field(graph, "inline_exprs")).find((inline) -> inline.contains(":method:square") && inline.contains("\"source\":\"1\"")).map((inline) -> json_field(inline, "inline_expr_id")).expect("editable imported call argument")
    edit :: "{{\"schema_version\":1,\"op\":\"edit_inline_expr\",\"revision\":\"{source_revision(changed)}\",\"inline_expr_id\":\"{inline_id}\",\"new_expr\":\"2\"}}"
    apply_transaction_json(path, edit).expect("edit imported call argument")
    edited :: fs.read_to_string(path).unwrap()
    assert(edited.contains("h.square(2)"), edited)
    assert_eq(format_source(edited).unwrap(), edited, "edit_inline_expr must preserve canonical formatting")
    reloaded :: graph_json_for_file(path).expect("reload edited imported call")
    reloaded_square :: json_top_level_objects(json_array_field(reloaded, "nodes")).find((node) -> node.contains(":method:square") && node.contains("\"node_descriptor_id\":\"function_exec\"")).expect("reloaded imported call node")
    assert(reloaded_square.contains("\"source_span\":{{\"start\":"), "reload must preserve imported call provenance: {reloaded_square}")
    assert(reloaded.contains("\"source\":\"2\""), "reload must preserve edited imported call spelling: {reloaded}")
    undo_source :: src.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    undo :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{source_revision(edited)}\",\"source\":\"{undo_source}\",\"undo_restore\":\"Undo\"}}"
    apply_transaction_json(path, undo).expect("undo imported call edits")
    assert_eq(fs.read_to_string(path).unwrap(), src, "undo must restore the original canonical source")
    graph :: graph_json_for_file(path).expect("graph after undo")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    before_invalid :: fs.read_to_string(path).unwrap()
    invalid :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(before_invalid)}\",\"graph_id\":\"{graph_id}\",\"callee\":\"println\",\"args\":[\"1\"]}}"
    error :: apply_transaction_json(path, invalid).unwrap_err()
    assert(error.contains("diagnostic") || error.contains("E"), error)
    assert_eq(fs.read_to_string(path).unwrap(), before_invalid)
}
// Rust: tests/canvas.rs:3254
#Test("canvas_actions_preserve_nested_imported_module_callee") {
    dir :: temp_dir("actions_nested_import")
    fs.write(dir.join("helper.jet"), "module tools {{\n    pub fn square(n: Int) -> Int {{\n        return n * n\n    }}\n}}\n").unwrap()
    path :: dir.join("main.jet")
    src :: "use \"./helper\" as h\n\nfn run(limit: Int) {{\n    print(limit)\n}}\n"
    fs.write(path, src).unwrap()
    request :: "{{\"schema_version\":1,\"op\":\"actions\",\"revision\":\"{source_revision(src)}\"}}"
    actions :: query_json_for_file(path, request).expect("nested actions query")
    square :: json_top_level_objects(json_array_field(actions, "actions")).find((action) -> action.contains("\"title\":\"square\"")).expect("nested imported action")
    assert(square.contains("\"callee\":\"h.tools.square\"") && square.contains("\"insert_callee\":\"h.tools.square\"") && square.contains("\"node_descriptor_id\":\"function_pure\""), "nested imported action must retain checked callee and descriptor: {square}")
    assert(!square.contains("\"callee\":\"h.square\"") && !square.contains("\"insert_callee\":\"h.square\""), "nested imported action must not flatten its checked scope: {square}")
    graph :: graph_json_for_file(path).expect("nested import graph")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"callee\":\"h.tools.square\",\"args\":[\"limit\"]}}"
    apply_transaction_json(path, insert).expect("nested imported insert")
    changed :: fs.read_to_string(path).unwrap()
    assert(changed.contains("h.tools.square(limit)"), changed)
    assert_eq(format_source(changed).unwrap(), changed, "nested imported insert must remain canonical")
    reloaded :: graph_json_for_file(path).expect("reload nested import graph")
    square_node :: json_top_level_objects(json_array_field(reloaded, "nodes")).find((node) -> node.contains(":method:square")).expect("reloaded nested imported call node")
    assert(square_node.contains("\"node_descriptor_id\":\"function_pure\"") && square_node.contains("\"source_span\":{{\"start\":"), "nested imported call must retain descriptor and provenance: {square_node}")
    stale :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(changed)}\",\"graph_id\":\"{graph_id}\",\"callee\":\"h.square\",\"args\":[\"limit\"]}}"
    stale_error :: apply_transaction_json(path, stale).unwrap_err()
    assert(stale_error.contains("diagnostic") || stale_error.contains("E"), "flattened nested callee must fail sema: {stale_error}")
    assert_eq(fs.read_to_string(path).unwrap(), changed)
}
// Rust: tests/canvas.rs:3327
#Test("canvas_core_catalog_browses_canonical_core_library_without_write_authority") {
    path :: write_fixture("core_catalog", "use core.math as m\n\nfn run() {{\n    print(\"core\")\n}}\n")
    src :: fs.read_to_string(path).unwrap()
    revision :: source_revision(src)
    query :: "{{\"schema_version\":1,\"op\":\"core_catalog\",\"revision\":\"{revision}\",\"query\":\"\"}}"
    catalog :: query_json_for_file(path, query).expect("Canvas core catalog query")
    loop field in ["\"op\":\"core_catalog\"", "\"catalog_schema_version\":1", "\"authority\":[\"canvas.catalog:core.read\"]", "\"writes\":\"none\"", "\"source\":\"Docs/spec/reference/core-library.md\"", "\"path\":\"core.http\"", "\"path\":\"core.http.client\"", "\"path\":\"core.files\"", "\"path\":\"core.net.url\"", "\"path\":\"core.net.mime\"", "\"path\":\"core.crypto\"", "\"path\":\"core.event\"", "\"path\":\"core.web\"", "\"path\":\"core.mem\"", "\"signature\":\"client.request(method, url)\"", "\"name\":\"request\"", "\"pure\"", "\"insert_callee\":\"m.abs\""] -> assert(catalog.contains(field), "catalog missing {field}: {catalog}")
    sema_query :: "{{\"schema_version\":1,\"op\":\"core_catalog\",\"revision\":\"{revision}\",\"query\":\"window_open\"}}"
    sema_catalog :: query_json_for_file(path, sema_query).expect("Canvas sema catalog query")
    loop field in ["\"path\":\"core.game.raylib\"", "\"name\":\"window_open\"", "\"signature\":\"core.game.raylib.window_open\"", "\"source\":\"crates/jet-sema/src/Sema/CheckerCoreLib/module_items.rs\""] -> assert(sema_catalog.contains(field), "sema catalog missing {field}: {sema_catalog}")
    assert_eq(fs.read_to_string(path).unwrap(), src, "Core catalog browsing must not edit source")
    args_query :: "{{\"schema_version\":1,\"op\":\"core_catalog\",\"revision\":\"{revision}\",\"query\":\"help\"}}"
    args_catalog :: query_json_for_file(path, args_query).expect("Canvas args catalog query")
    loop field in ["\"path\":\"core.args\"", "\"name\":\"help\"", "\"available\":false", "\"stageable\":true", "\"stage_reason_code\":\"method_only\"", "\"receiver_type\":\"ArgsSpec\"", "\"name\":\"receiver\",\"direction\":\"input\",\"type\":\"ArgsSpec\"", "\"unavailable_reason_code\":\"method_only\"", "Use this as a method on an ArgsSpec value."] -> assert(args_catalog.contains(field), args_catalog)
}
