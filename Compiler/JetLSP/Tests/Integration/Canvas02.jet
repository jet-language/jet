#Test("canvas_query_search_references_source_jump_and_rename_preview") {
    path :: write_fixture("query", CANVAS_FIXTURE)
    src :: fs.read_to_string(path).unwrap()
    revision :: source_revision(src)
    find :: "{{\"schema_version\":1,\"op\":\"find\",\"revision\":\"{revision}\",\"query\":\"square\"}}"
    found :: query_json_for_file(path, find).expect("find query")
    loop field in ["\"protocol\":\"jet.canvas.query\"", "\"op\":\"find\"", "\"kind\":\"definition\"", "\"graph_id\":\"fn:", "\"node_id\""] -> assert(found.contains(field), found)
    refs :: "{{\"schema_version\":1,\"op\":\"references\",\"revision\":\"{revision}\",\"symbol\":\"total\"}}"
    refs :: query_json_for_file(path, refs).expect("references query")
    loop field in ["\"kind\":\"definition\"", "\"kind\":\"reference\"", "\"impact\""] -> assert(refs.contains(field), refs)
    start :: src.find("total := square").expect("total binding")
    jump :: "{{\"schema_version\":1,\"op\":\"source_to_graph\",\"revision\":\"{revision}\",\"start\":{start},\"end\":{start + 5}}}"
    jump :: query_json_for_file(path, jump).expect("source jump query")
    assert(jump.contains("\"op\":\"source_to_graph\""), jump)
    assert(jump.contains(":binding"), jump)
    preview :: "{{\"schema_version\":1,\"op\":\"preview_rename\",\"revision\":\"{revision}\",\"symbol\":\"total\",\"to\":\"score\"}}"
    preview :: query_json_for_file(path, preview).expect("rename preview query")
    loop field in ["\"diff\"", "-    total := square(limit)", "+    score := square(limit)"] -> assert(preview.contains(field), preview)
    assert(fs.read_to_string(path).unwrap().contains("total := square(limit)"), "preview must not write")
    stale :: "{{\"schema_version\":1,\"op\":\"find\",\"revision\":\"sha256-stale\",\"query\":\"total\"}}"
    err :: query_json_for_file(path, stale).unwrap_err()
    assert(err.contains("\"kind\":\"conflict\""), err)
}
// Rust: tests/canvas.rs:2650
#Test("canvas_project_search_and_references_share_project_revision") {
    dir :: temp_dir("project_query")
    fs.write(dir.join("package.jet"), "name: \"project_query\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "fn helper() -> Int {{\n    return 1\n}}\n\nfn run() {{\n    helper()\n}}\n").unwrap()
    other :: dir.join("helper.jet")
    fs.write(other, "fn helper() -> Int {{\n    return 2\n}}\n\nfn use_helper() {{\n    helper()\n}}\n").unwrap()
    project_revision :: json_field(project_json_for_entry(entry), "project_revision")
    entry_src :: fs.read_to_string(entry).unwrap()
    entry_revision :: source_revision(entry_src)
    search :: "{{\"schema_version\":1,\"op\":\"project_search\",\"source_id\":\"main.jet\",\"revision\":\"{entry_revision}\",\"project_revision\":\"{project_revision}\",\"query\":\"helper\"}}"
    found :: query_json_for_entry(entry, search).expect("project search")
    loop field in ["\"op\":\"project_search\"", "\"project_revision\":\"sha256-", "\"source_id\":\"main.jet\"", "\"source_id\":\"helper.jet\"", "\"kind\":\"definition\""] -> assert(found.contains(field), "project search missing {field}: {found}")
    references :: "{{\"schema_version\":1,\"op\":\"references\",\"source_id\":\"main.jet\",\"revision\":\"{entry_revision}\",\"project_revision\":\"{project_revision}\",\"symbol\":\"helper\"}}"
    refs :: query_json_for_entry(entry, references).expect("project references")
    assert(refs.contains("\"op\":\"references\""), refs)
    assert(refs.contains("\"impact\""), refs)
    assert(refs.matches("\"kind\":\"definition\"").count() >= 2, refs)
    assert(refs.matches("\"kind\":\"reference\"").count() >= 2, refs)
    fs.write(other, "fn helper() -> Int {{\n    return 3\n}}\n").unwrap()
    stale :: query_json_for_entry(entry, search).expect_err("stale project query")
    assert(stale.contains("\"kind\":\"conflict\""), stale)
    assert(fs.read_to_string(other).unwrap().contains("return 3"))
}
// Rust: tests/canvas.rs:2718
#Test("canvas_project_rename_preview_and_atomic_commit_use_semantic_sites") {
    dir :: temp_dir("project_rename")
    fs.write(dir.join("package.jet"), "name: \"project_rename\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: dir.join("main.jet")
    fs.write(entry, "pub fn helper() -> Int {{\n    return 1\n}}\n\nfn run() {{\n    print(helper())\n}}\n").unwrap()
    other :: dir.join("other.jet")
    fs.write(other, "use \"./main\" as main\n\nfn use_helper() -> Int {{\n    return main.helper()\n}}\n").unwrap()
    unrelated :: dir.join("unrelated.jet")
    fs.write(unrelated, "fn helper() -> Int {{\n    return 99\n}}\n\nfn local() -> Int {{\n    return helper()\n}}\n").unwrap()
    project :: project_json_for_entry(entry)
    project_revision :: json_field(project, "project_revision")
    main_before :: fs.read_to_string(entry).unwrap()
    other_before :: fs.read_to_string(other).unwrap()
    unrelated_before :: fs.read_to_string(unrelated).unwrap()
    main_revision :: source_revision(main_before)
    request :: "{{\"schema_version\":1,\"op\":\"preview_rename\",\"source_id\":\"main.jet\",\"revision\":\"{main_revision}\",\"project_revision\":\"{project_revision}\",\"symbol\":\"helper\",\"to\":\"compute\"}}"
    preview :: query_json_for_entry(entry, request).expect("project rename preview")
    loop field in ["\"op\":\"preview_rename\"", "\"project_revision\":\"sha256-", "\"source_id\":\"main.jet\"", "\"source_id\":\"other.jet\"", "\"source_id\":\"unrelated.jet\"", "\"files\"", "-pub fn helper()", "+pub fn compute()"] -> assert(preview.contains(field), "rename preview missing {field}: {preview}")
    assert_eq(fs.read_to_string(entry).unwrap(), main_before)
    assert_eq(fs.read_to_string(other).unwrap(), other_before)
    assert_eq(fs.read_to_string(unrelated).unwrap(), unrelated_before)
    touched :: "[{{\"path\":\"main.jet\",\"revision\":\"{main_revision}\"}},{{\"path\":\"other.jet\",\"revision\":\"{source_revision(other_before)}\"}}]"
    apply :: "{{\"schema_version\":1,\"op\":\"rename_binding\",\"preview\":false,\"project_revision\":\"{project_revision}\",\"files\":{touched},\"source_id\":\"main.jet\",\"from\":\"helper\",\"to\":\"compute\"}}"
    committed :: apply_project_transaction_json(entry, apply).expect("project rename commit")
    assert(committed.contains("\"writes\":\"source_transaction\""), committed)
    assert(fs.read_to_string(entry).unwrap().contains("compute()"))
    assert(fs.read_to_string(other).unwrap().contains("compute()"))
    receipt :: fs.read_dir(dir.join(".jet/codemods")).unwrap().filter_map((entry) -> entry.ok()).map((entry) -> entry.path()).find((path) -> path.file_name().and_then((name) -> name.to_str()).is_some_and((name) -> name.starts_with("CanvasProjectRename-") && name.ends_with(".log.json"))).expect("project rename receipt")
    receipt :: fs.read_to_string(receipt).unwrap()
    loop field in ["\"kind\":\"rename\"", "\"from\":\"helper\"", "\"to\":\"compute\""] -> assert(receipt.contains(field), receipt)
    stale :: apply_project_transaction_json(entry, apply).expect_err("old project rename must be rejected")
    assert(stale.contains("\"kind\":\"conflict\""), stale)
    assert(fs.read_to_string(entry).unwrap().contains("compute()"))
    assert(fs.read_to_string(other).unwrap().contains("compute()"))
}
