// Rust: tests/canvas.rs:2091
#Test("canvas_wired_insert_transaction_writes_call_with_origin_value") {
    path :: write_fixture("wired_insert", "fn use_int(n: Int) {{\n    print(n)\n}}\n\nfn demo(x: Int) {{\n}}\n\nfn run() {{\n    demo(1)\n}}\n")
    src :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("canvas graph")
    demo_graph_id :: field_before(graph, "\"title\":\"demo\"", "graph_id")
    insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{demo_graph_id}\",\"callee\":\"use_int\",\"args\":[],\"wire_origin_pin_id\":\"local:x\",\"wire_target_pin\":\"n\",\"wire_expr\":\"x\"}}"
    out :: apply_transaction_json(path, insert).expect("wired insert")
    assert(out.contains("\"changed\":true"), out)
    changed :: fs.read_to_string(path).unwrap()
    assert(changed.contains("use_int(x)"), changed)
    projected :: graph_json_for_file(path).expect("canvas graph after insert")
    assert(projected.contains("\"title\":\"use_int\""), projected)
    assert(projected.contains("\"wire_kind\":\"data\""), projected)
    no_arg_path :: write_fixture("wired_insert_exec_no_arg", "fn helper() {{\n    print(\"ok\")\n}}\n\nfn run() {{\n    print(\"start\")\n}}\n")
    no_arg_src :: fs.read_to_string(no_arg_path).unwrap()
    no_arg_graph :: graph_json_for_file(no_arg_path).expect("canvas graph")
    run_graph_id :: field_before(no_arg_graph, "\"title\":\"run\"", "graph_id")
    exec_insert :: "{{\"schema_version\":1,\"op\":\"insert_call\",\"revision\":\"{source_revision(no_arg_src)}\",\"graph_id\":\"{run_graph_id}\",\"callee\":\"helper\",\"args\":[],\"wire_origin_pin_id\":\"entry:output:then\",\"wire_target_pin\":\"exec\"}}"
    out :: apply_transaction_json(no_arg_path, exec_insert).expect("exec-origin no-arg wired insert")
    assert(out.contains("\"changed\":true"), out)
    changed :: fs.read_to_string(no_arg_path).unwrap()
    assert(changed.contains("helper()"), changed)
    assert(!changed.contains("helper(1)"), changed)
}
// Rust: tests/canvas.rs:2150
#Test("canvas_comment_regions_round_trip_through_source_comments") {
    path :: write_fixture("comment_region", CANVAS_COMMENT_FIXTURE)
    src :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("canvas graph")
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    start :: src.find("print").expect("print call")
    end :: start + "print(\"damage\")".bytes().len()
    create :: "{{\"schema_version\":1,\"op\":\"create_comment_region\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"start\":{start},\"end\":{end},\"title\":\"Damage path\",\"color\":\"#2f80ed\",\"alpha\":\"0.25\",\"bounds\":\"10,20,320,140\"}}"
    out :: apply_transaction_json(path, create).expect("create comment region")
    assert(out.contains("\"changed\":true"), out)
    commented :: fs.read_to_string(path).unwrap()
    assert(commented.contains("// canvas:comment"), commented)
    assert(commented.contains("title=\"Damage path\""), commented)
    graph :: graph_json_for_file(path).expect("comment graph")
    loop field in ["\"kind\":\"comment\"", "\"title\":\"Damage path\"", "\"color\":\"#2f80ed\"", "\"alpha\":\"0.25\"", "\"bounds\""] -> assert(graph.contains(field), "comment graph missing {field}: {graph}")
    region_id :: field_before(graph, "\"title\":\"Damage path\"", "region_id")
    edit :: "{{\"schema_version\":1,\"op\":\"edit_comment_region\",\"revision\":\"{source_revision(commented)}\",\"region_id\":\"{region_id}\",\"title\":\"Validated damage\",\"color\":\"#22c55e\",\"alpha\":\"0.4\",\"bounds\":\"30,40,360,180\"}}"
    apply_transaction_json(path, edit).expect("edit comment region")
    edited :: fs.read_to_string(path).unwrap()
    loop field in ["title=\"Validated damage\"", "color=\"#22c55e\"", "bounds=(30,40,360,180)"] -> assert(edited.contains(field), edited)
    graph :: graph_json_for_file(path).expect("edited comment graph")
    assert(graph.contains("\"title\":\"Validated damage\""), graph)
    assert(graph.contains("\"x\":30"), graph)
    delete :: "{{\"schema_version\":1,\"op\":\"delete_comment_region\",\"revision\":\"{source_revision(edited)}\",\"region_id\":\"{region_id}\"}}"
    apply_transaction_json(path, delete).expect("delete comment region")
    deleted :: fs.read_to_string(path).unwrap()
    assert(!deleted.contains("canvas:comment"), deleted)
    assert(deleted.contains("print(\"damage\")"), deleted)
}
// Rust: tests/canvas.rs:2210
#Test("canvas_collapse_extract_preview_and_inline_are_source_refactors") {
    path :: write_fixture("collapse_extract", CANVAS_COLLAPSE_FIXTURE)
    src :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("canvas graph")
    graph_id :: field_before(graph, "\"title\":\"compute\"", "graph_id")
    expr_id :: field_before(graph, "\"source\":\"limit + 1\"", "inline_expr_id")
    start :: src.find("return limit + 1").expect("return span")
    end :: start + "return limit + 1".bytes().len()
    collapse :: "{{\"schema_version\":1,\"op\":\"create_collapsed_region\",\"revision\":\"{source_revision(src)}\",\"graph_id\":\"{graph_id}\",\"start\":{start},\"end\":{end},\"title\":\"Compute body\"}}"
    apply_transaction_json(path, collapse).expect("collapse region")
    collapsed :: fs.read_to_string(path).unwrap()
    assert(collapsed.contains("// canvas:collapse"), collapsed)
    graph :: graph_json_for_file(path).expect("collapse graph")
    assert(graph.contains("\"kind\":\"collapse\""), graph)
    collapse_region :: field_before(graph, "\"title\":\"Compute body\"", "region_id")
    expand :: "{{\"schema_version\":1,\"op\":\"expand_collapsed_region\",\"revision\":\"{source_revision(collapsed)}\",\"region_id\":\"{collapse_region}\"}}"
    apply_transaction_json(path, expand).expect("expand collapse region")
    expanded :: fs.read_to_string(path).unwrap()
    assert(!expanded.contains("canvas:collapse"), expanded)
    preview :: "{{\"schema_version\":1,\"op\":\"preview_extract_inline_expr\",\"revision\":\"{source_revision(expanded)}\",\"inline_expr_id\":\"{expr_id}\",\"function\":\"inc_limit\",\"ret_type\":\"Int\"}}"
    preview_out :: apply_transaction_json(path, preview).expect("extract preview")
    assert(preview_out.contains("\"protocol\":\"jet.canvas.preview\""), preview_out)
    assert(preview_out.contains("+fn inc_limit(limit: Int) -> Int"), preview_out)
    assert_eq(fs.read_to_string(path).unwrap(), expanded)
    extract :: preview.replace("preview_extract_inline_expr", "extract_inline_expr")
    apply_transaction_json(path, extract).expect("extract inline")
    extracted :: fs.read_to_string(path).unwrap()
    assert(extracted.contains("fn inc_limit(limit: Int) -> Int"), extracted)
    assert(extracted.contains("return inc_limit(limit)"), extracted)
    call_start :: extracted.find("inc_limit(limit)").expect("helper call")
    inline :: "{{\"schema_version\":1,\"op\":\"inline_helper_call\",\"revision\":\"{source_revision(extracted)}\",\"start\":{call_start},\"end\":{call_start + "inc_limit(limit)".bytes().len()}}}"
    apply_transaction_json(path, inline).expect("inline helper")
    inlined :: fs.read_to_string(path).unwrap()
    assert(inlined.contains("return limit + 1"), inlined)
}
// Rust: tests/canvas.rs:2278
#Test("canvas_structural_writes_insert_control_and_fallible_rails_with_undo_source") {
    path :: write_fixture("structural_writes", CANVAS_STRUCTURAL_WRITE_FIXTURE)
    original :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("canvas graph")
    assert(graph.contains("\"source_text\""), graph)
    graph_id :: field_before(graph, "\"title\":\"run\"", "graph_id")
    loop op in ["insert_branch", "insert_switch", "insert_loop", "insert_fallible_rail"] {
        revision :: source_revision(fs.read_to_string(path).unwrap())
        req :: "{{\"schema_version\":1,\"op\":\"{op}\",\"revision\":\"{revision}\",\"graph_id\":\"{graph_id}\"}}"
        out :: apply_transaction_json(path, req).expect(op)
        assert(out.contains("\"source_text\""), out)
    }
    written :: fs.read_to_string(path).unwrap()
    loop field in ["if true", "if 0 ==", "loop {{", "fallible_value :: Int.parse(\"1\")", "unwrapped :: fallible_value ?? 0"] -> assert(written.contains(field), "missing {field}: {written}")
    graph :: graph_json_for_file(path).expect("structural graph")
    loop field in ["\"kind\":\"branch\"", "\"kind\":\"function\"", "\"kind\":\"loop\"", "\"kind\":\"fallible\"", "\"fallible\""] -> assert(graph.contains(field), "structural graph missing {field}: {graph}")
    escaped_original :: original.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    undo :: "{{\"schema_version\":1,\"op\":\"replace_source\",\"revision\":\"{source_revision(written)}\",\"source\":\"{escaped_original}\"}}"
    apply_transaction_json(path, undo).expect("undo source replace")
    expected :: format_source(original).expect("format original")
    assert_eq(fs.read_to_string(path).unwrap(), expected)
}
// Rust: tests/canvas.rs:2339
#Test("canvas_structural_insert_uses_exec_pin_target_and_refuses_stale_target") {
    path :: write_fixture("structural_pin_target", "fn run() {{\n    print(\"before\")\n    print(\"target\")\n    print(\"after\")\n}}\n")
    before :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("target graph")
    graph_id :: graph_id_for_title(graph, "run")
    target_node_id :: field_before(graph, "\"source\":\"\\\"target\\\"\"", "node_id")
    target_pin :: "{target_node_id}:input:exec"
    insert :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"wire_origin_pin_id\":\"{target_pin}\",\"wire_target_pin\":\"exec\"}}"
    apply_transaction_json(path, insert).expect("targeted branch insert")
    inserted :: fs.read_to_string(path).unwrap()
    branch :: inserted.find("if true").expect("branch source")
    assert(branch > inserted.find("print(\"before\")").unwrap())
    assert(branch < inserted.find("print(\"target\")").unwrap())
    assert(inserted.contains("print(\"after\")"), inserted)
    assert_eq(format_source(inserted).expect("format targeted branch"), inserted)
    graph_after :: graph_json_for_file(path).expect("reproject targeted branch")
    assert(graph_after.contains("\"kind\":\"branch\""), graph_after)
    stale_target :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(inserted)}\",\"graph_id\":\"{graph_id}\",\"wire_origin_pin_id\":\"{target_node_id}:input:exec\",\"wire_target_pin\":\"exec\"}}"
    err :: apply_transaction_json(path, stale_target).unwrap_err()
    assert(err.contains("Canvas insertion pin no longer exists"), err)
    assert_eq(fs.read_to_string(path).unwrap(), inserted)
    live_target_node_id :: field_before(graph_after, "\"source\":\"\\\"target\\\"\"", "node_id")
    unknown_pin :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(inserted)}\",\"graph_id\":\"{graph_id}\",\"wire_origin_pin_id\":\"{live_target_node_id}:input:not_a_pin\",\"wire_target_pin\":\"exec\"}}"
    err :: apply_transaction_json(path, unknown_pin).unwrap_err()
    assert(err.contains("Canvas insertion pin no longer exists"), err)
    assert_eq(fs.read_to_string(path).unwrap(), inserted)
    output_path :: write_fixture("structural_output_target", "fn run() {{\n    print(\"before\")\n    print(\"target\")\n}}\n")
    output_before :: fs.read_to_string(output_path).unwrap()
    output_graph :: graph_json_for_file(output_path).expect("output target graph")
    output_graph_id :: graph_id_for_title(output_graph, "run")
    output_node_id :: field_before(output_graph, "\"source\":\"\\\"before\\\"\"", "node_id")
    output_insert :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(output_before)}\",\"graph_id\":\"{output_graph_id}\",\"wire_origin_pin_id\":\"{output_node_id}:output:then\",\"wire_target_pin\":\"exec\"}}"
    apply_transaction_json(output_path, output_insert).expect("output-targeted branch insert")
    output_inserted :: fs.read_to_string(output_path).unwrap()
    assert(output_inserted.find("if true").unwrap() > output_inserted.find("print(\"before\")").unwrap())
    assert(output_inserted.find("if true").unwrap() < output_inserted.find("print(\"target\")").unwrap())
}
