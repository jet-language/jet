#Test("canvas_structural_incomplete_wire_refuses_without_writing") {
    path :: write_fixture("structural_incomplete_wire", "fn run() {{\n    print(\"target\")\n}}\n")
    before :: fs.read_to_string(path).unwrap()
    graph :: graph_json_for_file(path).expect("incomplete wire graph")
    graph_id :: graph_id_for_title(graph, "run")
    target_node_id :: field_before(graph, "\"source\":\"\\\"target\\\"\"", "node_id")
    request :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"wire_origin_pin_id\":\"{target_node_id}:input:exec\"}}"
    err :: apply_transaction_json(path, request).expect_err("incomplete structural wire must be rejected")
    assert(err.contains("Canvas structural wire target is missing"), err)
    assert_eq(fs.read_to_string(path).unwrap(), before)
    target_only_request :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(before)}\",\"graph_id\":\"{graph_id}\",\"wire_target_pin\":\"exec\"}}"
    target_only_err :: apply_transaction_json(path, target_only_request).expect_err("structural wire without an origin must be rejected")
    assert(target_only_err.contains("Canvas structural wire origin is missing"), target_only_err)
    assert_eq(fs.read_to_string(path).unwrap(), before)
    data_path :: write_fixture("structural_data_wire", "fn run() {{\n    doubled :: 1\n}}\n")
    data_before :: fs.read_to_string(data_path).unwrap()
    data_graph :: graph_json_for_file(data_path).expect("data wire graph")
    data_graph_id :: graph_id_for_title(data_graph, "run")
    data_pin :: data_graph.split("\"pin_id\":\"").skip(1).find_map((chunk) -> {
        pin_id :: chunk.split('"').first() ?? return None
        if pin_id.starts_with(data_graph_id) && chunk.contains("\"direction\":\"output\"") && chunk.contains("\"type\":\"Int\"") -> Val(pin_id) else -> None
    }).expect("entry data pin")
    data_request :: "{{\"schema_version\":1,\"op\":\"insert_branch\",\"revision\":\"{source_revision(data_before)}\",\"graph_id\":\"{data_graph_id}\",\"wire_origin_pin_id\":\"{data_pin}\",\"wire_target_pin\":\"exec\"}}"
    data_err :: apply_transaction_json(data_path, data_request).expect_err("data structural wire must be rejected")
    assert(data_err.contains("Canvas structural nodes connect through the exec pin"), data_err)
    assert_eq(fs.read_to_string(data_path).unwrap(), data_before)
}
