// Rust: tests/semindex.rs:814
#Test("semindex_identity_stable_across_reorder") {
    a :: "\nmodule math {{\n    pub fn double(n: Int) -> Int {{\n        return n * 2\n    }}\n}}\n\nstruct Point {{\n    x: Int\n    y: Int\n\n    fn sum(self) -> Int {{\n        return self.x + self.y\n    }}\n}}\n\nimpl Point {{\n    fn origin() -> Point {{\n        return Point.{{x: 0, y: 0}}\n    }}\n}}\n\nenum Light {{\n    Red\n    Green\n}}\n\nfn helper(p: Point) -> Int {{\n    return p.sum()\n}}\n\nfn run() {{\n    p :: Point.origin()\n    print(helper(p))\n}}\n"
    b :: "\nenum Light {{\n    Red\n    Green\n}}\n\nfn helper(p: Point) -> Int {{\n    return p.sum()\n}}\n\nstruct Point {{\n    x: Int\n    y: Int\n\n    fn sum(self) -> Int {{\n        return self.x + self.y\n    }}\n}}\n\nmodule math {{\n    pub fn double(n: Int) -> Int {{\n        return n * 2\n    }}\n}}\n\nimpl Point {{\n    fn origin() -> Point {{\n        return Point.{{x: 0, y: 0}}\n    }}\n}}\n\nfn run() {{\n    p :: Point.origin()\n    print(helper(p))\n}}\n"
    path :: temp_fixture("identity_reorder.jet", a)
    before :: open(path).expect("first fixture indexes")
    fs.write(path, b).expect("rewrite semindex fixture")
    after :: open(path).expect("reordered fixture indexes")
    before_ids := before.definitions().iter().map(d -> d.identity.clone()).collect<[String]>()
    after_ids := after.definitions().iter().map(d -> d.identity.clone()).collect<[String]>()
    before_ids.sort()
    after_ids.sort()
    assert_eq(before_ids, after_ids)
    assert(before_ids.iter().any(id -> id.contains("module:")))
    assert(before_ids.iter().any(id -> id.contains("fn:")))
    assert(before_ids.iter().any(id -> id.contains("type:") && id.contains("Point")))
    assert(before_ids.iter().any(id -> id.contains("field:") && id.contains("Point.x")))
    assert(before_ids.iter().any(id -> id.contains("variant:") && id.contains("Light.Red")))
    assert(before_ids.iter().any(id -> id.contains("method:") && id.contains("Point.sum")))
}

// Rust: tests/semindex.rs:923
#Test("returned_view_provenance_is_structured_and_changes_signature_id") {
    path :: temp_fixture("view_provenance.jet", "fn pick(left: [Int], right: [Int], first: Bool) -> View<Int> {{\n    if first {{ return left[0..1] }}\n    return right[0..1]\n}}\nfn run() {{}}\n")
    union :: open(path).expect("multi-source view provenance indexes")
    pick :: union.lookup("pick").expect("pick definition")
    assert(match pick.kind { SymbolKind.Function { .. } -> true; else -> false })
    assert_eq(pick.view_provenance.len(), 1)
    provenance :: pick.view_provenance[0]
    assert(provenance.output_path.is_empty())
    assert_eq(provenance.sources.len(), 2)
    assert_eq(provenance.sources[0].source, ViewSourceFact.Parameter(0))
    assert_eq(provenance.sources[0].projections, [ViewProjectionFact.Range])
    assert_eq(provenance.sources[1].source, ViewSourceFact.Parameter(1))
    assert_eq(provenance.sources[1].projections, [ViewProjectionFact.Range])
    assert(!provenance.mutable)
    union_signature :: union.definition_facts().iter().find(fact -> fact.name == "pick").unwrap().signature_id
    json :: union.to_json()
    assert(json.contains("\"view_provenance\":[{{\"output_path\":[],\"sources\":[{{\"source\":{{\"kind\":\"parameter\",\"index\":0}}"))
    assert(json.contains("\"source\":{{\"kind\":\"parameter\",\"index\":1}}"))
    assert(json.contains("\"projections\":[{{\"kind\":\"range\"}}]"))
    fs.write(path, "fn pick(left: [Int], right: [Int], first: Bool) -> View<Int> {{ return right[0..1] }}\nfn run() {{}}\n").unwrap()
    right :: open(path).expect("parameter-1 view provenance indexes")
    right_pick :: right.lookup("pick").expect("pick definition")
    assert_eq(right_pick.view_provenance[0].canonical(), "slot:$;parameter:1;access:read;path:range")
    right_signature :: right.definition_facts().iter().find(fact -> fact.name == "pick").unwrap().signature_id
    assert_ne(union_signature, right_signature)
}

// Rust: tests/semindex.rs:979
#Test("aggregate_view_provenance_preserves_slots_and_changes_signature_id") {
    source :: (right_owner: &String) -> "\nstruct Pair {{ left: View<Int>, right: View<Int> }}\n\nfn pair(left: [Int], right: [Int]) -> Pair {{\n    left_view :: left[0..1]\n    right_view :: {right_owner}[0..1]\n    return Pair.{{ left: left_view, right: right_view }}\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("aggregate_view_provenance.jet", source("right"))
    distinct :: open(path).expect("aggregate view provenance indexes")
    pair :: distinct.lookup("pair").expect("pair definition")
    assert_eq(pair.view_provenance.len(), 2)
    assert_eq(pair.view_provenance[0].output_path, ["left"])
    assert_eq(pair.view_provenance[0].sources[0].source, ViewSourceFact.Parameter(0))
    assert_eq(pair.view_provenance[1].output_path, ["right"])
    assert_eq(pair.view_provenance[1].sources[0].source, ViewSourceFact.Parameter(1))
    distinct_signature :: distinct.definition_facts().iter().find(fact -> fact.name == "pair").unwrap().signature_id
    json :: distinct.to_json()
    assert(json.contains("\"output_path\":[\"left\"],\"sources\":[{{\"source\":{{\"kind\":\"parameter\",\"index\":0}}"))
    assert(json.contains("\"output_path\":[\"right\"],\"sources\":[{{\"source\":{{\"kind\":\"parameter\",\"index\":1}}"))
    fs.write(path, source("left")).unwrap()
    changed :: open(path).expect("changed aggregate view provenance indexes")
    changed_signature :: changed.definition_facts().iter().find(fact -> fact.name == "pair").unwrap().signature_id
    assert_ne(distinct_signature, changed_signature)
}

// Rust: tests/semindex.rs:1036
#Test("semindex_structural_audit_reports_signature_change") {
    a :: "\nstruct Point {{\n    x: Int\n}}\n\nfn run() {{}}\n"
    b :: "\nstruct Point {{\n    x: Float\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("audit_change.jet", a)
    before :: open(path).expect("first fixture indexes")
    fs.write(path, b).expect("rewrite semindex fixture")
    after :: open(path).expect("changed fixture indexes")
    audit :: before.structural_audit(after)
    assert(audit.added.is_empty())
    assert(audit.removed.is_empty())
    assert(audit.changed.iter().any(id -> id.contains("Point")))
}

// Rust: tests/semindex.rs:1063
#Test("semindex_structural_audit_tracks_callable_signature_changes") {
    a :: "\nfn score(name: String) -> Int {{\n    return 1\n}}\n\nfn run() {{}}\n"
    b :: "\nfn score(name: String, bonus: Int) -> Float {{\n    return 1.0\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("audit_callable_change.jet", a)
    before :: open(path).expect("first fixture indexes")
    fs.write(path, b).expect("rewrite semindex fixture")
    after :: open(path).expect("changed fixture indexes")
    audit :: before.structural_audit(after)
    assert(!audit.added.iter().any(id -> id.starts_with("fn:") && id.ends_with("::score")), "added: {audit.added:?}")
    assert(!audit.removed.iter().any(id -> id.starts_with("fn:") && id.ends_with("::score")), "removed: {audit.removed:?}")
    assert(audit.changed.iter().any(id -> id.starts_with("fn:") && id.ends_with("::score")))
}

// Rust: tests/semindex.rs:1107
#Test("semindex_unified_loop_slots_and_state_scope_are_structural") {
    src :: "fn run() {{\n    loop item in [1, 2, 3], 2 {{\n        print(item)\n    }}\n    loop cursor in 0..<1 {{\n        print(cursor)\n    }}\n}}\n"
    path :: temp_fixture("unified_loop_slots.jet", src)
    index :: open(path).expect("unified loops index")
    slots :: index.structural_nodes().iter().map(node -> node.slot).collect<std.collections.BTreeSet<String>>()
    loop slot in ["source", "stride", "init", "condition", "afterthought", "body"] {
        assert(slots.contains(slot), "missing loop structural slot `{slot}`: {slots:?}")
    }
    inner_def :: index.definitions().iter().filter(def -> def.name == "cursor").max_by_key(def -> def.def_span.start).expect("inner state definition")
    loop reference in index.references_to("cursor") {
        assert_eq(reference.target.unwrap().def_span, inner_def.def_span)
    }
    out_of_scope :: check_document("state_scope.jet", "fn run() {{\n    loop cursor in 0..<1 {{}}\n    print(cursor)\n}}\n")
    assert(out_of_scope.iter().any(diagnostic -> diagnostic.code == "E0107" && diagnostic.what.contains("cursor")), "state binding must end with the loop: {out_of_scope:?}")
}

// Rust: tests/semindex.rs:1164
#Test("definition_ancestry_identity_ignores_signature_and_body_shape") {
    path :: temp_fixture("ancestry_identity.jet", "fn score(n: Int) -> Int {{ return n + 1 }}\nfn run() {{ print(score(1)) }}\n")
    before :: open(path).expect("first fixture indexes")
    fs.write(path, "fn score(n: Float, bonus: Float) -> Float {{ return n * bonus }}\nfn run() {{ print(score(1.0, 2.0)) }}\n").unwrap()
    after :: open(path).expect("changed fixture indexes")
    before_score :: before.definition_facts().iter().find(f -> f.name == "score").unwrap()
    after_score :: after.definition_facts().iter().find(f -> f.name == "score").unwrap()
    assert_eq(before_score.stable_id, after_score.stable_id)
    assert_ne(before_score.signature_id, after_score.signature_id)
    assert_ne(before_score.content_id, after_score.content_id)
}

