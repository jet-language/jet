// Rust: tests/semindex.rs:1242
#Test("semindex_effect_provenance_covers_open_and_trait_dispatch") {
    path :: temp_fixture("effect_provenance_origins.jet", "trait Shape {{ fn area(self) -[IO]> Int }}\nfn dynamic(shape: Shape) -> Int {{ return shape.area() }}\nfn apply(f: fn() -> Int) -> Int {{ return f() }}\nfn stored(f: ^fn() -> Int) -> Int {{\n    g :: f\n    return g()\n}}\nfn run() {{}}\n")
    index :: open(path).expect("effect provenance index")
    apply :: index.effect_of("apply").expect("open callback effects")
    assert(!apply.maximal)
    assert(apply.inferred.is_empty())
    assert(apply.provenance.is_empty())
    stored :: index.effect_of("stored").expect("stored callback effects")
    assert(stored.maximal)
    assert_eq(stored.provenance.len(), stored.inferred.len())
    assert(stored.provenance.iter().all(origin -> !origin.spans.is_empty()))
    dynamic :: index.effect_of("dynamic").expect("trait dispatch effects")
    io :: dynamic.provenance.iter().find(origin -> origin.effect == "IO").expect("IO provenance")
    assert_eq(io.call_path.len(), 2)
    assert_eq(io.spans.len(), 2)
}

// Rust: tests/semindex.rs:1273
#Test("semindex_via_contracts_have_provenance_without_invocation") {
    path :: temp_fixture("effect_via_provenance.jet", "fn bounded(act: fn() -[IO]>) -[via act]> {{}}\nfn open(act: fn()) -[via act]> {{}}\nfn run() {{}}\n")
    index :: open(path).expect("via provenance index")
    bounded :: index.effect_of("bounded").expect("bounded via effects")
    assert_eq(bounded.inferred, ["IO"])
    assert_eq(bounded.provenance.len(), 1)
    assert_eq(bounded.provenance[0].spans.len(), 1)
    unbounded :: index.effect_of("open").expect("unbounded via effects")
    assert(unbounded.maximal)
    assert_eq(unbounded.provenance.len(), unbounded.inferred.len())
    assert(unbounded.provenance.iter().all(origin -> !origin.spans.is_empty()))
}

