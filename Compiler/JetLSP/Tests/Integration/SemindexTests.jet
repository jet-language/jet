// Rust: tests/semindex.rs:612
#Test("semantic_symbols_carry_shared_docs_and_provenance") {
    src :: "\n/// Scores one name.\n/// Example: score(\"Ada\")\nfn score(name: String) -> Int {{\n    return 1\n}}\n\nfn run() {{\n    local_total :: score(\"Ada\")\n    print(local_total)\n}}\n"
    path :: temp_fixture("semantic_docs.jet", src)
    symbols :: open_symbols(path).expect("semantic symbols")
    // #1801: module identity is the sanitized stem, never the on-disk path.
    score :: symbols.lookup_identity("fn:module:semantic_docs::score").expect("score identity")
    assert_eq(score.signature, "fn score(name: String) -> Int\nfailure: Int (implicit default Err!)")
    assert_eq(score.summary, "Scores one name.")
    assert_eq(score.examples, ["score(\"Ada\")"])
    assert(match score.provenance { SemanticProvenance.Source { module_path: _ } -> true; else -> false })
    local :: symbols.lookup("local_total")
    assert_eq(local.len(), 1)
    assert_eq(local[0].kind, SemanticSymbolKind.Local)
}

// Rust: tests/semindex.rs:649
#Test("tracked_float_symbol_exposes_its_binding_site") {
    src :: "fn run() {{\n    #Track speed :: 3.5\n    origin :: prep {{ speed.$origin }}\n    print(origin?.source ?? \"missing\")\n}}\n"
    path :: temp_fixture("tracked_float_binding.jet", src)
    symbols :: open_symbols(path).expect("tracked-value semantic symbols")
    speed :: symbols.lookup("speed").into_iter().find(symbol -> symbol.kind == SemanticSymbolKind.Local).expect("tracked local")
    span :: speed.span.expect("tracked binding span")
    binding_start :: src.find("speed ::").expect("binding name")
    assert_eq(speed.signature, "speed: Float")
    assert_eq(span.start, binding_start)
    binding_text := src[span.start..span.end] // #4303
    assert_eq(binding_text, "speed")
    origin :: symbols.lookup("origin").into_iter().find(symbol -> symbol.kind == SemanticSymbolKind.Local).expect("origin fact binding")
    assert_eq(origin.signature, "origin: OriginInfo?")
    index :: open(path).expect("tracked-value semindex")
    origin_read :: index.references_to("origin").into_iter().find_map(reference -> reference.fact).expect("typed origin semindex reference")
    assert_eq(origin_read.name, "origin")
    assert_eq(origin_read.kind, "Origin")
    assert_eq(origin_read.type_name, "OriginInfo?")
    assert(index.to_json().contains("\"fact\":{{\"name\":\"origin\",\"kind\":\"Origin\",\"type\":\"OriginInfo?\"}}"))
    fact_symbol :: symbols.lookup("origin").into_iter().find(symbol -> symbol.signature == "@origin: OriginInfo?").expect("typed origin semantic symbol")
    assert_eq(fact_symbol.kind, SemanticSymbolKind.Member)
}

// Rust: tests/semindex.rs:693
#Test("semantic_symbols_keep_module_and_member_collisions_distinct") {
    src :: "\nmodule first {{\n    struct Item {{\n        value: Int\n    }}\n}}\n\nmodule second {{\n    struct Item {{\n        value: String\n    }}\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("semantic_collisions.jet", src)
    symbols :: open_symbols(path).expect("semantic symbols")
    items :: symbols.lookup("Item")
    assert_eq(items.len(), 2, "same spelling must retain module identity")
    assert_ne(items[0].identity, items[1].identity)
    values :: symbols.lookup_member("Item", "value")
    assert_eq(values.len(), 2, "same member spelling must retain owner identity")
    assert_ne(values[0].identity, values[1].identity)
}

