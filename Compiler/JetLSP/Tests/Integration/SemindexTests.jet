// Rust: tests/semindex.rs:369
#Test("semindex_projects_arithmetic_policy_and_exact_scope") {
    path :: temp_fixture("arithmetic_policy.jet", "fn run() {{\n    #Arithmetic(.Wrapping) {{\n        value :: U8{{250}} + U8{{10}}\n    }}\n}}\n")
    index :: open(path).expect("arithmetic policy indexes")
    operation :: index.arithmetic().first().expect("arithmetic operation fact")
    assert_eq(operation.operation, "add")
    assert_eq(operation.policy, "Wrapping")
    assert(operation.scope_span.start < operation.operation_span.start)
    json :: index.to_json()
    assert(json.contains("\"arithmetic\":[{{"))
    assert(json.contains("\"policy\":\"Wrapping\""))
    (diagnostics, bundle, facts) :: check_file_with_effect_facts(path.to_str().unwrap(), none, false)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    db :: build_symbol_db(bundle.expect("checked bundle"), facts)
    hover :: db.hover_at(path.to_str().unwrap(), operation.operation_span.start).expect("arithmetic hover")
    assert(hover.contains("fixed-width add: .Wrapping"), "{hover}")
    assert(hover.contains("scope = "), "{hover}")
}

// Rust: tests/semindex.rs:403
#Test("semindex_projects_terminal_and_reachability_graph") {
    path :: temp_fixture("terminal_state_graph.jet", "\nstruct Door {{\n    state {{ Closed, Open, Orphan }}\n}}\nimpl Door {{\n    #Transition(_, Closed) fn close() -> Door {{ Door{{}} }}\n    #Transition(Closed, Open) fn open(self: ^Door) -> Door {{ self }}\n    #Transition(Closed, Closed) fn hold(self: ^Door) -> Door {{ self }}\n}}\nfn run() {{}}\n")
    index :: open(path).expect("state graph indexes")
    graph :: index.state_graphs().iter().find(graph -> graph.owner == "Door").expect("Door graph")
    closed :: graph.states.iter().find(state -> state.name == "Closed").unwrap()
    open_state :: graph.states.iter().find(state -> state.name == "Open").unwrap()
    orphan :: graph.states.iter().find(state -> state.name == "Orphan").unwrap()
    assert(!closed.terminal)
    assert(open_state.terminal)
    assert_eq(closed.reachable, true)
    assert_eq(open_state.reachable, true)
    assert_eq(orphan.reachable, false)
    assert(index.to_json().contains("\"state_graphs\":[{{"))
    dossier :: index.dossier("Door")
    assert_eq(dossier.state_graphs.len(), 1)
    assert(dossier.render_text().contains("Open (terminal; reachable)"))
    assert(dossier.to_json().contains("\"terminal\":true"))
}

// Rust: tests/semindex.rs:453
#Test("semindex_hover_projects_terminal_and_reachability_facts") {
    path :: temp_fixture("terminal_state_hover.jet", "struct Door {{\n    state {{ Closed, Open, Orphan }}\n}}\nimpl Door {{\n    #Transition(_, Closed) fn new() -[]> Door {{ return Door{{}} }}\n    #Transition(Closed, Open) fn open(self: ^Door) -[]> Door {{ return self }}\n}}\nfn run() {{}}\n")
    (diagnostics, bundle, facts) :: check_file_with_effect_facts(path.to_str().unwrap(), none, false)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    checked :: bundle.expect("checked bundle")
    db :: build_symbol_db(checked, facts)
    closed :: db.hover.iter().find(hover -> hover.text.contains("Door.State.Closed")).expect("Closed hover")
    assert(closed.text.contains("nonterminal; reachable"), "{closed:?}")
    orphan :: db.hover.iter().find(hover -> hover.text.contains("Door.State.Orphan")).expect("Orphan hover")
    assert(orphan.text.contains("terminal; unreachable"), "{orphan:?}")
}

// Rust: tests/semindex.rs:486
#Test("semindex_state_symbols_keep_their_struct_owner") {
    path :: temp_fixture("state_owner_symbols.jet", "\nstruct Door {{\n    state {{ Closed, Open }}\n}}\nimpl Door {{\n    #Transition(_, Door.State.Closed) fn new() -[]> Door {{ return Door{{}} }}\n    #Transition(Door.State.Closed, Door.State.Open) fn open(self: ^Door) -[]> Door {{ return self }}\n}}\nfn run() {{}}\n")
    index :: open(path).expect("state symbols index")
    closed :: index.definitions().iter().find(definition -> definition.qualified_name.ends_with("Door.State.Closed")).expect("owning struct state definition")
    assert(match closed.kind { SymbolKind.EnumVariant { parent } -> parent == "Door.State"; else -> false })
    closed_span :: closed.def_span
    closed_qualified_name :: closed.qualified_name
    marker_reference :: index.references_to("Closed").into_iter().find(reference -> reference.target.is_some_and(target -> target.def_span == closed_span)).expect("qualified marker reference resolves to the state section")
    assert_eq(marker_reference.target.unwrap().def_span, closed_span)
    source :: fs.read_to_string(path).expect("read state symbols fixture")
    marker_text := source[marker_reference.span.start..marker_reference.span.end] // #4303
    assert_eq(marker_text, "Closed")
    assert(index.to_json().contains("\"name\":\"{closed_qualified_name}\""))
}

// Rust: tests/semindex.rs:537
#Test("semindex_reconstructs_checked_output_callable") {
    path :: fixture("tooling/output_callable.jet")
    index :: open(path).expect("Output example indexes")
    output :: index.outputs().first().expect("resolved Output fact")
    assert_eq(output.binding, "app")
    assert_eq(output.kind, "Executable")
    assert_eq(output.name, "checked-output")
    assert_eq(output.entry.name, "launch")
    assert(output.entry.identity.ends_with("::launch"))
    assert_eq(output.entry.failure_contract, "!Err")
    assert_eq(output.entry.failure_source, "implicit default !Err")
    assert_eq(output.entry.authority, "safe-jet")
    assert_ne(output.entry.definition_span, output.entry.reference_span)
    json :: index.to_json()
    loop field in ["\"outputs\":[{{", "\"entry\":{{\"identity\"", "\"failure_contract\":\"!Err\"", "\"failure_source\":\"implicit default !Err\"", "\"authority\":\"safe-jet\"", "\"effects\":[\"IO\"]"] {
        assert(json.contains(field), "semindex JSON missing {field}: {json}")
    }
}

// Rust: tests/semindex.rs:567
