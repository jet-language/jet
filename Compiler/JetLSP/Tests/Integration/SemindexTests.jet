// Rust: tests/semindex.rs:774
#Test("semantic_symbols_include_module_and_selected_imports") {
    root :: env.temp_dir().join("jet_semantic_imports_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("library.jet"), "pub fn score(name: String) -> Int {{ return 1 }}\n").unwrap()
    main :: root.join("main.jet")
    fs.write(main, "use \"./library\" as api\nuse api.[score as imported_score]\nfn run() {{ print(imported_score(\"Ada\")) }}\n").unwrap()
    symbols :: open_symbols(main).expect("import symbols")
    assert_eq(symbols.lookup("api").len(), 1)
    imported :: symbols.lookup("imported_score")
    assert_eq(imported.len(), 1)
    assert(imported[0].identity.starts_with("import:"))
    assert(imported[0].signature.contains("score(name: String) Int"))
    _ :: fs.remove_dir_all(root).ok()
}

