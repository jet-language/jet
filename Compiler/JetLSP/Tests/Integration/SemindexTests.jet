// Rust: tests/semindex.rs:1201
#Test("semindex_projects_omitted_inferred_effects") {
    path :: temp_fixture("inferred_effect_signature.jet", "fn announce() {{ print(\"hello\") }}\nfn run() {{ announce() }}\n")
    index :: open(path).expect("inferred effects index")
    announce :: index.effect_of("announce").expect("announce effects")
    assert_eq(announce.inferred, ["IO"])
    assert(announce.callees.is_empty(), "direct effect has no call edge")
    assert_eq(announce.provenance.len(), 1)
    assert_eq(announce.provenance[0].effect, "IO")
    assert_eq(announce.provenance[0].call_path, ["announce"])
    assert_eq(announce.provenance[0].spans.len(), 1)
    run :: index.effect_of("run").expect("run effects")
    assert_eq(run.provenance[0].call_path, ["run", "inferred_effect_signature::announce"])
    assert_eq(run.provenance[0].spans.len(), 2)
}

