// Rust: tests/semindex.rs:52
#Test("semantic_visibility_prefers_live_and_local_bindings") {
    index :: SemanticSymbolIndex.new([
        fact("builtin:keyword:answer", "answer", "answer", SemanticSymbolKind.Keyword, SemanticProvenance.Builtin { module: "syntax" }),
        fact("import:test::api.answer::answer", "answer", "answer", SemanticSymbolKind.Function, SemanticProvenance.Session),
        fact("fn:session::answer", "answer", "answer", SemanticSymbolKind.Function, SemanticProvenance.Session),
        fact("session:binding:answer", "answer", "answer", SemanticSymbolKind.Local, SemanticProvenance.Session)
    ])
    assert_eq(index.resolve_visible("answer").expect("visible answer").identity, "session:binding:answer")
    completions :: index.complete_visible("ans", none)
    assert_eq(completions.len(), 1)
    assert_eq(completions[0].identity, "session:binding:answer")
}

// Rust: tests/semindex.rs:98
#Test("contextual_result_names_are_not_advertised_as_keywords") {
    path :: temp_fixture("contextual_result_names.jet", "fn run() {{}}\n")
    symbols :: open_symbols(path).expect("semantic symbols")
    loop name in ["Ok", "Err"] {
        assert(symbols.symbols().iter().all(symbol -> symbol.identity != "builtin:keyword:{name}" && !(symbol.name == name && symbol.kind == SemanticSymbolKind.Keyword)), "{name} must stay a contextual identifier, not a keyword")
    }
}

// Rust: tests/semindex.rs:113
#Test("numeric_destination_conversions_and_parse_are_cataloged") {
    symbols :: SemanticSymbolIndex.language()
    assert(symbols.lookup_qualified("Int.parse").is_some())
    assert(symbols.lookup_qualified("Float.parse").is_some())
    narrow :: symbols.lookup_qualified("F32.from_float").expect("F32 narrowing catalog entry")
    assert(narrow.signature.ends_with("-> F32 !String"), "{narrow.signature}")
    assert(symbols.lookup_qualified("U8.from_u64").is_some())
    assert(symbols.lookup_qualified("Float.from_i8").is_some())
    assert(symbols.lookup_qualified("I64.from_f32").is_some())
    assert(symbols.lookup_qualified("F64.from_u32").is_some())
}

// Rust: tests/semindex.rs:132
#Test("source_distinct_and_unit_conversion_members_are_cataloged") {
    src :: "\n#Numeric UserID :: distinct Int\n#UnitFamily(Currency) {{ usd }}\n\nfn run() {{}}\n"
    path :: temp_fixture("source_numeric_members.jet", src)
    symbols :: open_symbols(path).expect("source semantic symbols")
    user :: symbols.lookup_qualified("UserID.from_u8").expect("source distinct conversion member")
    assert_eq(user.owner, "UserID")
    assert_eq(user.signature, "UserID.from_u8(value: U8) -> UserID")
    unit :: symbols.lookup_qualified("Usd.from_int").expect("unit-family conversion member")
    assert_eq(unit.owner, "Usd")
    user_offset :: src.find("#Numeric UserID").unwrap()
    assert(symbols.complete_visible_at("from_u", "UserID", SemanticVisibilityAnchor { module_path: path.to_string_lossy(), offset: user_offset, session_top_level: false }).iter().any(symbol -> symbol.qualified_name == "UserID.from_u8"))
}

// Rust: tests/semindex.rs:169
#Test("checked_text_contract_is_one_tooling_fact") {
    src :: "\n#Error\nenum PatternError {{ Bad }}\n\nPattern :: distinct String\n\nimpl Pattern.CheckedText {{\n    type Error = PatternError\n\n    fn check(text: String) -[]> PatternError! {{\n        return\n    }}\n\n    fn encode_hole<T: Printable>(value: T) -[]> String {{\n        return \"\"\n    }}\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("checked_text_contract.jet", src)
    index :: open(path).expect("checked text semantic index")
    definition :: index.definitions().iter().find(definition -> definition.name == "Pattern").expect("Pattern definition")
    assert_eq(definition.nominal_base, "String")
    contract :: definition.trait_contracts.iter().find(contract -> contract.trait_name == "CheckedText").expect("CheckedText contract")
    assert_eq(contract.associated_types, [("Error", "PatternError")])
    assert(contract.methods.iter().any(method -> method.contains("check")))
    assert(contract.methods.iter().any(method -> method.contains("encode_hole")))
    symbols :: open_symbols(path).expect("checked text semantic symbols")
    symbol :: symbols.lookup_qualified("Pattern").expect("Pattern semantic symbol")
    assert(symbol.signature.contains("type Pattern :: distinct String"))
    assert(symbol.signature.contains("implements CheckedText"))
    assert(symbol.signature.contains("type Error = PatternError"))
    assert(symbol.signature.contains("encode_hole"))
    json :: index.to_json()
    assert(json.contains("\"nominal_base\":\"String\""))
    assert(json.contains("\"trait\":\"CheckedText\""))
    assert(json.contains("\"associated_types\":[{{\"name\":\"Error\""))
    assert(index.dossier("Pattern").render_text().contains("trait contracts"))
}

// Rust: tests/semindex.rs:230
#Test("affine_unit_point_and_delta_members_are_cataloged") {
    src :: "\n#UnitFamily(Temperature, base: kelvin) {{\n    kelvin\n    celsius(scale: 1, offset: 27315/100)\n}}\n\nfn run() {{}}\n"
    path :: temp_fixture("source_affine_unit_members.jet", src)
