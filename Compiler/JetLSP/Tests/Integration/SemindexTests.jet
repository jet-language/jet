// Rust: tests/semindex.rs:1476
#Test("semindex_dossier_bypass_facts") {
    // D-LINTPOLICY1=A: every spelled bypass surfaces in the program-wide dossier.
    src :: "\nstruct Invoice {{\n    #allow(float_money)\n    price: Float,\n}}\n\n#Unsafe(\"caller must ensure the pointer is valid\") fn risky_fn() {{\n    print(\"danger\")\n}}\n\nfn run() {{\n    #Unsafe(\"index checked against len\") {{\n        print(\"audited\")\n    }}\n    #Unsafe(\"risky_fn's contract is upheld here\") {{\n        risky_fn()\n    }}\n    fetch_it().drop(\"telemetry only\")\n}}\n\nfn fetch_it() -> Int {{\n    return 1\n}}\n"
    path :: temp_fixture("dossier_bypass_facts.jet", src)
    idx :: open(path).expect("bypass-fact fixture indexes")
    dossier :: idx.dossier("run")
    kinds :: dossier.bypass_facts.iter().map(b -> b.kind).collect<[String]>()
    assert(kinds.contains("lint_allow"), "expected a lint_allow bypass fact, got: {kinds:?}")
    assert(kinds.contains("unsafe_region"), "expected an unsafe_region bypass fact, got: {kinds:?}")
    assert(kinds.contains("unsafe_fn"), "expected an unsafe_fn bypass fact, got: {kinds:?}")
    assert(kinds.contains("explicit_drop"), "expected an explicit_drop bypass fact, got: {kinds:?}")
    allow :: dossier.bypass_facts.iter().find(b -> b.kind == "lint_allow").expect("lint_allow fact present")
    assert_eq(allow.site, "price")
    assert_eq(allow.detail, "float_money")
    dropped :: dossier.bypass_facts.iter().find(b -> b.kind == "explicit_drop").expect("explicit_drop fact present")
    assert_eq(dropped.detail, "telemetry only")
    json :: dossier.to_json()
    assert(json.contains("\"bypass_facts\""))
    assert(json.contains("\"lint_allow\""))
    text :: dossier.render_text()
    assert(text.contains("bypass facts"))
    assert(text.contains("float_money"))
}

// Rust: tests/semindex.rs:1555
#Test("jet_semindex_cli_json_smoke") {
    bin :: OSPath.from(env.binary_path("jet"))
    path :: fixture("basics/hello.jet")
    out :: Command.new(bin).args(["inspect", "semindex", path.to_str().unwrap(), "--json"]).output().expect("jet inspect semindex")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    text :: String.from_utf8_lossy(out.stdout)
    assert_eq(read_machine_output(text).unwrap(), [MachineRecord.Status])
    assert(text.starts_with("{{\"schema\":\"jet.status/v1\""))
    assert_eq(text.matches("\"schema\":\"jet.status/v1\"").count(), 1, "semindex must emit one status envelope, not nest a second one: {text}")
    assert(text.contains("\"schema_version\":{SCHEMA_VERSION}"))
}

// Rust: tests/semindex.rs:1583
#Test("shape6_inspect_routes_and_bare_snapshots") {
    bin :: OSPath.from(env.binary_path("jet"))
    help_output :: Command.new(bin).arg("help").output().unwrap()
    assert(help_output.status.success())
    help :: String.from_utf8(^help_output.stdout).unwrap()
    loop group_name in ["inspect", "registry"] {
        group :: CLI.command_group(group_name).unwrap()
        group_label :: CLI.command_group_label(group_name)
        expected_usage :: group.actions.iter().flat_map(action -> action.usage.lines().map(usage -> "  jet {group.name} {usage:<48} {action.summary}\n")).collect<String>()
        assert(help.contains("{group_label} Commands:\n{expected_usage}"), "jet help did not render exact {group_name} usage")
        group_help :: Command.new(bin).args([group_name, "help"]).output().unwrap()
        assert(group_help.status.success())
        assert_eq(String.from_utf8(^group_help.stdout).unwrap(), "jet {group_name} — {group.summary}\n{expected_usage}")
        loop action in group.actions {
            loop usage in action.usage.lines() {
                command :: "jet {group.name} {usage}"
                assert(help.contains(command), "jet help omitted {command}")
            }
        }
    }
    loop verb in ["build", "run", "test", "fmt", "search"] {
        assert(CLI.is_canonical_top_level(verb), "jet {verb} must stay flat")
        assert(CLI.moved_command(verb).is_none(), "jet {verb} must not redirect")
    }
    loop (verb, handler_text) in [
        ("schema", "`jet inspect schema` needs a verb"),
        ("expand", "`jet inspect expand` needs an entry file"),
        ("live", "jet inspect live needs a process id"),
        ("semindex", "`jet inspect semindex` needs an entry file")
    ] {
        grouped :: Command.new(bin).args(["inspect", verb]).output().unwrap()
        assert(!grouped.status.success(), "jet inspect {verb} needs test input")
        stderr :: String.from_utf8(^grouped.stderr).unwrap()
        assert(stderr.contains(handler_text), "jet inspect {verb}: {stderr}")
        bare :: Command.new(bin).args([verb, "sentinel"]).output().unwrap()
        assert_eq(bare.status.code(), 2, "bare jet {verb}")
        assert_eq(String.from_utf8(^bare.stderr).unwrap(), "Error [E2101]: `{verb}` moved under `jet inspect`.\n Why: infrequent commands live in a named area so daily Jet commands stay easy to scan.\n Fix: run `jet inspect {verb} sentinel`.\n")
    }
}
