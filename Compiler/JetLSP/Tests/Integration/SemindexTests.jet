}

// Rust: tests/semindex.rs:252
#Test("semantic_visibility_orders_items_imports_and_builtins") {
    builtin :: fact("builtin:keyword:answer", "answer", "answer", SemanticSymbolKind.Keyword, SemanticProvenance.Builtin { module: "syntax" })
    import :: fact("import:test::api.answer::answer", "answer", "answer", SemanticSymbolKind.Function, SemanticProvenance.Session)
    item :: fact("fn:session::answer", "answer", "answer", SemanticSymbolKind.Function, SemanticProvenance.Session)
    assert_eq(SemanticSymbolIndex.new([builtin.clone(), import.clone()]).resolve_visible("answer").unwrap().identity, import.identity)
    assert_eq(SemanticSymbolIndex.new([^builtin, ^import, item.clone()]).resolve_visible("answer").unwrap().identity, item.identity)
}

// Rust: tests/semindex.rs:293
#Test("semantic_visibility_uses_current_module_context") {
    current := fact("fn:current::answer", "answer", "answer", SemanticSymbolKind.Function, SemanticProvenance.Source { module_path: "current.jet" })
    current.module_path = "current.jet"
    foreign_local := fact("local:other::answer", "answer", "answer", SemanticSymbolKind.Local, SemanticProvenance.Source { module_path: "other.jet" })
    foreign_local.module_path = "other.jet"
    index :: SemanticSymbolIndex.new([current.clone(), ^foreign_local])
    assert_eq(index.resolve_visible_in("answer", "current.jet").unwrap().identity, current.identity)
    assert_eq(index.complete_visible_in("ans", none, "current.jet").len(), 1)
}

// Rust: tests/semindex.rs:331
#Test("semantic_visibility_retains_explicit_qualified_alternatives") {
    index :: SemanticSymbolIndex.new([
        fact("method:List.answer", "answer", "List.answer", SemanticSymbolKind.Member, SemanticProvenance.Builtin { module: "core" }),
        fact("method:Map.answer", "answer", "Map.answer", SemanticSymbolKind.Member, SemanticProvenance.Builtin { module: "core" })
    ])
    assert_eq(index.resolve_visible("List.answer").unwrap().identity, "method:List.answer")
    qualified :: index.complete_visible("", "List")
    assert_eq(qualified.len(), 1)
    assert_eq(qualified[0].identity, "method:List.answer")
    assert(index.lookup_identity("method:Map.answer").is_some())
}

