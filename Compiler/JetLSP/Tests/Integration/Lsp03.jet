//RS // ── c44: drift-guard tests ────────────────────────────────────────────────────
//RS //
//RS // These tests encode the structural invariants introduced in c44.
//RS // They exist so any future attempt to re-fork the keyword/type/builtin tables
//RS // into parallel hardcoded lists fails loudly rather than silently.
//RS 
//RS /// The LSP keyword table must be identical to Syntax::JET_KEYWORD_LIST.
//RS ///
//RS /// Since Completion::JET_KEYWORDS is now a direct alias (`= Syntax::JET_KEYWORD_LIST`),
//RS /// this test is a pointer-equality sanity check. It also encodes that key words
//RS /// we care about are present, and that paused/live teaching words are absent.
//RS #[test]
//RS fn c44_lsp_keywords_derive_from_syntax() {
//RS     use jet::Syntax;
//RS     // JET_KEYWORDS is an alias of JET_KEYWORD_LIST — compare ptr addresses.
//RS     // If they ever become separate slices again, this detects it at pointer level.
//RS     let kw_ptr = Syntax::JET_KEYWORD_LIST.as_ptr();
//RS     // We can't import Completion directly (it's pub(crate)), so we verify via
//RS     // the public check_document / completion path: ensure Syntax constants appear
//RS     // in what completions return. Instead, verify the key structural invariants:
//RS     // 1. Real keywords are present.
//RS     let required = [
//RS         Syntax::KW_FN,
//RS         Syntax::KW_PUB,
//RS         Syntax::KW_USE,
//RS         Syntax::KW_IF,
//RS         Syntax::KW_ELSE,
//RS         Syntax::KW_LOOP,
//RS         Syntax::KW_RETURN,
//RS         Syntax::KW_STRUCT,
//RS         Syntax::KW_ENUM,
//RS         Syntax::KW_IMPL,
//RS         Syntax::KW_UNSAFE,
//RS         Syntax::KW_TEST,
//RS         Syntax::KW_TODO,
//RS         Syntax::LIT_TRUE,
//RS         Syntax::LIT_FALSE,
//RS         Syntax::LIT_NULL,
//RS         Syntax::KW_DISTINCT,
//RS         Syntax::KW_MODULE,
//RS     ];
//RS     for kw in &required {
//RS         assert!(
//RS             Syntax::JET_KEYWORD_LIST.contains(kw),
//RS             "JET_KEYWORD_LIST missing required keyword: {:?}",
//RS             kw
//RS         );
//RS     }
//RS     // 2. Paused/live teaching words must NOT be in the keyword list.
//RS     let banned = [
//RS         Syntax::FOREIGN_SWITCH,
//RS         Syntax::FOREIGN_IMPORT,
//RS         Syntax::FOREIGN_OR_FALLBACK,
//RS         Syntax::FOREIGN_WHILE,
//RS         Syntax::FOREIGN_FOR,
//RS         Syntax::FOREIGN_MATCH,
//RS         Syntax::FOREIGN_CLASS,
//RS     ];
//RS     for word in &banned {
//RS         assert!(
//RS             !Syntax::JET_KEYWORD_LIST.contains(word),
//RS             "JET_KEYWORD_LIST contains banned FOREIGN_ word: {:?}",
//RS             word
//RS         );
//RS     }
