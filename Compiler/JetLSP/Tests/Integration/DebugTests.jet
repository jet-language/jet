// GATE #4494: actual filesystem/CLI/pipe/thread/channel/lldb providers.
// Rust: tests/debug.rs:111
#Test("structured_session_status_ignores_program_output") {
    file :: fixture("structured_status", "fn run() {{\n    print(\"program finished\")\n}}\n")
    result :: DebugEngine.run_session_result(file.path, ["c"])
    assert_eq(result.status, DebugEngine.SessionStatus.Finished)
    assert_eq(result.transcript.lines().filter((line) -> line == "program finished").count(), 2, "transcript must retain program output and the debugger completion marker")
}

// Rust: tests/debug.rs:131
#Test("paused_session_stops_at_a_live_command_boundary") {
    file :: fixture("paused_status", LOOPS)
    result :: DebugEngine.run_session_result_paused(file.path, ["s"])
    assert_eq(result.status, DebugEngine.SessionStatus.Running)
    assert(result.transcript.contains("<- here"), "missing live stop: {result.transcript}")
    assert(!result.transcript.contains("program finished"), "a paused session must not fabricate completion: {result.transcript}")
    finished :: DebugEngine.run_session_result_paused(file.path, ["c"])
    assert_eq(finished.status, DebugEngine.SessionStatus.Finished)
    assert(finished.transcript.contains("program finished"))
}

// Rust: tests/debug.rs:153
#Test("canvas_debug_session_replays_one_source_bound_session") {
    file :: fixture("canvas_live_protocol", LOOPS)
    path :: file.as_ref()
    source :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(source)
    source_id :: canvas_source_id(path)
    sessions :: Canvas.DebugSessions.default()
    first_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"commands\":[\"s\"]}}"
    first :: Canvas.debug_session_json_for_file_with_sessions(path, first_request, sessions).expect("Canvas should expose the first live stop")
    assert(first.contains("\"state\":\"running\""), "{first}")
    assert(first.contains("\"tier\":\"jet-dev-interpreter\""), "{first}")
    assert(first.contains("\"revision\":\"{revision}\""), "{first}")
    assert(first.contains("run()"), "Canvas must expose the Jet entry function, not its host wrapper: {first}")
    marker :: "\"id\":\"canvas-debug-"
    start :: first.find(marker).expect("live response session id") + 6
    end :: start + first.slice(start, first.bytes().len()).find('"').expect("live response session id terminator")
    session_id := first.slice(start, end) // #4303
    next_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"session_id\":\"{session_id}\",\"commands\":[\"s\"]}}"
    next :: Canvas.debug_session_json_for_file_with_sessions(path, next_request, sessions).expect("Canvas should replay the same live session")
    assert(next.contains("\"state\":\"running\""), "{next}")
    assert(next.contains("\"id\":\"{session_id}\""), "{next}")
    assert(next.contains("\"debug_overlay\":\"running\""), "{next}")
    invalid_continuation :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"session_id\":\"{session_id}\",\"commands\":[\"teleport\"]}}"
    invalid :: Canvas.debug_session_json_for_file_with_sessions(path, invalid_continuation, sessions).expect_err("Canvas must reject an unsupported continuation command")
    assert(invalid.contains("\"kind\":\"unsupported\""), "{invalid}")
    after_invalid :: Canvas.debug_session_json_for_file_with_sessions(path, next_request, sessions).expect("a rejected command must leave the live session usable")
    assert(after_invalid.contains("\"id\":\"{session_id}\""), "{after_invalid}")
    assert(after_invalid.contains("\"state\":\"running\""), "{after_invalid}")
    stop_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"session_id\":\"{session_id}\",\"stop\":true}}"
    stopped :: Canvas.debug_session_json_for_file_with_sessions(path, stop_request, sessions).expect("Canvas should stop the live session without editing source")
    assert(stopped.contains("\"state\":\"stopped\""), "{stopped}")
    assert(stopped.contains("\"overlay\":null"), "{stopped}")
    assert_eq(fs.read_to_string(path).unwrap(), source)
    invalid_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"commands\":[\"teleport\"]}}"
    invalid :: Canvas.debug_session_json_for_file_with_sessions(path, invalid_request, sessions).expect_err("Canvas must reject commands outside the debugger vocabulary")
    assert(invalid.contains("\"kind\":\"unsupported\""), "{invalid}")
    assert_eq(fs.read_to_string(path).unwrap(), source)
}

// Rust: tests/debug.rs:248
#Test("canvas_debug_stop_requires_matching_source_revision_and_tier") {
    file :: fixture("canvas_stop_binding", LOOPS)
    path :: file.as_ref()
    source :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(source)
    source_id :: canvas_source_id(path)
    sessions :: Canvas.DebugSessions.default()
    first_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"jet-dev-interpreter\",\"commands\":[\"s\"]}}"
    first :: Canvas.debug_session_json_for_file_with_sessions(path, first_request, sessions).expect("Canvas should start a stoppable session")
    marker :: "\"id\":\"canvas-debug-"
    start :: first.find(marker).expect("live response session id") + 6
    end :: start + first.slice(start, first.bytes().len()).find('"').expect("live response session id terminator")
    session_id := first.slice(start, end) // #4303
    wrong_tier :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"native-lldb\",\"session_id\":\"{session_id}\",\"stop\":true}}"
    error :: Canvas.debug_session_json_for_file_with_sessions(path, wrong_tier, sessions).expect_err("Canvas must not stop a session through another tier")
    assert(error.contains("\"kind\":\"conflict\""), "{error}")
    other_file :: fixture("canvas_stop_other_source", LOOPS)
    other_revision :: Canvas.source_revision(fs.read_to_string(other_file.as_ref()).unwrap())
    other_source_id :: canvas_source_id(other_file.as_ref())
    wrong_source :: "{{\"schema_version\":1,\"source_id\":\"{other_source_id}\",\"revision\":\"{other_revision}\",\"tier\":\"jet-dev-interpreter\",\"session_id\":\"{session_id}\",\"stop\":true}}"
    error :: Canvas.debug_session_json_for_file_with_sessions(other_file.as_ref(), wrong_source, sessions).expect_err("Canvas must not stop a session through another source")
    assert(error.contains("\"kind\":\"conflict\""), "{error}")
    next_request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"jet-dev-interpreter\",\"session_id\":\"{session_id}\",\"commands\":[\"s\"]}}"
    Canvas.debug_session_json_for_file_with_sessions(path, next_request, sessions).expect("a mismatched stop must leave the live session intact")
    stale_stop :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"sha256-stale\",\"tier\":\"jet-dev-interpreter\",\"session_id\":\"{session_id}\",\"stop\":true}}"
    error :: Canvas.debug_session_json_for_file_with_sessions(path, stale_stop, sessions).expect_err("Canvas must reject a stale stop request")
    assert(error.contains("\"kind\":\"conflict\""), "{error}")
    ended :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"jet-dev-interpreter\",\"session_id\":\"{session_id}\",\"stop\":true}}"
    stopped :: Canvas.debug_session_json_for_file_with_sessions(path, ended, sessions).expect("a stale stop request must leave the current session intact")
    assert(stopped.contains("\"state\":\"stopped\""), "{stopped}")
    assert_eq(fs.read_to_string(path).unwrap(), source)
}

// Rust: tests/debug.rs:322
#Test("canvas_debug_rejects_unbounded_breakpoint_spans_before_execution") {
    file :: fixture("canvas_breakpoint_limit", LOOPS)
    path :: file.as_ref()
    source :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(source)
    source_id :: canvas_source_id(path)
    anchors :: (0..<129).map((_) -> "\"0:1\"").collect().join(",")
    request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"breakpoint_spans\":[{anchors}],\"commands\":[\"s\"]}}"
    error :: Canvas.debug_session_json_for_file(path, request).expect_err("Canvas must bound breakpoint span input")
    assert(error.contains("\"kind\":\"limit\""), "{error}")
    assert_eq(fs.read_to_string(path).unwrap(), source)
}

// Rust: tests/debug.rs:340
#Test("canvas_debug_native_tier_never_falls_back_to_interpreter") {
    file :: fixture("canvas_native_protocol", LOOPS)
    path :: file.as_ref()
    source :: fs.read_to_string(path).unwrap()
    revision :: Canvas.source_revision(source)
    source_id :: canvas_source_id(path)
    sessions :: Canvas.DebugSessions.default()
    request :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"native-lldb\",\"commands\":[\"s\"]}}"
    if Canvas.debug_session_json_for_file_with_sessions(path, request, sessions) == {
        Ok(body) -> {
            assert(body.contains("\"tier\":\"native-lldb\""), "{body}")
            assert(!body.contains("\"tier\":\"jet-dev-interpreter\""), "{body}")
            assert(body.contains("\"state\":\"running\""), "{body}")
            marker :: "\"id\":\"canvas-debug-"
            start :: body.find(marker).expect("native session id") + 6
            end :: start + body.slice(start, body.bytes().len()).find('"').expect("native session id terminator")
            session_id := body.slice(start, end) // #4303
            stop :: "{{\"schema_version\":1,\"source_id\":\"{source_id}\",\"revision\":\"{revision}\",\"tier\":\"native-lldb\",\"session_id\":\"{session_id}\",\"stop\":true}}"
            stopped :: Canvas.debug_session_json_for_file_with_sessions(path, stop, sessions).expect("native session stop")
            assert(stopped.contains("\"state\":\"stopped\""), "{stopped}")
        }
        Err(error) -> {
            assert(error.contains("\"kind\":\"diagnostic\""), "{error}")
            assert(!error.contains("rustc rejected"), "{error}")
        }
    }
    assert_eq(fs.read_to_string(path).unwrap(), source)
}

