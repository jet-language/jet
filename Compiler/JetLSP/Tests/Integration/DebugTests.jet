#Test("dap_cli_keeps_running_state_transitions_on_the_production_wire") {
    if !have("rustc") || !have("lldb") -> return
    tag :: "dap_cli_running_state_{process.id()}_{SystemTime.now().duration_since(UNIX_EPOCH).expect("clock after epoch").as_nanos()}"
    file :: native_fixture(tag, "fn run() {{\n    total := 0\n    loop i in 1..1000000000 {{\n        total += i\n    }}\n}}\n")
    child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("start the production Jet DAP command")
    input := &child.stdin.take().expect("DAP stdin")
