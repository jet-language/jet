#Test("dap_cli_projects_raw_frames_only_when_requested_through_production_wire") {
    if !have("rustc") || !have("lldb") -> return
    tag :: "dap_cli_raw_frames_{process.id()}_{SystemTime.now().duration_since(UNIX_EPOCH).expect("clock after epoch").as_nanos()}"
    file :: native_fixture(tag, LOOPS)
