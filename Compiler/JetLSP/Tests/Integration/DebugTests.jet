        dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}}}"),
        dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{{\"program\":\"{file.path}\",\"stopOnEntry\":true,\"args\":[],\"env\":{{}}}}}}"),
        dap_frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{{}}}}"),
    ].join("")
    child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("start the production Jet DAP command")
    input_pipe := &child.stdin.take().expect("DAP stdin")
    write_dap_request(&input_pipe, setup)
    stdout_pipe := &child.stdout.take().expect("DAP stdout")
    (output_tx, output_rx) :: mpsc.channel<[U8]>()
    // Rust: tests/debug.rs:1445
    output_reader :: thread.spawn(() -> {
        chunk := [U8;4096]{0}
        loop {
            if &stdout_pipe.read(&chunk) == {
                Ok(0) | Err(_) -> break
                Ok(size) -> { if output_tx.send(chunk.slice(0, size).to_vec()).is_err() -> break }
            }
        }
    })
    deadline :: Instant.now() + Duration.from_secs(30)
    stdout := ""
    stopped := false
    loop if Instant.now() < deadline && !stopped {
        if output_rx.recv_timeout(Duration.from_millis(100)) == {
            Ok(chunk) -> { &stdout.push_str(String.from_utf8_lossy(chunk)); stopped = stdout.contains("\"event\":\"stopped\"") }
            Err(RecvTimeoutError.Timeout) -> {}
            Err(RecvTimeoutError.Disconnected) -> break
        }
    }
    assert(stopped, "production DAP did not stop at entry:\n{stdout}")
    if stopped -> write_dap_request(&input_pipe, dap_frame("{{\"seq\":4,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1,\"showRawFrames\":\"yes\"}}}}"))
    rejected :: read_dap_response(output_rx, &stdout, 4, "stackTrace")
    assert(rejected.contains("\"success\":false"), "{rejected}")
    assert(rejected.contains("\"id\":22032"), "{rejected}")
    assert(rejected.contains("\"code\":\"E2236\""), "{rejected}")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":5,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1}}}}"))
    safe :: read_dap_response(output_rx, &stdout, 5, "stackTrace")
    assert(safe.contains("\"success\":true"), "{safe}")
    assert(!safe.contains("__jet_"), "generated Rust leaked into Jet view: {safe}")
    assert(!safe.contains(rust_file), "generated Rust source leaked into Jet view: {safe}")
    safe_frame :: dap_u32_after(safe, "\"stackFrames\":[{{\"id\":")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":6,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{safe_frame}}}}}"))
    safe_scopes :: read_dap_response(output_rx, &stdout, 6, "scopes")
    assert(safe_scopes.contains("\"success\":true"), "{safe_scopes}")
    assert(safe_scopes.contains("\"name\":\"Locals\""), "{safe_scopes}")
    assert(!safe_scopes.contains("[raw]"), "raw scope leaked into Jet view: {safe_scopes}")
    safe_scope :: dap_u32_after(safe_scopes, "\"name\":\"Locals\",\"variablesReference\":")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":7,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":{safe_scope}}}}}"))
    safe_variables :: read_dap_response(output_rx, &stdout, 7, "variables")
    assert(safe_variables.contains("\"success\":true"), "{safe_variables}")
    assert(!safe_variables.contains("__jet_"), "generated Rust leaked into Jet locals: {safe_variables}")
    assert(!safe_variables.contains(rust_file), "generated Rust source leaked into Jet locals: {safe_variables}")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":8,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1,\"showRawFrames\":true}}}}"))
    raw :: read_dap_response(output_rx, &stdout, 8, "stackTrace")
    assert(raw.contains("\"success\":true"), "{raw}")
    assert(raw.contains("\"name\":\"[raw]"), "{raw}")
    assert(raw.contains("\"path\":\"{rust_file}\""), "raw stack must expose the generated frame source only in expert mode: {raw}")
    raw_frame :: dap_u32_before(raw, "\"name\":\"[raw]")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":9,\"type\":\"request\",\"command\":\"scopes\",\"arguments\":{{\"frameId\":{raw_frame}}}}}"))
    raw_scopes :: read_dap_response(output_rx, &stdout, 9, "scopes")
    assert(raw_scopes.contains("\"success\":true"), "{raw_scopes}")
    assert(raw_scopes.contains("\"name\":\"[raw] Locals\""), "{raw_scopes}")
    raw_scope :: dap_u32_after(raw_scopes, "\"name\":\"[raw] Locals\",\"variablesReference\":")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":10,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":{raw_scope}}}}}"))
    raw_variables :: read_dap_response(output_rx, &stdout, 10, "variables")
    assert(raw_variables.contains("\"success\":true"), "{raw_variables}")
    stopped_count :: stdout.matches("\"event\":\"stopped\"").count()
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":11,\"type\":\"request\",\"command\":\"next\",\"arguments\":{{\"threadId\":1}}}}"))
    next :: read_dap_response(output_rx, &stdout, 11, "next")
    assert(next.contains("\"success\":true"), "{next}")
    read_dap_until(output_rx, &stdout, (output) -> output.matches("\"event\":\"stopped\"").count() > stopped_count, "next stopped event")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":12,\"type\":\"request\",\"command\":\"variables\",\"arguments\":{{\"variablesReference\":{safe_scope}}}}}"))
    stale :: read_dap_response(output_rx, &stdout, 12, "variables")
    assert(stale.contains("\"success\":false"), "{stale}")
    assert(stale.contains("\"id\":22036"), "{stale}")
    assert(stale.contains("\"code\":\"E2238\""), "{stale}")
    write_dap_request(&input_pipe, dap_frame("{{\"seq\":13,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{{\"terminateDebuggee\":true}}}}"))
    disconnected :: read_dap_response(output_rx, &stdout, 13, "disconnect")
    assert(disconnected.contains("\"success\":true"), "{disconnected}")
    drop(^input_pipe)
    status :: &child.wait().expect("wait for the production Jet DAP command")
    output_reader.join().expect("join DAP output reader")
    loop { if output_rx.try_recv() == Ok(chunk) -> &stdout.push_str(String.from_utf8_lossy(chunk)); else -> break }
    _ :: fs.remove_file(file.as_ref())
    assert(status.success(), "DAP command failed:\nstdout:\n{stdout}")
}

// Rust: tests/debug.rs:1628
#Test("debug_build_carries_line_markers_a_normal_build_does_not") {
    file :: native_fixture("markers", LOOPS)
    debug_out :: compile_for_debug(file.path).expect("compiles for debug")
    assert(debug_out.rust.contains("// jet:line "), "debug_linemap build should carry `// jet:line N` markers:\n{debug_out.rust}")
    normal_out :: compile_with_path(fs.read_to_string(file.as_ref()).unwrap(), file.path).expect("compiles normally")
    assert(!normal_out.rust.contains("// jet:line "), "a normal build must stay byte-identical to today's output — no markers leak in when debug_linemap is off (JIT tier + golden tests depend on this)")
    if !have("rustc") || !have("lldb") -> return
    jet_src :: fs.read_to_string(file.as_ref()).unwrap()
    (debug_dir, debug_bin) :: native_binary("markers_debug", debug_out.rust)
    debug_transcript :: DebugEngine.run_native_scripted(debug_bin, "prog.rs", debug_out.rust, file.path, jet_src, false, ["next"])
    assert(debug_transcript.contains("2 |     n := 3") && debug_transcript.contains("3 |     total := 0"), "debug source map did not step through mapped statements:\n{debug_transcript}")
    (normal_dir, normal_bin) :: native_binary("markers_normal", normal_out.rust)
    normal_transcript :: DebugEngine.run_native_scripted(normal_bin, "prog.rs", normal_out.rust, file.path, jet_src, false, [])
    assert(normal_transcript.contains("source-mapped entry statement"), "normal build unexpectedly supplied a debugger source map:\n{normal_transcript}")
    _ :: fs.remove_dir_all(debug_dir.path)
    _ :: fs.remove_dir_all(normal_dir.path)
}

