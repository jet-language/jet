// Rust: tests/debug.rs:582
#Test("loop_next_edges_are_step_visible_and_line_mapped") {
    src :: "fn run() {{\n    hits := 0\n    loop i in 0..<3 {{\n        if i == 1 {{\n            next\n        }}\n        hits += i\n    }}\n    outer_hits := 0\n    inner_hits := 0\n    outer :: loop i in 0..<3 {{\n        loop j in 0..<3 {{\n            if j == 1 {{\n                next(outer)\n            }}\n            inner_hits += 1\n        }}\n        outer_hits += 1\n    }}\n    print(\"{{hits}},{{inner_hits}},{{outer_hits}}\")\n}}\n"
    file :: fixture("loop_next_edges", src)
    plain :: DebugEngine.run_session(file.path, ["break 5", "c", "n", "p i", "n", "p i", "c"])
    next_stop :: plain.find("5 |             next        <- here").expect("plain next stop")
    step_stop :: next_stop + plain.slice(next_stop, plain.bytes().len()).find("3 |     loop i in 0..<3 {{        <- here").expect("plain next must stop on the loop afterthought")
    assert(!plain.slice(next_stop, step_stop).contains("7 |         hits += i        <- here"), "plain next leaked into the skipped body before its afterthought:\n{plain}")
    assert(plain.contains("i = 2"), "afterthought did not advance i:\n{plain}")
    assert(plain.contains("2,3,0"), "wrong loop result:\n{plain}")
    labeled :: DebugEngine.run_session(file.path, ["break 14", "c", "n", "p i", "n", "p i", "c"])
    next_stop :: labeled.find("14 |                 next(outer)        <- here").expect("labeled next stop")
    outer_step :: next_stop + labeled.slice(next_stop, labeled.bytes().len()).find("11 |     outer :: loop i in 0..<3 {{        <- here").expect("labeled next must target the outer afterthought")
    assert(!labeled.slice(next_stop, outer_step).contains("12 |         loop j in 0..<3 {{        <- here"), "labeled next stepped through the inner loop edge first:\n{labeled}")
    assert(labeled.contains("i = 1"), "outer afterthought did not advance i:\n{labeled}")
    assert(labeled.contains("2,3,0"), "wrong labeled loop result:\n{labeled}")
    generated :: compile_for_debug(file.path).expect("loop next fixture compiles for debug")
    loop line in [5, 14] {
        assert(generated.rust.contains("// jet:line {line}\n"), "missing line marker for loop next on Jet line {line}:\n{generated.rust}")
    }
}

// Rust: tests/debug.rs:892
#Test("dap_cli_exercises_the_production_wire_and_attach_failure") {
    tag :: "dap_cli_failure_{process.id()}"
    file :: native_fixture(tag, LOOPS)
    input :: [
        dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}}}"),
        dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"{file.path}\"}},\"breakpoints\":[{{\"line\":7}}]}}}}"),
        dap_frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{{\"processId\":0}}}}"),
    ].join("")
    child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start the production Jet DAP command")
    &child.stdin.take().expect("DAP stdin").write_all(input.bytes()).expect("send framed DAP requests")
    output :: &child.wait_with_output().expect("wait for the production Jet DAP command")
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(output.status.success(), "DAP command failed:\n{stderr}")
    initialize :: dap_response(stdout, 1, "initialize").expect("initialize response")
    assert(initialize.contains("\"success\":true"), "{initialize}")
    breakpoints :: dap_response(stdout, 2, "setBreakpoints").expect("breakpoint response")
    assert(breakpoints.contains("\"verified\":true"), "{breakpoints}")
    assert(breakpoints.contains("\"id\":1,\"verified\":true,\"line\":7"), "{breakpoints}")
    attach :: dap_response(stdout, 3, "attach").expect("attach response")
    assert(attach.contains("\"success\":false"), "{attach}")
    assert(attach.contains("\"id\":22032"), "{attach}")
    assert(attach.contains("\"code\":\"E2236\""), "{attach}")
    assert(!stdout.contains("\"event\":\"stopped\""), "invalid attach must not start a target: {stdout}")
    _ :: fs.remove_file(file.as_ref())
}

// Rust: tests/debug.rs:946
#Test("dap_cli_rejects_a_cross_executable_attach_through_the_production_wire") {
    if selected_os() != "linux" -> return // GATE #4483.
    if !have("rustc") -> return
    tag :: "dap_cli_attach_denied_{process.id()}_{SystemTime.now().duration_since(UNIX_EPOCH).expect("clock after epoch").as_nanos()}"
    file :: native_fixture(tag, "fn run() {{\n    loop {{}}\n}}\n")
    stem :: file.as_ref().file_stem().expect("attach fixture has a file stem").to_string_lossy()
    binary :: OSPath("build").join("{stem}_dbg")
    map :: binary.with_extension("jetmap")
    adapter := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start the production Jet DAP command")
    input := &adapter.stdin.take().expect("DAP stdin")
    &input.write_all(dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}}}").bytes()).expect("send initialize request")
    &input.flush().expect("flush initialize request")
    deadline :: Instant.now() + Duration.from_secs(30)
    loop if !(binary.is_file() && map.is_file()) {
        if (&adapter.try_wait()).expect("check production DAP process").is_some() -> panic("production DAP process exited before writing its debug map")
        assert(Instant.now() < deadline, "production DAP process did not publish its debug map")
        thread.sleep(Duration.from_millis(20))
    }
    target := Command.new("sleep").arg("30").spawn().expect("start mismatched native attach target")
    attach :: dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{{\"processId\":{target.id()},\"program\":\"{binary}\",\"map\":\"{map}\"}}}}")
    &input.write_all(attach.bytes()).expect("send attach request")
    &input.flush().expect("flush attach request")
    drop(^input)
    output :: &adapter.wait_with_output().expect("wait for the production Jet DAP command")
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    target_alive :: (&target.try_wait()).expect("check denied target").is_none()
    _ :: &target.kill()
    _ :: &target.wait()
    _ :: fs.remove_file(map)
    _ :: fs.remove_file(binary)
    _ :: fs.remove_file(OSPath("build").join("{stem}.rs"))
    _ :: fs.remove_file(file.as_ref())
    assert(output.status.success(), "DAP command failed:\n{stderr}")
    assert(stdout.contains("\"command\":\"attach\""), "{stdout}")
    assert(stdout.contains("\"request_seq\":2,\"success\":false,\"command\":\"attach\""), "{stdout}")
    assert(stdout.contains("\"id\":22037"), "{stdout}")
    assert(stdout.contains("\"code\":\"E2231\""), "{stdout}")
    assert(!stdout.contains("\"event\":\"stopped\""), "{stdout}")
    assert(target_alive, "denied attach must leave the target alive")
}

// Rust: tests/debug.rs:1041
#Test("dap_cli_attaches_and_disconnects_through_the_production_wire") {
    if selected_os() != "linux" -> return // GATE #4483.
    if !have("rustc") || !have("lldb") -> return
    tag :: "dap_cli_attach_success_{process.id()}_{SystemTime.now().duration_since(UNIX_EPOCH).expect("clock after epoch").as_nanos()}"
    file :: native_fixture(tag, "fn run() {{\n    loop {{}}\n}}\n")
    stem :: file.as_ref().file_stem().expect("attach fixture has a file stem").to_string_lossy()
    binary :: OSPath("build").join("{stem}_dbg")
    map :: binary.with_extension("jetmap")
    adapter := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start the production Jet DAP command")
    input := &adapter.stdin.take().expect("DAP stdin")
    &input.write_all(dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}}}").bytes()).expect("send initialize request")
    &input.flush().expect("flush initialize request")
    deadline :: Instant.now() + Duration.from_secs(30)
    loop if !(binary.is_file() && map.is_file()) {
        if (&adapter.try_wait()).expect("check production DAP process").is_some() -> panic("production DAP process exited before writing its debug map")
        assert(Instant.now() < deadline, "production DAP process did not publish its debug map")
        thread.sleep(Duration.from_millis(20))
    }
    target := spawn_attachable_native_target(binary, tag)
    wait_for_target_binary(target.id(), binary)
    attach :: dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"attach\",\"arguments\":{{\"processId\":{target.id()},\"program\":\"{binary}\",\"map\":\"{map}\"}}}}")
    &input.write_all(attach.bytes()).expect("send attach request")
    &input.flush().expect("flush attach request")
    attach_deadline :: Instant.now() + Duration.from_secs(30)
    target_stopped := false
    loop if Instant.now() < attach_deadline {
        if (&adapter.try_wait()).expect("check production DAP process during attach").is_some() -> break
        state :: linux_process_state(target.id())
        if state == Val("T") || state == Val("t") { target_stopped = true; break }
        thread.sleep(Duration.from_millis(20))
    }
    disconnect :: dap_frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{{}}}}")
    _ :: &input.write_all(disconnect.bytes())
    _ :: &input.flush()
    drop(^input)
    output :: &adapter.wait_with_output().expect("wait for the production Jet DAP command")
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    target_alive :: (&target.try_wait()).expect("check detached target").is_none()
    target_running := false
    if target_alive {
        deadline :: Instant.now() + Duration.from_secs(2)
        loop {
            state :: linux_process_state(target.id())
            if state == Val("T") || state == Val("t") {
                if Instant.now() < deadline -> thread.sleep(Duration.from_millis(20))
                else -> break
            } else if state.is_some() { target_running = true; break }
            else -> break
        }
    }
    if target_alive -> _ :: &target.kill()
    _ :: &target.wait()
    _ :: fs.remove_file(map)
    _ :: fs.remove_file(binary)
    _ :: fs.remove_file(OSPath("build").join("{stem}.rs"))
    _ :: fs.remove_file(file.as_ref())
    assert(output.status.success(), "DAP command failed:\n{stderr}")
    assert(stdout.contains("\"command\":\"attach\""), "{stdout}")
    assert(stdout.contains("\"request_seq\":2,\"success\":true,\"command\":\"attach\""), "{stdout}")
    assert(stdout.contains("\"command\":\"disconnect\""), "{stdout}")
    assert(stdout.contains("\"request_seq\":3,\"success\":true,\"command\":\"disconnect\""), "{stdout}")
    assert(!stdout.contains("\"success\":false"), "{stdout}")
    assert(target_alive, "production disconnect must leave an attached target alive")
    assert(target_running, "production disconnect must resume the attached target")
    assert(target_stopped, "production attach must stop the real target before disconnect")
}

// Rust: tests/debug.rs:1184
#Test("dap_cli_launches_and_projects_a_live_target_in_jet_terms") {
    if !have("rustc") || !have("lldb") -> return
    tag :: "dap_cli_success_{process.id()}"
    file :: native_fixture(tag, LOOPS)
    input :: [
        dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\",\"linesStartAt1\":true,\"columnsStartAt1\":true}}}}"),
        dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"{file.path}\"}},\"breakpoints\":[{{\"line\":7}}]}}}}"),
        dap_frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{{\"program\":\"{file.path}\",\"stopOnEntry\":true,\"args\":[],\"env\":{{}}}}}}"),
        dap_frame("{{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{{}}}}"),
        dap_frame("{{\"seq\":5,\"type\":\"request\",\"command\":\"threads\",\"arguments\":{{}}}}"),
        dap_frame("{{\"seq\":6,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1}}}}"),
        dap_frame("{{\"seq\":7,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{{\"threadId\":1}}}}"),
        dap_frame("{{\"seq\":8,\"type\":\"request\",\"command\":\"stackTrace\",\"arguments\":{{\"threadId\":1}}}}"),
        dap_frame("{{\"seq\":9,\"type\":\"request\",\"command\":\"continue\",\"arguments\":{{\"threadId\":1}}}}"),
    ].join("")
    child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start the production Jet DAP command")
    &child.stdin.take().expect("DAP stdin").write_all(input.bytes()).expect("send framed DAP requests")
    output :: &child.wait_with_output().expect("wait for the production Jet DAP command")
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(output.status.success(), "DAP command failed:\n{stderr}")
    breakpoints :: dap_response(stdout, 2, "setBreakpoints").expect("breakpoint response")
    assert(breakpoints.contains("\"verified\":true"), "{breakpoints}")
    assert(breakpoints.contains("\"id\":1,\"verified\":true,\"line\":7"), "{breakpoints}")
    assert(stdout.contains("\"request_seq\":1,\"success\":true,\"command\":\"initialize\""), "{stdout}")
    assert(stdout.contains("\"event\":\"stopped\""), "{stdout}")
    assert(stdout.contains("\"reason\":\"breakpoint\""), "{stdout}")
    assert(stdout.contains("\"hitBreakpointIds\":[1]"), "{stdout}")
    assert(stdout.contains("\"command\":\"threads\""), "{stdout}")
    assert(stdout.contains("\"command\":\"stackTrace\""), "{stdout}")
    assert(stdout.contains("\"name\":\"run\""), "{stdout}")
    assert(stdout.contains("\"line\":2"), "{stdout}")
    breakpoint_stack :: dap_response(stdout, 8, "stackTrace").expect("breakpoint stack trace")
    assert(breakpoint_stack.contains("\"line\":7"), "{breakpoint_stack}")
    assert(stdout.contains("\"path\":\"{file.path}\""), "{stdout}")
    assert(stdout.contains("\"event\":\"output\""), "{stdout}")
    assert(stdout.contains("total is "), "{stdout}")
    assert(!stdout.contains("__jet_"), "generated Rust leaked into Jet view: {stdout}")
    assert(stdout.contains("\"event\":\"exited\""), "{stdout}")
    assert(stdout.contains("\"event\":\"terminated\""), "{stdout}")
    _ :: fs.remove_file(file.as_ref())
}

// Rust: tests/debug.rs:1271
#Test("dap_cli_pauses_a_running_target_through_production_wire") {
    if !have("rustc") || !have("lldb") -> return
    tag :: "dap_cli_pause_{process.id()}_{SystemTime.now().duration_since(UNIX_EPOCH).expect("clock after epoch").as_nanos()}"
    file :: native_fixture(tag, "fn run() {{\n    total := 0\n    loop i in 1..1000000000 {{\n        total += i\n    }}\n    print(\"{{total}}\")\n}}\n")
    input :: [
        dap_frame("{{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\",\"arguments\":{{\"adapterID\":\"jet\",\"pathFormat\":\"path\"}}}}"),
        dap_frame("{{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{{\"program\":\"{file.path}\",\"stopOnEntry\":false,\"args\":[],\"env\":{{}}}}}}"),
        dap_frame("{{\"seq\":3,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{{}}}}"),
        dap_frame("{{\"seq\":4,\"type\":\"request\",\"command\":\"pause\",\"arguments\":{{}}}}"),
    ].join("")
    child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["debug", "--dap", file.path]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("start the production Jet DAP command")
    input_pipe := &child.stdin.take().expect("DAP stdin")
    &input_pipe.write_all(input.bytes()).expect("send initialize, launch, configuration, and pause")
    &input_pipe.flush().expect("flush DAP requests")
    stdout := &child.stdout.take().expect("DAP stdout")
    (output_tx, output_rx) :: mpsc.channel<[U8]>()
    // Rust: tests/debug.rs:1314
    output_reader :: thread.spawn(() -> {
        chunk := [U8;4096]{0}
        loop {
            if &stdout.read(&chunk) == {
                Ok(0) | Err(_) -> break
                Ok(size) -> { if output_tx.send(chunk.slice(0, size).to_vec()).is_err() -> break }
            }
        }
    })
    deadline :: Instant.now() + Duration.from_secs(30)
    transcript := ""
    paused := false
    loop if Instant.now() < deadline && !paused {
        if output_rx.recv_timeout(Duration.from_millis(100)) == {
            Ok(chunk) -> {
                &transcript.push_str(String.from_utf8_lossy(chunk))
                paused = transcript.contains("\"request_seq\":4,\"success\":true,\"command\":\"pause\"") && transcript.contains("\"event\":\"stopped\"") && transcript.contains("\"reason\":\"pause\"")
            }
            Err(RecvTimeoutError.Timeout) -> {}
            Err(RecvTimeoutError.Disconnected) -> break
        }
    }
    threads_ok := false
    if paused {
        &input_pipe.write_all(dap_frame("{{\"seq\":5,\"type\":\"request\",\"command\":\"threads\",\"arguments\":{{}}}}").bytes()).expect("send threads after pause")
        &input_pipe.flush().expect("flush threads request")
        threads_deadline :: Instant.now() + Duration.from_secs(5)
        loop if Instant.now() < threads_deadline && !threads_ok {
            if output_rx.recv_timeout(Duration.from_millis(100)) == {
                Ok(chunk) -> {
                    &transcript.push_str(String.from_utf8_lossy(chunk))
                    threads_ok = transcript.contains("\"request_seq\":5,\"success\":true,\"command\":\"threads\"")
                }
                Err(RecvTimeoutError.Timeout) -> {}
                Err(RecvTimeoutError.Disconnected) -> break
            }
        }
        &input_pipe.write_all(dap_frame("{{\"seq\":6,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{{}}}}").bytes()).expect("send disconnect after pause")
        &input_pipe.flush().expect("flush disconnect")
    }
    drop(^input_pipe)
    exit_deadline :: Instant.now() + Duration.from_secs(10)
    status := None
    loop if Instant.now() < exit_deadline {
        if (&child.try_wait()).expect("check production DAP process") == Val(result) { status = Val(result); break }
        thread.sleep(Duration.from_millis(20))
    }
    if status.is_none() { _ :: &child.kill(); status = (&child.wait()).ok() }
    _ :: output_reader.join()
    loop {
        if output_rx.try_recv() == Ok(chunk) -> &transcript.push_str(String.from_utf8_lossy(chunk))
        else -> break
    }
    _ :: fs.remove_file(file.as_ref())
    assert(paused, "production DAP pause did not settle:\n{transcript}")
    assert(threads_ok, "production DAP stopped state was not usable:\n{transcript}")
    assert(status.is_some_and((status) -> status.success()), "production DAP pause session failed:\n{transcript}")
}

