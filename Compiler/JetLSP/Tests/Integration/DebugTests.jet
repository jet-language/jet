    configuring_restart :: read_dap_response(output_rx, &transcript, 3, "restart")
    assert(configuring_restart.contains("\"success\":true"), "{configuring_restart}")
    write_dap_request(&input, dap_frame("{{\"seq\":4,\"type\":\"request\",\"command\":\"configurationDone\",\"arguments\":{{}}}}"))
    configured :: read_dap_response(output_rx, &transcript, 4, "configurationDone")
    assert(configured.contains("\"success\":true"), "{configured}")
    // Restart/breakpoint replacement preempt an in-flight native resume.
    write_dap_request(&input, dap_frame("{{\"seq\":5,\"type\":\"request\",\"command\":\"restart\",\"arguments\":{{}}}}"))
    running_restart :: read_dap_response(output_rx, &transcript, 5, "restart")
    assert(running_restart.contains("\"success\":true"), "{running_restart}")
    write_dap_request(&input, dap_frame("{{\"seq\":6,\"type\":\"request\",\"command\":\"setBreakpoints\",\"arguments\":{{\"source\":{{\"path\":\"{file.path}\"}},\"breakpoints\":[{{\"line\":4}}]}}}}"))
    breakpoints :: read_dap_response(output_rx, &transcript, 6, "setBreakpoints")
    assert(breakpoints.contains("\"success\":true"), "{breakpoints}")
    assert(breakpoints.contains("\"verified\":true"), "{breakpoints}")
    read_dap_until(output_rx, &transcript, (output) -> output.contains("\"hitBreakpointIds\":[1]"), "replacement breakpoint stop")
    write_dap_request(&input, dap_frame("{{\"seq\":7,\"type\":\"request\",\"command\":\"disconnect\",\"arguments\":{{}}}}"))
    disconnected :: read_dap_response(output_rx, &transcript, 7, "disconnect")
    assert(disconnected.contains("\"success\":true"), "{disconnected}")
    drop(^input)
    status :: &child.wait().expect("wait for the production Jet DAP command")
    output_reader.join().expect("join DAP output reader")
    loop { if output_rx.try_recv() == Ok(chunk) -> &transcript.push_str(String.from_utf8_lossy(chunk)); else -> break }
    _ :: fs.remove_file(file.as_ref())
    assert(status.success(), "DAP command failed:\n{transcript}")
}
