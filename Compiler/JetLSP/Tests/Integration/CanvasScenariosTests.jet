    tools :: gecko_tools().unwrap_or_else(error -> panic("{error}"))
    run_gecko_cleanup_probe(tools)
    loop name in ["open-and-render", "pan-zoom-fit", "click-select-details", "palette-insert-core-fn", "wire-data-and-exec", "undo-restores-source", "check-button-populates-panel", "random-ops-source-sync"] {
        run_browser_scenario(name, "firefox", tools.node, [("FIREFOX", tools.firefox), ("GECKODRIVER", tools.geckodriver)])
    }
}
