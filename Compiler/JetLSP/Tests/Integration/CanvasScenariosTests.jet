use std.[fs, env, process, thread]
use std.process.[Command]
// Helpers and fixtures are owned solely by CanvasScenarios.jet.
// GATE #4494: real browser/CLI processes, threads and filesystem providers.
// GATE #4483: Unix permissions tests dispatch on the selected target family.

// Rust: tests/canvas_scenarios.rs:47
#Test("full_verification_uses_clean_short_external_tmpdir") {
    repo :: OSPath.from(env.manifest_dir())
    probe :: (mode: String, parent: OSPath?) -> {
        command := Command.new("bash")
        command.current_dir(repo).arg("Tools/agent/verify-full.sh").arg(mode).env("JET_NIX_TMP_CLEANED", "1").env_remove("JET_VERIFY_TMPDIR")
        if parent != none -> command.env("JET_VERIFY_TMPDIR", parent.unwrap())
        output :: command.output().expect("probe full-verification temp root")
        roots :: String.from_utf8(output.stdout).unwrap().lines().map(value -> OSPath.from(value)).collect()
        assert_eq(roots.len(), 4, "temp probe must report every exported temp root")
        assert(roots.iter().all(path -> path == roots[0]))
        assert(roots[0].file_name().is_some_and(name -> name.to_string_lossy().starts_with("jet-verify.")))
        assert(!roots[0].exists(), "verification temp root must be removed on exit")
        (output.status, roots[0].clone())
    }
    (status, root) :: probe("--probe-temp-root", none)
    assert(status.success())
    assert_eq(root.parent(), OSPath.from("/tmp"))
    override_parent :: env.temp_dir().join("jet-verify-parent-{process.id()}-{thread.current().id():?}")
    fs.create_dir_all(override_parent).unwrap()
    (status, root) :: probe("--probe-temp-root", override_parent)
    assert(status.success())
    assert_eq(root.parent(), override_parent.as_path())
    (status, root) :: probe("--probe-temp-root-signal", override_parent)
    assert_eq(status.code(), 143)
    assert_eq(root.parent(), override_parent.as_path())
    fs.remove_dir(override_parent).unwrap()
}

// Rust: tests/canvas_scenarios.rs:103
#Test("strict_full_verification_rejects_each_missing_canvas_tool_once") {
    if core.sys.target.selected_family() == "unix" {
        repo :: OSPath.from(env.manifest_dir())
        tools :: env.temp_dir().join("jet-canvas-preflight-tools-{process.id()}-{thread.current().id():?}")
        fs.create_dir_all(tools).unwrap()
        chromium :: tools.join("chromium")
        firefox :: tools.join("firefox")
        geckodriver :: tools.join("geckodriver")
        node :: tools.join("node")
        fs.write(chromium, "#!/bin/sh\necho 'Chromium 1'\n").unwrap()
        fs.write(firefox, "#!/bin/sh\necho 'Mozilla Firefox 1'\n").unwrap()
        fs.write(geckodriver, "#!/bin/sh\necho 'geckodriver 1'\n").unwrap()
        fs.write(node, "#!/bin/sh\necho 'v1.0.0'\n").unwrap()
        loop path in [chromium, firefox, geckodriver, node] -> fs.set_permissions(path, fs.Permissions.from_mode(0o755)).unwrap()
        loop (missing, chromium, firefox, geckodriver, node) in [
            ("chromium", tools.join("missing-chromium"), firefox.clone(), geckodriver.clone(), node.clone()),
            ("firefox", chromium.clone(), tools.join("missing-firefox"), geckodriver.clone(), node.clone()),
            ("geckodriver", chromium.clone(), firefox.clone(), tools.join("missing-geckodriver"), node.clone()),
            ("node", chromium, firefox, geckodriver, tools.join("missing-node"))
        ] {
            output :: Command.new("bash").current_dir(repo).arg("Tools/agent/verify-full.sh")
                .env("JET_VERIFY_CANVAS_PREREQUISITES_ONLY", "1").env("JET_VERIFY_TEMP_PROBE_ONLY", "1").env("JET_NIX_TMP_CLEANED", "1")
                .env("JET_CANVAS_CHROMIUM", chromium).env("JET_CANVAS_FIREFOX", firefox).env("JET_CANVAS_GECKODRIVER", geckodriver).env("JET_CANVAS_NODE", node)
                .output().expect("run strict Canvas prerequisite preflight")
            assert(!output.status.success(), "missing {missing} must fail")
            stderr :: String.from_utf8_lossy(output.stderr)
            expected :: "error: Canvas interaction tests require Chromium, Firefox/geckodriver, and Node; missing: {missing}. Run Tools/agent/jet-env full Tools/agent/verify-full.sh."
            assert_eq(stderr.matches(expected).count(), 1, stderr)
            assert(!stderr.contains("ignored:"), stderr)
        }
        fs.remove_dir_all(tools).unwrap()
    }
}

// Rust: tests/canvas_scenarios.rs:179
#Test("strict_full_verification_rejects_executable_impostors") {
    repo :: OSPath.from(env.manifest_dir())
    output :: Command.new("bash").current_dir(repo).arg("Tools/agent/verify-full.sh")
        .env("JET_VERIFY_CANVAS_PREREQUISITES_ONLY", "1").env("JET_NIX_TMP_CLEANED", "1")
        .env("JET_CANVAS_CHROMIUM", "true").env("JET_CANVAS_FIREFOX", "true").env("JET_CANVAS_GECKODRIVER", "true").env("JET_CANVAS_NODE", "true")
        .output().expect("run strict Canvas prerequisite preflight")
    assert(!output.status.success(), "arbitrary executables must fail identity checks")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert_eq(stderr.matches("Canvas interaction tests require").count(), 1, stderr)
    assert(stderr.contains("missing: chromium,firefox,geckodriver,node"), stderr)
}

// Rust: tests/canvas_scenarios.rs:209
#Test("strict_full_verification_accepts_canvas_tools_in_dev_shell") {
    repo :: OSPath.from(env.manifest_dir())
    chromium :: resolve_executable(OSPath.from("chromium")).expect("dev-shell chromium path")
    firefox :: resolve_executable(OSPath.from("firefox")).expect("dev-shell firefox path")
    geckodriver :: resolve_executable(OSPath.from("geckodriver")).expect("dev-shell geckodriver path")
    node :: resolve_executable(OSPath.from("node")).expect("dev-shell node path")
    output :: Command.new("bash").current_dir(repo).arg("Tools/agent/verify-full.sh")
        .env("JET_VERIFY_CANVAS_PREREQUISITES_ONLY", "1").env("JET_NIX_TMP_CLEANED", "1")
        .env("JET_CANVAS_CHROMIUM", chromium).env("JET_CANVAS_FIREFOX", firefox).env("JET_CANVAS_GECKODRIVER", geckodriver).env("JET_CANVAS_NODE", node)
        .output().expect("run strict Canvas prerequisite preflight")
    assert(output.status.success(), "dev-shell Canvas prerequisite preflight failed: {String.from_utf8_lossy(output.stderr)}")
}

// Rust: tests/canvas_scenarios.rs:234
#Test("cdp_driver_owns_parallel_browsers_under_long_tmpdir") {
    tools :: canvas_tools()
    if tools == none {
        eprintln("ignored: CDP lifecycle regression needs dev-shell Chromium and Node")
        return
    }
    _permits :: (0..MAX_CANVAS_BROWSERS).map(_ -> CanvasBrowserPermit.acquire()).collect()
    repo :: OSPath.from(env.manifest_dir())
    repeated :: "x".repeat(120)
    long_tmp :: env.temp_dir().join("canvas-driver-lifecycle-{repeated}-{process.id()}")
    fs.create_dir_all(long_tmp).expect("create long Canvas driver temp root")
    output :: Command.new(tools.unwrap().node).current_dir(repo).env("CHROMIUM", tools.unwrap().chromium).env("TMPDIR", long_tmp)
        .arg("Tools/canvas-test/driver-lifecycle.mjs").arg(MAX_CANVAS_BROWSERS.to_string()).output().expect("run Canvas CDP lifecycle regression")
    fs.remove_dir_all(long_tmp).expect("remove long Canvas driver temp root")
    assert(output.status.success(), "parallel CDP lifecycle failed\n--- stdout ---\n{String.from_utf8_lossy(output.stdout)}\n--- stderr ---\n{String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("PASS 4 isolated Chromium lifecycles"))
}

