    tools: canvas_tools().unwrap_or_else(() -> panic("big-project-perf needs dev-shell Chromium and Node; no skipped sample path"))
    loop clean_run in 1..2 {
        eprintln("BIG_PROJECT_PERF clean_run={clean_run}/2")
        run_browser_scenario(BIG_PROJECT_SCENARIO, "chromium", tools.node, [("CHROMIUM", tools.chromium)])
    }
}
#Test("gecko_smoke") {
    if env.var_os("JET_CANVAS_GECKO_SMOKE").as_deref() != "1" {
        eprintln("ignored: Gecko smoke lane not selected")
        return
    }
    tools: gecko_tools().unwrap_or_else(error -> panic("{error}"))
    run_gecko_cleanup_probe(tools)
    loop name in ["open-and-render", "pan-zoom-fit", "click-select-details", "palette-insert-core-fn", "wire-data-and-exec", "undo-restores-source", "check-button-populates-panel", "random-ops-source-sync"] {
        run_browser_scenario(name, "firefox", tools.node, [(_0: "FIREFOX", _1: tools.firefox), (_0: "GECKODRIVER", _1: tools.geckodriver)])
    }
}
#Test("canvas_cases_same_name_get_distinct_directories") {
    repo: OSPath.from(env.manifest_dir())
    first: CanvasCase.new(repo, "undo-restores-source")
    second: CanvasCase.new(repo, "undo-restores-source")
    assert_ne(first.dir, second.dir)
}
