// JSON-RPC framing of one message, responses, and the capabilities
// `initialize` advertises: each one names a method the server answers.
use {
    core.encoding.[Dyn]
    jet_lsp.[lsp_error_response, lsp_member, lsp_parse_rpc_message, lsp_response]
}

lsp_test_rpc_error: fn(body: String) -> Int Never! {
    if lsp_parse_rpc_message(body) == {
        .Ok(_) -> panic("`{body}` parsed as a message")
        .Err(problem) -> problem.code
    }
}

#Test("a JSON-RPC message is an object with a method and a valid id") {
    message: lsp_parse_rpc_message("{{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\"}}") ?? panic("a request parses")
    assert_eq(lsp_test_text(message, "method"), "shutdown")
    assert_eq(lsp_test_int(message, "id"), 7)
    notification: lsp_parse_rpc_message("{{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":[]}}") ?? panic("a notification parses")
    assert(lsp_member(notification, "id") == None, "a notification has no id")
    assert_eq(lsp_test_rpc_error("{{"), -32700)
    assert_eq(lsp_test_rpc_error("[1]"), -32600)
    assert_eq(lsp_test_rpc_error("{{\"jsonrpc\":\"1.0\",\"method\":\"exit\"}}"), -32600)
    assert_eq(lsp_test_rpc_error("{{\"jsonrpc\":\"2.0\",\"id\":1}}"), -32600)
    assert_eq(lsp_test_rpc_error("{{\"jsonrpc\":\"2.0\",\"id\":1.5,\"method\":\"exit\"}}"), -32600)
    assert_eq(lsp_test_rpc_error("{{\"jsonrpc\":\"2.0\",\"id\":true,\"method\":\"exit\"}}"), -32600)
    assert_eq(lsp_test_rpc_error("{{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":3}}"), -32600)
}

#Test("responses echo the request id") {
    assert_eq(lsp_response(Dyn.Int(3), "null"), "{{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":null}}")
    assert_eq(lsp_response(Dyn.Text("a\"b"), "[]"), "{{\"jsonrpc\":\"2.0\",\"id\":\"a\\\"b\",\"result\":[]}}")
    assert_eq(lsp_error_response(Dyn.Null, -32700, "Parse error"), "{{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{{\"code\":-32700,\"message\":\"Parse error\"}}}}")
}

LSP_TEST_PROVIDERS: [String]{
    "textDocumentSync",
    "documentFormattingProvider",
    "documentRangeFormattingProvider",
    "documentOnTypeFormattingProvider",
    "codeActionProvider",
    "completionProvider",
    "signatureHelpProvider",
    "hoverProvider",
    "definitionProvider",
    "referencesProvider",
    "documentHighlightProvider",
    "renameProvider",
    "documentSymbolProvider",
    "workspaceSymbolProvider",
    "foldingRangeProvider",
    "selectionRangeProvider",
    "documentLinkProvider",
    "semanticTokensProvider",
}

#Test("initialize advertises exactly the answered capabilities") {
    server := lsp_test_server()
    result: lsp_test_result(server, "initialize", "{{}}")
    capabilities: lsp_test_field(result, "capabilities")
    loop provider in LSP_TEST_PROVIDERS -> assert(lsp_member(capabilities, provider) != None, "initialize advertises {provider}")
    assert_eq(lsp_test_member_count(capabilities), LSP_TEST_PROVIDERS.len())
    assert_eq(lsp_test_int(capabilities, "textDocumentSync"), 2)
    legend: lsp_test_field(lsp_test_field(capabilities, "semanticTokensProvider"), "legend")
    assert_eq(lsp_test_rows(lsp_test_field(legend, "tokenTypes")).len(), 13)
    assert_eq(lsp_test_text(lsp_test_field(result, "serverInfo"), "name"), "jet")
}

// The request each advertised provider answers.
LSP_TEST_PROVIDER_METHODS: [String]{
    "textDocument/formatting",
    "textDocument/rangeFormatting",
    "textDocument/onTypeFormatting",
    "textDocument/codeAction",
    "textDocument/completion",
    "textDocument/signatureHelp",
    "textDocument/hover",
    "textDocument/definition",
    "textDocument/references",
    "textDocument/documentHighlight",
    "textDocument/prepareRename",
    "textDocument/rename",
    "textDocument/documentSymbol",
    "workspace/symbol",
    "textDocument/foldingRange",
    "textDocument/selectionRange",
    "textDocument/documentLink",
    "textDocument/semanticTokens/full",
    "textDocument/semanticTokens/range",
}

#Test("initialize speaks only LSP, and every advertised provider's request is answered") {
    server := lsp_test_main_server()
    result: lsp_test_result(server, "initialize", "{{}}")
    assert(lsp_member(result, "protocolVersion") == None, "initialize has no protocolVersion")
    assert(lsp_member(result, "resources") == None, "initialize has no resources")
    params: lsp_test_at(LSP_TEST_MAIN_URI, 0, 0)
    loop method in LSP_TEST_PROVIDER_METHODS {
        response: lsp_test_response(server, method, params)
        if lsp_member(response, "error") == .Val(error) -> assert(lsp_test_int(error, "code") != -32601, "{method} is answered")
    }
}

#Test("an unknown method is not found and shutdown is acknowledged") {
    server := lsp_test_server()
    assert_eq(lsp_test_error_code(server, "textDocument/codeLens", "{{}}"), -32601)
    assert_eq(lsp_test_error_code(server, "workspace/executeCommand", "{{}}"), -32601)
    assert(!server.shutdown, "no shutdown yet")
    assert(lsp_test_result(server, "shutdown", "{{}}") == .Null, "shutdown answers null")
    assert(server.shutdown, "shutdown is recorded")
}
