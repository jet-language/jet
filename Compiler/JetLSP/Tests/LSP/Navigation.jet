// Hover, definition, references, highlights, rename and signature help over
// the main fixture: `add` is declared on line 0 (characters 0-3) and called on
// line 5 at characters 4-7 and 11-14.
use {
    core.encoding.[Dyn]
    jet_lsp.[lsp_member]
}

lsp_test_ranges: fn(rows: [Dyn]) -> [String] Never! {
    ranges := [String]{}
    loop row in rows -> ranges.push(lsp_test_range(lsp_test_field(row, "range")))
    ranges.sort()
    ranges
}

#Test("definition jumps from a call to the declared name") {
    server := lsp_test_main_server()
    location: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 5, 5))
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_MAIN_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "0:0-0:3")
    // The inner call resolves to the same declaration.
    inner: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 5, 12))
    assert_eq(lsp_test_range(lsp_test_field(inner, "range")), "0:0-0:3")
    // A blank line names nothing; a closed document is not answered.
    assert(lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)) == .Null, "a blank line has no definition")
    assert(lsp_test_result(server, "textDocument/definition", lsp_test_at("file:///w/closed.jet", 0, 0)) == .Null, "a closed document has no definition")
}

#Test("references list the declaration only when asked") {
    server := lsp_test_main_server()
    with: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":0,\"character\":1}},\"context\":{{\"includeDeclaration\":true}}}}"
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/references", with))
    assert_eq(lsp_test_ranges(rows), [String]{"0:0-0:3", "5:11-5:14", "5:4-5:7"})
    loop row in rows -> assert_eq(lsp_test_text(row, "uri"), LSP_TEST_MAIN_URI)
    without: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"context\":{{\"includeDeclaration\":false}}}}"
    assert_eq(lsp_test_ranges(lsp_test_rows(lsp_test_result(server, "textDocument/references", without))), [String]{"5:11-5:14", "5:4-5:7"})
}

#Test("highlights mark the declaration as a write and each call as a read") {
    server := lsp_test_main_server()
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentHighlight", lsp_test_at(LSP_TEST_MAIN_URI, 5, 4)))
    kinds := [String]{}
    loop row in rows -> kinds.push("{lsp_test_range(lsp_test_field(row, "range"))}={lsp_test_int(row, "kind")}")
    kinds.sort()
    assert_eq(kinds, [String]{"0:0-0:3=3", "5:11-5:14=2", "5:4-5:7=2"})
}

#Test("rename edits the declaration and every call") {
    server := lsp_test_main_server()
    prepared: lsp_test_result(server, "textDocument/prepareRename", lsp_test_at(LSP_TEST_MAIN_URI, 5, 12))
    assert_eq(lsp_test_range(lsp_test_field(prepared, "range")), "5:11-5:14")
    assert_eq(lsp_test_text(prepared, "placeholder"), "add")
    params: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":12}},\"newName\":\"sum\"}}"
    changes: lsp_test_field(lsp_test_result(server, "textDocument/rename", params), "changes")
    edits: lsp_test_rows(lsp_test_field(changes, LSP_TEST_MAIN_URI))
    assert_eq(lsp_test_ranges(edits), [String]{"0:0-0:3", "5:11-5:14", "5:4-5:7"})
    loop edit in edits -> assert_eq(lsp_test_text(edit, "newText"), "sum")
}

#Test("rename refuses a keyword and a position with no declaration") {
    server := lsp_test_main_server()
    keyword: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"newName\":\"fn\"}}"
    assert_eq(lsp_test_error_code(server, "textDocument/rename", keyword), -32602)
    spaced: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"newName\":\"a b\"}}"
    assert_eq(lsp_test_error_code(server, "textDocument/rename", spaced), -32602)
    assert_eq(lsp_test_error_code(server, "textDocument/prepareRename", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)), -32803)
}

#Test("signature help names the call's parameters and the active one") {
    server := lsp_test_main_server()
    // After `add(1, ` the outer call's second parameter is active.
    help: lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 5, 11))
    assert_eq(lsp_test_int(help, "activeParameter"), 1)
    signature: lsp_test_rows(lsp_test_field(help, "signatures"))[0]
    assert(lsp_test_text(signature, "label").contains("add"), "the signature names `add`")
    parameters := [String]{}
    loop parameter in lsp_test_rows(lsp_test_field(signature, "parameters")) -> parameters.push(lsp_test_text(parameter, "label"))
    assert_eq(parameters, [String]{"left: Int", "right: Int"})
    // Inside the inner call's parentheses its first parameter is active.
    inner: lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 5, 15))
    assert_eq(lsp_test_int(inner, "activeParameter"), 0)
    // Outside any call there is no signature.
    assert(lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 4, 1)) == .Null, "no call holds the cursor")
}

#Test("hover shows a declaration's signature and a keyword's description") {
    server := lsp_test_main_server()
    call: lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 5, 5))
    assert(lsp_test_text(lsp_test_field(call, "contents"), "value").contains("add"), "hover names `add`")
    assert_eq(lsp_test_text(lsp_test_field(call, "contents"), "kind"), "markdown")
    assert_eq(lsp_test_range(lsp_test_field(call, "range")), "5:4-5:7")
    keyword: lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 0, 6))
    assert(lsp_test_text(lsp_test_field(keyword, "contents"), "value").contains("Jet keyword."), "`fn` hovers as a keyword")
    assert(lsp_member(keyword, "range") == None, "a keyword hover has no name range")
    assert(lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)) == .Null, "a blank line has no hover")
}
