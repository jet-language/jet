// Hover, definition, declaration, references, highlights, rename and
// signature help over the main fixture: `add` is declared on line 0
// (characters 0-3) and called on line 5 at characters 4-7 and 11-14. Then
// implementations and type definitions over traits and the types
// implementing them.
use {
    core.encoding.[Dyn]
    jet_lsp.[LSPServer, lsp_member]
    jet_semindex.[SemAnchor]
}

lsp_test_ranges: fn(rows: [Dyn]) -> [String] Never! {
    ranges := [String]{}
    loop row in rows -> ranges.push(lsp_test_range(lsp_test_field(row, "range")))
    ranges.sort()
    ranges
}

#Test("definition jumps from a call to the declared name") {
    server := lsp_test_main_server()
    location: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 5, 5))
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_MAIN_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "0:0-0:3")
    // The inner call resolves to the same declaration.
    inner: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 5, 12))
    assert_eq(lsp_test_range(lsp_test_field(inner, "range")), "0:0-0:3")
    // A blank line names nothing; a closed document is not answered.
    assert(lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)) == .Null, "a blank line has no definition")
    assert(lsp_test_result(server, "textDocument/definition", lsp_test_at("file:///w/closed.jet", 0, 0)) == .Null, "a closed document has no definition")
}

#Test("references list the declaration only when asked") {
    server := lsp_test_main_server()
    with: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":0,\"character\":1}},\"context\":{{\"includeDeclaration\":true}}}}"
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/references", with))
    assert_eq(lsp_test_ranges(rows), [String]{"0:0-0:3", "5:11-5:14", "5:4-5:7"})
    loop row in rows -> assert_eq(lsp_test_text(row, "uri"), LSP_TEST_MAIN_URI)
    without: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"context\":{{\"includeDeclaration\":false}}}}"
    assert_eq(lsp_test_ranges(lsp_test_rows(lsp_test_result(server, "textDocument/references", without))), [String]{"5:11-5:14", "5:4-5:7"})
}

#Test("highlights mark the declaration as a write and each call as a read") {
    server := lsp_test_main_server()
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentHighlight", lsp_test_at(LSP_TEST_MAIN_URI, 5, 4)))
    kinds := [String]{}
    loop row in rows {
        kinds.push("{lsp_test_range(lsp_test_field(row, "range"))}={lsp_test_int(row, "kind")}")
    }
    kinds.sort()
    assert_eq(kinds, [String]{"0:0-0:3=3", "5:11-5:14=2", "5:4-5:7=2"})
}

// Publishes the check of `uri` with each unresolved read of a local or a
// parameter pointed at the one declaration of its name there. The fixture
// checks without sema, which is what resolves the names a body reads.
lsp_test_publish_resolved_locals: fn(server: ^LSPServer, uri: String) Never! {
    doc: server.diagnostic_state.docs.get(uri) ?? panic("{uri} is open")
    checked := server.check(doc)
    index := checked.index ?? panic("the fixture builds an index")
    loop slot in 0..<index.references.len() {
        reference: index.references[slot]
        if reference.target != None -> next
        loop definition in index.definitions {
            def: definition.def
            if def.module_path != reference.module_path || def.name != reference.name -> next
            kind: if def.kind == {
                .Local(_, _) -> "local"
                .Param(_) -> "param"
                .Module | .Function(_) | .Struct(_, _) | .Enum(_, _) | .Trait | .Tag | .Type(_) | .Const | .EnumVariant(_) | .Field(_, _) -> next
            }
            index.references[slot].target = Val(SemAnchor{module_path: def.module_path, kind: kind, def_span: def.def_span, semantic_identity: None})
        }
    }
    checked.index = Val(index.move())
    server.published[uri] = checked.move()
}

// The sorted linked ranges at a position, or "null".
lsp_test_linked: fn(server: ^LSPServer, uri: String, line: Int, character: Int) -> [String] {
    result: lsp_test_result(server, "textDocument/linkedEditingRange", lsp_test_at(uri, line, character))
    if result == .Null -> return [String]{"null"}
    ranges := [String]{}
    loop row in lsp_test_rows(lsp_test_field(result, "ranges")) -> ranges.push(lsp_test_range(row))
    ranges.sort()
    ranges
}

#Test("linked editing edits a local's and a parameter's declaration and uses together, and nothing else") {
    server := lsp_test_server()
    uri: "file:///w/linked.jet"
    lsp_test_open(server, uri, "run: fn(count: Int) -> Int {{\n    total: count + 1\n    total + count\n}}\n")
    lsp_test_publish_resolved_locals(server, uri)
    assert_eq(lsp_test_linked(server, uri, 2, 5), [String]{"1:4-1:9", "2:4-2:9"})
    assert_eq(lsp_test_linked(server, uri, 0, 9), [String]{"0:8-0:13", "1:11-1:16", "2:12-2:17"})
    // A function may be called from other files, which linked ranges do not reach.
    assert_eq(lsp_test_linked(server, uri, 0, 1), [String]{"null"})
}

#Test("rename edits the declaration and every call") {
    server := lsp_test_main_server()
    prepared: lsp_test_result(server, "textDocument/prepareRename", lsp_test_at(LSP_TEST_MAIN_URI, 5, 12))
    assert_eq(lsp_test_range(lsp_test_field(prepared, "range")), "5:11-5:14")
    assert_eq(lsp_test_text(prepared, "placeholder"), "add")
    params: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":12}},\"newName\":\"sum\"}}"
    changes: lsp_test_field(lsp_test_result(server, "textDocument/rename", params), "changes")
    edits: lsp_test_rows(lsp_test_field(changes, LSP_TEST_MAIN_URI))
    assert_eq(lsp_test_ranges(edits), [String]{"0:0-0:3", "5:11-5:14", "5:4-5:7"})
    loop edit in edits -> assert_eq(lsp_test_text(edit, "newText"), "sum")
}

LSP_TEST_TYPED_URI: "file:///w/typed.jet"

// `Pattern` is declared on line 2 and written as a type on line 4 at
// characters 16-23 and 28-35; `shapes.Point` names line 0 of the shapes
// document at characters 20-25 of line 8.
LSP_TEST_TYPED: `use shapes

Pattern: distinct String

keep: fn(value: Pattern) -> Pattern {
    value
}

near: fn(at: shapes.Point) -> Int {
    at.x
}
`

#Test("a name a written type holds reaches its declaration for definition, references and rename") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    lsp_test_open(server, LSP_TEST_TYPED_URI, LSP_TEST_TYPED)
    location: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_TYPED_URI, 4, 17))
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_TYPED_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "2:0-2:7")
    with: "{{{lsp_test_text_document(LSP_TEST_TYPED_URI)},\"position\":{{\"line\":2,\"character\":1}},\"context\":{{\"includeDeclaration\":true}}}}"
    assert_eq(lsp_test_ranges(lsp_test_rows(lsp_test_result(server, "textDocument/references", with))), [String]{"2:0-2:7", "4:16-4:23", "4:28-4:35"})
    params: "{{{lsp_test_text_document(LSP_TEST_TYPED_URI)},\"position\":{{\"line\":4,\"character\":30}},\"newName\":\"Glob\"}}"
    edits: lsp_test_rows(lsp_test_field(lsp_test_field(lsp_test_result(server, "textDocument/rename", params), "changes"), LSP_TEST_TYPED_URI))
    assert_eq(lsp_test_ranges(edits), [String]{"2:0-2:7", "4:16-4:23", "4:28-4:35"})
    // A type its module's alias qualifies is the imported module's declaration.
    point: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_TYPED_URI, 8, 21))
    assert_eq(lsp_test_text(point, "uri"), LSP_TEST_SHAPES_URI)
    assert_eq(lsp_test_range(lsp_test_field(point, "range")), "0:0-0:5")
}

LSP_TEST_WIDE_URI: "file:///w/wide.jet"

// Two comment lines of two-byte characters put every later byte offset past
// the same count of characters: `Glyph` is declared on line 2 and written as
// a type on line 4 at characters 16-21 and 26-31, the second within the
// document's last 16 bytes.
LSP_TEST_WIDE: `// cañón ñ
// ññññññññññññññññññññ
Glyph: distinct String

keep: fn(value: Glyph) -> Glyph { value }
`

#Test("a written type after non-ASCII text reaches its declaration, up to the document's last bytes") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_WIDE_URI, LSP_TEST_WIDE)
    first: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_WIDE_URI, 4, 17))
    assert_eq(lsp_test_text(first, "uri"), LSP_TEST_WIDE_URI)
    assert_eq(lsp_test_range(lsp_test_field(first, "range")), "2:0-2:5")
    last: lsp_test_result(server, "textDocument/definition", lsp_test_at(LSP_TEST_WIDE_URI, 4, 28))
    assert_eq(lsp_test_range(lsp_test_field(last, "range")), "2:0-2:5")
    with: "{{{lsp_test_text_document(LSP_TEST_WIDE_URI)},\"position\":{{\"line\":2,\"character\":1}},\"context\":{{\"includeDeclaration\":true}}}}"
    assert_eq(lsp_test_ranges(lsp_test_rows(lsp_test_result(server, "textDocument/references", with))), [String]{"2:0-2:5", "4:16-4:21", "4:26-4:31"})
}

#Test("rename binds negotiated documentChanges to the checked version and names the renamed identity") {
    server := lsp_test_main_server()
    _ := lsp_test_result(server, "initialize", "{{\"capabilities\":{{\"workspace\":{{\"workspaceEdit\":{{\"documentChanges\":true}}}}}}}}")
    params: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":12}},\"newName\":\"sum\"}}"
    result: lsp_test_result(server, "textDocument/rename", params)
    files: lsp_test_rows(lsp_test_field(result, "documentChanges"))
    assert_eq(files.len(), 1)
    document: lsp_test_field(files[0], "textDocument")
    assert_eq(lsp_test_text(document, "uri"), LSP_TEST_MAIN_URI)
    assert_eq(lsp_test_int(document, "version"), 1)
    assert_eq(lsp_test_ranges(lsp_test_rows(lsp_test_field(files[0], "edits"))), [String]{"0:0-0:3", "5:11-5:14", "5:4-5:7"})
    operation: lsp_test_rows(lsp_test_field(result, "semantic_ops"))[0]
    assert_eq(lsp_test_text(operation, "kind"), "rename")
    assert_eq(lsp_test_text(operation, "from"), "add")
    assert_eq(lsp_test_text(operation, "to"), "sum")
    target: lsp_test_rows(lsp_test_field(operation, "targets"))[0]
    assert_eq(lsp_test_text(target, "before"), "fn:main.add")
    assert_eq(lsp_test_text(target, "after"), "fn:main.sum")
}

#Test("rename refuses a program with errors, which may hide a use") {
    server := lsp_test_server()
    uri: "file:///w/broken.jet"
    lsp_test_open(server, uri, "add: fn() -> Int {{ 1 }}\nrun: fn() {{ add( }}\n")
    assert_eq(lsp_test_error_code(server, "textDocument/rename", "{{{lsp_test_text_document(uri)},\"position\":{{\"line\":0,\"character\":1}},\"newName\":\"sum\"}}"), -32803)
}

#Test("rename refuses a keyword and a position with no declaration") {
    server := lsp_test_main_server()
    keyword: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"newName\":\"fn\"}}"
    assert_eq(lsp_test_error_code(server, "textDocument/rename", keyword), -32602)
    spaced: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"position\":{{\"line\":5,\"character\":5}},\"newName\":\"a b\"}}"
    assert_eq(lsp_test_error_code(server, "textDocument/rename", spaced), -32602)
    assert_eq(lsp_test_error_code(server, "textDocument/prepareRename", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)), -32803)
    // A language word says so by name.
    word: lsp_test_field(lsp_test_response(server, "textDocument/prepareRename", lsp_test_at(LSP_TEST_MAIN_URI, 0, 5)), "error")
    assert_eq(lsp_test_int(word, "code"), -32803)
    assert_eq(lsp_test_text(word, "message"), "`fn` is Jet syntax, not a name you can rename")
}

#Test("signature help names the call's parameters and the active one") {
    server := lsp_test_main_server()
    // After `add(1, ` the outer call's second parameter is active.
    help: lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 5, 11))
    assert_eq(lsp_test_int(help, "activeParameter"), 1)
    signature: lsp_test_rows(lsp_test_field(help, "signatures"))[0]
    assert(lsp_test_text(signature, "label").contains("add"), "the signature names `add`")
    parameters: loop parameter in lsp_test_rows(lsp_test_field(signature, "parameters")) -> lsp_test_text(parameter, "label")
    assert_eq(parameters, [String]{"left: Int", "right: Int"})
    // Inside the inner call's parentheses its first parameter is active.
    inner: lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 5, 15))
    assert_eq(lsp_test_int(inner, "activeParameter"), 0)
    // Outside any call there is no signature.
    assert(lsp_test_result(server, "textDocument/signatureHelp", lsp_test_at(LSP_TEST_MAIN_URI, 4, 1)) == .Null, "no call holds the cursor")
}

#Test("hover shows a declaration's signature and a keyword's description") {
    server := lsp_test_main_server()
    call: lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 5, 5))
    assert(lsp_test_text(lsp_test_field(call, "contents"), "value").contains("add"), "hover names `add`")
    assert_eq(lsp_test_text(lsp_test_field(call, "contents"), "kind"), "markdown")
    assert_eq(lsp_test_range(lsp_test_field(call, "range")), "5:4-5:7")
    keyword: lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 0, 6))
    assert(lsp_test_text(lsp_test_field(keyword, "contents"), "value").contains("Jet keyword."), "`fn` hovers as a keyword")
    assert(lsp_member(keyword, "range") == None, "a keyword hover has no name range")
    assert(lsp_test_result(server, "textDocument/hover", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)) == .Null, "a blank line has no hover")
}

#Test("declaration answers as definition does") {
    server := lsp_test_main_server()
    location: lsp_test_result(server, "textDocument/declaration", lsp_test_at(LSP_TEST_MAIN_URI, 5, 5))
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_MAIN_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "0:0-0:3")
    assert(lsp_test_result(server, "textDocument/declaration", lsp_test_at(LSP_TEST_MAIN_URI, 3, 0)) == .Null, "a blank line has no declaration")
}

LSP_TEST_IMPLS_URI: "file:///w/impls.jet"

// `Renderable` (line 0) requires `render` (line 1). `Button` (line 4)
// implements it in its body on line 6, with `render` on line 7. `Panel`
// (line 13) implements it in the head on line 18, with `render` on line 19,
// and has its own impl on line 24. `frame` on line 30 takes and returns them.
LSP_TEST_IMPLS: `Renderable: trait {
    render: fn(self) -> String,
}

Button: struct {
    label: String,
    impl Renderable {
        render: fn(self) -> String {
            self.label
        }
    }
}

Panel: struct {
    title: String,
    corner: Button?,
}

impl Panel.Renderable {
    render: fn(self) -> String {
        self.title
    }
}

impl Panel {
    width: fn(self) -> Int {
        1
    }
}

frame: fn(panel: Panel, items: [Button]) -> Panel? {
    None
}
`

// The ranges a location request answers at `line`:`character`, sorted.
lsp_test_located: fn(server: ^LSPServer, method: String, line: Int, character: Int) -> [String] {
    rows: lsp_test_rows(lsp_test_result(server, method, lsp_test_at(LSP_TEST_IMPLS_URI, line, character)))
    loop row in rows -> assert_eq(lsp_test_text(row, "uri"), LSP_TEST_IMPLS_URI)
    lsp_test_ranges(rows)
}

#Test("implementation goes from a trait to its impls, from a trait method to each impl's method, and from a type to its impls") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_IMPLS_URI, LSP_TEST_IMPLS)
    // A trait block in a type's body and an `impl` head both implement it.
    assert_eq(lsp_test_located(server, "textDocument/implementation", 0, 1), [String]{"18:11-18:21", "6:9-6:19"})
    assert_eq(lsp_test_located(server, "textDocument/implementation", 1, 5), [String]{"19:4-19:10", "7:8-7:14"})
    assert_eq(lsp_test_located(server, "textDocument/implementation", 13, 1), [String]{"18:11-18:21", "24:5-24:10"})
    assert_eq(lsp_test_located(server, "textDocument/implementation", 4, 1), [String]{"6:9-6:19"})
    // A use of the trait reaches the same impls.
    assert_eq(lsp_test_located(server, "textDocument/implementation", 6, 10), [String]{"18:11-18:21", "6:9-6:19"})
    // A function implements nothing and nothing implements it.
    assert_eq(lsp_test_located(server, "textDocument/implementation", 30, 1), [String]{})
}

#Test("type definition goes from a value to the declaration of the type it has") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_IMPLS_URI, LSP_TEST_IMPLS)
    // A parameter's type, a list parameter's item type, and a function's return type through an optional.
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 30, 11), [String]{"13:0-13:5"})
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 30, 25), [String]{"4:0-4:6"})
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 30, 1), [String]{"13:0-13:5"})
    // A field's type, through an optional; a type is its own.
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 15, 5), [String]{"4:0-4:6"})
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 13, 1), [String]{"13:0-13:5"})
    // A built-in type has no declaration.
    assert_eq(lsp_test_located(server, "textDocument/typeDefinition", 14, 5), [String]{})
}
