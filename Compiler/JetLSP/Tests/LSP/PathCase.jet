// In the Jet repository (a folder holding the acronym lexicon's home) an open
// document whose name breaks the path case rule carries Jet.AcronymPathCase,
// and its quick fix renames the file.
use {
    lsp_path_case_files: core.files
    lsp_path_case_process: core.process
    lsp_path_case_sys: core.sys
    jet_foundation.[PATH_CASE_LEXICON_PATH]
}

#Test("a lowered acronym in a repository file's name is reported and renamed by its quick fix") {
    root: "{lsp_path_case_sys.temp_dir()}/jet-lsp-path-case-{lsp_path_case_process.current_pid()}"
    if lsp_path_case_files.exists(root) {
        lsp_path_case_files.remove_all(root) ?? panic("clear {root}: {err}")
    }
    lsp_path_case_files.create_dir_all("{root}/Compiler/JetFoundation/Data/Syntax") ?? panic("create {root}: {err}")
    lsp_path_case_files.create_dir_all("{root}/Core/Net") ?? panic("create {root}/Core/Net: {err}")
    lsp_path_case_files.write("{root}/{PATH_CASE_LEXICON_PATH}", "// home\n") ?? panic("write the lexicon's home: {err}")
    lsp_path_case_files.write("{root}/Core/Net/Tls.jet", "tls: fn() {{}}\n") ?? panic("write Tls.jet: {err}")
    uri: "file://{root}/Core/Net/Tls.jet"
    server := lsp_test_server()
    lsp_test_open(server, uri, "tls: fn() {{}}\n")
    lsp_test_publish(server, uri)
    checked: server.published.get(uri) ?? panic("{uri} was not published")
    codes := [String]{}
    loop diagnostic in checked.diagnostics -> codes.push(diagnostic.code)
    assert_eq(codes, [String]{"L0536"})
    params: "{{{lsp_test_text_document(uri)},\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":0}}}},\"context\":{{\"diagnostics\":[]}}}}"
    actions: lsp_test_rows(lsp_test_result(server, "textDocument/codeAction", params))
    lsp_path_case_files.remove_all(root) ?? panic("remove {root}: {err}")
    assert(actions.len() >= 1, "the diagnostic offers its quick fix")
    action: actions[0]
    assert_eq(lsp_test_text(action, "title"), "Rename `Tls.jet` to `TLS.jet`")
    assert_eq(lsp_test_text(action, "kind"), "quickfix")
    changes: lsp_test_rows(lsp_test_field(lsp_test_field(action, "edit"), "documentChanges"))
    assert(changes.len() == 1, "one file is renamed")
    assert_eq(lsp_test_text(changes[0], "kind"), "rename")
    assert_eq(lsp_test_text(changes[0], "oldUri"), uri)
    assert_eq(lsp_test_text(changes[0], "newUri"), "file://{root}/Core/Net/TLS.jet")
}
