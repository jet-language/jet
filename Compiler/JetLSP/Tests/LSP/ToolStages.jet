// A package's `#On(lsp.…, Query)` hooks reach the `Query` blocks of a document
// that imports the package: completion offers their items, semantic tokens
// take their classes and inlay hints show their labels. The fixture checker
// answers each call without running it (Fixture.jet).
LSP_TEST_TOOLS_URI: "file:///w/tools.jet"

LSP_TEST_TOOLS: `use compiler: core.compiler

#On(lsp.completion, Query)
complete: fn(block: compiler.MarkerBlock) -> [compiler.Completion] {
    [compiler.Completion]{}
}

#On(lsp.semantic_tokens, Query)
classify: fn(block: compiler.MarkerBlock) -> [compiler.SemanticToken] {
    [compiler.SemanticToken]{}
}

#On(lsp.inlay_hints, Query)
hint: fn(block: compiler.MarkerBlock) -> [compiler.InlayHint] {
    [compiler.InlayHint]{}
}
`

LSP_TEST_APP_URI: "file:///w/app.jet"

// Line 3: the block's body ` select name ` runs from character 18 to 31.
LSP_TEST_APP: `use tools

run: fn() {
    #Tools.Query { select name }
}
`

lsp_test_stage_server: fn(app: String) -> LSPServer Never! {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_TOOLS_URI, LSP_TEST_TOOLS)
    lsp_test_open(server, LSP_TEST_APP_URI, app)
    server
}

// Each semantic token as `line:character+length=type`.
lsp_test_stage_tokens: fn(result: Dyn) -> [String] Never! {
    data: lsp_test_token_data(result)
    ^tokens: [String]{}
    ^line: 0
    ^character: 0
    ^at: 0
    loop at + 4 < data.len() {
        if data[at] > 0 -> character = 0
        line += data[at]
        character += data[at + 1]
        tokens.push("{line}:{character}+{data[at + 2]}={data[at + 3]}")
        at += 5
    }
    tokens
}

lsp_test_stage_hints: fn(server: ^LSPServer) -> [String] {
    range: "\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":5,\"character\":0}}}}"
    ^hints: [String]{}
    loop row in lsp_test_rows(lsp_test_result(server, "textDocument/inlayHint", "{{{lsp_test_text_document(LSP_TEST_APP_URI)},{range}}}")) {
        position: lsp_test_field(row, "position")
        hints.push("{lsp_test_int(position, "line")}:{lsp_test_int(position, "character")}{lsp_test_text(row, "label")}")
    }
    hints
}

#Test("a package marker block gets its hooks' completion, tokens and hints") {
    ^server: lsp_test_stage_server(LSP_TEST_APP)
    labels: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_APP_URI, 3, 19)))
    assert(labels.contains("SELECT=1"), "the completion hook's item is offered in the block")
    outside: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_APP_URI, 2, 0)))
    assert(!outside.contains("SELECT=1"), "outside the block the hook is not called")
    tokens: lsp_test_stage_tokens(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(LSP_TEST_APP_URI)}}}"))
    assert(tokens.contains("3:19+6=0"), "the token hook classifies `select` as a keyword")
    assert_eq(lsp_test_stage_hints(server), [String]{"3:31: block"})
}

#Test("a marker block reaches no hook of a package its document does not import") {
    ^server: lsp_test_stage_server(LSP_TEST_APP.replace("use tools", "use other"))
    labels: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_APP_URI, 3, 19)))
    assert(!labels.contains("SELECT=1"), "no hook of an unimported package runs")
    assert_eq(lsp_test_stage_hints(server), [String]{})
}

#Test("a qualified marker block reaches only the package its qualifier names") {
    ^server: lsp_test_stage_server(LSP_TEST_APP.replace("#Tools.Query", "#Other.Query"))
    assert_eq(lsp_test_stage_hints(server), [String]{})
}
