// The test host: a checker over the open documents alone. Each document
// parses into a module and the semantic index is built over them, so the
// server's features read real index facts. Without type checking the index
// resolves declarations, impl heads and free calls, which the feature tests
// lean on.
use {
    core.encoding.[Dyn]
    jet_foundation.[Diagnostic, foundation_json_integer, foundation_json_quote, foundation_parse_protocol_json]
    jet_parser.[parse_source]
    jet_driver.[JetDriverDocModule]
    jet_semindex.[SemEffectProjection, semindex_build, semindex_build_symbols]
    jet_lsp.[LSPChecked, LSPChecker, LSPOverlay, LSPServer, lsp_handle_request, lsp_member, lsp_server, lsp_update_document]
}

LSPFixtureChecker: struct {}

impl LSPFixtureChecker.LSPChecker {
    check: fn(self, entry: String, overlays: [LSPOverlay]) -[FS, Env, Exec, IO, Time]> LSPChecked {
        modules := [JetDriverDocModule]{}
        diagnostics := [Diagnostic]{}
        loop overlay in overlays {
            parsed: parse_source(overlay.source.bytes())
            alias: lsp_fixture_alias(overlay.path)
            modules.push(JetDriverDocModule{
                path: overlay.path.copy(),
                physical_path: overlay.path.copy(),
                alias: alias.copy(),
                source: overlay.source.copy(),
                items: parsed.program.items.copy(),
                block_spans: parsed.program.block_spans.copy(),
                imports: parsed.program.imports.copy(),
                module_name: alias,
            })
            if overlay.path == entry -> diagnostics = parsed.diagnostics.copy()
        }
        index: semindex_build(modules, SemEffectProjection{required: [String]{}, granted: [String]{}, denied: [String]{}, authority: ""})
        symbols: semindex_build_symbols(index, modules)
        LSPChecked{diagnostics: diagnostics, modules: modules, index: Val(index), symbols: symbols}
    }
}

// `/w/main.jet` is the module `main`.
lsp_fixture_alias: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    name: parts[parts.len() - 1]
    if name.ends_with(".jet") -> return name.slice(0, name.count_bytes() - 4)
    name.copy()
}

LSP_TEST_MAIN_URI: "file:///w/main.jet"

// Lines 0-6: `add` is declared on line 0 and called twice on line 5.
LSP_TEST_MAIN: `add: fn(left: Int, right: Int) -> Int {
    left + right
}

run: fn() -> Int {
    add(1, add(2, 3))
}
`

lsp_test_json: fn(text: String) -> Dyn Never! {
    foundation_parse_protocol_json(text) ?? panic("fixture JSON does not parse: {text}")
}

lsp_test_server: fn() -> LSPServer Never! { lsp_server(LSPFixtureChecker{}) }

// Opens `text` at `uri` as version 1, unpublished.
lsp_test_open: fn(server: &LSPServer, uri: String, text: String) Never! {
    params: lsp_test_json("{{\"textDocument\":{{\"uri\":{foundation_json_quote(uri)},\"languageId\":\"jet\",\"version\":1,\"text\":{foundation_json_quote(text)}}}}}")
    assert_eq(lsp_update_document(server.diagnostic_state, Val(params), is_open: true), Val(uri))
}

// A server with the main fixture open.
lsp_test_main_server: fn() -> LSPServer Never! {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_MAIN_URI, LSP_TEST_MAIN)
    server
}

// Records the document's check as its publication, as didOpen does.
lsp_test_publish: fn(server: &LSPServer, uri: String) {
    doc: server.diagnostic_state.docs.get(uri) ?? panic("{uri} is not open")
    server.published[uri] = server.check(doc)
}

// The whole response to one request with id 1.
lsp_test_response: fn(server: &LSPServer, method: String, params: String) -> Dyn {
    lsp_test_json(lsp_handle_request(server, method, Val(lsp_test_json(params)), Dyn.Int(1)))
}

lsp_test_result: fn(server: &LSPServer, method: String, params: String) -> Dyn {
    lsp_member(lsp_test_response(server, method, params), "result") ?? panic("{method} answered without a result")
}

lsp_test_error_code: fn(server: &LSPServer, method: String, params: String) -> Int {
    error: lsp_member(lsp_test_response(server, method, params), "error") ?? panic("{method} answered without an error")
    lsp_test_int(error, "code")
}

lsp_test_text_document: fn(uri: String) -> String Never! { "\"textDocument\":{{\"uri\":{foundation_json_quote(uri)}}}" }

// Positional request params on the document.
lsp_test_at: fn(uri: String, line: Int, character: Int) -> String Never! {
    "{{{lsp_test_text_document(uri)},\"position\":{{\"line\":{line},\"character\":{character}}}}}"
}

lsp_test_rows: fn(value: Dyn) -> [Dyn] Never! {
    if value == .Array(rows) -> return rows.copy()
    panic("expected a JSON array")
}

lsp_test_member_count: fn(value: Dyn) -> Int Never! {
    if value == .Object(fields) -> return fields.len()
    panic("expected a JSON object")
}

lsp_test_field: fn(value: Dyn, key: String) -> Dyn Never! {
    lsp_member(value, key) ?? panic("no `{key}` member")
}

lsp_test_int: fn(value: Dyn, key: String) -> Int Never! {
    foundation_json_integer(lsp_test_field(value, key)) ?? panic("`{key}` is not an integer")
}

lsp_test_text: fn(value: Dyn, key: String) -> String Never! {
    if lsp_test_field(value, key) == .Text(text) -> return text.copy()
    panic("`{key}` is not a string")
}

// A range as `start_line:start_character-end_line:end_character`.
lsp_test_range: fn(value: Dyn) -> String Never! {
    start: lsp_test_field(value, "start")
    end: lsp_test_field(value, "end")
    "{lsp_test_int(start, "line")}:{lsp_test_int(start, "character")}-{lsp_test_int(end, "line")}:{lsp_test_int(end, "character")}"
}
