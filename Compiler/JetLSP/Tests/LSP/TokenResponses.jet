// Source3110–3400 has no standalone original token/helper tests. These narrow
// regressions exercise its pure serialization and byte-scanner contracts only;
// they do not substitute for any gated native/handler original test.
#Test("semantic token result IDs use UTF8 bytes and encoded element count") {
    data :: [U32]{U32{0}, U32{1}, U32{2}, U32{3}, U32{4}}
    assert_eq(lsp_semantic_tokens_result_id("é😀", data), "6:5")
    assert_eq(lsp_semantic_tokens_json("é😀", data), "{{\"resultId\":\"6:5\",\"data\":[0,1,2,3,4]}}")
    assert_eq(lsp_semantic_tokens_json("", [U32]{}), "{{\"resultId\":\"0:0\",\"data\":[]}}")
}

#Test("call argument labels preserve nested separators and reject double colon") {
    assert_eq(lsp_call_argument_label(" value: 1"), Val("value"))
    assert_eq(lsp_call_argument_label(" value:: 1"), None)
    assert_eq(lsp_call_argument_label(" 1 + 2"), None)
    assert_eq(lsp_call_argument_labels("left: nested(1, 2), right: [3, 4], anonymous"), [String]{"left", "right"})
    source :: "call(first: nested(1, 2), second: "
    active :: lsp_active_call(source, source.bytes().len()) ?? panic("active call")
    assert_eq(active.name, "call")
    assert_eq(active.active_param, 1)
    assert_eq(active.active_label, Val("second"))
    assert_eq(active.consumed_labels, [String]{"first"})
    assert_eq(lsp_active_call("not a call", 10), None)
}

#Test("checked impact provenance appends only to a closing object") {
    assert_eq(lsp_impact_report_json_with_provenance("[]  "), "[]  ")
    assert_eq(lsp_impact_report_json_with_provenance("{{\"ok\":true}}\n"), "{{\"ok\":true,\"evidence\":\"checked_static\",\"runtime_observation\":\"not_run\",\"provenance_scope\":\"checked_semantic_index\"}}")
}
