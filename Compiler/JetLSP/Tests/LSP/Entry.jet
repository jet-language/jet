#Test("rename_preserves_case_for_all_declaration_families") {
    src: "UserId: distinct Int\nCount: Int\n#UnitFamily(Length) {{ meter }}\nDoor: struct {{ state {{ Open }} }}\nprotocol Wire {{ client: Send(value: Int) }}\nholder: module<T> {{ Box: struct {{ value: T }} }}\ncache: holder<Int>\nrun: fn() {{}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _): lex(src)
    loop name in ["UserId", "Count", "Length", "Door", "Open", "Wire", "Send"] {
        error: compute_rename(db, tokens, project.entry(), src.find(name) ?? panic("declaration"), "bad_name").err() ?? panic("rename must reject casing")
        assert(error.contains("BadName"), "{name}: {error}")
    }
    loop name in ["meter", "holder", "cache"] {
        error: compute_rename(db, tokens, project.entry(), src.find(name) ?? panic("declaration"), "BadName").err() ?? panic("rename must reject casing")
        assert(error.contains("bad_name"), "{name}: {error}")
    }
}

#Test("semantic_tokens_non_empty") {
    src: "run: fn() {{ x: Int: 1 }}\n"
    (toks, _): lex(src)
    data: encode_semantic_tokens_with_arithmetic(toks, src, [])
    assert(data.len() >= 5, "expected at least one semantic token")
}

#Test("semantic_tokens_keep_string_interpolations_one_color") {
    src: "run: fn() {{\n    line: \"{{escape(level)}}\"\n}}\n"
    (toks, diags): lex(src)
    assert(diags.is_empty(), "{diags:Debug}")
    data: encode_semantic_tokens_with_arithmetic(toks, src, [])
    STRING: U32{7}
    quote: src.find("\"") ?? panic("opening quote")
    end: (src.rfind("\"") ?? panic("closing quote")) + 1
    line := U32{0}
    character := U32{0}
    saw_string := false
    loop chunk in data.chunks_exact(5) {
        if chunk[0] == 0 -> character += chunk[1] else -> line += chunk[0]; character = chunk[1]
        start: lsp_pos_to_offset(src, LSPPos{line: Int{line}, character: Int{character}})
        tok_end: start + Int{chunk[2]}
        if tok_end > quote && start < end {
            assert_eq(chunk[3], STRING, "quoted span must stay string, got type {chunk[3]} at {start}..{tok_end}")
            saw_string = true
        }
    }
    assert(saw_string, "expected a string semantic token over the quoted span")
}

#Test("semantic_tokens_name_arithmetic_policy") {
    src: "run: fn() {{ #Arithmetic(.Wrapping) {{ value: U8{{250}} + U8{{10}} }} }}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "arithmetic semantic-token fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("checked bundle"), facts)
    (tokens, lex_diagnostics): lex(src)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:Debug}")
    data: encode_semantic_tokens_with_arithmetic(tokens, src, db.arithmetic)
    MOD_ARITHMETIC_WRAPPING: (U32{1}) << 7
    assert(data.chunks_exact(5).any((token) -> { token[4].bit_and(MOD_ARITHMETIC_WRAPPING) != 0 }), "wrapping arithmetic modifier missing: {data:Debug}")
    assert(db.arithmetic.iter().all((fact) -> { fact.module_path == project.entry() }), "arithmetic provenance used the wrong source module")
    operation: db.arithmetic.first() ?? panic("arithmetic operation")
    operator_offset: operation.operation_span.start + (src[operation.operation_span.start..<operation.operation_span.end].find("+") ?? panic("arithmetic operator"))
    hover: compute_hover(db, tokens, src, project.entry(), operator_offset) ?? panic("arithmetic operation hover")
    assert(hover.contains("fixed-width add: .Wrapping"), "{hover}")
    assert(hover.contains("scope = {project.entry()}:{operation.scope_span.start}..{operation.scope_span.end}"), "hover lost exact arithmetic scope: {hover}")
}

#Test("inlay_hints_for_int_literal") {
    src: "run: fn() {{\n    x: 42\n    count := 0\n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    hints: db.inlay_hints_for(project.entry())
    assert(hints.iter().any((h) -> { h.label.contains(": Int") }), "expected : Int inlay hint for immutable binding")
    assert(hints.iter().any((h) -> { h.label.contains(": Int") }), "expected : Int inlay hint for mutable binding")
}

#Test("inlay_hints_for_bare_call_parameter_names") {
    src: "clamp: fn(value: Int, low: Int, high: Int) -> Int {{\n    return value\n}}\nrun: fn() {{\n    print(clamp(12, low: 0, high: 10))\n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.is_empty(), "unexpected diagnostics: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    hints: db.inlay_hints_for(project.entry())
    assert(hints.iter().any((hint) -> { hint.label == "value: " }), "expected the bare argument to carry its public name: {hints:Debug}")
    assert(!hints.iter().any((hint) -> { hint.label == "low: " || hint.label == "high: " }), "written labels must not receive duplicate ghost text: {hints:Debug}")
}

// #6014 C3: a `?` hint right after each of the 4 calls whose failure passes up
// automatically; the explicit `?`, the `?(note)` and the `??`-handled call
// get none.
#Test("inlay_hints_mark_each_automatic_propagation") {
    src: "parse: fn(raw: String) -> Int {{\n    if raw == \"\" -> return Err(\"empty\")\n    7\n}}\nrun: fn() {{\n    a: parse(\"1\")\n    b: parse(\"2\")\n    c: parse(\"3\")?\n    d: parse(\"4\") ?? 0\n    e: parse(\"5\")?(\"five\")\n    print(parse(\"6\"))\n    print(a + b + c + d + e + parse(\"7\"))\n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "propagation fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    marks := [Int]{}
    loop hint in db.inlay_hints_for(project.entry()) {
        if hint[0].label == "?" -> marks.push(hint[0].span.end)
    }
    marks.sort()
    expected := [Int]{}
    loop call in ([String]{"parse(\"1\")", "parse(\"2\")", "parse(\"6\")", "parse(\"7\")"}) {
        start: src.find(call) ?? panic("fixture call {call}")
        expected.push(start + call.bytes().len())
    }
    assert_eq(marks, expected)
}

