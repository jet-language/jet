// Rust: Source/LSP/mod.rs:597
#Test("semantic_tokens_keep_string_interpolations_one_color") {
    src :: "fn run() {{\n    line :: \"{{escape(level)}}\"\n}}\n"
    (toks, diags) :: lex(src)
    assert(diags.is_empty(), "{diags:Debug}")
    data :: encode_semantic_tokens_with_arithmetic(toks, src, [])
    STRING :: 7 as U32
    quote :: src.find("\"") ?? panic("opening quote")
    end :: (src.rfind("\"") ?? panic("closing quote")) + 1
    line := 0 as U32
    character := 0 as U32
    saw_string := false
    loop chunk in data.chunks_exact(5) {
        if chunk[0] == 0 { character += chunk[1] }
        else { line += chunk[0]; character = chunk[1] }
        start :: lsp_pos_to_offset(src, LSPPos{line: line as Int, character: character as Int})
        tok_end :: start + chunk[2] as Int
        if tok_end > quote && start < end {
            assert_eq(chunk[3], STRING, "quoted span must stay string, got type {chunk[3]} at {start}..{tok_end}")
            saw_string = true
        }
    }
    assert(saw_string, "expected a string semantic token over the quoted span")
}

// Rust: Source/LSP/mod.rs:636
#Test("semantic_tokens_name_arithmetic_policy") {
    src :: "fn run() {{ #Arithmetic(.Wrapping) {{ value :: U8{{250}} + U8{{10}} }} }}\n"
    (project, diagnostics, maybe_bundle, facts) :: check_test_document(src)
    assert(diagnostics.iter().all(fn(d) { d.severity != Severity.Error }), "arithmetic semantic-token fixture should check: {diagnostics:Debug}")
    db :: build_symbol_db(maybe_bundle ?? panic("checked bundle"), facts)
    (tokens, lex_diagnostics) :: lex(src)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:Debug}")
    data :: encode_semantic_tokens_with_arithmetic(tokens, src, db.arithmetic)
    MOD_ARITHMETIC_WRAPPING :: (1 as U32) << 7
    assert(data.chunks_exact(5).any(fn(token) { token[4] & MOD_ARITHMETIC_WRAPPING != 0 }), "wrapping arithmetic modifier missing: {data:Debug}")
    assert(db.arithmetic.iter().all(fn(fact) { fact.module_path == project.entry() }), "arithmetic provenance used the wrong source module")
    operation :: db.arithmetic.first() ?? panic("arithmetic operation")
    operator_offset :: operation.operation_span.start + (src[operation.operation_span.start..<operation.operation_span.end].find("+") ?? panic("arithmetic operator"))
    hover :: compute_hover(db, tokens, src, project.entry(), operator_offset) ?? panic("arithmetic operation hover")
    assert(hover.contains("fixed-width add: .Wrapping"), "{hover}")
    assert(hover.contains("scope = {project.entry()}:{operation.scope_span.start}..{operation.scope_span.end}"), "hover lost exact arithmetic scope: {hover}")
}

