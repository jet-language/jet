}

#Test("completion_includes_keywords") {
    src: "run: fn() {{\n    \n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    items: compute_completions(db, src, 14, project.entry(), None, None)
    assert(!items.iter().any((i) -> { i.label == "val" }), "old binding words must not appear in completions")
    assert(items.iter().any((i) -> { i.label == "fn" }), "expected fn in completions")
    assert(items.iter().any((i) -> { i.label == "use" }), "expected use (KW_USE) in completions")
}

#Test("completion_hides_soft_public_names_until_explicitly_requested") {
    src: "_helper: fn() {{}}\nrun: fn() {{}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
