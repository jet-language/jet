// Rust: Source/LSP/mod.rs:252
#Test("marker_hover_and_completion_show_one_canonical_parameter_list") {
    src :: "marker Needs(value: String, @sites: [.Function, .Method], @repeatable: true)\n#Needs(\"x\") fn work() {{}}\nfn run() {{\n    \n}}\n"
    (project, diagnostics, maybe_bundle, facts) :: check_test_document(src)
    assert(diagnostics.iter().all(fn(d) { d.severity != Severity.Error }), "marker declaration should check: {diagnostics:Debug}")
    db :: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _) :: lex(src)
    expected :: "marker Needs(value: String, @sites: [.Function, .Method], @repeatable: true)"
    name_offset :: (src.find("Needs(value") ?? panic("marker declaration")) + 1
    hover :: compute_hover(db, tokens, src, project.entry(), name_offset) ?? panic("marker hover")
    assert(hover.contains(expected), "{hover}")
    completion_offset :: (src.rfind("    \n") ?? panic("completion line")) + 4
    completion :: compute_completions(db, src, completion_offset, project.entry(), None, None).iter().find(fn(item) { item.label == "Needs" }) ?? panic("marker completion")
    assert_eq(completion.detail, Val(expected))
}

