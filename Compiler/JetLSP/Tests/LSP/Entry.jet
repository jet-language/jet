    project :: TestProject.new()
    // GATE #4494: remove the real manifest, preserving inline-package coverage.
    entry_fs.remove_file(entry_path.join(project.root, entry_path.from_text(Syntax.PACKAGE_FILE, project.root.platform))) ?? panic("remove the ordinary manifest for inline-package coverage")
    source :: "package {{\n    name: \"lsp-inline\"\n}}\n\npub(package) fn secret() -> String {{\n    return \"ok\"\n}}\n\nfn run() {{\n    print(secret())\n}}\n"
    (diagnostics, bundle, _) :: check_document_with_bundle(project.entry(), source)
    assert(diagnostics.iter().all(fn(d) { d.code != "E1360" && d.code != "E1361" && d.code != "E1362" && d.code != "E1363" }), "inline Package should not produce carrier diagnostics: {diagnostics:Debug}")
    assert(bundle != None, "LSP should retain a checked bundle")
}

