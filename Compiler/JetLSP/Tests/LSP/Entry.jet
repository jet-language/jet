}

#Test("completion_sees_parameter_inside_empty_body") {
    src: "inspect: fn(value: Int) {{\n    \n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    offset: (src.find("    \n") ?? panic("empty body")) + 4
    symbol: db.symbols.symbols().iter().find((symbol) -> { symbol.name == "value" }) ?? panic("parameter")
    scope: symbol.lexical_scope ?? panic("parameter scope")
    assert_eq(scope.span.start, (src.find("{{") ?? panic("body opener")) + 1)
    assert_eq(scope.span.end, src.rfind("}}") ?? panic("body closer"))
    assert(compute_completions(db, src, offset, project.entry(), None, None).iter().any((item) -> { item.label == "value" }))
}

#Test("completion_sees_last_local_on_trailing_blank_line") {
    src: "run: fn() {{\n    last_local: 1\n    \n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    offset: (src.rfind("    \n") ?? panic("trailing blank line")) + 4
    symbol: db.symbols.symbols().iter().find((symbol) -> { symbol.name == "last_local" }) ?? panic("last local")
    scope: symbol.lexical_scope ?? panic("last local scope")
    assert_eq(scope.span.end, src.rfind("}}") ?? panic("body closer"))
    assert(compute_completions(db, src, offset, project.entry(), None, None).iter().any((item) -> { item.label == "last_local" }))
}

#Test("slot_boundaries_ignore_comment_and_interpolation_braces") {
    src: "run: fn(flag: Bool) {{\n    text: \"flag={{flag}}\"\n    // comment braces: {{ }}\n    \n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    bundle: maybe_bundle ?? panic("bundle")
    expected_start: (src.find("{{") ?? panic("body opener")) + 1
    expected_end: src.rfind("}}") ?? panic("body closer")
    assert_eq(bundle.modules[0].block_spans, [Span{start: expected_start, end: expected_end}])
    db: build_symbol_db(bundle, facts)
    offset: (src.rfind("    \n") ?? panic("completion line")) + 4
    assert(compute_completions(db, src, offset, project.entry(), None, None).iter().any((item) -> { item.label == "flag" }))
}
