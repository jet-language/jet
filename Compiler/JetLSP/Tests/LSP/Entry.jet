// Rust: Source/LSP/mod.rs:785
#Test("hover_and_completion_use_same_semantic_fact") {
    src :: "/// Adds two values.\n/// Example: add(1, 2)\nfn add(a: Int, b: Int) -> Int {{ return a + b }}\nfn run() {{\n    \n}}\n"
    (project, _, maybe_bundle, facts) :: check_test_document(src)
    db :: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    // #1801: ledger module alias, never the on-disk path.
    entry_alias :: entry_path.file_stem(entry_path.from_text(project.entry(), project.root.platform)).and_then(fn(stem) { entry_path.to_str(stem) }) ?? panic("entry file stem")
    symbol :: db.symbols.lookup_identity("fn:module:{entry_alias}::add") ?? panic("add fact")
    (tokens, _) :: lex(src)
    hover_offset :: (src.find("\nfn add") ?? panic("add declaration")) + 4
    hover :: compute_hover(db, tokens, src, project.entry(), hover_offset) ?? panic("hover")
    offset :: (src.rfind("    \n") ?? panic("completion line")) + 4
    completion :: compute_completions(db, src, offset, project.entry(), None, None).iter().find(fn(item) { item.label == "add" }) ?? panic("add completion")
    assert(hover.contains(symbol.signature))
    assert(hover.contains(symbol.summary))
    assert(symbol.signature.contains("failure: Int (implicit default !Err)"))
    assert(hover.contains("failure: Int (implicit default !Err)"))
    assert_eq(completion.detail, Val(symbol.signature))
}

