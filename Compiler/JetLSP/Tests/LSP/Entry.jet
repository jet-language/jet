#Test("completion_respects_then_else_slot_boundaries") {
    src: "run: fn(flag: Bool) {{\n    if flag {{\n        then_only: 1\n        print(then_only)\n    }} else {{\n        else_only: 2\n        print(else_only)\n    }}\n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    then_start: (src.find("if flag {{") ?? panic("then start")) + "if flag {{".len()
    then_end: (src.find("    }} else {{") ?? panic("then end")) + 4
    else_start: (src.find("else {{") ?? panic("else start")) + "else {{".len()
    else_end: (src.rfind("    }}\n}}") ?? panic("else end")) + 4
    assert(db.slot_boundaries.iter().any((boundary) -> { boundary.slot == "body" && boundary.span.start == then_start && boundary.span.end == then_end }))
    assert(db.slot_boundaries.iter().any((boundary) -> { boundary.slot == "else_body" && boundary.span.start == else_start && boundary.span.end == else_end }))
    then_offset: src.find("print(then_only)") ?? panic("then completion")
    then_items: compute_completions(db, src, then_offset, project.entry(), None, None)
    assert(then_items.iter().any((item) -> { item.label == "then_only" }))
    assert(!then_items.iter().any((item) -> { item.label == "else_only" }))
    else_offset: src.find("print(else_only)") ?? panic("else completion")
    else_items: compute_completions(db, src, else_offset, project.entry(), None, None)
    assert(else_items.iter().any((item) -> { item.label == "else_only" }))
    assert(!else_items.iter().any((item) -> { item.label == "then_only" }))
}

