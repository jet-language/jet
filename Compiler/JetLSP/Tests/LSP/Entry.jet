    assert(hover.contains("Point"), "{hover}")
    json: db.index.to_json()
    assert(json.contains("\"name\":\"Point\",\"leaf_name\":\"Point\""), "{json}")
}

#Test("hover_shows_source_module_for_imported_root_call") {
    project: TestProject.new()
    // GATE #4494: write the actual imported source, not checked facts.
    entry_fs.write(entry_path.join(project.root, entry_path.from_text("library.jet", project.root.platform)), "render: fn(#Root value: Int) -> Int {{ return value }}\n".bytes()) ?? panic("write imported root-call library")
    src: "use one: \"./library\"\nrun: fn() {{ value: 1\n    value.render()\n}}\n"
    (diagnostics, maybe_bundle, facts): check_document_with_bundle(project.entry(), src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "imported root-call fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("imported root-call bundle"), facts)
    (tokens, lex_diagnostics): lex(src)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:Debug}")
    hover: compute_hover(db, tokens, src, project.entry(), src.find("render") ?? panic("root-call method name")) ?? panic("imported root-call hover")
    assert(hover.contains("from module `"), "{hover}")
    assert(hover.contains("library.jet"), "{hover}")
}

#Test("compiler_layout_fact_lsp_surface_is_visible_and_fixed") {
    src: "Packet: struct {{ count: Int }}\nderive T.LayoutFacts {{ info: T.@layout }}\nrun: fn() {{}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "layout fact LSP fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    layout_offset: (src.find("@layout") ?? panic("layout fact")) + 2
    completions: compute_completions(db, src, layout_offset + 4, project.entry(), None, None)
    assert(completions.iter().any((item) -> { item.label == "@layout" && item.detail == Val("compiler fact: LayoutInfo") }), "compiler fact completion missing: {completions:Debug}")
    (tokens, lex_diagnostics): lex(src)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:Debug}")
    hover: compute_hover(db, tokens, src, project.entry(), layout_offset) ?? panic("layout fact hover")
    assert(hover.contains("@layout"), "{hover}")
    // Definition lookup uses the concrete receiver and lands on its type.
    navigation_src: "Packet: struct {{ count: Int }}\nrun: fn() {{ info: Packet.@layout }}\n"
    (navigation_tokens, navigation_diagnostics): lex(navigation_src)
    assert(navigation_diagnostics.is_empty(), "{navigation_diagnostics:Debug}")
    navigation_offset: (navigation_src.find("@layout") ?? panic("layout fact")) + 2
    (definition_path, definition_span): compute_definition(db, navigation_tokens, navigation_src, project.entry(), navigation_offset) ?? panic("layout fact definition")
    assert_eq(definition_path, project.entry())
    assert_eq(src[definition_span.start..<definition_span.end], "Packet")
    rename_error: compute_rename(db, tokens, project.entry(), layout_offset, "Other").err() ?? panic("compiler facts are not renameable")
    assert(rename_error.contains("compiler-owned @layout"), "{rename_error}")
}

#Test("compiler_origin_fact_lsp_surface_is_visible_and_fixed") {
    src: "run: fn() {{\n    #Track speed: Float{{3.5}}\n    @origin: speed.@origin\n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "origin fact LSP fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    completion_offset: (src.find("speed.@origin") ?? panic("origin access")) + 7
    completions: compute_completions(db, src, completion_offset, project.entry(), None, None)
    assert(completions.iter().any((item) -> { item.label == "@origin" && item.detail == Val("compiler fact: OriginInfo?") }), "origin fact completion missing: {completions:Debug}")
    (tokens, lex_diagnostics): lex(src)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:Debug}")
    origin_offset: (src.find("@origin") ?? panic("origin fact")) + 2
    hover: compute_hover(db, tokens, src, project.entry(), origin_offset) ?? panic("origin fact hover")
    assert(hover.contains("@origin"), "{hover}")
    assert(hover.contains("OriginInfo"), "{hover}")
    (definition_path, definition_span): compute_definition(db, tokens, src, project.entry(), origin_offset) ?? panic("origin fact definition")
    assert_eq(definition_path, project.entry())
    assert_eq(src[definition_span.start..<definition_span.end], "speed")
    references: compute_references(db, tokens, project.entry(), origin_offset, true)
    assert(references.iter().any((pair) -> { src[pair.1.start..<pair.1.end] == "speed" }), "origin receiver references missing: {references:Debug}")
    rename_error: compute_rename(db, tokens, project.entry(), origin_offset, "other").err() ?? panic("compiler facts are not renameable")
    assert(rename_error.contains("compiler-owned @origin"), "{rename_error}")
}

