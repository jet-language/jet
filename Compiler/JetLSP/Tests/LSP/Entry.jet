// Rust: Source/LSP/mod.rs:226
#Test("symbol_db_finds_function") {
    src :: "fn greet(name: String) {{\n    print(name)\n}}\nfn run() {{\n    greet(\"world\")\n}}\n"
    (_project, _, maybe_bundle, facts) :: check_test_document(src)
    bundle :: maybe_bundle ?? panic("bundle")
    db :: build_symbol_db(bundle, facts)
    assert(db.defs.iter().any(fn(d) { d.name == "greet" }))
    assert(db.defs.iter().any(fn(d) { d.name == "run" }))
    assert(db.refs.iter().any(fn(r) { r.name == "greet" }))
}

