#Test("completion_catalogs_source_distinct_and_unit_members") {
    src: "\n#Numeric Token: distinct Int(0..10)\n#UnitFamily(Reward) {{ credit }}\n\nrun: fn() {{\n    token: Token.from_u8(1)\n    money: Credit.from_int(1)\n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle diagnostics: {diagnostics:Debug}"), facts)
    token_site: src.find("Token.from_u8") ?? panic("Token method")
    token_items: compute_completions(db, src, token_site + "Token.from_u".len(), project.entry(), None, None)
    assert(token_items.iter().any((item) -> { item.label == "from_u8" && item.detail == Val("Token.from_u8(value: U8) -> Token !String") }))
    loop (unit_site, _) in src.match_indices("Credit.from_int") {
        unit_items: compute_completions(db, src, unit_site + "Credit.from_i".len(), project.entry(), None, None)
        assert_eq(unit_items.iter().filter((item) -> { item.label == "from_int" }).count(), 1)
    }
}

