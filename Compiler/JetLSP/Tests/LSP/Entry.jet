    hints :: db.inlay_hints_for(project.entry())
    assert(hints.iter().any(fn(hint) { hint.label == "value: " }), "expected the bare argument to carry its public name: {hints:Debug}")
    assert(!hints.iter().any(fn(hint) { hint.label == "low: " || hint.label == "high: " }), "written labels must not receive duplicate ghost text: {hints:Debug}")
}

