// Rust: Source/LSP/mod.rs:1124
#Test("slot_boundaries_ignore_comment_and_interpolation_braces") {
    src :: "fn run(flag: Bool) {{\n    text :: \"flag={{flag}}\"\n    // comment braces: {{ }}\n    \n}}\n"
    (project, _, maybe_bundle, facts) :: check_test_document(src)
    bundle :: maybe_bundle ?? panic("bundle")
    expected_start :: (src.find("{{") ?? panic("body opener")) + 1
    expected_end :: src.rfind("}}") ?? panic("body closer")
    assert_eq(bundle.modules[0].block_spans, [Span{start: expected_start, end: expected_end}])
    db :: build_symbol_db(bundle, facts)
    offset :: (src.rfind("    \n") ?? panic("completion line")) + 4
    assert(compute_completions(db, src, offset, project.entry(), None, None).iter().any(fn(item) { item.label == "flag" }))
}
