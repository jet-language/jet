// Rust: Source/LSP/mod.rs:549
#Test("rename_preserves_case_for_all_declaration_families") {
    src :: "UserId :: distinct Int\nalias Count :: Int\n#UnitFamily(Length) {{ meter }}\nstruct Door {{ state {{ Open }} }}\nprotocol Wire {{ client: Send(value: Int) }}\nmodule holder<T> {{ pub struct Box {{ value: T }} }}\nmodule cache :: holder<Int>\nfn run() {{}}\n"
    (project, _, maybe_bundle, facts) :: check_test_document(src)
    db :: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _) :: lex(src)
    loop name in ["UserId", "Count", "Length", "Door", "Open", "Wire", "Send"] {
        error :: compute_rename(db, tokens, project.entry(), src.find(name) ?? panic("declaration"), "bad_name").err() ?? panic("rename must reject casing")
        assert(error.contains("BadName"), "{name}: {error}")
    }
    loop name in ["meter", "holder", "cache"] {
        error :: compute_rename(db, tokens, project.entry(), src.find(name) ?? panic("declaration"), "BadName").err() ?? panic("rename must reject casing")
        assert(error.contains("bad_name"), "{name}: {error}")
    }
}

