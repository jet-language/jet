// Rust: Source/LSP/mod.rs:46
// GATE #4494: real atomic fetch_add, not a fabricated project identity.
NEXT_TEST_PROJECT := AtomicU64.new(0)

// Rust: Source/LSP/mod.rs:50
struct TestProject {
    root: OSPath
    entry_path: String

    // Rust: Source/LSP/mod.rs:56
    fn new() -[FS, Env]> TestProject {
        root :: loop {
            // GATE #4494: native temp directory, process id and atomic counter.
            candidate :: entry_path.join(entry_env.temp_dir(), entry_path.from_text("jet-lsp-unit-{entry_process.id()}-{NEXT_TEST_PROJECT.fetch_add(1, Ordering.Relaxed)}", core.sys.target.selected_path_platform()))
            if entry_fs.create_dir(candidate) == {
                .Ok(_) -> break candidate
                .Err(error) -> {
                    if error.kind() == .AlreadyExists -> next
                    panic("create isolated LSP test project: {error}")
                }
            }
        }
        entry :: entry_path.to_string_lossy(entry_path.join(root, entry_path.from_text("test.jet", root.platform)))
        project :: TestProject{root: root, entry_path: entry}
        // GATE #4494: real filesystem write; #4409 preserves native error kind.
        entry_fs.write(entry_path.join(project.root, entry_path.from_text(Syntax.PACKAGE_FILE, root.platform)), "name: \"lsp_unit\"\nversion: \"0.1.0\"\n".bytes()) ?? panic("write isolated LSP test manifest")
        project
    }

    // Rust: Source/LSP/mod.rs:79
    fn entry(self) -> String { self.entry_path }
}

// Rust: Source/LSP/mod.rs:85
impl TestProject.Close {
    fn close(^self) -[FS]> Never! {
        // GATE #4494: best-effort native cleanup on every exit.
        _ :: entry_fs.remove_dir_all(self.root)
    }
}

// Rust: Source/LSP/mod.rs:90
fn check_test_document(text: String) -[FS, Env]> (TestProject, [Diagnostic], ProgramBundle?, SemIndexEffectFacts) {
    project :: TestProject.new()
    (diagnostics, bundle, facts) :: check_document_with_bundle(project.entry(), text)
    (project, diagnostics, bundle, facts)
}

// Rust: Source/LSP/mod.rs:104
#Test("old_binding_keyword_has_no_teaching_edit") {
    src :: "fn run() {{\n    let x = 1\n}}\n"
    (_project, diags, _, _) :: check_test_document(src)
    assert(!diags.iter().any(fn(d) { d.code == "E0009" || d.code == "E0985" }), "old binding words should not produce migration diagnostics: {diags:Debug}")
    assert(!diags.is_empty(), "old binding words should still fail")
}

// Rust: Source/LSP/mod.rs:115
#Test("retired_interpolation_selector_has_one_shared_quick_fix") {
    project :: TestProject.new()
    source :: "fn run() {{\n    value :: 1\n    print(\"{{value{Syntax.RETIRED_INTERPOLATION_SELECTOR_RAIL}Debug}}\")\n}}\n"
    fixes :: collect_fixes(project.entry(), source)
    assert_eq(fixes.iter().filter(fn(fix) { fix.title.contains("D-ONCE-HASH1") }).count(), 1)
    assert_eq(lsp_apply_all(source, fixes), "fn run() {{\n    value :: 1\n    print(\"{{value{Syntax.INTERPOLATION_SELECTOR_RAIL}Debug}}\")\n}}\n")
}

// Rust: Source/LSP/mod.rs:139
#Test("retired_print_family_has_one_shared_quick_fix_per_spelling") {
    project :: TestProject.new()
    source :: "use core.term as io\n\nfn run() {{\n    io.println(\"line\")\n    value :: \"value\"\n    io.sprint(value)\n    io.repr(value)\n}}\n"
    fixes :: collect_fixes(project.entry(), source)
    print_fixes :: fixes.iter().filter(fn(fix) { fix.title.contains("D-ONCE-PRINT1") }).cloned().collect()
    assert_eq(print_fixes.len(), 3)
    assert_eq(lsp_apply_all(source, print_fixes), "use core.term as io\n\nfn run() {{\n    io.print(\"line\")\n    value :: \"value\"\n    print(\"{{value}}\")\n    print(\"{{value:Debug}}\")\n}}\n")
}

// Rust: Source/LSP/mod.rs:155
#Test("overlapping_fixes_apply_the_wider_edit_and_defer_the_rest") {
    fix :: fn(start: Int, end: Int, text: String) -> Fix {
        Fix{title: "", edit: TextEdit{span: Span{start: start, end: end}, new_text: text}, applicability: FixApplicability.Safe, safety: FixSafety.Formatting}
    }
    source :: "abcdefghij"
    (text, applied, deferred) :: lsp_apply_non_overlapping(source, [fix(2, 4, "X"), fix(0, 6, "OUTER"), fix(8, 9, "Y")])
    assert_eq(text, "OUTERghYj")
    assert_eq((applied, deferred), (2, 1))
}

// Rust: Source/LSP/mod.rs:175
#Test("test_document_context_does_not_discover_the_workspace") {
