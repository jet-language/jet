    assert(diagnostics.is_empty(), "contract fixture should check: {diagnostics:Debug}")
    db :: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _) :: lex(src)
    default_offset :: (src.find("default_helper") ?? panic("default helper")) + 2
    default_hover :: compute_hover(db, tokens, src, project.entry(), default_offset) ?? panic("default helper hover")
    assert(default_hover.contains("failure: Int (implicit default !Err)"), "{default_hover}")
    explicit_offset :: (src.find("explicit_helper") ?? panic("explicit helper")) + 2
    explicit_hover :: compute_hover(db, tokens, src, project.entry(), explicit_offset) ?? panic("explicit helper hover")
    assert(explicit_hover.contains("failure: Int (explicit !Problem)"), "{explicit_hover}")
}

// Rust: Source/LSP/mod.rs:859
#Test("checked_text_metadata_reaches_editor_symbol_surfaces") {
    src :: "\n#Error\nenum PatternError {{ Bad }}\nPattern :: distinct String\nimpl Pattern.CheckedText {{\n    type Error = PatternError\n    fn check(text: String) !PatternError -[]> {{\n        return\n    }}\n    fn encode_hole<T: Printable>(value: T) -[]> String {{\n        return \"\"\n    }}\n}}\nfn run() {{\n    \n}}\n"
    (project, diagnostics, maybe_bundle, facts) :: check_test_document(src)
    assert(diagnostics.iter().all(fn(d) { d.severity != Severity.Error }), "checked text editor fixture should check: {diagnostics:Debug}")
    db :: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    pattern :: db.symbols.lookup_qualified("Pattern") ?? panic("Pattern semantic symbol")
    assert(pattern.signature.contains("type Pattern :: distinct String"))
    assert(pattern.signature.contains("implements CheckedText"))
    (tokens, _) :: lex(src)
    offset :: (src.find("Pattern ::") ?? panic("Pattern declaration")) + 1
    symbol :: semantic_symbol_at(db, tokens, project.entry(), offset) ?? panic("Pattern symbol at declaration")
    metadata :: semantic_symbol_metadata_json(db, symbol) ?? panic("nominal metadata")
    assert(metadata.contains("\"nominal_base\":\"String\""))
    assert(metadata.contains("\"name\":\"CheckedText\""))
    assert(metadata.contains("encode_hole"))
    completion_offset :: (src.rfind("    \n") ?? panic("completion scope")) + 4
    completion :: compute_completions(db, src, completion_offset, project.entry(), None, None).iter().find(fn(item) { item.label == "Pattern" }) ?? panic("Pattern completion")
    assert(completion.detail.is_some_and(fn(detail) { detail.contains("implements CheckedText") }))
}

