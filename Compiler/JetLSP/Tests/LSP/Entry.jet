use {
    jet_foundation.[Diagnostic, Span, TextEdit]
    jet_foundation.Syntax
    jet_semindex.[SemanticSymbolKind]
    jet_lexer.[lex]
    jet_driver.Loader.[find_manifest_root]
    core.files.runtime.kernel_path_components.[OSPath]
    entry_path: core.files.runtime.kernel_path_components
    entry_fs: core.files.host.retained_descriptor
    entry_env: core.sys.env
    entry_process: core.sys.process
    core.sync.atomic.[AtomicU64, Ordering]
}

// GATE #4494: real atomic fetch_add, not a fabricated project identity.
NEXT_TEST_PROJECT := AtomicU64.new(0)

TestProject: struct {
    root: OSPath
    entry_path: String

    new: fn() -[FS, Env]> TestProject {
        root: loop {
            // GATE #4494: native temp directory, process id and atomic counter.
            candidate: entry_path.join(entry_env.temp_dir(), entry_path.from_text("jet-lsp-unit-{entry_process.id()}-{NEXT_TEST_PROJECT.fetch_add(1, Ordering.Relaxed)}", core.sys.target.selected_path_platform()))
            if entry_fs.create_dir(candidate) == {
                .Ok(_) -> { break candidate }
                .Err(error) -> {
                    if error.kind() == .AlreadyExists -> next
                    panic("create isolated LSP test project: {error}")
                }
            }
        }
        entry: entry_path.to_string_lossy(entry_path.join(root, entry_path.from_text("test.jet", root.platform)))
        project: TestProject{root: root, entry_path: entry}
        // GATE #4494: real filesystem write; #4409 preserves native error kind.
        entry_fs.write(entry_path.join(project.root, entry_path.from_text(Syntax.PACKAGE_FILE, root.platform)), "name: \"lsp_unit\"\nversion: \"0.1.0\"\n".bytes()) ?? panic("write isolated LSP test manifest")
        project
    }

    entry: fn(self) -> String { self.entry_path }
}

impl TestProject.Close {
    close: fn(&&self) Never! -[FS]> {
        // GATE #4494: best-effort native cleanup on every exit.
        _: entry_fs.remove_dir_all(self.root)
    }
}

check_test_document: fn(text: String) -[FS, Env]> (TestProject, [Diagnostic], ProgramBundle?, SemIndexEffectFacts) {
    project: TestProject.new()
    (diagnostics, bundle, facts): check_document_with_bundle(project.entry(), text)
    (project, diagnostics, bundle, facts)
}

#Test("overlapping_fixes_apply_the_wider_edit_and_defer_the_rest") {
    fix: (start: Int, end: Int, text: String) -> {
        Fix{title: "", edit: TextEdit{span: Span{start: start, end: end}, new_text: text}, applicability: FixApplicability.Safe, safety: FixSafety.Formatting}
    }
    source: "abcdefghij"
    (text, applied, deferred): lsp_apply_non_overlapping(source, [fix(2, 4, "X"), fix(0, 6, "OUTER"), fix(8, 9, "Y")])
    assert_eq(text, "OUTERghYj")
    assert_eq((applied, deferred), (2, 1))
}

#Test("test_document_context_does_not_discover_the_workspace") {
    (project, diagnostics, maybe_bundle, _): check_test_document("run: fn() {{}}\n")
    assert(diagnostics.is_empty(), "{diagnostics:Debug}")
    bundle: maybe_bundle ?? panic("bundle")
    assert(entry_path.is_absolute(project.root))
    assert_eq(find_manifest_root(project.root), Val(project.root))
    assert_eq(bundle.project_root, project.root)
    assert_eq(bundle.modules.len(), 1)
    assert_eq(bundle.modules[0].display, project.entry())
}

#Test("inline_package_is_masked_for_lsp_but_keeps_pub_package") {
    project: TestProject.new()
    // GATE #4494: remove the real manifest, preserving inline-package coverage.
    entry_fs.remove_file(entry_path.join(project.root, entry_path.from_text(Syntax.PACKAGE_FILE, project.root.platform))) ?? panic("remove the ordinary manifest for inline-package coverage")
    source: "package: {{\n    name: \"lsp-inline\"\n}}\n\npriv(package) vault: module {{\n    secret: fn() -> String {{\n        return \"ok\"\n    }}\n}}\n\nrun: fn() {{\n    print(vault.secret())\n}}\n"
    (diagnostics, bundle, _): check_document_with_bundle(project.entry(), source)
    assert(diagnostics.iter().all((d) -> { d.code != "E1360" && d.code != "E1361" && d.code != "E1362" && d.code != "E1363" }), "inline Package should not produce carrier diagnostics: {diagnostics:Debug}")
    assert(bundle != None, "LSP should retain a checked bundle")
}

#Test("lsp_pos_round_trip") {
    src: "run: fn() {{\n    x: 1\n}}\n"
    offset: 18
    pos: lsp_byte_offset_to_lsp(src, offset)
    assert_eq(lsp_pos_to_offset(src, pos), offset)
}

#Test("symbol_db_finds_function") {
    src: "greet: fn(name: String) {{\n    print(name)\n}}\nrun: fn() {{\n    greet(\"world\")\n}}\n"
    (_project, _, maybe_bundle, facts): check_test_document(src)
    bundle: maybe_bundle ?? panic("bundle")
    db: build_symbol_db(bundle, facts)
    assert(db.defs.iter().any((d) -> { d.name == "greet" }))
    assert(db.defs.iter().any((d) -> { d.name == "run" }))
    assert(db.refs.iter().any((r) -> { r.name == "greet" }))
}

#Test("hover_returns_function_signature") {
    src: "add: fn(a: Int, b: Int) -> Int {{ return a + b }}\nrun: fn() {{ r: add(1, 2) }}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (toks, _): lex(src)
    hover: compute_hover(db, toks, src, project.entry(), 3)
    assert(hover != None, "expected hover for 'add'")
    h: hover ?? panic("hover")
    assert(h.contains("add"), "hover should mention the function name")
}

#Test("marker_hover_and_completion_show_one_canonical_parameter_list") {
    src: "Needs: struct {{\n    value: String\n\n    impl Marker {{\n        sites: [.Function, .Method]\n        repeatable: true\n    }}\n}}\n#Needs(\"x\") work: fn() {{}}\nrun: fn() {{\n    \n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "marker declaration should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _): lex(src)
    expected: "Needs: struct {{ value: String, impl Marker {{ sites: [.Function, .Method]; repeatable: true }} }}"
    name_offset: (src.find("Needs {{") ?? panic("marker declaration")) + 1
    hover: compute_hover(db, tokens, src, project.entry(), name_offset) ?? panic("marker hover")
    assert(hover.contains(expected), "{hover}")
    completion_offset: (src.rfind("    \n") ?? panic("completion line")) + 4
    completion: compute_completions(db, src, completion_offset, project.entry(), None, None).iter().find((item) -> { item.label == "Needs" }) ?? panic("marker completion")
    assert_eq(completion.detail, Val(expected))
}

#Test("hover_shows_callable_access_defaults_and_policies") {
    src: "#Policy(trace(\"users.load\"))\nload: fn(value: Int, label: String{{\"user\"}}) -> Int {{ return 1 }}\nrun: fn() {{}}\n"
