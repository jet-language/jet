    assert(!db.symbols.complete_visible_in("", None, Val(project.entry())).iter().any((symbol) -> { symbol.name == "_helper" }))
    assert(db.symbols.complete_visible_in("_", None, Val(project.entry())).iter().any((symbol) -> { symbol.name == "_helper" }))
}

#Test("hover_and_completion_use_same_semantic_fact") {
    src: "/// Adds two values.\n/// Example: add(1, 2)\nadd: fn(a: Int, b: Int) -> Int {{ return a + b }}\nrun: fn() {{\n    \n}}\n"
    (project, _, maybe_bundle, facts): check_test_document(src)
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    // #1801: ledger module alias, never the on-disk path.
    entry_alias: entry_path.file_stem(entry_path.from_text(project.entry(), project.root.platform)).and_then((stem) -> { entry_path.to_str(stem) }) ?? panic("entry file stem")
    symbol: db.symbols.lookup_identity("fn:module:{entry_alias}::add") ?? panic("add fact")
    (tokens, _): lex(src)
    hover_offset: (src.find("\nadd: fn") ?? panic("add declaration")) + 1
    hover: compute_hover(db, tokens, src, project.entry(), hover_offset) ?? panic("hover")
    offset: (src.rfind("    \n") ?? panic("completion line")) + 4
    completion: compute_completions(db, src, offset, project.entry(), None, None).iter().find((item) -> { item.label == "add" }) ?? panic("add completion")
    assert(hover.contains(symbol.signature))
    assert(hover.contains(symbol.summary))
    assert(symbol.signature.contains("failure: Int (implicit default !Err)"))
    assert(hover.contains("failure: Int (implicit default !Err)"))
    assert_eq(completion.detail, Val(symbol.signature))
}

#Test("failure_contract_hover_teaches_default_and_explicit_routes") {
    src: "#Error\nProblem: enum {{ Bad }}\ndefault_helper: fn() -> Int {{ return 1 }}\nexplicit_helper: fn() -> Int !Problem {{ return Ok(1) }}\nrun: fn() {{}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.is_empty(), "contract fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    (tokens, _): lex(src)
    default_offset: (src.find("default_helper") ?? panic("default helper")) + 2
    default_hover: compute_hover(db, tokens, src, project.entry(), default_offset) ?? panic("default helper hover")
    assert(default_hover.contains("failure: Int (implicit default !Err)"), "{default_hover}")
    explicit_offset: (src.find("explicit_helper") ?? panic("explicit helper")) + 2
    explicit_hover: compute_hover(db, tokens, src, project.entry(), explicit_offset) ?? panic("explicit helper hover")
    assert(explicit_hover.contains("failure: Int (explicit !Problem)"), "{explicit_hover}")
}

#Test("checked_text_metadata_reaches_editor_symbol_surfaces") {
    src: "\n#Error\nPatternError: enum {{ Bad }}\nPattern: distinct String\nimpl Pattern.CheckedText {{\n    Error: PatternError\n    check: fn(text: String) !PatternError -[]> {{\n        return\n    }}\n    encode_hole: fn<T: Printable>(value: T) -[]> String {{\n        return \"\"\n    }}\n}}\nrun: fn() {{\n    \n}}\n"
    (project, diagnostics, maybe_bundle, facts): check_test_document(src)
    assert(diagnostics.iter().all((d) -> { d.severity != Severity.Error }), "checked text editor fixture should check: {diagnostics:Debug}")
    db: build_symbol_db(maybe_bundle ?? panic("bundle"), facts)
    pattern: db.symbols.lookup_qualified("Pattern") ?? panic("Pattern semantic symbol")
    assert(pattern.signature.contains("type Pattern: distinct String"))
    assert(pattern.signature.contains("implements CheckedText"))
    (tokens, _): lex(src)
    offset: (src.find("Pattern: ") ?? panic("Pattern declaration")) + 1
    symbol: semantic_symbol_at(db, tokens, project.entry(), offset) ?? panic("Pattern symbol at declaration")
    metadata: semantic_symbol_metadata_json(db, symbol) ?? panic("nominal metadata")
    assert(metadata.contains("\"nominal_base\":\"String\""))
    assert(metadata.contains("\"name\":\"CheckedText\""))
    assert(metadata.contains("encode_hole"))
    completion_offset: (src.rfind("    \n") ?? panic("completion scope")) + 4
    completion: compute_completions(db, src, completion_offset, project.entry(), None, None).iter().find((item) -> { item.label == "Pattern" }) ?? panic("Pattern completion")
    assert(completion.detail.is_some_and((detail) -> { detail.contains("implements CheckedText") }))
}

