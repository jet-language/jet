// Document and workspace symbols, selection ranges, document links, semantic
// tokens, completion and code actions.
use {
    core.encoding.[Dyn]
    jet_foundation.[foundation_json_integer]
    jet_lsp.[LSPServer, lsp_member]
}

LSP_TEST_SHAPES_URI: "file:///w/shapes.jet"

LSP_TEST_SHAPES: `Point: struct {
    x: Int
    y: Int
}

Shape: enum {
    Dot
    Line
}

origin: fn() -> Int {
    0
}
`

lsp_test_symbol_rows: fn(rows: [Dyn]) -> [String] Never! {
    names := [String]{}
    loop row in rows {
        container: if lsp_member(row, "containerName") == .Val(_) -> "{lsp_test_text(row, "containerName")}." else -> ""
        names.push("{container}{lsp_test_text(row, "name")}={lsp_test_int(row, "kind")}")
    }
    names
}

#Test("document symbols are the declarations in source order") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentSymbol", "{{{lsp_test_text_document(LSP_TEST_SHAPES_URI)}}}"))
    assert_eq(lsp_test_symbol_rows(rows), [String]{"Point=23", "Point.x=8", "Point.y=8", "Shape=10", "Shape.Dot=22", "Shape.Line=22", "origin=12"})
    location: lsp_test_field(rows[0], "location")
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_SHAPES_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "0:0-0:5")
}

#Test("workspace symbols search the published checks by fuzzy name") {
    server := lsp_test_main_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    assert_eq(lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"pt\"}}")).len(), 0)
    lsp_test_publish(server, LSP_TEST_SHAPES_URI)
    assert_eq(lsp_test_symbol_rows(lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"pt\"}}"))), [String]{"Point=23"})
    // Both open documents are overlaid in the check, so one publication finds
    // the other document's declarations too, each once.
    lsp_test_publish(server, LSP_TEST_MAIN_URI)
    rows: lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"ADD\"}}"))
    assert_eq(lsp_test_symbol_rows(rows), [String]{"add=12"})
    assert_eq(lsp_test_text(lsp_test_field(rows[0], "location"), "uri"), LSP_TEST_MAIN_URI)
}

#Test("selection ranges grow from the name to the whole document") {
    server := lsp_test_main_server()
    params: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"positions\":[{{\"line\":1,\"character\":5}}]}}"
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/selectionRange", params))
    assert_eq(rows.len(), 1)
    current := rows[0]
    assert_eq(lsp_test_range(lsp_test_field(current, "range")), "1:4-1:8")
    depth := 1
    loop lsp_member(current, "parent") == .Val(parent) {
        current = parent
        depth += 1
    }
    assert(depth > 2, "syntax nodes lie between the name and the document")
    assert_eq(lsp_test_range(lsp_test_field(current, "range")), "0:0-7:0")
    outside: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"positions\":[{{\"line\":40,\"character\":0}}]}}"
    assert_eq(lsp_test_error_code(server, "textDocument/selectionRange", outside), -32602)
}

#Test("a file import links to the imported document") {
    server := lsp_test_server()
    uri: "file:///w/app.jet"
    lsp_test_open(server, uri, `use helper: "./helper"

run: fn() -> Int {
    2
}
`)
    lsp_test_open(server, "file:///w/helper.jet", "double: fn(x: Int) -> Int {{ x * 2 }}\n")
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentLink", "{{{lsp_test_text_document(uri)}}}"))
    assert_eq(rows.len(), 1)
    assert_eq(lsp_test_text(rows[0], "target"), "file:///w/helper.jet")
    assert_eq(lsp_test_int(lsp_test_field(lsp_test_field(rows[0], "range"), "start"), "line"), 0)
}

lsp_test_token_data: fn(result: Dyn) -> [Int] Never! {
    data := [Int]{}
    loop value in lsp_test_rows(lsp_test_field(result, "data")) -> data.push(foundation_json_integer(value) ?? -1)
    data
}

#Test("semantic tokens classify declarations, keywords and calls") {
    server := lsp_test_main_server()
    full: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)}}}"))
    assert_eq(full.len() % 5, 0)
    // `add` declares a function, `fn` is a keyword, `left` declares a parameter.
    assert_eq(full.slice(0, 15), [Int]{0, 0, 3, 2, 1, 0, 5, 2, 0, 0, 0, 3, 4, 4, 1})
    range: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"range\":{{\"start\":{{\"line\":5,\"character\":0}},\"end\":{{\"line\":6,\"character\":0}}}}}}"
    line: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/range", range))
    // The call to `add`, then the number `1`.
    assert_eq(line.slice(0, 10), [Int]{5, 4, 3, 2, 0, 0, 4, 1, 8, 0})
    malformed: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"range\":{{\"start\":{{\"line\":5}}}}}}"
    assert_eq(lsp_test_error_code(server, "textDocument/semanticTokens/range", malformed), -32602)
}

lsp_test_labels: fn(result: Dyn) -> [String] Never! {
    labels := [String]{}
    loop item in lsp_test_rows(lsp_test_field(result, "items")) -> labels.push("{lsp_test_text(item, "label")}={lsp_test_int(item, "kind")}")
    labels
}

#Test("completion offers the names in scope that match the prefix") {
    server := lsp_test_main_server()
    // `    ad` on line 5.
    call: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 6)))
    assert(call.contains("add=3"), "`add` completes as a function")
    assert(!call.contains("run=3"), "only names with the prefix complete")
    // `    le` on line 1 is inside `add`, where its parameter is in scope.
    param: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 1, 6)))
    assert(param.contains("left=6"), "the parameter completes inside its function")
    // The same prefix in `run` does not reach `add`'s parameter.
    lsp_test_open(server, LSP_TEST_MAIN_URI, LSP_TEST_MAIN.replace("add(1, add(2, 3))", "le"))
    outside: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 6)))
    assert(!outside.contains("left=6"), "a parameter is out of scope in another function")
}

#Test("completion after a dot with no receiver is empty") {
    server := lsp_test_server()
    uri: "file:///w/dot.jet"
    lsp_test_open(server, uri, `f: fn() {
    .
}
`)
    result: lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 1, 5))
    assert_eq(lsp_test_rows(lsp_test_field(result, "items")).len(), 0)
}

LSP_TEST_MARKERS: `#Codable
Pixel: struct {
    r: Int
    #Layout: c
}
`

// The actions for the whole of line `line`.
lsp_test_action_rows: fn(server: &LSPServer, uri: String, line: Int) -> [Dyn] {
    params: "{{{lsp_test_text_document(uri)},\"range\":{{\"start\":{{\"line\":{line},\"character\":0}},\"end\":{{\"line\":{line + 1},\"character\":0}}}},\"context\":{{\"diagnostics\":[]}}}}"
    lsp_test_rows(lsp_test_result(server, "textDocument/codeAction", params))
}

#Test("code actions offer a diagnostic's fixes and marker moves") {
    server := lsp_test_server()
    uri: "file:///w/markers.jet"
    lsp_test_open(server, uri, LSP_TEST_MARKERS)
    kinds := [String]{}
    loop action in lsp_test_action_rows(server, uri, 3) {
        kinds.push(lsp_test_text(action, "kind"))
        change: lsp_test_rows(lsp_test_field(lsp_test_field(action, "edit"), "documentChanges"))[0]
        document: lsp_test_field(change, "textDocument")
        assert_eq(lsp_test_text(document, "uri"), uri)
        assert_eq(lsp_test_int(document, "version"), 1)
        assert(lsp_test_rows(lsp_test_field(change, "edits")).len() == 1, "each action is one edit")
    }
    // E0942 (markers above and inside) offers both moves as quick fixes.
    assert(kinds.contains("quickfix"), "the diagnostic's fix is offered")
    // A declaration whose markers are all above offers to move them inside.
    clean: "file:///w/clean.jet"
    lsp_test_open(server, clean, `#Codable
Pixel: struct {
    r: Int
}
`)
    titles := [String]{}
    loop action in lsp_test_action_rows(server, clean, 1) -> titles.push(lsp_test_text(action, "title"))
    assert_eq(titles, [String]{"Write the markers inside the declaration's body"})
    // A line outside the document is refused.
    outside: "{{{lsp_test_text_document(clean)},\"range\":{{\"start\":{{\"line\":40,\"character\":0}},\"end\":{{\"line\":40,\"character\":0}}}}}}"
    assert_eq(lsp_test_error_code(server, "textDocument/codeAction", outside), -32602)
}
