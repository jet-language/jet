// Document and workspace symbols, selection ranges, document links, semantic
// tokens, completion and code actions.
use {
    core.encoding.[Dyn]
    jet_foundation.[Span, TextEdit, foundation_json_integer, jet_error_json_encode_value]
    jet_parser.[parser_marker_placement_edits]
    jet_lsp.[LSPServer, lsp_change_workspace_folders, lsp_member, lsp_update_document]
}

LSP_TEST_SHAPES_URI: "file:///w/shapes.jet"

LSP_TEST_SHAPES: `Point: struct {
    x: Int,
    y: Int,
}

Shape: enum {
    Dot,
    Line,
}

origin: fn() -> Int {
    0
}
`

lsp_test_symbol_rows: fn(rows: [Dyn]) -> [String] Never! {
    ^names: [String]{}
    loop row in rows {
        container: if lsp_member(row, "containerName") == .Val(_) -> "{lsp_test_text(row, "containerName")}." else -> ""
        names.push("{container}{lsp_test_text(row, "name")}={lsp_test_int(row, "kind")}")
    }
    names
}

#Test("document symbols are the declarations in source order") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentSymbol", "{{{lsp_test_text_document(LSP_TEST_SHAPES_URI)}}}"))
    assert_eq(lsp_test_symbol_rows(rows), [String]{"Point=23", "Point.x=8", "Point.y=8", "Shape=10", "Shape.Dot=22", "Shape.Line=22", "origin=12"})
    location: lsp_test_field(rows[0], "location")
    assert_eq(lsp_test_text(location, "uri"), LSP_TEST_SHAPES_URI)
    assert_eq(lsp_test_range(lsp_test_field(location, "range")), "0:0-0:5")
}

#Test("workspace symbols search the published checks by fuzzy name") {
    ^server: lsp_test_main_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    assert_eq(lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"pt\"}}")).len(), 0)
    lsp_test_publish(server, LSP_TEST_SHAPES_URI)
    assert_eq(lsp_test_symbol_rows(lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"pt\"}}"))), [String]{"Point=23"})
    // Both open documents are overlaid in the check, so one publication finds
    // the other document's declarations too, each once.
    lsp_test_publish(server, LSP_TEST_MAIN_URI)
    rows: lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"ADD\"}}"))
    assert_eq(lsp_test_symbol_rows(rows), [String]{"add=12"})
    assert_eq(lsp_test_text(lsp_test_field(rows[0], "location"), "uri"), LSP_TEST_MAIN_URI)
}

lsp_test_workspace_rows: fn(server: ^LSPServer) -> [Dyn] {
    lsp_test_rows(lsp_test_result(server, "workspace/symbol", "{{\"query\":\"\"}}"))
}

lsp_test_change_folders: fn(server: ^LSPServer, added: String, removed: String) Never! {
    lsp_change_workspace_folders(server, Val(lsp_test_json("{{\"event\":{{\"added\":[{added}],\"removed\":[{removed}]}}}}")))
}

#Test("workspace symbols follow the workspace folders, open text over saved text") {
    ^server: lsp_test_server()
    ^_: lsp_test_result(server, "initialize", "{{\"workspaceFolders\":[{{\"uri\":\"file:///w/first\",\"name\":\"first\"}},{{\"uri\":\"file:///w/second/\",\"name\":\"second\"}}]}}")
    lsp_test_open(server, "file:///w/second/open.jet", "OpenSecond: fn() {{}}\n")
    rows: lsp_test_workspace_rows(server)
    assert_eq(lsp_test_symbol_rows(rows), [String]{"ClosedFirst=12", "OpenSecond=12"})
    assert_eq(lsp_test_text(lsp_test_field(rows[0], "location"), "uri"), "file:///w/first/closed.jet")
    lsp_test_change_folders(server, "{{\"uri\":\"file:///w/third\",\"name\":\"third\"}}", "{{\"uri\":\"file:///w/first\",\"name\":\"first\"}}")
    added: lsp_test_workspace_rows(server)
    assert_eq(lsp_test_symbol_rows(added), [String]{"OpenSecond=12", "AddedThird=12"})
    assert_eq(lsp_test_text(lsp_test_field(added[1], "location"), "uri"), "file:///w/third/added.jet")
    lsp_test_change_folders(server, "", "{{\"uri\":\"file:///w/second\",\"name\":\"second\"}},{{\"uri\":\"file:///w/third\",\"name\":\"third\"}}")
    assert_eq(lsp_test_workspace_rows(server).len(), 0)
}

#Test("workspace symbols read the root URI as the one workspace folder") {
    ^server: lsp_test_server()
    ^_: lsp_test_result(server, "initialize", "{{\"rootUri\":\"file:///w/third\"}}")
    assert_eq(lsp_test_symbol_rows(lsp_test_workspace_rows(server)), [String]{"AddedThird=12"})
}

#Test("selection ranges grow from the name to the whole document") {
    ^server: lsp_test_main_server()
    params: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"positions\":[{{\"line\":1,\"character\":5}}]}}"
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/selectionRange", params))
    assert_eq(rows.len(), 1)
    ^current: rows[0]
    assert_eq(lsp_test_range(lsp_test_field(current, "range")), "1:4-1:8")
    ^depth: 1
    loop lsp_member(current, "parent") == .Val(parent) {
        current = parent
        depth += 1
    }
    assert(depth > 2, "syntax nodes lie between the name and the document")
    assert_eq(lsp_test_range(lsp_test_field(current, "range")), "0:0-7:0")
    outside: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"positions\":[{{\"line\":40,\"character\":0}}]}}"
    assert_eq(lsp_test_error_code(server, "textDocument/selectionRange", outside), -32602)
}

#Test("a file import links to the imported document") {
    ^server: lsp_test_server()
    uri: "file:///w/app.jet"
    lsp_test_open(
        server,
        uri,
        `use helper: "./helper"

run: fn() -> Int {
    2
}
`,
    )
    lsp_test_open(server, "file:///w/helper.jet", "double: fn(x: Int) -> Int {{ x * 2 }}\n")
    rows: lsp_test_rows(lsp_test_result(server, "textDocument/documentLink", "{{{lsp_test_text_document(uri)}}}"))
    assert_eq(rows.len(), 1)
    assert_eq(lsp_test_text(rows[0], "target"), "file:///w/helper.jet")
    assert_eq(lsp_test_int(lsp_test_field(lsp_test_field(rows[0], "range"), "start"), "line"), 0)
}

lsp_test_token_data: fn(result: Dyn) -> [Int] Never! {
    ^data: [Int]{}
    loop value in lsp_test_rows(lsp_test_field(result, "data")) {
        data.push(foundation_json_integer(value) ?? -1)
    }
    data
}

#Test("semantic tokens classify declarations, keywords and calls") {
    ^server: lsp_test_main_server()
    full: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)}}}"))
    assert_eq(full.len() % 5, 0)
    // `add` declares a function, `fn` is a keyword, `left` declares a parameter.
    assert_eq(full.slice(0, 15), [Int]{0, 0, 3, 2, 1, 0, 5, 2, 0, 0, 0, 3, 4, 4, 1})
    range: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"range\":{{\"start\":{{\"line\":5,\"character\":0}},\"end\":{{\"line\":6,\"character\":0}}}}}}"
    line: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/range", range))
    // The call to `add`, then the number `1`.
    assert_eq(line.slice(0, 10), [Int]{5, 4, 3, 2, 0, 0, 4, 1, 8, 0})
    malformed: "{{{lsp_test_text_document(LSP_TEST_MAIN_URI)},\"range\":{{\"start\":{{\"line\":5}}}}}}"
    assert_eq(lsp_test_error_code(server, "textDocument/semanticTokens/range", malformed), -32602)
}

#Test("semantic tokens class the names a written type holds, and a retired word is no keyword") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_SHAPES_URI, LSP_TEST_SHAPES)
    uri: "file:///w/views.jet"
    lsp_test_open(
        server,
        uri,
        `use shapes

measure: fn(window: View<Int>, grow: ViewMut<Int>, at: shapes.Point) -> Int {
    window.len() + grow.len() + at.x
}

archive: fn(names: [String]) -> [String] {
    names.take(1)
}
`,
    )
    tokens: lsp_test_stage_tokens(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(uri)}}}"))
    expected: [String]{"2:20+4=1", "2:25+3=1", "2:37+7=1", "2:45+3=1", "2:55+6=11", "2:62+5=1", "2:72+3=1"}
    loop token in expected -> assert(tokens.contains(token), "{token} in {tokens}")
    // `take` is the lexer's retired word; as `.take(n)` it names a method.
    assert(!tokens.contains("6:10+4=0"), "`take` is no keyword in {tokens}")
}

#Test("a semantic tokens delta answers the edit from its kept result, and the full tokens for any other id") {
    ^server: lsp_test_main_server()
    doc: lsp_test_text_document(LSP_TEST_MAIN_URI)
    first: lsp_test_result(server, "textDocument/semanticTokens/full", "{{{doc}}}")
    assert_eq(lsp_test_text(first, "resultId"), "1")
    before: lsp_test_token_data(first)
    same: lsp_test_result(server, "textDocument/semanticTokens/full/delta", "{{{doc},\"previousResultId\":\"1\"}}")
    assert_eq(lsp_test_text(same, "resultId"), "2")
    assert_eq(lsp_test_rows(lsp_test_field(same, "edits")).len(), 0)
    // `add(1, add(2, 3))` on line 5 becomes `add(10, add(2, 3))`.
    ^_: lsp_test_change(server.diagnostic_state, LSP_TEST_MAIN_URI, 2, "[{{\"range\":{{\"start\":{{\"line\":5,\"character\":9}},\"end\":{{\"line\":5,\"character\":9}}}},\"text\":\"0\"}}]")
    changed: lsp_test_result(server, "textDocument/semanticTokens/full/delta", "{{{doc},\"previousResultId\":\"2\"}}")
    assert_eq(lsp_test_text(changed, "resultId"), "3")
    assert(lsp_member(changed, "data") == None, "a delta on the kept result sends no full tokens")
    edits: lsp_test_rows(lsp_test_field(changed, "edits"))
    assert_eq(edits.len(), 1)
    start: lsp_test_int(edits[0], "start")
    ^applied: before.slice(0, start)
    loop value in lsp_test_rows(lsp_test_field(edits[0], "data")) {
        applied.push(foundation_json_integer(value) ?? -1)
    }
    loop value in before.slice(start + lsp_test_int(edits[0], "deleteCount"), before.len()) {
        applied.push(value)
    }
    assert_eq(applied, lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{doc}}}")))
    // An id the server no longer keeps answers the full tokens.
    stale: lsp_test_result(server, "textDocument/semanticTokens/full/delta", "{{{doc},\"previousResultId\":\"1\"}}")
    assert_eq(lsp_test_token_data(stale), applied)
    assert(lsp_member(stale, "edits") == None, "a stale delta sends no edits")
}

lsp_test_labels: fn(result: Dyn) -> [String] Never! {
    labels: loop item in lsp_test_rows(lsp_test_field(result, "items")) -> "{lsp_test_text(item, "label")}={lsp_test_int(item, "kind")}"
    labels
}

#Test("completion offers the names in scope that match the prefix") {
    ^server: lsp_test_main_server()
    // `    ad` on line 5.
    call: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 6)))
    assert(call.contains("add=3"), "`add` completes as a function")
    assert(!call.contains("run=3"), "only names with the prefix complete")
    // `    le` on line 1 is inside `add`, where its parameter is in scope.
    param: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 1, 6)))
    assert(param.contains("left=6"), "the parameter completes inside its function")
    // The same prefix in `run` does not reach `add`'s parameter.
    lsp_test_open(server, LSP_TEST_MAIN_URI, LSP_TEST_MAIN.replace("add(1, add(2, 3))", "le"))
    outside: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 6)))
    assert(!outside.contains("left=6"), "a parameter is out of scope in another function")
}

#Test("completion after a dot with no receiver is empty") {
    ^server: lsp_test_server()
    uri: "file:///w/dot.jet"
    lsp_test_open(
        server,
        uri,
        `f: fn() {
    .
}
`,
    )
    result: lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 1, 5))
    assert_eq(lsp_test_rows(lsp_test_field(result, "items")).len(), 0)
}

#Test("completion reads the word being written from the lexer's tokens") {
    ^server: lsp_test_main_server()
    // Inside `add` on line 5, the word's start narrows the names.
    inside: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 6)))
    assert(inside.contains("add=3") && !inside.contains("run=3"), "the start of `add` is the prefix")
    // A comment's text is no word, so nothing narrows there.
    lsp_test_open(server, LSP_TEST_MAIN_URI, LSP_TEST_MAIN.replace("add(1, add(2, 3))", "0 // ad"))
    comment: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 11)))
    assert(comment.contains("add=3") && comment.contains("run=3"), "a comment's text is no prefix")
    // A `.` after a call's `)` has no receiver word.
    lsp_test_open(server, LSP_TEST_MAIN_URI, LSP_TEST_MAIN.replace("add(1, add(2, 3))", "add(1, 2)."))
    after_call: lsp_test_result(server, "textDocument/completion", lsp_test_at(LSP_TEST_MAIN_URI, 5, 14))
    assert_eq(lsp_test_rows(lsp_test_field(after_call, "items")).len(), 0)
}

#Test("a completion item gets its doc comment through completionItem/resolve") {
    ^server: lsp_test_server()
    uri: "file:///w/docs.jet"
    lsp_test_open(server, uri, "/// Adds two numbers.\nadd: fn(left: Int, right: Int) -> Int {{ left + right }}\n\nrun: fn() -> Int {{\n    ad\n}}\n")
    items: lsp_test_rows(lsp_test_field(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 4, 6)), "items"))
    ^at: -1
    loop (index, offered) in items {
        if lsp_test_text(offered, "label") == "add" && lsp_test_int(offered, "kind") == 3 {
            at = index
        }
    }
    if at < 0 -> panic("`add` is offered")
    item: items[at]
    assert(lsp_member(item, "documentation") == None, "the list carries no documentation")
    resolved: lsp_test_result(server, "completionItem/resolve", jet_error_json_encode_value(item))
    assert_eq(lsp_test_text(lsp_test_field(resolved, "documentation"), "value"), "Adds two numbers.")
    assert_eq(lsp_test_text(resolved, "label"), "add")
    assert_eq(lsp_test_text(resolved, "detail"), lsp_test_text(item, "detail"))
    // An item that names no declaration comes back as it is.
    plain: lsp_test_result(server, "completionItem/resolve", "{{\"label\":\"x\",\"kind\":1}}")
    assert(lsp_member(plain, "documentation") == None, "nothing is added")
    assert_eq(lsp_test_text(plain, "label"), "x")
}

#Test("completion offers the binding snippets at a statement's start in a block") {
    ^server: lsp_test_server()
    uri: "file:///w/bind.jet"
    lsp_test_open(server, uri, "run: fn() {{\n    \n}}\n\n")
    ^snippets: [String]{}
    loop item in lsp_test_rows(lsp_test_field(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 1, 4)), "items")) {
        if lsp_test_int(item, "kind") == 15 {
            snippets.push("{lsp_test_text(item, "label")}|{lsp_test_text(item, "insertText")}|{lsp_test_int(item, "insertTextFormat")}")
        }
    }
    assert_eq(snippets, [String]{"bind immut (inferred)|${{1:name}}: ${{2:value}}|2", "bind mut|${{1:name}} := ${{2:value}}|2"})
    outside: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 3, 0)))
    assert(!outside.contains("bind mut=15"), "no binding starts outside a block")
}

#Test("completion offers a saved file's declarations with the `use` line they need") {
    ^server: lsp_test_server()
    ^_: lsp_test_result(server, "initialize", "{{\"rootUri\":\"file:///w\"}}")
    uri: "file:///w/second/open.jet"
    lsp_test_open(server, uri, "run: fn() {{\n    \n}}\n")
    ^imports: [String]{}
    loop item in lsp_test_rows(lsp_test_field(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 1, 4)), "items")) {
        edits: lsp_member(item, "additionalTextEdits") ?? next
        edit: lsp_test_rows(edits)[0]
        imports.push("{lsp_test_text(item, "label")}|{lsp_test_text(item, "insertText")}|{lsp_test_range(lsp_test_field(edit, "range"))}|{lsp_test_text(edit, "newText")}")
    }
    // The open file's saved text is not offered: its check reads the open text.
    assert_eq(imports, [String]{"ClosedFirst|closed.ClosedFirst|0:0-0:0|use first.closed\n", "AddedThird|added.AddedThird|0:0-0:0|use third.added\n"})
    lsp_test_open(server, uri, "run: fn() {{\n    Add\n}}\n")
    narrowed: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 1, 7)))
    assert(narrowed.contains("AddedThird=3") && !narrowed.contains("ClosedFirst=3"), "the prefix narrows the saved declarations")
}

LSP_TEST_MARKERS: `#Codable
Pixel: struct {
    r: Int
    #Layout: c
}
`

// The actions for the whole of line `line`.
lsp_test_action_rows: fn(server: ^LSPServer, uri: String, line: Int) -> [Dyn] {
    params: "{{{lsp_test_text_document(uri)},\"range\":{{\"start\":{{\"line\":{line},\"character\":0}},\"end\":{{\"line\":{line + 1},\"character\":0}}}},\"context\":{{\"diagnostics\":[]}}}}"
    lsp_test_rows(lsp_test_result(server, "textDocument/codeAction", params))
}

#Test("code actions offer a diagnostic's fixes and marker moves") {
    ^server: lsp_test_server()
    ^_: lsp_test_result(server, "initialize", "{{\"capabilities\":{{\"workspace\":{{\"workspaceEdit\":{{\"documentChanges\":true}}}}}}}}")
    uri: "file:///w/markers.jet"
    lsp_test_open(server, uri, LSP_TEST_MARKERS)
    ^kinds: [String]{}
    loop action in lsp_test_action_rows(server, uri, 3) {
        kinds.push(lsp_test_text(action, "kind"))
        change: lsp_test_rows(lsp_test_field(lsp_test_field(action, "edit"), "documentChanges"))[0]
        document: lsp_test_field(change, "textDocument")
        assert_eq(lsp_test_text(document, "uri"), uri)
        assert_eq(lsp_test_int(document, "version"), 1)
        assert(lsp_test_rows(lsp_test_field(change, "edits")).len() == 1, "each action is one edit")
    }
    // E0942 (markers above and inside) offers both moves as quick fixes.
    assert(kinds.contains("quickfix"), "the diagnostic's fix is offered")
    // A declaration whose markers are all above offers to move them inside.
    clean: "file:///w/clean.jet"
    lsp_test_open(
        server,
        clean,
        `#Codable
Pixel: struct {
    r: Int,
}
`,
    )
    titles: loop action in lsp_test_action_rows(server, clean, 1) -> lsp_test_text(action, "title")
    assert_eq(titles, [String]{"Write the markers inside the declaration's body"})
    // A range that runs past the document's end covers the rest of it.
    past: "{{{lsp_test_text_document(clean)},\"range\":{{\"start\":{{\"line\":1,\"character\":0}},\"end\":{{\"line\":40,\"character\":0}}}},\"context\":{{\"diagnostics\":[]}}}}"
    clamped: loop action in lsp_test_rows(lsp_test_result(server, "textDocument/codeAction", past)) -> lsp_test_text(action, "title")
    assert_eq(clamped, [String]{"Write the markers inside the declaration's body"})
}

#Test("a code action's edit is a plain changes map unless documentChanges is negotiated") {
    ^server: lsp_test_server()
    uri: "file:///w/markers.jet"
    lsp_test_open(server, uri, LSP_TEST_MARKERS)
    actions: lsp_test_action_rows(server, uri, 3)
    assert(actions.len() > 0, "the markers line offers actions")
    loop action in actions {
        edit: lsp_test_field(action, "edit")
        assert(lsp_member(edit, "documentChanges") == None, "no documentChanges without the capability")
        assert(lsp_test_rows(lsp_test_field(lsp_test_field(edit, "changes"), uri)).len() == 1, "each action is one edit")
    }
}

#Test("a client that resolves code actions gets each one's edit from codeAction/resolve") {
    ^plain: lsp_test_server()
    uri: "file:///w/markers.jet"
    lsp_test_open(plain, uri, LSP_TEST_MARKERS)
    ^expected: [String]{}
    loop action in lsp_test_action_rows(plain, uri, 3) {
        expected.push(jet_error_json_encode_value(action))
    }
    ^server: lsp_test_server()
    ^_: lsp_test_result(server, "initialize", "{{\"capabilities\":{{\"textDocument\":{{\"codeAction\":{{\"resolveSupport\":{{\"properties\":[\"edit\"]}}}}}}}}}}")
    lsp_test_open(server, uri, LSP_TEST_MARKERS)
    offered: lsp_test_action_rows(server, uri, 3)
    assert(offered.len() > 0, "the markers line offers actions")
    ^resolved: [String]{}
    loop action in offered {
        assert(lsp_member(action, "edit") == None, "the list leaves each edit out")
        resolved.push(jet_error_json_encode_value(lsp_test_result(server, "codeAction/resolve", jet_error_json_encode_value(action))))
    }
    // Each resolved action is the one a client that does not resolve gets.
    assert_eq(resolved, expected)
    // Once the document moves on, an action offered before is refused.
    ^_: lsp_update_document(server.diagnostic_state, Val(lsp_test_json("{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":2}},\"contentChanges\":[]}}")), is_open: false)
    assert_eq(lsp_test_error_code(server, "codeAction/resolve", jet_error_json_encode_value(offered[0])), -32801)
}

// The byte offset of an LSP position in ASCII `text`.
lsp_test_offset: fn(text: String, position: Dyn) -> Int Never! {
    wanted: lsp_test_int(position, "line")
    ^offset: 0
    ^row: 0
    loop line in text.split("\n") {
        if row == wanted -> break
        offset += line.count_bytes() + 1
        row += 1
    }
    offset + lsp_test_int(position, "character")
}

// `text` after `edits`, which are in source order and do not overlap.
lsp_test_apply_edits: fn(text: String, edits: [TextEdit]) -> String Never! {
    ^result: text
    loop index in 0..<edits.len() {
        edit: edits[edits.len() - 1 - index]
        bytes: result.bytes()
        head: String.from_bytes(bytes.slice(0, edit.span.start)) ?? panic("an edit span keeps whole characters")
        tail: String.from_bytes(bytes.slice(edit.span.end, bytes.len())) ?? panic("an edit span keeps whole characters")
        result = "{head}{edit.new_text}{tail}"
    }
    result
}

#Test("marker_move_code_actions on a struct and a function write what jet fix --markers writes") {
    ^server: lsp_test_server()
    sources: [String]{
        `#Codable
Pixel: struct {
    r: Int,
    #Layout: c
}
`,
        `#MustUse
area: fn() -> Int {
    1
    #Inline: true
}
`,
    }
    loop index in 0..<sources.len() {
        source: sources[index]
        uri: "file:///w/split{index}.jet"
        lsp_test_open(server, uri, source)
        ^moves: [String:String]{}
        loop action in lsp_test_action_rows(server, uri, 1) {
            if lsp_test_text(action, "kind") != "refactor.rewrite" -> next
            edits: lsp_test_rows(lsp_test_field(lsp_test_field(lsp_test_field(action, "edit"), "changes"), uri))
            assert_eq(edits.len(), 1)
            range: lsp_test_field(edits[0], "range")
            span: Span{start: lsp_test_offset(source, lsp_test_field(range, "start")), end: lsp_test_offset(source, lsp_test_field(range, "end"))}
            moves[lsp_test_text(action, "title")] = lsp_test_apply_edits(source, [TextEdit]{TextEdit{span: span, new_text: lsp_test_text(edits[0], "newText")}})
        }
        // `jet fix --markers above|inside` applies the parser's placements for
        // every declaration; each source holds one.
        assert_eq(moves.len(), 2)
        assert_eq(moves["Write the markers above the declaration"], lsp_test_apply_edits(source, parser_marker_placement_edits(source.bytes(), false)))
        assert_eq(moves["Write the markers inside the declaration's body"], lsp_test_apply_edits(source, parser_marker_placement_edits(source.bytes(), true)))
    }
}
