// Positions are UTF-16 code units on lines ended by `\n`, `\r\n` or `\r`;
// `file://` URIs name percent-decoded paths.
use {
    jet_foundation.[Span]
    jet_lsp.[
        LSPPos,
        LSPRange,
        lsp_apply_edit,
        lsp_byte_offset_to_lsp,
        lsp_byte_span_to_range,
        lsp_checked_offset_bytes,
        lsp_full_document_range,
        lsp_line_table_bytes,
        lsp_path_to_uri,
        lsp_pos_from_json,
        lsp_pos_to_offset,
        lsp_range_json,
        lsp_uri_to_path,
    ]
}

lsp_test_pos_text: fn(pos: LSPPos) -> String Never! { "{pos.line}:{pos.character}" }

#Test("a byte offset maps to its line and UTF-16 character") {
    src: "aé😀b\r\ncd\re"
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 0)), "0:0")
    // `b` follows one 2-byte and one 4-byte character: 1 + 1 + 2 units.
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 7)), "0:4")
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 10)), "1:0")
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 11)), "1:1")
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 13)), "2:0")
    // Past the end clamps to the end.
    assert_eq(lsp_test_pos_text(lsp_byte_offset_to_lsp(src, 99)), "2:1")
}

#Test("a position maps back to its byte offset") {
    src: "aé😀b\ncd"
    assert_eq(lsp_pos_to_offset(src, LSPPos{line: 0, character: 4}), 7)
    assert_eq(lsp_pos_to_offset(src, LSPPos{line: 1, character: 1}), 10)
    bytes: src.bytes()
    table: lsp_line_table_bytes(bytes)
    // Inside the surrogate pair is no position.
    assert_eq(lsp_checked_offset_bytes(table, bytes, LSPPos{line: 0, character: 3}), None)
    // A character past the line's end clamps to it; a line past the end is none.
    assert_eq(lsp_checked_offset_bytes(table, bytes, LSPPos{line: 1, character: 40}), Val(11))
    assert_eq(lsp_checked_offset_bytes(table, bytes, LSPPos{line: 2, character: 0}), None)
}

#Test("ranges round-trip through JSON") {
    src: "one\ntwo"
    range: lsp_byte_span_to_range(src, Span{start: 1, end: 6})
    json: lsp_range_json(range)
    assert_eq(json, "{{\"start\":{{\"line\":0,\"character\":1}},\"end\":{{\"line\":1,\"character\":2}}}}")
    full: lsp_full_document_range(src)
    assert_eq(lsp_test_pos_text(full.end), "1:3")
    parsed: lsp_pos_from_json(lsp_test_json("{{\"line\":1,\"character\":2}}")) ?? panic("position parses")
    assert_eq(lsp_test_pos_text(parsed), "1:2")
    assert_eq(lsp_pos_from_json(lsp_test_json("{{\"line\":-1,\"character\":2}}")), None)
    assert_eq(lsp_pos_from_json(lsp_test_json("{{\"line\":1}}")), None)
}

#Test("an edit replaces its range and checks the replaced length") {
    src: "let 😀 = 1\nnext"
    range: LSPRange{start: LSPPos{line: 0, character: 4}, end: LSPPos{line: 0, character: 6}}
    assert_eq(lsp_apply_edit(src, range, Val(2), "x"), Val("let x = 1\nnext"))
    assert_eq(lsp_apply_edit(src, range, Val(1), "x"), None)
    assert_eq(lsp_apply_edit(src, LSPRange{start: LSPPos{line: 0, character: 5}, end: LSPPos{line: 0, character: 6}}, None, "x"), None)
    reversed: LSPRange{start: LSPPos{line: 1, character: 0}, end: LSPPos{line: 0, character: 0}}
    assert_eq(lsp_apply_edit(src, reversed, None, ""), None)
    across: LSPRange{start: LSPPos{line: 0, character: 10}, end: LSPPos{line: 1, character: 0}}
    assert_eq(lsp_apply_edit(src, across, None, " "), Val("let 😀 = 1 next"))
}

#Test("file URIs name decoded paths") {
    assert_eq(lsp_uri_to_path("file:///tmp/a%20b/main.jet"), "/tmp/a b/main.jet")
    assert_eq(lsp_uri_to_path("file:///C:/a%20b"), "C:/a b")
    assert_eq(lsp_uri_to_path("untitled:Untitled-1"), "untitled:Untitled-1")
    assert_eq(lsp_uri_to_path("file:///bad%zz"), "")
    assert_eq(lsp_path_to_uri("/tmp/a b/main.jet"), "file:///tmp/a%20b/main.jet")
    assert_eq(lsp_uri_to_path(lsp_path_to_uri("/w/ü.jet")), "/w/ü.jet")
}
