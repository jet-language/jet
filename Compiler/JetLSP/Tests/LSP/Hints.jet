// Inlay hints from the checked index: parameter names at a call's positional
// arguments, the `^` and `^^` a callee's signature decides, and, on a type,
// the methods an impl declares outside its body. The fixture checker resolves
// free calls and impl heads but infers no local types, so local type hints and
// method receivers are covered by the LSP cases.
LSP_TEST_HINTS_URI: "file:///w/hints.jet"

// Line 5 calls `clamp` with two positional arguments, one that spells its
// parameter's name, and a labeled one.
LSP_TEST_HINTS: `clamp: fn(value: Int, low: Int, high: Int) -> Int {
    value
}

run: fn(low: Int) -> Int {
    clamp(12, low, high: 10) + clamp(1, 2, 3)
}
`

LSP_TEST_BREADCRUMB_URI: "file:///w/widget.jet"

// `size` is declared by an impl apart from `Widget`'s body on line 0.
LSP_TEST_BREADCRUMB: `Widget: struct {
    title: String
}

impl Widget {
    size: fn(self) -> Int {
        1
    }
}
`

LSP_TEST_MARKS_URI: "file:///w/marks.jet"

// Line 10 calls `bump`, which writes its first argument; line 11 calls
// `keep`, which takes its only one.
LSP_TEST_MARKS: `bump: fn(count: ^Int, by: Int) {
    count += by
}

keep: fn(title: ^^String) -> Int {
    0
}

run: fn() -> Int {
    score := 1
    bump(score, 2)
    keep("vault")
}
`

LSP_TEST_FAILURES_URI: "file:///w/failures.jet"

// Four calls of `fail` on lines 5 to 7, each passing its failure up.
LSP_TEST_FAILURES: `fail: fn() -> Int {
    1
}

run: fn() -> Int {
    first: fail()
    second: fail() + fail()
    first + second + fail()
}
`

// Each hint as `line:character label`.
lsp_test_hints: fn(server: ^LSPServer, uri: String, end_line: Int) -> [String] {
    range: "\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":{end_line},\"character\":0}}}}"
    hints := [String]{}
    loop row in lsp_test_rows(lsp_test_result(server, "textDocument/inlayHint", "{{{lsp_test_text_document(uri)},{range}}}")) {
        position: lsp_test_field(row, "position")
        hints.push("{lsp_test_int(position, "line")}:{lsp_test_int(position, "character")} {lsp_test_text(row, "label")}")
    }
    hints
}

#Test("inlay hints name the parameter each positional argument binds") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_HINTS_URI, LSP_TEST_HINTS)
    // The range runs past the document's last line and stops at its end.
    assert_eq(lsp_test_hints(server, LSP_TEST_HINTS_URI, 40), [String]{"5:10 value: ", "5:37 value: ", "5:40 low: ", "5:43 high: "})
    // A range over the first line holds none of them.
    assert_eq(lsp_test_hints(server, LSP_TEST_HINTS_URI, 1), [String]{})
}

#Test("inlay hints show a type's methods declared in an impl apart from it") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_BREADCRUMB_URI, LSP_TEST_BREADCRUMB)
    assert_eq(lsp_test_hints(server, LSP_TEST_BREADCRUMB_URI, 9), [String]{"0:6 + size: fn() -> Int"})
}

#Test("calls show the marks their signatures decide and a written name is a modification") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_MARKS_URI, LSP_TEST_MARKS)
    assert_eq(lsp_test_hints(server, LSP_TEST_MARKS_URI, 13), [String]{"10:9 count: &", "10:16 by: ", "11:9 title: &&"})
    data: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(LSP_TEST_MARKS_URI)}}}"))
    // Each token on line 10 as `line:character:modifiers`; `modification` is
    // bit 4.
    tokens := [String]{}
    line := 0
    character := 0
    at := 0
    loop at + 4 < data.len() {
        if data[at] > 0 -> character = 0
        line += data[at]
        character += data[at + 1]
        if line == 10 -> tokens.push("{line}:{character}:{data[at + 4]}")
        at += 5
    }
    assert_eq(tokens, [String]{"10:4:0", "10:9:4", "10:16:0"})
}

#Test("inlay hints show a `?` after each call that passes a failure up") {
    server := lsp_test_server()
    lsp_test_open(server, LSP_TEST_FAILURES_URI, LSP_TEST_FAILURES)
    assert_eq(lsp_test_hints(server, LSP_TEST_FAILURES_URI, 9), [String]{"5:17 ?", "6:18 ?", "6:27 ?", "7:27 ?"})
    // The range keeps those inside it.
    assert_eq(lsp_test_hints(server, LSP_TEST_FAILURES_URI, 6), [String]{"5:17 ?"})
}
