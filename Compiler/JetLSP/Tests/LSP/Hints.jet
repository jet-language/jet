// Inlay hints from the checked index: parameter names at a call's positional
// arguments, the `^` and `^^` a callee's signature decides, and, on a type,
// the methods an impl declares outside its body. The fixture checker resolves
// free calls and impl heads but infers no local types, so local type hints and
// method receivers are covered by the LSP cases.
use {
    jet_driver.[JetDriverSourceDocument, JetDriverToolStageItem]
    jet_foundation.[DIAGNOSTIC_ERROR, DIAGNOSTIC_LINT, Diagnostic, DiagnosticFixApplicability, Span, TextEdit]
    jet_lsp.[LSPChecked, LSPChecker, lsp_server]
}

LSP_TEST_HINTS_URI: "file:///w/hints.jet"

// Line 5 calls `clamp` with two positional arguments, one that spells its
// parameter's name, and a labeled one.
LSP_TEST_HINTS: `clamp: fn(value: Int, low: Int, high: Int) -> Int {
    value
}

run: fn(low: Int) -> Int {
    clamp(12, low, high: 10) + clamp(1, 2, 3)
}
`

LSP_TEST_BREADCRUMB_URI: "file:///w/widget.jet"

// `size` is declared by an impl apart from `Widget`'s body on line 0.
LSP_TEST_BREADCRUMB: `Widget: struct {
    title: String
}

impl Widget {
    size: fn(self) -> Int {
        1
    }
}
`

LSP_TEST_MARKS_URI: "file:///w/marks.jet"

// Line 10 calls `bump`, which writes its first argument; line 11 calls
// `keep`, which takes its only one.
LSP_TEST_MARKS: `bump: fn(count: ^Int, by: Int) {
    count += by
}

keep: fn(title: ^^String) -> Int {
    0
}

run: fn() -> Int {
    ^score: 1
    bump(^score, 2)
    note: "vault"
    keep(note)
    keep(^^note)
}
`

LSP_TEST_FAILURES_URI: "file:///w/failures.jet"

// Four calls of `fail` on lines 5 to 7, each passing its failure up.
LSP_TEST_FAILURES: `fail: fn() -> Int {
    1
}

run: fn() -> Int {
    first: fail()
    second: fail() + fail()
    first + second + fail()
}
`

// Each hint as `line:character label`.
lsp_test_hints: fn(server: ^LSPServer, uri: String, end_line: Int) -> [String] {
    range: "\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":{end_line},\"character\":0}}}}"
    ^hints: [String]{}
    loop row in lsp_test_rows(lsp_test_result(server, "textDocument/inlayHint", "{{{lsp_test_text_document(uri)},{range}}}")) {
        position: lsp_test_field(row, "position")
        hints.push("{lsp_test_int(position, "line")}:{lsp_test_int(position, "character")} {lsp_test_text(row, "label")}")
    }
    hints
}

#Test("inlay hints name the parameter each positional argument binds") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_HINTS_URI, LSP_TEST_HINTS)
    // The range runs past the document's last line and stops at its end.
    assert_eq(lsp_test_hints(server, LSP_TEST_HINTS_URI, 40), [String]{"5:10 value: ", "5:37 value: ", "5:40 low: ", "5:43 high: "})
    // A range over the first line holds none of them.
    assert_eq(lsp_test_hints(server, LSP_TEST_HINTS_URI, 1), [String]{})
}

#Test("inlay hints show a type's methods declared in an impl apart from it") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_BREADCRUMB_URI, LSP_TEST_BREADCRUMB)
    assert_eq(lsp_test_hints(server, LSP_TEST_BREADCRUMB_URI, 9), [String]{"0:6 + size: fn() -> Int"})
}

#Test("calls show unwritten take hints, omit redundant write hints, and mark written names") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_MARKS_URI, LSP_TEST_MARKS)
    assert_eq(lsp_test_hints(server, LSP_TEST_MARKS_URI, 15), [String]{"10:9 count: ", "10:17 by: ", "12:9 title: ^^", "13:9 title: "})
    data: lsp_test_token_data(lsp_test_result(server, "textDocument/semanticTokens/full", "{{{lsp_test_text_document(LSP_TEST_MARKS_URI)}}}"))
    // Each token on line 10 as `line:character:modifiers`; `modification` is
    // bit 4, landing on `score` past the written `^`.
    ^tokens: [String]{}
    ^line: 0
    ^character: 0
    ^at: 0
    loop at + 4 < data.len() {
        if data[at] > 0 -> character = 0
        line += data[at]
        character += data[at + 1]
        if line == 10 -> tokens.push("{line}:{character}:{data[at + 4]}")
        at += 5
    }
    assert_eq(tokens, [String]{"10:4:0", "10:10:4", "10:17:0"})
}

#Test("inlay hints no longer emit faint `?` failure marks") {
    ^server: lsp_test_server()
    lsp_test_open(server, LSP_TEST_FAILURES_URI, LSP_TEST_FAILURES)
    assert_eq(lsp_test_hints(server, LSP_TEST_FAILURES_URI, 9), [String]{})
}

LSPFixAllChecker: struct {
    insert_at: Int,
    delete_at: Int,

    impl LSPChecker {
        check: fn(self, entry: String, overlays: [JetDriverSourceDocument]) -[FS, Env, Exec, IO, Time, Net, FFI.Asm]> LSPChecked Never! {
            ^checked: LSPFixtureChecker{}.check(entry, overlays)
            e0434: Diagnostic{
                code: "E0434",
                severity: DIAGNOSTIC_ERROR,
                what: "`fail` can fail, so the call is written with `?`",
                why: "every call that can pass a failure up writes `?`",
                fix: "write `?` after the call",
                span: Val(Span{start: self.insert_at - 6, end: self.insert_at}),
                edit: Val(TextEdit{span: Span{start: self.insert_at, end: self.insert_at}, new_text: "?"}),
                applicability: Val(DiagnosticFixApplicability.Safe),
            }
            l0537: Diagnostic{
                code: "L0537",
                severity: DIAGNOSTIC_LINT,
                what: "this `?` is unnecessary because this expression cannot fail",
                why: "a bare `?` marks a failure propagation",
                fix: "remove the unnecessary `?`",
                span: Val(Span{start: self.delete_at, end: self.delete_at + 1}),
                edit: Val(TextEdit{span: Span{start: self.delete_at, end: self.delete_at + 1}, new_text: ""}),
                applicability: Val(DiagnosticFixApplicability.Safe),
            }
            checked.diagnostics = [Diagnostic]{e0434, l0537}
            checked
        }

        stage: fn(self, entry: String, overlays: ^^[JetDriverSourceDocument], stage: String, bodies: [Span], program: ^^String) -[FS, Env, Exec, IO, Time, Net, FFI.Asm]> [[JetDriverToolStageItem]] Never! {
            LSPFixtureChecker{}.stage(entry, overlays, stage, bodies, program)
        }

        sources: fn(self, root: String) -[FS]> [JetDriverSourceDocument] Never! {
            LSPFixtureChecker{}.sources(root)
        }
    }
}

#Test("source.fixAll applies safe E0434 and L0537 edits across the document") {
    source: "run: fn() {{\n    a: fail()\n    b: ok()?\n}}\n"
    insert_at: source.find("fail()") + 6
    delete_at: source.find("ok()?") + 4
    ^server: lsp_server(LSPFixAllChecker{insert_at: insert_at, delete_at: delete_at})
    ^_: lsp_test_result(server, "initialize", "{{}}")
    lsp_test_open(server, "file:///w/fixall.jet", source)
    assert_eq(
        lsp_imports_actions(server, "file:///w/fixall.jet", 0, "source.fixAll"),
        [String]{"Apply safe failure and call marks|source.fixAll|true|1:13-1:13 ?;2:11-2:12 "},
    )
}

#Test("completion in a write parameter slot inserts ^name") {
    ^server: lsp_test_server()
    uri: "file:///w/write_slot.jet"
    lsp_test_open(
        server,
        uri,
        `bump: fn(count: ^Int, by: Int) {
    count += by
}

run: fn() {
    ^score: 1
    bump(sco, sco)
    bump(^sco, 2)
}
`,
    )
    first: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 6, 12)))
    assert(first.contains("^score=6"), "write slot offers ^name")
    second: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 6, 17)))
    assert(second.contains("score=6"), "read slot offers plain name")
    marked: lsp_test_labels(lsp_test_result(server, "textDocument/completion", lsp_test_at(uri, 7, 13)))
    assert(marked.contains("score=6"), "already-marked write slot does not double ^")
}

