// Document sync (didOpen, incremental and full didChange), the dirty set the
// loop republishes, and the diagnostics each publication carries.
use {
    jet_lsp.[
        LSPDiagnosticState,
        lsp_diagnostic_groups,
        lsp_diagnostic_state,
        lsp_dirty_documents,
        lsp_document_group_json,
        lsp_member,
        lsp_source_paths_equal,
        lsp_update_document,
    ]
}

lsp_test_change: fn(state: &LSPDiagnosticState, uri: String, version: Int, changes: String) -> String? Never! {
    params: lsp_test_json("{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":{version}}},\"contentChanges\":{changes}}}")
    lsp_update_document(state, Val(params), is_open: false)
}

lsp_test_doc_text: fn(state: LSPDiagnosticState, uri: String) -> String Never! {
    doc: state.docs.get(uri) ?? panic("{uri} is open")
    doc.text.copy()
}

#Test("didOpen stores the document under its path") {
    server := lsp_test_main_server()
    doc: server.diagnostic_state.docs.get(LSP_TEST_MAIN_URI) ?? panic("main is open")
    assert_eq(doc.path, "/w/main.jet")
    assert_eq(doc.version, 1)
    assert_eq(doc.text, LSP_TEST_MAIN)
    assert(!server.diagnostic_state.dirty.has_key(LSP_TEST_MAIN_URI), "opening is not an edit")
    missing: lsp_test_json("{{\"textDocument\":{{\"uri\":\"file:///w/x.jet\",\"version\":1}}}}")
    assert_eq(lsp_update_document(server.diagnostic_state, Val(missing), is_open: true), None)
}

#Test("didChange applies its edits in order and advances the version") {
    state := lsp_diagnostic_state()
    uri: "file:///w/a.jet"
    open: lsp_test_json("{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":1,\"text\":\"hello world\"}}}}")
    assert_eq(lsp_update_document(state, Val(open), is_open: true), Val(uri))
    edits: "[{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":5}}}},\"rangeLength\":5,\"text\":\"goodbye\"}},{{\"range\":{{\"start\":{{\"line\":0,\"character\":13}},\"end\":{{\"line\":0,\"character\":13}}}},\"text\":\"!\"}}]"
    assert_eq(lsp_test_change(state, uri, 2, edits), Val(uri))
    assert_eq(lsp_test_doc_text(state, uri), "goodbye world!")
    assert(state.dirty.has_key(uri), "an edit marks the document dirty")
    assert_eq(lsp_test_change(state, uri, 3, "[{{\"text\":\"fresh\"}}]"), Val(uri))
    assert_eq(lsp_test_doc_text(state, uri), "fresh")
}

#Test("a rejected didChange leaves the document and version intact") {
    state := lsp_diagnostic_state()
    uri: "file:///w/a.jet"
    open: lsp_test_json("{{\"textDocument\":{{\"uri\":\"{uri}\",\"version\":4,\"text\":\"abc\"}}}}")
    _ := lsp_update_document(state, Val(open), is_open: true)
    // A stale version, a wrong rangeLength, a range past the document, and a
    // rangeLength with no range are each refused whole.
    assert_eq(lsp_test_change(state, uri, 4, "[{{\"text\":\"x\"}}]"), None)
    bad_length: "[{{\"text\":\"x\"}},{{\"range\":{{\"start\":{{\"line\":0,\"character\":0}},\"end\":{{\"line\":0,\"character\":1}}}},\"rangeLength\":2,\"text\":\"y\"}}]"
    assert_eq(lsp_test_change(state, uri, 5, bad_length), None)
    past: "[{{\"range\":{{\"start\":{{\"line\":3,\"character\":0}},\"end\":{{\"line\":3,\"character\":0}}}},\"text\":\"y\"}}]"
    assert_eq(lsp_test_change(state, uri, 5, past), None)
    assert_eq(lsp_test_change(state, uri, 5, "[{{\"rangeLength\":1,\"text\":\"y\"}}]"), None)
    assert_eq(lsp_test_change(state, "file:///w/closed.jet", 9, "[]"), None)
    assert_eq(lsp_test_doc_text(state, uri), "abc")
    assert_eq((state.docs.get(uri) ?? panic("open")).version, 4)
    assert(!state.dirty.has_key(uri), "a refused edit is not dirty")
    // An empty change list is accepted and still advances the version.
    assert_eq(lsp_test_change(state, uri, 5, "[]"), Val(uri))
    assert_eq((state.docs.get(uri) ?? panic("open")).version, 5)
}

#Test("draining the dirty set adds the open documents that read a dirty one") {
    server := lsp_test_server()
    lsp_test_open(server, "file:///w/main.jet", "use helper: \"./helper\"\n")
    lsp_test_open(server, "file:///w/helper.jet", "double: fn(x: Int) -> Int {{ x * 2 }}\n")
    lsp_test_open(server, "file:///w/other.jet", "")
    server.diagnostic_state.checked_modules["file:///w/main.jet"] = [String]{"/w/main.jet", "./w/helper.jet"}
    server.diagnostic_state.checked_modules["file:///w/other.jet"] = [String]{"/w/other.jet"}
    _ := lsp_test_change(server.diagnostic_state, "file:///w/helper.jet", 2, "[{{\"text\":\"double: fn(x: Int) -> Int {{ x + x }}\\n\"}}]")
    assert_eq(lsp_dirty_documents(server.diagnostic_state), [String]{"file:///w/helper.jet"})
    server.diagnostic_state.checked_modules["file:///w/main.jet"] = [String]{"/w/main.jet", "/w/helper.jet"}
    _ := lsp_test_change(server.diagnostic_state, "file:///w/helper.jet", 3, "[]")
    assert_eq(lsp_dirty_documents(server.diagnostic_state), [String]{"file:///w/helper.jet", "file:///w/main.jet"})
    assert_eq(lsp_dirty_documents(server.diagnostic_state), [String]{})
}

#Test("source paths compare without leading ./") {
    assert(lsp_source_paths_equal("w/a.jet", "./w/a.jet"), "./ is dropped")
    assert(lsp_source_paths_equal("././a.jet", "a.jet"), "every leading ./ is dropped")
    assert(!lsp_source_paths_equal("w/a.jet", "w/b.jet"), "different files differ")
}

LSP_TEST_BROKEN: "run: fn() {{\n    x: (\n}}\n"

#Test("a publication carries the document's diagnostics and version") {
    server := lsp_test_server()
    uri: "file:///w/broken.jet"
    lsp_test_open(server, uri, LSP_TEST_BROKEN)
    doc: server.diagnostic_state.docs.get(uri) ?? panic("open")
    checked: server.check(doc)
    assert(checked.diagnostics.len() > 0, "the broken fixture has parse diagnostics")
    targets := [String:Bool]{}
    groups: lsp_diagnostic_groups(server.diagnostic_state, uri, checked, targets)
    assert_eq(groups.len(), 1)
    indices: groups[uri]
    assert_eq(indices.len(), checked.diagnostics.len())
    assert(targets.has_key(uri), "the root is a target")
    message: lsp_test_json(lsp_document_group_json(server.diagnostic_state, uri, checked.diagnostics, indices))
    assert_eq(lsp_test_text(message, "method"), "textDocument/publishDiagnostics")
    params: lsp_test_field(message, "params")
    assert_eq(lsp_test_text(params, "uri"), uri)
    assert_eq(lsp_test_int(params, "version"), 1)
    rows: lsp_test_rows(lsp_test_field(params, "diagnostics"))
    assert_eq(rows.len(), checked.diagnostics.len())
    first: rows[0]
    assert_eq(lsp_test_text(first, "source"), "jet")
    assert_eq(lsp_test_int(first, "severity"), 1)
    assert_eq(lsp_test_text(first, "code"), checked.diagnostics[0].code)
    assert(lsp_test_text(lsp_test_field(first, "codeDescription"), "href").starts_with("jet://explain/"), "codes link to their explanation")
}

#Test("a target the previous publication wrote is cleared once no longer reported") {
    server := lsp_test_main_server()
    doc: server.diagnostic_state.docs.get(LSP_TEST_MAIN_URI) ?? panic("open")
    checked: server.check(doc)
    assert_eq(checked.diagnostics.len(), 0)
    previous := [String:Bool]{}
    previous["file:///w/gone.jet"] = true
    server.diagnostic_state.diagnostic_targets[LSP_TEST_MAIN_URI] = previous
    targets := [String:Bool]{}
    groups: lsp_diagnostic_groups(server.diagnostic_state, LSP_TEST_MAIN_URI, checked, targets)
    assert_eq(groups.len(), 2)
    assert_eq(groups["file:///w/gone.jet"].len(), 0)
    clear: lsp_test_json(lsp_document_group_json(server.diagnostic_state, "file:///w/gone.jet", checked.diagnostics, groups["file:///w/gone.jet"]))
    params: lsp_test_field(clear, "params")
    assert_eq(lsp_test_rows(lsp_test_field(params, "diagnostics")).len(), 0)
    assert(lsp_member(params, "version") == None, "a clear of a closed document has no version")
}
