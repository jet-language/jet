// Composed formatter proofs require the complete formatter SCC, not mocks.
use {
    jet_parser.[jet_format_library_source, jet_format_redundant_grouping, jet_format_source, jfmt_format_program_with_tokens, parse_source]
    jet_lexer.[Token, lex]
    jet_foundation.[AST_NODE_GENERATED, Expr, Item, Stmt, TryConvert, expr_span]
}

fmt_core_ok: fn(source: String) -> String { parser_test_format(source) }
fmt_core_stable: fn(source: String) -> String {
    formatted: fmt_core_ok(source)
    assert(fmt_core_ok(formatted) == formatted)
    formatted
}
#Test("trailing_transaction_comment_stays_inside_transaction_block") {
    source: `transfer: fn(from: Shared<Account>, amount: Int) {
    #Transact(tx) {
        from.balance -= amount  // both land, or neither
    }
}
`
    formatted: fmt_core_stable(source)
    comment: parser_test_find(formatted, "// both land, or neither")
    close: parser_test_rfind(formatted, "}}")
    assert(comment < close)
}
#Test("inner_comment_stays_before_enclosing_block_close") {
    formatted: fmt_core_stable("run: fn() {{\n    if ready {{ launch() /* go */ }}\n}}\n")
    assert(parser_test_find(formatted, "/* go */") < parser_test_find(formatted, "}}"))
}
#Test("inferred_braces_and_blocks_round_trip") {
    source: `Point: struct {
    x: Int
    y: Int
}

make: fn() -> Point { {x: 1, y: 2} }

accepts: fn(values: [String]) {}

block: fn() {
    print("block")
}

run: fn() {
    accepts({"needle"})
    p: make()
    block()
}
`
    formatted: fmt_core_stable(source)
    assert(formatted.contains("{{x: 1, y: 2}}"))
    assert(formatted.contains("accepts({{\"needle\"}})"))
    assert(formatted.contains("block: fn() {{"))
}
#Test("repeated_struct_list_heads_preserve_explicit_heads") {
    source: `Point: struct {
    x: Int
}

run: fn() {
    compact := [Point{x: 1}, Point{x: 2}]
    spread := [
        Point{x: 3},
        Point{x: 4},
    ]
}
`
    plain: fmt_core_ok(source)
    fragment: "compact := [Point{{x: 1}}, Point{{x: 2}}]"
    assert(plain.contains(fragment))
    assert(!plain.contains("compact := [Point]"))
    simplified_result: jet_format_source(source, true)
    assert(simplified_result.ok)
    simplified: simplified_result.text
    assert(simplified.contains(fragment))
    assert(!simplified.contains("compact := [Point]"))
    assert_eq(jet_format_source(simplified, true).text, simplified)
}
#Test("failure_formatter_keeps_prefix_and_contextual_roles") {
    formatted: fmt_core_stable("load: fn() -> Int? IOError! {{ read()?(\n    \"loading\"\n) }}\n")
    assert(formatted.contains("load: fn() -> Int? IOError!"))
    assert(formatted.contains("read()?(\"loading\")"))
    source: "load: fn() -> Int IOError! {{ read() }}\n"
    lexed: lex(source.bytes())
    assert(lexed.diagnostics.len() == 0)
    program := parse_source(source.bytes()).program
    if program.items[0] == .Func(function) {
        updated := function
        if updated.body[0] == .Expr(inner) {
            updated.body[0] = Stmt.Expr{expr: Expr.Try{value: inner, span: expr_span(inner), conversion: TryConvert.NoConversion, context: None, id: AST_NODE_GENERATED}}
        } else { panic("expected expression body") }
        program.items[0] = Item.Func{value: updated}
    } else { panic("expected load function") }
    rendered: jfmt_format_program_with_tokens(program, source, [Token]{}, false)
    assert(rendered.contains("read()"))
    assert(!rendered.contains("read()?"))
    assert(fmt_core_ok(rendered) == rendered)
}

// A field's markers format to themselves, so `#Redact` is written once
// however often `jet fmt` runs.
#Test("field_markers_format_to_themselves") {
    loop source in [
        "Login: struct {{\n    user: String\n    #Redact password: String\n}}\n",
        "Login: struct {{\n    #[Redact, Rename(\"pw\")] password: String\n}}\n",
        "Login: struct {{\n    #[Rename(\"pw\"), Redact] password: String\n}}\n",
    ] -> assert_eq(fmt_core_stable(source), source)
}

// The grouping census reports exactly the parens precedence does not need:
// a comparison under a comparison, `&&` under `||`, a prefix operator under
// another, a literal receiver and a pair that spans lines all stay. So do a
// fallback left of `??`, a typed literal that would meet an `if` body, and an
// interpolated string that would become a string pattern.
#Test("redundant_grouping_reports_only_parens_precedence_does_not_need") {
    source: `run: fn(a: Int, b: Int, c: Int, xs: [Int], ok: Bool, o: Int?) {
    p: (a * b) + c
    q: (a + b) * c
    r: a - (b - c)
    s: (a - b) - c
    t: (a < b) == ok
    u: (ok && ok) || ok
    v: -(-a)
    w: (xs.len())
    x: (0..a).len()
    y: (a
        + b)
    z: ((c))
    m: (o ?? a) ?? b
    n: "{a}" == ("{b}x")
    if (I32{1} == b) -> print("one")
    if (ok) { print("{(a + b)}") }
}
`
    spans: jet_format_redundant_grouping(source) ?? panic("census parses its source")
    found: (loop span in spans -> source.slice(span.start..<span.end))
    assert_eq(found, [String]{"(a * b)", "(a - b)", "(xs.len())", "((c))", "(c)", "(ok)", "(a + b)"})
    assert(jet_format_redundant_grouping("run: fn() {{ x: ( }}\n") == None)
}

// The `#!` launch line is no token; it prints byte for byte.
#Test("launch_line_prints_byte_for_byte") {
    assert_eq(fmt_core_stable("#!/usr/bin/env jet\nrun: fn() {{\n    print(1)\n}}\n"), "#!/usr/bin/env jet\nrun: fn() {{ print(1) }}\n")
    assert_eq(fmt_core_stable("#!/usr/bin/env jet\n\n// Tool entry.\n\nrun: fn() {{\n    print(1)\n}}\n"), "#!/usr/bin/env jet\n\n// Tool entry.\n\nrun: fn() {{ print(1) }}\n")
}

// A blank line between a standalone comment and the declaration under it
// stays, so a banner never becomes that declaration's doc comment; a comment
// written against the declaration stays against it.
#Test("banner_comment_keeps_its_blank_line") {
    source: "// --- helpers ---\n\nhelper: fn() -> Int {{ 1 }}\n\n// --- entry ---\n\n// Prints the helper.\nrun: fn() {{ print(helper()) }}\n"
    assert_eq(fmt_core_stable(source), source)
    member: "Point: struct {{\n    // --- position ---\n\n    x: Int\n    // The height.\n    y: Int\n}}\n"
    assert_eq(fmt_core_stable(member), member)
}

// A multiline argument or parameter list puts each entry one level in and its
// closer back at the list's own indent, a text-block argument included.
#Test("multiline_lists_indent_their_entries_one_level") {
    source: `show: fn(
    text: String,
    n: Int,
) { print(text) }

run: fn() {
    show(
        """
        hello
        """,
        2,
    )
    twice(
        () -> {
            print("HI")
            print("Hello")
        },
    )
}
`
    assert_eq(fmt_core_stable(source), source)
    assert_eq(fmt_core_stable("run: fn() {{\n    twice(() -> {{\n        print(\"HI\")\n        print(\"Hello\")\n    }})\n}}\n"), "run: fn() {{\n    twice(\n        () -> {{\n            print(\"HI\")\n            print(\"Hello\")\n        }},\n    )\n}}\n")
}

// A lambda whose body is one statement written after `->` keeps its line,
// so the call around it stays on one line too.
#Test("written_lambda_statement_keeps_its_line") {
    source: "run: fn() {{\n    store.transaction(\"x\", (n: &Int) -> n += 1)\n    store.each((n) -> total += n)\n}}\n"
    assert_eq(fmt_core_stable(source), source)
}

// fmt keeps the order the author wrote: a named tuple type's fields stay in
// source order, and a wrapped `loop … in` head gains no comma.
#Test("fmt_keeps_tuple_field_order_and_adds_no_comma_to_a_wrapped_loop_head") {
    tuple: "run: fn() {{\n    cases: [(path: String, replacement: String, original: String)]{{}}\n    print(cases.len())\n}}\n"
    assert_eq(fmt_core_stable(tuple), tuple)
    nested: "f: fn(x: (p: [Int], b: (z: Int, a: Int))) {{\n    print(x)\n    print(x)\n}}\n"
    assert_eq(fmt_core_stable(nested), nested)
    looped: fmt_core_stable("run: fn() {{\n    loop directory in ([String]{{\"{{package}}/src\", \"{{root}}/.jet\", \"{{package}}/.jet\", \"{{package}}/.jet/generated\"}}) {{\n        print(directory)\n    }}\n}}\n")
    assert(!looped.contains("), {{"), "a wrapped loop head ends without a comma")
    assert(looped.contains("loop directory in"), "the loop head is kept")
}

// Core library and compiler prelude sources spell reserved `__` names; they
// format in the reserved lane, and a user source with the same text is E0067.
#Test("library_sources_format_in_the_reserved_lane") {
    source: "// A Core library source may spell reserved names.\n__probe_value: 1\n\nprobe: fn() -> Int {{ __probe_value }}\n"
    library: jet_format_library_source(source, false)
    assert(library.ok, "a library source formats: {library.diagnostics:Debug}")
    assert_eq(library.text, source)
    user: jet_format_source(source, false)
    assert(!user.ok, "a user source may not spell a reserved name")
    reserved := false
    loop diagnostic in user.diagnostics {
        if diagnostic.code == "E0067" -> reserved = true
    }
    assert(reserved, "the user source reports E0067")
}

// An empty struct or enum body stays `{}` on its header line; a body that
// holds only a comment keeps the comment.
#Test("empty_type_bodies_stay_on_the_header_line") {
    source: "Meter: struct {{}}\n\nPer: struct<A, B> {{}}\n\nNothing: enum {{}}\n\nNoted: struct {{\n    // filled in later\n}}\n"
    formatted: jet_format_source(source, false)
    assert(formatted.ok, "the source formats: {formatted.diagnostics:Debug}")
    assert_eq(formatted.text, source)
    spread: jet_format_source("Meter: struct {{\n\n}}\nNothing: enum {{\n}}\n", false)
    assert_eq(spread.text, "Meter: struct {{}}\n\nNothing: enum {{}}\n")
}
