#Test("formatter_utf8_comments_and_source_extents") {
    fmt_expr_keeps(`fn run() {
    label :: "é🙂"
    out :: label
        .trim()  // ── étape ──
        .to_upper()
    result :: if label == {
        "é🙂" -> { /* 中文 */ 1 }
        else -> 0
    }
}
`, [String]{`"é🙂"`, `// ── étape ──`, `/* 中文 */`})
}
#Test("formatter_task_combinators_keep_named_branches") {
    fmt_expr_keeps(`fn run() {
    all :: task.all { first: 1, second: {
        value :: 2
        value
    } }
    any :: task.any { 1, 2 }
    race :: task.race { 1, 2 }
    timeout :: task.timeout(500ms)
}
`, [String]{`task.all {first: 1, second: {`, `task.any {1, 2}`, `task.race {1, 2}`, `task.timeout(500ms)`})
}
#Test("formatter_generic_argument_comments_retain_source_order") {
    fmt_expr_keeps(`fn run() {
    result :: build<
        /* first type */ Int,
        /* second type */ String,
    >(
        /* argument */ 1,
    )
}
`, [String]{`/* first type */`, `/* second type */`, `/* argument */`})
}
