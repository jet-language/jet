#Test("fmt_compact_result_handler_is_one_line_when_it_fits") {
    fmt_expr_keeps("fn pick(value: Int String!) -> String -> value ? ok -> ok ! error -> error\n", [String]{"value ? ok -> ok ! error -> error"})
}
#Test("fmt_compact_result_handler_expands_long_branches_deterministically") {
    ok :: "ok_value_abcdefghijklmnopqrstuvwxyz_abcdefghijklmnopqrstuvwxyz_abcdefghijklmnopqrstuvwxyz"
    err :: "error_value_abcdefghijklmnopqrstuvwxyz_abcdefghijklmnopqrstuvwxyz_abcdefghijklmnopqrstuvwxyz"
    out :: fmt_expr_keeps("fn pick(value: Int String!) -> String -> value ? ok -> {ok} ! error -> {err}\n", [String]{"\n! error ->", "-> {{"})
    assert(!out.contains("->{{"))
}
#Test("fmt_result_handler_expands_blocked_nested_and_commented_branches") {
    cases :: [String]{
        `fn pick(value: Int String!) -> String -> value ? ok -> {
    saved :: ok
    saved
} ! error -> {
    saved_error :: error
    saved_error
}
`,
        "fn pick(value: Int String!) -> Int -> value ? ok -> value ? inner -> inner ! inner_error -> inner_error ! error -> 0\n",
        "fn pick(value: Int String!) -> Int -> value ? ok -> if ready -> 1 else -> 2 ! error -> 0\n",
        "fn pick(value: Int String!) -> String -> value ? ok -> ok /* keep this branch readable */ ! error -> error\n",
        "fn pick(value: Int String!) -> String -> value ? ok -> ok ! error -> error /* keep failure readable */\n",
    }
    loop source in cases {
        out :: fmt_expr_keeps(source, [String]{"\n! error ->", "-> {{"})
        assert(!out.contains("->{{"))
        if source.contains("keep this branch readable") -> assert(out.contains("ok  /* keep this branch readable */"))
        if source.contains("keep failure readable") -> assert(out.contains("error  /* keep failure readable */"))
    }
}
