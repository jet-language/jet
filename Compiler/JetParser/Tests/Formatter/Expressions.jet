#Test("fmt_concurrency_spellings_that_parse_today") {
    fmt_expr_keeps(`fn inspect(handle: Task<Int>, group: Group, rx: Receiver<Int>, tx: Sender<Int>) -> TaskFailure {
    joined :: handle.join()
    cancelled :: .Cancelled
    deadline :: .DeadlineBlown
    loop value in rx -> tx.send(value)
    return .Panicked("boom")
}

fn open() {
    pair :: channel<Int>(capacity: 8)
    plain :: task { 1 }
    frozen :: freeze(1)
    task.group g {
        child :: task ^frozen { frozen }
        child.join() ?? 0
    }
}
`, [String]{"Task<Int>", "Group", "Receiver<Int>", "Sender<Int>", "TaskFailure", "handle.join()", ".Cancelled", ".DeadlineBlown", "loop value in rx", `.Panicked("boom")`, "channel<Int>(capacity: 8)", `plain :: task { 1 }`, "freeze(1)", "task ^frozen"})
}
#Test("fmt_loop_values_and_yielding_loops_are_idempotent") {
    out :: fmt_expr_keeps(`fn find(xs: [Int]) -> Int {
    found :: loop {
        loop x in xs {
            if x > 2 { break(found, x) }
        }
        break -1
    }
    found
}

fn run() {
    xs :: [Int]{ 1, 2, 3, 4 }
    values :: loop x in xs -> {
        if x > 3 { break }
        x * 2
    }
    print(values)
}
`, [String]{"found :: loop", "break(found, x)", "values :: loop x in xs ->"})
    assert(!out.contains("__jet_"))
    guard :: `fn run() {
    values :: loop u in users if u.active -> u.name
}
`
    assert_eq(fmt_expr_keeps(guard, [String]{"loop u in users if u.active -> u.name"}), guard)
}
#Test("subjectless_guards_preserve_tokens_and_are_byte_stable") {
    source :: `fn run() {
    ready :: true
    if ready -> print("inline")
    if {
        ready -> print("ready")
        false -> print("never")
    }
    label :: if {
        ready -> "ready"
        else -> "waiting"
    }
    print(label)
}
`
    assert_eq(fmt_expr_keeps(source, [String]{`else -> "waiting"`}), source)
}

