// Rust tests/fmt.rs expression/type/pattern regressions. The shared entry
// admits lexer/parser failures explicitly and never returns the authored source.
use jet_parser.[jet_format_source, jet_format_canonical_program, parse_for_fmt]
use jet_lexer.[lex]

fn fmt_expr_identity(source: String) -> [U8] Never! {
    lexed :: lex(source.bytes())
    assert_eq(lexed.diagnostics.len(), 0)
    parsed :: parse_for_fmt(lexed.tokens)
    program :: parsed.program ?? panic("formatter fixture must parse")
    jet_format_canonical_program(program)
}
fn fmt_expr_keeps(source: String, needles: [String]) -> String Never! {
    before :: fmt_expr_identity(source)
    result :: jet_format_source(source)
    assert_eq(result.diagnostics.len(), 0)
    once :: result.source ?? panic("formatter fixture must format")
    loop needle in needles -> assert(once.contains(needle), "formatter dropped {needle}")
    assert_eq(before, fmt_expr_identity(once))
    again :: jet_format_source(once)
    assert_eq(again.diagnostics.len(), 0)
    assert_eq(again.source, Val(once))
    once
}
fn fmt_expr_stable(source: String) Never! { fmt_expr_keeps(source, [String]{}) }

#Test("fixed_interpolation_selector_is_stable") {
    source :: `fn run(){price::1234.5
print("{price:Fixed(2)}")}
`
    expected :: `fn run() {
    price :: 1234.5
    print("{price:Fixed(2)}")
}
`
    assert_eq(fmt_expr_keeps(source, [String]{`{price:Fixed(2)}`}), expected)
}
#Test("grouped_interpolation_selector_is_stable") {
    source :: `fn run(){price::1234.5
print("{price:Grouped(2)}") }
`
    expected :: `fn run() {
    price :: 1234.5
    print("{price:Grouped(2)}")
}
`
    assert_eq(fmt_expr_keeps(source, [String]{`{price:Grouped(2)}`}), expected)
}
