#Test("synthetic_declarations_render_real_ast_without_source_passthrough") {
    source :: "trait Shape: [Show, Hash] {{ type Elem fn width(self) -> Int }}\nstruct Size {{ width: Int }}\nimpl Size.Shape {{ type Elem = Int fn width(self) -> Int {{ return self.width }} }}\nfn run() {{}}\n"
    tokens :: lex(source.bytes())
    program :: parse_for_fmt(tokens.tokens).program ?? panic("synthetic source did not parse")
    output :: jet_format_synthetic_program(program)
    assert(output.contains("trait Shape: [Show, Hash]"))
    assert(output.contains("type Elem = Int"))
    assert(output.contains("width: Int"))
    assert_eq(item_test_identity(source), item_test_identity(output))
    assert_eq(item_test_format(output), item_test_format(item_test_format(output)))
}

#Test("trait_operator_bound_diagnostic_and_byte_span_are_exact") {
    tokens :: lex("trait Broken: Add<Int, String> {{}}\n".bytes())
    parsed :: parse_for_fmt(tokens.tokens)
    assert_eq(parsed.diagnostics.len(), 1)
    diagnostic :: parsed.diagnostics[0]
    assert_eq(diagnostic.code, "E0003")
    assert_eq(diagnostic.what, "operator bound `Add` accepts exactly one RHS type")
    assert_eq(diagnostic.why, "an operator bound names one right-hand operand")
    assert_eq(diagnostic.fix, "write one type between `<` and `>`")
    assert_eq(diagnostic.span, Val(Span{start: 21, end: 22}))
}
#Test("trait_quantity_kind_diagnostic_and_byte_span_are_exact") {
    tokens :: lex("trait Broken: Quantity<Length, .Unknown> {{}}\n".bytes())
    parsed :: parse_for_fmt(tokens.tokens)
    assert_eq(parsed.diagnostics.len(), 1)
    diagnostic :: parsed.diagnostics[0]
    assert_eq(diagnostic.code, "E0003")
    assert_eq(diagnostic.what, "`.Unknown` is not a quantity kind")
    assert_eq(diagnostic.why, "Quantity bounds distinguish linear values, affine points, and affine deltas")
    assert_eq(diagnostic.fix, "use `.Linear`, `.Point`, or `.Delta`")
    assert_eq(diagnostic.span, Val(Span{start: 32, end: 39}))
}
#Test("trait_generic_bound_does_not_accept_a_missing_closer") {
    tokens :: lex("trait Broken: Add<Int {{}}\n".bytes())
    parsed :: parse_for_fmt(tokens.tokens)
    assert_eq(parsed.diagnostics.len(), 1)
    diagnostic :: parsed.diagnostics[0]
    assert_eq(diagnostic.code, "E0003")
    assert(diagnostic.what.starts_with("expected `>` after the operator bound"))
    assert_eq(diagnostic.why, "close a generic type with `>` — nested types may end with `>>`")
    assert_eq(diagnostic.fix, "add `>` here")
    assert_eq(diagnostic.span, Val(Span{start: 22, end: 23}))
}

// fmt_round_trip_regressions.rs:73-95, original complete module/library fixtures.
#Test("generic_module_and_library_bodies_round_trip_retired_signatures") {
    item_test_keeps("// D-CONF-GENSPELL1=A: generic module templates and aliases.\n//\n// A generic module is a module template parameterised by types and values.\n// `module cache<K>(capacity: Int)` defines the template; `module int_cache :: cache<Int>(32)`\n// instantiates it, producing a concrete module with all type params resolved.\nmodule cache<K>(capacity: Int) {{\n    BASE :: prep {{ capacity }}\n\n    COMPUTED_SIZE :: prep {{ BASE + 1 }}\n\n    pub struct Entry {{\n        key: K\n        limit: Int -> capacity\n    }}\n\n    pub enum Slot {{\n        Empty\n        Value(K)\n    }}\n\n    pub fn entry(k: K) -> Entry {{ return Entry{{key: k}} }}\n\n    pub fn slot(k: K) -> Slot {{ Slot.Value(k) }}\n\n    pub fn key_of(k: K) -> String {{ return \"key\" }}\n\n    pub fn describe() -> String {{ \"generic cache\" }}\n\n    pub fn size() -> Int {{ COMPUTED_SIZE }}\n}}\n\n// Forward alias chain: declaration order does not affect resolution.\nmodule forward_cache :: int_cache\n\nmodule int_cache :: cache<Int>(32)\n\nenum Mode {{\n    Fast\n    Safe\n}}\n\nmodule tier_zero(flag: Bool, count: Int, letter: Char, label: String, mode: Mode) {{\n    // A marker argument is fixed metadata; module value parameters reach the\n    // body, not the marker.\n    #Meta(category: \"tier zero\")\n    pub fn show() {{\n        print(flag)\n        print(count)\n        print(letter)\n        print(label)\n        print(mode == Mode.Fast)\n    }}\n}}\n\nmodule values :: tier_zero(true, 7, 'J', \"jet\", Mode.Fast)\n\ntrait Token {{\n}}\n\nstruct GoodToken {{\n\n}}\n\nimpl GoodToken.Token {{\n\n}}\n\n// The annotation decides the kind: `Item` is a type slot because `Token` is a\n// trait, while `count` is an `Int` value slot. Their spelling follows that kind.\nmodule annotation_kinds<Item: Token>(count: Int) {{\n    pub fn count() -> Int {{ count }}\n}}\n\nmodule kinds :: annotation_kinds<GoodToken>(8)\n\nmodule fixed_buffer<T>(capacity: Int) {{\n    pub struct Buffer {{\n        items: [T#capacity]\n    }}\n\n    pub fn echo(values: [T#capacity]) -> [T#capacity] {{ return ~values }}\n}}\n\nmodule three_ints :: fixed_buffer<Int>(3)\n\nmodule local_laws<T> {{\n    pub trait Reveal {{\n        type Output\n        fn reveal(self) -> T\n    }}\n\n    pub struct Wrapped {{\n        value: T\n    }}\n\n    impl Wrapped.Reveal {{\n        type Output = T\n\n        fn reveal(self) -> T {{ self.value }}\n    }}\n\n    pub enum SourceErr {{\n        Bad(T)\n    }}\n\n    pub enum TargetErr {{\n        Wrapped(SourceErr)\n    }}\n\n    impl SourceErr -> TargetErr {{ return TargetErr.Wrapped(self) }}\n}}\n\nmodule int_laws :: local_laws<Int>\n\nfn run() {{\n    k :: int_cache.key_of(42)\n    d :: int_cache.describe()\n    n :: int_cache.size()\n    e :: int_cache.entry(42)\n    s :: int_cache.slot(7)\n    print(k)\n    print(d)\n    print(n)\n    print(e.key)\n    print(e.limit)\n    forwarded :: forward_cache.entry(9)\n    print(forward_cache.size())\n    print(forwarded.key)\n    if s == {{\n        .Value(v) -> {{ print(v) }}\n        .Empty -> {{ print(0) }}\n    }}\n\n    values.show()\n    print(kinds.count())\n    input :: [Int#3]{{1, 2, 3}}\n    fixed :: three_ints.echo(input)\n    buffer :: three_ints.Buffer{{items: fixed}}\n    print(buffer.items[2])\n    wrapped :: int_laws.Wrapped{{value: 91}}\n    print(wrapped.reveal())\n}}\n", ["pub fn slot(k: K) -> Slot {{", "Slot.Value(k)"])
    item_test_keeps("// E2-M6: library authoring ergonomics\n// Demonstrates S61 (labels/defaults), S62 (delegation), S77 (field punning),\n// D-LIB2 (default method bodies), D-LIB3 (declared ! conversion).\n// --- S61: argument labels and trailing defaults ---\nfn greet(name: String, loud: Bool{{false}}) -> String {{\n    if loud -> return \"HELLO {{name}}!\"\n    return \"hello {{name}}.\"\n}}\n\n// --- D-LIB2: trait with a default method body ---\ntrait Greetable {{\n    fn greeting(self) -> String\n    fn announce(self) -> String {{\n        g :: self.greeting()\n        return \"[ {{g}} ]\"\n    }}\n}}\n\nstruct Person {{\n    name: String\n}}\n\nimpl Person.Greetable {{\n    fn greeting(self) -> String {{\n        n :: self.name\n        return \"hi, I'm {{n}}\"\n    }}\n}}\n\n// `announce` uses the default from the trait\n// --- S77: field punning ---\nstruct Point {{\n    x: Int\n    y: Int\n}}\n\nfn make_point(x: Int, y: Int) -> Point {{\n    return Point{{x: x, y: y}}  // S77 puns: x:x, y:y\n}}\n\n// --- S62: trait delegation ---\ntrait Logger {{\n    fn log(self, msg: String)\n}}\n\nstruct ConsoleLogger {{\n    prefix: String\n}}\n\nimpl ConsoleLogger.Logger {{\n    fn log(self, msg: String) {{\n        p :: self.prefix\n        print(\"{{p}}: {{msg}}\")\n    }}\n}}\n\nstruct App {{\n    logger: ConsoleLogger\n}}\n\nimpl App.Logger using logger  // S62: forwards Logger methods to `logger`\n\nfn run() {{\n    // S61 labels + defaults\n    print(greet(\"world\"))\n    print(greet(\"world\", true))\n    // D-LIB2 default method body\n    p :: Person{{name: \"Ada\"}}\n    print(p.greeting())\n    print(p.announce())\n    // S77 field punning\n    pt :: make_point(3, 4)\n    print(pt.x)\n    print(pt.y)\n    // S62 delegation\n    app :: App{{logger: ConsoleLogger{{prefix: \"INFO\"}}}}\n    app.log(\"delegation works\")\n}}\n", ["fn greeting(self) -> String\n"])
}
