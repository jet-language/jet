#Test("fmt_empty_marker_parentheses_canonicalize_and_are_stable") {
    output :: item_test_stable("#Inline()\nfn double(x: Int) -> Int {{\n    return x * 2\n}}\n\n#Job()\nfn refresh() {{\n    print(\"refresh\")\n}}\n")
    assert(output.contains("#Inline fn double") || output.contains("#Inline\nfn double"))
    assert(!output.contains("#Inline()") && !output.contains("#Job()"))
}

// fmt_round_trip_regressions.rs:22-42,133-181.
#Test("generic_module_template_struct_heads_round_trip") {
    output :: item_test_stable("module cache<K>(capacity: Int) {{\n    struct Entry {{ key: K }}\n    fn entry(k: K) -[]> Entry {{ return Entry{{key: k}} }}\n}}\n\n")
    assert(output.contains("Entry{{"))
    assert(!output.contains("Entry.{{"))
}
#Test("inline_module_struct_heads_round_trip") {
    output :: item_test_stable("module arith {{\n    struct Tally {{ total: Int }}\n    fn tally(value: Int) -[]> Tally {{ return Tally{{total: value}} }}\n}}\n")
    assert(output.contains("Tally{{"))
    assert(!output.contains("Tally.{{"))
}
#Test("effect_arrows_round_trip_beside_foreign_bodies") {
    output :: item_test_stable("#Import module c.demo {{\n    fn probe(value: Int) -> Int = \"probe\"\n}}\n\nfn run() -[IO]> Int {{\n    return 1\n}}\n")
    assert(output.contains("fn probe(value: Int) -> Int = \"probe\""))
    assert(output.contains("fn run() -[IO]> Int"))
    assert(!output.contains("=[IO]=>") && !output.contains("Int) => Int"))
}

// Items.rs source-order regression witnesses: Unicode offsets/comments belong
// to the next authored member, not to a later vector category.
#Test("type_body_members_preserve_authored_interleaving_and_comments") {
    item_test_order("#CLI\nstruct Commands {{\n    // λ before method\n    fn before(self) {{}}\n    // 命 before field\n    first: Int\n    // before impl\n    impl Show {{ fn show(self) -> String {{ \"ok\" }} }}\n    // before CLI binding\n    plan = plan_impl\n    // before validation\n    validate {{ assert(true) }}\n    second: Int\n    fn after(self) {{}}\n}}\nfn plan_impl(args: Commands) {{}}\n", ["// λ before method", "fn before", "// 命 before field", "first:", "// before impl", "impl Show", "// before CLI binding", "plan =", "// before validation", "validate {{", "second:", "fn after"])
}
#Test("impl_associated_types_preserve_authored_interleaving") {
    item_test_order("impl Collection {{\n    fn before(self) {{}}\n    // Elem belongs here\n    type Elem = Int\n    fn after(self) {{}}\n    type Other = String\n}}\n", ["fn before", "// Elem belongs here", "type Elem = Int", "fn after", "type Other = String"])
}
#Test("module_imports_and_items_preserve_authored_interleaving") {
    item_test_order("module bank {{\n    fn before() {{}}\n    // local import\n    use core.math as math\n    VALUE :: 1\n    fn after() {{}}\n    // tail λ\n}}\n", ["fn before", "// local import", "use core.math", "VALUE ::", "fn after", "// tail λ"])
}
#Test("trait_supertraits_round_trip_bare_list_operator_quantity") {
    item_test_keeps("trait Single: Show {{ fn display(self) -> String }}\ntrait Multiple: [Show, Hash] {{ type Elem fn at(self) -> Elem }}\ntrait Operator: Add<Int> {{}}\ntrait Measured: Quantity<Length, .Linear> {{}}\n", ["trait Single: Show", "trait Multiple: [Show, Hash]", "trait Operator: Add<Int>", "trait Measured: Quantity<Length, .Linear>"])
}

// Canonical Foundation resolver and name seam tests (not source-shape assertions).
#Test("decode_wire_shapes_alias_substitution_cycles_and_ambiguity") {
    span :: Span{start: 0, end: 0}
    generic :: TypeParam{name: "T", name_span: span, bounds: [String]{}, prep: None}
    alias :: TypeAliasDef{is_pub: false, is_package_pub: false, name: "Alias", name_span: span, type_params: [TypeParam]{generic}, target: Type.Option{inner: Type.Named{name: "T"}}, target_span: span, span: span}
    cycle :: TypeAliasDef{is_pub: false, is_package_pub: false, name: "Cycle", name_span: span, type_params: [TypeParam]{}, target: Type.Named{name: "Cycle"}, target_span: span, span: span}
    items :: [Item]{Item.TypeAlias{value: alias}, Item.TypeAlias{value: cycle}}
    assert_eq(resolved_decode_wire_shapes(items, Type.Apply{name: "Alias", args: [Type]{Type.String}}), Val([SerdeWireShape]{SerdeWireShape.Null, SerdeWireShape.Text}))
    assert_eq(resolved_decode_wire_shapes(items, Type.Named{name: "Cycle"}), None)
    assert_eq(resolved_decode_wire_shapes(items, Type.Union{members: [Type]{Type.Char, Type.String}}), Val([SerdeWireShape]{SerdeWireShape.Text}))
    assert_eq(resolved_decode_wire_shapes(items, Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}), None)
}
#Test("decode_wire_shapes_tagged_untagged_and_generic_enum") {
    span :: Span{start: 0, end: 0}
    definition := ast_enum("Envelope", span, span)
    &definition.derives.push(NamedSpan{name: "Decode", span: span})
    &definition.type_params.push(TypeParam{name: "T", name_span: span, bounds: [String]{}, prep: None})
    &definition.variants.push(Variant{name: "Empty", name_span: span, payload: VariantPayload.Unit, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
    &definition.variants.push(Variant{name: "Value", name_span: span, payload: VariantPayload.Single{ty: Type.Named{name: "T"}, span: span}, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
    assert_eq(resolved_decode_wire_shapes([Item]{Item.Enum{value: definition}}, Type.Apply{name: "Envelope", args: [Type]{Type.Int}}), Val([SerdeWireShape]{SerdeWireShape.Text, SerdeWireShape.Object}))
    &definition.serde_markers.push(Marker{name: "Untagged", negated: false, name_span: span, args: [MarkerCallArg]{}, arg_labels: [], span: span, ct: None})
    assert_eq(resolved_decode_wire_shapes([Item]{Item.Enum{value: definition}}, Type.Apply{name: "Envelope", args: [Type]{Type.Int}}), Val([SerdeWireShape]{SerdeWireShape.Null, SerdeWireShape.Int, SerdeWireShape.Number}))
    &definition.serde_markers.push(Marker{name: "Discriminant", negated: false, name_span: span, args: [MarkerCallArg]{}, arg_labels: [], span: span, ct: None})
    assert_eq(resolved_decode_wire_shapes([Item]{Item.Enum{value: definition}}, Type.Apply{name: "Envelope", args: [Type]{Type.Int}}), Val([SerdeWireShape]{SerdeWireShape.Object}))
}
#Test("generated_paths_are_injective_across_identity_separators") {
    identities :: [String]{"a::b", "a/b", "a\\b", "a_b", "a.b", "a-b", "a:x", "λ.命"}
    symbols := [String]{}
    loop identity in identities {
        symbol :: foundation_generated_path(identity)
        assert(!symbols.contains(symbol))
        &symbols.push(symbol)
        assert_eq(foundation_decode_generated_path_suffix(symbol.slice(6, symbol.len())), Val(identity))
    }
    assert_eq(foundation_member_name("bank", "open"), "__jet_bank_dopen")
    assert_eq(foundation_member_name("__jet_bank", "open"), "__jet_bank_dopen")
    assert_eq(foundation_decode_generated_path_suffix("broken_xQ0"), None)
    assert_eq(foundation_decode_generated_path_suffix("_xff"), None)
}
#Test("callable_marker_line_break_projection") {
    names :: [String]{"Meta", "Unsafe", "FFI", "Target", "WasmExport"}
    loop name in names -> assert(callable_marker_needs_line_break(name))
    assert(!callable_marker_needs_line_break("Inline"))
    assert(!callable_marker_needs_line_break("Unknown"))
}

// Original typed-template fixtures: fmt_round_trip_regressions.rs:45-70.
// Named-body expectations reconciled by Main to D-SIG-AFTER1=A, not weakened.
#Test("derive_template_bodies_round_trip_retired_signatures") {
    item_test_keeps("// D-STRUCT-ONCE1=A: one typed `prep loop` mechanism reaches derive/marker bodies,\n// root impl items, and interpolated test declarations.\nderive T.FieldNames {{\n    prep loop field in T.$fields {{\n        method :: \"field_{{field.$name}}\"\n        fn $method(self) -> String {{ field.$name }}\n    }}\n}}\n\nmarker AddMarkerFields($sites: [.Type]) {{\n    type_name :: target.$name\n    prep loop field in target.$fields {{\n        method :: \"marked_{{field.$name}}\"\n        impl $type_name {{\n            fn $method(self) -> String {{ field.$name }}\n        }}\n    }}\n}}\n\n#[FieldNames, AddMarkerFields]\nstruct Point {{\n    x: Int\n    y: Int\n}}\n\nstruct Case {{\n    n: Int\n}}\n\nCASES :: prep {{ [Case]{{Case{{n: 1}}, Case{{n: 2}}}} }}\n\nprep loop T in [Point] {{\n    impl T {{\n        fn generated(self) -> String {{ \"generated\" }}\n    }}\n}}\n\nprep loop case in CASES {{\n    #Test(\"case {{case.n}}\") {{\n        .measure {{\n            assert(case.n > 0)\n        }}\n    }}\n}}\n\nfn run() {{\n    point := Point{{x: 1, y: 2}}\n    print(point.field_x())\n    print(point.field_y())\n    print(point.marked_x())\n    print(point.marked_y())\n    print(point.generated())\n}}\n", ["fn $method(self) -> String {{", "field.$name", "prep loop T in [Point]", "#Test(\"case {{case.n}}\")"])
}
#Test("marker_template_bodies_round_trip_retired_signatures") {
    item_test_keeps("// D-META-USER1=A: a source rule with a body adds an ordinary method. A\n// template binding is spliced with `$` (D-NAME-SPLICE1=B): `impl $tname`\n// names the target type and `$marker_count` reads the build-time value.\nmarker Audited($sites: [.Type])\n\nmarker AddGreeting($sites: [.Type]) {{\n    tname :: target.name\n    marker_count :: target.markers.len()\n    impl $tname {{\n        fn greeting(self) -> String {{ \"hello\" }}\n\n        fn marker_count(self) -> Int {{ $marker_count }}\n    }}\n}}\n\n#[Audited, AddGreeting]\nstruct Person {{\n    name: String\n}}\n\nfn run() {{\n    person :: Person{{name: \"ada\"}}\n    print(person.greeting())\n    print(person.marker_count())\n}}\n", ["fn greeting(self) -> String {{", "\"hello\"", "impl $tname", "$marker_count"])
}
#Test("fmt_comptime_splice_stability") {
    _ :: item_test_stable("derive T.Debug {{\n    fn tag(self) -> String -> \"ok\"\n}}\n\nfn run() {{\n    print(\"ok\")\n}}\n")
    item_test_keeps("derive T.Named {{\n    tname :: \"test\"\n    x :: $tname\n    fn $tname(self) -> String -> $tname\n}}\n\nfn run() {{}}\n", ["x :: $tname", "fn $tname(self)"])
}
