// Declaration regressions ported from tests/fmt.rs and fmt_round_trip_regressions.rs.
// All fixtures go through the real formatter SCC and canonical Foundation AST.
use jet_parser.[jet_format_source, jet_format_synthetic_program, jet_format_canonical_program, parse_for_fmt]
use jet_lexer.[lex]
use jet_foundation.[Item, Type, TypeParam, NamedSpan, Span, SerdeWireShape, TypeAliasDef, Variant, VariantPayload, Marker, MarkerCallArg, ast_enum, ast_struct, resolved_decode_wire_shapes, foundation_generated_path, foundation_member_name, foundation_decode_generated_path_suffix, callable_marker_needs_line_break]

fn item_test_format(source: String) -> String Never! { jet_format_source(source).source ?? panic("declaration fixture did not format") }
fn item_test_identity(source: String) -> [U8] Never! {
    tokens :: lex(source.bytes())
    assert_eq(tokens.diagnostics.len(), 0)
    parsed :: parse_for_fmt(tokens.tokens)
    jet_format_canonical_program(parsed.program ?? panic("declaration fixture did not parse"))
}
fn item_test_stable(source: String) -> String Never! {
    output :: item_test_format(source)
    assert_eq(item_test_identity(source), item_test_identity(output))
    assert_eq(output, item_test_format(output))
    output
}
fn item_test_keeps(source: String, needles: [String]) Never! {
    output :: item_test_stable(source)
    loop needle in needles -> assert(output.contains(needle))
}
fn item_test_order(source: String, needles: [String]) Never! {
    output :: item_test_stable(source)
    previous := -1
    loop needle in needles {
        offset :: output.index_of(needle) ?? panic("source-ordered member lost")
        assert(offset > previous)
        previous = offset
    }
}

// tests/fmt.rs:59-83,226-255,279-315,347-353.
#Test("type_alias_binding_sigils_are_canonical_and_idempotent") {
    output :: item_test_stable("alias Result<T> :: T Int!;\nfn run() {{}}\n")
    assert(output.contains("alias Result<T> :: T Int!"))
    assert(!output.contains("alias Result<T> ="))
}
#Test("fmt_preserves_module_declaration_and_function_source_order") {
    item_test_order("MESSAGE :: \"module global\"\n\nfn helper() -> Int {{\n    return 42\n}}\n\nfn run() {{\n    print(MESSAGE)\n    print(helper())\n}}\n", ["MESSAGE ::", "fn helper", "fn run"])
}
#Test("fmt_preserves_root_receiver_declarations") {
    item_test_keeps("fn show(#Root value: Int) {{ print(value) }}\n", ["fn show(#Root value: Int)"])
}
#Test("fmt_canonicalizes_unit_return_types") {
    item_test_keeps("fn run() Err! {{ return Err(\"boom\") }}\n", ["fn run() Err!"])
    assert(jet_format_source("fn run() ? {{ return Err(\"boom\") }}\n").source == None)
    assert(jet_format_source("fn run() => Void ! {{ return Err(\"boom\") }}\n").source == None)
}
#Test("repr_c_enum_surface_is_stable") {
    item_test_keeps("#Layout(c, tag: U8)\nenum Packet {{ Ping(Int) = 3; Data(x: I32, y: I32) = 7 }}\n", ["#Layout(c, tag: U8)", "Ping(Int) = 3", "Data(x: I32, y: I32) = 7"])
}
#Test("computed_declaration_values_format_stably") {
    item_test_keeps("LANES :: prep {{ 2 }}\nBASE :: prep {{ 40 }}\nstruct Frame {{ values: [Int#(LANES * 2)] }}\n#Layout(c, tag: U8) enum Code {{ First = BASE + 1 Second }}\n", ["[Int#(LANES * 2)]", "First = BASE + 1"])
}
// D-SIG-AFTER1=A: Main reconciled stale arrow-body goldens to named-function braces.
#Test("multi_head_function_surface_round_trips") {
    item_test_keeps("enum Shape {{ Circle(Float) Rect(w: Float, h: Float) }}\n\nfn area(Circle(r: Float)) -> Float -> r * r\nfn area(Rect(w: Float, h: Float)) -> Float -> w * h\n", ["fn area(Circle(r: Float)) -> Float {{ r * r }}", "fn area(Rect(w: Float, h: Float)) -> Float {{ w * h }}"])
}
#Test("typestate_section_stays_inside_its_struct") {
    output :: item_test_stable("struct Door {{ state {{ Open, Closed }} value: Int }}\nfn run() {{}}\n")
    assert(output.contains("state {{ Open, Closed }}"))
    assert(!output.contains("\nstate Door"))
}

