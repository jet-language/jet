    item_test_keeps("APP :: Output.Executable{{ name: \"demo\", entry: start }}\n\nfn start() {{}}\n", ["APP ::", "Output.Executable{{", "name: \"demo\"", "entry: start"])
}
#Test("fmt_one_placement_law_round_trips_every_target_kind") {
    item_test_keeps("#Codable\nstruct Widget {{\n    #Doc(\"display name\") label: String\n}}\n\nLIMIT :: prep {{ 32 }}\n\n#Inline\nfn hot(a: Int) -> Int {{\n    return a * LIMIT\n}}\n\nfn run() {{\n    #Off print(\"off\")\n    #Impure(\"reads the wall clock\") {{\n        print(\"now\")\n    }}\n}}\n", ["#Codable", "#Doc(\"display name\") label: String", "LIMIT :: prep {{ 32 }}", "#Inline", "#Off print(\"off\")", "#Impure(\"reads the wall clock\") {{"])
}
#Test("trait_member_comments_and_associated_type_order_remain_inside_the_trait") {
    // STATIC frozen Rust defect Items.rs:876-969; canonical cursor fix retained.
    item_test_order("trait Indexed {{\n    // λ belongs to before\n    fn before()\n    // Elem belongs here\n    type Elem\n    fn after()\n    // 命 remains inside the trait\n}}\nfn run() {{}}\n", ["trait Indexed", "// λ belongs to before", "fn before", "// Elem belongs here", "type Elem", "fn after", "// 命 remains inside the trait", "fn run"])
