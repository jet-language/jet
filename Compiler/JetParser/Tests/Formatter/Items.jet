}
#Test("fmt_preserves_ambiguous_codable_union_source_order") {
    _ :: item_test_stable("use core.encoding.json as json\n\n#Codable\nstruct Row {{\n    // String and Char both encode as Text — decode cannot pick uniquely.\n    value: String | Char\n}}\n\nfn run() {{\n    print(\"x\")\n}}\n")
    _ :: item_test_stable("#Codable\nenum Envelope {{\n    Value(Int | I32)\n}}\n\nfn run() {{\n    print(\"x\")\n}}\n")
}
#Test("fmt_preserves_comments_in_ambiguous_decode_unions") {
    item_test_keeps("#Decode\nstruct Row {{\n    value: String /* Text */ | Char\n}}\n", ["value: String /* Text */ | Char"])
    item_test_keeps("#Decode\nstruct Row {{\n    value: String | Char // note\n}}\n", ["value: String | Char", "// note"])
}
#Test("fmt_still_canonicalizes_valid_codable_union") {
    item_test_keeps("#Codable\nstruct Row {{\n    value: String | Int\n}}\n", ["value: Int | String"])
}
#Test("fmt_canonicalizes_skipped_decode_union") {
    item_test_keeps("#Decode\nstruct Row {{\n    #Skip value: String | Char\n}}\n", ["value: Char | String"])
}
#Test("fmt_nested_enum_groups_stability") {
    item_test_keeps("enum Damage {{\n    Physical {{ Blunt, Pierce }}\n    Fire {{ Burn, Scald }}\n    Cold\n}}\n\nfn run() {{\n    d := Damage.Fire.Burn\n    if d == {{\n        .Physical -> {{ print(\"physical\") }}\n        .Fire -> {{ print(\"fire\") }}\n        .Cold -> {{ print(\"cold\") }}\n    }}\n}}\n", ["Physical {{", "Blunt", "Pierce", ".Fire ->", "Fire {{"])
}
#Test("fmt_keeps_codable_and_field_rename_and_turbofish") {
    item_test_keeps("#Codable\nstruct Order {{\n    id: Int\n    #Rename(\"customer\") who: String\n}}\n\nfn run() {{\n    raw :: \"x\"\n    back :: json.decode<Order>(raw) ?? panic(\"bad\")\n    print(back.who)\n}}\n", ["#Codable", "#Rename(\"customer\")", "decode<Order>"])
}
// Main ratified callable marker-list placement inline; frozen Rust differs.
#Test("fmt_rewrites_marker_stacking_to_one_shape_and_is_stable") {
    single :: item_test_stable("#[Codable]\nstruct Invoice {{ id: Int }}\n")
    assert(single.contains("#Codable\nstruct Invoice"))
    stacked :: item_test_stable("#Job #Every(5min) fn prune() {{\n}}\n")
    assert(stacked.contains("#[Job, Every(5min)] fn prune"))
}
