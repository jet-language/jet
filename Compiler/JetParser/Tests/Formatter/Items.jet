    output :: item_test_stable("derive T.Label {{\n    info :: T.reflect()\n    tname :: info.name\n    // resolves to the same value as `tname`\n    lbl :: $tname\n    fn label(self) -> String -> $lbl\n}}\n\n#Label\nstruct Cube {{\n    side: Int\n}}\n\nfn run() {{\n    c :: Cube{{side: 5}}\n    print(c.label())\n}}\n")
