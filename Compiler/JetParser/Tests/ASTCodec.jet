    if !ast_codec_refuses_empty<jet_foundation.WebBucket>() -> accepted.push("WebBucket")
    if !ast_codec_refuses_empty<jet_foundation.WebPartitionMarker>() -> accepted.push("WebPartitionMarker")
    assert_eq(accepted.join(", "), "")
}
