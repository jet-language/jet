// Every AST type carries the codec its declaration derives, though nearly
// each one holds a type another member file declares (a `Span`, a `Type`):
// a parsed program writes to CBOR and reads back to the same bytes, and the
// decoder of each AST type reads a value and refuses an empty input.
use {
    cbor: core.encoding.cbor
    jet_foundation
    jet_foundation.[Program]
    jet_parser.[parse_source]
}

// core.encoding.cbor's parse accepts a depth of at most 4096.
AST_CODEC_LIMITS: cbor.CBOROptions{max_depth: 4096, max_items: 100000000, max_bytes: 1000000000, require_canonical: false}

AST_CODEC_SOURCE: [String]{
    "use {{ text: core.text }}",
    "Shape: enum {{ Circle(radius: Float) Square(Int) Empty }}",
    "#Codable",
    "Point: struct {{ x: Int{{0}} y: Int{{0}} label: String? }}",
    "Named: trait {{ name: fn(self) -> String }}",
    "impl Point.Named {{ name: fn(self) -> String {{ \"({{self.x}}, {{self.y}})\" }} }}",
    "Meters: distinct Int",
    "LIMIT: 16",
    "area: fn(shape: Shape) -> Float {{",
    "    if shape == {{",
    "        .Circle(radius) -> 3.14 * radius * radius",
    "        .Square(side) -> Float.from_int(side * side)",
    "        .Empty -> 0.0",
    "    }}",
    "}}",
    "largest: fn<T: Comparable>(values: [T]) -> T? {{",
    "    best := values.first() ?? return None",
    "    loop value in values {{",
    "        if value > best -> best = value",
    "    }}",
    "    best",
    "}}",
    "total: fn(points: [Point]) -> Int {{",
    "    sum := 0",
    "    loop (index, point) in points {{",
    "        if index >= LIMIT -> break",
    "        sum += point.x + point.y",
    "    }}",
    "    doubled: points.map(|point| point.x * 2)",
    "    sum + doubled.len()",
    "}}",
    "#Test(\"area\") {{ assert_eq(area(.Square(2)), 4.0) }}",
}

// The decoder of `T` runs and refuses an input that holds no value.
ast_codec_refuses_empty: fn<T: Decode>() -> Bool Never! {
    if cbor.decode<T>([U8]{}, AST_CODEC_LIMITS) == .Err(_) -> return true
    false
}

#Test("a parsed program writes to CBOR and reads back to the same bytes") {
    parsed: parse_source(AST_CODEC_SOURCE.join("\n").bytes())
    if parsed.program.items.len() == 0 -> panic("the AST codec source parsed to no items")
    blob: cbor.to_bytes(parsed.program) ?? panic("a parsed program doesn't encode: {err}")
    back: cbor.decode<Program>(blob, AST_CODEC_LIMITS) ?? panic("a parsed program doesn't decode: {err}")
    again: cbor.to_bytes(back) ?? panic("a decoded program doesn't encode: {err}")
    if again != blob -> panic("a program read back from CBOR writes {again.len()} bytes, not its {blob.len()}")
}

#Test("the decoder of every AST type refuses an empty input") {
