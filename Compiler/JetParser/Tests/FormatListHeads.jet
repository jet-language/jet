// 2945ed58b: repeated struct list heads keep explicit heads; assemble with Compiler and run.
fn fmt_list_require(ok: Bool, name: String) Never! {
    if !ok -> panic("formatter list heads contract: {name}")
}

fn run() {
    source := "struct Point {{\n    x: Int\n}}\n\nfn run() {{\n    compact := [Point{{x: 1}}, Point{{x: 2}}]\n    spread := [\n        Point{{x: 3}},\n        Point{{x: 4}},\n    ]\n}}\n"
    plain :: jet_format_source(source, false)
    fmt_list_require(plain.ok, "plain format succeeds")
    fmt_list_require(plain.text.contains("compact := [Point{{x: 1}}, Point{{x: 2}}]"), "plain keeps explicit list heads")
    fmt_list_require(!plain.text.contains("compact := [Point]"), "plain does not collapse repeated heads")
    simplified :: jet_format_source(source, true)
    fmt_list_require(simplified.ok, "simplified format succeeds")
    fmt_list_require(simplified.text.contains("compact := [Point{{x: 1}}, Point{{x: 2}}]"), "simplified keeps explicit list heads")
    fmt_list_require(!simplified.text.contains("compact := [Point]"), "simplified does not collapse repeated heads")
    print("formatter list heads: passed")
}
