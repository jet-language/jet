// The compiler-owned Prelude texts (markers and value tags, derives, the
// original errors, the contract rules and the unit catalog) are parsed and
// read ahead of time into JetSema's PreludeRows.jet by
// Compiler/Toolchain/PreludeRows, so a compile never parses or scans them.
// Each stored value must equal what its reader gives for the same text when
// it runs now, byte for byte in CBOR.
use {
    cbor: core.encoding.cbor
    jet_foundation.[MARKER_SOURCE, registration_marker_rules]
    jet_parser.[parse_generated_source, parser_line_starts]
    jet_sema.[
        SEMA_PRELUDE_DERIVE_PROVIDERS,
        SEMA_PRELUDE_DERIVE_WORDS,
        SEMA_PRELUDE_ERROR_LINE_STARTS,
        SEMA_PRELUDE_ERROR_PROGRAM,
        SEMA_PRELUDE_ERROR_SOURCE,
        SEMA_PRELUDE_MARKER_DECLS,
        SEMA_PRELUDE_RULE_LINE_STARTS,
        SEMA_PRELUDE_RULE_PROGRAM,
        SEMA_PRELUDE_RULE_SOURCE,
        SEMA_PRELUDE_TAGS,
        SEMA_UNITS_CATALOG,
        sema_derive_builtin_providers,
        sema_marker_module_prelude_decls,
        sema_marker_module_prelude_tags,
        sema_marker_rules_applied_row,
        sema_prelude_text_error,
        sema_registration_derive_words,
        sema_registration_original_error_program,
        sema_registration_rule_program,
        sema_units_catalog_read,
    ]
}

prelude_build_rows_same: fn<T: Encode>(built: T, read: T, what: String) {
    built_bytes: cbor.to_bytes(built) ?? panic("the build-time {what} does not encode: {err}")
    read_bytes: cbor.to_bytes(read) ?? panic("the {what} read now does not encode: {err}")
    if built_bytes != read_bytes {
        panic("the build-time {what} ({built_bytes.len()} CBOR bytes) differs from the {what} read now ({read_bytes.len()} bytes); from the checkout root, run jet Compiler/Toolchain/PreludeRows/Main.jet --write")
    }
}

// The marker declarations parse to the stored rows, and each one's
// applied-rule row, read from the parsed declaration, is the marker row the
// registration table holds for it, in the same order.
#Test("the build-time marker rows equal the marker source read now") {
    declarations: sema_marker_module_prelude_decls() ?? panic("{err.file}: {err.message}")
    assert(declarations.len() > 20, "Prelude/Markers.jet declares no markers")
    prelude_build_rows_same(SEMA_PRELUDE_MARKER_DECLS, declarations, "marker declarations")
    rules: registration_marker_rules()
    assert_eq(rules.len(), declarations.len())
    loop index in 0..<declarations.len() {
        row: sema_marker_rules_applied_row(declarations[index], MARKER_SOURCE) ?? panic("`#{declarations[index].name}` reads no applied-rule row")
        prelude_build_rows_same(rules[index], row, "`#{row.name}` rule row")
    }
}

#Test("the build-time value tags equal the marker source read now") {
    tags: sema_marker_module_prelude_tags() ?? panic("{err.file}: {err.message}")
    assert_eq(tags.len(), 4)
    prelude_build_rows_same(SEMA_PRELUDE_TAGS, tags, "value tags")
}

#Test("the build-time derive providers and words equal the derive source read now") {
    providers: sema_derive_builtin_providers() ?? panic("{err.file}: {err.message}")
    assert(providers.len() > 0, "Prelude/Derives.jet declares no provider")
    prelude_build_rows_same(SEMA_PRELUDE_DERIVE_PROVIDERS, providers, "derive providers")
    assert_eq(SEMA_PRELUDE_DERIVE_WORDS, sema_registration_derive_words())
}

#Test("the build-time original error module equals the error source read now") {
    errors: sema_registration_original_error_program() ?? panic("{err.file}: {err.message}")
    prelude_build_rows_same(SEMA_PRELUDE_ERROR_PROGRAM, errors, "original error program")
    assert_eq(SEMA_PRELUDE_ERROR_PROGRAM.items.len(), 7)
    assert_eq(SEMA_PRELUDE_ERROR_LINE_STARTS, parser_line_starts(SEMA_PRELUDE_ERROR_SOURCE.bytes()))
}

#Test("the build-time contract rule module equals the rule source read now") {
    rules: sema_registration_rule_program() ?? panic("{err.file}: {err.message}")
    prelude_build_rows_same(SEMA_PRELUDE_RULE_PROGRAM, rules, "contract rule program")
    ^markers: 0
    loop item in SEMA_PRELUDE_RULE_PROGRAM.items {
        if item == .MarkerDecl(_) -> markers += 1
    }
    assert_eq(markers, 2)
    assert_eq(SEMA_PRELUDE_RULE_LINE_STARTS, parser_line_starts(SEMA_PRELUDE_RULE_SOURCE.bytes()))
}

#Test("the build-time unit catalog equals the unit source read now") {
    catalog: sema_units_catalog_read() ?? panic("{err.file}: {err.message}")
    assert_eq(catalog.len(), 34)
    prelude_build_rows_same(SEMA_UNITS_CATALOG, catalog, "unit catalog")
}

// A Prelude text that does not parse is its reader's error, naming the file
// and the line of the first problem.
#Test("a Prelude text that does not parse is an error at the line of its first problem") {
    text: "Good: struct {{\n    a: Int,\n}}\n\nBad: struct {{\n    a: ,\n}}\n"
    parsed: parse_generated_source(text.bytes())
    assert(parsed.diagnostics.len() > 0, "the broken text parses")
    error: sema_prelude_text_error("Prelude/Broken.jet", text, parsed.diagnostics)
    assert_eq(error.file, "Prelude/Broken.jet")
    assert_eq(error.line, Val(6))
    assert(error.message.starts_with("does not parse: "), error.message)
}
