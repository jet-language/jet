// A function type's parameter marks a written `&` or taken `&&` input, and a
// lambda parameter marks its access the same way; the formatter prints every
// mark back as written.
use jet_parser.[jet_format_source]

access_marks_require: fn(ok: Bool, name: String) Never! {
    if !ok -> panic("function type access marks: {name}")
}

#Test("function_type_access_marks_round_trip") {
    source := "Words: struct {{\n    names: [String]\n}}\n\nWrapper: struct {{\n    edit: fn(&[Int])\n    take: fn(&&Words) -> Int\n}}\n\nthrough: fn(f: fn(&[Int]), buf: &[Int]) {{ f(buf) }}\n\nrun: fn() {{\n    values := [Int]{{}}\n    through(fn(buf: &[Int]) {{ buf.push(1) }}, values)\n    wrapper: Wrapper{{edit: fn(buf: &[Int]) {{ buf.push(2) }}, take: fn(words: &&Words) {{ words.names.len() }}}}\n    wrapper.edit(values)\n}}\n"
    formatted: jet_format_source(source, false)
    access_marks_require(formatted.ok, "the marked source parses and formats")
    access_marks_require(formatted.text == source, "every mark prints back as written:\n{formatted.text}")
    print("function type access marks: passed")
}
