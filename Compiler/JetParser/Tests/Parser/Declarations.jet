use {
    jet_foundation.[DiagnosticStructured, MARKER_SOURCE_SITES, Marker, MarkerDecl, Span, TextEdit, expr_span]
    jet_parser.[jet_format_source, jfmt_check_parse_accepts, parser_marker_placement_edits]
}

marker_test_decl: fn(source: String) -> MarkerDecl {
    program: parser_test_program(source)
    loop item in program.items { if item == .MarkerDecl(value) -> return value }
    panic("expected marker declaration")
}

#Test("a_marker_struct_reads_its_fields_and_settings") {
    program: parser_test_program(`Inline: struct {
    mode: InlineMode

    impl Marker {
        sites: [.Function, .Method, .Constant]
    }
}
run: fn() {}
`)
    program.items[0] == .Struct(definition) ?? panic("the marker is a struct")
    assert_eq(definition.fields.len(), 1)
    decl: definition.marker ?? panic("the struct declares a marker")
    assert_eq(decl.name, "Inline")
    assert_eq(decl.params.len(), 2)
    assert_eq(decl.params[0].name, "mode")
    assert_eq(decl.params[1].name, "$sites")
    assert_eq(marker_test_decl(`Inline: struct { impl Marker { sites: [.Function] } }
run: fn() {}
`).name, "Inline")
}

#Test("empty_and_every_published_site_value_parse_as_settings") {
    assert(marker_test_decl(`NoParameters: struct {
    impl Marker {}
}
run: fn() {}
`).params.is_empty())
    empty: marker_test_decl(`Empty: struct {
    impl Marker {
        sites: []
        repeatable: false
    }
}
run: fn() {}
`)
    assert_eq(empty.params.len(), 2)
    loop param in empty.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    many: marker_test_decl(`Many: struct {
    impl Marker {
        sites: [.Type, .Field]
        repeatable: true
        inherits: false
        scopes: [.Type, .Field]
        resolution: .Merge
    }
}
run: fn() {}
`)
    assert_eq(many.params.len(), 5)
    loop param in many.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    loop site in MARKER_SOURCE_SITES -> _: marker_test_decl("Uses: struct {{ impl Marker {{ sites: [.{site}] }} }}\nrun: fn() {{}}\n")
}

#Test("fact_declaration_parses_its_law_columns") {
    program: parser_test_program(`fact Exactness(holds: .Value, safe: .Gain, gates: [approx, raw])
run: fn() {}
`)
    program.items[0] == .FactDecl(decl) ?? panic("fact declaration")
    assert_eq(decl.name, "Exactness")
    names := [String]{}
    loop param in decl.params {
        names.push(param.name)
        assert(param.ty == None && param.value != None)
    }
    assert_eq(names, [String]{"holds", "safe", "gates"})
}

#Test("an_unknown_top_word_lists_the_declaration_forms") {
    diagnostics: parser_test_errors(`
frobnicate Selector on [.Text] {
    check @body
}
run: fn() {}
`)
    assert_eq(diagnostics[0].code, "E0003")
    assert(diagnostics[0].what.contains("`frobnicate` is not a Jet word"), diagnostics[0].what)
    assert(diagnostics[0].why.contains("`name: value`"), diagnostics[0].why)
}

#Test("fields_join_the_settings_and_a_last_list_field_is_variadic") {
    decl: marker_test_decl(`Pre: struct {
    condition: String
    message: String{"failed"}
    tags: [String]

    impl Marker {
        sites: [.Function, .Method]
        repeatable: true
    }
}
run: fn() {}
`)
    names := [String]{}
    loop param in decl.params -> names.push(param.name)
    assert_eq(names, [String]{"condition", "message", "tags", "$sites", "$repeatable"})
    loop param in decl.params {
        if param.name.starts_with("$") {
            assert(param.ty == None && param.value != None)
        } else { assert(param.ty != None) }
    }
    assert(!decl.params[0].variadic && decl.params[1].value != None && decl.params[2].variadic)
    assert_eq(MARKER_SOURCE_SITES.len(), 20)
}

#Test("a_marker_struct_holds_a_group_or_a_template") {
    group: marker_test_decl(`Fast: struct {
    impl Marker {
        group: #[Inline(.Always), Scalar]
    }
}
run: fn() {}
`)
    members: group.group ?? panic("the marker is a group")
    assert_eq(members.len(), 2)
    template: marker_test_decl(`Logged: struct {
    impl Marker {
        sites: [.Function]

        expand: fn(self, target: Target) {
            print("logged")
        }
    }
}
run: fn() {}
`)
    assert(template.body != None)
}

#Test("impl_marker_rejects_what_a_marker_does_not_have") {
    diagnostics: parser_test_errors(`Bad: struct {
    impl Marker {
        sites: [.Function]
        sites: [.Method]
        colour: .Red
        render: fn(self) {}
    }
}
run: fn() {}
`)
    codes := [String]{}
    loop diagnostic in diagnostics -> codes.push(diagnostic.code)
    assert_eq(codes, [String]{"E0937", "E0936", "E0907"})
}

#Test("nested_state_section_is_stored_on_struct_not_as_an_item") {
    program: parser_test_program(`Door: struct {
    state { Open, Closed }
    value: Int
}
run: fn() {}
`)
    program.items[0] == .Struct(definition) ?? panic("struct")
    state: definition.state ?? panic("struct-owned state set")
    names := [String]{}
    loop name in state.states -> names.push(name.name)
    assert_eq(names, [String]{"Open", "Closed"})
}

#Test("top_level_state_companion_is_rejected_with_a_spanned_rewrite") {
    source: `state Door { Open, Closed }
Door: struct { value: Int }
run: fn() {}
`
    diagnostics: parser_test_errors(source)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E0157")
    assert(diagnostics[0].span != None)
    assert(diagnostics[0].fix.contains("Door: struct"))
    assert(diagnostics[0].fix.contains("state {{ Open, Closed }}"))
    assert(!jfmt_check_parse_accepts(diagnostics))
    formatted: jet_format_source(source, false)
    assert(!formatted.ok)
    assert_eq(formatted.diagnostics.len(), 1)
    assert_eq(formatted.diagnostics[0].code, "E0157")
}

#Test("inline_code_module_companion_uses_the_same_rewrite") {
    source: `ledger: module { state Order { Draft, Confirmed } }
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0157")
    assert(diagnostic.fix.contains("Order: struct"))
    assert(diagnostic.fix.contains("state {{ Draft, Confirmed }}"))
    formatted: jet_format_source(source, false)
    assert(!formatted.ok)
    _: parser_test_diagnostic(formatted.diagnostics, "E0157")
}

#Test("ineligible_state_section_uses_one_registered_parser_diagnostic") {
    loop testcase in [
        (source: `Door: enum { state { Open } }
run: fn() {}
`, owner: "enum"),
        (source: `Door: trait { state { Open } }
run: fn() {}
`, owner: "trait"),
        (source: `Door: state { Open }
run: fn() {}
`, owner: "alias"),
        (source: `impl Door { state { Open } }
run: fn() {}
`, owner: "impl"),
        (source: `Door: module { state { Open } }
run: fn() {}
`, owner: "module"),
        (source: `Door: module<T> { state { Open } }
run: fn() {}
`, owner: "module"),
        (source: `run: fn() { value: { x: 1, state { Open } } }
`, owner: "anonymous shape")
    ] {
        source: testcase.source
        owner: testcase.owner
        diagnostics: parser_test_errors(source)
        assert_eq(diagnostics.len(), 1)
        assert_eq(diagnostics[0].code, "E0158")
        assert(diagnostics[0].what.contains(owner))
        start: parser_test_find(source, "state {{")
        finish: start + parser_test_find(source.slice(start, source.len()), "}}") + 1
        assert_eq(diagnostics[0].span, Val(Span{start: start, end: finish}))
    }
}

#Test("repeated_state_section_points_at_the_second_section") {
    source: `Door: struct { state { Ready } state { Open } }
run: fn() {}
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0168")
    start: parser_test_rfind(source, "state {{")
    finish: start + parser_test_find(source.slice(start, source.len()), "}}") + 1
    assert_eq(diagnostic.span, Val(Span{start: start, end: finish}))
}

#Test("distinct_markers_select_the_type_site_before_module_bindings") {
    loop source in ([String]{"#Numeric Meters: distinct Float", "#Numeric\nMeters: distinct Float"}) {
        program: parser_test_program(source)
        program.items[0] == .Distinct(declaration) ?? panic("marked distinct type")
        assert_eq(declaration.name, "Meters")
        assert_eq(declaration.type_markers.len(), 1)
        assert_eq(declaration.type_markers[0].name, "Numeric")
    }
}

#Test("trait_blocks_in_a_type_body_read_dotted_using_and_operator_heads") {
    source: `Meters: struct {
    v: Int

    impl Literal.Int {
        comptime from_literal: fn(value: Int) -> Meters { Meters{v: value} }
    }

    impl far.Named using inner

    impl Add(Int) #Commutative {
        add: fn(self, rhs: Int) -> Meters { Meters{v: self.v + rhs} }
    }
}
`
    program: parser_test_program(source)
    program.items[0] == .Struct(definition) ?? panic("struct")
    assert_eq(definition.trait_impls.len(), 3)
    literal: definition.trait_impls[0]
    assert_eq(literal.trait_name, "Literal.Int")
    assert_eq(literal.trait_span, Span{start: parser_test_find(source, "Literal.Int"), end: parser_test_find(source, "Literal.Int") + 11})
    assert_eq(literal.methods.len(), 1)
    assert(literal.delegation_field == None)
    named: definition.trait_impls[1]
    assert_eq(named.trait_name, "far.Named")
    assert_eq(named.delegation_field, Val("inner"))
    assert(named.methods.is_empty())
    operator: definition.trait_impls[2]
    assert_eq(operator.trait_name, "Add")
    assert(operator.operator_rhs != None)
    assert(operator.operator_marker != None)
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert_eq(formatted.text, source)
}

// Each marker as `name(args)`, its arguments as written in `source`.
inbody_test_markers: fn(source: String, markers: [Marker]) -> String {
    rows := [String]{}
    loop marker in markers {
        args := [String]{}
        loop arg in marker.args {
            if arg == .Expr(value) {
                span: expr_span(value)
                args.push(source.slice(span.start..<span.end))
            }
        }
        rows.push("{if marker.negated -> "!" else -> ""}{marker.name}({args.join(", ")})")
    }
    rows.join(" ")
}

// `edits` are in source order and do not overlap, so they apply from the last.
inbody_test_apply: fn(source: String, edits: [TextEdit]) -> String {
    text := source
    loop index in 0..<edits.len() {
        edit: edits[edits.len() - 1 - index]
        text = "{text.slice(0..<edit.span.start)}{edit.new_text}{text.slice(edit.span.end..<text.count_bytes())}"
    }
    text
}

#Test("marker_lines_inside_a_body_are_the_markers_above_it") {
    above: `#[Layout(c), Deprecated("x"), Codable, !Debug]
Pixel: struct {
    r: Int
}

#[MustUse, Inline]
area: fn() -> Int { 1 }
`
    inside: `Pixel: struct {
    r: Int
    #Layout: c
    #Deprecated: "x"
    #Codable: true
    #Debug: false
}

area: fn() -> Int {
    #MustUse: true
    1
    #Inline: true
}
`
    written: parser_test_program(above)
    lines: parser_test_program(inside)
    written.items[0] == .Struct(written_struct) ?? panic("struct above")
    lines.items[0] == .Struct(lines_struct) ?? panic("struct inside")
    assert_eq(inbody_test_markers(above, written_struct.type_markers), "Layout(c) Deprecated(\"x\") Codable() !Debug()")
    assert_eq(inbody_test_markers(inside, lines_struct.type_markers), inbody_test_markers(above, written_struct.type_markers))
    loop marker in lines_struct.type_markers -> assert(marker.inside)
    loop marker in written_struct.type_markers -> assert(!marker.inside)
    written_area: parser_test_function(written, "area")
    lines_area: parser_test_function(lines, "area")
    assert_eq(inbody_test_markers(inside, lines_area.markers), "MustUse() Inline()")
    assert_eq(inbody_test_markers(inside, lines_area.markers), inbody_test_markers(above, written_area.markers))
    // The marker lines are not statements: the body keeps its one tail value.
    assert_eq(lines_area.body.len(), written_area.body.len())
    assert_eq(parser_test_stable(inside), inside)
}

#Test("moving_a_marker_set_above_and_back_inside_restores_the_body") {
    inside: `Pixel: struct {
    r: Int
    #Layout: c
    #Codable: true
}

area: fn() -> Int {
    1
    #MustUse: true
}
`
    moved: inbody_test_apply(inside, parser_marker_placement_edits(inside.bytes(), false))
    assert_eq(moved, `#[Layout(c), Codable]
Pixel: struct {
    r: Int
}

#MustUse
area: fn() -> Int {
    1
}
`)
    assert(parser_marker_placement_edits(moved.bytes(), false).is_empty())
    assert_eq(inbody_test_apply(moved, parser_marker_placement_edits(moved.bytes(), true)), inside)
    assert(parser_marker_placement_edits(inside.bytes(), true).is_empty())
}

#Test("markers_above_and_inside_are_e0942_with_a_move_either_way") {
    source: `#Codable
Pixel: struct {
    r: Int
    #Layout: c
}
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0942")
    upward: diagnostic.edit ?? panic("E0942 moves the set above")
    assert_eq(inbody_test_apply(source, [TextEdit]{upward}), `#[Codable, Layout(c)]
Pixel: struct {
    r: Int
}
`)
    diagnostic.structured == .Val(.SuggestedEdits(alternatives)) ?? panic("E0942 offers the move into the body")
    assert_eq(alternatives.len(), 1)
    assert_eq(inbody_test_apply(source, alternatives), `Pixel: struct {
    r: Int
    #Codable: true
    #Layout: c
}
`)
}

#Test("a_marker_line_in_a_nested_block_or_shaping_a_body_is_e0355") {
    nested: parser_test_diagnostic(parser_test_errors(`run: fn() {
    if true {
        #Inline: true
    }
}
`), "E0355")
    assert(nested.what.contains("Block"))
    shaping: parser_test_diagnostic(parser_test_errors(`put: fn() {
    #FFI: true
}
`), "E0355")
    assert(shaping.what.contains("inside the body it shapes"))
}

#Test("a_marker_line_value_must_be_simple_or_parenthesized") {
    diagnostic: parser_test_diagnostic(parser_test_errors(`Pixel: struct {
    r: Int
    #Deprecated: since: "1"
}
`), "E0943")
    assert(diagnostic.edit != None)
}
