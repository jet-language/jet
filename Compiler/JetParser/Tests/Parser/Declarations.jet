use {
    jet_foundation.[DiagnosticStructured, MARKER_SOURCE_SITES, Marker, MarkerDecl, Span, TextEdit, expr_span]
    jet_parser.[jet_format_source, jfmt_check_parse_accepts, parser_marker_placement_edits]
}

fn marker_test_decl(source: String) -> MarkerDecl {
    program :: parser_test_program(source)
    loop item in program.items { if item == .MarkerDecl(value) -> return value }
    panic("expected marker declaration")
}

#Test("a_marker_struct_reads_its_fields_and_settings") {
    program :: parser_test_program(`struct Inline {
    mode: InlineMode

    impl Marker {
        sites :: [.Function, .Method, .Constant]
    }
}
fn run() {}
`)
    program.items[0] == .Struct(definition) ?? panic("the marker is a struct")
    assert_eq(definition.fields.len(), 1)
    decl :: definition.marker ?? panic("the struct declares a marker")
    assert_eq(decl.name, "Inline")
    assert_eq(decl.params.len(), 2)
    assert_eq(decl.params[0].name, "mode")
    assert_eq(decl.params[1].name, "$sites")
    assert_eq(marker_test_decl(`struct Inline { impl Marker { sites :: [.Function] } }
fn run() {}
`).name, "Inline")
}

#Test("empty_and_every_published_site_value_parse_as_settings") {
    assert(marker_test_decl(`struct NoParameters {
    impl Marker {}
}
fn run() {}
`).params.is_empty())
    empty :: marker_test_decl(`struct Empty {
    impl Marker {
        sites :: []
        repeatable :: false
    }
}
fn run() {}
`)
    assert_eq(empty.params.len(), 2)
    loop param in empty.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    many :: marker_test_decl(`struct Many {
    impl Marker {
        sites :: [.Type, .Field]
        repeatable :: true
        inherits :: false
        scopes :: [.Type, .Field]
        resolution :: .Merge
    }
}
fn run() {}
`)
    assert_eq(many.params.len(), 5)
    loop param in many.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    loop site in MARKER_SOURCE_SITES -> _ :: marker_test_decl("struct Uses {{ impl Marker {{ sites :: [.{site}] }} }}\nfn run() {{}}\n")
}

// Rust: crates/jet-parser/src/Parser/Items/states_protocols.rs:981
#Test("fact_declaration_parses_its_law_columns") {
    program :: parser_test_program(`fact Exactness($holds: .Value, $safe: .Gain, $gates: [approx, raw], $decision: "D-TEST")
fn run() {}
`)
    program.items[0] == .FactDecl(decl) ?? panic("fact declaration")
    assert_eq(decl.name, "Exactness")
    names := [String]{}
    loop param in decl.params {
        &names.push(param.name)
        assert(param.ty == None && param.value != None)
    }
    assert_eq(names, [String]{"$holds", "$safe", "$gates", "$decision"})
}

// Rust: crates/jet-parser/src/Parser/Items/states_protocols.rs:1013
#Test("former_text_contract_is_rejected") {
    diagnostics :: parser_test_errors(`
marker Selector on [.Text] {
    check @body
    hole @value
}
fn run() {}
`)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E0381")
    assert(diagnostics[0].what.contains("retired"))
    assert(diagnostics[0].fix.contains("impl Marker"))
}

#Test("fields_join_the_settings_and_a_last_list_field_is_variadic") {
    decl :: marker_test_decl(`struct Pre {
    condition: String
    message: String{"failed"}
    tags: [String]

    impl Marker {
        sites :: [.Function, .Method]
        repeatable :: true
    }
}
fn run() {}
`)
    names := [String]{}
    loop param in decl.params -> &names.push(param.name)
    assert_eq(names, [String]{"condition", "message", "tags", "$sites", "$repeatable"})
    loop param in decl.params {
        if param.name.starts_with("$") {
            assert(param.ty == None && param.value != None)
        } else { assert(param.ty != None) }
    }
    assert(!decl.params[0].variadic && decl.params[1].value != None && decl.params[2].variadic)
    assert_eq(MARKER_SOURCE_SITES.len(), 19)
}

#Test("a_marker_struct_holds_a_group_or_a_template") {
    group :: marker_test_decl(`struct Fast {
    impl Marker {
        group :: #[Inline(.Always), Scalar]
    }
}
fn run() {}
`)
    members :: group.group ?? panic("the marker is a group")
    assert_eq(members.len(), 2)
    template :: marker_test_decl(`struct Logged {
    impl Marker {
        sites :: [.Function]

        fn expand(self, target: Target) {
            print("logged")
        }
    }
}
fn run() {}
`)
    assert(template.body != None)
}

#Test("retired_declarations_teach_the_struct_form_with_an_edit") {
    diagnostics :: parser_test_errors(`marker Pre(condition: String, $sites: [.Function], $repeatable: true)

marker Fast = #[Inline(.Always), Scalar]

fn run() {}
`)
    assert_eq(diagnostics.len(), 2)
    loop diagnostic in diagnostics -> assert_eq(diagnostic.code, "E0381")
    rule :: diagnostics[0].edit ?? panic("the parameter form carries its rewrite")
    assert_eq(rule.new_text, "struct Pre {{\n    condition: String\n\n    impl Marker {{\n        sites :: [.Function]\n        repeatable :: true\n    }}\n}}")
    group :: diagnostics[1].edit ?? panic("the group form carries its rewrite")
    assert_eq(group.new_text, "struct Fast {{\n    impl Marker {{\n        group :: #[Inline(.Always), Scalar]\n    }}\n}}")
}

// Rust: crates/jet-parser/src/Parser/Items/states_protocols.rs:1078
#Test("rejected_trailers_each_teach_the_struct_form") {
    diagnostics :: parser_test_errors(`
marker Inline(mode: String) on [.Function]

marker Pre(condition: String)(sites: [.Function])

fn run() {}
`)
    assert_eq(diagnostics.len(), 2)
    loop diagnostic in diagnostics {
        assert_eq(diagnostic.code, "E0381")
        assert(diagnostic.fix.contains("impl Marker"))
        assert(diagnostic.edit == None)
    }
}

#Test("impl_marker_rejects_what_a_marker_does_not_have") {
    diagnostics :: parser_test_errors(`struct Bad {
    impl Marker {
        sites :: [.Function]
        sites :: [.Method]
        colour :: .Red
        fn render(self) {}
    }
}
fn run() {}
`)
    codes := [String]{}
    loop diagnostic in diagnostics -> &codes.push(diagnostic.code)
    assert_eq(codes, [String]{"E0937", "E0936", "E0907"})
}

// Rust: crates/jet-parser/src/Parser/Items/states_protocols.rs:1108
#Test("nested_state_section_is_stored_on_struct_not_as_an_item") {
    program :: parser_test_program(`struct Door {
    state { Open, Closed }
    value: Int
}
fn run() {}
`)
    program.items[0] == .Struct(definition) ?? panic("struct")
