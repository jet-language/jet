use {
    jet_foundation.[MARKER_SOURCE_SITES, Marker, MarkerDecl, Span, TextEdit, effect_access_name, expr_span]
    jet_parser.[jet_format_source, jfmt_check_parse_accepts, parse_source_layout, parse_type_text, parser_marker_placement_edits]
}

marker_test_decl: fn(source: String) -> MarkerDecl {
    program: parser_test_program(source)
    loop item in program.items {
        if item == .MarkerDecl(value) -> return value
    }
    panic("expected marker declaration")
}

#Test("a_marker_struct_reads_its_fields_and_settings") {
    program: parser_test_program(
        `Inline: struct {
    mode: InlineMode,

    impl Marker {
        sites: [.Function, .Method, .Constant],
    }
}
run: fn() {}
`,
    )
    program.items[0] == .Struct(definition) ?? panic("the marker is a struct")
    assert_eq(definition.fields.len(), 1)
    decl: definition.marker ?? panic("the struct declares a marker")
    assert_eq(decl.name, "Inline")
    assert_eq(decl.params.len(), 2)
    assert_eq(decl.params[0].name, "mode")
    assert_eq(decl.params[1].name, "$sites")
    assert_eq(
        marker_test_decl(
            `Inline: struct { impl Marker { sites: [.Function] } }
run: fn() {}
`,
        )
            .name,
        "Inline",
    )
}

#Test("empty_and_every_published_site_value_parse_as_settings") {
    assert(
        marker_test_decl(
            `NoParameters: struct {
    impl Marker {}
}
run: fn() {}
`,
        )
            .params.is_empty(),
    )
    empty: marker_test_decl(
        `Empty: struct {
    impl Marker {
        sites: [],
        repeatable: false,
    }
}
run: fn() {}
`,
    )
    assert_eq(empty.params.len(), 2)
    loop param in empty.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    many: marker_test_decl(
        `Many: struct {
    impl Marker {
        sites: [.Type, .Field],
        repeatable: true,
        inherits: false,
        scopes: [.Type, .Field],
        resolution: .Merge,
    }
}
run: fn() {}
`,
    )
    assert_eq(many.params.len(), 5)
    loop param in many.params {
        assert(param.ty == None)
        assert(param.value != None)
    }
    loop site in MARKER_SOURCE_SITES {
        // A struct marked only at type uses is a value tag, not a marker rule.
        if site == "TypeUse" -> next
        _: marker_test_decl("Uses: struct {{ impl Marker {{ sites: [.{site}] }} }}\nrun: fn() {{}}\n")
    }
}

#Test("a_type_use_marker_struct_is_a_value_tag_denying_its_fx_row") {
    program: parser_test_program(
        `#FX(!Net, !Log)
Audited: struct {
    impl Marker {
        sites: [.TypeUse],
        from: [Net, store.read],
        timing: .Fixed
    }
}
run: fn() {}
`,
    )
    program.items[0] == .Tag(audited) ?? panic("a type-use marker struct is a value tag")
    assert_eq(audited.name, "Audited")
    ^denied: [String]{}
    loop entry in audited.deny -> denied.push(entry.name)
    assert_eq(denied, [String]{"Net", "Log"})
    ^sources: [String]{}
    loop entry in audited.from -> sources.push(entry.name)
    assert_eq(sources, [String]{"Net", "store.read"})
    timing: audited.timing ?? panic("the tag writes its timing")
    assert_eq(timing.name, "Fixed")
    loop item in program.items {
        if item == .Struct(_) -> panic("a value tag declares no struct type")
    }
    nothing: parser_test_errors(
        `Risk: struct {
    impl Marker {
        sites: [.TypeUse]
    }
}
run: fn() {}
`,
    )
    assert_eq(parser_test_diagnostic(nothing, "E0734").what, "The tag `Risk` denies no destination")
    ceiling: parser_test_errors(
        `#FX(!Exec, Net)
Risk: struct {
    impl Marker {
        sites: [.TypeUse]
    }
}
run: fn() {}
`,
    )
    assert_eq(parser_test_diagnostic(ceiling, "E0734").what, "`Net` in the tag `Risk`'s `#FX` row is a ceiling, not a denial")
}

#Test("fact_plane_struct_parses_its_law_columns") {
    program: parser_test_program(
        `Exactness: struct {
    impl Fact {
        holds: .Value,
        safe: .Gain,
        gates: [approx, raw],
    }
}
run: fn() {}
`,
    )
    program.items[0] == .FactDecl(decl) ?? panic("fact plane")
    assert_eq(decl.name, "Exactness")
    ^names: [String]{}
    loop param in decl.params {
        names.push(param.name)
        assert(param.ty == None && param.value != None)
    }
    assert_eq(names, [String]{"holds", "safe", "gates"})
    loop item in program.items {
        if item == .Struct(_) -> panic("a fact plane declares no struct type")
    }
}

#Test("fact_plane_struct_formats_stably") {
    source: `TypeNominal: struct {
    impl Fact {
        name: "Type.Nominal",
        holds: .Value,
        safe: .Gain,
        gates: [],
        identity: true,
    }
}

run: fn() {}
`
    assert_eq(parser_test_stable(source), source)
}

#Test("fact_plane_struct_refuses_other_members_and_a_second_block") {
    members: parser_test_errors(
        `Flow: struct {
    level: Int,
    impl Fact {
        holds: .Value
    }
}
run: fn() {}
`,
    )
    assert(members.len() > 0 && members[0].what.contains("declares more than its `impl Fact` block"), "a field beside `impl Fact` is refused")
    twice: parser_test_errors(
        `Flow: struct {
    impl Fact {
        holds: .Value
    }
    impl Fact {
        safe: .Gain
    }
}
run: fn() {}
`,
    )
    assert_eq(parser_test_diagnostic(twice, "E0908").what, "`Flow` has a second `impl Fact` block")
}

#Test("the_fact_declaration_word_is_gone") {
    diagnostics: parser_test_errors(
        `fact Exactness(holds: .Value, safe: .Gain, gates: [approx, raw])
run: fn() {}
`,
    )
    assert_eq(diagnostics[0].code, "E0003")
    assert(diagnostics[0].what.contains("`fact` is not a Jet word"), diagnostics[0].what)
}

#Test("the_old_declaration_words_are_ordinary_names") {
    lines: [String]{"tag Secret", "effect Net", "marker Traced {{\n}}", "derive Point.Describe {{}}"}
    words: [String]{"tag", "effect", "marker", "derive"}
    loop (index, line) in lines {
        diagnostics: parser_test_errors("{line}\nrun: fn() {{}}\n")
        assert_eq(diagnostics.len(), 1)
        assert_eq(diagnostics[0].code, "E0003")
        assert_eq(diagnostics[0].what, "`{words[index]}` is not a Jet word")
    }
    named: parser_test_result(
        `Label: struct {
    tag: String,
    effect: Int,
    derive: Bool,
}
describe: fn(tag: String, effect: Int, derive: Bool) -> String {
    marker: Label{tag: tag, effect: effect, derive: derive}
    ^fact: marker.effect
    "{marker.tag} {fact}"
}
run: fn() {
    print(describe(tag: "ok", effect: 1, derive: true))
}
`,
    )
    assert(named.diagnostics.is_empty(), "a retired declaration word still parses as a name")
}

#Test("an_unknown_top_word_lists_the_declaration_forms") {
    diagnostics: parser_test_errors(
        `
frobnicate Selector on [.Text] {
    check @body
}
run: fn() {}
`,
    )
    assert_eq(diagnostics[0].code, "E0003")
    assert(diagnostics[0].what.contains("`frobnicate` is not a Jet word"), diagnostics[0].what)
    assert(diagnostics[0].why.contains("`name: value`"), diagnostics[0].why)
}

#Test("a_retired_binding_word_gets_the_generic_statement_error") {
    diagnostics: parser_test_errors(
        `run: fn() {
    let total = 3
    let mut seen = 0
    var mut kept = 2
}
`,
    )
    words: [String]{"let", "let", "var"}
    assert_eq(diagnostics.len(), words.len())
    loop (index, word) in words {
        assert_eq(diagnostics[index].code, "E0003")
        assert_eq(diagnostics[index].what, "`{word}` is not a Jet word")
        assert(diagnostics[index].why.contains("a binding (`name: value`)"), diagnostics[index].why)
    }
}

#Test("fields_join_the_settings_and_a_last_list_field_is_variadic") {
    decl: marker_test_decl(
        `Pre: struct {
    condition: String,
    message: String{"failed"},
    tags: [String],

    impl Marker {
        sites: [.Function, .Method],
        repeatable: true,
    }
}
run: fn() {}
`,
    )
    ^names: [String]{}
    loop param in decl.params -> names.push(param.name)
    assert_eq(names, [String]{"condition", "message", "tags", "$sites", "$repeatable"})
    loop param in decl.params {
        if param.name.starts_with("$") -> assert(param.ty == None && param.value != None) else {
            assert(param.ty != None)
        }
    }
    assert(!decl.params[0].variadic && decl.params[1].value != None && decl.params[2].variadic)
    assert_eq(MARKER_SOURCE_SITES.len(), 21)
}

#Test("a_marker_struct_holds_a_group_or_a_template") {
    group: marker_test_decl(
        `Fast: struct {
    impl Marker {
        group: #[Inline(.Always), Scalar],
    }
}
run: fn() {}
`,
    )
    members: group.group ?? panic("the marker is a group")
    assert_eq(members.len(), 2)
    template: marker_test_decl(
        `Logged: struct {
    impl Marker {
        sites: [.Function],

        expand: fn(self, target: Target) {
            print("logged")
        }
    }
}
run: fn() {}
`,
    )
    assert(template.body != None)
}

#Test("impl_marker_rejects_a_method_a_marker_does_not_have") {
    diagnostics: parser_test_errors(
        `Bad: struct {
    impl Marker {
        sites: [.Function],
        render: fn(self) {}
    }
}
run: fn() {}
`,
    )
    ^codes: [String]{}
    loop diagnostic in diagnostics -> codes.push(diagnostic.code)
    assert_eq(codes, [String]{"E0907"})
}

// The settings are the constants of a generated `impl Marker`, which sema
// checks against the Core trait (an unknown or repeated one is E0936/E0937
// there), so the parser keeps each one as written.
#Test("impl_marker_settings_become_marker_constants") {
    program: parser_test_program(
        `Traced: struct {
    impl Marker {
        sites: [.Function],
        sites: [.Method],
        color: .Red,
    }
}
run: fn() {}
`,
    )
    program.items[0] == .Struct(definition) ?? panic("struct")
    assert_eq(definition.trait_impls.len(), 1)
    block: definition.trait_impls[0]
    assert_eq(block.trait_name, "Marker")
    assert(block.compiler_generated)
    ^names: [String]{}
    loop constant in block.constants -> names.push(constant.name)
    assert_eq(names, [String]{"sites", "sites", "color"})
}

#Test("impl_marker_group_implements_no_marker") {
    program: parser_test_program(
        `Pair: struct {
    impl Marker {
        group: #[Inline, Scalar],
    }
}
run: fn() {}
`,
    )
    program.items[0] == .Struct(definition) ?? panic("struct")
    assert_eq(definition.trait_impls.len(), 0)
}

#Test("nested_state_section_is_stored_on_struct_not_as_an_item") {
    program: parser_test_program(
        `Door: struct {
    state { Open, Closed }
    value: Int,
}
run: fn() {}
`,
    )
    program.items[0] == .Struct(definition) ?? panic("struct")
    state: definition.state ?? panic("struct-owned state set")
    ^names: [String]{}
    loop name in state.states -> names.push(name.name)
    assert_eq(names, [String]{"Open", "Closed"})
}

#Test("state_list_reads_moves_and_groups") {
    source: `Order: struct {
    state {
        Draft -> Confirmed, Canceled
        Confirmed -> Shipped, Canceled
        Shipped
        Canceled
        Open: Draft | Confirmed
    }
    id: Int,
}
run: fn() {}
`
    program: parser_test_program(source)
    program.items[0] == .Struct(definition) ?? panic("struct")
    state: definition.state ?? panic("struct-owned state list")
    ^names: [String]{}
    loop name in state.states -> names.push(name.name)
    assert_eq(names, [String]{"Draft", "Confirmed", "Shipped", "Canceled"})
    assert_eq(state.arrows.len(), 4)
    ^moves: [String]{}
    loop target in state.arrows[0].to -> moves.push(target.name)
    assert_eq(moves, [String]{"Confirmed", "Canceled"})
    assert(state.arrows[2].to.is_empty())
    assert_eq(state.groups.len(), 1)
    assert_eq(state.groups[0].name.name, "Open")
    ^members: [String]{}
    loop member in state.groups[0].members -> members.push(member.name)
    assert_eq(members, [String]{"Draft", "Confirmed"})
    assert_eq(definition.fields.len(), 1)
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert(formatted.text.contains("    state {{\n        Draft -> Confirmed, Canceled\n        Confirmed -> Shipped, Canceled\n        Shipped\n        Canceled\n        Open: Draft | Confirmed\n    }}\n"))
    assert_eq(jet_format_source(formatted.text, false).text, formatted.text)
    flat: jet_format_source(
        `Door: struct { state { Open, Closed } }
run: fn() {}
`,
        false,
    )
    assert(flat.text.contains("state {{ Open, Closed }}"))
}

#Test("enum_body_owns_one_state_list") {
    source: `Door: enum {
    Shut,
    Open,
    Locked(code: Int),
    state {
        Shut -> Open, Locked
        Open -> Shut
        Locked -> Shut
    }
}
run: fn() {}
`
    program: parser_test_program(source)
    program.items[0] == .Enum(definition) ?? panic("enum")
    assert_eq(definition.variants.len(), 3)
    state: definition.state ?? panic("enum-owned state list")
    assert_eq(state.type_name, "Door")
    assert_eq(state.states.len(), 3)
    assert_eq(state.arrows[0].to.len(), 2)
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert(formatted.text.contains("    state {{\n        Shut -> Open, Locked\n        Open -> Shut\n        Locked -> Shut\n    }}\n"))
    repeated: `Door: enum {
    Shut
    state { Shut }
    state { Shut }
}
run: fn() {}
`
    diagnostic: parser_test_diagnostic(parser_test_errors(repeated), "E0168")
    start: parser_test_rfind(repeated, "state {{")
    assert_eq(diagnostic.span, Val(Span{start: start, end: start + "state {{ Shut }}".len()}))
}

#Test("top_level_state_companion_is_rejected_with_a_spanned_rewrite") {
    source: `state Door { Open, Closed }
Door: struct { value: Int }
run: fn() {}
`
    diagnostics: parser_test_errors(source)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E0157")
    assert(diagnostics[0].span != None)
    assert(diagnostics[0].fix.contains("Door: struct"))
    assert(diagnostics[0].fix.contains("state {{ Open, Closed }}"))
    assert(!jfmt_check_parse_accepts(diagnostics))
    formatted: jet_format_source(source, false)
    assert(!formatted.ok)
    assert_eq(formatted.diagnostics.len(), 1)
    assert_eq(formatted.diagnostics[0].code, "E0157")
}

#Test("inline_code_module_companion_uses_the_same_rewrite") {
    source: `ledger: module { state Order { Draft, Confirmed } }
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0157")
    assert(diagnostic.fix.contains("Order: struct"))
    assert(diagnostic.fix.contains("state {{ Draft, Confirmed }}"))
    formatted: jet_format_source(source, false)
    assert(!formatted.ok)
    _: parser_test_diagnostic(formatted.diagnostics, "E0157")
}

#Test("ineligible_state_section_uses_one_registered_parser_diagnostic") {
    loop testcase in
        [
        {
            source: `Door: trait { state { Open } }
run: fn() {}
`,
            owner: "trait",
        },
        {
            source: `Door: state { Open }
run: fn() {}
`,
            owner: "alias",
        },
        {
            source: `impl Door { state { Open } }
run: fn() {}
`,
            owner: "impl",
        },
        {
            source: `Door: module { state { Open } }
run: fn() {}
`,
            owner: "module",
        },
        {
            source: `Door: module<T> { state { Open } }
run: fn() {}
`,
            owner: "module",
        },
        {
            source: `run: fn() { value: { x: 1, state { Open } } }
`,
            owner: "anonymous shape",
        },
    ] {
        source: testcase.source
        owner: testcase.owner
        diagnostics: parser_test_errors(source)
        assert_eq(diagnostics.len(), 1)
        assert_eq(diagnostics[0].code, "E0158")
        assert(diagnostics[0].what.contains(owner))
        start: parser_test_find(source, "state {{")
        finish: start + parser_test_find(source.slice(start, source.len()), "}}") + 1
        assert_eq(diagnostics[0].span, Val(Span{start: start, end: finish}))
    }
}

#Test("repeated_state_section_points_at_the_second_section") {
    source: `Door: struct { state { Ready } state { Open } }
run: fn() {}
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0168")
    start: parser_test_rfind(source, "state {{")
    finish: start + parser_test_find(source.slice(start, source.len()), "}}") + 1
    assert_eq(diagnostic.span, Val(Span{start: start, end: finish}))
}

#Test("distinct_markers_select_the_type_site_before_module_bindings") {
    loop source in ([String]{"#Numeric Meters: distinct Float", "#Numeric\nMeters: distinct Float"}) {
        program: parser_test_program(source)
        program.items[0] == .Distinct(declaration) ?? panic("marked distinct type")
        assert_eq(declaration.name, "Meters")
        assert_eq(declaration.type_markers.len(), 1)
        assert_eq(declaration.type_markers[0].name, "Numeric")
    }
}

#Test("binding_markers_on_lines_of_their_own_mark_the_module_binding_below") {
    sources: [String]{"#StepLimit(5) table: #run f()", "#StepLimit(5)\ntable: #run f()", "#StepLimit(5)\n\n#Audit\ntable: #run f()"}
    loop source in sources {
        program: parser_test_program(source)
        assert_eq(program.items.len(), 1)
        program.items[0] == .Const(binding) ?? panic("marked module binding: {source:Debug}")
        assert_eq(binding.name, "table")
        assert_eq(binding.markers[0].name, "StepLimit")
    }
    // Markers above a function still mark the function.
    program: parser_test_program("#Memo\nfib: fn() -> Int {{ 1 }}")
    program.items[0] == .Func(function) ?? panic("marked function")
    assert_eq(function.name, "fib")
    assert_eq(function.markers[0].name, "Memo")
}

#Test("trait_blocks_in_a_type_body_read_dotted_using_and_operator_heads") {
    source: `Meters: struct {
    v: Int,

    impl Literal.Int {
        #run from_literal: fn(value: Int) -> Meters { Meters{v: value} }
    }

    impl far.Named using inner

    impl Add(Int) #Commutative {
        add: fn(self, rhs: Int) -> Meters { Meters{v: self.v + rhs} }
    }
}
`
    program: parser_test_program(source)
    program.items[0] == .Struct(definition) ?? panic("struct")
    assert_eq(definition.trait_impls.len(), 3)
    literal: definition.trait_impls[0]
    assert_eq(literal.trait_name, "Literal.Int")
    assert_eq(literal.trait_span, Span{start: parser_test_find(source, "Literal.Int"), end: parser_test_find(source, "Literal.Int") + 11})
    assert_eq(literal.methods.len(), 1)
    assert(literal.delegation_field == None)
    named: definition.trait_impls[1]
    assert_eq(named.trait_name, "far.Named")
    assert_eq(named.delegation_field, Val("inner"))
    assert(named.methods.is_empty())
    operator: definition.trait_impls[2]
    assert_eq(operator.trait_name, "Add")
    assert(operator.operator_rhs != None)
    assert(operator.operator_marker != None)
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert_eq(formatted.text, source)
}

#Test("a_trait_takes_type_parameters_and_each_use_names_its_arguments") {
    source: `Holds: trait<T, U> {
    first: fn(self) -> T,
}

Scores: struct {
    values: [Int],

    impl Holds<Int, [String]> {
        first: fn(self) -> Int { self.values[0] }
    }
}

impl Names.Holds<String, Int> {
    first: fn(self) -> String { self.values[0] }
}

impl Pair<T: Priced>.Describe {
    describe: fn(self) -> String { "pair" }
}

doubled: fn<S: Holds<Int, [String]>>(store: S) -> Int { store.first() * 2 }

either: fn<S: [Holds<String, Int>, Printable]>(store: S) -> String { store.first() }
`
    program: parser_test_program(source)
    program.items[0] == .Trait(holds) ?? panic("trait")
    assert_eq(holds.name, "Holds")
    assert_eq(holds.type_params.len(), 2)
    assert_eq(holds.type_params[1].name, "U")
    program.items[1] == .Struct(scores) ?? panic("struct")
    assert_eq(scores.trait_impls[0].trait_name, "Holds<Int, [String]>")
    program.items[2] == .Impl(names) ?? panic("impl")
    assert_eq(names.type_name, "Names")
    assert_eq(names.trait_name, Val("Holds<String, Int>"))
    program.items[3] == .Impl(pair) ?? panic("conditional impl")
    assert_eq(pair.type_name, "Pair")
    assert_eq(pair.trait_name, Val("Describe"))
    assert_eq(pair.type_params[0].bounds, [String]{"Priced"})
    program.items[4] == .Func(doubled) ?? panic("doubled")
    assert_eq(doubled.type_params[0].bounds, [String]{"Holds<Int, [String]>"})
    program.items[5] == .Func(either) ?? panic("either")
    assert_eq(either.type_params[0].bounds, [String]{"Holds<String, Int>", "Printable"})
    parsed_type: parse_type_text("Holds<Int, [String]>") ?? panic("type text")
    parsed_type == .Apply(applied, arguments) ?? panic("applied type")
    assert_eq(applied, "Holds")
    assert_eq(arguments.len(), 2)
    assert(parse_type_text("Int\n    other: Int") == None)
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert_eq(formatted.text, source)
}

#Test("a_trait_type_parameter_takes_no_bound") {
    diagnostics: parser_test_errors(
        `Holds: trait<T: Printable> {
    first: fn(self) -> T
}
`,
    )
    assert(diagnostics[0].what.contains("takes no bound"))
}

// Each marker as `name(args)`, its arguments as written in `source`.
inbody_test_markers: fn(source: String, markers: [Marker]) -> String {
    ^rows: [String]{}
    loop marker in markers {
        ^args: [String]{}
        loop arg in marker.args {
            if arg == .Expr(value) {
                span: expr_span(value)
                args.push(source.slice(span.start..<span.end))
            }
        }
        rows.push("{if marker.negated -> "!" else -> ""}{marker.name}({args.join(", ")})")
    }
    rows.join(" ")
}

// `edits` are in source order and do not overlap, so they apply from the last.
inbody_test_apply: fn(source: String, edits: [TextEdit]) -> String {
    ^text: source
    loop index in 0..<edits.len() {
        edit: edits[edits.len() - 1 - index]
        bytes: text.bytes()
        head: String.from_bytes(bytes.slice(0, edit.span.start)) ?? panic("an edit span keeps whole characters")
        tail: String.from_bytes(bytes.slice(edit.span.end, bytes.len())) ?? panic("an edit span keeps whole characters")
        text = "{head}{edit.new_text}{tail}"
    }
    text
}

#Test("marker_lines_inside_a_body_are_the_markers_above_it") {
    above: `#[Layout(c), Deprecated("x"), Codable, !Debug]
Pixel: struct {
    r: Int,
}

#[MustUse, Inline]
area: fn() -> Int { 1 }
`
    inside: `Pixel: struct {
    r: Int,
    #Layout: c
    #Deprecated: "x"
    #Codable: true
    #Debug: false
}

area: fn() -> Int {
    #MustUse: true
    1
    #Inline: true
}
`
    written: parser_test_program(above)
    lines: parser_test_program(inside)
    written.items[0] == .Struct(written_struct) ?? panic("struct above")
    lines.items[0] == .Struct(lines_struct) ?? panic("struct inside")
    assert_eq(inbody_test_markers(above, written_struct.type_markers), "Layout(c) Deprecated(\"x\") Codable() !Debug()")
    assert_eq(inbody_test_markers(inside, lines_struct.type_markers), inbody_test_markers(above, written_struct.type_markers))
    loop marker in lines_struct.type_markers -> assert(marker.inside)
    loop marker in written_struct.type_markers -> assert(!marker.inside)
    written_area: parser_test_function(written, "area")
    lines_area: parser_test_function(lines, "area")
    assert_eq(inbody_test_markers(inside, lines_area.markers), "MustUse() Inline()")
    assert_eq(inbody_test_markers(inside, lines_area.markers), inbody_test_markers(above, written_area.markers))
    // The marker lines are not statements: the body keeps its one tail value.
    assert_eq(lines_area.body.len(), written_area.body.len())
    assert_eq(parser_test_stable(inside), inside)
}

#Test("moving_a_marker_set_above_and_back_inside_restores_the_body") {
    inside: `Pixel: struct {
    r: Int,
    #Layout: c
    #Codable: true
}

area: fn() -> Int {
    1
    #MustUse: true
}
`
    moved: inbody_test_apply(inside, parser_marker_placement_edits(inside.bytes(), false))
    assert_eq(
        moved,
        `#[Layout(c), Codable]
Pixel: struct {
    r: Int,
}

#MustUse
area: fn() -> Int {
    1
}
`,
    )
    assert(parser_marker_placement_edits(moved.bytes(), false).is_empty())
    assert_eq(inbody_test_apply(moved, parser_marker_placement_edits(moved.bytes(), true)), inside)
    assert(parser_marker_placement_edits(inside.bytes(), true).is_empty())
}

#Test("markers_above_and_inside_are_e0942_with_a_move_either_way") {
    source: `#Codable
Pixel: struct {
    r: Int,
    #Layout: c
}
`
    diagnostic: parser_test_diagnostic(parser_test_errors(source), "E0942")
    upward: diagnostic.edit ?? panic("E0942 moves the set above")
    assert_eq(
        inbody_test_apply(source, [TextEdit]{upward}),
        `#[Codable, Layout(c)]
Pixel: struct {
    r: Int,
}
`,
    )
    diagnostic.structured == .Val(.SuggestedEdits(alternatives)) ?? panic("E0942 offers the move into the body")
    assert_eq(alternatives.len(), 1)
    assert_eq(
        inbody_test_apply(source, alternatives),
        `Pixel: struct {
    r: Int,
    #Codable: true
    #Layout: c
}
`,
    )
}

#Test("a_marker_line_in_a_nested_block_or_shaping_a_body_is_e0355") {
    nested: parser_test_diagnostic(
        parser_test_errors(
            `run: fn() {
    if true {
        #Inline: true
    }
}
`,
        ),
        "E0355",
    )
    assert(nested.what.contains("Block"))
    shaping: parser_test_diagnostic(
        parser_test_errors(
            `put: fn() {
    #FFI: true
}
`,
        ),
        "E0355",
    )
    assert(shaping.what.contains("inside the body it shapes"))
}

#Test("a_marker_line_value_must_be_simple_or_parenthesized") {
    diagnostic: parser_test_diagnostic(
        parser_test_errors(
            `Pixel: struct {
    r: Int
    #Deprecated: since: "1"
}
`,
        ),
        "E0943",
    )
    assert(diagnostic.edit != None)
}

#Test("an_effect_impl_beside_its_type_joins_the_type") {
    source: `Audit: struct {}

impl Audit.Effect {
    parent: Log.Audit,
}

Ledger: enum {
    Read,
    Post,
}

impl Ledger.Effect {
    irreversible: fn(self) -> Bool { self == .Post }
}
`
    program: parser_test_program(source)
    ^names: [String]{}
    loop item in program.items {
        if item == {
            .Struct(definition) -> { names.push("struct {definition.name}") }
            .Enum(definition) -> { names.push("enum {definition.name}") }
            .EffectDecl(declaration) -> {
                names.push("effect {declaration.name} {declaration.irreversible}")
            }
            .Impl(definition) -> names.push("impl {definition.type_name}")
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                names.push("other")
            }
        }
    }
    assert_eq(names, [String]{"struct Audit", "effect Audit false", "enum Ledger", "effect Ledger true", "effect Ledger.Read false", "effect Ledger.Post true"})
    program.items[0] == .Struct(audit) ?? panic("the effect struct comes first")
    declared: audit.effect_impl ?? panic("the outside block joins `Audit`")
    parent: declared.parent ?? panic("the outside block keeps its `parent`")
    assert_eq(parent.name, "Log.Audit")
    layout: parse_source_layout(source.bytes()).program
    assert_eq(layout.items.len(), 4)
    layout.items[1] == .Impl(written) ?? panic("the layout parse keeps the block where it is written")
    assert_eq(written.type_name, "Audit")
    assert_eq(parser_test_stable(source), source)
}

#Test("an_effect_impl_beside_its_type_keeps_the_effect_contract") {
    twice: parser_test_diagnostic(
        parser_test_errors(
            `Audit: struct {
    impl Effect {}
}

impl Audit.Effect {}
`,
        ),
        "E0908",
    )
    assert(twice.what.contains("second `impl Effect` block"))
    method: parser_test_diagnostic(
        parser_test_errors(
            `Audit: struct {}

impl Audit.Effect {
    undo: fn(self) -> Bool { true }
}
`,
        ),
        "E0907",
    )
    assert(method.what.contains("`undo` is not a method of `Effect`"))
    elsewhere: parser_test_program(
        `impl Audit.Effect {
    irreversible: fn(self) -> Bool { true }
}
`,
    )
    elsewhere.items[0] == .Impl(kept) ?? panic("a block whose type is declared elsewhere stays an impl")
    assert_eq(kept.type_name, "Audit")
}

#Test("an_effect_declares_and_inherits_its_access_class") {
    source: `Journal: enum {
    Read,
    Append,
    Truncate,

    impl Effect {
        access: fn(self) -> EffectAccess { if self == .Read -> .Reads else if self == .Append -> .Adds else -> .Replaces }
    }
}

Archive: struct {
    impl Effect {
        parent: Meta.Generate,
    }
}
`
    program: parser_test_program(source)
    ^classes: [String]{}
    loop item in program.items {
        if item == .EffectDecl(declaration) {
            classes.push("{declaration.name}:{effect_access_name(declaration.access)}")
        }
    }
    assert_eq(
        classes,
        [String]{
            "Journal:Replaces",
            "Journal.Read:Reads",
            "Journal.Append:Adds",
            "Journal.Truncate:Replaces",
            "Archive:Adds",
        },
    )
    assert_eq(parser_test_stable(source), source)
    invalid: parser_test_diagnostic(
        parser_test_errors(
            `Broken: struct {
    impl Effect {
        access: fn(self) -> EffectAccess { .Other }
    }
}
`,
        ),
        "E0633",
    )
    assert(invalid.what.contains("`access: fn`"))
}

#Test("an_effect_value_row_entry_reads_into_the_row") {
    source: `put: fn() -[Bucket{name: "photos", size: -2, open: true}, !Bucket{name: "logs"}]> {}
`
    effects: parser_test_function(parser_test_program(source), "put").declared_effects ?? panic("the written row")
    assert_eq((loop entry in effects -> entry.name), [String]{`Bucket{name: "photos", size: -2, open: true}`, `!Bucket{name: "logs"}`})
    assert_eq(source.slice(effects[0].span.start..<effects[0].span.end), `Bucket{name: "photos", size: -2, open: true}`)
    assert_eq(parser_test_stable(source), source)
    twice: parser_test_diagnostic(parser_test_errors(`put: fn() -[Bucket{name: "a", name: "b"}]> {}`), "E0119")
    assert(twice.what.contains("gives the field `name` twice"))
    computed: parser_test_diagnostic(parser_test_errors(`put: fn() -[Bucket{name: label}]> {}`), "E0119")
    assert(computed.what.contains("`name` in `Bucket{{…}}` needs a literal value"))
    empty: parser_test_diagnostic(parser_test_errors(`put: fn() -[Bucket{}]> {}`), "E0119")
    assert(empty.what.contains("`Bucket{{}}` gives no value"))
}

#Test("a_trait_derive_is_a_type_marker_whose_template_writes_the_impl") {
    source: `Describe: trait {
    describe: fn(self) -> String,
}

impl Describe.Derive {
    expand: fn(target: Target) {
        name: target.name
        impl #{name}.Describe {
            describe: fn(self) -> String { target.name }
        }
    }
}
`
    program: parser_test_program(source)
    program.items[1] == .MarkerDecl(declaration) ?? panic("the derive is a marker declaration")
    assert(declaration.is_derive)
    assert_eq(declaration.name, "Describe")
    assert(declaration.is_pub, "the derive is as visible as its trait")
    assert_eq(declaration.params.len(), 1)
    assert_eq(declaration.params[0].name, "$sites")
    template: declaration.body ?? panic("the derive keeps its template")
    assert_eq(template.len(), 2)
    assert_eq(parser_test_stable(source), source)
    hidden: parser_test_program(
        `impl Describe.Derive {
    expand: fn(target: Target) {}
}
`,
    )
    hidden.items[0] == .MarkerDecl(elsewhere) ?? panic("a derive of a trait declared elsewhere")
    assert(!elsewhere.is_pub, "a derive of a trait declared elsewhere stays in its module")
}

#Test("a_trait_derive_keeps_the_derive_contract") {
    selfed: parser_test_diagnostic(
        parser_test_errors(
            `impl Describe.Derive {
    expand: fn(self, target: Target) {}
}
`,
        ),
        "E0907",
    )
    assert(selfed.what.contains("doesn't match the `Derive` contract"))
    method: parser_test_diagnostic(
        parser_test_errors(
            `impl Describe.Derive {
    describe: fn(self) -> String { "" }
}
`,
        ),
        "E0907",
    )
    assert(method.what.contains("`describe` is not a method of `Derive`"))
    empty: parser_test_diagnostic(parser_test_errors(`impl Describe.Derive {}`), "E0907")
    assert(empty.what.contains("has no `expand: fn(target: Target)`"))
    hidden: parser_test_diagnostic(
        parser_test_errors(
            `priv impl Describe.Derive {
    expand: fn(target: Target) {}
}
`,
        ),
        "E0003",
    )
    assert(hidden.what.contains("is written with markers or `priv`"))
    word: parser_test_errors(`derive Point.Describe {}`)
    assert_eq(word[0].code, "E0003")
    assert(!word[0].what.contains("Derive"), word[0].what)
}
