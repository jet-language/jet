use {
    jet_parser.[parse_generated_source]
    jet_foundation.[UnitFamilyDef]
    // The standard unit catalog as the compiler embeds it (JetSema's generated
    // prelude source) and the outline JetSema reads before it parses it.
    jet_sema.[SEMA_PRELUDE_UNITS_SOURCE, sema_units_catalog_outline]
}

#Test("lambda_callable_interface_parses_only_parameters_and_effects") {
    parsed: parser_test_program(`run: fn() {
    f: fn(n: Int) -[IO]> { print(n) }
}
`)
    initializer: parser_test_binding(parser_test_function(parsed, "run")).init
    initializer == .Lambda(lambda, _) ?? panic("stored lambda")
    effects: lambda.effects ?? panic("lambda effect row")
    names := [String]{}
    loop entry in effects -> names.push(entry.name)
    assert_eq(names, [String]{"IO"})
}

#Test("the old parenthesized lambda gets the generic parse error") {
    loop source in [
        `run: fn() { f: (n: Int) -> n }`,
        `run: fn() { f: (n: Int) -> Point { n } }`,
        `run: fn() {
    f: (n: Int) -> Point {
        total := n + 1
        total
    }
}
`
    ] {
        codes := [String]{}
        loop diagnostic in parser_test_errors(source) {
            if diagnostic.severity == 1 -> codes.push(diagnostic.code)
        }
        assert_eq(codes, [String]{"E0003"})
    }
}

#Test("braced_one_expression_bodies_keep_leading_dot_and_todo_values") {
    parsed: parser_test_program(`ok: fn() -> Int Err! { .Ok(1) }
hole: fn() -> Int { #Todo }
run: fn() {}
`)
    ok: parser_test_function(parsed, "ok").body
    hole: parser_test_function(parsed, "hole").body
    assert_eq(ok.len(), 1)
    assert_eq(hole.len(), 1)
    assert(if ok[0] == {
        .Expr(.EnumLit(_, _, _, _, leading_dot, _, _)) -> leading_dot
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    })
    assert(if hole[0] == {
        .Expr(.Todo(_, _, _)) -> true
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    })
}

#Test("shared_match_part_walk_parses_text_and_bytes") {
    _: parser_test_program(`
run: fn() {
    text: "prefix-42-suffix"
    if text == {
        "prefix-{value}-suffix" -> print(value)
        else -> print("miss")
    }
    bytes: [U8]{ 7 }
    if bytes == {
        [U8]{"{value:U8}"} -> print(value)
        else -> print("miss")
    }
}
`)
}

#Test("standard_units_source_parses_with_unique_members_and_provenance") {
    parsed: parse_generated_source(SEMA_PRELUDE_UNITS_SOURCE.bytes())
    assert(parsed.diagnostics.is_empty())
    families := [UnitFamilyDef]{}
    loop item in parsed.program.items { if item == .UnitFamily(family) -> families.push(family) }
    assert_eq(families.len(), 32)
    degree := false
    dalton := false
    mmhg := false
    square := false
    cubic := false
    loop family in families {
        names := [String]{}
        loop member in family.members {
            assert(!names.contains(member.name))
            names.push(member.name)
            assert(member.scale.numerator != 0)
            if member.name == "degree" -> degree = if member.scale_provenance == {
                .SymbolicPi(_, _) -> true
                .Rational | .Conventional(_, _) | .Measured(_, _, _) -> false
            }
            if member.name == "dalton" -> dalton = if member.scale_provenance == {
                .Measured(_, _, _) -> true
                .Rational | .SymbolicPi(_, _) | .Conventional(_, _) -> false
            }
            if member.name == "mmHg" -> mmhg = if member.scale_provenance == {
                .Conventional(_, _) -> true
                .Rational | .SymbolicPi(_, _) | .Measured(_, _, _) -> false
            }
            if member.name == "square_kilometer" -> square = member.scale.numerator == 1000000 && member.scale.denominator == 1
            if member.name == "cubic_kilometer" -> cubic = member.scale.numerator == 1000000000 && member.scale.denominator == 1
            assert(member.name != "kilosquare_meter" && member.name != "kilocubic_meter")
        }
    }
    assert(degree && dalton && mmhg && square && cubic)
}

// JetSema scans sources for unit mentions with the outline's names and parses
// the catalog only when one is found, so the outline must name exactly the
// parsed families and members, in order.
#Test("standard_units_outline_matches_the_parsed_catalog") {
    parsed: parse_generated_source(SEMA_PRELUDE_UNITS_SOURCE.bytes())
    families := [UnitFamilyDef]{}
    loop item in parsed.program.items { if item == .UnitFamily(family) -> families.push(family) }
    outline: sema_units_catalog_outline()
    assert_eq(outline.len(), families.len())
    loop (index, family) in families {
        assert_eq(outline[index].family, family.family)
        assert_eq(outline[index].members.len(), family.members.len())
        loop (member_index, member) in family.members -> assert_eq(outline[index].members[member_index], member.name)
    }
}

parser_test_statement_guard_tree: fn(depth: Int) -> String Never! {
    if depth == 0 {
        return `if {
(cp < I64{0}) -> return cp
(cp > I64{1}) -> return cp
else -> return cp
}
`
    }
    child: parser_test_statement_guard_tree(depth - 1)
    "if {{\n(cp < I64{{0}}) -> {{\n{child}}}\n(cp > I64{{1}}) -> {{\n{child}}}\nelse -> return cp\n}}\n"
}

#Test("statement_guard_tables_do_not_reparse_as_tail_values") {
    table: parser_test_statement_guard_tree(10)
    parsed: parser_test_program("mapping: fn(cp: I64) -> I64 Never! {{\n{table}}}\n")
    body: parser_test_function(parsed, "mapping").body
    assert_eq(body.len(), 1)
    assert(if body[0] == {
        .Switch(_, _, _, _) -> true
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    })
    _: parser_test_diagnostic(parser_test_errors(`run: fn() { value: if { true -> return 1 else -> 2 } }`), "E0003")
}

#Test("statement_guard_tables_in_value_and_fallback_blocks_parse_once") {
    table: parser_test_statement_guard_tree(8)
    parsed: parser_test_program("mapping: fn(cp: I64) -> I64 Never! {{\nvalue: if true -> {{\n{table}cp\n}} else -> cp\nother: None ?? {{\n{table}cp\n}}\nvalue\n}}\n")
    _: parser_test_binding(parser_test_function(parsed, "mapping"))
}

#Test("braced_control_arms_remain_value_branches") {
    parsed: parser_test_program(`mapping: fn(cp: I64) -> I64 Never! {
    if { (cp < I64{0}) -> { return cp } else -> cp }
}
`)
    body: parser_test_function(parsed, "mapping").body
    assert(if body[body.len() - 1] == {
        .Expr(.If(_, _, _, _, _, _, _)) -> true
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    })
}
