// Rust: crates/jet-parser/src/Parser/mod.rs:2880
#Test("unit_fallible_signatures_format_without_arrow") {
    once :: entry02_format("fn save(path: String) IOError! {{}}\nfn sync() Err! {{}}\nfn bounded() IOError! -[FS]> {{}}\n")
    assert(once.contains("fn save(path: String) IOError!"))
    assert(once.contains("fn sync() Err!"))
    assert(once.contains("fn bounded() IOError! -[FS]>"))
    assert(once == entry02_format(once))
}
