use {
    jet_foundation.[Binding, Diagnostic, Func, Program, StructDef, Type, TypeAliasDef]
    jet_lexer.[
        STRING_PART_INTERPOLATION, TOKEN_IDENT, TOKEN_INT, lex, token_decoded, token_integer,
        token_string_parts,
    ]
    jet_parser.[expand_named_marker_groups_with_uses, named_marker_groups, parse_tokens]
}

entry02_program: fn(source: String) -> Program { parser_test_program(source) }
entry02_errors: fn(source: String) -> [Diagnostic] { parser_test_errors(source) }
entry02_func: fn(program: Program, name: String) -> Func { parser_test_function(program, name) }
entry02_binding: fn(function: Func) -> Binding { parser_test_binding(function) }
entry02_struct: fn(program: Program, name: String) -> StructDef {
    loop item in program.items { if item == .Struct(value) && value.name == name -> return value }
    panic("expected struct")
}
entry02_alias: fn(program: Program, name: String) -> TypeAliasDef {
    loop item in program.items { if item == .TypeAlias(value) && value.name == name -> return value }
    panic("expected alias")
}
entry02_diag: fn(diagnostics: [Diagnostic], code: String) -> Diagnostic { parser_test_diagnostic(diagnostics, code) }
entry02_format: fn(source: String) -> String { parser_test_format(source) }
entry02_unit_result: fn(ty: Type?, error_name: String) -> Bool {
    if ty == {
        .Val(.Result(.Named(unit), .Named(error))) -> unit == "Unit" && error == error_name
        .Val(_) | .None -> false
    }
}

#Test("task_combinators_nest_and_accept_block_branches") {
    p: entry02_program("run: fn() {{\n                result: task.race {{\n                    task.all {{ one(), two() }},\n                    {{ three() }}\n                }}\n            }}\n")
    binding: entry02_binding(entry02_func(p, "run"))
    if binding.init == .MethodCall(_, method, _, _, _, args, _) {
        assert(method == parser_test_task_name("race"))
        if args[0].expr == .ListLit(branches, _, _) {
            assert(branches.len() == 2)
            assert(if branches[0] == { .MethodCall(_, spawn, _, _, _, aa, _) -> spawn == parser_test_task_name("spawn") && if aa[0].expr == { .Lambda(lambda, _) -> if lambda.body == {
                .Expr(.MethodCall(_, inner, _, _, _, _, _)) -> inner == parser_test_task_name("all")
                .Expr(_) | .Block(_) -> false
            }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            })
            assert(if branches[1] == { .MethodCall(_, spawn, _, _, _, aa, _) -> spawn == parser_test_task_name("spawn") && if aa[0].expr == { .Lambda(lambda, _) -> if lambda.body == {
                .Block(_) -> true
                .Expr(_) -> false
            }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            })
        } else { panic("expected task.race branch list") }
    } else { panic("expected task.race method call") }
}
#Test("task_timeout_parses_as_duration_method") {
    p: entry02_program("run: fn() {{\n                wait: 500ms\n                task.timeout(wait)\n            }}\n")
    f: entry02_func(p, "run")
    found := false
    loop stmt in f.body {
        if stmt == .Expr(.MethodCall(_, method, _, _, _, args, _)) {
            assert(method == parser_test_task_name("timeout"))
            assert(args.len() == 1)
            found = true
            break
        }
    }
    assert(found)
}
#Test("ffi_c_inline_tier_parses") {
    p: entry02_program("#FFI(c) add: fn(a: Int, b: Int) -> Int {{\n    \"\"\"long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n\"\"\"\n}}\n")
    f: entry02_func(p, "add")
    inline: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "c")
    assert(inline.source == "long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n")
    assert(f.body.is_empty())
    assert(f.params.len() == 2)
}
#Test("ffi_asm_inline_tier_with_unsafe_gate_parses") {
    p: entry02_program("use core.mem\n#[Unsafe(\"cycle counter\"), FFI(asm)] rdtsc: fn() -> U64 {{\n    \"\"\"rdtsc\nshl rdx, 32\nor rax, rdx        ; -> return\n; clobbers rdx\"\"\"\n}}\n")
    f: entry02_func(p, "rdtsc")
    assert(f.is_unsafe)
    assert(f.unsafe_reason == (Val("cycle counter")))
    inline: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "asm")
    assert(inline.source.contains("; -> return"))
}
#Test("grouped_ffi_keeps_unsafe_gate_and_raw_payload") {
    p: entry02_program("use core.mem\n#[Unsafe(\"scalar registers\"), FFI(asm)]\nadd: fn(a: Int, b: Int) -> Int {{\n    \"\"\"add {{a}}, {{b}} ; -> return\"\"\"\n}}\n")
    f: entry02_func(p, "add")
    assert(f.unsafe_reason == (Val("scalar registers")))
    inline: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.source == "add {{a}}, {{b}} ; -> return")
}
#Test("grouped_function_rules_keep_meta_and_policy_semantics") {
    p: entry02_program("#[Policy(copies: .Explicit), Meta(category: \"api\", maturity: .Tested), Job]\nsync: fn() {{}}\n")
    f: entry02_func(p, "sync")
    assert(f.is_job)
    assert(f.meta != None)
    assert(f.maturity == (Val(.Tested)))
    assert(loop declaration in p.policy_declarations {
        if declaration.key == .Copies && declaration.scope == .Function && declaration.target == (Val(f.span)) -> break true
    } ?? false)
}
#Test("named_rule_arguments_bind_by_signature_without_reordering_source") {
    src: "#[Pre(message: \"positive\", condition: x > 0), Meta(maturity: .Hardened, tunable: false)]\nwork: fn(x: Int) {{}}\n"
    p: entry02_program(src)
    f: entry02_func(p, "work")
    assert(f.pre.len() == 1)
    assert(f.maturity == (Val(.Hardened)))
    meta: f.meta ?? panic("meta")
    assert(!(loop field in meta.fields { if field == .Tunable(_) -> break true } ?? false))
    found := false
    loop marker in f.markers {
        if marker.name == "Pre" {
            labels := [String?]{}
            loop label in marker.arg_labels -> labels.push(if label == .Val(named) -> Val(named.name) else -> None)
            assert(labels == [String?]{Val("message"), Val("condition")})
            found = true
            break
        }
    }
    assert(found)
    family_p: entry02_program("#UnitFamily(base: meter, family: Length) {{\n    meter\n}}\n")
    found_family := false
    loop item in family_p.items {
        if item == .UnitFamily(family) {
            assert(family.family == "Length")
            assert(if family.base == .Val(base) -> base.name == "meter" else -> false)
            found_family = true
            break
        }
    }
    assert(found_family)
    assert(entry02_format(src).contains("#[Pre(message: \"positive\", condition: x > 0), Meta(maturity: .Hardened, tunable: false)]"))
    _: entry02_diag(entry02_errors("#Pre(message: \"positive\", x > 0)\nwork: fn(x: Int) {{}}\n"), "E0930")
}
#Test("marker_stack_fix_preserves_reordered_named_arguments") {
    ds: entry02_errors("#Pre(message: \"positive\", condition: x > 0)\n#Meta(maturity: .Tested, category: \"state\")\nwork: fn(x: Int) {{}}\n")
    edit: entry02_diag(ds, "E0999").edit ?? panic("marker stack edit")
    assert(edit.new_text == "#[Pre(message: \"positive\", condition: x > 0), Meta(maturity: .Tested, category: \"state\")]")
}
// `#State(A -> B)` is the transition, its to-state carried
// under the arrow label; `_` is only the entry from-state.
#Test("state_arrow_marker_parses_the_transition_and_rejects_other_shapes") {
    src: "#State(_ -> Open)\nopen: fn() {{}}\n#State(Open -> Closed)\nclose: fn() {{}}\n#State(Closed)\nread: fn() {{}}\n"
    p: entry02_program(src)
    entry: entry02_func(p, "open").state_transition ?? panic("entry transition")
    assert(entry.from == None)
    assert(entry.to == "Open")
    close_fn: entry02_func(p, "close")
    step: close_fn.state_transition ?? panic("transition")
    assert(step.from == (Val("Open")))
    assert(step.to == "Closed")
    labels := [String?]{}
    loop label in close_fn.markers[0].arg_labels -> labels.push(if label == .Val(named) -> Val(named.name) else -> None)
    assert(labels == [String?]{None, Val("->")})
    required: entry02_func(p, "read").state_requires ?? panic("required state")
    assert(required.name == "Closed")
    formatted: entry02_format(src)
    assert(formatted.contains("#State(_ -> Open)"))
    assert(formatted.contains("#State(Open -> Closed)"))
    assert(entry02_errors("#State(Open -> Closed -> Gone)\nwork: fn() {{}}\n").len() > 0)
    _: entry02_diag(entry02_errors("#State(_)\nwork: fn() {{}}\n"), "E0930")
    _: entry02_diag(entry02_errors("#State(Open -> _)\nwork: fn() {{}}\n"), "E0930")
    _: entry02_diag(entry02_errors("#State(Open, to: Closed)\nwork: fn() {{}}\n"), "E0930")
    _: entry02_diag(entry02_errors("#State(Open, Closed)\nwork: fn() {{}}\n"), "E0930")
}
#Test("argument_marker_stack_fix_keeps_payloads_and_order") {
    ds: entry02_errors("#Codable\n#Rename(.Camel)\nParticle: struct {{ x: Float }}\n")
    assert((entry02_diag(ds, "E0999").edit ?? panic("machine-applicable stack edit")).new_text == "#[Codable, Rename(.Camel)]")
}
#Test("adjacent_marker_stacks_share_one_ordered_e0999_rewrite") {
    loop testcase in [
        (source: "#Job(every: 1s)\n#Doc(\"tick\")\ntick: fn() {{}}\n", expected: "#[Job(every: 1s), Doc(\"tick\")]"),
        (source: "use core.mem\n#Unsafe(\"register ABI\")\n#FFI(c)\nadd: fn() {{ \"\"\"void add(void) {{}}\"\"\" }}\n", expected: "#[Unsafe(\"register ABI\"), FFI(c)]"),
        (source: "#Target(Web)\n#HTML(\"index.html\")\nmain: fn() {{}}\n", expected: "#[Target(Web), HTML(\"index.html\")]"),
        (source: "#PubFile\n#NoPrelude\nmain: fn() {{}}\n", expected: "#[PubFile, NoPrelude]"),
        (source: "#Codable\n#Rename(.Camel)\nParticle: struct {{ x: Float }}\n", expected: "#[Codable, Rename(.Camel)]")
    ] {
        expected: testcase.expected
        ds: entry02_errors(testcase.source)
        assert((entry02_diag(ds, "E0999").edit ?? panic("machine-applicable stack edit")).new_text == expected)
    }
}
#Test("ordered_function_and_file_groups_format_idempotently") {
    loop testcase in [
        (source: "use core.mem\n#[Policy(copies: .Explicit), Meta(category: \"ffi\"), Job, Unsafe(\"register ABI\", obligations: .None), FFI(c)]\nadd: fn() {{\n    \"\"\"void add(void) {{}}\"\"\"\n}}\n", expected: "#[Policy(copies: .Explicit), Meta(category: \"ffi\"), Job, Unsafe(\"register ABI\", obligations: .None), FFI(c)]"),
        (source: "#[HTML(\"index.html\"), PubFile, Target(Wasm), NoPrelude]\nmain: fn() {{}}\n", expected: "#[HTML(\"index.html\"), PubFile, Target(Wasm), NoPrelude]")
    ] {
        expected: testcase.expected
        once: entry02_format(testcase.source)
        assert(once.contains(expected))
        assert(once == entry02_format(once))
    }
}
// Retired `#Pure`/`#InlineAlways` are unknown applied rules; the closed rule
// registry is sema's (E0927, tests/ui/E0927_retired_pure_*). The parser keeps
// each group entry as written and adds no arity or site error of its own.
#Test("grouped_retired_function_markers_reach_sema_as_written") {
    loop testcase in [
        (source: "#[Pure, Job]\nwork: fn() {{}}\n", name: "Pure"),
        (source: "#[InlineAlways, Job]\nwork: fn() {{}}\n", name: "InlineAlways"),
        (source: "#[Pure(), Job]\nwork: fn() {{}}\n", name: "Pure"),
        (source: "#[InlineAlways(), Job]\nwork: fn() {{}}\n", name: "InlineAlways")
    ] {
        f: entry02_func(entry02_program(testcase.source), "work")
        assert(loop marker in f.markers { if marker.name == testcase.name -> break true } ?? false, testcase.source)
    }
}
#Test("abi_function_markers_route_to_the_c_declaration_diagnostic") {
    loop src in ["#[ABI(C), MustUse]\nwork: fn() {{}}\n", "#ABI(C) work: fn() {{}}\n"] {
        ds: entry02_errors(src)
        assert(loop diagnostic in ds {
            if diagnostic.code == "E3212" && diagnostic.what.contains("only applies to C declarations") -> break true
        } ?? false)
    }
}
#Test("abi_lowers_to_the_c_declaration_field_and_groups_reject_extra_rules") {
    p: entry02_program("#Import c.demo: module {{\n    #ABI(sysv64) ping: fn(x: I32) -> I32 = \"ping\"\n}}\n")
    found := false
    loop item in p.items {
        if item == .CModule(foreign_module) && !foreign_module.functions.is_empty() {
            assert(if foreign_module.functions[0].abi == .Val(abi) -> abi.name == "sysv64" else -> false)
            found = true
            break
        }
    }
    assert(found)
    _: entry02_diag(entry02_errors("#Import c.demo: module {{\n    #[ABI(sysv64), MustUse] ping: fn() = \"ping\"\n}}\n"), "E3212")
}
// `#Doc` on a function needs its `Job` companion; the registry's companion
// rule is checked by sema (E0355), so the parser accepts both forms.
#Test("doc_on_a_function_parses_with_and_without_its_job_companion") {
    _: entry02_program("#[Doc(\"task text\"), Job] work: fn() {{}}\n")
    helper: entry02_func(entry02_program("#Doc(\"helper text\") helper: fn() {{}}\n"), "helper")
    assert(loop marker in helper.markers { if marker.name == "Doc" -> break true } ?? false)
}
#Test("ffi_inline_tier_formats_idempotently") {
    loop src in ["#FFI(c) add: fn(a: Int, b: Int) -> Int {{\n    \"\"\"long add(long a, long b) {{ return a + b; }}\n\"\"\"\n}}\n", "use core.mem\n#[Unsafe(\"cycle counter\"), FFI(asm)] rdtsc: fn() -> U64 {{\n    \"\"\"rdtsc ; -> return\n\"\"\"\n}}\n"] {
        once: entry02_format(src)
        assert(once.contains("FFI("))
        assert(once == entry02_format(once))
    }
}
#Test("section_label_emits_e0415") {
    lexed: lex("priv:\nrun: fn() {{ return }}\n".bytes())
    assert(lexed.diagnostics.is_empty())
    parsed: parse_tokens(lexed.tokens, lexed.tables)
    _: parser_test_diagnostic(parsed.diagnostics, "E0415")
}
#Test("arrow_control_law_formats_canonical_forms_idempotently") {
    src: "protocol Exchange {{\n    client: Hello(id: Int)\n    server: Ready()\n}}\n\nclassify: fn(score: Int) -> Grade {{\nif {{\n    score >= 90 -> .A\n    score >= 80 -> .B\n    else -> .C\n}}\n}}\n\nnotify: fn(ready: Bool) -[Net]> {{\n    if ready -> send() else -> skip()\n    loop item in items -> audit(item)\n    outer: loop {{\n        next(outer)\n    }}\n    task.group group {{\n        task fetch()\n    }}\n    #FX(authority: FS, Net) {{\n        use_caps(caps)\n    }}\n}}\n"
    once: entry02_format(src)
    loop expected in ["classify: fn(score: Int) -> Grade {{", "score >= 90 -> .A", "notify: fn(ready: Bool) -[Net]> {{", "if ready -> send() else -> skip()", "loop item in items -> audit(item)", "next(outer)", "task fetch()", "#FX(authority: FS, Net)"] -> assert(once.contains(expected))
    assert(once == entry02_format(once))
}
#Test("named_effect_loop_stops_value_lookahead_at_its_body") {
    _: entry02_format("run: fn() {{\n    outer: loop {{\n        break\n    }}\n    values: loop item in [1, 2] -> item\n    state: if ready -> 1 else -> 2\n}}\n")
}
#Test("multiline_callable_tail_preserves_its_source_expression") {
    p: entry02_program("double: fn(value: Int) -> Int {{\n    adjusted: value + 1\n    adjusted * 2\n}}\n")
    body: entry02_func(p, "double").body
    assert(!body.is_empty())
    assert(if body[body.len() - 1] == {
        .Expr(_) -> true
        .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    })
}
#Test("lambda_interface_lookahead_preserves_grouped_multiplication") {
    _: entry02_program("run: fn() {{ print((2) * 3) }}\n")
}
#Test("adjacent_call_result_has_the_registered_call_value_fix") {
    ds: entry02_errors("run: fn() {{ make()() }}\n")
    assert((entry02_diag(ds, "E-CALL-VALUE").edit ?? panic("call value fix")).new_text == ".call")
}
#Test("return_type_question_spacing_disambiguates_option_vs_result") {
    opt: entry02_program("a: fn() -> Int? {{ None }}\nrun: fn() {{}}\n")
    assert(if entry02_func(opt, "a").return_type == {
        .Val(.Option(_)) -> true
        .Val(_) | .None -> false
    })
    res: entry02_program("b: fn() -> Int Err! {{ Ok(1) }}\nrun: fn() {{}}\n")
    assert(if entry02_func(res, "b").return_type == {
        .Val(.Result(_, _)) -> true
        .Val(_) | .None -> false
    })
    paren: entry02_program("c: fn() -> (Int?) {{ None }}\nrun: fn() {{}}\n")
    assert(if entry02_func(paren, "c").return_type == {
        .Val(.Option(_)) -> true
        .Val(_) | .None -> false
    })
}
#Test("fallible_type_sigil_is_valid_in_all_type_positions") {
    p: entry02_program("Holder: struct {{\nvalue: Int? IOError!\nnested: [Int (DbError | TimeoutError)!]\ncallback: fn(Int? IOError!) -> Int (DbError | TimeoutError)!\n}}\nBox<T>: T? IOError!\nfetch: fn(value: Int? IOError!) -> Box<Int? IOError!> {{ value }}\nrun: fn() {{}}\n")
    assert(loop item in p.items { if item == .Struct(_) -> break true } ?? false)
    holder: entry02_struct(p, "Holder")
    assert(holder.fields[0].ty == Type.Result{ok: Type.Option{inner: Type.Int}, err: Type.Named{name: "IOError"}})
    assert(if holder.fields[1].ty == {
        .List(.Result(.Int, .Union(members))) -> members.len() == 2
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[2].ty == { .Fn(params, .Val(.Result(.Int, .Union(members))), _, _, _, _) -> !params.is_empty() && if params[0] == {
        .Result(_, _) -> members.len() == 2
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(entry02_alias(p, "Box").target == Type.Result{ok: Type.Option{inner: Type.Named{name: "T"}}, err: Type.Named{name: "IOError"}})
}
#Test("failure_contracts_compose_optional_success_and_error_union") {
    p: entry02_program("Holder: struct {{ value: Int? IOError! }}\nfetch: fn(value: Int? IOError!) -> Int (DbError | TimeoutError)! {{ value }}\ninvoke: fn(callback: fn(Int? IOError!) -> Int (DbError | TimeoutError)!) -> Int? IOError! {{ None }}\nrun: fn() {{}}\n")
    assert(entry02_struct(p, "Holder").fields[0].ty == Type.Result{ok: Type.Option{inner: Type.Int}, err: Type.Named{name: "IOError"}})
    assert(if entry02_func(p, "fetch").return_type == {
        .Val(.Result(.Int, .Union(members))) -> members.len() == 2
        .Val(_) | .None -> false
    })
}
#Test("unit_fallible_signatures_use_the_error_prefix") {
    p: entry02_program("save: fn(path: String) IOError! {{}}\nsync: fn() Err! {{}}\nbounded: fn() IOError! -[FS]> {{}}\nload: fn() -> Config IOError! {{}}\n")
    assert(entry02_unit_result(entry02_func(p, "save").return_type, "IOError"))
    assert(entry02_unit_result(entry02_func(p, "sync").return_type, "Err"))
    assert(entry02_unit_result(entry02_func(p, "bounded").return_type, "IOError"))
    assert(entry02_func(p, "load").return_type == (Val(Type.Result{ok: Type.Named{name: "Config"}, err: Type.Named{name: "IOError"}})))
}
// The contract may also follow the effect arrow; both orders are one signature.
#Test("unit_fallible_contract_may_follow_the_effect_arrow") {
    p: entry02_program("before: fn() IOError! -[FS]> {{}}\nafter: fn() -[FS]> IOError! {{}}\n")
    assert(entry02_unit_result(entry02_func(p, "before").return_type, "IOError"))
    assert(entry02_unit_result(entry02_func(p, "after").return_type, "IOError"))
    assert(entry02_format("after: fn() -[FS]> IOError! {{}}\n").contains("after: fn() IOError! -[FS]>"))
}
#Test("suffix_contract_reaches_nested_general_type_positions") {
    p: entry02_program("Holder: struct {{\nmap: [String: IOError!]\ntuple: (entry: Entry? StoreError!, failure: Err!)\ncallback: fn(Int? StoreError!) IOError!\n}}\nCallback: fn(Int? StoreError!) IOError!\nrun: fn() {{}}\n")
    holder: entry02_struct(p, "Holder")
    assert(if holder.fields[0].ty == {
        .Map(_, _, value) -> entry02_unit_result(Val(value), "IOError")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[1].ty == { .Tuple(fields) -> fields.len() >= 2 && fields[0].name == "entry" && if fields[0].ty == {
        .Result(_, _) -> fields[1].name == "failure" && entry02_unit_result(Val(fields[1].ty), "Err")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[2].ty == {
        .Fn(_, ret, _, _, _, _) -> entry02_unit_result(ret, "IOError")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if entry02_alias(p, "Callback").target == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
}
#Test("explicit_error_contract_does_not_consume_the_next_struct_field") {
    p: entry02_program("Holder: struct {{\nfirst: Int Err!\ncallback: fn() Err!\nvalue: fn(self) -> Int {{ 1 }}\nsecond: String\n}}\nrun: fn() {{}}\n")
    holder: entry02_struct(p, "Holder")
    assert(holder.fields.len() == 3)
    assert(holder.methods.len() == 1)
    assert(holder.fields[0].ty == Type.Result{ok: Type.Int, err: Type.Named{name: "Err"}})
    assert(if holder.fields[1].ty == {
        .Fn(_, ret, _, _, _, _) -> entry02_unit_result(ret, "Err")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
}
#Test("retired_infix_failure_spelling_is_not_accepted") {
    _: entry02_errors("Old: Int? ! IOError\n")
}
// (an error suffix alone has a unit success type)
#Test("unit_failure_suffix_is_accepted_in_aliases") {
    target: entry02_alias(entry02_program("Failure: String!\n"), "Failure").target
    assert(target == Type.Result{ok: Type.Named{name: "Unit"}, err: Type.String})
}
#Test("retired_unit_infix_failure_spelling_is_not_accepted") {
    loop source in ["save: fn() ! IOError {{}}\n", "OldFn: fn() ! IOError\n"] -> _: entry02_errors(source)
}
#Test("unit_fallible_signatures_format_without_arrow") {
    once: entry02_format("save: fn(path: String) IOError! {{}}\nsync: fn() Err! {{}}\nbounded: fn() IOError! -[FS]> {{}}\n")
    assert(once.contains("save: fn(path: String) IOError!"))
    assert(once.contains("sync: fn() Err!"))
    assert(once.contains("bounded: fn() IOError! -[FS]>"))
    assert(once == entry02_format(once))
}
#Test("retired_unit_fallible_arrow_form_teaches_the_new_signature") {
    source: "save: fn() {"->"} () ! IOError {{ return }}\n"
    ds: entry02_errors(source)
    assert(entry02_diag(ds, "E0003").fix.contains("save: fn(path: String) IOError!"))
}
#Test("missing_method_body_is_e0081") {
    _: entry02_diag(entry02_errors("Greeter: struct {{}}\nimpl Greeter {{\n    greet: fn(self, name: String) -> String\n}}\nrun: fn() {{}}\n"), "E0081")
}
// A bodiless `name: fn(…)` at file level is a function type.
#Test("bodiless_file_level_fn_is_a_function_type") {
    p: entry02_program("Pick: fn(Int) -> Int\nhost_open: fn(path: String) -[FS]> Int\nrun: fn() {{}}\n")
    assert(if entry02_alias(p, "Pick").target == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if entry02_alias(p, "host_open").target == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
}
