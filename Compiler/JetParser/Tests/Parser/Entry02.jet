// Named groups keep the original expansion rules while importing table-local
// literal and interpolation IDs from independently lexed declarations.
#Test("named_marker_groups_preserve_imported_literal_tables") {
    declaration: lex(`Pair: struct { impl Marker { group: #[Label("value={inner}"), Count(7)] } }`.bytes())
    assert(declaration.diagnostics.is_empty())
    groups: named_marker_groups(declaration.tokens, declaration.tables)
    assert_eq(groups.len(), 1)
    use_site := lex("unrelated: 99\n#Pair run: fn() {{}}\n".bytes())
    assert(use_site.diagnostics.is_empty())
    expanded: expand_named_marker_groups_with_uses(use_site.tokens, use_site.tables, groups)
    assert_eq(expanded.uses.len(), 1)
    assert_eq(expanded.uses[0].name, "Pair")
    found_integer := false
    found_interpolation := false
    loop token in expanded.tokens {
        if token.kind == TOKEN_INT && token_integer(use_site.tables, token) == Val(7) -> found_integer = true
        loop part in token_string_parts(use_site.tables, token) {
            if part.kind != STRING_PART_INTERPOLATION -> next
            loop nested in part.tokens {
                if nested.kind == TOKEN_IDENT && token_decoded(use_site.tables, nested) == "inner" -> found_interpolation = true
            }
        }
    }
    assert(found_integer)
    assert(found_interpolation)
}
