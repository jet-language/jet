// Rust: crates/jet-parser/src/Parser/mod.rs:2554
#Test("retired_s14_teaching_is_paused") {
    retired :: [String]{"E0008", "E0012", "E0013", "E0014", "E0015", "E0016", "E0017", "E0018", "E0021", "E0022", "E0023", "E0024", "E0025", "E0026", "E0027", "E0028", "E0030", "E0032", "E0033", "E0036", "E0044", "E0045", "E0050", "E0051", "E0052", "E0053", "E0054", "E0056", "E0057", "E0984"}
    loop src in ["def run() {{ return }}", "func run() {{ return }}", "import core.files", "fn run() {{ while true {{ return }} }}", "fn run() {{ for x in xs {{ return }} }}", "fn run() {{ match x {{ 1 -> return }} }}", "fn run() {{ switch x {{ 1 -> return }} }}", "fn run() {{ x :: a or b }}", "fn run() {{ x :: a and b }}", "fn run() {{ x :: not ok }}", "fn run(x: Text) {{ return }}", "fn run() {{ todo }}", "fn run() {{ y :: Some(1) }}", "fn run() {{ y :: lambda x {{ x }} }}", "fn run() {{ y :: append(xs, 1) }}", "class Point {{ x: Int }}", "interface Shape {{ fn draw(self) }}", "fn use_item(mut item: Item) {{ return }}"] {
        lexed :: lex(src.bytes())
        assert(lexed.diagnostics.is_empty())
        admitted :: parser_test_result(src)
        loop diagnostic in admitted.diagnostics -> assert(!retired.contains(diagnostic.code))
    }
    loop src in ["fn run() {{ y :: |x| x + 1 }}", "fn run() {{ y :: 1 |> print }}"] {
        lexed :: lex(src.bytes())
        assert(lexed.diagnostics.is_empty())
        admitted :: parser_test_result(src)
        _ :: parser_test_diagnostic(admitted.diagnostics, "E0003")
        loop diagnostic in admitted.diagnostics -> assert(diagnostic.code != "E0033")
    }
    loop word in ["while", "for"] {
        lexed :: lex(word.bytes())
        assert(lexed.diagnostics.is_empty())
        assert(lexed.tokens[0].kind == TOKEN_IDENT)
        assert(token_decoded(lexed.tables, lexed.tokens[0]) == word)
    }
}
