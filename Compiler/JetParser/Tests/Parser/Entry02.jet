// Rust: crates/jet-parser/src/Parser/mod.rs:2760
#Test("prefix_contract_reaches_nested_general_type_positions") {
    p :: entry02_program("struct Holder {{\nmap: [String: !IOError]\ntuple: (entry: Entry? StoreError!, failure: !Err)\ncallback: fn(Int? StoreError!) IOError!\n}}\nalias Callback :: fn(Int? StoreError!) IOError!\nfn run() {{}}\n")
    holder :: entry02_struct(p, "Holder")
    assert(if holder.fields[0].ty == { .Map(_, _, value) -> entry02_unit_result(Val(value), "IOError"), else -> false })
    assert(if holder.fields[1].ty == { .Tuple(fields) -> fields.len() >= 2 && fields[0].name == "entry" && if fields[0].ty == { .Result(_, _) -> fields[1].name == "failure" && entry02_unit_result(Val(fields[1].ty), Syntax.TYPE_ERR), else -> false }, else -> false })
    assert(if holder.fields[2].ty == { .Fn(_, ret, _, _, _, _) -> entry02_unit_result(ret, "IOError"), else -> false })
    assert(if entry02_alias(p, "Callback").target == { .Fn(_, _, _, _, _, _) -> true, else -> false })
}
// Rust: crates/jet-parser/src/Parser/mod.rs:2816
#Test("explicit_error_contract_does_not_consume_the_next_struct_field") {
    p :: entry02_program("struct Holder {{\nfirst: Int Err!\ncallback: fn() Err!\nfn value(self) -> Int -> 1\nsecond: String\n}}\nfn run() {{}}\n")
    holder :: entry02_struct(p, "Holder")
    assert(holder.fields.len() == 3)
    assert(holder.methods.len() == 1)
    assert(holder.fields[0].ty == .Result(.Int, .Named("Err")))
    assert(if holder.fields[1].ty == { .Fn(_, ret, _, _, _, _) -> entry02_unit_result(ret, "Err"), else -> false })
}
