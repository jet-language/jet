fn entry02_program(source: String) -> Program { parser_test_program(source) }
fn entry02_errors(source: String) -> [Diagnostic] { parser_test_errors(source) }
fn entry02_func(program: Program, name: String) -> Func { parser_test_function(program, name) }
fn entry02_binding(function: Func) -> Binding { parser_test_binding(function) }
fn entry02_struct(program: Program, name: String) -> StructDef {
    loop item in program.items { if item == .Struct(value) && value.name == name -> return value }
    panic("expected struct")
}
fn entry02_alias(program: Program, name: String) -> TypeAliasDef {
    loop item in program.items { if item == .TypeAlias(value) && value.name == name -> return value }
    panic("expected alias")
}
fn entry02_diag(diagnostics: [Diagnostic], code: String) -> Diagnostic { parser_test_diagnostic(diagnostics, code) }
fn entry02_format(source: String) -> String { parser_test_format(source) }
fn entry02_unit_result(ty: Type?, error_name: String) -> Bool {
    if ty == { .Val(.Result(.Named(unit), .Named(error))) -> unit == "Unit" && error == error_name else -> false }
}

// Rust: crates/jet-parser/src/Parser/mod.rs:1776
#Test("task_combinators_nest_and_accept_block_branches") {
    p :: entry02_program("fn run() {{\n                result :: task.race {{\n                    task.all {{ one(), two() }},\n                    {{ three() }}\n                }}\n            }}\n")
    binding :: entry02_binding(entry02_func(p, "run"))
    if binding.init == .MethodCall(_, method, _, _, _, args, _, _) {
        assert(method == parser_test_task_name("race"))
        if args[0].expr == .ListLit(branches, _) {
            assert(branches.len() == 2)
            assert(if branches[0] == { .MethodCall(_, spawn, _, _, _, aa, _, _) -> spawn == parser_test_task_name("spawn") && if aa[0].expr == { .Lambda(lambda) -> if lambda.body == { .Expr(.MethodCall(_, inner, _, _, _, _, _, _)) -> inner == parser_test_task_name("all") else -> false } else -> false } else -> false })
            assert(if branches[1] == { .MethodCall(_, spawn, _, _, _, aa, _, _) -> spawn == parser_test_task_name("spawn") && if aa[0].expr == { .Lambda(lambda) -> if lambda.body == { .Block(_) -> true else -> false } else -> false } else -> false })
        } else { panic("expected task.race branch list") }
    } else { panic("expected task.race method call") }
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1834
#Test("task_timeout_parses_as_duration_method") {
    p :: entry02_program("fn run() {{\n                wait :: 500ms\n                task.timeout(wait)\n            }}\n")
    f :: entry02_func(p, "run")
    found := false
    loop stmt in f.body {
        if stmt == .Expr(.MethodCall(_, method, _, _, _, args, _, _)) {
            assert(method == parser_test_task_name("timeout"))
            assert(args.len() == 1)
            found = true
            break
        }
    }
    assert(found)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1862
#Test("ffi_c_inline_tier_parses") {
    p :: entry02_program("#FFI(c) fn add(a: Int, b: Int) -> Int {{\n    \"\"\"long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n\"\"\"\n}}\n")
    f :: entry02_func(p, "add")
    inline :: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "c")
    assert(inline.source == "long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n")
    assert(f.body.is_empty())
    assert(f.params.len() == 2)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1889
#Test("ffi_asm_inline_tier_with_unsafe_gate_parses") {
    p :: entry02_program("use core.mem\n#[Unsafe(\"cycle counter\"), FFI(asm)] fn rdtsc() -> U64 {{\n    \"\"\"rdtsc\nshl rdx, 32\nor rax, rdx        ; -> return\n; clobbers rdx\"\"\"\n}}\n")
    f :: entry02_func(p, "rdtsc")
    assert(f.is_unsafe)
    assert(f.unsafe_reason == (Val("cycle counter")))
    inline :: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "asm")
    assert(inline.source.contains("; -> return"))
}
