// Rust: crates/jet-parser/src/Parser/mod.rs:2607
#Test("fallible_type_sigil_is_valid_in_all_type_positions") {
    p :: entry02_program("struct Holder {{\nvalue: Int? IOError!\nnested: [Int (DbError | TimeoutError)!]\ncallback: fn(Int? IOError!) -> Int (DbError | TimeoutError)!\n}}\nalias Box<T> :: T? IOError!\nfn fetch(value: Int? IOError!) -> Box<Int? IOError!> -> value\nfn run() {{}}\n")
    assert(p.items.iter().any(fn(item) { if item == { .Struct(_) -> true, else -> false } }))
    holder :: entry02_struct(p, "Holder")
    assert(holder.fields[0].ty == .Result(.Option(.Int), .Named("IOError")))
    assert(if holder.fields[1].ty == { .List(.Result(.Int, .Union(members))) -> members.len() == 2, else -> false })
    assert(if holder.fields[2].ty == { .Fn(params, .Val(.Result(.Int, .Union(members))), _, _, _, _) -> !params.is_empty() && if params[0] == { .Result(_, _) -> members.len() == 2, else -> false }, else -> false })
    assert(entry02_alias(p, "Box").target == .Result(.Option(.Named("T")), .Named("IOError")))
}
