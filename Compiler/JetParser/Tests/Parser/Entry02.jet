use jet_foundation.*
use jet_lexer.*
use jet_parser.*

// Rust: crates/jet-parser/src/Parser/mod.rs:1775-2943; shared assertion adapters.
fn entry02_program(source: String) -> Program Never! {
    lexed :: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    parsed :: parse_tokens(lexed.tokens)
    assert(!parsed.diagnostics.iter().any(fn(d) { d.severity == 1 }))
    parsed.program
}
fn entry02_errors(source: String) -> [Diagnostic] Never! {
    lexed :: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    parsed :: parse_tokens(lexed.tokens)
    assert(parsed.diagnostics.iter().any(fn(d) { d.severity == 1 }))
    parsed.diagnostics
}
fn entry02_func(p: Program, name: String) -> @Func Never! from p {
    loop item in p.items { if item == .Func(f) && f.name == name -> return @f }
    panic("expected function {name}")
}
fn entry02_binding(f: Func) -> @Binding Never! from f {
    loop stmt in f.body { if stmt == .Val(binding) -> return @binding }
    panic("expected binding")
}
fn entry02_struct(p: Program, name: String) -> @StructDef Never! from p {
    loop item in p.items { if item == .Struct(s) && s.name == name -> return @s }
    panic("expected struct {name}")
}
fn entry02_alias(p: Program, name: String) -> @TypeAliasDef Never! from p {
    loop item in p.items { if item == .TypeAlias(a) && a.name == name -> return @a }
    panic("expected alias {name}")
}
fn entry02_diag(ds: [Diagnostic], code: String) -> @Diagnostic Never! from ds {
    loop d in ds { if d.code == code -> return @d }
    panic("expected diagnostic {code}")
}
fn entry02_format(source: String) -> String Never! {
    formatted :: jet_format_source(source)
    formatted.source ?? panic("expected successful format: {formatted.diagnostics:Debug}")
}
fn entry02_unit_result(ty: Type?, error_name: String) -> Bool Never! {
    if ty == { .Val(.Result(.Named(unit), .Named(error))) -> unit == Syntax.INTERNAL_UNIT_TYPE && error == error_name, else -> false }
}

// Rust: crates/jet-parser/src/Parser/mod.rs:1775
#Test("task_combinators_nest_and_accept_block_branches") {
    p :: entry02_program("fn run() {{\n                result :: task.race {{\n                    task.all {{ one(), two() }},\n                    {{ three() }}\n                }}\n            }}\n")
    binding :: entry02_binding(entry02_func(p, "run"))
    if binding.init == .MethodCall(_, method, _, _, _, args, _, _, _, _) {
        assert(method == Syntax.INTERNAL_TASK_RACE_METHOD)
        if args[0].expr == .ListLit(branches, _) {
            assert(branches.len() == 2)
            assert(if branches[0] == { .MethodCall(_, spawn, _, _, _, aa, _, _, _, _) -> spawn == Syntax.INTERNAL_TASK_SPAWN_METHOD && if aa[0].expr == { .Lambda(lambda) -> if lambda.body == { .Expr(.MethodCall(_, inner, _, _, _, _, _, _, _, _)) -> inner == Syntax.INTERNAL_TASK_ALL_METHOD, else -> false }, else -> false }, else -> false })
            assert(if branches[1] == { .MethodCall(_, spawn, _, _, _, aa, _, _, _, _) -> spawn == Syntax.INTERNAL_TASK_SPAWN_METHOD && if aa[0].expr == { .Lambda(lambda) -> if lambda.body == { .Block(_) -> true, else -> false }, else -> false }, else -> false })
        } else -> panic("expected task.race branch list")
    } else -> panic("expected task.race method call")
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1833
#Test("task_timeout_parses_as_duration_method") {
    p :: entry02_program("fn run() {{\n                wait :: 500ms\n                task.timeout(wait)\n            }}\n")
    f :: entry02_func(p, "run")
    found := false
    loop stmt in f.body {
        if stmt == .Expr(.MethodCall(_, method, _, _, _, args, _, _, _, _)) {
            assert(method == Syntax.INTERNAL_TASK_TIMEOUT_METHOD)
            assert(args.len() == 1)
            found = true
            break
        }
    }
    assert(found)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1861
#Test("ffi_c_inline_tier_parses") {
    p :: entry02_program("#FFI(c) fn add(a: Int, b: Int) -> Int {{\n    \"\"\"long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n\"\"\"\n}}\n")
    f :: entry02_func(p, "add")
    inline :: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "c")
    assert(inline.source == "long add(long a, long b) {{ return a + b; }}\\n\"quoted\"\n")
    assert(f.body.is_empty())
    assert(f.params.len() == 2)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1888
#Test("ffi_asm_inline_tier_with_unsafe_gate_parses") {
    p :: entry02_program("use core.mem\n#[Unsafe(\"cycle counter\"), FFI(asm)] fn rdtsc() -> U64 {{\n    \"\"\"rdtsc\nshl rdx, 32\nor rax, rdx        ; -> return\n; clobbers rdx\"\"\"\n}}\n")
    f :: entry02_func(p, "rdtsc")
    assert(f.is_unsafe)
    assert(f.unsafe_reason == Val("cycle counter"))
    inline :: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.lang == "asm")
    assert(inline.source.contains("; -> return"))
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1911
#Test("grouped_ffi_keeps_unsafe_gate_and_raw_payload") {
    p :: entry02_program("use core.mem\n#[Unsafe(\"scalar registers\"), FFI(asm)]\nfn add(a: Int, b: Int) -> Int {{\n    \"\"\"add {{a}}, {{b}} ; -> return\"\"\"\n}}\n")
    f :: entry02_func(p, "add")
    assert(f.unsafe_reason == Val("scalar registers"))
    inline :: f.inline_foreign ?? panic("inline_foreign set")
    assert(inline.source == "add {{a}}, {{b}} ; -> return")
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1932
#Test("grouped_function_rules_keep_meta_and_policy_semantics") {
    p :: entry02_program("#[Policy(copies: .Explicit), Meta(category: \"api\", maturity: .Tested), Job]\nfn sync() {{}}\n")
    f :: entry02_func(p, "sync")
    assert(f.is_job)
    assert(f.meta != None)
    assert(f.maturity == Val(.Tested))
    assert(p.policy_declarations.iter().any(fn(d) { d.key == .Copies && d.scope == .Function && d.target == Val(f.span) }))
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1954
#Test("named_rule_arguments_bind_by_signature_without_reordering_source") {
    src :: "#[Transition(to: Closed, from: Open), Meta(maturity: .Hardened, tunable: false)]\nfn work() {{}}\n"
    p :: entry02_program(src)
    f :: entry02_func(p, "work")
    transition :: f.state_transition ?? panic("bound transition")
    assert(transition.from == Val("Open"))
    assert(transition.to == "Closed")
    assert(f.maturity == Val(.Hardened))
    assert(!(f.meta ?? panic("meta")).facts().tunable)
    found := false
    loop application in p.applied_rules {
        if application.marker.name == Syntax.KW_TRANSITION {
            labels := [String?]{}
            loop label in application.marker.arg_labels -> &labels.push(if label == .Val(named) -> Val(named.name) else -> None)
            assert(labels == [String?]{Val("to"), Val("from")})
            found = true
            break
        }
    }
    assert(found)
    family_p :: entry02_program("#UnitFamily(base: meter, family: Length) {{\n    meter\n}}\n")
    found_family := false
    loop item in family_p.items {
        if item == .UnitFamily(family) {
            assert(family.family == "Length")
            assert(if family.base == .Val(base) -> base.name == "meter" else -> false)
            found_family = true
            break
        }
    }
    assert(found_family)
    assert(entry02_format(src).contains("#[Transition(to: Closed, from: Open), Meta(maturity: .Hardened, tunable: false)]"))
    _ :: entry02_diag(entry02_errors("#Transition(to: Closed, Open)\nfn work() {{}}\n"), "E0930")
}
