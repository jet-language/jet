}
// Rust: crates/jet-parser/src/Parser/mod.rs:2059
#Test("adjacent_marker_stacks_share_one_ordered_e0999_rewrite") {
    loop testcase in [
        (source: "#Job\n#Every(1s)\nfn tick() {{}}\n", expected: "#[Job, Every(1s)]"),
        (source: "use core.mem\n#Unsafe(\"register ABI\")\n#FFI(c)\nfn add() {{ \"\"\"void add(void) {{}}\"\"\" }}\n", expected: "#[Unsafe(\"register ABI\"), FFI(c)]"),
        (source: "#Target(Web)\n#HTML(\"index.html\")\nfn main() {{}}\n", expected: "#[Target(Web), HTML(\"index.html\")]"),
        (source: "#PubFile\n#NoPrelude\nfn main() {{}}\n", expected: "#[PubFile, NoPrelude]"),
        (source: "#Codable\n#RenameAll(camel)\nstruct Particle {{ x: Float }}\n", expected: "#[Codable, RenameAll(camel)]")
    ] {
        expected :: testcase.expected
        ds :: entry02_errors(testcase.source)
        assert((entry02_diag(ds, "E0999").edit ?? panic("machine-applicable stack edit")).new_text == expected)
    }
}
