use JetParser.Parser.Statements.[layout_anchor_method, desugar_layout_anchors, desugar_layout_expr]
use jet_foundation.[AccessConvention, Expr, Span, Stmt, StrPart]

// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1084-1090
// No original inline tests; controls exercise the exact structural rewrite.
#Test("layout anchors select horizontal and vertical accessors") {
    loop name in ["left", "right", "width"] -> assert(layout_anchor_method(name) == Val("h"))
    loop name in ["top", "bottom", "height"] -> assert(layout_anchor_method(name) == Val("v"))
    assert(layout_anchor_method("color") == None)
    assert(layout_anchor_method("Left") == None)
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1110-1153
#Test("layout self anchor names the container and preserves spans") {
    ident_span :: Span{start: 3, end: 7}
    anchor_span :: Span{start: 8, end: 13}
    value := Expr.Field{base: Expr.Ident{name: "self", span: ident_span}, member: "width", span: anchor_span}
    desugar_layout_expr("form", &value)
    assert(value == .MethodCall(_, _, _, _, _, _, _, _, _, _))
    if value == .MethodCall(receiver, method, method_span, owner_types, types, args, recv_type, resolved_ret, operator_rhs, checked_widen) {
        assert(receiver == Expr.Ident{name: "form", span: ident_span})
        assert(method == "h")
        assert(method_span == anchor_span)
        assert(owner_types.is_empty() && types.is_empty())
        assert(args.len() == 2)
        assert(args[0].expr == Expr.Str{parts: [StrPart.Lit{text: "form"}], span: ident_span})
        assert(args[1].expr == Expr.Str{parts: [StrPart.Lit{text: "width"}], span: anchor_span})
        assert(args[0].span == ident_span && args[1].span == anchor_span)
        loop arg in args {
            assert(arg.convention == AccessConvention.Read)
            assert(arg.label == None && !arg.spread)
        }
        assert(recv_type == None && resolved_ret == None && operator_rhs == None && !checked_widen)
    }
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1102-1178
#Test("layout rewrite visits deferred close but leaves ordinary fields alone") {
    span :: Span{start: 0, end: 1}
    unchanged :: Expr.Field{base: Expr.Ident{name: "label", span: span}, member: "color", span: span}
    value := ~unchanged
    desugar_layout_expr("form", &value)
    assert(value == unchanged)
    statement := Stmt.DeferClose{close: Expr.Field{base: Expr.Ident{name: "label", span: span}, member: "bottom", span: span}, span: span}
    desugar_layout_anchors("form", &statement)
    assert(statement == .DeferClose(_, _))
    if statement == .DeferClose(close, _) {
        assert(close == .MethodCall(_, "v", _, _, _, _, _, _, _, _))
        if close == .MethodCall(_, _, _, _, _, args, _, _, _, _) -> assert(args[0].expr == Expr.Str{parts: [StrPart.Lit{text: "label"}], span: span})
    }
}
