// A module re-exports a declaration by declaring a name for it:
// `clamp: core.math.clamp` is a public import row, not a constant.
use jet_foundation.[ImportDecl, Item]

reexport_test_row: fn(imports: [ImportDecl], alias: String) -> String {
    loop import in imports {
        if import.alias != alias -> next
        if import.kind == .Module(name, _) {
            return if import.is_pub -> "export {name}" else -> name
        }
    }
    panic("expected a module row named `{alias}`")
}

reexport_test_names: fn(items: [Item]) -> [String] {
    ^names: [String]{}
    loop item in items {
        if item == .Const(definition) -> names.push("{definition.name}")
        if item == .Func(definition) -> names.push("{definition.name}")
    }
    names
}

#Test("a module binding to a path of value names re-exports what it names") {
    program: parser_test_program(
        `use core.math.[clamp]
use core.files

limit: clamp
sqrt: core.math.sqrt
fs: files
read: files.read
LIMIT: other.LIMIT
Point: geo.Point
forward: again

run: fn() {}
`,
    )
    assert_eq(program.imports.len(), 6)
    assert_eq(reexport_test_row(program.imports, "limit"), "export core.math.clamp")
    assert_eq(reexport_test_row(program.imports, "sqrt"), "export core.math.sqrt")
    assert_eq(reexport_test_row(program.imports, "fs"), "export core.files")
    assert_eq(reexport_test_row(program.imports, "read"), "export core.files.read")
    assert_eq(reexport_test_names(program.items), [String]{"LIMIT", "Point", "forward", "run"})
}

#Test("a re-export target in parentheses is refused with the edit that drops them") {
    source: "root: (core.math.sqrt)\n\nrun: fn() {{}}\n"
    errors: parser_test_errors(source)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0].code, "E0003")
    assert_eq(errors[0].fix, "Drop the parentheses: `root: core.math.sqrt`")
    // The line still re-exports, so the parentheses are its one error.
    assert_eq(reexport_test_row(parser_test_result(source).program.imports, "root"), "export core.math.sqrt")
    kept: parser_test_program("Pair: (Int, Int)\n\nrun: fn() {{}}\n")
    assert_eq(kept.imports.len(), 0)
}

#Test("a re-export names the binding a re-export before it declares") {
    program: parser_test_program("first: core.math.clamp\nsecond: first\n\nrun: fn() {{}}\n")
    assert_eq(reexport_test_row(program.imports, "first"), "export core.math.clamp")
    assert_eq(reexport_test_row(program.imports, "second"), "export core.math.clamp")
}

#Test("an inline module re-exports through its own imports") {
    program: parser_test_program(
        `geo: module {
    use core.files

    read: files.read
    area: fn() -> Int { 1 }
}

run: fn() {}
`,
    )
    if program.items[0] == .CodeModule(definition) {
        assert_eq(reexport_test_row(definition.imports, "read"), "export core.files.read")
        assert_eq(reexport_test_names(definition.body ?? [Item]{}), [String]{"area"})
    } else { panic("expected the inline module first") }
}

#Test("a re-export that repeats its member is that member's import row") {
    source: "bank: module {{\n    launch: fn() {{}}\n}}\n\nbridge: module {{\n    launch: bank.launch\n}}\n\nrun: fn() {{}}\n"
    program: parser_test_program(source)
    if program.items[1] == .CodeModule(definition) {
        assert_eq(definition.imports.len(), 1)
        row: definition.imports[0]
        assert(row.is_pub)
        assert_eq(row.alias, "launch")
        if row.kind == .Unqualified(module_alias, _, items, _, _) {
            assert_eq(module_alias, "bank")
            assert_eq(items.len(), 1)
            assert_eq(items[0].original, "launch")
        } else { panic("expected the member import row `use bank.launch`") }
    } else { panic("expected the bridge module second") }
    assert_eq(parser_test_stable(source), source)
    renamed: parser_test_program("use text\n\nshout: text.loud\n\nrun: fn() {{}}\n")
    assert_eq(reexport_test_row(renamed.imports, "shout"), "export text.loud")
}

#Test("a name a file use row binds re-exports that file module") {
    program: parser_test_program("use bank_file: \"bank.jet\"\n\nbank: bank_file\n\nrun: fn() {{}}\n")
    assert_eq(program.imports.len(), 2)
    exported: program.imports[1]
    assert(exported.is_pub)
    assert_eq(exported.alias, "bank")
    if exported.kind == .File(path, _) -> assert_eq(path, "bank.jet") else {
        panic("expected a file row")
    }
    assert_eq(parser_test_stable("use bank_file: \"bank.jet\"\n\nbank: bank_file\n\nrun: fn() {{}}\n"), "use bank_file: \"bank.jet\"\n\nbank: bank_file\n\nrun: fn() {{}}\n")
}

#Test("a mutable binding stays a binding") {
    program: parser_test_program("total := core.math.zero\n\nrun: fn() {{}}\n")
    assert_eq(program.imports.len(), 0)
    assert_eq(reexport_test_names(program.items), [String]{"total", "run"})
}

#Test("fmt writes a re-export as the declaration it is, after the imports") {
    formatted: parser_test_stable(
        `use core.math.[clamp]

run: fn() {}

// The bound the shapes keep.
limit: clamp
sqrt: core.math.sqrt
`,
    )
    assert_eq(
        formatted,
        `use core.math.[clamp]

// The bound the shapes keep.
limit: clamp
sqrt: core.math.sqrt

run: fn() {}
`,
    )
}

#Test("`pub` is a plain name, so `pub use` and `pub fn` get the generic parse error") {
    sources: [String]{"pub use core.sys\n\nrun: fn() {{}}\n", "pub run: fn() {{}}\n"}
    loop source in sources {
        errors: parser_test_errors(source)
        assert(!errors.is_empty(), source)
        assert(!errors[0].fix.contains("re-export") && !errors[0].fix.contains("delete `pub`"), errors[0].fix)
    }
    program: parser_test_program("use core.files\n\npub: files.read\n\nrun: fn() {{}}\n")
    assert_eq(reexport_test_row(program.imports, "pub"), "export core.files.read")
}
