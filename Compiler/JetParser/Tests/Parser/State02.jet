use {
    jet_foundation.[BinOp, DiagnosticFixApplicability, DiagnosticFixSafety, Program, Type]
    jet_lexer.[TOKEN_BLOCK_COMMENT, TOKEN_LINE_COMMENT, Token, lex]
    jet_parser.[jfmt_check_parse_accepts, parse_tokens, parser_prepare_tokens]
}

program: fn(source: String) -> Program { parser_test_program(source) }

#Test("clean_preparation_reuses_byte_identical_tokens") {
    // A colon declaration is rewritten during preparation, so a clean source
    // here is a plain statement line.
    lexed := lex("print(1)\n".bytes())
    assert(lexed.diagnostics.is_empty())
    expected := [Token]{}
    loop token in lexed.tokens {
        if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT -> expected.push(token)
    }
    prepared: parser_prepare_tokens(lexed.tokens.move(), lexed.tables)
    assert(prepared.fenced_statements.is_empty())
    assert(prepared.tokens == expected)
    // Token value equality is observable; Rust Cow pointer identity is not a Jet API.
}

#Test("suffix_failure_contracts_cover_nested_type_positions") {
    parsed: program("Holder: struct {{\noptional: Int?\nunit: IOError!\nunion: Int (DbError | TimeoutError)!\ncallback: fn(Int? IOError!) IOError!\nimpossible: Never!\n}}\nBox<T>: T? IOError!\nfetch: fn(value: Int? IOError!) -> Int? (DbError | TimeoutError)! {{ value }}\nsave: fn() IOError! {{}}\nrun: fn() {{}}\n")
    holder: loop item in parsed.items {
        if item == .Struct(def) && def.name == "Holder" -> break def
    } ?? panic("Holder")
    assert(if holder.fields[0].ty == {
        .Option(inner) -> inner == Type.Int
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[1].ty == {
        .Result(ok, err) -> ok == Type.Named{name: "Unit"} && err == Type.Named{name: "IOError"}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[2].ty == {
        .Result(ok, err) -> ok == Type.Int && if err == {
            .Union(members) -> members.len() == 2
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[3].ty == {
        .Fn(params, ret, _, _, _, _) -> !params.is_empty() && if params[0] == {
            .Result(_, _) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        } && if ret == { .Val(ty) -> if ty == {
            .Result(_, _) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
            .None -> false
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if holder.fields[4].ty == {
        .Result(_, err) -> err == Type.Named{name: "Never"}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    })
    formatted: parser_test_format("save: fn() IOError! {{}}\nload: fn() -> Int (DbError | TimeoutError)! {{ 1 }}\n")
    assert(formatted.contains("save: fn() IOError!"))
    assert(formatted.contains("load: fn() -> Int (DbError | TimeoutError)!"))
    contextual: parser_test_format("load: fn() IOError! {{ read()?(\"loading config\") }}\n")
    assert(contextual.contains("?(\"loading config\")"))
}

#Test("built_in_marker_accepts_positional_string_argument") {
    parsed: program("#CLI\nServeArgs: struct {{\n#Doc(\"port\") port: Int{{3000}}\n}}\nrun: fn(args: ServeArgs) {{}}\n")
    field: loop item in parsed.items {
        if item == .Struct(def) && !def.fields.is_empty() -> break def.fields[0]
    } ?? panic("ServeArgs.port")
    assert(field.serde_markers.len() == 1)
    assert(field.serde_markers[0].name == "Doc")
    assert(field.serde_markers[0].arg_labels[0] == None)
}

#Test("dispatch_atom_boolean_group_has_safe_source_edit") {
    source: "run: fn() {{\n    n: 48\n    ready: true\n    if n < {{\n        48 | 45 && ready -> print(\"hit\")\n        else -> print(\"miss\")\n    }}\n}}\n"
    lexed: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    checked: parser_test_result(source)
    diagnostic: loop d in checked.diagnostics { if d.code == "E0386" -> break d } ?? panic("E0386")
    edit: diagnostic.edit ?? panic("source edit")
    assert(source.slice(edit.span.start, edit.span.end) == "48 | 45")
    assert(edit.new_text == "(48 | 45)")
    assert(diagnostic.applicability == (Val(DiagnosticFixApplicability.Safe)))
    assert(diagnostic.safety == (Val(DiagnosticFixSafety.Formatting)))
    fixed: source.replace("48 | 45", "(48 | 45)")
    fixed_lexed: lex(fixed.bytes())
    assert(fixed_lexed.diagnostics.is_empty())
    assert(jfmt_check_parse_accepts(parser_test_result(fixed).diagnostics))
    loop variant in ([source.replace("&&", "||"), source.replace("48 | 45 && ready", "ready && 48 | 45")]) {
        variant_lexed: lex(variant.bytes())
        assert(variant_lexed.diagnostics.is_empty())
        variant_checked: parser_test_result(variant)
        assert(loop d in variant_checked.diagnostics { if d.code == "E0386" -> break true } ?? false)
    }
}

#Test("missing_function_body_is_e0081_and_recovers_for_check") {
    source: "Host: struct {{}}\nimpl Host {{\n    open: fn(self, path: String) -[FS]> Int\n}}\nrun: fn() {{}}\n"
    lexed: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    // Rust `parse(&tokens).is_err()`: the ordinary parse reports an error. The check
    // acceptance (`jfmt_check_parse_accepts`) admits E0081 on purpose, as `parse_for_check` does.
    assert(loop d in parser_test_result(source).diagnostics { if d.severity == 1 -> break true } ?? false)
    checked: parser_test_result(source)
    assert(loop d in checked.diagnostics { if d.code == "E0081" -> break true } ?? false)
    names := [String]{}
    loop item in checked.program.items { if item == .Func(func) -> names.push(func.name) }
    assert(names.contains("run"))
    second: lex("Host: struct {{}}\nimpl Host {{ foo: fn(self) -> Int }}\nbar: fn() {{}}\n".bytes())
    assert(second.diagnostics.is_empty())
    recovered: parse_tokens(second.tokens, second.tables)
    assert(loop d in recovered.diagnostics { if d.code == "E0081" -> break true } ?? false)
    assert(loop item in recovered.program.items { if item == .Func(func) && func.name == "bar" -> break true } ?? false)
}

#Test("spaced_minus_is_subtraction") {
    parsed: program("run: fn() {{ d: 5 - 3 }}")
    func: loop item in parsed.items { if item == .Func(f) -> break f } ?? panic("a run function")
    binding: loop stmt in func.body { if stmt == .Val(b) -> break b } ?? panic("a val binding")
    assert(if binding.init == {
        .Binary(op, _, _, _, _) -> op == BinOp.Sub
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    })
}

#Test("marker_template_type_holes_stay_in_the_template_ast") {
    // The Rust fixture's retired `~self.value` is spelled `.copy()`.
    parsed: program("\nTypeName: struct {{\n    impl Marker {{\n        expand: fn(self, target: Target) {{\n            param: target.type_params[0].name\n            get_value: fn(self) -> @param {{ self.value.copy() }}\n            type_name: fn(self) -> String {{ target.name }}\n        }}\n    }}\n}}\n")
    declaration: loop item in parsed.items { if item == .MarkerDecl(d) -> break d } ?? panic("marker declaration")
    body: declaration.body ?? panic("marker template")
    function: loop body_item in body {
        if body_item == .Item(item) {
            if item == .Func(f) && f.name == "get_value" -> break f
        }
    } ?? panic("generic template function")
    assert(function.return_type == (Val(Type.Named{name: "@param"})))
}

#Test("retired_derive_provider_declaration_is_not_an_item_but_generate_keeps_item_blocks") {
    source: "\nderive T.Debug {{\n    debug: fn(self) -> String {{ \"retired\" }}\n}}\n"
    lexed: lex(source.bytes())
    assert(lexed.diagnostics.is_empty())
    diagnostics: parser_test_errors(source)
    assert(diagnostics.len() > 0)
    // No teaching diagnostic names the retired spelling.
    assert(loop d in diagnostics { if d.what.contains("derive T.") -> break false } ?? true)
    _: program("\nbuild: fn(b: Build) {{\n    b.generate(\"made\") {{\n        impl Thing.Debug {{\n            debug: fn(self) -> String {{ \"generated\" }}\n        }}\n    }}\n}}\n")
}

#Test("root_template_loop_parses_closed_type_list_and_declarations") {
    parsed: program("\n#loop T in [Point] {{\n    impl T {{\n        generated: fn(self) -> String {{ \"generated\" }}\n    }}\n    #Test(\"generated\") {{\n        .measure {{\n            assert(true)\n        }}\n    }}\n}}\n")
    loop_item: loop item in parsed.items { if item == .TemplateLoop(value) -> break value } ?? panic("root template loop")
    assert(loop_item.body.len() == 2)
    assert(if loop_item.body[0] == { .Item(item) -> if item == {
        .Impl(_) -> true
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    }
        .Stmt(_) | .Loop(_, _, _, _, _) | .If(_, _, _, _, _) -> false
    })
    assert(if loop_item.body[1] == { .Item(item) -> if item == {
        .Test(_) -> true
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    }
        .Stmt(_) | .Loop(_, _, _, _, _) | .If(_, _, _, _, _) -> false
    })
}

#Test("task_keyword_callable_body_parses_as_spawn") {
    parsed: program("run: fn() {{\n    task.group g {{\n        h: task work()\n    }}\n}}\n")
    run: loop item in parsed.items { if item == .Func(f) && f.name == "run" -> break f } ?? panic("run")
    task_group: loop stmt in run.body { if stmt == .TaskGroup(_, _, _, body, _) -> break body } ?? panic("task group")
    binding: loop stmt in task_group { if stmt == .Val(b) -> break b } ?? panic("binding")
    if binding.init == {
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _) -> {
            assert(method == parser_test_task_name("spawn"))
            assert(args.len() == 1)
            assert(if args[0].expr == {
                .Lambda(_, _) -> true
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            })
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> panic("expected task work() MethodCall")
    }
}
