#Test("arrow_else_if_chain_becomes_one_arm_table") {
    source :: "fn run() {{\n    if false -> print(\"a\") else if true -> print(\"b\") else -> print(\"c\")\n}}\n"
    assert(arm_table_fix_all(source) == "fn run() {{\n    if {{\n        false -> print(\"a\")\n        true -> print(\"b\")\n        else -> print(\"c\")\n    }}\n}}\n")
}
