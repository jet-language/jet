#Test("multi_line_value_branch_becomes_a_value_table") {
    source :: "fn run() {{\n    answer :: if true -> {{\n        value :: 40 + 2\n        value\n    }} else -> 0\n    print(answer)\n}}\n"
    assert(arm_table_fix_all(source) == "fn run() {{\n    answer :: if {{\n        true -> {{\n            value :: 40 + 2\n            value\n        }}\n        else -> 0\n    }}\n    print(answer)\n}}\n")
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:2452
#Test("nested_chains_converge_across_fix_rounds") {
    source :: "fn run(a: Bool, b: Bool) {{\n    if a {{\n        if b {{\n            print(\"1\")\n        }} else if a {{\n            print(\"2\")\n        }}\n    }} else if b {{\n        print(\"3\")\n    }}\n}}\n"
    diagnostics :: arm_table_checked(source)
    assert(arm_table_edits(diagnostics).len() == 2)
    fixed :: arm_table_fix_all(source)
    assert(fixed.contains("            b -> {{"))
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:2461
#Test("comment_between_branches_keeps_the_warning_without_an_edit") {
    source :: "fn run(a: Bool) {{\n    if a {{\n        print(\"x\")\n    }} /* keep */ else if !a {{\n        print(\"y\")\n    }}\n}}\n"
    diagnostics :: arm_table_checked(source)
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "L0507" {
            found = true
            assert(diagnostic.edit == None, "a comment would be lost")
            break
        }
    }
    assert(found, "the chain still warns")
}
// A module binding whose value only lints (L0507) is still a declaration, as
// Rust `module_binding_def` keeps every binding that parsed without an error.
#Test("linted_else_if_module_binding_stays_a_declaration") {
    source :: "LIMIT :: if 1 <= 0 -> 4 else if 2 == 8 -> 5 else -> 6\nNEXT :: LIMIT + 1\n"
    diagnostics :: arm_table_checked(source)
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "L0507" -> found = true
    }
    assert(found, "the chain warns")
    program :: parser_test_program(source)
    assert(program.items.len() == 2 && program.script_body.len() == 0, "both bindings are declarations")
    assert(if program.items[0] == .Const(value) -> value.name == "LIMIT" else -> false, "the linted binding is kept")
    assert(if program.items[1] == .Const(value) -> value.name == "NEXT" else -> false, "the following binding is kept")
}
