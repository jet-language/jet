// An authored `;` after nested control in a fallback block is not a synthetic
// terminator: it is reported as the explicit-semicolon diagnostic E0373 at
// exactly that `;` (Rust `report_explicit_semicolon`).
#Test("fallback_block_rejects_authored_semicolon_after_nested_control") {
    source: "\nrun: fn(value: Int?) {{\n    result: value ?? {{\n        loop {{\n            break\n        }};\n        1\n    }}\n}}\n"
    diagnostics: value_block_rejected(source)
    semicolon: parser_test_find(source, "}};")
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0373" && diagnostic.span == (Val(Span{start: semicolon + 1, end: semicolon + 2})) -> found = true
    }
    assert(found, "authored semicolon must not be treated as a synthetic terminator")
}

arm_table_checked: fn(source: String) -> [Diagnostic] {
    lexed: lex(source.bytes())
    assert(lexed.diagnostics.is_empty(), "lex")
    admission: parser_test_result(source)
    loop diagnostic in admission.diagnostics -> assert(diagnostic.severity != 1, "parse")
    admission.diagnostics
}
arm_table_edits: fn(diagnostics: [Diagnostic]) -> [TextEdit] {
    edits := [TextEdit]{}
    loop diagnostic in diagnostics {
        if diagnostic.code != "L0507" -> next
        if diagnostic.edit == .Val(edit) {
            assert(diagnostic.applicability == (Val(DiagnosticFixApplicability.Safe)))
            edits.push(edit.copy())
        }
    }
    edits
}
arm_table_applied: fn(source: String, edit: TextEdit) -> String {
    out := [U8]{}
    bytes: source.bytes()
    loop index in 0..<edit.span.start -> out.push(bytes[index])
    loop byte in edit.new_text.bytes() -> out.push(byte)
    loop index in edit.span.end..<bytes.len() -> out.push(bytes[index])
    String.from_bytes(out) ?? panic("edit preserves UTF-8 source boundaries")
}
// Not ported: fix_all's same_tree assertion is blocked on the production
// JetParser port gap: canonical_program/CanonicalAST. Source/edit/diagnostic
// checks remain.
arm_table_fix_all: fn(source: String) -> String {
    text := source
    loop _ in 0..<8 {
        diagnostics: arm_table_checked(text)
        edits: arm_table_edits(diagnostics)
        if edits.is_empty() -> break
        text = arm_table_applied(text, edits[0])
    }
    diagnostics: arm_table_checked(text)
    loop diagnostic in diagnostics -> assert(diagnostic.code != "L0507" && diagnostic.severity != 1, "fixed source still warns or fails")
    text
}
#Test("braced_else_if_chain_becomes_one_arm_table") {
    source: "show: fn(score: Int) {{\n    if score >= 90 {{\n        print(\"a\")\n    }} else if score >= 80 {{\n        print(\"b\")\n    }} else {{\n        print(\"c\")\n    }}\n    print(\"done\")\n}}\n"
    assert(arm_table_fix_all(source) == "show: fn(score: Int) {{\n    if {{\n        score >= 90 -> {{\n            print(\"a\")\n        }}\n        score >= 80 -> {{\n            print(\"b\")\n        }}\n        else -> {{\n            print(\"c\")\n        }}\n    }}\n    print(\"done\")\n}}\n")
}
#Test("value_tail_chain_becomes_the_function_value_table") {
    source: "grade: fn(score: Int) -> String {{\n    if score >= 90 {{\n        return \"a\"\n    }} else if score >= 80 {{\n        return \"b\"\n    }} else {{\n        return \"c\"\n    }}\n}}\n"
    assert(arm_table_fix_all(source) == "grade: fn(score: Int) -> String {{\n    if {{\n        score >= 90 -> {{\n            return \"a\"\n        }}\n        score >= 80 -> {{\n            return \"b\"\n        }}\n        else -> {{\n            return \"c\"\n        }}\n    }}\n}}\n")
}
#Test("arrow_else_if_chain_becomes_one_arm_table") {
    source: "run: fn() {{\n    if false -> print(\"a\") else if true -> print(\"b\") else -> print(\"c\")\n}}\n"
    assert(arm_table_fix_all(source) == "run: fn() {{\n    if {{\n        false -> print(\"a\")\n        true -> print(\"b\")\n        else -> print(\"c\")\n    }}\n}}\n")
}
#Test("multi_line_value_branch_becomes_a_value_table") {
    source: "run: fn() {{\n    answer: if true -> {{\n        value: 40 + 2\n        value\n    }} else -> 0\n    print(answer)\n}}\n"
    assert(arm_table_fix_all(source) == "run: fn() {{\n    answer: if {{\n        true -> {{\n            value: 40 + 2\n            value\n        }}\n        else -> 0\n    }}\n    print(answer)\n}}\n")
}
#Test("nested_chains_converge_across_fix_rounds") {
    source: "run: fn(a: Bool, b: Bool) {{\n    if a {{\n        if b {{\n            print(\"1\")\n        }} else if a {{\n            print(\"2\")\n        }}\n    }} else if b {{\n        print(\"3\")\n    }}\n}}\n"
    diagnostics: arm_table_checked(source)
    assert(arm_table_edits(diagnostics).len() == 2)
    fixed: arm_table_fix_all(source)
    assert(fixed.contains("            b -> {{"))
}
#Test("comment_between_branches_keeps_the_warning_without_an_edit") {
    source: "run: fn(a: Bool) {{\n    if a {{\n        print(\"x\")\n    }} /* keep */ else if !a {{\n        print(\"y\")\n    }}\n}}\n"
    diagnostics: arm_table_checked(source)
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "L0507" {
            found = true
            assert(diagnostic.edit == None, "a comment would be lost")
            break
        }
    }
    assert(found, "the chain still warns")
}
// A module binding whose value only lints (L0507) is still a declaration, as
// Rust `module_binding_def` keeps every binding that parsed without an error.
#Test("linted_else_if_module_binding_stays_a_declaration") {
    source: "LIMIT: if 1 <= 0 -> 4 else if 2 == 8 -> 5 else -> 6\nNEXT: LIMIT + 1\n"
    diagnostics: arm_table_checked(source)
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "L0507" -> found = true
    }
    assert(found, "the chain warns")
    program: parser_test_program(source)
    assert(program.items.len() == 2 && program.script_body.len() == 0, "both bindings are declarations")
    assert(if program.items[0] == .Const(value) -> value.name == "LIMIT" else -> false, "the linted binding is kept")
    assert(if program.items[1] == .Const(value) -> value.name == "NEXT" else -> false, "the following binding is kept")
}

#Test("marked_result_handler_line_is_an_effect_statement") {
    program: value_block_parsed("\nrun: fn() {{\n    writer.write(1) ? done -> print(done) ! err -> {{\n        print(err)\n    }}\n}}\n")
    handler: loop item in program.items {
        if item == .Func(function) && function.name == "run" {
            assert(function.body.len() == 1, "the handler is one statement")
            if function.body[0] == .Expr(expr) -> break expr
        }
    } ?? panic("missing the marked handler statement")
    assert(if handler == .If(_, _, _, _, _, _, _) -> true else -> false, "the marked line is the compact Result handler")
}
