// Ports of the marker-row walks from the deleted (#6096 marker-registry-coverage).
// Each active row of the one marker source (Compiler/Prelude/Markers.jet, read as
// MARKER_SOURCE) is written at one of its own declared sites and driven through
// the parser, formatter and reflection.
use {
    jet_foundation.[Diagnostic, MARKER_SOURCE, SemaNameCase, TAppliedRule, TAppliedRuleArgKind, TAppliedRuleArgumentMenu, TAppliedRuleCatalog, foundation_core_argument_menus, rule_arg_declaration, sema_casing_has_case]
    jet_lexer.[lex, lex_generated]
    jet_parser.[jet_format_source, parse_generated_source, parse_source]
    jet_sema.[SemaScopeMembersMarkerRegistry, SemaScopeMembersMarkerRule, sema_comptime_reflection_marker_rule, sema_marker_rules_build_catalog, sema_scope_members_registry_add_applied_catalog, sema_taint_builtin_tag_names]
}

// The applied-rule catalog the checker builds (MarkerModules.jet
// `sema_marker_module_check`). The effect menu is seeded with the roots the
// placeholders need; the Rust walk read EFFECT_ROOTS the same way.
mrc_catalog: fn() -> TAppliedRuleCatalog {
    parsed: parse_generated_source(MARKER_SOURCE.bytes())
    assert(parsed.diagnostics.is_empty(), "the marker source must parse")
    menus: foundation_core_argument_menus(["IO", "FS"], sema_taint_builtin_tag_names()) ?? panic("the applied-rule argument menus must build")
    sema_marker_rules_build_catalog(parsed.program, MARKER_SOURCE, menus) ?? panic("the applied-rule catalog must build")
}

// Sites no source text can spell. An operator impl spells the Impl site after
// its header (`impl W.Add(Int) #Commutative { … }`).
mrc_site_is_source_renderable: fn(site: String) -> Bool { site != "Package" && site != "Operation" && site != "Text" }

// One placeholder per parameter; a closed menu offers its first variant.
mrc_placeholder: fn(kind: TAppliedRuleArgKind, source_type: String, menus: [TAppliedRuleArgumentMenu]) -> String {
    if rule_arg_declaration(source_type, menus) == .Val(menu) && menu.variants.len() > 0 -> return menu.variants[0].copy()
    if kind == {
        .String -> "\"x\""
        .Path -> "Path{{\"x\"}}"
        .Int -> "1"
        .Bool -> "true"
        .DurationOrString -> "1s"
        .DurationOrInstant -> "1s"
        .StringOrMenu -> "\"x\""
        .Ident -> "x"
        .Any -> "1"
        .EffectRoots -> "[FS.Write]"
    }
}

mrc_arguments_required: fn(rule: TAppliedRule) -> Bool {
    loop param in rule.signature.params {
        if param.default_source == None -> return true
    }
    rule.signature.params.is_empty() && rule.signature.variadic != None
}

// Parentheses exactly when the signature needs them.
mrc_spelling: fn(rule: TAppliedRule, menus: [TAppliedRuleArgumentMenu]) -> String {
    if rule.name == "Test" -> return "#Test(\"coverage\")"
    if !mrc_arguments_required(rule) -> return "#{rule.name}"
    if rule.name == "UnitFamily" -> return "#UnitFamily(Length, dimension)"
    args := [String]{}
    loop param in rule.signature.params {
        if param.default_source == None -> args.push(mrc_placeholder(param.kind, param.source_type, menus))
    }
    if args.is_empty() && rule.signature.variadic == .Val(kind) -> args.push(mrc_placeholder(kind, rule.signature.variadic_source_type ?? "", menus))
    first: if rule.name == {
        "Scrub" -> "X"
        "Undo" -> "inverse"
        "FX" -> "IO"
        "Target" -> "Web"
        "Pre" | "Post" -> "true"
        else -> ""
    }
    if first != "" -> args[0] = first
    "#{rule.name}({args.join(", ")})"
}

// The smallest whole program that puts `marker` at `site`.
mrc_program_at: fn(marker: String, rule: TAppliedRule, site: String) -> String? {
    if site == {
        "File" -> if marker.starts_with("#NoPrelude") -> return Val("#NoPrelude\nuse io: core.term\nrun: fn() {{\n    io.print(\"ok\")\n}}\n") else -> return Val("{marker}\nrun: fn() {{\n    print(\"ok\")\n}}\n")
        // The Rust walk wrote `c.lib: module`; a dotted user module now needs a
        // declared namespace (E0960), so the smallest module is `lib: module`.
        "Module" -> if marker.starts_with("#Bindgen") -> return Val("{marker} c.coverage.__bindgen__: module {{\n}}\n") else -> return Val("{marker} lib: module {{\n}}\n\nrun: fn() {{\n    print(\"ok\")\n}}\n")
        "Function" -> {
            if marker.starts_with("#Scrub") -> return Val("X: tag {{ deny: [IO] }}\n{marker} helper: fn(raw: #X String) -[]> String {{ return raw.copy() }}\n\nrun: fn() {{\n}}\n")
            if marker.starts_with("#Undo") -> return Val("inverse: fn() {{}}\n#[Unsafe(\"coverage\"), FFI(c), Undo(inverse)]\nhelper: fn() {{\n    \"\"\"void helper(void) {{}}\"\"\"\n}}\n\nrun: fn() {{\n}}\n")
            if marker.starts_with("#ABI") -> return Val("#Import c.demo: module {{\n    {marker} helper: fn(value: I32) -> I32 = \"helper\"\n}}\n\nrun: fn() {{\n}}\n")
            if marker.starts_with("#FFI") -> return Val("#[Unsafe(\"coverage\"), FFI(c)]\nhelper: fn() {{\n    \"\"\"void helper(void) {{}}\"\"\"\n}}\n\nrun: fn() {{\n}}\n")
            if rule.name == "Memo" -> return Val("{marker}\nhelper: fn() -[]> {{\n}}\n\nrun: fn() {{\n}}\n")
            return Val("{marker}\nhelper: fn() {{\n}}\n\nrun: fn() {{\n}}\n")
        }
        "Method" -> return Val("W: struct {{\n    a: Int\n\n    {marker}\n    helper: fn(self) {{\n    }}\n}}\n\nrun: fn() {{\n}}\n")
        "Type" -> if marker.starts_with("#UnitFamily") -> return Val("{marker} {{ meter }}\n\nrun: fn() {{\n}}\n") else -> return Val("{marker}\nW: struct {{\n    a: Int\n}}\n\nrun: fn() {{\n}}\n")
        "Field" -> if marker.starts_with("#Short") || marker.starts_with("#Env") || marker.starts_with("#Flag") -> return Val("#CLI\nW: struct {{\n    {marker} a: String\n}}\n\nrun: fn() {{\n}}\n") else -> return Val("W: struct {{\n    {marker} a: Int\n}}\n\nrun: fn() {{\n}}\n")
        "Variant" -> return Val("E: enum {{\n    {marker} A\n    B\n}}\n\nrun: fn() {{\n}}\n")
        "Impl" -> return Val("W: struct {{\n    a: Int\n}}\n\nimpl W.Add(Int) {marker} {{\n    add: fn(self, rhs: Int) -> W {{ return W{{a: self.a + rhs}} }}\n}}\n\nrun: fn() {{\n}}\n")
        "Block" -> return Val("run: fn() {{\n    {marker} {{\n        print(\"ok\")\n    }}\n}}\n")
        "Statement" -> return Val("run: fn() {{\n    {marker} print(\"ok\")\n}}\n")
        "Declaration" -> if marker.starts_with("#Persist") -> return Val("{marker} value := 1\n\nrun: fn() {{\n}}\n") else -> return Val("run: fn() {{\n    {marker} value: 1\n}}\n")
        "Constant" -> return Val("{marker} VALUE: #run 1\n\nrun: fn() {{\n}}\n")
        "Parameter" -> return Val("helper: fn({marker} a: Int) {{\n}}\n\nrun: fn() {{\n}}\n")
        "Expression" -> return Val("run: fn() {{\n    value: {marker}\n}}\n")
        "Test" -> return Val("{marker} {{\n    print(\"ok\")\n}}\n\nrun: fn() {{\n}}\n")
        "Arm" -> return Val("run: fn() {{\n    x: 1\n    if x == {{\n        1 -> print(\"one\") {marker}\n        else -> print(\"other\")\n    }}\n}}\n")
        else -> return None
    }
}

mrc_render: fn(diagnostics: [Diagnostic]) -> [String] { diagnostics.map(fn(diagnostic) { "{diagnostic.code}: {diagnostic.what}" }) }

// Diagnostics meaning "this marker did not reach its rule": any lex diagnostic,
// or the parser's closed vocabulary (E0927) or scope table (E0355) rejecting
// it.
mrc_rejected_the_marker: fn(source: String) -> [String] {
    generated: source.contains("#Bindgen")
    lexed: if generated -> lex_generated(source.bytes()) else -> lex(source.bytes())
    if !lexed.diagnostics.is_empty() -> return mrc_render(lexed.diagnostics)
    parsed: if generated -> parse_generated_source(source.bytes()) else -> parse_source(source.bytes())
    rejected := [String]{}
    loop diagnostic in parsed.diagnostics {
        if diagnostic.code == "E0927" || diagnostic.code == "E0355" -> rejected.push("{diagnostic.code}: {diagnostic.what}")
    }
    rejected
}

// (law zero, the reachable half): every active row can be written at one of its
// own declared sites and is recognized there. Known failing: #6192
// (#Commutative declares only the Impl site).
#Test("every_active_row_is_reachable_at_a_declared_site") {
    catalog: mrc_catalog()
    assert(catalog.rows.len() > 20, "the marker catalog must hold the active rows")
    ghosts := [String]{}
    loop rule in catalog.rows {
        marker: mrc_spelling(rule, catalog.argument_menus)
        renderable := [String]{}
        loop site in rule.sites {
            if mrc_site_is_source_renderable(site) -> renderable.push(site)
        }
        if renderable.is_empty() {
            ghosts.push("#{rule.name} declares only interior sites {rule.sites.join(", ")}, so no source can reach it")
            next
        }
        rejections := [String]{}
        reached := false
        loop site in renderable {
            source: mrc_program_at(marker, rule, site) ?? next
            rejected: mrc_rejected_the_marker(source)
            if rejected.is_empty() {
                reached = true
                break
            }
            rejections.push("  at {site}: {rejected.join("; ")}")
        }
        if !reached -> ghosts.push("`{marker}` is rejected at every site it declares:\n{rejections.join("\n")}")
    }
    assert_eq(ghosts.join("\n"), "")
}

// Every active row parses at a declared site without a marker rejection, formats to a
// fixed point, and resolves through the comptime reflection registry. The highlight half
// is tests/guards/grammar_highlight.jet
// `every_highlight_token_is_in_each_generated_section`, which checks every active marker
// row in each generated editor grammar. Known failing: #6191 (#Local/#Shared declarations
// fail to parse).
#Test("every_active_row_walks_parse_validate_format_highlight_reflect") {
    catalog: mrc_catalog()
    registry := SemaScopeMembersMarkerRegistry{applied_rules: catalog.rows, argument_menus: catalog.argument_menus, marker_rules: [SemaScopeMembersMarkerRule]{}, known_marker_names: [String]{}, function_allowed_markers: [String]{}, block_allowed_markers: [String]{}}
    assert(sema_scope_members_registry_add_applied_catalog(registry, catalog), "the applied catalog must register once")
    failures := [String]{}
    loop rule in catalog.rows {
        marker: mrc_spelling(rule, catalog.argument_menus)
        found := String?{None}
        loop site in rule.sites {
            if !mrc_site_is_source_renderable(site) -> next
            source: mrc_program_at(marker, rule, site) ?? next
            if mrc_rejected_the_marker(source).is_empty() {
                found = Val(source)
                break
            }
        }
        source: found ?? {
            failures.push("`{marker}` has no parseable declared site")
            next
        }
        if !source.contains("#Bindgen") {
            once: jet_format_source(source, false)
            if !once.ok {
                failures.push("`{marker}` format: {mrc_render(once.diagnostics).join("; ")}")
            } else {
                twice: jet_format_source(once.text, false)
                if !twice.ok || twice.text != once.text -> failures.push("`{marker}` formatted source does not round-trip")
            }
        }
        reflected: sema_comptime_reflection_marker_rule(registry, rule.name)
        if reflected == .Val(row) {
            if row.name != rule.name -> failures.push("`{marker}` reflects as `{row.name}`")
        } else {
            failures.push("`{marker}` is missing from reflection")
        }
    }
    assert_eq(failures.join("\n"), "")
}

// #4284 c67: every active row is named in the `marker` NameCase (PascalCase,
// as sema checks a marker declaration's name), so `#allow` or `#wire` can never
// be a second spelling of a rule.
#Test("every_active_row_name_is_marker_name_case") {
    catalog: mrc_catalog()
    assert(catalog.rows.len() > 20, "the marker catalog must hold the active rows")
    wrong := [String]{}
    loop rule in catalog.rows {
        if !sema_casing_has_case(rule.name, SemaNameCase.Pascal) -> wrong.push("#{rule.name}")
    }
    assert_eq(wrong.join(", "), "")
}
