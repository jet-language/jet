// A hole table `if H[_] { candidate -> body }` parses to the table written
// out by hand: each arm tests the header with its candidate in the hole.
use {
    jet_parser.[jet_format_source, jfmt_structure, parse_source]
}

hole_structure: fn(source: String) -> String {
    parsed: parse_source(source.bytes())
    loop diagnostic in parsed.diagnostics -> assert(diagnostic.severity != 1, "a hole table parses without errors")
    jfmt_structure(parsed.program)
}

hole_same_as: fn(hole: String, reference: String) {
    assert_eq(hole_structure(hole), hole_structure(reference))
}

#Test("a statement hole table is the guard table of filled headers") {
    hole_same_as(
        "pick: fn(n: Int) {{\n    if n % _ == 0 {{\n        15 -> print(\"FizzBuzz\")\n        3 -> print(\"Fizz\")\n        else -> print(\"{{n}}\")\n    }}\n}}\n",
        "pick: fn(n: Int) {{\n    if {{\n        n % 15 == 0 -> print(\"FizzBuzz\")\n        n % 3 == 0 -> print(\"Fizz\")\n        else -> print(\"{{n}}\")\n    }}\n}}\n",
    )
}

#Test("a value hole table is the value guard table of filled headers") {
    hole_same_as(
        "label: fn(n: Int) -> String {{\n    return if n % _ == 0 {{\n        15 -> \"FizzBuzz\"\n        5 -> \"Buzz\"\n        else -> \"{{n}}\"\n    }}\n}}\n",
        "label: fn(n: Int) -> String {{\n    return if {{\n        n % 15 == 0 -> \"FizzBuzz\"\n        n % 5 == 0 -> \"Buzz\"\n        else -> \"{{n}}\"\n    }}\n}}\n",
    )
}

#Test("guards after a candidate keep ordinary precedence") {
    hole_same_as(
        "gate: fn(n: Int, ready: Bool, emergency: Bool) {{\n    if probe(_) == n {{\n        2 && ready || emergency -> print(\"open\")\n    }}\n}}\n",
        "gate: fn(n: Int, ready: Bool, emergency: Bool) {{\n    if {{\n        (probe(2) == n && ready) || emergency -> print(\"open\")\n    }}\n}}\n",
    )
}

#Test("a candidate group tries each candidate in turn") {
    hole_same_as(
        "pick: fn(n: Int) {{\n    if probe(_) == n {{\n        (2 | 3) -> print(\"two or three\")\n        else -> print(\"other\")\n    }}\n}}\n",
        "pick: fn(n: Int) {{\n    if {{\n        probe(2) == n || probe(3) == n -> print(\"two or three\")\n        else -> print(\"other\")\n    }}\n}}\n",
    )
}

#Test("a parenthesized Bool candidate fills the hole whole") {
    hole_same_as(
        "sign: fn(n: Int) -> String {{\n    return if both(_, n > 0) {{\n        (n % 2 == 0) -> \"even\"\n        else -> \"other\"\n    }}\n}}\n",
        "sign: fn(n: Int) -> String {{\n    return if {{\n        both(n % 2 == 0, n > 0) -> \"even\"\n        else -> \"other\"\n    }}\n}}\n",
    )
}

#Test("a case candidate fills the hole as a value") {
    hole_same_as(
        "first: fn(limit: Int) -> String {{\n    return if wait(_) > limit {{\n        .Green -> \"green\"\n        else -> \"none\"\n    }}\n}}\n",
        "first: fn(limit: Int) -> String {{\n    return if {{\n        wait(.Green) > limit -> \"green\"\n        else -> \"none\"\n    }}\n}}\n",
    )
}

#Test("subject == _ is the comparison table over the subject") {
    hole_same_as(
        "area: fn(shape: Shape) -> Int {{\n    return if shape == _ {{\n        .Circle(r) -> 3 * r * r\n        .Square(side) -> side * side\n    }}\n}}\n",
        "area: fn(shape: Shape) -> Int {{\n    return if shape == {{\n        .Circle(r) -> 3 * r * r\n        .Square(side) -> side * side\n    }}\n}}\n",
    )
    hole_same_as(
        "grade: fn(score: Int) {{\n    if _ == score {{\n        100 -> print(\"perfect\")\n        else -> print(\"score\")\n    }}\n}}\n",
        "grade: fn(score: Int) {{\n    if score == {{\n        100 -> print(\"perfect\")\n        else -> print(\"score\")\n    }}\n}}\n",
    )
}

#Test("the formatter keeps a hole table as written") {
    source: "pick: fn(n: Int) -> String {{\n    if trace(_) == n {{\n        1 -> print(\"one\")\n        (2 | 3) -> print(\"two or three\")\n    }}\n    return if n % _ == 0 {{\n        15 -> \"FizzBuzz\"\n        else -> \"{{n}}\"\n    }}\n}}\n"
    formatted: jet_format_source(source, false)
    assert(formatted.ok)
    assert_eq(formatted.text, source)
    assert_eq(formatted.structure_change ?? "none", "none")
}

#Test("a case wildcard in an if condition is not a hole") {
    formatted: jet_format_source("pick: fn(r: Int?) {{\n  if r == .Val(_) {{\n  print(\"some\")\n  }}\n}}\n", false)
    assert(formatted.ok)
    assert_eq(formatted.text, "pick: fn(r: Int?) {{\n    if r == .Val(_) -> print(\"some\")\n}}\n")
}
