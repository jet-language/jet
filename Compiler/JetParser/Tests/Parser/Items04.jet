use JetParser.Parser.Items.[format_version_segment]
// Rust: crates/jet-parser/src/Parser/Items/helpers.rs:1-16 (no original inline tests)
#Test("version segment keeps decimal point for integral floats") {
    assert(format_version_segment(1.0) == "1.0")
    assert(format_version_segment(1.4) == "1.4")
    assert(format_version_segment(0.0) == "0.0")
    assert(format_version_segment(1.10) == "1.1")
}
