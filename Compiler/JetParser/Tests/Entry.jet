    result :: parser_test_result("fn pick(value: Int String!) -> String {{ value ? ok -> ok ? inner -> inner ! inner_error -> inner_error ! error -> error }}\n")
    assert(result.diagnostics.is_empty(), "nested Result handlers should parse: {result.diagnostics:Debug}")
}

// Rust: crates/jet-parser/src/lib.rs:263
#Test("result_handler_stays_distinct_from_neighboring_postfix_and_branch_forms") {
    source :: "\nfn optional() -> Success? {{ None }}\nfn fallible() Err! {{ Err(\"bad\") }}\nfn result() -> Success? Err! {{ Ok(1) }}\nfn run(value: Int Err!, optional: String) {{\n    propagated :: value\n    noted :: value?(\"context\")\n    chained :: optional?.len\n    negated :: !true\n    if value == {{\n        .Ok(ok) -> print(ok)\n        .Err(error) -> print(error)\n    }}\n    fallback :: value ?? 0\n}}\n"
    result :: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "neighboring Result syntax should keep its meanings: {result.diagnostics:Debug}")
}

// Rust: crates/jet-parser/src/lib.rs:286
#Test("result_handler_keeps_one_sided_pattern_checks_and_fallbacks") {
    source :: "\nfn run(value: Int Err!, maybe: Int?) {{\n    if value == .Ok(ok) -> print(ok)\n    if value == .Err(error) -> print(error)\n    fallback :: maybe ?? 0\n    value == .Ok(other) ?? return\n}}\n"
    result :: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "one-sided Result checks should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Switch(_, ok_arms, _, _) ?? panic("success switch")
    assert(!ok_arms.is_empty())
    ok_arms[0].cond == .PatternTest(_, ok_pattern, _) ?? panic("success pattern")
    ok_name := false
    loop name in pattern_binding_names(ok_pattern) { if name.name == "ok" -> ok_name = true }
    assert(ok_name)
    assert(if ok_pattern == { .Ok(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Ok"
 else -> false })
    function.body[1] == .Switch(_, err_arms, _, _) ?? panic("failure switch")
    assert(!err_arms.is_empty())
    err_arms[0].cond == .PatternTest(_, err_pattern, _) ?? panic("failure pattern")
    err_name := false
    loop name in pattern_binding_names(err_pattern) { if name.name == "error" -> err_name = true }
    assert(err_name)
    assert(if err_pattern == { .Err(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Err"
 else -> false })
    function.body[2] == .Val(binding) ?? panic("fallback binding")
    binding.init == .OrFallback(value, fallback, _, _) ?? panic("value fallback")
    assert(if value == { .Ident(name, _) -> name == "maybe"
 else -> false })
    fallback == .Value(fallback_value) ?? panic("value fallback")
    assert(if fallback_value == { .Int(_, _, _, _) -> true
 else -> false })
    function.body[3] == .Val(refutable) ?? panic("refutable binding")
    refutable.pattern == .Val(bind_pattern) ?? panic("refutable pattern")
    bind_pattern == .Refutable(pattern, return_fallback, _, _) ?? panic("refutable pattern")
    assert(if return_fallback == { .Return(returned, _) -> returned == None
 else -> false })
    other_name := false
    loop name in pattern_binding_names(pattern) { if name.name == "other" -> other_name = true }
    assert(other_name)
    assert(if pattern == { .Ok(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Ok"
 else -> false })
}

// Rust: crates/jet-parser/src/lib.rs:362
#Test("result_handler_reports_fixed_shape_errors_at_the_offending_token") {
    cases :: [
        (source: "fn pick(value: Int String!) -> String {{ value ? ok -> ok }}\n", expected: "A Result handler needs a `!` failure branch", code: "E0003"),
        (source: "fn pick(value: Int String!) -> String {{ value ? same -> same ! same -> same }}\n", expected: "A Result handler cannot bind both payloads to the same name", code: "E0003"),
        (source: "fn pick(value: Int String!) -> String {{ value ? _ -> value ! error -> error }}\n", expected: "A Result handler success branch needs a payload binding", code: "E0003"),
        (source: "fn pick(value: Int String!) -> String {{ value ? ok -> ok ! error -> error ! again -> again }}\n", expected: "A Result handler cannot have two failure branches", code: "E0003"),
    ]
    loop testcase in cases {
        source :: testcase.source
        expected :: testcase.expected
        code :: testcase.code
        result :: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "invalid handler should fail")
        found := false
        loop diagnostic in result.diagnostics {
            if diagnostic.what == expected {
                assert_eq(diagnostic.code, code)
                assert(diagnostic.span != None, "diagnostic needs an exact span")
                assert(!diagnostic.why.is_empty())
                assert(!diagnostic.fix.is_empty())
                found = true
                break
            }
        }
        assert(found, "missing {expected:Debug} in {result.diagnostics:Debug}")
    }
}

// Rust: crates/jet-parser/src/lib.rs:406
#Test("callable_policy_marker_keeps_one_typed_wrapper_chain") {
    result :: parser_test_result("#Policy(retry(3), trace(\"users.load\"))\nfn load_user(id: Int) -> Int {{ return id }}\n")
    assert(result.diagnostics.is_empty(), "callable policy marker should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    found := false
    loop marker in function.markers {
        if marker.name == "Policy" {
            assert(if marker.args[0] == { .Expr(.Call(call)) -> call.name == "retry" else -> false })
            assert(if marker.args[1] == { .Expr(.Call(call)) -> call.name == "trace" else -> false })
            found = true
            break
        }
    }
    assert(found, "policy marker")
}

// Rust: crates/jet-parser/src/lib.rs:430
#Test("retired_memory_policy_names_point_to_effect_denials") {
    loop testcase in [
        (source: "#Policy(no_alloc)\nfn run() {{}}\n", replacement: "!Mem.Alloc"),
        (source: "#Policy(zero_rc)\nfn run() {{}}\n", replacement: "!Mem.Rc"),
        (source: "#Policy(arena_bounded(65536))\nfn run() {{}}\n", replacement: "!Mem.Alloc(above: 65536)"),
    ] {
        source :: testcase.source
        replacement :: testcase.replacement
        result :: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "memory floor words are retired")
        found := false
        loop diagnostic in result.diagnostics { if diagnostic.code == "E0355" && diagnostic.fix.contains(replacement) -> found = true }
        assert(found)
    }
}

