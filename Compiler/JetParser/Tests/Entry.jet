// Rust: crates/jet-parser/src/lib.rs:86
#Test("generic_module_retains_symbolic_fixed_length_and_nested_modules") {
    result :: parser_test_result("module buffer<T>(capacity: Int) {{ struct Data {{ items: [T#capacity] }} module stats {{ fn size() -> Int {{ return capacity }} }} }}")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:Debug}")
    result.program.items[0] == .GenericModule(def) ?? panic("template")
    def.body[0] == .Struct(data) ?? panic("struct")
    assert(if data.fields[0].ty == { .FixedList(_, .Symbol(_, name)) -> name == "capacity" else -> false })
    assert(if def.body[1] == { .CodeModule(child) -> child.name == "stats" else -> false })
}

