// Rust: crates/jet-parser/src/lib.rs:473
#Test("comptime_braced_values_accept_implicit_eof_termination") {
    loop suffix in ["", "\n", " // trailing comment"] {
        loop testcase in [
            (source: "CORE_MODULE_EXPORTS :: CoreModuleExportNames{{ name: \"core\" }}{suffix}", typed_array: false),
            (source: "CORE_MODULE_EXPORTS :: [CoreModuleExportNames]{{ CoreModuleExportNames{{ name: \"core\" }} }}{suffix}", typed_array: true),
        ] {
            source :: testcase.source
            typed_array :: testcase.typed_array
            result :: parser_test_result(source)
            assert(result.diagnostics.is_empty(), "complete comptime value: {result.diagnostics:Debug}")
            assert(result.program.items.len() == 1, "{source:Debug}")
            result.program.items[0] == .Const(def) ?? panic("expected comptime declaration: {source:Debug}")
            assert(def.span.end == expr_span(def.value).end, "{source:Debug}")
            if typed_array {
                def.value == .TypedLit(head, body, _) ?? panic("typed array")
                assert(if head == { .Val(.List(_)) -> true
 else -> false })
                assert(if body == { .Elements(elements) -> elements.len() == 1
 else -> false })
            } else {
                assert(if def.value == { .StructLit(type_name, _, _, _, fields, _, _) -> type_name == "CoreModuleExportNames" && fields.len() == 1
 else -> false })
            }
        }
    }
}

// Rust: crates/jet-parser/src/lib.rs:519
#Test("comptime_eof_termination_keeps_newline_item_boundaries") {
