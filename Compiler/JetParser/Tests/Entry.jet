// Rust: crates/jet-parser/src/lib.rs:112
#Test("script_statements_survive_items_and_formatter") {
    source :: "print(\"first\")\nfn helper() {{}}\nprint(\"last\")\n"
    result :: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "script should parse: {result.diagnostics:Debug}")
    program :: result.program
    assert_eq(program.script_body.len(), 2)
    program.script_body[0] == .Expr(first_statement) ?? panic("first loose expression")
    program.script_body[1] == .Expr(last_statement) ?? panic("last loose expression")
    assert(expr_span(first_statement).start < expr_span(last_statement).start, "loose statements must retain authored source order")
    found := false
    loop item in program.items {
        if item == .Func(function) && function.name == "helper" -> found = true
    }
    assert(found)
    formatted :: parser_test_format(source)
    assert(formatted.contains("print(\"first\")"), formatted)
    assert(formatted.contains("print(\"last\")"), formatted)
    assert(!formatted.contains("fn run"), "formatter must keep script syntax: {formatted}")
}

// Rust: crates/jet-parser/src/lib.rs:136
#Test("result_handler_desugars_to_ok_and_err_value_tests") {
    result :: parser_test_result("fn pick(value: Int String!) -> String {{ value ? ok -> ok ! error -> error }}\n")
    assert(result.diagnostics.is_empty(), "Result handler should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Expr(handler) ?? panic("Result handler should lower as a value if")
    handler == .If(ok_cond, _, ok_value, _, else_value, _) ?? panic("Result handler should lower as a value if")
    ok_cond == .PatternTest(ok_subject, ok_pattern, _) ?? panic("Result handler needs one success pattern")
    ok_pattern == .Ok(ok_binding, ok_binding_span, _, _) ?? panic("Result handler needs one success pattern")
    assert(if ok_subject == { .Ident(name, _) -> name == "value"
 else -> false })
    assert_eq(ok_binding, "ok")
    assert(if ok_value == { .Ident(name, _) -> name == "ok"
 else -> false })
    else_value == .If(err_cond, _, err_value, _, terminal, _) ?? panic("Result handler must retain its failure branch")
    err_cond == .PatternTest(err_subject, err_pattern, _) ?? panic("Result handler needs one failure pattern")
    err_pattern == .Err(err_binding, err_binding_span, _, _) ?? panic("Result handler needs one failure pattern")
    assert(if err_subject == { .Ident(name, _) -> name == "value"
 else -> false })
    assert_eq(err_binding, "error")
    assert(if err_value == { .Ident(name, _) -> name == "error"
 else -> false })
    assert(if terminal == { .NoElse(_) -> true
 else -> false })
    assert(ok_binding_span.end < err_binding_span.start)
    assert(expr_span(ok_cond).end < expr_span(err_cond).start)
}

// Rust: crates/jet-parser/src/lib.rs:213
#Test("result_handler_accepts_multiline_and_effectful_branches") {
    result :: parser_test_result("fn run(value: Int String!) Err! {{\n    value ? ok -> print(ok) // success\n    ! error -> print(error)\n}}\n")
    assert(result.diagnostics.is_empty(), "multiline Result handler should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Expr(handler) ?? panic("Result handler")
    handler == .If(cond, _, _, _, else_value, _) ?? panic("Result handler")
    cond == .PatternTest(subject, pattern, _) ?? panic("success pattern")
    assert(if subject == { .Ident(name, _) -> name == "value"
 else -> false })
    assert(if pattern == { .Ok(binding, _, _, _) -> binding == "ok"
 else -> false })
    else_value == .If(err_cond, then_body, then_value, _, _, _) ?? panic("failure branch")
    err_cond == .PatternTest(_, err_pattern, _) ?? panic("failure pattern")
    assert(if err_pattern == { .Err(binding, _, _, _) -> binding == "error"
 else -> false })
    assert(then_body.is_empty())
    assert(if then_value == { .Call(call) -> call.name == "print"
 else -> false })
}

