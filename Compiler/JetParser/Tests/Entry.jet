// Rust: crates/jet-parser/src/lib.rs:699
#Test("typed_literal_bodies_keep_raw_backslashes") {
    src :: "fn run() {{\n    digits :: Pattern{{\"\\d+\"}}\n    text :: \"a\\nb\"\n    loc :: Pattern{{\"https://x/{{name}}\"}}\n}}\n"
    once :: parser_test_format(src)
    assert(once.contains("Pattern{{\"\\d+\"}}"), "formatter decoded a typed-literal slash:\n{once}")
    assert(once.contains("\"a\\nb\""), "formatter lost the plain-string newline escape:\n{once}")
    assert(once.contains("{{name}}"), "formatter dropped a typed-literal hole:\n{once}")
    twice :: parser_test_format(once)
    assert(once == twice, "typed-literal formatting must be idempotent")
}

// Rust: crates/jet-parser/src/lib.rs:723
#Test("numeric_literals_keep_ratified_spelling") {
    src :: "fn run() {{\npopulation :: 8_100_000_000\nred :: 0xFF\nperms :: 0o755\nflags :: 0b1010\navogadro :: 6.022e23\n}}\n"
    once :: parser_test_format(src)
    loop literal in ["8_100_000_000", "0xFF", "0o755", "0b1010", "6.022e23"] {
        assert(once.contains(literal), "formatter rewrote ratified literal `{literal}`:\n{once}")
    }
    twice :: parser_test_format(once)
    assert(once == twice, "numeric literal formatting must be idempotent")
}

// Rust: crates/jet-parser/src/lib.rs:747
fn parse_complete(source: String) {
    result :: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "complete dispatch program should parse: {result.diagnostics:Debug}")
}

// Rust: crates/jet-parser/src/lib.rs:753
#Test("or_pattern_arm_after_braceless_call_keeps_payloads_and_guard") {
    parse_complete("\nenum Conn {{\n    Active(Int)\n    Reconnecting(Int)\n    Idle(Int)\n    Closed\n}}\n\nfn classify(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) /* before pipe */ | /* after pipe */ .Reconnecting(id) /* before pipe */ | .Idle(id) /* before guard */ && id > 0 /* before arrow */ -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n")
}

// Rust: crates/jet-parser/src/lib.rs:775
#Test("or_pattern_arm_after_nested_value_dispatch_keeps_outer_boundary") {
    parse_complete("\nenum Conn {{\n    Active(Int)\n    Reconnecting(Int)\n    Idle(Int)\n    Closed\n}}\n\nfn classify_nested(c: Conn, code: Int) -> String {{\n    if c == {{\n        .Closed -> return if code == {{\n            0 -> \"zero\"\n            else -> \"other\"\n        }}\n        .Active(id) | .Reconnecting(id) | .Idle(id) /* before arrow */ -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n")
}

// Rust: crates/jet-parser/src/lib.rs:800
#Test("leading_dot_fluent_chain_stays_one_expression") {
    parse_complete("\nstruct Box {{\n    value: Int\n}}\n\nfn chain(value: Box) -> Box {{\n    return value\n        .next()\n        .finish()\n}}\n")
}

// Rust: crates/jet-parser/src/lib.rs:817
#Test("malformed_or_pattern_does_not_gain_a_terminator_boundary") {
    loop source in [
        "\nenum Conn {{\n    Active(Int)\n    Reconnecting(Int)\n    Closed\n}}\n\nfn trailing_pipe(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) | -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n",
        "\nenum Conn {{\n    Active(Int)\n    Reconnecting(Int)\n    Closed\n}}\n\nfn split_guard(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) | .Reconnecting(id)\n            && id > 0\n            -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n",
    ] {
        result :: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "malformed dispatch head must be rejected")
    }
}
