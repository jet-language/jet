use jet_foundation.[BindPattern, Expr, ForKind, GenericModuleParam, Item, LambdaBody, ModuleArg, OrFallback, ParseResult, Pattern, Program, Stmt, Type, TypedLitBody, expr_span, pattern_binding_names, stmt_span]
use jet_lexer.[lex]
use JetParser.Parser.Entry.[parse_tokens]
use JetParser.Formatter.Entry.[jet_format_source]

// Rust: crates/jet-parser/src/lib.rs:465
fn parse_source(source: String) -> ParseResult {
    lexed :: lex(source.bytes())
    assert(lexed.diagnostics.is_empty(), "{lexed.diagnostics:?}")
    parse_tokens(lexed.tokens)
}

// Rust: crates/jet-parser/src/lib.rs:21
#Test("generic_module_slots_remain_unresolved_until_sema_without_casing_heuristics") {
    result :: parse_source("module Weird<lower>(UPPER: Int) {{ fn ready() -> Bool {{ return true }} }}\nmodule Use :: Weird<String>(32)")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:?}")
    program :: result.program
    program.items[0] == .GenericModule(def) ?? panic("template")
    assert(if def.params[0] == { .Type(name, _, bound) -> name == "lower" && bound == None; else -> false })
    assert(if def.params[1] == { .Value(name, _, _) -> name == "UPPER"; else -> false })
    program.items[1] == .ModuleAlias(alias) ?? panic("alias")
    assert(if alias.args[0] == { .Type(_, _) -> true; else -> false })
    assert(if alias.args[1] == { .Value(_, _) -> true; else -> false })
}

// Rust: crates/jet-parser/src/lib.rs:41
#Test("generic_module_value_slots_parse_closed_identifier_led_expressions") {
    result :: parse_source("module retry(count: Int) {{ fn ready() -> Bool {{ return true }} }}\nmodule a :: retry(limit + 1)\nmodule b :: retry(compute())")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:?}")
    loop item in result.program.items[1..] {
        item == .ModuleAlias(alias) ?? panic("alias")
        assert(if alias.args[0] == { .Value(_, _) -> true; else -> false })
    }
}

// Rust: crates/jet-parser/src/lib.rs:55
#Test("generic_module_retired_mixed_angle_value_slot_teaches_parentheses") {
    result :: parse_source("module cache<K, capacity: Int> {{ fn size() Int :: capacity }}")
    assert(!result.diagnostics.is_empty(), "retired mixed parameter spelling")
    found := false
    loop diagnostic in result.diagnostics {
        if diagnostic.code == "E0003" && diagnostic.what.contains("parentheses") && diagnostic.fix.contains("capacity: Int") -> found = true
    }
    assert(found, "{result.diagnostics:?}")
}

// Rust: crates/jet-parser/src/lib.rs:71
#Test("generic_module_retired_equals_alias_teaches_coloncolon") {
    result :: parse_source("module cache<K>(capacity: Int) {{ fn size() Int :: capacity }}\nmodule old = cache<Int>(64)")
    assert(!result.diagnostics.is_empty(), "retired equals alias spelling")
    found := false
    loop diagnostic in result.diagnostics {
        if diagnostic.code == "E0003" && diagnostic.what.contains("::") && diagnostic.fix.contains("module old :: Target") -> found = true
    }
    assert(found, "{result.diagnostics:?}")
}

// Rust: crates/jet-parser/src/lib.rs:87
#Test("generic_module_retains_symbolic_fixed_length_and_nested_modules") {
    result :: parse_source("module buffer<T>(capacity: Int) {{ struct Data {{ items: [T#capacity] }} module stats {{ fn size() -> Int {{ return capacity }} }} }}")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:?}")
    result.program.items[0] == .GenericModule(def) ?? panic("template")
    def.body[0] == .Struct(data) ?? panic("struct")
    assert(if data.fields[0].ty == { .FixedList(_, len) -> len.symbol_name() == .Val("capacity"); else -> false })
    assert(if def.body[1] == { .CodeModule(module) -> module.name == "stats"; else -> false })
}

