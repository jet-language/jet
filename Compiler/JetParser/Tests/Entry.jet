// Rust: crates/jet-parser/src/lib.rs:474
#Test("comptime_braced_values_accept_implicit_eof_termination") {
    loop suffix in ["", "\n", " // trailing comment"] {
        loop (source, typed_array) in [
            ("CORE_MODULE_EXPORTS :: CoreModuleExportNames{{ name: \"core\" }}{suffix}", false),
            ("CORE_MODULE_EXPORTS :: [CoreModuleExportNames]{{ CoreModuleExportNames{{ name: \"core\" }} }}{suffix}", true),
        ] {
            result :: parse_source(source)
            assert(result.diagnostics.is_empty(), "complete comptime value: {result.diagnostics:?}")
            assert_eq(result.program.items.len(), 1, "{source:?}")
            result.program.items[0] == .Const(def) ?? panic("expected comptime declaration: {source:?}")
            assert_eq(def.span.end, expr_span(def.value).end, "{source:?}")
            if typed_array {
                def.value == .TypedLit(head, body, _) ?? panic("typed array")
                assert(if head == { .Val(.List(_)) -> true; else -> false })
                assert(if body == { .Elements(elements) -> elements.len() == 1; else -> false })
            } else {
                assert(if def.value == { .StructLit(type_name, _, _, _, fields, _, _) -> type_name == "CoreModuleExportNames" && fields.len() == 1; else -> false })
            }
        }
    }
}

// Rust: crates/jet-parser/src/lib.rs:520
#Test("comptime_eof_termination_keeps_newline_item_boundaries") {
