// Rust: crates/jet-parser/src/lib.rs:588
#Test("yielding_loop_keeps_numeric_stride_after_source") {
    result :: parse_source("fn run() {{\n    values :: loop i in 0..10, 2 -> i\n}}\n")
    assert(result.diagnostics.is_empty(), "genuine stride should parse: {result.diagnostics:?}")
    found := false
    loop item in result.program.items {
        if item == .Func(function) && function.name == "run" {
            binding_found := false
            loop stmt in function.body {
                if stmt == .Val(binding) {
                    binding.init == .CallValue(callee, _, _) ?? panic("expected collecting loop call, got {binding.init:?}")
                    callee == .Lambda(lambda) ?? panic("expected collecting loop lambda, got {callee:?}")
                    lambda.body == .Block(body) ?? panic("expected collecting loop block")
                    assert(!body.is_empty(), "expected one source loop, got {body:?}")
                    body[0] == .For(_, _, _, kind, _, _, _, _, _) ?? panic("expected one source loop, got {body:?}")
                    kind == .Range(_, _, step, _) ?? panic("expected range source, got {kind:?}")
                    step == .Val(.Int(value, _, _, _)) ?? panic("expected numeric stride, got {step:?}")
                    assert_eq(value, 2)
                    binding_found = true
                    break
                }
            }
            assert(binding_found, "loop binding")
            found = true
            break
        }
    }
    assert(found, "run function")
}

