#Test("shared_prefix_accepts_inferred_brace_values") {
    result :: parse_source("fn run() {{ value :: shared {{ count: 1 }} }}\n")
    assert(result.diagnostics.is_empty(), "shared must accept an inferred brace value: {result.diagnostics:?}")
}

// Rust: crates/jet-parser/src/lib.rs:113
#Test("script_statements_survive_items_and_formatter") {
    source :: "print(\"first\")\nfn helper() {{}}\nprint(\"last\")\n"
    result :: parse_source(source)
    assert(result.diagnostics.is_empty(), "script should parse: {result.diagnostics:?}")
    program :: result.program
    assert_eq(program.script_body.len(), 2)
    assert(stmt_span(program.script_body[0]).start < stmt_span(program.script_body[1]).start, "loose statements must retain authored source order")
    found := false
    loop item in program.items {
        if item == .Func(function) && function.name == "helper" -> found = true
    }
    assert(found)
    formatted :: jet_format_source(source).source ?? panic("script should format")
    assert(formatted.contains("print(\"first\")"), formatted)
    assert(formatted.contains("print(\"last\")"), formatted)
    assert(!formatted.contains("fn run"), "formatter must keep script syntax: {formatted}")
}

// Rust: crates/jet-parser/src/lib.rs:137
#Test("result_handler_desugars_to_ok_and_err_value_tests") {
    result :: parse_source("fn pick(value: Int String!) -> String -> value ? ok -> ok ! error -> error\n")
    assert(result.diagnostics.is_empty(), "Result handler should parse: {result.diagnostics:?}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Expr(handler) ?? panic("Result handler should lower as a value if")
    handler == .If(ok_cond, _, ok_value, _, else_value, _) ?? panic("Result handler should lower as a value if")
    ok_cond == .PatternTest(ok_subject, ok_pattern, _) ?? panic("Result handler needs one success pattern")
    ok_pattern == .Ok(ok_binding, ok_binding_span, _, _) ?? panic("Result handler needs one success pattern")
    assert(if ok_subject == { .Ident(name, _) -> name == "value"; else -> false })
    assert_eq(ok_binding, "ok")
    assert(if ok_value == { .Ident(name, _) -> name == "ok"; else -> false })
    else_value == .If(err_cond, _, err_value, _, terminal, _) ?? panic("Result handler must retain its failure branch")
    err_cond == .PatternTest(err_subject, err_pattern, _) ?? panic("Result handler needs one failure pattern")
    err_pattern == .Err(err_binding, err_binding_span, _, _) ?? panic("Result handler needs one failure pattern")
    assert(if err_subject == { .Ident(name, _) -> name == "value"; else -> false })
    assert_eq(err_binding, "error")
    assert(if err_value == { .Ident(name, _) -> name == "error"; else -> false })
    assert(if terminal == { .NoElse(_) -> true; else -> false })
    assert(ok_binding_span.end < err_binding_span.start)
    assert(expr_span(ok_cond).end < expr_span(err_cond).start)
}

// Rust: crates/jet-parser/src/lib.rs:214
#Test("result_handler_accepts_multiline_and_effectful_branches") {
    result :: parse_source("fn run(value: Int String!) Err! {{\n    value ? ok -> print(ok) // success\n    ! error -> print(error)\n}}\n")
    assert(result.diagnostics.is_empty(), "multiline Result handler should parse: {result.diagnostics:?}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Expr(handler) ?? panic("Result handler")
    handler == .If(cond, _, _, _, else_value, _) ?? panic("Result handler")
    cond == .PatternTest(subject, pattern, _) ?? panic("success pattern")
    assert(if subject == { .Ident(name, _) -> name == "value"; else -> false })
    assert(if pattern == { .Ok(binding, _, _, _) -> binding == "ok"; else -> false })
    else_value == .If(err_cond, then_body, then_value, _, _, _) ?? panic("failure branch")
    err_cond == .PatternTest(_, err_pattern, _) ?? panic("failure pattern")
    assert(if err_pattern == { .Err(binding, _, _, _) -> binding == "error"; else -> false })
    assert(then_body.is_empty())
    assert(if then_value == { .Call(call) -> call.name == "print"; else -> false })
}

// Rust: crates/jet-parser/src/lib.rs:256
#Test("result_handler_allows_nested_value_handlers") {
    result :: parse_source("fn pick(value: Int String!) -> String -> value ? ok -> ok ? inner -> inner ! inner_error -> inner_error ! error -> error\n")
    assert(result.diagnostics.is_empty(), "nested Result handlers should parse: {result.diagnostics:?}")
}

// Rust: crates/jet-parser/src/lib.rs:264
#Test("result_handler_stays_distinct_from_neighboring_postfix_and_branch_forms") {
    source :: "\nfn optional() -> Success? -> None\nfn fallible() Err! -> Err(\"bad\")\nfn result() -> Success? Err! -> Ok(1)\nfn run(value: Int Err!, optional: String) {{\n    propagated :: value\n    noted :: value?(\"context\")\n    chained :: optional?.len\n    negated :: !true\n    if value == {{\n        .Ok(ok) -> print(ok)\n        .Err(error) -> print(error)\n    }}\n    fallback :: value ?? 0\n}}\n"
    result :: parse_source(source)
    assert(result.diagnostics.is_empty(), "neighboring Result syntax should keep its meanings: {result.diagnostics:?}")
}

// Rust: crates/jet-parser/src/lib.rs:287
#Test("result_handler_keeps_one_sided_pattern_checks_and_fallbacks") {
    source :: "\nfn run(value: Int Err!, maybe: Int?) {{\n    if value == .Ok(ok) -> print(ok)\n    if value == .Err(error) -> print(error)\n    fallback :: maybe ?? 0\n    value == .Ok(other) ?? return\n}}\n"
    result :: parse_source(source)
    assert(result.diagnostics.is_empty(), "one-sided Result checks should parse: {result.diagnostics:?}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Switch(_, ok_arms, _, _) ?? panic("success switch")
    assert(!ok_arms.is_empty())
    ok_arms[0].cond == .PatternTest(_, ok_pattern, _) ?? panic("success pattern")
    ok_name := false
    loop name in pattern_binding_names(ok_pattern) { if name.name == "ok" -> ok_name = true }
    assert(ok_name)
    assert(if ok_pattern == { .Ok(_, _, _, _) -> true; .Variant(variant, _, _, _) -> variant == "Ok"; else -> false })
    function.body[1] == .Switch(_, err_arms, _, _) ?? panic("failure switch")
    assert(!err_arms.is_empty())
    err_arms[0].cond == .PatternTest(_, err_pattern, _) ?? panic("failure pattern")
    err_name := false
    loop name in pattern_binding_names(err_pattern) { if name.name == "error" -> err_name = true }
    assert(err_name)
    assert(if err_pattern == { .Err(_, _, _, _) -> true; .Variant(variant, _, _, _) -> variant == "Err"; else -> false })
    function.body[2] == .Val(binding) ?? panic("fallback binding")
    binding.init == .OrFallback(value, fallback, _, _) ?? panic("value fallback")
    assert(if value == { .Ident(name, _) -> name == "maybe"; else -> false })
    fallback == .Value(fallback_value) ?? panic("value fallback")
    assert(if fallback_value == { .Int(_, _, _, _) -> true; else -> false })
    function.body[3] == .Val(refutable) ?? panic("refutable binding")
    refutable.pattern == .Val(bind_pattern) ?? panic("refutable pattern")
    bind_pattern == .Refutable(pattern, return_fallback, _) ?? panic("refutable pattern")
    assert(if return_fallback == { .Return(value, _) -> value == None; else -> false })
    other_name := false
    loop name in pattern_binding_names(pattern) { if name.name == "other" -> other_name = true }
    assert(other_name)
    assert(if pattern == { .Ok(_, _, _, _) -> true; .Variant(variant, _, _, _) -> variant == "Ok"; else -> false })
}

// Rust: crates/jet-parser/src/lib.rs:363
#Test("result_handler_reports_fixed_shape_errors_at_the_offending_token") {
    cases :: [
        ("fn pick(value: Int String!) -> String -> value ? ok -> ok\n", "A Result handler needs a `!` failure branch", "E0003"),
        ("fn pick(value: Int String!) -> String -> value ? same -> same ! same -> same\n", "A Result handler cannot bind both payloads to the same name", "E0003"),
        ("fn pick(value: Int String!) -> String -> value ? _ -> value ! error -> error\n", "A Result handler success branch needs a payload binding", "E0003"),
        ("fn pick(value: Int String!) -> String -> value ? ok => ok ! error -> error\n", "This uses a retired arrow spelling", "E0070"),
        ("fn pick(value: Int String!) -> String -> value ? ok -> ok ! error -> error ! again -> again\n", "A Result handler cannot have two failure branches", "E0003"),
    ]
    loop (source, expected, code) in cases {
        result :: parse_source(source)
        assert(!result.diagnostics.is_empty(), "invalid handler should fail")
        found := false
        loop diagnostic in result.diagnostics {
            if diagnostic.what == expected {
                assert_eq(diagnostic.code, code)
                assert(diagnostic.span != None, "diagnostic needs an exact span")
                assert(!diagnostic.why.is_empty())
                assert(!diagnostic.fix.is_empty())
                found = true
                break
            }
        }
        assert(found, "missing {expected:?} in {result.diagnostics:?}")
    }
}

// Rust: crates/jet-parser/src/lib.rs:407
#Test("callable_policy_marker_keeps_one_typed_wrapper_chain") {
    result :: parse_source("#Policy(retry(3), trace(\"users.load\"))\nfn load_user(id: Int) -> Int {{ return id }}\n")
    assert(result.diagnostics.is_empty(), "callable policy marker should parse: {result.diagnostics:?}")
    result.program.items[0] == .Func(function) ?? panic("function")
    found := false
    loop marker in function.markers {
        if marker.name == "Policy" {
            assert(if marker.args[0].as_expr() == { .Val(.Call(call)) -> call.name == "retry"; else -> false })
            assert(if marker.args[1].as_expr() == { .Val(.Call(call)) -> call.name == "trace"; else -> false })
            found = true
            break
        }
    }
    assert(found, "policy marker")
}

// Rust: crates/jet-parser/src/lib.rs:431
#Test("retired_memory_policy_names_point_to_effect_denials") {
    loop (source, replacement) in [
        ("#Policy(no_alloc)\nfn run() {{}}\n", "!Mem.Alloc"),
        ("#Policy(zero_rc)\nfn run() {{}}\n", "!Mem.Rc"),
        ("#Policy(arena_bounded(65536))\nfn run() {{}}\n", "!Mem.Alloc(above: 65536)"),
    ] {
        result :: parse_source(source)
        assert(!result.diagnostics.is_empty(), "memory floor words are retired")
        found := false
        loop diagnostic in result.diagnostics { if diagnostic.code == "E0355" && diagnostic.fix.contains(replacement) -> found = true }
        assert(found)
    }
}

