use jet_foundation.[expr_span, pattern_binding_names, type_name]

#Test("generic_module_slots_remain_unresolved_until_sema_without_casing_heuristics") {
    result: parser_test_result("Weird: module<lower>(UPPER: Int) {{ ready: fn() -> Bool {{ return true }} }}\nUse: Weird<String>(32)")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:Debug}")
    program: result.program
    program.items[0] == .GenericModule(def) ?? panic("template")
    assert(if def.params[0] == { .Type(name, _, bound) -> name == "lower" && bound == None
 .Value(_, _, _) -> false })
    assert(if def.params[1] == { .Value(name, _, _) -> name == "UPPER"
 .Type(_, _, _) -> false })
    program.items[1] == .ModuleAlias(alias) ?? panic("alias")
    assert(if alias.args[0] == { .Type(_, _) -> true
 .Value(_, _) -> false })
    assert(if alias.args[1] == { .Value(_, _) -> true
 .Type(_, _) -> false })
}

#Test("generic_module_value_slots_parse_closed_identifier_led_expressions") {
    result: parser_test_result("retry: module(count: Int) {{ ready: fn() -> Bool {{ return true }} }}\na: retry(limit + 1)\nb: retry(compute())")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:Debug}")
    loop index in 1..<result.program.items.len() {
        item: result.program.items[index]
        item == .ModuleAlias(alias) ?? panic("alias")
        assert(if alias.args[0] == { .Value(_, _) -> true
 .Type(_, _) -> false })
    }
}

// The Rust parser also teaches the `::` respelling; retired spellings carry no
// teaching any more, so only the rejection remains. (teaching for a `<K,
// capacity: Int>` value slot) has no parser claim left: a bounded type
// parameter is valid syntax and sema judges the bound.
#Test("generic_module_equals_alias_is_rejected") {
    result: parser_test_result("cache: module<K>(capacity: Int) {{ size: fn() -> Int {{ return capacity }} }}\nold: module = cache<Int>(64)")
    assert(!result.diagnostics.is_empty(), "equals alias spelling")
}

#Test("generic_module_retains_symbolic_fixed_length_and_nested_modules") {
    result: parser_test_result("buffer: module<T>(capacity: Int) {{ Data: struct {{ items: [T#capacity] }} stats: module {{ size: fn() -> Int {{ return capacity }} }} }}")
    assert(result.diagnostics.is_empty(), "{result.diagnostics:Debug}")
    result.program.items[0] == .GenericModule(def) ?? panic("template")
    def.body[0] == .Struct(data) ?? panic("struct")
    assert(if data.fields[0].ty == {
        .FixedList(_, .Symbol(_, name)) -> name == "capacity"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    })
    assert(if def.body[1] == {
        .CodeModule(child) -> child.name == "stats"
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    })
}

#Test("retired_shared_prefix_is_an_ordinary_parse_error") {
    result: parser_test_result("run: fn() {{ value: shared 1 }}\n")
    assert(!result.diagnostics.is_empty(), "`shared 1` must not parse as a shared cell")
}

#Test("script_statements_survive_items_and_formatter") {
    source: "print(\"first\")\nhelper: fn() {{}}\nprint(\"last\")\n"
    result: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "script should parse: {result.diagnostics:Debug}")
    program: result.program
    assert_eq(program.script_body.len(), 2)
    program.script_body[0] == .Expr(first_statement) ?? panic("first loose expression")
    program.script_body[1] == .Expr(last_statement) ?? panic("last loose expression")
    assert(expr_span(first_statement).start < expr_span(last_statement).start, "loose statements must retain authored source order")
    found := false
    loop item in program.items {
        if item == .Func(function) && function.name == "helper" -> found = true
    }
    assert(found)
    formatted: parser_test_format(source)
    assert(formatted.contains("print(\"first\")"), formatted)
    assert(formatted.contains("print(\"last\")"), formatted)
    assert(!formatted.contains("run: fn"), "formatter must keep script syntax: {formatted}")
}

// #6281: `,` separates the arms of a pattern table, so a two-way Result
// split fits on one line; a trailing `,` is optional.
#Test("compact_value_table_separates_arms_with_commas") {
    sources: [
        "pick: fn(value: Int String!) -> String {{ if value == {{ .Ok(ok) -> ok, .Err(error) -> error }} }}\n",
        "pick: fn(value: Int String!) -> String {{ if value == {{ .Ok(ok) -> ok, .Err(error) -> error, }} }}\n",
        "pick: fn(value: Int String!) -> String {{\n    if value == {{\n        .Ok(ok) -> ok,\n        .Err(error) -> error,\n    }}\n}}\n",
    ]
    loop source in sources {
        result: parser_test_result(source)
        assert(result.diagnostics.is_empty(), "compact table should parse: {result.diagnostics:Debug}")
        result.program.items[0] == .Func(function) ?? panic("function")
        function.body[0] == .Expr(table) ?? panic("the table is the body's value")
        table == .If(ok_cond, _, _, _, else_value, _, _) ?? panic("value table")
        assert(ok_cond == .PatternTest(_, _, _, _), "first arm tests a pattern")
        else_value == .If(err_cond, _, _, _, terminal, _, _) ?? panic("second arm")
        assert(err_cond == .PatternTest(_, _, _, _), "second arm tests a pattern")
        assert(terminal == .NoElse(_, _), "an all-pattern table ends without a fallback")
    }
}

#Test("compact_tables_end_statement_and_control_arms_at_commas") {
    sources: [
        "run: fn(value: Int String!) {{\n    if value == {{ .Ok(ok) -> print(ok), .Err(error) -> print(error) }}\n}}\n",
        "run: fn(flag: Bool) {{\n    if {{ flag -> print(1), else -> print(2), }}\n}}\n",
        "pick: fn(k: Int) -> Int {{\n    if k == {{ 0 -> return 1, else -> k }}\n}}\n",
        "pick: fn(k: Int) -> Int {{\n    loop {{\n        if k == {{ 0 -> break, else -> print(k) }}\n    }}\n    k\n}}\n",
        "pick: fn(k: Int) -> Int {{\n    loop {{\n        if k == {{ 0 -> next, 1 -> break, else -> break k }}\n    }}\n}}\n",
        "run: fn(k: Int) {{\n    if k == {{ 0 -> return, else -> print(k) }}\n}}\n",
        "pick: fn(value: Int String!) -> Int {{ if value == {{ .Ok(ok) -> if ok == {{ 0 -> 1, else -> ok }}, .Err(_) -> 0 }} }}\n",
    ]
    loop source in sources {
        result: parser_test_result(source)
        assert(result.diagnostics.is_empty(), "{source}: {result.diagnostics:Debug}")
    }
    statement: parser_test_result("run: fn(value: Int String!) {{\n    if value == {{ .Ok(ok) -> print(ok), .Err(error) -> print(error) }}\n}}\n")
    statement.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Switch(_, arms, _, _) ?? panic("statement table")
    assert_eq(arms.len(), 2)
}

#Test("compact_table_commas_stay_between_arms") {
    sources: [
        "pick: fn(k: Int) -> Int {{ if k == {{ 0 -> 1,, else -> k }} }}\n",
        "pick: fn(k: Int) -> Int {{ if k == {{ , 0 -> 1, else -> k }} }}\n",
    ]
    loop source in sources {
        result: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "{source} must not parse")
    }
}

#Test("compact_tables_keep_their_authored_line_shape_in_the_formatter") {
    one_line: "pick: fn(value: Int String!) -> String {{\n    if value == {{ .Ok(ok) -> ok, .Err(error) -> error }}\n}}\n"
    assert_eq(parser_test_format(one_line), one_line)
    trailing: "pick: fn(value: Int String!) -> String {{\n    if value == {{ .Ok(ok) -> ok, .Err(error) -> error, }}\n}}\n"
    assert_eq(parser_test_format(trailing), one_line)
    statement: "run: fn(value: Int String!) {{\n    if value == {{ .Ok(ok) -> print(ok), .Err(error) -> print(error) }}\n}}\n"
    assert_eq(parser_test_format(statement), statement)
    guard: "run: fn(flag: Bool) {{\n    if {{ flag -> print(1), else -> print(2) }}\n}}\n"
    assert_eq(parser_test_format(guard), guard)
    expanded: "pick: fn(value: Int String!) -> String {{\n    if value == {{\n        .Ok(ok) -> ok\n        .Err(error) -> error\n    }}\n}}\n"
    assert_eq(parser_test_format(expanded), expanded)
    with_commas: "pick: fn(value: Int String!) -> String {{\n    if value == {{\n        .Ok(ok) -> ok,\n        .Err(error) -> error,\n    }}\n}}\n"
    assert_eq(parser_test_format(with_commas), expanded)
    commented: parser_test_format("pick: fn(value: Int String!) -> String {{\n    if value == {{ .Ok(ok) -> ok, /* failure */ .Err(error) -> error }}\n}}\n")
    assert(!commented.contains("-> ok, "), commented)
    wide: parser_test_format("pick: fn(value: Int String!) -> String {{\n    if value == {{ .Ok(ok) -> \"a long success text for this one table\", .Err(error) -> \"and a long failure text\" }}\n}}\n")
    assert(wide.contains("\n        .Ok(ok) -> "), wide)
}

#Test("result_neighboring_postfix_and_branch_forms_keep_their_meanings") {
    source: "\noptional: fn() -> Success? {{ None }}\nfallible: fn() Err! {{ Err(\"bad\") }}\nresult: fn() -> Success? Err! {{ Ok(1) }}\nrun: fn(value: Int Err!, optional: String) {{\n    propagated: value\n    noted: value?(\"context\")\n    chained: optional?.len\n    negated: !true\n    if value == {{\n        .Ok(ok) -> print(ok)\n        .Err(error) -> print(error)\n    }}\n    fallback: value ?? 0\n}}\n"
    result: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "neighboring Result syntax should keep its meanings: {result.diagnostics:Debug}")
}

#Test("result_one_sided_pattern_checks_and_fallbacks_parse") {
    source: "\nrun: fn(value: Int Err!, maybe: Int?) {{\n    if value == .Ok(ok) -> print(ok)\n    if value == .Err(error) -> print(error)\n    fallback: maybe ?? 0\n    value == .Ok(other) ?? return\n}}\n"
    result: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "one-sided Result checks should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    function.body[0] == .Switch(_, ok_arms, _, _) ?? panic("success switch")
    assert(!ok_arms.is_empty())
    ok_arms[0].cond == .PatternTest(_, ok_pattern, _, _) ?? panic("success pattern")
    ok_name := false
    loop name in pattern_binding_names(ok_pattern) { if name.name == "ok" -> ok_name = true }
    assert(ok_name)
    assert(if ok_pattern == { .Ok(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Ok"
 .Present(_, _, _, _) | .Absent(_) | .Err(_, _, _, _) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _, _, _) | .List(_, _, _) | .Map(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> false })
    function.body[1] == .Switch(_, err_arms, _, _) ?? panic("failure switch")
    assert(!err_arms.is_empty())
    err_arms[0].cond == .PatternTest(_, err_pattern, _, _) ?? panic("failure pattern")
    err_name := false
    loop name in pattern_binding_names(err_pattern) { if name.name == "error" -> err_name = true }
    assert(err_name)
    assert(if err_pattern == { .Err(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Err"
 .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _, _, _) | .List(_, _, _) | .Map(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> false })
    function.body[2] == .Val(binding) ?? panic("fallback binding")
    binding.init == .OrFallback(value, fallback, _, _, _) ?? panic("value fallback")
    assert(if value == { .Ident(name, _, _) -> name == "maybe"
 .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false })
    fallback == .Value(fallback_value) ?? panic("value fallback")
    assert(if fallback_value == { .Int(_, _, _, _, _) -> true
 .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false })
    function.body[3] == .Val(refutable) ?? panic("refutable binding")
    refutable.pattern == .Val(bind_pattern) ?? panic("refutable pattern")
    bind_pattern == .Refutable(pattern, return_fallback, _, _) ?? panic("refutable pattern")
    assert(if return_fallback == { .Return(returned, _) -> returned == None
 .Value(_) | .Block(_, _, _) | .Panic(_, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> false })
    other_name := false
    loop name in pattern_binding_names(pattern) { if name.name == "other" -> other_name = true }
    assert(other_name)
    assert(if pattern == { .Ok(_, _, _, _) -> true
 .Variant(variant, _, _, _) -> variant == "Ok"
 .Present(_, _, _, _) | .Absent(_) | .Err(_, _, _, _) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _, _, _) | .List(_, _, _) | .Map(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> false })
}

// #6281: the retired result-only `value ? ok -> … ! err -> …` spelling is
// an ordinary parse error, with no teaching of its own.
#Test("retired_result_handler_spelling_does_not_parse") {
    sources: [
        "pick: fn(value: Int String!) -> String {{ value ? ok -> ok ! error -> error }}\n",
        "run: fn(value: Int String!) Err! {{\n    value ? ok -> print(ok)\n    ! error -> print(error)\n}}\n",
    ]
    loop source in sources {
        result: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "{source} must not parse")
        loop diagnostic in result.diagnostics {
            assert(!diagnostic.what.contains("Result handler"), "no handler teaching: {diagnostic.what}")
        }
    }
}

#Test("callable_policy_marker_keeps_one_typed_wrapper_chain") {
    result: parser_test_result("#Policy(retry(3), trace(\"users.load\"))\nload_user: fn(id: Int) -> Int {{ return id }}\n")
    assert(result.diagnostics.is_empty(), "callable policy marker should parse: {result.diagnostics:Debug}")
    result.program.items[0] == .Func(function) ?? panic("function")
    found := false
    loop marker in function.markers {
        if marker.name == "Policy" {
            assert(if marker.args[0] == {
                .Expr(.Call(call, _)) -> call.name == "retry"
                .Expr(_) | .EffectRow(_, _) -> false
            })
            assert(if marker.args[1] == {
                .Expr(.Call(call, _)) -> call.name == "trace"
                .Expr(_) | .EffectRow(_, _) -> false
            })
            found = true
            break
        }
    }
    assert(found, "policy marker")
}

#Test("memory floor words are not scoped policies") {
    loop source in ["#Policy(no_alloc)\nrun: fn() {{}}\n", "#Policy(zero_rc)\nrun: fn() {{}}\n"] {
        result: parser_test_result(source)
        found := false
        loop diagnostic in result.diagnostics { if diagnostic.code == "E0355" && diagnostic.fix.contains("`!Mem.*` effect denials") -> found = true }
        assert(found)
    }
}

#Test("a site-bound rule named as a policy points at its own site") {
    result: parser_test_result("#Policy(Unsafe)\nrun: fn() {{}}\n")
    found := false
    loop diagnostic in result.diagnostics { if diagnostic.code == "E0355" && diagnostic.why.contains("policy scope cannot widen them") && diagnostic.fix.contains("`#Unsafe` at its sound site") -> found = true }
    assert(found)
}

#Test("duplicate_callable_policy_markers_are_rejected") {
    result: parser_test_result("#Policy(trace(\"one\"))\n#Policy(trace(\"two\"))\nrun: fn() {{}}\n")
    assert(!result.diagnostics.is_empty(), "duplicate policy marker")
    found := false
    loop diagnostic in result.diagnostics { if diagnostic.code == "E0355" -> found = true }
    assert(found)
}

#Test("comptime_braced_values_accept_implicit_eof_termination") {
    loop suffix in ["", "\n", " // trailing comment"] {
        loop testcase in [
            (source: "CORE_MODULE_EXPORTS: CoreModuleExportNames{{ name: \"core\" }}{suffix}", typed_array: false),
            (source: "CORE_MODULE_EXPORTS: [CoreModuleExportNames]{{ CoreModuleExportNames{{ name: \"core\" }} }}{suffix}", typed_array: true),
        ] {
            source: testcase.source
            typed_array: testcase.typed_array
            result: parser_test_result(source)
            assert(result.diagnostics.is_empty(), "complete comptime value: {result.diagnostics:Debug}")
            assert(result.program.items.len() == 1, "{source:Debug}")
            result.program.items[0] == .Const(def) ?? panic("expected comptime declaration: {source:Debug}")
            assert(def.span.end == expr_span(def.value).end, "{source:Debug}")
            if typed_array {
                def.value == .TypedLit(head, body, _, _) ?? panic("typed array")
                assert(if head == { .Val(.List(_)) -> true
 .Val(_) | .None -> false })
                assert(if body == { .Elements(elements) -> elements.len() == 1
 .Fields(_) | .Entries(_) | .Value(_) | .ByteText(_) | .Empty -> false })
            } else {
                def.value == .TypedLit(head, body, _, _) ?? panic("typed struct literal")
                assert(if head == { .Val(.Named(name)) -> name == "CoreModuleExportNames"
 .Val(_) | .None -> false })
                assert(if body == { .Fields(fields) -> fields.len() == 1
 .Elements(_) | .Entries(_) | .Value(_) | .ByteText(_) | .Empty -> false })
            }
        }
    }
}

#Test("comptime_eof_termination_keeps_newline_item_boundaries") {
    source: "FIRST: CoreModuleExportNames{{ name: \"first\" }}\nSECOND: 2"
    result: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "newline separates comptime declarations: {result.diagnostics:Debug}")
    assert(result.program.items.len() == 2, "{source:Debug}")
    assert(if result.program.items[0] == { .Const(def) -> def.name == "FIRST"
 .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false })
    assert(if result.program.items[1] == { .Const(def) -> def.name == "SECOND"
 .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false })
}

#Test("comptime_eof_termination_still_rejects_incomplete_initializers") {
    source: "CORE_MODULE_EXPORTS: [CoreModuleExportNames]{{ CoreModuleExportNames{{ name: \"core\" }}"
    result: parser_test_result(source)
    assert(!result.diagnostics.is_empty(), "incomplete comptime initializer must fail")
    found := false
    loop diagnostic in result.diagnostics {
        if diagnostic.code == "E0003" && diagnostic.span == .Val(span) && span.start == source.bytes().len() && span.end == source.bytes().len() -> found = true
    }
    assert(found, "{result.diagnostics:Debug}")
}

#Test("comptime_eof_termination_still_rejects_unseparated_declarations") {
    source: "FIRST: CoreModuleExportNames{{ name: \"first\" }} SECOND: 2"
    second_start: parser_test_find(source, "SECOND")
    result: parser_test_result(source)
    assert(!result.diagnostics.is_empty(), "unseparated comptime declarations must fail")
    found := false
    loop diagnostic in result.diagnostics {
        if diagnostic.code == "E0003" && diagnostic.span == .Val(span) && span.start == second_start -> found = true
    }
    assert(found, "{result.diagnostics:Debug}")
}

#Test("separated_le_and_gt_still_reject_as_an_invalid_expression") {
    result: parser_test_result("run: fn() {{ return a <= > b }}")
    assert(!result.diagnostics.is_empty())
}

#Test("yielding_loop_keeps_numeric_stride_after_source") {
    result: parser_test_result("run: fn() {{\n    values: loop i in 0..10, 2 -> i\n}}\n")
    assert(result.diagnostics.is_empty(), "genuine stride should parse: {result.diagnostics:Debug}")
    found := false
    loop item in result.program.items {
        if item == .Func(function) && function.name == "run" {
            binding_found := false
            loop stmt in function.body {
                if stmt == .Val(binding) {
                    binding.init == .CallValue(callee, _, _, _) ?? panic("expected collecting loop call, got {binding.init:Debug}")
                    callee == .Lambda(lambda, _) ?? panic("expected collecting loop lambda, got {callee:Debug}")
                    lambda.body == .Block(body) ?? panic("expected collecting loop block")
                    assert(!body.is_empty(), "expected one source loop, got {body:Debug}")
                    body[0] == .For(_, _, _, kind, _, _, _, _, _) ?? panic("expected one source loop, got {body:Debug}")
                    kind == .Range(_, _, step, _) ?? panic("expected range source, got {kind:Debug}")
                    step == .Val(.Int(value, _, _, _, _)) ?? panic("expected numeric stride, got {step:Debug}")
                    assert_eq(value, 2)
                    binding_found = true
                    break
                }
            }
            assert(binding_found, "loop binding")
            found = true
            break
        }
    }
    assert(found, "run function")
}

#Test("source_loops_use_in_for_bindings_and_keep_stride_comma") {
    result: parser_test_result("\nrun: fn() {{\n    loop x in xs {{ print(x) }}\n    loop (key, value) in map {{ print(key, value) }}\n    loop n in 0..10, 2 {{ print(n) }}\n    filtered: loop x in xs if x > 0 -> x\n}}\n")
    assert(result.diagnostics.is_empty(), "canonical source-loop forms should parse: {result.diagnostics:Debug}")
}

#Test("in_is_reserved_for_source_loops") {
    result: parser_test_result("in: fn() {{}}\n")
    assert(!result.diagnostics.is_empty(), "`in` must not be an identifier")
    found := false
    loop diagnostic in result.diagnostics {
        if diagnostic.code == "E0003" && diagnostic.what.contains("reserved") && diagnostic.fix.contains("in") -> found = true
    }
    assert(found, "{result.diagnostics:Debug}")
}

#Test("typed_literal_bodies_keep_raw_backslashes") {
    src: "run: fn() {{\n    digits: Pattern{{\"\\d+\"}}\n    text: \"a\\nb\"\n    loc: Pattern{{\"https://x/{{name}}\"}}\n}}\n"
    once: parser_test_format(src)
    assert(once.contains("Pattern{{\"\\d+\"}}"), "formatter decoded a typed-literal slash:\n{once}")
    assert(once.contains("\"a\\nb\""), "formatter lost the plain-string newline escape:\n{once}")
    assert(once.contains("{{name}}"), "formatter dropped a typed-literal hole:\n{once}")
    twice: parser_test_format(once)
    assert(once == twice, "typed-literal formatting must be idempotent")
}

#Test("numeric_literals_keep_ratified_spelling") {
    src: "run: fn() {{\npopulation: 8_100_000_000\nred: 0xFF\nperms: 0o755\nflags: 0b1010\navogadro: 6.022e23\n}}\n"
    once: parser_test_format(src)
    loop literal in ["8_100_000_000", "0xFF", "0o755", "0b1010", "6.022e23"] {
        assert(once.contains(literal), "formatter rewrote ratified literal `{literal}`:\n{once}")
    }
    twice: parser_test_format(once)
    assert(once == twice, "numeric literal formatting must be idempotent")
}

parse_complete: fn(source: String) {
    result: parser_test_result(source)
    assert(result.diagnostics.is_empty(), "complete dispatch program should parse: {result.diagnostics:Debug}")
}

#Test("or_pattern_arm_after_braceless_call_keeps_payloads_and_guard") {
    parse_complete("\nConn: enum {{\n    Active(Int)\n    Reconnecting(Int)\n    Idle(Int)\n    Closed\n}}\n\nclassify: fn(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) /* before pipe */ | /* after pipe */ .Reconnecting(id) /* before pipe */ | .Idle(id) /* before guard */ && id > 0 /* before arrow */ -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n")
}

#Test("or_pattern_arm_after_nested_value_dispatch_keeps_outer_boundary") {
    parse_complete("\nConn: enum {{\n    Active(Int)\n    Reconnecting(Int)\n    Idle(Int)\n    Closed\n}}\n\nclassify_nested: fn(c: Conn, code: Int) -> String {{\n    if c == {{\n        .Closed -> return if code == {{\n            0 -> \"zero\"\n            else -> \"other\"\n        }}\n        .Active(id) | .Reconnecting(id) | .Idle(id) /* before arrow */ -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n")
}

#Test("leading_dot_fluent_chain_stays_one_expression") {
    parse_complete("\nBox: struct {{\n    value: Int\n}}\n\nchain: fn(value: Box) -> Box {{\n    return value\n        .next()\n        .finish()\n}}\n")
}

#Test("malformed_or_pattern_does_not_gain_a_terminator_boundary") {
    loop source in [
        "\nConn: enum {{\n    Active(Int)\n    Reconnecting(Int)\n    Closed\n}}\n\ntrailing_pipe: fn(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) | -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n",
        "\nConn: enum {{\n    Active(Int)\n    Reconnecting(Int)\n    Closed\n}}\n\nsplit_guard: fn(c: Conn) -> String {{\n    if c == {{\n        .Closed -> render_closed()\n        .Active(id) | .Reconnecting(id)\n            && id > 0\n            -> render_live(id)\n        else -> \"unknown\"\n    }}\n}}\n",
    ] {
        result: parser_test_result(source)
        assert(!result.diagnostics.is_empty(), "malformed dispatch head must be rejected")
    }
}
