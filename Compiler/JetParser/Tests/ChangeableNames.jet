// A changeable name is written `^name: value` and a write window
// `place.in_place()`. Each formats as written; the retired spellings
// `name := value` and a `^place` value no longer parse.
use jet_parser.[JetFormatResult, jet_format_source]

// Why a format failed: its diagnostics, or the meaning it would change.
changeable_names_why: fn(result: JetFormatResult) -> String Never! {
    ^why: result.structure_change ?? ""
    loop diagnostic in result.diagnostics -> why = "{why}\n{diagnostic.code}: {diagnostic.what}"
    why
}

changeable_names_keep: fn(name: String, source: String) Never! {
    kept: jet_format_source(source, false)
    if !kept.ok -> panic("changeable names: {name}: does not format: {changeable_names_why(kept)}")
    if kept.text != source {
        panic("changeable names: {name}: formatted to\n{kept.text}\nexpected\n{source}")
    }
}

changeable_names_refuse: fn(name: String, source: String) Never! {
    if jet_format_source(source, false).ok {
        panic("changeable names: {name}: the retired spelling still parses")
    }
}

#Test("changeable local names") {
    changeable_names_keep("local", "run: fn() -> Int {{\n    ^count: 0\n    count += 1\n    ^_: count\n    count\n}}\n")
    changeable_names_keep("uninit", "run: fn() -> Int {{\n    ^total: Int{{ uninit }}\n    total = 2\n    total\n}}\n")
}

#Test("changeable destructured names") {
    changeable_names_keep("record", "Pair: struct {{\n    lo: Int,\n    hi: Int,\n}}\n\nrun: fn(pair: Pair) -> Int {{\n    {{^lo, ^hi}}: pair\n    lo += hi\n    lo\n}}\n")
    changeable_names_keep("one of two", "Pair: struct {{\n    lo: Int,\n    hi: Int,\n}}\n\nrun: fn(pair: Pair) -> Int {{\n    {{^lo, hi}}: pair\n    lo += hi\n    lo\n}}\n")
    changeable_names_keep("renamed", "Pair: struct {{\n    lo: Int,\n    hi: Int,\n}}\n\nrun: fn(pair: Pair) -> Int {{\n    {{ lo: ^low }}: pair\n    low += 1\n    low\n}}\n")
    changeable_names_keep("list", "run: fn(xs: [Int]) -> Int {{\n    [^a, ^b]: xs\n    a += b\n    a\n}}\n")
}

#Test("changeable module and persisted names") {
    changeable_names_keep("module", "^hits: 0\n\nbump: fn() {{ hits += 1 }}\n")
    changeable_names_keep("persist", "#Persist ^visits: 0\n\nbump: fn() {{ visits += 1 }}\n")
    changeable_names_keep("file-scope lambda", "print(1)\n\n^scaled: fn(x: Int) -> Int {{ x * 2 }}\n\nprint(scaled(2))\n")
}

#Test("changeable state loop names") {
    changeable_names_keep("state loop", "run: fn() -> Int {{\n    ^total: 0\n    loop ^i: 0, i < 3 {{\n        total += i\n        i += 1\n    }}\n    total\n}}\n")
    changeable_names_keep("collecting state loop", "run: fn() -> [Int] {{\n    squares: loop ^i: 0, i < 3, i += 1 -> i * i\n    squares\n}}\n")
}

#Test("write windows") {
    changeable_names_keep("binding window", "run: fn(xs: ^[Int]) {{\n    slot: xs[0].in_place()\n    slot = 2\n}}\n")
    changeable_names_keep("match subject", "Shape: enum {{\n    Dot(Int),\n    Line(Int),\n}}\n\nrun: fn(shape: ^Shape) {{\n    if shape.in_place() == {{\n        .Dot(size) -> {{ size += 1 }}\n        .Line(size) -> size += 2\n    }}\n}}\n")
    changeable_names_keep("loop source", "run: fn(xs: ^[Int]) {{\n    loop x in xs.in_place() -> x += 1\n}}\n")
}

#Test("marks that stay marks") {
    changeable_names_keep("receiver and argument", "run: fn(buf: ^[Int], xs: ^[Int]) {{\n    ^buf.push(1)\n    fill(^xs)\n}}\n")
}

#Test("the retired spellings no longer parse") {
    changeable_names_refuse("changeable local", "run: fn() {{\n    count := 0\n    count += 1\n}}\n")
    changeable_names_refuse("state loop", "run: fn() {{\n    loop i := 0, i < 3, i += 1 {{}}\n}}\n")
    changeable_names_refuse("binding window", "run: fn(xs: ^[Int]) {{\n    slot: ^xs[0]\n    slot = 2\n}}\n")
}

#Test("a window is never a changeable name") {
    formatted: jet_format_source("run: fn(xs: ^[Int]) {{\n    ^slot: xs[0].in_place()\n}}\n", false)
    if formatted.ok -> panic("changeable names: `^slot: xs[0].in_place()` parsed")
    ^reported: false
    loop diagnostic in formatted.diagnostics {
        if diagnostic.what.contains("write window can't be a changeable name") -> reported = true
    }
    if !reported {
        panic("changeable names: `^slot: xs[0].in_place()` did not report the marked window: {changeable_names_why(formatted)}")
    }
}
