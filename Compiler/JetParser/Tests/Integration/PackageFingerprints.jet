// #2517 S1: parsed-source package identity and fingerprints.
use jet_foundation.AST.[CFfi, Item, LoadedModule, NameLedger, ProgramBundle, name_ledger_new, DevtoolsRegistry, PackageGuarantees]
use jet_foundation.PackageIdentity.[item_interface_fingerprint, item_source_fingerprint, PackageGraph, PackageKind, CORE_PACKAGE]
use jet_foundation.[MIRRuntimeLayer, MIRAllocatorPolicy, MIROSTarget, BuildFactSnapshot]
use jet_foundation.Diagnostics.Span
use jet_parser.[Lexer, Parser]
use std.path.OSPath

// Rust: crates/jet-parser/tests/package_fingerprints.rs:16
fn module(path: OSPath, source: String) -> LoadedModule {
    (tokens, diagnostics) :: Lexer.lex(source)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    program := Parser.parse(tokens).expect("parses")
    LoadedModule.from_program(path, path.display().to_string(), source, path.file_stem().unwrap().to_string_lossy(), ^program)
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:40
fn items(source: String) -> [Item] { module(OSPath.new("x.jet"), source).items }

// Rust: crates/jet-parser/tests/package_fingerprints.rs:44
fn only_item(source: String) -> Item {
    parsed := items(source)
    assert(parsed.len() == 1)
    &parsed.remove(0)
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:50
// Directory package with two files, a loose-file entry, and one Core module.
fn bundle(root: OSPath, lib_a: String) -> ProgramBundle {
    lib :: root.join("lib")
    modules :: [
        module(root.join("main.jet"), "fn run() {\n    print(\"hi\")\n}\n"),
        module(lib.join("a.jet"), lib_a),
        module(lib.join("b.jet"), "pub fn b() -> Int {\n    2\n}\n"),
        module(OSPath.new("<corelib>/text.jet"), "pub fn len() -> Int {\n    0\n}\n")
    ]
    name_ledger := name_ledger_new()
    name_ledger.set_module_namespace(1, lib.display().to_string())
    name_ledger.set_module_namespace(2, lib.display().to_string())
    name_ledger.record_import_target(0, Span.new(0, 1), 1)
    // GATE #4483: host target selection uses the native target owner.
    ProgramBundle{
        entry: 0, project_root: root, modules: modules,
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [],
        used_core: Set.new<String>(), ffi_callback_fns: Set.new<String>(),
        cffi: CFfi.empty(), comptime_inputs: [], name_ledger: name_ledger,
        layer_ceiling: None, inferred_layer: MIRRuntimeLayer.Core,
        web_partitions: [:], web_partition_enforced: false, web_partition_report: None,
        dep_roots: [:], package_guarantees: PackageGuarantees.default(),
        program_allocator: MIRAllocatorPolicy.HostedDefault, active_os: MIROSTarget.host(),
        build_facts: BuildFactSnapshot.default(), edition: "2027"
    }
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:89
const LIB_A: String = "pub fn add(a: Int, b: Int) -> Int {\n    a + b\n}\n\nfn helper() -> Int {\n    1\n}\n"

// Rust: crates/jet-parser/tests/package_fingerprints.rs:91
#Test("item_fingerprints_ignore_whitespace_and_comments") {
    plain :: only_item("pub fn add(a: Int, b: Int) -> Int {\n    a + b\n}\n")
    spaced :: only_item("// adds two numbers\n\n\npub fn add(a: Int,   b: Int) -> Int {\n\n    // the sum\n    a  +  b\n}\n")
    assert(item_source_fingerprint(plain) == item_source_fingerprint(spaced))
    assert(item_interface_fingerprint(plain, false) == item_interface_fingerprint(spaced, false))
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:104
#Test("body_edit_keeps_interface_fingerprint_and_signature_edit_changes_it") {
    plain :: only_item("pub fn add(a: Int, b: Int) -> Int {\n    a + b\n}\n")
    body :: only_item("pub fn add(a: Int, b: Int) -> Int {\n    b + a\n}\n")
    signature :: only_item("pub fn add(a: Int, b: Int, c: Int) -> Int {\n    a + b\n}\n")
    assert(item_source_fingerprint(plain) != item_source_fingerprint(body))
    assert(item_interface_fingerprint(plain, false) == item_interface_fingerprint(body, false))
    assert(item_interface_fingerprint(plain, false) != item_interface_fingerprint(signature, false))
    // Generic bodies are templates instantiated by importers and remain interface.
    generic :: only_item("pub fn same<T>(x: T) -> T {\n    x\n}\n")
    generic_body :: only_item("pub fn same<T>(x: T) -> T {\n    y :: x\n    y\n}\n")
    assert(item_interface_fingerprint(generic, false) != item_interface_fingerprint(generic_body, false))
    assert(item_interface_fingerprint(only_item("fn hidden() -> Int {\n    1\n}\n"), false) == None)
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:130
#Test("package_graph_partitions_by_namespace_and_orders_dependencies_first") {
    program :: bundle(OSPath.new("/work/a/project"), LIB_A)
    graph :: PackageGraph.from_bundle(program)
    identities :: graph.packages.map(package -> (package.identity, package.kind, package.modules))
    assert(identities == [
        (CORE_PACKAGE, PackageKind.Core, [3]),
        ("file:main.jet", PackageKind.File, [0]),
        ("pkg:lib", PackageKind.Manifest, [1, 2])
    ])
    // Entry depends on lib and Core; lib depends on Core.
    assert(graph.packages[1].dependencies == [0, 2])
    assert(graph.packages[2].dependencies == [0])
    assert(graph.is_acyclic())
    assert(graph.components() == [[0], [2], [1]])
    assert(graph.member_label(program, 2) == "b.jet")
}

// Rust: crates/jet-parser/tests/package_fingerprints.rs:155
#Test("digests_are_equal_across_checkout_paths_and_edits_cut_off_correctly") {
    digests :: (root: String, lib_a: String) -> {
        program :: bundle(OSPath.new(root), lib_a)
        graph :: PackageGraph.from_bundle(program)
        lib :: graph.packages.position(package -> package.identity == "pkg:lib").unwrap()
        (graph.source_digest(program, lib, Val("package { name: \"lib\" }\n".as_bytes())), graph.interface_digest(program, lib, [String:String]{}))
    }
    (source, interface) :: digests("/work/a/project", LIB_A)
    assert(digests("/elsewhere/b/project", LIB_A) == (source, interface))
    // Comment edits change only the source digest.
    commented :: LIB_A.replace("fn helper", "// the helper\nfn helper")
    (comment_source, comment_interface) :: digests("/work/a/project", commented)
    assert(comment_source != source)
    assert(comment_interface == interface)
    // Private body edits and new private functions keep the interface.
    private :: LIB_A.replace("    1\n", "    2\n") + "\nfn other() -> Int {\n    3\n}\n"
    assert(digests("/work/a/project", private).1 == interface)
    // Public signatures and new public functions change the interface.
    signature :: LIB_A.replace("b: Int) -> Int", "b: Int) -> Float")
    assert(digests("/work/a/project", signature).1 != interface)
    added :: LIB_A + "\npub fn more() -> Int {\n    4\n}\n"
    assert(digests("/work/a/project", added).1 != interface)
    // Inferred facts flow into the digest through checker summaries.
    program :: bundle(OSPath.new("/work/a/project"), LIB_A)
    graph :: PackageGraph.from_bundle(program)
    lib :: graph.packages.position(p -> p.identity == "pkg:lib").unwrap()
    summaries :: [String:String]{"pkg:lib::a.jet::add": "effects:FS"}
    assert(graph.interface_digest(program, lib, summaries) != interface)
}
