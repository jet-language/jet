// Production parser contracts; assembled with the canonical L2 sources by
// run-contract-fixtures.mjs. Any failed assertion exits through panic.
fn pc_require(ok: Bool, name: String) {
    if !ok -> panic("parser contract failed: {name}")
}

fn pc_binding_names(parsed: ParseResult) -> [String] {
    names := [String]{}
    loop item in parsed.program.items {
        if item == .Func(func) {
            loop statement in func.body {
                if statement == .Val(binding) -> &names.push(binding.name)
            }
        }
    }
    names
}

fn pc_binding_values(parsed: ParseResult) -> [Int] {
    values := [Int]{}
    loop item in parsed.program.items {
        if item == .Func(func) {
            loop statement in func.body {
                if statement == .Val(binding) && binding.init == .Int(value, _, _, _) -> &values.push(value)
            }
        }
    }
    values
}

fn pc_semicolon(source: String, replacement: String) {
    parsed :: parse_source(source.bytes())
    pc_require(parsed.diagnostics.len() == 1, "one diagnostic for all semicolons in one file")
    diagnostic :: parsed.diagnostics[0]
    pc_require(diagnostic.code == "E0373", "registered semicolon diagnostic")
    edit :: diagnostic.edit ?? panic("E0373 has no edit")
    pc_require(edit.new_text == replacement, "behavior-preserving newline/removal edit")
    pc_require(source.slice(edit.span.start, edit.span.end) == ";", "edit covers only the authored semicolon")
    pc_require(pc_binding_names(parsed) == [String]{"first", "second", "third"}, "parser resumes at every next statement")
    pc_require(pc_binding_values(parsed) == [Int]{1, 2, 3}, "recovered statements keep their original values")
    // Apply the one-per-file repair repeatedly; no boundary may swallow a name.
    repaired := source
    loop _ in 0..<3 {
        checked :: parse_source(repaired.bytes())
        if checked.diagnostics.len() == 0 -> break
        repair :: checked.diagnostics[0].edit ?? panic("repair lost its edit")
        repaired = "{repaired.slice(0, repair.span.start)}{repair.new_text}{repaired.slice(repair.span.end, repaired.len())}"
    }
    checked :: parse_source(repaired.bytes())
    pc_require(checked.diagnostics.len() == 0, "all suggested repairs parse canonically")
    pc_require(pc_binding_names(checked) == pc_binding_names(parsed), "repair preserves statement order and bindings")
    pc_require(pc_binding_values(checked) == pc_binding_values(parsed), "repair preserves values as well as boundaries")
}

fn pc_module_markers() {
    retired :: parse_source("#Extern module c.sample {{ }}".bytes())
    pc_require(retired.diagnostics.len() == 1 && retired.diagnostics[0].code == "E0060", "Extern teaches Import")
    pc_require(retired.diagnostics[0].fix.contains("#Import"), "Extern replacement agrees with registry")
    pc_require(retired.program.items.len() == 1, "Extern recovery keeps the module")
    pc_require(if retired.program.items[0] == .CModule(value) -> value.kind == CModuleKind.Extern else -> false, "Extern recovery is an import, not Bindgen")
    active :: parse_source("#Import module c.sample {{ }}".bytes())
    pc_require(active.diagnostics.len() == 0, "canonical module import is active")
    bindgen :: parse_source("#Bindgen module c.sample.__bindgen__ {{ }}".bytes())
    // The marker is active; authored use of the generated-only namespace
    // still receives the independent lexical reserved-name diagnostic.
    pc_require(bindgen.diagnostics.len() == 1 && bindgen.diagnostics[0].code == "E0067", "Bindgen is active while its generated namespace stays reserved")
    pc_require(if bindgen.program.items[0] == .CModule(value) -> value.kind == CModuleKind.Bindgen else -> false, "Bindgen remains its own module kind")
}

// Rust `trait_method_sig`: an effect arrow with no result ends a trait slot
// (no body); a free function in that shape still has no body (E0081).
fn pc_trait_effect_slots() {
    slots :: parse_source("trait Sink {{\n    fn begin(self, name: String) Never! -[FS]>\n    fn end(self) Never! -[FS]>\n    fn functions(self) -[]> Bool Never!\n}}\n".bytes())
    pc_require(slots.diagnostics.len() == 0, "effect-arrow trait slots have no body")
    pc_require(if slots.program.items[0] == .Trait(value) -> value.methods.len() == 3 && value.methods[0].default_body == None && value.methods[1].default_body == None else -> false, "effect-arrow trait slots stay requirements")
    free :: parse_source("fn begin(name: String) Never! -[FS]>\nfn run() {{}}\n".bytes())
    pc_require(free.diagnostics.len() == 1 && free.diagnostics[0].code == "E0081", "a free effect-arrow function without a body is E0081")
}

fn pc_marker_metadata() {
    parsed :: parse_source(PC_MARKER_SOURCE.bytes())
    pc_require(parsed.diagnostics.len() == 0, "complete canonical marker registry parses")
    seen := 0
    loop item in parsed.program.items {
        if item == .MarkerDecl(declaration) {
            expected :: PC_MARKER_STATUS.get(declaration.name) ?? panic("unregistered marker {declaration.name}")
            replacement := ""
            loop parameter in declaration.params {
                if parameter.name == "$retired" && parameter.value == .Val(value) && value == .Str(parts, _) {
                    if parts.len() == 1 && parts[0] == .Lit(text) -> replacement = text
                }
            }
            pc_require(replacement == expected, "parser preserves active/retired status for {declaration.name}")
            seen += 1
        }
    }
    pc_require(seen == PC_MARKER_STATUS.len(), "every marker status is covered")
    pc_require((PC_MARKER_STATUS.get("Extern") ?? "") == "#Import", "Extern registry retirement")
}

fn pc_formatter_edit_boundaries() {
    loop end in 1..<4 {
        pc_require(jfmt_apply_source_edits("🙂x", [TextEdit]{TextEdit{span: Span{start: 0, end: end}, new_text: "a"}}) == None, "edit end cannot split a UTF-8 scalar")
        pc_require(jfmt_apply_source_edits("🙂x", [TextEdit]{TextEdit{span: Span{start: end, end: 4}, new_text: "a"}}) == None, "edit start cannot split a UTF-8 scalar")
    }
    pc_require((jfmt_apply_source_edits("éx", [TextEdit]{TextEdit{span: Span{start: 0, end: 2}, new_text: "a"}}) ?? panic("whole scalar edit rejected")) == "ax", "whole scalar replacement")
    pc_require((jfmt_apply_source_edits("éx", [TextEdit]{TextEdit{span: Span{start: 3, end: 3}, new_text: "a"}}) ?? panic("end insertion rejected")) == "éxa", "insertion at source end")
    pc_require((jfmt_apply_source_edits("", [TextEdit]{TextEdit{span: Span{start: 0, end: 0}, new_text: "a"}}) ?? panic("empty insertion rejected")) == "a", "insertion in empty source")
    pc_require(jfmt_apply_source_edits("éx", [TextEdit]{TextEdit{span: Span{start: 0, end: 4}, new_text: "a"}}) == None, "out-of-bounds edit")
    pc_require(jfmt_apply_source_edits("éx", [TextEdit]{TextEdit{span: Span{start: 2, end: 0}, new_text: "a"}}) == None, "reversed edit")
}

// Kind-only queries are checked against the existing whole-token accessor.
// This semantic oracle is not a production allocation or timing measurement.
fn pc_current_kind_equivalence() {
    sources :: [String]{">> /* after split */ name", "/* block */ // line\n name", "/* block */ // line\n"}
    loop source in sources {
        bytes := source.bytes()
        lexed := lex(bytes)
        pc_require(lexed.diagnostics.len() == 0, "current-kind fixture lexes real tokens")
        prepared := parser_prepare_tokens(^lexed.tokens)
        pc_require(prepared.diagnostics.len() == 0, "current-kind fixture uses canonical prepared tokens")
        end :: bytes.len()
        state := JetParserState{tokens: ^prepared.tokens, position: 0, diagnostics: ^lexed.diagnostics, source_end: end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: end, end: end}, result_handler_depth: 0, statement_start: -1, line_starts: parser_line_starts(bytes), source: ^bytes, allow_environment_reads: false}
        pc_require(state.tokens.len() > 0 && state.tokens[state.tokens.len() - 1].kind == TOKEN_EOF, "fixture retains the actual lexical EOF token")
        split :: source.starts_with(">>")
        if split {
            pc_require(state.tokens[0].kind == TOKEN_SHR, "real lexer produces the combined type-close token")
            _ := parser_take_type_close(&state)
            pc_require(state.pending_type_gt, "real type-close consumer leaves the pending second GT")
        }
        before :: state.position
        oracle := ~state
        expected :: parser_current(&oracle).kind
        actual :: parser_current_kind(&state)
        pc_require(actual == expected && "{state:Debug}" == "{oracle:Debug}", "kind-only query preserves full parser state and the token-accessor verdict")
        if split -> pc_require(actual == TOKEN_GT && state.position == before, "pending GT precedes trivia and does not advance the cursor")
        if !split -> pc_require(state.position > before, "mixed and trivia-only comments advance to the same real token or EOF")
        stable :: state.position
        pc_require(parser_current_kind(&state) == actual && state.position == stable, "repeated current-kind query is idempotent")
        if split {
            cursors :: [Int]{-1, state.tokens.len(), state.tokens.len() + 1}
            loop cursor in cursors {
                state.position = cursor
                oracle = ~state
                expected_pending :: parser_current(&oracle).kind
                pc_require(parser_current_kind(&state) == expected_pending && expected_pending == TOKEN_GT, "pending split token precedes negative and out-of-range bounds")
                pc_require(state.position == cursor && "{state:Debug}" == "{oracle:Debug}", "pending GT preserves even an out-of-range cursor and all state")
                pc_require(parser_current_kind(&state) == TOKEN_GT && state.position == cursor, "pending GT remains idempotent")
            }
        }
        state.pending_type_gt = false
        cursors :: [Int]{-1, 0, state.tokens.len() - 1, state.tokens.len(), state.tokens.len() + 1}
        loop cursor in cursors {
            state.position = cursor
            oracle = ~state
            expected_at :: parser_current(&oracle).kind
            actual_at :: parser_current_kind(&state)
            pc_require(actual_at == expected_at && "{state:Debug}" == "{oracle:Debug}", "valid, comment, actual EOF, and invalid cursors match the canonical token accessor")
            if cursor < 0 || cursor >= state.tokens.len() -> pc_require(actual_at == TOKEN_EOF && state.position == cursor, "negative, end, and beyond-end cursors return EOF without advancing")
            if cursor == state.tokens.len() - 1 -> pc_require(actual_at == TOKEN_EOF && state.position == cursor, "the real EOF token is read without advancing")
            after :: state.position
            pc_require(parser_current_kind(&state) == actual_at && state.position == after, "all non-pending cursor cases remain idempotent")
        }
    }
}

fn run() {
    canonical :: parse_source("fn run() {{\n values :: [JSON]{{JSON.Null}}\n print(values.len())\n}}\n".bytes())
    pc_require(canonical.diagnostics.len() == 0, "canonical newline collection consumer")
    pc_semicolon("fn run() {{ first :: 1; second :: 2; third :: 3\n}}\n", "\n")
    pc_semicolon("fn run() {{\n first :: 1;\n second :: 2;\n third :: 3\n}}\n", "")
    pc_module_markers()
    pc_marker_metadata()
    pc_formatter_edit_boundaries()
    pc_trait_effect_slots()
    pc_current_kind_equivalence()
    print("V48 semicolon edits/recovery: passed")
    print("marker registry/parser status: passed")
    print("trait effect-arrow slots: passed")
}
