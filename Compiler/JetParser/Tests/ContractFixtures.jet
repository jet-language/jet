fn pc_formatter_runtime_declarations() {
    loop simplify in ([Bool]{false, true}) {
        once :: jet_format_source(PC_FMT_RUNTIME_SOURCE, simplify)
        pc_require(once.ok, "raw C imports and module bindings format")
        pc_require(once.text == PC_FMT_RUNTIME_SOURCE, "raw C symbols, attributes and binding sigils remain byte-exact")
        twice :: jet_format_source(once.text, simplify)
        pc_require(twice.ok && twice.text == once.text, "runtime declaration formatting is idempotent")
    }
}

fn pc_qualified_generic_literal() {
    parsed :: parse_source("fn run() {{\n case :: testing.TypedHistoryCase<List<Int>>{{value: 1}}\n}}\n".bytes())
    pc_require(parsed.diagnostics.len() == 0, "qualified generic literal parses without comparison diagnostics")
    seen := false
    loop item in parsed.program.items {
        if item == .Func(func) {
            loop statement in func.body {
                if statement == .Val(binding) {
                    if binding.init == .StructLit(name, args, namespace, _, _, _, _) {
                        pc_require(name == "TypedHistoryCase", "qualified literal name")
                        pc_require(namespace == .Val("testing"), "qualified literal namespace")
                        pc_require(args.len() == 1, "qualified literal generic arguments retained")
                        seen = true
                    }
                }
            }
        }
    }
    pc_require(seen, "qualified literal AST")
}

fn pc_lexical_and_parser_diagnostics() {
    parsed :: parse_source("fn run() {{\n __value :: 1 | 2\n print(__value)\n}}\n".bytes())
    reserved := false
    retired := false
    loop diagnostic in parsed.diagnostics {
        if diagnostic.code == "E0067" -> reserved = true
        if diagnostic.code == "E0398" -> retired = true
    }
    pc_require(reserved && retired, "parser teaching survives lexical reserved-name errors")
}

// D-PAT-RECORD1=A: after `==`, `Name{` is a struct pattern only when its
// brace body reads as pattern entries; typed literals and a constant before
// an `if` body stay value equality.
fn pc_named_struct_pattern_rhs_init(source: String, label: String) -> Expr {
    parsed :: parse_source(source.bytes())
    pc_require(parsed.diagnostics.len() == 0, "parses without diagnostics: {label}")
    function :: if parsed.program.items[0] == .Func(value) -> value else -> panic("comparison function: {label}")
    binding :: if function.body[0] == .Val(value) -> value else -> panic("comparison binding: {label}")
    binding.init
}

fn pc_named_struct_pattern_rhs() {
    loop rhs in ([String]{"I64{{0}}", "I64{{-4}}"}) {
        init :: pc_named_struct_pattern_rhs_init("fn run() {{ result :: errno == {rhs} }}", rhs)
        pc_require(if init == .Binary(op, _, _, _) -> op == BinOp.Eq else -> false, "typed literal stays value equality: {rhs}")
    }
    constant :: parse_source("fn run() {{\n if kind == CONST {{ print(kind) }}\n if kind == Limit {{ print(kind) }}\n}}\n".bytes())
    pc_require(constant.diagnostics.len() == 0, "a name compared before an `if` body stays a value")
    init :: pc_named_struct_pattern_rhs_init("fn run() {{ result :: point == Point{{x, y: 0}} }}", "Point{{x, y: 0}}")
    shaped :: if init == .PatternTest(_, pattern, _) -> (if pattern == .Struct(fields, _, _, head) -> fields.len() == 2 && (if head == .Val(_) -> true else -> false) else -> false) else -> false
    pc_require(shaped, "a named struct pattern still binds and compares fields")
}
fn run() {
    canonical :: parse_source("fn run() {{\n values :: [JSON]{{JSON.Null}}\n print(values.len())\n}}\n".bytes())
    pc_require(canonical.diagnostics.len() == 0, "canonical newline collection consumer")
    pc_semicolon("fn run() {{ first :: 1; second :: 2; third :: 3\n}}\n", "\n")
    pc_semicolon("fn run() {{\n first :: 1;\n second :: 2;\n third :: 3\n}}\n", "")
    pc_module_markers()
    pc_named_struct_pattern_rhs()
    pc_lexical_and_parser_diagnostics()
    pc_marker_metadata()
    pc_formatter_edit_boundaries()
    pc_qualified_generic_literal()
    pc_trait_effect_slots()
    pc_enum_methods()
    pc_explicit_privacy()
    pc_qualified_generic_literal()
    print("V48 semicolon edits/recovery: passed")
    print("marker registry/parser status: passed")
    print("trait effect-arrow slots: passed")
    print("Output provider AST facts: passed")
}
