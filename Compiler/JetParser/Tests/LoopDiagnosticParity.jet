// Canonical production-parser recovery, not a fixture-local parser.
// Assemble with run-contract-fixtures.mjs OUTDIR <this fixture>.
use jet_foundation.[ParseResult]
use jet_parser.[parse_source]

fn loop_diagnostic_expect(source: String, code: String, wanted_span: String) -> ParseResult {
    parsed :: parse_source(source.bytes())
    if parsed.diagnostics.len() != 1 -> panic("loop parity emitted extra or missing diagnostics")
    diagnostic :: parsed.diagnostics[0]
    span :: diagnostic.span ?? panic("loop parity lost the diagnostic span")
    if diagnostic.code != code || source.slice(span.start, span.end) != wanted_span -> panic("loop parity differs from the canonical code or span")
    parsed
}

// Retired loop-label spellings (`outer := loop`, `@outer`, `outer@`) carry no
// recovery or teaching any more; only the live loop diagnostics remain here.
#Test("loop_diagnostic_parity") {
    _ := loop_diagnostic_expect("fn run() {{\nvalues :: loop -> 1\n}}", "E0072", "loop")
    _ := loop_diagnostic_expect("fn run() {{\nvalues :: loop i < 4 -> i\n}}", "E0072", "loop")
    canonical :: parse_source("fn run() {{\nouter :: loop {{\nnext(outer)\nbreak(outer)\n}}\nvalues :: loop i in 0..<3 -> i\n}}".bytes())
    if canonical.diagnostics.len() != 0 -> panic("canonical named or collecting loops changed")
    print("loop diagnostic parity: passed")
}
