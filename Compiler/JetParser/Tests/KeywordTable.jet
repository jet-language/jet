// The keyword table both ways: every word the lexer's keyword table holds
// (LEXER_KEYWORD_SPELLINGS and LEXER_RETIRED_SPELLINGS, generated from
// JetLexer/Data/Lexer/Keywords.jet) is refused as an identifier, and every
// word the parser refuses as one is in that table. The words probed are the
// keyword list, the table itself, and the words a statement or form opens
// with outside it.
use {
    jet_foundation.[JET_KEYWORD_NAMES]
    jet_lexer.[LEXER_KEYWORD_SPELLINGS, LEXER_RETIRED_SPELLINGS]
    jet_parser.[parse_source]
}

// Whether the parser refuses `word` as a local's name: bound, then returned.
keyword_table_refused: fn(word: String) -> Bool {
    parsed: parse_source("probe: fn() -> Int {{\n    {word} := 1\n    return {word}\n}}\n".bytes())
    parsed.diagnostics.len() > 0
}

// Words the statement and form parsers open with by spelling, outside the
// keyword list.
KEYWORD_TABLE_OPENERS: [String]{"defer", "assert", "task", "next", "group", "race", "all", "any", "close", "panic", "uninit", "match", "ref", "value", "Transition"}

// Stops when the parser and the keyword table disagree about `word`.
keyword_table_agrees: fn(word: String) {
    in_table: LEXER_KEYWORD_SPELLINGS.contains(word) || LEXER_RETIRED_SPELLINGS.contains(word)
    refused: keyword_table_refused(word)
    if refused && !in_table -> panic("the parser refuses `{word}` as a local's name, but the keyword table does not hold it")
    if !refused && in_table -> panic("the keyword `{word}` parsed as a local's name")
}

#Test("every keyword table word is refused as an identifier") {
    loop word in LEXER_KEYWORD_SPELLINGS -> assert(keyword_table_refused(word), "the keyword `{word}` parsed as a local's name")
    loop word in LEXER_RETIRED_SPELLINGS -> assert(keyword_table_refused(word), "the retired keyword `{word}` parsed as a local's name")
}

#Test("every word the parser refuses as an identifier is in the keyword table") {
    loop word in KEYWORD_TABLE_OPENERS -> keyword_table_agrees(word)
    loop word in JET_KEYWORD_NAMES -> keyword_table_agrees(word)
    loop word in LEXER_KEYWORD_SPELLINGS -> keyword_table_agrees(word)
    loop word in LEXER_RETIRED_SPELLINGS -> keyword_table_agrees(word)
}
