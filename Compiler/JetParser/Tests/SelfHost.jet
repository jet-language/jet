fn parser_selfhost_snapshots() -> [ParserSelfHostSnapshot] {
    [ParserSelfHostSnapshot]{
        {file: "tests/ui/unclosed_paren_call.jet", source: "fn run() {{\n    print(\"hello\"\n}}\n", expected: "Error [E0083]: `(` opened on line 2 is never closed\n  --> tests/ui/unclosed_paren_call.jet:2:10\n    |\n  2 |     print(\"hello\"\n    |          ^\n  --> tests/ui/unclosed_paren_call.jet:2:18\n    |\n  2 |     print(\"hello\"\n    |                  ^ the end of the line comes before the closing `)`\n Why: Every `(` needs a matching `)`, but the end of the line came first\n Fix: Add `)` where the call ends\nMore: jet-lang.dev/e/E0083\n"},
        {file: "tests/ui/unclosed_bracket_list.jet", source: "fn run() {{\n    values :: [1, 2, 3\n    print(values.len())\n}}\n", expected: "Error [E0083]: `[` opened on line 2 is never closed\n  --> tests/ui/unclosed_bracket_list.jet:2:15\n    |\n  2 |     values :: [1, 2, 3\n    |               ^\n  --> tests/ui/unclosed_bracket_list.jet:2:23\n    |\n  2 |     values :: [1, 2, 3\n    |                       ^ the end of the line comes before the closing `]`\n Why: Every `[` needs a matching `]`, but the end of the line came first\n Fix: Add `]` where the list ends\nMore: jet-lang.dev/e/E0083\n"},
        {file: "tests/ui/unclosed_brace_block.jet", source: "fn run() {{\n    print(\"hello\")\n", expected: "Error [E0083]: `{{` opened on line 1 is never closed\n  --> tests/ui/unclosed_brace_block.jet:1:10\n    |\n  1 | fn run() {{\n    |          ^\n  --> tests/ui/unclosed_brace_block.jet:2:19\n    |\n  2 |     print(\"hello\")\n    |                   ^ the end of the file comes before the closing `}}`\n Why: Every `{{` needs a matching `}}`, but the end of the file came first\n Fix: Add `}}` where the block ends\nMore: jet-lang.dev/e/E0083\n"},
        {file: "tests/ui/unclosed_brace_interpolation.jet", source: "fn run() {{\n    count :: 1\n    print(\"count {{count\")\n}}\n", expected: "Error [E0002]: This `{{` never gets a matching `}}`\n  --> tests/ui/unclosed_brace_interpolation.jet:3:18\n    |\n  3 |     print(\"count {{count\")\n    |                  ^^^^^^^^\n Why: `{{` inside quoted text starts an interpolated value and needs a closing `}}` before the text ends; escaped braces use `{{{{`/`}}}}`, while raw backtick strings keep braces literal\n Fix: Add a `}}` after the value, write `{{{{` for an escaped brace, or write the text as ``…`` for raw text\nMore: jet-lang.dev/e/E0002\n"},
        {file: "tests/ui/logic_mix_or_then_and.jet", source: "fn run() {{\n    a :: true\n    b :: false\n    c :: true\n    print(a || b && c)\n}}\n", expected: "Error [E0082]: `&&` and `||` are mixed here without parentheses\n  --> tests/ui/logic_mix_or_then_and.jet:5:16\n    |\n  5 |     print(a || b && c)\n    |                ^^^^^^\n Why: `&&` binds tighter than `||`, but readers often misjudge that, so Jet asks you to show the grouping\n Fix: Write `(b && c)` to keep today's meaning, or regroup the conditions the way you intended\nMore: jet-lang.dev/e/E0082\n"},
        {file: "tests/ui/logic_mix_and_then_or.jet", source: "fn run() {{\n    a :: true\n    b :: false\n    c :: true\n    print(a && b || c)\n}}\n", expected: "Error [E0082]: `&&` and `||` are mixed here without parentheses\n  --> tests/ui/logic_mix_and_then_or.jet:5:11\n    |\n  5 |     print(a && b || c)\n    |           ^^^^^^\n Why: `&&` binds tighter than `||`, but readers often misjudge that, so Jet asks you to show the grouping\n Fix: Write `(a && b)` to keep today's meaning, or regroup the conditions the way you intended\nMore: jet-lang.dev/e/E0082\n"},
        {file: "tests/ui/incr_retired_statement.jet", source: "fn run() {{\n    count := 0\n    count++\n    ++count\n    count--\n    --count\n    print(\"{{count}}\")\n}}\n", expected: "Error [E0160]: `++` is not a Jet operator\n  --> tests/ui/incr_retired_statement.jet:3:5\n    |\n  3 |     count++\n    |     ^^^^^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `count += 1`\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `++` is not a Jet operator\n  --> tests/ui/incr_retired_statement.jet:4:5\n    |\n  4 |     ++count\n    |     ^^^^^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `count += 1`\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `--` is not a Jet operator\n  --> tests/ui/incr_retired_statement.jet:5:5\n    |\n  5 |     count--\n    |     ^^^^^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `count -= 1`\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `--` is not a Jet operator\n  --> tests/ui/incr_retired_statement.jet:6:5\n    |\n  6 |     --count\n    |     ^^^^^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `count -= 1`\nMore: jet-lang.dev/e/E0160\n"},
        {file: "tests/ui/incr_retired_expression.jet", source: "fn run() {{\n    n := 5\n    print(n++)\n    lives := 3\n    loop --lives > 0 {{\n        print(\"{{lives}}\")\n    }}\n    i := 1\n    j :: i++ + ++i\n    print(\"{{j}}\")\n}}\n", expected: "Error [E0160]: `++` is not a Jet operator\n  --> tests/ui/incr_retired_expression.jet:3:11\n    |\n  3 |     print(n++)\n    |           ^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Use `n` here, then write `n += 1` as its own statement after this line\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `--` is not a Jet operator\n  --> tests/ui/incr_retired_expression.jet:5:10\n    |\n  5 |     loop --lives > 0 {{\n    |          ^^^^^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `lives -= 1` as its own statement before this line, then use `lives` here\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `++` is not a Jet operator\n  --> tests/ui/incr_retired_expression.jet:9:10\n    |\n  9 |     j :: i++ + ++i\n    |          ^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Use `i` here, then write `i += 1` as its own statement after this line\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `++` is not a Jet operator\n  --> tests/ui/incr_retired_expression.jet:9:16\n    |\n  9 |     j :: i++ + ++i\n    |                ^^^\n Why: Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another\n Fix: Write `i += 1` as its own statement before this line, then use `i` here\nMore: jet-lang.dev/e/E0160\n"},
        {file: "tests/ui/incr_retired_double_minus.jet", source: "fn run() {{\n    a := 5\n    b := 2\n    print(\"{{a--b}}\")\n    c :: a--b\n    print(\"{{c}}\")\n}}\n", expected: "Error [E0160]: `--` is not a Jet operator\n  --> tests/ui/incr_retired_double_minus.jet:4:14\n    |\n  4 |     print(\"{{a--b}}\")\n    |              ^^\n Why: Jet retired `++` and `--`; reading `a--b` as `a - -b` would hide a sign inside an operator\n Fix: Write `a - -b` with a space, or `a - b` if one sign was meant\nMore: jet-lang.dev/e/E0160\n\nError [E0160]: `--` is not a Jet operator\n  --> tests/ui/incr_retired_double_minus.jet:5:11\n    |\n  5 |     c :: a--b\n    |           ^^\n Why: Jet retired `++` and `--`; reading `a--b` as `a - -b` would hide a sign inside an operator\n Fix: Write `a - -b` with a space, or `a - b` if one sign was meant\nMore: jet-lang.dev/e/E0160\n"},
        {file: "tests/ui/type_mark_prefix_optional_retired.jet", source: "// retired-spelling-fixture: D-TYPE-SUFFIX1 teaches `?T` as `T?`.\nstruct Entry {{\n    id: Int\n    tags: [?String]\n}}\n\nfn find(id: Int) -> ?Entry {{\n    if id > 0 -> return Val(Entry{{id: id, tags: [String?]{{}}}})\n    return None\n}}\n\nfn run() {{\n    limit :: ?Int{{None}}\n    print(limit ?? 0)\n}}\n", expected: "Error [E-TYPE-PREFIX]: `?T` and `!E` are retired prefix type marks.\n  --> tests/ui/type_mark_prefix_optional_retired.jet:4:12\n    |\n  4 |     tags: [?String]\n    |            ^^^^^^^\n Why: A type mark follows the type it marks: `Entry?` may be absent, and `SaveError!` in a function contract names how the call fails.\n Fix: Write `Entry?` for `?Entry`, `SaveError!` for `!SaveError`, and `(A | B)!` for `!(A | B)`.\nMore: jet-lang.dev/e/E-TYPE-PREFIX\n\nError [E-TYPE-PREFIX]: `?T` and `!E` are retired prefix type marks.\n  --> tests/ui/type_mark_prefix_optional_retired.jet:7:21\n    |\n  7 | fn find(id: Int) -> ?Entry {{\n    |                     ^^^^^^\n Why: A type mark follows the type it marks: `Entry?` may be absent, and `SaveError!` in a function contract names how the call fails.\n Fix: Write `Entry?` for `?Entry`, `SaveError!` for `!SaveError`, and `(A | B)!` for `!(A | B)`.\nMore: jet-lang.dev/e/E-TYPE-PREFIX\n\nError [E-TYPE-PREFIX]: `?T` and `!E` are retired prefix type marks.\n  --> tests/ui/type_mark_prefix_optional_retired.jet:13:14\n    |\n 13 |     limit :: ?Int{{None}}\n    |              ^^^^\n Why: A type mark follows the type it marks: `Entry?` may be absent, and `SaveError!` in a function contract names how the call fails.\n Fix: Write `Entry?` for `?Entry`, `SaveError!` for `!SaveError`, and `(A | B)!` for `!(A | B)`.\nMore: jet-lang.dev/e/E-TYPE-PREFIX\n"},
    }
}
