// Rust: tests/selfhost_parser.rs:717
// Reused parity/terminator assertions from acb463ca0's
// Compiler/JetFoundation/Tests/Integration/SelfhostParserTests.jet.
// Expected CASES facts are captured by the unchanged current-dev Rust serializer;
// the test itself has no Cargo, process, or Rust-host callback dependency.
// Host bootstrap and full I9 MIR/AOT/awaited-Wasm driver checks are not ported
// in-test APIs. U2-T2's receipt is checker-jet test (Rust-bootstrap path);
// the reviewer separately runs this same suite through native U2 r3/M3.
struct ParserSelfHostCase {
    name: String
    source: String
    expected: [Int]
}
struct ParserSelfHostSnapshot {
    file: String
    source: String
    expected: String
}

#Test("generated_jet_call_arguments_match_native_parser_contract") {
    loop testcase in parser_selfhost_cases() {
        parsed :: parser_test_result(testcase.source)
        if !testcase.source.contains(";") {
            rendered :: diagnostic_render_all(testcase.name, testcase.source, parsed.diagnostics, false)
            assert(!rendered.contains("`;`"), "{testcase.name}: diagnostic names a synthetic terminator: {rendered}")
        }
        actual :: selfhost_parser_result_facts(parsed)
        if testcase.name.starts_with("unclosed-") || testcase.name.starts_with("retired-step-") {
            assert(actual[0] == 1, "{testcase.name}: exactly one teaching diagnostic")
        }
        assert(actual == testcase.expected, "{testcase.name}: generated Jet parser parity; actual={actual:Debug}, expected={testcase.expected:Debug}")
    }

    // #3391 intentionally differs from frozen native parsing: retain one range
    // argument for sema E0214, never split this retired alias into two bounds.
    expected := [Int]{0, 1, 1, 0, 2, 19, 0, 0, 7}
    selfhost_parser_text(&expected, "view")
    loop fact in ([Int]{1, 0, 14, 18, 0, 0, 0, 1}) -> &expected.push(fact)
    selfhost_parser_text(&expected, "values")
    loop fact in ([Int]{2, 8}) -> &expected.push(fact)
    assert(selfhost_parser_probe("f(values.view(0..1))".bytes()) == expected, "retired view retains one ordinary range argument")

    // Render actual Jet parser diagnostics, not frozen CLI reports.
    loop snapshot in parser_selfhost_snapshots() {
        parsed :: parser_test_result(snapshot.source)
        if snapshot.file.contains("unclosed_") {
            assert(parsed.diagnostics.len() == 1, "{snapshot.file}: exactly one report")
        }
        rendered :: diagnostic_render_all(snapshot.file, snapshot.source, parsed.diagnostics, false)
        assert(!rendered.contains("found `;`"), "{snapshot.file}: synthetic terminator wording: {rendered}")
        assert(rendered.trim_end() == snapshot.expected.trim_end(), "{snapshot.file}: Jet-produced UI snapshot; actual={rendered:Debug}, expected={snapshot.expected:Debug}")
    }
}

