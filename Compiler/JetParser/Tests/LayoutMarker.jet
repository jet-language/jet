// Production parser regression for
// (Rust `layout_type_def`, the grouped
// `#[Layout(…)]` path, and the reserved `columnar [T]` prefix). Assemble with
// the canonical parser L2 unit, not a replacement parser.
// Native UI proof: jet check tests/ui/layout_unknown_variant.jet and
// tests/ui/layout_unsupported_variant.jet (E1105), and
// tests/ui/layout_columnar_prefix_reserved.jet (E1107).
use {
    jet_foundation.[StructDef, StructLayout]
    jet_parser.[parse_source]
}

layout_marker_struct: fn(source: String) -> StructDef {
    parsed: parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> panic("a supported layout form reported a diagnostic")
    if parsed.program.items[0] == .Struct(definition) -> return definition
    panic("the layout struct was not parsed")
}

layout_marker_refusal: fn(source: String, code: String, spelled: String) {
    parsed: parse_source(source.bytes())
    if parsed.diagnostics.len() != 1 -> panic("a refused layout form reported {parsed.diagnostics.len()} diagnostics")
    diagnostic: parsed.diagnostics[0]
    if diagnostic.code != code -> panic("a refused layout form reported {diagnostic.code}, not {code}")
    span: diagnostic.span ?? panic("a layout refusal has no span")
    if source.slice(span.start, span.end) != spelled -> panic("a layout refusal points at `{source.slice(span.start, span.end)}`, not `{spelled}`")
}

#Test("layout_marker") {
    plain: layout_marker_struct("#Layout(c)\nP: struct {{ x: Int }}")
    if plain.layout != Val(StructLayout.C) || plain.layout_span == None -> panic("`#Layout(c)` lost its C layout fact")
    aligned: layout_marker_struct("#Layout(c, align(64))\nP: struct {{ x: Int }}")
    if aligned.layout != Val(StructLayout.CAligned{alignment: 64, target: false}) -> panic("`#Layout(c, align(64))` lost its alignment")
    target: layout_marker_struct("#Layout(c, align(target, 2097152))\nP: struct {{ x: Int }}")
    if target.layout != Val(StructLayout.CAligned{alignment: 2097152, target: true}) -> panic("`align(target, N)` lost its target mode")
    line: layout_marker_struct("#Layout(c, align(build.cpu.cache_line))\nP: struct {{ x: Int }}")
    if line.layout != Val(StructLayout.CAligned{alignment: 64, target: false}) -> panic("`align(build.cpu.cache_line)` is not the generic 64-byte line")
    grouped_line: layout_marker_struct("#[Layout(c, align(build.cpu.cache_line)), Codable]\nP: struct {{ x: Int }}")
    if grouped_line.layout != Val(StructLayout.CAligned{alignment: 64, target: false}) -> panic("a grouped `align(build.cpu.cache_line)` lost its alignment")
    columnar: layout_marker_struct("#Layout(columnar)\nP: struct {{ x: Int }}")
    if columnar.layout != Val(StructLayout.Columnar) -> panic("`#Layout(columnar)` lost its columnar fact")
    grouped: layout_marker_struct("#[Layout(c), Codable]\nP: struct {{ x: Int }}")
    if grouped.layout != Val(StructLayout.C) || grouped.layout_span == None -> panic("a grouped `#Layout(c)` lost its C layout fact")
    default: layout_marker_struct("P: struct {{ x: Int }}")
    if default.layout != None || default.layout_span != None -> panic("an unmarked struct gained a layout fact")
    tagged: parse_source("#Layout(c, I32)\nE: enum {{ A }}".bytes())
    if tagged.diagnostics.len() != 0 -> panic("an enum C tag width was refused")
    backed: parse_source("#Layout(U8)\nE: enum {{\n    A = 1\n    B\n}}".bytes())
    if backed.diagnostics.len() != 0 -> panic("an enum integer backing was refused")
    if backed.program.items[0] == .Enum(definition) {
        if definition.type_markers.len() != 1 -> panic("an enum integer backing lost its marker")
    } else {
        panic("the backed enum was not parsed")
    }
    layout_marker_refusal("#Layout(U8)\nP: struct {{ x: Int }}", "E1105", "U8")
    layout_marker_refusal("#[Layout(U8), Codable]\nP: struct {{ x: Int }}", "E1105", "Layout(U8)")
    layout_marker_refusal("#Layout(packed)\nP: struct {{ x: Int }}", "E1105", "packed")
    layout_marker_refusal("#Layout(sparse)\nP: struct {{ x: Int }}", "E1105", "sparse")
    layout_marker_refusal("#Layout(columnar, align(64))\nP: struct {{ x: Int }}", "E1105", "64")
    layout_marker_refusal("#Layout(c, I32)\nP: struct {{ x: Int }}", "E1105", "#Layout(c, I32)")
    layout_marker_refusal("#Layout(c, align(8))\nE: enum {{ A }}", "E1105", "c")
    layout_marker_refusal("#[Layout(c, align(8)), Codable]\nE: enum {{ A }}", "E1105", "Layout(c, align(8))")
    // A bare name after a struct's layout kind is refused for what it is
    // (reserved `packed`, or no layout argument), in both spellings.
    layout_marker_refusal("#Layout(c, packed)\nP: struct {{ x: Int }}", "E1105", "packed")
    layout_marker_refusal("#Layout(c, sparse)\nP: struct {{ x: Int }}", "E1105", "sparse")
    layout_marker_refusal("#[Layout(c, packed), Codable]\nP: struct {{ x: Int }}", "E1105", "packed")
    layout_marker_refusal("#[Layout(c, I32), Codable]\nP: struct {{ x: Int }}", "E1105", "Layout(c, I32)")
    layout_marker_refusal("#[Layout(packed), Codable]\nP: struct {{ x: Int }}", "E1105", "packed")
    layout_marker_refusal("P: struct {{ x: Float }}\nf: fn(ps: columnar [P]) -> Float {{ 0.0 }}", "E1107", "columnar")
    print("Layout marker: passed")
}
