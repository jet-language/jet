// Private continuation of Parser/Expressions.jet; canonical state and AST carriers.
use jet_foundation.[AccessConvention, Expr, Span, StrPart, TupleField, Type,
    Syntax, access_label, fact_read_kind, fact_read_members, diagnostic_from_registry, expr_span]
use jet_lexer.[Token, TOKEN_IDENT, TOKEN_AT, TOKEN_INT, TOKEN_FLOAT,
    TOKEN_DOT, TOKEN_SLASH, TOKEN_MINUS, TOKEN_STAR, TOKEN_QUESTION, TOKEN_EQ,
    TOKEN_AMP, TOKEN_CARET, TOKEN_COMMA, TOKEN_COLON, TOKEN_LPAREN, TOKEN_RPAREN,
    TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_LBRACKET, TOKEN_RBRACKET, TOKEN_SEMI,
    TOKEN_KW_IN, TOKEN_KW_COPY, TOKEN_KW_MOVE, TOKEN_KW_EFFECT, TOKEN_KW_LOOP,
    TOKEN_KW_IT, TOKEN_NULL, TOKEN_HASH, TOKEN_RAW_STRING, TOKEN_STRING,
    TOKEN_UNIT_NUMBER, TOKEN_CHAR, TOKEN_TRUE, TOKEN_FALSE, TOKEN_SELF, TOKEN_KW_IF,
    TOKEN_QUESTION_QUESTION, TOKEN_DOT_DOT, TOKEN_DOT_DOT_LT, TOKEN_OR_OR,
    TOKEN_PIPE, TOKEN_AND_AND, TOKEN_EQ_EQ, TOKEN_NOT_EQ, TOKEN_LT, TOKEN_LE,
    TOKEN_GE, TOKEN_COMPARE, TOKEN_TILDE_PIPE, TOKEN_SHL, TOKEN_SHR, TOKEN_PLUS,
    TOKEN_SLASH_PERCENT, TOKEN_PERCENT, TOKEN_PERCENT_PERCENT, TOKEN_GT,
    TOKEN_QUESTION_DOT, TOKEN_PLUS_PLUS, TOKEN_MINUS_MINUS]

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:4
fn parser_looks_like_provider_ref_value(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_AT
}

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:8
fn parser_provider_ref_placeholder(state: &JetParserState) -> Expr Never! {
    start :: parser_current(&state).span.start
    end := parser_bump(&state).span.end
    if parser_current_kind(&state) == TOKEN_AT -> end = parser_bump(&state).span.end
    loop {
        kind :: parser_current_kind(&state)
        if kind != TOKEN_IDENT && kind != TOKEN_INT && kind != TOKEN_DOT && kind != TOKEN_SLASH && kind != TOKEN_MINUS && kind != TOKEN_STAR && kind != TOKEN_QUESTION && kind != TOKEN_EQ -> break
        end = parser_bump(&state).span.end
    }
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: Span{start: start, end: end}}
}

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:42
// A convention position accepts &/^. Copy (~) is an expression, never a convention.
fn parser_parse_capability_sigil(state: &JetParserState) -> AccessConvention? Never! {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_AMP {
        parser_bump(&state)
        return Val(AccessConvention.Write)
    }
    if kind == TOKEN_CARET {
        parser_bump(&state)
        return Val(AccessConvention.Move)
    }
    None
}

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:52
// parse_access_prefix is parser_call_access_prefix in Expressions.jet:1863.
// All retired-word arms are guarded by literal false in Rust (D-S14-PAUSE);
// that owner consumes only &/^ and defaults to Read, including take(names).

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:134
fn parser_push_cap_keyword_teach(state: &JetParserState, code: String, keyword: String, sigil: String, span: Span) {
    label :: access_label(sigil)
    &state.diagnostics.push(diagnostic_from_registry(code, Val(span),
        "`{keyword}` is now {label} (`{sigil}`)",
        "access is written with a sigil on the type, not a word — so all code reads the same",
        "write {label} (`{sigil}`) in place of `{keyword}`"))
}

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:167
// starts_expr is parser_starts_expression in Statements.jet:1495. Its complete
// lexical inventory includes contextual starts and the taken-receiver caret.

// Rust: crates/jet-parser/src/Parser/Expressions/providers.rs:204
fn parser_foreign_logic_error(state: &JetParserState, foreign: String, canonical: String) {
    &state.diagnostics.push(diagnostic_from_registry("E0012", Val(parser_current(&state).span),
        "{Syntax.LANG_NAME} writes \"{foreign}\" as `{canonical}`",
        "logic uses the symbols `{Syntax.OP_AND}`, `{Syntax.OP_OR}`, and `{Syntax.OP_NOT}`",
        "replace `{foreign}` with `{canonical}`"))
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:7
fn parser_ptr_from_addr(state: &JetParserState, alias: String, alias_span: Span, depth: Int) -> ParsedExpr {
    parser_expect(&state, TOKEN_LT, "after `{Syntax.TYPE_PTR}`")
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    elem :: parser_parse_type(&state, depth + 1)
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    if parser_current_kind(&state) == TOKEN_COMMA {
        parser_add_fatal_code(&state, "E0003", parser_current(&state).span,
            "`{Syntax.TYPE_PTR}<…>` takes exactly one element type",
            "a pointer points at a single element type",
            "write `{alias}.{Syntax.TYPE_PTR}<Int>.{Syntax.MEM_FROM_ADDR}(addr)`")
        return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    }
    if !parser_type_close_here(&state) {
        parser_expect(&state, TOKEN_GT, "after `{Syntax.TYPE_PTR}<…>`")
    } else {
        parser_take_type_close(&state)
    }
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    parser_expect(&state, TOKEN_DOT, "after `{Syntax.TYPE_PTR}<…>`")
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    method :: parser_expect_field_name(&state)
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    if method.payload.decoded != Syntax.MEM_FROM_ADDR {
        parser_add_fatal_code(&state, "E0003", method.span,
            "`{Syntax.TYPE_PTR}<…>` has no static method `{method.payload.decoded}`",
            "a typed pointer is built from an address",
            "write `{alias}.{Syntax.TYPE_PTR}<Int>.{Syntax.MEM_FROM_ADDR}(addr)`")
        return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    }
    parser_expect(&state, TOKEN_LPAREN, "after `{Syntax.MEM_FROM_ADDR}`")
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: alias_span}, span: alias_span}
    addr :: parser_expr(&state, depth + 1)
    if parser_aborting(&state) -> return addr
    parser_expect_closer(&state, TOKEN_RPAREN, "to finish the call", "call")
    span :: Span{start: alias_span.start, end: parser_lookahead(&state, -1).span.end}
    ParsedExpr{expr: Expr.PtrFromAddr{alias: alias, alias_span: alias_span, elem: elem.ty, addr: addr.expr, span: span}, span: span}
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:67
fn parser_looks_like_named_tuple(state: &JetParserState, lparen_consumed: Bool) -> Bool Never! {
    offset :: if lparen_consumed -> 0 else -> 1
    parser_kind_at(&state, offset) == TOKEN_IDENT && parser_kind_at(&state, offset + 1) == TOKEN_COLON
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:77
fn parser_emit_positional_tuple_error(state: &JetParserState, span: Span) {
    &state.diagnostics.push(diagnostic_from_registry("E0048", Val(span),
        "{Syntax.LANG_NAME} tuples name every member — positional `(1, 2)` isn't allowed (S73)",
        "named members make field access obvious and avoid `.0`, which collides with decimal numbers",
        "write named members: `(x: 1, y: 2)` and use `p.x`, not `p.0`"))
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:91
fn parser_emit_numeric_field_error(state: &JetParserState, span: Span) {
    &state.diagnostics.push(diagnostic_from_registry("E0049", Val(span),
        "{Syntax.LANG_NAME} doesn't use numeric field access like `.0` (S73)",
        "`.0` looks like the start of a decimal number, so tuple members must have names",
        "name the members when you build the tuple: `(x: 1, y: 2)`, then read `p.x`"))
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:107
fn parser_expect_field_name(state: &JetParserState) -> Token {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_INT || kind == TOKEN_FLOAT {
        token := parser_bump(&state)
        parser_emit_numeric_field_error(&state, token.span)
        token.payload.decoded = "0"
        return token
    }
    current :: parser_current(&state)
    if current.kind == TOKEN_IDENT && Syntax.is_comptime_name(current.payload.decoded) {
        member :: parser_expect_name(&state, "in a compiler fact")
        name :: member.payload.decoded
        if name == "$track_origin" {
            parser_add_fatal_code(&state, "E0302", member.span, "`$track_origin` is retired",
                "`#Track` origin is read through the typed `$origin` fact", "write `value.$origin`")
            return member
        }
        if state.derive_template_depth > 0 -> return member
        if fact_read_kind(name) == None {
            names := [String]{}
            loop registered in fact_read_members() -> &names.push("`{registered}`")
            members :: names.join(", ")
            parser_add_fatal_code(&state, "E0302", member.span,
                "`{name}` is not a compiler-owned fact", "the compiler-owned facts are {members}",
                "write a registered fact read such as `T.{Syntax.COMPILER_FACT_LAYOUT}`")
        }
        return member
    }
    if current.kind == TOKEN_IDENT && current.payload.decoded == Syntax.KW_CONC_TASK -> return parser_bump(&state)
    if kind == TOKEN_KW_IN || kind == TOKEN_KW_COPY || kind == TOKEN_KW_MOVE || kind == TOKEN_KW_EFFECT {
        token := parser_bump(&state)
        token.payload.decoded = if kind == {
            TOKEN_KW_IN -> Syntax.KW_IN
            TOKEN_KW_COPY -> Syntax.KW_COPY
            TOKEN_KW_MOVE -> Syntax.KW_MOVE
            else -> Syntax.KW_EFFECT_DECL
        }
        return token
    }
    parser_expect_name(&state, "after `.`")
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:196
fn parser_sync_to_rparen(state: &JetParserState) Never! {
    depth := 0
    loop state.position < state.tokens.len() {
        kind :: parser_current_kind(&state)
        if {
            kind == TOKEN_LPAREN -> depth += 1
            kind == TOKEN_RPAREN && depth == 0 -> { parser_bump(&state); return }
            kind == TOKEN_RPAREN -> depth -= 1
            (kind == TOKEN_SEMI || kind == TOKEN_RBRACE) && depth == 0 -> return
            else -> {}
        }
        parser_bump(&state)
    }
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:214
fn parser_parse_tuple_lit(state: &JetParserState, open: Span, depth: Int) -> ParsedExpr {
    fields := [TupleField]{}
    if parser_current_kind(&state) != TOKEN_RPAREN {
        loop {
            name :: parser_expect_name(&state, "for a tuple member name")
            if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: open}, span: open}
            parser_expect(&state, TOKEN_COLON, "after each tuple member name")
            if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: open}, span: open}
            value :: parser_expr(&state, depth + 1)
            if parser_aborting(&state) -> return value
            &fields.push(TupleField{name: name.payload.decoded, value: value.expr})
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
    }
    close :: parser_current(&state).span
    parser_expect(&state, TOKEN_RPAREN, "to close this tuple")
    span :: Span{start: open.start, end: close.end}
    if fields.len() < 2 {
        parser_add_fatal_code(&state, "E0003", span, "a tuple needs at least two named members",
            "a single `(name: value)` would be ambiguous with grouping — use a one-field `struct` instead",
            "add another member: `(x: 1, y: 2)`")
    }
    ParsedExpr{expr: Expr.TupleLit{fields: fields, span: span, ty: None}, span: span}
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:251
fn parser_parse_paren_primary(state: &JetParserState, allow_struct_lit: Bool, depth: Int) -> ParsedExpr {
    open :: parser_bump(&state).span
    if parser_current_kind(&state) == TOKEN_RPAREN {
        close :: parser_bump(&state).span
        span :: Span{start: open.start, end: close.end}
        return ParsedExpr{expr: Expr.Unit{span: span}, span: span}
    }
    if parser_looks_like_named_tuple(&state, true) -> return parser_parse_tuple_lit(&state, open, depth)
    if parser_after_lparen_is_positional_tuple(&state) {
        parser_emit_positional_tuple_error(&state, open)
        parser_sync_to_rparen(&state)
        return ParsedExpr{expr: Expr.Int{value: 0, span: open, width: None, raw: None}, span: open}
    }
    pos_after_first_open :: state.position
    opens := [Span]{open}
    loop parser_current_kind(&state) == TOKEN_LPAREN && !parser_looks_like_lambda(&state) && !parser_looks_like_named_tuple(&state, false) {
        candidate_pos :: state.position
        candidate :: parser_bump(&state).span
        if parser_after_lparen_is_positional_tuple(&state) {
            state.position = candidate_pos
            break
        }
        &opens.push(candidate)
    }
    if opens.len() > 1 {
        diags_before :: state.diagnostics.len()
        if parser_try_fold_paren_run(&state, opens, depth) == .Val(folded) -> return folded
        loop state.diagnostics.len() > diags_before -> _ := &state.diagnostics.pop()
        state.position = pos_after_first_open
        if state.abort_mark > diags_before { state.abort_mark = 0; state.abort_position = 0 }
    }
    inner :: parser_expr(&state, depth + 1)
    if parser_aborting(&state) -> return inner
    if parser_current_kind(&state) == TOKEN_COMMA {
        parser_emit_positional_tuple_error(&state, open)
        parser_sync_to_rparen(&state)
        return ParsedExpr{expr: Expr.Int{value: 0, span: open, width: None, raw: None}, span: open}
    }
    parser_expect(&state, TOKEN_RPAREN, "to close this `(`")
    span :: Span{start: open.start, end: parser_lookahead(&state, -1).span.end}
    ParsedExpr{expr: Expr.Paren{value: inner.expr, span: span}, span: span}
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:324
fn parser_try_fold_paren_run(state: &JetParserState, opens: [Span], depth: Int) -> ParsedExpr? {
    inner := parser_expr(&state, depth + 1)
    if parser_aborting(&state) || parser_current_kind(&state) == TOKEN_COMMA -> return None
    index := opens.len()
    loop index > 0 {
        index -= 1
        if parser_current_kind(&state) != TOKEN_RPAREN -> return None
        close :: parser_bump(&state).span
        span :: Span{start: opens[index].start, end: close.end}
        inner = ParsedExpr{expr: Expr.Paren{value: inner.expr, span: span}, span: span}
    }
    Val(inner)
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:345
fn parser_after_lparen_is_positional_tuple(state: &JetParserState) -> Bool Never! {
    i := state.position
    if i >= state.tokens.len() -> return false
    if state.tokens[i].kind == TOKEN_RPAREN -> return false
    if state.tokens[i].kind == TOKEN_IDENT && i + 1 < state.tokens.len() && state.tokens[i + 1].kind == TOKEN_COLON -> return false
    loop {
        kind :: state.tokens[i].kind
        if kind == TOKEN_RPAREN || kind == TOKEN_COLON -> return false
        if kind == TOKEN_COMMA -> return true
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACE || kind == TOKEN_LBRACKET {
            i += 1
            depth := 1
            loop i < state.tokens.len() && depth > 0 {
                nested :: state.tokens[i].kind
                if nested == TOKEN_LPAREN || nested == TOKEN_LBRACE || nested == TOKEN_LBRACKET -> depth += 1
                if nested == TOKEN_RPAREN || nested == TOKEN_RBRACE || nested == TOKEN_RBRACKET -> depth -= 1
                i += 1
            }
        } else {
            i += 1
        }
        if i >= state.tokens.len() -> return false
    }
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:386
fn parser_expr(state: &JetParserState, depth: Int) -> ParsedExpr {
    if depth > MAX_EXPRESSION_DEPTH -> return parser_parse_expression_restricted(&state, 1, depth, true, false)
    if parser_try_primary_expr(&state, depth) == .Val(primary) -> return primary
    parser_parse_expression_restricted(&state, 1, depth, true, false)
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:401
fn parser_try_primary_expr(state: &JetParserState, depth: Int) -> ParsedExpr? {
    if !parser_can_start_primary_expr(&state) -> return None
    saved :: parser_expr_probe_save(state)
    // expr_primary is owned by the primary expression fragment, not unary/postfix.
    expression :: parser_expr_primary(&state, true, depth + 1)
    if !parser_aborting(&state) && !parser_has_expr_infix_continuation(&state, depth) && !parser_has_expr_postfix_continuation(&state) -> return Val(expression)
    parser_expr_probe_restore(saved, &state)
    None
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:421
fn parser_can_start_primary_expr(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind == TOKEN_IDENT && token.payload.decoded == Syntax.KW_SHARED && starts_shared_operand(parser_lookahead(&state, 1).kind) -> return false
    kind :: token.kind
    kind == TOKEN_KW_LOOP || kind == TOKEN_KW_IT || kind == TOKEN_NULL || kind == TOKEN_HASH || kind == TOKEN_RAW_STRING || kind == TOKEN_STRING || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_CHAR || kind == TOKEN_LBRACKET || kind == TOKEN_TRUE || kind == TOKEN_FALSE || kind == TOKEN_SELF || kind == TOKEN_KW_IF || kind == TOKEN_KW_MOVE || kind == TOKEN_LPAREN || kind == TOKEN_IDENT
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:458
fn parser_has_expr_infix_continuation(state: &JetParserState, depth: Int) -> Bool Never! {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_GT -> return state.module_arg_expr_depth != Val(depth)
    kind == TOKEN_QUESTION_QUESTION || kind == TOKEN_DOT_DOT || kind == TOKEN_DOT_DOT_LT || kind == TOKEN_OR_OR || kind == TOKEN_PIPE || kind == TOKEN_AND_AND || kind == TOKEN_EQ_EQ || kind == TOKEN_NOT_EQ || kind == TOKEN_LT || kind == TOKEN_LE || kind == TOKEN_GE || kind == TOKEN_COMPARE || kind == TOKEN_TILDE_PIPE || kind == TOKEN_AMP || kind == TOKEN_SHL || kind == TOKEN_SHR || kind == TOKEN_PLUS || kind == TOKEN_MINUS || kind == TOKEN_STAR || kind == TOKEN_SLASH || kind == TOKEN_SLASH_PERCENT || kind == TOKEN_PERCENT || kind == TOKEN_PERCENT_PERCENT || kind == TOKEN_CARET || kind == TOKEN_KW_IN
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:490
fn parser_module_arg_expr(state: &JetParserState, depth: Int) -> ParsedExpr {
    previous :: state.module_arg_expr_depth
    state.module_arg_expr_depth = Val(depth + 1)
    result :: parser_expr(&state, depth + 1)
    state.module_arg_expr_depth = previous
    result
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:498
// expr_no_struct_lit maps to parser_parse_expression_no_struct_lit in Expressions.jet:225.
// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:509
fn parser_expr_no_struct_lit_no_cmp(state: &JetParserState, depth: Int) -> ParsedExpr {
    expression :: parser_parse_expression_restricted(&state, 6, depth, false, true)
    if !parser_aborting(&state) && parser_current_kind(&state) == TOKEN_KW_IN {
        span :: parser_bump(&state).span
        &state.diagnostics.push(diagnostic_from_registry("E0384", Val(span), "", "", ""))
        state.abort_mark = state.diagnostics.len()
        state.abort_position = state.position
    }
    expression
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:521
fn parser_has_expr_postfix_continuation(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    kind == TOKEN_DOT || kind == TOKEN_QUESTION || kind == TOKEN_QUESTION_DOT || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_PLUS_PLUS || kind == TOKEN_MINUS_MINUS
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:537
struct ExprProbeState {
    pub pos: Int
    pub diags_len: Int
    pub pending_type_gt: Bool
    pub pending_type_gt_span: Span
    pub depth: Int
    pub type_generic_depth: Int
    pub type_generic_chain_len: Int
    pub type_generic_truncated: Bool
    pub in_layout_body: Int
    pub adjacent_if_body_depth: Int
    pub block_depth: Int
    pub callable_tail_depth: Int
    pub callable_tail_expects_value: Bool
    pub lambda_tail_block_depth: Int?
    pub module_arg_expr_depth: Int?
    pub allow_lowercase_leading_dot: Bool
    pub derive_template_depth: Int
    pub policy_declarations_len: Int
    pub applied_rules_len: Int
    pub rule_facts_len: Int
    pub block_spans_len: Int
    // Canonical Jet recovery/trivia state must also be transactional.
    pub abort_mark: Int
    pub abort_position: Int
    pub else_arms_len: Int
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:561
fn parser_expr_probe_save(state: JetParserState) -> ExprProbeState Never! {
    ExprProbeState{pos: state.position, diags_len: state.diagnostics.len(),
        pending_type_gt: state.pending_type_gt, pending_type_gt_span: state.pending_type_gt_span,
        depth: state.depth, type_generic_depth: state.type_generic_depth,
        type_generic_chain_len: state.type_generic_chain.len(), type_generic_truncated: state.type_generic_truncated,
        in_layout_body: state.in_layout_body, adjacent_if_body_depth: state.adjacent_if_body_depth,
        block_depth: state.block_depth, callable_tail_depth: state.callable_tail_depth,
        callable_tail_expects_value: state.callable_tail_expects_value, lambda_tail_block_depth: state.lambda_tail_block_depth,
        module_arg_expr_depth: state.module_arg_expr_depth, allow_lowercase_leading_dot: state.allow_lowercase_leading_dot,
        derive_template_depth: state.derive_template_depth, policy_declarations_len: state.block_policy_declarations.len(),
        applied_rules_len: state.applied_rules.len(), rule_facts_len: state.rule_facts.len(),
        block_spans_len: state.block_spans.len(), abort_mark: state.abort_mark, abort_position: state.abort_position,
        else_arms_len: state.else_arms.len()}
}

// Rust: crates/jet-parser/src/Parser/Expressions/ptr_tuple.rs:586
fn parser_expr_probe_restore(saved: ExprProbeState, state: &JetParserState) Never! {
    state.position = saved.pos
    loop state.diagnostics.len() > saved.diags_len -> _ := &state.diagnostics.pop()
    state.pending_type_gt = saved.pending_type_gt
    state.pending_type_gt_span = saved.pending_type_gt_span
    state.depth = saved.depth
    state.type_generic_depth = saved.type_generic_depth
    loop state.type_generic_chain.len() > saved.type_generic_chain_len -> _ := &state.type_generic_chain.pop()
    state.type_generic_truncated = saved.type_generic_truncated
    state.in_layout_body = saved.in_layout_body
    state.adjacent_if_body_depth = saved.adjacent_if_body_depth
    state.block_depth = saved.block_depth
    state.callable_tail_depth = saved.callable_tail_depth
    state.callable_tail_expects_value = saved.callable_tail_expects_value
    state.lambda_tail_block_depth = saved.lambda_tail_block_depth
    state.module_arg_expr_depth = saved.module_arg_expr_depth
    state.allow_lowercase_leading_dot = saved.allow_lowercase_leading_dot
    state.derive_template_depth = saved.derive_template_depth
    loop state.block_policy_declarations.len() > saved.policy_declarations_len -> _ := &state.block_policy_declarations.pop()
    loop state.applied_rules.len() > saved.applied_rules_len -> _ := &state.applied_rules.pop()
    loop state.rule_facts.len() > saved.rule_facts_len -> _ := &state.rule_facts.pop()
    loop state.block_spans.len() > saved.block_spans_len -> _ := &state.block_spans.pop()
    state.abort_mark = saved.abort_mark
    state.abort_position = saved.abort_position
    loop state.else_arms.len() > saved.else_arms_len -> _ := &state.else_arms.pop()
}
