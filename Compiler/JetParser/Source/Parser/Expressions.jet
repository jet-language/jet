// Pratt expressions and source literals. Token precedence follows the language
// grammar: `^` is right-associative exponentiation; `~|` is bitwise XOR.
use jet_foundation.[
    AccessConvention,
    BinOp,
    ByteTextPart,
    Call,
    CallArg,
    CallLabel,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    EnumLitArg,
    Expr,
    ExprField,
    ExprMember,
    ExprPair,
    IndexKind,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    OrFallback,
    PlaceAccess,
    Span,
    Stmt,
    StrFormat,
    StrPart,
    TextEdit,
    TryConvert,
    TupleField,
    Type,
    TypedLitBody,
    UnOp,
    UnitFormat,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    diagnostic_from_registry,
    diagnostic_with_edit_grade,
    expr_span,
]
use jet_lexer.[
    STRING_PART_BYTE,
    STRING_PART_INTERPOLATION,
    STRING_PART_TEXT,
    TOKEN_AMP,
    TOKEN_AND_AND,
    TOKEN_BANG,
    TOKEN_BREAK,
    TOKEN_CARET,
    TOKEN_CHAR,
    TOKEN_COLON,
    TOKEN_COMMA,
    TOKEN_COMPARE,
    TOKEN_DOT,
    TOKEN_DOT_DOT,
    TOKEN_DOT_DOT_DOT,
    TOKEN_DOT_DOT_LT,
    TOKEN_EOF,
    TOKEN_EQ,
    TOKEN_EQ_EQ,
    TOKEN_FALSE,
    TOKEN_FLOAT,
    TOKEN_GE,
    TOKEN_GT,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_INT,
    TOKEN_KW_COPY,
    TOKEN_KW_IF,
    TOKEN_KW_IN,
    TOKEN_KW_IT,
    TOKEN_KW_LOOP,
    TOKEN_KW_MOVE,
    TOKEN_KW_TAG,
    TOKEN_KW_USE,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LE,
    TOKEN_LPAREN,
    TOKEN_LT,
    TOKEN_MINUS,
    TOKEN_MINUS_MINUS,
    TOKEN_NOT_EQ,
    TOKEN_NULL,
    TOKEN_OR_OR,
    TOKEN_PERCENT,
    TOKEN_PERCENT_PERCENT,
    TOKEN_PIPE,
    TOKEN_PLUS,
    TOKEN_PLUS_PLUS,
    TOKEN_QUESTION,
    TOKEN_QUESTION_DOT,
    TOKEN_QUESTION_QUESTION,
    TOKEN_RAW_STRING,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RETURN,
    TOKEN_RPAREN,
    TOKEN_SELF,
    TOKEN_SEMI,
    TOKEN_SHL,
    TOKEN_SHR,
    TOKEN_SLASH,
    TOKEN_SLASH_PERCENT,
    TOKEN_STAR,
    TOKEN_STRING,
    TOKEN_TILDE,
    TOKEN_TILDE_PIPE,
    TOKEN_TRUE,
    TOKEN_UNIT_NUMBER,
    StringPart,
    Token,
]

MAX_EXPRESSION_DEPTH :: prep { 256 }

pub struct ParsedExpr {
    pub expr: Expr
    pub span: Span
}

pub struct ParsedExprFields {
    pub fields: [ExprField]
    pub span: Span
}

// Rust's precedence ladder, loosest first: `??`, one non-chaining range,
// `||`, `&&`, comparisons, `|`, `~|`, `&`, shifts, `+ -`, `* /`, unary,
// then right-associative `^`. Bitwise operators bind tighter than
// comparisons (D-BITOREXPR1=A).
fn parser_expression_precedence(kind: Int) -> Int Never! {
    return if kind == {
        TOKEN_QUESTION_QUESTION -> 1
        TOKEN_DOT_DOT -> 2
        TOKEN_DOT_DOT_LT -> 2
        TOKEN_OR_OR -> 3
        TOKEN_AND_AND -> 4
        TOKEN_EQ_EQ -> 5
        TOKEN_NOT_EQ -> 5
        TOKEN_LT -> 5
        TOKEN_LE -> 5
        TOKEN_GT -> 5
        TOKEN_GE -> 5
        TOKEN_COMPARE -> 5
        TOKEN_PIPE -> 6
        TOKEN_TILDE_PIPE -> 7
        TOKEN_AMP -> 8
        TOKEN_SHL -> 10
        TOKEN_SHR -> 10
        TOKEN_PLUS -> 11
        TOKEN_MINUS -> 11
        TOKEN_STAR -> 12
        TOKEN_SLASH -> 12
        TOKEN_SLASH_PERCENT -> 12
        TOKEN_PERCENT -> 12
        TOKEN_PERCENT_PERCENT -> 12
        TOKEN_CARET -> 14
        else -> 0
    }
}

fn parser_binary_operator(kind: Int) -> BinOp Never! {
    if kind == {
        TOKEN_PLUS -> BinOp.Add
        TOKEN_MINUS -> BinOp.Sub
        TOKEN_STAR -> BinOp.Mul
        TOKEN_SLASH -> BinOp.Div
        TOKEN_SLASH_PERCENT -> BinOp.FloorDiv
        TOKEN_PERCENT -> BinOp.Mod
        TOKEN_PERCENT_PERCENT -> BinOp.Rem
        TOKEN_CARET -> BinOp.Pow
        TOKEN_AMP -> BinOp.BitAnd
        TOKEN_PIPE -> BinOp.BitOr
        TOKEN_TILDE_PIPE -> BinOp.BitXor
        TOKEN_SHL -> BinOp.Shl
        TOKEN_SHR -> BinOp.Shr
        TOKEN_EQ_EQ -> BinOp.Eq
        TOKEN_NOT_EQ -> BinOp.Ne
        TOKEN_LT -> BinOp.Lt
        TOKEN_GT -> BinOp.Gt
        TOKEN_LE -> BinOp.Le
        TOKEN_GE -> BinOp.Ge
        TOKEN_COMPARE -> BinOp.Compare
        TOKEN_AND_AND -> BinOp.And
        else -> BinOp.Or
    }
}

fn parser_is_relational(kind: Int) -> Bool Never! {
    kind == TOKEN_LT || kind == TOKEN_LE || kind == TOKEN_GT || kind == TOKEN_GE
}

fn parser_compare_direction(kind: Int) -> Int Never! {
    return if kind == {
        TOKEN_LT -> 1
        TOKEN_LE -> 1
        TOKEN_GT -> -1
        TOKEN_GE -> -1
        else -> 0
    }
}

fn parser_expression_comparison_boundary(kind: Int) -> Bool Never! {
    parser_is_relational(kind) || kind == TOKEN_EQ_EQ || kind == TOKEN_NOT_EQ || kind == TOKEN_COMPARE || kind == TOKEN_DOT_DOT || kind == TOKEN_DOT_DOT_LT
}

fn parser_expression_comparison_token(kind: Int) -> Bool Never! {
    parser_is_relational(kind) || kind == TOKEN_EQ_EQ || kind == TOKEN_NOT_EQ || kind == TOKEN_COMPARE
}

// Rust `chained_eq_error`: a comparison after `==`, `!=` or `<=>`, or an
// equality after a relational chain, is fatal.
fn parser_report_chained_comparison(state: &JetParserState) {
    span :: parser_current(&state).span
    parser_add_error(&state, span, "comparisons can't be chained", "`a < b < c` doesn't compare all three; check each pair and join with `&&`", "write `a < b && b < c`")
}

fn parser_parse_expression(state: &JetParserState, minimum: Int, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(&state, minimum, depth, true, false)
}

fn parser_parse_expression_no_struct_lit(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(&state, 1, depth, false, false)
}

fn parser_parse_expression_no_struct_lit_no_cmp(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(&state, 6, depth, false, true)
}

// A dispatch arm atom stops before `|`, which separates arm alternatives.
fn parser_parse_expression_dispatch_atom(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(&state, 7, depth, false, true)
}

fn parser_parse_expression_restricted(state: &JetParserState, minimum: Int, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    if depth > MAX_EXPRESSION_DEPTH {
        span :: parser_current(&state).span
        parser_add_error(&state, span, "this expression is nested too deeply", "recursive expression parsing is bounded against adversarial nesting", "reduce the nesting depth")
        return ParsedExpr{expr: Expr.Unit{span: span}, span: span}
    }

    left := parser_parse_prefix(&state, depth + 1, allow_struct_lit, stop_before_comparison)
    left = parser_parse_postfix(&state, left, depth + 1, allow_struct_lit)
    loop {
        operator := parser_current_kind(&state)
        // Rust `expr_cmp`: `in` after a comparison operand is the retired
        // membership spelling (E0384), fatal at the `in`.
        if operator == TOKEN_KW_IN && minimum <= 5 && !stop_before_comparison {
            membership :: parser_bump(&state)
            parser_add_fatal_code(&state, "E0384", membership.span, "Jet has no membership operator here; `in` only joins a source-loop binding to its source.", "Expression `x in xs` has no operator meaning in Jet. Collection membership is a method call.", "Write `xs.contains(x)` (the `.contains(x)` method) instead of `x in xs`.")
            break
        }
        precedence := parser_expression_precedence(operator)
        if precedence == 0 || precedence < minimum -> break
        if stop_before_comparison && parser_expression_comparison_boundary(operator) -> break
        operator_token :: parser_bump(&state)

        if operator == TOKEN_QUESTION_QUESTION {
            fallback :: parser_parse_or_fallback(&state, depth + 1, allow_struct_lit, stop_before_comparison)
            fallback_span :: parser_fallback_span(fallback)
            span := parser_cover(left.span, fallback_span)
            left = ParsedExpr{
                expr: Expr.OrFallback{value: left.expr, fallback: fallback, is_option: false, span: span},
                span: span,
            }
            next
        }

        if operator == TOKEN_EQ_EQ && parser_pattern_rhs_ahead(&state) {
            pattern :: parser_parse_pattern(&state, depth + 1, allow_struct_lit)
            span := parser_cover(left.span, pattern.span)
            left = ParsedExpr{expr: Expr.PatternTest{subject: left.expr, pattern: pattern.pattern, span: span}, span: span}
            next
        }

        next_minimum := precedence + 1
        if operator == TOKEN_CARET -> next_minimum = precedence
        right :: parser_parse_expression_restricted(&state, next_minimum, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(left.span, right.span)

        if operator == TOKEN_DOT_DOT || operator == TOKEN_DOT_DOT_LT {
            left = ParsedExpr{
                expr: Expr.Range{start: left.expr, end: right.expr, exclusive: operator == TOKEN_DOT_DOT_LT, span: span},
                span: span,
            }
            // Rust `expr_range`: one range, never chained (`1..2..3`); the
            // second `..` is left for the enclosing construct to reject.
            if parser_current_kind(&state) == TOKEN_DOT_DOT || parser_current_kind(&state) == TOKEN_DOT_DOT_LT -> break
            next
        }

        if parser_is_relational(operator) {
            ops := [BinOp]{parser_binary_operator(operator)}
            operands := [Expr]{left.expr, right.expr}
            direction := parser_compare_direction(operator)
            end := right.span
            loop parser_is_relational(parser_current_kind(&state)) && parser_compare_direction(parser_current_kind(&state)) == direction {
                next_operator := parser_current_kind(&state)
                parser_bump(&state)
                next_operand :: parser_parse_expression_restricted(&state, precedence + 1, depth + 1, allow_struct_lit, stop_before_comparison)
                &ops.push(parser_binary_operator(next_operator))
                &operands.push(next_operand.expr)
                end = next_operand.span
            }
            // D-CHAINCMP1: a chain reads in one direction only.
            if parser_is_relational(parser_current_kind(&state)) {
                turn :: parser_current(&state)
                parser_add_fatal_code(&state, "E0333", turn.span, "this comparison chain changes direction", "a chain like `0 <= sev < 10` reads in one direction; mixing `<` and `>` in one chain is almost always a mistake and has no single meaning", "split it into two comparisons joined with `&&`")
            }
            // `==` and `!=` never extend a relational chain.
            if parser_current_kind(&state) == TOKEN_EQ_EQ || parser_current_kind(&state) == TOKEN_NOT_EQ -> parser_report_chained_comparison(&state)
            chain_span := parser_cover(left.span, end)
            if {
                ops.len() > 1 -> {
                    hooks := [Bool]{}
                    hook_index := 0
                    loop hook_index < ops.len() {
                        &hooks.push(false)
                        hook_index += 1
                    }
                    left = ParsedExpr{expr: Expr.CompareChain{operands: operands, ops: ops, hooks: hooks, span: chain_span}, span: chain_span}
                }
                else -> {
                    left = ParsedExpr{expr: Expr.Binary{op: parser_binary_operator(operator), left: left.expr, right: right.expr, span: chain_span}, span: chain_span}
                }
            }
            next
        }

        if operator == TOKEN_OR_OR {
            parser_check_mixed_logic(&state, left)
            parser_check_mixed_logic(&state, right)
        }
        // `==`, `!=` and `<=>` never chain: any comparison after one is E0003.
        if (operator == TOKEN_EQ_EQ || operator == TOKEN_NOT_EQ || operator == TOKEN_COMPARE) && parser_expression_comparison_token(parser_current_kind(&state)) -> parser_report_chained_comparison(&state)
        left = ParsedExpr{
            expr: Expr.Binary{op: parser_binary_operator(operator), left: left.expr, right: right.expr, span: span},
            span: span,
        }
        if operator_token.span.end > left.span.end -> left.span.end = operator_token.span.end
    }
    left
}

// E0082 (D-ARMHEAD-PAREN1, amended 2026-09-28): an unparenthesized `&&`
// operand of `||` hides the precedence. The Safe edit inserts exactly the
// parentheses precedence already implies.
fn parser_check_mixed_logic(state: &JetParserState, operand: ParsedExpr) {
    if operand.expr == {
        .Binary(op, _, _, _) -> {
            if op != BinOp.And -> return
        }
        else -> return
    }
    grouped :: "({parser_source_text(state, operand.span)})"
    diagnostic :: diagnostic_from_registry(
        "E0082",
        Val(operand.span),
        "`&&` and `||` are mixed here without parentheses",
        "`&&` binds tighter than `||`, but readers often misjudge that, so Jet asks you to show the grouping",
        "Write `{grouped}` to keep today's meaning, or regroup the conditions the way you intended",
    )
    &state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: operand.span, new_text: grouped}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
}

// Rebuild the source spelling of `span` from its tokens. Whitespace between
// tokens becomes the same number of spaces, so byte offsets stay aligned.
fn parser_source_text(state: JetParserState, span: Span) -> String Never! {
    text := ""
    cursor := span.start
    loop token in state.tokens {
        if token.span.start < span.start || token.span.end > span.end || token.span.start == token.span.end -> next
        loop cursor < token.span.start {
            text = "{text} "
            cursor += 1
        }
        text = "{text}{token.payload.text}"
        cursor = token.span.end
    }
    text
}

fn parser_typed_literal_head_ahead(state: &JetParserState) -> Bool Never! {
    first :: parser_current_kind(&state)
    head :: state.position
    // D-DOTCTOR3 / D-TYPE-SUFFIX1=A: the optional typed-literal head is
    // `T?{ body }`; the `?` sits between the head type and its body.
    if first == TOKEN_LBRACKET {
        nested := 0
        index := head + 1
        loop index < state.tokens.len() {
            kind := state.tokens[index].kind
            if kind == TOKEN_EOF -> return false
            if kind == TOKEN_LBRACKET -> nested += 1
            if kind == TOKEN_RBRACKET {
                if nested == 0 {
                    next_kind := parser_lookahead_forward(state, index + 1, 0).kind
                    if next_kind == TOKEN_QUESTION -> return parser_lookahead_forward(state, index + 1, 1).kind == TOKEN_LBRACE
                    return next_kind == TOKEN_LBRACE || (next_kind == TOKEN_DOT && parser_lookahead_forward(state, index + 1, 1).kind == TOKEN_LBRACE)
                }
                nested -= 1
            }
            index += 1
        }
        return false
    }
    if first != TOKEN_IDENT && first != TOKEN_SELF -> return false
    index := head + 1
    nested := 0
    after_dot := false
    loop index < state.tokens.len() {
        kind := state.tokens[index].kind
        index += 1
        if parser_is_trivia(kind) -> next
        if kind == TOKEN_EOF || kind == TOKEN_SEMI || kind == TOKEN_RBRACE -> return false
        if {
            nested == 0 -> {
                if after_dot {
                    if kind != TOKEN_IDENT -> return false
                    after_dot = false
                    next
                }
                if kind == TOKEN_DOT {
                    after_dot = true
                    next
                }
                if kind == TOKEN_QUESTION -> return parser_lookahead_forward(state, index, 0).kind == TOKEN_LBRACE
                if kind != TOKEN_LT -> return kind == TOKEN_LBRACE
            }
            kind == TOKEN_LBRACE -> return false
        }
        if kind == TOKEN_LT -> nested += 1
        if kind == TOKEN_GT -> nested -= 1
        if kind == TOKEN_SHR -> nested -= 2
        if nested < 0 -> return false
    }
    false
}

fn parser_literal_fields_ahead(state: &JetParserState) -> Bool Never! {
    first := parser_kind_at(&state, 1)
    if first == TOKEN_RBRACE -> return true
    if first != TOKEN_IDENT -> return false
    second := parser_kind_at(&state, 2)
    second == TOKEN_COLON || second == TOKEN_COMMA || second == TOKEN_SEMI || second == TOKEN_RBRACE
}

fn parser_literal_close_terminators(state: &JetParserState) Never! {
    loop parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE -> parser_bump(&state)
}

fn parser_typed_literal_byte_head(head: Type?) -> Bool Never! {
    if head == {
        Val(ty) -> if ty == {
            .List(element) | .FixedList(element, _) -> parser_is_byte_type(element)
            else -> false
        }
        None -> false
    }
}

fn parser_parse_typed_literal_body(state: &JetParserState, head: Type?, start: Span, depth: Int) -> ParsedExpr {
    record_head := if head == {
        None -> true
        Val(ty) -> if ty == {
            .Named(name) -> name != "Layout"
            .Apply(_, _) -> true
            else -> false
        }
    }
    if record_head && parser_literal_fields_ahead(&state) {
        fields := parser_parse_expression_fields(&state, depth + 1)
        span := parser_cover(start, fields.span)
        if head == None {
            return ParsedExpr{expr: Expr.StructLit{type_name: "", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields.fields, inferred: true, span: span}, span: span}
        }
        body := if fields.fields.len() == 0 -> TypedLitBody.Empty else -> TypedLitBody.Fields{fields: fields.fields}
        return ParsedExpr{expr: Expr.TypedLit{head: Val(head), body: body, span: span}, span: span}
    }
    open := parser_expect(&state, TOKEN_LBRACE, "`{{` to open a typed literal")
    if parser_current_kind(&state) == TOKEN_RBRACE {
        close := parser_bump(&state)
        span := parser_cover(start, close.span)
        return ParsedExpr{expr: Expr.TypedLit{head: head, body: TypedLitBody.Empty, span: span}, span: span}
    }
    if parser_typed_literal_byte_head(head) && (parser_current_kind(&state) == TOKEN_STRING || parser_current_kind(&state) == TOKEN_RAW_STRING) && parser_kind_at(&state, 1) == TOKEN_RBRACE {
        text := parser_parse_string(&state, depth + 1)
        parts := [ByteTextPart]{}
        interpolated := false
        if text.expr == {
            .Str(source_parts, _) -> loop part in source_parts {
                if part == {
                    .Lit(value) -> &parts.push(ByteTextPart.Lit{text: value})
                    .Byte(value) -> &parts.push(ByteTextPart.Byte{value: value})
                    .Interp(_, _) -> interpolated = true
                }
            }
            else -> interpolated = true
        }
        parser_literal_close_terminators(&state)
        close := parser_expect(&state, TOKEN_RBRACE, "`}}` to close a typed literal")
        span := parser_cover(start, close.span)
        body := if interpolated -> TypedLitBody.Value{value: text.expr} else -> TypedLitBody.ByteText{parts: parts}
        return ParsedExpr{expr: Expr.TypedLit{head: head, body: body, span: span}, span: span}
    }
    map_head := if head == {
        Val(ty) -> if ty == { .Map(_, _, _) -> true else -> false }
        None -> false
    }
    list_head := if head == {
        Val(ty) -> if ty == {
            .List(_) | .FixedList(_, _) -> true
            .Named(name) -> name == "Layout"
            else -> false
        }
        None -> false
    }
    first := parser_parse_expression(&state, 1, depth + 1)
    parser_literal_close_terminators(&state)
    body := TypedLitBody.Value{value: first.expr}
    // #3739: a map head's lone expression with no `:` stays a one-expression
    // body; sema reads it as the whole value.
    if {
        (map_head && parser_current_kind(&state) != TOKEN_RBRACE) || (head == None && parser_current_kind(&state) == TOKEN_COLON) -> {
            parser_expect(&state, TOKEN_COLON, "`:` between a map key and its value")
            first_value :: parser_parse_expression(&state, 1, depth + 1)
            entries := [ExprPair]{ExprPair{key: first.expr, value: first_value.expr}}
            loop parser_current_kind(&state) == TOKEN_COMMA {
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
                key :: parser_parse_expression(&state, 1, depth + 1)
                parser_expect(&state, TOKEN_COLON, "`:` between a map key and its value")
                value :: parser_parse_expression(&state, 1, depth + 1)
                &entries.push(ExprPair{key: key.expr, value: value.expr})
            }
            body = TypedLitBody.Entries{entries: entries}
        }
        list_head || (head == None && parser_current_kind(&state) == TOKEN_COMMA) -> {
            elements := [Expr]{first.expr}
            loop parser_current_kind(&state) == TOKEN_COMMA {
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
                &elements.push(parser_parse_expression(&state, 1, depth + 1).expr)
            }
            body = TypedLitBody.Elements{elements: elements}
        }
    }
    parser_literal_close_terminators(&state)
    close := parser_expect(&state, TOKEN_RBRACE, "`}}` to close a typed literal")
    span := parser_cover(start, close.span)
    ParsedExpr{expr: Expr.TypedLit{head: head, body: body, span: span}, span: span}
}

fn parser_try_parse_typed_literal(state: &JetParserState, depth: Int) -> ParsedExpr? {
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_gt := state.pending_type_gt
    saved_gt_span := state.pending_type_gt_span
    parsed := parser_parse_type(&state, depth + 1)
    dotted := parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE
    if state.diagnostics.len() != saved_diagnostics || (!dotted && parser_current_kind(&state) != TOKEN_LBRACE) {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_gt
        state.pending_type_gt_span = saved_gt_span
        return None
    }
    if dotted {
        dot := parser_bump(&state)
        parser_add_error_code(&state, "E0320", dot.span, "typed collection construction uses `[T]{{…}}`, not `[T].{{…}}`", "D-LIT-DOT1 drops the constructor dot from every literal head", "write `[T]{{…}}`")
    }
    Val(parser_parse_typed_literal_body(&state, Val(parsed.ty), parsed.span, depth + 1))
}

// Rust `starts_shared_operand`: the tokens that open the value of a
// `shared expr` construction. Anything else leaves `shared` a plain name.
fn parser_starts_shared_operand(kind: Int) -> Bool Never! {
    kind == TOKEN_IDENT || kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_RAW_STRING || kind == TOKEN_STRING || kind == TOKEN_CHAR || kind == TOKEN_TRUE || kind == TOKEN_FALSE || kind == TOKEN_SELF || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE
}

fn parser_parse_prefix(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    if parser_expression_form_ahead(&state, allow_struct_lit) -> return parser_parse_expression_form(&state, depth + 1)
    token :: parser_current(&state)
    kind :: token.kind
    if kind == TOKEN_IDENT && token.payload.decoded == "task" -> return parser_parse_task_surface(&state, depth + 1)
    // D-CONC-SHARE1=A: `shared expr` is the one shared-cell construction
    // form. `shared` stays an ordinary name unless the next token opens a
    // value; the cell is the `Shared.new` call shape every tier lowers, and
    // it owns its payload, so the operand moves in.
    if kind == TOKEN_IDENT && token.payload.decoded == "shared" && parser_starts_shared_operand(parser_kind_at(&state, 1)) {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span :: parser_cover(token.span, operand.span)
        argument :: CallArg{convention: AccessConvention.Move, expr: operand.expr, span: operand.span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        return ParsedExpr{
            expr: Expr.MethodCall{receiver: Expr.Ident{name: "Shared", span: token.span}, method: "new", method_span: token.span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false},
            span: span,
        }
    }
    // D-PREP-SURFACE2=A: `prep { … }` in value position. The block's final
    // expression is its value, but no build-time value fold exists yet, so
    // the block is consumed and E0391 teaches the statement form. Where a
    // struct literal cannot follow (`if prep { … }`), `prep` stays a name.
    if allow_struct_lit && parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) {
        parser_bump(&state)
        block :: parser_parse_block(&state)
        span :: parser_cover(token.span, block.span)
        parser_add_error_code(&state, "E0391", span, "`prep {{ … }}` is used as a value in a form this compiler does not support yet", "D-PREP-SURFACE2=A makes the block's final expression its value; today only `name :: prep {{ value }}` with a single final expression is evaluated while building", "write `name :: prep {{ value }}` with one final expression, or bind the result inside a `prep {{ … }}` statement block")
        return ParsedExpr{expr: Expr.Unit{span: span}, span: span}
    }
    if allow_struct_lit && parser_typed_literal_head_ahead(&state) {
        typed :: parser_try_parse_typed_literal(&state, depth + 1)
        if typed == .Val(parsed) -> return parsed
    }
    if kind == TOKEN_PLUS_PLUS || kind == TOKEN_MINUS_MINUS {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        parser_report_retired_step(&state, token, operand.expr, parser_cover(token.span, operand.span), token.span.start, true)
        return operand
    }
    // D-SHAPE-COPY1=A: `~` copies its complete unary operand; it never
    // negates a Bool or integer.
    if kind == TOKEN_TILDE {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span :: parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.Copy{value: operand.expr, span: span}, span: span}
    }
    // Rust has no unary `+`: `+1` falls through to "expected a value".
    if kind == TOKEN_MINUS || kind == TOKEN_BANG {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        op := UnOp.Not
        if kind == TOKEN_MINUS -> op = UnOp.Neg
        span := parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.Unary{op: op, operand: operand.expr, span: span}, span: span}
    }
    // D-SHAPE-PLACE1=A / D-CAP-RECEIVER1=D: `&` or `^` marks the maximal
    // place after it. Before a place-rooted method chain it marks the place
    // the first call receives (`&buf.append(x)`, `^buf.seal()`).
    // D-COPY-DEFAULT1=A (#3714): `^` before a bare place (a name plus fields
    // or indexes) in any value position is the programmer's exact move
    // (`ys := ^xs`, `Box{xs: ^xs}`); sema checks the place and records the
    // move. Only a fresh value (a literal or call result) has nothing to move.
    if kind == TOKEN_AMP || kind == TOKEN_CARET {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(token.span, operand.span)
        if kind == TOKEN_CARET && !parser_contains_method_call(operand.expr) {
            if operand.expr == {
                .Ident(_, _) | .Field(_, _, _) | .Index(_, _, _, _) -> return ParsedExpr{expr: Expr.Place{value: operand.expr, access: PlaceAccess.Take, span: span}, span: span}
                else -> {}
            }
            parser_add_error_code(&state, "E0225", token.span, "the move marker `^` here marks a fresh value, not a named place", "`^` moves a named place (`^xs`, `^buf.seal()`); a literal or call result is already new, so it needs no mark", "remove `^`")
            return operand
        }
        access := PlaceAccess.Write
        if kind == TOKEN_CARET -> access = PlaceAccess.Take
        return ParsedExpr{expr: parser_mark_maximal_place(operand.expr, access, token.span), span: span}
    }
    if kind == TOKEN_STAR {
        parser_bump(&state)
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.RawOf{value: operand.expr, span: span}, span: span}
    }
    if kind == TOKEN_KW_MOVE && parser_kind_at(&state, 1) == TOKEN_LPAREN {
        take_names :: parser_parse_lambda_takes(&state)
        return parser_parse_lambda(&state, depth + 1, take_names)
    }
    if kind == TOKEN_KW_COPY {
        parser_bump(&state)
        parser_add_error_code(&state, "E0991", token.span, "`copy` is now the `~` sigil", "Jet has exactly one spelling for a copy — the `~` sigil (D-SHAPE-COPY1) — so all code reads the same", "write `~name` in place of `copy name`")
        operand :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.Copy{value: operand.expr, span: span}, span: span}
    }
    // Rust `primary`: `if` and `loop` in value position are always the value
    // forms (`if cond -> a else -> b`, tables, collecting or result loops).
    if kind == TOKEN_KW_IF || kind == TOKEN_KW_LOOP -> return parser_parse_expression_form(&state, depth + 1)
    // D-LIT-DOT1: `.{ … }` is retired; an inferred record is `{ … }`.
    if kind == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        dot :: parser_bump(&state)
        parser_add_fatal_code(&state, "E0320", dot.span, "inferred record construction uses `{{…}}`, not `.{{…}}`", "D-LIT-DOT1 drops the constructor dot from every literal head", "write `{{…}}`")
        fields :: parser_parse_expression_fields(&state, depth + 1)
        span :: parser_cover(dot.span, fields.span)
        return ParsedExpr{
            expr: Expr.StructLit{type_name: "", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields.fields, inferred: true, span: span},
            span: span,
        }
    }
    // D-SHAPE3a=A: `.new(...)` leaves only the static receiver implicit; sema
    // fills the empty receiver name from the expected type.
    if kind == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == "new" {
        parser_bump(&state)
        method :: parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_LPAREN -> parser_expect(&state, TOKEN_LPAREN, "`(` after `.new`")
        args :: if parser_current_kind(&state) == TOKEN_LPAREN -> parser_parse_call_args(&state, depth + 1, false) else -> [CallArg]{}
        span :: parser_cover(token.span, parser_lookahead(&state, -1).span)
        return ParsedExpr{
            expr: Expr.MethodCall{receiver: Expr.Ident{name: "", span: token.span}, method: "new", method_span: method.span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false},
            span: span,
        }
    }
    // D-SUBJECT-CALL1=A: a lower-case `.member` is the implicit-receiver
    // member shorthand; the postfix loop reads the rest of `.member.m(x)`.
    if kind == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT {
        first_byte :: parser_lookahead(&state, 1).payload.decoded.bytes()[0]
        if Int.from_u8(first_byte) >= 97 && Int.from_u8(first_byte) <= 122 {
            parser_bump(&state)
            member :: parser_bump(&state)
            member_span :: parser_cover(token.span, member.span)
            return ParsedExpr{expr: Expr.Field{base: Expr.Ident{name: "", span: token.span}, member: member.payload.decoded, span: member_span}, span: member_span}
        }
    }
    if kind == TOKEN_DOT && (parser_kind_at(&state, 1) == TOKEN_IDENT || parser_kind_at(&state, 1) == TOKEN_NULL) {
        parser_bump(&state)
        variant :: if parser_current_kind(&state) == TOKEN_NULL -> parser_bump(&state) else -> parser_expect_name(&state, "after `.` in an enum value")
        args :: parser_parse_variant_args(&state, depth + 1, allow_struct_lit)
        end := variant.span
        if state.position > 0 {
            previous :: parser_lookahead(&state, -1)
            if previous.kind == TOKEN_RPAREN || previous.kind == TOKEN_RBRACE -> end = previous.span
        }
        span := parser_cover(token.span, end)
        return ParsedExpr{
            expr: Expr.EnumLit{type_name: "", variant: variant.payload.decoded, variant_span: Val(variant.span), args: args, leading_dot: true, span: span},
            span: span,
        }
    }
    if kind == TOKEN_LPAREN -> return parser_parse_parenthesized(&state, depth + 1)
    if kind == TOKEN_LBRACKET -> return parser_parse_collection(&state, depth + 1)
    if allow_struct_lit && kind == TOKEN_LBRACE {
        return parser_parse_typed_literal_body(&state, None, token.span, depth + 1)
    }

    // D-PREP-SURFACE2=A: a retired `@`-marked constant read teaches E0388 and
    // reads the plain ALL_CAPS name.
    if parser_reads_retired_constant(&state) {
        parser_bump(&state)
        plain :: parser_retire_const_mark(&state, token)
        return ParsedExpr{expr: Expr.Ident{name: plain, span: token.span}, span: token.span}
    }
    // Optional constructors keep the contextual EnumLit shape used by Rust;
    // sema supplies the payload type from the expected optional type.
    // `Val` without `(` is still an ordinary identifier.
    if kind == TOKEN_IDENT && token.payload.decoded == "Val" && parser_kind_at(&state, 1) == TOKEN_LPAREN {
        parser_bump(&state)
        parser_expect(&state, TOKEN_LPAREN, "after `Val`")
        inner :: parser_parse_expression(&state, 0, depth + 1)
        parser_expect(&state, TOKEN_RPAREN, "after the value inside `Val(...)`")
        span :: parser_cover(token.span, inner.span)
        return ParsedExpr{
            expr: Expr.EnumLit{type_name: "", variant: "Val", variant_span: Val(token.span), args: [EnumLitArg]{EnumLitArg.Positional{value: inner.expr}}, leading_dot: false, span: span},
            span: span,
        }
    }
    if kind == TOKEN_IDENT || kind == TOKEN_SELF || kind == TOKEN_KW_IT {
        parser_bump(&state)
        return ParsedExpr{expr: Expr.Ident{name: token.payload.decoded, span: token.span}, span: token.span}
    }
    if kind == TOKEN_TRUE || kind == TOKEN_FALSE {
        parser_bump(&state)
        return ParsedExpr{expr: Expr.Bool{value: kind == TOKEN_TRUE, span: token.span}, span: token.span}
    }
    if kind == TOKEN_NULL {
        parser_bump(&state)
        return ParsedExpr{expr: Expr.EnumLit{type_name: "", variant: "None", variant_span: Val(token.span), args: [EnumLitArg]{}, leading_dot: false, span: token.span}, span: token.span}
    }
    if kind == TOKEN_INT {
        parser_bump(&state)
        value := token.payload.integer ?? 0
        return ParsedExpr{expr: Expr.Int{value: value, span: token.span, width: None, raw: Val(token.payload.text)}, span: token.span}
    }
    if kind == TOKEN_UNIT_NUMBER {
        parser_bump(&state)
        // Rust `UnitNumber`: `raw` is the lexer's digit spelling and the
        // suffix span covers only the suffix.
        suffix :: token.payload.suffix
        suffix_span :: Span{start: token.span.end - suffix.bytes().len(), end: token.span.end}
        return ParsedExpr{
            expr: Expr.UnitLit{raw: token.payload.decoded, int: token.payload.integer, float: token.payload.decimal, suffix: suffix, suffix_span: suffix_span, span: token.span},
            span: token.span,
        }
    }
    if kind == TOKEN_FLOAT {
        parser_bump(&state)
        value := token.payload.decimal ?? 0.0
        return ParsedExpr{expr: Expr.Float{value: value, span: token.span, is_f32: false, raw: Val(token.payload.decoded)}, span: token.span}
    }
    if kind == TOKEN_CHAR {
        parser_bump(&state)
        return ParsedExpr{expr: Expr.Char{value: token.payload.decoded, span: token.span}, span: token.span}
    }
    if kind == TOKEN_STRING || kind == TOKEN_RAW_STRING -> return parser_parse_string(&state, depth + 1)
    if kind == TOKEN_DOT_DOT_DOT {
        parser_bump(&state)
        value :: parser_parse_expression(&state, 13, depth + 1)
        span := parser_cover(token.span, value.span)
        return ParsedExpr{expr: Expr.Spread{value: value.expr, span: span}, span: span}
    }

    parser_add_error(&state, token.span, "expected a value, found `{token.payload.text}`", "a value can be a name, literal, collection, call, or parenthesized expression", "write an expression such as `x`, `42`, or `\"hello\"`")
    if kind != TOKEN_EOF && kind != TOKEN_RBRACE && kind != TOKEN_RPAREN && kind != TOKEN_RBRACKET && kind != TOKEN_COMMA && kind != TOKEN_SEMI -> parser_bump(&state)
    ParsedExpr{expr: Expr.Unit{span: token.span}, span: token.span}
}

fn parser_parse_string(state: &JetParserState, depth: Int) -> ParsedExpr {
    token :: parser_bump(&state)
    parts := [StrPart]{}
    index := 0
    loop index < token.payload.string_parts.len() {
        part :: token.payload.string_parts[index]
        if part.kind == {
            STRING_PART_TEXT -> &parts.push(StrPart.Lit{text: part.text})
            STRING_PART_BYTE -> &parts.push(StrPart.Byte{value: U8{part.byte}})
            STRING_PART_INTERPOLATION -> parser_parse_interpolation(&state, part, depth, &parts)
            else -> {}
        }
        index += 1
    }
    if token.payload.string_parts.len() == 0 -> &parts.push(StrPart.Lit{text: token.payload.decoded})
    ParsedExpr{expr: Expr.Str{parts: parts, span: token.span}, span: token.span}
}

// Rust `str_expr_from_parts`: one value, an optional debug label `=`, one
// optional selector, then the end of the hole. A failure is fatal for the
// statement, as Rust returns it as `Err`; an unknown selector (E0914) is not.
fn parser_parse_interpolation(state: &JetParserState, part: StringPart, depth: Int, parts: &[StrPart]) {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        result_handler_depth: state.result_handler_depth,
        statement_start: -1,
    }
    if parser_current_kind(&nested) == TOKEN_EQ {
        parser_add_error(&state, parser_current(&nested).span, "empty debug-label interpolation `{{=}}`", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}` or `{{x + 1=}}`")
        return
    }
    value :: parser_parse_expression(&nested, 1, depth + 1)
    loop block in nested.block_spans -> &state.block_spans.push(block)
    if nested.diagnostics.len() > 0 {
        parser_take_nested_failure(&state, nested.diagnostics)
        return
    }
    label := ""
    if parser_current_kind(&nested) == TOKEN_EQ {
        loop index in 0..<nested.position {
            token :: nested.tokens[index]
            piece :: parser_debug_label_piece(token)
            if piece == "" {
                parser_add_error(&state, token.span, "`{{…=}}` debug labels need a simple expression, not {parser_describe_token(token)}", "the label reprints the expression text before `=`", "use a name or a short expression such as `{{count=}}`")
                return
            }
            label = "{label}{piece}"
        }
        if label == "" {
            parser_add_error(&state, parser_current(&nested).span, "empty debug-label interpolation", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}`")
            return
        }
        parser_bump(&nested)
    }
    format :: parser_parse_string_format(&nested)
    if nested.abort_mark != 0 {
        parser_take_nested_failure(&state, nested.diagnostics)
        return
    }
    loop diagnostic in nested.diagnostics -> &state.diagnostics.push(diagnostic)
    if parser_current_kind(&nested) != TOKEN_EOF {
        extra :: parser_current(&nested)
        parser_add_error(&state, extra.span, "unexpected {parser_describe_token(extra)} inside this interpolated `{{ }}`", "the braces hold exactly one value, optional trailing `=`, and one optional format selector", "keep one value per `{{ }}`, for example \"{{a}}\", \"{{a=}}\", or \"{{a:Unit(bare)}}\"")
        return
    }
    if label != "" {
        &parts.push(StrPart.Lit{text: label})
        &parts.push(StrPart.Lit{text: " = "})
    }
    &parts.push(StrPart.Interp{expr: value.expr, format: format})
}

// Rust's debug-label spelling of one token, or "" when the token cannot
// appear in a label.
fn parser_debug_label_piece(token: Token) -> String Never! {
    if token.kind == {
        TOKEN_IDENT -> token.payload.decoded
        TOKEN_INT -> "{token.payload.integer ?? 0}"
        TOKEN_FLOAT -> "{token.payload.decimal ?? 0.0}"
        TOKEN_DOT -> "."
        TOKEN_LPAREN -> "("
        TOKEN_RPAREN -> ")"
        TOKEN_LBRACKET -> "["
        TOKEN_RBRACKET -> "]"
        TOKEN_PLUS -> " + "
        TOKEN_MINUS -> " - "
        TOKEN_STAR -> " * "
        TOKEN_SLASH -> " / "
        TOKEN_PERCENT -> " % "
        else -> ""
    }
}

// A nested hole parser failed: its diagnostics reach the file and the
// enclosing statement stops, as Rust's `Err(first)` does.
fn parser_take_nested_failure(state: &JetParserState, diagnostics: [Diagnostic]) {
    if parser_aborting(&state) -> return
    loop diagnostic in diagnostics -> &state.diagnostics.push(diagnostic)
    state.abort_mark = state.diagnostics.len()
}

// D-ONCE-HASH1=B / D-FMT-INTERP3=B: the closed interpolation selector
// vocabulary. An unknown selector is E0914 and leaves the bare Display form.
// `#` is the retired selector rail, still read so fmt can rewrite it.
fn parser_parse_string_format(state: &JetParserState) -> StrFormat {
    if parser_current_kind(&state) != TOKEN_COLON && parser_current_kind(&state) != TOKEN_HASH -> return StrFormat.Display
    parser_bump(&state)
    if parser_current_kind(&state) != TOKEN_IDENT {
        parser_expect_name(&state, "after `:` in interpolation")
        return StrFormat.Display
    }
    selector :: parser_bump(&state)
    name :: selector.payload.decoded
    head :: ":{name}"
    if name == "Debug" -> return StrFormat.Debug
    if name == "Pretty" -> return StrFormat.Pretty
    if name == "Bin" -> return StrFormat.Bin
    if name == "Oct" -> return StrFormat.Oct
    if name == "Fixed" -> return StrFormat.Fixed{digits: parser_parse_selector_argument(&state, head, "decimal places")}
    if name == "Grouped" -> return StrFormat.Grouped{digits: parser_parse_selector_argument(&state, head, "decimal places")}
    if name == "Sci" -> return StrFormat.Sci{digits: parser_parse_selector_argument(&state, head, "decimal places")}
    if name == "Percent" -> return StrFormat.Percent{digits: parser_parse_selector_argument(&state, head, "decimal places")}
    if name == "Hex" -> return StrFormat.Hex{digits: parser_parse_selector_argument(&state, head, "width")}
    if name == "Pad" || name == "PadLeft" {
        parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
        width :: parser_parse_selector_integer(&state, head, "width")
        fill := ""
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            fill = parser_parse_selector_fill(&state, head)
        }
        parser_expect(&state, TOKEN_RPAREN, "after the fill in `{head}(n, fill)`")
        if name == "Pad" -> return StrFormat.Pad{width: width, fill: fill}
        return StrFormat.PadLeft{width: width, fill: fill}
    }
    if name == "Unit" {
        parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
        style :: parser_expect_name(&state, "inside `{head}( )`")
        format := StrFormat.Unit{format: UnitFormat.Name}
        if style.payload.decoded == "bare" -> format = StrFormat.Unit{format: UnitFormat.Bare}
        if style.kind == TOKEN_IDENT && style.payload.decoded != "name" && style.payload.decoded != "bare" {
            parser_add_error(&state, style.span, "unknown unit style `{style.payload.decoded}`", "`{head}` accepts `name` or `bare`", "write `{head}(name)` or `{head}(bare)`")
        }
        parser_expect(&state, TOKEN_RPAREN, "after the style in `{head}( )`")
        return format
    }
    parser_add_error_code(&state, "E0914", selector.span, "unknown interpolation selector `{head}`", "string interpolation supports a closed selector set — use `:Debug`, `:Pretty`, `:Fixed(n)`, `:Grouped(n)`, `:Hex(n)`, `:Pad(n[, \"fill\"])`, `:PadLeft(n[, \"fill\"])`, `:Sci(n)`, `:Percent(n)`, `:Bin`, `:Oct`, or `:Unit(name|bare)`", "write `{{value:Debug}}`, `{{value:Pretty}}`, `{{value:Fixed(2)}}`, `{{value:Grouped(2)}}`, `{{value:Hex(2)}}`, `{{value:Pad(2, \" \")}}`, `{{value:PadLeft(2, \" \")}}`, `{{value:Sci(2)}}`, `{{value:Percent(2)}}`, `{{value:Bin}}`, `{{value:Oct}}`, `{{value:Unit(name)}}` or `{{value:Unit(bare)}}`, or `{{value}}`")
    StrFormat.Display
}

// `:Fixed(n)` and the other one-integer selectors.
fn parser_parse_selector_argument(state: &JetParserState, head: String, parameter: String) -> Int {
    parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
    value :: parser_parse_selector_integer(&state, head, parameter)
    parser_expect(&state, TOKEN_RPAREN, "after the {parameter} in `{head}(n)`")
    value
}

fn parser_parse_selector_integer(state: &JetParserState, head: String, parameter: String) -> Int {
    token :: parser_bump(&state)
    if token.kind == TOKEN_INT -> return token.payload.integer ?? 0
    example :: if parameter == "width" -> "16" else -> "2"
    noun :: if parameter == "width" -> "width" else -> "precision"
    parser_add_error(&state, token.span, "expected {parameter} inside `{head}( )`", "`{head}(n)` takes one nonnegative integer literal", "write a {noun} such as `{head}({example})`")
    0
}

// The quoted fill of `:Pad(n, "fill")`: fixed text, never a second
// interpolation.
fn parser_parse_selector_fill(state: &JetParserState, head: String) -> String {
    token :: parser_bump(&state)
    if token.kind == TOKEN_RAW_STRING -> return token.payload.decoded
    if token.kind != TOKEN_STRING {
        parser_add_error(&state, token.span, "expected a literal fill string inside `{head}( )`", "`{head}(n, fill)` takes a quoted fill string", "write a fill such as `{head}(8, \"0\")`")
        return ""
    }
    if token.payload.string_parts.len() == 0 -> return token.payload.decoded
    fill := ""
    loop part in token.payload.string_parts {
        if part.kind == STRING_PART_INTERPOLATION {
            parser_add_error(&state, token.span, "padding fill inside `{head}( )` cannot interpolate", "a padding fill is fixed text, not a second interpolation", "write a quoted fill such as `{head}(8, \"0\")`")
            return ""
        }
        if part.kind == STRING_PART_TEXT -> fill = "{fill}{part.text}"
        if part.kind == STRING_PART_BYTE {
            byte_text :: String.from_bytes([U8]{U8{part.byte}}) ?? ""
            fill = "{fill}{byte_text}"
        }
    }
    fill
}

fn parser_parse_parenthesized(state: &JetParserState, depth: Int) -> ParsedExpr {
    if parser_looks_like_lambda(&state) -> return parser_parse_lambda(&state, depth + 1, [NamedSpan]{})
    open :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_RPAREN {
        close :: parser_bump(&state)
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.Unit{span: span}, span: span}
    }

    fields := [TupleField]{}
    first_name := ""
    if parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON {
        name :: parser_bump(&state)
        first_name = name.payload.decoded
        parser_bump(&state)
    }
    first :: parser_parse_expression(&state, 1, depth + 1)
    &fields.push(TupleField{name: first_name, value: first.expr})
    // S73: tuples name every member; a positional `(a, b)` teaches E0048.
    if first_name == "" && parser_current_kind(&state) == TOKEN_COMMA {
        parser_add_error_code(&state, "E0048", open.span, "Jet tuples name every member — positional `(1, 2)` isn't allowed (S73)", "named members make field access obvious and avoid `.0`, which collides with decimal numbers", "write named members: `(x: 1, y: 2)` and use `p.x`, not `p.0`")
        parser_skip_to_rparen(&state)
        return ParsedExpr{expr: Expr.Int{value: 0, span: open.span, width: None, raw: None}, span: open.span}
    }
    if parser_current_kind(&state) != TOKEN_COMMA {
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after the expression")
        span := parser_cover(open.span, close.span)
        if first_name != "" -> parser_add_error(&state, span, "a tuple needs at least two named members", "a single `(name: value)` would be ambiguous with grouping — use a one-field `struct` instead", "add another member: `(x: 1, y: 2)`")
        return ParsedExpr{expr: Expr.Paren{value: first.expr, span: span}, span: span}
    }
    parser_bump(&state)
    // Rust `parse_tuple_lit`: every later member is `name: value` too.
    loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF {
        label :: parser_expect_name(&state, "for a tuple member name")
        parser_expect(&state, TOKEN_COLON, "after each tuple member name")
        value :: parser_parse_expression(&state, 1, depth + 1)
        &fields.push(TupleField{name: label.payload.decoded, value: value.expr})
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RPAREN, "`)` after the tuple")
    span := parser_cover(open.span, close.span)
    if fields.len() < 2 -> parser_add_error(&state, span, "a tuple needs at least two named members", "a single `(name: value)` would be ambiguous with grouping — use a one-field `struct` instead", "add another member: `(x: 1, y: 2)`")
    ParsedExpr{expr: Expr.TupleLit{fields: fields, span: span, ty: None}, span: span}
}

// S46: `(` … `)` opens a lambda only when the contents have parameter shape
// and a lambda interface or arrow follows; `(a > b) ->` stays a condition.
fn parser_looks_like_lambda(state: &JetParserState) -> Bool {
    if parser_current_kind(&state) != TOKEN_LPAREN -> return false
    index := parser_next_code_index(state, state.position + 1)
    if index < 0 -> return false
    if state.tokens[index].kind == TOKEN_RPAREN -> return parser_lambda_tail_starts_at(&state, index + 1)
    loop {
        if index < 0 || state.tokens[index].kind != TOKEN_IDENT -> return false
        index = parser_next_code_index(state, index + 1)
        if index < 0 -> return false
        if state.tokens[index].kind == TOKEN_COLON {
            index += 1
            type_start :: index
            parens := 0
            brackets := 0
            braces := 0
            angles := 0
            loop index < state.tokens.len() {
                kind :: state.tokens[index].kind
                if parens == 0 && brackets == 0 && braces == 0 && angles == 0 && (kind == TOKEN_COMMA || kind == TOKEN_RPAREN) -> break
                if {
                    kind == TOKEN_LPAREN -> parens += 1
                    kind == TOKEN_RPAREN && parens > 0 -> parens -= 1
                    kind == TOKEN_LBRACKET -> brackets += 1
                    kind == TOKEN_RBRACKET && brackets > 0 -> brackets -= 1
                    kind == TOKEN_LBRACE -> braces += 1
                    kind == TOKEN_RBRACE && braces > 0 -> braces -= 1
                    kind == TOKEN_LT -> angles += 1
                    kind == TOKEN_GT && angles > 0 -> angles -= 1
                    kind == TOKEN_SHR && angles > 0 -> angles = if angles > 2 -> angles - 2 else -> 0
                    else -> {}
                }
                index += 1
            }
            if index == type_start || index >= state.tokens.len() -> return false
        }
        kind :: state.tokens[index].kind
        if kind == TOKEN_RPAREN -> return parser_lambda_tail_starts_at(&state, index + 1)
        if kind != TOKEN_COMMA -> return false
        index = parser_next_code_index(state, index + 1)
    }
    false
}

// D-LAMBDA-IFACE1=A: probe the real result and effect parsers after a
// parameter list, so type-start tokens that are also expression operators
// (`*`, `(`, `[`, `?`) do not turn grouped expressions into lambdas.
fn parser_lambda_tail_starts_at(state: &JetParserState, index: Int) -> Bool {
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    saved_type_gt :: state.pending_type_gt
    saved_type_gt_span :: Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.end}
    saved_semicolon :: state.explicit_semicolon_reported
    state.position = index
    state.pending_type_gt = false
    _ := parser_parse_lambda_return_interface(&state, 0)
    effects :: parser_parse_opt_func_effects(&state)
    failed :: parser_aborting(&state) && state.abort_mark > saved_diagnostics
    starts :: !failed && (effects.effects != None || effects.via != None || parser_at_unified_arrow(&state))
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    state.pending_type_gt = saved_type_gt
    state.pending_type_gt_span = saved_type_gt_span
    state.explicit_semicolon_reported = saved_semicolon
    starts
}

pub struct ParsedLambdaInterface {
    pub result_type: Type?
    pub error_type: Type?
}

// The optional result between a lambda's parameters and its arrow: a type,
// or a unit-fallible `E!`. A result type `T E!` splits into both halves.
fn parser_parse_lambda_return_interface(state: &JetParserState, depth: Int) -> ParsedLambdaInterface {
    result :: if !parser_func_effect_starts_here(&state) && parser_type_starts_here(&state) -> Val(parser_parse_type(&state, depth + 1)) else -> parser_parse_unit_fallible_return(&state)
    if result == .Val(parsed) {
        if parsed.ty == .Result(ok, err) -> return ParsedLambdaInterface{result_type: Val(ok), error_type: Val(err)}
        return ParsedLambdaInterface{result_type: Val(parsed.ty), error_type: None}
    }
    ParsedLambdaInterface{result_type: None, error_type: None}
}

fn parser_parse_lambda_takes(state: &JetParserState) -> [NamedSpan] {
    start :: parser_current(&state).span
    parser_bump(&state)
    parser_expect(&state, TOKEN_LPAREN, "after `take` in a capture list")
    captures := [NamedSpan]{}
    valid := true
    if parser_current_kind(&state) != TOKEN_RPAREN {
        loop {
            name_kind :: parser_current_kind(&state)
            name :: parser_expect_name(&state, "in the capture list")
            if {
                name_kind == TOKEN_IDENT -> {
                    &captures.push(NamedSpan{name: name.payload.decoded, span: name.span})
                }
                else -> {
                    valid = false
                    if name_kind != TOKEN_RPAREN && name_kind != TOKEN_EOF -> parser_bump(&state)
                }
            }
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            if parser_current_kind(&state) != TOKEN_COMMA {
                token :: parser_current(&state)
                parser_add_error(&state, token.span, "expected `,` between captured names", "capture names are comma-separated", "add a comma or close the capture list")
                valid = false
                loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF -> parser_bump(&state)
                break
            }
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
    }
    closed := parser_current_kind(&state) == TOKEN_RPAREN
    parser_expect(&state, TOKEN_RPAREN, "after the capture list")
    if !closed -> valid = false
    if valid {
        parser_add_error_code(&state, "E0057", start, "this closure uses the retired `take(...)` capture prefix", "closures infer captures: Copy values copy at creation and owned non-Copy values move", "remove `take(...)` and use the captured names directly")
    }
    captures
}

fn parser_parse_lambda(state: &JetParserState, depth: Int, take_names: [NamedSpan]) -> ParsedExpr {
    open :: parser_expect(&state, TOKEN_LPAREN, "`(` before lambda parameters")
    params := [LambdaParam]{}
    if parser_current_kind(&state) != TOKEN_RPAREN {
        loop !parser_aborting(&state) {
            name :: parser_expect_name(&state, "as a lambda parameter")
            ty := Type?{None}
            ty_span := Span?{None}
            if parser_current_kind(&state) == TOKEN_COLON {
                parser_bump(&state)
                parsed :: parser_parse_type(&state, depth + 1)
                ty = Val(parsed.ty)
                ty_span = Val(parsed.span)
            }
            &params.push(LambdaParam{name: name.payload.decoded, name_span: name.span, ty: ty, ty_span: ty_span})
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            parser_expect(&state, TOKEN_COMMA, "`,` between lambda parameters")
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
    }
    close :: parser_expect(&state, TOKEN_RPAREN, "`)` after lambda parameters")
    interface :: parser_parse_lambda_return_interface(&state, depth)
    effects :: parser_parse_opt_func_effects(&state)
    if effects.via == .Val(via) {
        parser_add_fatal_code(&state, "E0119", via.span, "a lambda effect row cannot publish `via`", "a lambda stores a concrete effect row as part of its callable interface", "write the effects directly, for example `-[Net]>`")
    }
    if effects.effects == None -> parser_expect_unified_arrow(&state, "after the lambda interface")
    body :: parser_parse_lambda_arrow_body(&state, depth, close.span.end)
    span := Span{start: open.span.start, end: body.end}
    lambda := Lambda{
        take_names: take_names,
        params: params,
        result_type: interface.result_type,
        error_type: interface.error_type,
        effects: effects.effects,
        body: body.body,
        span: span,
        meta: ast_empty_lambda_meta(),
    }
    ParsedExpr{expr: Expr.Lambda{lambda: lambda}, span: span}
}

pub struct ParsedLambdaBody {
    pub body: LambdaBody
    pub end: Int
}

// S46: the body after a lambda's arrow, `-> expr` or `-> {{ … }}`. A single
// assignment needs no braces: `a -> a.balance -= n` is the one-statement form
// of `a -> {{ a.balance -= n }}`. `fallback_end` bounds the lambda's span.
fn parser_parse_lambda_arrow_body(state: &JetParserState, depth: Int, fallback_end: Int) -> ParsedLambdaBody {
    if parser_current_kind(&state) == TOKEN_LBRACE {
        // D-TAIL-RETURN1=A: a block lambda keeps one unadorned final value.
        block :: parser_parse_callable_body(&state, true)
        return ParsedLambdaBody{body: LambdaBody.Block{body: block.statements}, end: block.span.end}
    }
    value :: parser_parse_expression(&state, 1, depth + 1)
    if parser_is_assignment_operator(parser_current_kind(&state)) {
        operator :: parser_bump(&state)
        right :: parser_parse_expression(&state, 1, depth + 1)
        target :: parser_expression_lvalue(&state, value.expr, value.span, operator)
        end :: if right.span.end > fallback_end -> right.span.end else -> fallback_end
        return ParsedLambdaBody{body: LambdaBody.Block{body: [Stmt]{Stmt.Assign{target: target, op: parser_assignment_binop(operator.kind), op_span: operator.span, value: right.expr}}}, end: end}
    }
    end :: if value.span.end > fallback_end -> value.span.end else -> fallback_end
    ParsedLambdaBody{body: LambdaBody.Expr{value: value.expr}, end: end}
}

// D-UI-CLOSURE1=A: the brace body attached directly to a call.
fn parser_parse_trailing_lambda(state: &JetParserState) -> Lambda {
    open :: parser_current(&state).span
    body :: parser_parse_lambda_arrow_body(&state, 0, open.end)
    Lambda{
        take_names: [NamedSpan]{},
        params: [LambdaParam]{},
        result_type: None,
        error_type: None,
        effects: None,
        body: body.body,
        span: Span{start: open.start, end: body.end},
        meta: ast_empty_lambda_meta(),
    }
}

// D-SPREAD1=A: after `.`, `[a, b, c]` lists member names that hang off the
// prefix; S84 package names may be dashed (`util-linux`). Anything else in
// the list is E0961, skipped to the next `,` or `]`.
fn parser_parse_member_spread(state: &JetParserState, base: ParsedExpr) -> ParsedExpr {
    parser_bump(&state)
    members := [ExprMember]{}
    if parser_current_kind(&state) != TOKEN_RBRACKET {
        loop {
            if parser_current_kind(&state) == TOKEN_IDENT {
                first :: parser_bump(&state)
                name := first.payload.decoded
                end := first.span.end
                loop parser_current_kind(&state) == TOKEN_MINUS && parser_current(&state).span.start == end && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).span.start == end + 1 {
                    parser_bump(&state)
                    segment :: parser_bump(&state)
                    name = "{name}-{segment.payload.decoded}"
                    end = segment.span.end
                }
                if parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_RBRACKET {
                    &members.push(ExprMember{name: name, span: Span{start: first.span.start, end: end}})
                } else {
                    parser_report_member_spread_entry(&state)
                }
            } else {
                parser_report_member_spread_entry(&state)
            }
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RBRACKET -> break
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACKET, "`]` to close a member spread `.[…]`")
    span :: parser_cover(base.span, close.span)
    ParsedExpr{expr: Expr.MemberSpread{base: base.expr, members: members, span: span}, span: span}
}

fn parser_report_member_spread_entry(state: &JetParserState) {
    bad :: parser_current(&state).span
    parser_add_error_code(&state, "E0961", bad, "`.[ ]` lists member names, not calls or expressions", "member spread names fields or package names that hang off the prefix", "write bare names like `default.[cargo, ripgrep]`")
    loop parser_current_kind(&state) != TOKEN_COMMA && parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF -> parser_bump(&state)
}

// Rust `Syntax::INTERNAL_TASK_*`: NUL-led compiler-private names the `task`
// sugar lowers into, so no source name can collide with them.
fn parser_task_internal(name: String) -> String Never! {
    nul :: String.from_bytes([U8]{U8{0}}) ?? ""
    "{nul}jet.{name}"
}

fn parser_task_call(head: Span, method: String, method_span: Span, argument: Expr, argument_span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: parser_task_internal("task"), span: head}, method: parser_task_internal(method), method_span: method_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: argument, span: argument_span, flags: ast_empty_call_arg_flags(), label: None, spread: false}}, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false}
}

fn parser_task_spawn(head: Span, take_names: [NamedSpan], body: LambdaBody, body_span: Span) -> Expr Never! {
    lambda :: Lambda{take_names: take_names, params: [LambdaParam]{}, result_type: None, error_type: None, effects: None, body: body, span: body_span, meta: ast_empty_lambda_meta()}
    parser_task_call(head, "task.spawn", head, Expr.Lambda{lambda: lambda}, body_span)
}

// D-CONC-SPAWN1=D / D-CONC-ALLNAMED1=A: one `task` word owns single-task
// spawn (`task { … }`, `task ^name { … }`, `task value`), `task.timeout(d)`
// and the `all`/`race`/`any` combinators. Named `task.all` branches build a
// tuple, positional ones a list; mixing the two is E1117.
fn parser_parse_task_surface(state: &JetParserState, depth: Int) -> ParsedExpr {
    head :: parser_bump(&state).span
    if parser_current_kind(&state) == TOKEN_DOT {
        parser_bump(&state)
        selector :: parser_expect_name(&state, "after `task.`")
        name :: selector.payload.decoded
        if name == "group" {
            parser_add_error(&state, selector.span, "`task.group` is a statement, not a value", "a task group owns a block and its children until the closing brace", "write `task.group name {{ … }}`")
            return ParsedExpr{expr: Expr.Unit{span: head}, span: head}
        }
        if name == "timeout" {
            parser_expect(&state, TOKEN_LPAREN, "after `task.timeout`")
            argument :: parser_parse_expression(&state, 1, depth + 1)
            close :: parser_expect(&state, TOKEN_RPAREN, "to finish `task.timeout`")
            span :: parser_cover(head, close.span)
            return ParsedExpr{expr: parser_task_call(head, "task.timeout", selector.span, argument.expr, argument.span), span: span}
        }
        if name != "all" && name != "race" && name != "any" {
            parser_add_error(&state, selector.span, "unknown task selector `{name}`", "task selectors use `timeout`, `all`, `race`, or `any`", "write `task.timeout(duration)`, `task.all {{ … }}`, `task.race {{ … }}`, or `task.any {{ … }}`")
            return ParsedExpr{expr: Expr.Unit{span: head}, span: head}
        }
        open :: parser_expect(&state, TOKEN_LBRACE, "after the task selector")
        named := [TupleField]{}
        positional := [Expr]{}
        saw_named := false
        saw_positional := false
        mixed := Span?{None}
        if parser_current_kind(&state) != TOKEN_RBRACE {
            loop !parser_aborting(&state) {
                label := ""
                style_span := parser_current(&state).span
                if name == "all" && parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON {
                    label_token :: parser_bump(&state)
                    parser_bump(&state)
                    label = label_token.payload.decoded
                    style_span = label_token.span
                    saw_named = true
                } else {
                    saw_positional = true
                }
                if saw_named && saw_positional && mixed == None -> mixed = Val(style_span)
                spawn := Expr.Unit{span: style_span}
                if parser_current_kind(&state) == TOKEN_LBRACE {
                    block :: parser_parse_block(&state)
                    spawn = parser_task_spawn(head, [NamedSpan]{}, LambdaBody.Block{body: block.statements}, block.span)
                } else {
                    value :: parser_parse_expression(&state, 1, depth + 1)
                    spawn = parser_task_spawn(head, [NamedSpan]{}, LambdaBody.Expr{value: value.expr}, value.span)
                }
                if label.len() > 0 {
                    &named.push(TupleField{name: label, value: spawn})
                } else {
                    &positional.push(spawn)
                }
                parser_skip_semicolons(&state)
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
                parser_expect(&state, TOKEN_COMMA, "between task branches")
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
            }
        }
        close :: parser_expect(&state, TOKEN_RBRACE, "to close the task combinator")
        list_span :: parser_cover(open.span, close.span)
        if mixed == .Val(mixed_span) {
            parser_add_fatal_code(&state, "E1117", mixed_span, "`task.all` branches must all be named or all positional.", "D-CONC-ALLNAMED1=A gives named results stable record fields and keeps positional results as ordered lists; mixing the two shapes would make the result type ambiguous.", "Use `task.all {{ first: work(), second: other() }}`, or remove every branch label.")
        }
        argument :: if saw_named -> Expr.TupleLit{fields: named, span: list_span, ty: None} else -> Expr.ListLit{elements: positional, span: list_span}
        span :: parser_cover(head, close.span)
        return ParsedExpr{expr: parser_task_call(head, "task.{name}", selector.span, argument, list_span), span: span}
    }
    // D-CONC-FREEZE1=A: `task ^name { … }` consumes one enclosing binding.
    take_names := [NamedSpan]{}
    if parser_current_kind(&state) == TOKEN_CARET {
        caret :: parser_bump(&state)
        taken :: parser_expect_name(&state, "after the task capture `^`")
        &take_names.push(NamedSpan{name: taken.payload.decoded, span: parser_cover(caret.span, taken.span)})
    }
    if parser_current_kind(&state) != TOKEN_LBRACE {
        value :: parser_parse_expression(&state, 1, depth + 1)
        span :: parser_cover(head, value.span)
        return ParsedExpr{expr: parser_task_spawn(head, take_names, LambdaBody.Expr{value: value.expr}, value.span), span: span}
    }
    // A brace body holding one tail expression folds into an expression
    // body, so every tier sees one task-value shape.
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    open :: parser_bump(&state)
    tail :: parser_parse_expression(&state, 1, depth + 1)
    if parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE -> parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_RBRACE && !parser_error_since(state, saved_diagnostics) {
        close :: parser_bump(&state)
        body_span :: parser_cover(open.span, close.span)
        return ParsedExpr{expr: parser_task_spawn(head, take_names, LambdaBody.Expr{value: tail.expr}, body_span), span: parser_cover(head, close.span)}
    }
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    block :: parser_parse_block(&state)
    ParsedExpr{expr: parser_task_spawn(head, take_names, LambdaBody.Block{body: block.statements}, block.span), span: parser_cover(head, block.span)}
}

fn parser_parse_collection(state: &JetParserState, depth: Int) -> ParsedExpr {
    open :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_RBRACKET {
        close :: parser_bump(&state)
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.ListLit{elements: [Expr]{}, span: span}, span: span}
    }
    // Rust `list_or_map_lit`: the first element decides list or map; the
    // retired `[:]` is an ordinary missing-value error at the `:`.
    first :: parser_parse_expression(&state, 1, depth + 1)
    if parser_current_kind(&state) == TOKEN_COLON {
        parser_bump(&state)
        first_value :: parser_parse_expression(&state, 1, depth + 1)
        entries := [ExprPair]{ExprPair{key: first.expr, value: first_value.expr}}
        loop parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RBRACKET -> break
            key :: parser_parse_expression(&state, 1, depth + 1)
            parser_expect(&state, TOKEN_COLON, "`:` between a map key and its value")
            value :: parser_parse_expression(&state, 1, depth + 1)
            &entries.push(ExprPair{key: key.expr, value: value.expr})
        }
        if parser_current_kind(&state) != TOKEN_RBRACKET && parser_unclosed_delimiter(&state, "map") {
            cut_span :: parser_cover(open.span, parser_lookahead(&state, -1).span)
            return ParsedExpr{expr: Expr.MapLit{entries: entries, span: cut_span}, span: cut_span}
        }
        close :: parser_expect(&state, TOKEN_RBRACKET, "`]` to close the map literal")
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.MapLit{entries: entries, span: span}, span: span}
    }
    values := [Expr]{first.expr}
    loop parser_current_kind(&state) == TOKEN_COMMA {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_RBRACKET -> break
        &values.push(parser_parse_expression(&state, 1, depth + 1).expr)
    }
    if parser_current_kind(&state) != TOKEN_RBRACKET && parser_unclosed_delimiter(&state, "list") {
        cut_span :: parser_cover(open.span, parser_lookahead(&state, -1).span)
        return ParsedExpr{expr: Expr.ListLit{elements: values, span: cut_span}, span: cut_span}
    }
    close :: parser_expect(&state, TOKEN_RBRACKET, "`]` to close the list literal")
    span := parser_cover(open.span, close.span)
    ParsedExpr{expr: Expr.ListLit{elements: values, span: span}, span: span}
}

// The dotted name an `Ident(.Ident)*` chain spells, or "" for any other shape.
fn parser_literal_head_path(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _) -> name
        .Field(base, member, _) -> {
            prefix :: parser_literal_head_path(base)
            if prefix == "" -> "" else -> "{prefix}.{member}"
        }
        else -> ""
    }
}

fn parser_parse_postfix(state: &JetParserState, initial: ParsedExpr, depth: Int, allow_struct_lit: Bool) -> ParsedExpr {
    expression := initial
    // Rust `expr_primary`: a capitalized name's own `<…>` (`Pool<T>.new()`)
    // and D-GENERIC-CALL1=A call-site arguments (`decode<Order>(raw)`).
    owner_type_args := [Type]{}
    call_type_args := [Type]{}
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_LT {
            bare_name :: if expression.expr == {
                .Ident(name, _) -> name
                else -> ""
            }
            if allow_struct_lit && owner_type_args.len() == 0 && parser_pascal_name(bare_name) {
                owner_type_args = parser_parse_call_type_args(&state, depth + 1)
                next
            }
            callee :: if expression.expr == {
                .Ident(_, _) | .Field(_, _, _) -> true
                else -> false
            }
            if callee && call_type_args.len() == 0 && parser_turbofish_ahead(&state) {
                call_type_args = parser_parse_call_type_args(&state, depth + 1)
                next
            }
            break
        }
        if kind == TOKEN_LPAREN {
            method_name :: if expression.expr == {
                .Field(_, method, _) -> method
                else -> ""
            }
            args := [CallArg]{}
            if {
                method_name == "take_pattern" -> {
                    parser_bump(&state)
                    pattern :: parser_parse_take_pattern_literal(&state, depth + 1)
                    &args.push(CallArg{convention: AccessConvention.Read, expr: pattern.expr, span: pattern.span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
                    parser_expect(&state, TOKEN_RPAREN, "`)` after the take_pattern literal")
                }
                // D-DYNARRAY1: `.view(a..b)` is the one spelling; its two
                // ends become the constructor's two arguments.
                method_name == "view" -> {
                    parser_bump(&state)
                    range :: parser_parse_expression(&state, 1, depth + 1)
                    if range.expr == {
                        .Range(start, end, _, _) -> {
                            &args.push(CallArg{convention: AccessConvention.Read, expr: start, span: expr_span(start), flags: ast_empty_call_arg_flags(), label: None, spread: false})
                            &args.push(CallArg{convention: AccessConvention.Read, expr: end, span: expr_span(end), flags: ast_empty_call_arg_flags(), label: None, spread: false})
                        }
                        else -> parser_add_error_here(&state, "expected a `..` between the view's start and end", "the structure here isn't what the compiler expected", "use `..` between the view's start and end")
                    }
                    parser_expect(&state, TOKEN_RPAREN, "`)` to finish the call")
                }
                else -> {
                    args = parser_parse_call_args(&state, depth + 1, false)
                }
            }
            // D-UI-CLOSURE1=A: a direct call may carry one trailing block
            // closure, kept as a typed lambda argument; sema assigns its
            // parameter label after resolving the call.
            optional_call :: if expression.expr == {
                .OptField(_, _, _, _, _) -> true
                else -> false
            }
            if allow_struct_lit && !optional_call && parser_current_kind(&state) == TOKEN_LBRACE {
                lambda :: parser_parse_trailing_lambda(&state)
                lambda_span :: lambda.span
                flags := ast_empty_call_arg_flags()
                flags.is_trailing_block = true
                &args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Lambda{lambda: lambda}, span: lambda_span, flags: flags, label: None, spread: false})
            }
            close_span :: parser_current(&state)
            end := close_span.span
            if state.position > 0 -> end = parser_lookahead(&state, -1).span
            span := parser_cover(expression.span, end)
            if expression.expr == {
                .Ident(name, name_span) -> {
                    type_args :: if call_type_args.len() > 0 -> call_type_args else -> owner_type_args
                    call := Call{name: name, name_span: name_span, type_args: type_args, args: args, resolved_ret: None, range_checked: false, widen_approx: false}
                    expression = ParsedExpr{expr: Expr.Call{call: call}, span: span}
                }
                .Field(receiver, method, method_span) -> {
                    // D-CONC-SHARE1=A: `Shared.new(x)` is retired; teach at
                    // `new` (Rust `member_span`) and keep the method call.
                    if method == "new" && parser_literal_head_path(receiver) == "Shared" -> parser_add_error_code(&state, "E1115", Span{start: method_span.end - method.len(), end: method_span.end}, "`Shared.new(…)` is the retired shared-cell constructor.", "D-CONC-SHARE1=A gives shared state one construction word, so every shared cell reads the same on the page.", "Write `shared <value>` instead of `Shared.new(<value>)`.")
                    expression = ParsedExpr{
                        expr: Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: call_type_args, args: args, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false},
                        span: span,
                    }
                }
                .OptField(receiver, method, method_span, _, _) -> {
                    expression = ParsedExpr{
                        expr: Expr.OptMethodCall{receiver: receiver, method: method, method_span: method_span, type_args: [Type]{}, args: args, span: span},
                        span: span,
                    }
                }
                else -> expression = ParsedExpr{expr: Expr.CallValue{callee: expression.expr, args: args, span: span}, span: span}
            }
            owner_type_args = [Type]{}
            call_type_args = [Type]{}
            next
        }
        // A bare `{ }` after a field chain is a struct literal only on an
        // `alias.Type` head; after any other field or an index it is E0335.
        if kind == TOKEN_LBRACE && allow_struct_lit {
            alias := ""
            type_name := ""
            bad_block := false
            if expression.expr == {
                .Field(base, member, _) -> {
                    if base == {
                        .Ident(name, _) -> {
                            alias = name
                            type_name = member
                        }
                        else -> bad_block = true
                    }
                }
                .Index(_, _, _, _) | .Slice(_, _, _, _, _) -> bad_block = true
                else -> {}
            }
            if bad_block {
                bad_span :: parser_current(&state).span
                parser_add_fatal_code(&state, "E0335", bad_span, "trailing blocks are only valid on direct calls", "a bare `{{ }}` here is not a call argument; code arguments use `() -> {{ … }}` inside a call's parentheses", "write `callee(() -> {{ … }})` on a call")
                break
            }
            if alias.len() == 0 -> break
            parsed :: parser_parse_expression_fields(&state, depth + 1)
            span := parser_cover(expression.span, parsed.span)
            first_byte :: Int.from_u8(alias.bytes()[0])
            upper :: first_byte >= 65 && first_byte <= 90
            literal :: if upper -> Expr.StructLit{type_name: "{alias}.{type_name}", type_args: [Type]{}, import_ns: None, as_trait: None, fields: parsed.fields, inferred: false, span: span} else -> Expr.StructLit{type_name: type_name, type_args: [Type]{}, import_ns: Val(alias), as_trait: None, fields: parsed.fields, inferred: false, span: span}
            expression = ParsedExpr{expr: literal, span: span}
            next
        }
        if kind == TOKEN_LBRACKET {
            open :: parser_bump(&state)
            // D-LAYOUT-FACTS1=B: `[.field]` (or `[.field..end]`) is a typed
            // layout selector, kept as an identifier with an internal name.
            if parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT && (parser_kind_at(&state, 2) == TOKEN_RBRACKET || parser_kind_at(&state, 2) == TOKEN_DOT_DOT) {
                dot :: parser_bump(&state)
                field :: parser_bump(&state)
                selector :: Expr.Ident{name: parser_task_internal("layout.selector.{field.payload.decoded}"), span: parser_cover(dot.span, field.span)}
                if parser_current_kind(&state) == TOKEN_DOT_DOT {
                    parser_bump(&state)
                    end :: parser_parse_expression(&state, 1, depth + 1)
                    slice_close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after a slice range")
                    slice_span :: parser_cover(open.span, slice_close.span)
                    expression = ParsedExpr{expr: Expr.Slice{base: expression.expr, start: selector, end: end.expr, range: None, span: slice_span}, span: slice_span}
                    next
                }
                selector_close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after an index")
                selector_span :: parser_cover(open.span, selector_close.span)
                expression = ParsedExpr{expr: Expr.Index{base: expression.expr, index: selector, span: selector_span, kind: IndexKind.Unknown}, span: selector_span}
                next
            }
            index :: parser_parse_expression(&state, 1, depth + 1)
            close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after the index")
            span := parser_cover(expression.span, close.span)
            if index.expr == {
                .Range(start, end, exclusive, _) -> {
                    range_expr := index.expr
                    expression = ParsedExpr{
                        expr: Expr.Slice{base: expression.expr, start: start, end: end, range: Val(range_expr), span: span},
                        span: span,
                    }
                }
                else -> expression = ParsedExpr{expr: Expr.Index{base: expression.expr, index: index.expr, span: span, kind: IndexKind.Unknown}, span: span}
            }
            next
        }
        if kind == TOKEN_DOT || kind == TOKEN_QUESTION_DOT {
            operator :: parser_bump(&state)
            // A capitalized name's `<…>` belongs only to the member it names.
            owner_head :: parser_literal_head_path(expression.expr)
            if owner_head == "" || owner_head.contains(".") -> owner_type_args = [Type]{}
            // D-CAP9: postfix `p.*` dereferences a raw pointer (`p.*.field`
            // composes); sema gates it to `#Unsafe`.
            if operator.kind == TOKEN_DOT && parser_current_kind(&state) == TOKEN_STAR {
                star :: parser_bump(&state)
                deref_span :: parser_cover(expression.span, star.span)
                expression = ParsedExpr{expr: Expr.Deref{value: expression.expr, span: deref_span}, span: deref_span}
                next
            }
            // D-LIT-DOT1: `Type.{ … }` / `alias.Type.{ … }` is retired; the
            // literal head touches its brace. Any other `x.{` leaves the
            // brace to open a block.
            if allow_struct_lit && operator.kind == TOKEN_DOT && parser_current_kind(&state) == TOKEN_LBRACE {
                path :: parser_literal_head_path(expression.expr)
                if path == "" -> break
                construction :: if path.contains(".") -> "literal" else -> "struct"
                brace :: parser_current(&state).span
                parser_add_error_code(&state, "E0320", brace, "{construction} construction uses `{path}{{…}}`, not `{path}.{{…}}`", "literal heads place no dot before their brace (D-LIT-DOT1)", "write `{path}{{…}}`")
                expression = parser_parse_typed_literal_body(&state, Val(Type.Named{name: path}), expression.span, depth + 1)
                next
            }
            // D-SPREAD1=A: `prefix.[a, b, c]` member spread.
            if operator.kind == TOKEN_DOT && parser_current_kind(&state) == TOKEN_LBRACKET {
                expression = parser_parse_member_spread(&state, expression)
                next
            }
            // S73: `.0` reads like a decimal number, so tuple members are named.
            if parser_current_kind(&state) == TOKEN_INT || parser_current_kind(&state) == TOKEN_FLOAT {
                number :: parser_bump(&state)
                parser_add_error_code(&state, "E0049", number.span, "Jet doesn't use numeric field access like `.0` (S73)", "`.0` looks like the start of a decimal number, so tuple members must have names", "name the members when you build the tuple: `(x: 1, y: 2)`, then read `p.x`")
                span := parser_cover(expression.span, number.span)
                expression = ParsedExpr{expr: Expr.Field{base: expression.expr, member: "0", span: span}, span: span}
                next
            }
            member :: if parser_current_kind(&state) == TOKEN_KW_COPY || parser_current_kind(&state) == TOKEN_KW_MOVE -> parser_bump(&state) else -> parser_expect_name(&state, "after the field-access operator")
            member_name :: if member.kind == TOKEN_KW_COPY || member.kind == TOKEN_KW_MOVE -> member.payload.text else -> member.payload.decoded
            span := parser_cover(expression.span, member.span)
            expression = if operator.kind == TOKEN_QUESTION_DOT -> ParsedExpr{expr: Expr.OptField{base: expression.expr, member: member_name, member_span: member.span, flatten: false, span: span}, span: span} else -> ParsedExpr{expr: Expr.Field{base: expression.expr, member: member_name, span: span}, span: span}
            next
        }
        if kind == TOKEN_QUESTION {
            if parser_expression_result_handler_ahead(&state) {
                expression = parser_parse_result_handler_form(&state, expression, depth + 1)
                next
            }
            operator :: parser_bump(&state)
            // D-FAILURE-FOUNDATION1=A: bare `?` propagation is retired; only
            // `x?)` and the context frame `x?(note)` remain.
            if parser_current_kind(&state) == TOKEN_LPAREN {
                parser_bump(&state)
                note :: parser_parse_expression(&state, 1, depth + 1)
                parser_expect(&state, TOKEN_RPAREN, "`)` to finish the failure context")
                note_span :: parser_cover(expression.span, note.span)
                expression = ParsedExpr{expr: Expr.Try{value: expression.expr, span: note_span, conversion: TryConvert.NoConversion, context: Val(note.expr)}, span: note_span}
                next
            }
            if parser_current_kind(&state) != TOKEN_RPAREN {
                parser_add_fatal_code(&state, "E-ERR-PROPAGATE", operator.span, "Bare `?` propagation is retired.", "Fallible calls propagate automatically; `?(text)` is reserved for adding one failure-context frame.", "remove the trailing `?`, or write `?(text)` to add one context frame.")
                break
            }
            span := parser_cover(expression.span, operator.span)
            expression = ParsedExpr{expr: Expr.Try{value: expression.expr, span: span, conversion: TryConvert.NoConversion, context: None}, span: span}
            next
        }
        if kind == TOKEN_PLUS_PLUS || kind == TOKEN_MINUS_MINUS {
            operator :: parser_bump(&state)
            following :: parser_current_kind(&state)
            if following == TOKEN_IDENT || following == TOKEN_INT || following == TOKEN_FLOAT || following == TOKEN_LPAREN || following == TOKEN_SELF {
                // `a--b` / `a++b`: never read as a silent double sign.
                sign :: if operator.kind == TOKEN_PLUS_PLUS -> "+" else -> "-"
                spelling :: "{sign}{sign}"
                parser_add_error_code(&state, "E0160", operator.span, "`{spelling}` is not a Jet operator", "Jet retired `++` and `--`; reading `a{spelling}b` as `a {sign} {sign}b` would hide a sign inside an operator", "write `a {sign} {sign}b` with a space, or `a {sign} b` if one sign was meant")
                right :: parser_parse_expression_restricted(&state, 13, depth + 1, allow_struct_lit, false)
                span := parser_cover(expression.span, right.span)
                op :: if operator.kind == TOKEN_PLUS_PLUS -> BinOp.Add else -> BinOp.Sub
                expression = ParsedExpr{expr: Expr.Binary{op: op, left: expression.expr, right: right.expr, span: span}, span: span}
                next
            }
            parser_report_retired_step(&state, operator, expression.expr, parser_cover(expression.span, operator.span), expression.span.start, false)
            next
        }
        break
    }
    expression
}

// Rust `at_turbofish`: `<` touching the call name opens call type
// arguments only when the matching `>` touches a `(`, so a spaced
// `f < T > (x)` stays a comparison.
fn parser_turbofish_ahead(state: &JetParserState) -> Bool Never! {
    if state.position == 0 || state.tokens[state.position - 1].span.end != parser_current(&state).span.start -> return false
    nested := 0
    loop index in state.position..<state.tokens.len() {
        token :: state.tokens[index]
        if token.kind == TOKEN_LT -> nested += 1
        if token.kind == TOKEN_GT -> nested -= 1
        if token.kind == TOKEN_SHR -> nested -= 2
        if (token.kind == TOKEN_GT || token.kind == TOKEN_SHR) && nested <= 0 {
            return index + 1 < state.tokens.len() && state.tokens[index + 1].kind == TOKEN_LPAREN && state.tokens[index + 1].span.start == token.span.end
        }
        if token.kind == TOKEN_SEMI || token.kind == TOKEN_LBRACE || token.kind == TOKEN_RBRACE || token.kind == TOKEN_EOF -> return false
    }
    false
}

// Rust `parse_turbofish` / the capitalized-name `<…>`: comma-separated
// types, a trailing comma allowed, closed by `>` (or half of `>>`).
fn parser_parse_call_type_args(state: &JetParserState, depth: Int) -> [Type] {
    parser_bump(&state)
    args := [Type]{}
    loop {
        &args.push(parser_parse_type(&state, depth + 1).ty)
        if state.pending_type_gt || parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
        if parser_type_close_here(&state) -> break
    }
    if !parser_type_close_here(&state) {
        parser_add_error_here(&state, "expected `>` after call type arguments", "generic type arguments must be closed", "add `>`")
        return args
    }
    _ := parser_type_gt_span(&state)
    args
}

// D-INCR1 is retired (owner decision 2026-09-28): `x += 1` / `x -= 1` (S17) is
// the one spelling. `++`/`--` stay lexer tokens only so this one teaching
// diagnostic fires instead of `--x` parsing as a double negation. The parser
// keeps the operand for recovery. A step that is its whole statement gets a
// Safe compound-assignment edit; a step inside an expression must be hoisted
// into its own statement by hand, preserving the read order.
fn parser_report_retired_step(state: &JetParserState, operator: Token, operand: Expr, whole: Span, starts_at: Int, prefix: Bool) {
    state.retired_step = Val(whole)
    increment :: operator.kind == TOKEN_PLUS_PLUS
    spelling :: if increment -> "++" else -> "--"
    compound :: if increment -> "+=" else -> "-="
    place :: parser_retired_step_place(operand) ?? "x"
    following :: parser_current_kind(&state)
    whole_statement :: starts_at == state.statement_start && (following == TOKEN_SEMI || following == TOKEN_RBRACE || following == TOKEN_EOF)
    replacement :: "{place} {compound} 1"
    why :: "Jet updates a number with compound assignment only; an update hidden inside an expression reads one value and stores another"
    if whole_statement && parser_retired_step_place(operand) != None {
        diagnostic :: diagnostic_from_registry("E0160", Val(whole), "`{spelling}` is not a Jet operator", why, "write `{replacement}`")
        &state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: whole, new_text: replacement}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
        return
    }
    fix :: if prefix -> "write `{replacement}` as its own statement before this line, then use `{place}` here" else -> "use `{place}` here, then write `{replacement}` as its own statement after this line"
    parser_add_error_code(&state, "E0160", whole, "`{spelling}` is not a Jet operator", why, fix)
}

fn parser_retired_step_place(operand: Expr) -> String? {
    if operand == {
        .Ident(name, _) -> return Val(name)
        .Field(base, member, _) -> {
            base_text :: parser_retired_step_place(base) ?? return None
            return Val("{base_text}.{member}")
        }
        .Paren(inner, _) -> return parser_retired_step_place(inner)
        else -> return None
    }
}

// D-SHAPE-PLACE1=A / D-CAP-RECEIVER1=D: true when a projection chain passes
// through a method call, so a leading mark belongs to the place that call
// receives rather than to the chain.
fn parser_contains_method_call(expr: Expr) -> Bool Never! {
    if expr == {
        .MethodCall(_, _, _, _, _, _, _, _, _, _) -> return true
        .Field(base, _, _) -> return parser_contains_method_call(base)
        .Index(base, _, _, _) -> return parser_contains_method_call(base)
        .Slice(base, _, _, _, _) -> return parser_contains_method_call(base)
        else -> return false
    }
}

// A `&`/`^` mark binds the maximal place after it — a name plus fields,
// indexes, or ranges — and never a call result: `&buf.grow().len()` marks
// `buf` for `grow`, and `&values[0..1]` marks the whole range place.
fn parser_mark_maximal_place(expr: Expr, access: PlaceAccess, mark: Span) -> Expr {
    if expr == {
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, recv_type, resolved_ret, operator_rhs, checked_widen) -> {
            return Expr.MethodCall{receiver: parser_mark_maximal_place(receiver, access, mark), method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, recv_type: recv_type, resolved_ret: resolved_ret, operator_rhs: operator_rhs, checked_widen: checked_widen}
        }
        .Field(base, member, span) -> {
            if parser_contains_method_call(base) -> return Expr.Field{base: parser_mark_maximal_place(base, access, mark), member: member, span: span}
        }
        .Index(base, index, span, kind) -> {
            if parser_contains_method_call(base) -> return Expr.Index{base: parser_mark_maximal_place(base, access, mark), index: index, span: span, kind: kind}
        }
        .Slice(base, start, end, range, span) -> {
            if parser_contains_method_call(base) -> return Expr.Slice{base: parser_mark_maximal_place(base, access, mark), start: start, end: end, range: range, span: span}
        }
        else -> {}
    }
    span :: parser_cover(mark, expr_span(expr))
    Expr.Place{value: expr, access: access, span: span}
}

fn parser_call_access_prefix(state: &JetParserState) -> AccessConvention Never! {
    kind := parser_current_kind(&state)
    if kind == TOKEN_AMP {
        parser_bump(&state)
        return AccessConvention.Write
    }
    if kind == TOKEN_CARET {
        parser_bump(&state)
        return AccessConvention.Move
    }
    AccessConvention.Read
}

fn parser_parse_call_args(state: &JetParserState, depth: Int, allow_marker_labels: Bool) -> [CallArg] {
    parser_expect(&state, TOKEN_LPAREN, "`(` before call arguments")
    args := [CallArg]{}
    if parser_current_kind(&state) != TOKEN_RPAREN {
        loop {
            mark_span := parser_current(&state).span
            convention := parser_call_access_prefix(&state)
            argument_span := parser_current(&state).span
            spread := parser_current_kind(&state) == TOKEN_DOT_DOT_DOT
            if spread -> parser_bump(&state)
            label := CallLabel?{None}
            label_kind := parser_current_kind(&state)
            has_label := label_kind == TOKEN_IDENT || label_kind == TOKEN_KW_TAG || (allow_marker_labels && label_kind == TOKEN_KW_USE)
            if has_label && parser_kind_at(&state, 1) == TOKEN_COLON {
                label_token :: parser_bump(&state)
                parser_bump(&state)
                label_name := label_token.payload.decoded
                if label_token.kind == TOKEN_KW_TAG -> label_name = "tag"
                if label_token.kind == TOKEN_KW_USE -> label_name = "use"
                label = Val(CallLabel{name: label_name, span: label_token.span})
                after_label_span :: parser_current(&state).span
                after_label := parser_call_access_prefix(&state)
                if after_label != AccessConvention.Read {
                    if convention != AccessConvention.Read {
                        parser_add_error_code(&state, "E0029", argument_span, "this argument has two access markers", "an argument's access marker is written once, on the value", "keep the sigil after the label and remove the other")
                    }
                    convention = after_label
                    mark_span = after_label_span
                }
            }
            argument :: parser_parse_expression(&state, 1, depth + 1)
            // D-CAP-RECEIVER1=D: before a place-rooted method chain the mark
            // binds the place the first call receives, and the call's fresh
            // result passes unmarked (`inspect(&buf.grow())`).
            if !spread && convention != AccessConvention.Read && parser_contains_method_call(argument.expr) {
                access := PlaceAccess.Write
                if convention == AccessConvention.Move -> access = PlaceAccess.Take
                marked :: parser_mark_maximal_place(argument.expr, access, mark_span)
                &args.push(CallArg{convention: AccessConvention.Read, expr: marked, span: argument_span, flags: ast_empty_call_arg_flags(), label: label, spread: spread})
            } else {
                &args.push(CallArg{convention: convention, expr: argument.expr, span: argument_span, flags: ast_empty_call_arg_flags(), label: label, spread: spread})
            }
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            if parser_current_kind(&state) != TOKEN_COMMA {
                if parser_unclosed_delimiter(&state, "call") -> return args
                token :: parser_current(&state)
                parser_add_error(&state, token.span, "expected `,` between call arguments", "call arguments are comma-separated", "add a comma or close the call")
                break
            }
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
    }
    parser_expect(&state, TOKEN_RPAREN, "`)` after call arguments")
    args
}

fn parser_parse_expression_fields(state: &JetParserState, depth: Int) -> ParsedExprFields {
    open :: parser_expect(&state, TOKEN_LBRACE, "`{{` before record fields")
    fields := [ExprField]{}
    if parser_current_kind(&state) != TOKEN_RBRACE {
        loop {
            if parser_state_section_ahead(&state) {
                section_start :: parser_current(&state).span
                section := parser_parse_state_section(&state, "", section_start)
                parser_report_ineligible_state_section(&state, section, "anonymous shape")
                if parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RBRACE || parser_current_kind(&state) == TOKEN_EOF -> break
                next
            }
            name_token :: parser_expect_name(&state, "for a record field")
            value := Expr.Ident{name: name_token.payload.decoded, span: name_token.span}
            if parser_current_kind(&state) == TOKEN_COLON {
                parser_bump(&state)
                parsed_value :: parser_parse_expression(&state, 1, depth + 1)
                value = parsed_value.expr
            }
            &fields.push(ExprField{name: name_token.payload.decoded, name_span: name_token.span, value: value})
            if parser_current_kind(&state) == TOKEN_RBRACE -> break
            separator_kind := parser_current_kind(&state)
            if {
                separator_kind == TOKEN_COMMA || separator_kind == TOKEN_SEMI -> {
                    parser_bump(&state)
                    if parser_current_kind(&state) == TOKEN_RBRACE -> break
                }
                else -> {
                    token :: parser_current(&state)
                    parser_add_error(&state, token.span, "expected a separator between record fields", "record fields are separated by commas or statement terminators", "add a comma or close the record")
                    break
                }
            }
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after record fields")
    ParsedExprFields{fields: fields, span: parser_cover(open.span, close.span)}
}

// A record payload `.Case{…}` is read only where a struct literal may stand,
// as in Rust: in an `if` or loop header the `{` opens the body.
fn parser_parse_variant_args(state: &JetParserState, depth: Int, allow_struct_lit: Bool) -> [EnumLitArg] {
    args := [EnumLitArg]{}
    if {
        parser_current_kind(&state) == TOKEN_LPAREN -> {
            parser_bump(&state)
            if parser_current_kind(&state) != TOKEN_RPAREN {
                loop {
                    if {
                        parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON -> {
                            label :: parser_bump(&state)
                            parser_bump(&state)
                            value :: parser_parse_expression(&state, 1, depth + 1)
                            &args.push(EnumLitArg.Named{label: label.payload.decoded, expr: value.expr})
                        }
                        else -> {
                            value :: parser_parse_expression(&state, 1, depth + 1)
                            &args.push(EnumLitArg.Positional{value: value.expr})
                        }
                    }
                    if parser_current_kind(&state) == TOKEN_RPAREN -> break
                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                    parser_bump(&state)
                    if parser_current_kind(&state) == TOKEN_RPAREN -> break
                }
            }
            parser_expect(&state, TOKEN_RPAREN, "`)` after enum payload")
        }
        allow_struct_lit && parser_current_kind(&state) == TOKEN_LBRACE -> {
            fields :: parser_parse_expression_fields(&state, depth + 1)
            field_index := 0
            loop field_index < fields.fields.len() {
                field :: fields.fields[field_index]
                &args.push(EnumLitArg.Named{label: field.name, expr: field.value})
                field_index += 1
            }
        }
    }
    args
}


fn parser_parse_or_fallback(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> OrFallback {
    if parser_current_kind(&state) == TOKEN_LBRACE {
        block :: parser_parse_value_block(&state, depth + 1, false)
        return OrFallback.Block{body: block.statements, value: block.tail, span: block.span}
    }
    token :: parser_current(&state)
    if token.kind == TOKEN_RETURN {
        parser_bump(&state)
        value := Expr?{None}
        if parser_current_kind(&state) != TOKEN_COMMA && parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_SEMI && parser_current_kind(&state) != TOKEN_EOF {
            value = Val(parser_parse_expression_restricted(&state, 1, depth + 1, allow_struct_lit, stop_before_comparison).expr)
        }
        return OrFallback.Return{value: value, span: token.span}
    }
    // D-LOOP-CONTROLWORD1=B: bare `?? next` is contextual control and
    // `break(name)` / `next(name)` exit the named loop; `?? next(value)`
    // with anything but one name stays an ordinary call fallback.
    if token.kind == TOKEN_BREAK {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parser_bump(&state)
            name :: parser_expect_name(&state, "as the loop name in `break(name)`")
            close :: parser_expect(&state, TOKEN_RPAREN, "`)` after the named break target")
            return OrFallback.BreakLabel{name: name.payload.decoded, span: parser_cover(token.span, close.span)}
        }
        return OrFallback.Break{span: token.span}
    }
    if token.kind == TOKEN_IDENT && token.payload.decoded == "next" && (parser_kind_at(&state, 1) != TOKEN_LPAREN || (parser_kind_at(&state, 2) == TOKEN_IDENT && parser_kind_at(&state, 3) == TOKEN_RPAREN)) {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parser_bump(&state)
            name :: parser_bump(&state)
            close :: parser_bump(&state)
            return OrFallback.ContinueLabel{name: name.payload.decoded, span: parser_cover(token.span, close.span)}
        }
        return OrFallback.Continue{span: token.span}
    }
    value :: parser_parse_expression_restricted(&state, 2, depth + 1, allow_struct_lit, stop_before_comparison)
    // Rust `parse_or_fallback`: a bare `panic(...)` call is the panic fallback.
    if value.expr == .Call(call) {
        if call.name == "panic" -> return OrFallback.Panic{name_span: call.name_span, args: call.args}
    }
    OrFallback.Value{value: value.expr}
}

fn parser_fallback_span(fallback: OrFallback) -> Span {
    if fallback == {
        .Value(value) -> expr_span(value)
        .Block(_, _, span) -> span
        .Return(_, span) -> span
        .Panic(name_span, _) -> name_span
        .Break(span) -> span
        .Continue(span) -> span
        .BreakLabel(_, span) -> span
        .ContinueLabel(_, span) -> span
        else -> Span{start: 0, end: 0}
    }
}