// Pratt expressions preserve retired arithmetic precedence solely to produce
// behavior-preserving method repairs.
use {
    jet_foundation.[
        AccessConvention,
        AppliedRuleApplication,
        BinOp,
        ByteTextPart,
        Call,
        CallArg,
        CallLabel,
        CallMark,
        Diagnostic,
        DiagnosticFixApplicability,
        DiagnosticFixSafety,
        EnumLitArg,
        Expr,
        ExprField,
        ExprMember,
        ExprPair,
        IndexKind,
        Marker,
        Lambda,
        LambdaBody,
        LambdaParam,
        NamedSpan,
        OrFallback,
        PlaceAccess,
        RuleSite,
        Span,
        Stmt,
        StrFormat,
        StrPart,
        TextEdit,
        TryConvert,
        TupleField,
        Type,
        TypedLitBody,
        UnOp,
        UnitFormat,
        LIST_TYPE_OWNER,
        ast_empty_call_arg_flags,
        ast_empty_lambda_meta,
        diagnostic_from_registry,
        diagnostic_with_edit,
        diagnostic_with_edit_grade,
        expr_span,
        fact_read_kind,
        marker_registered,
        foundation_named_type,
        pipe_value_is_name,
        pipe_value_name,
        PipeStep,
    ]
    jet_lexer.[
        STRING_PART_BYTE,
        STRING_PART_INTERPOLATION,
        STRING_PART_TEXT,
        TOKEN_AMP,
        TOKEN_AND_AND,
        TOKEN_BANG,
        TOKEN_BREAK,
        TOKEN_CHAR,
        TOKEN_COLON,
        TOKEN_COMMA,
        TOKEN_COMPARE,
        TOKEN_DOT,
        TOKEN_DOT_DOT,
        TOKEN_DOT_DOT_DOT,
        TOKEN_DOT_DOT_LT,
        TOKEN_EOF,
        TOKEN_EQ,
        TOKEN_EQ_EQ,
        TOKEN_FALSE,
        TOKEN_FLOAT,
        TOKEN_GE,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_FN,
        TOKEN_KW_IF,
        TOKEN_KW_IN,
        TOKEN_KW_IT,
        TOKEN_KW_LOOP,
        TOKEN_KW_TAG,
        TOKEN_KW_USE,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LE,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_MINUS,
        TOKEN_NOT_EQ,
        TOKEN_NULL,
        TOKEN_OR_OR,
        TOKEN_PERCENT,
        TOKEN_PERCENT_PERCENT,
        TOKEN_PLUS,
        TOKEN_QUESTION,
        TOKEN_QUESTION_DOT,
        TOKEN_QUESTION_QUESTION,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RETURN,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SHL,
        TOKEN_SHR,
        TOKEN_SLASH,
        TOKEN_SLASH_PERCENT,
        TOKEN_STAR,
        TOKEN_STRING,
        TOKEN_TRUE,
        TOKEN_LT_GT,
        TOKEN_PIPE_GT,
        TOKEN_UNIFIED_ARROW,
        TOKEN_UNIT_NUMBER,
        StringPart,
        Token,
    ]
}

MAX_EXPRESSION_DEPTH: 256

ParsedExpr: struct {
    expr: Expr
    span: Span
}

ParsedExprFields: struct {
    fields: [ExprField]
    span: Span
}

parser_expression_precedence: fn(kind: Int) -> Int Never! {
    return if kind == {
        TOKEN_QUESTION_QUESTION -> 1
        TOKEN_DOT_DOT -> 2
        TOKEN_DOT_DOT_LT -> 2
        TOKEN_OR_OR -> 3
        TOKEN_AND_AND -> 4
        TOKEN_EQ_EQ -> 5
        TOKEN_NOT_EQ -> 5
        TOKEN_LT -> 5
        TOKEN_LE -> 5
        TOKEN_GT -> 5
        TOKEN_GE -> 5
        TOKEN_COMPARE -> 5
        TOKEN_SHL -> 10
        TOKEN_SHR -> 10
        TOKEN_PLUS -> 11
        TOKEN_MINUS -> 11
        TOKEN_STAR -> 12
        TOKEN_SLASH -> 12
        TOKEN_SLASH_PERCENT -> 12
        TOKEN_PERCENT -> 12
        TOKEN_PERCENT_PERCENT -> 12
        else -> 0
    }
}

parser_binary_operator: fn(kind: Int) -> BinOp Never! {
    if kind == {
        TOKEN_PLUS -> BinOp.Add
        TOKEN_MINUS -> BinOp.Sub
        TOKEN_STAR -> BinOp.Mul
        TOKEN_SLASH -> BinOp.Div
        TOKEN_SLASH_PERCENT -> BinOp.FloorDiv
        TOKEN_PERCENT -> BinOp.Mod
        TOKEN_PERCENT_PERCENT -> BinOp.Rem
        TOKEN_SHL -> BinOp.Shl
        TOKEN_SHR -> BinOp.Shr
        TOKEN_EQ_EQ -> BinOp.Eq
        TOKEN_NOT_EQ -> BinOp.Ne
        TOKEN_LT -> BinOp.Lt
        TOKEN_GT -> BinOp.Gt
        TOKEN_LE -> BinOp.Le
        TOKEN_GE -> BinOp.Ge
        TOKEN_COMPARE -> BinOp.Compare
        TOKEN_AND_AND -> BinOp.And
        else -> BinOp.Or
    }
}

parser_is_relational: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LT || kind == TOKEN_LE || kind == TOKEN_GT || kind == TOKEN_GE
}

parser_compare_direction: fn(kind: Int) -> Int Never! {
    return if kind == {
        TOKEN_LT -> 1
        TOKEN_LE -> 1
        TOKEN_GT -> -1
        TOKEN_GE -> -1
        else -> 0
    }
}

parser_expression_comparison_boundary: fn(kind: Int) -> Bool Never! {
    parser_is_relational(kind) || kind == TOKEN_EQ_EQ || kind == TOKEN_NOT_EQ || kind == TOKEN_COMPARE || kind == TOKEN_DOT_DOT || kind == TOKEN_DOT_DOT_LT
}

parser_expression_comparison_token: fn(kind: Int) -> Bool Never! {
    parser_is_relational(kind) || kind == TOKEN_EQ_EQ || kind == TOKEN_NOT_EQ || kind == TOKEN_COMPARE
}

// Rust `chained_eq_error`: a comparison after `==`, `!=` or `<=>`, or an
// equality after a relational chain, is fatal.
parser_report_chained_comparison: fn(state: &JetParserState) {
    span: parser_current(state).span
    parser_add_error(state, span, "comparisons can't be chained", "`a < b < c` doesn't compare all three; check each pair and join with `&&`", "write `a < b && b < c`")
}

parser_parse_expression: fn(state: &JetParserState, minimum: Int, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(state, minimum, depth, true, false)
}

parser_parse_expression_no_struct_lit: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(state, 1, depth, false, false)
}

parser_parse_expression_no_struct_lit_no_cmp: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(state, 6, depth, false, true)
}

// A dispatch arm atom stops before `|`, which separates arm alternatives.
parser_parse_expression_dispatch_atom: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    parser_parse_expression_restricted(state, 7, depth, false, true)
}

// A pipe belongs to the loosest expression at its bracket depth: that one
// reads the `|> step` lines, while the expressions inside its head and steps
// (a `?? return fallback`, an `if` arm) stop at the next `|>`. Brackets,
// blocks and string holes start a depth of their own.
parser_parse_expression_restricted: fn(state: &JetParserState, minimum: Int, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    if minimum > 1 || stop_before_comparison -> return parser_parse_operators(state, minimum, depth, allow_struct_lit, stop_before_comparison)
    level: parser_token_depth(state, state.position)
    owners: state.pipe_owner_depths.len()
    if owners > 0 && state.pipe_owner_depths[owners - 1] == level -> return parser_parse_operators(state, minimum, depth, allow_struct_lit, stop_before_comparison)
    state.pipe_owner_depths.push(level)
    left := parser_parse_operators(state, minimum, depth, allow_struct_lit, stop_before_comparison)
    if parser_current_kind(state) == TOKEN_PIPE_GT -> left = parser_parse_pipe(state, left, depth + 1, allow_struct_lit)
    _ := state.pipe_owner_depths.pop()
    left
}

// The bracket depth of token `index`; an opener and its closer sit at the
// depth outside them.
parser_token_depth: fn(state: &JetParserState, index: Int) -> Int {
    if state.token_depths.len() != state.tokens.len() {
        state.token_depths = [Int]{}
        level := 0
        loop cursor in 0..<state.tokens.len() {
            kind: state.tokens[cursor].kind
            if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE -> level -= 1
            state.token_depths.push(level)
            if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> level += 1
        }
    }
    if index < 0 || index >= state.token_depths.len() -> return 0
    state.token_depths[index]
}

// `head |> step |> step`: each step is parsed with its hidden name open, so
// every `<>` inside it (lambdas and string holes too) reads that name. A pipe
// that starts from a name reads that name in place, as the hand-named form
// writes it: its first step's `<>` is the name itself, so the head is neither
// moved nor copied. A first step that also writes the name (where an inner
// binding may hide it) keeps the hidden name. A step that never reads `<>`
// keeps `reads` at 0 for sema's E0438, whose fix needs the value's type.
parser_parse_pipe: fn(state: &JetParserState, head: ParsedExpr, depth: Int, allow_struct_lit: Bool) -> ParsedExpr {
    steps := [PipeStep]{}
    end := head.span
    loop parser_current_kind(state) == TOKEN_PIPE_GT {
        bar: parser_bump(state)
        name := pipe_value_name(bar.span.start)
        if steps.len() == 0 {
            // copy: the head keeps its name; the first step reads it as `<>`.
            if head.expr == .Ident(head_name, _, _) -> name = head_name.copy()
        }
        start: state.position
        saved_diagnostics: state.diagnostics.len()
        saved_blocks: state.block_spans.len()
        saved_else_arms: state.else_arms.len()
        step := parser_parse_pipe_step(state, name, depth, allow_struct_lit)
        if !pipe_value_is_name(name) && parser_pipe_step_writes(state, start, name) {
            parser_rewind(state, start, saved_diagnostics, saved_blocks, saved_else_arms)
            name = pipe_value_name(bar.span.start)
            step = parser_parse_pipe_step(state, name, depth, allow_struct_lit)
        }
        step_span: parser_cover(bar.span, step.value.span)
        end = step.value.span
        steps.push(PipeStep{name: name, value: step.value.expr, reads: step.reads, span: step_span})
    }
    span: parser_cover(head.span, end)
    ParsedExpr{expr: Expr.Pipe{head: head.expr, steps: steps, span: span, id: parser_node_id(state)}, span: span}
}

// One step's expression, parsed with `name` open as its `<>`, and how often
// it reads `<>`.
parser_parse_pipe_step: fn(state: &JetParserState, name: String, depth: Int, allow_struct_lit: Bool) -> (value: ParsedExpr, reads: Int) {
    // copy: the open-step stack keeps the name; the caller's step keeps it too.
    state.pipe_step_names.push(name.copy())
    state.pipe_step_reads.push(0)
    value: parser_parse_expression_restricted(state, 1, depth + 1, allow_struct_lit, false)
    reads: state.pipe_step_reads.pop() ?? 0
    _ := state.pipe_step_names.pop()
    (value: value, reads: reads)
}

// Whether the tokens from `start` to the cursor write `name` themselves, in
// code or in a string's hole.
parser_pipe_step_writes: fn(state: JetParserState, start: Int, name: String) -> Bool Never! {
    loop index in start..<state.position {
        if index >= state.tokens.len() -> break
        token: state.tokens[index]
        if token.kind == TOKEN_IDENT || token.kind == TOKEN_SELF || token.kind == TOKEN_KW_IT {
            if parser_value(state, token) == name -> return true
        } else if token.kind == TOKEN_STRING && parser_text(state, token).contains(name) {
            return true
        }
    }
    false
}

// `<>`: the value the innermost open pipe step receives.
parser_parse_pipe_value: fn(state: &JetParserState, token: Token) -> ParsedExpr {
    parser_bump(state)
    next: parser_current(state)
    if next.span.start == token.span.end && parser_pipe_value_touches(next.kind) {
        touching: Span{start: token.span.start, end: next.span.end}
        diagnostic: diagnostic_from_registry("E0439", Val(touching), "`<>` touches `{parser_text(state, next)}`", "`<>` written against another `<` or `>` reads as a different operator", "Add a space after `<>`")
        state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: Span{start: token.span.end, end: token.span.end}, new_text: " "}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
    }
    count: state.pipe_step_names.len()
    if count == 0 {
        parser_add_error_code(state, "E0437", token.span, "`<>` is outside a pipe step", "`<>` is the value a `|> step` receives from the line above; outside a step there is no such value", "Move it into a step such as `value |> f(<>)`, or write the value itself")
        return ParsedExpr{expr: Expr.Unit{span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    state.pipe_step_reads[count - 1] = state.pipe_step_reads[count - 1] + 1
    ParsedExpr{expr: Expr.Ident{name: state.pipe_step_names[count - 1], span: token.span, id: parser_node_id(state)}, span: token.span}
}

parser_pipe_value_touches: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LT || kind == TOKEN_GT || kind == TOKEN_LE || kind == TOKEN_GE || kind == TOKEN_SHL || kind == TOKEN_SHR || kind == TOKEN_COMPARE || kind == TOKEN_LT_GT
}

parser_parse_operators: fn(state: &JetParserState, minimum: Int, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    if depth > MAX_EXPRESSION_DEPTH {
        span: parser_current(state).span
        parser_add_fatal_code(state, "E1403", span, "this expression is nested too deeply", "recursive expression parsing is bounded against adversarial nesting", "reduce the nesting depth")
        return ParsedExpr{expr: Expr.Unit{span: span, id: parser_node_id(state)}, span: span}
    }

    // `&place == pattern` is a one-arm match that writes
    // into its subject (`if &slot == .Val(item) -> item.count += 1`); a `&`
    // that a pattern test does not follow is not a value. `&&` opens a take
    // mark on a receiver (parser_parse_take_mark).
    marked_subject := parser_current_kind(state) == TOKEN_AMP
    left := if {
        marked_subject -> parser_parse_marked_place(state, depth + 1, allow_struct_lit, true)
        parser_current_kind(state) == TOKEN_AND_AND -> parser_parse_take_mark(state, depth + 1, allow_struct_lit, stop_before_comparison)
        else -> {
            prefix: parser_parse_prefix(state, depth + 1, allow_struct_lit, stop_before_comparison)
            parser_parse_postfix(state, prefix, depth + 1, allow_struct_lit, false)
        }
    }
    // A non-place after `&` was reported where it was read.
    if marked_subject && !(left.expr == .Place(_, _, _, _)) -> marked_subject = false
    loop {
        operator := parser_current_kind(state)
        // `<>` only ever stands for a value, so after a value it joins
        // nothing (`a <> b`): name the operators that do, then read on.
        if operator == TOKEN_LT_GT {
            stray: parser_bump(state)
            parser_add_error(state, stray.span, "something unexpected appeared after this value, found `<>`", "after a value, an expression continues only with an operator: `==`, `!=`, `<`, `<=`, `>`, `>=`, `+`, `-`, `*`, `/`, `&&`, `||`, `??` or `|>`", "write the operator you mean, such as `!=` for not equal")
            _ := parser_parse_operators(state, minimum, depth + 1, allow_struct_lit, stop_before_comparison)
            break
        }
        precedence := parser_expression_precedence(operator)
        if precedence == 0 || precedence < minimum -> break
        if stop_before_comparison && parser_expression_comparison_boundary(operator) -> break
        operator_token: parser_bump(state)
        pattern_test: operator == TOKEN_EQ_EQ && parser_comparison_pattern_rhs_ahead(state, allow_struct_lit)
        if marked_subject && !pattern_test -> parser_report_marked_value(state, left.span)
        marked_subject = false
        if operator == TOKEN_QUESTION_QUESTION {
            fallback: parser_parse_or_fallback(state, depth + 1, allow_struct_lit, stop_before_comparison)
            fallback_span: parser_fallback_span(fallback)
            span := parser_cover(left.span, fallback_span)
            left = ParsedExpr{
                expr: Expr.OrFallback{value: left.expr.move(), fallback: fallback, is_option: false, span: span, id: parser_node_id(state)},
                span: span,
            }
            next
        }

        if pattern_test {
            // Rust `try_named_struct_pattern`: a `Point{…}` head that does
            // not read as a pattern (`Envelope{ badge: dep.Badge{ … } }`) is
            // the struct value it spells.
            named: parser_named_struct_pattern_ahead(state, allow_struct_lit)
            saved_position: state.position
            saved_diagnostics: state.diagnostics.len()
            saved_blocks: state.block_spans.len()
            saved_else_arms: state.else_arms.len()
            pattern: parser_parse_pattern(state, depth + 1, allow_struct_lit)
            if !named || !parser_error_since(state, saved_diagnostics) {
                span := parser_cover(left.span, pattern.span)
                left = ParsedExpr{expr: Expr.PatternTest{subject: left.expr.move(), pattern: pattern.pattern, span: span, id: parser_node_id(state)}, span: span}
                next
            }
            parser_rewind(state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
        }

        right := parser_parse_expression_restricted(state, precedence + 1, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(left.span, right.span)

        if operator == TOKEN_DOT_DOT || operator == TOKEN_DOT_DOT_LT {
            left = ParsedExpr{
                expr: Expr.Range{start: left.expr.move(), end: right.expr.move(), exclusive: operator == TOKEN_DOT_DOT_LT, span: span, id: parser_node_id(state)},
                span: span,
            }
            // Rust `expr_range`: one range, never chained (`1..2..3`); the
            // second `..` is left for the enclosing construct to reject.
            if parser_current_kind(state) == TOKEN_DOT_DOT || parser_current_kind(state) == TOKEN_DOT_DOT_LT -> break
            next
        }

        if parser_is_relational(operator) {
            ops := [BinOp]{parser_binary_operator(operator)}
            operands := [Expr]{left.expr, right.expr}
            direction := parser_compare_direction(operator)
            end := right.span
            loop parser_is_relational(parser_current_kind(state)) && parser_compare_direction(parser_current_kind(state)) == direction {
                next_operator := parser_current_kind(state)
                parser_bump(state)
                next_operand: parser_parse_expression_restricted(state, precedence + 1, depth + 1, allow_struct_lit, stop_before_comparison)
                ops.push(parser_binary_operator(next_operator))
                operands.push(next_operand.expr)
                end = next_operand.span
            }
            // A chain reads in one direction only.
            if parser_is_relational(parser_current_kind(state)) {
                turn: parser_current(state)
                parser_add_fatal_code(state, "E0333", turn.span, "this comparison chain changes direction", "a chain like `0 <= sev < 10` reads in one direction; mixing `<` and `>` in one chain is almost always a mistake and has no single meaning", "split it into two comparisons joined with `&&`")
            }
            // `==` and `!=` never extend a relational chain.
            if parser_current_kind(state) == TOKEN_EQ_EQ || parser_current_kind(state) == TOKEN_NOT_EQ -> parser_report_chained_comparison(state)
            chain_span := parser_cover(left.span, end)
            if {
                ops.len() > 1 -> {
                    hooks := [Bool]{}
                    hook_index := 0
                    loop hook_index < ops.len() {
                        hooks.push(false)
                        hook_index += 1
                    }
                    left = ParsedExpr{expr: Expr.CompareChain{operands: operands, ops: ops, hooks: hooks, span: chain_span, id: parser_node_id(state)}, span: chain_span}
                }
                else -> {
                    left = ParsedExpr{expr: Expr.Binary{op: parser_binary_operator(operator), left: left.expr, right: right.expr, span: chain_span, id: parser_node_id(state)}, span: chain_span}
                }
            }
            next
        }

        if operator == TOKEN_OR_OR {
            parser_check_mixed_logic(state, left)
            parser_check_mixed_logic(state, right)
        }
        // `==`, `!=` and `<=>` never chain: any comparison after one is E0003.
        if (operator == TOKEN_EQ_EQ || operator == TOKEN_NOT_EQ || operator == TOKEN_COMPARE) && parser_expression_comparison_token(parser_current_kind(state)) -> parser_report_chained_comparison(state)
        left = ParsedExpr{
            expr: Expr.Binary{op: parser_binary_operator(operator), left: left.expr.move(), right: right.expr.move(), span: span, id: parser_node_id(state)},
            span: span,
        }
        if operator_token.span.end > left.span.end -> left.span.end = operator_token.span.end
    }
    if marked_subject -> parser_report_marked_value(state, left.span)
    left
}

// The ordinary "expected a value" report, at the `&` that starts `span`.
parser_report_marked_value: fn(state: &JetParserState, span: Span) {
    parser_add_error(state, Span{start: span.start, end: span.start + 1}, "expected a value, found `&`", "a value can be a name, literal, collection, call, or parenthesized expression", "write an expression such as `x`, `42`, or `\"hello\"`")
}

// E0082 (amended 2026-09-28): an unparenthesized `&&`
// operand of `||` hides the precedence. The Safe edit inserts exactly the
// parentheses precedence already implies.
parser_check_mixed_logic: fn(state: &JetParserState, operand: ParsedExpr) {
    if operand.expr == {
        .Binary(op, _, _, _, _) -> {
            if op != BinOp.And -> return
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return
    }
    grouped: "({parser_source_text(state, operand.span)})"
    diagnostic: diagnostic_from_registry(
        "E0082",
        Val(operand.span),
        "`&&` and `||` are mixed here without parentheses",
        "`&&` binds tighter than `||`, but readers often misjudge that, so Jet asks you to show the grouping",
        "Write `{grouped}` to keep today's meaning, or regroup the conditions the way you intended",
    )
    state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: operand.span, new_text: grouped}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
}

// Rebuild the source spelling of `span` from its tokens. Whitespace between
// tokens becomes the same number of spaces, so byte offsets stay aligned.
parser_source_text: fn(state: JetParserState, span: Span) -> String Never! {
    text := ""
    cursor := span.start
    loop token in state.tokens {
        if token.span.start < span.start || token.span.end > span.end || token.span.start == token.span.end -> next
        loop cursor < token.span.start {
            text = "{text} "
            cursor += 1
        }
        text = "{text}{parser_text(state, token)}"
        cursor = token.span.end
    }
    text
}

parser_typed_literal_head_ahead: fn(state: &JetParserState) -> Bool Never! {
    first: parser_current_kind(state)
    head: state.position
    // The optional typed-literal head is
    // `T?{ body }`; the `?` sits between the head type and its body.
    if first == TOKEN_LBRACKET {
        nested := 0
        index := head + 1
        loop index < state.tokens.len() {
            kind := state.tokens[index].kind
            if kind == TOKEN_EOF -> return false
            if kind == TOKEN_LBRACKET -> nested += 1
            if kind == TOKEN_RBRACKET {
                if nested == 0 {
                    next_kind := parser_lookahead_forward(state, index + 1, 0).kind
                    if next_kind == TOKEN_QUESTION -> return parser_lookahead_forward(state, index + 1, 1).kind == TOKEN_LBRACE
                    return next_kind == TOKEN_LBRACE
                }
                nested -= 1
            }
            index += 1
        }
        return false
    }
    if first != TOKEN_IDENT && first != TOKEN_SELF -> return false
    index := head + 1
    nested := 0
    after_dot := false
    loop index < state.tokens.len() {
        kind := state.tokens[index].kind
        index += 1
        if parser_is_trivia(kind) -> next
        if kind == TOKEN_EOF || kind == TOKEN_SEMI || kind == TOKEN_RBRACE -> return false
        if {
            nested == 0 -> {
                if after_dot {
                    if kind != TOKEN_IDENT -> return false
                    after_dot = false
                    next
                }
                if kind == TOKEN_DOT {
                    after_dot = true
                    next
                }
                if kind == TOKEN_QUESTION -> return parser_lookahead_forward(state, index, 0).kind == TOKEN_LBRACE
                if kind != TOKEN_LT -> return kind == TOKEN_LBRACE
            }
            kind == TOKEN_LBRACE -> return false
        }
        if kind == TOKEN_LT -> nested += 1
        if kind == TOKEN_GT -> nested -= 1
        if kind == TOKEN_SHR -> nested -= 2
        if nested < 0 -> return false
    }
    false
}

// A typed literal head right after a comparison or `in`, whose `{` touches
// the head and whose closing `}` is followed by a body (`->` or `{`): the
// header form `if a > I32{0} -> …` that a header can't read.
parser_header_typed_literal_ahead: fn(state: &JetParserState) -> Bool Never! {
    before: parser_kind_at(state, -1)
    if !parser_expression_comparison_token(before) && before != TOKEN_KW_IN -> return false
    if !parser_typed_literal_head_ahead(state) -> return false
    // The literal's `{`: the first one outside the head's `[…]` and `<…>`.
    open := -1
    nested := 0
    index := state.position
    loop index < state.tokens.len() {
        kind: state.tokens[index].kind
        if kind == TOKEN_LBRACKET || kind == TOKEN_LT -> nested += 1
        if kind == TOKEN_RBRACKET || kind == TOKEN_GT -> nested -= 1
        if kind == TOKEN_SHR -> nested -= 2
        if kind == TOKEN_LBRACE && nested <= 0 {
            open = index
            break
        }
        index += 1
    }
    if open <= 0 || state.tokens[open - 1].span.end != state.tokens[open].span.start -> return false
    depth := 0
    index = open
    loop index < state.tokens.len() {
        kind: state.tokens[index].kind
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 {
                after: parser_lookahead_kind_forward(state, index + 1, 0)
                return after == TOKEN_UNIFIED_ARROW || after == TOKEN_LBRACE
            }
        }
        index += 1
    }
    false
}

parser_literal_fields_ahead: fn(state: &JetParserState) -> Bool Never! {
    first := parser_kind_at(state, 1)
    if first == TOKEN_RBRACE -> return true
    // `tag` names a field like any other word (`Label{tag: "ok"}`).
    if first != TOKEN_IDENT && first != TOKEN_KW_TAG -> return false
    second := parser_kind_at(state, 2)
    second == TOKEN_COLON || second == TOKEN_COMMA || second == TOKEN_SEMI || second == TOKEN_RBRACE
}

parser_literal_close_terminators: fn(state: &JetParserState) Never! {
    loop parser_current_kind(state) == TOKEN_SEMI && parser_kind_at(state, 1) == TOKEN_RBRACE -> parser_bump(state)
}

parser_typed_literal_byte_head: fn(head: Type?) -> Bool Never! {
    if head == {
        Val(ty) -> if ty == {
            .List(element) | .FixedList(element, _) -> parser_is_byte_type(element)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        None -> false
    }
}

parser_parse_typed_literal_body: fn(state: &JetParserState, head: Type?, start: Span, depth: Int) -> ParsedExpr {
    if parser_shared_cell_head(head) && parser_kind_at(state, 1) != TOKEN_RBRACE -> return parser_parse_shared_cell(state, head, start, depth)
    record_head := if head == {
        None -> true
        Val(ty) -> if ty == {
            // A constraint `Layout{…}` body holds comparisons, never
            // `field:` entries, so a user record named `Layout` stays a record.
            .Named(name) -> name != "Layout" || (parser_kind_at(state, 1) == TOKEN_IDENT && parser_kind_at(state, 2) == TOKEN_COLON)
            .Apply(_, _) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
    }
    if record_head && parser_literal_fields_ahead(state) {
        fields := parser_parse_expression_fields(state, depth + 1)
        span := parser_cover(start, fields.span)
        if head == None {
            return ParsedExpr{expr: Expr.StructLit{type_name: "", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields.fields.move(), inferred: true, span: span, id: parser_node_id(state)}, span: span}
        }
        body := if fields.fields.len() == 0 -> TypedLitBody.Empty else -> TypedLitBody.Fields{fields: fields.fields.move()}
        return ParsedExpr{expr: Expr.TypedLit{head: Val(head), body: body.move(), span: span, id: parser_node_id(state)}, span: span}
    }
    open := parser_expect(state, TOKEN_LBRACE, "`{{` to open a typed literal")
    if parser_current_kind(state) == TOKEN_RBRACE {
        close := parser_bump(state)
        span := parser_cover(start, close.span)
        return ParsedExpr{expr: Expr.TypedLit{head: head, body: TypedLitBody.Empty, span: span, id: parser_node_id(state)}, span: span}
    }
    if parser_typed_literal_byte_head(head) && (parser_current_kind(state) == TOKEN_STRING || parser_current_kind(state) == TOKEN_RAW_STRING) && parser_kind_at(state, 1) == TOKEN_RBRACE {
        text := parser_parse_string(state, depth + 1)
        parts := [ByteTextPart]{}
        interpolated := false
        if text.expr == {
            .Str(source_parts, _, _) -> loop part in source_parts {
                if part == {
                    .Lit(value) -> parts.push(ByteTextPart.Lit{text: value})
                    .Byte(value) -> parts.push(ByteTextPart.Byte{value: value})
                    .Interp(_, _) -> interpolated = true
                }
            }
            .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> interpolated = true
        }
        parser_literal_close_terminators(state)
        close := parser_expect(state, TOKEN_RBRACE, "`}}` to close a typed literal")
        span := parser_cover(start, close.span)
        body := if interpolated -> TypedLitBody.Value{value: text.expr} else -> TypedLitBody.ByteText{parts: parts}
        return ParsedExpr{expr: Expr.TypedLit{head: head, body: body, span: span, id: parser_node_id(state)}, span: span}
    }
    map_head := if head == {
        Val(ty) -> if ty == {
            .Map(_, _, _) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        None -> false
    }
    list_head := if head == {
        Val(ty) -> if ty == {
            .List(_) | .FixedList(_, _) -> true
            .Named(name) -> name == "Layout"
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        None -> false
    }
    first := parser_parse_expression(state, 1, depth + 1)
    parser_literal_close_terminators(state)
    // #3739: a map head's lone expression with no `:` stays a one-expression
    // body; sema reads it as the whole value. Every part moves into the body:
    // a copied element list costs a clone and a drop of every element tree.
    body := if {
        (map_head && parser_current_kind(state) != TOKEN_RBRACE) || (head == None && parser_current_kind(state) == TOKEN_COLON) -> {
            parser_expect(state, TOKEN_COLON, "`:` between a map key and its value")
            first_value := parser_parse_expression(state, 1, depth + 1)
            entries := [ExprPair]{ExprPair{key: first.expr.move(), value: first_value.expr.move()}}
            loop parser_current_kind(state) == TOKEN_COMMA {
                parser_bump(state)
                if parser_current_kind(state) == TOKEN_RBRACE -> break
                key := parser_parse_expression(state, 1, depth + 1)
                parser_expect(state, TOKEN_COLON, "`:` between a map key and its value")
                value := parser_parse_expression(state, 1, depth + 1)
                entries.push(ExprPair{key: key.expr.move(), value: value.expr.move()})
            }
            TypedLitBody.Entries{entries: entries.move()}
        }
        list_head || (head == None && parser_current_kind(state) == TOKEN_COMMA) -> {
            elements := [Expr]{first.expr.move()}
            loop parser_current_kind(state) == TOKEN_COMMA {
                parser_bump(state)
                if parser_current_kind(state) == TOKEN_RBRACE -> break
                element := parser_parse_expression(state, 1, depth + 1)
                elements.push(element.expr.move())
            }
            TypedLitBody.Elements{elements: elements.move()}
        }
        else -> TypedLitBody.Value{value: first.expr.move()}
    }
    parser_literal_close_terminators(state)
    close := parser_expect(state, TOKEN_RBRACE, "`}}` to close a typed literal")
    span := parser_cover(start, close.span)
    ParsedExpr{expr: Expr.TypedLit{head: head, body: body.move(), span: span, id: parser_node_id(state)}, span: span}
}

// The `{value}` default after a parameter, field or constant type. The body
// is one value of that type; an empty `T{}` is the typed literal `T{}`, the
// same empty value it is in an expression (`xs: [Int]{}` defaults to `[]`).
// The span runs from the type through the closing `}`.
parser_parse_declared_default: fn(state: &JetParserState, ty: Type, ty_span: Span, closer: String) -> ParsedExpr {
    if parser_kind_at(state, 1) == TOKEN_RBRACE {
        parser_bump(state)
        close := parser_bump(state)
        span := parser_cover(ty_span, close.span)
        return ParsedExpr{expr: Expr.TypedLit{head: Val(ty), body: TypedLitBody.Empty, span: span, id: parser_node_id(state)}, span: span}
    }
    parser_bump(state)
    parsed := parser_parse_expression(state, 1, 0)
    close := parser_expect(state, TOKEN_RBRACE, closer)
    ParsedExpr{expr: parsed.expr.move(), span: parser_cover(ty_span, close.span)}
}

parser_try_parse_typed_literal: fn(state: &JetParserState, depth: Int) -> ParsedExpr? {
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_gt := state.pending_type_gt
    saved_gt_span := state.pending_type_gt_span
    parsed := parser_parse_type(state, depth + 1)
    if state.diagnostics.len() != saved_diagnostics || parser_current_kind(state) != TOKEN_LBRACE {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := state.diagnostics.pop()
        state.pending_type_gt = saved_gt
        state.pending_type_gt_span = saved_gt_span
        return None
    }
    Val(parser_parse_typed_literal_body(state, Val(parsed.ty), parsed.span, depth + 1))
}

// A list type before `.name(`: `[Int?].filled(3, None)` or
// `[Int?#3].filled(None)`. Only a bracket whose contents can't be a list
// literal counts, one holding an optional element's `?` or a fixed length's
// `#`, so `[x].len()` stays a call on a list literal.
parser_list_type_owner_ahead: fn(state: &JetParserState) -> Bool Never! {
    nested := 0
    type_only := false
    index := state.position + 1
    loop index < state.tokens.len() {
        kind: state.tokens[index].kind
        if kind == TOKEN_EOF || kind == TOKEN_SEMI || kind == TOKEN_LBRACE || kind == TOKEN_LPAREN -> return false
        if kind == TOKEN_LBRACKET -> nested += 1
        if kind == TOKEN_RBRACKET {
            if nested == 0 {
                if !type_only || parser_lookahead_forward(state, index + 1, 0).kind != TOKEN_DOT -> return false
                return parser_lookahead_forward(state, index + 1, 1).kind == TOKEN_IDENT && parser_lookahead_forward(state, index + 1, 2).kind == TOKEN_LPAREN
            }
            nested -= 1
        }
        if kind == TOKEN_HASH || kind == TOKEN_QUESTION -> type_only = true
        index += 1
    }
    false
}

// `[T].name(args)` with the list type as the call's owner type argument.
// None, with the parser restored, when the bracket doesn't read as a type.
parser_try_parse_list_type_static: fn(state: &JetParserState, depth: Int) -> ParsedExpr? {
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_gt := state.pending_type_gt
    saved_gt_span := state.pending_type_gt_span
    parsed := parser_parse_type(state, depth + 1)
    if state.diagnostics.len() != saved_diagnostics || parser_current_kind(state) != TOKEN_DOT {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := state.diagnostics.pop()
        state.pending_type_gt = saved_gt
        state.pending_type_gt_span = saved_gt_span
        return None
    }
    parser_bump(state)
    method: parser_bump(state)
    args: parser_parse_call_args(state, depth + 1, false)
    span: parser_cover(parsed.span, parser_lookahead(state, -1).span)
    owner: Expr.Ident{name: LIST_TYPE_OWNER, span: parsed.span, id: parser_node_id(state)}
    Val(ParsedExpr{
        expr: Expr.MethodCall{receiver: owner, method: parser_value(state, method), method_span: method.span, owner_type_args: [Type]{parsed.ty}, type_args: [Type]{}, args: args, id: parser_node_id(state)},
        span: span,
    })
}

// A typed literal headed `Shared` or `Shared<T>` with a value body builds a
// shared cell. An empty body stays a typed literal, which sema refuses.
parser_shared_cell_head: fn(head: Type?) -> Bool Never! {
    if head == {
        Val(ty) -> if ty == {
            .Named(name) -> name == "Shared"
            .Shared(_) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        None -> false
    }
}

// `Shared{value}` and `Shared<T>{value}`: the cell is the `Shared.new` call
// shape every tier lowers, with `T` as its owner type argument when written.
// The cell owns its payload, so the operand moves in.
parser_parse_shared_cell: fn(state: &JetParserState, head: Type?, start: Span, depth: Int) -> ParsedExpr {
    parser_expect(state, TOKEN_LBRACE, "`{{` to open a `Shared{{…}}` cell")
    operand: parser_parse_expression(state, 1, depth + 1)
    parser_literal_close_terminators(state)
    close := parser_expect(state, TOKEN_RBRACE, "`}}` to close a `Shared{{…}}` cell")
    owner_type_args := [Type]{}
    // copy: `inner` is part of read parameter `head`; the call owns its owner type argument.
    if head == .Val(.Shared(inner)) -> owner_type_args.push(inner.copy())
    parser_shared_cell(state, operand.expr, operand.span, owner_type_args, start, parser_cover(start, close.span))
}

parser_shared_cell: fn(state: &JetParserState, operand: Expr, operand_span: Span, owner_type_args: [Type], head: Span, span: Span) -> ParsedExpr {
    flags := ast_empty_call_arg_flags()
    flags.shared_operand = true
    argument: CallArg{convention: AccessConvention.Move, expr: operand, span: operand_span, flags: flags, label: None, spread: false}
    ParsedExpr{
        expr: Expr.MethodCall{receiver: Expr.Ident{name: "Shared", span: head, id: parser_node_id(state)}, method: "new", method_span: head, owner_type_args: owner_type_args, type_args: [Type]{}, args: [CallArg]{argument}, id: parser_node_id(state)},
        span: span,
    }
}

parser_parse_prefix: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    if parser_expression_form_ahead(state, allow_struct_lit) -> return parser_parse_expression_form(state, depth + 1)
    token: parser_current(state)
    kind: token.kind
    word: if kind == TOKEN_IDENT -> parser_value(state, token) else -> ""
    if kind == TOKEN_IDENT && word == "task" && parser_task_surface_ahead(state) -> return parser_parse_task_surface(state, depth + 1)
    // `comptime { … }` in value position. The block's final
    // expression is its value, but no build-time value fold exists yet, so
    // the block is consumed and E0391 teaches the statement form.
    if allow_struct_lit && parser_prep_verb_ahead(state, 0, TOKEN_LBRACE) {
        parser_bump(state)
        block: parser_parse_block(state)
        span: parser_cover(token.span, block.span)
        parser_add_error_code(state, "E0391", span, "`comptime {{ … }}` is used as a value in a form this compiler does not support yet", "Jet makes the block's final expression its value; today only `name: comptime {{ value }}` with a single final expression is evaluated while building", "write `name: comptime {{ value }}` with one final expression, or bind the result inside a `comptime {{ … }}` statement block")
        return ParsedExpr{expr: Expr.Unit{span: span, id: parser_node_id(state)}, span: span}
    }
    if allow_struct_lit && parser_typed_literal_head_ahead(state) {
        typed: parser_try_parse_typed_literal(state, depth + 1)
        if typed == .Val(parsed) -> return parsed
    }
    // In an `if` or `loop` header `{` opens the body, so a typed literal
    // straight after a comparison or `in` can't be read there. When its
    // closing `}` is followed by the body, one diagnostic names the cause and
    // the literal is still parsed, so the body after it checks.
    if !allow_struct_lit && parser_header_typed_literal_ahead(state) {
        typed: parser_try_parse_typed_literal(state, depth + 1)
        if typed == .Val(parsed) {
            parser_add_error_code(state, "E0637", parsed.span, "the `{{` of this typed literal is read as the start of the body", "in an `if` or `loop` header, `{{` opens the body, so `a > I32{{0}}` reads as `a > I32` followed by the body `{{0}}`", "compare with a plain number, as in `if a > 0 ->`, or group the literal, as in `if a > (I32{{0}}) ->`")
            return parsed
        }
    }
    if kind == TOKEN_LT_GT -> return parser_parse_pipe_value(state, token)
    // Rust has no unary `+`: `+1` falls through to "expected a value".
    if kind == TOKEN_MINUS || kind == TOKEN_BANG {
        parser_bump(state)
        operand: parser_parse_expression_restricted(state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        op := UnOp.Not
        if kind == TOKEN_MINUS -> op = UnOp.Neg
        span := parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.Unary{op: op, operand: operand.expr, span: span, id: parser_node_id(state)}, span: span}
    }
    if kind == TOKEN_STAR {
        parser_bump(state)
        operand: parser_parse_expression_restricted(state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
        span := parser_cover(token.span, operand.span)
        return ParsedExpr{expr: Expr.RawOf{value: operand.expr, span: span, id: parser_node_id(state)}, span: span}
    }
    // Rust `primary`: `if` and `loop` in value position are always the value
    // forms (`if cond -> a else -> b`, tables, collecting or result loops).
    if kind == TOKEN_KW_IF || kind == TOKEN_KW_LOOP -> return parser_parse_expression_form(state, depth + 1)
    // This rule a=A: `.new(...)` leaves only the static receiver implicit; sema
    // fills the empty receiver name from the expected type.
    if kind == TOKEN_DOT && parser_kind_at(state, 1) == TOKEN_IDENT && parser_value_at(state, 1) == "new" {
        parser_bump(state)
        method: parser_bump(state)
        if parser_current_kind(state) != TOKEN_LPAREN -> parser_expect(state, TOKEN_LPAREN, "`(` after `.new`")
        args: if parser_current_kind(state) == TOKEN_LPAREN -> parser_parse_call_args(state, depth + 1, false) else -> [CallArg]{}
        span: parser_cover(token.span, parser_lookahead(state, -1).span)
        return ParsedExpr{
            expr: Expr.MethodCall{receiver: Expr.Ident{name: "", span: token.span, id: parser_node_id(state)}, method: "new", method_span: method.span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, id: parser_node_id(state)},
            span: span,
        }
    }
    // A lower-case `.member` is the implicit-receiver
    // member shorthand; the postfix loop reads the rest of `.member.m(x)`.
    if kind == TOKEN_DOT && parser_kind_at(state, 1) == TOKEN_IDENT {
        first_byte: parser_value_at(state, 1).bytes()[0]
        if Int.from_u8(first_byte) >= 97 && Int.from_u8(first_byte) <= 122 {
            parser_bump(state)
            member: parser_bump(state)
            // The field node is spanned at its member name, as in the
            // reference; the parsed span covers the leading `.` too.
            shorthand_span: parser_cover(token.span, member.span)
            return ParsedExpr{expr: Expr.Field{base: Expr.Ident{name: "", span: token.span, id: parser_node_id(state)}, member: parser_value(state, member), span: member.span, id: parser_node_id(state)}, span: shorthand_span}
        }
    }
    if kind == TOKEN_DOT && (parser_kind_at(state, 1) == TOKEN_IDENT || parser_kind_at(state, 1) == TOKEN_NULL) {
        parser_bump(state)
        variant: if parser_current_kind(state) == TOKEN_NULL -> parser_bump(state) else -> parser_expect_name(state, "after `.` in an enum value")
        args: parser_parse_variant_args(state, depth + 1, allow_struct_lit)
        end := variant.span
        if state.position > 0 {
            previous: parser_lookahead(state, -1)
            if previous.kind == TOKEN_RPAREN || previous.kind == TOKEN_RBRACE -> end = previous.span
        }
        span := parser_cover(token.span, end)
        return ParsedExpr{
            expr: Expr.EnumLit{type_name: "", variant: parser_value(state, variant), variant_span: Val(variant.span), args: args, leading_dot: true, span: span, id: parser_node_id(state)},
            span: span,
        }
    }
    // `#package`, `#here` and `#caller`: the site values, one name written
    // against the `#`. A marker path `#here.Name` stays a marker.
    if kind == TOKEN_HASH && parser_kind_at(state, 1) == TOKEN_IDENT && parser_site_value_ahead(state) {
        parser_bump(state)
        name_token: parser_bump(state)
        span: parser_cover(token.span, name_token.span)
        return ParsedExpr{expr: Expr.Ident{name: "#{parser_value(state, name_token)}", span: span, id: parser_node_id(state)}, span: span}
    }
    // One marker read at expression position (Rust `primary`): the marker
    // name is read first, then classified. Any name without its own value
    // meaning is a declared tag applied to the value after it.
    if kind == TOKEN_HASH && parser_kind_at(state, 1) == TOKEN_IDENT -> return parser_parse_marker_value(state, depth + 1, allow_struct_lit, stop_before_comparison)
    if kind == TOKEN_LPAREN -> return parser_parse_parenthesized(state, depth + 1)
    if kind == TOKEN_KW_FN && parser_kind_at(state, 1) == TOKEN_LPAREN -> return parser_parse_fn_lambda(state, depth + 1)
    if kind == TOKEN_LBRACKET && parser_list_type_owner_ahead(state) {
        static_call: parser_try_parse_list_type_static(state, depth + 1)
        if static_call == .Val(parsed) -> return parsed
    }
    if kind == TOKEN_LBRACKET -> return parser_parse_collection(state, depth + 1)
    if allow_struct_lit && kind == TOKEN_LBRACE {
        return parser_parse_typed_literal_body(state, None, token.span, depth + 1)
    }

    // Optional constructors keep the contextual EnumLit shape used by Rust;
    // sema supplies the payload type from the expected optional type.
    // `Val` without `(` is still an ordinary identifier.
    if kind == TOKEN_IDENT && word == "Val" && parser_kind_at(state, 1) == TOKEN_LPAREN {
        parser_bump(state)
        parser_expect(state, TOKEN_LPAREN, "after `Val`")
        inner: parser_parse_expression(state, 0, depth + 1)
        parser_expect(state, TOKEN_RPAREN, "after the value inside `Val(...)`")
        span: parser_cover(token.span, inner.span)
        return ParsedExpr{
            expr: Expr.EnumLit{type_name: "", variant: "Val", variant_span: Val(token.span), args: [EnumLitArg]{EnumLitArg.Positional{value: inner.expr}}, leading_dot: false, span: span, id: parser_node_id(state)},
            span: span,
        }
    }
    // The lexer reads `$NAME` as one identifier. Only a config surface reads
    // it as an environment read; in ordinary source, a template included, a
    // `$` word is no name.
    if kind == TOKEN_IDENT && word.starts_with("$") && !state.allow_environment_reads {
        parser_bump(state)
        parser_report_unknown_fact_root(state, word, token.span)
        return ParsedExpr{expr: Expr.Ident{name: word, span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_IDENT || kind == TOKEN_SELF || kind == TOKEN_KW_IT {
        parser_bump(state)
        return ParsedExpr{expr: Expr.Ident{name: if kind == TOKEN_IDENT -> word else -> parser_value(state, token), span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    // The `tag` keyword also spells an ordinary name (a field, a variant
    // field, a parameter), so a value reads it back as that name.
    if kind == TOKEN_KW_TAG {
        parser_bump(state)
        return ParsedExpr{expr: Expr.Ident{name: "tag", span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_TRUE || kind == TOKEN_FALSE {
        parser_bump(state)
        return ParsedExpr{expr: Expr.Bool{value: kind == TOKEN_TRUE, span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_NULL {
        parser_bump(state)
        return ParsedExpr{expr: Expr.EnumLit{type_name: "", variant: "None", variant_span: Val(token.span), args: [EnumLitArg]{}, leading_dot: false, span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_INT {
        parser_bump(state)
        value := parser_integer(state, token) ?? 0
        return ParsedExpr{expr: Expr.Int{value: value, span: token.span, width: None, raw: Val(parser_text(state, token)), id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_UNIT_NUMBER {
        parser_bump(state)
        // Rust `UnitNumber`: `raw` is the lexer's digit spelling and the
        // suffix span covers only the suffix.
        suffix: parser_suffix(state, token)
        suffix_span: Span{start: token.span.end - suffix.bytes().len(), end: token.span.end}
        return ParsedExpr{
            expr: Expr.UnitLit{raw: parser_value(state, token), int: parser_integer(state, token), float: parser_decimal(state, token), suffix: suffix, suffix_span: suffix_span, span: token.span, id: parser_node_id(state)},
            span: token.span,
        }
    }
    if kind == TOKEN_FLOAT {
        parser_bump(state)
        value := parser_decimal(state, token) ?? 0.0
        return ParsedExpr{expr: Expr.Float{value: value, span: token.span, is_f32: false, raw: Val(parser_value(state, token)), id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_CHAR {
        parser_bump(state)
        return ParsedExpr{expr: Expr.Char{value: parser_value(state, token), span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    if kind == TOKEN_STRING || kind == TOKEN_RAW_STRING -> return parser_parse_string(state, depth + 1)
    if kind == TOKEN_DOT_DOT_DOT {
        parser_bump(state)
        value: parser_parse_expression(state, 13, depth + 1)
        span := parser_cover(token.span, value.span)
        return ParsedExpr{expr: Expr.Spread{value: value.expr, span: span, id: parser_node_id(state)}, span: span}
    }

    // A hole's token stream ends at its closing `}`, which has no token text of its own.
    if kind == TOKEN_EOF && state.in_hole {
        parser_add_error(state, token.span, "expected a value before this hole's closing `}}`", "a `{{ }}` hole holds one complete value", "finish the value, for example `{{a + b}}`, or remove the hole")
        return ParsedExpr{expr: Expr.Unit{span: token.span, id: parser_node_id(state)}, span: token.span}
    }
    found: parser_text(state, token)
    parser_add_error(state, token.span, "expected a value, found `{found}`", "a value can be a name, literal, collection, call, or parenthesized expression", "write an expression such as `x`, `42`, or `\"hello\"`")
    if kind != TOKEN_EOF && kind != TOKEN_RBRACE && kind != TOKEN_RPAREN && kind != TOKEN_RBRACKET && kind != TOKEN_COMMA && kind != TOKEN_SEMI -> parser_bump(state)
    ParsedExpr{expr: Expr.Unit{span: token.span, id: parser_node_id(state)}, span: token.span}
}

// `#Name value` at expression position. `#Todo` is a typed goal; `#Meta` and
// the statement switches carry no value. Sema validates the tag.
parser_parse_marker_value: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    hash: parser_bump(state)
    first: parser_bump(state)
    name := parser_value(state, first)
    name_end := first.span.end
    loop parser_current_kind(state) == TOKEN_DOT && parser_kind_at(state, 1) == TOKEN_IDENT {
        parser_bump(state)
        segment: parser_bump(state)
        name = "{name}.{parser_value(state, segment)}"
        name_end = segment.span.end
    }
    head_span: Span{start: hash.span.start, end: name_end}
    if name == {
        "Meta" -> {
            parser_add_fatal_code(state, "E0349", head_span, "`#Meta` attaches to a binding or function", "`#Meta` is a tooling fact about a named source item; expressions do not carry it", "move `#Meta(...)` before a binding or function, or remove it")
            return ParsedExpr{expr: Expr.Unit{span: head_span, id: parser_node_id(state)}, span: head_span}
        }
        "Off" -> {
            parser_add_fatal_code(state, "E0343", head_span, "`#Off` does not produce a value", "statement switch attributes control a whole statement; expressions must still produce values in every build", "put it before the statement: `#Off <statement>` or `#Off(.Release) <statement>`")
            return ParsedExpr{expr: Expr.Unit{span: head_span, id: parser_node_id(state)}, span: head_span}
        }
        "Todo" -> return ParsedExpr{expr: Expr.Todo{span: head_span, expected_type: None, id: parser_node_id(state)}, span: head_span}
        else -> {}
    }
    // A marker with no value after it is no tag application: an unregistered
    // name applies to the expression site, where sema reports it from the shared
    // applied-rule vocabulary (E0927) like every other unknown marker.
    if !parser_starts_expression(parser_current_kind(state)) && !marker_registered(name) {
        marker: Marker{name: name, negated: false, name_span: Span{start: first.span.start, end: name_end}, args: [], arg_labels: [], span: head_span, ct: None}
        state.statement_rules.push(AppliedRuleApplication{marker: marker, target: Val(head_span), site: Val(RuleSite.Expression)})
        return ParsedExpr{expr: Expr.Unit{span: head_span, id: parser_node_id(state)}, span: head_span}
    }
    named: parser_current_kind(state) == TOKEN_IDENT
    inner := parser_parse_prefix(state, depth + 1, allow_struct_lit, stop_before_comparison)
    // Rust `expr_primary` reads a bare name's call or member call with the
    // name, so `#Checked Die.from_int(1)` tags the call's value.
    if named && inner.expr == .Ident(_, _, _) -> inner = parser_parse_postfix(state, inner, depth + 1, allow_struct_lit, true)
    span: parser_cover(head_span, inner.span)
    ParsedExpr{expr: Expr.Tainted{value: inner.expr, tag: Val(name), span: span, id: parser_node_id(state)}, span: span}
}

parser_parse_string: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    token: parser_bump(state)
    parts := [StrPart]{}
    index := 0
    token_parts: parser_string_parts(state, token)
    loop index < token_parts.len() {
        part: token_parts[index]
        if part.kind == {
            STRING_PART_TEXT -> parts.push(StrPart.Lit{text: parser_part_text(state, part)})
            STRING_PART_BYTE -> parts.push(StrPart.Byte{value: U8{part.byte}})
            STRING_PART_INTERPOLATION -> parser_parse_interpolation(state, part, depth, parts)
            else -> {}
        }
        index += 1
    }
    if token_parts.len() == 0 -> parts.push(StrPart.Lit{text: parser_value(state, token)})
    ParsedExpr{expr: Expr.Str{parts: parts, span: token.span, id: parser_node_id(state)}, span: token.span}
}

// Rust `str_expr_from_parts`: one value, an optional debug label `=`, one
// optional selector, then the end of the hole. A failure is fatal for the
// statement, as Rust returns it as `Err`; an unknown selector (E0914) is not.
parser_parse_interpolation: fn(state: &JetParserState, part: StringPart, depth: Int, parts: &[StrPart]) {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        sources: [[U8]]{},
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        statement_start: -1,
        allow_environment_reads: state.allow_environment_reads,
        derive_template_depth: state.derive_template_depth,
        // A hole inside a pipe step reads that step's `<>`.
        pipe_step_names: state.pipe_step_names.copy(),
        pipe_step_reads: state.pipe_step_reads.copy(),
        in_hole: true,
    }
    // The nested state parses with the outer tables and source; every exit
    // hands them back.
    parser_lend_hole(state, nested)
    if parser_current_kind(nested) == TOKEN_EQ {
        parser_return_hole(state, nested)
        parser_add_error(state, parser_current(nested).span, "empty debug-label interpolation `{{=}}`", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}` or `{{x + 1=}}`")
        return
    }
    value: parser_parse_expression(nested, 1, depth + 1)
    loop index in 0..<state.pipe_step_reads.len() -> state.pipe_step_reads[index] = nested.pipe_step_reads[index]
    loop block in nested.block_spans -> state.block_spans.push(block)
    if nested.diagnostics.len() > 0 {
        parser_return_hole(state, nested)
        parser_take_nested_failure(state, nested.diagnostics)
        return
    }
    label := ""
    if parser_current_kind(nested) == TOKEN_EQ {
        loop index in 0..<nested.position {
            token: nested.tokens[index].copy()
            piece: parser_debug_label_piece(nested, token)
            if piece == "" {
                found: parser_describe_token(nested, token)
                parser_return_hole(state, nested)
                parser_add_error(state, token.span, "`{{…=}}` debug labels need a simple expression, not {found}", "the label reprints the expression text before `=`", "use a name or a short expression such as `{{count=}}`")
                return
            }
            label = "{label}{piece}"
        }
        if label == "" {
            parser_return_hole(state, nested)
            parser_add_error(state, parser_current(nested).span, "empty debug-label interpolation", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}`")
            return
        }
        parser_bump(nested)
    }
    format: parser_parse_string_format(nested)
    extra: parser_current(nested)
    extra_found: parser_describe_token(nested, extra)
    parser_return_hole(state, nested)
    if nested.abort_mark != 0 {
        parser_take_nested_failure(state, nested.diagnostics)
        return
    }
    loop diagnostic in nested.diagnostics -> state.diagnostics.push(diagnostic)
    if extra.kind != TOKEN_EOF {
        parser_add_error(state, extra.span, "unexpected {extra_found} inside this interpolated `{{ }}`", "the braces hold exactly one value, optional trailing `=`, and one optional format selector", "keep one value per `{{ }}`, for example \"{{a}}\", \"{{a=}}\", or \"{{a:Unit(bare)}}\"")
        return
    }
    if label != "" {
        parts.push(StrPart.Lit{text: label})
        parts.push(StrPart.Lit{text: " = "})
    }
    parts.push(StrPart.Interp{expr: value.expr, format: format.move()})
}

// Rust's debug-label spelling of one token, or "" when the token cannot
// appear in a label.
parser_debug_label_piece: fn(state: JetParserState, token: Token) -> String Never! {
    if token.kind == {
        TOKEN_IDENT -> parser_value(state, token)
        TOKEN_INT -> "{parser_integer(state, token) ?? 0}"
        TOKEN_FLOAT -> "{parser_decimal(state, token) ?? 0.0}"
        TOKEN_DOT -> "."
        TOKEN_LPAREN -> "("
        TOKEN_RPAREN -> ")"
        TOKEN_LBRACKET -> "["
        TOKEN_RBRACKET -> "]"
        TOKEN_PLUS -> " + "
        TOKEN_MINUS -> " - "
        TOKEN_STAR -> " * "
        TOKEN_SLASH -> " / "
        TOKEN_PERCENT -> " % "
        else -> ""
    }
}

// A nested hole parser failed: its diagnostics reach the file and the
// enclosing statement stops, as Rust's `Err(first)` does.
parser_take_nested_failure: fn(state: &JetParserState, diagnostics: [Diagnostic]) {
    if parser_aborting(state) -> return
    loop diagnostic in diagnostics -> state.diagnostics.push(diagnostic.copy())
    state.abort_mark = state.diagnostics.len()
    state.abort_position = state.position
}

// The closed interpolation selector
// vocabulary. An unknown selector is E0914 and leaves the bare Display form.
// `#` is the retired selector rail, still read so fmt can rewrite it.
parser_parse_string_format: fn(state: &JetParserState) -> StrFormat {
    if parser_current_kind(state) != TOKEN_COLON && parser_current_kind(state) != TOKEN_HASH -> return StrFormat.Display
    parser_bump(state)
    if parser_current_kind(state) != TOKEN_IDENT {
        parser_expect_name(state, "after `:` in interpolation")
        return StrFormat.Display
    }
    selector: parser_bump(state)
    name: parser_value(state, selector)
    head: ":{name}"
    if name == "Debug" -> return StrFormat.Debug
    if name == "Pretty" -> return StrFormat.Pretty
    if name == "Bin" -> return StrFormat.Bin
    if name == "Oct" -> return StrFormat.Oct
    if name == "Fixed" -> return StrFormat.Fixed{digits: parser_parse_selector_argument(state, head, "decimal places")}
    if name == "Grouped" -> return StrFormat.Grouped{digits: parser_parse_selector_argument(state, head, "decimal places")}
    if name == "Sci" -> return StrFormat.Sci{digits: parser_parse_selector_argument(state, head, "decimal places")}
    if name == "Percent" -> return StrFormat.Percent{digits: parser_parse_selector_argument(state, head, "decimal places")}
    if name == "Hex" -> return StrFormat.Hex{digits: parser_parse_selector_argument(state, head, "width")}
    if name == "Pad" || name == "PadLeft" {
        parser_expect(state, TOKEN_LPAREN, "after `{head}` in interpolation")
        width: parser_parse_selector_integer(state, head, "width")
        fill := ""
        if parser_current_kind(state) == TOKEN_COMMA {
            parser_bump(state)
            fill = parser_parse_selector_fill(state, head)
        }
        parser_expect(state, TOKEN_RPAREN, "after the fill in `{head}(n, fill)`")
        if name == "Pad" -> return StrFormat.Pad{width: width, fill: fill}
        return StrFormat.PadLeft{width: width, fill: fill}
    }
    if name == "Unit" {
        parser_expect(state, TOKEN_LPAREN, "after `{head}` in interpolation")
        style: parser_expect_name(state, "inside `{head}( )`")
        format := StrFormat.Unit{format: UnitFormat.Name}
        style_name: parser_value(state, style)
        if style_name == "bare" -> format = StrFormat.Unit{format: UnitFormat.Bare}
        if style.kind == TOKEN_IDENT && style_name != "name" && style_name != "bare" {
            parser_add_error(state, style.span, "unknown unit style `{style_name}`", "`{head}` accepts `name` or `bare`", "write `{head}(name)` or `{head}(bare)`")
        }
        parser_expect(state, TOKEN_RPAREN, "after the style in `{head}( )`")
        return format
    }
    parser_add_error_code(state, "E0914", selector.span, "unknown interpolation selector `{head}`", "string interpolation supports a closed selector set — use `:Debug`, `:Pretty`, `:Fixed(n)`, `:Grouped(n)`, `:Hex(n)`, `:Pad(n[, \"fill\"])`, `:PadLeft(n[, \"fill\"])`, `:Sci(n)`, `:Percent(n)`, `:Bin`, `:Oct`, or `:Unit(name|bare)`", "write `{{value:Debug}}`, `{{value:Pretty}}`, `{{value:Fixed(2)}}`, `{{value:Grouped(2)}}`, `{{value:Hex(2)}}`, `{{value:Pad(2, \" \")}}`, `{{value:PadLeft(2, \" \")}}`, `{{value:Sci(2)}}`, `{{value:Percent(2)}}`, `{{value:Bin}}`, `{{value:Oct}}`, `{{value:Unit(name)}}` or `{{value:Unit(bare)}}`, or `{{value}}`")
    StrFormat.Display
}

// `:Fixed(n)` and the other one-integer selectors.
parser_parse_selector_argument: fn(state: &JetParserState, head: String, parameter: String) -> Int {
    parser_expect(state, TOKEN_LPAREN, "after `{head}` in interpolation")
    value: parser_parse_selector_integer(state, head, parameter)
    parser_expect(state, TOKEN_RPAREN, "after the {parameter} in `{head}(n)`")
    value
}

parser_parse_selector_integer: fn(state: &JetParserState, head: String, parameter: String) -> Int {
    token: parser_bump(state)
    if token.kind == TOKEN_INT -> return parser_integer(state, token) ?? 0
    example: if parameter == "width" -> "16" else -> "2"
    noun: if parameter == "width" -> "width" else -> "precision"
    parser_add_error(state, token.span, "expected {parameter} inside `{head}( )`", "`{head}(n)` takes one nonnegative integer literal", "write a {noun} such as `{head}({example})`")
    0
}

// The quoted fill of `:Pad(n, "fill")`: fixed text, never a second
// interpolation.
parser_parse_selector_fill: fn(state: &JetParserState, head: String) -> String {
    token: parser_bump(state)
    if token.kind == TOKEN_RAW_STRING -> return parser_value(state, token)
    if token.kind != TOKEN_STRING {
        parser_add_error(state, token.span, "expected a literal fill string inside `{head}( )`", "`{head}(n, fill)` takes a quoted fill string", "write a fill such as `{head}(8, \"0\")`")
        return ""
    }
    token_parts: parser_string_parts(state, token)
    if token_parts.len() == 0 -> return parser_value(state, token)
    fill := ""
    loop part in token_parts {
        if part.kind == STRING_PART_INTERPOLATION {
            parser_add_error(state, token.span, "padding fill inside `{head}( )` cannot interpolate", "a padding fill is fixed text, not a second interpolation", "write a quoted fill such as `{head}(8, \"0\")`")
            return ""
        }
        if part.kind == STRING_PART_TEXT -> fill = "{fill}{parser_part_text(state, part)}"
        if part.kind == STRING_PART_BYTE {
            byte_text: String.from_bytes([U8]{U8{part.byte}}) ?? ""
            fill = "{fill}{byte_text}"
        }
    }
    fill
}

parser_parse_parenthesized: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    if parser_looks_like_lambda(state) -> return parser_parse_lambda(state, depth + 1, [NamedSpan]{})
    open: parser_bump(state)
    if parser_current_kind(state) == TOKEN_RPAREN {
        close: parser_bump(state)
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.Unit{span: span, id: parser_node_id(state)}, span: span}
    }

    fields := [TupleField]{}
    first_name := ""
    if parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
        name: parser_bump(state)
        first_name = parser_value(state, name)
        parser_bump(state)
    }
    first: parser_parse_expression(state, 1, depth + 1)
    fields.push(TupleField{name: first_name, value: first.expr})
    if parser_current_kind(state) != TOKEN_COMMA {
        close: parser_expect(state, TOKEN_RPAREN, "`)` after the expression")
        span := parser_cover(open.span, close.span)
        if first_name != "" -> parser_add_error(state, span, "a tuple needs at least two named members", "a single `(name: value)` would be ambiguous with grouping — use a one-field `struct` instead", "add another member: `(x: 1, y: 2)`")
        return ParsedExpr{expr: Expr.Paren{value: first.expr, span: span, id: parser_node_id(state)}, span: span}
    }
    parser_bump(state)
    if first_name == "" -> parser_add_error(state, first.span, "expected `name:` before this tuple member", "every tuple member is written `name: value`", "write the members as `(x: 1, y: 2)`")
    // Rust `parse_tuple_lit`: every later member is `name: value` too.
    loop parser_current_kind(state) != TOKEN_RPAREN && parser_current_kind(state) != TOKEN_EOF {
        label: parser_expect_name(state, "for a tuple member name")
        parser_expect(state, TOKEN_COLON, "after each tuple member name")
        value: parser_parse_expression(state, 1, depth + 1)
        fields.push(TupleField{name: parser_value(state, label), value: value.expr})
        if parser_current_kind(state) != TOKEN_COMMA -> break
        parser_bump(state)
    }
    close: parser_expect(state, TOKEN_RPAREN, "`)` after the tuple")
    span := parser_cover(open.span, close.span)
    if fields.len() < 2 -> parser_add_error(state, span, "a tuple needs at least two named members", "a single `(name: value)` would be ambiguous with grouping — use a one-field `struct` instead", "add another member: `(x: 1, y: 2)`")
    ParsedExpr{expr: Expr.TupleLit{fields: fields, span: span, ty: None, id: parser_node_id(state)}, span: span}
}

// S46: `(` … `)` opens a lambda only when the contents have parameter shape
// and a lambda interface or arrow follows; `(a > b) ->` stays a condition.
parser_looks_like_lambda: fn(state: &JetParserState) -> Bool {
    if parser_current_kind(state) != TOKEN_LPAREN -> return false
    index := parser_next_code_index(state, state.position + 1)
    if index < 0 -> return false
    if state.tokens[index].kind == TOKEN_RPAREN -> return parser_lambda_tail_starts_at(state, index + 1)
    loop {
        if index < 0 || state.tokens[index].kind != TOKEN_IDENT -> return false
        index = parser_next_code_index(state, index + 1)
        if index < 0 -> return false
        if state.tokens[index].kind == TOKEN_COLON {
            index += 1
            type_start: index
            parens := 0
            brackets := 0
            braces := 0
            angles := 0
            loop index < state.tokens.len() {
                kind: state.tokens[index].kind
                if parens == 0 && brackets == 0 && braces == 0 && angles == 0 && (kind == TOKEN_COMMA || kind == TOKEN_RPAREN) -> break
                if {
                    kind == TOKEN_LPAREN -> parens += 1
                    kind == TOKEN_RPAREN && parens > 0 -> parens -= 1
                    kind == TOKEN_LBRACKET -> brackets += 1
                    kind == TOKEN_RBRACKET && brackets > 0 -> brackets -= 1
                    kind == TOKEN_LBRACE -> braces += 1
                    kind == TOKEN_RBRACE && braces > 0 -> braces -= 1
                    kind == TOKEN_LT -> angles += 1
                    kind == TOKEN_GT && angles > 0 -> angles -= 1
                    kind == TOKEN_SHR && angles > 0 -> angles = if angles > 2 -> angles - 2 else -> 0
                    else -> {}
                }
                index += 1
            }
            if index == type_start || index >= state.tokens.len() -> return false
        }
        kind: state.tokens[index].kind
        if kind == TOKEN_RPAREN -> return parser_lambda_tail_starts_at(state, index + 1)
        if kind != TOKEN_COMMA -> return false
        index = parser_next_code_index(state, index + 1)
    }
    false
}

// Probe retired types only to select a teaching diagnostic;
// they never become part of the lambda's interface.
parser_lambda_tail_starts_at: fn(state: &JetParserState, index: Int) -> Bool {
    saved_position: state.position
    saved_diagnostics: state.diagnostics.len()
    saved_blocks: state.block_spans.len()
    saved_else_arms: state.else_arms.len()
    saved_type_gt: state.pending_type_gt
    saved_type_gt_span: Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.end}
    saved_semicolon: state.explicit_semicolon_reported
    state.position = index
    state.pending_type_gt = false
    if !parser_func_effect_starts_here(state) && !parser_at_unified_arrow(state) && (parser_type_starts_here(state) || parser_current_kind(state) == TOKEN_BANG) -> _ := parser_parse_type(state, 0)
    effects: parser_parse_opt_func_effects(state)
    failed: parser_aborting(state) && state.abort_mark > saved_diagnostics
    starts: !failed && (effects.effects != None || effects.via != None || parser_at_unified_arrow(state))
    parser_rewind(state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    state.pending_type_gt = saved_type_gt
    state.pending_type_gt_span = saved_type_gt_span
    state.explicit_semicolon_reported = saved_semicolon
    starts
}

parser_lambda_interface_error: fn(state: &JetParserState, span: Span) {
    parser_add_fatal_code(state, "E0399", span, "a lambda cannot write a return or error type", "a lambda's arrow introduces its body; return and error types come from the expected callable type", "remove the type; pass the lambda to a typed parameter or slot, or use a named `fn` for a full interface")
}

parser_parse_lambda: fn(state: &JetParserState, depth: Int, take_names: [NamedSpan]) -> ParsedExpr {
    open: parser_expect(state, TOKEN_LPAREN, "`(` before lambda parameters")
    params: parser_parse_lambda_params(state, depth)
    close: parser_expect(state, TOKEN_RPAREN, "`)` after lambda parameters")
    if !parser_func_effect_starts_here(state) && !parser_at_unified_arrow(state) {
        interface_span: parser_current(state).span
        parser_lambda_interface_error(state, interface_span)
    }
    effects: parser_parse_opt_func_effects(state)
    if effects.via == .Val(via) {
        parser_add_fatal_code(state, "E0119", via.span, "a lambda effect row cannot publish `via`", "a lambda stores a concrete effect row as part of its callable interface", "write the effects directly, for example `-[Net]>`")
    }
    if effects.effects == None -> parser_expect_unified_arrow(state, "after the lambda interface")
    body: parser_parse_lambda_arrow_body(state, depth, close.span.end)
    span := Span{start: open.span.start, end: body.end}
    lambda := Lambda{
        take_names: take_names,
        params: params,
        effects: effects.effects,
        body: body.body,
        span: span,
        meta: ast_empty_lambda_meta(),
    }
    ParsedExpr{expr: Expr.Lambda{lambda: lambda, id: parser_node_id(state)}, span: span}
}

// The parameters after a lambda's `(`, up to (not including) its `)`: each a
// name with an optional `: Type`.
parser_parse_lambda_params: fn(state: &JetParserState, depth: Int) -> [LambdaParam] {
    params := [LambdaParam]{}
    if parser_current_kind(state) == TOKEN_RPAREN -> return params
    loop !parser_aborting(state) {
        name: parser_expect_name(state, "as a lambda parameter")
        ty := Type?{None}
        ty_span := Span?{None}
        convention := AccessConvention.Read
        if parser_current_kind(state) == TOKEN_COLON {
            parser_bump(state)
            // A written type may mark a written `&` or taken `&&` input, as a
            // function type's parameter does: `(buf: &[Int]) -> …`.
            mark_kind: parser_current_kind(state)
            if mark_kind == TOKEN_AMP || mark_kind == TOKEN_AND_AND {
                parser_bump(state)
                convention = if mark_kind == TOKEN_AMP -> AccessConvention.Write else -> AccessConvention.Move
            }
            parsed: parser_parse_type(state, depth + 1)
            ty = Val(parsed.ty)
            ty_span = Val(parsed.span)
        }
        params.push(LambdaParam{name: parser_value(state, name), name_span: name.span, ty: ty, ty_span: ty_span, convention: convention})
        if parser_current_kind(state) == TOKEN_RPAREN -> break
        parser_expect(state, TOKEN_COMMA, "`,` between lambda parameters")
        if parser_current_kind(state) == TOKEN_RPAREN -> break
    }
    params
}

// A lambda is a function binding's value without its name,
// `fn(n) { n > 2 }` or `fn(n: Int) -> Int { n * n }`. The interface after the
// parameters is a named function's (`-> T`, `-[E]>`, `-[E]> T`, `E!`), and any
// part of it, parameter types included, may be left out where the expected
// callable type fixes it. The body is always braced; its last value is the
// result.
parser_parse_fn_lambda: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    keyword: parser_bump(state)
    parser_expect(state, TOKEN_LPAREN, "`(` before lambda parameters")
    params: parser_parse_lambda_params(state, depth)
    parser_expect(state, TOKEN_RPAREN, "`)` after lambda parameters")
    signature: parser_parse_callable_result(state)
    effects := signature.effects
    via := signature.via
    // A unit-fallible contract comes before its effect row (`IOError! -[IO]>`).
    if effects == None && via == None && !signature.plain_arrow && parser_func_effect_starts_here(state) {
        after: parser_parse_opt_func_effects(state)
        effects = after.effects
        via = after.via
    }
    if via == .Val(written) {
        parser_add_fatal_code(state, "E0119", written.span, "a lambda effect row cannot publish `via`", "a lambda stores a concrete effect row as part of its callable interface", "write the effects directly, for example `-[Net]>`")
    }
    if parser_current_kind(state) != TOKEN_LBRACE {
        missing: parser_expect(state, TOKEN_LBRACE, "`{{` to open the lambda body")
        return ParsedExpr{expr: Expr.Unit{span: missing.span, id: parser_node_id(state)}, span: parser_cover(keyword.span, missing.span)}
    }
    block: parser_parse_callable_body(state, true)
    span := Span{start: keyword.span.start, end: block.span.end}
    lambda := Lambda{
        take_names: [NamedSpan]{},
        params: params,
        effects: effects,
        body: LambdaBody.Block{body: block.statements},
        span: span,
        meta: ast_empty_lambda_meta(),
        result: signature.return_type,
    }
    ParsedExpr{expr: Expr.Lambda{lambda: lambda, id: parser_node_id(state)}, span: span}
}

ParsedLambdaBody: struct {
    body: LambdaBody
    end: Int
}

// S46: the body after a lambda's arrow, `-> expr` or `-> {{ … }}`. A single
// assignment needs no braces: `a -> a.balance -= n` is the one-statement form
// of `a -> {{ a.balance -= n }}`. `fallback_end` bounds the lambda's span.
parser_parse_lambda_arrow_body: fn(state: &JetParserState, depth: Int, fallback_end: Int) -> ParsedLambdaBody {
    if parser_current_kind(state) == TOKEN_LBRACE {
        // A block lambda keeps one unadorned final value.
        block: parser_parse_callable_body(state, true)
        return ParsedLambdaBody{body: LambdaBody.Block{body: block.statements}, end: block.span.end}
    }
    body_start: parser_current(state)
    typed_body: body_start.kind == TOKEN_IDENT && parser_pascal_name(parser_value(state, body_start))
    struct_body: typed_body && parser_kind_at(state, 1) == TOKEN_LBRACE
    error_suffix: parser_kind_at(state, 1) == TOKEN_IDENT && parser_kind_at(state, 2) == TOKEN_BANG
    if typed_body && (parser_kind_at(state, 1) == TOKEN_BANG || error_suffix) -> parser_lambda_interface_error(state, body_start.span)
    saved_diagnostics: state.diagnostics.len()
    body_start_position: state.position
    // An arrow body owns its own pipe: `line -> line |> f(<>)`.
    state.pipe_owner_depths.push(-1)
    value: parser_parse_expression(state, 1, depth + 1)
    _ := state.pipe_owner_depths.pop()
    if struct_body && parser_aborting(state) && state.abort_mark > saved_diagnostics {
        loop state.diagnostics.len() > saved_diagnostics -> _ := state.diagnostics.pop()
        state.abort_mark = 0
        // `Type { statements }` is a return type before a block body: resume
        // statement recovery at the type so it skips the whole braced body.
        state.position = body_start_position
        parser_lambda_interface_error(state, body_start.span)
    }
    if parser_is_assignment_operator(parser_current_kind(state)) {
        operator: parser_bump(state)
        right: parser_parse_expression(state, 1, depth + 1)
        target: parser_expression_lvalue(state, value.expr, value.span, operator)
        end: if right.span.end > fallback_end -> right.span.end else -> fallback_end
        return ParsedLambdaBody{body: LambdaBody.Block{body: [Stmt]{Stmt.Assign{target: target.move(), op: parser_assignment_binop(operator.kind), op_span: operator.span, value: right.expr}}}, end: end}
    }
    end: if value.span.end > fallback_end -> value.span.end else -> fallback_end
    ParsedLambdaBody{body: LambdaBody.Expr{value: value.expr}, end: end}
}

// After `.`, `[a, b, c]` lists member names that hang off the
// prefix; S84 package names may be dashed (`util-linux`). Anything else in
// the list is E0961, skipped to the next `,` or `]`.
parser_parse_member_spread: fn(state: &JetParserState, base: ParsedExpr) -> ParsedExpr {
    parser_bump(state)
    members := [ExprMember]{}
    if parser_current_kind(state) != TOKEN_RBRACKET {
        loop {
            if parser_current_kind(state) == TOKEN_IDENT {
                first: parser_bump(state)
                name := parser_value(state, first)
                end := first.span.end
                loop parser_current_kind(state) == TOKEN_MINUS && parser_current(state).span.start == end && parser_kind_at(state, 1) == TOKEN_IDENT && parser_lookahead(state, 1).span.start == end + 1 {
                    parser_bump(state)
                    segment: parser_bump(state)
                    name = "{name}-{parser_value(state, segment)}"
                    end = segment.span.end
                }
                if parser_current_kind(state) == TOKEN_COMMA || parser_current_kind(state) == TOKEN_RBRACKET {
                    members.push(ExprMember{name: name, span: Span{start: first.span.start, end: end}})
                } else {
                    parser_report_member_spread_entry(state)
                }
            } else {
                parser_report_member_spread_entry(state)
            }
            if parser_current_kind(state) != TOKEN_COMMA -> break
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RBRACKET -> break
        }
    }
    close: parser_expect(state, TOKEN_RBRACKET, "`]` to close a member spread `.[…]`")
    span: parser_cover(base.span, close.span)
    ParsedExpr{expr: Expr.MemberSpread{base: base.expr, members: members.move(), span: span, id: parser_node_id(state)}, span: span}
}

parser_report_member_spread_entry: fn(state: &JetParserState) {
    bad: parser_current(state).span
    parser_add_error_code(state, "E0961", bad, "`.[ ]` lists member names, not calls or expressions", "member spread names fields or package names that hang off the prefix", "write bare names like `default.[cargo, ripgrep]`")
    loop parser_current_kind(state) != TOKEN_COMMA && parser_current_kind(state) != TOKEN_RBRACKET && parser_current_kind(state) != TOKEN_EOF -> parser_bump(state)
}

// Rust `Syntax::INTERNAL_TASK_*`: NUL-led compiler-private names the `task`
// sugar lowers into, so no source name can collide with them.
parser_task_internal: fn(name: String) -> String Never! {
    nul: String.from_bytes([U8]{U8{0}}) ?? ""
    "{nul}jet.{name}"
}

parser_task_call: fn(state: &JetParserState, head: Span, method: String, method_span: Span, argument: Expr, argument_span: Span) -> Expr Never! {
    receiver: Expr.Ident{name: parser_task_internal("task"), span: head, id: parser_node_id(state)}
    Expr.MethodCall{receiver: receiver, method: parser_task_internal(method), method_span: method_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: argument, span: argument_span, flags: ast_empty_call_arg_flags(), label: None, spread: false}}, id: parser_node_id(state)}
}

parser_task_spawn: fn(state: &JetParserState, head: Span, take_names: [NamedSpan], body: LambdaBody, body_span: Span) -> Expr Never! {
    lambda: Lambda{take_names: take_names, params: [LambdaParam]{}, effects: None, body: body, span: body_span, meta: ast_empty_lambda_meta()}
    body_lambda: Expr.Lambda{lambda: lambda, id: parser_node_id(state)}
    parser_task_call(state, head, "task.spawn", head, body_lambda, body_span)
}

// Only the complete `task` surface spawns: `task {`, `task &&name`, a
// `task.all/race/any/group/timeout` selector, or an atom or control operand.
// Followed by `(`, `[`, another `.`, or an operator, `task` is an ordinary name.
parser_task_surface_ahead: fn(state: &JetParserState) -> Bool Never! {
    next: parser_kind_at(state, 1)
    if next == TOKEN_LBRACE -> return true
    // `task &&name` takes a name written right after the mark; `task && ok`
    // stays a boolean operand.
    if next == TOKEN_AND_AND {
        mark: parser_lookahead(state, 1)
        taken: parser_lookahead(state, 2)
        return taken.kind == TOKEN_IDENT && mark.span.end == taken.span.start
    }
    if next == TOKEN_DOT {
        selector: parser_lookahead(state, 2)
        if selector.kind != TOKEN_IDENT -> return false
        name: parser_value(state, selector)
        return name == "all" || name == "race" || name == "any" || name == "group" || name == "timeout"
    }
    if next == TOKEN_LPAREN || next == TOKEN_LBRACKET || next == TOKEN_MINUS || next == TOKEN_BANG || next == TOKEN_STAR || next == TOKEN_AMP -> return false
    parser_starts_expression(next)
}

// One `task` word owns single-task
// spawn (`task { … }`, `task name.move() { … }`, `task value`), `task.timeout(d)`
// and the `all`/`race`/`any` combinators. Named `task.all` branches build a
// tuple, positional ones a list; mixing the two is E1117.
parser_parse_task_surface: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    head: parser_bump(state).span
    if parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        selector: parser_expect_name(state, "after `task.`")
        name: parser_value(state, selector)
        if name == "group" {
            parser_add_error(state, selector.span, "`task.group` is a statement, not a value", "a task group owns a block and its children until the closing brace", "write `task.group name {{ … }}`")
            return ParsedExpr{expr: Expr.Unit{span: head, id: parser_node_id(state)}, span: head}
        }
        if name == "timeout" {
            parser_expect(state, TOKEN_LPAREN, "after `task.timeout`")
            argument: parser_parse_expression(state, 1, depth + 1)
            close: parser_expect(state, TOKEN_RPAREN, "to finish `task.timeout`")
            span: parser_cover(head, close.span)
            return ParsedExpr{expr: parser_task_call(state, head, "task.timeout", selector.span, argument.expr, argument.span), span: span}
        }
        open: parser_expect(state, TOKEN_LBRACE, "after the task selector")
        named := [TupleField]{}
        positional := [Expr]{}
        saw_named := false
        saw_positional := false
        mixed := Span?{None}
        if parser_current_kind(state) != TOKEN_RBRACE {
            loop !parser_aborting(state) {
                label := ""
                style_span := parser_current(state).span
                if name == "all" && parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
                    label_token: parser_bump(state)
                    parser_bump(state)
                    label = parser_value(state, label_token)
                    style_span = label_token.span
                    saw_named = true
                } else {
                    saw_positional = true
                }
                if saw_named && saw_positional && mixed == None -> mixed = Val(style_span)
                spawn := Expr.Unit{span: style_span, id: parser_node_id(state)}
                if parser_current_kind(state) == TOKEN_LBRACE {
                    block: parser_parse_block(state)
                    spawn = parser_task_spawn(state, head, [NamedSpan]{}, LambdaBody.Block{body: block.statements}, block.span)
                } else {
                    value: parser_parse_expression(state, 1, depth + 1)
                    spawn = parser_task_spawn(state, head, [NamedSpan]{}, LambdaBody.Expr{value: value.expr}, value.span)
                }
                if label.len() > 0 {
                    named.push(TupleField{name: label, value: spawn})
                } else {
                    positional.push(spawn)
                }
                parser_skip_semicolons(state)
                if parser_current_kind(state) == TOKEN_RBRACE -> break
                parser_expect(state, TOKEN_COMMA, "between task branches")
                if parser_current_kind(state) == TOKEN_RBRACE -> break
            }
        }
        close: parser_expect(state, TOKEN_RBRACE, "to close the task combinator")
        list_span: parser_cover(open.span, close.span)
        if mixed == .Val(mixed_span) {
            parser_add_fatal_code(state, "E1117", mixed_span, "`task.all` branches must all be named or all positional.", "Jet gives named results stable record fields and keeps positional results as ordered lists; mixing the two shapes would make the result type ambiguous.", "Use `task.all {{ first: work(), second: other() }}`, or remove every branch label.")
        }
        argument: if saw_named -> Expr.TupleLit{fields: named, span: list_span, ty: None, id: parser_node_id(state)} else -> Expr.ListLit{elements: positional, span: list_span, id: parser_node_id(state)}
        span: parser_cover(head, close.span)
        return ParsedExpr{expr: parser_task_call(state, head, "task.{name}", selector.span, argument, list_span), span: span}
    }
    // `task &&name { … }` consumes one enclosing binding.
    take_names := [NamedSpan]{}
    if parser_current_kind(state) == TOKEN_AND_AND {
        mark: parser_bump(state)
        mark_text: parser_text(state, mark)
        taken: parser_expect_name(state, "after the task capture `{mark_text}`")
        take_names.push(NamedSpan{name: parser_value(state, taken), span: parser_cover(mark.span, taken.span)})
    }
    if parser_current_kind(state) != TOKEN_LBRACE {
        value: parser_parse_expression(state, 1, depth + 1)
        span: parser_cover(head, value.span)
        return ParsedExpr{expr: parser_task_spawn(state, head, take_names, LambdaBody.Expr{value: value.expr}, value.span), span: span.move()}
    }
    // A brace body holding one tail expression folds into an expression
    // body, so every tier sees one task-value shape. A lone finite loop
    // (`loop i in 0..<n { … }`) stays a statement body: as an expression it
    // would be a value loop owing a `break value`.
    saved_position: state.position
    saved_diagnostics: state.diagnostics.len()
    saved_blocks: state.block_spans.len()
    saved_else_arms: state.else_arms.len()
    open: parser_bump(state)
    tail: parser_parse_expression(state, 1, depth + 1)
    if parser_current_kind(state) == TOKEN_SEMI && parser_kind_at(state, 1) == TOKEN_RBRACE -> parser_bump(state)
    if parser_current_kind(state) == TOKEN_RBRACE && !parser_error_since(state, saved_diagnostics) && !parser_task_tail_is_finite_loop(tail.expr) {
        close: parser_bump(state)
        body_span: parser_cover(open.span, close.span)
        return ParsedExpr{expr: parser_task_spawn(state, head, take_names, LambdaBody.Expr{value: tail.expr}, body_span), span: parser_cover(head, close.span)}
    }
    parser_rewind(state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    block: parser_parse_block(state)
    ParsedExpr{expr: parser_task_spawn(state, head, take_names, LambdaBody.Block{body: block.statements}, block.span), span: parser_cover(head, block.span)}
}

parser_task_tail_is_finite_loop: fn(tail: Expr) -> Bool Never! {
    if tail == .CallValue(callee, _, _, _) {
        if callee == .Lambda(lambda, _) -> return lambda.meta.result_loop && lambda.meta.requires_exhaustion_route
    }
    false
}

parser_parse_collection: fn(state: &JetParserState, depth: Int) -> ParsedExpr {
    open: parser_bump(state)
    if parser_current_kind(state) == TOKEN_RBRACKET {
        close: parser_bump(state)
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.ListLit{elements: [Expr]{}, span: span, id: parser_node_id(state)}, span: span}
    }
    // Rust `list_or_map_lit`: the first element decides list or map; the
    // retired `[:]` is an ordinary missing-value error at the `:`.
    first: parser_parse_expression(state, 1, depth + 1)
    if parser_current_kind(state) == TOKEN_COLON {
        parser_bump(state)
        first_value: parser_parse_expression(state, 1, depth + 1)
        entries := [ExprPair]{ExprPair{key: first.expr, value: first_value.expr}}
        loop parser_current_kind(state) == TOKEN_COMMA {
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RBRACKET -> break
            key: parser_parse_expression(state, 1, depth + 1)
            parser_expect(state, TOKEN_COLON, "`:` between a map key and its value")
            value: parser_parse_expression(state, 1, depth + 1)
            entries.push(ExprPair{key: key.expr, value: value.expr})
        }
        if parser_current_kind(state) != TOKEN_RBRACKET && parser_unclosed_delimiter(state, "map") {
            cut_span: parser_cover(open.span, parser_lookahead(state, -1).span)
            return ParsedExpr{expr: Expr.MapLit{entries: entries, span: cut_span, id: parser_node_id(state)}, span: cut_span}
        }
        close: parser_expect(state, TOKEN_RBRACKET, "`]` to close the map literal")
        span := parser_cover(open.span, close.span)
        return ParsedExpr{expr: Expr.MapLit{entries: entries, span: span, id: parser_node_id(state)}, span: span}
    }
    values := [Expr]{first.expr}
    loop parser_current_kind(state) == TOKEN_COMMA {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_RBRACKET -> break
        values.push(parser_parse_expression(state, 1, depth + 1).expr)
    }
    if parser_current_kind(state) != TOKEN_RBRACKET && parser_unclosed_delimiter(state, "list") {
        cut_span: parser_cover(open.span, parser_lookahead(state, -1).span)
        return ParsedExpr{expr: Expr.ListLit{elements: values, span: cut_span, id: parser_node_id(state)}, span: cut_span}
    }
    close: parser_expect(state, TOKEN_RBRACKET, "`]` to close the list literal")
    span := parser_cover(open.span, close.span)
    ParsedExpr{expr: Expr.ListLit{elements: values, span: span, id: parser_node_id(state)}, span: span}
}

// The dotted name an `Ident(.Ident)*` chain spells, or "" for any other shape.
parser_literal_head_path: fn(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _, _) -> name
        .Field(base, member, _, _) -> {
            prefix: parser_literal_head_path(base)
            if prefix == "" -> "" else -> "{prefix}.{member}"
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
}

// Rust `is_adjacent_call_result`: a call result (through parentheses) that a
// following `(` would invoke with the retired adjacent-call spelling.
parser_is_adjacent_call_result: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> parser_is_adjacent_call_result(inner)
        .Call(_, _) | .CallValue(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The subject `x` of a bare `x.reflect()` call.
parser_reflect_subject: fn(expr: Expr) -> Expr? Never! {
    if expr == {
        .MethodCall(receiver, method, _, owner_type_args, type_args, args, _) -> if method == "reflect" && owner_type_args.len() == 0 && type_args.len() == 0 && args.len() == 0 -> Val(receiver.copy()) else -> None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> None
    }
}

parser_parse_postfix: fn(state: &JetParserState, initial: &&ParsedExpr, depth: Int, allow_struct_lit: Bool, primary_tail: Bool) -> ParsedExpr {
    expression := initial.move()
    // Rust `expr_primary`: a capitalized name's own `<…>` (`Pool<T>.new()`)
    // and call-site arguments (`decode<Order>(raw)`).
    owner_type_args := [Type]{}
    call_type_args := [Type]{}
    // `primary_tail` reads only what Rust `expr_primary` read after a bare
    // name: one call (`name(…)`), or one member with its call
    // (`name.member(…)`), with their `<…>` lists and a literal head.
    tail_member := false
    tail_done := false
    loop {
        kind: parser_current_kind(state)
        if primary_tail {
            if tail_done -> break
            if kind == TOKEN_LBRACKET || kind == TOKEN_QUESTION || kind == TOKEN_QUESTION_DOT -> break
            if tail_member && kind != TOKEN_LPAREN && kind != TOKEN_LT && kind != TOKEN_LBRACE -> break
        }
        // `Box<>{…}` / `id<>(…)`: an empty type-argument list, refused as
        // in a type and read on without it.
        if kind == TOKEN_LT_GT && parser_current(state).span.start == expression.span.end {
            written: if expression.expr == {
                .Ident(name, _, _) -> name
                .Field(_, member, _, _) -> member
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
            }
            if written != "" {
                empty: parser_bump(state)
                diagnostic: diagnostic_from_registry("E0440", Val(empty.span), "`{written}<>` has an empty type-argument list", "A type's arguments go between `<` and `>`; `<>` lists none, so it only adds noise", "Write the type arguments, such as `{written}<Int>`, or drop the `<>`")
                state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: empty.span, new_text: ""}))
                // A typed literal's head refuses with a diagnostic, so the
                // literal is read here, as `Box{…}` would be.
                if expression.expr == .Ident(_, _, _) && allow_struct_lit && parser_current_kind(state) == TOKEN_LBRACE {
                    expression = parser_parse_typed_literal_body(state, Val(foundation_named_type(written)), expression.span, depth + 1)
                    tail_done = true
                }
                next
            }
        }
        if kind == TOKEN_LT {
            // Rust `ptr_from_addr`: `alias.Ptr<T>.from_addr(addr)` reads its
            // `<…>` as the element type, not a comparison.
            if expression.expr == .Field(base, member, _, _) && member == "Ptr" {
                if base == .Ident(alias, alias_span, _) {
                    expression = parser_parse_ptr_from_addr(state, alias, alias_span, depth)
                    next
                }
            }
            literal_name: if expression.expr == {
                .Ident(name, _, _) -> name
                .Field(_, member, _, _) -> if parser_turbofish_ahead(state, TOKEN_LBRACE) -> member else -> ""
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
            }
            // An adjacent `Owner<T>.` names a generic owner even where a
            // struct literal can't start (`if Tally<Int>.new() == {`).
            if owner_type_args.len() == 0 && parser_pascal_name(literal_name) && (allow_struct_lit || parser_turbofish_ahead(state, TOKEN_DOT)) {
                owner_type_args = parser_parse_call_type_args(state, depth + 1)
                next
            }
            callee: if expression.expr == {
                .Ident(_, _, _) | .Field(_, _, _, _) -> true
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            }
            if callee && call_type_args.len() == 0 && parser_turbofish_ahead(state, TOKEN_LPAREN) {
                call_type_args = parser_parse_call_type_args(state, depth + 1)
                next
            }
            break
        }
        if kind == TOKEN_LPAREN {
            // (E-CALL-VALUE): a returned call result is
            // invoked with `.call(…)`, never `f()(…)`.
            if parser_is_adjacent_call_result(expression.expr) {
                open: parser_current(state).span
                parser_add_fatal_code_structured_edit(state, "E-CALL-VALUE", open, "a function value is invoked with an adjacent call `)(`", "named functions and direct field, index, or lambda calls keep their spelling; a returned call result uses `.call(…)` so the value and invocation stay explicit", "write `callee.call(…)`", TextEdit{span: Span{start: open.start, end: open.start}, new_text: ".call"})
                break
            }
            paren_start: parser_current(state).span.start
            method_name: if expression.expr == {
                .Field(_, method, _, _) -> method
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
            }
            args := [CallArg]{}
            if {
                method_name == "take_pattern" -> {
                    parser_bump(state)
                    pattern: parser_parse_take_pattern_literal(state, depth + 1)
                    args.push(CallArg{convention: AccessConvention.Read, expr: pattern.expr, span: pattern.span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
                    parser_expect(state, TOKEN_RPAREN, "`)` after the take_pattern literal")
                }
                else -> {
                    args = parser_parse_call_args(state, depth + 1, false)
                }
            }
            generated_block: parser_parse_generate_template_arg(state, method_name, args)
            // Code arguments are `() -> { … }` lambdas inside
            // the parentheses; a bare `{ }` after a direct call is E0335.
            optional_call: if expression.expr == {
                .OptField(_, _, _, _, _, _) -> true
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            }
            if allow_struct_lit && !optional_call && !generated_block && parser_current_kind(state) == TOKEN_LBRACE {
                callee_text := "callee"
                if expression.expr == .Ident(_, _, _) {
                    callee_text = parser_source_slice(state, expression.span.start, paren_start)
                } else if expression.expr == .Field(_, _, _, _) {
                    callee_text = parser_source_slice(state, expression.span.start, paren_start)
                }
                brace_span: parser_current(state).span
                parser_add_fatal_code(state, "E0335", brace_span, "trailing blocks are gone — pass code with `() ->`", "a bare `{{ }}` after a call used to fill one last zero-parameter function argument; that sugar is retired", "write `{callee_text}(…, () -> {{ … }})` — put the block inside the parentheses as `() -> {{ … }}`")
                break
            }
            close_span: parser_current(state)
            end := close_span.span
            if state.position > 0 -> end = parser_lookahead(state, -1).span
            span := parser_cover(expression.span, end)
            if expression.expr == {
                .Ident(name, name_span, _) -> {
                    type_args: if call_type_args.len() > 0 -> call_type_args else -> owner_type_args
                    call := Call{name: name, name_span: name_span, type_args: type_args, args: args}
                    expression = ParsedExpr{expr: Expr.Call{call: call, id: parser_node_id(state)}, span: span}
                }
                .Field(receiver, method, field_span, _) -> {
                    // A method call is spanned at its method name, the
                    // field path's trailing bytes; `span` covers the call.
                    method_span: Span{start: field_span.end - method.count_bytes(), end: field_span.end}
                    expression = ParsedExpr{
                        expr: Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: call_type_args, args: args, id: parser_node_id(state)},
                        span: span,
                    }
                }
                .OptField(receiver, method, method_span, _, _, _) -> {
                    expression = ParsedExpr{
                        expr: Expr.OptMethodCall{receiver: receiver, method: method, method_span: method_span, type_args: [Type]{}, args: args, span: span, id: parser_node_id(state)},
                        span: span,
                    }
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expression = ParsedExpr{expr: Expr.CallValue{callee: expression.expr, args: args.move(), span: span, id: parser_node_id(state)}, span: span}
            }
            owner_type_args = [Type]{}
            call_type_args = [Type]{}
            tail_done = true
            next
        }
        // A bare `{ }` after a field chain is a struct literal only on an
        // `alias.Type` head; after any other field or an index it is E0335.
        if kind == TOKEN_LBRACE && allow_struct_lit {
            alias := ""
            type_name := ""
            bad_block := false
            if expression.expr == {
                .Field(base, member, _, _) -> {
                    if base == {
                        .Ident(name, _, _) -> {
                            alias = name
                            type_name = member
                        }
                        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> bad_block = true
                    }
                }
                .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) -> bad_block = true
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            if bad_block {
                bad_span: parser_current(state).span
                parser_add_fatal_code(state, "E0335", bad_span, "trailing blocks are only valid on direct calls", "a bare `{{ }}` here is not a call argument; code arguments use `() -> {{ … }}` inside a call's parentheses", "write `callee(() -> {{ … }})` on a call")
                break
            }
            if alias.len() == 0 -> break
            parsed: parser_parse_expression_fields(state, depth + 1)
            span := parser_cover(expression.span, parsed.span)
            first_byte: Int.from_u8(alias.bytes()[0])
            upper: first_byte >= 65 && first_byte <= 90
            literal: if upper -> Expr.StructLit{type_name: "{alias}.{type_name}", type_args: owner_type_args, import_ns: None, as_trait: None, fields: parsed.fields, inferred: false, span: span, id: parser_node_id(state)} else -> Expr.StructLit{type_name: type_name, type_args: owner_type_args, import_ns: Val(alias), as_trait: None, fields: parsed.fields, inferred: false, span: span, id: parser_node_id(state)}
            expression = ParsedExpr{expr: literal, span: span}
            owner_type_args = [Type]{}
            tail_done = true
            next
        }
        if kind == TOKEN_LBRACKET {
            open: parser_bump(state)
            // `[.field]` (or `[.field..end]`) is a typed
            // layout selector, kept as an identifier with an internal name.
            if parser_current_kind(state) == TOKEN_DOT && parser_kind_at(state, 1) == TOKEN_IDENT && (parser_kind_at(state, 2) == TOKEN_RBRACKET || parser_kind_at(state, 2) == TOKEN_DOT_DOT) {
                dot: parser_bump(state)
                field: parser_bump(state)
                selector: Expr.Ident{name: parser_task_internal("layout.selector.{parser_value(state, field)}"), span: parser_cover(dot.span, field.span), id: parser_node_id(state)}
                if parser_current_kind(state) == TOKEN_DOT_DOT {
                    parser_bump(state)
                    end: parser_parse_expression(state, 1, depth + 1)
                    slice_close: parser_expect(state, TOKEN_RBRACKET, "`]` after a slice range")
                    slice_span: parser_cover(open.span, slice_close.span)
                    expression = ParsedExpr{expr: Expr.Slice{base: expression.expr.move(), start: selector, end: end.expr, range: None, span: slice_span, id: parser_node_id(state)}, span: slice_span}
                    next
                }
                selector_close: parser_expect(state, TOKEN_RBRACKET, "`]` after an index")
                selector_span: parser_cover(open.span, selector_close.span)
                expression = ParsedExpr{expr: Expr.Index{base: expression.expr.move(), index: selector.move(), span: selector_span, kind: IndexKind.Unknown, id: parser_node_id(state)}, span: selector_span}
                next
            }
            index: parser_parse_expression(state, 1, depth + 1)
            close: parser_expect(state, TOKEN_RBRACKET, "`]` after the index")
            span := parser_cover(expression.span, close.span)
            // An index or slice is spanned at its brackets, as in the
            // reference; `span` covers the base too.
            bracket_span: parser_cover(open.span, close.span)
            if index.expr == {
                .Range(start, end, exclusive, _, _) -> {
                    range_expr := index.expr
                    expression = ParsedExpr{
                        expr: Expr.Slice{base: expression.expr.move(), start: start, end: end, range: Val(range_expr), span: bracket_span, id: parser_node_id(state)},
                        span: span,
                    }
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expression = ParsedExpr{expr: Expr.Index{base: expression.expr.move(), index: index.expr, span: bracket_span, kind: IndexKind.Unknown, id: parser_node_id(state)}, span: span}
            }
            next
        }
        if kind == TOKEN_DOT || kind == TOKEN_QUESTION_DOT {
            operator: parser_bump(state)
            tail_member = true
            // A capitalized name's `<…>` belongs only to the member it names.
            owner_head: parser_literal_head_path(expression.expr)
            if owner_head == "" || owner_head.contains(".") -> owner_type_args = [Type]{}
            // Postfix `p.*` dereferences a raw pointer (`p.*.field`
            // composes); sema gates it to `#Unsafe`.
            if operator.kind == TOKEN_DOT && parser_current_kind(state) == TOKEN_STAR {
                star: parser_bump(state)
                deref_span: parser_cover(expression.span, star.span)
                expression = ParsedExpr{expr: Expr.Deref{value: expression.expr.move(), span: deref_span, id: parser_node_id(state)}, span: deref_span}
                next
            }
            // `prefix.[a, b, c]` member spread.
            if operator.kind == TOKEN_DOT && parser_current_kind(state) == TOKEN_LBRACKET {
                expression = parser_parse_member_spread(state, expression)
                next
            }
            // After `.` or `?.` a member is a name even when the word is a
            // keyword elsewhere (`x.copy()`, `p.effect`): no keyword
            // syntax starts at a member position.
            next_token: parser_current(state)
            keyword_member: parser_is_keyword_token(state, next_token)
            member: if keyword_member -> parser_bump(state) else -> parser_expect_name(state, "after the field-access operator")
            member_name: if keyword_member -> parser_text(state, member) else -> parser_value(state, member)
            // A program reads a compiler fact through `x.reflect().fact`, and a
            // template pastes a member name as `x.#{name}`.
            if member_name.starts_with("$") {
                parser_add_error_code(state, "E0003", member.span, "`{member_name}` is not a member name", "a member after `.` is a plain name", "write the member's name")
            }
            span := parser_cover(expression.span, member.span)
            // `x.reflect().fact` reads the compiler fact `fact` of `x`; the
            // tree keeps it as the `$fact` member of `x`.
            if operator.kind == TOKEN_DOT && parser_current_kind(state) != TOKEN_LPAREN && fact_read_kind("${member_name}") != None {
                if parser_reflect_subject(expression.expr) == .Val(subject) {
                    expression = ParsedExpr{expr: Expr.Field{base: subject, member: "${member_name}", span: member.span, id: parser_node_id(state)}, span: span}
                    next
                }
            }
            // A field access is spanned at its member name, as in the
            // reference; `span` covers the base too.
            expression = if operator.kind == TOKEN_QUESTION_DOT -> ParsedExpr{expr: Expr.OptField{base: expression.expr.move(), member: member_name, member_span: member.span, flatten: false, span: span, id: parser_node_id(state)}, span: span} else -> ParsedExpr{expr: Expr.Field{base: expression.expr.move(), member: member_name, span: member.span, id: parser_node_id(state)}, span: span}
            next
        }
        if kind == TOKEN_QUESTION {
            operator: parser_bump(state)
            // Bare `?` propagation is retired; only a value's
            // `x?)` and the context frame `x?(note)` remain. A call
            // propagates by itself, so `call()?)` is the bare form too.
            if parser_current_kind(state) == TOKEN_LPAREN {
                parser_bump(state)
                note: parser_parse_expression(state, 1, depth + 1)
                parser_expect(state, TOKEN_RPAREN, "`)` to finish the failure context")
                note_span: parser_cover(expression.span, note.span)
                expression = ParsedExpr{expr: Expr.Try{value: expression.expr, span: note_span, conversion: TryConvert.NoConversion, context: Val(note.expr), id: parser_node_id(state)}, span: note_span}
                next
            }
            if parser_current_kind(state) != TOKEN_RPAREN || parser_expression_is_call(expression.expr) {
                parser_add_fatal_code(state, "E-ERR-PROPAGATE", operator.span, "A bare `?` has no meaning.", "Fallible calls propagate automatically; `?(text)` is reserved for adding one failure-context frame.", "remove the trailing `?`, or write `?(text)` to add one context frame.")
                break
            }
            span := parser_cover(expression.span, operator.span)
            expression = ParsedExpr{expr: Expr.Try{value: expression.expr, span: span, conversion: TryConvert.NoConversion, context: None, id: parser_node_id(state)}, span: span}
            next
        }
        break
    }
    // A capitalized name's `<…>` that no member, call or literal took is a
    // generic type written where a value goes (`show(Box<Int>)`): the tree
    // keeps the whole type, and sema refuses it as a value.
    if owner_type_args.len() > 0 && expression.expr == .Ident(name, _, _) {
        type_span: Span{start: expression.span.start, end: parser_previous_end(state)}
        return ParsedExpr{expr: Expr.TypeValue{ty: Type.Apply{name: name, args: owner_type_args.move()}, span: type_span, id: parser_node_id(state)}, span: type_span}
    }
    expression
}

parser_expression_is_call: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Rust `ptr_from_addr`: the tail of `alias.Ptr<T>.from_addr(addr)`, with the
// cursor at the `<`.
parser_parse_ptr_from_addr: fn(state: &JetParserState, alias: String, alias_span: Span, depth: Int) -> ParsedExpr {
    parser_bump(state)
    elem: parser_parse_type(state, depth + 1).ty
    absent: ParsedExpr{expr: Expr.Absent{span: alias_span, id: parser_node_id(state)}, span: alias_span}
    if parser_current_kind(state) == TOKEN_COMMA {
        comma_span: parser_current(state).span
        parser_add_fatal_code(state, "E0003", comma_span, "`Ptr<…>` takes exactly one element type", "a pointer points at a single element type", "write `{alias}.Ptr<Int>.from_addr(addr)`")
        return absent
    }
    if !parser_type_close_here(state) {
        parser_add_error_here(state, "expected `>` after `Ptr<…>`", "generic type arguments must be closed", "add `>`")
        return absent
    }
    _ := parser_type_gt_span(state)
    parser_expect(state, TOKEN_DOT, "`.` after `Ptr<…>`")
    method: parser_expect_name(state, "after `Ptr<…>.`")
    method_name: parser_value(state, method)
    if method_name != "from_addr" {
        parser_add_fatal_code(state, "E0003", method.span, "`Ptr<…>` has no static method `{method_name}`", "a typed pointer is built from an address", "write `{alias}.Ptr<Int>.from_addr(addr)`")
        return absent
    }
    parser_expect(state, TOKEN_LPAREN, "`(` after `from_addr`")
    address: parser_parse_expression(state, 1, depth + 1)
    close: parser_expect(state, TOKEN_RPAREN, "`)` to finish the call")
    span: parser_cover(alias_span, close.span)
    ParsedExpr{expr: Expr.PtrFromAddr{alias: alias, alias_span: alias_span, elem: elem, addr: address.expr, span: span, id: parser_node_id(state)}, span: span}
}

// Adjacent generic heads before calls or qualified literals; spaced
// `f < T > (x)` stays a comparison.
parser_turbofish_ahead: fn(state: &JetParserState, following: Int) -> Bool Never! {
    if state.position == 0 || state.tokens[state.position - 1].span.end != parser_current(state).span.start -> return false
    nested := 0
    loop index in state.position..<state.tokens.len() {
        token: state.tokens[index]
        if token.kind == TOKEN_LT -> nested += 1
        if token.kind == TOKEN_GT -> nested -= 1
        if token.kind == TOKEN_SHR -> nested -= 2
        if (token.kind == TOKEN_GT || token.kind == TOKEN_SHR) && nested <= 0 {
            return index + 1 < state.tokens.len() && state.tokens[index + 1].kind == following && state.tokens[index + 1].span.start == token.span.end
        }
        if token.kind == TOKEN_SEMI || token.kind == TOKEN_LBRACE || token.kind == TOKEN_RBRACE || token.kind == TOKEN_EOF -> return false
    }
    false
}

// Rust `parse_turbofish` / the capitalized-name `<…>`: comma-separated
// types, a trailing comma allowed, closed by `>` (or half of `>>`).
parser_parse_call_type_args: fn(state: &JetParserState, depth: Int) -> [Type] {
    parser_bump(state)
    args := [Type]{}
    loop {
        args.push(parser_parse_type_argument(state, depth + 1))
        if state.pending_type_gt || parser_current_kind(state) != TOKEN_COMMA -> break
        parser_bump(state)
        if parser_type_close_here(state) -> break
    }
    if !parser_type_close_here(state) {
        parser_add_error_here(state, "expected `>` after call type arguments", "generic type arguments must be closed", "add `>`")
        return args
    }
    _ := parser_type_gt_span(state)
    args
}

// A mark in a body stays only where a name holds the
// access: a write window bound to a name (`edit: &values[2..3]`), a match
// that writes into its subject (`if &shape == {…}`), and a writing loop
// source (`loop v in &values`). Those positions parse the `&` here; sema
// requires its operand to be a place (E0213), so a window over a call result
// teaches binding the temporary first. A mark before a call on a place
// (`&xs.push(4)`) marks that call's receiver instead (parser_receiver_mark).
parser_parse_marked_place: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    mark: parser_bump(state)
    operand: parser_parse_expression_restricted(state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
    span: parser_cover(mark.span, operand.span)
    if parser_receiver_mark(state, operand.expr, PlaceAccess.Write, mark.span) == .Val(call) -> return ParsedExpr{expr: call, span: span}
    ParsedExpr{expr: Expr.Place{value: operand.expr, access: PlaceAccess.Write, span: span, id: parser_node_id(state)}, span: span}
}

// `&&buf.seal()`: the take mark on a receiver. Any other `&&` in value
// position is the ordinary "expected a value" report.
parser_parse_take_mark: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr {
    mark: parser_bump(state)
    operand: parser_parse_expression_restricted(state, 13, depth + 1, allow_struct_lit, stop_before_comparison)
    span: parser_cover(mark.span, operand.span)
    if parser_receiver_mark(state, operand.expr, PlaceAccess.Take, mark.span) == .Val(call) -> return ParsedExpr{expr: call, span: span}
    parser_report_mark_not_value(state, mark)
    operand
}

parser_report_mark_not_value: fn(state: &JetParserState, mark: Token) {
    found: parser_text(state, mark)
    parser_add_error(state, mark.span, "expected a value, found `{found}`", "a value can be a name, literal, collection, call, or parenthesized expression", "write an expression such as `x`, `42`, or `\"hello\"`")
}

// A call mark (`&` writes, `&&` takes) binds the maximal place after it: the
// receiver of the first method call on that place (`&xs.push(4)`,
// `&&self.buf.seal()`). The receiver becomes a written Place; sema checks it
// against the method's signature under `#Policy(writes: .Explicit)` and
// reports it as the ordinary parse error outside that policy.
parser_receiver_mark: fn(state: &JetParserState, expr: Expr, access: PlaceAccess, mark: Span) -> Expr? {
    if expr == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, id) {
        if parser_mark_place(receiver) {
            place: Expr.Place{value: receiver, access: access, span: Span{start: mark.start, end: expr_span(receiver).end}, id: parser_node_id(state)}
            return Val(Expr.MethodCall{receiver: place, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, id: id})
        }
        inner: parser_receiver_mark(state, receiver, access, mark) ?? return None
        return Val(Expr.MethodCall{receiver: inner, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, id: id})
    }
    None
}

// A place a call mark can name: a local, parameter or `self`, through fields,
// indexes and ranges.
parser_mark_place: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) -> parser_mark_place(base)
        .Index(base, _, _, _, _) -> parser_mark_place(base)
        .Slice(base, _, _, _, _, _) -> parser_mark_place(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> false
    }
}

parser_parse_call_args: fn(state: &JetParserState, depth: Int, allow_marker_labels: Bool) -> [CallArg] {
    parser_expect(state, TOKEN_LPAREN, "`(` before call arguments")
    args := [CallArg]{}
    if parser_current_kind(state) != TOKEN_RPAREN {
        loop {
            // A call cut off before its next argument reports its opener, not
            // a missing value at the cutoff.
            if parser_unclosed_delimiter(state, "call") -> return args
            argument_span := parser_current(state).span
            spread := parser_current_kind(state) == TOKEN_DOT_DOT_DOT
            if spread -> parser_bump(state)
            label := CallLabel?{None}
            label_kind := parser_current_kind(state)
            has_label := label_kind == TOKEN_IDENT || label_kind == TOKEN_KW_TAG || (allow_marker_labels && label_kind == TOKEN_KW_USE)
            if has_label && parser_kind_at(state, 1) == TOKEN_COLON {
                label_token: parser_bump(state)
                parser_bump(state)
                label_name := parser_value(state, label_token)
                if label_token.kind == TOKEN_KW_TAG -> label_name = "tag"
                if label_token.kind == TOKEN_KW_USE -> label_name = "use"
                label = Val(CallLabel{name: label_name, span: label_token.span})
            }
            mark_kind: parser_current_kind(state)
            if mark_kind == TOKEN_AMP || mark_kind == TOKEN_AND_AND {
                args.push(parser_parse_marked_argument(state, depth, argument_span, label.move(), spread))
            } else {
                argument: parser_parse_expression(state, 1, depth + 1)
                args.push(CallArg{convention: AccessConvention.Read, expr: argument.expr, span: argument_span, flags: ast_empty_call_arg_flags(), label: label.move(), spread: spread})
            }
            if parser_current_kind(state) == TOKEN_RPAREN -> break
            if parser_current_kind(state) != TOKEN_COMMA {
                if parser_unclosed_delimiter(state, "call") -> return args
                token: parser_current(state)
                parser_add_error(state, token.span, "expected `,` between call arguments", "call arguments are comma-separated", "add a comma or close the call")
                break
            }
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RPAREN -> break
        }
    }
    parser_expect(state, TOKEN_RPAREN, "`)` after call arguments")
    args
}

// `grow(&xs)` / `archive(&&title)`: a call mark on a place argument
// (CallMark). A mark before a call on a place marks that call's receiver
// (parser_receiver_mark); before any other value it is the ordinary
// "expected a value" report.
parser_parse_marked_argument: fn(state: &JetParserState, depth: Int, argument_span: Span, label: CallLabel?, spread: Bool) -> CallArg {
    mark_token: parser_bump(state)
    access: if mark_token.kind == TOKEN_AMP -> PlaceAccess.Write else -> PlaceAccess.Take
    argument: parser_parse_expression(state, 1, depth + 1)
    if parser_mark_place(argument.expr) {
        return CallArg{convention: AccessConvention.Read, expr: argument.expr, span: argument_span, flags: ast_empty_call_arg_flags(), label: label, spread: spread, mark: Val(CallMark{access: access, span: mark_token.span})}
    }
    marked: parser_receiver_mark(state, argument.expr, access, mark_token.span) ?? {
        parser_report_mark_not_value(state, mark_token)
        return CallArg{convention: AccessConvention.Read, expr: argument.expr, span: argument_span, flags: ast_empty_call_arg_flags(), label: label, spread: spread}
    }
    CallArg{convention: AccessConvention.Read, expr: marked, span: argument_span, flags: ast_empty_call_arg_flags(), label: label, spread: spread}
}

parser_parse_expression_fields: fn(state: &JetParserState, depth: Int) -> ParsedExprFields {
    open: parser_expect(state, TOKEN_LBRACE, "`{{` before record fields")
    fields := [ExprField]{}
    if parser_current_kind(state) != TOKEN_RBRACE {
        loop {
            if parser_state_section_ahead(state) {
                section_start: parser_current(state).span
                section := parser_parse_state_section(state, "", section_start)
                parser_report_ineligible_state_section(state, section, "anonymous shape")
                if parser_current_kind(state) == TOKEN_COMMA || parser_current_kind(state) == TOKEN_SEMI -> parser_bump(state)
                if parser_current_kind(state) == TOKEN_RBRACE || parser_current_kind(state) == TOKEN_EOF -> break
                next
            }
            name_token: parser_field_name(state, "for a record field")
            value := Expr.Ident{name: parser_value(state, name_token), span: name_token.span, id: parser_node_id(state)}
            if parser_current_kind(state) == TOKEN_COLON {
                parser_bump(state)
                parsed_value := parser_parse_expression(state, 1, depth + 1)
                value = parsed_value.expr.move()
            }
            fields.push(ExprField{name: parser_value(state, name_token), name_span: name_token.span, value: value.move()})
            if parser_current_kind(state) == TOKEN_RBRACE -> break
            separator_kind := parser_current_kind(state)
            if {
                separator_kind == TOKEN_COMMA || separator_kind == TOKEN_SEMI -> {
                    parser_bump(state)
                    if parser_current_kind(state) == TOKEN_RBRACE -> break
                }
                else -> {
                    token: parser_current(state)
                    parser_add_error(state, token.span, "expected a separator between record fields", "record fields are separated by commas or statement terminators", "add a comma or close the record")
                    break
                }
            }
        }
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after record fields")
    ParsedExprFields{fields: fields.move(), span: parser_cover(open.span, close.span)}
}

// A record payload `.Case{…}` is read only where a struct literal may stand,
// as in Rust: in an `if` or loop header the `{` opens the body.
parser_parse_variant_args: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool) -> [EnumLitArg] {
    args := [EnumLitArg]{}
    if {
        parser_current_kind(state) == TOKEN_LPAREN -> {
            parser_bump(state)
            if parser_current_kind(state) != TOKEN_RPAREN {
                loop {
                    if {
                        parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON -> {
                            label: parser_bump(state)
                            parser_bump(state)
                            value: parser_parse_expression(state, 1, depth + 1)
                            args.push(EnumLitArg.Named{label: parser_value(state, label), expr: value.expr})
                        }
                        else -> {
                            value: parser_parse_expression(state, 1, depth + 1)
                            args.push(EnumLitArg.Positional{value: value.expr})
                        }
                    }
                    if parser_current_kind(state) == TOKEN_RPAREN -> break
                    if parser_current_kind(state) != TOKEN_COMMA -> break
                    parser_bump(state)
                    if parser_current_kind(state) == TOKEN_RPAREN -> break
                }
            }
            parser_expect(state, TOKEN_RPAREN, "`)` after enum payload")
        }
        allow_struct_lit && parser_current_kind(state) == TOKEN_LBRACE -> {
            fields: parser_parse_expression_fields(state, depth + 1)
            field_index := 0
            loop field_index < fields.fields.len() {
                field: fields.fields[field_index]
                args.push(EnumLitArg.Named{label: field.name, expr: field.value})
                field_index += 1
            }
        }
    }
    args
}

parser_parse_or_fallback: fn(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> OrFallback {
    if parser_current_kind(state) == TOKEN_LBRACE {
        block: parser_parse_value_block(state, depth + 1, false)
        return OrFallback.Block{body: block.statements, value: block.tail, span: block.span}
    }
    token: parser_current(state)
    if token.kind == TOKEN_RETURN {
        parser_bump(state)
        value := Expr?{None}
        if parser_starts_expression(parser_current_kind(state)) {
            value = Val(parser_parse_expression_restricted(state, 1, depth + 1, allow_struct_lit, stop_before_comparison).expr)
        }
        return OrFallback.Return{value: value, span: token.span}
    }
    // Bare `?? next` is contextual control and
    // `break(name)` / `next(name)` exit the named loop; `?? next(value)`
    // with anything but one name stays an ordinary call fallback.
    if token.kind == TOKEN_BREAK {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_LPAREN {
            parser_bump(state)
            name: parser_expect_name(state, "as the loop name in `break(name)`")
            close: parser_expect(state, TOKEN_RPAREN, "`)` after the named break target")
            return OrFallback.BreakLabel{name: parser_value(state, name), span: parser_cover(token.span, close.span)}
        }
        return OrFallback.Break{span: token.span}
    }
    if token.kind == TOKEN_IDENT && parser_value(state, token) == "next" && (parser_kind_at(state, 1) != TOKEN_LPAREN || (parser_kind_at(state, 2) == TOKEN_IDENT && parser_kind_at(state, 3) == TOKEN_RPAREN)) {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_LPAREN {
            parser_bump(state)
            name: parser_bump(state)
            close: parser_bump(state)
            return OrFallback.ContinueLabel{name: parser_value(state, name), span: parser_cover(token.span, close.span)}
        }
        return OrFallback.Continue{span: token.span}
    }
    // `??` groups from the right, so `a ?? b ?? c`
    // is `a ?? (b ?? c)`: the fallback operand parses at `??`'s own level.
    value: parser_parse_expression_restricted(state, 1, depth + 1, allow_struct_lit, stop_before_comparison)
    // Rust `parse_or_fallback`: a bare `panic(...)` call is the panic fallback.
    if value.expr == .Call(call, _) {
        if call.name == "panic" -> return OrFallback.Panic{name_span: call.name_span, args: call.args}
    }
    OrFallback.Value{value: value.expr}
}

parser_fallback_span: fn(fallback: OrFallback) -> Span {
    if fallback == {
        .Value(value) -> expr_span(value)
        .Block(_, _, span) -> span
        .Return(_, span) -> span
        .Panic(name_span, _) -> name_span
        .Break(span) -> span
        .Continue(span) -> span
        .BreakLabel(_, span) -> span
        .ContinueLabel(_, span) -> span
    }
}