// Declaration grammar. AST nodes are assembled directly from Jet tokens; no
// Rust parser or semantic compiler is involved.
use jet_foundation.[
    AccessConvention,
    CLICommandBinding,
    CallLabel,
    ConstAttr,
    ConstDef,
    CtValue,
    DeriveBodyItem,
    DeriveDef,
    EffectDecl,
    EffectRowEntry,
    EnumDef,
    EnumGroup,
    ErrorConvDef,
    Expr,
    Field,
    Func,
    ImplDef,
    ImportDecl,
    ImportKind,
    ImportedItem,
    InlineForeign,
    InlineVersion,
    Item,
    Marker,
    MarkerCallArg,
    NamedSpan,
    NamedType,
    OperatorMarker,
    Param,
    ParamZone,
    PatSlot,
    Pattern,
    PrepParam,
    RustConstKind,
    Span,
    StateDecl,
    Stmt,
    StructDef,
    TagDef,
    TextEdit,
    TraitDef,
    TraitMethodSig,
    TraitImplBlock,
    Type,
    TypeAliasDef,
    TypeParam,
    UserPolicyDecl,
    Variant,
    VariantField,
    VariantPayload,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    ast_const,
    ast_enum,
    ast_func,
    ast_struct,
    diagnostic_from_registry,
    diagnostic_with_edit,
]
use jet_lexer.[
    TOKEN_AMP,
    TOKEN_AT,
    TOKEN_BANG,
    TOKEN_CARET,
    TOKEN_COLON,
    TOKEN_COLON_COLON,
    TOKEN_COLON_EQ,
    TOKEN_COMMA,
    TOKEN_DOT,
    TOKEN_DOT_DOT,
    TOKEN_DOT_DOT_DOT,
    TOKEN_EOF,
    TOKEN_EQ,
    TOKEN_FLOAT,
    TOKEN_GT,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_INT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_COPY,
    TOKEN_KW_DERIVE,
    TOKEN_KW_EFFECT,
    TOKEN_KW_ENUM,
    TOKEN_KW_EXTERN,
    TOKEN_KW_FN,
    TOKEN_KW_IMPL,
    TOKEN_KW_MODULE,
    TOKEN_KW_MOVE,
    TOKEN_KW_MUTATE,
    TOKEN_KW_PRIV,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_KW_TRAIT,
    TOKEN_KW_USE,
    TOKEN_LAMBDA_ARROW,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LPAREN,
    TOKEN_LT,
    TOKEN_MINUS,
    TOKEN_MINUS_MINUS,
    TOKEN_PIPE,
    TOKEN_RAW_STRING,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_SELF,
    TOKEN_SEMI,
    TOKEN_SLASH,
    TOKEN_STAR,
    TOKEN_STRING,
    TOKEN_TILDE_TILDE,
    TOKEN_UNIFIED_ARROW,
    Token,
]

pub struct ParsedItemOrImport {
    pub item: Item?
    pub import: ImportDecl?
    pub handled: Bool
}

pub struct ParsedItemModifiers {
    pub is_pub: Bool
    pub is_package_pub: Bool
    pub is_comptime: Bool
    pub markers: [Marker]
    pub start_span: Span
    // D-TAINT-SAN: the retired bare `sanitizer` word before `fn` (E0059).
    pub is_sanitizer: Bool{false}
}
pub struct ParsedFunction {
    pub value: Func
    pub has_body: Bool
}
pub struct ParsedUserPolicy {
    pub value: UserPolicyDecl
    pub valid: Bool
}

fn parser_user_policy_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) == TOKEN_KW_PUB {
        token := parser_lookahead(&state, 1)
        return token.kind == TOKEN_IDENT && token.payload.decoded == "policy"
    }
    token := parser_current(&state)
    token.kind == TOKEN_IDENT && token.payload.decoded == "policy"
}

fn parser_parse_user_policy(state: &JetParserState) -> ParsedUserPolicy {
    is_pub := false
    if parser_current_kind(&state) == TOKEN_KW_PUB {
        parser_bump(&state)
        is_pub = true
    }
    start :: parser_expect_name(&state, "to start a policy declaration")
    name :: parser_expect_name(&state, "as the policy setting name")
    params := parser_parse_param_list(&state)
    parser_expect(&state, TOKEN_LBRACE, "before the policy wrapper")
    wrap :: parser_expect_name(&state, "`wrap` in a policy declaration")
    valid := true
    if wrap.payload.decoded != "wrap" {
        parser_add_error(&state, wrap.span, "expected `wrap` in a policy declaration", "a user policy has one checked wrapper boundary around the supplied callable", "write `wrap(call)` around the policy body")
        valid = false
    }
    parser_expect(&state, TOKEN_LPAREN, "after `wrap`")
    call :: parser_expect_name(&state, "as the callable parameter in `wrap(call)`")
    if call.payload.decoded != "call" {
        parser_add_error(&state, call.span, "a policy wrapper must receive `call`", "policy wrappers receive one callable value and cannot edit its signature", "write `wrap(call)`")
        valid = false
    }
    parser_expect(&state, TOKEN_RPAREN, "after the policy callable parameter")
    body := parser_parse_block(&state)
    // The wrapper body's line end lexes as `;` before the outer `}` (Rust
    // imports_policy.rs skips every `Semi` in this gap).
    parser_skip_semicolons(&state)
    close :: parser_expect(&state, TOKEN_RBRACE, "after the policy wrapper body")
    parser_finish_statement(&state)
    if !is_pub {
        parser_add_error(&state, start.span, "a user policy setting must be public", "policy settings are package vocabulary and their users resolve a package-owned name", "make this a public policy declaration with a `wrap(call)` body")
        valid = false
    }
    value := UserPolicyDecl{is_pub: is_pub, name: name.payload.decoded, name_span: name.span, params: params, body: body.statements, span: parser_cover(start.span, close.span)}
    ParsedUserPolicy{value: value, valid: valid}
}



fn parser_parse_item_or_import(state: &JetParserState) -> ParsedItemOrImport {
    modifiers :: parser_parse_item_modifiers(&state, true)
    if {
        parser_c_module_ahead_at(&state, 0) -> {
            value := parser_parse_c_module(&state)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_module_ahead(&state) -> {
            value :: parser_parse_module(&state, modifiers)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_test_ahead(&state) -> {
            value :: parser_parse_test(&state)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_unit_family_ahead(&state) -> {
            value :: parser_parse_unit_family(&state, modifiers)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_distinct_ahead(&state) -> {
            value :: parser_parse_distinct(&state, modifiers)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_state_section_ahead(&state) -> {
            section_start :: parser_current(&state).span
            section := parser_parse_state_section(&state, "", section_start)
            parser_report_ineligible_state_section(&state, section, "module")
            return ParsedItemOrImport{item: None, import: None, handled: true}
        }
        parser_state_ahead(&state) -> {
            declaration := parser_parse_state_decl(&state, modifiers)
            parser_report_top_level_state_decl(&state, declaration)
            return ParsedItemOrImport{item: None, import: None, handled: true}
        }
        parser_protocol_ahead(&state) -> {
            value :: parser_parse_protocol(&state, modifiers)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_marker_decl_ahead(&state) -> {
            value :: parser_parse_marker_decl(&state)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_fact_decl_ahead(&state) -> {
            value :: parser_parse_fact_decl(&state)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_tag_decl_ahead(&state) -> {
            value :: parser_parse_tag_policy(&state, modifiers)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_item_declaration_ahead_at(&state, 0) && parser_extern_ahead(&state) -> {
            value :: parser_parse_extern_rust(&state)
            return ParsedItemOrImport{item: Val(value), import: None, handled: true}
        }
        parser_current_kind(&state) == TOKEN_KW_USE -> {
            import := parser_parse_import(&state)
            import.is_pub = modifiers.is_pub
            import.is_package_pub = modifiers.is_package_pub
            return ParsedItemOrImport{item: None, import: Val(import), handled: true}
        }
    }
    token :: parser_current(&state)
    if {
        parser_template_loop_ahead(&state) -> {
            value :: parser_parse_template_loop(&state)
            return ParsedItemOrImport{item: Val(Item.TemplateLoop{value: value}), import: None, handled: true}
        }
        // 3A: `pub NAME :: value` exports a module constant like any item.
        parser_comptime_const_ahead(&state, 0) || (modifiers.markers.len() > 0 && parser_marked_const_ahead(&state, 0)) || ((modifiers.is_pub || modifiers.is_package_pub) && token.kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON_COLON) -> {
            value :: parser_parse_const(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Const{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_FN -> {
            parsed :: parser_parse_function(&state, modifiers, true)
            return ParsedItemOrImport{item: Val(Item.Func{value: parsed.value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_STRUCT -> {
            value :: parser_parse_struct(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Struct{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_ENUM -> {
            value :: parser_parse_enum(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Enum{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_CONST || token.kind == TOKEN_KW_COMPTIME || (modifiers.is_comptime && token.kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_EQ) -> {
            value :: parser_parse_const(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Const{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_TRAIT -> {
            value :: parser_parse_trait(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Trait{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_IMPL -> return ParsedItemOrImport{item: Val(parser_parse_impl(&state)), import: None, handled: true}
        token.kind == TOKEN_KW_MODULE -> return ParsedItemOrImport{item: Val(parser_parse_module(&state, modifiers)), import: None, handled: true}
        token.kind == TOKEN_KW_EFFECT -> {
            value :: parser_parse_effect_decl(&state)
            return ParsedItemOrImport{item: Val(Item.EffectDecl{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_TAG -> {
            value :: parser_parse_tag_decl(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Tag{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_KW_EXTERN -> return ParsedItemOrImport{item: Val(parser_parse_extern_rust(&state)), import: None, handled: true}
        token.kind == TOKEN_KW_DERIVE -> {
            value :: parser_parse_user_derive(&state)
            return ParsedItemOrImport{item: Val(Item.UserDerive{value: value}), import: None, handled: true}
        }
        token.kind == TOKEN_IDENT && token.payload.decoded == "alias" -> {
            value :: parser_parse_type_alias(&state, modifiers)
            return ParsedItemOrImport{item: Val(Item.TypeAlias{value: value}), import: None, handled: true}
        }
    }
    ParsedItemOrImport{item: None, import: None, handled: false}
}
fn parser_report_top_level_state_decl(state: &JetParserState, declaration: StateDecl) {
    state_names := ""
    index := 0
    loop index < declaration.states.len() {
        if index > 0 -> state_names = "{state_names}, "
        state_name :: declaration.states[index]
        state_names = "{state_names}{state_name.name}"
        index += 1
    }
    states := "{{ {state_names} }}"
    parser_add_error_code(&state, "E0157", declaration.span, "`state {declaration.type_name} {{ … }}` is not a type declaration", "Typestate facts belong to the struct that owns them; a sibling declaration repeats the type name and creates a false namespace boundary", "move the states into the owner: write `struct {declaration.type_name}` with `state {states}` inside its body")
}

fn parser_report_ineligible_state_section(state: &JetParserState, section: StateDecl, owner: String) {
    parser_add_error_code(&state, "E0158", section.span, "`state {{ … }}` is not valid inside a {owner}", "state sections attach only to named struct bodies; enums, traits, aliases, impls, modules, and anonymous shapes have no state-set owner", "Move `state {{ … }}` into the named struct body")
}
fn parser_report_repeated_state_section(state: &JetParserState, section: StateDecl, type_name: String) {
    parser_add_error_code(&state, "E0168", section.span, "`{type_name}` may declare only one `state {{ … }}` section", "The state set is one erased fact row owned by the struct", "Merge the state names into one `state {{ … }}` section")
}

// `item_visibility` is the top-level item path (D-VISDEFAULT2=A): `priv`,
// the foreign `private`, and `#PubFile` defaults are judged there. Members
// and methods only accept the `pub` / `pub(package)` qualifier.
fn parser_parse_item_modifiers(state: &JetParserState, item_visibility: Bool) -> ParsedItemModifiers {
    start := parser_current(&state).span
    is_pub := false
    is_package_pub := false
    is_comptime := false
    is_sanitizer := false
    markers := [Marker]{}
    marker_chunks := 0
    bracket_chunks := 0
    sequence := parser_current(&state).span
    loop {
        kind := parser_current_kind(&state)
        if kind == TOKEN_KW_PUB {
            parser_bump(&state)
            is_pub = true
            is_package_pub = false
            if parser_current_kind(&state) == TOKEN_LPAREN {
                parser_bump(&state)
                qualifier :: parser_current(&state)
                if qualifier.kind == TOKEN_IDENT && qualifier.payload.decoded == "package" {
                    parser_bump(&state)
                    is_pub = false
                    is_package_pub = true
                    if parser_current_kind(&state) == TOKEN_RPAREN {
                        parser_bump(&state)
                    } else {
                        close_span :: parser_current(&state).span
                        parser_add_error(&state, close_span, "expected `)` to close `pub(package)`", "write `pub(package)` with no extra content inside the parentheses", "use `pub(package)` to restrict access to sibling packages in the same payload")
                    }
                } else {
                    parser_add_error_code(&state, "E0411", qualifier.span, "unknown `pub(…)` qualifier — only `pub(package)` is supported", "`pub(package)` restricts access to sibling packages in the same payload", "write `pub` (public to all) or `pub(package)` (package-scoped)")
                    loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF -> parser_bump(&state)
                    if parser_current_kind(&state) == TOKEN_RPAREN -> parser_bump(&state)
                }
            }
            if item_visibility && state.pub_file_default && is_pub {
                pub_span :: parser_lookahead(&state, -1).span
                parser_add_error_code(&state, "E0414", pub_span, "`pub` is redundant in a `#PubFile` file", "after `#PubFile`, top-level items are already public unless marked `priv`", "drop `pub` or mark exceptions with `priv`")
            }
            next
        }
        foreign_private :: item_visibility && kind == TOKEN_IDENT && parser_current(&state).payload.decoded == "private" && parser_foreign_private_ahead(&state)
        if kind == TOKEN_KW_PRIV || foreign_private {
            word :: parser_bump(&state)
            if foreign_private {
                parser_add_error_code(&state, "E0412", word.span, "write `priv`, not `private`", "inside a `#PubFile` file, `priv` marks an item that stays private to this file", "write `priv fn …` instead of `private fn …`")
            }
            if item_visibility && parser_current_kind(&state) == TOKEN_KW_PUB {
                conflict :: parser_cover(word.span, parser_bump(&state).span)
                if parser_current_kind(&state) == TOKEN_LPAREN -> parser_skip_group(&state)
                parser_add_error_code(&state, "E0417", conflict, "`priv` and `pub` can't both apply to one item", "an item is either public or private — pick one qualifier", "drop `pub` (already public in a `#PubFile` file) or remove `priv`")
            }
            if item_visibility && !state.pub_file_default {
                parser_add_error_code(&state, "E0413", word.span, "`priv` only applies inside a `#PubFile` file", "without `#PubFile`, items are private by default and export with `pub`", "add `#PubFile` at the top of the file, or write `pub` instead of `priv`")
            }
            is_pub = false
            is_package_pub = false
            next
        }
        // D-TAINT-SAN: a bare `sanitizer fn` is the retired spelling of the
        // taint-strip modifier (E0059); the function still strips taint.
        if item_visibility && kind == TOKEN_IDENT && parser_current(&state).payload.decoded == "sanitizer" && (parser_kind_at(&state, 1) == TOKEN_KW_FN || parser_kind_at(&state, 1) == TOKEN_KW_PUB) {
            word :: parser_bump(&state)
            parser_add_error_code(&state, "E0059", word.span, "the taint-strip modifier is written `#Scrub(Tag)`, not bare `sanitizer`", "`#Scrub(Tag)` names the exact fact removed by the function", "write: #Scrub(Tag) fn name() {{ ... }}")
            is_sanitizer = true
            next
        }
        if kind == TOKEN_HASH {
            if parser_item_declaration_ahead_at(&state, 0) -> break
            if parser_kind_at(&state, 1) == TOKEN_LBRACKET {
                group :: parser_parse_marker_group_list(&state)
                if marker_chunks == 0 -> sequence.start = group.span.start
                sequence.end = group.span.end
                marker_chunks += 1
                bracket_chunks += 1
                loop marker in group.markers {
                    &markers.push(marker)
                    if marker.name == "Comptime" -> is_comptime = true
                }
                next
            }
            marker :: parser_parse_marker(&state)
            if marker_chunks == 0 -> sequence.start = marker.span.start
            sequence.end = marker.span.end
            marker_chunks += 1
            &markers.push(marker)
            if marker.name == "Comptime" -> is_comptime = true
            // Rust `parse_attached_marker_sequence`: a marker on its own line
            // still attaches to the declaration below.
            parser_skip_semicolons(&state)
            next
        }
        break
    }
    noun :: parser_marker_sequence_noun(&state, item_visibility)
    if noun != "" -> parser_report_adjacent_markers(&state, markers, marker_chunks, bracket_chunks, sequence, noun)
    ParsedItemModifiers{is_pub: is_pub, is_package_pub: is_package_pub, is_comptime: is_comptime, markers: markers, start_span: start, is_sanitizer: is_sanitizer}
}

// The target a declaration marker sequence attaches to, named as Rust's
// marker-sequence sites name it; empty where no sequence check applies.
fn parser_marker_sequence_noun(state: &JetParserState, item_visibility: Bool) -> String {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_KW_FN || parser_prep_fn_ahead(&state) {
        if item_visibility -> return "function"
        return "method"
    }
    if kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM -> return "type"
    if kind == TOKEN_KW_IMPL -> return "impl"
    if !item_visibility && kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON -> return "field"
    ""
}

// The foreign `private` word before an item (E0412 teaches `priv`).
fn parser_foreign_private_ahead(state: &JetParserState) -> Bool Never! {
    next_kind :: parser_kind_at(&state, 1)
    parser_is_item_keyword(next_kind) || next_kind == TOKEN_KW_PUB || next_kind == TOKEN_HASH
}

fn parser_parse_marker(state: &JetParserState) -> Marker {
    hash :: parser_expect(&state, TOKEN_HASH, "`#` before a marker")
    negated := false
    bang_start := 0
    if parser_current_kind(&state) == TOKEN_BANG {
        bang_start = parser_bump(&state).span.start
        negated = true
    }
    name :: parser_expect_name(&state, "after `#` in a declaration marker")
    if negated -> parser_check_signed_marker(&state, bang_start, name)
    args := ParsedMarkerArgs{args: [MarkerCallArg]{}, labels: [CallLabel?]{}}
    end := name.span
    if parser_current_kind(&state) == TOKEN_LPAREN {
        args = parser_parse_marker_args(&state)
        if state.position > 0 -> end = parser_lookahead(&state, -1).span
    }
    Marker{name: name.payload.decoded, negated: negated, name_span: name.span, args: args.args, arg_labels: args.labels, span: parser_cover(hash.span, end), ct: None}
}
fn parser_marker_first_expr(marker: Marker) -> Expr? {
    if marker.args.len() == 0 -> return None
    if marker.args[0] == {
        .Expr(value) -> return Val(value)
        else -> return None
    }
}


fn parser_parse_import(state: &JetParserState) -> ImportDecl {
    start :: parser_bump(&state)
    token :: parser_current(&state)
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        path :: parser_bump(&state)
        alias := parser_path_basename(path.payload.decoded)
        alias_span := start.span
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "as" {
            parser_bump(&state)
            alias_token :: parser_expect_name(&state, "after `as` in an import")
            alias = alias_token.payload.decoded
            alias_span = alias_token.span
        }
        parser_finish_statement(&state)
        end := path.span
        if state.position > 0 -> end = parser_lookahead(&state, -1).span
        return ImportDecl{kind: ImportKind.File{path: path.payload.decoded, span: path.span}, alias: alias, alias_span: alias_span, span: parser_cover(start.span, end), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
    }
    first :: parser_expect_name(&state, "after `use`")
    path := first.payload.decoded
    last_span := first.span
    parts := [Token]{first}
    loop parser_current_kind(&state) == TOKEN_DOT {
        next_kind := parser_lookahead(&state, 1).kind
        if next_kind == TOKEN_LBRACKET || next_kind == TOKEN_LBRACE || next_kind == TOKEN_STAR -> break
        parser_bump(&state)
        member :: parser_expect_name(&state, "after `.` in an import path")
        &parts.push(member)
        path = "{path}.{member.payload.decoded}"
        last_span = member.span
    }
    module_span := parser_cover(first.span, last_span)
    if parser_current_kind(&state) == TOKEN_DOT {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LBRACKET {
            return parser_parse_import_member_list(&state, start.span, path, module_span)
        }
        if parser_current_kind(&state) == TOKEN_STAR {
            star :: parser_bump(&state)
            parser_add_error_code(&state, "E0612", star.span, "wildcard imports are not supported", "`use {path}.*` would hide where each name comes from", "list each item instead: `use {path}.[item, other]`")
            parser_finish_statement(&state)
            end := parser_lookahead(&state, -1).span
            return ImportDecl{kind: ImportKind.Module{name: path, span: module_span}, alias: parts[parts.len() - 1].payload.decoded, alias_span: start.span, span: parser_cover(start.span, end), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
        }
        if parser_current_kind(&state) == TOKEN_LBRACE {
            open :: parser_bump(&state)
            brace_depth := 1
            loop brace_depth > 0 && parser_current_kind(&state) != TOKEN_EOF {
                kind := parser_current_kind(&state)
                if kind == TOKEN_LBRACE -> brace_depth += 1
                if kind == TOKEN_RBRACE -> brace_depth -= 1
                parser_bump(&state)
            }
            parser_add_error(&state, open.span, "brace import groups are not supported", "the braced grouped-import suffix is retired", "write a bracketed member list instead")
            parser_finish_statement(&state)
            end := parser_lookahead(&state, -1).span
            return ImportDecl{kind: ImportKind.Module{name: path, span: module_span}, alias: parts[parts.len() - 1].payload.decoded, alias_span: start.span, span: parser_cover(start.span, end), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
        }
        suffix :: parser_current(&state)
        parser_add_error(&state, suffix.span, "expected an import member suffix after `.`", "a trailing import dot starts a member list or wildcard suffix", "write `.[member]` after the module path")
    }
    alias := parts[parts.len() - 1].payload.decoded
    alias_span := first.span
    if parts.len() > 1 -> alias_span = start.span
    inline_version := InlineVersion?{None}
    if parts.len() == 1 && parser_current_kind(&state) == TOKEN_HASH {
        inline_version = Val(parser_parse_inline_version(&state))
    }
    explicit_alias := false
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "as" {
        parser_bump(&state)
        alias_token :: parser_expect_name(&state, "after `as` in an import")
        alias = alias_token.payload.decoded
        alias_span = alias_token.span
        explicit_alias = true
    }
    parser_finish_statement(&state)
    end := last_span
    if state.position > 0 -> end = parser_lookahead(&state, -1).span
    span := parser_cover(start.span, end)
    if parts.len() == 2 && !explicit_alias {
        item_span := parts[1].span
        return ImportDecl{kind: ImportKind.Unqualified{module_alias: first.payload.decoded, module_alias_span: first.span, items: [ImportedItem]{ImportedItem{original: parts[1].payload.decoded, alias: None}}, items_span: item_span, span: span}, alias: alias, alias_span: item_span, span: span, item_spans: [Span]{item_span}, local_spans: [Span]{item_span}, is_pub: false, is_package_pub: false, inline_version: None}
    }
    ImportDecl{kind: ImportKind.Module{name: path, span: module_span}, alias: alias, alias_span: alias_span, span: span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: inline_version}
}

fn parser_parse_import_member_list(state: &JetParserState, start: Span, module_alias: String, module_alias_span: Span) -> ImportDecl {
    open :: parser_bump(&state)
    items := [ImportedItem]{}
    item_spans := [Span]{}
    local_spans := [Span]{}
    next_kind := parser_current_kind(&state)
    if next_kind == TOKEN_RBRACKET || next_kind == TOKEN_EOF {
        parser_add_error(&state, open.span, "an import member list cannot be empty", "the `.[…]` form must name at least one member", "write `use {module_alias}.[member]`")
    }
    loop parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF {
        first :: parser_expect_name(&state, "inside an import member list")
        name := first.payload.decoded
        item_end := first.span
        local_span := first.span
        loop parser_current_kind(&state) == TOKEN_DOT {
            parser_bump(&state)
            part :: parser_expect_name(&state, "after `.` in an imported member")
            name = "{name}.{part.payload.decoded}"
            item_end = part.span
            local_span = part.span
        }
        alias := String?{None}
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "as" {
            parser_bump(&state)
            local :: parser_expect_name(&state, "after `as` in an imported member")
            alias = Val(local.payload.decoded)
            local_span = local.span
        }
        &items.push(ImportedItem{original: name, alias: alias})
        &item_spans.push(parser_cover(first.span, item_end))
        &local_spans.push(local_span)
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after imported members")
    items_span := parser_cover(open.span, close.span)
    parser_finish_statement(&state)
    end := parser_lookahead(&state, -1).span
    span := parser_cover(start, end)
    ImportDecl{kind: ImportKind.Unqualified{module_alias: module_alias, module_alias_span: module_alias_span, items: items, items_span: items_span, span: span}, alias: module_alias, alias_span: module_alias_span, span: span, item_spans: item_spans, local_spans: local_spans, is_pub: false, is_package_pub: false, inline_version: None}
}

fn parser_parse_inline_version(state: &JetParserState) -> InlineVersion {
    hash :: parser_bump(&state)
    first := parser_current(&state)
    if first.kind != TOKEN_INT && first.kind != TOKEN_FLOAT {
        parser_add_error(&state, first.span, "expected a version number after `#`", "`use package#version;` pins an inline dependency version", "write numeric version components after `#`")
        return InlineVersion{text: "", span: hash.span}
    }
    text := first.payload.text
    end := parser_bump(&state).span
    loop parser_current_kind(&state) == TOKEN_DOT && parser_lookahead(&state, 1).kind == TOKEN_INT {
        parser_bump(&state)
        part :: parser_bump(&state)
        text = "{text}.{part.payload.text}"
        end = part.span
    }
    InlineVersion{text: text, span: parser_cover(hash.span, end)}
}

fn parser_path_basename(path: String) -> String Never! {
    segments :: path.split("/").to_list()
    segments[segments.len() - 1]
}

fn parser_parse_type_params(state: &JetParserState) -> [TypeParam] {
    params := [TypeParam]{}
    if parser_current_kind(&state) != TOKEN_LT -> return params
    parser_bump(&state)
    if {
        parser_type_close_here(&state) -> parser_add_error_here(&state, "a generic parameter list cannot be empty", "type parameters are declared by name", "write at least one type parameter or remove `< >`")
        else -> {
            loop {
                // D-CONSTGEN2=A: `prep N: Int` declares a compile-time number
                // parameter; `<prep>` and `<prep: Trait>` stay type parameters.
                if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "prep" && parser_kind_at(&state, 1) == TOKEN_IDENT {
                    prep_head :: parser_bump(&state)
                    &params.push(parser_parse_prep_param(&state, prep_head.span, false))
                    if parser_type_close_here(&state) -> break
                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                    parser_bump(&state)
                    if parser_type_close_here(&state) -> break
                    next
                }
                // The retired D-CONSTGEN1 spelling `<@N: Int>` teaches E0389 once.
                if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded.starts_with("@") && parser_kind_at(&state, 1) == TOKEN_COLON {
                    retired_start :: parser_current(&state).span
                    &params.push(parser_parse_prep_param(&state, retired_start, true))
                    if parser_type_close_here(&state) -> break
                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                    parser_bump(&state)
                    if parser_type_close_here(&state) -> break
                    next
                }
                name :: parser_expect_name(&state, "in a generic parameter list")
                bounds := [String]{}
                if parser_current_kind(&state) == TOKEN_COLON {
                    parser_bump(&state)
                    if {
                        parser_current_kind(&state) == TOKEN_LBRACKET -> {
                            parser_bump(&state)
                            if parser_current_kind(&state) != TOKEN_RBRACKET {
                                loop {
                                    bound :: parser_expect_name(&state, "in a generic trait-bound list")
                                    &bounds.push(bound.payload.decoded)
                                    if parser_current_kind(&state) == TOKEN_RBRACKET -> break
                                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                                    parser_bump(&state)
                                }
                            }
                            parser_expect(&state, TOKEN_RBRACKET, "`]` after generic bounds")
                        }
                        else -> {
                            loop {
                                bound :: parser_expect_name(&state, "after `:` in a generic parameter")
                                &bounds.push(bound.payload.decoded)
                                if parser_current_kind(&state) != TOKEN_PIPE -> break
                                parser_bump(&state)
                            }
                        }
                    }
                }
                &params.push(TypeParam{name: name.payload.decoded, name_span: name.span, bounds: bounds, prep: None})
                if parser_type_close_here(&state) -> break
                if parser_current_kind(&state) != TOKEN_COMMA {
                    parser_add_error_here(&state, "expected `,` between generic parameters", "type parameter declarations are comma-separated", "add a comma or close the generic list")
                    break
                }
                parser_bump(&state)
                if parser_type_close_here(&state) -> break
            }
        }
    }
    if parser_type_close_here(&state) -> parser_take_type_close(&state) else -> parser_expect(&state, TOKEN_GT, "`>` after generic parameters")
    params
}

// D-CONSTGEN2=A: parse `N: Int` after `prep` (or the retired `@N: Int`, which
// teaches E0389) into the typed number-parameter slot.
fn parser_parse_prep_param(state: &JetParserState, prep_span: Span, retired: Bool) -> TypeParam {
    name :: parser_expect_name(&state, "for a number parameter name")
    written :: name.payload.decoded
    param_name :: if retired -> written.slice(1, written.len()) else -> written
    name_span :: if retired -> Span{start: name.span.start + 1, end: name.span.end} else -> name.span
    if retired {
        parser_add_error_code(&state, "E0389", name.span, "`{written}` marks a number parameter with the retired `@` mark", "only the declaration carries `prep`; every use writes the plain name `{param_name}`", "write `prep {param_name}` in the parameter list")
    }
    parser_expect(&state, TOKEN_COLON, "`:` after a number parameter name")
    value_type :: parser_expect_name(&state, "for the number parameter type")
    TypeParam{name: param_name, name_span: name_span, bounds: [String]{}, prep: Val(PrepParam{prep_span: prep_span, value_type: value_type.payload.decoded, value_type_span: value_type.span})}
}

// D-APILABEL1=A: `/` closes the positional-only zone and `*` opens the
// label-only zone; each appears at most once, `/` before `*`, and neither
// may mark an empty zone (E0763).
fn parser_parse_param_list(state: &JetParserState) -> [Param] {
    parser_expect(&state, TOKEN_LPAREN, "`(` before function parameters")
    params := [Param]{}
    zone := ParamZone.Either
    slash := Span?{None}
    star := Span?{None}
    if parser_current_kind(&state) != TOKEN_RPAREN {
        loop {
            if {
                parser_current_kind(&state) == TOKEN_SLASH -> {
                    span :: parser_bump(&state).span
                    if {
                        slash != None -> parser_add_error_code(&state, "E0763", span, "`/` appears twice in this parameter list", "each parameter list has at most one positional-only `/` and one label-only `*`", "remove the extra `/`")
                        star != None -> parser_add_error_code(&state, "E0763", span, "`/` comes after `*` in this parameter list", "the zones read left to right: positional-only, then either, then label-only", "move `/` before `*`")
                        params.len() == 0 -> parser_add_error_code(&state, "E0763", span, "`/` marks an empty parameter zone", "a positional-only zone needs at least one parameter before the `/`", "write the positional-only parameters before `/`, or remove the `/`")
                        else -> {
                            slash = Val(span)
                            index := 0
                            loop index < params.len() {
                                params[index].zone = ParamZone.PositionalOnly
                                index += 1
                            }
                        }
                    }
                }
                parser_current_kind(&state) == TOKEN_STAR -> {
                    span :: parser_bump(&state).span
                    if star != None {
                        parser_add_error_code(&state, "E0763", span, "`*` appears twice in this parameter list", "each parameter list has at most one positional-only `/` and one label-only `*`", "remove the extra `*`")
                    } else {
                        star = Val(span)
                        zone = ParamZone.LabelOnly
                    }
                }
                else -> &params.push(parser_parse_param(&state, zone))
            }
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            if parser_current_kind(&state) != TOKEN_COMMA {
                parser_add_error_here(&state, "expected `,` between parameters", "function parameters are comma-separated", "add a comma or close the parameter list")
                break
            }
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
    }
    parser_expect(&state, TOKEN_RPAREN, "`)` after function parameters")
    if star == Val(star_span) {
        label_only := false
        loop param in params {
            if param.zone == ParamZone.LabelOnly -> label_only = true
        }
        if !label_only -> parser_add_error_code(&state, "E0763", star_span, "`*` marks an empty parameter zone", "a label-only zone needs at least one parameter after the `*`", "write the label-only parameters after `*`, or remove the `*`")
    }
    parser_validate_variadic_params(&state, params)
    parser_validate_param_labels(&state, params)
    params
}

// D-APILABEL1=A: a parameter's call label is its public label when written,
// else its name; two parameters may not publish the same one (E0770).
fn parser_validate_param_labels(state: &JetParserState, params: [Param]) {
    loop index in 0..<params.len() {
        param :: params[index]
        if param.name == "self" -> next
        label :: if param.public_label == {.Val(value) -> value.name else -> param.name}
        label_span :: if param.public_label == {.Val(value) -> value.span else -> param.name_span}
        loop earlier_index in 0..<index {
            earlier :: params[earlier_index]
            if earlier.name == "self" -> next
            earlier_label :: if earlier.public_label == {.Val(value) -> value.name else -> earlier.name}
            if earlier_label == label {
                parser_add_error_code(&state, "E0770", label_span, "two parameters both publish the label `{label}`", "a label binds an argument by name, so a repeated one leaves the second parameter with no way to be called", "give one of them a different label, as in `{label}_2 {param.name}: …`")
                break
            }
        }
    }
}

// D-VARIADIC1: a `name: ...T` rest parameter collects every trailing
// argument, so it is last and has no default (E1310).
fn parser_validate_variadic_params(state: &JetParserState, params: [Param]) {
    loop index in 0..<params.len() {
        param :: params[index]
        if param.variadic && index + 1 != params.len() {
            parser_add_error_code(&state, "E1310", param.name_span, "variadic parameter `{param.name}` must be last", "a `name: ...T` rest parameter collects every trailing argument, so nothing may follow it", "move `{param.name}` to the end of the parameter list, or remove the `...`")
        }
    }
}

fn parser_parse_param(state: &JetParserState, zone: ParamZone) -> Param {
    root := false
    if parser_current_kind(&state) == TOKEN_HASH {
        marker :: parser_parse_marker(&state)
        root = marker.name == "Root"
    }
    convention := AccessConvention.Read
    access_kind :: parser_current_kind(&state)
    if access_kind == TOKEN_KW_COPY || access_kind == TOKEN_KW_MUTATE || access_kind == TOKEN_KW_MOVE {
        keyword_token :: parser_bump(&state)
        parser_add_error(&state, keyword_token.span, "expected a name for a parameter name, found the keyword `{keyword_token.payload.text}`", "names start with a letter or `_`", "write an identifier here")
    }
    if access_kind == {
        TOKEN_AMP -> {
            parser_bump(&state)
            convention = AccessConvention.Write
        }
        TOKEN_CARET -> {
            parser_bump(&state)
            convention = AccessConvention.Move
        }
        else -> {}
    }
    name := if parser_current_kind(&state) == TOKEN_SELF -> parser_bump(&state) else -> parser_expect_name(&state, "for a parameter name")
    public_label := CallLabel?{None}
    if name.kind == TOKEN_IDENT && parser_current_kind(&state) == TOKEN_IDENT {
        public_label = Val(CallLabel{name: name.payload.decoded, span: name.span})
        name = parser_bump(&state)
    }
    ty := Type.Named{name: ""}
    ty_span := name.span
    variadic := false
    variadic_bounds := [String]?{None}
    if {
        name.kind == TOKEN_SELF && parser_current_kind(&state) != TOKEN_COLON -> {
            // Sema supplies the receiver type from its owning declaration.
        }
        else -> {
            parser_expect(&state, TOKEN_COLON, "`:` and a type after the parameter name")
            cap_kind := parser_current_kind(&state)
            if cap_kind == TOKEN_AMP || cap_kind == TOKEN_CARET {
                cap :: parser_bump(&state)
                type_convention := AccessConvention.Move
                if cap.kind == TOKEN_AMP -> type_convention = AccessConvention.Write
                if convention != AccessConvention.Read {
                    leading_label :: if convention == AccessConvention.Write -> "the write-access marker `&`" else -> "the move marker `^`"
                    type_label :: if type_convention == AccessConvention.Write -> "the write-access marker `&`" else -> "the move marker `^`"
                    parser_add_error_code(&state, "E0029", name.span, "`{name.payload.text}` has two access markers", "{leading_label} before the parameter name conflicts with {type_label} on its type; a parameter can declare only one access marker", "keep one access marker on the type or receiver and remove the other")
                }
                convention = type_convention
            }
            if {
                parser_current_kind(&state) == TOKEN_DOT_DOT_DOT -> {
                    parser_bump(&state)
                    variadic = true
                    if {
                        parser_current_kind(&state) == TOKEN_LBRACKET -> {
                            parser_bump(&state)
                            bounds := [String]{}
                            if parser_current_kind(&state) != TOKEN_RBRACKET {
                                loop {
                                    bound :: parser_expect_name(&state, "in variadic trait bounds")
                                    &bounds.push(bound.payload.decoded)
                                    if parser_current_kind(&state) == TOKEN_RBRACKET -> break
                                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                                    parser_bump(&state)
                                }
                            }
                            close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after variadic bounds")
                            variadic_bounds = Val(bounds)
                            ty_span = parser_cover(name.span, close.span)
                        }
                        else -> {
                            parsed_type :: parser_parse_type(&state, 0)
                            ty = parsed_type.ty
                            ty_span = parsed_type.span
                        }
                    }
                }
                else -> {
                    parsed_type :: parser_parse_type(&state, 0)
                    ty = parsed_type.ty
                    ty_span = parsed_type.span
                }
            }
        }
    }
    // D-MEMPROVENANCE3=A: an optional `from src (| src)*` follows the type,
    // then the D-DEFAULT-SHAPE1=B default `{expr}`; the retired `= expr`
    // default is read once to teach E0385.
    declared_from := [String]?{None}
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "from" && (parser_kind_at(&state, 1) == TOKEN_IDENT || parser_kind_at(&state, 1) == TOKEN_SELF) {
        parser_bump(&state)
        sources := [String]{}
        loop {
            source :: parser_current(&state)
            if source.kind == TOKEN_SELF || (source.kind == TOKEN_IDENT && source.payload.decoded == "self") {
                parser_bump(&state)
                &sources.push("self")
            } else if source.kind == TOKEN_IDENT {
                parser_bump(&state)
                &sources.push(source.payload.decoded)
            } else {
                break
            }
            // A projection names a field of the source; the requirement keys
            // on the owner name only.
            loop parser_current_kind(&state) == TOKEN_DOT {
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_IDENT -> parser_bump(&state)
            }
            if parser_current_kind(&state) != TOKEN_PIPE -> break
            parser_bump(&state)
        }
        if sources.len() > 0 -> declared_from = Val(sources)
    }
    default := Expr?{None}
    if {
        parser_current_kind(&state) == TOKEN_LBRACE -> {
            parser_bump(&state)
            default = Val(parser_parse_expression(&state, 1, 0).expr)
            parser_expect(&state, TOKEN_RBRACE, "`}}` after the parameter default")
        }
        parser_current_kind(&state) == TOKEN_EQ -> {
            eq :: parser_bump(&state)
            parser_add_error_code(&state, "E0385", eq.span, "This declaration uses the retired `name: Type = value` default spelling.", "Declaration defaults ride the type as `name: Type{{value}}`; `=` remains for reassignment and extern slot fill.", "Write `name: Type{{value}}` for a declaration default, or keep `=` for reassignment and extern slot fill.")
            default = Val(parser_parse_expression(&state, 1, 0).expr)
        }
        else -> {}
    }
    if variadic && default != None {
        parser_add_error_code(&state, "E1310", name.span, "variadic parameter `{name.payload.decoded}` can't have a default value", "a `...` rest parameter collects trailing arguments — it can't also be optional", "remove the `{{…}}` default from the variadic parameter")
    }
    Param{convention: convention, root: root, name: name.payload.decoded, name_span: name.span, public_label: public_label, zone: zone, ty: ty, ty_span: ty_span, default: default, variadic: variadic, variadic_bound_list: variadic_bounds, declared_view_from_names: declared_from}
}

fn parser_parse_function(state: &JetParserState, modifiers: ParsedItemModifiers, body_required: Bool) -> ParsedFunction {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `fn`")
    func_name := name.payload.decoded
    func_name_span := name.span
    external_type := NamedSpan?{None}
    // Rust `func_after_fn`: `fn Type.method(` attaches an external method;
    // the retired `~~` connector teaches E0325 and recovers the same way.
    connector :: parser_current_kind(&state)
    if connector == TOKEN_DOT || (connector == TOKEN_TILDE_TILDE && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_kind_at(&state, 2) == TOKEN_LPAREN) {
        separator :: parser_bump(&state)
        if separator.kind == TOKEN_TILDE_TILDE -> parser_add_error_code(&state, "E0325", separator.span, "external methods attach with `.`, not `~~`", "the dot connector matches trait impls and ordinary member access", "write `fn {func_name}.method(...)`")
        method :: parser_expect_name(&state, "after `.` in an external method name")
        external_type = Val(NamedSpan{name: func_name, span: name.span})
        func_name = method.payload.decoded
        func_name_span = method.span
    }
    type_params := parser_parse_type_params(&state)
    // S83: one bare variant head, `Circle(r: Float)` or `Empty()`, in place
    // of the parameter list; its payload parameters feed sema's dispatch fold.
    head_pattern := Pattern?{None}
    params := [Param]{}
    if parser_current_kind(&state) == TOKEN_LPAREN && parser_kind_at(&state, 1) == TOKEN_IDENT && (parser_kind_at(&state, 2) == TOKEN_LPAREN || parser_kind_at(&state, 2) == TOKEN_RPAREN) {
        parser_bump(&state)
        variant :: parser_expect_name(&state, "for a multi-head variant")
        pattern_end := variant.span.end
        if parser_current_kind(&state) == TOKEN_LPAREN {
            params = parser_parse_param_list(&state)
            pattern_end = parser_lookahead(&state, -1).span.end
        }
        parser_expect(&state, TOKEN_RPAREN, "`)` after a multi-head variant")
        bindings := [PatSlot]{}
        loop param in params {
            if param.name == "_" {
                &bindings.push(PatSlot.Wildcard)
            } else {
                &bindings.push(PatSlot.Bind{name: param.name, span: param.name_span})
            }
        }
        head_pattern = Val(Pattern.Variant{variant: variant.payload.decoded, bindings: bindings, leading_dot: false, span: Span{start: variant.span.start, end: pattern_end}})
    } else {
        params = parser_parse_param_list(&state)
    }
    signature :: parser_parse_callable_result(&state)
    return_type := signature.return_type
    return_type_span := signature.return_type_span
    declared_effects := signature.effects
    effect_via := signature.via
    declared_return_view :: parser_parse_opt_declared_view_from(&state, parser_view_owner_names(params))
    post_effect := false
    if declared_effects == None && effect_via == None && parser_func_effect_starts_here(&state) {
        // D-SIG-AFTER1=A (card #4512): `-> T -[E]>` writes two arrows; the
        // result follows the one effect arrow instead (E0068).
        if signature.plain_arrow && parser_current_kind(&state) == TOKEN_MINUS && parser_kind_at(&state, 1) == TOKEN_LBRACKET {
            arrow_span :: parser_current(&state).span
            parser_add_error_code(&state, "E0068", arrow_span, "this callable puts the return type before the arrow", "a return type follows the one arrow, and a named function body uses braces", "write `fn name(...) -> Type {{ … }}`")
        }
        post_effect = true
        effects :: parser_parse_opt_func_effects(&state)
        declared_effects = effects.effects
        effect_via = effects.via
    }
    effect_body_marker :: post_effect || (return_type == None && (declared_effects != None || effect_via != None) && signature.prefix_effect)
    // D-SIG-SHAPE1=B: the colon before a bare result is not a signature form.
    if parser_current_kind(&state) == TOKEN_COLON {
        colon :: parser_bump(&state)
        if !parser_aborting(&state) {
            diagnostic :: diagnostic_from_registry("E0003", Val(colon.span), "a function return type uses `:`", "Jet uses `:` for parameter and field types; callable bodies use `->`", "replace `:` with `->` before the return type")
            &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: colon.span, new_text: "->"}))
        }
        if parser_type_starts_here(&state) {
            parsed :: parser_parse_type(&state, 0)
            return_type = Val(parsed.ty)
            return_type_span = Val(parsed.span)
        }
    }
    guest_import :: loop applied in modifiers.markers {
        if parser_marker_is_c_guest_import(applied) -> break true
    } ?? false
    is_ffi :: loop applied in modifiers.markers {
        if applied.name == "FFI" -> break true
    } ?? false
    // D-SIG-AFTER1=A (card #4512): a named function has one arrow, before its
    // result, and a braced body. A body `->` after the result, or an
    // expression right after the arrow, is E0080 and recovers to the same
    // body; the retired `=>` / `::` / `=` markers keep their own codes. An
    // `#FFI` function's body is its foreign source instead.
    marker_kind :: parser_current_kind(&state)
    marker_span :: parser_current(&state).span
    effect_body :: !is_ffi && effect_body_marker && marker_kind != TOKEN_UNIFIED_ARROW && marker_kind != TOKEN_LAMBDA_ARROW && marker_kind != TOKEN_COLON_COLON && marker_kind != TOKEN_EQ
    teach_arrow_body :: !guest_import && !signature.retired_shape
    arrow_marker :: !is_ffi && !effect_body && teach_arrow_body && marker_kind == TOKEN_UNIFIED_ARROW
    body_marker :: if {
        is_ffi -> false
        effect_body -> true
        else -> parser_parse_function_body_marker(&state, guest_import)
    }
    retired_body := Stmt?{None}
    value_body := false
    if arrow_marker && parser_current_kind(&state) == TOKEN_LBRACE -> parser_report_arrow_function_body(&state, marker_span)
    if body_marker && parser_current_kind(&state) != TOKEN_LBRACE {
        value_body = true
        if parser_function_body_missing(&state) {
            missing :: parser_current(&state).span
            parser_add_error_code(&state, "E0081", missing, "`fn {func_name}` has no body", "Jet functions are defined, not declared: a signature without `{{ … }}` is not a complete function. Host and FFI cells use `#Import` / `#FFI` with their required body form.", "Add a `{{ … }}` block.")
        } else {
            if arrow_marker -> parser_report_arrow_function_body(&state, marker_span)
            if effect_body && teach_arrow_body {
                body_span :: parser_current(&state).span
                parser_report_arrow_function_body(&state, body_span)
            }
            value :: parser_parse_expression(&state, 1, 0)
            parser_finish_statement(&state)
            retired_body = Val(Stmt.Expr{expr: value.expr})
        }
    }
    signature_end := parser_lookahead(&state, -1).span
    func := ast_func(func_name, func_name_span, start.span)
    func.is_pub = modifiers.is_pub
    func.is_package_pub = modifiers.is_package_pub
    func.is_comptime = modifiers.is_comptime
    func.is_sanitizer = modifiers.is_sanitizer
    func.external_type = external_type
    func.type_params = type_params
    func.params = params
    func.return_type = return_type
    func.return_type_span = return_type_span
    func.declared_effects = declared_effects
    func.effect_via = effect_via
    func.declared_return_view_provenance = declared_return_view
    if declared_effects == .Val(row) {
        if row.len() == 0 -> func.is_pure = true
    }
    func.head_pattern = head_pattern
    func.markers = modifiers.markers
    parser_apply_function_markers(&state, &func, modifiers.markers)
    has_body := false
    if {
        is_ffi -> {
            func.inline_foreign = parser_parse_inline_foreign_body(&state, modifiers.markers)
            func.span = parser_cover(modifiers.start_span, parser_lookahead(&state, -1).span)
            has_body = true
        }
        parser_current_kind(&state) == TOKEN_LBRACE -> {
            body :: parser_parse_callable_body(&state, parser_return_type_has_value(return_type))
            func.body = body.statements
            func.span = parser_cover(modifiers.start_span, body.span)
            has_body = true
        }
        else -> {
            if retired_body == .Val(statement) {
                func.body = [Stmt]{statement}
                has_body = true
            }
            if body_required && !has_body && !value_body {
                body_span :: parser_current(&state).span
                parser_add_error_code(&state, "E0081", body_span, "`fn {func_name}` has no body", "Jet functions are defined, not declared: a signature without `{{ … }}` is not a complete function. Host and FFI cells use `#Import` / `#FFI` with their required body form.", "Add a `{{ … }}` block.")
            }
            if parser_current_kind(&state) == TOKEN_SEMI -> signature_end = parser_bump(&state).span
            func.span = parser_cover(modifiers.start_span, signature_end)
        }
    }
    if guest_import && !is_ffi -> parser_bind_guest_import_symbol(&state, &func)
    ParsedFunction{value: func, has_body: has_body}
}

// Rust `is_c_guest_import_marker`: the per-callable C import `#Import(c)`.
// Declared infallible: it is called inside the `guest_import` loop
// expression, which would otherwise carry its failure into the parser.
fn parser_marker_is_c_guest_import(marker: Marker) -> Bool Never! {
    if marker.negated || marker.name != "Import" -> return false
    first :: parser_marker_first_expr(marker) ?? return false
    if first == .Ident(name, _) -> return name == "c"
    false
}

// D-ADOPT-GUEST1=A (Rust `guest_import_fn_from_markers`): the one string body
// of an `#Import(c)` function names its C symbol. The symbol moves into the
// marker's compile-time fact and the Jet body is cleared, so it never reaches
// expression checking or codegen.
fn parser_bind_guest_import_symbol(state: &JetParserState, func: &Func) {
    symbol := ""
    error_span := func.span
    if func.body.len() == 1 && func.body[0] == .Expr(value) && value == .Str(parts, span) {
        error_span = span
        if parts.len() == 1 && parts[0] == .Lit(text) -> symbol = text
    }
    if symbol == "" {
        parser_add_error_code(&state, "E3212", error_span, "a `#Import(c)` declaration needs one non-empty symbol string", "the Jet signature is checked by sema and the string after `=` names the stable C symbol", "write `#Import(c) fn name(args) Return = \"c_symbol\"`")
        return
    }
    loop index in 0..<func.markers.len() {
        if parser_marker_is_c_guest_import(func.markers[index]) {
            func.markers[index].ct = Val(CtValue.Str{value: symbol})
            break
        }
    }
    func.body = [Stmt]{}
}

pub struct ParsedFuncEffects {
    pub effects: [EffectRowEntry]?
    pub via: NamedSpan?
}

pub struct ParsedCallableResult {
    pub return_type: Type?
    pub return_type_span: Span?
    pub effects: [EffectRowEntry]?
    pub via: NamedSpan?
    pub prefix_effect: Bool
    // A retired bare result before the arrow (E0068) already teaches the
    // whole `-> Type { … }` shape; the arrow-body codes stay quiet then.
    pub retired_shape: Bool
    // The result follows a plain `->` (not an effect arrow or a bare `E!`).
    pub plain_arrow: Bool
}

// The start of an effect arrow: canonical `-[`, or a retired `:[`, `=[`,
// `#(` or `--` that is still read so it can be taught (E0066).
fn parser_func_effect_starts_here(state: &JetParserState) -> Bool Never! {
    first :: parser_current_kind(&state)
    second :: parser_kind_at(&state, 1)
    ((first == TOKEN_MINUS || first == TOKEN_COLON || first == TOKEN_EQ) && second == TOKEN_LBRACKET) || (first == TOKEN_HASH && second == TOKEN_LPAREN) || first == TOKEN_MINUS_MINUS
}

fn parser_report_retired_effect_syntax(state: &JetParserState, span: Span) {
    parser_add_error_code(&state, "E0066", span, "this function uses the retired effect-arrow spelling", "callable results use `->`, and an explicit effect ceiling uses the same arrow", "write `-[Effects]>`; use `-[]>` for an explicit purity bound")
}

// D-EFF1 / D-EFF2 / D-SHAPE8 / D-ARROW-RESPELL1: the effect arrow after a
// callable's parameters, a declared bound `-[Net, DB]>` or the `-[via f]>`
// pass-through. Both halves are None when no effect arrow starts here.
fn parser_parse_opt_func_effects(state: &JetParserState) -> ParsedFuncEffects {
    first :: parser_current_kind(&state)
    second :: parser_kind_at(&state, 1)
    canonical :: first == TOKEN_MINUS && second == TOKEN_LBRACKET
    retired_colon :: first == TOKEN_COLON && second == TOKEN_LBRACKET
    retired_eq :: first == TOKEN_EQ && second == TOKEN_LBRACKET
    retired_hash :: first == TOKEN_HASH && second == TOKEN_LPAREN
    if !canonical && !retired_colon && !retired_eq && !retired_hash && first != TOKEN_MINUS_MINUS -> return ParsedFuncEffects{effects: None, via: None}
    start :: parser_bump(&state)
    if !canonical -> parser_report_retired_effect_syntax(&state, start.span)
    close :: if retired_hash -> TOKEN_RPAREN else -> TOKEN_RBRACKET
    close_arrow :: if {
        canonical || retired_colon -> TOKEN_GT
        retired_eq -> TOKEN_LAMBDA_ARROW
        else -> TOKEN_UNIFIED_ARROW
    }
    if retired_hash {
        parser_expect(&state, TOKEN_LPAREN, "`(` to start an effect row")
    } else {
        parser_expect(&state, TOKEN_LBRACKET, "`[` to start an effect row")
    }
    close_text :: if retired_hash -> "`)` to close the effect row" else -> "`]` to close the effect row"
    via :: parser_current(&state)
    if via.kind == TOKEN_IDENT && via.payload.decoded == "via" {
        parser_bump(&state)
        param :: parser_expect_name(&state, "for the callback parameter name after `via`")
        parser_expect(&state, close, close_text)
        parser_finish_effect_arrow(&state, close_arrow, retired_hash, canonical, start.span)
        return ParsedFuncEffects{effects: None, via: Val(NamedSpan{name: param.payload.decoded, span: param.span})}
    }
    effects :: parser_parse_effect_row_entries(&state, close)
    parser_expect(&state, close, close_text)
    parser_finish_effect_arrow(&state, close_arrow, retired_hash, canonical, start.span)
    ParsedFuncEffects{effects: Val(effects), via: None}
}

fn parser_finish_effect_arrow(state: &JetParserState, close_arrow: Int, retired_hash: Bool, canonical: Bool, start: Span) {
    if retired_hash {
        if parser_at_unified_arrow(&state) -> parser_bump(&state)
        return
    }
    if parser_current_kind(&state) == TOKEN_GT {
        parser_bump(&state)
        return
    }
    if canonical && parser_at_unified_arrow(&state) {
        parser_bump(&state)
        parser_report_retired_effect_syntax(&state, start)
        return
    }
    arrow_text :: if close_arrow == TOKEN_LAMBDA_ARROW -> "`=>`" else -> "`->`"
    _ := parser_expect(&state, close_arrow, "{arrow_text} after the effect row")
}

// The entries of an effect row up to (not including) `close`: effect paths,
// `!Effect` prohibitions (D-PROP2=A) and `..Name` open rows.
fn parser_parse_effect_row_entries(state: &JetParserState, close: Int) -> [EffectRowEntry] {
    effects := [EffectRowEntry]{}
    loop parser_current_kind(&state) != close && !parser_aborting(&state) {
        if parser_current_kind(&state) == TOKEN_DOT_DOT {
            parser_bump(&state)
            open_name :: parser_expect_name(&state, "for an open effect-row name")
            &effects.push(EffectRowEntry{name: "..{open_name.payload.decoded}", span: open_name.span})
        } else {
            prohibited :: parser_current_kind(&state) == TOKEN_BANG
            if prohibited -> parser_bump(&state)
            entry :: parser_expect_effect_path_name(&state)
            if !prohibited && entry.name.contains("(") {
                parser_add_fatal_code(&state, "E0119", entry.span, "`{entry.name}` is only valid as a memory denial", "the `above: Bytes` argument parameterizes a prohibition, not a positive effect bound", "write `-[!{entry.name}]>`")
                break
            }
            name :: if prohibited -> "!{entry.name}" else -> entry.name
            &effects.push(EffectRowEntry{name: name, span: entry.span})
        }
        if parser_current_kind(&state) == close -> break
        parser_expect(&state, TOKEN_COMMA, "`,` between effects in the row")
    }
    effects
}

// D-EFFTREE1 / D-AUTHORITY-MEM2: an effect path `ident (.ident)*`; the one
// parameterized entry is the bounded memory denial `Mem.Alloc(above: N)`.
fn parser_expect_effect_path_name(state: &JetParserState) -> NamedSpan {
    first :: parser_expect_name(&state, "for an effect name")
    name := first.payload.decoded
    end := first.span.end
    loop parser_current_kind(&state) == TOKEN_DOT && !parser_aborting(&state) {
        parser_bump(&state)
        segment :: parser_expect_name(&state, "for an effect path segment after `.`")
        name = "{name}.{segment.payload.decoded}"
        end = segment.span.end
    }
    if name == "Mem.Alloc" && parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        label :: parser_expect_name(&state, "for the memory denial argument name")
        if label.payload.decoded != "above" {
            parser_add_fatal_code(&state, "E0119", label.span, "`Mem.Alloc` does not accept the argument `{label.payload.decoded}`", "the bounded memory denial has one closed argument: `above: Bytes`", "write `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        parser_expect(&state, TOKEN_COLON, "`:` after `above`")
        value :: parser_bump(&state)
        if value.kind != TOKEN_INT {
            parser_add_fatal_code(&state, "E0119", value.span, "`Mem.Alloc(above: …)` needs an integer byte ceiling", "the bounded denial is checked at compile time and accepts a positive byte count", "write `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        bytes :: value.payload.integer ?? 0
        if bytes <= 0 {
            parser_add_fatal_code(&state, "E0119", value.span, "`Mem.Alloc(above: …)` needs a positive byte ceiling", "zero cannot bound a usable memory region", "write a positive byte count, such as `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after the memory denial argument")
        name = "{name}(above: {bytes})"
        end = close.span.end
    }
    NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
}

fn parser_type_starts_here(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    kind == TOKEN_BANG || parser_type_starts(kind)
}

fn parser_is_unit_fallible(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) -> return ok == (Type.Named{name: "Unit"})
    false
}

// D-TYPE-SUFFIX1=A: a unit-fallible result written after the parameters
// (`IOError!`, `(A | B)!`); a retired prefix `!IOError` is read to teach it.
fn parser_parse_unit_fallible_return(state: &JetParserState) -> ParsedType? {
    start :: parser_current(&state).span
    if parser_current_kind(&state) != TOKEN_BANG && parser_suffix_contract_ahead(&state) < 0 -> return None
    error_type :: if {
        parser_current_kind(&state) == TOKEN_BANG -> {
            bang :: parser_bump(&state)
            parser_parse_retired_prefix_error(&state, bang.span, 1)
        }
        else -> parser_parse_suffix_contract(&state, 1)
    }
    Val(ParsedType{ty: Type.Result{ok: Type.Named{name: "Unit"}, err: error_type.ty}, span: parser_cover(start, error_type.span)})
}

// D-SIG-AFTER1=A: a result after `->` or `-[E]>` is a type only when a
// declaration-body boundary follows it, so `-> n * 2` stays an expression.
fn parser_result_type_follows_arrow(state: &JetParserState) -> Bool {
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    saved_type_gt :: state.pending_type_gt
    saved_type_gt_span :: Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.end}
    saved_semicolon :: state.explicit_semicolon_reported
    parsed :: parser_parse_type(&state, 0)
    failed :: parser_aborting(&state) && state.abort_mark > saved_diagnostics
    next :: parser_current(&state)
    kind :: next.kind
    // `-> T -[E]>` also ends the result: a second (effect) arrow, E0068 at the
    // caller. A one-line trait slot ends at the enclosing `}`.
    boundary :: kind == TOKEN_COLON_COLON || kind == TOKEN_EQ || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LAMBDA_ARROW || kind == TOKEN_SEMI || kind == TOKEN_COMMA || kind == TOKEN_RPAREN || (kind == TOKEN_LBRACE && parsed.span.end < next.span.start) || (kind == TOKEN_IDENT && next.payload.decoded == "from") || (kind == TOKEN_MINUS && parser_kind_at(&state, 1) == TOKEN_LBRACKET) || kind == TOKEN_RBRACE
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    state.pending_type_gt = saved_type_gt
    state.pending_type_gt_span = saved_type_gt_span
    state.explicit_semicolon_reported = saved_semicolon
    !failed && boundary
}

// D-SIG-AFTER1=A: the result after the one arrow. Current forms are `-> T`,
// `-[E]> T`, unit `-[E]>` and unit-fallible `E!`; a bare type after `)` is
// the retired shape (E0068). A `->` with no type after it is left for the
// body parser, so `fn f() -> expr` still reads as a one-line body.
fn parser_parse_callable_result(state: &JetParserState) -> ParsedCallableResult {
    prefix_effect :: parser_func_effect_starts_here(&state)
    effects :: parser_parse_opt_func_effects(&state)
    arrow_return := false
    retired_shape := false
    plain_arrow := false
    result := ParsedType?{None}
    if {
        effects.effects != None || effects.via != None -> {
            arrow_return = true
            result = if parser_result_type_follows_arrow(&state) -> Val(parser_parse_type(&state, 0)) else -> parser_parse_unit_fallible_return(&state)
        }
        parser_at_unified_arrow(&state) -> {
            before :: state.position
            parser_bump(&state)
            if parser_result_type_follows_arrow(&state) {
                arrow_return = true
                plain_arrow = true
                result = Val(parser_parse_type(&state, 0))
            } else {
                result = parser_parse_unit_fallible_return(&state)
                if parser_has_type(result) {
                    arrow_return = true
                    plain_arrow = true
                } else {
                    state.position = before
                }
            }
        }
        else -> {
            result = parser_parse_unit_fallible_return(&state)
            if !parser_has_type(result) && parser_type_starts_here(&state) {
                parsed :: parser_parse_type(&state, 0)
                parser_add_error_code(&state, "E0068", parsed.span, "this callable puts the return type before the arrow", "a return type follows the one arrow, and a named function body uses braces", "write `fn name(...) -> Type {{ … }}`")
                retired_shape = true
                result = Val(parsed)
            }
        }
    }
    return_type := Type?{None}
    return_type_span := Span?{None}
    if result == .Val(parsed) {
        return_type = Val(parsed.ty)
        return_type_span = Val(parsed.span)
        if arrow_return && parser_is_unit_fallible(parsed.ty) {
            parser_add_error_code(&state, "E0003", parsed.span, "this unit-fallible signature uses the retired arrow-and-unit form", "a function that can fail but returns no value has no result payload for an arrow to introduce", "write `fn save(path: String) IOError!`, or omit the contract for implicit `Err`")
        }
    }
    ParsedCallableResult{return_type: return_type, return_type_span: return_type_span, effects: effects.effects, via: effects.via, prefix_effect: prefix_effect, retired_shape: retired_shape, plain_arrow: plain_arrow}
}

// The marker that opens a recovered one-line function body. A `->` here is
// E0080 at the caller (card #4512); `=>` teaches `->` (E0070) and `::` / `=`
// teach braces (E0065), except that an `#Import(c)` function binds its C
// symbol with `=`, where a `->` is the wrong marker (E3261).
fn parser_parse_function_body_marker(state: &JetParserState, guest_import: Bool) -> Bool {
    token :: parser_current(&state)
    if token.kind == TOKEN_UNIFIED_ARROW {
        parser_bump(&state)
        if guest_import {
            parser_add_error_code(&state, "E3261", token.span, "`#Import(c)` function uses a non-canonical body marker", "`#Import(c)` binds a compile-time C symbol; `->` is a Jet function-body marker and cannot declare a foreign symbol", "write `#Import(c) fn name(args) Return = \"symbol\"`")
        }
        return true
    }
    if token.kind == TOKEN_LAMBDA_ARROW {
        parser_bump(&state)
        parser_report_retired_arrow(&state, token.span)
        return true
    }
    if token.kind != TOKEN_COLON_COLON && token.kind != TOKEN_EQ -> return false
    parser_bump(&state)
    if token.kind == TOKEN_COLON_COLON || !guest_import {
        parser_add_error_code(&state, "E0065", token.span, "This function uses the retired `{token.payload.text}` body marker.", "Named function bodies use braces. `::` binds a name, and `=` fills a slot inside a definition.", "Replace `{token.payload.text}` with `{{ … }}`; `jet fmt` applies this fix.")
    }
    true
}

// D-SIG-AFTER1=A (card #4512): E0080 for a named function body after an arrow.
fn parser_report_arrow_function_body(state: &JetParserState, span: Span) {
    parser_add_error_code(&state, "E0080", span, "This named function body follows an arrow instead of braces.", "A named function has one arrow, `->` or `-[Effects]>`, followed by its optional return type; the body always sits in braces: `fn name(...) -> Type {{ … }}`.", "Replace `-> expr` with `{{ expr }}`; `jet fmt` applies this fix.")
}

// D-FFI-INLINE1=A (card #501): a `#FFI(<lang>) fn` body is exactly one
// non-interpolated string of foreign source; anything else is E0064. The
// braced body follows the one arrow and its result; a second `->` is E0080.
fn parser_parse_inline_foreign_body(state: &JetParserState, markers: [Marker]) -> InlineForeign? {
    ffi := markers[0]
    loop applied in markers {
        if applied.name == "FFI" -> ffi = applied
    }
    lang := ""
    lang_span := ffi.span
    if parser_marker_first_expr(ffi) == .Val(argument) {
        if argument == .Ident(name, span) {
            lang = name
            lang_span = span
        }
    }
    if lang == "" {
        parser_add_fatal_code(&state, "E0930", ffi.span, "`#FFI` arguments do not match its registered signature", "marker arguments use the same call grammar and typed signature as function arguments", "match the registered marker signature")
        return None
    }
    if parser_current_kind(&state) == TOKEN_UNIFIED_ARROW {
        arrow_span :: parser_bump(&state).span
        parser_report_arrow_function_body(&state, arrow_span)
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` to open the `#FFI` foreign-source body")
    parser_skip_semicolons(&state)
    source :: parser_current(&state)
    plain :: source.kind == TOKEN_RAW_STRING || (source.kind == TOKEN_STRING && source.payload.interpolations == 0)
    if source.kind == TOKEN_STRING || source.kind == TOKEN_RAW_STRING -> parser_bump(&state)
    if !plain {
        error_span :: if source.kind == TOKEN_STRING -> source.span else -> ffi.span
        parser_add_fatal_code(&state, "E0064", error_span, "a `#FFI({lang})` function body must be one string of {lang} source", "the inline foreign tier carries the foreign source as a single `\"\"\"…\"\"\"` string; the Jet signature above is the checked contract (D-FFI-INLINE1)", "write the body as `{{ \"\"\"<{lang} source>\"\"\" }}` — one string literal, no other statements or interpolation")
        return None
    }
    parser_skip_semicolons(&state)
    parser_expect(&state, TOKEN_RBRACE, "`}}` to close the `#FFI` foreign-source body")
    Val(InlineForeign{lang: lang, lang_span: lang_span, marker_span: ffi.span, source: source.payload.decoded, source_span: source.span})
}

// D-MEMPROVENANCE3=A: an optional `from src (| src)*` or `from (slot: srcs, …)`
// after a return type. A source names one of `owners` (the non-`self`
// parameters, by position), the receiver `self`, or `static.path.Name`,
// optionally projected through fields.
fn parser_parse_opt_declared_view_from(state: &JetParserState, owners: [String]) -> ViewProvenanceMap? {
    token :: parser_current(&state)
    if !(token.kind == TOKEN_IDENT && token.payload.decoded == "from") -> return None
    next :: parser_kind_at(&state, 1)
    if next != TOKEN_IDENT && next != TOKEN_SELF && next != TOKEN_LPAREN -> return None
    parser_bump(&state)
    if parser_current_kind(&state) != TOKEN_LPAREN {
        sources :: parser_parse_declared_view_sources(&state, owners)
        return Val(ViewProvenanceMap{entries: [ViewProvenanceEntry]{ViewProvenanceEntry{slot: [String]{}, value: ViewProvenance{sources: sources, mutable: false}}}})
    }
    parser_bump(&state)
    entries := [ViewProvenanceEntry]{}
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_RPAREN || kind == TOKEN_EOF -> break
        if kind != TOKEN_IDENT {
            parser_bump(&state)
            break
        }
        slot :: parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_COLON -> break
        parser_bump(&state)
        sources :: parser_parse_declared_view_sources(&state, owners)
        &entries.push(ViewProvenanceEntry{slot: [String]{slot.payload.decoded}, value: ViewProvenance{sources: sources, mutable: false}})
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    if parser_current_kind(&state) == TOKEN_RPAREN -> parser_bump(&state)
    Val(ViewProvenanceMap{entries: entries})
}

fn parser_parse_declared_view_sources(state: &JetParserState, owners: [String]) -> [ViewSourcePath] {
    sources := [ViewSourcePath]{}
    loop {
        parsed :: parser_parse_declared_view_source(&state, owners)
        if parsed == .Val(path) {
            &sources.push(path)
        } else {
            break
        }
        if parser_current_kind(&state) != TOKEN_PIPE -> break
        parser_bump(&state)
    }
    sources
}

fn parser_parse_declared_view_source(state: &JetParserState, owners: [String]) -> ViewSourcePath? {
    token :: parser_current(&state)
    source := ViewSource.Receiver
    if {
        token.kind == TOKEN_SELF || (token.kind == TOKEN_IDENT && token.payload.decoded == "self") -> parser_bump(&state)
        token.kind == TOKEN_IDENT && token.payload.decoded == "static" -> {
            parser_bump(&state)
            if parser_current_kind(&state) != TOKEN_DOT -> return None
            parser_bump(&state)
            if parser_current_kind(&state) != TOKEN_IDENT -> return None
            module_path := ""
            name := parser_bump(&state).payload.decoded
            loop parser_current_kind(&state) == TOKEN_DOT {
                parser_bump(&state)
                if parser_current_kind(&state) != TOKEN_IDENT -> break
                module_path = if module_path == "" -> name else -> "{module_path}.{name}"
                name = parser_bump(&state).payload.decoded
            }
            source = ViewSource.Static{module_path: module_path, name: name}
        }
        token.kind == TOKEN_IDENT -> {
            parser_bump(&state)
            index := -1
            loop position in 0..<owners.len() {
                if owners[position] == token.payload.decoded {
                    index = position
                    break
                }
            }
            if index < 0 -> return None
            source = ViewSource.Parameter{index: index}
        }
        else -> return None
    }
    projections := [ViewSourceProjection]{}
    loop parser_current_kind(&state) == TOKEN_DOT {
        parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_IDENT -> break
        field :: parser_bump(&state)
        &projections.push(ViewSourceProjection.Field{name: field.payload.decoded})
    }
    Val(ViewSourcePath{source: source, projections: projections})
}

// The parameters a declared view source may name: every one but the receiver.
fn parser_view_owner_names(params: [Param]) -> [String] Never! {
    owners := [String]{}
    loop param in params {
        if param.name != "self" -> &owners.push(param.name)
    }
    owners
}

// A one-line body is missing when the next token already starts another
// declaration or closes the enclosing scope (`#Todo` is a value body).
fn parser_function_body_missing(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_HASH -> return !(parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == "Todo")
    kind == TOKEN_KW_FN || kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_USE || kind == TOKEN_KW_EXTERN || kind == TOKEN_EOF || kind == TOKEN_RBRACE || kind == TOKEN_SEMI
}

// A unit or unit-fallible (`E!`) result carries no value, so the body's final
// line stays a statement.
fn parser_return_type_has_value(return_type: Type?) -> Bool Never! {
    ty :: return_type ?? return false
    if ty == {
        .Named(name) -> name != "Unit"
        .Result(ok, _) -> ok != (Type.Named{name: "Unit"})
        else -> true
    }
}

// Rust `apply_callable_markers`: the typed projections of the function rules.
// The marker list itself stays on the function. Retired spellings (`#Pure`,
// `#Sanitizer`, `#InlineAlways`) project nothing; sema teaches their
// replacement (E0927).
fn parser_apply_function_markers(state: &JetParserState, func: &Func, markers: [Marker]) {
    loop marker in markers {
        if marker.name == {
            "Unsafe" -> {
                func.is_unsafe = true
                func.unsafe_span = Val(marker.span)
                first := parser_marker_first_expr(marker)
                if first == .Val(reason) -> func.unsafe_reason = parser_expr_literal_string(reason)
            }
            "Reactive" -> {
                if marker.args.len() == 0 -> func.is_reactive = true
            }
            "Replayable" -> {
                if marker.args.len() == 0 {
                    func.is_replayable = true
                    func.replayable_span = Val(marker.span)
                }
            }
            "MustUse" -> {
                if marker.args.len() == 0 {
                    func.is_must_use = true
                    func.must_use_span = Val(marker.span)
                }
            }
            // D-TAG-SURFACE1=A: `#Scrub(Tag)` names the one fact tag removed.
            "Scrub" -> {
                if parser_marker_bindings(marker, [String]{"tag"}) == .Val(values) && values[0] == .Val(written) && written == .Ident(name, _) -> func.scrub_tag = Val(name)
            }
            // D-METHODMACRO1=A: bare `#Inline` is a hint; `#Inline(Always)`
            // is the checked promise. A written `Hint` or `Never` mode is
            // E0930 here (Rust `apply_callable_markers`); sema's menu check
            // reports any other value.
            "Inline" -> {
                func.inline_span = Val(marker.span)
                mode := Expr?{None}
                if parser_marker_bindings(marker, [String]{"mode"}) == .Val(values) -> mode = values[0]
                if mode == {
                    .Val(value) -> {
                        variant :: parser_marker_enum_variant(value)
                        if {
                            variant == "Always" -> func.is_inline_always = true
                            variant == "Hint" || variant == "Never" -> parser_marker_shape_error(&state, marker)
                            else -> {}
                        }
                    }
                    else -> func.is_inline = true
                }
            }
            else -> {}
        }
    }
    // D-TASKS-LIST1=A: `#Job` metadata and its `#Every` schedule (E0925).
    _ := parser_project_function_job_markers(&state, &func, markers)
}

fn parser_parse_struct(state: &JetParserState, modifiers: ParsedItemModifiers) -> StructDef {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `struct`")
    value := ast_struct(name.payload.decoded, name.span, start.span)
    // D-AUTODERIVE1=E: a parsed declaration starts on the package default
    // (Rust parser `auto_derive_default: true`); signed markers decide each trait.
    value.auto_derive_default = true
    value.is_pub = modifiers.is_pub
    value.is_package_pub = modifiers.is_package_pub
    value.type_params = parser_parse_type_params(&state)
    value.type_markers = modifiers.markers
    parser_apply_type_markers(&value, modifiers.markers)
    if parser_current_kind(&state) != TOKEN_LBRACE {
        parser_add_error_here(&state, "expected `{{` before struct fields", "record fields are declared inside a struct body", "open a struct body with `{{`")
        return value
    }
    parser_bump(&state)
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF && !parser_aborting(&state) {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        member_start :: state.position
        member_modifiers := parser_parse_item_modifiers(&state, false)
        if parser_state_section_ahead(&state) {
            section := parser_parse_state_section(&state, name.payload.decoded, name.span)
            if value.state == {
                .None -> value.state = Val(section)
                else -> parser_report_repeated_state_section(&state, section, name.payload.decoded)
            }
            if parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
            next
        }
        if parser_take_prep_fn(&state) -> member_modifiers.is_comptime = true
        // D-CLI-GLOBAL1=E (Rust `cli_binding_starts_here` / `cli_binding`):
        // `name = callable` binds a program-struct command to a function; it
        // is a command member, never a stored field.
        if parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_EQ {
            command_name :: parser_bump(&state)
            parser_bump(&state)
            target :: parser_parse_expression(&state, 1, 0)
            &value.cli_bindings.push(CLICommandBinding{name: command_name.payload.decoded, name_span: command_name.span, markers: member_modifiers.markers, target: target.expr})
            if parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
            next
        }
        if parser_current_kind(&state) == {
            TOKEN_KW_FN -> {
                method :: parser_parse_function(&state, member_modifiers, true)
                &value.methods.push(method.value)
            }
            TOKEN_KW_IMPL -> &value.trait_impls.push(parser_parse_trait_impl_block(&state))
            TOKEN_KW_DERIVE -> parser_report_retired_derive_line(&state)
            else -> {
                field_markers := member_modifiers.markers
                field_pub := member_modifiers.is_pub
                field_package_pub := member_modifiers.is_package_pub
                field_name :: parser_expect_name(&state, "in a struct field")
                parser_expect(&state, TOKEN_COLON, "`:` after a struct field name")
                field_type :: parser_parse_type(&state, 0)
                computed := Expr?{None}
                default := Expr?{None}
                default_kind := parser_current_kind(&state)
                if {
                    default_kind == TOKEN_COLON_EQ || default_kind == TOKEN_EQ -> {
                        parser_bump(&state)
                        parsed_value :: parser_parse_expression(&state, 1, 0)
                        default = Val(parsed_value.expr)
                    }
                    parser_current_kind(&state) == TOKEN_LBRACE -> {
                        parser_bump(&state)
                        parsed_value :: parser_parse_expression(&state, 1, 0)
                        parser_expect(&state, TOKEN_RBRACE, "`}}` after a struct field default")
                        default = Val(parsed_value.expr)
                    }
                }
                redact := false
                marker_index := 0
                loop marker_index < field_markers.len() {
                    if field_markers[marker_index].name == "Redact" -> redact = true
                    if field_markers[marker_index].name == "Computed" {
                        first := parser_marker_first_expr(field_markers[marker_index])
                        if first == .Val(computed_expr) -> computed = Val(computed_expr)
                    }
                    marker_index += 1
                }
                &value.fields.push(Field{is_pub: field_pub, is_package_pub: field_package_pub, name: field_name.payload.decoded, name_span: field_name.span, ty: field_type.ty, ty_span: field_type.span, serde_markers: field_markers, redact: redact, computed: computed, default: default, default_ct: None})
                separator_kind := parser_current_kind(&state)
                if separator_kind == TOKEN_COMMA || separator_kind == TOKEN_SEMI -> parser_bump(&state)
            }
        }
        // A member's own separator is optional (a field may end at `}`), so
        // only a member that consumed nothing is reported and skipped.
        if state.position == member_start && !parser_aborting(&state) {
            parser_add_error_here(&state, "expected a separator between struct members", "struct fields and methods are separated by commas or statement terminators", "add a separator or close the struct")
            parser_recover_statement(&state)
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after struct fields")
    value.span = parser_cover(modifiers.start_span, close.span)
    value
}

fn parser_parse_enum(state: &JetParserState, modifiers: ParsedItemModifiers) -> EnumDef {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `enum`")
    value := ast_enum(name.payload.decoded, name.span, start.span)
    // D-AUTODERIVE1=E: as for structs, the package default applies.
    value.auto_derive_default = true
    value.is_pub = modifiers.is_pub
    value.is_package_pub = modifiers.is_package_pub
    value.type_params = parser_parse_type_params(&state)
    value.type_markers = modifiers.markers
    index := 0
    loop index < modifiers.markers.len() {
        marker :: modifiers.markers[index]
        if marker.name == "SingleUse" {
            value.is_single_use = true
            value.single_use_span = Val(marker.span)
        }
        if marker.name == "MustUse" {
            value.is_must_use = true
            value.must_use_span = Val(marker.span)
        }
        index += 1
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` before enum variants")
    // A fatal error ends the whole enum, as Rust's `?` does; the item loop
    // resynchronizes.
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF && !parser_aborting(&state) {
        if parser_current_kind(&state) == TOKEN_SEMI {
            parser_bump(&state)
            next
        }
        if parser_state_section_ahead(&state) {
            section_start :: parser_current(&state).span
            section := parser_parse_state_section(&state, "", section_start)
            parser_report_ineligible_state_section(&state, section, "enum")
            next
        }
        if parser_method_starts_here(&state) {
            &value.methods.push(parser_parse_type_method(&state))
            next
        }
        kind :: parser_current_kind(&state)
        markers :: if kind == TOKEN_HASH -> parser_parse_variant_markers(&state) else -> [Marker]{}
        if {
            kind == TOKEN_KW_DERIVE -> parser_report_retired_derive_line(&state)
            kind == TOKEN_KW_IMPL -> &value.trait_impls.push(parser_parse_trait_impl_block(&state))
            else -> parser_parse_variant_entry(&state, "", &value, markers)
        }
        if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after enum variants")
    value.span = parser_cover(modifiers.start_span, close.span)
    value
}

// A method inside a type body: `fn`, `prep fn`, or `pub prep fn`.
fn parser_method_starts_here(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_KW_FN || parser_prep_fn_ahead(&state) || (parser_current_kind(&state) == TOKEN_KW_PUB && parser_prep_verb_ahead(&state, 1, TOKEN_KW_FN))
}

fn parser_parse_type_method(state: &JetParserState) -> Func {
    modifiers := parser_parse_item_modifiers(&state, false)
    if parser_take_prep_fn(&state) -> modifiers.is_comptime = true
    parser_parse_function(&state, modifiers, true).value
}

// D-SERDE5/7 + D-SHAPE2: the markers on one variant, bare `#Name` markers or
// `#[…]` lists; two distinct rules belong in one list (E0999).
fn parser_parse_variant_markers(state: &JetParserState) -> [Marker] {
    markers := [Marker]{}
    chunks := 0
    bracket_chunks := 0
    sequence := parser_current(&state).span
    loop parser_current_kind(&state) == TOKEN_HASH && !parser_aborting(&state) {
        if parser_kind_at(&state, 1) == TOKEN_LBRACKET {
            group :: parser_parse_marker_group_list(&state)
            loop marker in group.markers -> &markers.push(marker)
            sequence.end = group.span.end
            bracket_chunks += 1
        } else {
            marker :: parser_parse_marker(&state)
            &markers.push(marker)
            sequence.end = marker.span.end
            parser_skip_semicolons(&state)
        }
        chunks += 1
    }
    parser_report_adjacent_markers(&state, markers, chunks, bracket_chunks, sequence, "variant")
    markers
}

// D-TAG1: one enum-body entry, a leaf variant or a variant group
// `Name { … }`. Leaves are recorded flat with their full dotted path and each
// group path in `groups`; groups nest to any depth. Payloads live on leaves
// only (E0331).
fn parser_parse_variant_entry(state: &JetParserState, prefix: String, value: &EnumDef, markers: [Marker]) {
    name :: parser_expect_name(&state, "for a variant name")
    if parser_aborting(&state) -> return
    path :: if prefix.len() == 0 -> name.payload.decoded else -> "{prefix}.{name.payload.decoded}"
    payload := VariantPayload.Unit
    if parser_current_kind(&state) == TOKEN_LPAREN {
        open :: parser_bump(&state)
        parsed :: parser_parse_variant_payload(&state)
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after a variant's payload")
        if parser_current_kind(&state) == TOKEN_LBRACE {
            parser_add_error_code(&state, "E0331", parser_cover(open.span, close.span), "group `{path}` can't carry a payload", "a variant group only names its subtree — data lives on the leaf variants (D-TAG1)", "move the payload onto the leaf variants inside the `{{ }}`, or remove the `(...)`")
        } else {
            payload = parsed
        }
    }
    discriminant := Int?{None}
    discriminant_expr := Expr?{None}
    if parser_current_kind(&state) == TOKEN_EQ {
        parser_bump(&state)
        expression :: parser_parse_expression(&state, 1, 0)
        discriminant_expr = Val(expression.expr)
        if expression.expr == .Int(number, _, _, _) -> discriminant = Val(number)
    }
    if parser_current_kind(&state) != TOKEN_LBRACE {
        &value.variants.push(Variant{name: path, name_span: name.span, payload: payload, discriminant: discriminant, discriminant_expr: discriminant_expr, serde_markers: markers})
        return
    }
    parser_bump(&state)
    if markers.len() > 0 {
        parser_add_error_code(&state, "E0003", name.span, "a `#[…]` marker can't sit on group `{path}`", "serde markers rename wire names, and only leaf variants reach the wire (D-TAG1)", "move the marker onto a leaf variant inside the `{{ }}`")
    }
    leaves_before :: value.variants.len()
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF && !parser_aborting(&state) {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_SEMI || kind == TOKEN_COMMA {
            parser_bump(&state)
            next
        }
        entry_markers :: if kind == TOKEN_HASH -> parser_parse_variant_markers(&state) else -> [Marker]{}
        parser_parse_variant_entry(&state, path, &value, entry_markers)
        if parser_current_kind(&state) == TOKEN_SEMI || parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state)
    }
    parser_expect(&state, TOKEN_RBRACE, "`}}` to close the variant group")
    if parser_aborting(&state) -> return
    if value.variants.len() == leaves_before {
        parser_add_error_code(&state, "E0003", name.span, "group `{path}` has no variants", "an empty group can never match anything — every group needs at least one leaf variant (D-TAG1)", "add a variant inside the `{{ }}`, or remove the group")
    }
    &value.groups.push(EnumGroup{path: path, name_span: name.span})
}

// A variant payload inside `( )`: named fields `name: Type, …` or one
// positional type.
fn parser_parse_variant_payload(state: &JetParserState) -> VariantPayload {
    if parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON {
        fields := [VariantField]{}
        loop !parser_aborting(&state) {
            field :: parser_expect_name(&state, "for a variant field name")
            parser_expect(&state, TOKEN_COLON, "`:` after a variant field name")
            ty :: parser_parse_type(&state, 0)
            &fields.push(VariantField{name: field.payload.decoded, name_span: field.span, ty: ty.ty, ty_span: ty.span})
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
        return VariantPayload.Named{fields: fields}
    }
    ty :: parser_parse_type(&state, 0)
    if parser_current_kind(&state) == TOKEN_COMMA {
        parser_add_error_here(&state, "a positional enum variant can carry only one value", "one positional payload has one type; variants with two or more values use named fields", "name each field, for example `Hit(text: String, count: Int)`")
    }
    VariantPayload.Single{ty: ty.ty, span: ty.span}
}

// D-ONCE-DERIVE1=A: a body-line `derive Trait` request is retired (E0922 for
// `Debug`, E0929 otherwise); `derive` defines providers at item scope.
fn parser_report_retired_derive_line(state: &JetParserState) {
    keyword :: parser_bump(&state)
    trait_name :: parser_expect_name(&state, "after `derive`")
    parser_finish_statement(&state)
    if trait_name.payload.decoded == "Debug" {
        parser_add_fatal_code(&state, "E0922", keyword.span, "`derive Debug` inside a type body is retired", "signed type markers are the one control for compiler-generated Debug implementations", "write `#Debug` before the type to opt in, `#!Debug` to opt out, or implement `Debug` by hand")
        return
    }
    parser_add_fatal_code(&state, "E0929", keyword.span, "`derive {trait_name.payload.decoded}` inside a type body is retired", "a derive request has one spelling: the marker before the type; `derive` defines providers", "write `#{trait_name.payload.decoded}` before the type")
}

// S28: `impl Trait { … }` inside a struct or enum body, with D-LIB2
// associated types `type Name = Type` and D-FOUND-OPMIX1=A's one
// parenthesized right-hand type on an operator trait.
fn parser_parse_trait_impl_block(state: &JetParserState) -> TraitImplBlock {
    parser_bump(&state)
    trait_name :: parser_expect_name(&state, "after `impl`")
    operator_rhs :: parser_parse_operator_rhs(&state, Val(trait_name.payload.decoded))
    operator_marker := OperatorMarker?{None}
    loop parser_current_kind(&state) == TOKEN_HASH {
        marker :: parser_parse_marker(&state)
        if marker.name == "Commutative" -> operator_marker = Val(OperatorMarker.Commutative)
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` to open the trait impl body")
    methods := [Func]{}
    assoc_types := [NamedType]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF && !parser_aborting(&state) {
        token :: parser_current(&state)
        if token.kind == TOKEN_SEMI {
            parser_bump(&state)
            next
        }
        if parser_state_section_ahead(&state) {
            section := parser_parse_state_section(&state, "", token.span)
            parser_report_ineligible_state_section(&state, section, "impl")
            next
        }
        if token.kind == TOKEN_IDENT && token.payload.decoded == "type" {
            parser_bump(&state)
            assoc :: parser_expect_name(&state, "after `type` in impl body")
            parser_expect(&state, TOKEN_EQ, "`=` after associated type name")
            ty :: parser_parse_type(&state, 0)
            parser_finish_statement(&state)
            &assoc_types.push(NamedType{name: assoc.payload.decoded, span: parser_cover(token.span, assoc.span), ty: ty.ty})
            next
        }
        if token.kind != TOKEN_KW_FN && token.kind != TOKEN_KW_PUB && token.kind != TOKEN_HASH && !parser_prep_fn_ahead(&state) {
            parser_add_error(&state, token.span, "expected the keyword `fn` to start a method, found {parser_describe_token(token)}", "an impl body holds methods and associated types", "write a method with `fn`")
            break
        }
        &methods.push(parser_parse_type_method(&state))
    }
    parser_expect(&state, TOKEN_RBRACE, "`}}` to close the trait impl body")
    TraitImplBlock{trait_name: trait_name.payload.decoded, trait_span: trait_name.span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: methods, compiler_generated: false, assoc_type_impls: assoc_types}
}

fn parser_report_retired_const(state: &JetParserState, kind: Int, span: Span) {
    if kind == {
        TOKEN_KW_CONST -> parser_add_error_code(&state, "E0146", span, "`const` is retired — write `NAME :: prep {{ … }}`", "a compile-time constant is an immutable binding whose value is prepared while building", "write `NAME :: prep {{ … }}` (or `#Persist name := …` for hot-reload state)")
        else -> parser_add_error_code(&state, "E0374", span, "`comptime` is retired", "Jet folds ordinary foldable expressions automatically; explicit compile-time demand lives on the marker plane", "remove the keyword; a build-time value is written `NAME :: prep {{ … }}`, and `prep {{ … }}` runs other work while building")
    }
}
fn parser_parse_const(state: &JetParserState, modifiers: ParsedItemModifiers) -> ConstDef {
    start := parser_current(&state)
    if modifiers.is_comptime {
        error_span := modifiers.start_span
        marker_index := 0
        loop marker_index < modifiers.markers.len() {
            marker :: modifiers.markers[marker_index]
            if marker.name == "Comptime" -> error_span = marker.span
            marker_index += 1
        }
        parser_report_retired_const(&state, TOKEN_KW_COMPTIME, error_span)
    }
    // D-PREP-SURFACE2=A + owner ruling (2026-09-30): compile time is always
    // explicit. Only `NAME :: prep { value }` is evaluated while building; a
    // retired `@NAME :: value` or `comptime` form recovers with its old
    // compile-time meaning after its teaching error.
    binding_name := ""
    retired_at := ""
    recovered_comptime := false
    name_token := if {
        start.kind == TOKEN_AT -> {
            parser_bump(&state)
            at_name :: parser_expect_name(&state, "after `@` in a constant")
            parser_expect(&state, TOKEN_COLON_COLON, "`::` after a constant name")
            binding_name = at_name.payload.decoded.to_ascii_upper()
            retired_at = "@{at_name.payload.decoded}"
            at_name
        }
        start.kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON_COLON -> {
            parser_bump(&state)
            parser_expect(&state, TOKEN_COLON_COLON, "`::` after a constant name")
            if start.payload.decoded.starts_with("@") {
                retired_at = start.payload.decoded
            } else {
                binding_name = start.payload.decoded
            }
            start
        }
        else -> {
            if {
                start.kind == TOKEN_KW_CONST || start.kind == TOKEN_KW_COMPTIME -> {
                    parser_bump(&state)
                    parser_report_retired_const(&state, start.kind, start.span)
                }
                !modifiers.is_comptime -> {
                    parser_add_error(&state, start.span, "expected a constant binding", "a module constant is an ALL_CAPS name", "write `NAME :: value`, or `NAME :: prep {{ value }}` to evaluate it while building")
                    if start.kind != TOKEN_EOF -> parser_bump(&state)
                }
            }
            retired_name :: parser_expect_name(&state, "after a retired constant keyword")
            parser_expect(&state, TOKEN_EQ, "`=` after a retired constant name")
            binding_name = retired_name.payload.decoded
            recovered_comptime = true
            retired_name
        }
    }
    prepared := false
    parsed_value := ParsedExpr{expr: Expr.Unit{span: start.span}, span: start.span}
    if parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) {
        head :: parser_bump(&state)
        block :: parser_parse_value_block(&state, 0, true)
        span :: parser_cover(head.span, block.span)
        parsed_value = ParsedExpr{expr: Expr.Unit{span: span}, span: span}
        if block.statements.len() == 0 && block.tail == .Val(tail) {
            prepared = true
            parsed_value = ParsedExpr{expr: tail, span: span}
        } else {
            parser_add_error_code(&state, "E0391", span, "`prep {{ … }}` is used as a value, which this compiler does not support yet", "D-PREP-SURFACE2=A makes the block's final expression its value; only a block holding a single final expression is folded today", "write `NAME :: prep {{ value }}` with one final expression, or a `prep {{ … }}` statement")
        }
    } else {
        parsed_value = parser_parse_expression(&state, 1, 0)
    }
    if retired_at != "" {
        recovered_comptime = true
        if prepared && start.kind != TOKEN_AT {
            binding_name = parser_retire_const_mark(&state, name_token)
        } else {
            binding_name = parser_retire_const_decl(&state, parser_cover(start.span, name_token.span), retired_at)
        }
        if start.kind == TOKEN_AT -> binding_name = binding_name.to_ascii_upper()
    }
    terminator := parser_current(&state)
    terminator_span := terminator.span
    if terminator.kind == TOKEN_RBRACE || terminator.kind == TOKEN_EOF -> terminator_span = parsed_value.span
    if terminator.kind != TOKEN_SEMI && terminator.kind != TOKEN_RBRACE && terminator.kind != TOKEN_EOF {
        parser_add_error(&state, terminator.span, "something unexpected appeared after this line, found `{terminator.payload.text}`", "each line ends where the line break is (no `;` needed)", "put the next line of code on a new line")
    }
    parser_finish_statement(&state)
    attrs := [ConstAttr]{}
    rust_kind := RustConstKind.Const
    marker_index := 0
    loop marker_index < modifiers.markers.len() {
        marker :: modifiers.markers[marker_index]
        if marker.name == "Static" {
            &attrs.push(ConstAttr.ForceStatic)
            rust_kind = RustConstKind.Static
        }
        if marker.name == "Inline" -> &attrs.push(ConstAttr.ForceInline)
        marker_index += 1
    }
    result := ast_const(binding_name, name_token.span, parser_cover(modifiers.start_span, terminator_span), parsed_value.expr)
    result.attrs = attrs
    result.is_pub = modifiers.is_pub
    result.is_package_pub = modifiers.is_package_pub
    result.is_comptime = prepared || recovered_comptime
    result.rust_kind = rust_kind
    result.ty = None
    result
}

// D-MODULE-BIND1: `name :: value` / `name := value` at file scope declares a
// module binding, not an executable script statement (Rust
// `module_binding_def`). The retired typed form `name : Type …` takes the same
// route so the binding parser teaches it.
fn parser_module_binding_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_IDENT -> return false
    next :: parser_kind_at(&state, 1)
    if next == TOKEN_COLON_COLON || next == TOKEN_COLON_EQ || next == TOKEN_COLON -> return true
    // `Type{ … } :: value` is a destructuring head; the module-binding parser
    // rejects it with one diagnostic (Rust `pattern_target_is_binding`).
    if next != TOKEN_LBRACE -> return false
    depth := 0
    offset := 1
    loop {
        kind :: parser_kind_at(&state, offset)
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 {
                after :: parser_kind_at(&state, offset + 1)
                return after == TOKEN_COLON_COLON || after == TOKEN_COLON_EQ
            }
        }
        offset += 1
    }
    false
}

// The module constant or variable a parsed file-scope binding declares, spanning
// `start` through `end`. A line that is not one named binding stays a script
// statement (None), which sema reports as top-level executable code.
fn parser_module_binding_item(statement: Stmt, start: Span, end: Int) -> Item? {
    if statement == .Val(binding) {
        if binding.pattern != None || binding.name == "" -> return None
        definition := ast_const(binding.name, binding.name_span, Span{start: start.start, end: end}, binding.init)
        definition.meta = binding.meta
        definition.is_comptime = binding.is_comptime
        definition.ct = binding.ct
        definition.ty = binding.ty
        definition.mutable = binding.mutable
        return Val(Item.Const{value: definition})
    }
    None
}

fn parser_parse_type_alias(state: &JetParserState, modifiers: ParsedItemModifiers) -> TypeAliasDef {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `alias`")
    type_params := parser_parse_type_params(&state)
    parser_expect(&state, TOKEN_COLON_COLON, "`::` before the aliased type")
    target := if {
        parser_state_section_ahead(&state) -> {
            section_start :: parser_current(&state).span
            section := parser_parse_state_section(&state, "", section_start)
            parser_report_ineligible_state_section(&state, section, "alias")
            ParsedType{ty: Type.Named{name: "__jet_error"}, span: section.span}
        }
        else -> parser_parse_type(&state, 0)
    }
    parser_finish_statement(&state)
    TypeAliasDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: name.payload.decoded, name_span: name.span, type_params: type_params, target: target.ty, target_span: target.span, span: parser_cover(start.span, target.span)}
}

fn parser_apply_type_markers(value: &StructDef, markers: [Marker]) Never! {
    index := 0
    loop index < markers.len() {
        marker :: markers[index]
        if marker.name == "SingleUse" {
            value.is_single_use = true
            value.single_use_span = Val(marker.span)
        }
        if marker.name == "MustUse" {
            value.is_must_use = true
            value.must_use_span = Val(marker.span)
        }
        if marker.name == "PublishedSchema" {
            value.is_published_schema = true
            value.published_schema_span = Val(marker.span)
        }
        index += 1
    }
}

fn parser_parse_trait(state: &JetParserState, modifiers: ParsedItemModifiers) -> TraitDef {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `trait`")
    parser_expect(&state, TOKEN_LBRACE, "`{{` before trait members")
    methods := [TraitMethodSig]{}
    assoc_types := [NamedSpan]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        if parser_state_section_ahead(&state) {
            section_start :: parser_current(&state).span
            section := parser_parse_state_section(&state, "", section_start)
            parser_report_ineligible_state_section(&state, section, "trait")
            next
        }
        if {
            parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "type" -> {
                kw :: parser_bump(&state)
                assoc :: parser_expect_name(&state, "after `type` in a trait")
                &assoc_types.push(NamedSpan{name: assoc.payload.decoded, span: parser_cover(kw.span, assoc.span)})
                parser_finish_statement(&state)
            }
            parser_current_kind(&state) == TOKEN_KW_FN -> {
                method_modifiers := parser_parse_item_modifiers(&state, false)
                parsed :: parser_parse_function(&state, method_modifiers, false)
                method := parsed.value
                default_body := [Stmt]?{None}
                if parsed.has_body -> default_body = Val(method.body)
                &methods.push(TraitMethodSig{name: method.name, name_span: method.name_span, params: method.params, return_type: method.return_type, span: method.span, default_body: default_body, is_pure: method.is_pure, declared_effects: method.declared_effects, return_view_provenance: method.return_view_provenance, declared_return_view_provenance: method.declared_return_view_provenance})
            }
            else -> {
                parser_add_error_here(&state, "expected a trait method or associated type", "trait bodies declare callable requirements and associated types", "write `fn name(...)` or `type Name;`")
                parser_recover_statement(&state)
            }
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after trait members")
    TraitDef{span: parser_cover(modifiers.start_span, close.span), is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: name.payload.decoded, name_span: name.span, assoc_types: assoc_types, methods: methods}
}

// D-FOUND-OPMIX1=A: the one parenthesized right-hand type allowed on an
// operator trait impl. A bare operator impl keeps `None`, which means `Self`.
fn parser_parse_operator_rhs(state: &JetParserState, trait_name: String?) -> Type? {
    if parser_current_kind(&state) != TOKEN_LPAREN -> return None
    parser_bump(&state)
    rhs :: parser_parse_type(&state, 0)
    if parser_current_kind(&state) == TOKEN_COMMA {
        comma :: parser_bump(&state)
        parser_add_error(&state, comma.span, "an operator impl accepts exactly one right-hand type", "operator dispatch has one right-hand operand; multiple type arguments would make the hook ambiguous", "write one type, for example `impl Money.Mul(Int)`")
        return None
    }
    parser_expect(&state, TOKEN_RPAREN, "`)` after the operator right-hand type")
    name :: trait_name ?? {
        parser_add_error(&state, rhs.span, "type arguments on an impl need an operator trait", "only Add, Sub, Mul, and Div accept an explicit right-hand operand type", "write a dotted operator impl such as `impl Money.Mul(Int)`")
        return None
    }
    if name != "Add" && name != "Sub" && name != "Mul" && name != "Div" {
        parser_add_error(&state, rhs.span, "`{name}` does not accept an operator right-hand type", "only Add, Sub, Mul, and Div have a typed right-hand operand", "remove the type arguments or use an arithmetic operator trait")
        return None
    }
    Val(rhs.ty)
}

// D-IMPLDOT1=A: `impl Type.Trait { … }` implements a trait; `impl Type { … }`
// is inherent, as is a protocol handle `impl Payment.Client { … }`. A
// `Type.Literal.Int` / `Type.Literal.Float` tail names one literal capability.
// D-ERR-CONV (as respelled by D-ARROW-CONTROL1): `impl Source -> Target { body }`
// declares the conversion of a `Source` error into a `Target` error.
fn parser_parse_impl(state: &JetParserState) -> Item {
    start :: parser_bump(&state)
    parts := [Token]{}
    &parts.push(parser_expect_name(&state, "after `impl`"))
    loop parser_current_kind(&state) == TOKEN_DOT && !parser_aborting(&state) {
        parser_bump(&state)
        &parts.push(parser_expect_name(&state, "after `.` in `impl`"))
    }
    first :: parts[0]
    count :: parts.len()
    is_error_conversion :: parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
    is_protocol_impl :: count == 2 && (parts[1].payload.decoded == "Client" || parts[1].payload.decoded == "Server") && parser_current_kind(&state) == TOKEN_LBRACE
    literal_capability :: count >= 3 && parts[count - 2].payload.decoded == "Literal" && (parts[count - 1].payload.decoded == "Int" || parts[count - 1].payload.decoded == "Float")
    owner_count :: if {
        count == 1 || is_error_conversion || is_protocol_impl -> count
        literal_capability -> count - 2
        else -> count - 1
    }
    type_name := first.payload.decoded
    loop index in 1..<owner_count -> type_name = "{type_name}.{parts[index].payload.decoded}"
    type_span :: parser_cover(first.span, parts[owner_count - 1].span)
    has_trait := owner_count < count
    trait_name := String?{None}
    trait_span := Span?{None}
    if has_trait {
        trait_text := parts[owner_count].payload.decoded
        loop index in (owner_count + 1)..<count -> trait_text = "{trait_text}.{parts[index].payload.decoded}"
        trait_name = Val(trait_text)
        trait_span = Val(parser_cover(parts[owner_count].span, parts[count - 1].span))
    }
    if is_error_conversion {
        parser_bump(&state)
        target :: parser_expect_name(&state, "after `->` in error conversion")
        to_ty := target.payload.decoded
        loop parser_current_kind(&state) == TOKEN_DOT && !parser_aborting(&state) {
            parser_bump(&state)
            segment :: parser_expect_name(&state, "after `.` in a type path")
            to_ty = "{to_ty}.{segment.payload.decoded}"
        }
        if parser_current_kind(&state) != TOKEN_LBRACE {
            parser_add_error_here(&state, "expected `{{` to open the error-conversion body", "an error conversion body is a block: `impl Source -> Target {{ … }}`", "add `{{` after the target type")
            return Item.ErrorConv{value: ErrorConvDef{from_ty: type_name, from_span: type_span, to_ty: to_ty, to_span: target.span, body: [Stmt]{}, body_span: parser_cover(start.span, target.span)}}
        }
        body :: parser_parse_block(&state)
        return Item.ErrorConv{value: ErrorConvDef{from_ty: type_name, from_span: type_span, to_ty: to_ty, to_span: target.span, body: body.statements, body_span: body.span}}
    }
    // The retired `impl Type: Trait` separator teaches `impl Type.Trait`.
    if !has_trait && parser_current_kind(&state) == TOKEN_COLON {
        has_trait = true
        colon :: parser_bump(&state)
        parser_add_error_code(&state, "E0321", colon.span, "trait separator is now `.`, not `:`", "the impl separator reads \"Type's Trait\", matching the dot accessor", "write `impl {type_name}.Trait {{ … }}`")
        named :: parser_expect_name(&state, "after `:` in `impl Type: Trait`")
        trait_name = Val(named.payload.decoded)
        trait_span = Val(named.span)
    }
    operator_rhs :: parser_parse_operator_rhs(&state, trait_name)
    operator_marker := OperatorMarker?{None}
    loop parser_current_kind(&state) == TOKEN_HASH && !parser_aborting(&state) {
        marker :: parser_parse_marker(&state)
        if marker.name == "Commutative" -> operator_marker = Val(OperatorMarker.Commutative)
    }
    // S62: `impl Type.Trait using field_name` delegates the trait to a field.
    using :: parser_current(&state)
    if has_trait && using.kind == TOKEN_IDENT && using.payload.decoded == "using" {
        parser_bump(&state)
        field :: parser_expect_name(&state, "after `using` for the delegation field")
        parser_finish_statement(&state)
        return Item.Impl{value: ImplDef{span: parser_cover(start.span, field.span), type_name: type_name, type_span: type_span, trait_name: trait_name, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: [Func]{}, delegation_field: Val(field.payload.decoded), assoc_type_impls: [NamedType]{}, is_generated_serde: false, os_target: None}}
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` to open the `impl` body")
    methods := [Func]{}
    assoc_types := [NamedType]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF && !parser_aborting(&state) {
        token :: parser_current(&state)
        if token.kind == TOKEN_SEMI {
            parser_bump(&state)
            next
        }
        if parser_state_section_ahead(&state) {
            section := parser_parse_state_section(&state, "", token.span)
            parser_report_ineligible_state_section(&state, section, "impl")
            next
        }
        if token.kind == TOKEN_IDENT && token.payload.decoded == "type" {
            parser_bump(&state)
            assoc :: parser_expect_name(&state, "after `type` in impl body")
            parser_expect(&state, TOKEN_EQ, "`=` after associated type name")
            ty :: parser_parse_type(&state, 0)
            parser_finish_statement(&state)
            &assoc_types.push(NamedType{name: assoc.payload.decoded, span: parser_cover(token.span, assoc.span), ty: ty.ty})
            next
        }
        if token.kind != TOKEN_KW_FN && token.kind != TOKEN_KW_PUB && token.kind != TOKEN_HASH && !parser_prep_fn_ahead(&state) {
            parser_add_error(&state, token.span, "expected the keyword `fn` to start a method, found {parser_describe_token(token)}", "an impl body holds methods and associated types", "write a method with `fn`")
            break
        }
        &methods.push(parser_parse_type_method(&state))
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after implementation methods")
    Item.Impl{value: ImplDef{span: parser_cover(start.span, close.span), type_name: type_name, type_span: type_span, trait_name: trait_name, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: methods, delegation_field: None, assoc_type_impls: assoc_types, is_generated_serde: false, os_target: None}}
}

fn parser_parse_effect_decl(state: &JetParserState) -> EffectDecl {
    start := parser_bump(&state)
    name :: parser_effect_path_name(&state)
    irreversible := false
    declaration_end := name.span.end
    fact := parser_current(&state)
    if fact.kind == TOKEN_IDENT && fact.payload.decoded == "$irreversible" {
        parser_bump(&state)
        irreversible = true
        declaration_end = fact.span.end
    }
    parser_finish_statement(&state)
    EffectDecl{name: name.name, name_span: name.span, irreversible: irreversible, span: Span{start: start.span.start, end: declaration_end}}
}

fn parser_effect_path_name(state: &JetParserState) -> NamedSpan {
    first :: parser_expect_name(&state, "after the `effect` declaration keyword")
    name := first.payload.decoded
    end := first.span
    loop parser_current_kind(&state) == TOKEN_DOT {
        parser_bump(&state)
        segment :: parser_expect_name(&state, "for an effect path segment after `.`")
        name = "{name}.{segment.payload.decoded}"
        end = segment.span
    }
    NamedSpan{name: name, span: parser_cover(first.span, end)}
}

fn parser_parse_tag_decl(state: &JetParserState, modifiers: ParsedItemModifiers) -> TagDef {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `tag`")
    deny := [NamedSpan]{}
    from := [NamedSpan]{}
    end := name.span
    if {
        parser_current_kind(&state) == TOKEN_LBRACE -> {
            parser_bump(&state)
            loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
                keyword :: parser_expect_name(&state, "in a tag declaration")
                target :: parser_expect_name(&state, "after a tag declaration clause")
                item := NamedSpan{name: target.payload.decoded, span: target.span}
                if keyword.payload.decoded == "deny" -> &deny.push(item)
                if keyword.payload.decoded == "from" -> &from.push(item)
                parser_finish_statement(&state)
            }
            close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after tag declaration")
            end = close.span
        }
        else -> parser_finish_statement(&state)
    }
    TagDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: name.payload.decoded, name_span: name.span, deny: deny, from: from, span: parser_cover(start.span, end)}
}

fn parser_parse_user_derive(state: &JetParserState) -> DeriveDef {
    start :: parser_bump(&state)
    type_name :: parser_expect_name(&state, "after `derive`")
    parser_expect(&state, TOKEN_DOT, "`.` between a type and derive trait")
    trait_token :: parser_expect_name(&state, "after `.` in a derive declaration")
    parser_expect(&state, TOKEN_LBRACE, "`{{` before derive methods")
    // Rust `derive_body_items`: template depth covers the whole body.
    state.derive_template_depth += 1
    body := [DeriveBodyItem]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        if {
            parser_template_loop_ahead(&state) -> &body.push(parser_marker_template_loop(&state))
            parser_current_kind(&state) == TOKEN_KW_FN -> {
                modifiers := ParsedItemModifiers{is_pub: false, is_package_pub: false, is_comptime: false, markers: [Marker]{}, start_span: parser_current(&state).span}
                parsed :: parser_parse_function(&state, modifiers, true)
                &body.push(DeriveBodyItem.Item{value: Item.Func{value: parsed.value}})
            }
            else -> {
                parser_add_error_here(&state, "expected a derive method", "user derive bodies contain method declarations", "write a method with `fn`")
                parser_recover_statement(&state)
            }
        }
    }
    state.derive_template_depth -= 1
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after derive methods")
    DeriveDef{trait_name: trait_token.payload.decoded, trait_span: trait_token.span, type_param: type_name.payload.decoded, body: body, span: parser_cover(start.span, close.span)}
}
